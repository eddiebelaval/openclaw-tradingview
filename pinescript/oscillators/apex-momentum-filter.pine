//@version=5
indicator("Apex Momentum Filter", overlay=true)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
grp1 = "Core Strategy"
minPrice      = input.float(10.0, "Min Price Filter", step=0.5, group=grp1)
fastLen       = input.int(5,  "Fast SMA", group=grp1)
slowLen       = input.int(15, "Slow SMA", group=grp1)

grp2 = "OsMA Settings"
osmaFast      = input.int(6,  "OsMA Fast Period", group=grp2)
osmaSlow      = input.int(12, "OsMA Slow Period", group=grp2)
osmaSignal    = input.int(4,  "OsMA Signal Period", group=grp2)
strongThresh  = input.float(0.60, "Strong Signal OsMA Threshold (0.0-1.0)", group=grp2)

grp3 = "RSI Settings"
rsiLen        = input.int(14, "RSI Length", group=grp3)
rsiOverbought = input.int(70, "RSI Overbought Level", group=grp3)
rsiOversold   = input.int(30, "RSI Oversold Level", group=grp3)

grp4 = "Bollinger Band Settings (Match Screenshot)"
bbLen         = input.int(10, "BB Length", group=grp4)
bbStdDev      = input.float(1.5, "BB StdDev", step=0.1, group=grp4)
bbUpperLimit  = input.float(0.85, "Max %B for Strong Buy", group=grp4)
bbLowerLimit  = input.float(0.15, "Min %B for Strong Sell", group=grp4)

grp5 = "Visuals"
heatmapBase   = input.int(55, "Heatmap Base Transparency", minval=0, maxval=90, group=grp5)
showBB        = input.bool(true, "Show Bollinger Bands on Chart?", group=grp5)

// ─── CALCULATIONS ─────────────────────────────────────────────────────────────
// 1. SMAs
fast = ta.sma(close, fastLen)
slow = ta.sma(close, slowLen)

// 2. OsMA
[macdLine, signalLine, _] = ta.macd(close, osmaFast, osmaSlow, osmaSignal)
osma = macdLine - signalLine
osmaMax = ta.highest(math.abs(osma), 50)
intensity = osmaMax != 0 ? math.abs(osma) / osmaMax : 0.0

// 3. RSI
rsi = ta.rsi(close, rsiLen)

// 4. Bollinger Bands
[bbBasis, bbUpper, bbLower] = ta.bb(close, bbLen, bbStdDev)
percentB = (close - bbLower) / (bbUpper - bbLower) // 0 to 1 scale

// ─── SIGNAL LOGIC ─────────────────────────────────────────────────────────────
priceFilter = close > minPrice
crossUp     = ta.crossover(fast, slow)
crossDown   = ta.crossunder(fast, slow)

// Filters
rsiOkBuy  = rsi < rsiOverbought
rsiOkSell = rsi > rsiOversold
bbOkBuy   = percentB < bbUpperLimit // Price isn't already "poking" through the top band
bbOkSell  = percentB > bbLowerLimit // Price isn't already "poking" through the bottom band

// Define "Strong" based on OsMA + RSI + BB Probability
isStrongBuy  = intensity >= strongThresh and rsi >= 40 and rsi <= 65 and bbOkBuy
isStrongSell = intensity >= strongThresh and rsi <= 60 and rsi >= 35 and bbOkSell

// Final 4 Signal Categories
strongBuy  = crossUp   and priceFilter and osma > 0 and rsiOkBuy  and isStrongBuy
normalBuy  = crossUp   and priceFilter and osma > 0 and rsiOkBuy  and not isStrongBuy
strongSell = crossDown and priceFilter and osma < 0 and rsiOkSell and isStrongSell
normalSell = crossDown and priceFilter and osma < 0 and rsiOkSell and not isStrongSell

// ─── VISUALS ──────────────────────────────────────────────────────────────────
// Heatmap
dynamicTransp = heatmapBase + (1.0 - intensity) * (100 - heatmapBase)
dynamicTransp := math.min(math.max(dynamicTransp, 0), 99)
bgColor = osma > 0 ? color.new(color.green, int(dynamicTransp)) : color.new(color.red, int(dynamicTransp))
bgcolor(bgColor, title="OsMA Heatmap")

// SMA Lines
plot(fast, "SMA 5",  color=color.teal,   linewidth=2)
plot(slow, "SMA 15", color=color.orange, linewidth=2)

// Bollinger Bands (Optional Plot)
plot(showBB ? bbUpper : na, "BB Upper", color=color.new(color.gray, 70))
plot(showBB ? bbLower : na, "BB Lower", color=color.new(color.gray, 70))
plot(showBB ? bbBasis : na, "BB Basis", color=color.new(color.gray, 85))

// RSI Label
var label rsiLabel = na
if barstate.islast
    label.delete(rsiLabel)
    rsiColor = rsi >= rsiOverbought ? color.red : rsi <= rsiOversold ? color.lime : color.gray
    rsiLabel := label.new(bar_index, high, text="RSI: " + str.tostring(math.round(rsi, 1)) + "\n%B: " + str.tostring(math.round(percentB, 2)), style=label.style_label_down, color=rsiColor, textcolor=color.black, size=size.small)

// Buy/Sell Shapes
plotshape(strongBuy,  title="Strong Buy",  style=shape.triangleup,   location=location.belowbar, color=color.lime,   size=size.large, text="STRONG BUY",  textcolor=color.lime)
plotshape(normalBuy,  title="Buy",         style=shape.triangleup,   location=location.belowbar, color=color.green,  size=size.small, text="BUY",         textcolor=color.green)
plotshape(strongSell, title="Strong Sell", style=shape.triangledown, location=location.abovebar, color=color.red,    size=size.large, text="STRONG SELL", textcolor=color.red)
plotshape(normalSell, title="Sell",        style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.small, text="SELL",        textcolor=color.orange)

// ─── ALERTS ───────────────────────────────────────────────────────────────────
alertMsg = "Ticker: " + syminfo.ticker + "\nPrice: " + str.tostring(math.round(close, 2)) + "\nOsMA: " + str.tostring(math.round(osma, 4)) + "\nRSI: " + str.tostring(math.round(rsi, 2)) + "\n%B: " + str.tostring(math.round(percentB, 2))

if strongBuy
    alert("💪🟢 STRONG BUY: " + alertMsg, alert.freq_once_per_bar_close)
else if normalBuy
    alert("🟢 BUY: " + alertMsg, alert.freq_once_per_bar_close)

if strongSell
    alert("💪🔴 STRONG SELL: " + alertMsg, alert.freq_once_per_bar_close)
else if normalSell
    alert("🔴 SELL: " + alertMsg, alert.freq_once_per_bar_close)
