//@version=5
indicator("Universal RSI Sync Dashboard - Full", overlay=true)

// ========================================================================= //
// 1. INPUTS
// ========================================================================= //
grp1      = "RSI Signal Settings"
threshold = input.float(0.5, "RSI Diff Threshold", group=grp1)
ma_len    = input.int(50, "Trend MA Length", group=grp1)
rsi_len   = input.int(14, "RSI Length", group=grp1)

grp2 = "Tickers"
sym1 = input.symbol("CME_MINI:MES1!", title="Ticker 1", group=grp2)
sym2 = input.symbol("CME_MINI:MNQ1!", title="Ticker 2", group=grp2)
sym3 = input.symbol("CME_MINI:MYM1!", title="Ticker 3", group=grp2)

grp3 = "30m Structural Settings"
ema_len = input.int(233, "EMA 233 Length", group=grp3)

grp4 = "Visuals"
dash_loc = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grp4)

// ========================================================================= //
// 2. LOGIC FUNCTIONS
// ========================================================================= //
get_ribbon_state(r_len, r_thresh, m_len) =>
    rsi_val = ta.rsi(close, r_len)
    diff    = rsi_val - 50
    is_bull = diff > r_thresh
    is_bear = diff < -r_thresh
    is_bull ? 1 : is_bear ? -1 : 0

get_struct_state(e_len, s_id) =>
    ema  = ta.ema(close, e_len)
    pd_h = request.security(s_id, "D", high[1], lookahead=barmerge.lookahead_on)
    pd_l = request.security(s_id, "D", low[1], lookahead=barmerge.lookahead_on)
    close > ema and close > pd_h ? 1 : close < ema and close < pd_l ? -1 : 0

// ========================================================================= //
// 3. DATA ACQUISITION
// ========================================================================= //
// Ticker 1 (MES)
t5_1  = request.security(sym1, "5",  get_ribbon_state(rsi_len, threshold, ma_len))
t15_1 = request.security(sym1, "15", get_ribbon_state(rsi_len, threshold, ma_len))
t30_1 = request.security(sym1, "30", get_struct_state(ema_len, sym1))

// Ticker 2 (MNQ)
t5_2  = request.security(sym2, "5",  get_ribbon_state(rsi_len, threshold, ma_len))
t15_2 = request.security(sym2, "15", get_ribbon_state(rsi_len, threshold, ma_len))
t30_2 = request.security(sym2, "30", get_struct_state(ema_len, sym2))

// Ticker 3 (MYM)
t5_3  = request.security(sym3, "5",  get_ribbon_state(rsi_len, threshold, ma_len))
t15_3 = request.security(sym3, "15", get_ribbon_state(rsi_len, threshold, ma_len))
t30_3 = request.security(sym3, "30", get_struct_state(ema_len, sym3))

// Chart Sync Logic (Paints the background based on the CURRENT symbol's 5m state)
chart_5m_ribbon = request.security(syminfo.tickerid, "5", get_ribbon_state(rsi_len, threshold, ma_len))
bgcolor(chart_5m_ribbon == 1 ? color.new(#00ffbb, 85) : chart_5m_ribbon == -1 ? color.new(#ff0055, 85) : color.new(color.gray, 90))

// ========================================================================= //
// 4. TABLE RENDERING
// ========================================================================= //
pos_val = dash_loc == "Top Right" ? position.top_right : dash_loc == "Top Left" ? position.top_left : dash_loc == "Bottom Right" ? position.bottom_right : position.bottom_left
var table dash = table.new(pos_val, 4, 4, bgcolor=#1e222d, border_width=1, border_color=color.gray)

get_cell_color(state) => 
    state == 1 ? color.new(#00ffbb, 30) : state == -1 ? color.new(#ff0055, 30) : color.new(color.gray, 70)

clean(s) => str.replace_all(s, "CME_MINI:", "")

if barstate.islast
    // Header
    table.cell(dash, 0, 0, "Ticker", bgcolor=#363a45, text_color=color.white)
    table.cell(dash, 1, 0, "5m Ribbon", bgcolor=#363a45, text_color=color.white)
    table.cell(dash, 2, 0, "15m Ribbon", bgcolor=#363a45, text_color=color.white)
    table.cell(dash, 3, 0, "30m Range", bgcolor=#363a45, text_color=color.white)

    // Row 1 (Ticker 1)
    table.cell(dash, 0, 1, clean(sym1), text_color=color.white)
    table.cell(dash, 1, 1, t5_1 == 1 ? "BULL" : t5_1 == -1 ? "BEAR" : "NEUT", bgcolor=get_cell_color(t5_1), text_color=color.white)
    table.cell(dash, 2, 1, t15_1 == 1 ? "BULL" : t15_1 == -1 ? "BEAR" : "NEUT", bgcolor=get_cell_color(t15_1), text_color=color.white)
    table.cell(dash, 3, 1, t30_1 == 1 ? "OUTSIDE ▲" : t30_1 == -1 ? "OUTSIDE ▼" : "INSIDE ⚪", bgcolor=get_cell_color(t30_1), text_color=color.white)

    // Row 2 (Ticker 2)
    table.cell(dash, 0, 2, clean(sym2), text_color=color.white)
    table.cell(dash, 1, 2, t5_2 == 1 ? "BULL" : t5_2 == -1 ? "BEAR" : "NEUT", bgcolor=get_cell_color(t5_2), text_color=color.white)
    table.cell(dash, 2, 2, t15_2 == 1 ? "BULL" : t15_2 == -1 ? "BEAR" : "NEUT", bgcolor=get_cell_color(t15_2), text_color=color.white)
    table.cell(dash, 3, 2, t30_2 == 1 ? "OUTSIDE ▲" : t30_2 == -1 ? "OUTSIDE ▼" : "INSIDE ⚪", bgcolor=get_cell_color(t30_2), text_color=color.white)

    // Row 3 (Ticker 3)
    table.cell(dash, 0, 3, clean(sym3), text_color=color.white)
    table.cell(dash, 1, 3, t5_3 == 1 ? "BULL" : t5_3 == -1 ? "BEAR" : "NEUT", bgcolor=get_cell_color(t5_3), text_color=color.white)
    table.cell(dash, 2, 3, t15_3 == 1 ? "BULL" : t15_3 == -1 ? "BEAR" : "NEUT", bgcolor=get_cell_color(t15_3), text_color=color.white)
    table.cell(dash, 3, 3, t30_3 == 1 ? "OUTSIDE ▲" : t30_3 == -1 ? "OUTSIDE ▼" : "INSIDE ⚪", bgcolor=get_cell_color(t30_3), text_color=color.white)
