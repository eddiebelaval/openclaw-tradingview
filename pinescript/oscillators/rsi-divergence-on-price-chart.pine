//@version=6
indicator(title="RSI Divergence Indicator", overlay = true)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
len            = input.int(title="RSI Period", minval=1, defval=14, group="RSI Settings")
src            = input(title="RSI Source", defval=close, group="RSI Settings")
lbR            = input(title="Pivot Lookback Right", defval=34, display=display.none)
lbL            = input(title="Pivot Lookback Left",  defval=21, display=display.none)
rangeUpper     = input(title="Max of Lookback Range", defval=60, display=display.none)
rangeLower     = input(title="Min of Lookback Range", defval=5,  display=display.none)
plotBull       = input(title="Plot Bullish",        defval=true,  display=display.none)
plotHiddenBull = input(title="Plot Hidden Bullish", defval=false, display=display.none)
plotBear       = input(title="Plot Bearish",        defval=true,  display=display.none)
plotHiddenBear = input(title="Plot Hidden Bearish", defval=false, display=display.none)

// ─── EMA INPUTS & CONTROLS ────────────────────────────────────────────────────
showEma12      = input.bool(true,  "Show EMA 34 High/Low Band", group="EMA Visibility")
showEma3       = input.bool(true,  "Show EMA 34 Close", group="EMA Visibility")
showEma4       = input.bool(true,  "Show EMA 89 HL2", group="EMA Visibility")

colorEmaHighLow = input.color(color.new(color.aqua, 50), "EMA 34 High/Low Color", group="EMA Colors")
colorEma3       = input.color(color.new(color.blue, 0),  "EMA 34 Close Color", group="EMA Colors")
colorEma4       = input.color(color.new(color.orange, 0),"EMA 89 HL2 Color", group="EMA Colors")
fillColor       = input.color(color.new(color.aqua, 95), "EMA Band Fill Color", group="EMA Colors")

// ─── COLORS ───────────────────────────────────────────────────────────────────
grp_colors      = "Divergence Colors"
bullColor       = input.color(color.green,           "Regular Bullish",  group=grp_colors)
bearColor       = input.color(color.orange,          "Regular Bearish",  group=grp_colors)
hiddenBullColor = input.color(color.new(color.green, 80), "Hidden Bullish",   group=grp_colors)
hiddenBearColor = input.color(color.new(color.red, 80),   "Hidden Bearish",   group=grp_colors)



// ─── RSI ──────────────────────────────────────────────────────────────────────
osc = ta.rsi(src, len)

// ─── PIVOTS ───────────────────────────────────────────────────────────────────
plFound = na(ta.pivotlow(osc,  lbL, lbR)) ? false : true
phFound = na(ta.pivothigh(osc, lbL, lbR)) ? false : true

// ─── RANGE HELPER ─────────────────────────────────────────────────────────────
_inRange(cond) =>
    bars = ta.barssince(cond == true)
    rangeLower <= bars and bars <= rangeUpper

// ─── DRAWING HELPERS ──────────────────────────────────────────────────────────
drawDivLine(x1, y1, x2, y2, col) =>
    line.new(x1=x1, y1=y1, x2=x2, y2=y2, color=col, width=2, style=line.style_solid)

drawDivLabel(x, y, txt, col, isAbove) =>
    label.new(x=x, y=y, text=txt, style=isAbove ? label.style_label_down : label.style_label_up, color=col, textcolor=color.white, size=size.small)

drawStructure(x1, mainY1, ctxY1, x2, mainY2, ctxY2, col, isAbove, txt) =>
    drawDivLine(x1, mainY1, x2, mainY2, col)
    drawDivLabel(x2, mainY2, txt, col, isAbove)

// ─── PIVOT STATE ──────────────────────────────────────────────────────────────
var int   pl_barA   = na
var float pl_lowA   = na
var float pl_highA  = na
var float pl_oscA   = na

var int   ph_barA   = na
var float ph_highA  = na
var float ph_lowA   = na
var float ph_oscA   = na

// ─── DIV LOGIC ────────────────────────────────────────────────────────────────
if plFound
    curBar   = bar_index[lbR]
    curLow   = low[lbR]
    curHigh  = high[lbR]
    curOsc   = osc[lbR]
    if not na(pl_barA)
        barsApart = curBar - pl_barA
        if rangeLower <= barsApart and barsApart <= rangeUpper
            if plotBull and curLow < pl_lowA and curOsc > pl_oscA
                drawStructure(pl_barA, pl_lowA, pl_highA, curBar + 5, curLow, curHigh, bullColor, false, " Bull ")
            if plotHiddenBull and curLow > pl_lowA and curOsc < pl_oscA
                drawStructure(pl_barA, pl_lowA, pl_highA, curBar + 5, curLow, curHigh, hiddenBullColor, false, " H Bull ")
    pl_barA  := curBar
    pl_lowA  := curLow
    pl_highA := curHigh
    pl_oscA  := curOsc

if phFound
    curBar   = bar_index[lbR]
    curHigh  = high[lbR]
    curLow   = low[lbR]
    curOsc   = osc[lbR]
    if not na(ph_barA)
        barsApart = curBar - ph_barA
        if rangeLower <= barsApart and barsApart <= rangeUpper
            if plotBear and curHigh > ph_highA and curOsc < ph_oscA
                drawStructure(ph_barA, ph_highA, ph_lowA, curBar + 5, curHigh, curLow, bearColor, true, " Bear ")
            if plotHiddenBear and curHigh < ph_highA and curOsc > ph_oscA
                drawStructure(ph_barA, ph_highA, ph_lowA, curBar + 5, curHigh, curLow, hiddenBearColor, true, " H Bear ")
    ph_barA  := curBar
    ph_highA := curHigh
    ph_lowA  := curLow
    ph_oscA  := curOsc

// ─── EMA CALCULATIONS ─────────────────────────────────────────────────────────
ema1 = ta.ema(high, 34)
ema2 = ta.ema(low, 34)
ema3 = ta.ema(close, 34)
ema4 = ta.ema(hl2, 89)

// ─── PLOTTING EMAs ────────────────────────────────────────────────────────────
// Using ternary operators to handle the toggle logic
plot(showEma3 ? ema3 : na, title="EMA 34 Close", color=colorEma3, linewidth=1)
plot(showEma4 ? ema4 : na, title="EMA 89 HL2", color=colorEma4, linewidth=1)

ema1_p = plot(showEma12 ? ema1 : na, title="EMA 34 High", color=colorEmaHighLow)
ema2_p = plot(showEma12 ? ema2 : na, title="EMA 34 Low", color=colorEmaHighLow)
fill(ema1_p, ema2_p, color=showEma12 ? fillColor : color.new(color.white, 100), title="EMA 34 Band Fill")

// ─── ALERTS ───────────────────────────────────────────────────────────────────
inRangePl = _inRange(plFound[1])
inRangePh = _inRange(phFound[1])
bullCondAlert = low[lbR] < ta.valuewhen(plFound, low[lbR], 1) and osc[lbR] > ta.valuewhen(plFound, osc[lbR], 1) and plFound
bearCondAlert = high[lbR] > ta.valuewhen(phFound, high[lbR], 1) and osc[lbR] < ta.valuewhen(phFound, osc[lbR], 1) and phFound

if bullCondAlert
    alert("Bullish Divergence", alert.freq_once_per_bar)
if bearCondAlert
    alert("Bearish Divergence", alert.freq_once_per_bar)
