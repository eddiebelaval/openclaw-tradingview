//@version=5
indicator("Advanced Momentum Engine [identityKa]", overlay=false)

// ==========================================
// 1. USER INPUTS (GLOBAL ENGLISH)
// ==========================================
grp1 = "⚙️ MACD Settings"
fast_len = input.int(12, title="Fast Length", group=grp1)
slow_len = input.int(26, title="Slow Length", group=grp1)
sig_len = input.int(9, title="Signal Length", group=grp1)

grp2 = "⚙️ RSI Settings"
rsi_len = input.int(14, title="RSI Length", group=grp2)
rsi_ob = input.int(70, title="Overbought Level", group=grp2)
rsi_os = input.int(30, title="Oversold Level", group=grp2)

grp3 = "🎨 Theme & Colors"
col_strong_buy = input.color(#00ffbb, title="Strong Bullish", group=grp3)
col_weak_buy = input.color(#00796b, title="Weak Bullish", group=grp3)
col_strong_sell = input.color(#ff1744, title="Strong Bearish", group=grp3)
col_weak_sell = input.color(#b71c1c, title="Weak Bearish", group=grp3)
col_danger = input.color(#ff9800, title="Danger Zone (Orange)", group=grp3)

grp4 = "📊 HUD Dashboard Settings"
show_dash = input.bool(true, "Show Dashboard", group=grp4)
dash_pos = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], group=grp4)
dash_size = input.string("Small", "Dashboard Text Size", options=["Tiny", "Small", "Normal", "Large"], group=grp4)

// ==========================================
// 2. MATHEMATICAL ENGINE (RSI + MACD CONFLUENCE)
// ==========================================
// MACD Calculation
[macd_line, signal_line, hist] = ta.macd(close, fast_len, slow_len, sig_len)

// RSI Calculation
rsi = ta.rsi(close, rsi_len)

// State Logic
is_ob = rsi >= rsi_ob
is_os = rsi <= rsi_os
is_danger = is_ob or is_os

// Histogram Color Logic (4 Colors + Danger)
color hist_col = na
if hist > 0 and hist > hist[1]
    hist_col := col_strong_buy
else if hist > 0 and hist <= hist[1]
    hist_col := col_weak_buy
else if hist < 0 and hist < hist[1]
    hist_col := col_strong_sell
else if hist < 0 and hist >= hist[1]
    hist_col := col_weak_sell

// Override with danger color if RSI is extreme
if is_danger
    hist_col := col_danger

// ==========================================
// 3. VISUALIZATION (OSCILLATOR PANE)
// ==========================================
plot(hist, title="Momentum Histogram", style=plot.style_columns, color=hist_col)
plot(macd_line, title="MACD Line", color=color.new(color.white, 0), linewidth=2)
plot(signal_line, title="Signal Line", color=color.new(color.gray, 50), linewidth=1)
hline(0, "Zero Line", color=color.new(color.gray, 50), linestyle=hline.style_dashed)

// Background highlights for danger zones
bgcolor(is_ob ? color.new(col_danger, 90) : na, title="Overbought Background")
bgcolor(is_os ? color.new(col_danger, 90) : na, title="Oversold Background")

// ==========================================
// 4. HUD DASHBOARD & AI SUGGESTION
// ==========================================
var string p_pos = dash_pos == "Top Right" ? position.top_right : dash_pos == "Top Left" ? position.top_left : dash_pos == "Bottom Right" ? position.bottom_right : dash_pos == "Bottom Left" ? position.bottom_left : dash_pos == "Middle Right" ? position.middle_right : position.middle_left
var string p_size = dash_size == "Tiny" ? size.tiny : dash_size == "Small" ? size.small : dash_size == "Normal" ? size.normal : size.large

var table hud = table.new(p_pos, 2, 3, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 80))

// AI Suggestion Logic based on Confluence
string ai_suggestion = is_danger ? "Dangerous" : (hist > 0 and macd_line > signal_line) ? "LONG" : (hist < 0 and macd_line < signal_line) ? "SHORT" : "WAIT"
color ai_color = ai_suggestion == "LONG" ? col_strong_buy : ai_suggestion == "SHORT" ? col_strong_sell : ai_suggestion == "Dangerous" ? col_danger : color.white

if barstate.islast and show_dash
    table.cell(hud, 0, 0, "RSI STATE", text_color=color.gray, text_size=p_size)
    table.cell(hud, 1, 0, is_ob ? "OVERBOUGHT" : is_os ? "OVERSOLD" : "NEUTRAL", text_color=is_danger ? col_danger : color.white, text_size=p_size)
    
    table.cell(hud, 0, 1, "MACD TREND", text_color=color.gray, text_size=p_size)
    table.cell(hud, 1, 1, hist > 0 ? "BULLISH" : "BEARISH", text_color=hist > 0 ? col_strong_buy : col_strong_sell, text_size=p_size)
    
    table.cell(hud, 0, 2, "AI SUGGESTION", text_color=color.gray, text_size=p_size)
    table.cell(hud, 1, 2, ai_suggestion, text_color=ai_color, text_size=p_size)

// ==========================================
// 5. ALERTS
// ==========================================
alertcondition(ta.crossover(macd_line, signal_line) and not is_danger, "🟢 Confluence Buy", "identityKa: MACD Crossed UP in a safe RSI zone!")
alertcondition(ta.crossunder(macd_line, signal_line) and not is_danger, "🔴 Confluence Sell", "identityKa: MACD Crossed DOWN in a safe RSI zone!")
alertcondition(is_danger and not is_danger[1], "⚠️ Danger Zone Entry", "identityKa: Price entered an extreme RSI zone. Be cautious!")
