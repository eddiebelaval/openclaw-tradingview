//@version=5
indicator("Stop Grid Alert by Deepsage", overlay=false)

// Input parameters
adxLength = input.int(14, title="ADX Length")
rsiLength = input.int(14, title="RSI Length")
bbLength = input.int(20, title="BB Length")
bbMult = input.float(2.0, title="BB Multiplier")

// ADX (via DMI)
[plusDI, minusDI, adx] = ta.dmi(adxLength, adxLength)

// RSI
rsi = ta.rsi(close, rsiLength)

// Bollinger Bands
basis = ta.sma(close, bbLength)
dev = bbMult * ta.stdev(close, bbLength)
upper = basis + dev
lower = basis - dev
bbScore = (close - basis) / dev

// Alert conditions
stopGridCondition =
     adx > 22 or
     rsi > 70 or rsi < 30 or
     bbScore > 1.5 or bbScore < -1.5

// Plotting
plot(adx, color=color.red, title="ADX")
plot(rsi, color=color.purple, title="RSI")
hline(70, "Overbought", color=color.red)
hline(30, "Oversold", color=color.green)

// Alert
alertcondition(stopGridCondition, title="Stop Grid Alert",
 message="Stop Grid: ADX > 22, RSI breakout, or BB score breach")
