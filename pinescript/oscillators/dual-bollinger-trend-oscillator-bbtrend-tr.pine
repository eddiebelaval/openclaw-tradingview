//                                 ██║       ██║     ████████║  ██║ ███║  ██║   ██║       ██████╔╝ ██║   ██║ ██║      ████████║ ████████║
//                                 ██║       ██║     ██╔═══██║  ██║  ██║  ██║   ██║       ██╔══██╗ ██║   ██║ ██║      ██║   ██║ ██╔═══██║
//                                 ██║    ████████╗  ██║   ██║  ███████║  ╚██████╔╝       ██║  ██║ ╚██████╔╝ ╚██████╗ ██║   ██║ ██║   ██║
//@version=6
indicator('Dual Bollinger Trend Oscillator - BBTrend | TR', 'BBTrend | TR →', false)
import TradingView/ta/12
//╔═════════════════╗
//║     Input's     ║
//╚═════════════════╝
Color_Mode =    input.string('Classic', 'Color Choice', group = '🎨 Color', options = ['Classic', 'Modern', 'Robust', 'Accented', 'Monochrome', 'Moderate', 'Aqua', 'Cosmic'])
showHist =      input.bool(true, 'Show Histogram', group='⚙️ BBTrend Setting', inline = "Bool")
showMA =        input.bool(false, 'Show Moving Average', group='⚙️ BBTrend Setting', inline = "Bool")
Source_BB =     input.source(close, 'Price Source', group='⚙️ BBTrend Setting')
Short_Len_BB =  input.int(10, 'Short BB Length', minval=2, group='⚙️ BBTrend Setting')
Long_Len_BB  =  input.int(50, 'Long BB Length', minval=2, group='⚙️ BBTrend Setting')
Short_Mult_BB = input.float(1.0, 'Short StdDev', minval=0.001, step=0.1, group='⚙️ BBTrend Setting')
Long_Mult_BB  = input.float(2.0, 'Long StdDev', minval=0.001, step=0.1, group='⚙️ BBTrend Setting')
Length_MA_BB =  input.int(14,'Length MA', minval=1, group='📊 BBTrend MA', inline = 'BBTrend MA')
MA_Type_BB =    input.string('EMA', 'Moving Average', group='📊 BBTrend MA', inline = 'BBTrend MA', options=['EMA', 'SMA', 'RMA', 'WMA', 'VWMA', 'HMA', 'DEMA', 'TEMA', 'TRIMA', 'FRAMA', 'SWMA', 'T3'])
T_Factor =      input.float(0.7, 'T3 Factor', minval=0, maxval=1, step=0.05, group='📊 BBTrend MA', tooltip = 'For Moving Average = T3')
//╔═════════════════════════════════╗
//║     MOVING AVERAGE ENGINE       ║
//╚═════════════════════════════════╝
ma(source, length, factor, type) =>
     type == 'EMA'   ? ta.ema(source, length) :
     type == 'SMA'   ? ta.sma(source, length) :
     type == 'RMA'   ? ta.rma(source, length) :
     type == 'WMA'   ? ta.wma(source, length) :
     type == 'VWMA'  ? ta.vwma(source, length) :
     type == 'HMA'   ? ta.hma(source, length) :
     type == 'DEMA'  ? ta.dema(source, length) :
     type == 'TEMA'  ? ta.tema(source, length) :
     type == 'TRIMA' ? ta.trima(source, length) :
     type == 'FRAMA' ? ta.frama(source, length) :
     type == 'SWMA'  ? ta.swma(source) :
     type == 'T3'    ? ta.t3(source, length, factor) :
     na
//╔═════════════════╗
//║     Color       ║
//╚═════════════════╝
[UpC, DnC] = switch Color_Mode
    'Classic'    => [#008800, #ff0000]
    'Modern'     => [#ffffff, #b721ff]
    'Robust'     => [#ffbb00, #770737]
    'Accented'   => [#8c5cf7, #e83e8c]
    'Monochrome' => [#e9ecef, #495057]
    'Moderate'   => [#43a047, #e53935]
    'Aqua'       => [#00a8e8, #f18f01]
    'Cosmic'     => [#e83e8c, #6f2da8]

Hist_Pos_Strong = color.new(UpC, 25)
Hist_Pos_Weak   = color.new(UpC, 50)
Hist_Neg_Strong = color.new(DnC, 25)
Hist_Neg_Weak   = color.new(DnC, 50)
//╔════════════════════════╗
//║      Calculation       ║
//╚════════════════════════╝
[shortMid, shortUp, shortLo] = ta.bb(Source_BB, Short_Len_BB, Short_Mult_BB)
[longMid,  longUp,  longLo]  = ta.bb(Source_BB, Long_Len_BB,  Long_Mult_BB)
safeDiv = shortMid != 0 ? shortMid : 0.000001
BBTrend_Hist = (math.abs(shortLo - longLo) - math.abs(shortUp - longUp)) / safeDiv * 100
BBTrend = (math.abs(shortLo - longLo) - math.abs(shortUp - longUp)) / safeDiv * 100
MA_BB = ma(BBTrend, Length_MA_BB, T_Factor, MA_Type_BB)
cond_posStrong = (BBTrend > 0) and (BBTrend >= BBTrend[1])
cond_posWeak   = (BBTrend > 0) and (BBTrend <  BBTrend[1])
cond_negWeak   = (BBTrend < 0) and (BBTrend >  BBTrend[1])
cond_negStrong = (BBTrend < 0) and (BBTrend <= BBTrend[1])
histColor = cond_posStrong ? Hist_Pos_Strong : cond_posWeak   ? Hist_Pos_Weak   : cond_negWeak   ? Hist_Neg_Weak   : cond_negStrong ? Hist_Neg_Strong : Hist_Pos_Weak
isBull_BB_Hist = BBTrend_Hist > 0
isBear_BB_Hist = BBTrend_Hist < 0
isBull_BB = BBTrend > MA_BB
isBear_BB = BBTrend < MA_BB
Bull_BB_Hist = ta.crossover(BBTrend_Hist, 0)
Bear_BB_Hist = ta.crossunder(BBTrend_Hist, 0)
Bull_BB = ta.crossover(BBTrend, MA_BB)
Bear_BB = ta.crossunder(BBTrend, MA_BB)
//╔════════════════════════╗
//║          Plot          ║
//╚════════════════════════╝
Plot_BB_Hist =  plot(showHist ? BBTrend_Hist : na, 'BBTrend Hist', style=plot.style_columns, color=histColor, histbase=0)
Plot_BB_Line =  plot(showHist ? na : BBTrend, 'BBTrend Line', color= BBTrend > MA_BB ? UpC : DnC , linewidth=2)
Plot_MA_BB =    plot((showMA or not showHist) ? MA_BB : na, 'MA', color.yellow, linewidth=2)
hline(0, 'Zero Line', color=#ffffff, linestyle=hline.style_dotted)
plotshape(showMA and Bull_BB ? BBTrend : na, 'Crossover', location=location.absolute, style=shape.circle, size=size.small, color=UpC)
plotshape(showMA and Bear_BB ? BBTrend : na, 'Crossdown', location=location.absolute, style=shape.circle, size=size.small, color=DnC)
plotshape(showHist ? Bull_BB_Hist : Bull_BB, 'LONG', shape.triangleup, location.belowbar, color=UpC, size=size.small, force_overlay=true)
plotshape(showHist ? Bear_BB_Hist : Bear_BB, 'SHORT', shape.triangledown, location.abovebar, color=DnC, size=size.small, force_overlay=true)
bgcolor(showHist ? isBull_BB_Hist ? color.new(UpC, 95) : isBear_BB_Hist ? color.new(DnC, 95) : na : isBull_BB ? color.new(UpC, 95) : isBear_BB ? color.new(DnC, 95) : na, title='Zone Background', force_overlay=true)
plotcandle(open, high, low, close, 'Bar Color', color=showHist ? (isBull_BB_Hist ? UpC : isBear_BB_Hist ? DnC : na) : (isBull_BB ? UpC : isBear_BB ? DnC : na), wickcolor=showHist ? (isBull_BB_Hist ? UpC : isBear_BB_Hist ? DnC : na) : (isBull_BB ? UpC : isBear_BB ? DnC : na), bordercolor=showHist ? (isBull_BB_Hist ? UpC : isBear_BB_Hist ? DnC : na) : (isBull_BB ? UpC : isBear_BB ? DnC : na), force_overlay = true)
fill(Plot_BB_Line, Plot_MA_BB, color = BBTrend > MA_BB ? color.new(UpC, 80) : color.new(DnC, 80), title = 'Trend Fill')
//╔════════════════════════╗
//║          VIEW          ║
//╚════════════════════════╝
var table Table_BB = table.new(position.middle_right, 1, 1, border_width=1)
var label BBLabel = na

if barstate.islast
    string signalText = na
    color signalColor = na
    if showHist
        if isBull_BB_Hist
            signalText := '⬆️ Bullish'
            signalColor := UpC
        else
            signalText := '⬇️ Bearish'
            signalColor := DnC
    else
        if isBull_BB
            signalText := '⬆️ Bullish'
            signalColor := UpC
        else
            signalText := '⬇️ Bearish'
            signalColor := DnC

    table.cell(Table_BB, 0, 0, text=signalText, text_color=signalColor, text_size=size.huge)
    if not na(BBLabel)
        label.delete(BBLabel)

    BBLabel := label.new(bar_index + 5, showHist ? BBTrend_Hist : BBTrend, text=str.tostring(showHist ? BBTrend_Hist : BBTrend, '#.##'), color = showHist ? (isBull_BB_Hist ? UpC : DnC) : (isBull_BB ? UpC : DnC), style=label.style_label_left, size=size.large, textcolor=color.black)
//╔════════════════════════╗
//║         Alerts         ║
//╚════════════════════════╝
alertcondition(Bull_BB_Hist, title='LONG', message='{{ticker}} LONG')
alertcondition(Bear_BB_Hist, title='SHORT', message='{{ticker}} SHORT')
alertcondition(Bull_BB, title='LONG', message='{{ticker}} LONG')
alertcondition(Bear_BB, title='SHORT', message='{{ticker}} SHORT')
