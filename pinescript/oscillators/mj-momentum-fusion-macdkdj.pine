//@version=6
indicator("MJ", overlay=false, shorttitle="MJ_2Bar")

// --- Inputs ---
shortLen = input.int(12, "MACD Short Period")
longLen = input.int(26, "MACD Long Period")
midLen = input.int(9, "MACD Signal Period")
kdjP1 = input.int(9, "KDJ P1 (RSV)")
kdjP2 = input.int(3, "KDJ P2 (K)")
kdjP3 = input.int(3, "KDJ P3 (D)")
nLookback = input.int(300, "Normalization Lookback")

// --- Calculations ---
lowMin = ta.lowest(low, kdjP1)
highMax = ta.highest(high, kdjP1)
rsv = 100 * (close - lowMin) / (highMax - lowMin)
k = ta.sma(rsv, kdjP2)
d = ta.sma(k, kdjP3)
j = 3 * k - 2 * d

dif = ta.ema(close, shortLen) - ta.ema(close, longLen)
dea = ta.ema(dif, midLen)
macd = (dif - dea) * 2

// --- MJ Normalization Engine ---
kdjMax = ta.highest(math.max(k, math.max(d, j)), nLookback)
kdjMin = ta.lowest(math.min(k, math.min(d, j)), nLookback)
kdj_A2 = (kdjMax - kdjMin)
kdj_M2 = (kdjMax + kdjMin) / 2

macdMax = ta.highest(math.max(dif, math.max(dea, macd)), nLookback)
macdMin = ta.lowest(math.min(dif, math.min(dea, macd)), nLookback)
macd_A1 = (macdMax - macdMin)
macd_M1 = (macdMax + macdMin) / 2

new_base = (0 - macd_M1) * kdj_A2 / macd_A1 + kdj_M2

// Normalized Lines
j_new = j - new_base
macd_new = (macd - macd_M1) * kdj_A2 / macd_A1 + kdj_M2 - new_base

// --- 2-BAR WINDOW LOGIC ---
// Detect exactly when the MACD changes color
macd_green = macd_new > 0
macd_red = macd_new < 0

// barssince returns 0 on the bar it happens. 0 = 1st bar, 1 = 2nd bar.
time_since_green = ta.barssince(ta.crossover(macd_new, 0))
time_since_red = ta.barssince(ta.crossunder(macd_new, 0))

// Signal only if J-Cross happens within first 2 bars of MACD color change
bullish_signal = ta.crossover(j_new, 0) and macd_green and time_since_green <= 1
bearish_signal = ta.crossunder(j_new, 0) and macd_red and time_since_red <= 1

// --- Plotting ---
hline(0, "Zero Line", color=color.new(color.gray, 50))
plot(macd_new, "MACD Histogram", color = macd_new >= 0 ? color.new(#26a69a, 60) : color.new(#ef5350, 60), style=plot.style_columns)
plot(j_new, "J Line", color=#2196f3, linewidth=2)

// Arrows at the 0-line for clarity
plotshape(bullish_signal ? 0 : na, "Buy", shape.triangleup, location.absolute, color.green, size=size.small, text="BUY")
plotshape(bearish_signal ? 0 : na, "Sell", shape.triangledown, location.absolute, color.red, size=size.small, text="SELL")

// --- Dashboard ---
var table mjTab = table.new(position.top_right, 2, 2, border_width=1)
if barstate.islast
    table.cell(mjTab, 0, 0, "Window Type", bgcolor=color.black, text_color=color.white)
    table.cell(mjTab, 1, 0, "Early Entry", bgcolor=color.purple, text_color=color.white)

// --- Alerts ---
alertcondition(bullish_signal, "MJ Buy", "MACD Green + J-Cross - {{ticker}}")
alertcondition(bearish_signal, "MJ Sell", "MACD Red + J-Cross - {{ticker}}")
