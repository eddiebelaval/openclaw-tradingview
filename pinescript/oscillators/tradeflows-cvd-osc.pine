//@version=6
indicator("TradeFlows CVD_OSC")
plot(close)
//@version=6


//============================
// CVD SOURCE (TradingView)
//============================
import TradingView/ta/8

anchorInput = input.timeframe("1D", "Anchor period")

useCustomTimeframeInput = input.bool(false, "Use custom timeframe")
lowerTimeframeInput = input.timeframe("1", "Custom TF")

var lowerTimeframe = switch
    useCustomTimeframeInput => lowerTimeframeInput
    timeframe.isseconds     => "1S"
    timeframe.isintraday    => "1"
    timeframe.isdaily       => "5"
    => "60"

[openVolume, maxVolume, minVolume, lastVolume] = ta.requestVolumeDelta(lowerTimeframe, anchorInput)

//============================
// CVD HISTOGRAM
//============================
cvdColor = lastVolume >= openVolume ? color.teal : color.red

hline(0, "Zero")

plotcandle(
     openVolume,
     maxVolume,
     minVolume,
     lastVolume,
     "CVD Histogram",
     color=cvdColor,
     bordercolor=cvdColor,
     wickcolor=cvdColor)

//============================
// OSCILLATOR SETTINGS
//============================
shortPeriod = input.int(34, "Fast Length")
longPeriod  = input.int(200, "Slow Length")

showDivergences = input.bool(true, "Show Divergences")
showCrossovers  = input.bool(true, "Show Zero Crosses")

//============================
// VOLUME DELTA APPROX
//============================
volDelta = volume * (close - open) / math.abs(high - low + 0.000001)

// EMA smoothing
fastCVD = ta.ema(volDelta, shortPeriod)
slowCVD = ta.ema(volDelta, longPeriod)

cvdOsc = fastCVD - slowCVD

//============================
// CROSS SIGNALS
//============================
crossBullish = ta.crossover(cvdOsc, 0)
crossBearish = ta.crossunder(cvdOsc, 0)

plotshape(showCrossovers and crossBullish,
     title="Bullish Cross",
     style=shape.circle,
     location=location.bottom,
     color=color.green,
     size=size.tiny)

plotshape(showCrossovers and crossBearish,
     title="Bearish Cross",
     style=shape.circle,
     location=location.top,
     color=color.red,
     size=size.tiny)

//============================
// DIVERGENCE LOGIC
//============================
bullishDiv = ta.falling(low, 2) and ta.rising(cvdOsc, 2)
bearishDiv = ta.rising(high, 2) and ta.falling(cvdOsc, 2)

plotshape(showDivergences and bullishDiv,
     title="Bullish Divergence",
     style=shape.triangleup,
     location=location.bottom,
     color=color.lime,
     size=size.small)

plotshape(showDivergences and bearishDiv,
     title="Bearish Divergence",
     style=shape.triangledown,
     location=location.top,
     color=color.red,
     size=size.small)

//============================
// ALERTS
//============================
if bullishDiv
    alert("Bullish CVD Divergence on " + syminfo.ticker, alert.freq_once_per_bar)

if bearishDiv
    alert("Bearish CVD Divergence on " + syminfo.ticker, alert.freq_once_per_bar)

if crossBullish
    alert("Bullish CVD Zero Cross on " + syminfo.ticker, alert.freq_once_per_bar)

if crossBearish
    alert("Bearish CVD Zero Cross on " + syminfo.ticker, alert.freq_once_per_bar)

//============================
// VOLUME CHECK
//============================
var cumVol = 0.
cumVol += nz(volume)

if barstate.islast and cumVol == 0
    runtime.error("No volume data for this symbol.")
