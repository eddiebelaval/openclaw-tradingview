//@version=5
indicator("W-MREI (Weekly Mean-Reversion Exhaustion Index)", overlay=false, timeframe="W")

meanLen     = input.int(50,  "Mean Length (SMA)", minval=10)
zLen        = input.int(50,  "Z-Score StdDev Length", minval=10)
bbLen       = input.int(20,  "BB Length", minval=10)
bbMult      = input.float(2.0, "BB Mult", step=0.1)

atrLen      = input.int(14,  "ATR Length", minval=5)
atrSmooth   = input.int(50,  "ATR Smooth", minval=10)
atrTh       = input.float(1.20, "ATR Expansion Threshold", step=0.05)

zTop        = input.float(2.0,  "Z Top", step=0.1)
zBot        = input.float(-2.0, "Z Bottom", step=0.1)

useATRFilter = input.bool(true, "Use ATR Expansion Filter")

mean = ta.sma(close, meanLen)
std  = ta.stdev(close, zLen)
z    = std != 0 ? (close - mean) / std : 0.0

basis = ta.sma(close, bbLen)
dev   = bbMult * ta.stdev(close, bbLen)
upper = basis + dev
lower = basis - dev
pb    = (upper != lower) ? (close - lower) / (upper - lower) : 0.5

atr    = ta.atr(atrLen)
atrAvg = ta.sma(atr, atrSmooth)
atrExp = atrAvg != 0 ? atr / atrAvg : 1.0

atrOK = not useATRFilter or (atrExp >= atrTh)

pbC = (pb - 0.5) * 2.0
score = (0.75 * z) + (0.25 * (pbC * 2.0))

topZone    = atrOK and (z >= zTop) and (pb >= 1.0)
bottomZone = atrOK and (z <= zBot) and (pb <= 0.0)

plot(score, title="W-MREI Score", linewidth=2)
hline(0, "Equilibrium", linestyle=hline.style_dotted)
hline(zTop, "Z Top", linestyle=hline.style_dashed)
hline(zBot, "Z Bottom", linestyle=hline.style_dashed)

plot(z,  title="Z-Score", display=display.none)
plot(pb, title="%B", display=display.none)
plot(atrExp, title="ATR Expansion", display=display.none)

bgcolor(topZone ? color.new(color.red, 85) : na)
bgcolor(bottomZone ? color.new(color.green, 85) : na)
