//@version=6
indicator("Probable Range [Alpha Extract]", overlay=false)
source = input.source(close,'Source')
bandTopColor = color.rgb(255, 0, 0)
bandBottomColor = color.rgb(81, 253, 224)
oscillatorLineColor = color.rgb(0, 255, 208)
smoothedLineColor = color.rgb(196, 188, 176, 30)
positionPositiveColor = color.rgb(0, 255, 200)
positionNegativeColor = color.rgb(255, 0, 0, 45)
helperDisplay = display.pane

bandColor(float level, int transparency) =>
    color.new(color.from_gradient(level, 0.0, 1.0, bandBottomColor, bandTopColor), transparency)

expandingStats(series float input, float upperSTD, float lowerSTD) =>
    var float cumSum = 0
    var float cumSquareSum = 0
    var int count = 0

    if not na(input)
        cumSum += input
        cumSquareSum += input * input
        count += 1

    expandingMean = cumSum / count
    varianceExpanding = (cumSquareSum / count) - (expandingMean * expandingMean)
    expandingSTD = math.sqrt(varianceExpanding)

    upperBand = expandingMean + (expandingSTD * upperSTD)
    lowerBand = expandingMean - (expandingSTD * lowerSTD)

    [expandingMean, expandingSTD, upperBand, lowerBand]

// Probable Range
window     = 20
confidence = input.float(0.95, "Confidence Level",options = [0.68, 0.95,0.99],group = 'Probable Range Settings')
subplot = input.string('Probable Oscillator',options = ['Probable Oscillator','Probable Position'],group = 'Subplot Plotting',title = 'Oscillator to show')

//Oscillator Settings
upperSTD = input.float(1.5,'Oscillator Upper', step=0.1,group = 'Probable Range Oscillator Settings')
lowerSTD = input.float(1.5,'Oscillator Lower', step=0.1,group = 'Probable Range Oscillator Settings')
probable_period = input.string('Medium Timeframe (Slow)',options = ['Low TimeFrame (Fastest Signals)','Low TimeFrame (Fast Signal)','Medium Timeframe (Fast)','Medium Timeframe (Slow)','High Timeframe (Medium Term Signals)','High Timeframe (Long Term Signals)'],group = 'Probable Range Position Settings',title = 'Position Period')
var pos_num = 0
if probable_period == 'Medium Timeframe (Slow)'
    pos_num := 30
if probable_period == 'Low TimeFrame (Fastest Signals)'
    pos_num := 7
if probable_period == 'Low TimeFrame (Fast Signal)'
    pos_num := 14
if probable_period == 'Medium Timeframe (Fast)'
    pos_num := 21
if probable_period == 'High Timeframe (Medium Term Signals)'
    pos_num := 40
if probable_period == 'High Timeframe (Long Term Signals)'
    pos_num := 60    

// Get z-score depending on confidence level
zScore = switch confidence
    0.68 => 1.0
    0.95 => 1.96
    0.99 => 2.33
    => 1.0  // default

// Rolling mean & std deviation of closing prices
meanPrice = ta.sma(source, window)
stdDev    = ta.stdev(source, window)

// Probable range
upperBound = meanPrice + zScore * stdDev
lowerBound = math.max(0.0, meanPrice - zScore * stdDev)
bandRange = upperBound - lowerBound
bandL1 = lowerBound + bandRange * 0.14
bandL2 = lowerBound + bandRange * 0.28
bandL3 = lowerBound + bandRange * 0.42
bandL4 = lowerBound + bandRange * 0.58
bandL5 = lowerBound + bandRange * 0.72
bandL6 = lowerBound + bandRange * 0.86

// Plotting
plot(upperBound, color=bandColor(1.0, 82), title="Upper Bound Glow", linewidth = 8, force_overlay = true, display = helperDisplay)
plot(lowerBound, color=bandColor(0.0, 82), title="Lower Bound Glow", linewidth = 8, force_overlay = true, display = helperDisplay)
p1 = plot(upperBound, color=bandColor(1.0, 0), title="Upper Bound", linewidth = 2, force_overlay = true)
bandP6 = plot(bandL6, color=bandColor(0.86, 48), title="Band Level 6", linewidth = 1, force_overlay = true, display = helperDisplay)
bandP5 = plot(bandL5, color=bandColor(0.72, 54), title="Band Level 5", linewidth = 1, force_overlay = true, display = helperDisplay)
bandP4 = plot(bandL4, color=bandColor(0.58, 60), title="Band Level 4", linewidth = 1, force_overlay = true, display = helperDisplay)
bandP3 = plot(bandL3, color=bandColor(0.42, 60), title="Band Level 3", linewidth = 1, force_overlay = true, display = helperDisplay)
bandP2 = plot(bandL2, color=bandColor(0.28, 54), title="Band Level 2", linewidth = 1, force_overlay = true, display = helperDisplay)
bandP1 = plot(bandL1, color=bandColor(0.14, 48), title="Band Level 1", linewidth = 1, force_overlay = true, display = helperDisplay)
p2 = plot(lowerBound, color=bandColor(0.0, 0), title="Lower Bound", linewidth = 2, force_overlay = true)
fill(p1, bandP6, color=bandColor(0.93, 88))
fill(bandP6, bandP5, color=bandColor(0.79, 89))
fill(bandP5, bandP4, color=bandColor(0.65, 90))
fill(bandP4, bandP3, color=bandColor(0.50, 91))
fill(bandP3, bandP2, color=bandColor(0.35, 90))
fill(bandP2, bandP1, color=bandColor(0.21, 89))
fill(bandP1, p2, color=bandColor(0.07, 88))

oscillator = (source - lowerBound ) / (upperBound - lowerBound) 
smoothed_oscillator = ta.sma(oscillator,7)
[expMean1, expSTD1, upBand1, lowBand1] = expandingStats(oscillator, upperSTD, lowerSTD)
oscRange = upBand1 - lowBand1
oscL1 = lowBand1 + oscRange * 0.14
oscL2 = lowBand1 + oscRange * 0.28
oscL3 = lowBand1 + oscRange * 0.42
oscL4 = lowBand1 + oscRange * 0.58
oscL5 = lowBand1 + oscRange * 0.72
oscL6 = lowBand1 + oscRange * 0.86
plot(subplot == 'Probable Oscillator' ? oscillator : na , color = oscillatorLineColor, title = 'Probable Range Oscillator',linewidth = 2)
plot(subplot == 'Probable Oscillator' ? smoothed_oscillator : na, color = smoothedLineColor, title = 'Probable Range Smoothed Oscillator')
plot(subplot == 'Probable Oscillator' ? upBand1 : na, color = bandColor(1.0, 82), title = 'Upper Band Glow', linewidth = 8, display = helperDisplay)
plot(subplot == 'Probable Oscillator' ? lowBand1 : na, color = bandColor(0.0, 82), title = 'Lower Band Glow', linewidth = 8, display = helperDisplay)
up = plot(subplot == 'Probable Oscillator' ? upBand1 : na, color = bandColor(1.0, 0), title = 'Upper Band')
lw = plot(subplot == 'Probable Oscillator' ? lowBand1 : na, color = bandColor(0.0, 0), title = 'Lower Band')
oscP6 = plot(subplot == 'Probable Oscillator' ? oscL6 : na, color = bandColor(0.86, 48), title = 'Oscillator Level 6', linewidth = 1, display = helperDisplay)
oscP5 = plot(subplot == 'Probable Oscillator' ? oscL5 : na, color = bandColor(0.72, 54), title = 'Oscillator Level 5', linewidth = 1, display = helperDisplay)
oscP4 = plot(subplot == 'Probable Oscillator' ? oscL4 : na, color = bandColor(0.58, 60), title = 'Oscillator Level 4', linewidth = 1, display = helperDisplay)
oscP3 = plot(subplot == 'Probable Oscillator' ? oscL3 : na, color = bandColor(0.42, 60), title = 'Oscillator Level 3', linewidth = 1, display = helperDisplay)
oscP2 = plot(subplot == 'Probable Oscillator' ? oscL2 : na, color = bandColor(0.28, 54), title = 'Oscillator Level 2', linewidth = 1, display = helperDisplay)
oscP1 = plot(subplot == 'Probable Oscillator' ? oscL1 : na, color = bandColor(0.14, 48), title = 'Oscillator Level 1', linewidth = 1, display = helperDisplay)
fill(up, oscP6, color = bandColor(0.93, 88))
fill(oscP6, oscP5, color = bandColor(0.79, 89))
fill(oscP5, oscP4, color = bandColor(0.65, 90))
fill(oscP4, oscP3, color = bandColor(0.50, 91))
fill(oscP3, oscP2, color = bandColor(0.35, 90))
fill(oscP2, oscP1, color = bandColor(0.21, 89))
fill(oscP1, lw, color = bandColor(0.07, 88))


probablehisto = ta.sma(oscillator,pos_num) - expMean1

plot(subplot == 'Probable Position' ? probablehisto : na, color = probablehisto > 0 ? positionPositiveColor : positionNegativeColor , style = plot.style_area)
