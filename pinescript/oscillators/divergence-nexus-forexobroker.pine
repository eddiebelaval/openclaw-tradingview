//@version=6
indicator("Divergence Nexus [forexobroker]",
     shorttitle="Div Nexus",
     overlay=true,
     max_lines_count=200,
     max_labels_count=100)

// ══════════════════════════════════════════════════════════════════════════════
// Divergence Nexus [forexobroker]
// Version 1.0
//
// 4-in-1 divergence detection hub scanning RSI, MACD histogram, Stochastic %K,
// and CCI simultaneously for regular and hidden divergences. Confluence scoring
// rates how many oscillators agree on the signal (1/4 weak to 4/4 very strong).
// Non-repainting confirmed divergences with visual lines and dashboard.
//
// (c) forexobroker | Open-source | Educational use
// ══════════════════════════════════════════════════════════════════════════════

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ INPUTS                                                                  │
// └──────────────────────────────────────────────────────────────────────────┘

// Oscillators
rsiLength   = input.int(14, "RSI Length", minval=2, maxval=50, group="Oscillators", tooltip="RSI lookback period")
macdFast    = input.int(12, "MACD Fast", minval=2, maxval=50, group="Oscillators", tooltip="MACD fast EMA length")
macdSlow    = input.int(26, "MACD Slow", minval=5, maxval=100, group="Oscillators", tooltip="MACD slow EMA length")
macdSignal  = input.int(9, "MACD Signal", minval=2, maxval=50, group="Oscillators", tooltip="MACD signal line length")
stochLength = input.int(14, "Stochastic Length", minval=2, maxval=50, group="Oscillators", tooltip="Stochastic %K lookback period")
cciLength   = input.int(20, "CCI Length", minval=2, maxval=100, group="Oscillators", tooltip="Commodity Channel Index lookback period")
enableRSI   = input.bool(true, "Enable RSI", group="Oscillators", tooltip="Include RSI in divergence scan")
enableMACD  = input.bool(true, "Enable MACD", group="Oscillators", tooltip="Include MACD histogram in divergence scan")
enableStoch = input.bool(true, "Enable Stochastic", group="Oscillators", tooltip="Include Stochastic %K in divergence scan")
enableCCI   = input.bool(true, "Enable CCI", group="Oscillators", tooltip="Include CCI in divergence scan")

// Detection
pivotLookback  = input.int(5, "Pivot Lookback", minval=2, maxval=20, group="Detection", tooltip="Bars left/right for pivot detection. Higher = fewer but stronger pivots")
minBarsBetween = input.int(5, "Min Bars Between Pivots", minval=2, maxval=30, group="Detection", tooltip="Minimum distance between two pivots to form a valid divergence")
maxBarsBetween = input.int(100, "Max Bars Between Pivots", minval=20, maxval=300, group="Detection", tooltip="Maximum distance between pivots. Beyond this a divergence is ignored")
detectRegular  = input.bool(true, "Detect Regular Divergences", group="Detection", tooltip="Regular divergences signal potential trend reversals")
detectHidden   = input.bool(true, "Detect Hidden Divergences", group="Detection", tooltip="Hidden divergences signal trend continuation")

// Display
showLines      = input.bool(true, "Show Divergence Lines", group="Display", tooltip="Draw divergence lines on the price chart")
showLabels     = input.bool(true, "Show Divergence Labels", group="Display", tooltip="Show labels with divergence type and confluence score")
showDashboard  = input.bool(true, "Show Dashboard", group="Display", tooltip="Display the divergence status dashboard")
showBgHighlight = input.bool(true, "Highlight High Confluence", group="Display", tooltip="Tint background when high-confluence divergence detected")
tablePos       = input.string("top_right", "Table Position", options=["top_left", "top_center", "top_right", "bottom_left", "bottom_center", "bottom_right"], group="Display", tooltip="Dashboard position on chart")
textSizeInput  = input.string("small", "Text Size", options=["tiny", "small", "normal"], group="Display", tooltip="Dashboard text size")
maxDrawings    = input.int(50, "Max Drawings", minval=10, maxval=100, group="Display", tooltip="Maximum divergence lines and labels kept on chart")

// Colors
bullRegColor = input.color(#26A69A, "Regular Bullish", group="Colors", tooltip="Color for regular bullish divergences (reversal up)")
bearRegColor = input.color(#EF5350, "Regular Bearish", group="Colors", tooltip="Color for regular bearish divergences (reversal down)")
bullHidColor = input.color(#2196F3, "Hidden Bullish", group="Colors", tooltip="Color for hidden bullish divergences (continuation up)")
bearHidColor = input.color(#FF9800, "Hidden Bearish", group="Colors", tooltip="Color for hidden bearish divergences (continuation down)")

// Alerts
minConfluenceAlert = input.int(3, "Min Confluence for Alert", minval=1, maxval=4, group="Alerts", tooltip="Minimum oscillator agreement (out of 4) to trigger high-confluence alert")

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ THEME-AWARE COLORS                                                      │
// └──────────────────────────────────────────────────────────────────────────┘
headerBg   = color.new(chart.fg_color, 85)
headerText = chart.fg_color
cellBg     = color.new(chart.bg_color, 20)
borderCol  = color.new(chart.fg_color, 75)
mutedText  = color.new(chart.fg_color, 50)

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ USER-DEFINED TYPES                                                      │
// └──────────────────────────────────────────────────────────────────────────┘
type PivotPoint
    int   barIdx
    float priceVal
    float oscVal

type DivResult
    bool   detected
    string divType    // "reg_bull", "reg_bear", "hid_bull", "hid_bear"
    int    bar1
    float  price1
    int    bar2
    float  price2

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ HELPER FUNCTIONS                                                        │
// └──────────────────────────────────────────────────────────────────────────┘
getTablePos(string pos) =>
    switch pos
        "top_left"      => position.top_left
        "top_center"    => position.top_center
        "top_right"     => position.top_right
        "bottom_left"   => position.bottom_left
        "bottom_center" => position.bottom_center
        "bottom_right"  => position.bottom_right
        => position.top_right

getTextSize(string s) =>
    switch s
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        => size.small

addPivot(array<PivotPoint> pivots, int barIdx, float priceVal, float oscVal) =>
    array.push(pivots, PivotPoint.new(barIdx, priceVal, oscVal))
    while array.size(pivots) > 10
        array.shift(pivots)

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ OSCILLATOR CALCULATIONS                                                 │
// └──────────────────────────────────────────────────────────────────────────┘
rsiVal   = ta.rsi(close, rsiLength)
[_, __, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)
stochVal = ta.stoch(close, high, low, stochLength)
cciVal   = ta.cci(hlc3, cciLength)

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ PIVOT DETECTION                                                         │
// └──────────────────────────────────────────────────────────────────────────┘
pricePivotHigh = ta.pivothigh(high, pivotLookback, pivotLookback)
pricePivotLow  = ta.pivotlow(low, pivotLookback, pivotLookback)

rsiPivotHigh   = ta.pivothigh(rsiVal, pivotLookback, pivotLookback)
rsiPivotLow    = ta.pivotlow(rsiVal, pivotLookback, pivotLookback)
macdPivotHigh  = ta.pivothigh(macdHist, pivotLookback, pivotLookback)
macdPivotLow   = ta.pivotlow(macdHist, pivotLookback, pivotLookback)
stochPivotHigh = ta.pivothigh(stochVal, pivotLookback, pivotLookback)
stochPivotLow  = ta.pivotlow(stochVal, pivotLookback, pivotLookback)
cciPivotHigh   = ta.pivothigh(cciVal, pivotLookback, pivotLookback)
cciPivotLow    = ta.pivotlow(cciVal, pivotLookback, pivotLookback)

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ PERSISTENT STATE                                                        │
// └──────────────────────────────────────────────────────────────────────────┘
// Pivot arrays per oscillator
var array<PivotPoint> rsiHighs   = array.new<PivotPoint>()
var array<PivotPoint> rsiLows    = array.new<PivotPoint>()
var array<PivotPoint> macdHighs  = array.new<PivotPoint>()
var array<PivotPoint> macdLows   = array.new<PivotPoint>()
var array<PivotPoint> stochHighs = array.new<PivotPoint>()
var array<PivotPoint> stochLows  = array.new<PivotPoint>()
var array<PivotPoint> cciHighs   = array.new<PivotPoint>()
var array<PivotPoint> cciLows    = array.new<PivotPoint>()

// Drawing cleanup arrays
var array<line>  divLines  = array.new<line>()
var array<label> divLabels = array.new<label>()

// Per-oscillator last detection tracking (for dashboard)
var string rsiLastBullType   = ""
var string rsiLastBearType   = ""
var int    rsiLastBullBar    = 0
var int    rsiLastBearBar    = 0
var string macdLastBullType  = ""
var string macdLastBearType  = ""
var int    macdLastBullBar   = 0
var int    macdLastBearBar   = 0
var string stochLastBullType = ""
var string stochLastBearType = ""
var int    stochLastBullBar  = 0
var int    stochLastBearBar  = 0
var string cciLastBullType   = ""
var string cciLastBearType   = ""
var int    cciLastBullBar    = 0
var int    cciLastBearBar    = 0

// Per-bar signal flags
bullConfluence = 0
bearConfluence = 0
bullSignal     = false
bearSignal     = false
highConfBull   = false
highConfBear   = false

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ DIVERGENCE DETECTION                                                    │
// └──────────────────────────────────────────────────────────────────────────┘
checkDivergence(array<PivotPoint> pivots, bool isHighPivot, bool checkReg, bool checkHid) =>
    result = DivResult.new(false, "", 0, 0.0, 0, 0.0)
    if array.size(pivots) >= 2
        recent   = array.get(pivots, array.size(pivots) - 1)
        previous = array.get(pivots, array.size(pivots) - 2)
        barsDiff = recent.barIdx - previous.barIdx
        if barsDiff >= minBarsBetween and barsDiff <= maxBarsBetween
            if isHighPivot
                // Bearish divergences (comparing highs)
                if checkReg and recent.priceVal > previous.priceVal and recent.oscVal < previous.oscVal
                    result := DivResult.new(true, "reg_bear", previous.barIdx, previous.priceVal, recent.barIdx, recent.priceVal)
                else if checkHid and recent.priceVal < previous.priceVal and recent.oscVal > previous.oscVal
                    result := DivResult.new(true, "hid_bear", previous.barIdx, previous.priceVal, recent.barIdx, recent.priceVal)
            else
                // Bullish divergences (comparing lows)
                if checkReg and recent.priceVal < previous.priceVal and recent.oscVal > previous.oscVal
                    result := DivResult.new(true, "reg_bull", previous.barIdx, previous.priceVal, recent.barIdx, recent.priceVal)
                else if checkHid and recent.priceVal > previous.priceVal and recent.oscVal < previous.oscVal
                    result := DivResult.new(true, "hid_bull", previous.barIdx, previous.priceVal, recent.barIdx, recent.priceVal)
    result

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ DRAWING FUNCTIONS                                                       │
// └──────────────────────────────────────────────────────────────────────────┘
getDivColor(string divType) =>
    divType == "reg_bull" ? bullRegColor : divType == "reg_bear" ? bearRegColor : divType == "hid_bull" ? bullHidColor : divType == "hid_bear" ? bearHidColor : color.gray

drawDivLine(int x1, float y1, int x2, float y2, string divType) =>
    lStyle = str.startswith(divType, "hid") ? line.style_dashed : line.style_solid
    newLine = line.new(x1, y1, x2, y2, color=getDivColor(divType), width=2, style=lStyle)
    array.push(divLines, newLine)
    if array.size(divLines) > maxDrawings
        line.delete(array.shift(divLines))

drawDivLabel(int x, float y, string divType, int confluence, bool isBelow) =>
    typeStr = str.startswith(divType, "hid") ? "H" : "R"
    dirStr  = str.contains(divType, "bull") ? "Bull" : "Bear"
    lText   = typeStr + " " + dirStr + " " + str.tostring(confluence) + "/4"
    lStyle  = isBelow ? label.style_label_up : label.style_label_down
    newLabel = label.new(x, y, lText, color=getDivColor(divType), textcolor=color.white, size=size.tiny, style=lStyle)
    array.push(divLabels, newLabel)
    if array.size(divLabels) > maxDrawings
        label.delete(array.shift(divLabels))

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ MAIN PROCESSING                                                         │
// └──────────────────────────────────────────────────────────────────────────┘
pivotBar = bar_index - pivotLookback

// Track the last divergence type + bar for labels
var string lastBullDivType = ""
var int    lastBullDivBar2 = 0
var float  lastBullPrice2  = 0.0
var string lastBearDivType = ""
var int    lastBearDivBar2 = 0
var float  lastBearPrice2  = 0.0

if barstate.isconfirmed
    // Reset per-bar counters
    bullConfluence := 0
    bearConfluence := 0
    lastBullDivType := ""
    lastBearDivType := ""

    // ── Add pivots ──
    if enableRSI
        if not na(pricePivotHigh) and not na(rsiPivotHigh)
            addPivot(rsiHighs, pivotBar, pricePivotHigh, rsiPivotHigh)
        if not na(pricePivotLow) and not na(rsiPivotLow)
            addPivot(rsiLows, pivotBar, pricePivotLow, rsiPivotLow)

    if enableMACD
        if not na(pricePivotHigh) and not na(macdPivotHigh)
            addPivot(macdHighs, pivotBar, pricePivotHigh, macdPivotHigh)
        if not na(pricePivotLow) and not na(macdPivotLow)
            addPivot(macdLows, pivotBar, pricePivotLow, macdPivotLow)

    if enableStoch
        if not na(pricePivotHigh) and not na(stochPivotHigh)
            addPivot(stochHighs, pivotBar, pricePivotHigh, stochPivotHigh)
        if not na(pricePivotLow) and not na(stochPivotLow)
            addPivot(stochLows, pivotBar, pricePivotLow, stochPivotLow)

    if enableCCI
        if not na(pricePivotHigh) and not na(cciPivotHigh)
            addPivot(cciHighs, pivotBar, pricePivotHigh, cciPivotHigh)
        if not na(pricePivotLow) and not na(cciPivotLow)
            addPivot(cciLows, pivotBar, pricePivotLow, cciPivotLow)

    // ── Detect divergences ──
    // RSI
    if enableRSI
        rsiBull = checkDivergence(rsiLows, false, detectRegular, detectHidden)
        rsiBear = checkDivergence(rsiHighs, true, detectRegular, detectHidden)
        if rsiBull.detected
            rsiLastBullType := str.startswith(rsiBull.divType, "hid") ? "hid" : "reg"
            rsiLastBullBar  := bar_index
            bullConfluence  += 1
            lastBullDivType := rsiBull.divType
            lastBullDivBar2 := rsiBull.bar2
            lastBullPrice2  := rsiBull.price2
            if showLines
                drawDivLine(rsiBull.bar1, rsiBull.price1, rsiBull.bar2, rsiBull.price2, rsiBull.divType)
        if rsiBear.detected
            rsiLastBearType := str.startswith(rsiBear.divType, "hid") ? "hid" : "reg"
            rsiLastBearBar  := bar_index
            bearConfluence  += 1
            lastBearDivType := rsiBear.divType
            lastBearDivBar2 := rsiBear.bar2
            lastBearPrice2  := rsiBear.price2
            if showLines
                drawDivLine(rsiBear.bar1, rsiBear.price1, rsiBear.bar2, rsiBear.price2, rsiBear.divType)

    // MACD
    if enableMACD
        macdBull = checkDivergence(macdLows, false, detectRegular, detectHidden)
        macdBear = checkDivergence(macdHighs, true, detectRegular, detectHidden)
        if macdBull.detected
            macdLastBullType := str.startswith(macdBull.divType, "hid") ? "hid" : "reg"
            macdLastBullBar  := bar_index
            bullConfluence   += 1
            lastBullDivType  := macdBull.divType
            lastBullDivBar2  := macdBull.bar2
            lastBullPrice2   := macdBull.price2
            if showLines
                drawDivLine(macdBull.bar1, macdBull.price1, macdBull.bar2, macdBull.price2, macdBull.divType)
        if macdBear.detected
            macdLastBearType := str.startswith(macdBear.divType, "hid") ? "hid" : "reg"
            macdLastBearBar  := bar_index
            bearConfluence   += 1
            lastBearDivType  := macdBear.divType
            lastBearDivBar2  := macdBear.bar2
            lastBearPrice2   := macdBear.price2
            if showLines
                drawDivLine(macdBear.bar1, macdBear.price1, macdBear.bar2, macdBear.price2, macdBear.divType)

    // Stochastic
    if enableStoch
        stochBull = checkDivergence(stochLows, false, detectRegular, detectHidden)
        stochBear = checkDivergence(stochHighs, true, detectRegular, detectHidden)
        if stochBull.detected
            stochLastBullType := str.startswith(stochBull.divType, "hid") ? "hid" : "reg"
            stochLastBullBar  := bar_index
            bullConfluence    += 1
            lastBullDivType   := stochBull.divType
            lastBullDivBar2   := stochBull.bar2
            lastBullPrice2    := stochBull.price2
            if showLines
                drawDivLine(stochBull.bar1, stochBull.price1, stochBull.bar2, stochBull.price2, stochBull.divType)
        if stochBear.detected
            stochLastBearType := str.startswith(stochBear.divType, "hid") ? "hid" : "reg"
            stochLastBearBar  := bar_index
            bearConfluence    += 1
            lastBearDivType   := stochBear.divType
            lastBearDivBar2   := stochBear.bar2
            lastBearPrice2    := stochBear.price2
            if showLines
                drawDivLine(stochBear.bar1, stochBear.price1, stochBear.bar2, stochBear.price2, stochBear.divType)

    // CCI
    if enableCCI
        cciBull = checkDivergence(cciLows, false, detectRegular, detectHidden)
        cciBear = checkDivergence(cciHighs, true, detectRegular, detectHidden)
        if cciBull.detected
            cciLastBullType := str.startswith(cciBull.divType, "hid") ? "hid" : "reg"
            cciLastBullBar  := bar_index
            bullConfluence  += 1
            lastBullDivType := cciBull.divType
            lastBullDivBar2 := cciBull.bar2
            lastBullPrice2  := cciBull.price2
            if showLines
                drawDivLine(cciBull.bar1, cciBull.price1, cciBull.bar2, cciBull.price2, cciBull.divType)
        if cciBear.detected
            cciLastBearType := str.startswith(cciBear.divType, "hid") ? "hid" : "reg"
            cciLastBearBar  := bar_index
            bearConfluence  += 1
            lastBearDivType := cciBear.divType
            lastBearDivBar2 := cciBear.bar2
            lastBearPrice2  := cciBear.price2
            if showLines
                drawDivLine(cciBear.bar1, cciBear.price1, cciBear.bar2, cciBear.price2, cciBear.divType)

    // ── Confluence scoring & labels ──
    if bullConfluence > 0
        bullSignal := true
        if bullConfluence >= minConfluenceAlert
            highConfBull := true
        if showLabels
            drawDivLabel(lastBullDivBar2, lastBullPrice2, lastBullDivType, bullConfluence, true)

    if bearConfluence > 0
        bearSignal := true
        if bearConfluence >= minConfluenceAlert
            highConfBear := true
        if showLabels
            drawDivLabel(lastBearDivBar2, lastBearPrice2, lastBearDivType, bearConfluence, false)

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ VISUAL SIGNALS                                                          │
// └──────────────────────────────────────────────────────────────────────────┘
plotshape(bullSignal, "Bull Divergence Marker", shape.diamond, location.belowbar, color=bullRegColor, size=size.tiny, display=display.pane)
plotshape(bearSignal, "Bear Divergence Marker", shape.diamond, location.abovebar, color=bearRegColor, size=size.tiny, display=display.pane)

bgcolor(showBgHighlight and highConfBull ? color.new(bullRegColor, 90) : na, title="High Confluence Bull BG")
bgcolor(showBgHighlight and highConfBear ? color.new(bearRegColor, 90) : na, title="High Confluence Bear BG")

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ DASHBOARD TABLE                                                         │
// └──────────────────────────────────────────────────────────────────────────┘
var table dashTable = table.new(getTablePos(tablePos), 6, 7, bgcolor=cellBg, border_width=1, border_color=borderCol, frame_width=2, frame_color=borderCol)

if barstate.islast and showDashboard
    sz      = getTextSize(textSizeInput)
    titleBg = color.new(#1565C0, 15)
    RECENCY = 50

    // Row 0: Title
    table.cell(dashTable, 0, 0, "DIVERGENCE NEXUS", bgcolor=titleBg, text_color=headerText, text_size=sz, text_halign=text.align_left)
    table.cell(dashTable, 1, 0, "", bgcolor=titleBg, text_color=headerText, text_size=sz)
    table.cell(dashTable, 2, 0, "", bgcolor=titleBg, text_color=headerText, text_size=sz)
    table.cell(dashTable, 3, 0, "", bgcolor=titleBg, text_color=headerText, text_size=sz)
    table.cell(dashTable, 4, 0, "", bgcolor=titleBg, text_color=headerText, text_size=sz)
    table.cell(dashTable, 5, 0, "forexobroker", bgcolor=titleBg, text_color=mutedText, text_size=size.tiny, text_halign=text.align_right)

    // Row 1: Headers
    table.cell(dashTable, 0, 1, "OSCILLATOR", bgcolor=headerBg, text_color=headerText, text_size=sz, text_halign=text.align_left)
    table.cell(dashTable, 1, 1, "R.BULL", bgcolor=headerBg, text_color=bullRegColor, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 2, 1, "H.BULL", bgcolor=headerBg, text_color=bullHidColor, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 3, 1, "R.BEAR", bgcolor=headerBg, text_color=bearRegColor, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 4, 1, "H.BEAR", bgcolor=headerBg, text_color=bearHidColor, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 5, 1, "STATUS", bgcolor=headerBg, text_color=headerText, text_size=sz, text_halign=text.align_center)

    // Helper: determine cell icon and status per oscillator
    // RSI — Row 2
    rsiBullRecent = enableRSI and rsiLastBullBar > 0 and (bar_index - rsiLastBullBar) < RECENCY
    rsiBearRecent = enableRSI and rsiLastBearBar > 0 and (bar_index - rsiLastBearBar) < RECENCY
    rsiStatus     = rsiBullRecent and rsiBearRecent ? "MIXED" : rsiBullRecent ? "BULL" : rsiBearRecent ? "BEAR" : enableRSI ? "--" : "OFF"
    rsiStatusCol  = rsiBullRecent ? bullRegColor : rsiBearRecent ? bearRegColor : mutedText
    table.cell(dashTable, 0, 2, "RSI", bgcolor=cellBg, text_color=headerText, text_size=sz, text_halign=text.align_left)
    table.cell(dashTable, 1, 2, rsiBullRecent and rsiLastBullType == "reg" ? "+" : "--", bgcolor=cellBg, text_color=rsiBullRecent and rsiLastBullType == "reg" ? bullRegColor : mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 2, 2, rsiBullRecent and rsiLastBullType == "hid" ? "+" : "--", bgcolor=cellBg, text_color=rsiBullRecent and rsiLastBullType == "hid" ? bullHidColor : mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 3, 2, rsiBearRecent and rsiLastBearType == "reg" ? "+" : "--", bgcolor=cellBg, text_color=rsiBearRecent and rsiLastBearType == "reg" ? bearRegColor : mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 4, 2, rsiBearRecent and rsiLastBearType == "hid" ? "+" : "--", bgcolor=cellBg, text_color=rsiBearRecent and rsiLastBearType == "hid" ? bearHidColor : mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 5, 2, rsiStatus, bgcolor=cellBg, text_color=rsiStatusCol, text_size=sz, text_halign=text.align_center)

    // MACD — Row 3
    macdBullRecent = enableMACD and macdLastBullBar > 0 and (bar_index - macdLastBullBar) < RECENCY
    macdBearRecent = enableMACD and macdLastBearBar > 0 and (bar_index - macdLastBearBar) < RECENCY
    macdStatus     = macdBullRecent and macdBearRecent ? "MIXED" : macdBullRecent ? "BULL" : macdBearRecent ? "BEAR" : enableMACD ? "--" : "OFF"
    macdStatusCol  = macdBullRecent ? bullRegColor : macdBearRecent ? bearRegColor : mutedText
    table.cell(dashTable, 0, 3, "MACD", bgcolor=headerBg, text_color=headerText, text_size=sz, text_halign=text.align_left)
    table.cell(dashTable, 1, 3, macdBullRecent and macdLastBullType == "reg" ? "+" : "--", bgcolor=headerBg, text_color=macdBullRecent and macdLastBullType == "reg" ? bullRegColor : mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 2, 3, macdBullRecent and macdLastBullType == "hid" ? "+" : "--", bgcolor=headerBg, text_color=macdBullRecent and macdLastBullType == "hid" ? bullHidColor : mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 3, 3, macdBearRecent and macdLastBearType == "reg" ? "+" : "--", bgcolor=headerBg, text_color=macdBearRecent and macdLastBearType == "reg" ? bearRegColor : mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 4, 3, macdBearRecent and macdLastBearType == "hid" ? "+" : "--", bgcolor=headerBg, text_color=macdBearRecent and macdLastBearType == "hid" ? bearHidColor : mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 5, 3, macdStatus, bgcolor=headerBg, text_color=macdStatusCol, text_size=sz, text_halign=text.align_center)

    // STOCH — Row 4
    stochBullRecent = enableStoch and stochLastBullBar > 0 and (bar_index - stochLastBullBar) < RECENCY
    stochBearRecent = enableStoch and stochLastBearBar > 0 and (bar_index - stochLastBearBar) < RECENCY
    stochStatus     = stochBullRecent and stochBearRecent ? "MIXED" : stochBullRecent ? "BULL" : stochBearRecent ? "BEAR" : enableStoch ? "--" : "OFF"
    stochStatusCol  = stochBullRecent ? bullRegColor : stochBearRecent ? bearRegColor : mutedText
    table.cell(dashTable, 0, 4, "STOCH", bgcolor=cellBg, text_color=headerText, text_size=sz, text_halign=text.align_left)
    table.cell(dashTable, 1, 4, stochBullRecent and stochLastBullType == "reg" ? "+" : "--", bgcolor=cellBg, text_color=stochBullRecent and stochLastBullType == "reg" ? bullRegColor : mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 2, 4, stochBullRecent and stochLastBullType == "hid" ? "+" : "--", bgcolor=cellBg, text_color=stochBullRecent and stochLastBullType == "hid" ? bullHidColor : mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 3, 4, stochBearRecent and stochLastBearType == "reg" ? "+" : "--", bgcolor=cellBg, text_color=stochBearRecent and stochLastBearType == "reg" ? bearRegColor : mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 4, 4, stochBearRecent and stochLastBearType == "hid" ? "+" : "--", bgcolor=cellBg, text_color=stochBearRecent and stochLastBearType == "hid" ? bearHidColor : mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 5, 4, stochStatus, bgcolor=cellBg, text_color=stochStatusCol, text_size=sz, text_halign=text.align_center)

    // CCI — Row 5
    cciBullRecent = enableCCI and cciLastBullBar > 0 and (bar_index - cciLastBullBar) < RECENCY
    cciBearRecent = enableCCI and cciLastBearBar > 0 and (bar_index - cciLastBearBar) < RECENCY
    cciStatus     = cciBullRecent and cciBearRecent ? "MIXED" : cciBullRecent ? "BULL" : cciBearRecent ? "BEAR" : enableCCI ? "--" : "OFF"
    cciStatusCol  = cciBullRecent ? bullRegColor : cciBearRecent ? bearRegColor : mutedText
    table.cell(dashTable, 0, 5, "CCI", bgcolor=headerBg, text_color=headerText, text_size=sz, text_halign=text.align_left)
    table.cell(dashTable, 1, 5, cciBullRecent and cciLastBullType == "reg" ? "+" : "--", bgcolor=headerBg, text_color=cciBullRecent and cciLastBullType == "reg" ? bullRegColor : mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 2, 5, cciBullRecent and cciLastBullType == "hid" ? "+" : "--", bgcolor=headerBg, text_color=cciBullRecent and cciLastBullType == "hid" ? bullHidColor : mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 3, 5, cciBearRecent and cciLastBearType == "reg" ? "+" : "--", bgcolor=headerBg, text_color=cciBearRecent and cciLastBearType == "reg" ? bearRegColor : mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 4, 5, cciBearRecent and cciLastBearType == "hid" ? "+" : "--", bgcolor=headerBg, text_color=cciBearRecent and cciLastBearType == "hid" ? bearHidColor : mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 5, 5, cciStatus, bgcolor=headerBg, text_color=cciStatusCol, text_size=sz, text_halign=text.align_center)

    // Row 6: Confluence summary
    totalBull = (rsiBullRecent ? 1 : 0) + (macdBullRecent ? 1 : 0) + (stochBullRecent ? 1 : 0) + (cciBullRecent ? 1 : 0)
    totalBear = (rsiBearRecent ? 1 : 0) + (macdBearRecent ? 1 : 0) + (stochBearRecent ? 1 : 0) + (cciBearRecent ? 1 : 0)
    confSignal = totalBull >= minConfluenceAlert ? "BULLISH" : totalBear >= minConfluenceAlert ? "BEARISH" : "--"
    confSigCol = totalBull >= minConfluenceAlert ? bullRegColor : totalBear >= minConfluenceAlert ? bearRegColor : mutedText
    table.cell(dashTable, 0, 6, "CONFLUENCE", bgcolor=cellBg, text_color=headerText, text_size=sz, text_halign=text.align_left)
    table.cell(dashTable, 1, 6, str.tostring(totalBull) + "/4", bgcolor=cellBg, text_color=totalBull > 0 ? bullRegColor : mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 2, 6, "BULL", bgcolor=cellBg, text_color=mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 3, 6, str.tostring(totalBear) + "/4", bgcolor=cellBg, text_color=totalBear > 0 ? bearRegColor : mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 4, 6, "BEAR", bgcolor=cellBg, text_color=mutedText, text_size=sz, text_halign=text.align_center)
    table.cell(dashTable, 5, 6, confSignal, bgcolor=cellBg, text_color=confSigCol, text_size=sz, text_halign=text.align_center)

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ DATA WINDOW                                                             │
// └──────────────────────────────────────────────────────────────────────────┘
plot(rsiVal,                "RSI",              display=display.data_window)
plot(macdHist,              "MACD Histogram",   display=display.data_window)
plot(stochVal,              "Stochastic %K",    display=display.data_window)
plot(cciVal,                "CCI",              display=display.data_window)
plot(bullConfluence * 1.0,  "Bull Confluence",  display=display.data_window)
plot(bearConfluence * 1.0,  "Bear Confluence",  display=display.data_window)

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ ALERT CONDITIONS                                                        │
// └──────────────────────────────────────────────────────────────────────────┘
alertcondition(bullSignal, "Bullish Divergence", "Divergence Nexus — Bullish divergence detected")
alertcondition(bearSignal, "Bearish Divergence", "Divergence Nexus — Bearish divergence detected")
alertcondition(highConfBull, "High-Confluence Bullish", "Divergence Nexus — High-confluence bullish divergence")
alertcondition(highConfBear, "High-Confluence Bearish", "Divergence Nexus — High-confluence bearish divergence")
alertcondition(bullSignal or bearSignal, "Any Divergence", "Divergence Nexus — Divergence detected")
alertcondition(highConfBull or highConfBear, "Any High-Confluence", "Divergence Nexus — High-confluence divergence detected")
// ══════════════════════════════════════════════════════════════════════════════
// END
// ══════════════════════════════════════════════════════════════════════════════
