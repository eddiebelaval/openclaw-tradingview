//@version=5
indicator("MACD + RSI Confirmation Signals", overlay=true)

// ==== INPUTS ====
src = input.source(close, "Source")
fastMA = input.int(12, "Fast MA", minval=1)
slowMA = input.int(26, "Slow MA", minval=1)
signalLength = input.int(9, "MACD Signal Length", minval=1)
rsiLength = input.int(14, "RSI Length", minval=1)

// ==== MACD ====
[macdLine, macdSignal, macdHist] = ta.macd(src, fastMA, slowMA, signalLength)

// ==== RSI ====
rsi = ta.rsi(src, rsiLength)

// ==== CONDITIONS ====
// Signal state
bullCondition = macdLine > 0 and rsi > 50
bearCondition = macdLine < 0 and rsi < 50

// Generate signal only once when condition turns true
buySignal = bullCondition and not bullCondition[1]
sellSignal = bearCondition and not bearCondition[1]

// ==== PLOTS ====
plotshape(buySignal, title="BUY", location=location.belowbar,
     color=color.lime, style=shape.labelup, text="BUY", size=size.small)

plotshape(sellSignal, title="SELL", location=location.abovebar,
     color=color.red, style=shape.labeldown, text="SELL", size=size.small)

// Alerts
alertcondition(buySignal, title="Buy Alert", message="MACD > 0 and RSI > 50")
alertcondition(sellSignal, title="Sell Alert", message="MACD < 0 and RSI < 50")
