//@version=6
indicator("RenderingNature MFx Radar | Money Flow Momentum)", overlay=false, max_lines_count=500, max_labels_count=500, max_bars_back=1200)

// ============================================================
// MFx Radar — Rebuilt w/ Roadmap Fixes
// Fixes: #1,#2,#3,#4,#6,#7,#8,#9,#11,#12,#13
// ============================================================

// === Display Toggles ===
showTable              = input.bool(true,  "Show Decision Table")
minimalMode            = input.bool(false, "Minimal Mode (Hide UI)")
dashboardTextSize      = input.string("Small", title="Dashboard Text Size", options=["Tiny","Small","Normal"])
dashboardTextSizeConst = dashboardTextSize == "Tiny" ? size.tiny : dashboardTextSize == "Small" ? size.small : size.normal

// === Trigger / Visuals ===
showTriggers             = input.bool(true,  "Show Trigger Diamonds")
showWTcrosses            = input.bool(true,  "Show WT Cross Circles")
showWaveLabels           = input.bool(true,  "Show Anchor/Trigger/Snake Eye Labels?")
showFlipLabels           = input.bool(true,  "Show Accum/Distr Text Labels")
showConfidenceEmoji      = input.bool(true,  "Show Confidence Emoji Above Candle")
showHiddenDistrHighlight = input.bool(true,  "🟠 Show Hidden Distribution Highlight (Price ↑, MF ↓)")

// === Trigger Diamond Shapes ===
bullTriggerShapeOption      = input.string("Diamond", "Bullish Trigger Shape", options=["Diamond","Circle","Arrow Up","Arrow Down","Square","Triangle Up","Triangle Down","Label Up","Label Down","X Cross","Flag"])
bearTriggerShapeOption      = input.string("Diamond", "Bearish Trigger Shape", options=["Diamond","Circle","Arrow Up","Arrow Down","Square","Triangle Up","Triangle Down","Label Up","Label Down","X Cross","Flag"])
greenDotShapeOption         = input.string("Circle",  "Green Dot Shape", options=["Diamond","Circle","Arrow Up","Arrow Down","Square","Triangle Up","Triangle Down","Label Up","Label Down","X Cross","Flag"])
bloodDiamondShapeOption     = input.string("Diamond", "Blood Diamond Shape", options=["Diamond","Circle","Arrow Up","Arrow Down","Square","Triangle Up","Triangle Down","Label Up","Label Down","X Cross","Flag"])

// === Signal Engine & Table Info ===
showSignalScore        = input.bool(true,  "Show Signal Score?")
showConfluenceRow      = input.bool(true,  "Show Multi-TF Confluence in Table?")
showOBVDivergence      = input.bool(true,  "Show OBV Divergence in Table?")

// === Divergence Settings ===
showBullishDiv         = input.bool(true,  "Show Bullish Divergence")
showBearishDiv         = input.bool(true,  "Show Bearish Divergence")
divLookback            = input.int(5,      "Divergence Lookback", minval=1)
divVolFilterOn         = input.bool(true,  "Filter Divergences by Volatility (BBWP)")
volatilityThreshold    = input.float(20.0, "BBWP Threshold (Max) for Valid Divergence")

// === Multi-Timeframe Trend Inputs ===
mtf_t1 = input.timeframe("30",  "MTF – Very Short Term", options=["15", "30", "45", "60"])
mtf_t2 = input.timeframe("120", "MTF – Short Term",      options=["60", "90", "120", "180"])
mtf_t3 = input.timeframe("360", "MTF – Medium Term",     options=["240", "360", "480", "720"])
mtf_t4 = input.timeframe("3D",  "MTF – Long Term",       options=["1D", "2D", "3D", "4D"])
mtf_t5 = input.timeframe("2W",  "MTF – Very Long Term",  options=["1W", "2W", "3W", "1M"])
mtf_t6 = input.timeframe("12D", "MTF – Macro Term",      options=["6D", "8D", "12D", "16D", "20D"])

// === Indicator Parameters ===
wtChannelLength = input.int(9,   "WT Channel Length", minval=1)
wtAverageLength = input.int(12,  "WT Average Length", minval=1)
wtMA_Length     = input.int(3,   "WT MA Length", minval=1)
wtOverbought    = input.int(53,  "WT Overbought Level")
wtOversold      = input.int(-53, "WT Oversold Level")

rsiLength       = input.int(14, "RSI Length", minval=1)
rsiOverbought   = input.int(70, "RSI Overbought Level")
rsiOversold     = input.int(30, "RSI Oversold Level")

bbwpLength      = input.int(20,  "BBWP Length", minval=1)
bbwpLookback    = input.int(100, "BBWP Lookback Period", minval=5)
cmfLength       = input.int(20,  "CMF Length", minval=1)
mfiLength       = input.int(14,  "MFI Length", minval=1)
adxLength       = input.int(14,  "ADX Length", minval=1)
htf_tf          = input.timeframe("60", "OBV Higher Timeframe (for Trend Bias)")
mf_htf_tf       = input.timeframe("1W", "HTF Money Flow Timeframe")

// === Alerts ===
enableAlertsSmartFlip = input.bool(true, "🔔 Alert: Smart Accum/Distr Flip")
enableAlertsBullDiv   = input.bool(true, "🔔 Alert: Bullish Divergence (Filtered)")
enableAlertsMTFTrend  = input.bool(true, "🔔 Alert: Strong Multi-TF Agreement")
enablePlaybookAlerts  = input.bool(true, "🔔 Enable Playbook-Based Alerts")

// === Pattern Engine Memory ===
enableHistoricalProjection = input.bool(true, "🔁 Enable Historical Projection")
lookbackLimit              = input.int(800, "📚 Max Bars to Search for Pattern Memory", options=[500, 800, 1000])
lookaheadChoice            = input.int(0, "Lookahead Bars for Outcome (0 = Auto)", options=[0, 1, 3, 5, 7, 10, 15, 20])
showUSDconversion          = input.bool(true, "💲 Convert ATR to Price Move")

matchSensitivity  = input.string("Normal", title="🔍 Pattern Match Sensitivity", options=["Loose", "Normal", "Strict", "Very Strict"])
maxDistGate       = matchSensitivity == "Loose" ? 3.5 : matchSensitivity == "Normal" ? 2.5 : matchSensitivity == "Strict" ? 1.8 : 1.2

minMatches        = input.int(8, "📚 Min Match Count (gate)", minval=0)          // (#7)
zLen              = input.int(100, "📏 Z-Score Window", minval=20)               // (#4)
recencyDecayLen   = input.int(300, "🕒 Recency Decay (bars)", minval=50)          // (#6)
triggerWindowBars = input.int(4, "⏱ Trigger Window after Anchor", minval=1)      // (#8)
snakeLookbackBars = input.int(4, "🐍 Snake Eyes Window (bars)", minval=2, maxval=10)

// ============================================================
// MOD #10 — Playbook Bias Scoring Inputs
// ============================================================
enablePlaybookBias    = input.bool(true,  "🧭 Enable Playbook Bias Scoring")
playbookBiasStrength  = input.float(0.6,  "🧭 Bias Strength", step=0.1, minval=0.0, maxval=2.0)
playbookBiasNeedsMTF  = input.bool(true,  "🧭 Bias requires MTF agreement?")

// === Minimal Mode Overrides ===
showTable         := minimalMode ? false : showTable
showWaveLabels    := minimalMode ? false : showWaveLabels
showFlipLabels    := minimalMode ? false : showFlipLabels
showTriggers      := minimalMode ? false : showTriggers
showWTcrosses     := minimalMode ? false : showWTcrosses
showSignalScore   := minimalMode ? false : showSignalScore
showOBVDivergence := minimalMode ? false : showOBVDivergence
showConfluenceRow := minimalMode ? false : showConfluenceRow

// ============================================================
// Utility helpers
// ============================================================

f_shapeFromOpt(opt) =>
    opt == "Diamond" ? shape.diamond :opt == "Circle" ? shape.circle :opt == "Arrow Up" ? shape.arrowup :opt == "Arrow Down" ? shape.arrowdown :opt == "Square" ? shape.square :opt == "Triangle Up" ? shape.triangleup :opt == "Triangle Down" ? shape.triangledown :opt == "Label Up" ? shape.labelup :opt == "Label Down" ? shape.labeldown :opt == "X Cross" ? shape.xcross :opt == "Flag" ? shape.flag : shape.diamond

bullTriggerShape     = f_shapeFromOpt(bullTriggerShapeOption)
bearTriggerShape     = f_shapeFromOpt(bearTriggerShapeOption)
greenDotShape        = f_shapeFromOpt(greenDotShapeOption)
bloodDiamondShape    = f_shapeFromOpt(bloodDiamondShapeOption)

f_safeDiv(float num, float den, float fallback=0.0) =>
    den != 0 and not na(den) ? num / den : fallback

f_normCentered(float src, int len) =>
    lo = ta.lowest(src, len)
    hi = ta.highest(src, len)
    den = hi - lo
    den != 0 ? ((src - lo) / den) * 100 - 50 : 0.0

f_bbwp(src, len, lookback) =>
    basis = ta.sma(src, len)
    bbw = f_safeDiv(ta.stdev(src, len), basis, 0.0) * 100
    lo = ta.lowest(bbw, lookback)
    hi = ta.highest(bbw, lookback)
    rng = hi - lo
    rng != 0 ? f_safeDiv(bbw - lo, rng, 0.0) * 100 : na

f_cleanTF(tf) =>
    tf == "15" ? "15m" : tf == "30" ? "30m" : tf == "45" ? "45m" : tf == "60" ? "1H" :tf == "90" ? "1.5H" : tf == "120" ? "2H" : tf == "180" ? "3H" :tf == "240" ? "4H" : tf == "360" ? "6H" : tf == "480" ? "8H" : tf == "720" ? "12H" :tf == "1D" ? "1D" : tf == "2D" ? "2D" : tf == "3D" ? "3D" : tf == "4D" ? "4D" :tf == "6D" ? "6D" : tf == "8D" ? "8D" : tf == "12D" ? "12D" : tf == "16D" ? "16D" : tf == "20D" ? "20D" :tf == "1W" ? "1W" : tf == "2W" ? "2W" : tf == "3W" ? "3W" : tf == "1M" ? "1M" : tf

f_zscore(src, len) =>
    mu = ta.sma(src, len)
    sd = ta.stdev(src, len)
    sd != 0 ? (src - mu) / sd : 0.0

f_adxNarrative(val) =>
    val < 15 ? "No Trend" : val < 25 ? "Weak Trend" : val < 40 ? "Strong Trend" : val < 60 ? "Powerful" : "Extreme"

f_wtNarrative(val) =>
    val > wtOverbought ? "Overbought" : val < wtOversold ? "Oversold" : "Neutral"

f_bbwpNarrative(val) =>
    val < 20 ? "Low Volatility" : val < 50 ? "Expanding" : "High Volatility"

f_rsiNarrative(val) =>
    val > rsiOverbought ? "Overbought" : val < rsiOversold ? "Oversold" : "Neutral"

f_hybridMFNarrative(val) =>
    val > 10  ? "💚 Strong Inflow" :val > 5   ? "🟢 Moderate Inflow" :val > 1   ? "🔹 Light Inflow" :val > -1  ? "⏸ Neutral Flow" :val > -5  ? "🔸 Light Outflow" :val > -10 ? "🔴 Moderate Outflow" : "💔 Strong Outflow"

f_hybridMFColor(narr) =>
    narr == "💚 Strong Inflow" ? color.new(color.green, 60) :narr == "🟢 Moderate Inflow" ? color.new(color.teal, 70) :narr == "🔹 Light Inflow" ? color.new(color.green, 80) :narr == "⏸ Neutral Flow" ? color.new(color.gray, 85) :narr == "🔸 Light Outflow" ? color.new(color.orange, 75) :narr == "🔴 Moderate Outflow" ? color.new(color.red, 70) :color.new(color.maroon, 60)

f_dirAgreeWeight(float mfHist, float wtHist, float wtPrevHist, float macdHist, float sigHist, float moveFwdHist) =>
    float adj = 1.0

    // Flow agreement
    if (mfHist > 0 and moveFwdHist > 0) or (mfHist < 0 and moveFwdHist < 0)
        adj += 0.20
    else if (mfHist > 0 and moveFwdHist < 0) or (mfHist < 0 and moveFwdHist > 0)
        adj -= 0.20

    // WT slope agreement
    bool wtUp = wtHist > wtPrevHist
    if (wtUp and moveFwdHist > 0) or ((not wtUp) and moveFwdHist < 0)
        adj += 0.15
    else
        adj -= 0.15

    // MACD posture agreement
    bool macdBull = macdHist > sigHist
    if (macdBull and moveFwdHist > 0) or ((not macdBull) and moveFwdHist < 0)
        adj += 0.15
    else
        adj -= 0.15

    math.max(0.35, adj)

 // ============================================================
// Core indicators
// ============================================================

f_getWT1() =>
    ap  = ta.sma(hlc3, wtChannelLength)
    esa = ta.ema(ap, wtAverageLength)
    d   = ta.ema(math.abs(ap - esa), wtAverageLength)
    ci  = f_safeDiv(ap - esa, 0.015 * d, 0.0)
    ta.ema(ci, wtMA_Length)

f_getSmartAccumScore() =>
    obv_ = ta.cum(close > close[1] ? volume : close < close[1] ? -volume : 0)
    wt1_ = f_getWT1()
    bbwp_ = f_bbwp(close, bbwpLength, bbwpLookback)
    rsi_ = ta.rsi(close, rsiLength)
    rsiMA = ta.sma(rsi_, 10)
    score = 0.0
    score += close < close[1] ? 1 : 0
    score += obv_ > obv_[1] ? 1 : 0
    score += wt1_ > wt1_[1] ? 1 : 0
    score += bbwp_ < 20 ? 1 : 0
    score += rsi_ > rsiMA ? 1 : 0
    score / 5.0

f_getSmartDistrScore() =>
    obv_ = ta.cum(close > close[1] ? volume : close < close[1] ? -volume : 0)
    wt1_ = f_getWT1()
    bbwp_ = f_bbwp(close, bbwpLength, bbwpLookback)
    rsi_ = ta.rsi(close, rsiLength)
    rsiMA = ta.sma(rsi_, 10)
    score = 0.0
    score += close > close[1] ? 1 : 0
    score += obv_ < obv_[1] ? 1 : 0
    score += wt1_ < wt1_[1] ? 1 : 0
    score += bbwp_ < 20 ? 1 : 0
    score += rsi_ < rsiMA ? 1 : 0
    score / 5.0

f_smartAccumBool(thresh) => f_getSmartAccumScore() >= thresh
f_smartDistrBool(thresh) => f_getSmartDistrScore() >= thresh

// === Multi-Timeframe WT Trend (non-repainting + 1 security call per TF) ===
f_mtfWTTrend(string tf) =>
    request.security(syminfo.tickerid, tf, (f_getWT1() > ta.sma(f_getWT1(), wtMA_Length) ? 1 : -1), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

s_mtf1 = f_mtfWTTrend(mtf_t1)
s_mtf2 = f_mtfWTTrend(mtf_t2)
s_mtf3 = f_mtfWTTrend(mtf_t3)
s_mtf4 = f_mtfWTTrend(mtf_t4)
s_mtf5 = f_mtfWTTrend(mtf_t5)
s_mtf6 = f_mtfWTTrend(mtf_t6)

mtf_score = (s_mtf1 * 1 + s_mtf2 * 1.5 + s_mtf3 * 2 + s_mtf4 * 2.5 + s_mtf5 * 3 + s_mtf6 * 4) / (1 + 1.5 + 2 + 2.5 + 3 + 4)

s_mtf1_txt = s_mtf1 == 1 ? "Up" : "Down"
s_mtf2_txt = s_mtf2 == 1 ? "Up" : "Down"
s_mtf3_txt = s_mtf3 == 1 ? "Up" : "Down"
s_mtf4_txt = s_mtf4 == 1 ? "Up" : "Down"
s_mtf5_txt = s_mtf5 == 1 ? "Up" : "Down"
s_mtf6_txt = s_mtf6 == 1 ? "Up" : "Down"

mtf_consensus = mtf_score >= 0.5 ? "Mostly Up" : mtf_score <= -0.5 ? "Mostly Down" : "Mixed"

// === WT, RSI, BBWP ===
wt1 = f_getWT1()
wt2 = ta.sma(wt1, wtMA_Length)
bullishWT = ta.crossover(wt1, wt2)
bearishWT = ta.crossunder(wt1, wt2)

rsi = ta.rsi(close, rsiLength)
bbwp = f_bbwp(close, bbwpLength, bbwpLookback)

f_hybridMFCalc() =>
    mfv_ = high != low ? (((close - low) - (high - close)) / (high - low)) : 0.0

    cmfNum_ = math.sum(mfv_ * volume, cmfLength)
    cmfDen_ = math.sum(volume, cmfLength)
    cmf_ = f_safeDiv(cmfNum_, cmfDen_, 0.0)

    mfi_ = ta.mfi(hlc3, mfiLength)
    lenNorm_ = timeframe.multiplier >= 7 ? 20 : 100

    cmfNorm_ = f_normCentered(cmf_, lenNorm_)
    mfiNorm_ = f_normCentered(mfi_, lenNorm_)

    (cmfNorm_ + mfiNorm_) / 2.0

// === Hybrid Money Flow (CMF + MFI normalized) ===
hybridMF = f_hybridMFCalc()

// === HTF MF overlay ===
mf_HTF = request.security(syminfo.tickerid, mf_htf_tf, f_hybridMFCalc(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
plot(mf_HTF, title="HTF Money Flow", color=mf_HTF >= 0 ? color.green : color.red, linewidth=2, style=plot.style_linebr)

// === Flip Labels ===
isGreenFlip = hybridMF > 0 and hybridMF[1] <= 0
isRedFlip   = hybridMF < 0 and hybridMF[1] >= 0

if showFlipLabels and isGreenFlip
    label.new(bar_index, hybridMF, "🟢 Accum", style=label.style_none, textcolor=color.white, size=size.tiny)
if showFlipLabels and isRedFlip
    label.new(bar_index, hybridMF, "🔴 Distr", style=label.style_none, textcolor=color.white, size=size.tiny)

// === OBV + ADX/DI ===
obv = ta.cum(close > close[1] ? volume : close < close[1] ? -volume : 0)
obv_HTF = request.security(syminfo.tickerid, htf_tf, obv)
obv_HTF_bias = obv_HTF > obv_HTF[1] ? "Bullish" : obv_HTF < obv_HTF[1] ? "Bearish" : "Neutral"

upMove   = high - high[1]
downMove = low[1] - low
plusDM   = upMove > downMove and upMove > 0 ? upMove : 0
minusDM  = downMove > upMove and downMove > 0 ? downMove : 0
trur     = ta.rma(ta.tr(true), adxLength)
diPlus   = 100 * f_safeDiv(ta.rma(plusDM, adxLength), trur, 0.0)
diMinus  = 100 * f_safeDiv(ta.rma(minusDM, adxLength), trur, 0.0)
dx  = f_safeDiv(math.abs(diPlus - diMinus), diPlus + diMinus, 0.0)
adx = 100 * ta.rma(dx, adxLength)

trendState = adx > 20 ? (diPlus > diMinus ? "Bull Trend" : "Bear Trend") : "No Trend"

// === VWAP-MACD normalized ===
vwap        = ta.vwap(hlc3)
macd_vwap   = ta.ema(vwap, 12) - ta.ema(vwap, 26)
signal_vwap = ta.ema(macd_vwap, 9)

macdNorm   = f_normCentered(macd_vwap, 100)
signalNorm = f_normCentered(signal_vwap, 100)

// === Plots ===
plot(wt1, title="WT1", color=color.white)
plot(wt2, title="WT2", color=color.blue)

plotshape(showWTcrosses and bullishWT ? wt1 : na, title="Bull WT Cross", style=bullTriggerShape, location=location.absolute, color=color.new(color.green, 0), size=size.tiny)
plotshape(showWTcrosses and bearishWT ? wt1 : na, title="Bear WT Cross", style=bearTriggerShape, location=location.absolute, color=color.new(color.red, 0), size=size.tiny)

plot(rsi,  title="RSI",  color=rsi > rsiOverbought ? color.red : rsi < rsiOversold ? color.lime : color.white, linewidth=2)
plot(bbwp, title="BBWP", color=bbwp > 50 ? color.green : color.red)
plot(macdNorm,   title="VWAP-MACD (Norm)", color=color.yellow, linewidth=2)

signalNearMACD = math.abs(signalNorm - macdNorm) < 3
plot(signalNorm, title="Signal (Norm)", color=signalNearMACD ? color.purple : color.white, linewidth=2)

plot(hybridMF, title="Hybrid Money Flow", color=hybridMF >= 0 ? color.lime : color.red)

// === Reference Lines ===
hline(0, title="Zero Line", color=color.gray, linestyle=hline.style_dashed)
hline(wtOverbought, title="WT Overbought", color=color.red, linestyle=hline.style_dashed)
hline(wtOversold, title="WT Oversold", color=color.green, linestyle=hline.style_dashed)
hline(rsiOverbought, title="RSI Overbought", color=color.red, linestyle=hline.style_dashed)
hline(rsiOversold, title="RSI Oversold", color=color.green, linestyle=hline.style_dashed)
hline(20, title="BBWP 20%", color=color.gray, linestyle=hline.style_dotted)
hline(50, title="BBWP 50%", color=color.orange, linestyle=hline.style_dotted)
hline(80, title="BBWP 80%", color=color.red, linestyle=hline.style_dotted)

// ============================================================
// WaveTrend Anchor/Trigger (FIX #8)
// ============================================================
labelOffset = 6.0

isAnchorRaw  = wt1 < wt1[1] and wt1[1] < wt1[2] and wt1 < wtOversold
isNewAnchor  = isAnchorRaw and not isAnchorRaw[1]

// 🐍 Snake Eyes = 2 anchors close together (double-dip)
// (new anchor occurs within snakeLookbackBars of a prior anchor)
barsSincePriorAnchor = ta.barssince(isNewAnchor[1])
snakeEyes = isNewAnchor and not na(barsSincePriorAnchor) and barsSincePriorAnchor <= snakeLookbackBars

// trigger must occur shortly AFTER a fresh anchor
barsSinceAnchor = ta.barssince(isNewAnchor)
isTriggerRaw = wt1 > wt1[1] and wt1[1] > wt1[2] and wt1 > wtOversold and wt1 < 0
isTrigger = isTriggerRaw and barsSinceAnchor > 0 and barsSinceAnchor <= triggerWindowBars

isNewTrigger = isTrigger and not isTrigger[1]
isNewSnake   = snakeEyes and not snakeEyes[1]

if showWaveLabels and isNewAnchor
    label.new(bar_index, wt1 - labelOffset, "A",
      xloc.bar_index, yloc.price, color.purple,
      style=label.style_label_down, textcolor=color.white, size=size.tiny)

if showWaveLabels and isNewTrigger
    label.new(bar_index, wt1 - labelOffset * 1.5, "T",
      xloc.bar_index, yloc.price, color.green,
      style=label.style_label_down, textcolor=color.white, size=size.tiny)

if showWaveLabels and isNewSnake
    label.new(bar_index, wt1 - labelOffset * 2.2, "👀",
      xloc.bar_index, yloc.price, color.orange,
      style=label.style_label_down, textcolor=color.black, size=size.tiny)

// ============================================================
// Playbook (kept simple, but no duplicate conflicting playbook vars)
// ============================================================
condition_squeeze      = hybridMF > 0 and bbwp < 20
condition_bear_trap    = hybridMF < 0 and rsi < 30
condition_distribution = hybridMF < 0 and wt1 > 0.5
condition_pullback     = hybridMF > 0 and rsi > 50 and wt1 < 0
condition_exhaustion   = hybridMF > 0 and bbwp > 80 and rsi > 70
condition_sideways     = math.abs(hybridMF) < 0.1 and bbwp < 25

playbook =
     condition_squeeze      ? "📈 Volatility Squeeze Breakout" :
     condition_bear_trap    ? "🪓 Bear Trap Reversal" :
     condition_distribution ? "🧯 Distribution Collapse" :
     condition_pullback     ? "🔥 Bullish Pullback Continuation" :
     condition_exhaustion   ? "💥 Volatility Exhaustion Reversal" :
     condition_sideways     ? "😴 Sideways Fade" :
                              "❓ Unclassified"
// ============================================================
// Weighted Signal Scoring (incl DI+/DI- fix #9)
// ============================================================
smartAccumScore = f_getSmartAccumScore()
smartDistrScore = f_getSmartDistrScore()

rsiScore    = math.max(0, (rsi - 50) / 20)
macdScore   = macdNorm / 100
sigScore    = signalNorm / 100
mfScore     = hybridMF / 100
bbwpScore   = bbwp < 20 ? 0.5 : 0.0

diBullScore = (adx > 20 and diPlus > diMinus) ? 0.6 : 0.0
diBearScore = (adx > 20 and diMinus > diPlus) ? 0.6 : 0.0

bullScoreWeighted = rsiScore + macdScore + sigScore + mfScore + bbwpScore + smartAccumScore + diBullScore
bearScoreWeighted = (1 - rsiScore) + (-macdScore) + (-sigScore) + (-mfScore) + bbwpScore + smartDistrScore + diBearScore

volumeConfidence = (macdNorm + signalNorm + hybridMF) / 3

// ============================================================
// MOD #10 — Apply Playbook Bias Scoring
// ============================================================

// Bias direction from playbook category (simple mapping)
float pbBias = 0.0
pbBias := playbook == "📈 Volatility Squeeze Breakout" ? 1.0 : playbook == "🔥 Bullish Pullback Continuation" ? 0.8 : playbook == "🪓 Bear Trap Reversal" ? 0.6 : playbook == "🧯 Distribution Collapse" ? -0.8 : playbook == "💥 Volatility Exhaustion Reversal" ? -0.6 : playbook == "😴 Sideways Fade" ? 0.0 : 0.0

// Optional: require MTF agreement before applying bias
bool pbBiasOK = not playbookBiasNeedsMTF or (pbBias > 0 and mtf_score >= 0.2) or (pbBias < 0 and mtf_score <= -0.2)

// Apply bias as a score nudge
if enablePlaybookBias and pbBiasOK
    bullScoreWeighted += playbookBiasStrength * math.max(pbBias, 0)
    bearScoreWeighted += playbookBiasStrength * math.max(-pbBias, 0)

bullVolumeConfirm = volumeConfidence > 0
bearVolumeConfirm = volumeConfidence < 0

isGreenDot     = isTrigger and bullScoreWeighted >= 3.5 and bullVolumeConfirm
isBloodDiamond = isTrigger and bearScoreWeighted >= 3.5 and bearVolumeConfirm

recentGreenDot = ta.highest(isGreenDot ? 1 : 0, 5) > 0
recentRedDot   = ta.highest(isBloodDiamond ? 1 : 0, 5) > 0

plotshape(showTriggers and isGreenDot ? wt1 : na, title="Green Dot", style=greenDotShape, location=location.absolute, color=color.green, size=size.tiny)
plotshape(showTriggers and isBloodDiamond ? wt1 : na, title="Blood Diamond", style=bloodDiamondShape, location=location.absolute, color=color.red, size=size.tiny)

// Hidden Distribution highlight
priceUp     = close > close[10]
mfDiverging = hybridMF < 0 and priceUp
bgcolor(bullScoreWeighted >= 4.0 ? color.new(color.green, 85) :
       bearScoreWeighted >= 4.0 ? color.new(color.red, 85) :
       (showHiddenDistrHighlight and mfDiverging) ? color.new(color.orange, 85) : na) 

// ============================================================
// Pattern Memory Engine — MOD #5 (explicit bull/bear pools)
// Includes: #1 #2 #3 #4 #6 #7
// ============================================================

float outcomeAvg     = na
float outcomeATR     = na
float outcomeInPrice = na
float bullProb       = na
float bearProb       = na

// Diagnostics (optional but useful)
int   bullMatchCount = 0
int   bearMatchCount = 0
float avgBullMove    = na
float avgBearMove    = na

// Separate match pools (explicit)
var float[] bullMoves  = array.new_float()   // positive forward moves
var float[] bullW      = array.new_float()   // weights for bull moves
var float[] bullScore  = array.new_float()   // distances for clustering

var float[] bearMoves  = array.new_float()   // positive magnitudes (abs of negative fwd moves)
var float[] bearW      = array.new_float()
var float[] bearScore  = array.new_float()

// z-scored features (#4)
zMF   = f_zscore(hybridMF, zLen)
zWT   = f_zscore(wt1,      zLen)
zRSI  = f_zscore(rsi,      zLen)
zBBWP = f_zscore(bbwp,     zLen)

atr   = ta.atr(14)
sma20 = ta.sma(close, 20)
sma50 = ta.sma(close, 50)

// lookahead default
defaultLookahead = timeframe.isdaily ? 10 : timeframe.isweekly ? 20 : timeframe.multiplier >= 60 ? 7 : 3
lookaheadBars    = lookaheadChoice == 0 ? defaultLookahead : lookaheadChoice

// Precompute once (optional but recommended for speed)
volMA = ta.sma(volume, 20)

if enableHistoricalProjection and bbwp < 80
    array.clear(bullMoves), array.clear(bullW), array.clear(bullScore)
    array.clear(bearMoves), array.clear(bearW), array.clear(bearScore)

    // current regime flags
    currTrend = trendState == "Bull Trend" ? 1 : trendState == "Bear Trend" ? -1 : 0
    currVol   = bbwp > 50 ? 1 : 0
    currMacro = sma20 > sma50 ? 1 : 0
    currRsiZ  = rsi > rsiOverbought ? 1 : rsi < rsiOversold ? -1 : 0

    for i = lookaheadBars to lookbackLimit
        // forward return from bar i
        moveFwd = na(close[i - lookaheadBars]) ? na : (close[i - lookaheadBars] - close[i])

        if not na(moveFwd)
            pastTrend = trendState[i] == "Bull Trend" ? 1 : trendState[i] == "Bear Trend" ? -1 : 0
            pastVol   = bbwp[i] > 50 ? 1 : 0
            pastMacro = sma20[i] > sma50[i] ? 1 : 0
            pastRsiZ  = rsi[i] > rsiOverbought ? 1 : rsi[i] < rsiOversold ? -1 : 0

            // distance on normalized features
            s = 0.0
            s += math.abs(zMF   - zMF[i])
            s += math.abs(zWT   - zWT[i])
            s += math.abs(zRSI  - zRSI[i])
            s += math.abs(zBBWP - zBBWP[i])
            s += math.abs(currTrend - pastTrend)
            s += math.abs(currVol   - pastVol)
            s += math.abs(currMacro - pastMacro)
            s += math.abs(currRsiZ  - pastRsiZ)

            // distance gate (z-score compatible)
            if s <= maxDistGate
                // weight (inverse distance) + recency decay (#6)
                float w = 1.0 / (s + 0.001)
                w *= math.exp(-i / recencyDecayLen)

                // internal-pressure agreement weighting
                histDirAdj = f_dirAgreeWeight(hybridMF[i], wt1[i], wt1[i + 1], macdNorm[i], signalNorm[i], moveFwd)
                w *= histDirAdj

                // penalize extremely high-vol historical bars
                if bbwp[i] > 70
                    w *= 0.8

                // optional: down-weight volume spike outliers
                volSpike = volume[i] > volMA[i] * 2.0
                if volSpike
                    w *= 0.5

                // push into pools
                if moveFwd > 0
                    array.push(bullMoves, moveFwd)
                    array.push(bullW,     w)
                    array.push(bullScore, s)
                else if moveFwd < 0
                    array.push(bearMoves, math.abs(moveFwd))
                    array.push(bearW,     w)
                    array.push(bearScore, s)

// --- clustering (#1): quantile multipliers per pool (uses TRUE per-match scores) ---
f_applyQuantileClustering(float[] scores, float[] weights) =>
    if array.size(scores) > 5 and array.size(weights) == array.size(scores)
        float[] sorted = array.copy(scores)
        array.sort(sorted, order.ascending)
        int sz = array.size(sorted)
        float q1 = array.get(sorted, math.floor(sz * 0.33))
        float q3 = array.get(sorted, math.floor(sz * 0.66))

        for j = 0 to array.size(weights) - 1
            float s = array.get(scores, j)
            float w = array.get(weights, j)
            float mult = s <= q1 ? 1.5 : s >= q3 ? 0.6 : 1.0
            array.set(weights, j, w * mult)

f_applyQuantileClustering(bullScore, bullW)
f_applyQuantileClustering(bearScore, bearW)

// --- final aggregation (#2 #3 #7) ---
float totalBullW = 0.0
float totalBearW = 0.0
float bullMoveW  = 0.0
float bearMoveW  = 0.0

bullMatchCount := array.size(bullMoves)
bearMatchCount := array.size(bearMoves)
int totalMatches = bullMatchCount + bearMatchCount

if totalMatches >= minMatches
    if bullMatchCount > 0
        for k = 0 to bullMatchCount - 1
            w = array.get(bullW, k)
            m = array.get(bullMoves, k)
            totalBullW += w
            bullMoveW  += w * m

    if bearMatchCount > 0
        for k = 0 to bearMatchCount - 1
            w = array.get(bearW, k)
            m = array.get(bearMoves, k)
            totalBearW += w
            bearMoveW  += w * m

    float totalW = totalBullW + totalBearW

    if totalW > 0
        bullProb := 100.0 * totalBullW / totalW
        bearProb := 100.0 * totalBearW / totalW

        avgBullMove := totalBullW > 0 ? bullMoveW / totalBullW : na
        avgBearMove := totalBearW > 0 ? bearMoveW / totalBearW : na

        // net expected move (bull minus bear magnitude)
        outcomeInPrice := (bullMoveW - bearMoveW) / totalW
        outcomeAvg     := outcomeInPrice
        outcomeATR     := atr != 0 ? math.abs(outcomeInPrice) / atr : na
    else
        outcomeAvg := na
        outcomeInPrice := na
        outcomeATR := na
        bullProb := na
        bearProb := na
        avgBullMove := na
        avgBearMove := na
else
    outcomeAvg := na
    outcomeInPrice := na
    outcomeATR := na
    bullProb := na
    bearProb := na
    avgBullMove := na
    avgBearMove := na

// emoji
var label confEmojiLabel = na

// emoji label (optional)
if barstate.islast
    if showConfidenceEmoji and not minimalMode
        emoji = outcomeATR > 1.2 ? "✅" : outcomeATR > 0.6 ? "⚠️" : outcomeATR > 0.2 ? "❌" : "⏸"

        if na(confEmojiLabel)
            confEmojiLabel := label.new(bar_index, wt1 + 5, emoji, style=label.style_none, size=size.small, yloc=yloc.price, textcolor=color.white)
        else
            label.set_x(confEmojiLabel, bar_index)
            label.set_y(confEmojiLabel, wt1 + 5)
            label.set_text(confEmojiLabel, emoji)
            emojiColor = outcomeATR > 1.2 ? color.lime : outcomeATR > 0.6 ? color.orange : outcomeATR > 0.2 ? color.red : color.gray
            label.set_textcolor(confEmojiLabel, emojiColor)
    else
        if not na(confEmojiLabel)
            label.delete(confEmojiLabel)
            confEmojiLabel := na

// ============================================================
// Divergence Engine
// ============================================================
f_divergence(bool bullish, bool hidden, float mf, int lb, float bbwpVal, bool volFilterOn, float volThreshold) =>
    volOK = not volFilterOn or (bbwpVal < volThreshold)
    isDiv = false
    if hidden
        isDiv := bullish ? (low > low[lb] and mf < mf[lb] and volOK) : (high < high[lb] and mf > mf[lb] and volOK)
    else
        isDiv := bullish ? (low < low[lb] and mf > mf[lb] and volOK) : (high > high[lb] and mf < mf[lb] and volOK)
    isDiv

bullDiv = f_divergence(true,  false, hybridMF, divLookback, bbwp, divVolFilterOn, volatilityThreshold)
bearDiv = f_divergence(false, false, hybridMF, divLookback, bbwp, divVolFilterOn, volatilityThreshold)
bullHid = f_divergence(true,  true,  hybridMF, divLookback, bbwp, divVolFilterOn, volatilityThreshold)
bearHid = f_divergence(false, true,  hybridMF, divLookback, bbwp, divVolFilterOn, volatilityThreshold)

if showBullishDiv and bullDiv
    label.new(bar_index, hybridMF, "◇", style=label.style_none, textcolor=color.white, size=size.tiny, yloc=yloc.price)
if showBearishDiv and bearDiv
    label.new(bar_index, hybridMF, "◈", style=label.style_none, textcolor=color.white, size=size.tiny, yloc=yloc.price)
if showBullishDiv and bullHid
    label.new(bar_index, hybridMF, "⬆️", style=label.style_none, textcolor=color.lime, size=size.tiny)
if showBearishDiv and bearHid
    label.new(bar_index, hybridMF, "⬇️", style=label.style_none, textcolor=color.red, size=size.tiny)

// ============================================================
// Alerts
// ============================================================
alertcondition(enableAlertsSmartFlip and isGreenFlip, title="Smart Flip: Accum", message="🟢 Smart Money Accumulation Flip on {{ticker}}")
alertcondition(enableAlertsSmartFlip and isRedFlip,   title="Smart Flip: Distr", message="🔴 Smart Money Distribution Flip on {{ticker}}")

alertcondition(enableAlertsMTFTrend and mtf_score >= 0.8,  title="Strong Bull MTF", message="✅ Strong Multi-TF Bull Trend on {{ticker}}")
alertcondition(enableAlertsMTFTrend and mtf_score <= -0.8, title="Strong Bear MTF", message="❌ Strong Multi-TF Bear Trend on {{ticker}}")

alertcondition(enableAlertsBullDiv and bullDiv, title="Bullish Divergence (Regular)", message="📈 Bullish Divergence on {{ticker}} with low BBWP")
alertcondition(enableAlertsBullDiv and bullHid, title="Bullish Divergence (Hidden)",  message="📈 Hidden Bullish Divergence on {{ticker}}")
alertcondition(showBearishDiv and bearDiv,      title="Bearish Divergence (Regular)", message="⚠️ Bearish Divergence on {{ticker}} with low BBWP")
alertcondition(showBearishDiv and bearHid,      title="Bearish Divergence (Hidden)",  message="⚠️ Hidden Bearish Divergence on {{ticker}}")

isHighConfidence = isGreenDot or isBloodDiamond
alertcondition(enablePlaybookAlerts and isHighConfidence and playbook == "📈 Volatility Squeeze Breakout", title="High Confidence: Squeeze Breakout", message="📈 High Confidence Squeeze Breakout on {{ticker}}")
alertcondition(enablePlaybookAlerts and isHighConfidence and playbook == "🪓 Bear Trap Reversal", title="High Confidence: Bear Trap", message="🪓 Bear Trap Reversal Detected on {{ticker}}")
alertcondition(enablePlaybookAlerts and isHighConfidence and playbook == "🧯 Distribution Collapse", title="High Confidence: Distribution Collapse", message="🧯 Distribution Collapse on {{ticker}}")
alertcondition(enablePlaybookAlerts and isHighConfidence and playbook == "🔥 Bullish Pullback Continuation", title="High Confidence: Bullish Pullback", message="🔥 Bullish Pullback Setup Detected on {{ticker}}")
alertcondition(enablePlaybookAlerts and isHighConfidence and playbook == "💥 Volatility Exhaustion Reversal", title="High Confidence: Volatility Reversal", message="💥 Volatility Exhaustion on {{ticker}}")
alertcondition(enablePlaybookAlerts and isHighConfidence and playbook == "😴 Sideways Fade", title="High Confidence: Sideways Fade", message="😴 Sideways Fade Detected on {{ticker}}")

// --- total matches (use INT so table math/printing is consistent) ---
int matchCount = bullMatchCount + bearMatchCount

// ============================================================
// Decision Table (updated: includes HybridMF + cleaner MTF rows)
// ============================================================
var table decisionTable = table.new(position.bottom_right, 7, 25,
     bgcolor=color.new(#1e1e1e, 0), frame_color=color.gray, frame_width=1)

// (optional) use dashboardTextSizeConst everywhere so sizing is consistent
f_addRow(int _row, string title, string value, color txtClr=color.white, color bgClr=na) =>
    if not na(decisionTable) and _row < 25
        table.cell(decisionTable, 0, _row, title, text_color=color.white, bgcolor=color.gray, text_size=dashboardTextSizeConst)
        table.cell(decisionTable, 1, _row, value, text_color=txtClr, bgcolor=bgClr, text_size=dashboardTextSizeConst)
    _row + 1

f_addRow6(int _row, string t1, string v1, string t2, string v2, string t3, string v3) =>
    if not na(decisionTable) and _row < 25
        table.cell(decisionTable, 0, _row, t1, text_color=color.white, bgcolor=color.gray, text_size=dashboardTextSizeConst)
        table.cell(decisionTable, 1, _row, v1, text_color=color.white, text_size=dashboardTextSizeConst)
        table.cell(decisionTable, 2, _row, t2, text_color=color.white, bgcolor=color.gray, text_size=dashboardTextSizeConst)
        table.cell(decisionTable, 3, _row, v2, text_color=color.white, text_size=dashboardTextSizeConst)
        table.cell(decisionTable, 4, _row, t3, text_color=color.white, bgcolor=color.gray, text_size=dashboardTextSizeConst)
        table.cell(decisionTable, 5, _row, v3, text_color=color.white, text_size=dashboardTextSizeConst)
    _row + 1

bool updateTable = barstate.islast or barstate.isrealtime
if showTable and updateTable and not na(decisionTable)
    table.clear(decisionTable, 0, 0, 6, 24)
    int row = 0

    // Confidence from outcomeATR
    confEmoji = outcomeATR > 1.2 ? "High" : outcomeATR > 0.6 ? "Moderate" : outcomeATR > 0.2 ? "Low" : "Very Low"
    confColor = outcomeATR > 1.2 ? color.new(color.green, 80) :outcomeATR > 0.6 ? color.new(color.orange, 80) :outcomeATR > 0.2 ? color.new(color.red, 80) :
                                   color.new(color.gray, 80)
    row := f_addRow(row, "Confidence", confEmoji, color.white, confColor)

    row := f_addRow(row, "Playbook", playbook, color.white, color.new(color.blue, 90))

    // Trigger status
    triggerText =
         recentGreenDot ? "🟢 Green Dot — possible bottom / reversal" :
         recentRedDot   ? "🔴 Blood Diamond — possible top / distribution" :
                          "⏸ No active reversal signal"
    triggerBg = recentGreenDot ? color.new(color.green, 90) :recentRedDot   ? color.new(color.maroon, 90) :
                                 color.new(color.gray, 90)
    row := f_addRow(row, "Trigger", triggerText, color.white, triggerBg)

    // --- MTF (digestible) ---
    if showConfluenceRow
        tfLine = f_cleanTF(mtf_t1) + " • " + f_cleanTF(mtf_t2) + " • " + f_cleanTF(mtf_t3) + " • " +
                 f_cleanTF(mtf_t4) + " • " + f_cleanTF(mtf_t5) + " • " + f_cleanTF(mtf_t6)
        row := f_addRow(row, "Timeframes", tfLine, color.white, color.new(color.gray, 90))

        mtfBg = mtf_score >= 0.6 ? color.new(color.green, 80) :mtf_score <= -0.6 ? color.new(color.red, 80) : color.new(color.orange, 85)
        row := f_addRow(row, "MTF Trend", mtf_consensus + " (" + str.tostring(mtf_score, "#.00") + ")", color.white, mtfBg)

    // Memory forecast
    displayAmount = showUSDconversion and not na(outcomeInPrice) ? "$" + str.tostring(math.abs(outcomeInPrice), "#.##") :not na(outcomeATR) ? str.tostring(math.abs(outcomeATR), "#.##") + "×ATR" : "N/A"
    dir = not na(outcomeInPrice) ? (outcomeInPrice > 0 ? "⬆️" : outcomeInPrice < 0 ? "⬇️" : "⏸") : "⏸"

    memSummary =matchCount < minMatches ? "⚫ Insufficient Data (" + str.tostring(matchCount) + "/" + str.tostring(minMatches) + ")" :(na(bullProb) or na(bearProb)) ? "N/A" :"Hist. Bull: " + str.tostring(bullProb, "#.0") + "% | Bear: " + str.tostring(bearProb, "#.0") +"% | Exp. Move: " + dir + " " + displayAmount

    row := f_addRow(row, "Memory (" + str.tostring(lookaheadBars) + ")", memSummary, color.white,
         matchCount < minMatches ? color.new(color.gray, 85) :
         bullProb >= 55 ? color.new(color.green, 80) :
         bearProb >= 55 ? color.new(color.red, 80) :
                          color.new(color.blue, 90))

    row := f_addRow(row, "Matches", str.tostring(matchCount), color.white)
    row := f_addRow(row, "Lookback", str.tostring(lookbackLimit) + " bars", color.white)

    // Snapshot (includes HybridMF)
    wtText   = str.tostring(wt1, "#.#") + " " + f_wtNarrative(wt1)
    bbwpText = str.tostring(bbwp, "#.#") + " " + f_bbwpNarrative(bbwp)
    rsiText  = str.tostring(rsi, "#.#") + " " + f_rsiNarrative(rsi)
    adxText  = str.tostring(adx, "#.#") + " " + f_adxNarrative(adx)

    mfNarr = f_hybridMFNarrative(hybridMF)
    mfText = str.tostring(hybridMF, "#.##") + " " + mfNarr

    row := f_addRow6(row, "HybridMF", mfText, "WT", wtText, "BBWP", bbwpText)
    row := f_addRow6(row, "RSI", rsiText, "OBV", obv_HTF_bias, "ADX", adxText)
    row := f_addRow(row, "DI", (diPlus > diMinus ? "DI+ > DI-" : "DI- > DI+"), color.white)

    // Signal score
    sig = math.max(bullScoreWeighted, bearScoreWeighted)
    sigText = sig >= 4.0 ? "🔥 Strong" : sig >= 3.5 ? "⚠️ High" : sig >= 3.0 ? "Moderate" : "Low"
    sigBg = sig >= 4.0 ? color.new(color.purple, 70) :sig >= 3.5 ? color.new(color.blue, 70) :sig >= 3.0 ? color.new(color.orange, 80) :
                         color.new(color.gray, 85)
    row := f_addRow(row, "Signal", sigText + " (" + str.tostring(sig, "#.00") + ")", color.white, sigBg)

    // Whale watch
    whaleTxt = hybridMF >= 0 and smartAccumScore >= 0.8 ? "🟢 Smart Accum" :
               hybridMF < 0 and smartDistrScore >= 0.8 ? "🔴 Smart Distr" : "😴 Quiet"
    if showOBVDivergence
        row := f_addRow(row, "Whale", whaleTxt, color.white)

// Risk metrics (uses bull/bear prob)
    rr     = (not na(outcomeInPrice) and atr != 0) ? math.abs(outcomeInPrice) / atr : na
    lossR  = (not na(avgBearMove) and atr != 0) ? (avgBearMove / atr) : 1.0
    exp    = (not na(bullProb) and not na(bearProb) and not na(rr)) ? (bullProb/100.0)*rr - (bearProb/100.0)*lossR : na

    rrText   = not na(rr)  ? str.tostring(rr, "#.##") + ":1" : "—"
    expText  = not na(exp) ? (exp > 0 ? "+" : "") + str.tostring(exp * 100, "#.#") + "%" : "—"
    lossText = not na(lossR) ? str.tostring(lossR, "#.##") + "R" : "—"  // optional (remove if you don't want it)

    rrBg  = na(rr)  ? color.new(color.gray, 85) : rr > 2 ? color.new(color.lime, 80) : rr > 1 ? color.new(color.orange, 80) : color.new(color.red, 80)
    expBg = na(exp) ? color.new(color.gray, 85) : exp > 0.1 ? color.new(color.lime, 80) : exp < -0.1 ? color.new(color.red, 80) : color.new(color.orange, 85)

    row := f_addRow(row, "RR", rrText, color.white, rrBg)
    row := f_addRow(row, "Expectancy", expText, color.white, expBg)

// OPTIONAL: if you want to see what the script assumed for loss side in the table:
// row := f_addRow(row, "Loss (R)", lossText, color.white, color.new(color.gray, 88))
