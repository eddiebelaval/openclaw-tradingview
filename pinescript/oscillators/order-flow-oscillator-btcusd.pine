// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("Order Flow Oscillator [BTCUSD]", shorttitle="OFO", overlay=false)

// --- Constants ---
COLOR_BULL = #089981
COLOR_BEAR = #f23645
COLOR_NONE = #5b9cf6

// --- Inputs ---
int   lengthInput      = input.int(20, "Smoothing Length", minval=1, tooltip="The lookback period for smoothing the estimated volume delta. BTCUSD often requires smoothing to filter noise.")
int   normLengthInput  = input.int(50, "Normalization Length", minval=1, tooltip="The lookback period for Z-score normalization. Helps identify extreme volume events.")
float thresholdInput   = input.float(2.0, "Threshold Level", minval=0.1, step=0.1, tooltip="Z-score threshold for extreme order flow.")

// --- Core Logic ---
// Function to calculate estimated buy/sell volume delta
calc_delta() =>
    float priceRange = high - low
    float buyVol  = priceRange == 0 ? 0.0 : volume * (close - low) / priceRange
    float sellVol = priceRange == 0 ? 0.0 : volume * (high - close) / priceRange
    buyVol - sellVol

float delta       = calc_delta()
float relDelta    = volume == 0 ? 0.0 : delta / volume
float smoothDelta = ta.ema(relDelta, lengthInput)

// Z-Score Normalization for BTCUSD volatility optimization
float mean  = ta.sma(smoothDelta, normLengthInput)
float stdev = ta.stdev(smoothDelta, normLengthInput)
float zScore = stdev == 0 ? 0.0 : (smoothDelta - mean) / stdev

// Trend detection
color oscColor = zScore > 0 ? COLOR_BULL : COLOR_BEAR

// --- Visual Elements ---
// Plotting the oscillator
plotOsc  = plot(zScore, "Order Flow Oscillator", color=oscColor, linewidth=2)
plotZero = plot(0, "Zero Line Plot", display=display.none)

// Static Levels
hline(thresholdInput, "Upper Threshold", color=COLOR_BULL, linestyle=hline.style_dashed)
hline(-thresholdInput, "Lower Threshold", color=COLOR_BEAR, linestyle=hline.style_dashed)
hline(0, "Zero Line", color=chart.fg_color, linestyle=hline.style_dotted)

// Vertical Gradient Fill per Guidelines
// 100% transparent at center (0), 50% transparent at oscillator value
fill(
     plotOsc, 
     plotZero, 
     top_value    = math.max(0, zScore), 
     bottom_value = math.min(0, zScore), 
     top_color    = zScore > 0 ? color.new(COLOR_BULL, 50) : color.new(COLOR_BEAR, 100), 
     bottom_color = zScore > 0 ? color.new(COLOR_BULL, 100) : color.new(COLOR_BEAR, 50),
     title        = "Oscillator Gradient Fill"
 )

// --- Alerts ---
bool isExtremePos = ta.crossover(zScore, thresholdInput)
bool isExtremeNeg = ta.crossunder(zScore, -thresholdInput)
bool isZeroCross  = ta.cross(zScore, 0)

alertcondition(isExtremePos, "Extreme Positive Flow", "BTCUSD extreme positive order flow (Z-score > {{thresholdInput}})")
alertcondition(isExtremeNeg, "Extreme Negative Flow", "BTCUSD extreme negative order flow (Z-score < -{{thresholdInput}})")
alertcondition(isZeroCross,  "Direction Shift", "Order flow shifted direction (Zero cross)")
