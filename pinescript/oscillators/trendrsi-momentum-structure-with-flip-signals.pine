//@version=6
indicator("TrendRSI – Momentum Structure with Flip Signals", overlay=false, max_labels_count=200)

//==============================
// Inputs
//==============================
grp1 = "RSI"
rsiLen   = input.int(20, "RSI Length", minval=1, group=grp1)
src      = input.source(close, "Source", group=grp1)

grp2 = "Smoothing"
maLen    = input.int(10, "RSI MA Length", minval=1, group=grp2)
maType   = input.string("RMA", "RSI MA Type", options=["SMA","EMA","RMA","WMA"], group=grp2)

grp3 = "Trend Dots (SuperTrend-like on RSI)"
atrLen   = input.int(14, "ATR Len (on RSI)", minval=1, group=grp3)
factor   = input.float(4.0, "Factor", step=0.1, group=grp3)
baseMode = input.string("RSI MA", "Base", options=["RSI","RSI MA"], group=grp3)

grp4 = "Display"
showRSI  = input.bool(false, "Show RSI (thin)", group=grp4)
show50   = input.bool(true,  "Show 50 line", group=grp4)
show7030 = input.bool(false, "Show 70/30", group=grp4)

grp5 = "Signals / Alerts"
showFlipSignal = input.bool(true, "Show flip signal (▲▼)", group=grp5)
sigSizeOpt     = input.string("small", "Signal size",
                   options=["tiny","small","normal","large","huge"], group=grp5)

//==============================
// Helpers
//==============================
f_ma(_x, _len, _type) =>
    switch _type
        "SMA" => ta.sma(_x, _len)
        "EMA" => ta.ema(_x, _len)
        "RMA" => ta.rma(_x, _len)
        => ta.wma(_x, _len)

//==============================
// Core
//==============================
rsi    = ta.rsi(src, rsiLen)
rsiMA  = f_ma(rsi, maLen, maType)
base   = baseMode == "RSI" ? rsi : rsiMA

// ATR on RSI
tr     = math.abs(base - base[1])
atrRSI = ta.rma(tr, atrLen)

// SuperTrend-like bands on RSI
upper  = base + factor * atrRSI
lower  = base - factor * atrRSI

// Carry forward bands
var float fUpper = na
var float fLower = na
fUpper := na(fUpper[1]) ? upper : (upper < fUpper[1] or base[1] > fUpper[1] ? upper : fUpper[1])
fLower := na(fLower[1]) ? lower : (lower > fLower[1] or base[1] < fLower[1] ? lower : fLower[1])

// Direction
var int dir = 1
dir := na(dir[1]) ? 1 :
     dir[1] == 1 ? (base < fLower[1] ? -1 : 1) :
                   (base > fUpper[1] ?  1 : -1)

// Dots line
trendLine = dir == 1 ? fLower : fUpper

//==============================
// Flip detection
//==============================
flipUp = dir == 1 and dir[1] == -1
flipDn = dir == -1 and dir[1] == 1

//==============================
// Reference lines
//==============================
col50 = show50   ? color.new(color.gray, 60) : color.new(color.gray, 100)
col70 = show7030 ? color.new(color.gray, 75) : color.new(color.gray, 100)
col30 = show7030 ? color.new(color.gray, 75) : color.new(color.gray, 100)

hline(50, "50", color=col50)
hline(70, "70", color=col70)
hline(30, "30", color=col30)

//==============================
// Plots
//==============================
plot(rsiMA, "RSI MA", color=color.white, linewidth=1)
plot(showRSI ? rsi : na, "RSI", color=color.new(color.white, 75), linewidth=1)

dotCol = dir == 1 ? color.aqua : color.fuchsia
plot(trendLine, "Trend Dots", style=plot.style_circles, linewidth=2, color=dotCol)

//==============================
// Flip Signals (size固定分岐 + text固定▲▼)
//==============================
condUp = showFlipSignal and flipUp ? trendLine : na
condDn = showFlipSignal and flipDn ? trendLine : na

// tiny
plotshape(sigSizeOpt=="tiny"   ? condUp : na, title="Flip Up tiny",   style=shape.labelup,   text="▲", color=color.aqua,    textcolor=color.white, size=size.tiny,   location=location.absolute)
plotshape(sigSizeOpt=="tiny"   ? condDn : na, title="Flip Dn tiny",   style=shape.labeldown, text="▼", color=color.fuchsia, textcolor=color.white, size=size.tiny,   location=location.absolute)

// small
plotshape(sigSizeOpt=="small"  ? condUp : na, title="Flip Up small",  style=shape.labelup,   text="▲", color=color.aqua,    textcolor=color.white, size=size.small,  location=location.absolute)
plotshape(sigSizeOpt=="small"  ? condDn : na, title="Flip Dn small",  style=shape.labeldown, text="▼", color=color.fuchsia, textcolor=color.white, size=size.small,  location=location.absolute)

// normal
plotshape(sigSizeOpt=="normal" ? condUp : na, title="Flip Up normal", style=shape.labelup,   text="▲", color=color.aqua,    textcolor=color.white, size=size.normal, location=location.absolute)
plotshape(sigSizeOpt=="normal" ? condDn : na, title="Flip Dn normal", style=shape.labeldown, text="▼", color=color.fuchsia, textcolor=color.white, size=size.normal, location=location.absolute)

// large
plotshape(sigSizeOpt=="large"  ? condUp : na, title="Flip Up large",  style=shape.labelup,   text="▲", color=color.aqua,    textcolor=color.white, size=size.large,  location=location.absolute)
plotshape(sigSizeOpt=="large"  ? condDn : na, title="Flip Dn large",  style=shape.labeldown, text="▼", color=color.fuchsia, textcolor=color.white, size=size.large,  location=location.absolute)

// huge
plotshape(sigSizeOpt=="huge"   ? condUp : na, title="Flip Up huge",   style=shape.labelup,   text="▲", color=color.aqua,    textcolor=color.white, size=size.huge,   location=location.absolute)
plotshape(sigSizeOpt=="huge"   ? condDn : na, title="Flip Dn huge",   style=shape.labeldown, text="▼", color=color.fuchsia, textcolor=color.white, size=size.huge,   location=location.absolute)

//==============================
// Alerts (方向転換の瞬間だけ)
//==============================
alertcondition(flipUp, title="TrendRSI Flip UP", message="TrendRSI flipped UP")
alertcondition(flipDn, title="TrendRSI Flip DOWN", message="TrendRSI flipped DOWN")
alertcondition(flipUp or flipDn, title="TrendRSI Flip (Any)", message="TrendRSI flipped direction")
