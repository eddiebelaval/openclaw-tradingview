//@version=5
indicator("MT4 Style MACD - Color Coded", overlay=false, precision=4)

// --- Inputs ---
fast_length   = input.int(12, "Fast EMA Length")
slow_length   = input.int(26, "Slow EMA Length")
signal_length = input.int(9, "Signal SMA Length")
src           = input.source(close, "Source")

// --- Calculations ---
fast_ma     = ta.ema(src, fast_length)
slow_ma     = ta.ema(src, slow_length)
macd_line   = fast_ma - slow_ma
signal_line = ta.sma(macd_line, signal_length)

// --- Color Logic for Histogram ---
// Logic: If current value is higher than previous, use bright color; else use dark color.
hist_color = macd_line >= 0 ? 
             (macd_line > macd_line[1] ? color.green : color.rgb(56, 142, 60)) : 
             (macd_line < macd_line[1] ? color.red   : color.rgb(183, 28, 28))

// --- Signals (Calculated on bar close) ---
bullish_cross = ta.crossover(macd_line, signal_line)
bearish_cross = ta.crossunder(macd_line, signal_line)

// --- Plotting ---
// Histogram (The main MACD line)
plot(macd_line, title="MACD Histogram", style=plot.style_columns, color=hist_color)

// Signal Line (The red line)
plot(signal_line, title="Signal Line", color=color.red, linewidth=1)

// Zero Line
hline(0, "Zero Line", color=color.gray, linestyle=hline.style_dotted)

// --- Visual Buy/Sell Signals ---
plotshape(bullish_cross, title="Buy Signal", style=shape.triangleup, location=location.bottom, color=color.green, size=size.small, text="BUY")
plotshape(bearish_cross, title="Sell Signal", style=shape.triangledown, location=location.top, color=color.red, size=size.small, text="SELL")

// --- Alert Configuration ---
if bullish_cross
    alert("Buy Signal: MACD crossed above Signal Line", alert.freq_once_per_bar_close)
if bearish_cross
    alert("Sell Signal: MACD crossed below Signal Line", alert.freq_once_per_bar_close)
