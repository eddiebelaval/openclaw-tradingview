// Triple ROC Composite — Pine Script v6

//@version=6
indicator("Triple Roc Composite", "TRC3Eng", overlay = false)

// ════════════════════════════════════════════════════════════════
// INPUTS — General
// ════════════════════════════════════════════════════════════════
var string G_GEN = "● General"
i_src        = input.source(close, "Source",       group = G_GEN)
i_showFast   = input.bool(false, "Show Fast",      group = G_GEN, inline = "vis1")
i_showComp   = input.bool(true,  "Show Composite", group = G_GEN, inline = "vis1")
i_showHeat   = input.bool(true,  "Heatmap",        group = G_GEN, inline = "vis2")
i_showGlow   = input.bool(true,  "Glow",           group = G_GEN, inline = "vis2")
i_showThresh = input.bool(true,  "Thresholds",     group = G_GEN, inline = "vis2")
i_showMid    = input.bool(true,  "Mid Band",       group = G_GEN, inline = "vis2")
i_showTable  = input.bool(true,  "Status Table",   group = G_GEN)

// ════════════════════════════════════════════════════════════════
// INPUTS — Fast Engine
// ════════════════════════════════════════════════════════════════
var string G_F = "● Fast Engine  (High Sensitivity)"
i_fL1   = input.int(3,    "ROC Lengths", minval = 1,   group = G_F, inline = "fp")
i_fL2   = input.int(5,    "",            minval = 1,   group = G_F, inline = "fp")
i_fL3   = input.int(8,    "",            minval = 1,   group = G_F, inline = "fp")
i_fL4   = input.int(13,   "",            minval = 1,   group = G_F, inline = "fp")
i_fSm   = input.int(3,    "Smoothing",   minval = 1,   group = G_F)
i_fVol  = input.int(55,   "Vol Lookback",minval = 5,   group = G_F)
i_fMult = input.float(1.6,"Thresh Mult", minval = 0.1, step = 0.1, group = G_F)
i_fClamp= input.float(2.5,"Norm Clamp",  minval = 0.5, step = 0.1, group = G_F)

// ════════════════════════════════════════════════════════════════
// INPUTS — Balanced Engine
// ════════════════════════════════════════════════════════════════
var string G_B = "● Balanced Engine  (Medium Sensitivity)"
i_bL1   = input.int(5,    "ROC Lengths", minval = 1,   group = G_B, inline = "bp")
i_bL2   = input.int(13,   "",            minval = 1,   group = G_B, inline = "bp")
i_bL3   = input.int(21,   "",            minval = 1,   group = G_B, inline = "bp")
i_bL4   = input.int(34,   "",            minval = 1,   group = G_B, inline = "bp")
i_bSm   = input.int(5,    "Smoothing",   minval = 1,   group = G_B)
i_bVol  = input.int(100,  "Vol Lookback",minval = 5,   group = G_B)
i_bMult = input.float(2.0,"Thresh Mult", minval = 0.1, step = 0.1, group = G_B)
i_bClamp= input.float(2.5,"Norm Clamp",  minval = 0.5, step = 0.1, group = G_B)

// ════════════════════════════════════════════════════════════════
// INPUTS — Slow Engine
// ════════════════════════════════════════════════════════════════
var string G_S = "● Slow Engine  (Low Sensitivity / Macro)"
i_sL1   = input.int(8,    "ROC Lengths", minval = 1,   group = G_S, inline = "sp")
i_sL2   = input.int(21,   "",            minval = 1,   group = G_S, inline = "sp")
i_sL3   = input.int(34,   "",            minval = 1,   group = G_S, inline = "sp")
i_sL4   = input.int(55,   "",            minval = 1,   group = G_S, inline = "sp")
i_sSm   = input.int(8,    "Smoothing",   minval = 1,   group = G_S)
i_sVol  = input.int(144,  "Vol Lookback",minval = 5,   group = G_S)
i_sMult = input.float(2.4,"Thresh Mult", minval = 0.1, step = 0.1, group = G_S)
i_sClamp= input.float(2.5,"Norm Clamp",  minval = 0.5, step = 0.1, group = G_S)

// ════════════════════════════════════════════════════════════════
// INPUTS — Composite
// ════════════════════════════════════════════════════════════════
var string G_C = "● Composite"
i_wF           = input.float(0.35,"Weight Fast",        minval = 0.0, maxval = 1.0, step = 0.05, group = G_C)
i_wB           = input.float(0.40,"Weight Balanced",    minval = 0.0, maxval = 1.0, step = 0.05, group = G_C)
i_wS           = input.float(0.25,"Weight Slow",        minval = 0.0, maxval = 1.0, step = 0.05, group = G_C)
i_adaptWeights = input.bool(true, "Adaptive Weights",   group = G_C,
     tooltip = "Blends user weights 50/50 with inverse-volatility weights.\nHigh-vol engine gets lower weight automatically.")
i_compSm       = input.int(3,     "Composite Smooth",   minval = 1, group = G_C)
i_deadZone     = input.float(0.10,"Dead Zone",           minval = 0.0, maxval = 0.49, step = 0.01, group = G_C,
     tooltip = "±Dead Zone is Neutral — kills zero-line chop.")
i_threshMult   = input.float(1.5, "Threshold Mult",     minval = 0.1, step = 0.1, group = G_C)
i_threshLb     = input.int(100,   "Threshold Lookback", minval = 10,  group = G_C)
i_slopeSm      = input.int(3,     "Slope Smooth",       minval = 1,   group = G_C,
     tooltip = "EMA period for composite slope. Higher = smoother.")

// ════════════════════════════════════════════════════════════════
// INPUTS — HTF Context
// ════════════════════════════════════════════════════════════════
var string G_HTF = "● HTF Context"
i_htfEnable  = input.bool(true,   "Enable HTF",         group = G_HTF,
     tooltip = "Calculates a simplified composite on the higher timeframe using close.\nUsed as context filter — does NOT change the base composite.")
i_htfTf      = input.timeframe("D","HTF Timeframe",     group = G_HTF)
i_htfSm      = input.int(5,       "HTF Smooth",         minval = 1, group = G_HTF,
     tooltip = "EMA smoothing applied to the raw HTF ROC before normalization.")
i_htfVolLb   = input.int(50,      "HTF Vol Lookback",   minval = 5,  group = G_HTF)
i_showHtf    = input.bool(false,  "Show HTF Bias Line", group = G_HTF)

// ════════════════════════════════════════════════════════════════
// INPUTS — Market Context (Range Position + Trend Quality)
// ════════════════════════════════════════════════════════════════
var string G_MKT = "● Market Context"
i_mktEnable  = input.bool(true,   "Enable Market Context", group = G_MKT,
     tooltip = "Calculates range position and trend quality.\nUsed to weight ctxScore that modulates composite color intensity.")
i_rangeLb    = input.int(50,      "Range Lookback",        minval = 10, group = G_MKT,
     tooltip = "Rolling high/low window for percentile position and midrange distance.")
i_effLb      = input.int(20,      "Efficiency Lookback",   minval = 5,  group = G_MKT,
     tooltip = "Window for trend efficiency (net move / total path).\nHigh = trending, Low = choppy.")
i_chopLb     = input.int(14,      "Choppiness Lookback",   minval = 5,  group = G_MKT,
     tooltip = "ATR-based choppiness index. High = range/chop, Low = trend.")
i_showCtx    = input.bool(false,  "Show Context Score",    group = G_MKT,
     tooltip = "Plots ctxScore as a thin line. 1.0 = high quality, 0.0 = low quality.")

// ════════════════════════════════════════════════════════════════
// INPUTS — Colors
// ════════════════════════════════════════════════════════════════
var string G_COL = "● Colors"
i_cBull     = input.color(#4caf50, "Bull / Bear",       inline = "c1", group = G_COL)
i_cBear     = input.color(#ff9800, "",                  inline = "c1", group = G_COL)
i_cBullGlow = input.color(#00bcd4, "Glow Bull / Bear",  inline = "c2", group = G_COL)
i_cBearGlow = input.color(#f44336, "",                  inline = "c2", group = G_COL)
i_cZero     = input.color(#9e9e9e, "Zero Line",         inline = "c3", group = G_COL)
i_cNeutral  = input.color(#ffffff, "Neutral",           inline = "c3", group = G_COL)
i_cFast     = input.color(#ffeb3b, "Fast Line",         group = G_COL)
i_cHeatBull = input.color(#4caf50, "Heat Bull / Bear",  inline = "c5", group = G_COL)
i_cHeatBear = input.color(#ff9800, "",                  inline = "c5", group = G_COL)
i_cHtf      = input.color(#e0e0e0, "HTF Bias",          inline = "c6", group = G_COL)
i_cCtx      = input.color(#78909c, "Context Score",     inline = "c6", group = G_COL)

// ════════════════════════════════════════════════════════════════
// ENGINE FUNCTION
// Returns: [normClamped, bull, bear, brkUp, brkDn]
// — vol floor prevents normalization spikes in low-vol flats
// — engine dead zone (20% of threshold) kills zero-line chop
// ════════════════════════════════════════════════════════════════
calcEngine(float src, simple int l1, simple int l2, simple int l3, simple int l4,
           simple int sm, simple int volLb, float mult, float clamp) =>
    float raw     = (ta.roc(src,l1) + ta.roc(src,l2) + ta.roc(src,l3) + ta.roc(src,l4)) / 4.0
    float osc     = ta.ema(raw, sm)
    float volRaw  = ta.stdev(osc, volLb)
    float volMin  = ta.sma(math.abs(osc), volLb) * 0.25
    float vol     = math.max(volRaw, volMin, 1e-10)
    float upper   = vol * mult
    float normC   = math.max(-clamp, math.min(clamp, osc / upper))
    float engDead = upper * 0.2
    bool  bull    = osc >  engDead
    bool  bear    = osc < -engDead
    bool  brkUp   = osc >  upper
    bool  brkDn   = osc < -upper
    [normC, bull, bear, brkUp, brkDn]

// ════════════════════════════════════════════════════════════════
// RUN ENGINES
// ════════════════════════════════════════════════════════════════
[fNorm, fBull, fBear, fBrkUp, fBrkDn] =
     calcEngine(i_src, i_fL1, i_fL2, i_fL3, i_fL4, i_fSm, i_fVol, i_fMult, i_fClamp)
[bNorm, bBull, bBear, bBrkUp, bBrkDn] =
     calcEngine(i_src, i_bL1, i_bL2, i_bL3, i_bL4, i_bSm, i_bVol, i_bMult, i_bClamp)
[sNorm, sBull, sBear, sBrkUp, sBrkDn] =
     calcEngine(i_src, i_sL1, i_sL2, i_sL3, i_sL4, i_sSm, i_sVol, i_sMult, i_sClamp)

// ════════════════════════════════════════════════════════════════
// COMPOSITE — adaptive inverse-volatility weights blended with static
// ════════════════════════════════════════════════════════════════
float wSum   = math.max(i_wF + i_wB + i_wS, 1e-9)
float wFst   = i_wF / wSum
float wBal   = i_wB / wSum
float wSlw   = i_wS / wSum

float fVolN  = math.max(ta.stdev(fNorm, 20), 1e-9)
float bVolN  = math.max(ta.stdev(bNorm, 20), 1e-9)
float sVolN  = math.max(ta.stdev(sNorm, 20), 1e-9)
float invSum = math.max(1.0/fVolN + 1.0/bVolN + 1.0/sVolN, 1e-9)
float aWFst  = (1.0/fVolN) / invSum
float aWBal  = (1.0/bVolN) / invSum
float aWSlw  = (1.0/sVolN) / invSum

float bWFst  = i_adaptWeights ? (wFst * 0.5 + aWFst * 0.5) : wFst
float bWBal  = i_adaptWeights ? (wBal * 0.5 + aWBal * 0.5) : wBal
float bWSlw  = i_adaptWeights ? (wSlw * 0.5 + aWSlw * 0.5) : wSlw
float bWSum  = math.max(bWFst + bWBal + bWSlw, 1e-9)
float nWFst  = bWFst / bWSum
float nWBal  = bWBal / bWSum
float nWSlw  = bWSlw / bWSum

float compRaw   = fNorm * nWFst + bNorm * nWBal + sNorm * nWSlw
float composite = ta.ema(compRaw, i_compSm)

// ════════════════════════════════════════════════════════════════
// ADAPTIVE COMPOSITE THRESHOLDS
// ════════════════════════════════════════════════════════════════
float cVolRaw   = ta.stdev(composite, i_threshLb)
float cVolMin   = ta.sma(math.abs(composite), i_threshLb) * 0.25
float cVol      = math.max(cVolRaw, cVolMin, 1e-10)
float compUpper = cVol * i_threshMult
float compLower = -compUpper
bool  isOverUpper = composite > compUpper
bool  isOverLower = composite < compLower

// ════════════════════════════════════════════════════════════════
// STATES
// ════════════════════════════════════════════════════════════════
bool isNeutral   = math.abs(composite) < i_deadZone
bool compBull    = composite >  i_deadZone
bool compBear    = composite < -i_deadZone
bool compStrBull = isOverUpper
bool compStrBear = isOverLower
bool compExtBull = composite >  compUpper * 1.3
bool compExtBear = composite < -compUpper * 1.3

float slopeRaw = composite - composite[1]
float slope    = ta.ema(slopeRaw, i_slopeSm)
bool  slopeUp  = slope > 0.0
bool  slopeDn  = slope < 0.0

int bullCount = (fBull ? 1 : 0) + (bBull ? 1 : 0) + (sBull ? 1 : 0)
int bearCount = (fBear ? 1 : 0) + (bBear ? 1 : 0) + (sBear ? 1 : 0)

// ════════════════════════════════════════════════════════════════
// FAST BREAKOUT BACKGROUND
// Active while fNorm is outside composite thresholds (upper/lower).
// Uses var to persist state across bars — stays ON until fNorm
// returns inside the band.
// Cyan (bull) when fNorm > compUpper, Orange (bear) when fNorm < compLower.
// ════════════════════════════════════════════════════════════════
var bool fastAbove = false
var bool fastBelow = false
fastAbove := fNorm > compUpper ? true  : fNorm < compUpper ? false : fastAbove
fastBelow := fNorm < compLower ? true  : fNorm > compLower ? false : fastBelow

color fastBgColor = fastAbove ? color.new(#00bcd4, 82) :
     fastBelow ? color.new(#ff9800, 82) : na

bgcolor(fastBgColor, title = "Fast Breakout BG")

// ════════════════════════════════════════════════════════════════
// MODULE 1 — HTF CONTEXT
// Runs a single lightweight ROC engine on the higher timeframe
// using close (request.security does not accept series source).
// Returns: htfBias (-1..+1 normalized), htfSlope, htfVolState
// htfVolState: 1 = expanding, -1 = contracting, 0 = neutral
// ════════════════════════════════════════════════════════════════
// HTF raw ROC (average of 4 lengths scaled to HTF)
htfRaw = request.security(syminfo.tickerid, i_htfTf,
     (ta.roc(close,3) + ta.roc(close,8) + ta.roc(close,21) + ta.roc(close,55)) / 4.0,
     lookahead = barmerge.lookahead_off)

// Smooth and normalize on current TF after security call
float htfOsc     = ta.ema(htfRaw, i_htfSm)
float htfVolRaw  = ta.stdev(htfOsc, i_htfVolLb)
float htfVolMin  = ta.sma(math.abs(htfOsc), i_htfVolLb) * 0.25
float htfVol     = math.max(htfVolRaw, htfVolMin, 1e-10)
float htfUpper   = htfVol * 1.5
// Bias: normalized -1..+1, clamped
float htfBias    = i_htfEnable ? math.max(-1.0, math.min(1.0, htfOsc / htfUpper)) : 0.0
// HTF slope (smoothed)
float htfSlope   = ta.ema(htfBias - htfBias[1], 3)
bool  htfUp      = htfBias >  0.1
bool  htfDn      = htfBias < -0.1
// HTF volatility state: compare current vol to its own SMA
float htfVolSma  = ta.sma(htfVol, i_htfVolLb)
int   htfVolState = htfVol > htfVolSma * 1.1 ? 1 : htfVol < htfVolSma * 0.9 ? -1 : 0
// HTF alignment with composite
bool  htfAgrees  = i_htfEnable ? (compBull and htfUp) or (compBear and htfDn) : true
bool  htfContra  = i_htfEnable ? (compBull and htfDn) or (compBear and htfUp) : false

// ════════════════════════════════════════════════════════════════
// MODULE 2 — RANGE POSITION
// percentile position in rolling high/low range (0..1)
// normalized distance from midrange (-1..+1)
// range expansion / contraction flag
// ════════════════════════════════════════════════════════════════
float rHigh      = ta.highest(close, i_rangeLb)
float rLow       = ta.lowest(close,  i_rangeLb)
float rRange     = math.max(rHigh - rLow, syminfo.mintick)
float rMid       = rLow + rRange * 0.5
// percentile position: 0 = at range low, 1 = at range high
float rPct       = (close - rLow) / rRange
// normalized distance from midrange: +1 = top, -1 = bottom
float rDist      = math.max(-1.0, math.min(1.0, (close - rMid) / (rRange * 0.5)))
// range expansion: current range vs its SMA
float rRangeSma  = ta.sma(rRange, i_rangeLb)
bool  rExpanding = rRange > rRangeSma * 1.05
bool  rContracting = rRange < rRangeSma * 0.95

// ════════════════════════════════════════════════════════════════
// MODULE 3 — TREND QUALITY
// Efficiency ratio: net move / total path (0..1, higher = trending)
// Choppiness index: normalized ATR/range (0..1, lower = trending)
// Combined → trendQuality (0..1)
// ════════════════════════════════════════════════════════════════
// Efficiency ratio
float netMove    = math.abs(close - close[i_effLb])
float totalPath  = math.sum(math.abs(close - close[1]), i_effLb)
float effRatio   = totalPath > 0 ? math.min(netMove / totalPath, 1.0) : 0.0

// Choppiness index (0..1): 1 = max chop, 0 = pure trend
float atrSum     = math.sum(ta.atr(1), i_chopLb)
float chopHigh   = ta.highest(high, i_chopLb)
float chopLow    = ta.lowest(low,   i_chopLb)
float chopRange  = math.max(chopHigh - chopLow, syminfo.mintick)
// raw choppiness: log(atrSum/range) / log(period), normalized 0..1
float chopRaw    = math.log(atrSum / chopRange) / math.log(i_chopLb)
float chop       = math.max(0.0, math.min(1.0, chopRaw))
// trend quality: high effRatio + low chop = trending
float trendQuality = (effRatio + (1.0 - chop)) / 2.0

// ════════════════════════════════════════════════════════════════
// CONTEXT SCORE  (ctxScore 0..1)
// Combines HTF agreement, range position alignment, trend quality.
// Used only as visual/table modifier — does NOT change composite.
//
// Logic:
//   htfFactor   : 1.0 if HTF agrees, 0.5 if neutral, 0.2 if contra
//   rangeFactor : reward momentum in mid-to-extreme range position
//                 penalize when price is at extremes against direction
//   qualFactor  : trendQuality directly
// ════════════════════════════════════════════════════════════════
float htfFactor   = i_htfEnable ?
     (htfAgrees ? 1.0 : htfContra ? 0.2 : 0.5) : 1.0

// Range factor: if bull and price in upper half → good; lower half → weak
// if bear and price in lower half → good; upper half → weak
float rangeFactor = compBull ? rPct : compBear ? (1.0 - rPct) : 0.5

float qualFactor  = i_mktEnable ? trendQuality : 1.0

// Weighted average: HTF is most important context
float ctxScore    = (htfFactor * 0.45 + rangeFactor * 0.30 + qualFactor * 0.25)
ctxScore         := math.max(0.0, math.min(1.0, ctxScore))

// ctxScore categories
bool  ctxHigh    = ctxScore >= 0.65
bool  ctxMid     = ctxScore >= 0.40 and ctxScore < 0.65
bool  ctxLow     = ctxScore  < 0.40

// ════════════════════════════════════════════════════════════════
// COMPOSITE COLOR  — ctxScore modulates transparency
// High ctx = full opacity; low ctx = more transparent (dim signal)
// luminance: 0..1 based on distance from zero to threshold
// ════════════════════════════════════════════════════════════════
float lum = compUpper > 0.0 ? math.min(math.abs(composite) / compUpper, 1.0) : 0.0

// ctx transparency offset: low quality dims the line
int ctxAlpha = ctxHigh ? 0 : ctxMid ? 20 : 45

color baseCompColor = isNeutral  ? i_cNeutral :
     compExtBull ? i_cBullGlow :
     compExtBear ? i_cBearGlow :
     compStrBull ? color.from_gradient(lum, 0.9, 1.0, i_cBull, i_cBullGlow) :
     compStrBear ? color.from_gradient(lum, 0.9, 1.0, i_cBear, i_cBearGlow) :
     compBull    ? color.from_gradient(lum, 0.0, 0.9, color.new(i_cBull, 45), i_cBull) :
                   color.from_gradient(lum, 0.0, 0.9, color.new(i_cBear, 45), i_cBear)

color compColor = color.new(baseCompColor, ctxAlpha)

// ════════════════════════════════════════════════════════════════
// PLOTS — THRESHOLDS + REFERENCE
// ════════════════════════════════════════════════════════════════
upperPlot = plot(i_showThresh ? compUpper : na, "Upper Threshold",
     color.new(i_cBull, 50), 1, plot.style_line)
lowerPlot = plot(i_showThresh ? compLower : na, "Lower Threshold",
     color.new(i_cBear, 50), 1, plot.style_line)

float midBand = compUpper * 0.5
midUpPlot = plot(i_showMid ?  midBand : na, "Mid+ Band", color.new(i_cBull, 80), 1, plot.style_line)
midDnPlot = plot(i_showMid ? -midBand : na, "Mid- Band", color.new(i_cBear, 80), 1, plot.style_line)

// ════════════════════════════════════════════════════════════════
// PLOTS — MAIN
// ════════════════════════════════════════════════════════════════
zeroPlot = plot(0.0, "Zero", color.new(i_cZero, 55), 1, plot.style_line)

plot(i_showFast ? fNorm : na, "Fast",     color.new(i_cFast, 65), 1, plot.style_line)

compPlot = plot(i_showComp ? composite : na, "Composite", compColor, 3, plot.style_line)

// HTF bias line — scaled to threshold space for visual alignment
// htfBias is -1..+1, multiply by compUpper to plot in same space as composite
float htfScaled  = htfBias * compUpper
htfPlot = plot(i_htfEnable and i_showHtf ? htfScaled : na, "HTF Bias",
     color.new(i_cHtf, 40), 1, plot.style_line)

// Context score — plotted as 0..1 scaled to threshold band for readability
float ctxPlotVal = i_mktEnable and i_showCtx ? ctxScore * compUpper : na
plot(ctxPlotVal, "Context Score", color.new(i_cCtx, 50), 1, plot.style_line)

// ════════════════════════════════════════════════════════════════
// FILLS
// ════════════════════════════════════════════════════════════════

// Threshold band — subtle ambient tint
fill(upperPlot, lowerPlot,
     color = i_showThresh ?
         (compBull ? color.new(i_cBull, 95) :
          compBear ? color.new(i_cBear, 95) :
                     color.new(i_cNeutral, 97)) :
          color.new(i_cNeutral, 100),
     title = "Threshold Band")

// Bullish gradient heatmap
fill(compPlot, zeroPlot,
     top_value    = i_showHeat ? math.max(composite, 0.0) : na,
     bottom_value = i_showHeat ? 0.0 : na,
     top_color    = color.new(i_cHeatBull, 25),
     bottom_color = color.new(i_cHeatBull, 100),
     title        = "Bull Heatmap")

// Bearish gradient heatmap
fill(compPlot, zeroPlot,
     top_value    = i_showHeat ? 0.0 : na,
     bottom_value = i_showHeat ? math.min(composite, 0.0) : na,
     top_color    = color.new(i_cHeatBear, 100),
     bottom_color = color.new(i_cHeatBear, 25),
     title        = "Bear Heatmap")

// Bull glow
fill(compPlot, upperPlot,
     top_value    = i_showGlow and isOverUpper ? composite : na,
     bottom_value = i_showGlow and isOverUpper ? compUpper : na,
     top_color    = color.new(i_cBullGlow, 15),
     bottom_color = color.new(i_cBullGlow, 80),
     title        = "Bull Glow")

// Bear glow
fill(compPlot, lowerPlot,
     top_value    = i_showGlow and isOverLower ? compLower  : na,
     bottom_value = i_showGlow and isOverLower ? composite  : na,
     top_color    = color.new(i_cBearGlow, 80),
     bottom_color = color.new(i_cBearGlow, 15),
     title        = "Bear Glow")

// ════════════════════════════════════════════════════════════════
// STATUS TABLE — helpers at global scope
// ════════════════════════════════════════════════════════════════
f_eTxt(brkUp, brkDn, bull, bear) =>
    brkUp ? "▲ Breakout" : brkDn ? "▼ Breakout" : bull ? "Bull" : bear ? "Bear" : "Neutral"

f_eCol(brkUp, brkDn, bull, bear, cBG, cBRG, cB, cBR, cN) =>
    color r = cN
    if brkUp
        r := cBG
    else if brkDn
        r := cBRG
    else if bull
        r := cB
    else if bear
        r := cBR
    r

if i_showTable and barstate.islast
    string fTxt = f_eTxt(fBrkUp, fBrkDn, fBull, fBear)
    string bTxt = f_eTxt(bBrkUp, bBrkDn, bBull, bBear)
    string sTxt = f_eTxt(sBrkUp, sBrkDn, sBull, sBear)
    color  fCol = f_eCol(fBrkUp, fBrkDn, fBull, fBear, i_cBullGlow, i_cBearGlow, i_cBull, i_cBear, i_cNeutral)
    color  bCol = f_eCol(bBrkUp, bBrkDn, bBull, bBear, i_cBullGlow, i_cBearGlow, i_cBull, i_cBear, i_cNeutral)
    color  sCol = f_eCol(sBrkUp, sBrkDn, sBull, sBear, i_cBullGlow, i_cBearGlow, i_cBull, i_cBear, i_cNeutral)

    string cTxt = isNeutral   ? "Neutral"    :
         compExtBull ? "▲▲ Extreme"  :
         compExtBear ? "▼▼ Extreme"  :
         compStrBull ? "▲ Strong"    :
         compStrBear ? "▼ Strong"    :
         compBull    ? "Bull"        : "Bear"
    color  cCol = isNeutral   ? i_cNeutral   :
         compExtBull ? i_cBullGlow   :
         compExtBear ? i_cBearGlow   :
         compBull    ? i_cBull       : i_cBear

    int    neutCount = 3 - bullCount - bearCount
    string aTxt = str.tostring(bullCount) + "↑  " +
         str.tostring(bearCount) + "↓  " +
         str.tostring(neutCount) + "–"
    color  aCol = bullCount == 3 ? i_cBullGlow :
         bearCount  == 3 ? i_cBearGlow :
         bullCount  >= 2 ? i_cBull     :
         bearCount  >= 2 ? i_cBear     : i_cNeutral

    string slTxt = slope >  0.03 ? "Rising ↑"  :
         slope < -0.03 ? "Falling ↓" : "Flat →"
    color  slCol = slopeUp ? i_cBull : slopeDn ? i_cBear : i_cNeutral

    string wTxt = i_adaptWeights ?
         str.format("F{0}  B{1}  S{2}",
             str.tostring(math.round(nWFst * 100)),
             str.tostring(math.round(nWBal * 100)),
             str.tostring(math.round(nWSlw * 100))) : "Static"

    // HTF row
    string htfTxt = not i_htfEnable ? "Off" :
         htfBias >  0.3 ? "▲ Bull" :
         htfBias < -0.3 ? "▼ Bear" :
         htfSlope >  0.02 ? "↑ Rising" :
         htfSlope < -0.02 ? "↓ Falling" : "Neutral"
    color  htfCol = not i_htfEnable ? i_cNeutral :
         htfUp ? i_cBull : htfDn ? i_cBear : i_cNeutral
    string htfVolTxt = htfVolState == 1 ? "Expand" : htfVolState == -1 ? "Contract" : "Stable"

    // Range row
    string rPctTxt  = str.format("{0}%", math.round(rPct * 100))
    string rZoneTxt = rPct > 0.75 ? "Upper zone" : rPct < 0.25 ? "Lower zone" : "Mid zone"
    color  rCol     = rPct > 0.6 ? i_cBull : rPct < 0.4 ? i_cBear : i_cNeutral
    string rExpTxt  = rExpanding ? "Expanding" : rContracting ? "Contr." : "Stable"

    // Quality row
    string qualTxt  = str.format("{0}%", math.round(trendQuality * 100))
    color  qualCol  = trendQuality > 0.6 ? i_cBull :
         trendQuality < 0.35 ? i_cBear : i_cNeutral
    string effTxt   = str.format("Eff {0}%", math.round(effRatio * 100))

    // Context score row
    string ctxTxt   = str.format("{0}%", math.round(ctxScore * 100))
    color  ctxCol   = ctxHigh ? i_cBull : ctxLow ? i_cBear : i_cNeutral
    string ctxQual  = ctxHigh ? "High" : ctxMid ? "Mid" : "Low"

    string vTxt = str.format("{0,number,#.###}", composite)

    color dimBg  = color.new(chart.bg_color, 5)
    color hdrBg  = color.new(i_cZero, 70)
    color compBg = isNeutral ? color.new(i_cNeutral, 88) :
         compBull ? color.new(i_cBull, 88) : color.new(i_cBear, 88)
    color ctxBg  = ctxHigh ? color.new(i_cBull, 90) :
         ctxLow ? color.new(i_cBear, 90) : color.new(i_cNeutral, 95)

    // Table: 2 cols × 16 rows
    var table tbl = table.new(position.bottom_right, 2, 16,
         bgcolor      = color.new(chart.bg_color, 8),
         border_width = 1,
         border_color = color.new(i_cZero, 50),
         frame_width  = 1,
         frame_color  = color.new(i_cZero, 30))

    // ── Engines ──────────────────────────────────────
    table.cell(tbl, 0,  0, "ENGINE",    text_color = color.white,              text_size = size.small, bgcolor = hdrBg)
    table.cell(tbl, 1,  0, "STATE",     text_color = color.white,              text_size = size.small, bgcolor = hdrBg)
    table.cell(tbl, 0,  1, "Fast",      text_color = color.new(i_cFast,  20),  text_size = size.small, bgcolor = dimBg)
    table.cell(tbl, 1,  1, fTxt,        text_color = fCol,                     text_size = size.small, bgcolor = dimBg)
    table.cell(tbl, 0,  2, "Balanced",  text_color = color.new(i_cNeutral, 30), text_size = size.small, bgcolor = dimBg)
    table.cell(tbl, 1,  2, bTxt,        text_color = bCol,                     text_size = size.small, bgcolor = dimBg)
    table.cell(tbl, 0,  3, "Slow",      text_color = color.new(i_cNeutral, 30), text_size = size.small, bgcolor = dimBg)
    table.cell(tbl, 1,  3, sTxt,        text_color = sCol,                     text_size = size.small, bgcolor = dimBg)
    // ── Composite ────────────────────────────────────
    table.cell(tbl, 0,  4, "Composite", text_color = cCol,                     text_size = size.small, bgcolor = compBg)
    table.cell(tbl, 1,  4, cTxt,        text_color = cCol,                     text_size = size.small, bgcolor = compBg)
    table.cell(tbl, 0,  5, "Align",     text_color = color.new(i_cNeutral,20), text_size = size.small, bgcolor = dimBg)
    table.cell(tbl, 1,  5, aTxt,        text_color = aCol,                     text_size = size.small, bgcolor = dimBg)
    table.cell(tbl, 0,  6, "Slope",     text_color = color.new(i_cNeutral,20), text_size = size.small, bgcolor = dimBg)
    table.cell(tbl, 1,  6, slTxt,       text_color = slCol,                    text_size = size.small, bgcolor = dimBg)
    table.cell(tbl, 0,  7, "Weights",   text_color = color.new(i_cNeutral,20), text_size = size.small, bgcolor = dimBg)
    table.cell(tbl, 1,  7, wTxt,        text_color = color.new(i_cNeutral,10), text_size = size.small, bgcolor = dimBg)
    table.cell(tbl, 0,  8, "Value",     text_color = color.new(i_cNeutral,20), text_size = size.small, bgcolor = dimBg)
    table.cell(tbl, 1,  8, vTxt,        text_color = cCol,                     text_size = size.small, bgcolor = dimBg)
    // ── HTF ──────────────────────────────────────────
    table.cell(tbl, 0,  9, "HTF Bias",  text_color = color.white,              text_size = size.small, bgcolor = hdrBg)
    table.cell(tbl, 1,  9, i_htfTf,    text_color = color.new(i_cHtf, 20),    text_size = size.small, bgcolor = hdrBg)
    table.cell(tbl, 0, 10, "Bias",      text_color = color.new(i_cNeutral,20), text_size = size.small, bgcolor = dimBg)
    table.cell(tbl, 1, 10, htfTxt,      text_color = htfCol,                   text_size = size.small, bgcolor = dimBg)
    table.cell(tbl, 0, 11, "HTF Vol",   text_color = color.new(i_cNeutral,20), text_size = size.small, bgcolor = dimBg)
    table.cell(tbl, 1, 11, htfVolTxt,   text_color = i_cNeutral,               text_size = size.small, bgcolor = dimBg)
    // ── Market Context ────────────────────────────────
    table.cell(tbl, 0, 12, "Market",    text_color = color.white,              text_size = size.small, bgcolor = hdrBg)
    table.cell(tbl, 1, 12, "Context",   text_color = color.white,              text_size = size.small, bgcolor = hdrBg)
    table.cell(tbl, 0, 13, "Range",     text_color = color.new(i_cNeutral,20), text_size = size.small, bgcolor = dimBg)
    table.cell(tbl, 1, 13, rPctTxt + "  " + rExpTxt, text_color = rCol,       text_size = size.small, bgcolor = dimBg)
    table.cell(tbl, 0, 14, "Quality",   text_color = color.new(i_cNeutral,20), text_size = size.small, bgcolor = dimBg)
    table.cell(tbl, 1, 14, qualTxt + "  " + effTxt,  text_color = qualCol,    text_size = size.small, bgcolor = dimBg)
    // ── Context Score ────────────────────────────────
    table.cell(tbl, 0, 15, "Ctx Score", text_color = ctxCol,                   text_size = size.small, bgcolor = ctxBg)
    table.cell(tbl, 1, 15, ctxTxt + "  " + ctxQual, text_color = ctxCol,      text_size = size.small, bgcolor = ctxBg)
