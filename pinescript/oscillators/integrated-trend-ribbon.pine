//@version=6
indicator("Ultimate Weighted Ribbon_Skip30", overlay=true)

// --- 1. Inputs ---
rvwapLen = input.int(20, "RVWAP Window")
emaFastLen = input.int(9, "Fast EMA")
emaSlowLen = input.int(21, "Slow EMA")
fishLen = input.int(9, "Fisher Transform Length")
mfiLen = input.int(14, "MFI Length")

// --- 2. Calculations ---
rvwap = ta.vwap(hlc3)
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
[macdLine, sigLine, _] = ta.macd(close, 12, 26, 9)
rsiVal = ta.rsi(close, 14)
mfiVal = ta.mfi(close, mfiLen)

// Fisher Transform (v6 Fix)
var float fish = 0.0
high_ = ta.highest(hl2, fishLen), low_ = ta.lowest(hl2, fishLen)
var float value = 0.0
value := 0.66 * ((hl2 - low_) / (math.max(high_ - low_, 0.001)) - 0.5) + 0.67 * nz(value[1])
value := value > 0.99 ? 0.999 : value < -0.99 ? -0.999 : value
fish := 0.5 * math.log((1 + value) / (1 - value)) + 0.5 * nz(fish[1])

// Tweezer Logic (+/- 1)
isTweezerBottom = math.abs(low - low[1]) < (low * 0.0001) and low < low[2]
isTweezerTop    = math.abs(high - high[1]) < (high * 0.0001) and high > high[2]

// --- 3. Weighted Scoring System ---
int score = 0
score += (close > emaFast ? 1 : -1)
score += (close > emaSlow ? 1 : -1)
score += (close > emaFast and close > emaSlow ? 1 : -1)
score += (close > rvwap ? 1 : -1)
score += (macdLine > sigLine ? 1 : -1)
score += (rsiVal > 50 ? 1 : -1)
score += (fish > nz(fish[1]) ? 1 : -1)
score += (mfiVal > 50 ? 1 : -1)
score += (isTweezerBottom ? 1 : 0)
score += (isTweezerTop ? -1 : 0)

// --- 4. Trend States ---
isStrongBull = score >= 7
isBull       = score >= 3 and score < 7
isMildBull   = score >= 1 and score < 3
isNeutral    = score == 0
isMildBear   = score <= -1 and score > -3
isBear       = score <= -3 and score > -7
isStrongBear = score <= -7

// --- 5. Skip Detection Logic (The 30% Pop Trigger) ---
bullSkip = (isNeutral[1] and (isBull or isStrongBull)) or (isMildBull[1] and isStrongBull)
bearSkip = (isNeutral[1] and (isBear or isStrongBear)) or (isMildBear[1] and isStrongBear)

// --- 6. Visual Ribbon Output (0% Transparency for Max Brightness) ---
plotchar(isStrongBull, "Strong Bull", "💎", location.bottom, color.green,  size=size.tiny)
plotchar(isBull,       "Bull",        "🚀", location.bottom, color.green,  size=size.tiny)
plotchar(isMildBull,   "Mild Bull",   "📈", location.bottom, color.green,  size=size.tiny)
plotchar(isNeutral,    "Neutral",     "❌", location.bottom, color.yellow, size=size.tiny)
plotchar(isMildBear,   "Mild Bear",   "📉", location.bottom, color.red,    size=size.tiny)
plotchar(isBear,       "Bear",        "🔥", location.bottom, color.red,    size=size.tiny)
plotchar(isStrongBear, "Strong Bear", "💀", location.bottom, color.red,    size=size.tiny)

// --- 7. QUAD STACKING (30% Visual Pop) ---
// We plot the same character 3 additional times for bull/bear skips to reach 30% density
// Bull Skips
plotchar(bullSkip and isStrongBull, "SB Skip 1", "💎", location.bottom, color.green, size=size.tiny)
plotchar(bullSkip and isStrongBull, "SB Skip 2", "💎", location.bottom, color.green, size=size.tiny)
plotchar(bullSkip and isStrongBull, "SB Skip 3", "💎", location.bottom, color.green, size=size.tiny)

plotchar(bullSkip and isBull, "Bull Skip 1", "🚀", location.bottom, color.green, size=size.tiny)
plotchar(bullSkip and isBull, "Bull Skip 2", "🚀", location.bottom, color.green, size=size.tiny)
plotchar(bullSkip and isBull, "Bull Skip 3", "🚀", location.bottom, color.green, size=size.tiny)

// Bear Skips
plotchar(bearSkip and isStrongBear, "SBr Skip 1", "💀", location.bottom, color.red, size=size.tiny)
plotchar(bearSkip and isStrongBear, "SBr Skip 2", "💀", location.bottom, color.red, size=size.tiny)
plotchar(bearSkip and isStrongBear, "SBr Skip 3", "💀", location.bottom, color.red, size=size.tiny)

plotchar(bearSkip and isBear, "Bear Skip 1", "🔥", location.bottom, color.red, size=size.tiny)
plotchar(bearSkip and isBear, "Bear Skip 2", "🔥", location.bottom, color.red, size=size.tiny)
plotchar(bearSkip and isBear, "Bear Skip 3", "🔥", location.bottom, color.red, size=size.tiny)
