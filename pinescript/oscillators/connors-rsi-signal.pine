//@version=6
indicator(title="Connors RSI + Signal", shorttitle="CRSI", format=format.price, precision=2, timeframe="", timeframe_gaps=true)

src = close
lenrsi = input(3, "RSI Length")
lenupdown = input(2, "UpDown Length")
lenroc = input(100, "ROC Length")

// Diese Eingaben steuern nun zuverlässig ALLES (Linien + Füllung)
upper_level = input.int(80, title="Upper Band Level")
lower_level = input.int(20, title="Lower Band Level")

updown(s) =>
    isEqual = s == s[1]
    isGrowing = s > s[1]
    ud = 0.0
    ud := isEqual ? 0 : isGrowing ? (nz(ud[1]) <= 0 ? 1 : nz(ud[1])+1) : (nz(ud[1]) >= 0 ? -1 : nz(ud[1])-1)
    ud

rsi = ta.rsi(src, lenrsi)
updownrsi = ta.rsi(updown(src), lenupdown)
percentrank = ta.percentrank(ta.roc(src, 1), lenroc)
crsi = math.avg(rsi, updownrsi, percentrank)

plot(crsi, "CRSI", #2962FF)

// --- LÖSUNG: hline wurde durch plot ersetzt ---
// Die Bänder nutzen jetzt plot(). Dadurch verschwinden die Zahlenfelder 
// im "Stil"-Tab und die Werte können nur noch im "Eingaben"-Tab 
// geändert werden, wo sie synchron mit der Füllung bleiben.
band1 = plot(upper_level, "Oberes Band", color = #787B86)
band_mid = plot(50, "Middle Band", color=color.new(#787B86, 50))
band0 = plot(lower_level, "Unteres Band",  color = #787B86)
fill(band1, band0, color.rgb(33, 150, 243, 90), title = "Hintergrund")

// --- Logik für ein sauberes Menü (Stil-Tab) ---
is_ob = crsi > upper_level
is_os = crsi < lower_level

p_ob_top = plot(is_ob ? 100 : na, display = display.none, editable = false)
p_ob_bot = plot(is_ob ? upper_level : na, display = display.none, editable = false)

p_os_top = plot(is_os ? lower_level : na, display = display.none, editable = false)
p_os_bot = plot(is_os ? 0 : na, display = display.none, editable = false)

fill(p_ob_top, p_ob_bot, color = color.new(color.red, 60), title="Füllung Zone Oben")
fill(p_os_top, p_os_bot, color = color.new(color.green, 60), title="Füllung Zone Unten")
