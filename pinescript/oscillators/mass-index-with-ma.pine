//@version=6
indicator(title="Mass Index with MA", format=format.price, precision=2, timeframe="", timeframe_gaps=true)

// Mass Index inputs
length = input.int(10, minval=1, title="Mass Index Length")

// Moving Average inputs
maLength = input.int(20, minval=1, title="MA Length")
maType = input.string("SMA", title="MA Type", options=["SMA", "EMA", "WMA", "RMA"])

// Mass Index calculation
span = high - low
mi = math.sum(ta.ema(span, 9) / ta.ema(ta.ema(span, 9), 9), length)

// Moving Average function
ma(source, length, type) =>
    switch type
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "WMA" => ta.wma(source, length)
        "RMA" => ta.rma(source, length)

// MA on Mass Index
miMA = ma(mi, maLength, maType)

// Plots
plot(mi, "Mass Index", color=color.blue)
plot(miMA, "MA on Mass Index", color=color.orange, linewidth=2)
