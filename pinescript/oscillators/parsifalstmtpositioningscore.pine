//@version=6
// author: parsifaltrading

indicator("Parsifal.STMT.PositioningScore", overlay=false)

// ─────────────────────────────────────────────
// Cumulative Normal Distribution Function
// Abramowitz & Stegun approximation
// ─────────────────────────────────────────────
f_normCdf(x) =>
    float a1 =  0.254829592
    float a2 = -0.284496736
    float a3 =  1.421413741
    float a4 = -1.453152027
    float a5 =  1.061405429
    float p  =  0.3275911
    float sign_x = x < 0 ? -1.0 : 1.0
    float x_abs  = math.abs(x)
    float t      = 1.0 / (1.0 + p * x_abs)
    float y      = ((((a5 * t + a4) * t + a3) * t + a2) * t + a1) * t
    float erf_a  = 1.0 - y * math.exp(-x_abs * x_abs)
    0.5 * (1.0 + sign_x * erf_a)

// ─────────────────────────────────────────────
// TEMA helper
// ─────────────────────────────────────────────
tema(src, length) =>
    ema1 = ta.ema(src, length)
    ema2 = ta.ema(ema1, length)
    ema3 = ta.ema(ema2, length)
    3 * ema1 - 3 * ema2 + ema3

// ─────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────
length  = input(14, title="Stochastic Length")
smoothK = input(3,  title="K Smoothing")
smoothD = input(3,  title="D Smoothing")

// ─────────────────────────────────────────────
// RSI & Stochastics
// ─────────────────────────────────────────────
rsi_length       = 14
rsi              = ta.rsi(close, rsi_length)
rsi_ema          = ta.ema(rsi, rsi_length)

k                = ta.sma(ta.stoch(close, high, low, length), smoothK)
Stoch_signal     = ta.sma(k, smoothD)
Stoch_signal_ema = ta.ema(Stoch_signal, 14)

RSI_k        = ta.sma(ta.stoch(rsi, rsi, rsi, length), smoothK)
stochRSI     = ta.sma(RSI_k, smoothD)
stochRSI_ema = ta.ema(stochRSI, 14)

Stoch_rsi = ta.rsi(close, rsi_length)

// ─────────────────────────────────────────────
// EMA / TEMA of Close
// ─────────────────────────────────────────────
ema5_close   = ta.ema(close, 5)
ema21_close  = ta.ema(close, 21)
ema50_close  = ta.ema(close, 50)
ema200_close = ta.ema(close, 200)
tema_close   = tema(close, 21)

slope_ema21_close  = ema21_close  - nz(ema21_close[1])
slope_ema50_close  = ema50_close  - nz(ema50_close[1])
slope_ema200_close = ema200_close - nz(ema200_close[1])

X_ema21_close  = close - ema21_close
X_ema50_close  = close - ema50_close
X_ema200_close = close - ema200_close

// ─────────────────────────────────────────────
// Module: SwingFast
// ─────────────────────────────────────────────
signal1up = 0.5 * (((rsi > 50 and rsi < 60) ? 0.1 * (rsi - 52) : 0.0) + (rsi > 60 ? 1.0 : 0.0)) * (1 + ((rsi > rsi_ema and rsi > rsi_ema[1]) ? 1 : 0))
signal2up = 1 + ((rsi > rsi[3] and rsi > rsi[4]) ? 1 : 0) + ((rsi_ema > rsi_ema[1] and rsi_ema > rsi_ema[2]) ? 1 : 0)
signal3up = (rsi / 75 + rsi_ema / 70 + Stoch_signal / 85 + Stoch_signal_ema / 80 + stochRSI_ema / 80) / 15

signal1dn = 0.5 * (((rsi < 50 and rsi > 40) ? 0.1 * (48 - rsi) : 0.0) + (rsi < 40 ? 1.0 : 0.0)) * (1 + ((rsi < rsi_ema and rsi < rsi_ema[1]) ? 1 : 0))
signal2dn = 1 + ((rsi < rsi[3] and rsi < rsi[4]) ? 1 : 0) + ((rsi_ema < rsi_ema[1] and rsi_ema < rsi_ema[2]) ? 1 : 0)
signal3dn = ((100 - rsi) / 75 + (100 - rsi_ema) / 70 + (100 - Stoch_signal) / 85 + (100 - Stoch_signal_ema) / 80 + (100 - stochRSI_ema) / 80) / 15

swing_fast   = 100 * (signal1up * signal2up * signal3up - signal1dn * signal2dn * signal3dn)
swing_fastMA = ta.ema(swing_fast, 9)

// ─────────────────────────────────────────────
// Module: SwingFlow
// ─────────────────────────────────────────────
hiLoRange   = math.max(high, high[1]) - math.min(low, low[1])

OS_neg_help = (((high - open) / (high - low)) * (close < open ? 1.0 : 0.0) + math.max(0.0, close[1] - open) / hiLoRange) / 2
OS_neg      = math.max(OS_neg_help, OS_neg_help[1], OS_neg_help[2])

US_pos_help = (((open - low) / (high - low)) * (close > open ? 1.0 : 0.0) + math.max(0.0, open - close[1]) / hiLoRange) / 2
US_pos      = math.max(US_pos_help, US_pos_help[1], US_pos_help[2])

snr       = (close - close[1]) / hiLoRange
extend_up = (math.max(0.0, high - high[1]) + math.max(0.0, low - high[1]) + math.max(0.0, low - low[1])) / hiLoRange / 3
extend_dn = (math.max(0.0, low[1] - low) + math.max(0.0, low[1] - high) + math.max(0.0, high[1] - high)) / hiLoRange / 3

up_flow_single = (math.max(high - high[1], 0.0) + math.max(low - low[1], 0.0) + math.max(close - open, 0.0) + math.max(close - high[1], 0.0) + (close - low) + math.max(close - close[1], 0.0)) / hiLoRange / 5
dn_flow_single = (math.min(high - high[1], 0.0) + math.min(low - low[1], 0.0) + math.min(close - open, 0.0) + math.min(close - low[1], 0.0) + (close - high) + math.min(close - close[1], 0.0)) / hiLoRange / 5

hiLo5 = math.max(high, high[1], high[2], high[3], high[4]) - math.min(high, high[1], high[2], high[3], high[4])
loLo5 = math.max(low, low[1], low[2], low[3], low[4]) - math.min(low, low[1], low[2], low[3], low[4])

rel_high = (high - math.min(high, high[1], high[2], high[3], high[4])) / hiLo5
rel_low  = (low  - math.min(low,  low[1],  low[2],  low[3],  low[4]))  / loLo5

pattern_bin_up = (US_pos + (close - low) / (high - low) + math.max(0.0, snr) + extend_up + up_flow_single + (math.max(0.0, high - high[1]) + math.max(0.0, low - low[1])) / hiLoRange + rel_high + rel_low) / 8
pattern_bin_dn = (OS_neg + (high - close) / (high - low) + math.max(0.0, -snr) + extend_dn - dn_flow_single + (math.max(0.0, high[1] - high) + math.max(0.0, low[1] - low)) / hiLoRange + (1 - rel_high) + (1 - rel_low)) / 8

flow_sum       = math.sum(pattern_bin_up - pattern_bin_dn, 21) / 5
flow_ema       = ta.ema(flow_sum, 21)
flow_ema_slope = flow_ema - nz(flow_ema[1])

// ─────────────────────────────────────────────
// Module: SwingTrend
// ─────────────────────────────────────────────
periods = 400

var float trend_X = na
trend_X := (X_ema21_close / ta.stdev(X_ema21_close, periods)) + slope_ema21_close +
           (X_ema50_close / ta.stdev(X_ema50_close, periods)) + slope_ema50_close +
           2 * (X_ema200_close / ta.stdev(X_ema200_close, periods)) + 2 * slope_ema200_close +
           (ema21_close - ema50_close) / ta.stdev(ema21_close - ema50_close, periods) +
           (ema50_close - ema200_close) / ta.stdev(ema50_close - ema200_close, periods) +
           0.5 * (tema_close - ema21_close) / ta.stdev(tema_close - ema21_close, periods) +
           0.5 * (tema_close - nz(tema_close[1])) / ta.stdev(tema_close - nz(tema_close[1]), periods) +
           0.5 * (tema_close - ema50_close) / ta.stdev(tema_close - ema50_close, periods) +
           (rsi - rsi_ema) / ta.stdev(rsi - rsi_ema, periods) +
           (rsi_ema - 50) / ta.stdev(rsi_ema, periods) +
           (rsi_ema - nz(rsi_ema[1])) / ta.stdev(rsi_ema - nz(rsi_ema[1]), periods) +
           flow_ema / ta.stdev(flow_ema, periods)

trend_X     := ta.ema(trend_X, 21) / 23
trendMA_X   = ta.ema(trend_X, 21)
trendTEMA_X = tema(trendMA_X, 21)

// ─────────────────────────────────────────────
// Module: SwingScore
// ─────────────────────────────────────────────
var float score_X = na
score_X := 0.5  * (math.abs(2 * rsi - 100) < 40 ? math.sign(2 * rsi - 100) : 0) +
           0.75 * math.sign(rsi_ema - 50) +
           0.75 * math.sign(swing_fastMA) +
           3.0  * swing_fast +
           0.75 * math.sign(tema_close - ema21_close) +
           0.75 * math.sign(flow_ema_slope) +
           0.75 * math.sign(tema_close - nz(tema_close[1])) +
           0.5  * math.sign(trendTEMA_X - trend_X) +
           0.5  * math.sign(trendTEMA_X - trendMA_X) +
           0.5  * math.sign(trendTEMA_X - nz(trendTEMA_X[1])) +
           (X_ema21_close  / ta.stdev(X_ema21_close,  periods)) + 0.5 * slope_ema21_close +
           (X_ema50_close  / ta.stdev(X_ema50_close,  periods)) + slope_ema50_close +
           (X_ema200_close / ta.stdev(X_ema200_close, periods)) + 2.0 * slope_ema200_close

score_X   := ta.ema(score_X, 21) / 15
scoreMA_X  = ta.ema(score_X, 21)

// ─────────────────────────────────────────────
// Module: Slopes
// ─────────────────────────────────────────────
var float slopes = na
slopes := math.sign(rsi_ema - nz(rsi_ema[1])) +
          0.5 * math.sign(flow_ema_slope) +
          0.5 * math.sign(tema_close - nz(tema_close[1])) +
          0.5 * math.sign(Stoch_signal - nz(Stoch_signal[1])) +
          0.5 * math.sign(Stoch_rsi - nz(Stoch_rsi[1])) +
          0.5 * math.sign(slope_ema21_close) +
          0.5 * math.sign(slope_ema50_close) +
          math.sign(score_X - nz(score_X[1])) +
          math.sign(swing_fastMA - nz(swing_fastMA[1])) +
          2.0 * math.sign(close - ema5_close)

// ─────────────────────────────────────────────
// Composite Scores: MT_Score & ST_Score
// ─────────────────────────────────────────────
short_swing = (trend_X   + score_X)   / 2
long_swing  = (trendMA_X + scoreMA_X) / 2

score_X_Z = score_X / (2 * ta.stdev(score_X, periods))
MT_Score  = 2 * f_normCdf(score_X_Z) - 1

slopeMT       = (MT_Score - MT_Score[1]) + (MT_Score - MT_Score[2])
slopeMT_Z     = slopeMT / ta.stdev(slopeMT, periods)
slopeMT_nq    = 2 * f_normCdf(slopeMT_Z) - 1
slopeMT_nq_MA = ta.ema(slopeMT_nq, 5)

slope2MT       = (slopeMT_nq_MA - slopeMT_nq_MA[1]) + (slopeMT_nq_MA - slopeMT_nq_MA[2])
slope2MT_Z     = slope2MT / ta.stdev(slope2MT, periods)
slope2MT_nq    = 2 * f_normCdf(slope2MT_Z) - 1
slope2MT_nq_MA = ta.ema(slope2MT_nq, 5)

ST_Score_raw = slopes / ta.stdev(slopes, periods) +
               trend_X / (2 * ta.stdev(trend_X, periods)) +
               long_swing / (2 * ta.stdev(long_swing, periods)) +
               short_swing / (2 * ta.stdev(short_swing, periods)) +
               swing_fast / (2 * ta.stdev(swing_fast, periods)) +
               swing_fastMA / (2 * ta.stdev(swing_fastMA, periods)) +
               flow_ema_slope / (2 * ta.stdev(flow_ema_slope, periods))

ST_Score_Z = ST_Score_raw / (2 * ta.stdev(ST_Score_raw, periods))
ST_Score   = 2 * f_normCdf(ST_Score_Z) - 1

Mid_Score = (MT_Score + 3 * ST_Score) / 4

// ─────────────────────────────────────────────
// Diff Scores -> composite directional signal used for positioning signals
// ─────────────────────────────────────────────
rsi_Score     = ta.rsi(Mid_Score, rsi_length)
rsi_Score_ema = ta.ema(rsi_Score, rsi_length)
Diff_Score1   = math.sign(rsi_Score_ema - rsi_Score_ema[1])

anchor_Cond1 = ta.crossover(slopeMT, 0)
anchor_Cond2 = ta.crossunder(slopeMT, 0)

var float anchor_value      = na
var float anchored_MT_Score = 0.0
if anchor_Cond1 or anchor_Cond2
    anchor_value      := MT_Score
    anchored_MT_Score := 0.0
else
    anchored_MT_Score := MT_Score - anchor_value

Diff_Score2 = math.sign(anchored_MT_Score) * (math.abs(anchored_MT_Score) > 0.15 ? 1 : 0)

var float Diff_Score3_help = na
var float Diff_Score4_help = na
var float Diff_Score3      = na

Diff_Score3_help := ((MT_Score > MT_Score[1] ? 1 : 0) * (MT_Score[1] > MT_Score[2] ? 1 : 0) * (Mid_Score > Mid_Score[1] ? 1 : 0)) - ((MT_Score < MT_Score[1] ? 1 : 0) * (MT_Score[1] < MT_Score[2] ? 1 : 0) * (Mid_Score < Mid_Score[1] ? 1 : 0))
Diff_Score4_help := (slopeMT > 0 ? 1 : 0) * (slope2MT > 0 ? 1 : 0) - (slopeMT < 0 ? 1 : 0) * (slope2MT < 0 ? 1 : 0)
Diff_Score3      := math.sign(Diff_Score3_help + Diff_Score3_help[1] + Diff_Score3_help[2] + Diff_Score4_help + Diff_Score4_help[1] + Diff_Score4_help[2])

Diff_Score_comp = math.sign(math.sign(Diff_Score1 + Diff_Score1[1]) + math.sign(Diff_Score2 + Diff_Score2[1]) + math.sign(Diff_Score3 + Diff_Score3[1]))

// ─────────────────────────────────────────────
// POS: Long / Flat / Short positioning signal
// ─────────────────────────────────────────────
DL = Diff_Score_comp[1]
DN = Diff_Score_comp
C1 = math.sign(slopeMT)
C2 = math.sign((ST_Score - MT_Score) - (ST_Score[1] - MT_Score[1]))

var float POS = 0.0

float POSa = (DL ==  1 and POS[1] ==  1) ? (DN ==  1 ? 1.0 : (DN == -1 and C1 < 0 and C2 < 0 ? -1.0 : 0.0)) : 0.0
float POSb = (DL == -1 and POS[1] == -1) ? (DN == -1 ? -1.0 : (DN == 1 and C2 > 0 ? 1.0 : 0.0)) : 0.0
float POSc = (DL == -1 and POS[1] ==  0) ? (DN == -1 and C1 < 0 and C2 < 0 ? -1.0 : (DN == 1 and C1 > 0 and C2 > 0 ? 1.0 : 0.0)) : 0.0
float POSd = (DL ==  1 and POS[1] ==  0) ? (DN ==  1 and C1 > 0 and C2 > 0 ? 1.0 : (DN == -1 and C1 < 0 and C2 < 0 ? -1.0 : 0.0)) : 0.0
float POSe = (DL == -1 and POS[1] ==  1) ? (DN == -1 ? (C1 > 0 and C2 > 0 ? 1.0 : (C1 < 0 ? -1.0 : 0.0)) : (DN == 1 ? 1.0 : 0.0)) : 0.0
float POSf = (DL ==  1 and POS[1] == -1) ? (DN ==  1 ? (C1 < 0 and C2 < 0 ? -1.0 : (C1 > 0 ? 1.0 : 0.0)) : (DN == -1 ? -1.0 : 0.0)) : 0.0

POS := POSa + POSb + POSc + POSd + POSe + POSf

// ─────────────────────────────────────────────
// POS2: Positioning score weighted by MT + slope alignment
// ─────────────────────────────────────────────
var float POS2_up = na
POS2_up := (MT_Score > 0 ? 1.0 : 0.0) * (slopeMT_nq_MA > 0 ? 1.0 : 0.0) * (slope2MT_nq_MA > 0 ? 1.0 : 0.0) +
           0.5 * (MT_Score > 0 ? 1.0 : 0.0) * (slopeMT_nq_MA > 0 ? 1.0 : 0.0) * (slope2MT_nq_MA < 0 ? 1.0 : 0.0) +
           0.5 * (MT_Score > 0 ? 1.0 : 0.0) * (slopeMT_nq_MA < 0 ? 1.0 : 0.0) * (slope2MT_nq_MA > 0 ? 1.0 : 0.0) +
           0.2 * (MT_Score > 0 ? 1.0 : 0.0) * (slopeMT_nq_MA < 0 ? 1.0 : 0.0) * (slope2MT_nq_MA < 0 ? 1.0 : 0.0)

var float POS2_dn = na
POS2_dn := (MT_Score < 0 ? 1.0 : 0.0) * (slopeMT_nq_MA < 0 ? 1.0 : 0.0) * (slope2MT_nq_MA < 0 ? 1.0 : 0.0) +
           0.5 * (MT_Score < 0 ? 1.0 : 0.0) * (slopeMT_nq_MA < 0 ? 1.0 : 0.0) * (slope2MT_nq_MA > 0 ? 1.0 : 0.0) +
           0.5 * (MT_Score < 0 ? 1.0 : 0.0) * (slopeMT_nq_MA > 0 ? 1.0 : 0.0) * (slope2MT_nq_MA < 0 ? 1.0 : 0.0) +
           0.2 * (MT_Score < 0 ? 1.0 : 0.0) * (slopeMT_nq_MA > 0 ? 1.0 : 0.0) * (slope2MT_nq_MA > 0 ? 1.0 : 0.0)

POS_cons    = POS2_up - POS2_dn
POS_agg = math.abs(POS) > 0 ? POS : math.sign(POS_cons)

// ─────────────────────────────────────────────
// Plots
// ─────────────────────────────────────────────
plot(MT_Score, "MT_Score", color.new(#f3a006, 0), linewidth=3)
plot(0, "Zero Line", color.white)

hline( 1.5, "Top Line",     color.gray, linestyle=hline.style_solid)
hline( 1.2, "Top Sub Line", color.gray, linestyle=hline.style_solid)
hline(-1.2, "Bot Sup Line", color.gray, linestyle=hline.style_solid)
hline(-1.5, "Bot Line",     color.gray, linestyle=hline.style_solid)

topLine    = hline( 1.5, linestyle=hline.style_solid, color=color.new(color.gray, 100))
topsubLine = hline( 1.2, linestyle=hline.style_solid, color=color.new(color.gray, 100))
botLine    = hline(-1.5, linestyle=hline.style_solid, color=color.new(color.gray, 100))
botsupLine = hline(-1.2, linestyle=hline.style_solid, color=color.new(color.gray, 100))

fill(topLine, topsubLine, color=POS_agg > 0 ? color.new(color.green, 30) : na)
fill(botLine, botsupLine, color=POS_agg < 0 ? color.new(color.red,   30) : na)

transpar = 50
color hColor = POS_cons >  0.5 ? color.new(color.green,  transpar) :
               POS_cons >  0.3 ? color.new(color.yellow, transpar) :
               POS_cons >  0.0 ? color.new(color.red,    transpar) :
               POS_cons > -0.3 ? color.new(color.green,  transpar) :
               POS_cons > -0.6 ? color.new(color.yellow, transpar) :
                              color.new(color.red,    transpar)

plot(math.sign(POS_cons), "POS_cons Histogram", hColor, style=plot.style_columns)
