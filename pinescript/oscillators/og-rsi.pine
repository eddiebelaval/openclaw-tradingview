//@version=6
indicator("OG RSI", shorttitle="OG RSI", overlay=false, precision=2)

// SOURCE
src = input.source(close, "Source")

// LEVEL TOGGLES
showOB  = input.bool(true, "Show 70 (Overbought)")
showMid = input.bool(true, "Show 50 (Midline)")
showOS  = input.bool(true, "Show 30 (Oversold)")

obLevel  = input.int(70, "Overbought Level", minval=1, maxval=100)
midLevel = input.int(50, "Mid Level", minval=1, maxval=100)
osLevel  = input.int(30, "Oversold Level", minval=1, maxval=100)

// RSI SETTINGS
show1 = input.bool(true, "RSI 1")
len1  = input.int(6, "Length 1", minval=1)
col1  = input.color(color.orange, "Color 1")

show2 = input.bool(true, "RSI 2")
len2  = input.int(24, "Length 2", minval=1)
col2  = input.color(color.aqua, "Color 2")

show3 = input.bool(false, "RSI 3")
len3  = input.int(24, "Length 3", minval=1)
col3  = input.color(color.fuchsia, "Color 3")

show4 = input.bool(false, "RSI 4")
len4  = input.int(50, "Length 4", minval=1)
col4  = input.color(color.lime, "Color 4")

show5 = input.bool(false, "RSI 5")
len5  = input.int(100, "Length 5", minval=1)
col5  = input.color(color.yellow, "Color 5")

// CALCULATIONS
r1 = ta.rsi(src, len1)
r2 = ta.rsi(src, len2)
r3 = ta.rsi(src, len3)
r4 = ta.rsi(src, len4)
r5 = ta.rsi(src, len5)

// LEVEL LINES
levelColor = color.new(color.gray, 50)

plot(showOB  ? obLevel  : na, title="70", color=levelColor, linewidth=1)
plot(showMid ? midLevel : na, title="50", color=levelColor, linewidth=1)
plot(showOS  ? osLevel  : na, title="30", color=levelColor, linewidth=1)

// Faint outer bounds
hline(100, "Upper Bound", color=color.new(color.gray, 90))
hline(0, "Lower Bound", color=color.new(color.gray, 90))

// RSI PLOTS
plot(show1 ? r1 : na, title="RSI 1", color=col1, linewidth=2)
plot(show2 ? r2 : na, title="RSI 2", color=col2, linewidth=2)
plot(show3 ? r3 : na, title="RSI 3", color=col3, linewidth=2)
plot(show4 ? r4 : na, title="RSI 4", color=col4, linewidth=2)
plot(show5 ? r5 : na, title="RSI 5", color=col5, linewidth=2)
