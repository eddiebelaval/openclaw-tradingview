//@version=6
indicator('VCO Fusion', overlay = false, max_bars_back = 500)


// SECTION 1 – CHANNEL / OSCILLATOR SETTINGS

length = input.int(10, 'Volatility Window', minval = 1, group = 'Channel / Oscillator')
scale = input.float(200, 'Band Scaling (%)', minval = 100, step = 5, group = 'Channel / Oscillator')
overbought = input.float(25, 'Overbought Level', step = 0.1, group = 'Channel / Oscillator')
oversold = input.float(-25, 'Oversold Level', step = 0.1, group = 'Channel / Oscillator')


// SECTION 2 – MAIN LINES (MA1 and MA2)

smoothLen1 = input.int(7, 'Smoothing 1 (EMA)', minval = 1, group = 'MA1 / MA2')
maLen1 = input.int(5, 'MA 1 Length (SMA)', minval = 1, group = 'MA1 / MA2')
smoothLen2 = input.int(10, 'Smoothing 2 (EMA)', minval = 1, group = 'MA1 / MA2')
maLen2 = input.int(5, 'MA 2 Length (SMA)', minval = 1, group = 'MA1 / MA2')


// Range Filters for Signals
group_signals = 'SIGNALS'

bull_circle_upper = input.float(20, 'Bull Signal – Upper Filter Level', step = 0.5, group = group_signals)
bull_circle_lower = input.float(1, 'Bull Signal – Lower Filter Level', step = 0.5, group = group_signals)

bear_circle_upper = input.float(-1, 'Bear Signal – Upper Filter Level', step = 0.5, group = group_signals)
bear_circle_lower = input.float(-20, 'Bear Signal – Lower Filter Level', step = 0.5, group = group_signals)

hist_peak_upper = input.float(3, 'Histogram Peak Down Level (diamonds)', step = 0.5, group = group_signals)
hist_peak_lower = input.float(-3, 'Histogram Peak Up Level (diamonds)', step = 0.5, group = group_signals)

// Offset
float triangleOffset = 6.0
float circleOffset = 2.0


// SECTION 3 – DIVERGENCES   

showDivergence = input.bool(true, 'Show Divergences on MA1', group = 'Divergences')
pivotLength = input.int(2, 'Pivot Lookback (left/right)', minval = 1, group = 'Divergences')


// SECTION 4 – COLORS + DYNAMIC LEVELS

colBullMain = input.color(color.rgb(6, 162, 47), 'Bull Color (MA lines / hist / gradient / labels)', group = 'Colors')
colBearMain = input.color(color.rgb(207, 23, 23), 'Bear Color (MA lines / hist / gradient / labels)', group = 'Colors')

bullDivColor = input.color(color.rgb(6, 162, 47), 'Bullish Divergence', group = 'Colors')
bearDivColor = input.color(color.rgb(207, 23, 23), 'Bearish Divergence', group = 'Colors')
divTextColor = input.color(color.white, 'Divergence Text', group = 'Colors')

colOB = input.color(color.rgb(207, 23, 23), 'Overbought Color', group = 'Colors')
colOS = input.color(color.rgb(6, 162, 47), 'Oversold Color', group = 'Colors')

useDynamicLevels = input.bool(true, 'OB/OS Lines', group = 'Colors')
minTransp = input.int(85, 'Min. Transparency (weak signal)', minval = 0, maxval = 100, group = 'Colors')
maxTransp = input.int(10, 'Max. Transparency (strong signal)', minval = 0, maxval = 100, group = 'Colors')

levelLineWidth = input.int(4, 'OB/OS Line Thickness', minval = 1, maxval = 6, group = 'Colors')


// CONSTANTS 

const_ma1_peak_transp = 55
const_mas_gradient_transp = 30
const_use_ma1_gradient = true
const_use_mas_gradient = true


// CALCULATIONS

candleMid = (high + low) / 2
midSma = ta.sma(candleMid, length)
avgRange = ta.sma(high - low, length)
avgBody = ta.sma(math.abs(close - open), length)

offset = avgRange * scale / 100 * (1 + avgBody / math.max(avgRange, 1e-10))
upperBand = midSma + offset
lowerBand = midSma - offset

bandWidth = math.max(upperBand - lowerBand, 1e-10)
rawBaseOsc = 100 * (close - lowerBand) / bandWidth - 50
oscValue = math.max(math.min(rawBaseOsc, 100), -100)

oscSmooth1 = ta.ema(oscValue, smoothLen1)
ma1 = ta.sma(oscSmooth1, maLen1)
oscSmooth2 = ta.ema(oscValue, smoothLen2)
ma2 = ta.sma(oscSmooth2, maLen2)

hist = ma1 - ma2

histTurnDown = hist < hist[1] and hist[1] > hist[2] and hist[1] > hist_peak_upper
histTurnUp = hist > hist[1] and hist[1] < hist[2] and hist[1] < hist_peak_lower

crossUp = ta.crossover(ma1, ma2)
crossDown = ta.crossunder(ma1, ma2)

var bool trendUp = true
if crossUp
    trendUp := true
    trendUp
if crossDown
    trendUp := false
    trendUp

longSignal = ta.crossover(ma1, oversold)
shortSignal = ta.crossunder(ma1, overbought)

// Range Filter for Circles Only
bool bullCrossSignal = crossUp and ma1 >= bull_circle_lower and ma1 <= bull_circle_upper
bool bearCrossSignal = crossDown and ma1 >= bear_circle_lower and ma1 <= bear_circle_upper


// DIVERGENCES 

lookbackRight = pivotLength
lookbackLeft = pivotLength

pivotHighMA1 = ta.pivothigh(ma1, lookbackLeft, lookbackRight)
pivotLowMA1 = ta.pivotlow(ma1, lookbackLeft, lookbackRight)

var bool plFound = false
var bool phFound = false
var bool bullCond = false
var bool bearCond = false

ma1_at_pivot = ma1[lookbackRight]

if showDivergence
    plFound := not na(pivotLowMA1)
    oscHigherLow = ma1_at_pivot > ta.valuewhen(plFound, ma1_at_pivot, 1)
    priceLowerLow = low[lookbackRight] < ta.valuewhen(plFound, low[lookbackRight], 1)
    bullCond := priceLowerLow and oscHigherLow and plFound

    phFound := not na(pivotHighMA1)
    oscLowerHigh = ma1_at_pivot < ta.valuewhen(phFound, ma1_at_pivot, 1)
    priceHigherHigh = high[lookbackRight] > ta.valuewhen(phFound, high[lookbackRight], 1)
    bearCond := priceHigherHigh and oscLowerHigh and phFound
    bearCond


// DYNAMIC OB/OS COLORS 

remap(val, inMin, inMax, outMin, outMax) =>
    outMin + (val - inMin) * (outMax - outMin) / (inMax - inMin)

getDynamicOBColor() =>
    if not useDynamicLevels
        colOB
    else
        rawDist = overbought - ma1
        clamped = math.max(0, math.min(rawDist, overbought))
        transp = math.round(remap(clamped, 0, overbought, maxTransp, minTransp))
        color.new(colOB, transp)

getDynamicOSColor() =>
    if not useDynamicLevels
        colOS
    else
        rawDist = ma1 - oversold
        clamped = math.max(0, math.min(rawDist, -oversold))
        transp = math.round(remap(clamped, 0, -oversold, maxTransp, minTransp))
        color.new(colOS, transp)


// GRADIENT COLORS 

c_bull_peak = color.new(colBullMain, const_ma1_peak_transp)
c_bear_peak = color.new(colBearMain, const_ma1_peak_transp)
c_bull_zero = color.new(colBullMain, 100)
c_bear_zero = color.new(colBearMain, 100)

mas_grad_col = color.new(trendUp ? colBullMain : colBearMain, const_mas_gradient_transp)


// DRAWING 

hline(0, 'Zero', color = color.gray, linestyle = hline.style_dashed)

plot(useDynamicLevels ? overbought : na, 'Overbought', color = getDynamicOBColor(), linewidth = math.max(1, math.max(1, levelLineWidth)))
plot(useDynamicLevels ? oversold : na, 'Oversold', color = getDynamicOSColor(), linewidth = math.max(1, math.max(1, levelLineWidth)))

plot(ma1, 'MA 1', color = trendUp ? colBullMain : colBearMain, linewidth = 2)
plot(ma2, 'MA 2', color = trendUp ? colBullMain : colBearMain, linewidth = 2)

pMA1 = plot(ma1, color = na, display = display.none)
pMA2 = plot(ma2, color = na, display = display.none)
pZero = plot(0, color = na, display = display.none)

// Gradient MA1 → Zero
fill(pMA1, pZero, top_value = const_use_ma1_gradient and ma1 > 0 ? ma1 : na, bottom_value = const_use_ma1_gradient and ma1 > 0 ? 0 : na, top_color = const_use_ma1_gradient and ma1 > 0 ? c_bull_peak : na, bottom_color = const_use_ma1_gradient and ma1 > 0 ? c_bull_zero : na)

fill(pZero, pMA1, top_value = const_use_ma1_gradient and ma1 < 0 ? 0 : na, bottom_value = const_use_ma1_gradient and ma1 < 0 ? ma1 : na, top_color = const_use_ma1_gradient and ma1 < 0 ? c_bear_zero : na, bottom_color = const_use_ma1_gradient and ma1 < 0 ? c_bear_peak : na)

// Gradient MA1–MA2
fill(pMA1, pMA2, color = const_use_mas_gradient ? mas_grad_col : na)

// Histogram
plot(hist, 'Histogram MA1-MA2', style = plot.style_area, color = hist >= 0 ? color.new(colBullMain, 60) : color.new(colBearMain, 60))

// Diamond – Wave Turn
plotshape(histTurnDown ? hist : na, title = 'Histogram Peak Down', style = shape.diamond, location = location.absolute, size = size.tiny, color = colBearMain)
plotshape(histTurnUp ? hist : na, title = 'Histogram Peak Up', style = shape.diamond, location = location.absolute, size = size.tiny, color = colBullMain)

// Triangle Signals
plotshape(longSignal ? oversold - triangleOffset : na, title = 'Long', style = shape.triangleup, size = size.tiny, color = colBullMain, location = location.absolute)
plotshape(shortSignal ? overbought + triangleOffset : na, title = 'Short', style = shape.triangledown, size = size.tiny, color = colBearMain, location = location.absolute)

// Circle Signals – Range-Based
plotshape(bullCrossSignal ? oversold - circleOffset : na, title = 'Bull Cross', style = shape.circle, size = size.tiny, color = colBullMain, location = location.absolute)
plotshape(bearCrossSignal ? overbought + circleOffset : na, title = 'Bear Cross', style = shape.circle, size = size.tiny, color = colBearMain, location = location.absolute)

// Divergences 
plot(showDivergence and plFound ? ma1_at_pivot : na, offset = -lookbackRight, title = 'Bull Div point', color = bullCond ? bullDivColor : color.new(color.white, 100), linewidth = 2)
plot(showDivergence and phFound ? ma1_at_pivot : na, offset = -lookbackRight, title = 'Bear Div point', color = bearCond ? bearDivColor : color.new(color.white, 100), linewidth = 2)

plotshape(showDivergence and bullCond ? ma1_at_pivot : na, offset = -lookbackRight, title = 'Bull Div', text = 'Bull Div', style = shape.labelup, location = location.absolute, color = color.new(bullDivColor, 40), textcolor = divTextColor, size = size.tiny)
plotshape(showDivergence and bearCond ? ma1_at_pivot : na, offset = -lookbackRight, title = 'Bear Div', text = 'Bear Div', style = shape.labeldown, location = location.absolute, color = color.new(bearDivColor, 40), textcolor = divTextColor, size = size.tiny)


// ALERTS


// Basic Signals
alertcondition(longSignal, title = "Long Signal", message = "VCO Long Signal – MA1 crossed above Oversold")
alertcondition(shortSignal, title = "Short Signal", message = "VCO Short Signal – MA1 crossed below Overbought")

// MA1 / MA2 Cross (Range-Based)
alertcondition(bullCrossSignal, title = "Bull Cross (Range Filter)", message = "VCO Bull Cross – MA1 crossed above MA2 in bull range")
alertcondition(bearCrossSignal, title = "Bear Cross (Range Filter)", message = "VCO Bear Cross – MA1 crossed below MA2 in bear range")

// Histogram Turn
alertcondition(histTurnUp, title = "Histogram Peak Up", message = "VCO Histogram turned UP (bullish wave turn)")
alertcondition(histTurnDown, title = "Histogram Peak Down", message = "VCO Histogram turned DOWN (bearish wave turn)")

// Divergences
alertcondition(showDivergence and bullCond, title = "Bullish Divergence", message = "VCO Bullish Divergence detected on MA1")
alertcondition(showDivergence and bearCond, title = "Bearish Divergence", message = "VCO Bearish Divergence detected on MA1")
