// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("Order Flow Divergence Oscillator", shorttitle="OFDO", overlay=false)

// --- Settings ---
int lengthInput = input.int(14, "Oscillator Period", minval=1, tooltip="Smoothing period for the Volume Delta oscillator.")
int lookbackInput = input.int(5, "Divergence Lookback", minval=2, tooltip="Lookback period for finding local peaks and troughs.")
color bullColor = input.color(#089981, "Bullish Color", group="Style")
color bearColor = input.color(#f23645, "Bearish Color", group="Style")

// --- Calculations ---
// Approximate Volume Delta (Order Flow approximation)
// If close > open, we assume buying pressure; if close < open, selling pressure.
float volumeDelta = (close > open ? volume : close < open ? -volume : 0)
float oscillator = ta.ema(volumeDelta, lengthInput)

// --- Divergence Logic ---
// Function to find pivots
float priceHigh = ta.highest(high, lookbackInput)
float priceLow = ta.lowest(low, lookbackInput)
float oscHigh = ta.highest(oscillator, lookbackInput)
float oscLow = ta.lowest(oscillator, lookbackInput)

bool isHigh = oscillator[lookbackInput] == ta.highest(oscillator, lookbackInput * 2 + 1)
bool isLow = oscillator[lookbackInput] == ta.lowest(oscillator, lookbackInput * 2 + 1)

// Values at pivot points
var float topPrice = na
var float topOsc = na
var float botPrice = na
var float botOsc = na

if isHigh
    topPrice := high[lookbackInput]
    topOsc := oscillator[lookbackInput]

if isLow
    botPrice := low[lookbackInput]
    botOsc := oscillator[lookbackInput]

// Regular Divergence detection
bool bullDiv = isLow and low[lookbackInput] < botPrice[1] and oscillator[lookbackInput] > botOsc[1]
bool bearDiv = isHigh and high[lookbackInput] > topPrice[1] and oscillator[lookbackInput] < topOsc[1]

// --- Visuals ---
// Zero line
hline(0, "Zero Line", color.gray, linestyle=hline.style_dashed)

// Oscillator Plot
oscColor = oscillator > 0 ? bullColor : bearColor
oscPlot = plot(oscillator, "Oscillator", color=oscColor, linewidth=2)
zeroPlot = plot(0, "Zero Reference", color=color.new(chart.fg_color, 100), display=display.none)

// Centered Gradient Fill
// IndicatorTypeStyleGuideline: Vertical gradient from center to oscillator
fill(oscPlot, zeroPlot, 
     top_value = math.max(0, oscillator), 
     bottom_value = math.min(0, oscillator), 
     top_color = oscillator > 0 ? color.new(bullColor, 50) : color.new(chart.bg_color, 100), 
     bottom_color = oscillator > 0 ? color.new(chart.bg_color, 100) : color.new(bearColor, 50),
     title = "Oscillator Gradient")

// Signals
plotshape(bullDiv ? oscillator[lookbackInput] : na, "Bullish Divergence", shape.labelup, location.absolute, bullColor, -lookbackInput, "BUY", chart.fg_color, size=size.small)
plotshape(bearDiv ? oscillator[lookbackInput] : na, "Bearish Divergence", shape.labeldown, location.absolute, bearColor, -lookbackInput, "SELL", chart.fg_color, size=size.small)

// Alerts
alertcondition(bullDiv, "Bullish Divergence", "Order Flow Bullish Divergence detected")
alertcondition(bearDiv, "Bearish Divergence", "Order Flow Bearish Divergence detected")
