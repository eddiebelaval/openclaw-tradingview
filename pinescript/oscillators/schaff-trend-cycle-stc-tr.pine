//@version=6
//                              ████████╗ ████████╗  ████████╗  ███████╗   ██████╗        ██████╗   ██████╗   ██████╗ ██╗   ██╗ ████████╗
//                              ╚══██╔══╝ ╚══██╔══╝  ██╔═══██║  ██╔════╝  ██╔═══██╗       ██╔══██╗ ██╔═══██╗ ██╔════╝ ██║   ██║ ██╔═══██║
//                                 ██║       ██║     ████████║  ██║ ███║  ██║   ██║       ██████╔╝ ██║   ██║ ██║      ████████║ ████████║
//                                 ██║       ██║     ██╔═══██║  ██║  ██║  ██║   ██║       ██╔══██╗ ██║   ██║ ██║      ██║   ██║ ██╔═══██║
//                                 ██║    ████████╗  ██║   ██║  ███████║  ╚██████╔╝       ██║  ██║ ╚██████╔╝ ╚██████╗ ██║   ██║ ██║   ██║
indicator('Schaff Trend Cycle - STC | TR', shorttitle='STC | TR →', overlay=false)
import TradingView/ta/12
//╔═════════════════╗
//║     Input's     ║
//╚═════════════════╝
Color_Mode =    input.string('Classic', '🎨 Color Choice', group = 'Color', options = ['Classic', 'Modern', 'Robust', 'Accented', 'Monochrome', 'Moderate', 'Aqua', 'Cosmic'])
fastLen =       input.int(12, 'Fast Length', group='⚙️ STC Parameters')
slowLen =       input.int(26, 'Slow Length', group='⚙️ STC Parameters')
cycleLen =      input.int(28, 'Cycle Length', group='⚙️ STC Parameters')
smooth1Len =    input.int(3, '1st Smoothing Length', group='⚙️ STC Parameters')
smooth2Len =    input.int(3, '2nd Smoothing Length', group='⚙️ STC Parameters')
Upper_Band =    input.int(75, 'Overbought Level', minval = 20, maxval = 100, group='⚙️ STC Parameters')
Lower_Band =    input.int(25, 'Oversold Level', minval = 0, maxval = 80, group='⚙️ STC Parameters')
MA_Type =       input.string('EMA', 'Moving Average', group='📊 Moving Average', inline = 'MA', options=['EMA', 'SMA', 'RMA', 'WMA', 'VWMA', 'HMA', 'DEMA', 'TEMA', 'TRIMA', 'FRAMA', 'SWMA', 'T3'])
MA_Source =     input(close, ' ', group='📊 Moving Average', inline = 'MA')
factor =        input.float(0.7, 'T3 Factor', minval=0, maxval=1, step=0.05, group='📊 Moving Average', tooltip = 'For Moving Average = T3')
//╔══════════════════════════════════╗
//║     MOVING AVERAGE ENGINE        ║
//╚══════════════════════════════════╝
ma(source, length, factor, type) =>
     type == 'EMA'   ? ta.ema(source, length) :
     type == 'SMA'   ? ta.sma(source, length) :
     type == 'RMA'   ? ta.rma(source, length) :
     type == 'WMA'   ? ta.wma(source, length) :
     type == 'VWMA'  ? ta.vwma(source, length) :
     type == 'HMA'   ? ta.hma(source, length) :
     type == 'DEMA'  ? ta.dema(source, length) :
     type == 'TEMA'  ? ta.tema(source, length) :
     type == 'TRIMA' ? ta.trima(source, length) :
     type == 'FRAMA' ? ta.frama(source, length) :
     type == 'SWMA'  ? ta.swma(source) :
     type == 'T3'    ? ta.t3(source, length, factor) :
     na
//╔═════════════════╗
//║     Color       ║
//╚═════════════════╝
[UpC, DnC] = switch Color_Mode
    'Classic' =>    [#008800, #ff0000]
    'Modern' =>     [#ffffff, #b721ff]
    'Robust' =>     [#ffbb00, #770737]
    'Accented' =>   [#8c5cf7, #e83e8c]
    'Monochrome' => [#e9ecef, #495057]
    'Moderate' =>   [#43a047, #e53935]
    'Aqua' =>       [#00a8e8, #f18f01]
    'Cosmic' =>     [#e83e8c, #6f2da8]
//╔═════════════════════════╗
//║     Calculations        ║
//╚═════════════════════════╝
Line = ma(MA_Source, fastLen,factor, MA_Type) - ma(MA_Source, slowLen,factor, MA_Type)
float k1 = ta.stoch(Line, Line, Line, cycleLen)
float d1 = ma(k1, smooth1Len,factor, MA_Type)
float k2 = ta.stoch(d1, d1, d1, cycleLen)
float STC = ma(k2, smooth2Len,factor, MA_Type)
STC := math.max(math.min(STC, 100), 0)
isBull_STC   = STC > Upper_Band
isBear_STC   = STC < Lower_Band
isNeutral = not (isBull_STC or isBear_STC)
Bull_STC = ta.crossover(STC, Upper_Band)
Bear_STC = ta.crossunder(STC, Lower_Band)
var string lastSignal = na
plotBull = Bull_STC and (na(lastSignal) or lastSignal != 'Bull')
plotBear = Bear_STC and (na(lastSignal) or lastSignal != 'Bear')
if plotBull
    lastSignal := 'Bull'
if plotBear
    lastSignal := 'Bear'
//╔═════════════════╗
//║     VIEW        ║
//╚═════════════════╝
var table Table_STC = table.new(position.middle_right, 1, 1, border_width = 1)
var label STCLabel = na
if barstate.islast
    table.cell(Table_STC, 0, 0, text = isBull_STC ? '⬆️ Bullish' : '⬇️ Bearish', text_color = isBull_STC ? UpC : DnC, text_size = size.huge)
    if not na(STCLabel)
        label.delete(STCLabel)
    STCLabel := label.new(bar_index + 5, STC, text = str.tostring(STC, '#.##'), color = STC > Upper_Band ? color.new(UpC, 20) : STC < Lower_Band ? color.new(DnC, 20) : color.gray, style = label.style_label_left, size = size.large, textcolor = #000000)
//╔═════════════════╗
//║     Plot's      ║
//╚═════════════════╝
STC_Plot =      plot(STC, color = STC > Upper_Band ? color.new(UpC, 20) : STC < Lower_Band ? color.new(DnC, 20) : color.gray, linewidth = 2, display = display.pane)
Upper_Plot =    plot(Upper_Band, 'Upper Threshold', color.new(UpC, 30), display = display.pane)
Lower_Plot =    plot(Lower_Band, 'Lower Threshold', color.new(DnC, 30), display = display.pane)
midLinePlot =   plot(50, color = color.new(color.white,100), display = display.pane)
fill(plot(Lower_Band), plot(Upper_Band), color=color.new(color.gray, 90), title='Background')
fill(STC_Plot, Upper_Plot, 100, Upper_Band, top_color = color.new(UpC, 0), bottom_color = color.new(UpC, 100), title = 'Overbought Fill')
fill(STC_Plot, Lower_Plot, Lower_Band, 0, top_color = color.new(DnC, 100), bottom_color = color.new(DnC, 0), title = 'Oversold Fill')
fill(STC_Plot, midLinePlot, STC > Upper_Band ? STC : (STC < Lower_Band ? STC : Lower_Band), STC > Upper_Band ? Upper_Band : (STC < Lower_Band ? Lower_Band : STC), STC > Upper_Band ? color.new(UpC, 50) : (STC < Lower_Band ? color.new(DnC, 50) : #00000000), STC > Upper_Band ? #00000000 : (STC < Lower_Band ? #00000000 : #00000000),title = 'Dynamic Fill')
plotcandle(open, high, low, close, 'Bar Color', isBull_STC ? UpC : isBear_STC ? DnC : color.gray, isBull_STC ? UpC : isBear_STC ? DnC : color.gray, bordercolor = isBull_STC ? UpC : isBear_STC ? DnC : color.gray, force_overlay = true)
plotshape(plotBull ? 1 : na, 'LONG', shape.triangleup, location.belowbar, UpC, 0, size = size.small, force_overlay = true)
plotshape(plotBear ? 1 : na, 'SHORT', shape.triangledown, location.abovebar, DnC, 0, size = size.small, force_overlay = true)
bgcolor(lastSignal == 'Bull' ? color.new(UpC, 95) : lastSignal == 'Bear' ? color.new(DnC, 95) : na, title='Zone Background', force_overlay = true)
