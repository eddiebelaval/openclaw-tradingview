//@version=6
indicator("Wasti's RSI Divergence Score", shorttitle="Wasti's RSI", overlay=false, max_labels_count=500)

//-----------------------------------------------------
// Inputs
//-----------------------------------------------------
rsiLen         = input.int(14, "RSI Length", minval=2)
slopeLen       = input.int(14, "Divergence Window", minval=3)
atrLen         = input.int(14, "ATR Length", minval=2)
scoreSmoothLen = input.int(5, "Score Smoothing", minval=1)
beta           = input.float(1.0, "Price Weight β", step=0.1)
scoreScale     = input.float(1.5, "Score Sensitivity", step=0.1)

pivotLeft      = input.int(5, "Pivot Left", minval=1)
pivotRight     = input.int(5, "Pivot Right", minval=1)
minScoreBull   = input.float(20.0, "Min Bull Score", step=1.0)
maxScoreBear   = input.float(-20.0, "Max Bear Score", step=1.0)

showSignals    = input.bool(true, "Show Bull/Bear Labels")
showScore      = input.bool(true, "Show Divergence Score")
showScoreBg    = input.bool(true, "Color Background by Score")
showMidline    = input.bool(true, "Show RSI Midline 50")

//-----------------------------------------------------
// Missing in Pine: custom tanh
//-----------------------------------------------------
tanh_custom(x) =>
    ex = math.exp(x)
    enx = math.exp(-x)
    (ex - enx) / (ex + enx)

//-----------------------------------------------------
// RSI base
//-----------------------------------------------------
rsi = ta.rsi(close, rsiLen)

//-----------------------------------------------------
// Divergence score
//-----------------------------------------------------
atr = ta.atr(atrLen)
rsiStd = ta.stdev(rsi, slopeLen)

safeAtr = math.max(atr, syminfo.mintick)
safeRsiStd = math.max(rsiStd, 0.0001)

priceRegNow  = ta.linreg(close, slopeLen, 0)
priceRegPrev = ta.linreg(close, slopeLen, 1)
priceSlope   = priceRegNow - priceRegPrev

rsiRegNow    = ta.linreg(rsi, slopeLen, 0)
rsiRegPrev   = ta.linreg(rsi, slopeLen, 1)
rsiSlope     = rsiRegNow - rsiRegPrev

priceSlopeNorm = priceSlope / safeAtr
rsiSlopeNorm   = rsiSlope / safeRsiStd
rawScore       = rsiSlopeNorm - beta * priceSlopeNorm
score          = 100.0 * tanh_custom(rawScore / scoreScale)
scoreSmoothed  = ta.ema(score, scoreSmoothLen)

//-----------------------------------------------------
// RSI pivots
//-----------------------------------------------------
rsiPivotLow  = ta.pivotlow(rsi, pivotLeft, pivotRight)
rsiPivotHigh = ta.pivothigh(rsi, pivotLeft, pivotRight)

priceAtPivotLow  = low[pivotRight]
priceAtPivotHigh = high[pivotRight]
rsiAtPivotLow    = rsi[pivotRight]
rsiAtPivotHigh   = rsi[pivotRight]
scoreAtPivot     = scoreSmoothed[pivotRight]

//-----------------------------------------------------
// Store previous pivots
//-----------------------------------------------------
var float prevPriceLow  = na
var float prevRsiLow    = na
var float prevScoreLow  = na
var int   prevLowBar    = na

var float prevPriceHigh = na
var float prevRsiHigh   = na
var float prevScoreHigh = na
var int   prevHighBar   = na

bullSignal = false
bearSignal = false

//-----------------------------------------------------
// Bullish setup: classical RSI divergence + positive score filter
//-----------------------------------------------------
if not na(rsiPivotLow)
    if not na(prevPriceLow) and not na(prevRsiLow)
        bullClassical = priceAtPivotLow < prevPriceLow and rsiAtPivotLow > prevRsiLow
        bullScoreOk   = scoreAtPivot >= minScoreBull
        bullSignal    := bullClassical and bullScoreOk

        if bullSignal and showSignals
            label.new(bar_index[pivotRight], rsiAtPivotLow, "Bull", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)

    prevPriceLow := priceAtPivotLow
    prevRsiLow   := rsiAtPivotLow
    prevScoreLow := scoreAtPivot
    prevLowBar   := bar_index[pivotRight]

//-----------------------------------------------------
// Bearish setup: classical RSI divergence + negative score filter
//-----------------------------------------------------
if not na(rsiPivotHigh)
    if not na(prevPriceHigh) and not na(prevRsiHigh)
        bearClassical = priceAtPivotHigh > prevPriceHigh and rsiAtPivotHigh < prevRsiHigh
        bearScoreOk   = scoreAtPivot <= maxScoreBear
        bearSignal    := bearClassical and bearScoreOk

        if bearSignal and showSignals
            label.new(bar_index[pivotRight], rsiAtPivotHigh, "Bear", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

    prevPriceHigh := priceAtPivotHigh
    prevRsiHigh   := rsiAtPivotHigh
    prevScoreHigh := scoreAtPivot
    prevHighBar   := bar_index[pivotRight]

//-----------------------------------------------------
// Plot RSI like normal RSI indicator
//-----------------------------------------------------
plot(rsi, "RSI", color=color.blue, linewidth=2)
hline(70, "Overbought", color=color.new(color.gray, 50))
hline(30, "Oversold", color=color.new(color.gray, 50))
hline(50, "Midline", color=showMidline ? color.new(color.gray, 75) : color.new(color.gray, 100))

//-----------------------------------------------------
// Optional score overlay in same pane
//-----------------------------------------------------
scoreCenter = 50.0
scoreVisualGain = input.float(1.00, "Score Visual Gain", step=0.05)
scoreHist = scoreSmoothed * scoreVisualGain
scoreTop = scoreCenter + math.max(scoreHist, 0)
scoreBot = scoreCenter + math.min(scoreHist, 0)

plot(showScore ? scoreCenter : na, "Score Center", color=color.new(color.gray, 85), linewidth=1)
plot(showScore ? scoreTop : na, "Score Top", color=color.new(color.green, 100), display=display.none)
plot(showScore ? scoreBot : na, "Score Bottom", color=color.new(color.red, 100), display=display.none)
fill(plot(showScore ? scoreCenter : na, "Score Base Fill", color=color.new(color.gray, 100), display=display.none), plot(showScore ? scoreTop : na, "Bull Fill", color=color.new(color.green, 100), display=display.none), color=color.new(color.lime, 70), title="Bull Score Fill")
fill(plot(showScore ? scoreCenter : na, "Score Base Fill 2", color=color.new(color.gray, 100), display=display.none), plot(showScore ? scoreBot : na, "Bear Fill", color=color.new(color.red, 100), display=display.none), color=color.new(color.red, 70), title="Bear Score Fill")

bgcolor(showScoreBg and scoreSmoothed >= minScoreBull ? color.new(color.green, 90) : na)
bgcolor(showScoreBg and scoreSmoothed <= maxScoreBear ? color.new(color.red, 90) : na)

//-----------------------------------------------------
// Alerts
//-----------------------------------------------------
alertcondition(bullSignal, "Bullish RSI Divergence", "Bullish RSI divergence with positive momentum score")
alertcondition(bearSignal, "Bearish RSI Divergence", "Bearish RSI divergence with negative momentum score")

//-----------------------------------------------------
// Debug values in Data Window
//-----------------------------------------------------
plot(scoreSmoothed, "ScoreRawWindow", color=color.new(color.orange, 100), display=display.data_window)
plot(priceSlopeNorm, "PriceSlopeNorm", color=color.new(color.orange, 100), display=display.data_window)
plot(rsiSlopeNorm, "RSISlopeNorm", color=color.new(color.purple, 100), display=display.data_window)
plot(rawScore, "RawDivergence", color=color.new(color.teal, 100), display=display.data_window)
