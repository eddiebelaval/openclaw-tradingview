//@version=6
indicator("MACD ADVANCED")
tf=input.timeframe('','MTF CROSSOVER', group='EMA Crossover')
m200l=input.int(200,'EMA Slow', group='EMA Crossover')
lb=input.int(50,'EMA FAST', group='EMA Crossover')
ma200=request.security(syminfo.tickerid,tf,ta.ema(close,m200l))
ma201=request.security(syminfo.tickerid,tf,ta.ema(close[lb],m200l))
r=(ma200/ma201)
//plot((r-1), style = plot.style_area)
src=input.source(close,"Source", group="MACD")
f1=input.int(12,"Fast Length", group="MACD")
f2=input.int(26,"Slow Length", group="MACD")
si=input.int(9,"Signal Length", group="MACD")
[macd,signal,hist]=ta.macd(src,f1,f2,si)
macd:=macd+(r-1)
g1=plot(macd+hist,  style=plot.style_area, display=display.none)
g2=plot(macd, color=macd>0?#0163045e:#fd131359, linewidth=1, style=plot.style_columns)
fill(g1,g2,color=hist>0?#51ff00e5:#f50303)
upc=ta.crossover(hist,0)
dnc=ta.crossunder(hist,0)
tup=ta.crossover(macd,0)
tdn=ta.crossunder(macd,0)
//plot(signal)
alertcondition(upc or dnc,"MACD Up/Dn Alert", "MACD UP/DN Alert")
alertcondition(tup or tdn, "Trend Up/Dn Alert", "Trend Up/Dn Alert")
alertcondition(upc or dnc or tup or tdn, "MACD/Trend Up/Dn Alert", "MACD/Trend Up/Dn Alert")
