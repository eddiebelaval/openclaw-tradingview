//@version=6
indicator("MACD MetaTrader Style", shorttitle="MACD MetaTrader", timeframe="", timeframe_gaps=true)

// Inputs
sourceInput  = input.source(close, "Source")
fastLenInput = input.int(12, "Fast EMA Period", minval=1)
slowLenInput = input.int(26, "Slow EMA Period", minval=1)
sigLenInput  = input.int(9, "Signal SMA Period", minval=1)

// MT5 calculation
fastEMA = ta.ema(sourceInput, fastLenInput)
slowEMA = ta.ema(sourceInput, slowLenInput)
macd    = fastEMA - slowEMA
signal  = ta.sma(macd, sigLenInput)

// Zero line
hline(0, "Zero", color=color.new(color.gray, 50))

// MT5-style plots
plot(macd, title="MACD", color=color.silver, style=plot.style_histogram, linewidth=2)
plot(signal, title="Signal", color=color.red, linewidth=1)
