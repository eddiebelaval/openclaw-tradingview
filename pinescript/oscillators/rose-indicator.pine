//@version=6
indicator("ATR Top Right BIG (MTF)", overlay=true)

// Inputs
len       = input.int(14, "Length", minval=1)
smooth    = input.string("RMA", "Smoothing", options=["SMA","EMA","RMA","WMA"])
tf        = input.timeframe("10", "Timeframe")
waitClose = input.bool(true, "Wait for timeframe closes")

// MA helper (no ternary chains)
f_ma(src, length, maType) =>
    float out = na
    if maType == "SMA"
        out := ta.sma(src, length)
    else if maType == "EMA"
        out := ta.ema(src, length)
    else if maType == "RMA"
        out := ta.rma(src, length)
    else
        out := ta.wma(src, length)
    out

// ATR calc: smooth True Range
f_atr(length, maType) =>
    float tr = ta.tr(true)
    float atr = f_ma(tr, length, maType)
    atr

// MTF ATR (single line)
atrValue = request.security(syminfo.tickerid, tf, f_atr(len, smooth), gaps=barmerge.gaps_off, lookahead=waitClose ? barmerge.lookahead_off : barmerge.lookahead_on)

// Display (top-right, "5x" by stacking 5 rows)
txt = "ATR (" + tf + "): " + str.tostring(atrValue, format.mintick)
var table t = table.new(position.top_right, 1, 5)

if barstate.islast
    table.cell(t, 0, 0, txt, text_color=color.orange, text_size=size.large)
