//@version=6
indicator("Symmetry Reversal Oscillator", overlay=false)

// INPUTS 
swingLen   = input.int(14,  "Swing Length",          minval=5)
atrLen     = input.int(20,  "ATR Length")
maxSmooth  = input.int(15,  "Max EMA Length for Adaptive", minval=1)
minSmooth  = input.int(5,   "Min EMA Length for Adaptive", minval=1)
volFactor  = input.float(0.5, "Volatility Sensitivity", step=0.1)

// OVERBOUGHT / OVERSOLD LEVELS 
OB = input.int(60,  "Overbought Level")
OS = input.int(-60, "Oversold Level")

// GRAPHICAL SETTINGS 
colBullMain = input.color(color.rgb(6, 162, 47),   "Bull Color (line / gradient)", group = "Colors")
colBearMain = input.color(color.rgb(207, 23, 23),  "Bear Color (line / gradient)", group = "Colors")
colOB       = input.color(color.rgb(207, 23, 23),  "Overbought Color",            group = "Colors")
colOS       = input.color(color.rgb(6, 162, 47),   "Oversold Color",              group = "Colors")
useDynamicLevels = input.bool(true,  "Dynamic OB/OS Lines", group = "Colors")

minTransp   = input.int(90, "Min. Transparency (weak signal)",  minval=0, maxval=100, group="Colors")
maxTransp   = input.int(40, "Max. Transparency (strong signal)",minval=0, maxval=100, group="Colors")
levelLineWidth = input.int(4, "OB/OS Line Thickness", minval=1, maxval=6, group="Colors")

// CONSTANTS + OFFSET 
const_ma1_peak_transp = 55
const_use_ma1_gradient = true
float triangleOffset = 6.0

// SWING RANGE + ATR 
swingHigh  = ta.highest(high, swingLen)
swingLow   = ta.lowest(low, swingLen)
swingRange = swingHigh - swingLow
atr_val    = math.max(ta.atr(atrLen), syminfo.mintick)

// OSCILLATOR 
float osc = na
if swingRange > 0
    if close >= swingLow and close <= swingHigh
        pos = (close - swingLow) / swingRange
        osc := (pos * 200) - 100
    else if close > swingHigh
        osc := 100
    else
        osc := -100

// ADAPTIVE EMA USING ATR
volatility   = math.min(math.max(math.abs(close - close[1]) / atr_val * volFactor, 0), 1)
adaptiveLen  = math.round(math.min(math.max(maxSmooth * (1 - volatility), minSmooth), maxSmooth))
alpha        = 2.0 / (adaptiveLen + 1)

float adaptiveEMA = na
adaptiveEMA := na(adaptiveEMA[1]) ? osc : adaptiveEMA[1] + alpha * (osc - adaptiveEMA[1])

// MA1 + TREND 
ma1     = adaptiveEMA
trendUp = ma1 >= 0

// HELPER FUNCTIONS 
remap(val, inMin, inMax, outMin, outMax) =>
    outMin + (val - inMin) * (outMax - outMin) / (inMax - inMin)

getDynamicOBColor() =>
    if not useDynamicLevels
        colOB
    else
        rawDist = OB - ma1
        clamped = math.max(0, math.min(rawDist, OB))
        transp  = math.round(remap(clamped, 0, OB, maxTransp, minTransp))
        color.new(colOB, transp)

getDynamicOSColor() =>
    if not useDynamicLevels
        colOS
    else
        rawDist = ma1 - OS
        clamped = math.max(0, math.min(rawDist, -OS))
        transp  = math.round(remap(clamped, 0, -OS, maxTransp, minTransp))
        color.new(colOS, transp)

// GRADIENT COLORS 
c_bull_peak = color.new(colBullMain, const_ma1_peak_transp)
c_bear_peak = color.new(colBearMain, const_ma1_peak_transp)
c_bull_zero = color.new(colBullMain, 100)
c_bear_zero = color.new(colBearMain, 100)

// DRAWING 
hline(0, "Zero Line", color = color.gray, linestyle = hline.style_dashed)

plot(useDynamicLevels ? OB : na, "Overbought Level", color = getDynamicOBColor(), linewidth = levelLineWidth)
plot(useDynamicLevels ? OS : na, "Oversold Level",   color = getDynamicOSColor(), linewidth = levelLineWidth)

// Hidden plots used for gradient fill
pMA1  = plot(ma1,  color = na, display = display.none)
pZero = plot(0,    color = na, display = display.none)

// Gradient fill (MA1 → Zero)
fill(pMA1, pZero,
     top_value    = const_use_ma1_gradient and ma1 > 0 ? ma1 : na,
     bottom_value = const_use_ma1_gradient and ma1 > 0 ? 0   : na,
     top_color    = const_use_ma1_gradient and ma1 > 0 ? c_bull_peak : na,
     bottom_color = const_use_ma1_gradient and ma1 > 0 ? c_bull_zero : na)

fill(pZero, pMA1,
     top_value    = const_use_ma1_gradient and ma1 < 0 ? 0   : na,
     bottom_value = const_use_ma1_gradient and ma1 < 0 ? ma1 : na,
     top_color    = const_use_ma1_gradient and ma1 < 0 ? c_bear_zero : na,
     bottom_color = const_use_ma1_gradient and ma1 < 0 ? c_bear_peak : na)

// Main oscillator line
plot(ma1, "Price Symmetry Oscillator", color = trendUp ? colBullMain : colBearMain, linewidth = 3)

// SIGNALS 
longSignal  = adaptiveEMA[1] <= OS and adaptiveEMA > OS
shortSignal = adaptiveEMA[1] >= OB and adaptiveEMA < OB

plotshape(longSignal  ? OS - triangleOffset : na, title="Long Signal",  location=location.absolute, color=colBullMain, style=shape.triangleup,   size=size.small)
plotshape(shortSignal ? OB + triangleOffset : na, title="Short Signal", location=location.absolute, color=colBearMain, style=shape.triangledown, size=size.small)

// ALERTS
alertcondition(longSignal,  title = "Long Signal",  message = "Symmetry Reversal Oscillator: LONG signal")
alertcondition(shortSignal, title = "Short Signal", message = "Symmetry Reversal Oscillator: SHORT signal")
