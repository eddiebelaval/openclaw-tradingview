//@version=5
indicator("RSI Compact Display", overlay=true)

// Paramètres
rsiLength = input.int(14, "Période RSI", minval=1)
rsiSource = input.source(close, "Source")

// Calcul du RSI
rsiValue = ta.rsi(rsiSource, rsiLength)

// Détermination de la couleur selon les zones
rsiColor = rsiValue >= 70 ? color.new(color.red, 0) : 
           rsiValue <= 30 ? color.new(color.green, 0) : 
           color.new(color.orange, 0)

// Création du tableau pour l'affichage
var table rsiTable = table.new(position.top_right, 2, 2, 
                                 bgcolor=color.new(color.black, 10), 
                                 frame_color=color.gray, 
                                 frame_width=2, 
                                 border_width=1, 
                                 border_color=color.gray)

// Mise à jour du tableau
if barstate.islast
    // En-tête
    table.cell(rsiTable, 0, 0, "RSI(" + str.tostring(rsiLength) + ")", 
               text_color=color.white, 
               bgcolor=color.new(color.navy, 20),
               text_size=size.normal)
    
    // Valeur du RSI
    table.cell(rsiTable, 1, 0, str.tostring(rsiValue, "#.##"), 
               text_color=color.white, 
               bgcolor=rsiColor,
               text_size=size.large)

// Alertes optionnelles
alertcondition(ta.crossover(rsiValue, 70), title="RSI Surachat", message="RSI > 70")
alertcondition(ta.crossunder(rsiValue, 30), title="RSI Survente", message="RSI < 30")
