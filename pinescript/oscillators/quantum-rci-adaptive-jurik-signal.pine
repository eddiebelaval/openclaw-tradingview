//@version=6
indicator("Quantum RCI [Adaptive + Jurik Signal]", "Quant_RCI_JMA", precision = 2)

// =============================================================================
// 1. SETTINGS
// =============================================================================
grp_rci  = "RCI Settings"
src_in   = input.source(close, "Source", group=grp_rci)
rci_len  = input.int(10, "RCI Length (Fixed)", minval=1, group=grp_rci)
rci_wid  = input.int(2, "RCI Line Width", minval=1, maxval=4, group=grp_rci)

grp_sig  = "Jurik Signal Line"
sig_len  = input.int(7, "JMA Length", group=grp_sig)
sig_pha  = input.int(50, "JMA Phase (-100 to 100)", group=grp_sig)
sig_pow  = input.int(2, "JMA Power", group=grp_sig)

grp_adap = "Adaptive Bollinger Bands"
er_len   = input.int(10, "Efficiency Ratio Length", group=grp_adap)
min_bb   = input.int(10, "Min BB Length", group=grp_adap)
max_bb   = input.int(30, "Max BB Length", group=grp_adap)
bb_mult  = input.float(2.0, "BB StdDev", group=grp_adap)

grp_adx  = "ADX Strength Gradient"
adx_len  = input.int(14, "ADX Length", group=grp_adx)
adx_min  = input.int(15, "ADX Weak Threshold (Gray)", group=grp_adx)
adx_max  = input.int(40, "ADX Strong Threshold (Neon)", group=grp_adx)

grp_col  = "Visual Theme"
c_bull   = input.color(#00FFFF, "Strong Bullish", group=grp_col)
c_bear   = input.color(#FF00FF, "Strong Bearish", group=grp_col)
c_weak   = input.color(color.new(color.gray, 40), "Weak/Choppy", group=grp_col)
c_sig    = input.color(#FFD700, "Signal Line", group=grp_col)

// =============================================================================
// 2. CORE RCI MATH
// =============================================================================
float rci_val = ta.rci(src_in, rci_len)

// =============================================================================
// 3. JURIK SIGNAL LINE MATH
// =============================================================================
f_jma(src, length, phase, power) =>
    phaseRatio = phase < -100 ? 0.5 : phase > 100 ? 2.5 : phase / 100 + 1.5
    beta = 0.45 * (length - 1) / (0.45 * (length - 1) + 2)
    alpha = math.pow(beta, power)
    var float e0 = 0.0, var float e1 = 0.0, var float e2 = 0.0, var float jma_val = 0.0
    e0 := (1 - alpha) * src + alpha * nz(e0[1])
    e1 := (src - e0) * (1 - beta) + beta * nz(e1[1])
    e2 := (e0 + phaseRatio * e1 - nz(jma_val[1])) * math.pow(1 - alpha, 2) + math.pow(alpha, 2) * nz(e2[1])
    jma_val := e2 + nz(jma_val[1])
    jma_val

float sig_val = f_jma(rci_val, sig_len, sig_pha, sig_pow)

// =============================================================================
// 4. ADX GRADIENT ENGINE (For Move Strength)
// =============================================================================
[diplus, diminus, adx] = ta.dmi(adx_len, adx_len)

color grad_bull = color.from_gradient(adx, adx_min, adx_max, c_weak, c_bull)
color grad_bear = color.from_gradient(adx, adx_min, adx_max, c_weak, c_bear)
color rci_color = rci_val >= 0 ? grad_bull : grad_bear

// =============================================================================
// 5. ADAPTIVE BOLLINGER BANDS MATH
// =============================================================================
float direction = math.abs(close - nz(close[er_len]))
float volatility = math.sum(math.abs(close - nz(close[1])), er_len)
float er = volatility != 0 ? direction / volatility : 0

int dyn_bb_len = math.round(min_bb + (max_bb - min_bb) * (1.0 - er))
dyn_bb_len := math.max(1, dyn_bb_len)

float bb_basis = ta.sma(rci_val, dyn_bb_len)
float bb_dev   = ta.stdev(rci_val, dyn_bb_len) * bb_mult
float bb_upper = bb_basis + bb_dev
float bb_lower = bb_basis - bb_dev

// =============================================================================
// 6. PLOTTING & SIGNALS
// =============================================================================
// Fixed extreme bands
hline(0, "Midline", color=color.new(color.gray, 60), linestyle=hline.style_dotted)
h_up = hline(80, "Upper Extreme", color=color.new(color.gray, 70))
h_dn = hline(-80, "Lower Extreme", color=color.new(color.gray, 70))
fill(h_up, h_dn, color=color.new(color.blue, 95), title="Extreme Zone Fill")

// Plot Adaptive Bollinger Bands
p_up = plot(bb_upper, "BB Upper", color=color.new(color.green, 70))
p_dn = plot(bb_lower, "BB Lower", color=color.new(color.red, 70))
plot(bb_basis, "BB Basis", color=color.new(color.yellow, 50), display=display.none)
fill(p_up, p_dn, color=color.new(color.white, 95), title="BB Fill")

// Plot Signal Line and RCI
plot(sig_val, "Jurik Signal", color=c_sig, linewidth=1)
plot(rci_val, "RCI", color=rci_color, linewidth=rci_wid)

// Crossover Signals
bool crossUp = ta.crossover(rci_val, sig_val)
bool crossDn = ta.crossunder(rci_val, sig_val)

plotshape(crossUp ? rci_val : na, title="Bull Cross", style=shape.triangleup, location=location.absolute, color=c_bull, size=size.tiny, offset=0)
plotshape(crossDn ? rci_val : na, title="Bear Cross", style=shape.triangledown, location=location.absolute, color=c_bear, size=size.tiny, offset=0)
