//                                 ██║       ██║     ████████║  ██║ ███║  ██║   ██║       ██████╔╝ ██║   ██║ ██║      ████████║ ████████║
//                                 ██║       ██║     ██╔═══██║  ██║  ██║  ██║   ██║       ██╔══██╗ ██║   ██║ ██║      ██║   ██║ ██╔═══██║
//                                 ██║    ████████╗  ██║   ██║  ███████║  ╚██████╔╝       ██║  ██║ ╚██████╔╝ ╚██████╗ ██║   ██║ ██║   ██║
//@version=6
indicator('Fisher Transform - Fisher | TR', 'Fisher | TR →', format=format.price, precision=2)
import TradingView/ta/12
//╔═════════════════╗
//║     Input's     ║
//╚═════════════════╝
Color_Mode =        input.string('Classic', 'Color Choice', group = '🎨 Color', options = ['Classic', 'Modern', 'Robust', 'Accented', 'Monochrome', 'Moderate', 'Aqua', 'Cosmic'])
Bool_Fisher =       input.bool(true,'Normal Fisher', group='⚙️ Fisher Setting', inline = 'Fisher')
Length_Fisher =     input.int(41, minval=2, title='Length', group='⚙️ Fisher Setting', inline = 'Fisher')
Source_Fisher =     input(hl2, title = '', group='⚙️ Fisher Setting', inline = 'Fisher')
Signal_Fisher =     input.string('0', 'Entry/Exit Signal', group='⚙️ Fisher Setting', options = ['0', 'Fisher MA'],tooltip = 'Choose Entry/Exit Point')
Length_MA_Fisher =  input.int(365, minval=2, title = 'Length MA', group='📊 Fisher MA', inline = 'Fisher MA')
Source_MA_Fisher =  input.string('EMA', 'Moving Average', group='📊 Fisher MA', inline = 'Fisher MA', options=['EMA', 'SMA', 'RMA', 'WMA', 'VWMA', 'HMA', 'DEMA', 'TEMA', 'TRIMA', 'FRAMA', 'SWMA', 'T3'])
T_Factor =          input.float(0.7, 'T3 Factor', minval=0, maxval=1, step=0.05, group='📊 Fisher MA', tooltip = 'For Moving Average = T3')
//╔═════════════════════════════════╗
//║     MOVING AVERAGE ENGINE       ║
//╚═════════════════════════════════╝
ma(source, length, factor, type) =>
     type == 'EMA'   ? ta.ema(source, length) :
     type == 'SMA'   ? ta.sma(source, length) :
     type == 'RMA'   ? ta.rma(source, length) :
     type == 'WMA'   ? ta.wma(source, length) :
     type == 'VWMA'  ? ta.vwma(source, length) :
     type == 'HMA'   ? ta.hma(source, length) :
     type == 'DEMA'  ? ta.dema(source, length) :
     type == 'TEMA'  ? ta.tema(source, length) :
     type == 'TRIMA' ? ta.trima(source, length) :
     type == 'FRAMA' ? ta.frama(source, length) :
     type == 'SWMA'  ? ta.swma(source) :
     type == 'T3'    ? ta.t3(source, length, factor) :
     na
//╔═════════════════╗
//║     Color       ║
//╚═════════════════╝
[UpC, DnC] = switch Color_Mode
    'Classic' =>    [#008800, #ff0000]
    'Modern' =>     [#ffffff, #b721ff]
    'Robust' =>     [#ffbb00, #770737]
    'Accented' =>   [#8c5cf7, #e83e8c]
    'Monochrome' => [#e9ecef, #495057]
    'Moderate' =>   [#43a047, #e53935]
    'Aqua' =>       [#00a8e8, #f18f01]
    'Cosmic' =>     [#e83e8c, #6f2da8]
//╔════════════════════════╗
//║      Calculation       ║
//╚════════════════════════╝
Fisher_High = ta.highest(Source_Fisher, Length_Fisher)
Fisher_Low = ta.lowest(Source_Fisher, Length_Fisher)
round_(val) => val > .99 ? .999 : val < -.99 ? -.999 : val
Fisher_Value = 0.0
Fisher_Value := round_(.66 * ((Source_Fisher - Fisher_Low) / (Fisher_High - Fisher_Low) - .5) + .67 * nz(Fisher_Value[1]))
Fisher_1 = 0.0
Fisher_1 := .5 * math.log((1 + Fisher_Value) / (1 - Fisher_Value)) + .5 * nz(Fisher_1[1])
Fisher_2 = Fisher_1[1]
Fisher = (Fisher_1 + Fisher_2) / 2
Fisher_MA =  ma(Fisher, Length_MA_Fisher, T_Factor, Source_MA_Fisher)
float Entry_Fisher = Signal_Fisher == 'Fisher MA' ? Fisher_MA : 0.0
isBull_Fisher_Normal = Fisher_1 > Fisher_2
isBull_Fisher_Mean = Fisher > Entry_Fisher
isBear_Fisher_Normal = Fisher_1 < Fisher_2 
isBear_Fisher_Mean = Fisher < Entry_Fisher
Bull_Fisher_Normal = ta.crossover(Fisher_1,Fisher_2)
Bull_Fisher_Mean = ta.crossover(Fisher,Entry_Fisher)
Bear_Fisher_Normal = ta.crossunder(Fisher_1,Fisher_2)
Bear_Fisher_Mean = ta.crossunder(Fisher,Entry_Fisher)
//╔════════════════════════╗
//║          Plot          ║
//╚════════════════════════╝
Plot_Fisher_1 =     plot(Bool_Fisher ? Fisher_1 :  na, color= isBull_Fisher_Normal ? UpC : isBear_Fisher_Normal ? DnC : na, title='Fisher 1', linewidth=2)
Plot_Fisher_2 =     plot(Bool_Fisher ? Fisher_2 : na, color= isBull_Fisher_Normal ? UpC : isBear_Fisher_Normal ? DnC : na , title='Fisher 2', linewidth=2)
Plot_Fisher =       plot(Bool_Fisher ? na : Fisher, color= isBull_Fisher_Mean ? UpC : isBear_Fisher_Mean ? DnC : na , title='Fisher', linewidth=2)
Plot_Entry_Fisher = plot(Bool_Fisher ? na : Entry_Fisher,color = color.yellow)
fill(Plot_Fisher_1, Plot_Fisher_2, color = Bool_Fisher ? isBull_Fisher_Normal ? color.new(UpC, 80) : isBear_Fisher_Normal ? color.new(DnC, 80) : na : na, title='Fisher Fill')
fill(Plot_Fisher, Plot_Entry_Fisher, 6, Entry_Fisher, top_color = color.new(UpC, 0), bottom_color = color.new(UpC, 100), title = 'Overbought Fill')
fill(Plot_Fisher, Plot_Entry_Fisher, Entry_Fisher, -6, top_color = color.new(DnC, 100), bottom_color =color.new(DnC, 0),    title = 'Oversold Fill')
fill(Plot_Fisher, Plot_Entry_Fisher, Fisher < Entry_Fisher ? Fisher : 0, Fisher < Entry_Fisher ? 0 : Fisher, Fisher < Entry_Fisher ? DnC : na, Fisher < Entry_Fisher ? na : UpC)
plotcandle(open, high, low, close, 'Bar Color', Bool_Fisher ?  isBull_Fisher_Normal ? UpC : isBear_Fisher_Normal ? DnC : color.gray : isBull_Fisher_Mean ? UpC : isBear_Fisher_Mean ? DnC : color.gray, force_overlay = true)
plotshape(Bool_Fisher ? Bull_Fisher_Normal : Bull_Fisher_Mean, 'LONG', shape.triangleup  , location.belowbar, UpC, 0, size = size.small, force_overlay = true)
plotshape(Bool_Fisher ? Bear_Fisher_Normal : Bear_Fisher_Mean, 'SHORT', shape.triangledown, location.abovebar, DnC, 0, size = size.small, force_overlay = true)
bgcolor(Bool_Fisher ? (isBull_Fisher_Normal ? color.new(UpC, 95) : isBear_Fisher_Normal ? color.new(DnC, 95) : na) : (isBull_Fisher_Mean ? color.new(UpC, 95) : isBear_Fisher_Mean ? color.new(DnC, 95) : na), title='Zone Background', force_overlay=true)
//╔════════════════════════╗
//║          VIEW          ║
//╚════════════════════════╝
var table Table_Fisher = table.new(position.middle_right, 1, 1, border_width = 1)
var label FisherLabel = na
if barstate.islast
    table.cell(Table_Fisher, 0, 0, text =  Bool_Fisher ? isBull_Fisher_Normal ? '⬆️ Bullish' : '⬇️ Bearish' : isBull_Fisher_Mean ? '⬆️ Bullish' : '⬇️ Bearish' , text_color =  Bool_Fisher ? isBull_Fisher_Normal ? UpC : isBear_Fisher_Normal ? DnC : color.gray : isBull_Fisher_Mean ? UpC : isBear_Fisher_Mean ? DnC : color.gray,text_size = size.huge)
    if not na(FisherLabel)
        label.delete(FisherLabel)
    FisherLabel := label.new(bar_index + 5, Fisher, text =  str.tostring(Fisher, '#.##'), color = Bool_Fisher ?  isBull_Fisher_Normal ? color.new(UpC, 20) : isBear_Fisher_Normal ? color.new(DnC, 20) : color.gray : isBull_Fisher_Mean ? color.new(UpC, 20) : isBear_Fisher_Mean ? color.new(DnC, 20) : color.gray , style = label.style_label_left, size = size.large, textcolor = #000000)
//╔════════════════════════╗
//║         Alerts         ║
//╚════════════════════════╝
alertcondition(Bull_Fisher_Normal, title= 'LONG', message= '{{ticker}} LONG')
alertcondition(Bull_Fisher_Mean, title= 'LONG', message= '{{ticker}} LONG')
alertcondition(Bear_Fisher_Normal, title= 'SHORT', message= '{{ticker}} SHORT')
alertcondition(Bear_Fisher_Mean, title= 'SHORT', message= '{{ticker}} SHORT')
