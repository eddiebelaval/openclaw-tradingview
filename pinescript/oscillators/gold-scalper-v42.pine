//@version=6
// ============================================================
// Gold Scalper V4.2 | Kalman MTF — Gold Edition
// Version : 4.2 — Zone Labels with Custom Colors
// ============================================================

indicator("Gold Scalper V4.2",
     max_labels_count = 500, overlay = true)

// ═══════════════════════════════════════════════════════════
// GROUP: LTF DOUBLE BOLLINGER BANDS
// ═══════════════════════════════════════════════════════════
int   ltfLength    = input.int(20,   minval=1,   maxval=500, title="Length",                 group="🔵 LTF Double Bollinger Bands")
float ltfMult1     = input.float(1.0, minval=0.1, maxval=5,  title="Inner Multiplier (BB1)", group="🔵 LTF Double Bollinger Bands")
float ltfMult2     = input.float(2.0, minval=0.1, maxval=5,  title="Outer Multiplier (BB2)", group="🔵 LTF Double Bollinger Bands")
int   ltfLW        = input.int(1,    minval=1,               title="Linewidth",              group="🔵 LTF Double Bollinger Bands")
bool  plotLTFBB    = input.bool(true,                         title="Plot LTF BB",            group="🔵 LTF Double Bollinger Bands")
color ltfBB1Col    = input.color(color.new(#26a69a, 15),     title="BB1 Inner Color",        group="🔵 LTF Double Bollinger Bands")
color ltfBB2Col    = input.color(color.new(#f57c00, 10),     title="BB2 Outer Color",        group="🔵 LTF Double Bollinger Bands")
color ltfBasisCol  = input.color(color.new(#90a4ae, 30),     title="Basis Color",            group="🔵 LTF Double Bollinger Bands")

// ═══════════════════════════════════════════════════════════
// GROUP: HTF DOUBLE BOLLINGER BANDS
// ═══════════════════════════════════════════════════════════
string HTFOption   = input.timeframe("60",                    title="HTF Timeframe",          group="🟣 HTF Double Bollinger Bands",
     tooltip="Recommended pairs — 1m→5m | 5m→15m | 15m→1H | 1H→4H")
int   htfLength    = input.int(20,   minval=1,   maxval=500, title="Length",                 group="🟣 HTF Double Bollinger Bands")
float htfMult1     = input.float(1.5, minval=0.1, maxval=5,  title="Inner Multiplier (BB1)", group="🟣 HTF Double Bollinger Bands")
float htfMult2     = input.float(2.25,minval=0.1, maxval=5,  title="Outer Multiplier (BB2)", group="🟣 HTF Double Bollinger Bands")
int   htfLW        = input.int(1,    minval=1,               title="Linewidth",              group="🟣 HTF Double Bollinger Bands")
bool  plotHTFBB    = input.bool(true,                         title="Plot HTF BB",            group="🟣 HTF Double Bollinger Bands")
bool  plotLabels   = input.bool(true,                         title="Plot HTF Labels",        group="🟣 HTF Double Bollinger Bands")
color htfBB1Col    = input.color(color.new(#78909c, 50),     title="BB1 Inner Color",        group="🟣 HTF Double Bollinger Bands")
color htfBB2Col    = input.color(color.new(#b0bec5, 30),     title="BB2 Outer Color",        group="🟣 HTF Double Bollinger Bands")

// ═══════════════════════════════════════════════════════════
// GROUP: SIGNALS & ENTRY/EXIT
// ═══════════════════════════════════════════════════════════
bool  signalsOn    = input.bool(true,  title="Show Signals",          group="🎯 Signals & Entry/Exit")
bool  showTP       = input.bool(true,  title="Show TP1 & TP2 Lines", group="🎯 Signals & Entry/Exit")
bool  showSL       = input.bool(true,  title="Show Stop Loss Line",   group="🎯 Signals & Entry/Exit")
int   lblOffset    = input.int(6,      title="Label Bar Offset",      group="🎯 Signals & Entry/Exit", minval=1)

// ═══════════════════════════════════════════════════════════
// GROUP: ZONE GRADIENT
// ═══════════════════════════════════════════════════════════
string colorOpt    = input.string("Gradient", title="Fill Mode",
     options=["Gradient","Solid","None"],                             group="🎨 Zone Gradient")
int   maxOpac      = input.int(85, minval=0, maxval=100, title="Opacity Max", group="🎨 Zone Gradient")
int   minOpac      = input.int(50, minval=0, maxval=100, title="Opacity Min", group="🎨 Zone Gradient")
color bullCol      = input.color(#089981, title="Bullish Color",              group="🎨 Zone Gradient")
color bearCol      = input.color(#F23645, title="Bearish Color",              group="🎨 Zone Gradient")

// ═══════════════════════════════════════════════════════════
// GROUP: ZONE LABELS
// ═══════════════════════════════════════════════════════════
bool  showZoneLabels = input.bool(true,  title="Show Zone Labels",      group="🏷️ Zone Labels")
int   zoneLblFreq    = input.int(30,     title="Label Every N Bars",    group="🏷️ Zone Labels",
     minval=5, maxval=200,
     tooltip="How often labels refresh. Lower = more frequent, Higher = less clutter.")

// ── SELL ZONE label colors ──
color sellLblBg   = input.color(color.new(#F23645, 10), title="SELL Zone — Background",  group="🏷️ Zone Labels",
     tooltip="Dark red works on light charts. Adjust for your chart theme.")
color sellLblTxt  = input.color(color.new(#ffffff, 0),  title="SELL Zone — Text Color",  group="🏷️ Zone Labels",
     tooltip="White text on dark bg. Change to black if your chart is light.")

// ── NEUTRAL ZONE label colors ──
color neutLblBg   = input.color(color.new(#37474f, 10), title="NEUTRAL Zone — Background", group="🏷️ Zone Labels",
     tooltip="Dark gray works on most charts. Adjust for your theme.")
color neutLblTxt  = input.color(color.new(#ffffff, 0),  title="NEUTRAL Zone — Text Color", group="🏷️ Zone Labels")

// ── BUY ZONE label colors ──
color buyLblBg    = input.color(color.new(#089981, 10), title="BUY Zone — Background",   group="🏷️ Zone Labels",
     tooltip="Dark green works on light charts. Adjust for your chart theme.")
color buyLblTxt   = input.color(color.new(#ffffff, 0),  title="BUY Zone — Text Color",   group="🏷️ Zone Labels",
     tooltip="White text on dark bg. Change to black if your chart is light.")

// ═══════════════════════════════════════════════════════════
// GROUP: OVERLAYS
// ═══════════════════════════════════════════════════════════
bool  showErrors   = input.bool(true, title="Show TF Warnings", group="⚙️ Overlays")

// ═══════════════════════════════════════════════════════════
// KALMAN FILTER
// ═══════════════════════════════════════════════════════════
kalman_filter(float src) =>
    var float estimate        = na
    var float error_est       = 1.0
    float     process_noise   = 0.005 * math.max(src, 1.0)
    float     measurement_err = 0.020 * math.max(src, 1.0)
    if na(estimate)
        estimate := nz(src[1], src)
    float prediction  = estimate
    float kalman_gain = error_est / (error_est + measurement_err)
    estimate         := prediction + kalman_gain * (src - prediction)
    error_est        := (1.0 - kalman_gain) * error_est + process_noise
    estimate

// ═══════════════════════════════════════════════════════════
// VOLUME-BASED GRADIENT COLOR & SIGNAL FILTER
// ═══════════════════════════════════════════════════════════
float hl    = math.max(high - low, 1e-10)
float vol   = math.max(volume, 1e-10)
float bvPct = (volume * (close - low)  / hl) / vol
float svPct = (volume * (high - close) / hl) / vol
float bvEMA = ta.ema(bvPct, 3)
float svEMA = ta.ema(svPct, 3)

getFillColor(color col, string side) =>
    float pct   = side == "buy" ? bvEMA : svEMA
    float opac  = 100.0 - (pct * (maxOpac - minOpac) + minOpac)
    color.new(col, math.max(0, math.min(100, opac)))

// ═══════════════════════════════════════════════════════════
// LTF DOUBLE BB — Kalman-filtered basis
// ═══════════════════════════════════════════════════════════
float ltfStdev = ta.stdev(close, ltfLength)
float ltfBasis = kalman_filter(close)
float ltfBB1Up = ltfBasis + ltfMult1 * ltfStdev
float ltfBB1Lo = ltfBasis - ltfMult1 * ltfStdev
float ltfBB2Up = ltfBasis + ltfMult2 * ltfStdev
float ltfBB2Lo = ltfBasis - ltfMult2 * ltfStdev

pBasis = plot(plotLTFBB ? ltfBasis : na, color=ltfBasisCol,  linewidth=ltfLW,   title="LTF Basis")
pBB1Up = plot(plotLTFBB ? ltfBB1Up : na, color=ltfBB1Col,   linewidth=ltfLW,   title="LTF BB1 Upper")
pBB1Lo = plot(plotLTFBB ? ltfBB1Lo : na, color=ltfBB1Col,   linewidth=ltfLW,   title="LTF BB1 Lower")
pBB2Up = plot(plotLTFBB ? ltfBB2Up : na, color=ltfBB2Col,   linewidth=ltfLW+1, title="LTF BB2 Upper")
pBB2Lo = plot(plotLTFBB ? ltfBB2Lo : na, color=ltfBB2Col,   linewidth=ltfLW+1, title="LTF BB2 Lower")

// ═══════════════════════════════════════════════════════════
// HTF DOUBLE BB
// ═══════════════════════════════════════════════════════════
htfSMA     = ta.sma(close, htfLength)
htfSDEV    = ta.stdev(close, htfLength)
// Non-repainting: Fetch MTF data from the last closed HTF bar
htfB_raw   = request.security(syminfo.tickerid, HTFOption, htfSMA[1], lookahead = barmerge.lookahead_on)
htfB1U_raw = request.security(syminfo.tickerid, HTFOption, (htfSMA + htfMult1 * htfSDEV)[1], lookahead = barmerge.lookahead_on)
htfB1L_raw = request.security(syminfo.tickerid, HTFOption, (htfSMA - htfMult1 * htfSDEV)[1], lookahead = barmerge.lookahead_on)
htfB2U_raw = request.security(syminfo.tickerid, HTFOption, (htfSMA + htfMult2 * htfSDEV)[1], lookahead = barmerge.lookahead_on)
htfB2L_raw = request.security(syminfo.tickerid, HTFOption, (htfSMA - htfMult2 * htfSDEV)[1], lookahead = barmerge.lookahead_on)

float htfBasis = ta.ema(htfB_raw,   5)
float htfBB1Up = ta.ema(htfB1U_raw, 5)
float htfBB1Lo = ta.ema(htfB1L_raw, 5)
float htfBB2Up = ta.ema(htfB2U_raw, 5)
float htfBB2Lo = ta.ema(htfB2L_raw, 5)

pH_BB2Up = plot(plotHTFBB ? htfBB2Up : na, color=htfBB2Col,                  linewidth=htfLW+1, title="HTF BB2 Upper")
pH_BB1Up = plot(plotHTFBB ? htfBB1Up : na, color=htfBB1Col,                  linewidth=htfLW,   title="HTF BB1 Upper")
pH_Basis = plot(plotHTFBB ? htfBasis  : na, color=color.new(color.gray, 50),  linewidth=htfLW,   title="HTF Basis")
pH_BB1Lo = plot(plotHTFBB ? htfBB1Lo : na, color=htfBB1Col,                  linewidth=htfLW,   title="HTF BB1 Lower")
pH_BB2Lo = plot(plotHTFBB ? htfBB2Lo : na, color=htfBB2Col,                  linewidth=htfLW+1, title="HTF BB2 Lower")

// ═══════════════════════════════════════════════════════════
// ZONE FILLS
// ═══════════════════════════════════════════════════════════
color fillBuy  = colorOpt == "None"     ? na :
                 colorOpt == "Gradient" ? getFillColor(bullCol, "buy")  :
                 color.new(bullCol, 75)
color fillSell = colorOpt == "None"     ? na :
                 colorOpt == "Gradient" ? getFillColor(bearCol, "sell") :
                 color.new(bearCol, 75)

fill(pBB2Lo, pBB1Lo, color=fillBuy,                     title="Bullish Extreme Zone")
fill(pBB2Up, pBB1Up, color=fillSell,                    title="Bearish Extreme Zone")
fill(pBB1Up, pBB1Lo, color=color.new(color.gray, 94),   title="Neutral Zone")

// ═══════════════════════════════════════════════════════════
// HTF LABELS (right edge)
// ═══════════════════════════════════════════════════════════
if plotLabels and plotHTFBB
    label l1 = label.new(bar_index + lblOffset, htfBB2Up, "HTF BB2 ↑",
         color=na, textcolor=htfBB2Col, style=label.style_label_left, size=size.small)
    label l2 = label.new(bar_index + lblOffset, htfBB2Lo, "HTF BB2 ↓",
         color=na, textcolor=htfBB2Col, style=label.style_label_left, size=size.small)
    label.delete(l1[1])
    label.delete(l2[1])

// ═══════════════════════════════════════════════════════════
// ZONE LABELS — User-customizable colors
//
// Chart layout:
//   BB2 Upper ──────────────────────────────────────────
//     🔴 SELL ZONE | Overbought → Look for SELL
//       TP target for BUY → BB1 Upper & BB2 Upper
//   BB1 Upper ──────────────────────────────────────────
//
//     ⚪ NEUTRAL ZONE | Wait for extreme zone
//
//   BB1 Lower ──────────────────────────────────────────
//     🟢 BUY ZONE | Oversold → Look for BUY
//       TP target for SELL → BB1 Lower & BB2 Lower
//   BB2 Lower ──────────────────────────────────────────
//
// Default colors (dark bg friendly):
//   SELL  → Dark red bg   + White text
//   NEUT  → Dark gray bg  + White text
//   BUY   → Dark green bg + White text
//
// For LIGHT chart themes, go to Settings → Zone Labels
// and change Text Color to black (#000000) for each zone.
// ═══════════════════════════════════════════════════════════

var label zoneSellLbl = na
var label zoneNeutLbl = na
var label zoneBuyLbl  = na

if showZoneLabels and plotLTFBB and bar_index % zoneLblFreq == 0

    // ── SELL ZONE: midpoint between BB2 Upper and BB1 Upper ──
    // Overbought area — entry for SELL, TP for BUY trades
    float sellMid = (ltfBB2Up + ltfBB1Up) / 2.0
    label.delete(zoneSellLbl)
    zoneSellLbl := label.new(
         bar_index, sellMid,
         "🔴 SELL ZONE  ┃  Price > BB2 Upper → Overbought → Look for SELL  |  BUY TP Target Zone",
         color     = sellLblBg,
         textcolor = sellLblTxt,
         style     = label.style_label_left,
         size      = size.normal)

    // ── NEUTRAL ZONE: midpoint between BB1 Upper and BB1 Lower ──
    // No trade zone — price inside normal range
    float neutMid = (ltfBB1Up + ltfBB1Lo) / 2.0
    label.delete(zoneNeutLbl)
    zoneNeutLbl := label.new(
         bar_index, neutMid,
         "⚪ NEUTRAL ZONE  ┃  Inside BB1 bands → No extreme → Wait for BUY or SELL Zone",
         color     = neutLblBg,
         textcolor = neutLblTxt,
         style     = label.style_label_left,
         size      = size.normal)

    // ── BUY ZONE: midpoint between BB1 Lower and BB2 Lower ──
    // Oversold area — entry for BUY, TP for SELL trades
    float buyMid = (ltfBB1Lo + ltfBB2Lo) / 2.0
    label.delete(zoneBuyLbl)
    zoneBuyLbl := label.new(
         bar_index, buyMid,
         "🟢 BUY ZONE  ┃  Price < BB2 Lower → Oversold → Look for BUY  |  SELL TP Target Zone",
         color     = buyLblBg,
         textcolor = buyLblTxt,
         style     = label.style_label_left,
         size      = size.normal)

// ═══════════════════════════════════════════════════════════
// SIGNAL LOGIC — 3-CONFLUENCE SYSTEM
// ═══════════════════════════════════════════════════════════
bool inBearZone      = close > ltfBB2Up
bool inBullZone      = close < ltfBB2Lo
bool htfBullish      = close > htfBasis
bool htfBearish      = close < htfBasis
bool ltfBearMomentum = ltfBB2Up < ltfBB2Up[1] and close < close[1]
bool ltfBullMomentum = ltfBB2Lo > ltfBB2Lo[1] and close > close[1]

var bool crossedAbove = false
var bool crossedBelow = false
var bool bearSignaled = false
var bool bullSignaled = false

if inBearZone
    crossedAbove := true
if inBullZone
    crossedBelow := true

if close < ltfBB1Up and close < htfBB1Up
    crossedAbove := false
    bearSignaled := false
if close > ltfBB1Lo and close > htfBB1Lo
    crossedBelow := false
    bullSignaled := false

bool hasBullVol = bvEMA > 0.4
bool hasBearVol = svEMA > 0.4

bool sellSignal = crossedAbove and ltfBearMomentum and htfBearish and hasBearVol and not bearSignaled
bool buySignal  = crossedBelow and ltfBullMomentum and htfBullish and hasBullVol and not bullSignaled

if sellSignal
    alert("🔴 SELL Signal | Gold Scalper", alert.freq_once_per_bar)
    bearSignaled := true
if buySignal
    alert("🟢 BUY Signal | Gold Scalper", alert.freq_once_per_bar)
    bullSignaled := true

// ═══════════════════════════════════════════════════════════
// PERSISTENT TRADE LEVELS
// ═══════════════════════════════════════════════════════════
var float  lastEntry = na
var float  lastSL    = na
var float  lastTP1   = na
var float  lastTP2   = na
var float  lastRRR   = na
var string lastSide  = "—"

if buySignal
    lastEntry := close
    lastTP1   := ltfBB1Up
    lastTP2   := ltfBB2Up
    lastSL    := ltfBB2Lo * 0.998
    lastRRR   := math.abs(ltfBB2Up - close) / math.max(math.abs(close - lastSL), 1e-10)
    lastSide  := "BUY"

if sellSignal
    lastEntry := close
    lastTP1   := ltfBB1Lo
    lastTP2   := ltfBB2Lo
    lastSL    := ltfBB2Up * 1.002
    lastRRR   := math.abs(close - ltfBB2Lo) / math.max(math.abs(lastSL - close), 1e-10)
    lastSide  := "SELL"

// ═══════════════════════════════════════════════════════════
// ENTRY / TP / SL LINES & LABELS (HISTORICAL PERSISTENCE)
// ═══════════════════════════════════════════════════════════

// ── BUY SETUP ──
if buySignal and signalsOn
    int s = bar_index
    line.new(s, lastEntry, s+40, lastEntry, color=color.new(bullCol,0),   width=2, style=line.style_dotted)
    if showTP
        line.new(s, lastTP1, s+40, lastTP1, color=color.new(bullCol,45), width=1, style=line.style_dashed)
        line.new(s, lastTP2, s+40, lastTP2, color=color.new(bullCol,20), width=2, style=line.style_dashed)
    if showSL
        line.new(s, lastSL,  s+40, lastSL,  color=color.new(bearCol,20), width=1, style=line.style_dashed)

    label.new(s, lastEntry, "▲ BUY\n" + str.tostring(lastEntry, "#.##"),
         color=bullCol, textcolor=color.white, style=label.style_label_up, size=size.normal)
    if showTP
        label.new(s+40, lastTP1, "TP1 " + str.tostring(lastTP1, "#.##"),
             color=color.new(bullCol,45), textcolor=color.white, style=label.style_label_left, size=size.small)
        label.new(s+40, lastTP2, "TP2 " + str.tostring(lastTP2, "#.##"),
             color=color.new(bullCol,20), textcolor=color.white, style=label.style_label_left, size=size.small)
    if showSL
        label.new(s+40, lastSL,  "SL  " + str.tostring(lastSL,  "#.##"),
             color=color.new(bearCol,20), textcolor=color.white, style=label.style_label_left, size=size.small)

// ── SELL SETUP ──
if sellSignal and signalsOn
    int s = bar_index
    line.new(s, lastEntry, s+40, lastEntry, color=color.new(bearCol,0),   width=2, style=line.style_dotted)
    if showTP
        line.new(s, lastTP1, s+40, lastTP1, color=color.new(bearCol,45), width=1, style=line.style_dashed)
        line.new(s, lastTP2, s+40, lastTP2, color=color.new(bearCol,20), width=2, style=line.style_dashed)
    if showSL
        line.new(s, lastSL,  s+40, lastSL,  color=color.new(bullCol,20), width=1, style=line.style_dashed)

    label.new(s, lastEntry, "▼ SELL\n" + str.tostring(lastEntry, "#.##"),
         color=bearCol, textcolor=color.white, style=label.style_label_down, size=size.normal)
    if showTP
        label.new(s+40, lastTP1, "TP1 " + str.tostring(lastTP1, "#.##"),
             color=color.new(bearCol,45), textcolor=color.white, style=label.style_label_left, size=size.small)
        label.new(s+40, lastTP2, "TP2 " + str.tostring(lastTP2, "#.##"),
             color=color.new(bearCol,20), textcolor=color.white, style=label.style_label_left, size=size.small)
    if showSL
        label.new(s+40, lastSL,  "SL  " + str.tostring(lastSL,  "#.##"),
             color=color.new(bullCol,20), textcolor=color.white, style=label.style_label_left, size=size.small)

// ── Signal Shapes ──
plotshape(sellSignal and signalsOn ? high * 1.001 : na,
     location=location.absolute, style=shape.triangledown,
     color=bearCol, size=size.small, title="Sell Signal")
plotshape(buySignal  and signalsOn ? low  * 0.999 : na,
     location=location.absolute, style=shape.triangleup,
     color=bullCol, size=size.small, title="Buy Signal")

// ═══════════════════════════════════════════════════════════
// TF WARNING
// ═══════════════════════════════════════════════════════════
bool ltfIsHigher = timeframe.in_seconds(timeframe.period) > timeframe.in_seconds(HTFOption)
if ltfIsHigher and showErrors and barstate.islast
    var table warnT = table.new(position.top_left, 1, 1,
         bgcolor=color.new(color.black, 60), frame_width=1)
    table.cell(warnT, 0, 0, "⚠️  Chart TF is HIGHER than HTF setting!",
         text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.red, 60))
