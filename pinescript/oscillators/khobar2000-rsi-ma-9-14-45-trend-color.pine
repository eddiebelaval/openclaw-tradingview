//@version=5
indicator("RSI + MA 9 / 14 / 45 (Trend Color)", overlay=false)

// ───── RSI ─────
rsiLength = 14
rsiValue  = ta.rsi(close, rsiLength)

// ───── المتوسطات (ثابتة) ─────
maType = input.string("EMA", "نوع المتوسط", options=["EMA", "SMA"])

ma9  = maType == "EMA" ? ta.ema(rsiValue, 9)  : ta.sma(rsiValue, 9)
ma14 = maType == "EMA" ? ta.ema(rsiValue, 14) : ta.sma(rsiValue, 14)
ma45 = maType == "EMA" ? ta.ema(rsiValue, 45) : ta.sma(rsiValue, 45)

// ───── ترتيب الاتجاه ─────
bullish = rsiValue > ma9 and ma9 > ma14 and ma14 > ma45
bearish = rsiValue < ma9 and ma9 < ma14 and ma14 < ma45

rsiColor = bullish ? color.lime :
           bearish ? color.red  :
           color.yellow

// ───── الرسم ─────
plot(rsiValue, title="RSI", color=rsiColor, linewidth=3)
plot(ma9,  title="MA 9",  color=color.orange)
plot(ma14, title="MA 14", color=color.blue)
plot(ma45, title="MA 45", color=color.gray)

// ───── مستويات RSI ─────
hline(70, "Overbought", color=color.red, linestyle=hline.style_dotted)
hline(50, "Mid", color=color.gray)
hline(30, "Oversold", color=color.green, linestyle=hline.style_dotted)
