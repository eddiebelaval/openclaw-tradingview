//@version=5
indicator("VVEI - Regression Residuals", shorttitle="VolDiv", overlay=false)

// --- Inputs ---
atrLength      = input.int(14, "ATR Period")
lookback       = input.int(50, "Lookback Period")
smoothOutput   = input.int(3, "Smooth Signal")
useTrueRange   = input.bool(false, "Use True Range (vs Close-to-Close)")
useDollarVol   = input.bool(true, "Use Dollar Volume (Price * Vol)")
showBands      = input.bool(true, "Show Threshold Bands")

// --- ATR & Price Move ---
tr = ta.tr(true)
atr = ta.rma(tr, atrLength)

ccMove = math.abs(close - close[1]) / atr
trMove = tr / atr
moveRaw = useTrueRange ? trMove : ccMove

// --- Volume Calculation ---
volBase = useDollarVol ? (volume * close) : volume
// Log transform to normalize scale across different market caps
volRaw = volBase > 0 ? math.log(volBase) : 0

// --- Standardize (Z-Scores) ---
moveMean = ta.sma(moveRaw, lookback)
moveStd  = ta.stdev(moveRaw, lookback)
volMean  = ta.sma(volRaw, lookback)
volStd   = ta.stdev(volRaw, lookback)

zMove = moveStd > 0 ? (moveRaw - moveMean) / moveStd : 0
zVol  = volStd > 0 ? (volRaw - volMean) / volStd : 0

// --- Empirical Expected-Volume Model (Linear Regression) ---
// Formula: expected zVol = alpha + beta * zMove
meanZMove = ta.sma(zMove, lookback)
meanZVol  = ta.sma(zVol, lookback)

covariance = ta.sma((zMove - meanZMove) * (zVol - meanZVol), lookback)
variance   = ta.sma(math.pow(zMove - meanZMove, 2), lookback)

beta  = variance > 0 ? covariance / variance : 1
alpha = meanZVol - beta * meanZMove

expectedZVol = alpha + beta * zMove

// --- The Signal (Residual) ---
rawResidual = zVol - expectedZVol
signal = ta.sma(rawResidual, smoothOutput)

// --- Plotting ---
sigCol = signal < -1 ? color.red : signal < 0 ? color.orange : signal > 1 ? color.green : color.gray
plot(signal, "Volume Divergence", color=sigCol, linewidth=2)

// Bands & Zero Line
hline(0, "Zero Line", color=color.white, linestyle=hline.style_solid)
plot(showBands ? 1 : na, "Upper Band", color=color.new(color.green, 50), style=plot.style_linebr)
plot(showBands ? -1 : na, "Lower Band", color=color.new(color.red, 50), style=plot.style_linebr)

// --- Dashboard Label ---
var table panel = table.new(position.top_right, 4, 1, bgcolor=color.new(color.black, 70), border_width=1)
if barstate.islast
    table.cell(panel, 0, 0, "VolDiv: " + str.tostring(signal, "#.##"), text_color=sigCol)
