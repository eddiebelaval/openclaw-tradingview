//@version=6
indicator(title="4EMA+RSI+BuySell+Diverg+NWE+Bollinger Megart", shorttitle = "4EMA+Adv", overlay=true, max_lines_count = 500, max_labels_count = 500, max_bars_back=500)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EMA
len1 = input.int(10, minval=1, title="EMA 1/1 Short")
len2 = input.int(20, minval=1, title="EMA 2/1 Long")
len3 = input.int(50, minval=1, title="EMA 1/2 Short")
len4 = input.int(200, minval=1, title="EMA 2/2 Long")

shortest = ta.ema(close, len1)
short    = ta.ema(close, len2)
longer   = ta.ema(close, len3)
longest  = ta.ema(close, len4)

plot(shortest, color = color.red)
plot(short,    color = color.blue)
plot(longer,   color = color.red,  linewidth = 2)
plot(longest,  color = color.blue, linewidth = 2)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Buyers / Sellers
bayerAndSellerShow = input.bool(true, "Show Bayer & Seller Change Signals")
length     = input.int(80, "Length")
rawlength  = input.int(20, "Raw Length")
Barcolor   = input.bool(false, title="Force Barcolor")
diffcolorsBuyers  = input.color(color.rgb(14, 88, 66), "Color of Buyers Arrow")
diffcolorsSellers = input.color(color.rgb(145, 4, 4), "Color of Sellers Arrow")
difflast = 0.0

if bayerAndSellerShow
    sp  = high - close
    bp  = close - low
    sp1 = high[1] - close[1]
    bp1 = close[1] - low[1]

    bpavg  = ta.ema(bp, length)
    spavg  = ta.ema(sp, length)
    bpavg1 = ta.ema(bp1, length)
    spavg1 = ta.ema(sp1, length)

    nbp  = bp / bpavg
    nsp  = sp / spavg
    nbp1 = bp1 / bpavg1
    nsp1 = sp1 / spavg1

    Varg  = ta.ema(volume, length)
    nv    = volume / Varg
    nbf   = ta.ema(nbp * nv, rawlength)
    nsf   = ta.ema(nsp * nv, rawlength)

    Varg1 = ta.ema(volume[1], length)
    nv1   = volume[1] / Varg1
    nbf1  = ta.ema(nbp1 * nv1, rawlength)
    nsf1  = ta.ema(nsp1 * nv1, rawlength)

    diffs  = nbf - nsf
    diffs1 = nbf1 - nsf1

    if (diffs >= 0 and diffs1 < 0) or (diffs <= 0 and diffs1 > 0)
        difflast := diffs

plotarrow(difflast, colorup=diffcolorsBuyers, colordown=diffcolorsSellers)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RSI
rsiLengthInput = input.int(14, minval=1, title="RSI Length", group="RSI Settings")
rsiHighLevel   = input.int(80, minval=1, title="RSI High Level", group="RSI Settings")
rsiLowLevel    = input.int(20, minval=1, title="RSI Low Level", group="RSI Settings")
rsiHighLevel2  = input.int(70, minval=1, title="RSI High Level", group="RSI Settings")
rsiLowLevel2   = input.int(30, minval=1, title="RSI Low Level", group="RSI Settings")
rsiSourceInput = input.source(close, "Source", group="RSI Settings")
rsiLowShow     = input.bool(false, "Show RSI Low Level (70, 30) Signal")
rsiHighShow    = input.bool(true,  "Show RSI High Level (80, 20) Signal")
calculateRSIBuySell = input.bool(true, title="Calculate RSI Buy and Sell", group="RSI Settings", display=display.data_window)

rsiSourceInput1 = close[1]

change = ta.change(rsiSourceInput)
up     = ta.rma(math.max(change, 0), rsiLengthInput)
down   = ta.rma(-math.min(change, 0), rsiLengthInput)
rsi    = down == 0 ? 100 : up == 0 ? 0 : 100 - (100 / (1 + up / down))

change1 = calculateRSIBuySell ? ta.change(rsiSourceInput1) : 0
up1     = calculateRSIBuySell ? ta.rma(math.max(change1, 0), rsiLengthInput) : 0
down1   = calculateRSIBuySell ? ta.rma(-math.min(change1, 0), rsiLengthInput) : 0
rsi1    = calculateRSIBuySell ? down1 == 0 ? 100 : up1 == 0 ? 0 : 100 - (100 / (1 + up1 / down1)) : 0

// Divergence (как у тебя)
calculateDivergence = input.bool(false, title="Calculate Divergence", group="RSI Settings", display=display.data_window)

_inRange(bool cond) =>
    bars = ta.barssince(cond)
    5 <= bars and bars <= 60

if calculateDivergence
    lookbackRight = 5
    lookbackLeft  = 5

    plFound = false
    phFound = false

    bullCond = false
    bearCond = false

    rsiLBR = rsi[lookbackRight]

    plFound := not na(ta.pivotlow(rsi, lookbackLeft, lookbackRight))
    rsiHL = rsiLBR > ta.valuewhen(plFound, rsiLBR, 1) and _inRange(plFound[1])
    lowLBR = low[lookbackRight]
    priceLL = lowLBR < ta.valuewhen(plFound, lowLBR, 1)
    bullCond := priceLL and rsiHL and plFound

    phFound := not na(ta.pivothigh(rsi, lookbackLeft, lookbackRight))
    rsiLH = rsiLBR < ta.valuewhen(phFound, rsiLBR, 1) and _inRange(phFound[1])
    highLBR = high[lookbackRight]
    priceHH = highLBR > ta.valuewhen(phFound, highLBR, 1)
    bearCond := priceHH and rsiLH and phFound

    if bearCond
        label.new(bar_index[lookbackRight], high[lookbackRight], text="Bear (" + str.tostring(math.round(rsiLBR)) + ")", style=label.style_label_lower_right, color=color.red)
    if bullCond
        label.new(bar_index[lookbackRight], low[lookbackRight],  text="Bull (" + str.tostring(math.round(rsiLBR)) + ")", style=label.style_label_upper_right, color=color.green)

// RSI labels (как у тебя, без изменений)
if rsi >= rsiHighLevel
    if rsi1 < rsiHighLevel and rsi >= rsiHighLevel and calculateRSIBuySell and rsiHighShow
        label.new(bar_index, high, text="RSI > " + str.tostring(rsiHighLevel), style=label.style_label_lower_right, color=color.new(color.green, 80))
else
    if rsi1 < rsiHighLevel2 and rsi >= rsiHighLevel2 and calculateRSIBuySell and rsiLowShow
        label.new(bar_index, high, text="RSI > " + str.tostring(rsiHighLevel2), style=label.style_label_lower_right, color=color.new(color.green, 80))

if rsi <= rsiLowLevel
    if rsi1 > rsiLowLevel and rsi <= rsiLowLevel and calculateRSIBuySell and rsiHighShow
        label.new(bar_index, low, text="RSI < " + str.tostring(rsiLowLevel), style=label.style_label_upper_right, color=color.new(color.red, 80))
else
    if rsi1 > rsiLowLevel2 and rsi <= rsiLowLevel2 and calculateRSIBuySell and rsiLowShow
        label.new(bar_index, low, text="RSI < " + str.tostring(rsiLowLevel2), style=label.style_label_upper_right, color=color.new(color.red, 80))

if rsi1 > rsiHighLevel
    if rsi1 > rsiHighLevel and rsi <= rsiHighLevel and calculateRSIBuySell and rsiHighShow
        label.new(bar_index, high, text="RSI " + str.tostring(rsiHighLevel) + " Sell", style=label.style_label_down, color=color.new(color.red, 80))
else
    if rsi1 > rsiHighLevel2 and rsi <= rsiHighLevel2 and calculateRSIBuySell and rsiLowShow
        label.new(bar_index, high, text="RSI " + str.tostring(rsiHighLevel2) + " Sell", style=label.style_label_down, color=color.new(color.red, 80))

if rsi1 <= rsiLowLevel
    if rsi1 <= rsiLowLevel and rsi > rsiLowLevel and calculateRSIBuySell and rsiHighShow
        label.new(bar_index, low, text="RSI " + str.tostring(rsiLowLevel) + " Buy", style=label.style_label_up, color=color.new(color.green, 80))
else
    if rsi1 <= rsiLowLevel2 and rsi > rsiLowLevel2 and calculateRSIBuySell and rsiLowShow
        label.new(bar_index, low, text="RSI " + str.tostring(rsiLowLevel2) + " Buy", style=label.style_label_up, color=color.new(color.green, 80))

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Bollinger (как у тебя)
bbAdvancedShow = input(true, title="Show Bollinger Bands Advanced")
bb_use_ema = input(false, title="Use EMA for Bollinger Band")
bb_filter = input(false, title="Filter Buy/Sell with Bollinger Bands")
sqz_filter = input(false, title="Flter Buy/Sell with BB squeeze")
bb_length = input.int(20, minval=1, title="Bollinger Length")
bb_source = input(close, title="Bollinger Source")
bb_mult = input.float(2.0, title="Base Multiplier", minval=0.5, maxval=10)
fast_ma_len = input.int(3, title="Fast EMA length", minval=2)

nLengthSlow = input.int(34, minval=1, title="Awesome Length Slow")
nLengthFast = input.int(5,  minval=1, title="Awesome Length Fast")

sqz_length = input.int(100, "BB Relative Squeeze Length", minval=5)
sqz_threshold = input.int(50, "BB Squeeze Threshold %", maxval=99, step=5)

ema_1 = ta.ema(bb_source, bb_length)
sma_1 = ta.sma(bb_source, bb_length)
bb_basis = bb_use_ema ? ema_1 : sma_1

dev = ta.stdev(bb_source, bb_length)
bb_dev = bb_mult * dev

bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev

xSMA1_hl2 = ta.sma(hl2, nLengthFast)
xSMA2_hl2 = ta.sma(hl2, nLengthSlow)
xSMA1_SMA2 = xSMA1_hl2 - xSMA2_hl2

AO = xSMA1_SMA2 >= 0 ? xSMA1_SMA2 > xSMA1_SMA2[1] ? 1 : 2 :
     xSMA1_SMA2 > xSMA1_SMA2[1] ? -1 : -2

spread = bb_upper - bb_lower
avgspread = ta.sma(spread, sqz_length)
bb_squeeze = spread / avgspread * 100

bb_offset = ta.atr(14) * 0.5
bb_sqz_upper = bb_upper + bb_offset
bb_sqz_lower = bb_lower - bb_offset

ubi = plot(bb_upper, title="Upper Band Inner", color=color.new(color.blue, 100), linewidth=1)
lbi = plot(bb_lower, title="Lower Band Inner", color=color.new(color.blue, 100), linewidth=1)
usqzi = plot(bb_sqz_upper, "Hide Sqz Upper", color.new(color.white, 100))
lsqzi = plot(bb_sqz_lower, "Hide Sqz Lower", color.new(color.white, 100))
fill(ubi, usqzi, color=bb_squeeze > sqz_threshold ? color.new(color.white, 100) : color.new(color.blue, 50))
fill(lbi, lsqzi, color=bb_squeeze > sqz_threshold ? color.new(color.white, 100) : color.new(color.blue, 50))

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// NWE (ПЕРЕДЕЛАНО)
// Settings
h = input.float(8.,'Bandwidth', minval = 0)
mult = input.float(3., minval = 0)
src = input(close, 'Source')

repaint = input(true, 'Repainting Smoothing', tooltip = 'Repainting is an effect where the indicators historical output is subject to change over time. Disabling repainting will cause the indicator to output the endpoints of the calculations')

//Style
upCss = input.color(color.teal, 'Colors', inline = 'inline1', group = 'Style')
dnCss = input.color(color.red, '', inline = 'inline1', group = 'Style')

//-----------------------------------------------------------------------------}
//Functions
//-----------------------------------------------------------------------------{
//Gaussian window
gauss(x, h) => math.exp(-(math.pow(x, 2)/(h * h * 2)))

//-----------------------------------------------------------------------------}
//Append lines
//-----------------------------------------------------------------------------{
n = bar_index

var ln = array.new_line(0) 

if barstate.isfirst and repaint
    for i = 0 to 499
        array.push(ln,line.new(na,na,na,na))

//-----------------------------------------------------------------------------}
//End point method
//-----------------------------------------------------------------------------{
var coefs = array.new_float(0)
var den = 0.

if barstate.isfirst and not repaint
    for i = 0 to 499
        w = gauss(i, h)
        coefs.push(w)

    den := coefs.sum()

out = 0.
if not repaint
    for i = 0 to 499
        out += src[i] * coefs.get(i)
out /= den
mae = ta.sma(math.abs(src - out), 499) * mult

upper = out + mae
lower = out - mae
 
//-----------------------------------------------------------------------------}
//Compute and display NWE
//-----------------------------------------------------------------------------{
float y2 = na
float y1 = na

nwe = array.new<float>(0)
if barstate.islast and repaint
    sae = 0.
    //Compute and set NWE point 
    for i = 0 to math.min(499,n - 1)
        sum = 0.
        sumw = 0.
        //Compute weighted mean 
        for j = 0 to math.min(499,n - 1)
            w = gauss(i - j, h)
            sum += src[j] * w
            sumw += w

        y2 := sum / sumw
        sae += math.abs(src[i] - y2)
        nwe.push(y2)
    
    sae := sae / math.min(499,n - 1) * mult
    for i = 0 to math.min(499,n - 1)
        if (i % 2) != 0
            line.new(n-i+1, y1 + sae, n-i, nwe.get(i) + sae, color = upCss)
            line.new(n-i+1, y1 - sae, n-i, nwe.get(i) - sae, color = dnCss)
        
        if src[i] > nwe.get(i) + sae and src[i+1] < nwe.get(i) + sae
            label.new(n-i, src[i], '▼', color = color(na), style = label.style_label_down, textcolor = dnCss, textalign = text.align_center, size = size.huge)
        if src[i] < nwe.get(i) - sae and src[i+1] > nwe.get(i) - sae
            label.new(n-i, src[i], '▲', color = color(na), style = label.style_label_up, textcolor = upCss, textalign = text.align_center, size = size.huge)
        
        y1 := nwe.get(i)

//-----------------------------------------------------------------------------}
//Dashboard
//-----------------------------------------------------------------------------{
var tb = table.new(position.top_right, 1, 1
  , bgcolor = #1e222d
  , border_color = #373a46
  , border_width = 1
  , frame_color = #373a46
  , frame_width = 1)

if repaint
    tb.cell(0, 0, 'Repainting Mode Enabled', text_color = color.white, text_size = size.small)

//-----------------------------------------------------------------------------}
//Plot
//-----------------------------------------------------------------------------}
plot(repaint ? na : out + mae, 'Upper', upCss)
plot(repaint ? na : out - mae, 'Lower', dnCss)

//Crossing Arrows
plotshape(ta.crossunder(close, out - mae) ? low : na, "Crossunder", shape.labelup, location.absolute, color(na), 0 , text = '▲', textcolor = upCss, size = size.tiny)
plotshape(ta.crossover(close, out + mae) ? high : na, "Crossover", shape.labeldown, location.absolute, color(na), 0 , text = '▼', textcolor = dnCss, size = size.tiny)

//-----------------------------------------------------------------------------}
