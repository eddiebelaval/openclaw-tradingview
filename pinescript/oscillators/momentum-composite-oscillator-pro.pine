//@version=5
indicator("Momentum Composite Oscillator Pro", shorttitle="MCO Pro", overlay=false, max_labels_count=500)

//----------------------------------------------------
// Inputs
//----------------------------------------------------
groupGeneral = "General"
rsiLen = input.int(14, "RSI Length", minval=2, group=groupGeneral)
rocLen = input.int(14, "ROC Length", minval=2, group=groupGeneral)
macdFast = input.int(12, "MACD Fast", minval=1, group=groupGeneral)
macdSlow = input.int(26, "MACD Slow", minval=2, group=groupGeneral)
macdSignal = input.int(9, "MACD Signal", minval=1, group=groupGeneral)
normLookback = input.int(100, "Normalization Lookback", minval=20, group=groupGeneral)
smoothLen = input.int(8, "Composite Smoothing", minval=1, group=groupGeneral)
signalLen = input.int(5, "Signal Length", minval=1, group=groupGeneral)

groupWeights = "Weights"
wRSI = input.float(1.25, "Weight: RSI", minval=0.0, step=0.25, group=groupWeights)
wMACD = input.float(1.50, "Weight: MACD", minval=0.0, step=0.25, group=groupWeights)
wROC = input.float(1.00, "Weight: ROC", minval=0.0, step=0.25, group=groupWeights)

groupLevels = "Levels"
upperBand = input.float(65.0, "Upper Band", minval=50.0, maxval=100.0, step=0.5, group=groupLevels)
lowerBand = input.float(35.0, "Lower Band", minval=0.0, maxval=50.0, step=0.5, group=groupLevels)
midLine = input.float(50.0, "Midline", minval=0.0, maxval=100.0, step=0.5, group=groupLevels)

groupDisplay = "Display"
showHistogram = input.bool(true, "Show Momentum Histogram", group=groupDisplay)
showSignals = input.bool(true, "Show Cross Signals", group=groupDisplay)
showBarColor = input.bool(false, "Color Price Bars", group=groupDisplay)
showBg = input.bool(true, "Background Regime Shading", group=groupDisplay)

//----------------------------------------------------
// Helpers
//----------------------------------------------------
clamp(val, minVal, maxVal) =>
    math.max(minVal, math.min(maxVal, val))

normalizeTo100(src, lookback) =>
    hi = ta.highest(src, lookback)
    lo = ta.lowest(src, lookback)
    rng = hi - lo
    rng != 0 ? 100 * (src - lo) / rng : 50

//----------------------------------------------------
// Raw Components
//----------------------------------------------------
// RSI already lives on a 0-100 scale
rsiVal = ta.rsi(close, rsiLen)

// MACD normalized into 0-100 using rolling min/max
macdLine = ta.ema(close, macdFast) - ta.ema(close, macdSlow)
macdNorm = normalizeTo100(macdLine, normLookback)

// ROC normalized into 0-100 using rolling min/max
rocRaw = ta.roc(close, rocLen)
rocNorm = normalizeTo100(rocRaw, normLookback)

//----------------------------------------------------
// Composite
//----------------------------------------------------
weightSum = wRSI + wMACD + wROC

rawComposite = 50.0
if weightSum > 0
    rawComposite := (rsiVal * wRSI + macdNorm * wMACD + rocNorm * wROC) / weightSum

composite = ta.ema(rawComposite, smoothLen)
signal = ta.ema(composite, signalLen)
hist = composite - signal

//----------------------------------------------------
// Regime Logic
//----------------------------------------------------
bullStrong = composite >= upperBand and composite > signal
bullMild = composite >= midLine and composite < upperBand and composite > signal
bearStrong = composite <= lowerBand and composite < signal
bearMild = composite < midLine and composite > lowerBand and composite < signal
neutral = not bullStrong and not bullMild and not bearStrong and not bearMild

crossUp = ta.crossover(composite, signal)
crossDown = ta.crossunder(composite, signal)

//----------------------------------------------------
// Colors
//----------------------------------------------------
lineColor =
     bullStrong ? color.lime :
     bullMild ? color.green :
     bearStrong ? color.red :
     bearMild ? color.orange :
     color.gray

signalColor = color.new(color.white, 0)

histColor =
     hist >= 0 and hist > hist[1] ? color.lime :
     hist >= 0 ? color.green :
     hist < 0 and hist < hist[1] ? color.red :
     color.orange

bgColor =
     bullStrong ? color.new(color.lime, 90) :
     bullMild ? color.new(color.green, 93) :
     bearStrong ? color.new(color.red, 90) :
     bearMild ? color.new(color.orange, 93) :
     color.new(color.gray, 95)

//----------------------------------------------------
// Plots
//----------------------------------------------------
hUpper = hline(upperBand, "Upper Band", color=color.new(color.gray, 40))
hMid = hline(midLine, "Midline", color=color.new(color.gray, 55))
hLower = hline(lowerBand, "Lower Band", color=color.new(color.gray, 40))

plot(composite, "Composite", color=lineColor, linewidth=3)
plot(signal, "Signal", color=signalColor, linewidth=2)

plot(showHistogram ? hist : na, "Histogram", style=plot.style_columns, color=histColor)

plotshape(showSignals and crossUp ? composite : na, title="Bullish Cross", style=shape.circle, location=location.absolute, size=size.tiny, color=color.lime, text="▲")
plotshape(showSignals and crossDown ? composite : na, title="Bearish Cross", style=shape.circle, location=location.absolute, size=size.tiny, color=color.red, text="▼")

bgcolor(showBg ? bgColor : na)

barcolor(showBarColor ? (
     bullStrong ? color.lime :
     bullMild ? color.green :
     bearStrong ? color.red :
     bearMild ? color.orange :
     na) : na)

//----------------------------------------------------
// Alerts
//----------------------------------------------------
alertcondition(crossUp, "Bullish Cross", "Momentum Composite Oscillator bullish cross")
alertcondition(crossDown, "Bearish Cross", "Momentum Composite Oscillator bearish cross")
alertcondition(composite > upperBand, "Above Upper Band", "Momentum Composite Oscillator moved above upper band")
alertcondition(composite < lowerBand, "Below Lower Band", "Momentum Composite Oscillator moved below lower band")
