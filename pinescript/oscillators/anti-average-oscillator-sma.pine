//@version=6
indicator("Anti-Average Oscillator (SMA)", overlay=false)

// ==== Inputs ====
maLength = input.int(50, "SMA Length")

// ==== Simple Moving Average ====
smaValue = ta.sma(close, maLength)

// ==== Anti-Average Oscillator ====
antiAvgOsc = close - smaValue

// ==== Plotting ====
plot(antiAvgOsc, color=color.blue, title="Anti-Average Oscillator", linewidth=2)
hline(0, "Zero Line", color=color.black)
