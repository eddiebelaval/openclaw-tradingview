//@version=6
indicator("Mean Reversion Opportunity 2.0", shorttitle="MRO 2.0", overlay=false)

// ─────────────────────────────────────────────────────────────────────────────
//  MRO 2.0 — Adaptive Mean Reversion Oscillator
//  Same clean look as MRO 1.0, smarter math under the hood
// ─────────────────────────────────────────────────────────────────────────────

// Settings
totalLength  = input.int(30, "Total Lookback Length", minval=3, maxval=500)
smoothLen    = input.int(8, "Smoothing Length", minval=1, maxval=30, tooltip="EMA smoothing on the raw signal. Higher = smoother, stays near center longer.")
adaptLen     = input.int(50, "Adaptive Normalization Length", minval=10, maxval=200, tooltip="Rolling window for percentile-based normalization. This is what keeps it compressed during chop.")
showMidline  = input.bool(true, "Show 0% Midline")

// ─────────────────────────────────────────────────────────────────────────────
//  STEP 1: Original MRO range calculation
// ─────────────────────────────────────────────────────────────────────────────
rangeLength     = math.floor(totalLength / 3)
actualRangeHigh = ta.highest(high[totalLength - rangeLength], rangeLength)
actualRangeLow  = ta.lowest(low[totalLength - rangeLength], rangeLength)
rangeMid        = (actualRangeHigh + actualRangeLow) / 2
rangeSize       = actualRangeHigh - actualRangeLow
rawPosition     = rangeSize != 0 ? ((close - rangeMid) / rangeSize) * 400 : 0

// ─────────────────────────────────────────────────────────────────────────────
//  STEP 2: Smooth the raw signal to kill noise
// ─────────────────────────────────────────────────────────────────────────────
smoothed = ta.ema(rawPosition, smoothLen)

// ─────────────────────────────────────────────────────────────────────────────
//  STEP 3: Adaptive normalization using rolling percentile rank
//  
//  Instead of fixed scaling, we rank the current value against its own
//  recent history. During chop, moves look average → compressed toward 0.
//  During a real trend, the value becomes an outlier → pushed to ±200.
//  This is the core innovation — the indicator self-calibrates to regime.
// ─────────────────────────────────────────────────────────────────────────────
pctRank = ta.percentrank(smoothed, adaptLen)  // 0 to 100

// Convert percentile to -200 to +200 scale
// 50th percentile = 0 (center), 100th = +200, 0th = -200
normalized = (pctRank - 50) * 4  // maps 0-100 → -200 to +200

// ─────────────────────────────────────────────────────────────────────────────
//  STEP 4: Volatility-weighted blending
//  
//  Low volatility → lean on the normalized (compressed) signal
//  High volatility → let more of the raw signal through
//  This creates the "breakout" effect naturally without binary gates
// ─────────────────────────────────────────────────────────────────────────────
atrVal    = ta.atr(14)
atrPct    = ta.percentrank(atrVal, adaptLen) / 100.0  // 0 to 1

// Blend weight: in calm markets mostly normalized, in volatile markets more raw
// Squared so the transition is smooth — stays compressed until vol really pops
volWeight = math.pow(atrPct, 2.0)

// Clamp the raw smoothed signal to ±300 so blending doesn't create spikes
rawClamped = math.max(-300, math.min(300, smoothed))

// Final blend
blended = normalized * (1 - volWeight) + rawClamped * volWeight

// One final light smooth to prevent any jitter from the blend
finalSig = ta.ema(blended, 3)

// ─────────────────────────────────────────────────────────────────────────────
//  PLOT — Same clean look as MRO 1.0
// ─────────────────────────────────────────────────────────────────────────────
plot(finalSig, "MRO 2.0", color=color.black, linewidth=2)

topLine    = hline(200, "Range High", color=color.new(#000080, 0), linestyle=hline.style_solid, linewidth=2)
bottomLine = hline(-200, "Range Low", color=color.new(#000080, 0), linestyle=hline.style_solid, linewidth=2)
hline(0, "Midline", color=showMidline ? color.gray : na, linestyle=hline.style_dashed, linewidth=1)

fill(topLine, bottomLine, color=color.new(#87CEEB, 80))
