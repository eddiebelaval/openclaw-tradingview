//@version=6
indicator("KDE Reversals [UAlgo]", overlay=false)

type KDEData
    array<float> prices
    int length

erf(float x) =>
    float sign = math.sign(x)
    float x_abs = math.abs(x)
    float a1 =  0.254829592
    float a2 = -0.284496736
    float a3 =  1.421413741
    float a4 = -1.453152027
    float a5 =  1.061405429
    float p  =  0.3275911
    float t = 1.0 / (1.0 + p * x_abs)
    float y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * math.exp(-x_abs * x_abs)
    sign * y

norm_cdf(float z) =>
    float sqrt2 = math.sqrt(2)
    0.5 * (1.0 + erf(z / sqrt2))

method update(KDEData this, float val) =>
    this.prices.push(val)
    if this.prices.size() > this.length
        this.prices.shift()

method get_iqr(KDEData this) =>
    int n = this.prices.size()
    if n < 4
        0.0
    else
        array<float> sorted = array.copy(this.prices)
        sorted.sort()
        int q1_idx = int(math.floor(n * 0.25))
        int q3_idx = int(math.floor(n * 0.75))
        sorted.get(q3_idx) - sorted.get(q1_idx)

method get_kde_cdf(KDEData this, float current_price) =>
    int n = this.prices.size()
    if n < 2
        50.0
    else
        float stdev = this.prices.stdev()
        float iqr = this.get_iqr()
        float spread = math.min(stdev, iqr / 1.34)
        if spread == 0
            spread := stdev != 0 ? stdev : 0.0001
        float h = 1.06 * spread * math.pow(n, -0.2)
        if h == 0
            h := 0.0001
        float sum_prob = 0.0
        for i = 0 to n - 1
            float xi = this.prices.get(i)
            float z = (current_price - xi) / h
            sum_prob += norm_cdf(z)
        (sum_prob / n) * 100.0

int lengthInput = input.int(100, "Lookback Window (N)", minval=20, maxval=500, group="KDE Parameters")
float srcInput  = input.source(close, "Source", group="KDE Parameters")

float upperThreshold = input.float(95.0, "Upper Reversal Zone (%)", minval=50.0, maxval=99.9, step=0.5, group="Statistical Reversal Zones")
float lowerThreshold = input.float(5.0, "Lower Reversal Zone (%)", minval=0.1, maxval=50.0, step=0.5, group="Statistical Reversal Zones")

bool showLabels = input.bool(true, "Show Reversal Labels", group="Style & Labels")

var KDEData kde = KDEData.new(array.new<float>(), lengthInput)

kde.update(srcInput)

float cdf_percent = na

if kde.prices.size() == lengthInput
    cdf_percent := kde.get_kde_cdf(srcInput)

color col_bull = #21ce99
color col_bear = #f7525f
color col_mid  = #787b86

color cdfColor = color.from_gradient(cdf_percent, lowerThreshold, upperThreshold, col_bull, col_bear)

p_cdf = plot(cdf_percent, "Empirical CDF (KDE)", cdfColor, 2)
p_mid = plot(50, "Median", color.new(color.gray, 100), display=display.none)

fill(p_cdf, p_mid, top_value=100, bottom_value=50, top_color=color.new(col_bear, 30), bottom_color=color.new(col_bear, 100), title="Upper Gradient")
fill(p_cdf, p_mid, top_value=50, bottom_value=0, top_color=color.new(col_bull, 100), bottom_color=color.new(col_bull, 30), title="Lower Gradient")

hline(50, "Center Line", color.new(color.gray, 70), hline.style_dotted)
hline(upperThreshold, "Upper Threshold", color.new(col_bear, 30), hline.style_dashed)
hline(lowerThreshold, "Lower Threshold", color.new(col_bull, 30), hline.style_dashed)

bgcolor(cdf_percent >= upperThreshold ? color.new(col_bear, 90) : cdf_percent <= lowerThreshold ? color.new(col_bull, 90) : na)

bool sellTrigger = ta.crossunder(cdf_percent, upperThreshold)
bool buyTrigger  = ta.crossover(cdf_percent, lowerThreshold)

if showLabels and sellTrigger
    label.new(bar_index, cdf_percent + 3, "▼", color=na, style=label.style_none, textcolor=col_bear, size=size.normal)

if showLabels and buyTrigger
    label.new(bar_index, cdf_percent - 3, "▲", color=na, style=label.style_none, textcolor=col_bull, size=size.normal)
