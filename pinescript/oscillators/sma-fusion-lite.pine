//@version=6
indicator("SMA Fusion Lite", overlay=true)

// INPUTS
smaLength  = input.int(9, "SMA Length", minval=1)
rsiLength  = input.int(14, "RSI Length")
adxLength  = input.int(14, "ADX Length")
chopLength = input.int(14, "Choppiness Length")

// CORE
sma = ta.sma(close, smaLength)
rsi = ta.rsi(close, rsiLength)
[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)

// ADX (manual)
upMove   = high - high[1]
downMove = low[1] - low

plusDM  = (upMove > downMove and upMove > 0) ? upMove : 0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0

trur = ta.rma(ta.tr(true), adxLength)

plusDI  = 100 * ta.rma(plusDM, adxLength) / trur
minusDI = 100 * ta.rma(minusDM, adxLength) / trur

dx  = (plusDI + minusDI != 0) ? 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI) : 0
adx = ta.rma(dx, adxLength)

// CHOPPY
tr    = ta.tr(true)
sumTR = math.sum(tr, chopLength)
hh    = ta.highest(high, chopLength)
ll    = ta.lowest(low, chopLength)

priceRange = hh - ll
chop = priceRange != 0 ? 100 * math.log10(sumTR / priceRange) / math.log10(chopLength) : 100

// SCORE
score = 0
score += close > sma ? 2 : -2
score += rsi > 55 ? 1 : rsi < 45 ? -1 : 0
score += macdLine > signalLine ? 1 : -1
score += adx > 20 ? 1 : 0
score += chop > 60 ? -1 : 0

// STATES
strongBull = score >= 4
bull       = score >= 2 and score < 4
neutral    = score > -2 and score < 2
bear       = score <= -2 and score > -4
strongBear = score <= -4

// SMA STYLE
smaColor = strongBull ? color.aqua : bull ? color.green : neutral ? color.gray : bear ? color.red : color.maroon
smaWidth = (strongBull or strongBear) ? 3 : (bull or bear) ? 2 : 1

plot(sma, color=smaColor, linewidth=2)

//----------------------------------------------------
// SMART SCORE POSITION (UPGRADED)
//----------------------------------------------------
var label scoreLabel = na

// Color based on strength
labelColor = score >= 3 ? color.green :
             score <= -3 ? color.red :
             color.gray

// Position above/below candle with offset
offset = ta.atr(14) * 0.2
yPos = score >= 0 ? high + offset : low - offset

if barstate.islast
    if not na(scoreLabel)
        label.delete(scoreLabel)
    scoreLabel := label.new(
         bar_index,
         yPos,
         str.tostring(score),
         style=label.style_label_center,
         textcolor=color.white,
         color=color.new(labelColor, 0),
         size=size.normal)

// CHOPPY DOTS
isChoppy = adx < 20 and chop > 60
plotshape(isChoppy, location=location.abovebar, style=shape.circle, size=size.tiny, color=color.blue)
plotshape(isChoppy, location=location.belowbar, style=shape.circle, size=size.tiny, color=color.blue)

//----------------------------------------------------
// STRICT TREND FILTERED SIGNALS
//----------------------------------------------------
buyCondition  = score >= 3 and close > sma and low > sma and macdLine > signalLine and not isChoppy
sellCondition = score <= -3 and close < sma and high < sma and macdLine < signalLine and not isChoppy

// Anti-spam
buySignal  = buyCondition and not buyCondition[1]
sellSignal = sellCondition and not sellCondition[1]

//----------------------------------------------------
// PLOT ARROWS
//----------------------------------------------------
plotshape(buySignal,  location=location.belowbar, style=shape.triangleup,   size=size.small, color=color.lime)
plotshape(sellSignal, location=location.abovebar, style=shape.triangledown, size=size.small, color=color.red)

//----------------------------------------------------
// OPTIONAL CLEAN LABELS
//----------------------------------------------------
if buySignal and barstate.islast
    label.new(bar_index, low, "BUY", style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.small)

if sellSignal and barstate.islast
    label.new(bar_index, high, "SELL", style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
