//@version=5
indicator("MTF RSI Trend Scalper: Daily Filtered", overlay=true)

// Параметры для RSI
rsiLength = input(14, title="RSI Length")

// Рассчитываем RSI на дневном таймфрейме
rsiDaily = request.security(syminfo.tickerid, "D", ta.rsi(close, rsiLength))

// Рассчитываем RSI на часовом таймфрейме
rsiHourly = ta.rsi(close, rsiLength)

// Условия для входа в лонг
longCondition = (rsiDaily > 60) and (rsiHourly < 20)

// Условия для входа в шорт
shortCondition = (rsiDaily < 40) and (rsiHourly > 80)

// Отображаем сигналы на графике
plotshape(series=longCondition, location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small, title="Long Signal", text="L")
plotshape(series=shortCondition, location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small, title="Short Signal", text="S")

// Добавляем метки для визуализации сигналов
if (longCondition)
    label.new(bar_index, low, text="LONG", color=color.green, style=label.style_label_up, textcolor=color.white)
if (shortCondition)
    label.new(bar_index, high, text="SHORT", color=color.red, style=label.style_label_down, textcolor=color.white)
