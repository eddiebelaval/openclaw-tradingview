//@version=6
indicator("Trend RSI x TRIX Candles (VIVID) + Trend Ribbon", overlay=true, max_labels_count=200)

//==============================
// Inputs
//==============================
grp1 = "RSI Trend Core"
rsiLen   = input.int(20, "RSI Length", minval=1, group=grp1)
src      = input.source(close, "Source", group=grp1)

grp2 = "RSI Smoothing"
maLen    = input.int(10, "RSI MA Length", minval=1, group=grp2)
maType   = input.string("RMA", "RSI MA Type", options=["SMA","EMA","RMA","WMA"], group=grp2)

grp3 = "RSI Trend (SuperTrend-like on RSI)"
atrLen   = input.int(14, "ATR Len (on RSI)", minval=1, group=grp3)
factor   = input.float(4.0, "Factor", step=0.1, group=grp3)
baseMode = input.string("RSI MA", "Base", options=["RSI","RSI MA"], group=grp3)

grpT = "TRIX Filter"
trixLen      = input.int(9, "TRIX Length", minval=1, group=grpT)
trixSlopeLen = input.int(1, "TRIX slope lookback (bars)", minval=1, maxval=10, group=grpT)
flatTh       = input.float(0.0, "TRIX flat threshold", step=0.0001, group=grpT)

grpV = "Trend Ribbon / Guide Line"
showRibbon   = input.bool(true, "Show Trend Ribbon", group=grpV)
ribbonFast   = input.int(21, "Ribbon Fast EMA", minval=1, group=grpV)
ribbonSlow   = input.int(55, "Ribbon Slow EMA", minval=1, group=grpV)
ribbonTransp = input.int(80, "Ribbon Transparency (0-100)", minval=0, maxval=100, group=grpV)

showGuideLine = input.bool(true, "Show Guide Line (EMA)", group=grpV)
guideLen      = input.int(34, "Guide EMA Length", minval=1, group=grpV)
guideWidth    = input.int(2, "Guide Line Width", minval=1, maxval=6, group=grpV)

grpCol = "Candle Colors (VIVID)"
// 強色：思い切り発色（ネオン寄り）
colStrongBull = input.color(color.rgb(0, 220, 255), "Strong Bull (RSI↑ + TRIX↑)", group=grpCol)
colStrongBear = input.color(color.rgb(255, 0, 110), "Strong Bear (RSI↓ + TRIX↓)", group=grpCol)

// ミスマッチ：薄色だけど“別色”で識別（透明度ではなく色味で差を出す）
colWeakBull   = input.color(color.rgb(0, 150, 210), "Mismatch Bull (RSI↑ only)", group=grpCol)
colWeakBear   = input.color(color.rgb(210, 80, 140),"Mismatch Bear (RSI↓ only)", group=grpCol)

// ニュートラル
colNeutral    = input.color(color.rgb(120, 120, 140), "Neutral", group=grpCol)

// 透明度（vividなので下げる＝濃くする）
weakTransp = input.int(25, "Mismatch transparency (0-100)", minval=0, maxval=100, group=grpCol)
neuTransp  = input.int(75, "Neutral transparency (0-100)", minval=0, maxval=100, group=grpCol)

// Wick / Border
wickAsBody   = input.bool(true, "Wicks same as body color", group=grpCol)
borderAsBody = input.bool(true, "Border same as body color", group=grpCol)
wickNeutral  = input.color(color.white, "Wick color if not same as body", group=grpCol)
bordNeutral  = input.color(color.white, "Border color if not same as body", group=grpCol)

grpDisp = "Display"
hideOriginalCandles = input.bool(true, "Hide original candles (use plotcandle)", group=grpDisp)

//==============================
// Helpers
//==============================
f_ma(_x, _len, _type) =>
    switch _type
        "SMA" => ta.sma(_x, _len)
        "EMA" => ta.ema(_x, _len)
        "RMA" => ta.rma(_x, _len)
        => ta.wma(_x, _len)

//==============================
// Core (TrendRSI)
//==============================
rsi    = ta.rsi(src, rsiLen)
rsiMA  = f_ma(rsi, maLen, maType)
base   = baseMode == "RSI" ? rsi : rsiMA

tr     = math.abs(base - base[1])
atrRSI = ta.rma(tr, atrLen)

upper  = base + factor * atrRSI
lower  = base - factor * atrRSI

var float fUpper = na
var float fLower = na
fUpper := na(fUpper[1]) ? upper : (upper < fUpper[1] or base[1] > fUpper[1] ? upper : fUpper[1])
fLower := na(fLower[1]) ? lower : (lower > fLower[1] or base[1] < fLower[1] ? lower : fLower[1])

var int dir = 1
dir := na(dir[1]) ? 1 :
     dir[1] == 1 ? (base < fLower[1] ? -1 : 1) :
                   (base > fUpper[1] ?  1 : -1)

//==============================
// TRIX slope
//==============================
ema1 = ta.ema(src, trixLen)
ema2 = ta.ema(ema1, trixLen)
ema3 = ta.ema(ema2, trixLen)
den  = nz(ema3[1], ema3)
trix = den != 0.0 ? 100.0 * (ema3 - ema3[1]) / den : 0.0

slope  = trix - trix[trixSlopeLen]
isUp   = slope >  flatTh
isDn   = slope < -flatTh

//==============================
// State (RSI trend x TRIX slope)
//==============================
strongBull = (dir == 1)  and isUp
strongBear = (dir == -1) and isDn
weakBull   = (dir == 1)  and not isUp
weakBear   = (dir == -1) and not isDn

cStrongBull = color.new(colStrongBull, 0)
cStrongBear = color.new(colStrongBear, 0)
cWeakBull   = color.new(colWeakBull,   weakTransp)
cWeakBear   = color.new(colWeakBear,   weakTransp)
cNeutral    = color.new(colNeutral,    neuTransp)

bodyColor =
     strongBull ? cStrongBull :
     strongBear ? cStrongBear :
     weakBull   ? cWeakBull :
     weakBear   ? cWeakBear :
     cNeutral

wickColor   = wickAsBody   ? bodyColor : wickNeutral
borderColor = borderAsBody ? bodyColor : bordNeutral

//==============================
// Candle rendering (VIVID)
//==============================
// 元のローソクを隠す（白ローソクが残って発色が弱く見えるのを防ぐ）
plotcandle(
     hideOriginalCandles ? open : na,
     hideOriginalCandles ? high : na,
     hideOriginalCandles ? low  : na,
     hideOriginalCandles ? close: na,
     title="Vivid Candles",
     color=bodyColor,
     wickcolor=wickColor,
     bordercolor=borderColor
)

//==============================
// Trend Ribbon (visual trend line)
//==============================
fast = ta.ema(close, ribbonFast)
slow = ta.ema(close, ribbonSlow)

ribbonCol = color.new(
     strongBull ? colStrongBull :
     strongBear ? colStrongBear :
     weakBull   ? colWeakBull :
     weakBear   ? colWeakBear :
     colNeutral,
     ribbonTransp
)

pFast = plot(showRibbon ? fast : na, title="Ribbon Fast", linewidth=1, color=color.new(color.white, 100))
pSlow = plot(showRibbon ? slow : na, title="Ribbon Slow", linewidth=1, color=color.new(color.white, 100))
fill(pFast, pSlow, color=ribbonCol, title="Trend Ribbon Fill")

//==============================
// Guide Line (single trend line)
//==============================
guide = ta.ema(close, guideLen)
plot(showGuideLine ? guide : na, title="Guide EMA", linewidth=guideWidth, color=bodyColor)

//==============================
// Alerts (optional)
//==============================
alertcondition(strongBull and not strongBull[1], title="Strong Bull", message="Strong Bull: RSI trend UP & TRIX slope UP")
alertcondition(strongBear and not strongBear[1], title="Strong Bear", message="Strong Bear: RSI trend DOWN & TRIX slope DOWN")
