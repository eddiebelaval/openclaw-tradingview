//@version=5
indicator("Momentum Shift Oscillator", shorttitle="MSO", overlay=false, max_labels_count=500)

//----------------------------------------------------
// Inputs
//----------------------------------------------------
groupCore = "Core Settings"
rsiLen = input.int(14, "RSI Length", minval=2, group=groupCore)
stochLen = input.int(14, "Stoch RSI Length", minval=2, group=groupCore)
kSmooth = input.int(3, "Stoch RSI K Smoothing", minval=1, group=groupCore)
dSmooth = input.int(3, "Stoch RSI D Smoothing", minval=1, group=groupCore)
rocLen = input.int(10, "ROC Length", minval=1, group=groupCore)
sigLen = input.int(5, "Signal Length", minval=1, group=groupCore)

groupMACD = "MACD Settings"
macdFast = input.int(12, "MACD Fast", minval=1, group=groupMACD)
macdSlow = input.int(26, "MACD Slow", minval=1, group=groupMACD)
macdSignal = input.int(9, "MACD Signal", minval=1, group=groupMACD)

groupNorm = "Normalization"
normLen = input.int(100, "Z-Score Length", minval=20, group=groupNorm)
normMult = input.float(10.0, "Z-Score Scaling Multiplier", minval=0.1, step=0.1, group=groupNorm)

groupWeights = "Weights"
wRSI = input.float(0.45, "Weight RSI", minval=0.0, step=0.05, group=groupWeights)
wSRSI = input.float(0.15, "Weight Stoch RSI", minval=0.0, step=0.05, group=groupWeights)
wMACD = input.float(0.25, "Weight MACD Histogram", minval=0.0, step=0.05, group=groupWeights)
wROC = input.float(0.15, "Weight ROC", minval=0.0, step=0.05, group=groupWeights)

groupView = "Display"
showHistogram = input.bool(true, "Show Momentum Histogram", group=groupView)
showCrosses = input.bool(true, "Show Signal Cross Markers", group=groupView)
showBg = input.bool(true, "Background Bias Shading", group=groupView)

//----------------------------------------------------
// Helpers
//----------------------------------------------------
clamp(v, lo, hi) =>
    math.max(lo, math.min(hi, v))

zscore(src, len) =>
    mean = ta.sma(src, len)
    dev = ta.stdev(src, len)
    dev != 0.0 ? (src - mean) / dev : 0.0

normalizeZToOsc(src, len, mult) =>
    clamp(50.0 + zscore(src, len) * mult, 0.0, 100.0)

//----------------------------------------------------
// Component Calculations
//----------------------------------------------------
// 1) RSI
rsiVal = ta.rsi(close, rsiLen)

// 2) Stoch RSI (0-100)
rsiBase = ta.rsi(close, rsiLen)
rsiLowest = ta.lowest(rsiBase, stochLen)
rsiHighest = ta.highest(rsiBase, stochLen)
stochRsiRaw = (rsiHighest - rsiLowest) != 0.0 ? 100.0 * (rsiBase - rsiLowest) / (rsiHighest - rsiLowest) : 50.0
stochRsiK = ta.sma(stochRsiRaw, kSmooth)
stochRsiD = ta.sma(stochRsiK, dSmooth)
stochRsiUsed = stochRsiK

// 3) MACD Histogram normalized to oscillator scale
macdLine = ta.ema(close, macdFast) - ta.ema(close, macdSlow)
macdSig = ta.ema(macdLine, macdSignal)
macdHist = macdLine - macdSig
macdNorm = normalizeZToOsc(macdHist, normLen, normMult)

// 4) ROC normalized to oscillator scale
rocVal = ta.roc(close, rocLen)
rocNorm = normalizeZToOsc(rocVal, normLen, normMult)

//----------------------------------------------------
// Composite
//----------------------------------------------------
weightSum = wRSI + wSRSI + wMACD + wROC

compositeRaw = weightSum > 0
     ? (rsiVal * wRSI + stochRsiUsed * wSRSI + macdNorm * wMACD + rocNorm * wROC) / weightSum
     : 50.0

composite = ta.ema(compositeRaw, 2)
signal = ta.ema(composite, sigLen)
hist = composite - signal

//----------------------------------------------------
// Conditions
//----------------------------------------------------
bullCross = ta.crossover(composite, signal)
bearCross = ta.crossunder(composite, signal)

bullBias = composite > 50 and signal > 50
bearBias = composite < 50 and signal < 50

strongBull = composite >= 70
strongBear = composite <= 30

//----------------------------------------------------
// Colors
//----------------------------------------------------
lineColor =
     strongBull ? color.lime :
     strongBear ? color.red :
     composite >= signal ? color.teal : color.orange

histColor = hist >= 0 ? color.new(color.lime, 0) : color.new(color.red, 0)

bgCol =
     bullBias ? color.new(color.green, 90) :
     bearBias ? color.new(color.red, 90) :
     color.new(color.gray, 95)

//----------------------------------------------------
// Plots
//----------------------------------------------------
h70 = hline(70, "Upper Zone", color=color.new(color.red, 65))
h50 = hline(50, "Midline", color=color.new(color.gray, 45))
h30 = hline(30, "Lower Zone", color=color.new(color.green, 65))

plot(composite, "MSO", color=lineColor, linewidth=3)
plot(signal, "Signal", color=color.new(color.white, 0), linewidth=2)

plot(showHistogram ? hist : na, "Histogram", style=plot.style_columns, color=histColor, linewidth=2)

plot(showCrosses and bullCross ? composite : na, "Bull Cross", style=plot.style_circles, color=color.lime, linewidth=3)
plot(showCrosses and bearCross ? composite : na, "Bear Cross", style=plot.style_circles, color=color.red, linewidth=3)

bgcolor(showBg ? bgCol : na)

//----------------------------------------------------
// Alerts
//----------------------------------------------------
alertcondition(bullCross, "MSO Bullish Cross", "Momentum Shift Oscillator bullish cross")
alertcondition(bearCross, "MSO Bearish Cross", "Momentum Shift Oscillator bearish cross")
alertcondition(ta.crossover(composite, 50), "MSO Cross Above 50", "Momentum Shift Oscillator crossed above 50")
alertcondition(ta.crossunder(composite, 50), "MSO Cross Below 50", "Momentum Shift Oscillator crossed below 50")
alertcondition(ta.crossover(composite, 70), "MSO Into Strong Bull Zone", "Momentum Shift Oscillator crossed above 70")
alertcondition(ta.crossunder(composite, 30), "MSO Into Strong Bear Zone", "Momentum Shift Oscillator crossed below 30")

//----------------------------------------------------
// Regime Table
//----------------------------------------------------
var table t = table.new(position.top_right, 2, 6, border_width=1)

regimeText =
     strongBull ? "Strong Bull" :
     strongBear ? "Strong Bear" :
     bullBias ? "Bull Bias" :
     bearBias ? "Bear Bias" :
     "Neutral"

if barstate.islast
    table.cell(t, 0, 0, "Metric", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(t, 1, 0, "Value", text_color=color.white, bgcolor=color.new(color.black, 0))

    table.cell(t, 0, 1, "MSO", text_color=color.white)
    table.cell(t, 1, 1, str.tostring(composite, "#.0"), text_color=color.white)

    table.cell(t, 0, 2, "Signal", text_color=color.white)
    table.cell(t, 1, 2, str.tostring(signal, "#.0"), text_color=color.white)

    table.cell(t, 0, 3, "Hist", text_color=color.white)
    table.cell(t, 1, 3, str.tostring(hist, "#.2"), text_color=color.white)

    table.cell(t, 0, 4, "Regime", text_color=color.white)
    table.cell(t, 1, 4, regimeText, text_color=color.white)

    table.cell(t, 0, 5, "Bias", text_color=color.white)
    table.cell(t, 1, 5, composite >= 50 ? "Above 50" : "Below 50", text_color=color.white)
