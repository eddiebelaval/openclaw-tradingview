//@version=6
indicator("Trend RSI with Flip Signals + TRIX Direction Bands + RCI", overlay=false, max_labels_count=200)

//==============================
// Inputs
//==============================
grp1 = "RSI"
rsiLen   = input.int(20, "RSI Length", minval=1, group=grp1)
src      = input.source(close, "Source", group=grp1)

grp2 = "Smoothing"
maLen    = input.int(10, "RSI MA Length", minval=1, group=grp2)
maType   = input.string("RMA", "RSI MA Type", options=["SMA","EMA","RMA","WMA"], group=grp2)

grp3 = "Trend Dots (SuperTrend-like on RSI)"
atrLen   = input.int(14, "ATR Len (on RSI)", minval=1, group=grp3)
factor   = input.float(4.0, "Factor", step=0.1, group=grp3)
baseMode = input.string("RSI MA", "Base", options=["RSI","RSI MA"], group=grp3)

grp4 = "Display"
showRSI  = input.bool(false, "Show RSI (thin)", group=grp4)
show50   = input.bool(true,  "Show 50 line", group=grp4)
show7030 = input.bool(false, "Show 70/30", group=grp4)

grp5 = "Signals / Alerts"
showFlipSignal = input.bool(true, "Show flip signal (▲▼)", group=grp5)
sigSizeOpt     = input.string("small", "Signal size",
                   options=["tiny","small","normal","large","huge"], group=grp5)

grpT = "TRIX Direction Bands (No Lines)"
useTrixBands   = input.bool(true, "Enable TRIX direction bands", group=grpT)
invertTrixBand = input.bool(true, "Invert bands (UP=Bottom / DOWN=Top)", group=grpT)  // ★追加
trixLen        = input.int(9, "TRIX Length", minval=1, group=grpT)
trixSlopeLen   = input.int(1, "Slope lookback (bars)", minval=1, maxval=10, group=grpT)
flatTh         = input.float(0.0, "Flat threshold (TRIX slope)", step=0.0001, group=grpT)

bandMode     = input.string("Both", "Band mode", options=["Both","Top only","Bottom only"], group=grpT)
flatPolicy   = input.string("Paint", "Flat behavior", options=["Paint","None"], group=grpT)
deadZone     = input.float(10.0, "No-paint zone around 90 (width)", step=0.5, minval=0.0, maxval=90.0, group=grpT)

grpTC = "TRIX Band Colors"
colUpTop    = input.color(color.new(color.aqua,  0),    "UP color", group=grpTC)
colDnBot    = input.color(color.new(color.fuchsia,0),   "DOWN color", group=grpTC)
colFlatBand = input.color(color.new(color.gray,  0),    "FLAT color", group=grpTC)
bandTransp  = input.int(88, "Band transparency (0-100)", minval=0, maxval=100, group=grpTC)

grpTA = "TRIX Alerts"
alertTrixSlopeFlip = input.bool(false, "Alert on TRIX slope flip", group=grpTA)

// ---- RCI 2 Lines ----
grpRCI = "RCI (2 lines)"
showRCI1 = input.bool(false, "Show RCI 1", group=grpRCI)
lenRCI1  = input.int(9, "RCI 1 Length", minval=2, group=grpRCI)
showRCI2 = input.bool(false, "Show RCI 2", group=grpRCI)
lenRCI2  = input.int(26, "RCI 2 Length", minval=2, group=grpRCI)
mapToRSI = input.bool(true, "Map RCI (-100..100) to 0..100", group=grpRCI)

grpRCISlope = "RCI Slope Coloring"
useRCISlopeColor = input.bool(true, "Color RCI lines by slope", group=grpRCISlope)
rciSlopeLen       = input.int(1, "Slope lookback (bars)", minval=1, maxval=10, group=grpRCISlope)
rciFlatTh         = input.float(0.0, "Flat threshold (mapped units)", step=0.01, group=grpRCISlope)

grpRCICol1 = "RCI 1 Colors"
rci1UpCol   = input.color(color.new(color.lime, 0),   "RCI 1 Up", group=grpRCICol1)
rci1DnCol   = input.color(color.new(color.red, 0),    "RCI 1 Down", group=grpRCICol1)
rci1FlatCol = input.color(color.new(color.gray, 0),   "RCI 1 Flat", group=grpRCICol1)
rci1Tr      = input.int(40, "RCI 1 Transparency (0-100)", minval=0, maxval=100, group=grpRCICol1)
rci1W       = input.int(1, "RCI 1 Width", minval=1, maxval=5, group=grpRCICol1)

grpRCICol2 = "RCI 2 Colors"
rci2UpCol   = input.color(color.new(color.yellow, 0), "RCI 2 Up", group=grpRCICol2)
rci2DnCol   = input.color(color.new(color.orange, 0), "RCI 2 Down", group=grpRCICol2)
rci2FlatCol = input.color(color.new(color.gray, 0),   "RCI 2 Flat", group=grpRCICol2)
rci2Tr      = input.int(55, "RCI 2 Transparency (0-100)", minval=0, maxval=100, group=grpRCICol2)
rci2W       = input.int(1, "RCI 2 Width", minval=1, maxval=5, group=grpRCICol2)

//==============================
// Helpers
//==============================
f_ma(_x, _len, _type) =>
    switch _type
        "SMA" => ta.sma(_x, _len)
        "EMA" => ta.ema(_x, _len)
        "RMA" => ta.rma(_x, _len)
        => ta.wma(_x, _len)

// RCI (Rank Correlation Index) : returns -100..100
// ★fix: rank so that higher price => smaller rank number (1 = highest)
f_rci(_src, _len) =>
    float sumD2 = 0.0
    for i = 0 to _len - 1
        int rankTime  = i + 1
        int rankPrice = 1
        for j = 0 to _len - 1
            if _src[j] > _src[i]   // ★was "<" ; this flips orientation
                rankPrice += 1
        float d = (rankTime - rankPrice)
        sumD2 += d * d
    float n = _len
    100.0 * (1.0 - (6.0 * sumD2) / (n * (n*n - 1.0)))

// Map -100..100 => 0..100
f_map100(_x) =>
    (_x + 100.0) * 0.5

//==============================
// Core (TrendRSI)
//==============================
rsi    = ta.rsi(src, rsiLen)
rsiMA  = f_ma(rsi, maLen, maType)
base   = baseMode == "RSI" ? rsi : rsiMA

tr     = math.abs(base - base[1])
atrRSI = ta.rma(tr, atrLen)

upper  = base + factor * atrRSI
lower  = base - factor * atrRSI

var float fUpper = na
var float fLower = na
fUpper := na(fUpper[1]) ? upper : (upper < fUpper[1] or base[1] > fUpper[1] ? upper : fUpper[1])
fLower := na(fLower[1]) ? lower : (lower > fLower[1] or base[1] < fLower[1] ? lower : fLower[1])

var int dir = 1
dir := na(dir[1]) ? 1 :
     dir[1] == 1 ? (base < fLower[1] ? -1 : 1) :
                   (base > fUpper[1] ?  1 : -1)

trendLine = dir == 1 ? fLower : fUpper

flipUp = dir == 1 and dir[1] == -1
flipDn = dir == -1 and dir[1] == 1

//==============================
// Reference lines
//==============================
col50 = show50   ? color.new(color.gray, 60) : color.new(color.gray, 100)
col70 = show7030 ? color.new(color.gray, 75) : color.new(color.gray, 100)
col30 = show7030 ? color.new(color.gray, 75) : color.new(color.gray, 100)

hline(50, "50", color=col50)
hline(70, "70", color=col70)
hline(30, "30", color=col30)

//==============================
// TRIX direction bands (no line plots)
//==============================
ema1 = ta.ema(src, trixLen)
ema2 = ta.ema(ema1, trixLen)
ema3 = ta.ema(ema2, trixLen)
trix = 100.0 * (ema3 - ema3[1]) / nz(ema3[1], ema3)

slope  = trix - trix[trixSlopeLen]
isUp   = slope >  flatTh
isDn   = slope < -flatTh
isFlat = not isUp and not isDn
wantFlatPaint = (flatPolicy == "Paint")

mid = 50.0
halfDZ = deadZone * 0.5
topStart = mid + halfDZ
botEnd   = mid - halfDZ

h100 = hline(100, "Band Top",         color=color.new(color.gray, 100))
hTop = hline(topStart, "Band TopStart", color=color.new(color.gray, 100))
hBot = hline(botEnd,   "Band BotEnd",   color=color.new(color.gray, 100))
h0   = hline(0,   "Band Bottom",      color=color.new(color.gray, 100))

// ★上下反転ロジック
topIsUp = invertTrixBand ? isDn : isUp
botIsDn = invertTrixBand ? isUp : isDn

paintTop = useTrixBands and (bandMode == "Both" or bandMode == "Top only") and (topIsUp or (wantFlatPaint and isFlat))
paintBot = useTrixBands and (bandMode == "Both" or bandMode == "Bottom only") and (botIsDn or (wantFlatPaint and isFlat))

// ★色も反転させる（UP色/DOWN色を上下に入れ替える）
topUpCol = invertTrixBand ? colDnBot : colUpTop
botDnCol = invertTrixBand ? colUpTop : colDnBot

topCol = paintTop ? color.new((topIsUp ? topUpCol : colFlatBand), bandTransp) : na
botCol = paintBot ? color.new((botIsDn ? botDnCol : colFlatBand), bandTransp) : na

fill(h100, hTop, color=topCol)
fill(hBot, h0,   color=botCol)

//==============================
// RCI calc & plots (optional)
//==============================
rci1_raw = f_rci(src, lenRCI1)
rci2_raw = f_rci(src, lenRCI2)

rci1 = mapToRSI ? f_map100(rci1_raw) : rci1_raw
rci2 = mapToRSI ? f_map100(rci2_raw) : rci2_raw

// slope coloring
rci1Slope = rci1 - rci1[rciSlopeLen]
rci2Slope = rci2 - rci2[rciSlopeLen]

rci1Up   = rci1Slope >  rciFlatTh
rci1Dn   = rci1Slope < -rciFlatTh
rci1Flat = not rci1Up and not rci1Dn

rci2Up   = rci2Slope >  rciFlatTh
rci2Dn   = rci2Slope < -rciFlatTh
rci2Flat = not rci2Up and not rci2Dn

rci1Color = useRCISlopeColor ? (rci1Up ? rci1UpCol : rci1Dn ? rci1DnCol : rci1FlatCol) : rci1UpCol
rci2Color = useRCISlopeColor ? (rci2Up ? rci2UpCol : rci2Dn ? rci2DnCol : rci2FlatCol) : rci2UpCol

plot(showRCI1 ? rci1 : na, "RCI 1", color=color.new(rci1Color, rci1Tr), linewidth=rci1W)
plot(showRCI2 ? rci2 : na, "RCI 2", color=color.new(rci2Color, rci2Tr), linewidth=rci2W)

//==============================
// Main plots
//==============================
plot(rsiMA, "RSI MA", color=color.white, linewidth=1)
plot(showRSI ? rsi : na, "RSI", color=color.new(color.white, 75), linewidth=1)

dotCol = dir == 1 ? color.aqua : color.fuchsia
plot(trendLine, "Trend Dots", style=plot.style_circles, linewidth=2, color=dotCol)

//==============================
// Flip Signals
//==============================
condUp = showFlipSignal and flipUp ? trendLine : na
condDn = showFlipSignal and flipDn ? trendLine : na

plotshape(sigSizeOpt=="tiny"   ? condUp : na, title="Flip Up tiny",   style=shape.labelup,   text="▲", color=color.aqua,    textcolor=color.white, size=size.tiny,   location=location.absolute)
plotshape(sigSizeOpt=="tiny"   ? condDn : na, title="Flip Dn tiny",   style=shape.labeldown, text="▼", color=color.fuchsia, textcolor=color.white, size=size.tiny,   location=location.absolute)

plotshape(sigSizeOpt=="small"  ? condUp : na, title="Flip Up small",  style=shape.labelup,   text="▲", color=color.aqua,    textcolor=color.white, size=size.small,  location=location.absolute)
plotshape(sigSizeOpt=="small"  ? condDn : na, title="Flip Dn small",  style=shape.labeldown, text="▼", color=color.fuchsia, textcolor=color.white, size=size.small,  location=location.absolute)

plotshape(sigSizeOpt=="normal" ? condUp : na, title="Flip Up normal", style=shape.labelup,   text="▲", color=color.aqua,    textcolor=color.white, size=size.normal, location=location.absolute)
plotshape(sigSizeOpt=="normal" ? condDn : na, title="Flip Dn normal", style=shape.labeldown, text="▼", color=color.fuchsia, textcolor=color.white, size=size.normal, location=location.absolute)

plotshape(sigSizeOpt=="large"  ? condUp : na, title="Flip Up large",  style=shape.labelup,   text="▲", color=color.aqua,    textcolor=color.white, size=size.large,  location=location.absolute)
plotshape(sigSizeOpt=="large"  ? condDn : na, title="Flip Dn large",  style=shape.labeldown, text="▼", color=color.fuchsia, textcolor=color.white, size=size.large,  location=location.absolute)

plotshape(sigSizeOpt=="huge"   ? condUp : na, title="Flip Up huge",   style=shape.labelup,   text="▲", color=color.aqua,    textcolor=color.white, size=size.huge,   location=location.absolute)
plotshape(sigSizeOpt=="huge"   ? condDn : na, title="Flip Dn huge",   style=shape.labeldown, text="▼", color=color.fuchsia, textcolor=color.white, size=size.huge,   location=location.absolute)

//==============================
// Alerts
//==============================
alertcondition(flipUp, title="TrendRSI Flip UP", message="TrendRSI flipped UP")
alertcondition(flipDn, title="TrendRSI Flip DOWN", message="TrendRSI flipped DOWN")
alertcondition(flipUp or flipDn, title="TrendRSI Flip (Any)", message="TrendRSI flipped direction")

trixUpNow  = isUp
trixDnNow  = isDn
trixUpFlip = trixUpNow and not trixUpNow[1]
trixDnFlip = trixDnNow and not trixDnNow[1]
alertcondition(alertTrixSlopeFlip and trixUpFlip, title="TRIX Slope UP", message="TRIX slope turned UP")
alertcondition(alertTrixSlopeFlip and trixDnFlip, title="TRIX Slope DOWN", message="TRIX slope turned DOWN")
