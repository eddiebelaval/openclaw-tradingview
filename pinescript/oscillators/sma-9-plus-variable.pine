//@version=5
indicator("Stratégie Option B : Triple SMA", overlay=true)

// 1. Définition des 3 Moyennes Mobiles
sma5  = ta.sma(close, 5)
sma9  = ta.sma(close, 9)
sma21 = ta.sma(close, 21)

// 2. Affichage des lignes
plot(sma5,  color=color.green, title="SMA 5 (Rapide)", linewidth=1)
plot(sma9,  color=color.blue,  title="SMA 9 (Référence)", linewidth=2)
plot(sma21, color=color.red,   title="SMA 21 (Lente)", linewidth=1)

// 3. Logique des signaux
// ACHAT : La rapide (5) ET la lente (21) sont au-dessus de la 9
achat = sma5 > sma9 and sma21 > sma9

// VENTE : La rapide (5) ET la lente (21) sont en-dessous de la 9
vente = sma5 < sma9 and sma21 < sma9

// RANGE : Une au-dessus, l'autre en-dessous (la 9 est "au milieu")
range_zone = (sma5 > sma9 and sma21 < sma9) or (sma5 < sma9 and sma21 > sma9)

// 4. Visuel
bgcolor(achat ? color.new(color.green, 85) : na, title="Zone Achat")
bgcolor(vente ? color.new(color.red, 85) : na, title="Zone Vente")
bgcolor(range_zone ? color.new(color.gray, 85) : na, title="Zone Range")

// Flèches de signal (seulement au moment du croisement)
plotshape(achat and not achat[1], "Signal Achat", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(vente and not vente[1], "Signal Vente", shape.triangledown, location.abovebar, color.red, size=size.small)
