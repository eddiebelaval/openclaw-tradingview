//@version=5
indicator("BTC Stretch Radar", overlay=false)

// ===== Inputs =====
emaLen = input.int(21, "EMA Length")
lookback = input.int(200, "Statistics Length")
mult = input.float(2.0, "Extreme Multiplier")

volLookback = input.int(10, "Volume Lookback")
volMultiplier = input.float(2.5, "Volume Spike Multiplier")

atrLen = input.int(14, "ATR Length")
atrFilterLen = input.int(50, "ATR Regime Filter")

// ===== Core calculations =====
emaValue = ta.ema(close, emaLen)      // short-term gravity center
vwapVal = ta.vwap(close)              // fair price of the session

// Stretch calculations
stretchEMA = (close - emaValue) / emaValue * 100   // rubber band physics
stretchVWAP = (close - vwapVal) / vwapVal * 100    // pigeons getting nervous 🐦

// ===== Statistics =====
meanStretch = ta.sma(stretchEMA, lookback)
devStretch = ta.stdev(stretchEMA, lookback)

upperExtreme = meanStretch + devStretch * mult     // 🚀 FOMO zone
lowerExtreme = meanStretch - devStretch * mult     // 💀 panic zone

// ===== Volume spike detection =====
avgVol = ta.sma(volume, volLookback)
volSpike = volume > avgVol * volMultiplier         // pigeons suddenly taking off 🐦💥

// ===== Volatility regime detection =====
atr = ta.atr(atrLen)
atrBaseline = ta.sma(atr, atrFilterLen)

marketAwake = atr > atrBaseline                    // true when market actually moving
saturdayMode = atr < atrBaseline                   // sleepy drift regime

// ===== Plots =====
plot(stretchEMA, "EMA Stretch %", color=color.orange, linewidth=2)
plot(stretchVWAP, "VWAP Stretch %", color=color.blue, linewidth=2)

plot(upperExtreme, "Upper Extreme", color=color.red)
plot(lowerExtreme, "Lower Extreme", color=color.green)

hline(0, "Equilibrium", color=color.gray)

// ===== Background highlight =====
bgcolor(stretchEMA > upperExtreme and marketAwake ? color.new(color.red,85) : na)
bgcolor(stretchEMA < lowerExtreme and marketAwake ? color.new(color.green,85) : na)

// ===== Volume marker =====
plotshape(volSpike, title="Volume Spike", location=location.top, style=shape.triangleup, color=color.yellow, size=size.tiny)

// ===== Regime visualization =====
bgcolor(saturdayMode ? color.new(color.gray, 92) : na)  // sleepy market shading

// ===== Alerts =====
alertcondition(stretchEMA > upperExtreme and marketAwake, "Extreme Up Stretch", "Price extremely stretched above EMA")
alertcondition(stretchEMA < lowerExtreme and marketAwake, "Extreme Down Stretch", "Price extremely stretched below EMA")
alertcondition(volSpike and marketAwake, "Volume Spike", "Volume spike detected")
