// ══════════════════════════════════════════════════════════════════════
// Smart Money Signal Engine — by JoriDefi (Smart Money Academy)
// ══════════════════════════════════════════════════════════════════════
// Invite-only signal indicator for Smart Money Academy course members.
// Combines EMA Ribbon + Trend Momentum + Channel Detection for
// high-probability BUY / SELL signals directly on the chart.
//
// HOW IT WORKS:
//   • EMA Ribbon (8 lines) shows trend direction & momentum
//   • Ribbon turns GREEN = bullish, RED = bearish, GRAY = ranging
//   • BUY arrows fire when ALL conditions align for a long entry
//   • SELL arrows fire when ALL conditions align for a short entry
//   • Background shading shows dominant trend zone
//
// PUBLISH AS: Invite-only indicator on TradingView
// ══════════════════════════════════════════════════════════════════════

//@version=5
indicator("Smart Money Signal Engine", shorttitle="SM Signals", overlay=true, max_labels_count=500)

// ── Inputs ──────────────────────────────────────────────────────────
grp_ribbon  = "EMA Ribbon"
ema1_len    = input.int(8,    "EMA 1",   minval=1, group=grp_ribbon)
ema2_len    = input.int(13,   "EMA 2",   minval=1, group=grp_ribbon)
ema3_len    = input.int(21,   "EMA 3",   minval=1, group=grp_ribbon)
ema4_len    = input.int(34,   "EMA 4",   minval=1, group=grp_ribbon)
ema5_len    = input.int(55,   "EMA 5",   minval=1, group=grp_ribbon)
ema6_len    = input.int(89,   "EMA 6",   minval=1, group=grp_ribbon)
ema7_len    = input.int(144,  "EMA 7",   minval=1, group=grp_ribbon)
ema8_len    = input.int(200,  "EMA 8",   minval=1, group=grp_ribbon)

grp_signal  = "Signal Engine"
atr_len     = input.int(14,   "ATR Length",            minval=1,  group=grp_signal)
rsi_len     = input.int(14,   "RSI Length",            minval=1,  group=grp_signal)
lookback    = input.int(20,   "Pivot Lookback",        minval=5,  group=grp_signal)
cooldown    = input.int(10,   "Signal Cooldown Bars",  minval=1,  group=grp_signal)
rsi_ob      = input.int(70,   "RSI Overbought",        minval=50, group=grp_signal)
rsi_os      = input.int(30,   "RSI Oversold",           maxval=50, group=grp_signal)

grp_visual  = "Visual"
show_ribbon = input.bool(true,  "Show EMA Ribbon",          group=grp_visual)
show_fills  = input.bool(true,  "Show Ribbon Fill",         group=grp_visual)
show_bg     = input.bool(true,  "Show Trend Background",    group=grp_visual)
show_ema200 = input.bool(true,  "Show EMA 200 Line",        group=grp_visual)
show_signals= input.bool(true,  "Show Buy/Sell Signals",    group=grp_visual)
// Signal arrow size (change here: size.tiny / size.small / size.small / size.large / size.huge)

// ── EMA Calculations ────────────────────────────────────────────────
ema1 = ta.ema(close, ema1_len)
ema2 = ta.ema(close, ema2_len)
ema3 = ta.ema(close, ema3_len)
ema4 = ta.ema(close, ema4_len)
ema5 = ta.ema(close, ema5_len)
ema6 = ta.ema(close, ema6_len)
ema7 = ta.ema(close, ema7_len)
ema8 = ta.ema(close, ema8_len)

// ── Trend Detection ─────────────────────────────────────────────────
ribbon_bull = ema1 > ema2 and ema2 > ema3 and ema3 > ema4 and ema4 > ema5
ribbon_bear = ema1 < ema2 and ema2 < ema3 and ema3 < ema4 and ema4 < ema5

trend_bull  = ema5 > ema8
trend_bear  = ema5 < ema8

price_above_ribbon = close > ema1 and close > ema4
price_below_ribbon = close < ema1 and close < ema4

// ── Momentum & Volatility ───────────────────────────────────────────
rsi         = ta.rsi(close, rsi_len)
atr         = ta.atr(atr_len)
atr_pct     = atr / close * 100

ema_fast_slope  = (ema1 - ema1[3]) / ema1[3] * 100
ema_slow_slope  = (ema5 - ema5[3]) / ema5[3] * 100

// ── Pivot Detection ─────────────────────────────────────────────────
pivot_high  = ta.pivothigh(high, lookback, lookback)
pivot_low   = ta.pivotlow(low, lookback, lookback)

var float last_swing_high = na
var float last_swing_low  = na

if not na(pivot_high)
    last_swing_high := pivot_high

if not na(pivot_low)
    last_swing_low  := pivot_low

// ── Channel Detection ───────────────────────────────────────────────
highest_hi    = ta.highest(high, lookback * 2)
lowest_lo     = ta.lowest(low, lookback * 2)
channel_mid   = (highest_hi + lowest_lo) / 2
channel_width = highest_hi - lowest_lo

chan_pos     = channel_width > 0 ? (close - lowest_lo) / channel_width : 0.5
near_upper  = chan_pos > 0.85
near_lower  = chan_pos < 0.15

// ── Candlestick Patterns ────────────────────────────────────────────
body        = math.abs(close - open)
total_range = high - low
upper_wick  = high - math.max(close, open)
lower_wick  = math.min(close, open) - low

bull_rejection = total_range > 0 and lower_wick / total_range >= 0.5 and close > open
bear_rejection = total_range > 0 and upper_wick / total_range >= 0.5 and close < open

bull_engulf = close > open and close[1] < open[1] and close > open[1] and open < close[1]
bear_engulf = close < open and close[1] > open[1] and close < open[1] and open > close[1]

// ── SIGNAL CONDITIONS ───────────────────────────────────────────────
buy_trend   = trend_bull or (ema1 > ema4 and ema_fast_slope > 0)
sell_trend  = trend_bear or (ema1 < ema4 and ema_fast_slope < 0)

buy_location  = close <= ema4 * 1.002 or near_lower or (close < ema3 and close > ema5)
sell_location = close >= ema4 * 0.998 or near_upper or (close > ema3 and close < ema5)

buy_confirm  = bull_rejection or bull_engulf or (close > open and close > ema1 and close[1] < ema1)
sell_confirm = bear_rejection or bear_engulf or (close < open and close < ema1 and close[1] > ema1)

buy_momentum  = rsi < rsi_ob and rsi > 25 and ema_fast_slope > -0.5
sell_momentum = rsi > rsi_os and rsi < 75 and ema_fast_slope < 0.5

raw_buy   = buy_trend and buy_location and buy_confirm and buy_momentum and show_signals
raw_sell  = sell_trend and sell_location and sell_confirm and sell_momentum and show_signals

// ── Cooldown ────────────────────────────────────────────────────────
var int bars_since_buy  = cooldown + 1
var int bars_since_sell = cooldown + 1

bars_since_buy  := bars_since_buy  + 1
bars_since_sell := bars_since_sell + 1

buy_signal  = raw_buy  and bars_since_buy  > cooldown and bars_since_sell > 3
sell_signal = raw_sell and bars_since_sell > cooldown and bars_since_buy  > 3

if buy_signal
    bars_since_buy  := 0

if sell_signal
    bars_since_sell := 0

// ── VISUAL: EMA Ribbon ──────────────────────────────────────────────
ribbon_color(fast, slow) =>
    fast > slow ? color.new(#10b981, 20) : fast < slow ? color.new(#ef4444, 20) : color.new(#64748b, 40)

p1 = plot(show_ribbon ? ema1 : na, "EMA 8",   color=ribbon_color(ema1, ema2), linewidth=1)
p2 = plot(show_ribbon ? ema2 : na, "EMA 13",  color=ribbon_color(ema2, ema3), linewidth=1)
p3 = plot(show_ribbon ? ema3 : na, "EMA 21",  color=ribbon_color(ema3, ema4), linewidth=1)
p4 = plot(show_ribbon ? ema4 : na, "EMA 34",  color=ribbon_color(ema4, ema5), linewidth=1)
p5 = plot(show_ribbon ? ema5 : na, "EMA 55",  color=ribbon_color(ema5, ema6), linewidth=1)
p6 = plot(show_ribbon ? ema6 : na, "EMA 89",  color=ribbon_color(ema6, ema7), linewidth=1)
p7 = plot(show_ribbon ? ema7 : na, "EMA 144", color=ribbon_color(ema7, ema8), linewidth=1)
p8 = plot(show_ema200 ? ema8 : na, "EMA 200", color=color.new(color.white, 10), linewidth=2)

// Ribbon fills
fill_color_bull    = color.new(#10b981, 88)
fill_color_bear    = color.new(#ef4444, 88)
fill_color_neutral = color.new(#64748b, 93)

get_fill(fast, slow) =>
    fast > slow ? fill_color_bull : fast < slow ? fill_color_bear : fill_color_neutral

fill(p1, p2, color=show_fills ? get_fill(ema1, ema2) : na)
fill(p2, p3, color=show_fills ? get_fill(ema2, ema3) : na)
fill(p3, p4, color=show_fills ? get_fill(ema3, ema4) : na)
fill(p4, p5, color=show_fills ? get_fill(ema4, ema5) : na)
fill(p5, p6, color=show_fills ? get_fill(ema5, ema6) : na)
fill(p6, p7, color=show_fills ? get_fill(ema6, ema7) : na)
fill(p7, p8, color=show_fills ? get_fill(ema7, ema8) : na)

// ── VISUAL: Trend Background ────────────────────────────────────────
bg_bull = color.new(#10b981, 95)
bg_bear = color.new(#ef4444, 95)

bg_color = show_bg ? (ribbon_bull and trend_bull ? bg_bull : ribbon_bear and trend_bear ? bg_bear : color(na)) : color(na)
bgcolor(bg_color, title="Trend Background")

// ── VISUAL: Buy / Sell Signals ──────────────────────────────────────
plotshape(buy_signal,  title="BUY Signal",  location=location.belowbar, style=shape.triangleup,   size=size.small, color=#10b981, text="BUY",  textcolor=#10b981)
plotshape(sell_signal, title="SELL Signal", location=location.abovebar, style=shape.triangledown, size=size.small, color=#ef4444, text="SELL", textcolor=#ef4444)

// ── VISUAL: Signal Labels with Price ────────────────────────────────
if buy_signal
    label.new(bar_index, low - atr * 0.5,
         text="BUY\n" + str.tostring(close, format.mintick),
         style=label.style_label_up,
         color=color.new(#10b981, 20),
         textcolor=color.white,
         size=size.small)

if sell_signal
    label.new(bar_index, high + atr * 0.5,
         text="SELL\n" + str.tostring(close, format.mintick),
         style=label.style_label_down,
         color=color.new(#ef4444, 20),
         textcolor=color.white,
         size=size.small)

// ── ALERTS ──────────────────────────────────────────────────────────
alertcondition(buy_signal,  title="BUY Signal",  message="Smart Money BUY Signal on {{ticker}} at {{close}}")
alertcondition(sell_signal, title="SELL Signal", message="Smart Money SELL Signal on {{ticker}} at {{close}}")
alertcondition(buy_signal or sell_signal, title="Any Signal", message="Smart Money {{ticker}} Signal at {{close}}")

// ── INFO TABLE ──────────────────────────────────────────────────────
var table info = table.new(position.top_right, 2, 6, bgcolor=color.new(#0f1623, 10), border_width=1, border_color=color.new(color.white, 85))

if barstate.islast
    trend_txt   = ribbon_bull and trend_bull ? "BULLISH" : ribbon_bear and trend_bear ? "BEARISH" : "RANGING"
    trend_clr   = ribbon_bull and trend_bull ? color.green : ribbon_bear and trend_bear ? color.red : color.gray
    rsi_txt     = str.tostring(math.round(rsi))
    chan_txt     = str.tostring(math.round(chan_pos * 100)) + "%"
    slope_txt   = str.tostring(math.round(ema_fast_slope * 100) / 100)

    table.cell(info, 0, 0, "SM SIGNAL ENGINE", text_color=color.new(#a855f7, 0), text_size=size.small)
    table.cell(info, 1, 0, "v1.0", text_color=color.new(color.white, 50), text_size=size.tiny)
    table.cell(info, 0, 1, "Trend", text_color=color.new(color.white, 40), text_size=size.tiny)
    table.cell(info, 1, 1, trend_txt, text_color=trend_clr, text_size=size.tiny)
    table.cell(info, 0, 2, "RSI", text_color=color.new(color.white, 40), text_size=size.tiny)
    table.cell(info, 1, 2, rsi_txt, text_color=rsi > rsi_ob ? color.red : rsi < rsi_os ? color.green : color.white, text_size=size.tiny)
    table.cell(info, 0, 3, "Channel", text_color=color.new(color.white, 40), text_size=size.tiny)
    table.cell(info, 1, 3, chan_txt, text_color=near_upper ? color.red : near_lower ? color.green : color.white, text_size=size.tiny)
    table.cell(info, 0, 4, "Momentum", text_color=color.new(color.white, 40), text_size=size.tiny)
    table.cell(info, 1, 4, slope_txt, text_color=ema_fast_slope > 0 ? color.green : color.red, text_size=size.tiny)
    table.cell(info, 0, 5, "Smart Money Academy", text_color=color.new(#f59e0b, 20), text_size=size.tiny)
    table.cell(info, 1, 5, "joridefi.com", text_color=color.new(#f59e0b, 20), text_size=size.tiny)
