//
// RSI Wave Bands overlay.
// - Maps adaptive RSI overbought/oversold thresholds into price space.
// - Draws smoothed inner and outer wave boundaries on the chart.
// - Highlights upper and lower extension zones with configurable colors.

//@version=6
indicator(title = 'RSI Wave Bands', shorttitle = 'RSI Waves', overlay = true)

// Inputs: RSI and smoothing.
rsiGroup = 'RSI Settings'

rsiLength = input.int(14, 'RSI Length', minval = 2, maxval = 500, group = rsiGroup, tooltip = 'Keep this in sync with the AdaptiveRSI panel if you use both together.')

bandSmoothingLength = input.int(8, 'Band Smoothing', minval = 1, maxval = 50, group = rsiGroup, tooltip = 'RMA smoothing applied to the band positions. Higher values are smoother but add lag.')

// Inputs: visual appearance.
appearanceGroup = 'Appearance'

upperLineColor = input.color(#FF6D00, 'Upper Line', inline = 'u', group = appearanceGroup)
upperFillColor = input.color(#FFB74D, 'Upper Fill', inline = 'u', group = appearanceGroup)
lowerLineColor = input.color(#00BCD4, 'Lower Line', inline = 'l', group = appearanceGroup)
lowerFillColor = input.color(#7FDBFF, 'Lower Fill', inline = 'l', group = appearanceGroup)

// Core constants.
halfRange = 50.0
epsilon = 1e-10
smoothingFactor = 1.0 / rsiLength
inverseSqrtLengthMinusOne = 1.0 / math.pow(math.max(rsiLength - 1.0, 1.0), 0.5)

// Helper functions.
customTanh(value) => (math.exp(2.0 * value) - 1.0) / (math.exp(2.0 * value) + 1.0)
rsiDistanceFrom50(zScore) => halfRange * customTanh(zScore * inverseSqrtLengthMinusOne)

// Adaptive RSI engine used for mapping RSI levels back into price.
middle = ta.rma(close, rsiLength)
middleOpen = (1.0 - smoothingFactor) * middle[1] + smoothingFactor * open
middleHigh = (1.0 - smoothingFactor) * middle[1] + smoothingFactor * high
middleLow = (1.0 - smoothingFactor) * middle[1] + smoothingFactor * low

closeVolatility = ta.rma(math.abs(close - close[1]), rsiLength)
openVolatility = (1.0 - smoothingFactor) * closeVolatility[1] + smoothingFactor * math.abs(open - close[1])
highVolatility = (1.0 - smoothingFactor) * closeVolatility[1] + smoothingFactor * math.abs(high - close[1])
lowVolatility = (1.0 - smoothingFactor) * closeVolatility[1] + smoothingFactor * math.abs(low - close[1])

closeDenominator = math.max(closeVolatility, epsilon) * (rsiLength - 1.0)
openDenominator = math.max(openVolatility, epsilon) * (rsiLength - 1.0)
highDenominator = math.max(highVolatility, epsilon) * (rsiLength - 1.0)
lowDenominator = math.max(lowVolatility, epsilon) * (rsiLength - 1.0)

adaptiveRsi = halfRange + halfRange * ((close - middle) / closeDenominator)

priceAtRsi(rsiValue) => middle + ((rsiValue - 50.0) / 50.0) * closeDenominator

// Thresholds that define inner and outer wave boundaries.
reversalThreshold = math.sqrt(3.0)
tailThreshold = math.sqrt((5.0 + math.sqrt(17.0)) / 2.0)

overboughtInner = 50.0 + rsiDistanceFrom50(reversalThreshold)
overboughtOuter = 50.0 + rsiDistanceFrom50(tailThreshold)
oversoldInner = 50.0 - rsiDistanceFrom50(reversalThreshold)
oversoldOuter = 50.0 - rsiDistanceFrom50(tailThreshold)

upperBandRaw = priceAtRsi(overboughtInner)
lowerBandRaw = priceAtRsi(oversoldInner)
upperTailRaw = priceAtRsi(overboughtOuter)
lowerTailRaw = priceAtRsi(oversoldOuter)

upperBand = ta.rma(upperBandRaw, bandSmoothingLength)
lowerBand = ta.rma(lowerBandRaw, bandSmoothingLength)
upperTail = ta.rma(upperTailRaw, bandSmoothingLength)
lowerTail = ta.rma(lowerTailRaw, bandSmoothingLength)

// Price-overlay plots.
upperPlot = plot(upperBand, 'Upper Band', color.new(upperLineColor, 5), linewidth = 2)
lowerPlot = plot(lowerBand, 'Lower Band', color.new(lowerLineColor, 5), linewidth = 2)
upperTailPlot = plot(upperTail, 'Upper Tail', color.new(upperFillColor, 100), linewidth = 1, display = display.none)
lowerTailPlot = plot(lowerTail, 'Lower Tail', color.new(lowerFillColor, 100), linewidth = 1, display = display.none)

fill(
     upperTailPlot,
     upperPlot,
     top_color = color.new(upperFillColor, 88),
     bottom_color = color.new(upperFillColor, 70),
     title = 'Upper Extension')

fill(
     lowerPlot,
     lowerTailPlot,
     top_color = color.new(lowerFillColor, 70),
     bottom_color = color.new(lowerFillColor, 88),
     title = 'Lower Extension')
