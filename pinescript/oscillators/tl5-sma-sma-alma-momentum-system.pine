//@version=6
//──────────────────────────────────────────────────────────────────────────────
//  [TL5 SMA] SMA-ALMA Momentum System
//──────────────────────────────────────────────────────────────────────────────
//  Author      : AquaTickTrader
//  Version     : 1.0
//  Description :
//      Multi-Moving Average trend framework designed for intraday and swing trading.
//      Combines SMA (8, 20, 50, 77) with ALMA(30) and RSI momentum bias.
//
//  Core Features:
//      • SMA 8  → Short-term momentum (dynamic color change)
//      • ALMA 30 → Smoothed adaptive trend filter
//      • SMA 20 → Short-term structure reference
//      • SMA 50 → Medium-term trend reference
//      • SMA 77 → Momentum-biased trend filter (colored by WMA of RSI)
//      • RSI Background Bias (Above/Below 50)
//
//  Visual Logic:
//      • Green line = Rising momentum
//      • Red line   = Falling momentum
//      • Background Green = RSI > 50 (Bullish bias)
//      • Background Red   = RSI < 50 (Bearish bias)
//
//  Intended Usage:
//      • Identify trend alignment (8 > 20 > 50 > 77 = strong uptrend)
//      • Use RSI background for directional bias confirmation
//      • ALMA 30 helps filter market noise
//      • SMA 77 color reflects RSI momentum strength
//
//  This script is for educational purposes only.
//──────────────────────────────────────────────────────────────────────────────

indicator(title="[TL5 SMA] SMA-ALMA Momentum System", overlay=true, timeframe="", timeframe_gaps=true)

//──────────────────────────────────────────────────────────────────────────────
// Momentum Component
//──────────────────────────────────────────────────────────────────────────────

// RSI (14) – Market momentum
rsi = ta.rsi(close, 14)

// WMA of RSI – Smooth momentum signal
wmarsi = ta.wma(rsi, 14)


//──────────────────────────────────────────────────────────────────────────────
// Background Bias (RSI 50 level)
//──────────────────────────────────────────────────────────────────────────────

bgcolor(
     rsi > 50 ? color.new(color.lime, 80) :
     rsi < 50 ? color.new(color.red, 80)  :
     na
)

//──────────────────────────────────────────────────────────────────────────────
// Moving Averages
//──────────────────────────────────────────────────────────────────────────────



// SMA 8 – Short-term momentum & ALMA 30 – Adaptive smoothing filter
sma8 = ta.sma(close, 8)
alma30 = ta.alma(close, 30, 0.85, 8)
plot(sma8, "SMA 8", color = sma8 > sma8[1] and sma8>alma30 and wmarsi > wmarsi[1]? color.green : sma8 < sma8[1] and sma8<alma30 and wmarsi < wmarsi[1]?color.red:sma8 < sma8[1] and sma8<alma30?color.yellow:sma8>sma8[1]?color.green:sma8<sma8[1]?color.red:color.gray, linewidth = 3)
plot(alma30, "ALMA 30", color = wmarsi > wmarsi[1] and sma8>alma30? color.lime : wmarsi < wmarsi[1] and sma8<alma30?color.red: sma8>sma8[1] and sma8>alma30? color.white:sma8<sma8[1] and sma8<alma30?color.yellow:color.gray, linewidth = 3)

// SMA 20 – Short-term structure
sma20 = ta.sma(close, 20)
plot(sma20, "SMA 20", color = color.blue, linewidth = 3, display = display.none)

// SMA 50 – Medium-term trend
sma50 = ta.sma(close, 50)
plot(sma50, "SMA 50", color = color.purple, linewidth = 3, display = display.none)


// SMA 77 – Long trend filter colored by RSI momentum direction
sma77 = ta.sma(close, 77)
plot(sma77, "SMA 77", color = color.black, linewidth = 3)
