//@version=6
indicator("Smoothed Stochastic Momentum Index [LuxAlgo]", shorttitle="SSMI", overlay=false)

// --- Constants ---
const color BULL_COLOR    = #089981
const color BEAR_COLOR    = #f23645
const color NEUTRAL_COLOR = #5b9cf6

// --- Inputs ---
// SSMI Settings
int   stochLen      = input.int(14, "Stochastic Length", minval=1, group="SSMI Settings")
int   smoothLen1    = input.int(3, "Internal Smoothing", minval=1, group="SSMI Settings")
int   smoothLen2    = input.int(3, "External Smoothing", minval=1, group="SSMI Settings")
int   signalLen     = input.int(9, "Signal Smoothing", minval=1, group="SSMI Settings")

// HTF Bias Settings
bool   useHtfFilter = input.bool(true, "Enable HTF Bias Filter", group="HTF Bias", tooltip="Only allows signals that align with the trend on a higher timeframe.")
string htfTimeframe = input.timeframe("60", "Higher Timeframe", group="HTF Bias", tooltip="The timeframe used to determine the 'Daily Bias' (e.g., 60m, 240m, Daily).")
int    htfEmaLen    = input.int(200, "HTF EMA Length", minval=1, group="HTF Bias")

// Local Filters
bool  usePriceFilter = input.bool(true, "Use Structure Breakout", group="Filters")
bool  useRangeFilter = input.bool(true, "Use Crossover Range Filter", group="Filters")
float rangeLower    = input.float(40, "Range Lower Bound", minval=0, maxval=100, group="Filters")
float rangeUpper    = input.float(60, "Range Upper Bound", minval=0, maxval=100, group="Filters")

bool  showSignals   = input.bool(true, "Show Signals on Chart", group="Visuals")
bool  showHtfBg     = input.bool(true, "Show HTF Bias Background", group="Visuals")

// --- Calculations ---
// SSMI Calculation
calc_dss(len, s1, s2) =>
    float low_  = ta.lowest(low, len)
    float high_ = ta.highest(high, len)
    float raw   = 100 * (close - low_) / math.max(high_ - low_, 1e-6)
    float smooth = ta.ema(ta.ema(raw, s1), s2)
    smooth

float ssmi   = calc_dss(stochLen, smoothLen1, smoothLen2)
float signal = ta.ema(ssmi, signalLen)
float hist   = ssmi - signal

// Higher Timeframe Bias Logic
[htfClose, htfEma] = request.security(syminfo.tickerid, htfTimeframe, [close, ta.ema(close, htfEmaLen)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
bool htfBullish = htfClose > htfEma
bool htfBearish = htfClose < htfEma

// Local Structure
float localHigh  = ta.highest(high[1], 2)
float localLow   = ta.lowest(low[1], 2)
bool  breakHigh  = close > localHigh
bool  breakLow   = close < localLow

// --- Signals ---
bool inRange    = ssmi >= rangeLower and ssmi <= rangeUpper
bool ssmiBullish = ta.crossover(ssmi, signal) and (useRangeFilter ? inRange : ssmi > 50)
bool ssmiBearish = ta.crossunder(ssmi, signal) and (useRangeFilter ? inRange : ssmi < 50)

bool longSignal  = ssmiBullish
bool shortSignal = ssmiBearish

// Apply HTF Filter
if useHtfFilter
    longSignal  := longSignal and htfBullish
    shortSignal := shortSignal and htfBearish

// Apply Price Filter
if usePriceFilter
    longSignal  := longSignal and breakHigh
    shortSignal := shortSignal and breakLow

// --- Visuals ---
// HTF Bias Background
bgcolor(showHtfBg and useHtfFilter ? (htfBullish ? color.new(BULL_COLOR, 90) : color.new(BEAR_COLOR, 90)) : na)

// Horizontal Levels
h_ob        = hline(80, "Overbought", color=color.new(chart.fg_color, 50), linestyle=hline.style_dashed)
h_os        = hline(20, "Oversold", color=color.new(chart.fg_color, 50), linestyle=hline.style_dashed)
plot_center = plot(50, "Center Line", color=color.new(chart.fg_color, 80), style=plot.style_linebr)

// Range Boundaries
plot(useRangeFilter ? rangeUpper : na, "Range Upper Bound", color=color.new(NEUTRAL_COLOR, 80), style=plot.style_circles)
plot(useRangeFilter ? rangeLower : na, "Range Lower Bound", color=color.new(NEUTRAL_COLOR, 80), style=plot.style_circles)

// Plots
ssmiPlot   = plot(ssmi, "SSMI Line", color = ssmi > 50 ? BULL_COLOR : BEAR_COLOR, linewidth=2)
signalPlot = plot(signal, "Signal Line", color = color.new(chart.fg_color, 40), linewidth=1)

// Centered Oscillator Gradient Fill
fill(ssmiPlot, plot_center, 
     top_value    = math.max(50, ssmi), 
     bottom_value = math.min(50, ssmi), 
     top_color    = ssmi > 50 ? color.new(BULL_COLOR, 50) : color.new(chart.bg_color, 100), 
     bottom_color = ssmi > 50 ? color.new(chart.bg_color, 100) : color.new(BEAR_COLOR, 50),
     title        = "Momentum Fill")

// Histogram
plot(hist, "Momentum Histogram", color = hist > 0 ? color.new(BULL_COLOR, 50) : color.new(BEAR_COLOR, 50), style=plot.style_columns)

// Chart Signals
plotshape(showSignals and longSignal, "Bullish Scalp", shape.triangleup, location.belowbar, BULL_COLOR, size=size.small, force_overlay=true)
plotshape(showSignals and shortSignal, "Bearish Scalp", shape.triangledown, location.abovebar, BEAR_COLOR, size=size.small, force_overlay=true)

// --- Alerts ---
alertcondition(longSignal, "Bullish Scalp Signal", "HTF-Filtered bullish momentum detected.")
alertcondition(shortSignal, "Bearish Scalp Signal", "HTF-Filtered bearish momentum detected.")
