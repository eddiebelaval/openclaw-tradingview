//@version=6
indicator("60-Point Signals On Price Chart", overlay=true)

// INPUTS
length = input.int(50, minval=1, title="Range MA Length")
mult = input.float(1.1, minval=0.1, title="ATR Multiplier")
threshold = input.float(60.0, minval=1, title="Oscillator Move Threshold")

// RANGE MA AND ATR
ma = ta.sma(close, length)
atrValue = ta.atr(200)
rangeATR = atrValue * mult

// OSCILLATOR (bar-aligned)
osc = rangeATR != 0 ? 100 * (close - ma) / rangeATR : 0

// DETECT SINGLE-CANDLE MOVE
// Instead of osc[1], we calculate using candle range itself
bigMoveUp = (close - open) / rangeATR * 100 >= threshold
bigMoveDn = (open - close) / rangeATR * 100 >= threshold

// PLOT SIGNALS ON PRICE CHART
plotshape(bigMoveUp, style=shape.triangleup, location=location.belowbar,
     color=color.lime, size=size.small, text="60↑")
plotshape(bigMoveDn, style=shape.triangledown, location=location.abovebar,
     color=color.red, size=size.small, text="60↓")

// OPTIONAL: PLOT RANGE MA
plot(ma, color=color.orange, linewidth=2)

// ALERTS
alertcondition(bigMoveUp, title="60pt Up Move", message="Bullish 60+ point move")
alertcondition(bigMoveDn, title="60pt Down Move", message="Bearish 60+ point move")
