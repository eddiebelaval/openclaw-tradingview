//@version=6
indicator("RenderingNature SMC Reversal Engine | Smart Money Concepts", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ============================================================
// === INPUTS ===
// ============================================================

// === DASHBOARD + STRUCTURE CONTROLS ===
dashboardPosition        = input.string("Top Right", "Dashboard Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group="Display")
htf                      = input.timeframe("60", "Higher Timeframe for Structure", group="Structure")
useIDMFilter             = input.bool(true, "Require Inducement Before CHoCH/BOS?", group="Structure")
structureShiftLookback   = input.int(8, "Structure Shift Lookback Bars", group="Structure")

// === FRACTAL SETTINGS ===
useAutoFractal           = input.bool(true, "Auto Fractal Sensitivity?", group="Fractal Settings")
manualFractalSensitivity = input.int(3, "Manual Sensitivity (Auto OFF)", minval=1, group="Fractal Settings")

// === CORE DISPLAY OPTIONS ===
showStructureLines       = input.bool(true,  "Show HTF High/Low Lines", group="Display")
showZigZag               = input.bool(true,  "Show ZigZag Lines", group="Display")
showPivotDots            = input.bool(true,  "Show Pivot Dots", group="Display")
minimalMode              = input.bool(false, "Minimal Mode (hide tables & most labels)", group="Display")
showStructureLabels      = input.bool(true,  "Show Structure Labels", group="Display")
showNextExpectation      = input.bool(true,  "Show Next Expected Structure", group="Display")
showInvalidationLabels   = input.bool(true,  "Show Invalidation Labels", group="Display")
showAnticipation         = input.bool(true,  "Show Anticipation Label", group="Display")
chochLabelOffset         = input.int(6, "CHoCH Label Offset", options=[2,4,6,8,12], group="Display")
bosLabelOffset           = input.int(4, "BOS Label Offset",   options=[2,4,6,8,12], group="Display")

// === ACCURACY DASHBOARD ===
showAccuracyChart        = input.bool(true, "Show Accuracy Mini-Chart", group="Display")
showPredictionAccuracy   = input.bool(true, "Show Prediction Accuracy", group="Display")
maxAccPoints             = input.int(20, "Max Accuracy History Points", minval=5, maxval=50, group="Display")

// === ORDER BLOCK SETTINGS ===
enableHTFob              = input.bool(true, "Enable HTF Order Blocks", group="Order Blocks")
obHTF                    = input.timeframe("W", "OB Timeframe (M/W/D)", group="Order Blocks")
maxOBs                   = input.int(3, "Max Order Blocks per Side", minval=1, group="Order Blocks")

// === OB DISPLAY OPTIONS ===
showOrderBlockZones      = input.bool(true,  "Show HTF Order Block Zones", group="OB Display")
onlyShowRecentOB         = input.bool(false, "Only Show Most Recent Unmitigated OB", group="OB Display")
fadeOldOBZones           = input.bool(true,  "Fade Old OB Zones", group="OB Display")
fadeOBsAfterBars         = input.int(50, "Fade OBs After X Bars (if unmitigated)", minval=5, group="OB Display")
maxOBOpacity             = input.int(60, "OB Fade Opacity (%)", minval=0, maxval=100, group="OB Display")
onlyShowCurrentTrend     = input.bool(false, "Only Show Current Trend Zones", group="OB Display")
useMinimalOB             = input.bool(true,  "Use Minimal OB Lines (No Shading)", group="OB Display")
obLineWidth              = input.int(2, "OB Line Width", minval=1, maxval=4, group="OB Display")
obLineStyleInput         = input.string("Dotted", "OB Line Style", options=["Solid","Dashed","Dotted"], group="OB Display")
showOBLabels             = input.bool(true,  "Show Order Block Labels", group="OB Display")
showTrendlineShading     = input.bool(true,  "Show Trendline Break Shading", group="OB Display")

// === BREAKER BLOCKS (Phase 4) ===
enableBreakerBlocks      = input.bool(true,  "Enable Breaker Blocks", group="Breaker Blocks")
maxBreakerBlocks         = input.int(3,      "Max Breaker Blocks per Side", minval=1, maxval=10, group="Breaker Blocks")
showBreakerLabels        = input.bool(true,  "Show Breaker Block Labels", group="Breaker Blocks")
breakerLineWidth         = input.int(2,      "Breaker Line Width", minval=1, maxval=4, group="Breaker Blocks")
breakerLineStyle         = input.string("Dashed", "Breaker Line Style", options=["Solid","Dashed","Dotted"], group="Breaker Blocks")
bullBreakerColor         = input.color(color.new(#FF6B6B, 0),  "Bull→Bear Breaker Color", group="Breaker Blocks")
bearBreakerColor         = input.color(color.new(#00BFFF, 0),  "Bear→Bull Breaker Color", group="Breaker Blocks")
showBreakerFill          = input.bool(true,  "Show Breaker Zone Fill", group="Breaker Blocks")
breakerFillTrans         = input.int(85,     "Breaker Fill Transparency", minval=0, maxval=100, group="Breaker Blocks")
wBreakerProx             = input.int(2,      "Weight: Breaker Block Proximity", minval=0, maxval=3, group="Breaker Blocks")

// === MITIGATION BLOCKS (Phase 4) ===
enableMitigationBlocks   = input.bool(true,  "Enable Mitigation Blocks", group="Mitigation Blocks")
maxMitigationBlocks      = input.int(3,      "Max Mitigation Blocks per Side", minval=1, maxval=10, group="Mitigation Blocks")
showMitigationLabels     = input.bool(true,  "Show Mitigation Block Labels", group="Mitigation Blocks")
mitigationLineWidth      = input.int(1,      "Mitigation Line Width", minval=1, maxval=4, group="Mitigation Blocks")
mitigationLineStyle      = input.string("Dotted", "Mitigation Line Style", options=["Solid","Dashed","Dotted"], group="Mitigation Blocks")
bullMitColor             = input.color(color.new(color.lime,   40), "Bull Mitigation Color", group="Mitigation Blocks")
bearMitColor             = input.color(color.new(color.orange, 40), "Bear Mitigation Color", group="Mitigation Blocks")
wMitigationProx          = input.int(1,      "Weight: Mitigation Block Proximity", minval=0, maxval=3, group="Mitigation Blocks")

// === FAIR VALUE GAP (FVG) SETTINGS ===
enableFVG                = input.bool(true,  "Enable FVG Zones", group="FVG Settings")
useTrendFilter           = input.bool(true,  "Only FVGs in Trend Direction", group="FVG Settings")
enableAutoEntry          = input.bool(false, "Auto-Enter on FVG Tap", group="FVG Settings")
markTapEntry             = input.bool(true,  "Mark Entry on FVG Tap", group="FVG Settings")
showFVGFill              = input.bool(true,  "Show FVG Fill", group="FVG Settings")
showFvgTapLine           = input.bool(true,  "Show FVG Tap Line", group="FVG Settings")
fvgTapLineBars           = input.int(8, "FVG Tap Line Extend (bars)", minval=1, maxval=50, group="FVG Settings")
fvgLabelOffset           = input.int(2, "FVG Label Left Offset", minval=0, maxval=10, group="FVG Settings")
maxFVGs                  = input.int(3, "Max FVG per Direction", minval=1, group="FVG Settings")
fvgExtend                = input.string("right", "FVG Extend", options=["right","none"], group="FVG Settings") == "right" ? extend.right : extend.none
fvgMaxLife               = input.int(50, "FVG Max Life (bars)", minval=10, group="FVG Settings")
enableFVGStrengthFilter  = input.bool(false, "Enable FVG Strength Filter", group="FVG Settings")
fvgStrengthThreshold     = input.float(1.5, "FVG Strength Threshold (X times body)", step=0.1, minval=0.1, group="FVG Settings")
fvgMitigationMethod      = input.string("wick", "FVG Removal Method", options=["wick", "close"], group="FVG Settings")
fvgRemovalDelayBars      = input.int(0, "Delay After Mitigation (bars)", minval=0, maxval=10, group="FVG Settings")

// === VOLUME-WEIGHTED FVG FILTER (Phase 3) ===
enableVolFVG             = input.bool(true,  "Enable Volume-Weighted FVG Filter", group="Vol FVG Filter")
volFVGLookback           = input.int(20,     "Volume SMA Lookback", minval=5, group="Vol FVG Filter")
volFVGMultiplier         = input.float(1.3,  "Min Volume Spike (X above SMA)", step=0.1, minval=1.0, group="Vol FVG Filter")
minDisplacementPct       = input.float(0.3,  "Min Displacement Body % of ATR", step=0.05, minval=0.0, group="Vol FVG Filter")
showVolFVGLabel          = input.bool(true,  "Label Strong FVGs", group="Vol FVG Filter")

// === AUTO FIBONACCI (Phase 3) ===
enableAutoFib            = input.bool(true,  "Enable Auto Fibonacci", group="Auto Fibonacci")
fibSource                = input.string("CHoCH/BOS", "Draw Fib From", options=["CHoCH/BOS", "Swing Memory"], group="Auto Fibonacci")
showFibLevels            = input.bool(true,  "Show All Fib Levels", group="Auto Fibonacci")
showOTEZone              = input.bool(true,  "Highlight OTE Zone (0.62–0.79)", group="Auto Fibonacci")
showFib50                = input.bool(true,  "Show 0.5 Level", group="Auto Fibonacci")
showFib618               = input.bool(true,  "Show 0.618 Level", group="Auto Fibonacci")
showFib705               = input.bool(true,  "Show 0.705 Level", group="Auto Fibonacci")
showFib79                = input.bool(true,  "Show 0.79 Level", group="Auto Fibonacci")
showFib100               = input.bool(true,  "Show 1.0 (Swing End)", group="Auto Fibonacci")
fibExtendBars            = input.int(50,     "Fib Line Extend (bars)", minval=10, maxval=200, group="Auto Fibonacci")
oteColor                 = input.color(color.new(#FFD700, 75), "OTE Zone Color", group="Auto Fibonacci")
fib50Color               = input.color(color.new(color.aqua,  0), "0.5 Color",   group="Auto Fibonacci")
fib618Color              = input.color(color.new(color.lime,  0), "0.618 Color", group="Auto Fibonacci")
fib705Color              = input.color(color.new(#FFD700,     0), "0.705 Color", group="Auto Fibonacci")
fib79Color               = input.color(color.new(color.orange,0), "0.79 Color",  group="Auto Fibonacci")
fib100Color              = input.color(color.new(color.red,   0), "1.0 Color",   group="Auto Fibonacci")
alertOnOTETouch          = input.bool(true,  "Alert When Price Enters OTE Zone", group="Auto Fibonacci")

// === TP / RR PROJECTION — FIB EXTENSIONS (Phase 5) ===
enableTPProjection       = input.bool(true,  "Enable TP Projection Lines", group="TP Projection")
showTP127                = input.bool(true,  "Show 1.27 Extension (TP1)", group="TP Projection")
showTP162                = input.bool(true,  "Show 1.618 Extension (TP2)", group="TP Projection")
showTP200                = input.bool(true,  "Show 2.0 Extension (TP3)", group="TP Projection")
showTP261                = input.bool(false, "Show 2.618 Extension (TP4 — aggressive)", group="TP Projection")
tpExtendBars             = input.int(80,     "TP Line Extend (bars)", minval=20, maxval=300, group="TP Projection")
tp1Color                 = input.color(color.new(color.lime,   0), "TP1 (1.27) Color",  group="TP Projection")
tp2Color                 = input.color(color.new(#00BFFF,      0), "TP2 (1.618) Color", group="TP Projection")
tp3Color                 = input.color(color.new(color.orange, 0), "TP3 (2.0) Color",   group="TP Projection")
tp4Color                 = input.color(color.new(color.red,    0), "TP4 (2.618) Color", group="TP Projection")
showSLLine               = input.bool(true,  "Show Stop Loss Line (below/above origin)", group="TP Projection")
slBufferATR              = input.float(0.5,  "SL Buffer (ATR multiplier)", step=0.1, minval=0.1, group="TP Projection")
slColor                  = input.color(color.new(color.red, 0), "SL Line Color", group="TP Projection")
showRRLabels             = input.bool(true,  "Show RR Ratio Labels on TP Lines", group="TP Projection")
alertOnTP1Hit            = input.bool(true,  "Alert on TP1 Hit", group="TP Projection")
alertOnTP2Hit            = input.bool(true,  "Alert on TP2 Hit", group="TP Projection")
useConfirmedHLLHOnly = input.bool(true, "Only Start Projection After HL/LH Confirm?", group="TP Projection")
showEntryLine = input.bool(true, "Show Entry Line", group="TP Projection")
entryColor = input.color(color.new(color.white, 0), "Entry Line Color", group="TP Projection")
tpLineWidth = input.int(2, "TP Line Width", minval=1, maxval=4, group="TP Projection")
slLineWidth = input.int(2, "SL Line Width", minval=1, maxval=4, group="TP Projection")

// === STATS MODE (Phase 6 Retail) ===
enableStatsMode = input.bool(true, "Enable Stats Mode", group="Stats Mode")
showStatsTable = input.bool(true, "Show Stats Table", group="Stats Mode")
statsPosition = input.string("Bottom Right", "Stats Position", options=["Top Left","Top Right","Bottom Left","Bottom Right"], group="Stats Mode")
countTP1AsWin = input.bool(false, "Count TP1 As Win Instead Of TP2?", group="Stats Mode")

// === SIMPLE MTF SCANNER (Phase 6 Retail) ===
enableMTFScanner = input.bool(true, "Enable MTF Scanner", group="MTF Scanner")
mtf1 = input.timeframe("D", "MTF 1", group="MTF Scanner")
mtf2 = input.timeframe("240", "MTF 2", group="MTF Scanner")
mtf3 = input.timeframe("60", "MTF 3", group="MTF Scanner")
showMTFTable = input.bool(true, "Show MTF Table", group="MTF Scanner")
mtfPosition = input.string("Top Left", "MTF Position", options=["Top Left","Top Right","Bottom Left","Bottom Right"], group="MTF Scanner")

// === EQ ZONE SETTINGS ===
enablePDZones            = input.bool(true, "Show Premium / Discount Zones", group="EQ Zones")
pdZoneTransparency       = input.int(85, "Zone Transparency (0–100)", minval=0, maxval=100, group="EQ Zones")
eqLineColor              = input.color(color.gray, "Equilibrium Line Color", group="EQ Zones")
premiumColor             = input.color(color.red, "Premium Zone Color", group="EQ Zones")
discountColor            = input.color(color.green, "Discount Zone Color", group="EQ Zones")

// === EARLY TOP DETECTION ===
enableEarlyTop           = input.bool(true,  "Enable Early-Top Warning", group="EarlyTop")
wickThresh               = input.float(0.5, "Wick Threshold (%)", step=0.1, group="EarlyTop")
rsiLen                   = input.int(14, "RSI Length", group="EarlyTop")
rsiOB                    = input.int(70, "RSI Overbought Level", group="EarlyTop")
earlyTopCooldownBars     = input.int(30, "Cooldown Bars Between Early Tops", minval=1, group="EarlyTop")

// === EARLY SIGNAL SETTINGS (from published) ===
enableEarlySignal        = input.bool(true,  "Enable Early HL/LH Signal", group="EarlySignal")
earlyRSILen              = input.int(14,     "Early-Signal RSI Length", group="EarlySignal", minval=5)
earlyRSIOver             = input.int(60,     "Early-Signal RSI Over-Threshold (Bullish)", group="EarlySignal", minval=50, maxval=100)
earlyRSIUnder            = input.int(40,     "Early-Signal RSI Under-Threshold (Bearish)", group="EarlySignal", minval=0, maxval=50)
enableEarlyVol           = input.bool(false, "Require Volume Spike for Early Signal?", group="EarlySignal")
volMultiplier            = input.float(1.5,  "Volume Spike Multiplier", group="EarlySignal", minval=1.0, step=0.1)

// === BUY / SELL SIGNALS ===
enableBuySell            = input.bool(true,  "Enable Buy/Sell Signals", group="Buy/Sell")
usePivotSignals          = input.bool(false, "Use Pivot-based Signals (instead of EMA)", group="Buy/Sell")
useAutoEMA               = input.bool(true,  "Auto EMA Lengths", group="Buy/Sell")
manualFastEMA            = input.int(9,   "Fast EMA Length", minval=1, group="Buy/Sell")
manualSlowEMA            = input.int(21,  "Slow EMA Length", minval=1, group="Buy/Sell")
emaGapThreshold          = input.float(0.5, "Minimum EMA Gap (%)", step=0.1, group="Buy/Sell")
buySellCooldownBars      = input.int(20,  "Cooldown Bars Between Signals", minval=1, group="Buy/Sell")

// === TRENDLINE CONTROLS ===
enableTrendlines         = input.bool(true,  "Auto Trendlines from Swings", group="Trendlines")
requireStrongTrend       = input.bool(true,  "Only Draw if Trend Confidence > 70%", group="Trendlines")
allowBothTrendlines      = input.bool(false, "Allow Bullish + Bearish Trendlines", group="Trendlines")
preserveTrendlines       = input.bool(true,  "Preserve Historical Trendlines", group="Trendlines")
maxTrendlines            = input.int(5, "Max Trendlines to Keep", minval=1, maxval=20, group="Trendlines")
enableTrendlineValidation= input.bool(true,  "Enable Trendline Validation", group="Trendlines")
trendlineBreakMode       = input.string("Close", "Trigger On", options=["Close", "Wick"], group="Trendlines")
highlightBrokenLines     = input.bool(true,  "Highlight Broken Lines", group="Trendlines")

// === LIQUIDITY SWEEPS ===
enableLiquiditySweep     = input.bool(true, "Enable Liquidity Sweep Detection", group="Liquidity Sweeps")
showSweepLabels          = input.bool(true, "Show Sweep Labels", group="Liquidity Sweeps")

// === EDUCATIONAL OVERLAYS ===
showSwingTags            = input.bool(true,  "Show HH/HL/LH/LL Tags", group="Educational")
showCheatSheet           = input.bool(true,  "Show SMC Quick Guide", group="Educational")
showOBLegend             = input.bool(true,  "Show OB Color Legend (ROYGBIV)", group="Educational")

// === CONFLUENCE SCORE + SETUP GRADES (from test version) ===
enableConfluence         = input.bool(true,  "Enable Confluence Score + Grades", group="Confluence")
minGradeForAlerts        = input.string("A", "Min Grade For Alerts", options=["C","B","A","S"], group="Confluence")
showConfluenceOnDash     = input.bool(true,  "Show Confluence Row in Dashboard", group="Confluence")
wTrendConf               = input.int(2, "Weight: Trend Confidence",              minval=0, maxval=3, group="Confluence")
wStructure               = input.int(2, "Weight: Structure (CHoCH/BOS)",          minval=0, maxval=3, group="Confluence")
wFvgTap                  = input.int(2, "Weight: FVG Tap",                        minval=0, maxval=3, group="Confluence")
wObProx                  = input.int(2, "Weight: OB Proximity",                   minval=0, maxval=3, group="Confluence")
wOTE                     = input.int(2, "Weight: OTE Zone Touch (Fib 0.62–0.79)", minval=0, maxval=3, group="Confluence")
wTrendlineBr             = input.int(2, "Weight: Trendline Break (reversal pressure)", minval=0, maxval=3, group="Confluence")

// === TREND CONFIDENCE ===
confEMAFastLen           = input.int(9,  "Conf Fast EMA Len",  group="Trend Confidence", minval=1)
confEMASlowLen           = input.int(21, "Conf Slow EMA Len",  group="Trend Confidence", minval=1)
confEMAweight            = input.float(0.4, "EMA Spread Weight",               group="Trend Confidence", minval=0.0, maxval=1.0, step=0.05)
confStructureW           = input.float(0.4, "Structure (BOS/CHoCH) Weight",    group="Trend Confidence", minval=0.0, maxval=1.0, step=0.05)
confSlopeW               = input.float(0.2, "Price Slope Weight",              group="Trend Confidence", minval=0.0, maxval=1.0, step=0.05)
confLookbackBars         = input.int(50, "Structure Lookback Bars",            group="Trend Confidence", minval=10)

// === PERFORMANCE CONTROLS ===
enableLightMode          = input.bool(false, "🔦 Light Mode (disables lines & labels)", group="Performance")
// ============================================================
// === CLEANUP CONTROLS ===
// ============================================================
displayMode = input.string("Balanced", "Chart Density", options=["Minimal", "Balanced", "Full"], group="Display")
zoneExtendBars = input.int(120, "Zone Extend Bars (cleanup)", minval=20, maxval=500, group="Display")
// Helpers
showMinimal = displayMode == "Minimal"
showBalancedOrMore = displayMode != "Minimal"
showFull = displayMode == "Full"
maxZigzagSwings          = input.int(20, "Max ZigZag Swings to Keep", minval=5, group="Performance")
maxEarlyTopLabels        = input.int(5,  "Max Recent Early-Top Labels", minval=1, group="Performance")
maxSwingHistory          = input.int(12, "Max Swing Memory", minval=4, maxval=50, group="Performance")

// ============================================================
// === ATR (CENTRALIZED) ===
// ============================================================
atrLenCore   = input.int(14, "ATR Length (Core)", minval=1, group="Vol FVG Filter")
atrCore      = ta.atr(atrLenCore)

// Mitigation “zone buffer” uses ATR * multiplier
mitAtrMult   = input.float(1.0, "Mitigation Buffer (x ATR)", step=0.1, minval=0.0, group="Mitigation Blocks")
atrMitBuffer = atrCore * mitAtrMult

// ============================================================
// === ROYGBIV COLORS ===
// ============================================================
var color[] rainbowColors = array.new_color()
if bar_index == 0
    array.push(rainbowColors, color.red)
    array.push(rainbowColors, color.new(#FFA500, 0))
    array.push(rainbowColors, color.yellow)
    array.push(rainbowColors, color.lime)
    array.push(rainbowColors, color.blue)
    array.push(rainbowColors, color.new(#4B0082, 0))
    array.push(rainbowColors, color.new(#9400D3, 0))

// ============================================================
// === FVG DELETION HELPER ===
// ============================================================
f_deleteFVG(_boxes, _bars, _touches, _i) =>
    if _i < array.size(_boxes) and _i < array.size(_bars) and _i < array.size(_touches)
        box.delete(array.get(_boxes, _i))
        array.remove(_boxes, _i)
        array.remove(_bars, _i)
        array.remove(_touches, _i)

// ============================================================
// === FRACTAL SENSITIVITY ===
// ============================================================
fractalSensitivity = useAutoFractal ? (
    htf == "1"   ? 1 :
    htf == "5"   ? 2 :
    htf == "15"  ? 3 :
    htf == "30"  ? 4 :
    htf == "60"  ? 5 :
    htf == "120" ? 6 :
    htf == "240" ? 7 :
    htf == "D"   ? 8 :
    htf == "W"   ? 10 : 12
    ) : manualFractalSensitivity

fractalSensitivity := math.max(2, fractalSensitivity)

// ============================================================
// === PIVOTS ===
// ============================================================
pivotHigh = ta.pivothigh(high, fractalSensitivity, fractalSensitivity)
pivotLow  = ta.pivotlow(low,  fractalSensitivity, fractalSensitivity)

// ============================================================
// === IDM TRACKING ===
// ============================================================
var float preBreakHigh = na
var float preBreakLow  = na

if not na(pivotHigh)
    preBreakHigh := high
if not na(pivotLow)
    preBreakLow := low

// ============================================================
// === LIQUIDITY SWEEP DETECTION ===
// ============================================================
var label[] sweepLabels = array.new_label()

bearSweep = not na(pivotHigh[1]) and high > pivotHigh[1] and close < pivotHigh[1]
bullSweep = not na(pivotLow[1])  and low  < pivotLow[1]  and close > pivotLow[1]

if enableLiquiditySweep and not minimalMode and showBalancedOrMore
    if bearSweep
        lbl = showSweepLabels ? label.new(bar_index, high, "🔻 Liquidity Sweep", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.tiny) : na
        if not na(lbl)
            array.push(sweepLabels, lbl)
    if bullSweep
        lbl = showSweepLabels ? label.new(bar_index, low, "🔺 Liquidity Sweep", color=color.green, textcolor=color.black, style=label.style_label_up, size=size.tiny) : na
        if not na(lbl)
            array.push(sweepLabels, lbl)
    if array.size(sweepLabels) > 10
        oldLbl = array.shift(sweepLabels)
        label.delete(oldLbl)

// ============================================================
// === TREND & SWING STATE ===
// ============================================================
var float lastSwingHigh = na
var float lastSwingLow  = na
var string trendDir     = "Neutral"

var bool showBullOBTap = false
var bool showBearOBTap = false

if not na(pivotHigh)
    lastSwingHigh := high
if not na(pivotLow)
    lastSwingLow := low

// ============================================================
// === CHoCH / BOS DETECTION ===
// ============================================================
bullishCHoCH = not na(pivotHigh) and pivotHigh > nz(lastSwingHigh[1]) and trendDir == "Bearish"
bearishCHoCH = not na(pivotLow)  and pivotLow  < nz(lastSwingLow[1])  and trendDir == "Bullish"

validBullCHoCH = bullishCHoCH and (not useIDMFilter or high > preBreakHigh)
validBearCHoCH = bearishCHoCH and (not useIDMFilter or low  < preBreakLow)

bullishBOS = not na(pivotLow)  and pivotLow  > nz(lastSwingLow[1])
bearishBOS = not na(pivotHigh) and pivotHigh < nz(lastSwingHigh[1])

trendDir := validBullCHoCH or bullishBOS ? "Bullish" : validBearCHoCH or bearishBOS ? "Bearish" : trendDir

// ============================================================
// === HTF ORDER BLOCKS ===
// ============================================================
obHigh = request.security(syminfo.tickerid, obHTF, ta.pivothigh(high, 5, 5)[1])
obLow  = request.security(syminfo.tickerid, obHTF, ta.pivotlow(low,  5, 5)[1])

var line[]  bullOBTopLines    = array.new_line()
var line[]  bullOBBottomLines = array.new_line()
var line[]  bearOBTopLines    = array.new_line()
var line[]  bearOBBottomLines = array.new_line()
var box[]   bullOBs           = array.new_box()
var box[]   bearOBs           = array.new_box()
var bool[]  bullOBMitigated   = array.new_bool()
var bool[]  bearOBMitigated   = array.new_bool()
var label[] bullOBLabels      = array.new_label()
var label[] bearOBLabels      = array.new_label()

var bool newBullOBMitigation = false
var bool newBearOBMitigation = false
newBullOBMitigation := false
newBearOBMitigation := false

var float lastBullOB = na
var float lastBearOB = na
var int   lastOBBar  = na

// --- OB line style helper (used in minimal mode) ---
line_style = obLineStyleInput == "Solid"  ? line.style_solid :
             obLineStyleInput == "Dashed" ? line.style_dashed :
             line.style_dotted

// --- Function: Create HTF Order Block ---
f_createHTFOB(_isBull, _proximal, _distal, _obPrice) =>
    float top    = math.max(_proximal, _distal)
    float bottom = math.min(_proximal, _distal)

    int left  = bar_index
    int right = bar_index + zoneExtendBars

    int idx = _isBull ? array.size(bullOBTopLines) % array.size(rainbowColors) :array.size(bearOBTopLines) % array.size(rainbowColors)
    color obColor = array.get(rainbowColors, idx)

    if not useMinimalOB
        box ob = box.new(left=left, right=right, top=top, bottom=bottom,
            border_color=obColor, bgcolor=color.new(obColor, 85), extend=extend.right)
        if _isBull
            array.push(bullOBs, ob)
            array.push(bullOBMitigated, false)
        else
            array.push(bearOBs, ob)
            array.push(bearOBMitigated, false)

    if useMinimalOB
        line topLine = line.new(left, top, right, top,
            extend=extend.right, color=obColor, style=line_style, width=obLineWidth)
        line botLine = line.new(left, bottom, right, bottom,
            extend=extend.right, color=obColor, style=line_style, width=obLineWidth)

        if _isBull
            array.push(bullOBTopLines, topLine)
            array.push(bullOBBottomLines, botLine)
            array.push(bullOBMitigated, false)
        else
            array.push(bearOBTopLines, topLine)
            array.push(bearOBBottomLines, botLine)
            array.push(bearOBMitigated, false)

    if showOBLabels and not minimalMode and not enableLightMode and showBalancedOrMore
        int seqNum = _isBull ? array.size(bullOBTopLines) : array.size(bearOBTopLines)
        label lbl = label.new(bar_index, _obPrice, "OB #" + str.tostring(seqNum),
            style=label.style_label_left, textcolor=color.white,
            color=color.new(obColor, 80), size=size.tiny)
        if _isBull
            array.push(bullOBLabels, lbl)
        else
            array.push(bearOBLabels, lbl)

    // Limit how many OBs we keep
    if _isBull
        while array.size(bullOBMitigated) > maxOBs
            if useMinimalOB
                line.delete(array.shift(bullOBTopLines))
                line.delete(array.shift(bullOBBottomLines))
            else
                box.delete(array.shift(bullOBs))
            array.shift(bullOBMitigated)
            if array.size(bullOBLabels) > 0
                label.delete(array.shift(bullOBLabels))
    else
        while array.size(bearOBMitigated) > maxOBs
            if useMinimalOB
                line.delete(array.shift(bearOBTopLines))
                line.delete(array.shift(bearOBBottomLines))
            else
                box.delete(array.shift(bearOBs))
            array.shift(bearOBMitigated)
            if array.size(bearOBLabels) > 0
                label.delete(array.shift(bearOBLabels))

// OB Creation Trigger
if enableHTFob
    if not na(obLow) and (na(lastBullOB) or obLow != lastBullOB)
        f_createHTFOB(true, high, obLow, obLow)
        lastBullOB := obLow
        lastOBBar  := bar_index

    if not na(obHigh) and (na(lastBearOB) or obHigh != lastBearOB)
        f_createHTFOB(false, low, obHigh, obHigh)
        lastBearOB := obHigh
        lastOBBar  := bar_index

// Auto-Fade unmitigated OBs
if useMinimalOB and fadeOBsAfterBars > 0
    if array.size(bullOBTopLines) > 0
        for i = 0 to array.size(bullOBTopLines) - 1
            if i < array.size(bullOBMitigated) and not array.get(bullOBMitigated, i)
                line tl = array.get(bullOBTopLines, i)
                line bl = array.get(bullOBBottomLines, i)
                if not na(tl) and not na(bl) and (bar_index - line.get_x1(tl)) > fadeOBsAfterBars
                    line.set_color(tl, color.new(color.gray, 70))
                    line.set_color(bl, color.new(color.gray, 70))

    if array.size(bearOBTopLines) > 0
        for i = 0 to array.size(bearOBTopLines) - 1
            if i < array.size(bearOBMitigated) and not array.get(bearOBMitigated, i)
                line tl = array.get(bearOBTopLines, i)
                line bl = array.get(bearOBBottomLines, i)
                if not na(tl) and not na(bl) and (bar_index - line.get_x1(tl)) > fadeOBsAfterBars
                    line.set_color(tl, color.new(color.gray, 70))
                    line.set_color(bl, color.new(color.gray, 70))

// OB Mitigation Detection
if useMinimalOB
    if array.size(bullOBTopLines) > 0
        for i = 0 to array.size(bullOBTopLines) - 1
            if i < array.size(bullOBMitigated) and not array.get(bullOBMitigated, i)
                line tl = array.get(bullOBTopLines, i)
                line bl = array.get(bullOBBottomLines, i)
                if not na(tl) and not na(bl)
                    float bot = line.get_y1(bl)
                    if close < bot
                        array.set(bullOBMitigated, i, true)
                        newBullOBMitigation := true
                        line.set_color(tl, color.new(color.gray, 60))
                        line.set_color(bl, color.new(color.gray, 60))
                        line.set_style(tl, line.style_dashed)
                        line.set_style(bl, line.style_dashed)
                        if array.size(bullOBLabels) > i
                            label oldLbl = array.get(bullOBLabels, i)
                            if not na(oldLbl)
                                label.delete(oldLbl)
                        if showOBLabels and not minimalMode
                            label newLbl = label.new(bar_index, bot, "Bull OB Mitigated",
                                style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.small)
                            if array.size(bullOBLabels) > i
                                array.set(bullOBLabels, i, newLbl)
                            else
                                array.push(bullOBLabels, newLbl)

    if array.size(bearOBTopLines) > 0
        for i = 0 to array.size(bearOBTopLines) - 1
            if i < array.size(bearOBMitigated) and not array.get(bearOBMitigated, i)
                line tl = array.get(bearOBTopLines, i)
                line bl = array.get(bearOBBottomLines, i)
                if not na(tl) and not na(bl)
                    float top = line.get_y1(tl)
                    if close > top
                        array.set(bearOBMitigated, i, true)
                        newBearOBMitigation := true
                        line.set_color(tl, color.new(color.gray, 60))
                        line.set_color(bl, color.new(color.gray, 60))
                        line.set_style(tl, line.style_dashed)
                        line.set_style(bl, line.style_dashed)
                        if array.size(bearOBLabels) > i
                            label oldLbl = array.get(bearOBLabels, i)
                            if not na(oldLbl)
                                label.delete(oldLbl)
                        if showOBLabels and not minimalMode
                            label newLbl = label.new(bar_index, top, "Bear OB Mitigated",
                                style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.small)
                            if array.size(bearOBLabels) > i
                                array.set(bearOBLabels, i, newLbl)
                            else
                                array.push(bearOBLabels, newLbl)

// Only Show Most Recent Unmitigated OB
int lastBullIdx = na
int lastBearIdx = na

if onlyShowRecentOB
    if array.size(bullOBMitigated) > 0
        for i = array.size(bullOBMitigated) - 1 to 0
            if not array.get(bullOBMitigated, i)
                lastBullIdx := i
                break
    if array.size(bearOBMitigated) > 0
        for i = array.size(bearOBMitigated) - 1 to 0
            if not array.get(bearOBMitigated, i)
                lastBearIdx := i
                break

if onlyShowRecentOB and useMinimalOB
    if array.size(bullOBTopLines) > 0
        for i = array.size(bullOBTopLines) - 1 to 0
            bool isLast = (i == lastBullIdx)
            if not isLast
                line tl = array.get(bullOBTopLines, i)
                line bl = array.get(bullOBBottomLines, i)
                if not na(tl)
                    line.delete(tl)
                if not na(bl)
                    line.delete(bl)
                array.set(bullOBTopLines, i, na)
                array.set(bullOBBottomLines, i, na)
                if array.size(bullOBLabels) > i
                    label lbl = array.get(bullOBLabels, i)
                    if not na(lbl)
                        label.delete(lbl)
                    array.set(bullOBLabels, i, na)
            else
                if array.size(bullOBLabels) > i
                    label lbl = array.get(bullOBLabels, i)
                    if not na(lbl)
                        label.set_textcolor(lbl, color.white)

    if array.size(bearOBTopLines) > 0
        for i = array.size(bearOBTopLines) - 1 to 0
            bool isLast = (i == lastBearIdx)
            if not isLast
                line tl = array.get(bearOBTopLines, i)
                line bl = array.get(bearOBBottomLines, i)
                if not na(tl)
                    line.delete(tl)
                if not na(bl)
                    line.delete(bl)
                array.set(bearOBTopLines, i, na)
                array.set(bearOBBottomLines, i, na)
                if array.size(bearOBLabels) > i
                    label lbl = array.get(bearOBLabels, i)
                    if not na(lbl)
                        label.delete(lbl)
                    array.set(bearOBLabels, i, na)
            else
                if array.size(bearOBLabels) > i
                    label lbl = array.get(bearOBLabels, i)
                    if not na(lbl)
                        label.set_textcolor(lbl, color.white)

// OB Status for dashboard
lastBullOBMitigated = array.size(bullOBMitigated) > 0 ? array.get(bullOBMitigated, array.size(bullOBMitigated) - 1) : false
lastBearOBMitigated = array.size(bearOBMitigated) > 0 ? array.get(bearOBMitigated, array.size(bearOBMitigated) - 1) : false

// ============================================================
// === BREAKER BLOCKS (Phase 4) ===
// ============================================================
// Lifecycle:
//   1. A Bull OB gets violated (close < OB bottom) → becomes a Bear Breaker
//   2. A Bear OB gets violated (close > OB top)    → becomes a Bull Breaker
//   3. Breaker is "tapped" when price returns into its zone
//   4. After tap, breaker is marked mitigated and fades
//
// This completes the full OB lifecycle:
//   Fresh OB → Mitigated OB → Breaker Block → Tapped Breaker

bkrLineStyle = breakerLineStyle == "Solid"  ? line.style_solid  :
               breakerLineStyle == "Dashed" ? line.style_dashed :
               line.style_dotted

// Breaker storage arrays
var line[]  bullBkrTopLines  = array.new_line()
var line[]  bullBkrBotLines  = array.new_line()
var line[]  bearBkrTopLines  = array.new_line()
var line[]  bearBkrBotLines  = array.new_line()
var box[]   bullBkrBoxes     = array.new_box()
var box[]   bearBkrBoxes     = array.new_box()
var bool[]  bullBkrTapped    = array.new_bool()
var bool[]  bearBkrTapped    = array.new_bool()
var label[] bullBkrLabels    = array.new_label()
var label[] bearBkrLabels    = array.new_label()

var bool newBullBreaker = false
var bool newBearBreaker = false
newBullBreaker := false
newBearBreaker := false

// When a Bull OB is newly mitigated → spawn Bear Breaker from that zone
if enableBreakerBlocks and newBullOBMitigation and useMinimalOB
    int mitIdx = na
    for i = array.size(bullOBMitigated) - 1 to 0
        if array.get(bullOBMitigated, i)
            mitIdx := i
            break

    if not na(mitIdx) and mitIdx < array.size(bullOBTopLines) and mitIdx < array.size(bullOBBottomLines)
        line tl = array.get(bullOBTopLines, mitIdx)
        line bl = array.get(bullOBBottomLines, mitIdx)
        if not na(tl) and not na(bl)
            float zTop = math.max(line.get_y1(tl), line.get_y1(bl))
            float zBot = math.min(line.get_y1(tl), line.get_y1(bl))
            int lx = bar_index
            int rx = bar_index + 60

            // Lines
            line newTop = line.new(lx, zTop, rx, zTop, extend=extend.right,
                color=bullBreakerColor, style=bkrLineStyle, width=breakerLineWidth)
            line newBot = line.new(lx, zBot, rx, zBot, extend=extend.right,
                color=bullBreakerColor, style=bkrLineStyle, width=breakerLineWidth)
            array.push(bearBkrTopLines, newTop)
            array.push(bearBkrBotLines, newBot)
            array.push(bearBkrTapped, false)

            // Fill box
            if showBreakerFill
                array.push(bearBkrBoxes, box.new(lx, zTop, rx, zBot,
                    bgcolor=color.new(bullBreakerColor, breakerFillTrans),
                    border_color=na, extend=extend.right))

            // Label
            if showBreakerLabels and not minimalMode and showBalancedOrMore
                array.push(bearBkrLabels, label.new(lx, zTop, "🔴 Bear Breaker",
                    style=label.style_label_right, color=color.new(bullBreakerColor, 70),
                    textcolor=color.white, size=size.small))

            newBullBreaker := true

            // Prune oldest
            while array.size(bearBkrTopLines) > maxBreakerBlocks
                line.delete(array.shift(bearBkrTopLines))
                line.delete(array.shift(bearBkrBotLines))
                array.shift(bearBkrTapped)
                if array.size(bearBkrBoxes) > 0
                    box.delete(array.shift(bearBkrBoxes))
                if array.size(bearBkrLabels) > 0
                    label.delete(array.shift(bearBkrLabels))

// When a Bear OB is newly mitigated → spawn Bull Breaker from that zone
if enableBreakerBlocks and newBearOBMitigation and useMinimalOB
    int mitIdx = na
    for i = array.size(bearOBMitigated) - 1 to 0
        if array.get(bearOBMitigated, i)
            mitIdx := i
            break

    if not na(mitIdx) and mitIdx < array.size(bearOBTopLines) and mitIdx < array.size(bearOBBottomLines)
        line tl = array.get(bearOBTopLines, mitIdx)
        line bl = array.get(bearOBBottomLines, mitIdx)
        if not na(tl) and not na(bl)
            float zTop = math.max(line.get_y1(tl), line.get_y1(bl))
            float zBot = math.min(line.get_y1(tl), line.get_y1(bl))
            int lx = bar_index
            int rx = bar_index + 60

            line newTop = line.new(lx, zTop, rx, zTop, extend=extend.right,
                color=bearBreakerColor, style=bkrLineStyle, width=breakerLineWidth)
            line newBot = line.new(lx, zBot, rx, zBot, extend=extend.right,
                color=bearBreakerColor, style=bkrLineStyle, width=breakerLineWidth)
            array.push(bullBkrTopLines, newTop)
            array.push(bullBkrBotLines, newBot)
            array.push(bullBkrTapped, false)

            if showBreakerFill
                array.push(bullBkrBoxes, box.new(lx, zTop, rx, zBot,
                    bgcolor=color.new(bearBreakerColor, breakerFillTrans),
                    border_color=na, extend=extend.right))

            if showBreakerLabels and not minimalMode
                array.push(bullBkrLabels, label.new(lx, zTop, "🔵 Bull Breaker",
                    style=label.style_label_right, color=color.new(bearBreakerColor, 70),
                    textcolor=color.white, size=size.small))

            newBearBreaker := true

            while array.size(bullBkrTopLines) > maxBreakerBlocks
                line.delete(array.shift(bullBkrTopLines))
                line.delete(array.shift(bullBkrBotLines))
                array.shift(bullBkrTapped)
                if array.size(bullBkrBoxes) > 0
                    box.delete(array.shift(bullBkrBoxes))
                if array.size(bullBkrLabels) > 0
                    label.delete(array.shift(bullBkrLabels))

// Breaker tap detection + mitigation fade
var bool bullBkrTappedThisBar = false
var bool bearBkrTappedThisBar = false
bullBkrTappedThisBar := false
bearBkrTappedThisBar := false

if enableBreakerBlocks
    // Bull Breaker taps (price re-enters zone from below)
    if array.size(bullBkrTopLines) > 0
        for i = array.size(bullBkrTopLines) - 1 to 0
            if i < array.size(bullBkrTapped) and not array.get(bullBkrTapped, i)
                line tl = array.get(bullBkrTopLines, i)
                line bl = array.get(bullBkrBotLines, i)
                if not na(tl) and not na(bl)
                    float zTop = line.get_y1(tl)
                    float zBot = line.get_y1(bl)
                    if low <= zTop and high >= zBot
                        bullBkrTappedThisBar := true
                        array.set(bullBkrTapped, i, true)
                        line.set_color(tl, color.new(color.gray, 60))
                        line.set_color(bl, color.new(color.gray, 60))
                        line.set_style(tl, line.style_dashed)
                        line.set_style(bl, line.style_dashed)
                        if not minimalMode
                            label.new(bar_index, zTop, "🔵 Bull Breaker Tapped",
                                style=label.style_label_left, color=color.new(bearBreakerColor, 70),
                                textcolor=color.white, size=size.small)

    // Bear Breaker taps (price re-enters zone from above)
    if array.size(bearBkrTopLines) > 0
        for i = array.size(bearBkrTopLines) - 1 to 0
            if i < array.size(bearBkrTapped) and not array.get(bearBkrTapped, i)
                line tl = array.get(bearBkrTopLines, i)
                line bl = array.get(bearBkrBotLines, i)
                if not na(tl) and not na(bl)
                    float zTop = line.get_y1(tl)
                    float zBot = line.get_y1(bl)
                    if low <= zTop and high >= zBot
                        bearBkrTappedThisBar := true
                        array.set(bearBkrTapped, i, true)
                        line.set_color(tl, color.new(color.gray, 60))
                        line.set_color(bl, color.new(color.gray, 60))
                        line.set_style(tl, line.style_dashed)
                        line.set_style(bl, line.style_dashed)
                        if not minimalMode
                            label.new(bar_index, zTop, "🔴 Bear Breaker Tapped",
                                style=label.style_label_left, color=color.new(bullBreakerColor, 70),
                                textcolor=color.white, size=size.small)

// Breaker proximity for confluence
bool bullBkrNear = false
bool bearBkrNear = false

if enableBreakerBlocks
    if array.size(bullBkrTopLines) > 0
        for i = 0 to array.size(bullBkrTopLines) - 1
            if i < array.size(bullBkrTapped) and not array.get(bullBkrTapped, i)
                line tl = array.get(bullBkrTopLines, i)
                line bl = array.get(bullBkrBotLines, i)
                if not na(tl) and not na(bl)
                    float zTop = line.get_y1(tl)
                    float zBot = line.get_y1(bl)
                    if low <= zTop and high >= zBot
                        bullBkrNear := true

    if array.size(bearBkrTopLines) > 0
        for i = 0 to array.size(bearBkrTopLines) - 1
            if i < array.size(bearBkrTapped) and not array.get(bearBkrTapped, i)
                line tl = array.get(bearBkrTopLines, i)
                line bl = array.get(bearBkrBotLines, i)
                if not na(tl) and not na(bl)
                    float zTop = line.get_y1(tl)
                    float zBot = line.get_y1(bl)
                    if low <= zTop and high >= zBot
                        bearBkrNear := true

// ============================================================
// === MITIGATION BLOCKS (Phase 4) ===
// ============================================================
// A Mitigation Block is an OB zone that produced a confirmed swing point
// (pivot high or pivot low formed inside or near the OB).
// When price returns, it's a high-probability zone because we know
// institutional activity already happened there.

mitLineStyle = mitigationLineStyle == "Solid"  ? line.style_solid  :
               mitigationLineStyle == "Dashed" ? line.style_dashed :
               line.style_dotted

var line[]  bullMitTopLines = array.new_line()
var line[]  bullMitBotLines = array.new_line()
var line[]  bearMitTopLines = array.new_line()
var line[]  bearMitBotLines = array.new_line()
var bool[]  bullMitActive   = array.new_bool()
var bool[]  bearMitActive   = array.new_bool()
var label[] bullMitLabels   = array.new_label()
var label[] bearMitLabels   = array.new_label()

// Spawn Bull Mitigation Block when a pivot LOW forms near an active Bull OB
if enableMitigationBlocks and not na(pivotLow) and useMinimalOB
    if array.size(bullOBTopLines) > 0
        for i = array.size(bullOBTopLines) - 1 to 0
            if i < array.size(bullOBMitigated) and not array.get(bullOBMitigated, i)
                line tl = array.get(bullOBTopLines, i)
                line bl = array.get(bullOBBottomLines, i)
                if not na(tl) and not na(bl)
                    float zTop = line.get_y1(tl)
                    float zBot = line.get_y1(bl)
                    // Pivot low formed inside or within 1 ATR of the OB zone
                    if low >= zBot - atrMitBuffer and low <= zTop + atrMitBuffer
                        int lx = bar_index
                        line newTop = line.new(lx, zTop, lx + 60, zTop, extend=extend.right,
                            color=bullMitColor, style=mitLineStyle, width=mitigationLineWidth)
                        line newBot = line.new(lx, zBot, lx + 60, zBot, extend=extend.right,
                            color=bullMitColor, style=mitLineStyle, width=mitigationLineWidth)
                        array.push(bullMitTopLines, newTop)
                        array.push(bullMitBotLines, newBot)
                        array.push(bullMitActive, true)
                        if showMitigationLabels and not minimalMode and showBalancedOrMore
                            array.push(bullMitLabels, label.new(lx, zTop, "📌 Bull Mitigation",
                                style=label.style_label_right, color=color.new(bullMitColor, 70),
                                textcolor=color.black, size=size.tiny))

                        while array.size(bullMitTopLines) > maxMitigationBlocks
                            line.delete(array.shift(bullMitTopLines))
                            line.delete(array.shift(bullMitBotLines))
                            array.shift(bullMitActive)
                            if array.size(bullMitLabels) > 0
                                label.delete(array.shift(bullMitLabels))
                        break

// Spawn Bear Mitigation Block when a pivot HIGH forms near an active Bear OB
if enableMitigationBlocks and not na(pivotHigh) and useMinimalOB
    if array.size(bearOBTopLines) > 0
        for i = array.size(bearOBTopLines) - 1 to 0
            if i < array.size(bearOBMitigated) and not array.get(bearOBMitigated, i)
                line tl = array.get(bearOBTopLines, i)
                line bl = array.get(bearOBBottomLines, i)
                if not na(tl) and not na(bl)
                    float zTop = line.get_y1(tl)
                    float zBot = line.get_y1(bl)
                    if high <= zTop + atrMitBuffer and high >= zBot - atrMitBuffer 
                        int lx = bar_index
                        line newTop = line.new(lx, zTop, lx + 60, zTop, extend=extend.right,
                            color=bearMitColor, style=mitLineStyle, width=mitigationLineWidth)
                        line newBot = line.new(lx, zBot, lx + 60, zBot, extend=extend.right,
                            color=bearMitColor, style=mitLineStyle, width=mitigationLineWidth)
                        array.push(bearMitTopLines, newTop)
                        array.push(bearMitBotLines, newBot)
                        array.push(bearMitActive, true)
                        if showMitigationLabels and not minimalMode
                            array.push(bearMitLabels, label.new(lx, zTop, "📌 Bear Mitigation",
                                style=label.style_label_right, color=color.new(bearMitColor, 70),
                                textcolor=color.black, size=size.tiny))

                        while array.size(bearMitTopLines) > maxMitigationBlocks
                            line.delete(array.shift(bearMitTopLines))
                            line.delete(array.shift(bearMitBotLines))
                            array.shift(bearMitActive)
                            if array.size(bearMitLabels) > 0
                                label.delete(array.shift(bearMitLabels))
                        break

// Mitigation Block proximity for confluence
bool bullMitNear = false
bool bearMitNear = false

if enableMitigationBlocks
    if array.size(bullMitTopLines) > 0
        for i = 0 to array.size(bullMitTopLines) - 1
            if i < array.size(bullMitActive) and array.get(bullMitActive, i)
                line tl = array.get(bullMitTopLines, i)
                line bl = array.get(bullMitBotLines, i)
                if not na(tl) and not na(bl)
                    float zTop = line.get_y1(tl)
                    float zBot = line.get_y1(bl)
                    if low <= zTop and high >= zBot
                        bullMitNear := true

    if array.size(bearMitTopLines) > 0
        for i = 0 to array.size(bearMitTopLines) - 1
            if i < array.size(bearMitActive) and array.get(bearMitActive, i)
                line tl = array.get(bearMitTopLines, i)
                line bl = array.get(bearMitBotLines, i)
                if not na(tl) and not na(bl)
                    float zTop = line.get_y1(tl)
                    float zBot = line.get_y1(bl)
                    if low <= zTop and high >= zBot
                        bearMitNear := true


// ============================================================
confFastEMA = ta.ema(close, confEMAFastLen)
confSlowEMA = ta.ema(close, confEMASlowLen)
emaScore    = math.min(100, math.abs(confFastEMA - confSlowEMA) / close * 100 * 10)

structEvents = 0
for i = 1 to confLookbackBars
    structEvents += (bullishBOS[i] or bearishBOS[i] or validBullCHoCH[i] or validBearCHoCH[i]) ? 1 : 0
maxStructEvents = math.max(1, confLookbackBars / 10)
structScore     = math.min(100, structEvents / maxStructEvents * 100)

lookbackPrice = close[confLookbackBars]
priceSlopePct = (close - lookbackPrice) / lookbackPrice * 100
slopeScore    = math.min(100, math.abs(priceSlopePct) * 5)

trendConfScore = math.round(emaScore * confEMAweight + structScore * confStructureW + slopeScore * confSlopeW)

// ============================================================
// === STRUCTURE SHIFT DETECTOR ===
// ============================================================
var label[] shiftLabels = array.new_label()
var int bullBOSBar = na
var int bearBOSBar = na

if bullishBOS
    bullBOSBar := bar_index
if bearishBOS
    bearBOSBar := bar_index

bullShift = validBullCHoCH and not na(bullBOSBar) and bar_index - bullBOSBar <= structureShiftLookback
bearShift = validBearCHoCH and not na(bearBOSBar) and bar_index - bearBOSBar <= structureShiftLookback

if bullShift
    array.push(shiftLabels, label.new(bar_index, low, "⬆️ Structure Shift",
        style=label.style_label_up, color=color.lime, textcolor=color.black, size=size.normal))
if bearShift
    array.push(shiftLabels, label.new(bar_index, high, "⬇️ Structure Shift",
        style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal))
if array.size(shiftLabels) > 10
    label.delete(array.shift(shiftLabels))

// ============================================================
// === STRUCTURE LABELS ===
// ============================================================
maxStructureLabels = switch htf
    "1"   => 2
    "5"   => 4
    "15"  => 6
    "30"  => 8
    "60"  => 10
    "120" => 12
    "240" => 14
    "D"   => 21
    "W"   => 26
    => 10

var label[] structureLabels = array.new_label()

f_addStructLbl(_lbl) =>
    array.push(structureLabels, _lbl)
    if array.size(structureLabels) > maxStructureLabels
        label.delete(array.shift(structureLabels))

f_drawLabelLine(_offset, _y, _txt, _col) =>
    lineEnd = bar_index + _offset * 8
    line.new(bar_index, _y, lineEnd, _y, style=line.style_dotted, color=_col)
    label.new(lineEnd, _y, _txt, style=label.style_label_left, color=na, textcolor=color.white, size=size.small)

if showStructureLabels and not minimalMode and not enableLightMode and showBalancedOrMore
    if validBullCHoCH
        f_addStructLbl(f_drawLabelLine(chochLabelOffset, high, "CHoCH ↑ $" + str.tostring(high, "#.##"), color.orange))
    if validBearCHoCH
        f_addStructLbl(f_drawLabelLine(chochLabelOffset, low,  "CHoCH ↓ $" + str.tostring(low,  "#.##"), color.orange))
    if bullishBOS
        f_addStructLbl(f_drawLabelLine(bosLabelOffset, high, "BOS ↑ $" + str.tostring(high, "#.##"), color.lime))
    if bearishBOS
        f_addStructLbl(f_drawLabelLine(bosLabelOffset, low,  "BOS ↓ $" + str.tostring(low,  "#.##"), color.red))

// ============================================================
// === HTF SWING HIGH/LOW (Support & Resistance) ===
// ============================================================
htfPivotHigh = request.security(syminfo.tickerid, htf, ta.pivothigh(high, fractalSensitivity, fractalSensitivity)[1])
htfPivotLow  = request.security(syminfo.tickerid, htf, ta.pivotlow(low,  fractalSensitivity, fractalSensitivity)[1])

var float htfLastHigh = na
var float htfLastLow  = na
if not na(htfPivotHigh)
    htfLastHigh := htfPivotHigh
if not na(htfPivotLow)
    htfLastLow  := htfPivotLow

plot(showStructureLines ? htfLastHigh : na, title="HTF Resistance", color=color.red,   linewidth=2, style=plot.style_linebr)
plot(showStructureLines ? htfLastLow  : na, title="HTF Support",    color=color.green, linewidth=2, style=plot.style_linebr)

// ============================================================
// === PREMIUM / DISCOUNT ZONES ===
// ============================================================
var box  premiumBox  = na
var box  discountBox = na
var line eqLine      = na

if enablePDZones and not na(lastSwingHigh) and not na(lastSwingLow)
    float eqPrice = (lastSwingHigh + lastSwingLow) / 2
    if not na(premiumBox)
        box.delete(premiumBox)
    if not na(discountBox)
        box.delete(discountBox)
    if not na(eqLine)
        line.delete(eqLine)
    premiumBox  := box.new(left=bar_index, top=lastSwingHigh, right=bar_index + 50, bottom=eqPrice,
        bgcolor=color.new(premiumColor, pdZoneTransparency), border_color=na, extend=extend.right)
    discountBox := box.new(left=bar_index, top=eqPrice, right=bar_index + 50, bottom=lastSwingLow,
        bgcolor=color.new(discountColor, pdZoneTransparency), border_color=na, extend=extend.right)
    eqLine := line.new(bar_index, eqPrice, bar_index + 50, eqPrice,
        color=eqLineColor, width=1, style=line.style_dashed)

// ============================================================
// === FVG ZONES ===
// ============================================================
var box[] bullFVGs      = array.new_box()
var box[] bearFVGs      = array.new_box()
var int[] bullBars      = array.new_int()
var int[] bearBars      = array.new_int()
var int[] bullTouchBars = array.new_int()
var int[] bearTouchBars = array.new_int()

// Array mismatch safety check
if not enableLightMode
    if array.size(bullFVGs) != array.size(bullBars) or array.size(bullBars) != array.size(bullTouchBars)
        label.new(bar_index, high, "⚠️ Bull FVG Array Mismatch",
            style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
    if array.size(bearFVGs) != array.size(bearBars) or array.size(bearBars) != array.size(bearTouchBars)
        label.new(bar_index, low, "⚠️ Bear FVG Array Mismatch",
            style=label.style_label_up, color=color.red, textcolor=color.white, size=size.small)

// ============================================================
// === VOLUME-WEIGHTED FVG FILTER (Phase 3) ===
// ============================================================
// A "strong" FVG requires:
//   1. The displacement candle (candle[1]) body is >= minDisplacementPct * ATR
//   2. Volume on that candle is >= volFVGMultiplier * SMA(volume, volFVGLookback)
// This eliminates low-energy, noisy FVGs automatically.

float atr14 = atrCore
volSMA          = ta.sma(volume, volFVGLookback)
dispBody        = math.abs(close[1] - open[1])                        // displacement candle body
dispBodyPct     = atrCore > 0 ? dispBody / atrCore : 0.0                 // body as % of ATR
isVolSpikeFVG   = volume[1] >= volSMA[1] * volFVGMultiplier           // volume spike on displacement candle
isDisplacement  = dispBodyPct >= minDisplacementPct                   // body size qualifies
passesVolFilter = not enableVolFVG or (isVolSpikeFVG and isDisplacement)

imbalanceStrength    = math.abs(high[1] - low[1]) / math.max(math.abs(high[2] - low[0]), 1e-5)
passesStrengthFilter = not enableFVGStrengthFilter or imbalanceStrength >= fvgStrengthThreshold

// Combined gate: must pass BOTH strength filter AND vol/displacement filter
fvgPassesAllFilters = passesStrengthFilter and passesVolFilter

// Confluence tap flags (reset each bar)
var bool bullFvgTapThisBar = false
var bool bearFvgTapThisBar = false
bullFvgTapThisBar := false
bearFvgTapThisBar := false

if enableFVG and not enableLightMode
    if low[2] > high[1] and (not useTrendFilter or trendDir == "Bullish") and fvgPassesAllFilters
        b = box.new(bar_index-2, low[2], bar_index, high[1],
            border_color=color.lime, bgcolor=showFVGFill ? color.new(color.lime, 90) : na, extend=fvgExtend)
        array.push(bullFVGs, b)
        array.push(bullBars, bar_index)
        array.push(bullTouchBars, na)
        if showVolFVGLabel and enableVolFVG and isVolSpikeFVG and isDisplacement and showBalancedOrMore
            label.new(bar_index - 1, high[1], "⚡ Strong FVG",
                style=label.style_label_up, color=color.new(color.lime, 60),
                textcolor=color.black, size=size.tiny)

    if high[2] < low[1] and (not useTrendFilter or trendDir == "Bearish") and fvgPassesAllFilters
        b = box.new(bar_index-2, high[1], bar_index, low[2],
            border_color=color.red, bgcolor=showFVGFill ? color.new(color.red, 90) : na, extend=fvgExtend)
        array.push(bearFVGs, b)
        array.push(bearBars, bar_index)
        array.push(bearTouchBars, na)
        if showVolFVGLabel and enableVolFVG and isVolSpikeFVG and isDisplacement and showBalancedOrMore
            label.new(bar_index - 1, low[1], "⚡ Strong FVG",
                style=label.style_label_down, color=color.new(color.red, 60),
                textcolor=color.white, size=size.tiny)

while array.size(bullFVGs) > maxFVGs
    f_deleteFVG(bullFVGs, bullBars, bullTouchBars, 0)
while array.size(bearFVGs) > maxFVGs
    f_deleteFVG(bearFVGs, bearBars, bearTouchBars, 0)

checkFVGMitigation(_price, _top, _bot) =>
    fvgMitigationMethod == "wick"  ? (_price <= _top and _price >= _bot) :fvgMitigationMethod == "close" ? (close  <= _top and close  >= _bot) : false

var bool showBullTapEntry = false
var bool showBearTapEntry = false

if enableFVG and not enableLightMode
    if array.size(bullFVGs) > 0
        for i = array.size(bullFVGs) - 1 to 0
            b   = array.get(bullFVGs, i)
            top = box.get_top(b)
            bot = box.get_bottom(b)
            if checkFVGMitigation(low, top, bot)
                bullFvgTapThisBar := true
                if showFvgTapLine
                    line.new(x1=bar_index - fvgLabelOffset - 2, y1=low * 0.9995,
                        x2=bar_index + fvgTapLineBars, y2=low * 0.9995,
                        color=color.white, style=line.style_dotted, width=1)
                label.new(x=bar_index - fvgLabelOffset, y=low, text="🟢 FVG Tap",
                    style=label.style_label_left, color=na, textcolor=color.lime, size=size.tiny)
                if enableAutoEntry and markTapEntry
                    showBullTapEntry := true
                if fvgRemovalDelayBars == 0
                    f_deleteFVG(bullFVGs, bullBars, bullTouchBars, i)
                else if na(array.get(bullTouchBars, i))
                    array.set(bullTouchBars, i, bar_index)

    if array.size(bearFVGs) > 0
        for i = array.size(bearFVGs) - 1 to 0
            b   = array.get(bearFVGs, i)
            top = box.get_top(b)
            bot = box.get_bottom(b)
            if checkFVGMitigation(high, top, bot)
                bearFvgTapThisBar := true
                if showFvgTapLine
                    line.new(x1=bar_index - fvgLabelOffset - 2, y1=high * 1.0005,
                        x2=bar_index + fvgTapLineBars, y2=high * 1.0005,
                        color=color.white, style=line.style_dotted, width=1)
                label.new(x=bar_index - fvgLabelOffset, y=high, text="🔻 FVG Tap",
                    style=label.style_label_left, color=na, textcolor=color.red, size=size.tiny)
                if enableAutoEntry and markTapEntry
                    showBearTapEntry := true
                if fvgRemovalDelayBars == 0
                    f_deleteFVG(bearFVGs, bearBars, bearTouchBars, i)
                else if na(array.get(bearTouchBars, i))
                    array.set(bearTouchBars, i, bar_index)

// Delayed FVG cleanup
if array.size(bullTouchBars) > 0
    for i = array.size(bullTouchBars) - 1 to 0
        tb = array.get(bullTouchBars, i)
        if not na(tb) and bar_index - tb >= fvgRemovalDelayBars
            f_deleteFVG(bullFVGs, bullBars, bullTouchBars, i)

if array.size(bearTouchBars) > 0
    for i = array.size(bearTouchBars) - 1 to 0
        tb = array.get(bearTouchBars, i)
        if not na(tb) and bar_index - tb >= fvgRemovalDelayBars
            f_deleteFVG(bearFVGs, bearBars, bearTouchBars, i)

plotshape(showBullTapEntry and markTapEntry and enableAutoEntry, title="Auto Long",
    location=location.belowbar, style=shape.triangleup,   color=color.lime, size=size.small)
plotshape(showBearTapEntry and markTapEntry and enableAutoEntry, title="Auto Short",
    location=location.abovebar, style=shape.triangledown, color=color.red,  size=size.small)

if showBullTapEntry
    showBullTapEntry := false
if showBearTapEntry
    showBearTapEntry := false

// ============================================================
// === BUY / SELL SIGNALS ===
// ============================================================
pivotBuy  = usePivotSignals and not na(pivotLow)
pivotSell = usePivotSignals and not na(pivotHigh)

fastLen = useAutoEMA ? (htf=="1"?5 : htf=="5"?9 : htf=="15"?12 : htf=="30"?14 : htf=="60"?21 : htf=="120"?34 : htf=="240"?55 : 89) : manualFastEMA
slowLen = useAutoEMA ? (htf=="1"?13: htf=="5"?21: htf=="15"?34: htf=="30"?50: htf=="60"?89: htf=="120"?144: htf=="240"?200: 300) : manualSlowEMA

fastEMA = ta.ema(close, fastLen)
slowEMA = ta.ema(close, slowLen)
crossUp = ta.crossover(fastEMA,  slowEMA)
crossDn = ta.crossunder(fastEMA, slowEMA)

var int lastBuyBar  = na
var int lastSellBar = na

emaGapPct      = math.abs(fastEMA - slowEMA) / close * 100
priceAboveSlow = close > slowEMA
priceBelowSlow = close < slowEMA
emaSeparated   = emaGapPct >= emaGapThreshold
inBullTrend    = trendDir == "Bullish"
inBearTrend    = trendDir == "Bearish"

emaBuy  = crossUp and priceAboveSlow and emaSeparated and inBullTrend and (na(lastBuyBar)  or bar_index - lastBuyBar  > buySellCooldownBars)
emaSell = crossDn and priceBelowSlow and emaSeparated and inBearTrend and (na(lastSellBar) or bar_index - lastSellBar > buySellCooldownBars)

if emaBuy
    lastBuyBar := bar_index
if emaSell
    lastSellBar := bar_index

buySignal  = usePivotSignals ? pivotBuy  : (enableBuySell and emaBuy)
sellSignal = usePivotSignals ? pivotSell : (enableBuySell and emaSell)

plotshape(showPivotDots and not minimalMode and not na(pivotLow),
    title="Pivot Low Dot",  style=shape.circle, location=location.belowbar, color=color.green, size=size.small, offset=-1)
plotshape(showPivotDots and not minimalMode and not na(pivotHigh),
    title="Pivot High Dot", style=shape.circle, location=location.abovebar, color=color.red,   size=size.small, offset=-1)

// ============================================================
// === SWING MEMORY + ZIGZAG + TRENDLINES ===
// ============================================================
var float[]  swingPrices = array.new_float()
var int[]    swingBars   = array.new_int()
var line[]   trendLines  = array.new_line()
var line[]   zzLines     = array.new_line()
var string[] trendTypes  = array.new_string()

var bool trendlineBrokenBull = false
var bool trendlineBrokenBear = false

// Memory reset on IDM toggle change
var bool lastIDMSetting = useIDMFilter
if useIDMFilter != lastIDMSetting
    array.clear(swingPrices)
    array.clear(swingBars)
    array.clear(trendLines)
    lastIDMSetting := useIDMFilter

if not na(pivotHigh)
    array.push(swingPrices, high)
    array.push(swingBars, bar_index)
if not na(pivotLow)
    array.push(swingPrices, low)
    array.push(swingBars, bar_index)

while array.size(swingPrices) > maxSwingHistory
    array.shift(swingPrices)
    array.shift(swingBars)

// ZigZag
if showZigZag and array.size(swingPrices) >= 2
    int   prevIdx = array.size(swingPrices) - 2
    int   currIdx = array.size(swingPrices) - 1
    int   x1 = array.get(swingBars,   prevIdx)
    float y1 = array.get(swingPrices, prevIdx)
    int   x2 = array.get(swingBars,   currIdx)
    float y2 = array.get(swingPrices, currIdx)
    color col = y2 > y1 ? color.new(color.lime, 0) : color.new(color.red, 0)
    array.push(zzLines, line.new(x1, y1, x2, y2, color=col, width=2))
    if array.size(zzLines) > maxZigzagSwings
        line.delete(array.shift(zzLines))

// Trendlines
if enableTrendlines and array.size(swingBars) >= 4
    bool validBull = trendDir == "Bullish" and (not requireStrongTrend or trendConfScore > 70)
    bool validBear = trendDir == "Bearish" and (not requireStrongTrend or trendConfScore > 70)
    bool drawBull  = allowBothTrendlines or validBull
    bool drawBear  = allowBothTrendlines or validBear

    if not preserveTrendlines
        if array.size(trendLines) > 0
            for i = 0 to array.size(trendLines) - 1
                line.delete(array.get(trendLines, i))
        array.clear(trendLines)
        array.clear(trendTypes)

    int   x1 = array.get(swingBars,   array.size(swingBars)   - 4)
    float y1 = array.get(swingPrices, array.size(swingPrices) - 4)
    int   x2 = array.get(swingBars,   array.size(swingBars)   - 2)
    float y2 = array.get(swingPrices, array.size(swingPrices) - 2)

    if drawBull
        line bullLine = line.new(x1, y1, x2, y2, extend=extend.right,
            color=color.new(color.lime, preserveTrendlines ? 60 : 0), width=2)
        array.push(trendLines, bullLine)
        array.push(trendTypes, "bull")

    if drawBear
        line bearLine = line.new(x1, y1, x2, y2, extend=extend.right,
            color=color.new(color.red, preserveTrendlines ? 60 : 0), width=2)
        array.push(trendLines, bearLine)
        array.push(trendTypes, "bear")

    if preserveTrendlines
        while array.size(trendLines) > maxTrendlines
            line.delete(array.shift(trendLines))
            array.shift(trendTypes)

// ============================================================
// === SWING TAGS (HH/HL/LH/LL + IDM) ===
// ============================================================
if showSwingTags and not minimalMode
    if not na(pivotHigh)
        txt = high > nz(lastSwingHigh[1]) ? "HH" : "LH"
        col = high > nz(lastSwingHigh[1]) ? color.lime : color.orange
        label.new(bar_index, high, txt, style=label.style_label_down, color=col, textcolor=color.black, size=size.tiny)
        if useIDMFilter
            label.new(bar_index, high, "Liquidity High", style=label.style_label_down,
                size=size.tiny, color=color.yellow, textcolor=color.purple)

    if not na(pivotLow)
        txt = low < nz(lastSwingLow[1]) ? "LL" : "HL"
        col = low < nz(lastSwingLow[1]) ? color.red : color.green
        label.new(bar_index, low, txt, style=label.style_label_up, color=col, textcolor=color.white, size=size.tiny)
        if useIDMFilter
            label.new(bar_index, low, "Liquidity Low", style=label.style_label_up,
                size=size.tiny, color=color.yellow, textcolor=color.purple)

// ============================================================
// === EARLY TOP WARNING ===
// ============================================================
var label[] earlyLabels    = array.new_label()
var int     lastEarlyTopBar = na

if enableEarlyTop
    if na(lastEarlyTopBar) or bar_index - lastEarlyTopBar > earlyTopCooldownBars
        wickRatio = (high - math.max(open, close)) / (high - low + 1e-10) * 100
        rsiValET  = ta.rsi(close, rsiLen)
        if wickRatio >= wickThresh and rsiValET > rsiOB and close < high * 0.98
            array.push(earlyLabels, label.new(bar_index, high, "⚠️ Early Top?",
                style=label.style_label_down, color=color.yellow, textcolor=color.black, size=size.small))
            lastEarlyTopBar := bar_index
            if array.size(earlyLabels) > maxEarlyTopLabels
                label.delete(array.shift(earlyLabels))

// ============================================================
// === EARLY SIGNAL (HL/LH EARLY DETECTION) ===
// ============================================================
rsiVal   = ta.rsi(close, earlyRSILen)
volSpike = enableEarlyVol ? volume > ta.sma(volume, 20) * volMultiplier : true

// ============================================================
// === PREDICTION / EXPECTATION ENGINE ===
// ============================================================
var int    predCount            = 0
var int    correctCount         = 0
var string lastPredictionResult = "—"
var int    lastConfirmBar       = na

var bool  expectHL = false
var bool  expectLH = false
var bool  expectHH = false
var bool  expectLL = false

var float expectedHLLevel = na
var float expectedLHLevel = na
var int   chochBarHL      = na
var int   chochBarLH      = na

minBarsAfterCHoCH = 5
expiryBars        = 30

var bool predictionActive = false
var bool hlConfirmedThisBar = false
var bool lhConfirmedThisBar = false
var bool hhConfirmedThisBar = false
var bool llConfirmedThisBar = false

// Reset all prediction memory on any new structural event
if validBullCHoCH or validBearCHoCH or bullishBOS or bearishBOS
    expectedHLLevel  := na
    expectedLHLevel  := na
    chochBarHL       := na
    chochBarLH       := na
    expectHL         := false
    expectLH         := false
    expectHH         := false
    expectLL         := false
    predictionActive := true

// Set expectations
if validBullCHoCH and not expectHL and predictionActive
    expectedHLLevel := low
    chochBarHL      := bar_index
    expectHL        := true
    predCount       += 1

if validBearCHoCH and not expectLH and predictionActive
    expectedLHLevel := high
    chochBarLH      := bar_index
    expectLH        := true
    predCount       += 1

if bullishBOS
    expectHH  := true
    predCount += 1
if bearishBOS
    expectLL  := true
    predCount += 1

// Early signal integration (from published version)
if enableEarlySignal and validBullCHoCH
    condMomentum = close > (low + (high - low) * 0.5)
    condRSI      = rsiVal > earlyRSIOver
    condVolOK    = volSpike
    if condMomentum and condRSI and condVolOK
        expectHL              := true
        predCount             += 1
        lastPredictionResult  := "🔹 Early HL Signal at $" + str.tostring(close, "#.##")

if enableEarlySignal and validBearCHoCH
    condMomentum = close < (high - (high - low) * 0.5)
    condRSI      = rsiVal < earlyRSIUnder
    condVolOK    = volSpike
    if condMomentum and condRSI and condVolOK
        expectLH              := true
        predCount             += 1
        lastPredictionResult  := "🔹 Early LH Signal at $" + str.tostring(close, "#.##")

predictionActive := false

hlConfirmedThisBar := false
lhConfirmedThisBar := false
hhConfirmedThisBar := false
llConfirmedThisBar := false

// Confirm HL
if expectHL
    barsSinceCHoCH   = bar_index - chochBarHL
    hlFormed         = not na(pivotLow) and low > expectedHLLevel and barsSinceCHoCH >= minBarsAfterCHoCH
    priceInvalidated = low < expectedHLLevel

    if hlFormed
        hlConfirmedThisBar := true
        correctCount += 1
        expectHL             := false
        lastConfirmBar       := bar_index
        lastPredictionResult := "✅ HL Confirmed at $" + str.tostring(low, "#.##")
    else if priceInvalidated
        expectHL             := false
        lastPredictionResult := "❌ HL Invalidated (low < $" + str.tostring(expectedHLLevel, "#.##") + ")"
    else if barsSinceCHoCH > expiryBars
        expectHL             := false
        lastPredictionResult := "❌ HL Expired"

// Confirm LH
if expectLH
    barsSinceCHoCH   = bar_index - chochBarLH
    lhFormed         = not na(pivotHigh) and high < expectedLHLevel and barsSinceCHoCH >= minBarsAfterCHoCH
    priceInvalidated = high > expectedLHLevel

    if lhFormed
        lhConfirmedThisBar := true
        correctCount += 1
        expectLH             := false
        lastConfirmBar       := bar_index
        lastPredictionResult := "✅ LH Confirmed at $" + str.tostring(high, "#.##")
    else if priceInvalidated
        expectLH             := false
        lastPredictionResult := "❌ LH Invalidated (high > $" + str.tostring(expectedLHLevel, "#.##") + ")"
    else if barsSinceCHoCH > expiryBars
        expectLH             := false
        lastPredictionResult := "❌ LH Expired"

// Confirm HH
if expectHH
    barsSinceBOS  = bar_index - bullBOSBar
    hhConfirmed   = not na(pivotHigh) and high > nz(lastSwingHigh[1])
    hhInvalidated = low < nz(lastSwingLow[1])

    if hhConfirmed and bar_index != lastConfirmBar
        hhConfirmedThisBar := true
        correctCount += 1
        expectHH             := false
        lastConfirmBar       := bar_index
        lastPredictionResult := "✅ HH Confirmed at $" + str.tostring(high, "#.##")
    else if hhInvalidated
        expectHH             := false
        lastPredictionResult := "❌ HH Invalidated"
    else if barsSinceBOS > expiryBars
        expectHH             := false
        lastPredictionResult := "❌ HH Expired"

// Confirm LL
if expectLL
    barsSinceBOS  = bar_index - bearBOSBar
    llConfirmed   = not na(pivotLow) and low < nz(lastSwingLow[1])
    llInvalidated = high > nz(lastSwingHigh[1])

    if llConfirmed and bar_index != lastConfirmBar
        llConfirmedThisBar := true
        correctCount += 1
        expectLL             := false
        lastConfirmBar       := bar_index
        lastPredictionResult := "✅ LL Confirmed at $" + str.tostring(low, "#.##")
    else if llInvalidated
        expectLL             := false
        lastPredictionResult := "❌ LL Invalidated"
    else if barsSinceBOS > expiryBars
        expectLL             := false
        lastPredictionResult := "❌ LL Expired"

predictionRate = predCount > 0 ? correctCount / predCount * 100 : na

anticipateHL = not na(expectedHLLevel) ? "HL > $" + str.tostring(expectedHLLevel, "#.##") + " (" + str.tostring((close - expectedHLLevel) / close * 100, "#.##") + "%)" : ""
anticipateLH = not na(expectedLHLevel) ? "LH < $" + str.tostring(expectedLHLevel, "#.##") + " (" + str.tostring((expectedLHLevel - close) / close * 100, "#.##") + "%)" : ""

anticipate = validBullCHoCH ? "CHoCH Bull → Expect HL" :
             validBearCHoCH ? "CHoCH Bear → Expect LH" :
             bullishBOS     ? "BOS Bull → Expect HH"   :
             bearishBOS     ? "BOS Bear → Expect LL"   :
             trendDir == "Bullish" and not na(expectedHLLevel) ? "Bull Trend → Wait " + anticipateHL :
             trendDir == "Bearish" and not na(expectedLHLevel) ? "Bear Trend → Wait " + anticipateLH :
             "Neutral"

// Anticipation label on chart
if showAnticipation and showNextExpectation and barstate.islast and not minimalMode and not enableLightMode and anticipate != "Neutral"
    if bar_index % 5 == 0
        label.new(bar_index + 3, trendDir == "Bullish" ? low : high, anticipate,
            style=label.style_label_left, color=color.teal, textcolor=color.black, size=size.normal)

// Invalidation labels
if showInvalidationLabels and barstate.islast and not minimalMode and not enableLightMode
    int offsetBars = 15
    if trendDir == "Bullish" and not na(expectedHLLevel)
        line.new(bar_index, expectedHLLevel, bar_index + offsetBars, expectedHLLevel,
            style=line.style_dotted, color=color.red, width=1)
        label.new(bar_index + offsetBars, expectedHLLevel,
            "Invalidate Bull < $" + str.tostring(expectedHLLevel, "#.##"),
            style=label.style_none, textcolor=color.red, size=size.small)
    if trendDir == "Bearish" and not na(expectedLHLevel)
        line.new(bar_index, expectedLHLevel, bar_index + offsetBars, expectedLHLevel,
            style=line.style_dotted, color=color.green, width=1)
        label.new(bar_index + offsetBars, expectedLHLevel,
            "Invalidate Bear > $" + str.tostring(expectedLHLevel, "#.##"),
            style=label.style_none, textcolor=color.green, size=size.small)

// ============================================================
// === ACCURACY MINI-CHART ===
// ============================================================
var float[] accHistory = array.new_float()

if barstate.islast and not na(predictionRate) and bar_index % 5 == 0
    float lastStored = array.size(accHistory) > 0 ? array.get(accHistory, array.size(accHistory)-1) : na
    if na(lastStored) or math.abs(predictionRate - lastStored) >= 0.01
        array.push(accHistory, predictionRate)
        if array.size(accHistory) > maxAccPoints
            array.shift(accHistory)

if showAccuracyChart and not enableLightMode and array.size(accHistory) >= 2 and barstate.islast
    float offset = atrCore * 6
    float scale  = offset * 2.5
    for i = 0 to array.size(accHistory) - 2
        float val1 = array.get(accHistory, i)
        float val2 = array.get(accHistory, i + 1)
        float y1 = low - offset + (val1 / 100) * scale
        float y2 = low - offset + (val2 / 100) * scale
        int   x1 = bar_index - (array.size(accHistory) - i) * 4
        int   x2 = bar_index - (array.size(accHistory) - i - 1) * 4
        line.new(x1=x1, y1=y1, x2=x2, y2=y2, color=color.new(color.aqua, 0), width=3)
        label.new(x=x1, y=y1, text="●", textcolor=color.aqua, style=label.style_none, size=size.large)
    float currentAcc = array.get(accHistory, array.size(accHistory)-1)
    label.new(bar_index, low - offset + (currentAcc/100)*scale + atrCore*0.5,
        text="Accuracy: " + str.tostring(currentAcc, "0.0") + "%",
        style=label.style_label_left, color=color.new(color.black, 20), textcolor=color.aqua, size=size.normal)

// ============================================================
// === TRENDLINE VALIDATION (Break Detection) ===
// ============================================================
trendlineBrokenBull := false
trendlineBrokenBear := false

if enableTrendlineValidation and array.size(trendLines) > 0
    for i = 0 to array.size(trendLines) - 1
        line   l         = array.get(trendLines, i)
        string trendType = array.get(trendTypes, i)
        bool   isBullLine = trendType == "bull"
        bool   isBearLine = trendType == "bear"
        int    x1 = line.get_x1(l)
        float  y1 = line.get_y1(l)
        int    x2 = line.get_x2(l)
        float  y2 = line.get_y2(l)

        if bar_index >= x1 and x2 != x1
            float yOnLine = y1 + (y2 - y1) * (bar_index - x1) / (x2 - x1)

            bool bullWickBreak  = trendlineBreakMode == "Wick"  and low   < yOnLine
            bool bullCloseBreak = trendlineBreakMode == "Close" and close < yOnLine
            bool bearWickBreak  = trendlineBreakMode == "Wick"  and high  > yOnLine
            bool bearCloseBreak = trendlineBreakMode == "Close" and close > yOnLine

            if isBullLine and (bullWickBreak or bullCloseBreak)
                trendlineBrokenBull := true
                if highlightBrokenLines
                    line.set_color(l, color.new(color.gray, 60))
                    line.set_style(l, line.style_dashed)

            if isBearLine and (bearWickBreak or bearCloseBreak)
                trendlineBrokenBear := true
                if highlightBrokenLines
                    line.set_color(l, color.new(color.gray, 60))
                    line.set_style(l, line.style_dashed)

// ============================================================
// === AUTO FIBONACCI + OTE ZONES (Phase 3) ===
// ============================================================
// Logic: On every confirmed CHoCH or BOS, draw Fibonacci retracement
// from the prior swing (origin) to the impulse leg endpoint.
// Highlights the OTE zone (0.62–0.79) as an institutional entry window.
// All fib lines are redrawn on each new structural event.

// ✅ CLEANUP TOGGLES (adds 1 setting)
showFibTextLabels = input.bool(false, "Show Fib Text Labels (cleanup)", group="Auto Fibonacci")
showOTETextLabel  = input.bool(false, "Show OTE Text Label (cleanup)", group="Auto Fibonacci")

var line   fibLine50    = na
var line   fibLine618   = na
var line   fibLine705   = na
var line   fibLine79    = na
var line   fibLine100   = na
var box    fibOTEBox    = na
var label  fibLabel50   = na
var label  fibLabel618  = na
var label  fibLabel705  = na
var label  fibLabel79   = na
var label  fibLabel100  = na
var label  fibOTELabel  = na

var float fibOrigin     = na   // start of the measured move (swing origin)
var float fibEndpoint   = na   // end of the measured move (impulse end)
var bool  fibIsBull     = false // direction of the move

// Helper: compute fib price level
f_fibLevel(_origin, _end, _ratio, _isBull) =>
    _isBull ? _end - (_end - _origin) * _ratio :
              _end + (_origin - _end) * _ratio

// Helper: delete all existing fib drawings
f_clearFibs() =>
    if not na(fibLine50)
        line.delete(fibLine50)
    if not na(fibLine618)
        line.delete(fibLine618)
    if not na(fibLine705)
        line.delete(fibLine705)
    if not na(fibLine79)
        line.delete(fibLine79)
    if not na(fibLine100)
        line.delete(fibLine100)
    if not na(fibOTEBox)
        box.delete(fibOTEBox)

    if not na(fibLabel50)
        label.delete(fibLabel50)
    if not na(fibLabel618)
        label.delete(fibLabel618)
    if not na(fibLabel705)
        label.delete(fibLabel705)
    if not na(fibLabel79)
        label.delete(fibLabel79)
    if not na(fibLabel100)
        label.delete(fibLabel100)
    if not na(fibOTELabel)
        label.delete(fibOTELabel)

// Detect when to trigger a new fib draw
fibTriggered = enableAutoFib and not enableLightMode and
               (validBullCHoCH or validBearCHoCH or bullishBOS or bearishBOS)

if fibTriggered
    f_clearFibs()

    if validBullCHoCH or bullishBOS
        fibOrigin    := nz(lastSwingLow[1],  low)
        fibEndpoint  := high
        fibIsBull    := true
    else
        fibOrigin    := nz(lastSwingHigh[1], high)
        fibEndpoint  := low
        fibIsBull    := false

if enableAutoFib and not enableLightMode and not na(fibOrigin) and not na(fibEndpoint)
    int   lx  = bar_index
    int   rx  = bar_index + fibExtendBars
    float p50  = f_fibLevel(fibOrigin, fibEndpoint, 0.500, fibIsBull)
    float p618 = f_fibLevel(fibOrigin, fibEndpoint, 0.618, fibIsBull)
    float p705 = f_fibLevel(fibOrigin, fibEndpoint, 0.705, fibIsBull)
    float p79  = f_fibLevel(fibOrigin, fibEndpoint, 0.790, fibIsBull)
    float p100 = fibOrigin  // 1.0 = full retracement back to origin

    // Draw OTE box (0.62–0.79 zone) — only on last bar to avoid repainting boxes
    if barstate.islast and showOTEZone
        float oteTop = math.max(p618, p79)
        float oteBot = math.min(p618, p79)
        fibOTEBox   := box.new(lx - 3, oteTop, rx, oteBot,
            bgcolor=oteColor, border_color=color.new(#FFD700, 20), extend=extend.right)

        // ✅ OTE text label now optional
        if showOTETextLabel
            fibOTELabel := label.new(rx, (oteTop + oteBot) / 2, "OTE Zone",
                style=label.style_label_left, color=na,
                textcolor=color.new(#FFD700, 0), size=size.small)

    // Draw individual fib lines (labels now optional)
    if showFib50
        fibLine50   := line.new(lx, p50,  rx, p50,  color=fib50Color,  style=line.style_dashed, width=1)
        if showFibTextLabels
            fibLabel50  := label.new(rx, p50,  "0.5  $" + str.tostring(p50,  "#.##"),
                style=label.style_label_left, color=na, textcolor=fib50Color,  size=size.tiny)

    if showFib618
        fibLine618  := line.new(lx, p618, rx, p618, color=fib618Color, style=line.style_dashed, width=1)
        if showFibTextLabels
            fibLabel618 := label.new(rx, p618, "0.618 $" + str.tostring(p618, "#.##"),
                style=label.style_label_left, color=na, textcolor=fib618Color, size=size.tiny)

    if showFib705
        fibLine705  := line.new(lx, p705, rx, p705, color=fib705Color, style=line.style_dotted, width=2)
        if showFibTextLabels
            fibLabel705 := label.new(rx, p705, "0.705 $" + str.tostring(p705, "#.##"),
                style=label.style_label_left, color=na, textcolor=fib705Color, size=size.tiny)

    if showFib79
        fibLine79   := line.new(lx, p79,  rx, p79,  color=fib79Color,  style=line.style_dotted, width=2)
        if showFibTextLabels
            fibLabel79  := label.new(rx, p79,  "0.79  $" + str.tostring(p79,  "#.##"),
                style=label.style_label_left, color=na, textcolor=fib79Color,  size=size.tiny)

    if showFib100
        fibLine100  := line.new(lx, p100, rx, p100, color=fib100Color, style=line.style_solid,  width=1)
        if showFibTextLabels
            fibLabel100 := label.new(rx, p100, "1.0   $" + str.tostring(p100, "#.##"),
                style=label.style_label_left, color=na, textcolor=fib100Color, size=size.tiny)

// OTE touch detection (for confluence + alert)
bool priceInOTE = false
if enableAutoFib and not na(fibOrigin) and not na(fibEndpoint)
    float p618c = f_fibLevel(fibOrigin, fibEndpoint, 0.618, fibIsBull)
    float p79c  = f_fibLevel(fibOrigin, fibEndpoint, 0.790, fibIsBull)
    float oteHi = math.max(p618c, p79c)
    float oteLo = math.min(p618c, p79c)
    priceInOTE := close >= oteLo and close <= oteHi

// === TP / RR PROJECTION — FIB EXTENSIONS (Phase 5 / Retail Upgrade) ===
f_extLevel(_origin, _end, _ratio, _isBull) =>
    _isBull ? _origin + (_end - _origin) * _ratio :
              _origin - (_origin - _end) * _ratio

var line projEntryLine = na
var line projSLLine = na
var line projTP1Line = na
var line projTP2Line = na
var line projTP3Line = na
var line projTP4Line = na

var label projEntryLabel = na
var label projSLLabel = na
var label projTP1Label = na
var label projTP2Label = na
var label projTP3Label = na
var label projTP4Label = na

var bool tp1Hit = false
var bool tp2Hit = false

var bool tradeActive = false
var bool tradeIsLong = false
var bool tradeTP1Done = false
var bool tradeTP2Done = false
var int tradeEntryBar = na
var float tradeEntry = na
var float tradeStop = na
var float tradeTP1 = na
var float tradeTP2 = na
var float tradeTP3 = na
var float tradeTP4 = na
var float tradeRisk = na
var float tradeRR1 = na
var float tradeRR2 = na
var float tradeRR3 = na
var float tradeRR4 = na
var string tradeGrade = "—"

f_clearProjection() =>
    if not na(projEntryLine)
        line.delete(projEntryLine)
    if not na(projSLLine)
        line.delete(projSLLine)
    if not na(projTP1Line)
        line.delete(projTP1Line)
    if not na(projTP2Line)
        line.delete(projTP2Line)
    if not na(projTP3Line)
        line.delete(projTP3Line)
    if not na(projTP4Line)
        line.delete(projTP4Line)

    if not na(projEntryLabel)
        label.delete(projEntryLabel)
    if not na(projSLLabel)
        label.delete(projSLLabel)
    if not na(projTP1Label)
        label.delete(projTP1Label)
    if not na(projTP2Label)
        label.delete(projTP2Label)
    if not na(projTP3Label)
        label.delete(projTP3Label)
    if not na(projTP4Label)
        label.delete(projTP4Label)

f_rr(_entry, _stop, _target) =>
    float risk = math.abs(_entry - _stop)
    risk > 0 ? math.abs(_target - _entry) / risk : na

bool longProjectionTrigger = false
bool shortProjectionTrigger = false

longProjectionTrigger := useConfirmedHLLHOnly ? hlConfirmedThisBar : (hlConfirmedThisBar or validBullCHoCH or bullishBOS)
shortProjectionTrigger := useConfirmedHLLHOnly ? lhConfirmedThisBar : (lhConfirmedThisBar or validBearCHoCH or bearishBOS)

tp1Hit := false
tp2Hit := false

if enableTPProjection and not na(fibOrigin) and not na(fibEndpoint)
    float tp127 = f_extLevel(fibOrigin, fibEndpoint, 1.272, fibIsBull)
    float tp162 = f_extLevel(fibOrigin, fibEndpoint, 1.618, fibIsBull)
    float tp200 = f_extLevel(fibOrigin, fibEndpoint, 2.000, fibIsBull)
    float tp261 = f_extLevel(fibOrigin, fibEndpoint, 2.618, fibIsBull)

    // --- Create Long Projection ---
    if longProjectionTrigger and fibIsBull
        f_clearProjection()

        tradeActive := true
        tradeIsLong := true
        tradeTP1Done := false
        tradeTP2Done := false
        tradeEntryBar := bar_index
        tradeEntry := close
        tradeStop := nz(expectedHLLevel, fibOrigin) - atrCore * slBufferATR
        tradeTP1 := tp127
        tradeTP2 := tp162
        tradeTP3 := tp200
        tradeTP4 := tp261
        tradeRisk := math.abs(tradeEntry - tradeStop)
        tradeRR1 := f_rr(tradeEntry, tradeStop, tradeTP1)
        tradeRR2 := f_rr(tradeEntry, tradeStop, tradeTP2)
        tradeRR3 := f_rr(tradeEntry, tradeStop, tradeTP3)
        tradeRR4 := f_rr(tradeEntry, tradeStop, tradeTP4)

        int lx = bar_index
        int rx = bar_index + tpExtendBars

        if showEntryLine
            projEntryLine := line.new(lx, tradeEntry, rx, tradeEntry, extend=extend.right, color=entryColor, style=line.style_solid, width=1)
            projEntryLabel := label.new(rx, tradeEntry, "Entry $" + str.tostring(tradeEntry, "#.##"), style=label.style_label_left, color=na, textcolor=entryColor, size=size.tiny)

        if showSLLine
            projSLLine := line.new(lx, tradeStop, rx, tradeStop, extend=extend.right, color=slColor, style=line.style_solid, width=slLineWidth)
            projSLLabel := label.new(rx, tradeStop, "SL $" + str.tostring(tradeStop, "#.##"), style=label.style_label_left, color=na, textcolor=slColor, size=size.tiny)

        if showTP127
            projTP1Line := line.new(lx, tradeTP1, rx, tradeTP1, extend=extend.right, color=tp1Color, style=line.style_dotted, width=tpLineWidth)
            projTP1Label := label.new(rx, tradeTP1,
                 showRRLabels ? "TP1 $" + str.tostring(tradeTP1, "#.##") + " | RR " + str.tostring(tradeRR1, "#.##") :
                                "TP1 $" + str.tostring(tradeTP1, "#.##"),
                 style=label.style_label_left, color=na, textcolor=tp1Color, size=size.tiny)

        if showTP162
            projTP2Line := line.new(lx, tradeTP2, rx, tradeTP2, extend=extend.right, color=tp2Color, style=line.style_dotted, width=tpLineWidth)
            projTP2Label := label.new(rx, tradeTP2,
                 showRRLabels ? "TP2 $" + str.tostring(tradeTP2, "#.##") + " | RR " + str.tostring(tradeRR2, "#.##") :
                                "TP2 $" + str.tostring(tradeTP2, "#.##"),
                 style=label.style_label_left, color=na, textcolor=tp2Color, size=size.tiny)

        if showTP200
            projTP3Line := line.new(lx, tradeTP3, rx, tradeTP3, extend=extend.right, color=tp3Color, style=line.style_dotted, width=tpLineWidth)
            projTP3Label := label.new(rx, tradeTP3,
                 showRRLabels ? "TP3 $" + str.tostring(tradeTP3, "#.##") + " | RR " + str.tostring(tradeRR3, "#.##") :
                                "TP3 $" + str.tostring(tradeTP3, "#.##"),
                 style=label.style_label_left, color=na, textcolor=tp3Color, size=size.tiny)

        if showTP261
            projTP4Line := line.new(lx, tradeTP4, rx, tradeTP4, extend=extend.right, color=tp4Color, style=line.style_dotted, width=tpLineWidth)
            projTP4Label := label.new(rx, tradeTP4,
                 showRRLabels ? "TP4 $" + str.tostring(tradeTP4, "#.##") + " | RR " + str.tostring(tradeRR4, "#.##") :
                                "TP4 $" + str.tostring(tradeTP4, "#.##"),
                 style=label.style_label_left, color=na, textcolor=tp4Color, size=size.tiny)

    // --- Create Short Projection ---
    if shortProjectionTrigger and not fibIsBull
        f_clearProjection()

        tradeActive := true
        tradeIsLong := false
        tradeTP1Done := false
        tradeTP2Done := false
        tradeEntryBar := bar_index
        tradeEntry := close
        tradeStop := nz(expectedLHLevel, fibOrigin) + atrCore * slBufferATR
        tradeTP1 := tp127
        tradeTP2 := tp162
        tradeTP3 := tp200
        tradeTP4 := tp261
        tradeRisk := math.abs(tradeEntry - tradeStop)
        tradeRR1 := f_rr(tradeEntry, tradeStop, tradeTP1)
        tradeRR2 := f_rr(tradeEntry, tradeStop, tradeTP2)
        tradeRR3 := f_rr(tradeEntry, tradeStop, tradeTP3)
        tradeRR4 := f_rr(tradeEntry, tradeStop, tradeTP4)

        int lx = bar_index
        int rx = bar_index + tpExtendBars

        if showEntryLine
            projEntryLine := line.new(lx, tradeEntry, rx, tradeEntry, extend=extend.right, color=entryColor, style=line.style_solid, width=1)
            projEntryLabel := label.new(rx, tradeEntry, "Entry $" + str.tostring(tradeEntry, "#.##"), style=label.style_label_left, color=na, textcolor=entryColor, size=size.tiny)

        if showSLLine
            projSLLine := line.new(lx, tradeStop, rx, tradeStop, extend=extend.right, color=slColor, style=line.style_solid, width=slLineWidth)
            projSLLabel := label.new(rx, tradeStop, "SL $" + str.tostring(tradeStop, "#.##"), style=label.style_label_left, color=na, textcolor=slColor, size=size.tiny)

        if showTP127
            projTP1Line := line.new(lx, tradeTP1, rx, tradeTP1, extend=extend.right, color=tp1Color, style=line.style_dotted, width=tpLineWidth)
            projTP1Label := label.new(rx, tradeTP1,
                 showRRLabels ? "TP1 $" + str.tostring(tradeTP1, "#.##") + " | RR " + str.tostring(tradeRR1, "#.##") :
                                "TP1 $" + str.tostring(tradeTP1, "#.##"),
                 style=label.style_label_left, color=na, textcolor=tp1Color, size=size.tiny)

        if showTP162
            projTP2Line := line.new(lx, tradeTP2, rx, tradeTP2, extend=extend.right, color=tp2Color, style=line.style_dotted, width=tpLineWidth)
            projTP2Label := label.new(rx, tradeTP2,
                 showRRLabels ? "TP2 $" + str.tostring(tradeTP2, "#.##") + " | RR " + str.tostring(tradeRR2, "#.##") :
                                "TP2 $" + str.tostring(tradeTP2, "#.##"),
                 style=label.style_label_left, color=na, textcolor=tp2Color, size=size.tiny)

        if showTP200
            projTP3Line := line.new(lx, tradeTP3, rx, tradeTP3, extend=extend.right, color=tp3Color, style=line.style_dotted, width=tpLineWidth)
            projTP3Label := label.new(rx, tradeTP3,
                 showRRLabels ? "TP3 $" + str.tostring(tradeTP3, "#.##") + " | RR " + str.tostring(tradeRR3, "#.##") :
                                "TP3 $" + str.tostring(tradeTP3, "#.##"),
                 style=label.style_label_left, color=na, textcolor=tp3Color, size=size.tiny)

        if showTP261
            projTP4Line := line.new(lx, tradeTP4, rx, tradeTP4, extend=extend.right, color=tp4Color, style=line.style_dotted, width=tpLineWidth)
            projTP4Label := label.new(rx, tradeTP4,
                 showRRLabels ? "TP4 $" + str.tostring(tradeTP4, "#.##") + " | RR " + str.tostring(tradeRR4, "#.##") :
                                "TP4 $" + str.tostring(tradeTP4, "#.##"),
                 style=label.style_label_left, color=na, textcolor=tp4Color, size=size.tiny)

// Track TP hits on active trade
if tradeActive
    if tradeIsLong
        if not tradeTP1Done and high >= tradeTP1
            tradeTP1Done := true
            tp1Hit := true
        if not tradeTP2Done and high >= tradeTP2
            tradeTP2Done := true
            tp2Hit := true
    else
        if not tradeTP1Done and low <= tradeTP1
            tradeTP1Done := true
            tp1Hit := true
        if not tradeTP2Done and low <= tradeTP2
            tradeTP2Done := true
            tp2Hit := true

f_grade(_score) =>
    _score >= 8 ? "S" : _score >= 6 ? "A" : _score >= 4 ? "B" : "C"

f_gradeOk(_g) =>
    minGradeForAlerts == "C" ? true :minGradeForAlerts == "B" ? (_g == "B" or _g == "A" or _g == "S") :minGradeForAlerts == "A" ? (_g == "A" or _g == "S") :(_g == "S")

f_lastUnmitigatedIdx(_mitArr) =>
    int idx = na
    if array.size(_mitArr) > 0
        for j = array.size(_mitArr) - 1 to 0
            if not array.get(_mitArr, j)
                idx := j
                break
    idx

bool bullOBNear = false
bool bearOBNear = false

int bullConfIdx = f_lastUnmitigatedIdx(bullOBMitigated)
int bearConfIdx = f_lastUnmitigatedIdx(bearOBMitigated)

if useMinimalOB
    if not na(bullConfIdx) and array.size(bullOBTopLines) > bullConfIdx and array.size(bullOBBottomLines) > bullConfIdx
        line tl = array.get(bullOBTopLines, bullConfIdx)
        line bl = array.get(bullOBBottomLines, bullConfIdx)
        if not na(tl) and not na(bl)
            float t   = line.get_y1(tl)
            float b   = line.get_y1(bl)
            float top = math.max(t, b)
            float bot = math.min(t, b)
            bullOBNear := (low <= top and high >= bot)

    if not na(bearConfIdx) and array.size(bearOBTopLines) > bearConfIdx and array.size(bearOBBottomLines) > bearConfIdx
        line tl = array.get(bearOBTopLines, bearConfIdx)
        line bl = array.get(bearOBBottomLines, bearConfIdx)
        if not na(tl) and not na(bl)
            float t   = line.get_y1(tl)
            float b   = line.get_y1(bl)
            float top = math.max(t, b)
            float bot = math.min(t, b)
            bearOBNear := (low <= top and high >= bot)

int bullScore = 0
int bearScore = 0

if trendDir == "Bullish" and trendConfScore >= 70
    bullScore += wTrendConf
if trendDir == "Bearish" and trendConfScore >= 70
    bearScore += wTrendConf

if validBullCHoCH or bullishBOS
    bullScore += wStructure
if validBearCHoCH or bearishBOS
    bearScore += wStructure

if bullFvgTapThisBar
    bullScore += wFvgTap
if bearFvgTapThisBar
    bearScore += wFvgTap

if bullOBNear
    bullScore += wObProx
if bearOBNear
    bearScore += wObProx

if trendlineBrokenBull
    bearScore += wTrendlineBr
if trendlineBrokenBear
    bullScore += wTrendlineBr

// OTE zone touch boosts the score in trend direction
if priceInOTE and fibIsBull
    bullScore += wOTE
if priceInOTE and not fibIsBull
    bearScore += wOTE

// Breaker Block proximity
if bullBkrNear
    bullScore += wBreakerProx
if bearBkrNear
    bearScore += wBreakerProx

// Mitigation Block proximity
if bullMitNear
    bullScore += wMitigationProx
if bearMitNear
    bearScore += wMitigationProx

string bullGrade = f_grade(bullScore)
string bearGrade = f_grade(bearScore)
bool bullSetup = enableConfluence and f_gradeOk(bullGrade)
bool bearSetup = enableConfluence and f_gradeOk(bearGrade)

// === RETAIL STATS ENGINE (Phase 6) ===
var int totalTrades = 0
var int winTrades = 0
var int lossTrades = 0
var int tp1HitsCount = 0
var int tp2HitsCount = 0
var float rrSum = 0.0

var int cTrades = 0
var int bTrades = 0
var int aTrades = 0
var int sTrades = 0

var int cWins = 0
var int bWins = 0
var int aWins = 0
var int sWins = 0

// Capture grade at entry
if longProjectionTrigger and fibIsBull
    tradeGrade := bullGrade
    totalTrades += 1
    if tradeGrade == "C"
        cTrades += 1
    else if tradeGrade == "B"
        bTrades += 1
    else if tradeGrade == "A"
        aTrades += 1
    else if tradeGrade == "S"
        sTrades += 1

if shortProjectionTrigger and not fibIsBull
    tradeGrade := bearGrade
    totalTrades += 1
    if tradeGrade == "C"
        cTrades += 1
    else if tradeGrade == "B"
        bTrades += 1
    else if tradeGrade == "A"
        aTrades += 1
    else if tradeGrade == "S"
        sTrades += 1

// Count TP touch stats
if tp1Hit
    tp1HitsCount += 1
if tp2Hit
    tp2HitsCount += 1

// Close trade logic
if enableStatsMode and tradeActive
    bool stopHit = tradeIsLong ? low <= tradeStop : high >= tradeStop
    bool targetHit = countTP1AsWin ? tradeTP1Done : tradeTP2Done

    if stopHit
        lossTrades += 1
        rrSum += -1.0
        tradeActive := false
    else if targetHit
        winTrades += 1
        rrSum += countTP1AsWin ? nz(tradeRR1, 0) : nz(tradeRR2, 0)

        if tradeGrade == "C"
            cWins += 1
        else if tradeGrade == "B"
            bWins += 1
        else if tradeGrade == "A"
            aWins += 1
        else if tradeGrade == "S"
            sWins += 1

        tradeActive := false

winRate = totalTrades > 0 ? (winTrades / totalTrades) * 100 : na
avgRR = totalTrades > 0 ? rrSum / totalTrades : na

cWinRate = cTrades > 0 ? (cWins / cTrades) * 100 : na
bWinRate = bTrades > 0 ? (bWins / bTrades) * 100 : na
aWinRate = aTrades > 0 ? (aWins / aTrades) * 100 : na
sWinRate = sTrades > 0 ? (sWins / sTrades) * 100 : na

// === SIMPLE MTF SCANNER (Phase 6 Retail) ===
f_mtfBias(_tf) =>
    request.security(syminfo.tickerid, _tf,
         ta.ema(close, 20) > ta.ema(close, 50) ? 1 :
         ta.ema(close, 20) < ta.ema(close, 50) ? -1 : 0)

mtfBias1 = enableMTFScanner ? f_mtfBias(mtf1) : 0
mtfBias2 = enableMTFScanner ? f_mtfBias(mtf2) : 0
mtfBias3 = enableMTFScanner ? f_mtfBias(mtf3) : 0

mtfText1 = mtfBias1 == 1 ? "Bull" : mtfBias1 == -1 ? "Bear" : "Neutral"
mtfText2 = mtfBias2 == 1 ? "Bull" : mtfBias2 == -1 ? "Bear" : "Neutral"
mtfText3 = mtfBias3 == 1 ? "Bull" : mtfBias3 == -1 ? "Bear" : "Neutral"

mtfColor1 = mtfBias1 == 1 ? color.lime : mtfBias1 == -1 ? color.red : color.gray
mtfColor2 = mtfBias2 == 1 ? color.lime : mtfBias2 == -1 ? color.red : color.gray
mtfColor3 = mtfBias3 == 1 ? color.lime : mtfBias3 == -1 ? color.red : color.gray

tripleBullish = mtfBias1 == 1 and mtfBias2 == 1 and mtfBias3 == 1
tripleBearish = mtfBias1 == -1 and mtfBias2 == -1 and mtfBias3 == -1

// ============================================================
// === DASHBOARD TABLE ===
// ============================================================
pos = dashboardPosition == "Top Left"    ? position.top_left :
      dashboardPosition == "Top Right"   ? position.top_right :
      dashboardPosition == "Bottom Left" ? position.bottom_left :
                                           position.bottom_right

var table dash = table.new(pos, 1, 13, border_width=1, bgcolor=color.new(color.black, 85), frame_color=color.white)

if barstate.islast and not minimalMode
    bosColor   = bullishBOS ? color.lime : bearishBOS ? color.red : color.gray
    chochColor = validBullCHoCH or validBearCHoCH ? color.orange : color.gray
    accText    = showPredictionAccuracy and not na(predictionRate) ? str.tostring(predictionRate, "#.##") + "%" : "—"
    accColor   = na(predictionRate) ? color.gray :
                 predictionRate >= 80 ? color.lime :
                 predictionRate >= 50 ? color.orange : color.red
    trendConfColor = trendConfScore >= 70 ? color.lime :
                     trendConfScore >= 40 ? color.orange : color.red

    table.cell(dash, 0, 0,  "Trend: " + trendDir, text_color=color.white)
    table.cell(dash, 0, 1,  "Last High: " + str.tostring(lastSwingHigh, "#.##"), text_color=color.red)
    table.cell(dash, 0, 2,  "Last Low: "  + str.tostring(lastSwingLow,  "#.##"), text_color=color.lime)
    table.cell(dash, 0, 3,  "Next Expectation: " + anticipate, text_color=color.yellow)
    table.cell(dash, 0, 4,  "BOS: " + (bullishBOS ? "Bull" : bearishBOS ? "Bear" : "—"), text_color=bosColor)
    table.cell(dash, 0, 5,  "CHoCH: " + (bullishCHoCH ? "Bull" : bearishCHoCH ? "Bear" : "—"), text_color=chochColor)
    table.cell(dash, 0, 6,  "Accuracy: " + accText, text_color=accColor)

    if showConfluenceOnDash
        table.cell(dash, 0, 7, "Confluence: Bull " + bullGrade + " (" + str.tostring(bullScore) + ") / Bear " + bearGrade + " (" + str.tostring(bearScore) + ")", text_color=color.aqua)
    else
        table.cell(dash, 0, 7, anticipate, text_color=color.teal)

    table.cell(dash, 0, 8,  lastPredictionResult, text_color=color.green)
    table.cell(dash, 0, 9,  "Trend Confidence: " + str.tostring(trendConfScore) + "%", text_color=trendConfColor)
    table.cell(dash, 0, 10, "OB Status: Bull " + (lastBullOBMitigated ? "✅ Mitigated" : "🟢 Active") +
        " / Bear " + (lastBearOBMitigated ? "✅ Mitigated" : "🔴 Active"), text_color=color.white)

    table.cell(dash, 0, 11, "Structure Bias: " + trendDir,
        text_color=trendDir == "Bullish" ? color.lime :
                   trendDir == "Bearish" ? color.red :
                   color.gray)

    activeZoneSummary =
         bullOBNear  ? "Price near Bull Order Block" :
         bearOBNear  ? "Price near Bear Order Block" :
         bullBkrNear ? "Price near Bull Breaker" :
         bearBkrNear ? "Price near Bear Breaker" :
         bullMitNear ? "Price near Bull Mitigation" :
         bearMitNear ? "Price near Bear Mitigation" :
         "No major zone in play"

    activeZoneColor =
         bullOBNear or bullBkrNear or bullMitNear ? color.lime :
         bearOBNear or bearBkrNear or bearMitNear ? color.red :
         color.gray

    table.cell(dash, 0, 12, "Active Zone: " + activeZoneSummary, text_color=activeZoneColor)


// === MTF TABLE (Phase 6 Retail) ===
mtfPos = mtfPosition == "Top Left" ? position.top_left :
         mtfPosition == "Top Right" ? position.top_right :
         mtfPosition == "Bottom Left" ? position.bottom_left :
         position.bottom_right

var table mtfTable = table.new(mtfPos, 1, 5, border_width=1, bgcolor=color.new(color.black, 80), frame_color=color.white)

if barstate.islast and enableMTFScanner and showMTFTable and not minimalMode
    table.cell(mtfTable, 0, 0, "MTF Scanner", text_color=color.white)
    table.cell(mtfTable, 0, 1, mtf1 + ": " + mtfText1, text_color=mtfColor1)
    table.cell(mtfTable, 0, 2, mtf2 + ": " + mtfText2, text_color=mtfColor2)
    table.cell(mtfTable, 0, 3, mtf3 + ": " + mtfText3, text_color=mtfColor3)
    table.cell(mtfTable, 0, 4,
        tripleBullish ? "Triple Bullish" :
        tripleBearish ? "Triple Bearish" : "Mixed",
        text_color=tripleBullish ? color.lime : tripleBearish ? color.red : color.orange)


// === STATS TABLE (Phase 6 Retail) ===
statsPos = statsPosition == "Top Left" ? position.top_left :
           statsPosition == "Top Right" ? position.top_right :
           statsPosition == "Bottom Left" ? position.bottom_left :
           position.bottom_right

var table statsTable = table.new(statsPos, 1, 9, border_width=1, bgcolor=color.new(color.black, 82), frame_color=color.white)

if barstate.islast and enableStatsMode and showStatsTable and not minimalMode
    table.cell(statsTable, 0, 0, "Stats Mode", text_color=color.white)
    table.cell(statsTable, 0, 1, "Trades: " + str.tostring(totalTrades), text_color=color.white)
    table.cell(statsTable, 0, 2, "Wins: " + str.tostring(winTrades) + " | Losses: " + str.tostring(lossTrades), text_color=color.white)
    table.cell(statsTable, 0, 3, "Win Rate: " + (na(winRate) ? "—" : str.tostring(winRate, "#.##") + "%"), text_color=na(winRate) ? color.gray : winRate >= 50 ? color.lime : color.red)
    table.cell(statsTable, 0, 4, "Avg RR: " + (na(avgRR) ? "—" : str.tostring(avgRR, "#.##")), text_color=color.aqua)
    table.cell(statsTable, 0, 5, "TP1 Hits: " + str.tostring(tp1HitsCount) + " | TP2 Hits: " + str.tostring(tp2HitsCount), text_color=color.yellow)
    table.cell(statsTable, 0, 6, "C/B/A/S Trades: " + str.tostring(cTrades) + "/" + str.tostring(bTrades) + "/" + str.tostring(aTrades) + "/" + str.tostring(sTrades), text_color=color.white)
    table.cell(statsTable, 0, 7, "C/B/A/S Win%: " +
        (na(cWinRate) ? "—" : str.tostring(cWinRate, "#")) + "/" +
        (na(bWinRate) ? "—" : str.tostring(bWinRate, "#")) + "/" +
        (na(aWinRate) ? "—" : str.tostring(aWinRate, "#")) + "/" +
        (na(sWinRate) ? "—" : str.tostring(sWinRate, "#")),
        text_color=color.aqua)
    table.cell(statsTable, 0, 8, tradeActive ? "Trade Active" : "No Active Trade", text_color=tradeActive ? color.lime : color.gray)
// ============================================================
// === OB COLOR LEGEND ===
// ============================================================
var table obLegend = table.new(position.bottom_right, 1, 8, border_width=0)

if barstate.islast and showOBLegend and not minimalMode
    table.cell(obLegend, 0, 0, "Order Block Color Legend", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.small)
    table.cell(obLegend, 0, 1, "Red = Oldest",   text_color=color.red,             text_size=size.tiny)
    table.cell(obLegend, 0, 2, "Orange",         text_color=color.new(#FFA500, 0), text_size=size.tiny)
    table.cell(obLegend, 0, 3, "Yellow",         text_color=color.yellow,          text_size=size.tiny)
    table.cell(obLegend, 0, 4, "Green",          text_color=color.lime,            text_size=size.tiny)
    table.cell(obLegend, 0, 5, "Blue",           text_color=color.blue,            text_size=size.tiny)
    table.cell(obLegend, 0, 6, "Indigo",         text_color=color.new(#4B0082, 0), text_size=size.tiny)
    table.cell(obLegend, 0, 7, "Violet = Newest", text_color=color.new(#9400D3, 0), text_size=size.tiny)
// ============================================================
// === SMC QUICK GUIDE ===
// ============================================================
var table guide = table.new(position.bottom_left, 1, 9,
    bgcolor=color.new(color.black, 30), border_width=2, border_color=color.fuchsia)

if showCheatSheet and not minimalMode
    table.cell(guide, 0, 0, "SMC QUICK GUIDE",                    text_color=color.yellow, text_size=size.normal)
    table.cell(guide, 0, 1, "CHoCH ↑ → Expect HL (reversal)",     text_color=color.orange)
    table.cell(guide, 0, 2, "CHoCH ↓ → Expect LH (reversal)",     text_color=color.orange)
    table.cell(guide, 0, 3, "BOS ↑ → Expect HH (continuation)",   text_color=color.lime)
    table.cell(guide, 0, 4, "BOS ↓ → Expect LL (continuation)",   text_color=color.red)
    table.cell(guide, 0, 5, "HH = Higher High",                   text_color=color.lime)
    table.cell(guide, 0, 6, "HL = Higher Low",                    text_color=color.green)
    table.cell(guide, 0, 7, "LH = Lower High",                    text_color=color.orange)
    table.cell(guide, 0, 8, "LL = Lower Low",                     text_color=color.red)
    
// ============================================================
// === ALERTS ===
// ============================================================

// Entry signals
alertcondition(buySignal,  title="📈 Buy Signal",  message="📈 BUY signal triggered on {{ticker}} at {{close}}")
alertcondition(sellSignal, title="📉 Sell Signal", message="📉 SELL signal triggered on {{ticker}} at {{close}}")

// Structure
alertcondition(validBullCHoCH, title="🟠 Bullish CHoCH", message="🟠 Bullish CHoCH on {{ticker}} at {{close}} → Expect HL")
alertcondition(validBearCHoCH, title="🟠 Bearish CHoCH", message="🟠 Bearish CHoCH on {{ticker}} at {{close}} → Expect LH")
alertcondition(bullishBOS,     title="🟢 Bullish BOS",   message="🟢 Bullish BOS on {{ticker}} at {{close}} → Expect HH")
alertcondition(bearishBOS,     title="🔴 Bearish BOS",   message="🔴 Bearish BOS on {{ticker}} at {{close}} → Expect LL")

// FVG taps
alertcondition(array.size(bullTouchBars) > 0 and not na(array.get(bullTouchBars, array.size(bullTouchBars) - 1)),
    title="🟢 Bullish FVG Tap", message="🟢 Bullish FVG Tap on {{ticker}} at {{close}}")
alertcondition(array.size(bearTouchBars) > 0 and not na(array.get(bearTouchBars, array.size(bearTouchBars) - 1)),
    title="🔻 Bearish FVG Tap", message="🔻 Bearish FVG Tap on {{ticker}} at {{close}}")

// IDM
alertcondition(useIDMFilter and not na(pivotHigh), title="💡 Liquidity High Swing", message="💡 Liquidity High swing on {{ticker}} at {{high}}")
alertcondition(useIDMFilter and not na(pivotLow),  title="💡 Liquidity Low Swing",  message="💡 Liquidity Low swing on {{ticker}} at {{low}}")

// Structure shifts
alertcondition(bullShift, title="⬆️ Bullish Structure Shift", message="⬆️ Bullish Structure Shift on {{ticker}} → CHoCH + BOS")
alertcondition(bearShift, title="⬇️ Bearish Structure Shift", message="⬇️ Bearish Structure Shift on {{ticker}} → CHoCH + BOS")

// Prediction confirmations (from published)
alertcondition(expectHL == false and not na(pivotLow)  and not na(expectedHLLevel) and low  > expectedHLLevel,
    title="✅ HL Confirmed", message="✅ Higher Low confirmed on {{ticker}} at {{low}}")
alertcondition(expectLH == false and not na(pivotHigh) and not na(expectedLHLevel) and high < expectedLHLevel,
    title="✅ LH Confirmed", message="✅ Lower High confirmed on {{ticker}} at {{high}}")
alertcondition(expectHH == false and not na(pivotHigh) and high > nz(lastSwingHigh[1]),
    title="✅ HH Confirmed", message="✅ Higher High confirmed on {{ticker}} at {{high}}")
alertcondition(expectLL == false and not na(pivotLow)  and low  < nz(lastSwingLow[1]),
    title="✅ LL Confirmed", message="✅ Lower Low confirmed on {{ticker}} at {{low}}")

// Trendline breaks
alertcondition(trendlineBrokenBull, title="⚠️ Bullish Trendline Broken",
    message="⚠️ Bullish trendline broken on {{ticker}} at {{close}} — structure may reverse or CHoCH soon")
alertcondition(trendlineBrokenBear, title="⚠️ Bearish Trendline Broken",
    message="⚠️ Bearish trendline broken on {{ticker}} at {{close}} — structure may reverse or CHoCH soon")

// OB mitigation
alertcondition(newBullOBMitigation, title="✅ Bullish OB Mitigated",
    message="✅ Bullish HTF Order Block mitigated on {{ticker}} at {{close}}")
alertcondition(newBearOBMitigation, title="✅ Bearish OB Mitigated",
    message="✅ Bearish HTF Order Block mitigated on {{ticker}} at {{close}}")

// BOS + OB confluence
alertcondition(bullishBOS and newBearOBMitigation, title="🟢 Bullish BOS + Bear OB Mitigated",
    message="🟢 Bullish BOS + Bear OB Mitigated on {{ticker}} at {{close}} → Bullish confirmation")
alertcondition(bearishBOS and newBullOBMitigation, title="🔴 Bearish BOS + Bull OB Mitigated",
    message="🔴 Bearish BOS + Bull OB Mitigated on {{ticker}} at {{close}} → Bearish confirmation")

// Confluence grade alerts (from test version)
alertcondition(bullSetup, title="⭐ Bull Setup (Grade OK)",
    message="⭐ Bull setup (grade passed) on {{ticker}} at {{close}}")
alertcondition(bearSetup, title="⭐ Bear Setup (Grade OK)",
    message="⭐ Bear setup (grade passed) on {{ticker}} at {{close}}")

// OTE zone touch
alertcondition(alertOnOTETouch and priceInOTE, title="🎯 Price in OTE Zone",
    message="🎯 Price entered OTE zone (0.618–0.79 Fib) on {{ticker}} at {{close}} — high-probability entry window")

// Breaker Blocks (Phase 4)
alertcondition(newBullBreaker, title="🔵 Bull Breaker Block Created",
    message="🔵 Bull Breaker Block created on {{ticker}} at {{close}} — bear OB violated, zone flipped bullish")
alertcondition(newBearBreaker, title="🔴 Bear Breaker Block Created",
    message="🔴 Bear Breaker Block created on {{ticker}} at {{close}} — bull OB violated, zone flipped bearish")
alertcondition(bullBkrTappedThisBar, title="🔵 Bull Breaker Tapped",
    message="🔵 Bull Breaker Block tapped on {{ticker}} at {{close}} — high-probability long zone")
alertcondition(bearBkrTappedThisBar, title="🔴 Bear Breaker Tapped",
    message="🔴 Bear Breaker Block tapped on {{ticker}} at {{close}} — high-probability short zone")

// TP Projection hits (Phase 5)
alertcondition(alertOnTP1Hit and tp1Hit, title="✅ TP1 Hit (1.272 Extension)",
    message="✅ TP1 hit on {{ticker}} at {{close}} — 1.272 Fib extension reached. Consider partial close.")
alertcondition(alertOnTP2Hit and tp2Hit, title="✅ TP2 Hit (1.618 Extension)",
    message="✅ TP2 hit on {{ticker}} at {{close}} — 1.618 Fib extension reached. Full target achieved.")
alertcondition(tripleBullish, title="🟢 Triple Bullish MTF",
    message="🟢 Triple Bullish MTF alignment on {{ticker}}")
alertcondition(tripleBearish, title="🔴 Triple Bearish MTF",
    message="🔴 Triple Bearish MTF alignment on {{ticker}}")

// end of Script® — SMC Reversal Engine v4.3 Final | All Phases Complete
