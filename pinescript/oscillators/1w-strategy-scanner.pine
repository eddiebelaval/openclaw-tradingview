//@version=5
indicator("1W Strategy Scanner", shorttitle="1W Scan", overlay=true)

// ===============================================
// НАСТРОЙКИ
// ===============================================
ema50_len   = input.int(50,  "EMA 50 период")
ema200_len  = input.int(200, "EMA 200 период")
rsi_len     = input.int(14,  "RSI период")
rsi_min     = input.int(50,  "RSI минимум",  minval=1,  maxval=100)
rsi_max     = input.int(80,  "RSI максимум", minval=1,  maxval=100)
ext_max     = input.float(20.0, "Макс. расстояние от EMA50, %", minval=1.0, maxval=50.0)
vol_min     = input.int(500000, "Минимальный объём")

// ===============================================
// ДАННЫЕ НЕДЕЛЬНОГО ТАЙМФРЕЙМА
// ===============================================
w_close  = request.security(syminfo.tickerid, "W", close,  lookahead=barmerge.lookahead_off)
w_high   = request.security(syminfo.tickerid, "W", high,   lookahead=barmerge.lookahead_off)
w_volume = request.security(syminfo.tickerid, "W", volume, lookahead=barmerge.lookahead_off)

w_ema50  = request.security(syminfo.tickerid, "W", ta.ema(close, ema50_len),  lookahead=barmerge.lookahead_off)
w_ema200 = request.security(syminfo.tickerid, "W", ta.ema(close, ema200_len), lookahead=barmerge.lookahead_off)
w_rsi    = request.security(syminfo.tickerid, "W", ta.rsi(close, rsi_len),    lookahead=barmerge.lookahead_off)

// 52-недельный максимум и минимум
w_52h = request.security(syminfo.tickerid, "W", ta.highest(high, 52), lookahead=barmerge.lookahead_off)
w_52l = request.security(syminfo.tickerid, "W", ta.lowest(low, 52),   lookahead=barmerge.lookahead_off)

// ===============================================
// УСЛОВИЯ СТРАТЕГИИ
// ===============================================

// 1. Цена выше EMA 200
c1 = w_close > w_ema200

// 2. Цена выше EMA 50
c2 = w_close > w_ema50

// 3. RSI в рабочей зоне
c3 = w_rsi >= rsi_min and w_rsi <= rsi_max

// 4. Цена не слишком далеко от EMA 50
dist_from_ema50 = (w_close - w_ema50) / w_ema50 * 100
c4 = dist_from_ema50 <= ext_max

// 5. EMA 50 выше EMA 200 — Golden Cross
c5 = w_ema50 > w_ema200

// 6. EMA 200 наклон вверх (за последние 4 недели)
c6 = w_ema200 > w_ema200[4]

// 7. Объём выше минимума
c7 = w_volume >= vol_min

// 8. Цена в верхней половине 52-недельного диапазона
mid52 = (w_52h + w_52l) / 2
c8 = w_close >= mid52

// ===============================================
// ИТОГОВЫЙ СИГНАЛ
// ===============================================
score = (c1 ? 1 : 0) + (c2 ? 1 : 0) + (c3 ? 1 : 0) + (c4 ? 1 : 0) + (c5 ? 1 : 0) + (c6 ? 1 : 0) + (c7 ? 1 : 0) + (c8 ? 1 : 0)

signal_strong = c1 and c2 and c3 and c4 and c5 and c6 and c7 and c8
signal_watch  = c1 and c2 and c3 and c7 and score >= 6

// ===============================================
// ВИЗУАЛИЗАЦИЯ
// ===============================================
plot(w_ema50,  "EMA 50 (W)",  color=color.new(#00ff88, 0), linewidth=2)
plot(w_ema200, "EMA 200 (W)", color=color.new(#4488ff, 0), linewidth=2)

bgcolor(signal_strong ? color.new(#00ff88, 92) : na)

if barstate.islast
    lbl_color = signal_strong ? color.new(#00ff88, 10) : signal_watch ? color.new(#ff9500, 10) : color.new(#ff4466, 10)
    status    = signal_strong ? "✅ СЕТАП" : signal_watch ? "👀 WATCHLIST" : "❌ НЕТ"
    
    // Выносим большой текст в отдельную переменную — это решает ошибку "end of line without line continuation"
    label_text = status + "\n" +
                 "Score: " + str.tostring(score) + "/8\n" +
                 "RSI: "   + str.tostring(math.round(w_rsi, 1)) + (c3 ? " ✓" : " ✗") + "\n" +
                 "Dist: "  + str.tostring(math.round(dist_from_ema50, 1)) + "%" + (c4 ? " ✓" : " ✗") + "\n" +
                 "GX: "    + (c5 ? "✓" : "✗") + " | Vol: " + (c7 ? "✓" : "✗")

    label.new(bar_index, high * 1.01,
         text      = label_text,
         color     = lbl_color,
         textcolor = color.white,
         style     = label.style_label_lower_left,
         size      = size.normal)

// ===============================================
// КОЛОНКИ ДЛЯ PINE SCREENER
// ===============================================
plot(signal_strong ? 1 : 0, "Сигнал",        display=display.none)
plot(score,                  "Score",          display=display.none)
plot(w_rsi,                  "RSI",            display=display.none)
plot(dist_from_ema50,        "Dist EMA50 %",   display=display.none)
