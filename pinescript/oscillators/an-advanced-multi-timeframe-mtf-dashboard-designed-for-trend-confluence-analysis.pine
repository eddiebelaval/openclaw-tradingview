//@version=5
indicator("MTF 跨级别共振表 ", overlay = true)

// --- 输入设置 ---
i_pos    = input.string("top_right", "位置", options=["top_right", "bottom_right", "top_left", "bottom_left"])
i_emaLen = input.int(20, "EMA周期")
i_rsiLen = input.int(14, "RSI周期")

// --- 基础指标逻辑定义 ---
emaVal = ta.ema(close, i_emaLen)
rsiVal = ta.rsi(close, i_rsiLen)
[mLine, mSig, _] = ta.macd(close, 12, 26, 9)
mBull  = mLine > mSig

// --- 数据采集 (Security) ---
// 5分钟
c5 = request.security(syminfo.tickerid, "5", close)
e5 = request.security(syminfo.tickerid, "5", emaVal)
r5 = request.security(syminfo.tickerid, "5", rsiVal)
m5 = request.security(syminfo.tickerid, "5", mBull)

// 15分钟
c15 = request.security(syminfo.tickerid, "15", close)
e15 = request.security(syminfo.tickerid, "15", emaVal)
r15 = request.security(syminfo.tickerid, "15", rsiVal)
m15 = request.security(syminfo.tickerid, "15", mBull)

// 1小时
c60 = request.security(syminfo.tickerid, "60", close)
e60 = request.security(syminfo.tickerid, "60", emaVal)
r60 = request.security(syminfo.tickerid, "60", rsiVal)
m60 = request.security(syminfo.tickerid, "60", mBull)

// 4小时
c240 = request.security(syminfo.tickerid, "240", close)
e240 = request.security(syminfo.tickerid, "240", emaVal)
r240 = request.security(syminfo.tickerid, "240", rsiVal) // 已修正变量名
m240 = request.security(syminfo.tickerid, "240", mBull)

// 日线
cD = request.security(syminfo.tickerid, "D", close)
eD = request.security(syminfo.tickerid, "D", emaVal)
rD = request.security(syminfo.tickerid, "D", rsiVal)
mD = request.security(syminfo.tickerid, "D", mBull)

// --- 表格初始化 ---
var pos = i_pos == "top_right" ? position.top_right : i_pos == "bottom_right" ? position.bottom_right : i_pos == "top_left" ? position.top_left : position.bottom_left
var dash = table.new(pos, 5, 6, border_width=1, frame_color=color.gray, border_color=color.gray)

// --- 绘制函数 (仅在最后一根K线执行) ---
if barstate.islast
    // 表头
    table.cell(dash, 0, 0, "级别", bgcolor=color.black, text_color=color.white)
    table.cell(dash, 1, 0, "EMA", bgcolor=color.black, text_color=color.white)
    table.cell(dash, 2, 0, "RSI", bgcolor=color.black, text_color=color.white)
    table.cell(dash, 3, 0, "MACD", bgcolor=color.black, text_color=color.white)
    table.cell(dash, 4, 0, "共振", bgcolor=color.black, text_color=color.white)

    // 数据行填充逻辑
    // 5m
    s5 = (c5 > e5 ? 1 : 0) + (r5 > 50 ? 1 : 0) + (m5 ? 1 : 0)
    table.cell(dash, 0, 1, "5m", bgcolor=color.new(color.gray, 50), text_color=color.white)
    table.cell(dash, 1, 1, c5 > e5 ? "多" : "空", bgcolor=c5 > e5 ? color.new(color.green, 30) : color.new(color.red, 30))
    table.cell(dash, 2, 1, r5 > 50 ? ">50" : "<50", bgcolor=r5 > 50 ? color.new(color.green, 30) : color.new(color.red, 30))
    table.cell(dash, 3, 1, m5 ? "金叉" : "死叉", bgcolor=m5 ? color.new(color.green, 30) : color.new(color.red, 30))
    table.cell(dash, 4, 1, s5 == 3 ? "强多" : s5 == 0 ? "强空" : "调整", bgcolor=s5 == 3 ? color.green : s5 == 0 ? color.red : color.orange)

    // 15m
    s15 = (c15 > e15 ? 1 : 0) + (r15 > 50 ? 1 : 0) + (m15 ? 1 : 0)
    table.cell(dash, 0, 2, "15m", bgcolor=color.new(color.gray, 50), text_color=color.white)
    table.cell(dash, 1, 2, c15 > e15 ? "多" : "空", bgcolor=c15 > e15 ? color.new(color.green, 30) : color.new(color.red, 30))
    table.cell(dash, 2, 2, r15 > 50 ? ">50" : "<50", bgcolor=r15 > 50 ? color.new(color.green, 30) : color.new(color.red, 30))
    table.cell(dash, 3, 2, m15 ? "金叉" : "死叉", bgcolor=m15 ? color.new(color.green, 30) : color.new(color.red, 30))
    table.cell(dash, 4, 2, s15 == 3 ? "强多" : s15 == 0 ? "强空" : "调整", bgcolor=s15 == 3 ? color.green : s15 == 0 ? color.red : color.orange)

    // 1H
    s60 = (c60 > e60 ? 1 : 0) + (r60 > 50 ? 1 : 0) + (m60 ? 1 : 0)
    table.cell(dash, 0, 3, "1H", bgcolor=color.new(color.gray, 50), text_color=color.white)
    table.cell(dash, 1, 3, c60 > e60 ? "多" : "空", bgcolor=c60 > e60 ? color.new(color.green, 30) : color.new(color.red, 30))
    table.cell(dash, 2, 3, r60 > 50 ? ">50" : "<50", bgcolor=r60 > 50 ? color.new(color.green, 30) : color.new(color.red, 30))
    table.cell(dash, 3, 3, m60 ? "金叉" : "死叉", bgcolor=m60 ? color.new(color.green, 30) : color.new(color.red, 30))
    table.cell(dash, 4, 3, s60 == 3 ? "强多" : s60 == 0 ? "强空" : "调整", bgcolor=s60 == 3 ? color.green : s60 == 0 ? color.red : color.orange)

    // 4H
    s240 = (c240 > e240 ? 1 : 0) + (r240 > 50 ? 1 : 0) + (m240 ? 1 : 0)
    table.cell(dash, 0, 4, "4H", bgcolor=color.new(color.gray, 50), text_color=color.white)
    table.cell(dash, 1, 4, c240 > e240 ? "多" : "空", bgcolor=c240 > e240 ? color.new(color.green, 30) : color.new(color.red, 30))
    table.cell(dash, 2, 4, r240 > 50 ? ">50" : "<50", bgcolor=r240 > 50 ? color.new(color.green, 30) : color.new(color.red, 30))
    table.cell(dash, 3, 4, m240 ? "金叉" : "死叉", bgcolor=m240 ? color.new(color.green, 30) : color.new(color.red, 30))
    table.cell(dash, 4, 4, s240 == 3 ? "强多" : s240 == 0 ? "强空" : "调整", bgcolor=s240 == 3 ? color.green : s240 == 0 ? color.red : color.orange)

    // Daily
    sD = (cD > eD ? 1 : 0) + (rD > 50 ? 1 : 0) + (mD ? 1 : 0)
    table.cell(dash, 0, 5, "日线", bgcolor=color.new(color.gray, 50), text_color=color.white)
    table.cell(dash, 1, 5, cD > eD ? "多" : "空", bgcolor=cD > eD ? color.new(color.green, 30) : color.new(color.red, 30))
    table.cell(dash, 2, 5, rD > 50 ? ">50" : "<50", bgcolor=rD > 50 ? color.new(color.green, 30) : color.new(color.red, 30))
    table.cell(dash, 3, 5, mD ? "金叉" : "死叉", bgcolor=mD ? color.new(color.green, 30) : color.new(color.red, 30))
    table.cell(dash, 4, 5, sD == 3 ? "强多" : sD == 0 ? "强空" : "调整", bgcolor=sD == 3 ? color.green : sD == 0 ? color.red : color.orange)

// 绘制主图 EMA 方便参考
plot(emaVal, color=color.new(color.blue, 70), title="主图 EMA")
