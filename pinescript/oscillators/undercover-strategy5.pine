//@version=5
indicator("Undercover Strategy5", overlay=true)

// =========================================================================
// INPUTS
// =========================================================================
grp_ema = "EMA Settings"
emaFastLen = input.int(8, title="Fast EMA Length", group=grp_ema)
emaSlowLen = input.int(200, title="Slow EMA Length", group=grp_ema)
tolerancePct = input.float(0.10, title="200 EMA Retest Tolerance (%)", step=0.05, group=grp_ema, 
 tooltip="How close price needs to get to the 200 EMA to be considered a 'touch' or retest.")

grp_rsi = "RSI Settings"
rsiLen = input.int(14, title="RSI Length", group=grp_rsi)
rsiBuyMin = input.int(50, title="RSI Buy Zone Min", group=grp_rsi)
rsiBuyMax = input.int(60, title="RSI Buy Zone Max", group=grp_rsi)
rsiSellThresh = input.int(50, title="RSI Sell Threshold", group=grp_rsi)

// =========================================================================
// CALCULATIONS
// =========================================================================
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi = ta.rsi(close, rsiLen)

// Plot EMAs
plot(emaFast, title="8 EMA", color=color.blue, linewidth=1)
plot(emaSlow, title="200 EMA", color=color.red, linewidth=2)

// =========================================================================
// SELL LOGIC
// =========================================================================
// 8 EMA crosses below 200 EMA AND RSI < 50 on the exact crossover candle
sellSignal = ta.crossunder(emaFast, emaSlow) and (rsi < rsiSellThresh)

plotshape(sellSignal, title="Sell Signal", style=shape.labeldown, location=location.abovebar, 
 color=color.red, text="SELL", textcolor=color.white, size=size.small)

// =========================================================================
// BUY LOGIC (STATE MACHINE)
// =========================================================================
// State Tracking Variable:
// 0 = Bearish/Inactive
// 1 = Bullish Crossover Active (Waiting for a retest)
// 2 = Retest Occurred with Valid RSI (Waiting for a bullish bounce)
var int buyPhase = 0

// Reset / Initialize Phase based on EMA trend
if ta.crossover(emaFast, emaSlow)
    buyPhase := 1
else if ta.crossunder(emaFast, emaSlow)
    buyPhase := 0

// Define boundaries for "Touching" or "Dipping into" the 200 EMA
upperBound = emaSlow * (1 + (tolerancePct / 100))
lowerBound = emaSlow * (1 - (tolerancePct / 100))

// Sub-conditions
isRetest       = low <= upperBound      // Price touches or dips into the EMA tolerance zone
isRsiValid     = rsi >= rsiBuyMin and rsi <= rsiBuyMax
isBullishClose = close > open and close > emaSlow // Bounces and closes above 200 EMA
isInvalidated  = close < lowerBound     // Price closes too far below 200 EMA (failed retest)

buySignal = false

// Buy Phase 1: Trend is Bullish, looking for the initial Retest
// "not ta.crossover" ensures we do not trigger on the original crossover candle
if buyPhase == 1 and not ta.crossover(emaFast, emaSlow)
    if isRetest and isRsiValid
        if isBullishClose
            // Perfect scenario: Retests and bounces on the exact same candle (e.g., bullish pinbar)
            buySignal := true
            buyPhase := 1 // Stays in Phase 1 to allow for future retests in the same trend
        else if not isInvalidated
            // Retested properly but hasn't bounced yet. Move to Phase 2 to wait for a bounce.
            buyPhase := 2

// Buy Phase 2: Price has retested, RSI was valid, now waiting for bounce confirmation
else if buyPhase == 2
    if isBullishClose
        // Price confirmed the bounce on a subsequent candle
        buySignal := true
        buyPhase := 1 // Reset to Phase 1 to look for future retests
    else if isInvalidated
        // Price broke and closed below the tolerance zone, invalidating the setup
        buyPhase := 1

plotshape(buySignal, title="Buy Signal", style=shape.labelup, location=location.belowbar, 
 color=color.green, text="BUY", textcolor=color.white, size=size.small)

// =========================================================================
// ALERTS
// =========================================================================
alertcondition(sellSignal, title="Sell Alert", message="Sell Signal: 8 EMA crossed below 200 EMA with RSI < 50 on the 15m chart.")
alertcondition(buySignal, title="Buy Alert", message="Buy Signal: Price retested 200 EMA (RSI 50-60) and bounced back up on the 15m chart.")
