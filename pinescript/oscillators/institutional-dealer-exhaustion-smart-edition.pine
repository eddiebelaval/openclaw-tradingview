//@version=5
indicator("Institutional Dealer Exhaustion [Smart Edition]", shorttitle="DEALER EXH", overlay=false, precision=2)

// ============================================================
//                        INPUTS
// ============================================================
grp1 = "Core Settings"
lookback = input.int(20,    "Lookback Period",         minval=5,   group=grp1)
atr_len  = input.int(14,    "Volatility Length (ATR)", minval=1,   group=grp1)
mult             = input.float(2.0, "Sensitivity Multiplier", step=0.1, group=grp1)
smooth   = input.int(3,     "Smoothing Factor",        minval=1,   group=grp1)

grp2 = "Alert Settings"
alert_thresh = input.float(70.0, "Alert Threshold %",     step=1.0, group=grp2)
prox_pct     = input.float(0.5,  "Key Level Proximity %", step=0.1, group=grp2)
pivot_left   = input.int(10,     "Pivot Lookback (Left)", minval=3, group=grp2)
pivot_right  = input.int(10,     "Pivot Lookforward",     minval=3, group=grp2)

grp3 = "Display"
show_zones = input.bool(true, "Show Zone Backgrounds", group=grp3)
show_table = input.bool(true, "Show Debug Table",      group=grp3)

// ============================================================
//                     CALCULATIONS
// ============================================================

// 1. Use rolling SMA as anchor (more responsive than session VWAP on daily charts)
anchor = ta.sma(close, lookback)

// 2. Dispersion = distance from rolling mean
dispersion = math.abs(close - anchor)

// 3. Normalize by ATR
vol      = ta.atr(atr_len)
stdev_v  = ta.stdev(close, lookback)
safe_vol = (na(vol) or vol == 0.0) ? stdev_v : vol
denom    = (na(safe_vol) or safe_vol == 0.0) ? 0.0001 : safe_vol

// 4. Z-score style ratio (how many ATRs away from mean)
raw_ratio = dispersion / (denom * mult)

// 5. Sigmoid mapping to 0–100 (soft cap, never clips, always shows waves)
exhaustion_raw = 100.0 * (1.0 - math.exp(-0.25 * raw_ratio))

// 6. Smooth final value
exhaustion = ta.ema(exhaustion_raw, smooth)

// ============================================================
//                     DEBUG RAW VALUES (TABLE)
// ============================================================
// ============================================================
//                     PIVOT DETECTION
// ============================================================
pivot_hi = ta.pivothigh(high, pivot_left, pivot_right)
pivot_lo = ta.pivotlow(low,   pivot_left, pivot_right)

var float last_ph = na
var float last_pl = na
if not na(pivot_hi)
    last_ph := pivot_hi
if not na(pivot_lo)
    last_pl := pivot_lo

near_resistance = not na(last_ph) and (math.abs(close - last_ph) / close * 100.0) < prox_pct
near_support    = not na(last_pl) and (math.abs(close - last_pl) / close * 100.0) < prox_pct
near_level      = near_resistance or near_support

// ============================================================
//                     ZONE BACKGROUNDS
// ============================================================
extreme_zone  = exhaustion >= 75.0
moderate_zone = exhaustion >= 50.0 and exhaustion < 75.0

bgcolor(show_zones and extreme_zone  ? color.new(color.red,    92) : na, title="Extreme Zone BG")
bgcolor(show_zones and moderate_zone ? color.new(color.orange, 92) : na, title="Moderate Zone BG")

// ============================================================
//                     PLOTTING
// ============================================================
dyn_color = exhaustion >= 75.0 ? color.new(#ff5252, 10) : exhaustion >= 50.0 ? color.new(#ff9800, 30) : color.new(#9598a1, 50)

plot(nz(exhaustion), "Exhaustion Level", dyn_color, 2, plot.style_area)

hline(75, "Extreme Zone",  color.new(color.red,    40), hline.style_dashed)
hline(50, "Moderate Zone", color.new(color.orange, 60), hline.style_dotted)
hline(25, "Neutral Zone",  color.new(color.gray,   80), hline.style_dotted)
hline(alert_thresh, "Alert Threshold", color.new(color.yellow, 30), hline.style_solid)

// ============================================================
//                     SMART ALERT
// ============================================================
alert_trigger = ta.crossover(exhaustion, alert_thresh) and near_level

alertcondition(alert_trigger, "⚠️ Dealer Exhaustion at Structure", "Exhaustion crossed threshold near a key pivot — potential reversion setup.")

plotshape(alert_trigger, "Smart Alert", shape.labelup, location.absolute, color.new(color.yellow, 0), text="⚠️", textcolor=color.black, size=size.small)

// ============================================================
//                     DEBUG TABLE
// ============================================================
var table debug = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 10), border_color=color.new(color.gray, 40), border_width=1, frame_color=color.new(color.gray, 40), frame_width=1)

if show_table and barstate.islast
    table.cell(debug, 0, 0, "DEALER EXH",   text_color=color.white,  bgcolor=color.new(color.blue, 60), text_size=size.small)
    table.cell(debug, 1, 0, "STATUS",        text_color=color.white,  bgcolor=color.new(color.blue, 60), text_size=size.small)
    table.cell(debug, 0, 1, "System",        text_color=color.silver, text_size=size.small)
    table.cell(debug, 1, 1, "🟢 ACTIVE",    text_color=color.green,  text_size=size.small)
    table.cell(debug, 0, 2, "Exhaustion %",  text_color=color.silver, text_size=size.small)
    table.cell(debug, 1, 2, str.tostring(nz(exhaustion), "#.##"),     text_color=color.aqua, text_size=size.small)
    table.cell(debug, 0, 3, "Raw Ratio",     text_color=color.silver, text_size=size.small)
    table.cell(debug, 1, 3, str.tostring(nz(raw_ratio), "#.####"),    text_color=color.yellow, text_size=size.small)
    table.cell(debug, 0, 4, "Dispersion",    text_color=color.silver, text_size=size.small)
    table.cell(debug, 1, 4, str.tostring(nz(dispersion), "#.##"),     text_color=color.yellow, text_size=size.small)
    table.cell(debug, 0, 5, "Near Pivot",    text_color=color.silver, text_size=size.small)
    table.cell(debug, 1, 5, near_level ? "✅ YES" : "❌ NO",          text_color=near_level ? color.green : color.red, text_size=size.small)
    string zone_label = exhaustion >= 75.0 ? "🔴 EXHAUSTION" : exhaustion >= 50.0 ? "🟠 SATURATION" : exhaustion >= 25.0 ? "🟡 NEUTRAL" : "🟢 EQUILIBRIUM"
    table.cell(debug, 0, 6, "Zone",          text_color=color.silver, text_size=size.small)
    table.cell(debug, 1, 6, zone_label,      text_color=color.white,  text_size=size.small)
