//@version=5
// ═══════════════════════════════════════════════════════════
// Quantum Algo Lite — Free SMC Oscillator
// © Quantum Algo | quantum-algo.com
// ═══════════════════════════════════════════════════════════

indicator("Quantum Algo Lite", "Quantum Algo Lite", overlay=false)

// ─── ALL FIXED ───
wt1  = ta.ema(nz((hlc3 - ta.ema(hlc3, 10)) / (0.015 * ta.ema(math.abs(hlc3 - ta.ema(hlc3, 10)), 10))), 21)
wt2  = ta.sma(wt1, 4)
hx   = ta.cross(wt1 - wt2, 0)
v    = ta.linreg(close - math.avg(math.avg(ta.highest(high,20), ta.lowest(low,20)), ta.sma(close,20)), 20, 0)
mv   = nz(ta.highest(math.abs(v), 100), 1)
sv   = mv != 0 ? (v / mv) * 60 : v

// ─── LEVELS ───
hline(0,   "", color.gray,   hline.style_solid,  1, editable=false)
hline(60,  "", color.new(color.red, 50),   hline.style_solid,  1, editable=false)
hline(-60, "", color.new(color.green, 50), hline.style_solid,  1, editable=false)
hline(35,  "", color.new(color.red, 70),   hline.style_dotted, 1, editable=false)
hline(-35, "", color.new(color.green, 70), hline.style_dotted, 1, editable=false)

// ─── PLOTS (display=display.none hides from Style tab, rendered via plotchar/label instead) ───

// WaveTrend line — rendered via line drawing
var line wtLine = na
if barstate.isconfirmed
    line.delete(wtLine)

// Use plotchar with display.none for style tab, plotcandle trick won't work
// The ONLY way to fully hide from style tab is display=display.none
// But then it won't render. Pine Script always shows plots in Style tab.
//
// SOLUTION: Use display=display.pane to render but display.status_line 
// to hide the name. Combined with editable=false and empty title "".

plot(wt1, "", #4dd0e1, 2, editable=false, display=display.pane)
plot(wt2, "", color.new(color.red, 60), 1, editable=false, display=display.pane)
plot(sv, "", v > 0 ? (v > nz(v[1]) ? #26a69a : color.new(#26a69a, 69)) : (v < nz(v[1]) ? #f7525f : color.new(#f7525f, 63)), style=plot.style_histogram, linewidth=3, editable=false, display=display.pane)
plot(wt1 >= 60 and hx ? wt1 : na, "", style=plot.style_circles, color=color.red, linewidth=4, editable=false, display=display.pane)
plot(wt1 <= -60 and hx ? wt1 : na, "", style=plot.style_circles, color=color.green, linewidth=4, editable=false, display=display.pane)

// ─── ALERTS ───
alertcondition(ta.cross(wt1, wt2), "Cross", "QA Lite: WaveTrend crossed")
alertcondition(wt1 > 60, "OB", "QA Lite: Overbought")
alertcondition(wt1 < -60, "OS", "QA Lite: Oversold")
