//@version=5
indicator("Merged RSI + Dual MACD Oscillator (with MACD & Signal)", shorttitle="RSI+MACD OSC+", overlay=false)

// ──────────────────────────
// INPUTS
// ──────────────────────────
smoothLen   = input.int(5, "Final Oscillator Smoothing")
macdNormLen = input.int(50, "MACD Normalization Length")
histScale   = input.float(1.8, "Histogram Height Multiplier", step=0.1)

// ──────────────────────────
// RSI MERGE (14-21-28)
// ──────────────────────────
rsi1 = ta.rsi(close, 14)
rsi2 = ta.rsi(close, 21)
rsi3 = ta.rsi(close, 28)

rsiAvg  = (rsi1 + rsi2 + rsi3) / 3
rsiNorm = (rsiAvg - 50) / 50

// ──────────────────────────
// MACD MERGE (8-17-9 & 19-39-9)
// ──────────────────────────
[macd1, sig1, hist1] = ta.macd(close, 8, 17, 9)
[macd2, sig2, hist2] = ta.macd(close, 19, 39, 9)

macdLineAvg   = (macd1 + macd2) / 2
signalLineAvg = (sig1 + sig2) / 2
macdHistAvg   = (hist1 + hist2) / 2

normBase   = ta.ema(math.abs(macdHistAvg), macdNormLen)
macdNorm   = macdLineAvg   / normBase
signalNorm = signalLineAvg / normBase
histNorm   = macdHistAvg   / normBase

// ──────────────────────────
// FINAL OSCILLATOR
// ──────────────────────────
mergedOsc    = (rsiNorm + histNorm) / 2
mergedSmooth = ta.ema(mergedOsc, smoothLen)

// ──────────────────────────
// COLORS
// ──────────────────────────
oscColor    = mergedSmooth >= 0 ? color.lime : color.red
macdColor   = color.blue
signalColor = color.orange

// ──────────────────────────
// PLOTS
// ──────────────────────────
hline(0, "Zero Line", color=color.gray)

// MAIN OSCILLATOR
plot(mergedSmooth,
     title="Merged RSI + MACD Oscillator",
     linewidth=2,
     color=oscColor)

// SUPPORTING MACD LINE
plot(macdNorm,
     title="MACD Line (Support)",
     linewidth=1,
     color=macdColor)

// SUPPORTING SIGNAL LINE
plot(signalNorm,
     title="Signal Line (Support)",
     linewidth=1,
     color=signalColor)

// SCALED HISTOGRAM (MORE HEIGHT)
plot(mergedSmooth * histScale,
     title="Osc Histogram (Scaled)",
     style=plot.style_columns,
     color = mergedSmooth >= 0
             ? color.new(color.lime, 60)
             : color.new(color.red, 60))
