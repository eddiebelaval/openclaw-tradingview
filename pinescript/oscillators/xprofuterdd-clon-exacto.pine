//@version=5
indicator("XprofuterDD [Clon Exacto]", overlay=false)

// --- Parámetros de Entrada ---
per = input.int(14, "Period for signal (per)")
drawShift = input.int(14, "Forward shift (drawShift)")
maPeriod = input.int(34, "Moving average period (maPeriod)")
showFuture = input.bool(true, "Mostrar cola proyectada (Repintado)")

// --- Lógica Matemática Base ---
// Equivalente a (close - open) / _Point en MQL5
float point_mult = 1.0 / syminfo.mintick
float body = (close - open) * point_mult

// En MQL5, el desplazamiento visual hace que la línea sólida histórica
// sea exactamente la suma de los cuerpos de las últimas (per + 1) velas.
float signal_hist = math.sum(body, per + 1)

// La media móvil es el SMA simple de esa señal
float ma_hist = ta.sma(signal_hist, maPeriod)

// --- Dibujo del Historial (Líneas sólidas, NO repintan) ---
plot(signal_hist, color=color.red, linewidth=2, title="Signal (Histórica)")
plot(ma_hist, color=color.blue, linewidth=2, title="MA (Histórica)")
hline(0, color=color.gray, linestyle=hline.style_dashed)

// --- Lógica de la Cola Futura (Idéntico al repintado de MQL5) ---
if showFuture and barstate.islast
    var line[] future_lines_sig = array.new_line()
    var line[] future_lines_ma = array.new_line()
    
    // Limpiar las líneas punteadas del tick anterior
    if array.size(future_lines_sig) > 0
        for i = 0 to array.size(future_lines_sig) - 1
            line.delete(array.get(future_lines_sig, i))
            line.delete(array.get(future_lines_ma, i))
        array.clear(future_lines_sig)
        array.clear(future_lines_ma)
        
    // Simular el buffer de MQL5 para calcular la proyección
    int buffer_size = drawShift + maPeriod + 1
    float[] buffer1 = array.new_float(buffer_size, 0.0)
    
    for b = 0 to buffer_size - 1
        int lim = b - per < 0 ? 0 : b - per
        float imp = 0.0
        for i = lim to b
            imp += body[i]
        array.set(buffer1, b, imp)
        
    // Trazar los segmentos hacia el futuro
    float prev_sig = signal_hist
    float prev_ma = ma_hist
    
    for k = 1 to drawShift
        int b = drawShift - k // Índice de barra simulado estilo MQL5
        float val_sig = array.get(buffer1, b)
        
        float imp_ma = 0.0
        for i = b to b + maPeriod - 1
            imp_ma += array.get(buffer1, i)
        float val_ma = imp_ma / maPeriod
        
        // Dibujar líneas punteadas proyectadas en el gráfico
        array.push(future_lines_sig, line.new(bar_index + k - 1, prev_sig, bar_index + k, val_sig, color=color.red, width=2, style=line.style_dotted))
        array.push(future_lines_ma, line.new(bar_index + k - 1, prev_ma, bar_index + k, val_ma, color=color.blue, width=2, style=line.style_dotted))
        
        prev_sig := val_sig
        prev_ma := val_ma
