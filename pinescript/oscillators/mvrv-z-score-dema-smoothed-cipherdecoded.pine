//                      ███    ███ ▀▀███▀▀▀     ███        ███    ███ ███    ███ ▀▀███▀▀▀      ███    ███         
//                      ███    ███   ███    █▄  ███    █▄  ███    ███ ███    ███   ███    █▄   ███    ███        
//                      ███   ▄███   ███    ███ ███    ███ ███    ███ ███   ▄███   ███    ███  ███   ▄███         
//                      ████████▀    ██████████ ████████▀   ▀██████▀  ████████▀    ██████████  ████████▀    

//@version=6
indicator("MVRV Z-Score (DEMA Smoothed) | CipherDecoded", 
     overlay = false, 
     precision = 2
    )

//======================================================================================================================
//                                                  Functions
//======================================================================================================================
zscore(src, len) =>
    mean = ta.sma(src, len)
    stdev = ta.stdev(src, len)
    (src - mean)/stdev

dema(src, len) =>
    e1 = ta.ema(src, len)
    e2 = ta.ema(e1, len)
    2.0 * e1 - e2

rs(src)         => request.security(src, "D", barstate.isconfirmed ? close : close[1])

//======================================================================================================================
//                                                  MVRV Request
//======================================================================================================================
MC              = rs("GLASSNODE:BTC_MARKETCAP") //Market Cap
RMC             = rs("COINMETRICS:BTC_MARKETCAPREAL") //Realised Market Cap

MVRV            = MC / RMC

//======================================================================================================================
//                                                  Calculations
//======================================================================================================================
len_z           = input.int(100,    title  = "Z-Score Length",                     group   = 'Input', tooltip = "Lookback period used to calculate the MVRV Z-score.\nHigher = smoother, slower regime shifts.\nLower = more reactive, more noise.")
len_d           = input.int(45,     title  = "DEMA Length",                        group   = 'Input', tooltip = "Smoothing length applied to the Z-score using DEMA.\nHigher = smoother signal, more lag.\nLower = faster turns, more whipsaws.")

MVRV_Z          = zscore(MVRV, len_z)
d_mvrv          = dema(MVRV_Z, len_d)

ls_thresh       = input.float(0.0,  title  = "Long/Short Threshold", step = 0.1,   group   = 'input')

//======================================================================================================================
//                                                  Visual
//======================================================================================================================
col = d_mvrv > ls_thresh ? color.rgb(51, 255, 0, 0) : color.rgb(255, 0, 43, 0)

plot(d_mvrv, color = col)
barcolor(col)
hline(ls_thresh)

