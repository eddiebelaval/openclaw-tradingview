// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("Institutional Flow Divergence Oscillator", shorttitle="IFDO", overlay=false)

// --- Constants ---
var float CENTER = 0.0

// --- Inputs ---
int   lengthInput      = input.int(14, "Institutional Flow Length", minval=1, tooltip="The period used to calculate the institutional flow metric.")
int   smoothInput      = input.int(5, "Smoothing Period", minval=1, tooltip="Smoothing period for the oscillator line.")
int   pivotLookback    = input.int(5, "Pivot Lookback (Left/Right)", minval=1, tooltip="Left and right bars to confirm a pivot high or low.")
color bullColorInput   = input.color(#089981, "Bullish Color", inline="Colors")
color bearColorInput   = input.color(#f23645, "Bearish Color", inline="Colors")

// --- Calculations ---
// Institutional Flow Proxy: Money Flow based on Close position relative to range, weighted by volume
float priceRange = high - low
float flowRaw = priceRange != 0 ? ((close - low) - (high - close)) / priceRange * volume : 0.0

// Normalize using a relative strength calculation on the cumulative flow
float flowEma = ta.ema(flowRaw, lengthInput)
float upFlow = ta.ema(math.max(flowEma - flowEma[1], 0), lengthInput)
float downFlow = ta.ema(math.max(flowEma[1] - flowEma, 0), lengthInput)
float rsiFlow = downFlow == 0 ? 100 : upFlow == 0 ? 0 : 100 - (100 / (1 + upFlow / downFlow))

// Centered Oscillator (-100 to 100)
float oscillator = ta.ema(rsiFlow - 50, smoothInput) * 2

// --- Divergence Logic ---
// We use simple pivot-based divergence detection
float ph = ta.pivothigh(oscillator, pivotLookback, pivotLookback)
float pl = ta.pivotlow(oscillator, pivotLookback, pivotLookback)

// Price pivots at the same points
float pricePH = ta.pivothigh(high, pivotLookback, pivotLookback)
float pricePL = ta.pivotlow(low, pivotLookback, pivotLookback)

// Detect Regular Bullish Divergence
bool bullDiv = false
var float lastOscLow = na
var float lastPriceLow = na
if not na(pl)
    if oscillator[pivotLookback] > lastOscLow and low[pivotLookback] < lastPriceLow
        bullDiv := true
    lastOscLow := oscillator[pivotLookback]
    lastPriceLow := low[pivotLookback]

// Detect Regular Bearish Divergence
bool bearDiv = false
var float lastOscHigh = na
var float lastPriceHigh = na
if not na(ph)
    if oscillator[pivotLookback] < lastOscHigh and high[pivotLookback] > lastPriceHigh
        bearDiv := true
    lastOscHigh := oscillator[pivotLookback]
    lastPriceHigh := high[pivotLookback]

// --- Visuals ---
// Oscillator Plot
color oscColor = oscillator > CENTER ? bullColorInput : bearColorInput
plotOsc = plot(oscillator, "Institutional Flow", color=oscColor, linewidth=2)
// For fill, we need a second plot. We use plot(0) with no color.
plotCenter = plot(CENTER, "Center Reference", color=na)

// Centered Oscillator Gradient Fill
// Guideline: 100% transparent at center, 50% transparent at oscillator value
fill(plotCenter, plotOsc, 
     top_value = math.max(CENTER, oscillator), 
     bottom_value = math.min(CENTER, oscillator), 
     top_color = oscillator > CENTER ? color.new(bullColorInput, 50) : color.new(chart.bg_color, 100), 
     bottom_color = oscillator > CENTER ? color.new(chart.bg_color, 100) : color.new(bearColorInput, 50))

// Divergence Visuals
plotshape(bullDiv, "Bullish Divergence", shape.triangleup, location.bottom, bullColorInput, offset=-pivotLookback, size=size.small, text="BULL", textcolor=bullColorInput)
plotshape(bearDiv, "Bearish Divergence", shape.triangledown, location.top, bearColorInput, offset=-pivotLookback, size=size.small, text="BEAR", textcolor=bearColorInput)

// Reference Levels
hline(0, "Center Line", color=color.new(chart.fg_color, 50), linestyle=hline.style_dashed)
hline(50, "Upper Threshold", color=color.new(chart.fg_color, 80), linestyle=hline.style_dotted)
hline(-50, "Lower Threshold", color=color.new(chart.fg_color, 80), linestyle=hline.style_dotted)
