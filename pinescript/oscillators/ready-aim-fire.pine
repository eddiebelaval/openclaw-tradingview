//@version=6
// =================================================================
// Trigger Lock Release Pro+
// =================================================================
// © 2026 NPR21 (TradingView: @NPR21) | All Rights Reserved
// VERSION: 2.0 | DATE: March 19, 2026
//
// Converted from ThinkScript: ST_Ready_Aim_Fire_Pro
// Original concept: Copyright (c) 2010-2020 David H. Starr
// Pine Script v6 conversion and professional visual upgrades
// by NPR21.
//
// THREE PHASES: READY → LOCKED → FIRE!
//
// WORKS ON: Any liquid market. All timeframes.
// =================================================================

indicator("Ready, Aim, Fire!",
     shorttitle="RAF",
     overlay=false,
     max_labels_count=500,
     max_lines_count=500,
     explicit_plot_zorder=true)

// =================================================================
// █ MAIN CONTROLS
// =================================================================
proLength = input.int(28, "Smoothing Length", minval=5, maxval=100,
     group="█ MAIN CONTROLS")
obosLevel = input.float(1.2, "Overbought / Oversold Level",
     minval=0.5, maxval=3.0, step=0.1,
     group="█ MAIN CONTROLS")
generateAlerts = input.bool(false, "Generate Alerts",
     group="█ MAIN CONTROLS")
alertRequiresLock = input.bool(true, "Alert Requires LOCKED State",
     group="█ MAIN CONTROLS")

// =================================================================
// █ VISUAL OPTIONS
// =================================================================
fireSize = input.string("Small", "FIRE! Label Size",
     options=["Tiny", "Small", "Normal", "Large"],
     group="█ VISUAL OPTIONS")
stateSize = input.string("Small", "READY/LOCKED Label Size",
     options=["Tiny", "Small", "Normal", "Large"],
     group="█ VISUAL OPTIONS")
showADX = input.bool(true, "Show ADX Strength Markers",
     group="█ VISUAL OPTIONS")
showFireLabels = input.bool(true, "Show FIRE! Labels",
     group="█ VISUAL OPTIONS",
     tooltip="FIRE! labels at every Fisher inflection\n" +
          "point with a dashed vertical line.")
showArrows = input.bool(false, "Show Inflection Arrows (▲▼)",
     group="█ VISUAL OPTIONS",
     tooltip="Original green/red triangle arrows at\n" +
          "every Fisher inflection. Off by default\n" +
          "since FIRE! labels replace them.")
showStateLabels = input.bool(true, "Show READY/LOCKED Labels",
     group="█ VISUAL OPTIONS")
showClouds = input.bool(true, "Show Background Clouds",
     group="█ VISUAL OPTIONS",
     tooltip="Green/red tinted clouds between OB/OS\n" +
          "lines during READY/LOCKED states.")

fireSz = switch fireSize
    "Tiny" => size.tiny
    "Small" => size.small
    "Normal" => size.normal
    "Large" => size.large
    => size.small
stateSz = switch stateSize
    "Tiny" => size.tiny
    "Small" => size.small
    "Normal" => size.normal
    "Large" => size.large
    => size.small

// =================================================================
// █ STOCHASTIC ENGINE
// =================================================================
float rawK1 = ta.stoch(close, high, low, 5)
float k1ema = ta.ema(rawK1, 3)
float k1v   = math.max(-100.0, math.min(100.0, k1ema - 50.0)) / 50.01

float rawK2 = ta.stoch(close, high, low, 8)
float k2ema = ta.ema(rawK2, 5)
float k2v   = math.max(-100.0, math.min(100.0, k2ema - 50.0)) / 50.01

float rawK3 = ta.stoch(close, high, low, 17)
float k3ema = ta.ema(rawK3, 5)
float k3v   = math.max(-100.0, math.min(100.0, k3ema - 50.0)) / 50.01

// =================================================================
// █ TEMA TREND FILTER + ATR BUFFER
// =================================================================
float _ema1 = ta.ema(close, proLength)
float _ema2 = ta.ema(_ema1, proLength)
float _ema3 = ta.ema(_ema2, proLength)
float tavg  = 3.0 * _ema1 - 3.0 * _ema2 + _ema3

int   halfLen   = math.floor(proLength / 2)
float savg      = tavg[halfLen]
float matr      = 0.5 * ta.atr(10)
int   savgstate = low > savg + matr ? 1 : high < savg - matr ? -1 : 0

// =================================================================
// █ ADX TREND STRENGTH
// =================================================================
[diPlus, diMinus, adxVal] = ta.dmi(halfLen, halfLen)
bool adxTurnedUp = adxVal > adxVal[1] and adxVal[1] <= adxVal[2]

color trendColor = savgstate == 1 ? color.rgb(0, 255, 0) :
     savgstate == -1 ? color.rgb(255, 0, 0) : color.rgb(255, 255, 0)

// =================================================================
// █ TRIGGER STATE ENGINE
// =================================================================
var int SC = 0

if k2v > 0
    int chg = (k1v <= k2v and k1v[1] > k2v[1] and k2v[1] > 0) ? -1 : 0
    SC := math.min(0, nz(SC[1], 0)) + chg
else
    int chg = (k1v >= k2v and k1v[1] < k2v[1] and k2v[1] <= 0) ? 1 : 0
    SC := math.max(0, nz(SC[1], 0)) + chg

// =================================================================
// █ READY / LOCKED VERTICAL LINES + LABELS
// =================================================================
bool crossEvent = (k2v > 0 and k1v <= k2v and k1v[1] > k2v[1]) or
                  (k2v < 0 and k1v >= k2v and k1v[1] < k2v[1])

color readyBull  = color.rgb(0, 180, 0)
color lockedBull = color.rgb(0, 255, 0)
color readyBear  = color.rgb(180, 0, 0)
color lockedBear = color.rgb(255, 0, 0)

color evtColor = SC > 1 ? lockedBull :
     SC == 1 ? readyBull :
     SC < -1 ? lockedBear :
     readyBear

color evtTextColor = color.rgb(255, 255, 255)
string evtText = math.abs(SC) > 1 ? "AIM" : "READY"

// Alternate label Y position to prevent overlap
var int evtToggle = 0

if crossEvent
    line.new(bar_index, -3.5, bar_index, 3.5,
         color=color.new(evtColor, 10),
         width=1,
         style=line.style_dashed)
    if showStateLabels
        evtToggle := nz(evtToggle[0], 0) == 0 ? 1 : 0
        float lblY = evtToggle == 0 ? -3.2 : -4.0
        label.new(bar_index, lblY, evtText,
             color=color.new(evtColor, 40),
             textcolor=evtTextColor,
             style=label.style_label_up,
             size=stateSz)

// =================================================================
// █ BACKGROUND CLOUDS (between OB/OS only)
// =================================================================
// Deep forest green / dark crimson matched to ToS original.
color cloudLockedBull = color.rgb(0, 110, 0)
color cloudReadyBull  = color.rgb(0, 85, 0)
color cloudLockedBear = color.rgb(150, 0, 0)
color cloudReadyBear  = color.rgb(110, 0, 0)

float cTop = (showClouds and SC != 0) ? obosLevel : na
float cBot = (showClouds and SC != 0) ? -obosLevel : na

color cCol = not showClouds ? na :
     SC > 1 ? color.new(cloudLockedBull, 15) :
     SC == 1 ? color.new(cloudReadyBull, 30) :
     SC < -1 ? color.new(cloudLockedBear, 15) :
     SC == -1 ? color.new(cloudReadyBear, 30) :
     na

pCT = plot(cTop, "Cloud Top", display=display.none)
pCB = plot(cBot, "Cloud Bot", display=display.none)
fill(pCT, pCB, cCol)

// OB/OS lines
plot(obosLevel, "Overbought", color.new(#ff0000, 0), linewidth=1, display=display.pane)
plot(-obosLevel, "Oversold", color.new(#09ff00, 0), linewidth=1, display=display.pane)

// =================================================================
// █ ZERO LINE — gaps around ADX markers (ToS style)
// =================================================================
bool adxFire = showADX and adxTurnedUp

float zeroLine = adxFire ? na : 0.0
plot(zeroLine, "Zero Line", trendColor, linewidth=2,
     style=plot.style_linebr, display=display.pane)

// ADX strength markers — trend-colored squares on zero line
if adxFire
    label.new(bar_index, -0.15, "■",
         color=color.new(color.black, 100),
         textcolor=trendColor,
         style=label.style_none,
         size=size.normal)

// =================================================================
// █ MOMENTUM LINE (Fisher Transform — gradient colored)
// =================================================================
float k3c = math.max(-0.999, math.min(0.999, k3v))
float logVal = math.log((1.0 + k3c) / (1.0 - k3c))

var float f3 = 0.0
float f3new = 0.5 * (logVal + nz(f3[1], 0.0))
f3 := na(f3new) ? nz(f3[1], 0.0) : f3new

// Solid magenta — matched to ThinkOrSwim original
color momColor = color.rgb(255, 0, 255)

plot(not na(close) ? f3 : na, "Momentum", momColor, linewidth=2, display=display.pane)

// =================================================================
// █ FIRE! SIGNALS (Fisher inflection points)
// =================================================================
// Direct from original ThinkScript MajorBuy / MajorSell logic.
// Sign of Fisher derivative flips = inflection = FIRE!

bool majorBuy  = math.sign(f3 - f3[1]) > math.sign(f3[1] - f3[2]) and not na(close)
bool majorSell = math.sign(f3 - f3[1]) < math.sign(f3[1] - f3[2]) and not na(close)

color fluoGreen = color.rgb(0, 255, 65)
color fluoRed   = color.rgb(255, 0, 65)
color fireOrange = color.rgb(255, 165, 0)

// FIRE! labels with dashed vertical lines
if majorSell and showFireLabels
    line.new(bar_index, -3.5, bar_index, 3.5,
         color=color.new(fluoRed, 30),
         width=1,
         style=line.style_dashed)
    label.new(bar_index, f3[1] + 0.6, "FIRE!",
         color=fluoRed,
         textcolor=color.rgb(0, 0, 0),
         style=label.style_label_down,
         size=fireSz)

if majorBuy and showFireLabels
    line.new(bar_index, -3.5, bar_index, 3.5,
         color=color.new(fluoGreen, 30),
         width=1,
         style=line.style_dashed)
    label.new(bar_index, f3[1] - 0.6, "FIRE!",
         color=fluoGreen,
         textcolor=color.rgb(0, 0, 0),
         style=label.style_label_up,
         size=fireSz)

// Original arrows (optional, off by default)
if majorBuy and showArrows
    label.new(bar_index, f3[1] - 0.8, "▲",
         color=color.new(fluoGreen, 100),
         textcolor=fluoGreen,
         style=label.style_none,
         size=fireSz)

if majorSell and showArrows
    label.new(bar_index, f3[1] + 0.15, "▼",
         color=color.new(fluoRed, 100),
         textcolor=fluoRed,
         style=label.style_none,
         size=fireSz)

// =================================================================
// █ ALERTS
// =================================================================
bool aBuy  = generateAlerts and majorBuy and
     (not alertRequiresLock or SC > 1)
bool aSell = generateAlerts and majorSell and
     (not alertRequiresLock or SC < -1)

alertcondition(aBuy,
     "TLR FIRE BUY",
     "Trigger Lock Release Pro+: FIRE BUY on {{ticker}} {{interval}}")
alertcondition(aSell,
     "TLR FIRE SELL",
     "Trigger Lock Release Pro+: FIRE SELL on {{ticker}} {{interval}}")

// =================================================================
// END — Trigger Lock Release Pro+ v2.0 by NPR21
// =================================================================
