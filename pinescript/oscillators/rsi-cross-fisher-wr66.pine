//@version=5
strategy("RSI Cross Strategy (Rango personalizado)", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// === INPUTS ===
rsiLength = input.int(14, title="RSI Length")

startDate = input.time(timestamp("2023-01-01 00:00"), "Fecha inicio")
endDate   = input.time(timestamp("2026-12-31 00:00"), "Fecha fin")

// === RSI ===
rsi = ta.rsi(close, rsiLength)

// === FILTRO DE RANGO ===
inRange = (time >= startDate and time <= endDate)

// === CONDICIONES ===
buySignal = ta.crossunder(rsi, 50) and inRange
sellSignal = ta.crossover(rsi, 70) and inRange

// === EJECUCIÓN ===
if (buySignal)
    strategy.entry("Long", strategy.long)

if (sellSignal)
    strategy.close("Long")

// === VISUAL ===
plot(rsi, color=color.blue)
hline(50)
hline(70)
