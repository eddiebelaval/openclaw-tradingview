//@version=5
indicator("ROC 18 with Institutional -10 Level", overlay=false, precision=2)

// 1. Settings - Using Length 18 as requested
rocLength = input.int(18, minval=1, title="ROC Length")
src = input(close, title="Source")

// 2. Calculation
rocValue = ta.roc(src, rocLength)

// 3. Plotting the ROC Line
plot(rocValue, color=color.blue, linewidth=2, title="ROC Line")

// 4. Plotting the -10 Level (Forces the scale to stay visible)
plot(-10, "Extreme Momentum Level", color=color.red, linewidth=1, style=plot.style_linebr)

// 5. Zero Line for Neutral Reference
hline(0, "Zero Line", color=color.gray, linestyle=hline.style_dotted)

// 6. Dynamic Background Highlight (Optional: Highlights when below -10)
bgcolor(rocValue < -10 ? color.new(color.red, 90) : na)
