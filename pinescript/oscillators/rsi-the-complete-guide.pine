//@version=5
indicator("RSI Framework Protocol [Coding Partner]", shorttitle="RSI Framework", overlay=false)

// =========================================================================
// 1. INPUTS & SETUP
// =========================================================================
rsiLen = input.int(14, title="RSI Length")
pivotLen = input.int(5, title="Pivot Lookback (For Divergence)")
src = input.source(close, title="Source")

// --- Divergence Legend & Color Settings ---
grp_div = "Divergence Legend (Candle & Line Colors)"
col_sBull = input.color(color.lime, title="Simple Bullish (Reversal / Exhaustion)", group=grp_div)
col_hBull = input.color(color.aqua, title="Hidden Bullish (Trend Continuation)", group=grp_div)
col_sBear = input.color(color.fuchsia, title="Simple Bearish (Reversal / Exhaustion)", group=grp_div)
col_hBear = input.color(color.maroon, title="Hidden Bearish (Trend Continuation)", group=grp_div)

myRsi = ta.rsi(src, rsiLen)

// =========================================================================
// 2. PLOTTING THE INDICATORS & BOUNDARIES
// =========================================================================
plot(myRsi, title="RSI Line", color=color.new(#2962FF, 0), linewidth=2)

// Core Regime Boundaries
hline(80, title="80 - Strong Bullish", color=color.new(color.green, 50), linestyle=hline.style_dashed)
hline(65, title="65 - Confidence Trigger", color=color.new(color.teal, 50), linestyle=hline.style_dotted)
hline(60, title="60 - Bearish Ceiling", color=color.new(color.gray, 40))
hline(40, title="40 - Bullish Floor", color=color.new(color.gray, 40))
hline(20, title="20 - Strong Bearish", color=color.new(color.red, 50), linestyle=hline.style_dashed)

// =========================================================================
// 3. RANGE SHIFTS & CONTINUOUS REGIME COLORING
// =========================================================================
bullShift = ta.crossover(myRsi, 60)
bearShift = ta.crossunder(myRsi, 40)

// Memory variable to track the current regime
var int regime = 0

if bullShift
    regime := 1
else if bearShift
    regime := -1

// Continuously color the candles based on the active regime
regimeColor = regime == 1 ? color.new(color.green, 0) : regime == -1 ? color.new(color.red, 0) : na
barcolor(regimeColor, title="Continuous Regime Candles")

// Vertical background highlight to show the exact moment the shift happened
bgcolor(bullShift ? color.new(color.green, 85) : na, title="Bear-to-Bull Shift Highlight")
bgcolor(bearShift ? color.new(color.red, 85) : na, title="Bull-to-Bear Shift Highlight")

// =========================================================================
// 4. PIVOT TRACKING FOR DIVERGENCE
// =========================================================================
rsiPivotHigh = ta.pivothigh(myRsi, pivotLen, pivotLen)
rsiPivotLow  = ta.pivotlow(myRsi, pivotLen, pivotLen)

var float p1_rsiHigh = na
var float p1_priceHigh = na
var int p1_highBar = na

var float p1_rsiLow = na
var float p1_priceLow = na
var int p1_lowBar = na

// Flags for retroactive candle coloring
bool isSBear = false
bool isHBear = false
bool isSBull = false
bool isHBull = false

// =========================================================================
// 5. DIVERGENCE LOGIC, TARGETING & CHART DRAWING
// =========================================================================
// --- Bearish Scenarios (Evaluated on RSI Tops) ---
if not na(rsiPivotHigh)
    float p2_rsiHigh = myRsi[pivotLen]
    float p2_priceHigh = high[pivotLen]
    int p2_highBar = bar_index[pivotLen]
    
    if not na(p1_rsiHigh)
        // Mathematically guarantee the lowest point between the two peaks
        int barsBetween = p2_highBar - p1_highBar
        float interveningLow = low[pivotLen]
        if barsBetween > 0 and barsBetween < 500
            for i = pivotLen to (pivotLen + barsBetween)
                interveningLow := math.min(interveningLow, low[i])
                
        float priceDelta = math.abs(p1_priceHigh - p2_priceHigh)
        
        // Simple Bearish (Reversal: Price HH, RSI LH)
        if p2_priceHigh > p1_priceHigh and p2_rsiHigh < p1_rsiHigh
            isSBear := true
            float divTarget = interveningLow - priceDelta
            label.new(p2_highBar, p2_rsiHigh + 5, text="S-Bear\nTgt: " + str.tostring(math.round(divTarget, 2)), color=color.new(col_sBear, 20), textcolor=color.white, style=label.style_label_down, size=size.small)
            line.new(p1_highBar, p1_rsiHigh, p2_highBar, p2_rsiHigh, color=col_sBear, width=2)
            line.new(p1_highBar, p1_priceHigh, p2_highBar, p2_priceHigh, color=col_sBear, width=2, force_overlay=true) 
            
        // Hidden Bearish (Continuation: Price LH, RSI HH)
        else if p2_priceHigh < p1_priceHigh and p2_rsiHigh > p1_rsiHigh
            isHBear := true
            float divTarget = interveningLow - priceDelta
            label.new(p2_highBar, p2_rsiHigh + 5, text="H-Bear\nTgt: " + str.tostring(math.round(divTarget, 2)), color=color.new(col_hBear, 20), textcolor=color.white, style=label.style_label_down, size=size.small)
            line.new(p1_highBar, p1_rsiHigh, p2_highBar, p2_rsiHigh, color=col_hBear, width=2)
            line.new(p1_highBar, p1_priceHigh, p2_highBar, p2_priceHigh, color=col_hBear, width=2, force_overlay=true) 

    p1_rsiHigh := p2_rsiHigh
    p1_priceHigh := p2_priceHigh
    p1_highBar := p2_highBar

// --- Bullish Scenarios (Evaluated on RSI Bottoms) ---
if not na(rsiPivotLow)
    float p2_rsiLow = myRsi[pivotLen]
    float p2_priceLow = low[pivotLen]
    int p2_lowBar = bar_index[pivotLen]
    
    if not na(p1_rsiLow)
        // Mathematically guarantee the highest point between the two troughs
        int barsBetween = p2_lowBar - p1_lowBar
        float interveningHigh = high[pivotLen]
        if barsBetween > 0 and barsBetween < 500
            for i = pivotLen to (pivotLen + barsBetween)
                interveningHigh := math.max(interveningHigh, high[i])
                
        float priceDelta = math.abs(p1_priceLow - p2_priceLow)
        
        // Simple Bullish (Reversal: Price LL, RSI HL)
        if p2_priceLow < p1_priceLow and p2_rsiLow > p1_rsiLow
            isSBull := true
            float divTarget = interveningHigh + priceDelta
            label.new(p2_lowBar, p2_rsiLow - 5, text="S-Bull\nTgt: " + str.tostring(math.round(divTarget, 2)), color=color.new(col_sBull, 20), textcolor=color.white, style=label.style_label_up, size=size.small)
            line.new(p1_lowBar, p1_rsiLow, p2_lowBar, p2_rsiLow, color=col_sBull, width=2)
            line.new(p1_lowBar, p1_priceLow, p2_lowBar, p2_priceLow, color=col_sBull, width=2, force_overlay=true) 
            
        // Hidden Bullish (Continuation: Price HL, RSI LL)
        else if p2_priceLow > p1_priceLow and p2_rsiLow < p1_rsiLow
            isHBull := true
            float divTarget = interveningHigh + priceDelta
            label.new(p2_lowBar, p2_rsiLow - 5, text="H-Bull\nTgt: " + str.tostring(math.round(divTarget, 2)), color=color.new(col_hBull, 20), textcolor=color.white, style=label.style_label_up, size=size.small)
            line.new(p1_lowBar, p1_rsiLow, p2_lowBar, p2_rsiLow, color=col_hBull, width=2)
            line.new(p1_lowBar, p1_priceLow, p2_lowBar, p2_priceLow, color=col_hBull, width=2, force_overlay=true) 

    p1_rsiLow := p2_rsiLow
    p1_priceLow := p2_priceLow
    p1_lowBar := p2_lowBar

// =========================================================================
// 6. DIVERGENCE CANDLE COLORING (Retroactive)
// =========================================================================
// Apply the exact colors chosen in the settings menu to the candles
divColor = isSBull ? col_sBull : isHBull ? col_hBull : isSBear ? col_sBear : isHBear ? col_hBear : na
barcolor(divColor, offset=-pivotLen, title="Divergence Candles")
