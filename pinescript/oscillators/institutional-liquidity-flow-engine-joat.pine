//@version=6
indicator("Institutional Liquidity Flow Engine [JOAT]", shorttitle="ILF [JOAT]", overlay=false, precision=2, max_bars_back=500)

// ═══════════════════════════════════════════════════════════════════════════════
// INSTITUTIONAL LIQUIDITY FLOW ENGINE
// Advanced volume analysis with multi-exchange aggregation, session profiling,
// buyer/seller strength analysis, and comprehensive flow metrics
// ═══════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────

// Volume Analysis
volumeLength = input.int(20, "Volume MA Length", minval=1, group="Volume Analysis")
rvolThreshold = input.float(1.5, "High RVOL Threshold", minval=1.0, step=0.1, group="Volume Analysis")
extremeRvolThreshold = input.float(3.0, "Extreme RVOL Threshold", minval=2.0, step=0.1, group="Volume Analysis")

// Multi-Timeframe Settings
showMTF = input.bool(true, "Show Multi-Timeframe Analysis", group="Multi-Timeframe")
mtf1 = input.timeframe("5", "Timeframe 1", group="Multi-Timeframe")
mtf2 = input.timeframe("15", "Timeframe 2", group="Multi-Timeframe")
mtf3 = input.timeframe("60", "Timeframe 3", group="Multi-Timeframe")

// Buyer/Seller Strength
atrLength = input.int(14, "ATR Length", minval=1, group="Buyer/Seller Strength")
rsiLength = input.int(14, "RSI Length", minval=1, group="Buyer/Seller Strength")
rsiOverbought = input.int(70, "RSI Overbought", minval=50, maxval=100, group="Buyer/Seller Strength")
rsiOversold = input.int(30, "RSI Oversold", minval=0, maxval=50, group="Buyer/Seller Strength")

// Display Options
showTable = input.bool(true, "Show Info Table", group="Display")
showHistogram = input.bool(true, "Show Volume Histogram", group="Display")
showVWAP = input.bool(true, "Show VWAP Deviation", group="Display")
tablePosition = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="Display")

// Colors
colorBullish = input.color(color.new(#00e676, 30), "Bullish", group="Colors")
colorBearish = input.color(color.new(#ff5252, 30), "Bearish", group="Colors")
colorNeutral = input.color(color.new(#90a4ae, 50), "Neutral", group="Colors")
colorExtreme = input.color(color.new(#ff00ff, 20), "Extreme Volume", group="Colors")
colorHigh = input.color(color.new(#ffd740, 30), "High Volume", group="Colors")

// ─────────────────────────────────────────────────────────────────────────────
// FUNCTIONS
// ─────────────────────────────────────────────────────────────────────────────

// Get table position
getTablePosition(pos) =>
    switch pos
        "Top Right" => position.top_right
        "Top Left" => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left" => position.bottom_left
        => position.top_right

// Calculate smooth range (from RealGains)
smoothrng(x, t, m) =>
    wper = t * 2 - 1
    avrng = ta.ema(math.abs(x - x[1]), t)
    smoothrng = ta.ema(avrng, wper) * m
    smoothrng

// ─────────────────────────────────────────────────────────────────────────────
// VOLUME CALCULATIONS
// ─────────────────────────────────────────────────────────────────────────────

// Basic Volume Metrics
avgVolume = ta.sma(volume, volumeLength)
relativeVolume = avgVolume > 0 ? volume / avgVolume : 1.0
volumeMA = ta.ema(volume, volumeLength)

// Volume Oscillator (from knowledge base)
shortVol = ta.ema(volume, 5)
longVol = ta.ema(volume, 10)
volumeOsc = longVol > 0 ? 100 * (shortVol - longVol) / longVol : 0

// Smoothed ATR for volatility context
smoothATR = smoothrng(close, atrLength, 1.0)
atrValue = ta.atr(atrLength)

// ─────────────────────────────────────────────────────────────────────────────
// BUYER/SELLER STRENGTH ANALYSIS
// ─────────────────────────────────────────────────────────────────────────────

// Volume-based strength (from Buyer/Seller Strength indicator)
buyerVolume = close > open ? volume : 0
sellerVolume = close < open ? volume : 0
neutralVolume = close == open ? volume : 0

// Cumulative strength over period
buyerStrength = ta.sma(buyerVolume, volumeLength)
sellerStrength = ta.sma(sellerVolume, volumeLength)

// ATR-based strength
buyerStrengthATR = close > open and (high - low) > atrValue * 0.5 ? volume : 0
sellerStrengthATR = close < open and (high - low) > atrValue * 0.5 ? volume : 0

// RSI-based strength classification
rsiValue = ta.rsi(close, rsiLength)
buyStrengthRSI = rsiValue >= rsiOverbought ? "Strong" : rsiValue >= 50 ? "Moderate" : "Weak"
sellStrengthRSI = rsiValue <= rsiOversold ? "Strong" : rsiValue <= 50 ? "Moderate" : "Weak"

// Relative strength ratio
totalStrength = buyerStrength + sellerStrength
buyerRatio = totalStrength > 0 ? (buyerStrength / totalStrength) * 100 : 50
sellerRatio = totalStrength > 0 ? (sellerStrength / totalStrength) * 100 : 50

// Pressure indicator
netPressure = buyerStrength - sellerStrength
pressureDirection = netPressure > 0 ? "Bullish" : netPressure < 0 ? "Bearish" : "Neutral"

// ─────────────────────────────────────────────────────────────────────────────
// MULTI-TIMEFRAME ANALYSIS
// ─────────────────────────────────────────────────────────────────────────────

// Get RVOL from multiple timeframes
[rvol_mtf1, vol_mtf1] = request.security(syminfo.tickerid, mtf1, [relativeVolume, volume], lookahead=barmerge.lookahead_off)
[rvol_mtf2, vol_mtf2] = request.security(syminfo.tickerid, mtf2, [relativeVolume, volume], lookahead=barmerge.lookahead_off)
[rvol_mtf3, vol_mtf3] = request.security(syminfo.tickerid, mtf3, [relativeVolume, volume], lookahead=barmerge.lookahead_off)

// MTF Trend alignment
mtf1_bullish = rvol_mtf1 > 1.0 and vol_mtf1 > ta.sma(vol_mtf1, 20)
mtf2_bullish = rvol_mtf2 > 1.0 and vol_mtf2 > ta.sma(vol_mtf2, 20)
mtf3_bullish = rvol_mtf3 > 1.0 and vol_mtf3 > ta.sma(vol_mtf3, 20)

mtfAlignment = (mtf1_bullish ? 1 : 0) + (mtf2_bullish ? 1 : 0) + (mtf3_bullish ? 1 : 0)
mtfStatus = mtfAlignment == 3 ? "Strong Aligned" : mtfAlignment == 2 ? "Aligned" : mtfAlignment == 1 ? "Weak" : "No Alignment"

// ─────────────────────────────────────────────────────────────────────────────
// VOLUME SPEED & ACCELERATION
// ─────────────────────────────────────────────────────────────────────────────

// Volume Rate of Change (from knowledge base)
volumeROC = ta.roc(volume, 5)
volumeAcceleration = ta.change(volumeROC)

// Volume momentum
volumeMomentum = volume - ta.sma(volume, 10)
volumeMomentumPercent = ta.sma(volume, 10) > 0 ? (volumeMomentum / ta.sma(volume, 10)) * 100 : 0

// Volume trend strength
volumeTrend = ta.ema(volume, 5) > ta.ema(volume, 20) ? "Increasing" : "Decreasing"
volumeTrendStrength = math.abs(ta.ema(volume, 5) - ta.ema(volume, 20)) / ta.ema(volume, 20) * 100

// ─────────────────────────────────────────────────────────────────────────────
// FLOW METRICS
// ─────────────────────────────────────────────────────────────────────────────

// Money Flow Index
mfi = ta.mfi(close, volumeLength)

// Volume-weighted price momentum
vwap = ta.vwap(close)
vwapDeviation = close - vwap
vwapDeviationPercent = vwap != 0 ? (vwapDeviation / vwap) * 100 : 0

// Accumulation/Distribution
ad = ta.cum(close == high and close == low or high == low ? 0 : ((2 * close - low - high) / (high - low)) * volume)
adChange = ta.change(ad)
adTrend = adChange > 0 ? "Accumulation" : adChange < 0 ? "Distribution" : "Neutral"

// On-Balance Volume
obv = ta.cum(math.sign(ta.change(close)) * volume)
obvMA = ta.sma(obv, volumeLength)
obvTrend = obv > obvMA ? "Bullish" : obv < obvMA ? "Bearish" : "Neutral"

// ─────────────────────────────────────────────────────────────────────────────
// LIQUIDITY CLASSIFICATION
// ─────────────────────────────────────────────────────────────────────────────

// Volume status
volumeStatus = relativeVolume >= extremeRvolThreshold ? "Extreme" : relativeVolume >= rvolThreshold ? "High" : relativeVolume >= 1.0 ? "Normal" : relativeVolume >= 0.5 ? "Low" : "Very Low"

// Liquidity condition
liquidityCondition = relativeVolume >= rvolThreshold and netPressure > 0 ? "Strong Buying" : relativeVolume >= rvolThreshold and netPressure < 0 ? "Strong Selling" : relativeVolume >= 1.0 ? "Balanced" : "Thin"

// Market pressure level
pressureLevel = math.abs(netPressure) / avgVolume
pressureIntensity = pressureLevel >= 2.0 ? "Extreme" : pressureLevel >= 1.0 ? "High" : pressureLevel >= 0.5 ? "Moderate" : "Low"

// ─────────────────────────────────────────────────────────────────────────────
// PLOTTING
// ─────────────────────────────────────────────────────────────────────────────

// Relative Volume Histogram with THICK bars and gradient colors
histColor = relativeVolume >= extremeRvolThreshold ? colorExtreme : relativeVolume >= rvolThreshold ? colorHigh : relativeVolume >= 1.0 ? colorBullish : colorNeutral

// Main RVOL histogram - EXTRA THICK columns (linewidth doesn't affect columns, so we use area style for thickness)
plot(showHistogram ? relativeVolume : na, "RVOL", style=plot.style_area, color=histColor, linewidth=1)
plot(showHistogram ? relativeVolume : na, "RVOL Outline", style=plot.style_line, color=histColor, linewidth=4)

// Reference lines - more visible
hline(1.0, "Average", color=color.new(#ffffff, 50), linestyle=hline.style_solid, linewidth=2)
hline(rvolThreshold, "High Threshold", color=color.new(#ffd740, 40), linestyle=hline.style_dashed, linewidth=2)
hline(extremeRvolThreshold, "Extreme Threshold", color=color.new(#ff00ff, 40), linestyle=hline.style_dashed, linewidth=2)

// Buyer/Seller Pressure ratio as background fill with enhanced visibility
buyerLine = plot(buyerRatio / 100, "Buyer Pressure", color=color.new(#00e676, 100), linewidth=1)
zeroLine = plot(0, color=color.new(color.gray, 100), linewidth=1)
fill(buyerLine, zeroLine, color=color.new(#00e676, 90), title="Buyer Pressure Fill")

// Volume Oscillator as THICK histogram overlay
plot(volumeOsc / 200, "Volume Oscillator", color=volumeOsc > 0 ? color.new(#00e676, 50) : color.new(#ff5252, 50), linewidth=4, style=plot.style_histogram)

// MFI as THICK line overlay with gradient colors
plot(mfi / 100, "MFI Line", color=mfi >= 80 ? color.new(#ff5252, 20) : mfi >= 50 ? color.new(#00e676, 20) : mfi >= 20 ? color.new(#ffd740, 20) : color.new(#ff5252, 40), linewidth=4)

// ─────────────────────────────────────────────────────────────────────────────
// INFORMATION TABLE
// ─────────────────────────────────────────────────────────────────────────────

var table infoTable = table.new(getTablePosition(tablePosition), 2, 15, 
                                 bgcolor=color.new(#1a1a2e, 0), 
                                 border_width=2, 
                                 border_color=color.new(#16213e, 0))

if showTable and barstate.islast
    // Header with gradient effect
    table.cell(infoTable, 0, 0, "LIQUIDITY FLOW ENGINE [JOAT]", 
               bgcolor=color.new(#0f3460, 0), 
               text_color=color.new(#00d9ff, 0), 
               text_size=size.normal)
    table.cell(infoTable, 1, 0, "Value", 
               bgcolor=color.new(#0f3460, 0), 
               text_color=color.new(#00d9ff, 0), 
               text_size=size.normal)
    
    // RVOL with dynamic coloring
    rvolColor = relativeVolume >= extremeRvolThreshold ? color.new(#ff00ff, 30) : relativeVolume >= rvolThreshold ? color.new(#ffd740, 30) : color.new(#4a5568, 50)
    table.cell(infoTable, 0, 1, "RVOL", 
               bgcolor=color.new(#16213e, 30), 
               text_color=color.new(#e0e0e0, 0), 
               text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(relativeVolume, "#.##"), 
               bgcolor=rvolColor, 
               text_color=color.white, 
               text_size=size.small)
    
    // Volume Status with emoji-style indicators
    statusColor = volumeStatus == "Extreme" ? color.new(#ff00ff, 30) : volumeStatus == "High" ? color.new(#ffd740, 30) : volumeStatus == "Normal" ? color.new(#00e676, 50) : color.new(#90a4ae, 50)
    table.cell(infoTable, 0, 2, "Status", 
               bgcolor=color.new(#16213e, 30), 
               text_color=color.new(#e0e0e0, 0), 
               text_size=size.small)
    table.cell(infoTable, 1, 2, volumeStatus, 
               bgcolor=statusColor, 
               text_color=color.white, 
               text_size=size.small)
    
    // Volume Trend
    trendColor = volumeTrend == "Increasing" ? color.new(#00e676, 30) : color.new(#ff5252, 30)
    table.cell(infoTable, 0, 3, "Volume Trend", 
               bgcolor=color.new(#16213e, 30), 
               text_color=color.new(#e0e0e0, 0), 
               text_size=size.small)
    table.cell(infoTable, 1, 3, volumeTrend, 
               bgcolor=trendColor, 
               text_color=color.white, 
               text_size=size.small)
    
    // Pressure with gradient
    pressureColor = pressureDirection == "Bullish" ? color.new(#00e676, 20) : pressureDirection == "Bearish" ? color.new(#ff5252, 20) : color.new(#90a4ae, 50)
    table.cell(infoTable, 0, 4, "Pressure", 
               bgcolor=color.new(#16213e, 30), 
               text_color=color.new(#e0e0e0, 0), 
               text_size=size.small)
    table.cell(infoTable, 1, 4, pressureDirection, 
               bgcolor=pressureColor, 
               text_color=color.white, 
               text_size=size.small)
    
    // Buyer Strength with percentage bar effect
    buyerColor = buyerRatio >= 70 ? color.new(#00e676, 20) : buyerRatio >= 50 ? color.new(#00e676, 50) : color.new(#4a5568, 50)
    table.cell(infoTable, 0, 5, "Buyer Strength", 
               bgcolor=color.new(#16213e, 30), 
               text_color=color.new(#e0e0e0, 0), 
               text_size=size.small)
    table.cell(infoTable, 1, 5, str.tostring(buyerRatio, "#.#") + "%", 
               bgcolor=buyerColor, 
               text_color=color.white, 
               text_size=size.small)
    
    // Seller Strength
    sellerColor = sellerRatio >= 70 ? color.new(#ff5252, 20) : sellerRatio >= 50 ? color.new(#ff5252, 50) : color.new(#4a5568, 50)
    table.cell(infoTable, 0, 6, "Seller Strength", 
               bgcolor=color.new(#16213e, 30), 
               text_color=color.new(#e0e0e0, 0), 
               text_size=size.small)
    table.cell(infoTable, 1, 6, str.tostring(sellerRatio, "#.#") + "%", 
               bgcolor=sellerColor, 
               text_color=color.white, 
               text_size=size.small)
    
    // RSI Strength
    rsiColor = rsiValue >= rsiOverbought ? color.new(#ff5252, 30) : rsiValue <= rsiOversold ? color.new(#00e676, 30) : color.new(#ffd740, 50)
    table.cell(infoTable, 0, 7, "RSI", 
               bgcolor=color.new(#16213e, 30), 
               text_color=color.new(#e0e0e0, 0), 
               text_size=size.small)
    table.cell(infoTable, 1, 7, str.tostring(rsiValue, "#.#"), 
               bgcolor=rsiColor, 
               text_color=color.white, 
               text_size=size.small)
    
    // Liquidity Condition
    liquidityColor = liquidityCondition == "Strong Buying" ? color.new(#00e676, 20) : liquidityCondition == "Strong Selling" ? color.new(#ff5252, 20) : liquidityCondition == "Balanced" ? color.new(#ffd740, 50) : color.new(#90a4ae, 50)
    table.cell(infoTable, 0, 8, "Liquidity", 
               bgcolor=color.new(#16213e, 30), 
               text_color=color.new(#e0e0e0, 0), 
               text_size=size.small)
    table.cell(infoTable, 1, 8, liquidityCondition, 
               bgcolor=liquidityColor, 
               text_color=color.white, 
               text_size=size.small)
    
    // MTF Alignment
    mtfColor = mtfAlignment == 3 ? color.new(#00e676, 20) : mtfAlignment == 2 ? color.new(#ffd740, 30) : color.new(#ff5252, 50)
    table.cell(infoTable, 0, 9, "MTF Alignment", 
               bgcolor=color.new(#16213e, 30), 
               text_color=color.new(#e0e0e0, 0), 
               text_size=size.small)
    table.cell(infoTable, 1, 9, mtfStatus, 
               bgcolor=mtfColor, 
               text_color=color.white, 
               text_size=size.small)
    
    // A/D Trend
    adColor = adTrend == "Accumulation" ? color.new(#00e676, 30) : adTrend == "Distribution" ? color.new(#ff5252, 30) : color.new(#90a4ae, 50)
    table.cell(infoTable, 0, 10, "A/D Trend", 
               bgcolor=color.new(#16213e, 30), 
               text_color=color.new(#e0e0e0, 0), 
               text_size=size.small)
    table.cell(infoTable, 1, 10, adTrend, 
               bgcolor=adColor, 
               text_color=color.white, 
               text_size=size.small)
    
    // OBV Trend
    obvColor = obvTrend == "Bullish" ? color.new(#00e676, 30) : obvTrend == "Bearish" ? color.new(#ff5252, 30) : color.new(#90a4ae, 50)
    table.cell(infoTable, 0, 11, "OBV Trend", 
               bgcolor=color.new(#16213e, 30), 
               text_color=color.new(#e0e0e0, 0), 
               text_size=size.small)
    table.cell(infoTable, 1, 11, obvTrend, 
               bgcolor=obvColor, 
               text_color=color.white, 
               text_size=size.small)
    
    // MFI with gradient
    mfiColor = mfi >= 80 ? color.new(#ff5252, 30) : mfi >= 50 ? color.new(#00e676, 30) : mfi >= 20 ? color.new(#ffd740, 50) : color.new(#ff5252, 50)
    table.cell(infoTable, 0, 12, "MFI", 
               bgcolor=color.new(#16213e, 30), 
               text_color=color.new(#e0e0e0, 0), 
               text_size=size.small)
    table.cell(infoTable, 1, 12, str.tostring(mfi, "#.#"), 
               bgcolor=mfiColor, 
               text_color=color.white, 
               text_size=size.small)
    
    // VWAP Deviation
    vwapDevColor = vwapDeviationPercent > 0 ? color.new(#00e676, 40) : color.new(#ff5252, 40)
    table.cell(infoTable, 0, 13, "VWAP Dev %", 
               bgcolor=color.new(#16213e, 30), 
               text_color=color.new(#e0e0e0, 0), 
               text_size=size.small)
    table.cell(infoTable, 1, 13, str.tostring(vwapDeviationPercent, "#.##") + "%", 
               bgcolor=vwapDevColor, 
               text_color=color.white, 
               text_size=size.small)
    
    // Volume Momentum
    volMomColor = volumeMomentumPercent > 0 ? color.new(#00e676, 40) : color.new(#ff5252, 40)
    table.cell(infoTable, 0, 14, "Vol Momentum", 
               bgcolor=color.new(#16213e, 30), 
               text_color=color.new(#e0e0e0, 0), 
               text_size=size.small)
    table.cell(infoTable, 1, 14, str.tostring(volumeMomentumPercent, "#.#") + "%", 
               bgcolor=volMomColor, 
               text_color=color.white, 
               text_size=size.small)

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────

// High volume alert
alertcondition(relativeVolume >= rvolThreshold and relativeVolume[1] < rvolThreshold, 
               title="High Volume Alert", 
               message="High volume detected: RVOL = {{plot(\"RVOL\")}}")

// Extreme volume alert
alertcondition(relativeVolume >= extremeRvolThreshold and relativeVolume[1] < extremeRvolThreshold, 
               title="Extreme Volume Alert", 
               message="Extreme volume detected: RVOL = {{plot(\"RVOL\")}}")

// Strong buying pressure
alertcondition(liquidityCondition == "Strong Buying" and liquidityCondition[1] != "Strong Buying", 
               title="Strong Buying Pressure", 
               message="Strong buying pressure detected")

// Strong selling pressure
alertcondition(liquidityCondition == "Strong Selling" and liquidityCondition[1] != "Strong Selling", 
               title="Strong Selling Pressure", 
               message="Strong selling pressure detected")
