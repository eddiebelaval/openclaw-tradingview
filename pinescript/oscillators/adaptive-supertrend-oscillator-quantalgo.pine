//@version=6
indicator(title = 'Adaptive SuperTrend Oscillator [QuantAlgo]', overlay = false, timeframe = '', timeframe_gaps = true)

//              ╔════════════════════════════════╗              //
//              ║      USER-DEFINED SETTINGS     ║              //
//              ╚════════════════════════════════╝              //

var string ST_Settings = '════════ SuperTrend Settings ════════'
var string Norm_Settings = '═════ Adaptive Normalization Settings ═════'
var string Appearance_Settings = '════════ Appearance Settings ════════'

tooltipPreset = 'Select a predefined configuration optimized for different trading styles and timeframes. Presets override SuperTrend and Normalization settings.\n\nDefault (Factor 3.0, ATR 10, ER 10, Norm Fast 5, Norm Slow 30): Balanced configuration for swing trading on 4H and daily charts. Moderate SuperTrend sensitivity captures meaningful trend changes while filtering minor noise.\n\nFast Response (Factor 2.0, ATR 7, ER 7, Norm Fast 3, Norm Slow 20): Aggressive configuration for intraday trading on 5min–1H charts. Tighter SuperTrend bands and shorter normalization windows react quickly to momentum shifts.\n\nSmooth Trend (Factor 4.0, ATR 14, ER 20, Norm Fast 8, Norm Slow 50): Conservative configuration for position trading on daily and weekly charts. Wide SuperTrend bands and longer normalization windows only confirm major momentum shifts.'
tooltipBandMultiplier = 'Multiplier applied to ATR to set the SuperTrend band width. Higher values push the SuperTrend further from price, reducing how often it flips and filtering out more noise. Lower values keep the SuperTrend closer to price for earlier but more frequent signals.'
tooltipBandATRLength = 'ATR lookback period used internally by SuperTrend to calculate its bands. Larger values smooth out the ATR, producing a slower-moving SuperTrend that is less reactive to short-term volatility spikes.'
tooltipERLength = 'Lookback window for the Efficiency Ratio, which measures how directionally efficient recent price movement is. This single value controls how quickly the entire normalization layer adapts between trending and ranging market regimes. Shorter = faster regime detection.'
tooltipNormATRFast = 'Normalization ATR period active during strong trending conditions, when the Efficiency Ratio is high. A shorter period tightens the normalization divisor, allowing the score to move more freely and amplify trend signals.'
tooltipNormATRSlow = 'Normalization ATR period active during choppy or ranging conditions, when the Efficiency Ratio is low. A longer period widens the normalization divisor, dampening the score and reducing false signals in low-conviction environments.'
tooltipColorPreset = 'Pre-configured color schemes for different chart themes and visual preferences. Classic uses traditional green/red. Aqua provides ocean-inspired tones. Cosmic offers futuristic cyan/purple. Cyber features warm/cool contrast. Neon delivers high-contrast yellow/magenta for maximum visibility. Custom allows full color customization using the color pickers below.'
tooltipBullish = 'Color used when the oscillator score is positive, confirming the SuperTrend is below price and the trend is bullish. Used across the ribbon, gradient, bar coloring, and OB/OS level colors.'
tooltipBearish = 'Color used when the oscillator score is negative, confirming the SuperTrend is above price and the trend is bearish. Used across the ribbon, gradient, bar coloring, and OB/OS level colors.'
tooltipNeutralZone = 'Enable a neutral zone around the zero line. Score readings within the threshold range are treated as non-directional and displayed in the neutral color, filtering out low-conviction trend readings that are not worth acting on.'
tooltipNeutralThresh = 'Defines the width of the neutral zone, applied symmetrically above and below zero. Readings between -threshold and +threshold are colored neutral. Increase this value to require stronger conviction before a bullish or bearish color is shown.'
tooltipNeutralColor = 'Color used when the score is within the neutral zone, indicating neither a confirmed bullish nor bearish condition. Neutral readings suggest the market is consolidating or lacking clear directional momentum.'
tooltipBarColor = 'When enabled, price bars are colored to match the current oscillator state — bullish, bearish, or neutral — providing instant trend confirmation without switching between chart and oscillator pane.'

//              ╔════════════════════════════════╗              //
//              ║         INPUT PARAMETERS       ║              //
//              ╚════════════════════════════════╝              //

preset_config = input.string('Default', 'Preset Configuration', options = ['Default', 'Fast Response', 'Smooth Trend'], tooltip = tooltipPreset, group = ST_Settings)
band_multiplier = input.float(3.0, 'SuperTrend Band Multiplier', minval = 0.5, maxval = 10.0, step = 0.5, tooltip = tooltipBandMultiplier, group = ST_Settings)
band_atr_length = input.int(10, 'SuperTrend ATR Length', minval = 1, maxval = 50, step = 1, tooltip = tooltipBandATRLength, group = ST_Settings)

er_length = input.int(10, 'Efficiency Ratio Length', minval = 3, maxval = 50, step = 1, tooltip = tooltipERLength, group = Norm_Settings)
norm_atr_fast = input.int(5, 'Normalization ATR Fast Period', minval = 2, maxval = 20, step = 1, tooltip = tooltipNormATRFast, group = Norm_Settings)
norm_atr_slow = input.int(30, 'Normalization ATR Slow Period', minval = 10, maxval = 100, step = 5, tooltip = tooltipNormATRSlow, group = Norm_Settings)

color_preset = input.string('Custom', 'Color Preset', options = ['Classic', 'Aqua', 'Cosmic', 'Cyber', 'Neon', 'Custom'], tooltip = tooltipColorPreset, group = Appearance_Settings)
bullish_input = input.color(#00ffaa, 'Bullish Color', tooltip = tooltipBullish, group = Appearance_Settings)
bearish_input = input.color(#ff0000, 'Bearish Color', tooltip = tooltipBearish, group = Appearance_Settings)
enable_neutral = input.bool(true, 'Enable Neutral Zone', tooltip = tooltipNeutralZone, group = Appearance_Settings)
neutral_threshold = input.float(25.0, 'Neutral Zone Threshold', step = 5.0, minval = 0.0, tooltip = tooltipNeutralThresh, group = Appearance_Settings)
neutral_color = input.color(#787b86, 'Neutral Zone Color', tooltip = tooltipNeutralColor, group = Appearance_Settings)
enable_barcolor = input.bool(true, 'Enable Bar Coloring', tooltip = tooltipBarColor, group = Appearance_Settings)

//              ╔════════════════════════════════╗              //
//              ║       PRESET CONFIGURATION     ║              //
//              ╚════════════════════════════════╝              //

active_multiplier = preset_config == 'Fast Response' ? 2.0 : preset_config == 'Smooth Trend' ? 4.0 : band_multiplier
active_atr_length = preset_config == 'Fast Response' ? 7 : preset_config == 'Smooth Trend' ? 14 : band_atr_length
active_er_length = preset_config == 'Fast Response' ? 7 : preset_config == 'Smooth Trend' ? 20 : er_length
active_norm_fast = preset_config == 'Fast Response' ? 3 : preset_config == 'Smooth Trend' ? 8 : norm_atr_fast
active_norm_slow = preset_config == 'Fast Response' ? 20 : preset_config == 'Smooth Trend' ? 50 : norm_atr_slow

//              ╔════════════════════════════════╗              //
//              ║          COLOR PRESETS         ║              //
//              ╚════════════════════════════════╝              //

[bullish_color, bearish_color] = switch color_preset
    'Classic' => [#00ff00, #ff0000]
    'Aqua' => [#00d4ff, #ff8c00]
    'Cosmic' => [#49ffce, #9932cc]
    'Cyber' => [#00cccc, #ff6600]
    'Neon' => [#ffff00, #ff00ff]
    => [bullish_input, bearish_input]

//              ╔════════════════════════════════╗              //
//              ║        CORE CALCULATION        ║              //
//              ╚════════════════════════════════╝              //

[supertrend_line, _] = ta.supertrend(active_multiplier, active_atr_length)
price_distance = close - supertrend_line

price_change = math.abs(close - close[active_er_length])
path_length = math.sum(math.abs(close - close[1]), active_er_length)
efficiency_ratio = path_length != 0 ? price_change / path_length : 0.0

adaptive_atr = efficiency_ratio * ta.atr(active_norm_fast) + (1.0 - efficiency_ratio) * ta.atr(active_norm_slow)
score = adaptive_atr != 0 ? price_distance / adaptive_atr * 100 : 0.0

//              ╔════════════════════════════════╗              //
//              ║        TREND DETECTION         ║              //
//              ╚════════════════════════════════╝              //

score_deviation = ta.stdev(score, 100)
ob_extreme = score_deviation * 3
ob_level = score_deviation * 2
os_level = -score_deviation * 2
os_extreme = -score_deviation * 3

is_neutral = enable_neutral and math.abs(score) <= neutral_threshold
is_bullish = not is_neutral and score > 0

trend_turned_bullish = is_bullish and not is_bullish[1]
trend_turned_bearish = not is_neutral and not is_bullish and (is_bullish[1] or is_neutral[1])
trend_turned_neutral = is_neutral and not is_neutral[1]

//              ╔════════════════════════════════╗              //
//              ║          VISUALIZATION         ║              //
//              ╚════════════════════════════════╝              //

uptrend_color = color.from_gradient(score, 0, ob_extreme, color.new(bullish_color, 40), bullish_color)
downtrend_color = color.from_gradient(score, os_extreme, 0, bearish_color, color.new(bearish_color, 40))
final_color = is_neutral ? neutral_color : is_bullish ? uptrend_color : downtrend_color

plot_score = plot(score, 'Adaptive SuperTrend Score', color = color.new(final_color, 0), linewidth = 2)
plot_inner = plot(score * 0.6, 'Score Ribbon Inner', color = color.new(final_color, 100), display = display.none)
plot_outer = plot(score * 0.3, 'Score Ribbon Outer', color = color.new(final_color, 100), display = display.none)
plot_zero = plot(0, 'Zero Line', color = color.new(color.gray, 50))

fill(plot_score, plot_inner, color.new(final_color, 55), title = 'Score Ribbon Fill 1')
fill(plot_inner, plot_outer, color.new(final_color, 72), title = 'Score Ribbon Fill 2')
fill(plot_outer, plot_zero, color.new(final_color, 93), title = 'Score Ribbon Fill 3')

plot(ob_extreme, 'Extreme Overbought (3σ)', downtrend_color)
plot(os_extreme, 'Extreme Oversold (3σ)', uptrend_color)
plot(ob_level, 'Overbought (2σ)', downtrend_color)
plot(os_level, 'Oversold (2σ)', uptrend_color)

barcolor(enable_barcolor ? (is_neutral ? neutral_color : is_bullish ? bullish_color : bearish_color) : na, title = 'Trend Bar Color')

//              ╔════════════════════════════════╗              //
//              ║             ALERTS             ║              //
//              ╚════════════════════════════════╝              //

alertcondition(trend_turned_bullish, title = 'Bullish Trend Signal', message = 'Adaptive SuperTrend Oscillator: BULLISH trend confirmed on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(trend_turned_bearish, title = 'Bearish Trend Signal', message = 'Adaptive SuperTrend Oscillator: BEARISH trend confirmed on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(trend_turned_neutral, title = 'Trend Turned Neutral', message = 'Adaptive SuperTrend Oscillator: Trend turned NEUTRAL on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(score >= ob_level, title = 'Overbought Level Reached', message = 'Adaptive SuperTrend Oscillator: Score reached OVERBOUGHT (2σ) on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(score <= os_level, title = 'Oversold Level Reached', message = 'Adaptive SuperTrend Oscillator: Score reached OVERSOLD (2σ) on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(score >= ob_extreme, title = 'Extreme Overbought Level Reached', message = 'Adaptive SuperTrend Oscillator: Score reached EXTREME OVERBOUGHT (3σ) on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(score <= os_extreme, title = 'Extreme Oversold Level Reached', message = 'Adaptive SuperTrend Oscillator: Score reached EXTREME OVERSOLD (3σ) on {{exchange}}:{{ticker}} - {{interval}}')

