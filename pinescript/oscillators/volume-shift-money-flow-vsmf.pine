//@version=5
indicator("Volume Shift Money Flow (VSMF)", overlay=false)

// Inputs
length = input.int(14, title="Volume Average Length")
smooth = input.int(10, title="Smoothing Length")

// Typical Price
tp = (high + low + close) / 3

// Volume Shift Factor
avgVol = ta.sma(volume, length)
volShift = volume / avgVol

// VSMF Formula
vsmf = (tp - tp[1]) * volShift

// Smoothed Indicator
vsmf_ma = ta.sma(vsmf, smooth)

// Plot
plot(vsmf_ma, title="VSMF", linewidth=2)
hline(1, title="Zero Line")
