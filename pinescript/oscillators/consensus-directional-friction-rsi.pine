//@version=6
indicator("RSI Directional Friction Oscillator (Consensus Engine)", overlay=false, max_bars_back=4000, max_lines_count=500)

// =========================================================================
// GLOBAL SETTINGS
// =========================================================================
grp_global = "Global Settings"
src        = input.source(close, title="Source", group=grp_global)
lookback   = input.time(timestamp("21 Mar 2024 00:00 -0400"), title="Maximum Lookback", group=grp_global)

grp_anomaly = "Liquidity Anomaly Triggers (The Anchor)"
vol_length      = input.int(50, "Volume Baseline Length", minval=10, group=grp_anomaly)
vol_z_threshold = input.float(2.5, "Anomaly Z-Score Threshold", step=0.1, group=grp_anomaly)
max_anchors     = input.int(24, "Max Cluster Anchors", minval=1, maxval=24, group=grp_anomaly)
anchor_cooldown = input.int(5, "Anchor Cooldown (Bars)", minval=1, group=grp_anomaly)

grp_osc = "Oscillator Visuals & Scaling"
hist_scale   = input.float(1.0, "Histogram Scale Factor", step=0.1, minval=0.1, group=grp_osc, tooltip="Visually scales the engine histogram vertically.")
color_smooth = input.int(1, "Color Smoothing (Bars)", minval=1, maxval=10, group=grp_osc, tooltip="Smooths the expansion/contraction detection for the momentum heatmap.")
streak_window= input.int(14, "Streak Lookback Window", minval=1, group=grp_osc, tooltip="How many bars can pass between consensus events before the streak count resets.")

// =========================================================================
// ANOMALY DETECTION LOGIC
// =========================================================================
bool is_within_lookback = time >= lookback

// Calculate Volume Z-Score to identify institutional "Liquidity Events"
float vol_sma = ta.sma(volume, vol_length)
float vol_sd  = ta.stdev(volume, vol_length)
float vol_z   = vol_sd > 0 ? (volume - vol_sma) / vol_sd : 0

var int bars_since_last_anchor = anchor_cooldown
bars_since_last_anchor += 1

// Trigger Condition: Volume exceeds Z-score threshold
bool is_anomaly = (vol_z >= vol_z_threshold) and is_within_lookback and (bars_since_last_anchor >= anchor_cooldown)

// =========================================================================
// DYNAMIC RSI CLUSTER ARRAYS (Cumulative Cutler's RSI)
// =========================================================================
var float[] sum_gain_arr = array.new_float(0)
var float[] sum_loss_arr = array.new_float(0)
var int[]   count_arr    = array.new_int(0)

if is_anomaly
    bars_since_last_anchor := 0
    // Unshift adds the new anchor to the beginning of the arrays
    array.unshift(sum_gain_arr, 0.0)
    array.unshift(sum_loss_arr, 0.0)
    array.unshift(count_arr, 0)
    
    // Enforce max cluster size
    if array.size(sum_gain_arr) > max_anchors
        array.pop(sum_gain_arr)
        array.pop(sum_loss_arr)
        array.pop(count_arr)

// Calculate Current Bar Gains/Losses
float chg = ta.change(src)
float current_gain = math.max(chg, 0)
float current_loss = math.max(-chg, 0)

var float[] active_rsis = array.new_float(0)
array.clear(active_rsis)

int current_cluster_size = array.size(sum_gain_arr)
if current_cluster_size > 0
    for i = 0 to current_cluster_size - 1
        // Update cumulative sums for each active anchor
        float g_sum = array.get(sum_gain_arr, i) + current_gain
        float l_sum = array.get(sum_loss_arr, i) + current_loss
        int   cnt   = array.get(count_arr, i) + 1
        
        array.set(sum_gain_arr, i, g_sum)
        array.set(sum_loss_arr, i, l_sum)
        array.set(count_arr, i, cnt)
        
        // Calculate Expanding RSI
        float rsi_val = 50.0 // Default to equilibrium
        if cnt > 0
            if l_sum == 0
                rsi_val := 100.0
            else if g_sum == 0
                rsi_val := 0.0
            else
                float rs = g_sum / l_sum
                rsi_val := 100.0 - (100.0 / (1.0 + rs))
                
        array.push(active_rsis, rsi_val)

// =========================================================================
// VARIABLE EXTRACTION FOR RIBBON PLOTTING
// =========================================================================
int sz = array.size(active_rsis)
float r1  = sz > 0  ? array.get(active_rsis, 0)  : na, float r2  = sz > 1  ? array.get(active_rsis, 1)  : na
float r3  = sz > 2  ? array.get(active_rsis, 2)  : na, float r4  = sz > 3  ? array.get(active_rsis, 3)  : na
float r5  = sz > 4  ? array.get(active_rsis, 4)  : na, float r6  = sz > 5  ? array.get(active_rsis, 5)  : na
float r7  = sz > 6  ? array.get(active_rsis, 6)  : na, float r8  = sz > 7  ? array.get(active_rsis, 7)  : na
float r9  = sz > 8  ? array.get(active_rsis, 8)  : na, float r10 = sz > 9  ? array.get(active_rsis, 9)  : na
float r11 = sz > 10 ? array.get(active_rsis, 10) : na, float r12 = sz > 11 ? array.get(active_rsis, 11) : na
float r13 = sz > 12 ? array.get(active_rsis, 12) : na, float r14 = sz > 13 ? array.get(active_rsis, 13) : na
float r15 = sz > 14 ? array.get(active_rsis, 14) : na, float r16 = sz > 15 ? array.get(active_rsis, 15) : na
float r17 = sz > 16 ? array.get(active_rsis, 16) : na, float r18 = sz > 17 ? array.get(active_rsis, 17) : na
float r19 = sz > 18 ? array.get(active_rsis, 18) : na, float r20 = sz > 19 ? array.get(active_rsis, 19) : na
float r21 = sz > 20 ? array.get(active_rsis, 20) : na, float r22 = sz > 21 ? array.get(active_rsis, 21) : na
float r23 = sz > 22 ? array.get(active_rsis, 22) : na, float r24 = sz > 23 ? array.get(active_rsis, 23) : na

// =========================================================================
// THE CORE & THE ENGINE (Meta-Mean & Scaling)
// =========================================================================
// Core: Consensus Equilibrium (Meta-Mean)
float meta_mean = sz > 0 ? array.avg(active_rsis) : na

// Engine Distance: Deviation of Meta-Mean from 50 Equilibrium
float engine_dev = meta_mean - 50.0

// Scaled Engine: Allows user to visually stretch the histogram
float scaled_engine = 50.0 + (engine_dev * hist_scale)

// =========================================================================
// MAGNITUDE & MOMENTUM HEATMAP (Size = Heat/Cold, Slope = Light/Dark)
// =========================================================================
// Clamped to 0-100 exclusively for the color gradient math
float clamped_engine = math.max(0.0, math.min(100.0, scaled_engine))

color consensus_color = na
if scaled_engine >= 50
    // Positive Magnitude: 50 -> 100 transitions from Green to Blue
    consensus_color := color.from_gradient(clamped_engine, 50, 100, color.lime, color.blue)
else
    // Negative Magnitude: 50 -> 0 transitions from Yellow to Red (0 is Red, 50 is Yellow)
    consensus_color := color.from_gradient(clamped_engine, 0, 50, color.red, color.yellow)

// Apply transparency to the cloud fill (Magnitude only)
color cloud_fill_color = color.new(consensus_color, 85) 

// Momentum Heatmap (Lower base brightness, higher expansion threshold)
bool is_expanding_up = scaled_engine >= 50 and ta.rising(scaled_engine, color_smooth)
bool is_expanding_dn = scaled_engine <  50 and ta.falling(scaled_engine, color_smooth)

f_apply_momentum(color base_c, bool expanding) =>
    // Harder to become lighter: 15% transparency for bright, 85% for dark baseline
    expanding ? color.new(base_c, 15) : color.new(base_c, 85)

color hist_color = na
if scaled_engine >= 50
    hist_color := f_apply_momentum(consensus_color, is_expanding_up)
else
    hist_color := f_apply_momentum(consensus_color, is_expanding_dn)

// =========================================================================
// FULL CONSENSUS STREAK & BACKGROUND SIGNALS
// =========================================================================
float max_rsi = sz > 0 ? array.max(active_rsis) : na
float min_rsi = sz > 0 ? array.min(active_rsis) : na

bool all_below_50 = sz > 0 and max_rsi < 50
bool all_above_50 = sz > 0 and min_rsi > 50

// Persistent Streak Accumulator
var int bg_streak_count = 0
var int last_consensus_bar = -100

if all_below_50 or all_above_50
    if bar_index - last_consensus_bar <= streak_window
        bg_streak_count += 1
    else
        bg_streak_count := 1
    last_consensus_bar := bar_index
else
    if bar_index - last_consensus_bar > streak_window
        bg_streak_count := 0

// Reversed intensity logic: Maximum brightness on Ignition (Bar 1), dimming over 50 bars
float intensity_ratio = math.min(bg_streak_count, 50) / 50.0
int dynamic_transp = int(70 + (intensity_ratio * 25))

// Apply Background Signal: Lime for Bullish Potential (All Below), Red for Bearish Potential (All Above)
bgcolor(all_below_50 ? color.new(color.lime, dynamic_transp) : all_above_50 ? color.new(color.red, dynamic_transp) : na, title="Institutional Consensus Ignition")

// =========================================================================
// RENDERING (Z-ORDERED: Back to Front -> Cloud, Histogram, Ribbons)
// =========================================================================
// RSI Boundaries
hline(70, "Overbought", color=color.new(color.gray, 60), linestyle=hline.style_dashed)
hline(50, "Equilibrium (50 Line)", color=color.new(color.white, 60), linestyle=hline.style_solid, linewidth=1)
hline(30, "Oversold", color=color.new(color.gray, 60), linestyle=hline.style_dashed)

// 1. Plot the Consensus Cloud Fill (Back Layer)
p_max = plot(max_rsi, "Max RSI Cloud Boundary", color=color.new(color.white, 100))
p_min = plot(min_rsi, "Min RSI Cloud Boundary", color=color.new(color.white, 100))
fill(p_max, p_min, color=cloud_fill_color, title="Consensus Cloud Heatmap")

// 2. Plot the Scaled Engine (Histogram - Middle Layer)
plot(scaled_engine, "Engine Histogram", color=hist_color, style=plot.style_columns, histbase=50)

// 3. Plot the Layered Ribbon Channels (Front Layer, 24 Lines)
int line_transp = 50 
color c1  = sz > 0  ? color.new(#F48FB1, line_transp) : na 
color c2  = sz > 1  ? color.new(#EF5350, line_transp) : na
color c3  = sz > 2  ? color.new(#E53935, line_transp) : na
color c4  = sz > 3  ? color.new(#FFCC80, line_transp) : na 
color c5  = sz > 4  ? color.new(#FFB74D, line_transp) : na
color c6  = sz > 5  ? color.new(#FF9800, line_transp) : na
color c7  = sz > 6  ? color.new(#FFF59D, line_transp) : na 
color c8  = sz > 7  ? color.new(#FFF176, line_transp) : na
color c9  = sz > 8  ? color.new(#FFEB3B, line_transp) : na
color c10 = sz > 9  ? color.new(#A5D6A7, line_transp) : na 
color c11 = sz > 10 ? color.new(#81C784, line_transp) : na
color c12 = sz > 11 ? color.new(#66BB6A, line_transp) : na
color c13 = sz > 12 ? color.new(#80CBC4, line_transp) : na 
color c14 = sz > 13 ? color.new(#4DB6AC, line_transp) : na
color c15 = sz > 14 ? color.new(#26A69A, line_transp) : na
color c16 = sz > 15 ? color.new(#81D4FA, line_transp) : na 
color c17 = sz > 16 ? color.new(#4FC3F7, line_transp) : na
color c18 = sz > 17 ? color.new(#29B6F6, line_transp) : na
color c19 = sz > 18 ? color.new(#90CAF9, line_transp) : na 
color c20 = sz > 19 ? color.new(#64B5F6, line_transp) : na
color c21 = sz > 20 ? color.new(#42A5F5, line_transp) : na
color c22 = sz > 21 ? color.new(#B39DDB, line_transp) : na 
color c23 = sz > 22 ? color.new(#9575CD, line_transp) : na
color c24 = sz > 23 ? color.new(#7E57C2, line_transp) : na

plot(r24, "RSI 24", color=c24, linewidth=1), plot(r23, "RSI 23", color=c23, linewidth=1), plot(r22, "RSI 22", color=c22, linewidth=1), plot(r21, "RSI 21", color=c21, linewidth=1)
plot(r20, "RSI 20", color=c20, linewidth=1), plot(r19, "RSI 19", color=c19, linewidth=1), plot(r18, "RSI 18", color=c18, linewidth=1), plot(r17, "RSI 17", color=c17, linewidth=1)
plot(r16, "RSI 16", color=c16, linewidth=1), plot(r15, "RSI 15", color=c15, linewidth=1), plot(r14, "RSI 14", color=c14, linewidth=1), plot(r13, "RSI 13", color=c13, linewidth=1)
plot(r12, "RSI 12", color=c12, linewidth=1), plot(r11, "RSI 11", color=c11, linewidth=1), plot(r10, "RSI 10", color=c10, linewidth=1), plot(r9,  "RSI 9",  color=c9,  linewidth=1)
plot(r8,  "RSI 8",  color=c8,  linewidth=1), plot(r7,  "RSI 7",  color=c7,  linewidth=1), plot(r6,  "RSI 6",  color=c6,  linewidth=1), plot(r5,  "RSI 5",  color=c5,  linewidth=1)
plot(r4,  "RSI 4",  color=c4,  linewidth=1), plot(r3,  "RSI 3",  color=c3,  linewidth=1), plot(r2,  "RSI 2",  color=c2,  linewidth=1), plot(r1,  "RSI 1",  color=c1,  linewidth=1)

// 4. Mark Anomaly Triggers
color trigger_color = is_anomaly ? (close >= open ? color.blue : color.yellow) : na
plotchar(is_anomaly ? 50 : na, "Liquidity Event Trigger", char="▲", location=location.absolute, color=trigger_color, size=size.tiny)
