//@version=5
indicator("Smart Pivot Reversals [identityKa]", overlay=true, max_labels_count=500)

// ==========================================
// 1. USER INPUTS (GLOBAL ENGLISH)
// ==========================================
grp1 = "⚙️ Pivot Engine Settings"
left_bars = input.int(5, title="Left Bars (Sensitivity)", minval=1, group=grp1, tooltip="Lower number = catches more minor tops/bottoms. Higher number = only major swings.")
right_bars = input.int(3, title="Right Bars (Confirmation)", minval=1, group=grp1, tooltip="Bars required to confirm the pivot. 3 is highly recommended for minimal lag.")

grp2 = "⚡ Smart Filters (Optional)"
use_ema = input.bool(false, title="Macro Trend Filter (EMA)", group=grp2, tooltip="If checked, only prints BOTTOMs in an uptrend (above EMA) and TOPs in a downtrend (below EMA).")
ema_len = input.int(200, title="EMA Length", group=grp2)

use_rsi = input.bool(false, title="Strict Mode: Require RSI Extremes?", group=grp2, tooltip="If checked, only prints TOP/BOTTOM when RSI is also Overbought/Oversold.")
rsi_len = input.int(14, title="RSI Length", group=grp2)
rsi_ob = input.int(70, title="RSI Overbought", group=grp2)
rsi_os = input.int(30, title="RSI Oversold", group=grp2)

grp3 = "🎨 Theme & Colors"
col_buy = input.color(#00ffbb, title="Bottom Signal (Green)", group=grp3)
col_sell = input.color(#ff1744, title="Top Signal (Red)", group=grp3)

grp4 = "📊 HUD Dashboard Settings"
show_dash = input.bool(true, "Show Dashboard", group=grp4)
dash_pos = input.string("Bottom Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], group=grp4)
dash_size = input.string("Small", "Dashboard Text Size", options=["Tiny", "Small", "Normal", "Large"], group=grp4)

// ==========================================
// 2. SMART PIVOT ENGINE
// ==========================================
// Raw Price Action Pivots (Catches every micro/macro swing perfectly)
ph = ta.pivothigh(high, left_bars, right_bars)
pl = ta.pivotlow(low, left_bars, right_bars)

// Filters Calculations
rsi = ta.rsi(close, rsi_len)
ema = ta.ema(close, ema_len)

// Align filters with the confirmation bar (offset by right_bars)
rsi_val = rsi[right_bars]
ema_val = ema[right_bars]
close_val = close[right_bars]

// Final Validation (Without broken alternating logic)
valid_ph = not na(ph) and (not use_rsi or rsi_val >= rsi_ob) and (not use_ema or close_val < ema_val)
valid_pl = not na(pl) and (not use_rsi or rsi_val <= rsi_os) and (not use_ema or close_val > ema_val)

// ==========================================
// 3. VISUALIZATION
// ==========================================
// Print exactly on the pivot candle using negative offset
plotshape(valid_ph, title="Market Top", text="TOP", style=shape.labeldown, location=location.abovebar, color=col_sell, textcolor=color.white, size=size.small, offset=-right_bars)
plotshape(valid_pl, title="Market Bottom", text="BOTTOM", style=shape.labelup, location=location.belowbar, color=col_buy, textcolor=color.black, size=size.small, offset=-right_bars)

// Draw EMA if filter is active
plot(use_ema ? ema : na, title="Macro Trend EMA", color=color.new(color.white, 50), linewidth=2)

// ==========================================
// 4. HUD DASHBOARD & AI SUGGESTION
// ==========================================
var string p_pos = dash_pos == "Top Right" ? position.top_right : dash_pos == "Top Left" ? position.top_left : dash_pos == "Bottom Right" ? position.bottom_right : dash_pos == "Bottom Left" ? position.bottom_left : dash_pos == "Middle Right" ? position.middle_right : position.middle_left
var string p_size = dash_size == "Tiny" ? size.tiny : dash_size == "Small" ? size.small : dash_size == "Normal" ? size.normal : size.large

var table hud = table.new(p_pos, 2, 3, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 80))

// Smart State Tracking
var string current_state = "NEUTRAL"
if valid_pl
    current_state := "BOTTOM FOUND"
else if valid_ph
    current_state := "TOP FOUND"

string ai_suggestion = current_state == "BOTTOM FOUND" ? "LONG" : current_state == "TOP FOUND" ? "SHORT" : "Dangerous"
color ai_color = ai_suggestion == "LONG" ? col_buy : ai_suggestion == "SHORT" ? col_sell : color.new(#ff9800, 0)

if barstate.islast and show_dash
    table.cell(hud, 0, 0, "ENGINE MODE", text_color=color.gray, text_size=p_size)
    table.cell(hud, 1, 0, "SMART PIVOT", text_color=color.yellow, text_size=p_size)
    
    table.cell(hud, 0, 1, "LAST STRUCTURE", text_color=color.gray, text_size=p_size)
    table.cell(hud, 1, 1, current_state, text_color=current_state == "BOTTOM FOUND" ? col_buy : current_state == "TOP FOUND" ? col_sell : color.white, text_size=p_size)
    
    table.cell(hud, 0, 2, "AI SUGGESTION", text_color=color.gray, text_size=p_size)
    table.cell(hud, 1, 2, ai_suggestion, text_color=ai_color, text_size=p_size)

// ==========================================
// 5. ALERTS
// ==========================================
alertcondition(valid_pl, "🟢 Smart Bottom Entry", "identityKa: Market Bottom Confirmed!")
alertcondition(valid_ph, "🔴 Smart Top Entry", "identityKa: Market Top Confirmed!")
