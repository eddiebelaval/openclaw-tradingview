//@version=6
indicator("Unified 4-Indicator Buy/Sell System (Inverted Logic)", overlay=true)

// -----------------------------
// 1️⃣ HMA Breakout Intraday Trend Filter
// -----------------------------
hma1 = 20
hma2 = 50
hma3 = 100

ma1 = ta.hma(close, hma1)
ma2 = ta.hma(close, hma2)
ma3 = ta.hma(close, hma3)

var bool isGreenTrend = false
var bool isRedTrend = false
l_col = color.gray

if ma3 < ma2 and ma3 < ma1 and ma1 > ma2
    isGreenTrend := true
    isRedTrend := false
    l_col := color.rgb(7, 249, 15)   // green
else if ma3 > ma2 and ma3 > ma1 and ma2 > ma1
    isRedTrend := true
    isGreenTrend := false
    l_col := color.rgb(247, 8, 8)    // red
else
    isGreenTrend := false
    isRedTrend := false
    l_col := color.gray

plot(ma3, color=l_col, linewidth=2)

// -----------------------------
// 2️⃣ PMO (10,10,6)
// -----------------------------
import TradingView/ta/11 as TVta

[pmo, signalLine] = TVta.pmo(close, 10, 10, 6)
plot(pmo, "PMO", color=color.blue)
plot(signalLine, "PMO Signal", color=#ff6d00)
hline(0)

// -----------------------------
// 3️⃣ 60-Point Signal (50, 1.1, 62)
// -----------------------------
len_60 = 50
mult_60 = 1.1
threshold_60 = 62.0

ma_60 = ta.sma(close, len_60)
atr_60 = ta.atr(200)
rangeATR = atr_60 * mult_60

bigMoveUp = (close - open) / rangeATR * 100 >= threshold_60
bigMoveDn = (open - close) / rangeATR * 100 >= threshold_60

// -----------------------------
// 4️⃣ Volume Filter
// -----------------------------
volUp = volume > volume[1]

// -----------------------------
// 5️⃣ Inverted Trade Logic
// -----------------------------
longCondition  = barstate.isconfirmed and isRedTrend and pmo < 0 and bigMoveUp and volUp
shortCondition = barstate.isconfirmed and isGreenTrend and pmo > 0 and bigMoveDn and volUp

// -----------------------------
// 6️⃣ Plot Signals
// -----------------------------
plotshape(longCondition, style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="BUY")
plotshape(shortCondition, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL")

// -----------------------------
// 7️⃣ Alerts
// -----------------------------
alertcondition(longCondition, "Long Alert", "Inverted Long Setup Triggered")
alertcondition(shortCondition, "Short Alert", "Inverted Short Setup Triggered")
