//@version=6
indicator("SMI Cycle Average Move & Duration", shorttitle="SMI Cycle Stats", overlay=false, max_labels_count=500)

//──────────────────────────────────────────────
// INPUTS
//──────────────────────────────────────────────
a         = input.int(9, "Percent K Length", minval=1)
b         = input.int(5, "Percent D Length", minval=1)
obLevel   = input.float(40, "Overbought Level")
osLevel   = input.float(-40, "Oversold Level")
showMarks = input.bool(true, "Show Confirmed Peak/Trough Markers On Price Chart")
showTable = input.bool(true, "Show Statistics Table On Price Chart")
lookbackN = input.int(10, "Cycles Used In Average", minval=1)

//──────────────────────────────────────────────
// SMI CALCULATION
//──────────────────────────────────────────────
ll      = ta.lowest(low, a)
hh      = ta.highest(high, a)
diff    = hh - ll
rdiff   = close - (hh + ll) / 2.0

avgrel  = ta.ema(ta.ema(rdiff, b), b)
avgdiff = ta.ema(ta.ema(diff, b), b)

SMI       = avgdiff != 0 ? (avgrel / (avgdiff / 2.0) * 100.0) : 0.0
SMIsignal = ta.ema(SMI, b)

//──────────────────────────────────────────────
// SMI PANE PLOTS
//──────────────────────────────────────────────
plot(SMI, title="SMI", linewidth=2)
plot(SMIsignal, color=color.red, title="SMI Signal")
plot(obLevel, color=color.red, title="Overbought")
plot(osLevel, color=color.green, title="Oversold")
plot(0, color=color.blue, title="Zero Line")

//──────────────────────────────────────────────
// STATE
//──────────────────────────────────────────────
inOversold   = SMI < osLevel
inOverbought = SMI > obLevel

var float osCandidateSMI   = na
var float osCandidatePrice = na
var int   osCandidateBar   = na

var float obCandidateSMI   = na
var float obCandidatePrice = na
var int   obCandidateBar   = na

var string lastExtremeType  = ""
var float  lastExtremePrice = na
var int    lastExtremeBar   = na

var int upCount   = 0
var int downCount = 0

var upPointsArr    = array.new_float()
var upPercentArr   = array.new_float()
var upBarsArr      = array.new_float()

var downPointsArr  = array.new_float()
var downPercentArr = array.new_float()
var downBarsArr    = array.new_float()

//──────────────────────────────────────────────
// HELPERS
//──────────────────────────────────────────────
f_push_trim(arr, val, maxSize) =>
    array.push(arr, val)
    if array.size(arr) > maxSize
        array.shift(arr)

f_avg(arr) =>
    float result = na
    int sz = array.size(arr)
    if sz > 0
        float sum = 0.0
        for i = 0 to sz - 1
            sum += array.get(arr, i)
        result := sum / sz
    result

f_pct_of_avg(currentVal, avgVal) =>
    not na(currentVal) and not na(avgVal) and avgVal != 0 ? (currentVal / avgVal) * 100.0 : na

f_move_text(pointsVal, percentVal) =>
    na(pointsVal) or na(percentVal) ? "n/a" : str.tostring(pointsVal, format.mintick) + " pts / " + str.tostring(percentVal, "#.##") + "%"

//──────────────────────────────────────────────
// TRACK LOWEST SMI IN OVERSOLD / HIGHEST SMI IN OVERBOUGHT
//──────────────────────────────────────────────
if inOversold
    if na(osCandidateSMI) or SMI < osCandidateSMI
        osCandidateSMI   := SMI
        osCandidatePrice := close
        osCandidateBar   := bar_index

if inOverbought
    if na(obCandidateSMI) or SMI > obCandidateSMI
        obCandidateSMI   := SMI
        obCandidatePrice := close
        obCandidateBar   := bar_index

exitOversold   = not inOversold and inOversold[1]
exitOverbought = not inOverbought and inOverbought[1]

//──────────────────────────────────────────────
// CONFIRM EXTREMES AND STORE CYCLE MOVES
//──────────────────────────────────────────────
if exitOversold and not na(osCandidatePrice)
    float troughPrice = osCandidatePrice
    int   troughBar   = osCandidateBar

    if lastExtremeType == "peak" and not na(lastExtremePrice) and not na(lastExtremeBar)
        float downMovePts  = troughPrice - lastExtremePrice
        float downMovePct  = lastExtremePrice != 0 ? (troughPrice / lastExtremePrice - 1.0) * 100.0 : na
        float downMoveBars = troughBar - lastExtremeBar

        downCount += 1
        f_push_trim(downPointsArr, downMovePts, lookbackN)
        f_push_trim(downPercentArr, downMovePct, lookbackN)
        f_push_trim(downBarsArr, downMoveBars, lookbackN)

    lastExtremeType  := "trough"
    lastExtremePrice := troughPrice
    lastExtremeBar   := troughBar

    if showMarks
        label.new(
             x=troughBar,
             y=troughPrice,
             text="T",
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=label.style_label_up,
             color=color.lime,
             textcolor=color.black,
             size=size.small,
             force_overlay=true)

    osCandidateSMI   := na
    osCandidatePrice := na
    osCandidateBar   := na

if exitOverbought and not na(obCandidatePrice)
    float peakPrice = obCandidatePrice
    int   peakBar   = obCandidateBar

    if lastExtremeType == "trough" and not na(lastExtremePrice) and not na(lastExtremeBar)
        float upMovePts  = peakPrice - lastExtremePrice
        float upMovePct  = lastExtremePrice != 0 ? (peakPrice / lastExtremePrice - 1.0) * 100.0 : na
        float upMoveBars = peakBar - lastExtremeBar

        upCount += 1
        f_push_trim(upPointsArr, upMovePts, lookbackN)
        f_push_trim(upPercentArr, upMovePct, lookbackN)
        f_push_trim(upBarsArr, upMoveBars, lookbackN)

    lastExtremeType  := "peak"
    lastExtremePrice := peakPrice
    lastExtremeBar   := peakBar

    if showMarks
        label.new(
             x=peakBar,
             y=peakPrice,
             text="P",
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=label.style_label_down,
             color=color.red,
             textcolor=color.white,
             size=size.small,
             force_overlay=true)

    obCandidateSMI   := na
    obCandidatePrice := na
    obCandidateBar   := na

//──────────────────────────────────────────────
// LAST-N AVERAGES
//──────────────────────────────────────────────
avgUpPoints    = f_avg(upPointsArr)
avgUpPercent   = f_avg(upPercentArr)
avgUpBars      = f_avg(upBarsArr)

avgDownPoints  = f_avg(downPointsArr)
avgDownPercent = f_avg(downPercentArr)
avgDownBars    = f_avg(downBarsArr)

avgAbsDownPoints  = na(avgDownPoints) ? na : math.abs(avgDownPoints)
avgAbsDownPercent = na(avgDownPercent) ? na : math.abs(avgDownPercent)

recentUpCount   = array.size(upPointsArr)
recentDownCount = array.size(downPointsArr)

//──────────────────────────────────────────────
// LIVE CURRENT-CYCLE PROGRESS
//──────────────────────────────────────────────
bool inCurrentUpCycle   = lastExtremeType == "trough" and not na(lastExtremePrice) and not na(lastExtremeBar)
bool inCurrentDownCycle = lastExtremeType == "peak"   and not na(lastExtremePrice) and not na(lastExtremeBar)

currentCycleDirection = inCurrentUpCycle ? "Up cycle: trough to now" : inCurrentDownCycle ? "Down cycle: peak to now" : "n/a"

currentMovePoints  = inCurrentUpCycle or inCurrentDownCycle ? (close - lastExtremePrice) : na
currentMovePercent = inCurrentUpCycle or inCurrentDownCycle ? (lastExtremePrice != 0 ? (close / lastExtremePrice - 1.0) * 100.0 : na) : na
currentBarsElapsed = inCurrentUpCycle or inCurrentDownCycle ? (bar_index - lastExtremeBar) : na

comparisonAvgPoints = inCurrentUpCycle ? avgUpPoints : inCurrentDownCycle ? avgAbsDownPoints : na
comparisonAvgPct    = inCurrentUpCycle ? avgUpPercent : inCurrentDownCycle ? avgAbsDownPercent : na
comparisonAvgBars   = inCurrentUpCycle ? avgUpBars : inCurrentDownCycle ? avgDownBars : na

currentMovePointsMagnitude  = not na(currentMovePoints) ? math.abs(currentMovePoints) : na
currentMovePercentMagnitude = not na(currentMovePercent) ? math.abs(currentMovePercent) : na

pctOfAvgMovePct = f_pct_of_avg(currentMovePercentMagnitude, comparisonAvgPct)
pctOfAvgBars    = f_pct_of_avg(currentBarsElapsed, comparisonAvgBars)

moveExtended = not na(pctOfAvgMovePct) and pctOfAvgMovePct >= 100
timeExtended = not na(pctOfAvgBars) and pctOfAvgBars >= 100

statusText = na(pctOfAvgMovePct) or na(pctOfAvgBars) ? "n/a" :
     moveExtended and timeExtended ? "Price move and time both above average" :
     moveExtended ? "Price move above average" :
     timeExtended ? "Time elapsed above average" :
     "Still below average"

//──────────────────────────────────────────────
// DISPLAY TEXT
//──────────────────────────────────────────────
avgUpMoveText      = f_move_text(avgUpPoints, avgUpPercent)
avgDownMoveText    = na(avgAbsDownPoints) or na(avgAbsDownPercent) ? "n/a" : str.tostring(avgAbsDownPoints, format.mintick) + " pts / " + str.tostring(avgAbsDownPercent, "#.##") + "%"
currentMoveText    = f_move_text(currentMovePoints, currentMovePercent)
progressText       = na(pctOfAvgMovePct) or na(pctOfAvgBars) ? "n/a" : str.tostring(pctOfAvgMovePct, "#.##") + "% of avg move / " + str.tostring(pctOfAvgBars, "#.##") + "% of avg time"

//──────────────────────────────────────────────
// TABLE OVERLAID ON PRICE CHART
//──────────────────────────────────────────────
var table stats = table.new(position.top_right, 2, 14, border_width=1, force_overlay=true)

if barstate.islast
    if showTable
        bg = color.new(color.gray, 20)
        tc = color.white

        table.cell(stats, 0, 0, "Cycle Statistic", bgcolor=bg, text_color=tc)
        table.cell(stats, 1, 0, "Value", bgcolor=bg, text_color=tc)

        table.cell(stats, 0, 1, "Completed up cycles", bgcolor=bg, text_color=tc)
        table.cell(stats, 1, 1, str.tostring(upCount), bgcolor=bg, text_color=tc)

        table.cell(stats, 0, 2, "Completed down cycles", bgcolor=bg, text_color=tc)
        table.cell(stats, 1, 2, str.tostring(downCount), bgcolor=bg, text_color=tc)

        table.cell(stats, 0, 3, "Up-cycle average sample", bgcolor=bg, text_color=tc)
        table.cell(stats, 1, 3, str.tostring(recentUpCount) + " of " + str.tostring(lookbackN), bgcolor=bg, text_color=tc)

        table.cell(stats, 0, 4, "Avg up-cycle move", bgcolor=bg, text_color=tc)
        table.cell(stats, 1, 4, avgUpMoveText, bgcolor=bg, text_color=tc)

        table.cell(stats, 0, 5, "Avg up-cycle duration", bgcolor=bg, text_color=tc)
        table.cell(stats, 1, 5, na(avgUpBars) ? "n/a" : str.tostring(avgUpBars, "#.##") + " bars", bgcolor=bg, text_color=tc)

        table.cell(stats, 0, 6, "Down-cycle average sample", bgcolor=bg, text_color=tc)
        table.cell(stats, 1, 6, str.tostring(recentDownCount) + " of " + str.tostring(lookbackN), bgcolor=bg, text_color=tc)

        table.cell(stats, 0, 7, "Avg down-cycle move", bgcolor=bg, text_color=tc)
        table.cell(stats, 1, 7, avgDownMoveText, bgcolor=bg, text_color=tc)

        table.cell(stats, 0, 8, "Avg down-cycle duration", bgcolor=bg, text_color=tc)
        table.cell(stats, 1, 8, na(avgDownBars) ? "n/a" : str.tostring(avgDownBars, "#.##") + " bars", bgcolor=bg, text_color=tc)

        table.cell(stats, 0, 9, "Current cycle", bgcolor=bg, text_color=tc)
        table.cell(stats, 1, 9, currentCycleDirection, bgcolor=bg, text_color=tc)

        table.cell(stats, 0, 10, "Current move from last extreme", bgcolor=bg, text_color=tc)
        table.cell(stats, 1, 10, currentMoveText, bgcolor=bg, text_color=tc)

        table.cell(stats, 0, 11, "Current bars since last extreme", bgcolor=bg, text_color=tc)
        table.cell(stats, 1, 11, na(currentBarsElapsed) ? "n/a" : str.tostring(currentBarsElapsed), bgcolor=bg, text_color=tc)

        table.cell(stats, 0, 12, "Current progress vs average", bgcolor=bg, text_color=tc)
        table.cell(stats, 1, 12, progressText, bgcolor=bg, text_color=tc)

        table.cell(stats, 0, 13, "Current Cycle Status:", bgcolor=bg, text_color=tc)
        table.cell(stats, 1, 13, statusText, bgcolor=bg, text_color=tc)
    else
        for r = 0 to 13
            table.cell(stats, 0, r, "")
            table.cell(stats, 1, r, "")
