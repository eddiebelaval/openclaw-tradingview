//                                 ██║       ██║     ████████║  ██║ ███║  ██║   ██║       ██████╔╝ ██║   ██║ ██║      ████████║ ████████║
//                                 ██║       ██║     ██╔═══██║  ██║  ██║  ██║   ██║       ██╔══██╗ ██║   ██║ ██║      ██║   ██║ ██╔═══██║
//                                 ██║    ████████╗  ██║   ██║  ███████║  ╚██████╔╝       ██║  ██║ ╚██████╔╝ ╚██████╗ ██║   ██║ ██║   ██║
//@version=6
indicator('Double Commodity Channel Index - DCCI | TR', 'DCCI | TR →',false)
import TradingView/ta/12
//╔═════════════════╗
//║     Input's     ║
//╚═════════════════╝
Color_Mode =        input.string('Classic', 'Color Choice', group = '🎨 Color', options = ['Classic', 'Modern', 'Robust', 'Accented', 'Monochrome', 'Moderate', 'Aqua', 'Cosmic'])
Length_DCCI =       input.int(55, title = 'Length DCCI', inline = 'DCCI', group='⚙️ DCCI Setting')
Source_DCCI =       input.source(close, '', inline = 'DCCI', group = '⚙️ DCCI Setting')
Signal_DCCI =       input.string('0', 'Entry/Exit Signal', group='⚙️ DCCI Setting', options = ['0', 'DCCI MA'],tooltip = 'Choose Entry/Exit Point')
Length_MA_DCCI =    input.int(365, title = 'Length MA', group='📊 DCCI MA', inline = 'MA')
Source_MA_DCCI =    input.string('EMA', 'Moving Average', group='📊 DCCI MA', inline = 'MA', options=['EMA', 'SMA', 'RMA', 'WMA', 'VWMA', 'HMA', 'DEMA', 'TEMA', 'TRIMA', 'FRAMA', 'SWMA', 'T3'])
T_Factor =          input.float(0.7, 'T3 Factor', minval=0, maxval=1, step=0.05, group='📊 DCCI MA', tooltip = 'For Moving Average = T3')
//╔═════════════════════════════════╗
//║     MOVING AVERAGE ENGINE       ║
//╚═════════════════════════════════╝
ma(source, length, factor, type) =>
     type == 'EMA'   ? ta.ema(source, length) :
     type == 'SMA'   ? ta.sma(source, length) :
     type == 'RMA'   ? ta.rma(source, length) :
     type == 'WMA'   ? ta.wma(source, length) :
     type == 'VWMA'  ? ta.vwma(source, length) :
     type == 'HMA'   ? ta.hma(source, length) :
     type == 'DEMA'  ? ta.dema(source, length) :
     type == 'TEMA'  ? ta.tema(source, length) :
     type == 'TRIMA' ? ta.trima(source, length) :
     type == 'FRAMA' ? ta.frama(source, length) :
     type == 'SWMA'  ? ta.swma(source) :
     type == 'T3'    ? ta.t3(source, length, factor) :
     na
//╔═════════════════╗
//║     Color       ║
//╚═════════════════╝
[UpC, DnC] = switch Color_Mode
    'Classic' =>    [#008800, #ff0000]
    'Modern' =>     [#ffffff, #b721ff]
    'Robust' =>     [#ffbb00, #770737]
    'Accented' =>   [#8c5cf7, #e83e8c]
    'Monochrome' => [#e9ecef, #495057]
    'Moderate' =>   [#43a047, #e53935]
    'Aqua' =>       [#00a8e8, #f18f01]
    'Cosmic' =>     [#e83e8c, #6f2da8]
//╔════════════════════════╗
//║      Calculation       ║
//╚════════════════════════╝
CCI = ta.cci(Source_DCCI,Length_DCCI)
DCCI = 2 * CCI - ta.cci(CCI, Length_DCCI)
DCCI_MA = ma(DCCI, Length_MA_DCCI, T_Factor, Source_MA_DCCI)
float Entry_DCCI = Signal_DCCI == 'DCCI MA' ? DCCI_MA : 0.0
isBull_DCCI = DCCI > Entry_DCCI
isBear_DCCI = DCCI < Entry_DCCI
Bull_CCI = ta.crossover(DCCI, Entry_DCCI)
Bear_CCI = ta.crossunder(DCCI, Entry_DCCI)
//╔════════════════════════╗
//║          Plot          ║
//╚════════════════════════╝
Plot_Entry_DCCI =   plot(Entry_DCCI, color = color.yellow)
Plot_DCCI =         plot(DCCI, color = DCCI > Entry_DCCI ? color.new(UpC, 50):color.new(DnC, 50), linewidth = 3)
fill(Plot_DCCI, Plot_Entry_DCCI, 300, 0, top_color = color.new(UpC, 0),    bottom_color = color.new(UpC, 100), title = 'Overbought Fill')
fill(Plot_DCCI, Plot_Entry_DCCI, 0, -300, top_color = color.new(DnC, 100), bottom_color = color.new(DnC, 0),    title = 'Oversold Fill')
fill(Plot_DCCI, Plot_Entry_DCCI, CCI < Entry_DCCI ? DCCI : Entry_DCCI, DCCI < Entry_DCCI ? Entry_DCCI : DCCI, DCCI < Entry_DCCI ? DnC : #00000000, DCCI < Entry_DCCI ? #00000000 : UpC)
plotcandle(open, high, low, close, 'Bar Color', isBull_DCCI ? UpC : isBear_DCCI ? DnC : na, isBull_DCCI ? UpC : isBear_DCCI ? DnC : na, bordercolor = isBull_DCCI ? UpC : isBear_DCCI ? DnC : na, force_overlay = true)
plotshape(Bull_CCI, 'LONG' , shape.triangleup  , location.belowbar, UpC,    0, size = size.small, force_overlay = true)
plotshape(Bear_CCI, 'SHORT', shape.triangledown, location.abovebar, DnC,    0, size = size.small, force_overlay = true)
bgcolor(isBull_DCCI ? color.new(UpC, 95) : isBear_DCCI ? color.new(DnC, 95) : na, title='Zone Background', force_overlay = true)
//╔════════════════════════╗
//║          VIEW          ║
//╚════════════════════════╝
var table Table_DCCI = table.new(position.middle_right, 1, 1, border_width = 1)
var label DCCILabel = na
if barstate.islast
    table.cell(Table_DCCI, 0, 0, text = isBull_DCCI ? '⬆️ Bullish' : '⬇️ Bearish', text_color = isBull_DCCI ? UpC : DnC,text_size = size.huge)
    if not na(DCCILabel)
        label.delete(DCCILabel)
    DCCILabel := label.new(bar_index + 5, DCCI, text =  str.tostring(DCCI, '#.##'), color = DCCI > Entry_DCCI ? color.new(UpC, 20) : DCCI < Entry_DCCI ? color.new(DnC, 20) : color.gray, style = label.style_label_left, size = size.large, textcolor = #000000)
//╔════════════════════════╗
//║         Alerts         ║
//╚════════════════════════╝
alertcondition(isBull_DCCI, title= 'LONG', message= '{{ticker}} LONG')
alertcondition(isBear_DCCI, title= 'SHORT', message= '{{ticker}} SHORT')
