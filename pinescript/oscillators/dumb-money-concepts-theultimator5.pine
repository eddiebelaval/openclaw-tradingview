//@version=6
indicator("Dumb Money Concepts [theUltimator5]", overlay=false, max_labels_count=500)

// INPUTS
group_general = "General Settings"
cooldownBars  = input.int(20, "Signal Cooldown (bars)", minval=1, group=group_general)
showRetailUI  = input.bool(false, "Enable Retail Indicator Clutter", group=group_general)

const string MODE_ADX   = "Dumb Directional Index (DDX)"
const string MODE_INDEX = "Dumb Money Index (DMI)"
panelMode = input.string(MODE_INDEX, "Panel Mode", options=[MODE_ADX, MODE_INDEX],
     tooltip="Switch between the DDX view and the normalized Dumb Money Index oscillator with component table.")
showADX   = panelMode == MODE_ADX
showIndex = panelMode == MODE_INDEX

group_signals = "Signal Toggles"
showFOMO  = input.bool(true,  "🔥 FOMO Breakout",    group=group_signals)
showPanic = input.bool(true,  "🩸 Panic Flush",       group=group_signals)
showCrowd = input.bool(true,  "🎯 Indicator Crowd",   group=group_signals)
showHerd  = input.bool(true,  "🐑 Herd Exhaustion",   group=group_signals)
showBored = input.bool(true,  "😴 Boring Price Action", group=group_signals)
showChase = input.bool(true,  "🏃‍♂️ Chase Price", group=group_signals)
showHopeless = input.bool(true,  "😱 Hopelessness", group=group_signals)

group_dumbadx = "DDX"

showBgHighlight          = input.bool(false, "Highlight Chart BG on Strong Trend",     group=group_dumbadx,
     tooltip="Green background when price action is extremely bullish calculated from rising DMX.  Red background is the opposite, obviously")
showConsolidationCandles = input.bool(true, "Highlight Consolidation Candles (Yellow)", group=group_dumbadx,
     tooltip="Show areas of 'boring' price action.")

group_index      = "Dumb Money Index"
indexLookback    = input.int(100, "Normalization Lookback", minval=20, group=group_index,
     tooltip="Lookback period used to normalize each component to a 0–100 scale.")
indexFastLen     = input.int(5,   "Fast MA Length",  minval=1, group=group_index,
     tooltip="MA length for the fast DMI line. Default 5.  1 = raw index value with no smoothing.")
indexSlowLen     = input.int(12,  "Slow MA Length",  minval=2, group=group_index,
     tooltip="MA length for the slow DMI line.")
showIndexTable   = input.bool(true, "Show Component Table", group=group_index)
tablePosition    = input.string("Middle Left", "Table Position",
     options=["Top Left","Top Right","Bottom Left","Bottom Right","Middle Left","Middle Right"],
     group=group_index)

group_gap         = "📍 Gap Lines"
showDumbGapLines  = input.bool(true,  "Show Gap Lines",      group=group_gap)
showDumbGapLabels = input.bool(true,  "Show Gap Labels",      group=group_gap)
showDumbGapFade   = input.bool(true,  "Show Gap Fill Fade",   group=group_gap,
     tooltip="Fills the space between the gap line and current price with a fading color.")
dumbGapLineColor  = input.color(color.orange, "Gap Line Color", group=group_gap)

// RANDOM STUFF
diMIN      = 20
rsiLen     = 14
emaLen     = 20
atrLen     = 14
lookbackHH = 50
dumb_adx_low_threshold   = 14
dumb_adx_high_threshold  = 40
dumbLen                  = 14
dumbSmooth               = 14

var color invisible_line = color.new(color.white, 100)

appendLine(existing, newLine) =>
    str.length(existing) > 0 ? existing + "\n" + newLine : newLine

tooltip_fomo()     => "🔥 FOMO BREAKOUT\nPrice just blasted through the 50-bar high with RSI above 80 and is stretched more than 2x ATR from the EMA. This is where retail starts to fear missing a moonshot when they are simply acting as exit liquidity."
tooltip_herd()     => "🐑 HERD EXHAUSTION\nFive straight green candles, volume surging 2x above average, RSI above 75.  This is when everybody is piling in from FOMO and the price is exhausing itself.  Herd exhaustion generally happens at extreme tops and is where bagholders are made."
tooltip_chase()    => "🏃 CHASE PRICE\nThe DMX is in strong trend territory but just started rolling over from its peak. This is where retail likes to jump in right as the upwards momentum fades and justify their move by calling it a 'pullback'.  The only thing getting pulled back should be their leverage from this reckless behaior."
tooltip_bored()    => "😴 BORING PRICE ACTION\nPrice action is boring.  No significant moves lately and this is the point where retail generally avoids making a move... when this is the point where a large move is most likely."
tooltip_hopeless() => "😱 HOPELESSNESS\nThe DMX is in a strong downtrend but just peaked and is rolling over from the low.  This is where the bears come out in force saying that the dip has only begun, when they simply want you to panic sell the extreme bottom."
tooltip_panic()    => "🩸 PANIC FLUSH\nPrice knifed below the 50-bar low on 2x+ volume before snapping back inside the range. This is a classic stoploss grab and shakeout. Retail panic-sold the exact low.  This move just triggered a reddit post with someone crying that they blew their account."

rsi   = ta.rsi(close, rsiLen)
ema   = ta.ema(close, emaLen)
atr   = ta.atr(atrLen)
volMA = ta.sma(volume, 30)

highestBreak = ta.highest(high, lookbackHH)
lowestBreak  = ta.lowest(low,  lookbackHH)
[basis, bbUpper, bbLower] = ta.bb(close, 20, 2)
vwapValue = ta.vwap(close)

ema20  = ta.ema(close, 20)
sma50  = ta.sma(close, 50)
sma200 = ta.sma(close, 200)

plot(showRetailUI ? ema20     : na, title="EMA 20",  color=color.blue,   force_overlay=true)
plot(showRetailUI ? sma50     : na, title="SMA 50",  color=color.orange, force_overlay=true)
plot(showRetailUI ? sma200    : na, title="SMA 200", color=color.red,    force_overlay=true)
plot(showRetailUI ? bbUpper   : na, title="BB Up",   color=color.gray,   force_overlay=true)
plot(showRetailUI ? bbLower   : na, title="BB Low",  color=color.gray,   force_overlay=true)
plot(showRetailUI ? vwapValue : na, title="VWAP",    color=color.purple, force_overlay=true)

var int lastFOMO     = na
var int lastPanic    = na
var int lastCrowd    = na
var int lastNews     = na
var int lastHerd     = na
var int lastBored    = na
var int lastChase    = na
var int lastHopeless = na

cooldownOK(lastBar) =>
    na(lastBar) or bar_index - lastBar > cooldownBars

// BASE SIGNAL CONDITIONS
distanceFromEMA = math.abs(close - ema)

fomoCondition =
     close > highestBreak[1] and
     rsi > 80 and
     distanceFromEMA > 2 * atr

panicCondition =
     low < lowestBreak[1] and
     close > lowestBreak[1] and
     volume > volMA * 2

greenStreak =
     close > close[1] and
     close[1] > close[2] and
     close[2] > close[3] and
     close[3] > close[4] and
     close[4] > close[5]

herdCondition =
     greenStreak and
     volume > volMA * 2 and
     rsi > 75

dumbBullRaw =
     (rsi > 70 ? (rsi - 70) / 30 : 0) +
     (close > ema ? (close - ema) / atr : 0) +
     (volume > volMA ? (volume / volMA - 1) : 0)

dumbBearRaw =
     (rsi < 30 ? (30 - rsi) / 30 : 0) +
     (close < ema ? (ema - close) / atr : 0) +
     (volume > volMA ? (volume / volMA - 1) : 0)

dumbClose = (dumbBullRaw - dumbBearRaw) * atr
dumbOpen  = nz(dumbClose[1])
dumbRange = math.abs(dumbBullRaw - dumbBearRaw) * atr * 0.3

dumbHigh = math.max(dumbClose, dumbOpen) + dumbRange
dumbLow  = math.min(dumbClose, dumbOpen) - dumbRange

// DI LOGIC
dumbTrueRange = math.max(
     dumbHigh - dumbLow,
     math.abs(dumbHigh - dumbClose[1]),
     math.abs(dumbLow  - dumbClose[1])
)

dumbUpMove   = dumbHigh - dumbHigh[1]
dumbDownMove = dumbLow[1] - dumbLow

volRatio  = volume / math.max(volMA, 1)
volFactor = math.max(0.85, math.min(1.15, 0.85 + 0.30 * math.min(volRatio, 1.0)))

dumbPosDM = dumbUpMove > dumbDownMove and dumbUpMove > 0 ? dumbUpMove * volFactor : 0
dumbNegDM = dumbDownMove > dumbUpMove and dumbDownMove > 0 ? dumbDownMove * volFactor : 0

dumbSmoothPosDM = ta.rma(dumbPosDM, dumbLen)
dumbSmoothNegDM = ta.rma(dumbNegDM, dumbLen)
dumbSmoothTR    = ta.rma(dumbTrueRange, dumbLen)

dumbDIPlus  = 100 * dumbSmoothPosDM / dumbSmoothTR
dumbDIMinus = 100 * dumbSmoothNegDM / dumbSmoothTR

dumbDX       = 100 * math.abs(dumbDIPlus - dumbDIMinus) / (dumbDIPlus + dumbDIMinus)
dumbADXValue = ta.rma(dumbDX, dumbSmooth)

dumb_is_strong  = dumbADXValue >= dumb_adx_high_threshold
dumb_is_weak    = dumbADXValue < dumb_adx_low_threshold and dumbDIPlus < diMIN and dumbDIMinus < diMIN
dumb_bull_trend = dumb_is_strong and dumbDIPlus > dumbDIMinus
dumb_bear_trend = dumb_is_strong and dumbDIMinus > dumbDIPlus

bgcolor(showBgHighlight and dumb_bull_trend ? color.new(color.green, 90) : na, force_overlay=true)
bgcolor(showBgHighlight and dumb_bear_trend ? color.new(color.red,   90) : na, force_overlay=true)

plotcandle(showConsolidationCandles and dumb_is_weak ? open  : na,
           showConsolidationCandles and dumb_is_weak ? high  : na,
           showConsolidationCandles and dumb_is_weak ? low   : na,
           showConsolidationCandles and dumb_is_weak ? close : na,
           color=color.new(color.yellow, 75),
           wickcolor=color.new(color.yellow, 50),
           bordercolor=color.new(color.yellow, 20),
           force_overlay=true,
           display=display.pane)

plotcandle(showConsolidationCandles and dumb_is_weak ? open  : na,
           showConsolidationCandles and dumb_is_weak ? high  : na,
           showConsolidationCandles and dumb_is_weak ? low   : na,
           showConsolidationCandles and dumb_is_weak ? close : na,
           color=color.new(color.yellow, 30),
           wickcolor=color.new(color.yellow, 0),
           bordercolor=color.new(color.yellow, 0),
           force_overlay=true,
           display=display.pane)

// NORMALIZED DMI COMPONENTS
normalize(src, len) =>
    lo = ta.lowest(src, len)
    hi = ta.highest(src, len)
    rng = hi - lo
    rng == 0 or na(rng) ? 50.0 : 100.0 * (src - lo) / rng

rsi_norm = normalize(rsi, indexLookback)

[macd_line, macd_sig, macd_hist] = ta.macd(close, 12, 26, 9)
macd_norm = normalize(macd_hist, indexLookback)

bb_pos = (bbUpper - bbLower) == 0 ? 50.0 : 100.0 * (close - bbLower) / (bbUpper - bbLower)
bb_norm = normalize(bb_pos, indexLookback)

vol_raw = volume / volMA * (close >= open ? 1.0 : -1.0)
vol_norm = normalize(vol_raw, indexLookback)

dumb_raw = dumbBullRaw - dumbBearRaw
dumb_sent_norm = normalize(dumb_raw, indexLookback)

dumb_index_raw  = (rsi_norm + macd_norm + bb_norm + vol_norm + dumb_sent_norm) / 5.0

dumb_index_fast = ta.sma(dumb_index_raw, indexFastLen)
dumb_index_slow = ta.sma(dumb_index_raw, indexSlowLen)

dumb_hist       = dumb_index_fast - dumb_index_slow

hist_color =
     dumb_hist >= 0 and dumb_hist >= dumb_hist[1] ? color.new(color.green,  20) :
     dumb_hist >= 0 and dumb_hist <  dumb_hist[1] ? color.new(color.green,  60) :
     dumb_hist <  0 and dumb_hist <= dumb_hist[1] ? color.new(color.red,    20) :
                                                     color.new(color.red,    60)

dumb_index_fast_color = dumb_index_fast >= dumb_index_slow ?
     color.new(color.aqua,    0) : color.new(color.fuchsia, 0)
dumb_index_slow_color = color.new(color.white, 40)

plot(showIndex ? 70 : na, "FOMO Zone",  color=color.new(color.green, 70), linewidth=1, display=display.pane)
plot(showIndex ? 50 : na, "Midline",    color=color.new(color.gray,  50), linewidth=1, display=display.pane)
plot(showIndex ? 30 : na, "Panic Zone", color=color.new(color.red,   70), linewidth=1, display=display.pane)

plot(showIndex ? 50 + dumb_hist : na, "DMI Hist Top",    color=invisible_line, display=display.none)
plot(showIndex ? 50             : na, "DMI Hist Bottom", color=invisible_line, display=display.none)
plot(showIndex ? 50 + dumb_hist : na, "DMI Histogram",
     color=hist_color, style=plot.style_histogram, linewidth=1, histbase=50, display=display.pane)

plot(showIndex ? dumb_index_fast : na, "DMI Fast", color=dumb_index_fast_color, linewidth=1)
plot(showIndex ? dumb_index_slow : na, "DMI Slow", color=dumb_index_slow_color, linewidth=1)

// TABLE
get_table_pos() =>
    switch tablePosition
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right
        "Middle Left"  => position.middle_left
        "Middle Right" => position.middle_right
        =>                position.bottom_right

score_label(v) =>
    v >= 70 ? "🔥 FOMO"   :
     v >= 55 ? "📈 Buying" :
     v >= 45 ? "😐 Confused"      :
     v >= 30 ? "📉 Selling":
               "🩸 Panic"

score_color(v) =>
    v >= 70 ? color.green  :
     v >= 55 ? color.lime   :
     v >= 45 ? color.yellow :
     v >= 30 ? color.orange :
               color.red

if barstate.islast and showIndex and showIndexTable
    var table t = table.new(get_table_pos(), 3, 7,
         bgcolor=color.new(color.navy, 20), border_width=1)

    table.cell(t, 0, 0, "Component",  text_color=color.white, text_size=size.small, bgcolor=color.navy)
    table.cell(t, 1, 0, "Score",      text_color=color.white, text_size=size.small, bgcolor=color.navy)
    table.cell(t, 2, 0, "Status",     text_color=color.white, text_size=size.small, bgcolor=color.navy)

    names  = array.from("RSI", "MACD", "Bollinger", "Volume", "Crowd Mood")
    values = array.from(rsi_norm, macd_norm, bb_norm, vol_norm, dumb_sent_norm)

    for i = 0 to 4
        v   = array.get(values, i)
        nm  = array.get(names,  i)
        row = i + 1
        bg  = color.new(color.navy, 80)
        table.cell(t, 0, row, nm,                             text_color=color.silver,    text_size=size.tiny, bgcolor=bg)
        table.cell(t, 1, row, str.tostring(v, "#.0"),         text_color=color.white,     text_size=size.tiny, bgcolor=bg)
        table.cell(t, 2, row, score_label(v), text_color=score_color(v), text_size=size.tiny, bgcolor=bg)

    table.cell(t, 0, 6, "⚡ COMBINED",                                    text_color=color.white,                    text_size=size.tiny, bgcolor=color.new(color.navy, 40))
    table.cell(t, 1, 6, str.tostring(dumb_index_fast, "#.0"),             text_color=score_color(dumb_index_fast),   text_size=size.tiny, bgcolor=color.new(color.navy, 40))
    table.cell(t, 2, 6, score_label(dumb_index_fast), text_color=score_color(dumb_index_fast), text_size=size.tiny, bgcolor=color.new(color.navy, 40))

// DDX
dumb_adxTransparency =
     dumbADXValue > dumb_adx_high_threshold or dumbADXValue < dumb_adx_low_threshold ? 0 :
     dumbADXValue > 25 ?
         3 * (dumb_adx_high_threshold - dumbADXValue) :
         3 * (dumbADXValue - dumb_adx_low_threshold)

dumb_adx_color =
     dumb_is_weak    ? color.new(color.yellow,            dumb_adxTransparency) :
     dumb_bull_trend ? color.new(color.green,             0) :
     dumb_bear_trend ? color.new(color.red,               0) :
                       color.new(color.rgb(255, 0, 200),  dumb_adxTransparency)

dumbDIPlusTransparency  = dumbDIPlus  > dumb_adx_high_threshold ? 0 :
                          dumbDIPlus  < dumb_adx_low_threshold  ? 80 :
                          80 * (dumb_adx_high_threshold - dumbDIPlus)  / (dumb_adx_high_threshold - dumb_adx_low_threshold)

dumbDIMinusTransparency = dumbDIMinus > dumb_adx_high_threshold ? 0 :
                          dumbDIMinus < dumb_adx_low_threshold  ? 80 :
                          80 * (dumb_adx_high_threshold - dumbDIMinus) / (dumb_adx_high_threshold - dumb_adx_low_threshold)

dumb_adx_line_plot = plot(showADX ? dumbADXValue : na,
     title="DMX", color=dumb_adx_color, linewidth=2)

dumb_di_plus_plot  = plot(showADX ? dumbDIPlus  : na,
     title="DDX+", color=color.new(color.aqua,   dumbDIPlusTransparency))
dumb_di_minus_plot = plot(showADX ? dumbDIMinus : na,
     title="DDX-", color=color.new(color.orange, dumbDIMinusTransparency))

hline(showADX ? dumb_adx_low_threshold  : na, "Low Threshold",  color=color.gray, linestyle=hline.style_dashed)
hline(showADX ? dumb_adx_high_threshold : na, "High Threshold", color=color.gray, linestyle=hline.style_dashed)

dumb_show_strong_fade = showADX and dumbADXValue > dumb_adx_high_threshold
dumb_strong_top_color = dumb_show_strong_fade ?
     (dumbDIPlus > dumbDIMinus ? color.new(color.green, 0) : color.new(color.red, 0)) : na

fill(plot(dumb_show_strong_fade ? dumb_adx_high_threshold : na, color=invisible_line, display=display.none),
     plot(dumb_show_strong_fade ? dumbADXValue            : na, color=invisible_line, display=display.none),
     top_value    = dumbADXValue,
     bottom_value = dumb_adx_high_threshold,
     top_color    = dumb_strong_top_color,
     bottom_color = invisible_line,
     title="ADX Strong Fade")

dumb_show_weak_fade = showADX and dumbADXValue < dumb_adx_low_threshold

fill(plot(dumb_show_weak_fade ? dumbADXValue            : na, color=invisible_line, display=display.none),
     plot(dumb_show_weak_fade ? dumb_adx_low_threshold  : na, color=invisible_line, display=display.none),
     top_value    = dumbADXValue,
     bottom_value = dumb_adx_low_threshold,
     top_color    = dumb_show_weak_fade ? color.new(color.yellow, 0) : invisible_line,
     bottom_color = invisible_line,
     title="ADX Weak Fade")

// GAP DETECTION
dumb_min_jump = 10

dumbDIPlus_change  = dumbDIPlus  - dumbDIPlus[1]
dumbDIMinus_change = dumbDIMinus - dumbDIMinus[1]

dumb_has_di_spike     = dumbDIPlus_change > dumb_min_jump or dumbDIMinus_change > dumb_min_jump
dumb_is_consolidating = dumb_is_weak and
                         math.abs(dumbDIPlus[1] - dumbDIMinus[1]) < 5 and
                         dumbDIPlus < diMIN and dumbDIMinus < diMIN

dumb_gap_fill_detected = dumbADXValue[1] < dumb_adx_low_threshold and dumb_has_di_spike
dumb_yellow_highlight  = dumb_gap_fill_detected and dumb_is_consolidating[1]

var bool dumb_gap_fill_active = false
var int  dumb_bars_since_gap  = 0
var int  dumb_last_gap_bar    = -1

dumb_new_gap_detected = dumb_yellow_highlight and not dumb_yellow_highlight[1]

if dumb_new_gap_detected
    dumb_gap_fill_active := true
    dumb_bars_since_gap  := 0
    dumb_last_gap_bar    := bar_index

if dumb_gap_fill_active and bar_index > dumb_last_gap_bar
    dumb_bars_since_gap += 1

if dumb_bars_since_gap > 5000
    dumb_gap_fill_active := false
    dumb_bars_since_gap  := 0
    dumb_last_gap_bar    := -1

dumb_fills_allowed = dumb_gap_fill_active and bar_index > dumb_last_gap_bar

var float dumb_gap_price_level = na
var int   dumb_gap_start_bar   = na
var bool  dumb_line_broken     = false

dumb_new_highlight_detected = dumb_gap_fill_detected and not dumb_gap_fill_detected[1]

if dumb_new_highlight_detected
    dumb_gap_price_level := (open + close) / 2
    dumb_gap_start_bar   := bar_index
    dumb_line_broken     := false

var float _dumb_eps = syminfo.mintick * 0.25

dumb_have_level     = not na(dumb_gap_price_level)
dumb_after_startbar = dumb_have_level and not na(dumb_gap_start_bar) and bar_index > dumb_gap_start_bar

dumb_price_touches   = dumb_after_startbar and
                       low  <= dumb_gap_price_level + _dumb_eps and
                       high >= dumb_gap_price_level - _dumb_eps

dumb_crosses_between = dumb_after_startbar and not na(close[1]) and
                       (close[1] - dumb_gap_price_level) * (open - dumb_gap_price_level) < 0

if dumb_price_touches or dumb_crosses_between
    dumb_line_broken := true

show_dumb_gap_line   = showDumbGapLines and dumb_fills_allowed and
                       dumb_have_level and dumb_after_startbar and not dumb_line_broken

dumb_gap_above_price = show_dumb_gap_line and dumb_gap_price_level > close

dumb_gap_plot = plot(show_dumb_gap_line ? dumb_gap_price_level : na,
     color=dumbGapLineColor,
     style=plot.style_linebr,
     linewidth=1,
     force_overlay=true,
     display=display.pane)

dumb_close_plot = plot(show_dumb_gap_line ? close : na,
     color=invisible_line,
     style=plot.style_linebr,
     linewidth=1,
     force_overlay=true,
     display=display.pane)

fill(dumb_gap_plot, dumb_close_plot,
     top_value    = dumb_gap_above_price ? dumb_gap_price_level : close,
     bottom_value = dumb_gap_above_price ? close : dumb_gap_price_level,
     top_color    = showDumbGapFade and dumb_gap_above_price     ? color.new(dumbGapLineColor, 85) : color.new(dumbGapLineColor, 100),
     bottom_color = showDumbGapFade and not dumb_gap_above_price ? color.new(dumbGapLineColor, 85) : color.new(dumbGapLineColor, 100),
     title="Gap Fill")

if showDumbGapLabels and show_dumb_gap_line and not show_dumb_gap_line[1]
    label.new(
         x         = bar_index,
         y         = dumb_gap_price_level,
         text      = "❌ " + str.tostring(dumb_gap_price_level, "#.##"),
         style     = dumb_gap_above_price ? label.style_label_down : label.style_label_up,
         color     = color.new(color.white, 100),
         textcolor = dumbGapLineColor,
         size      = size.small,
         textalign = text.align_center,
         force_overlay = true)

// SIGNAL LABEL BLOCK
fomoFires     = showFOMO     and fomoCondition                                                                        and cooldownOK(lastFOMO)
panicFires    = showPanic    and panicCondition                                                                       and cooldownOK(lastPanic)
herdFires     = showHerd     and herdCondition                                                                        and cooldownOK(lastHerd)
boredFires    = showBored    and dumb_is_consolidating                                                                and cooldownOK(lastBored)
chaseFires    = showChase    and dumbADXValue > dumb_adx_high_threshold and dumbDIPlus > dumbDIMinus
                              and dumbADXValue < dumbADXValue[1] and dumbADXValue[1] > dumbADXValue[2]               and cooldownOK(lastChase)
hopelessFires = showHopeless and dumbADXValue > dumb_adx_high_threshold and dumbDIPlus < dumbDIMinus
                              and dumbADXValue < dumbADXValue[1] and dumbADXValue[1] > dumbADXValue[2]               and cooldownOK(lastHopeless)

anyFires = fomoFires or panicFires or herdFires or boredFires or chaseFires or hopelessFires

if anyFires
    txt = ""
    if fomoFires
        txt := appendLine(txt, "🔥FOMO")
    if herdFires
        txt := appendLine(txt, "🐑Herd")
    if chaseFires
        txt := appendLine(txt, "🏃‍♂️Chase")
    if boredFires
        txt := appendLine(txt, "😴Bored")
    if hopelessFires
        txt := appendLine(txt, "😱Hopeless")
    if panicFires
        txt := appendLine(txt, "🩸Flush")

    hasBear  = panicFires or hopelessFires
    hasBull  = fomoFires  or herdFires or chaseFires or boredFires
    bearOnly = hasBear and not hasBull

    labelY   = bearOnly ? low  : high
    lblStyle = bearOnly ? label.style_label_up : label.style_label_down

    hasBullStrong = fomoFires or herdFires or chaseFires
    boredOnly     = boredFires and not hasBullStrong and not hasBear
    lblColor      = boredOnly                     ? color.gray  :
                     hasBear and not hasBull        ? color.red   :
                     hasBullStrong and not hasBear  ? color.green :
                     color.white

    tip = ""
    if fomoFires
        tip := appendLine(tip, tooltip_fomo())
    if herdFires
        tip := appendLine(tip, tooltip_herd())
    if chaseFires
        tip := appendLine(tip, tooltip_chase())
    if boredFires
        tip := appendLine(tip, tooltip_bored())
    if hopelessFires
        tip := appendLine(tip, tooltip_hopeless())
    if panicFires
        tip := appendLine(tip, tooltip_panic())

    label.new(bar_index, labelY, txt,
         style      = lblStyle,
         color      = color.new(color.black, 85),
         textcolor  = lblColor,
         size       = size.small,
         tooltip    = tip,
         force_overlay = true)

    if fomoFires
        lastFOMO     := bar_index
    if panicFires
        lastPanic    := bar_index
    if herdFires
        lastHerd     := bar_index
    if boredFires
        lastBored    := bar_index
    if chaseFires
        lastChase    := bar_index
    if hopelessFires
        lastHopeless := bar_index
