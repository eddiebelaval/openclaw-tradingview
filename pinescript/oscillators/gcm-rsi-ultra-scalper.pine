//@version=6
indicator("GCM RSI Ultra Scalper", "GCM RUS", overlay=false, max_lines_count=500, max_labels_count=500)

// ============================================================================
// 1. CUSTOM FUNCTIONS
// ============================================================================
getMA(src, len, type) =>
    switch type
        "EMA"   => ta.ema(src, len)
        "SMA"   => ta.sma(src, len)
        "HMA"   => ta.hma(src, len)
        "WMA"   => ta.wma(src, len)
        "RMA"   => ta.rma(src, len)
        "LSMA"  => ta.linreg(src, len, 0)
        "ALMA"  => ta.alma(src, len, 0.85, 6)
        "DEMA"  => 
            e1 = ta.ema(src, len)
            e2 = ta.ema(e1, len)
            2 * e1 - e2
        "TEMA"  =>
            e1 = ta.ema(src, len)
            e2 = ta.ema(e1, len)
            e3 = ta.ema(e2, len)
            3 * (e1 - e2) + e3
        "ZLEMA" =>
            e1 = ta.ema(src, len)
            e2 = ta.ema(e1, len)
            e1 + (e1 - e2)
        => ta.ema(src, len) // Fallback

// ============================================================================
// 2. INPUTS & SETTINGS
// ============================================================================
grpCore      = "Core Settings"
source       = input.source(close, "Source", group=grpCore)
length       = input.int(5, "RSI Base Length", group=grpCore) 
smoothType   = input.string("LSMA", "RSI Smoothing Type", options=["EMA", "SMA", "HMA", "WMA", "RMA", "LSMA", "ALMA", "DEMA", "TEMA", "ZLEMA"], group=grpCore)
rsiSmoothLen = input.int(7, "RSI Smoothing Length", group=grpCore) 
shortMaType  = input.string("EMA", "Short MA Type", options=["EMA", "SMA", "HMA", "WMA", "RMA", "LSMA", "ALMA", "DEMA", "TEMA", "ZLEMA"], group=grpCore)
shortMaLen   = input.int(5, "Short MA Length", group=grpCore)

grpBB        = "Bollinger Bands"
bbLength     = input.int(20, "BB Length", group=grpBB)
bbMult1      = input.float(2.0, "BB Deviation 1 (Outer)", group=grpBB)
bbMult2      = input.float(1.5, "BB Deviation 2 (Inner)", group=grpBB)

grpDiv       = "Divergence"
showDiv      = input.bool(true, "Show Divergence", group=grpDiv)
lbR          = input.int(1, "Pivot Lookback Right", minval=1, group=grpDiv)
lbL          = input.int(1, "Pivot Lookback Left", minval=1, group=grpDiv)
maxDivBars   = input.int(5, "Max Lookback", minval=5, group=grpDiv)

grpVis       = "Visuals & Colors"
colBull      = input.color(color.new(#2dff00, 0), "Bullish Color", group=grpVis)
colBear      = input.color(color.new(#ff0000, 0), "Bearish Color", group=grpVis)
colMacroUp   = input.color(color.new(#5b9cf6, 0), "Macro Trend Up", group=grpVis)
colMacroDn   = input.color(color.new(#ffb74d, 0), "Macro Trend Down", group=grpVis)

grpDash      = "Pro Dashboard"
showTable    = input.bool(true, "Show Dashboard", group=grpDash)
dashPosStr   = input.string("Bottom Right", "Dashboard Position", options=["Top Right", "Top Center", "Top Left", "Bottom Right", "Bottom Center", "Bottom Left"], group=grpDash)
dashSizeStr  = input.string("Normal", "Text Size", options=["Tiny", "Small", "Normal", "Large"], group=grpDash)

// ============================================================================
// 3. CORE CALCULATIONS
// ============================================================================
rawRsi    = ta.rsi(source, length)
smoothRSI = getMA(rawRsi, rsiSmoothLen, smoothType) 
shortMa   = getMA(smoothRSI, shortMaLen, shortMaType) 

bbBasis   = ta.sma(smoothRSI, bbLength)
bbStdev   = ta.stdev(smoothRSI, bbLength)

bbUpper1  = bbBasis + (bbMult1 * bbStdev)
bbLower1  = bbBasis - (bbMult1 * bbStdev)

bbUpper2  = bbBasis + (bbMult2 * bbStdev)
bbLower2  = bbBasis - (bbMult2 * bbStdev)

// ============================================================================
// 4. DIVERGENCE ENGINE (Optimized)
// ============================================================================
plFound   = not na(ta.pivotlow(smoothRSI, lbL, lbR))
phFound   = not na(ta.pivothigh(smoothRSI, lbL, lbR))

var float prevRsiValL = na, var float prevPriceValL = na, var int prevBarIndexL = na
var float prevRsiValH = na, var float prevPriceValH = na, var int prevBarIndexH = na

regBull = false, hidBull = false
regBear = false, hidBear = false

if plFound
    // Lookbacks only calculated if a pivot is actually found
    rsiValL   = smoothRSI[lbR]
    priceValL = low[lbR]
    barIndexL = bar_index[lbR]
    
    if not na(prevBarIndexL) and (barIndexL - prevBarIndexL <= maxDivBars)
        regBull := priceValL < prevPriceValL and rsiValL > prevRsiValL
        hidBull := priceValL > prevPriceValL and rsiValL < prevRsiValL
            
        if showDiv and (regBull or hidBull)
            line.new(prevBarIndexL, prevRsiValL, barIndexL, rsiValL, color=colBull, width=1, style=hidBull ? line.style_dashed : line.style_solid)
            line.new(prevBarIndexL, prevPriceValL, barIndexL, priceValL, color=colBull, width=1, style=hidBull ? line.style_dashed : line.style_solid, force_overlay=true)
            label.new(barIndexL, rsiValL, text=hidBull ? "H" : "R", color=color.new(colBull, 50), textcolor=color.white, style=label.style_label_up, size=size.small)
            label.new(barIndexL, priceValL, text=hidBull ? "H" : "R", color=color.new(colBull, 50), textcolor=color.white, style=label.style_label_up, size=size.small, force_overlay=true)
            
    prevRsiValL := rsiValL, prevPriceValL := priceValL, prevBarIndexL := barIndexL

if phFound
    // Lookbacks only calculated if a pivot is actually found
    rsiValH   = smoothRSI[lbR]
    priceValH = high[lbR]
    barIndexH = bar_index[lbR]
    
    if not na(prevBarIndexH) and (barIndexH - prevBarIndexH <= maxDivBars)
        regBear := priceValH > prevPriceValH and rsiValH < prevRsiValH
        hidBear := priceValH < prevPriceValH and rsiValH > prevRsiValH
            
        if showDiv and (regBear or hidBear)
            line.new(prevBarIndexH, prevRsiValH, barIndexH, rsiValH, color=colBear, width=1, style=hidBear ? line.style_dashed : line.style_solid)
            line.new(prevBarIndexH, prevPriceValH, barIndexH, priceValH, color=colBear, width=1, style=hidBear ? line.style_dashed : line.style_solid, force_overlay=true)
            label.new(barIndexH, rsiValH, text=hidBear ? "H" : "R", color=color.new(colBear, 50), textcolor=color.white, style=label.style_label_down, size=size.small)
            label.new(barIndexH, priceValH, text=hidBear ? "H" : "R", color=color.new(colBear, 50), textcolor=color.white, style=label.style_label_down, size=size.small, force_overlay=true)
            
    prevRsiValH := rsiValH, prevPriceValH := priceValH, prevBarIndexH := barIndexH

// ============================================================================
// 5. PLOTTING & VISUALS
// ============================================================================
slopeBull   = smoothRSI > smoothRSI[1]
c_micro     = slopeBull ? colBull : colBear
isRsiOverMa = smoothRSI > shortMa
isZoneUp    = shortMa > 50

// Base Lines (Hidden on chart, but kept in Style tab for manual toggling)
plot(smoothRSI, "Smoothed RSI", color.new(c_micro, 0), display=display.none)
plot(shortMa, "Short MA", color.new(#A9A9A9, 60), display=display.none) 

// Static Visible Horizontal Lines
hline(80, "Overbought", color.new(color.red, 30), hline.style_dashed, linewidth=1)
hline(50, "Mid Line", color.new(#A9A9A9, 60), hline.style_solid, linewidth=1) 
hline(20, "Oversold", color.new(color.green, 30), hline.style_dashed, linewidth=1)

// ----------------------------------------------------------------------------
// A. BOLLINGER BAND RIBBONS
// ----------------------------------------------------------------------------
// Hidden BB Plots (Editable=false to hide them from Style tab)
p_bbUp1 = plot(bbUpper1, "Upper BB (Outer)", display=display.none, editable=false)
p_bbLo1 = plot(bbLower1, "Lower BB (Outer)", display=display.none, editable=false)
p_bbUp2 = plot(bbUpper2, "Upper BB (Inner)", display=display.none, editable=false)
p_bbLo2 = plot(bbLower2, "Lower BB (Inner)", display=display.none, editable=false)

// Fill Outer BB Zones (80% Transparent Theme Colors)
fill(p_bbUp1, p_bbUp2, color.new(colBear, 80), title="Top BB Ribbon", editable=false)
fill(p_bbLo1, p_bbLo2, color.new(colBull, 80), title="Bottom BB Ribbon", editable=false)

// ----------------------------------------------------------------------------
// B. MACRO RIBBON (From 50 to the edge of the Micro Ribbon)
// ----------------------------------------------------------------------------
ribbonTop    = math.max(smoothRSI, shortMa)
ribbonBottom = math.min(smoothRSI, shortMa)

c_macro      = isZoneUp ? colMacroUp : colMacroDn
macroEnd     = isZoneUp ? ribbonBottom : ribbonTop
stepM        = (macroEnd - 50) / 8

// 8 Invisible Steps for Macro Gradient (Editable=false to hide from Style tab)
m0 = plot(50, display=display.none, editable=false)
m1 = plot(50 + stepM * 1, display=display.none, editable=false)
m2 = plot(50 + stepM * 2, display=display.none, editable=false)
m3 = plot(50 + stepM * 3, display=display.none, editable=false)
m4 = plot(50 + stepM * 4, display=display.none, editable=false)
m5 = plot(50 + stepM * 5, display=display.none, editable=false)
m6 = plot(50 + stepM * 6, display=display.none, editable=false)
m7 = plot(50 + stepM * 7, display=display.none, editable=false)
m8 = plot(macroEnd, display=display.none, editable=false)

// Macro Fill (Editable=false to hide from Style tab)
fill(m0, m1, color.new(c_macro, 87), editable=false)
fill(m1, m2, color.new(c_macro, 75), editable=false)
fill(m2, m3, color.new(c_macro, 62), editable=false)
fill(m3, m4, color.new(c_macro, 50), editable=false)
fill(m4, m5, color.new(c_macro, 37), editable=false)
fill(m5, m6, color.new(c_macro, 25), editable=false)
fill(m6, m7, color.new(c_macro, 12), editable=false)
fill(m7, m8, color.new(c_macro, 0), editable=false)

// ----------------------------------------------------------------------------
// C. MICRO RIBBON (Between RSI and MA)
// ----------------------------------------------------------------------------
step = (ribbonTop - ribbonBottom) / 8

// 8 Invisible Steps for Micro Gradient (Editable=false to hide from Style tab)
p0 = plot(ribbonBottom, display=display.none, editable=false)
p1 = plot(ribbonBottom + step * 1, display=display.none, editable=false)
p2 = plot(ribbonBottom + step * 2, display=display.none, editable=false)
p3 = plot(ribbonBottom + step * 3, display=display.none, editable=false)
p4 = plot(ribbonBottom + step * 4, display=display.none, editable=false)
p5 = plot(ribbonBottom + step * 5, display=display.none, editable=false)
p6 = plot(ribbonBottom + step * 6, display=display.none, editable=false)
p7 = plot(ribbonBottom + step * 7, display=display.none, editable=false)
p8 = plot(ribbonTop, display=display.none, editable=false)

// Transparency Levels
t01 = isZoneUp ? 100 : 0
t02 = isZoneUp ? 85  : 14
t03 = isZoneUp ? 71  : 28
t04 = isZoneUp ? 57  : 43
t05 = isZoneUp ? 43  : 57
t06 = isZoneUp ? 28  : 71
t07 = isZoneUp ? 14  : 85
t08 = isZoneUp ? 0   : 100

// Micro Fill (Editable=false to hide from Style tab)
fill(p0, p1, color.new(c_micro, t01), editable=false)
fill(p1, p2, color.new(c_micro, t02), editable=false)
fill(p2, p3, color.new(c_micro, t03), editable=false)
fill(p3, p4, color.new(c_micro, t04), editable=false)
fill(p4, p5, color.new(c_micro, t05), editable=false)
fill(p5, p6, color.new(c_micro, t06), editable=false)
fill(p6, p7, color.new(c_micro, t07), editable=false)
fill(p7, p8, color.new(c_micro, t08), editable=false)

// ============================================================================
// 6. PRO DASHBOARD & ALERTS
// ============================================================================
// Dashboard Formatting Setup
dashPos = dashPosStr == "Top Right" ? position.top_right :
  dashPosStr == "Top Center" ? position.top_center :
  dashPosStr == "Top Left" ? position.top_left :
  dashPosStr == "Bottom Right" ? position.bottom_right :
  dashPosStr == "Bottom Center" ? position.bottom_center : position.bottom_left

dashSize = dashSizeStr == "Tiny" ? size.tiny :
  dashSizeStr == "Small" ? size.small :
  dashSizeStr == "Normal" ? size.normal : size.large

colSilver = color.new(#A9A9A9, 20) // Dim Silver Color

// Initialize Table Frame (Sleek dark theme)
var table dashTable = table.new(dashPos, 2, 4, border_width=1, border_color=color.new(#A9A9A9, 85), frame_color=color.new(#A9A9A9, 85), frame_width=1, bgcolor=color.new(#151924, 15))

if showTable and barstate.islast
    // Header Row
    table.cell(dashTable, 0, 0, text="GCM RUS ENGINE", text_color=color.new(color.white, 10), text_size=dashSize, text_halign=text.align_center, bgcolor=color.new(#2a2e39, 10))
    table.merge_cells(dashTable, 0, 0, 1, 0)
    
    // Row 1: RSI Value 
    rsiCol = smoothRSI >= 80 ? colBear : smoothRSI <= 20 ? colBull : colSilver
    table.cell(dashTable, 0, 1, text="RSI Level", text_color=colSilver, text_size=dashSize, text_halign=text.align_left)
    table.cell(dashTable, 1, 1, text=str.tostring(smoothRSI, "#.00"), text_color=rsiCol, text_size=dashSize, text_halign=text.align_right)
    
    // Row 2: Micro Signal
    table.cell(dashTable, 0, 2, text="Micro Signal", text_color=colSilver, text_size=dashSize, text_halign=text.align_left)
    table.cell(dashTable, 1, 2, text=isRsiOverMa ? "BULLISH" : "BEARISH", text_color=isRsiOverMa ? colBull : colBear, text_size=dashSize, text_halign=text.align_right)

    // Row 3: Macro Regime
    table.cell(dashTable, 0, 3, text="Macro Regime", text_color=colSilver, text_size=dashSize, text_halign=text.align_left)
    table.cell(dashTable, 1, 3, text=isZoneUp ? "UPTREND" : "DOWNTREND", text_color=isZoneUp ? colMacroUp : colMacroDn, text_size=dashSize, text_halign=text.align_right)

// Alerts
alertcondition(ta.crossover(smoothRSI, shortMa), "Scalp Buy (Micro)", "RSI crossed above Short MA")
alertcondition(ta.crossunder(smoothRSI, shortMa), "Scalp Sell (Micro)", "RSI crossed below Short MA")
alertcondition(regBull or hidBull, "Bullish Divergence", "Bullish Divergence Detected")
alertcondition(regBear or hidBear, "Bearish Divergence", "Bearish Divergence Detected")
