//@version=5
indicator("Mean Reversion Probability", shorttitle="MRP", overlay=false, max_lines_count=500)

obLevel   = input.float(2.0,  "Overbought Level",  group="Levels")
osLevel   = input.float(-2.0, "Oversold Level",    group="Levels")
obExtreme = input.float(3.0,  "Extreme OB Level",  group="Levels")
osExtreme = input.float(-3.0, "Extreme OS Level",  group="Levels")
smaLength = input.int(50, "SMA Length", group="Moving Average")

sma50    = ta.sma(close, smaLength)
stddev50 = ta.stdev(close, smaLength)
mrp      = (close - sma50) / stddev50

isExtremeOB = mrp >= obExtreme
isOB        = mrp >= obLevel and mrp < obExtreme
isExtremeOS = mrp <= osExtreme
isOS        = mrp <= osLevel and mrp > osExtreme

mrpColor = isExtremeOB ? #ff2d55 : isOB ? #ff9f0a : isExtremeOS ? #30d158 : isOS ? #32ade6 : #a0a0b0

midLine  = plot(0,         title="Zero",  color=color.new(#636366, 50), linewidth=1)
obLine   = plot(obLevel,   title="OB",    color=color.new(#ff9f0a, 40), linewidth=1)
osLine   = plot(osLevel,   title="OS",    color=color.new(#32ade6, 40), linewidth=1)
obExLine = plot(obExtreme, title="OB Ex", color=color.new(#ff2d55, 50), linewidth=1)
osExLine = plot(osExtreme, title="OS Ex", color=color.new(#30d158, 50), linewidth=1)
mrpPlot  = plot(mrp, title="MRP", color=mrpColor, linewidth=2)

fill(mrpPlot, obLine,   top_value=obExtreme, bottom_value=obLevel,   top_color=color.new(#ff9f0a, 80), bottom_color=color.new(#ff9f0a, 92))
fill(mrpPlot, obExLine, top_value=5,         bottom_value=obExtreme, top_color=color.new(#ff2d55, 68), bottom_color=color.new(#ff2d55, 80))
fill(mrpPlot, osLine,   top_value=osLevel,   bottom_value=osExtreme, top_color=color.new(#32ade6, 92), bottom_color=color.new(#32ade6, 80))
fill(mrpPlot, osExLine, top_value=osExtreme, bottom_value=-5,        top_color=color.new(#30d158, 80), bottom_color=color.new(#30d158, 68))

buySignal  = ta.crossunder(mrp, osLevel)
buyStrong  = ta.crossunder(mrp, osExtreme)
sellSignal = ta.crossover(mrp, obLevel)
sellStrong = ta.crossover(mrp, obExtreme)
buyExit    = ta.crossover(mrp, 0) and mrp[1] < 0
sellExit   = ta.crossunder(mrp, 0) and mrp[1] > 0

alertcondition(buySignal,  title="BUY",        message="MRP BUY: Crossed into oversold")
alertcondition(buyStrong,  title="STRONG BUY", message="MRP STRONG BUY: Extreme oversold")
alertcondition(sellSignal, title="SELL",        message="MRP SELL: Crossed into overbought")
alertcondition(sellStrong, title="STRONG SELL", message="MRP STRONG SELL: Extreme overbought")
alertcondition(buyExit,    title="Exit Long",   message="MRP: Exit long — crossed zero")
alertcondition(sellExit,   title="Exit Short",  message="MRP: Exit short — crossed zero")

zoneLabel   = isExtremeOB ? "EXTREME OB" : isOB ? "OVERBOUGHT" : isExtremeOS ? "EXTREME OS" : isOS ? "OVERSOLD" : "NEUTRAL"
zoneColor   = isExtremeOB ? #ff2d55 : isOB ? #ff9f0a : isExtremeOS ? #30d158 : isOS ? #32ade6 : #636366
revTarget   = sma50 - close
revPct      = revTarget / close * 100
revColor    = revTarget > 0 ? #30d158 : #ff2d55

var table t = table.new(position.top_right, 2, 7, bgcolor=color.new(#1c1c1e, 10), border_width=1, border_color=color.new(#3a3a3c, 0), frame_width=1, frame_color=color.new(#3a3a3c, 0))
table.cell(t, 0, 0, "MEAN REVERSION", text_color=#ebebf5, text_size=size.small, bgcolor=color.new(#2c2c2e, 0), text_halign=text.align_left)
table.cell(t, 1, 0, "MRP",            text_color=#ebebf5, text_size=size.small, bgcolor=color.new(#2c2c2e, 0), text_halign=text.align_right)
table.cell(t, 0, 1, "Z-Score",    text_color=#8e8e93, text_size=size.small, bgcolor=color.new(#1c1c1e, 10), text_halign=text.align_left)
table.cell(t, 1, 1, str.tostring(mrp, "#.###"),      text_color=mrpColor,  text_size=size.small, bgcolor=color.new(#1c1c1e, 10), text_halign=text.align_right)
table.cell(t, 0, 2, "SMA 50",     text_color=#8e8e93, text_size=size.small, bgcolor=color.new(#1c1c1e, 10), text_halign=text.align_left)
table.cell(t, 1, 2, str.tostring(sma50, "#.##"),     text_color=#ebebf5,   text_size=size.small, bgcolor=color.new(#1c1c1e, 10), text_halign=text.align_right)
table.cell(t, 0, 3, "Std Dev",    text_color=#8e8e93, text_size=size.small, bgcolor=color.new(#1c1c1e, 10), text_halign=text.align_left)
table.cell(t, 1, 3, str.tostring(stddev50, "#.##"),  text_color=#ebebf5,   text_size=size.small, bgcolor=color.new(#1c1c1e, 10), text_halign=text.align_right)
table.cell(t, 0, 4, "To Mean",    text_color=#8e8e93, text_size=size.small, bgcolor=color.new(#1c1c1e, 10), text_halign=text.align_left)
table.cell(t, 1, 4, str.tostring(revTarget, "#.##") + "  (" + str.tostring(revPct, "#.##") + "%)", text_color=revColor, text_size=size.small, bgcolor=color.new(#1c1c1e, 10), text_halign=text.align_right)
table.cell(t, 0, 5, "Zone",       text_color=#8e8e93, text_size=size.small, bgcolor=color.new(#1c1c1e, 10), text_halign=text.align_left)
table.cell(t, 1, 5, zoneLabel,    text_color=zoneColor, text_size=size.small, bgcolor=color.new(#1c1c1e, 10), text_halign=text.align_right)
table.cell(t, 0, 6, "Bias",       text_color=#8e8e93, text_size=size.small, bgcolor=color.new(#1c1c1e, 10), text_halign=text.align_left)
table.cell(t, 1, 6, mrp > 0 ? "Above Mean" : mrp < 0 ? "Below Mean" : "At Mean", text_color=mrp > 0 ? #ff9f0a : mrp < 0 ? #32ade6 : #636366, text_size=size.small, bgcolor=color.new(#1c1c1e, 10), text_halign=text.align_right)
