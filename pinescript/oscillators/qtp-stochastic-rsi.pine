// ═══════════════════════════════════════════════════════════════════════════
//
//  QTP - Stochastic RSI
//  ─────────────────────
//  Stochastic oscillator applied to RSI values, combining momentum
//  measurement with overbought/oversold detection for sharper signals.
//
//  Features:
//  • RSI-based stochastic with independent RSI and Stochastic lengths
//  • Smoothed %K and %D lines in electric blue and hot pink
//  • Dark background panel for high-contrast visual clarity
//  • Configurable OB/OS levels with mid-line reference
//  • Clean, minimal design built for fast decision-making
//
// ═══════════════════════════════════════════════════════════════════════════

//@version=6
indicator("QTP - Stochastic RSI", shorttitle="QTP SthRSI", format=format.price, precision=2, timeframe="", timeframe_gaps=true)

// ─────────────────────────────────────────────────────────────────────────
//  SETTINGS
// ─────────────────────────────────────────────────────────────────────────
smoothK    = input.int(3,  "K",                 minval=1, group="Stochastic RSI")
smoothD    = input.int(3,  "D",                 minval=1, group="Stochastic RSI")
lengthRSI  = input.int(14, "RSI Length",        minval=1, group="Stochastic RSI")
lengthStoch = input.int(14, "Stochastic Length", minval=1, group="Stochastic RSI")
src        = input.source(close, "RSI Source",              group="Stochastic RSI")

upLine     = input.int(80, "Upper Band", minval=50, maxval=95, group="Levels")
midLine    = input.int(50, "Middle Band", minval=30, maxval=70, group="Levels")
lowLine    = input.int(20, "Lower Band", minval=5,  maxval=50, group="Levels")

// ─────────────────────────────────────────────────────────────────────────
//  COLORS
// ─────────────────────────────────────────────────────────────────────────
col_k      = color.new(#00D4FF, 0)    // electric blue (%K)
col_d      = color.new(#FF1493, 0)    // hot pink (%D)
col_band   = color.new(#555555, 0)    // muted gray for OB/OS lines
col_mid    = color.new(#555555, 50)   // faded gray for mid line
col_bg     = color.new(#000000, 85)   // dark background fill

// ─────────────────────────────────────────────────────────────────────────
//  CALCULATION
// ─────────────────────────────────────────────────────────────────────────
rsi1 = ta.rsi(src, lengthRSI)
k    = ta.sma(ta.stoch(rsi1, rsi1, rsi1, lengthStoch), smoothK)
d    = ta.sma(k, smoothD)

// ─────────────────────────────────────────────────────────────────────────
//  PLOTS
// ─────────────────────────────────────────────────────────────────────────
plot(k, "K", color=col_k, linewidth=2)
plot(d, "D", color=col_d, linewidth=2)

// ─────────────────────────────────────────────────────────────────────────
//  LEVELS & BACKGROUND
// ─────────────────────────────────────────────────────────────────────────
p_up  = plot(upLine,  "Upper Band",  color=col_band, linewidth=1)
p_mid = plot(midLine, "Middle Band", color=col_mid,  linewidth=1, style=plot.style_cross)
p_low = plot(lowLine, "Lower Band",  color=col_band, linewidth=1)
fill(p_up, p_low, color=col_bg, title="Background")
