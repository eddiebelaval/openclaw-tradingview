//@version=5
indicator("MTF 9/21 EMA + 50/100/200 SMA", shorttitle="MTF EMA + SMA", overlay=true)

// ────────────────────────────────────────────────
// Inputs
// ────────────────────────────────────────────────
lenFast = input.int(9,   "Fast EMA", minval=1)
lenSlow = input.int(21,  "Slow EMA", minval=1)

// ────────────────────────────────────────────────
// Colors
// ────────────────────────────────────────────────
bullColor = color.new(color.green, 0)
bearColor = color.new(color.red,   0)
neutColor = color.new(color.gray,  40)

// SMA colors – shades of yellow/orange, medium thickness
sma50Color  = color.new(#FFC107, 0)   // Amber / yellow-orange
sma100Color = color.new(#FF9800, 0)   // Deep orange
sma200Color = color.new(#F57C00, 0)   // Darker orange

// ────────────────────────────────────────────────
// Current timeframe EMAs + cross detection
// ────────────────────────────────────────────────
emaFast = ta.ema(close, lenFast)
emaSlow = ta.ema(close, lenSlow)

plot(emaFast,  "9 EMA",   color=color.orange, linewidth=2)
plot(emaSlow, "21 EMA",   color=color.blue,   linewidth=2)

// ────────────────────────────────────────────────
// 50, 100, 200 SMA – added here
// ────────────────────────────────────────────────
sma50  = ta.sma(close, 50)
sma100 = ta.sma(close, 100)
sma200 = ta.sma(close, 200)

plot(sma50,  "50 SMA",  color=sma50Color,  linewidth=2)
plot(sma100, "100 SMA", color=sma100Color, linewidth=2)
plot(sma200, "200 SMA", color=sma200Color, linewidth=2)

// ────────────────────────────────────────────────
// Crossovers on current timeframe (9/21 EMA)
// ────────────────────────────────────────────────
bullCross = ta.crossover(emaFast, emaSlow)
bearCross = ta.crossunder(emaFast, emaSlow)

plotshape(bullCross, title="Bull Cross", location=location.belowbar, color=bullColor, style=shape.triangleup,   size=size.small, text="BUY")
plotshape(bearCross, title="Bear Cross", location=location.abovebar, color=bearColor, style=shape.triangledown, size=size.small, text="SELL")

// ────────────────────────────────────────────────
// Higher Timeframe EMAs (unchanged)
// ────────────────────────────────────────────────
getEMA(tf) =>
    [fast, slow] = request.security(syminfo.tickerid, tf, 
         [ta.ema(close, lenFast), ta.ema(close, lenSlow)], 
         gaps=barmerge.gaps_off, 
         lookahead=barmerge.lookahead_off)
    [fast, slow]

[wk9,  wk21]   = getEMA("1W")
[dy9,  dy21]   = getEMA("1D")
[h4_9, h4_21]  = getEMA("240")
[h2_9, h2_21]  = getEMA("120")
[h1_9, h1_21]  = getEMA("60")
[m30_9, m30_21] = getEMA("30")
[m15_9, m15_21] = getEMA("15")

// ────────────────────────────────────────────────
// Trend status (9 > 21 = bullish)
// ────────────────────────────────────────────────
wkBull   = wk9  > wk21
dyBull   = dy9  > dy21
h4Bull   = h4_9 > h4_21
h2Bull   = h2_9 > h2_21
h1Bull   = h1_9 > h1_21
m30Bull  = m30_9 > m30_21
m15Bull  = m15_9 > m15_21

// Fresh cross detection
wkCrossUp   = wk9[1]  <= wk21[1]  and wk9  > wk21
wkCrossDn   = wk9[1]  >= wk21[1]  and wk9  < wk21
dyCrossUp   = dy9[1]  <= dy21[1]  and dy9  > dy21
dyCrossDn   = dy9[1]  >= dy21[1]  and dy9  < dy21
h4CrossUp   = h4_9[1] <= h4_21[1] and h4_9 > h4_21
h4CrossDn   = h4_9[1] >= h4_21[1] and h4_9 < h4_21
h2CrossUp   = h2_9[1] <= h2_21[1] and h2_9 > h2_21
h2CrossDn   = h2_9[1] >= h2_21[1] and h2_9 < h2_21
h1CrossUp   = h1_9[1] <= h1_21[1] and h1_9 > h1_21
h1CrossDn   = h1_9[1] >= h1_21[1] and h1_9 < h1_21
m30CrossUp  = m30_9[1] <= m30_21[1] and m30_9 > m30_21
m30CrossDn  = m30_9[1] >= m30_21[1] and m30_9 < m30_21
m15CrossUp  = m15_9[1] <= m15_21[1] and m15_9 > m15_21
m15CrossDn  = m15_9[1] >= m15_21[1] and m15_9 < m15_21

// ────────────────────────────────────────────────
// Dashboard Table
// ────────────────────────────────────────────────
var table dashboard = table.new(position.top_right, columns=4, rows=9, 
     bgcolor=color.new(color.black, 85), border_width=1, border_color=color.gray)

if barstate.islast
    // Header
    table.cell(dashboard, 0, 0, "Timeframe", text_color=color.white, bgcolor=color.gray)
    table.cell(dashboard, 1, 0, "Trend",      text_color=color.white, bgcolor=color.gray)
    table.cell(dashboard, 2, 0, "9 vs 21",    text_color=color.white, bgcolor=color.gray)
    table.cell(dashboard, 3, 0, "Signal",     text_color=color.white, bgcolor=color.gray)

    table.cell(dashboard, 0, 1, "Weekly", text_color=color.white)
    table.cell(dashboard, 1, 1, wkBull ? "Bullish ↑" : "Bearish ↓", text_color=wkBull ? bullColor : bearColor)
    table.cell(dashboard, 2, 1, wk9 > wk21 ? "9 > 21" : "9 < 21", text_color=wk9 > wk21 ? bullColor : bearColor)
    table.cell(dashboard, 3, 1, wkCrossUp ? "↑ Cross" : wkCrossDn ? "↓ Cross" : "", text_color=wkCrossUp ? bullColor : wkCrossDn ? bearColor : color.gray)

    table.cell(dashboard, 0, 2, "Daily", text_color=color.white)
    table.cell(dashboard, 1, 2, dyBull ? "Bullish ↑" : "Bearish ↓", text_color=dyBull ? bullColor : bearColor)
    table.cell(dashboard, 2, 2, dy9 > dy21 ? "9 > 21" : "9 < 21", text_color=dy9 > dy21 ? bullColor : bearColor)
    table.cell(dashboard, 3, 2, dyCrossUp ? "↑ Cross" : dyCrossDn ? "↓ Cross" : "", text_color=dyCrossUp ? bullColor : dyCrossDn ? bearColor : color.gray)

    table.cell(dashboard, 0, 3, "4 h", text_color=color.white)
    table.cell(dashboard, 1, 3, h4Bull ? "Bullish ↑" : "Bearish ↓", text_color=h4Bull ? bullColor : bearColor)
    table.cell(dashboard, 2, 3, h4_9 > h4_21 ? "9 > 21" : "9 < 21", text_color=h4_9 > h4_21 ? bullColor : bearColor)
    table.cell(dashboard, 3, 3, h4CrossUp ? "↑ Cross" : h4CrossDn ? "↓ Cross" : "", text_color=h4CrossUp ? bullColor : h4CrossDn ? bearColor : color.gray)

    table.cell(dashboard, 0, 4, "2 h", text_color=color.white)
    table.cell(dashboard, 1, 4, h2Bull ? "Bullish ↑" : "Bearish ↓", text_color=h2Bull ? bullColor : bearColor)
    table.cell(dashboard, 2, 4, h2_9 > h2_21 ? "9 > 21" : "9 < 21", text_color=h2_9 > h2_21 ? bullColor : bearColor)
    table.cell(dashboard, 3, 4, h2CrossUp ? "↑ Cross" : h2CrossDn ? "↓ Cross" : "", text_color=h2CrossUp ? bullColor : h2CrossDn ? bearColor : color.gray)

    table.cell(dashboard, 0, 5, "1 h", text_color=color.white)
    table.cell(dashboard, 1, 5, h1Bull ? "Bullish ↑" : "Bearish ↓", text_color=h1Bull ? bullColor : bearColor)
    table.cell(dashboard, 2, 5, h1_9 > h1_21 ? "9 > 21" : "9 < 21", text_color=h1_9 > h1_21 ? bullColor : bearColor)
    table.cell(dashboard, 3, 5, h1CrossUp ? "↑ Cross" : h1CrossDn ? "↓ Cross" : "", text_color=h1CrossUp ? bullColor : h1CrossDn ? bearColor : color.gray)

    table.cell(dashboard, 0, 6, "30 min", text_color=color.white)
    table.cell(dashboard, 1, 6, m30Bull ? "Bullish ↑" : "Bearish ↓", text_color=m30Bull ? bullColor : bearColor)
    table.cell(dashboard, 2, 6, m30_9 > m30_21 ? "9 > 21" : "9 < 21", text_color=m30_9 > m30_21 ? bullColor : bearColor)
    table.cell(dashboard, 3, 6, m30CrossUp ? "↑ Cross" : m30CrossDn ? "↓ Cross" : "", text_color=m30CrossUp ? bullColor : m30CrossDn ? bearColor : color.gray)

    table.cell(dashboard, 0, 7, "15 min", text_color=color.white)
    table.cell(dashboard, 1, 7, m15Bull ? "Bullish ↑" : "Bearish ↓", text_color=m15Bull ? bullColor : bearColor)
    table.cell(dashboard, 2, 7, m15_9 > m15_21 ? "9 > 21" : "9 < 21", text_color=m15_9 > m15_21 ? bullColor : bearColor)
    table.cell(dashboard, 3, 7, m15CrossUp ? "↑ Cross" : m15CrossDn ? "↓ Cross" : "", text_color=m15CrossUp ? bullColor : m15CrossDn ? bearColor : color.gray)

    // Summary
    bullCount = (wkBull?1:0) + (dyBull?1:0) + (h4Bull?1:0) + (h2Bull?1:0) + (h1Bull?1:0) + (m30Bull?1:0) + (m15Bull?1:0)
    table.cell(dashboard, 0, 8, "Bullish TFs:", text_color=color.white, bgcolor=color.gray)
    table.cell(dashboard, 1, 8, str.tostring(bullCount) + " / 7", 
         text_color = bullCount >= 5 ? bullColor : bullCount <= 2 ? bearColor : color.yellow, 
         bgcolor = color.gray)
