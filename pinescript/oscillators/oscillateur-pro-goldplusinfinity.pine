// © GoldPlusInfinity
//@version=6
indicator("GoldPlusInfinity_Pro_V6", overlay=false, scale=scale.right, precision=2)

// ==========================================
// CONFIGURATION MULTI-TIMEFRAME (MTF)
// ==========================================
group_mtf = "Configuration Temporelle"
useMTF    = input.bool(false, "Activer Multi-Timeframe", group=group_mtf)
tf        = input.timeframe("H", "Unité de Temps Supérieure", group=group_mtf)

// ==========================================
// PARAMÈTRES RSI PRO
// ==========================================
group_rsi = "Paramètres RSI"
showRSI   = input.bool(true, "Afficher RSI", group=group_rsi)
rsiLen    = input.int(7, "Période RSI", minval=1, group=group_rsi)
rsiSmooth = input.int(3, "Lissage RSI (EMA)", minval=1, group=group_rsi)
rsiOB     = input.int(70, "Surachat (OB)", group=group_rsi)
rsiOS     = input.int(30, "Survente (OS)", group=group_rsi)

// Calcul du RSI avec sécurité MTF
rawRsi = ta.rsi(close, rsiLen)
smoothedRsi = ta.ema(rawRsi, rsiSmooth)
rsi = useMTF ? request.security(syminfo.tickerid, tf, smoothedRsi, lookahead=barmerge.lookahead_on) : smoothedRsi

// ==========================================
// PARAMÈTRES TSI (CORRÉLATION)
// ==========================================
group_tsi = "Paramètres TSI (Momentum)"
showTSI   = input.bool(true, "Afficher TSI", group=group_tsi)
tsiLen    = input.int(14, "Période Corrélation", minval=1, group=group_tsi)
tsiSmooth = input.int(5, "Lissage TSI", minval=1, group=group_tsi)

// Calcul du TSI normalisé avec lissage
rawTsiRaw = ta.correlation(close, bar_index, tsiLen)
rawTsiNorm = math.min(math.max((rawTsiRaw + 1) * 50, 0), 100)
tsi = useMTF ? request.security(syminfo.tickerid, tf, ta.wma(rawTsiNorm, tsiSmooth), lookahead=barmerge.lookahead_on) : ta.wma(rawTsiNorm, tsiSmooth)

// ==========================================
// COULEURS ET ESTHÉTIQUE
// ==========================================
colorBull    = color.new(#00C853, 0)
colorBear    = color.new(#FF1744, 0)
colorNeutral = color.new(#787b86, 0)
colorSignal  = color.new(#FFD600, 0)
bgNeutral    = color.new(#808080, 90)

// ==========================================
// LOGIQUE DE CONVERGENCE (PRO SIGNAL)
// ==========================================
// Détection quand les deux indicateurs sortent des zones extrêmes en même temps
convergenceLong  = ta.crossover(rsi, rsiOS) and tsi < 40
convergenceShort = ta.crossunder(rsi, rsiOB) and tsi > 60

// ==========================================
// RENDER (AFFICHAGE)
// ==========================================

// RSI Plot - AMÉLIORATION VISUELLE
rsiColor = rsi > rsiOB ? colorBear : rsi < rsiOS ? colorBull : color.white
plot(showRSI ? rsi : na, "RSI Pro principal", color=rsiColor, linewidth=3, style=plot.style_line)

// Ligne de signal légère pour donner du relief au RSI
plot(showRSI ? rsi : na, "Effet Relief RSI", color=color.new(rsiColor, 70), linewidth=6, style=plot.style_line)

// TSI Plot
tsiColor = tsi >= 50 ? color.new(colorBull, 30) : color.new(colorBear, 30)
plot(showTSI ? tsi : na, "TSI Pro", color=tsiColor, linewidth=2, style=plot.style_area, histbase=50)

// Signaux de Convergence - POSITIONNÉS SUR LA LIGNE 50
// Correction : On utilise la valeur 50 pour forcer l'affichage au centre exact
plotshape(convergenceLong ? 50 : na, title="Achat Convergence", style=shape.circle, location=location.absolute, color=colorBull, size=size.tiny, offset=0)
plotshape(convergenceShort ? 50 : na, title="Vente Convergence", style=shape.circle, location=location.absolute, color=colorBear, size=size.tiny, offset=0)

// Niveaux et Zones
hOB = hline(rsiOB, "Surachat", color=color.new(colorBear, 20), linestyle=hline.style_solid, linewidth=1)
hOS = hline(rsiOS, "Survente", color=color.new(colorBull, 20), linestyle=hline.style_solid, linewidth=1)
hline(50, "Niveau Médian", color=bgNeutral)
fill(hOB, hOS, color=color.new(colorNeutral, 95), title="Zone Neutre")

// Arrière-plan dynamique pour les zones extrêmes
bgcolor(rsi > rsiOB ? color.new(colorBear, 92) : rsi < rsiOS ? color.new(colorBull, 92) : na)

// ==========================================
// ALERTES
// ==========================================
alertcondition(convergenceLong, "Achat: RSI + TSI", "Convergence Haussière détectée")
alertcondition(convergenceShort, "Vente: RSI + TSI", "Convergence Baissière détectée")
alertcondition(ta.cross(rsi, 50), "RSI Croisement 50", "Le RSI a traversé la ligne médiane")
