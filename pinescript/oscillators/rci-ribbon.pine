//@version=6
// © CVF4ZFQ
indicator("RCI Ribbon", overlay=false, precision=2)

shortLen  = input.int(9,  "RCI S",  minval=1, group="Length")
midLen    = input.int(26, "RCI M",  minval=2, group="Length")
longLen   = input.int(52, "RCI L",  minval=3, group="Length")
upColor   = input.color(color.red,   "Up Trend Color",   group="Color")
downColor = input.color(color.green, "Down Trend Color", group="Color")

s_raw = ta.rci(close, shortLen)
m_raw = ta.rci(close, midLen)
l_raw = ta.rci(close, longLen)

[rciS, rciM, rciL] = request.security(syminfo.tickerid, timeframe.period, [s_raw, m_raw, l_raw], lookahead=barmerge.lookahead_off)

rciS_Color = rciS > 90 ? upColor : rciS < -90 ? downColor : color.blue
p_s = plot(rciS, "RCI Short",  color=rciS_Color, linewidth=2)
p_m = plot(rciM, "RCI Middle", color=upColor, linewidth=1)
p_l = plot(rciL, "RCI Long",   color=downColor, linewidth=1)

hline(90,  "Overbought", color=upColor, linestyle=hline.style_dotted)
hline(0,   "Zero Line",  color=color.gray, linestyle=hline.style_solid)
hline(-90, "Oversold",   color=downColor, linestyle=hline.style_dotted)

ribbonColor = rciM > rciL ? color.new(upColor, 80) : color.new(downColor, 80)
fill(p_m, p_l, color=ribbonColor, title="Trend Ribbon")

isStrongUptrend = (rciL >= 85) or (rciL > 0 and rciL > rciL[1] and rciM >= 85)
isStrongDowntrend = (rciL <= -85) or (rciL < 0 and rciL < rciL[1] and rciM <= -85)

bgcolor(isStrongUptrend ? color.new(upColor, 90) : na, title="Strong Uptrend Background")
bgcolor(isStrongDowntrend ? color.new(downColor, 90) : na, title="Strong Downtrend Background")
