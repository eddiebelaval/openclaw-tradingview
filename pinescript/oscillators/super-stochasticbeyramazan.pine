//@version=6
indicator(title="Super Stochastic", shorttitle="Super Stochastic", format=format.price, precision=2, overlay=false)

//
periodK = input.int(14, title="%K Length", minval=1)
smoothK = input.int(1, title="%K Smoothing", minval=1)
periodD = input.int(3, title="%D Smoothing", minval=1)

// 
rawK = ta.stoch(close, high, low, periodK)
k = ta.sma(rawK, smoothK)
d = ta.sma(k, periodD)

// 
crossDown = ta.crossunder(k, d)
crossUp   = ta.crossover(k, d)

// 
kPivotHigh80 = k[1] > 80 and k[1] > k[2] and k < k[1]
kPivotLow80  = k[1] > 80 and k[1] < k[2] and k > k[1]

// 
midPivotHigh75 = k[1] >= 50 and k[1] <= 75 and k[1] > k[2] and k < k[1]
midPivotLow75  = k[1] >= 50 and k[1] <= 75 and k[1] < k[2] and k > k[1]

// 
midPivotHigh40 = k[1] >= 20 and k[1] <= 40 and k[1] > k[2] and k < k[1]
midPivotLow40  = k[1] >= 20 and k[1] <= 40 and k[1] < k[2] and k > k[1]

// 
kPivotLow20  = k[1] < 20 and k[1] < k[2] and k > k[1]

// 
var int lineState = 0 
if crossDown
    lineState := 1 
else if crossUp
    lineState := 2

kColor = lineState == 1 ? color.white : lineState == 2 ? color.green : #2962FF

// 
p_k = plot(k, title="%K", color=kColor, linewidth=2, style=plot.style_linebr)
p_d = plot(d, title="%D", color=#FF6D00, linewidth=2)

// 
p_80 = plot(80, display=display.none)
fillColorK = k > 80 ? color.new(#FF0000, 70) : color.new(#089981, 100)
fillColorD = d > 80 ? color.new(#FF0000, 70) : color.new(#089981, 100)
fill(p_k, p_80, color=fillColorK, title="K 80 Fill")
fill(p_d, p_80, color=fillColorD, title="D 80 Fill")

h_upper = hline(80, "Upper Band", color=#787B86)
hline(75, "75 Line", color=color.new(#787B86, 80), linestyle=hline.style_dotted)
hline(50, "Middle Band", color=color.new(#787B86, 50))
hline(40, "40 Line", color=color.new(#787B86, 80), linestyle=hline.style_dotted)
h_lower = hline(20, "Lower Band", color=#787B86)
fill(h_upper, h_lower, color=color.rgb(33, 150, 243, 95), title="Main BG")

// 
if kPivotHigh80 or midPivotHigh75 or midPivotHigh40
    label.new(x=bar_index[1], y=k[1], text="SELL", yloc=yloc.price, color=#FFFFFF, textcolor=color.red, style=label.style_label_down, size=size.small)

// 
if kPivotLow80 or midPivotLow75 or midPivotLow40 or kPivotLow20
    label.new(x=bar_index[1], y=k[1], text="BUY", yloc=yloc.price, color=#14b105, textcolor=color.white, style=label.style_label_up, size=size.small)

// --- ORIGINALITY AND ALARM SYSTEM ADDITION ---
 
isSellSignal = kPivotHigh80 or midPivotHigh75 or midPivotHigh40
isBuySignal  = kPivotLow80 or midPivotLow75 or midPivotLow40 or kPivotLow20

// 1. Classic Alert Condition (For separate setup)
alertcondition(isBuySignal,  title="Super Stochastic BUY",  message="Stochastic Alım Sinyali: {{ticker}} - Fiyat: {{close}}")
alertcondition(isSellSignal, title="Super Stochastic SELL", message="Stochastic Satış Sinyali: {{ticker}} - Fiyat: {{close}}")

// 2. Dynamic Alert Function (To set a single alarm and monitor everything)
if isBuySignal
    alert("BUY Sinyali Oluştu! Ticker: " + syminfo.ticker + " Seviye: " + str.tostring(k, "#.##"), alert.freq_once_per_bar_close)

if isSellSignal
    alert("SELL Sinyali Oluştu! Ticker: " + syminfo.ticker + " Seviye: " + str.tostring(k, "#.##"), alert.freq_once_per_bar_close)

// plotshape(isBuySignal,  title="Buy Icon",  location=location.bottom, style=shape.triangleup, color=color.green, size=size.tiny)
// plotshape(isSellSignal, title="Sell Icon", location=location.top,    style=shape.triangledown, color=color.red, size=size.tiny)
