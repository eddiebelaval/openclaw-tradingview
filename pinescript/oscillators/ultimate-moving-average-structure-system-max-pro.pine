//@version=6
indicator("Ultimate MA Structure System MAX", shorttitle="MA Structure MAX", overlay=true)

//——————————————————————
// MASTER SWITCH
//——————————————————————
master = input.bool(true,"MASTER VISUAL SWITCH")

// Feature toggles
showMarkers   = input.bool(true,"MA Offset Markers")
showCross     = input.bool(true,"Golden / Death Cross")
showBg        = input.bool(true,"Trend Background")
showPanel     = input.bool(true,"Info Panel")
showSR        = input.bool(true,"Support / Resistance")
showChannel   = input.bool(true,"Trend Channel")

//——————————————————————
// MOVING AVERAGES
//——————————————————————
sma20  = ta.sma(close,20)
sma60  = ta.sma(close,60)
sma120 = ta.sma(close,120)

ema20  = ta.ema(close,20)
ema60  = ta.ema(close,60)
ema120 = ta.ema(close,120)

plot(sma20,color=color.black,linewidth=2,title="SMA20")
plot(ema20,color=color.new(color.black,60))
plot(sma60,color=color.blue,linewidth=2,title="SMA60")
plot(ema60,color=color.new(color.blue,60))
plot(sma120,color=color.purple,linewidth=2,title="SMA120")
plot(ema120,color=color.new(color.purple,60))

//——————————————————————
// ATR FOR OFFSETS
//——————————————————————
atr = ta.atr(14)
offset = atr*0.6

//——————————————————————
// DECLARE VAR OBJECTS
//——————————————————————
var label m20 = label.new(na,na)
var label m60 = label.new(na,na)
var label m120 = label.new(na,na)
var label trendLabel = label.new(na,na)
var label p20 = label.new(na,na)
var label p60 = label.new(na,na)
var label p120 = label.new(na,na)
var table panel = table.new(position.top_right,1,1)

//——————————————————————
// MA OFFSET MARKERS
//——————————————————————
if master and showMarkers
    moveBar = input.int(0,"Move Bar")
    x20  = input.int(20,"X20 Offset")+moveBar
    x60  = input.int(60,"X60 Offset")+moveBar
    x120 = input.int(120,"X120 Offset")+moveBar

    if barstate.islast
        label.set_xy(m20,bar_index-x20,low[20]-offset)
        label.set_text(m20,"20MA")
        label.set_style(m20,label.style_label_up)
        label.set_color(m20,color.black)
        label.set_textcolor(m20,color.white)

        label.set_xy(m60,bar_index-x60,low[60]-offset)
        label.set_text(m60,"60MA")
        label.set_style(m60,label.style_label_up)
        label.set_color(m60,color.blue)
        label.set_textcolor(m60,color.white)

        label.set_xy(m120,bar_index-x120,low[120]-offset)
        label.set_text(m120,"120MA")
        label.set_style(m120,label.style_label_up)
        label.set_color(m120,color.purple)
        label.set_textcolor(m120,color.white)

//——————————————————————
// GOLDEN / DEATH CROSS
//——————————————————————
golden = ta.crossover(sma20,sma60)
death  = ta.crossunder(sma20,sma60)

plotshape(master and showCross and golden,
 location=location.belowbar,
 color=color.green,
 style=shape.triangleup,
 size=size.small)

plotshape(master and showCross and death,
 location=location.abovebar,
 color=color.red,
 style=shape.triangledown,
 size=size.small)

//——————————————————————
// TREND STRUCTURE
//——————————————————————
bullStack = sma20>sma60 and sma60>sma120
bearStack = sma20<sma60 and sma60<sma120

bgcolor(master and showBg and bullStack ? color.new(color.green,92):na)
bgcolor(master and showBg and bearStack ? color.new(color.red,92):na)

//——————————————————————
// TREND STRENGTH
//——————————————————————
slope20 = sma20 - sma20[5]
slope60 = sma60 - sma60[5]

trendScore =
 bullStack ? 80 :
 bearStack ? 20 :
 slope20>0 ? 60 :
 slope20<0 ? 40 :
 50

//——————————————————————
// MARKET PHASE
//——————————————————————
phase =
 bullStack ? "Markup" :
 bearStack ? "Markdown" :
 math.abs(slope20)<atr*0.02 ? "Accumulation" :
 "Distribution"

//——————————————————————
// SUPPORT / RESISTANCE
//——————————————————————
ph = ta.pivothigh(high,5,5)
pl = ta.pivotlow(low,5,5)

plot(master and showSR ? ph : na,
 style=plot.style_circles,
 color=color.red)

plot(master and showSR ? pl : na,
 style=plot.style_circles,
 color=color.green)

//——————————————————————
// TREND CHANNEL
//——————————————————————
basis = ta.linreg(close,50,0)
dev = ta.stdev(close,50)

upper = basis + dev
lower = basis - dev

plot(master and showChannel ? upper:na,color=color.gray)
plot(master and showChannel ? lower:na,color=color.gray)

//——————————————————————
// TREND LABEL
//——————————————————————
if master and barstate.islast
    if showPanel
        trendTxt =
         bullStack ? "Strong Bull Trend" :
         bearStack ? "Strong Bear Trend" :
         "Neutral"

        label.set_xy(trendLabel,bar_index,high+atr)
        label.set_text(trendLabel,trendTxt)
        label.set_style(trendLabel,label.style_label_left)
        label.set_color(trendLabel,color.black)
        label.set_textcolor(trendLabel,color.white)

//——————————————————————
// MA PRICE TAGS
//——————————————————————
if master and barstate.islast
    if showMarkers
        label.set_xy(p20,bar_index,sma20)
        label.set_text(p20,"20MA")

        label.set_xy(p60,bar_index,sma60)
        label.set_text(p60,"60MA")

        label.set_xy(p120,bar_index,sma120)
        label.set_text(p120,"120MA")

//——————————————————————
// INFO PANEL
//——————————————————————
if master and showPanel and barstate.islast
    info =
     "MA STRUCTURE\n"+
     "Trend Score: "+str.tostring(trendScore)+"\n"+
     "Market Phase: "+phase

    table.cell(panel,0,0,
     info,
     text_color=color.white,
     bgcolor=color.black)
