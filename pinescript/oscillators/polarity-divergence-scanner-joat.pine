//@version=6
indicator("Polarity Divergence Scanner [JOAT]", shorttitle="PDS [JOAT]", overlay=false, max_bars_back=500, max_labels_count=100)

// ═══════════════════════════════════════════════════════════════════════════════
// POLARITY DIVERGENCE SCANNER [JOAT] - Advanced Market Polarity Detection System
// Measures bullish/bearish pressure across price, volume, momentum, and volatility
// Detects polarity shifts, divergences, and pressure extremes with visual heatmaps
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════

// Polarity Core Settings
polarityGroup = "Polarity Core"
polarityLength = input.int(14, "Polarity Period", minval=5, maxval=50, group=polarityGroup, tooltip="Base period for polarity calculations")
smoothing = input.int(3, "Smoothing", minval=1, maxval=10, group=polarityGroup, tooltip="Smoothing factor for polarity waves")
sensitivity = input.float(1.5, "Sensitivity", minval=0.5, maxval=3.0, step=0.1, group=polarityGroup, tooltip="Signal sensitivity multiplier")

// Divergence Detection
divGroup = "Divergence Detection"
lookbackPivot = input.int(5, "Pivot Lookback", minval=3, maxval=15, group=divGroup, tooltip="Bars to look back for pivot detection")
minDivStrength = input.float(60.0, "Min Divergence Strength", minval=30, maxval=100, step=5, group=divGroup, tooltip="Minimum polarity strength for divergence signals")

// Visual Settings
visualGroup = "Visual Settings"
showPolarityWaves = input.bool(true, "Show Polarity Waves", group=visualGroup)
showPressureZones = input.bool(true, "Show Pressure Zones", group=visualGroup)
showDivergenceMarkers = input.bool(true, "Show Divergence Markers", group=visualGroup)
showPolarityShifts = input.bool(true, "Show Polarity Shifts", group=visualGroup)

// Color Scheme - Unique Polarity Gradient Palette
colorGroup = "Color Scheme"
bullColor = input.color(#00FFC8, "Bullish Polarity", inline="bull", group=colorGroup, tooltip="Cyan-Teal gradient for bullish pressure")
bearColor = input.color(#FF1744, "Bearish Polarity", inline="bear", group=colorGroup, tooltip="Crimson-Red gradient for bearish pressure")
neutralColor = input.color(#7C4DFF, "Neutral Zone", inline="neutral", group=colorGroup, tooltip="Deep purple for equilibrium state")
extremeColor = input.color(#FFD600, "Extreme Pressure", inline="extreme", group=colorGroup, tooltip="Golden yellow for extreme conditions")
accentColor = input.color(#00E5FF, "Accent Signals", inline="accent", group=colorGroup, tooltip="Electric blue for key signals")

// ═══════════════════════════════════════════
// POLARITY CORE CALCULATIONS
// ═══════════════════════════════════════════

// Price Polarity - Measures directional pressure from price action
priceChange = close - close[polarityLength]
priceRange = ta.highest(high, polarityLength) - ta.lowest(low, polarityLength)
pricePolarity = priceRange > 0 ? (priceChange / priceRange) * 100 : 0
smoothPricePolarity = ta.ema(pricePolarity, smoothing)

// Volume Polarity - Measures buying vs selling pressure
bullVolume = close > open ? volume : 0
bearVolume = close < open ? volume : 0
totalVolume = ta.sma(volume, polarityLength)
volumePolarity = totalVolume > 0 ? ((ta.sma(bullVolume, polarityLength) - ta.sma(bearVolume, polarityLength)) / totalVolume) * 100 : 0
smoothVolumePolarity = ta.ema(volumePolarity, smoothing)

// Momentum Polarity - Measures acceleration of price movement
rsi = ta.rsi(close, polarityLength)
rsiPolarity = (rsi - 50) * 2  // Scale -100 to +100
macd = ta.ema(close, 12) - ta.ema(close, 26)
macdSignal = ta.ema(macd, 9)
macdHist = macd - macdSignal
macdNormalized = ta.stdev(macdHist, polarityLength) > 0 ? (macdHist / ta.stdev(macdHist, polarityLength)) * 30 : 0
momentumPolarity = (rsiPolarity + macdNormalized) / 2
smoothMomentumPolarity = ta.ema(momentumPolarity, smoothing)

// Volatility Polarity - Measures expansion vs contraction pressure
atr = ta.atr(polarityLength)
atrChange = atr - atr[polarityLength]
atrAvg = ta.sma(atr, polarityLength)
volatilityPolarity = atrAvg > 0 ? (atrChange / atrAvg) * 100 : 0
smoothVolatilityPolarity = ta.ema(volatilityPolarity, smoothing)

// ═══════════════════════════════════════════
// COMPOSITE POLARITY INDEX
// ═══════════════════════════════════════════

// Weighted composite of all polarity dimensions
compositePolarityRaw = (smoothPricePolarity * 0.35) + (smoothVolumePolarity * 0.25) + (smoothMomentumPolarity * 0.30) + (smoothVolatilityPolarity * 0.10)
compositePolarity = ta.ema(compositePolarityRaw, smoothing) * sensitivity

// Polarity strength (absolute value)
polarityStrength = math.abs(compositePolarity)

// Polarity direction
polarityBullish = compositePolarity > 0
polarityBearish = compositePolarity < 0

// ═══════════════════════════════════════════
// PRESSURE ZONES & EXTREMES
// ═══════════════════════════════════════════

// Define pressure zones
extremeBullZone = compositePolarity >= 70
strongBullZone = compositePolarity >= 40 and compositePolarity < 70
weakBullZone = compositePolarity > 0 and compositePolarity < 40
neutralZone = compositePolarity == 0
weakBearZone = compositePolarity < 0 and compositePolarity > -40
strongBearZone = compositePolarity <= -40 and compositePolarity > -70
extremeBearZone = compositePolarity <= -70

// Pressure temperature (volatility-adjusted strength)
pressureTemp = math.min((polarityStrength * (1 + math.abs(smoothVolatilityPolarity) / 100)), 100)

// ═══════════════════════════════════════════
// POLARITY SHIFT DETECTION
// ═══════════════════════════════════════════

// Detect polarity flips
polarityFlipBull = compositePolarity > 0 and compositePolarity[1] <= 0 and polarityStrength > 30
polarityFlipBear = compositePolarity < 0 and compositePolarity[1] >= 0 and polarityStrength > 30

// Detect polarity acceleration
polarityAccelBull = compositePolarity > compositePolarity[1] and compositePolarity > 50
polarityAccelBear = compositePolarity < compositePolarity[1] and compositePolarity < -50

// Detect polarity exhaustion
polarityExhaustBull = compositePolarity > 80 and compositePolarity < compositePolarity[1]
polarityExhaustBear = compositePolarity < -80 and compositePolarity > compositePolarity[1]

// ═══════════════════════════════════════════
// POLARITY DIVERGENCE DETECTION
// ═══════════════════════════════════════════

// Pivot detection for price
priceHigh = ta.pivothigh(high, lookbackPivot, lookbackPivot)
priceLow = ta.pivotlow(low, lookbackPivot, lookbackPivot)

// Pivot detection for polarity
polarityHigh = ta.pivothigh(compositePolarity, lookbackPivot, lookbackPivot)
polarityLow = ta.pivotlow(compositePolarity, lookbackPivot, lookbackPivot)

// Store pivot values
var float lastPriceHigh = na
var float lastPriceLow = na
var float lastPolarityHigh = na
var float lastPolarityLow = na
var int lastPriceHighBar = na
var int lastPriceLowBar = na

if not na(priceHigh)
    lastPriceHigh := high[lookbackPivot]
    lastPriceHighBar := bar_index - lookbackPivot
    lastPolarityHigh := compositePolarity[lookbackPivot]

if not na(priceLow)
    lastPriceLow := low[lookbackPivot]
    lastPriceLowBar := bar_index - lookbackPivot
    lastPolarityLow := compositePolarity[lookbackPivot]

// Bullish Polarity Divergence: Price makes lower low, Polarity makes higher low
bullishDivergence = false
bullDivStrength = 0.0
if not na(priceLow) and not na(lastPriceLow)
    if low[lookbackPivot] < lastPriceLow and compositePolarity[lookbackPivot] > lastPolarityLow
        bullishDivergence := true
        bullDivStrength := math.abs(compositePolarity[lookbackPivot])

// Bearish Polarity Divergence: Price makes higher high, Polarity makes lower high
bearishDivergence = false
bearDivStrength = 0.0
if not na(priceHigh) and not na(lastPriceHigh)
    if high[lookbackPivot] > lastPriceHigh and compositePolarity[lookbackPivot] < lastPolarityHigh
        bearishDivergence := true
        bearDivStrength := math.abs(compositePolarity[lookbackPivot])

// Filter divergences by minimum strength
validBullDiv = bullishDivergence and bullDivStrength >= minDivStrength
validBearDiv = bearishDivergence and bearDivStrength >= minDivStrength

// ═══════════════════════════════════════════
// POLARITY WAVE VISUALIZATION
// ═══════════════════════════════════════════

// Advanced gradient coloring for composite polarity wave
polarityColor = compositePolarity >= 80 ? color.from_gradient(compositePolarity, 80, 100, color.new(bullColor, 0), color.new(extremeColor, 0)) : compositePolarity >= 70 ? color.new(bullColor, 0) : compositePolarity >= 40 ? color.from_gradient(compositePolarity, 40, 70, color.new(bullColor, 40), color.new(bullColor, 10)) : compositePolarity > 0 ? color.from_gradient(compositePolarity, 0, 40, color.new(neutralColor, 60), color.new(bullColor, 50)) : compositePolarity <= -80 ? color.from_gradient(compositePolarity, -100, -80, color.new(extremeColor, 0), color.new(bearColor, 0)) : compositePolarity <= -70 ? color.new(bearColor, 0) : compositePolarity <= -40 ? color.from_gradient(compositePolarity, -70, -40, color.new(bearColor, 10), color.new(bearColor, 40)) : color.from_gradient(compositePolarity, -40, 0, color.new(bearColor, 50), color.new(neutralColor, 60))

// Main polarity line with glow effect (triple layer)
plot(showPolarityWaves ? compositePolarity : na, "Polarity Glow", color=color.new(polarityColor, 80), linewidth=8, style=plot.style_line)
plot(showPolarityWaves ? compositePolarity : na, "Polarity Mid", color=color.new(polarityColor, 40), linewidth=4, style=plot.style_line)
plot(showPolarityWaves ? compositePolarity : na, "Composite Polarity", color=polarityColor, linewidth=2, style=plot.style_line)

// Polarity strength histogram (background layer)
strengthHistColor = compositePolarity > 0 ? color.new(bullColor, 92) : color.new(bearColor, 92)
plot(showPolarityWaves ? compositePolarity : na, "Strength Histogram", color=strengthHistColor, style=plot.style_columns)

// Individual polarity dimensions with unique colors
plot(showPolarityWaves ? smoothPricePolarity : na, "Price Polarity", color=color.new(accentColor, 50), linewidth=1, style=plot.style_line)
plot(showPolarityWaves ? smoothVolumePolarity : na, "Volume Polarity", color=color.new(#AB47BC, 50), linewidth=1, style=plot.style_line)
plot(showPolarityWaves ? smoothMomentumPolarity : na, "Momentum Polarity", color=color.new(#FF6E40, 50), linewidth=1, style=plot.style_line)

// ═══════════════════════════════════════════
// PRESSURE ZONE BACKGROUNDS
// ═══════════════════════════════════════════

// Dynamic gradient backgrounds based on polarity strength
extremeZoneBg = extremeBullZone ? color.from_gradient(compositePolarity, 70, 100, color.new(bullColor, 90), color.new(extremeColor, 85)) : extremeBearZone ? color.from_gradient(compositePolarity, -100, -70, color.new(extremeColor, 85), color.new(bearColor, 90)) : na
bgcolor(showPressureZones ? extremeZoneBg : na, title="Extreme Zones")

// Strong zones with subtle gradient
strongZoneBg = strongBullZone ? color.from_gradient(compositePolarity, 40, 70, color.new(bullColor, 94), color.new(bullColor, 90)) : strongBearZone ? color.from_gradient(compositePolarity, -70, -40, color.new(bearColor, 90), color.new(bearColor, 94)) : na
bgcolor(showPressureZones ? strongZoneBg : na, title="Strong Zones")

// Neutral zone with purple tint
neutralZoneBg = math.abs(compositePolarity) < 10 ? color.new(neutralColor, 96) : na
bgcolor(showPressureZones ? neutralZoneBg : na, title="Neutral Zone")

// ═══════════════════════════════════════════
// REFERENCE LINES & ZONES
// ═══════════════════════════════════════════

// Critical levels
hline(100, "Maximum", color=color.new(extremeColor, 50), linestyle=hline.style_solid, linewidth=1)
hline(70, "Extreme Bull", color=color.new(bullColor, 70), linestyle=hline.style_dashed)
hline(40, "Strong Bull", color=color.new(bullColor, 85), linestyle=hline.style_dotted)
hline(0, "Neutral", color=color.new(neutralColor, 50), linestyle=hline.style_solid, linewidth=2)
hline(-40, "Strong Bear", color=color.new(bearColor, 85), linestyle=hline.style_dotted)
hline(-70, "Extreme Bear", color=color.new(bearColor, 70), linestyle=hline.style_dashed)
hline(-100, "Minimum", color=color.new(extremeColor, 50), linestyle=hline.style_solid, linewidth=1)

// ═══════════════════════════════════════════
// POLARITY SHIFT SIGNALS
// ═══════════════════════════════════════════

// Track first occurrence of each signal type for text labels
var int lastAccelBullBar = -999
var int lastAccelBearBar = -999
var int lastExhaustBullBar = -999
var int lastExhaustBearBar = -999

// Determine if we should show text (only on first in sequence, with gap)
showAccelBullText = polarityAccelBull and (bar_index - lastAccelBullBar > 5)
showAccelBearText = polarityAccelBear and (bar_index - lastAccelBearBar > 5)
showExhaustBullText = polarityExhaustBull and (bar_index - lastExhaustBullBar > 5)
showExhaustBearText = polarityExhaustBear and (bar_index - lastExhaustBearBar > 5)

// Update last bar tracking
if polarityAccelBull and showAccelBullText
    lastAccelBullBar := bar_index
if polarityAccelBear and showAccelBearText
    lastAccelBearBar := bar_index
if polarityExhaustBull and showExhaustBullText
    lastExhaustBullBar := bar_index
if polarityExhaustBear and showExhaustBearText
    lastExhaustBearBar := bar_index

// Polarity flip signals (crosses zero line) - Always show text
plotshape(showPolarityShifts and polarityFlipBull, "Polarity Flip Bull", shape.circle, location.bottom, color=color.new(accentColor, 0), size=size.small, text="FLIP BULL")
plotshape(showPolarityShifts and polarityFlipBear, "Polarity Flip Bear", shape.circle, location.top, color=color.new(accentColor, 0), size=size.small, text="FLIP BEAR")

// Bullish Acceleration - ALL triangles up (green), text label separate
plotshape(showPolarityShifts and polarityAccelBull, "Acceleration Bull", shape.triangleup, location.bottom, color=color.new(bullColor, 20), size=size.tiny)
plotshape(showPolarityShifts and polarityAccelBull and showAccelBullText, "Acceleration Bull Text", shape.labelup, location.bottom, color=color.new(bullColor, 0), size=size.tiny, text="ACCEL", textcolor=color.white)

// Bearish Acceleration - ALL triangles down (red), text label separate
plotshape(showPolarityShifts and polarityAccelBear, "Acceleration Bear", shape.triangledown, location.top, color=color.new(bearColor, 20), size=size.tiny)
plotshape(showPolarityShifts and polarityAccelBear and showAccelBearText, "Acceleration Bear Text", shape.labeldown, location.top, color=color.new(bearColor, 0), size=size.tiny, text="ACCEL", textcolor=color.white)

// Bullish Exhaustion - ALL X crosses at top (yellow), text label separate
plotshape(showPolarityShifts and polarityExhaustBull, "Exhaustion Bull", shape.xcross, location.top, color=color.new(extremeColor, 0), size=size.small)
plotshape(showPolarityShifts and polarityExhaustBull and showExhaustBullText, "Exhaustion Bull Text", shape.labeldown, location.top, color=color.new(extremeColor, 0), size=size.tiny, text="EXHAUST", textcolor=color.black)

// Bearish Exhaustion - ALL X crosses at bottom (yellow), text label separate
plotshape(showPolarityShifts and polarityExhaustBear, "Exhaustion Bear", shape.xcross, location.bottom, color=color.new(extremeColor, 0), size=size.small)
plotshape(showPolarityShifts and polarityExhaustBear and showExhaustBearText, "Exhaustion Bear Text", shape.labelup, location.bottom, color=color.new(extremeColor, 0), size=size.tiny, text="EXHAUST", textcolor=color.black)

// ═══════════════════════════════════════════
// DIVERGENCE MARKERS
// ═══════════════════════════════════════════

// Bullish divergence (price down, polarity up) - Diamond markers
plotshape(showDivergenceMarkers and validBullDiv, "Bullish Divergence", shape.diamond, location.bottom, color=color.new(bullColor, 0), size=size.normal, text="BULLISH DIV")

// Bearish divergence (price up, polarity down) - Diamond markers
plotshape(showDivergenceMarkers and validBearDiv, "Bearish Divergence", shape.diamond, location.top, color=color.new(bearColor, 0), size=size.normal, text="BEARISH DIV")

// ═══════════════════════════════════════════
// POLARITY DASHBOARD
// ═══════════════════════════════════════════

var table dashboard = table.new(position.top_right, 3, 8, 
                                border_width=2, 
                                border_color=color.new(extremeColor, 30),
                                frame_width=2,
                                frame_color=color.new(extremeColor, 30))

if barstate.islast
    // Header
    table.cell(dashboard, 0, 0, "POLARITY", text_color=color.white, 
               bgcolor=color.new(extremeColor, 10), text_size=size.normal)
    table.cell(dashboard, 1, 0, "DIVERGENCE", text_color=color.white, 
               bgcolor=color.new(extremeColor, 10), text_size=size.normal)
    table.cell(dashboard, 2, 0, "SCANNER", text_color=color.white, 
               bgcolor=color.new(extremeColor, 10), text_size=size.normal)
    
    // Composite Polarity
    polarityValue = str.tostring(math.round(compositePolarity))
    polarityStatus = extremeBullZone ? "EXTREME↑" : strongBullZone ? "STRONG↑" : weakBullZone ? "WEAK↑" : extremeBearZone ? "EXTREME↓" : strongBearZone ? "STRONG↓" : weakBearZone ? "WEAK↓" : "NEUTRAL"
    polarityDashColor = extremeBullZone or extremeBearZone ? color.new(extremeColor, 20) : strongBullZone ? color.new(bullColor, 30) : strongBearZone ? color.new(bearColor, 30) : weakBullZone ? color.new(bullColor, 60) : weakBearZone ? color.new(bearColor, 60) : color.new(neutralColor, 70)
    
    table.cell(dashboard, 0, 1, "Polarity", text_color=color.white, 
               bgcolor=color.new(color.gray, 70), text_size=size.tiny)
    table.cell(dashboard, 1, 1, polarityValue, text_color=color.white, 
               bgcolor=polarityDashColor, text_size=size.large)
    table.cell(dashboard, 2, 1, polarityStatus, text_color=color.white, 
               bgcolor=polarityDashColor, text_size=size.tiny)
    
    // Polarity Strength
    strengthValue = str.tostring(math.round(polarityStrength))
    strengthStatus = polarityStrength >= 70 ? "EXTREME" : polarityStrength >= 40 ? "STRONG" : polarityStrength >= 20 ? "MODERATE" : "WEAK"
    strengthColor = polarityStrength >= 70 ? color.new(extremeColor, 20) : polarityStrength >= 40 ? color.new(extremeColor, 50) : color.new(color.gray, 70)
    
    table.cell(dashboard, 0, 2, "Strength", text_color=color.white, 
               bgcolor=color.new(color.gray, 70), text_size=size.tiny)
    table.cell(dashboard, 1, 2, strengthValue, text_color=color.white, 
               bgcolor=strengthColor, text_size=size.large)
    table.cell(dashboard, 2, 2, strengthStatus, text_color=color.white, 
               bgcolor=strengthColor, text_size=size.tiny)
    
    // Pressure Temperature
    tempValue = str.tostring(math.round(pressureTemp)) + "°"
    tempStatus = pressureTemp >= 70 ? "HOT" : pressureTemp >= 40 ? "WARM" : "COLD"
    tempColor = color.from_gradient(pressureTemp, 0, 100, color.new(color.blue, 70), color.new(color.red, 20))
    
    table.cell(dashboard, 0, 3, "Pressure", text_color=color.white, 
               bgcolor=color.new(color.gray, 70), text_size=size.tiny)
    table.cell(dashboard, 1, 3, tempValue, text_color=color.white, 
               bgcolor=tempColor, text_size=size.large)
    table.cell(dashboard, 2, 3, tempStatus, text_color=color.white, 
               bgcolor=tempColor, text_size=size.tiny)
    
    // Price Polarity Component
    pricePolValue = str.tostring(math.round(smoothPricePolarity))
    table.cell(dashboard, 0, 4, "Price", text_color=color.white, 
               bgcolor=color.new(color.gray, 70), text_size=size.tiny)
    table.cell(dashboard, 1, 4, pricePolValue, text_color=color.white, 
               bgcolor=smoothPricePolarity > 0 ? color.new(bullColor, 50) : color.new(bearColor, 50), 
               text_size=size.small)
    table.cell(dashboard, 2, 4, smoothPricePolarity > 0 ? "BULL" : "BEAR", text_color=color.white, 
               bgcolor=smoothPricePolarity > 0 ? color.new(bullColor, 50) : color.new(bearColor, 50), 
               text_size=size.tiny)
    
    // Volume Polarity Component
    volPolValue = str.tostring(math.round(smoothVolumePolarity))
    table.cell(dashboard, 0, 5, "Volume", text_color=color.white, 
               bgcolor=color.new(color.gray, 70), text_size=size.tiny)
    table.cell(dashboard, 1, 5, volPolValue, text_color=color.white, 
               bgcolor=smoothVolumePolarity > 0 ? color.new(bullColor, 50) : color.new(bearColor, 50), 
               text_size=size.small)
    table.cell(dashboard, 2, 5, smoothVolumePolarity > 0 ? "BULL" : "BEAR", text_color=color.white, 
               bgcolor=smoothVolumePolarity > 0 ? color.new(bullColor, 50) : color.new(bearColor, 50), 
               text_size=size.tiny)
    
    // Momentum Polarity Component
    momPolValue = str.tostring(math.round(smoothMomentumPolarity))
    table.cell(dashboard, 0, 6, "Momentum", text_color=color.white, 
               bgcolor=color.new(color.gray, 70), text_size=size.tiny)
    table.cell(dashboard, 1, 6, momPolValue, text_color=color.white, 
               bgcolor=smoothMomentumPolarity > 0 ? color.new(bullColor, 50) : color.new(bearColor, 50), 
               text_size=size.small)
    table.cell(dashboard, 2, 6, smoothMomentumPolarity > 0 ? "BULL" : "BEAR", text_color=color.white, 
               bgcolor=smoothMomentumPolarity > 0 ? color.new(bullColor, 50) : color.new(bearColor, 50), 
               text_size=size.tiny)
    
    // Signal Status
    signalText = validBullDiv ? "BULL DIV" : validBearDiv ? "BEAR DIV" : polarityFlipBull ? "FLIP↑" : polarityFlipBear ? "FLIP↓" : polarityExhaustBull ? "EXHAUST↑" : polarityExhaustBear ? "EXHAUST↓" : polarityAccelBull ? "ACCEL↑" : polarityAccelBear ? "ACCEL↓" : "WAIT"
    
    signalColor = validBullDiv or polarityFlipBull ? color.new(bullColor, 10) : validBearDiv or polarityFlipBear ? color.new(bearColor, 10) : polarityExhaustBull or polarityExhaustBear ? color.new(extremeColor, 20) : polarityAccelBull ? color.new(bullColor, 40) : polarityAccelBear ? color.new(bearColor, 40) : color.new(color.gray, 80)
    
    table.cell(dashboard, 0, 7, "Signal", text_color=color.white, 
               bgcolor=color.new(color.gray, 70), text_size=size.tiny)
    table.cell(dashboard, 1, 7, signalText, text_color=color.white, 
               bgcolor=signalColor, text_size=size.normal)
    table.cell(dashboard, 2, 7, "", text_color=color.white, 
               bgcolor=signalColor, text_size=size.tiny)



// ═══════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════

alertcondition(validBullDiv, "Bullish Polarity Divergence", 
               "POLARITY DIVERGENCE: Price declining but polarity strengthening - Potential reversal up!")
alertcondition(validBearDiv, "Bearish Polarity Divergence", 
               "POLARITY DIVERGENCE: Price rising but polarity weakening - Potential reversal down!")
alertcondition(polarityFlipBull, "Polarity Flip Bullish", 
               "POLARITY FLIP: Market polarity shifted from bearish to bullish!")
alertcondition(polarityFlipBear, "Polarity Flip Bearish", 
               "POLARITY FLIP: Market polarity shifted from bullish to bearish!")
alertcondition(polarityExhaustBull, "Bullish Exhaustion", 
               "EXHAUSTION WARNING: Extreme bullish polarity showing weakness - Watch for reversal!")
alertcondition(polarityExhaustBear, "Bearish Exhaustion", 
               "EXHAUSTION WARNING: Extreme bearish polarity showing weakness - Watch for reversal!")
alertcondition(extremeBullZone, "Extreme Bullish Pressure", 
               "EXTREME PRESSURE: Polarity in extreme bullish zone (>70) - Overbought conditions!")
alertcondition(extremeBearZone, "Extreme Bearish Pressure", 
               "EXTREME PRESSURE: Polarity in extreme bearish zone (<-70) - Oversold conditions!")
alertcondition(polarityAccelBull, "Bullish Acceleration", 
               "ACCELERATION: Bullish polarity accelerating rapidly - Strong momentum!")
alertcondition(polarityAccelBear, "Bearish Acceleration", 
               "ACCELERATION: Bearish polarity accelerating rapidly - Strong momentum!")
