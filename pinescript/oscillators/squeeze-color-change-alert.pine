//@version=6
indicator("Squeeze Color Change Alert", overlay=false)

// --- Squeeze base settings ---
length  = 20
multBB  = 2.0
multKC  = 1.5

source  = close
basis   = ta.sma(source, length)
dev     = multBB * ta.stdev(source, length)
upperBB = basis + dev
lowerBB = basis - dev

rangeLen = ta.highest(high, length) - ta.lowest(low, length)
maRange  = ta.sma(rangeLen, length)
upperKC  = basis + maRange * multKC
lowerKC  = basis - maRange * multKC

sqzOn  = (lowerBB > lowerKC) and (upperBB < upperKC)
sqzOff = (lowerBB < lowerKC) and (upperBB > upperKC)

// You can adjust this to match your preferred Squeeze formula
val  = ta.linreg(source - ta.sma(source, length), length, 0)
hist = val

// --- Color logic (LazyBear-style) ---
isIncreasing = hist > hist[1]
isDecreasing = hist < hist[1]

colorCode =
     hist > 0 and isIncreasing ? 1 :   // light green
     hist > 0 and isDecreasing ? 2 :   // dark green
     hist < 0 and isDecreasing ? 3 :   // dark red
     hist < 0 and isIncreasing ? 4 :   // light red
     0

// --- Detect color change on confirmed bar ---
colorChanged = colorCode != colorCode[1]

// --- Alert condition ---
alertcondition(
     colorChanged,
     title   = "Squeeze Color Change",
     message = "Squeeze Momentum bar changed color on confirmed bar"
)

// --- Plot ---
plot(hist, color=color.white)
