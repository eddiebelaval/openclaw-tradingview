//@version=5
indicator("AVANTI MASTER PRO FINAL", overlay=true)

//================ AUTO INSTRUMENT =================
string instrument = "NIFTY"

if str.contains(syminfo.ticker,"NIFTY")
    instrument := "NIFTY"
else if str.contains(syminfo.ticker,"CRUDE")
    instrument := "CRUDE"
else if str.contains(syminfo.ticker,"NATURALGAS")
    instrument := "NATURAL GAS"
else
    instrument := "OPTION"

rsiLen = input.int(14,"RSI Length")

//================ EMA =================
ema9 = ta.ema(close,9)
ema30 = ta.ema(close,30)
ema200 = ta.ema(close,200)

plot(ema9,color=color.blue)
plot(ema30,color=color.yellow)
plot(ema200,color=color.green,linewidth=2)

//================ RSI =================
rsiVal = ta.rsi(close,rsiLen)
rsi_round = math.round(rsiVal)

rsiColor =
 rsiVal > 55 ? color.green :
 rsiVal < 45 ? color.red :
 color.gray

//================ ADX =================
[plusDI, minusDI, adx] = ta.dmi(14,14)
adx_round = math.round(adx)

adxColor =
 adx > 25 ? color.blue :
 adx > 20 ? color.orange :
 color.gray

//================ BUILDUP =================
price_up = close > close[1]
price_down = close < close[1]

vol_up = volume > volume[1]
vol_down = volume < volume[1]

string buildup="Neutral"
color buildup_col=color.gray

if price_up and vol_up
    buildup := "Long Buildup"
    buildup_col := color.green
else if price_down and vol_up
    buildup := "Short Buildup"
    buildup_col := color.red
else if price_up and vol_down
    buildup := "Short Covering"
    buildup_col := color.blue
else if price_down and vol_down
    buildup := "Long Unwinding"
    buildup_col := color.orange

//================ SMART MONEY =================
smartLong = price_up and volume > volume[1]*1.5
smartShort = price_down and volume > volume[1]*1.5

//================ BREAKOUT SCORE =================
scoreBull = 0
scoreBull += ema9>ema30 ? 20 : 0
scoreBull += close>ema200 ? 15 : 0
scoreBull += rsiVal>55 ? 15 : 0
scoreBull += smartLong ? 25 : 0
scoreBull += buildup=="Long Buildup" ? 15 : 0
scoreBull += close>high[1] ? 10 : 0

scoreBear = 0
scoreBear += ema9<ema30 ? 20 : 0
scoreBear += close<ema200 ? 15 : 0
scoreBear += rsiVal<45 ? 15 : 0
scoreBear += smartShort ? 25 : 0
scoreBear += buildup=="Short Buildup" ? 15 : 0
scoreBear += close<low[1] ? 10 : 0

breakoutPerc = scoreBull
breakdownPerc = scoreBear

//================ MTF TREND FILTER =================

ema9_5 = request.security(syminfo.tickerid,"5", ta.ema(close,9))
ema30_5 = request.security(syminfo.tickerid,"5", ta.ema(close,30))

ema9_15 = request.security(syminfo.tickerid,"15", ta.ema(close,9))
ema30_15 = request.security(syminfo.tickerid,"15", ta.ema(close,30))

trendUp = ema9_5 > ema30_5 and ema9_15 > ema30_15
trendDown = ema9_5 < ema30_5 and ema9_15 < ema30_15

//================ SIGNAL =================
var int lastSignal = 0

buySignal =
 close>ema30 and
 close>high[1] and
 rsiVal>55 and
 breakoutPerc>breakdownPerc and
 trendUp and
 adx > 25 and
 lastSignal<=0

sellSignal =
 close<ema30 and
 close<low[1] and
 rsiVal<45 and
 breakdownPerc>breakoutPerc and
 trendDown and
 adx > 25 and
 lastSignal>=0

if buySignal
    lastSignal := 1
if sellSignal
    lastSignal := -1

//================ TARGETS =================

var float entry = na
var float tp1 = na
var float tp2 = na
var float tp3 = na
var float slv = na

if buySignal or sellSignal

    entry := math.round(close)

    if instrument == "NIFTY"
        tp1 := entry + 15
        tp2 := entry + 22.5
        tp3 := entry + 30
        slv := entry - 7.5

    if instrument == "OPTION"
        tp1 := entry + 5
        tp2 := entry + 10
        tp3 := entry + 15
        slv := entry - 3.75

    if instrument == "CRUDE"
        tp1 := entry + 10
        tp2 := entry + 15
        tp3 := entry + 20
        slv := entry - 5

    if instrument == "NATURAL GAS"
        tp1 := entry + 2
        tp2 := entry + 3
        tp3 := entry + 4
        slv := entry - 1

    if sellSignal
        tp1 := entry - (tp1-entry)
        tp2 := entry - (tp2-entry)
        tp3 := entry - (tp3-entry)
        slv := entry + (entry - slv)

//================ CLEAN OLD =================
var line lEntry = na
var line lSL = na
var line lTP1 = na
var line lTP2 = na
var line lTP3 = na

var label lbEntry = na
var label lbSL = na
var label lbTP1 = na
var label lbTP2 = na
var label lbTP3 = na

lineBars = 15

if buySignal or sellSignal

    line.delete(lEntry)
    line.delete(lSL)
    line.delete(lTP1)
    line.delete(lTP2)
    line.delete(lTP3)

    label.delete(lbEntry)
    label.delete(lbSL)
    label.delete(lbTP1)
    label.delete(lbTP2)
    label.delete(lbTP3)

    lEntry := line.new(bar_index,entry,bar_index+lineBars,entry,color=color.gray)
    lSL := line.new(bar_index,slv,bar_index+lineBars,slv,color=color.red,width=2)

    lTP1 := line.new(bar_index,tp1,bar_index+lineBars,tp1,color=color.green)
    lTP2 := line.new(bar_index,tp2,bar_index+lineBars,tp2,color=color.green)
    lTP3 := line.new(bar_index,tp3,bar_index+lineBars,tp3,color=color.green)

    lbEntry := label.new(bar_index+lineBars,entry,"ENTRY "+str.tostring(entry),
     style=label.style_label_left,color=color.gray,textcolor=color.white)

    lbSL := label.new(bar_index+lineBars,slv,"SL "+str.tostring(slv),
     style=label.style_label_left,color=color.red,textcolor=color.white)

    lbTP1 := label.new(bar_index+lineBars,tp1,"TP1 "+str.tostring(tp1),
     style=label.style_label_left,color=color.green,textcolor=color.white)

    lbTP2 := label.new(bar_index+lineBars,tp2,"TP2 "+str.tostring(tp2),
     style=label.style_label_left,color=color.green,textcolor=color.white)

    lbTP3 := label.new(bar_index+lineBars,tp3,"TP3 "+str.tostring(tp3),
     style=label.style_label_left,color=color.green,textcolor=color.white)


//================ DASHBOARD =================
var table dash = table.new(position.top_right,2,14,border_width=1)

trendText =
 ema9 > ema30 ? "UP TREND" :
 ema9 < ema30 ? "DOWN TREND" :
 "SIDEWAYS"

trendColor =
 ema9 > ema30 ? color.green :
 ema9 < ema30 ? color.red :
 color.gray

trendStrength =
 adx > 35 ? "Strong Trend" :
 adx > 25 ? "Moderate Trend" :
 "Weak Trend"

tradeZone =
 ema9>ema30 ? "BUY ZONE" :
 ema9<ema30 ? "SELL ZONE" :
 "WAIT"



//================ SIGNAL STRENGTH =================

strongBuySignal =
 ema9 > ema30 and
 breakoutPerc > 55 and
 rsiVal > 55 and
 adx > 25

strongSellSignal =
 ema9 < ema30 and
 breakdownPerc > 55 and
 rsiVal < 45 and
 adx > 25

signalText =
 strongBuySignal ? "STRONG BUY" :
 strongSellSignal ? "STRONG SELL" :
 "WAIT"

signalColor =
 strongBuySignal ? color.green :
 strongSellSignal ? color.red :
 color.gray

tradeColor =
 tradeZone == "BUY ZONE" ? color.green :
 tradeZone == "SELL ZONE" ? color.red :
 color.gray

if barstate.islast

    table.cell(dash,0,0,"Timeframe",text_color=color.white)
    table.cell(dash,1,0,"Trend Status",text_color=color.white)

    table.cell(dash,0,1,"5 Min",text_color=color.white)
    table.cell(dash,1,1,trendText,bgcolor=trendColor,text_color=color.white)

    table.cell(dash,0,2,"15 Min",text_color=color.white)
    table.cell(dash,1,2,trendText,bgcolor=trendColor,text_color=color.white)

    table.cell(dash,0,3,"1 Hour",text_color=color.white)
    table.cell(dash,1,3,trendText,bgcolor=trendColor,text_color=color.white)

    table.cell(dash,0,4,"4 Hour",text_color=color.white)
    table.cell(dash,1,4,trendText,bgcolor=trendColor,text_color=color.white)

    table.cell(dash,0,5,"Buildup",text_color=color.white)
    table.cell(dash,1,5,buildup,bgcolor=buildup_col,text_color=color.white)

    table.cell(dash,0,6,"RSI",text_color=color.white)
    table.cell(dash,1,6,str.tostring(rsi_round),bgcolor=rsiColor,text_color=color.white)

    table.cell(dash,0,7,"Breakout %",text_color=color.white)
    table.cell(dash,1,7,str.tostring(breakoutPerc)+" %",bgcolor=color.green,text_color=color.white)

    table.cell(dash,0,8,"Breakdown %",text_color=color.white)
    table.cell(dash,1,8,str.tostring(breakdownPerc)+" %",bgcolor=color.red,text_color=color.white)

    table.cell(dash,0,9,"ADX",text_color=color.white)
    table.cell(dash,1,9,str.tostring(adx_round),bgcolor=adxColor,text_color=color.white)

    table.cell(dash,0,10,"Trend Strength",text_color=color.white)
    table.cell(dash,1,10,trendStrength,bgcolor=color.orange,text_color=color.white)

    table.cell(dash,0,11,"Trade Zone",text_color=color.white)
    table.cell(dash,1,11,tradeZone,bgcolor=tradeColor,text_color=color.white)

    table.cell(dash,0,12,"Signal Strength",text_color=color.white)
    table.cell(dash,1,12,signalText,bgcolor=signalColor,text_color=color.white)
