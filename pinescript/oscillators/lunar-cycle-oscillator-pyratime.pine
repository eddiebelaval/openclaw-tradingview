//@version=5
indicator("Lunar Cycle Oscillator V1.0", overlay=false)

// --- USER INPUTS ---
grp_visuals = "Visual Settings"
showQuarterMoons = input.bool(true, title="Show Quarter Moon Markers", group=grp_visuals)
showBgShading    = input.bool(true, title="Show Waxing/Waning Background", group=grp_visuals)
showTable        = input.bool(true, title="Show Lunar Data Table", group=grp_visuals)

// --- LUNAR CONSTANTS ---
var float SYNODIC_MONTH = 2551442841.6
var float KNOWN_NEW_MOON = 1704974220000

// --- PHASE CALCULATION ---
float phase = ((time - KNOWN_NEW_MOON) % SYNODIC_MONTH) / SYNODIC_MONTH

if phase < 0
    phase += 1

// --- OSCILLATOR CONVERSION ---
float lunarWave = math.sin((phase - 0.25) * 2 * math.pi)

// --- WAXING/WANING BACKGROUND SHADING ---
// Waxing (Growing) = Cyan/Aqua tint | Waning (Shrinking) = Dark Navy tint
bool isWaxing = phase < 0.5
bgcolor(showBgShading ? (isWaxing ? color.new(color.aqua, 95) : color.new(#0a192f, 90)) : na, title="Phase Background")

// --- NEON GLOW PLOTTING (Silver/Grey, Half Thickness) ---
plot(lunarWave, color=color.new(color.gray, 80), linewidth=4, title="Glow Outer")
plot(lunarWave, color=color.new(color.silver, 60), linewidth=2, title="Glow Inner")
plot(lunarWave, color=color.new(color.white, 0), linewidth=1, title="Lunar Wave Core")

hline(0, color=color.new(color.gray, 60), linestyle=hline.style_dotted)

// --- TRIGGERS ---
bool fullMoonTrigger     = phase >= 0.5 and phase[1] < 0.5
bool newMoonTrigger      = phase < 0.1 and phase[1] > 0.9 
bool firstQuarterTrigger = phase >= 0.25 and phase[1] < 0.25
bool thirdQuarterTrigger = phase >= 0.75 and phase[1] < 0.75

// --- PULSE MARKERS & INTERSECTIONS ---
// Drawn exactly at UNIX timestamps to ensure they lock to the chart
if fullMoonTrigger
    line.new(x1=time, y1=-1.2, x2=time, y2=1.2, xloc=xloc.bar_time, color=color.new(#FFD700, 20), width=2, style=line.style_solid) // Gold
    label.new(x=time, y=1.2, text="🌕", xloc=xloc.bar_time, color=color.new(color.black, 100), textcolor=color.new(#FFD700, 0), style=label.style_label_down, size=size.small)

if newMoonTrigger
    line.new(x1=time, y1=-1.2, x2=time, y2=1.2, xloc=xloc.bar_time, color=color.new(color.aqua, 20), width=2, style=line.style_solid) // Cyan
    label.new(x=time, y=-1.2, text="🌑", xloc=xloc.bar_time, color=color.new(color.black, 100), textcolor=color.aqua, style=label.style_label_up, size=size.small)

if firstQuarterTrigger and showQuarterMoons
    line.new(x1=time, y1=-1.2, x2=time, y2=1.2, xloc=xloc.bar_time, color=color.new(color.gray, 40), width=1, style=line.style_dashed)
    label.new(x=time, y=1.2, text="🌓", xloc=xloc.bar_time, color=color.new(color.black, 100), textcolor=color.gray, style=label.style_label_down, size=size.small)

if thirdQuarterTrigger and showQuarterMoons
    line.new(x1=time, y1=-1.2, x2=time, y2=1.2, xloc=xloc.bar_time, color=color.new(color.gray, 40), width=1, style=line.style_dashed)
    label.new(x=time, y=-1.2, text="🌗", xloc=xloc.bar_time, color=color.new(color.black, 100), textcolor=color.gray, style=label.style_label_up, size=size.small)

// --- FUTURE PROJECTIONS ---
if barstate.islast
    for i = 0 to 2
        float target_fraction = (math.floor(phase * 4) + 1 + i) / 4
        int target_time = int(time + (target_fraction - phase) * SYNODIC_MONTH)
        
        int phase_idx = int((math.floor(phase * 4) + 1 + i)) % 4
        
        bool drawFuture = true
        if (phase_idx == 1 or phase_idx == 3) and not showQuarterMoons
            drawFuture := false
            
        if drawFuture
            // 70% transparent brand colors for future projections
            color lineColor = phase_idx == 0 ? color.new(color.aqua, 70) : phase_idx == 2 ? color.new(#FFD700, 70) : color.new(color.gray, 70)
            string labelStr = phase_idx == 0 ? "🌑" : phase_idx == 1 ? "🌓" : phase_idx == 2 ? "🌕" : "🌗"
            string styleLine = (phase_idx == 0 or phase_idx == 2) ? line.style_solid : line.style_dashed
            string labelStyle = (phase_idx == 0 or phase_idx == 3) ? label.style_label_up : label.style_label_down
            float yPos = (phase_idx == 0 or phase_idx == 3) ? -1.2 : 1.2
            int lineWidth = (phase_idx == 0 or phase_idx == 2) ? 2 : 1
            
            line.new(x1=target_time, y1=-1.2, x2=target_time, y2=1.2, xloc=xloc.bar_time, color=lineColor, width=lineWidth, style=styleLine)
            label.new(x=target_time, y=yPos, text=labelStr, xloc=xloc.bar_time, color=color.new(color.black, 100), textcolor=lineColor, style=labelStyle, size=size.small)

// --- DATA TABLE ---
var table moonTable = table.new(position.bottom_right, 2, 2, bgcolor=color.new(#0a192f, 80), frame_color=color.gray, frame_width=1, border_color=color.gray, border_width=1)

if barstate.islast and showTable
    float illumPct = phase <= 0.5 ? (phase * 200) : ((1.0 - phase) * 200)
    string nextPhaseName = phase < 0.5 ? "Full Moon" : "New Moon"
    float daysToNext = phase < 0.5 ? ((0.5 - phase) * SYNODIC_MONTH) / 86400000 : ((1.0 - phase) * SYNODIC_MONTH) / 86400000
    
    table.cell(moonTable, 0, 0, "Illumination:", text_color=color.gray, text_size=size.small)
    table.cell(moonTable, 1, 0, str.tostring(illumPct, "#.##") + "%", text_color=color.white, text_size=size.small)
    table.cell(moonTable, 0, 1, "Next " + nextPhaseName + ":", text_color=color.gray, text_size=size.small)
    table.cell(moonTable, 1, 1, str.tostring(daysToNext, "#.##") + " Days", text_color=phase < 0.5 ? color.new(#FFD700, 0) : color.aqua, text_size=size.small)

// --- ALERTS ---
alertcondition(newMoonTrigger, title="New Moon Alert", message="New Moon Phase Reached!")
alertcondition(fullMoonTrigger, title="Full Moon Alert", message="Full Moon Phase Reached!")
alertcondition(firstQuarterTrigger, title="First Quarter Alert", message="First Quarter (Waxing) Reached!")
alertcondition(thirdQuarterTrigger, title="Third Quarter Alert", message="Third Quarter (Waning) Reached!")
