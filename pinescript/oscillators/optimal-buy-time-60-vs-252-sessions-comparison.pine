//@version=6
indicator("Fascia Oraria - Confronto 60 vs 252 sedute", overlay = false, max_bars_back = 5000)

bool show_table = input.bool(true, "Mostra tabella")
bool show_bg = input.bool(true, "Colora sfondo")
float thresh_good = input.float(0.1, "Soglia buona %", minval = 0.0, step = 0.05)

bool in_session = not na(time("30", "0930-1600", "America/New_York"))

float daily_close_today = request.security(syminfo.tickerid, "D", close)

int bar_hour = hour(time, "America/New_York")
int bar_minute = minute(time, "America/New_York")
int slot = (bar_hour - 9) * 2 + (bar_minute >= 30 ? 1 : 0) - 1

int N = 13
int LOOKBACK_SHORT = 60
int LOOKBACK_LONG = 252

var float[] sum_s = array.new_float(N, 0.0)
var float[] sum_l = array.new_float(N, 0.0)
var int[] cnt_s = array.new_int(N, 0)
var int[] cnt_l = array.new_int(N, 0)
var int[] wins_s = array.new_int(N, 0)
var int[] wins_l = array.new_int(N, 0)

float mid = (high + low) / 2.0
float ret = daily_close_today > 0.0 and mid > 0.0 ? (daily_close_today - mid) / mid * 100.0 : 0.0

var int day_count = 0
bool is_new_day = dayofweek != dayofweek[1]
if is_new_day and in_session
    day_count := day_count + 1

if in_session and slot >= 0 and slot < N and not na(daily_close_today)
    if day_count <= LOOKBACK_LONG
        array.set(sum_l, slot, array.get(sum_l, slot) + ret)
        array.set(cnt_l, slot, array.get(cnt_l, slot) + 1)
        if ret > 0.0
            array.set(wins_l, slot, array.get(wins_l, slot) + 1)
    if day_count <= LOOKBACK_SHORT
        array.set(sum_s, slot, array.get(sum_s, slot) + ret)
        array.set(cnt_s, slot, array.get(cnt_s, slot) + 1)
        if ret > 0.0
            array.set(wins_s, slot, array.get(wins_s, slot) + 1)

float[] avg_s = array.new_float(N, 0.0)
float[] avg_l = array.new_float(N, 0.0)
float[] wr_s = array.new_float(N, 0.0)
float[] wr_l = array.new_float(N, 0.0)

for i = 0 to N - 1
    int cs = array.get(cnt_s, i)
    int cl = array.get(cnt_l, i)
    if cs > 0
        array.set(avg_s, i, array.get(sum_s, i) / cs)
        array.set(wr_s, i, float(array.get(wins_s, i)) / float(cs) * 100.0)
    if cl > 0
        array.set(avg_l, i, array.get(sum_l, i) / cl)
        array.set(wr_l, i, float(array.get(wins_l, i)) / float(cl) * 100.0)

string[] labels = array.new_string(N, "")
array.set(labels, 0, "09:30")
array.set(labels, 1, "10:00")
array.set(labels, 2, "10:30")
array.set(labels, 3, "11:00")
array.set(labels, 4, "11:30")
array.set(labels, 5, "12:00")
array.set(labels, 6, "12:30")
array.set(labels, 7, "13:00")
array.set(labels, 8, "13:30")
array.set(labels, 9, "14:00")
array.set(labels, 10, "14:30")
array.set(labels, 11, "15:00")
array.set(labels, 12, "15:30")

float plot_s = in_session and slot >= 0 and slot < N ? array.get(avg_s, slot) : na
float plot_l = in_session and slot >= 0 and slot < N ? array.get(avg_l, slot) : na

plot(plot_s, "60 sedute", color = color.new(#185FA5, 0), style = plot.style_columns, linewidth = 2)
plot(plot_l, "252 sedute", color = color.new(#888888, 50), style = plot.style_line, linewidth = 2)

hline(0.0, "Zero", color = color.gray, linestyle = hline.style_dashed)
hline(thresh_good, "Soglia buona", color = color.new(#1a9e6e, 40), linestyle = hline.style_dotted)
hline(-thresh_good, "Evita", color = color.new(#d94040, 40), linestyle = hline.style_dotted)

color bg = na
if show_bg and in_session and slot >= 0 and slot < N
    float av = array.get(avg_s, slot)
    bg := av >= thresh_good ? color.new(#1a9e6e, 90) : av < -thresh_good ? color.new(#d94040, 94) : na

bgcolor(bg, title = "Sfondo fascia")

if show_table and barstate.islast
    var table t = table.new(position.middle_center, 6, N + 2, border_width = 2, border_color = color.new(color.black, 0), frame_width = 2, frame_color = color.new(color.black, 0))

    table.cell(t, 0, 0, "Ora IT", text_color = color.white, text_size = size.normal, bgcolor = color.new(#1a1a2e, 0))
    table.cell(t, 1, 0, "60g rend.", text_color = color.new(#7ec8e3, 0), text_size = size.normal, bgcolor = color.new(#1a1a2e, 0))
    table.cell(t, 2, 0, "60g succ.", text_color = color.new(#7ec8e3, 0), text_size = size.normal, bgcolor = color.new(#1a1a2e, 0))
    table.cell(t, 3, 0, "252g rend.", text_color = color.new(#cccccc, 0), text_size = size.normal, bgcolor = color.new(#1a1a2e, 0))
    table.cell(t, 4, 0, "252g succ.", text_color = color.new(#cccccc, 0), text_size = size.normal, bgcolor = color.new(#1a1a2e, 0))
    table.cell(t, 5, 0, "Trend", text_color = color.white, text_size = size.normal, bgcolor = color.new(#1a1a2e, 0))

    for i = 0 to N - 1
        float as_ = array.get(avg_s, i)
        float al_ = array.get(avg_l, i)
        float ws_ = array.get(wr_s, i)
        float wl_ = array.get(wr_l, i)
        string lbl = array.get(labels, i)

        int lbl_hour = int(str.tonumber(str.substring(lbl, 0, 2))) + 6
        int lbl_min = int(str.tonumber(str.substring(lbl, 3, 5)))
        string lbl_it = str.tostring(lbl_hour) + ":" + (lbl_min == 0 ? "00" : str.tostring(lbl_min)) + " IT  (" + lbl + " ET)"

        string trend = as_ > al_ + 0.05 ? "Migliora" : as_ < al_ - 0.05 ? "Peggiora" : "Stabile"
        color trend_col = as_ > al_ + 0.05 ? color.new(#00ff88, 0) : as_ < al_ - 0.05 ? color.new(#ff4444, 0) : color.new(#cccccc, 0)

        color bg_s = as_ >= thresh_good ? color.new(#0d3d2a, 0) : as_ < -thresh_good ? color.new(#3d0d0d, 0) : color.new(#1e1e2e, 0)
        color bg_l = al_ >= thresh_good ? color.new(#0d3d2a, 0) : al_ < -thresh_good ? color.new(#3d0d0d, 0) : color.new(#1e1e2e, 0)

        color txt_s = as_ >= thresh_good ? color.new(#00ff88, 0) : as_ < -thresh_good ? color.new(#ff4444, 0) : color.new(#aaaaaa, 0)
        color txt_l = al_ >= thresh_good ? color.new(#00ff88, 0) : al_ < -thresh_good ? color.new(#ff4444, 0) : color.new(#aaaaaa, 0)

        string rs = (as_ >= 0.0 ? "+" : "") + str.tostring(math.round(as_ * 100.0) / 100.0, "#.##") + "%"
        string rl = (al_ >= 0.0 ? "+" : "") + str.tostring(math.round(al_ * 100.0) / 100.0, "#.##") + "%"
        string wrs = str.tostring(math.round(ws_ * 10.0) / 10.0, "#.#") + "%"
        string wrl = str.tostring(math.round(wl_ * 10.0) / 10.0, "#.#") + "%"

        table.cell(t, 0, i + 1, lbl_it, text_color = color.white, text_size = size.normal, bgcolor = color.new(#1a1a2e, 0))
        table.cell(t, 1, i + 1, rs, text_color = txt_s, text_size = size.normal, bgcolor = bg_s)
        table.cell(t, 2, i + 1, wrs, text_color = txt_s, text_size = size.normal, bgcolor = bg_s)
        table.cell(t, 3, i + 1, rl, text_color = txt_l, text_size = size.normal, bgcolor = bg_l)
        table.cell(t, 4, i + 1, wrl, text_color = txt_l, text_size = size.normal, bgcolor = bg_l)
        table.cell(t, 5, i + 1, trend, text_color = trend_col, text_size = size.normal, bgcolor = color.new(#1a1a2e, 0))

    table.cell(t, 0, N + 1, "Orari italiani  (ET +6h)", text_color = color.new(#888888, 0), text_size = size.small, bgcolor = color.new(#0d0d1a, 0))
    table.cell(t, 1, N + 1, syminfo.ticker, text_color = color.new(#888888, 0), text_size = size.small, bgcolor = color.new(#0d0d1a, 0))
    table.cell(t, 2, N + 1, " ", text_color = color.gray, text_size = size.small, bgcolor = color.new(#0d0d1a, 0))
    table.cell(t, 3, N + 1, " ", text_color = color.gray, text_size = size.small, bgcolor = color.new(#0d0d1a, 0))
    table.cell(t, 4, N + 1, " ", text_color = color.gray, text_size = size.small, bgcolor = color.new(#0d0d1a, 0))
    table.cell(t, 5, N + 1, " ", text_color = color.gray, text_size = size.small, bgcolor = color.new(#0d0d1a, 0))
