//@version=5
indicator("McClellan Bottom + Alternating FVG", overlay=true)

//=========================
// INPUTS
//=========================
isRA = input.bool(true, "Ratio Adjusted")
rm   = input.float(1000)

moonel = input.int(16, "MO Fast")
mtwol  = input.int(36, "MO Slow")

normLength = input.int(100, "Z Score Length")
zExtreme   = input.float(-2.0, "Extreme Breadth Level")

sweepLookback = input.int(10, "Liquidity Sweep Lookback")

//=========================
// ADV / DEC DATA
//=========================
adv = request.security("ADVN.US", timeframe.period, close)
dec = request.security("DECL.US", timeframe.period, close)

ai = nz(adv)
di = nz(dec)

rana = rm * (ai - di) / math.max(ai + di, 1)

e1 = isRA ? ta.ema(rana, moonel) : ta.ema(ai - di, moonel)
e2 = isRA ? ta.ema(rana, mtwol)  : ta.ema(ai - di, mtwol)

mo = e1 - e2

//=========================
// NORMALIZE OSCILLATOR
//=========================
moMean = ta.sma(mo, normLength)
moStd  = ta.stdev(mo, normLength)

z = (mo - moMean) / math.max(moStd, 1e-10)
turningUp = z > z[1]
extremeBreadth = z < zExtreme and turningUp

//=========================
// LIQUIDITY SWEEP (yellow dots, visual only)
//=========================
prevLow = ta.lowest(low[1], sweepLookback)
liquiditySweep = low < prevLow and close > prevLow
plotshape(liquiditySweep, title="Liquidity Sweep", location=location.belowbar, color=color.yellow, style=shape.circle, size=size.tiny)

//=========================
// FAIR VALUE GAPS
//=========================
bullishFVG = low > high[2]
bearishFVG = high < low[2]

//=========================
// STATE VARIABLES
//=========================
var bool waitingForSell = false
var bool waitingForBuy  = true

//=========================
// BUY SIGNAL (Green label below bar)
//=========================
buySignal = waitingForBuy and (liquiditySweep or bullishFVG)
if buySignal
    waitingForSell := true
    waitingForBuy  := false

plotshape(buySignal, title="BUY Signal", location=location.belowbar, color=color.green, style=shape.labelup, text="BUY", textcolor=color.white, size=size.small)

//=========================
// SELL SIGNAL (Red label above bar, first bearish FVG after BUY)
//=========================
sellSignal = waitingForSell and bearishFVG
if sellSignal
    waitingForSell := false
    waitingForBuy  := true

plotshape(sellSignal, title="SELL Signal", location=location.abovebar, color=color.red, style=shape.labeldown, text="SELL", textcolor=color.white, size=size.small)

//=========================
// McClellan oscillator reference
//=========================
plot(z, title="Normalized McClellan", color=color.blue)
hline(0)
hline(zExtreme)
