//@version=6
indicator('Volatility-Gated Trend Oscillator [QuantAlgo]', overlay=false, precision=4)

//              ╔════════════════════════════════╗              //
//              ║      USER-DEFINED SETTINGS     ║              //
//              ╚════════════════════════════════╝              //

var string calculation_settings = '════════ Calculation Parameters ════════'
var string visual_settings = '════════ Visualization Settings ════════'

tooltip_src = 'The price source used as input for all calculations. HLC3 (default) uses the average of High, Low, and Close, providing a balanced representation of each bar\'s price action. Close focuses purely on final bar price and reacts more sharply to closing momentum. HL2 uses the midpoint of the bar range. Experimenting with different sources can subtly shift signal timing and sensitivity.'
tooltip_sensitivity = 'Controls the lookback period for the baseline moving average and noise floor calculation. Lower values (8-14) make the oscillator highly reactive, capturing short-term momentum shifts with more frequent signals - suited to intraday and scalping timeframes. Medium values (18-28) offer a balanced response that filters minor noise while remaining responsive to meaningful trend changes - ideal for swing trading on 4H and daily charts. Higher values (34-55) produce a smoother, slower oscillator focused on major directional moves with fewer but higher-conviction signals - best for position trading and primary trend identification. Standard value is 20 for balanced performance.'
tooltip_ma_type = 'Moving average type used to calculate the baseline from which raw deviation is measured. SMA (default) provides equal weighting across the lookback period and is the most transparent baseline. EMA reacts faster to recent price changes, producing earlier but occasionally noisier signals. WMA applies linearly increasing weight to recent bars for a middle ground between SMA and EMA. HMA dramatically reduces lag while maintaining smoothness, useful for fast-moving markets. RMA is a smoothed moving average that reacts slowly and steadily, reducing false signals in choppy conditions.'
tooltip_noise_mult = 'Defines how many units of average absolute deviation price must exceed before a trend signal is confirmed. Lower values (0.8-1.2) create a tight noise floor that triggers signals on smaller moves, increasing reactivity but also susceptibility to false breakouts. Medium values (1.3-1.8) require meaningful deviation beyond typical fluctuation, filtering out most noise while still responding to genuine momentum. Higher values (2.0-3.0) demand large, decisive moves before confirming a trend, reducing signal frequency but greatly improving signal quality in volatile markets. Standard value is 1.5 for effective noise rejection.'
tooltip_preset = 'Select a predefined configuration optimized for different trading styles, timeframes, and market conditions. Presets override the Filter Strength, Baseline MA Type, and Noise Threshold settings.\n\nDefault (SMA, 20, 1.5): Standard configuration suitable for swing trading on 4H and daily charts. Balanced sensitivity captures meaningful trend changes, moderate noise threshold filters out minor fluctuations. Generates quality oscillator signals without excessive noise, ideal for most traders and market conditions.\n\nFast Response (EMA, 12, 1.1): Aggressive configuration for intraday trading and scalping on 5min-1H charts. EMA baseline reacts quickly to recent price shifts, shorter lookback and lower noise threshold trigger earlier on breakouts. Best for active traders capitalizing on short-term directional moves.\n\nSmooth Trend (HMA, 34, 2.0): Conservative configuration for position trading on daily and weekly charts. HMA baseline reduces lag while maintaining smoothness, higher noise threshold only confirms major momentum shifts. Best for patient traders seeking high-conviction signals with minimal false positives.'
tooltip_color_preset = 'Pre-configured color schemes optimized for different chart themes and visual preferences. Classic uses traditional green and red. Aqua provides ocean-inspired blues and oranges. Cosmic offers futuristic cyan and purple. Cyber features warm orange and cool cyan contrast. Neon delivers high-contrast yellow and magenta for maximum visibility. Custom allows full color customization using the color pickers below.'
tooltip_bull_col = 'Color applied to the oscillator and bar highlights when the trend state is bullish, meaning price deviation has exceeded the positive noise floor. Use vibrant, distinctive colors to clearly identify uptrend momentum zones and potential long opportunities on the oscillator.'
tooltip_bear_col = 'Color applied to the oscillator and bar highlights when the trend state is bearish, meaning price deviation has fallen below the negative noise floor. Use contrasting warning colors to signal downtrend momentum zones and potential short opportunities or exits.'
tooltip_barcolor = 'Enable or disable bar coloring based on the current trend state. When enabled, price bars are tinted with the bullish or bearish color during active trend conditions, providing instant visual confirmation of trend direction without reading the oscillator value. Disable if you prefer default bar colors or are running other bar coloring indicators.'

src = input.source(hlc3, 'Source', group=calculation_settings, tooltip=tooltip_src)
sensitivity = input.int(20, 'Filter Strength', group=calculation_settings, tooltip=tooltip_sensitivity)
ma_type = input.string('SMA', 'Baseline MA Type', options=['SMA', 'EMA', 'WMA', 'HMA', 'RMA'], group=calculation_settings, tooltip=tooltip_ma_type)
noise_mult = input.float(1.5, 'Noise Threshold', step=0.1, group=calculation_settings, tooltip=tooltip_noise_mult)
preset_config = input.string('Default', 'Preset Configuration', options=['Default', 'Fast Response', 'Smooth Trend'], group=calculation_settings, tooltip=tooltip_preset)
color_preset = input.string('Custom', 'Color Preset', options=['Classic', 'Aqua', 'Cosmic', 'Cyber', 'Neon', 'Custom'], group=visual_settings, tooltip=tooltip_color_preset)
bull_input = input.color(#00ffaa, 'Bullish Color', group=visual_settings, tooltip=tooltip_bull_col)
bear_input = input.color(#ff0000, 'Bearish Color', group=visual_settings, tooltip=tooltip_bear_col)
enable_barcolor = input.bool(true, 'Enable Bar Coloring', group=visual_settings, tooltip=tooltip_barcolor)

if preset_config == 'Fast Response'
    sensitivity := 12
    ma_type := 'EMA'
    noise_mult := 1.1
else if preset_config == 'Smooth Trend'
    sensitivity := 34
    ma_type := 'HMA'
    noise_mult := 2.0

[bull_col, bear_col] = switch color_preset
    'Classic' => [#00ff00, #ff0000]
    'Aqua' => [#00d4ff, #ff8c00]
    'Cosmic' => [#49ffce, #9932cc]
    'Cyber' => [#00cccc, #ff6600]
    'Neon' => [#ffff00, #ff00ff]
    'Custom' => [bull_input, bear_input]

//              ╔════════════════════════════════╗              //
//              ║        CORE CALCULATION        ║              //
//              ╚════════════════════════════════╝              //

get_ma(source, length, type) =>
    switch type
        'SMA' => ta.sma(source, length)
        'EMA' => ta.ema(source, length)
        'WMA' => ta.wma(source, length)
        'HMA' => ta.hma(source, length)
        'RMA' => ta.rma(source, length)

baseline = get_ma(src, sensitivity, ma_type)
raw_diff = src - baseline
noise_floor = ta.sma(math.abs(raw_diff), sensitivity) * noise_mult

var int trend_state = 0
var float locked_val = 0.0

if raw_diff > noise_floor
    trend_state := 1
    locked_val := raw_diff
else if raw_diff < -noise_floor
    trend_state := -1
    locked_val := raw_diff
else
    locked_val := locked_val * 0.9

normalized_val = locked_val / ta.atr(sensitivity)
final_osc = ta.wma(normalized_val, 5)
sig_color = trend_state == 1 ? bull_col : trend_state == -1 ? bear_col : color.gray

trend_turned_bullish = trend_state == 1 and trend_state[1] != 1
trend_turned_bearish = trend_state == -1 and trend_state[1] != -1
trend_changed = trend_turned_bullish or trend_turned_bearish

//              ╔════════════════════════════════╗              //
//              ║          VISUALIZATION         ║              //
//              ╚════════════════════════════════╝              //

hline(0, 'Zero Line', color=color.new(color.white, 75), linestyle=hline.style_solid, linewidth=1)

inner_layer = final_osc * 0.80
mid_layer = final_osc * 0.55
outer_layer = final_osc * 0.30

p_main = plot(final_osc, 'Main', color=color.new(sig_color, 0), linewidth=2)
p_inner_layer = plot(inner_layer, 'Inner Layer', color=color.new(sig_color, 100))
p_mid_layer = plot(mid_layer, 'Mid Layer', color=color.new(sig_color, 100))
p_outer_layer = plot(outer_layer, 'Outer Layer', color=color.new(sig_color, 100))
p_zero = plot(0, 'Zero', color=color.new(sig_color, 100))

fill(p_main, p_inner_layer, color.new(sig_color, 55), title='Luminance Layer 1')
fill(p_inner_layer, p_mid_layer, color.new(sig_color, 72), title='Luminance Layer 2')
fill(p_mid_layer, p_outer_layer, color.new(sig_color, 84), title='Luminance Layer 3')
fill(p_outer_layer, p_zero, color.new(sig_color, 93), title='Luminance Layer 4')

barcolor(enable_barcolor ? (trend_state != 0 ? color.new(sig_color, 20) : na) : na, title='Trend Bar Color')

//              ╔════════════════════════════════╗              //
//              ║             ALERTS             ║              //
//              ╚════════════════════════════════╝              //

alertcondition(trend_turned_bullish, title='Bullish Trend Signal', message='Volatility-Gated Trend Oscillator: BULLISH trend confirmed on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(trend_turned_bearish, title='Bearish Trend Signal', message='Volatility-Gated Trend Oscillator: BEARISH trend confirmed on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(trend_changed, title='Trend Direction Changed', message='Volatility-Gated Trend Oscillator: Trend direction changed on {{exchange}}:{{ticker}} - {{interval}}')

