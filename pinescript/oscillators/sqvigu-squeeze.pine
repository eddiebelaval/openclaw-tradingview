//@version=5
indicator("SQVIGU Squeeze", shorttitle="SQVIGU Squeeze", overlay=false)

// --- BASE SQUEEZE SETTINGS ---
length = input.int(20, "Squeeze Length")
bb_mult = input.float(2.0, "Bollinger Band Multiplier")
kc_mult = input.float(1.5, "Keltner Channel Multiplier")

// --- HIGH-PROBABILITY FILTER SETTINGS ---
ema_length = input.int(50, "Trend EMA Filter Length")
adx_threshold = input.int(20, "ADX Trend Strength Threshold")

// --- SQUEEZE CALCULATION ---
// Bollinger Bands
bb_basis = ta.sma(close, length)
bb_dev = bb_mult * ta.stdev(close, length)
upperBB = bb_basis + bb_dev
lowerBB = bb_basis - bb_dev

// Keltner Channels
kc_basis = ta.sma(close, length)
kc_range = ta.ema(ta.tr, length)
upperKC = kc_basis + kc_range * kc_mult
lowerKC = kc_basis - kc_range * kc_mult

// Squeeze States (Red dots = Squeeze ON, Green dots = Squeeze OFF/Firing)
sqzOn = (lowerBB > lowerKC) and (upperBB < upperKC)
sqzOff = (lowerBB < lowerKC) or (upperBB > upperKC)

// Momentum Oscillator (Linear Regression)
highest = ta.highest(high, length)
lowest = ta.lowest(low, length)
avg_hl = (highest + lowest) / 2
momentum = ta.linreg(close - ((avg_hl + kc_basis) / 2), length, 0)

// --- THE "BETTER PROBABILITY" FILTERS ---
// 1. Trend Filter: Ensure we are trading with the medium-term trend
ema_trend = ta.ema(close, ema_length)
bull_trend = close > ema_trend
bear_trend = close < ema_trend

// 2. Trend Strength Filter (ADX): Ensure the market actually has the energy to break out
[diplus, diminus, adx] = ta.dmi(14, 14)
strong_trend = adx > adx_threshold

// Base Firing Triggers
squeeze_fired = sqzOn[1] and sqzOff
long_fire = squeeze_fired and momentum > 0
short_fire = squeeze_fired and momentum < 0

// High-Probability Triggers
hp_long = long_fire and bull_trend and strong_trend
hp_short = short_fire and bear_trend and strong_trend

// --- PLOTTING ---
// Momentum Histogram
hist_color = momentum > 0 ? (momentum > momentum[1] ? color.new(color.aqua, 0) : color.new(color.blue, 0)) : (momentum < momentum[1] ? color.new(color.red, 0) : color.new(color.maroon, 0))
plot(momentum, title="Momentum", color=hist_color, style=plot.style_histogram, linewidth=3)

// Squeeze Dots on the zero line
plot(0, title="Squeeze Status", color = sqzOn ? color.red : color.green, style=plot.style_circles, linewidth=2)

// High Probability Signals (These will plot on the zero line when all conditions are met)
plotshape(hp_long ? 0 : na, title="High Prob Long", style=shape.triangleup, location=location.absolute, color=color.yellow, size=size.small)
plotshape(hp_short ? 0 : na, title="High Prob Short", style=shape.triangledown, location=location.absolute, color=color.fuchsia, size=size.small)
