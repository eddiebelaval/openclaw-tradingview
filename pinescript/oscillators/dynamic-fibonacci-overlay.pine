//@version=6
// Author: Simon20cent
// Dynamic Fibonacci Overlay v4
// Description: Shows dynamic top/bottom/50% lines with optional Fibonacci levels and shaded zone.

indicator("Dynamic Fibonacci Overlay", overlay=true, max_lines_count=500, max_labels_count=500)

// === Inputs ===
length = input.int(14, "Range Length")

// --- Top line ---
topColor = input.color(color.green, "Top Line Color")
topWidth = input.int(2, "Top Line Width", minval=1)
topStyleInput = input.string("Solid", "Top Line Style", options=["Solid","Dashed","Dotted"])

// --- Bottom line ---
bottomColor = input.color(color.red, "Bottom Line Color")
bottomWidth = input.int(2, "Bottom Line Width", minval=1)
bottomStyleInput = input.string("Solid", "Bottom Line Style", options=["Solid","Dashed","Dotted"])

// --- Mid line (50%) ---
show50 = input.bool(true, "Show 50% Line")
midColor = input.color(color.gray, "50% Line Color")
midWidth = input.int(1, "50% Line Width")
midStyleInput = input.string("Dashed", "50% Line Style", options=["Solid","Dashed","Dotted"])

// --- Additional Fibonacci levels ---
show38 = input.bool(true, "Show 38.2% Line")
show618 = input.bool(true, "Show 61.8% Line")

fib38Color = input.color(color.orange, "38.2% Line Color")
fib618Color = input.color(color.purple, "61.8% Line Color")
fibWidth = input.int(1, "Fib Line Width")

// --- Shading ---
fillColor = input.color(color.new(color.blue,85), "Fill Color")
showFill = input.bool(true, "Show Shaded Zone")

// --- Helper to map line style string to line.style ---
f_getStyle(s) =>
    s == "Solid" ? line.style_solid : (s == "Dashed" ? line.style_dashed : line.style_dotted)

topStyle = f_getStyle(topStyleInput)
midStyle = f_getStyle(midStyleInput)
bottomStyle = f_getStyle(bottomStyleInput)

// === Positions ===
barStart = bar_index - length
barEnd = bar_index

topClose = close
bottomClose = close[length]
midClose = (topClose + bottomClose)/2

// === Persistent lines and box ===
var line lineTop = na
var line lineBottom = na
var line lineMid = na
var line line38 = na
var line line618 = na
var box rangeBox = na

if bar_index >= length
    if na(lineTop)
        // Create lines
        lineTop := line.new(barStart, topClose, barEnd, topClose, color=topColor, width=topWidth, style=topStyle)
        lineBottom := line.new(barStart, bottomClose, barEnd, bottomClose, color=bottomColor, width=bottomWidth, style=bottomStyle)
        if show50
            lineMid := line.new(barStart, midClose, barEnd, midClose, color=midColor, width=midWidth, style=midStyle)
        if show38
            line38 := line.new(barStart, bottomClose + (topClose-bottomClose)*0.382, barEnd, bottomClose + (topClose-bottomClose)*0.382, color=fib38Color, width=fibWidth)
        if show618
            line618 := line.new(barStart, bottomClose + (topClose-bottomClose)*0.618, barEnd, bottomClose + (topClose-bottomClose)*0.618, color=fib618Color, width=fibWidth)
        if showFill
            rangeBox := box.new(barStart, topClose, barEnd, bottomClose, border_color=color.new(color.gray,100), bgcolor=fillColor)
    else
        // Update top/bottom/mid lines
        line.set_xy1(lineTop, barStart, topClose)
        line.set_xy2(lineTop, barEnd, topClose)
        line.set_xy1(lineBottom, barStart, bottomClose)
        line.set_xy2(lineBottom, barEnd, bottomClose)
        if show50
            line.set_xy1(lineMid, barStart, midClose)
            line.set_xy2(lineMid, barEnd, midClose)
        if show38
            line.set_xy1(line38, barStart, bottomClose + (topClose-bottomClose)*0.382)
            line.set_xy2(line38, barEnd, bottomClose + (topClose-bottomClose)*0.382)
        if show618
            line.set_xy1(line618, barStart, bottomClose + (topClose-bottomClose)*0.618)
            line.set_xy2(line618, barEnd, bottomClose + (topClose-bottomClose)*0.618)
        // Update shaded box
        if showFill
            box.set_left(rangeBox, barStart)
            box.set_right(rangeBox, barEnd)
            box.set_top(rangeBox, topClose)
            box.set_bottom(rangeBox, bottomClose)
            box.set_bgcolor(rangeBox, fillColor)
