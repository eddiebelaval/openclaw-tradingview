//@version=6
indicator("TWAV Oscillator", overlay=false, max_bars_back=4000)

// =========================================================================
// GLOBAL SETTINGS
// =========================================================================
grp_global = "Global Settings"
src        = input.source(ohlc4, title="Source", group=grp_global)
global_tz  = input.string("America/New_York", title="Timezone", group=grp_global)
lookback   = input.time(timestamp("21 Mar 2024 00:00 -0400"), title="Maximum Lookback", group=grp_global)

grp_osc = "Oscillator Visuals"
agg_method     = input.string("Average", "Aggregation Method", options=["Average", "Median"], group=grp_osc)
color_smooth   = input.int(1, "Color Smoothing (Bars)", minval=1, maxval=10, group=grp_osc)
show_mean_line = input.bool(true, "Show Signal Line (SMA of Osc)", group=grp_osc)
mean_length    = input.int(9, "Signal Length", minval=1, group=grp_osc)

grp_bands = "Cluster Envelope Settings"
show_cluster_bands = input.bool(true, "Show Rolling High/Low Cluster Channels", group=grp_bands)
show_sd_bands      = input.bool(true, "Show Cluster StdDev Bands", group=grp_bands)
sd_mult            = input.float(2.0, "StdDev Multiplier", step=0.1, group=grp_bands)

grp_inter = "Intersection Markers"
show_intersections = input.bool(true, "Show Line Intersections", group=grp_inter)

// =========================================================================
// CALCULATION LOGIC
// =========================================================================
int currentDay      = dayofmonth(time, global_tz)
int currentTotalMin = hour(time, global_tz) * 60 + minute(time, global_tz)
bool is_within_lookback = time >= lookback

// Optimized TWAP calculation function
f_calc_twap(bool enable, string targetTimeStr) =>
    var float sum_x = 0.0
    var int count = 0
    var int lastTriggerDay = -1
    
    var int targetTotalMin = 0
    if barstate.isfirst
        string[] timeParts = str.split(targetTimeStr, ":")
        int targetHour   = array.size(timeParts) > 0 ? int(str.tonumber(array.get(timeParts, 0))) : 0
        int targetMinute = array.size(timeParts) > 1 ? int(str.tonumber(array.get(timeParts, 1))) : 0
        targetTotalMin  := targetHour * 60 + targetMinute

    bool isAnchor = currentTotalMin >= targetTotalMin and currentDay != lastTriggerDay
    
    if isAnchor
        sum_x := 0.0
        count := 0
        lastTriggerDay := currentDay
            
    sum_x += src
    count += 1
        
    float rawTwap = (count > 0 and enable and is_within_lookback) ? (sum_x / count) : na
    rawTwap

// =========================================================================
// TWAP INPUTS (All enabled by default)
// =========================================================================
grp_twaps = "TWAP Sources"
en1  = input.bool(true, "", inline="t1", group=grp_twaps), tm1  = input.string("00:00", "T1", inline="t1", group=grp_twaps)
en2  = input.bool(true, "", inline="t2", group=grp_twaps), tm2  = input.string("01:00", "T2", inline="t2", group=grp_twaps)
en3  = input.bool(true, "", inline="t3", group=grp_twaps), tm3  = input.string("02:00", "T3", inline="t3", group=grp_twaps)
en4  = input.bool(true, "", inline="t4", group=grp_twaps), tm4  = input.string("03:00", "T4", inline="t4", group=grp_twaps)
en5  = input.bool(true, "", inline="t5", group=grp_twaps), tm5  = input.string("04:00", "T5", inline="t5", group=grp_twaps)
en6  = input.bool(true, "", inline="t6", group=grp_twaps), tm6  = input.string("05:00", "T6", inline="t6", group=grp_twaps)
en7  = input.bool(true, "", inline="t7", group=grp_twaps), tm7  = input.string("06:00", "T7", inline="t7", group=grp_twaps)
en8  = input.bool(true, "", inline="t8", group=grp_twaps), tm8  = input.string("07:00", "T8", inline="t8", group=grp_twaps)
en9  = input.bool(true, "", inline="t9", group=grp_twaps), tm9  = input.string("08:00", "T9", inline="t9", group=grp_twaps)
en10 = input.bool(true, "", inline="t10", group=grp_twaps), tm10 = input.string("09:00", "T10", inline="t10", group=grp_twaps)
en11 = input.bool(true, "", inline="t11", group=grp_twaps), tm11 = input.string("10:00", "T11", inline="t11", group=grp_twaps)
en12 = input.bool(true, "", inline="t12", group=grp_twaps), tm12 = input.string("11:00", "T12", inline="t12", group=grp_twaps)
en13 = input.bool(true, "", inline="t13", group=grp_twaps), tm13 = input.string("12:00", "T13", inline="t13", group=grp_twaps)
en14 = input.bool(true, "", inline="t14", group=grp_twaps), tm14 = input.string("13:00", "T14", inline="t14", group=grp_twaps)
en15 = input.bool(true, "", inline="t15", group=grp_twaps), tm15 = input.string("14:00", "T15", inline="t15", group=grp_twaps)
en16 = input.bool(true, "", inline="t16", group=grp_twaps), tm16 = input.string("15:00", "T16", inline="t16", group=grp_twaps)
en17 = input.bool(true, "", inline="t17", group=grp_twaps), tm17 = input.string("16:00", "T17", inline="t17", group=grp_twaps)
en18 = input.bool(true, "", inline="t18", group=grp_twaps), tm18 = input.string("17:00", "T18", inline="t18", group=grp_twaps)
en19 = input.bool(true, "", inline="t19", group=grp_twaps), tm19 = input.string("18:00", "T19", inline="t19", group=grp_twaps)
en20 = input.bool(true, "", inline="t20", group=grp_twaps), tm20 = input.string("19:00", "T20", inline="t20", group=grp_twaps)
en21 = input.bool(true, "", inline="t21", group=grp_twaps), tm21 = input.string("20:00", "T21", inline="t21", group=grp_twaps)
en22 = input.bool(true, "", inline="t22", group=grp_twaps), tm22 = input.string("21:00", "T22", inline="t22", group=grp_twaps)
en23 = input.bool(true, "", inline="t23", group=grp_twaps), tm23 = input.string("22:00", "T23", inline="t23", group=grp_twaps)
en24 = input.bool(true, "", inline="t24", group=grp_twaps), tm24 = input.string("23:00", "T24", inline="t24", group=grp_twaps)

// Collect all values
float v1 = f_calc_twap(en1, tm1),   float v2 = f_calc_twap(en2, tm2)
float v3 = f_calc_twap(en3, tm3),   float v4 = f_calc_twap(en4, tm4)
float v5 = f_calc_twap(en5, tm5),   float v6 = f_calc_twap(en6, tm6)
float v7 = f_calc_twap(en7, tm7),   float v8 = f_calc_twap(en8, tm8)
float v9 = f_calc_twap(en9, tm9),   float v10 = f_calc_twap(en10, tm10)
float v11 = f_calc_twap(en11, tm11), float v12 = f_calc_twap(en12, tm12)
float v13 = f_calc_twap(en13, tm13), float v14 = f_calc_twap(en14, tm14)
float v15 = f_calc_twap(en15, tm15), float v16 = f_calc_twap(en16, tm16)
float v17 = f_calc_twap(en17, tm17), float v18 = f_calc_twap(en18, tm18)
float v19 = f_calc_twap(en19, tm19), float v20 = f_calc_twap(en20, tm20)
float v21 = f_calc_twap(en21, tm21), float v22 = f_calc_twap(en22, tm22)
float v23 = f_calc_twap(en23, tm23), float v24 = f_calc_twap(en24, tm24)

// =========================================================================
// AGGREGATION & OSCILLATOR LOGIC
// =========================================================================
var float[] active_twaps = array.new_float(0)
array.clear(active_twaps)

if not na(v1)
    array.push(active_twaps, v1)
if not na(v2)
    array.push(active_twaps, v2)
if not na(v3)
    array.push(active_twaps, v3)
if not na(v4)
    array.push(active_twaps, v4)
if not na(v5)
    array.push(active_twaps, v5)
if not na(v6)
    array.push(active_twaps, v6)
if not na(v7)
    array.push(active_twaps, v7)
if not na(v8)
    array.push(active_twaps, v8)
if not na(v9)
    array.push(active_twaps, v9)
if not na(v10)
    array.push(active_twaps, v10)
if not na(v11)
    array.push(active_twaps, v11)
if not na(v12)
    array.push(active_twaps, v12)
if not na(v13)
    array.push(active_twaps, v13)
if not na(v14)
    array.push(active_twaps, v14)
if not na(v15)
    array.push(active_twaps, v15)
if not na(v16)
    array.push(active_twaps, v16)
if not na(v17)
    array.push(active_twaps, v17)
if not na(v18)
    array.push(active_twaps, v18)
if not na(v19)
    array.push(active_twaps, v19)
if not na(v20)
    array.push(active_twaps, v20)
if not na(v21)
    array.push(active_twaps, v21)
if not na(v22)
    array.push(active_twaps, v22)
if not na(v23)
    array.push(active_twaps, v23)
if not na(v24)
    array.push(active_twaps, v24)

float cluster_center = na
float cluster_high   = na
float cluster_low    = na

if array.size(active_twaps) > 0
    cluster_high := array.max(active_twaps)
    cluster_low  := array.min(active_twaps)
    
    if agg_method == "Average"
        cluster_center := array.avg(active_twaps)
    else if agg_method == "Median"
        cluster_center := array.median(active_twaps)

// Oscillator Value (Distance from Cluster Center)
float osc_val = src - cluster_center

// Rolling Envelope Values (Distance of High/Low relative to Center)
float env_top = cluster_high - cluster_center
float env_bottom = cluster_low  - cluster_center

// Standard Deviation of the Cluster (Volatility Bands)
float cluster_sd = array.size(active_twaps) > 1 ? array.stdev(active_twaps) : 0
float sd_upper = env_top + (cluster_sd * sd_mult)
float sd_lower = env_bottom - (cluster_sd * sd_mult)

// Signal Line
float signal = ta.sma(osc_val, mean_length)

// =========================================================================
// COMPLEX HEATMAP LOGIC
// =========================================================================
bool is_expanding_up = osc_val >= 0 and ta.rising(osc_val, color_smooth)
bool is_expanding_dn = osc_val <  0 and ta.falling(osc_val, color_smooth)

// Helper to darken colors for contraction bars
f_apply_momentum(color base_c, bool expanding) =>
    expanding ? base_c : color.new(base_c, 50)

float ratio_top = not na(env_top) and env_top != 0 ? math.abs(osc_val / env_top) : 0
float ratio_bot = not na(env_bottom) and env_bottom != 0 ? math.abs(osc_val / env_bottom) : 0

color hist_color = na
if osc_val >= 0
    // Upper Heatmap: Blue -> Aqua -> Green
    color base_c = na
    if ratio_top <= 1.0
        base_c := color.from_gradient(ratio_top, 0, 1, color.blue, color.aqua)
    else
        base_c := color.from_gradient(math.min(ratio_top - 1.0, 1.0), 0, 1, color.aqua, color.lime)
    hist_color := f_apply_momentum(base_c, is_expanding_up)
else
    // Lower Heatmap: Yellow -> Orange -> Red
    color base_c = na
    if ratio_bot <= 1.0
        base_c := color.from_gradient(ratio_bot, 0, 1, color.yellow, color.orange)
    else
        base_c := color.from_gradient(math.min(ratio_bot - 1.0, 1.0), 0, 1, color.orange, color.red)
    hist_color := f_apply_momentum(base_c, is_expanding_dn)

// =========================================================================
// INTERSECTION DETECTION LOGIC
// =========================================================================
// Signal crosses cluster boundaries
bool cross_sig_env_top = ta.cross(signal, env_top)
bool cross_sig_env_bot = ta.cross(signal, env_bottom)
bool cross_sig_sd_top  = ta.cross(signal, sd_upper)
bool cross_sig_sd_bot  = ta.cross(signal, sd_lower)

// Boundaries crossing each other
bool cross_env_sd_top  = ta.cross(env_top, sd_upper)
bool cross_env_sd_bot  = ta.cross(env_bottom, sd_lower)

float intersect_y = na
if cross_sig_env_top or cross_sig_env_bot
    intersect_y := signal
else if cross_sig_sd_top or cross_sig_sd_bot
    intersect_y := signal
else if cross_env_sd_top
    intersect_y := env_top
else if cross_env_sd_bot
    intersect_y := env_bottom

// =========================================================================
// RENDERING (Z-ORDER ADJUSTED)
// =========================================================================
hline(0, "Zero Line", color.gray, linestyle=hline.style_dashed)

// 1. Plot Main Heatmap Histogram (Bottom Layer)
plot(osc_val, "TWAP Deviation", color=hist_color, style=plot.style_columns)

// 2. Plot Cluster Channels Second (Middle Layer) - Red Upper, Green Lower
p_top = plot(show_cluster_bands ? env_top : na, "Rolling Cluster High", color=color.new(color.red, 20), style=plot.style_linebr, linewidth=2)
p_bot = plot(show_cluster_bands ? env_bottom : na, "Rolling Cluster Low", color=color.new(color.green, 20), style=plot.style_linebr, linewidth=2)
fill(p_top, p_bot, color.new(color.gray, 85), title="Cluster Range Fill")

// 3. Plot StdDev Envelope Third (Top Layer)
plot(show_sd_bands ? sd_upper : na, "SD Upper Boundary", color=color.new(color.aqua, 40), style=plot.style_linebr, linewidth=1)
plot(show_sd_bands ? sd_lower : na, "SD Lower Boundary", color=color.new(color.red, 40), style=plot.style_linebr, linewidth=1)

// 4. Plot Signal Line Fourth
plot(show_mean_line ? signal : na, "Signal Line", color=color.new(color.white, 20), linewidth=2)

// 5. Plot Intersections (Top Layer)
plotchar(show_intersections ? intersect_y : na, "Line Intersection", char="✧", location=location.absolute, color=color.white, size=size.tiny)

// Alerts for Channel Breakouts
alertcondition(ta.crossover(osc_val, env_top), "Cluster OB", "Price expanded above the highest cluster TWAP")
alertcondition(ta.crossunder(osc_val, env_bottom), "Cluster OS", "Price expanded below the lowest cluster TWAP")
alertcondition(not na(intersect_y), "Line Intersection", "Structural lines in the oscillator have intersected")
