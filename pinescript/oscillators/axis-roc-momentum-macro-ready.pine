//@version=5

// this is updated adaptive code so now works on all timerames.
// if I want to use it for more precision trades the metrics are below
// daily = 9 to 14, weekly = 4 to 8, Montly = 2 to 5

indicator("Axis ROC Momentum [Macro Ready]", overlay=false)

length = input.int(11, title="ROC Length (Adjust per timeframe)")
source = close

roc = ((source - source[length]) / source[length]) * 100

rocColor = roc > roc[1] ? color.green : roc < roc[1] ? color.red : color.gray

plot(roc, title="ROC", color=rocColor, linewidth=2)
hline(0, "Zero Line", color=color.gray, linestyle=hline.style_dashed)
