//@version=5
indicator("1W Strategy Scanner - Pine Screener Opt", shorttitle="1W Scan PS", overlay=true)

// ───────────────────────────────────────────────
// Inputs (be pokyčių)
// ───────────────────────────────────────────────
ema50_len   = input.int(50,   "EMA 50 period")
ema200_len  = input.int(200,  "EMA 200 period")
rsi_len     = input.int(14,   "RSI period")
rsi_min     = input.int(50,   "RSI min", minval=1, maxval=100)
rsi_max     = input.int(80,   "RSI max", minval=1, maxval=100)
ext_max     = input.float(20.0, "Max distance from EMA50, %", minval=1.0, maxval=50.0)
vol_min     = input.int(500000, "Min volume")

// ───────────────────────────────────────────────
// Optimized weekly data (tik 3 request.security kvietimai)
// ───────────────────────────────────────────────

// 1. Visi pagrindiniai duomenys + EMA + RSI vienu kvietimu
[wc, wh, wv, w_ema50, w_ema200, w_rsi] = request.security(syminfo.tickerid, "W",
     [close, high, volume, ta.ema(close, ema50_len), ta.ema(close, ema200_len), ta.rsi(close, rsi_len)],
     lookahead = barmerge.lookahead_off)

// 2. 52 sav. high + low vienu kvietimu
[w_52h, w_52l] = request.security(syminfo.tickerid, "W",
     [ta.highest(high, 52), ta.lowest(low, 52)],
     lookahead = barmerge.lookahead_off)

// 3. Vidutinis savaitės volume (SMA20) – trečias kvietimas
w_vol_avg = request.security(syminfo.tickerid, "W", ta.sma(volume, 20), lookahead = barmerge.lookahead_off)

// ───────────────────────────────────────────────
// Sąlygos (be pokyčių)
// ───────────────────────────────────────────────
c1 = wc > w_ema200
c2 = wc > w_ema50
c3 = w_rsi >= rsi_min and w_rsi <= rsi_max

dist_from_ema50 = (wc - w_ema50) / w_ema50 * 100
c4 = dist_from_ema50 <= ext_max

c5 = w_ema50 > w_ema200
c6 = w_ema200 > w_ema200[4]
c7 = wv >= vol_min

mid52 = (w_52h + w_52l) / 2
c8 = wc >= mid52

// ───────────────────────────────────────────────
// Signalai ir score
// ───────────────────────────────────────────────
score = (c1?1:0) + (c2?1:0) + (c3?1:0) + (c4?1:0) + (c5?1:0) + (c6?1:0) + (c7?1:0) + (c8?1:0)

signal_strong = c1 and c2 and c3 and c4 and c5 and c6 and c7 and c8
signal_watch  = c1 and c2 and c3 and c7 and score >= 6

// ───────────────────────────────────────────────
// Vizualizacija (paliekama grafike)
// ───────────────────────────────────────────────
plot(w_ema50,  "EMA 50 (W)",  color=color.new(#00ff88, 0), linewidth=2)
plot(w_ema200, "EMA 200 (W)", color=color.new(#4488ff, 0), linewidth=2)

bgcolor(signal_strong ? color.new(#00ff88, 92) : na)

if barstate.islast
    lbl_color = signal_strong ? color.new(#00ff88, 10) : signal_watch ? color.new(#ff9500, 10) : color.new(#ff4466, 10)
    status    = signal_strong ? "✅ SETUP" : signal_watch ? "👀 WATCH" : "❌ NO"
    
    label_text = status + "\n" +
                 "Score: " + str.tostring(score) + "/8\n" +
                 "RSI: "   + str.tostring(math.round(w_rsi,1)) + (c3?" ✓":" ✗") + "\n" +
                 "Dist: "  + str.tostring(math.round(dist_from_ema50,1)) + "%" + (c4?" ✓":" ✗") + "\n" +
                 "GX: "    + (c5?"✓":"✗") + " | Vol: " + (c7?"✓":"✗")

    label.new(bar_index, high * 1.01,
         text      = label_text,
         color     = lbl_color,
         textcolor = color.white,
         style     = label.style_label_lower_left,
         size      = size.normal)

// ───────────────────────────────────────────────
// Kolonos Pine Screener'iui (būtina)
// ───────────────────────────────────────────────
plot(signal_strong ? 1 : 0, "Сигнал",   display=display.none)
plot(score,                 "Score",     display=display.none)
plot(w_rsi,                 "RSI",       display=display.none)
plot(dist_from_ema50,       "Dist EMA50 %", display=display.none)
