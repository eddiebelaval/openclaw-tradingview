//@version=6
indicator("HAV Effort Gradient Oscillator (d/dx)", overlay=false, max_bars_back=4000)
//New Description
// =========================================================================
// GLOBAL SETTINGS
// =========================================================================
grp_global = "Global Settings"
src        = input.source(ohlc4, title="Source", group=grp_global)
lookback   = input.time(timestamp("21 Mar 2024 00:00 -0400"), title="Maximum Lookback", group=grp_global)

grp_anomaly = "Liquidity Anomaly Triggers (The Anchor)"
vol_length      = input.int(50, "Volume Baseline Length", minval=10, group=grp_anomaly)
vol_z_threshold = input.float(2.5, "Anomaly Z-Score Threshold", step=0.1, group=grp_anomaly)
anchor_cooldown = input.int(5, "Anchor Cooldown (Bars)", minval=1, group=grp_anomaly)

grp_osc = "Oscillator Visuals & Momentum"
effort_smooth= input.int(3, "Derivative Pre-Smoothing", minval=1, group=grp_osc, tooltip="Smooths the raw rate-of-change to remove chop before calculating the Z-Score.")
show_zscore  = input.bool(true, "Standardize to Z-Score", group=grp_osc, tooltip="Converts raw $d/dx$ into a Z-Score to match the VWAV/TWAV scale.")
z_len        = input.int(50, "Z-Score Length", minval=10, group=grp_osc)
signal_len   = input.int(9, "Signal Line Length", minval=1, group=grp_osc)
color_smooth = input.int(1, "Color Smoothing (Bars)", minval=1, maxval=10, group=grp_osc)

grp_bands = "Effort Volatility Bands"
show_sd_bands = input.bool(true, "Show Effort Boundary Bands", group=grp_bands)
sd_mult       = input.float(2.0, "Boundary StdDev Multiplier", step=0.1, group=grp_bands)

// =========================================================================
// CPU OPTIMIZATIONS & ANOMALY DETECTION
// =========================================================================
bool is_within_lookback = time >= lookback

// Calculate Volume Z-Score (Institutional Liquidity Detection)
float vol_sma = ta.sma(volume, vol_length)
float vol_sd  = ta.stdev(volume, vol_length)
float vol_z   = vol_sd > 0 ? (volume - vol_sma) / vol_sd : 0

var int bars_since_last_anchor = anchor_cooldown
bars_since_last_anchor += 1

// Trigger: Volume exceeds threshold, within lookback, and past cooldown
bool is_anomaly = (vol_z >= vol_z_threshold) and is_within_lookback and (bars_since_last_anchor >= anchor_cooldown)

// =========================================================================
// CLUSTER STATE MANAGEMENT
// =========================================================================
var int[]  anchors_arr = array.new_int(24, -1)
var bool[] active_arr  = array.new_bool(24, false)

if is_anomaly
    bars_since_last_anchor := 0
    // FIFO Shift: Array logic to track the last 24 Liquidity Events
    array.unshift(anchors_arr, bar_index)
    array.unshift(active_arr, true)
    
    array.pop(anchors_arr)
    array.pop(active_arr)

// =========================================================================
// HMA CALCULATION PIPELINE
// =========================================================================
f_calc_hma(int rank) =>
    int  anchor = array.get(anchors_arr, rank-1)
    bool active = array.get(active_arr, rank-1)
    
    // Dynamic Length: Continuously expanding bars since the anchor
    int count = active and anchor != -1 ? (bar_index - anchor + 1) : 0
    
    // Safeguard the length calculation (Minimum 2 for math)
    // Calculated unconditionally every bar to maintain Pine Script context buffers
    int len = math.max(2, count)
    int half_len = math.max(1, int(math.floor(len / 2)))
    int sqrt_len = math.max(1, int(math.floor(math.sqrt(len))))
    
    float half_wma = ta.wma(src, half_len)
    float full_wma = ta.wma(src, len)
    
    float rawHma = ta.wma(2 * half_wma - full_wma, sqrt_len)
    
    // Gate the mathematical output based on anchor activity
    float hmaVal = (count >= 2 and active) ? rawHma : float(na)
    hmaVal

// Unconditionally evaluate to maintain historical series contexts
float h1  = f_calc_hma(1),  float h2  = f_calc_hma(2),  float h3  = f_calc_hma(3),  float h4  = f_calc_hma(4)
float h5  = f_calc_hma(5),  float h6  = f_calc_hma(6),  float h7  = f_calc_hma(7),  float h8  = f_calc_hma(8)
float h9  = f_calc_hma(9),  float h10 = f_calc_hma(10), float h11 = f_calc_hma(11), float h12 = f_calc_hma(12)
float h13 = f_calc_hma(13), float h14 = f_calc_hma(14), float h15 = f_calc_hma(15), float h16 = f_calc_hma(16)
float h17 = f_calc_hma(17), float h18 = f_calc_hma(18), float h19 = f_calc_hma(19), float h20 = f_calc_hma(20)
float h21 = f_calc_hma(21), float h22 = f_calc_hma(22), float h23 = f_calc_hma(23), float h24 = f_calc_hma(24)

// =========================================================================
// HULL AGREED VALUE (HAV) & DERIVATIVE ($d/dx$)
// =========================================================================
var float[] active_hmas = array.new_float(0)
array.clear(active_hmas)

if not na(h1)
    array.push(active_hmas, h1)
if not na(h2)
    array.push(active_hmas, h2)
if not na(h3)
    array.push(active_hmas, h3)
if not na(h4)
    array.push(active_hmas, h4)
if not na(h5)
    array.push(active_hmas, h5)
if not na(h6)
    array.push(active_hmas, h6)
if not na(h7)
    array.push(active_hmas, h7)
if not na(h8)
    array.push(active_hmas, h8)
if not na(h9)
    array.push(active_hmas, h9)
if not na(h10)
    array.push(active_hmas, h10)
if not na(h11)
    array.push(active_hmas, h11)
if not na(h12)
    array.push(active_hmas, h12)
if not na(h13)
    array.push(active_hmas, h13)
if not na(h14)
    array.push(active_hmas, h14)
if not na(h15)
    array.push(active_hmas, h15)
if not na(h16)
    array.push(active_hmas, h16)
if not na(h17)
    array.push(active_hmas, h17)
if not na(h18)
    array.push(active_hmas, h18)
if not na(h19)
    array.push(active_hmas, h19)
if not na(h20)
    array.push(active_hmas, h20)
if not na(h21)
    array.push(active_hmas, h21)
if not na(h22)
    array.push(active_hmas, h22)
if not na(h23)
    array.push(active_hmas, h23)
if not na(h24)
    array.push(active_hmas, h24)

// Calculate the Meta-Mean of the active Hull lines
float hav = array.size(active_hmas) > 0 ? array.avg(active_hmas) : na

// Calculate Raw Derivative
float raw_d_dx = hav - nz(hav[1], hav)

// Smoothed Derivative (Removes erratic chop)
float d_dx = ta.wma(raw_d_dx, effort_smooth)

// Z-Score Standardization
float d_dx_sma = ta.sma(d_dx, z_len)
float d_dx_sd  = ta.stdev(d_dx, z_len)

float osc_val = show_zscore ? (d_dx_sd > 0 ? (d_dx - d_dx_sma) / d_dx_sd : 0) : d_dx

// Oscillator Signal Line
float signal  = ta.sma(osc_val, signal_len)

// Dynamic Volatility Bands (Thresholds for 'Extreme' Effort)
float osc_baseline = ta.sma(osc_val, z_len)
float osc_stdev_bands = ta.stdev(osc_val, z_len)
float upper_band = osc_baseline + (osc_stdev_bands * sd_mult)
float lower_band = osc_baseline - (osc_stdev_bands * sd_mult)

// =========================================================================
// KINETIC EXHAUSTION (DIVERGENCE) SIGNALS
// =========================================================================
// Trigger when the gradient is in extreme territory (> band) and crosses its signal line, showing effort decay
bool exhaustion_peak   = ta.crossunder(osc_val, signal) and (osc_val > upper_band)
bool exhaustion_trough = ta.crossover(osc_val, signal)  and (osc_val < lower_band)
bool kinetic_exhaustion = exhaustion_peak or exhaustion_trough

// =========================================================================
// HEATMAP LOGIC
// =========================================================================
bool is_expanding_up = osc_val >= 0 and ta.rising(osc_val, color_smooth)
bool is_expanding_dn = osc_val <  0 and ta.falling(osc_val, color_smooth)

f_apply_momentum(color base_c, bool expanding) =>
    expanding ? base_c : color.new(base_c, 50)

// Calculate ratio against bands for color intensity
float ratio_top = not na(upper_band) and upper_band != 0 ? math.abs(osc_val / upper_band) : 0
float ratio_bot = not na(lower_band) and lower_band != 0 ? math.abs(osc_val / lower_band) : 0

color hist_color = na
if osc_val >= 0
    color base_c = na
    if ratio_top <= 1.0
        base_c := color.from_gradient(ratio_top, 0, 1, color.blue, color.aqua)
    else
        base_c := color.from_gradient(math.min(ratio_top - 1.0, 0.5), 0, 0.5, color.aqua, color.lime)
    hist_color := f_apply_momentum(base_c, is_expanding_up)
else
    color base_c = na
    if ratio_bot <= 1.0
        base_c := color.from_gradient(ratio_bot, 0, 1, color.yellow, color.orange)
    else
        base_c := color.from_gradient(math.min(ratio_bot - 1.0, 0.5), 0, 0.5, color.orange, color.red)
    hist_color := f_apply_momentum(base_c, is_expanding_dn)

// =========================================================================
// RENDERING
// =========================================================================
hline(0, "Equilibrium (Zero Effort)", color.gray, linestyle=hline.style_dashed)

// Plot Main Effort Gradient Histogram
plot(osc_val, "HAV Effort Gradient", color=hist_color, style=plot.style_columns)

// Plot Volatility Bands (Effort Extremes)
plot(show_sd_bands ? upper_band : na, "Extreme Upward Effort", color=color.new(color.aqua, 40), style=plot.style_linebr)
plot(show_sd_bands ? lower_band : na, "Extreme Downward Effort", color=color.new(color.red, 40), style=plot.style_linebr)

// Plot Signal Line
plot(signal, "Signal Line", color=color.new(color.white, 20), linewidth=2)

// Plot Kinetic Exhaustion Signals (Stars)
plotchar(kinetic_exhaustion ? signal : na, "Kinetic Exhaustion", char="✧", location=location.absolute, color=color.white, size=size.tiny)

// Mark Anomaly Triggers visually on the 0 line with directional coloring
color trigger_color = is_anomaly ? (close >= open ? color.blue : color.yellow) : na
plotchar(is_anomaly ? 0 : na, "Liquidity Event Trigger", char="▲", location=location.absolute, color=trigger_color, size=size.tiny)

// Alerts
alertcondition(is_anomaly, "Liquidity Event", "Volume anomaly detected. New HAV anchor established.")
alertcondition(exhaustion_peak, "Effort Exhaustion (Short)", "Upward kinetic effort has peaked out of bounds and is decaying.")
alertcondition(exhaustion_trough, "Effort Exhaustion (Long)", "Downward kinetic effort has bottomed out of bounds and is decaying.")
