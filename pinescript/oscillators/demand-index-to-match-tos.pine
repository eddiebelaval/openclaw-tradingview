// This indicator tries to replicate the Thinkorswim DemandIndex study
// Created with the help of DeepSeek assignment
// Log: Version 1 Wed Mar 18 12:20:03 PM EST 2026:
//  Created script with DeepSeek and fixed issues with AI generated code 

//@version=6
indicator("DM Index", shorttitle="DMIndx", overlay=false)

// Input
length = input.int(5, title="Length")

// Calculations
wClose = (high + low + 2 * close) * 0.25
wCRatio = (wClose - wClose[1]) / math.min(wClose, wClose[1])
closeRatio = 3 * wClose / ta.sma(ta.highest(high, 2) - ta.lowest(low, 2), length) * math.abs(wCRatio)
volumeRatio = volume / ta.sma(volume, length)
volumePerClose = volumeRatio / math.exp(math.min(88, closeRatio))

// Initialize variables
var float buyP = 0
var float sellP = 0

// Conditional assignment
if wCRatio > 0
    buyP := volumeRatio
    sellP := volumePerClose
else
    buyP := volumePerClose
    sellP := volumeRatio

// Running averages (handling NaN values)
var float buyPres = 0.0
var float sellPres = 0.0

buyPres := ((nz(buyPres[1], 0) * (length - 1)) + buyP) / length
sellPres := ((nz(sellPres[1], 0) * (length - 1)) + sellP) / length

// tempDI calculation
float tempDI = 0.00
if ((sellPres[1] * (length - 1) + sellP) / length - (buyPres[1] * (length - 1) + buyP) / length) > 0
    tempDI := - (sellPres != 0 ? buyPres / sellPres : 1)
else
    tempDI := (buyPres != 0 ? sellPres / buyPres : 1)

// Final DM Index plot
DMIndx = not na(close) ? (tempDI < 0 ? -1 - tempDI : 1 - tempDI) : na
ZeroLine = 0

//plot(DMIndx, title="DM Index", color=color.blue, linewidth=1)
plot(DMIndx, title="DM Index", color=DMIndx >= 0 ? color.new(color.green, 0) : color.new(color.red, 0), linewidth=2)
plot(ZeroLine, title="Zero Line", color=color.gray, linewidth=1)

// Fill between DM Index and Zero Line
// fill(plot(DMIndx), plot(ZeroLine), color=DMIndx > 0 ? color.green : color.red)
