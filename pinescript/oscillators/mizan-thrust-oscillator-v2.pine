//@version=5
indicator("MIZAN Thrust Oscillator v2", shorttitle="MIZAN_THRUST_OSC", overlay=false)

// ==========================================
// INPUTS
// ==========================================
len_smooth = input.int(7, "Thrust EMA")
len_norm   = input.int(100, "Normalization Length")
ex_level   = input.float(0.8, "Exhaustion Level")

// ==========================================
// MANUEL TANH
// ==========================================
f_tanh(x) =>
    ex = math.exp(x)
    em = math.exp(-x)
    (ex - em) / (ex + em)

// ==========================================
// THRUST CORE
// ==========================================
rv = volume / ta.sma(volume, 50)
pc = ta.change(close)

th_raw = ta.ema(math.log(1 + math.abs(pc * rv)) * math.sign(pc), len_smooth)

// ==========================================
// NORMALIZATION (Z-Score)
// ==========================================
mean = ta.sma(th_raw, len_norm)
std  = ta.stdev(th_raw, len_norm)

z = std != 0 ? (th_raw - mean) / std : 0
th_osc = f_tanh(z)

// ==========================================
// COLOR ENGINE (Strength Based)
// ==========================================
strength = math.min(math.abs(th_osc), 1)

osc_color = th_osc >= 0 
     ? color.new(color.lime, 80 - int(strength * 80)) 
     : color.new(color.red, 80 - int(strength * 80))

// ==========================================
// PLOTS
// ==========================================
hline(0, "Zero Line", color=color.gray)
hline(ex_level, "Upper Exhaustion", color=color.red)
hline(-ex_level, "Lower Exhaustion", color=color.lime)

plot(th_osc, color=osc_color, linewidth=2)

// Background phase coloring
bgcolor(th_osc > 0 ? color.new(color.green, 92) : color.new(color.red, 92))

// ==========================================
// SIGNAL LOGIC
// ==========================================
buy_signal  = ta.crossover(th_osc, 0)
sell_signal = ta.crossunder(th_osc, 0)

ex_buy  = ta.crossover(th_osc, -ex_level)
ex_sell = ta.crossunder(th_osc, ex_level)

// ==========================================
// ARROWS
// ==========================================
plotshape(buy_signal,  title="BUY",  
     location=location.bottom, 
     color=color.lime,  
     style=shape.arrowup,   
     size=size.small)

plotshape(sell_signal, title="SELL", 
     location=location.top,    
     color=color.red,   
     style=shape.arrowdown, 
     size=size.small)

plotshape(ex_buy,  
     title="Exhaustion Buy",  
     location=location.bottom, 
     color=color.green, 
     style=shape.triangleup,   
     size=size.tiny)

plotshape(ex_sell, 
     title="Exhaustion Sell", 
     location=location.top,    
     color=color.maroon,
     style=shape.triangledown, 
     size=size.tiny)

// ==========================================
// ALERTS
// ==========================================
alertcondition(buy_signal,  "BUY Signal",  "Mizan Thrust BUY")
alertcondition(sell_signal, "SELL Signal", "Mizan Thrust SELL")
