//@version=5
indicator("QQE Momentum Pulse Pro [identityKa]", overlay=false)

// ==========================================
// 1. USER INPUTS (GLOBAL ENGLISH)
// ==========================================
grp1 = "⚙️ Momentum (QQE) Settings"
rsi_len = input.int(14, "RSI Period", group=grp1)
rsi_smooth = input.int(5, "RSI Smoothing Length", group=grp1)
use_hma = input.bool(true, "Zero-Lag Engine (HMA)", group=grp1, tooltip="Replaces standard EMA smoothing with Hull Moving Average for instant momentum reaction.")
qqe_factor = input.float(4.236, "QQE Fast Factor", tooltip="Lower = Faster signals. Higher = Holds trend longer.", group=grp1)

grp2 = "🎨 identityKa Theme (Pulse Colors)"
col_grow_above = input.color(#00ffbb, "Strong Bullish (Neon Green)", group=grp2)
col_fall_above = input.color(color.new(#00796B, 0), "Weak Bullish (Dark Green)", group=grp2)
col_grow_below = input.color(#ff1744, "Strong Bearish (Neon Red)", group=grp2)
col_fall_below = input.color(color.new(#880E4F, 0), "Weak Bearish (Dark Red)", group=grp2)

grp3 = "📊 HUD Dashboard Settings"
show_dash = input.bool(true, "Show Dashboard", group=grp3)
dash_pos = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], group=grp3)
dash_size = input.string("Small", "Dashboard Text Size", options=["Tiny", "Small", "Normal", "Large"], group=grp3)

// ==========================================
// 2. QQE MATHEMATICAL ENGINE (LAG-FREE)
// ==========================================
wilders_period = rsi_len * 2 - 1

// Base RSI
rsi_val = ta.rsi(close, rsi_len)

// Zero-Lag Smoothing Option
rsi_smoothed = use_hma ? ta.hma(rsi_val, rsi_smooth) : ta.ema(rsi_val, rsi_smooth)

// ATR of smoothed RSI
atr_rsi = math.abs(rsi_smoothed[1] - rsi_smoothed)
atr_rsi_ema = ta.ema(atr_rsi, wilders_period)
dar = ta.ema(atr_rsi_ema, wilders_period) * qqe_factor

var float longband = 0.0
var float shortband = 0.0
var int trend = 0

newshortband = rsi_smoothed + dar
newlongband = rsi_smoothed - dar

longband := rsi_smoothed[1] > longband[1] and rsi_smoothed > longband[1] ? math.max(longband[1], newlongband) : newlongband
shortband := rsi_smoothed[1] < shortband[1] and rsi_smoothed < shortband[1] ? math.min(shortband[1], newshortband) : newshortband

cross_1 = ta.cross(longband[1], rsi_smoothed)
trend := ta.cross(rsi_smoothed, shortband[1]) ? 1 : cross_1 ? -1 : nz(trend[1], 1)

fast_atr_rsi_tl = trend == 1 ? longband : shortband

// ==========================================
// 3. MOMENTUM PULSE (HISTOGRAM)
// ==========================================
// Difference creates the zero-line oscillating histogram
pulse = rsi_smoothed - fast_atr_rsi_tl

// ==========================================
// 4. VISUALIZATION
// ==========================================
pulse_color = pulse > 0 ? (pulse > pulse[1] ? col_grow_above : col_fall_above) : (pulse < pulse[1] ? col_grow_below : col_fall_below)

plot(pulse, title="Momentum Pulse", style=plot.style_columns, color=pulse_color, linewidth=2)
hline(0, color=color.new(color.gray, 50), linestyle=hline.style_dashed, title="Zero Line") 

// ==========================================
// 5. PREMIUM DASHBOARD & AI SUGGESTION
// ==========================================
// AI Logic: Dangerous when momentum is fading (failing to make higher highs / lower lows)
bool is_fading = (pulse > 0 and pulse < pulse[1]) or (pulse < 0 and pulse > pulse[1])
string ai_suggestion = is_fading ? "Dangerous" : pulse > 0 ? "LONG" : "SHORT"
color ai_color = ai_suggestion == "LONG" ? col_grow_above : ai_suggestion == "SHORT" ? col_grow_below : color.new(#ff9800, 0)

var string p_pos = dash_pos == "Top Right" ? position.top_right : dash_pos == "Top Left" ? position.top_left : dash_pos == "Bottom Right" ? position.bottom_right : dash_pos == "Bottom Left" ? position.bottom_left : dash_pos == "Middle Right" ? position.middle_right : position.middle_left
var string p_size = dash_size == "Tiny" ? size.tiny : dash_size == "Small" ? size.small : dash_size == "Normal" ? size.normal : size.large

if barstate.islast and show_dash
    var table hud = table.new(p_pos, 2, 3, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 80))
    table.cell(hud, 0, 0, "IDENTITYKA", text_color=color.white, text_size=p_size)
    table.cell(hud, 1, 0, "QQE ENGINE", text_color=color.white, text_size=p_size)
    
    table.cell(hud, 0, 1, "MOMENTUM STATE", text_color=color.gray, text_size=p_size)
    table.cell(hud, 1, 1, pulse > 0 ? "BULLISH" : "BEARISH", text_color=pulse > 0 ? col_grow_above : col_grow_below, text_size=p_size)
    
    table.cell(hud, 0, 2, "AI SUGGESTION", text_color=color.gray, text_size=p_size)
    table.cell(hud, 1, 2, ai_suggestion, text_color=ai_color, text_size=p_size)

// ==========================================
// 6. ALERTS
// ==========================================
alertcondition(ta.crossover(pulse, 0), title="🟢 QQE Bullish Crossing", message="identityKa: QQE Momentum crossed ABOVE zero line (LONG).")
alertcondition(ta.crossunder(pulse, 0), title="🔴 QQE Bearish Crossing", message="identityKa: QQE Momentum crossed BELOW zero line (SHORT).")
alertcondition(is_fading and not is_fading[1], title="⚠️ Momentum Fading", message="identityKa: Momentum is actively losing strength. Watch for reversal or consolidation.")
