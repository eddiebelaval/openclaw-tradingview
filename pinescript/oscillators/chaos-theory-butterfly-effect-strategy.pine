//@version=6
strategy("Chaos Theory - Butterfly Effect Strategy", 
         shorttitle="Chaos Strategy", 
         overlay=true, 
         initial_capital=10000, 
         default_qty_type=strategy.percent_of_equity, 
         default_qty_value=10, 
         commission_type=strategy.commission.percent, 
         commission_value=0.1,
         pyramiding=0)

// ============================================================================
// INPUTS
// ============================================================================

// Sensitivity Parameters (Butterfly Effect)
sensitivityPeriod = input.int(21, "Sensitivity Period", minval=5, maxval=100, 
                               tooltip="Captures small initial condition changes")
volatilityMultiplier = input.float(1.5, "Volatility Multiplier", minval=0.5, maxval=5.0, step=0.1,
                                    tooltip="Amplifies sensitivity to price changes")

// Strange Attractor (Fractal Pattern Detection)
fastLength = input.int(13, "Fast Attractor Length", minval=3, maxval=50)
slowLength = input.int(34, "Slow Attractor Length", minval=10, maxval=200)
signalLength = input.int(8, "Signal Smoothing", minval=3, maxval=20)

// Chaos Threshold
chaosThreshold = input.float(0.8, "Chaos Entry Threshold", minval=0.3, maxval=3.0, step=0.1,
                             tooltip="Higher values = stronger chaos signal required")

// Trend Filter
useTrendFilter = input.bool(true, "Use Trend Filter", tooltip="Only trade in direction of major trend")
trendPeriod = input.int(89, "Trend Period", minval=20, maxval=200)

// Risk Management
stopLossPercent = input.float(3.5, "Stop Loss %", minval=0.5, maxval=10.0, step=0.5)
takeProfitPercent = input.float(7.0, "Take Profit %", minval=1.0, maxval=20.0, step=0.5)
useTrailingStop = input.bool(true, "Use Trailing Stop")
trailingStopPercent = input.float(2.0, "Trailing Stop %", minval=0.5, maxval=10.0, step=0.5)

// ============================================================================
// CHAOS THEORY CALCULATIONS
// ============================================================================

// 1. SENSITIVITY TO INITIAL CONDITIONS (Butterfly Effect)
// Measures rate of change and acceleration in price movements
roc = ta.roc(close, sensitivityPeriod)
acceleration = ta.change(roc, 1)
volatility = ta.atr(sensitivityPeriod)

// Avoid division by zero
sensitivityIndex = volatility > 0 ? math.abs(acceleration) / volatility * 100 : 0

// 2. DETERMINISTIC CHAOS OSCILLATOR
// Uses exponential moving averages for better responsiveness
ema_fast = ta.ema(close, fastLength)
ema_slow = ta.ema(close, slowLength)

// Chaos deviation - normalized by ATR to handle different price scales
chaosDeviation = volatility > 0 ? (ema_fast - ema_slow) / (volatility * volatilityMultiplier) : 0

// Smoothed signal line (strange attractor pattern)
signalLine = ta.ema(chaosDeviation, signalLength)

// 3. FRACTAL DIMENSION APPROXIMATION
// Detects self-similar patterns across timeframes
highestHigh = ta.highest(high, sensitivityPeriod)
lowestLow = ta.lowest(low, sensitivityPeriod)
priceRange = highestHigh - lowestLow

// Fractal complexity indicator
fractalComplexity = priceRange > 0 ? volatility / priceRange : 0

// 4. MOMENTUM CONFIRMATION
// RSI-based momentum to confirm chaos signals
rsi = ta.rsi(close, 14)
momentumBullish = rsi > 40 and rsi < 70
momentumBearish = rsi < 60 and rsi > 30

// 5. TREND FILTER
trendEMA = ta.ema(close, trendPeriod)
uptrend = close > trendEMA
downtrend = close < trendEMA

// 6. VOLATILITY FILTER
// Only trade when there's sufficient market movement
avgVolatility = ta.sma(volatility, 20)
sufficientVolatility = volatility > avgVolatility * 0.7

// ============================================================================
// ENTRY CONDITIONS
// ============================================================================

// Bullish Chaos Signal
// - Chaos deviation crosses above signal (system shifting to new attractor)
// - Chaos deviation is positive and above threshold
// - Momentum confirmation
// - Trend alignment (if filter enabled)
bullishSetup = ta.crossover(chaosDeviation, signalLine) and 
               chaosDeviation > chaosThreshold and 
               momentumBullish and
               sufficientVolatility

bullishChaos = useTrendFilter ? (bullishSetup and uptrend) : bullishSetup

// Bearish Chaos Signal
bearishSetup = ta.crossunder(chaosDeviation, signalLine) and 
               chaosDeviation < -chaosThreshold and 
               momentumBearish and
               sufficientVolatility

bearishChaos = useTrendFilter ? (bearishSetup and downtrend) : bearishSetup

// ============================================================================
// POSITION MANAGEMENT
// ============================================================================

// Entry Prices
var float longEntry = na
var float shortEntry = na

// Long Entry
if bullishChaos and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    longEntry := close

// Short Entry
if bearishChaos and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    shortEntry := close

// Exit Conditions (Stop Loss & Take Profit)
if strategy.position_size > 0  // Long position
    stopLevel = longEntry * (1 - stopLossPercent / 100)
    profitLevel = longEntry * (1 + takeProfitPercent / 100)
    
    if useTrailingStop
        trailStop = close * (1 - trailingStopPercent / 100)
        strategy.exit("Exit Long", "Long", stop=stopLevel, limit=profitLevel, trail_price=close, trail_offset=trailingStopPercent)
    else
        strategy.exit("Exit Long", "Long", stop=stopLevel, limit=profitLevel)

if strategy.position_size < 0  // Short position
    stopLevel = shortEntry * (1 + stopLossPercent / 100)
    profitLevel = shortEntry * (1 - takeProfitPercent / 100)
    
    if useTrailingStop
        trailStop = close * (1 + trailingStopPercent / 100)
        strategy.exit("Exit Short", "Short", stop=stopLevel, limit=profitLevel, trail_price=close, trail_offset=trailingStopPercent)
    else
        strategy.exit("Exit Short", "Short", stop=stopLevel, limit=profitLevel)

// Emergency exit on opposite signal
if strategy.position_size > 0 and bearishChaos
    strategy.close("Long", comment="Reverse Signal")

if strategy.position_size < 0 and bullishChaos
    strategy.close("Short", comment="Reverse Signal")

// ============================================================================
// VISUALIZATION
// ============================================================================

// Plot Chaos Deviation and Signal
plot(chaosDeviation, "Chaos Deviation", color=color.new(color.blue, 0), linewidth=2)
plot(signalLine, "Signal Line", color=color.new(color.orange, 0), linewidth=2)

// Chaos Threshold Levels
hline(chaosThreshold, "Upper Threshold", color=color.new(color.green, 50), linestyle=hline.style_dashed)
hline(-chaosThreshold, "Lower Threshold", color=color.new(color.red, 50), linestyle=hline.style_dashed)
hline(0, "Equilibrium", color=color.new(color.gray, 70))

// Histogram for better visualization
histColor = chaosDeviation > signalLine ? color.new(color.green, 70) : color.new(color.red, 70)
plot(chaosDeviation - signalLine, "Chaos Histogram", color=histColor, style=plot.style_histogram, linewidth=2)

// Background color for trend
bgcolor(useTrendFilter and uptrend ? color.new(color.green, 95) : 
        useTrendFilter and downtrend ? color.new(color.red, 95) : na, title="Trend Background")

// Entry signals
plotshape(bullishChaos, "Bullish Chaos", shape.triangleup, location.belowbar, 
          color=color.new(color.green, 0), size=size.small, text="BUY")
plotshape(bearishChaos, "Bearish Chaos", shape.triangledown, location.abovebar, 
          color=color.new(color.red, 0), size=size.small, text="SELL")

// Plot trend EMA on chart
plot(useTrendFilter ? trendEMA : na, "Trend EMA", color=color.new(color.purple, 0), linewidth=2)

// ============================================================================
// PERFORMANCE TABLE (OPTIONAL)
// ============================================================================

// Display key metrics
var table perfTable = table.new(position.top_right, 2, 4, border_width=1)

if barstate.islast
    table.cell(perfTable, 0, 0, "Metric", bgcolor=color.gray, text_color=color.white)
    table.cell(perfTable, 1, 0, "Value", bgcolor=color.gray, text_color=color.white)
    
    table.cell(perfTable, 0, 1, "Chaos Dev", text_color=color.white)
    table.cell(perfTable, 1, 1, str.tostring(math.round(chaosDeviation, 2)), 
               bgcolor=chaosDeviation > 0 ? color.green : color.red, text_color=color.white)
    
    table.cell(perfTable, 0, 2, "Signal", text_color=color.white)
    table.cell(perfTable, 1, 2, str.tostring(math.round(signalLine, 2)), text_color=color.white)
    
    table.cell(perfTable, 0, 3, "Volatility", text_color=color.white)
    table.cell(perfTable, 1, 3, str.tostring(math.round(volatility, 2)), text_color=color.white)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(bullishChaos, "Bullish Chaos Signal", "🦋 Butterfly Effect: Long Entry Detected")
alertcondition(bearishChaos, "Bearish Chaos Signal", "🦋 Butterfly Effect: Short Entry Detected")
alertcondition(math.abs(chaosDeviation) > 2.5, "Extreme Chaos", "⚠️ Market entering highly chaotic state")
