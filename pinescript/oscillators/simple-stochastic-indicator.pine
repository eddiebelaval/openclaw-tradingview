//@version=5
indicator("Simple Stochastic Indicator", overlay=false)

// Inputs
kLength = input.int(14, title="K Length")
dLength = input.int(3, title="D Length")
smoothK = input.int(3, title="Smooth K")

// Calculate Stochastic
k = ta.sma(ta.stoch(close, high, low, kLength), smoothK)
d = ta.sma(k, dLength)

// Plot lines
plot(k, title="%K Line", color=color.blue, linewidth=2)
plot(d, title="%D Line", color=color.orange, linewidth=2)

// Overbought and Oversold levels
hline(80, title="Overbought", color=color.red)
hline(20, title="Oversold", color=color.green)
