//@version=6
indicator("Aura Trend Momentum [Pineify]", "Aura Trend", overlay=false, max_bars_back=5000)

// -----------------------------------------------------------------------------
// Inputs & Settings
// -----------------------------------------------------------------------------
grpSettings = "Oscillator Settings"
length = input.int(21, "Trend Length", group=grpSettings, tooltip="Main lookback period for momentum.")
smooth = input.int(9, "Signal Smoothing", group=grpSettings, tooltip="Smoothing for the signal line and noise reduction.")
src = input.source(close, "Source", group=grpSettings)

grpStyle = "Visuals & Colors"
colBullStrong = input.color(#00E676, "Bullish Strong", group=grpStyle)
colBullWeak = input.color(#1DE9B6, "Bullish Weak", group=grpStyle)
colBearStrong = input.color(#FF1744, "Bearish Strong", group=grpStyle)
colBearWeak = input.color(#FF8A80, "Bearish Weak", group=grpStyle)
colSignal = input.color(color.new(color.white, 30), "Signal Line", group=grpStyle)

// -----------------------------------------------------------------------------
// Calculations
// -----------------------------------------------------------------------------
// Double-smoothed momentum approach to eliminate market noise
// Calculate price change (momentum) from previous bar
diff = src - src[1]

// Apply double EMA smoothing to the momentum
smoothDiff = ta.ema(ta.ema(diff, length), smooth)

// Apply double EMA smoothing to absolute momentum for normalization
smoothAbs = ta.ema(ta.ema(math.abs(diff), length), smooth)

// Normalize between -100 and 100 for easy reading
osc = smoothAbs == 0 ? 0 : (100 * (smoothDiff / smoothAbs))
signal = ta.ema(osc, smooth)

// -----------------------------------------------------------------------------
// Colors & Styling Logic
// -----------------------------------------------------------------------------
isBull = osc > 0
isRising = osc > osc[1]

// Four-color gradient system for momentum columns
histCol = isBull ? (isRising ? colBullStrong : colBullWeak) : (not isRising ? colBearStrong : colBearWeak)

// -----------------------------------------------------------------------------
// Plots & Visuals
// -----------------------------------------------------------------------------
// Background reference lines
hline(50, "Overbought", color.new(color.gray, 60), hline.style_dashed)
hline(0, "Zero Line", color.new(color.gray, 40), hline.style_solid)
hline(-50, "Oversold", color.new(color.gray, 60), hline.style_dashed)

// Beautiful glowing histogram and lines
plot(osc, "Histogram", color=color.new(histCol, 60), style=plot.style_columns, linewidth=4)
pOsc = plot(osc, "Aura Line", color=histCol, linewidth=2)
pSig = plot(signal, "Signal Line", color=colSignal, linewidth=2)

// Cloud fill between Oscillator and Signal to visually highlight who is in control
fill(pOsc, pSig, osc > signal ? color.new(colBullStrong, 80) : color.new(colBearStrong, 80), "Trend Cloud")

// -----------------------------------------------------------------------------
// Trading Signals (Dots) & Alerts
// -----------------------------------------------------------------------------
// Look for crossovers happening in optimal zones
bullCross = ta.crossover(osc, signal) and osc < 0
bearCross = ta.crossunder(osc, signal) and osc > 0

plotshape(bullCross ? osc : na, "Bullish Entry", shape.circle, location.absolute, colBullStrong, size=size.tiny)
plotshape(bearCross ? osc : na, "Bearish Entry", shape.circle, location.absolute, colBearStrong, size=size.tiny)

alertcondition(bullCross, "Buy Signal", "Aura Trend indicates a Bullish reversal.")
alertcondition(bearCross, "Sell Signal", "Aura Trend indicates a Bearish reversal.")
