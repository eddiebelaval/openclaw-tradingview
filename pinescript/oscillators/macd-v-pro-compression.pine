//@version=6
indicator(title='MACD-V Pro + Compression', shorttitle='MACD-V Pro C', overlay=false)

// Inputs
fastLength   = input.int(12, title='Fast Length')
slowLength   = input.int(26, title='Slow Length')
signalLength = input.int(9, title='Signal Length')
atrLength    = input.int(26, title='ATR Length')
src          = input.source(close, title='Source')

// Bands
bbLen        = input.int(20, title='Band Length')
bbMult       = input.float(2.0, title='Band StdDev Mult', step=0.1)
showBB       = input.bool(true, title='Show Bands')
showBBFill   = input.bool(true, title='Fill Bands')

// Display
showCloud        = input.bool(true, title='Show Cloud')
showHistogram    = input.bool(true, title='Show Histogram')
showSignal       = input.bool(true, title='Show Signal Line')
cloudTransp      = input.int(85, title='Cloud Transparency', minval=0, maxval=100)

// Compression
showCompression       = input.bool(true, title='Show Compression Detection')
compressionMode       = input.string('Both', title='Compression Mode', options=['Histogram', 'Band Width', 'Both'])
compressionLen        = input.int(20, title='Compression Average Length', minval=2)
histCompressionThresh = input.float(0.60, title='Histogram Compression Threshold x Avg', step=0.05)
bandCompressionThresh = input.float(0.70, title='Band Width Compression Threshold x Avg', step=0.05)
expansionThresh       = input.float(1.20, title='Expansion Threshold x Avg', step=0.05)
highlightCompression  = input.bool(true, title='Highlight Compression Background')
showIgnitionMarkers   = input.bool(true, title='Show Expansion After Compression')

// Colors
bullColor         = input.color(color.lime, 'Bull Regime Color')
bearColor         = input.color(color.red, 'Bear Regime Color')
neutralColor      = input.color(color.white, 'Neutral Color')
signalColor       = input.color(#ff299b, 'Signal Color')
compressionColor  = input.color(color.white, 'Compression Color')
ignitionBullColor = input.color(color.aqua, 'Bull Ignition Color')
ignitionBearColor = input.color(color.fuchsia, 'Bear Ignition Color')

// Calculations
fastEMA   = ta.ema(src, fastLength)
slowEMA   = ta.ema(src, slowLength)
macdLine  = fastEMA - slowEMA
atrValue  = ta.atr(atrLength)

float macdV  = atrValue != 0 ? (macdLine / atrValue) * 100 : na
float signal = ta.ema(macdV, signalLength)
float hist   = macdV - signal

// Bands on MACD-V
bbBasis = ta.ema(macdV, bbLen)
bbDev   = ta.stdev(macdV, bbLen) * bbMult
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
bandWidth = bbUpper - bbLower

// Signal slope filter
sigUp   = signal > signal[1]
sigDown = signal < signal[1]

// Regime color with slope confirmation
macdVColor = macdV > 50 and sigUp ? bullColor : macdV < -50 and sigDown ? bearColor : neutralColor

// Histogram compression logic
histAbs    = math.abs(hist)
histAbsAvg = ta.ema(histAbs, compressionLen)
histCompressed = histAbsAvg != 0 ? histAbs < histAbsAvg * histCompressionThresh : false
histExpanded   = histAbsAvg != 0 ? histAbs > histAbsAvg * expansionThresh : false

// Band-width compression logic
bandWidthAvg   = ta.ema(bandWidth, compressionLen)
bandCompressed = bandWidthAvg != 0 ? bandWidth < bandWidthAvg * bandCompressionThresh : false
bandExpanded   = bandWidthAvg != 0 ? bandWidth > bandWidthAvg * expansionThresh : false

// Final compression state
isCompressed = compressionMode == 'Histogram' ? histCompressed : compressionMode == 'Band Width' ? bandCompressed : (histCompressed and bandCompressed)

// Expansion logic
isExpanded = compressionMode == 'Histogram' ? histExpanded : compressionMode == 'Band Width' ? bandExpanded : (histExpanded or bandExpanded)

// Ignition after compression
bullIgnition = showCompression and isCompressed[1] and isExpanded and hist > 0
bearIgnition = showCompression and isCompressed[1] and isExpanded and hist < 0

// Histogram color
hColor = bullIgnition ? ignitionBullColor :
         bearIgnition ? ignitionBearColor :
         isCompressed ? compressionColor :
         hist >= 0 ? (hist > hist[1] ? color.new(color.blue, 0) : color.new(color.blue, 45)) :
         (hist > hist[1] ? color.new(color.purple, 45) : color.new(color.purple, 0))

// Plots
pMacd   = plot(macdV, title='MACD-V', color=macdVColor, linewidth=2)
pSignal = plot(showSignal ? signal : na, title='Signal', color=signalColor, linewidth=2)

plot(showHistogram ? hist : na, title='Histogram', color=hColor, style=plot.style_columns)

// Cloud
cloudColor = macdV >= signal ? color.new(bullColor, cloudTransp) : color.new(bearColor, cloudTransp)
fill(pMacd, pSignal, color = showCloud and showSignal ? cloudColor : color.new(color.white, 100))

// Bands
pUpper = plot(showBB ? bbUpper : na, title='Upper Band', color=color.new(color.white, 0), linewidth=1)
pLower = plot(showBB ? bbLower : na, title='Lower Band', color=color.new(color.white, 0), linewidth=1)
pBasis = plot(showBB ? bbBasis : na, title='EMA Basis', color=color.new(color.gray, 20), linewidth=1)

fill(pUpper, pLower, color = showBB and showBBFill ? color.new(color.white, 92) : na)

// Compression background
bgcolor(showCompression and highlightCompression and isCompressed ? color.new(color.white, 92) : na)

// Ignition markers
plotshape(showCompression and showIgnitionMarkers and bullIgnition, title='Bull Ignition', style=shape.circle, location=location.bottom, size=size.tiny, color=ignitionBullColor)
plotshape(showCompression and showIgnitionMarkers and bearIgnition, title='Bear Ignition', style=shape.circle, location=location.top, size=size.tiny, color=ignitionBearColor)

// Levels
hline(150, 'Extreme Overbought', color=color.red, linestyle=hline.style_dashed)
hline(50, 'Bull Regime', color=color.green, linestyle=hline.style_dotted)
hline(0, 'Zero Line', color=color.gray)
hline(-50, 'Bear Regime', color=color.orange, linestyle=hline.style_dotted)
hline(-150, 'Extreme Oversold', color=color.red, linestyle=hline.style_dashed)

// Alerts
alertcondition(ta.crossover(macdV, 50), 'MACD-V Crossed Above +50', 'MACD-V crossed above +50')
alertcondition(ta.crossunder(macdV, -50), 'MACD-V Crossed Below -50', 'MACD-V crossed below -50')
alertcondition(hist[1] >= 0 and hist < 0, 'Histogram Rising to Falling', 'MACD-V histogram switched from rising to falling')
alertcondition(hist[1] <= 0 and hist > 0, 'Histogram Falling to Rising', 'MACD-V histogram switched from falling to rising')
alertcondition(isCompressed, 'MACD-V Compression', 'MACD-V compression detected')
alertcondition(bullIgnition, 'Bull Ignition After Compression', 'MACD-V expanded bullishly after compression')
alertcondition(bearIgnition, 'Bear Ignition After Compression', 'MACD-V expanded bearishly after compression')
