// ═══════════════════════════════════════════════════════════════════════════════
// SMART MONEY CONFLUENCE INDICATOR v1.0
// ═══════════════════════════════════════════════════════════════════════════════
// Designed for ASX small/micro-cap equity analysis
// Combines: SMC Structure | MA Framework | RSI Divergence | Volume Anomaly
//           Fair Value Gaps | Confluence Scoring | On-Chart Dashboard
// Primary timeframe: Daily
// ═══════════════════════════════════════════════════════════════════════════════

//@version=5
indicator("Smart Money Confluence", shorttitle="SMC Flow", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ─── INPUTS ──────────────────────────────────────────────────────────────────

// SMC Structure
grp_smc     = "══ SMC Structure ══"
pivotLen    = input.int(5, "Pivot Lookback", minval=2, maxval=20, group=grp_smc, tooltip="Number of bars for swing high/low detection. Higher = fewer but stronger pivots.")
showCHoCH   = input.bool(true, "Show CHoCH Labels", group=grp_smc)
showBOS     = input.bool(true, "Show BOS Labels", group=grp_smc)
showSwings  = input.bool(true, "Show Swing High/Low Markers", group=grp_smc)
showFVG     = input.bool(true, "Show Fair Value Gaps", group=grp_smc)
fvgMinPct   = input.float(0.5, "FVG Min Size (%)", minval=0.1, step=0.1, group=grp_smc, tooltip="Minimum gap size as % of price to display")

// Moving Averages
grp_ma      = "══ Moving Averages ══"
maFastLen   = input.int(50, "Fast MA Length", group=grp_ma)
maSlowLen   = input.int(200, "Slow MA Length", group=grp_ma)
maType      = input.string("SMA", "MA Type", options=["SMA", "EMA"], group=grp_ma)
showMACross = input.bool(true, "Show Golden/Death Cross", group=grp_ma)

// RSI Divergence
grp_rsi     = "══ RSI Divergence ══"
rsiLen      = input.int(14, "RSI Length", group=grp_rsi)
rsiOB       = input.int(70, "Overbought Level", group=grp_rsi)
rsiOS       = input.int(30, "Oversold Level", group=grp_rsi)
divLookback = input.int(30, "Divergence Lookback Bars", minval=10, maxval=60, group=grp_rsi)
showRSIDiv  = input.bool(true, "Show RSI Divergence Signals", group=grp_rsi)

// Volume Anomaly
grp_vol     = "══ Volume Anomaly ══"
volLen      = input.int(20, "Volume MA Length", group=grp_vol)
volZThresh  = input.float(2.0, "Z-Score Threshold", minval=1.0, step=0.25, group=grp_vol, tooltip="Standard deviations above mean to flag as anomalous")
showVolSpk  = input.bool(true, "Show Volume Spike Markers", group=grp_vol)

// Dashboard
grp_dash    = "══ Dashboard ══"
showDash    = input.bool(true, "Show Dashboard Table", group=grp_dash)
dashPos     = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grp_dash)

// Confluence
grp_conf    = "══ Confluence Scoring ══"
showConfBG  = input.bool(true, "Show Confluence Background", group=grp_conf, tooltip="Green/red background tint when multiple signals align")

// ─── MOVING AVERAGES ─────────────────────────────────────────────────────────

maFast = maType == "SMA" ? ta.sma(close, maFastLen) : ta.ema(close, maFastLen)
maSlow = maType == "SMA" ? ta.sma(close, maSlowLen) : ta.ema(close, maSlowLen)

plot(maFast, "Fast MA", color=color.new(color.blue, 20), linewidth=2)
plot(maSlow, "Slow MA", color=color.new(color.red, 20), linewidth=2)

// Golden / Death Cross detection
goldenCross = ta.crossover(maFast, maSlow)
deathCross  = ta.crossunder(maFast, maSlow)

priceAboveFast = close > maFast
priceAboveSlow = close > maSlow

if showMACross and goldenCross
    label.new(bar_index, low * 0.995, "GOLDEN\nCROSS", style=label.style_label_up, color=color.new(color.green, 10), textcolor=color.white, size=size.small)

if showMACross and deathCross
    label.new(bar_index, high * 1.005, "DEATH\nCROSS", style=label.style_label_down, color=color.new(color.red, 10), textcolor=color.white, size=size.small)


// ─── SMC STRUCTURE — SWING HIGHS / LOWS ──────────────────────────────────────

// Detect pivot highs and lows
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

// Track structure
var float lastHH  = na
var float lastHL  = na
var float lastLH  = na
var float lastLL  = na
var float prevSwingHigh = na
var float prevSwingLow  = na
var int   trend   = 0    // 1 = bullish, -1 = bearish, 0 = neutral

// Store swing levels for structure tracking
var float swingHigh1 = na
var float swingHigh2 = na
var float swingLow1  = na
var float swingLow2  = na

// CHoCH and BOS signals
var bool choch_bull = false
var bool choch_bear = false
var bool bos_bull   = false
var bool bos_bear   = false

choch_bull := false
choch_bear := false
bos_bull   := false
bos_bear   := false

if not na(ph)
    swingHigh2 := swingHigh1
    swingHigh1 := ph
    
    if showSwings
        label.new(bar_index - pivotLen, ph, "SH", style=label.style_label_down, color=color.new(color.red, 60), textcolor=color.white, size=size.tiny)
    
    // Structure analysis
    if not na(swingHigh2)
        if ph > swingHigh2  // Higher High
            if trend == -1
                choch_bull := true  // Change of Character — bearish to bullish
            else
                bos_bull := true    // Break of Structure — continuation
            trend := 1
        else if ph < swingHigh2  // Lower High
            if trend == 1
                choch_bear := true
            trend := -1

if not na(pl)
    swingLow2 := swingLow1
    swingLow1 := pl
    
    if showSwings
        label.new(bar_index - pivotLen, pl, "SL", style=label.style_label_up, color=color.new(color.green, 60), textcolor=color.white, size=size.tiny)
    
    if not na(swingLow2)
        if pl > swingLow2  // Higher Low
            if trend == -1
                choch_bull := true
            trend := 1
        else if pl < swingLow2  // Lower Low
            if trend == 1
                choch_bear := true
            else
                bos_bear := true
            trend := -1

// Plot CHoCH and BOS labels
if showCHoCH and choch_bull
    label.new(bar_index - pivotLen, low * 0.99, "CHoCH ▲", style=label.style_label_up, color=color.new(#00C853, 0), textcolor=color.white, size=size.normal)

if showCHoCH and choch_bear
    label.new(bar_index - pivotLen, high * 1.01, "CHoCH ▼", style=label.style_label_down, color=color.new(#FF1744, 0), textcolor=color.white, size=size.normal)

if showBOS and bos_bull
    label.new(bar_index - pivotLen, low * 0.993, "BOS ▲", style=label.style_label_up, color=color.new(#00C853, 60), textcolor=color.white, size=size.small)

if showBOS and bos_bear
    label.new(bar_index - pivotLen, high * 1.007, "BOS ▼", style=label.style_label_down, color=color.new(#FF1744, 60), textcolor=color.white, size=size.small)


// ─── FAIR VALUE GAPS (FVG) ───────────────────────────────────────────────────

// Bullish FVG: Bar[2] high < Bar[0] low (gap up)
// Bearish FVG: Bar[2] low > Bar[0] high (gap down)

bullFVG = low > high[2] and (low - high[2]) / close * 100 >= fvgMinPct
bearFVG = high < low[2] and (low[2] - high) / close * 100 >= fvgMinPct

if showFVG and bullFVG
    box.new(bar_index - 2, low, bar_index, high[2], bgcolor=color.new(color.green, 85), border_color=color.new(color.green, 60), border_width=1)

if showFVG and bearFVG
    box.new(bar_index - 2, low[2], bar_index, high, bgcolor=color.new(color.red, 85), border_color=color.new(color.red, 60), border_width=1)


// ─── RSI + DIVERGENCE ────────────────────────────────────────────────────────

rsiVal = ta.rsi(close, rsiLen)

// Bullish divergence: Price makes lower low, RSI makes higher low
// Bearish divergence: Price makes higher high, RSI makes lower high

// Find RSI pivot lows and highs
rsiPH = ta.pivothigh(rsiVal, pivotLen, pivotLen)
rsiPL = ta.pivotlow(rsiVal, pivotLen, pivotLen)

var float prevPriceLow  = na
var float prevRSILow    = na
var int   prevPriceLowBar = na
var float prevPriceHigh = na
var float prevRSIHigh   = na
var int   prevPriceHighBar = na

bullDiv = false
bearDiv = false

if not na(rsiPL)
    currPriceLow = low[pivotLen]
    currRSILow   = rsiPL
    currBar      = bar_index - pivotLen
    
    if not na(prevPriceLow) and (bar_index - prevPriceLowBar) <= divLookback
        // Bullish divergence: price lower low + RSI higher low
        if currPriceLow < prevPriceLow and currRSILow > prevRSILow
            bullDiv := true
    
    prevPriceLow    := currPriceLow
    prevRSILow      := currRSILow
    prevPriceLowBar := currBar

if not na(rsiPH)
    currPriceHigh = high[pivotLen]
    currRSIHigh   = rsiPH
    currBar       = bar_index - pivotLen
    
    if not na(prevPriceHigh) and (bar_index - prevPriceHighBar) <= divLookback
        // Bearish divergence: price higher high + RSI lower high
        if currPriceHigh > prevPriceHigh and currRSIHigh < prevRSIHigh
            bearDiv := true
    
    prevPriceHigh    := currPriceHigh
    prevRSIHigh      := currRSIHigh
    prevPriceHighBar := currBar

if showRSIDiv and bullDiv
    label.new(bar_index - pivotLen, low[pivotLen] * 0.985, "RSI\nBull Div", style=label.style_label_up, color=color.new(#2196F3, 0), textcolor=color.white, size=size.small)

if showRSIDiv and bearDiv
    label.new(bar_index - pivotLen, high[pivotLen] * 1.015, "RSI\nBear Div", style=label.style_label_down, color=color.new(#FF9800, 0), textcolor=color.white, size=size.small)


// ─── VOLUME ANOMALY ──────────────────────────────────────────────────────────

volMA   = ta.sma(volume, volLen)
volStd  = ta.stdev(volume, volLen)
volZ    = volStd != 0 ? (volume - volMA) / volStd : 0
volSpike = volZ >= volZThresh and volume > 0

// Classify spike as accumulation or distribution
volBullSpike = volSpike and close > open
volBearSpike = volSpike and close <= open

if showVolSpk and volBullSpike
    label.new(bar_index, low * 0.99, "VOL▲", style=label.style_label_up, color=color.new(#00BCD4, 20), textcolor=color.white, size=size.tiny)

if showVolSpk and volBearSpike
    label.new(bar_index, high * 1.01, "VOL▼", style=label.style_label_down, color=color.new(#E040FB, 20), textcolor=color.white, size=size.tiny)


// ─── ADDITIONAL SIGNALS ──────────────────────────────────────────────────────

// EQH / EQL Detection (Equal Highs / Equal Lows — liquidity pools)
eqhThreshold = input.float(0.3, "EQH/EQL Tolerance (%)", minval=0.1, step=0.1, group=grp_smc, tooltip="Percentage tolerance for equal highs/lows detection")
showEQHL     = input.bool(true, "Show Equal Highs/Lows", group=grp_smc)

isEQH = not na(swingHigh1) and not na(swingHigh2) and math.abs(swingHigh1 - swingHigh2) / swingHigh1 * 100 < eqhThreshold
isEQL = not na(swingLow1) and not na(swingLow2) and math.abs(swingLow1 - swingLow2) / swingLow1 * 100 < eqhThreshold

if showEQHL and not na(ph) and isEQH
    line.new(bar_index - pivotLen - 15, swingHigh1, bar_index - pivotLen, swingHigh1, color=color.new(color.red, 30), style=line.style_dashed, width=2)
    label.new(bar_index - pivotLen, swingHigh1 * 1.005, "EQH", style=label.style_none, textcolor=color.red, size=size.tiny)

if showEQHL and not na(pl) and isEQL
    line.new(bar_index - pivotLen - 15, swingLow1, bar_index - pivotLen, swingLow1, color=color.new(color.green, 30), style=line.style_dashed, width=2)
    label.new(bar_index - pivotLen, swingLow1 * 0.995, "EQL", style=label.style_none, textcolor=color.green, size=size.tiny)


// ─── CONFLUENCE SCORING ──────────────────────────────────────────────────────
// Score from -5 (max bearish) to +5 (max bullish)

var int confScore = 0
confScore := 0

// MA position (+1/-1 each)
confScore += priceAboveFast ? 1 : -1
confScore += priceAboveSlow ? 1 : -1

// Trend structure (+1/-1)
confScore += trend == 1 ? 1 : trend == -1 ? -1 : 0

// RSI zone (+1/-1 at extremes)
confScore += rsiVal < rsiOS ? 1 : rsiVal > rsiOB ? -1 : 0  // Contrarian: oversold = bullish signal

// Volume spike direction (+1/-1)
confScore += volBullSpike ? 1 : volBearSpike ? -1 : 0

// Background tint based on confluence
bgColor = confScore >= 3 ? color.new(color.green, 92) : confScore <= -3 ? color.new(color.red, 92) : na
bgcolor(showConfBG ? bgColor : na, title="Confluence Background")


// ─── DASHBOARD TABLE ─────────────────────────────────────────────────────────

if showDash and barstate.islast
    posY = str.contains(dashPos, "Top") ? position.top_right : position.bottom_right
    if dashPos == "Top Left"
        posY := position.top_left
    else if dashPos == "Bottom Left"
        posY := position.bottom_left
    else if dashPos == "Bottom Right"
        posY := position.bottom_right
    else
        posY := position.top_right

    var table dash = table.new(posY, 3, 12, bgcolor=color.new(color.white, 0), border_width=1, border_color=color.new(color.gray, 70))
    
    // Header
    table.cell(dash, 0, 0, "SMART MONEY CONFLUENCE", text_color=color.white, bgcolor=color.new(#1B3A5C, 0), text_size=size.small, text_halign=text.align_center)
    table.merge_cells(dash, 0, 0, 2, 0)
    
    // Confluence Score
    confLabel = confScore >= 3 ? "BULLISH" : confScore <= -3 ? "BEARISH" : confScore > 0 ? "LEAN BULL" : confScore < 0 ? "LEAN BEAR" : "NEUTRAL"
    confCol   = confScore >= 3 ? color.green : confScore <= -3 ? color.red : confScore > 0 ? color.new(color.green, 40) : confScore < 0 ? color.new(color.red, 40) : color.gray
    table.cell(dash, 0, 1, "Confluence", text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 1, str.tostring(confScore), text_size=size.tiny, text_halign=text.align_center)
    table.cell(dash, 2, 1, confLabel, text_color=confCol, text_size=size.tiny, text_halign=text.align_right)
    
    // Structure
    trendLabel = trend == 1 ? "BULLISH" : trend == -1 ? "BEARISH" : "NEUTRAL"
    trendCol   = trend == 1 ? color.green : trend == -1 ? color.red : color.gray
    table.cell(dash, 0, 2, "Structure", text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 2, trendLabel, text_color=trendCol, text_size=size.tiny, text_halign=text.align_center)
    table.cell(dash, 2, 2, trend == 1 ? "HH/HL" : trend == -1 ? "LH/LL" : "—", text_size=size.tiny, text_halign=text.align_right)
    
    // 50 MA
    ma50Label = priceAboveFast ? "ABOVE" : "BELOW"
    ma50Col   = priceAboveFast ? color.green : color.red
    table.cell(dash, 0, 3, str.tostring(maFastLen) + " MA", text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 3, str.tostring(maFast, "#.####"), text_size=size.tiny, text_halign=text.align_center)
    table.cell(dash, 2, 3, ma50Label, text_color=ma50Col, text_size=size.tiny, text_halign=text.align_right)
    
    // 200 MA
    ma200Label = priceAboveSlow ? "ABOVE" : "BELOW"
    ma200Col   = priceAboveSlow ? color.green : color.red
    table.cell(dash, 0, 4, str.tostring(maSlowLen) + " MA", text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 4, str.tostring(maSlow, "#.####"), text_size=size.tiny, text_halign=text.align_center)
    table.cell(dash, 2, 4, ma200Label, text_color=ma200Col, text_size=size.tiny, text_halign=text.align_right)
    
    // RSI
    rsiLabel = rsiVal > rsiOB ? "OVERBOUGHT" : rsiVal < rsiOS ? "OVERSOLD" : "NEUTRAL"
    rsiCol   = rsiVal > rsiOB ? color.red : rsiVal < rsiOS ? color.green : color.gray
    table.cell(dash, 0, 5, "RSI (14)", text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 5, str.tostring(rsiVal, "#.#"), text_size=size.tiny, text_halign=text.align_center)
    table.cell(dash, 2, 5, rsiLabel, text_color=rsiCol, text_size=size.tiny, text_halign=text.align_right)
    
    // Volume
    volLabel = volSpike ? (volBullSpike ? "BULL SPIKE" : "BEAR SPIKE") : "NORMAL"
    volCol   = volBullSpike ? color.green : volBearSpike ? color.red : color.gray
    table.cell(dash, 0, 6, "Volume", text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 6, str.tostring(volZ, "#.#") + "σ", text_size=size.tiny, text_halign=text.align_center)
    table.cell(dash, 2, 6, volLabel, text_color=volCol, text_size=size.tiny, text_halign=text.align_right)
    
    // Last CHoCH
    table.cell(dash, 0, 7, "Last CHoCH", text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 7, choch_bull ? "BULLISH" : choch_bear ? "BEARISH" : "—", text_color=choch_bull ? color.green : choch_bear ? color.red : color.gray, text_size=size.tiny, text_halign=text.align_center)
    table.cell(dash, 2, 7, "", text_size=size.tiny)
    
    // Last BOS
    table.cell(dash, 0, 8, "Last BOS", text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 8, bos_bull ? "BULLISH" : bos_bear ? "BEARISH" : "—", text_color=bos_bull ? color.green : bos_bear ? color.red : color.gray, text_size=size.tiny, text_halign=text.align_center)
    table.cell(dash, 2, 8, "", text_size=size.tiny)
    
    // RSI Divergence
    table.cell(dash, 0, 9, "RSI Div", text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 9, bullDiv ? "BULL DIV" : bearDiv ? "BEAR DIV" : "NONE", text_color=bullDiv ? color.green : bearDiv ? color.red : color.gray, text_size=size.tiny, text_halign=text.align_center)
    table.cell(dash, 2, 9, "", text_size=size.tiny)

    // EQH/EQL
    table.cell(dash, 0, 10, "EQH/EQL", text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 10, isEQH ? "EQH ACTIVE" : isEQL ? "EQL ACTIVE" : "NONE", text_color=isEQH ? color.orange : isEQL ? color.orange : color.gray, text_size=size.tiny, text_halign=text.align_center)
    table.cell(dash, 2, 10, "", text_size=size.tiny)
    
    // Swing levels
    table.cell(dash, 0, 11, "Swing H / L", text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 11, str.tostring(swingHigh1, "#.####"), text_size=size.tiny, text_halign=text.align_center, text_color=color.red)
    table.cell(dash, 2, 11, str.tostring(swingLow1, "#.####"), text_size=size.tiny, text_halign=text.align_right, text_color=color.green)


// ─── ALERT CONDITIONS ────────────────────────────────────────────────────────

alertcondition(choch_bull, title="Bullish CHoCH", message="{{ticker}} — Bullish Change of Character detected on {{interval}} chart")
alertcondition(choch_bear, title="Bearish CHoCH", message="{{ticker}} — Bearish Change of Character detected on {{interval}} chart")
alertcondition(bos_bull, title="Bullish BOS", message="{{ticker}} — Bullish Break of Structure on {{interval}} chart")
alertcondition(bos_bear, title="Bearish BOS", message="{{ticker}} — Bearish Break of Structure on {{interval}} chart")
alertcondition(goldenCross, title="Golden Cross", message="{{ticker}} — Golden Cross (50 MA > 200 MA) on {{interval}} chart")
alertcondition(deathCross, title="Death Cross", message="{{ticker}} — Death Cross (50 MA < 200 MA) on {{interval}} chart")
alertcondition(bullDiv, title="Bullish RSI Divergence", message="{{ticker}} — Bullish RSI Divergence detected on {{interval}} chart")
alertcondition(bearDiv, title="Bearish RSI Divergence", message="{{ticker}} — Bearish RSI Divergence detected on {{interval}} chart")
alertcondition(volBullSpike, title="Bullish Volume Spike", message="{{ticker}} — Bullish volume spike (Z={{plot_0}}) on {{interval}} chart")
alertcondition(volBearSpike, title="Bearish Volume Spike", message="{{ticker}} — Bearish volume spike on {{interval}} chart")
alertcondition(confScore >= 3, title="Strong Bullish Confluence", message="{{ticker}} — Strong bullish confluence score ({{plot_0}}/5) on {{interval}} chart")
alertcondition(confScore <= -3, title="Strong Bearish Confluence", message="{{ticker}} — Strong bearish confluence score on {{interval}} chart")
alertcondition(bullFVG, title="Bullish FVG", message="{{ticker}} — Bullish Fair Value Gap detected on {{interval}} chart")
alertcondition(bearFVG, title="Bearish FVG", message="{{ticker}} — Bearish Fair Value Gap detected on {{interval}} chart")
