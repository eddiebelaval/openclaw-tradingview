//------------------------------------------------------------------------------
// Hidden Bullish
// Indicator: Lower Low

IndicatorLL  = divNumber >= 1 and inRange(pl_pos, 1) and Indicator[lbR] < array.get(pl_vals, 1)
IndicatorLL2 = divNumber >= 2 and inRange(pl_pos, 2) and Indicator[lbR] < array.get(pl_vals, 2) and pl < array.get(pl_vals, 1) and array.get(pl_vals, 1) > array.get(pl_vals, 2)
IndicatorLL3 = divNumber >= 3 and inRange(pl_pos, 3) and Indicator[lbR] < array.get(pl_vals, 3) and pl < array.get(pl_vals, 2) and pl < array.get(pl_vals, 1) and array.get(pl_vals, 1) > array.get(pl_vals, 3) and array.get(pl_vals, 2) > array.get(pl_vals, 3)
IndicatorLL4 = divNumber >= 4 and inRange(pl_pos, 4) and Indicator[lbR] < array.get(pl_vals, 4) and pl < array.get(pl_vals, 3) and pl < array.get(pl_vals, 2) and pl < array.get(pl_vals, 1) and array.get(pl_vals, 1) > array.get(pl_vals, 4) and array.get(pl_vals, 2) > array.get(pl_vals, 4) and array.get(pl_vals, 3) > array.get(pl_vals, 4)
IndicatorLL5 = divNumber >= 5 and inRange(pl_pos, 5) and Indicator[lbR] < array.get(pl_vals, 5) and pl < array.get(pl_vals, 4) and pl < array.get(pl_vals, 3) and pl < array.get(pl_vals, 2) and pl < array.get(pl_vals, 1) and array.get(pl_vals, 1) > array.get(pl_vals, 5) and array.get(pl_vals, 2) > array.get(pl_vals, 5) and array.get(pl_vals, 3) > array.get(pl_vals, 5) and array.get(pl_vals, 4) > array.get(pl_vals, 5)

// Price: Higher Low

priceHL  = divNumber >= 1 and Source[lbR] > Source[bar_index - array.get(pl_pos, 1) + lbR]
hiddenBullCond = plotHiddenDiv and priceHL and IndicatorLL and pl != 0

