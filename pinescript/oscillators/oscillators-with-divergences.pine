// Regular Bearish
// Indicator: Lower High

IndicatorLH  = divNumber >= 1 and inRange(ph_pos, 1) and Indicator[lbR] < array.get(ph_vals, 1)
IndicatorLH2 = divNumber >= 2 and inRange(ph_pos, 2) and Indicator[lbR] < array.get(ph_vals, 2) and ph > array.get(ph_vals, 1) and array.get(ph_vals, 1) < array.get(ph_vals, 2)
IndicatorLH3 = divNumber >= 3 and inRange(ph_pos, 3) and Indicator[lbR] < array.get(ph_vals, 3) and ph > array.get(ph_vals, 2) and ph > array.get(ph_vals, 1) and array.get(ph_vals, 1) < array.get(ph_vals, 3) and array.get(ph_vals, 2) < array.get(ph_vals, 3)
IndicatorLH4 = divNumber >= 4 and inRange(ph_pos, 4) and Indicator[lbR] < array.get(ph_vals, 4) and ph > array.get(ph_vals, 3) and ph > array.get(ph_vals, 2) and ph > array.get(ph_vals, 1) and array.get(ph_vals, 1) < array.get(ph_vals, 4) and array.get(ph_vals, 2) < array.get(ph_vals, 4) and array.get(ph_vals, 3) < array.get(ph_vals, 4)
IndicatorLH5 = divNumber >= 5 and inRange(ph_pos, 5) and Indicator[lbR] < array.get(ph_vals, 5) and ph > array.get(ph_vals, 4) and ph > array.get(ph_vals, 3) and ph > array.get(ph_vals, 2) and ph > array.get(ph_vals, 1) and array.get(ph_vals, 1) < array.get(ph_vals, 5) and array.get(ph_vals, 2) < array.get(ph_vals, 5) and array.get(ph_vals, 3) < array.get(ph_vals, 5) and array.get(ph_vals, 4) < array.get(ph_vals, 5)

// Price: Higher High

priceHH   = divNumber >= 1 and Source[lbR] > Source[bar_index - array.get(ph_pos, 1) + lbR]
bearCond  = plotDiv and priceHH and IndicatorLH and ph != 0

priceHH2  = divNumber >= 2 and Source[lbR] > Source[bar_index - array.get(ph_pos, 2) + lbR]
bearCond2 = plotDiv and priceHH2 and IndicatorLH2 and ph != 0

priceHH3  = divNumber >= 3 and Source[lbR] > Source[bar_index - array.get(ph_pos, 3) + lbR]
bearCond3 = plotDiv and priceHH3 and IndicatorLH3 and ph != 0

priceHH4  = divNumber >= 4 and Source[lbR] > Source[bar_index - array.get(ph_pos, 4) + lbR]
bearCond4 = plotDiv and priceHH4 and IndicatorLH4 and ph != 0

priceHH5  = divNumber >= 5 and Source[lbR] > Source[bar_index - array.get(ph_pos, 5) + lbR]
bearCond5 = plotDiv and priceHH5 and IndicatorLH5 and ph != 0

BearSignal       = bearCond       or bearCond2       or bearCond3       or bearCond4       or bearCond5






earlyBearBool = divNumber >= 1 and plotDiv and inRange(ph_pos, 0) and iHigh and Indicator[1] < array.get(ph_vals, 0) and Source[1] > Source[bar_index - array.get(ph_pos, 0) + lbR] ? true : false //NegSlopeFunc("Bear", 0)//
