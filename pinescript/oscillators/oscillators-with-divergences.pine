BearLabelChart4 = bLabelsOnChart and bearCond4 and TrendFilterDn ? label.new(bar_index[lbR], high[lbR], yloc=yloc.abovebar, color = bearColor, style=Down_Label, text="Bear", size=Div_Label_Size, textcolor=BearTextColor, force_overlay = true) : na

Del_phs(bearCond4, BearLine,  BearLabel,  BearLineChart,  BearLabelChart,  4)
Del_phs(bearCond4, BearLine2, BearLabel2, BearLineChart2, BearLabelChart2, 3)
Del_phs(bearCond4, BearLine3, BearLabel3, BearLineChart3, BearLabelChart3, 2)






earlyBearBool5 = divNumber >= 5 and plotDiv and inRange(ph_pos, 4) and iHigh and Indicator[1] < array.get(ph_vals, 4) and Indicator[1] > array.get(ph_vals, 3) and Indicator[1] > array.get(ph_vals, 2) and Indicator[1] > array.get(ph_vals, 1) and Indicator[1] > array.get(ph_vals, 0) and array.get(ph_vals, 0) < array.get(ph_vals, 4) and array.get(ph_vals, 1) < array.get(ph_vals, 4) and array.get(ph_vals, 2) < array.get(ph_vals, 4) and array.get(ph_vals, 3) < array.get(ph_vals, 4) and Source[1] > Source[bar_index - array.get(ph_pos, 4) + lbR]? true : false //NegSlopeFunc("Bear", 4)//
earlyBearLine5 = bLines and earlyBearBool5 and TrendFilterDn ? line.new(array.get(ph_pos, 4) - lbR, array.get(ph_vals, 4), bar_index[1], Indicator[1], color = bearColor, style = Div_Line_Style, width = Div_Line_Width) : na
for x=2 to lbR-1
    if earlyBearBool5[x-1] and Indicator > Indicator[x]
        line.delete(earlyBearLine5[x-1])
    
line.delete(earlyBearLine5[lbR-1])



BearLine5       = bLines         and bearCond5 and TrendFilterDn ? line.new(array.get(ph_pos, 5) - lbR, array.get(ph_vals, 5),                       bar_index[lbR], Indicator[lbR],  color = bearColor, style = Div_Line_Style, width = Div_Line_Width) : na
BearLineChart5  = bLinesOnChart  and bearCond5 and TrendFilterDn ? line.new(array.get(ph_pos, 5) - lbR, high[bar_index - array.get(ph_pos,5) + lbR], bar_index[lbR], high[lbR],       color = bearColor, style = Div_Line_Style, width = Div_Line_Width, force_overlay = true) : na

BearLabel5      = bLabels        and bearCond5 and TrendFilterDn ? label.new(bar_index[lbR], Indicator[lbR],                color = bearColor, style=Down_Label, text="Bear", size=Div_Label_Size, textcolor=BearTextColor) : na
BearLabelChart5 = bLabelsOnChart and bearCond5 and TrendFilterDn ? label.new(bar_index[lbR], high[lbR], yloc=yloc.abovebar, color = bearColor, style=Down_Label, text="Bear", size=Div_Label_Size, textcolor=BearTextColor, force_overlay = true) : na

Del_phs(bearCond5, BearLine,  BearLabel,  BearLineChart,  BearLabelChart,  5)
Del_phs(bearCond5, BearLine2, BearLabel2, BearLineChart2, BearLabelChart2, 4)
Del_phs(bearCond5, BearLine3, BearLabel3, BearLineChart3, BearLabelChart3, 3)
Del_phs(bearCond5, BearLine4, BearLabel4, BearLineChart4, BearLabelChart4, 2)


//plotshape(bLabels2 and (bearCond or bearCond2 or bearCond3)  ?  Indicator[lbR] : na, offset=-lbR, title="Bearish Label", text=" Bear ", style=shape.labeldown, location=location.absolute, color=color.new(bearColor, 25) , textcolor=White)












//------------------------------------------------------------------------------
// Hidden Bearish
// Indicator: Higher High


IndicatorHH  = divNumber >= 1 and inRange(ph_pos, 1) and Indicator[lbR] > array.get(ph_vals, 1)
IndicatorHH2 = divNumber >= 2 and inRange(ph_pos, 2) and Indicator[lbR] > array.get(ph_vals, 2) and ph > array.get(ph_vals, 1) and array.get(ph_vals, 1) < array.get(ph_vals, 2)
IndicatorHH3 = divNumber >= 3 and inRange(ph_pos, 3) and Indicator[lbR] > array.get(ph_vals, 3) and ph > array.get(ph_vals, 2) and ph > array.get(ph_vals, 1) and array.get(ph_vals, 1) < array.get(ph_vals, 3) and array.get(ph_vals, 2) < array.get(ph_vals, 3)
IndicatorHH4 = divNumber >= 4 and inRange(ph_pos, 4) and Indicator[lbR] > array.get(ph_vals, 4) and ph > array.get(ph_vals, 3) and ph > array.get(ph_vals, 2) and ph > array.get(ph_vals, 1) and array.get(ph_vals, 1) < array.get(ph_vals, 4) and array.get(ph_vals, 2) < array.get(ph_vals, 4) and array.get(ph_vals, 3) < array.get(ph_vals, 4)
IndicatorHH5 = divNumber >= 5 and inRange(ph_pos, 5) and Indicator[lbR] > array.get(ph_vals, 5) and ph > array.get(ph_vals, 4) and ph > array.get(ph_vals, 3) and ph > array.get(ph_vals, 2) and ph > array.get(ph_vals, 1) and array.get(ph_vals, 1) < array.get(ph_vals, 5) and array.get(ph_vals, 2) < array.get(ph_vals, 5) and array.get(ph_vals, 3) < array.get(ph_vals, 5) and array.get(ph_vals, 4) < array.get(ph_vals, 5) 


// Price: Lower High

priceLH  = divNumber >= 1 and Source[lbR] < Source[bar_index - array.get(ph_pos, 1) + lbR]
hiddenBearCond = plotHiddenDiv and priceLH and IndicatorHH and ph != 0

priceLH2 = divNumber >= 2 and Source[lbR] < Source[bar_index - array.get(ph_pos, 2) + lbR]
hiddenBearCond2 = plotHiddenDiv and priceLH2 and IndicatorHH2 and ph != 0

priceLH3 = divNumber >= 3 and Source[lbR] < Source[bar_index - array.get(ph_pos, 3) + lbR]
hiddenBearCond3 = plotHiddenDiv and priceLH3 and IndicatorHH3 and ph != 0

priceLH4 = divNumber >= 4 and Source[lbR] < Source[bar_index - array.get(ph_pos, 4) + lbR]
hiddenBearCond4 = plotHiddenDiv and priceLH4 and IndicatorHH4 and ph != 0

priceLH5 = divNumber >= 5 and Source[lbR] < Source[bar_index - array.get(ph_pos, 5) + lbR]
hiddenBearCond5 = plotHiddenDiv and priceLH5 and IndicatorHH5 and ph != 0

HiddenBearSignal = hiddenBearCond or hiddenBearCond2 or hiddenBearCond3 or hiddenBearCond4 or hiddenBearCond5






earlyHiddenBearBool = divNumber >= 1 and plotHiddenDiv and inRange(ph_pos, 0) and iHigh and Indicator[1] > array.get(ph_vals, 0) and Source[1] < Source[bar_index - array.get(ph_pos, 0) + lbR] ? true : false //NegSlopeFunc("H Bear", 0)//
earlyHiddenBearLine = bLines and earlyHiddenBearBool and TrendFilterDn ? line.new(array.get(ph_pos, 0) - lbR, array.get(ph_vals, 0), bar_index[1], Indicator[1], color = hiddenBearColor, style = Hid_Div_Line_Style, width = Hid_Div_Line_Width) : na
for x=2 to lbR-1
    if earlyHiddenBearBool[x-1] and Indicator > Indicator[x]
        line.delete(earlyHiddenBearLine[x-1])
    
line.delete(earlyHiddenBearLine[lbR-1])


HiddenBearLine       = bLines         and hiddenBearCond and TrendFilterDn ? line.new(array.get(ph_pos, 1) - lbR, array.get(ph_vals, 1),                       bar_index[lbR], Indicator[lbR],  color = hiddenBearColor, style = Div_Line_Style, width = Div_Line_Width) : na
HiddenBearLineChart  = bLinesOnChart  and hiddenBearCond and TrendFilterDn ? line.new(array.get(ph_pos, 1) - lbR, high[bar_index - array.get(ph_pos,1) + lbR], bar_index[lbR], high[lbR],       color = hiddenBearColor, style = Div_Line_Style, width = Div_Line_Width, force_overlay = true) : na

HiddenBearLabel      = bLabels        and hiddenBearCond and TrendFilterDn ? label.new(bar_index[lbR], Indicator[lbR],                color = hiddenBearColor, style=Down_Label, text="H Bear", size=Div_Label_Size, textcolor=HiddenBearTextColor) : na
HiddenBearLabelChart = bLabelsOnChart and hiddenBearCond and TrendFilterDn ? label.new(bar_index[lbR], high[lbR], yloc=yloc.abovebar, color = hiddenBearColor, style=Down_Label, text="H Bear", size=Div_Label_Size, textcolor=HiddenBearTextColor, force_overlay = true) : na




earlyHiddenBearBool2 = divNumber >= 2 and plotHiddenDiv and inRange(ph_pos, 1) and iHigh and Indicator[1] > array.get(ph_vals, 0) and Indicator[1] > array.get(ph_vals, 1) and array.get(ph_vals, 0) < array.get(ph_vals, 1) and Source[1] < Source[bar_index - array.get(ph_pos, 1) + lbR] ? true : false //NegSlopeFunc("H Bear", 1)//
earlyHiddenBearLine2 = bLines and earlyHiddenBearBool2 and TrendFilterDn ? line.new(array.get(ph_pos, 1) - lbR, array.get(ph_vals, 1), bar_index[1], Indicator[1], color = hiddenBearColor, style = Hid_Div_Line_Style, width = Hid_Div_Line_Width) : na
for x=2 to lbR-1
    if earlyHiddenBearBool2[x-1] and Indicator > Indicator[x]
        line.delete(earlyHiddenBearLine2[x-1])
    
line.delete(earlyHiddenBearLine2[lbR-1])


HiddenBearLine2       = bLines         and hiddenBearCond2 and TrendFilterDn ? line.new(array.get(ph_pos, 2) - lbR, array.get(ph_vals, 2),                       bar_index[lbR], Indicator[lbR],  color = hiddenBearColor, style = Div_Line_Style, width = Div_Line_Width) : na
HiddenBearLineChart2  = bLinesOnChart  and hiddenBearCond2 and TrendFilterDn ? line.new(array.get(ph_pos, 2) - lbR, high[bar_index - array.get(ph_pos,2) + lbR], bar_index[lbR], high[lbR],       color = hiddenBearColor, style = Div_Line_Style, width = Div_Line_Width, force_overlay = true) : na

HiddenBearLabel2      = bLabels        and hiddenBearCond2 and TrendFilterDn ? label.new(bar_index[lbR], Indicator[lbR],                color = hiddenBearColor, style=Down_Label, text="H Bear", size=Div_Label_Size, textcolor=HiddenBearTextColor) : na
HiddenBearLabelChart2 = bLabelsOnChart and hiddenBearCond2 and TrendFilterDn ? label.new(bar_index[lbR], high[lbR], yloc=yloc.abovebar, color = hiddenBearColor, style=Down_Label, text="H Bear", size=Div_Label_Size, textcolor=HiddenBearTextColor, force_overlay = true) : na

Del_phs(hiddenBearCond2, HiddenBearLine, HiddenBearLabel, HiddenBearLineChart, HiddenBearLabelChart, 2)






earlyHiddenBearBool3 = divNumber >= 2 and plotHiddenDiv and inRange(ph_pos, 2) and iHigh and Indicator[1] > array.get(ph_vals, 2) and Indicator[1] > array.get(ph_vals, 1) and Indicator[1] > array.get(ph_vals, 0) and array.get(ph_vals, 0) < array.get(ph_vals, 2) and array.get(ph_vals, 1) < array.get(ph_vals, 2) and Source[1] < Source[bar_index - array.get(ph_pos, 2) + lbR] ? true : false //NegSlopeFunc("H Bear", 2)//
earlyHiddenBearLine3 = bLines and earlyHiddenBearBool3 and TrendFilterDn ? line.new(array.get(ph_pos, 2) - lbR, array.get(ph_vals, 2), bar_index[1], Indicator[1], color = hiddenBearColor, style = Hid_Div_Line_Style, width = Hid_Div_Line_Width) : na
for x=2 to lbR-1
    if earlyHiddenBearBool3[x-1] and Indicator > Indicator[x]
        line.delete(earlyHiddenBearLine3[x-1])
    
line.delete(earlyHiddenBearLine3[lbR-1])




HiddenBearLine3       = bLines         and hiddenBearCond3 and TrendFilterDn ? line.new(array.get(ph_pos, 3) - lbR, array.get(ph_vals, 3),                       bar_index[lbR], Indicator[lbR],  color = hiddenBearColor, style = Div_Line_Style, width = Div_Line_Width) : na
HiddenBearLineChart3  = bLinesOnChart  and hiddenBearCond3 and TrendFilterDn ? line.new(array.get(ph_pos, 3) - lbR, high[bar_index - array.get(ph_pos,3) + lbR], bar_index[lbR], high[lbR],       color = hiddenBearColor, style = Div_Line_Style, width = Div_Line_Width, force_overlay = true) : na

