HiddenBearLineChart5  = bLinesOnChart  and hiddenBearCond5 and TrendFilterDn ? line.new(array.get(ph_pos, 5) - lbR, high[bar_index - array.get(ph_pos,5) + lbR], bar_index[lbR], high[lbR],       color = hiddenBearColor, style = Div_Line_Style, width = Div_Line_Width, force_overlay = true) : na

