//------------------------------------------------------------------------------
// Regular Bullish
// Indicator: Higher Low

IndicatorHL  = divNumber >= 1 and inRange(pl_pos, 1) and Indicator[lbR] > array.get(pl_vals, 1)
IndicatorHL2 = divNumber >= 2 and inRange(pl_pos, 2) and Indicator[lbR] > array.get(pl_vals, 2) and Indicator[lbR] < array.get(pl_vals, 1) and array.get(pl_vals, 1) > array.get(pl_vals, 2)
IndicatorHL3 = divNumber >= 3 and inRange(pl_pos, 3) and Indicator[lbR] > array.get(pl_vals, 3) and Indicator[lbR] < array.get(pl_vals, 2) and Indicator[lbR] < array.get(pl_vals, 1) and array.get(pl_vals, 1) > array.get(pl_vals, 3) and array.get(pl_vals, 2) > array.get(pl_vals, 3)
IndicatorHL4 = divNumber >= 4 and inRange(pl_pos, 4) and Indicator[lbR] > array.get(pl_vals, 4) and Indicator[lbR] < array.get(pl_vals, 3) and Indicator[lbR] < array.get(pl_vals, 2) and Indicator[lbR] < array.get(pl_vals, 1) and array.get(pl_vals, 1) > array.get(pl_vals, 4) and array.get(pl_vals, 2) > array.get(pl_vals, 4) and array.get(pl_vals, 3) > array.get(pl_vals, 4)
IndicatorHL5 = divNumber >= 5 and inRange(pl_pos, 5) and Indicator[lbR] > array.get(pl_vals, 5) and Indicator[lbR] < array.get(pl_vals, 4) and Indicator[lbR] < array.get(pl_vals, 3) and Indicator[lbR] < array.get(pl_vals, 2) and Indicator[lbR] < array.get(pl_vals, 1) and array.get(pl_vals, 1) > array.get(pl_vals, 5) and array.get(pl_vals, 2) > array.get(pl_vals, 5) and array.get(pl_vals, 3) > array.get(pl_vals, 5) and array.get(pl_vals, 4) > array.get(pl_vals, 5)

// Price: Lower Low

priceLL   = divNumber >= 1 and Source[lbR] < Source[bar_index - array.get(pl_pos, 1) + lbR]
bullCond  = plotDiv and priceLL and IndicatorHL and pl != 0

priceLL2  = divNumber >= 2 and Source[lbR] < Source[bar_index - array.get(pl_pos, 2) + lbR]
bullCond2 = plotDiv and priceLL2 and IndicatorHL2 and pl != 0

priceLL3  = divNumber >= 3 and Source[lbR] < Source[bar_index - array.get(pl_pos, 3) + lbR]
bullCond3 = plotDiv and priceLL3 and IndicatorHL3 and pl != 0

priceLL4  = divNumber >= 4 and Source[lbR] < Source[bar_index - array.get(pl_pos, 4) + lbR]
bullCond4 = plotDiv and priceLL4 and IndicatorHL4 and pl != 0

priceLL5  = divNumber >= 5 and Source[lbR] < Source[bar_index - array.get(pl_pos, 5) + lbR]
bullCond5 = plotDiv and priceLL5 and IndicatorHL5 and pl != 0

BullSignal       = bullCond       or bullCond2       or bullCond3       or bullCond4       or bullCond5





