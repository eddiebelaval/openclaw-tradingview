//@version=6


indicator(title='Oscillators with Divergences', shorttitle='Osc_Divs', precision=2, max_bars_back = 500, max_lines_count = 500, max_labels_count = 500)




//------------------------------------------------------------------------ // ***** Colors ***** \\ ------------------------------------------------------------------------\\

Black   = #000000,      Charcoal= #363A45,      Gray    = #787B86,      Silver  = #C0C0C0,      White   = #FFFFFF
Brown   = #A52A2A,      Red     = #FF0000,      Pink    = #FF69B4,      Gold    = #D4AF37,      Orange  = #FF6A00,      Yellow  = #FFFF00
Green   = #00B060,      Teal    = #008080,      Lime    = #00FF0B       // Green = #008000
Navy    = #311B92,      Blue    = #0094FF,      Aqua    = #00BCD4       // #2962FF #00FFFF
Purple  = #800080,      Fucshia = #E040FB   //#FF00FF
None = color.new(Black, 100)


// -----------------------------  Assign Colors  -----------------------------

    // MACD colors
col_macd   = #0094ff
col_signal = #ff6a00

    // MACD Histogram colors
col_hist   =  None  // This is re-assigned later once the calculations have been made. This will show up black in the Style settings tab
col_grow_above = #26A69A  // Positive and going up
col_fall_above = #B2DFDB  // Positive but going down
col_grow_below = #FFCDD2  // Negative and going down
col_fall_below = #EF5350  // Negative but going up






    // Universal Colors // gotten later using color.input()
// col_osc     = #0094ff
// col_osc_ema = #ff6a00



//------------------------------------------------------------------------ // ***** Inputs ***** \\ ------------------------------------------------------------------------\\


source = close  //input(title="Source", defval=close)

IndicatorSelection = input.string(defval="MACD", title="", options=["MACD", "RSI", "CCI", "VMACD", "MFI", "Stochastic", "Stoch RSI"], inline='Indicator')
bMACD       = IndicatorSelection == "MACD" or IndicatorSelection == "VMACD" ? true : false
bRSI        = IndicatorSelection == "RSI"  or IndicatorSelection == "MFI"   ? true : false
bCCI        = IndicatorSelection == "CCI"        ? true : false
bVWMACD     = IndicatorSelection == "VMACD"      ? true : false
bMFI        = IndicatorSelection == "MFI"        ? true : false
bStochastic = IndicatorSelection == "Stochastic" ? true : false
bstochRSI   = IndicatorSelection == "Stoch RSI"  ? true : false


tf    = "" // input.timeframe(title="", defval="", inline='Indicator')  // Use this for setting higher time frames
TrendSelection = input.string(defval = "Off", title="Signals", options=["Off", "200 EMA Trend", "VWAP Trend"], inline='Indicator')
bVWAP = TrendSelection == "VWAP Trend" ? true : false

bSignals    = TrendSelection == "Off" ? false : true    // input.bool(true,  "Signals",         inline='Indicator')
bBars       = false     // input.bool(false, "Signal Bars",            inline='Indicator')

col_osc     = input.color(#0094ff, "", inline = 'Indicator')
col_osc_ema = input.color(#ff6a00, "", inline = 'Indicator')
bAlt_col    = input.bool(false, "", inline = 'Indicator', tooltip = "First is indciator selection. \nSecond is buying/selling signals based on a given trend. \nFirst color is for the leading line, second color is for the signal line. \nThe checkbox is for 'Alternate Colors.' This will make the singal line transparent and then set the leadiang line to be blue if it is above the middle line or red if it is below the middle line.")

// Getting MACD inputs
fast_length     = input.int(title='(VW)MACD', defval=12, inline='MACD Settings')
slow_length     = input.int(title='',     defval=26, inline='MACD Settings')
signal_length   = input.int(title='',     defval=9,  inline='MACD Settings', tooltip="Fast, Slow, Signal")
histSize        = 2 // input.int(title='',     defval=2,  inline='MACD Settings')




// ---------------------------------------------------------------------------- // Calculations \\ ------------------------------------------------------------------------- \\


fast_ma = bVWMACD ? (ta.ema(volume*source, fast_length)/ta.ema(volume, fast_length)) : ta.ema(source, fast_length)
slow_ma = bVWMACD ? (ta.ema(volume*source, slow_length)/ta.ema(volume, slow_length)) : ta.ema(source, slow_length)



outmacd       = 10000 * (fast_ma - slow_ma) / slow_ma  // Doing Calculation this way normalizes the data. Doesnt change the graph visually, but makes it so you can compare different charts
MTFmacd       = request.security(syminfo.tickerid, tf, outmacd, gaps=barmerge.gaps_off)
macd          = MTFmacd

outsignal     = ta.ema(macd, signal_length)
MTFsignal     = request.security(syminfo.tickerid, tf, outsignal, gaps=barmerge.gaps_off)
signal        = MTFsignal

outhist       = (macd - signal) * histSize  // Multiply to make the graph bigger, doesnt change anything other than visually making the histogram larger
MTFhist       = request.security(syminfo.tickerid, tf, outhist, gaps=barmerge.gaps_off)
hist          = MTFhist

// macd   = 10000 * (fast_ma - slow_ma) / slow_ma
// signal = ta.ema(macd, signal_length)
// hist   = (macd - signal) * histSize  



col_hist := hist > 0 ? (hist > hist[1] ? col_grow_above : hist < hist[1] ? col_fall_above : col_hist[1]) : (hist > hist[1] ? col_grow_below : hist < hist[1] ? col_fall_below : col_hist[1])

















//------------------------------------------------------------------------ // ***** Inputs ***** \\ ------------------------------------------------------------------------\\

// --------------------  // RSI \\ -------------------------- \\
length       = input.int(title='RSI/Stoch', minval=1,  defval=14, inline="OSC Length")   // 'Other',  
smoothlength = input.int(title='',    minval=1,  defval=3,  inline="OSC Length")   // 'Smooth', 
ema_length   = input.int(title='',    minval=1,  defval=14, inline="OSC Length", tooltip="Length, Smoothing, Signal")   // 'Signal', 

upperLine    = input.int(title='OB/OS',  minval=51, defval=70, inline="OB/OS")
centerLine   = bMACD or bVWMACD or bCCI ? 0 : 50     // Any oscillator that isn't macd or cci is bound 0-100 that's why 50 is the middle for those
lowerLine    = centerLine - (upperLine - centerLine)
extreme      = input.int(title='Extreme',    defval=10, inline="OB/OS", tooltip="OB/OS value: Set value to whatever you want the Overbought zone to be. Oversold will mirror the correct value. When the Indicator's leading line is above
    the OB value, it will fill in the space between the OB value and the leading line with green. When the leading line is below the OS value, it will fill that area with red. \n\nThink of the 'Extreme' value as the OB value + Extreme.
    For example, if the OB/OS value is 70 and Extreme is 10, then Extrame value is 80 (and it mirrors like the OS value does). \n\nWhen the indicator's leading line is past the Extreme value (80 in this case) it will highlight the area even brigher.
    So the green fill gets more green, and the red fill in the oversold area gets more red. This is to indicate that not only is it OB/OS, it is very much OB/OS.")

bFill      = false // input(false, 'Fill',       inline="options")
bColorBars = false // input(false, 'Color Bars', inline="options")
bColorBarsOpt = 0 // false // input.int(title='Based on', minval=1,  defval=1,  maxval=3, inline="options", tooltip="1.Histogram Slope  2.Histogram Value  3.RSI Value")



//------------------------------------------------------------------------ // ***** Inputs ***** \\ ------------------------------------------------------------------------\\

// --------------------  // CCI \\ -------------------------- \\
//length = input.int(20, minval=1)
src = hlc3
ma = ta.sma(src, length)
cci = (src - ma) / (0.015 * ta.dev(src, length))



//------------------------------------------------------------------------ // ***** Inputs ***** \\ ------------------------------------------------------------------------\\

// --------------------  // Stochastic \\ -------------------------- \\
StochKlength = length
StochKsmooth = smoothlength
StochDlength = ema_length

// stochRSI = input(false, 'Stochastic RSI', inline="options")
rsi      = ta.rsi(source, length)
StochK   = bstochRSI ? ta.sma(ta.stoch(rsi, rsi, rsi, StochKlength), StochKsmooth) : ta.sma(ta.stoch(close, high, low, StochKlength), StochKsmooth)
StochD   = ta.sma(StochK, StochDlength)



// StochasticColor = StochK > StochD ? color.new(col_osc, 25) : color.new(col_osc_ema, 25)


// request.security(system.tickerid, tf, close, barmerge.gaps_off, barmerge.lookahead_on)

// bool newDay = ta.change(time(tf))
// // bgcolor(newDay[1] ? color.silver : na)
// TestValue = request.security(syminfo.tickerid, tf, ta.ema(ta.rsi(source, length), smoothlength), gaps=barmerge.gaps_off, lookahead = barmerge.lookahead_on)
// TestValue := newDay ? TestValue : TestValue[1]
// plot(TestValue, color=Yellow)

outosc       = bMFI  ? ta.ema(ta.mfi(source, length), smoothlength) :  bRSI  ? ta.ema(ta.rsi(source, length), smoothlength) : bCCI ? ta.ema(ta.cci(hlc3, length), smoothlength) : bStochastic or bstochRSI ? StochK : na
MTFosc       = request.security(syminfo.tickerid, tf, outosc, gaps=barmerge.gaps_off, lookahead = barmerge.lookahead_on)
osc          = bMACD ? macd   : MTFosc
// osc := newDay[1] ? MTFosc : 0

outbasis     = bRSI or bCCI ? ta.ema(osc, ema_length) : bStochastic or bstochRSI ? ta.sma(StochK, StochDlength) : na
MTFbasis     = request.security(syminfo.tickerid, tf, outbasis, gaps=barmerge.gaps_off, lookahead = barmerge.lookahead_on)
basis        = bMACD ? signal : MTFbasis

// basis      = ta.ema(rsi, ema_length)


obNumber = upperLine
osNumber = lowerLine
miNumber = bMACD ? 0 : (upperLine + lowerLine) / 2


Fill_Lines_color = osc > basis ? col_osc : col_osc_ema








// test = request.security(syminfo.tickerid, tf, timeframe.multiplier)
// plot(test)


// newExchangeDay = ta.change(dayofmonth)
// plotchar(newExchangeDay, "newExchangeDay", "🠇", location.top, size = size.small)



















// ---------------------------------------------------------------------------- // Draw Graph \\ ------------------------------------------------------------------------- \\

Line0 = hline(bMACD ? 0 : na, 'MACD Midline', linestyle=hline.style_solid)

histplot     = plot(bMACD ? hist   : na, title='Histogram', color=col_hist, style=plot.style_columns)                     // draw histogram first so the lines aren't hidden
// Draw these later        // signalplot   = plot(bMACD ? signal : na, title='Signal',    color=color.new(col_osc_ema, 0), linewidth=2, histbase=50)    // col_signal     draw signal and macd lines after histogram so they are drawn over the histogram
// Draw these later        // macdplot     = plot(bMACD ? macd   : na, title='MACD',      color=color.new(col_osc, 0),     linewidth=2, histbase=50)    // col_macd       draw macd last so it is on top of he signal line

CurrentValue = math.round(hist, 2)
//CurrentValueLabel = label.new(bar_index, CurrentValue, style=label.style_label_left, color=None, textcolor=col_hist, text=tostring(CurrentValue), size=size.normal)
//label.delete(CurrentValueLabel[1])






// ---------------------------------------------------------------------------- // Alerts / Signals \\ ------------------------------------------------------------------------- \\

// Draw dots at the crossovers
//macd_color = (macd >= signal) ? color.blue : color.orange
//plotshape(series=cross(macd, signal) ? signal : na, location=location.absolute, title="Cross", color=macd_color, style=shape.circle, size=size.tiny)



outTrend  = bVWAP ? ta.vwap(close) : ta.ema(source, 200)
MTFema    = request.security(syminfo.tickerid, tf, outTrend, gaps=barmerge.gaps_off)
TrendEMA  = MTFema      // ta.ema(source, 200)


bMACDCrossOver  =  ta.crossover(macd, signal)
bMACDCrossUnder = ta.crossunder(macd, signal)


MACDBuySignal  = bMACD and (open > TrendEMA and close > TrendEMA and  bMACDCrossOver and (macd < 0 or macd[1] < 0)) ? true : false
MACDSellSignal = bMACD and (open < TrendEMA and close < TrendEMA and bMACDCrossUnder and (macd > 0 or macd[1] > 0)) ? true : false


// Highlight when a good long signal  (macd crosses over  signal line while below the 0 line and also price is above the 200 EMA)
    // I made this and the RSI signals later do the same thing so look further down for this 
// bgcolor(bSignals and MACDBuySignal ? color.new(Green, 60) : na, editable=true, title='Long Signal')

// Highlight when a good short signal (macd crosses below signal line while above the 0 line and also price is below the 200 EMA)
    // Same as last one. look under the RSI 
// bgcolor(bSignals and MACDSellSignal ? color.new(Red, 60) : na, editable=true, title='Short Signal')



alertcondition(MACDBuySignal,  title='MACD Buy Signal',  message='{{ticker}} MACD Buy Signal on the {{interval}} chart')
alertcondition(MACDSellSignal, title='MACD Sell Signal', message='{{ticker}} MACD Sell Signal on the {{interval}} chart')










//------------------------------------------------------------------------ // ***** GRAPH IT! ***** \\ ------------------------------------------------------------------------\\



        // Draw Current RSI value to the right, easier to see somtimes
CurrentValueOSC = math.round(osc, 2)
// CurrentValueLabelRSI = bRSI ? label.new(bar_index, CurrentValueRSI, style=label.style_label_left, color=None, textcolor=col_rsi, text=str.tostring(CurrentValueRSI), size=size.normal) : na
// label.delete(CurrentValueLabelRSI[1])




        // Draw RSI on graph. Draw last so that it is over top of everything. Almost always draw first so it shows up in settings first as it is the most important part of the indicator
//sqzColor2 =    bSqueeze and bbw < 10 ? White    :    bSqueeze and bbw < 15 ? Red    :    bSqueeze and bbw < 20 ? Yellow    :    Silver
//col_rsi := bBollinger ? Silver : sqzColor2
//col_rsi := osc > bbupper ? color.navy    :    osc < bblower ? color.navy    :    Silver

oscPlot = plot (osc  , title='Oscillator', color=bAlt_col ? (osc > miNumber ? Green : Red) : col_osc,     linewidth=2)
EMA     = plot (basis, title='Signal',     color=bAlt_col ? None : col_osc_ema, linewidth=2)


// outtestEMA  = ta.ema(ta.ema(osc, length), 4)
// MTFtestEMA  = request.security(syminfo.tickerid, tf, outtestEMA, gaps=barmerge.gaps_off)
// testEMA     = MTFtestEMA
// plottestEMA = plot (testEMA)

obLevel = hline(bRSI or bCCI or bMFI or bStochastic or bstochRSI ? obNumber : na, title='Overbought',  linestyle=hline.style_dotted)
midLine = hline(bRSI or bCCI or bMFI or bStochastic or bstochRSI ? miNumber : na, title='Middle Line', linestyle=hline.style_dotted)
osLevel = hline(bRSI or bCCI or bMFI or bStochastic or bstochRSI ? osNumber : na, title='Oversold',    linestyle=hline.style_dotted)
fill(obLevel, osLevel, title='OSC Background', color=color.new(#9915FF, 90))



// fill(oscPlot, EMA, title="Fill Lines", color=bFill ? Fill_Lines_color : na)      // Don't use this because it disables editing of colors in the "Style" tab
FillColor = osc > basis ? color.new(#0094ff, 25) : color.new(#ff6a00, 25)
fill(oscPlot, EMA, title="Fill Lines", color=bFill ? FillColor : na)


//OSCdiff = osc - basis

// plot(OSCdiff, "none", Yellow, 2, plot.style_columns)
//BarColor  = None   // This is needed
//BarColor := (  bColorBarsOpt == 1 and OSCdiff > OSCdiff[1]) ? Lime : (bColorBarsOpt == 1 and OSCdiff < OSCdiff[1]) ? Red : 
//              (bColorBarsOpt == 2 and OSCdiff > 0)          ? Lime : (bColorBarsOpt == 2 and OSCdiff < 0)          ? Red : 
//              (bColorBarsOpt == 3 and osc     > miNumber)   ? Lime : (bColorBarsOpt == 3 and osc     < miNumber)   ? Red : BarColor[1]
// BarColor = osc > testEMA ? color.new(#0094ff, 25) : color.new(#ff6a00, 25)
// barcolor(bColorBars ? BarColor : na, title="Bar Colors")



// -----------------------------------------------------------------------------------------  // Overbought/sold \\ ----------------------------------------------------------------------------------------- \\

supersold   = osc < osNumber - extreme
oversold    = osc < osNumber
overbought  = osc > obNumber
superbought = osc > obNumber + extreme




overBoughtColor = superbought ? color.new(Green, 25) : overbought ? color.new(Green, 50) : na
overSoldColor   = supersold   ? color.new(Red,   25) : oversold   ? color.new(Red,   50) : na

invisibleTop  = plot(bRSI or bCCI or bMFI or bStochastic or bstochRSI ? obNumber : na, color=None, linewidth=1, display=display.none, editable=false)
//invisibleMid  = plot(bRSI or bCCI or bMFI or bStochastic or bstochRSI ? miNumber : na, color=None, linewidth=1, display=display.none, editable=false)
invisibleBot  = plot(bRSI or bCCI or bMFI or bStochastic or bstochRSI ? osNumber : na, color=None, linewidth=1, display=display.none, editable=false)

fill(oscPlot, invisibleTop, color=bRSI or bCCI or bMFI or bStochastic or bstochRSI ? overBoughtColor : na, editable=true)
fill(oscPlot, invisibleBot, color=bRSI or bCCI or bMFI or bStochastic or bstochRSI ? overSoldColor   : na, editable=true)



bOscCrossOver    =   ta.crossover(osc, basis)
bOscCrossUnder   =  ta.crossunder(osc, basis)
bOscCrossOverOS  =  ta.crossover(osc, osNumber)
bOscCrossUnderOB = ta.crossunder(osc, obNumber)



  // Buy + Sell Signals
RSIBuySignal  = bRSI and (hl2 > TrendEMA and close > TrendEMA and   (bOscCrossOverOS or  (bOscCrossOver and (osc < osNumber or osc[1] < osNumber)))) ? true : false       //open > ta.ema(source, 200) and 
RSISellSignal = bRSI and (hl2 < TrendEMA and close < TrendEMA and  (bOscCrossUnderOB or (bOscCrossUnder and (osc > obNumber or osc[1] > obNumber)))) ? true : false       //open < ta.ema(source, 200) and 

CCIBuySignal  = bCCI and (hl2 > TrendEMA and close > TrendEMA and   (bOscCrossOverOS or  (bOscCrossOver and (osc < osNumber or osc[1] < osNumber)))) ? true : false       //open > ta.ema(source, 200) and 
CCISellSignal = bCCI and (hl2 < TrendEMA and close < TrendEMA and  (bOscCrossUnderOB or (bOscCrossUnder and (osc > obNumber or osc[1] > obNumber)))) ? true : false       //open < ta.ema(source, 200) and 

StochBuySignal  = bStochastic and (hl2 > TrendEMA and close > TrendEMA and   bOscCrossOverOS) ? true : false       //open > ta.ema(source, 200) and 
StochSellSignal = bStochastic and (hl2 < TrendEMA and close < TrendEMA and  bOscCrossUnderOB) ? true : false       //open < ta.ema(source, 200) and 

StochRSIBuySignal  = bstochRSI and (hl2 > TrendEMA and close > TrendEMA and   bOscCrossOverOS) ? true : false       //open > ta.ema(source, 200) and 
StochRSISellSignal = bstochRSI and (hl2 < TrendEMA and close < TrendEMA and  bOscCrossUnderOB) ? true : false       //open < ta.ema(source, 200) and 


  // Highlight when a good long signal  (tsi crosses over  signal line while below the 0 line and also source is above the 200 EMA)
bgcolor (bSignals and (MACDBuySignal  or  RSIBuySignal  or  CCIBuySignal or StochBuySignal or StochRSIBuySignal)  ? color.new(Green, 60) : na, editable=true, title="Long Signal")
// barcolor(bBars    and (MACDBuySignal  or  RSIBuySignal) ? Lime                 : na, editable=true, title="Long Signal Bars")

  // Highlight when a good short signal (tsi crosses below signal line while above the 0 line and also source is below the 200 EMA)
bgcolor (bSignals and (MACDSellSignal or RSISellSignal  or CCISellSignal or StochSellSignal or StochRSISellSignal) ? color.new(Red, 60)   : na, editable=true, title="Short Signal")
// barcolor(bBars    and (MACDSellSignal or RSISellSignal) ? Fucshia              : na, editable=true, title="Short Signal Bars")














// ---------------------------------------------------------------------------- // Divergences \\ ------------------------------------------------------------------------- \\

// A NOTE IF YOU ARE HERE:
// 
// For the brave soul that is looking to use my divergence code on their own stuff. I did add some notes where possible.
// At the beginning here, I have commented out things because I already pull that in from somewhere else in the code above. You can technically uncomment those and then plug in your own variables and it shoud just work.
// Why don't I use functions instead of doing manual checks for all my divergence checking and line/label drawing? Becuase I've tried 1000 different times and I cannot get it to work.
// I also could not find anyone else tha thas a multi-lookback method like this that worked the way I wanted it to. So I took someone's code from looking back one pivot point and just figured out a way to manually do it across multiple pivots.
// This took me several hundreds of hours to get the way it is. Maybe I'm just not too good, maybe it's just that I'm particular the way it works. Either way, please do mention me if you copy this code. It was a lot of work. 
//
// Finally, thank you for your support and I hope you do like the indicator or just the divergence stuff below :)
// 
// 





Source      = source        // your value of source (i.e. close, hloc4, hl2, open, etc) or the variable you stated before as something like     src = close     or      src = input(close, "Source"). In these cases, "src" would be what you input here so that     Source = src
// Indicator   = rsi          // your value of an indicator (i.e. rsi, hist, MACD, volume, etc)  In these cases, "rsi" would be what you input here so that     Indicator = rsi
indicator_input = input.string(defval="Oscillator", title="Divergence", options=["Histogram", "Oscillator"], inline = "01")    // "Divergence Indicator"
Indicator = bMACD == false or indicator_input == "Oscillator" ? osc : indicator_input == "Histogram" ? hist : na
Middle = miNumber // = bMACD ? 0 : (upperLine + lowerLine) / 2   // bMACD ? 0 : bRSI ? 50 : 0                 // Set this to whatever the middle of the indicator is, it's used to make sure highs and lows are actually above and below this point


DivergenceSelection = input.string(defval="Regular", title="", options=["Off", "Regular", "Hidden", "Both"], inline = "01", tooltip="If you select 'Histogram', this is only effective on MACD or VWMACD. Otherwise it will default to 'Oscillator', even if it isn't chosen. \nThen the second selection is pretty straight forward: Do you want Regular, Hidden, or Both types of divergences to be shown.")    // "Divergence"
plotDiv       = DivergenceSelection == "Regular" or DivergenceSelection == "Both" ? true : false
plotHiddenDiv = DivergenceSelection == "Hidden"  or DivergenceSelection == "Both" ? true : false

bOnlyTrend    = input(false, "Only Trending Divs", inline="Div Options")

TrendFilterUp = ((bOnlyTrend == true and close > TrendEMA) or (bOnlyTrend == false)) ? true : false
TrendFilterDn = ((bOnlyTrend == true and close < TrendEMA) or (bOnlyTrend == false)) ? true : false

//      Trend EMA is calculated above so just use that "TrendEMA"
// trendLength = input.int(title="", defval = 200, inline="trend")
// trendRes    = input.timeframe(title="", defval="", inline = "trend")
// currentEMA  = ta.ema(close, trendLength)    // used to get multi-timeframe ema
// mtfEMA      = request.security(syminfo.tickerid, trendRes, currentEMA, gaps=barmerge.gaps_off)
// TrendEMA = mtfEMA


bMiddleFilter = input.bool(true, "Middle Filter", inline="Div Options", tooltip="Only Trending Divergences will filter the divergences shown to only those that are following the trend. The trend, by default, is the 200 EMA. This will follow whatever you've chosen for the Signals selection at the top. So if you want it to follow VWAP instead, you have to select VWAP up there. \n\nMiddle Filter makes it so that High Pivots are only counted if they are above the middle line and Low Pivots if they are below the middle line. I recommend having this enabled.")
divNumber     = input.int(title="Pivots to look back", minval = 1, maxval = 5, defval = 1, tooltip="Max is 5, the higher you go the less relevant the pivot point is compared to the previous one due to the length the indicator uses to make its calculations. \n\nI find that 1 is great, 2 is amazing, 3 is pretty good, 4 is decent, 5 is not good usually.
 By the time it hits the 4th or 5th pivot from what it's comparing to, it no longer makes sense to compare data that far. But! I leave that choice up to you. ")


// --------------------  // Pivots \\ -------------------------- \\
PlotHL = false  //input(false, "Plot Highs/Lows")
lbL = 5         //input(title="Pivot Lookback Left", defval=5, minval=2)    // How far back do we look to see if anything was lower / higher than the current point.      Default 5
lbR = 5         //input(title="Pivot Lookback Right", defval=5, minval=2)   // How far ahead of the pivot do we wait until we confirm it was the lowest / highest point.  Default 5
maxbars = 500   // How far back can we look for a divergence


// -----------------------------  Assign Colors  -----------------------------

    //  Divergence Colors
bullColor       = input.color(defval = color.new(Green,    25),  title = "Bull",   inline = "02")     
hiddenBullColor = input.color(defval = color.new(Aqua,     25),  title = "",       inline = "02")     // H Bull

bearColor       = input.color(defval = color.new(Red,      25),  title = "Bear",   inline = "02")
hiddenBearColor = input.color(defval = color.new(Fucshia,  25),  title = "",       inline = "02")     // H Bear



// -----------------------------  Line/Label Styles  -----------------------------

LineSelection      = input.string("Indicator", "Lines", ["Off", "Indicator", "Chart", "Both"], inline='Draw Options', tooltip = "Lines and Pane labels will select where these are shown. The last selection is which type of labels will be drawn if you are showing labels at all.
    \n\nLines and labels have a maximum of 500 each. If you draw on both the indicator and the chart, you may reach the 500 limit on lines or labels and you'll see them stop drawing. Just FYI, also I've never seen it hit this limit if you just do the indicator OR the chart.
    \n\nYes I know that if you select 'Word Only' and draw them on the indicator, the Bull and H Bull signals are on top of the line rather than below it but they work correctly on the price chart. I don't know how to fix that without having to do a bunch of math to figure out the positioning. I don't use labels on the indicator anyways so it's too much effort for something I or anyone I know would use.")
bLines             = LineSelection == "Indicator" or LineSelection == "Both" ? true : false
bLinesOnChart      = LineSelection == "Chart"     or LineSelection == "Both" ? true : false

LabelSelection     = input.string("Off", "Labels", ["Off", "Indicator", "Chart", "Both"], inline='Draw Options')
bLabels            = LabelSelection == "Indicator" or LabelSelection == "Both" ? true : false
bLabelsOnChart     = LabelSelection == "Chart"     or LabelSelection == "Both" ? true : false

LabelStyle         = input.string("Label", "", ["Label", "Diamond", "Circle", "Word Only"], inline='Draw Options')

Up_Label           = LabelStyle == "Label"   ? label.style_label_up  :
                     LabelStyle == "Diamond" ? label.style_diamond :    
                     LabelStyle == "Circle"  ? label.style_circle :    
                     LabelStyle == "Word Only"   ? label.style_none :    
                     label.style_none 
Down_Label         = LabelStyle == "Label"   ? label.style_label_down  :
                     LabelStyle == "Diamond" ? label.style_diamond :    
                     LabelStyle == "Circle"  ? label.style_circle :    
                     LabelStyle == "Word Only"   ? label.style_none :    
                     label.style_none 


Div_Line_Style      = line.style_solid
Div_Line_Width      = 2
Div_Label_Size      = LabelStyle == "Word Only" ? size.normal : size.small //: size.tiny
BullTextColor       = LabelStyle == "Word Only" ? bullColor : White
BearTextColor       = LabelStyle == "Word Only" ? bearColor : White

Hid_Div_Line_Style  = line.style_solid                           // line.style_solid        line.style_dashed        line.style_dotted
Hid_Div_Line_Width  = 2
Hid_Div_Label_Size  = LabelStyle == "Word Only" ? size.normal : size.small //: size.tiny            // size.small              size.normal
HiddenBullTextColor = LabelStyle == "Word Only" ? hiddenBullColor : White
HiddenBearTextColor = LabelStyle == "Word Only" ? hiddenBearColor : White





//------------------------------------------------------------------------ // ***** Divergence Calculations ***** \\ ------------------------------------------------------------------------\\




float ph = ta.pivothigh(not bMiddleFilter ? Indicator : bMiddleFilter and Indicator > Middle ? Indicator : na, lbL, lbR)    // float ph = ta.pivothigh(Indicator, lbL, lbR)
float pl = ta.pivotlow( not bMiddleFilter ? Indicator : bMiddleFilter and Indicator < Middle ? Indicator : na, lbL, lbR)    // float pl = ta.pivotlow(Indicator, lbL, lbR)           // Plot these instead of using labels because there's a limit of 100 on lines / labels and pivots easily use a lot of them
//plotshape(PlotHL ? ph : na, text = "H", style = shape.labeldown, color = None, textcolor = Red,  location = location.absolute, offset = -lbR, editable=false)
//plotshape(PlotHL ? pl : na, text = "L", style = shape.labelup,   color = None, textcolor = Lime, location = location.absolute, offset = -lbR, editable=false)


iLow  = Indicator > Indicator[1] and Indicator[1] < Indicator[2]    // Check if indicator made a low  point (used in early indicators)
iHigh = Indicator < Indicator[1] and Indicator[1] > Indicator[2]    // Check if indicator made a high point (used in early indicators)


// keep values and pos of Pivot Highs/Lows in the arrays
var int maxarraysize = 5+1  // used to be 20 but only use 5 pivots to look back on. Saves memory and usually divergences should not look that far back anyways
var ph_pos = array.new_int(maxarraysize, 0)
var pl_pos = array.new_int(maxarraysize, 0)
var ph_vals = array.new_float(maxarraysize, 0.)
var pl_vals = array.new_float(maxarraysize, 0.)

// add PHs to the array
if ph != 0
    array.unshift(ph_pos, bar_index)
    array.unshift(ph_vals, ph)
    if array.size(ph_pos) > maxarraysize or array.get(ph_pos,5) != 0 or array.get(ph_pos,4) != 0 or array.get(ph_pos,3) > maxbars
        array.pop(ph_pos)
        array.pop(ph_vals)

// add PLs to the array
if pl != 0
    array.unshift(pl_pos, bar_index)
    array.unshift(pl_vals, pl)
    if array.size(pl_pos) > maxarraysize or array.get(pl_pos,5) != 0 or array.get(pl_pos,4) != 0 or array.get(pl_pos,3) > maxbars
        array.pop(pl_pos)
        array.pop(pl_vals)



inRange(Pivot, x) =>
    bars = bar_index - array.get(Pivot, x) + lbR
    lbR <= bars and bars <= maxbars
    //bars = barssince(cond == true)    // This method did not work if you want to look back more than one pivot point
    //lbR <= bars and bars <= 300




Del_phs(cond, _line1, _label1, _line2, _label2, number) =>      // This function is used so that I dont have to have 15 lines of code to delete every early line that I draw, You'll see later
    if cond == true
        for x=0 to number-1
            line.delete(_line1[bar_index - array.get(ph_pos, x)])
            line.delete(_line2[bar_index - array.get(ph_pos, x)])
            label.delete(_label1[bar_index - array.get(ph_pos, x)])
            label.delete(_label2[bar_index - array.get(ph_pos, x)])

Del_pls(cond, _line1, _label1, _line2, _label2, number) =>      // This function is used so that I dont have to have 15 lines of code to delete every early line that I draw, You'll see later
    if cond == true
        for x=0 to number-1
            line.delete(_line1[bar_index - array.get(pl_pos, x)])
            line.delete(_line2[bar_index - array.get(pl_pos, x)])
            label.delete(_label1[bar_index - array.get(pl_pos, x)])
            label.delete(_label2[bar_index - array.get(pl_pos, x)])



