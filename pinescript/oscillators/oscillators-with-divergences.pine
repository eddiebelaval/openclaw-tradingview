Del_phs(hiddenBearCond4, HiddenBearLine3, HiddenBearLabel3, HiddenBearLineChart3, HiddenBearLabelChart3, 2)






earlyHiddenBearBool5 = divNumber >= 5 and plotHiddenDiv and inRange(ph_pos, 4) and iHigh and Indicator[1] > array.get(ph_vals, 4) and Indicator[1] > array.get(ph_vals, 3) and Indicator[1] > array.get(ph_vals, 2) and Indicator[1] > array.get(ph_vals, 1) and Indicator[1] > array.get(ph_vals, 0) and array.get(ph_vals, 0) < array.get(ph_vals, 4) and array.get(ph_vals, 1) < array.get(ph_vals, 4) and array.get(ph_vals, 2) < array.get(ph_vals, 4) and array.get(ph_vals, 3) < array.get(ph_vals, 4) and Source[1] < Source[bar_index - array.get(ph_pos, 4) + lbR] ? true : false //NegSlopeFunc("H Bear", 4)//
earlyHiddenBearLine5 = bLines and earlyHiddenBearBool5 and TrendFilterDn ? line.new(array.get(ph_pos, 4) - lbR, array.get(ph_vals, 4), bar_index[1], Indicator[1], color = hiddenBearColor, style = Hid_Div_Line_Style, width = Hid_Div_Line_Width) : na
for x=2 to lbR-1
    if earlyHiddenBearBool5[x-1] and Indicator > Indicator[x]
        line.delete(earlyHiddenBearLine5[x-1])
    
line.delete(earlyHiddenBearLine5[lbR-1])




