HiddenBearLabelChart4 = bLabelsOnChart and hiddenBearCond4 and TrendFilterDn ? label.new(bar_index[lbR], high[lbR], yloc=yloc.abovebar, color = hiddenBearColor, style=Down_Label, text="H Bear", size=Div_Label_Size, textcolor=HiddenBearTextColor, force_overlay = true) : na

