HiddenBearLabelChart3 = bLabelsOnChart and hiddenBearCond3 and TrendFilterDn ? label.new(bar_index[lbR], high[lbR], yloc=yloc.abovebar, color = hiddenBearColor, style=Down_Label, text="H Bear", size=Div_Label_Size, textcolor=HiddenBearTextColor, force_overlay = true) : na

Del_phs(hiddenBearCond3, HiddenBearLine,  HiddenBearLabel,  HiddenBearLineChart,  HiddenBearLabelChart,  3)
Del_phs(hiddenBearCond3, HiddenBearLine2, HiddenBearLabel2, HiddenBearLineChart2, HiddenBearLabelChart2, 2)







earlyHiddenBearBool4 = divNumber >= 4 and plotHiddenDiv and inRange(ph_pos, 3) and iHigh and Indicator[1] > array.get(ph_vals, 3) and Indicator[1] > array.get(ph_vals, 2) and Indicator[1] > array.get(ph_vals, 1) and Indicator[1] > array.get(ph_vals, 0) and array.get(ph_vals, 0) < array.get(ph_vals, 3) and array.get(ph_vals, 1) < array.get(ph_vals, 3) and array.get(ph_vals, 2) < array.get(ph_vals, 3) and Source[1] < Source[bar_index - array.get(ph_pos, 3) + lbR] ? true : false //NegSlopeFunc("H Bear", 3)//
earlyHiddenBearLine4 = bLines and earlyHiddenBearBool4 and TrendFilterDn ? line.new(array.get(ph_pos, 3) - lbR, array.get(ph_vals, 3), bar_index[1], Indicator[1], color = hiddenBearColor, style = Hid_Div_Line_Style, width = Hid_Div_Line_Width) : na
for x=2 to lbR-1
    if earlyHiddenBearBool4[x-1] and Indicator > Indicator[x]
        line.delete(earlyHiddenBearLine4[x-1])
    
line.delete(earlyHiddenBearLine4[lbR-1])




HiddenBearLine4       = bLines         and hiddenBearCond4 and TrendFilterDn ? line.new(array.get(ph_pos, 4) - lbR, array.get(ph_vals, 4),                       bar_index[lbR], Indicator[lbR],  color = hiddenBearColor, style = Div_Line_Style, width = Div_Line_Width) : na
HiddenBearLineChart4  = bLinesOnChart  and hiddenBearCond4 and TrendFilterDn ? line.new(array.get(ph_pos, 4) - lbR, high[bar_index - array.get(ph_pos,4) + lbR], bar_index[lbR], high[lbR],       color = hiddenBearColor, style = Div_Line_Style, width = Div_Line_Width, force_overlay = true) : na

