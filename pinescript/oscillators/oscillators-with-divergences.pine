//        break

earlyBullBool = divNumber >= 1 and plotDiv and inRange(pl_pos, 0) and iLow and Indicator[1] > array.get(pl_vals, 0) and Source[1] < Source[bar_index - array.get(pl_pos, 0) + lbR] ? true : false //PosSlopeFunc("Bull", 0)//
earlyBullLine = bLines and earlyBullBool and TrendFilterUp ? line.new(array.get(pl_pos, 0) - lbR, array.get(pl_vals, 0), bar_index[1], Indicator[1], color = bullColor, style = Div_Line_Style, width = Div_Line_Width) : na
for x=2 to lbR-1
    if earlyBullBool[x-1] and Indicator < Indicator[x]
        line.delete(earlyBullLine[x-1])
    
line.delete(earlyBullLine[lbR-1])

//plot( pl ? Indicator[lbR] : na, offset=-lbR, title="Regular Bullish", linewidth=2, color=(bullCond ? bullColor : None), transp=0)
//plotshape(bullCond ? Indicator[lbR] : na,  offset=-lbR,  title="Regular Bullish Label",  text=" Bull ",  style=shape.labelup,  location=location.absolute,  color=bullColor,  textcolor=White)
BullLine       = bLines         and bullCond and TrendFilterUp ? line.new(array.get(pl_pos, 1) - lbR, array.get(pl_vals, 1),                       bar_index[lbR], Indicator[lbR], color = bullColor, style = Div_Line_Style, width = Div_Line_Width) : na
BullLineChart  = bLinesOnChart  and bullCond and TrendFilterUp ? line.new(array.get(pl_pos, 1) - lbR, low[bar_index - array.get(pl_pos, 1) + lbR], bar_index[lbR], low[lbR],       color = bullColor, style = Div_Line_Style, width = Div_Line_Width, force_overlay = true) : na

BullLabel      = bLabels        and bullCond and TrendFilterUp ? label.new(bar_index[lbR], Indicator[lbR],               color = bullColor, style=Up_Label, text="Bull", size=Div_Label_Size, textcolor=BullTextColor) : na
BullLabelChart = bLabelsOnChart and bullCond and TrendFilterUp ? label.new(bar_index[lbR], low[lbR], yloc=yloc.belowbar, color = bullColor, style=Up_Label, text="Bull", size=Div_Label_Size, textcolor=BullTextColor, force_overlay = true) : na





earlyBullBool2 = divNumber >= 2 and plotDiv and inRange(pl_pos, 1) and iLow and Indicator[1] > array.get(pl_vals, 1) and Indicator[1] < array.get(pl_vals, 0) and array.get(pl_vals, 0) > array.get(pl_vals, 1) and Source[1] < Source[bar_index - array.get(pl_pos, 1) + lbR] ? true : false //PosSlopeFunc("Bull", 1)//
earlyBullLine2 = bLines and earlyBullBool2 and TrendFilterUp ? line.new(array.get(pl_pos, 1) - lbR, array.get(pl_vals, 1), bar_index[1], Indicator[1], color = bullColor, style = Div_Line_Style, width = Div_Line_Width) : na
for x=2 to lbR-1
    if earlyBullBool2[x-1] and Indicator < Indicator[x]
        line.delete(earlyBullLine2[x-1])
    
line.delete(earlyBullLine2[lbR-1])

BullLine2       = bLines         and bullCond2 and TrendFilterUp ? line.new(array.get(pl_pos, 2) - lbR, array.get(pl_vals, 2),                       bar_index[lbR], Indicator[lbR], color = bullColor, style = Div_Line_Style, width = Div_Line_Width) : na
BullLineChart2  = bLinesOnChart  and bullCond2 and TrendFilterUp ? line.new(array.get(pl_pos, 2) - lbR, low[bar_index - array.get(pl_pos, 2) + lbR], bar_index[lbR], low[lbR],       color = bullColor, style = Div_Line_Style, width = Div_Line_Width, force_overlay = true) : na

BullLabel2      = bLabels        and bullCond2 and TrendFilterUp ? label.new(bar_index[lbR], Indicator[lbR],               color = bullColor, style=Up_Label, text="Bull", size=Div_Label_Size, textcolor=BullTextColor) : na
BullLabelChart2 = bLabelsOnChart and bullCond2 and TrendFilterUp ? label.new(bar_index[lbR], low[lbR], yloc=yloc.belowbar, color = bullColor, style=Up_Label, text="Bull", size=Div_Label_Size, textcolor=BullTextColor, force_overlay = true) : na

Del_pls(bullCond2, BullLine, BullLabel, BullLineChart, BullLabelChart, 2)






earlyBullBool3 = divNumber >= 3 and plotDiv and inRange(pl_pos, 2) and iLow and Indicator[1] > array.get(pl_vals, 2) and Indicator[1] < array.get(pl_vals, 1) and Indicator[1] < array.get(pl_vals, 0) and array.get(pl_vals, 0) > array.get(pl_vals, 2) and array.get(pl_vals, 1) > array.get(pl_vals, 2) and Source[1] < Source[bar_index - array.get(pl_pos, 2) + lbR] ? true : false //PosSlopeFunc("Bull", 2)//
earlyBullLine3 = bLines and earlyBullBool3 and TrendFilterUp ? line.new(array.get(pl_pos, 2) - lbR, array.get(pl_vals, 2), bar_index[1], Indicator[1], color = bullColor, style = Div_Line_Style, width = Div_Line_Width) : na
for x=2 to lbR-1
    if earlyBullBool3[x-1] and Indicator < Indicator[x]
        line.delete(earlyBullLine3[x-1])
    
line.delete(earlyBullLine3[lbR-1])

BullLine3       = bLines         and bullCond3 and TrendFilterUp ? line.new(array.get(pl_pos, 3) - lbR, array.get(pl_vals, 3),                       bar_index[lbR], Indicator[lbR], color = bullColor, style = Div_Line_Style, width = Div_Line_Width) : na
BullLineChart3  = bLinesOnChart  and bullCond3 and TrendFilterUp ? line.new(array.get(pl_pos, 3) - lbR, low[bar_index - array.get(pl_pos, 3) + lbR], bar_index[lbR], low[lbR],       color = bullColor, style = Div_Line_Style, width = Div_Line_Width, force_overlay = true) : na

BullLabel3      = bLabels        and bullCond3 and TrendFilterUp ? label.new(bar_index[lbR], Indicator[lbR],               color = bullColor, style=Up_Label, text="Bull", size=Div_Label_Size, textcolor=BullTextColor) : na
BullLabelChart3 = bLabelsOnChart and bullCond3 and TrendFilterUp ? label.new(bar_index[lbR], low[lbR], yloc=yloc.belowbar, color = bullColor, style=Up_Label, text="Bull", size=Div_Label_Size, textcolor=BullTextColor, force_overlay = true) : na

Del_pls(bullCond3, BullLine,  BullLabel,  BullLineChart,  BullLabelChart,  3)
Del_pls(bullCond3, BullLine2, BullLabel2, BullLineChart2, BullLabelChart2, 2)






earlyBullBool4 = divNumber >= 4 and plotDiv and inRange(pl_pos, 3) and iLow and Indicator[1] > array.get(pl_vals, 3) and Indicator[1] < array.get(pl_vals, 2) and Indicator[1] < array.get(pl_vals, 1) and Indicator[1] < array.get(pl_vals, 0) and array.get(pl_vals, 0) > array.get(pl_vals, 3) and array.get(pl_vals, 1) > array.get(pl_vals, 3) and array.get(pl_vals, 2) > array.get(pl_vals, 3) and Source[1] < Source[bar_index - array.get(pl_pos, 3) + lbR] ? true : false //PosSlopeFunc("Bull", 3)//
earlyBullLine4 = bLines and earlyBullBool4 and TrendFilterUp ? line.new(array.get(pl_pos, 3) - lbR, array.get(pl_vals, 3), bar_index[1], Indicator[1], color = bullColor, style = Div_Line_Style, width = Div_Line_Width) : na
for x=2 to lbR-1
    if earlyBullBool4[x-1] and Indicator < Indicator[x]
        line.delete(earlyBullLine4[x-1])

line.delete(earlyBullLine4[lbR-1])



BullLine4       = bLines         and bullCond4 and TrendFilterUp ? line.new(array.get(pl_pos, 4) - lbR, array.get(pl_vals, 4),                       bar_index[lbR], Indicator[lbR], color = bullColor, style = Div_Line_Style, width = Div_Line_Width) : na
BullLineChart4  = bLinesOnChart  and bullCond4 and TrendFilterUp ? line.new(array.get(pl_pos, 4) - lbR, low[bar_index - array.get(pl_pos, 4) + lbR], bar_index[lbR], low[lbR],       color = bullColor, style = Div_Line_Style, width = Div_Line_Width, force_overlay = true) : na

BullLabel4      = bLabels        and bullCond4 and TrendFilterUp ? label.new(bar_index[lbR], Indicator[lbR],               color = bullColor, style=Up_Label, text="Bull", size=Div_Label_Size, textcolor=BullTextColor) : na
BullLabelChart4 = bLabelsOnChart and bullCond4 and TrendFilterUp ? label.new(bar_index[lbR], low[lbR], yloc=yloc.belowbar, color = bullColor, style=Up_Label, text="Bull", size=Div_Label_Size, textcolor=BullTextColor, force_overlay = true) : na

Del_pls(bullCond4, BullLine,  BullLabel,  BullLineChart,  BullLabelChart,  4)
Del_pls(bullCond4, BullLine2, BullLabel2, BullLineChart2, BullLabelChart2, 3)
Del_pls(bullCond4, BullLine3, BullLabel3, BullLineChart3, BullLabelChart3, 2)





earlyBullBool5 = divNumber >= 5 and plotDiv and inRange(pl_pos, 4) and iLow and Indicator[1] > array.get(pl_vals, 4) and Indicator[1] < array.get(pl_vals, 3) and Indicator[1] < array.get(pl_vals, 2) and Indicator[1] < array.get(pl_vals, 1) and Indicator[1] < array.get(pl_vals, 0) and array.get(pl_vals, 0) > array.get(pl_vals, 4) and array.get(pl_vals, 1) > array.get(pl_vals, 4) and array.get(pl_vals, 2) > array.get(pl_vals, 4) and array.get(pl_vals, 3) > array.get(pl_vals, 4) and Source[1] < Source[bar_index - array.get(pl_pos, 4) + lbR] ? true : false //PosSlopeFunc("Bull", 4)//
earlyBullLine5 = bLines and earlyBullBool5 and TrendFilterUp ? line.new(array.get(pl_pos, 4) - lbR, array.get(pl_vals, 4), bar_index[1], Indicator[1], color = bullColor, style = Div_Line_Style, width = Div_Line_Width) : na
for x=2 to lbR-1
    if earlyBullBool5[x-1] and Indicator < Indicator[x]
        line.delete(earlyBullLine5[x-1])

line.delete(earlyBullLine5[lbR-1])



BullLine5       = bLines         and bullCond5 and TrendFilterUp ? line.new(array.get(pl_pos, 5) - lbR, array.get(pl_vals, 5),                       bar_index[lbR], Indicator[lbR], color = bullColor, style = Div_Line_Style, width = Div_Line_Width) : na
BullLineChart5  = bLinesOnChart  and bullCond5 and TrendFilterUp ? line.new(array.get(pl_pos, 5) - lbR, low[bar_index - array.get(pl_pos, 5) + lbR], bar_index[lbR], low[lbR],       color = bullColor, style = Div_Line_Style, width = Div_Line_Width, force_overlay = true) : na

BullLabel5      = bLabels        and bullCond5 and TrendFilterUp ? label.new(bar_index[lbR], Indicator[lbR],               color = bullColor, style=Up_Label, text="Bull", size=Div_Label_Size, textcolor=BullTextColor) : na
BullLabelChart5 = bLabelsOnChart and bullCond5 and TrendFilterUp ? label.new(bar_index[lbR], low[lbR], yloc=yloc.belowbar, color = bullColor, style=Up_Label, text="Bull", size=Div_Label_Size, textcolor=BullTextColor, force_overlay = true) : na

Del_pls(bullCond5, BullLine,  BullLabel,  BullLineChart,  BullLabelChart,  5)
Del_pls(bullCond5, BullLine2, BullLabel2, BullLineChart2, BullLabelChart2, 4)
Del_pls(bullCond5, BullLine3, BullLabel3, BullLineChart3, BullLabelChart3, 3)
Del_pls(bullCond5, BullLine4, BullLabel4, BullLineChart4, BullLabelChart4, 2)



