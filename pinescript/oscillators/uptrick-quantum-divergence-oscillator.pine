//@version=6
indicator("Uptrick: Quantum Divergence Oscillator", shorttitle = "QDO",
     overlay = false, max_bars_back = 500,
     max_lines_count = 500, max_labels_count = 500)

// ══════════════════════════════════════════════════════════════════════════════
//  GROUPS
// ══════════════════════════════════════════════════════════════════════════════
string G_SETUP = "──────────  SETUP  ──────────"
string G_CORE  = "──────────  CLASSIC ENGINE  ──────────"
string G_VOL   = "──────────  VOLATILITY  ──────────"
string G_BPIV  = "──────────  BULL DIVERGENCE  ──────────"
string G_RPIV  = "──────────  BEAR DIVERGENCE  ──────────"
string G_DIV   = "───────  DIVERGENCE DETECTION  ───────"
string G_M2    = "──────────  Z-RSI ENGINE  ──────────"
string G_TREND = "──────────  TREND OVERLAY  ──────────"
string G_SIG   = "──────────  SIGNALS & ALERTS  ──────────"
string G_BAR   = "──────────  BAR COLORING  ──────────"
string G_VIS   = "──────────  VISUALS  ──────────"
string G_TBL   = "──────────  DASHBOARD  ──────────"

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS — SETUP
// ══════════════════════════════════════════════════════════════════════════════
bool FULL_SETUP = input.bool(true, "Full Setup",
     group = G_SETUP,
     tooltip = "ON  — oscillator panel + all overlays.\n"
             + "OFF — panel hidden; only price overlays shown.")

string i_mode = input.string("Z-RSI", "Oscillator Mode",
     options = ["Classic", "Z-RSI"], group = G_SETUP,
     tooltip = "Classic — NW Kernel + KNN, ATR-normalised ±100.\n"
             + "Z-RSI   — Smoothed Z-Score RSI histogram.")

bool IS_M1 = i_mode == "Classic"
bool IS_M2 = i_mode == "Z-RSI"

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS — CLASSIC ENGINE
// ══════════════════════════════════════════════════════════════════════════════
float  i_src        = input.source(close,  "Source",          group = G_CORE)
int    i_basePeriod = input.int(14,        "Base Lookback",   group = G_CORE, minval = 2)
int    i_knnK       = input.int(8,         "KNN Neighbors",   group = G_CORE, minval = 1)
float  i_kernBw     = input.float(8.0,     "Kernel Bandwidth",group = G_CORE, step = 0.5, minval = 0.5)
int    i_smooth     = input.int(5,         "Final Smoothing",  group = G_CORE, minval = 1)

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS — VOLATILITY
// ══════════════════════════════════════════════════════════════════════════════
int    i_atrLen    = input.int(14,    "ATR Length",           group = G_VOL, minval = 1)
int    i_volWindow = input.int(100,   "Vol Rank Window",     group = G_VOL, minval = 10)
float  i_adaptStr  = input.float(0.6, "Adaptation Strength", group = G_VOL, step = 0.05, minval = 0.0, maxval = 1.0)

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS — BULL DIVERGENCE
// ══════════════════════════════════════════════════════════════════════════════
int    i_bullLeft  = input.int(30,   "Left Bars",     group = G_BPIV, minval = 1)
int    i_bullRight = input.int(1,   "Right Bars",    group = G_BPIV, minval = 1)
string i_bullAllow = input.string("All", "Occurrence Filter", group = G_BPIV,
     options = ["All","1st","2nd","3rd","4th","5th"])

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS — BEAR DIVERGENCE
// ══════════════════════════════════════════════════════════════════════════════
int    i_bearLeft  = input.int(30,   "Left Bars",     group = G_RPIV, minval = 1)
int    i_bearRight = input.int(1,   "Right Bars",    group = G_RPIV, minval = 1)
string i_bearAllow = input.string("All", "Occurrence Filter", group = G_RPIV,
     options = ["All","1st","2nd","3rd","4th","5th"])

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS — DIVERGENCE DETECTION
// ══════════════════════════════════════════════════════════════════════════════
int  i_divLook    = input.int(120,   "Max Lookback", group = G_DIV, minval = 10)
bool i_showRegDiv = input.bool(true, "Enable Regular Divergence", group = G_DIV)

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS — Z-RSI ENGINE
// ══════════════════════════════════════════════════════════════════════════════
float src2     = input.source(close, "Source",           group = G_M2)
int   rsiLen   = input.int(14,       "RSI Length",       group = G_M2, minval = 2)
int   zLen     = input.int(50,       "Z-Score Lookback", group = G_M2, minval = 5)
int   zSmoothL = input.int(3,        "Z-Score Smooth",   group = G_M2, minval = 1)

float M2_SIG  =  1.0
float M2_NSIG = -1.0
float M2_EXT  =  2.0
float M2_NEXT = -2.0

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS — TREND OVERLAY
// ══════════════════════════════════════════════════════════════════════════════
bool showTrend = input.bool(true, "Show Trend Overlay",  group = G_TREND)
int  trendLen  = input.int(50,    "EMA Period",          group = G_TREND, minval = 5)
int  trendW    = input.int(2,     "Main Line Width",     group = G_TREND, minval = 1, maxval = 5)

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS — SIGNALS & ALERTS
// ══════════════════════════════════════════════════════════════════════════════
bool   i_showOvSig = input.bool(true,  "Show Overlay Signals", group = G_SIG)
string i_sigType   = input.string("Divergence", "Signal Type", group = G_SIG,
     options = ["Divergence", "OB/OS", "Both"])
string i_sigFilter = input.string("Both", "Direction Filter", group = G_SIG,
     options = ["Both","Bullish Only","Bearish Only"])
bool   i_alertOn   = input.bool(true, "Enable Alerts", group = G_SIG)

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS — BAR COLORING
// ══════════════════════════════════════════════════════════════════════════════
string i_barMode = input.string("Trend", "Bar Color Mode", group = G_BAR,
     options = ["Signal", "Trend", "Heat"],
     tooltip = "Signal — colors persist from last bull/bear signal.\n"
             + "Trend  — colors follow the trend line slope.\n"
             + "Heat   — smooth gradient: higher osc = more bearish, lower = more bullish.")

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS — VISUALS
// ══════════════════════════════════════════════════════════════════════════════
bool  showBG       = input.bool(true,    "OB/OS Background Tint", group = G_VIS)
int   bgAlpha      = input.int(93,       "Background Opacity",    group = G_VIS, minval = 70, maxval = 99)
color i_colBull    = input.color(#00FFE5, "Bullish",  group = G_VIS)
color i_colBear    = input.color(#FF00B5, "Bearish",  group = G_VIS)
color i_colNeutral = input.color(#787B86, "Neutral",  group = G_VIS)

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS — DASHBOARD
// ══════════════════════════════════════════════════════════════════════════════
bool   showTbl  = input.bool(true,  "Show Dashboard", group = G_TBL)
string tblPos   = input.string("Top Right", "Position", group = G_TBL,
     options = ["Top Right","Top Left","Bottom Right","Bottom Left"])
string tblSzStr = input.string("Small", "Text Size", group = G_TBL,
     options = ["Tiny","Small","Normal"])

// ══════════════════════════════════════════════════════════════════════════════
//  HELPER FUNCTIONS
// ══════════════════════════════════════════════════════════════════════════════
f_tblPos(_s) =>
    _s == "Top Left"     ? position.top_left    :
     _s == "Bottom Right" ? position.bottom_right :
     _s == "Bottom Left"  ? position.bottom_left  :
     position.top_right

f_tblSz(_s) =>
    _s == "Normal" ? size.normal : _s == "Small" ? size.small : size.tiny

f_r2(_x) =>
    str.tostring(math.round(_x, 2))

f_allowToInt(_str) =>
    _str == "1st" ? 1 : _str == "2nd" ? 2 : _str == "3rd" ? 3 :
     _str == "4th" ? 4 : _str == "5th" ? 5 : 0

f_percentileRank(_val, _len) =>
    int count = 0
    for i = 1 to _len
        if _val > nz(_val[i])
            count += 1
    100.0 * count / _len

f_nadarayaWatson(_src, _len, _h) =>
    float num = 0.0
    float den = 0.0
    for i = 0 to _len - 1
        float u = i / _h
        float w = math.exp(-0.5 * u * u)
        num += w * nz(_src[i])
        den += w
    den == 0.0 ? _src : num / den

f_knnSmooth(_src, _k, _lookback) =>
    int   maxLook = math.min(_lookback, 60)
    float sumW    = 0.0
    float sumWV   = 0.0
    float maxDist = 0.0
    for i = 1 to maxLook
        float d = math.abs(_src - nz(_src[i]))
        if d > maxDist
            maxDist := d
    float threshold = maxDist
    int   found     = 0
    for step = 0 to 4
        found := 0
        sumW  := 0.0
        sumWV := 0.0
        for i = 1 to maxLook
            float d = math.abs(_src - nz(_src[i]))
            if d <= threshold
                float w = maxDist > 0 ? math.exp(-2.0 * d / maxDist) : 1.0
                sumW  += w
                sumWV += w * nz(_src[i])
                found += 1
        if found >= _k
            break
        threshold *= 1.5
    sumW > 0 ? sumWV / sumW : _src

// ══════════════════════════════════════════════════════════════════════════════
//  MODE 1 ENGINE
// ══════════════════════════════════════════════════════════════════════════════
float atrVal     = ta.atr(i_atrLen)
float atrPctRank = f_percentileRank(atrVal, i_volWindow) / 100.0

float adaptRatio          = 1.0 + i_adaptStr * (1.0 - 2.0 * atrPctRank)
int   adaptPeriod         = math.round(i_basePeriod * adaptRatio)
int   adaptPeriod_clamped = math.max(4, math.min(adaptPeriod, 100))
float adaptBw             = i_kernBw * adaptRatio
float adaptBw_c           = math.max(1.0, adaptBw)

float nwEstimate  = f_nadarayaWatson(i_src, adaptPeriod_clamped, adaptBw_c)
float knnSmoothed = f_knnSmooth(nwEstimate, i_knnK, adaptPeriod_clamped)

float rawDeviation = i_src - knnSmoothed
float normOsc      = atrVal > 0 ? rawDeviation / atrVal : 0.0
float oscSmoothed  = ta.ema(normOsc, i_smooth)
float oscAbs       = math.abs(oscSmoothed)
float oscP95       = ta.percentile_linear_interpolation(oscAbs, 200, 95)
float scaleFactor  = oscP95 > 0 ? 50.0 / oscP95 : 1.0
float oscFinal     = math.max(-100.0, math.min(100.0, oscSmoothed * scaleFactor))

float baseOB    =  40.0
float baseOS    = -40.0
float bandShift = 20.0 * (atrPctRank - 0.5)
float dynOB     = baseOB + bandShift
float dynOS     = baseOS - bandShift

bool m1AbvOB = oscFinal > dynOB
bool m1BlwOS = oscFinal < dynOS

// ══════════════════════════════════════════════════════════════════════════════
//  MODE 1 HISTOGRAM COLOR — gray default, colored only in OB/OS zones
// ══════════════════════════════════════════════════════════════════════════════
bool  m1Rising = oscFinal > nz(oscFinal[1])

color oscColor =
     m1AbvOB and m1Rising     ? i_colBear :
     m1AbvOB and not m1Rising ? color.new(i_colBear, 55) :
     m1BlwOS and not m1Rising ? i_colBull :
     m1BlwOS and m1Rising     ? color.new(i_colBull, 55) :
     i_colNeutral

// ══════════════════════════════════════════════════════════════════════════════
//  MODE 1 OB/OS SIGNALS
// ══════════════════════════════════════════════════════════════════════════════
bool obosBull = IS_M1 and ta.crossover(oscFinal,  dynOS)
bool obosBear = IS_M1 and ta.crossunder(oscFinal, dynOB)

// ══════════════════════════════════════════════════════════════════════════════
//  MODE 1 DIVERGENCE
// ══════════════════════════════════════════════════════════════════════════════
bool plFound = IS_M1 and not na(ta.pivotlow(oscFinal,  i_bullLeft, i_bullRight))
bool phFound = IS_M1 and not na(ta.pivothigh(oscFinal, i_bearLeft, i_bearRight))

var array<float> plPrices = array.new_float()
var array<float> plOscs   = array.new_float()
var array<int>   plBars   = array.new_int()
var array<float> phPrices = array.new_float()
var array<float> phOscs   = array.new_float()
var array<int>   phBars   = array.new_int()
int MAX_PIVOTS = 10

float currPL_price = low[i_bullRight]
float currPL_osc   = oscFinal[i_bullRight]
int   currPL_bar   = bar_index - i_bullRight
float currPH_price = high[i_bearRight]
float currPH_osc   = oscFinal[i_bearRight]
int   currPH_bar   = bar_index - i_bearRight

var bool  rawRegBullDiv = false
var bool  rawRegBearDiv = false
var float matchPL_osc   = na
var int   matchPL_bar   = na
var float matchPH_osc   = na
var int   matchPH_bar   = na

rawRegBullDiv := false
rawRegBearDiv := false

if plFound
    if array.size(plBars) > 0
        for i = array.size(plBars) - 1 to 0
            int   pBar   = array.get(plBars,   i)
            float pPrice = array.get(plPrices, i)
            float pOsc   = array.get(plOscs,   i)
            int   dist   = currPL_bar - pBar
            if dist > 0 and dist <= i_divLook
                if currPL_price < pPrice and currPL_osc > pOsc
                    rawRegBullDiv := true
                    matchPL_osc   := pOsc
                    matchPL_bar   := pBar
                    break
    array.push(plPrices, currPL_price)
    array.push(plOscs,   currPL_osc)
    array.push(plBars,   currPL_bar)
    if array.size(plBars) > MAX_PIVOTS
        array.shift(plPrices)
        array.shift(plOscs)
        array.shift(plBars)

if phFound
    if array.size(phBars) > 0
        for i = array.size(phBars) - 1 to 0
            int   pBar   = array.get(phBars,   i)
            float pPrice = array.get(phPrices, i)
            float pOsc   = array.get(phOscs,   i)
            int   dist   = currPH_bar - pBar
            if dist > 0 and dist <= i_divLook
                if currPH_price > pPrice and currPH_osc < pOsc
                    rawRegBearDiv := true
                    matchPH_osc   := pOsc
                    matchPH_bar   := pBar
                    break
    array.push(phPrices, currPH_price)
    array.push(phOscs,   currPH_osc)
    array.push(phBars,   currPH_bar)
    if array.size(phBars) > MAX_PIVOTS
        array.shift(phPrices)
        array.shift(phOscs)
        array.shift(phBars)

// ══════════════════════════════════════════════════════════════════════════════
//  OCCURRENCE COUNTER + FILTER
// ══════════════════════════════════════════════════════════════════════════════
int bullAllowN = f_allowToInt(i_bullAllow)
int bearAllowN = f_allowToInt(i_bearAllow)

var int bullCount = 0
var int bearCount = 0

if rawRegBullDiv
    bullCount += 1
if rawRegBearDiv
    bullCount := 0
if rawRegBearDiv
    bearCount += 1
if rawRegBullDiv
    bearCount := 0

bool bullOccurrencePass = bullAllowN == 0 ? true : bullCount == bullAllowN
bool bearOccurrencePass = bearAllowN == 0 ? true : bearCount == bearAllowN

bool regBullDiv = i_showRegDiv and rawRegBullDiv and bullOccurrencePass
bool regBearDiv = i_showRegDiv and rawRegBearDiv and bearOccurrencePass

// ══════════════════════════════════════════════════════════════════════════════
//  MODE 2 ENGINE
// ══════════════════════════════════════════════════════════════════════════════
float rawRsi  = ta.rsi(src2, rsiLen)
float zMean   = ta.sma(rawRsi, zLen)
float zStdev  = ta.stdev(rawRsi, zLen)
float m2Val   = ta.ema(zStdev > 0.0 ? (rawRsi - zMean) / zStdev : 0.0, zSmoothL)
bool  m2AbExt = m2Val >  M2_EXT
bool  m2BlExt = m2Val <  M2_NEXT
bool  m2AbSig = m2Val >  M2_SIG
bool  m2BlSig = m2Val <  M2_NSIG

bool m2DivBull  = IS_M2 and ta.crossover(m2Val,  M2_NEXT)
bool m2DivBear  = IS_M2 and ta.crossunder(m2Val, M2_EXT)
bool m2ObosBull = IS_M2 and ta.crossover(m2Val,  M2_NSIG)
bool m2ObosBear = IS_M2 and ta.crossunder(m2Val, M2_SIG)

// ══════════════════════════════════════════════════════════════════════════════
//  MODE 2 HISTOGRAM COLOR — gray default, colored only in extreme zones
// ══════════════════════════════════════════════════════════════════════════════
bool  m2Rising = m2Val > nz(m2Val[1])

color m2Col =
     m2AbExt and m2Rising     ? i_colBear :
     m2AbExt and not m2Rising ? color.new(i_colBear, 55) :
     m2BlExt and not m2Rising ? i_colBull :
     m2BlExt and m2Rising     ? color.new(i_colBull, 55) :
     i_colNeutral

// ══════════════════════════════════════════════════════════════════════════════
//  SIGNAL COMPOSITES
// ══════════════════════════════════════════════════════════════════════════════
bool showDivSigs  = i_sigType == "Divergence" or i_sigType == "Both"
bool showOBOSSigs = i_sigType == "OB/OS"      or i_sigType == "Both"

bool dirBullOk = i_sigFilter == "Both" or i_sigFilter == "Bullish Only"
bool dirBearOk = i_sigFilter == "Both" or i_sigFilter == "Bearish Only"

bool divBullSig  = IS_M1 and showDivSigs  and regBullDiv and dirBullOk
bool divBearSig  = IS_M1 and showDivSigs  and regBearDiv and dirBearOk
bool obosBullSig = IS_M1 and showOBOSSigs and obosBull    and dirBullOk
bool obosBearSig = IS_M1 and showOBOSSigs and obosBear    and dirBearOk

bool m2BullSig = IS_M2 and dirBullOk and (
     (showDivSigs  and m2DivBull)  or
     (showOBOSSigs and m2ObosBull))
bool m2BearSig = IS_M2 and dirBearOk and (
     (showDivSigs  and m2DivBear)  or
     (showOBOSSigs and m2ObosBear))

bool rawAnyBull = divBullSig or obosBullSig or m2BullSig
bool rawAnyBear = divBearSig or obosBearSig or m2BearSig

bool anyBullSig = rawAnyBull and not rawAnyBear
bool anyBearSig = rawAnyBear and not rawAnyBull

// ══════════════════════════════════════════════════════════════════════════════
//  ML TREND LINE — OHLC cloud + vertical gradient to price
// ══════════════════════════════════════════════════════════════════════════════
float trendSrc   = IS_M1 ? i_src : src2
int   smoothLen  = math.max(3, trendLen / 5)

// EMA on each OHLC component for the trend "candle" cloud
float emaClose   = ta.ema(trendSrc, trendLen)
float emaOpen    = ta.ema(open,     trendLen)
float emaHigh    = ta.ema(high,     trendLen)
float emaLow     = ta.ema(low,      trendLen)

// Double-smooth for the main trend line (close-based)
float trendLine  = ta.ema(emaClose, smoothLen)
float trendOpen  = ta.ema(emaOpen,  smoothLen)
float trendHi    = ta.ema(emaHigh,  smoothLen)
float trendLo    = ta.ema(emaLow,   smoothLen)

bool  trendBull  = trendLine > nz(trendLine[1])
color trendCol   = trendBull ? i_colBull : i_colBear


// Main trend line on top
pTC = plot(showTrend ? trendLine : na, "Trend Close",
     trendCol, trendW, plot.style_line, force_overlay = true)

// ── Vertical gradient fill: trend line → price ──────────────────────────────
pPrice = plot(showTrend ? close : na, "Price",
     color.new(#ffffff, 100), 1, plot.style_line, display = display.none, force_overlay = true)

// When price > trendLine: top = price (faded), bottom = trendLine (intense)
// When price < trendLine: top = trendLine (intense), bottom = price (faded)
color cIntense   = trendBull ? color.new(i_colBull, 50) : color.new(i_colBear, 50)
color cFade      = trendBull ? color.new(i_colBull, 100) : color.new(i_colBear, 100)
bool  priceAbove = close > trendLine

float fillHi     = math.max(trendLine, close)
float fillLo     = math.min(trendLine, close)
color gradTop    = priceAbove ? cFade    : cIntense
color gradBot    = priceAbove ? cIntense : cFade

fill(pTC, pPrice, fillHi, fillLo, gradTop, gradBot, title = "Trend-Price Gradient")

// ══════════════════════════════════════════════════════════════════════════════
//  REVERSAL METER — slope-colored band at top of oscillator panel
// ══════════════════════════════════════════════════════════════════════════════
float meterHi = IS_M1 ? 115.0 : 4.0
float meterLo = IS_M1 ? 108.0 : 3.5

pMeterHi = plot(FULL_SETUP ? meterHi : na, "Meter Hi",
     color.new(#ffffff, 100), display = display.none)
pMeterLo = plot(FULL_SETUP ? meterLo : na, "Meter Lo",
     color.new(#ffffff, 100), display = display.none)
fill(pMeterHi, pMeterLo, color.new(trendCol, 15), title = "Trend Meter")

// ══════════════════════════════════════════════════════════════════════════════
//  OSCILLATOR PANEL — only when FULL_SETUP = true
// ══════════════════════════════════════════════════════════════════════════════
hline(0, "Zero", color.new(#787B86, FULL_SETUP ? 50 : 100), hline.style_dotted)

// ── Mode 1 bands ─────────────────────────────────────────────────────────────
obPlot  = plot(FULL_SETUP and IS_M1 ? dynOB : na,
     "OB Band", color.new(i_colBear, 75), 1, plot.style_line)
osPlot  = plot(FULL_SETUP and IS_M1 ? dynOS : na,
     "OS Band", color.new(i_colBull, 75), 1, plot.style_line)
midPlot = plot(0, "Mid", color.new(#ffffff, 100), display = display.none)

fill(obPlot, midPlot, color.new(i_colBear, 96))
fill(osPlot, midPlot, color.new(i_colBull, 96))

// ── Mode 2 bands ─────────────────────────────────────────────────────────────
pE2  = plot(FULL_SETUP and IS_M2 ? M2_EXT  : na, "Z+2", color.new(i_colBear, 65), 1, plot.style_circles)
pS2  = plot(FULL_SETUP and IS_M2 ? M2_SIG  : na, "Z+1", color.new(i_colBear, 40), 1)
pNS2 = plot(FULL_SETUP and IS_M2 ? M2_NSIG : na, "Z-1", color.new(i_colBull, 40), 1)
pNE2 = plot(FULL_SETUP and IS_M2 ? M2_NEXT : na, "Z-2", color.new(i_colBull, 65), 1, plot.style_circles)

fill(pE2,  pS2,  color.new(i_colBear, 93))
fill(pNS2, pNE2, color.new(i_colBull, 93))

// ── Histogram ─────────────────────────────────────────────────────────────────
float panelVal = IS_M1 ? oscFinal : m2Val
color panelCol = IS_M1 ? oscColor : m2Col

plot(FULL_SETUP ? panelVal : na,
     "Histogram", panelCol, 1, plot.style_columns)

// ══════════════════════════════════════════════════════════════════════════════
//  OVERLAY — SIGNAL ARROWS
// ══════════════════════════════════════════════════════════════════════════════
float bullLabelPrice = IS_M1 ?
     (obosBullSig ? low : regBullDiv ? low[i_bullRight] : na) :
     (anyBullSig  ? low : na)
float bearLabelPrice = IS_M1 ?
     (obosBearSig ? high : regBearDiv ? high[i_bearRight] : na) :
     (anyBearSig  ? high : na)

if i_showOvSig and anyBullSig
    label.new(bar_index, bullLabelPrice, "𝓤𝓹",
         yloc = yloc.belowbar, style = label.style_label_up,
         color = i_colBull, textcolor = #000000,
         size = size.normal, force_overlay = true)

if i_showOvSig and anyBearSig
    label.new(bar_index, bearLabelPrice, "𝓓𝓸𝔀𝓷",
         yloc = yloc.abovebar, style = label.style_label_down,
         color = i_colBear, textcolor = color.white,
         size = size.normal, force_overlay = true)

// ══════════════════════════════════════════════════════════════════════════════
//  OVERLAY — BAR + CANDLE COLORING (3 modes)
// ══════════════════════════════════════════════════════════════════════════════
var int sigState = 0
if anyBullSig
    sigState := 1
else if anyBearSig
    sigState := -1

// Heat mode: smooth gradient from oscillator value
float heatVal   = IS_M1 ? oscFinal : m2Val
float heatMax   = IS_M1 ? 100.0    : 3.0
float heatNorm  = math.max(-1.0, math.min(1.0, heatVal / heatMax))
color heatColor = color.from_gradient(heatNorm, -1.0, 1.0, i_colBull, i_colBear)

color barCol =
     i_barMode == "Trend"  ? trendCol :
     i_barMode == "Heat"   ? heatColor :
     sigState == 1 ? i_colBull : i_colBear

barcolor(barCol, title = "Bar Color")
plotcandle(open, high, low, close,
     color = barCol, wickcolor = barCol, bordercolor = barCol,
     title = "Candles", force_overlay = true)

// ══════════════════════════════════════════════════════════════════════════════
//  OVERLAY — BACKGROUND TINT
// ══════════════════════════════════════════════════════════════════════════════
bool bgBear = IS_M1 ? m1AbvOB : m2AbExt
bool bgBull = IS_M1 ? m1BlwOS : m2BlExt

bgcolor(showBG and bgBear ? color.new(i_colBear, bgAlpha) : na, force_overlay = true)
bgcolor(showBG and bgBull ? color.new(i_colBull, bgAlpha) : na, force_overlay = true)

// ══════════════════════════════════════════════════════════════════════════════
//  MULTI-TIMEFRAME DATA
// ══════════════════════════════════════════════════════════════════════════════
[htf1_osc, htf1_bull, htf1_bear, htf1_trend] = request.security(syminfo.tickerid, "60",
     [oscFinal, m1BlwOS, m1AbvOB, trendBull], lookahead = barmerge.lookahead_off)
[htf2_osc, htf2_bull, htf2_bear, htf2_trend] = request.security(syminfo.tickerid, "240",
     [oscFinal, m1BlwOS, m1AbvOB, trendBull], lookahead = barmerge.lookahead_off)
[htf3_osc, htf3_bull, htf3_bear, htf3_trend] = request.security(syminfo.tickerid, "D",
     [oscFinal, m1BlwOS, m1AbvOB, trendBull], lookahead = barmerge.lookahead_off)

f_tfZone(_bull, _bear) =>
    _bear ? "OB" : _bull ? "OS" : "—"
f_tfTrend(_b) =>
    _b ? "▲" : "▼"
f_tfBias(_osc) =>
    _osc > 0 ? "BULL" : "BEAR"

// ══════════════════════════════════════════════════════════════════════════════
//  DASHBOARD TABLE
// ══════════════════════════════════════════════════════════════════════════════
var table tbl = table.new(f_tblPos(tblPos), 3, 18,
     bgcolor      = color.new(#0a0a0f, 0),
     border_color = color.new(#1a1a2e, 0),  border_width = 1,
     frame_color  = color.new(#2a2a4a, 0),  frame_width  = 2)

if showTbl and barstate.islast and FULL_SETUP
    color cW     = color.white
    color cBull  = i_colBull
    color cBear  = i_colBear
    color cBg    = color.new(#0a0a0f, 0)
    color cHead  = color.new(#12122a, 0)
    color cRow1  = color.new(#0e0e1a, 0)
    color cRow2  = color.new(#101020, 0)
    string sz    = f_tblSz(tblSzStr)
    float dispVal = IS_M1 ? oscFinal : m2Val

    // ── Row 0: Header ─────────────────────────────────────────────────────────
    string modeTag = IS_M1 ? "CLASSIC" : "Z-RSI"
    table.cell(tbl, 0, 0, "  QDO", text_color = cBull, text_size = sz,
         bgcolor = cHead, text_halign = text.align_left)
    table.cell(tbl, 1, 0, modeTag, text_color = cW, text_size = sz,
         bgcolor = cHead, text_halign = text.align_center)
    table.cell(tbl, 2, 0, syminfo.ticker + " · " + timeframe.period + "  ",
         text_color = cW, text_size = sz,
         bgcolor = cHead, text_halign = text.align_right)

    // ── Row 1: Oscillator ─────────────────────────────────────────────────────
    color valCol = dispVal > 0 ? cBull : cBear
    table.cell(tbl, 0, 1, "  Oscillator", text_color = cW, text_size = sz,
         bgcolor = cRow1, text_halign = text.align_left)
    table.cell(tbl, 1, 1, str.tostring(dispVal, "#.##"),
         text_color = valCol, text_size = sz,
         bgcolor = cRow1, text_halign = text.align_center)
    string zoneStr = IS_M1 ?
         (m1AbvOB ? "OVERBOUGHT" : m1BlwOS ? "OVERSOLD" : "NEUTRAL") :
         (m2AbExt ? "EXTREME +" : m2BlExt ? "EXTREME −" :
          m2AbSig ? "BULL ZONE" : m2BlSig ? "BEAR ZONE" : "NEUTRAL")
    color zoneCol = (m1AbvOB or m2AbExt or m2AbSig) ? cBear :
         (m1BlwOS or m2BlExt or m2BlSig) ? cBull : cW
    table.cell(tbl, 2, 1, zoneStr + "  ", text_color = zoneCol, text_size = sz,
         bgcolor = cRow1, text_halign = text.align_right)

    // ── Row 2: Signal ─────────────────────────────────────────────────────────
    table.cell(tbl, 0, 2, "  Signal", text_color = cW, text_size = sz,
         bgcolor = cRow2, text_halign = text.align_left)
    table.cell(tbl, 1, 2, sigState == 1 ? "▲ BULLISH" : "▼ BEARISH",
         text_color = sigState == 1 ? cBull : cBear, text_size = sz,
         bgcolor = cRow2, text_halign = text.align_center)
    table.cell(tbl, 2, 2, i_sigType + " · " + i_sigFilter + "  ",
         text_color = cW, text_size = sz,
         bgcolor = cRow2, text_halign = text.align_right)

    // ── Row 3: Trend ──────────────────────────────────────────────────────────
    table.cell(tbl, 0, 3, "  ML Trend", text_color = cW, text_size = sz,
         bgcolor = cRow1, text_halign = text.align_left)
    table.cell(tbl, 1, 3, trendBull ? "▲ BULL" : "▼ BEAR",
         text_color = trendBull ? cBull : cBear, text_size = sz,
         bgcolor = cRow1, text_halign = text.align_center)
    table.cell(tbl, 2, 3, "Bar: " + i_barMode + "  ",
         text_color = cW, text_size = sz,
         bgcolor = cRow1, text_halign = text.align_right)

    // ── Row 4: Vol / Z ────────────────────────────────────────────────────────
    string r4l = IS_M1 ? "  Vol Regime" : "  Z Value"
    string r4v = IS_M1 ?
         (atrPctRank > 0.75 ? "HIGH ▲" : atrPctRank < 0.25 ? "LOW ▼" : "MED ●") :
         f_r2(m2Val)
    color r4c = IS_M1 ?
         (atrPctRank > 0.75 ? cBear : atrPctRank < 0.25 ? cBull : cW) :
         (m2Val > M2_SIG ? cBear : m2Val < M2_NSIG ? cBull : cW)
    string r4r = IS_M1 ? f_r2(dynOB) + " / " + f_r2(dynOS) : "Lookback: " + str.tostring(zLen)
    table.cell(tbl, 0, 4, r4l, text_color = cW, text_size = sz,
         bgcolor = cRow2, text_halign = text.align_left)
    table.cell(tbl, 1, 4, r4v, text_color = r4c, text_size = sz,
         bgcolor = cRow2, text_halign = text.align_center)
    table.cell(tbl, 2, 4, r4r + "  ", text_color = cW, text_size = sz,
         bgcolor = cRow2, text_halign = text.align_right)

    // ── Row 5: Engine detail ──────────────────────────────────────────────────
    string r5l = IS_M1 ? "  Adapt Period" : "  RSI Length"
    string r5v = IS_M1 ? str.tostring(adaptPeriod_clamped) : str.tostring(rsiLen)
    string r5r = IS_M1 ?
         "Div: " + str.tostring(bullCount) + "/" + i_bullAllow :
         (m2AbExt ? "▲ ABOVE +2" : m2BlExt ? "▼ BELOW −2" : "WITHIN ±2")
    color r5rc = IS_M1 ? cBull :
         (m2AbExt ? cBear : m2BlExt ? cBull : cW)
    table.cell(tbl, 0, 5, r5l, text_color = cW, text_size = sz,
         bgcolor = cRow1, text_halign = text.align_left)
    table.cell(tbl, 1, 5, r5v, text_color = cW, text_size = sz,
         bgcolor = cRow1, text_halign = text.align_center)
    table.cell(tbl, 2, 5, r5r + "  ", text_color = r5rc, text_size = sz,
         bgcolor = cRow1, text_halign = text.align_right)

    // ── Row 6: MTF header ─────────────────────────────────────────────────────
    table.cell(tbl, 0, 6, "  TIMEFRAME", text_color = cBull, text_size = sz,
         bgcolor = cHead, text_halign = text.align_left)
    table.cell(tbl, 1, 6, "TREND", text_color = cBull, text_size = sz,
         bgcolor = cHead, text_halign = text.align_center)
    table.cell(tbl, 2, 6, "ZONE · BIAS  ", text_color = cBull, text_size = sz,
         bgcolor = cHead, text_halign = text.align_right)

    // ── Row 7: Current TF ────────────────────────────────────────────────────
    string curZ = IS_M1 ? (m1AbvOB ? "OB" : m1BlwOS ? "OS" : "—") : "—"
    color  curC = trendBull ? cBull : cBear
    table.cell(tbl, 0, 7, "  " + timeframe.period, text_color = cW, text_size = sz,
         bgcolor = cRow2, text_halign = text.align_left)
    table.cell(tbl, 1, 7, f_tfTrend(trendBull), text_color = curC, text_size = sz,
         bgcolor = cRow2, text_halign = text.align_center)
    table.cell(tbl, 2, 7, curZ + " · " + f_tfBias(dispVal) + "  ",
         text_color = curC, text_size = sz,
         bgcolor = cRow2, text_halign = text.align_right)

    // ── Row 8: 1H ────────────────────────────────────────────────────────────
    color h1C = htf1_trend ? cBull : cBear
    table.cell(tbl, 0, 8, "  1H", text_color = cW, text_size = sz,
         bgcolor = cRow1, text_halign = text.align_left)
    table.cell(tbl, 1, 8, f_tfTrend(htf1_trend), text_color = h1C, text_size = sz,
         bgcolor = cRow1, text_halign = text.align_center)
    table.cell(tbl, 2, 8,
         f_tfZone(htf1_bull, htf1_bear) + " · " + f_tfBias(htf1_osc) + "  ",
         text_color = h1C, text_size = sz,
         bgcolor = cRow1, text_halign = text.align_right)

    // ── Row 9: 4H ────────────────────────────────────────────────────────────
    color h4C = htf2_trend ? cBull : cBear
    table.cell(tbl, 0, 9, "  4H", text_color = cW, text_size = sz,
         bgcolor = cRow2, text_halign = text.align_left)
    table.cell(tbl, 1, 9, f_tfTrend(htf2_trend), text_color = h4C, text_size = sz,
         bgcolor = cRow2, text_halign = text.align_center)
    table.cell(tbl, 2, 9,
         f_tfZone(htf2_bull, htf2_bear) + " · " + f_tfBias(htf2_osc) + "  ",
         text_color = h4C, text_size = sz,
         bgcolor = cRow2, text_halign = text.align_right)

    // ── Row 10: 1D ───────────────────────────────────────────────────────────
    color d1C = htf3_trend ? cBull : cBear
    table.cell(tbl, 0, 10, "  1D", text_color = cW, text_size = sz,
         bgcolor = cRow1, text_halign = text.align_left)
    table.cell(tbl, 1, 10, f_tfTrend(htf3_trend), text_color = d1C, text_size = sz,
         bgcolor = cRow1, text_halign = text.align_center)
    table.cell(tbl, 2, 10,
         f_tfZone(htf3_bull, htf3_bear) + " · " + f_tfBias(htf3_osc) + "  ",
         text_color = d1C, text_size = sz,
         bgcolor = cRow1, text_halign = text.align_right)

    // ── Row 11: MTF Alignment ────────────────────────────────────────────────
    int bullTFs = (trendBull ? 1 : 0) + (htf1_trend ? 1 : 0) +
         (htf2_trend ? 1 : 0) + (htf3_trend ? 1 : 0)
    string alignStr =
          bullTFs == 4 ? "STRONG BULL ████" :
          bullTFs == 3 ? "BULL ███░" :
          bullTFs == 2 ? "MIXED ██░░" :
          bullTFs == 1 ? "BEAR █░░░" :
                         "STRONG BEAR ░░░░"
    color alignCol = bullTFs >= 3 ? cBull : bullTFs <= 1 ? cBear : cW
    table.cell(tbl, 0, 11, "  Alignment", text_color = cW, text_size = sz,
         bgcolor = cRow2, text_halign = text.align_left)
    table.cell(tbl, 1, 11, str.tostring(bullTFs) + "/4",
         text_color = alignCol, text_size = sz,
         bgcolor = cRow2, text_halign = text.align_center)
    table.cell(tbl, 2, 11, alignStr + "  ", text_color = alignCol, text_size = sz,
         bgcolor = cRow2, text_halign = text.align_right)

    // ── Row 12: Price ────────────────────────────────────────────────────────
    float chgPct = (close - open) / open * 100.0
    color chgCol = close >= open ? cBull : cBear
    table.cell(tbl, 0, 12, "  Price", text_color = cW, text_size = sz,
         bgcolor = cHead, text_halign = text.align_left)
    table.cell(tbl, 1, 12, str.tostring(close, format.mintick),
         text_color = chgCol, text_size = sz,
         bgcolor = cHead, text_halign = text.align_center)
    table.cell(tbl, 2, 12, str.tostring(chgPct, "#.##") + "%  ",
         text_color = chgCol, text_size = sz,
         bgcolor = cHead, text_halign = text.align_right)

    // ── Row 13: Footer ───────────────────────────────────────────────────────
    table.cell(tbl, 0, 13, "", bgcolor = cBg)
    table.cell(tbl, 1, 13,
         "QDO · Uptrick · " + str.format_time(timenow, "HH:mm", syminfo.timezone),
         text_color = color.new(cW, 40), text_size = sz,
         bgcolor = cBg, text_halign = text.align_center)
    table.cell(tbl, 2, 13, "", bgcolor = cBg)

// ══════════════════════════════════════════════════════════════════════════════
//  ALERTS
// ══════════════════════════════════════════════════════════════════════════════
alertcondition(i_alertOn and IS_M1 and divBullSig,
     "QDO — Bull Divergence", "QDO: Bull divergence · {{ticker}} · {{interval}}")
alertcondition(i_alertOn and IS_M1 and divBearSig,
     "QDO — Bear Divergence", "QDO: Bear divergence · {{ticker}} · {{interval}}")
alertcondition(i_alertOn and IS_M1 and obosBullSig,
     "QDO — Bull OB/OS",      "QDO: Bull OS exit · {{ticker}} · {{interval}}")
alertcondition(i_alertOn and IS_M1 and obosBearSig,
     "QDO — Bear OB/OS",      "QDO: Bear OB exit · {{ticker}} · {{interval}}")
alertcondition(i_alertOn and anyBullSig,
     "QDO — Bullish Signal",  "QDO: Bullish · {{ticker}} · {{interval}}")
alertcondition(i_alertOn and anyBearSig,
     "QDO — Bearish Signal",  "QDO: Bearish · {{ticker}} · {{interval}}")

// ─────────────────────────────────────────────────────────────────────────────
// END — QDO v6.9
// ─────────────────────────────────────────────────────────────────────────────
