//@version=6
indicator(title='Quantum Dual Regression Channels [RSX + RSI]', overlay=true)

// =============================================================================
// 1. SETTINGS
// =============================================================================
grp_rsx = "Jurik RSX Settings (Macro)"
rsx_len = input.int(14, "RSX Length", group=grp_rsx)
rsx_ob  = input.int(70, "Overbought Level", group=grp_rsx)
rsx_os  = input.int(30, "Oversold Level", group=grp_rsx)
use_jma = input.bool(true, "Use JMA Pre-Smoothing?", group=grp_rsx)
jma_len = input.int(7, "JMA Length", group=grp_rsx)

grp_rsi  = "Adaptive RSI Settings (Micro)"
min_len  = input.int(7, "Min Length", group=grp_rsi)
max_len  = input.int(21, "Max Length", group=grp_rsi)
er_len   = input.int(10, "Efficiency Ratio Length", group=grp_rsi)
rsi_ob   = input.int(65, "Overbought Level", group=grp_rsi)
rsi_os   = input.int(35, "Oversold Level", group=grp_rsi)

grp_lr1 = "RSX Channel Visuals (Channel 1)"
lr1_len = input.int(200, "Channel Length", group=grp_lr1)
lr1_dev = input.float(2.0, "Deviation", group=grp_lr1)
c1_res  = input.color(#FF00FF, "Resistance (Fuchsia)", group=grp_lr1)
c1_sup  = input.color(#00FFFF, "Support (Cyan)", group=grp_lr1)
tr1     = input.int(90, "Fill Transparency", group=grp_lr1)

grp_lr2 = "RSI Channel Visuals (Channel 2)"
lr2_len = input.int(50, "Channel Length", group=grp_lr2)
lr2_dev = input.float(2.0, "Deviation", group=grp_lr2)
c2_res  = input.color(#FF5252, "Resistance (Red)", group=grp_lr2)
c2_sup  = input.color(#00E676, "Support (Green)", group=grp_lr2)
tr2     = input.int(90, "Fill Transparency", group=grp_lr2)

// =============================================================================
// 2. RSX + JMA MATH ENGINE
// =============================================================================
f_jma(src, length) =>
    phaseRatio = 1.5 // Fixed phase 50
    beta = 0.45 * (length - 1) / (0.45 * (length - 1) + 2)
    alpha = math.pow(beta, 2) // Fixed power 2
    var float e0 = 0.0, var float e1 = 0.0, var float e2 = 0.0, var float jma_val = 0.0
    e0 := (1 - alpha) * src + alpha * nz(e0[1])
    e1 := (src - e0) * (1 - beta) + beta * nz(e1[1])
    e2 := (e0 + phaseRatio * e1 - nz(jma_val[1])) * math.pow(1 - alpha, 2) + math.pow(alpha, 2) * nz(e2[1])
    jma_val := e2 + nz(jma_val[1])
    jma_val

f_rsx(src, length) =>
    float f8 = 100 * src, float v8 = f8 - nz(f8[1])
    float f18 = 3.0 / (length + 2.0), float f20 = 1.0 - f18
    var float f28 = 0.0, var float f30 = 0.0
    f28 := f20 * nz(f28[1]) + f18 * v8, f30 := f18 * f28 + f20 * nz(f30[1])
    float vC = f28 * 1.5 - f30 * 0.5
    var float f38 = 0.0, var float f40 = 0.0
    f38 := f20 * nz(f38[1]) + f18 * vC, f40 := f18 * f38 + f20 * nz(f40[1])
    float v10 = f38 * 1.5 - f40 * 0.5
    var float f48 = 0.0, var float f50 = 0.0
    f48 := f20 * nz(f48[1]) + f18 * v10, f50 := f18 * f48 + f20 * nz(f50[1])
    float v14 = f48 * 1.5 - f50 * 0.5
    var float f58 = 0.0, var float f60 = 0.0
    f58 := f20 * nz(f58[1]) + f18 * math.abs(v8), f60 := f18 * f58 + f20 * nz(f60[1])
    float v18 = f58 * 1.5 - f60 * 0.5
    var float f68 = 0.0, var float f70 = 0.0
    f68 := f20 * nz(f68[1]) + f18 * v18, f70 := f18 * f68 + f20 * nz(f70[1])
    float v1C = f68 * 1.5 - f70 * 0.5
    var float f78 = 0.0, var float f80 = 0.0
    f78 := f20 * nz(f78[1]) + f18 * v1C, f80 := f18 * f78 + f20 * nz(f80[1])
    float v20 = f78 * 1.5 - f80 * 0.5
    var float f88 = 0.0, var float f90 = 0.0
    f90 := nz(f90[1]) == 0 ? 1 : nz(f88[1]) <= nz(f90[1]) ? nz(f88[1]) + 1 : nz(f90[1]) + 1
    f88 := nz(f90[1]) == 0 and (length - 1 >= 5) ? length - 1 : 5
    float f0 = f88 >= f90 and f8 != nz(f8[1]) ? 1 : 0
    float f90_final = f88 == f90 and f0 == 0 ? 0 : f90
    float v4 = f88 < f90_final and v20 > 0 ? (v14 / v20 + 1) * 50 : 50
    v4 > 100 ? 100 : v4 < 0 ? 0 : v4

float target_src = use_jma ? f_jma(close, jma_len) : close
float rsx_val = f_rsx(target_src, rsx_len)

bool rsx_os_cross = ta.crossover(rsx_val, rsx_os)
bool rsx_ob_cross = ta.crossunder(rsx_val, rsx_ob)

// =============================================================================
// 3. ADAPTIVE RSI ENGINE
// =============================================================================
f_dyn_rma(src, len) =>
    var float rma = na
    float alpha = 1.0 / math.max(1.0, len)
    rma := na(rma[1]) ? src : alpha * src + (1.0 - alpha) * nz(rma[1])
    rma

f_dyn_rsi(src, len) =>
    float chg = ta.change(src)
    float up = math.max(chg, 0.0), float down = -math.min(chg, 0.0)
    float rs_up = f_dyn_rma(up, len), float rs_down = f_dyn_rma(down, len)
    rs_down == 0.0 ? 100.0 : rs_up == 0.0 ? 0.0 : 100.0 - (100.0 / (1.0 + rs_up / rs_down))

float er_dir = math.abs(close - nz(close[er_len]))
float er_vol = math.sum(math.abs(close - nz(close[1])), er_len)
float er = er_vol != 0 ? er_dir / er_vol : 0
float dyn_len = min_len + (max_len - min_len) * (1.0 - er)
float vrsi = f_dyn_rsi(close, dyn_len)

bool rsi_os_cross = ta.crossover(vrsi, rsi_os)
bool rsi_ob_cross = ta.crossunder(vrsi, rsi_ob)

// =============================================================================
// 4. SIGNAL PLOTTING
// =============================================================================
// RSX Signals (Triangles)
plotshape(rsx_ob_cross, title="RSX Overbought", style=shape.triangledown, location=location.abovebar, color=c1_res, size=size.small)
plotshape(rsx_os_cross, title="RSX Oversold", style=shape.triangleup, location=location.belowbar, color=c1_sup, size=size.small)

// RSI Signals (Crosses)
plotshape(rsi_ob_cross, title="RSI Overbought", style=shape.cross, location=location.abovebar, color=c2_res, size=size.small)
plotshape(rsi_os_cross, title="RSI Oversold", style=shape.cross, location=location.belowbar, color=c2_sup, size=size.small)

// =============================================================================
// 5. TRUE GEOMETRIC TREND CHANNELS (DUAL DRAWING)
// =============================================================================
var line l1_up = line.new(na, na, na, na, color=c1_res, width=2, extend=extend.none)
var line l1_dn = line.new(na, na, na, na, color=c1_sup, width=2, extend=extend.none)
var line l1_md = line.new(na, na, na, na, color=color.new(color.gray, 50), width=1, style=line.style_dashed, extend=extend.none)
var linefill lf1 = linefill.new(l1_up, l1_dn, color=color.new(color.blue, tr1))

var line l2_up = line.new(na, na, na, na, color=c2_res, width=2, extend=extend.none)
var line l2_dn = line.new(na, na, na, na, color=c2_sup, width=2, extend=extend.none)
var line l2_md = line.new(na, na, na, na, color=color.new(color.gray, 50), width=1, style=line.style_dotted, extend=extend.none)
var linefill lf2 = linefill.new(l2_up, l2_dn, color=color.new(color.blue, tr2))

// Reusable function to calculate and update channel coordinates
f_update_channel(len, dev, l_upper, l_lower, l_mid) =>
    float sumX = 0.0, float sumY = 0.0, float sumXY = 0.0, float sumXX = 0.0
    for i = 0 to len - 1
        float y = close[i]
        float x = i
        sumX += x, sumY += y, sumXY += x * y, sumXX += x * x
        
    float slope = (len * sumXY - sumX * sumY) / (len * sumXX - sumX * sumX)
    float intercept = (sumY - slope * sumX) / len
    float end_mid = intercept
    float start_mid = intercept + slope * (len - 1)
    
    float sum_sq = 0.0
    for i = 0 to len - 1
        float line_y = intercept + slope * i
        sum_sq += math.pow(close[i] - line_y, 2)
    float stdev = math.sqrt(sum_sq / len)
    
    int x1 = bar_index - (len - 1)
    int x2 = bar_index
    
    line.set_xy1(l_upper, x1, start_mid + stdev * dev)
    line.set_xy2(l_upper, x2, end_mid + stdev * dev)
    line.set_xy1(l_lower, x1, start_mid - stdev * dev)
    line.set_xy2(l_lower, x2, end_mid - stdev * dev)
    line.set_xy1(l_mid, x1, start_mid)
    line.set_xy2(l_mid, x2, end_mid)

if barstate.islast
    // Update RSX Channel (Macro)
    f_update_channel(lr1_len, lr1_dev, l1_up, l1_dn, l1_md)
    // Update RSI Channel (Micro)
    f_update_channel(lr2_len, lr2_dev, l2_up, l2_dn, l2_md)
