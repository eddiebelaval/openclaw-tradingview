// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("Composite Divergence Oscillator", shorttitle="CDO", overlay=false)

// --- Inputs ---
rsiLen    = input.int(14, "RSI Length", minval=1, group="RSI")
macdFast  = input.int(12, "MACD Fast", minval=1, group="MACD")
macdSlow  = input.int(26, "MACD Slow", minval=1, group="MACD")
macdSig   = input.int(9, "MACD Signal", minval=1, group="MACD")
momLen    = input.int(10, "Momentum Length", minval=1, group="Momentum")
mfiLen    = input.int(14, "MFI Length (Volume)", minval=1, group="Volume (MFI)")
normLen   = input.int(50, "Normalization Lookback", minval=1, tooltip="Lookback period to normalize MACD and Momentum to 0-100 range")

lbL = input.int(5, "Pivot Lookleft", minval=1, group="Divergence")
lbR = input.int(5, "Pivot Lookright", minval=1, group="Divergence")

// --- Calculations ---
// 1. RSI
rsiVal = ta.rsi(close, rsiLen)

// 2. MACD Histogram
[macdLine, signalLine, _] = ta.macd(close, macdFast, macdSlow, macdSig)
macdHist = macdLine - signalLine
// Normalize MACD Hist
float macdMin = ta.lowest(macdHist, normLen)
float macdMax = ta.highest(macdHist, normLen)
float normMacd = (macdHist - macdMin) / (macdMax - macdMin) * 100

// 3. Momentum
momVal = ta.mom(close, momLen)
// Normalize Momentum
float momMin = ta.lowest(momVal, normLen)
float momMax = ta.highest(momVal, normLen)
float normMom = (momVal - momMin) / (momMax - momMin) * 100

// 4. MFI (Volume component)
mfiVal = ta.mfi(close, mfiLen)

// Composite Oscillator (Average)
float composite = math.avg(rsiVal, normMacd, normMom, mfiVal)

// --- Divergence Logic ---
// Pivot Points
oscPH = ta.pivothigh(composite, lbL, lbR)
oscPL = ta.pivotlow(composite, lbL, lbR)

// Regular Bearish Divergence (Price HH, Osc LH)
bool regBear = false
if not na(oscPH)
    float prevPH = ta.valuewhen(not na(oscPH), composite[lbR], 1)
    float prevPriceH = ta.valuewhen(not na(oscPH), high[lbR], 1)
    if composite[lbR] < prevPH and high[lbR] > prevPriceH
        regBear := true

// Regular Bullish Divergence (Price LL, Osc HL)
bool regBull = false
if not na(oscPL)
    float prevPL = ta.valuewhen(not na(oscPL), composite[lbR], 1)
    float prevPriceL = ta.valuewhen(not na(oscPL), low[lbR], 1)
    if composite[lbR] > prevPL and low[lbR] < prevPriceL
        regBull := true

// Hidden Bearish Divergence (Price LH, Osc HH)
bool hidBear = false
if not na(oscPH)
    float prevPH = ta.valuewhen(not na(oscPH), composite[lbR], 1)
    float prevPriceH = ta.valuewhen(not na(oscPH), high[lbR], 1)
    if composite[lbR] > prevPH and high[lbR] < prevPriceH
        hidBear := true

// Hidden Bullish Divergence (Price HL, Osc LL)
bool hidBull = false
if not na(oscPL)
    float prevPL = ta.valuewhen(not na(oscPL), composite[lbR], 1)
    float prevPriceL = ta.valuewhen(not na(oscPL), low[lbR], 1)
    if composite[lbR] < prevPL and low[lbR] > prevPriceL
        hidBull := true

// --- Visualization ---
// Horizontal Levels
h80 = hline(80, "Overbought", color=color.new(#f23645, 50), linestyle=hline.style_dashed)
h50 = hline(50, "Center", color=color.new(chart.fg_color, 70), linestyle=hline.style_dotted)
h20 = hline(20, "Oversold", color=color.new(#089981, 50), linestyle=hline.style_dashed)

// Oscillator Plot with Gradient
oscColor = composite > 50 ? #089981 : #f23645
oscPlot = plot(composite, "Composite Oscillator", color=oscColor, linewidth=2)

// Fills
midPlot = plot(50, color=na, editable=false, display=display.none)
fill(oscPlot, midPlot, 50, composite, composite > 50 ? color.new(#089981, 50) : color.new(#f23645, 100), composite > 50 ? color.new(#089981, 100) : color.new(#f23645, 50))

// Divergence Labels
plotshape(regBull, "Reg Bull", shape.labelup, location.bottom, color.new(#089981, 0), text="R", textcolor=color.white, offset=-lbR, size=size.tiny)
plotshape(hidBull, "Hid Bull", shape.labelup, location.bottom, color.new(#089981, 0), text="H", textcolor=color.white, offset=-lbR, size=size.tiny)
plotshape(regBear, "Reg Bear", shape.labelup, location.top, color.new(#f23645, 0), text="R", textcolor=color.white, offset=-lbR, size=size.tiny)
plotshape(hidBear, "Hid Bear", shape.labelup, location.top, color.new(#f23645, 0), text="H", textcolor=color.white, offset=-lbR, size=size.tiny)
