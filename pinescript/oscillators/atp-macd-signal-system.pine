//@version=6
indicator("ATP MACD Signal System", overlay=false)

//---------------------------------------------------------
// PRESETS
//---------------------------------------------------------

preset = input.string(
     "Custom",
     "MACD Preset",
     options = [
        "Custom",
        "Scalping",
        "Day Trading",
        "Swing Trading",
        "Position Trading"
     ],
     group="Presets"
)

// Manual MACD settings

fastLenManual = input.int(12, "Fast Length", minval=1, group="MACD Settings")
slowLenManual = input.int(26, "Slow Length", minval=1, group="MACD Settings")
sigLenManual  = input.int(9,  "Signal Length", minval=1, group="MACD Settings")

// Preset logic

fastLenInput =
     preset == "Scalping" ? 5 :
     preset == "Day Trading" ? 8 :
     preset == "Swing Trading" ? 12 :
     preset == "Position Trading" ? 24 :
     fastLenManual

slowLenInput =
     preset == "Scalping" ? 13 :
     preset == "Day Trading" ? 21 :
     preset == "Swing Trading" ? 26 :
     preset == "Position Trading" ? 52 :
     slowLenManual

sigLenInput =
     preset == "Scalping" ? 3 :
     preset == "Day Trading" ? 5 :
     preset == "Swing Trading" ? 9 :
     preset == "Position Trading" ? 18 :
     sigLenManual

//---------------------------------------------------------
// INPUTS
//---------------------------------------------------------

sourceInput  = input.source(close, "Source")

oscTypeInput = input.string("EMA", "Oscillator MA Type", ["EMA","SMA"])
sigTypeInput = input.string("EMA", "Signal MA Type", ["EMA","SMA"])

showSignals      = input.bool(true, "Show Buy/Sell Signals")
showHistogram    = input.bool(true, "Show Histogram")
showSignalCount  = input.bool(true, "Show Signal Counter")
showBackground   = input.bool(true, "Show Momentum Background")

minBarsBetweenSignals = input.int(3, "Minimum Bars Between Signals")

tradeDirection = input.string(
     "Both (Long & Short)",
     "Trade Direction",
     options = [
        "Both (Long & Short)",
        "Long Only",
        "Short Only"
     ]
)

filterMode = input.string(
     "No Filter",
     "Signal Filter Mode",
     options = [
        "No Filter",
        "Trend Filter (Zero Confirmation)",
        "Reversal Filter (Zero Rejection)"
     ]
)

//---------------------------------------------------------
// MOVING AVERAGE FUNCTION
//---------------------------------------------------------

ma(source, length, maType) =>
    switch maType
        "EMA" => ta.ema(source, length)
        "SMA" => ta.sma(source, length)

//---------------------------------------------------------
// MACD CALCULATION
//---------------------------------------------------------

maFast = ma(sourceInput, fastLenInput, oscTypeInput)
maSlow = ma(sourceInput, slowLenInput, oscTypeInput)

macd   = maFast - maSlow
signal = ma(macd, sigLenInput, sigTypeInput)
hist   = macd - signal

//---------------------------------------------------------
// HISTOGRAM COLOR
//---------------------------------------------------------

histColor =
     hist >= 0 ?
     hist > hist[1] ? color.teal : color.new(color.teal,40) :
     hist > hist[1] ? color.new(color.red,40) : color.red

//---------------------------------------------------------
// MACD COLOR
//---------------------------------------------------------

macdColor = macd > signal ? color.green : color.red

//---------------------------------------------------------
// CROSS CONDITIONS
//---------------------------------------------------------

bullCross = ta.crossover(macd, signal)
bearCross = ta.crossunder(macd, signal)

//---------------------------------------------------------
// SIGNAL FILTER LOGIC
//---------------------------------------------------------

longCondition  = bullCross
shortCondition = bearCross

if filterMode == "Trend Filter (Zero Confirmation)"
    longCondition  := bullCross and macd > 0
    shortCondition := bearCross and macd < 0

if filterMode == "Reversal Filter (Zero Rejection)"
    longCondition  := bullCross and macd < 0
    shortCondition := bearCross and macd > 0

//---------------------------------------------------------
// TRADE DIRECTION FILTER
//---------------------------------------------------------

if tradeDirection == "Long Only"
    shortCondition := false

if tradeDirection == "Short Only"
    longCondition := false

//---------------------------------------------------------
// SIGNAL SPACING FILTER
//---------------------------------------------------------

var int lastSignalBar = na

validSignal = na(lastSignalBar) or bar_index - lastSignalBar > minBarsBetweenSignals

longSignal  = longCondition  and validSignal
shortSignal = shortCondition and validSignal

if longSignal or shortSignal
    lastSignalBar := bar_index

//---------------------------------------------------------
// MOMENTUM CONDITIONS
//---------------------------------------------------------

bullMomentum = ta.crossover(macd, 0)
bearMomentum = ta.crossunder(macd, 0)

//---------------------------------------------------------
// SIGNAL COUNTERS
//---------------------------------------------------------

var int buyCount = 0
var int sellCount = 0

if longSignal
    buyCount += 1

if shortSignal
    sellCount += 1

//---------------------------------------------------------
// BACKGROUND MOMENTUM
//---------------------------------------------------------

bgcolor(
     showBackground ?
     macd > signal ?
     color.new(color.green, 92) :
     color.new(color.red, 92)
     : na
)

//---------------------------------------------------------
// PLOTS
//---------------------------------------------------------

hline(0, "Zero Line", color.new(color.gray,40))

plot(showHistogram ? hist : na, "Histogram", histColor, style=plot.style_columns)

plot(macd, "MACD Line", macdColor, 2)
plot(signal, "Signal Line", color=color.orange)

//---------------------------------------------------------
// SIGNALS
//---------------------------------------------------------

plotshape(
     showSignals and longSignal,
     title="Buy Signal",
     style=shape.triangleup,
     location=location.bottom,
     color=color.green,
     size=size.small,
     force_overlay = true
)

plotshape(
     showSignals and shortSignal,
     title="Sell Signal",
     style=shape.triangledown,
     location=location.top,
     color=color.red,
     size=size.small,
     force_overlay = true
)

bgcolor(
    showSignals and longSignal ? 
    color.new(color.lime, 90) : na, 
    force_overlay = true, 
    editable = true
)

bgcolor(
    showSignals and shortSignal ? 
    color.new(color.red, 90) : na, 
    force_overlay = true, 
    editable = true
)

//---------------------------------------------------------
// SIGNAL COUNTER LABEL
//---------------------------------------------------------

if showSignalCount and barstate.islast
    label.new(
        bar_index,
        macd,
        "Buy Signals: " + str.tostring(buyCount) +
        "\nSell Signals: " + str.tostring(sellCount),
        style=label.style_label_left,
        textcolor=color.white,
        color=color.new(color.blue, 70)
    )

//---------------------------------------------------------
// ALERTS
//---------------------------------------------------------

alertcondition(longSignal, "MACD Buy Signal", "MACD Bullish Crossover")
alertcondition(shortSignal, "MACD Sell Signal", "MACD Bearish Crossover")

alertcondition(bullMomentum, "MACD Bullish Momentum", "MACD crossed above zero line")
alertcondition(bearMomentum, "MACD Bearish Momentum", "MACD crossed below zero line")

//End
