//@version=6
indicator("Moving Average Convergence Divergence", "MACD")

// Inputs
float  sourceInput  = input.source(close, "Source")
int    fastLenInput = input.int(12, "Fast length",   1)
int    slowLenInput = input.int(26, "Slow length",   1)
int    sigLenInput  = input.int(9,  "Signal length", 1)
string oscTypeInput = input.string("EMA", "Oscillator MA type", ["EMA", "SMA"], display = display.none)
string sigTypeInput = input.string("EMA", "Signal MA type",     ["EMA", "SMA"], display = display.none)

// Дополнительные входные параметры для EMA, используемых в сигнале
int    ema9LenInput   = input.int(9,   "EMA 9 length", 1)
int    ema20LenInput  = input.int(20,  "EMA 20 length", 1)
int    ema200LenInput = input.int(200, "EMA 200 length", 1)

// Толщина сигнальной линии
int    signalLineWidth = input.int(2, "Signal line width", minval=1, maxval=10)

// @function    Calculates an EMA or SMA of a `source` series.
ma(float source, int length, simple string maType) =>
    switch maType
        "EMA" => ta.ema(source, length)
        "SMA" => ta.sma(source, length)

// Calculate and plot the MACD, signal, and histogram values.
float maFast = ma(sourceInput, fastLenInput, oscTypeInput)
float maSlow = ma(sourceInput, slowLenInput, oscTypeInput)
float macd   = maFast - maSlow
float signal = ma(macd, sigLenInput, sigTypeInput)
float hist   = macd - signal
color hColor = hist >= 0 ? hist > hist[1] ? #26a69a : #b2dfdb : hist > hist[1] ? #ffcdd2 : #ff5252

hline(0, "Zero", #787b8680)
plot(hist, "Histogram", hColor, style = plot.style_columns)
plot(macd, "MACD")
plot(signal, "Signal line", #ff6d00)

// Create alert conditions.
alertcondition(hist[1] >= 0 and hist < 0, "Rising to falling", "MACD histogram switched from a rising to falling state")
alertcondition(hist[1] <= 0 and hist > 0, "Falling to rising", "MACD histogram switched from a falling to rising state")

// --- Расчёт дополнительных EMA ---
float ema9   = ta.ema(close, ema9LenInput)
float ema20  = ta.ema(close, ema20LenInput)
float ema200 = ta.ema(close, ema200LenInput)

// --- Глобальные переменные для пересечений (вычисляются на каждом баре) ---
bool ema9CrossOverEma20  = ta.crossover(ema9, ema20)
bool ema9CrossUnderEma20 = ta.crossunder(ema9, ema20)

// --- Условия для лонг-сигнала ---
bool longCondition = close > ema200
                     and ema9CrossOverEma20
                     and macd[1] < 0 and signal[1] < 0

// --- Условия для шорт-сигнала ---
bool shortCondition = close < ema200
                      and ema9CrossUnderEma20
                      and macd[1] > 0 and signal[1] > 0

// --- Определение диапазона для вертикальных линий (за последние 100 баров) ---
float lowestMACD  = ta.lowest(macd, 100)
float highestMACD = ta.highest(macd, 100)

// --- Управление линиями (автоудаление старых) ---
var line[] lines = array.new_line()

if longCondition or shortCondition
    // Создаём новую вертикальную линию с заданной толщиной
    newLine = line.new(
         bar_index, lowestMACD,
         bar_index, highestMACD,
         color = longCondition ? color.green : color.red,
         width = signalLineWidth
    )
    array.push(lines, newLine)

// Удаляем линии старше 200 баров
if array.size(lines) > 0
    int i = array.size(lines) - 1
    while i >= 0
        l = array.get(lines, i)
        if bar_index - line.get_x1(l) > 200
            line.delete(l)
            array.remove(lines, i)
        i := i - 1
