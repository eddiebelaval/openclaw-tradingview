indicator("Stochastic Alignment Trend", shorttitle="StochTrend", overlay=false)
//@version=6
// 
// STOCHASTIC ALIGNMENT TREND
//
// This indicator tracks 4 Stochastic %D values (Short, Med-Short, Med-Long, Long) 
// and identifies periods where all four are moving in the same direction.
//
// LOGIC:
// 1. Calculates 4 %D lines based on user-defined lengths.
// 2. Monitors the direction (slope) of all 4 lines + their average.
// 3. Highlights "Alignment" when all 5 directional vectors match.
// 4. Filters signals when the average is in Extreme Zones (default 80/20).
//
// VISUALS:
// - Thick Line: The Average of all 4 Stochastics, color-coded by direction.
// - 1px Lines: The 4 individual Stochastic components.
// - Background: Green/Red for alignment; Vivid Green/Red for extreme zones.
// - Triangles: Entry signals for new alignments (filtered by thresholds).



// --- Constants ---
const color BULL_COLOR = #089981
const color BEAR_COLOR = #f23645
const color NEUTRAL_COLOR = #5b9cf6
const float CENTER = 50.0

// --- Inputs ---
groupStoch1 = "Stochastic 1 (Short)"
len1    = input.int(9, "Length", minval=1, group=groupStoch1)
smoothD1 = input.int(3, "D Smoothing", minval=1, group=groupStoch1)

groupStoch2 = "Stochastic 2 (Medium-Short)"
len2    = input.int(14, "Length", minval=1, group=groupStoch2)
smoothD2 = input.int(3, "D Smoothing", minval=1, group=groupStoch2)

groupStoch3 = "Stochastic 3 (Medium-Long)"
len3    = input.int(40, "Length", minval=1, group=groupStoch3)
smoothD3 = input.int(4, "D Smoothing", minval=1, group=groupStoch3)

groupStoch4 = "Stochastic 4 (Long)"
len4    = input.int(60, "Length", minval=1, group=groupStoch4)
smoothD4 = input.int(10, "D Smoothing", minval=1, group=groupStoch4)

smoothK = input.int(3, "K Smoothing (Global)", minval=1, tooltip="Internal smoothing for the %K line before calculating %D")

groupThresholds = "Thresholds"
upperThreshold = input.int(80, "Upper Threshold", minval=50, maxval=100, group=groupThresholds)
lowerThreshold = input.int(20, "Lower Threshold", minval=0, maxval=50, group=groupThresholds)


// --- Functions ---
// Function to calculate %D
calcStochD(len, kSmooth, dSmooth) =>
    k = ta.sma(ta.stoch(close, high, low, len), kSmooth)
    d = ta.sma(k, dSmooth)
    d

// --- Logic ---
d1 = calcStochD(len1, smoothK, smoothD1)
d2 = calcStochD(len2, smoothK, smoothD2)
d3 = calcStochD(len3, smoothK, smoothD3)
d4 = calcStochD(len4, smoothK, smoothD4)

// Calculate individual directions
dir1 = d1 > d1[1] ? 1 : (d1 < d1[1] ? -1 : 0)
dir2 = d2 > d2[1] ? 1 : (d2 < d2[1] ? -1 : 0)
dir3 = d3 > d3[1] ? 1 : (d3 < d3[1] ? -1 : 0)
dir4 = d4 > d4[1] ? 1 : (d4 < d4[1] ? -1 : 0)

// Average of the four %D values
stochAvg = (d1 + d2 + d3 + d4) / 4

// Average direction
avgDir = stochAvg > stochAvg[1] ? 1 : (stochAvg < stochAvg[1] ? -1 : 0)

allAlignedUp   = dir1 == 1  and dir2 == 1  and dir3 == 1  and dir4 == 1  and avgDir == 1
allAlignedDown = dir1 == -1 and dir2 == -1 and dir3 == -1 and dir4 == -1 and avgDir == -1

// Condition: All 4 values in extreme zones
allAboveUpper = d1 > upperThreshold and d2 > upperThreshold and d3 > upperThreshold and d4 > upperThreshold
allBelowLower = d1 < lowerThreshold and d2 < lowerThreshold and d3 < lowerThreshold and d4 < lowerThreshold


// Dynamic Color based on direction
plotColor = avgDir == 1 ? BULL_COLOR : avgDir == -1 ? BEAR_COLOR : NEUTRAL_COLOR


// --- Visuals ---
// Horizontal levels
h0 = hline(upperThreshold, "Upper Level", color=color.new(chart.fg_color, 50), linestyle=hline.style_dashed)
h1 = hline(50, "Center Line", color=color.new(chart.fg_color, 20), linestyle=hline.style_dotted)
h2 = hline(lowerThreshold, "Lower Level", color=color.new(chart.fg_color, 50), linestyle=hline.style_dashed)

// Plot individual Stochastic values (1px)
plot(d1, "Stoch 1 (Short)", color=color.red, linewidth=1)
plot(d2, "Stoch 2 (Med-Short)", color=#ff00ff, linewidth=1) // Pink/Magenta
plot(d3, "Stoch 3 (Med-Long)", color=color.green, linewidth=1)
plot(d4, "Stoch 4 (Long)", color=color.blue, linewidth=1)

// Plot the average
pAvg = plot(stochAvg, "Stochastic Average", color=plotColor, linewidth=3)

pMid = plot(CENTER, "Center Anchor", display=display.none)

// Centered Oscillator Gradient Fill
fill(pAvg, pMid, 
     top_value    = math.max(CENTER, stochAvg), 
     bottom_value = math.min(CENTER, stochAvg), 
     top_color    = stochAvg > CENTER ? color.new(plotColor, 50) : color.new(chart.bg_color, 100), 
     bottom_color = stochAvg > CENTER ? color.new(chart.bg_color, 100) : color.new(plotColor, 50),
     title        = "Trend Fill")


// Highlight Alignment and Threshold Signals
// Extreme zones take priority in coloring
bgCol = allAboveUpper ? color.new(BEAR_COLOR, 70) : 
         allBelowLower ? color.new(BULL_COLOR, 70) : 
         allAlignedUp   ? color.new(BULL_COLOR, 85) : 
         allAlignedDown ? color.new(BEAR_COLOR, 85) : na

bgcolor(bgCol, title="Background Highlight")

// Plot shapes for entry/exit points based on alignment
// Only show signals if the average is within the normal trading range (not extreme zones)
showTriangleUp   = allAlignedUp   and not allAlignedUp[1]   and stochAvg >= lowerThreshold and stochAvg <= upperThreshold
showTriangleDown = allAlignedDown and not allAlignedDown[1] and stochAvg >= lowerThreshold and stochAvg <= upperThreshold

plotshape(showTriangleUp, "Bullish Alignment", shape.triangleup, location.bottom, BULL_COLOR, size=size.small)
plotshape(showTriangleDown, "Bearish Alignment", shape.triangledown, location.top, BEAR_COLOR, size=size.small)
