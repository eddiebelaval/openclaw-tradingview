//@version=6
indicator("Signal Goat Trend and Momentum Oscillator", shorttitle="Signal Goat Trend and Momentum Oscillator", overlay=false, max_labels_count=500)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupCore   = "Core Settings"
groupSignal = "Signal Settings"
groupStyle  = "Style"
groupMarks  = "Markers"

src             = input.source(close, "Source", group=groupCore)
fastLen         = input.int(9, "Fast Momentum Length", minval=1, group=groupCore)
slowLen         = input.int(21, "Slow Momentum Length", minval=2, group=groupCore)
trendLen        = input.int(50, "Trend EMA Length", minval=1, group=groupCore)
volumeLen       = input.int(20, "Volume Smoothing Length", minval=1, group=groupCore)
normLen         = input.int(100, "Normalization Lookback", minval=20, group=groupCore)

signalLen       = input.int(7, "Signal Line Length", minval=1, group=groupSignal)
obLevel         = input.float(60.0, "Overbought Level", step=0.1, group=groupSignal)
osLevel         = input.float(-60.0, "Oversold Level", step=0.1, group=groupSignal)

showHistogram   = input.bool(true, "Show Histogram", group=groupStyle)
showSignalLine  = input.bool(true, "Show Signal Line", group=groupStyle)
showMarkers     = input.bool(true, "Show Buy/Sell Markers", group=groupMarks)
requireZeroConf = input.bool(true, "Require Zero-Line Confirmation", group=groupMarks)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// HELPER FUNCTIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_clamp(val, minv, maxv) =>
    math.max(minv, math.min(maxv, val))

f_normalize(series, len) =>
    hi = ta.highest(series, len)
    lo = ta.lowest(series, len)
    rng = hi - lo
    rng == 0 ? 0 : ((series - lo) / rng) * 200 - 100

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// COMPONENTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// 1) Momentum component
fastEma = ta.ema(src, fastLen)
slowEma = ta.ema(src, slowLen)
rawMomentum = fastEma - slowEma
momentumNorm = f_normalize(rawMomentum, normLen)

// 2) Trend bias component
trendEma = ta.ema(src, trendLen)
trendDelta = src - trendEma
trendNorm = f_normalize(trendDelta, normLen)

// 3) Volume pressure component
spread = high - low
safeSpread = spread == 0 ? syminfo.mintick : spread
closePosInBar = ((close - low) / safeSpread) * 2 - 1
volPressureRaw = closePosInBar * volume
volPressureSmooth = ta.ema(volPressureRaw, volumeLen)
volNorm = f_normalize(volPressureSmooth, normLen)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SIGNAL GOAT OSCILLATOR
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
rawOsc = (momentumNorm * 0.45) + (trendNorm * 0.35) + (volNorm * 0.20)
sgOsc  = ta.ema(rawOsc, 3)
signal = ta.ema(sgOsc, signalLen)
hist   = sgOsc - signal

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CONDITIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bullCross = ta.crossover(sgOsc, signal)
bearCross = ta.crossunder(sgOsc, signal)

buySignal  = requireZeroConf ? (bullCross and sgOsc < 0) : bullCross
sellSignal = requireZeroConf ? (bearCross and sgOsc > 0) : bearCross

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PLOTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
hline(0, "Zero Line", color=color.new(color.gray, 40))
hline(obLevel, "Overbought", color=color.new(color.red, 30))
hline(osLevel, "Oversold", color=color.new(color.lime, 30))

bgcolor(sgOsc > obLevel ? color.new(color.red, 92) : sgOsc < osLevel ? color.new(color.green, 92) : na)

histColor = hist >= 0 ? (hist > hist[1] ? color.lime : color.green) : (hist < hist[1] ? color.red : color.maroon)
plot(showHistogram ? hist : na, title="Histogram", style=plot.style_columns, color=histColor, linewidth=2)

plot(sgOsc, title="Signal Goat Oscillator", color=color.white, linewidth=3)
plot(showSignalLine ? signal : na, title="Signal Line", color=color.orange, linewidth=2)

// Buy / Sell markers
plotshape(showMarkers and buySignal,  title="Buy Signal",  style=shape.triangleup,   location=location.bottom, color=color.lime, size=size.small, text="BUY")
plotshape(showMarkers and sellSignal, title="Sell Signal", style=shape.triangledown, location=location.top,    color=color.red,  size=size.small, text="SELL")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ALERTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
alertcondition(buySignal, "Signal Goat Buy", "Signal Goat Oscillator Buy Signal")
alertcondition(sellSignal, "Signal Goat Sell", "Signal Goat Oscillator Sell Signal")
alertcondition(ta.crossover(sgOsc, 0), "Signal Goat Crossed Above Zero", "Signal Goat Oscillator crossed above zero")
alertcondition(ta.crossunder(sgOsc, 0), "Signal Goat Crossed Below Zero", "Signal Goat Oscillator crossed below zero")
