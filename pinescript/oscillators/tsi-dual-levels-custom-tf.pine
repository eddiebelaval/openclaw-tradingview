//@version=6
// @author LEGOLAS
indicator("TSI Dual Levels - Custom TF", shorttitle="TSI_Dual", format=format.price, precision=4, timeframe="", timeframe_gaps=true)

// --- Timeframe Settings ---
tfInput = input.timeframe("", "Custom Timeframe", group="Timeframe")

// --- TSI Settings ---
longLen  = input.int(25, "Long Length",   minval=1, group="TSI Settings")
shortLen = input.int(13, "Short Length",  minval=1, group="TSI Settings")
sigLen   = input.int(13, "Signal Length", minval=1, group="TSI Settings")

// --- Level Settings ---
ob2 = input.int(50,  "Overbought Level 2 (Extreme)", group="Levels")
ob1 = input.int(25,  "Overbought Level 1",           group="Levels")
os1 = input.int(-25, "Oversold Level 1",             group="Levels")
os2 = input.int(-50, "Oversold Level 2 (Extreme)",   group="Levels")

// --- Color Settings ---
colorUp1   = input.color(color.new(color.green, 0),  "Strong Up   (≥1pt)", group="TSI Colors")
colorUp2   = input.color(color.new(color.lime,  0),  "Weak Up     (<1pt)", group="TSI Colors")
colorDown1 = input.color(color.new(color.red,   0),  "Strong Down (≥1pt)", group="TSI Colors")
colorDown2 = input.color(color.new(color.orange,0),  "Weak Down   (<1pt)", group="TSI Colors")

// --- TSI Calculation ---
double_smooth(src, long, short) =>
    ta.ema(ta.ema(src, long), short)

pc        = ta.change(close)
base_tsi  = 100 * (double_smooth(pc, longLen, shortLen) / double_smooth(math.abs(pc), longLen, shortLen))
base_sig  = ta.ema(base_tsi, sigLen)

[tsi_value, signal_line] = request.security(syminfo.tickerid, tfInput, [base_tsi, base_sig], gaps=barmerge.gaps_off)

// --- Direction Logic ---
var bool tsiUp = true

if tsi_value - tsi_value[1] >= 1
    tsiUp := true
else if tsi_value[1] - tsi_value >= 1
    tsiUp := false

smallMoveUp   = (tsi_value - tsi_value[1]) > 0 and (tsi_value - tsi_value[1]) < 1
smallMoveDown = (tsi_value[1] - tsi_value) > 0 and (tsi_value[1] - tsi_value) < 1

tsiColor = smallMoveUp ? colorUp2 : smallMoveDown ? colorDown2 : tsiUp ? colorUp1 : colorDown1

// --- Levels ---
h_ob2 = hline(ob2, "OB Level 2", color=color.new(color.red,   20), linewidth=1)
h_ob1 = hline(ob1, "OB Level 1", color=color.new(color.red,   60), linestyle=hline.style_dotted)
hline(0,   "Zero Line",  color=color.gray,                          linestyle=hline.style_solid)
h_os1 = hline(os1, "OS Level 1", color=color.new(color.green, 60), linestyle=hline.style_dotted)
h_os2 = hline(os2, "OS Level 2", color=color.new(color.green, 20), linewidth=1)

// --- Zone Fills ---
fill(h_ob1, h_os1, color=color.new(color.purple, 95), title="Neutral Zone Fill")
fill(h_ob2, h_ob1, color=color.new(color.red,    90), title="OB Warning Fill")
fill(h_os2, h_os1, color=color.new(color.green,  90), title="OS Warning Fill")

// --- Plots ---
plot(tsi_value,   "TSI Line",    color=tsiColor,           linewidth=2)
plot(signal_line, "Signal Line", color=color.new(#E91E63, 0), linewidth=1)
