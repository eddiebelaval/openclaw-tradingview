//@version=5
indicator("RSI MTF", overlay=false)

// Parâmetros
length = input.int(14, title="Período do RSI")

// RSI de diferentes tempos gráficos
rsi_60  = request.security(syminfo.tickerid, "60", ta.rsi(close, length))
rsi_240 = request.security(syminfo.tickerid, "240", ta.rsi(close, length))
rsi_1D  = request.security(syminfo.tickerid, "D", ta.rsi(close, length))

// Plot dos RSI
plot(rsi_60,  title="RSI 60m",  color=color.blue,  linewidth=2)
plot(rsi_240, title="RSI 240m", color=color.orange, linewidth=2)
plot(rsi_1D,  title="RSI 1D",   color=color.red, linewidth=2)

// Linhas de sobrecompra e sobrevenda
hline(70, "Sobrecompra", color=color.red)
hline(30, "Sobrevenda", color=color.green)
hline(50, "Linha média", color=color.gray)
