//@version=6
indicator(title = 'Aethix 3 [Market Cipher G Ultimate]', shorttitle = 'Aethix 3', overlay = false, format = format.price, precision = 2, max_lines_count = 500, max_labels_count = 500)

// --- Aethix 3 Aesthetic Defaults ---
TEAL = #00ffd5
PINK = #ff006f
GOLD = #ffeb3b
CYAN = #00e6ff
PURP = #ab47bc
GRAY = #b2b5be

// --- Inputs ---

// CORE ENGINE SETTINGS
wtGrp = 'Core Engine - WaveTrend'
wtChLen = input.int(9, 'WT Channel Length', minval=1, group = wtGrp)
wtAvgLen = input.int(12, 'WT Average Length', minval=1, group = wtGrp)
wtMALen  = input.int(3, 'WT MA Length', minval=1, group = wtGrp)
wtMASrc  = input.source(hlc3, 'WT MA Source', group = wtGrp)

mfiGrp = 'Core Engine - Money Flow'
mfiShow = input.bool(true, 'Show Money Flow', group = mfiGrp)
mfiLen  = input.int(60, 'MFI Period', minval=1, group = mfiGrp)
mfiMult = input.float(150.0, 'MFI Area Multiplier', group = mfiGrp)
mfiPosY = input.float(0.0, 'MFI Vertical Shift', group = mfiGrp, tooltip = "Adjust this to move the MFI wave up or down.")

rsiGrp = 'Core Engine - RSI'
rsiShow   = input.bool(true, 'Show RSI Line', group = rsiGrp)
rsiLen    = input.int(14, 'RSI Length', group = rsiGrp)
rsiOB     = input.int(60, 'RSI Overbought Level', group = rsiGrp)
rsiOS     = input.int(30, 'RSI Oversold Level', group = rsiGrp)
rsiOffset = input.float(25.0, 'RSI Vertical Offset', group = rsiGrp, tooltip = "Shifts the RSI line upwards to clear the zero line (VMC Style).")

divGrp = 'Core Engine - Divergences'
showDivLines   = input.bool(true, 'Draw Divergence Lines on Waves', group = divGrp)
showDivSymbols = input.bool(true, 'Mark Divergences with Symbols', group = divGrp)
divLookback    = input.int(5, 'Pivot Lookback', minval=1, maxval=10, group = divGrp)

// AETHIX 3 VISUALS & CUSTOMIZATION
vGrp = 'Aethix 3 - Visual Customization'
bullThemeColor = input.color(TEAL, 'Bullish Theme Color', group = vGrp)
bearThemeColor = input.color(PINK, 'Bearish Theme Color', group = vGrp)
wt1Color       = input.color(CYAN, 'Wave 1 (Fast) Color', group = vGrp)
wt2Color       = input.color(GRAY, 'Wave 2 (Slow) Color', group = vGrp)
vwapColorInput = input.color(GOLD, 'VWAP Color', group = vGrp)
rsiBaseColor   = input.color(CYAN, 'RSI Base Color', group = vGrp)

mfiOpacity  = input.int(50, 'Money Flow Opacity', minval=0, maxval=100, group = vGrp)
wtOpacity   = input.int(30, 'Wave Area Opacity', minval=0, maxval=100, group = vGrp)
vwapOpacity = input.int(60, 'VWAP Area Opacity', minval=0, maxval=100, group = vGrp)
lineWeight  = input.int(3, 'Primary Line Weight', minval=1, maxval=5, group = vGrp)

// --- Functions ---

f_wavetrend(src, chlen, avg, malen) =>
    esa = ta.ema(src, chlen)
    de = ta.ema(math.abs(src - esa), chlen)
    ci = (src - esa) / (0.015 * de)
    wt1 = ta.ema(ci, avg)
    wt2 = ta.sma(wt1, malen)
    [wt1, wt2]

f_rsimfi(len, mult, yPos) =>
    ta.sma(((close - open) / (high - low)) * mult, len) + yPos

// --- Calculations ---

// 1. Oscillators
[wt1, wt2] = f_wavetrend(wtMASrc, wtChLen, wtAvgLen, wtMALen)
wtVwap = wt1 - wt2
rsiVal = ta.rsi(close, rsiLen)
// Offset RSI upwards to match the top pane logic where it stays in the upper region
finalRSI = rsiVal + rsiOffset 
mfiValue = f_rsimfi(mfiLen, mfiMult, mfiPosY)

// 2. Signals
wtCrossUp = ta.crossover(wt1, wt2)
wtCrossDn = ta.crossunder(wt1, wt2)

// 3. Divergence Detection
pHi = ta.pivothigh(wt2, divLookback, divLookback)
pLo = ta.pivotlow(wt2, divLookback, divLookback)

var float lastPHValue = na
var float lastPHPrice = na
var int lastPHIndex = na
var float lastPLValue = na
var float lastPLPrice = na
var int lastPLIndex = na

bool wtBear = false
bool wtBull = false

if not na(pHi)
    wtBear := high[divLookback] > lastPHPrice and pHi < lastPHValue
    if wtBear and showDivLines
        line.new(lastPHIndex, lastPHValue, bar_index[divLookback], pHi, color=color.new(bearThemeColor, 20), width=2)
    lastPHValue := pHi, lastPHPrice := high[divLookback], lastPHIndex := bar_index[divLookback]

if not na(pLo)
    wtBull := low[divLookback] < lastPLPrice and pLo > lastPLValue
    if wtBull and showDivLines
        line.new(lastPLIndex, lastPLValue, bar_index[divLookback], pLo, color=color.new(bullThemeColor, 20), width=2)
    lastPLValue := pLo, lastPLPrice := low[divLookback], lastPLIndex := bar_index[divLookback]

// --- Visual Rendering ---

// Pane Reference Lines
zLine = plot(0, 'Main Zero', color=color.new(chart.fg_color, 80), linewidth=1)
hline(rsiOB + rsiOffset, 'RSI OB Ref', color=color.new(bearThemeColor, 80), linestyle=hline.style_dotted)
hline(rsiOS + rsiOffset, 'RSI OS Ref', color=color.new(bullThemeColor, 80), linestyle=hline.style_dotted)

// LAYER 1: Large & Clear Money Flow (High Intensity)
mfiPlot = plot(mfiShow ? mfiValue : na, 'MFI Wave', color=color.new(mfiValue > 0 ? bullThemeColor : bearThemeColor, 100), linewidth=1)
fill(mfiPlot, zLine, 
     top_value = math.max(0, mfiValue), 
     bottom_value = math.min(0, mfiValue), 
     top_color = mfiValue > 0 ? color.new(bullThemeColor, 100 - mfiOpacity) : color.new(bearThemeColor, 100), 
     bottom_color = mfiValue > 0 ? color.new(bullThemeColor, 100) : color.new(bearThemeColor, 100 - mfiOpacity), 
     title = 'Money Flow Density')

// LAYER 2: WaveTrend Slowly (Background)
plot(wt2, 'Slow Wave Area', color=color.new(wt2Color, 100 - wtOpacity), style=plot.style_area)

// LAYER 3: VWAP Bold Action
plot(wtVwap, 'VWAP Pulse', color=color.new(vwapColorInput, 100 - vwapOpacity), style=plot.style_area, linewidth=2)

// LAYER 4: High Visibility Lines (WT Fast & Offset RSI)
plot(wt1, 'Fast WT Line', color=wt1Color, linewidth=lineWeight)
rsiDynamicColor = rsiVal >= rsiOB ? bearThemeColor : rsiVal <= rsiOS ? bullThemeColor : rsiBaseColor
plot(rsiShow ? finalRSI : na, 'Offset RSI Line', color=rsiDynamicColor, linewidth=lineWeight)

// Signal Markers (Synced with Waves)
plotshape(wtCrossUp ? wt2 : na, 'Bull Pulse Circle', shape.circle, location.absolute, color=bullThemeColor, size=size.tiny)
plotshape(wtCrossDn ? wt2 : na, 'Bear Pulse Circle', shape.circle, location.absolute, color=bearThemeColor, size=size.tiny)

// Edge Warning Dots (+/- 110 for clarity)
plotshape(wtCrossUp and wt2 < -60 ? -110 : na, 'Extreme Buy Dot', shape.circle, location.absolute, color=bullThemeColor, size=size.small)
plotshape(wtCrossDn and wt2 > 60 ? 110 : na, 'Extreme Sell Dot', shape.circle, location.absolute, color=bearThemeColor, size=size.small)

// Divergence Pane Symbols
plotshape(showDivSymbols and wtBull ? -100 : na, 'Bull Div Symbol', shape.triangleup, location.absolute, color=bullThemeColor, size=size.tiny, offset=-divLookback)
plotshape(showDivSymbols and wtBear ? 100 : na, 'Bear Div Symbol', shape.triangledown, location.absolute, color=bearThemeColor, size=size.tiny, offset=-divLookback)

// Status RSM Bar
rsmT = plot(-115, display=display.none)
rsmB = plot(-120, display=display.none)
fill(rsmT, rsmB, color = wt1 > wt2 ? color.new(bullThemeColor, 30) : color.new(bearThemeColor, 30), title='RSM Bar')
