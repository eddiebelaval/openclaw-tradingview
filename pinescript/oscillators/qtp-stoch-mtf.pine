// ═══════════════════════════════════════════════════════════════════════════
//
//  QTP - Stoch MTF
//  ────────────────
//  Multi-timeframe Stochastic oscillator with dual-stoch overlay,
//  configurable overbought/oversold levels, and B/S signal detection.
//
//  Features:
//  • Main Stochastic with custom timeframe support
//  • Optional 2nd Stochastic on a separate timeframe
//  • Strict cross signals (K past OB/OS level + crosses D)
//  • Any cross signals (simple K/D crossover)
//  • Background highlights and B/S character labels
//  • Configurable upper/lower/mid levels with fill
//
// ═══════════════════════════════════════════════════════════════════════════

//@version=6
indicator("QTP - Stoch MTF", shorttitle="QTP StchMTF", overlay=false)

// ─────────────────────────────────────────────────────────────────────────
//  MAIN STOCHASTIC SETTINGS
// ─────────────────────────────────────────────────────────────────────────
len      = input.int(14,  "Length",  minval=1, group="Main Stochastic")
smoothK  = input.int(3,   "Smooth K", minval=1, group="Main Stochastic")
smoothD  = input.int(3,   "Smooth D", minval=1, group="Main Stochastic")

upLine   = input.int(80,  "Upper Line", minval=50, maxval=90, group="Levels")
lowLine  = input.int(20,  "Lower Line", minval=10, maxval=50, group="Levels")
sml      = input.bool(true, "Show Mid Line?", group="Levels")

// ─────────────────────────────────────────────────────────────────────────
//  TIMEFRAME SETTINGS
// ─────────────────────────────────────────────────────────────────────────
useCurrentRes = input.bool(true,  "Use Current Chart Timeframe?", group="Main Timeframe")
resCustom     = input.timeframe("60", "Custom Timeframe", group="Main Timeframe")

// ─────────────────────────────────────────────────────────────────────────
//  2ND STOCHASTIC SETTINGS
// ─────────────────────────────────────────────────────────────────────────
ssStoch       = input.bool(false, "Show 2nd Stochastic?", group="2nd Stochastic")
useCurrentRes2 = input.bool(false, "Use Current Chart Timeframe?", group="2nd Stochastic")
resCustom2    = input.timeframe("D", "Custom Timeframe", group="2nd Stochastic")
len2          = input.int(14,  "Length",  minval=1, group="2nd Stochastic")
smoothK2      = input.int(3,   "Smooth K", minval=1, group="2nd Stochastic")
smoothD2      = input.int(3,   "Smooth D", minval=1, group="2nd Stochastic")

// ─────────────────────────────────────────────────────────────────────────
//  DISPLAY OPTIONS
// ─────────────────────────────────────────────────────────────────────────
sbh  = input.bool(false, "BG Highlight: Stoch Above/Below Lines?",                group="Display")
sch  = input.bool(true,  "BG Highlight: Strict Cross (K past line + crosses D)?", group="Display")
sl   = input.bool(true,  "Show B/S Labels: Strict Cross?",                        group="Display")
sac  = input.bool(false, "BG Highlight: Any K/D Cross?",                          group="Display")
sacl = input.bool(false, "Show B/S Labels: Any K/D Cross?",                       group="Display")

// ─────────────────────────────────────────────────────────────────────────
//  RESOLUTION
// ─────────────────────────────────────────────────────────────────────────
res  = useCurrentRes  ? timeframe.period : resCustom
res2 = useCurrentRes2 ? timeframe.period : resCustom2

// ─────────────────────────────────────────────────────────────────────────
//  MAIN STOCHASTIC CALCULATION
// ─────────────────────────────────────────────────────────────────────────
k = ta.sma(ta.stoch(close, high, low, len), smoothK)
d = ta.sma(k, smoothD)

outK = request.security(syminfo.tickerid, res, k)
outD = request.security(syminfo.tickerid, res, d)

// ─────────────────────────────────────────────────────────────────────────
//  2ND STOCHASTIC CALCULATION
// ─────────────────────────────────────────────────────────────────────────
k2 = ta.sma(ta.stoch(close, high, low, len2), smoothK2)
d2 = ta.sma(k2, smoothD2)

outK2 = request.security(syminfo.tickerid, res2, k2)
outD2 = request.security(syminfo.tickerid, res2, d2)

// ─────────────────────────────────────────────────────────────────────────
//  CROSS DEFINITIONS — STRICT (K past level + crosses D)
// ─────────────────────────────────────────────────────────────────────────
aboveLine = outK > upLine
belowLine = outK < lowLine

crossUp = (outK[1] < outD[1] and outK[1] < lowLine) and (outK > outD)
crossDn = (outK[1] > outD[1] and outK[1] > upLine) and (outK < outD)

// ─────────────────────────────────────────────────────────────────────────
//  CROSS DEFINITIONS — ANY K/D CROSS
// ─────────────────────────────────────────────────────────────────────────
crossUpAll   = outK[1] < outD[1] and outK > outD
crossDownAll = outK[1] > outD[1] and outK < outD

// ─────────────────────────────────────────────────────────────────────────
//  COLORS
// ─────────────────────────────────────────────────────────────────────────
col_bull      = color.new(#00E676, 0)    // bright green
col_bear      = color.new(#FF1744, 0)    // bright red
col_bull_bg   = color.new(#00E676, 70)   // green background (faded)
col_bear_bg   = color.new(#FF1744, 70)   // red background (faded)
col_bull_cross = color.new(#00E676, 40)  // green cross highlight
col_bear_cross = color.new(#FF1744, 40)  // red cross highlight
col_k2        = color.new(#FF9800, 0)    // orange (2nd K)
col_d2        = color.new(#FFEB3B, 0)    // yellow (2nd D)
col_mid       = color.new(#9E9E9E, 0)    // gray mid line
col_fill      = color.new(#B0BEC5, 70)   // silver fill between levels

// ─────────────────────────────────────────────────────────────────────────
//  BACKGROUND HIGHLIGHTS
// ─────────────────────────────────────────────────────────────────────────
// Above/below zone highlights
bgcolor(sbh and aboveLine ? col_bear_bg : na)
bgcolor(sbh and belowLine ? col_bull_bg : na)

// Strict cross highlights
bgcolor(sch and crossUp ? col_bull_cross : na)
bgcolor(sch and crossDn ? col_bear_cross : na)

// Any cross highlights
bgcolor(sac and crossUpAll ? col_bull_cross : na)
bgcolor(sac and crossDownAll ? col_bear_cross : na)

// ─────────────────────────────────────────────────────────────────────────
//  PLOTS — MAIN STOCHASTIC
// ─────────────────────────────────────────────────────────────────────────
plot(outK, "Stoch K", color=col_bull, linewidth=2)
plot(outD, "Stoch D", color=col_bear, linewidth=2)

// ─────────────────────────────────────────────────────────────────────────
//  PLOTS — 2ND STOCHASTIC
// ─────────────────────────────────────────────────────────────────────────
plot(ssStoch ? outK2 : na, "2nd Stoch K", color=col_k2, linewidth=2)
plot(ssStoch ? outD2 : na, "2nd Stoch D", color=col_d2, linewidth=2)

// ─────────────────────────────────────────────────────────────────────────
//  PLOTS — LEVELS
// ─────────────────────────────────────────────────────────────────────────
p1 = plot(upLine,  "Upper Line", color=col_bear, linewidth=2)
p2 = plot(lowLine, "Lower Line", color=col_bull, linewidth=2)
plot(sml ? 50 : na, "Mid Line", color=col_mid, linewidth=1, style=plot.style_cross)
fill(p1, p2, color=col_fill)

// ─────────────────────────────────────────────────────────────────────────
//  SIGNAL ARROWS — STRICT CROSS (on main chart)
// ─────────────────────────────────────────────────────────────────────────
plotshape(sl and crossUp, "Buy (Strict)",  style=shape.triangleup,   location=location.belowbar, color=col_bull, size=size.small, force_overlay=true)
plotshape(sl and crossDn, "Sell (Strict)", style=shape.triangledown, location=location.abovebar, color=col_bear, size=size.small, force_overlay=true)

// ─────────────────────────────────────────────────────────────────────────
//  SIGNAL ARROWS — ANY CROSS (on main chart)
// ─────────────────────────────────────────────────────────────────────────
plotshape(sacl and crossUpAll,   "Buy (Any Cross)",  style=shape.triangleup,   location=location.belowbar, color=col_bull, size=size.small, force_overlay=true)
plotshape(sacl and crossDownAll, "Sell (Any Cross)", style=shape.triangledown, location=location.abovebar, color=col_bear, size=size.small, force_overlay=true)
