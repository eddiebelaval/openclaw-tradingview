//@version=6
indicator("Pro Composite Analyzer", overlay=false, max_bars_back=5000, scale=scale.right)


// ╔══════════════════════════════════════════════════════════════╗
// ║  UTILITY FUNCTIONS                                           ║
// ╚══════════════════════════════════════════════════════════════╝

f_ema(series float src, simple int len) => ta.ema(src, len)

f_dema(series float src, simple int len) =>
    float e = ta.ema(src, len)
    2.0 * e - ta.ema(e, len)

f_tema(series float src, simple int len) =>
    float e1 = ta.ema(src, len)
    float e2 = ta.ema(e1, len)
    3.0 * (e1 - e2) + e2 - ta.ema(e2, len)

f_filter(series float src, simple int len, simple string style) =>
    switch style
        "DEMA" => f_dema(src, len)
        "TEMA" => f_tema(src, len)
        "WMA"  => ta.wma(src, len)
        "SMA"  => ta.sma(src, len)
        =>        f_ema(src, len)

// Zone-based normalization → [-1..+1]
f_norm(series float v, simple float up, simple float lo) =>
    float mid  = (up + lo) * 0.5
    float half = math.max(math.abs(up - lo) * 0.5, 1e-6)
    math.max(-1.0, math.min(1.0, (v - mid) / half))

// Table cell color by zone threshold
f_zCol(float v, float up, float lo) =>
    v >= up ? color.new(#00BCD4, 0) : v <= lo ? color.new(#FF6D00, 0) : color.gray

// Color for pre-normalised [-1..+1] value in table
f_nc(float v) =>
    v >  0.3 ? color.new(#00BCD4, 0) : v < -0.3 ? color.new(#FF6D00, 0) : color.gray

// Format normalised value as percent string for table
f_np(float v) => str.tostring(math.round(v * 100, 0))

// Composite color: gradient by strength (original cyan/orange)
f_compColor(float comp, float strength) =>
    if comp >= 0.0
        color.from_gradient(strength, 0.0, 1.0, color.new(#00BCD4, 60), color.new(#00BCD4, 0))
    else
        color.from_gradient(strength, 0.0, 1.0, color.new(#FF6D00, 60), color.new(#FF6D00, 0))

// ╔══════════════════════════════════════════════════════════════╗
// ║  OSCILLATOR FUNCTIONS  (all security-safe — no var arrays)   ║
// ╚══════════════════════════════════════════════════════════════╝

// ── VZO: Volume Zone Oscillator → approx [-100..+100]
f_vzo(simple int length) =>
    float dir  = close > close[3] ? volume : -volume
    float vzoV = ta.linreg(dir, length, 0)
    float totV = ta.linreg(volume, length, 0)
    math.max(-120.0, math.min(120.0, 100.0 * vzoV / math.max(totV, 1e-6)))

// ── CTO: 33-MA cluster score → [-100..+100]
f_cto(simple int sp, simple string fl, simple int ps) =>
    float s   = close
    float c01 = f_filter(s,  1*sp,fl), float c02 = f_filter(s,  2*sp,fl)
    float c03 = f_filter(s,  3*sp,fl), float c04 = f_filter(s,  4*sp,fl)
    float c05 = f_filter(s,  5*sp,fl), float c06 = f_filter(s,  6*sp,fl)
    float c07 = f_filter(s,  7*sp,fl), float c08 = f_filter(s,  8*sp,fl)
    float c09 = f_filter(s,  9*sp,fl), float c10 = f_filter(s, 10*sp,fl)
    float c11 = f_filter(s, 11*sp,fl), float c12 = f_filter(s, 12*sp,fl)
    float c13 = f_filter(s, 13*sp,fl), float c14 = f_filter(s, 14*sp,fl)
    float c15 = f_filter(s, 15*sp,fl), float c16 = f_filter(s, 16*sp,fl)
    float c17 = f_filter(s, 17*sp,fl), float c18 = f_filter(s, 18*sp,fl)
    float c19 = f_filter(s, 19*sp,fl), float c20 = f_filter(s, 20*sp,fl)
    float c21 = f_filter(s, 21*sp,fl), float c22 = f_filter(s, 22*sp,fl)
    float c23 = f_filter(s, 23*sp,fl), float c24 = f_filter(s, 24*sp,fl)
    float c25 = f_filter(s, 25*sp,fl), float c26 = f_filter(s, 26*sp,fl)
    float c27 = f_filter(s, 27*sp,fl), float c28 = f_filter(s, 28*sp,fl)
    float c29 = f_filter(s, 29*sp,fl), float c30 = f_filter(s, 30*sp,fl)
    float c31 = f_filter(s, 31*sp,fl), float c32 = f_filter(s, 32*sp,fl)
    float c33 = f_filter(s, 33*sp,fl)
    int sc =
         (s>c01?1:-1)+(c01>c02?1:-1)+(c02>c03?1:-1)+(c03>c04?1:-1)+(c04>c05?1:-1)+
         (c05>c06?1:-1)+(c06>c07?1:-1)+(c07>c08?1:-1)+(c08>c09?1:-1)+(c09>c10?1:-1)+
         (c10>c11?1:-1)+(c11>c12?1:-1)+(c12>c13?1:-1)+(c13>c14?1:-1)+(c14>c15?1:-1)+
         (c15>c16?1:-1)+(c16>c17?1:-1)+(c17>c18?1:-1)+(c18>c19?1:-1)+(c19>c20?1:-1)+
         (c20>c21?1:-1)+(c21>c22?1:-1)+(c22>c23?1:-1)+(c23>c24?1:-1)+(c24>c25?1:-1)+
         (c25>c26?1:-1)+(c26>c27?1:-1)+(c27>c28?1:-1)+(c28>c29?1:-1)+(c29>c30?1:-1)+
         (c30>c31?1:-1)+(c31>c32?1:-1)+(c32>c33?1:-1)
    float raw = float(sc) / 33.0 * 100.0
    ps > 1 ? ta.ema(raw, ps) : raw

// ── DMI histogram: DI+ minus DI− → approx [-50..+50]
f_dmi_osc(simple int len, simple bool doSmooth, simple int smLen) =>
    float hiD  = high - high[1]
    float loD  = low[1] - low
    float pDM  = hiD > loD and hiD > 0 ? hiD : 0.0
    float mDM  = loD > hiD and loD > 0 ? loD : 0.0
    float tr   = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
    float atrV = ta.rma(tr, len)
    float diP  = 100.0 * ta.rma(pDM, len) / math.max(atrV, 1e-6)
    float diM  = 100.0 * ta.rma(mDM, len) / math.max(atrV, 1e-6)
    float h    = diP - diM
    doSmooth ? ta.ema(h, smLen) : h

// ── Aroon Zero-Lag → approx [-100..+100]
f_aroon(simple int len, simple int sm) =>
    float aD  = 100.0 * (ta.lowestbars(low,  len + 1) + len) / len
    float aU  = 100.0 * (ta.highestbars(high, len + 1) + len) / len
    float raw = aU - aD
    float e1  = ta.ema(raw, sm)
    float e2  = ta.ema(e1,  sm)
    e1 + (e1 - e2)

// ── Sell/Buy Rate → unbounded, normalised via rolling max externally
f_sbr(simple int prd) =>
    float tw    = high - math.max(open, close)
    float bw    = math.min(open, close) - low
    float body  = math.abs(close - open)
    float denom = math.max(tw + bw + body, 1e-10)
    float vup   = volume * (0.5 * (tw + bw + (open <= close ? 2.0 * body : 0.0)) / denom)
    float vdn   = volume * (0.5 * (tw + bw + (open >= close ? 2.0 * body : 0.0)) / denom)
    ta.linreg(vup - vdn, prd, 0)

// ── Supertrend direction → +1.0 (bull) / -1.0 (bear)
f_st(simple float factor, simple int aLen) =>
    [_, d] = ta.supertrend(factor, aLen)
    d < 0 ? 1.0 : -1.0

// ── ADX: normalised relative to midpoint threshold → [-1..+1]
f_adx_norm(simple int dLen, simple int aLen, simple float midVal) =>
    [_, _, adxVal] = ta.dmi(dLen, aLen)
    math.max(-1.0, math.min(1.0, (adxVal - midVal) / math.max(midVal, 1e-6)))

// ── RSI centred: (RSI − 50) / 50 → [-1..+1]
f_rsi_norm(simple int len) =>
    (ta.rsi(close, len) - 50.0) / 50.0

// ── MACD histogram normalised via rolling absolute max → [-1..+1]
f_macd_norm(simple int fast, simple int slow, simple int sig, simple int normLen) =>
    [_, _, h] = ta.macd(close, fast, slow, sig)
    float mx  = ta.highest(math.abs(h), normLen)
    math.max(-1.0, math.min(1.0, h / math.max(mx, 1e-10)))

// ── Stochastic RSI %K centred: (%K − 50) / 50 → [-1..+1]
f_stochrsi_norm(simple int rsiLen, simple int stLen, simple int kSmooth) =>
    float r  = ta.rsi(close, rsiLen)
    float lo = ta.lowest(r,  stLen)
    float hi = ta.highest(r, stLen)
    float k  = 100.0 * (r - lo) / math.max(hi - lo, 1e-6)
    float ks = ta.sma(k, kSmooth)
    (ks - 50.0) / 50.0

// ── CCI normalised via rolling absolute max → [-1..+1]
f_cci_norm(simple int len, simple int normLen) =>
    float c  = ta.cci(hlc3, len)
    float mx = ta.highest(math.abs(c), normLen)
    math.max(-1.0, math.min(1.0, c / math.max(mx, 1e-10)))

