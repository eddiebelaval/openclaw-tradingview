// ╔══════════════════════════════════════════════════════════════╗
// ║  SECURITY CALLS — ORIGINAL OSCILLATORS                      ║
// ╚══════════════════════════════════════════════════════════════╝

// VZO
float _v1r = request.security(syminfo.tickerid, tf1, f_vzo(vzoL), barmerge.gaps_off, barmerge.lookahead_off)
float _v2r = request.security(syminfo.tickerid, tf2, f_vzo(vzoL), barmerge.gaps_off, barmerge.lookahead_off)
float _v3r = request.security(syminfo.tickerid, tf3, f_vzo(vzoL), barmerge.gaps_off, barmerge.lookahead_off)
float vzo1 = vzoOn ? nz(vzoSm ? ta.ema(_v1r, vzoNl) : _v1r) : 0.0
float vzo2 = vzoOn ? nz(vzoSm ? ta.ema(_v2r, vzoNl) : _v2r) : 0.0
float vzo3 = vzoOn ? nz(vzoSm ? ta.ema(_v3r, vzoNl) : _v3r) : 0.0

// CTO
float _c1r = request.security(syminfo.tickerid, tf1, f_cto(ctoSp,ctoFl,ctoPs), barmerge.gaps_off, barmerge.lookahead_off)
float _c2r = request.security(syminfo.tickerid, tf2, f_cto(ctoSp,ctoFl,ctoPs), barmerge.gaps_off, barmerge.lookahead_off)
float _c3r = request.security(syminfo.tickerid, tf3, f_cto(ctoSp,ctoFl,ctoPs), barmerge.gaps_off, barmerge.lookahead_off)
float cto1 = ctoOn ? nz(_c1r) : 0.0
float cto2 = ctoOn ? nz(_c2r) : 0.0
float cto3 = ctoOn ? nz(_c3r) : 0.0

// DMI oscillator
float _d1r = request.security(syminfo.tickerid, tf1, f_dmi_osc(dmiL,dmiSm,dmiSL), barmerge.gaps_off, barmerge.lookahead_off)
float _d2r = request.security(syminfo.tickerid, tf2, f_dmi_osc(dmiL,dmiSm,dmiSL), barmerge.gaps_off, barmerge.lookahead_off)
float _d3r = request.security(syminfo.tickerid, tf3, f_dmi_osc(dmiL,dmiSm,dmiSL), barmerge.gaps_off, barmerge.lookahead_off)
float dmi1 = dmiOn ? nz(_d1r) : 0.0
float dmi2 = dmiOn ? nz(_d2r) : 0.0
float dmi3 = dmiOn ? nz(_d3r) : 0.0

// Aroon
float _a1r  = request.security(syminfo.tickerid, tf1, f_aroon(arnL,arnSm), barmerge.gaps_off, barmerge.lookahead_off)
float _a2r  = request.security(syminfo.tickerid, tf2, f_aroon(arnL,arnSm), barmerge.gaps_off, barmerge.lookahead_off)
float _a3r  = request.security(syminfo.tickerid, tf3, f_aroon(arnL,arnSm), barmerge.gaps_off, barmerge.lookahead_off)
float arn1    = arnOn ? nz(_a1r) : 0.0
float arn2    = arnOn ? nz(_a2r) : 0.0
float arn3    = arnOn ? nz(_a3r) : 0.0
float arnSig1 = ta.ema(arn1, arnSg)

// SBR (using sbrPrd=50 to match screenshot default)
float _s1r  = f_sbr(sbrPrd)
float _s2r  = request.security(syminfo.tickerid, tf2, f_sbr(sbrPrd), barmerge.gaps_off, barmerge.lookahead_off)
float _s3r  = request.security(syminfo.tickerid, tf3, f_sbr(sbrPrd), barmerge.gaps_off, barmerge.lookahead_off)
float sbrR1 = nz(_s1r)
float sbrN1 = sbrOn ? math.max(-1.0, math.min(1.0, _s1r / math.max(ta.highest(math.abs(_s1r), 200), 1e-6))) : 0.0
float sbrN2 = sbrOn ? math.max(-1.0, math.min(1.0, _s2r / math.max(ta.highest(math.abs(_s2r), 200), 1e-6))) : 0.0
float sbrN3 = sbrOn ? math.max(-1.0, math.min(1.0, _s3r / math.max(ta.highest(math.abs(_s3r), 200), 1e-6))) : 0.0

// ╔══════════════════════════════════════════════════════════════╗
// ║  SECURITY CALLS — SMC-DERIVED OSCILLATORS                   ║
// ╚══════════════════════════════════════════════════════════════╝

// Supertrend direction
float _st1 = request.security(syminfo.tickerid, tf1, f_st(stFac,stAL), barmerge.gaps_off, barmerge.lookahead_off)
float _st2 = request.security(syminfo.tickerid, tf2, f_st(stFac,stAL), barmerge.gaps_off, barmerge.lookahead_off)
float _st3 = request.security(syminfo.tickerid, tf3, f_st(stFac,stAL), barmerge.gaps_off, barmerge.lookahead_off)
float st1  = stOn ? nz(_st1) : 0.0
float st2  = stOn ? nz(_st2) : 0.0
float st3  = stOn ? nz(_st3) : 0.0

// ADX normalised
float _adx1 = request.security(syminfo.tickerid, tf1, f_adx_norm(adxDL,adxAL,adxMid), barmerge.gaps_off, barmerge.lookahead_off)
float _adx2 = request.security(syminfo.tickerid, tf2, f_adx_norm(adxDL,adxAL,adxMid), barmerge.gaps_off, barmerge.lookahead_off)
float _adx3 = request.security(syminfo.tickerid, tf3, f_adx_norm(adxDL,adxAL,adxMid), barmerge.gaps_off, barmerge.lookahead_off)
float adxN1 = adxOn ? nz(_adx1) : 0.0
float adxN2 = adxOn ? nz(_adx2) : 0.0
float adxN3 = adxOn ? nz(_adx3) : 0.0

// RSI centred
float _rsi1 = request.security(syminfo.tickerid, tf1, f_rsi_norm(rsiL), barmerge.gaps_off, barmerge.lookahead_off)
float _rsi2 = request.security(syminfo.tickerid, tf2, f_rsi_norm(rsiL), barmerge.gaps_off, barmerge.lookahead_off)
float _rsi3 = request.security(syminfo.tickerid, tf3, f_rsi_norm(rsiL), barmerge.gaps_off, barmerge.lookahead_off)
float rsiN1 = rsiOn ? nz(_rsi1) : 0.0
float rsiN2 = rsiOn ? nz(_rsi2) : 0.0
float rsiN3 = rsiOn ? nz(_rsi3) : 0.0

// ╔══════════════════════════════════════════════════════════════╗
// ║  SECURITY CALLS — NEW OSCILLATORS                            ║
// ╚══════════════════════════════════════════════════════════════╝

// MACD histogram normalised
float _m1   = request.security(syminfo.tickerid, tf1, f_macd_norm(macdF,macdS,macdSig,macdNL), barmerge.gaps_off, barmerge.lookahead_off)
float _m2   = request.security(syminfo.tickerid, tf2, f_macd_norm(macdF,macdS,macdSig,macdNL), barmerge.gaps_off, barmerge.lookahead_off)
float _m3   = request.security(syminfo.tickerid, tf3, f_macd_norm(macdF,macdS,macdSig,macdNL), barmerge.gaps_off, barmerge.lookahead_off)
float macd1 = macdOn ? nz(_m1) : 0.0
float macd2 = macdOn ? nz(_m2) : 0.0
float macd3 = macdOn ? nz(_m3) : 0.0

// Stochastic RSI
float _sr1  = request.security(syminfo.tickerid, tf1, f_stochrsi_norm(srsiRL,srsiSL,srsiK), barmerge.gaps_off, barmerge.lookahead_off)
float _sr2  = request.security(syminfo.tickerid, tf2, f_stochrsi_norm(srsiRL,srsiSL,srsiK), barmerge.gaps_off, barmerge.lookahead_off)
float _sr3  = request.security(syminfo.tickerid, tf3, f_stochrsi_norm(srsiRL,srsiSL,srsiK), barmerge.gaps_off, barmerge.lookahead_off)
float srsiR1 = srsiOn ? nz(_sr1) : 0.0
float srsiR2 = srsiOn ? nz(_sr2) : 0.0
float srsiR3 = srsiOn ? nz(_sr3) : 0.0

// CCI
float _cci1 = request.security(syminfo.tickerid, tf1, f_cci_norm(cciL,cciNL), barmerge.gaps_off, barmerge.lookahead_off)
float _cci2 = request.security(syminfo.tickerid, tf2, f_cci_norm(cciL,cciNL), barmerge.gaps_off, barmerge.lookahead_off)
float _cci3 = request.security(syminfo.tickerid, tf3, f_cci_norm(cciL,cciNL), barmerge.gaps_off, barmerge.lookahead_off)
float cci1  = cciOn ? nz(_cci1) : 0.0
float cci2  = cciOn ? nz(_cci2) : 0.0
float cci3  = cciOn ? nz(_cci3) : 0.0

// ╔══════════════════════════════════════════════════════════════╗
// ║  NORMALIZATION → [-1..+1]                                    ║
// ╚══════════════════════════════════════════════════════════════╝

float nV1 = vzoOn ? f_norm(vzo1, vzoUp, vzoLo) : 0.0
float nV2 = vzoOn ? f_norm(vzo2, vzoUp, vzoLo) : 0.0
float nV3 = vzoOn ? f_norm(vzo3, vzoUp, vzoLo) : 0.0
float nC1 = ctoOn ? f_norm(cto1, ctoUp, ctoLo) : 0.0
float nC2 = ctoOn ? f_norm(cto2, ctoUp, ctoLo) : 0.0
float nC3 = ctoOn ? f_norm(cto3, ctoUp, ctoLo) : 0.0
float nD1 = dmiOn ? f_norm(dmi1, dmiUp, dmiLo) : 0.0
float nD2 = dmiOn ? f_norm(dmi2, dmiUp, dmiLo) : 0.0
float nD3 = dmiOn ? f_norm(dmi3, dmiUp, dmiLo) : 0.0
float nA1 = arnOn ? f_norm(arn1, arnUp, arnLo) : 0.0
float nA2 = arnOn ? f_norm(arn2, arnUp, arnLo) : 0.0
float nA3 = arnOn ? f_norm(arn3, arnUp, arnLo) : 0.0

// StochRSI: convert back to 0-100 scale then apply zone normalisation
float nSR1 = srsiOn ? f_norm(srsiR1 * 50.0 + 50.0, srsiUp, srsiLo) : 0.0
float nSR2 = srsiOn ? f_norm(srsiR2 * 50.0 + 50.0, srsiUp, srsiLo) : 0.0
float nSR3 = srsiOn ? f_norm(srsiR3 * 50.0 + 50.0, srsiUp, srsiLo) : 0.0

// ╔══════════════════════════════════════════════════════════════╗
// ║  MARKET REGIME                                               ║
// ╚══════════════════════════════════════════════════════════════╝

float smaF    = ta.sma(close, 20)
float smaS    = ta.sma(close, 50)
float tDiff   = math.abs(smaF - smaS) / math.max(smaS, 1e-6)
bool  isTrend = tDiff > 0.003
float flatK   = isTrend ? 1.0 : 0.6

// ╔══════════════════════════════════════════════════════════════╗
// ║  ADAPTIVE WEIGHTS                                            ║
// ╚══════════════════════════════════════════════════════════════╝

float wV   = vzoOn  ? vzoW  * flatK : 0.0
float wC   = ctoOn  ? ctoW  * flatK : 0.0
float wD   = dmiOn  ? dmiW  * flatK : 0.0
float wST  = stOn   ? stW   * flatK : 0.0
float wADX = adxOn  ? adxW  * flatK : 0.0
float wMCD = macdOn ? macdW * flatK : 0.0
float wA   = arnOn  ? arnW  : 0.0
float wS   = sbrOn  ? sbrWei : 0.0
float wR   = rsiOn  ? rsiW  : 0.0
float wSR  = srsiOn ? srsiW : 0.0
float wCC  = cciOn  ? cciW  : 0.0

float wT = math.max(wV + wC + wD + wA + wS + wST + wADX + wR + wMCD + wSR + wCC, 1e-6)

// ╔══════════════════════════════════════════════════════════════╗
// ║  COMPOSITE SCORE PER TIMEFRAME                               ║
// ╚══════════════════════════════════════════════════════════════╝

float score1 = (nV1*wV   + nC1*wC   + nD1*wD   + nA1*wA  + sbrN1*wS +
                st1*wST  + adxN1*wADX + rsiN1*wR +
                macd1*wMCD + nSR1*wSR + cci1*wCC) / wT

float score2 = (nV2*wV   + nC2*wC   + nD2*wD   + nA2*wA  + sbrN2*wS +
                st2*wST  + adxN2*wADX + rsiN2*wR +
                macd2*wMCD + nSR2*wSR + cci2*wCC) / wT

float score3 = (nV3*wV   + nC3*wC   + nD3*wD   + nA3*wA  + sbrN3*wS +
                st3*wST  + adxN3*wADX + rsiN3*wR +
                macd3*wMCD + nSR3*wSR + cci3*wCC) / wT

float composite = score1 * 0.25 + score2 * 0.35 + score3 * 0.40
float strength  = math.abs(composite)
float compPct   = composite * 100.0

// ── Regime change marker (crossing zero)
bool crossedUp   = ta.crossover(composite,  0.0)
bool crossedDown = ta.crossunder(composite, 0.0)

// ╔══════════════════════════════════════════════════════════════╗
// ║  SBR VISUAL BANDS                                            ║
// ╚══════════════════════════════════════════════════════════════╝

float buyEdge  = showSBR and sbrOn and sbrR1 >= 0 ? -100.0 + sbrN1 * sbrScl : na
float selEdge  = showSBR and sbrOn and sbrR1 <  0 ?  100.0 + sbrN1 * sbrScl : na
bool  sbrRise  = ta.rising(sbrR1,  5)
bool  sbrFall  = ta.falling(sbrR1, 5)
color buyCol   = sbrRise ? sbrBuyR : sbrBuyF
color selCol   = sbrFall ? sbrSelR : sbrSelF

// ╔══════════════════════════════════════════════════════════════╗
// ║  LINE COLORS — Hierarchy & Gamification                      ║
// ║  1. Composite = thick, bright, full saturation by strength   ║
// ║  2. TF scores = thinner, semi-transparent                    ║
// ║  3. DMI/Aroon = dimmed, auxiliary                            ║
// ╚══════════════════════════════════════════════════════════════╝

// Composite: gamified strength gradient (weak=light, strong=saturated)
color compCol = f_compColor(composite, strength)

// TF scores: original cyan/orange, semi-transparent (secondary)
color s1col = score1 >= 0.0 ? color.new(#00C853, 30) : color.new(#FF1744, 30)
color s2col = score2 >= 0.0 ? color.new(#00BCD4, 55) : color.new(#FF6D00, 55)
color s3col = score3 >= 0.0 ? color.new(#00BCD4, 70) : color.new(#FF6D00, 70)

// DMI: dim auxiliary, original cyan/orange
color dmiCol = dmi1 >= 0.0
     ? color.from_gradient(math.abs(dmi1), 0.0, 50.0, color.new(#00BCD4, 75), color.new(#00BCD4, 15))
     : color.from_gradient(math.abs(dmi1), 0.0, 50.0, color.new(#FF6D00, 75), color.new(#FF6D00, 15))

// ╔══════════════════════════════════════════════════════════════╗
// ║  PLOTS                                                       ║
// ╚══════════════════════════════════════════════════════════════╝

float _s1   = math.max(-100.0, math.min(100.0, score1 * 100))
float _s2   = math.max(-100.0, math.min(100.0, score2 * 100))
float _s3   = math.max(-100.0, math.min(100.0, score3 * 100))
float _comp = math.max(-100.0, math.min(100.0, compPct))
float _dmi  = dmiOn ? math.max(-100.0, math.min(100.0, dmi1 * 0.5)) : na
// Aroon Signal: thinner, dimmed auxiliary line (disabled by default in Style)
float _arn  = arnOn ? math.max(-100.0, math.min(100.0, arnSig1)) : na

// ── Secondary TF scores (thin, semi-transparent)
plot(_s3, "Score TF3", color=s3col, linewidth=1)
plot(_s2, "Score TF2", color=s2col, linewidth=1)
plot(_s1, "Score TF1", color=s1col, linewidth=2)

// ── Main Composite line (thick, primary, gamified color)
p_comp = plot(_comp, "Composite", color=compCol, linewidth=3)

// ── Zero line (prominent, well-visible)
p_zero = plot(0.0, "Zero Line", color=color.new(chart.fg_color, 35), linewidth=2)

// ── DMI histogram (auxiliary, dimmed)
plot(_dmi, "DMI Histo", style=plot.style_columns, color=dmiCol, linewidth=1)

// ── Aroon Signal (disabled by default — toggle in Style tab)
plot(_arn, "Aroon Signal",
     color=bar_index % 2 == 0 ? color.new(chart.fg_color, 70) : na,
     linewidth=1,
     display=display.none)

// ── Composite fill (gamified: green above zero, orange/red below)
fill(p_comp, p_zero,   0, -100, na,                    color.new(#FF6D00, 88))
fill(p_comp, p_zero, 100,    0, color.new(#00BCD4, 88), na)

// ── OB / OS lines and fills
p_ob     = plot(math.min( obLvl,  100.0), "OB",     color=obLC, linewidth=2)
p_os     = plot(math.max( osLvl, -100.0), "OS",     color=osLC, linewidth=2)
p_top    = plot( 100.0, "Top",    color=color.new(color.white, 100))
p_bottom = plot(-100.0, "Bottom", color=color.new(color.white, 100))
fill(p_ob, p_top,    color.new(obLC, obAlpha), title="OB Fill")
fill(p_os, p_bottom, color.new(osLC, osAlpha), title="OS Fill")

// ── Zero hline (dotted, always visible under fills)
hline(0, "Zero", color=color.new(color.gray, 40), linestyle=hline.style_solid, linewidth=1)

// ── Soft trend zone fills (new: bullish zone above tzBull, bearish zone below -tzBear)
float _tzBullLvl = showTZ ?  tzBull : na
float _tzBearLvl = showTZ ? -tzBear : na
p_tzBull = plot(_tzBullLvl, "Bullish Zone", color=na)
p_tzBear = plot(_tzBearLvl, "Bearish Zone", color=na)
p_tzTop  = plot(showTZ ?  100.0 : na, "TZ Top",    color=na)
p_tzBot  = plot(showTZ ? -100.0 : na, "TZ Bottom", color=na)
fill(p_tzBull, p_tzTop, color.new(#00BCD4, 95), title="Bullish Zone Fill")
fill(p_tzBear, p_tzBot, color.new(#FF6D00, 95), title="Bearish Zone Fill")

// ── SBR bands
float _buyEdge = showSBR and sbrOn ? math.max(-100.0, math.min(100.0, buyEdge)) : na
float _selEdge = showSBR and sbrOn ? math.max(-100.0, math.min(100.0, selEdge)) : na
p_buyE = plot(_buyEdge,                         "Buy Edge", color=na)
p_buyB = plot(showSBR and sbrOn ? -100.0 : na,  "Buy Base", color=na)
p_selE = plot(_selEdge,                         "Sel Edge", color=na)
p_selB = plot(showSBR and sbrOn ?  100.0 : na,  "Sel Base", color=na)
fill(p_buyE, p_buyB, buyCol, title="Buy Fill")
fill(p_selE, p_selB, selCol, title="Sell Fill")

// ── Regime change markers (circles at zero on composite crossover)
plot(crossedUp   ? 0.0 : na, "Regime Bull", style=plot.style_circles,
     color=color.new(#00BCD4, 0), linewidth=5)
plot(crossedDown ? 0.0 : na, "Regime Bear", style=plot.style_circles,
     color=color.new(#FF6D00, 0), linewidth=5)

// ╔══════════════════════════════════════════════════════════════╗
// ║  BACKGROUND + BARCOLOR                                       ║
// ╚══════════════════════════════════════════════════════════════╝

// Very delicate panel background — barely visible, won't compete with chart
color bgPanel = na
if showBg
    bgPanel := composite > 0.0
         ? color.from_gradient(strength, 0.0, 1.0, color.new(#00BCD4, 97), color.new(#00BCD4, 88))
         : composite < 0.0
         ? color.from_gradient(strength, 0.0, 1.0, color.new(#FF6D00, 97), color.new(#FF6D00, 88))
         : color.new(#607D8B, 97)
bgcolor(bgPanel, title="Panel BG")

// Barcolor: gamified — strength controls saturation (weak→light, strong→saturated)
color barOut = na
if showBC
    if composite > 0.0
        barOut := color.from_gradient(strength, 0.0, 1.0, bcBW, bcBF)
    else if composite < 0.0
        barOut := color.from_gradient(strength, 0.0, 1.0, bcBeW, bcBeF)
    else
        barOut := bcN
barcolor(barOut, title="Bar Color")

// Market Mode overlay — same heatmap logic as Panel BG, applied to main chart
color bgOverlay = composite > 0.0
     ? color.from_gradient(strength, 0.0, 1.0, color.new(#00BCD4, 97), color.new(#00BCD4, 88))
     : composite < 0.0
     ? color.from_gradient(strength, 0.0, 1.0, color.new(#FF6D00, 97), color.new(#FF6D00, 88))
     : color.new(#607D8B, 97)
bgcolor(bgOverlay, title="Market Mode", force_overlay=true)

// ── Helper: score cell background for Score row (global scope)
f_scoreBg(float v) =>
    float av = math.abs(v)
    color res = av > 70 ? (v > 0 ? color.new(#00BCD4, 70) : color.new(#FF6D00, 70)) : av > 40 ? (v > 0 ? color.new(#00BCD4, 82) : color.new(#FF6D00, 82)) : color.new(color.black, 80)
    res

// ╔══════════════════════════════════════════════════════════════╗
// ║  STATUS TABLE — Split into Core + Auxiliary blocks           ║
// ║  Core:  Label | Composite | TF1 | TF2 | TF3 | ST | ADX     ║
// ║  Aux:   VZO | CTO | DMI | SBR | RSI | MACD | StRSI | CCI   ║
// ╚══════════════════════════════════════════════════════════════╝
// Layout: 9 cols × 7 rows
// Cols: Label | Comp | TF1 | TF2 | TF3 | ST | ADX | RSI | SBR
// Rows: Header(core) | Values(core) | Header(aux) | TF1(aux) | TF2(aux) | TF3(aux) | SBR

var table tbl = table.new(position.top_right, 9, 7,
     bgcolor=color.new(color.black, 60), border_width=1,
     border_color=color.new(color.gray, 75))

if barstate.islast and showTbl

    // Header colors
    color hCore = color.new(#B0BEC5, 0)   // gray-blue for section headers
    color hAux  = color.new(#78909C, 20)  // dimmer for aux section

    // ── Row 0: Core signals header
    table.cell(tbl, 0, 0, "CORE",    text_color=hCore, text_size=size.tiny, bgcolor=color.new(#263238,60))
    table.cell(tbl, 1, 0, "COMP",    text_color=hCore, text_size=size.tiny, bgcolor=color.new(#263238,60))
    table.cell(tbl, 2, 0, tf1,       text_color=hCore, text_size=size.tiny, bgcolor=color.new(#263238,60))
    table.cell(tbl, 3, 0, tf2,       text_color=hCore, text_size=size.tiny, bgcolor=color.new(#263238,60))
    table.cell(tbl, 4, 0, tf3,       text_color=hCore, text_size=size.tiny, bgcolor=color.new(#263238,60))
    table.cell(tbl, 5, 0, "ST",      text_color=hCore, text_size=size.tiny, bgcolor=color.new(#263238,60))
    table.cell(tbl, 6, 0, "ADX",     text_color=hCore, text_size=size.tiny, bgcolor=color.new(#263238,60))
    table.cell(tbl, 7, 0, "RSI",     text_color=hCore, text_size=size.tiny, bgcolor=color.new(#263238,60))
    table.cell(tbl, 8, 0, "SBR",     text_color=hCore, text_size=size.tiny, bgcolor=color.new(#263238,60))

    // ── Row 1: Core values + Score row with strength highlight
    color  cC     = compPct > 5.0 ? color.new(#00BCD4,0) : compPct < -5.0 ? color.new(#FF6D00,0) : color.gray
    string cZ     = compPct >= obLvl ? "OB ▲" : compPct <= osLvl ? "OS ▼" : (compPct > 0 ? "▲" : compPct < 0 ? "▼" : "→")
    string compStr= str.tostring(math.round(compPct, 1))
    color  cBg    = f_scoreBg(compPct)

    color  s1c    = score1 > 0.05 ? color.new(#00BCD4,0) : score1 < -0.05 ? color.new(#FF6D00,0) : color.gray
    color  s2c    = score2 > 0.05 ? color.new(#00BCD4,0) : score2 < -0.05 ? color.new(#FF6D00,0) : color.gray
    color  s3c    = score3 > 0.05 ? color.new(#00BCD4,0) : score3 < -0.05 ? color.new(#FF6D00,0) : color.gray

    // Mode label in first col
    string modeStr = isTrend ? "▶ TREND" : "─ FLAT"
    color  modeC   = isTrend ? color.new(#00BCD4,0) : color.new(#607D8B,0)

    table.cell(tbl, 0, 1, modeStr,                                  text_color=modeC,   text_size=size.tiny)
    table.cell(tbl, 1, 1, compStr + " " + cZ,                       text_color=cC,      text_size=size.tiny, bgcolor=cBg)
    table.cell(tbl, 2, 1, str.tostring(math.round(score1*100, 1)),  text_color=s1c,     text_size=size.tiny, bgcolor=f_scoreBg(score1*100))
    table.cell(tbl, 3, 1, str.tostring(math.round(score2*100, 1)),  text_color=s2c,     text_size=size.tiny, bgcolor=f_scoreBg(score2*100))
    table.cell(tbl, 4, 1, str.tostring(math.round(score3*100, 1)),  text_color=s3c,     text_size=size.tiny, bgcolor=f_scoreBg(score3*100))
    table.cell(tbl, 5, 1, stOn   ? (st1 > 0 ? "▲" : "▼") : "—",   text_color=st1>0?color.new(#00BCD4,0):color.new(#FF6D00,0), text_size=size.tiny)
    table.cell(tbl, 6, 1, adxOn  ? f_np(adxN1) : "—",              text_color=f_nc(adxN1),  text_size=size.tiny)
    table.cell(tbl, 7, 1, rsiOn  ? f_np(rsiN1) : "—",              text_color=f_nc(rsiN1),  text_size=size.tiny)
    string sbrStr = sbrOn ? (sbrR1 > 0 ? "↑ " : "↓ ") + str.tostring(math.round(sbrN1*100, 0)) : "—"
    color  sbrC   = sbrOn ? (sbrR1 > 0 ? color.new(#00E676, 0) : color.new(#FF1744, 0)) : color.gray
    table.cell(tbl, 8, 1, sbrStr,                                   text_color=sbrC,    text_size=size.tiny)

    // ── Row 2: Aux signals header
    table.cell(tbl, 0, 2, "AUX",    text_color=hAux,  text_size=size.tiny, bgcolor=color.new(#1C2526,60))
    table.cell(tbl, 1, 2, "VZO",    text_color=hAux,  text_size=size.tiny, bgcolor=color.new(#1C2526,60))
    table.cell(tbl, 2, 2, "CTO",    text_color=hAux,  text_size=size.tiny, bgcolor=color.new(#1C2526,60))
    table.cell(tbl, 3, 2, "DMI",    text_color=hAux,  text_size=size.tiny, bgcolor=color.new(#1C2526,60))
    table.cell(tbl, 4, 2, "Aroon",  text_color=hAux,  text_size=size.tiny, bgcolor=color.new(#1C2526,60))
    table.cell(tbl, 5, 2, "MACD",   text_color=hAux,  text_size=size.tiny, bgcolor=color.new(#1C2526,60))
    table.cell(tbl, 6, 2, "StRSI",  text_color=hAux,  text_size=size.tiny, bgcolor=color.new(#1C2526,60))
    table.cell(tbl, 7, 2, "CCI",    text_color=hAux,  text_size=size.tiny, bgcolor=color.new(#1C2526,60))
    table.cell(tbl, 8, 2, "",        text_color=hAux,  text_size=size.tiny, bgcolor=color.new(#1C2526,60))

    // ── Row 3: Aux TF1
    table.cell(tbl, 0, 3, tf1,                                             text_color=s1c,                       text_size=size.tiny)
    table.cell(tbl, 1, 3, vzoOn  ? str.tostring(math.round(vzo1, 1)) : "—", text_color=f_zCol(vzo1,vzoUp,vzoLo), text_size=size.tiny)
    table.cell(tbl, 2, 3, ctoOn  ? str.tostring(math.round(cto1, 1)) : "—", text_color=f_zCol(cto1,ctoUp,ctoLo), text_size=size.tiny)
    table.cell(tbl, 3, 3, dmiOn  ? str.tostring(math.round(dmi1, 1)) : "—", text_color=f_zCol(dmi1,dmiUp,dmiLo), text_size=size.tiny)
    table.cell(tbl, 4, 3, arnOn  ? str.tostring(math.round(arn1, 1)) : "—", text_color=f_zCol(arn1,arnUp,arnLo), text_size=size.tiny)
    table.cell(tbl, 5, 3, macdOn ? f_np(macd1) : "—",                       text_color=f_nc(macd1),              text_size=size.tiny)
    table.cell(tbl, 6, 3, srsiOn ? f_np(nSR1)  : "—",                       text_color=f_nc(nSR1),               text_size=size.tiny)
    table.cell(tbl, 7, 3, cciOn  ? f_np(cci1)  : "—",                       text_color=f_nc(cci1),               text_size=size.tiny)
    table.cell(tbl, 8, 3, "",                                                text_color=color.gray,               text_size=size.tiny)

    // ── Row 4: Aux TF2
    table.cell(tbl, 0, 4, tf2,                                             text_color=s2c,                       text_size=size.tiny)
    table.cell(tbl, 1, 4, vzoOn  ? str.tostring(math.round(vzo2, 1)) : "—", text_color=f_zCol(vzo2,vzoUp,vzoLo), text_size=size.tiny)
    table.cell(tbl, 2, 4, ctoOn  ? str.tostring(math.round(cto2, 1)) : "—", text_color=f_zCol(cto2,ctoUp,ctoLo), text_size=size.tiny)
    table.cell(tbl, 3, 4, dmiOn  ? str.tostring(math.round(dmi2, 1)) : "—", text_color=f_zCol(dmi2,dmiUp,dmiLo), text_size=size.tiny)
    table.cell(tbl, 4, 4, arnOn  ? str.tostring(math.round(arn2, 1)) : "—", text_color=f_zCol(arn2,arnUp,arnLo), text_size=size.tiny)
    table.cell(tbl, 5, 4, macdOn ? f_np(macd2) : "—",                       text_color=f_nc(macd2),              text_size=size.tiny)
    table.cell(tbl, 6, 4, srsiOn ? f_np(nSR2)  : "—",                       text_color=f_nc(nSR2),               text_size=size.tiny)
    table.cell(tbl, 7, 4, cciOn  ? f_np(cci2)  : "—",                       text_color=f_nc(cci2),               text_size=size.tiny)
    table.cell(tbl, 8, 4, "",                                                text_color=color.gray,               text_size=size.tiny)

    // ── Row 5: Aux TF3
    table.cell(tbl, 0, 5, tf3,                                             text_color=s3c,                       text_size=size.tiny)
    table.cell(tbl, 1, 5, vzoOn  ? str.tostring(math.round(vzo3, 1)) : "—", text_color=f_zCol(vzo3,vzoUp,vzoLo), text_size=size.tiny)
    table.cell(tbl, 2, 5, ctoOn  ? str.tostring(math.round(cto3, 1)) : "—", text_color=f_zCol(cto3,ctoUp,ctoLo), text_size=size.tiny)
    table.cell(tbl, 3, 5, dmiOn  ? str.tostring(math.round(dmi3, 1)) : "—", text_color=f_zCol(dmi3,dmiUp,dmiLo), text_size=size.tiny)
    table.cell(tbl, 4, 5, arnOn  ? str.tostring(math.round(arn3, 1)) : "—", text_color=f_zCol(arn3,arnUp,arnLo), text_size=size.tiny)
    table.cell(tbl, 5, 5, macdOn ? f_np(macd3) : "—",                       text_color=f_nc(macd3),              text_size=size.tiny)
    table.cell(tbl, 6, 5, srsiOn ? f_np(nSR3)  : "—",                       text_color=f_nc(nSR3),               text_size=size.tiny)
    table.cell(tbl, 7, 5, cciOn  ? f_np(cci3)  : "—",                       text_color=f_nc(cci3),               text_size=size.tiny)
    table.cell(tbl, 8, 5, "",                                                text_color=color.gray,               text_size=size.tiny)

    // ── Row 6: SBR momentum row
    string sbrMom = sbrFall ? "↓ Falling" : sbrRise ? "↑ Rising" : "→ Flat"
    table.cell(tbl, 0, 6, "SBR",      text_color=color.new(#78909C,0), text_size=size.tiny)
    table.cell(tbl, 1, 6, sbrStr,     text_color=sbrC,                 text_size=size.tiny)
    table.cell(tbl, 2, 6, sbrMom,     text_color=color.gray,           text_size=size.tiny)
    table.cell(tbl, 3, 6, "",         text_color=color.gray,           text_size=size.tiny)
    table.cell(tbl, 4, 6, "",         text_color=color.gray,           text_size=size.tiny)
    table.cell(tbl, 5, 6, "",         text_color=color.gray,           text_size=size.tiny)
    table.cell(tbl, 6, 6, "",         text_color=color.gray,           text_size=size.tiny)
    table.cell(tbl, 7, 6, "",         text_color=color.gray,           text_size=size.tiny)
    table.cell(tbl, 8, 6, "",         text_color=color.gray,           text_size=size.tiny)
