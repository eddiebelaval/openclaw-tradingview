// ║  INPUTS — TIMEFRAMES                                         ║
// ╚══════════════════════════════════════════════════════════════╝

string gTF = "═══ Timeframes ═══"
string tf1  = input.timeframe("5",  "TF 1 (Fast)",   group=gTF)
string tf2  = input.timeframe("10", "TF 2 (Mid)",    group=gTF)
string tf3  = input.timeframe("45", "TF 3 (Slow)",   group=gTF)

// ╔══════════════════════════════════════════════════════════════╗
// ║  INPUTS — ORIGINAL OSCILLATORS                               ║
