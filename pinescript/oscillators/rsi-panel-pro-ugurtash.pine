//@version=6
indicator("RSI Panel Pro [UgurTash]", overlay=false)

// ==================== SETTINGS ====================
rsi_length = input.int(14, title="RSI Length", minval=2, maxval=50)
rsi_source = input.source(close, title="RSI Source")
rsi_overbought = input.int(70, title="Overbought Level", minval=60, maxval=90)
rsi_oversold = input.int(30, title="Oversold Level", minval=10, maxval=40)

// Smoothing
show_signal = input.bool(true, title="Show Signal Line (EMA of RSI)")
signal_length = input.int(9, title="Signal Line Length", minval=2, maxval=20)

// Colors
rsi_color_up = input.color(color.new(color.green, 0), title="RSI Color (Rising)")
rsi_color_down = input.color(color.new(color.red, 0), title="RSI Color (Falling)")
ob_color = input.color(color.new(color.red, 80), title="Overbought Zone Color")
os_color = input.color(color.new(color.green, 80), title="Oversold Zone Color")

// ==================== CALCULATIONS ====================
rsi = ta.rsi(rsi_source, rsi_length)
signal = ta.ema(rsi, signal_length)

rsi_rising = rsi > rsi[1]
rsi_color = rsi_rising ? rsi_color_up : rsi_color_down

// ==================== PLOTS ====================
// Overbought / Oversold zones
h1 = hline(rsi_overbought, "Overbought", color=color.new(color.red, 50), linestyle=hline.style_dashed, linewidth=1)
h2 = hline(rsi_oversold, "Oversold", color=color.new(color.green, 50), linestyle=hline.style_dashed, linewidth=1)
h3 = hline(50, "Midline", color=color.new(color.gray, 60), linestyle=hline.style_dotted, linewidth=1)
fill(h1, h2, color=color.new(color.gray, 92))

// Overbought / Oversold fill zones
ob_fill_top = hline(100, display=display.none)
os_fill_bot = hline(0, display=display.none)
fill(h1, ob_fill_top, color=ob_color)
fill(h2, os_fill_bot, color=os_color)

// RSI Line (colored by direction)
plot(rsi, "RSI", color=rsi_color, linewidth=2)

// Signal Line
plot(show_signal ? signal : na, "Signal", color=color.new(color.orange, 0), linewidth=1)

// RSI Histogram (distance from midline)
show_histogram = input.bool(true, title="Show RSI Histogram")
rsi_hist = rsi - 50
hist_color = rsi_hist >= 0 ? color.new(color.green, 60) : color.new(color.red, 60)
plot(show_histogram ? rsi_hist : na, "RSI Hist", color=hist_color, style=plot.style_histogram, linewidth=3)

// ==================== PIVOT MARKERS ON RSI ====================
show_div_markers = input.bool(true, title="Show Pivot Markers on RSI")
pivot_left_p = input.int(5, title="Pivot Left (match main indicator)", minval=1, maxval=20)
pivot_right_p = input.int(5, title="Pivot Right (match main indicator)", minval=0, maxval=20)

pivot_high_rsi = ta.pivothigh(rsi, pivot_left_p, pivot_right_p)
pivot_low_rsi = ta.pivotlow(rsi, pivot_left_p, pivot_right_p)

// RSI pivot high marker - placed at the RSI value
plot(show_div_markers and not na(pivot_high_rsi) ? rsi[pivot_right_p] : na,
     "RSI Pivot High", color=color.new(color.red, 0),
     style=plot.style_circles, linewidth=4, offset=-pivot_right_p)

// RSI pivot low marker - placed at the RSI value
plot(show_div_markers and not na(pivot_low_rsi) ? rsi[pivot_right_p] : na,
     "RSI Pivot Low", color=color.new(color.green, 0),
     style=plot.style_circles, linewidth=4, offset=-pivot_right_p)

// ==================== BACKGROUND ====================
bgcolor(rsi > rsi_overbought ? color.new(color.red, 93) : 
        rsi < rsi_oversold ? color.new(color.green, 93) : na)

// ==================== STATS PANEL ====================
show_stats = input.bool(true, title="Show Stats Panel")

if show_stats and barstate.islast
    var table stats = table.new(position.top_right, 2, 5,
         bgcolor=color.new(color.gray, 90), frame_width=2, frame_color=color.new(color.blue, 50),
         border_width=1, border_color=color.new(color.gray, 70))

    table.cell(stats, 0, 0, "RSI PANEL",
         bgcolor=color.new(color.blue, 70), text_color=color.white, text_size=size.normal)
    table.merge_cells(stats, 0, 0, 1, 0)

    table.cell(stats, 0, 1, "RSI Length:", text_color=color.white, text_size=size.small)
    table.cell(stats, 1, 1, str.tostring(rsi_length), text_color=color.yellow, text_size=size.small)

    table.cell(stats, 0, 2, "Current RSI:", text_color=color.white, text_size=size.small)
    rsi_color_panel = rsi > rsi_overbought ? color.red : rsi < rsi_oversold ? color.green : color.white
    table.cell(stats, 1, 2, str.tostring(rsi, "#.##"), text_color=rsi_color_panel, text_size=size.small)

    table.cell(stats, 0, 3, "Signal EMA:", text_color=color.white, text_size=size.small)
    table.cell(stats, 1, 3, str.tostring(signal, "#.##"), text_color=color.orange, text_size=size.small)

    table.cell(stats, 0, 4, "Zone:", text_color=color.white, text_size=size.small)
    zone_text = rsi > rsi_overbought ? "OVERBOUGHT" : rsi < rsi_oversold ? "OVERSOLD" : "NEUTRAL"
    zone_color = rsi > rsi_overbought ? color.red : rsi < rsi_oversold ? color.green : color.gray
    table.cell(stats, 1, 4, zone_text, text_color=zone_color, text_size=size.small)
