//@version=6
indicator('RSI Combine', overlay = false)

// ===== INPUT =====
rsiLength = input.int(14, title = 'RSI Length')
wmaLength = input.int(9, title = 'WMA Length')
emaLength = input.int(21, title = 'EMA Length')

// ===== CALCULATION =====
rsiValue = ta.rsi(close, rsiLength)
wmaOnRsi = ta.wma(rsiValue, wmaLength)
emaOnRsi = ta.ema(rsiValue, emaLength)

// ===== PLOT =====
plot(rsiValue, title = 'RSI', color = color.blue, linewidth = 2)
plot(wmaOnRsi, title = 'WMA on RSI', color = color.orange, linewidth = 2)
plot(emaOnRsi, title = 'EMA on RSI', color = color.purple, linewidth = 2)

// ===== LEVELS =====
// Overbought
hline(80, 'OB 80', color = color.red)
hline(75, 'OB 75', color = color.new(color.red, 20))
hline(65, 'OB 65', color = color.new(color.red, 40))

// Oversold
hline(20, 'OS 20', color = color.green)
hline(25, 'OS 25', color = color.new(color.green, 20))
hline(35, 'OS 35', color = color.new(color.green, 40))

// Midline
hline(50, 'Midline', color = color.gray)

// ===== SIGNALS =====
bullSignal = ta.crossover(rsiValue, wmaOnRsi) and rsiValue > emaOnRsi
bearSignal = ta.crossunder(rsiValue, wmaOnRsi) and rsiValue < emaOnRsi

plotshape(bullSignal, title = 'Buy', location = location.bottom, color = color.green, style = shape.triangleup, size = size.small)
plotshape(bearSignal, title = 'Sell', location = location.top, color = color.red, style = shape.triangledown, size = size.small)
