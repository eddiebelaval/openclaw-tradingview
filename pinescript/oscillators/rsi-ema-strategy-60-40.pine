//@version=5
indicator("RSI + EMA Strategy (60-40)", overlay=true)

// === INPUTS ===
rsiLength = input.int(14, title="RSI Length")
rsiUpper = input.int(60, title="RSI Upper Level")
rsiLower = input.int(40, title="RSI Lower Level")

emaShortLength = input.int(50, title="EMA 50")
emaLongLength = input.int(200, title="EMA 200")

// === CALCULATIONS ===
rsi = ta.rsi(close, rsiLength)
ema50 = ta.ema(close, emaShortLength)
ema200 = ta.ema(close, emaLongLength)

// === CONDITIONS ===

// BUY CONDITION:
// Price > EMA50 & EMA50 > EMA200 & RSI crosses above 60
buyCondition = close > ema50 and ema50 > ema200 and ta.crossover(rsi, rsiUpper)

// SELL CONDITION:
// Price < EMA50 & EMA50 < EMA200 & RSI crosses below 40
sellCondition = close < ema50 and ema50 < ema200 and ta.crossunder(rsi, rsiLower)

// === PLOTS ===
plot(ema50, color=color.blue, title="EMA 50")
plot(ema200, color=color.red, title="EMA 200")

// === SIGNALS ===
plotshape(buyCondition, title="BUY", location=location.belowbar, color=color.green, style=shape.labelup, text="BUY")
plotshape(sellCondition, title="SELL", location=location.abovebar, color=color.red, style=shape.labeldown, text="SELL")

// === ALERTS ===
alertcondition(buyCondition, title="Buy Alert", message="BUY Signal Generated")
alertcondition(sellCondition, title="Sell Alert", message="SELL Signal Generated")
