//@version=5
indicator("Smart Money vs Retail Osc", shorttitle="SMR Osc", overlay=false, max_bars_back=500)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════
sm_len      = input.int(7,     "Smart Money Length", minval=1,    group="Core")
rt_len      = input.int(21,    "Retail Length",      minval=1,    group="Core")
vol_len     = input.int(14,    "Volume Smooth",      minval=1,    group="Core")
sig_thresh  = input.float(0.15, "Signal Threshold",  minval=0.01, step=0.01,
              tooltip="Minimum gap between lines at crossover. Lower = more triangles.",
              group="Core")

show_sigs   = input.bool(true, "Show Triangles",  group="Display")
show_bg     = input.bool(true, "Show Pink Bands", group="Display")
show_table  = input.bool(true, "Show Table",      group="Display")

alert_range = input.bool(true, "Alert: Range/Exit zone",  group="Alerts")
alert_sm    = input.bool(true, "Alert: Smart Money ctrl", group="Alerts")
alert_exit  = input.bool(true, "Alert: EXIT signal",      group="Alerts")

// ═══════════════════════════════════════════════════════════════
// VOLUME DECOMPOSITION
// ═══════════════════════════════════════════════════════════════
bull_vol = close >= open ? volume : 0.0
bear_vol = close  < open ? volume : 0.0

sm_bull  = ta.ema(bull_vol, sm_len)
sm_bear  = ta.ema(bear_vol, sm_len)
sm_tot   = ta.ema(volume,   sm_len)
sm_raw   = sm_tot > 0 ? (sm_bull - sm_bear) / sm_tot : 0.0

rt_bull  = ta.ema(bull_vol, rt_len)
rt_bear  = ta.ema(bear_vol, rt_len)
rt_tot   = ta.ema(volume,   rt_len)
rt_raw   = rt_tot > 0 ? (rt_bull - rt_bear) / rt_tot : 0.0

// ═══════════════════════════════════════════════════════════════
// NORMALISATION → 0–3 SCALE
// ═══════════════════════════════════════════════════════════════
LKBK    = 100
sm_hi   = ta.highest(sm_raw, LKBK)
sm_lo   = ta.lowest(sm_raw,  LKBK)
rt_hi   = ta.highest(rt_raw, LKBK)
rt_lo   = ta.lowest(rt_raw,  LKBK)

sm_norm = sm_hi != sm_lo ? (sm_raw - sm_lo) / (sm_hi - sm_lo) * 3.0 : 1.5
rt_pct  = rt_hi != rt_lo ? (rt_raw - rt_lo) / (rt_hi - rt_lo)       : 0.5
rt_norm = 0.8 + rt_pct * 1.4

sm_plot = ta.ema(sm_norm, 3)
rt_plot = ta.ema(rt_norm, 5)

// ═══════════════════════════════════════════════════════════════
// REGIME DETECTION
// ═══════════════════════════════════════════════════════════════
vol_ma    = ta.sma(volume, vol_len)
vol_ratio = volume / math.max(vol_ma, 1)
[dp, dm, adx] = ta.dmi(14, 14)

reg_label =
  adx > 22 and vol_ratio > 1.1  ? "TREND" :
  vol_ratio > 1.8 and adx < 22  ? "MANIP" :
  adx < 14 and vol_ratio < 0.85 ? "CHOP"  :
  adx < 18 and vol_ratio < 0.95 ? "RANGE" : "TREND"

// ═══════════════════════════════════════════════════════════════
// CONTROL / TREND / STATUS
// ═══════════════════════════════════════════════════════════════
diff       = sm_plot - rt_plot
ctrl_label = diff >  sig_thresh ? "SMART"  :
             diff < -sig_thresh ? "RETAIL" : "BALANCE"

trend_up   = ta.ema(close, 20) > ta.ema(close, 50)
trend_dir  = trend_up ? "BUY" : "SELL"

sm_cross   = ta.cross(sm_plot, rt_plot)
sts_label  = sm_cross ? "EXIT" : "ACTIVE"

// ═══════════════════════════════════════════════════════════════
// SIGNALS — crossover only
//
//  ▲ Green  : yellow crosses ABOVE purple  (SM takes control)
//  ▼ Red    : yellow crosses BELOW purple  (Retail takes control)
//
// sig_thresh sets the minimum gap required at the moment of cross.
// Lower the threshold → more crosses qualify → more triangles.
// ═══════════════════════════════════════════════════════════════
buy_sig  = show_sigs and ta.crossover(sm_plot,  rt_plot) and math.abs(diff) > sig_thresh
sell_sig = show_sigs and ta.crossunder(sm_plot, rt_plot) and math.abs(diff) > sig_thresh

// ═══════════════════════════════════════════════════════════════
// BACKGROUND HIGHLIGHTS
// ═══════════════════════════════════════════════════════════════
pink_on = vol_ratio > 1.8 or sm_cross
bgcolor(show_bg and pink_on ? color.new(color.fuchsia, 83) : na)

// ═══════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════
plotshape(sell_sig, title="Sell", location=location.top,    style=shape.triangledown, color=color.new(color.red,  0), size=size.tiny)
plotshape(buy_sig,  title="Buy",  location=location.bottom, style=shape.triangleup,   color=color.new(color.lime, 0), size=size.tiny)

hline(3.0, "", color=color.new(color.gray, 70), linestyle=hline.style_dotted)
hline(2.0, "", color=color.new(color.gray, 70), linestyle=hline.style_dotted)
hline(1.5, "", color=color.new(color.gray, 50), linestyle=hline.style_dashed)
hline(1.0, "", color=color.new(color.gray, 70), linestyle=hline.style_dotted)
hline(0.0, "", color=color.new(color.gray, 70), linestyle=hline.style_dotted)

p_sm = plot(sm_plot, "Smart Money", color=#fbff00,               linewidth=1)
p_rt = plot(rt_plot, "Retail",      color=color.new(#7B1FA2, 0), linewidth=2)
fill(p_sm, p_rt, color=sm_plot >= rt_plot ? color.new(#90CAF9, 78) : color.new(#CE93D8, 78))

// ═══════════════════════════════════════════════════════════════
// INFO TABLE
// ═══════════════════════════════════════════════════════════════
if show_table and barstate.islast
    var table t = table.new(position.top_right, 2, 6,
      border_width=1, border_color=color.new(color.gray, 60),
      bgcolor=color.new(color.black, 0))

    white  = color.new(color.white, 0)
    grn    = color.new(#00C853, 0)
    yellow_c = #fffb00
    purp_c = #d900ff
    blk    = color.new(color.black, 0)
    grn_bg = color.new(#1B5E20, 0)
    red_bg = color.new(#C62828, 0)

    table.cell(t, 0, 0, "Regime:",   text_color=white,  bgcolor=blk, text_size=size.small, text_halign=text.align_right)
    table.cell(t, 1, 0, "✓ " + reg_label,  text_color=grn,    bgcolor=blk, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 0, 1, "Control:",  text_color=white,  bgcolor=blk, text_size=size.small, text_halign=text.align_right)
    table.cell(t, 1, 1, "✓ " + ctrl_label, text_color=grn,    bgcolor=blk, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 0, 2, "Smart:",    text_color=white,  bgcolor=blk, text_size=size.small, text_halign=text.align_right)
    table.cell(t, 1, 2, str.tostring(math.round(sm_plot, 2)), text_color=yellow_c, bgcolor=blk, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 0, 3, "Retail:",    text_color=white,  bgcolor=blk, text_size=size.small, text_halign=text.align_right)
    table.cell(t, 1, 3, str.tostring(math.round(rt_plot, 2)), text_color=purp_c, bgcolor=blk, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 0, 4, "Status:",   text_color=white,  bgcolor=blk, text_size=size.small, text_halign=text.align_right)
    table.cell(t, 1, 4, "✓ " + sts_label,  text_color=grn,    bgcolor=blk, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 0, 5, "TREND:", text_color=white,  bgcolor=blk, text_size=size.small, text_halign=text.align_right)
    table.cell(t, 1, 5, trend_dir, text_color=white, bgcolor=trend_up ? grn_bg : red_bg, text_size=size.small, text_halign=text.align_left)

// ═══════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════
if alert_range and pink_on
    alert("SMR: Range/Exit zone active", alert.freq_once_per_bar)
if alert_sm and ctrl_label == "SMART"
    alert("SMR: Smart Money in control", alert.freq_once_per_bar)
if alert_exit and sts_label == "EXIT"
    alert("SMR: EXIT signal fired",      alert.freq_once_per_bar)
