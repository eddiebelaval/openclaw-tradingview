//@version=6
indicator("Info Panel", overlay=true)

// ──────────────────────────────────────────────
// User Settings
// ──────────────────────────────────────────────
bgColor   = input.color(color.new(color.black, 30), "Panel Background", display=display.none)
txtColor  = input.color(color.rgb(220, 220, 220), "Label Color", display=display.none)
valColor  = input.color(color.rgb(255, 255, 255), "Value Color", display=display.none)

// ──────────────────────────────────────────────
// Market Cap
// ──────────────────────────────────────────────
shares = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FQ", ignore_invalid_symbol=true)
rawMC = not na(shares) ? close * shares : na

formatMC(val) =>
    if na(val)
        "N/A"
    else if val >= 1e12
        "$" + str.tostring(val / 1e12, "#.##") + "T"
    else if val >= 1e9
        "$" + str.tostring(val / 1e9, "#.##") + "B"
    else if val >= 1e6
        "$" + str.tostring(val / 1e6, "#.##") + "M"
    else
        "$" + str.tostring(val, "#.##")

mcText = formatMC(rawMC)

// ──────────────────────────────────────────────
// ADR% (Average Daily Range % over 20 trading days)
// ──────────────────────────────────────────────
dailyRange = (high - low) / close * 100
adr20 = ta.sma(dailyRange, 20)
adrText = not na(adr20) ? str.tostring(adr20, "#.##") + "%" : "N/A"

// ──────────────────────────────────────────────
// ATR% (Average True Range % over 20 trading days)
// ──────────────────────────────────────────────
atr20   = ta.atr(20)
atrPct  = not na(atr20) ? (atr20 / close) * 100 : na
atrText = not na(atrPct) ? str.tostring(atrPct, "#.##") + "%" : "N/A"

// ──────────────────────────────────────────────
// % Off 52-Week High (252 trading days)
// ──────────────────────────────────────────────
high52 = ta.highest(high, 252)
offHigh = (close - high52) / high52 * 100
offHighText = not na(offHigh) ? str.tostring(offHigh, "#.#") + "%" : "N/A"

// ──────────────────────────────────────────────
// Average Dollar Volume (20-day)
// ──────────────────────────────────────────────
dolVol = close * volume
avgDolVol = ta.sma(dolVol, 20)

formatDolVol(val) =>
    if na(val)
        "N/A"
    else if val >= 1e9
        "$" + str.tostring(val / 1e9, "#.##") + "B"
    else if val >= 1e6
        "$" + str.tostring(val / 1e6, "#.##") + "M"
    else if val >= 1e3
        "$" + str.tostring(val / 1e3, "#.##") + "K"
    else
        "$" + str.tostring(val, "#.##")

avgDolVolText = formatDolVol(avgDolVol)

// ──────────────────────────────────────────────
// RS Rating
// ──────────────────────────────────────────────
perf3m  = (close - close[63]) / close[63] * 100
perf6m  = (close - close[126]) / close[126] * 100
perf9m  = (close - close[189]) / close[189] * 100
perf12m = (close - close[252]) / close[252] * 100
weightedPerf = 0.4 * perf3m + 0.2 * perf6m + 0.2 * perf9m + 0.2 * perf12m

spyClose = request.security("SPY", timeframe.period, close, ignore_invalid_symbol=true)
spyPerf3m  = (spyClose - spyClose[63]) / spyClose[63] * 100
spyPerf6m  = (spyClose - spyClose[126]) / spyClose[126] * 100
spyPerf9m  = (spyClose - spyClose[189]) / spyClose[189] * 100
spyPerf12m = (spyClose - spyClose[252]) / spyClose[252] * 100
spyWeightedPerf = 0.4 * spyPerf3m + 0.2 * spyPerf6m + 0.2 * spyPerf9m + 0.2 * spyPerf12m

rsRaw = weightedPerf - spyWeightedPerf
rsRating = 50 + 50 * (2 / (1 + math.exp(-rsRaw / 15)) - 1)
rsRating := math.min(99, math.max(1, math.round(rsRating)))
rsText = not na(rsRating) ? str.tostring(rsRating, "#") : "N/A"

// ──────────────────────────────────────────────
// Sector, Industry, and Sector ETF
// ──────────────────────────────────────────────
sectorStr   = str.length(syminfo.sector) > 0 ? syminfo.sector : "N/A"
industryStr = str.length(syminfo.industry) > 0 ? syminfo.industry : "N/A"

sectorETF = switch sectorStr
    "Technology"             => "XLK"
    "Health Care"            => "XLV"
    "Financial"              => "XLF"
    "Finance"                => "XLF"
    "Financials"             => "XLF"
    "Consumer Cyclical"      => "XLY"
    "Consumer Defensive"     => "XLP"
    "Consumer Staples"       => "XLP"
    "Energy"                 => "XLE"
    "Industrials"            => "XLI"
    "Industrial"             => "XLI"
    "Basic Materials"        => "XLB"
    "Materials"              => "XLB"
    "Real Estate"            => "XLRE"
    "Utilities"              => "XLU"
    "Communication Services" => "XLC"
    "Communications"         => "XLC"
    "Health Technology"      => "XLV"
    "Electronic Technology"  => "XLK"
    "Technology Services"    => "XLK"
    => "N/A"

// ──────────────────────────────────────────────
// Table Display
// ──────────────────────────────────────────────
var tbl = table.new(position.top_right, 2, 10, bgcolor=bgColor, border_width=0)

if barstate.islast
    lblSize = size.small
    valSize = size.small

    table.cell(tbl, 0, 0, "\n",          text_size=size.tiny, bgcolor=color.new(color.black, 100))
    table.cell(tbl, 1, 0, "",             text_size=size.tiny, bgcolor=color.new(color.black, 100))

    table.cell(tbl, 0, 1, "MC",          text_color=txtColor, text_size=lblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 1, mcText,         text_color=valColor, text_size=valSize, text_halign=text.align_right)

    table.cell(tbl, 0, 2, "ADR%",        text_color=txtColor, text_size=lblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 2, adrText,        text_color=valColor, text_size=valSize, text_halign=text.align_right)

    table.cell(tbl, 0, 3, "ATR%",        text_color=txtColor, text_size=lblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 3, atrText,        text_color=valColor, text_size=valSize, text_halign=text.align_right)

    table.cell(tbl, 0, 4, "Off 52W High", text_color=txtColor, text_size=lblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 4, offHighText,    text_color=valColor, text_size=valSize, text_halign=text.align_right)

    table.cell(tbl, 0, 5, "Avg $ Vol",   text_color=txtColor, text_size=lblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 5, avgDolVolText,  text_color=valColor, text_size=valSize, text_halign=text.align_right)

    table.cell(tbl, 0, 6, "RS Rating",   text_color=txtColor, text_size=lblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 6, rsText,         text_color=valColor, text_size=valSize, text_halign=text.align_right)

    table.merge_cells(tbl, 0, 7, 1, 7)
    table.cell_set_text(tbl, 0, 7, sectorStr)
    table.cell_set_text_color(tbl, 0, 7, txtColor)
    table.cell_set_text_halign(tbl, 0, 7, text.align_center)
    table.cell_set_text_size(tbl, 0, 7, lblSize)

    table.merge_cells(tbl, 0, 8, 1, 8)
    table.cell_set_text(tbl, 0, 8, industryStr)
    table.cell_set_text_color(tbl, 0, 8, txtColor)
    table.cell_set_text_halign(tbl, 0, 8, text.align_center)
    table.cell_set_text_size(tbl, 0, 8, lblSize)

    table.merge_cells(tbl, 0, 9, 1, 9)
    table.cell_set_text(tbl, 0, 9, sectorETF)
    table.cell_set_text_color(tbl, 0, 9, txtColor)
    table.cell_set_text_halign(tbl, 0, 9, text.align_center)
    table.cell_set_text_size(tbl, 0, 9, lblSize)
