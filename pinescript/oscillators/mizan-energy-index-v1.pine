//@version=5
// Mizan Combined Energy Index Oscillator (Thrust + PSI)
// Author: Murat Kavak
indicator("Mizan Energy Index v1", shorttitle="Mizan-EI", overlay=false, max_labels_count=500)

// ==========================================
// INPUTS
// ==========================================
len_thrust  = input.int(7, "Thrust EMA Length")
len_norm    = input.int(100, "Thrust Normalization")
len_psi     = input.int(14, "PSI HMA Length")
ex_level    = input.float(0.8, "Exhaustion Level (Thrust)")
psi_thresh  = input.float(0.3, "PSI Noise Threshold")
alpha       = input.float(0.5, "Thrust Weight")
beta        = input.float(0.5, "PSI Weight")
use_vol     = input.bool(true, "Use Volume Weighting in PSI")

// ==========================================
// 1. THRUST OSCILLATOR
// ==========================================
rv = volume / ta.sma(volume, 50)
pc = ta.change(close)

th_raw = ta.ema(math.log(1 + math.abs(pc * rv)) * math.sign(pc), len_thrust)
mean_th = ta.sma(th_raw, len_norm)
std_th  = ta.stdev(th_raw, len_norm)
z_th = std_th != 0 ? (th_raw - mean_th)/std_th : 0

f_tanh(x) =>
    (math.exp(x) - math.exp(-x)) / (math.exp(x) + math.exp(-x))

th_osc = f_tanh(z_th)

// ==========================================
// 2. PSI OSCILLATOR
// ==========================================
total_range = high - low
body_size   = close - open
abs_body    = math.abs(body_size)
efficiency  = total_range == 0 ? 0 : abs_body / total_range
vol_factor  = use_vol ? (volume / ta.sma(volume,50)) : 1.0
psi_raw = efficiency > psi_thresh ? (body_size * efficiency * vol_factor) : 0
psi_line = ta.hma(psi_raw, len_psi)

// ==========================================
// 3. ENERGY INDEX (Combined)
// ==========================================
energy_index = alpha * th_osc + beta * psi_line

// ==========================================
// 4. VISUALIZATION (IF/ELSE DÜZELTME)
// ==========================================
col_psi = color.gray
if psi_line > 0
    if psi_line > psi_line[1]
        col_psi := color.new(#00bcd4, 0)   // Dark Blue - Strong Buyer
    else
        col_psi := color.new(#00bcd4, 60)  // Light Blue - Buyer Exhaustion
else
    if psi_line < psi_line[1]
        col_psi := color.new(#ff5252, 0)   // Dark Red - Strong Seller
    else
        col_psi := color.new(#ff5252, 60)  // Light Red - Seller Exhaustion

plot(energy_index, "Energy Index", color=color.yellow, linewidth=2)
plot(0, "Balance Line", color=color.gray)
plot(psi_line, "PSI Line", color=col_psi, style=plot.style_columns, linewidth=2)

// ==========================================
// 5. ALERTS
// ==========================================
alertcondition(ta.crossover(energy_index, 0), "BUY Signal", "Energy Index crosses above zero")
alertcondition(ta.crossunder(energy_index, 0), "SELL Signal", "Energy Index crosses below zero")
