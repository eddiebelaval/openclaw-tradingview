//@version=6
// =================================================================================================
//  █████╗ ██╗      ██████╗  ██████╗  █████╗ ████████╗     █████╗ ██╗     ██████╗ ██╗  ██╗ █████╗
// ██╔══██╗██║     ██╔════╝ ██╔═══██╗██╔══██╗╚══██╔══╝    ██╔══██╗██║     ██╔══██╗██║  ██║██╔══██╗
// ███████║██║     ██║  ███╗██║   ██║███████║   ██║       ███████║██║     ██████╔╝███████║███████║
// ██╔══██║██║     ██║   ██║██║   ██║██╔══██║   ██║       ██╔══██║██║     ██╔═══╝ ██╔══██║██╔══██║
// ██║  ██║███████╗╚██████╔╝╚██████╔╝██║  ██║   ██║       ██║  ██║███████╗██║     ██║  ██║██║  ██║
// ╚═╝  ╚═╝╚══════╝ ╚═════╝  ╚═════╝ ╚═╝  ╚═╝   ╚═╝       ╚═╝  ╚═╝╚══════╝╚═╝     ╚═╝  ╚═╝╚═╝  ╚═╝
// =================================================================================================

indicator("Goldilocks and the Three Bears - Confluence Scanner [Algoat_Alpha]", overlay=true, max_labels_count=500)

// ==========================================
// 1. INPUTS
// ==========================================
grp_ma   = "Papa (Trend: Moving Average)"
maType   = input.string("EMA", "MA Type", options=["SMA", "EMA"], group=grp_ma, tooltip="EMA reacts faster to recent price action. SMA weights all bars equally for a smoother line.")
maLength = input.int(200, "Length", minval=1, group=grp_ma, tooltip="Number of bars used to calculate the moving average. 200 is the institutional standard for long-term trend.")

grp_rsi  = "Mama (Momentum: RSI)"
rsiLen   = input.int(14, "Length", minval=2, group=grp_rsi, tooltip="RSI lookback period. 14 is the standard developed by J. Welles Wilder.")
rsiMid   = input.int(50, "Bull/Bear Threshold", minval=1, maxval=99, group=grp_rsi, tooltip="RSI above this level = bullish momentum. Below = bearish momentum. 50 is the equilibrium line.")

grp_macd = "Baby (Direction: MACD)"
fastLen  = input.int(12, "Fast Length", minval=1, group=grp_macd, tooltip="Short-term EMA for MACD calculation.")
slowLen  = input.int(26, "Slow Length", minval=1, group=grp_macd, tooltip="Long-term EMA for MACD calculation.")
sigLen   = input.int(9, "Signal Length", minval=1, group=grp_macd, tooltip="EMA of the MACD line, used for crossover signals.")

grp_vis  = "Visual Settings"
showBarColor = input.bool(false, "Enable Bar Coloring", group=grp_vis, tooltip="When enabled, bars are tinted green during full bullish confluence and red during full bearish confluence.")
dashPos      = input.string(position.top_right, "Dashboard Position", options=[position.top_right, position.middle_right, position.bottom_right, position.top_left, position.bottom_left], group=grp_vis)
dashSizeStr  = input.string("Small", "Dashboard Size", options=["Small", "Normal", "Large"], group=grp_vis)

// ==========================================
// 2. THEME COLORS & AUTO LIGHT/DARK MODE
// ==========================================
c_bull = color.rgb(8, 153, 129)
c_bear = color.rgb(242, 54, 69)

// Auto-detect chart theme via background brightness (ITU-R BT.601 luma formula)
bgBrightness = (color.r(chart.bg_color) * 299 + color.g(chart.bg_color) * 587 + color.b(chart.bg_color) * 114) / 1000
isLightMode  = bgBrightness > 128

c_tbl_header_bg = isLightMode ? color.rgb(240, 243, 250) : color.rgb(19, 23, 34)
c_tbl_cell_bg   = isLightMode ? color.rgb(255, 255, 255) : color.rgb(42, 46, 57)
c_tbl_border    = isLightMode ? color.rgb(209, 212, 220) : color.rgb(19, 23, 34)
c_text          = isLightMode ? color.rgb(19, 23, 34)    : color.white
c_bull_cell     = isLightMode ? color.rgb(219, 245, 237) : color.new(c_bull, 80)
c_bear_cell     = isLightMode ? color.rgb(253, 224, 227) : color.new(c_bear, 80)
dashSize        = dashSizeStr == "Small" ? size.small : dashSizeStr == "Normal" ? size.normal : size.large

// ==========================================
// 3. CALCULATIONS
// ==========================================
ma = maType == "SMA" ? ta.sma(close, maLength) : ta.ema(close, maLength)
rsi = ta.rsi(close, rsiLen)
[macdLine, signalLine, _] = ta.macd(close, fastLen, slowLen, sigLen)

// ==========================================
// 4. CONDITIONS
// ==========================================
papaBull = close > ma
mamaBull = rsi  > rsiMid
babyBull = macdLine > signalLine

papaBear = close < ma
mamaBear = rsi  < rsiMid
babyBear = macdLine < signalLine

bullZone = papaBull and mamaBull and babyBull
bearZone = papaBear and mamaBear and babyBear

longEntry  = bullZone and not bullZone[1]
shortEntry = bearZone and not bearZone[1]

// ==========================================
// 5. CHART VISUALS
// ==========================================
plot(ma, color=papaBull ? c_bull : c_bear, title="Papa MA", linewidth=2)

if longEntry
    label.new(bar_index, low, "🐂",
      color    = c_bull,
      textcolor= color.white,
      style    = label.style_label_up,
      size     = size.small,
      tooltip  = "GOLDILOCKS ZONE: 3 BULLS ALIGNED" +
        "\n\nPapa (MA): Price " + str.tostring(close, format.mintick) + " > " + str.tostring(ma, format.mintick) +
        "\nMama (RSI): " + str.tostring(rsi, "#.#") + " > " + str.tostring(rsiMid) +
        "\nBaby (MACD): " + str.tostring(macdLine, "#.####") + " > Signal " + str.tostring(signalLine, "#.####"))

if shortEntry
    label.new(bar_index, high, "🐻",
      color    = c_bear,
      textcolor= color.white,
      style    = label.style_label_down,
      size     = size.small,
      tooltip  = "GOLDILOCKS ZONE: 3 BEARS ALIGNED" +
        "\n\nPapa (MA): Price " + str.tostring(close, format.mintick) + " < " + str.tostring(ma, format.mintick) +
        "\nMama (RSI): " + str.tostring(rsi, "#.#") + " < " + str.tostring(rsiMid) +
        "\nBaby (MACD): " + str.tostring(macdLine, "#.####") + " < Signal " + str.tostring(signalLine, "#.####"))

barcolor(showBarColor ? bullZone ? color.new(c_bull, 60) : bearZone ? color.new(c_bear, 60) : na : na, title="Confluence Bar Color")

// ==========================================
// 6. ALERTS — Discord Webhook JSON Embeds
// ==========================================
// Note: alertcondition() requires const strings. Use TradingView placeholders only.

alertcondition(longEntry,
  title  = "3 Bulls Aligned (Long Entry)",
  message= '{"embeds":[{"title":"Goldilocks Zone — 3 Bulls Aligned","color":557185,"fields":[{"name":"Ticker","value":"{{ticker}}","inline":true},{"name":"Timeframe","value":"{{interval}}","inline":true},{"name":"Price","value":"{{close}}","inline":true},{"name":"Papa (Trend)","value":"Price > MA","inline":true},{"name":"Mama (Momentum)","value":"RSI > 50","inline":true},{"name":"Baby (Direction)","value":"MACD > Signal","inline":true}],"footer":{"text":"Goldilocks & the Three Bears | {{time}}"}}]}')

alertcondition(shortEntry,
  title  = "3 Bears Aligned (Short Entry)",
  message= '{"embeds":[{"title":"Goldilocks Zone — 3 Bears Aligned","color":15873093,"fields":[{"name":"Ticker","value":"{{ticker}}","inline":true},{"name":"Timeframe","value":"{{interval}}","inline":true},{"name":"Price","value":"{{close}}","inline":true},{"name":"Papa (Trend)","value":"Price < MA","inline":true},{"name":"Mama (Momentum)","value":"RSI < 50","inline":true},{"name":"Baby (Direction)","value":"MACD < Signal","inline":true}],"footer":{"text":"Goldilocks & the Three Bears | {{time}}"}}]}')

alertcondition(longEntry or shortEntry,
  title  = "Full Confluence (Any Direction)",
  message= '{"embeds":[{"title":"Goldilocks Zone — Full Confluence Detected","color":16750848,"fields":[{"name":"Ticker","value":"{{ticker}}","inline":true},{"name":"Timeframe","value":"{{interval}}","inline":true},{"name":"Price","value":"{{close}}","inline":true}],"footer":{"text":"Goldilocks & the Three Bears | {{time}}"}}]}')

// ==========================================
// 7. SCREENER EXPORTS (Pine Screener)
// ==========================================
// Signal State: 1 = bullish confluence, -1 = bearish confluence, 0 = no confluence
plot(bullZone ? 1 : bearZone ? -1 : 0, title="Signal State",  display=display.none)

// Individual component states for granular filtering
plot(papaBull ? 1 : 0, title="Papa Bull (Trend)",     display=display.none)
plot(mamaBull ? 1 : 0, title="Mama Bull (Momentum)",   display=display.none)
plot(babyBull ? 1 : 0, title="Baby Bull (Direction)",   display=display.none)

// Bull Count: number of bullish indicators (0 to 3)
plot((papaBull ? 1 : 0) + (mamaBull ? 1 : 0) + (babyBull ? 1 : 0), title="Bull Count", display=display.none)

// ==========================================
// 8. DASHBOARD
// ==========================================
var table dash = table.new(dashPos, 2, 5, border_width=2, frame_width=2)

string infoTip = "HOW TO READ THIS INDICATOR:" +
  "\n\nInspired by the Goldilocks fairy tale, this indicator looks for" +
  "\nmarket conditions that are 'just right' across three layers:" +
  "\n\nPapa (Trend) — Moving Average sets the macro direction." +
  "\nMama (Momentum) — RSI confirms momentum is aligned." +
  "\nBaby (Direction) — MACD crossover signals immediate shifts." +
  "\n\nWhen all 3 align bullish or bearish, you are in the" +
  "\nGoldilocks Zone — full directional confluence."

if barstate.islast
    table.set_border_color(dash, c_tbl_border)
    table.set_frame_color(dash, c_tbl_border)

    // Header row
    table.cell(dash, 0, 0, "Goldilocks Zone  ⓘ", tooltip=infoTip, text_color=c_text, text_halign=text.align_left, bgcolor=c_tbl_header_bg, text_size=dashSize)
    table.cell(dash, 1, 0, "Status", text_color=c_text, text_halign=text.align_center, bgcolor=c_tbl_header_bg, text_size=dashSize)

    // Papa row
    table.cell(dash, 0, 1, "Papa (Trend)", text_color=c_text, text_halign=text.align_left, bgcolor=c_tbl_cell_bg, text_size=dashSize)
    table.cell(dash, 1, 1, papaBull ? "Bull" : "Bear", text_color=papaBull ? c_bull : c_bear, bgcolor=papaBull ? c_bull_cell : c_bear_cell, text_size=dashSize)

    // Mama row
    table.cell(dash, 0, 2, "Mama (Momentum)", text_color=c_text, text_halign=text.align_left, bgcolor=c_tbl_cell_bg, text_size=dashSize)
    table.cell(dash, 1, 2, mamaBull ? "Bull" : "Bear", text_color=mamaBull ? c_bull : c_bear, bgcolor=mamaBull ? c_bull_cell : c_bear_cell, text_size=dashSize)

    // Baby row
    table.cell(dash, 0, 3, "Baby (Direction)", text_color=c_text, text_halign=text.align_left, bgcolor=c_tbl_cell_bg, text_size=dashSize)
    table.cell(dash, 1, 3, babyBull ? "Bull" : "Bear", text_color=babyBull ? c_bull : c_bear, bgcolor=babyBull ? c_bull_cell : c_bear_cell, text_size=dashSize)

    // Verdict row
    string verdict     = bullZone ? "JUST RIGHT (3 Bulls)" : bearZone ? "JUST RIGHT (3 Bears)" : "Still Cooking..."
    color  verdictBg   = bullZone ? c_bull : bearZone ? c_bear : c_tbl_header_bg
    color  verdictText = (bullZone or bearZone) ? color.white : c_text
    table.cell(dash, 0, 4, "Verdict:", text_color=c_text, text_halign=text.align_right, bgcolor=c_tbl_cell_bg, text_size=dashSize)
    table.cell(dash, 1, 4, verdict, text_color=verdictText, bgcolor=verdictBg, text_size=dashSize)
