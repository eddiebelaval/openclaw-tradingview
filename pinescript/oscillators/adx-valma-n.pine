//@version=6
indicator('ADX-vALMA (N)', timeframe = '', timeframe_gaps = false, overlay = false)

// Input Parameters
len     = input.int(14, title = 'Length', minval = 1, tooltip = 'The lookback period for ADX and DI calculations.')
offset_valma = input.float(0.7, title = 'ALMA Offset', step = 0.025, tooltip = 'Gaussian offset for ALMA (0-1)')
sigma   = input.float(4.0, title = 'ALMA Sigma', step = 0.25, tooltip = 'The deviation for the ALMA filterper')
th      = input.float(22, title = 'Trend Threshold', tooltip = 'The level above which the ADX indicates a strong trend.')

// Signal and Offset Parameters
showSignals  = input.bool(true, title = "Show Signals on Main Chart", tooltip = 'Displays Buy/Sell triangle shapes on the main price chart when DI lines cross.')
visualOffset = input.int(-1, title = "Signal Visual Offset", minval = -10, maxval = 10, tooltip = 'Shifts the signal shapes horizontally. Negative values move them to the left (past bars).')

// ADX Mode Selection
adxMode = input.string("Normalized ADX", title = "ADX Mode", options = ["Standard ADX", "Normalized ADX"], tooltip = 'Standard ADX is the classic calculation. Normalized ADX scales the value based on a lookback period (0-100 range).')
normLen = input.int(50, title = 'Normalization Lookback', minval = 1, tooltip = 'The period used to determine the highest and lowest ADX values for normalization.')

// Helper Functions (vALMA + Normalize)
valma(src, length, off, sig) =>
    vol = nz(volume, 1)
    ta.alma(src * vol, length, off, sig) / ta.alma(vol, length, off, sig)

normalize(src, length) =>
    minVal = ta.lowest(src, length)
    maxVal = ta.highest(src, length)
    100 * (src - minVal) / math.max(maxVal - minVal, 1e-10)

// DM +/- Calculation
up = ta.change(high)
down = -ta.change(low)

plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
tr = ta.tr(true)

// vALMA Smoothing
smoothedPlusDM  = valma(plusDM, len, offset_valma, sigma)
smoothedMinusDM = valma(minusDM, len, offset_valma, sigma)
smoothedTR      = valma(tr, len, offset_valma, sigma)

// DI Lines
diPlus  = (smoothedPlusDM / smoothedTR) * 100
diMinus = (smoothedMinusDM / smoothedTR) * 100

// ADX Calculation
dx = (math.abs(diPlus - diMinus) / math.max(diPlus + diMinus, 1e-10)) * 100
adx_raw = valma(dx, len, offset_valma, sigma)
adx_final = adxMode == "Normalized ADX" ? normalize(adx_raw, normLen) : adx_raw

// INDICATOR PANEL
plotPlus  = plot(diPlus, color = color.new(#09ff00, 0), title = 'DI+')
plotMinus = plot(diMinus, color = color.new(#ff0000, 0), title = 'DI-')
fill(plotPlus, plotMinus, color = diPlus > diMinus ? color.new(#00ff08, 90) : color.new(#ff0000, 90))

kolorADX = adx_final >= adx_final[1] ? color.lime : color.red
plot(adx_final, title = 'ADX Final', style = plot.style_line, linewidth = 2, color = kolorADX)

hline(th, color = color.new(color.gray, 50), linestyle = hline.style_dashed, title = "Threshold Line")
hline(100, color = color.new(color.red, 80), title = "Upper Bound")
hline(0, color = color.new(color.green, 80), title = "Lower Bound")

// MAIN CHART DRAWING
plotshape(showSignals and ta.crossover(diPlus, diMinus), 
     style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, 
     offset=visualOffset, force_overlay=true, title="Long Signal")

plotshape(showSignals and ta.crossunder(diPlus, diMinus), 
     style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, 
     offset=visualOffset, force_overlay=true, title="Short Signal")
