//@version=6
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Quant (LuxAlgo)

indicator("Money Flow Curvature Predictor", shorttitle="MF Curvature", overlay=false)

// --- INPUTS ---
mfi_len    = input.int(60, "MFI Length", minval=1)
mfi_mult   = input.float(0.15, "MFI Multiplier", minval=0.01, step=0.01)

// Confidence Filter Inputs
conf_bars   = input.int(3, "Min Rounding Duration", minval=1, tooltip="How many bars the curvature must be consistent before signaling.")
extreme_lvl = input.float(1.0, "Extreme Zone Threshold", minval=0.1, step=0.1, tooltip="Only signals when Money Flow is deep in these zones.")

// Style
bull_color = #089981
bear_color = #f23645

// --- CORE MONEY FLOW LOGIC ---
raw_mfi = ta.mfi(hlc3, mfi_len)
centered_mfi = (raw_mfi - 50) * mfi_mult
mf = ta.ema(centered_mfi, 3) 

// --- CURVATURE ANALYSIS ---
slope = mf - mf[1]
acceleration = slope - slope[1]

// --- PATTERN DETECTION WITH CONFIDENCE ---
is_rounding_bull = mf < -extreme_lvl and slope > 0 and acceleration > 0
is_rounding_bear = mf > extreme_lvl and slope < 0 and acceleration < 0

// Duration Tracking
var int bull_dur = 0
var int bear_dur = 0
bull_dur := is_rounding_bull ? bull_dur + 1 : 0
bear_dur := is_rounding_bear ? bear_dur + 1 : 0

// Signals
early_bullish = is_rounding_bull and bull_dur >= conf_bars
early_bearish = is_rounding_bear and bear_dur >= conf_bars

// --- VISUALIZATION ---
hline(0, "Zero Line", color=color.gray, linestyle=hline.style_dotted)

// Main Money Flow Cloud
mf_plot = plot(mf, "Money Flow", color=na)
zero_plot = plot(0, "Zero Reference", color=na)

fill(mf_plot, zero_plot, 
     top_value    = mf, 
     bottom_value = 0, 
     top_color    = mf > 0 ? color.new(bull_color, 50) : color.new(bull_color, 100), 
     bottom_color = mf > 0 ? color.new(bull_color, 100) : color.new(bull_color, 100))

fill(mf_plot, zero_plot, 
     top_value    = 0, 
     bottom_value = mf, 
     top_color    = mf < 0 ? color.new(bear_color, 100) : color.new(bear_color, 100), 
     bottom_color = mf < 0 ? color.new(bear_color, 50) : color.new(bear_color, 100))

// Curvature Predictors
plot(is_rounding_bull ? 0 : na, "Rounding Bullish", color=color.new(bull_color, 70), style=plot.style_circles, linewidth=2)
plot(is_rounding_bear ? 0 : na, "Rounding Bearish", color=color.new(bear_color, 70), style=plot.style_circles, linewidth=2)

// High Confidence (Larger Dots)
plot(early_bullish ? 0 : na, "High Confidence Bull", color=bull_color, style=plot.style_circles, linewidth=5)
plot(early_bearish ? 0 : na, "High Confidence Bear", color=bear_color, style=plot.style_circles, linewidth=5)

// Momentum Slope
plot(slope * 5, "Momentum Slope", color=slope > 0 ? color.new(bull_color, 70) : color.new(bear_color, 70), style=plot.style_columns)
