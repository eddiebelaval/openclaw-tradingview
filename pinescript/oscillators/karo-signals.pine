// Karolina Signals
// Version 1.1
// Updated: March 2026

//@version=6
indicator("Karo Signals", overlay=true)

// ===== INPUTS =====
emaLength = input.int(200, "EMA Length")
showEMA = input.bool(false, "Show EMA")
useEMAFilter = input.bool(true, "Use EMA200 Trend Filter")

atrLength = input.int(14, "ATR Length")
atrMult = input.float(0.6, "ATR Buffer")

macdFast = input.int(8)
macdSlow = input.int(21)
macdSignal = input.int(5)

rsiLength = input.int(14)

useDivergence = input.bool(true, "Show RSI Divergence Warnings")
pivotLen = input.int(5, "Divergence Pivot Length")

useSetups = input.bool(true, "Show Setup Signals")

slLookback = input.int(10, "Swing SL Lookback")
slBars = input.int(8, "SL Line Length")

cooldownBars = input.int(10, "Signal Cooldown")

// ===== CALCULATIONS =====
ema200 = ta.ema(close, emaLength)

[macdLine, signalLine, hist] = ta.macd(close, macdFast, macdSlow, macdSignal)

rsi = ta.rsi(close, rsiLength)

atr = ta.atr(atrLength)
buffer = atr * atrMult

// ===== TREND FILTER =====
trendLong = not useEMAFilter or close > ema200 + buffer
trendShort = not useEMAFilter or close < ema200 - buffer

// ===== MOMENTUM =====
rsiLong = rsi > 55
rsiShort = rsi < 45

macdLong = ta.crossover(macdLine, signalLine)
macdShort = ta.crossunder(macdLine, signalLine)

histUp = hist > hist[1]
histDown = hist < hist[1]

// ===== IMPULSE CANDLE =====
body = math.abs(close - open)
candleRange = high - low
impulse = body > candleRange * 0.6

// ===== COOLDOWN =====
var int lastSignalBar = na
cooldownOK = na(lastSignalBar) or bar_index - lastSignalBar > cooldownBars

// ===== ENTRY =====
longEntry =
     trendLong and
     macdLong and
     rsiLong and
     histUp and
     impulse and
     cooldownOK

shortEntry =
     trendShort and
     macdShort and
     rsiShort and
     histDown and
     impulse and
     cooldownOK

if longEntry or shortEntry
    lastSignalBar := bar_index

// ===== STOP LOSS =====
longSL = ta.lowest(low, slLookback)
shortSL = ta.highest(high, slLookback)

// ===== SL LINE =====
if longEntry
    line.new(bar_index, longSL, bar_index + slBars, longSL,
        color=color.red,
        style=line.style_dashed,
        width=2)

if shortEntry
    line.new(bar_index, shortSL, bar_index + slBars, shortSL,
        color=color.red,
        style=line.style_dashed,
        width=2)

// ===== RSI DIVERGENCE =====
pricePH = ta.pivothigh(high, pivotLen, pivotLen)
pricePL = ta.pivotlow(low, pivotLen, pivotLen)

rsiPH = ta.pivothigh(rsi, pivotLen, pivotLen)
rsiPL = ta.pivotlow(rsi, pivotLen, pivotLen)

var float lastPriceHigh = na
var float lastRsiHigh = na
var float lastPriceLow = na
var float lastRsiLow = na

bearDiv = false
bullDiv = false

if not na(pricePH)
    if not na(lastPriceHigh) and not na(lastRsiHigh)
        bearDiv := pricePH > lastPriceHigh and rsiPH < lastRsiHigh
    lastPriceHigh := pricePH
    lastRsiHigh := rsiPH

if not na(pricePL)
    if not na(lastPriceLow) and not na(lastRsiLow)
        bullDiv := pricePL < lastPriceLow and rsiPL > lastRsiLow
    lastPriceLow := pricePL
    lastRsiLow := rsiPL

// ===== SETUP SIGNALS (IMPROVED) =====

// MACD distance filter
macdDistance = math.abs(macdLine - signalLine)

// minimal distance threshold
setupThreshold = atr * 0.02

longSetup =
     useSetups and
     trendLong and
     rsi > 50 and
     macdLine < signalLine and
     macdLine > macdLine[1] and
     macdDistance < setupThreshold

shortSetup =
     useSetups and
     trendShort and
     rsi < 50 and
     macdLine > signalLine and
     macdLine < macdLine[1] and
     macdDistance < setupThreshold

// ===== PLOTS =====
plot(showEMA ? ema200 : na, "EMA200", color=color.blue, linewidth=2)

// ENTRY SIGNALS
plotshape(longEntry,
     title="Long Entry",
     location=location.belowbar,
     style=shape.triangleup,
     color=color.green,
     size=size.small)

plotshape(shortEntry,
     title="Short Entry",
     location=location.abovebar,
     style=shape.triangledown,
     color=color.red,
     size=size.small)

// SETUP SIGNALS
plotshape(longSetup,
     title="Long Setup",
     location=location.belowbar,
     style=shape.circle,
     color=color.green,
     size=size.tiny)

plotshape(shortSetup,
     title="Short Setup",
     location=location.abovebar,
     style=shape.circle,
     color=color.red,
     size=size.tiny)

// DIVERGENCE WARNINGS
plotshape(useDivergence and bearDiv,
     title="Bearish Divergence",
     location=location.abovebar,
     style=shape.circle,
     color=color.yellow,
     size=size.tiny)

plotshape(useDivergence and bullDiv,
     title="Bullish Divergence",
     location=location.belowbar,
     style=shape.circle,
     color=color.yellow,
     size=size.tiny)

// ===== LEGEND =====
var table legend = table.new(position.top_right, 1, 6)

if bar_index == 0
    table.cell(legend, 0, 0, "Karo Signals Guide", text_color=color.white, bgcolor=color.black)
    table.cell(legend, 0, 1, "Green ▲  Long Entry")
    table.cell(legend, 0, 2, "Red ▼  Short Entry")
    table.cell(legend, 0, 3, "Green dot = Possible Long Setup")
    table.cell(legend, 0, 4, "Red dot = Possible Short Setup")
    table.cell(legend, 0, 5, "Yellow dot = RSI Divergence Warning")
