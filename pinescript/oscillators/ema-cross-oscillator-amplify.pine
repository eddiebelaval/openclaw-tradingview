//@version=6
indicator("EMA Cross Oscillator", shorttitle="EMA Osc", overlay=false)

// Inputs
fastLen = input.int(9,  "Fast EMA")
slowLen = input.int(21, "Slow EMA")

// Current timeframe in minutes
cur_tf_min = timeframe.in_seconds() / 60

// Fixed set of 7 higher timeframes (balanced speed + coverage)
tfs = array.from("1W", "D", "240", "120", "60", "30", "15")

// Count bullish TFs
bullCount = 0

for i = 0 to array.size(tfs) - 1
    tf = array.get(tfs, i)
    
    [f, s] = request.security(syminfo.tickerid, tf,
         [ta.ema(close, fastLen), ta.ema(close, slowLen)],
         gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    
    if f > s
        bullCount += 1

// Max possible (constant for scaling only)
maxTFs = array.size(tfs)

// ────────────────────────────────────────────────
// Plot connected line + dots
// ────────────────────────────────────────────────
// Smooth line
plot(bullCount,
     title = "Bullish TFs",
     color = bullCount == maxTFs ? color.new(color.green, 0) :
             bullCount >= maxTFs * 0.8 ? color.new(color.lime, 10) :
             bullCount >= maxTFs * 0.5 ? color.new(color.orange, 20) :
             color.new(color.red, 30),
     linewidth = 3,
     style = plot.style_line)

// Dots
plot(bullCount,
     title = "Dots",
     color = bullCount == maxTFs ? color.new(color.green, 0) :
             bullCount >= maxTFs * 0.8 ? color.new(color.lime, 0) :
             bullCount >= maxTFs * 0.5 ? color.new(color.orange, 0) :
             color.new(color.red, 0),
     style = plot.style_circles,
     linewidth = 5)

// Fixed reference lines (constants only)
hline(0, "Zero", color=color.gray, linestyle=hline.style_dotted)
hline(7, "Max", color=color.gray, linestyle=hline.style_dashed)
