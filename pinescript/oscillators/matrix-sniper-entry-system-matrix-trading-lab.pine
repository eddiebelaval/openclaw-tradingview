//@version=5
indicator("Matrix Sniper Entry System — GÖKTUĞ ÖZIŞIK | Matrix Trading Lab", shorttitle="Matrix Sniper | GÖKTUĞ", overlay=true, max_labels_count=300, max_lines_count=300)

//══════════════════════════════════════════════════════════════════════════════
// INPUTS
//══════════════════════════════════════════════════════════════════════════════
groupTrend = "1. Trend Filter"
groupEntry = "2. Entry Engine"
groupRisk  = "3. Risk Guide"
groupDash  = "4. Dashboard"
groupAlert = "5. Alerts"

fastLen   = input.int(20, "Fast EMA Length", minval=1, group=groupTrend)
slowLen   = input.int(50, "Slow EMA Length", minval=2, group=groupTrend)
trendLen  = input.int(200, "Trend EMA Length", minval=10, group=groupTrend)

rsiLen    = input.int(14, "RSI Length", minval=2, group=groupEntry)
atrLen    = input.int(14, "ATR Length", minval=2, group=groupEntry)
pullbackAtr = input.float(0.25, "Pullback Distance ATR", step=0.05, minval=0.0, group=groupEntry)
minAtrPct = input.float(0.20, "Minimum ATR %", step=0.01, minval=0.0, group=groupEntry)

showSignals = input.bool(true, "Show Entry Signals", group=groupEntry)
showGuide   = input.bool(true, "Show TP / SL Guide", group=groupRisk)
slAtrMult   = input.float(1.0, "SL ATR Multiplier", step=0.1, minval=0.1, group=groupRisk)
tpAtrMult   = input.float(2.0, "TP ATR Multiplier", step=0.1, minval=0.1, group=groupRisk)

showDashboard = input.bool(true, "Show Dashboard", group=groupDash)
dashboardPos  = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=groupDash)

enableEntryAlerts = input.bool(true, "Enable Entry Alerts", group=groupAlert)
enableGuideAlerts = input.bool(true, "Enable TP / SL Alerts", group=groupAlert)

//══════════════════════════════════════════════════════════════════════════════
// COLORS
//══════════════════════════════════════════════════════════════════════════════
bullColor    = #10b981
bearColor    = #ef4444
neutralColor = #9ca3af
panelBg      = color.new(color.black, 15)

//══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
//══════════════════════════════════════════════════════════════════════════════
BULL = 1
BEAR = -1
NEUTRAL = 0

//══════════════════════════════════════════════════════════════════════════════
// HELPERS
//══════════════════════════════════════════════════════════════════════════════
f_dash_pos(_pos) =>
    _pos == "Top Left" ? position.top_left : _pos == "Bottom Right" ? position.bottom_right : _pos == "Bottom Left" ? position.bottom_left : position.top_right

f_bias_text(_bias) =>
    _bias == BULL ? "Bullish" : _bias == BEAR ? "Bearish" : "Neutral"

f_bias_color(_bias) =>
    _bias == BULL ? bullColor : _bias == BEAR ? bearColor : neutralColor

//══════════════════════════════════════════════════════════════════════════════
// CORE CALCULATIONS
//══════════════════════════════════════════════════════════════════════════════
fastEMA  = ta.ema(close, fastLen)
slowEMA  = ta.ema(close, slowLen)
trendEMA = ta.ema(close, trendLen)
rsiValue = ta.rsi(close, rsiLen)
atrValue = ta.atr(atrLen)

bullTrend = fastEMA > slowEMA and close > trendEMA
bearTrend = fastEMA < slowEMA and close < trendEMA

trendBias = bullTrend ? BULL : bearTrend ? BEAR : NEUTRAL

atrPct = close != 0.0 ? (atrValue / close) * 100.0 : 0.0
volatilityOk = atrPct >= minAtrPct

bullPullbackZone = low <= fastEMA + atrValue * pullbackAtr and low >= slowEMA - atrValue * pullbackAtr
bearPullbackZone = high >= fastEMA - atrValue * pullbackAtr and high <= slowEMA + atrValue * pullbackAtr

bullMomentum = rsiValue > 50 and rsiValue < 70
bearMomentum = rsiValue < 50 and rsiValue > 30

bullSignal = bullTrend and bullPullbackZone and bullMomentum and volatilityOk and close > open
bearSignal = bearTrend and bearPullbackZone and bearMomentum and volatilityOk and close < open

newBullSignal = bullSignal and not bullSignal[1]
newBearSignal = bearSignal and not bearSignal[1]

//══════════════════════════════════════════════════════════════════════════════
// SIGNAL STORAGE
//══════════════════════════════════════════════════════════════════════════════
var float lastEntry = na
var float lastSL = na
var float lastTP = na
var int lastDirection = NEUTRAL
var string lastEvent = "None"

if newBullSignal
    lastEntry := close
    lastSL := close - atrValue * slAtrMult
    lastTP := close + atrValue * tpAtrMult
    lastDirection := BULL
    lastEvent := "Bullish Sniper Entry"

if newBearSignal
    lastEntry := close
    lastSL := close + atrValue * slAtrMult
    lastTP := close - atrValue * tpAtrMult
    lastDirection := BEAR
    lastEvent := "Bearish Sniper Entry"

//══════════════════════════════════════════════════════════════════════════════
// VISUALS
//══════════════════════════════════════════════════════════════════════════════
plot(fastEMA, "Fast EMA", color=color.new(bullColor, 0), linewidth=2)
plot(slowEMA, "Slow EMA", color=color.new(color.white, 35), linewidth=2)
plot(trendEMA, "Trend EMA", color=color.new(#3b82f6, 0), linewidth=2)

plotshape(showSignals and newBullSignal, title="Bullish Sniper", style=shape.labelup, location=location.belowbar, color=color.new(color.black, 100), text="BUY", textcolor=bullColor, size=size.small)
plotshape(showSignals and newBearSignal, title="Bearish Sniper", style=shape.labeldown, location=location.abovebar, color=color.new(color.black, 100), text="SELL", textcolor=bearColor, size=size.small)

var line slLine = na
var line tpLine = na
var label slLabel = na
var label tpLabel = na

if showGuide and newBullSignal
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(slLabel)
        label.delete(slLabel)
    if not na(tpLabel)
        label.delete(tpLabel)

    slLine := line.new(bar_index, lastSL, bar_index + 20, lastSL, xloc=xloc.bar_index, color=color.new(bearColor, 0), style=line.style_dashed, width=1)
    tpLine := line.new(bar_index, lastTP, bar_index + 20, lastTP, xloc=xloc.bar_index, color=color.new(bullColor, 0), style=line.style_dashed, width=1)
    slLabel := label.new(bar_index + 1, lastSL, "SL", xloc=xloc.bar_index, style=label.style_label_left, textcolor=bearColor, color=color.new(color.black, 100), size=size.tiny)
    tpLabel := label.new(bar_index + 1, lastTP, "TP", xloc=xloc.bar_index, style=label.style_label_left, textcolor=bullColor, color=color.new(color.black, 100), size=size.tiny)

if showGuide and newBearSignal
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(slLabel)
        label.delete(slLabel)
    if not na(tpLabel)
        label.delete(tpLabel)

    slLine := line.new(bar_index, lastSL, bar_index + 20, lastSL, xloc=xloc.bar_index, color=color.new(bearColor, 0), style=line.style_dashed, width=1)
    tpLine := line.new(bar_index, lastTP, bar_index + 20, lastTP, xloc=xloc.bar_index, color=color.new(bullColor, 0), style=line.style_dashed, width=1)
    slLabel := label.new(bar_index + 1, lastSL, "SL", xloc=xloc.bar_index, style=label.style_label_left, textcolor=bearColor, color=color.new(color.black, 100), size=size.tiny)
    tpLabel := label.new(bar_index + 1, lastTP, "TP", xloc=xloc.bar_index, style=label.style_label_left, textcolor=bullColor, color=color.new(color.black, 100), size=size.tiny)

//══════════════════════════════════════════════════════════════════════════════
// DASHBOARD
//══════════════════════════════════════════════════════════════════════════════
var table dash = table.new(position.top_right, 2, 8, border_width=1)

if barstate.islast
    table.set_position(dash, f_dash_pos(dashboardPos))

    if showDashboard
        string trendText = f_bias_text(trendBias)
        color trendCol = f_bias_color(trendBias)
        string signalText = newBullSignal ? "BUY" : newBearSignal ? "SELL" : "None"
        color signalCol = newBullSignal ? bullColor : newBearSignal ? bearColor : neutralColor
        string volatilityText = volatilityOk ? "Valid" : "Low"
        color volatilityCol = volatilityOk ? color.white : neutralColor

        table.cell(dash, 0, 0, "Matrix Trading Lab", text_color=color.white, bgcolor=color.new(color.black, 0))
        table.cell(dash, 1, 0, "Sniper Entry", text_color=color.white, bgcolor=color.new(color.black, 0))

        table.cell(dash, 0, 1, "Trend Bias", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 1, trendText, text_color=trendCol, bgcolor=panelBg)

        table.cell(dash, 0, 2, "RSI", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 2, str.tostring(rsiValue, format.mintick), text_color=color.white, bgcolor=panelBg)

        table.cell(dash, 0, 3, "ATR %", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 3, str.tostring(atrPct, format.mintick), text_color=color.white, bgcolor=panelBg)

        table.cell(dash, 0, 4, "Volatility", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 4, volatilityText, text_color=volatilityCol, bgcolor=panelBg)

        table.cell(dash, 0, 5, "Signal", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 5, signalText, text_color=signalCol, bgcolor=panelBg)

        table.cell(dash, 0, 6, "Last Entry", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 6, na(lastEntry) ? "N/A" : str.tostring(lastEntry, format.mintick), text_color=color.white, bgcolor=panelBg)

        table.cell(dash, 0, 7, "Last Event", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 7, lastEvent, text_color=color.white, bgcolor=panelBg)
    else
        for r = 0 to 7
            table.cell(dash, 0, r, "", bgcolor=color.new(color.black, 100))
            table.cell(dash, 1, r, "", bgcolor=color.new(color.black, 100))

//══════════════════════════════════════════════════════════════════════════════
// ALERTS
//══════════════════════════════════════════════════════════════════════════════
alertcondition(enableEntryAlerts and newBullSignal, "Bullish Sniper Entry", "Matrix Sniper Entry System: Bullish sniper entry detected")
alertcondition(enableEntryAlerts and newBearSignal, "Bearish Sniper Entry", "Matrix Sniper Entry System: Bearish sniper entry detected")

alertcondition(enableGuideAlerts and newBullSignal, "Bullish TP/SL Guide", "Matrix Sniper Entry System: Bullish TP and SL guide created")
alertcondition(enableGuideAlerts and newBearSignal, "Bearish TP/SL Guide", "Matrix Sniper Entry System: Bearish TP and SL guide created")
