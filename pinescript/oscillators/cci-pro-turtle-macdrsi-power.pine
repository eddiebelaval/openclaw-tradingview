//@version=6
// ============================================================================
// SHK CCI Pro + Turtle Strength + MACD/RSI Power - Clean Chart Edition
// ============================================================================
indicator(
     title="CCI Pro + Turtle + MACD/RSI Power",
     shorttitle="CCI+Turtle+Power",
     format=format.price,
     precision=2,
     overlay=false
)

// ============================================================================
// CCI SETTINGS
// ============================================================================
length = input.int(20, minval=1, title="CCI Length", group="CCI Settings")
src = input(hlc3, title="Source", group="CCI Settings")
emaLen = input.int(14, title="EMA Length", group="CCI Settings")

// CCI Features
showDivergence = input.bool(true, "Show Divergences", group="CCI Features")
showTrendStrength = input.bool(true, "Show Trend Strength Bars", group="CCI Features")
showZeroCrosses = input.bool(true, "Show Zero Line Crosses", group="CCI Features")
showExtremeLevels = input.bool(true, "Highlight Extreme Zones", group="CCI Features")

// Divergence Settings
divLookback = input.int(5, "Divergence Lookback", minval=1, maxval=20, group="Divergence Settings")
divThreshold = input.float(10, "Divergence Threshold", minval=5, maxval=50, group="Divergence Settings")

// Custom Levels
customOB = input.int(200, "Overbought Level", group="CCI Levels")
customOS = input.int(-200, "Oversold Level", group="CCI Levels")
level100 = input.int(100, "Upper Level", group="CCI Levels")
levelNeg100 = input.int(-100, "Lower Level", group="CCI Levels")

// ============================================================================
// TURTLE STRENGTH SETTINGS (BACKEND ONLY)
// ============================================================================
turtleEnable = input.bool(true, "Enable Turtle Strength Filter", group="🐢 Turtle Strength")
turtleShort = input.int(20, "Short Channel (Entry)", minval=5, group="🐢 Turtle Strength")
turtleLong = input.int(55, "Long Channel (Entry)", minval=10, group="🐢 Turtle Strength")
turtleExit = input.int(10, "Exit Channel", minval=5, group="🐢 Turtle Strength")
atrLength = input.int(14, "ATR Length", group="🐢 Turtle Strength")
atrMultiplier = input.float(2.0, "ATR Multiplier", minval=0.5, step=0.5, group="🐢 Turtle Strength")

// Turtle Signal Requirements
useCCIFilter = input.bool(true, "Require CCI > 0 for Long", group="🐢 Turtle Strength")
requireCCITrend = input.bool(true, "Require CCI > EMA Alignment", group="🐢 Turtle Strength")
enhanceStrength = input.bool(true, "Enhance CCI Strength with Turtle", group="🐢 Turtle Strength")

// ============================================================================
// MACD POWER SETTINGS (BACKEND ONLY)
// ============================================================================
macdEnable = input.bool(true, "Enable MACD Power Filter", group="📊 MACD Power")
macdFast = input.int(12, "MACD Fast Length", minval=1, group="📊 MACD Power")
macdSlow = input.int(26, "MACD Slow Length", minval=1, group="📊 MACD Power")
macdSignal = input.int(9, "MACD Signal Length", minval=1, group="📊 MACD Power")
macdSrc = input(close, "MACD Source", group="📊 MACD Power")

// MACD Requirements
requireMACDAlign = input.bool(true, "Require MACD Histogram Alignment", group="📊 MACD Power")
requireMACDCross = input.bool(false, "Require Recent MACD Cross (5 bars)", group="📊 MACD Power")
macdHistThreshold = input.float(0.0, "MACD Histogram Min Threshold", step=0.01, group="📊 MACD Power")

// ============================================================================
// RSI POWER SETTINGS (BACKEND ONLY)
// ============================================================================
rsiEnable = input.bool(true, "Enable RSI Power Filter", group="⚡ RSI Power")
rsiLength = input.int(14, "RSI Length", minval=1, group="⚡ RSI Power")
rsiSrc = input(close, "RSI Source", group="⚡ RSI Power")
rsiOverbought = input.int(70, "RSI Overbought", minval=50, maxval=100, group="⚡ RSI Power")
rsiOversold = input.int(30, "RSI Oversold", minval=0, maxval=50, group="⚡ RSI Power")

// RSI Requirements
requireRSIZone = input.bool(true, "Require RSI in Correct Zone", group="⚡ RSI Power")
rsiExtremeBoost = input.bool(true, "Boost on RSI Extremes (>80/<20)", group="⚡ RSI Power")
rsiMidlineFilter = input.bool(true, "Filter: RSI > 50 for Bull / < 50 for Bear", group="⚡ RSI Power")

// ============================================================================
// POWER COMBINATION SETTINGS
// ============================================================================
powerMode = input.string("All Confirm", "Power Mode", 
     options=["All Confirm", "Majority (2/3)", "Any Confirm"], 
     tooltip="All Confirm = CCI + Turtle + MACD + RSI all aligned\nMajority = At least 2 out of 3 filters confirm\nAny Confirm = At least 1 filter confirms",
     group="🔥 Power Combination")

showPowerSignals = input.bool(true, "Show Power Confluence Signals", group="🔥 Power Combination")
powerBoostStrength = input.bool(true, "Multiply Strength on Perfect Confluence", group="🔥 Power Combination")

// ============================================================================
// TABLE SETTINGS
// ============================================================================
showTable = input.bool(true, "Show Info Table", group="Table Settings")
tablePosition = input.string("Top Right", "Table Position", 
     options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", 
              "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], 
     group="Table Settings")
showPowerMetrics = input.bool(true, "Show MACD/RSI in Table", group="Table Settings")

// ============================================================================
// CCI CALCULATION
// ============================================================================
basis = ta.sma(src, length)
cci = (src - basis) / (0.015 * ta.dev(src, length))
emaCCI = ta.ema(cci, emaLen)

// ============================================================================
// MACD BACKEND CALCULATION (NOT PLOTTED)
// ============================================================================
[macdLine, signalLine, histLine] = ta.macd(macdSrc, macdFast, macdSlow, macdSignal)

// MACD Conditions
macdBullish = macdLine > signalLine
macdBearish = macdLine < signalLine
macdHistBull = histLine > macdHistThreshold
macdHistBear = histLine < -macdHistThreshold
macdCrossUp = ta.crossover(macdLine, signalLine)
macdCrossDown = ta.crossunder(macdLine, signalLine)
macdRecentCrossUp = ta.barssince(macdCrossUp) <= 5
macdRecentCrossDown = ta.barssince(macdCrossDown) <= 5

// MACD Strength (0-100)
macdStrength = math.abs(histLine) / ta.stdev(histLine, 50) * 20
macdMomentum = macdLine > 0 ? 1 : -1

// MACD Confirmation Logic
macdBullConfirm = macdEnable ? (
     (requireMACDAlign ? macdHistBull : true) and
     (requireMACDCross ? macdRecentCrossUp : macdBullish)
) : true

macdBearConfirm = macdEnable ? (
     (requireMACDAlign ? macdHistBear : true) and
     (requireMACDCross ? macdRecentCrossDown : macdBearish)
) : true

// ============================================================================
// RSI BACKEND CALCULATION (NOT PLOTTED)
// ============================================================================
rsi = ta.rsi(rsiSrc, rsiLength)

// RSI Conditions
rsiBullish = rsi > 50
rsiBearish = rsi < 50
rsiInOverbought = rsi > rsiOverbought
rsiInOversold = rsi < rsiOversold
rsiExtremeBull = rsi > 80
rsiExtremeBear = rsi < 20

// RSI Divergence (simplified)
rsiDivBull = rsi < 40 and rsi > rsi[1] and close < close[1]
rsiDivBear = rsi > 60 and rsi < rsi[1] and close > close[1]

// RSI Confirmation Logic
rsiBullConfirm = rsiEnable ? (
     (requireRSIZone ? (rsiInOversold or rsiBullish) : true) and
     (rsiMidlineFilter ? rsiBullish : true)
) : true

rsiBearConfirm = rsiEnable ? (
     (requireRSIZone ? (rsiInOverbought or rsiBearish) : true) and
     (rsiMidlineFilter ? rsiBearish : true)
) : true

// RSI Strength Boost
rsiBoost = rsiExtremeBoost ? (rsiExtremeBull ? 1.3 : rsiExtremeBear ? 1.3 : 1.0) : 1.0

// ============================================================================
// TURTLE BACKEND CALCULATION (NOT PLOTTED)
// ============================================================================
atr = ta.atr(atrLength)

// Donchian Channels
upperShort = ta.highest(high, turtleShort)
lowerShort = ta.lowest(low, turtleShort)
upperLong = ta.highest(high, turtleLong)
lowerLong = ta.lowest(low, turtleLong)
exitUpper = ta.highest(high, turtleExit)
exitLower = ta.lowest(low, turtleExit)

// Turtle Breakout Detection
longBreakoutShort = ta.crossover(close, upperShort[1])
shortBreakoutShort = ta.crossunder(close, lowerShort[1])
longBreakoutLong = ta.crossover(close, upperLong[1])
shortBreakoutLong = ta.crossunder(close, lowerLong[1])

anyLongBreakout = longBreakoutShort or longBreakoutLong
anyShortBreakout = shortBreakoutShort or shortBreakoutLong

// Exit Signals
longExit = ta.crossunder(close, exitLower[1])
shortExit = ta.crossover(close, exitUpper[1])

// Price position in channel (0-100%)
bullPosition = ((close - lowerLong) / (upperLong - lowerLong)) * 100
bearPosition = ((upperLong - close) / (upperLong - lowerLong)) * 100

// ============================================================================
// POWER CONFLUENCE SYSTEM
// ============================================================================

// Individual confirmations
cciTrendBull = requireCCITrend ? cci >= emaCCI : true
cciTrendBear = requireCCITrend ? cci < emaCCI : true

turtleBullConfirm = turtleEnable and (anyLongBreakout or bullPosition > 70)
turtleBearConfirm = turtleEnable and (anyShortBreakout or bearPosition > 70)

// Count confirmations for each direction
bullConfirmCount = (turtleBullConfirm ? 1 : 0) + (macdBullConfirm ? 1 : 0) + (rsiBullConfirm ? 1 : 0)
bearConfirmCount = (turtleBearConfirm ? 1 : 0) + (macdBearConfirm ? 1 : 0) + (rsiBearConfirm ? 1 : 0)

// Apply power mode logic
powerBullConfluence = switch powerMode
    "All Confirm" => bullConfirmCount == 3
    "Majority (2/3)" => bullConfirmCount >= 2
    "Any Confirm" => bullConfirmCount >= 1
    => bullConfirmCount >= 2

powerBearConfluence = switch powerMode
    "All Confirm" => bearConfirmCount == 3
    "Majority (2/3)" => bearConfirmCount >= 2
    "Any Confirm" => bearConfirmCount >= 1
    => bearConfirmCount >= 2

// ============================================================================
// ENHANCED STRENGTH CALCULATION WITH ALL INDICATORS
// ============================================================================

// Base CCI strength
baseCCIStrength = math.abs(cci) / 3

// Turtle momentum factor
turtleMomentum = turtleEnable ? (
     anyLongBreakout and cci > 0 ? 1.5 : 
     anyShortBreakout and cci < 0 ? 1.5 : 
     bullPosition > 80 and cci > 0 ? 1.2 : 
     bearPosition > 80 and cci < 0 ? 1.2 : 1.0
) : 1.0

// MACD momentum factor
macdMomentumFactor = macdEnable ? math.min(1.0 + (macdStrength / 100), 1.4) : 1.0

// Combined strength
combinedStrength = baseCCIStrength * turtleMomentum * macdMomentumFactor * rsiBoost

// Perfect confluence multiplier
perfectConfluenceMultiplier = powerBoostStrength and (bullConfirmCount == 3 or bearConfirmCount == 3) ? 1.5 : 1.0

// Final enhanced strength
enhancedStrength = enhanceStrength ? combinedStrength * perfectConfluenceMultiplier : baseCCIStrength

// ============================================================================
// FINAL SIGNAL CLASSIFICATION
// ============================================================================

// Standard signals (from original)
strongBullish = (cci > level100 and cci >= emaCCI) or (turtleBullConfirm and cci > 0 and cciTrendBull)
strongBearish = (cci < levelNeg100 and cci < emaCCI) or (turtleBearConfirm and cci < 0 and cciTrendBear)

// Ultra signals (CCI + Turtle aligned)
ultraBullish = turtleEnable and anyLongBreakout and cci > level100 and cci >= emaCCI
ultraBearish = turtleEnable and anyShortBreakout and cci < levelNeg100 and cci < emaCCI

// POWER signals (all systems aligned)
powerBullish = powerBullConfluence and cci > 0 and cci >= emaCCI
powerBearish = powerBearConfluence and cci < 0 and cci < emaCCI

// MEGA signals (everything perfect)
megaBullish = ultraBullish and powerBullConfluence and bullConfirmCount == 3
megaBearish = ultraBearish and powerBearConfluence and bearConfirmCount == 3

// ============================================================================
// CCI DIVERGENCE DETECTION
// ============================================================================
pivotHigh = ta.pivothigh(cci, divLookback, divLookback)
pivotLow = ta.pivotlow(cci, divLookback, divLookback)
priceHigh = ta.pivothigh(high, divLookback, divLookback)
priceLow = ta.pivotlow(low, divLookback, divLookback)

// Bullish Divergence
var float lastCCILow = na
var float lastPriceLow = na
var int lastLowBar = na

if not na(pivotLow)
    if not na(lastCCILow)
        if priceLow < lastPriceLow and pivotLow > lastCCILow and (pivotLow - lastCCILow) > divThreshold
            if showDivergence
                line.new(lastLowBar, lastCCILow, bar_index[divLookback], pivotLow, 
                     color=color.new(color.lime, 0), width=2, style=line.style_solid)
                label.new(bar_index[divLookback], pivotLow, "Bull Div", 
                     style=label.style_label_up, color=color.new(color.lime, 20), 
                     textcolor=color.white, size=size.small)
    
    lastCCILow := pivotLow
    lastPriceLow := priceLow
    lastLowBar := bar_index[divLookback]

// Bearish Divergence
var float lastCCIHigh = na
var float lastPriceHigh = na
var int lastHighBar = na

if not na(pivotHigh)
    if not na(lastCCIHigh)
        if priceHigh > lastPriceHigh and pivotHigh < lastCCIHigh and (lastCCIHigh - pivotHigh) > divThreshold
            if showDivergence
                line.new(lastHighBar, lastCCIHigh, bar_index[divLookback], pivotHigh, 
                     color=color.new(color.red, 0), width=2, style=line.style_solid)
                label.new(bar_index[divLookback], pivotHigh, "Bear Div", 
                     style=label.style_label_down, color=color.new(color.red, 20), 
                     textcolor=color.white, size=size.small)
    
    lastCCIHigh := pivotHigh
    lastPriceHigh := priceHigh
    lastHighBar := bar_index[divLookback]

// ============================================================================
// ZERO LINE CROSSES
// ============================================================================
bullishCross = ta.crossover(cci, 0)
bearishCross = ta.crossunder(cci, 0)

plotshape(showZeroCrosses and bullishCross, "Bullish Cross", 
     style=shape.triangleup, location=location.bottom, 
     color=color.new(color.lime, 0), size=size.tiny)

plotshape(showZeroCrosses and bearishCross, "Bearish Cross", 
     style=shape.triangledown, location=location.top, 
     color=color.new(color.red, 0), size=size.tiny)

// ============================================================================
// POWER CONFLUENCE SIGNALS - REMOVED (MEGA & POWER SIGNALS)
// ============================================================================
// The following plotshape commands have been removed as requested:
// - MEGA BULL / MEGA BEAR (diamond shapes)
// - POWER BULL / POWER BEAR (circle shapes)

// ============================================================================
// ENHANCED CCI PLOTS
// ============================================================================
cciColor = cci >= emaCCI and cci > 0 ? color.new(color.lime, 0) : cci >= emaCCI and cci <= 0 ? color.new(color.lime, 50) : cci < emaCCI and cci < 0 ? color.new(color.red, 0) : color.new(color.red, 50)

plot(cci, title="CCI", color=cciColor, linewidth=3)
plot(emaCCI, title="CCI EMA", color=color.yellow, linewidth=2)

// Enhanced histogram with all power factors
histColor = cci > 0 ? (cci > level100 ? color.new(color.lime, 30) : color.new(color.lime, 70)) : (cci < levelNeg100 ? color.new(color.red, 30) : color.new(color.red, 70))

plot(showTrendStrength ? cci : na, title="Strength", 
     style=plot.style_histogram, color=histColor, linewidth=1)

// ============================================================================
// CCI LEVELS
// ============================================================================
upper200 = hline(customOB, "Overbought", color=color.new(color.red, 30), linestyle=hline.style_dashed, linewidth=2)
upper100 = hline(level100, "Upper", color=color.new(#787B86, 50), linestyle=hline.style_dashed)
middle0  = hline(0, "Zero", color=color.new(color.gray, 30), linewidth=2)
lower100 = hline(levelNeg100, "Lower", color=color.new(#787B86, 50), linestyle=hline.style_dashed)
lower200 = hline(customOS, "Oversold", color=color.new(color.green, 30), linestyle=hline.style_dashed, linewidth=2)

fill(upper100, lower100, color=color.new(#2196F3, 92), title="Normal Zone")

// Enhanced extreme zones - single bgcolor with conditional color
bgcolor(showExtremeLevels ? (cci > 0 and (cci > level100 or megaBullish or ultraBullish or strongBullish) ? color.new(color.lime, 92) : cci < 0 and (cci < levelNeg100 or megaBearish or ultraBearish or strongBearish) ? color.new(color.red, 92) : na) : na, title="Strong Zones")

// ============================================================================
// INFO TABLE WITH ALL POWER METRICS - REDUCED SIZE BY 20%
// ============================================================================
if showTable and barstate.islast
    pos = switch tablePosition
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right" => position.bottom_right
        => position.top_right
    
    tableRows = showPowerMetrics ? 9 : 6
    var table infoTable = table.new(pos, 2, tableRows, border_width=1, bgcolor=color.new(#0A0A0A, 0), frame_color=color.gray)
    
    table.clear(infoTable, 0, 0, 1, tableRows - 1)
    
    // Headers - REDUCED SIZE
    table.cell(infoTable, 0, 0, "INDICATOR", bgcolor=color.new(#0A0A0A, 0), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, "STATUS", bgcolor=color.new(#0A0A0A, 0), text_color=color.white, text_size=size.small)
    
    currentRow = 1
    
    // CCI + EMA Combined Status
    table.cell(infoTable, 0, currentRow, "CCI + EMA", text_color=color.white, text_size=size.small)
    
    cciEmaText = cci >= emaCCI and cci > 0 ? "BULLISH ✓" : cci >= emaCCI and cci <= 0 ? "BULL WEAK" : cci < emaCCI and cci < 0 ? "BEARISH ✓" : "BEAR WEAK"
    cciEmaColor = cci >= emaCCI and cci > 0 ? color.lime : cci >= emaCCI and cci <= 0 ? color.new(color.lime, 50) : cci < emaCCI and cci < 0 ? color.red : color.new(color.red, 50)
    
    table.cell(infoTable, 1, currentRow, cciEmaText, text_color=cciEmaColor, text_size=size.small)
    currentRow += 1
    
    // CCI Trend (Enhanced)
    trendText = (megaBullish or ultraBullish or powerBullish) ? "STRONG↑↑" : strongBullish ? "BULL↑" : cci > 0 ? "WEAK↑" : (megaBearish or ultraBearish or powerBearish) ? "STRONG↓↓" : strongBearish ? "BEAR↓" : "WEAK↓"
    
    trendColor = (megaBullish or ultraBullish or powerBullish) ? color.new(color.lime, 0) : strongBullish ? color.new(color.lime, 40) : cci > 0 ? color.new(color.lime, 70) : (megaBearish or ultraBearish or powerBearish) ? color.new(color.red, 0) : strongBearish ? color.new(color.red, 40) : color.new(color.red, 70)
    
    table.cell(infoTable, 0, currentRow, "Trend", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, currentRow, trendText, text_color=trendColor, text_size=size.small)
    currentRow += 1
    
    // CCI Zone
    posText = cci > customOB ? "EXTR OB" : cci < customOS ? "EXTR OS" : cci > level100 ? "OVERBOUGHT" : cci < levelNeg100 ? "OVERSOLD" : "NORMAL"
    posColor = cci > customOB ? color.new(color.red, 0) : cci < customOS ? color.new(color.lime, 0) : cci > level100 ? color.new(color.orange, 0) : cci < levelNeg100 ? color.new(color.aqua, 0) : color.gray
    
    table.cell(infoTable, 0, currentRow, "Zone", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, currentRow, posText, text_color=posColor, text_size=size.small)
    currentRow += 1
    
    // Power Strength
    table.cell(infoTable, 0, currentRow, "🔥 Strength", text_color=color.white, text_size=size.small)
    
    strengthPercent = math.round(enhancedStrength, 1)
    strengthText = str.tostring(strengthPercent) + "%"
    strengthColor = enhancedStrength > 150 ? color.aqua : enhancedStrength > 100 ? color.lime : enhancedStrength > 50 ? color.yellow : color.gray
    
    table.cell(infoTable, 1, currentRow, strengthText, text_color=strengthColor, text_size=size.small)
    currentRow += 1
    
    // Turtle Confirmation
    table.cell(infoTable, 0, currentRow, "🐢 Turtle", text_color=color.white, text_size=size.small)
    
    turtleText = turtleBullConfirm ? "BULL ✓" : turtleBearConfirm ? "BEAR ✓" : "NEUTRAL"
    turtleColor = turtleBullConfirm ? color.lime : turtleBearConfirm ? color.red : color.gray
    
    table.cell(infoTable, 1, currentRow, turtleText, text_color=turtleColor, text_size=size.small)
    currentRow += 1
    
    if showPowerMetrics
        // Confluence Score
        table.cell(infoTable, 0, currentRow, "⚡ Confluence", text_color=color.white, text_size=size.small)
        
        confluenceCount = cci > 0 ? bullConfirmCount : bearConfirmCount
        confluenceText = str.tostring(confluenceCount) + "/3"
        confluenceColor = confluenceCount == 3 ? color.aqua : confluenceCount == 2 ? color.lime : confluenceCount == 1 ? color.yellow : color.gray
        
        table.cell(infoTable, 1, currentRow, confluenceText, text_color=confluenceColor, text_size=size.small)
        currentRow += 1
        
        // MACD Status
        table.cell(infoTable, 0, currentRow, "📊 MACD", text_color=color.white, text_size=size.small)
        
        macdText = macdBullConfirm ? "BULL ✓" : macdBearConfirm ? "BEAR ✓" : "NEUTRAL"
        macdColor = macdBullConfirm ? color.lime : macdBearConfirm ? color.red : color.gray
        
        table.cell(infoTable, 1, currentRow, macdText, text_color=macdColor, text_size=size.small)
        currentRow += 1
        
        // RSI Status
        table.cell(infoTable, 0, currentRow, "⚡ RSI", text_color=color.white, text_size=size.small)
        
        rsiText = rsiBullConfirm ? "BULL ✓" : rsiBearConfirm ? "BEAR ✓" : "NEUTRAL"
        rsiColor = rsiBullConfirm ? color.lime : rsiBearConfirm ? color.red : color.gray
        
        table.cell(infoTable, 1, currentRow, rsiText, text_color=rsiColor, text_size=size.small)
        currentRow += 1

// ============================================================================
// ENHANCED ALERTS WITH POWER SIGNALS - READY FOR LIVE CHART
// ============================================================================
alertcondition(megaBullish, "🔥🔥🔥 MEGA BULLISH", "MEGA BULLISH: Perfect alignment of ALL indicators!")
alertcondition(megaBearish, "🔥🔥🔥 MEGA BEARISH", "MEGA BEARISH: Perfect alignment of ALL indicators!")
alertcondition(powerBullish and not megaBullish, "🔥 Power Bullish", "POWER BULLISH: Strong multi-indicator confluence")
alertcondition(powerBearish and not megaBearish, "🔥 Power Bearish", "POWER BEARISH: Strong multi-indicator confluence")
alertcondition(ultraBullish, "⚡ Ultra Bullish", "ULTRA BULLISH: CCI + Turtle perfect alignment")
alertcondition(ultraBearish, "⚡ Ultra Bearish", "ULTRA BEARISH: CCI + Turtle perfect alignment")
alertcondition(strongBullish and macdBullConfirm and rsiBullConfirm, "Strong Bull + MACD/RSI", "Strong bullish with MACD and RSI confirmation")
alertcondition(strongBearish and macdBearConfirm and rsiBearConfirm, "Strong Bear + MACD/RSI", "Strong bearish with MACD and RSI confirmation")
alertcondition(bullishCross and powerBullConfluence, "CCI Cross + Power", "CCI bullish cross with power confluence")
alertcondition(bearishCross and powerBearConfluence, "CCI Cross + Power Bear", "CCI bearish cross with power confluence")
alertcondition(macdCrossUp and cci > 0 and rsiBullConfirm, "MACD Cross + CCI/RSI", "MACD bullish cross with CCI and RSI confirmation")
alertcondition(macdCrossDown and cci < 0 and rsiBearConfirm, "MACD Cross + CCI/RSI Bear", "MACD bearish cross with CCI and RSI confirmation")
alertcondition(rsiExtremeBull and cci > level100, "RSI Extreme Bull + CCI", "RSI extreme oversold bounce with CCI strength")
alertcondition(rsiExtremeBear and cci < levelNeg100, "RSI Extreme Bear + CCI", "RSI extreme overbought drop with CCI strength")

// ============================================================================
// ADDITIONAL OVERBOUGHT/OVERSOLD ALERTS (NEW)
// ============================================================================
// Alert when CCI enters overbought zone
alertcondition(ta.cross(cci, customOB), "🔴 CCI Overbought Alert", "CCI crossed into OVERBOUGHT zone (>200)")

// Alert when CCI enters oversold zone
alertcondition(ta.cross(customOS, cci), "🟢 CCI Oversold Alert", "CCI crossed into OVERSOLD zone (<-200)")

// Alert when CCI exits overbought (coming back down)
alertcondition(ta.crossunder(cci, customOB), "↓ Exit Overbought", "CCI exiting overbought zone - potential reversal down")

// Alert when CCI exits oversold (coming back up)
alertcondition(ta.crossover(cci, customOS), "↑ Exit Oversold", "CCI exiting oversold zone - potential reversal up")

// Alert for upper/lower level crosses
alertcondition(ta.crossover(cci, level100), "⬆️ CCI Above 100", "CCI crossed above +100 - strong bullish momentum")
alertcondition(ta.crossunder(cci, levelNeg100), "⬇️ CCI Below -100", "CCI crossed below -100 - strong bearish momentum")
