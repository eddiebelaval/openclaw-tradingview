//@version=6
indicator('RSI Combine PRO (Trend + Momentum + Anti-Sideway)', overlay = false)

// ===== INPUT =====
rsiLength = input.int(14, title = 'RSI Length')
wmaLength = input.int(48, title = 'WMA Length')
emaLength = input.int(9, title = 'EMA Length')
emaDivLen = input.int(9, title = 'EMA RSI for Divergence')
pivotLen  = input.int(5, title = 'Pivot Length')

// ===== CALCULATION =====
rsiValue = ta.rsi(close, rsiLength)
wmaOnRsi = ta.wma(rsiValue, wmaLength)
emaOnRsi = ta.ema(rsiValue, emaLength)
emaRsiDiv = ta.ema(rsiValue, emaDivLen)

// ===== PLOT =====
plot(rsiValue, title='RSI', color=color.gray, linewidth=1)
plot(wmaOnRsi, title='WMA on RSI', color=color.red, linewidth=2)
plot(emaOnRsi, title='EMA on RSI', color=color.black, linewidth=1)
plot(emaRsiDiv, title='EMA RSI (Div)', color=color.black, linewidth=1)

// ===== OVERBOUGHT ZONES =====
hline(80, 'OB 80', color=color.gray)
hline(75, 'OB 75', color=color.new(color.gray, 30))
hline(67, 'OB 67', color=color.new(color.gray, 60))

// ===== OVERSOLD ZONES =====
hline(20, 'OS 20', color=color.gray)
hline(25, 'OS 25', color=color.new(color.gray, 30))
hline(33, 'OS 33', color=color.new(color.gray, 60))

hline(50, 'Midline', color=color.gray)

// ===== FILTERS =====

// 1. Trend filter
trendBull = emaOnRsi > 60
trendBear = emaOnRsi < 40

// 2. Momentum (độ dốc RSI)
slopeLen = input.int(3, title="Slope Length")
rsiSlope = ta.sma(rsiValue - rsiValue[1], slopeLen)
strongBullMomentum = rsiSlope > 0.5
strongBearMomentum = rsiSlope < -0.5

// 3. Sideway filter (được thêm lại)
rsiRange = ta.highest(rsiValue, 10) - ta.lowest(rsiValue, 10)
notSideway = rsiRange > 10

// ===== ENTRY SIGNALS =====
bullSignal = ta.crossover(rsiValue, wmaOnRsi) and
             rsiValue > emaOnRsi and
             trendBull and
             strongBullMomentum and
             notSideway

bearSignal = ta.crossunder(rsiValue, wmaOnRsi) and
             rsiValue < emaOnRsi and
             trendBear and
             strongBearMomentum and
             notSideway

plotshape(bullSignal, title='Buy', location=location.bottom, color=color.green, style=shape.triangleup, size=size.small)
plotshape(bearSignal, title='Sell', location=location.top, color=color.red, style=shape.triangledown, size=size.small)

// ===== DIVERGENCE (EMA RSI) =====
priceLow  = ta.pivotlow(low, pivotLen, pivotLen)
priceHigh = ta.pivothigh(high, pivotLen, pivotLen)

emaLow  = ta.pivotlow(emaRsiDiv, pivotLen, pivotLen)
emaHigh = ta.pivothigh(emaRsiDiv, pivotLen, pivotLen)

// Bullish divergence → thoát SELL
bullDiv = not na(priceLow) and not na(emaLow) and
          low[pivotLen] < low[pivotLen * 2] and
          emaRsiDiv[pivotLen] > emaRsiDiv[pivotLen * 2]

// Bearish divergence → thoát BUY
bearDiv = not na(priceHigh) and not na(emaHigh) and
          high[pivotLen] > high[pivotLen * 2] and
          emaRsiDiv[pivotLen] < emaRsiDiv[pivotLen * 2]

// ===== EXIT SIGNALS =====
exitBuy  = bearDiv
exitSell = bullDiv

plotshape(exitBuy, title='Exit Buy', location=location.top, color=color.yellow, style=shape.xcross, size=size.small)
plotshape(exitSell, title='Exit Sell', location=location.bottom, color=color.aqua, style=shape.xcross, size=size.small)
