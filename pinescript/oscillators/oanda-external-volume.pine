//@version=6
indicator("AggVol Multi-Source", shorttitle="AggVol", overlay=false)

// --- INPUTS ---
s1 = input.string("OANDA", "Source 1")
s2 = input.string("SAXO", "Source 2")
s3 = input.string("FXCM", "Source 3")
maLength = input.int(20, "Volume MA")

// --- DATA COLLECTION WITH ERROR HANDLING ---
// We use 'ignore_invalid_symbol = true' so if one broker doesn't have the pair, the script keeps running.
v1 = request.security(s1 + ":" + syminfo.ticker, timeframe.period, volume, ignore_invalid_symbol = true)
v2 = request.security(s2 + ":" + syminfo.ticker, timeframe.period, volume, ignore_invalid_symbol = true)
v3 = request.security(s3 + ":" + syminfo.ticker, timeframe.period, volume, ignore_invalid_symbol = true)

// Get price action from OANDA to determine bar color
[extClose, extOpen] = request.security("OANDA" + ":" + syminfo.ticker, timeframe.period, [close, open], ignore_invalid_symbol = true)

// --- AGGREGATION ---
// nz() turns "n/a" into 0 so the math still works
totalVol = nz(v1) + nz(v2) + nz(v3)
avgVol   = ta.sma(totalVol, maLength)

// --- COLOR LOGIC ---
volColor = nz(extClose) >= nz(extOpen) ? color.new(#26a69a, 50) : color.new(#ef5350, 50)

// --- PLOTTING ---
plot(totalVol, title="Aggregate Volume", style=plot.style_columns, color=volColor)
plot(avgVol, title="Volume MA", color=color.new(color.white, 20), linewidth=2)
