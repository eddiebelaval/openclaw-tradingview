// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("Institutional Flow Oscillator", shorttitle="IFO", overlay=false, format=format.price, precision=2)

// --- Inputs ---
grp_calc = "Calculation Settings"
rsiLen    = input.int(14, "RSI Length", minval=1, group=grp_calc, tooltip="Period for the Volume-Weighted RSI calculation.")
vLen      = input.int(20, "Volume Normalization Length", minval=1, group=grp_calc, tooltip="Used to calculate the average volume for identifying institutional activity.")
smoothLen = input.int(5, "Smoothing Length", minval=1, group=grp_calc, tooltip="Smoothing period for the final oscillator line.")

grp_style = "Style Settings"
bullColor = input.color(#089981, "Bullish Color", group=grp_style)
bearColor = input.color(#f23645, "Bearish Color", group=grp_style)
instColor = input.color(#5b9cf6, "Institutional Surge Color", group=grp_style, tooltip="Color used for high-volume bars that indicate institutional presence.")

// --- Calculations ---

// 1. Volume-Weighted RSI
// Instead of standard price, we use VWMA to weight the RSI by volume
vwSrc  = ta.vwma(close, rsiLen)
rawRsi = ta.rsi(vwSrc, rsiLen)

// 2. Normalize and Smooth
// Center the RSI around 0 (-50 to 50) and smooth it
oscVal = ta.ema(rawRsi - 50, smoothLen)
signal = ta.ema(oscVal, 9)


// 3. Institutional Volume Detection
// Identify bars with significantly higher volume than the average
volAvg = ta.sma(volume, vLen)
volStd = ta.stdev(volume, vLen)
isInst = volume > volAvg + volStd // Volume > 1 standard deviation above mean

// --- Visualization ---

// Plot Zero Line
hline(0, "Zero Line", color=color.new(chart.fg_color, 50), linestyle=hline.style_dashed)

// Plot the Oscillator Line
oscColor = oscVal > 0 ? bullColor : bearColor
p_osc = plot(oscVal, "Institutional Flow", color=oscColor, linewidth=2)
plot(signal, "Signal Line", color=color.new(chart.fg_color, 40), linewidth=1)


// Centered Oscillator Fill
// Gradient from center (100% transparent) to peak (50% transparent)
p_zero = plot(0, "Zero Path", color=color.new(chart.bg_color, 100), display=display.none)

fill(p_osc, p_zero, 
     top_value    = math.max(0, oscVal), 
     bottom_value = math.min(0, oscVal), 
     top_color    = oscVal > 0 ? color.new(bullColor, 50) : color.new(chart.bg_color, 100), 
     bottom_color = oscVal > 0 ? color.new(chart.bg_color, 100) : color.new(bearColor, 50),
     title="Flow Gradient")

// Institutional Surge Markers
// Highlight columns where volume is high to show "Institutional" backing
plot(isInst ? oscVal : na, "Institutional Surge", color=instColor, style=plot.style_circles, linewidth=3)

// Overbought/Oversold Reference Lines
hline(30, "Overbought", color=color.new(bearColor, 60), linestyle=hline.style_dotted)
hline(-30, "Oversold", color=color.new(bullColor, 60), linestyle=hline.style_dotted)
