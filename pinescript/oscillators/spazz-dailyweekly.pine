//@version=6
indicator('SPAZZ Daily/Weekly', overlay = true)

// Constants
const int RSI_LENGTH = 14
const int BB_LENGTH = 20

// Inputs
mult = input.float(defval = 1.76, title = 'BB Multiplier', step = 0.01)
showLabels = input.bool(defval = true, title = 'Show Labels')
timeframe = input.timeframe('D', title = 'Timeframe', options = ['D', 'W'])

// Calculations
[middle, upper, lower] = ta.bb(close, BB_LENGTH, mult)
rsi = ta.rsi(close, RSI_LENGTH)
rsiMean = ta.sma(rsi, RSI_LENGTH)
rsiStdDev = ta.stdev(rsi, RSI_LENGTH)
zScore = (rsi - rsiMean) / rsiStdDev

// Signal logic
up = ta.crossover(zScore, 0)
down = ta.crossunder(zScore, 0)
uppies = ta.crossover(close, lower)
downies = ta.crossunder(close, upper)

// Colors
upColor = color.new(color.green, 20)
downColor = color.new(color.red, 20)

// Plotting
plotshape(up and uppies, title = 'Up', style = shape.triangleup, location = location.belowbar, color = upColor, size = size.tiny)
plotshape(down and downies, title = 'Down', style = shape.triangledown, location = location.abovebar, color = downColor, size = size.tiny)

// Labels
if showLabels
    if up and uppies
        label.new(bar_index, low, text = 'BUY', color = upColor, textcolor = color.white, style = label.style_label_up, size = size.small)
    if down and downies
        label.new(bar_index, high, text = 'SELL', color = downColor, textcolor = color.white, style = label.style_label_down, size = size.small)

// Alerts
alertcondition(up and uppies, title = 'BUY', message = 'SPAZZ: Buy Signal Detected')
alertcondition(down and downies, title = 'SELL', message = 'SPAZZ: Sell Signal Detected')
