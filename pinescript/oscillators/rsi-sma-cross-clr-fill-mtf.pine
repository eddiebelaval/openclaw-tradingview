//@version=6
indicator(title="RSI SMA Cross Fill MTF", shorttitle="RSI SMA Fill MTF", format=format.price, precision=2)

// =====================
// TIMEFRAME INPUT
// =====================
rsiTF = input.timeframe("", "RSI Timeframe (Leave blank = Current TF)")

// =====================
// RSI SETTINGS
// =====================
rsiLength = input.int(14, minval=1, title="RSI Length")
rsiSource = input.source(close, "RSI Source")

// Function to calculate RSI
calcRSI(src, length) =>
    change = ta.change(src)
    up = ta.rma(math.max(change, 0), length)
    down = ta.rma(-math.min(change, 0), length)
    down == 0 ? 100 : up == 0 ? 0 : 100 - (100 / (1 + up / down))

// Get RSI from selected timeframe
rsi = request.security(syminfo.tickerid, rsiTF == "" ? timeframe.period : rsiTF, calcRSI(rsiSource, rsiLength))

// Plot RSI
rsiColor = input.color(color.green, "RSI Line Color")
rsiPlot = plot(rsi, "RSI", color=rsiColor, linewidth=2)

// =====================
// SMA SETTINGS
// =====================
maLength = input.int(14, "SMA Length")
maColor = input.color(color.red, "SMA Line Color")

sma = ta.sma(rsi, maLength)
maPlot = plot(sma, "RSI SMA", color=maColor, linewidth=2)

// =====================
// FILL SETTINGS
// =====================
bullFillColor = input.color(color.new(color.green, 80), "Bullish Fill Color")
bearFillColor = input.color(color.new(color.red, 80), "Bearish Fill Color")

isBull = rsi > sma
dynamicFill = isBull ? bullFillColor : bearFillColor

fill(rsiPlot, maPlot, color=dynamicFill, title="RSI-SMA Fill")

// Reference lines
hline(70, "Upper", color=color.gray)
hline(50, "Middle", color=color.gray)
hline(30, "Lower", color=color.gray)
