//@version=5
indicator("3T CVD (Custom Rolling, QA-like)", overlay=false)

// ---------- Inputs ----------
useAutoLower = input.bool(true, "Auto-Select Lower TF")
manualLower  = input.timeframe("1", "Manual Lower TF")
sigLen       = input.int(12, "Signallinienlänge", minval=1)
smoothLen    = input.int(20, "Glättung der Länge", minval=1)
rollLen      = input.int(20, "Rolling Window Length", minval=1)

// Auto lower TF heuristic (simple & stable)
string autoLower = timeframe.isminutes and timeframe.multiplier <= 30 ? "1" :
                   timeframe.isminutes and timeframe.multiplier <= 120 ? "5" : "15"
string lowerTF = useAutoLower ? autoLower : manualLower

// ---------- Delta (tick rule) on lower TF ----------
f_delta_tick() =>
    // Tick rule: compare current close to previous close
    // If price upticks => buy-initiated approx; downtick => sell-initiated approx
    float dir = close > close[1] ? 1.0 : close < close[1] ? -1.0 : 0.0
    dir * volume

deltaLT = request.security(syminfo.tickerid, lowerTF, f_delta_tick(), barmerge.gaps_off, barmerge.lookahead_off)

// ---------- CVD ----------
cvd = ta.cum(deltaLT)

// ---------- Rolling Oscillator (matches “Rolling Window Length”) ----------
baseline = ta.sma(cvd, rollLen)          // rolling baseline (SMA is typical)
rolling  = cvd - baseline               // "Rolling CVD"

// ---------- Smooth + Signal ----------
smooth = ta.ema(rolling, smoothLen)     // "Smooth CVD"
signal = ta.ema(smooth, sigLen)         // "Signal Line"

// ---------- Color logic (QA-like) ----------
isBull = smooth > signal
isBear = smooth < signal

plot(smooth, "Rolling CVD (Smoothed)", linewidth=2, color=isBull ? color.lime : color.red)
plot(signal, "Signal", linewidth=2, color=color.new(color.gray, 0))
hline(0, "Null", linestyle=hline.style_dotted)

bgcolor(isBull ? color.new(color.lime, 88) : isBear ? color.new(color.red, 88) : na)

// Debug label
if barstate.islast
    label.new(bar_index, smooth, "LowerTF: " + lowerTF + "\nSmooth: " + str.tostring(smooth, format.mintick) + "\nSignal: " + str.tostring(signal, format.mintick),
      style=label.style_label_left, textcolor=color.white, color=color.new(color.black, 0))
