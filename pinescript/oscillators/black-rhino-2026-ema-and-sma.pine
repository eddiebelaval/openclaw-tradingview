//Author: Ozie Adams <ozie.adams@gmail.com>

//study(shorttitle="Black Rhino - Main ", title="Black Rhino - Main", overlay=true)
indicator('Black Rhino : EMA and SMA', overlay = true)
import TradingView/ta/9

ema5Show = input(true, title="Show EMA5")
ema10Show = input(true, title="Show EMA10")
ema20Show = input(true, title="Show EMA20")
ema40Show = input(true, title="Show EMA40")



sma50Show = input(true, title="Show SMA50")
sma100Show = input(true, title="Show SMA100")
sma150Show = input(true, title="Show SMA150")
sma200Show = input(true, title="Show SMA200")

psarShow = input(true, title="Show Parabolic SAR")

// EMA
ema5 = ema5Show ? ta.ema(close, 5) : na
plot(ema5, color=color.new(color.black, 25), linewidth=1, title="ema5", style=plot.style_cross)
ema10 = ema10Show ? ta.ema(close, 10) : na
plot(ema10, color=color.new(color.green, 25), linewidth=1, title="EMA10", style=plot.style_cross)
ema20 = ema20Show ? ta.ema(close, 20) : na
plot(ema20, color=color.new(color.maroon, 25), linewidth=1, title="EMA20", style=plot.style_cross)
ema40 = ema40Show ? ta.ema(close, 40) : na
plot(ema40, color=color.new(color.aqua, 25), linewidth=1, title="EMA40", style=plot.style_cross)



// SMA
sma50 = sma50Show ? ta.sma(close, 50) : na
plot(sma50, color=color.black, linewidth=1, title="SMA50")
sma100 = sma100Show ? ta.sma(close, 100) : na
plot(sma100, color=color.red, linewidth=1, title="SMA100")
sma150 = sma150Show ? ta.sma(close, 150) : na
plot(sma150, color=color.yellow, linewidth=1, title="SMA150")
sma200 = sma200Show ? ta.sma(close, 200) : na
plot(sma200, color=color.green, linewidth=1, title="SMA200")

// PSAR
psarSeries = psarShow ? ta.sar(0.02, 0.02, 0.2) : na
plot(psarSeries, style=plot.style_circles, color=psarSeries > high ? color.new(color.red, 50) : color.new(color.green, 50), title="PSAR", linewidth=1)
