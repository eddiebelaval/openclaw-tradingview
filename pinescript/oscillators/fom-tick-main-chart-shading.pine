//@version=5
indicator("FOM TICK - Main Chart Shading", overlay=true)

// =========================================================================
// SETTINGS
// =========================================================================
// Transparency is set to 85 so it highlights the background without blinding you
shadeOverbought = input.color(color.new(color.red, 85), title="Overbought Shading (+950)")
shadeOversold   = input.color(color.new(color.green, 85), title="Oversold Shading (-950)")

// =========================================================================
// DATA FETCHING & LOGIC
// =========================================================================
tick_H = request.security("USI:TICK", timeframe.period, high)
tick_L = request.security("USI:TICK", timeframe.period, low)

isOverbought = tick_H >= 950
isOversold   = tick_L <= -950

// =========================================================================
// SHADING
// =========================================================================
bgcolor(isOverbought ? shadeOverbought : na, title="Overbought Background Shading")
bgcolor(isOversold   ? shadeOversold   : na, title="Oversold Background Shading")
