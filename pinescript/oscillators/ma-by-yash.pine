//@version=6
indicator(title = 'MA by yash', shorttitle='MA by yash', overlay = true)

// Variables with improved names
timeframeOption = input.string("2 years", title="Select MA Timeframe", options=[
    "1 day", 
    "2 days", 
    "5 days",
    "9 days",
    "21 days",
    "45 days",
    "52 days",
    "90 days",
    "180 days",
    "1 year", 
    "1.5 years",
    "2 years",
    "2.5 years",
    "3 years",
    "3.5 years",
    "4 years",
    "5 years",
    "6 years",
    "10 years",
    "20 years"
])

// --- Convert Timeframe to MA Period ---
int MA_PERIOD = switch timeframeOption
    "1 day" => 1           // 1 bar (daily chart)
    "2 days" => 2          // 2 bars (daily chart)
    "5 days" => 5          // 5 bars (daily chart)
    "9 days" => 9          // 9 bars (daily chart)
    "21 days" => 21        // 21 bars (daily chart)
    "45 days" => 45        // 45 bars (daily chart)
    "52 days" => 52        // 52 bars (daily chart)
    "90 days" => 90        // 90 bars (daily chart)
    "180 days" => 180      // 180 bars (daily chart)
    "1 year" => 365        // 365 bars (daily chart)
    "1.5 years" => 548     // 547.5 bars (1.5 × 365)
    "2 years" => 730       // 730 bars (daily chart)
    "2.5 years" => 913     // 912.5 bars (2.5 × 365)
    "3 years" => 1095      // 1095 bars (daily chart)
    "3.5 years" => 1278    // 1277.5 bars (3.5 × 365)
    "4 years" => 1460      // 1460 bars (daily chart)
    "5 years" => 1825      // 1825 bars (daily chart)
    "6 years" => 2190      // 2190 bars (daily chart)
    "10 years" => 3650     // 3650 bars (daily chart)
    "20 years" => 7300     // 7300 bars (daily chart)
    => 730

float MULTIPLIER = 5.0  // Multiplier for the upper band

// Calculate Moving Average and upper band
float movingAverage = ta.sma(close, MA_PERIOD)
float upperBand = movingAverage * MULTIPLIER

// Plot with improved RGB colors
var color MA_COLOR = color.rgb(34, 139, 34)  // Forest Green
var color UPPER_BAND_COLOR = color.rgb(178, 34, 34)  // Firebrick Red

// Plot the lines
plot1 = plot(movingAverage, color = color.new(MA_COLOR, 0), linewidth = 1, title="Moving Average")
plot2 = plot(upperBand, color = color.new(UPPER_BAND_COLOR, 0), linewidth = 1, title="Upper Band")

// Plot price for fill reference
pricePlot = plot(close, color = color.new(color.black, 100), title="Price")

// Fill between the bands (middle area)
fill(plot1, plot2, color = color.new(color.rgb(178, 34, 34), 95))

// Fill above upper band (overbought area)
fill(plot2, pricePlot, close > upperBand ? color.new(color.rgb(255, 99, 71), 90) : na)  // Tomato Red

// Fill below moving average (oversold area)
fill(plot1, pricePlot, close < movingAverage ? color.new(color.rgb(100, 149, 237), 90) : na)  // Cornflower Blue
