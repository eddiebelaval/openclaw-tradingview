//@version=6
indicator(title="RSI Multi-Timeframe + Divergence", shorttitle="RSI MTF+D", format=format.price, precision=2)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
rsiLength = input.int(14, title="RSI Length", minval=1)
rsiSource = input.source(close, title="RSI Source")
obLevel   = input.int(70, title="Overbought Level", minval=50, maxval=100)
osLevel   = input.int(30, title="Oversold Level",   minval=0,  maxval=50)
midLevel  = 50

// ─── DIVERGENCE SETTINGS ──────────────────────────────────────────────────────
lbR        = input.int(5,  title="Pivot Lookback Right", minval=1, display=display.none)
lbL        = input.int(5,  title="Pivot Lookback Left",  minval=1, display=display.none)
rangeUpper = input.int(60, title="Max of Lookback Range", minval=5, display=display.none)
rangeLower = input.int(5,  title="Min of Lookback Range", minval=1, display=display.none)
plotBull    = input.bool(true,  title="Plot Regular Bullish")
plotHidBull = input.bool(false, title="Plot Hidden Bullish")
plotBear    = input.bool(true,  title="Plot Regular Bearish")
plotHidBear = input.bool(false, title="Plot Hidden Bearish")

// ─── FARVER ───────────────────────────────────────────────────────────────────
bullColor       = color.green
bearColor       = color.red
hiddenBullColor = color.new(color.green, 80)
hiddenBearColor = color.new(color.red,   80)
textColor       = color.white
noneColor       = color.new(color.white, 100)

col0 = color.new(color.white, 0)
col1 = color.new(#00bcd4,     0)
col2 = color.new(#ff9800,     0)
col3 = color.new(#4caf50,     0)
col4 = color.new(#f44336,     0)
col5 = color.new(#9c27b0,     0)
col6 = color.new(#ffeb3b,     0)

// ─── FASTE TIMEFRAMES ─────────────────────────────────────────────────────────
tf1 = "5"
tf2 = "15"
tf3 = "60"
tf4 = "240"
tf5 = "D"
tf6 = "W"

// ─── RSI CALCULATIONS ─────────────────────────────────────────────────────────
osc  = ta.rsi(rsiSource, rsiLength)
rsi1 = request.security(syminfo.tickerid, tf1, ta.rsi(rsiSource, rsiLength), lookahead=barmerge.lookahead_off)
rsi2 = request.security(syminfo.tickerid, tf2, ta.rsi(rsiSource, rsiLength), lookahead=barmerge.lookahead_off)
rsi3 = request.security(syminfo.tickerid, tf3, ta.rsi(rsiSource, rsiLength), lookahead=barmerge.lookahead_off)
rsi4 = request.security(syminfo.tickerid, tf4, ta.rsi(rsiSource, rsiLength), lookahead=barmerge.lookahead_off)
rsi5 = request.security(syminfo.tickerid, tf5, ta.rsi(rsiSource, rsiLength), lookahead=barmerge.lookahead_off)
rsi6 = request.security(syminfo.tickerid, tf6, ta.rsi(rsiSource, rsiLength), lookahead=barmerge.lookahead_off)

// ─── PLOTS RSI LINJER ─────────────────────────────────────────────────────────
plot(osc,  title="Current", color=col0, linewidth=2)
plot(rsi1, title="5M",      color=col1, linewidth=1)
plot(rsi2, title="15M",     color=col2, linewidth=1)
plot(rsi3, title="1H",      color=col3, linewidth=1)
plot(rsi4, title="4H",      color=col4, linewidth=2)
plot(rsi5, title="1D",      color=col5, linewidth=1)
plot(rsi6, title="1W",      color=col6, linewidth=1)

// ─── OB/OS LINJER & FILL ──────────────────────────────────────────────────────
hOB  = hline(obLevel,  "Overbought", color=color.red,   linestyle=hline.style_dashed, linewidth=1)
hMid = hline(midLevel, "Midline",    color=color.gray,  linestyle=hline.style_dotted, linewidth=1)
hOS  = hline(osLevel,  "Oversold",   color=color.green, linestyle=hline.style_dashed, linewidth=1)

fill(hOB,  hMid, color=color.new(color.red,   88), title="Overbought Zone")
fill(hMid, hOS,  color=color.new(color.green, 88), title="Oversold Zone")

// ─── PIVOT DETECTION ──────────────────────────────────────────────────────────
plFound = na(ta.pivotlow(osc,  lbL, lbR)) ? false : true
phFound = na(ta.pivothigh(osc, lbL, lbR)) ? false : true

_inRange(cond) =>
    bars = ta.barssince(cond == true)
    rangeLower <= bars and bars <= rangeUpper

inRangePl = _inRange(plFound[1])
inRangePh = _inRange(phFound[1])

// ─── DIVERGENCE CONDITIONS ────────────────────────────────────────────────────
oscHL = osc[lbR] > ta.valuewhen(plFound, osc[lbR], 1) and inRangePl
oscLL = osc[lbR] < ta.valuewhen(plFound, osc[lbR], 1) and inRangePl
oscLH = osc[lbR] < ta.valuewhen(phFound, osc[lbR], 1) and inRangePh
oscHH = osc[lbR] > ta.valuewhen(phFound, osc[lbR], 1) and inRangePh

priceLL = low[lbR]  < ta.valuewhen(plFound, low[lbR],  1)
priceHL = low[lbR]  > ta.valuewhen(plFound, low[lbR],  1)
priceHH = high[lbR] > ta.valuewhen(phFound, high[lbR], 1)
priceLH = high[lbR] < ta.valuewhen(phFound, high[lbR], 1)

bullCondAlert    = priceLL and oscHL and plFound
hidBullCondAlert = priceHL and oscLL and plFound
bearCondAlert    = priceHH and oscLH and phFound
hidBearCondAlert = priceLH and oscHH and phFound

bullCond    = plotBull    and bullCondAlert
hidBullCond = plotHidBull and hidBullCondAlert
bearCond    = plotBear    and bearCondAlert
hidBearCond = plotHidBear and hidBearCondAlert

// ─── DIVERGENCE LINJER ────────────────────────────────────────────────────────
plot(plFound ? osc[lbR] : na, offset=-lbR, title="Regular Bullish",
     linewidth=2, color=(bullCond ? bullColor : noneColor), display=display.pane)
plot(plFound ? osc[lbR] : na, offset=-lbR, title="Hidden Bullish",
     linewidth=2, color=(hidBullCond ? hiddenBullColor : noneColor), display=display.pane)
plot(phFound ? osc[lbR] : na, offset=-lbR, title="Regular Bearish",
     linewidth=2, color=(bearCond ? bearColor : noneColor), display=display.pane)
plot(phFound ? osc[lbR] : na, offset=-lbR, title="Hidden Bearish",
     linewidth=2, color=(hidBearCond ? hiddenBearColor : noneColor), display=display.pane)

// ─── LABELS — ét sæt per timeframe (const string) ────────────────────────────
// 1M
plotshape(bullCond    and timeframe.period == "1" ? osc[lbR] : na, offset=-lbR, title="Bull 1M",   text=" Bull\n1M",   style=shape.labelup,   location=location.absolute, color=bullColor,       textcolor=textColor)
plotshape(hidBullCond and timeframe.period == "1" ? osc[lbR] : na, offset=-lbR, title="HBull 1M",  text=" HBull\n1M",  style=shape.labelup,   location=location.absolute, color=hiddenBullColor, textcolor=textColor)
plotshape(bearCond    and timeframe.period == "1" ? osc[lbR] : na, offset=-lbR, title="Bear 1M",   text=" Bear\n1M",   style=shape.labeldown, location=location.absolute, color=bearColor,       textcolor=textColor)
plotshape(hidBearCond and timeframe.period == "1" ? osc[lbR] : na, offset=-lbR, title="HBear 1M",  text=" HBear\n1M",  style=shape.labeldown, location=location.absolute, color=hiddenBearColor, textcolor=textColor)
// 3M
plotshape(bullCond    and timeframe.period == "3" ? osc[lbR] : na, offset=-lbR, title="Bull 3M",   text=" Bull\n3M",   style=shape.labelup,   location=location.absolute, color=bullColor,       textcolor=textColor)
plotshape(hidBullCond and timeframe.period == "3" ? osc[lbR] : na, offset=-lbR, title="HBull 3M",  text=" HBull\n3M",  style=shape.labelup,   location=location.absolute, color=hiddenBullColor, textcolor=textColor)
plotshape(bearCond    and timeframe.period == "3" ? osc[lbR] : na, offset=-lbR, title="Bear 3M",   text=" Bear\n3M",   style=shape.labeldown, location=location.absolute, color=bearColor,       textcolor=textColor)
plotshape(hidBearCond and timeframe.period == "3" ? osc[lbR] : na, offset=-lbR, title="HBear 3M",  text=" HBear\n3M",  style=shape.labeldown, location=location.absolute, color=hiddenBearColor, textcolor=textColor)
// 5M
plotshape(bullCond    and timeframe.period == "5" ? osc[lbR] : na, offset=-lbR, title="Bull 5M",   text=" Bull\n5M",   style=shape.labelup,   location=location.absolute, color=bullColor,       textcolor=textColor)
plotshape(hidBullCond and timeframe.period == "5" ? osc[lbR] : na, offset=-lbR, title="HBull 5M",  text=" HBull\n5M",  style=shape.labelup,   location=location.absolute, color=hiddenBullColor, textcolor=textColor)
plotshape(bearCond    and timeframe.period == "5" ? osc[lbR] : na, offset=-lbR, title="Bear 5M",   text=" Bear\n5M",   style=shape.labeldown, location=location.absolute, color=bearColor,       textcolor=textColor)
plotshape(hidBearCond and timeframe.period == "5" ? osc[lbR] : na, offset=-lbR, title="HBear 5M",  text=" HBear\n5M",  style=shape.labeldown, location=location.absolute, color=hiddenBearColor, textcolor=textColor)
// 15M
plotshape(bullCond    and timeframe.period == "15" ? osc[lbR] : na, offset=-lbR, title="Bull 15M",  text=" Bull\n15M",  style=shape.labelup,   location=location.absolute, color=bullColor,       textcolor=textColor)
plotshape(hidBullCond and timeframe.period == "15" ? osc[lbR] : na, offset=-lbR, title="HBull 15M", text=" HBull\n15M", style=shape.labelup,   location=location.absolute, color=hiddenBullColor, textcolor=textColor)
plotshape(bearCond    and timeframe.period == "15" ? osc[lbR] : na, offset=-lbR, title="Bear 15M",  text=" Bear\n15M",  style=shape.labeldown, location=location.absolute, color=bearColor,       textcolor=textColor)
plotshape(hidBearCond and timeframe.period == "15" ? osc[lbR] : na, offset=-lbR, title="HBear 15M", text=" HBear\n15M", style=shape.labeldown, location=location.absolute, color=hiddenBearColor, textcolor=textColor)
// 30M
plotshape(bullCond    and timeframe.period == "30" ? osc[lbR] : na, offset=-lbR, title="Bull 30M",  text=" Bull\n30M",  style=shape.labelup,   location=location.absolute, color=bullColor,       textcolor=textColor)
plotshape(hidBullCond and timeframe.period == "30" ? osc[lbR] : na, offset=-lbR, title="HBull 30M", text=" HBull\n30M", style=shape.labelup,   location=location.absolute, color=hiddenBullColor, textcolor=textColor)
plotshape(bearCond    and timeframe.period == "30" ? osc[lbR] : na, offset=-lbR, title="Bear 30M",  text=" Bear\n30M",  style=shape.labeldown, location=location.absolute, color=bearColor,       textcolor=textColor)
plotshape(hidBearCond and timeframe.period == "30" ? osc[lbR] : na, offset=-lbR, title="HBear 30M", text=" HBear\n30M", style=shape.labeldown, location=location.absolute, color=hiddenBearColor, textcolor=textColor)
// 1H
plotshape(bullCond    and timeframe.period == "60" ? osc[lbR] : na, offset=-lbR, title="Bull 1H",   text=" Bull\n1H",   style=shape.labelup,   location=location.absolute, color=bullColor,       textcolor=textColor)
plotshape(hidBullCond and timeframe.period == "60" ? osc[lbR] : na, offset=-lbR, title="HBull 1H",  text=" HBull\n1H",  style=shape.labelup,   location=location.absolute, color=hiddenBullColor, textcolor=textColor)
plotshape(bearCond    and timeframe.period == "60" ? osc[lbR] : na, offset=-lbR, title="Bear 1H",   text=" Bear\n1H",   style=shape.labeldown, location=location.absolute, color=bearColor,       textcolor=textColor)
plotshape(hidBearCond and timeframe.period == "60" ? osc[lbR] : na, offset=-lbR, title="HBear 1H",  text=" HBear\n1H",  style=shape.labeldown, location=location.absolute, color=hiddenBearColor, textcolor=textColor)
// 2H
plotshape(bullCond    and timeframe.period == "120" ? osc[lbR] : na, offset=-lbR, title="Bull 2H",  text=" Bull\n2H",   style=shape.labelup,   location=location.absolute, color=bullColor,       textcolor=textColor)
plotshape(bearCond    and timeframe.period == "120" ? osc[lbR] : na, offset=-lbR, title="Bear 2H",  text=" Bear\n2H",   style=shape.labeldown, location=location.absolute, color=bearColor,       textcolor=textColor)
// 4H
plotshape(bullCond    and timeframe.period == "240" ? osc[lbR] : na, offset=-lbR, title="Bull 4H",   text=" Bull\n4H",   style=shape.labelup,   location=location.absolute, color=bullColor,       textcolor=textColor)
plotshape(hidBullCond and timeframe.period == "240" ? osc[lbR] : na, offset=-lbR, title="HBull 4H",  text=" HBull\n4H",  style=shape.labelup,   location=location.absolute, color=hiddenBullColor, textcolor=textColor)
plotshape(bearCond    and timeframe.period == "240" ? osc[lbR] : na, offset=-lbR, title="Bear 4H",   text=" Bear\n4H",   style=shape.labeldown, location=location.absolute, color=bearColor,       textcolor=textColor)
plotshape(hidBearCond and timeframe.period == "240" ? osc[lbR] : na, offset=-lbR, title="HBear 4H",  text=" HBear\n4H",  style=shape.labeldown, location=location.absolute, color=hiddenBearColor, textcolor=textColor)
// 1D
plotshape(bullCond    and timeframe.period == "D" ? osc[lbR] : na, offset=-lbR, title="Bull 1D",   text=" Bull\n1D",   style=shape.labelup,   location=location.absolute, color=bullColor,       textcolor=textColor)
plotshape(hidBullCond and timeframe.period == "D" ? osc[lbR] : na, offset=-lbR, title="HBull 1D",  text=" HBull\n1D",  style=shape.labelup,   location=location.absolute, color=hiddenBullColor, textcolor=textColor)
plotshape(bearCond    and timeframe.period == "D" ? osc[lbR] : na, offset=-lbR, title="Bear 1D",   text=" Bear\n1D",   style=shape.labeldown, location=location.absolute, color=bearColor,       textcolor=textColor)
plotshape(hidBearCond and timeframe.period == "D" ? osc[lbR] : na, offset=-lbR, title="HBear 1D",  text=" HBear\n1D",  style=shape.labeldown, location=location.absolute, color=hiddenBearColor, textcolor=textColor)
// 1W
plotshape(bullCond    and timeframe.period == "W" ? osc[lbR] : na, offset=-lbR, title="Bull 1W",   text=" Bull\n1W",   style=shape.labelup,   location=location.absolute, color=bullColor,       textcolor=textColor)
plotshape(bearCond    and timeframe.period == "W" ? osc[lbR] : na, offset=-lbR, title="Bear 1W",   text=" Bear\n1W",   style=shape.labeldown, location=location.absolute, color=bearColor,       textcolor=textColor)
// 1MO
plotshape(bullCond    and timeframe.period == "M" ? osc[lbR] : na, offset=-lbR, title="Bull 1MO",  text=" Bull\n1MO",  style=shape.labelup,   location=location.absolute, color=bullColor,       textcolor=textColor)
plotshape(bearCond    and timeframe.period == "M" ? osc[lbR] : na, offset=-lbR, title="Bear 1MO",  text=" Bear\n1MO",  style=shape.labeldown, location=location.absolute, color=bearColor,       textcolor=textColor)

// ─── ALERTS ───────────────────────────────────────────────────────────────────
alertcondition(bullCondAlert,    title="Regular Bullish Divergence", message="Regular Bullish Divergence fundet")
alertcondition(hidBullCondAlert, title="Hidden Bullish Divergence",  message="Hidden Bullish Divergence fundet")
alertcondition(bearCondAlert,    title="Regular Bearish Divergence", message="Regular Bearish Divergence fundet")
alertcondition(hidBearCondAlert, title="Hidden Bearish Divergence",  message="Hidden Bearish Divergence fundet")
