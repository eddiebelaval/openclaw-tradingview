//@version=5
indicator(title="Institutional Pressure Oscillator [Quantum Algo]", shorttitle="Pressure Oscillator [Quantum Algo]", overlay=false, precision=2)

// ─────────────────────────────────────────────────────────────────────────────
//  ██████╗ ██╗   ██╗ █████╗ ███╗   ██╗████████╗██╗   ██╗███╗   ███╗
// ██╔═══██╗██║   ██║██╔══██╗████╗  ██║╚══██╔══╝██║   ██║████╗ ████║
// ██║   ██║██║   ██║███████║██╔██╗ ██║   ██║   ██║   ██║██╔████╔██║
// ██║▄▄ ██║██║   ██║██╔══██║██║╚██╗██║   ██║   ██║   ██║██║╚██╔╝██║
// ╚██████╔╝╚██████╔╝██║  ██║██║ ╚████║   ██║   ╚██████╔╝██║ ╚═╝ ██║
//  ╚══▀▀═╝  ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═══╝   ╚═╝    ╚═════╝ ╚═╝     ╚═╝
//  █████╗ ██╗      ██████╗  ██████╗ 
// ██╔══██╗██║     ██╔════╝ ██╔═══██╗
// ███████║██║     ██║  ███╗██║   ██║
// ██╔══██║██║     ██║   ██║██║   ██║
// ██║  ██║███████╗╚██████╔╝╚██████╔╝
// ╚═╝  ╚═╝╚══════╝ ╚═════╝  ╚═════╝ 
// ─────────────────────────────────────────────────────────────────────────────
//
//  Institutional Pressure Oscillator [Quantum Algo]
//
//  Detects hidden accumulation and distribution by measuring directional 
//  pressure behind each bar's volume. Unlike standard volume indicators 
//  that treat all activity equally, this oscillator applies a logarithmic 
//  volatility filter to separate institutional conviction from market noise,
//  then normalizes the result against a rolling participation baseline.
//
//  The result is a clean oscillator that reveals whether smart money is 
//  quietly building positions (positive pressure) or distributing into 
//  strength (negative pressure) — often well before price confirms the move.
//
//  How To Read:
//  ─ Oscillator above zero   → net buying pressure (accumulation phase)
//  ─ Oscillator below zero   → net selling pressure (distribution phase)
//  ─ Trigger line cross up   → pressure momentum shifting bullish
//  ─ Trigger line cross down → pressure momentum shifting bearish
//  ─ Histogram expanding     → conviction increasing behind the move
//  ─ Histogram contracting   → conviction fading, watch for reversal
//  ─ Divergence vs price     → early warning of trend exhaustion
//
//  Learn more at quantum-algo.com
// ─────────────────────────────────────────────────────────────────────────────

// ═══════════════════════════════════════════════════════════════════════════════
// 𝗦 𝗘 𝗧 𝗧 𝗜 𝗡 𝗚 𝗦
// ═══════════════════════════════════════════════════════════════════════════════

// ── Pressure Engine ─────────────────────────────────────────────────────────
grp_engine = "⚙️  Pressure Engine"
pressureWindow  = input.int(130, title="Accumulation Window", minval=10, maxval=500, tooltip="Number of bars over which directional pressure is accumulated. Longer windows produce smoother readings with less noise. Shorter windows react faster to changing conditions.", group=grp_engine)
noiseGate       = input.float(0.2, title="Noise Gate Sensitivity", minval=0.01, maxval=1.0, step=0.01, tooltip="Controls how aggressively small price moves are filtered out. Higher values require stronger directional conviction before volume is counted. Lower values include weaker moves.", group=grp_engine)
participationCap = input.float(2.5, title="Participation Cap", minval=1.0, maxval=10.0, step=0.1, tooltip="Limits any single bar's influence to this multiple of the average participation level. Prevents flash spikes or wash trading from distorting the oscillator.", group=grp_engine)
triggerSmoothing = input.int(5, title="Trigger Line Smoothing", minval=1, maxval=50, tooltip="EMA period applied to generate the trigger line. Lower values produce earlier but noisier crossover signals.", group=grp_engine)
useExtraSmooth  = input.bool(false, title="Extra Smoothing", tooltip="Applies an additional moving average pass to the main oscillator line for a cleaner but more lagging reading.", group=grp_engine)

// ── Display Options ─────────────────────────────────────────────────────────
grp_display = "🎨  Display Options"
showConviction  = input.bool(true, title="Show Conviction Histogram", tooltip="Displays the momentum difference between the oscillator and its trigger line as a histogram. Useful for gauging the strength behind directional pressure.", group=grp_display)
showPressureZones = input.bool(true, title="Show Pressure Zones", tooltip="Shades the area between the oscillator and the zero line to visually distinguish accumulation (positive) from distribution (negative) phases.", group=grp_display)
showCrossSignals = input.bool(true, title="Show Crossover Signals", tooltip="Marks the exact bars where the oscillator crosses its trigger line, highlighting potential momentum shift points.", group=grp_display)

// ── Quantum Algo Palette ────────────────────────────────────────────────────
grp_palette = "🔮  Quantum Algo Palette"
col_accumulation = input.color(#00e5ff, title="Accumulation Pressure", group=grp_palette)
col_distribution = input.color(#7c4dff, title="Distribution Pressure", group=grp_palette)
col_trigger      = input.color(#ff6d00, title="Trigger Line", group=grp_palette)
col_convictUp    = input.color(#00e5ff, title="Conviction Rising", group=grp_palette)
col_convictDown  = input.color(#7c4dff, title="Conviction Falling", group=grp_palette)
col_baseline     = input.color(#455a64, title="Baseline", group=grp_palette)

// ═══════════════════════════════════════════════════════════════════════════════
// 𝗖 𝗢 𝗥 𝗘   𝗟 𝗢 𝗚 𝗜 𝗖
// ═══════════════════════════════════════════════════════════════════════════════

// ── Optional Smoothing Pass ─────────────────────────────────────────────────
applySmoothing(float src, int len) =>
    useExtraSmooth ? ta.sma(src, len) : src

// ── Step 1: Logarithmic Price Differential ──────────────────────────────────
// Using log returns instead of raw price change normalizes across instruments
// and timeframes, making the noise gate work consistently on $1 and $50k assets.
anchorPrice     = hlc3
logDelta        = math.log(anchorPrice) - math.log(anchorPrice[1])

// ── Step 2: Adaptive Volatility Noise Gate ──────────────────────────────────
// Measures recent log-return dispersion to dynamically set the threshold 
// below which price moves are considered noise rather than conviction.
dispersion      = ta.stdev(logDelta, 30)
gateThreshold   = noiseGate * dispersion * close

// ── Step 3: Participation Normalization ─────────────────────────────────────
// Establishes a rolling baseline of normal participation and caps outliers
// so that a single anomalous bar cannot dominate the accumulated reading.
baselineParticipation = ta.sma(volume, pressureWindow)[1]
participationCeiling  = baselineParticipation * participationCap
normalizedActivity    = math.min(volume, participationCeiling)

// ── Step 4: Directional Pressure Classification ─────────────────────────────
// Each bar is classified as buying pressure, selling pressure, or neutral
// based on whether its price move exceeds the adaptive noise gate.
barDelta            = anchorPrice - anchorPrice[1]
classifiedPressure  = barDelta > gateThreshold ? normalizedActivity : barDelta < -gateThreshold ? -normalizedActivity : 0.0

// ── Step 5: Cumulative Pressure Oscillator ──────────────────────────────────
// Sums classified pressure over the lookback window and normalizes against
// the participation baseline, producing a bounded oscillator centered on zero.
pressureOscillator = applySmoothing(math.sum(classifiedPressure, pressureWindow) / baselineParticipation, 3)

// ── Step 6: Trigger Line & Conviction Spread ────────────────────────────────
triggerLine     = ta.ema(pressureOscillator, triggerSmoothing)
convictionSpread = pressureOscillator - triggerLine

// ── State Classification ────────────────────────────────────────────────────
isAccumulating   = pressureOscillator >= 0
isConvictionUp   = convictionSpread >= 0
bullishShift     = ta.crossover(pressureOscillator, triggerLine)
bearishShift     = ta.crossunder(pressureOscillator, triggerLine)

// ═══════════════════════════════════════════════════════════════════════════════
// 𝗩 𝗜 𝗦 𝗨 𝗔 𝗟 𝗦
// ═══════════════════════════════════════════════════════════════════════════════

// ── Baseline ────────────────────────────────────────────────────────────────
hline(0, title="Neutral Baseline", color=col_baseline, linestyle=hline.style_dashed, linewidth=1)

// ── Conviction Histogram ────────────────────────────────────────────────────
convictionColor = isConvictionUp ? color.new(col_convictUp, 55) : color.new(col_convictDown, 55)
plot(showConviction ? convictionSpread : na, title="Conviction Histogram", style=plot.style_columns, color=convictionColor, linewidth=3)

// ── Pressure Oscillator Line ────────────────────────────────────────────────
oscillatorColor = isAccumulating ? col_accumulation : col_distribution
pOscillator = plot(pressureOscillator, title="Institutional Pressure", color=oscillatorColor, linewidth=2)

// ── Trigger Line ────────────────────────────────────────────────────────────
pTrigger = plot(triggerLine, title="Trigger Line", color=col_trigger, linewidth=1)

// ── Pressure Zone Shading ───────────────────────────────────────────────────
pBaseline = plot(showPressureZones ? 0 : na, title="Baseline Reference", display=display.none)
zoneAccumulation = color.new(col_accumulation, 88)
zoneDistribution = color.new(col_distribution, 88)
fill(pOscillator, pBaseline, color=showPressureZones and isAccumulating ? zoneAccumulation : showPressureZones and not isAccumulating ? zoneDistribution : na, title="Pressure Zone Fill")

// ── Crossover Signals ───────────────────────────────────────────────────────
plotshape(showCrossSignals and bullishShift ? pressureOscillator : na, title="Bullish Shift", style=shape.circle, location=location.absolute, color=col_accumulation, size=size.tiny)
plotshape(showCrossSignals and bearishShift ? pressureOscillator : na, title="Bearish Shift", style=shape.circle, location=location.absolute, color=col_distribution, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// 𝗔 𝗟 𝗘 𝗥 𝗧 𝗦
// ═══════════════════════════════════════════════════════════════════════════════

alertcondition(bullishShift, title="🟢 Bullish Pressure Shift", message="Quantum Algo: Institutional buying pressure momentum shifting bullish on {{ticker}} ({{interval}})")
alertcondition(bearishShift, title="🔴 Bearish Pressure Shift", message="Quantum Algo: Institutional selling pressure momentum shifting bearish on {{ticker}} ({{interval}})")
alertcondition(ta.crossover(pressureOscillator, 0), title="🟢 Accumulation Phase", message="Quantum Algo: Net pressure turned positive — accumulation detected on {{ticker}} ({{interval}})")
alertcondition(ta.crossunder(pressureOscillator, 0), title="🔴 Distribution Phase", message="Quantum Algo: Net pressure turned negative — distribution detected on {{ticker}} ({{interval}})")
