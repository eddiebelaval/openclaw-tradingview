//@version=6
indicator("Start Grid Alert by Deepsage", overlay=false)

// Input parameters
adxLength     = input.int(14, title="ADX Length")
adxSmoothing  = input.int(14, title="ADX Smoothing")
chopLength    = input.int(14, title="CHOP Length")

// Calculate ADX
[_, _, adx] = ta.dmi(adxLength, adxSmoothing)


// Calculate CHOP
hh = ta.highest(high, chopLength)
ll = ta.lowest(low, chopLength)
chop = 100 * ((hh - ll) / (ta.highest(hh, chopLength) - ta.lowest(ll, chopLength)))

// Alert conditions
startGridCondition = (adx < 18) and (chop > 60)

// Plotting
plot(adx, color=color.blue, title="ADX")
plot(chop, color=color.green, title="CHOP")

// Alert
alertcondition(startGridCondition, title="Start Grid Alert", message="Start Grid: ADX < 18 and CHOP > 60")
