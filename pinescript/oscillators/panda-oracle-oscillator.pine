// ============================================================
//  🐼💕 PANDA ORACLE — Oscillator  v1.1
//  By Jay's Girly Team
//  EMA 25 / EMA 200 Normalized Oscillator
//  Separate pane | Range -100 to +100
// ============================================================
//@version=5
indicator("🐼 Panda Oracle — Oscillator 💕", overlay=false, max_labels_count=200)

// ─────────────────────────────────────────────
//  INPUTS
// ─────────────────────────────────────────────
grp_ema = "🌸 EMA Settings"
ema_fast_len = input.int(25,  "EMA Fast",          group=grp_ema, minval=1)
ema_slow_len = input.int(200, "EMA Slow",          group=grp_ema, minval=1)
smooth_len   = input.int(3,   "Signal Smoothing",  group=grp_ema, minval=1)

grp_display = "💕 Display"
show_histo   = input.bool(true,   "Show Histogram",               group=grp_display)
show_signal  = input.bool(true,   "Show Signal Line (smoothed)",  group=grp_display)
overbought   = input.float(60.0,  "Overbought Level",             group=grp_display, step=5.0)
oversold     = input.float(-60.0, "Oversold Level",               group=grp_display, step=5.0)

grp_dash = "🐼 Mini Dashboard"
show_dash = input.bool(true, "Show Mini Dashboard", group=grp_dash)

// ─────────────────────────────────────────────
//  COLORS
// ─────────────────────────────────────────────
col_pink       = color.new(#FF6B9D, 0)
col_purple     = color.new(#A855F7, 0)
col_pink_fade  = color.new(#FF6B9D, 60)
col_purp_fade  = color.new(#A855F7, 60)
col_ob_fill    = color.new(#FF6B9D, 78)
col_os_fill    = color.new(#A855F7, 78)
col_signal     = color.new(#FFD700, 0)   // Gold signal line

// Dashboard dark theme
col_hdr_bg    = color.new(#120818, 0)
col_hdr_txt   = color.new(#FF6B9D, 0)
col_sep_bg    = color.new(#2D1245, 0)
col_sep_txt   = color.new(#C084FC, 0)
col_row_bg    = color.new(#1A0E2E, 0)
col_row_lbl   = color.new(#C084FC, 0)
col_val_bull  = color.new(#FF6B9D, 0)
col_val_bear  = color.new(#C084FC, 0)
col_advice_bg = color.new(#2D1245, 0)

// ─────────────────────────────────────────────
//  CALCULATIONS
// ─────────────────────────────────────────────
ema25  = ta.ema(close, ema_fast_len)
ema200 = ta.ema(close, ema_slow_len)

// Raw oscillator: % spread between EMA25 and EMA200
raw_osc = ((ema25 - ema200) / ema200) * 100

// Dynamic normalization over last 200 bars → range stays near -100/+100
max_val = ta.highest(math.abs(raw_osc), 200)
osc     = max_val != 0.0 ? (raw_osc / max_val) * 100.0 : 0.0

// Smoothed signal line
signal_line = ta.ema(osc, smooth_len)

// Momentum (1-bar delta)
mom = osc - osc[1]

// Cross signals
cross_bull = ta.crossover(osc,  signal_line)
cross_bear = ta.crossunder(osc, signal_line)

// Zone flags
is_bull = osc > 0.0
is_ob   = osc >= overbought
is_os   = osc <= oversold

// ─────────────────────────────────────────────
//  REFERENCE LINES
// ─────────────────────────────────────────────
h_ob   = hline(overbought, "Overbought 🔥",
               color=color.new(#FF6B9D, 35), linewidth=1, linestyle=hline.style_dashed)
h_os   = hline(oversold,   "Oversold 💎",
               color=color.new(#A855F7, 35), linewidth=1, linestyle=hline.style_dashed)
h_zero = hline(0,          "Zero Line",
               color=color.new(#FF6B9D, 55), linewidth=1, linestyle=hline.style_solid)
h_top  = hline(100,        "Max",
               color=color.new(#FFD6E8, 65), linewidth=1, linestyle=hline.style_dotted)
h_bot  = hline(-100,       "Min",
               color=color.new(#FFD6E8, 65), linewidth=1, linestyle=hline.style_dotted)

// Zone fills
fill(h_ob,  h_top, color=col_ob_fill, title="Overbought Zone")
fill(h_bot, h_os,  color=col_os_fill, title="Oversold Zone")

// ─────────────────────────────────────────────
//  HISTOGRAM
// ─────────────────────────────────────────────
// Pink shades = bullish | Purple shades = bearish
// Bright = accelerating | Faded = decelerating
hist_color = osc >= 0.0 ?
     (mom >= 0.0 ? col_pink      : col_pink_fade) :
     (mom <= 0.0 ? col_purple    : col_purp_fade)

plot(show_histo ? osc : na, "Panda Oscillator 🐼",
     style=plot.style_columns, color=hist_color)

// ─────────────────────────────────────────────
//  SIGNAL LINE + CROSS DOTS
// ─────────────────────────────────────────────
plot(show_signal ? signal_line : na, "Signal Line ✨",
     color=col_signal, linewidth=2)


// ─────────────────────────────────────────────
//  ZONE ENTRY LABELS (entry into extreme zones)
// ─────────────────────────────────────────────
if ta.crossover(osc, overbought)
    label.new(bar_index, osc + 4,
         "🔥 Overbought!\nWait for a pullback",
         color=col_pink, textcolor=color.white,
         style=label.style_label_down, size=size.small)

if ta.crossunder(osc, oversold)
    label.new(bar_index, osc - 4,
         "💎 Oversold!\nLook for a bounce",
         color=col_purple, textcolor=color.white,
         style=label.style_label_up, size=size.small)

// ─────────────────────────────────────────────
//  MINI DASHBOARD
// ─────────────────────────────────────────────
osc_abs       = math.abs(osc)
strength_txt  = osc_abs > 75 ? "🔥 STRONG"  :osc_abs > 40 ? "✨ MEDIUM"  : "😴 WEAK"

zone_txt      = is_ob             ? "⚠️ OVERBOUGHT"   :is_os              ? "💎 OVERSOLD"     :is_bull            ? "🌸 Bullish Zone" : "💜 Bearish Zone"

cross_txt     = cross_bull         ? "🐼 CROSS UP — BUY!"   :cross_bear         ? "🐼 CROSS DOWN — SELL!" : "— No signal —"

mom_txt       = mom > 0.0 ? "📈 Accelerating ↑" :mom < 0.0 ? "📉 Decelerating ↓" : "➡️ Stable"

val_col       = is_bull ? col_val_bull : col_val_bear

advice_txt    = is_ob      ? "⚠️ Wait for a pullback"   :is_os       ? "💎 Look for a bounce"     :cross_bull  ? "🌸 Enter cautiously"      :cross_bear  ? "💜 Exit or flip"          :is_bull     ? "✨ Hold your position"    : "😴 Patience, panda!"

if show_dash and barstate.islast
    var t = table.new(position.top_right, 2, 8,
         border_color = color.new(#FF6B9D, 45),
         border_width = 1,
         frame_color  = color.new(#A855F7, 25),
         frame_width  = 2)

    // Header
    table.cell(t, 0, 0, "🐼 OSC STATUS",
         bgcolor = col_hdr_bg, text_color = col_hdr_txt,
         text_size = size.small, text_halign = text.align_center)
    table.cell(t, 1, 0, "EMA 25/200",
         bgcolor = col_hdr_bg, text_color = col_hdr_txt,
         text_size = size.small, text_halign = text.align_center)

    // OSC Value
    table.cell(t, 0, 1, "OSC Value",
         bgcolor = col_row_bg, text_color = col_row_lbl, text_size = size.small)
    table.cell(t, 1, 1, str.tostring(osc, "#.#"),
         bgcolor = col_row_bg, text_color = val_col, text_size = size.small)

    // Zone
    table.cell(t, 0, 2, "Zone",
         bgcolor = col_row_bg, text_color = col_row_lbl, text_size = size.small)
    table.cell(t, 1, 2, zone_txt,
         bgcolor = col_row_bg, text_color = val_col, text_size = size.small)

    // Strength
    table.cell(t, 0, 3, "Strength",
         bgcolor = col_row_bg, text_color = col_row_lbl, text_size = size.small)
    table.cell(t, 1, 3, strength_txt,
         bgcolor = col_row_bg, text_color = col_val_bull, text_size = size.small)

    // Momentum
    table.cell(t, 0, 4, "Momentum",
         bgcolor = col_row_bg, text_color = col_row_lbl, text_size = size.small)
    table.cell(t, 1, 4, mom_txt,
         bgcolor = col_row_bg, text_color = val_col, text_size = size.small)

    // Cross Signal
    table.cell(t, 0, 5, "Cross Signal",
         bgcolor = col_row_bg, text_color = col_row_lbl, text_size = size.small)
    table.cell(t, 1, 5, cross_txt,
         bgcolor = col_row_bg, text_color = col_val_bull, text_size = size.small)

    // Separator
    table.cell(t, 0, 6, "",
         bgcolor = col_sep_bg)
    table.cell(t, 1, 6, "",
         bgcolor = col_sep_bg)

    // Advice
    table.cell(t, 0, 7, "Advice 🐼",
         bgcolor = col_advice_bg, text_color = col_hdr_txt, text_size = size.small)
    table.cell(t, 1, 7, advice_txt,
         bgcolor = col_advice_bg, text_color = color.white, text_size = size.small)

// ─────────────────────────────────────────────
//  ALERTS
// ─────────────────────────────────────────────
alertcondition(cross_bull,                     "🐼 OSC Cross UP 🌸",      "Panda Osc: BUY signal — crossed signal line upward!")
alertcondition(cross_bear,                     "🐼 OSC Cross DOWN 💜",    "Panda Osc: SELL signal — crossed signal line downward!")
alertcondition(ta.crossover(osc, overbought),  "🔥 Entered Overbought",   "Panda Osc: Overbought zone entered — watch for pullback!")
alertcondition(ta.crossunder(osc, oversold),   "💎 Entered Oversold",     "Panda Osc: Oversold zone entered — watch for bounce!")
alertcondition(ta.crossover(osc, 0),           "🌸 OSC Turned Positive",  "Panda Osc: Oscillator crossed above zero — bullish shift")
alertcondition(ta.crossunder(osc, 0),          "💜 OSC Turned Negative",  "Panda Osc: Oscillator crossed below zero — bearish shift")
