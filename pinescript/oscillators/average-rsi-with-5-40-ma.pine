//@version=5
indicator("Average RSI (5 & 40 MA)", overlay=false)

// Inputs
rsi_length = input.int(14, "RSI Length")
ma_short   = input.int(5,  "Short MA Length")
ma_long    = input.int(40, "Long MA Length")

// Calculate RSI of price
rsi_val = ta.rsi(close, rsi_length)

// Calculate MAs of the RSI
rsi_ma_short = ta.sma(rsi_val, ma_short)
rsi_ma_long  = ta.sma(rsi_val, ma_long)

// Average of both MAs
rsi_avg = (rsi_ma_short + rsi_ma_long) / 2

// Plots
plot(rsi_val,      "RSI",           color=color.gray,   linewidth=1)
plot(rsi_ma_short, "RSI MA (5)",    color=color.blue,   linewidth=2)
plot(rsi_ma_long,  "RSI MA (40)",   color=color.orange, linewidth=2)
plot(rsi_avg,      "Avg RSI MA",    color=color.purple, linewidth=2)

// Reference lines
hline(70, "Overbought", color=color.red,   linestyle=hline.style_dashed)
hline(50, "Midline",    color=color.gray,  linestyle=hline.style_dotted)
hline(30, "Oversold",   color=color.green, linestyle=hline.style_dashed)
