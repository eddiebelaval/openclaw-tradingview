//@version=5
//Author: Cyph3r
//TMO Author: Mobius
indicator("TMO True Momentum Oscillator + MTF [Fixed Scale]", shorttitle="TMO MTF", overlay=false, max_bars_back=500)

// ── Inputs ─────────────────────────────────────
groupMain = "Primary TMO"
length       = input.int(14,  "Length",        minval=1, group=groupMain)
calcLength   = input.int(5,   "Calc Length",   minval=1, group=groupMain)
smoothLength = input.int(3,   "Smooth Length", minval=1, group=groupMain)

groupMTF = "MTF Settings"
showMTF      = input.bool(true, "Show MTF Lines", group=groupMTF)
mtfTimeframe = input.timeframe("D", "MTF Timeframe", group=groupMTF)
length2      = input.int(14, "MTF Length",        minval=1, group=groupMTF)
calcLength2  = input.int(5,  "MTF Calc Length",   minval=1, group=groupMTF)
smoothLength2= input.int(3,  "MTF Smooth Length", minval=1, group=groupMTF)

// ── TMO Calculation Function ───────────────────
f_tmo(int len, int clen, int slen) =>
    int data = 0
    for i = 0 to len - 1
        data += close > open[i] ? 1 : close < open[i] ? -1 : 0
    float ema5   = ta.ema(data, clen)
    float main   = ta.ema(ema5, slen)
    float signal = ta.ema(main, slen)
    [main, signal]

// ── Primary TMO (current chart timeframe) ──────
[main, signal] = f_tmo(length, calcLength, smoothLength)

// ── MTF TMO ────────────────────────────────────
[mainMTF, signalMTF] = request.security(syminfo.tickerid, mtfTimeframe, f_tmo(length2, calcLength2, smoothLength2), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// ── Colors ─────────────────────────────────────
colUp    = color.new(#00CCCC, 0)   // Light Cyan
colDn    = color.new(#FF0066, 0)   // Bright Red
colMTFUp = color.yellow
colMTFDn = color.fuchsia

// ── Plots (FIXED: conditional series inside plot(), never conditional plot calls) ──────
pMain   = plot(main,   "Main",   main   > signal   ? colUp : colDn, linewidth=2)
pSignal = plot(signal, "Signal", main   > signal   ? colUp : colDn)

pMainMTF   = plot(showMTF ? mainMTF   : na, "MTF Main",   mainMTF > signalMTF ? colMTFUp : colMTFDn, linewidth=2)
pSignalMTF = plot(showMTF ? signalMTF : na, "MTF Signal", mainMTF > signalMTF ? colMTFUp : colMTFDn, linewidth=1)

// ── Clouds ─────────────────────────────────────
fill(pMain, pSignal, main > signal ? color.new(color.green, 70) : color.new(color.red, 70))

fill(pMainMTF, pSignalMTF, showMTF ? (mainMTF > signalMTF ? color.new(colMTFUp, 75) : color.new(colMTFDn, 75)) : na)

// ── Levels & Zones ─────────────────────────────
hline(0, "Zero", color.gray, hline.style_dashed)

ob = math.round(length * 0.7)
os = -math.round(length * 0.7)
hline(ob,     "Overbought", color.gray)
hline(os,     "Oversold",   color.gray)
hline(length, "Upper",      color.new(color.red, 80))
hline(-length,"Lower",      color.new(color.green, 80))

// Invisible plots for zone fills (FIXED: defined once, not inside fill())
pUpper = plot(length,  display=display.none)
pLower = plot(-length, display=display.none)
pOB    = plot(ob,      display=display.none)
pOS    = plot(os,      display=display.none)

fill(pUpper, pOB, color.new(#FF0066, 85))
fill(pOS, pLower, color.new(#00CCCC, 85))

// ── Crossover Dots (plotted ON the oscillator scale) ──
plot(ta.crossover(main, signal)   ? main   : na, title="Bull Cross",  style=plot.style_circles, color=color.new(color.lime, 0),  linewidth=3)
plot(ta.crossunder(main, signal)  ? main   : na, title="Bear Cross", style=plot.style_circles, color=color.new(color.red, 0),   linewidth=3)

plot(showMTF ? (ta.crossover(mainMTF, signalMTF)  ? mainMTF : na) : na, title="MTF Bull", style=plot.style_circles, color=colMTFUp, linewidth=3)
plot(showMTF ? (ta.crossunder(mainMTF, signalMTF) ? mainMTF : na) : na, title="MTF Bear", style=plot.style_circles, color=colMTFDn, linewidth=3)

// ── Alerts ─────────────────────────────────────
alertcondition(ta.crossover(main, signal),    "Primary Bull Cross", "TMO Bull Cross")
alertcondition(ta.crossunder(main, signal),   "Primary Bear Cross", "TMO Bear Cross")
alertcondition(ta.crossover(mainMTF, signalMTF), "MTF Bull Cross",   "MTF Bull Cross")
alertcondition(ta.crossunder(mainMTF, signalMTF), "MTF Bear Cross",   "MTF Bear Cross")

// ── MTF Label ──────────────────────────────────
var table t = table.new(position.top_right, 1, 1, bgcolor=color.new(color.black, 70))
if barstate.islast and showMTF
    table.cell(t, 0, 0, "MTF: " + (mtfTimeframe == "" ? "Same" : mtfTimeframe), text_color=color.white)
