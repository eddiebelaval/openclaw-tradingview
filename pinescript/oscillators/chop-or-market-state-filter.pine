// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("Market State Filter", shorttitle="Chop Filter", overlay=true)

// --- Inputs ---
groupTrend = "Trend Strength (ADX)"
adxLen     = input.int(14, "ADX Smoothing", minval=1, group=groupTrend, tooltip="Period for ADX calculation.")
adxThresh  = input.int(20, "ADX Threshold", minval=1, group=groupTrend, tooltip="ADX below this value indicates a non-trending (choppy) market.")

groupVolat = "Volatility (ATR)"
atrLen     = input.int(14, "ATR Length", minval=1, group=groupVolat, tooltip="Period for ATR calculation.")
atrMult    = input.float(0.8, "ATR Relative Threshold", minval=0.1, step=0.1, group=groupVolat, tooltip="Filters chop when ATR is below this multiple of its EMA. Lower values are more strict.")

groupVolum = "Volume"
volLen     = input.int(20, "Volume MA Length", minval=1, group=groupVolum, tooltip="Period for Volume Moving Average.")
useVol     = input.bool(true, "Use Volume Filter", group=groupVolum, tooltip="Include low volume as a condition for chop.")

groupCong  = "Congestion Filter"
useCong    = input.bool(true, "Use Congestion Filter", group=groupCong, tooltip="Filters chop when the last X bars stay within a narrow range.")
congBars   = input.int(5, "Congestion Bars", minval=2, group=groupCong, tooltip="Number of bars to check for a narrow range.")
congPerc   = input.float(1.5, "Congestion Range Mult", minval=0.1, step=0.1, group=groupCong, tooltip="The max height of the congestion zone as a multiple of ATR.")

groupStyle = "Style"
chopColor  = input.color(color.new(#f23645, 85), "Chop Background Color", group=groupStyle)

// --- Logic ---
// 1. ADX Calculation
[plus, minus, adx] = ta.dmi(adxLen, adxLen)
isLowTrend = adx < adxThresh

// 2. Relative Volatility (ATR)
atr = ta.atr(atrLen)
atrEma = ta.ema(atr, atrLen * 2)
isLowVolat = atr < (atrEma * atrMult)

// 3. Volume Filter
volMa = ta.sma(volume, volLen)
isLowVolum = useVol ? volume < volMa : false

// 4. Congestion Filter (Range-bound detection)
highestHigh = ta.highest(high, congBars)
lowestLow   = ta.lowest(low, congBars)
rangeHeight = highestHigh - lowestLow
// If the range of the last 5 bars is smaller than 1.5x the current ATR, it's congestion
isCongested = useCong ? rangeHeight < (atr * congPerc) : false

// Determine Chop Condition
isChop = isLowTrend and (isLowVolat or isLowVolum or isCongested)

// --- Visuals ---
bgcolor(isChop ? chopColor : na, title="Chop Zone")

// Indicators on bottom for status
plotshape(isChop, "Chop Detected", shape.square, location.bottom, color=chopColor, size=size.tiny)

// Alerts
alertcondition(isChop, title="Chop Detected", message="Market is entering a choppy state.")
alertcondition(not isChop and isChop[1], title="Trend Resuming", message="Market is exiting a choppy state.")
