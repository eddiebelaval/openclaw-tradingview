//@version=6
indicator("ATR Normalized Relative Strength - V2", shorttitle="RS ATR Normalized - V2", overlay=false)

compare_symbol = input.symbol("NASDAQ:QQQ", "Compare To")
atr_len = input.int(14, "ATR Length", minval=1)
normalization_mode = input.string("ATR%", "Normalization", options=["ATR%", "ATR Price"])
display_mode = input.string("RS", "Display", options=["RS", "Mansfield"])

rs_ma_type = input.string("SMA", "RS MA Type", options=["SMA", "EMA"])
rs_ma_len = input.int(50, "RS MA Length", minval=1)
color_by_ma = input.bool(true, "Color RS By MA")

mansfield_len = input.int(200, "Mansfield Length", minval=1)
mansfield_scale = input.float(100.0, "Mansfield Scale", minval=0.1)
show_mansfield_zero = input.bool(true, "Show Mansfield Zero Line")

base_atr = ta.atr(atr_len)
base_atr_pct = (not na(base_atr) and close != 0.0) ? base_atr / close : na
base_norm_atr = (not na(base_atr) and base_atr != 0.0) ? close / base_atr : na
base_norm_atr_pct = (not na(base_atr_pct) and base_atr_pct != 0.0) ? close / base_atr_pct : na
base_norm = normalization_mode == "ATR Price" ? base_norm_atr : base_norm_atr_pct

comp_close = request.security(compare_symbol, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
comp_atr = request.security(compare_symbol, timeframe.period, ta.atr(atr_len), barmerge.gaps_off, barmerge.lookahead_off)
comp_atr_pct = (not na(comp_atr) and comp_close != 0.0) ? comp_atr / comp_close : na
comp_norm_atr = (not na(comp_atr) and comp_atr != 0.0) ? comp_close / comp_atr : na
comp_norm_atr_pct = (not na(comp_atr_pct) and comp_atr_pct != 0.0) ? comp_close / comp_atr_pct : na
comp_norm = normalization_mode == "ATR Price" ? comp_norm_atr : comp_norm_atr_pct

atr_normalized_rs = (not na(base_norm) and not na(comp_norm) and comp_norm != 0.0) ? base_norm / comp_norm : na
rs_ma = rs_ma_type == "EMA" ? ta.ema(atr_normalized_rs, rs_ma_len) : ta.sma(atr_normalized_rs, rs_ma_len)

rs_color = color_by_ma and not na(atr_normalized_rs) and not na(rs_ma) ? (atr_normalized_rs >= rs_ma ? color.lime : color.red) : color.white
plot(display_mode == "RS" ? atr_normalized_rs : na, title="ATR Normalized RS", linewidth=2, color=rs_color)
plot(display_mode == "RS" ? rs_ma : na, title="RS MA", linewidth=2, color=color.gray)

mansfield_base = atr_normalized_rs
mansfield_ma = ta.sma(mansfield_base, mansfield_len)
mansfield = (not na(mansfield_base) and not na(mansfield_ma) and mansfield_ma != 0.0) ? (mansfield_base / mansfield_ma - 1.0) * mansfield_scale : na
plot(display_mode == "Mansfield" ? mansfield : na, title="Mansfield RS", linewidth=2, color=color.white)
plot(display_mode == "Mansfield" and show_mansfield_zero ? 0.0 : na, title="Mansfield Zero", linewidth=1, color=color.gray)
