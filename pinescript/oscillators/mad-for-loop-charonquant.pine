//@version=6
indicator("MAD For-Loop ~ CharonQuant")

//MA
MAGP = "MA"
ma_type = input.string("EMA", "MA Type", options = ["SMA","EMA","WMA","RMA","VWMA","HMA","ALMA"],group = MAGP)
ma_len  = input.int(25, "MA Length",group = MAGP)
ma_src  = input.source(high, "MA Source",group = MAGP)
f_hma(_src, _len) =>
    ta.wma(2 * ta.wma(_src, _len / 2) - ta.wma(_src, _len), math.round(math.sqrt(_len)))

f_alma(_src, _len) =>
    ta.alma(_src, _len, 0.85, 6)
ma = switch ma_type
    "SMA"  => ta.sma (ma_src, ma_len)
    "EMA"  => ta.ema (ma_src, ma_len)
    "WMA"  => ta.wma (ma_src, ma_len)
    "RMA"  => ta.rma (ma_src, ma_len)
    "VWMA" => ta.vwma(ma_src, ma_len)
    "HMA"  => f_hma (ma_src, ma_len)
    "ALMA" => f_alma(ma_src, ma_len)
    => na

//For Loop
loopGP = "For-Loop"
from = input.int(0,  "From", group = loopGP)
to_  = input.int(18, "To",   group = loopGP)
float loop = 0.0
if bar_index >= to_
    for i = from to to_
        loop += ma > ma[i] ? 1 : -1

//MAD
MADpGP = "MAD"
mad_len = input.int(30, "MAD Length", group = MADpGP)
mean_loop = ta.sma(loop, mad_len)
abs_dev = math.abs(loop - mean_loop)
mad = ta.sma(abs_dev, mad_len)
upper = loop + mad
lower = loop - mad

//Conditions
LongCondition  = lower > 0
ShortCondition = upper < 0

var int CharonQuant = 0

if LongCondition and not ShortCondition
    CharonQuant := 1
if ShortCondition
    CharonQuant := -1

//plots
color BULL = #D4A017
color BEAR = #6B2A3A
loopColor =
     CharonQuant == 1  ? BULL :
     CharonQuant == -1 ? BEAR :
     color.gray
plot(loop,
     title = "MAD For-Loop",
     color = loopColor,
     linewidth = 2)
plot(upper,
     title = "Upper MAD",
     color = color.new(BULL, 40),
     linewidth = 1)
plot(lower,
     title = "Lower MAD",
     color = color.new(BEAR, 40),
     linewidth = 1)

hline(0,
     "Equilibrium",
     color = color.new(color.white, 80))
bgcolor(
     CharonQuant == 1  ? color.new(BULL, 90) :
     CharonQuant == -1 ? color.new(BEAR, 90) :
     na)
plotcandle(
     open, high, low, close,
     title="Candles",
     color=loopColor,
     wickcolor=loopColor,
     bordercolor=loopColor,
     force_overlay=true
)
