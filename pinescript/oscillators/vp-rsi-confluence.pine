//@version=6
indicator("VP RSI Confluence", overlay=true, max_bars_back=500)

// ═══════════════ INPUTS ═══════════════
vpLength    = input.int(100, "VP Lookback Bars", minval=20)
numRows     = input.int(50, "Number of VP Rows", minval=10)
vaPercent   = input.float(70.0, "Value Area %", minval=50, maxval=95) / 100.0
rsiLen      = input.int(14, "RSI Length")
rsiOB       = input.int(70, "RSI Overbought")
rsiOS       = input.int(30, "RSI Oversold")
pocSkew     = input.float(0.3, "POC Skew Threshold", minval=0.1, maxval=0.5, tooltip="How close POC must be to VAH/VAL (0=at edge, 0.5=middle)")
proximity   = input.float(0.5, "Price Proximity to VA Edge %", minval=0.1, maxval=2.0) / 100.0

// ═══════════════ VOLUME PROFILE CALC ═══════════════
highestHigh = ta.highest(high, vpLength)
lowestLow   = ta.lowest(low, vpLength)
priceRange  = highestHigh - lowestLow
rowHeight   = priceRange / numRows

// Build volume profile
var float[] volProfile = array.new_float(50, 0.0)
if bar_index >= vpLength
    for i = 0 to numRows - 1
        array.set(volProfile, i, 0.0)
    for j = 0 to vpLength - 1
        idx = math.min(math.floor((close[j] - lowestLow) / rowHeight), numRows - 1)
        if idx >= 0 and idx < numRows
            array.set(volProfile, idx, array.get(volProfile, idx) + volume[j])

// Find POC (row with max volume)
var int pocIdx = 0
float maxVol = 0.0
for i = 0 to numRows - 1
    if array.get(volProfile, i) > maxVol
        maxVol := array.get(volProfile, i)
        pocIdx := i

float pocPrice = lowestLow + (pocIdx + 0.5) * rowHeight

// Calculate Value Area (VAH / VAL)
float totalVol = array.sum(volProfile)
float vaTargetVol = totalVol * vaPercent
float vaVol = array.get(volProfile, pocIdx)
int upperIdx = pocIdx
int lowerIdx = pocIdx

while vaVol < vaTargetVol and (upperIdx < numRows - 1 or lowerIdx > 0)
    float upVol = upperIdx < numRows - 1 ? array.get(volProfile, upperIdx + 1) : 0.0
    float dnVol = lowerIdx > 0 ? array.get(volProfile, lowerIdx - 1) : 0.0
    if upVol >= dnVol and upperIdx < numRows - 1
        upperIdx += 1
        vaVol += upVol
    else if lowerIdx > 0
        lowerIdx -= 1
        vaVol += dnVol
    else
        upperIdx += 1
        vaVol += upVol

float vahPrice = lowestLow + (upperIdx + 1) * rowHeight
float valPrice = lowestLow + lowerIdx * rowHeight

// ═══════════════ RSI ═══════════════
float rsiVal = ta.rsi(close, rsiLen)

// ═══════════════ POC SKEW ═══════════════
float vaRange = vahPrice - valPrice
float pocPosition = vaRange != 0 ? (pocPrice - valPrice) / vaRange : 0.5
bool pocNearVAL = pocPosition < pocSkew
bool pocNearVAH = pocPosition > (1.0 - pocSkew)

// ═══════════════ SIGNAL CONDITIONS ═══════════════
float proxAmt = close * proximity
bool nearVAL = math.abs(close - valPrice) < proxAmt
bool nearVAH = math.abs(close - vahPrice) < proxAmt
bool belowVAL = close < valPrice

// Signal logic
bool strongBuy  = nearVAL and pocNearVAL and rsiVal < rsiOS
bool buySignal  = nearVAL and rsiVal < rsiOS and not strongBuy
bool strongSell = nearVAH and pocNearVAH and rsiVal > rsiOB
bool sellSignal = nearVAH and rsiVal > rsiOB and not strongSell
bool dangerZone = belowVAL and pocNearVAL and ta.falling(ta.mom(close, 10), 3)

// ═══════════════ PLOTS ═══════════════
// VP levels
plot(pocPrice, "POC", color=color.red, linewidth=2, style=plot.style_line)
plot(vahPrice, "VAH", color=color.new(color.aqua, 30), linewidth=1, style=plot.style_line)
plot(valPrice, "VAL", color=color.new(color.aqua, 30), linewidth=1, style=plot.style_line)

// Signal labels
plotshape(strongBuy,  title="Strong Buy",  location=location.belowbar, style=shape.labelup,   color=color.green,  textcolor=color.white, text="STRONG\nBUY",  size=size.normal)
plotshape(buySignal,  title="Buy",         location=location.belowbar, style=shape.triangleup, color=color.lime,   textcolor=color.white, text="BUY",          size=size.small)
plotshape(strongSell, title="Strong Sell", location=location.abovebar, style=shape.labeldown, color=color.red,    textcolor=color.white, text="STRONG\nSELL", size=size.normal)
plotshape(sellSignal, title="Sell",        location=location.abovebar, style=shape.triangledown, color=color.orange, textcolor=color.white, text="SELL",         size=size.small)
plotshape(dangerZone, title="Danger",      location=location.belowbar, style=shape.xcross,    color=color.purple, textcolor=color.white, text="DANGER",       size=size.small)

// Background shading
bgcolor(close > vahPrice ? color.new(color.red, 90) : close < valPrice ? color.new(color.green, 90) : na)

// ═══════════════ INFO TABLE ═══════════════
var table infoTable = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(infoTable, 0, 0, "POC",       text_color=color.red,   text_size=size.small)
    table.cell(infoTable, 1, 0, str.tostring(pocPrice, format.mintick), text_color=color.red, text_size=size.small)
    table.cell(infoTable, 0, 1, "VAH",       text_color=color.aqua,  text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(vahPrice, format.mintick), text_color=color.aqua, text_size=size.small)
    table.cell(infoTable, 0, 2, "VAL",       text_color=color.aqua,  text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(valPrice, format.mintick), text_color=color.aqua, text_size=size.small)
    table.cell(infoTable, 0, 3, "RSI",       text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(rsiVal, "#.##"), text_color=rsiVal > rsiOB ? color.red : rsiVal < rsiOS ? color.green : color.white, text_size=size.small)
    table.cell(infoTable, 0, 4, "POC Skew",  text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, pocNearVAH ? "↑ Near VAH" : pocNearVAL ? "↓ Near VAL" : "— Neutral", text_color=pocNearVAH ? color.red : pocNearVAL ? color.green : color.gray, text_size=size.small)
    table.cell(infoTable, 0, 5, "Signal",    text_color=color.yellow, text_size=size.small)
    table.cell(infoTable, 1, 5, strongBuy ? "STRONG BUY" : buySignal ? "BUY" : strongSell ? "STRONG SELL" : sellSignal ? "SELL" : dangerZone ? "DANGER" : "NONE", text_color=strongBuy ? color.green : buySignal ? color.lime : strongSell ? color.red : sellSignal ? color.orange : dangerZone ? color.purple : color.gray, text_size=size.small)

// ═══════════════ ALERTS ═══════════════
alertcondition(strongBuy,  title="Strong Buy",  message="VP RSI Confluence: STRONG BUY — Price at VAL + POC support + RSI oversold")
alertcondition(buySignal,  title="Buy Signal",  message="VP RSI Confluence: BUY — Price at VAL + RSI oversold")
alertcondition(strongSell, title="Strong Sell", message="VP RSI Confluence: STRONG SELL — Price at VAH + POC resistance + RSI overbought")
alertcondition(sellSignal, title="Sell Signal", message="VP RSI Confluence: SELL — Price at VAH + RSI overbought")
alertcondition(dangerZone, title="Danger Zone", message="VP RSI Confluence: DANGER — Breakdown below VAL + POC with falling momentum")
