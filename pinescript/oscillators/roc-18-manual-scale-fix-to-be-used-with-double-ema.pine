//@version=5
indicator("ROC 18 - Manual Scale Fix", overlay=false, precision=2)

// 1. Settings
rocLen = 18
src = close

// 2. Calculation
rocVal = ta.roc(src, rocLen)

// 3. THE "MANUAL" FIX
// We plot an invisible value at -10.5. 
// This forces the Y-axis to show the -10 area at all times.
plot(-10.5, color=color.new(color.white, 100), title="Force Scale Bottom")
plot(2, color=color.new(color.white, 100), title="Force Scale Top")

// 4. Visible Coordinates
hline(0, "Zero Line", color=color.gray, linestyle=hline.style_dotted)
hline(-10, "Your -10 Level", color=color.red, linewidth=2)

// 5. The ROC Line
plot(rocVal, color=#2196f3, linewidth=2, title="ROC Line")

// 6. Highlight Area (Optional)
// Turns the background slightly red when you hit your -10 target
bgcolor(rocVal <= -10 ? color.new(color.red, 85) : na)
