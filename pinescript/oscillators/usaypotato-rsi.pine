//@version=5
indicator("Usaypotato RSI", shorttitle="Usaypotato RSI", overlay=false)

// Inputs
rsiLength = input.int(14, title="RSI Length")
source = input.source(close, title="Source")
maLength = input.int(14, title="MA Length")
maType = input.string("SMA", title="MA Type", options=["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"])

// RSI
rsi = ta.rsi(source, rsiLength)

// MA on RSI
ma(src, length, type) =>
    switch type
        "SMA"        => ta.sma(src, length)
        "EMA"        => ta.ema(src, length)
        "SMMA (RMA)" => ta.rma(src, length)
        "WMA"        => ta.wma(src, length)
        "VWMA"       => ta.vwma(src, length)

rsiMA = ma(rsi, maLength, maType)

// Levels
obLevel = input.int(70, title="Overbought Level")
osLevel = input.int(30, title="Oversold Level")

hline(obLevel, "Overbought", color=#787B86, linestyle=hline.style_dashed)
hline(50,      "Middle",     color=#787B86, linestyle=hline.style_dotted)
hline(osLevel, "Oversold",   color=#787B86, linestyle=hline.style_dashed)

// Background
bgColor = rsi > obLevel ? color.new(color.green, 70) :
          rsi < osLevel ? color.new(color.red,   70) :
          rsi >= 50     ? color.new(color.green, 88) :
                          color.new(color.red,   88)

bgcolor(bgColor)

plot(rsi,   title="RSI",          color=#7E57C2, linewidth=2)
plot(rsiMA, title="RSI-based MA", color=#F9A825, linewidth=1)
