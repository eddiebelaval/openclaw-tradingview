//@version=5
indicator("Z-Score (Gradient) — Fixed", overlay=false)

//====================
// Inputs
//====================
src       = input.source(close, "Source")
len       = input.int(50, "Lookback", minval=5)
anchorOpt = input.string("VWAP", "Anchor", options=["VWAP", "SMA", "EMA", "KAMA", "Kalman"])
volOpt    = input.string("Stdev (classic)", "Volatility", options=["Stdev (classic)", "MAD Approx (robust-ish)"])
madK      = input.float(1.4826, "MAD Scale (≈Stdev)", step=0.0001)

// KAMA tuning
kamaLen = input.int(21, "KAMA Length", minval=1)

// Kalman tuning
kalmanQ = input.float(0.01, "Kalman Process Noise (Q)", minval=0.0001, maxval=1.0, step=0.005)
kalmanR = input.float(1.0, "Kalman Measurement Noise (R)", minval=0.01, maxval=10.0, step=0.1)

//====================
// KAMA
//====================
nfastend = 2.0 / (2.0 + 1.0)
nslowend = 2.0 / (30.0 + 1.0)

xvnoise  = math.abs(src - src[1])
nsignal  = math.abs(src - src[kamaLen])
nnoise   = math.sum(xvnoise, kamaLen)
nefratio = nnoise != 0 ? nsignal / nnoise : 0.0
nsmooth  = math.pow(nefratio * (nfastend - nslowend) + nslowend, 2)

var float nAMA = na
nAMA := na(nAMA[1]) ? src : nAMA[1] + nsmooth * (src - nAMA[1])

//====================
// Kalman Filter (1-D)
//====================
var float kalmanX = na
var float kalmanP = 1.0

kalmanPpred = kalmanP + kalmanQ
kalmanK     = kalmanPpred / (kalmanPpred + kalmanR)
kalmanX     := na(kalmanX) ? src : kalmanX + kalmanK * (src - kalmanX)
kalmanP     := (1.0 - kalmanK) * kalmanPpred

//====================
// Anchor
//====================
basis = switch anchorOpt
    "VWAP"   => ta.vwap(src)
    "SMA"    => ta.sma(src, len)
    "EMA"    => ta.ema(src, len)
    "KAMA"   => nAMA
    "Kalman" => kalmanX

//====================
// Volatility
//====================
st = ta.stdev(src, len)
med = ta.percentile_linear_interpolation(src, len, 50)
madApprox = ta.percentile_linear_interpolation(math.abs(src - med), len, 50)
robustVol = madK * madApprox

vol     = volOpt == "Stdev (classic)" ? st : robustVol
volSafe = math.max(vol, syminfo.mintick)

//====================
// Z-score
//====================
z = (src - basis) / volSafe

//====================
// Gradient Color Logic
//====================
zClamped = math.max(math.min(z, 3.0), -3.0)
lineColor = zClamped >= 0 ? color.from_gradient(zClamped, 0, 3, color.new(color.green, 70), color.green) : color.from_gradient(zClamped, -3, 0, color.red, color.new(color.red, 70))

//====================
// Plot
//====================
hline(0, "Mean")
hline(2, "+2", linestyle=hline.style_dotted)
hline(-2, "-2", linestyle=hline.style_dotted)
hline(3, "+3", linestyle=hline.style_dashed)
hline(-3, "-3", linestyle=hline.style_dashed)

plot(z, "Z", color=lineColor, linewidth=2)
