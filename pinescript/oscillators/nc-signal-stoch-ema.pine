//@version=6
indicator("NC Signal Stoch + EMA", overlay=true, max_labels_count=500)

// Inputs
emaFastLen = input.int(9, "EMA Fast", minval=1)
emaSlowLen = input.int(21, "EMA Slow", minval=1)

kLen       = input.int(14, "Stochastic Length", minval=1)
kSmooth    = input.int(3, "K Smoothing", minval=1)

atrLen     = input.int(14, "ATR Length", minval=1)
slAtrMult  = input.float(1.0, "SL ATR Mult", step=0.1)

tp1RR      = input.float(1.0, "TP1 RR", step=0.1)
tp2RR      = input.float(2.0, "TP2 RR", step=0.1)
tp3RR      = input.float(3.0, "TP3 RR", step=0.1)

// Indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
atrVal  = ta.atr(atrLen)

// Manual stochastic
lowestLow   = ta.lowest(low, kLen)
highestHigh = ta.highest(high, kLen)
rawK        = highestHigh != lowestLow ? 100 * (close - lowestLow) / (highestHigh - lowestLow) : 0
stochK      = ta.sma(rawK, kSmooth)

// Trend filter
longTrend  = emaFast > emaSlow
shortTrend = emaFast < emaSlow

// Signal logic
buySignal  = longTrend and ta.crossover(stochK, 20)
sellSignal = shortTrend and ta.crossunder(stochK, 80)

// Trade levels
var float entryPrice = na
var float slPrice    = na
var float tp1Price   = na
var float tp2Price   = na
var float tp3Price   = na

// BUY
if buySignal
    entryPrice := close
    slPrice    := close - atrVal * slAtrMult
    risk       = entryPrice - slPrice
    tp1Price   := entryPrice + risk * tp1RR
    tp2Price   := entryPrice + risk * tp2RR
    tp3Price   := entryPrice + risk * tp3RR

    buyText = "BUY\n" +
      "Entry: " + str.tostring(entryPrice, format.mintick) + "\n" +
      "SL: " + str.tostring(slPrice, format.mintick) + "\n" +
      "TP1: " + str.tostring(tp1Price, format.mintick) + "\n" +
      "TP2: " + str.tostring(tp2Price, format.mintick) + "\n" +
      "TP3: " + str.tostring(tp3Price, format.mintick)

    label.new(bar_index, low, buyText, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)

// SELL
if sellSignal
    entryPrice := close
    slPrice    := close + atrVal * slAtrMult
    risk       = slPrice - entryPrice
    tp1Price   := entryPrice - risk * tp1RR
    tp2Price   := entryPrice - risk * tp2RR
    tp3Price   := entryPrice - risk * tp3RR

    sellText = "SELL\n" +
      "Entry: " + str.tostring(entryPrice, format.mintick) + "\n" +
      "SL: " + str.tostring(slPrice, format.mintick) + "\n" +
      "TP1: " + str.tostring(tp1Price, format.mintick) + "\n" +
      "TP2: " + str.tostring(tp2Price, format.mintick) + "\n" +
      "TP3: " + str.tostring(tp3Price, format.mintick)

    label.new(bar_index, high, sellText, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

// Plots
plot(emaFast, "EMA 9", color=color.yellow, linewidth=2)
plot(emaSlow, "EMA 21", color=color.orange, linewidth=2)

plot(entryPrice, "Entry", color=color.white, linewidth=2, style=plot.style_linebr)
plot(slPrice, "SL", color=color.red, linewidth=2, style=plot.style_linebr)
plot(tp1Price, "TP1", color=color.lime, linewidth=2, style=plot.style_linebr)
plot(tp2Price, "TP2", color=color.green, linewidth=2, style=plot.style_linebr)
plot(tp3Price, "TP3", color=color.teal, linewidth=2, style=plot.style_linebr)

// Visual signals
plotshape(buySignal, title="BUY Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.normal, text="BUY")
plotshape(sellSignal, title="SELL Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.normal, text="SELL")

// Alerts
alertcondition(buySignal, title="BUY Alert", message="NC BUY Signal")
alertcondition(sellSignal, title="SELL Alert", message="NC SELL Signal")
