//@version=6
indicator("Price Normalized RSI Profile [UAlgo]", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

group_rsi = "RSI Settings"
int rsi_len = input.int(14, "RSI Length", minval=1, group=group_rsi)
float rsi_src = input.source(close, "Source", group=group_rsi)

group_vp = "Volume Profile Settings"
int lookback = input.int(300, "Profile Lookback (Bars)", minval=50, maxval=5000, group=group_vp, tooltip="How many past bars to include in the volume profile.")
int bin_count = input.int(20, "Resolution (Bins)", minval=5, maxval=100, group=group_vp, tooltip="Number of vertical bins. Lower values = Thicker bars, smoother profile.")
int width_bars = input.int(50, "Profile Width (Bars)", minval=10, maxval=200, group=group_vp, tooltip="Maximum width of the profile in bars.")
int offset_val = input.int(10, "Horizontal Offset", group=group_vp)
float va_pct = input.float(70.0, "Value Area (%)", minval=0, maxval=100, group=group_vp, tooltip="Percentage of volume to include in the Value Area.")

group_style = "Visuals"
color col_bull = input.color(#089981, "Bullish Color", group=group_style)
color col_bear = input.color(#F23645, "Bearish Color", group=group_style)
color col_poc  = input.color(#FFD700, "POC Color", group=group_style)
color col_va   = input.color(#FFFFFF, "VA Highlight", group=group_style)

type RsiBin
    float min_val
    float max_val
    float volume
    int   count

type RsiProfile
    array<RsiBin> bins
    float max_vol
    float total_vol
    int   poc_idx
    int   va_top_idx
    int   va_bot_idx

method init(RsiProfile this, int bins_count) =>
    this.bins := array.new<RsiBin>()
    this.max_vol := 0.0
    this.total_vol := 0.0
    this.poc_idx := 0
    this.va_top_idx := 0
    this.va_bot_idx := 0
    
    float step = 100.0 / bins_count
    
    for i = 0 to bins_count - 1
        float min_v = i * step
        float max_v = (i + 1) * step
        this.bins.push(RsiBin.new(min_v, max_v, 0.0, 0))

method populate(RsiProfile this, float[] rsi_series, float[] vol_series, int lookback_len) =>
    int data_size = rsi_series.size()
    int start_idx = math.max(0, data_size - lookback_len)
    
    this.max_vol := 0.0
    this.total_vol := 0.0
    this.poc_idx := 0
    
    for i = start_idx to data_size - 1
        float r_val = rsi_series.get(i)
        float v_val = vol_series.get(i)
        
        if not na(r_val) and not na(v_val)
            int bin_idx = math.floor(r_val / 100.0 * this.bins.size())
            
            bin_idx := math.min(bin_idx, this.bins.size() - 1)
            bin_idx := math.max(bin_idx, 0)
            
            RsiBin b = this.bins.get(bin_idx)
            b.volume += v_val
            b.count += 1
            
            this.total_vol += v_val
            
            if b.volume > this.max_vol
                this.max_vol := b.volume
                this.poc_idx := bin_idx

method calc_va(RsiProfile this, float va_percent) =>
    if this.total_vol > 0
        float target_vol = this.total_vol * (va_percent / 100.0)
        float current_vol = this.bins.get(this.poc_idx).volume
        
        int top = this.poc_idx
        int bot = this.poc_idx
        int max_idx = this.bins.size() - 1
        
        while current_vol < target_vol
            float vol_up = (top < max_idx) ? this.bins.get(top + 1).volume : 0.0
            float vol_dn = (bot > 0) ? this.bins.get(bot - 1).volume : 0.0
            
            if vol_up > vol_dn
                top += 1
                current_vol += vol_up
            else if vol_dn > 0
                bot -= 1
                current_vol += vol_dn
            else if vol_up > 0
                top += 1
                current_vol += vol_up
            else
                break
        
        this.va_top_idx := top
        this.va_bot_idx := bot

method render(RsiProfile this, int bar_idx, int max_width, int x_offset, color c_bull, color c_bear, color c_poc, color c_va, float chart_high, float chart_low) =>
    int right_edge = bar_idx + x_offset
    
    float price_range = chart_high - chart_low
    
    if price_range <= 0
        price_range := syminfo.mintick * 100
    
    for i = 0 to this.bins.size() - 1
        RsiBin b = this.bins.get(i)
        
        if b.volume > 0
            float y_bottom = chart_low + (b.min_val / 100.0) * price_range
            float y_top    = chart_low + (b.max_val / 100.0) * price_range
            
            bool is_in_va = (i >= this.va_bot_idx and i <= this.va_top_idx)
            bool is_poc = (i == this.poc_idx)
            
            int bar_w = math.round((b.volume / this.max_vol) * max_width)
            if is_poc
                bar_w := int(max_width * 1.15)
            
            color base_col = color.from_gradient(b.min_val, 0, 100, c_bull, c_bear)
            
            color final_bg = base_col
            color final_border = color.new(base_col, 50)
            
            if is_poc
                final_bg := color.new(c_poc, 20)
                final_border := c_poc
            else if is_in_va
                final_bg := color.new(base_col, 40)
                final_border := color.new(base_col, 20)
            else
                final_bg := color.new(base_col, 80)
                final_border := color.new(base_col, 60)
            
            box.new(left=right_edge, top=y_top, right=right_edge + bar_w, bottom=y_bottom, 
                     border_color=final_border, 
                     border_width=1,
                     bgcolor=final_bg,
                     xloc=xloc.bar_index)
            
            if is_poc
                label.new(x=right_edge + bar_w, y=(y_top + y_bottom) / 2, 
                          text="POC\n" + str.tostring(b.volume, format.volume),
                          style=label.style_none,
                          textcolor=c_poc,
                          size=size.small)
                          
    float price_range_val = chart_high - chart_low
    if price_range_val <= 0
        price_range_val := syminfo.mintick * 100
        
    if this.va_top_idx < this.bins.size()
        RsiBin b_vah = this.bins.get(this.va_top_idx)
        float vah_level = chart_low + (b_vah.max_val / 100.0) * price_range_val
        line.new(bar_idx + x_offset, vah_level, bar_idx + x_offset + max_width, vah_level, color=color.new(c_va, 50), style=line.style_dashed)
        label.new(bar_idx + x_offset + max_width, vah_level, "VAH", style=label.style_none, textcolor=color.new(c_va, 50), size=size.tiny)

    if this.va_bot_idx >= 0
        RsiBin b_val = this.bins.get(this.va_bot_idx)
        float val_level = chart_low + (b_val.min_val / 100.0) * price_range_val
        line.new(bar_idx + x_offset, val_level, bar_idx + x_offset + max_width, val_level, color=color.new(c_va, 50), style=line.style_dashed)
        label.new(bar_idx + x_offset + max_width, val_level, "VAL", style=label.style_none, textcolor=color.new(c_va, 50), size=size.tiny)

float rsi_val = ta.rsi(rsi_src, rsi_len)

var float[] rsi_history = array.new<float>()
var float[] vol_history = array.new<float>()

rsi_history.push(rsi_val)
vol_history.push(volume)

if rsi_history.size() > lookback + 100
    rsi_history.shift()
    vol_history.shift()

var RsiProfile vp = RsiProfile.new()

float chart_high = ta.highest(high, lookback)
float chart_low = ta.lowest(low, lookback)

if barstate.islast
    vp.init(bin_count)
    vp.populate(rsi_history, vol_history, lookback)
    vp.calc_va(va_pct)
    vp.render(bar_index, width_bars, offset_val, col_bull, col_bear, col_poc, col_va, chart_high, chart_low)
    
    int start_bar_idx = bar_index - lookback
    line.new(start_bar_idx, chart_low, start_bar_idx, chart_high, color=color.new(color.gray, 50), style=line.style_dotted, width=1)
    label.new(start_bar_idx, chart_high, "Profile Start", style=label.style_none, textcolor=color.new(color.gray, 50), size=size.tiny)
    
    line.new(start_bar_idx, chart_low, bar_index + offset_val + width_bars, chart_low, color=color.new(col_bull, 80), style=line.style_dotted)
    line.new(start_bar_idx, chart_high, bar_index + offset_val + width_bars, chart_high, color=color.new(col_bear, 80), style=line.style_dotted)
