//@version=5
indicator(title="AO 3+1 + Williams Fraktal & Alligator Sinyali", shorttitle="AO_Fraktal_Signal", overlay=true)

smma(src, length) =>
    var float smma_val = na
    smma_val := na(smma_val[1]) ? ta.sma(src, length) : (smma_val[1] * (length - 1) + src) / length
    smma_val

// ─────────────────────────────────────────────
// WILLIAMS ALLIGATOR
// ─────────────────────────────────────────────
jaw   = smma(hl2, 13)
teeth = smma(hl2, 8)
lips  = smma(hl2, 5)

plot(jaw,   title="Alligator Cene",  color=color.blue,  linewidth=2, offset=8)
plot(teeth, title="Alligator Dis",   color=color.red,   linewidth=2, offset=5)
plot(lips,  title="Alligator Dudak", color=color.green, linewidth=2, offset=3)

jaw_val   = smma(hl2, 13)[8]
teeth_val = smma(hl2, 8)[5]
lips_val  = smma(hl2, 5)[3]

// ─────────────────────────────────────────────
// WILLIAMS FRAKTALLARI
// ─────────────────────────────────────────────
fractal_up   = high[2] > high[4] and high[2] > high[3] and high[2] > high[1] and high[2] > high[0]
fractal_down = low[2]  < low[4]  and low[2]  < low[3]  and low[2]  < low[1]  and low[2]  < low[0]

teeth_at_fractal = smma(hl2, 8)[7]

valid_fractal_up   = fractal_up   and high[2] > teeth_at_fractal
valid_fractal_down = fractal_down and low[2]  < teeth_at_fractal

plotshape(valid_fractal_up,   title="Yukselis Fraktali", style=shape.triangleup,
     location=location.abovebar, offset=-2,
     color=color.new(color.aqua, 0), size=size.tiny)
plotshape(valid_fractal_down, title="Dusus Fraktali", style=shape.triangledown,
     location=location.belowbar, offset=-2,
     color=color.new(color.orange, 0), size=size.tiny)

var float last_valid_fractal_up_level   = na
var float last_valid_fractal_down_level = na

fractal_up_break   = not na(last_valid_fractal_up_level)   and high > last_valid_fractal_up_level
fractal_down_break = not na(last_valid_fractal_down_level) and low  < last_valid_fractal_down_level

if valid_fractal_up
    last_valid_fractal_up_level := high[2]
if fractal_up_break
    last_valid_fractal_up_level := na

if valid_fractal_down
    last_valid_fractal_down_level := low[2]
if fractal_down_break
    last_valid_fractal_down_level := na

plot(last_valid_fractal_up_level,   title="Son Yukselis Fraktali",
     color=color.new(color.aqua,   50), linewidth=1, style=plot.style_stepline)
plot(last_valid_fractal_down_level, title="Son Dusus Fraktali",
     color=color.new(color.orange, 50), linewidth=1, style=plot.style_stepline)

// ─────────────────────────────────────────────
// AWESOME OSCILLATOR
// ─────────────────────────────────────────────
ao = ta.sma(hl2, 5) - ta.sma(hl2, 34)

ao_positive = ao > ao[1]
ao_negative = ao < ao[1]

// ─────────────────────────────────────────────
// AO SAYAC MEKANIZMASI
// ─────────────────────────────────────────────
var int   green_count      = 0
var int   red_count        = 0
var bool  after_red        = false
var bool  after_green      = false
var float third_green_high = na
var float third_red_low    = na
var bool  waiting_for_buy  = false
var bool  waiting_for_sell = false

if ao_negative
    after_red        := true
    green_count      := 0
    third_green_high := na
    waiting_for_buy  := false
    if after_green
        red_count := red_count + 1
        if red_count == 3
            third_red_low    := low
            waiting_for_sell := true

if ao_positive
    after_green      := true
    red_count        := 0
    third_red_low    := na
    waiting_for_sell := false
    if after_red
        green_count := green_count + 1
        if green_count == 3
            third_green_high := high
            waiting_for_buy  := true

// ─────────────────────────────────────────────
// AO HAM SINYALLER
// ─────────────────────────────────────────────
ao_buy_raw  = waiting_for_buy  and ao_positive and high > third_green_high
ao_sell_raw = waiting_for_sell and ao_negative and low  < third_red_low

// ─────────────────────────────────────────────
// BLOK MEKANIZMASI
// ─────────────────────────────────────────────
var bool ao_buy_blocked  = false
var bool ao_sell_blocked = false

if ao_buy_blocked and ao_negative
    ao_buy_blocked := false
if ao_sell_blocked and ao_positive
    ao_sell_blocked := false

ao_buy  = ao_buy_raw  and not ao_buy_blocked
ao_sell = ao_sell_raw and not ao_sell_blocked

if ao_buy
    ao_buy_blocked  := true
if ao_sell
    ao_sell_blocked := true

// ─────────────────────────────────────────────
// REFERANS SEVIYE CIZGISI
// ─────────────────────────────────────────────
plot(waiting_for_buy  ? third_green_high : na, title="3. Yesil Bar High",
     color=color.new(color.lime, 40), linewidth=1, style=plot.style_stepline)
plot(waiting_for_sell ? third_red_low    : na, title="3. Kirmizi Bar Low",
     color=color.new(color.red,  40), linewidth=1, style=plot.style_stepline)

// ─────────────────────────────────────────────
// GUCLU / TEKLI SINYAL AYRIMI
// ─────────────────────────────────────────────
strong_buy  = ao_buy  and fractal_up_break
strong_sell = ao_sell and fractal_down_break

only_ao_buy       = ao_buy         and not fractal_up_break
only_ao_sell      = ao_sell        and not fractal_down_break
only_fraktal_buy  = fractal_up_break   and not ao_buy
only_fraktal_sell = fractal_down_break and not ao_sell

// ─────────────────────────────────────────────
// POZİSYON TAKİBİ
// ─────────────────────────────────────────────
var int   position_state = 0
var float entry_price    = na
var bool  ever_in_profit = false

any_buy  = ao_buy  or fractal_up_break
any_sell = ao_sell or fractal_down_break

lowest_3  = math.min(low[1],  math.min(low[2],  low[3]))
highest_3 = math.max(high[1], math.max(high[2], high[3]))

// Cikis kosullari (giris guncellenmeden ONCE hesaplanir)
exit_long_reverse  = position_state == 1  and any_sell
exit_short_reverse = position_state == -1 and any_buy

exit_long_stop  = position_state == 1  and ever_in_profit and low  < lowest_3
exit_short_stop = position_state == -1 and ever_in_profit and high > highest_3

exit_long  = exit_long_reverse  or exit_long_stop
exit_short = exit_short_reverse or exit_short_stop

// Cikis uygula
if exit_long or exit_short
    position_state := 0
    entry_price    := na
    ever_in_profit := false

// Giris uygula (cikisin ardindan)
if any_buy and position_state == 0
    position_state := 1
    entry_price    := close
    ever_in_profit := false

if any_sell and position_state == 0
    position_state := -1
    entry_price    := close
    ever_in_profit := false

// Karda olma durumunu guncelle
if position_state == 1  and high > entry_price
    ever_in_profit := true
if position_state == -1 and low  < entry_price
    ever_in_profit := true

// ─────────────────────────────────────────────
// GRAFIK GOSTERIMI — GIRIS
// ─────────────────────────────────────────────
plotshape(strong_buy, title="GUCLU AL",
     location=location.belowbar, style=shape.labelup,
     size=size.large, color=color.new(color.orange, 0),
     text="GUCLU\nAL", textcolor=color.black)

plotshape(strong_sell, title="GUCLU SAT",
     location=location.abovebar, style=shape.labeldown,
     size=size.large, color=color.new(color.fuchsia, 0),
     text="GUCLU\nSAT", textcolor=color.white)

plotshape(only_ao_buy, title="AO AL",
     location=location.belowbar, style=shape.labelup,
     size=size.small, color=color.new(color.lime, 0),
     text="AO\nAL", textcolor=color.black)

plotshape(only_ao_sell, title="AO SAT",
     location=location.abovebar, style=shape.labeldown,
     size=size.small, color=color.new(color.red, 0),
     text="AO\nSAT", textcolor=color.white)

plotshape(only_fraktal_buy, title="Fraktal AL",
     location=location.belowbar, style=shape.labelup,
     size=size.small, color=color.new(color.teal, 0),
     text="FRK\nAL", textcolor=color.white)

plotshape(only_fraktal_sell, title="Fraktal SAT",
     location=location.abovebar, style=shape.labeldown,
     size=size.small, color=color.new(color.maroon, 0),
     text="FRK\nSAT", textcolor=color.white)

// ─────────────────────────────────────────────
// GRAFIK GOSTERIMI — CIKIS
// ─────────────────────────────────────────────
plotshape(exit_long, title="Long Stop",
     location=location.abovebar, style=shape.labeldown,
     size=size.small, color=color.new(color.yellow, 0),
     text="STOP\nLONG", textcolor=color.black)

plotshape(exit_short, title="Short Stop",
     location=location.belowbar, style=shape.labelup,
     size=size.small, color=color.new(color.white, 0),
     text="STOP\nSHORT", textcolor=color.black)

plot(position_state == 1  ? lowest_3  : na, title="Long Stop Seviyesi",
     color=color.new(color.yellow, 30), linewidth=1, style=plot.style_stepline)
plot(position_state == -1 ? highest_3 : na, title="Short Stop Seviyesi",
     color=color.new(color.white,  30), linewidth=1, style=plot.style_stepline)

bgcolor(strong_buy        ? color.new(color.orange,  80) : na)
bgcolor(strong_sell       ? color.new(color.fuchsia, 80) : na)
bgcolor(only_ao_buy       ? color.new(color.green,   90) : na)
bgcolor(only_ao_sell      ? color.new(color.red,     90) : na)
bgcolor(only_fraktal_buy  ? color.new(color.teal,    90) : na)
bgcolor(only_fraktal_sell ? color.new(color.orange,  90) : na)
bgcolor(exit_long         ? color.new(color.yellow,  85) : na)
bgcolor(exit_short        ? color.new(color.gray,    85) : na)

// ─────────────────────────────────────────────
// ALERTLER
// ─────────────────────────────────────────────
alertcondition(strong_buy,         title="GUCLU AL",          message="{{ticker}} - AO + Fraktal -> GUCLU ALIM!")
alertcondition(strong_sell,        title="GUCLU SAT",         message="{{ticker}} - AO + Fraktal -> GUCLU SATIM!")
alertcondition(only_ao_buy,        title="AO Alim",           message="{{ticker}} - AO 3 yesil + high kirilimi -> ALIM!")
alertcondition(only_ao_sell,       title="AO Satim",          message="{{ticker}} - AO 3 kirmizi + low kirilimi -> SATIM!")
alertcondition(only_fraktal_buy,   title="Fraktal Alim",      message="{{ticker}} - Yukselis fraktali kirildi -> ALIM!")
alertcondition(only_fraktal_sell,  title="Fraktal Satim",     message="{{ticker}} - Dusus fraktali kirildi -> SATIM!")
alertcondition(exit_long,          title="Long Stop",         message="{{ticker}} - LONG pozisyon kapatildi!")
alertcondition(exit_long_stop,     title="Long Stop Bar",     message="{{ticker}} - LONG stop: son 3 bar dibi kirildi!")
alertcondition(exit_long_reverse,  title="Long Ters Sinyal",  message="{{ticker}} - LONG ters sinyal ile kapatildi!")
alertcondition(exit_short,         title="Short Stop",        message="{{ticker}} - SHORT pozisyon kapatildi!")
alertcondition(exit_short_stop,    title="Short Stop Bar",    message="{{ticker}} - SHORT stop: son 3 bar zirvesi kirildi!")
alertcondition(exit_short_reverse, title="Short Ters Sinyal", message="{{ticker}} - SHORT ters sinyal ile kapatildi!")
alertcondition(ao_buy or fractal_up_break,                    title="Herhangi Alim",  message="{{ticker}} - Alim sinyali!")
alertcondition(ao_sell or fractal_down_break,                 title="Herhangi Satim", message="{{ticker}} - Satim sinyali!")

// ─────────────────────────────────────────────
// BILGI TABLOSU
// ─────────────────────────────────────────────
var table info = table.new(position.top_right, 2, 17, border_width=1)

if barstate.islast
    table.cell(info, 0, 0,  "SINYAL",              text_color=color.white,  bgcolor=color.gray)
    table.cell(info, 1, 0,  "DURUM",               text_color=color.white,  bgcolor=color.gray)
    table.cell(info, 0, 1,  "AO Degeri",           text_color=color.white,  bgcolor=color.navy)
    table.cell(info, 1, 1,  str.tostring(ao, "#.####"), text_color=color.yellow, bgcolor=color.navy)
    table.cell(info, 0, 2,  "Dis (Teeth)",         text_color=color.white,  bgcolor=color.navy)
    table.cell(info, 1, 2,  str.tostring(teeth_val, "#.##"), text_color=color.red, bgcolor=color.navy)
    table.cell(info, 0, 3,  "AO SINYALLERI",       text_color=color.yellow, bgcolor=color.teal)
    table.cell(info, 1, 3,  "",                    text_color=color.white,  bgcolor=color.teal)
    table.cell(info, 0, 4,  "Yesil Bar Sayisi",    text_color=color.white,  bgcolor=color.navy)
    table.cell(info, 1, 4,  str.tostring(green_count), text_color=color.lime, bgcolor=color.navy)
    table.cell(info, 0, 5,  "Kirmizi Bar Sayisi",  text_color=color.white,  bgcolor=color.navy)
    table.cell(info, 1, 5,  str.tostring(red_count), text_color=color.red,  bgcolor=color.navy)
    table.cell(info, 0, 6,  "AL Bekleniyor",       text_color=color.white,  bgcolor=color.navy)
    table.cell(info, 1, 6,  waiting_for_buy  ? "Evet" : "Hayir", text_color=waiting_for_buy  ? color.lime : color.gray, bgcolor=color.navy)
    table.cell(info, 0, 7,  "SAT Bekleniyor",      text_color=color.white,  bgcolor=color.navy)
    table.cell(info, 1, 7,  waiting_for_sell ? "Evet" : "Hayir", text_color=waiting_for_sell ? color.red  : color.gray, bgcolor=color.navy)
    table.cell(info, 0, 8,  "AO Sinyal",           text_color=color.white,  bgcolor=color.navy)
    table.cell(info, 1, 8,  ao_buy ? "AL" : ao_sell ? "SAT" : "Bekle", text_color=ao_buy ? color.lime : ao_sell ? color.red : color.orange, bgcolor=color.navy)
    table.cell(info, 0, 9,  "FRAKTAL SINYALLERI",  text_color=color.yellow, bgcolor=color.teal)
    table.cell(info, 1, 9,  "",                    text_color=color.white,  bgcolor=color.teal)
    table.cell(info, 0, 10, "Fraktal Sinyal",      text_color=color.white,  bgcolor=color.navy)
    table.cell(info, 1, 10, fractal_up_break ? "AL" : fractal_down_break ? "SAT" : "Bekle", text_color=fractal_up_break ? color.lime : fractal_down_break ? color.red : color.orange, bgcolor=color.navy)
    table.cell(info, 0, 11, "GUCLU SINYAL",        text_color=color.white,  bgcolor=color.navy)
    table.cell(info, 1, 11, strong_buy ? "GUCLU AL!" : strong_sell ? "GUCLU SAT!" : "Yok", text_color=strong_buy ? color.orange : strong_sell ? color.fuchsia : color.gray, bgcolor=color.navy)
    table.cell(info, 0, 12, "POZISYON",            text_color=color.yellow, bgcolor=color.teal)
    table.cell(info, 1, 12, "",                    text_color=color.white,  bgcolor=color.teal)
    table.cell(info, 0, 13, "Durum",               text_color=color.white,  bgcolor=color.navy)
    table.cell(info, 1, 13, position_state == 1 ? "LONG" : position_state == -1 ? "SHORT" : "Yok", text_color=position_state == 1 ? color.lime : position_state == -1 ? color.red : color.gray, bgcolor=color.navy)
    table.cell(info, 0, 14, "Giris Fiyati",        text_color=color.white,  bgcolor=color.navy)
    table.cell(info, 1, 14, na(entry_price) ? "---" : str.tostring(entry_price, "#.####"), text_color=color.yellow, bgcolor=color.navy)
    table.cell(info, 0, 15, "Karda mi",            text_color=color.white,  bgcolor=color.navy)
    table.cell(info, 1, 15, ever_in_profit ? "Evet" : "Hayir", text_color=ever_in_profit ? color.lime : color.gray, bgcolor=color.navy)
    table.cell(info, 0, 16, "Stop Seviyesi",       text_color=color.white,  bgcolor=color.navy)
    table.cell(info, 1, 16, position_state == 1 ? str.tostring(lowest_3, "#.####") : position_state == -1 ? str.tostring(highest_3, "#.####") : "---", text_color=color.yellow, bgcolor=color.navy)
