//@version=6
indicator("Unified 4-Indicator Buy/Sell System (60pt62, PMO exact)", overlay=true, max_lines_count=500, max_labels_count=500)

// -----------------------------
// 1️⃣ HMA Breakout Intraday Trend Filter
// -----------------------------
hma1 = 20
hma2 = 50
hma3 = 100

ma1 = ta.hma(close, hma1)
ma2 = ta.hma(close, hma2)
ma3 = ta.hma(close, hma3)
l_col = color.gray

var bool isLongTrend = false
var bool isShortTrend = false

if ma3 < ma2 and ma3 < ma1 and ma1 > ma2
    isLongTrend := true
    isShortTrend := false
    l_col := color.rgb(7, 249, 15)  // green
else if ma3 > ma2 and ma3 > ma1 and ma2 > ma1
    isShortTrend := true
    isLongTrend := false
    l_col := color.rgb(247, 8, 8)  // red
else
    isLongTrend := false
    isShortTrend := false
    l_col := color.gray

plot(ma3, color=l_col, linewidth=2)

// -----------------------------
// 2️⃣ PMO (10,10,6) using your original code
// -----------------------------
import TradingView/ta/11 as TVta

pmo_source  = close
pmo_fast    = 10
pmo_slow    = 10
pmo_signal  = 6

[pmo, pmo_signal_line] = TVta.pmo(pmo_source, pmo_fast, pmo_slow, pmo_signal)
plot(pmo, "PMO", color=color.blue)
plot(pmo_signal_line, "PMO Signal", color=#ff6d00)
hline(0, "Zero")

// -----------------------------
// 3️⃣ 60-Point Signal (length=50, mult=1.1, threshold=62)
// -----------------------------
len_60 = 50
mult_60 = 1.1
threshold_60 = 62.0

ma_60 = ta.sma(close, len_60)
atr_60 = ta.atr(200)
rangeATR = atr_60 * mult_60

// Single-candle move logic exactly as in your original 60-point code
bigMoveUp = (close - open)/rangeATR * 100 >= threshold_60
bigMoveDn = (open - close)/rangeATR * 100 >= threshold_60

// -----------------------------
// 4️⃣ Volume Filter
// -----------------------------
vol_up = volume > volume[1]

// -----------------------------
// 5️⃣ Long / Short Conditions (Candle close only)
// -----------------------------
longCondition  = barstate.isconfirmed and isLongTrend and pmo > 0 and bigMoveUp and vol_up
shortCondition = barstate.isconfirmed and isShortTrend and pmo < 0 and bigMoveDn and vol_up

// -----------------------------
// 6️⃣ Plot Signals
// -----------------------------
plotshape(longCondition, style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="BUY")
plotshape(shortCondition, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL")

// -----------------------------
// 7️⃣ Alerts
// -----------------------------
alertcondition(longCondition, "Long Alert", "Long setup triggered (HMA green, PMO>0, 60pt62 signal, Volume Up)")
alertcondition(shortCondition, "Short Alert", "Short setup triggered (HMA red, PMO<0, 60pt62 signal, Volume Up)")
