//@version=6 
indicator("Trend Indicator", shorttitle="Trend Indicator[MrRamadan]", overlay=false)

// --- Inputs & Calculations  ---
length = input.int(14, title="Length", minval=1)
offset_val = input.float(0.1, title="Etiket Boşluk Oranı", step=0.01) 

rwiHigh = (high - nz(low[length])) / (ta.atr(length) * math.sqrt(length))
rwiLow  = (nz(high[length]) - low) / (ta.atr(length) * math.sqrt(length))

// --- Visual Plots ---
plot(rwiHigh, title="High Line", linewidth=2, color=color.new(color.white, 0))
plot(rwiLow,  title="Low Line",  linewidth=2, color=color.new(#f00c0c, 0))

bgColor = rwiHigh > rwiLow ? color.new(color.white, 85) : color.new(color.red, 85)
bgcolor(bgColor, title="Trend Background")

trendUp   = ta.crossover(rwiHigh, rwiLow)
trendDown = ta.crossunder(rwiHigh, rwiLow)

// --- Chart Labels ---
plotshape(trendUp ? rwiHigh - offset_val : na, 
     title="Label Up", 
     text="Trend Up", 
     style=shape.labelup, 
     location=location.absolute, 
     color=color.new(color.white, 10), 
     textcolor=color.black, 
     size=size.tiny)

plotshape(trendDown ? rwiLow + offset_val : na, 
     title="Label Down", 
     text="Trend Down", 
     style=shape.labeldown, 
     location=location.absolute, 
     color=color.new(#f00c0c, 10), 
     textcolor=color.white, 
     size=size.tiny)

hline(1.0, "Threshold", color=color.gray, linestyle=hline.style_dashed, linewidth=1)

// ==========================================
// Newly added functions
// ==========================================

// 1. Visual Crossover Points
plot(trendUp ? rwiHigh : na, title="Buy Signal Dot", style=plot.style_circles, linewidth=4, color=color.white)
plot(trendDown ? rwiLow : na, title="Sell Signal Dot", style=plot.style_circles, linewidth=4, color=color.red)

// 2. Classic Alert Conditions
alertcondition(trendUp, title="Trend Yükseliş Başladı", message="RWI: Boğa Trendi Başladı! (Beyaz Üstte)")
alertcondition(trendDown, title="Trend Düşüş Başladı", message="RWI: Ayı Trendi Başladı! (Kırmızı Üstte)")

// 3. Modern alert() Function (Automation compatible)
if trendUp
    alert("Trend Up Sinyali: " + syminfo.ticker, alert.freq_once_per_bar_close)
if trendDown
    alert("Trend Down Sinyali: " + syminfo.ticker, alert.freq_once_per_bar_close)
