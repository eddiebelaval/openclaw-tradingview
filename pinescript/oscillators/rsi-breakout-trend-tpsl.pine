//@version=6
indicator("RSI Breakout Trend + TP/SL", overlay = true, max_labels_count = 500, max_boxes_count = 500, max_lines_count = 500)

// INPUTS 
rsiLength = input.int(14,  "RSI Length",          minval = 1, group = "RSI Settings")
maLength  = input.int(9,   "RSI MA Length",       minval = 1, group = "RSI Settings")

priceRangeBars = input.int(30,  "Price Range Lookback", minval = 1, group = "Trend Settings")
smoothLength   = input.int(10,  "Smoothing Length",    minval = 1, group = "Trend Settings")
smoothType     = input.string("EMA", "Smoothing Type", options = ["SMA","EMA","WMA"], group = "Trend Settings")
multiplier     = input.float(2.5, "Tolerance Multiplier", minval = 0.0, step = 0.1, group = "Trend Settings")

periods = 100

rsiOB      = input.int(70,  "Overbought Level",           minval = 0, maxval = 100, group = "Box Settings")
rsiOS      = input.int(30,  "Oversold Level",             minval = 0, maxval = 100, group = "Box Settings")
obColor    = input.color(#26a69a, "Overbought Box Color", group = "Box Settings")
osColor    = input.color(#ef5350,  "Oversold Box Color",   group = "Box Settings")
boxTransp  = input.int(90, "Box Transparency (0-100)", minval = 0, maxval = 100, group = "Box Settings")

showTargets   = input.bool(true,   "Show TP/SL",               group = "TP/SL Settings")
useAtrForSl   = input.bool(true,   "SL = ATR × instead of %",  group = "TP/SL Settings")
atrPeriod     = input.int(14,      "ATR Period",      minval=1,  group = "TP/SL Settings")
slAtrMult     = input.float(1.5,   "SL ATR Multiplier", step=0.1,  group = "TP/SL Settings")
slPercent     = input.float(1.0,   "SL % from Entry",   step=0.1, group = "TP/SL Settings")

rrTp1         = input.float(1.0,   "TP1 RR", step=0.1, group = "TP/SL Settings")
rrTp2         = input.float(2.0,   "TP2 RR", step=0.1, group = "TP/SL Settings")
rrTp3         = input.float(3.0,   "TP3 RR", step=0.1, group = "TP/SL Settings")

showSlLevel   = input.bool(true,   "SL",   group = "TP/SL Display")
showTp1Level  = input.bool(true,   "TP1",  group = "TP/SL Display")
showTp2Level  = input.bool(true,   "TP2",  group = "TP/SL Display")
showTp3Level  = input.bool(true,   "TP3",  group = "TP/SL Display")

enableCandleColoring = input.bool(true, "Enable Candle Coloring", group = "Visual Settings")

buyLabelColor  = obColor
sellLabelColor = osColor
buyColorLight  = color.new(obColor,  40)
sellColorLight = color.new(osColor, 40)
buyFill        = color.new(obColor,  85)
sellFill       = color.new(osColor, 85)

// CALCULATIONS
rsi   = ta.rsi(close, rsiLength)
maRsi = ta.sma(rsi, maLength)                 

priceHigh = ta.highest(high, priceRangeBars)
priceLow  = ta.lowest(low,  priceRangeBars)
scale     = (priceHigh - priceLow) / 100.0
projected = priceLow + maRsi * scale

avgLine = smoothType == "SMA" ? ta.sma(projected, smoothLength) :
          smoothType == "EMA" ? ta.ema(projected, smoothLength) :
          smoothType == "WMA" ? ta.wma(projected, smoothLength) :
          ta.ema(projected, smoothLength)

atr_val = ta.atr(atrPeriod)

body      = math.abs(open - close)
avgBody   = ta.sma(body, periods)
tolerance = multiplier * avgBody

var bool isUptrend = true
marginLine = isUptrend ? avgLine - tolerance : avgLine + tolerance

if isUptrend and close < marginLine
    isUptrend := false
else if not isUptrend and close > marginLine
    isUptrend := true

marginLine := isUptrend ? avgLine - tolerance : avgLine + tolerance

trendDistance = math.abs(close - marginLine)
maxDistance   = ta.highest(trendDistance, periods)
strength      = not na(maxDistance) and maxDistance != 0 ? trendDistance / maxDistance : 0

lightBull     = color.from_gradient(strength, 0, 1, color.new(obColor, 40), color.new(obColor, 0))
lightBear     = color.from_gradient(strength, 0, 1, color.new(osColor, 40), color.new(osColor, 0))
candleColor   = isUptrend ? lightBull : lightBear

isOB = rsi > rsiOB
isOS = rsi < rsiOS

// DRAWING 
lineColor = isUptrend ? obColor : osColor
plot(marginLine, "Margin Line (Trend)", lineColor, 2)
plot(hl2, "HL2", color.new(color.gray, 65), 1)

color bandColor = isUptrend ? obColor : osColor
color strong = color.new(bandColor, 75)
color weak   = color.new(bandColor, 92)
bool marginHigher = marginLine > hl2
color topColor    = marginHigher ? strong : weak
color bottomColor = marginHigher ? weak   : strong

pMargin = plot(marginLine, display = display.none)
pHL2    = plot(hl2,        display = display.none)
fill(pMargin, pHL2, top_color = topColor, bottom_color = bottomColor, top_value = math.max(marginLine, hl2), bottom_value = math.min(marginLine, hl2), title = "Gradient Fill")

// SIGNAL FILTERS
trendFollowingOnly = input.bool(false, "Only Trend-Following Signals", group = "Signal Filters")
counterTrendOnly   = input.bool(false, "Only Counter-Trend Signals",   group = "Signal Filters")

// BOXES 
var box obBox = na
var box osBox = na
var line obMidLine = na
var line osMidLine = na

var line   obBreakLine          = na   
var float  obLineLevel          = na
var bool   obLineFrozen         = false
var line   obBottomBreakLine    = na   
var float  obBottomLineLevel    = na
var bool   obBottomLineFrozen   = false

var line   osBreakLine          = na   
var float  osLineLevel          = na
var bool   osLineFrozen         = false
var line   osTopBreakLine       = na   
var float  osTopLineLevel       = na
var bool   osTopLineFrozen      = false

// OB
if isOB
    if na(obBox)
        obBox := box.new(left = bar_index, top = high, right = bar_index + 1, bottom = low, xloc = xloc.bar_index, border_color = color.new(obColor, 0), bgcolor = color.new(obColor, boxTransp))
        float midLevel = (high + low) / 2
        obMidLine := line.new(bar_index, midLevel, bar_index + 1, midLevel, xloc = xloc.bar_index, color = color.new(obColor, boxTransp), style = line.style_dashed)
    else
        box.set_right(obBox, bar_index + 1)
        line.set_x2(obMidLine, bar_index + 1)
        float curTop = box.get_top(obBox)
        float curBottom = box.get_bottom(obBox)
        if high > curTop
            box.set_top(obBox, high)
            line.set_y1(obMidLine, (high + curBottom)/2)
            line.set_y2(obMidLine, (high + curBottom)/2)
        if low < curBottom
            box.set_bottom(obBox, low)
            line.set_y1(obMidLine, (curTop + low)/2)
            line.set_y2(obMidLine, (curTop + low)/2)
else
    if isOB[1] and not isOB and not na(obBox)
        float topLevel    = box.get_top(obBox)
        float bottomLevel = box.get_bottom(obBox)
        
        if not na(obBreakLine) and not obLineFrozen
            line.set_x2(obBreakLine, bar_index)
            obLineFrozen := true
        if not na(obBottomBreakLine) and not obBottomLineFrozen
            line.set_x2(obBottomBreakLine, bar_index)
            obBottomLineFrozen := true
        
        obBreakLine := line.new(bar_index - 1, topLevel, bar_index, topLevel, xloc = xloc.bar_index, color = color.new(obColor, 0), width = 1, style = line.style_dashed)
        obLineLevel := topLevel
        obLineFrozen := false
        
        obBottomBreakLine := line.new(bar_index - 1, bottomLevel, bar_index, bottomLevel, xloc = xloc.bar_index, color = color.new(obColor, 0), width = 1, style = line.style_dashed)
        obBottomLineLevel := bottomLevel
        obBottomLineFrozen := false

    if not na(obBox)
        obBox := na
    if not na(obMidLine)
        line.delete(obMidLine)
        obMidLine := na

// OS
if isOS
    if na(osBox)
        osBox := box.new(left = bar_index, top = high, right = bar_index + 1, bottom = low, xloc = xloc.bar_index, border_color = color.new(osColor, 0), bgcolor = color.new(osColor, boxTransp))
        float midLevel = (high + low) / 2
        osMidLine := line.new(bar_index, midLevel, bar_index + 1, midLevel, xloc = xloc.bar_index, color = color.new(osColor, boxTransp), style = line.style_dashed)
    else
        box.set_right(osBox, bar_index + 1)
        line.set_x2(osMidLine, bar_index + 1)
        float curTop = box.get_top(osBox)
        float curBottom = box.get_bottom(osBox)
        if high > curTop
            box.set_top(osBox, high)
            line.set_y1(osMidLine, (high + curBottom)/2)
            line.set_y2(osMidLine, (high + curBottom)/2)
        if low < curBottom
            box.set_bottom(osBox, low)
            line.set_y1(osMidLine, (curTop + low)/2)
            line.set_y2(osMidLine, (curTop + low)/2)
else
    if isOS[1] and not isOS and not na(osBox)
        float bottomLevel = box.get_bottom(osBox)
        float topLevel    = box.get_top(osBox)
        
        if not na(osBreakLine) and not osLineFrozen
            line.set_x2(osBreakLine, bar_index)
            osLineFrozen := true
        if not na(osTopBreakLine) and not osTopLineFrozen
            line.set_x2(osTopBreakLine, bar_index)
            osTopLineFrozen := true
        
        osBreakLine := line.new(bar_index - 1, bottomLevel, bar_index, bottomLevel, xloc = xloc.bar_index, color = color.new(osColor, 0), width = 1, style = line.style_dashed)
        osLineLevel := bottomLevel
        osLineFrozen := false
        
        osTopBreakLine := line.new(bar_index - 1, topLevel, bar_index, topLevel, xloc = xloc.bar_index, color = color.new(osColor, 0), width = 1, style = line.style_dashed)
        osTopLineLevel := topLevel
        osTopLineFrozen := false

    if not na(osBox)
        osBox := na
    if not na(osMidLine)
        line.delete(osMidLine)
        osMidLine := na

// BREAKOUT DETECTION 
bool obBreakSignal        = false   
bool obBottomBreakSignal  = false   
bool osBreakSignal        = false   
bool osTopBreakSignal     = false   


bool obTopCross     = ta.crossover(close, obLineLevel)
bool obBottomCross  = ta.crossunder(close, obBottomLineLevel)
bool osBottomCross  = ta.crossunder(close, osLineLevel)
bool osTopCross     = ta.crossover(close, osTopLineLevel)

// OB TOP
if not na(obBreakLine) and not obLineFrozen and not na(obLineLevel)
    line.set_x2(obBreakLine, bar_index + 1)
    if obTopCross                     
        line.set_x2(obBreakLine, bar_index)
        obLineFrozen := true
        obBreakSignal := true
        if not na(obBottomBreakLine) and not obBottomLineFrozen
            line.set_x2(obBottomBreakLine, bar_index)
            obBottomLineFrozen := true

// OB BOTTOM
if not na(obBottomBreakLine) and not obBottomLineFrozen and not na(obBottomLineLevel)
    line.set_x2(obBottomBreakLine, bar_index + 1)
    if obBottomCross                  
        line.set_x2(obBottomBreakLine, bar_index)
        obBottomLineFrozen := true
        obBottomBreakSignal := true
        if not na(obBreakLine) and not obLineFrozen
            line.set_x2(obBreakLine, bar_index)
            obLineFrozen := true

// OS BOTTOM
if not na(osBreakLine) and not osLineFrozen and not na(osLineLevel)
    line.set_x2(osBreakLine, bar_index + 1)
    if osBottomCross                  
        line.set_x2(osBreakLine, bar_index)
        osLineFrozen := true
        osBreakSignal := true
        if not na(osTopBreakLine) and not osTopLineFrozen
            line.set_x2(osTopBreakLine, bar_index)
            osTopLineFrozen := true

// OS TOP
if not na(osTopBreakLine) and not osTopLineFrozen and not na(osTopLineLevel)
    line.set_x2(osTopBreakLine, bar_index + 1)
    if osTopCross                     
        line.set_x2(osTopBreakLine, bar_index)
        osTopLineFrozen := true
        osTopBreakSignal := true
        if not na(osBreakLine) and not osLineFrozen
            line.set_x2(osBreakLine, bar_index)
            osLineFrozen := true

// Apply Signal Filters
if (obBreakSignal or osTopBreakSignal)
    bool thisTrendFollowing = isUptrend
    bool thisCounter = not isUptrend
    bool allowed = (not trendFollowingOnly and not counterTrendOnly) or (trendFollowingOnly and thisTrendFollowing) or (counterTrendOnly and thisCounter)
    obBreakSignal := obBreakSignal and allowed
    osTopBreakSignal := osTopBreakSignal and allowed

if (obBottomBreakSignal or osBreakSignal)
    bool thisTrendFollowing = not isUptrend
    bool thisCounter = isUptrend
    bool allowed = (not trendFollowingOnly and not counterTrendOnly) or (trendFollowingOnly and thisTrendFollowing) or (counterTrendOnly and thisCounter)
    obBottomBreakSignal := obBottomBreakSignal and allowed
    osBreakSignal := osBreakSignal and allowed

// TP/SL 
var int   trade_dir     = 0
var int   entry_bar     = na
var float sl_level      = na
var float extreme_level = na

var line     entry_line   = na
var label    entry_label  = na
var line     sl_line      = na
var label    sl_label     = na
var line     tp1_line     = na
var label    tp1_label    = na
var line     tp2_line     = na
var label    tp2_label    = na
var line     tp3_line     = na
var label    tp3_label    = na
var line     extreme_line = na
var linefill risk_fill    = na
var linefill reward_fill  = na

if (obBreakSignal or obBottomBreakSignal or osBreakSignal or osTopBreakSignal) and showTargets
    line.delete(entry_line)
    label.delete(entry_label)
    line.delete(sl_line)
    label.delete(sl_label)
    line.delete(tp1_line)
    label.delete(tp1_label)
    line.delete(tp2_line)
    label.delete(tp2_label)
    line.delete(tp3_line)
    label.delete(tp3_label)
    line.delete(extreme_line)
    linefill.delete(risk_fill)
    linefill.delete(reward_fill)

    int dir = obBreakSignal ? 1 :
              obBottomBreakSignal ? -1 :
              osBreakSignal ? -1 :
              osTopBreakSignal ? 1 : 0

    trade_dir := dir
    entry_bar := bar_index
    float entry_price = close
    float risk_dist = useAtrForSl ? atr_val * slAtrMult : entry_price * (slPercent / 100)

    float sl_level_local = dir == 1 ? entry_price - risk_dist : entry_price + risk_dist
    float tp1_p = dir == 1 ? entry_price + risk_dist * rrTp1 : entry_price - risk_dist * rrTp1
    float tp2_p = dir == 1 ? entry_price + risk_dist * rrTp2 : entry_price - risk_dist * rrTp2
    float tp3_p = dir == 1 ? entry_price + risk_dist * rrTp3 : entry_price - risk_dist * rrTp3

    float extreme_level_local = na
    if showTp3Level
        extreme_level_local := tp3_p
    if showTp2Level
        extreme_level_local := na(extreme_level_local) ? tp2_p : dir == 1 ? math.max(extreme_level_local, tp2_p) : math.min(extreme_level_local, tp2_p)
    if showTp1Level
        extreme_level_local := na(extreme_level_local) ? tp1_p : dir == 1 ? math.max(extreme_level_local, tp1_p) : math.min(extreme_level_local, tp1_p)

    entry_line   := line.new(bar_index, entry_price, bar_index + 1, entry_price, color = dir == 1 ? buyLabelColor : sellLabelColor, width = 2, extend = extend.right)
    entry_label  := label.new(bar_index, entry_price, (dir == 1 ? "BUY " : "SELL ") + str.tostring(entry_price, format.mintick), style = label.style_label_left, color = dir == 1 ? buyLabelColor : sellLabelColor, textcolor = color.white, size = size.small)

    if showSlLevel
        sl_line  := line.new(bar_index, sl_level_local, bar_index + 1, sl_level_local, color = sellColorLight, width = 1, style = line.style_dashed, extend = extend.right)
        sl_label := label.new(bar_index, sl_level_local, "SL " + str.tostring(sl_level_local, format.mintick), style = label.style_label_left, color = sellColorLight, textcolor = color.white, size = size.small)

    if showTp1Level
        tp1_line  := line.new(bar_index, tp1_p, bar_index + 1, tp1_p, color = buyColorLight, width = 1, extend = extend.right)
        tp1_label := label.new(bar_index, tp1_p, "TP1 " + str.tostring(tp1_p, format.mintick), style = label.style_label_left, color = buyColorLight, textcolor = color.white, size = size.small)

    if showTp2Level
        tp2_line  := line.new(bar_index, tp2_p, bar_index + 1, tp2_p, color = buyColorLight, width = 1, extend = extend.right)
        tp2_label := label.new(bar_index, tp2_p, "TP2 " + str.tostring(tp2_p, format.mintick), style = label.style_label_left, color = buyColorLight, textcolor = color.white, size = size.small)

    if showTp3Level
        tp3_line  := line.new(bar_index, tp3_p, bar_index + 1, tp3_p, color = buyColorLight, width = 1, style = line.style_dotted, extend = extend.right)
        tp3_label := label.new(bar_index, tp3_p, "TP3 " + str.tostring(tp3_p, format.mintick), style = label.style_label_left, color = buyColorLight, textcolor = color.white, size = size.small)

    if showSlLevel
        risk_fill := linefill.new(entry_line, sl_line, sellFill)

    float extreme_for_fill = entry_price
    if showTp1Level
        extreme_for_fill := dir == 1 ? math.max(extreme_for_fill, tp1_p) : math.min(extreme_for_fill, tp1_p)
    if showTp2Level
        extreme_for_fill := dir == 1 ? math.max(extreme_for_fill, tp2_p) : math.min(extreme_for_fill, tp2_p)
    if showTp3Level
        extreme_for_fill := dir == 1 ? math.max(extreme_for_fill, tp3_p) : math.min(extreme_for_fill, tp3_p)

    if (dir == 1 and extreme_for_fill > entry_price) or (dir == -1 and extreme_for_fill < entry_price)
        extreme_line := line.new(bar_index, extreme_for_fill, bar_index + 1, extreme_for_fill, color = na, extend = extend.right)
        reward_fill  := linefill.new(entry_line, extreme_line, buyFill)

    sl_level      := sl_level_local
    extreme_level := extreme_level_local

// Signals
plotshape(obBreakSignal or osTopBreakSignal,  title="Upward Box Breakout",  location=location.belowbar, style=shape.triangleup,   color=obColor, size=size.small)
plotshape(obBottomBreakSignal or osBreakSignal, title="Downward Box Breakout", location=location.abovebar, style=shape.triangledown, color=osColor, size=size.small)

// TP/SL
if trade_dir != 0
    label.set_x(entry_label, bar_index)
    if not na(sl_label)
        label.set_x(sl_label, bar_index)
    if not na(tp1_label)
        label.set_x(tp1_label, bar_index)
    if not na(tp2_label)
        label.set_x(tp2_label, bar_index)
    if not na(tp3_label)
        label.set_x(tp3_label, bar_index)

    bool sl_hit = trade_dir == 1 ? low <= sl_level : high >= sl_level
    bool tp_hit = not na(extreme_level) and (trade_dir == 1 ? high >= extreme_level : low <= extreme_level)

    if bar_index > entry_bar and (sl_hit or tp_hit)
        line.set_extend(entry_line, extend.none)
        line.set_x2(entry_line, bar_index)
        if not na(sl_line)
            line.set_extend(sl_line, extend.none)
            line.set_x2(sl_line, bar_index)
        if not na(tp1_line)
            line.set_extend(tp1_line, extend.none)
            line.set_x2(tp1_line, bar_index)
        if not na(tp2_line)
            line.set_extend(tp2_line, extend.none)
            line.set_x2(tp2_line, bar_index)
        if not na(tp3_line)
            line.set_extend(tp3_line, extend.none)
            line.set_x2(tp3_line, bar_index)
        if not na(extreme_line)
            line.set_extend(extreme_line, extend.none)
            line.set_x2(extreme_line, bar_index)
        trade_dir := 0

// ALERTS
barcolor(enableCandleColoring ? candleColor : na)

alertcondition(obBreakSignal or osTopBreakSignal, title = "Breakout Signal: Upward Breakout", message = "Upward breakout from the box → buy signal")
alertcondition(obBottomBreakSignal or osBreakSignal, title = "Breakout Signal: Downward Breakout", message = "Downward breakout from the box → sell signal")

bool trendUp   = isUptrend and not isUptrend[1]
bool trendDown = not isUptrend and isUptrend[1]
alertcondition(trendUp,   title = "Trend Change to bullish",   message = "Trend changed to bullish")
alertcondition(trendDown, title = "Trend Change to bearish", message = "Trend changed to bearish")
