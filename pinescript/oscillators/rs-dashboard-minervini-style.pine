//@version=6
indicator("RS Dashboard (Minervini Style)", overlay=true)

// ===== INPUT =====
benchmark = input.symbol("NSE:NIFTY", "Benchmark")
rsLen     = input.int(252, "RS Rating Period")
shortLen  = input.int(55, "Momentum Period")

// ===== DATA =====
index_close = request.security(benchmark, timeframe.period, close)

// ===== RS CALCULATION =====
rs = close / index_close

stock_return = close / close[shortLen]
index_return = index_close / index_close[shortLen]
rs_momentum = stock_return / index_return

// ===== RS RATING =====
rs_min = ta.lowest(rs_momentum, rsLen)
rs_max = ta.highest(rs_momentum, rsLen)
rs_rating = 100 * (rs_momentum - rs_min) / (rs_max - rs_min)

// ===== CONDITIONS =====
rs_strong   = rs_rating > 70
rs_elite    = rs_rating > 90
rs_new_high = rs >= ta.highest(rs, 100)

above_200ma = close > ta.sma(close, 200)
breakout    = close > ta.highest(close, 50)

// ===== FINAL SIGNAL =====
leader_stock = rs_strong and rs_new_high and above_200ma and breakout

// ===== STATUS COLOR =====
status_color = leader_stock ? color.lime :
     rs_strong and above_200ma ? color.yellow :
     color.red

// ===== DASHBOARD TABLE =====
var table dashboard = table.new(position.top_right, 2, 6, border_width=1)

// Headers
if barstate.islast
    table.cell(dashboard, 0, 0, "Metric", bgcolor=color.gray, text_color=color.white)
    table.cell(dashboard, 1, 0, "Value", bgcolor=color.gray, text_color=color.white)

// RS Rating
if barstate.islast
    table.cell(dashboard, 0, 1, "RS Rating")
    table.cell(dashboard, 1, 1, str.tostring(rs_rating, "#.##"), bgcolor=status_color)

// Trend
if barstate.islast
    table.cell(dashboard, 0, 2, "Above 200MA")
    table.cell(dashboard, 1, 2, above_200ma ? "YES" : "NO", bgcolor=above_200ma ? color.green : color.red)

// RS Strength
if barstate.islast
    table.cell(dashboard, 0, 3, "RS Strong")
    table.cell(dashboard, 1, 3, rs_strong ? "YES" : "NO", bgcolor=rs_strong ? color.green : color.red)

// RS New High
if barstate.islast
    table.cell(dashboard, 0, 4, "RS New High")
    table.cell(dashboard, 1, 4, rs_new_high ? "YES" : "NO", bgcolor=rs_new_high ? color.green : color.red)

// Leader Signal
if barstate.islast
    table.cell(dashboard, 0, 5, "Leader Signal")
    table.cell(dashboard, 1, 5, leader_stock ? "YES" : "NO", bgcolor=leader_stock ? color.lime : color.red)

// ===== VISUAL SIGNAL =====
plotshape(leader_stock, title="Leader", location=location.belowbar,
     color=color.lime, style=shape.triangleup, size=size.small)
