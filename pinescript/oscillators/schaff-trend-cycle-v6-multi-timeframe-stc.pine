//@version=6
indicator("Schaff Trend Cycle V6 + Timeframe", shorttitle="STC V6 TF", overlay=false)

// --- Input Parameters ---
tf = input.timeframe("", title="Timeframe", tooltip="Select the timeframe for indicator calculation. Leave empty to use the current chart timeframe.")
fastLength = input.int(23, title="MACD Fast Length", tooltip="Short-term EMA length used in MACD calculation. Lower values make the indicator more responsive.")
slowLength = input.int(50, title="MACD Slow Length", tooltip="Long-term EMA length used in MACD calculation. Higher values provide a smoother baseline.")
cycleLength = input.int(10, title="Cycle Length", tooltip="Period of the stochastic cycle. Controls how many bars are used in each stochastic calculation.")
d1Length = input.int(3, title="1st %D Length", tooltip="First smoothing layer (D1). Smooths the raw stochastic output before the second pass.")
d2Length = input.int(3, title="2nd %D Length", tooltip="Second smoothing layer (Final STC). Produces the final STC line from D1.")
src = input.source(close, title="Source", tooltip="Price type used as the base for calculation (Close, Open, HL2, etc.).")
upper = input.int(75, title="Upper Band", tooltip="Overbought threshold. A reading above this level suggests the asset may be overbought (typically 75 or 80).")
lower = input.int(25, title="Lower Band", tooltip="Oversold threshold. A reading below this level suggests the asset may be oversold (typically 25 or 20).")
highlightBreakouts = input.bool(true, title="Highlight Breakouts?", tooltip="When enabled, fills the area with color when STC breaks above the upper band or below the lower band.")

// --- STC Calculation Function ---
calc_stc(s, fL, sL, cL, d1, d2) =>
    macd = ta.ema(s, fL) - ta.ema(s, sL)
    k = nz(fixnan(ta.stoch(macd, macd, macd, cL)))
    d = ta.ema(k, d1)
    kd = nz(fixnan(ta.stoch(d, d, d, cL)))
    stc_val = ta.ema(kd, d2)
    math.max(math.min(stc_val, 100), 0)

// --- Timeframe (HTF) Calculation ---
// FIX 🟢: Intermediate variable stc_raw removed; assigned directly to stc
stc = request.security(syminfo.tickerid, tf, calc_stc(src, fastLength, slowLength, cycleLength, d1Length, d2Length), lookahead=barmerge.lookahead_off)

// --- Coloring Logic ---
stcColor1 = stc > stc[1] ? color.green : color.red
stcColor2 = stc > upper ? color.green : stc <= lower ? color.red : color.orange
stcColor = highlightBreakouts ? stcColor2 : stcColor1

// --- Plots ---
stcPlot    = plot(stc,   title="STC",   color=stcColor,   linewidth=3)
upperLevel = plot(upper, title="Upper", color=color.gray, linewidth=2)
hline(50, title="Middle", linestyle=hline.style_dotted)
lowerLevel = plot(lower, title="Lower", color=color.gray, linewidth=2)

// --- Zone Fills ---
fill(upperLevel, lowerLevel, title="Middle Zone", color=color.new(#f9cb9c, 90))

upperFillColor = stc > upper and highlightBreakouts ? color.new(color.green, 50) : na
// FIX 🟡: color.red → color.new(color.red, 80) — consistent transparency added to match upper fill
lowerFillColor = stc < lower and highlightBreakouts ? color.new(color.red, 50) : na

fill(upperLevel, stcPlot, title="Upper Zone Fill", color=upperFillColor)
fill(lowerLevel, stcPlot, title="Lower Zone Fill", color=lowerFillColor)

// --- Signals ---
buySignal  = ta.crossover(stc, lower)
sellSignal = ta.crossunder(stc, upper)

// location.absolute: correct choice for non-overlay (separate pane) indicators
// Shape is drawn at a fixed y-position exactly on the band lines
plotshape(sellSignal ? upper : na, title="Sell Signal", location=location.absolute, style=shape.circle, size=size.tiny, color=color.red)
plotshape(buySignal  ? lower : na, title="Buy Signal",  location=location.absolute, style=shape.circle, size=size.tiny, color=color.green)

// --- Individual Alert Conditions ---
alertcondition(buySignal,  title="Alert: Buy",  message="STC ({{interval}}): Buy!\nSymbol: {{exchange}}:{{ticker}}")
alertcondition(sellSignal, title="Alert: Sell", message="STC ({{interval}}): Sell!\nSymbol: {{exchange}}:{{ticker}}")

// --- FIX 🔴: Combined Dynamic Alert ---
// alertcondition() does not support custom variables like {{alert_msg}} in its message.
// Solution: alert() function is used instead — supports dynamic message content.
if buySignal
    alert("STC Indicator: BUY signal on " + syminfo.ticker + " at " + timeframe.period + " timeframe!", alert.freq_once_per_bar)
if sellSignal
    alert("STC Indicator: SELL signal on " + syminfo.ticker + " at " + timeframe.period + " timeframe!", alert.freq_once_per_bar)
