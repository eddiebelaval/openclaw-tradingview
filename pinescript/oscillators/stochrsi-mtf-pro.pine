// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © StochRSI MTF Pro v9

//@version=6
indicator("StochRSI MTF Pro", shorttitle="StochRSI MTF", overlay=false, precision=2)

// ── Inputs ──────────────────────────────────────────────────────────

grp1 = "Stochastic RSI"
rsi_len   = input.int(14, "RSI Length", minval=1, group=grp1)
stoch_len = input.int(14, "Stochastic Length", minval=1, group=grp1)
smooth_k  = input.int(3, "Suavizado %K", minval=1, group=grp1)
smooth_d  = input.int(3, "Suavizado %D", minval=1, group=grp1)
extra_sm  = input.int(4, "Suavizado Extra (EMA)", minval=1, maxval=20, group=grp1, tooltip="Suaviza las líneas K/D")
src       = input.source(close, "Fuente", group=grp1)
ob        = input.float(80, "Sobrecompra", group=grp1)
os_lv     = input.float(20, "Sobreventa", group=grp1)

grp2 = "Visual"
col_k     = input.color(color.new(#2962FF, 0), "Color %K", group=grp2)
col_d     = input.color(color.new(#FFA726, 0), "Color %D", group=grp2)
col_h_up  = input.color(color.new(#26A69A, 0), "Histograma +", group=grp2, inline="h")
col_h_dn  = input.color(color.new(#EF5350, 0), "Histograma -", group=grp2, inline="h")
hist_smooth = input.int(6, "Suavizado Histograma", minval=1, maxval=20, group=grp2)

grp3 = "Multi-Temporalidad"
show_tbl  = input.bool(true, "Mostrar Tabla", group=grp3)
tf1       = input.timeframe("15", "TF 1", group=grp3)
tf2       = input.timeframe("60", "TF 2", group=grp3)
tf3       = input.timeframe("240", "TF 3", group=grp3)
tbl_size  = input.string("normal", "Tamaño Tabla", options=["small", "normal", "large"], group=grp3)

grp4 = "Alertas"
alert_ob  = input.bool(true, "Alerta Sobrecompra", group=grp4)
alert_os  = input.bool(true, "Alerta Sobreventa", group=grp4)
alert_cx  = input.bool(true, "Alerta Cruce K/D", group=grp4)

// ── Cálculos ────────────────────────────────────────────────────────

rsi_v   = ta.rsi(src, rsi_len)
stoch_v = ta.stoch(rsi_v, rsi_v, rsi_v, stoch_len)
k_raw   = ta.sma(stoch_v, smooth_k)
d_raw   = ta.sma(k_raw, smooth_d)

k = ta.ema(k_raw, extra_sm)
d = ta.ema(d_raw, extra_sm)

// ── Histograma suavizado ────────────────────────────────────────────

hist_raw = k - d
hist     = ta.ema(hist_raw, hist_smooth)

hist_c = hist >= 0 ?
     (hist > hist[1] ? color.new(col_h_up, 65) : color.new(col_h_up, 80)) :
     (hist < hist[1] ? color.new(col_h_dn, 65) : color.new(col_h_dn, 80))

// ── MTF ─────────────────────────────────────────────────────────────

f_kd(_s, _rl, _sl, _sk, _sd, _esm) =>
    _r   = ta.rsi(_s, _rl)
    _st  = ta.stoch(_r, _r, _r, _sl)
    _k_r = ta.sma(_st, _sk)
    _d_r = ta.sma(_k_r, _sd)
    _k   = ta.ema(_k_r, _esm)
    _d   = ta.ema(_d_r, _esm)
    _dir = _k - ta.ema(_k, 3)
    [_k, _d, _dir]

[k1, d1, dir1] = request.security(syminfo.tickerid, tf1, f_kd(src, rsi_len, stoch_len, smooth_k, smooth_d, extra_sm), lookahead=barmerge.lookahead_off)
[k2, d2, dir2] = request.security(syminfo.tickerid, tf2, f_kd(src, rsi_len, stoch_len, smooth_k, smooth_d, extra_sm), lookahead=barmerge.lookahead_off)
[k3, d3, dir3] = request.security(syminfo.tickerid, tf3, f_kd(src, rsi_len, stoch_len, smooth_k, smooth_d, extra_sm), lookahead=barmerge.lookahead_off)

// ── Cruces ──────────────────────────────────────────────────────────

cross_up = ta.crossover(k, d)
cross_dn = ta.crossunder(k, d)

// ── PLOTS ───────────────────────────────────────────────────────────

// Histograma translúcido de fondo
plot(hist * 2 + 50, "Histograma", style=plot.style_columns, color=hist_c, histbase=50)

// Líneas K y D delgadas
plot(k, "%K", color=col_k, linewidth=1)
plot(d, "%D", color=col_d, linewidth=1)

// ── Sombra degradada en zonas extremas (capas superpuestas) ─────────

p_k  = plot(k, "K ref", color=color.new(color.white, 100), display=display.none)

// Niveles arriba (cada 2.5 unidades para suavizar)
p_80  = plot(80.0, "", color=color.new(color.white, 100), display=display.none)
p_82  = plot(82.5, "", color=color.new(color.white, 100), display=display.none)
p_85  = plot(85.0, "", color=color.new(color.white, 100), display=display.none)
p_87  = plot(87.5, "", color=color.new(color.white, 100), display=display.none)
p_90  = plot(90.0, "", color=color.new(color.white, 100), display=display.none)
p_92  = plot(92.5, "", color=color.new(color.white, 100), display=display.none)
p_95  = plot(95.0, "", color=color.new(color.white, 100), display=display.none)

// Niveles abajo
p_20  = plot(20.0, "", color=color.new(color.white, 100), display=display.none)
p_17  = plot(17.5, "", color=color.new(color.white, 100), display=display.none)
p_15  = plot(15.0, "", color=color.new(color.white, 100), display=display.none)
p_12  = plot(12.5, "", color=color.new(color.white, 100), display=display.none)
p_10  = plot(10.0, "", color=color.new(color.white, 100), display=display.none)
p_07  = plot(7.5, "", color=color.new(color.white, 100), display=display.none)
p_05  = plot(5.0, "", color=color.new(color.white, 100), display=display.none)

// ── Verde: 7 capas, tenue cerca de 80 → intenso cerca de K ──
fill(p_k, p_80, color=k > 80   ? color.new(#00E5CC, 96) : na, title="OB 1")
fill(p_k, p_82, color=k > 82.5 ? color.new(#00E5CC, 94) : na, title="OB 2")
fill(p_k, p_85, color=k > 85   ? color.new(#00E5CC, 92) : na, title="OB 3")
fill(p_k, p_87, color=k > 87.5 ? color.new(#00E5CC, 90) : na, title="OB 4")
fill(p_k, p_90, color=k > 90   ? color.new(#00E5CC, 88) : na, title="OB 5")
fill(p_k, p_92, color=k > 92.5 ? color.new(#00E5CC, 85) : na, title="OB 6")
fill(p_k, p_95, color=k > 95   ? color.new(#00E5CC, 82) : na, title="OB 7")

// ── Rojo: 7 capas, tenue cerca de 20 → intenso cerca de K ──
fill(p_20, p_k, color=k < 20   ? color.new(#E53935, 96) : na, title="OS 1")
fill(p_17, p_k, color=k < 17.5 ? color.new(#E53935, 94) : na, title="OS 2")
fill(p_15, p_k, color=k < 15   ? color.new(#E53935, 92) : na, title="OS 3")
fill(p_12, p_k, color=k < 12.5 ? color.new(#E53935, 90) : na, title="OS 4")
fill(p_10, p_k, color=k < 10   ? color.new(#E53935, 88) : na, title="OS 5")
fill(p_07, p_k, color=k < 7.5  ? color.new(#E53935, 85) : na, title="OS 6")
fill(p_05, p_k, color=k < 5    ? color.new(#E53935, 82) : na, title="OS 7")

// ── Zona central tenue (80-20) ──────────────────────────────────────

p_zone_hi = plot(ob, "Zone Hi", color=color.new(color.white, 100), display=display.none)
p_zone_lo = plot(os_lv, "Zone Lo", color=color.new(color.white, 100), display=display.none)
fill(p_zone_hi, p_zone_lo, top_color=color.new(color.gray, 95), bottom_color=color.new(color.gray, 95), title="Zona Central")

// Niveles casi invisibles
hline(50, "", color=color.new(color.gray, 93))
hline(ob, "", color=color.new(color.gray, 90))
hline(os_lv, "", color=color.new(color.gray, 90))

// ── TABLA MTF ───────────────────────────────────────────────────────

f_tf_label(tf_str) =>
    switch tf_str
        "1"    => "1m"
        "3"    => "3m"
        "5"    => "5m"
        "10"   => "10m"
        "15"   => "15m"
        "30"   => "30m"
        "45"   => "45m"
        "60"   => "1H"
        "120"  => "2H"
        "180"  => "3H"
        "240"  => "4H"
        "360"  => "6H"
        "480"  => "8H"
        "720"  => "12H"
        "D"    => "1D"
        "W"    => "1W"
        "M"    => "1M"
        => tf_str

f_k_bg(val) =>
    if val >= 90
        color.new(#00C853, 5)
    else if val >= 80
        color.new(#00E676, 15)
    else if val >= 70
        color.new(#69F0AE, 30)
    else if val >= 60
        color.new(#455A64, 45)
    else if val >= 40
        color.new(#37474F, 55)
    else if val >= 30
        color.new(#546E7A, 45)
    else if val >= 20
        color.new(#FF8A80, 30)
    else if val >= 10
        color.new(#FF5252, 15)
    else
        color.new(#FF1744, 5)

f_k_tc(val) =>
    if val >= 80
        color.new(#FFFFFF, 0)
    else if val >= 60
        color.new(#CFD8DC, 0)
    else if val >= 40
        color.new(#90A4AE, 0)
    else if val >= 20
        color.new(#CFD8DC, 0)
    else
        color.new(#FFFFFF, 0)

t_size = switch tbl_size
    "small"  => size.small
    "normal" => size.normal
    "large"  => size.large

if show_tbl and barstate.islast
    var table tbl = table.new(position.middle_right, 3, 4, bgcolor=color.new(#131722, 0), border_width=0)

    table.cell(tbl, 0, 0, "  TF  ", text_color=color.new(#607D8B, 0), text_size=t_size, bgcolor=color.new(#131722, 0))
    table.cell(tbl, 1, 0, "   K   ", text_color=color.new(#607D8B, 0), text_size=t_size, bgcolor=color.new(#131722, 0))
    table.cell(tbl, 2, 0, "", text_color=color.new(#607D8B, 0), text_size=t_size, bgcolor=color.new(#131722, 0))

    // Dirección: momentum de K vs su EMA(3), calculado dentro de cada temporalidad
    ar1 = dir1 > 0 ? "▲" : dir1 < 0 ? "▼" : "▸"
    ar2 = dir2 > 0 ? "▲" : dir2 < 0 ? "▼" : "▸"
    ar3 = dir3 > 0 ? "▲" : dir3 < 0 ? "▼" : "▸"
    dc1 = dir1 > 0 ? color.new(#00E676, 0) : dir1 < 0 ? color.new(#FF5252, 0) : color.new(#78909C, 0)
    dc2 = dir2 > 0 ? color.new(#00E676, 0) : dir2 < 0 ? color.new(#FF5252, 0) : color.new(#78909C, 0)
    dc3 = dir3 > 0 ? color.new(#00E676, 0) : dir3 < 0 ? color.new(#FF5252, 0) : color.new(#78909C, 0)

    table.cell(tbl, 0, 1, "  " + f_tf_label(tf1) + "  ", text_color=color.new(#B0BEC5, 0), text_size=t_size, bgcolor=color.new(#1E2430, 0))
    table.cell(tbl, 1, 1, "  " + str.tostring(k1, "#.#") + "  ", text_color=f_k_tc(k1), text_size=t_size, bgcolor=f_k_bg(k1))
    table.cell(tbl, 2, 1, ar1, text_color=dc1, text_size=t_size, bgcolor=color.new(#1E2430, 0))

    table.cell(tbl, 0, 2, "  " + f_tf_label(tf2) + "  ", text_color=color.new(#B0BEC5, 0), text_size=t_size, bgcolor=color.new(#1E2430, 0))
    table.cell(tbl, 1, 2, "  " + str.tostring(k2, "#.#") + "  ", text_color=f_k_tc(k2), text_size=t_size, bgcolor=f_k_bg(k2))
    table.cell(tbl, 2, 2, ar2, text_color=dc2, text_size=t_size, bgcolor=color.new(#1E2430, 0))

    table.cell(tbl, 0, 3, "  " + f_tf_label(tf3) + "  ", text_color=color.new(#B0BEC5, 0), text_size=t_size, bgcolor=color.new(#1E2430, 0))
    table.cell(tbl, 1, 3, "  " + str.tostring(k3, "#.#") + "  ", text_color=f_k_tc(k3), text_size=t_size, bgcolor=f_k_bg(k3))
    table.cell(tbl, 2, 3, ar3, text_color=dc3, text_size=t_size, bgcolor=color.new(#1E2430, 0))

// ── ALERTAS ─────────────────────────────────────────────────────────

alertcondition(k > ob and alert_ob, "Sobrecompra", "StochRSI en sobrecompra ({{ticker}})")
alertcondition(k < os_lv and alert_os, "Sobreventa", "StochRSI en sobreventa ({{ticker}})")
alertcondition(cross_up and alert_cx, "Cruce Alcista", "StochRSI cruce alcista ({{ticker}})")
alertcondition(cross_dn and alert_cx, "Cruce Bajista", "StochRSI cruce bajista ({{ticker}})")
