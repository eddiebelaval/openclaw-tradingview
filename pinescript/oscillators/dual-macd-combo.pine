//@version=5
indicator("Dual MACD Combo", overlay=false)

// === INPUTS ===
// MACD 1 settings
fast1   = input.int(12,  "MACD1 Fast Length")
slow1   = input.int(26,  "MACD1 Slow Length")
signal1 = input.int(9,   "MACD1 Signal Length")

// MACD 2 settings
fast2   = input.int(5,   "MACD2 Fast Length")
slow2   = input.int(35,  "MACD2 Slow Length")
signal2 = input.int(5,   "MACD2 Signal Length")

// === MACD CALCULATIONS ===
// MACD 1
[macdLine1, signalLine1, hist1] = ta.macd(close, fast1, slow1, signal1)

// MACD 2
[macdLine2, signalLine2, hist2] = ta.macd(close, fast2, slow2, signal2)

// === COMBINED SIGNAL CONDITIONS ===
bullish = macdLine1 > signalLine1 and macdLine2 > signalLine2
bearish = macdLine1 < signalLine1 and macdLine2 < signalLine2

// === PLOTS ===
// Histogram plots
plot(hist1, title="Histogram 1", style=plot.style_columns, color=hist1 >= 0 ? color.teal : color.red)
plot(hist2, title="Histogram 2", style=plot.style_columns, color=hist2 >= 0 ? color.blue : color.orange)

// MACD & Signal lines
plot(macdLine1,  title="MACD1 Line",  color=color.teal,  linewidth=2)
plot(signalLine1,title="MACD1 Signal",color=color.red)

plot(macdLine2,  title="MACD2 Line",  color=color.blue,  linewidth=2)
plot(signalLine2,title="MACD2 Signal",color=color.orange)

// Zero line
hline(0, "Zero Line", color=color.gray)

// === BUY/SELL SIGNAL MARKERS ===
plotshape(bullish, title="Bullish Agreement", location=location.bottom,
          color=color.lime, style=shape.triangleup, size=size.small, text="BUY")

plotshape(bearish, title="Bearish Agreement", location=location.top,
          color=color.red, style=shape.triangledown, size=size.small, text="SELL")
