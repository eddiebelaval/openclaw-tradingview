//@version=6
indicator("ADR Ratio Table (Customizable)", overlay=true)

// === INPUTS ===
shortLen = input.int(5, "ADR Short Period", minval=1)
longLen  = input.int(21, "ADR Long Period", minval=1)

// === TABLE SETTINGS ===
posY = input.string("Top", "Table Vertical Position", options=["Top", "Bottom"])
posX = input.string("Right", "Table Horizontal Position", options=["Left", "Right"])

txtSizeInput = input.string("Normal", "Text Size", options=["Small", "Normal", "Large"])

headerBg = input.color(color.gray, "Header Background")
cellBg   = input.color(color.new(color.black, 80), "Cell Background")
textCol  = input.color(color.white, "Text Color")

// === POSITION LOGIC ===
tablePos = posY == "Top" and posX == "Right" ? position.top_right :
           posY == "Top" and posX == "Left"  ? position.top_left  :
           posY == "Bottom" and posX == "Right" ? position.bottom_right :
           position.bottom_left

// === TEXT SIZE ===
txtSize = txtSizeInput == "Small" ? size.small :
          txtSizeInput == "Large" ? size.large :
          size.normal

// === DAILY RANGE ===
dailyRange = request.security(syminfo.tickerid, "D", high - low)

// === ADR CALCULATIONS ===
adrShort = ta.sma(dailyRange, shortLen)
adrLong  = ta.sma(dailyRange, longLen)
adrRatio = adrLong != 0 ? adrShort / adrLong : na

// === TABLE ===
var table adrTable = table.new(tablePos, 2, 4, frame_width=1)

if barstate.islast
    table.clear(adrTable, 0, 0, 1, 3)

    table.cell(adrTable, 0, 0, "Metric", bgcolor=headerBg, text_color=textCol, text_size=txtSize)
    table.cell(adrTable, 1, 0, "Value",  bgcolor=headerBg, text_color=textCol, text_size=txtSize)

    table.cell(adrTable, 0, 1, "ADR Short (" + str.tostring(shortLen) + ")", bgcolor=cellBg, text_color=textCol, text_size=txtSize)
    table.cell(adrTable, 1, 1, str.tostring(adrShort, format.mintick), bgcolor=cellBg, text_color=textCol, text_size=txtSize)

    table.cell(adrTable, 0, 2, "ADR Long (" + str.tostring(longLen) + ")", bgcolor=cellBg, text_color=textCol, text_size=txtSize)
    table.cell(adrTable, 1, 2, str.tostring(adrLong, format.mintick), bgcolor=cellBg, text_color=textCol, text_size=txtSize)

    table.cell(adrTable, 0, 3, "ADR Ratio", bgcolor=cellBg, text_color=textCol, text_size=txtSize)
    table.cell(adrTable, 1, 3, str.tostring(adrRatio, "#.###"), bgcolor=cellBg, text_color=textCol, text_size=txtSize)
