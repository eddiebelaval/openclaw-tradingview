//@version=6
indicator(
     title      = "Trend Pulse Oscillator [invincible3]",
     shorttitle = "TPO",
     overlay    = false
)

// ─────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────

// Core source
src = input.source(close, "Source")

// Squeeze Momentum settings
bbLength     = input.int(20,  "BB Length", minval = 1)
bbMult       = input.float(2.0, "BB MultFactor", minval = 0.1, step = 0.1)
kcLength     = input.int(20,  "KC Length", minval = 1)
kcMult       = input.float(1.5, "KC MultFactor", minval = 0.1, step = 0.1)
useTrueRange = input.bool(true, "Use True Range (KC)")

// Normalization settings
normLen     = input.int(200, "Normalize Lookback", minval = 20, group="Settings")
targetRange = input.float(100.0, "Target Range (+/-)", minval = 10, group="Settings")
zClamp      = input.float(3.0, "Z-Score Clamp", minval = 1, group="Settings")

// Zone levels
bandLevel = input.float(60.0, "Band Level (+/-)", minval = 1, maxval = 100, group="Settings")

// MACD settings
macdSource = input.source(close, "MACD Source", group="macd")
fastLen    = input.int(12, "Fast Length", minval = 1, group="macd")
slowLen    = input.int(26, "Slow Length", minval = 1, group="macd")
sigLen     = input.int(9,  "Signal Length", minval = 1, group="macd")
oscType    = input.string("EMA", "Oscillator MA Type", options = ["EMA", "SMA"], group="macd")
sigType    = input.string("EMA", "Signal MA Type", options = ["EMA", "SMA"], group="macd")

// ─────────────────────────────────────────────────────────────
// HELPER FUNCTIONS
// ─────────────────────────────────────────────────────────────

// Clamp a value between minimum and maximum bounds.
clamp(x, minv, maxv) =>
    x < minv ? minv : x > maxv ? maxv : x

// Normalize any series into a symmetric target range using z-score scaling.
// Extreme values are capped by zClamp to reduce distortion from outliers.
normalizeToRange(_x, _len, _range, _zClamp) =>
    _mean = ta.sma(_x, _len)
    _sd   = ta.stdev(_x, _len)
    _z    = _sd == 0.0 ? 0.0 : (_x - _mean) / _sd
    _zc   = clamp(_z, -_zClamp, _zClamp)
    _range * (_zc / _zClamp)

// Return selected MA type.
maType(float _src, int _len, string _type) =>
    emaVal = ta.ema(_src, _len)
    smaVal = ta.sma(_src, _len)
    _type == "EMA" ? emaVal : smaVal
// ─────────────────────────────────────────────────────────────
// SQUEEZE MOMENTUM COMPONENT
// ─────────────────────────────────────────────────────────────

// Bollinger Bands
bbBasis = ta.sma(src, bbLength)
bbDev   = bbMult * ta.stdev(src, bbLength)
upperBB = bbBasis + bbDev
lowerBB = bbBasis - bbDev

// Keltner Channels
kcBasis = ta.sma(src, kcLength)
kcRange = useTrueRange ? ta.tr(true) : (high - low)
kcAvg   = ta.sma(kcRange, kcLength)
upperKC = kcBasis + kcAvg * kcMult
lowerKC = kcBasis - kcAvg * kcMult

// Squeeze states
sqzOn  = lowerBB > lowerKC and upperBB < upperKC
sqzOff = lowerBB < lowerKC and upperBB > upperKC
noSqz  = not sqzOn and not sqzOff

// Raw momentum calculation
hh     = ta.highest(high, kcLength)
ll     = ta.lowest(low, kcLength)
mid    = math.avg(math.avg(hh, ll), ta.sma(src, kcLength))
valRaw = ta.linreg(src - mid, kcLength, 0)

// Normalized squeeze momentum
trendOsc = normalizeToRange(valRaw, normLen, targetRange, zClamp)

// Histogram color logic
histColor = trendOsc > 0
     ? (trendOsc > nz(trendOsc[1]) ? #17dfad : #dd326b)
     : (trendOsc < nz(trendOsc[1]) ? #dd326b : #17dfad)

// Zero-line color indicates squeeze state
zeroColor = noSqz ? color.blue : sqzOn ? color.yellow : color.gray

// ─────────────────────────────────────────────────────────────
// MACD COMPONENT
// ─────────────────────────────────────────────────────────────

// Raw MACD values
maFast = maType(macdSource, fastLen, oscType)
maSlow = maType(macdSource, slowLen, oscType)

macdRaw   = maFast - maSlow
signalRaw = maType(macdRaw, sigLen, sigType)

// Normalized MACD lines for visual scale alignment
macdNorm   = normalizeToRange(macdRaw, normLen, targetRange, zClamp)
signalNorm = normalizeToRange(signalRaw, normLen, targetRange, zClamp)

// ─────────────────────────────────────────────────────────────
// PLOTS
// ─────────────────────────────────────────────────────────────

// Main normalized trend histogram
plot(trendOsc, title = "Trend Oscillator", style = plot.style_histogram, color = histColor, linewidth = 4)

// Normalized MACD overlay lines
plot(macdNorm,   title = "MACD (Normalized)",   color = color.blue,   linewidth = 2)
plot(signalNorm, title = "Signal (Normalized)", color = color.orange, linewidth = 1)

// Zero line with squeeze-state coloring
plot(0, title = "Zero Line", color = zeroColor, linewidth = 2)

// Reference bands
upperBand = hline(bandLevel,  "Upper Band", color = color.black)
lowerBand = hline(-bandLevel, "Lower Band", color = color.black)
fill(upperBand, lowerBand, color = #bd9ff122, title = "Band Fill")
