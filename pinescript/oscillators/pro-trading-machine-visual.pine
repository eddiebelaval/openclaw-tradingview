// ╔══════════════════════════════════════════════════════════════╗
// ║  FUNCTIONS                                                   ║
// ╚══════════════════════════════════════════════════════════════╝

f_n(series float v) => na(v) ? 0.0   : math.max(-1.0,   math.min(1.0,   v))
f_p(series float v) => na(v) ? 0.0   : math.max(-120.0, math.min(120.0, v))
f_barGuard(series float v, simple int minBars) => bar_index >= minBars ? v : na

f_cs(series float v, simple bool on) =>
    on ? ta.ema(ta.ema(v, 3), 3) : v

f_vzo(simple int len, simple bool sm, simple int sn) =>
    float dir   = close > close[3] ? volume : -volume
    float tvol  = ta.linreg(volume, len, 0)
    float dvol  = ta.linreg(dir,    len, 0)
    // Clamp raw BEFORE EMA: prevents extreme linreg spikes (low-volume bars
    // make denominator near-zero → raw ±500+) from locking EMA near ±120.
    // This matches Van Helsig's intent — EMA smooths an already-bounded signal.
    float raw   = math.max(-120.0, math.min(120.0,
         100.0 * dvol / math.max(tvol, 1e-6)))
    sm ? ta.ema(raw, sn) : raw

f_zscore(simple int len, simple string srcStr) =>
    float s = switch srcStr
        "Returns" => (close - open) / close * 100
        "open"    => open
        "high"    => high
        "low"     => low
        "hl2"     => hl2
        =>           close
    int   L = srcStr == "Returns" ? len * 5 : len
    float _std = ta.stdev(s, L)
    float _sma = ta.sma(s, L)
    float z    = bar_index < L ? 0.0 : (s - _sma) / math.max(_std, 1e-10)
    math.max(-4.0, math.min(4.0, z))

f_cto(simple int sp, simple int psLen, simple bool cs) =>
    float s   = close
    float c01=ta.ema(s, 1*sp),  float c02=ta.ema(s, 2*sp),  float c03=ta.ema(s, 3*sp)
    float c04=ta.ema(s, 4*sp),  float c05=ta.ema(s, 5*sp),  float c06=ta.ema(s, 6*sp)
    float c07=ta.ema(s, 7*sp),  float c08=ta.ema(s, 8*sp),  float c09=ta.ema(s, 9*sp)
    float c10=ta.ema(s,10*sp),  float c11=ta.ema(s,11*sp),  float c12=ta.ema(s,12*sp)
    float c13=ta.ema(s,13*sp),  float c14=ta.ema(s,14*sp),  float c15=ta.ema(s,15*sp)
    float c16=ta.ema(s,16*sp),  float c17=ta.ema(s,17*sp),  float c18=ta.ema(s,18*sp)
    float c19=ta.ema(s,19*sp),  float c20=ta.ema(s,20*sp),  float c21=ta.ema(s,21*sp)
    float c22=ta.ema(s,22*sp),  float c23=ta.ema(s,23*sp),  float c24=ta.ema(s,24*sp)
    float c25=ta.ema(s,25*sp),  float c26=ta.ema(s,26*sp),  float c27=ta.ema(s,27*sp)
    float c28=ta.ema(s,28*sp),  float c29=ta.ema(s,29*sp),  float c30=ta.ema(s,30*sp)
    float c31=ta.ema(s,31*sp),  float c32=ta.ema(s,32*sp),  float c33=ta.ema(s,33*sp)
    int sc =
         (s>c01?1:-1)+(c01>c02?1:-1)+(c02>c03?1:-1)+(c03>c04?1:-1)+(c04>c05?1:-1)+
         (c05>c06?1:-1)+(c06>c07?1:-1)+(c07>c08?1:-1)+(c08>c09?1:-1)+(c09>c10?1:-1)+
         (c10>c11?1:-1)+(c11>c12?1:-1)+(c12>c13?1:-1)+(c13>c14?1:-1)+(c14>c15?1:-1)+
         (c15>c16?1:-1)+(c16>c17?1:-1)+(c17>c18?1:-1)+(c18>c19?1:-1)+(c19>c20?1:-1)+
         (c20>c21?1:-1)+(c21>c22?1:-1)+(c22>c23?1:-1)+(c23>c24?1:-1)+(c24>c25?1:-1)+
         (c25>c26?1:-1)+(c26>c27?1:-1)+(c27>c28?1:-1)+(c28>c29?1:-1)+(c29>c30?1:-1)+
         (c30>c31?1:-1)+(c31>c32?1:-1)+(c32>c33?1:-1)
    float raw = float(sc) / 33.0
    float sm  = psLen > 1 ? ta.ema(raw, psLen) : raw
    f_n(f_cs(sm, cs))

f_adx(simple int len, simple int diLen, simple float mid) =>
    [_, _, adxV] = ta.dmi(diLen, len)
    f_n((adxV - mid) / math.max(mid, 1e-6))

f_aroon(simple int len, simple int sm, simple bool cs) =>
    float aU  = 100.0 * (ta.highestbars(high, len+1) + len) / len
    float aD  = 100.0 * (ta.lowestbars(low,  len+1) + len) / len
    float raw = (aU - aD) / 100.0
    float e1  = ta.ema(raw, sm)
    float zl  = e1 + (e1 - ta.ema(e1, sm))
    f_n(f_cs(zl, cs))

f_rsi(series float src, simple int len, simple bool cs) =>
    float r = f_n((ta.rsi(src, len) - 50.0) / 50.0)
    f_cs(r, cs)

f_tpx(simple int len, simple int sm, simple int cl, simple bool preS, simple int preV) =>
    float R        = ta.highest(2) - ta.lowest(2)
    float hiup     = math.max(ta.change(high), 0.0)
    float loup     = math.max(ta.change(low),  0.0)
    float bulls    = math.min((hiup + loup) / math.max(R, 1e-10), 1.0) * 100.0
    float avgbull  = ta.wma(nz(bulls), len)
    float avgbulls = preS ? ta.wma(avgbull, preV) : avgbull
    float hidn     = math.min(ta.change(high), 0.0)
    float lodn     = math.min(ta.change(low),  0.0)
    float bears    = math.max((hidn + lodn) / math.max(R, 1e-10), -1.0) * -100.0
    float avgbear  = ta.wma(nz(bears), len)
    float avgbears = preS ? ta.wma(avgbear, preV) : avgbear
    float net      = ta.wma(avgbulls - avgbears, sm)
    f_n(net / math.max(float(cl), 1e-6))

f_ma_dmi(series float x, simple int len, simple string t) =>
    switch t
        "SMA" => ta.sma(x, len)
        "WMA" => ta.wma(x, len)
        "RMA" => ta.rma(x, len)
        =>       ta.ema(x, len)

f_dmi(simple int len, simple int normLen, simple bool smOn, simple int smLen, simple string smT) =>
    float hiD = high  - high[1]
    float loD = low[1] - low
    float pDM = hiD > loD and hiD > 0 ? hiD : 0.0
    float mDM = loD > hiD and loD > 0 ? loD : 0.0
    float tr  = math.max(high - low,
         math.max(math.abs(high - close[1]), math.abs(low - close[1])))
    float atr = ta.rma(tr, len)
    float diP_raw = 100.0 * ta.rma(pDM, len) / math.max(atr, 1e-6)
    float diM_raw = 100.0 * ta.rma(mDM, len) / math.max(atr, 1e-6)
    float diP = smOn ? f_ma_dmi(diP_raw, smLen, smT) : diP_raw
    float diM = smOn ? f_ma_dmi(diM_raw, smLen, smT) : diM_raw
    float raw = math.abs(diP - diM) * (diP >= diM ? 1.0 : -1.0)
    float mx  = ta.highest(math.abs(raw), normLen)
    f_n(raw / math.max(mx, 1e-6))

// ╔══════════════════════════════════════════════════════════════╗
// ║  MARKET REGIME                                               ║
// ╚══════════════════════════════════════════════════════════════╝
float sma20   = ta.sma(close, 20)
float sma50   = ta.sma(close, 50)
float tDiff   = math.abs(sma20 - sma50) / math.max(sma50, 1e-6)
bool  isTrend = tDiff > 0.003
var float regimeSmooth = 0.5
regimeSmooth := 0.9 * nz(regimeSmooth[1], 0.5) + 0.1 * (isTrend ? 1.0 : 0.0)
bool  trendConfirmed = regimeSmooth > 0.6
bool  flatConfirmed  = regimeSmooth < 0.4

// ╔══════════════════════════════════════════════════════════════╗
// ║  ATR NORMALISATION FACTOR                                    ║
// ╚══════════════════════════════════════════════════════════════╝
float atrVal    = ta.atr(atrLen)
float atrAvg    = ta.sma(atrVal, 50)
float atrFactor = atrNorm
     ? math.max(0.3, math.min(3.0, atrVal / math.max(atrAvg, 1e-6)))
     : 1.0

// ╔══════════════════════════════════════════════════════════════╗
// ║  VZO — SINGLE CALL                                           ║
// ║  f_vzo() contains ta.ema (stateful). Calling it twice       ║
// ║  creates two independent EMA states that diverge over time. ║
// ║  _vzoRawLocal is the single source of truth for all uses:   ║
// ║  display, symbol scaling, composite weight, divergence.     ║
// ║  Custom TF: separate security call is unavoidable but rare. ║
// ╚══════════════════════════════════════════════════════════════╝
float _vzoRawLocal = f_vzo(vzoLen, vzoSm, vzoSmN)
float _vzoMean     = ta.sma(_vzoRawLocal, symLen)
float _vzoStd      = ta.stdev(_vzoRawLocal, symLen)

// ╔══════════════════════════════════════════════════════════════╗
// ║  ADAPTIVE WEIGHT MULTIPLIERS                                 ║
// ╚══════════════════════════════════════════════════════════════╝
float _lerpT  = adaptW ? math.max(0.0, math.min(1.0, (regimeSmooth - 0.4) / 0.6)) : 0.5
float mCTO    = adaptW ? (0.7 + _lerpT * 0.7) : 1.0
float mVZO    = adaptW ? (0.7 + _lerpT * 0.6) : 1.0
float mDMI    = adaptW ? (0.7 + _lerpT * 0.6) : 1.0
float mRSI    = adaptW ? (1.4 - _lerpT * 0.7) : 1.0
float mZS_    = adaptW ? (1.3 - _lerpT * 0.7) : 1.0
float mADX    = 1.0
float mARN    = 1.0
float mTPX    = 1.0

// ╔══════════════════════════════════════════════════════════════╗
// ║  COMPUTE                                                     ║
// ╚══════════════════════════════════════════════════════════════╝

// — VZO
// _vzoRawLocal holds the single EMA-state result. Used directly for local TF.
// Custom TF security call is a separate EMA context — unavoidable for MTF.
float vzoRaw = vzoUTF and vzoTF != ""
     ? request.security(syminfo.tickerid, vzoTF,
          f_vzo(vzoLen, vzoSm, vzoSmN),
          barmerge.gaps_off, barmerge.lookahead_off)
     : _vzoRawLocal
float _vzoScaled = symOn and _vzoStd > 1e-6 and bar_index >= symLen
     ? f_p((vzoRaw - _vzoMean) / _vzoStd * 40.0)
     : f_p(vzoRaw)
float vzoDisp  = _vzoScaled
float _vzoN    = vzoInC ? f_n(vzoDisp / 120.0 * atrFactor) : 0.0

// — Z-Score: compute locally only when enabled; fetch from custom TF if configured
float _zsRawLocal = zsOn ? f_zscore(zsLen, zsSrc) : 0.0
float zsRaw    = zsOn and zsUTF and zsTF != ""
     ? request.security(syminfo.tickerid, zsTF,
          f_zscore(zsLen, zsSrc),
          barmerge.gaps_off, barmerge.lookahead_off)
     : _zsRawLocal
float _zsSmaFull  = ta.sma(zsRaw, symLen)
float _zsStdFull  = ta.stdev(zsRaw, symLen)
float _zsMean  = symOn ? _zsSmaFull : 0.0
float _zsStd   = symOn ? _zsStdFull : 1.0
float zsScaled = symOn and _zsStd > 1e-6 and bar_index >= symLen ? (zsRaw - _zsMean) / _zsStd : zsRaw
float zsDisp   = zsOn ? f_p(zsScaled * 30.0) : na

// — DMI (unified: one f_dmi() call, shared for display + composite weight)
// Moved before Components so _dmiN is available when building _cmpRaw.
float _dmiShared = (dmiOn or dmiInC) ? f_dmi(dmiLen, dmiNL, dmiSmOn, dmiSmL, dmiSmT) : 0.0
float _dmiDisp   = _dmiShared
float _dmiN      = dmiInC ? _dmiShared : 0.0

// — Components
float _cto     = ctoOn ? f_cto(ctoSpc, ctoPsL, conserv)           : 0.0
float _adx     = adxOn ? f_adx(adxLen, adxDL, adxMid)             : 0.0
float _arn     = arnOn ? f_aroon(arnLen, arnSm, conserv)           : 0.0
float _rsiSrc  = switch rsiSrc
    "open"  => open
    "high"  => high
    "low"   => low
    "hl2"   => hl2
    =>         close
float _rsi     = rsiOn  ? f_rsi(_rsiSrc, rsiLen, conserv)         : 0.0
float _tpx     = tpxOn  ? f_tpx(tpxLen, tpxSm, tpxCL, tpxPre, tpxPreV) : 0.0
float _zsN     = zsOn   ? f_n(zsRaw / 4.0 * mZS_)                : 0.0

// ╔══════════════════════════════════════════════════════════════╗
// ║  ML ONLINE WEIGHT SCORING                                    ║
// ╚══════════════════════════════════════════════════════════════╝
bool _priceUp = close[1] > close[2]
float _mlCtoSig = _cto[1] > 0 ? (_priceUp ? 1.0 : -1.0) : (_priceUp ? -1.0 : 1.0)
float _mlRsiSig = _rsi[1] > 0 ? (_priceUp ? 1.0 : -1.0) : (_priceUp ? -1.0 : 1.0)
float _mlVzoSig = _vzoN[1] > 0 ? (_priceUp ? 1.0 : -1.0) : (_priceUp ? -1.0 : 1.0)
float _mlArnSig = _arn[1]  > 0 ? (_priceUp ? 1.0 : -1.0) : (_priceUp ? -1.0 : 1.0)
float _mlTpxSig = _tpx[1]  > 0 ? (_priceUp ? 1.0 : -1.0) : (_priceUp ? -1.0 : 1.0)
float _mlCtoEma = ta.ema(_mlCtoSig, mlLen)
float _mlRsiEma = ta.ema(_mlRsiSig, mlLen)
float _mlVzoEma = ta.ema(_mlVzoSig, mlLen)
float _mlArnEma = ta.ema(_mlArnSig, mlLen)
float _mlTpxEma = ta.ema(_mlTpxSig, mlLen)
float _mlCTO = mlOn ? _mlCtoEma : 0.0
float _mlRSI = mlOn ? _mlRsiEma : 0.0
float _mlVZO = mlOn ? _mlVzoEma : 0.0
float _mlARN = mlOn ? _mlArnEma : 0.0
float _mlTPX = mlOn ? _mlTpxEma : 0.0
f_mlMult(float score) => 1.0 + score * 0.3

// — Effective weights
float _wCTO    = ctoOn  ? ctoW * mCTO * (mlOn ? f_mlMult(_mlCTO) : 1.0) : 0.0
float _wADX    = adxOn  ? adxW * mADX : 0.0
float _wARN    = arnOn  ? arnW * mARN * (mlOn ? f_mlMult(_mlARN) : 1.0) : 0.0
float _wRSI    = rsiOn  ? rsiW * mRSI * (mlOn ? f_mlMult(_mlRSI) : 1.0) : 0.0
float _wTPX    = tpxOn  ? tpxW * mTPX * (mlOn ? f_mlMult(_mlTPX) : 1.0) : 0.0
float _wVZO    = vzoInC ? vzoW * mVZO * (mlOn ? f_mlMult(_mlVZO) : 1.0) : 0.0
float _wDMI    = dmiInC ? dmiW * mDMI : 0.0
float _wZS     = zsOn   ? zsCompW * mZS_ : 0.0
float _wTot    = math.max(_wCTO+_wADX+_wARN+_wRSI+_wTPX+_wVZO+_wDMI+_wZS, 1e-6)

// — Composite raw
float _cmpRaw  = (_cto*_wCTO + _adx*_wADX + _arn*_wARN + _rsi*_wRSI +
                  _tpx*_wTPX + _vzoN*_wVZO*atrFactor + _dmiN*_wDMI*atrFactor +
                  _zsN*_wZS) / _wTot * 100.0

int _smL       = conserv ? math.max(cmpSmL, 7) : cmpSmL
float _cmpFin  = cmpSm ? ta.ema(_cmpRaw, _smL) : _cmpRaw
float cmpVal   = cmpOn
     ? (cmpUTF and cmpTF != ""
          ? request.security(syminfo.tickerid, cmpTF, _cmpFin, barmerge.gaps_off, barmerge.lookahead_off)
          : _cmpFin)
     : na

// — DMI TF fetch (uses already-computed _dmiShared from above)
float dmiVal     = dmiOn
     ? (dmiUTF and dmiTF != ""
          ? request.security(syminfo.tickerid, dmiTF, _dmiShared, barmerge.gaps_off, barmerge.lookahead_off)
          : _dmiShared)
     : na

// — VZO zone geometry
float vzo_ob_edge = f_p(vzoDisp >  vzoOBlo ? vzoDisp :  vzoOBlo)
float vzo_os_edge = f_p(vzoDisp < -vzoOBlo ? vzoDisp : -vzoOBlo)
// rngUp and rngDn are NOT symmetric: sma(vzoDisp+W) ≠ sma(-vzoDisp-W)
// because vzoDisp can be negative, making (vzoDisp+W) < (-vzoDisp-W).
// Two separate SMA calls are required for correctness.
float rngUp       = ta.sma(vzoDisp  + rngW, rngL)
float rngDn       = ta.sma(-vzoDisp - rngW, rngL)

// ╔══════════════════════════════════════════════════════════════╗
// ║  MTF COMPUTE  (3 values → 1 tuple, guarded by mtfOn)       ║
// ║  request.security NOT called when mtfOn=false — saves CPU.  ║
// ╚══════════════════════════════════════════════════════════════╝
var float mtfVZO = 0.0
var float mtfCmp = 0.0
var float mtfZs  = 0.0
if mtfOn
    [_rv, _rc, _rz] = request.security(syminfo.tickerid, mtfTF,
         [f_vzo(vzoLen, vzoSm, vzoSmN), _cmpRaw, zsRaw],
         barmerge.gaps_off, barmerge.lookahead_off)
    mtfVZO := nz(_rv)
    mtfCmp := nz(_rc)
    mtfZs  := nz(_rz)

int _mtfBullConf = not mtfOn ? 3 :
     (mtfVZO > 10.0 ? 1 : 0) +
     (mtfCmp > 10.0 ? 1 : 0) +
     (mtfZs  > 0.2  ? 1 : 0)
int _mtfBearConf = not mtfOn ? 3 :
     (mtfVZO < -10.0 ? 1 : 0) +
     (mtfCmp < -10.0 ? 1 : 0) +
     (mtfZs  < -0.2  ? 1 : 0)
bool mtfBullOk   = _mtfBullConf >= mtfMin
bool mtfBearOk   = _mtfBearConf >= mtfMin

// ╔══════════════════════════════════════════════════════════════╗
// ║  CONFLUENCE METER                                            ║
// ╚══════════════════════════════════════════════════════════════╝
float _thresh  = input.float(0.08, "Confluence Threshold", group=gPan,
     minval=0.01, maxval=0.30, step=0.01,
     tooltip="Min normalised value [0..1] for a component to count as aligned.\nLower = more sensitive, higher = stricter. Default 0.08 = ~8% of max swing.")
int confScore =
     (ctoOn  ? (_cto   >  _thresh ? 1 : _cto   < -_thresh ? -1 : 0) : 0) +
     (adxOn  ? (_adx   >  _thresh ? 1 : _adx   < -_thresh ? -1 : 0) : 0) +
     (arnOn  ? (_arn   >  _thresh ? 1 : _arn   < -_thresh ? -1 : 0) : 0) +
     (rsiOn  ? (_rsi   >  _thresh ? 1 : _rsi   < -_thresh ? -1 : 0) : 0) +
     (tpxOn  ? (_tpx   >  _thresh ? 1 : _tpx   < -_thresh ? -1 : 0) : 0) +
     (vzoInC ? (_vzoN  >  _thresh ? 1 : _vzoN  < -_thresh ? -1 : 0) : 0) +
     (dmiInC ? (_dmiN  >  _thresh ? 1 : _dmiN  < -_thresh ? -1 : 0) : 0)

bool confBullActive = showConf and confScore >=  confMin and mtfBullOk
bool confBearActive = showConf and confScore <= -confMin and mtfBearOk

// ╔══════════════════════════════════════════════════════════════╗
// ║  DIVERGENCE DETECTION                                        ║
// ╚══════════════════════════════════════════════════════════════╝
bool _divOk     = bar_index >= divLB
bool divBearVZO = _divOk and vzoRaw > divVZOT and
     vzoRaw[divLB] < vzoRaw and
     _cmpRaw < divCmpT and
     _cmpRaw[divLB] > _cmpRaw

bool divBullVZO = _divOk and vzoRaw < -divVZOT and
     vzoRaw[divLB] > vzoRaw and
     _cmpRaw > -divCmpT and
     _cmpRaw[divLB] < _cmpRaw

// Z-Score adaptive thresholds — always use rolling stats for divergence accuracy,
// regardless of symOn flag (symOn is for display scaling, not divergence detection)
float _zsAdpMean = ta.sma(zsRaw, symLen)
float _zsAdpStd  = ta.stdev(zsRaw, symLen)
float _zsAdpHi   = _zsAdpMean + divZsT * math.max(_zsAdpStd, 0.1)
float _zsAdpLo   = _zsAdpMean - divZsT * math.max(_zsAdpStd, 0.1)
float _zsHighest = ta.highest(zsRaw, divLB * 2)
float _zsLowest  = ta.lowest(zsRaw,  divLB * 2)
bool zsNewHigh   = _divOk and zsRaw >= _zsHighest and zsRaw > _zsAdpHi
bool zsNewLow    = _divOk and zsRaw <= _zsLowest  and zsRaw < _zsAdpLo

bool divBearZ    = zsNewHigh and _cmpRaw < _cmpRaw[divLB] and zsRaw > 0.0
bool divBullZ    = zsNewLow  and _cmpRaw > _cmpRaw[divLB] and zsRaw < 0.0

bool divBear     = divBearVZO or divBearZ
bool divBull     = divBullVZO or divBullZ

// ╔══════════════════════════════════════════════════════════════╗
// ║  COLORS                                                      ║
// ╚══════════════════════════════════════════════════════════════╝
color zsCol   = zsOn ? color.from_gradient(zsRaw, -3.5, 3.5, zsDn, zsUp) : na

float cmpAbs  = math.abs(nz(cmpVal))
color cmpCol  = nz(cmpVal) >= 0.0
     ? color.from_gradient(cmpAbs, 0.0, 100.0, color.new(cmpBull,cmpAlpLo), color.new(cmpBull,cmpAlpHi))
     : color.from_gradient(cmpAbs, 0.0, 100.0, color.new(cmpBear,cmpAlpLo), color.new(cmpBear,cmpAlpHi))

float dmiAbsV = math.abs(nz(dmiVal))
color dmiCol  = nz(dmiVal) > 0.0
     ? color.from_gradient(dmiAbsV, 0.0, 1.0, dmiBuy2, dmiBuy1)
     : color.from_gradient(dmiAbsV, 0.0, 1.0, dmiSel2, dmiSel1)

color vzoBarC = vzoDisp > 0.0
     ? color.from_gradient(vzoDisp,  0.0, 120.0, color.new(#00E676,60), #00E676)
     : color.from_gradient(-vzoDisp, 0.0, 120.0, color.new(#FF1744,60), #FF1744)

float confAbs = math.abs(float(confScore)) / 7.0
color confCol = confScore > 0
     ? color.new(confBullC, int(100.0 - confAbs * 80.0))
     : color.new(confBearC, int(100.0 - confAbs * 80.0))

// ╔══════════════════════════════════════════════════════════════╗
// ║  BAR COLOR                                                   ║
// ╚══════════════════════════════════════════════════════════════╝
color barOut = na
if barMode == "Composite" and cmpOn
    barOut := color.new(cmpCol, barAlp)
else if barMode == "DMI" and dmiOn
    barOut := color.new(dmiCol, barAlp)
else if barMode == "VZO"
    barOut := color.new(vzoBarC, barAlp)
else if barMode == "Confluence"
    barOut := color.new(confCol, barAlp)
barcolor(barOut, title="Bar Color")

// ╔══════════════════════════════════════════════════════════════╗
// ║  ALERTS                                                      ║
// ╚══════════════════════════════════════════════════════════════╝
string _divType  = divBearVZO ? "VZO-CMP" : divBearZ ? "Z-CMP" : divBullVZO ? "VZO-CMP" : divBullZ ? "Z-CMP" : ""
string _confCtx  = "CTO:" + ((_cto > _thresh) ? "▲" : (_cto < -_thresh) ? "▼" : "−") +
     " VZO:" + ((_vzoN > _thresh) ? "▲" : (_vzoN < -_thresh) ? "▼" : "−") +
     " RSI:" + ((_rsi  > _thresh) ? "▲" : (_rsi  < -_thresh) ? "▼" : "−") +
     " TPX:" + ((_tpx  > _thresh) ? "▲" : (_tpx  < -_thresh) ? "▼" : "−") +
     " DMI:" + ((_dmiN > _thresh) ? "▲" : (_dmiN < -_thresh) ? "▼" : "−")
string _aCtx = " | " + _confCtx +
     " | Conf:" + str.tostring(confScore) + "/7" +
     " | Div:" + _divType +
     " | ATR:" + str.tostring(math.round(atrFactor, 2)) + "x" +
     " | Regime:" + (trendConfirmed ? "TREND" : flatConfirmed ? "FLAT" : "TRANS") +
     " | MTF:" + (mtfOn ? (mtfBearOk or mtfBullOk ? "✓" : "✗") : "off") +
     " | TF:" + timeframe.period

alertcondition(divBear,        "PTM: Bear Divergence",   "PTM Bear Divergence detected")
alertcondition(divBull,        "PTM: Bull Divergence",   "PTM Bull Divergence detected")
alertcondition(confBullActive, "PTM: Bull Confluence",   "PTM Bull Confluence active")
alertcondition(confBearActive, "PTM: Bear Confluence",   "PTM Bear Confluence active")
alertcondition(divBear or confBearActive, "PTM: Bear",   "PTM Bearish condition")
alertcondition(divBull or confBullActive, "PTM: Bull",   "PTM Bullish condition")

bool _fireDivBear  = divBear  and (divAlert == "Both" or divAlert == "Divergence Only")
bool _fireConfBear = confBearActive and not confBearActive[1] and (divAlert == "Both" or divAlert == "Confluence Only")
bool _fireDivBull  = divBull  and (divAlert == "Both" or divAlert == "Divergence Only")
bool _fireConfBull = confBullActive and not confBullActive[1] and (divAlert == "Both" or divAlert == "Confluence Only")

if _fireDivBear
    alert("PTM BEAR DIV [" + _divType + "]" + _aCtx, alert.freq_once_per_bar)
if _fireConfBear
    alert("PTM BEAR CONF" + _aCtx, alert.freq_once_per_bar)
if _fireDivBull
    alert("PTM BULL DIV [" + _divType + "]" + _aCtx, alert.freq_once_per_bar)
if _fireConfBull
    alert("PTM BULL CONF" + _aCtx, alert.freq_once_per_bar)

// ╔══════════════════════════════════════════════════════════════╗
// ║  SCALE ANCHORS                                               ║
// ╚══════════════════════════════════════════════════════════════╝
plot( 120.0, color=color.new(color.white,99), display=display.price_scale)
plot(-120.0, color=color.new(color.white,99), display=display.price_scale)

// ╔══════════════════════════════════════════════════════════════╗
// ║  CONFLUENCE BAND                                             ║
// ╚══════════════════════════════════════════════════════════════╝
bgcolor(confBullActive and showConfLay ? color.new(confBullC, confAlpha) : na, title="Confluence Bull BG")
bgcolor(confBearActive and showConfLay ? color.new(confBearC, confAlpha) : na, title="Confluence Bear BG")

// ╔══════════════════════════════════════════════════════════════╗
// ║  LAYER 4: DMI — AREA (background glow, inverted)            ║
// ╚══════════════════════════════════════════════════════════════╝
// Area style creates a soft background glow behind Composite columns.
// Transparency 90% keeps it subtle — presence felt, not seen.
float _dmiPlotVal = dmiOn and showDMIlay and not compactMode ? -nz(dmiVal) * 120.0 : na
color _dmiAreaCol = nz(dmiVal) > 0.0
     ? color.from_gradient(math.abs(nz(dmiVal)), 0.0, 1.0, color.new(dmiBuy2,dmiAlpLo), color.new(dmiBuy1,dmiAlpHi))
     : color.from_gradient(math.abs(nz(dmiVal)), 0.0, 1.0, color.new(dmiSel2,dmiAlpLo), color.new(dmiSel1,dmiAlpHi))
plot(_dmiPlotVal, title="DMI",
     style = plot.style_area,
     color = _dmiAreaCol, linewidth=1)

// ╔══════════════════════════════════════════════════════════════╗
// ║  LAYER 3: COMPOSITE — HISTOGRAM or COLUMNS                   ║
// ╚══════════════════════════════════════════════════════════════╝
float _cmpPlotVal = cmpOn and showCMPlay and not compactMode ? cmpVal : na
plot(_cmpPlotVal, title="Composite",
     style = cmpStyle == "Columns" ? plot.style_columns : plot.style_histogram,
     color = cmpCol, linewidth=2)

// ╔══════════════════════════════════════════════════════════════╗
// ║  VZO ZONE FILLS                                              ║
// ╚══════════════════════════════════════════════════════════════╝
float _hiC  = math.min( 120.0, float(vzoOBhi))
float _loC  = math.min( 120.0, float(vzoOBlo))
float _loNC = math.max(-120.0,-float(vzoOBlo))
float _hiNC = math.max(-120.0,-float(vzoOBhi))

h_ob_hi = hline( _hiC,  "OB Upper", color=color.new(color.red,  85), linestyle=hline.style_dotted)
h_ob_lo = hline( _loC,  "OB Lower", color=color.new(color.red,  85), linestyle=hline.style_dotted)
h_os_lo = hline( _loNC, "OS Lower", color=color.new(color.green,85), linestyle=hline.style_dotted)
h_os_hi = hline( _hiNC, "OS Upper", color=color.new(color.green,85), linestyle=hline.style_dotted)
hline(0.0, "Zero", color=vzoZC, linestyle=hline.style_dashed)
fill(h_ob_hi, h_ob_lo, color=vzoOBz, title="OB Zone")
fill(h_os_lo, h_os_hi, color=vzoOSz, title="OS Zone")

p_ob_lo  = plot(f_p( float(vzoOBlo)), color=na, editable=false)
p_ob_edg = plot(vzo_ob_edge,          color=na, editable=false)
p_os_lo  = plot(f_p(-float(vzoOBlo)), color=na, editable=false)
p_os_edg = plot(vzo_os_edge,          color=na, editable=false)
fill(p_ob_lo, p_ob_edg, color=vzoDisp >  vzoOBlo ? vzoOBb : na, title="OB Breakout")
fill(p_os_lo, p_os_edg, color=vzoDisp < -vzoOBlo ? vzoOSb : na, title="OS Breakout")

p_rngUp  = plot(f_p(rngUp), "Range Upper", color=vzoRngU, linewidth=1)
p_rngDn  = plot(f_p(rngDn), "Range Lower", color=vzoRngL, linewidth=1)
p_rngOBe = plot(vzo_ob_edge, color=na, editable=false)
p_rngOSe = plot(vzo_os_edge, color=na, editable=false)
fill(p_rngUp, p_rngOBe, color=vzoOBr, title="OB Range Fill")
fill(p_rngDn, p_rngOSe, color=vzoOSr, title="OS Range Fill")

// ╔══════════════════════════════════════════════════════════════╗
// ║  LAYER 2: Z-SCORE LINE                                       ║
// ╚══════════════════════════════════════════════════════════════╝
plot(zsOn and showZSlay ? zsDisp : na, title="Z-Score", color=zsCol, linewidth=zsLW)

// ╔══════════════════════════════════════════════════════════════╗
// ║  LAYER 1: VZO LINE (foreground)                             ║
// ╚══════════════════════════════════════════════════════════════╝
plot(showVZOlay ? vzoDisp : na, title="VZO", color=vzoLC, linewidth=vzoLW)

// ╔══════════════════════════════════════════════════════════════╗
// ║  DIVERGENCE MARKERS                                          ║
// ╚══════════════════════════════════════════════════════════════╝
// triangledown/up read as directional signals, not errors/stops.
plotshape(divBear, title="Divergence Bear",
     style=shape.triangledown, location=location.top,
     color=color.new(#FF1744,0), size=size.small)
plotshape(divBull, title="Divergence Bull",
     style=shape.triangleup, location=location.bottom,
     color=color.new(#00E676,0), size=size.small)

// ╔══════════════════════════════════════════════════════════════╗
// ║  STATUS TABLE                                                ║
// ╚══════════════════════════════════════════════════════════════╝
var table tbl = table.new(position.top_right, 3, 13,
     bgcolor=color.new(#131722, 40),
     border_width=0)
string _tblSz = tblSize == "Small" ? size.tiny : tblSize == "Large" ? size.normal : size.small

f_tc(float v) =>
    v >  0.12 ? color.new(#00E676,0) :
     v < -0.12 ? color.new(#FF6D00,0) : color.new(#9E9E9E,0)

f_pct(float v) => str.tostring(math.round(v * 100.0, 0))

if barstate.islast and showTbl
    table.cell(tbl, 0, 0, "Component",  text_color=color.gray, text_size=_tblSz)
    table.cell(tbl, 1, 0, "Value",      text_color=color.gray, text_size=_tblSz)
    table.cell(tbl, 2, 0, "State",      text_color=color.gray, text_size=_tblSz)

    float _vN = _vzoN
    table.cell(tbl, 0, 1, "VZO",  text_color=color.gray,  text_size=_tblSz)
    table.cell(tbl, 1, 1, f_pct(_vN), text_color=f_tc(_vN), text_size=_tblSz)
    table.cell(tbl, 2, 1, _vN > 0.58 ? "OB ▲" : _vN < -0.58 ? "OS ▼" : (_vN > 0 ? "▲" : "▼"),
         text_color=f_tc(_vN), text_size=_tblSz)

    float _zN = zsRaw / 4.0
    table.cell(tbl, 0, 2, "Z-Score", text_color=color.gray, text_size=_tblSz)
    table.cell(tbl, 1, 2, str.tostring(math.round(zsRaw, 2)),
         text_color=f_tc(_zN), text_size=_tblSz)
    table.cell(tbl, 2, 2, zsRaw > 2.0 ? "OB ▲" : zsRaw < -2.0 ? "OS ▼" : "—",
         text_color=f_tc(_zN), text_size=_tblSz)

    table.cell(tbl, 0, 3, "CTO",  text_color=color.gray,  text_size=_tblSz)
    table.cell(tbl, 1, 3, f_pct(_cto), text_color=f_tc(_cto), text_size=_tblSz)
    table.cell(tbl, 2, 3, _cto > 0.5 ? "Bull ▲" : _cto < -0.5 ? "Bear ▼" : "—",
         text_color=f_tc(_cto), text_size=_tblSz)

    table.cell(tbl, 0, 4, "ADX",  text_color=color.gray,  text_size=_tblSz)
    table.cell(tbl, 1, 4, f_pct(_adx), text_color=f_tc(_adx), text_size=_tblSz)
    table.cell(tbl, 2, 4, _adx > 0.0 ? "Trend" : "Range",
         text_color=f_tc(_adx), text_size=_tblSz)

    table.cell(tbl, 0, 5, "Aroon", text_color=color.gray, text_size=_tblSz)
    table.cell(tbl, 1, 5, f_pct(_arn), text_color=f_tc(_arn), text_size=_tblSz)
    table.cell(tbl, 2, 5, _arn > 0.1 ? "▲" : _arn < -0.1 ? "▼" : "—",
         text_color=f_tc(_arn), text_size=_tblSz)

    table.cell(tbl, 0, 6, "RSI",  text_color=color.gray,  text_size=_tblSz)
    table.cell(tbl, 1, 6, f_pct(_rsi), text_color=f_tc(_rsi), text_size=_tblSz)
    table.cell(tbl, 2, 6, _rsi > 0.3 ? "OB ▲" : _rsi < -0.3 ? "OS ▼" : "—",
         text_color=f_tc(_rsi), text_size=_tblSz)

    table.cell(tbl, 0, 7, "TPX",  text_color=color.gray,  text_size=_tblSz)
    table.cell(tbl, 1, 7, f_pct(_tpx), text_color=f_tc(_tpx), text_size=_tblSz)
    table.cell(tbl, 2, 7, _tpx > 0.1 ? "Bull ▲" : _tpx < -0.1 ? "Bear ▼" : "—",
         text_color=f_tc(_tpx), text_size=_tblSz)

    table.cell(tbl, 0, 8, "DMI",  text_color=color.gray,  text_size=_tblSz)
    table.cell(tbl, 1, 8, f_pct(_dmiDisp), text_color=f_tc(_dmiDisp), text_size=_tblSz)
    table.cell(tbl, 2, 8, _dmiDisp > 0.2 ? "Bull ▲" : _dmiDisp < -0.2 ? "Bear ▼" : "—",
         text_color=f_tc(_dmiDisp), text_size=_tblSz)

    float _cN = nz(cmpVal) / 100.0
    table.cell(tbl, 0, 9, "Composite", text_color=color.gray, text_size=_tblSz)
    table.cell(tbl, 1, 9, str.tostring(math.round(nz(cmpVal), 1)),
         text_color=f_tc(_cN), text_size=_tblSz)
    table.cell(tbl, 2, 9, nz(cmpVal) > 30 ? "Bull ▲" : nz(cmpVal) < -30 ? "Bear ▼" : "—",
         text_color=f_tc(_cN), text_size=_tblSz)

    color  _cfc = confScore > 0 ? color.new(#00E676,0) : confScore < 0 ? color.new(#FF1744,0) : color.gray
    string _cfs = str.tostring(confScore) + " / 7"
    int    _cfa  = math.abs(confScore)
    string _cfst = _cfa >= confMin ? "★★★ CONF" : _cfa >= confMin - 1 ? "★★ High" : _cfa >= confMin - 2 ? "★ Med" : "Low"
    table.cell(tbl, 0,10, "Confluence", text_color=color.gray, text_size=_tblSz)
    table.cell(tbl, 1,10, _cfs,        text_color=_cfc,       text_size=_tblSz)
    table.cell(tbl, 2,10, _cfst,       text_color=_cfc,       text_size=_tblSz)

    color  _dvc = divBear ? color.new(#FF1744,0) : divBull ? color.new(#00E676,0) : color.gray
    string _dvs = divBear ? (divBearVZO ? "VZO↑CMP↓" : "Z>2.5↓") : divBull ? (divBullVZO ? "VZO↓CMP↑" : "Z<-2.5↑") : "—"
    string _dvt = divBear ? "Bear ✕" : divBull ? "Bull ✕" : "—"
    table.cell(tbl, 0,11, "Divergence", text_color=color.gray, text_size=_tblSz)
    table.cell(tbl, 1,11, _dvs,        text_color=_dvc,       text_size=_tblSz)
    table.cell(tbl, 2,11, _dvt,        text_color=_dvc,       text_size=_tblSz)

    color  _mc = trendConfirmed ? color.new(#00BCD4,0) : flatConfirmed ? color.new(#607D8B,0) : color.new(#FFD600,0)
    string _ms = trendConfirmed ? "▶ TREND" : flatConfirmed ? "— FLAT" : "~ TRANS"
    string _mw = adaptW ? (trendConfirmed ? " [T↑]" : flatConfirmed ? " [F↑]" : "") : ""
    table.cell(tbl, 0,12, "Regime",     text_color=color.gray, text_size=_tblSz)
    table.cell(tbl, 1,12, _ms + _mw,    text_color=_mc,        text_size=_tblSz)
    table.cell(tbl, 2,12, str.tostring(math.round(tDiff * 100, 3)) + "%",
         text_color=color.gray, text_size=_tblSz)
