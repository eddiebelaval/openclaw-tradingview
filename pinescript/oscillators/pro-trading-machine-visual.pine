     tooltip="Adds extra EMA smoothing to all components and composite.\nRecommended for 1h/5m charts to reduce noise.\nComposite EMA: 3→7, Components: +2 extra passes")
bool   adaptW = input.bool(true,  "Adaptive Weights",  group=gMode,
     tooltip="In TREND: CTO, VZO, DMI get boosted weight.\nIn FLAT: RSI, Z-Score get boosted weight.\nBase weights still apply — this modifies multipliers only.")
bool   atrNorm= input.bool(true,  "ATR Normalisation", group=gMode,
     tooltip="Scales VZO and DMI by current ATR relative to its 50-bar average.\nHigh volatility bars carry proportionally more weight.")
int    atrLen = input.int(14, "ATR Length", group=gMode, minval=1,
     tooltip="Used for ATR normalisation scaling factor")

