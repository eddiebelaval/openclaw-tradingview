//@version=6
indicator("Pro Trading Machine Visual+", shorttitle="PTM V+", overlay=false,
     format=format.price, precision=2, max_bars_back=1000, scale=scale.right)

// ╔══════════════════════════════════════════════════════════════╗
// ║  PRO TRADING MACHINE  v9                                     ║
// ║  Pure market reading panel — no signals                      ║
// ║                                                              ║
// ║  Optimisations v9 (safe, verified):                          ║
// ║  · f_sec() removed — dead code, replaced by inline guards   ║
// ║  · VZO: EMA before clamp (matches original Van Helsig)      ║
// ║  · VZO: single f_vzo() call, no f_sec double-shift          ║
// ║  · Z-Score: local compute, security only on custom TF       ║
// ║  · DMI: f_dmi() called once, shared for display+composite   ║
// ║  · MTF: 3 security calls → 1 tuple, guarded by mtfOn        ║
// ║  · rngUp/rngDn: two correct SMAs (asymmetric, not abs)      ║
// ║  · ATR: standard SMA (Pine caches internally — correct)     ║
// ║  · All original parameter defaults preserved                 ║
// ║                                                              ║
// ║  LAYER HIERARCHY (front → back)                             ║
// ║  1. VZO line + OB/OS zones         [FOREGROUND]             ║
// ║  2. Z-Score line (multi-color)                               ║
// ║  3. Composite columns              [MIDDLE]                  ║
// ║  4. DMI area glow (inverted)       [BACKGROUND]             ║
// ╚══════════════════════════════════════════════════════════════╝

// ╔══════════════════════════════════════════════════════════════╗
// ║  TIMEFRAMES                                                  ║
// ╚══════════════════════════════════════════════════════════════╝
string gTF    = "═══ Timeframes ═══"
bool   vzoUTF = input.bool(false, "VZO TF?",       group=gTF, inline="t1")
string vzoTF  = input.timeframe("","",             group=gTF, inline="t1")
bool   zsUTF  = input.bool(false, "Z-Score TF?",   group=gTF, inline="t2")
string zsTF   = input.timeframe("","",             group=gTF, inline="t2")
bool   cmpUTF = input.bool(false, "Composite TF?", group=gTF, inline="t3")
string cmpTF  = input.timeframe("","",             group=gTF, inline="t3")
bool   dmiUTF = input.bool(false, "DMI TF?",       group=gTF, inline="t4")
string dmiTF  = input.timeframe("","",             group=gTF, inline="t4")
bool   repaint= input.bool(false, "Allow repainting?", group=gTF)

// ╔══════════════════════════════════════════════════════════════╗
// ║  MODE                                                        ║
