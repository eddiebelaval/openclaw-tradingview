//@version=6
indicator("SQVIGU Cloud Squeeze", shorttitle=" Cloud SQZ", overlay = false)

// --- ORIGINAL COLORS ---
color BULL_CLR = #089981
color BEAR_CLR = #f23645
color SQZ_CLR  = color.gray

// --- INPUTS ---
int   len       = input.int(20, "Squeeze Period")
float bbMult    = input.float(2.0, "Bollinger Mult")
float kcMult    = input.float(1.5, "Keltner Mult")
float thickness = input.float(4.0, "Cloud Thickness", minval=1.0, maxval=20.0)
int   smoothing = input.int(3, "Cloud Smoothness", minval=1)

// --- SQUEEZE LOGIC ---
// $$Squeeze = (BB_{low} > KC_{low}) \cap (BB_{high} < KC_{high})$$
float basis = ta.sma(close, len)
float dev   = bbMult * ta.stdev(close, len)
float ran   = ta.ema(ta.tr, len) * kcMult
bool  sqzOn = (basis - dev > basis - ran) and (basis + dev < basis + ran)

// --- MOMENTUM & CLOUD LAYERS ---
float baseMom = ta.linreg(close - ( (ta.highest(high, len) + ta.lowest(low, len))/2 + basis ) / 2, len, 0)
float mom     = ta.ema(baseMom, smoothing) // Smoothing the core for a "clean" look

// Calculating 5 layers for a dense gradient effect
float vol     = ta.ema(ta.stdev(mom, 10), smoothing) * thickness
float t2 = mom + vol * 1.0
float t1 = mom + vol * 0.5
float b1 = mom - vol * 0.5
float b2 = mom - vol * 1.0

// --- COLOR ENGINE ---
color mainColor = SQZ_CLR
if not sqzOn
    mainColor := mom > 0 ? BULL_CLR : BEAR_CLR

// --- PLOTTING THE MEGA CLOUD ---
// Invisible boundary lines
pTop2 = plot(t2,  "Outer Top",    display = display.none)
pTop1 = plot(t1,  "Inner Top",    display = display.none)
pMid  = plot(mom, "Core Line",    color = color.new(mainColor, 0), linewidth = 2)
pBot1 = plot(b1,  "Inner Bottom", display = display.none)
pBot2 = plot(b2,  "Outer Bottom", display = display.none)

// Layered Fills for "Thickness"
fill(pTop2, pBot2, color.new(mainColor, 80), title = "Outer Glow")
fill(pTop1, pBot1, color.new(mainColor, 50), title = "Inner Density")
fill(pTop1, pMid,  color.new(mainColor, 20), title = "Top Core")
fill(pMid,  pBot1, color.new(mainColor, 20), title = "Bottom Core")

// Zero Line
plot(0, "Zero Line", color.new(color.white, 80), 1)

// --- FIRE SIGNALS ---
bool longFire  = sqzOn[1] and not sqzOn and mom > 0
bool shortFire = sqzOn[1] and not sqzOn and mom < 0

plotshape(longFire ? 0 : na,  "Long Fire",  shape.triangleup,   location.absolute, BULL_CLR, size=size.small)
plotshape(shortFire ? 0 : na, "Short Fire", shape.triangledown, location.absolute, BEAR_CLR, size=size.small)
