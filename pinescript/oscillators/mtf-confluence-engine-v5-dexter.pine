// ============================================================
// MTF CONFLUENCE ENGINE v5.0
// by Dexter | Labelled, readable, no dead space
// Compatible: TradingView Pine Script v5
// ============================================================

//@version=5
indicator("MTF Confluence Engine v5 [Dexter]", shorttitle="MTF·CE", overlay=false, max_lines_count=200, max_labels_count=200)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
grp_tf      = "── Timeframes ──"
tf_m15      = input.timeframe("15", "TF 1 — Fast",  group=grp_tf)
tf_h1       = input.timeframe("60", "TF 2 — Mid",   group=grp_tf)
tf_d1       = input.timeframe("D",  "TF 3 — Slow",  group=grp_tf)
tf_w1       = input.timeframe("W",  "TF 4 — Major", group=grp_tf)

grp_w       = "── Weights ──"
w_m15       = input.float(1.0, "M15 Weight", minval=0.1, maxval=5.0, step=0.1, group=grp_w)
w_h1        = input.float(2.0, "H1  Weight", minval=0.1, maxval=5.0, step=0.1, group=grp_w)
w_d1        = input.float(3.5, "D1  Weight", minval=0.1, maxval=5.0, step=0.1, group=grp_w)
w_w1        = input.float(5.0, "W1  Weight", minval=0.1, maxval=5.0, step=0.1, group=grp_w)

grp_sig     = "── Signal Engine ──"
fast_len    = input.int(9,    "Fast EMA",    minval=2,  group=grp_sig)
slow_len    = input.int(21,   "Slow EMA",    minval=3,  group=grp_sig)
rsi_len     = input.int(14,   "RSI Length",  minval=2,  group=grp_sig)
rsi_mid     = input.float(50, "RSI Midline", minval=30, maxval=70, group=grp_sig)

grp_vis     = "── Visual ──"
conf_thresh = input.float(70.0, "Signal Threshold %",    minval=50, maxval=100, step=5, group=grp_vis)
show_sigs   = input.bool(true,  "Show LONG/SHORT Labels", group=grp_vis)
tbl_pos     = input.string("Top Right", "Panel Position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=grp_vis)

// ─────────────────────────────────────────────
// COLOURS
// ─────────────────────────────────────────────
c_bull   = #00c98a
c_bear   = #ff4444
c_neut   = #555566
c_w1     = #ff5533
c_d1     = #ff9900
c_h1     = #f5d000
c_m15    = #00e5a0
c_white  = #ffffff

// ─────────────────────────────────────────────
// SIGNAL FUNCTION
// ─────────────────────────────────────────────
get_signal(src) =>
    ema_f = ta.ema(src, fast_len)
    ema_s = ta.ema(src, slow_len)
    rsi_v = ta.rsi(src, rsi_len)
    sig   = ema_f > ema_s and rsi_v > rsi_mid ? 1 : ema_f < ema_s and rsi_v < rsi_mid ? -1 : 0
    [sig, rsi_v]

// ─────────────────────────────────────────────
// MTF DATA
// ─────────────────────────────────────────────
[sig_m15, rsi_m15] = request.security(syminfo.tickerid, tf_m15, get_signal(close))
[sig_h1,  rsi_h1]  = request.security(syminfo.tickerid, tf_h1,  get_signal(close))
[sig_d1,  rsi_d1]  = request.security(syminfo.tickerid, tf_d1,  get_signal(close))
[sig_w1,  rsi_w1]  = request.security(syminfo.tickerid, tf_w1,  get_signal(close))

// ─────────────────────────────────────────────
// CONFLUENCE SCORE
// ─────────────────────────────────────────────
total_w    = w_m15 + w_h1 + w_d1 + w_w1
bull_score = ((sig_m15==1?w_m15:0)+(sig_h1==1?w_h1:0)+(sig_d1==1?w_d1:0)+(sig_w1==1?w_w1:0)) / total_w * 100
bear_score = ((sig_m15==-1?w_m15:0)+(sig_h1==-1?w_h1:0)+(sig_d1==-1?w_d1:0)+(sig_w1==-1?w_w1:0)) / total_w * 100
net_conf   = bull_score - bear_score
abs_conf   = math.abs(net_conf)
is_bull    = net_conf > 0
is_bear    = net_conf < 0
is_strong  = abs_conf >= conf_thresh
conf_ema   = ta.ema(net_conf, 3)

// ─────────────────────────────────────────────
// PANE LAYOUT  (total range: 0 to 100)
//
//  95-100  : LONG/SHORT signal labels
//  88-94   : W1  dot lane
//  81-87   : D1  dot lane
//  74-80   : H1  dot lane
//  67-73   : M15 dot lane
//  62-66   : divider gap
//   0-61   : histogram  (net_conf mapped -100→0, +100→61)
// ─────────────────────────────────────────────

// Map net_conf [-100,+100] → [0,61] for histogram
hist_val   = (net_conf + 100) / 200 * 61
hist_mid   = 30.5  // zero line on histogram
hist_ema   = (conf_ema + 100) / 200 * 61
thresh_hi  = (conf_thresh  + 100) / 200 * 61
thresh_lo  = (-conf_thresh + 100) / 200 * 61

// ─────────────────────────────────────────────
// ZONE BACKGROUND
// ─────────────────────────────────────────────
bgcolor(is_strong and is_bull ? color.new(c_bull, 93) : na, title="Bull Zone")
bgcolor(is_strong and is_bear ? color.new(c_bear, 93) : na, title="Bear Zone")

// ─────────────────────────────────────────────
// LANE SEPARATOR LINES
// ─────────────────────────────────────────────
hline(66,        "Dot/Hist Divider", color=color.new(c_white, 60), linestyle=hline.style_solid,  linewidth=1)
hline(hist_mid,  "Zero Line",        color=color.new(c_white, 50), linestyle=hline.style_solid,  linewidth=1)
hline(thresh_hi, "Bull Threshold",   color=color.new(c_bull,  35), linestyle=hline.style_dashed, linewidth=1)
hline(thresh_lo, "Bear Threshold",   color=color.new(c_bear,  35), linestyle=hline.style_dashed, linewidth=1)

// Lane dividers (subtle)
hline(94,  "W1/D1 div",   color=color.new(c_white, 88), linestyle=hline.style_dotted, linewidth=1)
hline(87,  "D1/H1 div",   color=color.new(c_white, 88), linestyle=hline.style_dotted, linewidth=1)
hline(80,  "H1/M15 div",  color=color.new(c_white, 88), linestyle=hline.style_dotted, linewidth=1)
hline(73,  "M15/gap div", color=color.new(c_white, 88), linestyle=hline.style_dotted, linewidth=1)

// ─────────────────────────────────────────────
// HISTOGRAM  — sits in 0–61 zone
// ─────────────────────────────────────────────
bar_bull_strong = color.new(c_bull, 8)
bar_bull_weak   = color.new(c_bull, 58)
bar_bear_strong = color.new(c_bear, 8)
bar_bear_weak   = color.new(c_bear, 58)

bar_col = is_bull ? (is_strong ? bar_bull_strong : bar_bull_weak) : (is_strong ? bar_bear_strong : bar_bear_weak)

// Plot histogram as distance from midline
plot(hist_val,  "Hist Top",  color=bar_col,                    style=plot.style_columns, linewidth=1)
plot(hist_mid,  "Hist Base", color=color.new(c_white, 100),    display=display.none)
plot(hist_ema,  "EMA Line",  color=color.new(c_white, 20),     linewidth=2)

// ─────────────────────────────────────────────
// DOT LANES — one per TF, clearly separated
// Lane centres: W1=91, D1=84, H1=77, M15=70
// ─────────────────────────────────────────────
w1_y   = 91.0
d1_y   = 84.0
h1_y   = 77.0
m15_y  = 70.0

// W1 dots
plotshape(sig_w1 == 1  ? w1_y : na,  "W1 ▲", shape.circle, location.absolute, color.new(c_w1,   0),  size=size.small)
plotshape(sig_w1 == -1 ? w1_y : na,  "W1 ▼", shape.circle, location.absolute, color.new(c_bear, 25), size=size.small)
plotshape(sig_w1 == 0  ? w1_y : na,  "W1 ◈", shape.circle, location.absolute, color.new(c_neut, 30), size=size.tiny)

// D1 dots
plotshape(sig_d1 == 1  ? d1_y : na,  "D1 ▲", shape.circle, location.absolute, color.new(c_d1,   0),  size=size.small)
plotshape(sig_d1 == -1 ? d1_y : na,  "D1 ▼", shape.circle, location.absolute, color.new(c_bear, 40), size=size.small)
plotshape(sig_d1 == 0  ? d1_y : na,  "D1 ◈", shape.circle, location.absolute, color.new(c_neut, 30), size=size.tiny)

// H1 dots
plotshape(sig_h1 == 1  ? h1_y : na,  "H1 ▲", shape.circle, location.absolute, color.new(c_h1,   0),  size=size.small)
plotshape(sig_h1 == -1 ? h1_y : na,  "H1 ▼", shape.circle, location.absolute, color.new(c_bear, 55), size=size.small)
plotshape(sig_h1 == 0  ? h1_y : na,  "H1 ◈", shape.circle, location.absolute, color.new(c_neut, 30), size=size.tiny)

// M15 dots
plotshape(sig_m15 == 1  ? m15_y : na, "M15 ▲", shape.circle, location.absolute, color.new(c_m15,  0),  size=size.small)
plotshape(sig_m15 == -1 ? m15_y : na, "M15 ▼", shape.circle, location.absolute, color.new(c_bear, 65), size=size.small)
plotshape(sig_m15 == 0  ? m15_y : na, "M15 ◈", shape.circle, location.absolute, color.new(c_neut, 30), size=size.tiny)

// ─────────────────────────────────────────────
// ROW LABELS — left-side labels via label.new
// Printed only on last bar to avoid clutter
// ─────────────────────────────────────────────
var label lbl_w1  = na
var label lbl_d1  = na
var label lbl_h1  = na
var label lbl_m15 = na
var label lbl_0   = na
var label lbl_pos = na
var label lbl_neg = na

if barstate.islast
    label.delete(lbl_w1)
    label.delete(lbl_d1)
    label.delete(lbl_h1)
    label.delete(lbl_m15)
    label.delete(lbl_0)
    label.delete(lbl_pos)
    label.delete(lbl_neg)

    lbl_w1  := label.new(bar_index - 3, w1_y,  " W1 ",  style=label.style_label_right, color=color.new(c_w1,  20), textcolor=#ffffff, size=size.small)
    lbl_d1  := label.new(bar_index - 3, d1_y,  " D1 ",  style=label.style_label_right, color=color.new(c_d1,  20), textcolor=#ffffff, size=size.small)
    lbl_h1  := label.new(bar_index - 3, h1_y,  " H1 ",  style=label.style_label_right, color=color.new(c_h1,  20), textcolor=#000000, size=size.small)
    lbl_m15 := label.new(bar_index - 3, m15_y, " M15 ", style=label.style_label_right, color=color.new(c_m15, 20), textcolor=#000000, size=size.small)
    lbl_0   := label.new(bar_index - 3, hist_mid, " 0 ", style=label.style_label_right, color=color.new(c_white, 70), textcolor=#ffffff, size=size.tiny)
    lbl_pos := label.new(bar_index - 3, thresh_hi, "+" + str.tostring(math.round(conf_thresh)) + "%", style=label.style_label_right, color=color.new(c_bull, 55), textcolor=#ffffff, size=size.tiny)
    lbl_neg := label.new(bar_index - 3, thresh_lo, "-" + str.tostring(math.round(conf_thresh)) + "%", style=label.style_label_right, color=color.new(c_bear, 55), textcolor=#ffffff, size=size.tiny)

// ─────────────────────────────────────────────
// SIGNAL LABELS
// ─────────────────────────────────────────────
long_sig  = show_sigs and ta.crossover(net_conf,   conf_thresh)
short_sig = show_sigs and ta.crossunder(net_conf,  -conf_thresh)

plotshape(long_sig  ? 98.0 : na, "LONG",  shape.labelup,   location.absolute, c_bull, text="▲ LONG",  textcolor=#000000, size=size.small)
plotshape(short_sig ? 98.0 : na, "SHORT", shape.labeldown, location.absolute, c_bear, text="▼ SHORT", textcolor=#ffffff, size=size.small)

// ─────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────
alertcondition(long_sig,              "MTF Long",  "MTF CE — LONG: {{ticker}}")
alertcondition(short_sig,             "MTF Short", "MTF CE — SHORT: {{ticker}}")
alertcondition(long_sig or short_sig, "MTF Any",   "MTF CE — Signal: {{ticker}}")

// ─────────────────────────────────────────────
// DASHBOARD PANEL
// ─────────────────────────────────────────────
tbl_position = tbl_pos == "Top Right"    ? position.top_right    :
               tbl_pos == "Top Left"     ? position.top_left     :
               tbl_pos == "Bottom Right" ? position.bottom_right :
               position.bottom_left

if barstate.islast
    var table panel = table.new(tbl_position, 4, 9,
         bgcolor      = color.new(#08080f, 8),
         border_color = color.new(#ffffff, 78),
         border_width = 1,
         frame_color  = color.new(#ffffff, 60),
         frame_width  = 1)

    hdr_bg  = color.new(#04040a, 0)
    bull_bg = color.new(#001f12, 0)
    bear_bg = color.new(#1f0500, 0)
    neut_bg = color.new(#0e0e18, 0)
    sep_bg  = color.new(#04040a, 0)

    // Header
    table.cell(panel, 0, 0, "TF",   text_color=color.new(#ffffff, 45), text_size=size.small,  bgcolor=hdr_bg, text_halign=text.align_center)
    table.cell(panel, 1, 0, "BIAS", text_color=color.new(#ffffff, 45), text_size=size.small,  bgcolor=hdr_bg, text_halign=text.align_center)
    table.cell(panel, 2, 0, "RSI",  text_color=color.new(#ffffff, 45), text_size=size.small,  bgcolor=hdr_bg, text_halign=text.align_center)
    table.cell(panel, 3, 0, "WGT",  text_color=color.new(#ffffff, 45), text_size=size.small,  bgcolor=hdr_bg, text_halign=text.align_center)

    // W1
    w1_b = sig_w1  == 1 ? "▲ BULL" : sig_w1  == -1 ? "▼ BEAR" : "◈ NEUT"
    w1_c = sig_w1  == 1 ? c_bull   : sig_w1  == -1 ? c_bear   : c_neut
    w1_g = sig_w1  == 1 ? bull_bg  : sig_w1  == -1 ? bear_bg  : neut_bg
    table.cell(panel, 0, 1, "W1",  text_color=c_w1,  text_size=size.normal, bgcolor=w1_g, text_halign=text.align_center)
    table.cell(panel, 1, 1, w1_b,  text_color=w1_c,  text_size=size.normal, bgcolor=w1_g, text_halign=text.align_center)
    table.cell(panel, 2, 1, str.tostring(math.round(rsi_w1,  1)), text_color=color.new(#ffffff, 15), text_size=size.normal, bgcolor=w1_g, text_halign=text.align_center)
    table.cell(panel, 3, 1, str.tostring(w_w1),  text_color=color.new(c_w1,  40), text_size=size.small, bgcolor=w1_g, text_halign=text.align_center)

    // D1
    d1_b = sig_d1  == 1 ? "▲ BULL" : sig_d1  == -1 ? "▼ BEAR" : "◈ NEUT"
    d1_c = sig_d1  == 1 ? c_bull   : sig_d1  == -1 ? c_bear   : c_neut
    d1_g = sig_d1  == 1 ? bull_bg  : sig_d1  == -1 ? bear_bg  : neut_bg
    table.cell(panel, 0, 2, "D1",  text_color=c_d1,  text_size=size.normal, bgcolor=d1_g, text_halign=text.align_center)
    table.cell(panel, 1, 2, d1_b,  text_color=d1_c,  text_size=size.normal, bgcolor=d1_g, text_halign=text.align_center)
    table.cell(panel, 2, 2, str.tostring(math.round(rsi_d1,  1)), text_color=color.new(#ffffff, 15), text_size=size.normal, bgcolor=d1_g, text_halign=text.align_center)
    table.cell(panel, 3, 2, str.tostring(w_d1),  text_color=color.new(c_d1,  40), text_size=size.small, bgcolor=d1_g, text_halign=text.align_center)

    // H1
    h1_b = sig_h1  == 1 ? "▲ BULL" : sig_h1  == -1 ? "▼ BEAR" : "◈ NEUT"
    h1_c = sig_h1  == 1 ? c_bull   : sig_h1  == -1 ? c_bear   : c_neut
    h1_g = sig_h1  == 1 ? bull_bg  : sig_h1  == -1 ? bear_bg  : neut_bg
    table.cell(panel, 0, 3, "H1",  text_color=c_h1,  text_size=size.normal, bgcolor=h1_g, text_halign=text.align_center)
    table.cell(panel, 1, 3, h1_b,  text_color=h1_c,  text_size=size.normal, bgcolor=h1_g, text_halign=text.align_center)
    table.cell(panel, 2, 3, str.tostring(math.round(rsi_h1,  1)), text_color=color.new(#ffffff, 15), text_size=size.normal, bgcolor=h1_g, text_halign=text.align_center)
    table.cell(panel, 3, 3, str.tostring(w_h1),  text_color=color.new(c_h1,  40), text_size=size.small, bgcolor=h1_g, text_halign=text.align_center)

    // M15
    m15_b = sig_m15 == 1 ? "▲ BULL" : sig_m15 == -1 ? "▼ BEAR" : "◈ NEUT"
    m15_c = sig_m15 == 1 ? c_bull   : sig_m15 == -1 ? c_bear   : c_neut
    m15_g = sig_m15 == 1 ? bull_bg  : sig_m15 == -1 ? bear_bg  : neut_bg
    table.cell(panel, 0, 4, "M15", text_color=c_m15, text_size=size.normal, bgcolor=m15_g, text_halign=text.align_center)
    table.cell(panel, 1, 4, m15_b, text_color=m15_c, text_size=size.normal, bgcolor=m15_g, text_halign=text.align_center)
    table.cell(panel, 2, 4, str.tostring(math.round(rsi_m15, 1)), text_color=color.new(#ffffff, 15), text_size=size.normal, bgcolor=m15_g, text_halign=text.align_center)
    table.cell(panel, 3, 4, str.tostring(w_m15), text_color=color.new(c_m15, 40), text_size=size.small, bgcolor=m15_g, text_halign=text.align_center)

    // Separator
    table.cell(panel, 0, 5, "", bgcolor=sep_bg, text_size=size.tiny)
    table.cell(panel, 1, 5, "", bgcolor=sep_bg, text_size=size.tiny)
    table.cell(panel, 2, 5, "", bgcolor=sep_bg, text_size=size.tiny)
    table.cell(panel, 3, 5, "", bgcolor=sep_bg, text_size=size.tiny)

    // Bull / Bear scores
    table.cell(panel, 0, 6, "BULL", text_color=color.new(c_bull, 20), text_size=size.small,  bgcolor=sep_bg, text_halign=text.align_center)
    table.cell(panel, 1, 6, str.tostring(math.round(bull_score, 1)) + "%", text_color=c_bull, text_size=size.normal, bgcolor=sep_bg, text_halign=text.align_center)
    table.cell(panel, 2, 6, "BEAR", text_color=color.new(c_bear, 20), text_size=size.small,  bgcolor=sep_bg, text_halign=text.align_center)
    table.cell(panel, 3, 6, str.tostring(math.round(bear_score, 1)) + "%", text_color=c_bear, text_size=size.normal, bgcolor=sep_bg, text_halign=text.align_center)

    // Confluence score row
    dir_txt = is_bull ? "▲ LONG" : is_bear ? "▼ SHORT" : "◈ FLAT"
    dir_col = is_bull ? c_bull   : is_bear  ? c_bear    : c_neut
    scr_bg  = is_strong ? (is_bull ? color.new(#004d33, 0) : color.new(#4d1000, 0)) : color.new(#0d0d1a, 0)
    table.cell(panel, 0, 7, "SCORE", text_color=color.new(#ffffff, 40), text_size=size.small,  bgcolor=scr_bg, text_halign=text.align_center)
    table.cell(panel, 1, 7, str.tostring(math.round(abs_conf, 1)) + "%", text_color=color.new(#ffffff, 5), text_size=size.large, bgcolor=scr_bg, text_halign=text.align_center)
    table.cell(panel, 2, 7, "BIAS",  text_color=color.new(#ffffff, 40), text_size=size.small,  bgcolor=scr_bg, text_halign=text.align_center)
    table.cell(panel, 3, 7, dir_txt, text_color=dir_col,                text_size=size.normal, bgcolor=scr_bg, text_halign=text.align_center)

    // Status bar
    status_txt = is_strong ? (is_bull ? "⚡ STRONG BULL SETUP" : "⚡ STRONG BEAR SETUP") : abs_conf > 40 ? "~ BUILDING CONFLUENCE..." : "  WAIT — NO CLEAR SETUP"
    status_col = is_strong ? (is_bull ? c_bull : c_bear) : abs_conf > 40 ? c_d1 : color.new(#ffffff, 55)
    table.merge_cells(panel, 0, 8, 3, 8)
    table.cell(panel, 0, 8, status_txt, text_color=status_col, text_size=size.small, bgcolor=color.new(#04040a, 0), text_halign=text.align_center)
