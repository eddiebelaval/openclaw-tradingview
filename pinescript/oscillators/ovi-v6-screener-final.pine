//@version=6
indicator("OVI_V6_SCREENER_FINAL", overlay=false, precision=2)

// --- 1. LÓGICA DE CÁLCULO ---
ovi_base = ta.sma(close > close[1] ? volume : -volume, 10)
ovi_norm = math.abs(ta.stdev(ovi_base, 10))
val_ovi = 50 + (ovi_base / (ovi_norm == 0 ? 1 : ovi_norm))

val_rsi = ta.rsi(close, 7)

vol_rel = volume / ta.sma(volume, 20)

// Condición para el Screener (OVI > 50, OVI subiendo y RSI < 65)
es_apto = val_ovi > 50 and val_ovi > val_ovi[1] and val_rsi < 65

// --- 2. VISTA DE BARRAS (HISTOGRAMA) ---
plot(val_ovi, title="OVI_BARRAS", color = val_ovi > 50 ? color.green : color.red, style=plot.style_columns, histbase=50)
hline(50, "Nivel 50", color=color.gray, linestyle=hline.style_dashed)

// --- 3. SALIDA TÉCNICA PARA EL SCREENER ---
// Esta es la columna que buscaremos con el "+" en el Screener
plot(es_apto ? 1 : 0, title="OVI_OK", display=display.none)

// --- 4. CUADRO NEGRO UNIFICADO ---
var table tab = table.new(position.top_right, 2, 4, bgcolor=color.black, border_width=1)
if barstate.islast
    // Fila OVI
    table.cell(tab, 0, 0, "OVI", text_color=color.white)
    table.cell(tab, 1, 0, str.tostring(val_ovi, "#.##"), text_color=val_ovi > 50 ? color.green : color.red)
    // Fila RSI
    table.cell(tab, 0, 1, "RSI", text_color=color.white)
    table.cell(tab, 1, 1, str.tostring(val_rsi, "#.##"), text_color=color.white)
    // Fila VOL RELATIVO
    table.cell(tab, 0, 2, "VOL R", text_color=color.white)
    table.cell(tab, 1, 2, str.tostring(vol_rel, "#.##"), text_color=color.yellow)
    // Fila APTO (SI/NO)
    table.cell(tab, 0, 3, "APTO", text_color=color.white)
    table.cell(tab, 1, 3, es_apto ? "SI" : "NO", text_color=es_apto ? color.green : color.red)
