// © TheCleverTraders
// RSI Elite Toolkit [Clever] — Multi-Feature Momentum & Divergence Toolkit
// Designed for analytical and educational purposes only.

//@version=6
indicator("RSI Elite Toolkit [Clever]", shorttitle="RSI ELITE", overlay=false, format=format.price, precision=2)

// ==========================================
// --- Inputs ---
// ==========================================
grp_rsi = "RSI Core Settings"
rsiLen = input.int(14, "RSI Length", minval=1, group=grp_rsi)
rsiSrc = input.source(close, "Source", group=grp_rsi)
useMTF = input.bool(false, "Enable Multi-Timeframe", group=grp_rsi)
tf = input.timeframe("", "Timeframe", group=grp_rsi)

grp_ma = "RSI Moving Average"
showMA = input.bool(true, "Show RSI MA", group=grp_ma)
maType = input.string("SMA", "MA Type", options=["SMA", "EMA", "WMA", "RMA"], group=grp_ma)
maLen = input.int(14, "MA Length", minval=1, group=grp_ma)

grp_levels = "Overbought / Oversold Levels"
obLevel = input.int(70, "Overbought Level", group=grp_levels)
osLevel = input.int(30, "Oversold Level", group=grp_levels)
midLevel = input.int(50, "Mid Level", group=grp_levels)

grp_div = "Divergence Settings"
showDiv = input.bool(true, "Detect Divergences", group=grp_div)
divLookbackRight = input.int(5, "Pivot Lookback Right", group=grp_div)
divLookbackLeft = input.int(5, "Pivot Lookback Left", group=grp_div)
maxLookback = input.int(60, "Max Lookback Range", group=grp_div)
minLookback = input.int(5, "Min Lookback Range", group=grp_div)

grp_visuals = "Visual Aesthetics"
obColor = input.color(color.new(color.red, 0), "Overbought Color", group=grp_visuals)
osColor = input.color(color.new(color.green, 0), "Oversold Color", group=grp_visuals)
midColor = input.color(color.new(color.blue, 0), "Neutral Color", group=grp_visuals)
fillBg = input.bool(true, "Fill Background Extreme Zones", group=grp_visuals)

grp_signals = "Buy / Sell Signals"
showSignals = input.bool(true, "Show Buy/Sell Signals", group=grp_signals)
overlaySignals = input.bool(true, "Overlay Signals on Main Chart", group=grp_signals)
signalType = input.string("RSI Crosses Extremes", "Signal Strategy", options=["RSI Crosses Extremes", "RSI Crosses MA", "Divergences"], group=grp_signals)
buySignalColor = input.color(color.new(color.green, 20), "Buy Signal Color", group=grp_signals)
sellSignalColor = input.color(color.new(color.red, 20), "Sell Signal Color", group=grp_signals)

grp_risk = "Risk Management (SL/TP Zones)"
showTradeVisuals = input.bool(true, "Show SL/TP Zones on Main Chart", group=grp_risk)
atrLen = input.int(14, "ATR Length", group=grp_risk)
slMult = input.float(1.5, "Stop Loss Multiplier", step=0.1, group=grp_risk)
tpMult = input.float(3.0, "Take Profit Multiplier", step=0.1, group=grp_risk)
bullZoneColor = input.color(color.new(color.green, 90), "Bullish TP Zone", group=grp_risk)
bearZoneColor = input.color(color.new(color.red, 90), "Bearish TP Zone", group=grp_risk)
slZoneColor = input.color(color.new(color.gray, 92), "Stop Loss Zone", group=grp_risk)

grp_extras = "Extras (EMA & Dashboard)"
showEma = input.bool(true, "Show 200 EMA on Main Chart", group=grp_extras)
emaLen = input.int(200, "EMA Length", group=grp_extras)
showDash = input.bool(true, "Show Trade Dashboard", group=grp_extras)
dashPos = input.string("Top Right", "Dashboard Position", options=["Top Right", "Bottom Right", "Bottom Left", "Top Left"], group=grp_extras)

// ==========================================
// --- Calculations ---
// ==========================================
// Custom RSI Calculation Function
f_rsi(src, len) =>
    up = ta.rma(math.max(ta.change(src), 0), len)
    down = ta.rma(-math.min(ta.change(src), 0), len)
    down == 0 ? 100 : up == 0 ? 0 : 100 - (100 / (1 + up / down))

rsi_normal = f_rsi(rsiSrc, rsiLen)
rsi = useMTF ? request.security(syminfo.tickerid, tf, rsi_normal, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off) : rsi_normal

// MA Calculation
float rsiMA = na
if showMA
    if maType == "SMA"
        rsiMA := ta.sma(rsi, maLen)
    else if maType == "EMA"
        rsiMA := ta.ema(rsi, maLen)
    else if maType == "WMA"
        rsiMA := ta.wma(rsi, maLen)
    else if maType == "RMA"
        rsiMA := ta.rma(rsi, maLen)

// Divergences Calculation
plFound = not na(ta.pivotlow(rsi, divLookbackLeft, divLookbackRight))
phFound = not na(ta.pivothigh(rsi, divLookbackLeft, divLookbackRight))

float rsiPivotLow  = ta.valuewhen(plFound, rsi[divLookbackRight], 0)
float pricePivotLow= ta.valuewhen(plFound, low[divLookbackRight], 0)
float rsiPivotHigh = ta.valuewhen(phFound, rsi[divLookbackRight], 0)
float pricePivotHigh=ta.valuewhen(phFound, high[divLookbackRight], 0)

float rsiPrevPivotLow  = ta.valuewhen(plFound, rsi[divLookbackRight], 1)
float pricePrevPivotLow= ta.valuewhen(plFound, low[divLookbackRight], 1)
float rsiPrevPivotHigh = ta.valuewhen(phFound, rsi[divLookbackRight], 1)
float pricePrevPivotHigh=ta.valuewhen(phFound, high[divLookbackRight], 1)

int barsSincePL = ta.barssince(plFound)
int barsSincePH = ta.barssince(phFound)

// Determine valid lookback range (distance in bars between the two pivots)
int distPL = nz(barsSincePL[1]) + 1
int distPH = nz(barsSincePH[1]) + 1

bool isValidLookbackLow = distPL >= minLookback and distPL <= maxLookback
bool isValidLookbackHigh = distPH >= minLookback and distPH <= maxLookback

// Divergence Logic
bool bullishRegDiv = plFound and (pricePivotLow < pricePrevPivotLow) and (rsiPivotLow > rsiPrevPivotLow) and isValidLookbackLow
bool bullishHiddenDiv = plFound and (pricePivotLow > pricePrevPivotLow) and (rsiPivotLow < rsiPrevPivotLow) and isValidLookbackLow

bool bearishRegDiv = phFound and (pricePivotHigh > pricePrevPivotHigh) and (rsiPivotHigh < rsiPrevPivotHigh) and isValidLookbackHigh
bool bearishHiddenDiv = phFound and (pricePivotHigh < pricePrevPivotHigh) and (rsiPivotHigh > rsiPrevPivotHigh) and isValidLookbackHigh

// ==========================================
// --- Visuals ---
// ==========================================
// Dynamic Color based on RSI Value
color rsiLineColor = rsi >= obLevel ? obColor : rsi <= osLevel ? osColor : midColor

// Reference Lines
obLine = hline(obLevel, "Overbought", color=color.new(obColor, 50), linestyle=hline.style_dashed)
midLine = hline(midLevel, "Midline", color=color.new(color.gray, 50), linestyle=hline.style_dotted)
osLine = hline(osLevel, "Oversold", color=color.new(osColor, 50), linestyle=hline.style_dashed)

// Zone Fills
topLine = hline(100, display=display.none)
botLine = hline(0, display=display.none)

fill(obLine, topLine, color=fillBg ? color.new(obColor, 90) : na, title="Overbought Background")
fill(obLine, osLine, color=fillBg ? color.new(color.purple, 97) : na, title="Neutral Background")
fill(botLine, osLine, color=fillBg ? color.new(osColor, 90) : na, title="Oversold Background")

// Primary RSI Plots
plot(rsi, title="RSI Core", color=rsiLineColor, linewidth=2)
plot(showMA ? rsiMA : na, title="RSI MA", color=color.new(color.orange, 0), linewidth=1)

// Divergence Signal Shapes (plotted on RSI line)
plotshape(showDiv and bullishRegDiv ? rsi[divLookbackRight] : na, title="Bullish Reg Div", offset=-divLookbackRight, location=location.absolute, style=shape.circle, size=size.tiny, color=osColor)
plotshape(showDiv and bearishRegDiv ? rsi[divLookbackRight] : na, title="Bearish Reg Div", offset=-divLookbackRight, location=location.absolute, style=shape.circle, size=size.tiny, color=obColor)

plotshape(showDiv and bullishHiddenDiv ? rsi[divLookbackRight] : na, title="Bullish Hidden Div", offset=-divLookbackRight, location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(osColor, 30))
plotshape(showDiv and bearishHiddenDiv ? rsi[divLookbackRight] : na, title="Bearish Hidden Div", offset=-divLookbackRight, location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(obColor, 30))

// Divergence Signal Shapes (plotted on Main Chart)
plotshape(showDiv and bullishRegDiv, title="Reg Bull Main", style=shape.circle, location=location.belowbar, color=color.rgb(55, 198, 59), size=size.tiny, text="REG BULL", textcolor=color.rgb(49, 203, 54), offset=-divLookbackRight, force_overlay=true)
plotshape(showDiv and bearishRegDiv, title="Reg Bear Main", style=shape.circle, location=location.abovebar, color=color.rgb(200, 33, 33), size=size.tiny, text="REG BEAR", textcolor=color.rgb(221, 35, 35), offset=-divLookbackRight, force_overlay=true)

plotshape(showDiv and bullishHiddenDiv, title="Hid Bull Main", style=shape.circle, location=location.belowbar, color=color.new(#23ce29, 50), size=size.tiny, text="HID BULL", textcolor=color.new(#1ad820, 50), offset=-divLookbackRight, force_overlay=true)
plotshape(showDiv and bearishHiddenDiv, title="Hid Bear Main", style=shape.circle, location=location.abovebar, color=color.new(#d81c1c, 50), size=size.tiny, text="HID BEAR", textcolor=color.new(#dd1717, 50), offset=-divLookbackRight, force_overlay=true)

// Label text and lines for divergences
if showDiv and bullishRegDiv
    label.new(bar_index - divLookbackRight, rsi[divLookbackRight], "REG BULL", color=color.new(color.black, 100), textcolor=osColor, style=label.style_label_up, size=size.tiny)
    line.new(bar_index - divLookbackRight - distPL, rsiPrevPivotLow, bar_index - divLookbackRight, rsiPivotLow, color=osColor, width=1, style=line.style_dotted)

if showDiv and bearishRegDiv
    label.new(bar_index - divLookbackRight, rsi[divLookbackRight], "REG BEAR", color=color.new(color.black, 100), textcolor=obColor, style=label.style_label_down, size=size.tiny)
    line.new(bar_index - divLookbackRight - distPH, rsiPrevPivotHigh, bar_index - divLookbackRight, rsiPivotHigh, color=obColor, width=1, style=line.style_dotted)

if showDiv and bullishHiddenDiv
    label.new(bar_index - divLookbackRight, rsi[divLookbackRight], "HID BULL", color=color.new(color.black, 100), textcolor=color.new(osColor, 30), style=label.style_label_up, size=size.tiny)
    line.new(bar_index - divLookbackRight - distPL, rsiPrevPivotLow, bar_index - divLookbackRight, rsiPivotLow, color=color.new(osColor, 30), width=1, style=line.style_dashed)

if showDiv and bearishHiddenDiv
    label.new(bar_index - divLookbackRight, rsi[divLookbackRight], "HID BEAR", color=color.new(color.black, 100), textcolor=color.new(obColor, 30), style=label.style_label_down, size=size.tiny)
    line.new(bar_index - divLookbackRight - distPH, rsiPrevPivotHigh, bar_index - divLookbackRight, rsiPivotHigh, color=color.new(obColor, 30), width=1, style=line.style_dashed)


// ==========================================
// --- Extras (EMA Chart Plot) ---
// ==========================================
mainEma = ta.ema(close, emaLen)
plot(showEma ? mainEma : na, title="Main EMA Overlay", color=color.new(color.white, 30), linewidth=2, force_overlay=true)


// ==========================================
// --- Buy / Sell Signals ---
// ==========================================
bool buySignal = false
bool sellSignal = false

if signalType == "RSI Crosses Extremes"
    buySignal := ta.crossover(rsi, osLevel)
    sellSignal := ta.crossunder(rsi, obLevel)
else if signalType == "RSI Crosses MA"
    buySignal := showMA and ta.crossover(rsi, rsiMA)
    sellSignal := showMA and ta.crossunder(rsi, rsiMA)
else if signalType == "Divergences"
    buySignal := bullishRegDiv
    sellSignal := bearishRegDiv

int sigOffset = signalType == "Divergences" ? -divLookbackRight : 0

// Signals plotted on the main chart (Price chart)
plotshape(series=showSignals and overlaySignals and buySignal, title="Buy Signal Overlay", style=shape.labelup, location=location.belowbar, color=buySignalColor, size=size.tiny, text="BUY", textcolor=color.white, offset=sigOffset, force_overlay=true)
plotshape(series=showSignals and overlaySignals and sellSignal, title="Sell Signal Overlay", style=shape.labeldown, location=location.abovebar, color=sellSignalColor, size=size.tiny, text="SELL", textcolor=color.white, offset=sigOffset, force_overlay=true)

// Signals plotted on the indicator pane (RSI chart)
plotshape(series=showSignals and not overlaySignals and buySignal ? osLevel : na, title="Buy Signal Pane", style=shape.labelup, location=location.absolute, color=buySignalColor, size=size.tiny, text="BUY", textcolor=color.white, offset=sigOffset)
plotshape(series=showSignals and not overlaySignals and sellSignal ? obLevel : na, title="Sell Signal Pane", style=shape.labeldown, location=location.absolute, color=sellSignalColor, size=size.tiny, text="SELL", textcolor=color.white, offset=sigOffset)

// --- Signal Counters ---
var int totalBuyCount = 0
var int totalSellCount = 0
if buySignal 
    totalBuyCount += 1
if sellSignal
    totalSellCount += 1


// ==========================================
// --- SL/TP & Zone Logic ---
// ==========================================
var box longTPBox = na
var box longSLBox = na
var box shortTPBox = na
var box shortSLBox = na
var line entryLine = na

var int active_trade = 0 // 1 for long, -1 for short, 0 for none
var float active_sl = na
var float active_tp = na

float atr = ta.atr(atrLen)

if buySignal and active_trade == 0
    float entryPrice = close
    float slPrice = entryPrice - (atr * slMult)
    float tpPrice = entryPrice + (atr * tpMult)
    
    active_trade := 1
    active_sl := slPrice
    active_tp := tpPrice

    if showTradeVisuals
        longTPBox := box.new(left=bar_index, top=tpPrice, right=bar_index + 10, bottom=entryPrice, bgcolor=bullZoneColor, border_color=color.new(color.green, 100), border_style=line.style_dotted, xloc=xloc.bar_index, force_overlay=true)
        longSLBox := box.new(left=bar_index, top=entryPrice, right=bar_index + 10, bottom=slPrice, bgcolor=slZoneColor, border_color=color.new(color.red, 100), border_style=line.style_dotted, xloc=xloc.bar_index, force_overlay=true)
        entryLine := line.new(bar_index, entryPrice, bar_index+10, entryPrice, color=color.aqua, width=2, force_overlay=true)

if sellSignal and active_trade == 0
    float entryPrice = close
    float slPrice = entryPrice + (atr * slMult)
    float tpPrice = entryPrice - (atr * tpMult)
    
    active_trade := -1
    active_sl := slPrice
    active_tp := tpPrice

    if showTradeVisuals
        shortTPBox := box.new(left=bar_index, top=entryPrice, right=bar_index + 10, bottom=tpPrice, bgcolor=bearZoneColor, border_color=color.new(color.red, 100), border_style=line.style_dotted, xloc=xloc.bar_index, force_overlay=true)
        shortSLBox := box.new(left=bar_index, top=slPrice, right=bar_index + 10, bottom=entryPrice, bgcolor=slZoneColor, border_color=color.new(color.red, 100), border_style=line.style_dotted, xloc=xloc.bar_index, force_overlay=true)
        entryLine := line.new(bar_index, entryPrice, bar_index+10, entryPrice, color=color.aqua, width=2, force_overlay=true)

// --- HIT DETECTION ---
if active_trade == 1
    if showTradeVisuals
        box.set_right(longTPBox, bar_index)
        box.set_right(longSLBox, bar_index)
        line.set_x2(entryLine, bar_index)

    if low <= active_sl
        if showTradeVisuals
            label.new(bar_index, active_sl, "SL", color=color.new(color.black, 100), textcolor=color.red, style=label.style_label_up, size=size.small, force_overlay=true)
        active_trade := 0
    else if high >= active_tp
        if showTradeVisuals
            label.new(bar_index, active_tp, "TP", color=color.new(color.black, 100), textcolor=color.green, style=label.style_label_down, size=size.small, force_overlay=true)
        active_trade := 0

if active_trade == -1
    if showTradeVisuals
        box.set_right(shortTPBox, bar_index)
        box.set_right(shortSLBox, bar_index)
        line.set_x2(entryLine, bar_index)

    if high >= active_sl
        if showTradeVisuals
            label.new(bar_index, active_sl, "SL", color=color.new(color.black, 100), textcolor=color.red, style=label.style_label_down, size=size.small, force_overlay=true)
        active_trade := 0
    else if low <= active_tp
        if showTradeVisuals
            label.new(bar_index, active_tp, "TP", color=color.new(color.black, 100), textcolor=color.green, style=label.style_label_up, size=size.small, force_overlay=true)
        active_trade := 0


// ==========================================
// --- Trade Dashboard ---
// ==========================================
var table dash = na
if showDash
    string realPos = dashPos == "Top Right" ? position.top_right : dashPos == "Bottom Right" ? position.bottom_right : dashPos == "Bottom Left" ? position.bottom_left : position.top_left
    dash := table.new(realPos, 2, 9, bgcolor=color.new(#131722, 10), border_width=1, border_color=color.new(color.white, 90), force_overlay=true)
    
    // Convert current RSI state to string
    string rsiStatus = rsi > obLevel ? "Overbought" : rsi < osLevel ? "Oversold" : "Neutral"
    color rsiStatusColor = rsi > obLevel ? color.new(color.red, 0) : rsi < osLevel ? color.new(color.green, 0) : color.new(color.white, 30)
    
    string trendStatus = close > mainEma ? "BULLISH ⇡" : "BEARISH ⇣"
    color trendColor = close > mainEma ? color.new(#00e676, 0) : color.new(#ff5252, 0)
    
    string activeTradeStatus = active_trade == 1 ? "LONG ACTIVE" : active_trade == -1 ? "SHORT ACTIVE" : "WAITING"
    color activeTradeColor = active_trade == 1 ? color.new(#00e676, 0) : active_trade == -1 ? color.new(#ff5252, 0) : color.new(color.white, 30)

    // Delta Volume Calculation
    float dVol = (close >= open ? volume : -volume)
    color dVolColor = dVol >= 0 ? color.new(#00e676, 0) : color.new(#ff5252, 0)

    if barstate.islast
        table.cell(dash, 0, 0, "✦ RSI ELITE HUB ✦", text_color=color.white, text_size=size.small, bgcolor=color.new(#2962ff, 10), text_halign=text.align_center)
        table.merge_cells(dash, 0, 0, 1, 0)
        
        table.cell(dash, 0, 1, "RSI STAT", text_color=color.new(color.white, 50), text_size=size.small, text_halign=text.align_left)
        table.cell(dash, 1, 1, str.tostring(rsi, "#.##") + " • " + rsiStatus, text_color=rsiStatusColor, text_size=size.small, text_halign=text.align_right)
        
        table.cell(dash, 0, 2, "TREND", text_color=color.new(color.white, 50), text_size=size.small, text_halign=text.align_left)
        table.cell(dash, 1, 2, trendStatus, text_color=trendColor, text_size=size.small, text_halign=text.align_right)
        
        table.cell(dash, 0, 3, "SIGNAL", text_color=color.new(color.white, 50), text_size=size.small, text_halign=text.align_left)
        table.cell(dash, 1, 3, activeTradeStatus, text_color=activeTradeColor, text_size=size.small, text_halign=text.align_right, bgcolor=color.new(activeTradeColor, 95))

        table.cell(dash, 0, 4, "TOTAL BUY", text_color=color.new(color.white, 50), text_size=size.small, text_halign=text.align_left)
        table.cell(dash, 1, 4, str.tostring(totalBuyCount), text_color=color.green, text_size=size.small, text_halign=text.align_right)

        table.cell(dash, 0, 5, "TOTAL SELL", text_color=color.new(color.white, 50), text_size=size.small, text_halign=text.align_left)
        table.cell(dash, 1, 5, str.tostring(totalSellCount), text_color=color.red, text_size=size.small, text_halign=text.align_right)

        table.cell(dash, 0, 6, "DELTA VOL", text_color=color.new(color.white, 50), text_size=size.small, text_halign=text.align_left)
        table.cell(dash, 1, 6, str.tostring(dVol, format.volume), text_color=dVolColor, text_size=size.small, text_halign=text.align_right)

        table.cell(dash, 0, 7, "TIMEFRAME", text_color=color.new(color.white, 50), text_size=size.small, text_halign=text.align_left)
        table.cell(dash, 1, 7, useMTF ? tf : timeframe.period, text_color=color.white, text_size=size.small, text_halign=text.align_right)

// ==========================================
// --- Alerts ---
// ==========================================
alertcondition(ta.crossover(rsi, osLevel), title="Bullish: RSI Crossed Oversold", message="RSI has crossed above the oversold level.")
alertcondition(ta.crossunder(rsi, obLevel), title="Bearish: RSI Crossed Overbought", message="RSI has crossed below the overbought level.")
alertcondition(ta.crossover(rsi, rsiMA), title="Bullish: RSI Crossed Above MA", message="RSI has crossed above its Moving Average.")
alertcondition(ta.crossunder(rsi, rsiMA), title="Bearish: RSI Crossed Below MA", message="RSI has crossed below its Moving Average.")
alertcondition(bullishRegDiv, title="Bullish Regular Divergence", message="Bullish Regular Divergence Detected.")
alertcondition(bearishRegDiv, title="Bearish Regular Divergence", message="Bearish Regular Divergence Detected.")
alertcondition(buySignal, title="Indicator Buy Signal", message="The configured Buy strategy triggered a signal.")
alertcondition(sellSignal, title="Indicator Sell Signal", message="The configured Sell strategy triggered a signal.")
