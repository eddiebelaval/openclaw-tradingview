// This script is unfortunately really slow and laggy. That's unavoidable,
// because to scale the visible portion of the index line we need to
// access `left_visible_bar_time` and `right_visible_bar_time`. There are
// two issues with that. First, if a script access those variables, then it
// is reloaded on every zoom/scroll. So every time the chart is zoomed/
// scrolled, this script is reloaded and has to recalculate and draw
// everything from scratch. Second, TradingView has a couple of seconds delay
// built in before it will initiate the reload, presumably to allow the zoom/
// scroll to settle, and to avoid reloading on every zoom/scroll intermediate
// step. But that makes this script even less responsive, of course.
//
// Tip: when using this indicator, you may also want to change the main
// chart's top margin to push the main plot down a bit (that setting does not
// affect the position of this indicator). See the "Margins" section in the
// Chart Setting's "Canvas" tab.
//
// Implementation note: to avoid having a scale added to the side of the chart
// we us `scale=scale.none`. Sometimes TradingView will then draw our drawings
// on the scale of the main chart, so we have to manually map the index's Y
// values to the Y coordinates of the main chart, being careful to keep them
// out of our top/bottom "margin" areas. Othertimes, TradingView will scale
// the drawings to fill the full height of the chart area despite that effort.
// (Not what we want, obviously.) To avoid that, we have a little trick/hack
// of drawing an invisible line spanning the full height of the main chart's
// Y coordinates.

//@version=6
indicator(
    "Index Line With Top/Bottom Margins",
    "Index Line",
    overlay = true,
    max_bars_back = 2,
    max_lines_count = 500,  // the max allowed
    behind_chart = true,
    scale = scale.none)

idxSymbol = input.symbol("SP:SPX", "Index Symbol")
fracAbove = input.int(0,  "Top Margin (%)", minval=0, maxval=100, display=display.none) / 100
fracBelow = input.int(66, "Bottom Margin (%)", minval=0, maxval=100, display=display.none) / 100
lineWidth = input.int(1, "Line Width/Color      ", inline="i1", display=display.none)
lineColor = input.color(#888888, "", inline="i1", display=display.none)

var float fracRem = 1 - fracAbove - fracBelow

var int leftTime  = chart.left_visible_bar_time
var int rightTime = chart.right_visible_bar_time
var int leftIndex = na

var float visIdxHigh = 0
var float visIdxLow = 9999999
var float visChartHigh = 0
var float visChartLow = 9999999

inWindow = time_close >= leftTime and time <= rightTime

idxClose = request.security(
    idxSymbol, timeframe.period, close,
    lookahead=barmerge.lookahead_on)

//max_bars_back(idxClose, 5000)

if inWindow and not na(idxClose)
    if na(leftIndex)
        leftIndex := bar_index
    visIdxHigh := math.max(visIdxHigh, idxClose)
    visIdxLow := math.min(visIdxLow, idxClose)
    visChartHigh := math.max(visChartHigh, high)
    visChartLow := math.min(visChartLow, low)
    // Was hoping using `line.new()` instead of `plot()` would avoid the
    // scale being added to the chart, but alas, no.
    //line.new(bar_index-1, idxClose[1], bar_index, idxClose, color=#ffffffbb, width=1)

var drewLines = false
if not drewLines and ((not inWindow and inWindow[1]) or barstate.islast)
    drewLines := true

    float idxRange = visIdxHigh - visIdxLow
    float chartRange = visChartHigh - visChartLow
    float prevY = na
    int step = math.ceil((bar_index - leftIndex) / 500)  // handling max_lines_count

    for i = 0 to bar_index - leftIndex by step
        float fracOfIdxRange = (idxClose[i] - visIdxLow) / idxRange
        float fracOfChart = fracBelow + fracOfIdxRange * fracRem
        x = bar_index - i + 1
        y = visChartLow + fracOfChart * chartRange
        line.new(x, prevY, x-step, y, color=lineColor, width=lineWidth)
        prevY := y

    // Hack to exploit the auto-scaling - draw a tall, transparent black line to
    // force the index line into the correct portion (horizontal strip) of the chart.
    // The `-1`s are needed make sure the line is actually in the visible area of
    // the chart, otherwise it won't force any scaling.
    line.new(bar_index-1, visChartLow, bar_index-1, visChartHigh, color=#00000000, width=1)
