//@version=6
strategy(title = 'Super Trend + Stoch/RSI + Tolerance + 3 TP', shorttitle = 'ST-RSI-STR', overlay = true, pyramiding = 0, initial_capital = 6000)

///////////////////
// Date Ranges
from_month = input.int(defval = 1, title = 'From Month', minval = 1, maxval = 12)
from_day = input.int(defval = 1, title = 'From Day', minval = 1, maxval = 31)
from_year = input(defval = 2021, title = 'From Year')
to_month = input.int(defval = 1, title = 'To Month', minval = 1, maxval = 12)
to_day = input.int(defval = 1, title = 'To Day', minval = 1, maxval = 31)
to_year = input(defval = 9999, title = 'To Year')
start = timestamp(from_year, from_month, from_day, 00, 00) 
finish = timestamp(to_year, to_month, to_day, 23, 59) 
window = time >= start and time <= finish ? true : false 
//
tradeDirection = input.string("Both", title="Trade Direction", options=["Long", "Short", "Both"])
//// super trend
Periods = input(title = 'ATR Period', defval = 10)
hl2Price = input(hl2, title = 'Source')
Multiplier = input.float(title = 'ATR Multiplier', step = 0.1, defval = 3.0)
changeATR = input(title = 'Change ATR Calculation Method ?', defval = true)
///// cal super trend
atr2 = ta.sma(ta.tr, Periods)
atr = changeATR ? ta.atr(Periods) : atr2
up = hl2Price - Multiplier * atr
up1 = nz(up[1], up)
up := close[1] > up1 ? math.max(up, up1) : up
dn = hl2Price + Multiplier * atr
dn1 = nz(dn[1], dn)
dn := close[1] < dn1 ? math.min(dn, dn1) : dn
trend = 1
trend := nz(trend[1], trend)
trend := trend == -1 and close > dn1 ? 1 : trend == 1 and close < up1 ? -1 : trend
plot(trend == 1 ? up : na, title = 'Up Trend', style = plot.style_linebr, linewidth = math.max(1, 0), color = color.new(color.green, 0))
plot(trend == 1 ? na : dn, title = 'Down Trend', style = plot.style_linebr, linewidth = math.max(1, 0), color = color.new(color.red, 0))
///how close to the trend
tolerance = input.float(title = 'Price Diff to Wait (in %)', step = 0.1, defval = 0.1)
buyRange = up * (1 + tolerance / 100)
sellRange = dn * (1 - tolerance / 100)
/////buyRange from the trend
b = trend == 1 and buyRange > close
s = trend == -1 and sellRange < close

////Stoch/RSI
smoothK = input.int(3, "K smooth Stoch/Rsi", minval=1)
lengthRSI = input.int(14, "RSI Length", minval=1)
lengthStoch = input.int(14, "Stochastic Length", minval=1)
src = input(close, title="RSI Source")
rsi = ta.rsi(src, lengthRSI)
k = ta.sma(ta.stoch(rsi, rsi, rsi, lengthStoch), smoothK)

////buy/sell signal
LB = input(5,"Low band of ST/RSI for long trade")
HB = input(95,"High band of ST/RSI for short trade")
buy = trend == 1 and ( k < LB  ) and  buyRange > close
sell = trend == -1 and ( k > HB ) and buyRange < close
///
tp_level1 = input.float(title="Take Profit Level 1 (%)", defval=1.0, step = 0.1)
tp_level2 = input.float(title="Take Profit Level 2 (%)", defval=2.0, step = 0.1)
tp_level3 = input.float(title="Take Profit Level 3 (%)", defval=3.0, step = 0.1)

tp_percent1 = input.float(title="Take Profit Percent 1 (%)", defval=30.0)
tp_percent2 = input.float(title="Take Profit Percent 2 (%)", defval=20.0)
tp_percent3 = input.float(title="Take Profit Percent 3 (%)", defval=15.0)

//SIZE OF THE TRADE
increaseT = input.bool(true,title = " Increase size of the trade after # of losing trades ")
SZZ = input(1000,title = "Size of the trade in USD")
nl = input.float(2,minval=1,title = "# of losing trades in the row")
osc = SZZ / close
// Check if there's a new losing trade that increased the streak
loss = (strategy.losstrades > strategy.losstrades[1]) and (strategy.wintrades == strategy.wintrades[1]) and (strategy.eventrades == strategy.eventrades[1])
win = strategy.wintrades > strategy.wintrades[1] and strategy.losstrades == strategy.losstrades[1] and strategy.eventrades == strategy.eventrades[1]

// Determine current losing streak length
streaklen = 0

streaklen := if loss
    nz(streaklen[1]) + 1
else
    if strategy.wintrades > strategy.wintrades[1] or
         strategy.eventrades > strategy.eventrades[1]
        0
    else
        nz(streaklen[1])

/// size increase  like D'Alembert 
var size_arr = array.from(osc/2, osc/2, osc/2, osc/2)
array.size(size_arr)
    

if win and array.size(size_arr) >= 4
    array.shift(size_arr)
    array.pop(size_arr)


else if win 
    size_arr := array.from(osc/2, osc/2, osc/2,osc/2)


if streaklen > nl and loss
    array.push(size_arr, value= array.get(size_arr, 1) + array.last(size_arr))


first_elem = array.get(size_arr, 0)

last_elem  = array.last(size_arr)
fl = first_elem + last_elem

// ========================================================================================================


// strategy 
if ( buy) and (tradeDirection == "Long" or tradeDirection == "Both") and window 
    strategy.entry("Long Position", strategy.long, qty = increaseT == true ?  fl : osc)


if trend == -1
    strategy.close("Long Position")    

if ( sell) and (tradeDirection == "Short" or tradeDirection == "Both") and window
    strategy.entry("Short Position", strategy.short, qty = increaseT== true ?   fl : osc)
if trend ==  1
    strategy.close("Short Position")    


// Calculate the take-profit prices based on the average entry price
tp_price1_long = strategy.position_avg_price * (1 + tp_level1 / 100)
tp_price2_long = strategy.position_avg_price * (1 + tp_level2 / 100)
tp_price3_long = strategy.position_avg_price * (1 + tp_level3 / 100)
//st = strategy.position_avg_price * (1 - up)
tp_price1_short = strategy.position_avg_price * (1 - tp_level1 / 100)
tp_price2_short = strategy.position_avg_price * (1 - tp_level2 / 100)
tp_price3_short = strategy.position_avg_price * (1 - tp_level3 / 100)


// Exit portions of the position at each take-profit level
if strategy.position_size > 0
    strategy.exit("Take Profit 1", from_entry="Long Position", qty_percent=tp_percent1, limit=tp_price1_long)
    strategy.exit("Take Profit 2", from_entry="Long Position", qty_percent=tp_percent2, limit=tp_price2_long)
    strategy.exit("Take Profit 3", from_entry="Long Position", qty_percent=tp_percent3, limit=tp_price3_long)

if strategy.position_size < 0
    strategy.exit("Take Profit 1", from_entry="Short Position", qty_percent=tp_percent1, limit=tp_price1_short)
    strategy.exit("Take Profit 2", from_entry="Short Position", qty_percent=tp_percent2, limit=tp_price2_short)
    strategy.exit("Take Profit 3", from_entry="Short Position", qty_percent=tp_percent3, limit=tp_price3_short)

// plot
plot(strategy.position_size > 0 ? tp_price1_long : na, style  = plot.style_linebr, linewidth = 1, color = color.green)
plot(strategy.position_size > 0 ? tp_price2_long : na, style = plot.style_linebr, linewidth = 1, color = color.green)
plot(strategy.position_size > 0 ? tp_price3_long : na, style  = plot.style_linebr, linewidth = 1, color = color.green)
plot(strategy.position_size < 0 ? tp_price1_short : na, style = plot.style_linebr, linewidth = 1, color = color.red)
plot(strategy.position_size < 0 ? tp_price2_short : na, style = plot.style_linebr, linewidth = 1, color = color.red)
plot(strategy.position_size < 0 ? tp_price3_short : na, style = plot.style_linebr, linewidth = 1, color = color.red)
