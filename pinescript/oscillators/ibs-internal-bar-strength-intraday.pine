//@version=5
indicator(title="IBS — Internal Bar Strength (Intraday)", shorttitle="IBS", overlay=false)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
ibsLen       = input.int(1,   title="IBS Length (bars)",       minval=1)
smoothLen    = input.int(3,   title="Smoothing (EMA periods)", minval=1)
obLevel      = input.float(0.7, title="Overbought Level",      minval=0.0, maxval=1.0, step=0.05)
osLevel      = input.float(0.3, title="Oversold Level",        minval=0.0, maxval=1.0, step=0.05)
showSignals  = input.bool(true, title="Show Entry Signals")
showBgColor  = input.bool(true, title="Color Background on Extremes")

// ─────────────────────────────────────────────
// IBS CALCULATION
// IBS = (close - low) / (high - low)
// 0 = closed at the low (full weakness)
// 1 = closed at the high (full strength)
// ─────────────────────────────────────────────
rawIBS = (close - low) / (high - low)
ibs    = ta.ema(rawIBS, smoothLen)  // slight smoothing to reduce noise

// ─────────────────────────────────────────────
// PLOT IBS LINE
// ─────────────────────────────────────────────
ibsColor = ibs >= obLevel ? color.new(color.red, 0) :
           ibs <= osLevel ? color.new(color.green, 0) :
           color.new(color.gray, 20)

plot(ibs, title="IBS", color=ibsColor, linewidth=2)

// Reference levels
hline(obLevel, "Overbought", color=color.new(color.red,  40), linestyle=hline.style_dashed, linewidth=1)
hline(0.5,     "Midline",    color=color.new(color.gray, 50), linestyle=hline.style_dotted, linewidth=1)
hline(osLevel, "Oversold",   color=color.new(color.green,40), linestyle=hline.style_dashed, linewidth=1)

// Fill zones
obZone = hline(1.0, display=display.none)
osZone = hline(0.0, display=display.none)
obLine = hline(obLevel, display=display.none)
osLine = hline(osLevel, display=display.none)
fill(obLine, obZone, color=color.new(color.red,   88), title="Overbought Zone")
fill(osLine, osZone, color=color.new(color.green, 88), title="Oversold Zone")

// ─────────────────────────────────────────────
// SIGNALS
// Bounce signal: IBS crosses above oversold (potential long)
// Fade signal:   IBS crosses below overbought (potential short)
// ─────────────────────────────────────────────
bounceSignal = ta.crossover(ibs,  osLevel)
fadeSignal   = ta.crossunder(ibs, obLevel)

plotshape(showSignals and bounceSignal, title="Bounce Signal", style=shape.triangleup,
          location=location.bottom, color=color.new(color.green, 0), size=size.small)
plotshape(showSignals and fadeSignal,   title="Fade Signal",   style=shape.triangledown,
          location=location.top,    color=color.new(color.red,   0), size=size.small)

// ─────────────────────────────────────────────
// BACKGROUND COLOR (optional)
// ─────────────────────────────────────────────
bgColor = showBgColor ?
          (ibs <= osLevel ? color.new(color.green, 92) :
           ibs >= obLevel ? color.new(color.red,   92) :
           na) : na
bgcolor(bgColor, title="Extreme Zone Background")

// ─────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────
alertcondition(bounceSignal, title="IBS Bounce Setup",
               message="IBS crossed above oversold ({{ticker}} {{interval}}) — Potential bounce / long setup. Check internals + VWAP.")
alertcondition(fadeSignal,   title="IBS Fade Setup",
               message="IBS crossed below overbought ({{ticker}} {{interval}}) — Potential fade / short setup. Check internals + VWAP.")

// ─────────────────────────────────────────────
// USAGE GUIDE (in description when publishing)
// ─────────────────────────────────────────────
// IBS < 0.3  = Price closed in bottom 30% of bar range = WEAKNESS / oversold bounce zone
// IBS > 0.7  = Price closed in top 70% of bar range    = STRENGTH / overbought fade zone
// IBS = 0.5  = Price closed at midpoint of bar range   = neutral
//
// INTRADAY SETUP (5m chart):
// LONG:  IBS < 0.3 + price near VWAP or key support + internals aligned bullish
// SHORT: IBS > 0.7 + price at resistance + internals aligned bearish
//
// Best used as CONFIRMATION — not standalone signal.
// Always check: Flowtopia flow, $TICK, $ADD, VWAP, key levels BEFORE entry.
