//@version=6
// From here to line 27 is the built in indicator provided by tradingview.com
indicator("Average Directional Index (ADX) + Trend Thresholds and Color", shorttitle="ADX", format=format.price, precision=2, timeframe="", timeframe_gaps=true)

TT_ADX_LEN = "The time period to be used in calculating the ADX which has a smoothing component."
TT_DI_LEN  = "The time period to be used in calculating the DI (Directional Indicator)."

adxlen = input(14, title = "ADX Smoothing",  tooltip = TT_ADX_LEN)
dilen =  input(14, title = "DI Length",      tooltip = TT_DI_LEN)

dirmov(len) =>
    up = ta.change(high)
    down = -ta.change(low)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    truerange = ta.rma(ta.tr, len)
    plus = fixnan(100 * ta.rma(plusDM, len) / truerange)
    minus = fixnan(100 * ta.rma(minusDM, len) / truerange)
    [plus, minus]
adx(dilen, adxlen) =>
    [plus, minus] = dirmov(dilen)
    sum = plus + minus
    adx = 100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), adxlen)
sig = adx(dilen, adxlen)
plot(sig, color=color.red, title="ADX")

// Below was added by MatteoArroz
bool enableBarColoring = input.bool(false, "Enable Bar Coloring")

h0 = hline(0, "0 Level")
h20 = hline(20, "20 Level")
h25 = hline(25, "25 Level")
h50 = hline(50, "50 Level")
h75 = hline(75, "75 Level")
h100 = hline(100, "100 Level")

fill(h0, h20, color=color.new(#2C7BB6, 90), title="Weak or no trend")
fill(h20, h25, color=color.new(#ABD9E9, 90), title="No trend or trend beginning")
fill(h25, h50, color=color.new(#FFFFBF, 90), title="Strong trend")
fill(h50, h75, color=color.new(#FDAE61, 90), title="Very strong trend")
fill(h75, h100, color=color.new(#D7191C, 90), title="Extremely strong trend")

colorForBar = color.new(#2C7BB6, 90)

if (sig >=0 and sig <=20)
    colorForBar := color.new(#2C7BB6, 37)
else if (sig >= 20 and sig <= 25)
    colorForBar := color.new(#ABD9E9, 37)
else if (sig >= 25 and sig <= 50)
    colorForBar := color.new(#FFFFBF, 37)
else if (sig >= 50 and sig <= 75)
    colorForBar := color.new(#FDAE61, 37)
else if (sig >= 75 and sig <= 100)
    colorForBar := color.new(#D7191C, 37)

barcolor(colorForBar)
