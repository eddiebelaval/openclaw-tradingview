//@version=6
indicator(title="Average RSI with 5 and 40 MA", shorttitle="Avg RSI MA", overlay=false, timeframe="", timeframe_gaps=true)

// ══════════════════════════════════════════
//  INPUTS
// ══════════════════════════════════════════

grp1 = "RSI Settings"
rsi_source = input.source(close, title="RSI Source",      group=grp1)
rsi_length = input.int(14,       title="RSI Length",      group=grp1, minval=1, maxval=100)

grp2 = "Moving Average Settings"
ma_type  = input.string("SMA",   title="MA Type",         group=grp2, options=["SMA","EMA","WMA","RMA"])
ma_short = input.int(5,          title="Short MA Length", group=grp2, minval=1, maxval=200)
ma_long  = input.int(40,         title="Long MA Length",  group=grp2, minval=1, maxval=200)

grp3 = "Appearance"
col_rsi   = input.color(color.new(color.gray,   30), title="RSI Color",          group=grp3)
col_short = input.color(color.new(color.blue,    0), title="Short MA Color",     group=grp3)
col_long  = input.color(color.new(color.orange,  0), title="Long MA Color",      group=grp3)
col_avg   = input.color(color.new(color.purple,  0), title="Average Line Color", group=grp3)

// ══════════════════════════════════════════
//  MA FUNCTION
// ══════════════════════════════════════════

f_ma(src, len, type) =>
    switch type
        "SMA" => ta.sma(src, len)
        "EMA" => ta.ema(src, len)
        "WMA" => ta.wma(src, len)
        "RMA" => ta.rma(src, len)
        => ta.sma(src, len)  // v6 requires explicit default case

// ══════════════════════════════════════════
//  CALCULATIONS
// ══════════════════════════════════════════

rsi_val      = ta.rsi(rsi_source, rsi_length)
rsi_ma_short = f_ma(rsi_val, ma_short, ma_type)
rsi_ma_long  = f_ma(rsi_val, ma_long,  ma_type)
rsi_avg      = (rsi_ma_short + rsi_ma_long) / 2

// ══════════════════════════════════════════
//  PLOTS
// ══════════════════════════════════════════

plot(rsi_val,      title="RSI",          color=col_rsi,   linewidth=1)
plot(rsi_ma_short, title="Short MA (5)", color=col_short, linewidth=2)
plot(rsi_ma_long,  title="Long MA (40)", color=col_long,  linewidth=2)
plot(rsi_avg,      title="Avg RSI MA",   color=col_avg,   linewidth=3)

// ══════════════════════════════════════════
//  REFERENCE LINES
// ══════════════════════════════════════════

hline(70, "Overbought", color=color.red,   linestyle=hline.style_dashed, linewidth=1)
hline(50, "Midline",    color=color.gray,  linestyle=hline.style_dotted, linewidth=1)
hline(30, "Oversold",   color=color.green, linestyle=hline.style_dashed, linewidth=1)
