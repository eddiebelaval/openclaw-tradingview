//@version=6
indicator(title="RSI BUY/SELL Pro - KN", shorttitle="RSI Pro KN", overlay=true)

// ==========================================
// 1. RSI CORE SETTINGS
// ==========================================
groupRSI = "RSI Core Settings"
rsiLengthInput = input.int(14, minval=1, title="RSI Length", group=groupRSI)
rsiSourceInput = input.source(close, "Source", group=groupRSI)

rsi = ta.rsi(rsiSourceInput, rsiLengthInput)

// ==========================================
// 2. CONSECUTIVE BUY/SELL LOGIC & CONFIG
// ==========================================
groupSignal = "Buy/Sell Signal Settings"
up_thr      = input.int(70, minval=1, title="RSI Sell Threshold", group=groupSignal)
dn_thr      = input.int(30, minval=1, title="RSI Buy Threshold", group=groupSignal)
consec_len  = input.int(2, minval=1, title="Req. Consecutive Bars", group=groupSignal)

// Configurable Text and Colors
buyTxt      = input.string("BUY", "Buy Label Text", group=groupSignal)
sellTxt     = input.string("SELL", "Sell Label Text", group=groupSignal)
buyColor    = input.color(color.green, "Buy Label Color", group=groupSignal)
sellColor   = input.color(color.red, "Sell Label Color", group=groupSignal)
buyTxtCol   = input.color(color.white, "Buy Text Color", group=groupSignal)
sellTxtCol  = input.color(color.white, "Sell Text Color", group=groupSignal)

// Counters for consecutive bars
var int count_below = 0
var int count_above = 0

count_below := (rsi < dn_thr) ? count_below + 1 : 0
count_above := (rsi > up_thr) ? count_above + 1 : 0

// Trigger Logic (Waiting for the RSI to cross back into the neutral zone)
buy_signal  = (count_below[1] >= consec_len) and ta.crossover(rsi, dn_thr)
sell_signal = (count_above[1] >= consec_len) and ta.crossunder(rsi, up_thr)

// --- DYNAMIC LABEL PLOTTING ---
// Note: 'yloc' handles the offset automatically. 
// Using style=label.style_arrowup/down provides more clearance than standard labels.

if buy_signal
    label.new(bar_index, na, text=buyTxt, color=buyColor, textcolor=buyTxtCol, 
         style=label.style_label_up, size=size.tiny, yloc=yloc.belowbar)

if sell_signal
    label.new(bar_index, na, text=sellTxt, color=sellColor, textcolor=sellTxtCol, 
         style=label.style_label_down, size=size.tiny, yloc=yloc.abovebar)

// ==========================================
// 3. ALERTS
// ==========================================
if buy_signal
    alert("RSI Buy triggered: " + buyTxt, alert.freq_once_per_bar)
if sell_signal
    alert("RSI Sell triggered: " + sellTxt, alert.freq_once_per_bar)
