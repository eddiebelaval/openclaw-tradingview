//@version=5
indicator("Mogalef Trend Filter", overlay=false)

// ===== INPUTS =====
blockCase1 = input.bool(false, "Block Case 1")
blockCase2 = input.bool(false, "Block Case 2")
blockCase3 = input.bool(false, "Block Case 3")
blockCase4 = input.bool(false, "Block Case 4")
blockCase5 = input.bool(false, "Block Case 5")
blockCase6 = input.bool(false, "Block Case 6")
blockCase7 = input.bool(false, "Block Case 7")
blockCase8 = input.bool(false, "Block Case 8")

R1 = input.int(1, "R1")
R2 = input.int(90, "R2")
R3 = input.int(150, "R3")

tradeOnlyCase = input.int(0, "Trade Only This Case (0 = all)", minval=0, maxval=8)
offOn = input.bool(true, "Filter ON")

// ===== FUNCTION REPULSE =====
repulse(len) =>
    pousH = ((3 * close) - open[len]) / close * 100
    pousB = (open[len] - (3 * close)) / close * 100
    emaH = ta.ema(pousH, len * 5)
    emaB = ta.ema(pousB, len * 5)
    emaH - emaB

// ===== CALCULO INDICADORES =====
indic1  = repulse(R1)
indic5  = repulse(R2)
indic15 = repulse(R3)

// ===== DIRECCIÓN =====
sensR1  = indic1  > indic1[1]  ? 1 : -1
sensR5  = indic5  > indic5[1]  ? 1 : -1
sensR15 = indic15 > indic15[1] ? 1 : -1

// ===== CASOS =====
cas =
     sensR15 == 1 and sensR5 == 1 and sensR1 == 1 ? 8 :
     sensR15 == 1 and sensR5 == 1 and sensR1 == -1 ? 7 :
     sensR15 == 1 and sensR5 == -1 and sensR1 == 1 ? 6 :
     sensR15 == 1 and sensR5 == -1 and sensR1 == -1 ? 5 :
     sensR15 == -1 and sensR5 == 1 and sensR1 == 1 ? 4 :
     sensR15 == -1 and sensR5 == 1 and sensR1 == -1 ? 3 :
     sensR15 == -1 and sensR5 == -1 and sensR1 == 1 ? 2 :
     sensR15 == -1 and sensR5 == -1 and sensR1 == -1 ? 1 : na

// ===== FILTRO =====
var int flag = 0
flag := 0

if offOn
    if tradeOnlyCase != 0
        if cas != tradeOnlyCase
            flag := 1
    else
        if (blockCase1 and cas == 1) or
           (blockCase2 and cas == 2) or
           (blockCase3 and cas == 3) or
           (blockCase4 and cas == 4) or
           (blockCase5 and cas == 5) or
           (blockCase6 and cas == 6) or
           (blockCase7 and cas == 7) or
           (blockCase8 and cas == 8)
            flag := 1

// evitar valores iniciales
if bar_index < R3 * 5
    flag := 1
    cas := na

// ===== PLOTS =====
plot(cas, title="CAS", color=color.black)
plot(flag, title="BLOCK FLAG", color=color.red)
