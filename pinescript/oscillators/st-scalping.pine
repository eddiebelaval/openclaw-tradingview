//@version=5
indicator("ST Scalping", overlay=true)

//=====================
// EMA SETTINGS
//=====================
emaLength   = input.int(50, "EMA Length")
zonePercent = input.float(0.2, "EMA Zone %", step=0.1)

emaValue = ta.ema(close, emaLength)
zoneSize = emaValue * zonePercent / 100

upperZone = emaValue + zoneSize
lowerZone = emaValue - zoneSize

//=====================
// WICK SETTINGS
//=====================
wickTolerance = input.float(0.0, "Wick Tolerance")

//=====================
// SESSION SETTINGS (IST)
//=====================
asiaSession     = input.session("0300-1000", "Asia Session (IST)")
london1Session  = input.session("1000-1330", "London 1 Session (IST)")
london2Session  = input.session("1330-1630", "London 2 Session (IST)")
nySession       = input.session("1800-2230", "New York Session (IST)")

asiaColor    = input.color(color.yellow, "Asia Signal Color")
london1Color = input.color(color.green, "London 1 Signal Color")
london2Color = input.color(color.blue, "London 2 Signal Color")
nyColor      = input.color(color.red, "New York Signal Color")

//=====================
// BLOCKED PERIOD
//=====================
blockSession = input.session("1630-1800", "Blocked Time (IST)")

//=====================
// TABLE SETTINGS
//=====================
showStatsTable = input.bool(true, "Show Stats Table (Top Right)")
showDayTable   = input.bool(true, "Show Daily Signals Table (Bottom Right)")

//=====================
// SESSION DETECTION
//=====================
asia    = not na(time(timeframe.period, asiaSession, "Asia/Kolkata"))
london1 = not na(time(timeframe.period, london1Session, "Asia/Kolkata"))
london2 = not na(time(timeframe.period, london2Session, "Asia/Kolkata"))
ny      = not na(time(timeframe.period, nySession, "Asia/Kolkata"))

blocked = not na(time(timeframe.period, blockSession, "Asia/Kolkata"))

//=====================
// WICKLESS CONDITIONS
//=====================
bullCandle = close > open
bearCandle = close < open

bullNoWick = bullCandle and (open - low) <= wickTolerance
bearNoWick = bearCandle and (high - open) <= wickTolerance

//=====================
// EMA TREND FILTER
//=====================
aboveZone = close > upperZone
belowZone = close < lowerZone

bullSignal = bullNoWick and aboveZone and not blocked
bearSignal = bearNoWick and belowZone and not blocked

//=====================
// SESSION COLOR
//=====================
sessionColor =
     asia ? asiaColor :
     london1 ? london1Color :
     london2 ? london2Color :
     ny ? nyColor :
     na

//=====================
// SIGNAL PLOTS
//=====================
plotshape(bullSignal and not na(sessionColor),
     location=location.belowbar,
     color=sessionColor,
     style=shape.triangleup,
     size=size.small)

plotshape(bearSignal and not na(sessionColor),
     location=location.abovebar,
     color=sessionColor,
     style=shape.triangledown,
     size=size.small)

//=====================
// EMA ZONE
//=====================
emaPlot = plot(emaValue, color=color.orange, linewidth=2)
upperPlot = plot(upperZone, color=color.blue)
lowerPlot = plot(lowerZone, color=color.blue)

fill(upperPlot, lowerPlot, color=color.new(color.blue,85))

//=====================
// STATS
//=====================
var int totalCandles = 0
var int bullCandles = 0
var int bearCandles = 0
var int wicklessBull = 0
var int wicklessBear = 0

totalCandles += 1

if bullCandle
    bullCandles += 1
if bearCandle
    bearCandles += 1
if bullNoWick
    wicklessBull += 1
if bearNoWick
    wicklessBear += 1

bullPercent = bullCandles > 0 ? (wicklessBull / bullCandles) * 100 : 0
bearPercent = bearCandles > 0 ? (wicklessBear / bearCandles) * 100 : 0

//=====================
// DAILY SIGNAL COUNT
//=====================
var int todaySignals = 0

newDay = ta.change(time("D", "Asia/Kolkata"))
if newDay
    todaySignals := 0

if bullSignal or bearSignal
    todaySignals += 1

//=====================
// STATS TABLE (TOP RIGHT)
//=====================
var table statsTable = table.new(position.top_right, 2, 8, border_width=1)

if showStatsTable and barstate.islast
    table.cell(statsTable,0,0,"Metric",bgcolor=color.gray,text_color=color.white)
    table.cell(statsTable,1,0,"Value",bgcolor=color.gray,text_color=color.white)

    table.cell(statsTable,0,1,"Wickless Bull", text_color=color.white)
    table.cell(statsTable,1,1,str.tostring(wicklessBull), text_color=color.white)

    table.cell(statsTable,0,2,"Wickless Bear", text_color=color.white)
    table.cell(statsTable,1,2,str.tostring(wicklessBear), text_color=color.white)

    table.cell(statsTable,0,3,"% Bull", text_color=color.white)
    table.cell(statsTable,1,3,str.tostring(bullPercent,"#.##")+"%", text_color=color.white)

    table.cell(statsTable,0,4,"% Bear", text_color=color.white)
    table.cell(statsTable,1,4,str.tostring(bearPercent,"#.##")+"%", text_color=color.white)

    table.cell(statsTable,0,5,"Total", text_color=color.white)
    table.cell(statsTable,1,5,str.tostring(totalCandles), text_color=color.white)

    table.cell(statsTable,0,6,"Bull Candles", text_color=color.white)
    table.cell(statsTable,1,6,str.tostring(bullCandles), text_color=color.white)

    table.cell(statsTable,0,7,"Bear Candles", text_color=color.white)
    table.cell(statsTable,1,7,str.tostring(bearCandles), text_color=color.white)

//=====================
// DAILY TABLE (BOTTOM RIGHT)
//=====================
var table dayTable = table.new(position.bottom_right, 1, 2, border_width=1)

if showDayTable and barstate.islast
    table.cell(dayTable, 0, 0, "Signals Today",
         bgcolor=color.black, text_color=color.white)

    table.cell(dayTable, 0, 1, str.tostring(todaySignals),
         bgcolor=color.black, text_color=color.yellow)

//=====================
// ALERTS
//=====================
alertcondition(bullSignal, "Bullish Wickless", "Bullish wickless candle")
alertcondition(bearSignal, "Bearish Wickless", "Bearish wickless candle")
