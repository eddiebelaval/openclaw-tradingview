//@version=6
indicator("RSI Multi-Stock Table - (Pre & Post MKT)-HowlyTr", overlay=true)

// ─── CONFIG ───
rsi_length   = input.int(8, "RSI Length", minval=2)
use_chart_tf = input.bool(true, "Usar timeframe del chart", group="Configuración de Datos")
custom_tf    = input.timeframe("3", "Timeframe personalizado", group="Configuración de Datos")
use_ext_session = input.bool(true, "Incluir Pre/Post Market (Ext)", group="Configuración de Datos")

tf = use_chart_tf ? timeframe.period : custom_tf
session_type = use_ext_session ? session.extended : session.regular

// ─── NIVELES Y COLORES ───
lvl_ob   = input.float(70, "Sobrecompra", group="Niveles")
lvl_ob_w = input.float(60, "Aprox Sobrecompra", group="Niveles")
lvl_os_w = input.float(40, "Aprox Sobreventa", group="Niveles")
lvl_os   = input.float(30, "Sobreventa", group="Niveles")

col_ob   = input.color(color.new(#FF3B3B, 0), "Color Sobrecompra", group="Colores Texto")
col_ob_w = input.color(color.new(#FF8C00, 0), "Color Aprox OB", group="Colores Texto")
col_os_w = input.color(color.new(#A855F7, 0), "Color Aprox OS", group="Colores Texto")
col_os   = input.color(color.new(#00C853, 0), "Color Sobreventa", group="Colores Texto")

col_neu_base = input.color(#B0BEC5, "Color Neutro", group="Colores Texto")
neu_transp   = input.int(0, "Intensidad Color Neutro (0-100)", minval=0, maxval=100, group="Colores Texto")
col_neu      = color.new(col_neu_base, neu_transp)

// ─── TABLA CONFIG (COLORES AZULES COPIADOS) ───
tbl_pos    = input.string("middle_right", "Posición", options=["top_right","top_left","top_center","bottom_right","bottom_left","bottom_center","middle_right","middle_left"])
txt_size   = input.string("large", "Tamaño Letra", options=["tiny","small","normal","large","huge"])

// Paleta de colores de la imagen 1/5/6
color_bg_header = #1a222d // Azul oscuro cabecera
color_bg_body   = #0d1117 // Fondo muy oscuro
color_border    = #30363d // Gris azulado de bordes
color_txt_title = #58a6ff // Azul claro para títulos

// ─── SÍMBOLOS (WMT corregido) ───
sym1 = input.symbol("NASDAQ:AFRM", "S1"), on1 = input.bool(true, "", inline="1")
sym2 = input.symbol("NASDAQ:AMKR", "S2"), on2 = input.bool(true, "", inline="2")
sym3 = input.symbol("NASDAQ:APLD", "S3"), on3 = input.bool(true, "", inline="3")
sym4 = input.symbol("NYSE:BE", "S4"), on4 = input.bool(true, "", inline="4")
sym5 = input.symbol("NYSE:CDE", "S5"), on5 = input.bool(true, "", inline="5")
sym6 = input.symbol("NASDAQ:CIFR", "S6"), on6 = input.bool(true, "", inline="6")
sym7 = input.symbol("NASDAQ:COIN", "S7"), on7 = input.bool(true, "", inline="7")
sym8 = input.symbol("NYSE:CRCL", "S8"), on8 = input.bool(true, "", inline="8")
sym9 = input.symbol("NASDAQ:CRWV", "S9"), on9 = input.bool(true, "", inline="9")
sym10 = input.symbol("NYSE:FIG", "S10"), on10 = input.bool(true, "", inline="10")
sym11 = input.symbol("NASDAQ:GLXY", "S11"), on11 = input.bool(true, "", inline="11")
sym12 = input.symbol("NASDAQ:GTLB", "S12"), on12 = input.bool(true, "", inline="12")
sym13 = input.symbol("NYSE:HIMS", "S13"), on13 = input.bool(true, "", inline="13")
sym14 = input.symbol("NYSE:HL", "S14"), on14 = input.bool(true, "", inline="14")
sym15 = input.symbol("NASDAQ:HOOD", "S15"), on15 = input.bool(true, "", inline="15")
sym16 = input.symbol("NASDAQ:IREN", "S16"), on16 = input.bool(true, "", inline="16")
sym17 = input.symbol("NYSE:IONQ", "S17"), on17 = input.bool(true, "", inline="17")
sym18 = input.symbol("NASDAQ:MSTR", "S18"), on18 = input.bool(true, "", inline="18")
sym19 = input.symbol("NYSE:PL", "S19"), on19 = input.bool(true, "", inline="19")
sym20 = input.symbol("NYSE:QBTS", "S20"), on20 = input.bool(true, "", inline="20")
sym21 = input.symbol("NYSE:RBLX", "S21"), on21 = input.bool(true, "", inline="21")
sym22 = input.symbol("NASDAQ:RGTI", "S22"), on22 = input.bool(true, "", inline="22")
sym23 = input.symbol("NASDAQ:RIOT", "S23"), on23 = input.bool(true, "", inline="23")
sym24 = input.symbol("NASDAQ:RKLB", "S24"), on24 = input.bool(true, "", inline="24")
sym25 = input.symbol("NASDAQ:SHOP", "S25"), on25 = input.bool(true, "", inline="25")
sym26 = input.symbol("NYSE:SMR", "S26"), on26 = input.bool(true, "", inline="26")
sym27 = input.symbol("NASDAQ:TEAM", "S27"), on27 = input.bool(true, "", inline="27")
sym28 = input.symbol("NASDAQ:TPG", "S28"), on28 = input.bool(true, "", inline="28")
sym29 = input.symbol("AMEX:UUUU", "S29"), on29 = input.bool(true, "", inline="29")
sym30 = input.symbol("NASDAQ:VIAV", "S30"), on30 = input.bool(true, "", inline="30")
sym31 = input.symbol("NASDAQ:WULF", "S31"), on31 = input.bool(true, "", inline="31")
sym32 = input.symbol("NASDAQ:Z", "S32"), on32 = input.bool(true, "", inline="32")
sym33 = input.symbol("NYSE:A", "S33"), on33 = input.bool(true, "", inline="33")
sym34 = input.symbol("NYSE:A", "S34"), on34 = input.bool(true, "", inline="34")
sym35 = input.symbol("NYSE:A", "S35"), on35 = input.bool(true, "", inline="35")
sym36 = input.symbol("AMEX:SPY", "S36"), on36 = input.bool(true, "", inline="36")
sym37 = input.symbol("NASDAQ:QQQ", "S37"), on37 = input.bool(true, "", inline="37")
sym38 = input.symbol("AMEX:IWM", "S38"), on38 = input.bool(true, "", inline="38")
sym39 = input.symbol("NASDAQ:NVDA", "S39"), on39 = input.bool(true, "", inline="39")
sym40 = input.symbol("AMEX:SOXL", "S40"), on40 = input.bool(true, "", inline="40")

// ─── LÓGICA RSI ───
f_rsi(sym, is_on) =>
    float res = na
    if is_on
        t_mod = ticker.modify(sym, session=session_type)
        res := request.security(t_mod, tf, ta.rsi(close, rsi_length), lookahead=barmerge.lookahead_on, gaps=barmerge.gaps_off)
    res

rsi1=f_rsi(sym1,on1), rsi2=f_rsi(sym2,on2), rsi3=f_rsi(sym3,on3), rsi4=f_rsi(sym4,on4), rsi5=f_rsi(sym5,on5)
rsi6=f_rsi(sym6,on6), rsi7=f_rsi(sym7,on7), rsi8=f_rsi(sym8,on8), rsi9=f_rsi(sym9,on9), rsi10=f_rsi(sym10,on10)
rsi11=f_rsi(sym11,on11), rsi12=f_rsi(sym12,on12), rsi13=f_rsi(sym13,on13), rsi14=f_rsi(sym14,on14), rsi15=f_rsi(sym15,on15)
rsi16=f_rsi(sym16,on16), rsi17=f_rsi(sym17,on17), rsi18=f_rsi(sym18,on18), rsi19=f_rsi(sym19,on19), rsi20=f_rsi(sym20,on20)
rsi21=f_rsi(sym21,on21), rsi22=f_rsi(sym22,on22), rsi23=f_rsi(sym23,on23), rsi24=f_rsi(sym24,on24), rsi25=f_rsi(sym25,on25)
rsi26=f_rsi(sym26,on26), rsi27=f_rsi(sym27,on27), rsi28=f_rsi(sym28,on28), rsi29=f_rsi(sym29,on29), rsi30=f_rsi(sym30,on30)
rsi31=f_rsi(sym31,on31), rsi32=f_rsi(sym32,on32), rsi33=f_rsi(sym33,on33), rsi34=f_rsi(sym34,on34), rsi35=f_rsi(sym35,on35)
rsi36=f_rsi(sym36,on36), rsi37=f_rsi(sym37,on37), rsi38=f_rsi(sym38,on38), rsi39=f_rsi(sym39,on39), rsi40=f_rsi(sym40,on40)

// ─── HELPERS ───
rsi_color(v) =>
    v >= lvl_ob ? col_ob : v >= lvl_ob_w ? col_ob_w : v <= lvl_os ? col_os : v <= lvl_os_w ? col_os_w : col_neu

clean_sym(s) => str.contains(s, ":") ? str.substring(s, str.pos(s, ":") + 1) : s
rs(v) => na(v) ? "n/a" : str.tostring(math.round(v, 1))

get_size(s) =>
    switch s
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        "huge"   => size.huge
        => size.small

get_pos(p) =>
    switch p
        "top_right"     => position.top_right
        "top_left"      => position.top_left
        "top_center"    => position.top_center
        "bottom_right"  => position.bottom_right
        "bottom_left"   => position.bottom_left
        "bottom_center" => position.bottom_center
        "middle_right"  => position.middle_right
        "middle_left"   => position.middle_left
        => position.top_right

// ─── RENDER ───
var table t = na
if barstate.islast or barstate.isrealtime
    sz = get_size(txt_size)
    t := table.new(get_pos(tbl_pos), 4, 21, bgcolor=color_bg_body, border_width=1, border_color=color_border)
    
    // Headers con azul de títulos
    table.cell(t, 0, 0, "SÍMBOLO", bgcolor=color_bg_header, text_color=color_txt_title, text_size=sz)
    table.cell(t, 1, 0, "RSI", bgcolor=color_bg_header, text_color=color_txt_title, text_size=sz)
    table.cell(t, 2, 0, "SÍMBOLO", bgcolor=color_bg_header, text_color=color_txt_title, text_size=sz)
    table.cell(t, 3, 0, "RSI", bgcolor=color_bg_header, text_color=color_txt_title, text_size=sz)

    // Llenado Columna 1
    s1 = array.from(sym1,sym2,sym3,sym4,sym5,sym6,sym7,sym8,sym9,sym10,sym11,sym12,sym13,sym14,sym15,sym16,sym17,sym18,sym19,sym20)
    o1 = array.from(on1,on2,on3,on4,on5,on6,on7,on8,on9,on10,on11,on12,on13,on14,on15,on16,on17,on18,on19,on20)
    v1 = array.from(rsi1,rsi2,rsi3,rsi4,rsi5,rsi6,rsi7,rsi8,rsi9,rsi10,rsi11,rsi12,rsi13,rsi14,rsi15,rsi16,rsi17,rsi18,rsi19,rsi20)

    r1 = 1
    for i = 0 to 19
        if array.get(o1, i)
            val = array.get(v1, i)
            table.cell(t, 0, r1, clean_sym(array.get(s1, i)), text_color=color.white, text_size=sz)
            table.cell(t, 1, r1, rs(val), text_color=rsi_color(val), text_size=sz)
            r1 := r1 + 1

    // Llenado Columna 2
    s2 = array.from(sym21,sym22,sym23,sym24,sym25,sym26,sym27,sym28,sym29,sym30,sym31,sym32,sym33,sym34,sym35,sym36,sym37,sym38,sym39,sym40)
    o2 = array.from(on21,on22,on23,on24,on25,on26,on27,on28,on29,on30,on31,on32,on33,on34,on35,on36,on37,on38,on39,on40)
    v2 = array.from(rsi21,rsi22,rsi23,rsi24,rsi25,rsi26,rsi27,rsi28,rsi29,rsi30,rsi31,rsi32,rsi33,rsi34,rsi35,rsi36,rsi37,rsi38,rsi39,rsi40)

    r2 = 1
    for i = 0 to 19
        if array.get(o2, i)
            val = array.get(v2, i)
            table.cell(t, 2, r2, clean_sym(array.get(s2, i)), text_color=color.white, text_size=sz)
            table.cell(t, 3, r2, rs(val), text_color=rsi_color(val), text_size=sz)
            r2 := r2 + 1
