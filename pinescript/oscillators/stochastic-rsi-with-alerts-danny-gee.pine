//@version=6
indicator(title="Stochastic RSI", shorttitle="Stoch RSI", format=format.price, precision=2, timeframe="", timeframe_gaps=true)

smoothK     = input.int(3,  "K",                 minval=1)
smoothD     = input.int(3,  "D",                 minval=1)
lengthRSI   = input.int(14, "RSI Length",        minval=1)
lengthStoch = input.int(14, "Stochastic Length", minval=1)
src         = input(close,  title="RSI Source")

GRP = "Zone Signals"
showCrossColour     = input.bool(true,  "Colour candle when entering extreme zone", group=GRP)
bullColour          = input.color(color.new(color.lime, 0),   "Buy zone colour (below 20)",          group=GRP)
bearColour          = input.color(color.new(color.red,  0),   "Sell zone colour (above 80)",         group=GRP)
showExitColour      = input.bool(true,  "Colour candle when exiting extreme zone",  group=GRP)
bullExitColour      = input.color(color.new(color.aqua,   0), "Exit oversold colour (K crosses 20)", group=GRP)
bearExitColour      = input.color(color.new(color.orange, 0), "Exit overbought colour (K crosses 80)", group=GRP)

rsi1 = ta.rsi(src, lengthRSI)
k    = ta.sma(ta.stoch(rsi1, rsi1, rsi1, lengthStoch), smoothK)
d    = ta.sma(k, smoothD)

// Entry — K first crosses into zone
enterOverbought = k > 80 and k[1] <= 80
enterOversold   = k < 20 and k[1] >= 20

// Exit — K first crosses back out of zone
exitOverbought  = k < 80 and k[1] >= 80
exitOversold    = k > 20 and k[1] <= 20

barcolor(
  showCrossColour and enterOverbought ? bearColour     :
  showCrossColour and enterOversold   ? bullColour     :
  showExitColour  and exitOverbought  ? bearExitColour :
  showExitColour  and exitOversold    ? bullExitColour : na)

plot(k, "K", color=#2962FF)
plot(d, "D", color=#FF6D00)
h0 = hline(80, "Upper Band", color=#787B86)
hline(50, "Middle Band", color=color.new(#787B86, 50))
h1 = hline(20, "Lower Band", color=#787B86)
fill(h0, h1, color=color.rgb(33, 150, 243, 90), title="Background")

plotshape(enterOverbought, title="Overbought - Look for Sells", location=location.top,    style=shape.triangledown, color=color.red,  size=size.small, text="SELL")
plotshape(enterOversold,   title="Oversold - Look for Buys",   location=location.bottom, style=shape.triangleup,   color=color.lime, size=size.small, text="BUY")

alertcondition(enterOverbought, title='Stoch RSI Overbought - Look for Sells',  message='Stoch RSI entered overbought zone — look for sell FVG')
alertcondition(enterOversold,   title='Stoch RSI Oversold - Look for Buys',     message='Stoch RSI entered oversold zone — look for buy FVG')
alertcondition(exitOverbought,  title='Stoch RSI Exited Overbought',            message='Stoch RSI exited overbought zone — momentum may be fading')
alertcondition(exitOversold,    title='Stoch RSI Exited Oversold',              message='Stoch RSI exited oversold zone — momentum may be fading')
