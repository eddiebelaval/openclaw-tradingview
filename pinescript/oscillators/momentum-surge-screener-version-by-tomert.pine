//@version=5
indicator("Momentum Surge - Screener Version By Tomer.T", overlay=true)

// --- Settings ---
ema50 = ta.ema(close, 50)
ema20 = ta.ema(close, 20)
rsi = ta.rsi(close, 14)
[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
avgVol = ta.sma(volume, 20)

// --- Logic ---
longSignal = (close > ema50) and (close > ema20) and (rsi > 50 and rsi < 70) and ta.crossover(macdLine, signalLine) and (volume > avgVol)

// --- Data for Screener ---
// We plot '1' when the signal is active, '0' when it is not.
plot(longSignal ? 1 : 0, title="LongSignalData", display=display.none)

// Visuals for your chart
plot(ema50, color=color.blue, title="EMA 50")
plot(ema20, color=color.orange, title="EMA 20")
plotshape(longSignal, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
