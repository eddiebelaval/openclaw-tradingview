//@version=5
indicator("Raschke 3-10-16 Master - Fixed SL/TP", overlay=true)

// --- Time Filter ---
forbiddenWindow = time(timeframe.period, "1100-1400:1234567")
canTrade = na(forbiddenWindow)

// --- Indicators ---
vwapValue = ta.vwap(hlc3)
ema9 = ta.ema(close, 9)
fastMA = ta.ema(close, 3)
slowMA = ta.ema(close, 10)
macdLine = fastMA - slowMA
signalLine = ta.sma(macdLine, 16) 

// --- Entry Logic ---
buySignal  = ta.crossover(close, ema9) and ta.crossover(macdLine, signalLine) and close > vwapValue and canTrade
sellSignal = ta.crossunder(close, ema9) and ta.crossunder(macdLine, signalLine) and close < vwapValue and canTrade

// --- Logic to Track and Terminate Levels ---
var float slLevel = na
var float tpLevel = na
var int activeDir = 0 

// 1. Update levels when a NEW signal occurs
if buySignal
    slLevel := low
    tpLevel := close + ((close - low) * 3)
    activeDir := 1
else if sellSignal
    slLevel := high
    tpLevel := close - ((high - close) * 3)
    activeDir := -1

// 2. Check for hits ONLY if we aren't on the signal bar (prevents instant deletion)
if not (buySignal or sellSignal)
    if activeDir == 1 // Long
        if low <= slLevel or high >= tpLevel
            slLevel := na
            tpLevel := na
            activeDir := 0
    else if activeDir == -1 // Short
        if high >= slLevel or low <= tpLevel
            slLevel := na
            tpLevel := na
            activeDir := 0

// --- Visuals ---
plot(vwapValue, color=color.new(color.orange, 0), title="VWAP", linewidth=2)
plot(ema9, color=color.new(#2962FF, 0), title="9 EMA")

// Signal Dots
plotshape(buySignal, style=shape.circle, location=location.belowbar, color=color.green, size=size.tiny, title="Buy Signal")
plotshape(sellSignal, style=shape.circle, location=location.abovebar, color=color.red, size=size.tiny, title="Sell Signal")

// SL and TP Lines - style_linebr is key here
plot(slLevel, color=color.new(color.red, 40), style=plot.style_linebr, linewidth=2, title="Stop Loss Level")
plot(tpLevel, color=color.new(color.green, 40), style=plot.style_linebr, linewidth=2, title="Take Profit Level")

// Lunch Filter Shading
bgFill = not canTrade ? color.new(color.red, 95) : na
bgcolor(bgFill, title="Lunch Break Highlight")
