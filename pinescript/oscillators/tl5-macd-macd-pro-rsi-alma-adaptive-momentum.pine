//@version=6
//──────────────────────────────────────────────────────────────────────────────
//  [TL5 MACD] MACD Pro – RSI + ALMA Adaptive Momentum
//──────────────────────────────────────────────────────────────────────────────
//  Author      : AquaTickTrader
//  Version     : 1.0
//  Pine Script : v6
//──────────────────────────────────────────────────────────────────────────────
//
//  OVERVIEW
//  TL5 MACD Pro is a structurally enhanced MACD integrating:
//
//   • RSI(14) 50-level momentum bias
//   • WMA-smoothed RSI confirmation
//   • ALMA(30) adaptive trend filter
//   • SMA(8) short-term momentum alignment
//   • Dynamic MACD & Signal coloring
//
//  Core MACD math remains standard.
//  No repainting logic is used.
//
//  NOTE:
//  Dual bgcolor() is intentional:
//   - One colors the indicator pane
//   - One colors the main price chart (force_overlay)
//──────────────────────────────────────────────────────────────────────────────

indicator("[TL5 MACD] MACD Pro – RSI + ALMA Adaptive Momentum", timeframe = "", timeframe_gaps = true)

//──────────────────────────────────────────────────────────────────────────────
// INPUT GROUPS
//──────────────────────────────────────────────────────────────────────────────

// MACD Settings
groupMACD = "MACD Settings"

sourceInput  = input.source(close, "Source", group = groupMACD)
fastLenInput = input.int(12, "Fast Length",   minval = 1, group = groupMACD)
slowLenInput = input.int(26, "Slow Length",   minval = 1, group = groupMACD)
sigLenInput  = input.int(9,  "Signal Length", minval = 1, group = groupMACD)

oscTypeInput = input.string("EMA", "Oscillator MA Type", ["EMA", "SMA"], group = groupMACD)
sigTypeInput = input.string("EMA", "Signal MA Type",     ["EMA", "SMA"], group = groupMACD)


// Display Settings
groupDisplay = "Display Settings"

showHistogram    = input.bool(false,  "Show Histogram", group = groupDisplay)
showSMA8         = input.bool(false, "Show SMA(8) on Chart", group = groupDisplay)
showALMA30       = input.bool(false, "Show ALMA(30) on Chart", group = groupDisplay)
colorZeroByTrend = input.bool(true,  "Color Zero Line by ALMA Trend", group = groupDisplay)


// RSI Bias Settings
groupRSI = "RSI Bias Settings"

showRSIBgPane  = input.bool(true,  "Show RSI Bias (Indicator Pane)", group = groupRSI)
showRSIBgChart = input.bool(false, "Show RSI Bias (Main Chart Overlay)", group = groupRSI)


//──────────────────────────────────────────────────────────────────────────────
// RSI (Momentum Bias)
//──────────────────────────────────────────────────────────────────────────────

rsi    = ta.rsi(close, 14)
wmarsi = ta.wma(rsi, 14)

rsiColor =
     rsi > 50 ? color.new(color.lime, 85) :
     rsi < 50 ? color.new(color.red, 85)  :
     na

// Indicator pane background
bgcolor(showRSIBgPane ? rsiColor : na)

// Main chart background (intentional duplicate with force_overlay)
bgcolor(showRSIBgChart ? rsiColor : na, force_overlay = true, title = "Bgcolor on main chart")


//──────────────────────────────────────────────────────────────────────────────
// STRUCTURE MOVING AVERAGES
//──────────────────────────────────────────────────────────────────────────────

// Short-term momentum
sma8 = ta.sma(close, 8)

// Adaptive trend filter
alma30 = ta.alma(close, 30, 0.85, 8)

// Optional overlays
plot(showSMA8 ? sma8 : na,
     title = "SMA 8",
     color = sma8 > sma8[1] ? color.green : color.red,
     linewidth = 2,
     linestyle = plot.linestyle_dotted,
     force_overlay = true)

plot(showALMA30 ? alma30 : na,
     title = "ALMA 30",
     color = alma30 > alma30[1] ? color.blue : color.red,
     linewidth = 2,
     force_overlay = true)


//──────────────────────────────────────────────────────────────────────────────
// MOVING AVERAGE FUNCTION
//──────────────────────────────────────────────────────────────────────────────

ma(float source, int length, string maType) =>
    switch maType
        "EMA" => ta.ema(source, length)
        "SMA" => ta.sma(source, length)


//──────────────────────────────────────────────────────────────────────────────
// MACD CALCULATION (Standard Formula)
//──────────────────────────────────────────────────────────────────────────────

maFast = ma(sourceInput, fastLenInput, oscTypeInput)
maSlow = ma(sourceInput, slowLenInput, oscTypeInput)

macd   = maFast - maSlow
signal = ma(macd, sigLenInput, sigTypeInput)
hist   = macd - signal


//──────────────────────────────────────────────────────────────────────────────
// HISTOGRAM COLOR LOGIC
//──────────────────────────────────────────────────────────────────────────────

hColor =
     hist >= 0 ?
         hist > hist[1] ? #26a69a : #b2dfdb :
         hist > hist[1] ? #ffcdd2 : #ff5252


//──────────────────────────────────────────────────────────────────────────────
// ZERO LINE
//──────────────────────────────────────────────────────────────────────────────

plot(0,
     title = "Zero Line",
     color = colorZeroByTrend
         ? (alma30 > alma30[1] ? color.blue : color.red)
         : color.gray,
     linewidth = 2,
     linestyle = plot.linestyle_dotted)


//──────────────────────────────────────────────────────────────────────────────
// MACD & SIGNAL COLOR LOGIC
//──────────────────────────────────────────────────────────────────────────────

macdColor =
     sma8 > sma8[1] and sma8 > alma30 and wmarsi > wmarsi[1] ? color.blue :
     sma8 < sma8[1] and sma8 < alma30 and wmarsi < wmarsi[1] ? color.red :
     sma8 > sma8[1] ? color.green :
     sma8 < sma8[1] ? color.fuchsia :
     color.gray

signalColor =
     wmarsi > wmarsi[1] and sma8 > alma30 ? color.green :
     wmarsi < wmarsi[1] and sma8 < alma30 ? color.red :
     color.gray


//──────────────────────────────────────────────────────────────────────────────
// PLOTS
//──────────────────────────────────────────────────────────────────────────────

plot(showHistogram ? hist : na,
     title = "Histogram",
     color = hColor,
     style = plot.style_columns)

plot(macd,
     title = "MACD",
     color = macdColor,
     linestyle = plot.linestyle_dotted,
     linewidth = 3)

plot(signal,
     title = "Signal",
     color = signalColor,
     linestyle = plot.linestyle_solid,
     linewidth = 2)

//──────────────────────────────────────────────────────────────────────────────
// END
//──────────────────────────────────────────────────────────────────────────────
