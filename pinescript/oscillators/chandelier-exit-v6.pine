//@version=6
indicator("Chandelier Exit 纯净稳定版 v6", shorttitle="CE_CLEAN_V6", overlay=true)

//========================= 参数区 =========================
group_ce   = "Chandelier 参数"
group_flt  = "过滤条件"
group_disp = "显示设置"
group_col  = "颜色设置"

ceLen            = input.int(22, "CE Length", minval=1, group=group_ce)
atrLen           = input.int(22, "ATR Length", minval=1, group=group_ce)
atrMult          = input.float(3.0, "ATR Multiplier", minval=0.1, step=0.1, group=group_ce)
useCloseExtremes = input.bool(false, "极值使用收盘价", group=group_ce)

useTrendFilter = input.bool(true, "启用 EMA 趋势过滤", group=group_flt)
emaLen         = input.int(20, "EMA 长度", minval=1, group=group_flt)

useVolFilter   = input.bool(false, "启用放量过滤", group=group_flt)
volMaLen       = input.int(20, "成交量均线长度", minval=1, group=group_flt)
volMult        = input.float(1.2, "放量倍数", minval=0.1, step=0.1, group=group_flt)

showLongLine   = input.bool(true, "显示 Long Exit", group=group_disp)
showShortLine  = input.bool(true, "显示 Short Exit", group=group_disp)
showSignals    = input.bool(true, "显示买卖箭头", group=group_disp)
showBg         = input.bool(true, "显示趋势背景色", group=group_disp)
showEMA        = input.bool(true, "显示 EMA 过滤线", group=group_disp)
lineWidth      = input.int(2, "线宽", minval=1, maxval=5, group=group_disp)

colLongLine    = input.color(color.lime, "Long Exit 颜色", group=group_col)
colShortLine   = input.color(color.orange, "Short Exit 颜色", group=group_col)
colEmaLine     = input.color(color.blue, "EMA 颜色", group=group_col)
colBullBg      = input.color(color.new(color.green, 88), "多头背景色", group=group_col)
colBearBg      = input.color(color.new(color.red, 88), "空头背景色", group=group_col)
colBuySignal   = input.color(color.lime, "买点箭头颜色", group=group_col)
colSellSignal  = input.color(color.red, "卖点箭头颜色", group=group_col)

//========================= 核心计算 =========================
highestSrc = useCloseExtremes ? close : high
lowestSrc  = useCloseExtremes ? close : low

hh  = ta.highest(highestSrc, ceLen)
ll  = ta.lowest(lowestSrc, ceLen)
atr = ta.atr(atrLen)

longRaw  = hh - atrMult * atr
shortRaw = ll + atrMult * atr

var float longCE  = na
var float shortCE = na

// longCE 只上移不下移
longCE := na(longCE[1]) ? longRaw : (close[1] > longCE[1] ? math.max(longRaw, longCE[1]) : longRaw)

// shortCE 只下移不上移
shortCE := na(shortCE[1]) ? shortRaw : (close[1] < shortCE[1] ? math.min(shortRaw, shortCE[1]) : shortRaw)

//========================= 过滤条件 =========================
emaBase = ta.ema(close, emaLen)
volMA   = ta.sma(volume, volMaLen)

trendLongOk  = not useTrendFilter or close > emaBase
trendShortOk = not useTrendFilter or close < emaBase

volLongOk  = not useVolFilter or volume > volMA * volMult
volShortOk = not useVolFilter or volume > volMA * volMult

//========================= 趋势状态 =========================
var int trendState = 0

bullBreak = close > shortCE[1]
bearBreak = close < longCE[1]

if bullBreak
    trendState := 1
else if bearBreak
    trendState := -1
else
    trendState := nz(trendState[1], 0)

//========================= 信号逻辑 =========================
buySignal  = ta.crossover(close, shortCE) and trendLongOk and volLongOk
sellSignal = ta.crossunder(close, longCE) and trendShortOk and volShortOk

//========================= 绘图 =========================
plot(showLongLine ? longCE : na, "Long Exit", color=colLongLine, linewidth=lineWidth)
plot(showShortLine ? shortCE : na, "Short Exit", color=colShortLine, linewidth=lineWidth)
plot(showEMA and useTrendFilter ? emaBase : na, "EMA Filter", color=colEmaLine, linewidth=1)

bgcolor(showBg ? (trendState == 1 ? colBullBg : trendState == -1 ? colBearBg : na) : na)

plotshape(showSignals and buySignal, title="Buy Signal", style=shape.triangleup, location=location.belowbar, color=colBuySignal, size=size.small)
plotshape(showSignals and sellSignal, title="Sell Signal", style=shape.triangledown, location=location.abovebar, color=colSellSignal, size=size.small)

//========================= 报警条件 =========================
alertcondition(buySignal, title="CE 买点", message="Chandelier Exit 买点信号：价格上穿 Short Exit。")
alertcondition(sellSignal, title="CE 卖点", message="Chandelier Exit 卖点信号：价格下穿 Long Exit。")

alertcondition(ta.crossover(close, shortCE), title="价格上穿 Short Exit", message="价格上穿 Short Exit。")
alertcondition(ta.crossunder(close, longCE), title="价格下穿 Long Exit", message="价格下穿 Long Exit。")
