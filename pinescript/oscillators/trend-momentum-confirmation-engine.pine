//@version=6
indicator("Trend Momentum Confirmation Engine", shorttitle="TM Confirm", overlay=true)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MODULES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
grpModules = "Modules"
enableTrendModule = input.bool(true, "Enable Trend module", group=grpModules)
enableAOModule    = input.bool(true, "Enable AO module", group=grpModules)
enableADXModule   = input.bool(true, "Enable ADX module", group=grpModules)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SHARED VISUAL SETTINGS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
grpVisual = "Shared Visual Settings"
showBg         = input.bool(true, "Show background", group=grpVisual)
bgOpacity      = input.int(80, "Background opacity (0-100)", minval=0, maxval=100, group=grpVisual)
showGuideLine  = input.bool(false, "Show trend guide line", group=grpVisual)
guideLineWidth = input.int(2, "Guide line width", minval=1, maxval=5, group=grpVisual)
showArrows     = input.bool(true, "Show arrows", group=grpVisual)

grpColors = "Shared Colors"
bullBgColor    = input.color(color.rgb(0, 140, 0), "Bull background", group=grpColors)
bearBgColor    = input.color(color.rgb(120, 0, 0), "Bear background", group=grpColors)
bullLineColor  = input.color(color.rgb(60, 255, 60), "Bull guide", group=grpColors)
bearLineColor  = input.color(color.rgb(255, 70, 70), "Bear guide", group=grpColors)
bullArrowColor = input.color(color.rgb(120, 255, 80), "LONG arrow", group=grpColors)
bearArrowColor = input.color(color.rgb(255, 90, 90), "SHORT arrow", group=grpColors)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TREND MODULE (Supertrend)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
grpTrend = "Trend Settings"
atrPeriod = input.int(10, "Core Length", minval=1, group=grpTrend)
factor    = input.float(3.0, "Sensitivity", minval=0.01, step=0.01, group=grpTrend)

[guideValueRaw, state] = ta.supertrend(factor, atrPeriod)
float guideValue = barstate.isfirst ? na : guideValueRaw

bool trendLongEvent  = enableTrendModule and state[1] > state
bool trendShortEvent = enableTrendModule and state[1] < state

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// AO MODULE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
grpAO = "AO Settings"
showZeroCross        = input.bool(true, "Show arrows on AO zero cross", group=grpAO)
enableThreeToZero    = input.bool(true, "Enable 3→0 AFTER reversal arrows", group=grpAO)
threeToZeroOnNextBar = input.bool(false, "Place 3→0 arrow on next bar", group=grpAO)

float medianPrice = (high + low) / 2.0
float ao = ta.sma(medianPrice, 5) - ta.sma(medianPrice, 34)

bool longZeroRaw  = ta.crossover(ao, 0)
bool shortZeroRaw = ta.crossunder(ao, 0)

bool towardZeroBull = (ao < 0) and (ao > ao[1]) and (ao[1] > ao[2])
bool towardZeroBear = (ao > 0) and (ao < ao[1]) and (ao[1] < ao[2])

bool wasAwayBull = (ao < 0) and (ao[3] > ao[2])
bool wasAwayBear = (ao > 0) and (ao[3] < ao[2])

bool long3Raw  = enableThreeToZero and towardZeroBull and wasAwayBull
bool short3Raw = enableThreeToZero and towardZeroBear and wasAwayBear

bool long3Event  = threeToZeroOnNextBar ? long3Raw[1] : long3Raw
bool short3Event = threeToZeroOnNextBar ? short3Raw[1] : short3Raw

bool aoLongEvent  = enableAOModule and ((showZeroCross and longZeroRaw) or long3Event)
bool aoShortEvent = enableAOModule and ((showZeroCross and shortZeroRaw) or short3Event)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ADX MODULE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
grpAdx = "ADX Settings"
adxLen       = input.int(14, "ADX Smoothing", minval=1, group=grpAdx)
diLen        = input.int(14, "DI Length", minval=1, group=grpAdx)
adxMinLevel  = input.float(20.0, "ADX minimum level", step=0.1, group=grpAdx)
requireDiDirection = input.bool(true, "Require DI direction filter", group=grpAdx)

dirmov(len) =>
    float up = ta.change(high)
    float down = -ta.change(low)
    float plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
    float minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    float tr = ta.rma(ta.tr, len)
    float plus = fixnan(100 * ta.rma(plusDM, len) / tr)
    float minus = fixnan(100 * ta.rma(minusDM, len) / tr)
    [plus, minus]

adxCalc(dilen, adxlen) =>
    [plus, minus] = dirmov(dilen)
    float sum = plus + minus
    float adxv = 100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), adxlen)
    adxv

[plusDI, minusDI] = dirmov(diLen)
float adxValue = adxCalc(diLen, adxLen)

bool adxPass = adxValue >= adxMinLevel
bool diBullPass = not requireDiDirection or (plusDI > minusDI)
bool diBearPass = not requireDiDirection or (minusDI > plusDI)

bool adxLongEvent  = enableADXModule and adxPass and diBullPass
bool adxShortEvent = enableADXModule and adxPass and diBearPass

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// COMBINED SIGNAL LOGIC
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
grpCombo = "Combined Signal Logic"
confirmWindowBars = input.int(3, "Confirmation window (bars)", minval=0, group=grpCombo)

bool recentLongTrend  = ta.barssince(trendLongEvent) <= confirmWindowBars
bool recentShortTrend = ta.barssince(trendShortEvent) <= confirmWindowBars

bool recentLongAO  = ta.barssince(aoLongEvent) <= confirmWindowBars
bool recentShortAO = ta.barssince(aoShortEvent) <= confirmWindowBars

bool recentLongADX  = ta.barssince(adxLongEvent) <= confirmWindowBars
bool recentShortADX = ta.barssince(adxShortEvent) <= confirmWindowBars

int enabledModulesCount = 0
if enableTrendModule
    enabledModulesCount += 1
if enableAOModule
    enabledModulesCount += 1
if enableADXModule
    enabledModulesCount += 1

bool combinedLongSetup = enabledModulesCount > 0
bool combinedShortSetup = enabledModulesCount > 0

if enableTrendModule
    combinedLongSetup := combinedLongSetup and recentLongTrend
    combinedShortSetup := combinedShortSetup and recentShortTrend

if enableAOModule
    combinedLongSetup := combinedLongSetup and recentLongAO
    combinedShortSetup := combinedShortSetup and recentShortAO

if enableADXModule
    combinedLongSetup := combinedLongSetup and recentLongADX
    combinedShortSetup := combinedShortSetup and recentShortADX

bool combinedLongSignal = combinedLongSetup and not combinedLongSetup[1]
bool combinedShortSignal = combinedShortSetup and not combinedShortSetup[1]

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// COMBINED BIAS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var int bias = 0
if combinedLongSignal
    bias := 1
if combinedShortSignal
    bias := -1

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VISUAL OUTPUT
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
color bgColor = na
if showBg and enabledModulesCount > 0
    if bias == 1
        bgColor := color.new(bullBgColor, bgOpacity)
    else if bias == -1
        bgColor := color.new(bearBgColor, bgOpacity)
    else
        bgColor := na
else
    bgColor := na

bgcolor(bgColor)

float bullGuide = na
float bearGuide = na

if enableTrendModule and showGuideLine
    if bias == 1
        bullGuide := guideValue
    else if bias == -1
        bearGuide := guideValue

plot(bullGuide, title="Bull Guide", color=bullLineColor, linewidth=guideLineWidth, style=plot.style_linebr)
plot(bearGuide, title="Bear Guide", color=bearLineColor, linewidth=guideLineWidth, style=plot.style_linebr)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FINAL ARROWS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
plotshape(
     showArrows and combinedLongSignal,
     title="Combined LONG",
     style=shape.triangleup,
     location=location.belowbar,
     size=size.small,
     color=bullArrowColor)

plotshape(
     showArrows and combinedShortSignal,
     title="Combined SHORT",
     style=shape.triangledown,
     location=location.abovebar,
     size=size.small,
     color=bearArrowColor)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ALERTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
alertcondition(combinedLongSignal, title="Combined LONG", message="Combined LONG | {{ticker}} {{interval}} @ {{close}}")
alertcondition(combinedShortSignal, title="Combined SHORT", message="Combined SHORT | {{ticker}} {{interval}} @ {{close}}")
alertcondition(combinedLongSignal or combinedShortSignal, title="Combined Direction Change", message="Combined direction changed | {{ticker}} {{interval}} @ {{close}}")
