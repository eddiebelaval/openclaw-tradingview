//@version=6
indicator("3D RSI [UAlgo]", overlay=false, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_polylines_count=100)

// -----------------------------------------------------------------------------
// Constants & Inputs
// -----------------------------------------------------------------------------
grp_sett = "Settings"
grp_vis  = "Visuals"
grp_div  = "3D Divergence"

int LEN = input.int(14, "RSI Length", group=grp_sett)
float THICKNESS = input.float(2.0, "3D Thickness", step=0.1, group=grp_sett)

// Gradient Colors
color COL_OS = input.color(#00E5FF, "Oversold Color (Low)", group=grp_vis) // Cyan
color COL_OB = input.color(#FF0055, "Overbought Color (High)", group=grp_vis) // Magenta

// Divergence Settings
bool SHOW_DIV = input.bool(true, "Show 3D Divergence", group=grp_div)
int DIV_LB = input.int(5, "Pivot Lookback Left", group=grp_div)
int DIV_RB = input.int(5, "Pivot Lookback Right", group=grp_div)
color COL_DIV_BEAR = input.color(color.new(#ff0000, 20), "Bearish Div 3D", group=grp_div)
color COL_DIV_BULL = input.color(color.new(#00ff00, 20), "Bullish Div 3D", group=grp_div)

// -----------------------------------------------------------------------------
// Types
// -----------------------------------------------------------------------------
type RSIPoint
    int index
    float value
    float upper
    float lower

type PivotPoint
    int index
    float price
    float rsi_val
    float rsi_upper
    float rsi_lower

type RSI3D
    int length
    float thickness
    RSIPoint[] history
    line[] lines_upper
    line[] lines_lower
    line[] lines_vert
    linefill[] fills
    label current_label
    int last_drawn_index
    PivotPoint last_ph
    PivotPoint last_pl

// -----------------------------------------------------------------------------
// Methods & Functions
// -----------------------------------------------------------------------------

method init(RSI3D this, int len, float thick) =>
    this.length := len
    this.thickness := thick
    this.history := array.new<RSIPoint>()
    this.lines_upper := array.new<line>()
    this.lines_lower := array.new<line>()
    this.lines_vert := array.new<line>()
    this.fills := array.new<linefill>()
    this.current_label := label.new(na, na, "", xloc=xloc.bar_index, style=label.style_none, textcolor=color.white)
    this.last_drawn_index := -1

// Helper function to draw 3D bridge
draw_bridge(RSI3D this, PivotPoint p1, PivotPoint p2, bool is_bullish) =>
    color baseCol = is_bullish ? COL_DIV_BULL : COL_DIV_BEAR
    float y1 = is_bullish ? p1.rsi_lower : p1.rsi_upper
    float y2 = is_bullish ? p2.rsi_lower : p2.rsi_upper
    
    // Top/Bottom edges
    line.new(p1.index, y1, p2.index, y2, color=baseCol, width=1, style=line.style_dashed)
    
    // 3D thickness line
    float y1_inner = is_bullish ? p1.rsi_val : p1.rsi_val 
    float y2_inner = is_bullish ? p2.rsi_val : p2.rsi_val
    line l2 = line.new(p1.index, y1_inner, p2.index, y2_inner, color=color.new(baseCol, 50), width=1)
    
    // Vertical pillars
    line.new(p1.index, y1, p1.index, y1_inner, color=baseCol)
    line.new(p2.index, y2, p2.index, y2_inner, color=baseCol)
    
    // Label
    label.new(int(math.avg(p1.index, p2.index)), math.avg(y1, y2), is_bullish ? "Bull Div" : "Bear Div", 
             xloc=xloc.bar_index, yloc=yloc.price, color=color.new(baseCol, 100), style=label.style_none, textcolor=baseCol, size=size.small)

method update_data(RSI3D this, float src) =>
    float rsiVal = ta.rsi(src, LEN)
    
    if not na(rsiVal)
        float upperVal = rsiVal + this.thickness
        float lowerVal = rsiVal - this.thickness
        RSIPoint newPoint = RSIPoint.new(bar_index, rsiVal, upperVal, lowerVal)
        
        // Manage History
        if this.history.size() > 0
            RSIPoint lastPoint = this.history.get(this.history.size() - 1)
            if lastPoint.index == bar_index
                this.history.set(this.history.size() - 1, newPoint)
            else
                this.history.push(newPoint)
        else
            this.history.push(newPoint)
            
        if this.history.size() > 1000
            this.history.shift()
        
        // --------------------------------------
        // 3D DIVERGENCE LOGIC
        // --------------------------------------
        if SHOW_DIV
            float ph_rsi_val = ta.pivothigh(rsiVal, DIV_LB, DIV_RB)
            float pl_rsi_val = ta.pivotlow(rsiVal, DIV_LB, DIV_RB)
            int pivot_idx = bar_index - DIV_RB
            
            if not na(ph_rsi_val)
                float ph_price = high[DIV_RB]
                float ph_upper = ph_rsi_val + this.thickness
                float ph_lower = ph_rsi_val - this.thickness
                PivotPoint curr_ph = PivotPoint.new(pivot_idx, ph_price, ph_rsi_val, ph_upper, ph_lower)
                if not na(this.last_ph)
                    if curr_ph.price > this.last_ph.price and curr_ph.rsi_val < this.last_ph.rsi_val
                        draw_bridge(this, this.last_ph, curr_ph, false)
                this.last_ph := curr_ph

            if not na(pl_rsi_val)
                float pl_price = low[DIV_RB]
                float pl_upper = pl_rsi_val + this.thickness
                float pl_lower = pl_rsi_val - this.thickness
                PivotPoint curr_pl = PivotPoint.new(pivot_idx, pl_price, pl_rsi_val, pl_upper, pl_lower)
                if not na(this.last_pl)
                    if curr_pl.price < this.last_pl.price and curr_pl.rsi_val > this.last_pl.rsi_val
                        draw_bridge(this, this.last_pl, curr_pl, true)
                this.last_pl := curr_pl

method draw(RSI3D this) =>
    if this.history.size() >= 2
        int idx_curr = this.history.size() - 1
        int idx_prev = this.history.size() - 2
        RSIPoint p2 = this.history.get(idx_curr)
        RSIPoint p1 = this.history.get(idx_prev)
        
        color c_curr = color.from_gradient(p2.value, 30, 70, COL_OS, COL_OB)
        color colorTop = c_curr
        color colorBot = color.new(c_curr, 50) 
        color colorFill = color.new(c_curr, 60) 
        color colorVert = color.new(c_curr, 40)
        
        bool need_new = p2.index > this.last_drawn_index
        
        if need_new
            line l_up = line.new(p1.index, p1.upper, p2.index, p2.upper, color=colorTop, width=2)
            line l_dn = line.new(p1.index, p1.lower, p2.index, p2.lower, color=colorBot, width=1)
            line l_v = line.new(p2.index, p2.upper, p2.index, p2.lower, color=colorVert, width=1) 
            linefill lf = linefill.new(l_up, l_dn, color=colorFill)
            
            this.lines_upper.push(l_up)
            this.lines_lower.push(l_dn)
            this.lines_vert.push(l_v)
            this.fills.push(lf)
            this.last_drawn_index := p2.index
        else
            if this.lines_upper.size() > 0
                int last_idx = this.lines_upper.size() - 1
                line l_up = this.lines_upper.get(last_idx)
                line l_dn = this.lines_lower.get(last_idx)
                line l_v = this.lines_vert.get(last_idx)
                linefill lf = this.fills.get(last_idx)
                
                l_up.set_xy1(p1.index, p1.upper)
                l_up.set_xy2(p2.index, p2.upper)
                l_up.set_color(colorTop)
                l_dn.set_xy1(p1.index, p1.lower)
                l_dn.set_xy2(p2.index, p2.lower)
                l_dn.set_color(colorBot)
                l_v.set_xy1(p2.index, p2.upper)
                l_v.set_xy2(p2.index, p2.lower)
                l_v.set_color(colorVert)
                
                linefill.delete(lf)
                this.fills.set(last_idx, linefill.new(l_up, l_dn, color=colorFill))

        // Cleanup Ribbon only
        if this.lines_upper.size() > 480 
            line.delete(this.lines_upper.shift())
            line.delete(this.lines_lower.shift())
            line.delete(this.lines_vert.shift())
            linefill.delete(this.fills.shift())

        // Label update
        this.current_label.set_xy(p2.index + 1, p2.value)
        this.current_label.set_text(str.tostring(p2.value, "#.0"))
        this.current_label.set_textcolor(c_curr)
        this.current_label.set_style(label.style_none)

// -----------------------------------------------------------------------------
// Execution
// -----------------------------------------------------------------------------

var RSI3D rsi3d = RSI3D.new()

if barstate.isfirst
    rsi3d.init(LEN, THICKNESS)

rsi3d.update_data(close)
rsi3d.draw()

// -----------------------------------------------------------------------------
// Visuals & Base RSI Plot
// -----------------------------------------------------------------------------

// 1. PLOT STANDARD RSI (Shows everywhere, even where 3D ribbon is deleted)
rsiVal = ta.rsi(close, LEN)
plot(rsiVal, "RSI Base", color=color.new(color.gray, 50), linewidth=1)

// 2. Levels
hline(70, "OB Level", color=color.new(color.gray, 50), linestyle=hline.style_dashed)
hline(30, "OS Level", color=color.new(color.gray, 50), linestyle=hline.style_dashed)
hline(50, "Mid Level", color=color.new(color.gray, 70), linestyle=hline.style_dotted)

// 3. Background Zones
midLine = plot(50, display=display.none)
obLine = plot(70, display=display.none)
osLine = plot(30, display=display.none)
fill(obLine, plot(100, display=display.none), color=color.new(COL_OB, 95))
fill(osLine, plot(0, display=display.none), color=color.new(COL_OS, 95))
