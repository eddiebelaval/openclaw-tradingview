//@version=5
indicator("RSI+STOCH", shorttitle="RSI+1", overlay=false)

// ===== RSI =====
src = close
len = input.int(14, minval=1, title="Length")

up = ta.rma(math.max(ta.change(src), 0), len)
down = ta.rma(-math.min(ta.change(src), 0), len)
rsi_val = down == 0 ? 100 : up == 0 ? 0 : 100 - (100 / (1 + up / down))

plot(rsi_val, color=color.rgb(120, 0, 218), linewidth=1)

// ===== 分段线 =====
h80 = hline(80, "80")
h70 = hline(70, "70")
h30 = hline(30, "30")
h20 = hline(20, "20")
h50 = hline(50, "50")

// ===== 分段填充 =====
fill(h80, h70, color=color.new(color.red, 66))
fill(h70, h30, color=color.new(color.purple, 85))
fill(h30, h20, color=color.new(color.red, 66))

// ===== STOCH（按官方 Stochastic 的写法） =====
smoothK = input.int(3, minval=1)
smoothD = input.int(3, minval=1)
lengthRSI = input.int(14, minval=1)   // 保留参数，不删除
lengthStoch = input.int(5, minval=1)

k = ta.sma(ta.stoch(close, high, low, lengthStoch), smoothK)
d = ta.sma(k, smoothD)

plot(k, color=color.blue)
plot(d, color=color.orange)
