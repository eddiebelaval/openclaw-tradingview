//@version=5
// Mizan PSI Oscillator v2: Mass & Momentum Integration
// Author: Murat Kavak (Idea Architect)
indicator("Mizan PSI: Enhanced", shorttitle="Mizan-PSI v2", overlay=false)

// ==========================================
// 1. SETTINGS
// ==========================================
len_psi   = input.int(14, "PSI Period (Sensitivity)")
threshold = input.float(0.3, "Noise Threshold (0.1 - 0.9)", step=0.1, tooltip="Minimum body-to-range ratio required to consider the candle valid.")
use_vol   = input.bool(true, "Use Volume Weighting (Merit)", tooltip="If enabled, low volume moves generate less energy.")

// ==========================================
// 2. ENERGY ENGINE
// ==========================================

// Body & Efficiency Calculation
total_range = high - low
body_size   = close - open 
abs_body    = math.abs(body_size)

// Efficiency: How "full" is the candle?
// (Wicks represent wasted energy / entropy)
efficiency  = total_range == 0 ? 0 : abs_body / total_range

// Volume Multiplier (Mass)
// If there is no volume, the price movement is an "illusion".
vol_factor  = use_vol ? (volume / ta.sma(volume, 50)) : 1.0

// RAW PSI CALCULATION
// If efficiency is below threshold, the candle is considered "Noise" (0).
// Otherwise: Body Direction * Efficiency * Volume Power
psi_raw = efficiency > threshold ? (body_size * efficiency * vol_factor) : 0

// ==========================================
// 3. SMOOTHING (HMA instead of EMA)
// ==========================================
// HMA reacts much faster to price, capturing reversals early.
psi_line = ta.hma(psi_raw, len_psi)

// ==========================================
// 4. VISUALIZATION (4-COLOR LOGIC)
// ==========================================

// Color Algorithm:
// 1. DARK BLUE:   Above Zero AND Rising (Strong Buyer / Kinetic Energy)
// 2. LIGHT BLUE:  Above Zero BUT Falling (Buyer Exhaustion -> EXIT SIGNAL)
// 3. DARK RED:    Below Zero AND Falling (Strong Seller / Kinetic Energy)
// 4. LIGHT RED:   Below Zero BUT Rising  (Seller Exhaustion -> REACTION SIGNAL)

col_final = color.gray // Default

if psi_line > 0
    col_final := psi_line > psi_line[1] ? color.new(#00bcd4, 0) : color.new(#00bcd4, 60)
else
    col_final := psi_line < psi_line[1] ? color.new(#ff5252, 0) : color.new(#ff5252, 60)

// Plotting
plot(psi_line, "PSI Energy", color=col_final, style=plot.style_columns, linewidth=2)
plot(0, "Balance Line", color=color.gray, linewidth=1)

// ==========================================
// 5. WARNING SIGNALS (Labels)
// ==========================================
// Captures color shifts (e.g., transition from Dark Blue to Light Blue)
trend_weakening = (psi_line > 0 and psi_line < psi_line[1] and psi_line[1] > psi_line[2])
// trend_reversal  = (psi_line < 0 and psi_line > psi_line[1] and psi_line[1] < psi_line[2]) // Optional

plotshape(trend_weakening, "Momentum Loss", shape.circle, location.top, color=color.orange, size=size.tiny, title="Top Weakening Warning")
