//@version=6
indicator("ADX Squeeze Breakout Screener",
     shorttitle="FuturesScreener",
     overlay=false,
     max_boxes_count=500,
     max_lines_count=500,
     max_labels_count=500)

grp1 = "Criteria Settings"
ema200_period  = input.int(200,  "EMA Period (Trend Filter)",          group=grp1, minval=1)
sma18_period   = input.int(18,   "SMA Period (Momentum Filter)",       group=grp1, minval=1)
sma_lookback   = input.int(10,   "SMA Slope Lookback (sessions)",      group=grp1, minval=1)
adx_period     = input.int(14,   "ADX Period",                         group=grp1, minval=1)
adx_coil_level = input.float(12, "ADX Coil Level (squeeze threshold)", group=grp1, minval=1.0, step=0.5)
adx_lookback   = input.int(10,   "ADX Coil Lookback (sessions)",       group=grp1, minval=1)

grp2 = "Display Settings"
show_equity    = input.bool(true, "Show Equity Indices",  group=grp2)
show_commodity = input.bool(true, "Show Commodities",     group=grp2)
show_currency  = input.bool(true, "Show Currencies",      group=grp2)
show_bonds     = input.bool(true, "Show Bonds/Rates",     group=grp2)

C_BG         = color.new(#ffffff, 0)
C_HDR_EQ     = color.new(#d0e4f7, 0)
C_HDR_CM     = color.new(#d4edda, 0)
C_HDR_FX     = color.new(#fff3cd, 0)
C_HDR_BD     = color.new(#e8d5f5, 0)
C_HDR_COL    = color.new(#343a40, 0)
C_HDR_TXT    = color.new(#ffffff, 0)
C_SEC_TXT_EQ = color.new(#1565c0, 0)
C_SEC_TXT_CM = color.new(#2e7d32, 0)
C_SEC_TXT_FX = color.new(#e65100, 0)
C_SEC_TXT_BD = color.new(#6a1b9a, 0)
C_PASS       = color.new(#1b7a34, 0)
C_FAIL       = color.new(#c62828, 0)
C_NEAR       = color.new(#e65100, 0)
C_TEXT       = color.new(#212121, 0)
C_DIM        = color.new(#757575, 0)
C_BORDER     = color.new(#dee2e6, 0)
C_PASS_BG    = color.new(#e8f5e9, 0)
C_NEAR_BG    = color.new(#fff8e1, 0)
C_ROW_A      = color.new(#ffffff, 0)
C_ROW_B      = color.new(#f8f9fa, 0)
C_TICK_G     = color.new(#1b7a34, 0)
C_TICK_R     = color.new(#c62828, 0)

get_signals(sym) =>
    [c, h, l] = request.security(sym, "D", [close, high, low], lookahead=barmerge.lookahead_off)
    ema200_v   = ta.ema(c, ema200_period)
    sma18_v    = ta.sma(c, sma18_period)
    sma18_ago  = ta.sma(c, sma18_period)[sma_lookback]
    sma_slope  = sma18_v - sma18_ago
    up         = h - h[1]
    down       = l[1] - l
    plus_dm    = (up > down and up > 0) ? up : 0.0
    minus_dm   = (down > up and down > 0) ? down : 0.0
    tr         = math.max(math.max(h - l, math.abs(h - c[1])), math.abs(l - c[1]))
    atr_v      = ta.rma(tr, adx_period)
    plus_di    = ta.rma(plus_dm,  adx_period) / atr_v * 100
    minus_di   = ta.rma(minus_dm, adx_period) / atr_v * 100
    dx         = math.abs(plus_di - minus_di) / (plus_di + minus_di) * 100
    adx_v      = ta.rma(dx, adx_period)
    adx_prev_v = adx_v[1]
    min_adx    = ta.lowest(adx_v[1], adx_lookback)
    f1         = c > ema200_v
    f2         = sma_slope > 0
    f3a        = min_adx < adx_coil_level
    f3b        = adx_v > adx_prev_v
    passes     = f1 and f2 and f3a and f3b
    pct_ema    = (c - ema200_v) / ema200_v * 100
    fail_cnt   = (f1 ? 0 : 1) + (f2 ? 0 : 1) + (f3a ? 0 : 1) + (f3b ? 0 : 1)
    [passes, f1, f2, f3a, f3b, c, ema200_v, sma18_v, adx_v, adx_prev_v, pct_ema, sma_slope, min_adx, fail_cnt]

[es_p,es_f1,es_f2,es_f3a,es_f3b,es_c,es_e2,es_s1,es_ax,es_ap,es_pc,es_sl,es_ma,es_fc] = get_signals("CME_MINI:ES1!")
[nq_p,nq_f1,nq_f2,nq_f3a,nq_f3b,nq_c,nq_e2,nq_s1,nq_ax,nq_ap,nq_pc,nq_sl,nq_ma,nq_fc] = get_signals("CME_MINI:NQ1!")
[ym_p,ym_f1,ym_f2,ym_f3a,ym_f3b,ym_c,ym_e2,ym_s1,ym_ax,ym_ap,ym_pc,ym_sl,ym_ma,ym_fc] = get_signals("CBOT_MINI:YM1!")
[ry_p,ry_f1,ry_f2,ry_f3a,ry_f3b,ry_c,ry_e2,ry_s1,ry_ax,ry_ap,ry_pc,ry_sl,ry_ma,ry_fc] = get_signals("CME_MINI:RTY1!")
[dx_p,dx_f1,dx_f2,dx_f3a,dx_f3b,dx_c,dx_e2,dx_s1,dx_ax,dx_ap,dx_pc,dx_sl,dx_ma,dx_fc] = get_signals("EUREX:FDAX1!")
[sx_p,sx_f1,sx_f2,sx_f3a,sx_f3b,sx_c,sx_e2,sx_s1,sx_ax,sx_ap,sx_pc,sx_sl,sx_ma,sx_fc] = get_signals("EUREX:FESX1!")
[ft_p,ft_f1,ft_f2,ft_f3a,ft_f3b,ft_c,ft_e2,ft_s1,ft_ax,ft_ap,ft_pc,ft_sl,ft_ma,ft_fc] = get_signals("ICEEUR:Z1!")
[hs_p,hs_f1,hs_f2,hs_f3a,hs_f3b,hs_c,hs_e2,hs_s1,hs_ax,hs_ap,hs_pc,hs_sl,hs_ma,hs_fc] = get_signals("HKEX:HSI1!")
[nk_p,nk_f1,nk_f2,nk_f3a,nk_f3b,nk_c,nk_e2,nk_s1,nk_ax,nk_ap,nk_pc,nk_sl,nk_ma,nk_fc] = get_signals("OSE:NK2251!")
[as_p,as_f1,as_f2,as_f3a,as_f3b,as_c,as_e2,as_s1,as_ax,as_ap,as_pc,as_sl,as_ma,as_fc] = get_signals("ASX24:AP1!")
[cl_p,cl_f1,cl_f2,cl_f3a,cl_f3b,cl_c,cl_e2,cl_s1,cl_ax,cl_ap,cl_pc,cl_sl,cl_ma,cl_fc] = get_signals("NYMEX:CL1!")
[bb_p,bb_f1,bb_f2,bb_f3a,bb_f3b,bb_c,bb_e2,bb_s1,bb_ax,bb_ap,bb_pc,bb_sl,bb_ma,bb_fc] = get_signals("NYMEX:BB1!")
[rb_p,rb_f1,rb_f2,rb_f3a,rb_f3b,rb_c,rb_e2,rb_s1,rb_ax,rb_ap,rb_pc,rb_sl,rb_ma,rb_fc] = get_signals("NYMEX:RB1!")
[ho_p,ho_f1,ho_f2,ho_f3a,ho_f3b,ho_c,ho_e2,ho_s1,ho_ax,ho_ap,ho_pc,ho_sl,ho_ma,ho_fc] = get_signals("NYMEX:HO1!")
[ng_p,ng_f1,ng_f2,ng_f3a,ng_f3b,ng_c,ng_e2,ng_s1,ng_ax,ng_ap,ng_pc,ng_sl,ng_ma,ng_fc] = get_signals("NYMEX:NG1!")
[gc_p,gc_f1,gc_f2,gc_f3a,gc_f3b,gc_c,gc_e2,gc_s1,gc_ax,gc_ap,gc_pc,gc_sl,gc_ma,gc_fc] = get_signals("COMEX:GC1!")
[si_p,si_f1,si_f2,si_f3a,si_f3b,si_c,si_e2,si_s1,si_ax,si_ap,si_pc,si_sl,si_ma,si_fc] = get_signals("COMEX:SI1!")
[hg_p,hg_f1,hg_f2,hg_f3a,hg_f3b,hg_c,hg_e2,hg_s1,hg_ax,hg_ap,hg_pc,hg_sl,hg_ma,hg_fc] = get_signals("COMEX:HG1!")
[zw_p,zw_f1,zw_f2,zw_f3a,zw_f3b,zw_c,zw_e2,zw_s1,zw_ax,zw_ap,zw_pc,zw_sl,zw_ma,zw_fc] = get_signals("CBOT:ZW1!")
[zc_p,zc_f1,zc_f2,zc_f3a,zc_f3b,zc_c,zc_e2,zc_s1,zc_ax,zc_ap,zc_pc,zc_sl,zc_ma,zc_fc] = get_signals("CBOT:ZC1!")
[zs_p,zs_f1,zs_f2,zs_f3a,zs_f3b,zs_c,zs_e2,zs_s1,zs_ax,zs_ap,zs_pc,zs_sl,zs_ma,zs_fc] = get_signals("CBOT:ZS1!")
[kc_p,kc_f1,kc_f2,kc_f3a,kc_f3b,kc_c,kc_e2,kc_s1,kc_ax,kc_ap,kc_pc,kc_sl,kc_ma,kc_fc] = get_signals("ICEUS:KC1!")
[ct_p,ct_f1,ct_f2,ct_f3a,ct_f3b,ct_c,ct_e2,ct_s1,ct_ax,ct_ap,ct_pc,ct_sl,ct_ma,ct_fc] = get_signals("ICEUS:CT1!")
[sb_p,sb_f1,sb_f2,sb_f3a,sb_f3b,sb_c,sb_e2,sb_s1,sb_ax,sb_ap,sb_pc,sb_sl,sb_ma,sb_fc] = get_signals("ICEUS:SB1!")
[eu_p,eu_f1,eu_f2,eu_f3a,eu_f3b,eu_c,eu_e2,eu_s1,eu_ax,eu_ap,eu_pc,eu_sl,eu_ma,eu_fc] = get_signals("CME:6E1!")
[bp_p,bp_f1,bp_f2,bp_f3a,bp_f3b,bp_c,bp_e2,bp_s1,bp_ax,bp_ap,bp_pc,bp_sl,bp_ma,bp_fc] = get_signals("CME:6B1!")
[jy_p,jy_f1,jy_f2,jy_f3a,jy_f3b,jy_c,jy_e2,jy_s1,jy_ax,jy_ap,jy_pc,jy_sl,jy_ma,jy_fc] = get_signals("CME:6J1!")
[ad_p,ad_f1,ad_f2,ad_f3a,ad_f3b,ad_c,ad_e2,ad_s1,ad_ax,ad_ap,ad_pc,ad_sl,ad_ma,ad_fc] = get_signals("CME:6A1!")
[cd_p,cd_f1,cd_f2,cd_f3a,cd_f3b,cd_c,cd_e2,cd_s1,cd_ax,cd_ap,cd_pc,cd_sl,cd_ma,cd_fc] = get_signals("CME:6C1!")
[sf_p,sf_f1,sf_f2,sf_f3a,sf_f3b,sf_c,sf_e2,sf_s1,sf_ax,sf_ap,sf_pc,sf_sl,sf_ma,sf_fc] = get_signals("CME:6S1!")
[nz_p,nz_f1,nz_f2,nz_f3a,nz_f3b,nz_c,nz_e2,nz_s1,nz_ax,nz_ap,nz_pc,nz_sl,nz_ma,nz_fc] = get_signals("CME:6N1!")
[di_p,di_f1,di_f2,di_f3a,di_f3b,di_c,di_e2,di_s1,di_ax,di_ap,di_pc,di_sl,di_ma,di_fc] = get_signals("ICEUS:DX1!")
[mp_p,mp_f1,mp_f2,mp_f3a,mp_f3b,mp_c,mp_e2,mp_s1,mp_ax,mp_ap,mp_pc,mp_sl,mp_ma,mp_fc] = get_signals("CME:6M1!")
[zr_p,zr_f1,zr_f2,zr_f3a,zr_f3b,zr_c,zr_e2,zr_s1,zr_ax,zr_ap,zr_pc,zr_sl,zr_ma,zr_fc] = get_signals("CME:6Z1!")
[br_p,br_f1,br_f2,br_f3a,br_f3b,br_c,br_e2,br_s1,br_ax,br_ap,br_pc,br_sl,br_ma,br_fc] = get_signals("CME:6L1!")
[rp_p,rp_f1,rp_f2,rp_f3a,rp_f3b,rp_c,rp_e2,rp_s1,rp_ax,rp_ap,rp_pc,rp_sl,rp_ma,rp_fc] = get_signals("CME:RP1!")
[zn_p,zn_f1,zn_f2,zn_f3a,zn_f3b,zn_c,zn_e2,zn_s1,zn_ax,zn_ap,zn_pc,zn_sl,zn_ma,zn_fc] = get_signals("CBOT:ZN1!")
[zb_p,zb_f1,zb_f2,zb_f3a,zb_f3b,zb_c,zb_e2,zb_s1,zb_ax,zb_ap,zb_pc,zb_sl,zb_ma,zb_fc] = get_signals("CBOT:ZB1!")
[zf_p,zf_f1,zf_f2,zf_f3a,zf_f3b,zf_c,zf_e2,zf_s1,zf_ax,zf_ap,zf_pc,zf_sl,zf_ma,zf_fc] = get_signals("CBOT:ZF1!")
[gl_p,gl_f1,gl_f2,gl_f3a,gl_f3b,gl_c,gl_e2,gl_s1,gl_ax,gl_ap,gl_pc,gl_sl,gl_ma,gl_fc] = get_signals("EUREX:FGBL1!")

count_pass =
     (es_p?1:0)+(nq_p?1:0)+(ym_p?1:0)+(ry_p?1:0)+(dx_p?1:0)+(sx_p?1:0)+
     (ft_p?1:0)+(hs_p?1:0)+(nk_p?1:0)+(as_p?1:0)+
     (cl_p?1:0)+(bb_p?1:0)+(rb_p?1:0)+(ho_p?1:0)+(ng_p?1:0)+(gc_p?1:0)+
     (si_p?1:0)+(hg_p?1:0)+(zw_p?1:0)+(zc_p?1:0)+(zs_p?1:0)+(kc_p?1:0)+
     (ct_p?1:0)+(sb_p?1:0)+
     (eu_p?1:0)+(bp_p?1:0)+(jy_p?1:0)+(ad_p?1:0)+(cd_p?1:0)+(sf_p?1:0)+
     (nz_p?1:0)+(di_p?1:0)+(mp_p?1:0)+(zr_p?1:0)+(br_p?1:0)+(rp_p?1:0)+
     (zn_p?1:0)+(zb_p?1:0)+(zf_p?1:0)+(gl_p?1:0)

var table t = table.new(position.top_left, 11, 56,
     bgcolor=C_BG, border_color=C_BORDER, border_width=1,
     frame_color=color.new(#adb5bd, 0), frame_width=1)

hdr(r, c, txt) =>
    table.cell(t, c, r, txt, text_color=C_HDR_TXT, text_size=size.tiny,
         bgcolor=C_HDR_COL, text_halign=text.align_center)

bool_cell(r, c, val, bg) =>
    table.cell(t, c, r, val ? "✔" : "✘",
         text_color=val ? C_TICK_G : C_TICK_R,
         text_size=size.tiny, bgcolor=bg, text_halign=text.align_center)

row_bg(passes, fc, idx) =>
    passes ? C_PASS_BG : fc == 1 ? C_NEAR_BG : (idx % 2 == 0 ? C_ROW_A : C_ROW_B)

fmt_p(p) =>
    p >= 10000 ? str.tostring(math.round(p, 0)) :
     p >= 100  ? str.tostring(math.round(p, 1)) :
     p >= 1    ? str.tostring(math.round(p, 2)) :
                 str.tostring(math.round(p, 4))

fmt_pct(p) =>
    (p >= 0 ? "+" : "") + str.tostring(math.round(p, 1)) + "%"

fmt_adx(a) =>
    str.tostring(math.round(a, 1))

draw_row(r, idx, lbl, passes, f1, f2, f3a, f3b, price, pct, adxv, minadx, fc) =>
    bg      = row_bg(passes, fc, idx)
    sig_txt = passes ? "● PASS" : fc == 1 ? "◐ NEAR" : "○ fail"
    sig_col = passes ? C_PASS   : fc == 1 ? C_NEAR   : C_FAIL
    pct_col = pct >= 0 ? color.new(#1b7a34, 0) : color.new(#c62828, 0)
    adx_col = adxv < adx_coil_level ? color.new(#1565c0, 0) : adxv > 25 ? color.new(#c62828, 0) : C_TEXT
    table.cell(t, 0,  r, lbl,            text_color=C_TEXT,  text_size=size.tiny, bgcolor=bg, text_halign=text.align_left)
    table.cell(t, 1,  r, sig_txt,         text_color=sig_col, text_size=size.tiny, bgcolor=bg, text_halign=text.align_center)
    table.cell(t, 2,  r, fmt_p(price),    text_color=C_TEXT,  text_size=size.tiny, bgcolor=bg, text_halign=text.align_right)
    table.cell(t, 3,  r, fmt_pct(pct),    text_color=pct_col, text_size=size.tiny, bgcolor=bg, text_halign=text.align_right)
    table.cell(t, 4,  r, f2 ? "↑" : "↓", text_color=f2 ? C_PASS : C_FAIL, text_size=size.tiny, bgcolor=bg, text_halign=text.align_center)
    table.cell(t, 5,  r, fmt_adx(adxv),   text_color=adx_col, text_size=size.tiny, bgcolor=bg, text_halign=text.align_right)
    table.cell(t, 6,  r, fmt_adx(minadx), text_color=minadx < adx_coil_level ? color.new(#1565c0,0) : C_DIM, text_size=size.tiny, bgcolor=bg, text_halign=text.align_right)
    bool_cell(r, 7,  f1,  bg)
    bool_cell(r, 8,  f2,  bg)
    bool_cell(r, 9,  f3a, bg)
    bool_cell(r, 10, f3b, bg)

sec_hdr(row, lbl, txt_col, bg_col) =>
    table.cell(t, 0, row, lbl, text_color=txt_col, text_size=size.tiny,
         bgcolor=bg_col, text_halign=text.align_left)
    table.merge_cells(t, 0, row, 10, row)

if barstate.islast
    table.cell(t, 0, 0, "⚡  ADX Squeeze Breakout Screener     " +
         str.tostring(count_pass) + " signal(s)     " +
         str.format_time(timenow, "dd MMM yyyy  HH:mm"),
         text_color=C_HDR_TXT, text_size=size.small,
         bgcolor=C_HDR_COL, text_halign=text.align_left)
    table.merge_cells(t, 0, 0, 10, 0)

    hdr(1, 0,  "Contract")
    hdr(1, 1,  "Signal")
    hdr(1, 2,  "Price")
    hdr(1, 3,  "% vs EMA")
    hdr(1, 4,  "SMA↑")
    hdr(1, 5,  "ADX")
    hdr(1, 6,  "minADX")
    hdr(1, 7,  "F1")
    hdr(1, 8,  "F2")
    hdr(1, 9,  "F3a")
    hdr(1, 10, "F3b")

    if show_equity
        sec_hdr(2, "  EQUITY INDICES", C_SEC_TXT_EQ, C_HDR_EQ)
        draw_row(3,  0, "ES1!   S&P 500",      es_p, es_f1, es_f2, es_f3a, es_f3b, es_c, es_pc, es_ax, es_ma, es_fc)
        draw_row(4,  1, "NQ1!   NASDAQ 100",   nq_p, nq_f1, nq_f2, nq_f3a, nq_f3b, nq_c, nq_pc, nq_ax, nq_ma, nq_fc)
        draw_row(5,  0, "YM1!   Dow Jones",    ym_p, ym_f1, ym_f2, ym_f3a, ym_f3b, ym_c, ym_pc, ym_ax, ym_ma, ym_fc)
        draw_row(6,  1, "RTY1!  Russell 2000", ry_p, ry_f1, ry_f2, ry_f3a, ry_f3b, ry_c, ry_pc, ry_ax, ry_ma, ry_fc)
        draw_row(7,  0, "FDAX1! DAX",          dx_p, dx_f1, dx_f2, dx_f3a, dx_f3b, dx_c, dx_pc, dx_ax, dx_ma, dx_fc)
        draw_row(8,  1, "FESX1! EuroSTOXX",    sx_p, sx_f1, sx_f2, sx_f3a, sx_f3b, sx_c, sx_pc, sx_ax, sx_ma, sx_fc)
        draw_row(9,  0, "Z1!    FTSE 100",     ft_p, ft_f1, ft_f2, ft_f3a, ft_f3b, ft_c, ft_pc, ft_ax, ft_ma, ft_fc)
        draw_row(10, 1, "HSI1!  Hang Seng",    hs_p, hs_f1, hs_f2, hs_f3a, hs_f3b, hs_c, hs_pc, hs_ax, hs_ma, hs_fc)
        draw_row(11, 0, "NK2251! Nikkei",      nk_p, nk_f1, nk_f2, nk_f3a, nk_f3b, nk_c, nk_pc, nk_ax, nk_ma, nk_fc)
        draw_row(12, 1, "AP1!   ASX 200",      as_p, as_f1, as_f2, as_f3a, as_f3b, as_c, as_pc, as_ax, as_ma, as_fc)

    if show_commodity
        cm = 2 + (show_equity ? 11 : 0)
        sec_hdr(cm, "  COMMODITIES", C_SEC_TXT_CM, C_HDR_CM)
        draw_row(cm+1,  0, "CL1!  Crude Oil WTI", cl_p, cl_f1, cl_f2, cl_f3a, cl_f3b, cl_c, cl_pc, cl_ax, cl_ma, cl_fc)
        draw_row(cm+2,  1, "BB1!  Brent Crude",   bb_p, bb_f1, bb_f2, bb_f3a, bb_f3b, bb_c, bb_pc, bb_ax, bb_ma, bb_fc)
        draw_row(cm+3,  0, "RB1!  RBOB Gasoline", rb_p, rb_f1, rb_f2, rb_f3a, rb_f3b, rb_c, rb_pc, rb_ax, rb_ma, rb_fc)
        draw_row(cm+4,  1, "HO1!  Heating Oil",   ho_p, ho_f1, ho_f2, ho_f3a, ho_f3b, ho_c, ho_pc, ho_ax, ho_ma, ho_fc)
        draw_row(cm+5,  0, "NG1!  Natural Gas",   ng_p, ng_f1, ng_f2, ng_f3a, ng_f3b, ng_c, ng_pc, ng_ax, ng_ma, ng_fc)
        draw_row(cm+6,  1, "GC1!  Gold",          gc_p, gc_f1, gc_f2, gc_f3a, gc_f3b, gc_c, gc_pc, gc_ax, gc_ma, gc_fc)
        draw_row(cm+7,  0, "SI1!  Silver",        si_p, si_f1, si_f2, si_f3a, si_f3b, si_c, si_pc, si_ax, si_ma, si_fc)
        draw_row(cm+8,  1, "HG1!  Copper",        hg_p, hg_f1, hg_f2, hg_f3a, hg_f3b, hg_c, hg_pc, hg_ax, hg_ma, hg_fc)
        draw_row(cm+9,  0, "ZW1!  Wheat",         zw_p, zw_f1, zw_f2, zw_f3a, zw_f3b, zw_c, zw_pc, zw_ax, zw_ma, zw_fc)
        draw_row(cm+10, 1, "ZC1!  Corn",          zc_p, zc_f1, zc_f2, zc_f3a, zc_f3b, zc_c, zc_pc, zc_ax, zc_ma, zc_fc)
        draw_row(cm+11, 0, "ZS1!  Soybeans",      zs_p, zs_f1, zs_f2, zs_f3a, zs_f3b, zs_c, zs_pc, zs_ax, zs_ma, zs_fc)
        draw_row(cm+12, 1, "KC1!  Coffee",        kc_p, kc_f1, kc_f2, kc_f3a, kc_f3b, kc_c, kc_pc, kc_ax, kc_ma, kc_fc)
        draw_row(cm+13, 0, "CT1!  Cotton",        ct_p, ct_f1, ct_f2, ct_f3a, ct_f3b, ct_c, ct_pc, ct_ax, ct_ma, ct_fc)
        draw_row(cm+14, 1, "SB1!  Sugar #11",     sb_p, sb_f1, sb_f2, sb_f3a, sb_f3b, sb_c, sb_pc, sb_ax, sb_ma, sb_fc)

    if show_currency
        fx = 2 + (show_equity ? 11 : 0) + (show_commodity ? 15 : 0)
        sec_hdr(fx, "  CURRENCIES", C_SEC_TXT_FX, C_HDR_FX)
        draw_row(fx+1,  0, "6E1!  Euro FX",   eu_p, eu_f1, eu_f2, eu_f3a, eu_f3b, eu_c, eu_pc, eu_ax, eu_ma, eu_fc)
        draw_row(fx+2,  1, "6B1!  GBP",       bp_p, bp_f1, bp_f2, bp_f3a, bp_f3b, bp_c, bp_pc, bp_ax, bp_ma, bp_fc)
        draw_row(fx+3,  0, "6J1!  JPY",       jy_p, jy_f1, jy_f2, jy_f3a, jy_f3b, jy_c, jy_pc, jy_ax, jy_ma, jy_fc)
        draw_row(fx+4,  1, "6A1!  AUD",       ad_p, ad_f1, ad_f2, ad_f3a, ad_f3b, ad_c, ad_pc, ad_ax, ad_ma, ad_fc)
        draw_row(fx+5,  0, "6C1!  CAD",       cd_p, cd_f1, cd_f2, cd_f3a, cd_f3b, cd_c, cd_pc, cd_ax, cd_ma, cd_fc)
        draw_row(fx+6,  1, "6S1!  CHF",       sf_p, sf_f1, sf_f2, sf_f3a, sf_f3b, sf_c, sf_pc, sf_ax, sf_ma, sf_fc)
        draw_row(fx+7,  0, "6N1!  NZD",       nz_p, nz_f1, nz_f2, nz_f3a, nz_f3b, nz_c, nz_pc, nz_ax, nz_ma, nz_fc)
        draw_row(fx+8,  1, "DX1!  USD Index", di_p, di_f1, di_f2, di_f3a, di_f3b, di_c, di_pc, di_ax, di_ma, di_fc)
        draw_row(fx+9,  0, "6M1!  Mex Peso",  mp_p, mp_f1, mp_f2, mp_f3a, mp_f3b, mp_c, mp_pc, mp_ax, mp_ma, mp_fc)
        draw_row(fx+10, 1, "6Z1!  ZAR",       zr_p, zr_f1, zr_f2, zr_f3a, zr_f3b, zr_c, zr_pc, zr_ax, zr_ma, zr_fc)
        draw_row(fx+11, 0, "6L1!  BRL",       br_p, br_f1, br_f2, br_f3a, br_f3b, br_c, br_pc, br_ax, br_ma, br_fc)
        draw_row(fx+12, 1, "RP1!  EUR/GBP",   rp_p, rp_f1, rp_f2, rp_f3a, rp_f3b, rp_c, rp_pc, rp_ax, rp_ma, rp_fc)

    if show_bonds
        bd = 2 + (show_equity ? 11 : 0) + (show_commodity ? 15 : 0) + (show_currency ? 13 : 0)
        sec_hdr(bd, "  BONDS / RATES", C_SEC_TXT_BD, C_HDR_BD)
        draw_row(bd+1, 0, "ZN1!   10Y T-Note", zn_p, zn_f1, zn_f2, zn_f3a, zn_f3b, zn_c, zn_pc, zn_ax, zn_ma, zn_fc)
        draw_row(bd+2, 1, "ZB1!   30Y T-Bond", zb_p, zb_f1, zb_f2, zb_f3a, zb_f3b, zb_c, zb_pc, zb_ax, zb_ma, zb_fc)
        draw_row(bd+3, 0, "ZF1!   5Y T-Note",  zf_p, zf_f1, zf_f2, zf_f3a, zf_f3b, zf_c, zf_pc, zf_ax, zf_ma, zf_fc)
        draw_row(bd+4, 1, "FGBL1! Euro Bund",  gl_p, gl_f1, gl_f2, gl_f3a, gl_f3b, gl_c, gl_pc, gl_ax, gl_ma, gl_fc)

any_pass = es_p or nq_p or ym_p or ry_p or dx_p or sx_p or ft_p or hs_p or nk_p or as_p or
           cl_p or bb_p or rb_p or ho_p or ng_p or gc_p or si_p or hg_p or zw_p or zc_p or
           zs_p or kc_p or ct_p or sb_p or eu_p or bp_p or jy_p or ad_p or cd_p or sf_p or
           nz_p or di_p or mp_p or zr_p or br_p or rp_p or zn_p or zb_p or zf_p or gl_p

alertcondition(any_pass,              "Any Contract — ADX Squeeze Signal", "Futures Screener: New ADX squeeze breakout signal fired")
alertcondition(es_p,                  "ES  — S&P 500 Signal",              "ES1! S&P 500: ADX squeeze breakout")
alertcondition(nq_p,                  "NQ  — NASDAQ Signal",               "NQ1! NASDAQ 100: ADX squeeze breakout")
alertcondition(ym_p,                  "YM  — Dow Jones Signal",            "YM1! Dow Jones: ADX squeeze breakout")
alertcondition(gc_p,                  "GC  — Gold Signal",                 "GC1! Gold: ADX squeeze breakout")
alertcondition(cl_p,                  "CL  — Crude Oil Signal",            "CL1! WTI Crude: ADX squeeze breakout")
alertcondition(eu_p,                  "6E  — Euro FX Signal",              "6E1! Euro FX: ADX squeeze breakout")
alertcondition(zn_p or zb_p or zf_p,  "Bonds — Any US Signal",             "US Bonds (ZN/ZB/ZF): ADX squeeze breakout")
alertcondition(zw_p or zc_p or zs_p,  "Grains — Any Signal",               "Grains (Wheat/Corn/Soybeans): ADX squeeze breakout")

plot(count_pass, "Signals Count", color=color.new(#00c853, 100))
hline(0, "Zero", color=color.new(color.gray, 90))
