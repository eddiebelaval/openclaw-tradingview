GROUP_PRESET = "============= STOCK PRESETS (ONE-CLICK SETUP) ============="
presetSelect = input.string("None", "Active Stock Preset",
    options=["None","① NVDA — 15 Min","② AAPL — 15 Min","③ AMD  — 15 Min","④ TSLA — 15 Min","⑤ META — 1 Hour"],
    group=GROUP_PRESET,
    tooltip="Calibrated Mar 2026. NVDA 15m|B2.37 HV42%  AAPL 15m|B1.12 HV29%  AMD 15m|B2.02 HV60%  TSLA 15m|B1.92 HV45%  META 1h|B1.50 HV35%")

//====================================================================
// Section #3.5 | PRESET ENGINE
//====================================================================
bool isPresetNVDA = presetSelect == "① NVDA — 15 Min"
bool isPresetAAPL = presetSelect == "② AAPL — 15 Min"
bool isPresetAMD  = presetSelect == "③ AMD  — 15 Min"
bool isPresetTSLA = presetSelect == "④ TSLA — 15 Min"
bool isPresetMETA = presetSelect == "⑤ META — 1 Hour"
bool isPresetOn   = isPresetNVDA or isPresetAAPL or isPresetAMD or isPresetTSLA or isPresetMETA

float eff_utKey = isPresetNVDA ? 1.1 : isPresetAAPL ? 1.2 : isPresetAMD ? 1.3 : isPresetTSLA ? 2.0 : isPresetMETA ? 1.2 : utKey
int   eff_utAtrPeriod = isPresetNVDA ? 10 : isPresetAAPL ? 7 : isPresetAMD ? 10 : isPresetTSLA ? 14 : isPresetMETA ? 10 : utAtrPeriod
bool  eff_utUseSwingFilter = isPresetOn ? true : utUseSwingFilter
int   eff_swingLen = isPresetNVDA ? 8 : isPresetAAPL ? 7 : isPresetAMD ? 12 : isPresetTSLA ? 12 : isPresetMETA ? 8 : swingLen
bool  eff_utUseZlsmaFilter = isPresetNVDA ? false : isPresetAAPL ? true : isPresetAMD ? false : isPresetTSLA ? false : isPresetMETA ? true : utUseZlsmaFilter
int   eff_maShortLen = isPresetNVDA ? 9 : isPresetAAPL ? 9 : isPresetAMD ? 9 : isPresetTSLA ? 9 : isPresetMETA ? 10 : maShortLen
int   eff_maMedLen   = isPresetNVDA ? 21 : isPresetAAPL ? 20 : isPresetAMD ? 20 : isPresetTSLA ? 21 : isPresetMETA ? 21 : maMedLen
float eff_stMult = isPresetNVDA ? 2.2 : isPresetAAPL ? 1.8 : isPresetAMD ? 2.5 : isPresetTSLA ? 3.0 : isPresetMETA ? 2.0 : stMult
bool  eff_useAdxFilter = isPresetOn ? true : useAdxFilter
float eff_adxMin = isPresetNVDA ? 25.0 : isPresetAAPL ? 20.0 : isPresetAMD ? 23.0 : isPresetTSLA ? 25.0 : isPresetMETA ? 20.0 : adxMin
bool  eff_useVolFilter = isPresetNVDA ? true : isPresetAAPL ? true : isPresetAMD ? true : isPresetTSLA ? true : isPresetMETA ? false : useVolFilter
float eff_volMinFactor = isPresetNVDA ? 1.5 : isPresetAAPL ? 1.2 : isPresetAMD ? 1.4 : isPresetTSLA ? 1.5 : isPresetMETA ? 1.2 : volMinFactor
bool  eff_useRsiPullback = isPresetOn ? false : useRsiPullback
string eff_presetLabel = isPresetNVDA ? "PRESET: NVDA  15m  |  B2.37  HV42%" : isPresetAAPL ? "PRESET: AAPL  15m  |  B1.12  HV29%" : isPresetAMD ? "PRESET: AMD   15m  |  B2.02  HV60%" : isPresetTSLA ? "PRESET: TSLA  15m  |  B1.92  HV45%" : isPresetMETA ? "PRESET: META   1h  |  B1.50  HV35%" : ""

//====================================================================
// Section #4 | VALIDATION AND CORE HELPERS
//====================================================================
// REPAIR-010: Validation now checks effective preset-overridden values.
// maMidLong length checks are guarded by showMidLongMA so they only
// fire when that MA is actually enabled. All three checks are also
// guarded by not isPresetOn so valid preset combinations never
// trigger a false crash from raw panel input ordering.
if not isPresetOn and eff_maShortLen >= eff_maMedLen
    runtime.error("Fast MA length must be less than Medium MA length")
if showMidLongMA and not isPresetOn and maMedLen >= maMidLongLen
    runtime.error("Medium MA length must be less than Medium-Long MA length")
if showMidLongMA and not isPresetOn and maMidLongLen >= ma200Len
    runtime.error("Medium-Long MA length must be less than Long MA length")
if rsiBuyMin >= rsiBuyMax
    runtime.error("RSI Buy Min must be less than Buy Max")
if rsiSellMin >= rsiSellMax
    runtime.error("RSI Sell Min must be less than Sell Max")

maSwitch(_src, _len, _type) =>
    float result = na
    switch _type
        "EMA"  => result := ta.ema(_src, _len)
        "SMA"  => result := ta.sma(_src, _len)
        "WMA"  => result := ta.wma(_src, _len)
        "VWMA" => result := ta.vwma(_src, _len)
        "RMA"  => result := ta.rma(_src, _len)
        "HMA"  => result := ta.hma(_src, _len)
    result

anchor_reset(string how) =>
    bool reset = false
    if how == "Session"
        reset := session.isfirstbar
    else if how == "Day"
        reset := timeframe.change("D")
    else if how == "Week"
        reset := timeframe.change("W")
    else if how == "Month"
        reset := timeframe.change("M")
    else if how == "Quarter"
        reset := timeframe.change("3M")
    else if how == "Year"
        reset := timeframe.change("12M")
    reset

zlsma_calc(_src, _length, _offset) =>
    float fastLen      = math.max(1.0, math.floor(_length * 0.5))
    float emaFast      = ta.ema(_src, int(fastLen))
    float emaSlow      = ta.ema(_src, _length)
    float momentumRate = (emaFast - emaSlow) / _length
    float hullMa       = ta.hma(_src, _length)
    float prediction   = hullMa + momentumRate * (_length * 0.25)
    prediction * 0.4 + emaFast * 0.6 + _offset

dmi_local(_len) =>
    float upMove  = high - high[1]
    float dnMove  = low[1] - low
    float plusDM  = (upMove > dnMove and upMove > 0) ? upMove : 0.0
    float minusDM = (dnMove > upMove and dnMove > 0) ? dnMove : 0.0
    float trur    = ta.rma(ta.tr, _len)
    float plus    = trur == 0 ? 0.0 : 100 * ta.rma(plusDM, _len) / trur
    float minus   = trur == 0 ? 0.0 : 100 * ta.rma(minusDM, _len) / trur
    float dx      = (plus + minus) == 0 ? 0.0 : 100 * math.abs(plus - minus) / (plus + minus)
    float adxVal  = ta.rma(dx, _len)
    [adxVal, plus, minus]

getEmoji(_ok) => _ok ? "Y" : "N"
triEmoji(_state) => _state == 1 ? "Y" : _state == -1 ? "N" : "-"

sess_minutes(string s) =>
    int total = 0
    string[] segs = str.split(s, ",")
    for i = 0 to array.size(segs) - 1
        string seg    = array.get(segs, i)
        string[] ends = str.split(seg, "-")
        if array.size(ends) == 2
            string a = array.get(ends, 0)
            string b = array.get(ends, 1)
            int ah = int(str.tonumber(str.substring(a, 0, 2)))
            int am = int(str.tonumber(str.substring(a, 2, 4)))
            int bh = int(str.tonumber(str.substring(b, 0, 2)))
            int bm = int(str.tonumber(str.substring(b, 2, 4)))
            total += (bh * 60 + bm) - (ah * 60 + am)
    total == 0 ? 390 : total

bias_label_from(_v) =>
    na(_v) ? "NEUTRAL" : _v > 0 ? "BULLISH" : _v < 0 ? "BEARISH" : "NEUTRAL"

// REPAIR-009: Extended biasBg to recognise ORB status strings.
// Strings containing "ABOVE" map to bullish green.
// Strings containing "BELOW" map to bearish red.
// All other strings (INSIDE, BUILDING, Not Open, NEUTRAL) map to neutral gray.
biasBg(_txt) =>
    _txt == "BULLISH"            ? color.rgb(1, 131, 6)   :
     str.contains(_txt, "ABOVE") ? color.rgb(1, 131, 6)   :
     _txt == "BEARISH"           ? color.rgb(209, 0, 0)   :
     str.contains(_txt, "BELOW") ? color.rgb(209, 0, 0)   :
                                   color.rgb(160, 159, 159)

//====================================================================
// Section #5 | CORE CALCULATIONS
//====================================================================
float maShort   = maSwitch(close, eff_maShortLen, maFastType)
float maMedium  = maSwitch(close, eff_maMedLen,   maMedType)
float maMidLong = maSwitch(close, maMidLongLen, maMidLongType)
float maLong    = maSwitch(close, ma200Len,     maLongType)

[macdLine, signalLine, macdHist] = ta.macd(macdSrc, macdFast, macdSlow, macdSig)
float atrNow      = ta.atr(atrLen)
bool  maDistanceOk = not na(maMedium) and maMedium != 0 and math.abs(maShort - maMedium) / maMedium * 100 > distanceThrPct
bool  macdSepOk    = math.abs(macdLine - signalLine) > atrNow * macdSepFactor

bool  vwActive    = showVWAP and not (hideonDWM and timeframe.isdwm)
bool  isNewPeriod = anchor_reset(anchor)

var float sumPV  = 0.0
var float sumV   = 0.0
var float sumP2V = 0.0

float vwapAtr10       = ta.atr(10)
float vwapValue       = na
float upperBandValue1 = na
float lowerBandValue1 = na
float upperBandValue2 = na
float lowerBandValue2 = na
float upperBandValue3 = na
float lowerBandValue3 = na

if vwActive
    if isNewPeriod
        sumPV  := 0.0
        sumV   := 0.0
        sumP2V := 0.0
    float vol  = barstate.isconfirmed ? volume : nz(volume[1], volume)
    sumPV  += srcVWAP * vol
    sumV   += vol
    sumP2V += srcVWAP * srcVWAP * vol
    vwapValue := sumV > 0 ? sumPV / sumV : na
    float variance    = sumV > 0 ? (sumP2V / sumV) - (vwapValue * vwapValue) : na
    // REPAIR-008: Standard deviation is computed without the non-standard
    // ATR-based inflation factor. Formula is now sqrt(variance) only,
    // matching the standard VWAP band definition.
    float weightedStd = na(variance) ? na : math.sqrt(math.max(0.0, variance))
    float bandBasis   = calcModeInput == "Standard Deviation" ? weightedStd : vwapValue * 0.01
    upperBandValue1 := na(bandBasis) ? na : vwapValue + bandBasis * bandMult1
    lowerBandValue1 := na(bandBasis) ? na : vwapValue - bandBasis * bandMult1
    upperBandValue2 := na(bandBasis) ? na : vwapValue + bandBasis * bandMult2
    lowerBandValue2 := na(bandBasis) ? na : vwapValue - bandBasis * bandMult2
    upperBandValue3 := na(bandBasis) ? na : vwapValue + bandBasis * bandMult3
    lowerBandValue3 := na(bandBasis) ? na : vwapValue - bandBasis * bandMult3

bool vwOkLong  = vwActive ? close > vwapValue  : true
bool vwOkShort = vwActive ? close < vwapValue  : true

bool longCondBase  = ta.crossover(maShort,  maMedium) and vwOkLong  and macdSepOk and maDistanceOk and close > open and (not macdAboveZero or macdLine > 0)
bool shortCondBase = ta.crossunder(maShort, maMedium) and vwOkShort and macdSepOk and maDistanceOk and close < open and (not macdBelowZero or macdLine < 0)

//====================================================================
// Section #6 | ZLSMA
//====================================================================
bool  needZlsmaMain  = showZLSMA or eff_utUseZlsmaFilter or rowZLSMA
float zlsma          = needZlsmaMain ? zlsma_calc(zlsmaSrc, zlsmaLength, zlsmaOffset) : na
bool  zlsmaAgreeBuy  = not eff_utUseZlsmaFilter or na(zlsma) or close > zlsma
bool  zlsmaAgreeSell = not eff_utUseZlsmaFilter or na(zlsma) or close < zlsma

//====================================================================
// Section #7 | UT BOT LOGIC
//====================================================================
float srcUT    = close
float xATR     = ta.atr(eff_utAtrPeriod)
float volSma20 = ta.sma(volume, 20)
float volRatio = volSma20 == 0 ? 1.0 : volume / volSma20
float mom5     = ta.mom(srcUT, 5)
float momentum = srcUT == 0 ? 0.0 : mom5 / srcUT

float adaptiveKey = eff_utKey * (1 + math.abs(momentum) * 2) * math.max(0.8, math.min(1.2, volRatio))
float trailDist   = xATR * adaptiveKey

// REPAIR-001: Replaced the EMA blend (0.7/0.3) with a proper ratchet.
// In bullish state (srcUT > prior stop), the stop can only move upward
// to srcUT - trailDist, enforced by math.max so it never retreats.
// In bearish state (srcUT < prior stop), the stop can only move downward
// to srcUT + trailDist, enforced by math.min so it never rises.
// This eliminates phantom crossover and crossunder events caused by
// stop drift in the wrong direction during ongoing trends.
var float xATRTrailingStop = na
if na(xATRTrailingStop)
    xATRTrailingStop := srcUT
else if srcUT > xATRTrailingStop[1]
    xATRTrailingStop := math.max(xATRTrailingStop[1], srcUT - trailDist)
else if srcUT < xATRTrailingStop[1]
    xATRTrailingStop := math.min(xATRTrailingStop[1], srcUT + trailDist)
else
    xATRTrailingStop := xATRTrailingStop[1]

bool above = ta.crossover(srcUT,  xATRTrailingStop) and volRatio > 0.8
bool below = ta.crossunder(srcUT, xATRTrailingStop) and volRatio > 0.8

float atrPct = srcUT != 0 ? xATR / srcUT * 100.0 : 0.0
float thr    = math.max(utPctThr, math.min(atrPct, 20.0) * 0.50)
bool  chgOk  = not utUsePctFilter or (srcUT[1] != 0 and math.abs(srcUT - srcUT[1]) / srcUT[1] * 100.0 > thr)

float swingLowRef  = ta.lowest(srcUT,  eff_swingLen)
float swingHighRef = ta.highest(srcUT, eff_swingLen)
bool  swingOkBuy   = not eff_utUseSwingFilter or srcUT > swingLowRef  * 1.01
bool  swingOkSell  = not eff_utUseSwingFilter or srcUT < swingHighRef * 0.99

float volVma = ta.sma(volume, volLookback)
bool  volOK  = not eff_useVolFilter or (na(volVma) or volume >= volVma * eff_volMinFactor)

bool barbuy  = srcUT > xATRTrailingStop
bool barsell = srcUT < xATRTrailingStop

bool utBuyRaw  = (utUseDelay ? (bar_index > 1 and above[2]  and barbuy[1]  and barbuy[2])  : above)  and chgOk and swingOkBuy
bool utSellRaw = (utUseDelay ? (bar_index > 1 and below[2] and barsell[1] and barsell[2]) : below) and chgOk and swingOkSell

bool utBuy  = utBuyRaw  and close > xATRTrailingStop and zlsmaAgreeBuy
bool utSell = utSellRaw and close < xATRTrailingStop and zlsmaAgreeSell

bool utVizGate      = not drawUtvizOnClose or barstate.isconfirmed or not barstate.isrealtime
bool slFeatureOn    = slShow and utShowLabels
bool tpFeatureOn    = tpShow and utShowLabels
bool entryFeatureOn = entryShow

//====================================================================
// Section #7.5 | CONSOLIDATED DAILY DATA FETCHES
//====================================================================
[ppdPrevDayHigh, ppdPrevDayLow, ppdPrevDayClose] = request.security(syminfo.tickerid, "D",
    [high[1], low[1], close[1]], barmerge.gaps_off, barmerge.lookahead_on)

[ppdMA20D, ppdMA50D, ppdMA200D, ppdHigh52Wk, ppdHigh13Wk, ppdHigh1Month, ppdFourWeekHigh, ppdFourWeekLow, ppdThirteenWeekHigh, ppdThirteenWeekLow] = request.security(syminfo.tickerid, "D",
    [ta.sma(close, 20), ta.sma(close, 50), ta.sma(close, 200),
     ta.highest(high, 252), ta.highest(high, 63), ta.highest(high, 21),
     ta.highest(high, 20),  ta.lowest(low,  20),
     ta.highest(high, 65),  ta.lowest(low,  65)],
    barmerge.gaps_off, barmerge.lookahead_off)

//====================================================================
// Section #7.6 | PHASE 2 SECURITY FETCHES — Relative Strength
//====================================================================
float _p2B1PrevClose = request.security(rsBenchmark1, "D",
    close[1], barmerge.gaps_off, barmerge.lookahead_on)
float _p2B1CurClose  = request.security(rsBenchmark1, timeframe.period,
    close,    barmerge.gaps_off, barmerge.lookahead_off)
float _p2B2PrevClose = request.security(rsBenchmark2, "D",
    close[1], barmerge.gaps_off, barmerge.lookahead_on)
float _p2B2CurClose  = request.security(rsBenchmark2, timeframe.period,
    close,    barmerge.gaps_off, barmerge.lookahead_off)

//====================================================================
// Section #8 | PREVIOUS DAY HIGH / LOW
//====================================================================
bool  pdhlActive = showPDHL and timeframe.isintraday
float pdh = pdhlActive ? ppdPrevDayHigh : na
float pdl = pdhlActive ? ppdPrevDayLow  : na

color pdhlLineColor = pdhlLightTheme ? color.new(color.black, 0) : color.new(color.white, 0)
color pdhlTextColor = pdhlLightTheme ? color.new(color.black, 0) : color.new(color.white, 0)

var line  pdhLine  = na
var line  pdlLine  = na
var label pdhLabel = na
var label pdlLabel = na

if pdhlActive and barstate.islast
    int x1 = bar_index + 1
    int x2 = bar_index + 6
    if not na(pdhLine)
        line.delete(pdhLine)
    if not na(pdlLine)
        line.delete(pdlLine)
    if not na(pdhLabel)
        label.delete(pdhLabel)
    if not na(pdlLabel)
        label.delete(pdlLabel)
    pdhLine  := line.new(x1, pdh, x2, pdh, xloc=xloc.bar_index, color=pdhlLineColor, width=1)
    pdlLine  := line.new(x1, pdl, x2, pdl, xloc=xloc.bar_index, color=pdhlLineColor, width=1)
    float labelOffset = (high - low) * 0.001
    int   xMid        = int(math.floor((x1 + x2) * 0.5))
    pdhLabel := label.new(xMid, pdh + labelOffset, "PREVIOUS DAY HIGH", xloc=xloc.bar_index, style=label.style_none, textcolor=pdhlTextColor, size=size.small, textalign=text.align_center)
    pdlLabel := label.new(xMid, pdl - labelOffset, "PREVIOUS DAY LOW",  xloc=xloc.bar_index, style=label.style_none, textcolor=pdhlTextColor, size=size.small, textalign=text.align_center)
else if not pdhlActive
    if not na(pdhLine)
        line.delete(pdhLine)
        pdhLine := na
    if not na(pdlLine)
        line.delete(pdlLine)
        pdlLine := na
    if not na(pdhLabel)
        label.delete(pdhLabel)
        pdhLabel := na
    if not na(pdlLabel)
        label.delete(pdlLabel)
        pdlLabel := na

//====================================================================
// Section #9 | ADX, RSI, DONCHIAN FILTERS
//====================================================================
bool  needDMIrt = eff_useAdxFilter or showAdxBadge or rowADX
float adxVal    = na
float diP       = na
float diM       = na

if needDMIrt
    [adxTemp, diPTemp, diMTemp] = dmi_local(adxLen)
    adxVal := adxTemp
    diP    := diPTemp
    diM    := diMTemp

bool adxOk         = na(adxVal) ? false : adxVal >= eff_adxMin
bool adxAgreeLong  = na(diP) or na(diM) ? false : diP > diM
bool adxAgreeShort = na(diP) or na(diM) ? false : diM > diP

bool  needRSIrt  = useRsiPullback or showRsiBadge or rowRSI
float _rsiRaw    = ta.rsi(rsiSrcM, rsiLenM)
float rsiV       = needRSIrt ? _rsiRaw : na
bool  rsiOkLong  = not eff_useRsiPullback or (rsiV >= math.min(rsiBuyMin,  rsiBuyMax)  and rsiV <= math.max(rsiBuyMin,  rsiBuyMax))
bool  rsiOkShort = not eff_useRsiPullback or (rsiV >= math.min(rsiSellMin, rsiSellMax) and rsiV <= math.max(rsiSellMin, rsiSellMax))

// REPAIR-003: Shifted lookback window to high[1] and low[1] to exclude
// the current bar from the Donchian calculation. Because close <= high
// is always true on any bar, close > ta.highest(high, donLen) (which
// included current bar) was logically impossible and permanently
// blocked all signals when useDonchian was enabled. Using high[1]
// and low[1] measures the prior N bars' extreme, which the current
// close can legitimately exceed on a genuine breakout.
float _donHighRaw = ta.highest(high[1], donLen)
float _donLowRaw  = ta.lowest(low[1],   donLen)
float donHigh  = useDonchian ? _donHighRaw : na
float donLow   = useDonchian ? _donLowRaw  : na
bool  donOkLong  = not useDonchian or (not na(donHigh) and close > donHigh)
bool  donOkShort = not useDonchian or (not na(donLow)  and close < donLow)

longCondBase  := longCondBase  and (not eff_useAdxFilter or (adxOk and adxAgreeLong))  and rsiOkLong  and donOkLong  and volOK
shortCondBase := shortCondBase and (not eff_useAdxFilter or (adxOk and adxAgreeShort)) and rsiOkShort and donOkShort and volOK

//====================================================================
// Section #10 | VISUAL PLOTS
//====================================================================
plot(showMAPlots and showFastMA    ? maShort   : na, "Fast MA",        color=color.rgb(51, 204, 214), linewidth=2)
plot(showMAPlots and showMedMA     ? maMedium  : na, "Medium MA",      color=color.rgb(230, 5, 255),  linewidth=2)
plot(showMAPlots and showMidLongMA ? maMidLong : na, "Medium-Long MA", color=color.rgb(170, 0, 255),  linewidth=3)
plot(showMAPlots and showLongMA    ? maLong    : na, "Long MA",        color=color.new(color.black, 40), linewidth=3)

plot(vwActive ? vwapValue : na, "VWAP", color=color.rgb(6, 58, 245), linewidth=2, offset=offsetBars)
upperBand1Plot = plot(vwActive and bands1On ? upperBandValue1 : na, "Upper Band 1", color=color.lime, offset=offsetBars)
lowerBand1Plot = plot(vwActive and bands1On ? lowerBandValue1 : na, "Lower Band 1", color=color.lime, offset=offsetBars)
fill(upperBand1Plot, lowerBand1Plot, title="VWAP Band 1", color=color.new(color.lime, 98))

upperBand2Plot = plot(vwActive and bands2On ? upperBandValue2 : na, "Upper Band 2", color=color.olive, offset=offsetBars)
lowerBand2Plot = plot(vwActive and bands2On ? lowerBandValue2 : na, "Lower Band 2", color=color.olive, offset=offsetBars)
fill(upperBand2Plot, lowerBand2Plot, title="VWAP Band 2", color=color.new(color.olive, 98))

upperBand3Plot = plot(vwActive and bands3On ? upperBandValue3 : na, "Upper Band 3", color=color.teal, offset=offsetBars)
lowerBand3Plot = plot(vwActive and bands3On ? lowerBandValue3 : na, "Lower Band 3", color=color.teal, offset=offsetBars)
fill(upperBand3Plot, lowerBand3Plot, title="VWAP Band 3", color=color.new(color.teal, 98))

plot(showZLSMA  ? zlsma            : na, "ZLSMA",           color=color.yellow, linewidth=2)
plot(utShowLine ? xATRTrailingStop : na, "UT Trailing Stop", color=color.orange, linewidth=2)

bool utPlotGate = utShowLabels and utVizGate
plotshape(utPlotGate and utBuy,  title="Buy",  text="Buy",  style=shape.labelup,   location=location.belowbar, color=color.aqua,   textcolor=color.white, size=size.tiny)
plotshape(utPlotGate and utSell, title="Sell", text="Sell", style=shape.labeldown, location=location.abovebar, color=color.orange, textcolor=color.white, size=size.tiny)
barcolor(utColorBars ? (barbuy ? color.aqua : barsell ? color.orange : na) : na)

//====================================================================
// Section #11 | SUPERTREND
//====================================================================
bool  stActive = stShow and not (stHideDWM and timeframe.isdwm)
float stTr        = ta.tr
float _atrSatr    = ta.atr(stAtrPeriod)
float _atrSsma    = ta.sma(stTr, stAtrPeriod)
float atrS        = stUseATR ? _atrSatr : _atrSsma

float volWeightRaw = ta.sma(volume, stAtrPeriod)
float volWeight    = volWeightRaw == 0 ? 1.0 : volume / volWeightRaw

float corr         = ta.correlation(close, float(bar_index), stAtrPeriod)
float trendStr     = na(corr) ? 0.5 : math.abs(corr)
float adaptiveMult = eff_stMult * (0.8 + trendStr * 0.4) * math.sqrt(math.max(0.1, volWeight))

float upRaw = stSrc - atrS * adaptiveMult
float dnRaw = stSrc + atrS * adaptiveMult

var float upLine = na
var float dnLine = na

// REPAIR-002: Replaced the EMA smoothing blend with the standard
// Supertrend ratchet. When price is above the prior upLine, the new
// upLine is the maximum of upRaw and upLine[1], ensuring the stop
// never retreats while price is above it. When price is below the
// prior dnLine, the new dnLine is the minimum of dnRaw and dnLine[1],
// ensuring the stop never rises while price is below it. This
// eliminates false bearish flips during uninterrupted uptrends caused
// by the stop retreating when ATR expands.
if na(upLine[1])
    upLine := upRaw
    dnLine := dnRaw
else
    upLine := close > upLine[1] ? math.max(upRaw, upLine[1]) : upRaw
    dnLine := close < dnLine[1] ? math.min(dnRaw, dnLine[1]) : dnRaw

var int stDir = na
stDir := na(stDir[1]) ? (close >= stSrc ? 1 : -1) : stDir[1]
stDir := stDir == -1 and close > dnLine[1] ? 1 : stDir == 1 and close < upLine[1] ? -1 : stDir

bool stFlip        = stDir != stDir[1]
int  barsSinceFlip = ta.barssince(stFlip)
bool neutral       = stNeutralBars > 0 and not na(barsSinceFlip) and barsSinceFlip >= 0 and barsSinceFlip < stNeutralBars

float upSeg = stActive and stDir ==  1 and not neutral ? upLine : na
float dnSeg = stActive and stDir == -1 and not neutral ? dnLine : na

float gapVal    = stDir == 1 ? close - upLine : dnLine - close
float rawStrPre = stShow and not neutral and atrS > 0 and not na(gapVal) ? math.max(0.0, gapVal / atrS) : na
float capS      = na(rawStrPre) ? na : math.min(rawStrPre, dynCapATR)

float _capSInput = nz(capS, 0.0)
float _emaCapS   = ta.ema(_capSInput, dynSmoothLen)
float sStr       = na(capS) ? na : _emaCapS
float norm       = na(sStr) ? 0.0 : math.max(0.0, math.min(1.0, sStr / dynCapATR))

float uFar = stFillOn and stDir ==  1 ? upLine + math.min(gapVal, atrS * dynCapATR) : na
float dFar = stFillOn and stDir == -1 ? dnLine - math.min(gapVal, atrS * dynCapATR) : na

color ST_BULL = color.new(color.green, 20)
color ST_BEAR = color.new(color.red,   20)

pUfar    = plot(uFar, "ST Up Haze Line",   style=plot.style_stepline, display=display.none, editable=false)
pDfar    = plot(dFar, "ST Down Haze Line", style=plot.style_stepline, display=display.none, editable=false)

int stLineWidth = stFillOn ? 2 : 4
stUpPlot = plot(stActive ? upSeg : na, "Supertrend Up",   style=plot.style_linebr, linewidth=stLineWidth, color=ST_BULL, editable=false)
stDnPlot = plot(stActive ? dnSeg : na, "Supertrend Down", style=plot.style_linebr, linewidth=stLineWidth, color=ST_BEAR, editable=false)

fill(stUpPlot, pUfar, color=stFillOn ? color.new(ST_BULL, 92) : na, title="ST Up Haze",   editable=false)
fill(stDnPlot, pDfar, color=stFillOn ? color.new(ST_BEAR, 92) : na, title="ST Down Haze", editable=false)

plotshape(stShow and stFlip and stDir ==  1 ? upLine : na, title="ST Bull Start", location=location.absolute, style=shape.circle, size=size.tiny, color=ST_BULL, editable=false)
plotshape(stShow and stFlip and stDir == -1 ? dnLine : na, title="ST Bear Start", location=location.absolute, style=shape.circle, size=size.tiny, color=ST_BEAR, editable=false)

//====================================================================
// Section #12 | BASE SIGNALS
//====================================================================
// REPAIR-007: Swapped style and location for both plotshape calls so
// that LONG signals display as upward-pointing arrows below the bar
// and SHORT signals display as downward-pointing arrows above the bar,
// matching universal trading chart convention. The previous config
// placed a downward arrow for LONG and an upward arrow for SHORT,
// which was visually inverted and could cause incorrect trade decisions.
plotshape(showBaseSignals and longCondBase,  title="Market LONG",  text="Market LONG",  style=shape.labelup,   location=location.belowbar, color=color.green, textcolor=color.white, size=size.tiny)
plotshape(showBaseSignals and shortCondBase, title="Market SHORT", text="Market SHORT", style=shape.labeldown, location=location.abovebar, color=color.red,   textcolor=color.white, size=size.tiny)

plot(donHigh, "Donchian High", display=display.none)
plot(donLow,  "Donchian Low",  display=display.none)

//====================================================================
// Section #13 | ENTRY, STOP LOSS, TAKE PROFIT VISUALS
//====================================================================
calcLongSL(_entry) =>
    float stFloor  = stActive and stDir == 1 ? upLine : na
    float vwFloor  = vwActive ? vwapValue : na
    float donFloor = useDonchian ? donLow : ta.lowest(low, eff_swingLen)
    float emaFloor = maLong
    float atrFloor = xATRTrailingStop
    float sl = na
    if not na(atrFloor) and atrFloor < _entry
        sl := atrFloor
    if not na(stFloor)  and stFloor  < _entry
        sl := na(sl) ? stFloor  : math.max(sl, stFloor)
    if not na(vwFloor)  and vwFloor  < _entry
        sl := na(sl) ? vwFloor  : math.max(sl, vwFloor)
    if not na(donFloor) and donFloor < _entry
        sl := na(sl) ? donFloor : math.max(sl, donFloor)
    if not na(emaFloor) and emaFloor < _entry
        sl := na(sl) ? emaFloor : math.max(sl, emaFloor)
    if na(sl)
        sl := _entry - xATR * 1.50
    sl - xATR * 0.10

calcShortSL(_entry) =>
    float stCeil  = stActive and stDir == -1 ? dnLine : na
    float vwCeil  = vwActive ? vwapValue : na
    float donCeil = useDonchian ? donHigh : ta.highest(high, eff_swingLen)
    float emaCeil = maLong
    float atrCeil = xATRTrailingStop
    float sl = na
    if not na(atrCeil) and atrCeil > _entry
        sl := atrCeil
    if not na(stCeil)  and stCeil  > _entry
        sl := na(sl) ? stCeil  : math.min(sl, stCeil)
    if not na(vwCeil)  and vwCeil  > _entry
        sl := na(sl) ? vwCeil  : math.min(sl, vwCeil)
    if not na(donCeil) and donCeil > _entry
        sl := na(sl) ? donCeil : math.min(sl, donCeil)
    if not na(emaCeil) and emaCeil > _entry
        sl := na(sl) ? emaCeil : math.min(sl, emaCeil)
    if na(sl)
        sl := _entry + xATR * 1.50
    sl + xATR * 0.10

var line  entryLine  = na
var label entryLbl   = na
var float entryPx    = na
var int   entryBar   = na
var color entryCol   = na

var line  slLine     = na
var label slLbl      = na
var int   slStartBar = na
var float slPrice    = na
var color slColor    = na
var float baseSl     = na

const float TP1  = 1.0
const float TP15 = 1.5
const float TP2  = 2.0
const float TP3  = 3.0

var line  tp1Line  = na
var line  tp15Line = na
var line  tp2Line  = na
var line  tp3Line  = na
var label tp1Lbl   = na
var label tp15Lbl  = na
var label tp2Lbl   = na
var label tp3Lbl   = na
var float tp1Y     = na
var float tp15Y    = na
var float tp2Y     = na
var float tp3Y     = na
var float tpInitRisk = na

var bool  legDone     = false
var int   legDoneBar  = na
var bool  slFrozen    = false
var bool  entryFrozen = false
var bool  tp1Frozen   = false
var bool  tp15Frozen  = false
var bool  tp2Frozen   = false
var bool  tp3Frozen   = false
var bool  tp1Hit      = false
var bool  tp15Hit     = false
var bool  tp2Hit      = false
var bool  tp3Hit      = false
var int   tradeDir    = na
var int   lastFlipBar = na
var float entry       = na

bool commitFlip = (utBuy or utSell) and (not drawUtvizOnClose or barstate.isconfirmed)

if rtFlipAlerts and commitFlip and lastFlipBar != bar_index
    lastFlipBar := bar_index
    alert("UT FLIP " + (utBuy ? "BUY" : "SELL") + " | " + syminfo.ticker + " " + timeframe.period + " | Close: " + str.tostring(close), alert.freq_once_per_bar_close)

if commitFlip
    slFrozen    := false
    entryFrozen := false
    tp1Frozen   := false
    tp15Frozen  := false
    tp2Frozen   := false
    tp3Frozen   := false
    tp1Hit      := false
    tp15Hit     := false
    tp2Hit      := false
    tp3Hit      := false
    legDone     := false
    legDoneBar  := na

    if not na(slLine)
        line.delete(slLine)
        slLine := na
    if not na(slLbl)
        label.delete(slLbl)
        slLbl := na
    if not na(tp1Line)
        line.delete(tp1Line)
        tp1Line := na
    if not na(tp15Line)
        line.delete(tp15Line)
        tp15Line := na
    if not na(tp2Line)
        line.delete(tp2Line)
        tp2Line := na
    if not na(tp3Line)
        line.delete(tp3Line)
        tp3Line := na
    if not na(tp1Lbl)
        label.delete(tp1Lbl)
        tp1Lbl := na
    if not na(tp15Lbl)
        label.delete(tp15Lbl)
        tp15Lbl := na
    if not na(tp2Lbl)
        label.delete(tp2Lbl)
        tp2Lbl := na
    if not na(tp3Lbl)
        label.delete(tp3Lbl)
        tp3Lbl := na

    slStartBar := bar_index
    entry      := close
    float _slLong  = calcLongSL(entry)
    float _slShort = calcShortSL(entry)
    baseSl     := utBuy ? _slLong : _slShort

    float extra = slExtraTicks * syminfo.mintick
    slPrice     := utBuy ? baseSl - extra : baseSl + extra
    slColor     := utBuy ? color.aqua : color.orange

    float minFloor = xATR * 1.60
    if utBuy  and slPrice >= entry
        slPrice := entry - minFloor
    if utSell and slPrice <= entry
        slPrice := entry + minFloor

    tradeDir := utBuy ? 1 : -1

    if slFeatureOn
        slLine := line.new(slStartBar, slPrice, slStartBar, slPrice, xloc=xloc.bar_index, extend=extend.none, color=slColor, width=1)
        slLbl  := label.new(slStartBar, slPrice, "Suggested Stop Loss", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=slColor)

    tpInitRisk := math.abs(entry - baseSl)
    tp1Y  := tp1On  ? (utBuy ? entry + tpInitRisk * TP1  : entry - tpInitRisk * TP1)  : na
    tp15Y := tp15On ? (utBuy ? entry + tpInitRisk * TP15 : entry - tpInitRisk * TP15) : na
    tp2Y  := tp2On  ? (utBuy ? entry + tpInitRisk * TP2  : entry - tpInitRisk * TP2)  : na
    tp3Y  := tp3On  ? (utBuy ? entry + tpInitRisk * TP3  : entry - tpInitRisk * TP3)  : na

    if tpFeatureOn
        if tp1On and not na(tp1Y)
            tp1Line := line.new(slStartBar, tp1Y,  bar_index, tp1Y,  xloc=xloc.bar_index, extend=extend.none, color=slColor, width=1)
            tp1Lbl  := label.new(bar_index,  tp1Y,  "TP1",   xloc=xloc.bar_index, style=label.style_label_right, textcolor=color.white, color=slColor, size=size.small)
        if tp15On and not na(tp15Y)
            tp15Line := line.new(slStartBar, tp15Y, bar_index, tp15Y, xloc=xloc.bar_index, extend=extend.none, color=slColor, width=1)
            tp15Lbl  := label.new(bar_index,  tp15Y, "TP1.5", xloc=xloc.bar_index, style=label.style_label_right, textcolor=color.white, color=slColor, size=size.small)
        if tp2On and not na(tp2Y)
            tp2Line := line.new(slStartBar, tp2Y,  bar_index, tp2Y,  xloc=xloc.bar_index, extend=extend.none, color=slColor, width=1)
            tp2Lbl  := label.new(bar_index,  tp2Y,  "TP2",   xloc=xloc.bar_index, style=label.style_label_right, textcolor=color.white, color=slColor, size=size.small)
        if tp3On and not na(tp3Y)
            tp3Line := line.new(slStartBar, tp3Y,  bar_index, tp3Y,  xloc=xloc.bar_index, extend=extend.none, color=slColor, width=1)
            tp3Lbl  := label.new(bar_index,  tp3Y,  "TP3",   xloc=xloc.bar_index, style=label.style_label_right, textcolor=color.white, color=slColor, size=size.small)

    if not na(entryLine)
        line.delete(entryLine)
        entryLine := na
    if not na(entryLbl)
        label.delete(entryLbl)
        entryLbl := na

    entryPx  := close
    entryBar := bar_index
    entryCol := slColor

    if entryFeatureOn
        entryLine := line.new(entryBar, entryPx, entryBar, entryPx, xloc=xloc.bar_index, extend=extend.none, color=entryCol, width=1)
        entryLbl  := label.new(entryBar, entryPx, "ENTRY", xloc=xloc.bar_index, style=label.style_label_right, textcolor=color.white, color=entryCol, size=size.small)

bool inLegNow = not na(tradeDir)
int  dirNow   = na(tradeDir) ? 0 : tradeDir

if inLegNow and not slFrozen and not na(slPrice) and not na(slStartBar)
    float tol = syminfo.mintick * 0.51
    bool  wickHit = dirNow == 1 ? low <= slPrice + tol : high >= slPrice - tol
    if wickHit
        slFrozen    := true
        entryFrozen := true
        legDone     := true
        legDoneBar  := bar_index
        if na(slLine)
            slLine := line.new(slStartBar, slPrice, slStartBar, slPrice, xloc=xloc.bar_index, extend=extend.none, color=slColor, width=1)
        if na(slLbl)
            slLbl := label.new(slStartBar, slPrice, "Suggested Stop Loss", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=slColor)
        label.set_text(slLbl,  "SL Touched")
        label.set_style(slLbl, label.style_label_left)

int slX2raw = not na(slStartBar) ? (slLimit10 ? math.min(bar_index, slStartBar + 10) : bar_index) : bar_index
int slX2    = not na(legDoneBar) ? math.min(slX2raw, legDoneBar) : slX2raw
int tpX2raw = not na(slStartBar) ? (tpLimit10 ? math.min(bar_index, slStartBar + 10) : bar_index) : bar_index
int tpX2    = not na(legDoneBar) ? math.min(tpX2raw, legDoneBar) : tpX2raw

if not na(slLine)
    line.set_x1(slLine, slStartBar)
    line.set_x2(slLine, slX2)
    line.set_y1(slLine, slPrice)
    line.set_y2(slLine, slPrice)
if not na(slLbl)
    label.set_x(slLbl, slX2)
    label.set_y(slLbl, slPrice)

if not na(tp1Line)
    line.set_x2(tp1Line, tpX2)
    line.set_y1(tp1Line, tp1Y)
    line.set_y2(tp1Line, tp1Y)
if not na(tp1Lbl)
    label.set_x(tp1Lbl, tpX2)
    label.set_y(tp1Lbl, tp1Y)
    label.set_style(tp1Lbl, label.style_label_left)

if not na(tp15Line)
    line.set_x2(tp15Line, tpX2)
    line.set_y1(tp15Line, tp15Y)
    line.set_y2(tp15Line, tp15Y)
if not na(tp15Lbl)
    label.set_x(tp15Lbl, tpX2)
    label.set_y(tp15Lbl, tp15Y)
    label.set_style(tp15Lbl, label.style_label_left)

if not na(tp2Line)
    line.set_x2(tp2Line, tpX2)
    line.set_y1(tp2Line, tp2Y)
    line.set_y2(tp2Line, tp2Y)
if not na(tp2Lbl)
    label.set_x(tp2Lbl, tpX2)
    label.set_y(tp2Lbl, tp2Y)
    label.set_style(tp2Lbl, label.style_label_left)

if not na(tp3Line)
    line.set_x2(tp3Line, tpX2)
    line.set_y1(tp3Line, tp3Y)
    line.set_y2(tp3Line, tp3Y)
if not na(tp3Lbl)
    label.set_x(tp3Lbl, tpX2)
    label.set_y(tp3Lbl, tp3Y)
    label.set_style(tp3Lbl, label.style_label_left)

if tpFreezeOnTouch and not legDone and not na(entryBar) and bar_index > entryBar
    if tp1On and not tp1Frozen and not na(tp1Y) and ((tradeDir == 1 and high >= tp1Y) or (tradeDir == -1 and low <= tp1Y))
        tp1Frozen := true
        tp1Hit    := true
        if not na(tp1Lbl)
            label.set_text(tp1Lbl, "TP1 Hit")
    if tp15On and not tp15Frozen and not na(tp15Y) and ((tradeDir == 1 and high >= tp15Y) or (tradeDir == -1 and low <= tp15Y))
        tp15Frozen := true
        tp15Hit    := true
        if not na(tp15Lbl)
            label.set_text(tp15Lbl, "TP1.5 Hit")
    if tp2On and not tp2Frozen and not na(tp2Y) and ((tradeDir == 1 and high >= tp2Y) or (tradeDir == -1 and low <= tp2Y))
        tp2Frozen := true
        tp2Hit    := true
        if not na(tp2Lbl)
            label.set_text(tp2Lbl, "TP2 Hit")
    if tp3On and not tp3Frozen and not na(tp3Y) and ((tradeDir == 1 and high >= tp3Y) or (tradeDir == -1 and low <= tp3Y))
        tp3Frozen := true
        tp3Hit    := true
        if not na(tp3Lbl)
            label.set_text(tp3Lbl, "TP3 Hit")

float farTP = na
if tradeDir == 1
    farTP := tp1On  and not na(tp1Y)  ? tp1Y  : na
    if tp15On and not na(tp15Y)
        farTP := na(farTP) ? tp15Y : math.max(farTP, tp15Y)
    if tp2On  and not na(tp2Y)
        farTP := na(farTP) ? tp2Y  : math.max(farTP, tp2Y)
    if tp3On  and not na(tp3Y)
        farTP := na(farTP) ? tp3Y  : math.max(farTP, tp3Y)
else if tradeDir == -1
    farTP := tp1On  and not na(tp1Y)  ? tp1Y  : na
    if tp15On and not na(tp15Y)
        farTP := na(farTP) ? tp15Y : math.min(farTP, tp15Y)
    if tp2On  and not na(tp2Y)
        farTP := na(farTP) ? tp2Y  : math.min(farTP, tp2Y)
    if tp3On  and not na(tp3Y)
        farTP := na(farTP) ? tp3Y  : math.min(farTP, tp3Y)

bool touchedFar = not na(entryBar) and bar_index > entryBar and not na(farTP) and not legDone and ((tradeDir == 1 and high >= farTP) or (tradeDir == -1 and low <= farTP))
if touchedFar
    legDone     := true
    legDoneBar  := bar_index
    slFrozen    := true
    entryFrozen := true
    if not na(slLbl)
        label.set_text(slLbl, "SL Frozen")

if not na(entryLine) and not na(entryBar) and not na(entryPx)
    int entryX2Live   = tpLimit10 ? math.min(bar_index, entryBar + 10) : bar_index
    int entryX2Frozen = not na(legDoneBar) ? (tpLimit10 ? math.min(legDoneBar, entryBar + 10) : legDoneBar) : entryX2Live
    int entryX2Final  = (entryFrozen or legDone) ? entryX2Frozen : entryX2Live
    line.set_x1(entryLine,  entryBar)
    line.set_x2(entryLine,  entryX2Final)
    line.set_y1(entryLine,  entryPx)
    line.set_y2(entryLine,  entryPx)
    if not na(entryLbl)
        label.set_x(entryLbl,     entryX2Final)
        label.set_y(entryLbl,     entryPx)
        label.set_style(entryLbl, label.style_label_left)
        label.set_text(entryLbl,  "ENTRY")

if not slFeatureOn
    if not na(slLine)
        line.delete(slLine)
        slLine := na
    if not na(slLbl)
        label.delete(slLbl)
        slLbl := na

if not tpFeatureOn
    if not na(tp1Line)
        line.delete(tp1Line)
        tp1Line := na
    if not na(tp15Line)
        line.delete(tp15Line)
        tp15Line := na
    if not na(tp2Line)
        line.delete(tp2Line)
        tp2Line := na
    if not na(tp3Line)
        line.delete(tp3Line)
        tp3Line := na
    if not na(tp1Lbl)
        label.delete(tp1Lbl)
        tp1Lbl := na
    if not na(tp15Lbl)
        label.delete(tp15Lbl)
        tp15Lbl := na
    if not na(tp2Lbl)
        label.delete(tp2Lbl)
        tp2Lbl := na
    if not na(tp3Lbl)
        label.delete(tp3Lbl)
        tp3Lbl := na

if not entryFeatureOn
    if not na(entryLine)
        line.delete(entryLine)
        entryLine := na
    if not na(entryLbl)
        label.delete(entryLbl)
        entryLbl := na

//====================================================================
// Section #14 | ALERTS
//====================================================================
// REPAIR-006: barstate.isconfirmed gate added to all four alertcondition
// calls. Base Long and Base Short messages enriched with ticker,
// interval, and close data.
//
// VERIFICATION FIX: The two alert() calls below are now gated on
// rtFlipAlerts. Previously they fired unconditionally on every confirmed
// utBuy and utSell bar, bypassing the rtFlipAlerts input and creating
// a permanent always-on alert pathway that the user could not disable.
// Section 13 already contains a separate rtFlipAlerts-gated alert()
// call that fires on commitFlip. These Section 14 calls provide a
// distinct "Momentum Buy/Sell Signal" message format and are now
// correctly placed under the same rtFlipAlerts user control.
alertcondition(utBuy and barstate.isconfirmed,         title="Momentum Buy Signal",  message="Momentum Buy Signal | {{ticker}} {{interval}} | Close: {{close}}")
alertcondition(utSell and barstate.isconfirmed,        title="Momentum Sell Signal", message="Momentum Sell Signal | {{ticker}} {{interval}} | Close: {{close}}")
alertcondition(longCondBase and barstate.isconfirmed,  title="Base Long",            message="Base Long | {{ticker}} {{interval}} | Close: {{close}}")
alertcondition(shortCondBase and barstate.isconfirmed, title="Base Short",           message="Base Short | {{ticker}} {{interval}} | Close: {{close}}")

if rtFlipAlerts and utBuy  and barstate.isconfirmed
    alert("Momentum Buy Signal | "  + syminfo.ticker + " " + timeframe.period + " | Close: " + str.tostring(close), alert.freq_once_per_bar_close)
if rtFlipAlerts and utSell and barstate.isconfirmed
    alert("Momentum Sell Signal | " + syminfo.ticker + " " + timeframe.period + " | Close: " + str.tostring(close), alert.freq_once_per_bar_close)

//====================================================================
// Section #15 | LABELS
//====================================================================
float refOpen = request.security(syminfo.tickerid, "D", open, barmerge.gaps_off, barmerge.lookahead_off)
float yMid    = (high + low) * 0.5

var label rsiLbl       = na
var label adxLbl       = na
var label deltaOpenLbl = na
var label presetLbl    = na

if barstate.islast
    if showRsiBadge
        float bMin = useClassicRSIBias ? 0.0   : math.min(rsiBuyMin,  rsiBuyMax)
        float bMax = useClassicRSIBias ? 30.0  : math.max(rsiBuyMin,  rsiBuyMax)
        float sMin = useClassicRSIBias ? 70.0  : math.min(rsiSellMin, rsiSellMax)
        float sMax = useClassicRSIBias ? 100.0 : math.max(rsiSellMin, rsiSellMax)
        bool longZone   = rsiV > bMin and rsiV < bMax
        bool shortZone  = rsiV >= sMin and rsiV <= sMax
        bool neutralRSI = not (longZone or shortZone)
        color rsiBg  = neutralRSI ? color.new(color.yellow, 0) : longZone ? color.new(color.green, 0) : color.new(color.red, 0)
        color rsiFg  = neutralRSI ? color.black : color.white
        string rsiTxt = "RSI " + str.tostring(rsiV, "#.##") + (neutralRSI ? " Neutral" : longZone ? " Long Zone" : " Short Zone")
        if na(rsiLbl)
            rsiLbl := label.new(bar_index, high, "", style=label.style_label_down, textcolor=rsiFg, color=rsiBg)
        label.set_x(rsiLbl,         bar_index)
        label.set_y(rsiLbl,         high)
        label.set_size(rsiLbl,      size.small)
        label.set_color(rsiLbl,     rsiBg)
        label.set_textcolor(rsiLbl, rsiFg)
        label.set_text(rsiLbl,      rsiTxt)
    else
        if not na(rsiLbl)
            label.delete(rsiLbl)
            rsiLbl := na

    if showAdxBadge
        color adxBg = adxVal >= 75 ? adxColor75100 : adxVal >= 50 ? adxColor5075 : adxVal >= 25 ? adxColor2550 : adxColor025
        color adxFg = adxVal >= 25 ? color.black : color.white
        if na(adxLbl)
            adxLbl := label.new(bar_index, low, "", style=label.style_label_up, textcolor=adxFg, color=adxBg)
        label.set_x(adxLbl,         bar_index)
        label.set_y(adxLbl,         low)
        label.set_color(adxLbl,     adxBg)
        label.set_textcolor(adxLbl, adxFg)
        label.set_size(adxLbl,      size.small)
        label.set_text(adxLbl,      "ADX " + str.tostring(nz(adxVal), "#.##"))
    else
        if not na(adxLbl)
            label.delete(adxLbl)
            adxLbl := na

    if showDeltaOpen and not na(refOpen) and refOpen != 0
        float dPct = (close - refOpen) / refOpen * 100.0
        string sgn = dPct >= 0 ? "+" : ""
        string txt = "Change from Open " + sgn + str.tostring(dPct, "0." + str.repeat("0", deltaOpenDec)) + "%"
        color  fg  = color.white
        color  bg  = dPct >= 0 ? color.rgb(1, 131, 6) : color.red
        if na(deltaOpenLbl)
            deltaOpenLbl := label.new(bar_index + 1, yMid, txt, xloc=xloc.bar_index, style=label.style_label_left, textcolor=fg, color=bg, size=size.normal)
        label.set_x(deltaOpenLbl,     bar_index + 1)
        label.set_y(deltaOpenLbl,     yMid)
        label.set_text(deltaOpenLbl,      txt)
        label.set_textcolor(deltaOpenLbl, fg)
        label.set_color(deltaOpenLbl,     bg)
    else
        if not na(deltaOpenLbl)
            label.delete(deltaOpenLbl)
            deltaOpenLbl := na

    if isPresetOn
        color pBg = isPresetNVDA ? color.rgb(118,0,182) : isPresetAAPL ? color.rgb(0,122,255) : isPresetAMD ? color.rgb(219,68,55) : isPresetTSLA ? color.rgb(204,0,0) : color.rgb(0,150,50)
        if na(presetLbl)
            presetLbl := label.new(bar_index, high, eff_presetLabel, xloc=xloc.bar_index, yloc=yloc.abovebar, style=label.style_label_down, textcolor=color.white, color=pBg, size=size.small)
        label.set_x(presetLbl,    bar_index)
        label.set_text(presetLbl, eff_presetLabel)
        label.set_color(presetLbl, pBg)
    else
        if not na(presetLbl)
            label.delete(presetLbl)
            presetLbl := na

//====================================================================
// Section #16 | CANDLESTICK PATTERNS
//====================================================================
// REPAIR-011: All 12 cndl_* series declarations have been moved inside
// the if showCandlePatterns block. They were previously computed
// unconditionally on every bar even when showCandlePatterns was false
// (the default). Moving them inside the conditional block eliminates
// 12 unnecessary rolling series computations for all users who have
// the feature disabled.
//
// REPAIR-012: Morning Star now requires close[2] < open[2] (bar-2 must
// be a bearish candle) and math.abs(close[2]-open[2]) > cndl_atr5*0.5
// (bar-2 must have a meaningful body). Evening Star now requires
// close[2] > open[2] and the same minimum body check. Without these
// guards both patterns could fire in trending markets whenever RSI
// briefly touched the oversold or overbought zone.
if showCandlePatterns
    float cndl_rsi5      = ta.rsi(close, 5)
    float cndl_rsi7      = ta.rsi(close, 7)
    float cndl_rsi7Prev  = ta.rsi(close, 7)[1]
    float cndl_rsi14_2   = ta.rsi(close, 14)[2]
    float cndl_volSma10  = ta.sma(volume, 10)
    float cndl_volSma5   = ta.sma(volume, 5)
    float cndl_volSma20  = ta.sma(volume, 20)
    float cndl_atr5      = ta.atr(5)
    float cndl_lowL20    = ta.lowest(low,  20)[1]
    float cndl_highH20   = ta.highest(high, 20)[1]
    bool  cndl_macdXO    = ta.crossover(macdLine,  signalLine)
    bool  cndl_macdXU    = ta.crossunder(macdLine, signalLine)

    float bodySize     = math.abs(close - open)
    float candleRange  = high - low + 0.0001
    float bodyPct      = close != 0 ? bodySize / close * 100.0 : 0.0
    bool  bodyMeetsMin = bodyPct >= minCandleBodyPct

    bool bullEngulf = false
    if showBullEngulf and bar_index > 0 and bodyMeetsMin
        bool prevRed       = close[1] < open[1]
        bool bodyCoversAll = open < close[1] and close > open[1]
        bullEngulf := (prevRed and bodyCoversAll and close > open and cndl_rsi5 < 55 and volume > cndl_volSma10 * 1.3)

    bool bearEngulf = false
    if showBearEngulf and bar_index > 0 and bodyMeetsMin
        bool prevGreen     = close[1] > open[1]
        bool bodyCoversAll = open > close[1] and close < open[1]
        bearEngulf := (prevGreen and bodyCoversAll and close < open and cndl_rsi5 > 45 and volume > cndl_volSma10 * 1.0)

    bool hammerPat = false
    if showHammer and bodyMeetsMin
        float lowerWick   = math.min(open, close) - low
        float upperWick   = high - math.max(open, close)
        bool  hammerShape = (lowerWick >= 2.0 * bodySize and upperWick <= 0.30 * candleRange)
        bool  nearLow     = low <= cndl_lowL20 * 1.005
        bool  prevBearCtx = close[1] < open[1]
        bool  rsiOk       = (cndl_rsi7 > cndl_rsi7Prev and cndl_rsi7 < 50)
        hammerPat := (hammerShape and nearLow and prevBearCtx and rsiOk and volume > cndl_volSma5)

    bool shootingStarPat = false
    if showShootingStar and bodyMeetsMin
        float upperWick2   = high - math.max(open, close)
        float lowerWick2   = math.min(open, close) - low
        bool  starShape    = (upperWick2 >= 2.0 * bodySize and lowerWick2 <= 0.30 * candleRange)
        bool  nearHigh     = high >= cndl_highH20 * 0.99
        bool  prevBullCtx  = close[1] > open[1]
        bool  rsiOk2       = (cndl_rsi7 < cndl_rsi7Prev and cndl_rsi7 > 50)
        shootingStarPat := (starShape and nearHigh and prevBullCtx and rsiOk2 and volume < cndl_volSma5 * 1.1)

    bool morningStarPat = false
    if showMorningStar and bar_index > 2 and bodyMeetsMin
        bool volPatternM = volume[1] < cndl_volSma20 * 0.7 and volume > cndl_volSma20 * 1.2
        bool bearCandle2 = close[2] < open[2]
        bool largeBody2  = math.abs(close[2] - open[2]) > cndl_atr5 * 0.5
        morningStarPat := bearCandle2 and largeBody2 and cndl_rsi14_2 < 35 and ((close - close[2]) / close[2] * 100) > 1.5 and volPatternM and low[1] < low[2] and close > high[1] and (cndl_macdXO or close > maMedium)

    bool eveningStarPat = false
    if showEveningStar and bar_index > 2 and bodyMeetsMin
        bool volPatternE = volume[1] < cndl_volSma20 * 0.7 and volume > cndl_volSma20 * 1.2
        bool bullCandle2 = close[2] > open[2]
        bool largeBody2E = math.abs(close[2] - open[2]) > cndl_atr5 * 0.5
        eveningStarPat := bullCandle2 and largeBody2E and cndl_rsi14_2 > 65 and ((close - close[2]) / close[2] * 100) < -1.5 and volPatternE and high[1] > high[2] and close < low[1] and (cndl_macdXU or close < maMedium)

    bool insideBarPat = false
    if showInsideBar and bar_index > 0
        bool isInside        = high <= high[1] and low >= low[1]
        bool motherBigEnough = not insideBarStrict or ((high[1] - low[1]) >= cndl_atr5 * 0.8)
        insideBarPat := isInside and motherBigEnough

    bool tweezTopPat  = false
    float atrTolTop   = na
    float pctTolTop   = na
    float finalTolTop = na
    bool equalHi      = false
    bool afterUp      = false
    bool prevBullBody = false
    bool currReject   = false
    bool nearRecentHi = false

    if showTweezTop and bar_index > 3
        atrTolTop   := cndl_atr5 * tweezTolInput
        pctTolTop   := close * 0.0005
        finalTolTop := math.min(atrTolTop, pctTolTop)
        equalHi      := math.abs(high - high[1]) <= finalTolTop
        afterUp      := close[1] > close[3] and close > close[2]
        prevBullBody := close[1] > open[1]
        currReject   := high > math.max(open, close) and close <= open
        nearRecentHi := high >= ta.highest(high, 10)[1] * 0.995
        tweezTopPat  := equalHi and afterUp and prevBullBody and currReject and nearRecentHi and bodyMeetsMin

    bool tweezBotPat  = false
    float atrTolBot   = na
    float pctTolBot   = na
    float finalTolBot = na
    bool equalLo      = false
    bool afterDn      = false
    bool prevBearBody = false
    bool currSupport  = false
    bool nearRecentLo = false

    if showTweezBot and bar_index > 3
        atrTolBot   := cndl_atr5 * tweezTolInput
        pctTolBot   := close * 0.0005
        finalTolBot := math.min(atrTolBot, pctTolBot)
        equalLo      := math.abs(low - low[1]) <= finalTolBot
        afterDn      := close[1] < close[3] and close < close[2]
        prevBearBody := close[1] < open[1]
        currSupport  := low < math.min(open, close) and close >= open
        nearRecentLo := low <= ta.lowest(low, 10)[1] * 1.005
        tweezBotPat  := equalLo and afterDn and prevBearBody and currSupport and nearRecentLo and bodyMeetsMin

    bool dojiPat        = false
    bool dojiDragonfly  = false
    bool dojiGravestone = false
    if showDoji and candleRange > syminfo.mintick
        float dojiBodyRangePct = bodySize / candleRange * 100.0
        if dojiBodyRangePct <= dojiMaxBodyPct
            float lowerWickD = math.min(open, close) - low
            float upperWickD = high - math.max(open, close)
            if lowerWickD >= candleRange * 0.60 and upperWickD <= candleRange * 0.10
                dojiDragonfly := true
            else if upperWickD >= candleRange * 0.60 and lowerWickD <= candleRange * 0.10
                dojiGravestone := true
            else
                dojiPat := true

    if bullEngulf
        label.new(bar_index, low,  "BullEngulf", yloc=yloc.belowbar, style=label.style_none, color=color.new(color.green,  100), textcolor=color.green,  size=size.small)
    if bearEngulf
        label.new(bar_index, high, "BearEngulf", yloc=yloc.abovebar, style=label.style_none, color=color.new(color.red,    100), textcolor=color.red,    size=size.small)
    if hammerPat
        label.new(bar_index, low,  "Hammer",     yloc=yloc.belowbar, style=label.style_none, color=color.new(color.yellow, 100), textcolor=color.yellow, size=size.small)
    if shootingStarPat
        label.new(bar_index, high, "ShootStar",  yloc=yloc.abovebar, style=label.style_none, color=color.new(color.orange, 100), textcolor=color.orange, size=size.small)
    if morningStarPat
        label.new(bar_index, low,  "MornStar",   yloc=yloc.belowbar, style=label.style_none, color=color.new(color.lime,   100), textcolor=color.lime,   size=size.small)
    if eveningStarPat
        label.new(bar_index, high, "EveStar",    yloc=yloc.abovebar, style=label.style_none, color=color.new(color.maroon, 100), textcolor=color.maroon, size=size.small)
    if insideBarPat
        label.new(bar_index, low,  "InsideBar",  yloc=yloc.belowbar, style=label.style_none, color=color.new(color.purple, 100), textcolor=color.purple, size=size.small)
    if tweezTopPat
        label.new(bar_index, high, "TweezTop",   yloc=yloc.abovebar, style=label.style_none, color=color.new(color.red,    100), textcolor=color.red,    size=size.small)
    if tweezBotPat
        label.new(bar_index, low,  "TweezBot",   yloc=yloc.belowbar, style=label.style_none, color=color.new(color.blue,   100), textcolor=color.blue,   size=size.small)
    if dojiDragonfly
        label.new(bar_index, low,  "Dragonfly",  yloc=yloc.belowbar, style=label.style_none, color=color.new(color.teal,   100), textcolor=color.teal,   size=size.small)
    if dojiGravestone
        label.new(bar_index, high, "Gravestone", yloc=yloc.abovebar, style=label.style_none, color=color.new(color.fuchsia,100), textcolor=color.fuchsia,size=size.small)
    if dojiPat
        label.new(bar_index, low,  "Doji",       yloc=yloc.belowbar, style=label.style_none, color=color.new(color.silver, 100), textcolor=color.silver, size=size.small)

//====================================================================
// Section #17 | BIAS TABLE HELPERS
//====================================================================
const string vixSymbol = "TVC:VIX"
const string vixTF     = "D"
const float  VIX_LOW   = 18.0
const float  VIX_HIGH  = 22.0

string sessStrRaw = (sessPreset == "New York (NYSE 09:30-16:00)"         ? "0930-1600" :
                     sessPreset == "London (LSE 08:00-16:30)"            ? "0800-1630" :
                     sessPreset == "Tokyo (TSE 09:00-11:30,12:30-15:00)" ? "0900-1130,1230-1500" :
                     sessCustom)

bool   isFullDay = sess_minutes(sessStrRaw) >= 1435
string sessStr   = isFullDay ? "0930-1600" : sessStrRaw

or_bias_band_status_series() =>
    string result = "Not Open"
    if timeframe.isintraday
        bool inSess  = not na(time(timeframe.period, sessStr))
        bool newDay  = ta.change(time("D")) != 0
        bool openEvt = session.isfirstbar_regular or (inSess and not inSess[1] and newDay)

        var int openTime = na
        if openEvt
            openTime := time

        int minsSince = inSess and not na(openTime) ? int(math.floor((time - openTime) / 60000)) : na

        bool d5  = inSess and not na(minsSince) and minsSince >= 5
        bool d15 = inSess and not na(minsSince) and minsSince >= 15
        bool d30 = inSess and not na(minsSince) and minsSince >= 30
        bool d60 = inSess and not na(minsSince) and minsSince >= 60

        var float h5  = na
        var float l5  = na
        var float h15 = na
        var float l15 = na
        var float h30 = na
        var float l30 = na
        var float h60 = na
        var float l60 = na

        if openEvt
            h5  := na
            l5  := na
            h15 := na
            l15 := na
            h30 := na
            l30 := na
            h60 := na
            l60 := na

        if inSess
            if not d5
                h5 := na(h5) ? high : math.max(h5, high)
                l5 := na(l5) ? low  : math.min(l5, low)
            if not d15
                h15 := na(h15) ? high : math.max(h15, high)
                l15 := na(l15) ? low  : math.min(l15, low)
            if not d30
                h30 := na(h30) ? high : math.max(h30, high)
                l30 := na(l30) ? low  : math.min(l30, low)
            if not d60
                h60 := na(h60) ? high : math.max(h60, high)
                l60 := na(l60) ? low  : math.min(l60, low)

        result := "BUILDING"
        if d5 and not d15
            result := close > h5 ? "ABOVE 5" : close < l5 ? "BELOW 5" : "INSIDE 5"
        else if d15 and not d30
            result := close > h15 ? "ABOVE 15" : close < l15 ? "BELOW 15" : "INSIDE 15"
        else if d30 and not d60
            result := close > h30 ? "ABOVE 30" : close < l30 ? "BELOW 30" : "INSIDE 30"
        else if d60
            result := close > h60 ? "ABOVE 60" : close < l60 ? "BELOW 60" : "INSIDE 60"
    result

macdStateCalc() =>
    [macdLineTF, signalLineTF, macdHistTF] = ta.macd(macdSrc, macdFast, macdSlow, macdSig)
    macdLineTF > signalLineTF ? 1 : -1

anchored_vwap_basic(string how, float src) =>
    var float sumPv  = 0.0
    var float sumVol = 0.0
    string key = how == "D" ? "Day" : how == "W" ? "Week" : how == "M" ? "Month" : how
    if anchor_reset(key)
        sumPv  := 0.0
        sumVol := 0.0
    sumPv  += src * volume
    sumVol += volume
    sumVol != 0 ? sumPv / sumVol : na

rsiStateCalc() =>
    float r = ta.rsi(rsiSrcM, rsiLenM)
    int result = 0
    if useClassicRSIBias
        result := r >= 70 ? -1 : r <= 30 ? 1 : 0
    else
        if r >= math.min(rsiSellMin, rsiSellMax) and r <= math.max(rsiSellMin, rsiSellMax)
            result := -1
        else if r >= math.min(rsiBuyMin, rsiBuyMax) and r <= math.max(rsiBuyMin, rsiBuyMax)
            result := 1
    result

adxStrongCalc() =>
    float upMove   = high - high[1]
    float downMove = low[1] - low
    float plusDM   = (upMove > downMove and upMove > 0) ? upMove : 0.0
    float minusDM  = (downMove > upMove and downMove > 0) ? downMove : 0.0
    float trur     = ta.rma(ta.tr, adxLen)
    float plusDI   = trur == 0 ? 0.0 : 100.0 * ta.rma(plusDM, adxLen) / trur
    float minusDI  = trur == 0 ? 0.0 : 100.0 * ta.rma(minusDM, adxLen) / trur
    float dx       = (plusDI + minusDI) == 0 ? 0.0 : 100.0 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
    float adxTF    = ta.rma(dx, adxLen)
    adxTF >= eff_adxMin

st_state_tf(_src, _atrPeriod, _mult, _useATR, _neutralBars) =>
    float trLocal   = ta.tr
    float atrRaw    = ta.atr(_atrPeriod)
    float smaRaw    = ta.sma(trLocal, _atrPeriod)
    float atrLocal  = _useATR ? atrRaw : smaRaw
    float upRawL    = _src - _mult * atrLocal
    float dnRawL    = _src + _mult * atrLocal
    var float upL   = na
    var float dnL   = na
    // VERIFICATION FIX: Changed close[1] to close in both ratchet
    // condition comparisons. The prior implementation used the prior
    // higher timeframe bar's close against the prior bar's line, which
    // lagged the ratchet evaluation by one higher timeframe bar relative
    // to the main chart Supertrend. The main chart correctly compares
    // the current bar's close against the prior bar's line. This fix
    // aligns the ratchet evaluation timing between st_state_tf and the
    // main chart, eliminating the one-bar directional lag that caused
    // the bias table Supertrend row to disagree with the main chart
    // Supertrend color on flip bars.
    upL := na(upL[1]) ? upRawL : (close > upL[1] ? math.max(upRawL, upL[1]) : upRawL)
    dnL := na(dnL[1]) ? dnRawL : (close < dnL[1] ? math.min(dnRawL, dnL[1]) : dnRawL)
    var int dirL = na
    dirL := na(dirL[1]) ? (close >= _src ? 1 : -1) : dirL[1]
    dirL := dirL == -1 and close > dnL[1] ? 1 : dirL == 1 and close < upL[1] ? -1 : dirL
    int ago   = ta.barssince(dirL != dirL[1])
    bool neu  = _neutralBars > 0 and not na(ago) and ago >= 0 and ago < _neutralBars
    neu ? 0 : dirL

getAllBiasTF(_tf) =>
    request.security(syminfo.tickerid, _tf,
        [maSwitch(close, eff_maShortLen, maFastType) > maSwitch(close, eff_maMedLen, maMedType),
         close > maSwitch(close, ma200Len, maLongType),
         close > (useAnchoredVWAPinTable ? anchored_vwap_basic(anchor, srcVWAP) : ta.vwap(srcVWAP)),
         zlsma_calc(zlsmaSrc, zlsmaLength, zlsmaOffset) > zlsma_calc(zlsmaSrc, zlsmaLength, zlsmaOffset)[1],
         adxStrongCalc(),
         macdStateCalc(),
         st_state_tf(stSrc, stAtrPeriod, eff_stMult, stUseATR, stNeutralBars),
         rsiStateCalc()],
        barmerge.gaps_off, barmerge.lookahead_off)

//====================================================================
// Section #18 | BIAS TABLE RENDER
//====================================================================
bool isFutures      = syminfo.type == "futures"
bool limitedHistory = bar_index < 5000
bool effRowBias3D      = rowBias3D      and not (isFutures or limitedHistory)
bool effRowBiasWeekly  = rowBiasWeekly  and not (isFutures or limitedHistory)
bool effRowBiasMonth   = rowBiasMonth   and not (isFutures or limitedHistory)
bool effRowBiasQuarter = rowBiasQuarter and not (isFutures or limitedHistory)

bool biasGuard = showTable and not (hideBiasOnDplus and timeframe.isdwm)

tablePosition = switch tablePosLabel
    "Top Left"     => position.top_left
    "Top Right"    => position.top_right
    "Middle Left"  => position.middle_left
    "Middle Right" => position.middle_right
    "Bottom Left"  => position.bottom_left
    =>                position.bottom_right

var table  fullTable    = na
var string lastTablePos = ""
var int    lastTfMask   = na

int tfMask         = (tf1mOn ? 1 : 0) + (tf5mOn ? 2 : 0) + (tf15mOn ? 4 : 0) + (tf30mOn ? 8 : 0) + (tf1hOn ? 16 : 0) + (tf2hOn ? 32 : 0) + (tf4hOn ? 64 : 0) + (tfDOn ? 128 : 0)
int tfEnabledCount = (tf1mOn ? 1 : 0) + (tf5mOn ? 1 : 0) + (tf15mOn ? 1 : 0) + (tf30mOn ? 1 : 0) + (tf1hOn ? 1 : 0) + (tf2hOn ? 1 : 0) + (tf4hOn ? 1 : 0) + (tfDOn ? 1 : 0)
int kCols          = timeframe.isdwm ? 3 : tfEnabledCount
int dynCols        = 1 + kCols + 1

if biasGuard
    if na(fullTable) or tablePosLabel != lastTablePos or na(lastTfMask) or tfMask != lastTfMask
        lastTablePos := tablePosLabel
        lastTfMask   := tfMask
        if not na(fullTable)
            table.delete(fullTable)
        fullTable := table.new(tablePosition, dynCols, 20, border_width=0)
else
    if not na(fullTable)
        table.delete(fullTable)
        fullTable := na

// REPAIR-005: Corrected temporal bias lookback periods to match labels.
// 3 Day  : was 60m TF close[50] (~7.7 days). Now D TF close[3]  (3 trading days).
// Weekly : was 240m TF close[25] (~15 days). Now D TF close[5]  (5 trading days = 1 week).
// Monthly: was D TF close[15] (~3 weeks).    Now D TF close[21] (21 trading days = 1 month).
// Quarterly: W TF close[13] was already correct and is unchanged.
[_b3dA,  _b3dB]  = request.security(syminfo.tickerid, "D", [close, close[3]],  barmerge.gaps_off, barmerge.lookahead_off)
[_bwkA,  _bwkB]  = request.security(syminfo.tickerid, "D", [close, close[5]],  barmerge.gaps_off, barmerge.lookahead_off)
[_bmnA,  _bmnB]  = request.security(syminfo.tickerid, "D", [close, close[21]], barmerge.gaps_off, barmerge.lookahead_off)
[_bqtA,  _bqtB]  = request.security(syminfo.tickerid, "W", [close, close[13]], barmerge.gaps_off, barmerge.lookahead_off)
float bias3D      = (na(_b3dA) or na(_b3dB)) ? na : _b3dA - _b3dB
float biasWeek    = (na(_bwkA) or na(_bwkB)) ? na : _bwkA - _bwkB
float biasMon     = (na(_bmnA) or na(_bmnB)) ? na : _bmnA - _bmnB
float biasQuarter = (na(_bqtA) or na(_bqtB)) ? na : _bqtA - _bqtB

float  vixD    = request.security(vixSymbol, vixTF, close, barmerge.gaps_off, barmerge.lookahead_off)
string vixBias = vixD < VIX_LOW ? "BULLISH" : vixD > VIX_HIGH ? "BEARISH" : "NEUTRAL"
string orBand  = rowORB and timeframe.isintraday ? or_bias_band_status_series() : "Not Open"

var string[] tfLabelsActive = array.new_string()
var string[] tfCodesActive  = array.new_string()
array.clear(tfLabelsActive)
array.clear(tfCodesActive)

if timeframe.isdwm
    array.push(tfLabelsActive, "D")
    array.push(tfCodesActive,  "D")
    array.push(tfLabelsActive, "W")
    array.push(tfCodesActive,  "W")
    array.push(tfLabelsActive, "M")
    array.push(tfCodesActive,  "M")
else
    if tf1mOn
        array.push(tfLabelsActive, "1m")
        array.push(tfCodesActive,  "1")
    if tf5mOn
        array.push(tfLabelsActive, "5m")
        array.push(tfCodesActive,  "5")
    if tf15mOn
        array.push(tfLabelsActive, "15m")
        array.push(tfCodesActive,  "15")
    if tf30mOn
        array.push(tfLabelsActive, "30m")
        array.push(tfCodesActive,  "30")
    if tf1hOn
        array.push(tfLabelsActive, "1h")
        array.push(tfCodesActive,  "60")
    if tf2hOn
        array.push(tfLabelsActive, "2h")
        array.push(tfCodesActive,  "120")
    if tf4hOn
        array.push(tfLabelsActive, "4h")
        array.push(tfCodesActive,  "240")
    if tfDOn
        array.push(tfLabelsActive, "D")
        array.push(tfCodesActive,  "D")

[_1m_cr,  _1m_ab,  _1m_vw,  _1m_zl,  _1m_ad,  _1m_mc,  _1m_st,  _1m_rs]  = getAllBiasTF("1")
[_5m_cr,  _5m_ab,  _5m_vw,  _5m_zl,  _5m_ad,  _5m_mc,  _5m_st,  _5m_rs]  = getAllBiasTF("5")
[_15m_cr, _15m_ab, _15m_vw, _15m_zl, _15m_ad, _15m_mc, _15m_st, _15m_rs] = getAllBiasTF("15")
[_30m_cr, _30m_ab, _30m_vw, _30m_zl, _30m_ad, _30m_mc, _30m_st, _30m_rs] = getAllBiasTF("30")
[_1h_cr,  _1h_ab,  _1h_vw,  _1h_zl,  _1h_ad,  _1h_mc,  _1h_st,  _1h_rs]  = getAllBiasTF("60")
[_2h_cr,  _2h_ab,  _2h_vw,  _2h_zl,  _2h_ad,  _2h_mc,  _2h_st,  _2h_rs]  = getAllBiasTF("120")
[_4h_cr,  _4h_ab,  _4h_vw,  _4h_zl,  _4h_ad,  _4h_mc,  _4h_st,  _4h_rs]  = getAllBiasTF("240")
[_D_cr,   _D_ab,   _D_vw,   _D_zl,   _D_ad,   _D_mc,   _D_st,   _D_rs]   = getAllBiasTF("D")
[_W_cr,   _W_ab,   _W_vw,   _W_zl,   _W_ad,   _W_mc,   _W_st,   _W_rs]   = getAllBiasTF("W")
[_M_cr,   _M_ab,   _M_vw,   _M_zl,   _M_ad,   _M_mc,   _M_st,   _M_rs]   = getAllBiasTF("M")

var bool[] tfCrossVals    = array.new_bool()
var bool[] tfAbove200Vals = array.new_bool()
var bool[] tfVwapVals     = array.new_bool()
var bool[] tfZlsmaVals    = array.new_bool()
var bool[] tfAdxVals      = array.new_bool()
var int[]  tfMacdVals     = array.new_int()
var int[]  tfStVals       = array.new_int()
var int[]  tfRsiVals      = array.new_int()

array.clear(tfCrossVals)
array.clear(tfAbove200Vals)
array.clear(tfVwapVals)
array.clear(tfZlsmaVals)
array.clear(tfAdxVals)
array.clear(tfMacdVals)
array.clear(tfStVals)
array.clear(tfRsiVals)

if timeframe.isdwm
    array.push(tfCrossVals, _D_cr)
    array.push(tfAbove200Vals, _D_ab)
    array.push(tfVwapVals, _D_vw)
    array.push(tfZlsmaVals, _D_zl)
    array.push(tfAdxVals, _D_ad)
    array.push(tfMacdVals, _D_mc)
    array.push(tfStVals, _D_st)
    array.push(tfRsiVals, _D_rs)
    array.push(tfCrossVals, _W_cr)
    array.push(tfAbove200Vals, _W_ab)
    array.push(tfVwapVals, _W_vw)
    array.push(tfZlsmaVals, _W_zl)
    array.push(tfAdxVals, _W_ad)
    array.push(tfMacdVals, _W_mc)
    array.push(tfStVals, _W_st)
    array.push(tfRsiVals, _W_rs)
    array.push(tfCrossVals, _M_cr)
    array.push(tfAbove200Vals, _M_ab)
    array.push(tfVwapVals, _M_vw)
    array.push(tfZlsmaVals, _M_zl)
    array.push(tfAdxVals, _M_ad)
    array.push(tfMacdVals, _M_mc)
    array.push(tfStVals, _M_st)
    array.push(tfRsiVals, _M_rs)
else
    if tf1mOn
        array.push(tfCrossVals, _1m_cr)
        array.push(tfAbove200Vals, _1m_ab)
        array.push(tfVwapVals, _1m_vw)
        array.push(tfZlsmaVals, _1m_zl)
        array.push(tfAdxVals, _1m_ad)
        array.push(tfMacdVals, _1m_mc)
        array.push(tfStVals, _1m_st)
        array.push(tfRsiVals, _1m_rs)
    if tf5mOn
        array.push(tfCrossVals, _5m_cr)
        array.push(tfAbove200Vals, _5m_ab)
        array.push(tfVwapVals, _5m_vw)
        array.push(tfZlsmaVals, _5m_zl)
        array.push(tfAdxVals, _5m_ad)
        array.push(tfMacdVals, _5m_mc)
        array.push(tfStVals, _5m_st)
        array.push(tfRsiVals, _5m_rs)
    if tf15mOn
        array.push(tfCrossVals, _15m_cr)
        array.push(tfAbove200Vals, _15m_ab)
        array.push(tfVwapVals, _15m_vw)
        array.push(tfZlsmaVals, _15m_zl)
        array.push(tfAdxVals, _15m_ad)
        array.push(tfMacdVals, _15m_mc)
        array.push(tfStVals, _15m_st)
        array.push(tfRsiVals, _15m_rs)
    if tf30mOn
        array.push(tfCrossVals, _30m_cr)
        array.push(tfAbove200Vals, _30m_ab)
        array.push(tfVwapVals, _30m_vw)
        array.push(tfZlsmaVals, _30m_zl)
        array.push(tfAdxVals, _30m_ad)
        array.push(tfMacdVals, _30m_mc)
        array.push(tfStVals, _30m_st)
        array.push(tfRsiVals, _30m_rs)
    if tf1hOn
        array.push(tfCrossVals, _1h_cr)
        array.push(tfAbove200Vals, _1h_ab)
        array.push(tfVwapVals, _1h_vw)
        array.push(tfZlsmaVals, _1h_zl)
        array.push(tfAdxVals, _1h_ad)
        array.push(tfMacdVals, _1h_mc)
        array.push(tfStVals, _1h_st)
        array.push(tfRsiVals, _1h_rs)
    if tf2hOn
        array.push(tfCrossVals, _2h_cr)
        array.push(tfAbove200Vals, _2h_ab)
        array.push(tfVwapVals, _2h_vw)
