    if tfDOn
        array.push(tfCrossVals, _D_cr)
        array.push(tfAbove200Vals, _D_ab)
        array.push(tfVwapVals, _D_vw)
        array.push(tfZlsmaVals, _D_zl)
        array.push(tfAdxVals, _D_ad)
        array.push(tfMacdVals, _D_mc)
        array.push(tfStVals, _D_st)
        array.push(tfRsiVals, _D_rs)

drawBiasBandRow(_table, _row, _label, _rawTxt) =>
    table.cell(_table, 0, _row, _label, text_color=color.white, bgcolor=tableBgColor, text_size=textSize, text_halign=text.align_left)
    string displayWord = str.upper(_rawTxt)
    color  bg          = biasBg(_rawTxt)
    for c = 1 to kCols
        string ch = c <= str.length(displayWord) ? str.substring(displayWord, c - 1, c) : ""
        table.cell(_table, c, _row, ch, text_color=color.white, bgcolor=bg, text_size=textSize)
    table.cell(_table, 1 + kCols, _row, "", text_color=color.white, bgcolor=bg, text_size=textSize)
    _row + 1

drawBoolRow(_table, _row, _label, _kind) =>
    table.cell(_table, 0, _row, _label, text_color=color.white, bgcolor=tableBgColor, text_size=textSize, text_halign=text.align_left)
    int green = 0
    int valid = 0
    for i = 0 to array.size(tfCodesActive) - 1
        bool ok = false
        if _kind == "cross"
            ok := array.get(tfCrossVals, i)
        else if _kind == "ma200"
            ok := array.get(tfAbove200Vals, i)
        else if _kind == "vwap"
            ok := array.get(tfVwapVals, i)
        else if _kind == "zlsma"
            ok := array.get(tfZlsmaVals, i)
        else if _kind == "adx"
            ok := array.get(tfAdxVals, i)
        valid += 1
        if ok
            green += 1
        table.cell(_table, i + 1, _row, getEmoji(ok), text_color=color.white, bgcolor=tableBgColor, text_size=textSize)
    table.cell(_table, 1 + kCols, _row, valid > 0 ? str.tostring(math.round(100.0 * green / valid)) + "%" : "-", text_color=color.white, bgcolor=tableBgColor, text_size=textSize)
    _row + 1

drawTriRow(_table, _row, _label, _kind) =>
    table.cell(_table, 0, _row, _label, text_color=color.white, bgcolor=tableBgColor, text_size=textSize, text_halign=text.align_left)
    float score = 0.0
    int   valid = 0
    for i = 0 to array.size(tfCodesActive) - 1
        int state = 0
        if _kind == "macd"
            state := array.get(tfMacdVals, i)
        else if _kind == "st"
            state := array.get(tfStVals, i)
        else if _kind == "rsi"
            state := array.get(tfRsiVals, i)
        valid += 1
        score += state == 1 ? 1.0 : state == 0 ? 0.5 : 0.0
        table.cell(_table, i + 1, _row, triEmoji(state), text_color=color.white, bgcolor=tableBgColor, text_size=textSize)
    table.cell(_table, 1 + kCols, _row, valid > 0 ? str.tostring(math.round(100.0 * score / valid)) + "%" : "-", text_color=color.white, bgcolor=tableBgColor, text_size=textSize)
    _row + 1

if biasGuard and not na(fullTable) and barstate.islast
    table.clear(fullTable, 0, 0, dynCols - 1, 19)
    string headerTitle = timeframe.isdwm ? "LONG BIAS" : "BIAS INDICATOR"
    table.cell(fullTable, 0, 0, headerTitle, bgcolor=tableBgColor, text_color=color.white, text_halign=text.align_center, text_size=textSize)
    table.merge_cells(fullTable, 0, 0, dynCols - 1, 0)

    int rowIdx = 1
    if effRowBias3D
        rowIdx := drawBiasBandRow(fullTable, rowIdx, "3 Day Bias", bias_label_from(bias3D))
    if effRowBiasWeekly
        rowIdx := drawBiasBandRow(fullTable, rowIdx, "Weekly Bias", bias_label_from(biasWeek))
    if effRowBiasMonth
        rowIdx := drawBiasBandRow(fullTable, rowIdx, "Monthly Bias", bias_label_from(biasMon))
    if effRowBiasQuarter
        rowIdx := drawBiasBandRow(fullTable, rowIdx, "Quarterly Bias", bias_label_from(biasQuarter))
    if rowVIX
        rowIdx := drawBiasBandRow(fullTable, rowIdx, "VIX Fear Index", vixBias)
    if rowORB and timeframe.isintraday
        rowIdx := drawBiasBandRow(fullTable, rowIdx, "Opening Range Breakout", orBand)

    for c = 0 to dynCols - 1
        table.cell(fullTable, c, rowIdx, "", bgcolor=tableBgColor, text_size=size.auto)
    rowIdx += 1

    table.cell(fullTable, 0, rowIdx, "", bgcolor=tableBgColor, text_size=textSize)
    for i = 0 to array.size(tfLabelsActive) - 1
        table.cell(fullTable, i + 1, rowIdx, array.get(tfLabelsActive, i), text_color=color.white, bgcolor=tableBgColor, text_size=textSize)
    table.cell(fullTable, 1 + kCols, rowIdx, "AVG", text_color=color.white, bgcolor=tableBgColor, text_size=textSize)
    rowIdx += 1

    string maFastLabel = maFastType + " " + str.tostring(eff_maShortLen)
    string maMedLabel  = maMedType + " " + str.tostring(eff_maMedLen)
    string maLongLabel = maLongType + " " + str.tostring(ma200Len)

    if rowMA
        rowIdx := drawBoolRow(fullTable, rowIdx, maFastLabel + " > " + maMedLabel, "cross")
    if rowMA200
        rowIdx := drawBoolRow(fullTable, rowIdx, "Price > " + maLongLabel, "ma200")
    if rowVWAP
        rowIdx := drawBoolRow(fullTable, rowIdx, "Price > VWAP", "vwap")
    if rowMACD
        rowIdx := drawTriRow(fullTable, rowIdx, "MACD > Signal", "macd")
    if rowST
        rowIdx := drawTriRow(fullTable, rowIdx, "Supertrend", "st")
    if rowZLSMA
        rowIdx := drawBoolRow(fullTable, rowIdx, "ZLSMA Rising", "zlsma")
    if rowRSI
        rowIdx := drawTriRow(fullTable, rowIdx, "RSI In Zone", "rsi")
    if rowADX
        rowIdx := drawBoolRow(fullTable, rowIdx, "ADX >= Minimum", "adx")

//====================================================================
// Section #18.5 | PPD SUPPLEMENTAL CALCULATIONS
//====================================================================
float rvolAvg = ta.sma(volume, rvolLookback)
float rvolVal = rvolAvg > 0 ? volume / rvolAvg : na

float ppdATRpct = close != 0 ? atrNow / close * 100.0 : na

float gapPct          = not na(refOpen) and not na(ppdPrevDayClose) and ppdPrevDayClose != 0 ? (refOpen - ppdPrevDayClose) / ppdPrevDayClose * 100.0 : na
float distFromOpenPct = not na(refOpen) and refOpen != 0 ? (close - refOpen) / refOpen * 100.0 : na

float ppdVwap    = vwActive and not na(vwapValue) ? vwapValue : ta.vwap(hlc3)
float vwapDevPct = not na(ppdVwap) and ppdVwap != 0 ? (close - ppdVwap) / ppdVwap * 100.0 : na

float ppdPivotPoint = (ppdPrevDayHigh + ppdPrevDayLow + ppdPrevDayClose) / 3.0
float ppdPivotR1    = 2.0 * ppdPivotPoint - ppdPrevDayLow
float ppdPivotS1    = 2.0 * ppdPivotPoint - ppdPrevDayHigh

var float ppdPrevMajorHigh = na
var float ppdPrevMajorLow  = na
var float ppdSwingHigh     = na
var float ppdSwingLow      = na

float ppdPivH = ta.pivothigh(high, ppdSwingLength, ppdSwingLength)
float ppdPivL = ta.pivotlow(low, ppdSwingLength, ppdSwingLength)

if ppdMajorMode == "Lookback"
    ppdPrevMajorHigh := ta.highest(high, ppdMajorLookback)
    ppdPrevMajorLow  := ta.lowest(low, ppdMajorLookback)

if not na(ppdPivH)
    ppdSwingHigh := ppdPivH
    if ppdMajorMode == "Swing"
        ppdPrevMajorHigh := ppdPivH

if not na(ppdPivL)
    ppdSwingLow := ppdPivL
    if ppdMajorMode == "Swing"
        ppdPrevMajorLow := ppdPivL

float ppdFibAnchorHigh = ppdFibMode == "4 Week High Low" ? ppdFourWeekHigh : ppdFibMode == "13 Week High Low" ? ppdThirteenWeekHigh : ppdSwingHigh
float ppdFibAnchorLow  = ppdFibMode == "4 Week High Low" ? ppdFourWeekLow : ppdFibMode == "13 Week High Low" ? ppdThirteenWeekLow : ppdSwingLow
float ppdFib38         = not na(ppdFibAnchorHigh) and not na(ppdFibAnchorLow) ? ppdFibAnchorLow + (ppdFibAnchorHigh - ppdFibAnchorLow) * 0.382 : na
float ppdDistBelow52Wk = not na(ppdHigh52Wk) and ppdHigh52Wk != 0 ? (ppdHigh52Wk - close) / ppdHigh52Wk * 100.0 : na

var float _ppdOrH5       = na
var float _ppdOrL5       = na
var float _ppdOrH15      = na
var float _ppdOrL15      = na
var float _ppdOrH30      = na
var float _ppdOrL30      = na
var float _ppdOrH60      = na
var float _ppdOrL60      = na
var int   _ppdOrOpenTime = na

float  ppdOrHigh   = na
float  ppdOrLow    = na
string ppdOrWindow = "Building"

if timeframe.isintraday
    bool _ppdInSess  = not na(time(timeframe.period, sessStr))
    bool _ppdNewDay  = ta.change(time("D")) != 0
    bool _ppdOpenEvt = session.isfirstbar_regular or (_ppdInSess and not _ppdInSess[1] and _ppdNewDay)

    if _ppdOpenEvt
        _ppdOrOpenTime := time
        _ppdOrH5 := na
        _ppdOrL5 := na
        _ppdOrH15 := na
        _ppdOrL15 := na
        _ppdOrH30 := na
        _ppdOrL30 := na
        _ppdOrH60 := na
        _ppdOrL60 := na

    int  _ppdMins = _ppdInSess and not na(_ppdOrOpenTime) ? int(math.floor((time - _ppdOrOpenTime) / 60000)) : na
    bool _ppdD5   = _ppdInSess and not na(_ppdMins) and _ppdMins >= 5
    bool _ppdD15  = _ppdInSess and not na(_ppdMins) and _ppdMins >= 15
    bool _ppdD30  = _ppdInSess and not na(_ppdMins) and _ppdMins >= 30
    bool _ppdD60  = _ppdInSess and not na(_ppdMins) and _ppdMins >= 60

    if _ppdInSess
        if not _ppdD5
            _ppdOrH5 := na(_ppdOrH5) ? high : math.max(_ppdOrH5, high)
            _ppdOrL5 := na(_ppdOrL5) ? low : math.min(_ppdOrL5, low)
        if not _ppdD15
            _ppdOrH15 := na(_ppdOrH15) ? high : math.max(_ppdOrH15, high)
            _ppdOrL15 := na(_ppdOrL15) ? low : math.min(_ppdOrL15, low)
        if not _ppdD30
            _ppdOrH30 := na(_ppdOrH30) ? high : math.max(_ppdOrH30, high)
            _ppdOrL30 := na(_ppdOrL30) ? low : math.min(_ppdOrL30, low)
        if not _ppdD60
            _ppdOrH60 := na(_ppdOrH60) ? high : math.max(_ppdOrH60, high)
            _ppdOrL60 := na(_ppdOrL60) ? low : math.min(_ppdOrL60, low)

    if _ppdD60
        ppdOrHigh   := _ppdOrH60
        ppdOrLow    := _ppdOrL60
        ppdOrWindow := "60m"
    else if _ppdD30
        ppdOrHigh   := _ppdOrH30
        ppdOrLow    := _ppdOrL30
        ppdOrWindow := "30m"
    else if _ppdD15
        ppdOrHigh   := _ppdOrH15
        ppdOrLow    := _ppdOrL15
        ppdOrWindow := "15m"
    else if _ppdD5
        ppdOrHigh   := _ppdOrH5
        ppdOrLow    := _ppdOrL5
        ppdOrWindow := "5m"

float ppdOrDistHigh = not na(ppdOrHigh) and ppdOrHigh != 0 ? (close - ppdOrHigh) / ppdOrHigh * 100.0 : na
float ppdOrDistLow  = not na(ppdOrLow) and ppdOrLow != 0 ? (close - ppdOrLow) / ppdOrLow * 100.0 : na

//====================================================================
// Section #18.6 | PHASE 2 CALCULATIONS
//====================================================================
float _symReturn  = not na(ppdPrevDayClose) and ppdPrevDayClose != 0 ? (close - ppdPrevDayClose) / ppdPrevDayClose * 100.0 : na
float _b1Return   = not na(_p2B1PrevClose) and _p2B1PrevClose != 0   ? (_p2B1CurClose - _p2B1PrevClose) / _p2B1PrevClose * 100.0 : na
float _b2Return   = not na(_p2B2PrevClose) and _p2B2PrevClose != 0   ? (_p2B2CurClose - _p2B2PrevClose) / _p2B2PrevClose * 100.0 : na

float p2RS1       = not na(_symReturn) and not na(_b1Return) ? _symReturn - _b1Return : na
float p2RS2       = not na(_symReturn) and not na(_b2Return) ? _symReturn - _b2Return : na
bool  p2RS1Bull   = not na(p2RS1) and p2RS1 > 0
bool  p2RS2Bull   = not na(p2RS2) and p2RS2 > 0

string _b1Name = str.contains(rsBenchmark1, ":") ? str.substring(rsBenchmark1, str.pos(rsBenchmark1, ":") + 1, str.length(rsBenchmark1)) : rsBenchmark1
string _b2Name = str.contains(rsBenchmark2, ":") ? str.substring(rsBenchmark2, str.pos(rsBenchmark2, ":") + 1, str.length(rsBenchmark2)) : rsBenchmark2

float p2BBBasis  = ta.sma(close, bbLenVol)
float p2BBDev    = ta.stdev(close, bbLenVol)
float p2BBUpper  = p2BBBasis + bbMultVol * p2BBDev
float p2BBLower  = p2BBBasis - bbMultVol * p2BBDev
float p2BBWidth  = p2BBBasis != 0 ? (p2BBUpper - p2BBLower) / p2BBBasis : na

float p2KCMid    = ta.ema(close, kcLenVol)
float p2KCAtr    = ta.atr(kcLenVol)
float p2KCUpper  = p2KCMid + kcMultVol * p2KCAtr
float p2KCLower  = p2KCMid - kcMultVol * p2KCAtr

bool  p2IsSqueeze   = p2BBUpper < p2KCUpper and p2BBLower > p2KCLower
float p2BBWidthSma  = ta.sma(p2BBWidth, 20)
bool  p2IsExpansion = not p2IsSqueeze and not na(p2BBWidthSma) and p2BBWidthSma > 0 and p2BBWidth > p2BBWidthSma * 1.5

string p2VolState = p2IsSqueeze ? "SQUEEZE" : p2IsExpansion ? "EXPANSION" : "NORMAL"

float _tssVwap   = ppdVwap
float tssScore   = 0.0

if not na(maShort) and not na(maMedium) and not na(maLong)
    if maShort > maMedium
        tssScore += 15.0
    if maMedium > maLong
        tssScore += 10.0

if not na(_tssVwap) and _tssVwap > 0
    if close > _tssVwap
        tssScore += 20.0
    else if close > _tssVwap * 0.995
        tssScore += 10.0

if not na(macdLine) and not na(signalLine)
    if macdLine > signalLine
        tssScore += 20.0

if not neutral
    if stDir == 1
        tssScore += 20.0
else
    tssScore += 10.0

if not na(adxVal)
    tssScore += adxVal >= 40 ? 15.0 : adxVal >= 30 ? 12.0 : adxVal >= 20 ? 8.0 : adxVal >= 10 ? 4.0 : 0.0

tssScore := math.max(0.0, math.min(100.0, tssScore))

float tpsScore = 0.0

int   _tfCnt     = array.size(tfCrossVals)
float _tfBullSum = 0.0
if _tfCnt > 0
    for _ii = 0 to _tfCnt - 1
        float _crPts  = array.get(tfCrossVals,    _ii) ? 1.0 : 0.0
        float _abPts  = array.get(tfAbove200Vals, _ii) ? 1.0 : 0.0
        float _mcPts  = array.get(tfMacdVals,     _ii) == 1 ? 1.0 : array.get(tfMacdVals, _ii) == 0 ? 0.5 : 0.0
        _tfBullSum += (_crPts + _abPts + _mcPts) / 3.0
    tpsScore += 20.0 * (_tfBullSum / _tfCnt)

if not na(maShort) and not na(maMedium) and not na(maLong)
    if maShort > maMedium and maMedium > maLong
        tpsScore += 10.0
    else if maShort > maMedium
        tpsScore += 5.0

if not na(_tssVwap) and _tssVwap > 0 and close > _tssVwap
    tpsScore += 8.0

if not na(maLong) and close > maLong
    tpsScore += 7.0

if not na(macdLine) and not na(signalLine) and macdLine > signalLine
    tpsScore += 8.0

if not neutral
    tpsScore += stDir == 1 ? 10.0 : 0.0
else
    tpsScore += 5.0

if not na(adxVal)
    tpsScore += adxVal >= 40 ? 8.0 : adxVal >= 30 ? 6.0 : adxVal >= 20 ? 4.0 : 0.0

if not na(rvolVal)
    tpsScore += rvolVal >= 2.0 ? 7.0 : rvolVal >= 1.5 ? 5.0 : rvolVal >= 1.0 ? 3.0 : 0.0

if timeframe.isintraday
    if str.contains(orBand, "ABOVE")
        tpsScore += 7.0
    else if str.contains(orBand, "INSIDE")
        tpsScore += 3.5
    else if orBand == "BUILDING" or orBand == "Not Open"
        tpsScore += 2.5

if not na(p2RS1)
    tpsScore += p2RS1 > 0.5 ? 5.0 : p2RS1 > 0.0 ? 2.5 : 0.0

tpsScore += p2IsExpansion ? 5.0 : p2IsSqueeze ? 0.0 : 3.0

if not na(ppdPivotS1) and not na(ppdPivotR1)
    bool aboveS1 = close > ppdPivotS1
    bool belowR1 = close < ppdPivotR1
    tpsScore += (aboveS1 and belowR1) ? 5.0 : aboveS1 ? 3.0 : 0.0

tpsScore := math.max(0.0, math.min(100.0, tpsScore))

string tpsLabel = tpsScore >= 80 ? "HIGH PROBABILITY" : tpsScore >= 60 ? "GOOD SETUP" : tpsScore >= 40 ? "NEUTRAL" : "AVOID"

float _sweepRefHigh = ta.highest(high[1], sweepLookback)
float _sweepRefLow  = ta.lowest(low[1],   sweepLookback)
float _sweepAtrTol  = atrNow * sweepRejAtr

bool p2SweepHigh = high > _sweepRefHigh and close < _sweepRefHigh and (high - _sweepRefHigh) >= _sweepAtrTol
bool p2SweepLow  = low < _sweepRefLow and close > _sweepRefLow and (_sweepRefLow - low) >= _sweepAtrTol

//====================================================================
// Section #19 | PRICE POINT LIVE DASHBOARD
//====================================================================
ppdFmt(_x) =>
    na(_x) ? "n/a" : str.tostring(_x, format.mintick)

ppdFmtPct(_x) =>
    na(_x) ? "n/a" : ((_x >= 0 ? "+" : "") + str.tostring(_x, "#.##") + "%")

ppdValBg(_val, _ref) =>
    na(_val) ? color.new(color.gray, 65) : _val > _ref ? color.new(color.rgb(180, 60, 60), 0) : color.new(color.rgb(60, 140, 75), 0)

rvolColor(_r) =>
    color result = na
    if na(_r)
        result := color.new(color.rgb(70, 70, 70), 0)
    else if _r >= 3.0
        result := color.new(color.red, 0)
    else if _r >= 2.0
        result := color.new(color.orange, 0)
    else if _r >= 1.5
        result := color.new(color.yellow, 0)
    else if _r >= 1.0
        result := color.new(color.rgb(60, 140, 75), 0)
    else
        result := color.new(color.rgb(90, 90, 90), 0)
    result

ppdPctBg(_pct) =>
    color result = na
    if na(_pct)
        result := color.new(color.gray, 65)
    else if _pct > 0
        result := color.new(color.rgb(1, 131, 6), 0)
    else
        result := color.new(color.rgb(180, 60, 60), 0)
    result

ppdVwapDevBg(_pct) =>
    color result = na
    if na(_pct)
        result := color.new(color.gray, 65)
    else if math.abs(_pct) >= 2.0
        result := color.new(color.red, 0)
    else if math.abs(_pct) >= 0.5
        result := color.new(color.orange, 0)
    else
        result := color.new(color.rgb(60, 140, 75), 0)
    result

ppdOrDistBg(_pct) =>
    color result = na
    if na(_pct)
        result := color.new(color.gray, 65)
    else if _pct >= 0
        result := color.new(color.rgb(1, 131, 6), 0)
    else
        result := color.new(color.rgb(180, 60, 60), 0)
    result

p2TssBg(_s) =>
    color result = na
    if na(_s)
        result := color.new(color.gray, 65)
    else if _s >= 70
        result := color.new(color.rgb(1, 131, 6), 0)
    else if _s >= 50
        result := color.new(color.rgb(180, 140, 0), 0)
    else if _s >= 30
        result := color.new(color.rgb(200, 90, 0), 0)
    else
        result := color.new(color.rgb(180, 30, 30), 0)
    result

p2TpsBg(_s) =>
    color result = na
    if na(_s)
        result := color.new(color.gray, 65)
    else if _s >= 80
        result := color.new(color.rgb(0, 160, 50), 0)
    else if _s >= 60
        result := color.new(color.rgb(1, 131, 6), 0)
    else if _s >= 40
        result := color.new(color.rgb(160, 130, 0), 0)
    else
        result := color.new(color.rgb(160, 40, 40), 0)
    result

p2RsBg(_v) =>
    color result = na
    if na(_v)
        result := color.new(color.gray, 65)
    else if _v > 0.5
        result := color.new(color.rgb(1, 131, 6), 0)
    else if _v > 0.0
        result := color.new(color.rgb(100, 160, 60), 0)
    else if _v > -0.5
        result := color.new(color.rgb(180, 90, 0), 0)
    else
        result := color.new(color.rgb(180, 30, 30), 0)
    result

p2VolBg(_st) =>
    _st == "SQUEEZE"    ? color.new(color.rgb(200, 140, 0), 0) :
     _st == "EXPANSION" ? color.new(color.rgb(0, 140, 80),  0) :
                          color.new(color.rgb(60, 80, 100), 0)

var table ppdTable = na
if showPPD and na(ppdTable)
    ppdTable := table.new(position.bottom_right, 2, 46, border_width=1, bgcolor=color.new(color.rgb(35, 38, 43), 0))
if not showPPD and not na(ppdTable)
    table.delete(ppdTable)
    ppdTable := na

if showPPD and not na(ppdTable) and barstate.islast
    table.clear(ppdTable, 0, 0, 1, 45)

    color ppdHdrBg   = color.new(color.rgb(52, 38, 130),  0)
    color ppdSectBg  = color.new(color.rgb(78, 82, 94),   0)
    color ppdNameBg  = color.new(color.rgb(49, 53, 66),   0)
    color ppdDistBg  = color.new(color.rgb(40, 110, 150), 0)
    color ppdWhite   = color.white

    table.cell(ppdTable, 0, 0, "PRICE POINT LIVE DASHBOARD", text_color=ppdWhite, bgcolor=ppdHdrBg, text_size=ppdTextSizeInput, text_halign=text.align_center)
    table.cell(ppdTable, 1, 0, syminfo.ticker,               text_color=ppdWhite, bgcolor=ppdHdrBg, text_size=ppdTextSizeInput, text_halign=text.align_center)

    table.cell(ppdTable, 0, 1, "MAJOR LEVELS", text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput, text_halign=text.align_center)
    table.cell(ppdTable, 1, 1, "",             text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput)
    table.cell(ppdTable, 0, 2, "Previous Major High", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 2, ppdFmt(ppdPrevMajorHigh), text_color=ppdWhite, bgcolor=ppdValBg(ppdPrevMajorHigh, close), text_size=ppdTextSizeInput, text_halign=text.align_right)
    table.cell(ppdTable, 0, 3, "Previous Major Low", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 3, ppdFmt(ppdPrevMajorLow), text_color=ppdWhite, bgcolor=ppdValBg(ppdPrevMajorLow, close), text_size=ppdTextSizeInput, text_halign=text.align_right)

    table.cell(ppdTable, 0, 4, "HIGHS", text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput, text_halign=text.align_center)
    table.cell(ppdTable, 1, 4, "",      text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput)
    table.cell(ppdTable, 0, 5, "52 Week High", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 5, ppdFmt(ppdHigh52Wk), text_color=ppdWhite, bgcolor=ppdValBg(ppdHigh52Wk, close), text_size=ppdTextSizeInput, text_halign=text.align_right)
    table.cell(ppdTable, 0, 6, "13 Week High", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 6, ppdFmt(ppdHigh13Wk), text_color=ppdWhite, bgcolor=ppdValBg(ppdHigh13Wk, close), text_size=ppdTextSizeInput, text_halign=text.align_right)
    table.cell(ppdTable, 0, 7, "1 Month High", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 7, ppdFmt(ppdHigh1Month), text_color=ppdWhite, bgcolor=ppdValBg(ppdHigh1Month, close), text_size=ppdTextSizeInput, text_halign=text.align_right)

    table.cell(ppdTable, 0, 8, "PIVOT LEVELS", text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput, text_halign=text.align_center)
    table.cell(ppdTable, 1, 8, "",             text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput)
    table.cell(ppdTable, 0, 9, "Pivot Point", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 9, ppdFmt(ppdPivotPoint), text_color=ppdWhite, bgcolor=ppdValBg(ppdPivotPoint, close), text_size=ppdTextSizeInput, text_halign=text.align_right)
    table.cell(ppdTable, 0, 10, "Pivot Resistance 1", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 10, ppdFmt(ppdPivotR1), text_color=ppdWhite, bgcolor=ppdValBg(ppdPivotR1, close), text_size=ppdTextSizeInput, text_halign=text.align_right)
    table.cell(ppdTable, 0, 11, "Pivot Support 1", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 11, ppdFmt(ppdPivotS1), text_color=ppdWhite, bgcolor=ppdValBg(ppdPivotS1, close), text_size=ppdTextSizeInput, text_halign=text.align_right)

    table.cell(ppdTable, 0, 12, "TREND AND VALUE", text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput, text_halign=text.align_center)
    table.cell(ppdTable, 1, 12, "",                text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput)
    table.cell(ppdTable, 0, 13, "20 Day Moving Average", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 13, ppdFmt(ppdMA20D), text_color=ppdWhite, bgcolor=ppdValBg(ppdMA20D, close), text_size=ppdTextSizeInput, text_halign=text.align_right)
    table.cell(ppdTable, 0, 14, "50 Day Moving Average", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 14, ppdFmt(ppdMA50D), text_color=ppdWhite, bgcolor=ppdValBg(ppdMA50D, close), text_size=ppdTextSizeInput, text_halign=text.align_right)
    table.cell(ppdTable, 0, 15, "200 Day Moving Average", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 15, ppdFmt(ppdMA200D), text_color=ppdWhite, bgcolor=ppdValBg(ppdMA200D, close), text_size=ppdTextSizeInput, text_halign=text.align_right)
    table.cell(ppdTable, 0, 16, "Fibonacci 38.2%", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 16, ppdFmt(ppdFib38), text_color=ppdWhite, bgcolor=ppdValBg(ppdFib38, close), text_size=ppdTextSizeInput, text_halign=text.align_right)
    table.cell(ppdTable, 0, 17, "VWAP", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 17, ppdFmt(ppdVwap), text_color=ppdWhite, bgcolor=ppdValBg(ppdVwap, close), text_size=ppdTextSizeInput, text_halign=text.align_right)
    string ppdDistTxt = na(ppdDistBelow52Wk) ? "n/a" : str.tostring(ppdDistBelow52Wk, "#.##") + "%"
    table.cell(ppdTable, 0, 18, "Distance Below 52 Wk High", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 18, ppdDistTxt, text_color=ppdWhite, bgcolor=ppdDistBg, text_size=ppdTextSizeInput, text_halign=text.align_right)

    table.cell(ppdTable, 0, 19, "PREVIOUS DAY LEVELS", text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput, text_halign=text.align_center)
    table.cell(ppdTable, 1, 19, "",                    text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput)
    table.cell(ppdTable, 0, 20, "Previous Day High", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 20, ppdFmt(ppdPrevDayHigh), text_color=ppdWhite, bgcolor=ppdValBg(ppdPrevDayHigh, close), text_size=ppdTextSizeInput, text_halign=text.align_right)
    table.cell(ppdTable, 0, 21, "Previous Day Low", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 21, ppdFmt(ppdPrevDayLow), text_color=ppdWhite, bgcolor=ppdValBg(ppdPrevDayLow, close), text_size=ppdTextSizeInput, text_halign=text.align_right)
    table.cell(ppdTable, 0, 22, "Previous Day Close", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 22, ppdFmt(ppdPrevDayClose), text_color=ppdWhite, bgcolor=ppdValBg(ppdPrevDayClose, close), text_size=ppdTextSizeInput, text_halign=text.align_right)

    table.cell(ppdTable, 0, 23, "OPENING RANGE (" + ppdOrWindow + ")", text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput, text_halign=text.align_center)
    table.cell(ppdTable, 1, 23, "",                                     text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput)
    table.cell(ppdTable, 0, 24, "Opening Range High", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 24, ppdFmt(ppdOrHigh), text_color=ppdWhite, bgcolor=ppdValBg(ppdOrHigh, close), text_size=ppdTextSizeInput, text_halign=text.align_right)
    table.cell(ppdTable, 0, 25, "Opening Range Low", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 25, ppdFmt(ppdOrLow), text_color=ppdWhite, bgcolor=ppdValBg(ppdOrLow, close), text_size=ppdTextSizeInput, text_halign=text.align_right)
    table.cell(ppdTable, 0, 26, "Distance from OR High", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 26, ppdFmtPct(ppdOrDistHigh), text_color=ppdWhite, bgcolor=ppdOrDistBg(ppdOrDistHigh), text_size=ppdTextSizeInput, text_halign=text.align_right)
    table.cell(ppdTable, 0, 27, "Distance from OR Low", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 27, ppdFmtPct(ppdOrDistLow), text_color=ppdWhite, bgcolor=ppdOrDistBg(ppdOrDistLow), text_size=ppdTextSizeInput, text_halign=text.align_right)

    table.cell(ppdTable, 0, 28, "VOLATILITY AND FLOW", text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput, text_halign=text.align_center)
    table.cell(ppdTable, 1, 28, "",                    text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput)
    table.cell(ppdTable, 0, 29, "ATR " + str.tostring(atrLen), text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 29, ppdFmt(atrNow), text_color=ppdWhite, bgcolor=ppdDistBg, text_size=ppdTextSizeInput, text_halign=text.align_right)
    table.cell(ppdTable, 0, 30, "ATR % of Price", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 30, ppdFmtPct(ppdATRpct), text_color=ppdWhite, bgcolor=ppdDistBg, text_size=ppdTextSizeInput, text_halign=text.align_right)
    table.cell(ppdTable, 0, 31, "Gap %", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 31, ppdFmtPct(gapPct), text_color=ppdWhite, bgcolor=ppdPctBg(gapPct), text_size=ppdTextSizeInput, text_halign=text.align_right)
    table.cell(ppdTable, 0, 32, "Distance from Open", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 32, ppdFmtPct(distFromOpenPct), text_color=ppdWhite, bgcolor=ppdPctBg(distFromOpenPct), text_size=ppdTextSizeInput, text_halign=text.align_right)
    table.cell(ppdTable, 0, 33, "VWAP Deviation %", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 33, ppdFmtPct(vwapDevPct), text_color=ppdWhite, bgcolor=ppdVwapDevBg(vwapDevPct), text_size=ppdTextSizeInput, text_halign=text.align_right)
    string rvolTxt = na(rvolVal) ? "n/a" : str.tostring(rvolVal, "#.##") + "x"
    table.cell(ppdTable, 0, 34, "Relative Volume (RVOL)", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
    table.cell(ppdTable, 1, 34, rvolTxt, text_color=ppdWhite, bgcolor=rvolColor(rvolVal), text_size=ppdTextSizeInput, text_halign=text.align_right)

    if showTSS
        table.cell(ppdTable, 0, 35, "TREND STRENGTH SCORE", text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput, text_halign=text.align_center)
        table.cell(ppdTable, 1, 35, "",                      text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput)
        string tssTxt = str.tostring(math.round(tssScore)) + " / 100"
        table.cell(ppdTable, 0, 36, "Trend Strength (0-100)", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
        table.cell(ppdTable, 1, 36, tssTxt, text_color=ppdWhite, bgcolor=p2TssBg(tssScore), text_size=ppdTextSizeInput, text_halign=text.align_right)
    else
        table.cell(ppdTable, 0, 35, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)
        table.cell(ppdTable, 1, 35, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)
        table.cell(ppdTable, 0, 36, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)
        table.cell(ppdTable, 1, 36, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)

    if showTPS
        table.cell(ppdTable, 0, 37, "TRADE PROBABILITY SCORE", text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput, text_halign=text.align_center)
        table.cell(ppdTable, 1, 37, "",                         text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput)
        string tpsTxt  = str.tostring(math.round(tpsScore)) + " / 100"
        table.cell(ppdTable, 0, 38, "Trade Prob (Long Setup)", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
        table.cell(ppdTable, 1, 38, tpsTxt, text_color=ppdWhite, bgcolor=p2TpsBg(tpsScore), text_size=ppdTextSizeInput, text_halign=text.align_right)
        table.cell(ppdTable, 0, 39, "Interpretation", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
        table.cell(ppdTable, 1, 39, tpsLabel, text_color=ppdWhite, bgcolor=p2TpsBg(tpsScore), text_size=ppdTextSizeInput, text_halign=text.align_right)
    else
        table.cell(ppdTable, 0, 37, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)
        table.cell(ppdTable, 1, 37, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)
        table.cell(ppdTable, 0, 38, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)
        table.cell(ppdTable, 1, 38, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)
        table.cell(ppdTable, 0, 39, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)
        table.cell(ppdTable, 1, 39, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)

    if showRS
        table.cell(ppdTable, 0, 40, "RELATIVE STRENGTH", text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput, text_halign=text.align_center)
        table.cell(ppdTable, 1, 40, "",                  text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput)
        string rs1Txt = na(p2RS1) ? "n/a" : (p2RS1 >= 0 ? "+" : "") + str.tostring(p2RS1, "#.##") + "% vs " + _b1Name
        string rs2Txt = na(p2RS2) ? "n/a" : (p2RS2 >= 0 ? "+" : "") + str.tostring(p2RS2, "#.##") + "% vs " + _b2Name
        string rs1Lbl = "RS vs " + _b1Name + (p2RS1Bull ? " UP" : not na(p2RS1) ? " DN" : "")
        string rs2Lbl = "RS vs " + _b2Name + (p2RS2Bull ? " UP" : not na(p2RS2) ? " DN" : "")
        table.cell(ppdTable, 0, 41, rs1Lbl, text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
        table.cell(ppdTable, 1, 41, rs1Txt, text_color=ppdWhite, bgcolor=p2RsBg(p2RS1), text_size=ppdTextSizeInput, text_halign=text.align_right)
        table.cell(ppdTable, 0, 42, rs2Lbl, text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
        table.cell(ppdTable, 1, 42, rs2Txt, text_color=ppdWhite, bgcolor=p2RsBg(p2RS2), text_size=ppdTextSizeInput, text_halign=text.align_right)
    else
        table.cell(ppdTable, 0, 40, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)
        table.cell(ppdTable, 1, 40, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)
        table.cell(ppdTable, 0, 41, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)
        table.cell(ppdTable, 1, 41, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)
        table.cell(ppdTable, 0, 42, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)
        table.cell(ppdTable, 1, 42, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)

    if showVolState
        table.cell(ppdTable, 0, 43, "VOLATILITY STATE", text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput, text_halign=text.align_center)
        table.cell(ppdTable, 1, 43, "",                  text_color=ppdWhite, bgcolor=ppdSectBg, text_size=ppdTextSizeInput)
        string bbwTxt = na(p2BBWidth) ? "n/a" : str.tostring(p2BBWidth * 100.0, "#.##") + "%"
        table.cell(ppdTable, 0, 44, "BB/KC State", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
        table.cell(ppdTable, 1, 44, p2VolState, text_color=ppdWhite, bgcolor=p2VolBg(p2VolState), text_size=ppdTextSizeInput, text_halign=text.align_right)
        table.cell(ppdTable, 0, 45, "BB Width %", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput, text_halign=text.align_left)
        table.cell(ppdTable, 1, 45, bbwTxt, text_color=ppdWhite, bgcolor=ppdDistBg, text_size=ppdTextSizeInput, text_halign=text.align_right)
    else
        table.cell(ppdTable, 0, 43, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)
        table.cell(ppdTable, 1, 43, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)
        table.cell(ppdTable, 0, 44, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)
        table.cell(ppdTable, 1, 44, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)
        table.cell(ppdTable, 0, 45, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)
        table.cell(ppdTable, 1, 45, "", text_color=ppdWhite, bgcolor=ppdNameBg, text_size=ppdTextSizeInput)

//====================================================================
// Section #20 | LIQUIDITY SWEEP LABELS
//====================================================================
bool sweepGate = showSweeps and (not sweepOnClose or barstate.isconfirmed)

if sweepGate and p2SweepHigh
    label.new(bar_index, high, "SweepHigh",
         yloc=yloc.abovebar,
         style=label.style_none,
         color=color.new(color.red, 100),
         textcolor=color.new(color.red, 0),
         size=size.small)

if sweepGate and p2SweepLow
    label.new(bar_index, low, "SweepLow",
         yloc=yloc.belowbar,
         style=label.style_none,
         color=color.new(color.teal, 100),
         textcolor=color.new(color.teal, 0),
         size=size.small)
