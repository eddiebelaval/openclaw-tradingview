// SECTION 57: DELTA PROXY HISTOGRAM (Optional)
// ═══════════════════════════════════════════════════════════════════════════════

deltaHistColor = normalizedDelta > 0 ? color.new(color.teal, 50) : color.new(color.orange, 50)
plot(plotDeltaHistogram ? normalizedDelta * 20 : na, title="Delta Proxy", color=deltaHistColor, style=plot.style_columns, linewidth=2)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 58: BUY/SELL SIGNAL ARROWS
// ═══════════════════════════════════════════════════════════════════════════════

// UPDATED: only tiny/small options
plotshape(zenithSell and arrowSize == "tiny",  title="SELL Tiny",  location=location.top,    color=color.red,  style=shape.triangledown, size=size.tiny,  text="SELL")
plotshape(zenithSell and arrowSize == "small", title="SELL Small", location=location.top,    color=color.red,  style=shape.triangledown, size=size.small, text="SELL")

plotshape(zenithBuy and arrowSize == "tiny",   title="BUY Tiny",   location=location.bottom, color=color.lime, style=shape.triangleup,   size=size.tiny,  text="BUY")
plotshape(zenithBuy and arrowSize == "small",  title="BUY Small",  location=location.bottom, color=color.lime, style=shape.triangleup,   size=size.small, text="BUY")

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 59: DIVERGENCE SIGNAL LABELS (MANAGED with Toggle)
// ═══════════════════════════════════════════════════════════════════════════════

// Helper to add managed divergence labels
f_addDivLabel(arr, lbl, maxLabels) =>
    array.push(arr, lbl)
    while array.size(arr) > maxLabels
        oldLbl = array.shift(arr)
        label.delete(oldLbl)

// RSI Bullish Divergence labels
if isBullDiv
    lblText = showDivLabelText ? "▲\nRSI\nBULL" : "▲"
    newLbl = label.new(bar_index - divLookbackR, lowLevel, lblText, color=color.new(color.white, 100), textcolor=divBullColor, style=label.style_label_up, size=size.small, force_overlay=true)
    f_addDivLabel(rsiBullDivLabels, newLbl, maxDivLabels)

// RSI Bearish Divergence labels
if isBearDiv
    lblText = showDivLabelText ? "RSI\nBEAR\n▼" : "▼"
    newLbl = label.new(bar_index - divLookbackR, highLevel, lblText, color=color.new(color.white, 100), textcolor=divBearColor, style=label.style_label_down, size=size.small, force_overlay=true)
    f_addDivLabel(rsiBearDivLabels, newLbl, maxDivLabels)

// Score Bullish Divergence labels
if isScoreBullDiv
    lblText = showDivLabelText ? "▲\nSCORE\nBULL" : "▲"
    newLbl = label.new(bar_index - scoreDivLookbackR, scoreLowLevel, lblText, color=color.new(color.white, 100), textcolor=scoreDivColor, style=label.style_label_up, size=size.small, force_overlay=true)
    f_addDivLabel(scoreBullDivLabels, newLbl, maxDivLabels)

// Score Bearish Divergence labels
if isScoreBearDiv
    lblText = showDivLabelText ? "SCORE\nBEAR\n▼" : "▼"
    newLbl = label.new(bar_index - scoreDivLookbackR, scoreHighLevel, lblText, color=color.new(color.white, 100), textcolor=scoreDivColor, style=label.style_label_down, size=size.small, force_overlay=true)
    f_addDivLabel(scoreBearDivLabels, newLbl, maxDivLabels)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 60: BACKGROUND EFFECTS
// ═══════════════════════════════════════════════════════════════════════════════

// Main flash background
bgcolor(enableBgFlash ? flashColor : na, title="Zone Flash")

// Time zone background (chart overlay handled via plot)
bgcolor(timeZoneBgColor, title="Time Zone Highlight")

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 61: DIVERGENCE ZONE MANAGEMENT (WITH LINE CAP & EXPIRATION)
// ═══════════════════════════════════════════════════════════════════════════════

if showDivZones
    // RSI divergence zones (separate arrays, with maxDivZoneLines cap and expiration)
    plotDivergenceZones(bearDivLines, isBearDiv, false, divLookbackR, divBullColor, divBearColor, maxDivZoneLines, divLineOpacity, divZoneOpacity, divZoneExpireBars)
    plotDivergenceZones(bullDivLines, isBullDiv, true, divLookbackR, divBullColor, divBearColor, maxDivZoneLines, divLineOpacity, divZoneOpacity, divZoneExpireBars)

    // Score divergence zones (SEPARATE arrays - fixes contamination, with cap and expiration)
    plotScoreDivergenceZones(scoreBearDivLines, isScoreBearDiv, false, scoreDivLookbackR, scoreDivColor, maxDivZoneLines, divLineOpacity, divZoneOpacity, divZoneExpireBars)
    plotScoreDivergenceZones(scoreBullDivLines, isScoreBullDiv, true, scoreDivLookbackR, scoreDivColor, maxDivZoneLines, divLineOpacity, divZoneOpacity, divZoneExpireBars)

// FIXED: Accurate drawing object counts
divZoneLinesCount =
     array.size(bearDivLines) * 2 +
     array.size(bullDivLines) * 2 +
     array.size(scoreBearDivLines) * 2 +
     array.size(scoreBullDivLines) * 2

targetLinesCount =
     (not na(stopLine) ? 1 : 0) +
     (not na(target1Line) ? 1 : 0) +
     (not na(target2Line) ? 1 : 0) +
     (not na(target3Line) ? 1 : 0)

totalLinesActive := divZoneLinesCount + targetLinesCount

targetLabelsCount =
     (not na(stopLabel) ? 1 : 0) +
     (not na(target1Label) ? 1 : 0) +
     (not na(target2Label) ? 1 : 0) +
     (not na(target3Label) ? 1 : 0)

totalLabelsActive :=
     array.size(rsiBullDivLabels) +
     array.size(rsiBearDivLabels) +
     array.size(scoreBullDivLabels) +
     array.size(scoreBearDivLabels) +
     array.size(sweepLabels) +
     array.size(exhaustLabels) +
     targetLabelsCount

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 62: ALERTS
// ═══════════════════════════════════════════════════════════════════════════════

// Build alert suffix strings
aiSuffix = enableAI and showAIScore ? " | AI: " + str.tostring(aiConfidence, "#") + "%" : ""
perfSuffix = enablePerformance and showPerformance ? " | WR: " + str.tostring(winRate, "#") + "%" : ""
strengthSuffix = " | Grade: " + signalGrade + " (" + str.tostring(signalStrength, "#") + "%)"
mtfSuffix = enableMTFScore ? " | HTF: " + str.tostring(htfScoreValue, "#") : ""

// Main signal alerts
if zenithSell
    alert("🔴 ZENITH SELL (Score: " + str.tostring(reversalScore, "#") + ")" + strengthSuffix + aiSuffix + mtfSuffix + perfSuffix, alert.freq_once_per_bar)

if zenithBuy
    alert("🟢 ZENITH BUY (Score: " + str.tostring(reversalScore, "#") + ")" + strengthSuffix + aiSuffix + mtfSuffix + perfSuffix, alert.freq_once_per_bar)

// Zone alerts
if reversalScore >= 90
    alert("🚨 EXTREME PEAK ZONE - High Prob Reversal Area (Score: " + str.tostring(reversalScore, "#") + ")", alert.freq_once_per_bar)

if reversalScore <= -90
    alert("🚨 EXTREME VALLEY ZONE - High Prob Reversal Area (Score: " + str.tostring(reversalScore, "#") + ")", alert.freq_once_per_bar)

// Divergence alerts
if isBearDiv
    alert("🐻 RSI BEARISH DIVERGENCE - Price HH, RSI LH", alert.freq_once_per_bar)

if isBullDiv
    alert("🐂 RSI BULLISH DIVERGENCE - Price LL, RSI HL", alert.freq_once_per_bar)

if isScoreBearDiv
    alert("🔻 SCORE BEARISH DIVERGENCE - Price HH, Score LH (Very Strong!)", alert.freq_once_per_bar)

if isScoreBullDiv
    alert("🔺 SCORE BULLISH DIVERGENCE - Price LL, Score HL (Very Strong!)", alert.freq_once_per_bar)

// Liquidity sweep alerts
if bullishSweep
    alert("💧 BULLISH LIQUIDITY SWEEP - Stops hunted below " + str.tostring(priorSwingLow, "#.##"), alert.freq_once_per_bar)

if bearishSweep
    alert("💧 BEARISH LIQUIDITY SWEEP - Stops hunted above " + str.tostring(priorSwingHigh, "#.##"), alert.freq_once_per_bar)

// Exhaustion alerts
if exhaustionBull
    alert("⚡ BULLISH EXHAUSTION PATTERN - Volume spike with price stall", alert.freq_once_per_bar)

if exhaustionBear
    alert("⚡ BEARISH EXHAUSTION PATTERN - Volume spike with price stall", alert.freq_once_per_bar)

// High confluence alerts
if bullConfluence >= 6
    alert("🎯 HIGH BULL CONFLUENCE (" + str.tostring(bullConfluence) + "/9 factors)", alert.freq_once_per_bar)

if bearConfluence >= 6
    alert("🎯 HIGH BEAR CONFLUENCE (" + str.tostring(bearConfluence) + "/9 factors)", alert.freq_once_per_bar)

// AI high confidence alert
if enableAI and aiConfidence > 80 and (zenithSell or zenithBuy)
    alert("🤖 HIGH AI CONFIDENCE (" + str.tostring(aiConfidence, "#") + "%) - Strong Pattern Match", alert.freq_once_per_bar)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 63: INFO PANEL
// ═══════════════════════════════════════════════════════════════════════════════

if showInfoPanel and barstate.islast
    divStatus = isScoreBearDiv ? "🔻 SCORE" : isScoreBullDiv ? "🔺 SCORE" : isBearDiv ? "🐻 RSI" : isBullDiv ? "🐂 RSI" : "⚪ NONE"
    signalStatus = zenithSell ? "🔴 SELL" : zenithBuy ? "🟢 BUY" : "⚪ WAIT"
    sweepStatus = bullishSweep ? "💧 BULL" : bearishSweep ? "💧 BEAR" : "⚪ NONE"
    exhaustStatus = exhaustionBull ? "⚡ BULL" : exhaustionBear ? "⚡ BEAR" : "⚪ NONE"
    timeStatus = isOpenDrive ? "🟢 OPEN" : isCloseDrive ? "🔵 CLOSE" : isLunchHour ? "⚠️ LUNCH" : isDeadZone ? "🔴 DEAD" : "⚪ NORM"

    if useTable
        // Calculate rows needed
        baseRows = 8
        extraRows = (showPerformance ? 3 : 0) + (showAIScore ? 1 : 0) + (showMTFScorePanel ? 1 : 0) + (showDeltaInPanel ? 1 : 0)
        totalRows = baseRows + extraRows

        tablePos = infoPanelPos == "top_left" ? position.top_left :
                   infoPanelPos == "top_center" ? position.top_center :
                   infoPanelPos == "top_right" ? position.top_right :
                   infoPanelPos == "bottom_left" ? position.bottom_left :
                   infoPanelPos == "bottom_center" ? position.bottom_center : position.bottom_right

        var table infoTable = table.new(tablePos, 2, totalRows, bgcolor=color.new(color.navy, infoPanelBgOpacity), border_width=1, border_color=color.gray, frame_width=1, frame_color=color.white)

        table.clear(infoTable, 0, 0, 1, totalRows - 1)

        tSize = infoPanelSize == "tiny" ? size.tiny : infoPanelSize == "small" ? size.small : infoPanelSize == "normal" ? size.normal : size.large

        row = 0

        // Core metrics
        table.cell(infoTable, 0, row, "Score:", text_color=color.white, text_size=tSize)
        table.cell(infoTable, 1, row, formatValue(reversalScore), text_color=reversalScore > 0 ? color.orange : color.aqua, text_size=tSize)
        row += 1

        table.cell(infoTable, 0, row, "Signal:", text_color=color.white, text_size=tSize)
        table.cell(infoTable, 1, row, signalStatus + (zenithSell or zenithBuy ? " [" + signalGrade + "]" : ""), text_color=color.white, text_size=tSize)
        row += 1

        table.cell(infoTable, 0, row, "RSI/MFI:", text_color=color.white, text_size=tSize)
        table.cell(infoTable, 1, row, formatValue(rsiSmooth) + " / " + formatValue(mfi), text_color=color.orange, text_size=tSize)
        row += 1

        table.cell(infoTable, 0, row, "Divergence:", text_color=color.white, text_size=tSize)
        table.cell(infoTable, 1, row, divStatus, text_color=color.white, text_size=tSize)
        row += 1

        table.cell(infoTable, 0, row, "Sweep:", text_color=color.white, text_size=tSize)
        table.cell(infoTable, 1, row, sweepStatus, text_color=color.white, text_size=tSize)
        row += 1

        table.cell(infoTable, 0, row, "Exhaust:", text_color=color.white, text_size=tSize)
        table.cell(infoTable, 1, row, exhaustStatus, text_color=color.white, text_size=tSize)
        row += 1

        table.cell(infoTable, 0, row, "Time:", text_color=color.white, text_size=tSize)
        table.cell(infoTable, 1, row, timeStatus, text_color=color.white, text_size=tSize)
        row += 1

        table.cell(infoTable, 0, row, "Confluence:", text_color=color.white, text_size=tSize)
        confText = "🐂" + str.tostring(bullConfluence) + " / 🐻" + str.tostring(bearConfluence)
        table.cell(infoTable, 1, row, confText, text_color=bullConfluence > bearConfluence ? color.lime : bearConfluence > bullConfluence ? color.red : color.gray, text_size=tSize)
        row += 1

        // Optional rows
        if showMTFScorePanel
            table.cell(infoTable, 0, row, "HTF Score:", text_color=color.white, text_size=tSize)
            htfCol = htfScoreValue > 50 ? color.red : htfScoreValue < -50 ? color.lime : color.gray
            table.cell(infoTable, 1, row, formatValue(htfScoreValue), text_color=htfCol, text_size=tSize)
            row += 1

        if showDeltaInPanel
            table.cell(infoTable, 0, row, "Delta:", text_color=color.white, text_size=tSize)
            deltaCol = normalizedDelta > 0.3 ? color.lime : normalizedDelta < -0.3 ? color.red : color.gray
            table.cell(infoTable, 1, row, formatValue(normalizedDelta), text_color=deltaCol, text_size=tSize)
            row += 1

        if showAIScore
            table.cell(infoTable, 0, row, "🤖 AI:", text_color=color.white, text_size=tSize)
            aiCol = aiConfidence > 60 ? color.lime : aiConfidence < 40 ? color.red : color.orange
            table.cell(infoTable, 1, row, formatValue(aiConfidence) + "% (" + str.tostring(patternCount) + " matches)", text_color=aiCol, text_size=tSize)
            row += 1

        if showPerformance and enablePerformance
            table.cell(infoTable, 0, row, "📈 Win Rate:", text_color=color.white, text_size=tSize)
            wrCol = winRate > 60 ? color.lime : winRate < 40 ? color.red : color.orange
            table.cell(infoTable, 1, row, formatValue(winRate) + "%", text_color=wrCol, text_size=tSize)
            row += 1

            table.cell(infoTable, 0, row, "Signals:", text_color=color.white, text_size=tSize)
            table.cell(infoTable, 1, row, str.tostring(totalSignals) + " (W:" + str.tostring(winningSignals) + " L:" + str.tostring(losingSignals) + ")", text_color=color.gray, text_size=tSize)
            row += 1

            table.cell(infoTable, 0, row, "Avg Return:", text_color=color.white, text_size=tSize)
            table.cell(infoTable, 1, row, formatValue(avgReturn) + "%", text_color=avgReturn > 0 ? color.lime : color.red, text_size=tSize)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 64: KEY FACTORS TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if showKeyFactors and barstate.islast and factorCount > 0
    factorsPos = factorsPosition == "top_left" ? position.top_left :
                 factorsPosition == "top_center" ? position.top_center :
                 factorsPosition == "top_right" ? position.top_right :
                 factorsPosition == "middle_left" ? position.middle_left :
                 factorsPosition == "middle_center" ? position.middle_center :
                 factorsPosition == "middle_right" ? position.middle_right :
                 factorsPosition == "bottom_left" ? position.bottom_left :
                 factorsPosition == "bottom_center" ? position.bottom_center : position.bottom_right

    var table factorsTable = table.new(factorsPos, 1, factorCount + 1, bgcolor=color.new(color.maroon, 85), border_width=1, border_color=color.white, frame_width=1, frame_color=color.yellow)

    table.clear(factorsTable, 0, 0, 0, factorCount)

    table.cell(factorsTable, 0, 0, "🎯 KEY FACTORS (" + str.tostring(factorCount) + ")", text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.red, 20))

    factorLines = str.split(keyFactorsText, "\n")
    for i = 0 to math.min(array.size(factorLines) - 1, factorCount - 1)
        if i < factorCount and array.size(factorLines) > i
            table.cell(factorsTable, 0, i + 1, array.get(factorLines, i), text_color=color.white, text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 65: LIVE MARKET ANALYSIS PANEL
// ═══════════════════════════════════════════════════════════════════════════════

if showLiveAnalysis and barstate.islast
    currentSituation = ""
    suggestedAction = ""
    riskLevel = ""
    confidence = ""

    // Analyze current market state
    if reversalScore >= 90
        currentSituation := "EXTREME PEAK - Severely overbought"
        suggestedAction := "PREPARE SHORT - Wait for turn"
        riskLevel := "HIGH"
        confidence := "85%"
    else if reversalScore >= peakTH
        currentSituation := "PEAK ZONE - Overbought"
        suggestedAction := zenithSell ? "🔴 SELL ACTIVE [" + signalGrade + "]" : "MONITOR for turn"
        riskLevel := "ELEVATED"
        confidence := "70%"
    else if reversalScore <= -90
        currentSituation := "EXTREME VALLEY - Severely oversold"
        suggestedAction := "PREPARE LONG - Wait for turn"
        riskLevel := "HIGH"
        confidence := "85%"
    else if reversalScore <= valleyTH
        currentSituation := "VALLEY ZONE - Oversold"
        suggestedAction := zenithBuy ? "🟢 BUY ACTIVE [" + signalGrade + "]" : "MONITOR for turn"
        riskLevel := "ELEVATED"
        confidence := "70%"
    else if math.abs(reversalScore) < 30
        currentSituation := "NEUTRAL - No clear direction"
        suggestedAction := "WAIT - No setup"
        riskLevel := "LOW"
        confidence := "40%"
    else
        currentSituation := "TRENDING toward extreme"
        suggestedAction := "PREPARE - Setup developing"
        riskLevel := "MODERATE"
        confidence := "55%"

    // Divergence boost
    divAnalysis = ""
    if isScoreBearDiv
        divAnalysis := " + SCORE BEAR DIV"
        confidence := "95%"
    else if isScoreBullDiv
        divAnalysis := " + SCORE BULL DIV"
        confidence := "95%"
    else if isBearDiv
        divAnalysis := " + RSI BEAR DIV"
    else if isBullDiv
        divAnalysis := " + RSI BULL DIV"

    // Sweep addition
    sweepAnalysis = bullishSweep ? " + BULL SWEEP" : bearishSweep ? " + BEAR SWEEP" : ""

    analysisPos = analysisPosition == "top_left" ? position.top_left :
                  analysisPosition == "top_center" ? position.top_center :
                  analysisPosition == "top_right" ? position.top_right :
                  analysisPosition == "middle_left" ? position.middle_left :
                  analysisPosition == "middle_center" ? position.middle_center :
                  analysisPosition == "middle_right" ? position.middle_right :
                  analysisPosition == "bottom_left" ? position.bottom_left :
                  analysisPosition == "bottom_center" ? position.bottom_center : position.bottom_right

    var table liveTable = table.new(analysisPos, 1, 6, bgcolor=color.new(color.black, 75), border_width=2, border_color=color.white, frame_width=2, frame_color=color.yellow)

    table.clear(liveTable, 0, 0, 0, 5)

    table.cell(liveTable, 0, 0, "📊 LIVE ANALYSIS - Score: " + str.tostring(reversalScore, "#"), text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 40))
    table.cell(liveTable, 0, 1, currentSituation + divAnalysis + sweepAnalysis, text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 60))

    actionColor = str.contains(suggestedAction, "SELL") ? color.red : str.contains(suggestedAction, "BUY") ? color.lime : color.white
    table.cell(liveTable, 0, 2, "ACTION: " + suggestedAction, text_color=actionColor, text_size=size.small, bgcolor=color.new(color.black, 60))

    riskColor = riskLevel == "HIGH" ? color.red : riskLevel == "ELEVATED" ? color.orange : color.white
    table.cell(liveTable, 0, 3, "RISK: " + riskLevel + " | CONF: " + confidence, text_color=riskColor, text_size=size.small, bgcolor=color.new(color.black, 60))

    confText = "CONFLUENCE: 🐂" + str.tostring(bullConfluence) + "/9 | 🐻" + str.tostring(bearConfluence) + "/9"
    table.cell(liveTable, 0, 4, confText, text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 60))

    perfText = enablePerformance and totalSignals > 0 ? "PERF: " + str.tostring(winRate, "#") + "% WR (" + str.tostring(totalSignals) + " sigs)" : "PERF: Gathering data..."
    table.cell(liveTable, 0, 5, perfText, text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 60))

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 66: DRAWING OBJECT DEBUG PANEL
// ═══════════════════════════════════════════════════════════════════════════════

if showDrawingDebug and barstate.islast
    var table debugTable = table.new(position.bottom_left, 2, 6, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

    table.clear(debugTable, 0, 0, 1, 5)

    table.cell(debugTable, 0, 0, "🔧 DRAWING DEBUG", text_color=color.yellow, text_size=size.tiny, bgcolor=color.new(color.gray, 60))
    table.cell(debugTable, 1, 0, "", bgcolor=color.new(color.gray, 60))

    table.cell(debugTable, 0, 1, "Lines Active:", text_color=color.white, text_size=size.tiny)
    lineColor = totalLinesActive > 400 ? color.red : totalLinesActive > 300 ? color.orange : color.lime
    table.cell(debugTable, 1, 1, str.tostring(totalLinesActive) + " / 500", text_color=lineColor, text_size=size.tiny)

    table.cell(debugTable, 0, 2, "Labels Active:", text_color=color.white, text_size=size.tiny)
    labelColor = totalLabelsActive > 400 ? color.red : totalLabelsActive > 300 ? color.orange : color.lime
    table.cell(debugTable, 1, 2, str.tostring(totalLabelsActive) + " / 500", text_color=labelColor, text_size=size.tiny)

    table.cell(debugTable, 0, 3, "RSI Div Labels:", text_color=color.white, text_size=size.tiny)
    table.cell(debugTable, 1, 3, str.tostring(array.size(rsiBullDivLabels) + array.size(rsiBearDivLabels)), text_color=color.gray, text_size=size.tiny)

    table.cell(debugTable, 0, 4, "Score Div Labels:", text_color=color.white, text_size=size.tiny)
    table.cell(debugTable, 1, 4, str.tostring(array.size(scoreBullDivLabels) + array.size(scoreBearDivLabels)), text_color=color.gray, text_size=size.tiny)

    table.cell(debugTable, 0, 5, "Sweep/Exhaust:", text_color=color.white, text_size=size.tiny)
    table.cell(debugTable, 1, 5, str.tostring(array.size(sweepLabels)) + " / " + str.tostring(array.size(exhaustLabels)), text_color=color.gray, text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// END OF IRON DOME 48 ZENITH EDITION
// ═══════════════════════════════════════════════════════════════════════════════
