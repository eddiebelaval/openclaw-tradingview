     tooltip="When enabled, arrows require RSI or Score divergence confirmation.", group="📈 Divergence")
showMomentumRSI      = input.bool(true, "Show Momentum RSI (alongside regular RSI)", group="📈 Divergence")
useMomentumForDiv    = input.bool(true, "Use Momentum RSI for Divergence Detection", group="📈 Divergence")
divMomLen            = input.int(10, "Momentum Length for RSI", group="📈 Divergence", minval=5, maxval=20)
showDivZones         = input.bool(true, "Show Divergence Zones", group="📈 Divergence")
showDivLabelText     = input.bool(false, "Show Divergence Label Text", group="📈 Divergence")
