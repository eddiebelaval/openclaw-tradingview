// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 51: MAIN SCORE LINE PLOTTING
// ═══════════════════════════════════════════════════════════════════════════════

// Main reversal score plot
plot(reversalScore, title="Reversal Score", color=plotColor, linewidth=normalLineWidth)

// Score MAs
plot(plotMa ? scoreMa : na, title="Score MA", color=maColor, linewidth=maWidth)
plot(plotMa1 ? ma1 : na, title="MA Line 1", color=ma1Color, linewidth=ma1Width)
plot(plotMa2 ? ma2 : na, title="MA Line 2", color=ma2Color, linewidth=ma2Width)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 52: ROOM TO RUN HISTOGRAM
// ═══════════════════════════════════════════════════════════════════════════════

// Dynamic transparency helper (darker when LESS room; lighter when MORE room)
f_roomOpacity(val) =>
    absVal = math.min(100.0, math.abs(val))
    lo = math.min(minRoomToRunTransparency, histogramOpacity)
    hi = math.max(minRoomToRunTransparency, histogramOpacity)
    int(lo + (hi - lo) * (absVal / 100.0))

f_roomColor(val) =>
    op = useDynamicRoomOpacity ? f_roomOpacity(val) : histogramOpacity
    color.new(roomToRunHistColor, op)

histStyle = histogramStyle == "columns" ? plot.style_columns : plot.style_histogram

plot(roomToRunMode == "Dual Histograms" and showUpRoom ? roomToRunUp : na, title="Room to Run Up", color=f_roomColor(roomToRunUp), style=histStyle, linewidth=1)
plot(roomToRunMode == "Dual Histograms" and showDownRoom ? -roomToRunDown : na, title="Room to Run Down", color=f_roomColor(roomToRunDown), style=histStyle, linewidth=1)
plot(roomToRunMode != "Dual Histograms" ? finalRoomToRun : na, title="Room to Run", color=f_roomColor(finalRoomToRun), style=histStyle, linewidth=1)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 53: DIVERGENCE PLOTS (Indicator Pane)
// ═══════════════════════════════════════════════════════════════════════════════

noneCol = color.new(color.white, 100)

// RSI Divergence plots on indicator (thinner lines)
plot(foundPL ? rsiForDiv[divLookbackR] : na, offset=-divLookbackR, title='Bullish RSI HL', color=isBullDiv ? divBullColor : noneCol, linewidth=1)
plot(foundPH ? rsiForDiv[divLookbackR] : na, offset=-divLookbackR, title='Bearish RSI LH', color=isBearDiv ? divBearColor : noneCol, linewidth=1)

// Momentum RSI if enabled
plot(showMomentumRSI ? rsi : na, title="Regular RSI", color=color.new(color.blue, 30), linewidth=1)
plot(showMomentumRSI ? momentumRsi : na, title="Momentum RSI", color=color.new(color.orange, 30), linewidth=1)

// Score Line Divergence plots (thinner lines)
plot(scoreFoundPL ? scoreSeriesForDiv[scoreDivLookbackR] : na, offset=-scoreDivLookbackR, title='Bullish Score HL', color=isScoreBullDiv ? scoreDivColor : noneCol, linewidth=1, display=display.pane)
plot(scoreFoundPH ? scoreSeriesForDiv[scoreDivLookbackR] : na, offset=-scoreDivLookbackR, title='Bearish Score LH', color=isScoreBearDiv ? scoreDivColor : noneCol, linewidth=1, display=display.pane)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 54: DIVERGENCE PLOTS (Chart Overlay - RSI)
// ═══════════════════════════════════════════════════════════════════════════════

// RSI Bullish divergence on chart
plot(foundPL ? lowLevel : na, offset=-divLookbackR, title='Bullish Price LL', color=isBullDiv ? divBullColor : noneCol, linewidth=1, display=display.pane, force_overlay=true)
plot(foundPL ? lowLevel : na, offset=-divLookbackR, title='Bullish Price LL BG', color=isBullDiv ? color.new(divBullColor, 70) : noneCol, linewidth=6, display=display.pane, force_overlay=true)

// RSI Bearish divergence on chart
plot(foundPH ? highLevel : na, offset=-divLookbackR, title='Bearish Price HH', color=isBearDiv ? divBearColor : noneCol, linewidth=1, display=display.pane, force_overlay=true)
plot(foundPH ? highLevel : na, offset=-divLookbackR, title='Bearish Price HH BG', color=isBearDiv ? color.new(divBearColor, 70) : noneCol, linewidth=6, display=display.pane, force_overlay=true)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 55: DIVERGENCE PLOTS (Chart Overlay - Score)
// ═══════════════════════════════════════════════════════════════════════════════

// Score Bullish divergence on chart
plot(scoreFoundPL ? scoreLowLevel : na, offset=-scoreDivLookbackR, title='Score Bullish Price LL', color=isScoreBullDiv ? scoreDivColor : noneCol, linewidth=2, display=display.pane, force_overlay=true)
plot(scoreFoundPL ? scoreLowLevel : na, offset=-scoreDivLookbackR, title='Score Bullish Price LL BG', color=isScoreBullDiv ? color.new(scoreDivColor, 60) : noneCol, linewidth=8, display=display.pane, force_overlay=true)

// Score Bearish divergence on chart
plot(scoreFoundPH ? scoreHighLevel : na, offset=-scoreDivLookbackR, title='Score Bearish Price HH', color=isScoreBearDiv ? scoreDivColor : noneCol, linewidth=2, display=display.pane, force_overlay=true)
plot(scoreFoundPH ? scoreHighLevel : na, offset=-scoreDivLookbackR, title='Score Bearish Price HH BG', color=isScoreBearDiv ? color.new(scoreDivColor, 60) : noneCol, linewidth=8, display=display.pane, force_overlay=true)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 56: HORIZONTAL REFERENCE LINES
// ═══════════════════════════════════════════════════════════════════════════════

hline(90, title="PEAK REVERSAL ZONE (+) DEFAULT", color=color.new(color.red, 0), linestyle=hline.style_solid, linewidth=1)
hline(-90, title="VALLEY REVERSAL ZONE (-) DEFAULT", color=color.new(color.lime, 0), linestyle=hline.style_solid, linewidth=1)
hline(0, title="Neutral", color=color.new(color.gray, 0), linestyle=hline.style_dashed, linewidth=1)
hline(74, title="EXTREME PEAK (warning)", color=color.new(color.maroon, 0), linestyle=hline.style_dotted, linewidth=1)
hline(-74, title="EXTREME VALLEY (warning)", color=color.new(color.green, 0), linestyle=hline.style_dotted, linewidth=1)
hline(100, title="Max Bullish", color=color.new(color.red, 0), linestyle=hline.style_dashed, linewidth=1)
hline(-100, title="Max Bearish", color=color.new(color.lime, 0), linestyle=hline.style_dashed, linewidth=1)

// Adaptive threshold overlay
plot(useAdaptiveThresh ? peakTH : na, title="Adaptive Peak Threshold", color=color.new(color.red, 0), linewidth=1, style=plot.style_line)
plot(useAdaptiveThresh ? valleyTH : na, title="Adaptive Valley Threshold", color=color.new(color.lime, 0), linewidth=1, style=plot.style_line)

