divLookbackL         = input.int(5, "Divergence Lookback Left", group="📈 Divergence", minval=2, maxval=15)
divLookbackR         = input.int(3, "Divergence Lookback Right", group="📈 Divergence", minval=2, maxval=15)
minDivBars           = input.int(5, "Min Bars Between Divergence", group="📈 Divergence", minval=3, maxval=20)
maxDivBars           = input.int(50, "Max Bars Between Divergence", group="📈 Divergence", minval=20, maxval=100)
divBullColor         = input.color(#33c570, "Bullish Divergence Color", group="📈 Divergence")
divBearColor         = input.color(#ae4ce6, "Bearish Divergence Color", group="📈 Divergence")
scoreDivColor        = input.color(#ff9800, "Score Line Divergence Color", group="📈 Divergence")
divLineOpacity       = input.int(0, "Divergence Line Opacity", group="📈 Divergence", minval=0, maxval=90, tooltip="0 = fully visible, 90 = nearly invisible")
divZoneOpacity       = input.int(70, "Divergence Zone BG Opacity", group="📈 Divergence", minval=0, maxval=100)
divZoneExpireBars    = input.int(30, "Divergence Zone Expire (Bars)", group="📈 Divergence", minval=5, maxval=100, tooltip="Remove zone lines after N bars")
divWeight            = input.float(15.0, "Divergence Score Weight (RSI)", group="📈 Divergence", minval=0.0, maxval=50.0)

// Score Divergence (independent controls)
scoreDivLookbackL      = input.int(5, "Score Div Lookback Left", group="📈 Divergence - Score", minval=2, maxval=15)
scoreDivLookbackR      = input.int(3, "Score Div Lookback Right", group="📈 Divergence - Score", minval=2, maxval=15)
scoreMinDivBars        = input.int(5, "Score Min Bars Between Div", group="📈 Divergence - Score", minval=3, maxval=20)
scoreMaxDivBars        = input.int(50, "Score Max Bars Between Div", group="📈 Divergence - Score", minval=20, maxval=100)
scoreDivWeight         = input.float(18.0, "Score Divergence Weight", group="📈 Divergence - Score", minval=0.0, maxval=50.0)
useSmoothedScoreForDiv = input.bool(true, "Use Smoothed Base Score for Score-Div", group="📈 Divergence - Score")
scoreDivSmoothingLen   = input.int(2, "Score-Div Smoothing Length", group="📈 Divergence - Score", minval=2, maxval=50)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 5: ZENITH KILLER GATE
// ═══════════════════════════════════════════════════════════════════════════════
useZenithGate       = input.bool(false, "Enable Zenith Killer Gate", group="🧨 Zenith Killer")
