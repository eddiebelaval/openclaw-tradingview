// ═══════════════════════════════════════════════════════════════════════════════
useZScoreNorm     = input.bool(false, "Z-score normalize RSI/MFI", group="🔧 Enhancements")
useAdaptiveThresh = input.bool(true, "Adaptive thresholds by ATR", group="🔧 Enhancements")
zLookback         = input.int(100, "Z-score lookback", minval=20, maxval=500, group="🔧 Enhancements")

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 18: AUTO-SCALE PARAMETERS BY TIMEFRAME
// ═══════════════════════════════════════════════════════════════════════════════
var int   finalRsiLen  = 14
var int   finalMfiLen  = 14
var float finalVwapDev = 2.0
var int   finalMomLen  = 10

if autoTF
    if timeframe.isintraday and timeframe.multiplier <= 5
        finalRsiLen   := 9
        finalMfiLen   := 9
        finalVwapDev  := 1.5
        finalMomLen   := 6
    else if timeframe.isintraday and timeframe.multiplier <= 30
        finalRsiLen   := 14
        finalMfiLen   := 14
        finalVwapDev  := 2.0
        finalMomLen   := 10
    else if timeframe.isintraday and timeframe.in_seconds() >= 3600
        finalRsiLen   := 21
        finalMfiLen   := 21
        finalVwapDev  := 2.5
        finalMomLen   := 14
    else if timeframe.isdaily
        finalRsiLen   := 14
        finalMfiLen   := 14
        finalVwapDev  := 2.0
        finalMomLen   := 10
    else
        finalRsiLen   := 21
        finalMfiLen   := 21
        finalVwapDev  := 3.0
        finalMomLen   := 14
else
    finalRsiLen   := rsiLen
    finalMfiLen   := mfiLen
    finalVwapDev  := vwapDev
    finalMomLen   := momLen

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 19: MULTI-ANCHOR VWAP CALCULATION ENGINE
// ═══════════════════════════════════════════════════════════════════════════════

// --- Session Detection Functions ---
isIntraday = timeframe.isintraday

// RTH session check (based on explicit session timezone)
f_isRTH() =>
    h = hour(time, vwapSessionTz)
    m = minute(time, vwapSessionTz)
    startMins = rthStartHour * 60 + rthStartMinute
    endMins = rthEndHour * 60 + rthEndMinute
    currentMins = h * 60 + m
    currentMins >= startMins and currentMins < endMins

// ETH session check (inverse of RTH)
f_isETH() =>
    not f_isRTH()

isRTH = f_isRTH()
isETH = f_isETH()

// Session filter for VWAP calculation
sessionValid = vwapSessionType == "Full Session" ? true :
               vwapSessionType == "RTH Only" ? isRTH :
               vwapSessionType == "ETH Only" ? isETH : true

// --- Anchor Detection Functions ---

// Session anchor (daily reset)
var int sessionAnchor = na
if isIntraday
    if na(sessionAnchor) or (dayofweek != dayofweek[1] and sessionValid)
        sessionAnchor := time

// Weekly anchor (Monday open)
var int weeklyAnchor = na
if na(weeklyAnchor) or (dayofweek == dayofweek.monday and dayofweek[1] != dayofweek.monday)
    weeklyAnchor := time

// Monthly anchor
var int monthlyAnchor = na
if na(monthlyAnchor) or month != month[1]
    monthlyAnchor := time

// Quarterly Auto-Roll anchor (for ES/NQ futures)
// Roll dates: ~2nd Friday before 3rd Wednesday of March, June, Sept, Dec
f_getQuarterlyRollAnchor() =>
    m = month
    y = year
    // Determine current quarter's expiry month
    expiryMonth = m <= 3 ? 3 : m <= 6 ? 6 : m <= 9 ? 9 : 12
    // If we're past expiry month, move to next quarter
    expiryYear = expiryMonth < m ? y + 1 : y
    // Approximate roll: 1st of expiry month (simplified - true roll is complex)
    timestamp(expiryYear, expiryMonth, 1, 0, 0, 0)

var int quarterlyAnchor = na
quarterlyTarget = f_getQuarterlyRollAnchor()
if na(quarterlyAnchor) or (time >= quarterlyTarget and time[1] < quarterlyTarget)
    quarterlyAnchor := time

// Custom anchor
customAnchor = timestamp(rollYear, rollMonth, rollDay, rollHour, rollMinute, rollSecond)

// Select anchor based on user choice
chosenAnchor = vwapAnchorType == "Session" ? nz(sessionAnchor, time) :
               vwapAnchorType == "Weekly" ? nz(weeklyAnchor, time) :
               vwapAnchorType == "Monthly" ? nz(monthlyAnchor, time) :
               vwapAnchorType == "Quarterly (Auto-Roll)" ? nz(quarterlyAnchor, time) :
               vwapAnchorType == "Custom Date" ? customAnchor : time

// --- Anchored VWAP Calculation ---
f_anchored_vwap(src, vol, anchorTime, sessionFilter) =>
    var float cumPV = 0.0
    var float cumV  = 0.0

    // Reset on new anchor
    if time >= anchorTime and time[1] < anchorTime
        cumPV := 0.0
        cumV  := 0.0

    // Only accumulate during valid session
    if sessionFilter
        cumPV += src * vol
        cumV  += vol

    cumV != 0 ? cumPV / cumV : src

// Calculate VWAP
vwapCalc = vwapAnchorType == "None" ? ta.vwma(hlc3, finalRsiLen) :
           isIntraday ? f_anchored_vwap(hlc3, volume, chosenAnchor, sessionValid) :
           f_anchored_vwap(hlc3, volume, chosenAnchor, true)

// TRUE VWAP deviation (stdev of residuals: price - vwap)
vwapResid  = hlc3 - vwapCalc
vwapStdDev = ta.stdev(vwapResid, finalRsiLen)

upperBand = vwapCalc + (vwapStdDev * finalVwapDev)
lowerBand = vwapCalc - (vwapStdDev * finalVwapDev)

vwapPosition = close > upperBand ? 100.0 :
               close < lowerBand ? 0.0 :
               ((close - lowerBand) / math.max(upperBand - lowerBand, 1e-10)) * 100.0

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 20: CORE INDICATOR CALCULATIONS
// ═══════════════════════════════════════════════════════════════════════════════

// --- RSI Calculation ---
_rawRsi = ta.rsi(close, finalRsiLen)
rsiNorm = 50.0 + 10.0 * ((_rawRsi - ta.sma(_rawRsi, zLookback)) / math.max(ta.stdev(_rawRsi, zLookback), 1e-10))
rsi     = useZScoreNorm ? math.max(0.0, math.min(100.0, rsiNorm)) : _rawRsi
rsiSmooth = ta.sma(rsi, 3)

// Momentum RSI (for divergence option)
momentumRsi = ta.rsi(ta.mom(close, divMomLen), finalRsiLen)
momentumRsiSmooth = ta.sma(momentumRsi, 3)

// RSI for divergence detection
rsiForDiv = useMomentumForDiv ? momentumRsi : rsi

// --- MFI Calculation ---
_rawMfi = ta.mfi(hlc3, finalMfiLen)
mfiNorm = 50.0 + 10.0 * ((_rawMfi - ta.sma(_rawMfi, zLookback)) / math.max(ta.stdev(_rawMfi, zLookback), 1e-10))
mfi     = useZScoreNorm ? math.max(0.0, math.min(100.0, mfiNorm)) : _rawMfi

// --- Momentum Calculation ---
momentum  = ta.mom(close, finalMomLen)
momChange = ta.change(momentum)
momAccel  = momChange > 0 ? 1 : momChange < 0 ? -1 : 0

// --- Volume Analysis ---
avgVol    = ta.sma(volume, 20)
volSurge  = volume > (avgVol * 1.5)
climaxVol = volume >= (avgVol * climaxMult)

// --- ATR for targets/stops ---
atr14 = ta.atr(14)

// --- Candle Structure (for rejection detection) ---
body      = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

bearReject = (body > 0 ? upperWick / body : (upperWick > 0 ? 999.0 : 0.0)) >= wickBodyMin and close < open
bullReject = (body > 0 ? lowerWick / body : (lowerWick > 0 ? 999.0 : 0.0)) >= wickBodyMin and close > open

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 21: TIME-OF-DAY ANALYSIS (NEW)
// ═══════════════════════════════════════════════════════════════════════════════
currentHour = hour(time, timeFilterTz)
currentMinute = minute(time, timeFilterTz)
currentMins = currentHour * 60 + currentMinute

// Time zone definitions (interpreted in timeFilterTz)
isOpenDrive  = currentMins >= 570 and currentMins < 660   // 9:30 - 11:00
isCloseDrive = currentMins >= 870 and currentMins < 960   // 14:30 - 16:00
isLunchHour  = currentMins >= 690 and currentMins < 780   // 11:30 - 13:00
isDeadZone   = currentMins >= 960 and currentMins < 1080  // 16:00 - 18:00
isOvernight  = currentMins >= 1200 or currentMins < 120   // 20:00 - 02:00

// Time filter gate
timeFilterPass = true
if enableTimeFilter
    if avoidLunchHour and isLunchHour
        timeFilterPass := false
    if avoidDeadZone and isDeadZone
        timeFilterPass := false
    if avoidOvernightChop and isOvernight
        timeFilterPass := false

// Time boost calculation
timeBoost = 0.0
if enableTimeFilter
    if boostOpenDrive and isOpenDrive
        timeBoost := timeBoostWeight
    if boostCloseDrive and isCloseDrive
        timeBoost := timeBoostWeight

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 22: LIQUIDITY SWEEP DETECTION (NEW)
// ═══════════════════════════════════════════════════════════════════════════════
priorSwingHigh = ta.highest(high, sweepLookback)[1]
priorSwingLow  = ta.lowest(low, sweepLookback)[1]

// Bullish sweep: wick below prior low, close above (stop hunt below)
bullishSweep = enableSweepDetection and
               low < priorSwingLow and
               close > priorSwingLow and
               (priorSwingLow - low) >= atr14 * sweepAtrMult

// Bearish sweep: wick above prior high, close below (stop hunt above)
bearishSweep = enableSweepDetection and
               high > priorSwingHigh and
               close < priorSwingHigh and
               (high - priorSwingHigh) >= atr14 * sweepAtrMult

sweepBoost = bullishSweep ? sweepScoreBoost : bearishSweep ? -sweepScoreBoost : 0.0

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 23: DELTA PROXY CALCULATION (NEW)
// ═══════════════════════════════════════════════════════════════════════════════
// Simple delta proxy from candle structure
// Positive = buying pressure, Negative = selling pressure
deltaProxy = (close - low) - (high - close)
normalizedDelta = (high - low) != 0 ? deltaProxy / (high - low) : 0.0  // -1 to +1 scale

// Smoothed delta for confirmation
deltaProxySmooth = ta.ema(normalizedDelta, 3)

// Delta confirmation for signals
deltaBullConfirm = normalizedDelta >= deltaThreshold
deltaBearConfirm = normalizedDelta <= -deltaThreshold

// Delta contribution to score
deltaContrib = 0.0
if enableDeltaProxy
    deltaContrib := normalizedDelta * deltaProxyWeight

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 24: EXHAUSTION VOLUME PATTERN (NEW)
// ═══════════════════════════════════════════════════════════════════════════════
// Pattern: Volume spike → volume decline → price stalls
volSpike = volume[exhaustionDecayBars] > avgVol * exhaustionVolMult

volDecline = true
for i = 0 to exhaustionDecayBars - 2
    if volume[i] >= volume[i + 1]
        volDecline := false

priceStall = math.abs(close - close[exhaustionDecayBars]) < atr14 * exhaustionPriceStall

exhaustionPattern = enableExhaustion and volSpike and volDecline and priceStall

// Determine if exhaustion is bullish or bearish
exhaustionBull = exhaustionPattern and close > open[exhaustionDecayBars]
exhaustionBear = exhaustionPattern and close < open[exhaustionDecayBars]

exhaustionBoost = exhaustionBull ? exhaustionScoreBoost : exhaustionBear ? -exhaustionScoreBoost : 0.0

// ═══════════════════════════════════════════════════════════════════════════════
// END OF PART 1 - Continue in Part 2 for Divergence & Score Calculation
// ═══════════════════════════════════════════════════════════════════════════════

// Export key values for Part 2 (these will be recalculated there for compilation)
// rsi, rsiSmooth, mfi, vwapPosition, momentum, momAccel, volSurge, climaxVol
// bearReject, bullReject, timeFilterPass, timeBoost, sweepBoost, deltaContrib, exhaustionBoost
// bullishSweep, bearishSweep, exhaustionBull, exhaustionBear
// ═══════════════════════════════════════════════════════════════════════════════
// BK AK-IRON DOME 48 - ZENITH EDITION - PART 2/4 (DIVERGENCE & SCORE)
// ═══════════════════════════════════════════════════════════════════════════════
// © Ki11a_B | Continuation from Part 1
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 25: DIVERGENCE TYPE DEFINITIONS & LABEL TRACKING
// ═══════════════════════════════════════════════════════════════════════════════

// Type for divergence zone tracking (with bar index for expiration)
type divLevel
    line primaryLine
    line bgLine
    int createBar

// Type for tracking divergence labels (for cleanup)
type divLabel
    label lbl
    int barIdx

// Arrays for RSI divergence zones (SEPARATE from Score)
var bearDivLines = array.new<divLevel>()
var bullDivLines = array.new<divLevel>()

// Arrays for SCORE divergence zones (SEPARATE from RSI - fixes contamination bug)
var scoreBearDivLines = array.new<divLevel>()
var scoreBullDivLines = array.new<divLevel>()

// NEW: Label tracking arrays for managed cleanup
var array<label> rsiBullDivLabels = array.new<label>()
var array<label> rsiBearDivLabels = array.new<label>()
var array<label> scoreBullDivLabels = array.new<label>()
var array<label> scoreBearDivLabels = array.new<label>()
var array<label> sweepLabels = array.new<label>()
var array<label> exhaustLabels = array.new<label>()

// Drawing object counter for debug
var int totalLinesActive = 0
var int totalLabelsActive = 0

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 26: RSI DIVERGENCE DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

// Helper: check if bars between pivots are in valid range
_inRange(pivotCond, minBars, maxBars) =>
    barCount = ta.barssince(pivotCond)
    minBars <= barCount and barCount <= maxBars

// RSI Divergence detection function
detectDivergence(rsiData, doCheck, lookL, lookR, minB, maxB) =>
    bullDiv = false
    bearDiv = false
    foundPL = false
    foundPH = false

    if doCheck
        rsiRight = rsiData[lookR]

        // Bullish divergence: Price makes Lower Low, RSI makes Higher Low
        foundPL := not na(ta.pivotlow(rsiData, lookL, lookR))
        inRangePL = _inRange(foundPL[1], minB, maxB)
        rsiHL    = rsiRight > ta.valuewhen(foundPL, rsiRight, 1) and inRangePL
        priceLL  = low[lookR] < ta.valuewhen(foundPL, low[lookR], 1)
        bullDiv := foundPL and rsiHL and priceLL

        // Bearish divergence: Price makes Higher High, RSI makes Lower High
        foundPH := not na(ta.pivothigh(rsiData, lookL, lookR))
        inRangePH = _inRange(foundPH[1], minB, maxB)
        rsiLH    = rsiRight < ta.valuewhen(foundPH, rsiRight, 1) and inRangePH
        priceHH  = high[lookR] > ta.valuewhen(foundPH, high[lookR], 1)
        bearDiv := foundPH and rsiLH and priceHH

    [foundPL, foundPH, bullDiv, bearDiv, high[lookR], low[lookR]]

// Execute RSI divergence detection
[foundPL, foundPH, isBullDiv, isBearDiv, highLevel, lowLevel] = detectDivergence(rsiForDiv, enableDivCheck, divLookbackL, divLookbackR, minDivBars, maxDivBars)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 27: BASE SCORE CALCULATION (Before Divergence Adjustments)
// ═══════════════════════════════════════════════════════════════════════════════

// Component contributions
rsiContrib  = rsiSmooth * 0.30
mfiContrib  = mfi * 0.25
vwapContrib = vwapPosition * 0.20

// Momentum contribution with divergence awareness
momContrib = 0.0
if momAccel > 0 and rsiSmooth > 50
    momContrib := 5.0
else if momAccel < 0 and rsiSmooth < 50
    momContrib := -5.0
else if momAccel < 0 and rsiSmooth > 70
    momContrib := -10.0  // Momentum diverging from overbought RSI
else if momAccel > 0 and rsiSmooth < 30
    momContrib := 10.0   // Momentum diverging from oversold RSI

// Raw score assembly
reversalScoreRaw = rsiContrib + mfiContrib + vwapContrib + momContrib

// Volume surge adjustment
if volSurge and reversalScoreRaw > 70
    reversalScoreRaw += 10
else if volSurge and reversalScoreRaw < 30
    reversalScoreRaw -= 10

// BASE reversal score (normalized to -100 to +100)
baseReversalScore = math.max(-100.0, math.min(100.0, (reversalScoreRaw - 50.0) * 2.0))

// Score series for divergence (optionally smoothed)
scoreSeriesForDiv = useSmoothedScoreForDiv ? ta.ema(baseReversalScore, scoreDivSmoothingLen) : baseReversalScore

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 27: SCORE LINE DIVERGENCE DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

detectScoreDivergence(scoreData, doCheck, lookL, lookR, minB, maxB) =>
    scoreBullDiv = false
    scoreBearDiv = false
    scoreFoundPL = false
    scoreFoundPH = false

    if doCheck
        pl = ta.pivotlow(scoreData, lookL, lookR)
        ph = ta.pivothigh(scoreData, lookL, lookR)
        scoreFoundPL := not na(pl)
        scoreFoundPH := not na(ph)

        prevPL = ta.valuewhen(scoreFoundPL, pl, 1)
        prevPH = ta.valuewhen(scoreFoundPH, ph, 1)

        currLowBar  = bar_index - lookR
        currHighBar = bar_index - lookR
        prevLowBar  = ta.valuewhen(scoreFoundPL, bar_index - lookR, 1)
        prevHighBar = ta.valuewhen(scoreFoundPH, bar_index - lookR, 1)

        inRangePL = scoreFoundPL and not na(prevLowBar) and (currLowBar - prevLowBar >= minB) and (currLowBar - prevLowBar <= maxB)
        inRangePH = scoreFoundPH and not na(prevHighBar) and (currHighBar - prevHighBar >= minB) and (currHighBar - prevHighBar <= maxB)

        priceLL = low[lookR] < ta.valuewhen(scoreFoundPL, low[lookR], 1)
        priceHH = high[lookR] > ta.valuewhen(scoreFoundPH, high[lookR], 1)

        scoreHL = pl > prevPL
        scoreLH = ph < prevPH

        scoreBullDiv := inRangePL and priceLL and scoreHL
        scoreBearDiv := inRangePH and priceHH and scoreLH

    [scoreFoundPL, scoreFoundPH, scoreBullDiv, scoreBearDiv, high[lookR], low[lookR]]

// Execute Score divergence detection
[scoreFoundPL, scoreFoundPH, isScoreBullDiv, isScoreBearDiv, scoreHighLevel, scoreLowLevel] = detectScoreDivergence(scoreSeriesForDiv, enableScoreDiv, scoreDivLookbackL, scoreDivLookbackR, scoreMinDivBars, scoreMaxDivBars)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 28: AI PATTERN RECOGNITION
// ═══════════════════════════════════════════════════════════════════════════════

createPatternHash() =>
    rsiZone   = rsiSmooth > 70 ? "H" : rsiSmooth < 30 ? "L" : "M"
    mfiZone   = mfi > 70 ? "H" : mfi < 30 ? "L" : "M"
    vwapZone  = vwapPosition > 70 ? "H" : vwapPosition < 30 ? "L" : "M"
    volZone   = volSurge ? "V" : "N"
    divZone   = isBearDiv ? "BD" : isBullDiv ? "BU" : isScoreBearDiv ? "SD" : isScoreBullDiv ? "SU" : "N"
    scoreZone = math.abs(baseReversalScore) > 70 ? "EX" : math.abs(baseReversalScore) > 50 ? "HI" : "LO"
    sweepZone = bullishSweep ? "SB" : bearishSweep ? "SS" : "N"
    timeZone  = isOpenDrive ? "OD" : isCloseDrive ? "CD" : "N"

    rsiZone + mfiZone + vwapZone + volZone + divZone + scoreZone + sweepZone + timeZone

var array<string> patternHistory = array.new<string>()
var array<float> outcomeHistory = array.new<float>()
var array<int> signalBars = array.new<int>()
var array<int> signalDir = array.new<int>()  // +1 long (valley), -1 short (peak)

patternHash = enableAI ? createPatternHash() : ""
aiConfidence = 0.0
patternCount = 0
avgOutcome = 0.0

if enableAI and array.size(patternHistory) > 0
    for i = 0 to math.min(array.size(patternHistory) - 1, patternMemory - 1)
        if array.get(patternHistory, i) == patternHash
            patternCount += 1
            avgOutcome += array.get(outcomeHistory, i)

    if patternCount > 0
        avgOutcome := avgOutcome / patternCount
        aiConfidence := math.max(0, math.min(100, avgOutcome * 10 + 50))

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 29: MTF SCORE CALCULATION (NEW)
// ═══════════════════════════════════════════════════════════════════════════════

// Calculate score on higher timeframe
f_htfScore() =>
    htfRsi = ta.rsi(close, finalRsiLen)
    htfMfi = ta.mfi(hlc3, finalMfiLen)
    htfMom = ta.mom(close, finalMomLen)
    htfMomAccel = ta.change(htfMom) > 0 ? 1 : ta.change(htfMom) < 0 ? -1 : 0

    htfRsiContrib  = ta.sma(htfRsi, 3) * 0.30
    htfMfiContrib  = htfMfi * 0.25
    htfVwapContrib = 50.0 * 0.20  // Simplified - no VWAP position on HTF
    htfMomContrib  = htfMomAccel > 0 ? 5.0 : htfMomAccel < 0 ? -5.0 : 0.0

    htfRaw = htfRsiContrib + htfMfiContrib + htfVwapContrib + htfMomContrib
    math.max(-100.0, math.min(100.0, (htfRaw - 50.0) * 2.0))

htfScoreValue = enableMTFScore ? request.security(syminfo.tickerid, mtfScoreTF, f_htfScore(), lookahead=barmerge.lookahead_off) : 0.0

// MTF alignment check
mtfBullAligned = htfScoreValue <= -mtfScoreThreshold  // HTF in valley = bullish alignment
mtfBearAligned = htfScoreValue >= mtfScoreThreshold   // HTF in peak = bearish alignment

mtfBoost = 0.0
if enableMTFScore
    if baseReversalScore < -50 and mtfBullAligned
        mtfBoost := mtfAlignmentBoost
    else if baseReversalScore > 50 and mtfBearAligned
        mtfBoost := -mtfAlignmentBoost

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 30: FINAL SCORE ASSEMBLY WITH ALL CONTRIBUTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// RSI Divergence contribution
divContrib = 0.0
if isBullDiv and baseReversalScore < 30
    divContrib += divWeight
else if isBearDiv and baseReversalScore > 70
    divContrib -= divWeight

// Score Line Divergence contribution (separate weight)
if isScoreBullDiv and baseReversalScore < 50
    divContrib += scoreDivWeight
else if isScoreBearDiv and baseReversalScore > -50
    divContrib -= scoreDivWeight

// AI Pattern Recognition contribution
aiContrib = 0.0
if enableAI and patternCount >= 3
    confidenceAdjustment = (aiConfidence - 50) / 50
    aiContrib := confidenceAdjustment * aiWeight

// Time-based boost (from Part 1)
timeContrib = 0.0
if enableTimeFilter and timeFilterPass
    if baseReversalScore < -50 and timeBoost > 0
        timeContrib := timeBoost  // Boost valley signals during good times
    else if baseReversalScore > 50 and timeBoost > 0
        timeContrib := -timeBoost  // Boost peak signals during good times

// FINAL SCORE with all contributions
reversalScore = math.max(-100.0, math.min(100.0,
    baseReversalScore +
    divContrib +
    aiContrib +
    sweepBoost +
    deltaContrib +
    exhaustionBoost +
    mtfBoost +
    timeContrib
))

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 31: ADAPTIVE THRESHOLDS
// ═══════════════════════════════════════════════════════════════════════════════
peakTH   = peakThresh
valleyTH = valleyThresh

if useAdaptiveThresh
    atrMA = ta.sma(atr14, 100)
    isHighVol = atr14 > atrMA * 1.5
    isLowVol  = atr14 < atrMA * 0.8
    peakTH   := isHighVol ? 70.0  : isLowVol ? 55.0  : peakThresh
    valleyTH := isHighVol ? -70.0 : isLowVol ? -55.0 : valleyThresh

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 32: SCORE MOVING AVERAGES
// ═══════════════════════════════════════════════════════════════════════════════
scoreMa = scoreMaType == "SMA" ? ta.sma(reversalScore, scoreMaLen) :
          scoreMaType == "EMA" ? ta.ema(reversalScore, scoreMaLen) :
          scoreMaType == "WMA" ? ta.wma(reversalScore, scoreMaLen) :
                                  ta.hma(reversalScore, scoreMaLen)

ma1 = ma1Type == "SMA" ? ta.sma(reversalScore, ma1Len) :
      ma1Type == "EMA" ? ta.ema(reversalScore, ma1Len) :
      ma1Type == "WMA" ? ta.wma(reversalScore, ma1Len) :
                         ta.hma(reversalScore, ma1Len)

ma2 = ma2Type == "SMA" ? ta.sma(reversalScore, ma2Len) :
      ma2Type == "EMA" ? ta.ema(reversalScore, ma2Len) :
      ma2Type == "WMA" ? ta.wma(reversalScore, ma2Len) :
                         ta.hma(reversalScore, ma2Len)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 33: ROOM TO RUN CALCULATIONS
// ═══════════════════════════════════════════════════════════════════════════════
roomToRunOriginal = reversalScore < 0 ? math.abs(reversalScore - valleyTH) : peakTH - reversalScore
roomToRunNormalized = math.max(0, math.min(100, math.abs(roomToRunOriginal)))

roomToRunSymmetrical = reversalScore < 0 ? math.max(0, math.abs(reversalScore - (-90))) : -math.max(0, 90 - reversalScore)
roomToRunUp   = math.max(0, 90 - math.max(0, reversalScore))
roomToRunDown = math.max(0, math.max(0, reversalScore) - (-90))
distanceToTop    = 90 - reversalScore
distanceToBottom = reversalScore - (-90)
roomToRunCentered = math.abs(distanceToTop) < math.abs(distanceToBottom) ? distanceToTop : -distanceToBottom
distanceTraveled  = reversalScore

finalRoomToRun = roomToRunMode == "Original" ? roomToRunNormalized :
                 roomToRunMode == "Symmetrical" ? roomToRunSymmetrical :
                 roomToRunMode == "Centered" ? roomToRunCentered :
                 roomToRunMode == "Distance Traveled" ? distanceTraveled :
                 roomToRunNormalized

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 34: BAND TOUCH DETECTION
// ═══════════════════════════════════════════════════════════════════════════════
touchingPeak          = reversalScore >= peakTH
touchingValley        = reversalScore <= valleyTH
touchingExtremePeak   = reversalScore >= 90
touchingExtremeValley = reversalScore <= -90

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 35: HTF FILTER COMPONENTS (For Zenith Gate)
// ═══════════════════════════════════════════════════════════════════════════════
htfClose = request.security(syminfo.tickerid, htfTF, close, lookahead=barmerge.lookahead_off)
htfEma   = request.security(syminfo.tickerid, htfTF, ta.ema(close, htfEmaLen), lookahead=barmerge.lookahead_off)
htfRsi   = request.security(syminfo.tickerid, htfTF, ta.rsi(close, htfRsiLen), lookahead=barmerge.lookahead_off)

htfUp   = htfClose > htfEma
htfDown = htfClose < htfEma

htfGateSell = not useHTFFilter or (htfUp and htfRsi >= htfRsiOB)
htfGateBuy  = not useHTFFilter or (htfDown and htfRsi <= htfRsiOS)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 36: DIVERGENCE ZONE PLOTTING FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// RSI Divergence zone management
plotDivergenceZones(arr, cond, isBull, lookR, bullCol, bearCol, maxZones, lineOpacity, zoneOpacity, expireBars) =>
    levelY = isBull ? low[lookR] : high[lookR]
    lineCol = color.new(isBull ? bullCol : bearCol, lineOpacity)
    zoneCol = color.new(isBull ? bullCol : bearCol, zoneOpacity)

    if cond
        l1 = line.new(bar_index - lookR, levelY, bar_index, levelY, color=lineCol, force_overlay=true)
        l2 = line.new(bar_index - lookR, levelY, bar_index, levelY, color=zoneCol, width=6, force_overlay=true)
        arr.push(divLevel.new(l1, l2, bar_index))

    // Remove excess zones
    while arr.size() > maxZones
        expired = arr.shift()
        expired.primaryLine.delete()
        expired.bgLine.delete()

    // Update existing zones and check for expiration
    if arr.size() > 0
        for i = arr.size() - 1 to 0
            dl = arr.get(i)
            line1 = dl.primaryLine
            line2 = dl.bgLine
            barsOld = bar_index - dl.createBar

            // Expire old zones
            if barsOld > expireBars
                line1.delete()
                line2.delete()
                arr.remove(i)
            else if isBull ? high > line1.get_y1() : low < line1.get_y1()
                line1.set_x2(bar_index + 15)
                line2.set_x2(bar_index + 15)
            else
                line1.set_x2(bar_index)
                line1.set_style(line.style_dashed)
                line2.delete()
                arr.remove(i)
    0

// Score Divergence zone management (SEPARATE arrays)
plotScoreDivergenceZones(arr, cond, isBull, lookR, divCol, maxZones, lineOpacity, zoneOpacity, expireBars) =>
    levelY = isBull ? low[lookR] : high[lookR]
    lineCol = color.new(divCol, lineOpacity)
    zoneCol = color.new(divCol, zoneOpacity)

    if cond
        l1 = line.new(bar_index - lookR, levelY, bar_index, levelY, color=lineCol, force_overlay=true)
        l2 = line.new(bar_index - lookR, levelY, bar_index, levelY, color=zoneCol, width=6, force_overlay=true)
        arr.push(divLevel.new(l1, l2, bar_index))

    while arr.size() > maxZones
        expired = arr.shift()
        expired.primaryLine.delete()
        expired.bgLine.delete()

    if arr.size() > 0
        for i = arr.size() - 1 to 0
            dl = arr.get(i)
            line1 = dl.primaryLine
            line2 = dl.bgLine
            barsOld = bar_index - dl.createBar

            if barsOld > expireBars
                line1.delete()
                line2.delete()
                arr.remove(i)
            else if isBull ? high > line1.get_y1() : low < line1.get_y1()
                line1.set_x2(bar_index + 15)
                line2.set_x2(bar_index + 15)
            else
                line1.set_x2(bar_index)
                line1.set_style(line.style_dashed)
                line2.delete()
                arr.remove(i)
    0

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 37: SIGNAL DETECTION (Base - Before Zenith Gate)
// ═══════════════════════════════════════════════════════════════════════════════
isPeakZone    = reversalScore >= peakTH
wasPeakZone   = reversalScore[1] >= peakTH
isValleyZone  = reversalScore <= valleyTH
wasValleyZone = reversalScore[1] <= valleyTH

// Turn detection (momentum shift in zone)
peakTurn   = wasPeakZone and (reversalScore < reversalScore[1]) and (reversalScore[1] >= reversalScore[2])
valleyTurn = wasValleyZone and (reversalScore > reversalScore[1]) and (reversalScore[1] <= reversalScore[2])

// Divergence requirement gate
needDivPeak   = not requireDivForSignals or (isBearDiv or isScoreBearDiv)
needDivValley = not requireDivForSignals or (isBullDiv or isScoreBullDiv)

// MTF alignment requirement gate
needMTFPeak   = not requireMTFAlignment or mtfBearAligned
needMTFValley = not requireMTFAlignment or mtfBullAligned

// Base confirmed signals (before Zenith Gate)
peakTurnConfirmed   = peakTurn and needDivPeak and needMTFPeak
valleyTurnConfirmed = valleyTurn and needDivValley and needMTFValley

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 38: ZENITH KILLER GATE (Final Signal Filter)
// ═══════════════════════════════════════════════════════════════════════════════

// Gate components
rejectSell = not requireRejectCandle or bearReject
rejectBuy  = not requireRejectCandle or bullReject

volGateSell = not requireClimaxVol or climaxVol or volSurge
volGateBuy  = not requireClimaxVol or climaxVol or volSurge

// Time filter gate
timeGate = not enableTimeFilter or timeFilterPass

// One-shot arming mechanism
var bool armedZenith = true
if not armedZenith and math.abs(reversalScore) < rearmAbsScore
    armedZenith := true

// FINAL Zenith-filtered signals
zenithSell = peakTurnConfirmed and (not useZenithGate or (htfGateSell and rejectSell and volGateSell)) and timeGate and armedZenith
zenithBuy  = valleyTurnConfirmed and (not useZenithGate or (htfGateBuy and rejectBuy and volGateBuy)) and timeGate and armedZenith

// Disarm after signal fires
if zenithSell or zenithBuy
    armedZenith := false

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 39: AI PATTERN LEARNING (Store on Signal)
// ═══════════════════════════════════════════════════════════════════════════════
if (zenithSell or zenithBuy) and enableAI
    dir = zenithBuy ? 1 : -1
    array.push(signalDir, dir)
    array.push(patternHistory, patternHash)
    array.push(signalBars, bar_index)
    array.push(outcomeHistory, 0.0)

    if array.size(patternHistory) > patternMemory
        array.shift(patternHistory)
        array.shift(outcomeHistory)
        array.shift(signalBars)
        array.shift(signalDir)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 40: PERFORMANCE TRACKING
// ═══════════════════════════════════════════════════════════════════════════════
var int totalSignals = 0
var int winningSignals = 0
var int losingSignals = 0
var float totalReturn = 0.0

if performanceReset
    totalSignals := 0
    winningSignals := 0
    losingSignals := 0
    totalReturn := 0.0

if (zenithSell or zenithBuy) and enablePerformance
    totalSignals += 1

// Update outcomes (direction-aware)
if enableAI and array.size(signalBars) > 0
    for i = array.size(signalBars) - 1 to 0
        signalBar = array.get(signalBars, i)
        barsElapsed = bar_index - signalBar
        if barsElapsed >= 10 and barsElapsed <= 20
            entryPrice = close[barsElapsed]
            dir = array.get(signalDir, i)
            signedReturn = ((close - entryPrice) / entryPrice) * 100 * dir
            wasWin = signedReturn >= minTradeReturn
            outcome = wasWin ? 1.0 : signedReturn <= -minTradeReturn ? -1.0 : 0.0

            previousOutcome = array.get(outcomeHistory, i)
            if previousOutcome == 0.0
                if outcome > 0
                    winningSignals += 1
                else if outcome < 0
                    losingSignals += 1
                totalReturn += signedReturn

            array.set(outcomeHistory, i, outcome)

winRate = totalSignals > 0 ? (winningSignals / totalSignals) * 100 : 0
avgReturn = totalSignals > 0 ? totalReturn / totalSignals : 0
profitFactor = losingSignals > 0 ? winningSignals / losingSignals : winningSignals > 0 ? 99.9 : 0

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 41: DYNAMIC COLORING
// ═══════════════════════════════════════════════════════════════════════════════
scoreROC = reversalScore - reversalScore[1]
normalizedROC = math.min(math.abs(scoreROC) * dynamicIntensity, 1.0)

baseColor = touchingPeak ? color.red : touchingValley ? color.lime : isScoreBearDiv ? scoreDivColor : isScoreBullDiv ? scoreDivColor : isBearDiv ? divBearColor : isBullDiv ? divBullColor : reversalScore > 0 ? color.orange : color.blue

plotColor = baseColor
if enableDynamicColor
    if enableGradient
        opacity = enableBandHighlight and (touchingPeak or touchingValley) ? 0 : int(normalizedROC * 50)
        if scoreROC > 0
            plotColor := reversalScore > 0 ? color.new(color.red, opacity) : color.new(color.lime, opacity)
        else
            plotColor := reversalScore > 0 ? color.new(color.orange, opacity) : color.new(color.blue, opacity)

        if isScoreBearDiv or isScoreBullDiv
            plotColor := color.new(scoreDivColor, math.max(opacity, 15))
        else if isBearDiv
            plotColor := color.new(divBearColor, math.max(opacity, 20))
        else if isBullDiv
            plotColor := color.new(divBullColor, math.max(opacity, 20))

// Background flash
distanceFromPeak   = reversalScore - peakTH
distanceFromValley = valleyTH - reversalScore
dynamicFlashIntensity = 0.0
if touchingPeak
    dynamicFlashIntensity := math.min((distanceFromPeak / (100 - peakTH)) * maxDynamicFlash, maxDynamicFlash)
else if touchingValley
    dynamicFlashIntensity := math.min((math.abs(reversalScore - valleyTH) / math.abs(-100 - valleyTH)) * maxDynamicFlash, maxDynamicFlash)

finalFlashStrength = useDynamicFlash ? dynamicFlashIntensity : staticFlashStrength

flashColor = touchingExtremePeak ? color.new(color.maroon, 100 - int(finalFlashStrength * 1.5)) : touchingPeak ? color.new(color.red, 100 - finalFlashStrength) : touchingExtremeValley ? color.new(color.green, 100 - int(finalFlashStrength * 1.5)) : touchingValley ? color.new(color.lime, 100 - finalFlashStrength) : isScoreBearDiv ? color.new(scoreDivColor, 70) : isScoreBullDiv ? color.new(scoreDivColor, 70) : isBearDiv ? color.new(divBearColor, 80) : isBullDiv ? color.new(divBullColor, 80) : na

// ═══════════════════════════════════════════════════════════════════════════════
// END OF PART 2 - Continue in Part 3 for Target Projection & Part 4 for Plotting
// ═══════════════════════════════════════════════════════════════════════════════

// Key exports for Part 3/4:
// reversalScore, scoreMa, ma1, ma2, finalRoomToRun
// zenithSell, zenithBuy, peakTurnConfirmed, valleyTurnConfirmed
// isBullDiv, isBearDiv, isScoreBullDiv, isScoreBearDiv
// foundPL, foundPH, scoreFoundPL, scoreFoundPH
// highLevel, lowLevel, scoreHighLevel, scoreLowLevel
// touchingPeak, touchingValley, touchingExtremePeak, touchingExtremeValley
// plotColor, flashColor
// winRate, avgReturn, totalSignals, aiConfidence, patternHash, patternCount
// bullishSweep, bearishSweep, exhaustionBull, exhaustionBear
// htfScoreValue, mtfBullAligned, mtfBearAligned
// ═══════════════════════════════════════════════════════════════════════════════
// BK AK-IRON DOME 48 - ZENITH EDITION - PART 3/4 (TARGETS & ANALYSIS)
// ═══════════════════════════════════════════════════════════════════════════════
// © Ki11a_B | Continuation from Part 2
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 42: R:R TARGET PROJECTION SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

// Persistent variables for target lines
var line stopLine    = na
var line target1Line = na
var line target2Line = na
var line target3Line = na
var label stopLabel    = na
var label target1Label = na
var label target2Label = na
var label target3Label = na

var float activeEntryPrice = na
var float activeStopPrice  = na
var float activeTarget1    = na
var float activeTarget2    = na
var float activeTarget3    = na
var int   activeSignalBar  = na
var int   activeDirection  = 0  // 1 = long, -1 = short

// Calculate targets on new signal
if enableTargets and (zenithBuy or zenithSell)
    // Clean up old lines
    if not na(stopLine)
        line.delete(stopLine)
        label.delete(stopLabel)
        stopLine := na
        stopLabel := na
    if not na(target1Line)
        line.delete(target1Line)
        line.delete(target2Line)
        line.delete(target3Line)
        label.delete(target1Label)
        label.delete(target2Label)
        label.delete(target3Label)
        target1Line := na
        target2Line := na
        target3Line := na

    activeEntryPrice := close
    activeSignalBar  := bar_index

    if zenithBuy
        activeDirection  := 1
        activeStopPrice  := low - atr14 * stopAtrMult
        riskAmount       = activeEntryPrice - activeStopPrice
        activeTarget1    := activeEntryPrice + riskAmount * target1RR
        activeTarget2    := activeEntryPrice + riskAmount * target2RR
        activeTarget3    := activeEntryPrice + riskAmount * target3RR
    else  // zenithSell
        activeDirection  := -1
        activeStopPrice  := high + atr14 * stopAtrMult
        riskAmount       = activeStopPrice - activeEntryPrice
        activeTarget1    := activeEntryPrice - riskAmount * target1RR
        activeTarget2    := activeEntryPrice - riskAmount * target2RR
        activeTarget3    := activeEntryPrice - riskAmount * target3RR

    // Create stop line (independent of targets)
    if showStopLine
        stopLine := line.new(bar_index, activeStopPrice, bar_index + targetLineExtend, activeStopPrice, color=stopColor, style=line.style_dashed, width=2, force_overlay=true)
        stopLabel := label.new(bar_index + targetLineExtend, activeStopPrice, "STOP", color=color.new(color.white, 100), textcolor=color.new(stopColor, targetLabelOpacity), style=label.style_label_left, size=size.small, force_overlay=true)

    // Create target lines (independent of stop)
    if showTargetLines
        target1Line := line.new(bar_index, activeTarget1, bar_index + targetLineExtend, activeTarget1, color=target1Color, style=line.style_solid, width=2, force_overlay=true)
        target1Label := label.new(bar_index + targetLineExtend, activeTarget1, "T1 (" + str.tostring(target1RR, "#.#") + "R)", color=color.new(color.white, 100), textcolor=color.new(target1Color, targetLabelOpacity), style=label.style_label_left, size=size.small, force_overlay=true)

        target2Line := line.new(bar_index, activeTarget2, bar_index + targetLineExtend, activeTarget2, color=target2Color, style=line.style_solid, width=2, force_overlay=true)
        target2Label := label.new(bar_index + targetLineExtend, activeTarget2, "T2 (" + str.tostring(target2RR, "#.#") + "R)", color=color.new(color.white, 100), textcolor=color.new(target2Color, targetLabelOpacity), style=label.style_label_left, size=size.small, force_overlay=true)

        target3Line := line.new(bar_index, activeTarget3, bar_index + targetLineExtend, activeTarget3, color=target3Color, style=line.style_dashed, width=1, force_overlay=true)
        target3Label := label.new(bar_index + targetLineExtend, activeTarget3, "T3 (" + str.tostring(target3RR, "#.#") + "R)", color=color.new(color.white, 100), textcolor=color.new(target3Color, targetLabelOpacity), style=label.style_label_left, size=size.small, force_overlay=true)

// Extend existing lines (and auto-cleanup after maxTargetBars)
if enableTargets and not na(activeSignalBar)
    barsFromSignal = bar_index - activeSignalBar

    // Auto-cleanup old targets
    if enableAutoCleanup and barsFromSignal > maxTargetBars
        if not na(stopLine)
            line.delete(stopLine)
            label.delete(stopLabel)
            stopLine := na
            stopLabel := na
        if not na(target1Line)
            line.delete(target1Line)
            line.delete(target2Line)
            line.delete(target3Line)
            label.delete(target1Label)
            label.delete(target2Label)
            label.delete(target3Label)
            target1Line := na
            target2Line := na
            target3Line := na
        activeSignalBar := na
    else if barsFromSignal > 0
        newEndBar = activeSignalBar + targetLineExtend

        // Extend stop line if exists
        if not na(stopLine)
            line.set_x2(stopLine, newEndBar)
            label.set_x(stopLabel, newEndBar)

        // Extend target lines if exist
        if not na(target1Line)
            line.set_x2(target1Line, newEndBar)
            label.set_x(target1Label, newEndBar)
        if not na(target2Line)
            line.set_x2(target2Line, newEndBar)
            label.set_x(target2Label, newEndBar)
        if not na(target3Line)
            line.set_x2(target3Line, newEndBar)
            label.set_x(target3Label, newEndBar)

// Check if targets hit (for info panel)
target1Hit = activeDirection == 1 ? high >= activeTarget1 : activeDirection == -1 ? low <= activeTarget1 : false
target2Hit = activeDirection == 1 ? high >= activeTarget2 : activeDirection == -1 ? low <= activeTarget2 : false
target3Hit = activeDirection == 1 ? high >= activeTarget3 : activeDirection == -1 ? low <= activeTarget3 : false
stopHit    = activeDirection == 1 ? low <= activeStopPrice : activeDirection == -1 ? high >= activeStopPrice : false

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 43: LIQUIDITY SWEEP MARKERS (MANAGED)
// ═══════════════════════════════════════════════════════════════════════════════

// Helper function to manage label arrays
f_addManagedLabel(arr, lbl, maxLabels) =>
    array.push(arr, lbl)
    // Remove oldest if over limit
    while array.size(arr) > maxLabels
        oldLabel = array.shift(arr)
        label.delete(oldLabel)

// Plot sweep markers on chart with managed cleanup
// Bullish sweep (stops hunted BELOW) = label BELOW candle pointing up
// Bearish sweep (stops hunted ABOVE) = label ABOVE candle pointing down
if showSweepMarkers and bullishSweep
    newLabel = label.new(bar_index, low, "💧",
         color=color.new(color.white, 100), textcolor=sweepBullColor,
         style=label.style_label_up, size=size.small, force_overlay=true,
         tooltip="Bullish Liquidity Sweep - Stops hunted below " + str.tostring(priorSwingLow, "#.##"))
    f_addManagedLabel(sweepLabels, newLabel, maxSweepLabels)

if showSweepMarkers and bearishSweep
    newLabel = label.new(bar_index, high, "💧",
         color=color.new(color.white, 100), textcolor=sweepBearColor,
         style=label.style_label_down, size=size.small, force_overlay=true,
         tooltip="Bearish Liquidity Sweep - Stops hunted above " + str.tostring(priorSwingHigh, "#.##"))
    f_addManagedLabel(sweepLabels, newLabel, maxSweepLabels)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 44: EXHAUSTION VOLUME MARKERS (MANAGED)
// ═══════════════════════════════════════════════════════════════════════════════

// Bullish exhaustion (reversal UP) = label BELOW candle
// Bearish exhaustion (reversal DOWN) = label ABOVE candle
if showExhaustionMarker and exhaustionBull
    newLabel = label.new(bar_index, low, "⚡",
         color=color.new(color.white, 100), textcolor=color.lime,
         style=label.style_label_up, size=size.small, force_overlay=true,
         tooltip="Bullish Exhaustion - Volume spike with price stall (reversal UP likely)")
    f_addManagedLabel(exhaustLabels, newLabel, maxExhaustLabels)

if showExhaustionMarker and exhaustionBear
    newLabel = label.new(bar_index, high, "⚡",
         color=color.new(color.white, 100), textcolor=color.red,
         style=label.style_label_down, size=size.small, force_overlay=true,
         tooltip="Bearish Exhaustion - Volume spike with price stall (reversal DOWN likely)")
    f_addManagedLabel(exhaustLabels, newLabel, maxExhaustLabels)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 45: TIME ZONE HIGHLIGHTING
// ═══════════════════════════════════════════════════════════════════════════════

color timeZoneBgColor = na
if showTimeZoneOnChart and enableTimeFilter
    if isOpenDrive
        timeZoneBgColor := color.new(color.green, 92)
    else if isCloseDrive
        timeZoneBgColor := color.new(color.blue, 92)
    else if isLunchHour and avoidLunchHour
        timeZoneBgColor := color.new(color.gray, 95)
    else if isDeadZone and avoidDeadZone
        timeZoneBgColor := color.new(color.red, 95)
    else if isOvernight and avoidOvernightChop
        timeZoneBgColor := color.new(color.purple, 95)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 46: KEY FACTORS ANALYSIS
// ═══════════════════════════════════════════════════════════════════════════════

keyFactorsText = ""
factorCount = 0

if showKeyFactors
    // RSI Factor
    if rsiSmooth > 70
        keyFactorsText += "🔴 RSI Overbought (" + str.tostring(rsiSmooth, "#.#") + ")\n"
        factorCount += 1
    else if rsiSmooth < 30
        keyFactorsText += "🟢 RSI Oversold (" + str.tostring(rsiSmooth, "#.#") + ")\n"
        factorCount += 1

    // MFI Factor
    if mfi > 70
        keyFactorsText += "🔴 Money Flow High (" + str.tostring(mfi, "#.#") + ")\n"
        factorCount += 1
    else if mfi < 30
        keyFactorsText += "🟢 Money Flow Low (" + str.tostring(mfi, "#.#") + ")\n"
        factorCount += 1

    // VWAP Factor
    if vwapPosition > 70
        keyFactorsText += "🔴 Above VWAP Bands (" + str.tostring(vwapPosition, "#.#") + "%)\n"
        factorCount += 1
    else if vwapPosition < 30
        keyFactorsText += "🟢 Below VWAP Bands (" + str.tostring(vwapPosition, "#.#") + "%)\n"
        factorCount += 1

    // Volume Factor
    if volSurge
        keyFactorsText += "⚡ Volume Surge (+" + str.tostring(((volume/avgVol - 1) * 100), "#") + "%)\n"
        factorCount += 1

    // Climax Volume
    if climaxVol
        keyFactorsText += "🔥 CLIMAX Volume (×" + str.tostring(volume/avgVol, "#.#") + ")\n"
        factorCount += 1

    // RSI Divergence Factor
    if isBearDiv
        keyFactorsText += "🐻 RSI Bearish Divergence\n"
        factorCount += 1
    else if isBullDiv
        keyFactorsText += "🐂 RSI Bullish Divergence\n"
        factorCount += 1

    // Score Divergence Factor
    if isScoreBearDiv
        keyFactorsText += "🔻 Score Bearish Divergence\n"
        factorCount += 1
    else if isScoreBullDiv
        keyFactorsText += "🔺 Score Bullish Divergence\n"
        factorCount += 1

    // Liquidity Sweep Factor
    if bullishSweep
        keyFactorsText += "💧 Bullish Liquidity Sweep\n"
        factorCount += 1
    else if bearishSweep
        keyFactorsText += "💧 Bearish Liquidity Sweep\n"
        factorCount += 1

    // Exhaustion Factor
    if exhaustionBull
        keyFactorsText += "⚡ Bullish Exhaustion Pattern\n"
        factorCount += 1
    else if exhaustionBear
        keyFactorsText += "⚡ Bearish Exhaustion Pattern\n"
        factorCount += 1

    // Rejection Candle Factor
    if bullReject
        keyFactorsText += "🕯️ Bullish Rejection Candle\n"
        factorCount += 1
    else if bearReject
        keyFactorsText += "🕯️ Bearish Rejection Candle\n"
        factorCount += 1

    // MTF Alignment Factor
    if enableMTFScore
        if mtfBullAligned
            keyFactorsText += "📐 MTF Bullish Aligned (" + str.tostring(htfScoreValue, "#") + ")\n"
            factorCount += 1
        else if mtfBearAligned
            keyFactorsText += "📐 MTF Bearish Aligned (" + str.tostring(htfScoreValue, "#") + ")\n"
            factorCount += 1

    // Delta Proxy Factor
    if enableDeltaProxy
        if deltaBullConfirm
            keyFactorsText += "⚡ Delta Bullish (" + str.tostring(normalizedDelta, "#.##") + ")\n"
            factorCount += 1
        else if deltaBearConfirm
            keyFactorsText += "⚡ Delta Bearish (" + str.tostring(normalizedDelta, "#.##") + ")\n"
            factorCount += 1

    // Time Zone Factor
    if enableTimeFilter
        if isOpenDrive
            keyFactorsText += "⏰ Open Drive (High Prob)\n"
            factorCount += 1
        else if isCloseDrive
            keyFactorsText += "⏰ Close Drive (High Prob)\n"
            factorCount += 1
        else if isLunchHour and avoidLunchHour
            keyFactorsText += "⚠️ Lunch Hour (Low Prob)\n"
            factorCount += 1

    // Momentum Factor
    if momAccel != 0
        if momentum > 0
            keyFactorsText += (momAccel > 0 ? "📈" : "📉") + " Momentum Up " + (momAccel > 0 ? "(Accel)" : "(Decel)") + "\n"
        else
            keyFactorsText += (momAccel > 0 ? "📈" : "📉") + " Momentum Down " + (momAccel > 0 ? "(Decel)" : "(Accel)") + "\n"
        factorCount += 1

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 47: SIGNAL STRENGTH CALCULATION
// ═══════════════════════════════════════════════════════════════════════════════

// Calculate comprehensive signal strength (for info panel)
signalStrength = 0.0
strengthFactors = 0

if zenithBuy or zenithSell
    // Base zone strength
    if touchingExtremePeak or touchingExtremeValley
        signalStrength += 25
        strengthFactors += 1
    else if touchingPeak or touchingValley
        signalStrength += 15
        strengthFactors += 1

    // Divergence bonus
    if isScoreBullDiv or isScoreBearDiv
        signalStrength += 20
        strengthFactors += 1
    else if isBullDiv or isBearDiv
        signalStrength += 15
        strengthFactors += 1

    // Volume confirmation
    if climaxVol
        signalStrength += 15
        strengthFactors += 1
    else if volSurge
        signalStrength += 10
        strengthFactors += 1

    // Rejection candle
    if (zenithBuy and bullReject) or (zenithSell and bearReject)
        signalStrength += 10
        strengthFactors += 1

    // Liquidity sweep
    if (zenithBuy and bullishSweep) or (zenithSell and bearishSweep)
        signalStrength += 15
        strengthFactors += 1

    // Exhaustion pattern
    if (zenithBuy and exhaustionBull) or (zenithSell and exhaustionBear)
        signalStrength += 10
        strengthFactors += 1

    // MTF alignment
    if (zenithBuy and mtfBullAligned) or (zenithSell and mtfBearAligned)
        signalStrength += 10
        strengthFactors += 1

    // Delta confirmation
    if (zenithBuy and deltaBullConfirm) or (zenithSell and deltaBearConfirm)
        signalStrength += 10
        strengthFactors += 1

    // Time zone bonus
    if isOpenDrive or isCloseDrive
        signalStrength += 10
        strengthFactors += 1

    // AI confidence bonus
    if enableAI and aiConfidence > 70
        signalStrength += 10
        strengthFactors += 1

signalStrength := math.min(100, signalStrength)

signalGrade = signalStrength >= 80 ? "A+" :
              signalStrength >= 70 ? "A" :
              signalStrength >= 60 ? "B+" :
              signalStrength >= 50 ? "B" :
              signalStrength >= 40 ? "C+" :
              signalStrength >= 30 ? "C" : "D"

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 48: CONFLUENCE SCORE (How many systems agree)
// ═══════════════════════════════════════════════════════════════════════════════

bullConfluence = 0
bearConfluence = 0

// RSI
if rsiSmooth < 30
    bullConfluence += 1
if rsiSmooth > 70
    bearConfluence += 1

// MFI
if mfi < 30
    bullConfluence += 1
if mfi > 70
    bearConfluence += 1

// VWAP Position
if vwapPosition < 30
    bullConfluence += 1
if vwapPosition > 70
    bearConfluence += 1

// Divergences
if isBullDiv or isScoreBullDiv
    bullConfluence += 1
if isBearDiv or isScoreBearDiv
    bearConfluence += 1

// Sweeps
if bullishSweep
    bullConfluence += 1
if bearishSweep
    bearConfluence += 1

// Exhaustion
if exhaustionBull
    bullConfluence += 1
if exhaustionBear
    bearConfluence += 1

// Rejection candles
if bullReject
    bullConfluence += 1
if bearReject
    bearConfluence += 1

// Delta
if deltaBullConfirm
    bullConfluence += 1
if deltaBearConfirm
    bearConfluence += 1

// MTF
if mtfBullAligned
    bullConfluence += 1
if mtfBearAligned
    bearConfluence += 1

maxConfluence = 9  // Total possible factors
bullConfluencePct = (bullConfluence / maxConfluence) * 100
bearConfluencePct = (bearConfluence / maxConfluence) * 100

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 49: HELPER FUNCTION - FORMAT VALUES
// ═══════════════════════════════════════════════════════════════════════════════

formatValue(value) =>
    absValue = math.abs(value)
    result = ""
    if absValue >= 1000
        result := str.tostring(value, "#")
    else if absValue >= 100
        result := str.tostring(value, "#.#")
    else if absValue >= 10
        result := str.tostring(value, "#.##")
    else if absValue >= 1
        result := str.tostring(value, "#.###")
    else
        result := str.tostring(value, "#.####")
    result

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 50: VWAP OVERLAY PLOTTING
// ═══════════════════════════════════════════════════════════════════════════════

// Plot VWAP and bands on chart if enabled
plot(showVwapBands ? vwapCalc : na, "VWAP", color=vwapColor, linewidth=2, force_overlay=true)
plot(showVwapBands ? upperBand : na, "VWAP Upper", color=color.new(vwapColor, 50), linewidth=1, force_overlay=true)
plot(showVwapBands ? lowerBand : na, "VWAP Lower", color=color.new(vwapColor, 50), linewidth=1, force_overlay=true)

// Fill between bands (FIXED)
upperBandPlot = plot(showVwapBands ? upperBand : na, display=display.none, force_overlay=true, editable=false)
lowerBandPlot = plot(showVwapBands ? lowerBand : na, display=display.none, force_overlay=true, editable=false)
fill(upperBandPlot, lowerBandPlot, color=(showVwapBands ? color.new(vwapColor, vwapFillOpacity) : na), title="VWAP Band Fill")

