//@version=6
indicator(title="BK AK-Iron Dome", shorttitle="📡", overlay=false, max_bars_back=500, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 1: CORE MODE & AUTO-SCALING
// ═══════════════════════════════════════════════════════════════════════════════
autoTF = input.bool(true, "Auto-Scale to Chart TF", group="⚙️ Core Settings")

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 2: VWAP MULTI-ANCHOR SYSTEM (NEW)
// ═══════════════════════════════════════════════════════════════════════════════
vwapAnchorType = input.string("Session", "VWAP Anchor Type",
     options=["Session", "Weekly", "Monthly", "Quarterly (Auto-Roll)", "Custom Date", "None"],
     group="📊 VWAP System",
     tooltip="Session=Daily reset | Weekly=Monday open | Quarterly=Auto-detects futures roll dates")

vwapSessionType = input.string("Full Session", "Session Type",
     options=["Full Session", "RTH Only", "ETH Only"],
     group="📊 VWAP System",
     tooltip="Full=24hr | RTH=Regular Trading Hours only | ETH=Extended/Overnight only")

// NEW: Explicit session timezone (fixes ET vs exchange-time ambiguity)
vwapSessionTz = input.string("America/New_York", "VWAP Session Timezone",
     group="📊 VWAP System",
     tooltip="IANA timezone (e.g., America/New_York). RTH/ETH windows below are interpreted in this timezone.")

// RTH Time Settings (defaults are 9:30-16:00 in the session timezone above)
rthStartHour   = input.int(9,  "RTH Start Hour (Session TZ)", minval=0, maxval=23, group="📊 VWAP System")
rthStartMinute = input.int(30, "RTH Start Minute", minval=0, maxval=59, group="📊 VWAP System")
rthEndHour     = input.int(16, "RTH End Hour (Session TZ)", minval=0, maxval=23, group="📊 VWAP System")
rthEndMinute   = input.int(0,  "RTH End Minute", minval=0, maxval=59, group="📊 VWAP System")

// Custom anchor date (preserved from original)
rollYear   = input.int(2025, "Custom Anchor Year", 1900, 2100, group="📊 VWAP System")
rollMonth  = input.int(1,    "Custom Anchor Month", 1, 12, group="📊 VWAP System")
rollDay    = input.int(1,    "Custom Anchor Day", 1, 31, group="📊 VWAP System")
rollHour   = input.int(0,    "Custom Anchor Hour", 0, 23, group="📊 VWAP System")
rollMinute = input.int(0,    "Custom Anchor Minute", 0, 59, group="📊 VWAP System")
rollSecond = input.int(0,    "Custom Anchor Second", 0, 59, group="📊 VWAP System")

vwapDev = input.float(2.0, "VWAP Band Deviation", group="📊 VWAP System", minval=0.5, maxval=5.0)

showVwapBands = input.bool(false, "Show VWAP & Bands on Chart", group="📊 VWAP System")
vwapColor     = input.color(color.purple, "VWAP Color", group="📊 VWAP System")

// NEW: VWAP band fill opacity (fixes missing fill)
vwapFillOpacity = input.int(92, "VWAP Band Fill Opacity", group="📊 VWAP System", minval=0, maxval=100)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 3: REVERSAL DETECTION INPUTS
// ═══════════════════════════════════════════════════════════════════════════════
rsiLen  = input.int(14, "RSI Length", group="🎯 Reversal Detection", minval=5, maxval=50)
mfiLen  = input.int(14, "Money Flow Length", group="🎯 Reversal Detection", minval=5, maxval=50)
momLen  = input.int(10, "Momentum Length", group="🎯 Reversal Detection", minval=5, maxval=20)

// Thresholds
peakThresh   = input.float(90.0,  "Peak Reversal Threshold (+)", group="🎯 Thresholds", minval=20.0, maxval=100.0)
valleyThresh = input.float(-90.0, "Valley Reversal Threshold (-)", group="🎯 Thresholds", minval=-100.0, maxval=-20.0)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 4: DIVERGENCE SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════
