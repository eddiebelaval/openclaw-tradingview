//@version=6
indicator("Ben Bot Entry Alerts", shorttitle="Ben Bot Entry Alerts", overlay=true)

// ═══════════════════════════════════════════════
// ─── Inputs ───
// ═══════════════════════════════════════════════
grpDMI = "DMI Settings"
dmiLength = input.int(14, "DMI Length", minval=1, group=grpDMI)
adxSmooth = input.int(14, "ADX Smoothing", minval=1, group=grpDMI)

grpORB = "Opening Range Settings"
orSess   = input.session("0930-1000", "Open Range Session", options=["0930-0945", "0930-1000", "0930-1030"], group=grpORB)

// ═══════════════════════════════════════════════
// ─── DMI Calculation ───
// ═══════════════════════════════════════════════
[diPlus, diMinus, adxValue] = ta.dmi(dmiLength, adxSmooth)

// ═══════════════════════════════════════════════
// ─── Trading Hours Filter (9:30 AM - 3:00 PM ET) ───
// ═══════════════════════════════════════════════
inSession = not na(time(timeframe.period, "0930-1500", "America/New_York"))

// ═══════════════════════════════════════════════
// ─── Opening Range Calculation ───
// ═══════════════════════════════════════════════
is_session(sess) =>
    not na(time(timeframe.period, sess, "America/New_York"))

bool inOpenRange = is_session(orSess)

var float or_high = na
var float or_low  = na
var bool  orComplete = false

// New OR session starting — reset
if inOpenRange and not inOpenRange[1]
    or_high    := high
    or_low     := low
    orComplete := false

// Still inside OR — expand range
else if inOpenRange
    or_high := math.max(or_high, high)
    or_low  := math.min(or_low, low)

// OR just closed — mark complete
if not inOpenRange and inOpenRange[1]
    orComplete := true

// ─── OR Level Plots ───
or_high_line = plot(orComplete ? or_high : na, "OR High", color.maroon, 2, style=plot.style_linebr)
or_low_line  = plot(orComplete ? or_low  : na, "OR Low",  color.olive,  2, style=plot.style_linebr)
fill(or_high_line, or_low_line, color.new(color.gray, 80))

// ═══════════════════════════════════════════════
// ─── Signal 1: DMI Crossover + ADX Rising ───
// ═══════════════════════════════════════════════
bullishCross = ta.crossover(diPlus, diMinus)
bearishCross = ta.crossover(diMinus, diPlus)
adxRising    = adxValue > adxValue[1]

dmiCall = bullishCross and adxRising and inSession
dmiPut  = bearishCross and adxRising and inSession

// ═══════════════════════════════════════════════
// ─── Signal 2: ORB Breakout + ADX Rising ───
// (5-min close above/below OR after OR is complete)
// ═══════════════════════════════════════════════
inOrbWindow = not na(time(timeframe.period, "1005-1100", "America/New_York"))

orbCall = orComplete and inOrbWindow and (close > or_high) and (close[1] <= or_high) and adxRising
orbPut  = orComplete and inOrbWindow and (close < or_low)  and (close[1] >= or_low)  and adxRising

// ═══════════════════════════════════════════════
// ─── Plot Flags ───
// ═══════════════════════════════════════════════

// DMI Signals
plotshape(dmiCall, title="DMI Call", text="DMI\nCALL", textcolor=color.white,
     style=shape.labelup, location=location.belowbar,
     color=color.green, size=size.normal)

plotshape(dmiPut, title="DMI Put", text="DMI\nPUT", textcolor=color.white,
     style=shape.labeldown, location=location.abovebar,
     color=color.red, size=size.normal)

// ORB Signals
plotshape(orbCall, title="ORB Call", text="ORB\nCALL", textcolor=color.white,
     style=shape.labelup, location=location.belowbar,
     color=color.teal, size=size.normal)

plotshape(orbPut, title="ORB Put", text="ORB\nPUT", textcolor=color.white,
     style=shape.labeldown, location=location.abovebar,
     color=color.orange, size=size.normal)

// ═══════════════════════════════════════════════
// ─── Audio Alerts ───
// ═══════════════════════════════════════════════
alertcondition(dmiCall, title="DMI Buy Call",
     message="Buy a Call - PeakBot - Ben Bot")

alertcondition(dmiPut, title="DMI Buy Put",
     message="Buy a Put - PeakBot - Ben Bot")

alertcondition(orbCall, title="ORB Buy Call",
     message="Buy a Call - PeakBot - Ben Bot")

alertcondition(orbPut, title="ORB Buy Put",
     message="Buy a Put - PeakBot - Ben Bot")

alertcondition(dmiCall or orbCall, title="Any Call Signal",
     message="Buy a Call - PeakBot - Ben Bot")

alertcondition(dmiPut or orbPut, title="Any Put Signal",
     message="Buy a Put - PeakBot - Ben Bot")
