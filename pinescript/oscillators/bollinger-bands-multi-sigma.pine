//@version=6
indicator(shorttitle="BB Multi-Sigma", title="Bollinger Bands (Multi-Sigma)", overlay=true, timeframe="", timeframe_gaps=true)

// 入力設定
length = input.int(20, minval=1, title="Length")
maType = input.string("SMA", "Basis MA Type", options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"])
src = input(close, title="Source")
offset = input.int(0, "Offset", minval = -500, maxval = 500, display = display.data_window)

// 標準偏差の乗数（シグマ値）
mult1 = input.float(1.0, minval=0.001, maxval=50, title="StdDev Multiplier (Sigma 1)") // Σ1
mult2 = input.float(2.0, minval=0.001, maxval=50, title="StdDev Multiplier (Sigma 2)") // Σ2 (デフォルト)
mult3 = input.float(3.0, minval=0.001, maxval=50, title="StdDev Multiplier (Sigma 3)") // Σ3

// --- 関数定義 ---
ma(source, length, _type) =>
    switch _type
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)

// --- 計算 ---
// 基準線 (Basis) は共通
basis = ma(src, length, maType)
// 標準偏差
stddev = ta.stdev(src, length)

// シグマ 1, 2, 3 の偏差とバンド
dev1 = mult1 * stddev
upper1 = basis + dev1
lower1 = basis - dev1

dev2 = mult2 * stddev
upper2 = basis + dev2
lower2 = basis - dev2

dev3 = mult3 * stddev
upper3 = basis + dev3
lower3 = basis - dev3

// --- プロット ---

// 基準線
plot(basis, "Basis", color=#2962FF, offset = offset)

// シグマ 1 バンド
p_u1 = plot(upper1, "Upper 1", color=color.rgb(255, 165, 0), offset = offset) // オレンジ
p_l1 = plot(lower1, "Lower 1", color=color.rgb(255, 165, 0), offset = offset)
fill(p_u1, p_l1, title = "Background 1", color=color.rgb(255, 165, 0, 90))

// シグマ 2 バンド (デフォルトの色を使用)
p_u2 = plot(upper2, "Upper 2", color=#F23645, offset = offset) // 赤
p_l2 = plot(lower2, "Lower 2", color=#089981, offset = offset) // 緑
// p_u2とp_l2の間は、シグマ1のフィルが覆いかぶさらないように、シグマ2とシグマ1の間にフィルを行います。
fill(p_u2, p_u1, title = "Background 2 Upper", color=color.rgb(33, 150, 243, 95))
fill(p_l1, p_l2, title = "Background 2 Lower", color=color.rgb(33, 150, 243, 95))


// シグマ 3 バンド (色を青系に調整)
p_u3 = plot(upper3, "Upper 3", color=color.rgb(63, 81, 181), offset = offset) // 濃い青
p_l3 = plot(lower3, "Lower 3", color=color.rgb(63, 81, 181), offset = offset)
// シグマ3とシグマ2の間にフィルを行います。
fill(p_u3, p_u2, title = "Background 3 Upper", color=color.rgb(156, 39, 176, 90))
fill(p_l2, p_l3, title = "Background 3 Lower", color=color.rgb(156, 39, 176, 90))
