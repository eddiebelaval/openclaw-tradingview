//@version=6
//
//@author LincolnWung
// 
//script based in:
// original John Carter's ideas (SQUEEZE & SQUEEZE PRO) https://www.simplertrading.com/
// LazyBear's script (Squeeze Momentum Indicator) https://www.tradingview.com/script/nqQ1DT5a-Squeeze-Momentum-Indicator-LazyBear/
//
// USE IT IN CONJUNCTION WITH THE SQUEEZE PRO ARROWS INDICATOR
// 
// This system is based in the volatility reversion to the mean: volatility contraction leads to volatility expansion and the other way on
// The dot signal is a warning of volatility compression, more often than not this leads to a expansion of volatility and a move in the action price usually bigger than the expected move
// Be aware of the trend direction, use the momentum histogram to see the slope direction
//  
//挤压点（sq_color） 
//窄通道挤压（最强）：红色 red
//正常挤压：橙色 orange
//宽通道挤压（最弱）：黄色 yellow
//刚刚出挤压（扩张）：亮绿色 lime
//其他（无挤压）：灰色 gray
//动量柱（mom_color）——只表达“方向 + 强弱”
//现在四种颜色（aqua/blue/red/yellow）比较散，不太容易联想到“多空强弱”。建议：
//多头方向（>0）：全部用“绿色系”
//增强：亮绿 lime
//减弱：普通绿 green
//空头方向（<0）：全部用“红色系”
//增强：红 red
//减弱：深红/酒红 maroon
indicator(title="Squeeze_Momentum_By_Lincoln", shorttitle="SqzMmtm_LW", overlay=false) // 定义指标：完整标题、短标题，不叠加在主图（overlay=false 表示单独一个副图）

float source = close // 指定计算用的数据源，这里使用每根K线的收盘价
length = input.int(20, "Length") // 指标的基础周期长度，这里统一使用20根K线
ma = ta.sma(source,length) // 计算20周期的简单移动平均线（SMA），作为中轴
devBB = ta.stdev(source,length) // 计算20周期收盘价的标准差，用于构建布林带的上下轨
devKC = ta.sma(ta.tr(true),length) // 计算20周期的真实波幅平均（TR 的 SMA），用于构建凯尔特纳通道


//Bollinger 2x —— 布林带，上下轨为 2 倍标准差，表示较常用的波动范围
upBB = ma + devBB * 2 // 布林带上轨 = 中轴 + 2倍标准差
lowBB = ma - devBB * 2 // 布林带下轨 = 中轴 - 2倍标准差

//Keltner 2x —— 最宽的凯尔特纳通道，上下轨为 2 倍平均真实波幅
upKCWide = ma + devKC * 2 // 宽通道上轨 = 中轴 + 2倍ATR均值
lowKCWide = ma - devKC * 2 // 宽通道下轨 = 中轴 - 2倍ATR均值

//Keltner 1.5x —— 正常宽度的凯尔特纳通道，上下轨为 1.5 倍平均真实波幅
upKCNormal = ma + devKC * 1.5 // 正常通道上轨
lowKCNormal = ma - devKC * 1.5 // 正常通道下轨

//Keltner 1x —— 最窄的凯尔特纳通道，上下轨为 1 倍平均真实波幅
upKCNarrow = ma + devKC // 窄通道上轨
lowKCNarrow = ma - devKC // 窄通道下轨

// 当布林带完全被“宽”凯尔特纳通道包住时，说明波动非常收缩，对应最弱的挤压级别（配合 sq_color 使用“黄色”）
sqzOnWide  = (lowBB >= lowKCWide) and (upBB <= upKCWide) // WIDE SQUEEZE —— 宽通道挤压（弱挤压）
// 当布林带被“正常”宽度的通道包住时，对应常规挤压级别（配合 sq_color 使用“橙色”），类似原版 Squeeze 定义
sqzOnNormal  = (lowBB >= lowKCNormal) and (upBB <= upKCNormal) // NORMAL SQUEEZE —— 正常挤压（中等强度）
// 当布林带甚至被“窄”通道包住时，说明极端收缩，对应最强挤压级别（配合 sq_color 使用“红色”）
sqzOnNarrow  = (lowBB >= lowKCNarrow) and (upBB <= upKCNarrow) // NARROW SQUEEZE —— 极限挤压（最强挤压）
// 当布林带重新跑到“宽”通道外面时，代表挤压已经被释放，进入波动扩张（配合 sq_color 使用“亮绿色”）
sqzOffWide = (lowBB < lowKCWide) and (upBB > upKCWide) // FIRED WIDE SQUEEZE —— 挤压触发（释放）
// 既不是挤压中，也不是刚刚释放挤压的状态，属于“无挤压区”（配合 sq_color 使用“灰色”）
noSqz  = (sqzOnWide == false) and (sqzOffWide == false) // NO SQUEEZE —— 无挤压

//Momentum Oscillator —— 动量震荡指标，用来判断价格相对“中值”的偏离方向和力度
// 使用线性回归拟合的方式平滑动量
mom = ta.linreg(source  -  ( (ta.highest(high, length) + ta.lowest(low, length)) / 2 
  + ta.sma(close, length) ) / 2,length,0)

//Momentum histogram color —— 给动量柱赋予颜色，帮助我们快速看多空强弱以及斜率变化
// 动量柱配色：绿系=多头，红系=空头；亮=增强，暗=减弱
mom_color = mom > 0
     ? (mom > nz(mom[1]) ? color.lime   : color.green)  
     : (mom < nz(mom[1]) ? color.red    : color.maroon) 

//Squeeze Dots color —— 0轴上的圆点颜色，用来表示当前所处的挤压阶段
// 更语义化的挤压点配色：灰(无) → 黄(弱) → 橙(中) → 红(强) → 绿(释放)
// 极限挤压：最“危险”，用红色
// 正常挤压：中等强度，用橙色
// 宽通道挤压：比较弱，用黄色
// 挤压刚释放：波动扩张，用亮绿
// 其他情况：无挤压，用灰色
sq_color = sqzOnNarrow ? color.red
           : sqzOnNormal ? color.orange 
           : sqzOnWide  ? color.yellow  
           : sqzOffWide ? color.lime    
           : color.gray                 
// 绘制动量柱状图，颜色由上面的逻辑决定
plot(mom, title='柱体', color=mom_color, style=plot.style_histogram, linewidth=5) 
// 在0轴上绘制彩色圆点，用于直观看挤压状态
plot(0, title='中轴点', style=plot.style_circles, color=color.new(sq_color, 0), linewidth=3)
