// HillBillyKrypto
//@version=5

strategy("🔥 HB - Rotational Stretch Engine (STRATEGY)",
     overlay=true,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=4,
     slippage=1)

//────────────────────────────
// USER SETTINGS
//────────────────────────────
contracts      = input.int(1, "Contracts")

// RSI Controls
rsiLength      = input.int(14, "RSI Length")
shortStretch   = input.int(60, "Short Stretch Level")
longStretch    = input.int(40, "Long Stretch Level")

// Premium / Discount Width
rangeLookback  = input.int(100, "Range Lookback")
zonePercent    = input.float(0.20, "Premium/Discount %", step=0.01)

// Risk
targetTicks    = input.int(12, "Target (ticks)")
stopTicks      = input.int(11, "Stop (ticks)")

// Session
nySession = input.session("0200-1559", "Session Hrs")
inNY = not na(time(timeframe.period, nySession))

//────────────────────────────
// RANGE MODEL
//────────────────────────────
rangeHigh = ta.highest(high, rangeLookback)
rangeLow  = ta.lowest(low,  rangeLookback)
rangeSize = rangeHigh - rangeLow

premiumLevel  = rangeHigh - rangeSize * zonePercent
discountLevel = rangeLow  + rangeSize * zonePercent

inPremium  = close >= premiumLevel
inDiscount = close <= discountLevel

//────────────────────────────
// RSI STRUCTURE
//────────────────────────────
rsi = ta.rsi(close, rsiLength)

// Swing detection
rsiSwingHigh = rsi[1] > rsi[2] and rsi[1] > rsi
rsiSwingLow  = rsi[1] < rsi[2] and rsi[1] < rsi

// Momentum shift
rsiTurnDown = rsi < rsi[1]
rsiTurnUp   = rsi > rsi[1]

//────────────────────────────
// ENTRY LOGIC
//────────────────────────────

// SHORT ENTRY
shortCondition =
     inNY and
     inPremium and
     rsi[1] > shortStretch and
     rsiSwingHigh and
     rsiTurnDown and
     strategy.position_size <= 0

// LONG ENTRY
longCondition =
     inNY and
     inDiscount and
     rsi[1] < longStretch and
     rsiSwingLow and
     rsiTurnUp and
     strategy.position_size >= 0

//────────────────────────────
// EXECUTION
//────────────────────────────
if shortCondition
    strategy.entry("Short", strategy.short, qty=contracts)

if longCondition
    strategy.entry("Long", strategy.long, qty=contracts)

//────────────────────────────
// EXIT (TP / SL)
//────────────────────────────
tick = syminfo.mintick

if strategy.position_size < 0
    strategy.exit("Short Exit",
         from_entry="Short",
         limit=strategy.position_avg_price - targetTicks * tick,
         stop=strategy.position_avg_price + stopTicks * tick)

if strategy.position_size > 0
    strategy.exit("Long Exit",
         from_entry="Long",
         limit=strategy.position_avg_price + targetTicks * tick,
         stop=strategy.position_avg_price - stopTicks * tick)
