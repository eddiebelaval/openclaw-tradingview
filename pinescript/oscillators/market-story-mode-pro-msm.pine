//@version=6
indicator("Market Story Mode Pro [MSM]", shorttitle="MSM Pro", overlay=true, max_labels_count=50)

//----------------------------------------
// Inputs
//----------------------------------------
groupCore = "Core Logic"
len = input.int(14, "Analysis Length", minval=5, maxval=100, group=groupCore)
smoothLen = input.int(5, "Smoothing", minval=1, maxval=50, group=groupCore)
confirmBars = input.int(3, "Story Confirmation Bars", minval=1, maxval=10, group=groupCore)

groupDisplay = "Display"
showDashboard = input.bool(true, "Show Dashboard", group=groupDisplay)
showBackground = input.bool(true, "Background Highlight", group=groupDisplay)

groupDashboard = "Dashboard"
dashboardPosition = input.string(
     "Top Right",
     "Dashboard Position",
     options=[
         "Top Left", "Top Center", "Top Right",
         "Middle Left", "Middle Center", "Middle Right",
         "Bottom Left", "Bottom Center", "Bottom Right"
     ],
     group=groupDashboard
)

dashboardTextSize = input.string(
     "Normal",
     "Text Size",
     options=["Tiny", "Small", "Normal", "Large"],
     group=groupDashboard
)

//----------------------------------------
// Helpers
//----------------------------------------
f_pos(p) =>
    pos = position.top_right
    if p == "Top Left"
        pos := position.top_left
    else if p == "Top Center"
        pos := position.top_center
    else if p == "Top Right"
        pos := position.top_right
    else if p == "Middle Left"
        pos := position.middle_left
    else if p == "Middle Center"
        pos := position.middle_center
    else if p == "Middle Right"
        pos := position.middle_right
    else if p == "Bottom Left"
        pos := position.bottom_left
    else if p == "Bottom Center"
        pos := position.bottom_center
    else
        pos := position.bottom_right
    pos

f_size(s) =>
    out = size.normal
    if s == "Tiny"
        out := size.tiny
    else if s == "Small"
        out := size.small
    else if s == "Normal"
        out := size.normal
    else
        out := size.large
    out

f_clamp(v, lo, hi) =>
    math.max(lo, math.min(hi, v))

//----------------------------------------
// Core Logic
//----------------------------------------
avgRange = ta.sma(high - low, len)
avgBody = ta.sma(math.abs(close - open), len)
direction = ta.ema(close - close[1], smoothLen)
momentumSlope = ta.ema(close - close[2], smoothLen)

strength = avgBody / math.max(avgRange, syminfo.mintick)
directionStrength = math.abs(direction) / math.max(avgRange, syminfo.mintick)

// Intraday-friendly control rules
bullControl = direction > 0 and strength > 0.55
bearControl = direction < 0 and strength > 0.55
weakMove = strength < 0.35
choppy = math.abs(direction) < syminfo.mintick * 2

//----------------------------------------
// Raw Story Engine
//----------------------------------------
story = "Market is transitioning"
if bullControl
    story := "Buyers are in control"
else if bearControl
    story := "Sellers are in control"
else if weakMove
    story := "Market is weak and uncertain"
else if choppy
    story := "Market is sideways / indecisive"

context = "Mixed signals"
if bullControl and strength > 0.70
    context := "Strong upward pressure"
else if bearControl and strength > 0.70
    context := "Strong downward pressure"
else if weakMove
    context := "Low conviction move"
else if choppy
    context := "No clear direction"

advice = "Wait for confirmation"
if bullControl
    advice := "Momentum is upward"
else if bearControl
    advice := "Momentum is downward"
else if weakMove
    advice := "Better to wait for clarity"
else if choppy
    advice := "Avoid aggressive trades"

//----------------------------------------
// Raw Colors
//----------------------------------------
rawStateColor = color.rgb(90, 120, 255)
if bullControl
    rawStateColor := color.rgb(0, 200, 120)
else if bearControl
    rawStateColor := color.rgb(230, 70, 70)
else if weakMove
    rawStateColor := color.rgb(255, 170, 0)
else if choppy
    rawStateColor := color.rgb(120, 120, 180)

//----------------------------------------
// Stability Layer
//----------------------------------------
var string stableStory = "Market is transitioning"
var string stableContext = "Mixed signals"
var string stableAdvice = "Wait for confirmation"
var color stableStateColor = color.rgb(90, 120, 255)
var int stateCount = 0

currentState = story

if currentState == stableStory
    stateCount += 1
else
    stateCount := 1

if stateCount >= confirmBars
    stableStory := story
    stableContext := context
    stableAdvice := advice
    stableStateColor := rawStateColor

//----------------------------------------
// No Trade Zone Logic
//----------------------------------------
isStableTransition = stableStory == "Market is transitioning"
isStableSideways = stableStory == "Market is sideways / indecisive"
isNoTradeZone = (isStableTransition or isStableSideways) and stateCount >= confirmBars

//----------------------------------------
// Trend Stage Logic (Intraday)
//----------------------------------------
trendStage = "None"

if stableStory == "Buyers are in control"
    if stateCount <= confirmBars + 1
        trendStage := "Early Uptrend"
    else if stateCount <= confirmBars + 5
        trendStage := "Mid Uptrend"
    else
        trendStage := "Late Uptrend"
else if stableStory == "Sellers are in control"
    if stateCount <= confirmBars + 1
        trendStage := "Early Downtrend"
    else if stateCount <= confirmBars + 5
        trendStage := "Mid Downtrend"
    else
        trendStage := "Late Downtrend"
else if isNoTradeZone
    trendStage := "No Trend"
else if stableStory == "Market is weak and uncertain"
    trendStage := "Weak Phase"
else
    trendStage := "Transition"

//----------------------------------------
// Confidence Logic
//----------------------------------------
baseConfidence = 0.0
stabilityBoost = 0.0
directionBoost = 0.0
penalty = 0.0

baseConfidence := strength * 100.0
stabilityBoost := math.min(stateCount * 6.0, 30.0)
directionBoost := math.min(directionStrength * 100.0, 20.0)

if weakMove
    penalty += 20.0
if choppy
    penalty += 20.0
if isNoTradeZone
    penalty += 25.0

confidence = f_clamp(baseConfidence + stabilityBoost + directionBoost - penalty, 0.0, 100.0)
confidenceTxt = str.tostring(math.round(confidence)) + "%"

//----------------------------------------
// Final Display Layer
//----------------------------------------
displayStory = stableStory
displayContext = stableContext
displayAdvice = stableAdvice
displayStateColor = stableStateColor

if isNoTradeZone
    displayStory := "No Trade Zone"
    displayContext := "Market is consistently unclear"
    displayAdvice := "Avoid entries until direction improves"
    displayStateColor := color.rgb(255, 170, 0)

//----------------------------------------
// Background
//----------------------------------------
bgcolor(showBackground ? color.new(displayStateColor, 92) : na)

//----------------------------------------
// Dashboard
//----------------------------------------
var string lastPos = dashboardPosition
var table dash = table.new(f_pos(dashboardPosition), 2, 7)

if dashboardPosition != lastPos
    table.delete(dash)
    dash := table.new(f_pos(dashboardPosition), 2, 7)
    lastPos := dashboardPosition

if showDashboard and barstate.islast
    txt = f_size(dashboardTextSize)

    header = color.rgb(10, 12, 18)
    left = color.rgb(22, 26, 34)
    right = color.rgb(14, 17, 24)

    confirmTxt = str.tostring(stateCount) + "/" + str.tostring(confirmBars)

    table.cell(dash, 0, 0, "MSM", text_color=color.white, text_size=txt, bgcolor=header)
    table.cell(dash, 1, 0, "PRO", text_color=color.white, text_size=txt, bgcolor=header)

    table.cell(dash, 0, 1, "Story", text_color=color.white, text_size=txt, bgcolor=left)
    table.cell(dash, 1, 1, displayStory, text_color=color.white, text_size=txt, bgcolor=color.new(displayStateColor, 20))

    table.cell(dash, 0, 2, "Context", text_color=color.white, text_size=txt, bgcolor=left)
    table.cell(dash, 1, 2, displayContext, text_color=color.white, text_size=txt, bgcolor=right)

    table.cell(dash, 0, 3, "Guidance", text_color=color.white, text_size=txt, bgcolor=left)
    table.cell(dash, 1, 3, displayAdvice, text_color=color.white, text_size=txt, bgcolor=right)

    table.cell(dash, 0, 4, "Stability", text_color=color.white, text_size=txt, bgcolor=left)
    table.cell(dash, 1, 4, confirmTxt, text_color=color.white, text_size=txt, bgcolor=right)

    table.cell(dash, 0, 5, "Trend Stage", text_color=color.white, text_size=txt, bgcolor=left)
    table.cell(dash, 1, 5, trendStage, text_color=color.white, text_size=txt, bgcolor=right)

    table.cell(dash, 0, 6, "Confidence", text_color=color.white, text_size=txt, bgcolor=left)
    table.cell(dash, 1, 6, confidenceTxt, text_color=color.white, text_size=txt, bgcolor=right)

//----------------------------------------
// Alerts
//----------------------------------------
alertcondition(bullControl, title="MSM Bullish", message="Market Story: Buyers are in control")
alertcondition(bearControl, title="MSM Bearish", message="Market Story: Sellers are in control")
alertcondition(weakMove, title="MSM Weak", message="Market Story: Weak market conditions")
alertcondition(choppy, title="MSM Sideways", message="Market Story: Market is sideways / indecisive")
alertcondition(isNoTradeZone, title="MSM No Trade Zone", message="Market Story: No trade zone detected. Market is consistently unclear.")
