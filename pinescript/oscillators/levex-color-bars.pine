//@version=5
indicator("Levex - Color Bars", overlay=true)

//====================
// Inputs
//====================
ema1Len = input.int(10,  "EMA 1 Length", minval=1)
ema2Len = input.int(20,  "EMA 2 Length", minval=1)

rsiLen   = input.int(5, "RSI Length", minval=1)
maRsiLen = input.int(9,  "MA(RSI) Length", minval=1)
alpha    = input.float(0.1, "alpha", step=0.01)

useWeighted = input.bool(false, "Use Weighted MA")

lowThr  = 28.0//input.float(28.0, "InvFish Low Threshold", step=0.1)
highThr = 72.0//input.float(72.0, "InvFish High Threshold", step=0.1)

colorUp = input.color(color.blue, "Color Up")
colorDn = input.color(color.red, "Color Down")

// EMA
ema1 = ta.ema(close, ema1Len)
ema2 = ta.ema(close, ema2Len)
diff = ema1 - ema2

slopingDown = diff < diff[1]
slopingUp   = diff > diff[1]


// InvFish
// exp:=( Exponential(2*( alpha*( MA(RSI(@,RSI),Exp,MArsi)-50)))-1)/( Exponential(2* ( alpha*( MA(RSI(@,RSI),Exp,MArsi)-50)))+1);
// wei:=( Exponential(2*( alpha*( MA(RSI(@,RSI),Wei,MArsi)-50)))-1)/( Exponential(2* ( alpha*( MA(RSI(@,RSI),Wei,MArsi)-50)))+1);
// normalizedEXP:=50*( exp+1);
// normalizedWEI:=50*( wei+1);
// IF(Weighted_Exponential = 1, normalizedWEI, normalizedEXP) 

rsiVal   = ta.rsi(close, rsiLen)
maExpRsi = ta.ema(rsiVal, maRsiLen)
maWeiRsi = ta.wma(rsiVal, maRsiLen)

invFishFrom(ma) =>
    x  = alpha * (ma - 50.0)
    e2 = math.exp(2.0 * x)
    t  = (e2 - 1.0) / (e2 + 1.0)
    50.0 * (t + 1.0)

invFish = useWeighted ? invFishFrom(maWeiRsi) : invFishFrom(maExpRsi)

// Color bars
redCond   = slopingDown and invFish < lowThr
greenCond = slopingUp   and invFish > highThr

barcolor(greenCond ? colorUp : redCond ? colorDn : na)
