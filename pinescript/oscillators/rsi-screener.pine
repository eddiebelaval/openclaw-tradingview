//@version=6
indicator(title="RSI Screener", shorttitle = "RSI Screener", overlay=true)

ticker1 = syminfo.tickerid

grp_tf = "Таймфреймы"
useTF1 = input.bool(true, "", inline="tf1", group=grp_tf)
TF1 = input.timeframe("1", title="ТФ 1", inline="tf1", group=grp_tf)

useTF2 = input.bool(true, "", inline="tf2", group=grp_tf)
TF2 = input.timeframe("5", title="ТФ 2", inline="tf2", group=grp_tf)

useTF3 = input.bool(true, "", inline="tf3", group=grp_tf)
TF3 = input.timeframe("15", title="ТФ 3", inline="tf3", group=grp_tf)

useTF4 = input.bool(true, "", inline="tf4", group=grp_tf)
TF4 = input.timeframe("60", title="ТФ 4", inline="tf4", group=grp_tf)

useTF5 = input.bool(true, "", inline="tf5", group=grp_tf)
TF5 = input.timeframe("240", title="ТФ 5", inline="tf5", group=grp_tf)

useTF6 = input.bool(true, "", inline="tf6", group=grp_tf)
TF6 = input.timeframe("720", title="ТФ 6", inline="tf6", group=grp_tf)

useTF7 = input.bool(true, "", inline="tf7", group=grp_tf)
TF7 = input.timeframe("1D", title="ТФ 7", inline="tf7", group=grp_tf)

useTF8 = input.bool(true, "", inline="tf8", group=grp_tf)
TF8 = input.timeframe("3D", title="ТФ 8", inline="tf8", group=grp_tf)

useTF9 = input.bool(true, "", inline="tf9", group=grp_tf)
TF9 = input.timeframe("1W", title="ТФ 9", inline="tf9", group=grp_tf)

tfs = array.from(TF1, TF2, TF3, TF4, TF5, TF6, TF7, TF8, TF9)
tfs_enabled = array.from(useTF1, useTF2, useTF3, useTF4, useTF5, useTF6, useTF7, useTF8, useTF9)

grp_rsi = "Параметры RSI"
rsiPeriod = input.int(14, title="Период RSI", minval=2, maxval=365, tooltip="RSI length", group=grp_rsi)
rsiOverbought = input.int(65, title="Перекупленность (Шорт / Красная зона)", minval=51, maxval=100, tooltip="Bearish zone", group=grp_rsi)
rsiOversold   = input.int(35, title="Перепроданность (Лонг / Зеленая зона)", minval=0, maxval=50, tooltip="Bullish zone", group=grp_rsi)

grp_style = "Настройки стиля"
show_ticker  = input.bool(false, "Показывать колонку с тикером", tooltip="Show ticker column", group=grp_style)
show_arrow   = input.bool(false, "Показывать направление стрелками", tooltip="Show direction with arrows", group=grp_style)
dash_loc     = input.session("Снизу справа", "Расположение таблицы", options=["Сверху справа", "Снизу справа", "Сверху слева", "Снизу слева", "Справа по центру", "Снизу по центру"], tooltip="Screener location", group=grp_style)
text_size    = input.session("Мелкий", "Размер текста", options=["Крошечный", "Мелкий", "Обычный", "Крупный"], tooltip="Screener size", group=grp_style)
cell_up      = input.color(#e71a2a, 'Цвет зоны перекупленности', tooltip="Bearish cell colour", group=grp_style)
cell_dn      = input.color(#4caf50, 'Цвет зоны перепроданности', tooltip="Bullish cell colour", group=grp_style)
cell_mid     = input.color(#ffeb3b, 'Цвет зоны 50 (Флэт/Переход)', tooltip="Middle cell colour", group=grp_style) 
cell_neutral = input.color(color.rgb(255, 255, 255), 'Цвет нейтральной зоны', tooltip="Neutral cell colour", group=grp_style)
txt_col      = input.color(color.rgb(20, 20, 20), 'Цвет текста и границ', tooltip="Text/Frame colour", group=grp_style)
cell_transp  = input.int(20, 'Прозрачность заливки', minval=0, maxval=100, tooltip="Cell transparency", group=grp_style)

f_get_rsi() =>
    r = ta.rsi(close, rsiPeriod)
    r_prev = r[1]
    [r, r_prev]

[s1_r1, s1_p1] = request.security(ticker1, TF1, f_get_rsi())
[s1_r2, s1_p2] = request.security(ticker1, TF2, f_get_rsi())
[s1_r3, s1_p3] = request.security(ticker1, TF3, f_get_rsi())
[s1_r4, s1_p4] = request.security(ticker1, TF4, f_get_rsi())
[s1_r5, s1_p5] = request.security(ticker1, TF5, f_get_rsi())
[s1_r6, s1_p6] = request.security(ticker1, TF6, f_get_rsi())
[s1_r7, s1_p7] = request.security(ticker1, TF7, f_get_rsi())
[s1_r8, s1_p8] = request.security(ticker1, TF8, f_get_rsi())
[s1_r9, s1_p9] = request.security(ticker1, TF9, f_get_rsi())

s1_rsi_arr = array.from(s1_r1, s1_r2, s1_r3, s1_r4, s1_r5, s1_r6, s1_r7, s1_r8, s1_r9)
s1_prv_arr = array.from(s1_p1, s1_p2, s1_p3, s1_p4, s1_p5, s1_p6, s1_p7, s1_p8, s1_p9)

f_format_tf(tf_str) =>
    string res = tf_str
    if not str.contains(tf_str, "D") and not str.contains(tf_str, "W") and not str.contains(tf_str, "M")
        int_val = int(str.tonumber(tf_str))
        if not na(int_val)
            if int_val >= 60
                hrs = int(int_val / 60)
                mins = int_val % 60
                if mins == 0
                    res := str.tostring(hrs) + "H"
                else
                    res := str.tostring(hrs) + "H " + str.tostring(mins) + "m"
            else
                res := str.tostring(int_val) + "m"
    res

sym_parts = str.split(ticker1, ":")
display_sym = array.size(sym_parts) > 1 ? array.get(sym_parts, 1) : ticker1

var table_position = dash_loc == 'Сверху слева' ? position.top_left :
  dash_loc == 'Снизу слева' ? position.bottom_left :
  dash_loc == 'Справа по центру' ? position.middle_right :
  dash_loc == 'Снизу по центру' ? position.bottom_center :
  dash_loc == 'Сверху справа' ? position.top_right : position.bottom_right
  
var table_text_size = text_size == 'Крошечный' ? size.tiny :
  text_size == 'Мелкий' ? size.small :
  text_size == 'Обычный' ? size.normal : size.large

var t = table.new(table_position, show_ticker ? 10 : 9, 2, frame_color=color.black, frame_width=1, border_color=color.black, border_width=1)

if barstate.islast
    col_offset = show_ticker ? 1 : 0

    if show_ticker
        table.cell(t, 0, 0, "Тикер", text_color=color.white, text_size=table_text_size, bgcolor=color.black)
        table.cell(t, 0, 1, display_sym, text_color=color.white, text_size=table_text_size, bgcolor=color.black)

    col = col_offset

    for i = 0 to 8
        if array.get(tfs_enabled, i)
            pretty_tf = f_format_tf(array.get(tfs, i))
            table.cell(t, col, 0, pretty_tf, text_color=color.white, text_size=table_text_size, bgcolor=color.black)
            
            curr_rsi = array.get(s1_rsi_arr, i)
            prev_rsi = array.get(s1_prv_arr, i)
            
            arrow = show_arrow ? (curr_rsi > prev_rsi ? " ↑" : curr_rsi < prev_rsi ? " ↓" : " ⭢") : ""
            bg_color = curr_rsi >= rsiOverbought ? cell_up : curr_rsi <= rsiOversold ? cell_dn : (curr_rsi >= 48.5 and curr_rsi <= 51.5) ? cell_mid : cell_neutral
            cell_text = str.tostring(curr_rsi, '#.#') + arrow
            
            table.cell(t, col, 1, cell_text, text_color=txt_col, text_size=table_text_size, bgcolor=color.new(bg_color, cell_transp))
            
            col += 1
