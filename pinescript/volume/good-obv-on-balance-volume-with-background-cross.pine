//@version=6
indicator(title="Good OBV On Balance Volume with background cross", shorttitle="OBV cross", format=format.volume, timeframe="", timeframe_gaps=true)
res = input.timeframe('', 'Indicator TimeFrame')
var cumVol = 0.
cumVol += nz(volume)
if barstate.islast and cumVol == 0
    runtime.error("No volume is provided by the data vendor.")
src = close
obv = ta.cum(math.sign(ta.change(src)) * volume)
plot(obv, color=color.rgb(220, 88, 88), title="OnBalanceVolume")

//signal
signal_length = input.int(title = 'Signal Smoothing', minval = 1, maxval = 999, defval = 50)
sma_signal = input.string(title = 'Signal Line MA Type', defval = 'EMA', options = ['SMA', 'EMA'])
show_signal_LW = input.int(2, minval = 0, maxval = 5, title = 'Signal Width', group = 'Show Plots?', inline = 'SP11')
show_cross = input.bool(true, title = 'Show BackGround on Cross', group = 'Show Plots?', inline = 'SP50')
signal = request.security(syminfo.tickerid, res, sma_signal == 'SMA' ? ta.sma(obv, signal_length) : ta.ema(obv, signal_length))

// Show Plots T/F
show_obv = input.bool(true, title = 'Show OBV Lines', group = 'Show Plots?', inline = 'SP10')
show_obv_LW = input.int(3, minval = 0, maxval = 5, title = 'MACD Width', group = 'Show Plots?', inline = 'SP11')

//this should allow you to turn on or off the trend changing colour
show_trend = input.bool(true, title = 'Show OBV Lines w/ Trend Color', group = 'Show Plots?', inline = 'SP30')
// OBV Lines colors
col_obv = input.color(#FF6D00, 'OBV Line  ', group = 'Color Settings', inline = 'CS1')
col_signal = input.color(#2962FF, 'Signal Line  ', group = 'Color Settings', inline = 'CS1')
col_trnd_Up = input.color(#4BAF4F, 'Trend Up      ', group = 'Color Settings', inline = 'CS2')
col_trnd_Dn = input.color(#B71D1C, 'Trend Down    ', group = 'Color Settings', inline = 'CS2')

// OBV Trend and Cross Up/Down conditions
trend_up = obv > signal
trend_dn = obv < signal
cross_UP = signal[1] >= obv[1] and signal < obv
cross_DN = signal[1] <= obv[1] and signal > obv
// Condition that changes Color of OBV Line if Show Trend is turned on..
trend_col = show_trend and trend_up ? col_trnd_Up : trend_up ? col_obv : show_trend and trend_dn ? col_trnd_Dn : trend_dn ? col_obv : na

//Background Color
bgcolor(show_cross and cross_UP ? col_trnd_Up : na, editable = false)
bgcolor(show_cross and cross_DN ? col_trnd_Dn : na, editable = false)



//Plots
plot(show_obv and bool(signal) ? signal : na, title = 'Signal', color = color.new(col_signal, 0), style = plot.style_line, linewidth = math.max(1, show_signal_LW))
plot(show_obv and bool(obv) ? obv : na, title = 'OBV', color = color.new(trend_col, 0), style = plot.style_line, linewidth = math.max(1, show_obv_LW))
