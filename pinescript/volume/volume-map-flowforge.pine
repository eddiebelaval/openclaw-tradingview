//@version=6
indicator("Volume Map [FlowForge]", shorttitle="Volume Map [FlowForge]", overlay=false)

// ═══════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════

// ── Theme ──────────────────────────────────────────────────────────
themeChoice = input.string("Colorful", "Theme", group="Theme",
     options=["Colorful", "Synthwave", "Sunny", "Neon", "Monochrome", "Arctic", "Dusk"],
     tooltip="Colorful   = TradingView green/red.\nSynthwave  = cyan bullish, magenta bearish.\nSunny      = amber bullish, terracotta bearish.\nNeon       = neon green bullish, neon red bearish.\nMonochrome = white bullish, dark grey bearish.\nArctic     = ice blue bullish, navy bearish.\nDusk       = pink bullish, deep purple bearish.")
applyTheme  = input.bool(true, "Apply theme", group="Theme",
     tooltip="When enabled, the selected theme colours override the manual colour inputs.")

// ── Volume Bars ────────────────────────────────────────────────────
colorByPrev = input.bool(false, "Color based on previous close", group="Volume",
     tooltip="On: bar is bullish if close > previous close.\nOff: bar is bullish if close > open.")
markAboveMA = input.bool(true, "Highlight bars above MA", group="Volume",
     tooltip="Bars above the MA get full opacity. Bars below are dimmed.")

// ── Relative Volume (RVOL) ─────────────────────────────────────────
useRVOL = input.bool(true, "Show Relative Volume (RVOL)", group="Relative Volume",
     tooltip="When enabled, each bar shows volume relative to the slow MA (volume ÷ MA).\nAll sessions become comparable — a 1.5× Asia bar is as visible as a 1.5× NY bar.\nThe MA line becomes a flat reference at 1.0.\nDefault: off.")

// ── Slow MA ────────────────────────────────────────────────────────
maSlowLen   = input.int(20,  "Slow MA length", group="Slow MA", minval=1, maxval=500,
     tooltip="Length of the slow volume moving average (SMA).")

// ── Fast MA (EMA) ──────────────────────────────────────────────────
showFastMA  = input.bool(false, "Show Fast MA (EMA)", group="Fast MA",
     tooltip="Show a fast EMA on volume. Useful for spotting short-term volume momentum shifts.")
maFastLen   = input.int(9, "Fast MA length", group="Fast MA", minval=1, maxval=200,
     tooltip="Length of the fast volume EMA.")

// ── Volume Climax ──────────────────────────────────────────────────
showClimax      = input.bool(false, "Show volume climax", group="Volume Climax",
     tooltip="Highlights bars where volume exceeds the slow MA by the set multiplier.\nSignals unusually high activity — potential momentum or exhaustion.")
climaxMult      = input.float(2.0, "Climax threshold (× MA)", group="Volume Climax", minval=1.1, maxval=10.0, step=0.1,
     tooltip="Volume must exceed slow MA × this value to trigger a climax signal.\nDefault 2.0 = volume is at least twice the average.")
climaxLabel     = input.bool(true, "Show climax label", group="Volume Climax",
     tooltip="Show a label above the climax bar with the relative volume value (e.g. 2.4×).")

// ── Volume Dry-Up ──────────────────────────────────────────────────
showDryUp       = input.bool(false, "Show volume dry-up", group="Volume Dry-Up",
     tooltip="Highlights bars where volume falls significantly below the slow MA.\nSignals low conviction, potential consolidation or lack of interest.")
dryUpPct        = input.float(0.4, "Dry-up threshold (× MA)", group="Volume Dry-Up", minval=0.05, maxval=0.95, step=0.05,
     tooltip="Volume must be below slow MA × this value to trigger a dry-up signal.\nDefault 0.4 = volume is 40% or less of the average.")
dryUpLabel      = input.bool(true, "Show dry-up label", group="Volume Dry-Up",
     tooltip="Show a label above the dry-up bar with the relative volume value (e.g. 0.3×).")

// ── Manual Colours ─────────────────────────────────────────────────
manualUp        = input.color(color.new(color.teal, 20),  "Bullish color",        group="Colors")
manualDn        = input.color(color.new(color.red,  20),  "Bearish color",        group="Colors")
manualSlowMA    = input.color(color.new(color.blue,  0),  "Slow MA color",        group="Colors")
manualFastMA    = input.color(color.new(color.white, 20), "Fast MA color",        group="Colors")
manualClimax    = input.color(color.new(color.orange, 0), "Climax color",         group="Colors")
manualDryUp     = input.color(color.new(color.gray,  0),  "Dry-up color",         group="Colors")

// ═══════════════════════════════════════════════════════════════════
// THEME COLOUR PALETTE
// ═══════════════════════════════════════════════════════════════════
isFut  = themeChoice == "Synthwave"
isCol  = themeChoice == "Colorful"
isSun  = themeChoice == "Sunny"
isNeon = themeChoice == "Neon"
isMono = themeChoice == "Monochrome"
isArc  = themeChoice == "Arctic"
isDusk = themeChoice == "Dusk"

T_UP_RAW      = isFut ? color.rgb(0,   229, 255) : isSun ? color.rgb(255, 179, 0)   : isNeon ? color.rgb(0,   255, 136) : isMono ? color.rgb(255, 255, 255) : isArc ? color.rgb(178, 235, 242) : isDusk ? color.rgb(244, 143, 177) : color.rgb(38,  166, 154)
T_DN_RAW      = isFut ? color.rgb(255, 0,   229) : isSun ? color.rgb(191, 54,  12)  : isNeon ? color.rgb(255, 0,   85)  : isMono ? color.rgb(66,  66,  66)  : isArc ? color.rgb(1,   87,  155)  : isDusk ? color.rgb(69,  39,  160)  : color.rgb(239, 83,  80)
T_SMA_RAW     = isFut ? color.rgb(191, 0,   255) : isSun ? color.rgb(255, 230, 100) : isNeon ? color.rgb(0,   191, 255) : isMono ? color.rgb(180, 180, 180) : isArc ? color.rgb(2,   119, 189)  : isDusk ? color.rgb(149, 117, 205)  : color.rgb(100, 149, 237)
T_EMA_RAW     = isFut ? color.rgb(0,   229, 255) : isSun ? color.rgb(255, 109, 0)   : isNeon ? color.rgb(0,   255, 136) : isMono ? color.rgb(220, 220, 220) : isArc ? color.rgb(178, 235, 242)  : isDusk ? color.rgb(244, 143, 177)  : color.rgb(255, 255, 255)
T_CLIMAX_RAW  = isFut ? color.rgb(255, 230, 0)   : isSun ? color.rgb(255, 230, 0)   : isNeon ? color.rgb(255, 230, 0)   : isMono ? color.rgb(255, 255, 255) : isArc ? color.rgb(255, 230, 0)    : isDusk ? color.rgb(255, 230, 0)    : color.rgb(255, 165, 0)
T_DRYUP_RAW   = isFut ? color.rgb(120, 120, 140) : isSun ? color.rgb(140, 120, 100) : isNeon ? color.rgb(100, 120, 120) : isMono ? color.rgb(100, 100, 100) : isArc ? color.rgb(100, 130, 150)  : isDusk ? color.rgb(120, 100, 140)  : color.rgb(130, 130, 130)

// Resolved colours
rUp      = applyTheme ? T_UP_RAW     : color.r(manualUp) > 0 or color.g(manualUp) > 0 or color.b(manualUp) > 0 ? color.rgb(color.r(manualUp), color.g(manualUp), color.b(manualUp)) : T_UP_RAW
rDn      = applyTheme ? T_DN_RAW     : color.r(manualDn) > 0 or color.g(manualDn) > 0 or color.b(manualDn) > 0 ? color.rgb(color.r(manualDn), color.g(manualDn), color.b(manualDn)) : T_DN_RAW
rSlowMA  = applyTheme ? color.new(T_SMA_RAW, 0)    : manualSlowMA
rFastMA  = applyTheme ? color.new(T_EMA_RAW, 20)   : manualFastMA
rClimax  = applyTheme ? color.new(T_CLIMAX_RAW, 0) : manualClimax
rDryUp   = applyTheme ? color.new(T_DRYUP_RAW, 0)  : manualDryUp

// ═══════════════════════════════════════════════════════════════════
// CALCULATIONS
// ═══════════════════════════════════════════════════════════════════
volSMA   = ta.sma(volume, maSlowLen)
volEMA   = ta.ema(volume, maFastLen)
relVol   = volSMA > 0 ? volume / volSMA : 1.0
aboveSMA = volume >= volSMA
isBull   = colorByPrev ? close > close[1] : close >= open

// In RVOL mode: plotted value is relVol, reference line at 1.0
// In normal mode: plotted value is volume, reference line is volSMA
plotVal     = useRVOL ? relVol        : volume
slowMAVal   = useRVOL ? float(1.0)    : volSMA
fastMAVal   = useRVOL ? ta.ema(relVol, maFastLen) : volEMA

isClimax = showClimax and relVol >= climaxMult
isDryUp  = showDryUp  and relVol <= dryUpPct

// Bar colour — climax and dry-up override normal colour
opacityNormal = markAboveMA ? (aboveSMA ? 10 : 55) : 20

barCol = isClimax ? color.new(rClimax, 10) : isDryUp ? color.new(rDryUp, 30) : isBull ? color.new(T_UP_RAW, opacityNormal) : color.new(T_DN_RAW, opacityNormal)

barColManual = isClimax ? color.new(rClimax, 10) : isDryUp ? color.new(rDryUp, 30) : isBull ? color.new(color.rgb(color.r(manualUp), color.g(manualUp), color.b(manualUp)), opacityNormal) : color.new(color.rgb(color.r(manualDn), color.g(manualDn), color.b(manualDn)), opacityNormal)

finalBarCol = applyTheme ? barCol : barColManual

// ═══════════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════════
plot(plotVal,   "Volume",   color=finalBarCol, style=plot.style_columns)
plot(slowMAVal, "Slow MA",  color=rSlowMA, linewidth=2, style=plot.style_line)
plot(showFastMA ? fastMAVal : na, "Fast MA (EMA)", color=rFastMA, linewidth=1, style=plot.style_line)

// Reference line at 1.0 when RVOL is on
hline(useRVOL ? 1.0 : na, "RVOL baseline", color=color.new(color.white, 60), linestyle=hline.style_dashed, linewidth=1)

// ── Climax labels ──────────────────────────────────────────────────
if isClimax and climaxLabel and barstate.isconfirmed
    label.new(bar_index, plotVal,
         text      = str.tostring(math.round(relVol, 1)) + "×",
         style     = label.style_label_down,
         color     = color.new(color.black, 100),
         textcolor = rClimax,
         size      = size.tiny)

// ── Dry-up labels ──────────────────────────────────────────────────
if isDryUp and dryUpLabel and barstate.isconfirmed
    label.new(bar_index, plotVal,
         text      = str.tostring(math.round(relVol, 2)) + "×",
         style     = label.style_label_down,
         color     = color.new(color.black, 100),
         textcolor = rDryUp,
         size      = size.tiny)
