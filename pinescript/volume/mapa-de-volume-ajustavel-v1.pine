//@version=5
indicator("Volume Heatmap - Brasil (Ajustável)", overlay=true)

// --- 1. FUNÇÕES GLOBAIS ---
f_format_br(_t) =>
    int offset = -3 * 60 * 60 * 1000 // UTC-3 milissegundos
    int t_br = _t + offset
    string d = str.format("{0,date,dd/MM}", t_br)
    string h = str.format("{0,time,HH:mm}", t_br)
    d + " | " + h

// --- 2. CONFIGURAÇÕES DE EXIBIÇÃO ---
grp_interface = "Interface e Legenda"
showTable   = input.bool(true, "Mostrar Legenda", group=grp_interface)
showLabels  = input.bool(true, "Marcar Candles", group=grp_interface)
posTable    = input.string("Top Right", "Posição da Legenda", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=grp_interface)

// --- 3. CONFIGURAÇÕES DE CORES ---
grp_cores = "Cores dos Candles"
c_alta  = input.color(#03ff25, "Cor de Alta", group=grp_cores)
c_baixa = input.color(#f23645, "Cor de Baixa", group=grp_cores)

// --- 4. CONFIGURAÇÕES DE NÍVEIS E OPACIDADES (PERSONALIZÁVEL) ---
grp_niveis = "Ajuste de Níveis (Multiplicadores)"
mult_lv2 = input.float(2.0, "Multiplicador Nível 2 (x o mínimo)", minval=1.1, step=0.5, group=grp_niveis)
mult_lv3 = input.float(4.0, "Multiplicador Nível 3 (x o mínimo)", minval=1.1, step=0.5, group=grp_niveis)
mult_lv4 = input.float(6.0, "Multiplicador Nível 4 (x o mínimo)", minval=1.1, step=0.5, group=grp_niveis)

grp_opac = "Ajuste de Opacidades (%)"
opac_minima = input.int(5, "Opacidade Base", minval=0, maxval=100, group=grp_opac)
opac_lv2    = input.int(15, "Opacidade Nível 2", minval=0, maxval=100, group=grp_opac)
opac_lv3    = input.int(35, "Opacidade Nível 3", minval=0, maxval=100, group=grp_opac)
opac_lv4    = input.int(100, "Opacidade Nível 4", minval=0, maxval=100, group=grp_opac)

// --- 5. LÓGICA DE EXTREMOS (FECHAMENTO CONFIRMADO) ---
var float menorVolDia = na
var float maiorVolDia = na
var int dataHoraMenor = na
var int dataHoraMaior = na
var label lblMaior = na
var label lblMenor = na

isNewDay = ta.change(time("D")) != 0

if barstate.isconfirmed
    if isNewDay
        menorVolDia := volume
        maiorVolDia := volume
        dataHoraMenor := time
        dataHoraMaior := time
    else
        if volume < menorVolDia or na(menorVolDia)
            menorVolDia := volume
            dataHoraMenor := time
        if volume > maiorVolDia or na(maiorVolDia)
            maiorVolDia := volume
            dataHoraMaior := time

// --- 6. CÁLCULO DINÂMICO DOS NÍVEIS ---
volRelativo = volume / (na(menorVolDia) or menorVolDia == 0 ? 1 : menorVolDia)
ehAlta = close >= open

float opacidadeAtual = opac_minima

if volRelativo >= mult_lv4
    opacidadeAtual := opac_lv4
else if volRelativo >= mult_lv3
    opacidadeAtual := opac_lv3
else if volRelativo >= mult_lv2
    opacidadeAtual := opac_lv2
else
    opacidadeAtual := opac_minima

// --- 7. APLICAÇÃO VISUAL ---
color corFinal = color.new(ehAlta ? c_alta : c_baixa, 100 - opacidadeAtual)
barcolor(corFinal)
plotcandle(open, high, low, close, color=corFinal, wickcolor=corFinal, bordercolor=corFinal)

// --- 8. ATUALIZAÇÃO DE LABELS ---
if barstate.isconfirmed and showLabels
    label.delete(lblMaior)
    label.delete(lblMenor)
    
    int idxMaior = -1
    int idxMenor = -1
    
    for i = 0 to 500 
        if time[i] == dataHoraMaior
            idxMaior := i
        if time[i] == dataHoraMenor
            idxMenor := i
    
    if idxMaior != -1
        lblMaior := label.new(bar_index[idxMaior], high[idxMaior], "MÁX VOL", color=c_baixa, textcolor=color.white, style=label.style_label_down, size=size.small)
    if idxMenor != -1
        lblMenor := label.new(bar_index[idxMenor], low[idxMenor], "MÍN VOL", color=c_alta, textcolor=color.black, style=label.style_label_up, size=size.small)

// --- 9. TABELA (LEGEND) ---
var table mainTable = table.new(posTable == "Top Right" ? position.top_right : posTable == "Bottom Right" ? position.bottom_right : posTable == "Top Left" ? position.top_left : position.bottom_left, 2, 3, border_width=1, border_color=color.gray)

if showTable and barstate.islast
    table.cell(mainTable, 0, 0, "Extremo", bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(mainTable, 1, 0, "Data - Vol - Hora (BR)", bgcolor=color.new(color.gray, 70), text_color=color.white)
    
    table.cell(mainTable, 0, 1, "MAIOR", bgcolor=color.new(c_baixa, 30), text_color=color.white)
    table.cell(mainTable, 1, 1, f_format_br(dataHoraMaior) + " | " + str.format("{0,number,#}", maiorVolDia), bgcolor=color.black, text_color=color.white)
    
    table.cell(mainTable, 0, 2, "MENOR", bgcolor=color.new(c_alta, 30), text_color=color.white)
    table.cell(mainTable, 1, 2, f_format_br(dataHoraMenor) + " | " + str.format("{0,number,#}", menorVolDia), bgcolor=color.black, text_color=color.white)
