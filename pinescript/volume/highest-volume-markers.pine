//@version=5
indicator("Highest Volume Markers", overlay=true)

// 1. Calculations
// Highest Volume Ever
var float hve = 0.0
hve := math.max(volume, nz(hve[1]))
isHVE = (volume >= hve) and (bar_index > 0)

// Highest Volume in 1 Year (Approx 252 trading days)
hv1 = ta.highest(volume, 252)
isHV1 = volume >= hv1

// Highest Volume Since IPO (Excluding Day 1)
var float hvIPO = 0.0
isIPODay = bar_index == 0
if not isIPODay
    hvIPO := math.max(volume, nz(hvIPO[1]))
isHVIPO = not isIPODay and volume >= hvIPO

// Highest Volume Since Last Earnings (Including Earnings Day)
earnings = request.earnings(syminfo.tickerid, earnings.actual)
var float hvLE = 0.0
newEarnings = not na(earnings) and (na(earnings[1]) or earnings != earnings[1])

// If it's a new earnings day, we reset the tracker to ONLY this day's volume
// This makes the earnings day the "benchmark" to beat.
if newEarnings
    hvLE := volume 
else
    hvLE := math.max(volume, nz(hvLE[1]))

// Trigger if current volume matches the record since/on earnings day
isHVLE = volume >= hvLE and hvLE > 0

// 2. Shape Logic
// Prioritization: HVE > HV1 > HVIPO > HVLE
plotshape(isHVE, title="HVE", text="", style=shape.triangledown, location=location.abovebar, color=color.purple, size=size.small, textcolor=color.purple)
plotshape(isHV1 and not isHVE, title="HV1", text="", style=shape.triangledown, location=location.abovebar, color=color.blue, size=size.small, textcolor=color.blue)
plotshape(isHVIPO and not isHVE and not isHV1, title="HVIPO", text="", style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.small, textcolor=color.orange)
plotshape(isHVLE and not isHVE and not isHV1 and not isHVIPO, title="HVLE", text="", style=shape.triangledown, location=location.abovebar, color=color.green, size=size.small, textcolor=color.green)
