//@version=5
indicator("Mapa de Calor de Volume - Final", overlay=true)

// --- CONFIGURAÇÕES DE ENTRADA ---
periodoVol = input.int(20, "Período da Média de Volume", minval=1)
v_lv1 = input.float(1.2, "Nível 1 (1.2x - Mais Forte)", minval=1.0)
v_lv2 = input.float(2.0, "Nível 2 (2.0x - Sólido)", minval=1.0)
v_lv3 = input.float(3.0, "Nível 3 (3.0x - Sólido Escuro)", minval=1.0)
v_lv4 = input.float(4.5, "Nível 4 (4.5x - Sólido Muito Escuro)", minval=1.0)

// Cores base (Usando RGB para manipulação precisa)
cor_alta_r = input.int(8, "Vermelho (Alta)", minval=0, maxval=255)
cor_alta_g = input.int(153, "Verde (Alta)", minval=0, maxval=255)
cor_alta_b = input.int(129, "Azul (Alta)", minval=0, maxval=255)

cor_baixa_r = input.int(242, "Vermelho (Baixa)", minval=0, maxval=255)
cor_baixa_g = input.int(54, "Verde (Baixa)", minval=0, maxval=255)
cor_baixa_b = input.int(69, "Azul (Baixa)", minval=0, maxval=255)

// --- CÁLCULOS ---
volMedia = ta.sma(volume, periodoVol)
volRelativo = volume / volMedia
ehAlta = close >= open

// Definição das cores base por direção
r = ehAlta ? cor_alta_r : cor_baixa_r
g = ehAlta ? cor_alta_g : cor_baixa_g
b = ehAlta ? cor_alta_b : cor_baixa_b

// --- LÓGICA DE CORES (Saturação e Escurecimento) ---
color corFinal = na

if volRelativo >= v_lv4
    // Nível 4: Muito mais escuro (Reduzimos o RGB em 60%)
    corFinal := color.rgb(r * 0.4, g * 0.4, b * 0.4)
else if volRelativo >= v_lv3
    // Nível 3: Mais escuro (Reduzimos o RGB em 30%)
    corFinal := color.rgb(r * 0.7, g * 0.7, b * 0.7)
else if volRelativo >= v_lv2
    // Nível 2: Cor Sólida Original
    corFinal := color.rgb(r, g, b)
else if volRelativo >= v_lv1
    // Nível 1: Levemente transparente
    corFinal := color.rgb(r, g, b, 30)
else
    // Padrão: Bem transparente (Volume baixo)
    corFinal := color.rgb(r, g, b, 75)

// --- APLICAÇÃO NO GRÁFICO ---
barcolor(corFinal)

plotcandle(open, high, low, close, title="Velas de Volume", color=corFinal, wickcolor=corFinal, bordercolor=corFinal)

// --- ALERTA ---
alertcondition(volRelativo >= v_lv4, "Volume Extremo", "O volume atingiu o nível máximo de escurecimento!")
