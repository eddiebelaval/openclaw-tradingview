//@version=6
indicator("Luminous Volume Delta [Pineify]", "Luminous Volume", overlay=false)

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
grp1 = "Volume Moving Averages"
length = input.int(14, "Delta Smoothing Length", group=grp1, tooltip="Smoothes the raw volume delta to remove noise.")
sigLength = input.int(9, "Signal Line Length", group=grp1, tooltip="Generates the trailing signal line for crossovers.")

grp2 = "Surge Detection"
surgeThresh = input.float(1.618, "Volume Surge Threshold", step=0.1, group=grp2, tooltip="Multiplier of average volume to trigger a brightly colored surge bar.")

grp3 = "Aesthetics & Colors"
colorUp = input.color(#089981, "Bullish Color", group=grp3)
colorDn = input.color(#F23645, "Bearish Color", group=grp3)
colorDelta = input.color(#2962FF, "Delta Line", group=grp3)
colorSignal = input.color(#FF9800, "Signal Line", group=grp3)

//---------------------------------------------------------------------------------------------------------------------}
// Core Calculations
//---------------------------------------------------------------------------------------------------------------------{
// 1. Determine Buy and Sell Volume (Intrabar polarity estimation)
isBull = close > open
isBear = close < open

buyVol = isBull ? volume : (close == open ? volume * 0.5 : 0)
sellVol = isBear ? volume : (close == open ? volume * 0.5 : 0)

// 2. Calculate Volume Delta (Buy Volume - Sell Volume)
rawDelta = buyVol - sellVol
smoothDelta = ta.ema(rawDelta, length)
signalLine = ta.sma(smoothDelta, sigLength)

// 3. Volume Surge Detection (Highlights unusually high trading activity)
avgVol = ta.sma(volume, 50)
isSurge = volume > (avgVol * surgeThresh)

//---------------------------------------------------------------------------------------------------------------------}
// Visuals & Plotting
//---------------------------------------------------------------------------------------------------------------------{
// Zero Baseline
hline(0, "Zero Line", color=color.new(color.gray, 50), linestyle=hline.style_dashed)

// Dynamic Histogram (Bright = Surge / Faded = Normal)
histColor = rawDelta > 0 ? color.new(colorUp, isSurge ? 15 : 75) : color.new(colorDn, isSurge ? 15 : 75)
plot(rawDelta, title="Raw Volume Delta", style=plot.style_columns, color=histColor)

// Oscillator Lines
p_delta = plot(smoothDelta, title="Smoothed Delta", color=colorDelta, linewidth=2)
p_signal = plot(signalLine, title="Signal Line", color=colorSignal, linewidth=2)

// Gradient Cloud Fill between Delta and Signal lines
fillColor = smoothDelta > signalLine ? color.new(colorUp, 80) : color.new(colorDn, 80)
fill(p_delta, p_signal, color=fillColor, title="Momentum Cloud")

//---------------------------------------------------------------------------------------------------------------------}
// Trading Signals & Alerts
//---------------------------------------------------------------------------------------------------------------------{
// Buy: Delta crosses above Signal Line while in negative territory (Oversold accumulation)
buyCond = ta.crossover(smoothDelta, signalLine) and smoothDelta < 0

// Sell: Delta crosses below Signal Line while in positive territory (Overbought distribution)
sellCond = ta.crossunder(smoothDelta, signalLine) and smoothDelta > 0

// Plot Labels
// plotshape(buyCond ? signalLine : na, title="Buy Pulse", text="B", style=shape.labelup, location=location.absolute, color=colorUp, textcolor=color.white, size=size.tiny)
// plotshape(sellCond ? signalLine : na, title="Sell Pulse", text="S", style=shape.labeldown, location=location.absolute, color=colorDn, textcolor=color.white, size=size.tiny)

// Alerts
// alertcondition(buyCond, title="LVD Buy Alert", message="Luminous Volume Delta: Buy Signal Detected!")
// alertcondition(sellCond, title="LVD Sell Alert", message="Luminous Volume Delta: Sell Signal Detected!")
