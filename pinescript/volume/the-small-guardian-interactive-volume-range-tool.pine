//@version=5
indicator("the small guardian", overlay=true, max_lines_count=2, max_labels_count=1)

// =====================================================================
// 1. SELEZIONE INTERATTIVA
// =====================================================================
t1 = input.time(timestamp("2026-01-01"), "1. Clicca Prima Candela", confirm=true)
t2 = input.time(timestamp("2026-01-15"), "2. Clicca Seconda Candela", confirm=true)

// =====================================================================
// 2. LINEE VERTICALI PIÙ VISIBILI (Grosse e Arancioni)
// =====================================================================
var line l1 = line.new(na, 0, na, 1, xloc=xloc.bar_time, extend=extend.both, color=color.orange, style=line.style_solid, width=3)
var line l2 = line.new(na, 0, na, 1, xloc=xloc.bar_time, extend=extend.both, color=color.orange, style=line.style_solid, width=3)
var label lblCount = label.new(na, na, "", xloc=xloc.bar_time, color=color.orange, textcolor=color.black, style=label.style_label_down, size=size.normal)

if barstate.islast
    line.set_x1(l1, t1), line.set_x2(l1, t1)
    line.set_x1(l2, t2), line.set_x2(l2, t2)

// =====================================================================
// 3. CALCOLO VOLUME E CONTEGGIO
// =====================================================================
var float totalVolume = 0.0
var int   candleCount = 0
var float topPrice    = 0.0

if barstate.islast
    totalVolume := 0.0
    candleCount := 0
    topPrice    := 0.0
    
    startR = math.min(t1, t2)
    endR   = math.max(t1, t2)

    for i = 0 to math.min(bar_index, 4999)
        if time[i] >= startR and time[i] <= endR
            totalVolume += volume[i]
            candleCount += 1
            // Cerchiamo il punto più alto per posizionare il label
            if high[i] > topPrice
                topPrice := high[i]

    // Posiziona il label con il numero di candele sopra il range
    midTime = startR + (endR - startR) / 2
    label.set_xy(lblCount, int(midTime), topPrice)
    label.set_text(lblCount, "Candele: " + str.tostring(candleCount))

// =====================================================================
// 4. TABELLA CON VOLUME TOTALE (Font Grande)
// =====================================================================
// Usiamo size.large per rendere il volume molto leggibile
var table tab = table.new(position.bottom_right, 1, 1, bgcolor=color.new(#000000, 50), border_width=2, border_color=color.orange)

if barstate.islast
    table.clear(tab, 0, 0, 0, 0)
    string volTxt = "VOL TOT: " + str.tostring(totalVolume, format.volume)
    table.cell(tab, 0, 0, volTxt, text_color=color.white, text_size=size.large)
