//@version=6
//@version=5
indicator(title="Volume Detection NZS", shorttitle="Vol Detector NZS", overlay=true, precision=4)

// ────────────────────────────────────────────────
// Inputs
// ────────────────────────────────────────────────
volume_ma_length  = input.int(20, "Volume MA Length", minval=5, maxval=100)
volume_multiplier = input.float(1.5, "Volume Spike Multiplier", minval=1.0, maxval=5.0, step=0.1)

// ────────────────────────────────────────────────
// Volume & Pressure Calculation
// ────────────────────────────────────────────────
volume_ma    = ta.sma(volume, volume_ma_length)
volume_spike = volume > (volume_ma * volume_multiplier)

candle_range = high - low
buy_volume   = 0.0
sell_volume  = 0.0

safe_range = candle_range == 0 ? 1 : candle_range

if close > open
    buy_volume  := volume * (0.5 + 0.3 * math.min((close - open)  / safe_range, 1.0))
    sell_volume := volume - buy_volume
else if close < open
    sell_volume := volume * (0.5 + 0.3 * math.min((open - close)  / safe_range, 1.0))
    buy_volume  := volume - sell_volume
else
    buy_volume  := volume * 0.5
    sell_volume := volume * 0.5

volume_delta     = buy_volume - sell_volume
buying_pressure  = volume_delta > 0
selling_pressure = volume_delta < 0

// ────────────────────────────────────────────────
// Bar coloring (only on volume spikes)
// ────────────────────────────────────────────────
candle_color = selling_pressure ? color.rgb(17,17,17) : buying_pressure ? color.rgb(33,243,33) : color.gray
barcolor(volume_spike ? candle_color : na)

// ────────────────────────────────────────────────
// Dashboard Table ─ last bar only
// ────────────────────────────────────────────────
if barstate.islast
    var table t = table.new(position.top_right, columns=2, rows=4,
         bgcolor      = color.new(color.black, 88),
         border_width = 1,
         border_color = color.gray,
         frame_width  = 1,
         frame_color  = color.gray)

    // ─── Volume Spike ───
    table.cell(t, 0, 0, "Volume Spike", text_color=color.white, bgcolor=color.new(color.blue, 75))
    table.cell(t, 1, 0, volume_spike ? "YES" : "NO",
         text_color = color.white,
         bgcolor    = volume_spike ? color.new(color.green, 60) : color.new(color.red, 60))

    // ─── Pressure (this is the row you care about) ───
    string pressure_txt = buying_pressure ? "BUYING" : selling_pressure ? "SELLING" : "NEUTRAL"

    color label_bg = color.new(color.blue, 75)           // consistent label style like other rows

    color value_bg = buying_pressure  ? color.new(#00ff1a, 25)   // bright vivid green
                   : selling_pressure ? color.new(#ff3333,  35)   // strong red
                   :                    color.new(color.gray, 65)

    table.cell(t, 0, 1, "Pressure",   text_color=color.white, bgcolor=label_bg)
    table.cell(t, 1, 1, pressure_txt, text_color=color.white, bgcolor=value_bg)

    // ─── Buy Volume ───
    table.cell(t, 0, 2, "Buy Volume", text_color=color.white, bgcolor=color.new(color.blue, 75))
    table.cell(t, 1, 2, str.tostring(math.round(buy_volume)), text_color=color.white, bgcolor=color.new(color.blue, 75))

    // ─── Sell Volume ───
    table.cell(t, 0, 3, "Sell Volume", text_color=color.white, bgcolor=color.new(color.blue, 75))
    table.cell(t, 1, 3, str.tostring(math.round(sell_volume)), text_color=color.white, bgcolor=color.new(color.red, 60))

// ────────────────────────────────────────────────
// Alerts
// ────────────────────────────────────────────────
alertcondition(volume_spike and buying_pressure,  title="Bullish Volume Spike", message="Bullish volume spike on {{ticker}} @ {{close}}")
alertcondition(volume_spike and selling_pressure, title="Bearish Volume Spike", message="Bearish volume spike on {{ticker}} @ {{close}}")
