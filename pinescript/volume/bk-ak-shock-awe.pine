//@version=6
indicator("BK AK-Shock & Awe", shorttitle="︻╦╤─▰", overlay=false, precision=2, max_lines_count=500, max_boxes_count=500, max_labels_count=500, max_bars_back=5000)

// ============================================================================
// GROUPS - ORGANIZED BY PRIORITY
// ============================================================================
var g_cvd         = "CVD Display Settings"
var g_divergence  = "Enhanced Divergence Detection"
var g_confluence  = "🔥 Divergence Confluence System"
var g_bollinger   = "CVD Bollinger Bands (AK-9 Style)"
var g_gradient    = "Gradient Coloring (5-State)"
var g_structure   = "Structure Lines"
var g_background  = "Background Flash"
var g_styling     = "Label & Line Styling"
var g_infobox     = "📊 Strategic Info Box"
var g_smartscore  = "🤖 Smart Score System"
var g_volume_profile = "📊 CVD Volume Profile"
var g_consolidation = "🔗 Signal Consolidation"
var g_limits      = "Performance & Limits"

// ============================================================================
// RAW CVD & SCALING
// ============================================================================
i_scale_mode = input.string("Millions (M)", "Value Scaling", options=["None", "Thousands (K)", "Millions (M)"], group=g_cvd)
i_cvdLineOnTop = input.bool(false, "🎯 Bring CVD Line to Top", group=g_cvd)
i_cvdLineTransp = input.int(0, "CVD Line Transparency", minval=0, maxval=100, group=g_cvd)

// ============================================================================
// CVD HEIKIN ASHI DISPLAY (VISUAL MODE)
// ============================================================================
i_cvdDisplayMode = input.string("Line + Heikin Ashi", "CVD Display Mode",
     options=["Line","Candles","Heikin Ashi Candles","Line + Heikin Ashi"],
     group=g_cvd)

i_haCvdSmoothing = input.int(2, "HA Open Smoothing (CVD)", minval=1, maxval=100, group=g_cvd)
i_haCvdCandleTransp = input.int(0, "HA Candle Transparency (CVD)", minval=0, maxval=100, group=g_cvd)

i_cvdCandleColorMode = input.string("Direction", "Candle Color Mode",
     options=["Direction","Gradient"], group=g_cvd)

i_cvdCandleUp   = input.color(color.new(color.lime, 0), "Candle Up", group=g_cvd, inline="cvdCanCol")
i_cvdCandleDown = input.color(color.new(color.red, 0),  " ",         group=g_cvd, inline="cvdCanCol")

float divisor = switch i_scale_mode
    "Thousands (K)" => 1000.0
    "Millions (M)"  => 1000000.0
    => 1.0

vol       = nz(volume, 0.0)
isUpBar   = close > open
isDownBar = close < open
volDelta  = isUpBar ? vol : isDownBar ? -vol : 0.0
cvd_raw   = ta.cum(volDelta)
cvd_scaled = cvd_raw / divisor

// ============================================================================
// CVD MA & AUXILIARY MAs
// ============================================================================
i_cvdMaType   = input.string("WMA", "CVD MA Type", options=["SMA", "EMA", "WMA", "RMA"], group=g_cvd)
i_cvdMaLength = input.int(21, "CVD Moving Average Length", group=g_cvd)
i_cvdMaColor  = input.color(color.new(color.white, 35), "CVD MA Line Color", group=g_cvd)
i_cvdMaWidth  = input.int(1, "CVD MA Width", minval=1, maxval=4, group=g_cvd)

i_showMA2   = input.bool(false, "Show MA2 (Support/Resistance)", group=g_cvd)
i_ma2Type   = input.string("EMA", "MA2 Type", options=["SMA", "EMA", "WMA", "RMA"], group=g_cvd)
i_ma2Length = input.int(50, "MA2 Length", group=g_cvd)
i_ma2Color  = input.color(color.new(color.purple, 0), "MA2 Color", group=g_cvd)

i_showMA3   = input.bool(false, "Show MA3 (Support/Resistance)", group=g_cvd)
i_ma3Type   = input.string("EMA", "MA3 Type", options=["SMA", "EMA", "WMA", "RMA"], group=g_cvd)
i_ma3Length = input.int(100, "MA3 Length", group=g_cvd)
i_ma3Color  = input.color(color.new(color.yellow, 0), "MA3 Color", group=g_cvd)

i_showMA4   = input.bool(false, "Show MA4 (Support/Resistance)", group=g_cvd)
i_ma4Type   = input.string("SMA", "MA4 Type", options=["SMA", "EMA", "WMA", "RMA"], group=g_cvd)
i_ma4Length = input.int(200, "MA4 Length", group=g_cvd)
i_ma4Color  = input.color(color.new(color.orange, 0), "MA4 Color", group=g_cvd)

cvdMA_raw = switch i_cvdMaType
    "SMA" => ta.sma(cvd_raw, i_cvdMaLength)
    "EMA" => ta.ema(cvd_raw, i_cvdMaLength)
    "WMA" => ta.wma(cvd_raw, i_cvdMaLength)
    "RMA" => ta.rma(cvd_raw, i_cvdMaLength)
    => ta.sma(cvd_raw, i_cvdMaLength)

float ma2_raw = na
if i_showMA2
    ma2_raw := switch i_ma2Type
        "SMA" => ta.sma(cvd_raw, i_ma2Length)
        "EMA" => ta.ema(cvd_raw, i_ma2Length)
        "WMA" => ta.wma(cvd_raw, i_ma2Length)
        "RMA" => ta.rma(cvd_raw, i_ma2Length)
        => ta.ema(cvd_raw, i_ma2Length)

float ma3_raw = na
if i_showMA3
    ma3_raw := switch i_ma3Type
        "SMA" => ta.sma(cvd_raw, i_ma3Length)
        "EMA" => ta.ema(cvd_raw, i_ma3Length)
        "WMA" => ta.wma(cvd_raw, i_ma3Length)
        "RMA" => ta.rma(cvd_raw, i_ma3Length)
        => ta.ema(cvd_raw, i_ma3Length)

float ma4_raw = na
if i_showMA4
    ma4_raw := switch i_ma4Type
        "SMA" => ta.sma(cvd_raw, i_ma4Length)
        "EMA" => ta.ema(cvd_raw, i_ma4Length)
        "WMA" => ta.wma(cvd_raw, i_ma4Length)
        "RMA" => ta.rma(cvd_raw, i_ma4Length)
        => ta.sma(cvd_raw, i_ma4Length)

cvdMA_scaled = cvdMA_raw / divisor
ma2_scaled   = na(ma2_raw) ? na : ma2_raw / divisor
ma3_scaled   = na(ma3_raw) ? na : ma3_raw / divisor
ma4_scaled   = na(ma4_raw) ? na : ma4_raw / divisor

// ============================================================================
// MA5 ADVANCED (Anchored/VWCVD/PVCVD)
// ============================================================================
i_showMA5      = input.bool(false, "🚀 Show MA5 (Advanced CVD)", group=g_cvd)
i_ma5Type      = input.string("Anchored Session", "MA5 Type", options=["Anchored Session","Anchored Weekly","Volume-Weighted","Price-Volume CVD"], group=g_cvd)
i_ma5Length    = input.int(20, "MA5 Length (for Volume-Weighted)", group=g_cvd)
i_pvcvdMode    = input.string("Anchored Session", "PVCVD Reset Mode", options=["Cumulative","Anchored Session","Anchored Weekly","Rolling Window"], group=g_cvd)
i_pvcvdScaler  = input.float(0.0001, "PVCVD Scale Factor", minval=0.00001, maxval=1.0, step=0.0001, group=g_cvd)
i_ma5UseOffset = input.bool(true, "🎯 Offset MA5 to CVD Level", group=g_cvd)
i_ma5ScaleMode = input.string("Auto", "MA5 Additional Scaling", options=["Auto","Multiply x10","Multiply x100","Divide by 10","Divide by 100","None"], group=g_cvd)
i_ma5Color     = input.color(color.new(color.fuchsia, 0), "MA5 Color", group=g_cvd)
i_ma5LineWidth = input.int(2, "MA5 Line Width", minval=1, maxval=5, group=g_cvd)

isNewSession = ta.change(time("1D")) != 0
isNewWeek    = ta.change(time("1W")) != 0
isNewMonth   = ta.change(time("1M")) != 0

var float anchoredCVD_session = 0.0
var float anchoredCVD_weekly  = 0.0
var float sessionAnchorPoint  = 0.0
var float weeklyAnchorPoint   = 0.0
var float vwcvd_sum_cvd_vol   = 0.0
var float vwcvd_sum_vol       = 0.0
var float pvcvd_cumulative    = 0.0
var float pvcvd_session       = 0.0
var float pvcvd_weekly        = 0.0
var float pvcvd_sessionAnchor = 0.0
var float pvcvd_weeklyAnchor  = 0.0

if isNewSession
    anchoredCVD_session := 0.0
    sessionAnchorPoint  := cvd_raw
    pvcvd_session       := 0.0
    pvcvd_sessionAnchor := cvd_raw
anchoredCVD_session += volDelta

if isNewWeek
    anchoredCVD_weekly := 0.0
    weeklyAnchorPoint  := cvd_raw
    pvcvd_weekly       := 0.0
    pvcvd_weeklyAnchor := cvd_raw
anchoredCVD_weekly += volDelta

// Volume-Weighted CVD
vwcvd_sum_cvd_vol := 0.0
vwcvd_sum_vol     := 0.0
for i = 0 to i_ma5Length - 1
    if bar_index - i >= 0
        vwcvd_sum_cvd_vol += cvd_raw[i] * volume[i]
        vwcvd_sum_vol     += volume[i]
vwcvd_raw = vwcvd_sum_vol > 0 ? vwcvd_sum_cvd_vol / vwcvd_sum_vol : cvd_raw

// Price-Volume CVD
priceMove   = math.abs(close - open)
pvcvd_delta = priceMove * volDelta * i_pvcvdScaler
pvcvd_cumulative += pvcvd_delta
pvcvd_session    += pvcvd_delta
pvcvd_weekly     += pvcvd_delta

pvcvd_rolling = 0.0
for i = 0 to i_ma5Length - 1
    if bar_index - i >= 0
        priceMove_i = math.abs(close[i] - open[i])
        volDelta_i  = close[i] > open[i] ? volume[i] : close[i] < open[i] ? -volume[i] : 0.0
        pvcvd_rolling += priceMove_i * volDelta_i * i_pvcvdScaler

pvcvd_final = switch i_pvcvdMode
    "Cumulative"       => pvcvd_cumulative
    "Anchored Session" => pvcvd_session
    "Anchored Weekly"  => pvcvd_weekly
    "Rolling Window"   => pvcvd_rolling
    => pvcvd_session

ma5_base = switch i_ma5Type
    "Anchored Session"   => anchoredCVD_session
    "Anchored Weekly"    => anchoredCVD_weekly
    "Volume-Weighted"    => vwcvd_raw
    "Price-Volume CVD"   => pvcvd_final
    => anchoredCVD_session

float ma5_with_offset = ma5_base
if i_ma5UseOffset
    if i_ma5Type == "Anchored Session"
        ma5_with_offset := sessionAnchorPoint + anchoredCVD_session
    else if i_ma5Type == "Anchored Weekly"
        ma5_with_offset := weeklyAnchorPoint + anchoredCVD_weekly
    else if i_ma5Type == "Volume-Weighted"
        ma5_with_offset := vwcvd_raw
    else if i_ma5Type == "Price-Volume CVD"
        if i_pvcvdMode == "Anchored Session"
            ma5_with_offset := pvcvd_sessionAnchor + pvcvd_session
        else if i_pvcvdMode == "Anchored Weekly"
            ma5_with_offset := pvcvd_weeklyAnchor + pvcvd_weekly
        else if i_pvcvdMode == "Rolling Window"
            ma5_with_offset := cvd_raw + pvcvd_rolling
        else
            ma5_with_offset := cvd_raw + (pvcvd_cumulative - cvd_raw)

float ma5_multiplier = 1.0
if i_ma5ScaleMode == "Multiply x10"
    ma5_multiplier := 10.0
else if i_ma5ScaleMode == "Multiply x100"
    ma5_multiplier := 100.0
else if i_ma5ScaleMode == "Divide by 10"
    ma5_multiplier := 0.1
else if i_ma5ScaleMode == "Divide by 100"
    ma5_multiplier := 0.01

ma5_raw    = i_ma5UseOffset ? ma5_with_offset * ma5_multiplier : ma5_base * ma5_multiplier
ma5_scaled = ma5_raw / divisor

// ============================================================================
// CVD AK-9 BOLLINGER (VWAP-style CVD bands)
// ============================================================================
i_useBBLogic      = input.bool(true, "Use Bollinger Band Color Logic", group=g_bollinger)
i_showCVDBollinger = input.bool(false, "Show CVD AK-9 Style Bollinger Bands (Visual)", group=g_bollinger)
i_cvdSmoothLength  = input.int(3, "CVD Smooth Length (like %D)", group=g_bollinger)
i_cvdBBStdDev      = input.float(0.8, "CVD BB Standard Deviation", minval=0.1, maxval=3.0, group=g_bollinger)
i_cvdBBUpperColor  = input.color(color.new(color.yellow, 20), "CVD BB Upper Band Color", group=g_bollinger)
i_cvdBBLowerColor  = input.color(color.new(color.yellow, 20), "CVD BB Lower Band Color", group=g_bollinger)
i_cvdBBFillColor   = input.color(color.new(color.yellow, 78), "CVD BB Band Fill Color", group=g_bollinger)
i_cvdRedColor      = input.color(color.new(color.red, 0), "CVD Color (Below Lower Band)", group=g_bollinger)
i_cvdGreenColor    = input.color(color.new(color.lime, 0), "CVD Color (Above Upper Band)", group=g_bollinger)
i_cvdNeutralColor  = input.color(color.new(color.blue, 0), "CVD Color (Between Bands)", group=g_bollinger)

cvdSmooth_raw    = ta.sma(cvd_raw, i_cvdSmoothLength)
cvdSmooth_scaled = cvdSmooth_raw / divisor
cvdAK9_stdDev    = ta.stdev(cvd_raw, i_cvdSmoothLength)
cvdAK9BB_upper   = (cvdSmooth_raw + i_cvdBBStdDev * cvdAK9_stdDev) / divisor
cvdAK9BB_lower   = (cvdSmooth_raw - i_cvdBBStdDev * cvdAK9_stdDev) / divisor

cvd_above_upper = cvd_raw > (cvdSmooth_raw + i_cvdBBStdDev * cvdAK9_stdDev)
cvd_below_lower = cvd_raw < (cvdSmooth_raw - i_cvdBBStdDev * cvdAK9_stdDev)
cvd_in_bands    = not cvd_above_upper and not cvd_below_lower

// ============================================================================
// GRADIENT COLORING (repointed to AK-9 stats)
// ============================================================================
i_useGradient         = input.bool(true, "Enable Gradient Coloring", group=g_gradient)
i_gradientSlopePeriod = input.int(8, "Slope Calculation Period", minval=1, maxval=20, group=g_gradient)
i_gradientSensitivity = input.float(2.0, "Gradient Sensitivity", minval=0.1, maxval=2.0, group=g_gradient)

i_bullStrongColor   = input.color(color.new(color.lime, 0), "Strong Bullish", group=g_gradient)
i_bullModWeakColor  = input.color(color.new(color.green, 0), "Moderate/Weak Bullish", group=g_gradient)
i_neutralColor      = input.color(color.new(color.gray, 0), "Neutral", group=g_gradient)
i_bearModWeakColor  = input.color(color.new(color.orange, 0), "Moderate/Weak Bearish", group=g_gradient)
i_bearStrongColor   = input.color(color.new(color.red, 0), "Strong Bearish", group=g_gradient)

cvd_slope_g      = ta.change(cvd_raw, i_gradientSlopePeriod)
slope_smoothed   = ta.sma(cvd_slope_g, 3)
slope_normalized = slope_smoothed / nz(cvdAK9_stdDev * i_gradientSensitivity, 1.0)

color gradient_color = na
if slope_normalized > 2.0
    gradient_color := i_bullStrongColor
else if slope_normalized >= 0.2
    gradient_color := i_bullModWeakColor
else if slope_normalized <= -2.0
    gradient_color := i_bearStrongColor
else if slope_normalized <= -0.2
    gradient_color := i_bearModWeakColor
else
    gradient_color := i_neutralColor

cvd_bb_color    = i_useBBLogic and cvd_below_lower ? i_cvdRedColor :
                  i_useBBLogic and cvd_above_upper ? i_cvdGreenColor :
                  i_useBBLogic ? i_cvdNeutralColor : color.new(color.orange, 0)
cvd_final_color = i_useGradient ? gradient_color : cvd_bb_color

// ============================================================================
// DIVERGENCE DETECTION
// ============================================================================
i_enableDivCheck       = input.bool(false, title='Enable Regular Divergence Detection', group=g_divergence)
i_showDivLines         = input.bool(false, "Show Regular Divergence Lines", group=g_divergence)
i_showDivMarkers       = input.bool(false, "Show Regular Divergence Markers", group=g_divergence)
i_bullishDivColor      = input.color(color.new(color.lime, 0), "Regular Bullish Color", group=g_divergence)
i_bearishDivColor      = input.color(color.new(color.red, 0), "Regular Bearish Color", group=g_divergence)

i_enableHiddenDiv      = input.bool(false, title='Enable Hidden Divergence Detection', group=g_divergence)
i_showHiddenDivLines   = input.bool(false, "Show Hidden Divergence Lines", group=g_divergence)
i_showHiddenDivMarkers = input.bool(false, "Show Hidden Divergence Markers", group=g_divergence)
i_hiddenBullColor      = input.color(color.new(color.aqua, 0), "Hidden Bullish Color", group=g_divergence)
i_hiddenBearColor      = input.color(color.new(color.blue, 0), "Hidden Bearish Color", group=g_divergence)

i_enableRangeFilter = input.bool(false, "Enable Strict Range Filter", group=g_divergence)
i_divLookbackL      = input.int(5, "Divergence Left Lookback", group=g_divergence)
i_divLookbackR      = input.int(5, "Divergence Right Lookback", group=g_divergence)
i_minBarsInRange    = input.int(3, "Min Bars Between Pivots", group=g_divergence)
i_maxBarsInRange    = input.int(60, "Max Bars Between Pivots", group=g_divergence)
i_useDynamicTF      = input.bool(true, "🚀 Auto-Adjust for Futures Trading", group=g_divergence)

getTFMinutes() =>
    tf = timeframe.period
    minutes = 0
    if str.endswith(tf, "S")
        seconds = str.tonumber(str.replace(tf, "S", ""))
        minutes := math.round(seconds / 60)
    else if str.endswith(tf, "D")
        days = str.tonumber(str.replace(tf, "D", ""))
        minutes := math.round(days * 1440)
    else if str.endswith(tf, "W")
        weeks = str.tonumber(str.replace(tf, "W", ""))
        minutes := math.round(weeks * 10080)
    else if str.endswith(tf, "M")
        months = str.tonumber(str.replace(tf, "M", ""))
        minutes := math.round(months * 43200)
    else
        minutes := math.round(str.tonumber(tf))
    minutes

getDynamicSettings(tfMinutes) =>
    if tfMinutes <= 1
        [2,2,2,20]
    else if tfMinutes <= 5
        [3,3,3,30]
    else if tfMinutes <= 15
        [4,4,3,40]
    else if tfMinutes <= 60
        [5,5,3,50]
    else if tfMinutes <= 240
        [7,7,5,75]
    else if tfMinutes <= 1440
        [10,10,8,100]
    else
        [15,15,12,150]

// ============================================================================
// CVD -> OHLC + Heikin Ashi (display-only)
// ============================================================================
f_seriesOHLC(_v) =>
    float _c = _v
    float _o = nz(_v[1], _v)
    float _h = math.max(_o, _c)
    float _l = math.min(_o, _c)
    [_o, _h, _l, _c]

f_heikinAshiOHLC(_o, _h, _l, _c, _smooth) =>
    float _haClose = (_o + _h + _l + _c) / 4.0
    var float _haOpen = na
    _haOpen := na(_haOpen[_smooth]) ? (_o + _c) / 2.0 : ((_haOpen[1] * _smooth) + _haClose[1]) / (_smooth + 1.0)
    float _haHigh = math.max(_h, math.max(_haOpen, _haClose))
    float _haLow  = math.min(_l, math.min(_haOpen, _haClose))
    [_haOpen, _haHigh, _haLow, _haClose]

currentTFMinutes = getTFMinutes()
[dynamicLookbackL, dynamicLookbackR, dynamicMinRange, dynamicMaxRange] = getDynamicSettings(currentTFMinutes)

finalLookbackL = i_useDynamicTF ? dynamicLookbackL : i_divLookbackL
finalLookbackR = i_useDynamicTF ? dynamicLookbackR : i_divLookbackR
finalMinRange  = i_useDynamicTF ? dynamicMinRange  : i_minBarsInRange
finalMaxRange  = i_useDynamicTF ? dynamicMaxRange  : i_maxBarsInRange

_inRange(pivotCond) =>
    barCount = ta.barssince(pivotCond)
    i_enableRangeFilter ? (finalMinRange <= barCount and barCount <= finalMaxRange) : (barCount <= finalMaxRange)

cvdRight       = cvd_raw[finalLookbackR]
priceHighRight = high[finalLookbackR]
priceLowRight  = low[finalLookbackR]

detectEnhancedDivergence(doCheck) =>
    foundPL = not na(ta.pivotlow(cvd_raw, finalLookbackL, finalLookbackR))
    foundPH = not na(ta.pivothigh(cvd_raw, finalLookbackL, finalLookbackR))
    cvdRight_prev_L = ta.valuewhen(foundPL, cvdRight, 1)
    priceLowRight_prev_L = ta.valuewhen(foundPL, priceLowRight, 1)
    cvdRight_prev_H = ta.valuewhen(foundPH, cvdRight, 1)
    priceHighRight_prev_H = ta.valuewhen(foundPH, priceHighRight, 1)
    bullDiv = false
    bearDiv = false
    if doCheck
        bullRangeValid = _inRange(foundPL[1])
        cvdHL = cvdRight > cvdRight_prev_L and bullRangeValid
        priceLL = priceLowRight < priceLowRight_prev_L
        bullDiv := foundPL and cvdHL and priceLL

        bearRangeValid = _inRange(foundPH[1])
        cvdLH = cvdRight < cvdRight_prev_H and bearRangeValid
        priceHH = priceHighRight > priceHighRight_prev_H
        bearDiv := foundPH and cvdLH and priceHH
    [foundPL, foundPH, bullDiv, bearDiv, priceHighRight, priceLowRight]

detectHiddenDivergence(doCheck) =>
    foundPL_H = not na(ta.pivotlow(cvd_raw, finalLookbackL, finalLookbackR))
    foundPH_H = not na(ta.pivothigh(cvd_raw, finalLookbackL, finalLookbackR))
    cvdRight_prev_L_H = ta.valuewhen(foundPL_H, cvdRight, 1)
    priceLowRight_prev_L_H = ta.valuewhen(foundPL_H, priceLowRight, 1)
    cvdRight_prev_H_H = ta.valuewhen(foundPH_H, cvdRight, 1)
    priceHighRight_prev_H_H = ta.valuewhen(foundPH_H, priceHighRight, 1)
    hiddenBullDiv = false
    hiddenBearDiv = false
    if doCheck
        bullRangeValid_H = _inRange(foundPL_H[1])
        cvdLL = cvdRight < cvdRight_prev_L_H and bullRangeValid_H
        priceHL = priceLowRight > priceLowRight_prev_L_H
        hiddenBullDiv := foundPL_H and cvdLL and priceHL

        bearRangeValid_H = _inRange(foundPH_H[1])
        cvdHH = cvdRight > cvdRight_prev_H_H and bearRangeValid_H
        priceLH = priceHighRight < priceHighRight_prev_H_H
        // ✅ BUG FIX: was foundPL_H (pivot LOW) — must be foundPH_H (pivot HIGH) for bearish
        hiddenBearDiv := foundPH_H and cvdHH and priceLH
    [foundPL_H, foundPH_H, hiddenBullDiv, hiddenBearDiv, priceHighRight, priceLowRight]

// ============================================================================
// CONFLUENCE (OBV & MACD) + COUNTS
// ============================================================================
i_enableConfluence      = input.bool(true, "🔥 Enable Confluence Detection", group=g_confluence)
i_requireConfluence     = input.bool(false, "⚠️ ONLY Show Divergences with Confluence", group=g_confluence)
i_minConfluenceCount    = input.int(2, "Minimum Total Indicators Required", minval=1, maxval=3, group=g_confluence)
i_showConfluenceBadge   = input.bool(true, "Show Confluence Badge on Labels", group=g_confluence)
i_confluenceBonus       = input.int(25, "Confluence Smart Score Bonus", minval=0, maxval=50, group=g_confluence)
i_checkOBV              = input.bool(true, "Check OBV Divergences", group=g_confluence)
i_checkMACD             = input.bool(true, "Check MACD Divergences", group=g_confluence)

obv_for_confluence = ta.cum(math.sign(ta.change(close)) * volume)
[macd_line, signal_line, macd_histogram] = ta.macd(close, 12, 26, 9)

detectOBVDivergence(doCheck) =>
    foundPL_obv = not na(ta.pivotlow(obv_for_confluence, finalLookbackL, finalLookbackR))
    foundPH_obv = not na(ta.pivothigh(obv_for_confluence, finalLookbackL, finalLookbackR))
    obvRight = obv_for_confluence[finalLookbackR]
    obvRight_prev_L = ta.valuewhen(foundPL_obv, obvRight, 1)
    priceLowRight_prev_L_obv = ta.valuewhen(foundPL_obv, priceLowRight, 1)
    obvRight_prev_H = ta.valuewhen(foundPH_obv, obvRight, 1)
    priceHighRight_prev_H_obv = ta.valuewhen(foundPH_obv, priceHighRight, 1)
    bullDiv_obv = false
    bearDiv_obv = false
    hiddenBullDiv_obv = false
    hiddenBearDiv_obv = false
    if doCheck and i_checkOBV
        bullRangeValid_obv = _inRange(foundPL_obv[1])
        obvHL = obvRight > obvRight_prev_L and bullRangeValid_obv
        priceLL = priceLowRight < priceLowRight_prev_L_obv
        bullDiv_obv := foundPL_obv and obvHL and priceLL

        bearRangeValid_obv = _inRange(foundPH_obv[1])
        obvLH = obvRight < obvRight_prev_H and bearRangeValid_obv
        priceHH = priceHighRight > priceHighRight_prev_H_obv
        bearDiv_obv := foundPH_obv and obvLH and priceHH

        bullRangeValid_H_obv = _inRange(foundPL_obv[1])
        obvLL = obvRight < obvRight_prev_L and bullRangeValid_H_obv
        priceHL = priceLowRight > priceLowRight_prev_L_obv
        hiddenBullDiv_obv := foundPL_obv and obvLL and priceHL

        bearRangeValid_H_obv = _inRange(foundPH_obv[1])
        obvHH = obvRight > obvRight_prev_H and bearRangeValid_H_obv
        priceLH = priceHighRight < priceHighRight_prev_H_obv
        hiddenBearDiv_obv := foundPH_obv and obvHH and priceLH
    [bullDiv_obv, bearDiv_obv, hiddenBullDiv_obv, hiddenBearDiv_obv]

detectMACDDivergence(doCheck) =>
    foundPL_macd = not na(ta.pivotlow(macd_histogram, finalLookbackL, finalLookbackR))
    foundPH_macd = not na(ta.pivothigh(macd_histogram, finalLookbackL, finalLookbackR))
    macdRight = macd_histogram[finalLookbackR]
    macdRight_prev_L = ta.valuewhen(foundPL_macd, macdRight, 1)
    priceLowRight_prev_L_macd = ta.valuewhen(foundPL_macd, priceLowRight, 1)
    macdRight_prev_H = ta.valuewhen(foundPH_macd, macdRight, 1)
    priceHighRight_prev_H_macd = ta.valuewhen(foundPH_macd, priceHighRight, 1)
    bullDiv_macd = false
    bearDiv_macd = false
    hiddenBullDiv_macd = false
    hiddenBearDiv_macd = false
    if doCheck and i_checkMACD
        bullRangeValid_macd = _inRange(foundPL_macd[1])
        macdHL = macdRight > macdRight_prev_L and bullRangeValid_macd
        priceLL = priceLowRight < priceLowRight_prev_L_macd
        bullDiv_macd := foundPL_macd and macdHL and priceLL

        bearRangeValid_macd = _inRange(foundPH_macd[1])
        macdLH = macdRight < macdRight_prev_H and bearRangeValid_macd
        priceHH = priceHighRight > priceHighRight_prev_H_macd
        bearDiv_macd := foundPH_macd and macdLH and priceHH

        bullRangeValid_H_macd = _inRange(foundPL_macd[1])
        macdLL = macdRight < macdRight_prev_L and bullRangeValid_H_macd
        priceHL = priceLowRight > priceLowRight_prev_L_macd
        hiddenBullDiv_macd := foundPL_macd and macdLL and priceHL

        bearRangeValid_H_macd = _inRange(foundPH_macd[1])
        macdHH = macdRight > macdRight_prev_H and bearRangeValid_H_macd
        priceLH = priceHighRight < priceHighRight_prev_H_macd
        hiddenBearDiv_macd := foundPH_macd and macdHH and priceLH
    [bullDiv_macd, bearDiv_macd, hiddenBullDiv_macd, hiddenBearDiv_macd]

// Run divergence detections
[foundPL, foundPH, isBullDiv, isBearDiv, highLevel, lowLevel] = detectEnhancedDivergence(i_enableDivCheck)
[foundPL_H, foundPH_H, isHiddenBullDiv, isHiddenBearDiv, hiddenHighLevel, hiddenLowLevel] = detectHiddenDivergence(i_enableHiddenDiv)
[isBullDiv_OBV, isBearDiv_OBV, isHiddenBullDiv_OBV, isHiddenBearDiv_OBV] = detectOBVDivergence(i_enableConfluence)
[isBullDiv_MACD, isBearDiv_MACD, isHiddenBullDiv_MACD, isHiddenBearDiv_MACD] = detectMACDDivergence(i_enableConfluence)

// Confluence counts
int bullDiv_confluence = (isBullDiv ? 1 : 0) + (isBullDiv_OBV ? 1 : 0) + (isBullDiv_MACD ? 1 : 0)
int bearDiv_confluence = (isBearDiv ? 1 : 0) + (isBearDiv_OBV ? 1 : 0) + (isBearDiv_MACD ? 1 : 0)
int hiddenBullDiv_confluence = (isHiddenBullDiv ? 1 : 0) + (isHiddenBullDiv_OBV ? 1 : 0) + (isHiddenBullDiv_MACD ? 1 : 0)
int hiddenBearDiv_confluence = (isHiddenBearDiv ? 1 : 0) + (isHiddenBearDiv_OBV ? 1 : 0) + (isHiddenBearDiv_MACD ? 1 : 0)

// Display gating
bool showBullDiv = i_enableConfluence ? (bullDiv_confluence >= i_minConfluenceCount) : isBullDiv
bool showBearDiv = i_enableConfluence ? (bearDiv_confluence >= i_minConfluenceCount) : isBearDiv
bool showHiddenBullDiv = i_enableConfluence ? (hiddenBullDiv_confluence >= i_minConfluenceCount) : isHiddenBullDiv
bool showHiddenBearDiv = i_enableConfluence ? (hiddenBearDiv_confluence >= i_minConfluenceCount) : isHiddenBearDiv

if i_requireConfluence
    showBullDiv := bullDiv_confluence >= 2
    showBearDiv := bearDiv_confluence >= 2
    showHiddenBullDiv := hiddenBullDiv_confluence >= 2
    showHiddenBearDiv := hiddenBearDiv_confluence >= 2

// ============================================================================
// SIGNAL CONSOLIDATION
// ============================================================================
i_enableConsolidation     = input.bool(true, "🔗 Enable Signal Consolidation", group=g_consolidation)
i_mergeTolerance          = input.int(3, "Merge Tolerance (ticks)", minval=0, maxval=10, group=g_consolidation)
i_mergeATR                = input.float(0.05, "ATR Merge Tolerance (%)", minval=0.0, maxval=0.5, step=0.01, group=g_consolidation)
i_mergeBars               = input.int(5, "Max Bars Between Signals", minval=1, maxval=20, group=g_consolidation)
i_showConsolidationCount  = input.bool(true, "Show Consolidation Count", group=g_consolidation)
i_consolidationBadge      = input.bool(true, "Show 🔥 for Super Zones", group=g_consolidation)
i_minConsolidationForBadge= input.int(3, "Min Consolidations for 🔥", minval=2, maxval=10, group=g_consolidation)
i_superZoneThreshold      = input.int(5, "Min Consolidations for 🔥🔥", minval=3, maxval=15, group=g_consolidation)
i_consolidationBonus      = input.int(15, "Consolidation Strength Bonus", minval=0, maxval=30, group=g_consolidation)

type ConsolidatedSignal
    int type
    float cvdLevel
    int barIndex
    int count
    line divLine
    label divLabel

var array<ConsolidatedSignal> consolidatedSignals = array.new<ConsolidatedSignal>()
atr14 = ta.atr(14)

// ✅ FIX: Prune stale signals to prevent unbounded array growth
if array.size(consolidatedSignals) > 100
    while array.size(consolidatedSignals) > 50
        stale = array.shift(consolidatedSignals)
        if not na(stale.divLine)
            line.delete(stale.divLine)
        if not na(stale.divLabel)
            label.delete(stale.divLabel)

canMerge(float newLevel, int newBar, int newType) =>
    result = true
    mergeIdx = -1
    if i_enableConsolidation and array.size(consolidatedSignals) > 0
        mergeTolerance = syminfo.mintick * i_mergeTolerance + atr14 * i_mergeATR
        for i = 0 to array.size(consolidatedSignals) - 1
            sig = array.get(consolidatedSignals, i)
            levelDiff = math.abs(newLevel - sig.cvdLevel)
            barDiff = newBar - sig.barIndex
            sameType = sig.type == newType
            if sameType and levelDiff < mergeTolerance and barDiff <= i_mergeBars
                result := false
                mergeIdx := i
                break
    [result, mergeIdx]

mergeSignal(int idx, float newLevel, int newBar) =>
    if idx >= 0 and idx < array.size(consolidatedSignals)
        sig = array.get(consolidatedSignals, idx)
        sig.count += 1
        sig.cvdLevel := (sig.cvdLevel * (sig.count - 1) + newLevel) / sig.count
        sig.barIndex := newBar
        array.set(consolidatedSignals, idx, sig)
        sig.count
    else
        1

// ============================================================================
// VOLUME PROFILE
// ============================================================================
i_enableVolumeProfile  = input.bool(true, "📊 Enable CVD Volume Profile", group=g_volume_profile)
i_profileResolution    = input.int(25, "Profile Resolution (bins)", minval=10, maxval=50, group=g_volume_profile)
i_profileLength        = input.int(144, "Profile Lookback Period", minval=100, maxval=2000, group=g_volume_profile)
i_showPOC              = input.bool(true, "Show POC Line", group=g_volume_profile)
i_pocColor             = input.color(color.new(color.yellow, 0), "POC Line Color", group=g_volume_profile)
i_pocWidth             = input.int(2, "POC Line Width", minval=1, maxval=4, group=g_volume_profile)
i_showValueArea        = input.bool(true, "Show Value Area (70%)", group=g_volume_profile)
i_valueAreaColor       = input.color(color.new(color.aqua, 85), "Value Area Color", group=g_volume_profile)
i_profileUpdateFreq    = input.int(10, "Profile Update Frequency (bars)", minval=1, maxval=50, group=g_volume_profile)
i_pocProximityBonus    = input.int(15, "POC Proximity Bonus", minval=0, maxval=30, group=g_volume_profile)
i_pocProximityPct      = input.float(2.0, "POC Proximity Threshold %", minval=0.5, maxval=5.0, step=0.5, group=g_volume_profile)

var array<float> vpBins = array.new_float(i_profileResolution, 0.0)
var float vpPOC = na
var float vpVAH = na
var float vpVAL = na
var int lastProfileUpdate = -1000000

lookback = math.min(i_profileLength, bar_index + 1)
lb = math.max(1, lookback)
vpHigh = ta.highest(cvd_raw, lb)
vpLow  = ta.lowest(cvd_raw, lb)
float binSize = vpHigh > vpLow ? (vpHigh - vpLow) / math.max(1, i_profileResolution) : 0

var int vpCalculationCounter = 0
vpCalculationCounter += 1
bool shouldCalculateVP = vpCalculationCounter % i_profileUpdateFreq == 0
bool execProfile = i_enableVolumeProfile and barstate.islast and shouldCalculateVP

if execProfile
    for i = 0 to i_profileResolution - 1
        array.set(vpBins, i, 0.0)
    if binSize > 0
        cappedLookback = math.min(math.max(50, i_profileLength), 1000)
        L = math.min(lb, cappedLookback)
        for i = 0 to L - 1
            cvdVal = cvd_raw[i]
            binIdx = int((cvdVal - vpLow) / binSize)
            binIdx := math.max(0, math.min(binIdx, i_profileResolution - 1))
            currentVol = array.get(vpBins, binIdx)
            array.set(vpBins, binIdx, currentVol + math.abs(volDelta[i]))
        maxVol = 0.0
        pocIdx = 0
        for i = 0 to i_profileResolution - 1
            binVol = array.get(vpBins, i)
            if binVol > maxVol
                maxVol := binVol
                pocIdx := i
        vpPOC := vpLow + (pocIdx + 0.5) * binSize
        totalVol = 0.0
        for i = 0 to i_profileResolution - 1
            totalVol += array.get(vpBins, i)
        targetVol = totalVol * 0.70
        vaVol = array.get(vpBins, pocIdx)
        vaLower = pocIdx
        vaUpper = pocIdx
        while vaVol < targetVol and (vaLower > 0 or vaUpper < i_profileResolution - 1)
            lowerVol = vaLower > 0 ? array.get(vpBins, vaLower - 1) : 0
            upperVol = vaUpper < i_profileResolution - 1 ? array.get(vpBins, vaUpper + 1) : 0
            if lowerVol > upperVol
                vaVol += lowerVol
                vaLower -= 1
            else
                vaVol += upperVol
                vaUpper += 1
        vpVAH := vpLow + (vaUpper + 1) * binSize
        vpVAL := vpLow + vaLower * binSize
    lastProfileUpdate := bar_index

pocProximity = false
if i_enableVolumeProfile and not na(vpPOC)
    distanceToPOC = math.abs(cvd_raw - vpPOC)
    pocThreshold = math.abs(cvd_raw) * (i_pocProximityPct / 100)
    pocProximity := distanceToPOC < pocThreshold

// ============================================================================
// BACKGROUND FLASH (repointed to AK-9)
// ============================================================================
i_enableFlash         = input.bool(true, "Enable Background Flash", group=g_background)
i_useDynamicFlash     = input.bool(true, "Use Dynamic Flash Strength", group=g_background)
i_staticFlashStrength = input.int(30, "Static Flash Strength (0-100)", minval=0, maxval=100, group=g_background)
i_maxDynamicFlash     = input.int(22, "Max Dynamic Flash Strength (0-100)", minval=0, maxval=100, group=g_background)
i_flashMajorOnly      = input.bool(true, "🎯 Flash Major Turning Points Only", group=g_background)
i_flashVelocityFilter = input.float(1.5, "Flash Velocity Threshold", minval=0.5, maxval=3.0, group=g_background)
i_flashDuration       = input.int(1, "Flash Duration (bars)", minval=1, maxval=5, group=g_background)
i_flashCooldownMajor  = input.int(20, "Major Flash Cooldown (bars)", minval=5, maxval=100, group=g_background)
i_flashCooldownNormal = input.int(5, "Normal Flash Cooldown (bars)", minval=2, maxval=50, group=g_background)

distance_above_bb = cvd_raw - (cvdSmooth_raw + i_cvdBBStdDev * cvdAK9_stdDev)
distance_below_bb = (cvdSmooth_raw - i_cvdBBStdDev * cvdAK9_stdDev) - cvd_raw

dynamic_flash_intensity = cvd_above_upper ? (cvdAK9_stdDev > 0 ? math.min(distance_above_bb / cvdAK9_stdDev * i_maxDynamicFlash, i_maxDynamicFlash) : 0) :
                         cvd_below_lower ? (cvdAK9_stdDev > 0 ? math.min(distance_below_bb / cvdAK9_stdDev * i_maxDynamicFlash, i_maxDynamicFlash) : 0) :
                         na

final_flash_strength = i_useDynamicFlash ? dynamic_flash_intensity : i_staticFlashStrength

color bb_flash_color = na
if cvd_above_upper
    bb_flash_color := color.new(color.green, 100 - final_flash_strength)
else if cvd_below_lower
    bb_flash_color := color.new(color.red, 100 - final_flash_strength)
else
    bb_flash_color := na

obv = ta.cum(math.sign(ta.change(close)) * volume)
obv_slope = ta.change(obv, 14)
cvd_slope_14 = ta.change(cvd_raw, 14)
cvd_stdev_50 = ta.stdev(cvd_raw, 50)
obv_stdev_50 = ta.stdev(obv, 50)
obv_cvd_divergence_bull = cvd_slope_14 < 0 and obv_slope > 0 and math.abs(cvd_slope_14) > (cvd_stdev_50 * 0.1)
obv_cvd_divergence_bear = cvd_slope_14 > 0 and obv_slope < 0 and math.abs(obv_slope) > (obv_stdev_50 * 0.1)

[diPlus, diMinus, adx] = ta.dmi(14, 14)
adx_slope = ta.change(adx, 5)
adx_cvd_divergence_bear = cvd_slope_14 > 0 and adx_slope < -1 and adx > 20
adx_cvd_divergence_bull = cvd_slope_14 < 0 and adx_slope > 1 and adx > 20

peak_divergence = (showBearDiv or showHiddenBearDiv) and cvd_above_upper
valley_divergence = (showBullDiv or showHiddenBullDiv) and cvd_below_lower
strategic_divergence_warning = obv_cvd_divergence_bear or obv_cvd_divergence_bull or adx_cvd_divergence_bear or adx_cvd_divergence_bull

cvd_velocity = ta.change(cvd_raw, 8)
cvd_velocity_normalized = cvd_stdev_50 > 0 ? cvd_velocity / cvd_stdev_50 : 0
is_major_movement = math.abs(cvd_velocity_normalized) > i_flashVelocityFilter

bool reversal_setup = false
if i_flashMajorOnly
    reversal_setup := (peak_divergence or valley_divergence or strategic_divergence_warning) and is_major_movement
else
    reversal_setup := (peak_divergence or valley_divergence or strategic_divergence_warning)

var int last_warning_bar = -999
var int last_major_warning_bar = -999
int major_warning_cooldown = i_flashMajorOnly ? i_flashCooldownMajor : i_flashCooldownNormal
bool new_warning_detected = reversal_setup and (bar_index - last_warning_bar) > i_flashDuration

if i_flashMajorOnly
    new_warning_detected := new_warning_detected and (bar_index - last_major_warning_bar) > major_warning_cooldown

if new_warning_detected
    last_warning_bar := bar_index
    if i_flashMajorOnly and is_major_movement
        last_major_warning_bar := bar_index

int bars_since_warning = bar_index - last_warning_bar
bool bg_should_flash = bars_since_warning >= 0 and bars_since_warning < i_flashDuration

color final_background_color = na
if i_enableFlash
    if i_useBBLogic and (cvd_above_upper or cvd_below_lower) and not bg_should_flash
        final_background_color := bb_flash_color
    if bg_should_flash
        final_background_color := color.new(color.yellow, 100 - 40)

// ============================================================================
// STRUCTURE LINES
// ============================================================================
i_showStdDev1    = input.bool(false, "📊 ±1 Standard Deviation Bands", group=g_structure)
i_stdDev1Color   = input.color(color.new(color.yellow, 60), "±1 StdDev Color", group=g_structure)
i_stdDev1Width   = input.int(1, "±1 StdDev Line Width", minval=1, maxval=4, group=g_structure)

i_showStdDev2    = input.bool(false, "📊 ±2 Standard Deviation Bands", group=g_structure)
i_stdDev2Color   = input.color(color.new(color.orange, 60), "±2 StdDev Color", group=g_structure)
i_stdDev2Width   = input.int(1, "±2 StdDev Line Width", minval=1, maxval=4, group=g_structure)

i_stdDevLength   = input.int(50, "StdDev Calculation Length", group=g_structure)

cvdStdDev    = (i_showStdDev1 or i_showStdDev2) ? ta.stdev(cvd_raw, i_stdDevLength) : na
stdDev1Upper = i_showStdDev1 ? (cvdMA_raw + cvdStdDev) / divisor : na
stdDev1Lower = i_showStdDev1 ? (cvdMA_raw - cvdStdDev) / divisor : na
stdDev2Upper = i_showStdDev2 ? (cvdMA_raw + 2 * cvdStdDev) / divisor : na
stdDev2Lower = i_showStdDev2 ? (cvdMA_raw - 2 * cvdStdDev) / divisor : na

// ============================================================================
// SESSION ANCHORS + EXTENDED LINES
// ============================================================================
i_showDailySession     = input.bool(true,  "📅 Daily Session Anchor Line",  group=g_structure)
i_dailySessionColor    = input.color(color.new(color.white, 74), "Daily Session Color", group=g_structure)
i_dailySessionWidth    = input.int(2, "Daily Session Width", minval=1, maxval=4, group=g_structure)

i_showWeeklySession    = input.bool(true,  "📅 Weekly Session Anchor Line", group=g_structure)
i_weeklySessionColor   = input.color(color.new(color.navy, 74), "Weekly Session Color", group=g_structure)
i_weeklySessionWidth   = input.int(2, "Weekly Session Width", minval=1, maxval=4, group=g_structure)

i_showDailyAnchorLine  = input.bool(true,  "🎯 Extended Daily Anchor Line",  group=g_structure)
i_dailyAnchorColor     = input.color(color.white, "Daily Anchor Line Color", group=g_structure)
i_dailyAnchorWidth     = input.int(1, "Daily Anchor Line Width", minval=1, maxval=4, group=g_structure)
i_dailyAnchorTransp    = input.int(0, "Daily Anchor Line Transparency", minval=0, maxval=100, group=g_structure)

i_showWeeklyAnchorLine = input.bool(false, "🎯 Extended Weekly Anchor Line", group=g_structure)
i_weeklyAnchorColor    = input.color(color.white, "Weekly Anchor Line Color", group=g_structure)
i_weeklyAnchorWidth    = input.int(1, "Weekly Anchor Line Width", minval=1, maxval=4, group=g_structure)
i_weeklyAnchorTransp   = input.int(0, "Weekly Anchor Line Transparency", minval=0, maxval=100, group=g_structure)

var float dailySessionLevel  = na
var float weeklySessionLevel = na
var float monthlySessionLevel = na

if isNewSession
    dailySessionLevel := cvd_raw
if isNewWeek
    weeklySessionLevel := cvd_raw
if isNewMonth
    monthlySessionLevel := cvd_raw

cvd_above_daily  = cvd_raw > nz(dailySessionLevel,  cvd_raw)
cvd_below_daily  = cvd_raw < nz(dailySessionLevel,  cvd_raw)
cvd_above_weekly = cvd_raw > nz(weeklySessionLevel, cvd_raw)
cvd_below_weekly = cvd_raw < nz(weeklySessionLevel, cvd_raw)

daily_distance      = cvd_raw - nz(dailySessionLevel,  cvd_raw)
weekly_distance     = cvd_raw - nz(weeklySessionLevel, cvd_raw)
daily_distance_pct  = dailySessionLevel  != 0 ? (daily_distance  / math.abs(dailySessionLevel))  * 100 : 0
weekly_distance_pct = weeklySessionLevel != 0 ? (weekly_distance / math.abs(weeklySessionLevel)) * 100 : 0

// ============================================================================
// 🧠 INSTITUTIONAL REGIME DETECTION (NEW — feeds tooltips)
// ============================================================================
// --- Momentum Regime ---
cvd_roc_fast   = ta.roc(cvd_raw, 5)
cvd_roc_slow   = ta.roc(cvd_raw, 21)
cvd_atr_ratio  = atr14 / nz(ta.sma(atr14, 50), atr14)
cvd_slope_5    = ta.change(cvd_raw, 5)
cvd_slope_21   = ta.change(cvd_raw, 21)
slope_agreement = (cvd_slope_5 > 0 and cvd_slope_21 > 0) or (cvd_slope_5 < 0 and cvd_slope_21 < 0)

string momentum_regime = "NEUTRAL"
if slope_agreement and math.abs(slope_normalized) > 1.5
    momentum_regime := slope_normalized > 0 ? "STRONG TREND ↑" : "STRONG TREND ↓"
else if slope_agreement and math.abs(slope_normalized) > 0.5
    momentum_regime := slope_normalized > 0 ? "TREND ↑" : "TREND ↓"
else if not slope_agreement and math.abs(slope_normalized) < 0.5
    momentum_regime := "CHOPPY/RANGE"
else if not slope_agreement
    momentum_regime := "TRANSITIONING"

// --- Volume Regime ---
vol_sma20  = ta.sma(volume, 20)
vol_ratio  = vol_sma20 > 0 ? volume / vol_sma20 : 1.0
vol_slope  = ta.change(ta.sma(volume, 5), 5)

string volume_regime = "NORMAL"
if vol_ratio > 2.5
    volume_regime := "⚠️ CLIMACTIC"
else if vol_ratio > 1.5
    volume_regime := "EXPANDING"
else if vol_ratio < 0.5
    volume_regime := "DRY/THIN"
else if vol_ratio < 0.75
    volume_regime := "CONTRACTING"

// --- Trap Risk Assessment ---
// Trap = price extended + CVD diverging + at BB extreme
bool bull_trap_risk = cvd_above_upper and cvd_slope_14 > 0 and obv_slope < 0
bool bear_trap_risk = cvd_below_lower and cvd_slope_14 < 0 and obv_slope > 0
// Hoist ta.change() to global scope — must execute every bar for consistent history
float cvd_change_3 = ta.change(cvd_raw, 3)
// Enhanced trap: price making new highs but CVD not confirming with declining volume
bool exhaustion_top = cvd_above_upper and vol_ratio > 1.5 and cvd_change_3 < 0
bool exhaustion_bottom = cvd_below_lower and vol_ratio > 1.5 and cvd_change_3 > 0

string trap_warning = "NONE"
int trap_severity = 0
if bull_trap_risk and exhaustion_top
    trap_warning := "🚨 BULL TRAP — EXHAUSTION TOP"
    trap_severity := 3
else if bull_trap_risk
    trap_warning := "⚠️ BULL TRAP RISK"
    trap_severity := 2
else if bear_trap_risk and exhaustion_bottom
    trap_warning := "🚨 BEAR TRAP — EXHAUSTION BOTTOM"
    trap_severity := 3
else if bear_trap_risk
    trap_warning := "⚠️ BEAR TRAP RISK"
    trap_severity := 2
else if exhaustion_top
    trap_warning := "⚡ EXHAUSTION FORMING (TOP)"
    trap_severity := 1
else if exhaustion_bottom
    trap_warning := "⚡ EXHAUSTION FORMING (BOTTOM)"
    trap_severity := 1

// --- Institutional Flow Classification ---
// Delta conviction: are big players leaning hard?
float delta_conviction = math.abs(volDelta) / math.max(vol, 1) * 100
float avg_conviction   = ta.sma(delta_conviction, 20)
bool high_conviction   = delta_conviction > avg_conviction * 1.5

string flow_quality = "MIXED"
if high_conviction and slope_agreement
    flow_quality := isUpBar ? "INSTITUTIONAL BUYING" : "INSTITUTIONAL SELLING"
else if high_conviction and not slope_agreement
    flow_quality := "ABSORPTION/ROTATION"
else if not high_conviction and vol_ratio < 0.6
    flow_quality := "NO PARTICIPATION"

// --- Signal Priority Hierarchy ---
int priority_level = 0  // 0=nothing, 1=monitor, 2=alert, 3=action
string priority_signal = ""

if trap_severity >= 3
    priority_level := 3
    priority_signal := trap_warning
else if showBullDiv or showBearDiv
    priority_level := 3
    priority_signal := showBullDiv ? "🐂 REGULAR BULLISH DIVERGENCE" : "🐻 REGULAR BEARISH DIVERGENCE"
else if trap_severity >= 2
    priority_level := 2
    priority_signal := trap_warning
else if showHiddenBullDiv or showHiddenBearDiv
    priority_level := 2
    priority_signal := showHiddenBullDiv ? "H-🐂 HIDDEN BULL DIV" : "H-🐻 HIDDEN BEAR DIV"
else if strategic_divergence_warning
    priority_level := 2
    priority_signal := "⚡ STRATEGIC DIVERGENCE"
else if volume_regime == "⚠️ CLIMACTIC"
    priority_level := 1
    priority_signal := "⚠️ CLIMACTIC VOLUME"
else if flow_quality == "ABSORPTION/ROTATION"
    priority_level := 1
    priority_signal := "🔄 ABSORPTION DETECTED"

// ============================================================================
// SMART SCORE (references AK-9 states)
// ============================================================================
i_enableSmartScore = input.bool(true, "🤖 Enable Smart Score System", group=g_smartscore)
i_strongBuyThreshold = input.float(80, "Strong Buy Threshold", minval=0, maxval=100, step=5, group=g_smartscore)
i_buyThreshold = input.float(60, "Buy Signal Threshold", minval=0, maxval=100, step=5, group=g_smartscore)
i_sellThreshold = input.float(-60, "Sell Signal Threshold", minval=-100, maxval=0, step=5, group=g_smartscore)
i_strongSellThreshold = input.float(-80, "Strong Sell Threshold", minval=-100, maxval=0, step=5, group=g_smartscore)

i_weight_trend = input.float(8.0, "Weight: Trend State", minval=0, maxval=10, step=0.5, group=g_smartscore)
i_weight_divergence = input.float(9.0, "Weight: Regular Divergences", minval=0, maxval=10, step=0.5, group=g_smartscore)
i_weight_hidden_div = input.float(7.0, "Weight: Hidden Divergences", minval=0, maxval=10, step=0.5, group=g_smartscore)
i_weight_obv = input.float(8.5, "Weight: OBV Alignment", minval=0, maxval=10, step=0.5, group=g_smartscore)
i_weight_adx = input.float(7.5, "Weight: ADX Strength", minval=0, maxval=10, step=0.5, group=g_smartscore)
i_weight_session = input.float(6.0, "Weight: Session Position", minval=0, maxval=10, step=0.5, group=g_smartscore)
i_weight_momentum = input.float(7.0, "Weight: Momentum (ROC)", minval=0, maxval=10, step=0.5, group=g_smartscore)
i_weight_bb_position = input.float(6.5, "Weight: BB Position", minval=0, maxval=10, step=0.5, group=g_smartscore)
i_weight_atr = input.float(5.0, "Weight: ATR State", minval=0, maxval=10, step=0.5, group=g_smartscore)
i_weight_volume = input.float(6.0, "Weight: Volume Alignment", minval=0, maxval=10, step=0.5, group=g_smartscore)

cvd_above_ma1 = cvd_raw > cvdMA_raw
var int bars_above_ma1 = 0
var int bars_below_ma1 = 0
bars_above_ma1 := cvd_above_ma1 ? (bars_above_ma1 + 1) : 0
bars_below_ma1 := not cvd_above_ma1 ? (bars_below_ma1 + 1) : 0

bool ma2_ok_bull = not i_showMA2 or cvdMA_raw > ma2_raw
bool ma3_ok_bull = not i_showMA3 or (not i_showMA2 or ma2_raw > ma3_raw)
bool ma4_ok_bull = not i_showMA4 or (not i_showMA3 or ma3_raw > ma4_raw)
bool bull_stack  = cvd_raw > cvdMA_raw and ma2_ok_bull and ma3_ok_bull and ma4_ok_bull

bool ma2_ok_bear = not i_showMA2 or cvdMA_raw < ma2_raw
bool ma3_ok_bear = not i_showMA3 or (not i_showMA2 or ma2_raw < ma3_raw)
bool ma4_ok_bear = not i_showMA4 or (not i_showMA3 or ma3_raw < ma4_raw)
bool bear_stack  = cvd_raw < cvdMA_raw and ma2_ok_bear and ma3_ok_bear and ma4_ok_bear

strong_bullish = bull_stack and cvd_above_ma1 and cvd_slope_14 > 0
weak_bullish = cvd_above_ma1 and not bull_stack
strong_bearish = bear_stack and not cvd_above_ma1 and cvd_slope_14 < 0
weak_bearish = not cvd_above_ma1 and not bull_stack

adx_cvd_aligned_strong = ((cvd_slope_14 > 0 and adx_slope > 1) or (cvd_slope_14 < 0 and adx_slope < -1)) and adx > 25
obv_cvd_aligned = (cvd_slope_14 > 0 and obv_slope > 0) or (cvd_slope_14 < 0 and obv_slope < 0)

volumeMA_raw = ta.sma(volume, i_cvdMaLength)
volume_ma_slope = ta.change(volumeMA_raw, 10)
volume_cvd_divergence = (cvd_slope_14 > 0 and volume_ma_slope < -vol / 100) or (cvd_slope_14 < 0 and volume_ma_slope > vol / 100)

atr_slope = ta.change(atr14, 5)
atr_cvd_compression = math.abs(cvd_slope_14) > (cvd_stdev_50 * 0.05) and atr_slope < 0
atr_cvd_expansion = math.abs(cvd_slope_14) > (cvd_stdev_50 * 0.05) and atr_slope > 0

cvd_roc = ta.roc(cvd_raw, 14)
cvd_roc_normalized = cvd_roc / math.max(ta.stdev(cvd_roc, 50), 0.001) * 50

// --- Individual Smart Score Components (stored for tooltip breakdown) ---
float ss_trend = 0.0
float ss_div = 0.0
float ss_hdiv = 0.0
float ss_obv = 0.0
float ss_adx = 0.0
float ss_session = 0.0
float ss_momentum = 0.0
float ss_bb = 0.0
float ss_atr = 0.0
float ss_vol = 0.0

float smart_score = 0.0
if i_enableSmartScore
    float trend_score = strong_bullish ? 100 : weak_bullish ? 50 : strong_bearish ? -100 : weak_bearish ? -50 : 0
    ss_trend := (trend_score * i_weight_trend) / 10
    smart_score += ss_trend

    float div_score = showBullDiv ? 100 : showBearDiv ? -100 : 0
    ss_div := (div_score * i_weight_divergence) / 10
    smart_score += ss_div

    float hidden_div_score = showHiddenBullDiv ? 70 : showHiddenBearDiv ? -70 : 0
    ss_hdiv := (hidden_div_score * i_weight_hidden_div) / 10
    smart_score += ss_hdiv

    float obv_score = obv_cvd_divergence_bull ? 100 : obv_cvd_divergence_bear ? -100 : obv_cvd_aligned ? (cvd_slope_14 > 0 ? 40 : -40) : 0
    ss_obv := (obv_score * i_weight_obv) / 10
    smart_score += ss_obv

    float adx_score = 0.0
    if adx_cvd_divergence_bull
        adx_score := 100
    else if adx_cvd_divergence_bear
        adx_score := -100
    else if adx_cvd_aligned_strong
        adx_score := cvd_slope_14 > 0 ? 80 : -80
    else
        adx_score := adx > 25 ? (cvd_slope_14 > 0 ? 30 : -30) : 0
    ss_adx := (adx_score * i_weight_adx) / 10
    smart_score += ss_adx

    float session_score = 0.0
    float daily_strength = math.min(math.abs(daily_distance_pct) / 5, 1.0) * 100
    float weekly_strength = math.min(math.abs(weekly_distance_pct) / 10, 1.0) * 100
    if cvd_above_daily and cvd_above_weekly
        session_score := (daily_strength + weekly_strength) / 2
    else if not cvd_above_daily and not cvd_above_weekly
        session_score := -1 * (daily_strength + weekly_strength) / 2
    else
        session_score := cvd_above_daily ? daily_strength / 2 : -1 * daily_strength / 2
    ss_session := (session_score * i_weight_session) / 10
    smart_score += ss_session

    float momentum_score = math.max(-100, math.min(100, (cvd_roc_normalized * 2)))
    ss_momentum := (momentum_score * i_weight_momentum) / 10
    smart_score += ss_momentum

    float bb_score = 0.0
    if cvd_above_upper
        float distance_pct = cvdAK9_stdDev > 0 ? (distance_above_bb / cvdAK9_stdDev) * 100 : 0
        bb_score := -1 * math.min(distance_pct, 100)
    else if cvd_below_lower
        float distance_pct = cvdAK9_stdDev > 0 ? (distance_below_bb / cvdAK9_stdDev) * 100 : 0
        bb_score := math.min(distance_pct, 100)
    else
        float center_distance = cvdAK9_stdDev > 0 ? (cvd_raw - cvdSmooth_raw) / cvdAK9_stdDev : 0
        bb_score := center_distance * 30
    ss_bb := (bb_score * i_weight_bb_position) / 10
    smart_score += ss_bb

    float atr_score = atr_cvd_compression ? (cvd_slope_14 > 0 ? 50 : -50) : atr_cvd_expansion ? (cvd_slope_14 > 0 ? 30 : -30) : 0
    ss_atr := (atr_score * i_weight_atr) / 10
    smart_score += ss_atr

    float volume_score = volume_cvd_divergence ? (cvd_slope_14 > 0 ? -80 : 80) : (cvd_slope_14 > 0 ? 40 : -40)
    ss_vol := (volume_score * i_weight_volume) / 10
    smart_score += ss_vol

    float poc_bonus = pocProximity ? i_pocProximityBonus : 0
    smart_score += poc_bonus * 10

float total_max_weight = 0.0
total_max_weight += i_weight_trend + i_weight_divergence + i_weight_hidden_div + i_weight_obv + i_weight_adx + i_weight_session + i_weight_momentum + i_weight_bb_position + i_weight_atr + i_weight_volume

// ============================================================================
// INFO BOX — INSTITUTIONAL GRADE TOOLTIPS
// ============================================================================
i_showInfoBox     = input.bool(true, "Show Strategic Info Box", group=g_infobox)
i_showTooltip     = input.bool(true, "Show Detailed Tooltip", group=g_infobox)
i_infoBoxSize     = input.string("Small", "Info Box Size", options=["Tiny", "Small", "Normal", "Large"], group=g_infobox)
i_infoBoxPosition = input.string("Middle Left", "Info Box Position",
                                 options=["Top Left", "Top Right", "Middle Left", "Middle Right", "Bottom Left", "Bottom Right"], group=g_infobox)

get_infobox_position(string pos) =>
    switch pos
        "Top Left" => position.top_left
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Right" => position.bottom_right
        => position.top_right

get_infobox_size(string size) =>
    switch size
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        => size.small

// ============================================================================
// LABEL/LINE MANAGEMENT + STYLING
// ============================================================================
i_limitLastN = input.bool(true, "Show Only Last N Labels/Signals", group=g_limits)
i_lastN      = input.int(12, "N (max labels/signals kept)", minval=1, maxval=200, group=g_limits)

var label[] _lbls = array.new_label()
_enqueue_label(l) =>
    if not na(l)
        array.push(_lbls, l)
        if i_limitLastN and array.size(_lbls) > i_lastN
            lab = array.shift(_lbls)
            if not na(lab)
                label.delete(lab)

i_labelBgTransp   = input.int(0, "Label Background Transparency", minval=0, maxval=100, group=g_styling)
i_labelTextTransp = input.int(0, "Label Text/Icon Transparency", minval=0, maxval=100, group=g_styling)
i_regLineTransp   = input.int(0, "Regular Divergence Line Transparency", minval=0, maxval=100, group=g_styling)
i_hidLineTransp   = input.int(0, "Hidden Divergence Line Transparency", minval=0, maxval=100, group=g_styling)

// ============================================================================
// PLOTTING — core lines and fills
// ============================================================================
bool showLine     = (i_cvdDisplayMode == "Line") or (i_cvdDisplayMode == "Line + Heikin Ashi")
bool showCandles  = (i_cvdDisplayMode == "Candles")
bool showHACandle = (i_cvdDisplayMode == "Heikin Ashi Candles") or (i_cvdDisplayMode == "Line + Heikin Ashi")

color cvdLineCol = showLine ? color.new(cvd_final_color, i_cvdLineTransp) : color.new(cvd_final_color, 100)

// Build CVD candles from series
[cvdO, cvdH, cvdL, cvdC] = f_seriesOHLC(cvd_scaled)

// Build HA CVD candles
[haO, haH, haL, haC] = f_heikinAshiOHLC(cvdO, cvdH, cvdL, cvdC, i_haCvdSmoothing)

// Candle colors
color dirUp   = i_cvdCandleUp
color dirDown = i_cvdCandleDown

color rawBody = (cvdC >= cvdO) ? dirUp : dirDown
color haBody  = (haC  >= haO)  ? dirUp : dirDown

color rawBodyFinal = i_cvdCandleColorMode == "Gradient" ? cvd_final_color : rawBody
color haBodyFinal  = i_cvdCandleColorMode == "Gradient" ? cvd_final_color : haBody

color rawBodyDraw = rawBodyFinal
color haBodyDraw  = color.new(haBodyFinal, i_haCvdCandleTransp)

// Draw candles
plotcandle(showCandles  ? cvdO : na, showCandles  ? cvdH : na, showCandles  ? cvdL : na, showCandles  ? cvdC : na,
     title="CVD Candles", color=rawBodyDraw, wickcolor=rawBodyDraw, bordercolor=rawBodyDraw)

plotcandle(showHACandle ? haO  : na, showHACandle ? haH  : na, showHACandle ? haL  : na, showHACandle ? haC  : na,
     title="CVD Heikin Ashi Candles", color=haBodyDraw, wickcolor=haBodyDraw, bordercolor=haBodyDraw)

plot_cvdMA = plot(cvdMA_scaled, "CVD MA", i_cvdMaColor, i_cvdMaWidth)
plot(i_showMA2 ? ma2_scaled : na, "MA2", i_ma2Color, 1)
plot(i_showMA3 ? ma3_scaled : na, "MA3", i_ma3Color, 1)
// ✅ BUG FIX: MA4 was calculated but never plotted
plot(i_showMA4 ? ma4_scaled : na, "MA4", i_ma4Color, 1)
plot(i_showMA5 ? ma5_scaled : na, "MA5 (Advanced)", i_ma5Color, i_ma5LineWidth)

// AK-9 bands + fill
plot_cvdak9bb_upper = plot(i_showCVDBollinger ? cvdAK9BB_upper : na, "CVD AK-9 BB Upper", i_cvdBBUpperColor, 1)
plot_cvdak9bb_lower = plot(i_showCVDBollinger ? cvdAK9BB_lower : na, "CVD AK-9 BB Lower", i_cvdBBLowerColor, 1)
fill(plot_cvdak9bb_upper, plot_cvdak9bb_lower, color=i_showCVDBollinger ? i_cvdBBFillColor : na, title="CVD AK-9 BB Fill")

// Structure lines
plot(stdDev1Upper, "StdDev +1", i_stdDev1Color, i_stdDev1Width)
plot(stdDev1Lower, "StdDev -1", i_stdDev1Color, i_stdDev1Width)
plot(stdDev2Upper, "StdDev +2", i_stdDev2Color, i_stdDev2Width)
plot(stdDev2Lower, "StdDev -2", i_stdDev2Color, i_stdDev2Width)

// Session lines
sessionOpen_val = nz(dailySessionLevel, cvd_raw) / divisor
weeklyOpen_val  = nz(weeklySessionLevel, cvd_raw) / divisor
plot(i_showDailySession ? sessionOpen_val : na, "Daily Session Open", i_dailySessionColor, i_dailySessionWidth)
plot(i_showWeeklySession ? weeklyOpen_val  : na, "Weekly Session Open", i_weeklySessionColor, i_weeklySessionWidth)

// Extended right anchor lines
var line dailyAnchorLine  = na
var line weeklyAnchorLine = na

if i_showDailyAnchorLine
    if isNewSession
        if not na(dailyAnchorLine)
            line.delete(dailyAnchorLine)
        dailyAnchorLine := line.new(
             bar_index,        sessionOpen_val,
             bar_index + 1,    sessionOpen_val,
             xloc.bar_index,   extend.right,
             color.new(i_dailyAnchorColor, i_dailyAnchorTransp),
             line.style_solid, i_dailyAnchorWidth)
else
    if not na(dailyAnchorLine)
        line.delete(dailyAnchorLine)
        dailyAnchorLine := na

if i_showWeeklyAnchorLine
    if isNewWeek
        if not na(weeklyAnchorLine)
            line.delete(weeklyAnchorLine)
        weeklyAnchorLine := line.new(
             bar_index,        weeklyOpen_val,
             bar_index + 1,    weeklyOpen_val,
             xloc.bar_index,   extend.right,
             color.new(i_weeklyAnchorColor, i_weeklyAnchorTransp),
             line.style_solid, i_weeklyAnchorWidth)
else
    if not na(weeklyAnchorLine)
        line.delete(weeklyAnchorLine)
        weeklyAnchorLine := na

// Volume Profile POC/VA lines
var line pocLine = na
var line vahLine = na
var line valLine = na
if i_enableVolumeProfile and not na(vpPOC) and barstate.islast
    if i_showPOC
        if not na(pocLine)
            line.delete(pocLine)
        pocLine := line.new(bar_index - 10, vpPOC / divisor, bar_index + 50, vpPOC / divisor, xloc.bar_index, extend.right, i_pocColor, line.style_solid, i_pocWidth)
    if i_showValueArea
        if not na(vahLine)
            line.delete(vahLine)
        if not na(valLine)
            line.delete(valLine)
        vahLine := line.new(bar_index - 10, vpVAH / divisor, bar_index + 50, vpVAH / divisor, xloc.bar_index, extend.right, i_valueAreaColor, line.style_dashed, 1)
        valLine := line.new(bar_index - 10, vpVAL / divisor, bar_index + 50, vpVAL / divisor, xloc.bar_index, extend.right, i_valueAreaColor, line.style_dashed, 1)

// CVD line plotted AFTER candles
plot_cvd = plot(cvd_scaled, "CVD", cvdLineCol, i_cvdLineOnTop ? 2 : 1)
fill(plot_cvd, plot_cvdMA, color = cvd_scaled > cvdMA_scaled ? color.new(color.green, 80) : color.new(color.red, 80), title="CVD Trend Fill")

// === Divergence markers base Y prep
stdevScaled50 = ta.stdev(cvd_scaled, 50)
dy = stdevScaled50 > 0 ? stdevScaled50 / 5.0 : 0.000001

// ============================================================================
// 🏷️ INSTITUTIONAL DIVERGENCE LABELS WITH RICH TOOLTIPS
// ============================================================================
// Using label.new instead of plotshape to enable hover tooltips on every signal

// --- Helper: Build divergence tooltip ---
f_divTooltip(_type, _direction, _confluenceCnt, _cvdVal, _consCount) =>
    string tt = ""
    // Header
    tt += "═══════════════════════\n"
    if _type == "REG"
        tt += _direction > 0 ? "🐂 REGULAR BULLISH DIV\n" : "🐻 REGULAR BEARISH DIV\n"
    else
        tt += _direction > 0 ? "H-🐂 HIDDEN BULLISH DIV\n" : "H-🐻 HIDDEN BEARISH DIV\n"
    tt += "═══════════════════════\n\n"

    // Strength Rating
    int stars = 1
    if _confluenceCnt >= 3
        stars := 5
    else if _confluenceCnt >= 2
        stars := 4
    else if _consCount >= 3
        stars := 3
    else if _confluenceCnt >= 1
        stars := 2
    string starStr = ""
    for i = 0 to 4
        starStr += i < stars ? "★" : "☆"
    tt += "STRENGTH: " + starStr + " (" + str.tostring(stars) + "/5)\n\n"

    // What it means
    if _type == "REG" and _direction > 0
        tt += "📖 WHAT: Price made LOWER LOW\n"
        tt += "    but CVD made HIGHER LOW\n"
        tt += "    = Sellers exhausting, buyers\n"
        tt += "    absorbing at lower prices\n\n"
        tt += "🎯 EDGE: Smart money accumulating\n"
        tt += "    while weak hands panic sell.\n"
        tt += "    Watch for reclaim of prior low.\n"
    else if _type == "REG" and _direction < 0
        tt += "📖 WHAT: Price made HIGHER HIGH\n"
        tt += "    but CVD made LOWER HIGH\n"
        tt += "    = Buyers weakening, distribution\n"
        tt += "    happening into strength\n\n"
        tt += "🎯 EDGE: Institutions distributing\n"
        tt += "    while retail chases highs.\n"
        tt += "    Watch for loss of prior high.\n"
    else if _type == "HID" and _direction > 0
        tt += "📖 WHAT: Price made HIGHER LOW\n"
        tt += "    but CVD made LOWER LOW\n"
        tt += "    = Trend continuation signal.\n"
        tt += "    Healthy pullback absorbed.\n\n"
        tt += "🎯 EDGE: Trend intact despite\n"
        tt += "    CVD weakness — dip buyers\n"
        tt += "    still in control.\n"
    else
        tt += "📖 WHAT: Price made LOWER HIGH\n"
        tt += "    but CVD made HIGHER HIGH\n"
        tt += "    = Downtrend continuation.\n"
        tt += "    Rally sold into aggressively.\n\n"
        tt += "🎯 EDGE: Sellers still dominant\n"
        tt += "    despite CVD bounce — dead\n"
        tt += "    cat bounce likely.\n"
    tt += "\n"

    // Confluence breakdown
    tt += "🔥 CONFLUENCE: " + str.tostring(_confluenceCnt) + "/3 indicators\n"
    tt += "    CVD: " + (_type == "REG" ? (_direction > 0 ? (isBullDiv ? "✅" : "❌") : (isBearDiv ? "✅" : "❌")) : (_direction > 0 ? (isHiddenBullDiv ? "✅" : "❌") : (isHiddenBearDiv ? "✅" : "❌"))) + "\n"
    tt += "    OBV: " + (_direction > 0 ? (isBullDiv_OBV or isHiddenBullDiv_OBV ? "✅" : "❌") : (isBearDiv_OBV or isHiddenBearDiv_OBV ? "✅" : "❌")) + "\n"
    tt += "    MACD: " + (_direction > 0 ? (isBullDiv_MACD or isHiddenBullDiv_MACD ? "✅" : "❌") : (isBearDiv_MACD or isHiddenBearDiv_MACD ? "✅" : "❌")) + "\n\n"

    // Consolidation
    if _consCount > 1
        tt += "🔗 CONSOLIDATION: x" + str.tostring(_consCount) + " signals merged\n"
        if _consCount >= 5
            tt += "    🔥🔥 SUPER ZONE — HIGH CONVICTION\n"
        else if _consCount >= 3
            tt += "    🔥 STRONG ZONE\n"
        tt += "\n"

    // Context
    tt += "📊 CONTEXT\n"
    tt += "  CVD: " + str.tostring(math.round(_cvdVal)) + "\n"
    tt += "  BB: " + (cvd_above_upper ? "⚠️ OVERBOUGHT" : cvd_below_lower ? "⚠️ OVERSOLD" : "NEUTRAL") + "\n"
    tt += "  Vol: " + volume_regime + "\n"
    tt += "  Flow: " + flow_quality + "\n"
    tt += "  Regime: " + momentum_regime + "\n\n"

    // Action guidance
    tt += "═══════════════════════\n"
    if stars >= 4
        tt += "⚡ HIGH PROBABILITY SETUP\n"
        tt += _direction > 0 ? "  Look for LONG entries on\n  pullback or reclaim\n" : "  Look for SHORT entries on\n  bounce or breakdown\n"
    else if stars >= 3
        tt += "📍 MODERATE SETUP\n"
        tt += "  Wait for price confirmation\n"
        tt += "  before committing size\n"
    else
        tt += "👁️ MONITOR — LOW CONVICTION\n"
        tt += "  Needs more confluence\n"
        tt += "  or consolidation to act on\n"
    tt += "═══════════════════════"
    tt

// --- Draw Divergence Labels with Tooltips ---
if i_showDivMarkers and showBullDiv
    [canCreateB, mergeIdxB] = canMerge(cvdRight, bar_index - finalLookbackR, 1)
    consolidationCountB = canCreateB ? 1 : mergeSignal(mergeIdxB, cvdRight, bar_index - finalLookbackR)
    bool bullHasCons  = i_consolidationBadge and consolidationCountB >= i_minConsolidationForBadge
    bool bullHasConf  = i_showConfluenceBadge and i_enableConfluence and bullDiv_confluence >= 2
    bool bullDoBadge  = bullHasCons or bullHasConf
    string bullIcon = bullDoBadge ? "🔥🐂" : "🐂"
    string bullTT = f_divTooltip("REG", 1, bullDiv_confluence, cvd_raw, consolidationCountB)
    _enqueue_label(label.new(bar_index - finalLookbackR, cvd_scaled + dy, bullIcon,
         xloc.bar_index, yloc.price, color.new(i_bullishDivColor, i_labelBgTransp),
         label.style_label_up, color.new(color.white, i_labelTextTransp), size.tiny, text_font_family=font.family_default, tooltip=bullTT))

if i_showDivMarkers and showBearDiv
    [canCreateS, mergeIdxS] = canMerge(cvdRight, bar_index - finalLookbackR, -1)
    consolidationCountS = canCreateS ? 1 : mergeSignal(mergeIdxS, cvdRight, bar_index - finalLookbackR)
    bool bearHasCons  = i_consolidationBadge and consolidationCountS >= i_minConsolidationForBadge
    bool bearHasConf  = i_showConfluenceBadge and i_enableConfluence and bearDiv_confluence >= 2
    bool bearDoBadge  = bearHasCons or bearHasConf
    string bearIcon = bearDoBadge ? "🔥🐻" : "🐻"
    string bearTT = f_divTooltip("REG", -1, bearDiv_confluence, cvd_raw, consolidationCountS)
    _enqueue_label(label.new(bar_index - finalLookbackR, cvd_scaled - dy, bearIcon,
         xloc.bar_index, yloc.price, color.new(i_bearishDivColor, i_labelBgTransp),
         label.style_label_down, color.new(color.white, i_labelTextTransp), size.tiny, text_font_family=font.family_default, tooltip=bearTT))

if i_showHiddenDivMarkers and showHiddenBullDiv
    bool hBullBadge = i_showConfluenceBadge and i_enableConfluence and hiddenBullDiv_confluence >= 2
    string hBullIcon = hBullBadge ? "⚡🐂" : "H-🐂"
    string hBullTT = f_divTooltip("HID", 1, hiddenBullDiv_confluence, cvd_raw, 1)
    _enqueue_label(label.new(bar_index - finalLookbackR, cvd_scaled + dy, hBullIcon,
         xloc.bar_index, yloc.price, color.new(i_hiddenBullColor, i_labelBgTransp),
         label.style_label_up, color.new(color.white, i_labelTextTransp), size.tiny, text_font_family=font.family_default, tooltip=hBullTT))

if i_showHiddenDivMarkers and showHiddenBearDiv
    bool hBearBadge = i_showConfluenceBadge and i_enableConfluence and hiddenBearDiv_confluence >= 2
    string hBearIcon = hBearBadge ? "⚡🐻" : "H-🐻"
    string hBearTT = f_divTooltip("HID", -1, hiddenBearDiv_confluence, cvd_raw, 1)
    _enqueue_label(label.new(bar_index - finalLookbackR, cvd_scaled - dy, hBearIcon,
         xloc.bar_index, yloc.price, color.new(i_hiddenBearColor, i_labelBgTransp),
         label.style_label_down, color.new(color.white, i_labelTextTransp), size.tiny, text_font_family=font.family_default, tooltip=hBearTT))

// Divergence Lines
if i_showDivLines
    if showBearDiv
        line.new(bar_index - finalLookbackR, cvdRight / divisor, bar_index, cvd_raw / divisor, xloc.bar_index, extend.none, color.new(i_bearishDivColor, i_regLineTransp), line.style_solid, 2)
    if showBullDiv
        line.new(bar_index - finalLookbackR, cvdRight / divisor, bar_index, cvd_raw / divisor, xloc.bar_index, extend.none, color.new(i_bullishDivColor, i_regLineTransp), line.style_solid, 2)

if i_showHiddenDivLines
    if showHiddenBearDiv
        line.new(bar_index - finalLookbackR, cvdRight / divisor, bar_index, cvd_raw / divisor, xloc.bar_index, extend.none, color.new(i_hiddenBearColor, i_hidLineTransp), line.style_dashed, 2)
    if showHiddenBullDiv
        line.new(bar_index - finalLookbackR, cvdRight / divisor, bar_index, cvd_raw / divisor, xloc.bar_index, extend.none, color.new(i_hiddenBullColor, i_hidLineTransp), line.style_dashed, 2)

// Background
bgcolor(final_background_color, title="Strategic Background")

// ============================================================================
// 📊 INSTITUTIONAL INFO BOX — COMPLETE REWRITE
// ============================================================================
if i_showInfoBox and barstate.islast
    // === Compact Label Text (what you see at a glance) ===
    string trendIcon = strong_bullish ? "🚀" : weak_bullish ? "⬆️" : strong_bearish ? "📉" : weak_bearish ? "⬇️" : "➡️"
    string sessionIcon = cvd_above_daily ? "🟢" : "🔴"
    string pocIcon = pocProximity ? "🎯" : ""
    string rocIcon = cvd_roc_normalized > 30 ? "⚡🟢" : cvd_roc_normalized > 0 ? "⚡⚪" : cvd_roc_normalized > -30 ? "⚡🟠" : "⚡🔴"
    string labelText = trendIcon + " " + sessionIcon
    if str.length(pocIcon) > 0
        labelText += " " + pocIcon
    labelText += " " + rocIcon

    if i_enableSmartScore
        string scoreIcon = smart_score >= i_strongBuyThreshold ? "💚" : smart_score >= i_buyThreshold ? "🟢" :
                          smart_score <= i_strongSellThreshold ? "💔" : smart_score <= i_sellThreshold ? "🔴" :
                          smart_score > 0 ? "🟡" : smart_score < 0 ? "🟠" : "⚪"
        labelText += " | " + scoreIcon + str.tostring(math.round(smart_score))
    string biasD = cvd_above_daily ? "D+" : "D-"
    string biasW = cvd_above_weekly ? "W+" : "W-"
    labelText += " | " + biasD + " " + biasW

    // === INSTITUTIONAL TOOLTIP ===
    string tooltip = ""
    if i_showTooltip
        // ─── SECTION 1: PRIORITY ALERT (only if active) ───
        if priority_level >= 2
            tooltip += "╔═══════════════════════════╗\n"
            if priority_level >= 3
                tooltip += "║  🚨 ACTION REQUIRED       ║\n"
            else
                tooltip += "║  ⚠️  ALERT ACTIVE          ║\n"
            tooltip += "╠═══════════════════════════╣\n"
            tooltip += "║  " + priority_signal + "\n"
            if trap_severity >= 2
                tooltip += "║\n"
                tooltip += "║  🪤 TRAP ANALYSIS:\n"
                if bull_trap_risk
                    tooltip += "║  CVD extended + OBV diverging\n"
                    tooltip += "║  Institutions may be selling\n"
                    tooltip += "║  into this strength.\n"
                    tooltip += "║  ➜ Tighten stops / reduce size\n"
                if bear_trap_risk
                    tooltip += "║  CVD dumping but OBV holding\n"
                    tooltip += "║  Possible stop hunt below.\n"
                    tooltip += "║  ➜ Watch for sharp V-reversal\n"
                if exhaustion_top or exhaustion_bottom
                    tooltip += "║  🔋 Volume surging at extreme\n"
                    tooltip += "║  = Classic exhaustion pattern\n"
            tooltip += "╚═══════════════════════════╝\n\n"
        else if priority_level == 1
            tooltip += "┌─── 👁️ MONITORING ─────────┐\n"
            tooltip += "│ " + priority_signal + "\n"
            tooltip += "└───────────────────────────┘\n\n"

        // ─── SECTION 2: REGIME DASHBOARD ───
        tooltip += "┌─── 🧠 MARKET REGIME ──────┐\n"
        tooltip += "│ Momentum: " + momentum_regime + "\n"
        tooltip += "│ Volume:   " + volume_regime
        if vol_ratio > 0
            tooltip += " (" + str.tostring(math.round(vol_ratio * 100)) + "% avg)"
        tooltip += "\n"
        tooltip += "│ Flow:     " + flow_quality + "\n"
        tooltip += "│ ADX:      " + str.tostring(math.round(adx, 1))
        if adx > 40
            tooltip += " ⚡ STRONG TREND"
        else if adx > 25
            tooltip += " ↗ TRENDING"
        else if adx > 15
            tooltip += " ↔ WEAK/RANGE"
        else
            tooltip += " 💤 NO TREND"
        tooltip += "\n"
        tooltip += "│ ATR:      "
        if cvd_atr_ratio > 1.3
            tooltip += "EXPANDING ↑"
        else if cvd_atr_ratio < 0.7
            tooltip += "COMPRESSED ↓"
        else
            tooltip += "NORMAL"
        tooltip += " (" + str.tostring(math.round(cvd_atr_ratio * 100)) + "%)\n"
        tooltip += "└───────────────────────────┘\n\n"

        // ─── SECTION 3: CVD CORE METRICS ───
        tooltip += "┌─── 📊 CVD METRICS ────────┐\n"
        tooltip += "│ Value: " + str.tostring(cvd_scaled, format.volume) + "\n"
        tooltip += "│ MA" + str.tostring(i_cvdMaLength) + ":  " + (cvd_above_ma1 ? "▲ Above" : "▼ Below") + " (" + str.tostring(cvd_above_ma1 ? bars_above_ma1 : bars_below_ma1) + " bars)\n"
        tooltip += "│ Slope: " + (slope_normalized > 2 ? "⬆⬆ STRONG UP" : slope_normalized > 0.5 ? "⬆ UP" : slope_normalized < -2 ? "⬇⬇ STRONG DOWN" : slope_normalized < -0.5 ? "⬇ DOWN" : "↔ FLAT") + "\n"
        tooltip += "│ ROC(14): " + str.tostring(math.round(cvd_roc, 1)) + "%\n"
        tooltip += "│ Stack:  " + (bull_stack ? "🚀 BULL ALIGNED" : bear_stack ? "📉 BEAR ALIGNED" : "⚠️ MIXED") + "\n"
        tooltip += "│ BB:     "
        if cvd_above_upper
            float bb_ext = cvdAK9_stdDev > 0 ? distance_above_bb / cvdAK9_stdDev : 0
            tooltip += "🔴 OVERBOUGHT (" + str.tostring(math.round(bb_ext, 1)) + "σ)\n"
            if bb_ext > 2
                tooltip += "│         ⚠️ EXTREME — mean revert likely\n"
        else if cvd_below_lower
            float bb_ext = cvdAK9_stdDev > 0 ? distance_below_bb / cvdAK9_stdDev : 0
            tooltip += "🟢 OVERSOLD (" + str.tostring(math.round(bb_ext, 1)) + "σ)\n"
            if bb_ext > 2
                tooltip += "│         ⚠️ EXTREME — bounce likely\n"
        else
            tooltip += "⚪ IN BANDS (neutral)\n"
        tooltip += "└───────────────────────────┘\n\n"

        // ─── SECTION 4: VOLUME PROFILE ───
        if i_enableVolumeProfile and not na(vpPOC)
            tooltip += "┌─── 📈 VOLUME PROFILE ─────┐\n"
            tooltip += "│ POC:  " + str.tostring(vpPOC / divisor, format.volume) + "\n"
            if pocProximity
                tooltip += "│ ➜ 🎯 AT POC — High volume node\n"
                tooltip += "│   Expect SUPPORT/RESISTANCE\n"
                tooltip += "│   and potential reversal here.\n"
            else if not na(vpVAH) and cvd_raw > vpVAH
                float vahDist = math.abs(cvd_raw - vpVAH) / math.max(math.abs(vpVAH), 1) * 100
                tooltip += "│ ➜ ABOVE Value Area (" + str.tostring(math.round(vahDist, 1)) + "% away)\n"
                tooltip += "│   Breakout territory — if vol\n"
                tooltip += "│   supports, trend continues.\n"
            else if not na(vpVAL) and cvd_raw < vpVAL
                float valDist = math.abs(cvd_raw - vpVAL) / math.max(math.abs(vpVAL), 1) * 100
                tooltip += "│ ➜ BELOW Value Area (" + str.tostring(math.round(valDist, 1)) + "% away)\n"
                tooltip += "│   Breakdown zone — watch for\n"
                tooltip += "│   failed auction / reclaim.\n"
            else
                tooltip += "│ ➜ IN Value Area (fair value)\n"
                tooltip += "│   Range-bound behavior likely.\n"
            tooltip += "│ VAH: " + str.tostring(nz(vpVAH, 0) / divisor, format.volume) + "\n"
            tooltip += "│ VAL: " + str.tostring(nz(vpVAL, 0) / divisor, format.volume) + "\n"
            tooltip += "└───────────────────────────┘\n\n"

        // ─── SECTION 5: SESSION BIAS ───
        tooltip += "┌─── 📅 SESSION POSITION ───┐\n"
        tooltip += "│ Daily:  " + (cvd_above_daily ? "▲" : "▼") + " " + str.tostring(math.round(math.abs(daily_distance_pct), 1)) + "% from open\n"
        tooltip += "│ Weekly: " + (cvd_above_weekly ? "▲" : "▼") + " " + str.tostring(math.round(math.abs(weekly_distance_pct), 1)) + "% from open\n"
        // Bias alignment
        if cvd_above_daily and cvd_above_weekly
            tooltip += "│ ➜ 🟢 BOTH BULLISH — aligned\n"
            tooltip += "│   Favor longs, buy dips\n"
        else if not cvd_above_daily and not cvd_above_weekly
            tooltip += "│ ➜ 🔴 BOTH BEARISH — aligned\n"
            tooltip += "│   Favor shorts, sell rips\n"
        else
            tooltip += "│ ➜ 🟡 MIXED — D/W disagree\n"
            tooltip += "│   Reduce size, wait for align\n"
        tooltip += "└───────────────────────────┘\n\n"

        // ─── SECTION 6: SMART SCORE BREAKDOWN ───
        if i_enableSmartScore
            tooltip += "┌─── 🤖 SMART SCORE ────────┐\n"
            string signalStr = smart_score >= i_strongBuyThreshold ? "💚 STRONG BUY" : smart_score >= i_buyThreshold ? "🟢 BUY" :
                              smart_score <= i_strongSellThreshold ? "💔 STRONG SELL" : smart_score <= i_sellThreshold ? "🔴 SELL" :
                              smart_score > 20 ? "🟡 LEAN BULL" : smart_score < -20 ? "🟠 LEAN BEAR" : "⚪ NEUTRAL"
            tooltip += "│ TOTAL: " + str.tostring(math.round(smart_score)) + " → " + signalStr + "\n"
            tooltip += "│\n"
            tooltip += "│ Component Breakdown:\n"
            // Show each component with bar visualization
            tooltip += "│  Trend:    " + (ss_trend >= 0 ? "+" : "") + str.tostring(math.round(ss_trend, 1))
            tooltip += ss_trend > 50 ? " ████" : ss_trend > 20 ? " ██" : ss_trend > 0 ? " █" : ss_trend > -20 ? " ▌" : ss_trend > -50 ? " ░░" : " ░░░░"
            tooltip += "\n"
            tooltip += "│  Div:      " + (ss_div >= 0 ? "+" : "") + str.tostring(math.round(ss_div, 1))
            if ss_div != 0
                tooltip += " ⚡ ACTIVE"
            tooltip += "\n"
            tooltip += "│  H.Div:    " + (ss_hdiv >= 0 ? "+" : "") + str.tostring(math.round(ss_hdiv, 1))
            if ss_hdiv != 0
                tooltip += " ⚡ ACTIVE"
            tooltip += "\n"
            tooltip += "│  OBV:      " + (ss_obv >= 0 ? "+" : "") + str.tostring(math.round(ss_obv, 1))
            tooltip += ss_obv > 30 ? " 🟢" : ss_obv < -30 ? " 🔴" : " ⚪"
            tooltip += "\n"
            tooltip += "│  ADX:      " + (ss_adx >= 0 ? "+" : "") + str.tostring(math.round(ss_adx, 1))
            tooltip += ss_adx > 30 ? " 🟢" : ss_adx < -30 ? " 🔴" : " ⚪"
            tooltip += "\n"
            tooltip += "│  Session:  " + (ss_session >= 0 ? "+" : "") + str.tostring(math.round(ss_session, 1))
            tooltip += "\n"
            tooltip += "│  Momentum: " + (ss_momentum >= 0 ? "+" : "") + str.tostring(math.round(ss_momentum, 1))
            tooltip += ss_momentum > 30 ? " 🟢" : ss_momentum < -30 ? " 🔴" : " ⚪"
            tooltip += "\n"
            tooltip += "│  BB Pos:   " + (ss_bb >= 0 ? "+" : "") + str.tostring(math.round(ss_bb, 1))
            tooltip += "\n"
            tooltip += "│  ATR:      " + (ss_atr >= 0 ? "+" : "") + str.tostring(math.round(ss_atr, 1))
            tooltip += "\n"
            tooltip += "│  Volume:   " + (ss_vol >= 0 ? "+" : "") + str.tostring(math.round(ss_vol, 1))
            tooltip += ss_vol > 20 ? " 🟢" : ss_vol < -20 ? " 🔴" : " ⚪"
            tooltip += "\n"
            if pocProximity
                tooltip += "│  POC:      +" + str.tostring(i_pocProximityBonus * 10) + " 🎯\n"
            tooltip += "└───────────────────────────┘\n\n"

        // ─── SECTION 7: WHAT TO WATCH ───
        tooltip += "┌─── 👁️ KEY LEVELS TO WATCH ─┐\n"
        tooltip += "│ Daily Open:  " + str.tostring(sessionOpen_val, format.volume) + "\n"
        tooltip += "│ Weekly Open: " + str.tostring(weeklyOpen_val, format.volume) + "\n"
        if i_enableVolumeProfile and not na(vpPOC)
            tooltip += "│ CVD POC:     " + str.tostring(vpPOC / divisor, format.volume) + "\n"
        tooltip += "│ CVD MA:      " + str.tostring(cvdMA_scaled, format.volume) + "\n"
        tooltip += "└───────────────────────────┘\n"

        // ─── SECTION 8: TACTICAL GUIDANCE ───
        tooltip += "\n┌─── ⚔️ TACTICAL GUIDANCE ──┐\n"
        if smart_score >= i_strongBuyThreshold and cvd_above_daily and cvd_above_weekly
            tooltip += "│ Full size LONGS appropriate\n"
            tooltip += "│ Buy pullbacks to MA/session\n"
        else if smart_score >= i_buyThreshold
            tooltip += "│ Lean LONG with reduced size\n"
            tooltip += "│ Wait for pullback to add\n"
        else if smart_score <= i_strongSellThreshold and not cvd_above_daily and not cvd_above_weekly
            tooltip += "│ Full size SHORTS appropriate\n"
            tooltip += "│ Sell rips to MA/session\n"
        else if smart_score <= i_sellThreshold
            tooltip += "│ Lean SHORT with reduced size\n"
            tooltip += "│ Wait for bounce to add\n"
        else if momentum_regime == "CHOPPY/RANGE"
            tooltip += "│ ⚠️ CHOP ZONE — reduce size\n"
            tooltip += "│ Fade extremes, scalp only\n"
        else
            tooltip += "│ NEUTRAL — no clear edge\n"
            tooltip += "│ Patience. Wait for setup.\n"

        if trap_severity >= 2
            tooltip += "│\n│ 🪤 TRAP RISK ELEVATED\n"
            tooltip += "│ ➜ Use protective stops\n"
            tooltip += "│ ➜ Reduce position size\n"
        tooltip += "└───────────────────────────┘"

    // === Render Info Box ===
    var table infoTable = table.new(get_infobox_position(i_infoBoxPosition), 1, 1, border_width=1)
    table.clear(infoTable, 0, 0)
    bool box_should_flash = bars_since_warning >= 0 and bars_since_warning < i_flashDuration

    // Dynamic box color based on priority
    color bgColor = color.new(color.gray, 60)
    if box_should_flash
        bgColor := color.new(color.yellow, 60)
    else if priority_level >= 3
        bgColor := color.new(color.red, 70)
    else if priority_level >= 2
        bgColor := color.new(color.orange, 70)

    table.cell(infoTable, 0, 0, labelText, bgcolor=bgColor, text_color=color.white,
              text_size=get_infobox_size(i_infoBoxSize), tooltip=i_showTooltip ? tooltip : na)
