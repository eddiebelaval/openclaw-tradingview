//@version=5
indicator("Mapa de Calor de Volume - Customização de Opacidade", overlay=true)

// --- CONFIGURAÇÕES DE CORES ---
grp_cores = "Configurações de Cores"
c_alta  = input.color(#03ff25, "Cor de Alta", group=grp_cores)
c_baixa = input.color(#f23645, "Cor de Baixa", group=grp_cores)

// --- CONFIGURAÇÕES DE OPACIDADE (0 a 100) ---
grp_opac = "Graus de Opacidade (%)"
opac_padrao = input.int(25, "Opacidade Padrão (Volume Baixo)", minval=0, maxval=100, group=grp_opac)
opac_lv3    = input.int(50, "Opacidade Nível 3 (Volume 2x)", minval=0, maxval=100, group=grp_opac)
opac_lv4    = input.int(100, "Opacidade Nível 4 (Volume 3x)", minval=0, maxval=100, group=grp_opac)

// --- CONFIGURAÇÕES DE VOLUME ---
periodoVol = input.int(20, "Período da Média de Volume", minval=1)

// --- CÁLCULOS ---
volMedia = ta.sma(volume, periodoVol)
volRelativo = volume / volMedia
ehAlta = close >= open

// --- LÓGICA DE CONVERSÃO (Opacidade para Transparência) ---
// O Pine Script usa transparência (0 = sólido, 100 = invisível)
// Calculamos: Transparência = 100 - Opacidade
float trans_final = 0.0

if volRelativo >= 3.0
    trans_final := 100 - opac_lv4
else if volRelativo >= 2.0
    trans_final := 100 - opac_lv3
else
    trans_final := 100 - opac_padrao

// --- DEFINIÇÃO DA COR FINAL ---
color corFinal = color.new(ehAlta ? c_alta : c_baixa, trans_final)

// --- APLICAÇÃO NO GRÁFICO ---
barcolor(corFinal)
plotcandle(open, high, low, close, title="Velas de Volume", color=corFinal, wickcolor=corFinal, bordercolor=corFinal)

// --- ALERTAS ---
alertcondition(volRelativo >= 3.0, "Volume Crítico", "O volume atingiu o nível máximo de opacidade configurado!")
