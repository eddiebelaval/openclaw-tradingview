//@version=5
indicator("Projected Vol · Double Line", shorttitle="Proj. Vol Double", overlay=false, precision=0, format=format.volume)

// --- Inputs: Logik ---
periodo = input.int(20, "Period (EMA)", group="Logik")
fator   = input.float(1.25, "Faktor für High Vol (1.25)", minval=0.0, group="Logik")
showProjected = input.bool(true, "Projektions-Schatten anzeigen?", group="Visuals")
projTransparency = input.int(70, "Transparenz Schatten (0-100)", minval=0, maxval=100, group="Visuals")

// --- Inputs: Farben ---
colorHighUp   = input.color(#00FF00, "High Volume Up (Lime)", group="Farben")
colorHighDown = input.color(#FF0000, "High Volume Down (Red)", group="Farben")
colorNormUp   = input.color(#C0C0C0, "Normal Volume Up (Silver)", group="Farben")
colorNormDown = input.color(#808080, "Normal Volume Down (Gray)", group="Farben")
colorEmaLine  = input.color(color.new(#2196f3, 0), "Durchschnitts-Linie (EMA)", group="Farben")
colorThresh   = input.color(color.new(color.orange, 20), "Schwellenwert-Linie (Faktor)", group="Farben")

// --- 1. Berechnung der Projektion (Hochrechnung) ---
float candle_duration = timeframe.multiplier * 60 * 1000
float elapsed_time = timenow - time
float progress = math.min(elapsed_time / (timeframe.isintraday ? candle_duration : 86400000), 1.0)

float projectedVol = (barstate.islast and barstate.isrealtime) ? (volume / math.max(progress, 0.01)) : volume

// --- 2. Volume Logic ---
float volEma = ta.ema(volume, periodo)
float threshold = volEma * fator
bool up = close > open
bool down = open > close
bool pesado = projectedVol > threshold

// --- 3. Dynamische Farbauswahl ---
color baseColor = (pesado and up) ? colorHighUp : (pesado and down) ? colorHighDown : up ? colorNormUp : colorNormDown
color projectionColor = color.new(baseColor, projTransparency)

// --- 4. Darstellung ---

// Schatten des projizierten Volumens
plot(showProjected and barstate.islast ? projectedVol : na, "Projected Target", style=plot.style_columns, color=projectionColor)

// Der echte Volumenbalken
plot(volume, "Volume", style=plot.style_columns, color=baseColor)

// NEU: Die reine Durchschnitts-Linie (EMA 20) - meist blau
plot(volEma, "Average (EMA)", color=colorEmaLine, linewidth=1)

// Die Schwellenwert-Linie (EMA * Faktor) - meist orange
plot(threshold, "Threshold (EMA * Faktor)", color=colorThresh, linewidth=1, style=plot.style_linebr)
