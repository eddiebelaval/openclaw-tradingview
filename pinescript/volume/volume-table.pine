//@version=6
indicator(title="Volume Table", shorttitle="Vol Table", overlay=true)

// ════════════════════════════════════════
// TABLE POSITION
// ════════════════════════════════════════
table_pos = input.string("Bottom Left", "Table Position",
     options=["Top Left","Top Center","Top Right",
              "Middle Left","Middle Center","Middle Right",
              "Bottom Left","Bottom Center","Bottom Right"],
     group="── Table ──")

vol_slots    = input.int(10,  "Number of Slots",  minval=5, maxval=20,  group="── Table ──")
abnormal_mul = input.float(2.0, "Abnormal Volume Multiplier", minval=1.1, maxval=5.0, step=0.1, group="── Table ──")

tbl_size = input.string("Small", "Font Size",
     options=["Tiny","Small","Normal","Large"],
     group="── Table ──")

// ════════════════════════════════════════
// EXTRA TIMEFRAMES
// ════════════════════════════════════════
tf2 = input.timeframe("60",  "Timeframe 2", group="── Timeframes ──")
tf3 = input.timeframe("240", "Timeframe 3", group="── Timeframes ──")

// ════════════════════════════════════════
// TABLE COLORS
// ════════════════════════════════════════
tbl_bg       = input.color(color.new(color.black,  60),  "Table Background",    group="── Table Colors ──")
tbl_border   = input.color(color.gray,                   "Table Border",        group="── Table Colors ──")
header_bg    = input.color(color.new(color.blue,   50),  "Header Background",   group="── Table Colors ──")
header_txt   = input.color(color.white,                  "Header Font Color",   group="── Table Colors ──")
avg_bg       = input.color(color.new(color.black,  70),  "Avg Row Background",  group="── Table Colors ──")
avg_txt      = input.color(color.gray,                   "Avg Row Font Color",  group="── Table Colors ──")
now_txt      = input.color(color.white,                  "NOW Bar Font Color",  group="── Table Colors ──")
old_txt      = input.color(color.gray,                   "Old Bars Font Color", group="── Table Colors ──")

// ════════════════════════════════════════
// VOLUME COLORS
// ════════════════════════════════════════
col_bull     = input.color(color.green,                  "Bullish Volume",      group="── Volume Colors ──")
col_bear     = input.color(color.red,                    "Bearish Volume",      group="── Volume Colors ──")
col_abnormal = input.color(color.new(#FFD700, 0),        "Abnormal Volume",     group="── Volume Colors ──")
abn_bg       = input.color(color.new(#FFD700, 75),       "Abnormal Row BG",     group="── Volume Colors ──")

// ════════════════════════════════════════
// HELPERS
// ════════════════════════════════════════
get_size(s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

get_pos(p) =>
    switch p
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.bottom_right

format_vol(float v) =>
    if v >= 1000000
        str.tostring(math.round(v / 1000000, 2)) + "M"
    else if v >= 1000
        str.tostring(math.round(v / 1000, 1)) + "K"
    else
        str.tostring(int(v))

txt_size = get_size(tbl_size)

// ════════════════════════════════════════
// REQUIRED PLOT
// ════════════════════════════════════════
plot(volume, "Volume", color=color.new(color.blue, 100), display=display.none)

// ════════════════════════════════════════
// SECURITY CALLS
// For NOW row: lookahead_on to get live current candle
// For history: we collect a confirmed-close series using
// barmerge.lookahead_on with [1] offset inside security
// so every historical slot is a real closed candle
// ════════════════════════════════════════

// TF2 — live current candle (NOW row)
[tf2_vol_now, tf2_close_now, tf2_open_now] = request.security(
     syminfo.tickerid, tf2, [volume, close, open],
     lookahead=barmerge.lookahead_on)

// TF2 — confirmed closed history (slots -1 and beyond)
[tf2_vol_hist, tf2_close_hist, tf2_open_hist] = request.security(
     syminfo.tickerid, tf2, [volume[1], close[1], open[1]],
     lookahead=barmerge.lookahead_on)

// TF2 avg
tf2_avg = request.security(syminfo.tickerid, tf2, ta.sma(volume, 20), lookahead=barmerge.lookahead_on)

// TF3 — live current candle (NOW row)
[tf3_vol_now, tf3_close_now, tf3_open_now] = request.security(
     syminfo.tickerid, tf3, [volume, close, open],
     lookahead=barmerge.lookahead_on)

// TF3 — confirmed closed history (slots -1 and beyond)
[tf3_vol_hist, tf3_close_hist, tf3_open_hist] = request.security(
     syminfo.tickerid, tf3, [volume[1], close[1], open[1]],
     lookahead=barmerge.lookahead_on)

// TF3 avg
tf3_avg = request.security(syminfo.tickerid, tf3, ta.sma(volume, 20), lookahead=barmerge.lookahead_on)

avg_vol = ta.sma(volume, 20)

// ════════════════════════════════════════
// STORE HIGHER TF HISTORY INTO ARRAYS
// We capture a new value each time the HTF candle closes
// by detecting when the HTF bar index changes
// ════════════════════════════════════════
var array<float> tf2_vols   = array.new<float>(20, 0.0)
var array<float> tf2_closes = array.new<float>(20, 0.0)
var array<float> tf2_opens  = array.new<float>(20, 0.0)

var array<float> tf3_vols   = array.new<float>(20, 0.0)
var array<float> tf3_closes = array.new<float>(20, 0.0)
var array<float> tf3_opens  = array.new<float>(20, 0.0)

// Detect when a new HTF candle has started (previous one just closed)
tf2_new_bar = ta.change(request.security(syminfo.tickerid, tf2, bar_index, lookahead=barmerge.lookahead_on)) != 0
tf3_new_bar = ta.change(request.security(syminfo.tickerid, tf3, bar_index, lookahead=barmerge.lookahead_on)) != 0

// When a new TF2 bar starts, push the just-closed candle into the front of the array
if tf2_new_bar
    array.unshift(tf2_vols,   tf2_vol_hist)
    array.unshift(tf2_closes, tf2_close_hist)
    array.unshift(tf2_opens,  tf2_open_hist)
    if array.size(tf2_vols) > 20
        array.pop(tf2_vols)
        array.pop(tf2_closes)
        array.pop(tf2_opens)

if tf3_new_bar
    array.unshift(tf3_vols,   tf3_vol_hist)
    array.unshift(tf3_closes, tf3_close_hist)
    array.unshift(tf3_opens,  tf3_open_hist)
    if array.size(tf3_vols) > 20
        array.pop(tf3_vols)
        array.pop(tf3_closes)
        array.pop(tf3_opens)

// ════════════════════════════════════════
// MASTER TABLE
// 11 cols: [0-2] chart | [3] sep | [4-6] tf2 | [7] sep | [8-10] tf3
// ════════════════════════════════════════
if barstate.islast

    var table vt = table.new(get_pos(table_pos), 11, vol_slots + 2,
         bgcolor=tbl_bg,
         border_color=tbl_border,
         border_width=1,
         frame_color=tbl_border,
         frame_width=1)

    sep_color = color.new(color.gray, 70)

    // ════════════════════════
    // BLOCK 1 — CHART TF (cols 0-2)
    // ════════════════════════
    table.cell(vt, 0, 0, timeframe.period, text_color=header_txt, bgcolor=header_bg, text_size=txt_size)
    table.cell(vt, 1, 0, "Dir",            text_color=header_txt, bgcolor=header_bg, text_size=txt_size)
    table.cell(vt, 2, 0, "Volume",         text_color=header_txt, bgcolor=header_bg, text_size=txt_size)

    table.cell(vt, 0, 1, "Avg",               text_color=avg_txt, bgcolor=avg_bg, text_size=size.tiny)
    table.cell(vt, 1, 1, "20",                text_color=avg_txt, bgcolor=avg_bg, text_size=size.tiny)
    table.cell(vt, 2, 1, format_vol(avg_vol), text_color=avg_txt, bgcolor=avg_bg, text_size=size.tiny)

    for i = 0 to vol_slots - 1
        row      = i + 2
        v        = volume[i]
        bull     = close[i] >= open[i]
        abnormal = v >= avg_vol[i] * abnormal_mul
        bar_lbl  = i == 0 ? "NOW" : "-" + str.tostring(i)
        dir_lbl  = bull ? "UP" : "DN"
        vol_disp = abnormal ? format_vol(v) + " !" : format_vol(v)
        cell_bg  = abnormal ? abn_bg : tbl_bg
        dir_col  = bull ? col_bull : col_bear
        vol_col  = abnormal ? col_abnormal : (bull ? col_bull : col_bear)
        bar_col  = i == 0 ? now_txt : old_txt
        table.cell(vt, 0, row, bar_lbl,  text_color=bar_col, bgcolor=cell_bg, text_size=txt_size)
        table.cell(vt, 1, row, dir_lbl,  text_color=dir_col, bgcolor=cell_bg, text_size=txt_size)
        table.cell(vt, 2, row, vol_disp, text_color=vol_col, bgcolor=cell_bg, text_size=txt_size)

    // ════════════════════════
    // SEPARATOR (col 3)
    // ════════════════════════
    for r = 0 to vol_slots + 1
        table.cell(vt, 3, r, "", bgcolor=sep_color)

    // ════════════════════════
    // BLOCK 2 — TF2 (cols 4-6)
    // ════════════════════════
    table.cell(vt, 4, 0, tf2,              text_color=header_txt, bgcolor=header_bg, text_size=txt_size)
    table.cell(vt, 5, 0, "Dir",            text_color=header_txt, bgcolor=header_bg, text_size=txt_size)
    table.cell(vt, 6, 0, "Volume",         text_color=header_txt, bgcolor=header_bg, text_size=txt_size)

    table.cell(vt, 4, 1, "Avg",               text_color=avg_txt, bgcolor=avg_bg, text_size=size.tiny)
    table.cell(vt, 5, 1, "20",                text_color=avg_txt, bgcolor=avg_bg, text_size=size.tiny)
    table.cell(vt, 6, 1, format_vol(tf2_avg), text_color=avg_txt, bgcolor=avg_bg, text_size=size.tiny)

    for i = 0 to vol_slots - 1
        row      = i + 2
        // NOW row uses live current candle, history uses array of confirmed closes
        v        = i == 0 ? tf2_vol_now   : (i - 1 < array.size(tf2_vols)   ? array.get(tf2_vols,   i - 1) : 0.0)
        c        = i == 0 ? tf2_close_now : (i - 1 < array.size(tf2_closes) ? array.get(tf2_closes, i - 1) : 0.0)
        o        = i == 0 ? tf2_open_now  : (i - 1 < array.size(tf2_opens)  ? array.get(tf2_opens,  i - 1) : 0.0)
        bull     = c >= o
        abnormal = v >= tf2_avg * abnormal_mul
        bar_lbl  = i == 0 ? "NOW" : "-" + str.tostring(i)
        dir_lbl  = bull ? "UP" : "DN"
        vol_disp = abnormal ? format_vol(v) + " !" : format_vol(v)
        cell_bg  = abnormal ? abn_bg : tbl_bg
        dir_col  = bull ? col_bull : col_bear
        vol_col  = abnormal ? col_abnormal : (bull ? col_bull : col_bear)
        bar_col  = i == 0 ? now_txt : old_txt
        table.cell(vt, 4, row, bar_lbl,  text_color=bar_col, bgcolor=cell_bg, text_size=txt_size)
        table.cell(vt, 5, row, dir_lbl,  text_color=dir_col, bgcolor=cell_bg, text_size=txt_size)
        table.cell(vt, 6, row, vol_disp, text_color=vol_col, bgcolor=cell_bg, text_size=txt_size)

    // ════════════════════════
    // SEPARATOR (col 7)
    // ════════════════════════
    for r = 0 to vol_slots + 1
        table.cell(vt, 7, r, "", bgcolor=sep_color)

    // ════════════════════════
    // BLOCK 3 — TF3 (cols 8-10)
    // ════════════════════════
    table.cell(vt, 8,  0, tf3,             text_color=header_txt, bgcolor=header_bg, text_size=txt_size)
    table.cell(vt, 9,  0, "Dir",           text_color=header_txt, bgcolor=header_bg, text_size=txt_size)
    table.cell(vt, 10, 0, "Volume",        text_color=header_txt, bgcolor=header_bg, text_size=txt_size)

    table.cell(vt, 8,  1, "Avg",               text_color=avg_txt, bgcolor=avg_bg, text_size=size.tiny)
    table.cell(vt, 9,  1, "20",                text_color=avg_txt, bgcolor=avg_bg, text_size=size.tiny)
    table.cell(vt, 10, 1, format_vol(tf3_avg), text_color=avg_txt, bgcolor=avg_bg, text_size=size.tiny)

    for i = 0 to vol_slots - 1
        row      = i + 2
        v        = i == 0 ? tf3_vol_now   : (i - 1 < array.size(tf3_vols)   ? array.get(tf3_vols,   i - 1) : 0.0)
        c        = i == 0 ? tf3_close_now : (i - 1 < array.size(tf3_closes) ? array.get(tf3_closes, i - 1) : 0.0)
        o        = i == 0 ? tf3_open_now  : (i - 1 < array.size(tf3_opens)  ? array.get(tf3_opens,  i - 1) : 0.0)
        bull     = c >= o
        abnormal = v >= tf3_avg * abnormal_mul
        bar_lbl  = i == 0 ? "NOW" : "-" + str.tostring(i)
        dir_lbl  = bull ? "UP" : "DN"
        vol_disp = abnormal ? format_vol(v) + " !" : format_vol(v)
        cell_bg  = abnormal ? abn_bg : tbl_bg
        dir_col  = bull ? col_bull : col_bear
        vol_col  = abnormal ? col_abnormal : (bull ? col_bull : col_bear)
        bar_col  = i == 0 ? now_txt : old_txt
        table.cell(vt, 8,  row, bar_lbl,  text_color=bar_col, bgcolor=cell_bg, text_size=txt_size)
        table.cell(vt, 9,  row, dir_lbl,  text_color=dir_col, bgcolor=cell_bg, text_size=txt_size)
        table.cell(vt, 10, row, vol_disp, text_color=vol_col, bgcolor=cell_bg, text_size=txt_size)
