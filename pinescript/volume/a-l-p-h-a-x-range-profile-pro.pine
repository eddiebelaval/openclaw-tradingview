// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © AlphaX
//@version=6
indicator("AlphaX Range Profile Pro", overlay=true, max_boxes_count=500, max_lines_count=120, max_labels_count=100, max_bars_back=501)

//────────────────────────────────────────────────────────────────────────────────────────────────────
// Inputs
//────────────────────────────────────────────────────────────────────────────────────────────────────
groupRange  = "Range"
groupProf   = "Profile"
groupLevels = "Levels"
groupStyle  = "Style"
groupStats  = "Stats"

rangeMode   = input.string("Fixed Bars", "Range Mode", options=["Fixed Bars", "From Date/Time"], group=groupRange)
fixedBars   = input.int(150, "Number of Bars", minval=1, maxval=500, group=groupRange)
anchorTime  = input.time(1704067200000, "Anchor Time (if From Date/Time)", group=groupRange)
maxLookback = input.int(500, "Max Lookback (Anchor mode)", minval=1, maxval=500, group=groupRange)

rows             = input.int(24, "Row Size (bins)", minval=5, maxval=100, group=groupProf)
vaPercent        = input.float(70.0, "Value Area Volume %", minval=0, maxval=100, group=groupProf)
displayMode      = input.string("Up/Down Split", "Display Mode", options=["Up/Down Split", "Total Only", "Delta Only"], group=groupProf)
profileWidthBars = input.int(28, "Profile Width (bars)", minval=6, maxval=200, group=groupProf)
placement        = input.string("Left (inside chart)", "Placement", options=["Left (inside chart)", "Right (future)"], group=groupProf)
xOffset          = input.int(0, "X Offset (bars)", minval=-200, maxval=200, group=groupProf)

showValueAreaFill = input.bool(true,  "Shade Value Area (box)", group=groupLevels)
showPOCLine       = input.bool(true,  "Show POC",               group=groupLevels)
showVALines       = input.bool(true,  "Show VAH / VAL",         group=groupLevels)
showRangeHiLo     = input.bool(false, "Show Range High / Low",  group=groupLevels)
extendLinesOpt    = input.string("Right", "Extend Lines", options=["Right", "None"], group=groupLevels)
showLevelLabels   = input.bool(true,  "Show Level Labels",      group=groupLevels)
showHVN           = input.bool(false, "Show HVN (Top Nodes) Lines", group=groupLevels)
hvnCount          = input.int(2, "HVN Count (excl. POC)", minval=1, maxval=5, group=groupLevels)

showGlassPanel     = input.bool(true,  "Profile Panel",   group=groupStyle)
showGlassHighlight = input.bool(false, "Panel Highlight", group=groupStyle)
showPanelAccent    = input.bool(true,  "Accent Edge",     group=groupStyle)
rowGapPct          = input.float(0.06, "Row Gap", minval=0.00, maxval=0.45, step=0.01, group=groupStyle)

// ── Palette: yellow-green up, matte crimson down ──────────────────────────────
pocColor         = input.color(color.rgb(255, 200, 40),                 "POC Color",          group=groupStyle)
vahColor         = input.color(color.rgb(200, 210, 220),                "VAH Color",          group=groupStyle)
valColor         = input.color(color.rgb(200, 210, 220),                "VAL Color",          group=groupStyle)
hiLoColor        = input.color(color.new(color.rgb(140, 155, 170), 50), "Range Hi/Lo Color",  group=groupStyle)

vaUpColor        = input.color(color.new(color.rgb(178, 208, 72),  40), "Value Area Up",      group=groupStyle)
vaDownColor      = input.color(color.new(color.rgb(176, 58,  58),  40), "Value Area Down",    group=groupStyle)
upColor          = input.color(color.new(color.rgb(178, 208, 72),  65), "Up Volume",          group=groupStyle)
downColor        = input.color(color.new(color.rgb(176, 58,  58),  65), "Down Volume",        group=groupStyle)

vaFillColor      = input.color(color.new(color.rgb(178, 208, 72),  93), "Value Area Fill",    group=groupStyle)
panelBgColor     = input.color(color.new(color.rgb(10,  13,  20),  86), "Panel Tint",         group=groupStyle)
panelBorderColor = input.color(color.new(color.rgb(50,  58,  70),  60), "Panel Border",       group=groupStyle)
panelAccentColor = input.color(color.new(color.rgb(178, 208, 72),  45), "Accent Edge Color",  group=groupStyle)
glassHighlightColor = input.color(color.new(color.white, 97),           "Highlight Tint",     group=groupStyle)

labelTextColor   = input.color(color.rgb(220, 225, 230),                "Label Text Color",   group=groupStyle)
labelBgColor     = input.color(color.new(color.rgb(10,  13,  20),  68), "Label Background",   group=groupStyle)

pocWidth         = input.int(2, "POC Width",          minval=1, maxval=5, group=groupStyle)
vaWidth          = input.int(1, "VAH/VAL Width",       minval=1, maxval=4, group=groupStyle)
hvnWidth         = input.int(1, "HVN Width",           minval=1, maxval=4, group=groupStyle)
panelBorderWidth = input.int(1, "Panel Border Width",  minval=0, maxval=2, group=groupStyle)

statsTable = input.bool(true, "Stats Table", group=groupStats)
tablePos   = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=groupStats)

extendOpt = extendLinesOpt == "Right" ? extend.right : extend.none

//────────────────────────────────────────────────────────────────────────────────────────────────────
// Helpers
//────────────────────────────────────────────────────────────────────────────────────────────────────
getVol(binLo, binHi, segA, segB, segH, segVol) =>
    segH <= 0.0 ? 0.0 : math.max(math.min(math.max(binLo, binHi), math.max(segA, segB)) - math.max(math.min(binLo, binHi), math.min(segA, segB)), 0.0) * segVol / segH

roundTick(x) =>
    math.round_to_mintick(x)

f_delBoxes(box[] bx) =>
    int n = array.size(bx)
    if n > 0
        for i = 0 to n - 1
            box.delete(array.get(bx, i))
    array.clear(bx)

f_delLines(line[] ln) =>
    int n = array.size(ln)
    if n > 0
        for i = 0 to n - 1
            line.delete(array.get(ln, i))
    array.clear(ln)

//────────────────────────────────────────────────────────────────────────────────────────────────────
// Persistent drawing handles
//────────────────────────────────────────────────────────────────────────────────────────────────────
var box[]  g_boxesA   = array.new_box()
var box[]  g_boxesB   = array.new_box()
var box    g_panelBox = na
var box    g_glowBox  = na
var box    g_vaBox    = na
var line   g_edgeLine = na
var line   g_pocLine  = na
var line   g_vahLine  = na
var line   g_valLine  = na
var line   g_hiLine   = na
var line   g_loLine   = na
var line[] g_hvnLines = array.new_line()
var label  g_pocLbl   = na
var label  g_vahLbl   = na
var label  g_valLbl   = na
var table  g_tbl      = na

var float g_poc = na
var float g_vah = na
var float g_val = na
var float g_rhi = na
var float g_rlo = na
var int   g_len = na

//────────────────────────────────────────────────────────────────────────────────────────────────────
// Main computation + drawing
//────────────────────────────────────────────────────────────────────────────────────────────────────
if barstate.islast
    f_delBoxes(g_boxesA)
    f_delBoxes(g_boxesB)
    f_delLines(g_hvnLines)

    if not na(g_panelBox)
        box.delete(g_panelBox)
    g_panelBox := na

    if not na(g_glowBox)
        box.delete(g_glowBox)
    g_glowBox := na

    if not na(g_vaBox)
        box.delete(g_vaBox)
    g_vaBox := na

    if not na(g_edgeLine)
        line.delete(g_edgeLine)
    g_edgeLine := na

    if not na(g_pocLine)
        line.delete(g_pocLine)
    g_pocLine := na

    if not na(g_vahLine)
        line.delete(g_vahLine)
    g_vahLine := na

    if not na(g_valLine)
        line.delete(g_valLine)
    g_valLine := na

    if not na(g_hiLine)
        line.delete(g_hiLine)
    g_hiLine := na

    if not na(g_loLine)
        line.delete(g_loLine)
    g_loLine := na

    if not na(g_pocLbl)
        label.delete(g_pocLbl)
    g_pocLbl := na

    if not na(g_vahLbl)
        label.delete(g_vahLbl)
    g_vahLbl := na

    if not na(g_valLbl)
        label.delete(g_valLbl)
    g_valLbl := na

    if not statsTable and not na(g_tbl)
        table.delete(g_tbl)
        g_tbl := na

    // Determine range length
    int reqLen = rangeMode == "Fixed Bars" ? fixedBars : 1
    if rangeMode == "From Date/Time"
        int cnt = 0
        for i = 0 to maxLookback - 1
            if na(time[i])
                break
            if time[i] >= anchorTime
                cnt += 1
            else
                break
        reqLen := math.max(cnt, 1)

    int availLen = math.min(reqLen, bar_index + 1)
    g_len := availLen

    // Compute range high / low
    float top = -1e100
    float bot =  1e100
    for i = 0 to availLen - 1
        if not na(high[i])
            top := math.max(top, high[i])
        if not na(low[i])
            bot := math.min(bot, low[i])

    g_rhi := top
    g_rlo := bot

    float pr       = top - bot
    float step     = rows > 0 ? pr / rows : na
    float rowInset = na(step) ? na : step * rowGapPct

    int leftX        = bar_index - availLen + 1
    int rightX       = bar_index
    int drawWidth    = placement == "Right (future)" ? profileWidthBars : math.max(1, math.min(profileWidthBars, availLen))
    int profileLeft  = ((placement == "Right (future)") ? rightX + 1 : leftX) + xOffset
    int profileRight = profileLeft + drawWidth
    int labelX       = profileRight + 1

    if pr <= 0 or na(step)
        g_poc := na
        g_vah := na
        g_val := na
    else
        // Build bin levels
        float[] levels = array.new_float(rows + 1, na)
        for x = 0 to rows
            array.set(levels, x, bot + step * x)

        // Accumulate up/down volume per bin
        float[] upVol = array.new_float(rows, 0.0)
        float[] dnVol = array.new_float(rows, 0.0)

        for b = 0 to availLen - 1
            float o = open[b]
            float c = close[b]
            float h = high[b]
            float l = low[b]
            float v = nz(volume[b], 0.0)

            float bodyTop    = math.max(c, o)
            float bodyBot    = math.min(c, o)
            bool  isGreen    = c >= o
            float topWick    = math.max(h - bodyTop, 0.0)
            float bottomWick = math.max(bodyBot - l, 0.0)
            float bodyH      = math.max(bodyTop - bodyBot, 0.0)
            float denom      = 2.0 * topWick + 2.0 * bottomWick + bodyH

            float bodyVol    = denom > 0 ? (bodyH * v / denom) : v
            float topWickVol = denom > 0 ? (2.0 * topWick * v / denom) : 0.0
            float botWickVol = denom > 0 ? (2.0 * bottomWick * v / denom) : 0.0

            for x = 0 to rows - 1
                float binLo = array.get(levels, x)
                float binHi = array.get(levels, x + 1)

                float upAdd = (isGreen ? getVol(binLo, binHi, bodyBot, bodyTop, bodyH, bodyVol) : 0.0) +
                              getVol(binLo, binHi, bodyTop, h, topWick, topWickVol) / 2.0 +
                              getVol(binLo, binHi, bodyBot, l, bottomWick, botWickVol) / 2.0

                float dnAdd = (isGreen ? 0.0 : getVol(binLo, binHi, bodyBot, bodyTop, bodyH, bodyVol)) +
                              getVol(binLo, binHi, bodyTop, h, topWick, topWickVol) / 2.0 +
                              getVol(binLo, binHi, bodyBot, l, bottomWick, botWickVol) / 2.0

                array.set(upVol, x, array.get(upVol, x) + upAdd)
                array.set(dnVol, x, array.get(dnVol, x) + dnAdd)

        // Totals + POC
        float[] totalVol = array.new_float(rows, 0.0)
        float sumVol     = 0.0
        float maxRowVol  = 0.0
        int   poc        = 0
        float pocVol     = -1.0

        for x = 0 to rows - 1
            float t = array.get(upVol, x) + array.get(dnVol, x)
            array.set(totalVol, x, t)
            sumVol += t
            if t > maxRowVol
                maxRowVol := t
            if t > pocVol
                pocVol := t
                poc := x

        float pocPrice = (array.get(levels, poc) + array.get(levels, poc + 1)) / 2.0
        g_poc := pocPrice

        // Value Area expansion from POC
        float target  = sumVol * (vaPercent / 100.0)
        float vaTotal = array.get(totalVol, poc)
        int   up      = poc
        int   down    = poc

        for _ = 0 to rows - 1
            if vaTotal >= target
                break
            float upper = up < rows - 1 ? array.get(totalVol, up + 1) : 0.0
            float lower = down > 0      ? array.get(totalVol, down - 1) : 0.0
            if upper == 0 and lower == 0
                break
            if upper >= lower
                vaTotal += upper
                up += 1
            else
                vaTotal += lower
                down -= 1

        float vah = array.get(levels, up + 1)
        float val = array.get(levels, down)
        g_vah := vah
        g_val := val

        // Panel backdrop
        if showGlassPanel
            g_panelBox := box.new(profileLeft, top, profileRight, bot, xloc=xloc.bar_index, border_color=panelBorderColor, border_width=panelBorderWidth, bgcolor=panelBgColor)

        if showGlassHighlight
            float glowBottom = math.max(bot, top - pr * 0.22)
            g_glowBox := box.new(profileLeft, top, profileRight, glowBottom, xloc=xloc.bar_index, border_width=0, bgcolor=glassHighlightColor)

        if showPanelAccent
            g_edgeLine := line.new(profileLeft, top, profileLeft, bot, xloc=xloc.bar_index, extend=extend.none, color=panelAccentColor, width=2)

        // Value Area fill
        if showValueAreaFill
            g_vaBox := box.new(left=leftX, top=vah, right=rightX, bottom=val, xloc=xloc.bar_index, border_width=0, bgcolor=vaFillColor)

        // Delta pre-pass
        float maxAbsDelta = 0.0
        if displayMode == "Delta Only"
            for x = 0 to rows - 1
                maxAbsDelta := math.max(maxAbsDelta, math.abs(array.get(upVol, x) - array.get(dnVol, x)))

        // Draw profile rows
        for x = 0 to rows - 1
            float yTop  = array.get(levels, x + 1) - rowInset
            float yBot  = array.get(levels, x) + rowInset
            bool  inVA  = x >= down and x <= up
            float u     = array.get(upVol, x)
            float d     = array.get(dnVol, x)
            float t     = array.get(totalVol, x)
            float delta = u - d

            if yTop > yBot
                if displayMode == "Up/Down Split"
                    int totalW = maxRowVol > 0 ? int(math.round((t / maxRowVol) * drawWidth)) : 0
                    if totalW > 0
                        int wUp = t > 0 ? int(math.round(totalW * (u / t))) : 0
                        wUp := u > 0 ? math.max(1, wUp) : 0
                        wUp := math.min(wUp, totalW)
                        int wDn = totalW - wUp
                        if d > 0 and wDn == 0
                            wDn := 1
                            wUp := math.max(totalW - 1, 0)
                        color cu = inVA ? vaUpColor : upColor
                        color cd = inVA ? vaDownColor : downColor
                        if wUp > 0
                            array.push(g_boxesA, box.new(profileLeft, yTop, profileLeft + wUp, yBot, xloc=xloc.bar_index, border_width=0, bgcolor=cu))
                        if wDn > 0
                            array.push(g_boxesB, box.new(profileLeft + wUp, yTop, profileLeft + wUp + wDn, yBot, xloc=xloc.bar_index, border_width=0, bgcolor=cd))

                else if displayMode == "Total Only"
                    int w = maxRowVol > 0 ? int(math.round((t / maxRowVol) * drawWidth)) : 0
                    if w > 0
                        color cTot = inVA ? color.new(color.rgb(178, 208, 72), 55) : color.new(color.rgb(178, 208, 72), 78)
                        array.push(g_boxesA, box.new(profileLeft, yTop, profileLeft + w, yBot, xloc=xloc.bar_index, border_width=0, bgcolor=cTot))

                else
                    int w = maxAbsDelta > 0 ? int(math.round((math.abs(delta) / maxAbsDelta) * drawWidth)) : 0
                    if w > 0
                        color cDel = delta >= 0 ? (inVA ? vaUpColor : upColor) : (inVA ? vaDownColor : downColor)
                        array.push(g_boxesA, box.new(profileLeft, yTop, profileLeft + w, yBot, xloc=xloc.bar_index, border_width=0, bgcolor=cDel))

        // Key level lines
        if showPOCLine
            g_pocLine := line.new(leftX, pocPrice, rightX, pocPrice, xloc=xloc.bar_index, extend=extendOpt, color=pocColor, width=pocWidth)

        if showVALines
            g_vahLine := line.new(leftX, vah, rightX, vah, xloc=xloc.bar_index, extend=extendOpt, color=vahColor, width=vaWidth, style=line.style_dashed)
            g_valLine := line.new(leftX, val, rightX, val, xloc=xloc.bar_index, extend=extendOpt, color=valColor, width=vaWidth, style=line.style_dashed)

        if showRangeHiLo
            g_hiLine := line.new(leftX, top, rightX, top, xloc=xloc.bar_index, extend=extendOpt, color=hiLoColor, width=1, style=line.style_dotted)
            g_loLine := line.new(leftX, bot, rightX, bot, xloc=xloc.bar_index, extend=extendOpt, color=hiLoColor, width=1, style=line.style_dotted)

        // HVN lines
        if showHVN and hvnCount > 0
            int[] picked = array.new_int()
            for k = 0 to hvnCount - 1
                float best   = -1.0
                int bestIdx  = na
                for i = 0 to rows - 1
                    if i == poc
                        continue
                    if array.includes(picked, i)
                        continue
                    float vv = array.get(totalVol, i)
                    if vv > best
                        best    := vv
                        bestIdx := i
                if not na(bestIdx)
                    array.push(picked, bestIdx)
                    float hvnPx = (array.get(levels, bestIdx) + array.get(levels, bestIdx + 1)) / 2.0
                    array.push(g_hvnLines, line.new(leftX, hvnPx, rightX, hvnPx, xloc=xloc.bar_index, extend=extendOpt, color=color.new(color.rgb(178, 208, 72), 60), width=hvnWidth, style=line.style_dashed))

        // Labels
        if showLevelLabels
            if showPOCLine
                g_pocLbl := label.new(labelX, pocPrice, text=" POC  " + str.tostring(roundTick(pocPrice)) + " ", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.rgb(255, 200, 40), color=color.new(color.rgb(18, 22, 30), 5), size=size.normal)
            if showVALines
                g_vahLbl := label.new(labelX, vah, text=" VAH  " + str.tostring(roundTick(vah)) + " ", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.rgb(220, 225, 232), color=color.new(color.rgb(18, 22, 30), 5), size=size.small)
                g_valLbl := label.new(labelX, val, text=" VAL  " + str.tostring(roundTick(val)) + " ", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.rgb(220, 225, 232), color=color.new(color.rgb(18, 22, 30), 5), size=size.small)

        // ── Stats table ───────────────────────────────────────────────────────
        if statsTable
            string simple_pos = tablePos == "Top Right" ? position.top_right : tablePos == "Top Left" ? position.top_left : tablePos == "Bottom Right" ? position.bottom_right : position.bottom_left

            if na(g_tbl)
                g_tbl := table.new(simple_pos, 2, 6,
                     frame_color  = color.new(color.rgb(178, 208, 72), 60),
                     frame_width  = 1,
                     border_color = color.new(color.rgb(40, 46, 56), 20),
                     border_width = 1)

            float sumUp    = array.sum(upVol)
            float sumDn    = array.sum(dnVol)
            float netDelta = sumUp - sumDn
            float pocPct   = sumVol > 0 ? (array.get(totalVol, poc) / sumVol) * 100.0 : na

            // ── Table color tokens ────────────────────────────────────────────
            color c_hdrBg   = color.new(color.rgb(18, 22, 30),  5)   // near-black header
            color c_rowBg   = color.new(color.rgb(12, 15, 22),  8)   // slightly lighter rows
            color c_accent  = color.rgb(178, 208, 72)                 // yellow-green accent
            color c_dim     = color.new(color.rgb(130, 140, 155), 0)  // muted label text
            color c_white   = color.rgb(220, 225, 232)                // value text
            color c_up      = color.rgb(178, 208, 72)                 // positive delta
            color c_dn      = color.rgb(176, 58,  58)                 // negative delta

            // Row 0 — header
            table.cell(g_tbl, 0, 0, "ALPHAX RANGE PROFILE PRO",
                 text_color=c_accent, text_size=size.small,
                 bgcolor=c_hdrBg, text_halign=text.align_left)
            table.cell(g_tbl, 1, 0, timeframe.period,
                 text_color=c_dim, text_size=size.small,
                 bgcolor=c_hdrBg, text_halign=text.align_right)

            // Row 1
            table.cell(g_tbl, 0, 1, "RANGE BARS",
                 text_color=c_dim, text_size=size.tiny, bgcolor=c_rowBg, text_halign=text.align_left)
            table.cell(g_tbl, 1, 1, str.tostring(availLen),
                 text_color=c_white, text_size=size.tiny, bgcolor=c_rowBg, text_halign=text.align_right)

            // Row 2
            table.cell(g_tbl, 0, 2, "POC",
                 text_color=c_dim, text_size=size.tiny, bgcolor=c_rowBg, text_halign=text.align_left)
            table.cell(g_tbl, 1, 2, str.tostring(roundTick(pocPrice)) + (na(pocPct) ? "" : "  " + str.tostring(math.round(pocPct * 10) / 10) + "%"),
                 text_color=color.rgb(255, 200, 40), text_size=size.tiny, bgcolor=c_rowBg, text_halign=text.align_right)

            // Row 3
            table.cell(g_tbl, 0, 3, "VAH / VAL",
                 text_color=c_dim, text_size=size.tiny, bgcolor=c_rowBg, text_halign=text.align_left)
            table.cell(g_tbl, 1, 3, str.tostring(roundTick(vah)) + " / " + str.tostring(roundTick(val)),
                 text_color=c_white, text_size=size.tiny, bgcolor=c_rowBg, text_halign=text.align_right)

            // Row 4
            table.cell(g_tbl, 0, 4, "VOL  UP / DN",
                 text_color=c_dim, text_size=size.tiny, bgcolor=c_rowBg, text_halign=text.align_left)
            table.cell(g_tbl, 1, 4, str.tostring(math.round(sumUp)) + " / " + str.tostring(math.round(sumDn)),
                 text_color=c_white, text_size=size.tiny, bgcolor=c_rowBg, text_halign=text.align_right)

            // Row 5
            table.cell(g_tbl, 0, 5, "NET DELTA",
                 text_color=c_dim, text_size=size.tiny, bgcolor=c_rowBg, text_halign=text.align_left)
            table.cell(g_tbl, 1, 5, str.tostring(math.round(netDelta)),
                 text_color=netDelta >= 0 ? c_up : c_dn,
                 text_size=size.tiny, bgcolor=c_rowBg, text_halign=text.align_right)

//────────────────────────────────────────────────────────────────────────────────────────────────────
// Alerts
//────────────────────────────────────────────────────────────────────────────────────────────────────
alertcondition(not na(g_poc) and ta.crossover(close, g_poc),  "AlphaX Range Profile Pro: Cross Above POC", "Price crossed ABOVE POC: {{ticker}} @ {{close}}")
alertcondition(not na(g_poc) and ta.crossunder(close, g_poc), "AlphaX Range Profile Pro: Cross Below POC", "Price crossed BELOW POC: {{ticker}} @ {{close}}")
alertcondition(not na(g_vah) and ta.crossover(close, g_vah),  "AlphaX Range Profile Pro: Cross Above VAH", "Price crossed ABOVE VAH: {{ticker}} @ {{close}}")
alertcondition(not na(g_val) and ta.crossunder(close, g_val), "AlphaX Range Profile Pro: Cross Below VAL", "Price crossed BELOW VAL: {{ticker}} @ {{close}}")
