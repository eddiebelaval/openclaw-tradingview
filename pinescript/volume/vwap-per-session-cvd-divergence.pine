//@version=6
// @description To spot institutional reversals at VWAP using CVD Divergence.
// @author mattman44
// @strategy NQ/MNQ/Futures Scalping
indicator("NQ: Session Reset CVD Divergence", "CVD VWAP Div", overlay=true, max_bars_back=1000)

// ==========================================
// --- INPUTS & CONFIGURATION ---
// ==========================================
prd = input.int(2, "Pivot Sensitivity", minval=1, tooltip="Lookback for highs/lows. Lower = faster, Higher = filtered.")
vwapThreshold = input.float(0.8, "NQ VWAP Band (%)", step=0.1, tooltip="The 'Action Zone' around VWAP where reversals are valid.")
resetCVD = input.bool(true, "Reset CVD Every Session?", tooltip="Ensures delta starts at 0 every day to align with intraday volume.")

// ==========================================
// --- CALCULATIONS & DATA HANDLING ---
// ==========================================
// Detect session break to reset calculations
is_new_session = ta.change(time("D")) != 0

// Standard Volume Weighted Average Price (Resets Daily)
vwapVal = ta.vwap(hlc3)
plot(vwapVal, "VWAP", color=color.new(color.gray, 50), linewidth=2)

// Cumulative Volume Delta (CVD) Logic
// We calculate delta per bar (Close vs Open) and accumulate it.
// If it's a new session, we clear the 'scorecard' and start fresh.
var float cvd = 0.0
vol = na(volume) ? 0 : volume
delta = (close > open ? vol : close < open ? -vol : 0)

if is_new_session and resetCVD
    cvd := delta
else
    cvd += delta

// ==========================================
// --- DIVERGENCE ENGINE ---
// ==========================================
// Identify technical pivots (Swing Highs and Swing Lows)
ph = ta.pivothigh(high, prd, prd)
pl = ta.pivotlow(low, prd, prd)

// Proximity Filter: Only trigger signals within a specific % of VWAP
upperBand = vwapVal * (1 + vwapThreshold / 100)
lowerBand = vwapVal * (1 - vwapThreshold / 100)
inZone(price) => price <= upperBand and price >= lowerBand

// State variables to remember the previous pivot's price and CVD value
var float lastPH_Price = na
var float lastPH_CVD   = na
var float lastPL_Price = na
var float lastPL_CVD   = na

bool bullSignal = false
bool bearSignal = false

// BEARISH DIVERGENCE: Price makes a Higher High, but CVD makes a Lower High.
// Suggests buyers are exhausted and hitting a wall of institutional limit orders at VWAP.
if not na(ph)
    if high[prd] > lastPH_Price and cvd[prd] < lastPH_CVD and inZone(high[prd])
        bearSignal := true
    lastPH_Price := high[prd]
    lastPH_CVD   := cvd[prd]

// BULLISH DIVERGENCE: Price makes a Lower Low, but CVD makes a Higher Low.
// Suggests sellers are being absorbed by aggressive limit buyers at VWAP.
if not na(pl)
    if low[prd] < lastPL_Price and cvd[prd] > lastPL_CVD and inZone(low[prd])
        bullSignal := true
    lastPL_Price := low[prd]
    lastPL_CVD   := cvd[prd]

// ==========================================
// --- VISUALS & PLOTTING ---
// ==========================================
// Signals are offset by -prd because a pivot is only confirmed after 'prd' bars.
plotshape(bullSignal, "NQ Bullish", shape.triangleup, location.belowbar, color.green, size=size.small, offset=-prd)
plotshape(bearSignal, "NQ Bearish", shape.triangledown, location.abovebar, color.red, size=size.small, offset=-prd)

// Background highlighting for quick visual recognition
bgcolor(bullSignal ? color.new(color.green, 90) : bearSignal ? color.new(color.red, 90) : na)

// Optional: Plotting the Bands (Visual Guide)
plot(upperBand, "Upper Zone", color=color.new(color.red, 95))
plot(lowerBand, "Lower Zone", color=color.new(color.green, 95))

// ==========================================
// --- ALERTS ---
// ==========================================
alertcondition(bullSignal, "CVD Bullish Divergence @ VWAP", "Bullish Reversal Confirmed")
alertcondition(bearSignal, "CVD Bearish Divergence @ VWAP", "Bearish Reversal Confirmed")
