//@version=6
indicator("[CS] Relative Volume (RVOL)", overlay=true, max_labels_count=500)

// ──────────────────────────────────────────────────────────────────────────────
//  INPUTS
// ──────────────────────────────────────────────────────────────────────────────

grpDetection = "Detection"
lookbackDays = input.int(10, "Lookback Days", minval=2, maxval=50, tooltip="Number of past days used to calculate average volume for each time slot. More days = smoother baseline.", group=grpDetection)
highThresh   = input.float(2.0, "High RVOL Threshold", minval=1.1, step=0.1, tooltip="RVOL above this is considered elevated. 2.0 = double the normal volume for this time of day.", group=grpDetection)
extremeThresh = input.float(3.5, "Extreme RVOL Threshold", minval=1.5, step=0.1, tooltip="RVOL above this is considered extreme. Rare and worth attention.", group=grpDetection)

grpDisplay = "Display"
showMarkers = input.bool(true, "Show Markers", tooltip="Small shapes near high-RVOL bars.", group=grpDisplay)
showTable   = input.bool(true, "Show Stats Table", group=grpDisplay)
tablePos    = input.string("Bottom Right", "Table Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group=grpDisplay)

grpColors  = "Colors"
highColor    = input.color(#ffa726, "High RVOL Marker", group=grpColors)
extremeColor = input.color(#ffa726, "Extreme RVOL Marker", group=grpColors)
dryColor     = input.color(#42a5f5, "Low RVOL (Dry-Up)", group=grpColors)

// ──────────────────────────────────────────────────────────────────────────────
//  TIME-OF-DAY VOLUME BASELINE
// ──────────────────────────────────────────────────────────────────────────────

// Each bar gets compared to the average volume of bars at the SAME time of day
// over the past N days. This means 9:30 volume is compared to other 9:30 bars,
// not to the sleepy 12:30 PM average.

// Minutes since midnight — unique ID for each time slot
barHour    = hour(time, syminfo.timezone)
barMin     = minute(time, syminfo.timezone)
timeSlot   = barHour * 60 + barMin

// Count how many bars per day to calculate day offsets
// On intraday TFs: bars per day = minutes in session / timeframe minutes
tfMins     = timeframe.in_seconds() / 60
barsPerDay = tfMins > 0 ? math.ceil(390 / tfMins) : 78  // 390 min = 6.5hr NYSE session

// Calculate average volume at this same time slot across past N days
sumVol     = 0.0
countDays  = 0

for i = 1 to 50
    offset = i * barsPerDay
    if offset <= bar_index and i <= lookbackDays
        pastTime = hour(time[offset], syminfo.timezone) * 60 + minute(time[offset], syminfo.timezone)
        // Only include if the time slot roughly matches (within 1 minute tolerance)
        if math.abs(pastTime - timeSlot) <= 1
            sumVol += volume[offset]
            countDays += 1

avgVolAtTime = countDays > 0 ? sumVol / countDays : ta.sma(volume, 20)

// ──────────────────────────────────────────────────────────────────────────────
//  RVOL CALCULATION
// ──────────────────────────────────────────────────────────────────────────────

rvol = avgVolAtTime > 0 ? volume / avgVolAtTime : 0.0

isBullish = close >= open
isHigh    = rvol >= highThresh
isExtreme = rvol >= extremeThresh
isDryUp   = rvol < 0.5 and rvol > 0  // Less than half of normal — volume dry-up

// ──────────────────────────────────────────────────────────────────────────────
//  MARKERS — Small shapes near candles. Candles stay untouched.
//  Bullish: below bar. Bearish: above bar.
// ──────────────────────────────────────────────────────────────────────────────

// Extreme RVOL
plotshape(showMarkers and isExtreme and isBullish, title="Extreme RVOL Bull", style=shape.diamond, location=location.belowbar, color=extremeColor, size=size.tiny)
plotshape(showMarkers and isExtreme and not isBullish, title="Extreme RVOL Bear", style=shape.diamond, location=location.abovebar, color=extremeColor, size=size.tiny)

// High RVOL (not extreme)
plotshape(showMarkers and isHigh and not isExtreme and isBullish, title="High RVOL Bull", style=shape.diamond, location=location.belowbar, color=color.new(highColor, 50), size=size.auto)
plotshape(showMarkers and isHigh and not isExtreme and not isBullish, title="High RVOL Bear", style=shape.diamond, location=location.abovebar, color=color.new(highColor, 50), size=size.auto)

// Dry-up
plotshape(showMarkers and isDryUp and isBullish, title="Dry-Up Bull", style=shape.circle, location=location.belowbar, color=color.new(dryColor, 50), size=size.auto)
plotshape(showMarkers and isDryUp and not isBullish, title="Dry-Up Bear", style=shape.circle, location=location.abovebar, color=color.new(dryColor, 50), size=size.auto)

// ──────────────────────────────────────────────────────────────────────────────
//  STATS TABLE
// ──────────────────────────────────────────────────────────────────────────────

tblPos = switch tablePos
    "Top Left"     => position.top_left
    "Top Right"    => position.top_right
    "Bottom Left"  => position.bottom_left
    => position.bottom_right

var table tbl = table.new(tblPos, 2, 6, bgcolor=color.new(#131722, 5), border_color=color.new(#2a2e39, 0), border_width=1, frame_color=color.new(#2a2e39, 0), frame_width=1)

if showTable and barstate.islast
    // Row 0: RVOL value
    rvolColor = isExtreme ? extremeColor : isHigh ? highColor : isDryUp ? dryColor : color.new(color.white, 50)
    table.cell(tbl, 0, 0, "RVOL", text_color=color.new(color.white, 60), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 0, str.tostring(rvol, "#.##") + "x", text_color=rvolColor, text_size=size.tiny, text_halign=text.align_right)

    // Row 1: Baseline info
    table.cell(tbl, 0, 1, "Base", text_color=color.new(color.white, 60), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 1, str.tostring(countDays) + "d avg", text_color=color.new(color.white, 50), text_size=size.tiny, text_halign=text.align_right)

    // Row 2: Status
    statusText  = isExtreme ? "EXTREME" : isHigh ? "HIGH" : isDryUp ? "DRY" : "Normal"
    statusColor = isExtreme ? extremeColor : isHigh ? highColor : isDryUp ? dryColor : color.new(color.white, 70)
    table.cell(tbl, 0, 2, " ", text_color=color.new(color.white, 60), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 2, statusText, text_color=statusColor, text_size=size.tiny, text_halign=text.align_right)

    // Row 3-5: Legend
    table.cell(tbl, 0, 3, "◆", text_color=extremeColor, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 3, "Extreme (" + str.tostring(extremeThresh, "#.#") + "x+)", text_color=color.new(color.white, 60), text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 0, 4, "◆", text_color=color.new(highColor, 50), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 4, "High (" + str.tostring(highThresh, "#.#") + "x+)", text_color=color.new(color.white, 60), text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 0, 5, "●", text_color=color.new(dryColor, 50), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 5, "Dry-Up (<0.5x)", text_color=color.new(color.white, 60), text_size=size.tiny, text_halign=text.align_right)

// ──────────────────────────────────────────────────────────────────────────────
//  ALERTS
// ──────────────────────────────────────────────────────────────────────────────

alertcondition(isHigh,    title="High RVOL",    message="[CS] High relative volume — {{plot_0}}x normal for this time of day")
alertcondition(isExtreme, title="Extreme RVOL",  message="[CS] Extreme relative volume — {{plot_0}}x normal for this time of day")
alertcondition(isDryUp,   title="Volume Dry-Up", message="[CS] Volume dry-up — {{plot_0}}x of normal. Unusually quiet.")

plot(rvol, "RVOL", display=display.none)
