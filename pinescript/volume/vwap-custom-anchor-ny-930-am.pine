//@version=6
indicator(title="Levels Pro - 9:30 AM Anchor (Clean)", shorttitle="VWAP 9:30", overlay=true)

// ==========================================
// SECTION 1: INPUTS
// ==========================================
anchor_hour   = input.int(9, "Reset Hour (EST/Exchange)", minval=0, maxval=23)
anchor_minute = input.int(30, "Reset Minute (EST/Exchange)", minval=0, maxval=59)
src           = input(hlc3, "Source")

// ==========================================
// SECTION 2: THE RESET ENGINE
// ==========================================
// Check for the 9:30 AM candle and the start of a new calendar day
isNewDay = ta.change(time("D", "America/New_York")) != 0
isAnchorTime = hour(time, "America/New_York") == anchor_hour and minute(time, "America/New_York") == anchor_minute

// Persistent variables for calculation
var float sumSrcVol = 0.0
var float sumVol    = 0.0
var bool  active    = false

// Logic: Reset and start at 9:30 AM. Stop at end of day.
if isAnchorTime
    active    := true
    sumSrcVol := src * volume
    sumVol    := volume
else if isNewDay
    active    := false 
    sumSrcVol := 0.0
    sumVol    := 0.0
else if active
    sumSrcVol += src * volume
    sumVol    += volume

// Final Calculation
float customVwap = active and sumVol > 0 ? sumSrcVol / sumVol : na

// ==========================================
// SECTION 3: PLOTTING
// ==========================================
plot(customVwap, "9:30 AM VWAP", color=color.new(#ff00ff, 0), linewidth=1, style=plot.style_linebr)
