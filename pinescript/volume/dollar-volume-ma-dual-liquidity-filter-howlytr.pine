//@version=5
indicator("Dollar Volume & MA- Dual Liquidity Filter [HowlyTr]", overlay=true)

// --- Parámetros de Configuración ---
i_length     = input.int(20, "Longitud del Promedio", minval=1)
i_offset     = input.int(0, "Desplazamiento Vertical (Nº de filas)", minval=0, maxval=20)
i_show_dec   = input.bool(true, "Mostrar Decimales")

// --- Umbrales Críticos ---
i_min_act    = input.float(500000, "Mínimo USD Actual (Filtro Rojo)", minval=0, step=100000)
i_min_prom   = input.float(2000000, "Mínimo USD Promedio (Filtro Rojo)", minval=0, step=100000)

// --- Parámetros de Color ---
c_title_act  = input.color(color.white, "Color Título Vol USD")
c_value_act  = input.color(color.white, "Color Valor Vol USD")
c_title_prom = input.color(color.gray,  "Color Título Promedio")
c_value_prom = input.color(color.gray,  "Color Valor Promedio")
c_alert      = color.red

// --- Cálculos ---
vol_usd_actual = volume * close
vol_usd_prom   = ta.sma(vol_usd_actual, i_length)

// --- Formateo de Números ---
format_usd(val, show_dec) =>
    dec_format = show_dec ? "#.##" : "#"
    if val >= 1000000000
        str.tostring(val / 1000000000, dec_format) + "B"
    else if val >= 1000000
        str.tostring(val / 1000000, dec_format) + "M"
    else if val >= 1000
        str.tostring(val / 1000, dec_format) + "K"
    else
        str.tostring(val, dec_format)

// --- Lógica de la Tabla ---
var table vol_table = table.new(position.top_right, 2, 30)

if barstate.islast
    table.clear(vol_table, 0, 0, 1, 29)
    
    // Relleno para desplazamiento
    if i_offset > 0
        for i = 0 to i_offset - 1
            table.cell(vol_table, 0, i, " ", text_size=size.small)
            table.cell(vol_table, 1, i, " ", text_size=size.small)

    // Lógica de alerta independiente
    color color_act  = vol_usd_actual < i_min_act  ? c_alert : c_value_act
    color color_prom = vol_usd_prom   < i_min_prom ? c_alert : c_value_prom

    // Fila Volumen Actual
    table.cell(vol_table, 0, i_offset, "Vol USD:", text_color=c_title_act, text_halign=text.align_left)
    table.cell(vol_table, 1, i_offset, format_usd(vol_usd_actual, i_show_dec), text_color=color_act, text_halign=text.align_right)
    
    // Fila Volumen Promedio
    table.cell(vol_table, 0, i_offset + 1, "Vol USD Prom:", text_color=c_title_prom, text_halign=text.align_left)
    table.cell(vol_table, 1, i_offset + 1, format_usd(vol_usd_prom, i_show_dec), text_color=color_prom, text_halign=text.align_right)
