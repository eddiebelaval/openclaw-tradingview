//@version=6
indicator("Dynamic Volume Histogram [DVH]", shorttitle="DVH", format=format.volume)

// === Volume Inputs ===
highVolThreshold  = input.float(10000000, title="High Volume Threshold", step=1000000)
showAvg           = input.bool(true,      title="Show Average Volume Line")
avgLen            = input.int(20,         title="Average Volume Length", minval=1)

// === Color Inputs ===
colorBullish     = input.color(color.green, title="Bullish Candle (Normal Volume)")
colorBearish     = input.color(color.red,   title="Bearish Candle (Normal Volume)")
colorBullHighVol = input.color(color.blue,  title="Bullish Candle (10M+ Volume)")
colorBearHighVol = input.color(color.black, title="Bearish Candle (10M+ Volume)")

// === Time Window Inputs ===
showWindow  = input.bool(true, title="Enable Time Window Analysis")
startHour   = input.int(15,    title="Start Hour (24h)",  minval=0, maxval=23)
startMinute = input.int(0,     title="Start Minute",      minval=0, maxval=59)
endHour     = input.int(15,    title="End Hour (24h)",    minval=0, maxval=23)
endMinute   = input.int(30,    title="End Minute",        minval=0, maxval=59)

// === Signal Volume Range Inputs ===
sigVolMin = input.float(9000000,  title="Signal Volume Min", step=1000000)
sigVolMax = input.float(20000000, title="Signal Volume Max", step=1000000)
sigThresh = input.int(8,          title="Signal Candle Count Threshold", minval=1)

// === Time Window Logic ===
barTimeMinutes = hour * 60 + minute
startMinutes   = startHour * 60 + startMinute
endMinutes     = endHour   * 60 + endMinute
inWindow       = showWindow and (barTimeMinutes >= startMinutes and barTimeMinutes < endMinutes)

// === Candle & Volume Logic ===
isBullish   = close >= open
isHighVol   = volume > highVolThreshold
inSigVolume = volume > sigVolMin and volume < sigVolMax

volColor = isBullish and isHighVol     ? colorBullHighVol :
           not isBullish and isHighVol ? colorBearHighVol :
           isBullish                   ? colorBullish :
                                         colorBearish

// === Count Logic ===
var int bullCount    = 0
var int bearCount    = 0
var int bullSigCount = 0  // bull candles within signal volume range
var int bearSigCount = 0  // bear candles within signal volume range

var int bullSnapshot    = 0
var int bearSnapshot    = 0
var int bullSigSnapshot = 0
var int bearSigSnapshot = 0

var bool wasInWindow = false

// Detect window END → save snapshot & reset
windowJustEnded = wasInWindow and not inWindow
if windowJustEnded
    bullSnapshot    := bullCount
    bearSnapshot    := bearCount
    bullSigSnapshot := bullSigCount
    bearSigSnapshot := bearSigCount
    bullCount       := 0
    bearCount       := 0
    bullSigCount    := 0
    bearSigCount    := 0

// Detect window START → reset live counters
windowJustStarted = not wasInWindow and inWindow
if windowJustStarted
    bullCount    := 0
    bearCount    := 0
    bullSigCount := 0
    bearSigCount := 0

// Count candles inside window
if inWindow
    if isBullish
        bullCount += 1
        if inSigVolume
            bullSigCount += 1
    else
        bearCount += 1
        if inSigVolume
            bearSigCount += 1

wasInWindow := inWindow

// === Display Values (live or snapshot) ===
displayBull    = inWindow ? bullCount    : bullSnapshot
displayBear    = inWindow ? bearCount    : bearSnapshot
displayBullSig = inWindow ? bullSigCount : bullSigSnapshot
displayBearSig = inWindow ? bearSigCount : bearSigSnapshot

// === Signal Logic ===
// Only consider candles within signal volume range
// BUY PUT  → bearish sig candles >= threshold
// BUY CALL → bullish sig candles >= threshold
// IGNORE   → volume counts don't qualify

hasSigVolCandles = (displayBullSig + displayBearSig) > 0

signalValue = hasSigVolCandles and displayBearSig >= sigThresh ? 1 :
              hasSigVolCandles and displayBullSig >= sigThresh ? 2 :
              0  // 0 = IGNORE

// === Plot Volume Bars ===
plot(volume,
     title     = "Volume",
     style     = plot.style_columns,
     color     = volColor,
     linewidth = 1)

// === Average Volume Line ===
avgVol = ta.sma(volume, avgLen)
plot(showAvg ? avgVol : na,
     title     = "Avg Volume",
     color     = color.orange,
     linewidth = 2)

// === Status Line Plots ===
plot(showWindow ? displayBull : na,
     title   = "Bull Candles (Window)",
     color   = color.green,
     display = display.status_line)

plot(showWindow ? displayBear : na,
     title   = "Bear Candles (Window)",
     color   = color.red,
     display = display.status_line)

plot(showWindow ? displayBull + displayBear : na,
     title   = "Total Candles (Window)",
     color   = color.white,
     display = display.status_line)

// Signal shown as numeric code in status line with meaningful title
// 0 = IGNORE, 1 = BUY PUT, 2 = BUY CALL
plot(showWindow ? signalValue : na,
     title   = "0=IGNORE | 1=BUY PUT | 2=BUY CALL",
     color   = signalValue == 1 ? color.red :
               signalValue == 2 ? color.green :
                                  color.gray,
     display = display.status_line)

// === High Volume Label ===
if isHighVol
    label.new(bar_index, volume,
              text      = str.tostring(volume, format.volume),
              style     = label.style_label_down,
              color     = volColor,
              textcolor = color.white,
              size      = size.tiny)

// === Highlight Time Window Background ===
bgcolor(inWindow ? color.new(color.yellow, 88) : na, title="Time Window Highlight")
