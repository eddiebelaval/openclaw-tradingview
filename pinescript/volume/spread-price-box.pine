//@version=6
indicator("Spread Price Box", overlay=true)

// ---------
// Spread manual con info tooltip
// ---------
var string infoText = "To adjust the spread, you need to check the high price and subtract the low price of the index/pair you want to trade. Then put the result in this space."

manualSpread = input.float(0.82, "Spread Manual", step=0.01, tooltip=infoText)

// Otros inputs
boxColor = input.color(color.orange, "Color del rectángulo")
boxOpacity = input.int(70, "Opacity (0-100)", minval=0, maxval=100)

// ---------
// Variables spread fijo
// ---------
var float fixedSpread = na

if barstate.isnew
    fixedSpread := manualSpread

lastPrice = close

// Cajas superior e inferior
topUp = lastPrice + fixedSpread
bottomUp = lastPrice
topDown = lastPrice
bottomDown = lastPrice - fixedSpread

leftPos = bar_index
rightPos = bar_index + 1

var box boxUp = box.new(na, na, na, na)
var box boxDown = box.new(na, na, na, na)

box.set_left(boxUp, leftPos)
box.set_right(boxUp, rightPos)
box.set_top(boxUp, topUp)
box.set_bottom(boxUp, bottomUp)

box.set_left(boxDown, leftPos)
box.set_right(boxDown, rightPos)
box.set_top(boxDown, topDown)
box.set_bottom(boxDown, bottomDown)

box.set_border_color(boxUp, boxColor)
box.set_bgcolor(boxUp, color.new(boxColor, boxOpacity))

box.set_border_color(boxDown, boxColor)
box.set_bgcolor(boxDown, color.new(boxColor, boxOpacity))
