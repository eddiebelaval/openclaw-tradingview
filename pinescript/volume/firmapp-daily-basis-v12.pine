//@version=6
// FirmApp Daily Basis v1.3.4 - Ultimate Control
// Features: Precision 24h Rolling Volume, BTC Correlation, BTC.D & Smart Highlights
// Visuals: 100% restored classic v1.2 style. Independent UI toggles.
// Author: FirmApp

indicator("FirmApp Daily Basis", shorttitle="FirmApp DB", overlay=true)

// =========================================================================
// SETTINGS PANEL
// =========================================================================

// --- Group: Dashboard Settings (Top Panel) ---
grp_dash = "Dashboard Settings"
showDash = input.bool(true, title="Show Dashboard (Top)", group=grp_dash)
dashPos  = input.string("top_right", title="Dashboard Position", options=["top_right", "top_left", "bottom_right", "bottom_left"], group=grp_dash)
btcSymbol = input.symbol("BYBIT:BTCUSDT.P", title="Ticker for Correlation", group=grp_dash)
domSymbol = input.symbol("CRYPTOCAP:BTC.D", title="Ticker for Dominance", group=grp_dash)
dashSizeInput = input.string("normal", title="Dashboard Text Size", options=["small", "normal", "large"], group=grp_dash)

// Anomaly Thresholds
volHighMult = input.float(1.5, title="Volume Spike Threshold (x Avg)", group=grp_dash)
volLowMult = input.float(0.5, title="Volume Low Threshold (x Avg)", group=grp_dash)

// --- Group: Watermark Settings (Bottom Label) ---
grp_wm = "Watermark Settings"
showWatermark = input.bool(true, title="Show Watermark (Bottom)", group=grp_wm)
wmColor = input.color(color.new(color.gray, 40), title="Watermark Color", group=grp_wm)
wmSizeInput = input.string("normal", title="Watermark Size", options=["tiny", "small", "normal", "large", "huge", "auto"], group=grp_wm)

// --- Group: Fractal Settings ---
grp_frac = "Fractal Settings"
showFractals = input.bool(true, title="Show Fractals", group=grp_frac)

// Helper functions for sizes and positions
get_size(s) => s == "tiny" ? size.tiny : s == "small" ? size.small : s == "normal" ? size.normal : s == "large" ? size.large : s == "huge" ? size.huge : size.auto
get_pos(p) => p == "top_right" ? position.top_right : p == "top_left" ? position.top_left : p == "bottom_right" ? position.bottom_right : position.bottom_left

wmSize = get_size(wmSizeInput)
dashSize = get_size(dashSizeInput)
actualDashPos = get_pos(dashPos)

// =========================================================================
// DATA FETCHING & LOGIC
// =========================================================================
btcClose = request.security(btcSymbol, timeframe.period, close)
btcDom = request.security(domSymbol, timeframe.period, close)
dailyVolInQuote = request.security(syminfo.tickerid, "5", math.sum(volume * hlc3, 288))
avgVolWeek = request.security(syminfo.tickerid, "60", ta.sma(math.sum(volume * hlc3, 24), 168))
corr = ta.correlation(close, btcClose, 20)

volTextFormatted = dailyVolInQuote >= 1000000000 ? str.format("{0,number,#.##}B USDT", dailyVolInQuote / 1000000000) : str.format("{0,number,#.##}M USDT", dailyVolInQuote / 1000000)

// Background color logic (Dashboard only)
volBgColor = color.new(#434651, 10) 
if dailyVolInQuote > (avgVolWeek * volHighMult)
    volBgColor := #089981 // Solid TV Green
else if dailyVolInQuote < (avgVolWeek * volLowMult)
    volBgColor := #f23645 // Solid TV Red

// =========================================================================
// RENDER: DASHBOARD (Independent)
// =========================================================================
var table dashTable = table.new(actualDashPos, 1, 4, border_width=1, border_color=color.new(color.gray, 50))

if barstate.islast and showDash
    table.cell(dashTable, 0, 0, "Current Pair Data", text_color=color.white, bgcolor=color.new(#1c1e22, 10), text_size=size.tiny)
    table.cell(dashTable, 0, 1, "Daily Vol: " + volTextFormatted, text_color=color.white, bgcolor=volBgColor, text_size=dashSize)
    table.cell(dashTable, 0, 2, "BTC Correlation: " + str.tostring(corr, "#.##"), text_color=color.white, bgcolor=color.new(#434651, 10), text_size=dashSize)
    table.cell(dashTable, 0, 3, "BTC.D: " + str.tostring(btcDom, "#.##") + "%", text_color=color.white, bgcolor=color.new(#434651, 10), text_size=dashSize)

// =========================================================================
// RENDER: WATERMARK (Independent)
// =========================================================================
var table wmTable = table.new(position.bottom_center, 1, 1)
if barstate.islast and showWatermark
    dateStr = str.tostring(dayofmonth(time_close)) + "/" + str.tostring(month(time_close)) + "/" + str.tostring(year(time_close))
    tfText = timeframe.isminutes ? str.tostring(timeframe.multiplier) + "M" : timeframe.period
    watermarkText = dateStr + "\n" + syminfo.ticker + " | " + tfText
    table.cell(wmTable, 0, 0, watermarkText, text_color=wmColor, text_size=wmSize, text_halign=text.align_center)

// =========================================================================
// RENDER: FRACTALS
// =========================================================================
plotshape(showFractals and high[1] > high[2] and high[1] > high, style=shape.triangledown, location=location.abovebar, color=color.new(color.gray, 30), size=size.tiny, offset=-1)
plotshape(showFractals and low[1] < low[2] and low[1] < low, style=shape.triangleup, location=location.belowbar, color=color.new(color.gray, 30), size=size.tiny, offset=-1)
