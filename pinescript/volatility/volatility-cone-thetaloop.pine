//@version=6
indicator("Volatility Cone [ThetaLoop]", shorttitle="VolCone", overlay=false, precision=1)

// ═══════════════════════════════════════════════════════════════
//  VOLATILITY CONE — Is Vol Cheap or Expensive at Your DTE?
//  by ThetaLoop Research
//
//  You are about to sell a 14-day put. Is 25% realized vol
//  high or low for a 14-day window on this stock?
//  You have no idea — unless you have the full history.
//
//  This indicator computes realized volatility across
//  8 time windows (5d to 252d), ranks each against
//  its own history, and displays the classic cone that
//  institutional vol desks have used since the 1990s.
// ═══════════════════════════════════════════════════════════════

// ─── INPUTS ───────────────────────────────────────────────────
grp_hist = "History Depth"
hist_len = input.int(252, "History for Percentiles", minval=120, maxval=504, group=grp_hist,
                     tooltip="How far back to rank current vol. 252 = 1 year. 504 = 2 years.")

grp_style = "Display"
show_mode = input.string("Percentile Rank", "Main Plot",
                         options=["Percentile Rank", "Annualized Vol"], group=grp_style,
                         tooltip="Percentile shows where current vol sits in history (0-100). Annualized shows the raw number.")
show_current = input.bool(true, "Highlight current vol on cone", group=grp_style)

// ═══════════════════════════════════════════════════════════════
//  RV CALCULATION FOR EACH TENOR
// ═══════════════════════════════════════════════════════════════

// Parkinson RV function (inline for each window)
hl_sq(len) =>
    float hl = math.log(high / low)
    float pv = ta.sma(hl * hl, len) / (4.0 * math.log(2))
    math.sqrt(pv * 252) * 100

// Current RV at each tenor
float rv_5   = hl_sq(5)
float rv_10  = hl_sq(10)
float rv_20  = hl_sq(20)
float rv_30  = hl_sq(30)
float rv_60  = hl_sq(60)
float rv_90  = hl_sq(90)
float rv_120 = hl_sq(120)
float rv_252 = hl_sq(252)

// ═══════════════════════════════════════════════════════════════
//  PERCENTILE RANKING (where does current sit in history?)
// ═══════════════════════════════════════════════════════════════

pct_rank(src, lookback) =>
    int count = 0
    int total = 0
    for i = 1 to lookback
        if not na(src[i])
            total += 1
            if src[i] < src
                count += 1
    total > 0 ? (count / total) * 100.0 : 50.0

float pct_5   = pct_rank(rv_5,   hist_len)
float pct_10  = pct_rank(rv_10,  hist_len)
float pct_20  = pct_rank(rv_20,  hist_len)
float pct_30  = pct_rank(rv_30,  hist_len)
float pct_60  = pct_rank(rv_60,  hist_len)
float pct_90  = pct_rank(rv_90,  hist_len)
float pct_120 = pct_rank(rv_120, hist_len)
float pct_252 = pct_rank(rv_252, hist_len)

// ═══════════════════════════════════════════════════════════════
//  HISTORICAL MIN/MAX/MEDIAN FOR CONE BANDS
// ═══════════════════════════════════════════════════════════════

get_stats(src, lookback) =>
    float mn = src
    float mx = src
    float sm = 0.0
    int cnt = 0
    for i = 0 to lookback - 1
        if not na(src[i])
            mn := math.min(mn, src[i])
            mx := math.max(mx, src[i])
            sm += src[i]
            cnt += 1
    float avg = cnt > 0 ? sm / cnt : src
    [mn, mx, avg]

[min_5,   max_5,   avg_5]   = get_stats(rv_5,   hist_len)
[min_10,  max_10,  avg_10]  = get_stats(rv_10,  hist_len)
[min_20,  max_20,  avg_20]  = get_stats(rv_20,  hist_len)
[min_30,  max_30,  avg_30]  = get_stats(rv_30,  hist_len)
[min_60,  max_60,  avg_60]  = get_stats(rv_60,  hist_len)
[min_90,  max_90,  avg_90]  = get_stats(rv_90,  hist_len)
[min_120, max_120, avg_120] = get_stats(rv_120, hist_len)
[min_252, max_252, avg_252] = get_stats(rv_252, hist_len)

// ═══════════════════════════════════════════════════════════════
//  PLOT — Selected 20d tenor as time series
// ═══════════════════════════════════════════════════════════════

float main_val = show_mode == "Percentile Rank" ? pct_20 : rv_20

pct_col(float pct) =>
    pct > 85 ? color.red : pct > 65 ? color.orange : pct < 15 ? color.green : pct < 35 ? color.teal : color.white

plot(main_val, "20d RV", color=pct_col(pct_20), linewidth=2)

hline(show_mode == "Percentile Rank" ? 50 : na, "Median", color=color.new(color.gray, 50))
hline(show_mode == "Percentile Rank" ? 85 : na, "Expensive", color=color.new(color.red, 60), linestyle=hline.style_dashed)
hline(show_mode == "Percentile Rank" ? 15 : na, "Cheap", color=color.new(color.green, 60), linestyle=hline.style_dashed)

// ═══════════════════════════════════════════════════════════════
//  CONE TABLE — The main event
// ═══════════════════════════════════════════════════════════════

var table cone = table.new(position.top_right, 6, 10,
     bgcolor=color.new(color.black, 50), border_width=1, border_color=color.new(color.gray, 60))

vol_color(float pct) =>
    pct > 85 ? color.red : pct > 65 ? color.orange : pct < 15 ? color.green : pct < 35 ? color.teal : color.white

label_text(float pct) =>
    pct > 85 ? "EXPENSIVE" : pct > 65 ? "ELEVATED" : pct < 15 ? "CHEAP" : pct < 35 ? "LOW" : "FAIR"

if barstate.islast
    // Header
    table.cell(cone, 0, 0, "Tenor",    text_color=color.gray,  text_size=size.small, bgcolor=color.new(color.gray, 70))
    table.cell(cone, 1, 0, "Current",  text_color=color.gray,  text_size=size.small, bgcolor=color.new(color.gray, 70))
    table.cell(cone, 2, 0, "Rank",     text_color=color.gray,  text_size=size.small, bgcolor=color.new(color.gray, 70))
    table.cell(cone, 3, 0, "Avg",      text_color=color.gray,  text_size=size.small, bgcolor=color.new(color.gray, 70))
    table.cell(cone, 4, 0, "Min/Max",  text_color=color.gray,  text_size=size.small, bgcolor=color.new(color.gray, 70))
    table.cell(cone, 5, 0, "Status",   text_color=color.gray,  text_size=size.small, bgcolor=color.new(color.gray, 70))

    // 5d
    table.cell(cone, 0, 1, "5d",   text_color=color.white, text_size=size.small)
    table.cell(cone, 1, 1, str.tostring(rv_5, "#.#") + "%",   text_color=vol_color(pct_5), text_size=size.small)
    table.cell(cone, 2, 1, str.tostring(pct_5, "#") + "th",   text_color=vol_color(pct_5), text_size=size.small)
    table.cell(cone, 3, 1, str.tostring(avg_5, "#.#") + "%",  text_color=color.white, text_size=size.small)
    table.cell(cone, 4, 1, str.tostring(min_5, "#.#") + "-" + str.tostring(max_5, "#.#"), text_color=color.gray, text_size=size.small)
    table.cell(cone, 5, 1, label_text(pct_5), text_color=vol_color(pct_5), text_size=size.small)

    // 10d
    table.cell(cone, 0, 2, "10d",  text_color=color.white, text_size=size.small)
    table.cell(cone, 1, 2, str.tostring(rv_10, "#.#") + "%",  text_color=vol_color(pct_10), text_size=size.small)
    table.cell(cone, 2, 2, str.tostring(pct_10, "#") + "th",  text_color=vol_color(pct_10), text_size=size.small)
    table.cell(cone, 3, 2, str.tostring(avg_10, "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(cone, 4, 2, str.tostring(min_10, "#.#") + "-" + str.tostring(max_10, "#.#"), text_color=color.gray, text_size=size.small)
    table.cell(cone, 5, 2, label_text(pct_10), text_color=vol_color(pct_10), text_size=size.small)

    // 20d
    table.cell(cone, 0, 3, "20d",  text_color=color.white, text_size=size.small)
    table.cell(cone, 1, 3, str.tostring(rv_20, "#.#") + "%",  text_color=vol_color(pct_20), text_size=size.small)
    table.cell(cone, 2, 3, str.tostring(pct_20, "#") + "th",  text_color=vol_color(pct_20), text_size=size.small)
    table.cell(cone, 3, 3, str.tostring(avg_20, "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(cone, 4, 3, str.tostring(min_20, "#.#") + "-" + str.tostring(max_20, "#.#"), text_color=color.gray, text_size=size.small)
    table.cell(cone, 5, 3, label_text(pct_20), text_color=vol_color(pct_20), text_size=size.small)

    // 30d
    table.cell(cone, 0, 4, "30d",  text_color=color.white, text_size=size.small)
    table.cell(cone, 1, 4, str.tostring(rv_30, "#.#") + "%",  text_color=vol_color(pct_30), text_size=size.small)
    table.cell(cone, 2, 4, str.tostring(pct_30, "#") + "th",  text_color=vol_color(pct_30), text_size=size.small)
    table.cell(cone, 3, 4, str.tostring(avg_30, "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(cone, 4, 4, str.tostring(min_30, "#.#") + "-" + str.tostring(max_30, "#.#"), text_color=color.gray, text_size=size.small)
    table.cell(cone, 5, 4, label_text(pct_30), text_color=vol_color(pct_30), text_size=size.small)

    // 60d
    table.cell(cone, 0, 5, "60d",  text_color=color.white, text_size=size.small)
    table.cell(cone, 1, 5, str.tostring(rv_60, "#.#") + "%",  text_color=vol_color(pct_60), text_size=size.small)
    table.cell(cone, 2, 5, str.tostring(pct_60, "#") + "th",  text_color=vol_color(pct_60), text_size=size.small)
    table.cell(cone, 3, 5, str.tostring(avg_60, "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(cone, 4, 5, str.tostring(min_60, "#.#") + "-" + str.tostring(max_60, "#.#"), text_color=color.gray, text_size=size.small)
    table.cell(cone, 5, 5, label_text(pct_60), text_color=vol_color(pct_60), text_size=size.small)

    // 90d
    table.cell(cone, 0, 6, "90d",  text_color=color.white, text_size=size.small)
    table.cell(cone, 1, 6, str.tostring(rv_90, "#.#") + "%",  text_color=vol_color(pct_90), text_size=size.small)
    table.cell(cone, 2, 6, str.tostring(pct_90, "#") + "th",  text_color=vol_color(pct_90), text_size=size.small)
    table.cell(cone, 3, 6, str.tostring(avg_90, "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(cone, 4, 6, str.tostring(min_90, "#.#") + "-" + str.tostring(max_90, "#.#"), text_color=color.gray, text_size=size.small)
    table.cell(cone, 5, 6, label_text(pct_90), text_color=vol_color(pct_90), text_size=size.small)

    // 120d
    table.cell(cone, 0, 7, "120d", text_color=color.white, text_size=size.small)
    table.cell(cone, 1, 7, str.tostring(rv_120, "#.#") + "%", text_color=vol_color(pct_120), text_size=size.small)
    table.cell(cone, 2, 7, str.tostring(pct_120, "#") + "th", text_color=vol_color(pct_120), text_size=size.small)
    table.cell(cone, 3, 7, str.tostring(avg_120, "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(cone, 4, 7, str.tostring(min_120, "#.#") + "-" + str.tostring(max_120, "#.#"), text_color=color.gray, text_size=size.small)
    table.cell(cone, 5, 7, label_text(pct_120), text_color=vol_color(pct_120), text_size=size.small)

    // 252d
    table.cell(cone, 0, 8, "252d", text_color=color.white, text_size=size.small)
    table.cell(cone, 1, 8, str.tostring(rv_252, "#.#") + "%", text_color=vol_color(pct_252), text_size=size.small)
    table.cell(cone, 2, 8, str.tostring(pct_252, "#") + "th", text_color=vol_color(pct_252), text_size=size.small)
    table.cell(cone, 3, 8, str.tostring(avg_252, "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(cone, 4, 8, str.tostring(min_252, "#.#") + "-" + str.tostring(max_252, "#.#"), text_color=color.gray, text_size=size.small)
    table.cell(cone, 5, 8, label_text(pct_252), text_color=vol_color(pct_252), text_size=size.small)

    // Summary row
    float avg_pct = (pct_5 + pct_10 + pct_20 + pct_30 + pct_60 + pct_90 + pct_120 + pct_252) / 8.0
    string overall = avg_pct > 70 ? "VOL IS EXPENSIVE" : avg_pct < 30 ? "VOL IS CHEAP" : "VOL IS FAIR"
    color overall_col = avg_pct > 70 ? color.red : avg_pct < 30 ? color.green : color.teal
    table.cell(cone, 0, 9, "Overall", text_color=color.gray, text_size=size.small, bgcolor=color.new(color.gray, 70))
    table.cell(cone, 1, 9, "", bgcolor=color.new(color.gray, 70))
    table.cell(cone, 2, 9, str.tostring(avg_pct, "#") + "th", text_color=overall_col, text_size=size.small, bgcolor=color.new(color.gray, 70))
    table.cell(cone, 3, 9, "", bgcolor=color.new(color.gray, 70))
    table.cell(cone, 4, 9, "", bgcolor=color.new(color.gray, 70))
    table.cell(cone, 5, 9, overall, text_color=overall_col, text_size=size.normal, bgcolor=color.new(color.gray, 70))

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(pct_20 > 85, "20d Vol Expensive", "20-day realized volatility in top 15th percentile — premium is rich")
alertcondition(pct_20 < 15, "20d Vol Cheap",     "20-day realized volatility in bottom 15th percentile — premium is thin")
