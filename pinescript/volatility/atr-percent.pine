//@version=6
indicator("ATR Percent", overlay=true)

length = input.int(14, "ATR Length")
atrValue = ta.atr(length)
atrPercent = (atrValue / close) * 100

var label atrLabel = label.new(bar_index, high, "")

label.set_xy(atrLabel, bar_index, high)
label.set_text(atrLabel, "ATR%: " + str.tostring(atrPercent, "#.##") + "%")
label.set_style(atrLabel, label.style_label_down)
label.set_color(atrLabel, color.black)
label.set_textcolor(atrLabel, color.white)
