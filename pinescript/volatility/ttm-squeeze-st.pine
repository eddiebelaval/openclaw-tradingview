//@version=5

// 1. STANDARDIZATION: Name [ST]
indicator("TTM Squeeze [ST]", shorttitle="TTM [ST]", overlay=false)

// 2. VERSION CONTROL
string ver_num  = "v3.0"
string ver_date = "2026-02-09"

// ==========================================
// 1. INPUTS
// ==========================================
grp_bb = "Bollinger Bands Settings"
grp_kc = "Keltner Channel Settings"

// Bollinger Inputs
bbLength = input.int(20, "Length", group=grp_bb)
bbMult   = input.float(2.0, "MultiFactor", group=grp_bb)

// Keltner Inputs
kcLength = input.int(20, "Length", group=grp_kc)
kcMult   = input.float(1.5, "MultiFactor", group=grp_kc)

// ==========================================
// 2. CALCULATIONS
// ==========================================

// Bollinger Bands
// Optimized using built-in tuple function
[basis, upperBB, lowerBB] = ta.bb(close, bbLength, bbMult)

// Keltner Channels
// Manual calculation to ensure TTM logic (SMA of True Range)
maKC      = ta.sma(close, kcLength)
rangeKC   = ta.tr // True Range
rangemaKC = ta.sma(rangeKC, kcLength)
upperKC   = maKC + rangemaKC * kcMult
lowerKC   = maKC - rangemaKC * kcMult

// ==========================================
// 3. SQUEEZE LOGIC
// ==========================================
// Squeeze is ON when Bollinger Bands are completely INSIDE Keltner Channels
sqzOn = (lowerBB > lowerKC) and (upperBB < upperKC)

// ==========================================
// 4. PLOTTING
// ==========================================

// Colors: Red for Active Squeeze, Dark Gray for No Squeeze (Release)
color color_squeeze = color.new(color.red, 0)
color color_normal  = color.new(#363a45, 0) // Dark Lead Gray
color plotColor     = sqzOn ? color_squeeze : color_normal

// Plot dots on the zero line
plot(0, "Squeeze Dots", color=plotColor, style=plot.style_circles, linewidth=3)

// ==========================================
// 5. FOOTER (Hidden Info)
// ==========================================
// Just to keep track of version in the data window if needed, 
// though on separate pane indicators, text labels are less common.
// This variable ensures the compiler includes the version string.
var string version_id = ver_num + " (" + ver_date + ")"
