//@version=6
indicator("ATR% Credit Spread Strike Guide", shorttitle = "WSY CS Lvl", overlay=true)

// Inputs
atrLength   = input.int(20, "ATR Length", minval=1)
atrMultiple = input.int(3, "ATR% Multiple", minval=1, maxval=4)
priceSource = input.source(close, "Price Source")

showMode = input.string(
    "Both",
    "Show Levels",
    options = ["Both", "Lower Only", "Upper Only"]
)

showLabels = input.bool(true, "Show Last-Bar Labels")

// Core calculations
atrValue    = ta.atr(atrLength)
atrPct      = (atrValue / priceSource) * 100.0
distancePct = atrPct * atrMultiple

lowerLevel = priceSource * (1.0 - distancePct / 100.0)
upperLevel = priceSource * (1.0 + distancePct / 100.0)

showLower = showMode == "Both" or showMode == "Lower Only"
showUpper = showMode == "Both" or showMode == "Upper Only"

// Persistent line + label handles
var line  lowerLine = na
var line  upperLine = na
var label lowerLbl  = na
var label upperLbl  = na

// Update only on the last bar
if barstate.islast
    // Clear old drawings
    if not na(lowerLine)
        line.delete(lowerLine)
    if not na(upperLine)
        line.delete(upperLine)
    if not na(lowerLbl)
        label.delete(lowerLbl)
    if not na(upperLbl)
        label.delete(upperLbl)

    // Draw lower horizontal level
    if showLower
        lowerLine := line.new(
            x1 = bar_index,
            y1 = lowerLevel,
            x2 = bar_index + 1,
            y2 = lowerLevel,
            extend = extend.right,
            color = color.red,
            width = 2
        )

        if showLabels
            lowerText = "Lower Min Price\nATR%: " + str.tostring(atrPct, "#.##") + "%\nDistance: " + str.tostring(distancePct, "#.##") + "%\nLevel: " + str.tostring(lowerLevel, format.mintick)

            lowerLbl := label.new(
                x = bar_index + 1,
                y = lowerLevel,
                text = lowerText,
                style = label.style_label_left,
                color = color.red,
                textcolor = color.white
            )

    // Draw upper horizontal level
    if showUpper
        upperLine := line.new(
            x1 = bar_index,
            y1 = upperLevel,
            x2 = bar_index + 1,
            y2 = upperLevel,
            extend = extend.right,
            color = color.green,
            width = 2
        )

        if showLabels
            upperText = "Upper Min Price\nATR%: " + str.tostring(atrPct, "#.##") + "%\nDistance: " + str.tostring(distancePct, "#.##") + "%\nLevel: " + str.tostring(upperLevel, format.mintick)

            upperLbl := label.new(
                x = bar_index + 1,
                y = upperLevel,
                text = upperText,
                style = label.style_label_left,
                color = color.green,
                textcolor = color.white
            )
