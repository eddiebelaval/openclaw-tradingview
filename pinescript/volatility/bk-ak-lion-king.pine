alertcondition(bearBreakSig,          title="Death Drop",          message="ZENITH LION FP: 💀 DEATH DROP - GO SHORT!")
alertcondition(bullPeakSig,           title="Bull Peak",           message="ZENITH LION FP: 👑 Bull peak")
alertcondition(bearPeakSig,           title="Bear Peak",           message="ZENITH LION FP: 👑 Bear peak")
alertcondition(regBullDivSig,         title="Diamond Bull",        message="ZENITH LION FP: 💎 DIAMOND bullish divergence")
alertcondition(regBearDivSig,         title="Diamond Bear",        message="ZENITH LION FP: 💎 DIAMOND bearish divergence")
alertcondition(hidBullDivStartSig,    title="Hidden Bull Start",   message="ZENITH LION FP: 🎭 HIDDEN BULL — continuation ACTIVE")
alertcondition(hidBullDivEndSig,      title="Hidden Bull End",     message="ZENITH LION FP: 🎭 HIDDEN BULL — condition EXHAUSTED")
alertcondition(hidBearDivStartSig,    title="Hidden Bear Start",   message="ZENITH LION FP: 🎭 HIDDEN BEAR — continuation ACTIVE")
alertcondition(hidBearDivEndSig,      title="Hidden Bear End",     message="ZENITH LION FP: 🎭 HIDDEN BEAR — condition EXHAUSTED")
alertcondition(bullTrapSig,           title="Bull Trap",           message="ZENITH LION FP: ⚠️ Trap detected! (Bull)")
alertcondition(bearTrapSig,           title="Bear Trap",           message="ZENITH LION FP: ⚠️ Trap detected! (Bear)")
alertcondition(climacticSig,          title="Bleed",               message="ZENITH LION FP: 🩸 BLEED - Climactic extreme volume")
alertcondition(threeDriveSig,         title="Tank Empty",          message="ZENITH LION FP: ⛽ TANK EMPTY - 3-drive exhaustion")
alertcondition(fpDeltaBearDivSig,     title="FP Distribution",    message="ZENITH LION FP: 🔻 DISTRIBUTION — delta diverging at bull peak")
alertcondition(fpDeltaBullDivSig,     title="FP Accumulation",    message="ZENITH LION FP: 🔺 ACCUMULATION — delta diverging at bear peak")
alertcondition(compressImbalanceBull, title="FP Bull Imbalance",  message="ZENITH LION FP: 🧲 BUY IMBALANCE stacked in compression")
alertcondition(compressImbalanceBear, title="FP Bear Imbalance",  message="ZENITH LION FP: 🧲 SELL IMBALANCE stacked in compression")
