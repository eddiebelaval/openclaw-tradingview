//@version=5
indicator("ATR Tight Risk Stats", overlay=true)

// הגדרות - שיניתי את המכפיל ל-1.0 כדי להגיע ל-305
atrLen    = input.int(14, "ATR Period")
multi     = input.float(1.05, "Stop Multiplier (ATR)", step=0.1)

// חישובים
atrValue      = ta.atr(atrLen)
volatilityPct = (atrValue / close) * 100

// רמות לפי המכפיל החדש
suggestedStop   = close - (atrValue * multi)
suggestedTarget = close + (atrValue * multi * 2)

// תצוגה בשורת הסטטוס
plot(atrValue, "ATR", color=color.new(color.white, 100))
plot(volatilityPct, "Volat %", color=color.new(color.white, 100))
plot(suggestedStop, "Stop Loss", color=color.new(color.white, 100))
plot(suggestedTarget, "Target", color=color.new(color.white, 100))

// קווים על הגרף
var line stopLine = line.new(na, na, na, na, color=color.red, width=2)
if barstate.islast
    line.set_xy1(stopLine, bar_index - 10, suggestedStop)
    line.set_xy2(stopLine, bar_index + 10, suggestedStop)
