//@version=6
indicator("ATR+ADX Quiet Dashboard + VWAP Slope + Trade Summary", overlay=true)

// =====================
// Inputs
// =====================
atrLen      = input.int(14, "ATR length", minval=1)
adxLen      = input.int(14, "ADX length", minval=1)
maType      = input.string("SMA", "Average type", options=["SMA","EMA"])
showTable   = input.bool(true, "Show dashboard")

useAtrQuartileGate = input.bool(false, "ATR extra gate: require ATR <= Q50 (all windows)")
useAdxGate         = input.bool(true, "ADX gate for QUIET status")
adxGateMax         = input.float(20.0, "ADX gate max", step=0.5)

displayMode = input.string("Percent", "ATR display mode", options=["Percent","Points","Both"])

// VWAP slope
vwapSlopeLookback = input.int(3, "VWAP slope lookback bars", minval=1)
vwapFlatTicks     = input.float(2.0, "VWAP flat threshold (ticks)", step=0.25)

// =====================
// Helpers
// =====================
f_avg(src, len) =>
    maType == "EMA" ? ta.ema(src, len) : ta.sma(src, len)

f_quart(x, q25, q50, q75) =>
    string s = ""
    if x <= q25
        s := "Q1"
    else if x <= q50
        s := "Q2"
    else if x <= q75
        s := "Q3"
    else
        s := "Q4"
    s

f_lmh(x, q25, q50, q75) =>
    string s = ""
    if x <= q25
        s := "LOW"
    else if x <= q75
        s := "MID"
    else
        s := "HIGH"
    s

f_colorAtr(x, q25, q50, q75) =>
    color c = color.new(color.red, 85)
    if x <= q25
        c := color.new(color.green, 85)
    else if x <= q50
        c := color.new(color.teal, 85)
    else if x <= q75
        c := color.new(color.orange, 85)
    else
        c := color.new(color.red, 85)
    c

f_colorAdx(adxVal) =>
    color c = color.new(color.red, 80)
    if adxVal < 20
        c := color.new(color.green, 80)
    else if adxVal < 30
        c := color.new(color.orange, 80)
    else
        c := color.new(color.red, 80)
    c

f_vwapSlopeLabel(slope, threshold) =>
    string s = ""
    if na(slope)
        s := "n/a"
    else if slope > threshold
        s := "UP"
    else if slope < -threshold
        s := "DOWN"
    else
        s := "FLAT"
    s

f_vwapSlopeColor(slope, threshold) =>
    color c = color.new(color.gray, 85)
    if na(slope)
        c := color.new(color.gray, 85)
    else if slope > threshold
        c := color.new(color.green, 80)
    else if slope < -threshold
        c := color.new(color.red, 80)
    else
        c := color.new(color.orange, 80)
    c

fmtPct(x) => str.tostring(x * 100.0, "#.##") + "%"
fmtPts(x) => str.tostring(x, "#.##") + "p"
fmtAdx(x) => str.tostring(x, "#.#")

fmtVal(pct, pts) =>
    displayMode == "Percent" ? fmtPct(pct) :
     displayMode == "Points" ? fmtPts(pts) :
     (fmtPct(pct) + " / " + fmtPts(pts))

// =====================
// Core: ATR points + ATR%
// =====================
float atrPts = ta.atr(atrLen)
float atrPct = atrPts / close

[_, __, adxVal] = ta.dmi(adxLen, adxLen)

// =====================
// Window lengths
// =====================
float tfSecRaw = timeframe.in_seconds(timeframe.period)
int tfSec = int(math.max(1, tfSecRaw))
int len1h = math.max(1, int(math.round(3600 / tfSec)))
int len4h = math.max(1, int(math.round(14400 / tfSec)))

// =====================
// 1H & 4H ATR
// =====================
float avg1h_pts = f_avg(atrPts, len1h)
float avg4h_pts = f_avg(atrPts, len4h)

float avg1h_pct = f_avg(atrPct, len1h)
float avg4h_pct = f_avg(atrPct, len4h)

float q25_1h = ta.percentile_linear_interpolation(atrPct, len1h, 25)
float q50_1h = ta.percentile_linear_interpolation(atrPct, len1h, 50)
float q75_1h = ta.percentile_linear_interpolation(atrPct, len1h, 75)

float q25_4h = ta.percentile_linear_interpolation(atrPct, len4h, 25)
float q50_4h = ta.percentile_linear_interpolation(atrPct, len4h, 50)
float q75_4h = ta.percentile_linear_interpolation(atrPct, len4h, 75)

// =====================
// 4D ATR on Daily TF
// =====================
float avg4d_pts = request.security(syminfo.tickerid, "D", maType == "EMA" ? ta.ema(ta.atr(atrLen), 4) : ta.sma(ta.atr(atrLen), 4), barmerge.gaps_off, barmerge.lookahead_off)
float avg4d_pct = request.security(syminfo.tickerid, "D", maType == "EMA" ? ta.ema(ta.atr(atrLen) / close, 4) : ta.sma(ta.atr(atrLen) / close, 4), barmerge.gaps_off, barmerge.lookahead_off)

float q25_4d = request.security(syminfo.tickerid, "D", ta.percentile_linear_interpolation(ta.atr(atrLen) / close, 4, 25), barmerge.gaps_off, barmerge.lookahead_off)
float q50_4d = request.security(syminfo.tickerid, "D", ta.percentile_linear_interpolation(ta.atr(atrLen) / close, 4, 50), barmerge.gaps_off, barmerge.lookahead_off)
float q75_4d = request.security(syminfo.tickerid, "D", ta.percentile_linear_interpolation(ta.atr(atrLen) / close, 4, 75), barmerge.gaps_off, barmerge.lookahead_off)

// =====================
// QUIET logic
// =====================
bool quietByAvgs = (atrPct < avg1h_pct) and (atrPct < avg4h_pct) and (atrPct < avg4d_pct)
bool quietByQuart = (atrPct <= q50_1h) and (atrPct <= q50_4h) and (atrPct <= q50_4d)
bool atrOk = useAtrQuartileGate ? (quietByAvgs and quietByQuart) : quietByAvgs
bool adxOk = useAdxGate ? (adxVal < adxGateMax) : true
bool tradeAllowed = atrOk and adxOk

// =====================
// VWAP slope
// =====================
float flatThreshold = vwapFlatTicks * syminfo.mintick

float vwapCurr = ta.vwap(hlc3)
float vwapSlopeCurr = vwapCurr - vwapCurr[vwapSlopeLookback]

float vwapSlope1h = request.security(syminfo.tickerid, "60", ta.vwap(hlc3) - ta.vwap(hlc3)[vwapSlopeLookback], barmerge.gaps_off, barmerge.lookahead_off)
float vwapSlope4h = request.security(syminfo.tickerid, "240", ta.vwap(hlc3) - ta.vwap(hlc3)[vwapSlopeLookback], barmerge.gaps_off, barmerge.lookahead_off)

float vwapSlope4d = na

// =====================
// VWAP alignment for trading decision
// =====================
float vwap1m  = request.security(syminfo.tickerid, "1",  ta.vwap(hlc3), barmerge.gaps_off, barmerge.lookahead_off)
float vwap15m = request.security(syminfo.tickerid, "15", ta.vwap(hlc3), barmerge.gaps_off, barmerge.lookahead_off)
float vwap60m = request.security(syminfo.tickerid, "60", ta.vwap(hlc3), barmerge.gaps_off, barmerge.lookahead_off)

bool aboveAllVwaps = close > vwap1m and close > vwap15m and close > vwap60m
bool belowAllVwaps = close < vwap1m and close < vwap15m and close < vwap60m

// Logical summary:
// 1) ADX must be OK first
// 2) ATR must be OK
// 3) Then direction only if all VWAPs align
string tradeSummary = "NO"
color tradeSummaryBg = color.new(color.red, 80)

if adxOk and atrOk
    if aboveAllVwaps
        tradeSummary := "YES LONG"
        tradeSummaryBg := color.new(color.green, 75)
    else if belowAllVwaps
        tradeSummary := "YES SHORT"
        tradeSummaryBg := color.new(color.green, 75)
    else
        tradeSummary := "NO"
        tradeSummaryBg := color.new(color.red, 80)
else
    tradeSummary := "NO"
    tradeSummaryBg := color.new(color.red, 80)

// Small diagnostic text for why
string reasonTxt = ""
if not adxOk
    reasonTxt := "ADX BLOCK"
else if not atrOk
    reasonTxt := "ATR BLOCK"
else if aboveAllVwaps
    reasonTxt := "VWAP LONG"
else if belowAllVwaps
    reasonTxt := "VWAP SHORT"
else
    reasonTxt := "VWAP MIXED"

// =====================
// Dashboard table
// =====================
var table t = table.new(position.top_right, 5, 9, border_width=1)

color bg    = color.new(color.white, 0)
color txt   = color.new(color.black, 0)
color okBg  = color.new(color.green, 80)
color badBg = color.new(color.red, 80)

f_set(c, r, s, bgc) =>
    table.cell(t, c, r, s, bgcolor=bgc, text_color=txt, text_size=size.tiny)

if showTable and barstate.islast
    // Row 0
    f_set(0, 0, "ATR", bg)
    f_set(1, 0, fmtVal(atrPct, atrPts), bg)
    f_set(2, 0, "STATE", bg)
    f_set(3, 0, tradeAllowed ? "QUIET" : "NO", tradeAllowed ? okBg : badBg)
    f_set(4, 0, "VWAP", bg)

    // Row 1
    string gateTxt = useAdxGate ? ("<" + str.tostring(adxGateMax, "#.#")) : "OFF"
    f_set(0, 1, "ADX", bg)
    f_set(1, 1, fmtAdx(adxVal), bg)
    f_set(2, 1, "GATE", bg)
    f_set(3, 1, gateTxt, useAdxGate ? (adxOk ? okBg : badBg) : bg)
    f_set(4, 1, "SLP", bg)

    // Row 2
    f_set(0, 2, "WIN", bg)
    f_set(1, 2, "AVG", bg)
    f_set(2, 2, "LMH", bg)
    f_set(3, 2, "Q", bg)
    f_set(4, 2, "SLOPE", bg)

    // Row 3: CURR
    color c0 = f_colorAtr(atrPct, q25_1h, q50_1h, q75_1h)
    color vs0 = f_vwapSlopeColor(vwapSlopeCurr, flatThreshold)
    f_set(0, 3, "CURR", bg)
    f_set(1, 3, fmtVal(atrPct, atrPts), bg)
    f_set(2, 3, f_lmh(atrPct, q25_1h, q50_1h, q75_1h), c0)
    f_set(3, 3, f_quart(atrPct, q25_1h, q50_1h, q75_1h), bg)
    f_set(4, 3, f_vwapSlopeLabel(vwapSlopeCurr, flatThreshold), vs0)

    // Row 4: 1H
    color c1 = f_colorAtr(atrPct, q25_1h, q50_1h, q75_1h)
    color vs1 = f_vwapSlopeColor(vwapSlope1h, flatThreshold)
    f_set(0, 4, "1H", bg)
    f_set(1, 4, fmtVal(avg1h_pct, avg1h_pts), bg)
    f_set(2, 4, f_lmh(atrPct, q25_1h, q50_1h, q75_1h), c1)
    f_set(3, 4, f_quart(atrPct, q25_1h, q50_1h, q75_1h), bg)
    f_set(4, 4, f_vwapSlopeLabel(vwapSlope1h, flatThreshold), vs1)

    // Row 5: 4H
    color c2 = f_colorAtr(atrPct, q25_4h, q50_4h, q75_4h)
    color vs2 = f_vwapSlopeColor(vwapSlope4h, flatThreshold)
    f_set(0, 5, "4H", bg)
    f_set(1, 5, fmtVal(avg4h_pct, avg4h_pts), bg)
    f_set(2, 5, f_lmh(atrPct, q25_4h, q50_4h, q75_4h), c2)
    f_set(3, 5, f_quart(atrPct, q25_4h, q50_4h, q75_4h), bg)
    f_set(4, 5, f_vwapSlopeLabel(vwapSlope4h, flatThreshold), vs2)

    // Row 6: 4D
    color c3 = f_colorAtr(atrPct, q25_4d, q50_4d, q75_4d)
    color vs3 = f_vwapSlopeColor(vwapSlope4d, flatThreshold)
    f_set(0, 6, "4D", bg)
    f_set(1, 6, fmtVal(avg4d_pct, avg4d_pts), bg)
    f_set(2, 6, f_lmh(atrPct, q25_4d, q50_4d, q75_4d), c3)
    f_set(3, 6, f_quart(atrPct, q25_4d, q50_4d, q75_4d), bg)
    f_set(4, 6, f_vwapSlopeLabel(vwapSlope4d, flatThreshold), vs3)

    // Row 7: original rule
    string ruleTxt = useAtrQuartileGate ? "<AVG&<=Q2" : "<AVG"
    ruleTxt := useAdxGate ? (ruleTxt + " & ADX<" + str.tostring(adxGateMax, "#.#")) : ruleTxt
    f_set(0, 7, "RULE", bg)
    f_set(1, 7, ruleTxt, bg)
    f_set(2, 7, "", bg)
    f_set(3, 7, "", bg)
    f_set(4, 7, "VWAP LKB " + str.tostring(vwapSlopeLookback), bg)

    // Row 8: final summary
    f_set(0, 8, "TRADE", bg)
    f_set(1, 8, tradeSummary, tradeSummaryBg)
    f_set(2, 8, "WHY", bg)
    f_set(3, 8, reasonTxt, tradeSummaryBg)
    f_set(4, 8, aboveAllVwaps ? "LONG" : belowAllVwaps ? "SHORT" : "MIXED", tradeSummaryBg)

// Optional marker
plotshape(tradeAllowed, title="QUIET regime (ATR+ADX)", style=shape.circle, size=size.tiny, location=location.top)
