//@version=5
indicator("Market Regime Detector [Trend + Volatility] - AI Trading Tech", overlay=true)

// ==========================================
// 1. INPUTS
// ==========================================
// Trend Settings (ADX)
adxLen = input.int(14, title="ADX Smoothing")
diLen = input.int(14, title="DI Length", tooltip="DI = Directional Indicator")
adxThreshold = input.int(25, title="Trend Threshold (ADX)") // Below 25 is usually choppy

// Volatility Settings (ATR)
atrLen = input.int(14, title="ATR Length")
volLookback = input.int(100, title="Avg Volatility Lookback") // Baseline for "High/Low" comparison

// Visual Settings
showBg = input.bool(true, title="Show Background Color")
showTable = input.bool(true, title="Show Dashboard")

// ==========================================
// 2. CALCULATIONS
// ==========================================
// --- Trend Calculation (ADX) ---
[diplus, diminus, adx] = ta.dmi(diLen, adxLen)
isTrending = adx > adxThreshold
isChoppy = adx <= adxThreshold

// --- Volatility Calculation (Relative ATR) ---
// We compare current ATR to the average ATR of the last 100 bars (or user input)
atr = ta.atr(atrLen)
avgAtr = ta.sma(atr, volLookback)
isHighVol = atr > avgAtr
isLowVol = atr <= avgAtr

// Determine Direction (Bullish/Bearish)
isBullish = diplus > diminus
trendDir = isBullish ? "Bullish" : "Bearish"

// ==========================================
// 3. DETERMINE REGIME
// ==========================================
// There are 4 possible states:
// 1. Trending + High Vol (Explosive Move)
// 2. Trending + Low Vol (Slow Grind/Steady)
// 3. Choppy + High Vol (Violent Whip-saw/Dangerous)
// 4. Choppy + Low Vol (Sleep/Accumulation)

var string regime = ""
var color regimeColor = color.new(color.gray, 90)

if isTrending and isHighVol
    regime := "EXPLOSION (Trend + High Vol)"
    regimeColor := color.new(color.green, 85) // Green background
else if isTrending and isLowVol
    regime := "SLOW (Trend + Low Vol)"
    regimeColor := color.new(color.blue, 85) // Blue background
else if isChoppy and isHighVol
    regime := "CHOPPY (No Trend + High Vol)"
    regimeColor := color.new(color.red, 85) // Red background
else
    regime := "SLEEPING (No Trend + Low Vol)"
    regimeColor := color.new(color.gray, 85) // Gray background

// Plot Background
bgcolor(showBg ? regimeColor : na)

// ==========================================
// 4. DASHBOARD TABLE
// ==========================================
var table dash = table.new(position.bottom_right, 2, 4, bgcolor=color.new(color.black, 50), frame_color=color.gray, frame_width=1)

if showTable and barstate.islast
    // Header
    table.cell(dash, 0, 0, "Market Regime", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, regime, text_color=color.white, bgcolor=regimeColor, text_size=size.small)
    
    // Trend Status
    table.cell(dash, 0, 1, "Trend (ADX)", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(adx, "#.##") + (isTrending ? " (Strong)" : " (Weak)"), text_color=isTrending ? color.green : color.orange, text_size=size.small)

    // Volatility Status
    table.cell(dash, 0, 2, "Volatility (ATR)", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, isHighVol ? "HIGH" : "LOW", text_color=isHighVol ? color.red : color.gray, text_size=size.small)

    // Direction
    table.cell(dash, 0, 3, "Direction", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, trendDir, text_color=isBullish ? color.green : color.red, text_size=size.small)
