//@version=6
indicator("1 Contract Worth (30s ATR) — Minimal STEP", overlay=true, max_lines_count=200)

// -------------------- Inputs
tf           = input.timeframe("30S", "Timeframe")
length       = input.int(9, "ATR Length", minval=1)
waitForClose = input.bool(true, "Wait for Timeframe Close")
adjustmentPct= input.float(0.0, "Adjustment %", step=0.5)

showPoints   = input.bool(true, "Show Points")
showTicks    = input.bool(false, "Show Ticks")
showDollars  = input.bool(true, "Show 1-Contract $")

showLines    = input.bool(false, "Show Live Range Lines")
lineLenBars  = input.int(30, "Line Length (Bars)", minval=1)
lineColor    = input.color(color.new(color.blue, 0), "Range Line Color")

posOpt       = input.string("top_center", "Position", options=["top_left","top_center","top_right","bottom_left","bottom_center","bottom_right"])
sizeOpt      = input.string("normal", "Text Size", options=["tiny","small","normal","large","huge"])
bgColor      = input.color(color.new(color.black, 70), "Background Color")
txtColor     = input.color(color.white, "Text Color")

fallbackDollarsPerPoint = input.float(2.0, "Fallback $/Point (if unknown)", step=0.25)

// -------------------- Helpers (kept simple)
pos =
     posOpt == "top_left"      ? position.top_left :
     posOpt == "top_center"    ? position.top_center :
     posOpt == "top_right"     ? position.top_right :
     posOpt == "bottom_left"   ? position.bottom_left :
     posOpt == "bottom_center" ? position.bottom_center :
                                 position.bottom_right

txtSize =
     sizeOpt == "tiny"   ? size.tiny :
     sizeOpt == "small"  ? size.small :
     sizeOpt == "normal" ? size.normal :
     sizeOpt == "large"  ? size.large :
                           size.huge

// -------------------- Auto-detect $/point for NQ vs MNQ
sym  = str.upper(syminfo.ticker)
root = str.upper(syminfo.root)

float dollarsPerPoint = fallbackDollarsPerPoint
if (str.contains(sym, "MNQ") or str.contains(root, "MNQ"))
    dollarsPerPoint := 2.0
else if (str.contains(sym, "NQ") or str.contains(root, "NQ"))
    dollarsPerPoint := 20.0

// -------------------- STEP ATR from 30S timeframe
lookaheadMode = waitForClose ? barmerge.lookahead_off : barmerge.lookahead_on

// Built-in ATR on the 30-second timeframe.
// With lookahead_off this will update only when the 30s candle closes.
atr30 = request.security(syminfo.tickerid, tf, ta.atr(length), lookahead=lookaheadMode)

// Adjustment %
scale     = 1.0 + (adjustmentPct / 100.0)
pointsNow = atr30 * scale

tickSize  = syminfo.mintick
ticksNow  = tickSize > 0 ? (pointsNow / tickSize) : na

oneContractDollars = pointsNow * dollarsPerPoint

// -------------------- Optional live range lines
var line lTop = na
var line lBot = na

if showLines
    topY = close + pointsNow
    botY = close - pointsNow

    if na(lTop)
        lTop := line.new(bar_index, topY, bar_index + lineLenBars, topY, color=lineColor, width=2)
        lBot := line.new(bar_index, botY, bar_index + lineLenBars, botY, color=lineColor, width=2)
    else
        line.set_xy1(lTop, bar_index, topY)
        line.set_xy2(lTop, bar_index + lineLenBars, topY)
        line.set_color(lTop, lineColor)

        line.set_xy1(lBot, bar_index, botY)
        line.set_xy2(lBot, bar_index + lineLenBars, botY)
        line.set_color(lBot, lineColor)
else
    if not na(lTop)
        line.delete(lTop)
        line.delete(lBot)
        lTop := na
        lBot := na

// -------------------- Table readout
var table t = table.new(pos, 1, 3, frame_color=color.new(color.black, 0), frame_width=0)

fmtPts(x) => str.tostring(x, format.mintick)
fmtNum(x) => str.tostring(x, "#.##")

row1 = showPoints  ? ("Points: " + fmtPts(pointsNow)) : ""
row2 = showDollars ? ("1 Contract: $" + fmtNum(oneContractDollars)) : ""

if barstate.islast
    table.cell(t, 0, 0, row1, text_color=txtColor, bgcolor=bgColor, text_size=txtSize)
    table.cell(t, 0, 2, row2, text_color=txtColor, bgcolor=bgColor, text_size=txtSize)
