//@version=6
strategy("V-Spike Reversal v3 [Location Filtered]",
     overlay = true,
     initial_capital = 100000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 2,
     commission_type = strategy.commission.percent,
     commission_value = 0.01)

// ————— INPUTS —————
atrMult     = input.float(1.3, "Spike ATR Multiplier", minval = 0.5)
wickPercent = input.float(0.5, "Min Wick % of Candle", minval = 0.2)
riskReward  = input.float(2.0, "Risk/Reward")

// ————— PREVIOUS DAY LEVELS —————
prevHigh = request.security(syminfo.tickerid, "D", high[1])
prevLow  = request.security(syminfo.tickerid, "D", low[1])

plot(prevHigh, "Prev Day High", color=color.orange)
plot(prevLow,  "Prev Day Low",  color=color.orange)

// ————— CALCULATIONS —————
atr = ta.atr(14)
barRange = high - low

upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

bullRejection = (
    barRange > atr * atrMult and
    lowerWick > barRange * wickPercent and
    low < prevLow
)

bearRejection = (
    barRange > atr * atrMult and
    upperWick > barRange * wickPercent and
    high > prevHigh
)

// ————— EXECUTION —————
if bullRejection
    entryPrice  = close
    stopPrice   = low
    targetPrice = entryPrice + (entryPrice - stopPrice) * riskReward
    strategy.entry("LongReversal", strategy.long)
    strategy.exit("ExitLong",
        from_entry = "LongReversal",
        stop  = stopPrice,
        limit = targetPrice)

if bearRejection
    entryPrice  = close
    stopPrice   = high
    targetPrice = entryPrice - (stopPrice - entryPrice) * riskReward
    strategy.entry("ShortReversal", strategy.short)
    strategy.exit("ExitShort",
        from_entry = "ShortReversal",
        stop  = stopPrice,
        limit = targetPrice)
