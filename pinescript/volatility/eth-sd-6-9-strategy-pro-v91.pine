//@version=5
indicator("ETH SD 6-9 Strategy Pro", overlay=true, max_boxes_count=30, max_lines_count=70, max_labels_count=60)

// ==================== TIME SETTINGS ====================
sessionStart = input.session("0600-0900", "6-9 AM Range", group="Time Settings")
timeZone = input.string("UTC-5", "Timezone (UTC Offset)", options=["UTC-12", "UTC-11", "UTC-10", "UTC-9", "UTC-8", "UTC-7", "UTC-6", "UTC-5", "UTC-4", "UTC-3", "UTC-2", "UTC-1", "UTC", "UTC+1", "UTC+2", "UTC+3", "UTC+4", "UTC+5", "UTC+6", "UTC+7", "UTC+8", "UTC+9", "UTC+10", "UTC+11", "UTC+12"], group="Time Settings")

// ==================== DISPLAY SETTINGS ====================
showSDLevels = input.bool(true, "Show SD Levels", group="Display")
showPriceLabels = input.bool(true, "Show Price Labels", group="Display")
labelSize = input.string("Small", "Label Size", options=["Tiny", "Small", "Normal", "Large"], group="Display")
showDashboard = input.bool(true, "Show Dashboard", group="Display")
dashboardPosition = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="Display")
lineExtension = input.int(30, "Line Extension (bars)", minval=0, maxval=200, group="Display", tooltip="How many bars to extend lines to the right")

// RTH Highlighting
showRTHCandles = input.bool(true, "Highlight RTH Candles (9:30+)", group="Display")
rthCandleColor = input.color(color.new(#2962FF, 85), "RTH Highlight Color", group="Display")

// ==================== ETH SESSION LEVELS ====================
showONSLevels = input.bool(true, "Show ONS H/L", group="ETH Session Levels")
onsSession = input.session("1800-0600", "ONS Session Time", group="ETH Session Levels", tooltip="Default: 6 PM to 6 AM ET (1800-0600). Format uses 24-hour time.")
onsLineStyle = input.string("Dashed", "ONS Line Style", options=["Solid", "Dashed", "Dotted"], group="ETH Session Levels")
keepONSAfterSweep = input.bool(true, "Keep Lines After Sweep", group="ETH Session Levels", tooltip="Keep ONS lines visible after they're swept (shown as dotted gray)")


// ==================== KEY STRATEGY ELEMENTS ====================
show940_950Window = input.bool(true, "Show 9:40-9:50 Reversal Window", group="Strategy Elements")
showQuartiles = input.bool(true, "Show 25%/75% Quartiles", group="Strategy Elements")

// ==================== MEAN REVERSION BOXES ====================
showBox033_066 = input.bool(true, "Show ±0.33/0.66 Box", group="Mean Reversion Zones")
boxColor033_066 = input.color(color.new(color.teal, 90), "±0.33/0.66 Box Color", group="Mean Reversion Zones")
showMeanRevBoxes = input.bool(true, "Show R/R Zone Boxes (±1.33/1.66)", group="Mean Reversion Zones")
boxColorRR = input.color(color.new(color.orange, 90), "R/R Zone Box Color", group="Mean Reversion Zones")

// ==================== EDGE DETECTION ====================
minRangeSize = input.float(60.0, "Minimum Range Size (pts)", group="Edge Detection")
maxRangeSize = input.float(200.0, "Maximum Range Size (pts)", group="Edge Detection")
onsMultiplier = input.float(1.5, "Extended ONS Multiplier", group="Edge Detection")

// ==================== LINE COLORS & STYLES ====================
colorHL = input.color(color.gray, "6-9 High/Low", inline="hl", group="Line Colors")
widthHL = input.int(2, "", inline="hl", group="Line Colors")
styleHL = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], inline="hl", group="Line Colors")

colorEQ = input.color(color.gray, "Equilibrium", inline="eq", group="Line Colors")
widthEQ = input.int(2, "", inline="eq", group="Line Colors")
styleEQ = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], inline="eq", group="Line Colors")

colorOpen = input.color(color.gray, "Open", inline="open", group="Line Colors")
widthOpen = input.int(1, "", inline="open", group="Line Colors")
styleOpen = input.string("Dotted", "", options=["Solid", "Dashed", "Dotted"], inline="open", group="Line Colors")

colorQuartiles = input.color(color.gray, "25%/75%", inline="q", group="Line Colors")
widthQuartiles = input.int(1, "", inline="q", group="Line Colors")
styleQuartiles = input.string("Dotted", "", options=["Solid", "Dashed", "Dotted"], inline="q", group="Line Colors")

// Individual SD Level Colors
colorSD05 = input.color(color.gray, "±0.5 SD", inline="sd05", group="Line Colors")
widthSD05 = input.int(3, "", inline="sd05", group="Line Colors")
styleSD05 = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], inline="sd05", group="Line Colors")

colorSD10 = input.color(color.gray, "±1.0 SD", inline="sd10", group="Line Colors")
widthSD10 = input.int(1, "", inline="sd10", group="Line Colors")
styleSD10 = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], inline="sd10", group="Line Colors")

colorSD20 = input.color(color.gray, "±2.0 SD", inline="sd20", group="Line Colors")
widthSD20 = input.int(1, "", inline="sd20", group="Line Colors")
styleSD20 = input.string("Dotted", "", options=["Solid", "Dashed", "Dotted"], inline="sd20", group="Line Colors")

colorRR = input.color(color.gray, "R/R Zone (±1.33/1.66)", inline="rr", group="Line Colors")
widthRR = input.int(1, "", inline="rr", group="Line Colors")
styleRR = input.string("Dotted", "", options=["Solid", "Dashed", "Dotted"], inline="rr", group="Line Colors")

colorONS = input.color(color.gray, "ONS High/Low", inline="ons", group="Line Colors")
widthONS = input.int(2, "", inline="ons", group="Line Colors")

// Convert ONS line style string to Pine Script constant
onsStyle = onsLineStyle == "Solid" ? line.style_solid : onsLineStyle == "Dotted" ? line.style_dotted : line.style_dashed

// Helper function to convert style strings
getLineStyle(string style) =>
    style == "Solid" ? line.style_solid : style == "Dotted" ? line.style_dotted : line.style_dashed

// Helper function to convert label size
getLabelSize(string size) =>
    size == "Tiny" ? size.tiny : size == "Small" ? size.small : size == "Large" ? size.large : size.normal

// Parse 6-9 session
sessionParts = str.split(sessionStart, "-")
startTime = array.get(sessionParts, 0)
endTime = array.get(sessionParts, 1)
startHour = str.tonumber(str.substring(startTime, 0, 2))
startMin = str.tonumber(str.substring(startTime, 2, 4))
endHour = str.tonumber(str.substring(endTime, 0, 2))
endMin = str.tonumber(str.substring(endTime, 2, 4))

// Parse ONS session
onsParts = str.split(onsSession, "-")
onsStartTime = array.get(onsParts, 0)
onsEndTime = array.get(onsParts, 1)
onsStartHour = str.tonumber(str.substring(onsStartTime, 0, 2))
onsStartMin = str.tonumber(str.substring(onsStartTime, 2, 4))
onsEndHour = str.tonumber(str.substring(onsEndTime, 0, 2))
onsEndMin = str.tonumber(str.substring(onsEndTime, 2, 4))

currentHour = hour(time, timeZone)
currentMin = minute(time, timeZone)

// ==================== 6-9 RANGE STORAGE ====================
var line lineHigh = na
var line lineLow = na
var line lineOpen = na
var line lineEQ = na
var line lineQ25 = na
var line lineQ75 = na

var line lineMR05h = na
var line lineMR05l = na
var line lineMR10h = na
var line lineMR10l = na
var line lineMR20h = na
var line lineMR20l = na

var line lineRR133h = na
var line lineRR133l = na
var line lineRR166h = na
var line lineRR166l = na

var box box033_066_upper = na
var box box033_066_lower = na
var box boxRR_upper = na
var box boxRR_lower = na

var label lblHigh = na
var label lblLow = na
var label lblOpen = na
var label lblEQ = na
var label lblQ25 = na
var label lblQ75 = na
var label lblMR05h = na
var label lblMR05l = na
var label lblMR10h = na
var label lblMR10l = na
var label lblMR20h = na
var label lblMR20l = na
var label lblRR133h = na
var label lblRR133l = na
var label lblRR166h = na
var label lblRR166l = na

var float rangeHigh = na
var float rangeLow = na
var float rangeOpen = na
var int rangeStart = 0
var int highBar = 0
var int lowBar = 0
var bool drawn = false

// ==================== ONS STORAGE ====================
var float onsHigh = na
var float onsLow = na
var int onsHighBar = 0  // Track which bar made the ONS high
var int onsLowBar = 0   // Track which bar made the ONS low
var line lineONSHigh = na
var line lineONSLow = na
var label lblONSHigh = na
var label lblONSLow = na

// ONS Sweep Tracking (for Judas prediction)
var bool onsHighSwept = false
var bool onsLowSwept = false
var float onsHighValue = na  // Store for display even after sweep
var float onsLowValue = na
var int onsHighBarValue = 0  // Store bar index for line drawing
var int onsLowBarValue = 0

// ==================== TRACKING ====================
var float avgRangeSize = na
var int rangeCount = 0
var float onsRangeSize = na

// ==================== SESSION DETECTION ====================
in6_9Session = (currentHour > startHour or (currentHour == startHour and currentMin >= startMin)) and (currentHour < endHour or (currentHour == endHour and currentMin < endMin))

prevHour = hour(time[1], timeZone)
prevMin = minute(time[1], timeZone)
prev6_9Session = (prevHour > startHour or (prevHour == startHour and prevMin >= startMin)) and (prevHour < endHour or (prevHour == endHour and prevMin < endMin))

// ONS Session (customizable, default 6 PM to 6 AM ET)
// Handle sessions that cross midnight (e.g., 18:00-06:00)
onsSessionCrossesMidnight = onsEndHour < onsStartHour
bool inONSSession = false
if onsSessionCrossesMidnight
    // Session crosses midnight (e.g., 18:00-06:00)
    inONSSession := (currentHour > onsStartHour or (currentHour == onsStartHour and currentMin >= onsStartMin)) or (currentHour < onsEndHour or (currentHour == onsEndHour and currentMin < onsEndMin))
else
    // Session doesn't cross midnight (e.g., 02:00-08:00)
    inONSSession := (currentHour > onsStartHour or (currentHour == onsStartHour and currentMin >= onsStartMin)) and (currentHour < onsEndHour or (currentHour == onsEndHour and currentMin < onsEndMin))

// RTH Session (9:30 AM to 4:00 PM ET)
inRTHSession = (currentHour > 9 or (currentHour == 9 and currentMin >= 30)) and currentHour < 16

// 9:40-9:50 Reversal Window
in940_950Window = currentHour == 9 and currentMin >= 40 and currentMin <= 50

// ==================== ONS TRACKING ====================
if inONSSession
    if na(onsHigh) or high > onsHigh
        onsHigh := high
        onsHighBar := bar_index  // Track the bar that made this high
    if na(onsLow) or low < onsLow
        onsLow := low
        onsLowBar := bar_index  // Track the bar that made this low

// Reset ONS at session end - store values when we EXIT the ONS session
// This triggers when current bar is OUT of session but previous bar was IN
if not inONSSession and inONSSession[1]
    onsRangeSize := na(onsHigh) or na(onsLow) ? na : onsHigh - onsLow
    // Store values before reset for dashboard display
    onsHighValue := onsHigh
    onsLowValue := onsLow
    onsHighBarValue := onsHighBar  // Store bar indices for line drawing
    onsLowBarValue := onsLowBar
    // Reset tracking
    onsHigh := na
    onsLow := na
    onsHighBar := 0
    onsLowBar := 0
    onsHighSwept := false
    onsLowSwept := false

// Detect ONS sweeps after ONS session ends (6 AM onward)
// This includes pre-market (6-9 AM) AND RTH (9:30 AM+)
// Framework logic: track whether liquidity was purged BEFORE Judas window
if not inONSSession and not na(onsHighValue) and not na(onsLowValue)
    // Check if price swept ONS high
    if not onsHighSwept and high >= onsHighValue
        onsHighSwept := true
    
    // Check if price swept ONS low
    if not onsLowSwept and low <= onsLowValue
        onsLowSwept := true

// ==================== START NEW 6-9 RANGE ====================
if currentHour == startHour and currentMin == startMin and not prev6_9Session
    rangeHigh := high
    rangeLow := low
    rangeOpen := open
    rangeStart := bar_index
    highBar := bar_index
    lowBar := bar_index
    drawn := false
    
    // Delete old 6-9 objects
    line.delete(lineHigh)
    line.delete(lineLow)
    line.delete(lineOpen)
    line.delete(lineEQ)
    line.delete(lineQ25)
    line.delete(lineQ75)
    line.delete(lineMR05h)
    line.delete(lineMR05l)
    line.delete(lineMR10h)
    line.delete(lineMR10l)
    line.delete(lineMR20h)
    line.delete(lineMR20l)
    line.delete(lineRR133h)
    line.delete(lineRR133l)
    line.delete(lineRR166h)
    line.delete(lineRR166l)
    
    box.delete(box033_066_upper)
    box.delete(box033_066_lower)
    box.delete(boxRR_upper)
    box.delete(boxRR_lower)
    
    label.delete(lblHigh)
    label.delete(lblLow)
    label.delete(lblOpen)
    label.delete(lblEQ)
    label.delete(lblQ25)
    label.delete(lblQ75)
    label.delete(lblMR05h)
    label.delete(lblMR05l)
    label.delete(lblMR10h)
    label.delete(lblMR10l)
    label.delete(lblMR20h)
    label.delete(lblMR20l)
    label.delete(lblRR133h)
    label.delete(lblRR133l)
    label.delete(lblRR166h)
    label.delete(lblRR166l)
    
    // Delete old ONS objects
    line.delete(lineONSHigh)
    line.delete(lineONSLow)
    label.delete(lblONSHigh)
    label.delete(lblONSLow)

// ==================== UPDATE 6-9 RANGE ====================
if in6_9Session
    if high > rangeHigh
        rangeHigh := high
        highBar := bar_index
    if low < rangeLow
        rangeLow := low
        lowBar := bar_index

// ==================== CALCULATE LEVELS ====================
rangeSize = rangeHigh - rangeLow
rangeMid = (rangeHigh + rangeLow) / 2
valid = not na(rangeHigh) and not na(rangeLow)

// Quartiles (25%, 75%)
q25 = rangeLow + (rangeSize * 0.25)
q75 = rangeLow + (rangeSize * 0.75)

// Mean Reversion Levels
mr033_h = rangeHigh + (rangeSize * 0.33)
mr033_l = rangeLow - (rangeSize * 0.33)
mr066_h = rangeHigh + (rangeSize * 0.66)
mr066_l = rangeLow - (rangeSize * 0.66)
mr05_h = rangeHigh + (rangeSize * 0.5)
mr05_l = rangeLow - (rangeSize * 0.5)
mr10_h = rangeHigh + rangeSize
mr10_l = rangeLow - rangeSize
mr20_h = rangeHigh + (rangeSize * 2.0)
mr20_l = rangeLow - (rangeSize * 2.0)

// R/R Zone (Retracement/Reversal)
rr133_h = rangeHigh + (rangeSize * 1.33)
rr133_l = rangeLow - (rangeSize * 1.33)
rr166_h = rangeHigh + (rangeSize * 1.66)
rr166_l = rangeLow - (rangeSize * 1.66)

// ==================== DRAW 6-9 RANGE AT 9:00 AM ====================
if valid and not in6_9Session and prev6_9Session and not drawn
    drawn := true
    
    // Update tracking
    rangeCount += 1
    if na(avgRangeSize)
        avgRangeSize := rangeSize
    else
        avgRangeSize := (avgRangeSize * (rangeCount - 1) + rangeSize) / rangeCount
    
    // 6-9 Range Lines
    lineHigh := line.new(highBar, rangeHigh, bar_index + lineExtension, rangeHigh, color=colorHL, width=widthHL, style=getLineStyle(styleHL))
    lineLow := line.new(lowBar, rangeLow, bar_index + lineExtension, rangeLow, color=colorHL, width=widthHL, style=getLineStyle(styleHL))
    lineEQ := line.new(bar_index, rangeMid, bar_index + lineExtension, rangeMid, color=colorEQ, width=widthEQ, style=getLineStyle(styleEQ))
    lineOpen := line.new(bar_index, rangeOpen, bar_index + lineExtension, rangeOpen, color=colorOpen, width=widthOpen, style=getLineStyle(styleOpen))
    
    // Quartiles
    if showQuartiles
        lineQ25 := line.new(bar_index, q25, bar_index + lineExtension, q25, color=colorQuartiles, width=widthQuartiles, style=getLineStyle(styleQuartiles))
        lineQ75 := line.new(bar_index, q75, bar_index + lineExtension, q75, color=colorQuartiles, width=widthQuartiles, style=getLineStyle(styleQuartiles))
    
    // Mean Reversion Levels
    if showSDLevels
        // ±0.5 LEVELS - THE KEY LEVELS (86.46%)
        lineMR05h := line.new(bar_index, mr05_h, bar_index + lineExtension, mr05_h, color=colorSD05, width=widthSD05, style=getLineStyle(styleSD05))
        lineMR05l := line.new(bar_index, mr05_l, bar_index + lineExtension, mr05_l, color=colorSD05, width=widthSD05, style=getLineStyle(styleSD05))
        
        // ±1.0 LEVELS - Secondary targets (74%)
        lineMR10h := line.new(bar_index, mr10_h, bar_index + lineExtension, mr10_h, color=colorSD10, width=widthSD10, style=getLineStyle(styleSD10))
        lineMR10l := line.new(bar_index, mr10_l, bar_index + lineExtension, mr10_l, color=colorSD10, width=widthSD10, style=getLineStyle(styleSD10))
        
        // ±2.0 LEVELS
        lineMR20h := line.new(bar_index, mr20_h, bar_index + lineExtension, mr20_h, color=colorSD20, width=widthSD20, style=getLineStyle(styleSD20))
        lineMR20l := line.new(bar_index, mr20_l, bar_index + lineExtension, mr20_l, color=colorSD20, width=widthSD20, style=getLineStyle(styleSD20))
    
    // R/R Zone
    if showSDLevels
        lineRR133h := line.new(bar_index, rr133_h, bar_index + lineExtension, rr133_h, color=colorRR, width=widthRR, style=getLineStyle(styleRR))
        lineRR133l := line.new(bar_index, rr133_l, bar_index + lineExtension, rr133_l, color=colorRR, width=widthRR, style=getLineStyle(styleRR))
        lineRR166h := line.new(bar_index, rr166_h, bar_index + lineExtension, rr166_h, color=colorRR, width=widthRR, style=getLineStyle(styleRR))
        lineRR166l := line.new(bar_index, rr166_l, bar_index + lineExtension, rr166_l, color=colorRR, width=widthRR, style=getLineStyle(styleRR))
    
    // ±0.33/0.66 Box
    if showBox033_066
        box033_066_upper := box.new(bar_index, mr066_h, bar_index + lineExtension, mr033_h, border_color=na, bgcolor=boxColor033_066)
        box033_066_lower := box.new(bar_index, mr033_l, bar_index + lineExtension, mr066_l, border_color=na, bgcolor=boxColor033_066)
    
    // R/R Zone Boxes (±1.33/1.66)
    if showMeanRevBoxes
        boxRR_upper := box.new(bar_index, rr166_h, bar_index + lineExtension, rr133_h, border_color=color.new(colorRR, 70), bgcolor=boxColorRR)
        boxRR_lower := box.new(bar_index, rr133_l, bar_index + lineExtension, rr166_l, border_color=color.new(colorRR, 70), bgcolor=boxColorRR)
    
    // ONS High/Low Lines (attached to actual candles where high/low occurred)
    if showONSLevels and not na(onsHighValue) and not na(onsLowValue)
        // Draw ONS High line
        if not onsHighSwept
            // Active (unswept) line
            lineONSHigh := line.new(onsHighBarValue, onsHighValue, bar_index + lineExtension, onsHighValue, color=colorONS, width=widthONS, style=onsStyle)
        else if keepONSAfterSweep
            // Already swept but keep visible (dotted gray)
            lineONSHigh := line.new(onsHighBarValue, onsHighValue, bar_index + lineExtension, onsHighValue, color=color.gray, width=1, style=line.style_dotted)
        
        // Draw ONS Low line
        if not onsLowSwept
            // Active (unswept) line
            lineONSLow := line.new(onsLowBarValue, onsLowValue, bar_index + lineExtension, onsLowValue, color=colorONS, width=widthONS, style=onsStyle)
        else if keepONSAfterSweep
            // Already swept but keep visible (dotted gray)
            lineONSLow := line.new(onsLowBarValue, onsLowValue, bar_index + lineExtension, onsLowValue, color=color.gray, width=1, style=line.style_dotted)
    
    // 6-9 Labels - positioned to the RIGHT of lines
    highText = showPriceLabels ? "HIGH (" + str.tostring(rangeHigh, format.mintick) + ")" : "HIGH"
    lowText = showPriceLabels ? "LOW (" + str.tostring(rangeLow, format.mintick) + ")" : "LOW"
    openText = showPriceLabels ? "OPEN (" + str.tostring(rangeOpen, format.mintick) + ")" : "OPEN"
    eqText = showPriceLabels ? "EQ (" + str.tostring(rangeMid, format.mintick) + ")" : "EQ"
    
    lblHigh := label.new(bar_index + lineExtension, rangeHigh, highText, style=label.style_label_left, textcolor=colorHL, size=getLabelSize(labelSize), color=color(na))
    lblLow := label.new(bar_index + lineExtension, rangeLow, lowText, style=label.style_label_left, textcolor=colorHL, size=getLabelSize(labelSize), color=color(na))
    lblOpen := label.new(bar_index + lineExtension, rangeOpen, openText, style=label.style_label_left, textcolor=colorOpen, size=getLabelSize(labelSize), color=color(na))
    lblEQ := label.new(bar_index + lineExtension, rangeMid, eqText, style=label.style_label_left, textcolor=colorEQ, size=getLabelSize(labelSize), color=color(na))
    
    if showQuartiles
        lblQ25 := label.new(bar_index + lineExtension, q25, "25%", style=label.style_label_left, textcolor=colorQuartiles, size=getLabelSize(labelSize), color=color(na))
        lblQ75 := label.new(bar_index + lineExtension, q75, "75%", style=label.style_label_left, textcolor=colorQuartiles, size=getLabelSize(labelSize), color=color(na))
    
    // Mean Reversion Level Labels
    if showSDLevels
        // ±0.5 LEVELS - Make them prominent (86.46% probability)
        mr05hText = showPriceLabels ? "+0.5 (" + str.tostring(mr05_h, format.mintick) + ")" : "+0.5"
        mr05lText = showPriceLabels ? "-0.5 (" + str.tostring(mr05_l, format.mintick) + ")" : "-0.5"
        
        // ±1.0 LEVELS - Secondary targets (74%)
        mr10hText = showPriceLabels ? "+1.0 (" + str.tostring(mr10_h, format.mintick) + ")" : "+1.0"
        mr10lText = showPriceLabels ? "-1.0 (" + str.tostring(mr10_l, format.mintick) + ")" : "-1.0"
        
        mr20hText = showPriceLabels ? "+2.0 (" + str.tostring(mr20_h, format.mintick) + ")" : "+2.0"
        mr20lText = showPriceLabels ? "-2.0 (" + str.tostring(mr20_l, format.mintick) + ")" : "-2.0"
        
        // ±0.5 LABELS
        lblMR05h := label.new(bar_index + lineExtension, mr05_h, mr05hText, style=label.style_label_left, textcolor=colorSD05, size=getLabelSize(labelSize), color=color(na))
        lblMR05l := label.new(bar_index + lineExtension, mr05_l, mr05lText, style=label.style_label_left, textcolor=colorSD05, size=getLabelSize(labelSize), color=color(na))
        
        // ±1.0 LABELS
        lblMR10h := label.new(bar_index + lineExtension, mr10_h, mr10hText, style=label.style_label_left, textcolor=colorSD10, size=getLabelSize(labelSize), color=color(na))
        lblMR10l := label.new(bar_index + lineExtension, mr10_l, mr10lText, style=label.style_label_left, textcolor=colorSD10, size=getLabelSize(labelSize), color=color(na))
        
        // ±2.0 LABELS
        lblMR20h := label.new(bar_index + lineExtension, mr20_h, mr20hText, style=label.style_label_left, textcolor=colorSD20, size=getLabelSize(labelSize), color=color(na))
        lblMR20l := label.new(bar_index + lineExtension, mr20_l, mr20lText, style=label.style_label_left, textcolor=colorSD20, size=getLabelSize(labelSize), color=color(na))
        
        // R/R Zone Labels
        rr133hText = showPriceLabels ? "+1.33 (" + str.tostring(rr133_h, format.mintick) + ")" : "+1.33"
        rr133lText = showPriceLabels ? "-1.33 (" + str.tostring(rr133_l, format.mintick) + ")" : "-1.33"
        rr166hText = showPriceLabels ? "+1.66 (" + str.tostring(rr166_h, format.mintick) + ")" : "+1.66"
        rr166lText = showPriceLabels ? "-1.66 (" + str.tostring(rr166_l, format.mintick) + ")" : "-1.66"
        
        lblRR133h := label.new(bar_index + lineExtension, rr133_h, rr133hText, style=label.style_label_left, textcolor=colorRR, size=getLabelSize(labelSize), color=color(na))
        lblRR133l := label.new(bar_index + lineExtension, rr133_l, rr133lText, style=label.style_label_left, textcolor=colorRR, size=getLabelSize(labelSize), color=color(na))
        lblRR166h := label.new(bar_index + lineExtension, rr166_h, rr166hText, style=label.style_label_left, textcolor=colorRR, size=getLabelSize(labelSize), color=color(na))
        lblRR166l := label.new(bar_index + lineExtension, rr166_l, rr166lText, style=label.style_label_left, textcolor=colorRR, size=getLabelSize(labelSize), color=color(na))
    
    // ONS Labels
    if showONSLevels and not na(onsHighValue) and not na(onsLowValue)
        // ONS High label
        if not onsHighSwept
            // Active (unswept) label
            onsHighText = showPriceLabels ? "ONS HIGH (" + str.tostring(onsHighValue, format.mintick) + ")" : "ONS HIGH"
            lblONSHigh := label.new(bar_index + lineExtension, onsHighValue, onsHighText, style=label.style_label_left, textcolor=colorONS, size=getLabelSize(labelSize), color=color(na))
        else if keepONSAfterSweep
            // Swept but keep visible (gray with checkmark)
            onsHighText = showPriceLabels ? "ONS HIGH ✓ (" + str.tostring(onsHighValue, format.mintick) + ")" : "ONS HIGH ✓"
            lblONSHigh := label.new(bar_index + lineExtension, onsHighValue, onsHighText, style=label.style_label_left, textcolor=color.gray, size=getLabelSize(labelSize), color=color(na))
        
        // ONS Low label
        if not onsLowSwept
            // Active (unswept) label
            onsLowText = showPriceLabels ? "ONS LOW (" + str.tostring(onsLowValue, format.mintick) + ")" : "ONS LOW"
            lblONSLow := label.new(bar_index + lineExtension, onsLowValue, onsLowText, style=label.style_label_left, textcolor=colorONS, size=getLabelSize(labelSize), color=color(na))
        else if keepONSAfterSweep
            // Swept but keep visible (gray with checkmark)
            onsLowText = showPriceLabels ? "ONS LOW ✓ (" + str.tostring(onsLowValue, format.mintick) + ")" : "ONS LOW ✓"
            lblONSLow := label.new(bar_index + lineExtension, onsLowValue, onsLowText, style=label.style_label_left, textcolor=color.gray, size=getLabelSize(labelSize), color=color(na))

// ==================== UPDATE POSITIONS ====================
if valid and not na(lineHigh)
    line.set_x2(lineHigh, bar_index + lineExtension)
    line.set_x2(lineLow, bar_index + lineExtension)
    line.set_x2(lineEQ, bar_index + lineExtension)
    line.set_x2(lineOpen, bar_index + lineExtension)
    
    label.set_x(lblHigh, bar_index + lineExtension)
    label.set_x(lblLow, bar_index + lineExtension)
    label.set_x(lblOpen, bar_index + lineExtension)
    label.set_x(lblEQ, bar_index + lineExtension)
    
    if not na(lineQ25)
        line.set_x2(lineQ25, bar_index + lineExtension)
        line.set_x2(lineQ75, bar_index + lineExtension)
        label.set_x(lblQ25, bar_index + lineExtension)
        label.set_x(lblQ75, bar_index + lineExtension)
    
    if showSDLevels and not na(lineMR05h)
        line.set_x2(lineMR05h, bar_index + lineExtension)
        line.set_x2(lineMR05l, bar_index + lineExtension)
        line.set_x2(lineMR10h, bar_index + lineExtension)
        line.set_x2(lineMR10l, bar_index + lineExtension)
        line.set_x2(lineMR20h, bar_index + lineExtension)
        line.set_x2(lineMR20l, bar_index + lineExtension)
        line.set_x2(lineRR133h, bar_index + lineExtension)
        line.set_x2(lineRR133l, bar_index + lineExtension)
        line.set_x2(lineRR166h, bar_index + lineExtension)
        line.set_x2(lineRR166l, bar_index + lineExtension)
        
        label.set_x(lblMR05h, bar_index + lineExtension)
        label.set_x(lblMR05l, bar_index + lineExtension)
        label.set_x(lblMR10h, bar_index + lineExtension)
        label.set_x(lblMR10l, bar_index + lineExtension)
        label.set_x(lblMR20h, bar_index + lineExtension)
        label.set_x(lblMR20l, bar_index + lineExtension)
        label.set_x(lblRR133h, bar_index + lineExtension)
        label.set_x(lblRR133l, bar_index + lineExtension)
        label.set_x(lblRR166h, bar_index + lineExtension)
        label.set_x(lblRR166l, bar_index + lineExtension)
    
    if not na(box033_066_upper)
        box.set_right(box033_066_upper, bar_index + lineExtension)
        box.set_right(box033_066_lower, bar_index + lineExtension)
    
    if not na(boxRR_upper)
        box.set_right(boxRR_upper, bar_index + lineExtension)
        box.set_right(boxRR_lower, bar_index + lineExtension)
    
    // Update ONS High line
    if showONSLevels and not na(onsHighValue)
        if not onsHighSwept
            // Active (unswept) line
            if na(lineONSHigh)
                lineONSHigh := line.new(onsHighBarValue, onsHighValue, bar_index + lineExtension, onsHighValue, color=colorONS, width=widthONS, style=onsStyle)
                lblONSHigh := label.new(bar_index + lineExtension, onsHighValue, showPriceLabels ? "ONS HIGH (" + str.tostring(onsHighValue, format.mintick) + ")" : "ONS HIGH", style=label.style_label_left, textcolor=colorONS, size=getLabelSize(labelSize), color=color(na))
            else
                line.set_x2(lineONSHigh, bar_index + lineExtension)
                label.set_x(lblONSHigh, bar_index + lineExtension)
        else if keepONSAfterSweep
            // Swept but keep visible (change to dotted gray)
            if na(lineONSHigh)
                lineONSHigh := line.new(onsHighBarValue, onsHighValue, bar_index + lineExtension, onsHighValue, color=color.gray, width=1, style=line.style_dotted)
                lblONSHigh := label.new(bar_index + lineExtension, onsHighValue, showPriceLabels ? "ONS HIGH ✓ (" + str.tostring(onsHighValue, format.mintick) + ")" : "ONS HIGH ✓", style=label.style_label_left, textcolor=color.gray, size=getLabelSize(labelSize), color=color(na))
            else
                // Update swept line appearance and extend
                line.set_color(lineONSHigh, color.gray)
                line.set_width(lineONSHigh, 1)
                line.set_style(lineONSHigh, line.style_dotted)
                line.set_x2(lineONSHigh, bar_index + lineExtension)
                label.set_textcolor(lblONSHigh, color.gray)
                label.set_text(lblONSHigh, showPriceLabels ? "ONS HIGH ✓ (" + str.tostring(onsHighValue, format.mintick) + ")" : "ONS HIGH ✓")
                label.set_x(lblONSHigh, bar_index + lineExtension)
        else
            // Swept and don't keep - delete
            line.delete(lineONSHigh)
            label.delete(lblONSHigh)
            lineONSHigh := na
            lblONSHigh := na
    else if not showONSLevels
        // Toggle OFF - delete
        line.delete(lineONSHigh)
        label.delete(lblONSHigh)
        lineONSHigh := na
        lblONSHigh := na
    

    // Update ONS Low line
    if showONSLevels and not na(onsLowValue)
        if not onsLowSwept
            // Active (unswept) line
            if na(lineONSLow)
                lineONSLow := line.new(onsLowBarValue, onsLowValue, bar_index + lineExtension, onsLowValue, color=colorONS, width=widthONS, style=onsStyle)
                lblONSLow := label.new(bar_index + lineExtension, onsLowValue, showPriceLabels ? "ONS LOW (" + str.tostring(onsLowValue, format.mintick) + ")" : "ONS LOW", style=label.style_label_left, textcolor=colorONS, size=getLabelSize(labelSize), color=color(na))
            else
                line.set_x2(lineONSLow, bar_index + lineExtension)
                label.set_x(lblONSLow, bar_index + lineExtension)
        else if keepONSAfterSweep
            // Swept but keep visible (change to dotted gray)
            if na(lineONSLow)
                lineONSLow := line.new(onsLowBarValue, onsLowValue, bar_index + lineExtension, onsLowValue, color=color.gray, width=1, style=line.style_dotted)
                lblONSLow := label.new(bar_index + lineExtension, onsLowValue, showPriceLabels ? "ONS LOW ✓ (" + str.tostring(onsLowValue, format.mintick) + ")" : "ONS LOW ✓", style=label.style_label_left, textcolor=color.gray, size=getLabelSize(labelSize), color=color(na))
            else
                // Update swept line appearance and extend
                line.set_color(lineONSLow, color.gray)
                line.set_width(lineONSLow, 1)
                line.set_style(lineONSLow, line.style_dotted)
                line.set_x2(lineONSLow, bar_index + lineExtension)
                label.set_textcolor(lblONSLow, color.gray)
                label.set_text(lblONSLow, showPriceLabels ? "ONS LOW ✓ (" + str.tostring(onsLowValue, format.mintick) + ")" : "ONS LOW ✓")
                label.set_x(lblONSLow, bar_index + lineExtension)
        else
            // Swept and don't keep - delete
            line.delete(lineONSLow)
            label.delete(lblONSLow)
            lineONSLow := na
            lblONSLow := na
    else if not showONSLevels
        // Toggle OFF - delete
        line.delete(lineONSLow)
        label.delete(lblONSLow)
        lineONSLow := na
        lblONSLow := na

// ==================== BACKGROUND HIGHLIGHTING ====================
bgcolor(showRTHCandles and inRTHSession ? rthCandleColor : na, title="RTH Candles")
bgcolor(show940_950Window and in940_950Window ? color.new(color.yellow, 90) : na, title="9:40-9:50 Reversal Window")

// ==================== SIMPLIFIED DASHBOARD ====================
if showDashboard and valid and barstate.islast
    var table dashboard = table.new(
         dashboardPosition == "Top Right" ? position.top_right : 
         dashboardPosition == "Top Left" ? position.top_left :
         dashboardPosition == "Bottom Right" ? position.bottom_right : position.bottom_left,
         2, 10)
    
    table.clear(dashboard, 0, 0, 1, 9)
    
    // Calculate stats
    rangePts = math.round(rangeSize, 2)
    extendedONS = not na(onsRangeSize) and onsRangeSize > rangeSize * onsMultiplier
    rangeTooSmall = rangeSize < minRangeSize
    rangeTooLarge = rangeSize > maxRangeSize
    rangeOptimal = not rangeTooSmall and not rangeTooLarge
    
    int row = 0
    
    // ========== HEADER ==========
    table.cell(dashboard, 0, row, "6-9 STRATEGY", text_color=color.white, bgcolor=#2962FF, text_size=size.normal)
    table.merge_cells(dashboard, 0, row, 1, row)
    row += 1
    
    // ========== 6-9 RANGE ==========
    table.cell(dashboard, 0, row, "6-9 Range", text_color=color.gray, bgcolor=color.new(color.black, 50), text_size=size.small)
    table.cell(dashboard, 1, row, str.tostring(rangePts) + " pts", text_color=rangeOptimal ? color.lime : color.red, bgcolor=color.new(color.black, 50), text_size=size.small)
    row += 1
    
    // ========== ONS STATUS ==========
    if not na(onsRangeSize)
        onsStatus = extendedONS ? "⚠ EXTENDED" : "✓ Normal"
        onsStatusColor = extendedONS ? color.orange : color.lime
        table.cell(dashboard, 0, row, "ONS Status", text_color=color.gray, bgcolor=color.new(color.black, 50), text_size=size.small)
        table.cell(dashboard, 1, row, onsStatus, text_color=onsStatusColor, bgcolor=color.new(color.black, 50), text_size=size.small)
        row += 1
    
    // ========== ONS SWEEPS ==========
    if not na(onsHighValue) and not na(onsLowValue)
        table.cell(dashboard, 0, row, "ONS High", text_color=color.gray, bgcolor=color.new(color.black, 50), text_size=size.small)
        onsHighStatus = onsHighSwept ? "✓ Swept" : "✗ Unswept"
        onsHighColor = onsHighSwept ? color.gray : color.orange
        table.cell(dashboard, 1, row, onsHighStatus, text_color=onsHighColor, bgcolor=color.new(color.black, 50), text_size=size.small)
        row += 1
        
        table.cell(dashboard, 0, row, "ONS Low", text_color=color.gray, bgcolor=color.new(color.black, 50), text_size=size.small)
        onsLowStatus = onsLowSwept ? "✓ Swept" : "✗ Unswept"
        onsLowColor = onsLowSwept ? color.gray : color.orange
        table.cell(dashboard, 1, row, onsLowStatus, text_color=onsLowColor, bgcolor=color.new(color.black, 50), text_size=size.small)
