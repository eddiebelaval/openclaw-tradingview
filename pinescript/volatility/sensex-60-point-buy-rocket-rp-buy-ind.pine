//@version=6
indicator("Sensex 60-Point BUY Rocket", overlay=true, max_labels_count=500, max_lines_count=500)

// === INPUTS ===
rsi_length = input.int(14, "RSI Length")
rsi_buy = input.int(65, "RSI Buy Trigger") 
ma_fast = input.int(9, "Fast MA")
ma_slow = input.int(21, "Slow MA")
target_points = input.int(60, "Target Points")

// === CORE INDICATORS ===
rsi = ta.rsi(close, rsi_length)
ma9 = ta.ema(close, ma_fast)
ma21 = ta.ema(close, ma_slow)
atr = ta.atr(14)
vol_avg = ta.sma(volume, 20)

// === BUY CONDITIONS ===
trend_bull = ma9 > ma21
momentum_strong = rsi > rsi_buy and rsi < 80
breakout = close > high[1] and volume > vol_avg * 1.5
candle_power = (close - open) > atr * 0.8

buy_rocket = trend_bull and momentum_strong and breakout and candle_power

// === PLOTS ===
plot(ma9, "Fast MA", color=color.blue, linewidth=2)
plot(ma21, "Slow MA", color=color.orange, linewidth=2)
plotshape(buy_rocket, "BUY 60PTS", shape.triangleup, location.belowbar, color=color.lime, size=size.large)

// === LABELS & LINES ===
if buy_rocket
    target_price = close + target_points
    label.new(bar_index, low - atr*0.5, 
        text="🚀 BUY\nEntry: " + str.tostring(close, "#") + "\nTarget: " + str.tostring(target_price, "#"), 
        color=color.new(color.lime, 10), textcolor=color.white, style=label.style_label_up, size=size.normal)
    
    // Entry line
    line.new(bar_index, close, bar_index + 10, close, color=color.yellow, width=2, style=line.style_dotted)
    // Target line  
    line.new(bar_index, target_price, bar_index + 10, target_price, color=color.lime, width=3, style=line.style_solid)

// === BACKGROUND ===
bgcolor(buy_rocket ? color.new(color.green, 92) : na)

// === INFO TABLE ===
if barstate.islast
    var info_table = table.new(position.top_right, 2, 5, bgcolor=color.white, border_width=1)
    table.cell(info_table, 0, 0, "RSI", text_color=color.black, bgcolor=color.gray)
    table.cell(info_table, 1, 0, str.tostring(rsi, "#.#"), text_color=color.black)
    table.cell(info_table, 0, 1, "Trend", text_color=color.black, bgcolor=color.gray)
    table.cell(info_table, 1, 1, trend_bull ? "BULL✅" : "BEAR❌", text_color=trend_bull ? color.green : color.red)
    table.cell(info_table, 0, 2, "Vol", text_color=color.black, bgcolor=color.gray)
    table.cell(info_table, 1, 2, volume > vol_avg*1.5 ? "HIGH✅" : "LOW❌", text_color=color.black)

// === ALERT ===
alertcondition(buy_rocket, "🚀 SENSEX BUY", "BUY CALLS NOW! +60pts target!")
