//@version=6
strategy("Ulcer Trend Strategy", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

import TradingView/ta/11 as TVta

// === Inputs ===
sourceInput   = input.source(close, "Source")
lengthInput   = input.int(14, "Ulcer Index Length", minval=1)
uiMaLen       = input.int(5, "UI MA Length", minval=1)
uiThreshold   = input.float(999.0, "UI Threshold (unused if 999)", step=0.1, tooltip="Optional: set a numeric threshold to require UI be below/above it for entries. Leave default 999 to ignore.")
trendMaLen    = input.int(50, "Trend EMA Length", minval=1)

allowShort    = input.bool(true, "Allow Shorts")
useStops      = input.bool(true, "Use Stop / Take Profit")
stopPct       = input.float(2.0, "Stop Loss (%)", step=0.1)
tpPct         = input.float(4.0, "Take Profit (%)", step=0.1)

useTrail      = input.bool(false, "Use ATR Trailing Stop")
atrLen        = input.int(14, "ATR Length", minval=1)
atrMult       = input.float(2.0, "ATR Multiplier", step=0.1)

// === Ulcer Index calculation & smoothing ===
float ui = TVta.ulcerIndex(sourceInput, lengthInput)
uiMa = ta.sma(ui, uiMaLen)
trendEMA = ta.ema(close, trendMaLen)

// optional threshold logic (ignored when left at default 999)
useThreshold = uiThreshold < 999.0

// === Signal logic ===
// UI turning down (crosses under its MA) -> bullish bias
uiTurnDown = ta.crossunder(ui, uiMa) and (not useThreshold or ui < uiThreshold)
// UI turning up (crosses over its MA) -> bearish bias
uiTurnUp   = ta.crossover(ui, uiMa)  and (not useThreshold or ui > uiThreshold)

longCond  = uiTurnDown and close > trendEMA
shortCond = allowShort and uiTurnUp and close < trendEMA

// === Entries ===
if longCond
    strategy.entry("Long", strategy.long)

if shortCond
    strategy.entry("Short", strategy.short)

// === Fixed Stop / TP ===
if useStops
    if strategy.position_size > 0
        strategy.exit("Exit Long", from_entry="Long",
          stop = strategy.position_avg_price * (1 - stopPct/100),
          limit = strategy.position_avg_price * (1 + tpPct/100))
    if strategy.position_size < 0
        strategy.exit("Exit Short", from_entry="Short",
          stop = strategy.position_avg_price * (1 + stopPct/100),
          limit = strategy.position_avg_price * (1 - tpPct/100))

// === ATR Trailing Stop (optional) ===
atr = ta.atr(atrLen)
if useTrail and strategy.position_size > 0
    strategy.exit("Trail Long", from_entry="Long", trail_points = atr * atrMult, trail_offset = atr * atrMult)
if useTrail and strategy.position_size < 0
    strategy.exit("Trail Short", from_entry="Short", trail_points = atr * atrMult, trail_offset = atr * atrMult)

// === Close on reverse signal (keeps single-direction positions) ===
if ta.crossover(ui, uiMa) and strategy.position_size > 0
    strategy.close("Long")
if ta.crossunder(ui, uiMa) and strategy.position_size < 0
    strategy.close("Short")

// === Visuals ===
uiPlot = plot(ui, "Ulcer Index", linewidth=2)
plot(uiMa, "UI MA", linewidth=1, style=plot.style_line)
hline(0, "Zero")
plot(trendEMA, title="Trend EMA", color=color.orange)

// === Info label (last bar) ===
if barstate.islast
    var label info = na
    label.delete(info)
    infoText = "UI: " + str.tostring(ui, format.mintick) + "  UI_MA(" + str.tostring(uiMaLen) + "): " + str.tostring(uiMa, format.mintick)
    info := label.new(bar_index, high, infoText, xloc=xloc.bar_index, yloc=yloc.abovebar, style=label.style_label_left, color=color.new(color.black,80), textcolor=color.white)
