//@version=6
indicator("Parkinson Range Oscillator [BackQuant]", overlay = false)

// Inputs
lengthInput    = input.int(20, "Parkinson Length", minval = 5, tooltip = "Window for the Parkinson high-low variance estimate.")
smoothInput    = input.int(100, "Baseline Length", minval = 20, tooltip = "Rolling window to normalize Parkinson vol against its own history.")
signalInput    = input.int(10, "Signal Length", minval = 2, tooltip = "EMA smoothing for the signal line.")
pctRankInput   = input.int(252, "Percentile Lookback", minval = 50)
bullInput      = input.color(#00ff00, "Low Vol / Compression")
bearInput      = input.color(#ff0000, "High Vol / Expansion")
showDashInput  = input.bool(true, "Show Dashboard")
dashPosInput   = input.string("Top Right", "Dashboard Position", options = ["Top Right", "Bottom Right", "Bottom Left"])
dashSizeInput  = input.string("Small", "Dashboard Size", options = ["Tiny", "Small", "Normal"])

// Cast to simple for fill compatibility
color bullCol = bullInput
color bearCol = bearInput

// Parkinson Volatility
// Var = (1 / (4*n*ln2)) * sum(ln(H/L)^2)
// We take the rolling mean of ln(H/L)^2 then scale by 1/(4*ln2)
float logHL2  = math.pow(math.log(high / low), 2)
float parkVar = ta.sma(logHL2, lengthInput) / (4.0 * math.log(2))
float parkVol = math.sqrt(parkVar) * 100

// Z-score normalization against rolling baseline
float parkMA = ta.sma(parkVol, smoothInput)
float parkSD = ta.stdev(parkVol, smoothInput)
float osc    = parkSD > 0 ? (parkVol - parkMA) / parkSD : 0.0

// Signal line
float signal = ta.ema(osc, signalInput)

// Percentile rank of raw Parkinson vol
float pctRank = ta.percentrank(parkVol, pctRankInput)

// ATR-based z-score for visual comparison
float atrVol = ta.atr(lengthInput) / close * 100
float atrMA  = ta.sma(atrVol, smoothInput)
float atrSD  = ta.stdev(atrVol, smoothInput)
float atrOsc = atrSD > 0 ? (atrVol - atrMA) / atrSD : 0.0

// Regime classification
string regime = osc > 2.0 ? "EXTREME" : osc > 1.0 ? "HIGH" : osc > 0.0 ? "ABOVE AVG" : osc > -1.0 ? "BELOW AVG" : "COMPRESSED"
color regimeColor = osc > 2.0 ? bearCol : osc > 1.0 ? color.new(bearCol, 30) : osc > 0.0 ? color.new(bearCol, 60) : osc > -1.0 ? color.new(bullCol, 60) : bullCol

// Crossover signals
bool expansionCross   = ta.crossover(osc, signal) and osc > 0
bool compressionCross = ta.crossunder(osc, signal) and osc < 0

// Main plots — split positive/negative for gradient fills
float oscPos = osc > 0 ? osc : na
float oscNeg = osc < 0 ? osc : na

pZero = plot(0, "Zero", color = color.new(color.white, 80), style = plot.style_circles, display = display.none)
pPos  = plot(oscPos, "Positive Osc", color = bearCol, linewidth = 2, style = plot.style_linebr)
pNeg  = plot(oscNeg, "Negative Osc", color = bullCol, linewidth = 2, style = plot.style_linebr)

// Gradient fills
fill(pPos, pZero, 6, 0, top_color = color.new(bearCol, 40), bottom_color = color.new(bearCol, 97), title = "Expansion Gradient")
fill(pNeg, pZero, 0, -6, top_color = color.new(bullCol, 97), bottom_color = color.new(bullCol, 40), title = "Compression Gradient")

// Signal line
plot(signal, "Signal", color = color.new(color.white, 40), linewidth = 1)

// ATR comparison (thin gray)
plot(atrOsc, "ATR Z-Score", color = color.new(#787b86, 50), linewidth = 1)

// Cross dots
plot(expansionCross ? osc : na, "Expansion Cross", color = bearCol, style = plot.style_circles, linewidth = 4)
plot(compressionCross ? osc : na, "Compression Cross", color = bullCol, style = plot.style_circles, linewidth = 4)

// Reference levels
hline(2.0, "Extreme", color = color.new(bearCol, 60), linestyle = hline.style_dashed)
hline(1.0, "High", color = color.new(color.white, 80), linestyle = hline.style_dotted)
hline(0.0, "Zero", color = color.new(color.white, 70), linestyle = hline.style_dotted)
hline(-1.0, "Low", color = color.new(color.white, 80), linestyle = hline.style_dotted)

// Dashboard
var parsedDashPos = switch dashPosInput
    "Top Right"    => position.top_right
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left

var parsedDashSize = switch dashSizeInput
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal

if showDashInput and barstate.islast
    var table dash = table.new(parsedDashPos, 2, 8, bgcolor = #00000000, frame_color = #ffffff, frame_width = 1)

    table.merge_cells(dash, 0, 0, 1, 0)
    table.cell(dash, 0, 0, "Parkinson Range", text_color = chart.fg_color, text_size = parsedDashSize, text_halign = text.align_center)

    table.merge_cells(dash, 0, 1, 1, 1)
    table.cell(dash, 0, 1, "━━━━━━━━━━━━━━━━━━", text_color = chart.fg_color, text_size = parsedDashSize, text_halign = text.align_center)

    table.cell(dash, 0, 2, "Parkinson Vol ", text_color = chart.fg_color, text_size = parsedDashSize, text_halign = text.align_left)
    table.cell(dash, 1, 2, str.tostring(parkVol, "#.###") + "%", text_color = chart.fg_color, text_size = parsedDashSize, text_halign = text.align_right)

    table.cell(dash, 0, 3, "Z-Score ", text_color = chart.fg_color, text_size = parsedDashSize, text_halign = text.align_left)
    table.cell(dash, 1, 3, str.tostring(osc, "#.##"), text_color = osc >= 0 ? bearCol : bullCol, text_size = parsedDashSize, text_halign = text.align_right)

    table.cell(dash, 0, 4, "Percentile ", text_color = chart.fg_color, text_size = parsedDashSize, text_halign = text.align_left)
    table.cell(dash, 1, 4, str.tostring(pctRank, "#.#") + "%", text_color = pctRank > 80 ? bearCol : pctRank < 20 ? bullCol : #DBDBDB, text_size = parsedDashSize, text_halign = text.align_right)

    table.merge_cells(dash, 0, 5, 1, 5)
    table.cell(dash, 0, 5, "━━━━━━━━━━━━━━━━━━", text_color = chart.fg_color, text_size = parsedDashSize, text_halign = text.align_center)

    table.cell(dash, 0, 6, "Regime ", text_color = chart.fg_color, text_size = parsedDashSize, text_halign = text.align_left)
    table.cell(dash, 1, 6, regime, text_color = regimeColor, text_size = parsedDashSize, text_halign = text.align_right)

    table.cell(dash, 0, 7, "ATR Z-Score ", text_color = chart.fg_color, text_size = parsedDashSize, text_halign = text.align_left)
    table.cell(dash, 1, 7, str.tostring(atrOsc, "#.##"), text_color = chart.fg_color, text_size = parsedDashSize, text_halign = text.align_right)
