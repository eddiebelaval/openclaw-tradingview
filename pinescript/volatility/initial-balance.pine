//
// Initial Balance (IB) session tool.
// - Tracks IB high/low during the configured session window.
// - Draws optional 1.5x and 2.0x range extensions.
// - Locks the fill width at session end while keeping levels updated.

//@version=6
indicator("Initial Balance", shorttitle="IB Simple", overlay=true, max_lines_count=500, max_boxes_count=500)

// ──────────────────────────────────────────────
// Inputs: Session
// ──────────────────────────────────────────────
startTime  = input.session("0930-1030", "IB Time Range")
timeZone   = input.string("UTC-5", "Timezone")

// ──────────────────────────────────────────────
// Inputs: Styling
// ──────────────────────────────────────────────
showHigh   = input.bool(true, "Show IB High",   inline="High")
colHigh    = input.color(color.blue, "",        inline="High")
wHigh      = input.int(2, "", options=[1, 2, 3, 4], inline="High")

showLow    = input.bool(true, "Show IB Low",    inline="Low")
colLow     = input.color(color.blue, "",        inline="Low")
wLow       = input.int(2, "", options=[1, 2, 3, 4], inline="Low")

show15     = input.bool(false, "Show 1.5x Ext", inline="15")
col15      = input.color(color.new(color.blue, 30), "", inline="15")
w15        = input.int(1, "", options=[1, 2, 3, 4], inline="15")

show20     = input.bool(false, "Show 2.0x Ext", inline="20")
col20      = input.color(color.new(color.blue, 0), "",  inline="20")
w20        = input.int(1, "", options=[1, 2, 3, 4], inline="20")

showFill   = input.bool(true, "Show IB Fill",   inline="Fill")
colFill    = input.color(color.new(color.blue, 90), "", inline="Fill")

// ──────────────────────────────────────────────
// Core calculations
// ──────────────────────────────────────────────
inSession = not na(time(timeframe.period, startTime, timeZone))
isFirst   = inSession and not inSession[1]

var float ibH = na
var float ibL = na

if isFirst
    ibH := high
    ibL := low
else if inSession
    ibH := math.max(high, ibH)
    ibL := math.min(low, ibL)

float ib_range = ibH - ibL
float ext15H  = ibH + (ib_range * 0.5)
float ext15L  = ibL - (ib_range * 0.5)
float ext20H  = ibH + ib_range
float ext20L  = ibL - ib_range

// ──────────────────────────────────────────────
// Drawing state
// ──────────────────────────────────────────────
var line highLine = na, var line lowLine = na, var box fillBox = na
var line h15Line  = na, var line l15Line = na
var line h20Line  = na, var line l20Line = na

if isFirst
    highLine := line.new(bar_index, ibH, bar_index, ibH, color=showHigh ? colHigh : #00000000, width=wHigh)
    lowLine  := line.new(bar_index, ibL, bar_index, ibL, color=showLow ? colLow : #00000000, width=wLow)
    fillBox  := box.new(bar_index, ibH, bar_index, ibL, bgcolor=showFill ? colFill : #00000000, border_color=na)
    
    h15Line  := line.new(bar_index, ext15H, bar_index, ext15H, color=show15 ? col15 : #00000000, width=w15)
    l15Line  := line.new(bar_index, ext15L, bar_index, ext15L, color=show15 ? col15 : #00000000, width=w15)
    h20Line  := line.new(bar_index, ext20H, bar_index, ext20H, color=show20 ? col20 : #00000000, width=w20)
    l20Line  := line.new(bar_index, ext20L, bar_index, ext20L, color=show20 ? col20 : #00000000, width=w20)

if not na(ibH)
    // Extend all active lines to the current bar.
    line.set_xy1(highLine, line.get_x1(highLine), ibH), line.set_xy2(highLine, bar_index, ibH)
    line.set_xy1(lowLine,  line.get_x1(lowLine),  ibL), line.set_xy2(lowLine,  bar_index, ibL)
    line.set_xy1(h15Line, line.get_x1(h15Line), ext15H), line.set_xy2(h15Line, bar_index, ext15H)
    line.set_xy1(l15Line, line.get_x1(l15Line), ext15L), line.set_xy2(l15Line, bar_index, ext15L)
    line.set_xy1(h20Line, line.get_x1(h20Line), ext20H), line.set_xy2(h20Line, bar_index, ext20H)
    line.set_xy1(l20Line, line.get_x1(l20Line), ext20L), line.set_xy2(l20Line, bar_index, ext20L)

    // Keep fill height synced to IB levels.
    box.set_top(fillBox, ibH)
    box.set_bottom(fillBox, ibL)
    // Freeze fill width once the session window ends.
    if inSession
        box.set_right(fillBox, bar_index)

    // Apply live visibility, color, and width settings.
    line.set_color(highLine, showHigh ? colHigh : #00000000), line.set_width(highLine, wHigh)
    line.set_color(lowLine,  showLow  ? colLow  : #00000000), line.set_width(lowLine,  wLow)
    line.set_color(h15Line,  show15   ? col15   : #00000000), line.set_width(h15Line,  w15)
    line.set_color(l15Line,  show15   ? col15   : #00000000), line.set_width(l15Line,  w15)
    line.set_color(h20Line,  show20   ? col20   : #00000000), line.set_width(h20Line,  w20)
    line.set_color(l20Line,  show20   ? col20   : #00000000), line.set_width(l20Line,  w20)
    box.set_bgcolor(fillBox, showFill ? colFill  : #00000000)
