//@version=5
indicator("Crypto MTF Scanner", shorttitle="Crypto Scanner", overlay=true)

// ╔══════════════════════════════════════════════════════════╗
// ║  Crypto Multi-Timeframe Volume Scanner                  ║
// ║  Based on NASDAQ MTF Scanner logic                     ║
// ║  Scans 10 crypto coins across 4 timeframes             ║
// ║  Default: Top 10 Binance coins by volume               ║
// ╚══════════════════════════════════════════════════════════╝

// ══════════════════════════════════════════════════════════
// INPUTS — 10 configurable crypto tickers
// ══════════════════════════════════════════════════════════
grpT = "Coins (edit to change)"
t1  = input.symbol("BINANCE:BTCUSDT",  "Coin 1",  group=grpT)
t2  = input.symbol("BINANCE:ETHUSDT",  "Coin 2",  group=grpT)
t3  = input.symbol("BINANCE:BNBUSDT",  "Coin 3",  group=grpT)
t4  = input.symbol("BINANCE:SOLUSDT",  "Coin 4",  group=grpT)
t5  = input.symbol("BINANCE:XRPUSDT",  "Coin 5",  group=grpT)
t6  = input.symbol("BINANCE:DOGEUSDT", "Coin 6",  group=grpT)
t7  = input.symbol("BINANCE:ADAUSDT",  "Coin 7",  group=grpT)
t8  = input.symbol("BINANCE:AVAXUSDT", "Coin 8",  group=grpT)
t9  = input.symbol("BINANCE:LINKUSDT", "Coin 9",  group=grpT)
t10 = input.symbol("BINANCE:DOTUSDT",  "Coin 10", group=grpT)

grpS = "Settings"
dvBullThr = input.float(0.58, "DV Bull threshold", group=grpS, minval=0.51, maxval=0.75, step=0.01, tooltip="Buy pressure threshold. Higher = stricter.")
dvBearThr = input.float(0.42, "DV Bear threshold", group=grpS, minval=0.25, maxval=0.49, step=0.01)
tblPos    = input.string("top_right", "Table position", group=grpS, options=["top_right","top_left","bottom_right","bottom_left"])

grpTF = "Timeframes (must be >= chart TF)"
tf_t1 = input.timeframe("D",   "TF 1 (highest)",  group=grpTF, tooltip="Must be >= chart timeframe")
tf_t2 = input.timeframe("240", "TF 2",             group=grpTF, tooltip="Must be >= chart timeframe")
tf_t3 = input.timeframe("60",  "TF 3",             group=grpTF, tooltip="Must be >= chart timeframe")
tf_t4 = input.timeframe("15",  "TF 4 (lowest)",    group=grpTF, tooltip="On 4H chart use 240 or higher.")

// ══════════════════════════════════════════════════════════
// SCAN FUNCTION — 1 security call per TF (tuple)
// ══════════════════════════════════════════════════════════
f_tf(_sym, _tf) =>
    [_o, _c, _h, _l, _v] = request.security(_sym, _tf,
         [open, close, high, low, volume],
         lookahead=barmerge.lookahead_off)

    bool  _green = _c > _o
    float _delta = _c > _o ? _v : _c < _o ? -_v : 0.0

    float _sp   = _h - _l
    float _buy  = _sp > 0 ? _v * (_c - _l) / _sp : _v * 0.5
    float _sell = _sp > 0 ? _v * (_h - _c) / _sp : _v * 0.5
    float _dvR  = (_buy + _sell) > 0 ? _buy / (_buy + _sell) : 0.5

    bool _hidBuy  = _dvR > dvBullThr and not _green
    bool _hidSell = _dvR < dvBearThr and _green

    string _dir = _delta > 0 and _dvR > 0.5 ? "▲" : _delta < 0 and _dvR < 0.5 ? "▼" : "—"
    color  _col = _delta > 0 and _dvR > 0.5 ? color.lime : _delta < 0 and _dvR < 0.5 ? color.red : color.new(color.gray, 40)

    [_dvR, _hidBuy, _hidSell, _dir, _col, _delta, _green]

// ══════════════════════════════════════════════════════════
// COMPOSITE SCORE — weighted by TF importance
// ══════════════════════════════════════════════════════════
f_score(_dv, _hb, _hs, _d1D, _d4H, _d1H, _d15) =>
    int _s = 0
    _s += _d1D > 0 ? 3 : _d1D < 0 ? -3 : 0
    _s += _d4H > 0 ? 2 : _d4H < 0 ? -2 : 0
    _s += _d1H > 0 ? 2 : _d1H < 0 ? -2 : 0
    _s += _d15 > 0 ? 1 : _d15 < 0 ? -1 : 0
    _s += _dv > dvBullThr ? 1 : _dv < dvBearThr ? -1 : 0
    _s += _hb ? 2 : _hs ? -2 : 0
    _s

// ══════════════════════════════════════════════════════════
// SIGNAL LABEL
// ══════════════════════════════════════════════════════════
f_sig(int _sc) =>
    string _t = ""
    color  _c = color.gray
    color  _b = color.new(color.gray, 75)
    if _sc >= 9
        _t := "BUY 💪💪"
        _c := color.white
        _b := color.new(color.green, 5)
    else if _sc >= 6
        _t := "BUY ▲"
        _c := color.lime
        _b := color.new(color.green, 30)
    else if _sc >= 3
        _t := "BUY ~"
        _c := color.lime
        _b := color.new(color.green, 60)
    else if _sc <= -9
        _t := "SELL 💪💪"
        _c := color.white
        _b := color.new(color.red, 5)
    else if _sc <= -6
        _t := "SELL ▼"
        _c := color.red
        _b := color.new(color.red, 30)
    else if _sc <= -3
        _t := "SELL ~"
        _c := color.red
        _b := color.new(color.red, 60)
    else
        _t := "WAIT"
        _c := color.new(color.gray, 20)
        _b := color.new(color.gray, 75)
    [_t, _c, _b]

// ══════════════════════════════════════════════════════════
// SCAN ALL 10 COINS
// ══════════════════════════════════════════════════════════

// Coin 1 — BTC
[_, _, _, d1_1D, dc1_1D, delta1_1D, g1_1D] = f_tf(t1, tf_t1)
[_,   _,   _,   d1_4H, dc1_4H, delta1_4H, _     ] = f_tf(t1, tf_t2)
[_,   _,   _,   d1_1H, dc1_1H, delta1_1H, _     ] = f_tf(t1, tf_t3)
[dv1, hb1, hs1, d1_15, dc1_15, delta1_15, g1_15] = f_tf(t1, tf_t4)
sc1 = f_score(dv1, hb1, hs1, delta1_1D, delta1_4H, delta1_1H, delta1_15)

// Coin 2 — ETH
[_, _, _, d2_1D, dc2_1D, delta2_1D, _] = f_tf(t2, tf_t1)
[_,   _,   _,   d2_4H, dc2_4H, delta2_4H, _] = f_tf(t2, tf_t2)
[_,   _,   _,   d2_1H, dc2_1H, delta2_1H, _] = f_tf(t2, tf_t3)
[dv2, hb2, hs2, d2_15, dc2_15, delta2_15, g2_15] = f_tf(t2, tf_t4)
sc2 = f_score(dv2, hb2, hs2, delta2_1D, delta2_4H, delta2_1H, delta2_15)

// Coin 3 — BNB
[_, _, _, d3_1D, dc3_1D, delta3_1D, _] = f_tf(t3, tf_t1)
[_,   _,   _,   d3_4H, dc3_4H, delta3_4H, _] = f_tf(t3, tf_t2)
[_,   _,   _,   d3_1H, dc3_1H, delta3_1H, _] = f_tf(t3, tf_t3)
[dv3, hb3, hs3, d3_15, dc3_15, delta3_15, g3_15] = f_tf(t3, tf_t4)
sc3 = f_score(dv3, hb3, hs3, delta3_1D, delta3_4H, delta3_1H, delta3_15)

// Coin 4 — SOL
[_, _, _, d4_1D, dc4_1D, delta4_1D, _] = f_tf(t4, tf_t1)
[_,   _,   _,   d4_4H, dc4_4H, delta4_4H, _] = f_tf(t4, tf_t2)
[_,   _,   _,   d4_1H, dc4_1H, delta4_1H, _] = f_tf(t4, tf_t3)
[dv4, hb4, hs4, d4_15, dc4_15, delta4_15, g4_15] = f_tf(t4, tf_t4)
sc4 = f_score(dv4, hb4, hs4, delta4_1D, delta4_4H, delta4_1H, delta4_15)

// Coin 5 — XRP
[_, _, _, d5_1D, dc5_1D, delta5_1D, _] = f_tf(t5, tf_t1)
[_,   _,   _,   d5_4H, dc5_4H, delta5_4H, _] = f_tf(t5, tf_t2)
[_,   _,   _,   d5_1H, dc5_1H, delta5_1H, _] = f_tf(t5, tf_t3)
[dv5, hb5, hs5, d5_15, dc5_15, delta5_15, g5_15] = f_tf(t5, tf_t4)
sc5 = f_score(dv5, hb5, hs5, delta5_1D, delta5_4H, delta5_1H, delta5_15)

// Coin 6 — DOGE
[_, _, _, d6_1D, dc6_1D, delta6_1D, _] = f_tf(t6, tf_t1)
[_,   _,   _,   d6_4H, dc6_4H, delta6_4H, _] = f_tf(t6, tf_t2)
[_,   _,   _,   d6_1H, dc6_1H, delta6_1H, _] = f_tf(t6, tf_t3)
[dv6, hb6, hs6, d6_15, dc6_15, delta6_15, g6_15] = f_tf(t6, tf_t4)
sc6 = f_score(dv6, hb6, hs6, delta6_1D, delta6_4H, delta6_1H, delta6_15)

// Coin 7 — ADA
[_, _, _, d7_1D, dc7_1D, delta7_1D, _] = f_tf(t7, tf_t1)
[_,   _,   _,   d7_4H, dc7_4H, delta7_4H, _] = f_tf(t7, tf_t2)
[_,   _,   _,   d7_1H, dc7_1H, delta7_1H, _] = f_tf(t7, tf_t3)
[dv7, hb7, hs7, d7_15, dc7_15, delta7_15, g7_15] = f_tf(t7, tf_t4)
sc7 = f_score(dv7, hb7, hs7, delta7_1D, delta7_4H, delta7_1H, delta7_15)

// Coin 8 — AVAX
[_, _, _, d8_1D, dc8_1D, delta8_1D, _] = f_tf(t8, tf_t1)
[_,   _,   _,   d8_4H, dc8_4H, delta8_4H, _] = f_tf(t8, tf_t2)
[_,   _,   _,   d8_1H, dc8_1H, delta8_1H, _] = f_tf(t8, tf_t3)
[dv8, hb8, hs8, d8_15, dc8_15, delta8_15, g8_15] = f_tf(t8, tf_t4)
sc8 = f_score(dv8, hb8, hs8, delta8_1D, delta8_4H, delta8_1H, delta8_15)

// Coin 9 — LINK
[_, _, _, d9_1D, dc9_1D, delta9_1D, _] = f_tf(t9, tf_t1)
[_,   _,   _,   d9_4H, dc9_4H, delta9_4H, _] = f_tf(t9, tf_t2)
[_,   _,   _,   d9_1H, dc9_1H, delta9_1H, _] = f_tf(t9, tf_t3)
[dv9, hb9, hs9, d9_15, dc9_15, delta9_15, g9_15] = f_tf(t9, tf_t4)
sc9 = f_score(dv9, hb9, hs9, delta9_1D, delta9_4H, delta9_1H, delta9_15)

// Coin 10 — DOT
[_, _, _, d10_1D, dc10_1D, delta10_1D, _] = f_tf(t10, tf_t1)
[_,    _,    _,    d10_4H, dc10_4H, delta10_4H, _ ] = f_tf(t10, tf_t2)
[_,    _,    _,    d10_1H, dc10_1H, delta10_1H, _ ] = f_tf(t10, tf_t3)
[dv10, hb10, hs10, d10_15, dc10_15, delta10_15, g10_15] = f_tf(t10, tf_t4)
sc10 = f_score(dv10, hb10, hs10, delta10_1D, delta10_4H, delta10_1H, delta10_15)

// ══════════════════════════════════════════════════════════
// TABLE
// ══════════════════════════════════════════════════════════
var table tbl = table.new(
     tblPos == "top_left"     ? position.top_left     :
     tblPos == "bottom_right" ? position.bottom_right :
     tblPos == "bottom_left"  ? position.bottom_left  :
     position.top_right,
     10, 12,
     bgcolor      = color.new(color.black, 15),
     border_width = 1,
     border_color = color.new(color.gray, 55),
     frame_width  = 2,
     frame_color  = color.new(color.orange, 40))

C_HDR = color.new(color.navy, 10)
C_LBL = color.new(color.silver, 0)
C_BG  = color.new(color.black, 50)

// Header
table.cell(tbl, 0, 0, "COIN",   text_color=C_LBL, text_size=size.small, bgcolor=C_HDR)
table.cell(tbl, 1, 0, tf_t1,    text_color=C_LBL, text_size=size.small, bgcolor=C_HDR)
table.cell(tbl, 2, 0, tf_t2,    text_color=C_LBL, text_size=size.small, bgcolor=C_HDR)
table.cell(tbl, 3, 0, tf_t3,    text_color=C_LBL, text_size=size.small, bgcolor=C_HDR)
table.cell(tbl, 4, 0, tf_t4,    text_color=C_LBL, text_size=size.small, bgcolor=C_HDR)
table.cell(tbl, 5, 0, "DV%",    text_color=C_LBL, text_size=size.small, bgcolor=C_HDR)
table.cell(tbl, 6, 0, "HIDDEN", text_color=C_LBL, text_size=size.small, bgcolor=C_HDR)
table.cell(tbl, 7, 0, "SCORE",  text_color=C_LBL, text_size=size.small, bgcolor=C_HDR)
table.cell(tbl, 8, 0, "SIGNAL", text_color=C_LBL, text_size=size.small, bgcolor=C_HDR)
table.cell(tbl, 9, 0, "REV",    text_color=C_LBL, text_size=size.small, bgcolor=C_HDR)

// Row function
f_row(_row, _tkr, _d1D, _dc1D, _d4H, _dc4H, _d1H, _dc1H, _d15, _dc15, _dv, _hb, _hs, _sc, _isGreen15) =>
    [_st, _sc2, _sb] = f_sig(_sc)
    string _dvTxt  = str.tostring(math.round(_dv * 100)) + "%"
    color  _dvCol  = _dv > dvBullThr ? color.lime : _dv < dvBearThr ? color.red : color.gray
    string _hidTxt = _hb ? "BUY 🔍" : _hs ? "SELL 🔍" : "—"
    color  _hidCol = _hb ? color.lime : _hs ? color.red : color.new(color.gray, 40)
    string _scTxt  = (_sc > 0 ? "+" : "") + str.tostring(_sc)
    color  _scCol  = _sc >= 6 ? color.lime : _sc <= -6 ? color.red : _sc >= 3 ? color.new(color.lime,40) : _sc <= -3 ? color.new(color.red,40) : color.gray
    color  _tBg    = _sc >= 6 ? color.new(color.green, 70) : _sc <= -6 ? color.new(color.red, 70) : C_BG
    string _revTxt = _hb and not _isGreen15 ? "🟢 BUY" : _hs and _isGreen15 ? "🔴 SELL" : "—"
    color  _revCol = _hb and not _isGreen15 ? color.lime : _hs and _isGreen15 ? color.red : color.new(color.gray, 40)
    color  _revBg  = _hb and not _isGreen15 ? color.new(color.lime, 65) : _hs and _isGreen15 ? color.new(color.red, 65) : C_BG
    // Shorten ticker — strip BINANCE: prefix
    string _name   = str.contains(_tkr, ":") ? str.substring(_tkr, str.pos(_tkr, ":") + 1) : _tkr
    _name := str.replace(_name, "USDT", "")
    table.cell(tbl, 0, _row, _name,   text_color=color.white, text_size=size.small,  bgcolor=_tBg)
    table.cell(tbl, 1, _row, _d1D,    text_color=_dc1D,       text_size=size.normal, bgcolor=C_BG)
    table.cell(tbl, 2, _row, _d4H,    text_color=_dc4H,       text_size=size.normal, bgcolor=C_BG)
    table.cell(tbl, 3, _row, _d1H,    text_color=_dc1H,       text_size=size.normal, bgcolor=C_BG)
    table.cell(tbl, 4, _row, _d15,    text_color=_dc15,       text_size=size.normal, bgcolor=C_BG)
    table.cell(tbl, 5, _row, _dvTxt,  text_color=_dvCol,      text_size=size.small,  bgcolor=C_BG)
    table.cell(tbl, 6, _row, _hidTxt, text_color=_hidCol,     text_size=size.small,  bgcolor=C_BG)
    table.cell(tbl, 7, _row, _scTxt,  text_color=_scCol,      text_size=size.small,  bgcolor=C_BG)
    table.cell(tbl, 8, _row, _st,     text_color=_sc2,        text_size=size.small,  bgcolor=_sb)
    table.cell(tbl, 9, _row, _revTxt, text_color=_revCol,     text_size=size.small,  bgcolor=_revBg)

// Title row
table.cell(tbl, 0, 1, "── Crypto MTF · Volume Scanner ──", text_color=color.new(color.orange,10), text_size=size.tiny, bgcolor=C_HDR, text_halign=text.align_center)
table.merge_cells(tbl, 0, 1, 9, 1)

// Data rows
f_row(2,  t1,  d1_1D,  dc1_1D,  d1_4H,  dc1_4H,  d1_1H,  dc1_1H,  d1_15,  dc1_15,  dv1,  hb1,  hs1,  sc1,  g1_15)
f_row(3,  t2,  d2_1D,  dc2_1D,  d2_4H,  dc2_4H,  d2_1H,  dc2_1H,  d2_15,  dc2_15,  dv2,  hb2,  hs2,  sc2,  g2_15)
f_row(4,  t3,  d3_1D,  dc3_1D,  d3_4H,  dc3_4H,  d3_1H,  dc3_1H,  d3_15,  dc3_15,  dv3,  hb3,  hs3,  sc3,  g3_15)
f_row(5,  t4,  d4_1D,  dc4_1D,  d4_4H,  dc4_4H,  d4_1H,  dc4_1H,  d4_15,  dc4_15,  dv4,  hb4,  hs4,  sc4,  g4_15)
f_row(6,  t5,  d5_1D,  dc5_1D,  d5_4H,  dc5_4H,  d5_1H,  dc5_1H,  d5_15,  dc5_15,  dv5,  hb5,  hs5,  sc5,  g5_15)
f_row(7,  t6,  d6_1D,  dc6_1D,  d6_4H,  dc6_4H,  d6_1H,  dc6_1H,  d6_15,  dc6_15,  dv6,  hb6,  hs6,  sc6,  g6_15)
f_row(8,  t7,  d7_1D,  dc7_1D,  d7_4H,  dc7_4H,  d7_1H,  dc7_1H,  d7_15,  dc7_15,  dv7,  hb7,  hs7,  sc7,  g7_15)
f_row(9,  t8,  d8_1D,  dc8_1D,  d8_4H,  dc8_4H,  d8_1H,  dc8_1H,  d8_15,  dc8_15,  dv8,  hb8,  hs8,  sc8,  g8_15)
f_row(10, t9,  d9_1D,  dc9_1D,  d9_4H,  dc9_4H,  d9_1H,  dc9_1H,  d9_15,  dc9_15,  dv9,  hb9,  hs9,  sc9,  g9_15)
f_row(11, t10, d10_1D, dc10_1D, d10_4H, dc10_4H, d10_1H, dc10_1H, d10_15, dc10_15, dv10, hb10, hs10, sc10, g10_15)

// ══════════════════════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════════════════════
alertcondition(sc1  >= 9,  title="STRONG BUY — Coin 1",  message="Crypto Scanner — Strong BUY on Coin 1")
alertcondition(sc2  >= 9,  title="STRONG BUY — Coin 2",  message="Crypto Scanner — Strong BUY on Coin 2")
alertcondition(sc3  >= 9,  title="STRONG BUY — Coin 3",  message="Crypto Scanner — Strong BUY on Coin 3")
alertcondition(sc4  >= 9,  title="STRONG BUY — Coin 4",  message="Crypto Scanner — Strong BUY on Coin 4")
alertcondition(sc5  >= 9,  title="STRONG BUY — Coin 5",  message="Crypto Scanner — Strong BUY on Coin 5")
alertcondition(sc1  <= -9, title="STRONG SELL — Coin 1", message="Crypto Scanner — Strong SELL on Coin 1")
alertcondition(sc2  <= -9, title="STRONG SELL — Coin 2", message="Crypto Scanner — Strong SELL on Coin 2")
alertcondition(sc3  <= -9, title="STRONG SELL — Coin 3", message="Crypto Scanner — Strong SELL on Coin 3")
alertcondition(sc4  <= -9, title="STRONG SELL — Coin 4", message="Crypto Scanner — Strong SELL on Coin 4")
alertcondition(sc5  <= -9, title="STRONG SELL — Coin 5", message="Crypto Scanner — Strong SELL on Coin 5")
alertcondition(hb1 or hb2 or hb3 or hb4 or hb5 or hb6 or hb7 or hb8 or hb9 or hb10, title="HIDDEN BUY",  message="Crypto Scanner — Hidden BUY detected")
alertcondition(hs1 or hs2 or hs3 or hs4 or hs5 or hs6 or hs7 or hs8 or hs9 or hs10, title="HIDDEN SELL", message="Crypto Scanner — Hidden SELL detected")
