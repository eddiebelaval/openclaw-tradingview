//@version=6
indicator("Gold-Oil Ratio", overlay = false)

// 1. Settings (Inputs)
len = input.int(200, "Lookback Period", minval=10)
mult = input.float(2.0, "Boundary Sensitivity", step = 0.1)
isInverted = input.bool(false, "Invert Ratio (Oil/Gold Focus)")

// 2. Color Settings (Gradient Controls)
lowColor  = input.color(color.green, "Low Zone Color (Bottom)")
highColor = input.color(color.red, "High Zone Color (Top)")

upperLineColor = input.color(color.new(color.red, 50), "Upper Band Color")
lowerLineColor = input.color(color.new(color.green, 50), "Lower Band Color")
midLineColor   = input.color(color.new(color.white, 70), "Mean Line Color")
bgFillColor    = input.color(color.new(color.blue, 98), "Background Fill Color")

// 3. Data Fetching
g_c = request.security("COMEX:GC1!", timeframe.period, close)
o_c = request.security("NYMEX:CL1!", timeframe.period, close)
g_o = request.security("COMEX:GC1!", timeframe.period, open)
o_o = request.security("NYMEX:CL1!", timeframe.period, open)

float r_close = isInverted ? (o_c / g_c) : (g_c / o_c)
float r_open  = isInverted ? (o_o / g_o) : (g_o / o_o)

// 4. PRECISION FIX: Only April 19 and 20, 2020
// Targeted surgery on the two days you requested
is_spike_day = (year == 2020 and month == 4 and (dayofmonth == 19 or dayofmonth == 20))
float clean_c = is_spike_day ? ta.sma(r_close, 10) : r_close
float clean_o = is_spike_day ? ta.sma(r_open, 10) : r_open

// 5. Adaptive Bands
avg = ta.sma(clean_c, len)
std = ta.stdev(clean_c, len)
upper = avg + (std * mult)
lower = avg - (std * mult)

// 6. Dynamic Gradient Logic
float position_perc = (clean_c - lower) / (upper - lower) * 100
color final_candle_col = color.from_gradient(position_perc, 0, 100, lowColor, highColor)

// 7. Plotting
plotcandle(clean_o, math.max(clean_o, clean_c), math.min(clean_o, clean_c), clean_c, 
     title="Gradient Candles", color=final_candle_col, wickcolor=final_candle_col, bordercolor=final_candle_col)

p_up = plot(upper, "Upper Band", color = upperLineColor)
p_lo = plot(lower, "Lower Band", color = lowerLineColor)
plot(avg, "Mean Line", color = midLineColor, style = plot.style_linebr)
fill(p_up, p_lo, color = bgFillColor, title = "Normal Zone Fill")
