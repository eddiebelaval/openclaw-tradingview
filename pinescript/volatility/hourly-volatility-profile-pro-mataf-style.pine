//@version=5
indicator("Hourly Volatility Profile PRO", overlay=true)

weeks = input.int(10, "Weeks Lookback")
peakMultiplier = input.float(1.3, "Peak Multiplier")

// ARRAYS
var float[] volHour = array.new_float(24, 0)
var int[] countHour = array.new_int(24, 0)
var float[] avgVol = array.new_float(24, 0)

// VOLATILITY
vol = high - low
h = hour(time)

array.set(volHour, h, array.get(volHour, h) + vol)
array.set(countHour, h, array.get(countHour, h) + 1)

// MEDIA ORARIA
for i = 0 to 23
    c = array.get(countHour, i)
    v = array.get(volHour, i)
    avg = c > 0 ? v / c : 0
    array.set(avgVol, i, avg)

// VALORE ORA ATTUALE
hourVol = array.get(avgVol, h)

// MEDIA GLOBALE
globalAvg = ta.sma(hourVol, 24)

// PICCO
isPeak = hourVol > globalAvg * peakMultiplier
isMedium = hourVol > globalAvg and not isPeak

// COLORI
col =
     isPeak ? color.red :
     isMedium ? color.orange :
     color.blue

// ISTOGRAMMA
plot(hourVol, style=plot.style_columns, color=col, linewidth=3)

// ZONA SUL GRAFICO PREZZO
bgcolor(isPeak ? color.new(color.red,85) : na)
