//@version=6
indicator("Kenya 17:30 Marker (EAT)", overlay=true, max_lines_count=500, max_labels_count=50)

// --- Inputs
showOnlyOn15301H = input.bool(true, "Only show on 15m / 30m / 1H")
maxMarkers        = input.int(60, "Keep last N markers", minval=1, maxval=500)
lineWidth         = input.int(1, "Line width", minval=1, maxval=4)
showLabel         = input.bool(true, "Show label")
labelText         = input.string("17:30 EAT", "Label text")

tz = "Africa/Nairobi"

// --- Timeframe filter
is15  = timeframe.isintraday and timeframe.multiplier == 15
is30  = timeframe.isintraday and timeframe.multiplier == 30
is60  = timeframe.isintraday and timeframe.multiplier == 60
tfOK  = is15 or is30 or is60

// --- Compute today's 17:30 timestamp in Kenya time
y  = year(time, tz)
m  = month(time, tz)
d  = dayofmonth(time, tz)
t1730 = timestamp(tz, y, m, d, 17, 30)

// --- Create marker once per day when we cross 17:30 (Kenya time)
crossed1730 = time >= t1730 and time[1] < t1730

// --- Storage for line ids so we can delete old ones
var line[]  lines = array.new_line()
var label[] labs  = array.new_label()

canDraw = (not showOnlyOn15301H) or tfOK

if canDraw and crossed1730
    // Vertical line spanning full chart height (extend both directions)
    ln = line.new(x1=t1730, y1=na, x2=t1730, y2=na, xloc=xloc.bar_time, extend=extend.both, width=lineWidth)
    array.push(lines, ln)

    if showLabel
        lb = label.new(x=t1730, y=high, xloc=xloc.bar_time, text=labelText, style=label.style_label_down)
        array.push(labs, lb)

    // Delete old markers beyond maxMarkers
    while array.size(lines) > maxMarkers
        oldLn = array.shift(lines)
        line.delete(oldLn)

    while array.size(labs) > maxMarkers
        oldLb = array.shift(labs)
        label.delete(oldLb)

// Optional: show a small warning on unsupported timeframes
if showOnlyOn15301H and not tfOK and barstate.islast
    // Comment this out if you don't want any warning at all
    label.new(bar_index, high, "Switch to 15m / 30m / 1H to see 17:30 EAT markers",
      style=label.style_label_left, textcolor=color.white, color=color.new(color.black, 0))
