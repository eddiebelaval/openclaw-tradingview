//@version=6
indicator("EGU • CVD v2 (Cumulative Volume Delta) + Divergences", overlay=false, max_labels_count=500)

//====================
// INPUTS
//====================
grpCvd = "⚙️ CVD Settings"
resetMode  = input.string("Daily",  "Reset CVD",       options=["Never","Daily","Weekly","Monthly"], group=grpCvd)
useWicks   = input.bool(true,  "Pondération par position du close (wicks)",  group=grpCvd)
smoothLen  = input.int(21, "Smoothing EMA", minval=1, group=grpCvd)
showMA     = input.bool(true, "Afficher EMA du CVD", group=grpCvd)

grpDiv = "📐 Divergences"
showDiv    = input.bool(true,  "Afficher divergences", group=grpDiv)
pivotLen   = input.int(5,  "Pivot length", minval=2, group=grpDiv)
minBarsGap = input.int(5,  "Min bars entre pivots", minval=0, group=grpDiv)
showLines  = input.bool(true, "Tracer les lignes de divergence", group=grpDiv)

grpViz = "🎨 Visuel"
colorBull     = input.color(color.new(#00e5ff, 0),   "Couleur Bull CVD",  group=grpViz)
colorBear     = input.color(color.new(#ff1744, 0),   "Couleur Bear CVD",  group=grpViz)
colorNeutral  = input.color(color.new(#b0bec5, 60),  "Couleur neutre",    group=grpViz)
colorEma      = input.color(color.new(#ffeb3b, 80),  "Couleur EMA",       group=grpViz)

grpAlert = "🔔 Alertes"
alertDiv   = input.bool(true,  "Alertes divergences", group=grpAlert)
alertCross = input.bool(true,  "Alerte croisement CVD / zéro", group=grpAlert)

//====================
// RESET LOGIC
//====================
newDay   = ta.change(time("D"))
newWeek  = ta.change(time("W"))
newMonth = ta.change(time("M"))

doReset = switch resetMode
    "Daily"   => bool(newDay)
    "Weekly"  => bool(newWeek)
    "Monthly" => bool(newMonth)
    => false

//====================
// DELTA ESTIMATION
//====================
rng     = math.max(high - low, syminfo.mintick)
posInBar = (close - low) / rng
signedW  = (posInBar - 0.5) * 2.0

delta = useWicks ? (volume * signedW) : (close>open ? volume : close < open ? -volume : 0.0)


//====================
// CVD
//====================
var float cvd = na
cvd := na(cvd) ? delta : (doReset ? delta : cvd + delta)

cvdEma = ta.ema(cvd, smoothLen)

// Couleur dynamique selon direction
cvdColor = cvd > cvdEma ? colorBull : cvd < cvdEma ? colorBear : colorNeutral

//====================
// HISTOGRAMME + LIGNE
//====================
// Histogramme de delta (barre par barre) pour voir la pression en temps réel
plot(delta, "Delta (barre)", style=plot.style_columns,
     color=delta >= 0 ? color.new(colorBull, 55) : color.new(colorBear, 55))

// CVD principal
plot(cvd, "CVD", color=cvdColor, linewidth=2)

// EMA
plot(showMA ? cvdEma : na, "CVD EMA", color=colorEma, linewidth=1, style=plot.style_line)

// Zero line
hline(0, "Zero", color=color.new(color.white, 70), linestyle=hline.style_dotted, linewidth=1)

//====================
// COLORATION FOND (zone positive / négative)
//====================
bgcolor(cvd > 0 ? color.new(colorBull, 93) : color.new(colorBear, 93), title="Zone CVD")

//====================
// CROISEMENT CVD / ZERO
//====================
crossUp   = ta.crossover(cvd, 0)
crossDown = ta.crossunder(cvd, 0)

plotshape(crossUp,   title="Cross Up",   style=shape.triangleup,   location=location.bottom, color=colorBull, size=size.tiny)
plotshape(crossDown, title="Cross Down", style=shape.triangledown, location=location.top,    color=colorBear, size=size.tiny)

if alertCross and crossUp
    alert("CVD croise le zéro vers le HAUT — possible momentum bullish", alert.freq_once_per_bar)
if alertCross and crossDown
    alert("CVD croise le zéro vers le BAS — possible momentum bearish", alert.freq_once_per_bar)

//====================
// DIVERGENCES
//====================
phPrice = ta.pivothigh(high, pivotLen, pivotLen)
plPrice = ta.pivotlow(low,   pivotLen, pivotLen)
phCvd   = ta.pivothigh(cvd,  pivotLen, pivotLen)
plCvd   = ta.pivotlow(cvd,   pivotLen, pivotLen)

var float lastPH_price = na
var int   lastPH_bar   = na
var float lastPH_cvd   = na
var float lastPH_cvdBar = na  // valeur cvd au bar du pivot pour tracer la ligne

var float lastPL_price = na
var int   lastPL_bar   = na
var float lastPL_cvd   = na
var float lastPL_cvdBar = na

// --- BEARISH : prix HH mais CVD LH ---
if showDiv and not na(phPrice) and not na(phCvd)
    curBar       = bar_index - pivotLen
    curPH_price  = phPrice
    curPH_cvd    = phCvd

    if not na(lastPH_price) and (curBar - lastPH_bar >= minBarsGap)
        isHH = curPH_price > lastPH_price
        isLH = curPH_cvd   < lastPH_cvd
        if isHH and isLH
            lbl = label.new(curBar, curPH_cvd,
                 "🔴 Bear Div",
                 style=label.style_label_down,
                 color=color.new(colorBear, 15),
                 textcolor=color.white,
                 size=size.small)
            if showLines
                line.new(lastPH_bar, lastPH_cvd, curBar, curPH_cvd,
                     color=colorBear, width=2, style=line.style_dashed)
            if alertDiv
                alert("🔴 Divergence BEARISH détectée sur CVD", alert.freq_once_per_bar)

    lastPH_price  := curPH_price
    lastPH_cvd    := curPH_cvd
    lastPH_bar    := curBar

// --- BULLISH : prix LL mais CVD HL ---
if showDiv and not na(plPrice) and not na(plCvd)
    curBar       = bar_index - pivotLen
    curPL_price  = plPrice
    curPL_cvd    = plCvd

    if not na(lastPL_price) and (curBar - lastPL_bar >= minBarsGap)
        isLL = curPL_price < lastPL_price
        isHL = curPL_cvd   > lastPL_cvd
        if isLL and isHL
            lbl = label.new(curBar, curPL_cvd,
                 "🟢 Bull Div",
                 style=label.style_label_up,
                 color=color.new(colorBull, 15),
                 textcolor=color.white,
                 size=size.small)
            if showLines
                line.new(lastPL_bar, lastPL_cvd, curBar, curPL_cvd,
                     color=colorBull, width=2, style=line.style_dashed)
            if alertDiv
                alert("🟢 Divergence BULLISH détectée sur CVD", alert.freq_once_per_bar)

    lastPL_price  := curPL_price
    lastPL_cvd    := curPL_cvd
    lastPL_bar    := curBar

//====================
// TABLE INFO (coin bas droite)
//====================
var table infoTable = table.new(position.bottom_right, 2, 4,
     bgcolor=color.new(color.black, 60), border_width=1)

if barstate.islast
    cvdState = cvd > 0 ? "🟢 Positif" : "🔴 Négatif"
    trend    = cvd > cvdEma ? "↑ Au dessus EMA" : "↓ En dessous EMA"
    resetLbl = "Reset : " + resetMode

    table.cell(infoTable, 0, 0, "CVD",       text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, cvdState,     text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 1, "Tendance",   text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, trend,        text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 2, "Delta bar",  text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(math.round(delta)),
               text_color=delta >= 0 ? colorBull : colorBear, text_size=size.small)
    table.cell(infoTable, 0, 3, resetLbl,    text_color=color.new(color.white,40), text_size=size.tiny)
    table.cell(infoTable, 1, 3, syminfo.ticker, text_color=color.new(color.white,40), text_size=size.tiny)
