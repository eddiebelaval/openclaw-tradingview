//@version=6
indicator("Average candle size + SL levels", overlay=true)

// Calculs (on exclut la bougie en cours)
avg26 = ta.sma(high[1] - low[1], 26)
avg52 = ta.sma(high[1] - low[1], 52)
stopLoss = avg26 + avg52

// SL basés sur l'avant-dernière bougie
slUpper = high[1] + stopLoss
slLower = low[1] - stopLoss

// Création de la table (une seule fois)
var table t = table.new(position.top_right, 1, 5, border_width = 1)

// Mise à jour seulement sur la dernière bougie
if barstate.islast and not na(avg52)
    table.cell(t, 0, 0, "Average 26 candles: " + str.tostring(avg26, "#.##"), text_color=color.white, bgcolor=color.new(#0066FF, 0))
    table.cell(t, 0, 1, "Average 52 candles: " + str.tostring(avg52, "#.##"), text_color=color.white, bgcolor=color.new(#0066FF, 0))
    table.cell(t, 0, 2, "Stop Loss (52 + 26): " + str.tostring(stopLoss, "#.##"), text_color=color.white, bgcolor=color.new(#0066FF, 0))
    table.cell(t, 0, 3, "SL Upper (High[1] + SL): " + str.tostring(slUpper, "#.##"), text_color=color.white, bgcolor=color.new(#0066FF, 0))
    table.cell(t, 0, 4, "SL Lower (Low[1] - SL): " + str.tostring(slLower, "#.##"), text_color=color.white, bgcolor=color.new(#0066FF, 0))
