//@version=5
indicator("Daily ATR Box (Remaining → Locked w/ Extensions)", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

//====================================================================
// Inputs
//====================================================================
atrLen        = input.int(14, "Daily ATR Length", minval=1)
usePrevDayATR = input.bool(true, "Use PRIOR Daily ATR (recommended)", tooltip="Keeps ATR constant during the day (non-repainting).")

seg0Fill   = input.color(color.new(color.teal, 85),   "Primary Fill (Segment 0)")
seg0Border = input.color(color.new(color.teal, 0),    "Primary Border (Segment 0)")

// Extension colors by ATR multiple
ext1Fill   = input.color(color.new(color.yellow, 85), "Extension Fill (1×ATR)", tooltip="Color used for the FIRST extension segment outside the locked ATR range. This segment represents an extension distance of 1.00–1.99 ATR.")
ext1Border = input.color(color.new(color.yellow, 0),  "Extension Border (1×ATR)")

ext2Fill   = input.color(color.new(color.orange, 82), "Extension Fill (2×ATR)", tooltip="Color used once price extends into the SECOND extension segment. This segment represents an extension distance of 2.00–2.99 ATR.")
ext2Border = input.color(color.new(color.orange, 0),  "Extension Border (2×ATR)")

ext3Fill   = input.color(color.new(color.red, 82),    "Extension Fill (3×ATR+)", tooltip="Color used once price extends into the THIRD extension segment or beyond. This segment represents an extension distance of 3.00+ ATR.")
ext3Border = input.color(color.new(color.red, 0),     "Extension Border (3×ATR+)")

maxSegmentsEachSide = input.int(6, "Max Extension Segments Per Side", minval=0, maxval=50)

// HUD controls
showHUD     = input.bool(true, "Show ATR HUD Box")
hudPosStr   = input.string("Top Right", "HUD Position",
     options=["Top Left","Top Center","Top Right",
              "Middle Left","Middle Center","Middle Right",
              "Bottom Left","Bottom Center","Bottom Right"])
hudTextSize = input.string("Small", "HUD Text Size",
     options=["Tiny","Small","Normal","Large","Huge"])

//====================================================================
// HUD style customizations (edit these here)
//====================================================================
HUD_BG_COLOR    = color.new(color.black, 0)
HUD_TEXT_COLOR  = color.white
HUD_FRAME_COLOR = color.new(color.white, 70)
HUD_FRAME_WIDTH = 1

//====================================================================
// Helpers
//====================================================================
f_pos(string p) =>
    pos = position.top_right
    if p == "Top Left"
        pos := position.top_left
    else if p == "Top Center"
        pos := position.top_center
    else if p == "Top Right"
        pos := position.top_right
    else if p == "Middle Left"
        pos := position.middle_left
    else if p == "Middle Center"
        pos := position.middle_center
    else if p == "Middle Right"
        pos := position.middle_right
    else if p == "Bottom Left"
        pos := position.bottom_left
    else if p == "Bottom Center"
        pos := position.bottom_center
    else if p == "Bottom Right"
        pos := position.bottom_right
    pos

f_size(string s) =>
    sz = size.small
    if s == "Tiny"
        sz := size.tiny
    else if s == "Small"
        sz := size.small
    else if s == "Normal"
        sz := size.normal
    else if s == "Large"
        sz := size.large
    else if s == "Huge"
        sz := size.huge
    sz

f_extFill(int k) =>
    k == 1 ? ext1Fill : k == 2 ? ext2Fill : ext3Fill

f_extBorder(int k) =>
    k == 1 ? ext1Border : k == 2 ? ext2Border : ext3Border

//====================================================================
// Daily series
//====================================================================
openD  = request.security(syminfo.tickerid, "D", open, barmerge.gaps_off, barmerge.lookahead_off)
atrRaw = request.security(syminfo.tickerid, "D", ta.atr(atrLen), barmerge.gaps_off, barmerge.lookahead_off)
atrD   = usePrevDayATR ? atrRaw[1] : atrRaw

newDay = timeframe.change("D")

//====================================================================
// Track intraday high/low
//====================================================================
var float dayHigh = na
var float dayLow  = na
var float prevDayHigh = na
var float prevDayLow  = na

if newDay
    dayHigh := high
    dayLow  := low
    prevDayHigh := na
    prevDayLow  := na
else
    prevDayHigh := dayHigh
    prevDayLow  := dayLow
    dayHigh := math.max(dayHigh, high)
    dayLow  := math.min(dayLow, low)

//====================================================================
// Remaining-budget box (pre-fill)
//====================================================================
baseUpper = openD + atrD
baseLower = openD - atrD

upExcursion = math.max(0.0, dayHigh - openD)
dnExcursion = math.max(0.0, openD - dayLow)

remLower = baseLower + upExcursion
remUpper = baseUpper - dnExcursion

rangeFilled = atrD > 0 ? ((dayHigh - dayLow) >= atrD) : false
filledNow   = rangeFilled

//====================================================================
// Lock Segment 0 on first fill
//====================================================================
var bool   locked   = false
var float  seg0TopL = na
var float  seg0BotL = na
var string lockSide = ""

madeNewHigh = not na(prevDayHigh) and dayHigh > prevDayHigh
madeNewLow  = not na(prevDayLow)  and dayLow  < prevDayLow

if newDay
    locked   := false
    seg0TopL := na
    seg0BotL := na
    lockSide := ""

if (not locked) and filledNow
    locked := true

    if madeNewHigh and not madeNewLow
        seg0BotL := dayLow
        seg0TopL := dayLow + atrD
        lockSide := "LOW-ANCHORED"
    else if madeNewLow and not madeNewHigh
        seg0TopL := dayHigh
        seg0BotL := dayHigh - atrD
        lockSide := "HIGH-ANCHORED"
    else
        downDominant = dnExcursion > upExcursion
        if downDominant
            seg0TopL := dayHigh
            seg0BotL := dayHigh - atrD
            lockSide := "HIGH-ANCHORED*"
        else
            seg0BotL := dayLow
            seg0TopL := dayLow + atrD
            lockSide := "LOW-ANCHORED*"

seg0Top = locked ? seg0TopL : remUpper
seg0Bot = locked ? seg0BotL : remLower

//====================================================================
// Extensions (only after lock)
//====================================================================
distDown = locked ? math.max(0.0, seg0Bot - dayLow) : 0.0
distUp   = locked ? math.max(0.0, dayHigh - seg0Top) : 0.0

extDownCount = (locked and distDown > 0 and atrD > 0) ? (math.floor(distDown / atrD) + 1) : 0
extUpCount   = (locked and distUp   > 0 and atrD > 0) ? (math.floor(distUp   / atrD) + 1) : 0

extDownCount := math.min(extDownCount, maxSegmentsEachSide)
extUpCount   := math.min(extUpCount,   maxSegmentsEachSide)

//====================================================================
// Boxes
//====================================================================
var box   seg0Box   = na
var box[] downBoxes = array.new_box()
var box[] upBoxes   = array.new_box()

f_deleteAll(_seg0Box, box[] _down, box[] _up) =>
    if not na(_seg0Box)
        box.delete(_seg0Box)

    int dn = array.size(_down)
    if dn > 0
        for i = 0 to dn - 1
            bx = array.get(_down, i)
            if not na(bx)
                box.delete(bx)

    int upn = array.size(_up)
    if upn > 0
        for i = 0 to upn - 1
            bx = array.get(_up, i)
            if not na(bx)
                box.delete(bx)

f_resizeArray(box[] arr, int desired) =>
    while array.size(arr) < desired
        array.push(arr, na)
    while array.size(arr) > desired
        last = array.pop(arr)
        if not na(last)
            box.delete(last)

if newDay
    f_deleteAll(seg0Box, downBoxes, upBoxes)
    seg0Box := na
    array.clear(downBoxes)
    array.clear(upBoxes)

if na(seg0Box)
    seg0Box := box.new(bar_index, seg0Top, bar_index, seg0Bot, bgcolor=seg0Fill, border_color=seg0Border, border_width=1)
else
    box.set_right(seg0Box, bar_index)
    box.set_top(seg0Box, seg0Top)
    box.set_bottom(seg0Box, seg0Bot)

if not locked
    f_resizeArray(downBoxes, 0)
    f_resizeArray(upBoxes, 0)
else
    f_resizeArray(downBoxes, extDownCount)
    f_resizeArray(upBoxes,   extUpCount)

if locked
    int dn = array.size(downBoxes)
    if dn > 0
        for i = 0 to dn - 1
            k = i + 1
            topD = seg0Bot - (atrD * (k - 1))
            botD = seg0Bot - (atrD * k)

            bx = array.get(downBoxes, i)
            if na(bx)
                bx := box.new(bar_index, topD, bar_index, botD, bgcolor=f_extFill(k), border_color=f_extBorder(k), border_width=1)
                array.set(downBoxes, i, bx)
            else
                box.set_right(bx, bar_index)
                box.set_top(bx, topD)
                box.set_bottom(bx, botD)

if locked
    int upn = array.size(upBoxes)
    if upn > 0
        for i = 0 to upn - 1
            k = i + 1
            topU = seg0Top + (atrD * k)
            botU = seg0Top + (atrD * (k - 1))

            bx = array.get(upBoxes, i)
            if na(bx)
                bx := box.new(bar_index, topU, bar_index, botU, bgcolor=f_extFill(k), border_color=f_extBorder(k), border_width=1)
                array.set(upBoxes, i, bx)
            else
                box.set_right(bx, bar_index)
                box.set_top(bx, topU)
                box.set_bottom(bx, botU)

//====================================================================
// HUD Box
//====================================================================
var table  hud     = na
var string prevPos = na

if barstate.isfirst or hudPosStr != prevPos
    if not na(hud)
        table.delete(hud)
    hud := table.new(f_pos(hudPosStr), 1, 2, frame_color=HUD_FRAME_COLOR, frame_width=HUD_FRAME_WIDTH)
    prevPos := hudPosStr

remaining = math.max(0.0, atrD - (upExcursion + dnExcursion))

if showHUD and not na(hud)
    string line1 = "$" + syminfo.ticker + " Daily ATR(" + str.tostring(atrLen) + "): $" + str.tostring(atrD, format.mintick)

    string line2 =
         locked
             ? ("Range Filled & Locked (" + lockSide + ")")
             : ("LIVE (Remaining: $" + str.tostring(remaining, format.mintick) + ")")

    table.cell(hud, 0, 0, line1, text_color=HUD_TEXT_COLOR, bgcolor=HUD_BG_COLOR, text_size=f_size(hudTextSize))
    table.cell(hud, 0, 1, line2, text_color=HUD_TEXT_COLOR, bgcolor=HUD_BG_COLOR, text_size=f_size(hudTextSize))
