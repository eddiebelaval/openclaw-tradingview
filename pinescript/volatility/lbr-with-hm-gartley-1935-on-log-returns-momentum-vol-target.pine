//@version=6
strategy("Log Returns Momentum + Vol Target v6 - Fixed with Closes", 
     overlay           = true,
     initial_capital   = 10000,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 100,
     currency          = currency.USD,
     calc_on_every_tick = false,
     pyramiding        = 1)  // Increase to 2-5 if you want layering

// ── Inputs ────────────────────────────────────────────────────────────────
int    mom_len          = input.int(50,   "Momentum Lookback (bars)", minval=5)
int    vol_len          = input.int(20,   "Volatility Lookback", minval=5)
float  target_vol_pct   = input.float(20.0, "Target Annual Vol (%)", step=0.1, minval=0.1)
int    ann_days         = input.int(252,  "Annual Trading Days", minval=100)

float  tp_pct           = input.float(5.0,  "Take Profit %", step=0.1)   // Smaller for gold
float  sl_pct           = input.float(3.0,  "Stop Loss %", step=0.1)

bool   use_strict_cross = input.bool(false, "Use strict crossover (fewer trades)")
bool   use_mom_sma_filter = input.bool(false, "Filter with SMA on Momentum")
int    mom_sma_len      = input.int(10, "SMA Length on Momentum", minval=1)

// ── Calculations ──────────────────────────────────────────────────────────
float target_vol     = target_vol_pct / 100
float log_ret        = na(close[1]) ? 0.0 : math.log(close / close[1])
float mom_log        = na(close[mom_len]) ? 0.0 : math.log(close / close[mom_len])
float vol_sample     = ta.stdev(log_ret, vol_len)
float realized_vol   = na(vol_sample) ? 0.0 : vol_sample * math.sqrt(ann_days)
float size_factor    = target_vol / math.max(realized_vol, 0.005)

float qty = (strategy.equity * size_factor) / close
qty := math.max(qty, 1.0)

float mom_filtered = use_mom_sma_filter ? ta.sma(mom_log, mom_sma_len) : mom_log

bool bullish = use_strict_cross ? (mom_filtered > 0 and ta.crossover(mom_filtered, 0)) : (mom_filtered > 0)
bool bearish = use_strict_cross ? (mom_filtered < 0 and ta.crossunder(mom_filtered, 0)) : (mom_filtered < 0)

// ── Force close on opposite + entry ──────────────────────────────────────
if bullish and strategy.position_size < 0
    strategy.close("Short", comment="Reverse to Long")
    log.info("Closed Short → Reverse to Long")

if bearish and strategy.position_size > 0
    strategy.close("Long", comment="Reverse to Short")
    log.info("Closed Long → Reverse to Short")

// ── Entries ───────────────────────────────────────────────────────────────
if bullish
    strategy.entry("Long", strategy.long, qty = qty)
    log.info("Entry Long")

if bearish
    strategy.entry("Short", strategy.short, qty = qty)
    log.info("Entry Short")

// ── Percentage-based Exits (calculated dynamically) ───────────────────────
if strategy.position_size > 0  // Long position
    float entry_price = strategy.position_avg_price
    strategy.exit("TP/SL Long", "Long", 
         limit = entry_price * (1 + tp_pct/100), 
         stop  = entry_price * (1 - sl_pct/100))

if strategy.position_size < 0  // Short position
    float entry_price = strategy.position_avg_price
    strategy.exit("TP/SL Short", "Short", 
         limit = entry_price * (1 - tp_pct/100), 
         stop  = entry_price * (1 + sl_pct/100))

// ── Visuals & Debug (unchanged) ──────────────────────────────────────────
plot(mom_filtered, "Momentum (filtered)", color = color.blue, linewidth = 2)
hline(0, "Zero", color = color.gray, linestyle = hline.style_dashed)

plotshape(bullish, "Bull", shape.triangleup,   location.belowbar, color.green,  size = size.small)
plotshape(bearish, "Bear", shape.triangledown, location.abovebar, color.red,    size = size.small)

// Debug table (added signal state)
var table debug = table.new(position.top_right, 2, 5, border_width=1, bgcolor=color.new(color.black, 80))
if barstate.islast
    table.cell(debug, 0, 0, "Real Vol", text_color=color.white)
    table.cell(debug, 1, 0, str.tostring(math.round(realized_vol*100, 2)) + "%", text_color=color.white)
    table.cell(debug, 0, 1, "Size Factor", text_color=color.white)
    table.cell(debug, 1, 1, str.tostring(math.round(size_factor, 3)), text_color=color.white)
    table.cell(debug, 0, 2, "Qty", text_color=color.white)
    table.cell(debug, 1, 2, str.tostring(math.round(qty, 2)), text_color=color.white)
    table.cell(debug, 0, 3, "Momentum", text_color=color.white)
    table.cell(debug, 1, 3, str.tostring(math.round(mom_filtered, 4)), text_color=color.white)
    table.cell(debug, 0, 4, "Signal", text_color=color.white)
    table.cell(debug, 1, 4, bullish ? "LONG" : bearish ? "SHORT" : "FLAT", text_color = bullish ? color.green : bearish ? color.red : color.gray)

// Alerts
alertcondition(bullish, title="Bullish Momentum Signal", message="Log Momentum BUY on {{ticker}}")
alertcondition(bearish, title="Bearish Momentum Signal", message="Log Momentum SELL on {{ticker}}")
