//@version=5
indicator("Dual Bollinger Clouds (20, x2 & x3)", overlay=true)

// Inputs
len     = input.int(20, "Length", minval=1)
src     = input.source(close, "Source")
mult1   = input.float(2.0, "Multiplier 1 (inner)", step=0.1)
mult2   = input.float(3.0, "Multiplier 2 (outer)", step=0.1)

// Basis & stdev
basis = ta.sma(src, len)
dev   = ta.stdev(src, len)

// Bands (inner = mult1, outer = mult2)
upper1 = basis + dev * mult1
lower1 = basis - dev * mult1
upper2 = basis + dev * mult2
lower2 = basis - dev * mult2

// Plot bands (optional visibility controls)
showBands = input.bool(true, "Show Band Lines")

pUpper1 = plot(showBands ? upper1 : na, "Upper x2", color=color.new(color.red, 0), linewidth=1)
pUpper2 = plot(showBands ? upper2 : na, "Upper x3", color=color.new(color.red, 0), linewidth=1)
pLower1 = plot(showBands ? lower1 : na, "Lower x2", color=color.new(color.lime, 0), linewidth=1)
pLower2 = plot(showBands ? lower2 : na, "Lower x3", color=color.new(color.lime, 0), linewidth=1)

// Clouds
fill(pUpper1, pUpper2, title="Upper Red Cloud", color=color.new(color.red, 80))
fill(pLower1, pLower2, title="Lower Green Cloud", color=color.new(color.lime, 80))

// (Optional) Basis
showBasis = input.bool(false, "Show Basis (SMA)")
plot(showBasis ? basis : na, "Basis", color=color.new(color.gray, 0), linewidth=1)
