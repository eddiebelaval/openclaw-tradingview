//@version=6
indicator('6% Trailing Stop Loss Alert', overlay = true)

// --- Inputs ---
tslPercent = input.float(6.0, title = 'Trailing Stop %', minval = 0.1) / 100

// --- TSL Logic ---
var float highSinceEntry = na
var float trailStop = na
var bool inTrade = false

// Detect new high and trail stop
if not inTrade
    highSinceEntry := high
    trailStop := high * (1 - tslPercent)
    inTrade := true
    inTrade
else
    if high > highSinceEntry
        highSinceEntry := high
        trailStop := highSinceEntry * (1 - tslPercent)
        trailStop

// Trigger: price closes below trailing stop
tslTriggered = close < trailStop

// Reset after trigger
if tslTriggered
    inTrade := false
    highSinceEntry := na
    highSinceEntry

// --- Plots ---
plot(trailStop, title = '6% Trail Stop', color = color.red, linewidth = 2, style = plot.style_line)
plotshape(tslTriggered, title = 'TSL Hit', location = location.belowbar, color = color.red, style = shape.xcross, size = size.small)

// --- Alert ---
alertcondition(tslTriggered, title = '6% TSL Triggered', message = '6% Trailing Stop Loss HIT — {{ticker}} closed below trail stop at {{close}}')
