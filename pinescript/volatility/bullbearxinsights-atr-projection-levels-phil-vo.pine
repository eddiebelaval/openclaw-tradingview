//@version=5
indicator("BullBearXinsights - ATR Projection Levels [Phil Vo]", overlay=true, max_lines_count=500, max_labels_count=500)

//====================================================
// INPUTS
//====================================================
groupCore    = "Core"
groupTrend   = "Trend Context"
groupDisplay = "Display"
groupLevels  = "ATR Levels"
groupAlerts  = "Alerts"

atrLen     = input.int(7, "Daily ATR Length", minval=1, group=groupCore, tooltip="ATR is calculated from the Daily timeframe.")
fastEMALen = input.int(9, "Fast EMA", minval=1, group=groupTrend, tooltip="Short-term trend guide.")
slowEMALen = input.int(21, "Slow EMA", minval=1, group=groupTrend, tooltip="Trend confirmation guide.")

showSessionOpen   = input.bool(true, "Show Session Open", group=groupDisplay, tooltip="Plots the session open.")
showEMAContext    = input.bool(true, "Show EMA + VWAP", group=groupDisplay, tooltip="Plots EMA 9, EMA 21, and VWAP.")
showATRLevels     = input.bool(true, "Show ATR Levels", group=groupDisplay, tooltip="Projects ATR levels from session open.")
showLevelPercents = input.bool(true, "Show % Labels", group=groupDisplay, tooltip="Shows readable percentage labels at the end of enabled ATR levels.")

lvl25  = input.bool(true,  "25%",  group=groupLevels, inline="lvl", tooltip="Quarter ATR projection.")
lvl50  = input.bool(true,  "50%",  group=groupLevels, inline="lvl", tooltip="Half ATR projection.")
lvl80  = input.bool(true,  "80%",  group=groupLevels, inline="lvl", tooltip="Expanded ATR projection.")
lvl100 = input.bool(true,  "100%", group=groupLevels, inline="lvl", tooltip="Full ATR projection.")
lvl120 = input.bool(false, "120%", group=groupLevels, inline="lvl", tooltip="Extended ATR projection.")

enableAlerts = input.bool(true, "Enable ATR Threshold Alerts", group=groupAlerts, tooltip="Creates basic alerts when ATR usage crosses major thresholds.")

//====================================================
// DAILY ATR
//====================================================
dailyATR = request.security(syminfo.tickerid, "D", ta.atr(atrLen), barmerge.gaps_off, barmerge.lookahead_off)

//====================================================
// SESSION TRACKING
//====================================================
isNewSession = ta.change(time("D")) != 0

var float sessionOpen = na
var float sessionHighSinceOpen = na
var float sessionLowSinceOpen = na

if isNewSession or na(sessionOpen)
    sessionOpen := open
    sessionHighSinceOpen := high
    sessionLowSinceOpen := low
else
    sessionHighSinceOpen := math.max(sessionHighSinceOpen, high)
    sessionLowSinceOpen := math.min(sessionLowSinceOpen, low)

//====================================================
// ATR USAGE CALC
//====================================================
upMovePoints   = sessionHighSinceOpen - sessionOpen
downMovePoints = sessionOpen - sessionLowSinceOpen
dominantMovePoints = math.max(upMovePoints, downMovePoints)
dominantATRUsedPct = dailyATR > 0 ? (dominantMovePoints / dailyATR) * 100.0 : na

//====================================================
// EMA + VWAP
//====================================================
emaFast = ta.ema(close, fastEMALen)
emaSlow = ta.ema(close, slowEMALen)
vwapVal = ta.vwap(hlc3)

//====================================================
// ATR LEVELS
//====================================================
atr25  = dailyATR * 0.25
atr50  = dailyATR * 0.50
atr80  = dailyATR * 0.80
atr100 = dailyATR * 1.00
atr120 = dailyATR * 1.20

up25   = sessionOpen + atr25
up50   = sessionOpen + atr50
up80   = sessionOpen + atr80
up100  = sessionOpen + atr100
up120  = sessionOpen + atr120

dn25   = sessionOpen - atr25
dn50   = sessionOpen - atr50
dn80   = sessionOpen - atr80
dn100  = sessionOpen - atr100
dn120  = sessionOpen - atr120

//====================================================
// COLORS
//====================================================
colLine      = color.new(color.gray, 55)
colLineBold  = color.new(color.silver, 15)
colSession   = color.new(color.white, 0)
colFast      = color.new(color.yellow, 10)
colSlow      = color.new(color.orange, 15)
colVWAP      = color.new(color.aqua, 10)
colLabel25   = color.new(color.black, 35)
colLabel50   = color.new(color.black, 30)
colLabel80   = color.new(color.black, 25)
colLabel100  = color.new(color.black, 20)
colLabel120  = color.new(color.black, 15)

//====================================================
// PLOTS
//====================================================
plot(showSessionOpen ? sessionOpen : na, "Session Open", color=colSession, linewidth=2)

plot(showATRLevels and lvl25 ? up25 : na, "ATR Up 25%", color=colLine, linewidth=1, style=plot.style_line)
plot(showATRLevels and lvl50 ? up50 : na, "ATR Up 50%", color=colLine, linewidth=1, style=plot.style_line)
plot(showATRLevels and lvl80 ? up80 : na, "ATR Up 80%", color=colLine, linewidth=1, style=plot.style_line)
plot(showATRLevels and lvl100 ? up100 : na, "ATR Up 100%", color=colLineBold, linewidth=2, style=plot.style_line)
plot(showATRLevels and lvl120 ? up120 : na, "ATR Up 120%", color=colLineBold, linewidth=2, style=plot.style_line)

plot(showATRLevels and lvl25 ? dn25 : na, "ATR Down 25%", color=colLine, linewidth=1, style=plot.style_line)
plot(showATRLevels and lvl50 ? dn50 : na, "ATR Down 50%", color=colLine, linewidth=1, style=plot.style_line)
plot(showATRLevels and lvl80 ? dn80 : na, "ATR Down 80%", color=colLine, linewidth=1, style=plot.style_line)
plot(showATRLevels and lvl100 ? dn100 : na, "ATR Down 100%", color=colLineBold, linewidth=2, style=plot.style_line)
plot(showATRLevels and lvl120 ? dn120 : na, "ATR Down 120%", color=colLineBold, linewidth=2, style=plot.style_line)

plot(showEMAContext ? emaFast : na, "EMA 9", color=colFast, linewidth=1)
plot(showEMAContext ? emaSlow : na, "EMA 21", color=colSlow, linewidth=1)
plot(showEMAContext ? vwapVal : na, "VWAP", color=colVWAP, linewidth=2)

//====================================================
// READABLE % LABELS AT LINE ENDS
//====================================================
var label lblUp25 = na
var label lblUp50 = na
var label lblUp80 = na
var label lblUp100 = na
var label lblUp120 = na
var label lblDn25 = na
var label lblDn50 = na
var label lblDn80 = na
var label lblDn100 = na
var label lblDn120 = na

if barstate.islast
    label.delete(lblUp25)
    label.delete(lblUp50)
    label.delete(lblUp80)
    label.delete(lblUp100)
    label.delete(lblUp120)
    label.delete(lblDn25)
    label.delete(lblDn50)
    label.delete(lblDn80)
    label.delete(lblDn100)
    label.delete(lblDn120)

    if showATRLevels and showLevelPercents
        if lvl25
            lblUp25 := label.new(bar_index + 2, up25, "+25%", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=color.white, color=colLabel25, size=size.small)
            lblDn25 := label.new(bar_index + 2, dn25, "-25%", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=color.white, color=colLabel25, size=size.small)

        if lvl50
            lblUp50 := label.new(bar_index + 2, up50, "+50%", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=color.white, color=colLabel50, size=size.small)
            lblDn50 := label.new(bar_index + 2, dn50, "-50%", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=color.white, color=colLabel50, size=size.small)

        if lvl80
            lblUp80 := label.new(bar_index + 2, up80, "+80%", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=color.white, color=colLabel80, size=size.small)
            lblDn80 := label.new(bar_index + 2, dn80, "-80%", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=color.white, color=colLabel80, size=size.small)

        if lvl100
            lblUp100 := label.new(bar_index + 2, up100, "+100%", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=color.white, color=colLabel100, size=size.small)
            lblDn100 := label.new(bar_index + 2, dn100, "-100%", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=color.white, color=colLabel100, size=size.small)

        if lvl120
            lblUp120 := label.new(bar_index + 2, up120, "+120%", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=color.white, color=colLabel120, size=size.small)
            lblDn120 := label.new(bar_index + 2, dn120, "-120%", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=color.white, color=colLabel120, size=size.small)

//====================================================
// BASIC ALERTS
//====================================================
entered50  = enableAlerts and dominantATRUsedPct >= 50 and dominantATRUsedPct[1] < 50
entered80  = enableAlerts and dominantATRUsedPct >= 80 and dominantATRUsedPct[1] < 80
entered100 = enableAlerts and dominantATRUsedPct >= 100 and dominantATRUsedPct[1] < 100
entered120 = enableAlerts and dominantATRUsedPct >= 120 and dominantATRUsedPct[1] < 120

alertcondition(entered50, "ATR 50% Reached", "Price has reached 50% of Daily ATR.")
alertcondition(entered80, "ATR 80% Reached", "Price has reached 80% of Daily ATR.")
alertcondition(entered100, "ATR 100% Reached", "Price has reached 100% of Daily ATR.")
alertcondition(entered120, "ATR 120% Reached", "Price has reached 120% of Daily ATR.")
