// © officialjackofalltrades
//@version=6
indicator("Thermal Momentum Gauge [JOAT]", shorttitle="TMG [JOAT]", overlay=false, max_bars_back=500)

// ═══════════════════════════════════════════════════════════════════════════════
// THERMAL MOMENTUM GAUGE - Institutional Grade Pressure & Volatility Monitor
// Combines Market Pressure, Volatility Temperature, and Explosion Detection
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════

// Pressure Settings (Market Cipher + Market Scan Methods)
pressureGroup = "═══ Pressure Settings ═══"
rsiLen = input.int(14, "RSI Length", minval=1, group=pressureGroup, tooltip="Standard RSI period for pressure calculation")
wtLen1 = input.int(10, "WT Channel Length", minval=1, group=pressureGroup, tooltip="LazyBear WaveTrend channel period")
wtLen2 = input.int(21, "WT Average Length", minval=1, group=pressureGroup, tooltip="WaveTrend smoothing period")
mfiLen = input.int(14, "MFI Length", minval=1, group=pressureGroup, tooltip="Money Flow Index period")
stochLen = input.int(14, "Stochastic Length", minval=1, group=pressureGroup, tooltip="Stochastic RSI period for additional pressure")
useStochPressure = input.bool(true, "Use Stochastic Pressure", group=pressureGroup, tooltip="Add Stochastic RSI to pressure calculation")

// Temperature Settings (BTC Strategy Volume Method)
tempGroup = "═══ Temperature Settings ═══"
atrLen = input.int(14, "ATR Length", minval=1, group=tempGroup, tooltip="Average True Range period for volatility")
atrMultiplier = input.float(10.0, "Temperature Multiplier", minval=1.0, step=0.5, group=tempGroup, tooltip="Sensitivity adjustment for temperature gauge")
useBollingerTemp = input.bool(true, "Use Bollinger Band Width", group=tempGroup, tooltip="Add BB width to temperature calculation")
bbLen = input.int(20, "BB Length", minval=1, group=tempGroup)
bbMult = input.float(2.0, "BB Multiplier", minval=0.1, step=0.1, group=tempGroup)

// Volume Settings (BTC Strategy Volume + Market Cipher Methods)
volGroup = "═══ Volume Settings ═══"
volLen = input.int(20, "Volume MA Length", minval=1, group=volGroup, tooltip="Moving average period for volume comparison")
steamThreshold = input.float(2.0, "Steam Threshold", minval=1.0, step=0.1, group=volGroup, tooltip="Volume spike multiplier for steam detection")
useVolDelta = input.bool(true, "Use Volume Delta", group=volGroup, tooltip="Track buy vs sell volume pressure")
showVolSpikes = input.bool(true, "Show Volume Spikes", group=volGroup, tooltip="Highlight extreme volume events")

// Explosion Settings (Multi-Factor Confluence)
expGroup = "═══ Explosion Settings ═══"
pressureThreshold = input.int(80, "Pressure Threshold", minval=50, maxval=100, group=expGroup, tooltip="Minimum pressure for explosion signal")
tempThreshold = input.int(70, "Temperature Threshold", minval=50, maxval=100, group=expGroup, tooltip="Minimum temperature for explosion signal")
steamThresholdExp = input.int(80, "Steam Threshold", minval=50, maxval=100, group=expGroup, tooltip="Minimum steam for explosion signal")
minConfluence = input.int(3, "Minimum Confluence Score", minval=1, maxval=5, group=expGroup, tooltip="Minimum factors aligned for explosion (1-5)")
showWarnings = input.bool(true, "Show Explosion Warnings", group=expGroup, tooltip="Show warning markers when approaching explosion")

// Color Settings (Professional Gradient Scheme)
colorGroup = "═══ Color Settings ═══"
bullPressureColor = input.color(color.new(#00FFA3, 0), "Bullish Pressure Primary", inline="press", group=colorGroup)
bullPressureColor2 = input.color(color.new(#00E5FF, 0), "Bullish Pressure Secondary", inline="press", group=colorGroup)
bearPressureColor = input.color(color.new(#FF1744, 0), "Bearish Pressure Primary", inline="bear", group=colorGroup)
bearPressureColor2 = input.color(color.new(#FF6E40, 0), "Bearish Pressure Secondary", inline="bear", group=colorGroup)
tempColor = input.color(color.new(#FF6D00, 0), "Temperature", inline="temp", group=colorGroup)
tempColor2 = input.color(color.new(#FFAB00, 0), "Temperature Hot", inline="temp", group=colorGroup)
steamColor = input.color(color.new(#E0E0E0, 0), "Steam", inline="steam", group=colorGroup)
steamColor2 = input.color(color.new(#FFFFFF, 0), "Steam Intense", inline="steam", group=colorGroup)
explosionColor = input.color(color.new(#FFD600, 0), "Explosion", inline="exp", group=colorGroup)
warningColor = input.color(color.new(#FF9100, 0), "Warning", inline="warn", group=colorGroup)
neutralColor = input.color(color.new(#546E7A, 0), "Neutral Zone", inline="neutral", group=colorGroup)

// ═══════════════════════════════════════════
// PRESSURE CALCULATIONS (0-100 scale)
// ═══════════════════════════════════════════

// RSI Pressure
rsiVal = ta.rsi(close, rsiLen)
rsiPressure = rsiVal

// WaveTrend Pressure
ap = hlc3
esa = ta.ema(ap, wtLen1)
d = ta.ema(math.abs(ap - esa), wtLen1)
ci = (ap - esa) / (0.015 * d)
wt1 = ta.ema(ci, wtLen2)
wtPressure = (wt1 + 100) / 2  // Normalize -100 to 100 → 0 to 100

// MFI Pressure
mfiVal = ta.mfi(hlc3, mfiLen)
mfiPressure = mfiVal

// Stochastic RSI Pressure (Additional Component)
rsiForStoch = ta.rsi(close, rsiLen)
stochRSI = ta.stoch(rsiForStoch, rsiForStoch, rsiForStoch, stochLen)
stochK = ta.sma(stochRSI, 3)
stochPressure = useStochPressure ? stochK : 50

// Combined Pressure (0-100) - 4 Component System
totalPressure = useStochPressure ? (rsiPressure + wtPressure + mfiPressure + stochPressure) / 4 : (rsiPressure + wtPressure + mfiPressure) / 3

// ═══════════════════════════════════════════
// TEMPERATURE CALCULATIONS (0-100 scale)
// ═══════════════════════════════════════════

// ATR-based volatility
atrVal = ta.atr(atrLen)
atrPct = (atrVal / close) * 100
atrTemp = atrPct * atrMultiplier

// Bollinger Band Width Temperature (Additional Component)
bbBasis = ta.sma(close, bbLen)
bbDev = bbMult * ta.stdev(close, bbLen)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
bbWidth = ((bbUpper - bbLower) / bbBasis) * 100
bbTemp = useBollingerTemp ? bbWidth * 5 : 0  // Scale to 0-100

// Combined Temperature
temperature = useBollingerTemp ? math.min((atrTemp + bbTemp) / 2, 100) : math.min(atrTemp, 100)

// ═══════════════════════════════════════════
// STEAM CALCULATIONS (0-100 scale)
// ═══════════════════════════════════════════

// Volume ratio
volMA = ta.sma(volume, volLen)
volRatio = volume / volMA
steamBase = volRatio * 50

// Volume Delta (Buy vs Sell Pressure)
buyVol = close > open ? volume : 0
sellVol = close < open ? volume : 0
volDelta = useVolDelta ? (buyVol - sellVol) / volume * 50 : 0

// Combined Steam (0-100)
steam = math.min(steamBase + math.abs(volDelta), 100)

// Steam burst detection (Extreme Volume)
steamBurst = steam > steamThresholdExp
extremeSteam = steam > 90  // Very extreme volume

// Volume Spike Direction
volSpikeUp = steamBurst and close > open
volSpikeDown = steamBurst and close < open

// ═══════════════════════════════════════════
// EXPLOSION DETECTION
// ═══════════════════════════════════════════

// Momentum Confirmation (Ensure signals are at turning points)
pressureMomentum = ta.change(totalPressure)
pressureAcceleration = ta.change(pressureMomentum)
momentumShift = (pressureMomentum > 0 and pressureMomentum[1] <= 0) or (pressureMomentum < 0 and pressureMomentum[1] >= 0)

// Confluence Score (0-5) - How many factors are extreme
confluenceScore = (totalPressure > pressureThreshold ? 1 : 0) + (temperature > tempThreshold ? 1 : 0) + (steam > steamThresholdExp ? 1 : 0) + (wtPressure > 80 or wtPressure < 20 ? 1 : 0) + (extremeSteam ? 1 : 0)

// Explosion occurs when confluence threshold met WITH momentum confirmation
explosion = confluenceScore >= minConfluence and (momentumShift or math.abs(pressureAcceleration) > 2)

// Bullish or Bearish explosion (Direction + Strength + Momentum)
bullExplosion = explosion and totalPressure > 50 and pressureMomentum > 0 and (close > open or volSpikeUp)
bearExplosion = explosion and totalPressure < 50 and pressureMomentum < 0 and (close < open or volSpikeDown)

// Perfect Explosion (All 5 factors aligned + strong momentum)
perfectExplosion = confluenceScore == 5 and math.abs(pressureMomentum) > 3
perfectBull = perfectExplosion and totalPressure > 50 and pressureMomentum > 0
perfectBear = perfectExplosion and totalPressure < 50 and pressureMomentum < 0

// Signal Filtering - Prevent Overlapping (Only show new signals)
var int lastBullBar = -999
var int lastBearBar = -999
var int lastPerfectBullBar = -999
var int lastPerfectBearBar = -999
var int lastWarningBar = -999

int minBarsBetweenSignals = 8  // Increased from 5 to 8 for better spacing

// Check if enough bars have passed since last signal
bool canShowBullSignal = bar_index - lastBullBar >= minBarsBetweenSignals
bool canShowBearSignal = bar_index - lastBearBar >= minBarsBetweenSignals
bool canShowPerfectBullSignal = bar_index - lastPerfectBullBar >= minBarsBetweenSignals
bool canShowPerfectBearSignal = bar_index - lastPerfectBearBar >= minBarsBetweenSignals
bool canShowWarning = bar_index - lastWarningBar >= minBarsBetweenSignals

// Filtered signals
filteredPerfectBull = perfectBull and canShowPerfectBullSignal
filteredPerfectBear = perfectBear and canShowPerfectBearSignal
filteredBullExplosion = bullExplosion and not perfectBull and canShowBullSignal
filteredBearExplosion = bearExplosion and not perfectBear and canShowBearSignal

// Update last signal bars
if filteredPerfectBull
    lastPerfectBullBar := bar_index
    lastBullBar := bar_index
if filteredPerfectBear
    lastPerfectBearBar := bar_index
    lastBearBar := bar_index
if filteredBullExplosion
    lastBullBar := bar_index
if filteredBearExplosion
    lastBearBar := bar_index

// ═══════════════════════════════════════════
// PRESSURE ZONES
// ═══════════════════════════════════════════

// Extreme zones
extremeOverbought = totalPressure > 80
extremeOversold = totalPressure < 20
overbought = totalPressure > 70 and totalPressure <= 80
oversold = totalPressure < 30 and totalPressure >= 20

// ═══════════════════════════════════════════
// COLORS
// ═══════════════════════════════════════════

// Pressure Color Gradient (Smooth Thermal Transition)
pressureColor = totalPressure > 50 ? color.from_gradient(totalPressure, 50, 100, bullPressureColor2, bullPressureColor) : color.from_gradient(totalPressure, 0, 50, bearPressureColor, bearPressureColor2)

// Temperature Background Color (Heat Map Style)
tempIntensity = math.min(temperature / 100, 1.0)
tempBgColor = temperature > 70 ? color.from_gradient(temperature, 70, 100, tempColor, tempColor2) : color.new(tempColor, 100 - (temperature * 0.6))

// Steam Color (Intensity-based)
steamIntensity = math.min(steam / 100, 1.0)
steamPlotColor = steam > steamThresholdExp ? color.from_gradient(steam, steamThresholdExp, 100, steamColor, steamColor2) : color.new(steamColor, 70)

// Pressure Area Fill Color (Subtle Glow Effect)
pressureAreaColor = totalPressure > 50 ? color.new(pressureColor, 70) : color.new(pressureColor, 75)

// ═══════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════

// Pressure Gauge (Main Plot with Glow Effect - Thermal Style)
plot(totalPressure, "Total Pressure", color=pressureAreaColor, linewidth=6, style=plot.style_area)
plot(totalPressure, "Pressure Glow", color=color.new(pressureColor, 50), linewidth=3)
plot(totalPressure, "Pressure Core", color=pressureColor, linewidth=1)

// Component Pressures (Thin Lines for Analysis)
plot(rsiPressure, "RSI Pressure", color=color.new(bullPressureColor, 70), linewidth=1, display=display.none)
plot(wtPressure, "WT Pressure", color=color.new(#00E5FF, 70), linewidth=1, display=display.none)
plot(mfiPressure, "MFI Pressure", color=color.new(#E040FB, 70), linewidth=1, display=display.none)
plot(useStochPressure ? stochPressure : na, "Stoch Pressure", color=color.new(#FFD600, 70), linewidth=1, display=display.none)

// Temperature (Background Heat Map)
bgcolor(tempBgColor, title="Temperature Background")

// Steam Bursts (Histogram at top with Thermal Direction) - Filtered to reduce clutter
var int lastSteamBar = -999
bool canShowSteam = bar_index - lastSteamBar >= 3  // Minimum 3 bars between steam bursts

filteredSteamBurst = steamBurst and canShowSteam
filteredExtremeSteam = extremeSteam and canShowSteam

if filteredSteamBurst or filteredExtremeSteam
    lastSteamBar := bar_index

steamBurstColor = volSpikeUp ? color.new(bullPressureColor, 0) : volSpikeDown ? color.new(bearPressureColor, 0) : steamPlotColor
plot(filteredSteamBurst ? 100 : na, "Steam Burst", color=steamBurstColor, style=plot.style_histogram, linewidth=5, histbase=94)
plot(filteredExtremeSteam ? 100 : na, "Extreme Steam", color=color.new(explosionColor, 0), style=plot.style_histogram, linewidth=3, histbase=96)

// Neutral Zone Fill (45-55 range)
neutralTop = hline(55, "Neutral Top", color=color.new(neutralColor, 80), linestyle=hline.style_dotted)
neutralBot = hline(45, "Neutral Bottom", color=color.new(neutralColor, 80), linestyle=hline.style_dotted)
fill(neutralTop, neutralBot, color=color.new(neutralColor, 92), title="Neutral Zone")

// Reference Lines (Thermal Zones)
hline(80, "Extreme OB", color=color.new(bearPressureColor, 40), linestyle=hline.style_solid, linewidth=2)
hline(70, "Overbought", color=color.new(bearPressureColor, 70), linestyle=hline.style_dashed)
hline(50, "Equilibrium", color=color.new(neutralColor, 50), linestyle=hline.style_solid, linewidth=1)
hline(30, "Oversold", color=color.new(bullPressureColor, 70), linestyle=hline.style_dashed)
hline(20, "Extreme OS", color=color.new(bullPressureColor, 40), linestyle=hline.style_solid, linewidth=2)

// ═══════════════════════════════════════════
// EXPLOSION MARKERS
// ═══════════════════════════════════════════

// Explosion Markers (Size based on strength) - Filtered to prevent overlap
plotshape(filteredPerfectBull, "Perfect Bull Explosion", shape.diamond, location.top, color=explosionColor, size=size.huge, text="PERFECT")
plotshape(filteredPerfectBear, "Perfect Bear Explosion", shape.diamond, location.bottom, color=explosionColor, size=size.huge, text="PERFECT")
plotshape(filteredBullExplosion, "Bull Explosion", shape.triangleup, location.top, color=color.new(bullPressureColor, 0), size=size.large, text="BULL")
plotshape(filteredBearExplosion, "Bear Explosion", shape.triangledown, location.bottom, color=color.new(bearPressureColor, 0), size=size.large, text="BEAR")

// Warning markers for approaching explosion (filtered)
approachingExplosion = showWarnings and confluenceScore >= (minConfluence - 1) and not explosion
filteredWarningBull = approachingExplosion and totalPressure > 50 and canShowWarning and not filteredBullExplosion and not filteredPerfectBull
filteredWarningBear = approachingExplosion and totalPressure <= 50 and canShowWarning and not filteredBearExplosion and not filteredPerfectBear

if filteredWarningBull or filteredWarningBear
    lastWarningBar := bar_index

plotshape(filteredWarningBull, "Bull Warning", shape.circle, location.top, color=color.new(warningColor, 30), size=size.small, text="WARN")
plotshape(filteredWarningBear, "Bear Warning", shape.circle, location.bottom, color=color.new(warningColor, 30), size=size.small, text="WARN")

// ═══════════════════════════════════════════
// DASHBOARD
// ═══════════════════════════════════════════

var table dashboard = table.new(position.top_right, 2, 10, border_width=2, border_color=color.new(#37474F, 30), frame_width=2, frame_color=color.new(#37474F, 30))

if barstate.islast
    // Header (Thermal Theme)
    table.cell(dashboard, 0, 0, "THERMAL GAUGE", text_color=color.white, bgcolor=color.new(#263238, 0), text_size=size.normal)
    table.cell(dashboard, 1, 0, "READING", text_color=color.white, bgcolor=color.new(#263238, 0), text_size=size.normal)
    
    // Total Pressure
    pressureText = str.tostring(math.round(totalPressure, 1))
    pressureBg = totalPressure > 80 ? color.new(bearPressureColor, 50) : totalPressure < 20 ? color.new(bullPressureColor, 50) : color.new(#37474F, 60)
    table.cell(dashboard, 0, 1, "Pressure", text_color=color.white, bgcolor=color.new(#37474F, 70), text_size=size.small)
    table.cell(dashboard, 1, 1, pressureText, text_color=color.white, bgcolor=pressureBg, text_size=size.small)
    
    // Temperature
    tempText = str.tostring(math.round(temperature, 1))
    tempBg = temperature > 70 ? color.new(tempColor, 50) : color.new(#37474F, 60)
    table.cell(dashboard, 0, 2, "Temperature", text_color=color.white, bgcolor=color.new(#37474F, 70), text_size=size.small)
    table.cell(dashboard, 1, 2, tempText, text_color=color.white, bgcolor=tempBg, text_size=size.small)
    
    // Steam
    steamText = str.tostring(math.round(steam, 1))
    steamBg = steam > 80 ? color.new(steamColor, 50) : color.new(#37474F, 60)
    table.cell(dashboard, 0, 3, "Steam", text_color=color.white, bgcolor=color.new(#37474F, 70), text_size=size.small)
    table.cell(dashboard, 1, 3, steamText, text_color=color.white, bgcolor=steamBg, text_size=size.small)
    
    // RSI Component
    rsiText = str.tostring(math.round(rsiPressure, 1))
    table.cell(dashboard, 0, 4, "RSI", text_color=color.white, bgcolor=color.new(#37474F, 70), text_size=size.small)
    table.cell(dashboard, 1, 4, rsiText, text_color=color.white, bgcolor=color.new(#37474F, 60), text_size=size.small)
    
    // WT Component
    wtText = str.tostring(math.round(wtPressure, 1))
    table.cell(dashboard, 0, 5, "WaveTrend", text_color=color.white, bgcolor=color.new(#37474F, 70), text_size=size.small)
    table.cell(dashboard, 1, 5, wtText, text_color=color.white, bgcolor=color.new(#37474F, 60), text_size=size.small)
    
    // MFI Component
    mfiText = str.tostring(math.round(mfiPressure, 1))
    table.cell(dashboard, 0, 6, "Money Flow", text_color=color.white, bgcolor=color.new(#37474F, 70), text_size=size.small)
    table.cell(dashboard, 1, 6, mfiText, text_color=color.white, bgcolor=color.new(#37474F, 60), text_size=size.small)
    
    // Confluence Score
    confText = str.tostring(confluenceScore) + "/5"
    confBg = confluenceScore >= minConfluence ? color.new(explosionColor, 40) : color.new(#37474F, 60)
    table.cell(dashboard, 0, 7, "Confluence", text_color=color.white, bgcolor=color.new(#37474F, 70), text_size=size.small)
    table.cell(dashboard, 1, 7, confText, text_color=color.white, bgcolor=confBg, text_size=size.small)
    
    // Volume Direction
    volDirText = volSpikeUp ? "BUY SPIKE" : volSpikeDown ? "SELL SPIKE" : steamBurst ? "SPIKE" : "Normal"
    volDirBg = volSpikeUp ? color.new(bullPressureColor, 50) : volSpikeDown ? color.new(bearPressureColor, 50) : steamBurst ? color.new(steamColor, 50) : color.new(#37474F, 60)
    table.cell(dashboard, 0, 8, "Volume", text_color=color.white, bgcolor=color.new(#37474F, 70), text_size=size.small)
    table.cell(dashboard, 1, 8, volDirText, text_color=color.white, bgcolor=volDirBg, text_size=size.small)
    
    // Status
    statusText = perfectBull ? "PERFECT BULL" : perfectBear ? "PERFECT BEAR" : bullExplosion ? "BULL EXPLOSION" : bearExplosion ? "BEAR EXPLOSION" : approachingExplosion ? "WARNING" : extremeOverbought ? "Extreme OB" : extremeOversold ? "Extreme OS" : overbought ? "Overbought" : oversold ? "Oversold" : "Normal"
    statusBg = perfectBull or perfectBear ? color.new(explosionColor, 20) : bullExplosion ? color.new(bullPressureColor, 40) : bearExplosion ? color.new(bearPressureColor, 40) : approachingExplosion ? color.new(warningColor, 50) : extremeOverbought or overbought ? color.new(bearPressureColor, 60) : extremeOversold or oversold ? color.new(bullPressureColor, 60) : color.new(#37474F, 60)
    table.cell(dashboard, 0, 9, "Status", text_color=color.white, bgcolor=color.new(#37474F, 70), text_size=size.small)
    table.cell(dashboard, 1, 9, statusText, text_color=color.white, bgcolor=statusBg, text_size=size.small)

// ═══════════════════════════════════════════
// PRESSURE METER VISUALIZATION
// ═══════════════════════════════════════════

var table meter = table.new(position.bottom_right, 11, 3, border_width=2, border_color=color.new(#37474F, 30))

if barstate.islast
    // Title (Thermal Theme)
    table.cell(meter, 0, 0, "PRESSURE METER", text_color=color.white, bgcolor=color.new(#263238, 0), text_size=size.small)
    table.merge_cells(meter, 0, 0, 10, 0)
    
    // Meter bars (Enhanced Thermal Gradient)
    for i = 0 to 10
        barValue = i * 10
        barColor = barValue <= totalPressure ? color.from_gradient(barValue, 0, 100, bearPressureColor, bullPressureColor) : color.new(color.gray, 90)
        table.cell(meter, i, 1, "", bgcolor=barColor)
        table.cell(meter, i, 2, str.tostring(barValue), text_color=color.white, bgcolor=color.new(#37474F, 60), text_size=size.tiny)

// ═══════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════

alertcondition(filteredPerfectBull, "Perfect Bullish Explosion", 
               "Thermal Gauge: PERFECT BULLISH EXPLOSION - All 5 Factors Aligned!")
alertcondition(filteredPerfectBear, "Perfect Bearish Explosion", 
               "Thermal Gauge: PERFECT BEARISH EXPLOSION - All 5 Factors Aligned!")
alertcondition(filteredBullExplosion, "Bullish Explosion", 
               "Thermal Gauge: BULLISH EXPLOSION - High Confluence Detected")
alertcondition(filteredBearExplosion, "Bearish Explosion", 
               "Thermal Gauge: BEARISH EXPLOSION - High Confluence Detected")
alertcondition(filteredWarningBull or filteredWarningBear, "Explosion Warning", 
               "Thermal Gauge: WARNING - Approaching Explosion Threshold")
alertcondition(extremeOverbought, "Extreme Overbought", 
               "Thermal Gauge: Extreme Overbought Condition - Pressure Above 80")
alertcondition(extremeOversold, "Extreme Oversold", 
               "Thermal Gauge: Extreme Oversold Condition - Pressure Below 20")
alertcondition(volSpikeUp and filteredSteamBurst, "Bullish Volume Spike", 
               "Thermal Gauge: Bullish Volume Spike Detected")
alertcondition(volSpikeDown and filteredSteamBurst, "Bearish Volume Spike", 
               "Thermal Gauge: Bearish Volume Spike Detected")
alertcondition(filteredExtremeSteam, "Extreme Volume", 
               "Thermal Gauge: Extreme Volume Event - Steam Above 90")
