//@version=5
indicator("Manual 3-Sigma Volatility Trailing Stop (With Start Date)", overlay=true)

// === USER INPUTS ===
entryPrice  = input.float(0.0, "Average Entry Price")
isLong      = input.bool(true, "Position Type (Long = true, Short = false)")
startTime   = input.time(timestamp("2024-01-01 00:00"), "Entry Start Date")
lookback    = input.int(20, "Volatility Lookback")
mult        = input.float(3.0, "Sigma Multiplier")

// === VOLATILITY (Log Returns) ===
returns = math.log(close / close[1])
sigma   = ta.stdev(returns, lookback)
volDistance = mult * sigma * close

// === STATE VARIABLES ===
var float highestSinceEntry = na
var float lowestSinceEntry  = na
var float trailingStop      = na
var bool  tracking          = false

// === START TRACKING AFTER CHOSEN DATE ===
if time >= startTime
    tracking := true

// Reset if start time changes
if startTime != startTime[1]
    highestSinceEntry := na
    lowestSinceEntry  := na
    trailingStop      := na
    tracking          := false

// === TRAILING LOGIC ===
if tracking
    if isLong
        highestSinceEntry := na(highestSinceEntry) ? high : math.max(highestSinceEntry, high)
        newStop = highestSinceEntry - volDistance
        trailingStop := na(trailingStop) ? newStop : math.max(trailingStop, newStop)

    else
        lowestSinceEntry := na(lowestSinceEntry) ? low : math.min(lowestSinceEntry, low)
        newStop = lowestSinceEntry + volDistance
        trailingStop := na(trailingStop) ? newStop : math.min(trailingStop, newStop)

// === PLOTS ===
plot(trailingStop, "3-Sigma Trailing Stop", color=color.red, linewidth=2)
plot(entryPrice, "Entry Price", color=color.blue)
