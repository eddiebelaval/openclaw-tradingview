//@version=6
indicator("Liquidation Reversal Hunter V3 - Horizontal", shorttitle="LiqRevV3-H", overlay=true, max_lines_count=500, max_labels_count=100)

// ══════════════════════════════════════════════════════════════════════════════
// LIQUIDATION REVERSAL HUNTER V3 - HORIZONTAL LINES VERSION
// ══════════════════════════════════════════════════════════════════════════════
// Professional-grade liquidation detection with horizontal line visualization
// 
// KEY FEATURES:
// • Horizontal lines showing exact liquidation levels
// • Perfect for lower timeframes and precise entries
// • Line width based on importance (thicker = more important)
// • Color gradient showing importance intensity
// • Smart line management - removes swept/tagged levels
// • Multi-timeframe confluence detection
// • Advanced stop hunt pattern recognition
// ══════════════════════════════════════════════════════════════════════════════

// ── INPUTS ──
g1 = "Liquidation Detection"
volumeMultiplier = input.float(2.0, "Volume Multiplier Threshold", minval=1.0, maxval=5.0, step=0.1, group=g1, tooltip="Volume must be this many times average to trigger")
volumeLookback = input.int(20, "Volume Lookback", minval=10, maxval=100, group=g1)
minLiquidationSize = input.float(3.0, "Min Liquidation Size (M)", minval=0.5, maxval=50.0, step=0.5, group=g1, tooltip="Minimum liquidity cleared in millions")
zScoreThreshold = input.float(1.8, "Z-Score Threshold", minval=1.0, maxval=4.0, step=0.1, group=g1, tooltip="Statistical threshold for abnormal events")
wickThreshold = input.float(0.4, "Wick Threshold (% of range)", minval=0.1, maxval=0.9, step=0.05, group=g1, tooltip="Minimum wick size as percentage of total range")

// Multi-timeframe settings
gMTF = "Multi-Timeframe"
useMTF = input.bool(true, "Enable MTF Confluence", group=gMTF)
mtfTimeframe = input.timeframe("60", "Higher TF", group=gMTF)
mtfWeight = input.float(0.3, "MTF Weight", minval=0.0, maxval=1.0, step=0.1, group=gMTF)

// Signal quality settings
g2 = "Signal Quality"
useStopHuntFilter = input.bool(true, "Use Stop Hunt Detection", group=g2, tooltip="Look for sweep & reversal patterns - most accurate signals")
useDivergence = input.bool(true, "Use Divergence Filter", group=g2, tooltip="Confirm with RSI/MACD divergence")
useMomentumFilter = input.bool(true, "Use Momentum Filter", group=g2, tooltip="Confirm with RSI oversold/overbought")
requireReversal = input.bool(false, "Require Price Reversal", group=g2, tooltip="Price must reverse after liquidation")
reversalBars = input.int(2, "Reversal Confirmation Bars", minval=1, maxval=5, group=g2)
signalCooldown = input.int(3, "Signal Cooldown (bars)", minval=1, maxval=10, group=g2)
minSignalStrength = input.int(3, "Min Signal Strength (1-10)", minval=1, maxval=10, group=g2)

// Visual settings
g3 = "Visual Settings"
showLines = input.bool(true, "Show Liquidation Lines", group=g3)
showHeatmap = input.bool(true, "Show Volume Heatmap", group=g3)
showSignals = input.bool(true, "Show Signal Arrows", group=g3)
showInfoPanel = input.bool(false, "Show Info Panel", group=g3)
showStatistics = input.bool(false, "Show Statistics Table", group=g3)
showLabels = input.bool(true, "Show Line Labels", group=g3, tooltip="Show liquidity amount on lines")
labelType = input.string("Liquidity", "Label Type", options=["Liquidity", "Importance", "Both"], group=g3)

// Line settings
g4 = "Line Settings"
lineLength = input.int(100, "Line Length (bars)", minval=20, maxval=500, group=g4)
lineWidthBase = input.int(2, "Base Line Width", minval=1, maxval=5, group=g4)
maxLineAge = input.int(100, "Max Line Age (bars)", minval=20, maxval=500, group=g4)
taggedLineDecay = input.int(5, "Tagged Line Decay (bars)", minval=1, maxval=20, group=g4)
minImportanceToShow = input.float(25.0, "Min Importance to Show (%)", minval=0.0, maxval=100.0, step=5.0, group=g4)
maxLines = input.int(15, "Max Active Lines", minval=5, maxval=50, group=g4)
mergeThreshold = input.float(0.3, "Merge Threshold (%)", minval=0.1, maxval=1.0, step=0.1, group=g4, tooltip="Merge lines within this % of price")

// Color settings
g5 = "Colors"
bullishColor = input.color(#00D084, "Bullish Color", group=g5)
bearishColor = input.color(#FF4757, "Bearish Color", group=g5)
neutralColor = input.color(#FFA502, "Neutral Color", group=g5)
lineOpacity = input.int(75, "Line Opacity", minval=0, maxval=100, group=g5)
taggedOpacity = input.int(50, "Tagged Line Opacity", minval=0, maxval=100, group=g5)

// ── CORE CALCULATIONS ──

// Volume Analysis
avgVolume = ta.sma(volume, volumeLookback)
volumeStd = ta.stdev(volume, volumeLookback)
volumeZ = volumeStd > 0 ? (volume - avgVolume) / volumeStd : 0.0
abnormalVolume = volumeZ >= zScoreThreshold
veryAbnormalVolume = volumeZ >= (zScoreThreshold * 1.3)
extremeVolume = volumeZ >= (zScoreThreshold * 1.8)

// Liquidation Size Calculation
rangePU = high - low
volumeM = volume / 1e6
liquidationSize = volumeM * rangePU

// Average liquidation size for comparison
avgLiquidationSize = ta.sma(liquidationSize, volumeLookback)
liquidationStd = ta.stdev(liquidationSize, volumeLookback)
liquidationZ = liquidationStd > 0 ? (liquidationSize - avgLiquidationSize) / liquidationStd : 0.0

// Major liquidation detection
isMajorLiquidation = (veryAbnormalVolume and liquidationSize >= minLiquidationSize * 0.5) or 
                     (extremeVolume) or 
                     (abnormalVolume and liquidationZ >= zScoreThreshold)

// Price action analysis
isBearishCandle = close < open
isBullishCandle = close > open
bodySize = math.abs(close - open)
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low
wickSize = upperWick + lowerWick
totalRange = high - low
upperWickRatio = totalRange > 0 ? upperWick / totalRange : 0
lowerWickRatio = totalRange > 0 ? lowerWick / totalRange : 0

// ATR for volatility
atr14 = ta.atr(14)
atr20 = ta.atr(20)

// Multi-timeframe data
[mtfHigh, mtfLow, mtfClose] = request.security(syminfo.tickerid, mtfTimeframe, [high, low, close], lookahead=barmerge.lookahead_off)
mtfRange = mtfHigh - mtfLow
mtfVolume = request.security(syminfo.tickerid, mtfTimeframe, volume, lookahead=barmerge.lookahead_off)
mtfAvgVolume = request.security(syminfo.tickerid, mtfTimeframe, ta.sma(volume, volumeLookback), lookahead=barmerge.lookahead_off)
mtfAbnormal = useMTF and mtfVolume > mtfAvgVolume * volumeMultiplier

// ── MOMENTUM & DIVERGENCE ──

// RSI for momentum
rsi = ta.rsi(close, 14)
rsiOversold = rsi < 30
rsiOverbought = rsi > 70
rsiExtremeOS = rsi < 20
rsiExtremeOB = rsi > 80

// MACD for trend
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)

// Pivot detection for divergence
var float[] priceHighs = array.new<float>()
var float[] priceLows = array.new<float>()
var float[] rsiHighs = array.new<float>()
var float[] rsiLows = array.new<float>()
var int[] highBars = array.new<int>()
var int[] lowBars = array.new<int>()

pivotHigh = ta.pivothigh(high, 3, 3)
pivotLow = ta.pivotlow(low, 3, 3)

if not na(pivotHigh)
    array.push(priceHighs, pivotHigh)
    array.push(rsiHighs, rsi[3])
    array.push(highBars, bar_index - 3)
    if array.size(priceHighs) > 5
        array.shift(priceHighs)
        array.shift(rsiHighs)
        array.shift(highBars)

if not na(pivotLow)
    array.push(priceLows, pivotLow)
    array.push(rsiLows, rsi[3])
    array.push(lowBars, bar_index - 3)
    if array.size(priceLows) > 5
        array.shift(priceLows)
        array.shift(rsiLows)
        array.shift(lowBars)

// Detect bullish divergence
detectBullishDivergence() =>
    hasDivergence = false
    if array.size(priceLows) >= 2 and array.size(rsiLows) >= 2
        priceLow1 = array.get(priceLows, array.size(priceLows) - 1)
        priceLow2 = array.get(priceLows, array.size(priceLows) - 2)
        rsiLow1 = array.get(rsiLows, array.size(rsiLows) - 1)
        rsiLow2 = array.get(rsiLows, array.size(rsiLows) - 2)
        priceLower = priceLow1 < priceLow2
        rsiHigher = rsiLow1 > rsiLow2
        if priceLower and rsiHigher
            hasDivergence := true
    hasDivergence

// Detect bearish divergence
detectBearishDivergence() =>
    hasDivergence = false
    if array.size(priceHighs) >= 2 and array.size(rsiHighs) >= 2
        priceHigh1 = array.get(priceHighs, array.size(priceHighs) - 1)
        priceHigh2 = array.get(priceHighs, array.size(priceHighs) - 2)
        rsiHigh1 = array.get(rsiHighs, array.size(rsiHighs) - 1)
        rsiHigh2 = array.get(rsiHighs, array.size(rsiHighs) - 2)
        priceHigher = priceHigh1 > priceHigh2
        rsiLower = rsiHigh1 < rsiHigh2
        if priceHigher and rsiLower
            hasDivergence := true
    hasDivergence

bullishDivergence = useDivergence ? detectBullishDivergence() : true
bearishDivergence = useDivergence ? detectBearishDivergence() : true

// ── STOP HUNT DETECTION ──

// Swing high/low tracking
swingHigh5 = ta.highest(high, 5)[1]
swingLow5 = ta.lowest(low, 5)[1]
swingHigh10 = ta.highest(high, 10)[1]
swingLow10 = ta.lowest(low, 10)[1]

// Bullish stop hunt: price sweeps below recent low then reverses up
bullishStopHunt = (low < swingLow5) and (close > open) and (close > (low + totalRange * 0.5))
strongBullishStopHunt = (low < swingLow10) and (close > open) and (close > (low + totalRange * 0.6)) and (lowerWick > bodySize * 1.5)

// Bearish stop hunt: price sweeps above recent high then reverses down  
bearishStopHunt = (high > swingHigh5) and (close < open) and (close < (high - totalRange * 0.5))
strongBearishStopHunt = (high > swingHigh10) and (close < open) and (close < (high - totalRange * 0.6)) and (upperWick > bodySize * 1.5)

// ── REVERSAL DETECTION ──

recentLow = ta.lowest(low, reversalBars + 1)
recentHigh = ta.highest(high, reversalBars + 1)

checkBullishReversal() =>
    reversed = false
    if requireReversal and bar_index >= reversalBars
        wasBearish = true
        for i = 1 to reversalBars
            if close[i] >= open[i]
                wasBearish := false
                break
        isReversing = isBullishCandle and close > recentLow
        reversed := wasBearish and isReversing
    else
        reversed := true
    reversed

checkBearishReversal() =>
    reversed = false
    if requireReversal and bar_index >= reversalBars
        wasBullish = true
        for i = 1 to reversalBars
            if close[i] <= open[i]
                wasBullish := false
                break
        isReversing = isBearishCandle and close < recentHigh
        reversed := wasBullish and isReversing
    else
        reversed := true
    reversed

bullishReversalResult = checkBullishReversal()
bearishReversalResult = checkBearishReversal()

// ── LIQUIDATION LEVEL TRACKING ──

// Line data structure
var float[] liqLevels = array.new<float>()
var int[] liqBars = array.new<int>()
var bool[] liqWasBearish = array.new<bool>()
var float[] liqImportance = array.new<float>()
var float[] liqSizes = array.new<float>()
var bool[] liqTagged = array.new<bool>()
var int[] liqTagBar = array.new<int>()
var line[] liqLines = array.new<line>()
var label[] liqLabels = array.new<label>()

var int lastBullishSignalBar = 0
var int lastBearishSignalBar = 0

// Calculate liquidation importance score (0-100)
calculateLiquidationImportance() =>
    importance = 0.0
    
    // Volume component (0-35 points)
    if extremeVolume
        importance += 35.0
    else if veryAbnormalVolume
        importance += 28.0
    else if abnormalVolume
        importance += 20.0
    else if volume > avgVolume * volumeMultiplier
        importance += 12.0
    
    // Liquidation size component (0-25 points)
    if liquidationZ >= zScoreThreshold * 1.5
        importance += 25.0
    else if liquidationZ >= zScoreThreshold
        importance += 20.0
    else if liquidationZ >= zScoreThreshold * 0.7
        importance += 14.0
    else if liquidationSize >= minLiquidationSize * 0.5
        importance += 8.0
    
    // MTF confluence (0-15 points)
    if useMTF and mtfAbnormal
        importance += 15.0
    
    // Price range component (0-15 points)
    if totalRange > 0
        rangeRatio = totalRange / atr14
        if rangeRatio > 3.0
            importance += 15.0
        else if rangeRatio > 2.0
            importance += 11.0
        else if rangeRatio > 1.5
            importance += 7.0
        else if rangeRatio > 1.0
            importance += 3.0
    
    // Wick rejection component (0-10 points)
    if totalRange > 0
        if isBearishCandle and upperWickRatio > wickThreshold
            importance += 10.0
        else if isBullishCandle and lowerWickRatio > wickThreshold
            importance += 10.0
        else if upperWickRatio > wickThreshold * 0.7 or lowerWickRatio > wickThreshold * 0.7
            importance += 6.0
    
    math.min(100.0, importance)

// Calculate age-adjusted importance
getAgeAdjustedImportance(baseImportance, barsOld) =>
    decayRate = 0.3
    decay = barsOld * decayRate
    adjustedImportance = baseImportance - decay
    math.max(0.0, adjustedImportance)

// ── SMART LINE CLEANUP ──

// Process line tagging and cleanup on every bar
if array.size(liqLevels) > 0
    i = array.size(liqLevels) - 1
    while i >= 0
        liqLevel = array.get(liqLevels, i)
        liqBar = array.get(liqBars, i)
        wasBearish = array.get(liqWasBearish, i)
        importance = array.get(liqImportance, i)
        isTagged = array.get(liqTagged, i)
        tagBar = array.get(liqTagBar, i)
        liqLine = array.get(liqLines, i)
        liqLabel = array.get(liqLabels, i)
        
        liqAge = bar_index - liqBar
        tagAge = isTagged ? bar_index - tagBar : 0
        
        shouldRemove = false
        touchThreshold = atr14 * 0.15
        sweepThreshold = atr14 * 0.4
        
        // Check if level is tagged (touched but not swept)
        if not isTagged
            if wasBearish
                // Bearish level at high - check if price came close
                if high >= liqLevel - touchThreshold
                    array.set(liqTagged, i, true)
                    array.set(liqTagBar, i, bar_index)
                    isTagged := true
            else
                // Bullish level at low - check if price came close
                if low <= liqLevel + touchThreshold
                    array.set(liqTagged, i, true)
                    array.set(liqTagBar, i, bar_index)
                    isTagged := true
        
        // Check for clean sweep (remove immediately)
        if wasBearish
            // Bearish level - swept when price closes above it
            if close > liqLevel + sweepThreshold
                shouldRemove := true
        else
            // Bullish level - swept when price closes below it
            if close < liqLevel - sweepThreshold
                shouldRemove := true
        
        // Calculate age-adjusted importance
        adjustedImportance = getAgeAdjustedImportance(importance, liqAge)
        
        // Remove old levels based on importance
        if not shouldRemove and liqAge > maxLineAge
            shouldRemove := true
        
        // Remove tagged levels after decay period (unless very important)
        if not shouldRemove and isTagged
            if tagAge > taggedLineDecay and adjustedImportance < 60.0
                shouldRemove := true
        
        // Remove if importance has decayed too much
        if not shouldRemove and adjustedImportance < 15.0
            shouldRemove := true
        
        // Execute removal
        if shouldRemove
            if not na(liqLine)
                line.delete(liqLine)
            if not na(liqLabel)
                label.delete(liqLabel)
            array.remove(liqLevels, i)
            array.remove(liqBars, i)
            array.remove(liqWasBearish, i)
            array.remove(liqImportance, i)
            array.remove(liqSizes, i)
            array.remove(liqTagged, i)
            array.remove(liqTagBar, i)
            array.remove(liqLines, i)
            array.remove(liqLabels, i)
        
        i -= 1

// Detect new liquidation events
if isMajorLiquidation
    newImportance = calculateLiquidationImportance()
    currentLiqSize = liquidationSize
    
    if newImportance >= minImportanceToShow
        if isBearishCandle
            liqLevel = high
            array.push(liqLevels, liqLevel)
            array.push(liqBars, bar_index)
            array.push(liqWasBearish, true)
            array.push(liqImportance, newImportance)
            array.push(liqSizes, currentLiqSize)
            array.push(liqTagged, false)
            array.push(liqTagBar, 0)
            array.push(liqLines, na)
            array.push(liqLabels, na)
        else
            liqLevel = low
            array.push(liqLevels, liqLevel)
            array.push(liqBars, bar_index)
            array.push(liqWasBearish, false)
            array.push(liqImportance, newImportance)
            array.push(liqSizes, currentLiqSize)
            array.push(liqTagged, false)
            array.push(liqTagBar, 0)
            array.push(liqLines, na)
            array.push(liqLabels, na)
        
        // Keep only recent liquidations
        if array.size(liqLevels) > 30
            oldLine = array.get(liqLines, 0)
            oldLabel = array.get(liqLabels, 0)
            if not na(oldLine)
                line.delete(oldLine)
            if not na(oldLabel)
                label.delete(oldLabel)
            array.shift(liqLevels)
            array.shift(liqBars)
            array.shift(liqWasBearish)
            array.shift(liqImportance)
            array.shift(liqSizes)
            array.shift(liqTagged)
            array.shift(liqTagBar)
            array.shift(liqLines)
            array.shift(liqLabels)

// ── SIGNAL STRENGTH CALCULATION ──

calculateSignalStrength(isBearish) =>
    strength = 0.0
    
    // Base strength
    if isMajorLiquidation
        strength += 1.0
    
    // Volume confirmation (0-2 pts)
    if extremeVolume
        strength += 2.0
    else if veryAbnormalVolume
        strength += 1.5
    else if abnormalVolume
        strength += 1.0
    
    // Liquidation magnitude (0-2 pts)
    if liquidationZ >= zScoreThreshold * 1.5
        strength += 2.0
    else if liquidationZ >= zScoreThreshold
        strength += 1.5
    else if liquidationZ >= zScoreThreshold * 0.7
        strength += 1.0
    
    // MTF confluence (0-1 pt)
    if useMTF and mtfAbnormal
        strength += 1.0
    
    // Stop hunt pattern (0-2.5 pts)
    if useStopHuntFilter
        if isBearish
            if strongBearishStopHunt
                strength += 2.5
            else if bearishStopHunt
                strength += 1.5
        else
            if strongBullishStopHunt
                strength += 2.5
            else if bullishStopHunt
                strength += 1.5
    
    // Divergence (0-1 pt)
    if useDivergence
        if isBearish and bearishDivergence
            strength += 1.0
        else if not isBearish and bullishDivergence
            strength += 1.0
    
    // Momentum confirmation (0-1 pt)
    if useMomentumFilter
        if isBearish
            if rsiExtremeOB
                strength += 1.0
            else if rsiOverbought
                strength += 0.5
        else
            if rsiExtremeOS
                strength += 1.0
            else if rsiOversold
                strength += 0.5
    
    // Wick rejection (0-1.5 pts)
    if totalRange > 0
        if isBearish and upperWickRatio > wickThreshold
            strength += 1.5
        else if not isBearish and lowerWickRatio > wickThreshold
            strength += 1.5
        else if isBearish and upperWickRatio > wickThreshold * 0.7
            strength += 1.0
        else if not isBearish and lowerWickRatio > wickThreshold * 0.7
            strength += 1.0
    
    math.min(10.0, strength)

bullishSignalStrength = calculateSignalStrength(false)
bearishSignalStrength = calculateSignalStrength(true)

// ── SIGNAL GENERATION ──

bullishSignal = false
bearishSignal = false

// Generate bullish signals
if isMajorLiquidation and isBullishCandle
    inCooldown = bar_index - lastBullishSignalBar < signalCooldown
    if not inCooldown
        currentImportance = calculateLiquidationImportance()
        signalStrength = bullishSignalStrength
        hasReversal = bullishReversalResult
        
        strengthMet = signalStrength >= minSignalStrength
        reversalMet = not requireReversal or hasReversal
        hasStopHunt = useStopHuntFilter and (bullishStopHunt or strongBullishStopHunt)
        
        standardConditions = strengthMet and reversalMet
        stopHuntConditions = hasStopHunt and signalStrength >= 2.0
        volumeSpikeConditions = veryAbnormalVolume and signalStrength >= 2.0
        strongWickConditions = lowerWickRatio > wickThreshold and abnormalVolume
        
        if standardConditions or stopHuntConditions or volumeSpikeConditions or strongWickConditions
            bullishSignal := true
            lastBullishSignalBar := bar_index

// Generate bearish signals
if isMajorLiquidation and isBearishCandle
    inCooldown = bar_index - lastBearishSignalBar < signalCooldown
    if not inCooldown
        currentImportance = calculateLiquidationImportance()
        signalStrength = bearishSignalStrength
        hasReversal = bearishReversalResult
        
        strengthMet = signalStrength >= minSignalStrength
        reversalMet = not requireReversal or hasReversal
        hasStopHunt = useStopHuntFilter and (bearishStopHunt or strongBearishStopHunt)
        
        standardConditions = strengthMet and reversalMet
        stopHuntConditions = hasStopHunt and signalStrength >= 2.0
        volumeSpikeConditions = veryAbnormalVolume and signalStrength >= 2.0
        strongWickConditions = upperWickRatio > wickThreshold and abnormalVolume
        
        if standardConditions or stopHuntConditions or volumeSpikeConditions or strongWickConditions
            bearishSignal := true
            lastBearishSignalBar := bar_index

// ── VISUALIZATION ──

// Get line color based on importance and direction
getLineColor(importance, wasBearish, isTagged) =>
    normalized = math.min(100.0, math.max(0.0, importance)) / 100.0
    
    if wasBearish
        // Bearish = red gradient
        r = 255
        g = math.round(100 - (100 * normalized))
        b = math.round(100 - (100 * normalized))
        color.rgb(r, g, b)
    else
        // Bullish = green gradient
        r = math.round(100 - (100 * normalized))
        g = 255
        b = math.round(100 - (100 * normalized))
        color.rgb(r, g, b)

// Draw liquidation lines
if showLines and array.size(liqLevels) > 0
    // Sort levels by importance
    sortedIndices = array.new<int>()
    for i = 0 to array.size(liqLevels) - 1
        array.push(sortedIndices, i)
    
    // Bubble sort by importance
    if array.size(sortedIndices) > 1
        for i = 0 to array.size(sortedIndices) - 2
            for j = i + 1 to array.size(sortedIndices) - 1
                idx1 = array.get(sortedIndices, i)
                idx2 = array.get(sortedIndices, j)
                imp1 = array.get(liqImportance, idx1)
                imp2 = array.get(liqImportance, idx2)
                if imp2 > imp1
                    array.set(sortedIndices, i, idx2)
                    array.set(sortedIndices, j, idx1)
    
    // Build filtered list with merging
    filteredLevels = array.new<float>()
    filteredIndices = array.new<int>()
    
    for i = 0 to array.size(sortedIndices) - 1
        if array.size(filteredLevels) >= maxLines
            break
        
        idx = array.get(sortedIndices, i)
        liqLevel = array.get(liqLevels, idx)
        liqBar = array.get(liqBars, idx)
        liqAge = bar_index - liqBar
        importance = array.get(liqImportance, idx)
        adjustedImportance = getAgeAdjustedImportance(importance, liqAge)
        
        // Filter by importance
        if adjustedImportance >= minImportanceToShow and liqAge <= lineLength
            // Check for merge
            shouldAdd = true
            mergeDist = close * (mergeThreshold / 100.0)
            
            if array.size(filteredLevels) > 0
                for j = 0 to array.size(filteredLevels) - 1
                    existingLevel = array.get(filteredLevels, j)
                    if math.abs(liqLevel - existingLevel) < mergeDist
                        shouldAdd := false
                        break
            
            if shouldAdd
                array.push(filteredLevels, liqLevel)
                array.push(filteredIndices, idx)
    
    // Draw lines
    if array.size(filteredIndices) > 0
        for i = 0 to array.size(filteredIndices) - 1
            idx = array.get(filteredIndices, i)
        
            liqLevel = array.get(liqLevels, idx)
            liqBar = array.get(liqBars, idx)
            wasBearish = array.get(liqWasBearish, idx)
            importance = array.get(liqImportance, idx)
            isTagged = array.get(liqTagged, idx)
            oldLine = array.get(liqLines, idx)
            oldLabel = array.get(liqLabels, idx)
            
            liqAge = bar_index - liqBar
            adjustedImportance = getAgeAdjustedImportance(importance, liqAge)
            
            // Calculate line properties
            lineColor = getLineColor(adjustedImportance, wasBearish, isTagged)
            lineWidth = math.max(1, math.round(lineWidthBase * (0.5 + (adjustedImportance / 100.0) * 0.5)))
            lineStyle = isTagged ? line.style_dashed : line.style_solid
            lineOpacityValue = isTagged ? taggedOpacity : lineOpacity
            
            // Line coordinates
            startBar = liqBar
            endBar = liqBar + lineLength
            
            // Delete old line if exists
            if not na(oldLine)
                line.delete(oldLine)
            
            // Create new line
            newLine = line.new(
                x1=startBar,
                y1=liqLevel,
                x2=endBar,
                y2=liqLevel,
                color=color.new(lineColor, 100 - lineOpacityValue),
                width=lineWidth,
                style=lineStyle,
                extend=extend.right
            )
            
            // Update line reference
            array.set(liqLines, idx, newLine)
            
            // Handle labels
            if showLabels
                // Delete old label
                if not na(oldLabel)
                    label.delete(oldLabel)
                
                // Get liquidation size for this level
                liqSize = array.get(liqSizes, idx)
                
                // Create label text based on user preference
                labelText = ""
                if labelType == "Liquidity"
                    labelText := str.tostring(liqSize, "#.##") + "M"
                else if labelType == "Importance"
                    labelText := str.tostring(math.round(adjustedImportance)) + "%"
                else if labelType == "Both"
                    labelText := str.tostring(liqSize, "#.##") + "M | " + str.tostring(math.round(adjustedImportance)) + "%"
                
                labelColor = wasBearish ? bearishColor : bullishColor
                labelStyle = wasBearish ? label.style_label_down : label.style_label_up
                
                newLabel = label.new(
                    x=endBar,
                    y=liqLevel,
                    text=labelText,
                    color=color.new(labelColor, 80),
                    textcolor=color.white,
                    size=size.tiny,
                    style=labelStyle
                )
                
                array.set(liqLabels, idx, newLabel)
            else
                // Delete label if showing is disabled
                if not na(oldLabel)
                    label.delete(oldLabel)
                    array.set(liqLabels, idx, na)

// Plot signals as flags (no text) - smallest size
plotshape(
    series=showSignals and bullishSignal,
    title="Bullish Reversal",
    location=location.belowbar,
    color=bullishColor,
    style=shape.flag,
    size=size.tiny)

plotshape(
    series=showSignals and bearishSignal,
    title="Bearish Reversal",
    location=location.abovebar,
    color=bearishColor,
    style=shape.flag,
    size=size.tiny)

// Volume heatmap background
heatmapColor = not showHeatmap or not abnormalVolume ? na : 
               extremeVolume ? color.new(bearishColor, 90) : 
               veryAbnormalVolume ? color.new(neutralColor, 90) : 
               color.new(bullishColor, 92)
bgcolor(heatmapColor, title="Volume Heatmap")

// ── COMMON STATS ──
var taggedCount = 0
var activeCount = 0
if barstate.islast
    taggedCount := 0
    totalLevels = array.size(liqTagged)
    if totalLevels > 0
        for idx = 0 to totalLevels - 1
            if array.get(liqTagged, idx)
                taggedCount += 1
    activeCount := totalLevels - taggedCount

// ── INFO PANEL ──
if barstate.islast and showInfoPanel
    var table infoPanel = table.new(position.top_right, 2, 8, 
        bgcolor=color.new(#1a1a2e, 10), 
        border_width=2, 
        border_color=color.new(#16213e, 0),
        frame_width=2,
        frame_color=color.new(#0f3460, 0))
    
    // Header
    table.cell(infoPanel, 0, 0, "LiqRev Hunter V3-H", 
        bgcolor=color.new(#e94560, 20), 
        text_color=color.white, 
        text_size=size.small, 
        text_halign=text.align_center)
    table.merge_cells(infoPanel, 0, 0, 1, 0)
    
    // Volume Z-Score
    table.cell(infoPanel, 0, 1, "Volume Z", text_color=color.gray, text_size=size.tiny)
    volZColor = extremeVolume ? color.new(bearishColor, 0) : veryAbnormalVolume ? color.new(neutralColor, 0) : abnormalVolume ? color.new(bullishColor, 0) : color.white
    table.cell(infoPanel, 1, 1, str.tostring(volumeZ, "#.##"), text_color=volZColor, text_size=size.tiny)
    
    // Liquidation Size
    table.cell(infoPanel, 0, 2, "Liq Size", text_color=color.gray, text_size=size.tiny)
    table.cell(infoPanel, 1, 2, str.tostring(liquidationSize, "#.##") + "M", text_color=color.white, text_size=size.tiny)
    
    // Signal Strength
    currentStrength = isBullishCandle ? bullishSignalStrength : bearishSignalStrength
    table.cell(infoPanel, 0, 3, "Strength", text_color=color.gray, text_size=size.tiny)
    strengthColor = currentStrength >= minSignalStrength ? color.new(bullishColor, 0) : currentStrength >= minSignalStrength * 0.7 ? color.new(neutralColor, 0) : color.gray
    table.cell(infoPanel, 1, 3, str.tostring(currentStrength, "#.#") + "/10", text_color=strengthColor, text_size=size.tiny)
    
    // Stop Hunt
    table.cell(infoPanel, 0, 4, "Stop Hunt", text_color=color.gray, text_size=size.tiny)
    hasStrongStopHunt = strongBullishStopHunt or strongBearishStopHunt
    hasStopHunt = bullishStopHunt or bearishStopHunt or hasStrongStopHunt
    stopHuntColor = hasStrongStopHunt ? color.new(bullishColor, 0) : hasStopHunt ? color.new(neutralColor, 0) : color.gray
    stopHuntText = strongBullishStopHunt ? "↑ Strong" : strongBearishStopHunt ? "↓ Strong" : bullishStopHunt ? "↑ Bull" : bearishStopHunt ? "↓ Bear" : "None"
    table.cell(infoPanel, 1, 4, stopHuntText, text_color=stopHuntColor, text_size=size.tiny)
    
    // RSI
    table.cell(infoPanel, 0, 5, "RSI", text_color=color.gray, text_size=size.tiny)
    rsiColor = rsiExtremeOS ? color.new(bullishColor, 0) : rsiExtremeOB ? color.new(bearishColor, 0) : rsiOversold ? color.new(color.green, 0) : rsiOverbought ? color.new(color.orange, 0) : color.white
    table.cell(infoPanel, 1, 5, str.tostring(rsi, "#.#"), text_color=rsiColor, text_size=size.tiny)
    
    // Active Levels
    table.cell(infoPanel, 0, 6, "Active Lvls", text_color=color.gray, text_size=size.tiny)
    table.cell(infoPanel, 1, 6, str.tostring(activeCount), text_color=color.white, text_size=size.tiny)
    
    // MTF Status
    if useMTF
        table.cell(infoPanel, 0, 7, "MTF Confl", text_color=color.gray, text_size=size.tiny)
        mtfColor = mtfAbnormal ? color.new(bullishColor, 0) : color.gray
        table.cell(infoPanel, 1, 7, mtfAbnormal ? "Yes" : "No", text_color=mtfColor, text_size=size.tiny)

// ── STATISTICS TABLE ──
if barstate.islast and showStatistics
    var table statsTable = table.new(position.bottom_right, 2, 6,
        bgcolor=color.new(#1a1a2e, 10),
        border_width=1,
        border_color=color.new(#16213e, 0))
    
    // Calculate statistics
    avgImportance = 0.0
    if array.size(liqImportance) > 0
        for i = 0 to array.size(liqImportance) - 1
            avgImportance += array.get(liqImportance, i)
        avgImportance := avgImportance / array.size(liqImportance)
    
    // Header
    table.cell(statsTable, 0, 0, "Statistics", 
        bgcolor=color.new(#0f3460, 20), 
        text_color=color.white, 
        text_size=size.tiny)
    table.merge_cells(statsTable, 0, 0, 1, 0)
    
    table.cell(statsTable, 0, 1, "Total Levels", text_color=color.gray, text_size=size.tiny)
    table.cell(statsTable, 1, 1, str.tostring(array.size(liqLevels)), text_color=color.white, text_size=size.tiny)
    
    table.cell(statsTable, 0, 2, "Active", text_color=color.gray, text_size=size.tiny)
    table.cell(statsTable, 1, 2, str.tostring(activeCount), text_color=color.new(bullishColor, 0), text_size=size.tiny)
    
    table.cell(statsTable, 0, 3, "Tagged", text_color=color.gray, text_size=size.tiny)
    table.cell(statsTable, 1, 3, str.tostring(taggedCount), text_color=color.new(neutralColor, 0), text_size=size.tiny)
    
    table.cell(statsTable, 0, 4, "Avg Importance", text_color=color.gray, text_size=size.tiny)
    table.cell(statsTable, 1, 4, str.tostring(avgImportance, "#.#") + "%", text_color=color.white, text_size=size.tiny)
    
    table.cell(statsTable, 0, 5, "Volume Status", text_color=color.gray, text_size=size.tiny)
    volStatus = extremeVolume ? "Extreme" : veryAbnormalVolume ? "High" : abnormalVolume ? "Elevated" : "Normal"
    volStatusColor = extremeVolume ? color.new(bearishColor, 0) : veryAbnormalVolume ? color.new(neutralColor, 0) : abnormalVolume ? color.new(bullishColor, 0) : color.gray
    table.cell(statsTable, 1, 5, volStatus, text_color=volStatusColor, text_size=size.tiny)

// ── ALERTS ──
alertcondition(
    condition=bullishSignal,
    title="Bullish Liquidation Reversal",
    message="🟢 BULLISH LIQUIDATION REVERSAL\n" +
            "Symbol: {{ticker}}\n" +
            "Timeframe: {{interval}}\n" +
            "Price: {{close}}")

alertcondition(
    condition=bearishSignal,
    title="Bearish Liquidation Reversal",
    message="🔴 BEARISH LIQUIDATION REVERSAL\n" +
            "Symbol: {{ticker}}\n" +
            "Timeframe: {{interval}}\n" +
            "Price: {{close}}")

alertcondition(
    condition=strongBullishStopHunt,
    title="Strong Bullish Stop Hunt",
    message="🎯 STRONG BULLISH STOP HUNT\n" +
            "Symbol: {{ticker}}\n" +
            "Price: {{close}}\n" +
            "Shorts swept and rejected!")

alertcondition(
    condition=strongBearishStopHunt,
    title="Strong Bearish Stop Hunt",
    message="🎯 STRONG BEARISH STOP HUNT\n" +
            "Symbol: {{ticker}}\n" +
            "Price: {{close}}\n" +
            "Longs swept and rejected!")

alertcondition(
    condition=isMajorLiquidation and abnormalVolume,
    title="Major Liquidation Event",
    message="⚠️ MAJOR LIQUIDATION EVENT\n" +
            "Symbol: {{ticker}}\n" +
            "Check chart for details.")
