//@version=6
indicator("AncientNeros Gap Suite (Mitigated)", shorttitle="ANGS", overlay=true, max_boxes_count=500)

// ==========================================
// 1. INPUTS
// ==========================================
grp_settings  = "Logic & Performance"
i_lookback    = input.int(5000, "Lookback Period (Bars)", minval=10, group=grp_settings, tooltip="Detection starts this many bars back from the current bar.")

grp_style_bg  = "Body Gap (BG) Style"
i_bgColorB    = input.color(color.new(#2962FF, 85), "Bullish BG Color", group=grp_style_bg)
i_bgColorS    = input.color(color.new(#FF5252, 85), "Bearish BG Color", group=grp_style_bg)

grp_style_cg  = "Candle Gap (CG) Style"
i_cgColorB    = input.color(color.new(#00BCD4, 80), "Bullish CG Color", group=grp_style_cg)
i_cgColorS    = input.color(color.new(#FF9800, 80), "Bearish CG Color", group=grp_style_cg)

i_borderColor = input.color(color.new(color.gray, 60), "Border Color")
i_textColor   = input.color(color.new(color.black, 0), "Text Color")

// ==========================================
// 2. TYPES & STATE
// ==========================================
type Gap
    box b
    float top
    float bottom
    bool isBull
    string gapType // "BG" or "CG"

var Gap[] active_gaps = array.new<Gap>()

// Helper for box text
f_box_text(type, top_val, bot_val) => 
    type + " (" + str.tostring(bot_val, format.mintick) + " - " + str.tostring(top_val, format.mintick) + ")"

// ==========================================
// 3. DETECTION (at bar close)
// ==========================================
// Detect gaps only on confirmed bars to prevent duplicates on the live bar
if last_bar_index - bar_index <= i_lookback and barstate.isconfirmed

    // Boundary calculations
    prev_max_oc = math.max(open[1], close[1])
    prev_min_oc = math.min(open[1], close[1])

    // 3a. Bullish Detections
    // Priority 1: Candle Gap (CG) - Wick to Wick (Low > Prev High)
    if low > high[1]
        t = low, b = high[1]
        box bx = box.new(bar_index-1, t, bar_index+2, b, bgcolor=i_cgColorB, border_color=i_borderColor, 
             text=f_box_text("CG", t, b), text_size=size.tiny, text_color=i_textColor, extend=extend.right,
             text_halign=text.align_right, text_valign=text.align_center)
        array.push(active_gaps, Gap.new(bx, t, b, true, "CG"))
    
    // Priority 2: Body Gap (BG) - Body to Price (only if not a CG)
    else if low > prev_max_oc
        t = low, b = prev_max_oc
        box bx = box.new(bar_index-1, t, bar_index+2, b, bgcolor=i_bgColorB, border_color=i_borderColor, 
             text=f_box_text("BG", t, b), text_size=size.tiny, text_color=i_textColor, extend=extend.right,
             text_halign=text.align_right, text_valign=text.align_center)
        array.push(active_gaps, Gap.new(bx, t, b, true, "BG"))

    // 3b. Bearish Detections
    // Priority 1: Candle Gap (CG) - Wick to Wick (High < Prev Low)
    if high < low[1]
        t = low[1], b = high
        box bx = box.new(bar_index-1, t, bar_index+2, b, bgcolor=i_cgColorS, border_color=i_borderColor, 
             text=f_box_text("CG", t, b), text_size=size.tiny, text_color=i_textColor, extend=extend.right,
             text_halign=text.align_right, text_valign=text.align_center)
        array.push(active_gaps, Gap.new(bx, t, b, false, "CG"))
    
    // Priority 2: Body Gap (BG) - Body to Price (only if not a CG)
    else if high < prev_min_oc
        t = prev_min_oc, b = high
        box bx = box.new(bar_index-1, t, bar_index+2, b, bgcolor=i_bgColorS, border_color=i_borderColor, 
             text=f_box_text("BG", t, b), text_size=size.tiny, text_color=i_textColor, extend=extend.right,
             text_halign=text.align_right, text_valign=text.align_center)
        array.push(active_gaps, Gap.new(bx, t, b, false, "BG"))

// ==========================================
// 4. MITIGATION & UPDATE (Live)
// ==========================================
if array.size(active_gaps) > 0
    for i = array.size(active_gaps) - 1 to 0
        Gap g = array.get(active_gaps, i)
        bool removed = false
        
        if g.isBull // Bullish Box (mitigated by price Low)
            // Price penetrates from above: lower the TOP of the box
            if low < g.top
                g.top := math.max(low, g.bottom)
                box.set_top(g.b, g.top)
                box.set_text(g.b, g.gapType + " (" + str.tostring(g.bottom, format.mintick) + " - " + str.tostring(g.top, format.mintick) + ")")
            
            // Delete if the gap is fully closed
            if g.top <= g.bottom + syminfo.mintick
                box.delete(g.b)
                array.remove(active_gaps, i)
                removed := true
        else // Bearish Box (mitigated by price High)
            // Price penetrates from below: raise the BOTTOM of the box
            if high > g.bottom
                g.bottom := math.min(high, g.top)
                box.set_bottom(g.b, g.bottom)
                box.set_text(g.b, g.gapType + " (" + str.tostring(g.bottom, format.mintick) + " - " + str.tostring(g.top, format.mintick) + ")")
            
            // Delete if the gap is fully closed
            if g.bottom >= g.top - syminfo.mintick
                box.delete(g.b)
                array.remove(active_gaps, i)
                removed := true
        
        // Dynamic Extension: Keep text at the leading edge (right side of chart)
        if not removed
            box.set_right(g.b, bar_index + 1)
