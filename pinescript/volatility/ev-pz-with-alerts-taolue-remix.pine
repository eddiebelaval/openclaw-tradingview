//@version=6
indicator("Earnings Volatility & Projection Zones with Alerts [Taolue Remix]", shorttitle="EV & PZ with Alerts [Taolue Remix]", overlay=true, max_lines_count=100, max_labels_count=100)

// --- ユーザー設定 ---
lookback_earnings = input.int(4, "参照する過去の決算回数", minval=1)
check_next_day    = input.bool(true, "決算翌日の動きを計測する（引け後決算用）")
future_bars_span  = input.int(20, "予測ゾーンの表示期間（バー数）", minval=5)

// --- データの取得 ---
float earned_val = request.earnings(syminfo.tickerid, earnings.actual, gaps=barmerge.gaps_on, ignore_invalid_symbol=true)

// --- 変数定義 ---
var float[] past_moves = array.new_float(0)
var float avg_volatility = 0.0

// --- 決算日の判定 ---
bool is_earnings_day = not na(earned_val)
bool is_target_day   = check_next_day ? is_earnings_day[1] : is_earnings_day

// --- 背景色のための変数 ---
color signal_color = na

// --- ボラティリティ計算と記録 ---
if is_target_day
    float move_pct = (high - low) / open
    array.unshift(past_moves, move_pct)
    if array.size(past_moves) > lookback_earnings
        array.pop(past_moves)
        
    string label_text = "Vol: " + str.tostring(move_pct * 100, "#.1") + "%"
    label.new(bar_index, high, label_text, xloc=xloc.bar_index, color=color.new(color.blue, 40), style=label.style_label_down, textcolor=color.white, size=size.small)
    signal_color := color.new(color.blue, 80)

bgcolor(signal_color)

// --- 平均変動率の更新 ---
if array.size(past_moves) > 0
    avg_volatility := array.avg(past_moves)

// --- 【重要】アラート判定ロジック ---
// 現在の足の「始値」を基準に、平均変動率分のターゲット価格を計算（日中固定される）
float today_upper_limit = open * (1 + avg_volatility)
float today_lower_limit = open * (1 - avg_volatility)

// 高値・安値がそのラインにタッチしたか判定
bool hit_upper = high >= today_upper_limit
bool hit_lower = low <= today_lower_limit

// アラート条件の定義
alertcondition(hit_upper, title="📈 上値ターゲット到達 (Upper Hit)", message="価格が予想変動率の上限に到達しました！")
alertcondition(hit_lower, title="📉 下値ターゲット到達 (Lower Hit)", message="価格が予想変動率の下限に到達しました！")

// --- 未来の予測ゾーン描画（視覚用） ---
var line upper_line = na
var line lower_line = na
var label info_label = na
var box zone_box = na

if barstate.islast and avg_volatility > 0
    line.delete(upper_line)
    line.delete(lower_line)
    label.delete(info_label)
    box.delete(zone_box)
    
    // 現在価格からの予測（視覚的な目安）
    float projected_high = close * (1 + avg_volatility)
    float projected_low  = close * (1 - avg_volatility)
    
    int end_bar_index = bar_index + future_bars_span
    
    upper_line := line.new(bar_index, projected_high, end_bar_index, projected_high, xloc=xloc.bar_index, color=color.red, style=line.style_dashed, width=2)
    lower_line := line.new(bar_index, projected_low, end_bar_index, projected_low, xloc=xloc.bar_index, color=color.green, style=line.style_dashed, width=2)
    zone_box := box.new(bar_index, projected_high, end_bar_index, projected_low, xloc=xloc.bar_index, border_color=na, bgcolor=color.new(color.gray, 90))
    
    string t1 = "📊 次回決算ターゲット\n"
    string t2 = "平均変動率: ±" + str.tostring(avg_volatility * 100, "#.2") + "%\n"
    string t3 = "上値目処: " + str.tostring(projected_high, "#.2") + "\n"
    string t4 = "下値目処: " + str.tostring(projected_low, "#.2")
    string final_txt = t1 + t2 + t3 + t4
    
    info_label := label.new(x=end_bar_index, y=projected_high, text=final_txt, xloc=xloc.bar_index, color=color.new(color.black, 100), style=label.style_label_left, textcolor=color.gray)
