// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//@version=6
indicator("Average Volatility Zones", overlay=true, max_lines_count=100, max_boxes_count=100, max_labels_count=100)

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS
// ══════════════════════════════════════════════════════════════════════════════

// ─── Core ────────────────────────────────────────────────────────────────────
string GRP_CORE  = "Core Settings"
i_tf             = input.timeframe("D",        "Timeframe",       group = GRP_CORE)
i_period         = input.int(20,               "Period",          group = GRP_CORE, minval = 1)
i_volType        = input.string("High-Low",    "Volatility Type", group = GRP_CORE, options = ["High-Low", "True Range"])

// ─── Pip ─────────────────────────────────────────────────────────────────────
string GRP_PIP   = "Pip Settings"
i_pipMode        = input.string("Auto",        "Pip Mode",        group = GRP_PIP, options = ["Auto", "Manual"])
i_pipManual      = input.float(0.0001,         "Manual Pip Size", group = GRP_PIP, step = 0.00001)
i_decimals       = input.int(1,                "Decimal Places",  group = GRP_PIP, minval = 0, maxval = 5)

// ─── Main Lines ──────────────────────────────────────────────────────────────
string GRP_LINE  = "Line Appearance"
i_extBars        = input.int(100,              "Extension (bars forward)", group = GRP_LINE, minval = 1)
i_lineWidth      = input.int(2,                "Line Width",              group = GRP_LINE, minval = 1, maxval = 5)
i_lineStyle      = input.string("Solid",       "Line Style",              group = GRP_LINE, options = ["Solid", "Dashed", "Dotted"])
i_colUp          = input.color(#006400,        "Upper Line Color",        group = GRP_LINE)
i_colDn          = input.color(#8B0000,        "Lower Line Color",        group = GRP_LINE)

// ─── 2x Scale ────────────────────────────────────────────────────────────────
string GRP_2X    = "2x Scale"
i_show2x         = input.bool(false,           "Enable 2x Level",   group = GRP_2X)
i_col2xUp        = input.color(#004d00,        "2x Upper Color",    group = GRP_2X)
i_col2xDn        = input.color(#660000,        "2x Lower Color",    group = GRP_2X)

// ─── 3x Scale ────────────────────────────────────────────────────────────────
string GRP_3X    = "3x Scale"
i_show3x         = input.bool(false,           "Enable 3x Level",   group = GRP_3X)
i_col3xUp        = input.color(#003300,        "3x Upper Color",    group = GRP_3X)
i_col3xDn        = input.color(#4d0000,        "3x Lower Color",    group = GRP_3X)

// ─── Custom Scale ────────────────────────────────────────────────────────────
string GRP_CUS   = "Custom Scale"
i_showCust       = input.bool(false,           "Enable Custom Level",   group = GRP_CUS)
i_custMult       = input.float(2.4,            "Custom Multiplier",     group = GRP_CUS, minval = 0.1, step = 0.1)
i_colCustUp      = input.color(#005500,        "Custom Upper Color",    group = GRP_CUS)
i_colCustDn      = input.color(#550000,        "Custom Lower Color",    group = GRP_CUS)

// ─── Labels ──────────────────────────────────────────────────────────────────
string GRP_LBL   = "Labels"
i_showLabels     = input.bool(true,            "Show Labels",               group = GRP_LBL)
i_lblOffset      = input.int(30,               "Label Offset (bars forward)", group = GRP_LBL, minval = 1)
i_lblColor       = input.color(#555555,        "Label Color",               group = GRP_LBL)
i_lblSize        = input.string("Small",       "Label Size",                group = GRP_LBL, options = ["Tiny", "Small", "Normal", "Large", "Huge"])

// ─── Zones ───────────────────────────────────────────────────────────────────
string GRP_ZONE  = "Zones"
i_showZones      = input.bool(false,           "Show Zones",            group = GRP_ZONE)
i_zonePct        = input.float(10.0,           "Zone Width (% of Avg Volatility)", group = GRP_ZONE, minval = 0.1, step = 0.5)
i_zoneTrans      = input.int(85,               "Zone Transparency (0=opaque, 100=invisible)", group = GRP_ZONE, minval = 0, maxval = 100)

// ══════════════════════════════════════════════════════════════════════════════
//  HELPERS
// ══════════════════════════════════════════════════════════════════════════════

f_lineStyle() =>
    switch i_lineStyle
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        =>          line.style_solid

f_labelSize() =>
    switch i_lblSize
        "Tiny"  => size.tiny
        "Small" => size.small
        "Large" => size.large
        "Huge"  => size.huge
        =>         size.normal

f_pipAuto() =>
    bool isForex    = syminfo.type == "forex"
    bool fractional = isForex and (syminfo.mintick == 0.00001 or syminfo.mintick == 0.001)
    isForex ? (fractional ? syminfo.mintick * 10.0 : syminfo.mintick) : syminfo.mintick

float pipSize = i_pipMode == "Auto" ? f_pipAuto() : i_pipManual
float pow10   = math.pow(10.0, float(i_decimals))

f_pipsStr(float priceVal) =>
    float p = priceVal / pipSize
    str.tostring(math.round(p * pow10) / pow10)

// Timeframe display string
string tfDisp = (i_tf == "" or i_tf == timeframe.period) ? timeframe.period : i_tf

// ══════════════════════════════════════════════════════════════════════════════
//  MTF DATA
// ══════════════════════════════════════════════════════════════════════════════

float avgVol = request.security(
     syminfo.tickerid, i_tf,
     i_volType == "High-Low" ? ta.sma(high - low, i_period) : ta.sma(ta.tr(true), i_period),
     barmerge.gaps_off, barmerge.lookahead_off)

float tfOpen = request.security(
     syminfo.tickerid, i_tf, open,
     barmerge.gaps_off, barmerge.lookahead_on)

bool valid = not na(avgVol) and not na(tfOpen) and pipSize > 0

// ─── Detect current-period start bar ─────────────────────────────────────────
var int periodStartIdx = 0
if timeframe.change(i_tf)
    periodStartIdx := bar_index

// ══════════════════════════════════════════════════════════════════════════════
//  DRAWING ENGINE
// ══════════════════════════════════════════════════════════════════════════════

// Persistent arrays for cleanup
var line[]  aLines  = array.new<line>()
var label[] aLabels = array.new<label>()
var box[]   aBoxes  = array.new<box>()

// Draw one level (upper + lower line, optional label + zone)
drawLevel(float basePrice, float offset, color colUp, color colDn, string prefix,
          float zoneHalfPrice, int x1, int x2, int lblX, float lblYOffset) =>
    float upper = basePrice + offset
    float lower = basePrice - offset

    string tag = prefix + tfDisp + "(" + str.tostring(i_period) + "), " + f_pipsStr(offset) + " pips"

    // ── Lines ──
    array.push(aLines, line.new(x1, upper, x2, upper, color = colUp, width = i_lineWidth, style = f_lineStyle()))
    array.push(aLines, line.new(x1, lower, x2, lower, color = colDn, width = i_lineWidth, style = f_lineStyle()))

    // ── Labels (placed in the future, away from candles) ──
    if i_showLabels
        array.push(aLabels, label.new(lblX, upper + lblYOffset, tag,
             style = label.style_none, textcolor = i_lblColor, size = f_labelSize(), textalign = text.align_left))
        array.push(aLabels, label.new(lblX, lower + lblYOffset, tag,
             style = label.style_none, textcolor = i_lblColor, size = f_labelSize(), textalign = text.align_left))

    // ── Zones ──
    if i_showZones and zoneHalfPrice > 0
        array.push(aBoxes, box.new(x1, upper + zoneHalfPrice, x2, upper - zoneHalfPrice,
             border_color = color.new(colUp, i_zoneTrans), bgcolor = color.new(colUp, i_zoneTrans)))
        array.push(aBoxes, box.new(x1, lower + zoneHalfPrice, x2, lower - zoneHalfPrice,
             border_color = color.new(colDn, i_zoneTrans), bgcolor = color.new(colDn, i_zoneTrans)))
    true

// ══════════════════════════════════════════════════════════════════════════════
//  MAIN EXECUTION
// ══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    // ── Cleanup previous drawings ──
    for ln in aLines
        line.delete(ln)
    array.clear(aLines)

    for lb in aLabels
        label.delete(lb)
    array.clear(aLabels)

    for bx in aBoxes
        box.delete(bx)
    array.clear(aBoxes)

    // ── Draw fresh ──
    if valid
        int x1   = periodStartIdx
        int x2   = bar_index + i_extBars
        int lblX = bar_index + i_lblOffset   // user-configurable label position

        float zHalf  = i_showZones ? (i_zonePct / 100.0 * avgVol / 2.0) : 0.0
        float lblOff = avgVol * 0.02

        // ── 1x ──
        drawLevel(tfOpen, avgVol, i_colUp, i_colDn, "", zHalf, x1, x2, lblX, lblOff)

        // ── 2x ──
        if i_show2x
            drawLevel(tfOpen, avgVol * 2.0, i_col2xUp, i_col2xDn, "2x", zHalf, x1, x2, lblX, lblOff)

        // ── 3x ──
        if i_show3x
            drawLevel(tfOpen, avgVol * 3.0, i_col3xUp, i_col3xDn, "3x", zHalf, x1, x2, lblX, lblOff)

        // ── Custom ──
        if i_showCust
            string cp = str.tostring(i_custMult) + "x"
            drawLevel(tfOpen, avgVol * i_custMult, i_colCustUp, i_colCustDn, cp, zHalf, x1, x2, lblX, lblOff)
