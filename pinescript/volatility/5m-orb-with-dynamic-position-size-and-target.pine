//@version=6
indicator("NY 5m ORB - Clean Daily Lines", overlay=true)

// --- User Inputs ---
risk_usd     = input.float(100.0, "Risk Amount ($)", minval=1.0, group="Risk")
tick_buffer  = input.int(1, "Stop Buffer (Ticks)", minval=0, group="Risk")
size_thresh  = input.float(20.0, "ORB Size Threshold (Pts)", tooltip="If ORB is larger than this, use Target 2", group="Targets")
target_1_rr  = input.float(2.0, "Standard RR Target", minval=0.1, group="Targets")
target_2_rr  = input.float(1.0, "High Vol RR Target", minval=0.1, group="Targets")

// --- Time Logic ---
timezone       = "America/New_York"
is_new_day     = ta.change(time("D", timezone)) != 0
t_orb          = time(timeframe.period, "0930-0935", timezone)
is_orb_session = not na(t_orb)
// Define the exact drawing window
is_drawing_window = not na(time(timeframe.period, "0930-1200", timezone))

var float orb_h = na
var float orb_l = na
var int   orb_start_index = na

// --- Line Objects ---
var line hi_line = na
var line lo_line = na
var line target_h_line = na
var line target_l_line = na

// Reset everything at the start of a new trading day
if is_new_day
    orb_h := na
    orb_l := na
    orb_start_index := na
    hi_line := na
    lo_line := na
    target_h_line := na
    target_l_line := na

// Track the range and the start bar
if is_orb_session
    if na(orb_start_index)
        orb_start_index := bar_index
    
    orb_h := na(orb_h) ? high + (tick_buffer * syminfo.mintick) : math.max(orb_h, high + (tick_buffer * syminfo.mintick))
    orb_l := na(orb_l) ? low - (tick_buffer * syminfo.mintick) : math.min(orb_l, low - (tick_buffer * syminfo.mintick))

// --- Calculations ---
orb_range      = orb_h - orb_l
active_rr      = orb_range > size_thresh ? target_2_rr : target_1_rr
long_target    = orb_h + (orb_range * active_rr)
short_target   = orb_l - (orb_range * active_rr)

// Risk/Position Sizing
points_at_risk = orb_range
max_contracts  = math.floor(risk_usd / (points_at_risk * 5)) 

// --- Line Drawing Logic ---
if not na(orb_h) and is_drawing_window
    if na(hi_line) 
        // Create lines only once per day at the start of the ORB
        hi_line       := line.new(orb_start_index, orb_h, bar_index, orb_h, color=color.new(color.green, 30), width=2)
        lo_line       := line.new(orb_start_index, orb_l, bar_index, orb_l, color=color.new(color.red, 30), width=2)
        target_h_line := line.new(orb_start_index, long_target, bar_index, long_target, color=color.lime, width=2)
        target_l_line := line.new(orb_start_index, short_target, bar_index, short_target, color=color.orange, width=2)
    else
        // Update the lines on every bar until 12:00 EST
        line.set_xy2(hi_line, bar_index, orb_h)
        line.set_xy2(lo_line, bar_index, orb_l)
        line.set_xy2(target_h_line, bar_index, long_target)
        line.set_xy2(target_l_line, bar_index, short_target)
        
        // Ensure the start height and price stay correct during the first 5 minutes
        line.set_y1(hi_line, orb_h)
        line.set_y1(lo_line, orb_l)
        line.set_y1(target_h_line, long_target)
        line.set_y1(target_l_line, short_target)

// --- Visual Extras ---
bgcolor(is_orb_session ? color.new(color.gray, 90) : na)

// --- UI Dashboard ---
var table risk_table = table.new(position.top_right, 2, 3, bgcolor=color.new(color.black, 70), border_width=1)
if barstate.islast and not na(orb_h)
    bool is_high_vol = orb_range > size_thresh
    table.cell(risk_table, 0, 0, "ORB Size:", text_color=color.white)
    table.cell(risk_table, 1, 0, str.tostring(orb_range, "#.##") + " pts", text_color=color.white)
    table.cell(risk_table, 0, 1, "Active RR:", text_color=color.white)
    table.cell(risk_table, 1, 1, str.tostring(active_rr, "#.#") + (is_high_vol ? " (High Vol)" : ""), text_color=is_high_vol ? color.aqua : color.white)
    table.cell(risk_table, 0, 2, "Max MES:", text_color=color.yellow)
    table.cell(risk_table, 1, 2, str.tostring(max_contracts), text_color=color.yellow, text_size=size.large)
