//@version=6
indicator("ATR % Box", overlay=true)

// Inputs
length = input.int(14, "ATR Length", minval=1)
boxPos = input.string("Top Right", "Box Position", options=[
     "Top Left", "Top Center", "Top Right",
     "Middle Left", "Middle Center", "Middle Right",
     "Bottom Left", "Bottom Center", "Bottom Right"
])

bgColor   = input.color(color.black, "Background Color")
textColor = input.color(color.white, "Text Color")

// ATR %
atrValue = ta.atr(length)
atrPercent = (atrValue / close) * 100

// Convert text input to TradingView table position
tablePos = switch boxPos
    "Top Left"      => position.top_left
    "Top Center"    => position.top_center
    "Top Right"     => position.top_right
    "Middle Left"   => position.middle_left
    "Middle Center" => position.middle_center
    "Middle Right"  => position.middle_right
    "Bottom Left"   => position.bottom_left
    "Bottom Center" => position.bottom_center
    => position.bottom_right

// Create table
var table t = table.new(tablePos, 1, 1, frame_color=color.gray, frame_width=1)

if barstate.islast
    table.cell(t, 0, 0, "ATR%: " + str.tostring(atrPercent, "#.##") + "%", text_color=textColor, bgcolor=bgColor)
