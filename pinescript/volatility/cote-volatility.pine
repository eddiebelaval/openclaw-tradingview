//@version=5
indicator("COTE Volatility", overlay=true)

// Ayarlar
atrLength = input.int(14, "ATR Length")
multiplier = input.float(2.0, "ATR Multiplier")

// ATR hesapla
atrValue = ta.atr(atrLength)

// Mum genişliği
candleRange = high - low

// Volatilite spike
volatilitySpike = candleRange > atrValue * multiplier

// Yukarı / aşağı ayrımı
bearSpike = volatilitySpike and close < open
bullSpike = volatilitySpike and close > open

// Grafik işaretleri
plotshape(bearSpike, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
plotshape(bullSpike, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
