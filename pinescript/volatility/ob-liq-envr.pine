//@version=6
indicator("Algo-Zone: XAUUSD 2m Sadık Avcı", overlay=true, max_boxes_count=150)

// --- 1. LİKİDİTE KATMANLARI (XAU İÇİN HASSAS) ---
hi = ta.highest(high[1], 30)
lo = ta.lowest(low[1], 30)
super_hi = ta.highest(high[1], 50)
super_lo = ta.lowest(low[1], 50)
ema100 = ta.ema(close, 100) 

// Görselleştirme (Sadık Çizgiler)
plot(hi, "Üst Likidite", color=color.new(color.red, 50), style=plot.style_linebr)
plot(lo, "Alt Likidite", color=color.new(color.green, 50), style=plot.style_linebr)
plot(super_hi, "SÜPER ÜST", color=color.new(color.black, 20), style=plot.style_linebr, linewidth=2)
plot(super_lo, "SÜPER ALT", color=color.new(color.black, 20), style=plot.style_linebr, linewidth=2)
plot(ema100, "EMA 100 (Altın Trendi)", color=color.yellow, linewidth=3)

// --- 2. FVG TESPİTİ (BELİRGİN VE SAYDAM) ---
fvg_up = low > high[2]
fvg_down = high < low[2]

if fvg_up
    box.new(bar_index-2, high[2], bar_index, low, bgcolor=color.new(color.green, 92), border_color=color.new(color.green, 85), 
             text="FVG", text_color=color.green, text_size=size.tiny, text_valign="center", text_halign="center")
if fvg_down
    box.new(bar_index-2, low[2], bar_index, high, bgcolor=color.new(color.red, 92), border_color=color.new(color.red, 85), 
             text="FVG", text_color=color.red, text_size=size.tiny, text_valign="center", text_halign="center")

// --- 3. ANA SİNYAL VE YIĞILMA KİLİDİ ---
av_oldu_ust = high > hi and close < hi
av_oldu_alt = low < lo and close > lo
super_av_ust = high > super_hi and close < super_hi
super_av_alt = low < super_lo and close > super_lo

var int son_nokta_bar = 0
can_signal = (bar_index - son_nokta_bar) > 15 

// --- 4. SAYDAM KUTULAR VE ONAY ---
is_super_sat = can_signal and super_av_ust
is_normal_sat = can_signal and (av_oldu_ust and close < ema100)
is_super_al = can_signal and super_av_alt
is_normal_al = can_signal and (av_oldu_alt and close > ema100)

onay_sat = is_super_sat or is_normal_sat
onay_al = is_super_al or is_normal_al

if onay_sat
    son_nokta_bar := bar_index
    box.new(left=bar_index, top=high, right=bar_index + 21, bottom=low, border_color=color.new(color.red, 60), bgcolor=color.new(color.red, 92))
    label.new(bar_index, high, is_super_sat ? "!!! SÜPER SAT !!!" : "SAT OB", color=color.red, textcolor=color.white, style=label.style_label_down)

if onay_al
    son_nokta_bar := bar_index
    box.new(left=bar_index, top=high, right=bar_index + 21, bottom=low, border_color=color.new(color.green, 60), bgcolor=color.new(color.green, 92))
    label.new(bar_index, low, is_super_al ? "!!! SÜPER AL !!!" : "AL OB", color=color.green, textcolor=color.white, style=label.style_label_up)

// --- 5. WUNDERTRADING ALARMLARI ---
// ÖNEMLİ: WunderTrading'de "Once Per Bar Close" seçilmelidir.
alertcondition(onay_al, title="Wunder AL Sinyali", message='{"action": "buy", "symbol": "XAUUSD", "type": "market"}')
alertcondition(onay_sat, title="Wunder SAT Sinyali", message='{"action": "sell", "symbol": "XAUUSD", "type": "market"}')

// --- 6. MOMENTUM ---
rsi_m = ta.rsi(close, 14)
var table mom_table = table.new(position.top_right, 1, 1, border_width=1)
table.cell(mom_table, 0, 0, "MOMENTUM: " + str.tostring(math.round(rsi_m, 2)), bgcolor=rsi_m > 50 ? color.teal : color.maroon, text_color=color.white)
