//@version=6
//@author=supralgo

//   _________                     _____  .__                  
//  /   _____/__ _______________  /  _  \ |  |    ____   ____  
//  \_____  \|  |  \____ \_  __ \/  /_\  \|  |   / ___\ /  _ \ 
//  /        \  |  /  |_> >  | \/    |    \  |__/ /_/  >  <_> )
// /_______  /____/|   __/|__|  \____|__  /____/\___  / \____/ 
//         \/      |__|                 \/     /_____/         

indicator("ATR-Based Spike Radar [SuprAlgo]", overlay=false)

// █── INPUTS
const string groupvol = "Volatility Signal Settings"
atrSmooth = input.string("RMA", title="ATR Smoothing Type", options=["RMA", "EMA", "SMA", "WMA"], tooltip="📐 Choose the smoothing type used to calculate the ATR (Average True Range).\n\nRMA is the most common for ATR. You can experiment with EMA, SMA, or WMA for different sensitivity.", group=groupvol)
atrLen = input.int(14, title="ATR Length", tooltip="⏱️ Number of bars used to calculate the ATR.\n\nShorter values = more reactive, longer = smoother.\n\nDefault = 14.", group=groupvol)
minVol = input.float(0.5, title="ATR Spike Threshold", tooltip="⚠️ Sets the minimum spike intensity required to trigger a volatility spike between two bars.\n\nShows a spike only if the ATR between two bars is greater than the entered value.\n\nThe higher the value, the bigger the spikes.", group=groupvol)
maSmooth = input.string("SMA", title="MA Smoothing Type", options=["RMA", "EMA", "SMA", "WMA"], tooltip="📐 Choose the smoothing method for the Moving Average of the ATR.\n\nThis moving average is used as a reference baseline to detect rising volatility.", group=groupvol)
maLength = input.int(200, title="Moving Average Length", minval=1, tooltip="📏 Number of bars used to calculate the moving average of ATR.\n\nUsed as a reference to identify if ATR is above or below its usual level.", group=groupvol)
highVolOnly = input.bool(false, title="High Volatile Zones Only",
     tooltip="Only show/alert spikes when the ATR is above its MA (green ATR regime).", group=groupvol)

const string groupdraws = "Drawings"
BullishColor = input.color(#00ff0a, "Bullish/Bearish Color", inline="col", group=groupdraws)
BearishColor = input.color(#ff0000, "", inline="col", tooltip="🟢🔴 Choose the base color used for bullish (ATR above MA) and bearish (ATR below MA) zones and lines.", group=groupdraws)

// █── ATR / MA CALCULATIONS
AvgTrueRange() =>
     atrSmooth == "EMA" ? ta.ema(ta.tr, atrLen) :
     atrSmooth == "RMA" ? ta.rma(ta.tr, atrLen) :
     atrSmooth == "SMA" ? ta.sma(ta.tr, atrLen) :
                          ta.wma(ta.tr, atrLen)

MovingAverage(src) =>
     maSmooth == "EMA" ? ta.ema(src, maLength) :
     maSmooth == "RMA" ? ta.rma(src, maLength) :
     maSmooth == "SMA" ? ta.sma(src, maLength) :
                         ta.wma(src, maLength)

ATR = AvgTrueRange()
MA  = MovingAverage(ATR)
atrPrev = nz(ATR[1])
atrDelta = ATR - atrPrev
volatilitySpike = (ATR > atrPrev) and (atrDelta >= minVol)
spike_zone = volatilitySpike

Atr_MA_above = ATR > MA
Atr_MA_below = ATR < MA

// █── COLORS
bg_col = spike_zone ? color.new(color.white, 80) : na
bg_col2 = spike_zone and Atr_MA_above ? color.new(color.white, 80) : na


// █── MAIN PLOTS
plot_ma       = plot(MA, "MA", color=color.gray, linewidth=1)
plot_atr_main = plot(ATR, "ATR Line", color=spike_zone ? color.white : Atr_MA_above ? BullishColor : BearishColor, style=plot.style_linebr)

// █── DYNAMIC PLOTS FOR FILL EFFECT
plot_atr_bull  = plot(Atr_MA_above and not spike_zone ? ATR : na, "ATR Bull", color=color.new(BullishColor, 0), style=plot.style_linebr)
plot_atr_bear  = plot(Atr_MA_below and not spike_zone ? ATR : na, "ATR Bear", color=color.new(BearishColor, 0), style=plot.style_linebr)
plot_atr_spike = plot(spike_zone ? ATR : na, "ATR Spike", color=color.new(color.white, 0), style=plot.style_linebr)

// █── FILLS
fill(plot_atr_bull, plot_ma, top_value=ATR, bottom_value=MA,
     top_color=color.new(BullishColor, 70), bottom_color=color.new(BullishColor, 100), title="Bullish ATR Fill")

fill(plot_atr_bear, plot_ma, top_value=MA, bottom_value=ATR,
     top_color=color.new(BearishColor, 100), bottom_color=color.new(BearishColor, 70), title="Bearish ATR Fill")

fill(plot_atr_spike, plot_ma, top_value=ATR, bottom_value=MA,
     top_color=color.new(color.white, 70), bottom_color=color.new(color.white, 100), title="ATR Spike Fill")

// █── VISUALS
plotshape(highVolOnly ? volatilitySpike and Atr_MA_above : volatilitySpike, "Spike Volatility", text="Spike!", location=location.belowbar,
          color=color.white, style=shape.diamond, size=size.tiny, textcolor=color.white, force_overlay=true)

bgcolor(highVolOnly ? bg_col2 : bg_col, 0, force_overlay=true)

// █── ALERTS
alertcondition(highVolOnly ? volatilitySpike and Atr_MA_above : volatilitySpike, "🔔 ATR-Based Spike Radar", message="⚠️ ATR Spike detected on {{ticker}}")
