//@version=6
indicator("Diamond V5 : Institutional SMC & Liquidity Engine [Forex | Gold | Indices]", overlay=true, max_bars_back=500)

// ════════════════════════════════════════════════════════════
// 1. AUTO MARKET DETECTION
// ════════════════════════════════════════════════════════════
sym        = syminfo.ticker
is_gold    = str.contains(sym, "XAU") or str.contains(sym, "GOLD") or str.contains(sym, "GC")
is_idx_nq  = str.contains(sym, "NQ")  or str.contains(sym, "MNQ") or str.contains(sym, "US100")
is_idx_sp  = str.contains(sym, "SPX") or str.contains(sym, "SP500") or str.contains(sym, "ES")
is_idx_dj  = str.contains(sym, "DJ")  or str.contains(sym, "YM")
is_idx_eu  = str.contains(sym, "DAX") or str.contains(sym, "GER") or str.contains(sym, "UK100")
is_indices = is_idx_nq or is_idx_sp or is_idx_dj or is_idx_eu
is_forex   = not is_gold and not is_indices

// ════════════════════════════════════════════════════════════
// 2. INPUTS
// ════════════════════════════════════════════════════════════
grp_mkt     = "Market & Timeframe"
grp_struct  = "Structure & PD Arrays"
grp_smc     = "Sweep & Entry Logic"
grp_filters = "Filters & Scoring"
grp_visuals = "Visuals & Dashboard"

market_override = input.string("Auto", "Market Type", options=["Auto","Forex","Gold","Indices"], group=grp_mkt)
htf_period      = input.timeframe("240", "HTF Timeframe", group=grp_mkt)
htf_aggressive  = input.bool(false, "Aggressive HTF", group=grp_mkt)

show_structure  = input.bool(true,  "Show BOS/CHoCH",  group=grp_struct)
swing_left      = input.int(5,      "Pivot Left Bars",  minval=2, maxval=10, group=grp_struct)
swing_right     = input.int(3,      "Pivot Right Bars", minval=1, maxval=5,  group=grp_struct)
bos_confirm     = input.string("Body Close", "BOS Confirmation", options=["Body Close","Wick"], group=grp_struct)
use_pd_filter   = input.bool(true,  "PD Array Filter",  group=grp_struct)
ema_len         = input.int(50,     "EMA Length",       group=grp_struct)
slope_bars      = input.int(5,      "Slope Lookback",   group=grp_struct)
min_slope_atr   = input.float(0.1,  "Min Slope (ATR)",  step=0.05, group=grp_struct)

sweep_lookback  = input.int(3,     "Liquidity Pool Depth", minval=1, maxval=6, group=grp_smc)
cluster_tol     = input.float(0.1, "Cluster Tolerance (ATR)", step=0.05, group=grp_smc)
atr_len         = input.int(14,    "ATR Length", group=grp_smc)
body_filter     = input.bool(true,  "Body Closure Filter", group=grp_smc)
use_fvg         = input.bool(true,  "Require FVG", group=grp_smc)
sl_buffer       = input.float(0.5,  "SL Buffer (ATR)", step=0.1, group=grp_smc)

use_vol         = input.bool(true,  "Volume Filter",       group=grp_filters)
vol_len         = input.int(20,     "Volume MA Length",    group=grp_filters)
use_rsi         = input.bool(true,  "RSI Divergence",      group=grp_filters)
rsi_lb          = input.int(10,     "RSI Lookback (bars)", minval=3, maxval=30, group=grp_filters)
use_session     = input.bool(true,  "Killzone Filter",     group=grp_filters)
min_score       = input.int(5,      "Min Score (0-15)",    minval=0, maxval=15, group=grp_filters)

theme           = input.string("Institutional", "Theme", options=["Institutional","Classic"], group=grp_visuals)
minimal_mode    = input.bool(false,  "Minimal Mode",       group=grp_visuals)
show_dashboard  = input.bool(true,   "Show Dashboard",     group=grp_visuals)
dash_pos_inp    = input.string("Top Right", "Dashboard Position", options=["Top Right","Bottom Right","Top Left"], group=grp_visuals)
dash_size       = input.string("Normal", "Size", options=["Small","Normal","Large"], group=grp_visuals)
show_ema        = input.bool(true,  "Show EMA",     group=grp_visuals)
show_sl         = input.bool(true,  "Show SL Line", group=grp_visuals)
show_tp         = input.bool(true,  "Show TP Line", group=grp_visuals)
show_fvg_box    = input.bool(true,  "Show FVG Box", group=grp_visuals)
tp_rr           = input.float(2.0,  "Target RR Ratio", step=0.5, group=grp_visuals)

// ════════════════════════════════════════════════════════════
// 3. MARKET RESOLUTION
// ════════════════════════════════════════════════════════════
bool mrkt_gold    = market_override == "Gold"    or (market_override == "Auto" and is_gold)
bool mrkt_indices = market_override == "Indices" or (market_override == "Auto" and is_indices)
bool mrkt_forex   = not mrkt_gold and not mrkt_indices

market_name = mrkt_gold ? "GOLD" : mrkt_indices ? "INDEX" : "FOREX"

float sweep_tol_val   = mrkt_gold ? 0.8  : mrkt_indices ? 1.0  : 0.5
float wick_ratio_val  = mrkt_gold ? 0.12 : mrkt_indices ? 0.10 : 0.15
float disp_body_val   = mrkt_gold ? 0.65 : mrkt_indices ? 0.70 : 0.55
float vol_mult_val    = mrkt_gold ? 1.3  : mrkt_indices ? 1.4  : 1.2
float fvg_min_val     = mrkt_gold ? 0.08 : mrkt_indices ? 0.06 : 0.03
int   confirm_win_val = mrkt_gold ? 5    : mrkt_indices ? 4    : 6

// ════════════════════════════════════════════════════════════
// 4. SESSION FUNCTIONS
// ════════════════════════════════════════════════════════════
sess_london  = "0200-0500"
sess_ny_open = "0800-1100"
sess_ny_pre  = "0700-0930"

f_killzone() =>
    in_ldn = not na(time("", sess_london,  "America/New_York"))
    in_ny  = not na(time("", sess_ny_open, "America/New_York"))
    in_pre = not na(time("", sess_ny_pre,  "America/New_York"))
    bool result = false
    if mrkt_indices
        result := in_ny or in_pre
    else
        result := in_ny or in_ldn
    result

f_sess_name() =>
    in_ldn = not na(time("", sess_london,  "America/New_York"))
    in_ny  = not na(time("", sess_ny_open, "America/New_York"))
    in_pre = not na(time("", sess_ny_pre,  "America/New_York"))
    string s = "Off-Hours"
    if in_ldn
        s := "London"
    else if in_ny
        s := "New York"
    else if in_pre
        s := "Pre-Market"
    s

f_day_qual() =>
    d = dayofweek(time)
    bool result = false
    if mrkt_indices
        result := d >= dayofweek.monday and d <= dayofweek.thursday
    else
        result := d >= dayofweek.tuesday and d <= dayofweek.thursday
    result

// ════════════════════════════════════════════════════════════
// 5. CORE INDICATORS
// ════════════════════════════════════════════════════════════
f_safe_div(n, d, v) => d == 0 ? v : n / d

atr     = ta.atr(atr_len)
vol_avg = ta.sma(volume, vol_len)
ema_val = ta.ema(close, ema_len)
rsi_val = ta.rsi(close, 14)

f_rsi_div(is_bull) =>
    is_bull ? rsi_val > rsi_val[rsi_lb] : rsi_val < rsi_val[rsi_lb]

f_htf_trend() =>
    shift   = htf_aggressive ? 0 : 1
    lkd     = htf_aggressive ? barmerge.lookahead_on : barmerge.lookahead_off
    src     = close[shift]
    htf_c   = request.security(syminfo.tickerid, htf_period, src,                              lookahead=lkd, gaps=barmerge.gaps_off)
    htf_e   = request.security(syminfo.tickerid, htf_period, ta.ema(src, ema_len),             lookahead=lkd, gaps=barmerge.gaps_off)
    htf_ep  = request.security(syminfo.tickerid, htf_period, ta.ema(src, ema_len)[slope_bars], lookahead=lkd, gaps=barmerge.gaps_off)
    htf_atr = request.security(syminfo.tickerid, htf_period, ta.atr(14)[shift],                lookahead=lkd, gaps=barmerge.gaps_off)
    slope   = f_safe_div(htf_e - htf_ep, htf_atr, 0)
    int dir = 0
    if htf_c > htf_e and slope > min_slope_atr
        dir := 1
    else if htf_c < htf_e and slope < -min_slope_atr
        dir := -1
    dir

f_get_fvg(is_bull) =>
    float top = na
    float bot = na
    bool  ok  = false
    min_gap   = atr * fvg_min_val
    if is_bull
        gap = low - high[2]
        if gap > min_gap and close > open
            ok  := true
            top := low
            bot := high[2]
    else
        gap = low[2] - high
        if gap > min_gap and close < open
            ok  := true
            top := low[2]
            bot := high
    [ok, top, bot]

// ════════════════════════════════════════════════════════════
// 6. SWING DETECTION
// ════════════════════════════════════════════════════════════
var float[] sw_high_price = array.new_float(0)
var int[]   sw_high_idx   = array.new_int(0)
var float[] sw_low_price  = array.new_float(0)
var int[]   sw_low_idx    = array.new_int(0)

ph = ta.pivothigh(swing_left, swing_right)
pl = ta.pivotlow (swing_left, swing_right)

if not na(ph)
    array.unshift(sw_high_price, ph)
    array.unshift(sw_high_idx,   bar_index[swing_right])
    if array.size(sw_high_price) > 10
        array.pop(sw_high_price)
        array.pop(sw_high_idx)

if not na(pl)
    array.unshift(sw_low_price, pl)
    array.unshift(sw_low_idx,   bar_index[swing_right])
    if array.size(sw_low_price) > 10
        array.pop(sw_low_price)
        array.pop(sw_low_idx)

// ════════════════════════════════════════════════════════════
// 7. STRUCTURE ENGINE
// ════════════════════════════════════════════════════════════
var int   structure_state  = 0
var float protected_level  = na
var float target_level     = na
var float range_high       = na
var float range_low        = na
var line  struct_line_prot = na
var line  struct_line_targ = na

if bar_index == 0 or structure_state == 0
    structure_state := close > ema_val ? 1 : -1
    protected_level := structure_state == 1 ? (not na(pl) ? pl : low) : (not na(ph) ? ph : high)
    target_level    := structure_state == 1 ? (not na(ph) ? ph : high) : (not na(pl) ? pl : low)
    range_high      := high
    range_low       := low

is_break_up = bos_confirm == "Body Close" ? close > target_level    : high > target_level
is_break_dn = bos_confirm == "Body Close" ? close < target_level    : low  < target_level
is_choch_up = bos_confirm == "Body Close" ? close > protected_level : high > protected_level
is_choch_dn = bos_confirm == "Body Close" ? close < protected_level : low  < protected_level

string event_txt = ""

if structure_state == 1
    if not na(target_level) and is_break_up
        protected_level := array.size(sw_low_price) > 0 ? array.get(sw_low_price, 0) : protected_level
        target_level    := na
        range_high      := high
        range_low       := protected_level
        event_txt       := "BOS"
    else if not na(protected_level) and is_choch_dn
        structure_state := -1
        target_level    := protected_level
        protected_level := array.size(sw_high_price) > 0 ? array.get(sw_high_price, 0) : high
        range_high      := protected_level
        range_low       := low
        event_txt       := "CHoCH"

else if structure_state == -1
    if not na(target_level) and is_break_dn
        protected_level := array.size(sw_high_price) > 0 ? array.get(sw_high_price, 0) : protected_level
        target_level    := na
        range_low       := low
        range_high      := protected_level
        event_txt       := "BOS"
    else if not na(protected_level) and is_choch_up
        structure_state := 1
        target_level    := protected_level
        protected_level := array.size(sw_low_price) > 0 ? array.get(sw_low_price, 0) : low
        range_low       := protected_level
        range_high      := high
        event_txt       := "CHoCH"

if structure_state == 1 and not na(ph)
    if ph > (na(target_level) ? 0.0 : target_level)
        target_level := ph

if structure_state == -1 and not na(pl)
    if pl < (na(target_level) ? 1.0e6 : target_level)
        target_level := pl

if structure_state == 1
    range_high := math.max(range_high, high)
else
    range_low  := math.min(range_low, low)

pd_mid = (range_high + range_low) / 2

if show_structure and event_txt != ""
    lbl_c = event_txt == "CHoCH" ? color.yellow : (structure_state == 1 ? color.teal : color.red)
    lbl_y = event_txt == "BOS" ? (structure_state == 1 ? high : low) : (structure_state == 1 ? low : high)
    label.new(bar_index, lbl_y, event_txt, color=lbl_c, style=label.style_none, textcolor=lbl_c, size=size.tiny)

// ════════════════════════════════════════════════════════════
// 8. HTF ALIGNMENT
// ════════════════════════════════════════════════════════════
htf_dir      = f_htf_trend()
active_trend = (structure_state == htf_dir and structure_state != 0) ? structure_state : 0

// ════════════════════════════════════════════════════════════
// 9. SWEEP ENGINE
// ════════════════════════════════════════════════════════════
var bool  is_sweep = false
var int   sweep_q  = 0

var int[]   mem_bar        = array.new_int(0)
var int[]   mem_trend      = array.new_int(0)
var float[] mem_level      = array.new_float(0)
var float[] mem_extreme    = array.new_float(0)
var int[]   mem_score      = array.new_int(0)
var bool[]  mem_is_cluster = array.new_bool(0)

is_sweep := false
sweep_q  := 0

if active_trend != 0
    arr_p   = active_trend == 1 ? sw_low_price : sw_high_price
    count   = math.min(array.size(arr_p), sweep_lookback)
    c_range = math.max(0.00001, high - low)

    if count > 0
        for i = 0 to count - 1
            target     = array.get(arr_p, i)
            penetrated = active_trend == 1 ? (low < target and close > target) : (high > target and close < target)
            depth      = math.abs(target - (active_trend == 1 ? low : high))

            if penetrated and depth <= (atr * sweep_tol_val)
                wick    = active_trend == 1 ? (math.min(open, close) - low) : (high - math.max(open, close))
                w_ratio = wick / c_range
                body_ok = not body_filter or (active_trend == 1 ? math.min(open, close) >= target : math.max(open, close) <= target)

                if w_ratio >= wick_ratio_val and body_ok
                    q      = 0
                    vol_ok = use_vol and volume > vol_avg * vol_mult_val
                    q += vol_ok ? (mrkt_indices ? 3 : 2) : 0
                    q += (use_session and f_killzone()) ? 2 : 0
                    q += f_day_qual() ? 1 : 0

                    cl = 0
                    for j = 0 to count - 1
                        if math.abs(target - array.get(arr_p, j)) <= (atr * cluster_tol)
                            cl += 1
                    q += cl >= 2 ? 3 : 0

                    pd_ok = not use_pd_filter or (active_trend == 1 ? close < pd_mid : close > pd_mid)
                    q += pd_ok ? 2 : -3

                    if use_rsi
                        q += f_rsi_div(active_trend == 1) ? 2 : 0

                    sweep_q  := q
                    is_sweep := true

                    array.push(mem_bar,        bar_index)
                    array.push(mem_trend,      active_trend)
                    array.push(mem_level,      target)
                    array.push(mem_extreme,    active_trend == 1 ? low : high)
                    array.push(mem_score,      q)
                    array.push(mem_is_cluster, cl >= 2)
                    break

// ════════════════════════════════════════════════════════════
// 10. CONFIRMATION & ENTRY
// ════════════════════════════════════════════════════════════
var bool   entry_sig    = false
var int    entry_dir    = 0
var float  entry_sl     = na
var float  entry_tp     = na
var int    final_q      = 0
var float  fvg_top      = na
var float  fvg_bot      = na
var string last_sig_txt = "Scanning..."
var color  last_sig_col = color.gray
var int    sig_count    = 0

entry_sig := false
to_rem    = array.new_int(0)

if array.size(mem_bar) > 0
    for i = 0 to array.size(mem_bar) - 1
        idx = array.get(mem_bar, i)
        trd = array.get(mem_trend, i)
        scr = array.get(mem_score, i)
        ext = array.get(mem_extreme, i)
        age = bar_index - idx

        if age > confirm_win_val
            array.push(to_rem, i)
        else if age > 0
            is_b      = trd == 1
            candle_ok = is_b ? close > open : close < open
            body      = math.abs(close - open)
            disp_ok   = body >= (atr * disp_body_val)

            [fvg_exists, f_t, f_b] = f_get_fvg(is_b)
            fvg_ok = not use_fvg or fvg_exists

            if candle_ok and disp_ok and fvg_ok
                v_bonus  = (use_vol and volume > vol_avg * vol_mult_val) ? 1 : 0
                tot      = scr + 2 + v_bonus + (fvg_exists ? 2 : 0)

                if tot >= min_score
                    float sl_dist = math.abs(close - ext) + (atr * sl_buffer)
                    float calc_sl = ext + (is_b ? -1.0 : 1.0) * (atr * sl_buffer)
                    float calc_tp = close + (is_b ? 1.0 : -1.0) * (sl_dist * tp_rr)

                    entry_sig    := true
                    entry_dir    := trd
                    entry_sl     := calc_sl
                    entry_tp     := calc_tp
                    final_q      := tot
                    fvg_top      := fvg_exists ? f_t : na
                    fvg_bot      := fvg_exists ? f_b : na
                    sig_count    += 1
                    last_sig_txt := (trd == 1 ? "LONG" : "SHORT") + " [" + str.tostring(tot) + "pts]"
                    last_sig_col := trd == 1 ? color.teal : color.red
                    array.push(to_rem, i)
                    break

if array.size(to_rem) > 0
    array.sort(to_rem, order.descending)
    for i = 0 to array.size(to_rem) - 1
        ri = array.get(to_rem, i)
        array.remove(mem_bar,        ri)
        array.remove(mem_trend,      ri)
        array.remove(mem_score,      ri)
        array.remove(mem_level,      ri)
        array.remove(mem_extreme,    ri)
        array.remove(mem_is_cluster, ri)

// ════════════════════════════════════════════════════════════
// 11. THEME COLORS
// ════════════════════════════════════════════════════════════
c_bull = theme == "Institutional" ? color.rgb(0, 160, 160) : color.lime
c_bear = theme == "Institutional" ? color.rgb(180, 30, 30) : color.red
c_neut = color.gray
c_text = color.white
c_hdr  = mrkt_gold ? color.rgb(120, 80, 0) : mrkt_indices ? color.rgb(20, 60, 120) : color.rgb(20, 80, 60)

// ════════════════════════════════════════════════════════════
// 12. VISUALIZATION
// ════════════════════════════════════════════════════════════
plot(show_ema ? ema_val : na, "EMA", color=active_trend == 1 ? c_bull : active_trend == -1 ? c_bear : c_neut, linewidth=1)

plotshape(not minimal_mode and is_sweep and active_trend == 1,  "Sweep Up",   shape.diamond, location.belowbar, color=color.orange, size=size.tiny)
plotshape(not minimal_mode and is_sweep and active_trend == -1, "Sweep Down", shape.diamond, location.abovebar, color=color.orange, size=size.tiny)

plotshape(entry_sig and entry_dir ==  1, "BUY",  shape.labelup,   location.belowbar, color=c_bull, textcolor=c_text, text="BUY",  size=size.small)
plotshape(entry_sig and entry_dir == -1, "SELL", shape.labeldown, location.abovebar, color=c_bear, textcolor=c_text, text="SELL", size=size.small)

if not minimal_mode and entry_sig
    lbl_y = entry_dir == 1 ? low - (atr * 1.5) : high + (atr * 1.5)
    lbl_s = entry_dir == 1 ? label.style_label_up : label.style_label_down
    lbl_c = entry_dir == 1 ? c_bull : c_bear
    label.new(bar_index, lbl_y, str.tostring(final_q) + "pts  RR " + str.tostring(tp_rr, "#.#"), color=lbl_c, textcolor=c_text, style=lbl_s, size=size.tiny)

var line[] sl_lines  = array.new_line(0)
var line[] tp_lines  = array.new_line(0)
var box[]  fvg_boxes = array.new_box(0)

if show_sl and entry_sig
    sl_l = line.new(bar_index, entry_sl, bar_index + 20, entry_sl, color=color.new(color.red, 20), style=line.style_dotted, width=2)
    array.push(sl_lines, sl_l)
    if array.size(sl_lines) > 5
        line.delete(array.shift(sl_lines))

if show_tp and entry_sig and not na(entry_tp)
    tp_l = line.new(bar_index, entry_tp, bar_index + 20, entry_tp, color=color.new(color.green, 20), style=line.style_dotted, width=2)
    array.push(tp_lines, tp_l)
    if array.size(tp_lines) > 5
        line.delete(array.shift(tp_lines))

if show_fvg_box and entry_sig and not na(fvg_top)
    fvg_c = entry_dir == 1 ? c_bull : c_bear
    bx    = box.new(bar_index - 2, fvg_bot, bar_index, fvg_top, border_color=na, bgcolor=color.new(fvg_c, 78))
    array.push(fvg_boxes, bx)
    if array.size(fvg_boxes) > 5
        box.delete(array.shift(fvg_boxes))

bgcolor(entry_sig ? color.new(entry_dir == 1 ? c_bull : c_bear, 92) : na)

if show_structure and not minimal_mode
    if not na(struct_line_prot)
        line.delete(struct_line_prot)
    if not na(struct_line_targ)
        line.delete(struct_line_targ)
    if not na(protected_level)
        prot_col         = structure_state == 1 ? color.green : color.red
        struct_line_prot := line.new(bar_index - 20, protected_level, bar_index + 5, protected_level, color=prot_col, width=1)
        if barstate.islast
            prot_lbl = "Strong " + (structure_state == 1 ? "Low" : "High")
            label.new(bar_index + 5, protected_level, prot_lbl, color=color.new(color.gray, 100), textcolor=prot_col, style=label.style_label_left, size=size.small)
    if not na(target_level) and show_tp
        struct_line_targ := line.new(bar_index - 20, target_level, bar_index + 5, target_level, color=color.gray, style=line.style_dotted, width=1)
        if barstate.islast
            targ_lbl = "Weak " + (structure_state == 1 ? "High" : "Low")
            label.new(bar_index + 5, target_level, targ_lbl, color=color.new(color.gray, 100), textcolor=color.gray, style=label.style_label_left, size=size.small)

// ════════════════════════════════════════════════════════════
// 13. DASHBOARD
// ════════════════════════════════════════════════════════════
dash_p = dash_pos_inp == "Top Right" ? position.top_right : dash_pos_inp == "Bottom Right" ? position.bottom_right : position.top_left

var table hud = table.new(dash_p, 2, 12, bgcolor=color.new(color.black, 35), frame_color=color.gray, frame_width=1, border_width=1)

if show_dashboard and barstate.islast
    sz = dash_size == "Small" ? size.small : dash_size == "Normal" ? size.normal : size.large

    table.cell(hud, 0, 0, "DIAMOND V5",  text_color=color.yellow, bgcolor=c_hdr, text_size=sz)
    table.cell(hud, 1, 0, market_name,   text_color=color.yellow, bgcolor=c_hdr, text_size=sz)

    htf_txt = htf_dir == 1 ? "BULL" : htf_dir == -1 ? "BEAR" : "RANGE"
    htf_bg  = htf_dir == 1 ? c_bull : htf_dir == -1 ? c_bear : color.gray
    table.cell(hud, 0, 1, "HTF Trend", text_color=color.white, text_size=sz)
    table.cell(hud, 1, 1, htf_txt, bgcolor=htf_bg, text_color=color.white, text_size=sz)

    str_txt = structure_state == 1 ? "BULLISH" : structure_state == -1 ? "BEARISH" : "NEUTRAL"
    str_bg  = structure_state == 1 ? c_bull    : structure_state == -1 ? c_bear    : color.gray
    table.cell(hud, 0, 2, "Structure", text_color=color.white, text_size=sz)
    table.cell(hud, 1, 2, str_txt, bgcolor=str_bg, text_color=color.white, text_size=sz)

    aln_txt = active_trend != 0 ? "ALIGNED" : "CONFLICT"
    aln_bg  = active_trend != 0 ? color.green : color.maroon
    table.cell(hud, 0, 3, "Alignment", text_color=color.white, text_size=sz)
    table.cell(hud, 1, 3, aln_txt, bgcolor=aln_bg, text_color=color.white, text_size=sz)

    is_disc = structure_state == 1 ? close < pd_mid : close > pd_mid
    prc_txt = is_disc ? "DISCOUNT" : "PREMIUM"
    prc_bg  = is_disc ? color.green : color.orange
    table.cell(hud, 0, 4, "Pricing", text_color=color.white, text_size=sz)
    table.cell(hud, 1, 4, prc_txt, bgcolor=prc_bg, text_color=color.white, text_size=sz)

    kz_active = f_killzone()
    sess_bg   = kz_active ? color.green : color.gray
    table.cell(hud, 0, 5, "Session",     text_color=color.white, text_size=sz)
    table.cell(hud, 1, 5, f_sess_name(), bgcolor=sess_bg, text_color=color.white, text_size=sz)

    day_ok  = f_day_qual()
    day_txt = day_ok ? "Trade Day" : "Caution"
    day_bg  = day_ok ? color.green : color.orange
    table.cell(hud, 0, 6, "Day Quality", text_color=color.white, text_size=sz)
    table.cell(hud, 1, 6, day_txt, bgcolor=day_bg, text_color=color.white, text_size=sz)

    atr_unit  = mrkt_forex ? " pip" : mrkt_gold ? " $" : " pts"
    float atr_num = mrkt_forex ? math.round(atr / syminfo.mintick / 10) : math.round(atr * 100) / 100
    table.cell(hud, 0, 7, "ATR", text_color=color.white, text_size=sz)
    table.cell(hud, 1, 7, str.tostring(atr_num) + atr_unit, bgcolor=color.new(color.blue, 60), text_color=color.white, text_size=sz)

    p_swp     = "SWP:" + str.tostring(sweep_tol_val, "#.#")
    p_dsp     = " DSP:" + str.tostring(disp_body_val, "#.#")
    p_win     = " WIN:" + str.tostring(confirm_win_val)
    param_txt = p_swp + p_dsp + p_win
    table.cell(hud, 0, 8, "Params",  text_color=color.white, text_size=sz)
    table.cell(hud, 1, 8, param_txt, bgcolor=color.new(color.purple, 50), text_color=color.white, text_size=sz)

    table.cell(hud, 0, 9, "Last Signal", text_color=color.white, text_size=sz)
    table.cell(hud, 1, 9, last_sig_txt,  bgcolor=color.new(last_sig_col, 35), text_color=color.white, text_size=sz)

    table.cell(hud, 0, 10, "Target RR", text_color=color.white, text_size=sz)
    table.cell(hud, 1, 10, "1 : " + str.tostring(tp_rr, "#.#"), bgcolor=color.new(color.purple, 50), text_color=color.white, text_size=sz)

    table.cell(hud, 0, 11, "Signals",           text_color=color.white, text_size=sz)
    table.cell(hud, 1, 11, str.tostring(sig_count), bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=sz)

// ════════════════════════════════════════════════════════════
// 14. DATA WINDOW & ALERTS
// ════════════════════════════════════════════════════════════
plot(entry_sig ? entry_sl : na, "SL", display=display.data_window)
plot(entry_sig ? entry_tp : na, "TP", display=display.data_window)

alertcondition(entry_sig and entry_dir ==  1, "BUY Signal",  "Diamond V5 - LONG Entry")
alertcondition(entry_sig and entry_dir == -1, "SELL Signal", "Diamond V5 - SHORT Entry")
alertcondition(is_sweep,                      "Sweep Alert", "Liquidity Sweep Detected")
