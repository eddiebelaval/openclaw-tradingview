//@version=5
indicator("NASDAQ HEDGE FUND SCALPING V3", overlay=true)

// ===== INPUTS =====
emaFastLen = input.int(9, "EMA Fast")
emaMidLen = input.int(21, "EMA Mid")
emaSlowLen = input.int(50, "EMA Slow")

volMultiplier = input.float(2.0, "Institutional Volume")
rsiLen = input.int(14, "RSI Length")

// ===== MARKET DATA =====
vix = request.security("CBOE:VIX", timeframe.period, close)

// ===== EMA TREND =====
emaFast = ta.ema(close, emaFastLen)
emaMid = ta.ema(close, emaMidLen)
emaSlow = ta.ema(close, emaSlowLen)

trendBull = emaFast > emaMid and emaMid > emaSlow
trendBear = emaFast < emaMid and emaMid < emaSlow

// ===== MOMENTUM =====
rsi = ta.rsi(close, rsiLen)
[macdLine, macdSignal, macdHist] = ta.macd(close,12,26,9)

momentumBull = rsi > 55 and macdLine > macdSignal
momentumBear = rsi < 45 and macdLine < macdSignal

// ===== SMART MONEY VOLUME =====
volMA = ta.sma(volume,20)
institutionalVolume = volume > volMA * volMultiplier

// ===== PRICE IMPULSE =====
priceImpulseUp = close > open and close > close[1]
priceImpulseDown = close < open and close < close[1]

// ===== VIX FILTER =====
vixBull = vix < 20
vixBear = vix > 22

// ===== SCORING SYSTEM =====
buyers = 0
sellers = 0

buyers += trendBull ? 25 : 0
buyers += momentumBull ? 25 : 0
buyers += institutionalVolume and priceImpulseUp ? 25 : 0
buyers += vixBull ? 25 : 0

sellers += trendBear ? 25 : 0
sellers += momentumBear ? 25 : 0
sellers += institutionalVolume and priceImpulseDown ? 25 : 0
sellers += vixBear ? 25 : 0

buyersPercent = math.round(buyers)
sellersPercent = math.round(sellers)

// ===== SIGNALS =====
buySignal = buyersPercent >= 75
sellSignal = sellersPercent >= 75

// ===== ARROWS =====
plotshape(buySignal, location=location.belowbar, style=shape.triangleup, color=color.lime, size=size.large, text="BUY")

plotshape(sellSignal, location=location.abovebar, style=shape.triangledown, color=color.red, size=size.large, text="SELL")

// ===== TREND LINES =====
plot(emaFast, color=color.green, title="EMA 9")
plot(emaMid, color=color.orange, title="EMA 21")
plot(emaSlow, color=color.red, title="EMA 50")

// ===== HEATMAP =====
bgcolor(buyersPercent > sellersPercent ? color.new(color.green,90) : color.new(color.red,90))

// ===== DASHBOARD =====
var table dashboard = table.new(position.top_right,2,6)

if barstate.islast

    table.cell(dashboard,0,0,"BUYERS",bgcolor=color.new(color.green,70))
    table.cell(dashboard,1,0,str.tostring(buyersPercent)+"%")

    table.cell(dashboard,0,1,"SELLERS",bgcolor=color.new(color.red,70))
    table.cell(dashboard,1,1,str.tostring(sellersPercent)+"%")

    table.cell(dashboard,0,2,"VIX")
    table.cell(dashboard,1,2,str.tostring(math.round(vix,2)))

    table.cell(dashboard,0,3,"SMART MONEY")
    table.cell(dashboard,1,3,institutionalVolume ? "ACTIVE" : "LOW")

    table.cell(dashboard,0,4,"TREND")
    table.cell(dashboard,1,4,trendBull ? "BULLISH" : trendBear ? "BEARISH" : "NEUTRAL")

    table.cell(dashboard,0,5,"TRADE PROB")
    table.cell(dashboard,1,5,buySignal ? "BUY SETUP" : sellSignal ? "SELL SETUP" : "WAIT")

// ===== ALERTS =====
alertcondition(buySignal, title="BUY SIGNAL", message="NASDAQ BUY SIGNAL")
alertcondition(sellSignal, title="SELL SIGNAL", message="NASDAQ SELL SIGNAL")
