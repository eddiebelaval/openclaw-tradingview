//@version=5
indicator("ScalpBoard Pro", overlay=true, dynamic_requests=true)

// ========== НАСТРОЙКИ ==========
showNatr15    = input.bool(true, "N15")
showNatr4H    = input.bool(true, "N4")
showNatr1D    = input.bool(true, "ND")
showDayVol    = input.bool(true, "DV")
showAvgVol    = input.bool(true, "AV")
showRelVol    = input.bool(true, "RV")
showCorr      = input.bool(true, "Corr")

natrLen       = input.int(14, "NATR length")
avgVolLen     = input.int(20, "Avg Volume length")
corrPeriod    = input.int(20, "Correlation period")
corrTicker    = input.symbol("BINANCE:BTCUSDT", "BTC Ticker")

thresholdNatr4H = input.float(0.45, "N4 squeeze <")
thresholdNatr1D = input.float(2.0,  "ND active >")
thresholdRelVol = input.float(1.5,  "RV >")
thresholdDayVol = input.int(100000000, "DV threshold $")
thresholdShort = input.float(1.5, "N4 short >")

// ========== ПОЗИЦИЯ ==========
pos = input.string("Right bottom", "Position", options=["Right top","Right bottom","Left top","Left bottom"])
tablePos = pos == "Right top" ? position.top_right : 
           pos == "Right bottom" ? position.bottom_right : 
           pos == "Left top" ? position.top_left : position.bottom_left

// ========== NATR ==========
atr15 = request.security(syminfo.tickerid, "15", ta.atr(natrLen))
close15 = request.security(syminfo.tickerid, "15", close)
natr15 = (atr15 / close15) * 100

atr4h = request.security(syminfo.tickerid, "240", ta.atr(natrLen))
close4h = request.security(syminfo.tickerid, "240", close)
natr4h = (atr4h / close4h) * 100

atr1d = request.security(syminfo.tickerid, "1D", ta.atr(natrLen))
close1d = request.security(syminfo.tickerid, "1D", close)
natr1d = (atr1d / close1d) * 100

// ========== ДНЕВНОЙ ОБЪЕМ ==========
dailyVolUSD = request.security(syminfo.tickerid, "1D", volume * close)
dayVolNum = dailyVolUSD
dayVolStr = str.tostring(math.round(dayVolNum / 1000000, 1)) + "M"

// ========== СРЕДНИЙ ДНЕВНОЙ ОБЪЕМ ==========
d1  = request.security(syminfo.tickerid, "1D", volume[0] * close[0])
d2  = request.security(syminfo.tickerid, "1D", volume[1] * close[1])
d3  = request.security(syminfo.tickerid, "1D", volume[2] * close[2])
d4  = request.security(syminfo.tickerid, "1D", volume[3] * close[3])
d5  = request.security(syminfo.tickerid, "1D", volume[4] * close[4])
d6  = request.security(syminfo.tickerid, "1D", volume[5] * close[5])
d7  = request.security(syminfo.tickerid, "1D", volume[6] * close[6])
d8  = request.security(syminfo.tickerid, "1D", volume[7] * close[7])
d9  = request.security(syminfo.tickerid, "1D", volume[8] * close[8])
d10 = request.security(syminfo.tickerid, "1D", volume[9] * close[9])
d11 = request.security(syminfo.tickerid, "1D", volume[10] * close[10])
d12 = request.security(syminfo.tickerid, "1D", volume[11] * close[11])
d13 = request.security(syminfo.tickerid, "1D", volume[12] * close[12])
d14 = request.security(syminfo.tickerid, "1D", volume[13] * close[13])
d15 = request.security(syminfo.tickerid, "1D", volume[14] * close[14])
d16 = request.security(syminfo.tickerid, "1D", volume[15] * close[15])
d17 = request.security(syminfo.tickerid, "1D", volume[16] * close[16])
d18 = request.security(syminfo.tickerid, "1D", volume[17] * close[17])
d19 = request.security(syminfo.tickerid, "1D", volume[18] * close[18])
d20 = request.security(syminfo.tickerid, "1D", volume[19] * close[19])

avgVolArray = array.from(d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, d12, d13, d14, d15, d16, d17, d18, d19, d20)
avgVolNum = array.avg(avgVolArray)
avgVolStr = str.tostring(math.round(avgVolNum / 1000000, 1)) + "M"

// ========== ОТНОСИТЕЛЬНЫЙ ОБЪЕМ 4H ==========
vol4h = request.security(syminfo.tickerid, "240", volume * close)
volSma4h = request.security(syminfo.tickerid, "240", ta.sma(volume * close, 7))
relVol = vol4h / volSma4h
relVolStr = str.tostring(math.round(relVol, 2))

// ========== КОРРЕЛЯЦИЯ ==========
btcClose = request.security(corrTicker, timeframe.period, close)
corrVal = ta.correlation(btcClose, close, corrPeriod)
corrStr = str.tostring(math.round(corrVal, 2))

// ========== УРОВНИ ==========
asiaHigh = request.security(syminfo.tickerid, "1D", high)
asiaLow = request.security(syminfo.tickerid, "1D", low)
prevLow = request.security(syminfo.tickerid, "1D", low[1])

// ========== ЦВЕТА - УСИЛЕННЫЙ КОНТРАСТ ==========
// Основные фоны
bgTable = color.new(#1E1E1E, 0)        // темно-серый, не черный
bgHeader = color.new(#F97316, 0)        // яркий оранжевый
bgCard = color.new(#2D2D2D, 0)          // средний серый для ячеек

// Цвета значений - МАКСИМАЛЬНО ЯРКИЕ
bgSqueeze = color.new(#00C853, 0)       // яркий зеленый
bgShort = color.new(#FF3B30, 0)         // яркий красный
bgAlert = color.new(#F97316, 30)        // оранжевый полупрозрачный

// Текст
textWhite = color.white
textOrange = color.new(#FFB74D, 0)      // светлый оранжевый для меток
textMuted = color.new(#AAAAAA, 0)       // серый для разделителей

// ========== УСЛОВИЯ ==========
longSetup = natr4h < thresholdNatr4H and relVol > thresholdRelVol and close > asiaHigh * 0.995 and close < asiaHigh * 1.005
shortSetup = natr4h > thresholdShort and relVol > thresholdRelVol and close < prevLow * 1.005

// ========== ЦВЕТА ЯЧЕЕК ==========
cNatr15 = natr15 < 0.2 ? bgSqueeze : bgCard
cNatr4h = natr4h < thresholdNatr4H ? bgSqueeze : natr4h > thresholdShort ? bgShort : bgCard
cNatr1d = natr1d > thresholdNatr1D ? bgAlert : bgCard
cRelVol = relVol > thresholdRelVol ? bgSqueeze : bgCard
cDayVol = dayVolNum > thresholdDayVol ? bgAlert : bgCard

// ========== ТАБЛИЦА ==========
var table t = table.new(tablePos, 2, 20, border_width=1, border_color=color.new(#444444, 0), bgcolor=bgTable)

if barstate.islast
    row = 0
    
    // ЗАГОЛОВОК — яркий оранжевый
    table.cell(t, 0, row, "SCALP", bgcolor=bgHeader, text_color=textWhite, width=7, text_size=size.small)
    table.cell(t, 1, row, "PRO", bgcolor=bgHeader, text_color=textWhite, width=7, text_size=size.small)
    row += 1
    
    // N15
    if showNatr15
        table.cell(t, 0, row, "N15", bgcolor=bgCard, text_color=textOrange)
        table.cell(t, 1, row, str.tostring(math.round(natr15, 2)) + "%", bgcolor=cNatr15, text_color=textWhite)
        row += 1
    
    // N4
    if showNatr4H
        table.cell(t, 0, row, "N4", bgcolor=bgCard, text_color=textOrange)
        table.cell(t, 1, row, str.tostring(math.round(natr4h, 2)) + "%", bgcolor=cNatr4h, text_color=textWhite)
        row += 1
    
    // ND
    if showNatr1D
        table.cell(t, 0, row, "ND", bgcolor=bgCard, text_color=textOrange)
        table.cell(t, 1, row, str.tostring(math.round(natr1d, 2)) + "%", bgcolor=cNatr1d, text_color=textWhite)
        row += 1
    
    // Разделитель
    table.cell(t, 0, row, "——", bgcolor=bgCard, text_color=textMuted)
    table.cell(t, 1, row, "——", bgcolor=bgCard, text_color=textMuted)
    row += 1
    
    // DV
    if showDayVol
        table.cell(t, 0, row, "DV", bgcolor=bgCard, text_color=textOrange)
        table.cell(t, 1, row, dayVolStr, bgcolor=cDayVol, text_color=textWhite)
        row += 1
    
    // AV
    if showAvgVol
        table.cell(t, 0, row, "AV", bgcolor=bgCard, text_color=textOrange)
        table.cell(t, 1, row, avgVolStr, bgcolor=bgCard, text_color=textWhite)
        row += 1
    
    // RV
    if showRelVol
        table.cell(t, 0, row, "RV", bgcolor=bgCard, text_color=textOrange)
        table.cell(t, 1, row, relVolStr, bgcolor=cRelVol, text_color=textWhite)
        row += 1
    
    // CR
    if showCorr
        table.cell(t, 0, row, "CR", bgcolor=bgCard, text_color=textOrange)
        table.cell(t, 1, row, corrStr, bgcolor=bgCard, text_color=textWhite)
        row += 1
    
    // Разделитель
    table.cell(t, 0, row, "——", bgcolor=bgCard, text_color=textMuted)
    table.cell(t, 1, row, "——", bgcolor=bgCard, text_color=textMuted)
    row += 1
    
    // Сигналы
    if longSetup
        table.cell(t, 0, row, "LONG", bgcolor=bgSqueeze, text_color=textWhite)
        table.cell(t, 1, row, "✓", bgcolor=bgSqueeze, text_color=textWhite)
        row += 1
    
    if shortSetup
        table.cell(t, 0, row, "SHORT", bgcolor=bgShort, text_color=textWhite)
        table.cell(t, 1, row, "↓", bgcolor=bgShort, text_color=textWhite)
        row += 1
