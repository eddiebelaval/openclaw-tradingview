//@version=6
indicator('HiddenRidder - Reversal VIX', overlay = false, precision = 0)
SignalGroup = input(false, title = "Signals")
// Fetch VIX data regardless of what chart you are on
vixData = request.security('TVC:VIX', timeframe.period, close) * -1
len1 = input.int(2,title = "FastEMA")
len2 = input.int(19,title = "SlowEMA")
len3 = input.int(60,title = "Very SlowEMA")
// Calculate EMAs
emaFast = ta.ema(vixData, len1)
emaSlow = ta.ema(vixData, len2)
emsVerySlow = ta.ema(vixData,len3)

// Plotting
p1 = plot(emaFast, title = 'VIX EMA 2', color = color.rgb(0, 0, 0), linewidth = 1,display = display.none)
p2 = plot(emaSlow, title = 'VIX EMA 19', color = color.rgb(213, 8, 8), linewidth = 1,display = display.none)
p3 = plot(emsVerySlow, title = 'VIX EMA 60', color = color.rgb(0, 33, 251), linewidth = 2)
VIXSideway = vixData > emaFast and vixData < emaFast
M4310 =  emaFast > emaSlow ? color.rgb(1, 250, 9, 80) : emaFast < emaSlow ? color.rgb(255, 0, 0, 80) : VIXSideway ? color.orange :na
fill(p1,p2,M4310, title = "EMA 9/18 bgcolor")

DirColor =  emaFast > emaSlow ? color.rgb(1, 250, 9) : emaFast < emaSlow ? color.rgb(255, 0, 0) : VIXSideway ? color.rgb(250, 150, 0) :na
plot(vixData, title = 'VIX', color = DirColor,linewidth = 3)

// Crossover Logic (Inverted for SPX)
buySignal =  ta.crossover(emaFast, emaSlow) and SignalGroup// VIX falling = SPX Sell
sellSignal = ta.crossunder(emaFast, emaSlow) and SignalGroup // VIX rising = SPX Buy


// Visual Signals
plotshape(buySignal, title = 'SPX Sell', style = shape.triangleup, location = location.bottom, color = color.green, size = size.small)
plotshape(sellSignal, title = 'SPX Buy', style = shape.triangledown, location = location.top, color = color.red, size = size.small)

// Background Highlights
bgcolor(buySignal ? color.new(color.green, 90) : na)
bgcolor(sellSignal ? color.new(color.red, 90) : na)
