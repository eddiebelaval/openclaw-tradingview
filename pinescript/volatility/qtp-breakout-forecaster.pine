// ═══════════════════════════════════════════════════════════════════════════
//
//  QTP - Breakout Forecaster
//  ─────────────────────────
//  Probabilistic breakout detection using a random walk model with
//  Normal CDF approximation to forecast the likelihood of price
//  breaking above or below a consolidation range.
//
//  Features:
//  • Statistical probability engine (Abramowitz & Stegun CDF)
//  • Volatility squeeze detection with ATR ratio
//  • Donchian channel overlay on main chart
//  • Professional dashboard with forecast metrics
//  • Neon glow effect on probability lines
//  • Alert conditions for high-probability breakouts
//
// ═══════════════════════════════════════════════════════════════════════════

//@version=6
indicator("QTP - Breakout Forecaster", shorttitle="QTP BkFcst", format=format.price, precision=2)

// ─────────────────────────────────────────────────────────────────────────
//  CONSTANTS
// ─────────────────────────────────────────────────────────────────────────
color ELECTRIC_BLUE  = #00d2ff
color HOT_PINK       = #ff0080
color NEUTRAL_COLOR  = #555555
color PANEL_BG       = #0a0a0a

string GROUP_CALC     = "⚙️  Calculation Settings"
string GROUP_VIS      = "🎨  Visualization"
string DASHBOARD_GROUP = "📊  Dashboard"

color DATA            = #DBDBDB
color HEADERS         = #808080
color BACKGROUND      = #0d0d0d
color BORDERS         = #2E2E2E

string TOP_RIGHT      = 'Top Right'
string BOTTOM_RIGHT   = 'Bottom Right'
string BOTTOM_LEFT    = 'Bottom Left'
string TINY           = 'Tiny'
string SMALL          = 'Small'
string NORMAL         = 'Normal'
string LARGE          = 'Large'
string HUGE           = 'Huge'

// ─────────────────────────────────────────────────────────────────────────
//  INPUTS
// ─────────────────────────────────────────────────────────────────────────

// Calculation
int   lengthInput       = input.int(20, "Range Length", minval=5, group=GROUP_CALC, tooltip="Lookback period to define the consolidation range (High/Low).")
int   horizonInput      = input.int(10, "Forecast Horizon (Bars)", minval=1, group=GROUP_CALC, tooltip="Number of bars into the future for breakout probability calculation.")
int   volLookbackInput  = input.int(50, "Volatility Lookback", minval=10, group=GROUP_CALC, tooltip="Period used to calculate standard deviation for the probability model.")

// Visualization
color bullColorInput    = input.color(ELECTRIC_BLUE, "Bullish Color", group=GROUP_VIS, inline="colors")
color bearColorInput    = input.color(HOT_PINK, "Bearish Color", group=GROUP_VIS, inline="colors")
int   transparencyInput = input.int(70, "Fill Transparency", minval=0, maxval=100, group=GROUP_VIS)
bool  showGlow          = input.bool(true, "Neon Glow Effect", group=GROUP_VIS)
bool  showChannel       = input.bool(true, "Show Range on Chart", group=GROUP_VIS)

// Dashboard
bool   dashboardInput         = input.bool(true, "Enable Dashboard", group=DASHBOARD_GROUP)
string dashboardPositionInput = input.string(TOP_RIGHT, "Position", group=DASHBOARD_GROUP, options=[TOP_RIGHT, BOTTOM_RIGHT, BOTTOM_LEFT])
string dashboardSizeInput     = input.string(SMALL, "Size", group=DASHBOARD_GROUP, options=[TINY, SMALL, NORMAL, LARGE, HUGE])

// ─────────────────────────────────────────────────────────────────────────
//  FUNCTIONS
// ─────────────────────────────────────────────────────────────────────────

// Normal CDF approximation (Abramowitz & Stegun)
nCdf(float x) =>
    float t = 1.0 / (1.0 + 0.2316419 * math.abs(x))
    float d = 0.3989423 * math.exp(-x * x / 2.0)
    float p = d * t * (0.3193815 + t * (-0.3565638 + t * (1.7814779 + t * (-1.821256 + t * 1.3302744))))
    x > 0 ? 1.0 - p : p

// Dashboard helpers
var parsedDashboardPosition = switch dashboardPositionInput
    TOP_RIGHT    => position.top_right
    BOTTOM_RIGHT => position.bottom_right
    BOTTOM_LEFT  => position.bottom_left

var parsedDashboardSize = switch dashboardSizeInput
    TINY   => size.tiny
    SMALL  => size.small
    NORMAL => size.normal
    LARGE  => size.large
    HUGE   => size.huge

cell(table t_able, int column, int row, string data, color txtColor = #FFFFFF, string align = text.align_right, color background = na, float height = 0) =>
    t_able.cell(column, row, data, text_color=txtColor, text_size=parsedDashboardSize, text_halign=align, bgcolor=background, height=height)

divider(table t_able, int row, int lastColumn) =>
    string rowDivider = '━━━━━━━━━━━━━━'
    t_able.merge_cells(0, row, lastColumn, row)
    cell(t_able, 0, row, rowDivider, align=text.align_center, height=0.5, txtColor=BORDERS)

// ─────────────────────────────────────────────────────────────────────────
//  CALCULATIONS
// ─────────────────────────────────────────────────────────────────────────

// Range boundaries
float upperRange = ta.highest(high, lengthInput)
float lowerRange = ta.lowest(low, lengthInput)

// Volatility (log returns std dev)
float logReturns = math.log(close / nz(close[1], close))
float sigma      = ta.stdev(logReturns, volLookbackInput)

// Forecast probabilities
float horizonSqrt = math.sqrt(horizonInput)
float denominator = sigma * horizonSqrt

float bullProb = 0.0
float bearProb = 0.0

if denominator > 0
    float zUpper = math.log(upperRange / close) / denominator
    float zLower = math.log(lowerRange / close) / denominator
    bullProb := (1.0 - nCdf(zUpper)) * 100
    bearProb := nCdf(zLower) * 100

// Volatility squeeze factor
float currentAtr = ta.atr(14)
float avgAtr     = ta.sma(currentAtr, 100)
float squeeze    = math.max(0, 1 - currentAtr / avgAtr) * 100

// Bias
float bias = bullProb - bearProb
string biasLabel = bias > 15 ? "BULLISH" : bias < -15 ? "BEARISH" : "NEUTRAL"
color  biasColor = bias > 15 ? bullColorInput : bias < -15 ? bearColorInput : NEUTRAL_COLOR

// ─────────────────────────────────────────────────────────────────────────
//  PANEL BACKGROUND
// ─────────────────────────────────────────────────────────────────────────
bgcolor(color.new(PANEL_BG, 0), title="Panel Background")

// ─────────────────────────────────────────────────────────────────────────
//  PROBABILITY PLOTS
// ─────────────────────────────────────────────────────────────────────────

// Glow layer (wider, semi-transparent behind main lines)
plot(showGlow ? bullProb : na, "Bull Glow", color=color.new(bullColorInput, 70), linewidth=6, display=display.pane)
plot(showGlow ? -bearProb : na, "Bear Glow", color=color.new(bearColorInput, 70), linewidth=6, display=display.pane)

// Main probability lines
pBull = plot(bullProb, "Bullish Probability", color=bullColorInput, linewidth=2)
pBear = plot(-bearProb, "Bearish Probability", color=bearColorInput, linewidth=2)
plot0  = plot(0, display=display.none, editable=false)

// Threshold lines
plot(50,  "High Prob Upper", color=color.new(bullColorInput, 70), linewidth=1, style=plot.style_cross)
plot(-50, "High Prob Lower", color=color.new(bearColorInput, 70), linewidth=1, style=plot.style_cross)
plot(0,   "Zero Line", color=color.new(NEUTRAL_COLOR, 50), linewidth=1, style=plot.style_cross)

// Fills
fill(pBull, plot0, bullProb, 0, color.new(bullColorInput, transparencyInput), color.new(bullColorInput, 100), "Bullish Fill")
fill(pBear, plot0, 0, -bearProb, color.new(bearColorInput, 100), color.new(bearColorInput, transparencyInput), "Bearish Fill")

// ─────────────────────────────────────────────────────────────────────────
//  DONCHIAN CHANNEL OVERLAY (main chart)
// ─────────────────────────────────────────────────────────────────────────
upperDc = plot(showChannel ? upperRange : na, "Upper Range", color=color.new(bullColorInput, 40), linewidth=1, force_overlay=true)
lowerDc = plot(showChannel ? lowerRange : na, "Lower Range", color=color.new(bearColorInput, 40), linewidth=1, force_overlay=true)
fill(upperDc, lowerDc, top_value=upperRange, bottom_value=lowerRange, top_color=color.new(bullColorInput, 92), bottom_color=color.new(bearColorInput, 92), title="Range Fill")

// ─────────────────────────────────────────────────────────────────────────
//  BREAKOUT ARROWS (main chart)
// ─────────────────────────────────────────────────────────────────────────
bool bullBreak = bullProb > 50 and bullProb[1] <= 50
bool bearBreak = bearProb > 50 and bearProb[1] <= 50

plotshape(bullBreak ? low : na, "Bullish Breakout", shape.triangleup, location.belowbar, bullColorInput, size=size.small, force_overlay=true)
plotshape(bearBreak ? high : na, "Bearish Breakout", shape.triangledown, location.abovebar, bearColorInput, size=size.small, force_overlay=true)

// ─────────────────────────────────────────────────────────────────────────
//  DASHBOARD
// ─────────────────────────────────────────────────────────────────────────
var table t_able = table.new(parsedDashboardPosition, 2, 9, bgcolor=BACKGROUND, border_width=0, frame_color=BORDERS, frame_width=1, force_overlay=true)

if dashboardInput and barstate.islast
    t_able.merge_cells(0, 0, 1, 0)
    cell(t_able, 0, 0, "Breakout Forecast", txtColor=DATA, align=text.align_center)

    divider(t_able, 1, 1)

    cell(t_able, 0, 2, "Bullish Prob.", txtColor=HEADERS, align=text.align_left)
    cell(t_able, 1, 2, str.format("{0,number,#.##}%", bullProb), txtColor=bullProb > 50 ? bullColorInput : DATA)

    cell(t_able, 0, 3, "Bearish Prob.", txtColor=HEADERS, align=text.align_left)
    cell(t_able, 1, 3, str.format("{0,number,#.##}%", bearProb), txtColor=bearProb > 50 ? bearColorInput : DATA)

    divider(t_able, 4, 1)

    cell(t_able, 0, 5, "Bias", txtColor=HEADERS, align=text.align_left)
    cell(t_able, 1, 5, biasLabel, txtColor=biasColor)

    cell(t_able, 0, 6, "Squeeze", txtColor=HEADERS, align=text.align_left)
    cell(t_able, 1, 6, str.format("{0,number,#.##}%", squeeze), txtColor=squeeze > 50 ? color.orange : DATA)

    divider(t_able, 7, 1)

    cell(t_able, 0, 8, "Horizon", txtColor=HEADERS, align=text.align_left)
    cell(t_able, 1, 8, str.tostring(horizonInput) + " Bars", txtColor=DATA)

// ─────────────────────────────────────────────────────────────────────────
//  ALERTS
// ─────────────────────────────────────────────────────────────────────────
alertcondition(bullBreak, "Bullish Breakout Forecast", "Bullish breakout probability crossed above 50%")
alertcondition(bearBreak, "Bearish Breakout Forecast", "Bearish breakout probability crossed above 50%")
alertcondition(squeeze > 70, "High Squeeze Detected", "Volatility squeeze intensity above 70% — breakout imminent")
