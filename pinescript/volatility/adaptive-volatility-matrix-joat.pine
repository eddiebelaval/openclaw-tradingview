//@version=6
indicator("Adaptive Volatility Matrix [JOAT]", shorttitle="AVM [JOAT]", overlay=false, max_bars_back=500)

// ─────────────────────────────────────────────────────────────────────────────────
// CONFIGURATION
// ─────────────────────────────────────────────────────────────────────────────────

g_bbwp = "BBWP Parameters"
g_atr = "ATR Analysis"
g_regime = "Regime Classification"
g_visual = "Visualization"

// BBWP Settings (from DIY Entry Signals knowledge)
bbwp_length = input.int(13, "BBWP Length", minval=5, maxval=50, group=g_bbwp)
bbwp_lookback = input.int(252, "BBWP Lookback", minval=50, maxval=500, group=g_bbwp)

// ATR Settings
atr_period = input.int(14, "ATR Period", minval=5, maxval=50, group=g_atr)
atr_lookback = input.int(100, "ATR Percentile Lookback", minval=50, maxval=500, group=g_atr)

// Regime Thresholds
expansion_threshold = input.float(70.0, "Expansion Threshold", minval=50, maxval=100, step=5, group=g_regime)
contraction_threshold = input.float(30.0, "Contraction Threshold", minval=0, maxval=50, step=5, group=g_regime)
extreme_threshold = input.float(85.0, "Extreme Threshold", minval=70, maxval=100, step=5, group=g_regime)

// Visual
show_regime_zones = input.bool(true, "Show Regime Zones", group=g_visual)
show_histogram = input.bool(true, "Show Histogram", group=g_visual)
show_atr_overlay = input.bool(true, "Show ATR Overlay", group=g_visual)

// ─────────────────────────────────────────────────────────────────────────────────
// COLOR SYSTEM - PURPLE/YELLOW VOLATILITY SPECTRUM (Regime Theme)
// ─────────────────────────────────────────────────────────────────────────────────

color c_extreme_expansion = #ff00ff        // Electric magenta (extreme high vol)
color c_expansion = #cc00ff                // Deep purple (high vol)
color c_normal = #1a1a2e                   // Deep space blue (normal)
color c_contraction = #ffff00              // Electric yellow (low vol)
color c_extreme_contraction = #ccff00      // Lime yellow (extreme low vol)
color c_atr_line = #9d00ff                 // Purple glow
color c_background = #0d0d0d               // Almost black
color c_text = #ffffff                     // Pure white
color c_dashboard_bg = #0a0a0f             // Almost black
color c_dashboard_border = #cc00ff         // Deep purple border

// ─────────────────────────────────────────────────────────────────────────────────
// CORE FUNCTIONS
// ─────────────────────────────────────────────────────────────────────────────────

// BBWP Calculation (from DIY Entry Signals knowledge)
f_calculate_bbwp(int length, int lookback) =>
    float basis = ta.sma(close, length)
    float dev = ta.stdev(close, length)
    float bb_width = (dev * 2) / basis * 100
    
    // Calculate percentile rank
    int count = 0
    for i = 1 to lookback
        if bb_width > nz(bb_width[i])
            count += 1
    
    float bbwp = (count / lookback) * 100
    [bbwp, bb_width]

// ATR Percentile (from VWAP Tension knowledge)
f_atr_percentile(int period, int lookback) =>
    float atr_val = ta.atr(period)
    float natr = close > 0 ? (atr_val / close) * 100 : 0.0
    float percentile = ta.percentrank(natr, lookback)
    [natr, percentile]

// Regime Classification
f_classify_regime(float bbwp_val, float atr_perc, float exp_th, float con_th, float ext_th) =>
    string regime = "Normal"
    int regime_code = 0
    
    if bbwp_val >= ext_th or atr_perc >= ext_th
        regime := "Extreme Expansion"
        regime_code := 4
    else if bbwp_val >= exp_th or atr_perc >= exp_th
        regime := "Expansion"
        regime_code := 3
    else if bbwp_val <= con_th and atr_perc <= con_th
        regime := "Extreme Contraction"
        regime_code := 1
    else if bbwp_val <= (con_th + 10) or atr_perc <= (con_th + 10)
        regime := "Contraction"
        regime_code := 2
    
    [regime, regime_code]

// Volatility Trend (from Mean Reversion knowledge)
f_volatility_trend(float current_val, int period) =>
    float ma_val = ta.sma(current_val, period)
    string trend = current_val > ma_val ? "Rising" : "Falling"
    float strength = math.abs(current_val - ma_val) / ma_val * 100
    [trend, strength]

// ─────────────────────────────────────────────────────────────────────────────────
// CALCULATIONS
// ─────────────────────────────────────────────────────────────────────────────────

// BBWP Calculation
[bbwp_value, bb_width] = f_calculate_bbwp(bbwp_length, bbwp_lookback)

// ATR Analysis
[natr_value, atr_percentile] = f_atr_percentile(atr_period, atr_lookback)

// Combined Volatility Score (weighted average)
float combined_score = (bbwp_value * 0.6) + (atr_percentile * 0.4)

// Regime Classification
[current_regime, regime_code] = f_classify_regime(combined_score, atr_percentile, 
     expansion_threshold, contraction_threshold, extreme_threshold)

// Volatility Trend
[vol_trend, trend_strength] = f_volatility_trend(combined_score, 20)

// Regime Changes
bool regime_changed = regime_code != regime_code[1]

// Historical Regime Stats
var int bars_in_regime = 0
bars_in_regime := regime_changed ? 1 : bars_in_regime + 1

// ─────────────────────────────────────────────────────────────────────────────────
// VISUALIZATION
// ─────────────────────────────────────────────────────────────────────────────────

// Reference lines
hline(expansion_threshold, "Expansion", color=color.new(c_expansion, 60), linestyle=hline.style_dashed)
hline(contraction_threshold, "Contraction", color=color.new(c_contraction, 60), linestyle=hline.style_dashed)
hline(extreme_threshold, "Extreme", color=color.new(c_extreme_expansion, 70), linestyle=hline.style_dotted)
hline(50, "Neutral", color=color.new(c_normal, 50), linestyle=hline.style_solid)

// Combined Score Line
color score_color = 
     regime_code == 4 ? c_extreme_expansion :
     regime_code == 3 ? c_expansion :
     regime_code == 2 ? c_contraction :
     regime_code == 1 ? c_extreme_contraction :
     c_normal

plot(combined_score, "Volatility Score", color=score_color, linewidth=3, style=plot.style_line)

// ATR Overlay (optional)
plot(show_atr_overlay ? atr_percentile : na, "ATR Percentile", 
     color=color.new(c_atr_line, 40), linewidth=2, style=plot.style_circles)

// Histogram
color hist_color = 
     regime_code == 4 ? color.new(c_extreme_expansion, 20) :
     regime_code == 3 ? color.new(c_expansion, 30) :
     regime_code == 2 ? color.new(c_contraction, 30) :
     regime_code == 1 ? color.new(c_extreme_contraction, 20) :
     color.new(c_normal, 50)

plot(show_histogram ? combined_score : na, "Histogram", 
     color=hist_color, style=plot.style_histogram, linewidth=6, histbase=50)

// Background Zones
bgcolor(show_regime_zones and regime_code == 4 ? color.new(c_extreme_expansion, 93) : na, title="Extreme Expansion Zone")
bgcolor(show_regime_zones and regime_code == 3 ? color.new(c_expansion, 95) : na, title="Expansion Zone")
bgcolor(show_regime_zones and regime_code == 2 ? color.new(c_contraction, 95) : na, title="Contraction Zone")
bgcolor(show_regime_zones and regime_code == 1 ? color.new(c_extreme_contraction, 93) : na, title="Extreme Contraction Zone")

// ─────────────────────────────────────────────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────────────────────────────────────────────

var table dashboard = table.new(position.top_right, 2, 12, bgcolor=color.new(c_dashboard_bg, 5), 
                                 border_width=2, border_color=color.new(c_dashboard_border, 30))

if barstate.islast
    // Header
    table.cell(dashboard, 0, 0, "AVM [JOAT]", text_color=c_expansion, text_size=size.normal, 
               bgcolor=color.new(c_dashboard_bg, 0))
    table.merge_cells(dashboard, 0, 0, 1, 0)
    
    // Current Regime
    table.cell(dashboard, 0, 1, "Regime", text_color=c_text, text_size=size.tiny)
    table.cell(dashboard, 1, 1, current_regime, text_color=score_color, text_size=size.tiny)
    
    // Combined Score
    table.cell(dashboard, 0, 2, "Score", text_color=c_text, text_size=size.tiny)
    table.cell(dashboard, 1, 2, str.tostring(combined_score, "#.#"), text_color=c_text, text_size=size.tiny)
    
    // BBWP
    table.cell(dashboard, 0, 3, "BBWP", text_color=c_text, text_size=size.tiny)
    table.cell(dashboard, 1, 3, str.tostring(bbwp_value, "#.#"), text_color=c_text, text_size=size.tiny)
    
    // ATR Percentile
    table.cell(dashboard, 0, 4, "ATR %", text_color=c_text, text_size=size.tiny)
    table.cell(dashboard, 1, 4, str.tostring(atr_percentile, "#.#"), text_color=c_atr_line, text_size=size.tiny)
    
    // Trend
    table.cell(dashboard, 0, 5, "Trend", text_color=c_text, text_size=size.tiny)
    table.cell(dashboard, 1, 5, vol_trend, 
               text_color=vol_trend == "Rising" ? c_expansion : c_contraction, text_size=size.tiny)
    
    // Bars in Regime
    table.cell(dashboard, 0, 6, "Duration", text_color=c_text, text_size=size.tiny)
    table.cell(dashboard, 1, 6, str.tostring(bars_in_regime) + " bars", text_color=c_text, text_size=size.tiny)

// ─────────────────────────────────────────────────────────────────────────────────
// ADVANCED FEATURES - REGIME TRANSITION PREDICTION
// ─────────────────────────────────────────────────────────────────────────────────

// Regime momentum (rate of change in volatility score)
float regime_momentum = combined_score - combined_score[5]
string momentum_direction = regime_momentum > 2 ? "Accelerating" : 
                           regime_momentum < -2 ? "Decelerating" : "Stable"

// Predict next regime based on momentum
string predicted_regime = regime_code == 4 and regime_momentum < -5 ? "→ Expansion" :
                         regime_code == 3 and regime_momentum < -3 ? "→ Normal" :
                         regime_code == 2 and regime_momentum > 3 ? "→ Normal" :
                         regime_code == 1 and regime_momentum > 5 ? "→ Contraction" :
                         "Stable"

// Transition probability (0-100%)
float transition_prob = math.min(math.abs(regime_momentum) * 10, 100)

// ─────────────────────────────────────────────────────────────────────────────────
// ADVANCED FEATURES - HISTORICAL REGIME STATISTICS
// ─────────────────────────────────────────────────────────────────────────────────

// Track regime history
var array<int> regime_history = array.new_int(0)
var array<int> regime_durations = array.new_int(0)

if regime_changed
    array.push(regime_history, regime_code)
    array.push(regime_durations, bars_in_regime)
    
    // Keep last 50 regimes
    if array.size(regime_history) > 50
        array.shift(regime_history)
        array.shift(regime_durations)

// Calculate regime statistics
int total_regimes = array.size(regime_history)
int expansion_count = 0
int contraction_count = 0
float avg_expansion_duration = 0.0
float avg_contraction_duration = 0.0

if total_regimes > 0
    float exp_sum = 0.0, float con_sum = 0.0
    int exp_cnt = 0, int con_cnt = 0
    
    for i = 0 to total_regimes - 1
        int r = array.get(regime_history, i)
        int d = array.get(regime_durations, i)
        
        if r >= 3  // Expansion regimes
            expansion_count += 1
            exp_sum += d
            exp_cnt += 1
        else if r <= 2  // Contraction regimes
            contraction_count += 1
            con_sum += d
            con_cnt += 1
    
    avg_expansion_duration := exp_cnt > 0 ? exp_sum / exp_cnt : 0
    avg_contraction_duration := con_cnt > 0 ? con_sum / con_cnt : 0

// Current regime vs average duration
float duration_ratio = regime_code >= 3 and avg_expansion_duration > 0 ? 
                       bars_in_regime / avg_expansion_duration :
                       regime_code <= 2 and avg_contraction_duration > 0 ?
                       bars_in_regime / avg_contraction_duration : 0

bool regime_extended = duration_ratio > 1.5

// ─────────────────────────────────────────────────────────────────────────────────
// ADVANCED FEATURES - VOLATILITY CLUSTERING DETECTION
// ─────────────────────────────────────────────────────────────────────────────────

// Detect volatility clusters (periods of sustained high/low volatility)
int cluster_lookback = 20
float cluster_threshold = 70.0

// Count high volatility bars in lookback
int high_vol_count = 0
for i = 0 to cluster_lookback - 1
    if combined_score[i] >= cluster_threshold
        high_vol_count += 1

float cluster_ratio = high_vol_count / cluster_lookback * 100
bool in_vol_cluster = cluster_ratio >= 60  // 60% of bars are high vol

// Cluster strength
string cluster_strength = cluster_ratio >= 80 ? "Strong" :
                         cluster_ratio >= 60 ? "Moderate" :
                         cluster_ratio >= 40 ? "Weak" : "None"

// ─────────────────────────────────────────────────────────────────────────────────
// ADVANCED FEATURES - REGIME-BASED ADAPTIVE COLORING
// ─────────────────────────────────────────────────────────────────────────────────

// Dynamic background intensity based on regime stability
float bg_intensity = regime_extended ? 85 : 93
color adaptive_bg = 
     regime_code == 4 ? color.new(c_extreme_expansion, bg_intensity) :
     regime_code == 3 ? color.new(c_expansion, bg_intensity + 2) :
     regime_code == 2 ? color.new(c_contraction, bg_intensity + 2) :
     regime_code == 1 ? color.new(c_extreme_contraction, bg_intensity) :
     na

bgcolor(show_regime_zones ? adaptive_bg : na, title="Adaptive Regime Zone")

// Regime transition warning
bool transition_warning = transition_prob >= 50
plotchar(transition_warning and barstate.isconfirmed ? combined_score : na, 
         "Transition Warning", "⚠", location.absolute, color.new(#ffeb3b, 0), size=size.tiny)

// ─────────────────────────────────────────────────────────────────────────────────
// ADVANCED FEATURES - BBWP PERCENTILE BANDS
// ─────────────────────────────────────────────────────────────────────────────────

// BBWP percentile levels (from VWAP Tension knowledge)
float bbwp_20th = ta.percentile_linear_interpolation(bbwp_value, bbwp_lookback, 20)
float bbwp_50th = ta.percentile_linear_interpolation(bbwp_value, bbwp_lookback, 50)
float bbwp_80th = ta.percentile_linear_interpolation(bbwp_value, bbwp_lookback, 80)

// Plot percentile bands
plot(bbwp_80th, "BBWP 80th", color=color.new(c_expansion, 70), linewidth=1, style=plot.style_circles)
plot(bbwp_50th, "BBWP 50th", color=color.new(c_normal, 70), linewidth=1, style=plot.style_circles)
plot(bbwp_20th, "BBWP 20th", color=color.new(c_contraction, 70), linewidth=1, style=plot.style_circles)

// ─────────────────────────────────────────────────────────────────────────────────
// ENHANCED DASHBOARD WITH ADVANCED METRICS
// ─────────────────────────────────────────────────────────────────────────────────

if barstate.islast
    // Regime momentum
    table.cell(dashboard, 0, 7, "Momentum", text_color=c_text, text_size=size.tiny)
    table.cell(dashboard, 1, 7, momentum_direction, 
               text_color=regime_momentum > 0 ? c_expansion : c_contraction, text_size=size.tiny)
    
    // Transition prediction
    if transition_prob >= 30
        table.cell(dashboard, 0, 8, "Transition", text_color=c_text, text_size=size.tiny)
        table.cell(dashboard, 1, 8, predicted_regime + " (" + str.tostring(transition_prob, "#") + "%)", 
                   text_color=#ffeb3b, text_size=size.tiny)
    
    // Volatility cluster
    if in_vol_cluster
        table.cell(dashboard, 0, 9, "Cluster", text_color=c_text, text_size=size.tiny)
        table.cell(dashboard, 1, 9, cluster_strength, text_color=c_extreme_expansion, text_size=size.tiny)
    
    // Duration vs average
    if duration_ratio > 0
        table.cell(dashboard, 0, 10, "Duration", text_color=c_text, text_size=size.tiny)
        string dur_text = str.tostring(duration_ratio, "#.#") + "x avg"
        table.cell(dashboard, 1, 10, dur_text, 
                   text_color=regime_extended ? #ffeb3b : c_text, text_size=size.tiny)
    
    // Historical stats
    if total_regimes > 10
        table.cell(dashboard, 0, 11, "History", text_color=c_text, text_size=size.tiny)
        string hist_text = "E:" + str.tostring(expansion_count) + " C:" + str.tostring(contraction_count)
        table.cell(dashboard, 1, 11, hist_text, text_color=c_text, text_size=size.tiny)

// ─────────────────────────────────────────────────────────────────────────────────
// ENHANCED ALERTS
// ─────────────────────────────────────────────────────────────────────────────────

alertcondition(regime_changed and regime_code == 4, "Extreme Expansion", "AVM: Entered extreme expansion regime")
alertcondition(regime_changed and regime_code == 1, "Extreme Contraction", "AVM: Entered extreme contraction regime")
alertcondition(ta.crossover(combined_score, expansion_threshold), "Expansion Threshold", "AVM: Volatility expanding")
alertcondition(ta.crossunder(combined_score, contraction_threshold), "Contraction Threshold", "AVM: Volatility contracting")
alertcondition(transition_warning and not transition_warning[1], "Regime Transition Warning", "AVM: Regime transition likely (50%+ probability)")
alertcondition(in_vol_cluster and not in_vol_cluster[1], "Volatility Cluster", "AVM: Entered volatility cluster")
alertcondition(regime_extended and not regime_extended[1], "Extended Regime", "AVM: Current regime duration 1.5x above average")

// ═══════════════════════════════════════════════════════════════════════════════════
// END OF ADAPTIVE VOLATILITY MATRIX
// ═══════════════════════════════════════════════════════════════════════════════════
