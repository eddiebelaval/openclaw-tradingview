//@version=6
indicator("Average Candle", overlay=true)

//--------- Inputs
tfSource   = input.timeframe("D",  "Timeframe pro vypocet")
barsCount  = input.int(20,         "Pocet sviccek", minval=1)
rangeType  = input.string("High-Low", "Typ volatility", options=["High-Low", "True Range"])

pipMode    = input.string("Auto",  "Velikost pipu", options=["Auto", "Manual"])
pipManual  = input.float(0.0001,   "Manualni pip", step=0.00001)

decimals   = input.int(1,          "Desetinna mista", minval=0, maxval=5)
showDetail = input.bool(true,      "Zobrazit timeframe a periodu")

cornerOpt  = input.string("Bottom Left", "Roh", options=["Bottom Left","Bottom Right","Top Left","Top Right"])
txtColor   = input.color(color.yellow,   "Barva pisma") // <-- oprava: gold neexistuje
txtSizeOpt = input.string("Normal",      "Velikost pisma", options=["Tiny","Small","Normal","Large","Huge"])
bgColor    = input.color(color.new(color.black, 85), "Pozadi")

//--------- Helpers
f_pos(string c) =>
    switch c
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Right" => position.bottom_right
        => position.bottom_left

f_size(string s) =>
    switch s
        "Tiny"  => size.tiny
        "Small" => size.small
        "Large" => size.large
        "Huge"  => size.huge
        => size.normal

f_pipAuto() =>
    bool isForex = syminfo.type == "forex"
    // "fractional pip" (5-digit/3-digit) detekce pres mintick
    bool fractional = isForex and (syminfo.mintick == 0.00001 or syminfo.mintick == 0.001)
    float pip = isForex ? (fractional ? syminfo.mintick * 10.0 : syminfo.mintick) : syminfo.mintick
    pip

pipSize = pipMode == "Auto" ? f_pipAuto() : pipManual

//--------- Core (MTF average range)
avgRange = request.security(
     syminfo.tickerid,
     tfSource,
     rangeType == "High-Low" ? ta.sma(high - low, barsCount) : ta.sma(ta.tr(true), barsCount),
     barmerge.gaps_off,
     barmerge.lookahead_off
)

valid = not na(avgRange) and (pipSize > 0)
pips  = valid ? (avgRange / pipSize) : na

pow10 = math.pow(10.0, float(decimals))
pipsRounded = valid ? (math.round(pips * pow10) / pow10) : na

valueStr = valid ? str.tostring(pipsRounded) : "n/a"
textStr  = showDetail
     ? str.format("Average Candle ({0}, {1}): {2} pips", tfSource, barsCount, valueStr)
     : str.format("{0} pips", valueStr)

//--------- Display
var table t = table.new(f_pos(cornerOpt), 1, 1, bgcolor=bgColor)

if barstate.islast
    table.cell(
         t, 0, 0, textStr,
         text_color=txtColor,
         text_size=f_size(txtSizeOpt),
         text_halign=text.align_left,
         text_valign=text.align_bottom,
         bgcolor=bgColor
    )
