string syncMode         = input.string("Live HTF", "HTF sync mode", options=["Confirmed HTF", "Live HTF"], group=G1, tooltip="Confirmed HTF = non-repainting HTF logic. Live HTF = evolving HTF bar, more reactive but can repaint on reload.")
