float  zCap          = input.float(2.5,  "Z-score cap",          minval=0.5, step=0.1, group=GS)
float  shockCap      = input.float(2.5,  "Shock cap",            minval=0.5, step=0.1, group=GS)
float  trendCap      = input.float(12.0, "Trend spread cap (%)", minval=1.0, step=0.5, group=GS)
float  wPct          = input.float(0.40, "Weight - percentile", minval=0.0, step=0.05, group=GS)
float  wZ            = input.float(0.25, "Weight - z-score",    minval=0.0, step=0.05, group=GS)
float  wShock        = input.float(0.20, "Weight - shock",      minval=0.0, step=0.05, group=GS)
float  wTrend        = input.float(0.15, "Weight - trend",      minval=0.0, step=0.05, group=GS)

// Gate
string GG = "11) Gate Logic"
bool  useGate            = input.bool(true,  "Enable gate", group=GG)
float singleLaneFearThr  = input.float(65.0, "Single-lane fear threshold", step=0.5, group=GG)
float termLayerThr       = input.float(61.0, "Term pressure threshold", step=0.5, group=GG)
float contagionLayerThr  = input.float(62.0, "Contagion pressure threshold", step=0.5, group=GG)
float tailLayerThr       = input.float(60.0, "Tail pressure threshold", step=0.5, group=GG)
float compositeFearThr   = input.float(63.0, "Composite threshold", step=0.5, group=GG)
float breadthThr         = input.float(0.33, "Breadth threshold", minval=0.0, maxval=1.0, step=0.05, group=GG)
int   requiredHotLayersI = input.int(2, "Required hot layers", minval=1, maxval=3, group=GG)
int   minActiveLanes     = input.int(8, "Min selected active lanes", minval=1, maxval=30, group=GG)
float layerWTerm         = input.float(0.45, "Composite weight - Term",      minval=0.0, step=0.05, group=GG)
float layerWContagion    = input.float(0.35, "Composite weight - Contagion", minval=0.0, step=0.05, group=GG)
float layerWTail         = input.float(0.20, "Composite weight - Tail",      minval=0.0, step=0.05, group=GG)

// Direction / colors
string GD = "12) Direction / Colors"
string dirLocalMode   = input.string("Price+OBV+CVD", "Local direction source", options=["Price","OBV","CVD","Price+OBV","Price+CVD","OBV+CVD","Price+OBV+CVD"], group=GD)
string dirRegimeMode  = input.string("Blend", "Regime fusion", options=["None","Bias only","Confirm","Blend"], group=GD)
float  dirRegimeWeight = input.float(0.35, "Regime weight", minval=0.0, maxval=1.0, step=0.05, group=GD)
string flowBasisMode  = input.string("Series+Delta", "OBV/CVD basis", options=["Series","Delta","Series+Delta"], group=GD)
string flowNormMode   = input.string("ZScore->Tanh", "Flow normalization", options=["ZScore->Tanh","MinMax"], group=GD)
int    flowNormLen    = input.int(120, "Flow norm len", minval=20, group=GD)
bool   pseudoVol      = input.bool(true, "Pseudo-volume when volume is missing", group=GD)
string slotColorMode  = input.string("Hybrid", "Heatmap color mode", options=["Signed Direction","Cluster Heat","Hybrid"], group=GD)
string signedPalette  = input.string("Teal/Red", "Directional palette", options=["Classic","Teal/Red","Blue/Orange","Monochrome"], group=GD)
float  dirNeutralBand = input.float(0.08, "Neutral band", minval=0.0, maxval=0.5, step=0.01, group=GD)

// Pressure / overlay
string GP = "13) Pressure / Overlay"
bool   pressureOverlayOn    = input.bool(true,  "Show overlay pressure", group=GP)
string pressureZoneStyle    = input.string("Boxes+Tint", "Zone style", options=["Boxes","Tint","Boxes+Tint"], group=GP)
bool   pressureTintCandles  = input.bool(true,  "Tint candles by pressure", group=GP)
bool   pressureCurvesOn     = input.bool(true,  "Draw pressure curves", group=GP)
bool   pressureFlipArrowsOn = input.bool(false, "Entry arrows", group=GP)
string pressurePolMode      = input.string("Auto", "Risk polarity", options=["Auto","Risk-Off Bearish","Risk-Off Bullish","Neutral"], group=GP)
float  pressureZoneMin      = input.float(20.0, "Min zone intensity", minval=5.0, maxval=50.0, step=1.0, group=GP, inline="z")
float  pressureAtrScale     = input.float(1.0, "Curve/box ATR scale", minval=0.2, maxval=3.0, step=0.1, group=GP, inline="z")
int    pressureCurveKeep    = input.int(420, "Max curve lines", minval=60, maxval=470, group=GP, inline="q1")
int    pressureBoxKeep      = input.int(220, "Max regime boxes", minval=20, maxval=400, group=GP, inline="q1")
int    pressureFlipKeep     = input.int(250, "Max entry arrows", minval=20, maxval=400, group=GP, inline="q2")

//──────────────────────────────────────────────────────────────────────────────
// CONSTANTS
//──────────────────────────────────────────────────────────────────────────────
const int SLOT_COUNT = 29
const int PAL_GATE   = 0
const int PAL_META   = 1
const int PAL_TERM   = 2
const int PAL_TAIL   = 3
const int PAL_EQ     = 4
const int PAL_RATES  = 5
const int PAL_CMDTY  = 6
const int PAL_CRYPTO = 7
const int PAL_CUSTOM = 8

const int CLS_EQIDX  = 0
const int CLS_CRYPTO = 1
const int CLS_CMDTY  = 2
const int CLS_FX     = 3
const int CLS_RATES  = 4
const int CLS_MIXED  = 5

//──────────────────────────────────────────────────────────────────────────────
// HELPERS (pure / unconditional)
//──────────────────────────────────────────────────────────────────────────────
f_clamp(float x, float lo, float hi) =>
    math.max(lo, math.min(hi, x))

f_norm(float x, float cap) =>
    50.0 + 50.0 * f_clamp(x / cap, -1.0, 1.0)

f_num(float x) =>
    na(x) ? "na" : str.tostring(math.round(x * 10.0) / 10.0)

f_hot(float s) =>
    not na(s) and s >= singleLaneFearThr ? 1 : 0

f_wavg2(float a, float wa, float b, float wb) =>
    float s = 0.0
    float w = 0.0
    if not na(a)
        s += a * wa
        w += wa
    if not na(b)
        s += b * wb
        w += wb
    w > 0 ? s / w : na

f_wavg3(float a, float wa, float b, float wb, float c, float wc) =>
    float s = 0.0
    float w = 0.0
    if not na(a)
        s += a * wa
        w += wa
    if not na(b)
        s += b * wb
        w += wb
    if not na(c)
        s += c * wc
        w += wc
    w > 0 ? s / w : na

f_tanh(float x) =>
    float xx = math.max(-10.0, math.min(10.0, x))
    float e2 = math.exp(2.0 * xx)
    (e2 - 1.0) / (e2 + 1.0)

f_signedUnit(float src, int len, string mode) =>
    float lo = ta.lowest(src, len)
    float hi = ta.highest(src, len)
    float mu = ta.sma(src, len)
    float sd = ta.stdev(src, len)
    float mm = hi > lo ? 2.0 * (src - lo) / (hi - lo) - 1.0 : 0.0
    float z  = na(sd) or sd == 0.0 ? 0.0 : (src - mu) / sd
    mode == "MinMax" ? f_clamp(mm, -1.0, 1.0) : f_clamp(f_tanh(z / 2.0), -1.0, 1.0)

f_pickLocalDir(string mode, float priceS, float obvS, float cvdS) =>
    mode == "Price"         ? priceS :  mode == "OBV"           ? obvS :  mode == "CVD"           ? cvdS :  mode == "Price+OBV"     ? 0.5 * (priceS + obvS) :  mode == "Price+CVD"     ? 0.5 * (priceS + cvdS) :  mode == "OBV+CVD"       ? 0.5 * (obvS + cvdS) :   (priceS + obvS + cvdS) / 3.0

f_ccyHaven(string c) =>
    c == "JPY" or c == "CHF" ? 1.00 :  c == "USD" ? 0.70 :  c == "EUR" ? 0.25 : 0.0

f_ccyRisk(string c) =>
    c == "AUD" or c == "NZD" or c == "CAD" or c == "NOK" or c == "SEK" ? 0.75 :  c == "MXN" or c == "ZAR" or c == "BRL" or c == "TRY" ? 1.00 : 0.0

f_first3(float a, float b, float c) =>
    not na(a) ? a : not na(b) ? b : c

f_first6(float a, float b, float c, float d, float e, float f) =>
    not na(a) ? a : not na(b) ? b : not na(c) ? c :  not na(d) ? d :   not na(e) ? e : f

f_applyInvert(float x, bool invert) =>
    na(x) ? na : invert ? 100.0 - x : x

f_clusterHeatColor(int pal, float s) =>
    color out = color.new(color.gray, 88)
    if pal == PAL_GATE
        out := na(s) ? color.new(color.gray, 88) : s >= 50 ? color.new(#ff2d55, 0) : color.new(#00c27a, 55)
    else
        color lo = pal == PAL_META   ? #2f3f57 :    pal == PAL_TERM   ? #102a6b :    pal == PAL_TAIL   ? #35145f :  pal == PAL_EQ     ? #0a4d45 :    pal == PAL_RATES  ? #243b7a :   pal == PAL_CMDTY  ? #4b5200 :   pal == PAL_CRYPTO ? #3a1a7d : #505050

        color mid = pal == PAL_META   ? #c7a300 :  pal == PAL_TERM   ? #00c8ff :    pal == PAL_TAIL   ? #b600ff :    pal == PAL_EQ     ? #00d6a5 :    pal == PAL_RATES  ? #63a1ff :    pal == PAL_CMDTY  ? #d9b400 :   pal == PAL_CRYPTO ? #9b39ff : #c4c4c4

        color hi = pal == PAL_META   ? #ff5a1f :  pal == PAL_TERM   ? #ff7b00 :     pal == PAL_TAIL   ? #ff3f81 :   pal == PAL_EQ     ? #ffb000 :    pal == PAL_RATES  ? #ff8b2a :   pal == PAL_CMDTY  ? #ff7a00 :     pal == PAL_CRYPTO ? #ff3d6e : #ff6b6b

        out := na(s) ? color.new(color.gray, 88) :    s < 50 ? color.from_gradient(s, 0, 50, color.new(lo, 55), color.new(mid, 10)) :  color.from_gradient(s, 50, 100, color.new(mid, 10), color.new(hi, 0))
    out

f_signedColor(float signed, float intensity) =>
    float mag = f_clamp(intensity * math.abs(signed) / 100.0, 0.0, 1.0) * 100.0
    bool bull = signed > dirNeutralBand
    bool bear = signed < -dirNeutralBand

    color bullLo = signedPalette == "Teal/Red"    ? color.new(color.teal, 60) :
                   signedPalette == "Blue/Orange" ? color.new(color.blue, 60) :
                   signedPalette == "Monochrome"  ? color.new(color.silver, 65) :
                                                     color.new(color.aqua, 60)

    color bullHi = signedPalette == "Teal/Red"    ? color.new(color.aqua, 0) :
                   signedPalette == "Blue/Orange" ? color.new(color.blue, 10) :
                   signedPalette == "Monochrome"  ? color.new(color.white, 10) :
                                                     color.new(color.aqua, 0)

    color bearLo = signedPalette == "Teal/Red"    ? color.new(color.maroon, 60) :
                   signedPalette == "Blue/Orange" ? color.new(color.orange, 60) :
                   signedPalette == "Monochrome"  ? color.new(color.gray, 65) :
                                                     color.new(color.red, 60)

    color bearHi = signedPalette == "Teal/Red"    ? color.new(color.red, 0) :
                   signedPalette == "Blue/Orange" ? color.new(color.orange, 0) :
                   signedPalette == "Monochrome"  ? color.new(color.black, 15) :
                                                     color.new(color.red, 0)

    bull ? color.from_gradient(mag, 0, 100, bullLo, bullHi) :  bear ? color.from_gradient(mag, 0, 100, bearLo, bearHi) :    color.new(color.gray, 82)

f_laneColor(int pal, float score, float signed) =>
    slotColorMode == "Cluster Heat" ? f_clusterHeatColor(pal, score) :  slotColorMode == "Signed Direction" ? f_signedColor(signed, nz(score, 50.0)) :    math.abs(signed) >= 0.18 ? f_signedColor(signed, nz(score, 50.0)) : f_clusterHeatColor(pal, score)

f_laneBg(int pal) =>
    pal == PAL_GATE   ? color.new(#2b2b2b, 35) :  pal == PAL_META   ? color.new(#4a566e, 45) :   pal == PAL_TERM   ? color.new(#19419a, 55) :   pal == PAL_TAIL   ? color.new(#6f1ca2, 55) :   pal == PAL_EQ     ? color.new(#0d6c61, 55) :   pal == PAL_RATES  ? color.new(#3557a5, 55) :    pal == PAL_CMDTY  ? color.new(#7a6210, 55) :   pal == PAL_CRYPTO ? color.new(#6b31a8, 55) :    color.new(#666666, 55)

f_pushLane(array<color> cols, array<string> txts, array<color> bgs, bool enabled, float score, string txt, int pal, float signed) =>
    if enabled
        array.push(cols, f_laneColor(pal, score, signed))
        array.push(txts, txt)
        array.push(bgs, f_laneBg(pal))
    0

f_hasSlot(array<color> cols, int idx) =>
    array.size(cols) > idx

f_slotColor(array<color> cols, int idx) =>
    array.size(cols) > idx ? array.get(cols, idx) : na

f_tblPos(string s) =>
    s == "Top Left"      ? position.top_left :  s == "Bottom Right"  ? position.bottom_right :  s == "Bottom Left"   ? position.bottom_left :   s == "Middle Right"  ? position.middle_right :  s == "Middle Left"   ? position.middle_left :   s == "Middle Center" ? position.middle_center :    position.top_right

f_tblTextSz(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal :    size.small

f_romanOnes(int d) =>
    d == 9 ? "IX" :  d == 8 ? "VIII" :  d == 7 ? "VII" :   d == 6 ? "VI" :   d == 5 ? "V" :  d == 4 ? "IV" :  d == 3 ? "III" :  d == 2 ? "II" :   d == 1 ? "I" : ""

f_roman(int n) =>
    int tens = int(math.floor(n / 10))
    string t = tens == 3 ? "XXX" : tens == 2 ? "XX" : tens == 1 ? "X" : ""
    n > 39 ? str.tostring(n) : t + f_romanOnes(n % 10)

f_fearTrendGlyph(float x) =>
    float d = x - nz(x[1], x)
    na(x) ? "·" : d > 0.25 ? "↑" : d < -0.25 ? "↓" : "→"

f_fearTrendColor(float x) =>
    float d = x - nz(x[1], x)
    na(x) ? color.gray : d > 0.25 ? color.red : d < -0.25 ? color.aqua : color.silver

f_dirTrendGlyph(float x) =>
    float d = x - nz(x[1], x)
    na(x) ? "·" : d > 0.02 ? "↑" : d < -0.02 ? "↓" : "→"

f_dirTrendColor(float x) =>
    float d = x - nz(x[1], x)
    na(x) ? color.gray : d > 0.02 ? color.aqua : d < -0.02 ? color.red : color.silver

f_fearState(float x) =>
    na(x) ? "NA" : x >= singleLaneFearThr ? "HOT" : x >= 50 ? "WARM" : "CALM"

f_dirState(float x) =>
    x > dirNeutralBand ? "BULL" : x < -dirNeutralBand ? "BEAR" : "NEUT"

f_stateBgFear(string st) =>
    st == "HOT"  ? color.new(color.red, 74) :  st == "WARM" ? color.new(color.orange, 78) :  st == "CALM" ? color.new(color.teal, 82) :   color.new(color.gray, 82)

f_stateBgDir(string st) =>
    st == "BULL" ? color.new(color.aqua, 74) :   st == "BEAR" ? color.new(color.red, 74) :    color.new(color.gray, 82)

f_resumeClear(table t, int cols, int rows) =>
    for rr = 0 to rows - 1
        for cc = 0 to cols - 1
            table.cell(t, cc, rr, "", bgcolor=color.new(color.black, 100), text_color=color.white, text_size=f_tblTextSz(resumeTblTextSz))
    0

f_pushResumeStatic(array<string> ids, array<string> names, array<string> vals, array<string> trends, array<color> trendCols, array<string> states, array<color> stateBgs, array<string> roles, array<color> chips, int idx, bool enabled, string name, string valueTxt, string trendTxt, color trendTc, string stateTxt, color stateBg, string roleTxt, color chipBg) =>
    int out = idx
    if enabled
        array.push(ids, showTableRoman ? f_roman(idx) : str.tostring(idx))
        array.push(names, name)
        array.push(vals, valueTxt)
        array.push(trends, trendTxt)
        array.push(trendCols, trendTc)
        array.push(states, stateTxt)
        array.push(stateBgs, stateBg)
        array.push(roles, roleTxt)
        array.push(chips, chipBg)
        out += 1
    out

f_pushResumeFear(array<string> ids, array<string> names, array<string> vals, array<string> trends, array<color> trendCols, array<string> states, array<color> stateBgs, array<string> roles, array<color> chips, int idx, bool enabled, string name, float score, int pal, string roleTxt, float signedRef) =>
    string g  = f_fearTrendGlyph(score)
    color gc  = f_fearTrendColor(score)
    string st = f_fearState(score)
    color sbg = f_stateBgFear(st)
    color chp = f_laneColor(pal, score, signedRef)
    f_pushResumeStatic(ids, names, vals, trends, trendCols, states, stateBgs, roles, chips, idx, enabled, name, f_num(score), g, gc, st, sbg, roleTxt, chp)

f_pushResumeDir(array<string> ids, array<string> names, array<string> vals, array<string> trends, array<color> trendCols, array<string> states, array<color> stateBgs, array<string> roles, array<color> chips, int idx, bool enabled, string name, float signedVal, float intensity, string roleTxt) =>
    string g  = f_dirTrendGlyph(signedVal)
    color gc  = f_dirTrendColor(signedVal)
    string st = f_dirState(signedVal)
    color sbg = f_stateBgDir(st)
    color chp = f_signedColor(signedVal, intensity)
    f_pushResumeStatic(ids, names, vals, trends, trendCols, states, stateBgs, roles, chips, idx, enabled, name, f_num(signedVal * 100.0), g, gc, st, sbg, roleTxt, chp)

f_autoTf(int cls, float chartSec) =>
    float outSec = 3600.0
    if cls == CLS_CRYPTO
        outSec := chartSec <= 300 ? 1800.0 : chartSec <= 3600 ? 14400.0 : chartSec <= 14400 ? 86400.0 : chartSec <= 86400 ? 604800.0 : 2592000.0
    else if cls == CLS_FX
        outSec := chartSec <= 300 ? 3600.0 : chartSec <= 3600 ? 14400.0 : chartSec <= 14400 ? 86400.0 : chartSec <= 86400 ? 604800.0 : 2592000.0
    else if cls == CLS_CMDTY
        outSec := chartSec <= 300 ? 3600.0 : chartSec <= 3600 ? 14400.0 : chartSec <= 14400 ? 86400.0 : chartSec <= 86400 ? 604800.0 : 2592000.0
    else if cls == CLS_RATES
        outSec := chartSec <= 300 ? 3600.0 : chartSec <= 3600 ? 14400.0 : chartSec <= 14400 ? 86400.0 : chartSec <= 86400 ? 604800.0 : 2592000.0
    else
        outSec := chartSec <= 300 ? 3600.0 : chartSec <= 3600 ? 14400.0 : chartSec <= 14400 ? 86400.0 : chartSec <= 86400 ? 604800.0 : 2592000.0
    timeframe.from_seconds(int(outSec))

f_tfNearFallback(string tfIn) =>
    float chartSecL = timeframe.in_seconds()
    chartSecL := na(chartSecL) or chartSecL <= 0 ? 60.0 : chartSecL
    float baseSec = timeframe.in_seconds(tfIn)
    baseSec := na(baseSec) or baseSec <= 0 ? chartSecL : baseSec
    float halfSec = math.max(chartSecL, math.floor(baseSec / 2.0))
    timeframe.from_seconds(int(halfSec))

f_autoFearFast(int cls, float sec) =>
    cls == CLS_CRYPTO ? (sec <= 1800 ? 8 : sec <= 14400 ? 13 : sec <= 86400 ? 21 : 34) :  cls == CLS_FX     ? (sec <= 3600 ? 13 : sec <= 14400 ? 21 : sec <= 86400 ? 34 : 55) :  cls == CLS_RATES  ? (sec <= 3600 ? 21 : sec <= 14400 ? 34 : sec <= 86400 ? 55 : 89) : cls == CLS_CMDTY  ? (sec <= 3600 ? 13 : sec <= 14400 ? 21 : sec <= 86400 ? 34 : 55) : (sec <= 3600 ? 13 : sec <= 14400 ? 21 : sec <= 86400 ? 34 : 55)

f_autoFearSlow(int cls, float sec) =>
    cls == CLS_CRYPTO ? (sec <= 1800 ? 34 : sec <= 14400 ? 55 : sec <= 86400 ? 89 : 144) : cls == CLS_FX     ? (sec <= 3600 ? 55 : sec <= 14400 ? 89 : sec <= 86400 ? 144 : 233) : cls == CLS_RATES  ? (sec <= 3600 ? 89 : sec <= 14400 ? 144 : sec <= 86400 ? 233 : 377) : cls == CLS_CMDTY  ? (sec <= 3600 ? 55 : sec <= 14400 ? 89 : sec <= 86400 ? 144 : 233) : (sec <= 3600 ? 55 : sec <= 14400 ? 89 : sec <= 86400 ? 144 : 233)

f_autoDirFast(int cls, float sec) =>
    cls == CLS_CRYPTO ? (sec <= 300 ? 8 : sec <= 3600 ? 13 : sec <= 14400 ? 21 : 34) : cls == CLS_FX     ? (sec <= 300 ? 13 : sec <= 3600 ? 21 : sec <= 14400 ? 34 : 55) : cls == CLS_RATES  ? (sec <= 300 ? 21 : sec <= 3600 ? 34 : sec <= 14400 ? 55 : 89) : cls == CLS_CMDTY  ? (sec <= 300 ? 13 : sec <= 3600 ? 21 : sec <= 14400 ? 34 : 55) :   (sec <= 300 ? 13 : sec <= 3600 ? 21 : sec <= 14400 ? 34 : 55)

f_autoDirSlow(int cls, float sec) =>
    cls == CLS_CRYPTO ? (sec <= 300 ? 34 : sec <= 3600 ? 55 : sec <= 14400 ? 89 : 144) : cls == CLS_FX     ? (sec <= 300 ? 55 : sec <= 3600 ? 89 : sec <= 14400 ? 144 : 233) : cls == CLS_RATES  ? (sec <= 300 ? 89 : sec <= 3600 ? 144 : sec <= 14400 ? 233 : 377) : cls == CLS_CMDTY  ? (sec <= 300 ? 55 : sec <= 3600 ? 89 : sec <= 14400 ? 144 : 233) : (sec <= 300 ? 55 : sec <= 3600 ? 89 : sec <= 14400 ? 144 : 233)

f_autoDirBasis(int cls, float sec) =>
    cls == CLS_CRYPTO ? (sec <= 300 ? 21 : sec <= 3600 ? 21 : sec <= 14400 ? 34 : 55) : cls == CLS_FX     ? (sec <= 300 ? 21 : sec <= 3600 ? 34 : sec <= 14400 ? 55 : 89) : cls == CLS_RATES  ? (sec <= 300 ? 34 : sec <= 3600 ? 55 : sec <= 14400 ? 89 : 144) : cls == CLS_CMDTY  ? (sec <= 300 ? 21 : sec <= 3600 ? 34 : sec <= 14400 ? 55 : 89) :     (sec <= 300 ? 21 : sec <= 3600 ? 34 : sec <= 14400 ? 55 : 89)

f_autoDirMom(int cls, float sec) =>
    cls == CLS_CRYPTO ? (sec <= 300 ? 4 : sec <= 3600 ? 6 : sec <= 14400 ? 8 : 10) : cls == CLS_FX     ? (sec <= 300 ? 6 : sec <= 3600 ? 8 : sec <= 14400 ? 10 : 12) : cls == CLS_RATES  ? (sec <= 300 ? 8 : sec <= 3600 ? 10 : sec <= 14400 ? 12 : 16) : cls == CLS_CMDTY  ? (sec <= 300 ? 6 : sec <= 3600 ? 8 : sec <= 14400 ? 10 : 12) :  (sec <= 300 ? 6 : sec <= 3600 ? 8 : sec <= 14400 ? 10 : 12)

f_autoDirAtr(int cls, float sec) =>
    cls == CLS_CRYPTO ? (sec <= 300 ? 10 : sec <= 3600 ? 12 : sec <= 14400 ? 14 : 21) : cls == CLS_FX     ? (sec <= 300 ? 14 : sec <= 3600 ? 14 : sec <= 14400 ? 21 : 21) : cls == CLS_RATES  ? (sec <= 300 ? 14 : sec <= 3600 ? 21 : sec <= 14400 ? 21 : 34) : cls == CLS_CMDTY  ? (sec <= 300 ? 12 : sec <= 3600 ? 14 : sec <= 14400 ? 14 : 21) : (sec <= 300 ? 12 : sec <= 3600 ? 14 : sec <= 14400 ? 14 : 21)

f_autoDirSmooth(int cls, float sec) =>
    cls == CLS_CRYPTO ? (sec <= 3600 ? 2 : 3) : cls == CLS_FX     ? (sec <= 3600 ? 3 : 4) : cls == CLS_RATES  ? (sec <= 3600 ? 4 : 5) : cls == CLS_CMDTY  ? (sec <= 3600 ? 3 : 4) : (sec <= 3600 ? 3 : 4)


f_trimLineQ(array<line> q, int keepMax) =>
    while array.size(q) > keepMax
        line.delete(array.shift(q))
    0

f_trimBoxQ(array<box> q, int keepMax) =>
    while array.size(q) > keepMax
        box.delete(array.shift(q))
    0

f_trimLabelQ(array<label> q, int keepMax) =>
    while array.size(q) > keepMax
        label.delete(array.shift(q))
    0

f_updSeg(line lastLn, bool doDraw, float y1, float y2, color col, int width, array<line> q, int keepMax) =>
    line out = lastLn
    if not doDraw and barstate.isnew
        out := na
    if doDraw and bar_index > 0 and not na(y1) and not na(y2)
        if barstate.isnew or na(out)
            out := line.new(x1=bar_index - 1, y1=y1, x2=bar_index, y2=y2, xloc=xloc.bar_index, extend=extend.none, color=col, width=width, force_overlay=true)
            array.push(q, out)
            f_trimLineQ(q, keepMax)
        else
            line.set_xy1(out, bar_index - 1, y1)
            line.set_xy2(out, bar_index, y2)
            line.set_color(out, col)
            line.set_width(out, width)
    out

//──────────────────────────────────────────────────────────────────────────────
// CLASSIFICATION
//──────────────────────────────────────────────────────────────────────────────
string typeU  = syminfo.type
string tickU  = str.upper(syminfo.ticker)
string descU  = str.upper(syminfo.description)
string rootU  = str.upper(syminfo.root)
string baseU  = str.upper(syminfo.basecurrency)
string quoteU = str.upper(syminfo.currency)

bool isYieldLike = str.contains(tickU, "US02Y") or str.contains(tickU, "US05Y") or str.contains(tickU, "US10Y") or str.contains(tickU, "US30Y") or str.contains(descU, "YIELD")
bool tokenBTC    = str.contains(tickU, "BTC") or str.contains(descU, "BITCOIN") or baseU == "BTC" or rootU == "BTC"
bool tokenETH    = str.contains(tickU, "ETH") or str.contains(descU, "ETHEREUM") or baseU == "ETH" or rootU == "ETH"
bool isCryptoLike= typeU == "crypto" or tokenBTC or tokenETH

bool isGoldLike  = str.contains(tickU, "XAU") or str.contains(descU, "GOLD") or rootU == "GC"
bool isSilverLike= str.contains(tickU, "XAG") or str.contains(descU, "SILVER") or rootU == "SI"
bool isOilLike   = str.contains(tickU, "OIL") or str.contains(tickU, "WTI") or str.contains(tickU, "BRENT") or str.contains(descU, "CRUDE") or str.contains(descU, "BRENT") or rootU == "CL" or rootU == "BRN"

bool isFXLike = typeU == "forex" or str.contains(tickU, "EURUSD") or str.contains(tickU, "USDJPY") or str.contains(tickU, "GBPUSD") or str.contains(tickU, "AUDUSD") or str.contains(tickU, "USDCAD") or str.contains(tickU, "USDCHF") or str.contains(tickU, "NZDUSD") or tickU == "DXY" or str.contains(descU, "DOLLAR INDEX") or rootU == "6E" or rootU == "6J" or rootU == "6B" or rootU == "6A" or rootU == "6C" or rootU == "DX"

bool isRatesLike = typeU == "bond" or rootU == "ZN" or rootU == "ZB" or rootU == "ZF" or rootU == "ZT" or rootU == "UB" or str.contains(descU, "TREASURY") or str.contains(descU, "BUND") or str.contains(descU, "NOTE") or str.contains(descU, "YIELD")

bool isIndexLike = typeU == "index" or typeU == "stock" or typeU == "fund" or typeU == "dr" or typeU == "warrant" or typeU == "structured" or typeU == "right" or str.contains(tickU, "US500") or str.contains(tickU, "SPX") or str.contains(tickU, "NAS100") or str.contains(tickU, "NDX") or str.contains(tickU, "US30") or str.contains(tickU, "DJI") or str.contains(tickU, "GER40") or str.contains(tickU, "DAX") or str.contains(tickU, "UK100") or str.contains(tickU, "JP225") or str.contains(tickU, "EU50") or rootU == "ES" or rootU == "NQ" or rootU == "YM" or rootU == "RTY"

bool isCommodityLike = (typeU == "futures" or typeU == "cfd") and not isCryptoLike and not isFXLike and not isRatesLike and (isGoldLike or isSilverLike or isOilLike or str.contains(descU, "COMMOD") or str.contains(descU, "NATGAS") or rootU == "NG" or rootU == "HG" or rootU == "PL")

int assetClassAuto = isCryptoLike ? CLS_CRYPTO : isCommodityLike ? CLS_CMDTY : isFXLike ? CLS_FX : isRatesLike ? CLS_RATES : isIndexLike ? CLS_EQIDX : CLS_MIXED
int assetClass = assetProfileMode == "Auto" ? assetClassAuto : assetProfileMode == "Index/Equity" ? CLS_EQIDX : assetProfileMode == "Crypto" ? CLS_CRYPTO : assetProfileMode == "Commodity" ? CLS_CMDTY : assetProfileMode == "Forex" ? CLS_FX : assetProfileMode == "Rates" ? CLS_RATES : CLS_MIXED
string assetName = assetClass == CLS_CRYPTO ? "Crypto" : assetClass == CLS_CMDTY ? "Commodity" : assetClass == CLS_FX ? "Forex" : assetClass == CLS_RATES ? "Rates" : assetClass == CLS_EQIDX ? "Index/Equity" : "Mixed"
bool commodityGeneric = assetClass == CLS_CMDTY and not isOilLike and not isGoldLike and not isSilverLike

//──────────────────────────────────────────────────────────────────────────────
// EFFECTIVE UNIVERSE + TF ENGINE + ADAPTIVE LENGTHS
//──────────────────────────────────────────────────────────────────────────────
bool isManualUniverse = universeMode == "Manual"

bool enVIX1D = isManualUniverse ? useVIX1D : (assetClass == CLS_EQIDX or assetClass == CLS_RATES)
bool enVIX9D = isManualUniverse ? useVIX9D : (assetClass == CLS_EQIDX or assetClass == CLS_CRYPTO or assetClass == CLS_MIXED)
bool enVIX   = isManualUniverse ? useVIX   : true
bool enVIX3M = isManualUniverse ? useVIX3M : true
bool enVIX6M = isManualUniverse ? useVIX6M : (assetClass == CLS_RATES)
bool enVIX1Y = isManualUniverse ? useVIX1Y : false

bool enVVIX  = isManualUniverse ? useVVIX : (assetClass == CLS_EQIDX or assetClass == CLS_CRYPTO or assetClass == CLS_CMDTY or assetClass == CLS_RATES or assetClass == CLS_MIXED)
bool enSKEW  = isManualUniverse ? useSKEW : (assetClass == CLS_EQIDX or assetClass == CLS_RATES or assetClass == CLS_MIXED)

bool enVXN   = isManualUniverse ? useVXN : (assetClass == CLS_EQIDX or assetClass == CLS_MIXED)
bool enRVX   = isManualUniverse ? useRVX : false
bool enVXD   = isManualUniverse ? useVXD : false

bool enMOVE  = isManualUniverse ? useMOVE  : true
bool enVXTLT = isManualUniverse ? useVXTLT : (assetClass == CLS_FX or assetClass == CLS_RATES)

bool enOVX   = isManualUniverse ? useOVX   : (assetClass == CLS_CMDTY and (isOilLike or commodityGeneric))
bool enGVZ   = isManualUniverse ? useGVZ   : (assetClass == CLS_CMDTY and (isGoldLike or commodityGeneric))
bool enVXSLV = isManualUniverse ? useVXSLV : (assetClass == CLS_CMDTY and (isSilverLike or commodityGeneric))

bool enDVOL    = isManualUniverse ? useDVOL    : (assetClass == CLS_CRYPTO)
bool enETHDVOL = isManualUniverse ? useETHDVOL : (assetClass == CLS_CRYPTO)
bool enBVIV    = isManualUniverse ? useBVIV    : (assetClass == CLS_CRYPTO)
bool enEVIV    = isManualUniverse ? useEVIV    : (assetClass == CLS_CRYPTO)

bool enCustom1 = useCustom1
bool enCustom2 = useCustom2

float chartSecRaw = timeframe.in_seconds()
float chartSec    = na(chartSecRaw) or chartSecRaw <= 0 ? 60.0 : chartSecRaw

string autoFearTF     = f_autoTf(assetClass, chartSec)
string selectedFearTF = tfMode == "Manual" ? manualFearTF : autoFearTF

float selectedFearSecRaw = timeframe.in_seconds(selectedFearTF)
float selectedFearSec    = na(selectedFearSecRaw) or selectedFearSecRaw <= 0 ? chartSec : selectedFearSecRaw

bool tfClamped = selectedFearSec < chartSec
string effectiveFearTF = tfClamped ? timeframe.from_seconds(int(chartSec)) : selectedFearTF
string nearFearTF      = f_tfNearFallback(effectiveFearTF)
bool confirmedHTFMode  = syncMode == "Confirmed HTF"

int fearFastLen = f_autoFearFast(assetClass, selectedFearSec)
int fearSlowLen = f_autoFearSlow(assetClass, selectedFearSec)
int dirFastLen  = f_autoDirFast(assetClass, chartSec)
int dirSlowLen  = f_autoDirSlow(assetClass, chartSec)
int dirBasisLen = f_autoDirBasis(assetClass, chartSec)
int dirMomLen   = f_autoDirMom(assetClass, chartSec)
int dirAtrLen   = f_autoDirAtr(assetClass, chartSec)
int dirSmoothLen= f_autoDirSmooth(assetClass, chartSec)

int barsNeeded = pctLookback + zLookback + shockLookback + fearSlowLen + 150

//──────────────────────────────────────────────────────────────────────────────
// FEAR SCORE CORE + RAW REQUESTS (all unconditional)
//──────────────────────────────────────────────────────────────────────────────
f_scoreCore(float x) =>
    float pct = ta.percentrank(x, pctLookback)
    float muZ = ta.sma(x, zLookback)
    float sdZ = ta.stdev(x, zLookback)
    float z   = na(x) or na(sdZ) or sdZ == 0.0 ? 0.0 : (x - muZ) / sdZ
    float shockRaw = ta.roc(x, 1)
    float muS = ta.sma(shockRaw, shockLookback)
    float sdS = ta.stdev(shockRaw, shockLookback)
    float shockZ = na(shockRaw) or na(sdS) or sdS == 0.0 ? 0.0 : (shockRaw - muS) / sdS
    float fast =  fearFastLen == 5  ? ta.ema(x, 5)  :  fearFastLen == 8  ? ta.ema(x, 8)  :   fearFastLen == 13 ? ta.ema(x, 13) :  fearFastLen == 21 ? ta.ema(x, 21) :   ta.ema(x, 34)

    float slow =  fearSlowLen == 21 ? ta.ema(x, 21) :  fearSlowLen == 34 ? ta.ema(x, 34) :   fearSlowLen == 55 ? ta.ema(x, 55) :  fearSlowLen == 89 ? ta.ema(x, 89) :  ta.ema(x, 144)
 
    float trend = na(fast) or na(slow) or slow == 0.0 ? 0.0 : ((fast - slow) / math.abs(slow)) * 100.0
    float pctN   = na(pct) ? 50.0 : pct
    float zN     = f_norm(z, zCap)
    float shockN = f_norm(shockZ, shockCap)
    float trendN = f_norm(trend, trendCap)
    float wSum = math.max(wPct + wZ + wShock + wTrend, 0.0001)
    float out  = (wPct * pctN + wZ * zN + wShock * shockN + wTrend * trendN) / wSum
    na(x) ? na : out

f_fetchRawScore(string sym, string reqTf, bool confirmedMode) =>
    float chartSecL = timeframe.in_seconds()
    chartSecL := na(chartSecL) or chartSecL <= 0 ? 60.0 : chartSecL
    float reqSecL = timeframe.in_seconds(reqTf)
    reqSecL := na(reqSecL) or reqSecL <= 0 ? chartSecL : reqSecL
    bool isHTF = reqSecL > chartSecL
    float raw = na

    if confirmedMode and isHTF
        raw := request.security(sym,reqTf,f_scoreCore(close[1]),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_on,ignore_invalid_symbol=true,calc_bars_count=800)
    else
        raw := request.security(sym,reqTf,f_scoreCore(close),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true,calc_bars_count=800)
    raw

// Base raw requests
float rawVIX1D_tf0    = f_fetchRawScore("CBOE:VIX1D",      effectiveFearTF, confirmedHTFMode)
float rawVIX9D_tf0    = f_fetchRawScore("CBOE:VIX9D",      effectiveFearTF, confirmedHTFMode)
float rawVIX3M_tf0    = f_fetchRawScore("CBOE:VIX3M",      effectiveFearTF, confirmedHTFMode)
float rawVIX6M_tf0    = f_fetchRawScore("CBOE:VIX6M",      effectiveFearTF, confirmedHTFMode)
float rawVIX1Y_tf0    = f_fetchRawScore("CBOE:VIX1Y",      effectiveFearTF, confirmedHTFMode)
float rawVVIX_tf0     = f_fetchRawScore("CBOE:VVIX",       effectiveFearTF, confirmedHTFMode)
float rawSKEW_tf0     = f_fetchRawScore("CBOE:SKEW",       effectiveFearTF, confirmedHTFMode)
float rawVXN_tf0      = f_fetchRawScore("CBOE:VXN",        effectiveFearTF, confirmedHTFMode)
float rawRVX_tf0      = f_fetchRawScore("CBOE:RVX",        effectiveFearTF, confirmedHTFMode)
float rawVXD_tf0      = f_fetchRawScore("CBOE:VXD",        effectiveFearTF, confirmedHTFMode)
float rawMOVE_tf0     = f_fetchRawScore("TVC:MOVE",        effectiveFearTF, confirmedHTFMode)
float rawVXTLT_tf0    = f_fetchRawScore("CBOE:VXTLT",      effectiveFearTF, confirmedHTFMode)
float rawOVX_tf0      = f_fetchRawScore("CBOE:OVX",        effectiveFearTF, confirmedHTFMode)
float rawGVZ_tf0      = f_fetchRawScore("CBOE:GVZ",        effectiveFearTF, confirmedHTFMode)
float rawVXSLV_tf0    = f_fetchRawScore("CBOE:VXSLV",      effectiveFearTF, confirmedHTFMode)
float rawDVOL_tf0     = f_fetchRawScore("DERIBIT:DVOL",    effectiveFearTF, confirmedHTFMode)
float rawETHDVOL_tf0  = f_fetchRawScore("DERIBIT:ETHDVOL", effectiveFearTF, confirmedHTFMode)
float rawBVIV_tf0     = f_fetchRawScore("VOLMEX:BVIV",     effectiveFearTF, confirmedHTFMode)
float rawEVIV_tf0     = f_fetchRawScore("VOLMEX:EVIV",     effectiveFearTF, confirmedHTFMode)

// Smart alias / fallback raw requests (unconditional)
float rawCboeVIX_tf0  = f_fetchRawScore("CBOE:VIX", effectiveFearTF, confirmedHTFMode)
float rawTvcVIX_tf0   = f_fetchRawScore("TVC:VIX",  effectiveFearTF, confirmedHTFMode)
float rawCboeVIX_near = f_fetchRawScore("CBOE:VIX", nearFearTF,      confirmedHTFMode)
float rawTvcVIX_near  = f_fetchRawScore("TVC:VIX",  nearFearTF,      confirmedHTFMode)
float rawCboeVIX_d    = f_fetchRawScore("CBOE:VIX", "1D",            confirmedHTFMode)
float rawTvcVIX_d     = f_fetchRawScore("TVC:VIX",  "1D",            confirmedHTFMode)

float rawTvcDXY_tf0   = f_fetchRawScore("TVC:DXY",   effectiveFearTF, confirmedHTFMode)
float rawIceDXY_tf0   = f_fetchRawScore("ICEUS:DXY", effectiveFearTF, confirmedHTFMode)
float rawTvcDXY_near  = f_fetchRawScore("TVC:DXY",   nearFearTF,      confirmedHTFMode)
float rawIceDXY_near  = f_fetchRawScore("ICEUS:DXY", nearFearTF,      confirmedHTFMode)
float rawTvcDXY_d     = f_fetchRawScore("TVC:DXY",   "1D",            confirmedHTFMode)
float rawIceDXY_d     = f_fetchRawScore("ICEUS:DXY", "1D",            confirmedHTFMode)

float rawCustom1_tf0  = f_fetchRawScore(custom1Sym, effectiveFearTF, confirmedHTFMode)
float rawCustom1_near = f_fetchRawScore(custom1Sym, nearFearTF,      confirmedHTFMode)
float rawCustom1_d    = f_fetchRawScore(custom1Sym, "1D",            confirmedHTFMode)
float rawCustom2_tf0  = f_fetchRawScore(custom2Sym, effectiveFearTF, confirmedHTFMode)
float rawCustom2_near = f_fetchRawScore(custom2Sym, nearFearTF,      confirmedHTFMode)
float rawCustom2_d    = f_fetchRawScore(custom2Sym, "1D",            confirmedHTFMode)

float rawVIXSmart = f_first6(rawCboeVIX_tf0, rawTvcVIX_tf0, rawCboeVIX_near, rawTvcVIX_near, rawCboeVIX_d, rawTvcVIX_d)
float rawDXYSmart = f_first6(rawTvcDXY_tf0, rawIceDXY_tf0, rawTvcDXY_near, rawIceDXY_near, rawTvcDXY_d, rawIceDXY_d)

bool custom1IsDxy = str.contains(str.upper(custom1Sym), "DXY")
bool custom2IsDxy = str.contains(str.upper(custom2Sym), "DXY")
bool custom1IsVix = str.contains(str.upper(custom1Sym), "VIX")
bool custom2IsVix = str.contains(str.upper(custom2Sym), "VIX")

float rawCustom1Smart = custom1IsDxy ? rawDXYSmart : custom1IsVix ? rawVIXSmart : f_first3(rawCustom1_tf0, rawCustom1_near, rawCustom1_d)
float rawCustom2Smart = custom2IsDxy ? rawDXYSmart : custom2IsVix ? rawVIXSmart : f_first3(rawCustom2_tf0, rawCustom2_near, rawCustom2_d)

// Apply enable/invert masks (no conditional request calls here)
float scVIX1D   = enVIX1D   ? rawVIX1D_tf0   : na
float scVIX9D   = enVIX9D   ? rawVIX9D_tf0   : na
float scVIX     = enVIX     ? rawVIXSmart    : na
float scVIX3M   = enVIX3M   ? rawVIX3M_tf0   : na
float scVIX6M   = enVIX6M   ? rawVIX6M_tf0   : na
float scVIX1Y   = enVIX1Y   ? rawVIX1Y_tf0   : na
float scVVIX    = enVVIX    ? rawVVIX_tf0    : na
float scSKEW    = enSKEW    ? rawSKEW_tf0    : na
float scVXN     = enVXN     ? rawVXN_tf0     : na
float scRVX     = enRVX     ? rawRVX_tf0     : na
float scVXD     = enVXD     ? rawVXD_tf0     : na
float scMOVE    = enMOVE    ? rawMOVE_tf0    : na
float scVXTLT   = enVXTLT   ? rawVXTLT_tf0   : na
float scOVX     = enOVX     ? rawOVX_tf0     : na
float scGVZ     = enGVZ     ? rawGVZ_tf0     : na
float scVXSLV   = enVXSLV   ? rawVXSLV_tf0   : na
float scDVOL    = enDVOL    ? rawDVOL_tf0    : na
float scETHDVOL = enETHDVOL ? rawETHDVOL_tf0 : na
float scBVIV    = enBVIV    ? rawBVIV_tf0    : na
float scEVIV    = enEVIV    ? rawEVIV_tf0    : na
float scCustom1 = enCustom1 ? f_applyInvert(rawCustom1Smart, custom1Invert) : na
float scCustom2 = enCustom2 ? f_applyInvert(rawCustom2Smart, custom2Invert) : na

string nmC1 = custom1Name == "" ? "Custom 1" : custom1Name
string nmC2 = custom2Name == "" ? "Custom 2" : custom2Name

//──────────────────────────────────────────────────────────────────────────────
// META-LANES
//──────────────────────────────────────────────────────────────────────────────
float frontSum = 0.0
float frontW   = 0.0
if enVIX1D and not na(scVIX1D)
    frontSum += scVIX1D * 1.25
    frontW   += 1.25
if enVIX9D and not na(scVIX9D)
    frontSum += scVIX9D * 1.15
    frontW   += 1.15
if enVIX and not na(scVIX)
    frontSum += scVIX * 1.00
    frontW   += 1.00
float frontStress = frontW > 0 ? frontSum / frontW : na

float backSum = 0.0
float backW   = 0.0
if enVIX3M and not na(scVIX3M)
    backSum += scVIX3M * 1.00
    backW   += 1.00
if enVIX6M and not na(scVIX6M)
    backSum += scVIX6M * 0.85
    backW   += 0.85
if enVIX1Y and not na(scVIX1Y)
    backSum += scVIX1Y * 0.70
    backW   += 0.70
float backStress = backW > 0 ? backSum / backW : na

float curveStress = not na(frontStress) and not na(backStress) ? 50.0 + 50.0 * f_clamp((frontStress - backStress) / 18.0, -1.0, 1.0) : na

float termBaseSum = 0.0
float termBaseW   = 0.0
int   termActive  = 0
int   termHotN    = 0
if enVIX1D and not na(scVIX1D)
    termBaseSum += scVIX1D * 1.25
    termBaseW   += 1.25
    termActive  += 1
    termHotN    += f_hot(scVIX1D)
if enVIX9D and not na(scVIX9D)
    termBaseSum += scVIX9D * 1.15
    termBaseW   += 1.15
    termActive  += 1
    termHotN    += f_hot(scVIX9D)
if enVIX and not na(scVIX)
    termBaseSum += scVIX * 1.00
    termBaseW   += 1.00
    termActive  += 1
    termHotN    += f_hot(scVIX)
if enVIX3M and not na(scVIX3M)
    termBaseSum += scVIX3M * 1.00
    termBaseW   += 1.00
    termActive  += 1
    termHotN    += f_hot(scVIX3M)
if enVIX6M and not na(scVIX6M)
    termBaseSum += scVIX6M * 0.85
    termBaseW   += 0.85
    termActive  += 1
    termHotN    += f_hot(scVIX6M)
if enVIX1Y and not na(scVIX1Y)
    termBaseSum += scVIX1Y * 0.70
    termBaseW   += 0.70
    termActive  += 1
    termHotN    += f_hot(scVIX1Y)
float termBase = termBaseW > 0 ? termBaseSum / termBaseW : na
float termPressure = f_wavg3(termBase, 0.50, frontStress, 0.30, curveStress, 0.20)
bool termHot = not na(termPressure) and termPressure >= termLayerThr

float tailBaseSum = 0.0
float tailBaseW   = 0.0
int   tailActive  = 0
int   tailHotN    = 0
if enVVIX and not na(scVVIX)
    tailBaseSum += scVVIX * 1.20
    tailBaseW   += 1.20
    tailActive  += 1
    tailHotN    += f_hot(scVVIX)
if enSKEW and not na(scSKEW)
    tailBaseSum += scSKEW * 0.80
    tailBaseW   += 0.80
    tailActive  += 1
    tailHotN    += f_hot(scSKEW)
float tailBase = tailBaseW > 0 ? tailBaseSum / tailBaseW : na

float dxyProxy = rawDXYSmart
float fxTailPressure     = f_wavg2(f_wavg3(scMOVE, 0.45, scVXTLT, 0.20, scVIX, 0.35), 0.85, dxyProxy, 0.15)
float cryptoTailPressure = f_wavg3(scDVOL, 0.40, scETHDVOL, 0.25, scVIX, 0.35)
float cmdtyTailPressure  = f_wavg3(scOVX, 0.35, scVIX, 0.35, scMOVE, 0.30)
float ratesTailPressure  = f_wavg3(scMOVE, 0.50, scVXTLT, 0.30, scSKEW, 0.20)
float eqTailPressure     = f_wavg3(tailBase, 0.70, curveStress, 0.15, frontStress, 0.15)
float mixedTailPressure  = f_wavg3(scVIX, 0.40, scMOVE, 0.40, tailBase, 0.20)

float tailPressure = not na(tailBase) ? tailBase :
                     universeMode == "Adaptive" and assetClass == CLS_FX     ? fxTailPressure :
                     universeMode == "Adaptive" and assetClass == CLS_CRYPTO ? cryptoTailPressure :
                     universeMode == "Adaptive" and assetClass == CLS_CMDTY  ? cmdtyTailPressure :
                     universeMode == "Adaptive" and assetClass == CLS_RATES  ? ratesTailPressure :
                     universeMode == "Adaptive" and assetClass == CLS_EQIDX  ? eqTailPressure :
                     universeMode == "Adaptive" and assetClass == CLS_MIXED  ? mixedTailPressure : na
bool tailHot = not na(tailPressure) and tailPressure >= tailLayerThr

float eqSum = 0.0
float eqW   = 0.0
if enVXN and not na(scVXN)
    eqSum += scVXN * 1.00
    eqW   += 1.00
if enRVX and not na(scRVX)
    eqSum += scRVX * 1.00
    eqW   += 1.00
if enVXD and not na(scVXD)
    eqSum += scVXD * 0.80
    eqW   += 0.80
float eqMean = eqW > 0 ? eqSum / eqW : na

float ratesSum = 0.0
float ratesW   = 0.0
if enMOVE and not na(scMOVE)
    ratesSum += scMOVE * 1.25
    ratesW   += 1.25
if enVXTLT and not na(scVXTLT)
    ratesSum += scVXTLT * 0.95
    ratesW   += 0.95
float ratesMean = ratesW > 0 ? ratesSum / ratesW : na

float cmdtySum = 0.0
float cmdtyW   = 0.0
if enOVX and not na(scOVX)
    cmdtySum += scOVX * 0.80
    cmdtyW   += 0.80
if enGVZ and not na(scGVZ)
    cmdtySum += scGVZ * 0.60
    cmdtyW   += 0.60
if enVXSLV and not na(scVXSLV)
    cmdtySum += scVXSLV * 0.55
    cmdtyW   += 0.55
float cmdtyMean = cmdtyW > 0 ? cmdtySum / cmdtyW : na

float cryptoSum = 0.0
float cryptoW   = 0.0
if enDVOL and not na(scDVOL)
    cryptoSum += scDVOL * 1.00
    cryptoW   += 1.00
if enETHDVOL and not na(scETHDVOL)
    cryptoSum += scETHDVOL * 0.90
    cryptoW   += 0.90
if enBVIV and not na(scBVIV)
    cryptoSum += scBVIV * 0.85
    cryptoW   += 0.85
if enEVIV and not na(scEVIV)
    cryptoSum += scEVIV * 0.75
    cryptoW   += 0.75
float cryptoMean = cryptoW > 0 ? cryptoSum / cryptoW : na

float customSum = 0.0
float customW   = 0.0
if enCustom1 and not na(scCustom1)
    customSum += scCustom1 * 0.85
    customW   += 0.85
if enCustom2 and not na(scCustom2)
    customSum += scCustom2 * 0.85
    customW   += 0.85
float customMean = customW > 0 ? customSum / customW : na

float contagionBaseSum = 0.0
float contagionBaseW   = 0.0
int   contagionActive  = 0
int   contagionHotN    = 0
if enVXN and not na(scVXN)
    contagionBaseSum += scVXN * 1.00
    contagionBaseW   += 1.00
    contagionActive  += 1
    contagionHotN    += f_hot(scVXN)
if enRVX and not na(scRVX)
    contagionBaseSum += scRVX * 1.00
    contagionBaseW   += 1.00
    contagionActive  += 1
    contagionHotN    += f_hot(scRVX)
if enVXD and not na(scVXD)
    contagionBaseSum += scVXD * 0.80
    contagionBaseW   += 0.80
    contagionActive  += 1
    contagionHotN    += f_hot(scVXD)
if enMOVE and not na(scMOVE)
    contagionBaseSum += scMOVE * 1.25
    contagionBaseW   += 1.25
    contagionActive  += 1
    contagionHotN    += f_hot(scMOVE)
if enVXTLT and not na(scVXTLT)
    contagionBaseSum += scVXTLT * 0.95
    contagionBaseW   += 0.95
    contagionActive  += 1
    contagionHotN    += f_hot(scVXTLT)
if enOVX and not na(scOVX)
    contagionBaseSum += scOVX * 0.80
    contagionBaseW   += 0.80
    contagionActive  += 1
    contagionHotN    += f_hot(scOVX)
if enGVZ and not na(scGVZ)
    contagionBaseSum += scGVZ * 0.60
    contagionBaseW   += 0.60
    contagionActive  += 1
    contagionHotN    += f_hot(scGVZ)
if enVXSLV and not na(scVXSLV)
    contagionBaseSum += scVXSLV * 0.55
    contagionBaseW   += 0.55
    contagionActive  += 1
    contagionHotN    += f_hot(scVXSLV)
if enDVOL and not na(scDVOL)
    contagionBaseSum += scDVOL * 1.00
    contagionBaseW   += 1.00
    contagionActive  += 1
    contagionHotN    += f_hot(scDVOL)
if enETHDVOL and not na(scETHDVOL)
    contagionBaseSum += scETHDVOL * 0.90
    contagionBaseW   += 0.90
    contagionActive  += 1
    contagionHotN    += f_hot(scETHDVOL)
if enBVIV and not na(scBVIV)
    contagionBaseSum += scBVIV * 0.85
    contagionBaseW   += 0.85
    contagionActive  += 1
    contagionHotN    += f_hot(scBVIV)
if enEVIV and not na(scEVIV)
    contagionBaseSum += scEVIV * 0.75
    contagionBaseW   += 0.75
    contagionActive  += 1
    contagionHotN    += f_hot(scEVIV)
if enCustom1 and not na(scCustom1)
    contagionBaseSum += scCustom1 * 0.85
    contagionBaseW   += 0.85
    contagionActive  += 1
    contagionHotN    += f_hot(scCustom1)
if enCustom2 and not na(scCustom2)
    contagionBaseSum += scCustom2 * 0.85
    contagionBaseW   += 0.85
    contagionActive  += 1
    contagionHotN    += f_hot(scCustom2)
float contagionBase = contagionBaseW > 0 ? contagionBaseSum / contagionBaseW : na

int contagionClusterN = (not na(eqMean) ? 1 : 0) + (not na(ratesMean) ? 1 : 0) + (not na(cmdtyMean) ? 1 : 0) + (not na(cryptoMean) ? 1 : 0) + (not na(customMean) ? 1 : 0)
int contagionClusterHot = (not na(eqMean) and eqMean >= singleLaneFearThr ? 1 : 0) + (not na(ratesMean) and ratesMean >= singleLaneFearThr ? 1 : 0) + (not na(cmdtyMean) and cmdtyMean >= singleLaneFearThr ? 1 : 0) + (not na(cryptoMean) and cryptoMean >= singleLaneFearThr ? 1 : 0) + (not na(customMean) and customMean >= singleLaneFearThr ? 1 : 0)
float contagionBreadth = contagionClusterN > 0 ? 100.0 * contagionClusterHot / contagionClusterN : na
float contagionPressure = f_wavg2(contagionBase, 0.75, contagionBreadth, 0.25)
bool contagionHot = not na(contagionPressure) and contagionPressure >= contagionLayerThr

//──────────────────────────────────────────────────────────────────────────────
// GLOBAL GATE
//──────────────────────────────────────────────────────────────────────────────
int selectedRawLaneCount = (enVIX1D ? 1 : 0) + (enVIX9D ? 1 : 0) + (enVIX ? 1 : 0) + (enVIX3M ? 1 : 0) + (enVIX6M ? 1 : 0) + (enVIX1Y ? 1 : 0) + (enVVIX ? 1 : 0) + (enSKEW ? 1 : 0) + (enVXN ? 1 : 0) + (enRVX ? 1 : 0) + (enVXD ? 1 : 0) + (enMOVE ? 1 : 0) + (enVXTLT ? 1 : 0) + (enOVX ? 1 : 0) + (enGVZ ? 1 : 0) + (enVXSLV ? 1 : 0) + (enDVOL ? 1 : 0) + (enETHDVOL ? 1 : 0) + (enBVIV ? 1 : 0) + (enEVIV ? 1 : 0) + (enCustom1 ? 1 : 0) + (enCustom2 ? 1 : 0)

int activeLaneCount = termActive + tailActive + contagionActive
int hotLaneCount    = termHotN + tailHotN + contagionHotN
float breadthPct    = activeLaneCount > 0 ? hotLaneCount / activeLaneCount : 0.0
float breadthScore  = breadthPct * 100.0

int activeLayers = (not na(termPressure) ? 1 : 0) + (not na(contagionPressure) ? 1 : 0) + (not na(tailPressure) ? 1 : 0)
int hotLayers    = (termHot ? 1 : 0) + (contagionHot ? 1 : 0) + (tailHot ? 1 : 0)
int requiredHotLayers = activeLayers > 0 ? math.min(requiredHotLayersI, activeLayers) : 0
int requiredActive    = selectedRawLaneCount > 0 ? math.min(minActiveLanes, selectedRawLaneCount) : 0

float compSum = 0.0
float compW   = 0.0
if not na(termPressure)
    compSum += termPressure * layerWTerm
    compW   += layerWTerm
if not na(contagionPressure)
    compSum += contagionPressure * layerWContagion
    compW   += layerWContagion
if not na(tailPressure)
    compSum += tailPressure * layerWTail
    compW   += layerWTail
float compositeScore = compW > 0 ? compSum / compW : na
bool riskOff = useGate and selectedRawLaneCount > 0 and activeLaneCount >= requiredActive and activeLayers > 0 and not na(compositeScore) and compositeScore >= compositeFearThr and breadthPct >= breadthThr and hotLayers >= requiredHotLayers

//──────────────────────────────────────────────────────────────────────────────
// DIRECTIONAL CORE (fully adaptive lengths)
//──────────────────────────────────────────────────────────────────────────────
float volEff = nz(volume)
volEff := volEff == 0 and pseudoVol ? 1.0 : volEff

float chFlow = nz(close - close[1])
float obvDelta = chFlow > 0 ? volEff : chFlow < 0 ? -volEff : 0.0
var float obvSeries = 0.0
obvSeries := nz(obvSeries[1]) + obvDelta

float cvdDelta = close > open ? volEff : close < open ? -volEff : 0.0
var float cvdSeries = 0.0
cvdSeries := nz(cvdSeries[1]) + cvdDelta

float obvSeriesU = f_signedUnit(obvSeries, flowNormLen, flowNormMode)
float obvDeltaU  = f_signedUnit(obvDelta,  flowNormLen, flowNormMode)
float cvdSeriesU = f_signedUnit(cvdSeries, flowNormLen, flowNormMode)
float cvdDeltaU  = f_signedUnit(cvdDelta,  flowNormLen, flowNormMode)

float obvSrc = flowBasisMode == "Series" ? obvSeriesU : flowBasisMode == "Delta" ? obvDeltaU : 0.60 * obvSeriesU + 0.40 * obvDeltaU
float cvdSrc = flowBasisMode == "Series" ? cvdSeriesU : flowBasisMode == "Delta" ? cvdDeltaU : 0.60 * cvdSeriesU + 0.40 * cvdDeltaU

float obvSigned = dirSmoothLen == 2 ? ta.ema(obvSrc,2) : dirSmoothLen == 3 ? ta.ema(obvSrc,3) : dirSmoothLen == 5 ? ta.ema(obvSrc,5) : ta.ema(obvSrc,8)
float cvdSigned = dirSmoothLen == 2 ? ta.ema(cvdSrc,2) : dirSmoothLen == 3 ? ta.ema(cvdSrc,3) : dirSmoothLen == 5 ? ta.ema(cvdSrc,5) : ta.ema(cvdSrc,8)

float pAtr = dirAtrLen == 7 ? ta.atr(7) : dirAtrLen == 14 ? ta.atr(14) : dirAtrLen == 21 ? ta.atr(21) : ta.atr(34)
float pBasis = dirBasisLen == 21 ? ta.ema(hlc3,21) : dirBasisLen == 34 ? ta.ema(hlc3,34) : dirBasisLen == 55 ? ta.ema(hlc3,55) : ta.ema(hlc3,89)
float pFast = dirFastLen == 8 ? ta.ema(close,8) : dirFastLen == 13 ? ta.ema(close,13) : dirFastLen == 21 ? ta.ema(close,21) : ta.ema(close,34)
float pSlow = dirSlowLen == 34 ? ta.ema(close,34) : dirSlowLen == 55 ? ta.ema(close,55) : dirSlowLen == 89 ? ta.ema(close,89) : ta.ema(close,144)

float priceTrendU = f_clamp((pFast - pSlow) / math.max(pAtr * 2.5, syminfo.mintick), -1.0, 1.0)
float priceLocU   = f_clamp((close - pBasis) / math.max(pAtr * 1.5, syminfo.mintick), -1.0, 1.0)
float priceMomU   = f_signedUnit(ta.change(close, dirMomLen), flowNormLen, flowNormMode)
float priceCore=f_clamp(0.45*priceTrendU+0.30*priceLocU+0.25*priceMomU,-1.0,1.0)
float priceSigned=dirSmoothLen==2?ta.ema(priceCore,2):dirSmoothLen==3?ta.ema(priceCore,3):dirSmoothLen==5?ta.ema(priceCore,5):ta.ema(priceCore,8)

float autoRiskPol = assetClass == CLS_CRYPTO ? 1.00 : assetClass == CLS_EQIDX ? 1.00 : assetClass == CLS_CMDTY ? (isGoldLike ? -0.85 : isSilverLike ? -0.35 : isOilLike ? 1.00 : 0.45) : assetClass == CLS_RATES ? (isYieldLike ? 1.00 : -1.00) : assetClass == CLS_FX ? f_clamp((f_ccyHaven(quoteU) + f_ccyRisk(baseU)) - (f_ccyHaven(baseU) + f_ccyRisk(quoteU)), -1.0, 1.0) : 0.60

float riskPolarity = pressurePolMode == "Risk-Off Bearish" ? 1.0 : pressurePolMode == "Risk-Off Bullish" ? -1.0 : pressurePolMode == "Neutral" ? 0.0 : autoRiskPol
float regimeSignedRaw  = -riskPolarity * f_clamp((nz(compositeScore, 50.0) - 50.0) / 50.0, -1.0, 1.0)
float regimeBreadthRaw = -riskPolarity * f_clamp((nz(breadthScore, 50.0) - 50.0) / 50.0, -1.0, 1.0)
float regimeCore=f_clamp(0.70*regimeSignedRaw+0.30*regimeBreadthRaw,-1.0,1.0)
float regimeSigned=dirSmoothLen==2?ta.ema(regimeCore,2):dirSmoothLen==3?ta.ema(regimeCore,3):dirSmoothLen==5?ta.ema(regimeCore,5):ta.ema(regimeCore,8)
float regimeConf01     = f_clamp(math.abs(regimeSignedRaw), 0.0, 1.0)

float localCore = f_pickLocalDir(dirLocalMode, priceSigned, obvSigned, cvdSigned)

float signedPress = 0.0
if dirRegimeMode == "None"
    signedPress := localCore
else if dirRegimeMode == "Bias only"
    signedPress := regimeSigned
else if dirRegimeMode == "Blend"
    signedPress := f_clamp((1.0 - dirRegimeWeight) * localCore + dirRegimeWeight * regimeSigned, -1.0, 1.0)
else
    float confirmGain = math.abs(localCore) < dirNeutralBand or math.abs(regimeSigned) < dirNeutralBand ? 1.0 : (math.sign(localCore) == math.sign(regimeSigned) ? 1.0 + dirRegimeWeight * regimeConf01 : 1.0 - dirRegimeWeight * regimeConf01)
    signedPress := f_clamp(localCore * confirmGain, -1.0, 1.0)
signedPress := dirSmoothLen==2?ta.ema(signedPress,2):dirSmoothLen==3?ta.ema(signedPress,3):dirSmoothLen==5?ta.ema(signedPress,5):ta.ema(signedPress,8)

float pressureIntensity = 100.0 * (dirRegimeMode == "None" ? f_clamp(math.abs(signedPress), 0.0, 1.0) : f_clamp(0.60 * math.abs(signedPress) + 0.40 * regimeConf01, 0.0, 1.0))
float bullPressure = signedPress > dirNeutralBand ? pressureIntensity : 0.0
float bearPressure = signedPress < -dirNeutralBand ? pressureIntensity : 0.0
float domPressure  = math.max(bullPressure, bearPressure)
int zoneState      = bullPressure > 0 ? 1 : bearPressure > 0 ? -1 : 0
bool bullEntry     = zoneState == 1 and zoneState[1] != 1
bool bearEntry     = zoneState == -1 and zoneState[1] != -1

//──────────────────────────────────────────────────────────────────────────────
// SLOT STACK (AUTO-REPACK, NO INTERNAL GAPS)
//──────────────────────────────────────────────────────────────────────────────
var array<color> slotCols = array.new_color()
var array<string> slotTxt = array.new_string()
var array<color> slotBgs  = array.new_color()

array.clear(slotCols)
array.clear(slotTxt)
array.clear(slotBgs)

f_pushLane(slotCols, slotTxt, slotBgs, showMetaGate, riskOff ? 100.0 : 0.0, "GATE  " + (riskOff ? "ON" : "OFF") + " | " + assetName + " | TF " + effectiveFearTF + (tfClamped ? " CLAMP" : ""), PAL_GATE, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, showMetaComposite, compositeScore, "COMPOSITE  " + f_num(compositeScore) + " | active " + str.tostring(activeLaneCount) + "/" + str.tostring(selectedRawLaneCount), PAL_META, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, showMetaBreadth, breadthScore, "BREADTH  " + f_num(breadthScore) + " | hot " + str.tostring(hotLaneCount), PAL_META, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, showMetaFront, frontStress, "FRONT STRESS  " + f_num(frontStress), PAL_META, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, showMetaCurve, curveStress, "CURVE STRESS  " + f_num(curveStress), PAL_META, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, showMetaContagion, contagionPressure, "CONTAGION PRESSURE  " + f_num(contagionPressure), PAL_META, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, showMetaTail and not na(tailPressure), tailPressure, "TAIL PRESSURE  " + f_num(tailPressure), PAL_META, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enVIX1D, scVIX1D, "VIX1D  " + f_num(scVIX1D), PAL_TERM, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enVIX9D, scVIX9D, "VIX9D  " + f_num(scVIX9D), PAL_TERM, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enVIX, scVIX, "VIX  " + f_num(scVIX), PAL_TERM, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enVIX3M, scVIX3M, "VIX3M  " + f_num(scVIX3M), PAL_TERM, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enVIX6M, scVIX6M, "VIX6M  " + f_num(scVIX6M), PAL_TERM, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enVIX1Y, scVIX1Y, "VIX1Y  " + f_num(scVIX1Y), PAL_TERM, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enVVIX, scVVIX, "VVIX  " + f_num(scVVIX), PAL_TAIL, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enSKEW, scSKEW, "SKEW  " + f_num(scSKEW), PAL_TAIL, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enVXN, scVXN, "VXN  " + f_num(scVXN), PAL_EQ, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enRVX, scRVX, "RVX  " + f_num(scRVX), PAL_EQ, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enVXD, scVXD, "VXD  " + f_num(scVXD), PAL_EQ, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enMOVE, scMOVE, "MOVE  " + f_num(scMOVE), PAL_RATES, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enVXTLT, scVXTLT, "VXTLT  " + f_num(scVXTLT), PAL_RATES, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enOVX, scOVX, "OVX  " + f_num(scOVX), PAL_CMDTY, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enGVZ, scGVZ, "GVZ  " + f_num(scGVZ), PAL_CMDTY, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enVXSLV, scVXSLV, "VXSLV  " + f_num(scVXSLV), PAL_CMDTY, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enDVOL, scDVOL, "DVOL  " + f_num(scDVOL), PAL_CRYPTO, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enETHDVOL, scETHDVOL, "ETHDVOL  " + f_num(scETHDVOL), PAL_CRYPTO, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enBVIV, scBVIV, "BVIV  " + f_num(scBVIV), PAL_CRYPTO, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enEVIV, scEVIV, "EVIV  " + f_num(scEVIV), PAL_CRYPTO, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enCustom1, scCustom1,   " nmC1" + f_num(scCustom1), PAL_CUSTOM, signedPress)
f_pushLane(slotCols, slotTxt, slotBgs, enCustom2, scCustom2,   "nmC2 " + f_num(scCustom2), PAL_CUSTOM, signedPress)

int slotN = array.size(slotCols)
bool renderOk = renderBarsIn == 0 ? true : (bar_index >= last_bar_index - renderBarsIn)

//──────────────────────────────────────────────────────────────────────────────
// SLOT PLOTS
//──────────────────────────────────────────────────────────────────────────────
plot(renderOk and f_hasSlot(slotCols, 0) ? 29.0 : na, "Slot 01", style=plot.style_columns, histbase=28.2, color=f_slotColor(slotCols, 0))
plot(renderOk and f_hasSlot(slotCols, 1) ? 28.0 : na, "Slot 02", style=plot.style_columns, histbase=27.2, color=f_slotColor(slotCols, 1))
plot(renderOk and f_hasSlot(slotCols, 2) ? 27.0 : na, "Slot 03", style=plot.style_columns, histbase=26.2, color=f_slotColor(slotCols, 2))
plot(renderOk and f_hasSlot(slotCols, 3) ? 26.0 : na, "Slot 04", style=plot.style_columns, histbase=25.2, color=f_slotColor(slotCols, 3))
plot(renderOk and f_hasSlot(slotCols, 4) ? 25.0 : na, "Slot 05", style=plot.style_columns, histbase=24.2, color=f_slotColor(slotCols, 4))
plot(renderOk and f_hasSlot(slotCols, 5) ? 24.0 : na, "Slot 06", style=plot.style_columns, histbase=23.2, color=f_slotColor(slotCols, 5))
plot(renderOk and f_hasSlot(slotCols, 6) ? 23.0 : na, "Slot 07", style=plot.style_columns, histbase=22.2, color=f_slotColor(slotCols, 6))
plot(renderOk and f_hasSlot(slotCols, 7) ? 22.0 : na, "Slot 08", style=plot.style_columns, histbase=21.2, color=f_slotColor(slotCols, 7))
plot(renderOk and f_hasSlot(slotCols, 8) ? 21.0 : na, "Slot 09", style=plot.style_columns, histbase=20.2, color=f_slotColor(slotCols, 8))
plot(renderOk and f_hasSlot(slotCols, 9) ? 20.0 : na, "Slot 10", style=plot.style_columns, histbase=19.2, color=f_slotColor(slotCols, 9))
plot(renderOk and f_hasSlot(slotCols, 10) ? 19.0 : na, "Slot 11", style=plot.style_columns, histbase=18.2, color=f_slotColor(slotCols, 10))
plot(renderOk and f_hasSlot(slotCols, 11) ? 18.0 : na, "Slot 12", style=plot.style_columns, histbase=17.2, color=f_slotColor(slotCols, 11))
plot(renderOk and f_hasSlot(slotCols, 12) ? 17.0 : na, "Slot 13", style=plot.style_columns, histbase=16.2, color=f_slotColor(slotCols, 12))
plot(renderOk and f_hasSlot(slotCols, 13) ? 16.0 : na, "Slot 14", style=plot.style_columns, histbase=15.2, color=f_slotColor(slotCols, 13))
plot(renderOk and f_hasSlot(slotCols, 14) ? 15.0 : na, "Slot 15", style=plot.style_columns, histbase=14.2, color=f_slotColor(slotCols, 14))
plot(renderOk and f_hasSlot(slotCols, 15) ? 14.0 : na, "Slot 16", style=plot.style_columns, histbase=13.2, color=f_slotColor(slotCols, 15))
plot(renderOk and f_hasSlot(slotCols, 16) ? 13.0 : na, "Slot 17", style=plot.style_columns, histbase=12.2, color=f_slotColor(slotCols, 16))
plot(renderOk and f_hasSlot(slotCols, 17) ? 12.0 : na, "Slot 18", style=plot.style_columns, histbase=11.2, color=f_slotColor(slotCols, 17))
plot(renderOk and f_hasSlot(slotCols, 18) ? 11.0 : na, "Slot 19", style=plot.style_columns, histbase=10.2, color=f_slotColor(slotCols, 18))
plot(renderOk and f_hasSlot(slotCols, 19) ? 10.0 : na, "Slot 20", style=plot.style_columns, histbase=9.2, color=f_slotColor(slotCols, 19))
plot(renderOk and f_hasSlot(slotCols, 20) ? 9.0 : na, "Slot 21", style=plot.style_columns, histbase=8.2, color=f_slotColor(slotCols, 20))
plot(renderOk and f_hasSlot(slotCols, 21) ? 8.0 : na, "Slot 22", style=plot.style_columns, histbase=7.2, color=f_slotColor(slotCols, 21))
plot(renderOk and f_hasSlot(slotCols, 22) ? 7.0 : na, "Slot 23", style=plot.style_columns, histbase=6.2, color=f_slotColor(slotCols, 22))
plot(renderOk and f_hasSlot(slotCols, 23) ? 6.0 : na, "Slot 24", style=plot.style_columns, histbase=5.2, color=f_slotColor(slotCols, 23))
plot(renderOk and f_hasSlot(slotCols, 24) ? 5.0 : na, "Slot 25", style=plot.style_columns, histbase=4.2, color=f_slotColor(slotCols, 24))
plot(renderOk and f_hasSlot(slotCols, 25) ? 4.0 : na, "Slot 26", style=plot.style_columns, histbase=3.2, color=f_slotColor(slotCols, 25))
plot(renderOk and f_hasSlot(slotCols, 26) ? 3.0 : na, "Slot 27", style=plot.style_columns, histbase=2.2, color=f_slotColor(slotCols, 26))
plot(renderOk and f_hasSlot(slotCols, 27) ? 2.0 : na, "Slot 28", style=plot.style_columns, histbase=1.2, color=f_slotColor(slotCols, 27))
plot(renderOk and f_hasSlot(slotCols, 28) ? 1.0 : na, "Slot 29", style=plot.style_columns, histbase=0.2, color=f_slotColor(slotCols, 28))

//──────────────────────────────────────────────────────────────────────────────
// OVERLAY DRAWING
//──────────────────────────────────────────────────────────────────────────────
bool zoneUseTint  = pressureZoneStyle == "Tint" or pressureZoneStyle == "Boxes+Tint"
bool zoneUseBoxes = pressureZoneStyle == "Boxes" or pressureZoneStyle == "Boxes+Tint"

color bullCol = f_signedColor(1.0, bullPressure)
color bearCol = f_signedColor(-1.0, bearPressure)
color zoneCol = zoneState == 1 ? bullCol : zoneState == -1 ? bearCol : color.new(color.gray, 85)

bgcolor(pressureOverlayOn and renderOk and zoneUseTint and zoneState != 0 ? color.new(zoneCol, 88) : na, force_overlay=true)
barcolor(pressureOverlayOn and renderOk and pressureTintCandles and zoneState != 0 ? color.new(zoneCol, 72) : na)

float midCurve  = pBasis
float bullCurve = bullPressure > 0 ? pBasis - pAtr * pressureAtrScale * (0.50 + bullPressure / 60.0) : na
float bearCurve = bearPressure > 0 ? pBasis + pAtr * pressureAtrScale * (0.50 + bearPressure / 60.0) : na

color midCurveCol  = zoneState == 0 ? color.new(color.gray, 70) : color.new(zoneCol, 10)
color bullCurveCol = color.new(bullCol, 10)
color bearCurveCol = color.new(bearCol, 10)

int midW  = domPressure >= 75 ? 3 : 2
int edgeW = domPressure >= 75 ? 3 : domPressure >= 45 ? 2 : 1

var array<line> curveLines = array.new_line()
var line lastMidLine  = na
var line lastBullLine = na
var line lastBearLine = na

if not pressureOverlayOn or not pressureCurvesOn or not renderOk
    while array.size(curveLines) > 0
        line.delete(array.pop(curveLines))
    lastMidLine  := na
    lastBullLine := na
    lastBearLine := na
else
    float midPrev  = nz(midCurve[1], midCurve)
    float bullPrev = bullCurve[1]
    float bearPrev = bearCurve[1]
    lastMidLine  := f_updSeg(lastMidLine,  not na(midPrev) and not na(midCurve),  midPrev,  midCurve,  midCurveCol,  midW,  curveLines, pressureCurveKeep)
    lastBullLine := f_updSeg(lastBullLine, not na(bullPrev) and not na(bullCurve), bullPrev, bullCurve, bullCurveCol, edgeW, curveLines, pressureCurveKeep)
    lastBearLine := f_updSeg(lastBearLine, not na(bearPrev) and not na(bearCurve), bearPrev, bearCurve, bearCurveCol, edgeW, curveLines, pressureCurveKeep)

var array<box> regimeBoxes = array.new_box()
var box  activeRegBox   = na
var int  activeRegState = 0
var float activeRegTop  = na
var float activeRegBot  = na

float boxPad    = pAtr * pressureAtrScale * (0.45 + domPressure / 100.0)
float boxTopNow = high + boxPad
float boxBotNow = low  - boxPad

if not pressureOverlayOn or not zoneUseBoxes or not renderOk
    while array.size(regimeBoxes) > 0
        box.delete(array.pop(regimeBoxes))
    activeRegBox   := na
    activeRegState := 0
    activeRegTop   := na
    activeRegBot   := na
else
    if bullEntry or bearEntry
        activeRegState := zoneState
        activeRegTop   := boxTopNow
        activeRegBot   := boxBotNow
        activeRegBox := box.new(left=bar_index, top=activeRegTop, right=bar_index, bottom=activeRegBot, xloc=xloc.bar_index, extend=extend.none, bgcolor=color.new(zoneCol, 88), border_color=color.new(zoneCol, 35), border_width=1, force_overlay=true)
        array.push(regimeBoxes, activeRegBox)
        f_trimBoxQ(regimeBoxes, pressureBoxKeep)
    else if zoneState != 0 and not na(activeRegBox) and activeRegState == zoneState
        activeRegTop := math.max(activeRegTop, boxTopNow)
        activeRegBot := math.min(activeRegBot, boxBotNow)
        box.set_right(activeRegBox, bar_index)
        box.set_top(activeRegBox, activeRegTop)
        box.set_bottom(activeRegBox, activeRegBot)
        box.set_bgcolor(activeRegBox, color.new(zoneCol, 88))
        box.set_border_color(activeRegBox, color.new(zoneCol, 35))
    else if zoneState == 0
        activeRegBox   := na
        activeRegState := 0
        activeRegTop   := na
        activeRegBot   := na

var array<label> entryMarks = array.new_label()
if not pressureOverlayOn or not pressureFlipArrowsOn or not renderOk
    while array.size(entryMarks) > 0
        label.delete(array.pop(entryMarks))
else if barstate.isnew
    if bullEntry
        label lbUp = label.new(x=bar_index, y=low - pAtr * 0.35, text="▲", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, textcolor=color.white, color=color.new(bullCol, 0), size=size.small, force_overlay=true)
        array.push(entryMarks, lbUp)
        f_trimLabelQ(entryMarks, pressureFlipKeep)
    if bearEntry
        label lbDn = label.new(x=bar_index, y=high + pAtr * 0.35, text="▼", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, textcolor=color.white, color=color.new(bearCol, 0), size=size.small, force_overlay=true)
        array.push(entryMarks, lbDn)
        f_trimLabelQ(entryMarks, pressureFlipKeep)


//──────────────────────────────────────────────────────────────────────────────
// REVERSAL RISK BLOCK
// Paste after OVERLAY DRAWING and before HIDDEN OUTPUTS
//──────────────────────────────────────────────────────────────────────────────
string GRR = "14) Reversal Risk"
bool revRiskOn = input.bool(true, "Show reversal risk rails", group=GRR)
bool revRecolorBox = input.bool(true, "Recolor active box on warning", group=GRR)
bool revShowLabels = input.bool(true, "Show REV?/X labels", group=GRR)
float revWickMult = input.float(1.20, "Wick/body factor", minval=0.5, step=0.05, group=GRR)
float revVolMult = input.float(1.35, "Volume spike x", minval=1.0, step=0.05, group=GRR)
float revWarnFrac = input.float(0.72, "VAH/VAL reclaim frac", minval=0.55, maxval=0.90, step=0.01, group=GRR)
float revInvAtr = input.float(0.10, "Invalidation ATR", minval=0.0, maxval=1.0, step=0.05, group=GRR)
int revVolLen = input.int(20, "Volume EMA len", minval=5, group=GRR)

float revBody = math.abs(close - open)
float revUpperWick = high - math.max(open, close)
float revLowerWick = math.min(open, close) - low
float revVolEma = ta.ema(nz(volume, 0.0), revVolLen)
bool revHasVol = ta.sma(nz(volume, 0.0), revVolLen) > 0
bool revVolSpike = revHasVol and volume > revVolEma * revVolMult

float revSlope = (pFast - pSlow) - nz((pFast - pSlow)[1], pFast - pSlow)
bool bullRej = close > open and revLowerWick > math.max(revBody, syminfo.mintick) * revWickMult
bool bearRej = close < open and revUpperWick > math.max(revBody, syminfo.mintick) * revWickMult
bool bullFlow = localCore > 0 or obvSigned > 0 or cvdSigned > 0
bool bearFlow = localCore < 0 or obvSigned < 0 or cvdSigned < 0
bool bullSlope = revSlope > 0
bool bearSlope = revSlope < 0

float regRange = not na(activeRegTop) and not na(activeRegBot) ? math.max(activeRegTop - activeRegBot, syminfo.mintick) : na
float bearWarnLine = not na(regRange) ? activeRegBot + regRange * revWarnFrac : na
float bullWarnLine = not na(regRange) ? activeRegTop - regRange * revWarnFrac : na
float bearInvLine = not na(activeRegTop) ? activeRegTop + pAtr * revInvAtr : na
float bullInvLine = not na(activeRegBot) ? activeRegBot - pAtr * revInvAtr : na

int bullEvidence = (bullRej ? 1 : 0) + (bullFlow ? 1 : 0) + (bullSlope ? 1 : 0) + (revVolSpike ? 1 : 0) + (close > pBasis ? 1 : 0)
int bearEvidence = (bearRej ? 1 : 0) + (bearFlow ? 1 : 0) + (bearSlope ? 1 : 0) + (revVolSpike ? 1 : 0) + (close < pBasis ? 1 : 0)

bool bearRevRisk = revRiskOn and zoneState == -1 and not na(bearWarnLine) and close > bearWarnLine and bullEvidence >= (revHasVol ? 3 : 2)
bool bullRevRisk = revRiskOn and zoneState == 1 and not na(bullWarnLine) and close < bullWarnLine and bearEvidence >= (revHasVol ? 3 : 2)
bool bearInvalid = revRiskOn and zoneState == -1 and not na(bearInvLine) and close > bearInvLine
bool bullInvalid = revRiskOn and zoneState == 1 and not na(bullInvLine) and close < bullInvLine

var int revZoneLeft = na
var line revWarnLn = na
var line revInvLn = na
var array<line> revStructLines = array.new_line()
var array<label> revRiskMarks = array.new_label()

if bullEntry or bearEntry
    revZoneLeft := bar_index
    revWarnLn := na
    revInvLn := na

if revRiskOn and pressureOverlayOn and renderOk and zoneState != 0 and not na(revZoneLeft)
    color baseCol = zoneState == -1 ? color.new(#ff5289, 5) : color.new(color.aqua, 5)
    color warnCol = zoneState == -1 ? (bearRevRisk ? color.new(#ff5289, 0) : baseCol) : (bullRevRisk ? color.new(color.aqua, 0) : baseCol)
    color invCol = zoneState == -1 ? (bearInvalid ? color.new(color.black, 0) : baseCol) : (bullInvalid ? color.new(color.black, 0) : baseCol)
    float warnY = zoneState == -1 ? bearWarnLine : bullWarnLine
    float invY = zoneState == -1 ? bearInvLine : bullInvLine

    if na(revWarnLn)
        revWarnLn := line.new(revZoneLeft, warnY, bar_index, warnY, xloc=xloc.bar_index, extend=extend.none, color=warnCol, width=2, style=line.style_solid, force_overlay=true)
        array.push(revStructLines, revWarnLn)
        f_trimLineQ(revStructLines, pressureCurveKeep)
    else
        line.set_xy1(revWarnLn, revZoneLeft, warnY)
        line.set_xy2(revWarnLn, bar_index, warnY)
        line.set_color(revWarnLn, warnCol)

    if na(revInvLn)
        revInvLn := line.new(revZoneLeft, invY, bar_index, invY, xloc=xloc.bar_index, extend=extend.none, color=invCol, width=1, style=line.style_dashed, force_overlay=true)
        array.push(revStructLines, revInvLn)
        f_trimLineQ(revStructLines, pressureCurveKeep)
    else
        line.set_xy1(revInvLn, revZoneLeft, invY)
        line.set_xy2(revInvLn, bar_index, invY)
        line.set_color(revInvLn, invCol)

    if revRecolorBox and not na(activeRegBox)
        color bxBg = bearInvalid or bullInvalid ? color.new(color.silver, 84) : (bearRevRisk or bullRevRisk ? color.new(color.orange, 86) : color.new(zoneCol, 88))
        color bxBr = bearInvalid or bullInvalid ? color.new(color.white, 45) : (bearRevRisk or bullRevRisk ? color.new(color.orange, 35) : color.new(zoneCol, 35))
        box.set_bgcolor(activeRegBox, bxBg)
        box.set_border_color(activeRegBox, bxBr)

if revRiskOn and pressureOverlayOn and renderOk and barstate.isnew
    if bearRevRisk and not bearRevRisk[1] and revShowLabels
        label lb = label.new(bar_index, low - pAtr * 0.55, "R", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, textcolor=color.black, color=color.new(color.aqua, 0), size=size.tiny, force_overlay=true)
        array.push(revRiskMarks, lb)
        f_trimLabelQ(revRiskMarks, pressureFlipKeep)

    if bullRevRisk and not bullRevRisk[1] and revShowLabels  
        label lb = label.new(bar_index,  high + pAtr * 0.55, "R", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, textcolor=color.black, color=color.new(#ff527a, 0), size=size.tiny, force_overlay=true)
        array.push(revRiskMarks, lb)
        f_trimLabelQ(revRiskMarks, pressureFlipKeep)

    if bearInvalid and not bearInvalid[1] and revShowLabels
        label lb = label.new(bar_index, high + pAtr * 0.85, "X", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, textcolor=color.white, color=color.new(#ff527a, 0), size=size.tiny, force_overlay=true)
        array.push(revRiskMarks, lb)
        f_trimLabelQ(revRiskMarks, pressureFlipKeep)

    if bullInvalid and not bullInvalid[1] and revShowLabels
        label lb = label.new(bar_index, low - pAtr * 0.85, "X", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, textcolor=color.white, color=color.new(color.aqua, 0), size=size.tiny, force_overlay=true)
        array.push(revRiskMarks, lb)
        f_trimLabelQ(revRiskMarks, pressureFlipKeep)

if zoneState == 0
    revWarnLn := na
    revInvLn := na
    revZoneLeft := na


//──────────────────────────────────────────────────────────────────────────────
// HIDDEN OUTPUTS
//──────────────────────────────────────────────────────────────────────────────
plot(riskOff ? 1 : 0, "fearBlocked", display=display.none, color=color.gray)
plot(compositeScore,  "fearComposite", display=display.none, color=color.gray)
plot(signedPress * 100.0, "pressureSigned", display=display.none, color=color.gray)

//──────────────────────────────────────────────────────────────────────────────
// RESUME ROW DATA (built every bar, rendered only on last bar)
//──────────────────────────────────────────────────────────────────────────────
array<string> rIds       = array.new_string()
array<string> rNames     = array.new_string()
array<string> rVals      = array.new_string()
array<string> rTrends    = array.new_string()
array<color>  rTrendCols = array.new_color()
array<string> rStates    = array.new_string()
array<color>  rStateBgs  = array.new_color()
array<string> rRoles     = array.new_string()
array<color>  rChips     = array.new_color()

int rowIdx = 1
rowIdx := f_pushResumeStatic(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, true, "GATE", riskOff ? "ON" : "OFF", str.tostring(hotLayers) + "/" + str.tostring(requiredHotLayers), color.white, activeLaneCount >= requiredActive ? "READY" : "THIN", activeLaneCount >= requiredActive ? color.new(color.aqua, 78) : color.new(color.orange, 78), "Gate", f_clusterHeatColor(PAL_GATE, riskOff ? 100.0 : 0.0))
rowIdx := f_pushResumeDir(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, true, "SIGNED PRESS", signedPress, pressureIntensity, "Direction")
rowIdx := f_pushResumeDir(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, true, "PRICE CORE", priceSigned, 100.0 * math.abs(priceSigned), "Direction")
rowIdx := f_pushResumeDir(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, true, "OBV CORE", obvSigned, 100.0 * math.abs(obvSigned), "Direction")
rowIdx := f_pushResumeDir(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, true, "CVD CORE", cvdSigned, 100.0 * math.abs(cvdSigned), "Direction")
rowIdx := f_pushResumeDir(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, dirRegimeMode != "None", "REGIME CORE", regimeSigned, 100.0 * regimeConf01, "Direction")
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, showMetaComposite, "COMPOSITE", compositeScore, PAL_META, "Meta", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, showMetaBreadth, "BREADTH", breadthScore, PAL_META, "Meta", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, showMetaFront, "FRONT", frontStress, PAL_META, "Meta", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, showMetaCurve, "CURVE", curveStress, PAL_META, "Meta", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, showMetaContagion, "CONTAGION", contagionPressure, PAL_META, "Meta", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, showMetaTail and not na(tailPressure), "TAIL", tailPressure, PAL_META, "Meta", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enVIX1D, "VIX1D", scVIX1D, PAL_TERM, "Term", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enVIX9D, "VIX9D", scVIX9D, PAL_TERM, "Term", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enVIX, "VIX", scVIX, PAL_TERM, "Term", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enVIX3M, "VIX3M", scVIX3M, PAL_TERM, "Term", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enVIX6M, "VIX6M", scVIX6M, PAL_TERM, "Term", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enVIX1Y, "VIX1Y", scVIX1Y, PAL_TERM, "Term", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enVVIX, "VVIX", scVVIX, PAL_TAIL, "Tail", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enSKEW, "SKEW", scSKEW, PAL_TAIL, "Tail", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enVXN, "VXN", scVXN, PAL_EQ, "Equity", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enRVX, "RVX", scRVX, PAL_EQ, "Equity", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enVXD, "VXD", scVXD, PAL_EQ, "Equity", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enMOVE, "MOVE", scMOVE, PAL_RATES, "Rates", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enVXTLT, "VXTLT", scVXTLT, PAL_RATES, "Rates", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enOVX, "OVX", scOVX, PAL_CMDTY, "Cmdty", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enGVZ, "GVZ", scGVZ, PAL_CMDTY, "Cmdty", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enVXSLV, "VXSLV", scVXSLV, PAL_CMDTY, "Cmdty", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enDVOL, "DVOL", scDVOL, PAL_CRYPTO, "Crypto", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enETHDVOL, "ETHDVOL", scETHDVOL, PAL_CRYPTO, "Crypto", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enBVIV, "BVIV", scBVIV, PAL_CRYPTO, "Crypto", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enEVIV, "EVIV", scEVIV, PAL_CRYPTO, "Crypto", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enCustom1, nmC1, scCustom1, PAL_CUSTOM, "Custom", signedPress)
rowIdx := f_pushResumeFear(rIds, rNames, rVals, rTrends, rTrendCols, rStates, rStateBgs, rRoles, rChips, rowIdx, enCustom2, nmC2, scCustom2, PAL_CUSTOM, "Custom", signedPress)

//──────────────────────────────────────────────────────────────────────────────
// RESUME TABLE
//──────────────────────────────────────────────────────────────────────────────
var table tResume = na

if barstate.islast
    if showResumeTable
        if na(tResume)
            tResume := table.new(f_tblPos(resumeTblPos), 6, 44, border_width=1)

        f_resumeClear(tResume, 6, 44)

        table.cell(tResume, 0, 0, "✦👁",            text_color=color.white, bgcolor=color.new(#2a3472, 0), text_size=f_tblTextSz(resumeTblTextSz))
        table.cell(tResume, 1, 0, "FTWM",           text_color=color.white, bgcolor=color.new(#2a3472, 0), text_size=f_tblTextSz(resumeTblTextSz))
        table.cell(tResume, 2, 0, assetName,        text_color=color.white, bgcolor=color.new(#2a3472, 0), text_size=f_tblTextSz(resumeTblTextSz))
        table.cell(tResume, 3, 0, effectiveFearTF + (confirmedHTFMode ? " C" : " L"), text_color=color.white, bgcolor=color.new(#2a3472, 0), text_size=f_tblTextSz(resumeTblTextSz))
        table.cell(tResume, 4, 0, slotColorMode,    text_color=color.white, bgcolor=color.new(#2a3472, 0), text_size=f_tblTextSz(resumeTblTextSz))
        table.cell(tResume, 5, 0, "[by Oberlunar]", text_color=color.white, bgcolor=color.new(#2a3472, 0), text_size=f_tblTextSz(resumeTblTextSz))

        table.cell(tResume, 0, 1, "#",      text_color=color.white, bgcolor=color.new(color.black, 0), text_size=f_tblTextSz(resumeTblTextSz))
        table.cell(tResume, 1, 1, "Driver", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=f_tblTextSz(resumeTblTextSz))
        table.cell(tResume, 2, 1, "Val",    text_color=color.white, bgcolor=color.new(color.black, 0), text_size=f_tblTextSz(resumeTblTextSz))
        table.cell(tResume, 3, 1, "Trend",  text_color=color.white, bgcolor=color.new(color.black, 0), text_size=f_tblTextSz(resumeTblTextSz))
        table.cell(tResume, 4, 1, "State",  text_color=color.white, bgcolor=color.new(color.black, 0), text_size=f_tblTextSz(resumeTblTextSz))
        table.cell(tResume, 5, 1, "Role",   text_color=color.white, bgcolor=color.new(color.black, 0), text_size=f_tblTextSz(resumeTblTextSz))

        int rowN = array.size(rNames)
        for i = 0 to rowN - 1
            int rr = i + 2
            color baseBg = color.new(color.black, 86)
            color roleBg = color.new(color.black, 92)
            table.cell(tResume, 0, rr, array.get(rIds, i),      text_color=color.white,         bgcolor=array.get(rChips, i),     text_size=f_tblTextSz(resumeTblTextSz))
            table.cell(tResume, 1, rr, array.get(rNames, i),    text_color=color.white,         bgcolor=baseBg,                   text_size=f_tblTextSz(resumeTblTextSz))
            table.cell(tResume, 2, rr, array.get(rVals, i),     text_color=color.white,         bgcolor=baseBg,                   text_size=f_tblTextSz(resumeTblTextSz))
            table.cell(tResume, 3, rr, array.get(rTrends, i),   text_color=array.get(rTrendCols, i), bgcolor=baseBg,             text_size=f_tblTextSz(resumeTblTextSz))
            table.cell(tResume, 4, rr, array.get(rStates, i),   text_color=color.white,         bgcolor=array.get(rStateBgs, i), text_size=f_tblTextSz(resumeTblTextSz))
            table.cell(tResume, 5, rr, array.get(rRoles, i),    text_color=color.white,         bgcolor=roleBg,                   text_size=f_tblTextSz(resumeTblTextSz))

        int foot = rowN + 2
        table.cell(tResume, 0, foot, "✦",                text_color=color.white, bgcolor=color.new(#2a3472, 0), text_size=f_tblTextSz(resumeTblTextSz))
        table.cell(tResume, 1, foot, "Fear The Walking", text_color=color.white, bgcolor=color.new(#2a3472, 0), text_size=f_tblTextSz(resumeTblTextSz))
        table.cell(tResume, 2, foot, assetName,          text_color=color.white, bgcolor=color.new(#2a3472, 0), text_size=f_tblTextSz(resumeTblTextSz))
        table.cell(tResume, 3, foot, "✦👁",              text_color=color.white, bgcolor=color.new(#2a3472, 0), text_size=f_tblTextSz(resumeTblTextSz))
        table.cell(tResume, 4, foot, "by",               text_color=color.white, bgcolor=color.new(#2a3472, 0), text_size=f_tblTextSz(resumeTblTextSz))
        table.cell(tResume, 5, foot, "Oberlunar",        text_color=color.white, bgcolor=color.new(#2a3472, 0), text_size=f_tblTextSz(resumeTblTextSz))
    else
        if not na(tResume)
            table.delete(tResume)
            tResume := na
