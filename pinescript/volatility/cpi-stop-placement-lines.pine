//@version=5
indicator("Configurable Price Rays", overlay=true)

// ── Inputs
pointDistance = input.float(30.0, "Distance (points)", minval=0.0, step=0.25)
useHL         = input.bool(false, "Use High/Low instead of Close?")
upperColor    = input.color(color.black, "Upper line color")
lowerColor    = input.color(color.black, "Lower line color")
lineWidth     = input.int(1, "Line width", minval=1, maxval=5)

// ── Reference price
price = useHL ? hl2 : close

upper = price + pointDistance
lower = price - pointDistance

// ── Create or update horizontal rays
var line upperRay = na
var line lowerRay = na

if barstate.isfirst
    upperRay := line.new(bar_index, upper, bar_index + 1, upper, extend=extend.right, color=upperColor, width=lineWidth)
    lowerRay := line.new(bar_index, lower, bar_index + 1, lower, extend=extend.right, color=lowerColor, width=lineWidth)
else
    line.set_y1(upperRay, upper)
    line.set_y2(upperRay, upper)
    line.set_color(upperRay, upperColor)
    line.set_width(upperRay, lineWidth)

    line.set_y1(lowerRay, lower)
    line.set_y2(lowerRay, lower)
    line.set_color(lowerRay, lowerColor)
    line.set_width(lowerRay, lineWidth)
