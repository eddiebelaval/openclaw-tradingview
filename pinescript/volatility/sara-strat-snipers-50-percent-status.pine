//@version=5
indicator("Sara Strat Snipers 50 Percent Status", overlay=true, max_lines_count=10, max_labels_count=50)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
tfMode       = input.string("Chart", "Timeframe Mode", options=["Chart", "Single Timeframe"])
fixedTF      = input.timeframe("W", "Single Timeframe (if selected above)")
showBox      = input.bool(true, "Show Status Box")
viewType     = input.string("Normal", "View Type", options=["Normal", "Compact"])
autoLevels   = input.bool(true, "AUTO Chart Levels")
manualLevels = input.bool(false, "MANUAL Chart Levels (only if AUTO is OFF)")
showHL       = input.bool(true, "Show High/Low Labels")
show50       = input.bool(true, "Show 50% Label")
bgColor      = input.color(color.new(color.black, 0), "Chart Background Color")

// Colors
colInvalid   = input.color(color.red,   "INVALID Color")
colStandby   = input.color(color.orange,"STANDBY Color")
colActive    = input.color(color.green, "ACTIVE Color")
colComplete  = input.color(color.green, "COMPLETE Color")

// ─────────────────────────────────────────────
// RESOLVE TIMEFRAME
// ─────────────────────────────────────────────
useTF = tfMode == "Chart" ? timeframe.period : fixedTF

// ─────────────────────────────────────────────
// FETCH OHLC FROM SELECTED TIMEFRAME
// ─────────────────────────────────────────────
tfOpen  = request.security(syminfo.tickerid, useTF, open,  lookahead=barmerge.lookahead_off)
tfHigh  = request.security(syminfo.tickerid, useTF, high,  lookahead=barmerge.lookahead_off)
tfLow   = request.security(syminfo.tickerid, useTF, low,   lookahead=barmerge.lookahead_off)
tfClose = request.security(syminfo.tickerid, useTF, close, lookahead=barmerge.lookahead_off)

tfPrevHigh  = request.security(syminfo.tickerid, useTF, high[1],  lookahead=barmerge.lookahead_off)
tfPrevLow   = request.security(syminfo.tickerid, useTF, low[1],   lookahead=barmerge.lookahead_off)
tfPrevClose = request.security(syminfo.tickerid, useTF, close[1], lookahead=barmerge.lookahead_off)
tfPrevOpen  = request.security(syminfo.tickerid, useTF, open[1],  lookahead=barmerge.lookahead_off)

// ─────────────────────────────────────────────
// CANDLE TYPE LOGIC (current TF candle)
// ─────────────────────────────────────────────
prev50      = (tfPrevHigh + tfPrevLow) / 2

isBullCandle = tfClose > tfOpen   // green
isBearCandle = tfClose < tfOpen   // red

// Candle relationship to previous
is2Up        = tfHigh > tfPrevHigh and tfLow >= tfPrevLow    // 2UP: higher high, no new low
is2Down      = tfLow  < tfPrevLow  and tfHigh <= tfPrevHigh  // 2DOWN: lower low, no new high
isInsideBar  = tfHigh <= tfPrevHigh and tfLow >= tfPrevLow   // Inside Bar (1)
isOutsideBar = tfHigh > tfPrevHigh  and tfLow < tfPrevLow    // Outside Bar (3)

// Strat candle numbers
// 1 = Inside, 2U = 2Up, 2D = 2Down, 3 = Outside

// SSS50 Conditions
// INVALID: Inside Bar OR Green 2UP OR Red 2DOWN
isInvalid    = isInsideBar or (is2Up and isBullCandle) or (is2Down and isBearCandle)

// STANDBY: Failed 2UP (Red 2UP) OR Failed 2DOWN (Green 2DOWN)
isFailed2Up  = is2Up and isBearCandle
isFailed2Dn  = is2Down and isBullCandle
isStandby    = (isFailed2Up or isFailed2Dn) and not isOutsideBar

// ACTIVE: Failed 2 AND has crossed over previous candle's 50% level
crossedAbove50 = isFailed2Dn and tfClose > prev50
crossedBelow50 = isFailed2Up and tfClose < prev50
isActive     = (crossedAbove50 or crossedBelow50) and not isOutsideBar

// COMPLETE: Outside Bar
isComplete   = isOutsideBar

// ─────────────────────────────────────────────
// DETERMINE STATUS
// ─────────────────────────────────────────────
statusText  = isComplete ? "COMPLETE"  :
              isActive   ? "ACTIVE"    :
              isStandby  ? "STANDBY"   :
              isInvalid  ? "INVALID"   : "INVALID"

subText     = isComplete  ? "Outside Bar Complete"   :
              isActive    ? "Outside Bar Possible"   :
              isFailed2Up ? "Failed 2U"              :
              isFailed2Dn ? "Failed 2D"              :
              isInsideBar ? "Inside Bar"             :
              is2Up       ? "2UP"                    :
              is2Down     ? "2DOWN"                  : ""

statusColor = isComplete  ? colComplete :
              isActive    ? colActive   :
              isStandby   ? colStandby  :
              colInvalid

// ─────────────────────────────────────────────
// STATUS BOX (Table)
// ─────────────────────────────────────────────
var table statusTable = table.new(position.top_right, 2, 3, bgcolor=color.new(color.gray, 80), border_width=1, border_color=color.gray)

if showBox and barstate.islast
    if viewType == "Normal"
        table.cell(statusTable, 0, 0, "SSS50", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.small)
        table.cell(statusTable, 1, 0, statusText, text_color=statusColor, bgcolor=color.new(color.gray,80), text_size=size.small)
        table.cell(statusTable, 0, 1, "Status", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
        table.cell(statusTable, 1, 1, subText, text_color=statusColor, bgcolor=color.new(color.gray,80), text_size=size.tiny)
        table.cell(statusTable, 0, 2, "TF", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
        table.cell(statusTable, 1, 2, useTF, text_color=color.white, bgcolor=color.new(color.gray,80), text_size=size.tiny)
    else
        // Compact
        table.cell(statusTable, 0, 0, "SSS50 | " + statusText + " | " + subText, text_color=statusColor, bgcolor=color.new(color.gray,80), text_size=size.tiny)
        table.cell(statusTable, 1, 0, useTF, text_color=color.white, bgcolor=color.new(color.gray,80), text_size=size.tiny)
        table.merge_cells(statusTable, 0, 1, 1, 1)
        table.merge_cells(statusTable, 0, 2, 1, 2)

// ─────────────────────────────────────────────
// LEVELS (Lines & Labels)
// ─────────────────────────────────────────────
showLevels = (autoLevels and not isInvalid) or (manualLevels and not autoLevels)

// Lines — redraw each bar using a simple approach
var line highLine = na
var line lowLine  = na
var line midLine  = na
var label highLbl = na
var label lowLbl  = na
var label midLbl  = na

if showLevels and barstate.islast
    // Delete previous
    line.delete(highLine)
    line.delete(lowLine)
    line.delete(midLine)
    label.delete(highLbl)
    label.delete(lowLbl)
    label.delete(midLbl)

    lineCol = statusColor
    lineStyle = line.style_dashed

    highLine := line.new(bar_index - 5, tfPrevHigh, bar_index + 20, tfPrevHigh, color=lineCol, style=lineStyle, width=1)
    lowLine  := line.new(bar_index - 5, tfPrevLow,  bar_index + 20, tfPrevLow,  color=lineCol, style=lineStyle, width=1)
    midLine  := line.new(bar_index - 5, prev50,     bar_index + 20, prev50,     color=lineCol, style=line.style_dotted, width=1)

    if showHL
        highLbl := label.new(bar_index + 10, tfPrevHigh, str.tostring(tfPrevHigh, format.mintick), color=color.new(lineCol, 20), textcolor=color.white, style=label.style_label_left, size=size.tiny)
        lowLbl  := label.new(bar_index + 10, tfPrevLow,  str.tostring(tfPrevLow,  format.mintick), color=color.new(lineCol, 20), textcolor=color.white, style=label.style_label_left, size=size.tiny)

    if show50
        midLbl := label.new(bar_index + 10, prev50, str.tostring(prev50, format.mintick) + " (50%)", color=color.new(lineCol, 20), textcolor=color.white, style=label.style_label_left, size=size.tiny)

// // ─────────────────────────────────────────────
// // BACKGROUND HIGHLIGHT when ACTIVE or COMPLETE
// // ─────────────────────────────────────────────
// bgcolor(isActive   ? color.new(color.green,  90) : na)
// bgcolor(isComplete ? color.new(color.blue,   90) : na)
// bgcolor(isStandby  ? color.new(color.orange, 95) : na)
