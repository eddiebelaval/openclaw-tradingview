//@version=6
indicator("Daily ATR Box Tool", overlay=true, max_boxes_count=50, max_labels_count=50)

//====================================================
// INPUTS
//====================================================
groupATR = "ATR Settings"
atrLen   = input.int(14, "ATR Length", minval=1, group=groupATR)
avgDays  = input.int(5, "ATR Average Reference Days", minval=1, group=groupATR)

groupBox = "ATR Box Display"
showHalfBox = input.bool(true, "Show 0.5 ATR Box", group=groupBox)
showFullBox = input.bool(true, "Show 1.0 ATR Box", group=groupBox)

groupTable = "Table"
showTable = input.bool(true, "Show Info Table", group=groupTable)
tablePosInput = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=groupTable)

groupStyle = "Style"
showDayOpenLine = input.bool(true, "Show Daily Open Line", group=groupStyle)

//====================================================
// TABLE POSITION
//====================================================
tablePos = switch tablePosInput
    "Top Left" => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left" => position.bottom_left
    => position.top_right

//====================================================
// DAILY DATA
//====================================================
dayOpen = request.security(syminfo.tickerid, "D", open, barmerge.gaps_off, barmerge.lookahead_off)
dailyATR = request.security(syminfo.tickerid, "D", ta.atr(atrLen), barmerge.gaps_off, barmerge.lookahead_off)
avgDailyATR = request.security(syminfo.tickerid, "D", ta.sma(ta.atr(atrLen), avgDays), barmerge.gaps_off, barmerge.lookahead_off)

todayHigh = request.security(syminfo.tickerid, "D", high, barmerge.gaps_off, barmerge.lookahead_off)
todayLow  = request.security(syminfo.tickerid, "D", low,  barmerge.gaps_off, barmerge.lookahead_off)

//====================================================
// LEVELS
//====================================================
halfATR = avgDailyATR * 0.5
fullATR = avgDailyATR * 1.0

upperHalf = dayOpen + halfATR
lowerHalf = dayOpen - halfATR

upperFull = dayOpen + fullATR
lowerFull = dayOpen - fullATR

tickSize = syminfo.mintick
avgAtrTicks = avgDailyATR / tickSize
todayRange = todayHigh - todayLow
todayRangeTicks = todayRange / tickSize
pctATRUsed = avgDailyATR > 0 ? (todayRange / avgDailyATR) * 100.0 : na
atrRemaining = avgDailyATR - todayRange
atrRemainingTicks = atrRemaining / tickSize

//====================================================
// DAY OPEN LINE
//====================================================
plot(showDayOpenLine ? dayOpen : na, "Daily Open", color=color.white, linewidth=2)

//====================================================
// BOXES
//====================================================
newDay = ta.change(time("D")) != 0

var box halfBox = na
var box fullBox = na

// start of current day on chart
var int dayStartBar = na
if newDay
    dayStartBar := bar_index

if na(dayStartBar)
    dayStartBar := bar_index

// Create fresh boxes at new day
if newDay
    if not na(halfBox)
        box.delete(halfBox)
    if not na(fullBox)
        box.delete(fullBox)

    if showHalfBox
        halfBox := box.new(
             left=bar_index,
             top=upperHalf,
             right=bar_index,
             bottom=lowerHalf,
             border_color=color.new(color.yellow, 0),
             bgcolor=color.new(color.yellow, 88)
         )

    if showFullBox
        fullBox := box.new(
             left=bar_index,
             top=upperFull,
             right=bar_index,
             bottom=lowerFull,
             border_color=color.new(color.aqua, 0),
             bgcolor=color.new(color.aqua, 92)
         )

// Update current day's boxes as bars progress
if not na(halfBox) and showHalfBox
    box.set_left(halfBox, dayStartBar)
    box.set_right(halfBox, bar_index)
    box.set_top(halfBox, upperHalf)
    box.set_bottom(halfBox, lowerHalf)

if not na(fullBox) and showFullBox
    box.set_left(fullBox, dayStartBar)
    box.set_right(fullBox, bar_index)
    box.set_top(fullBox, upperFull)
    box.set_bottom(fullBox, lowerFull)

//====================================================
// TABLE
//====================================================
var table t = table.new(tablePos, 2, 8, border_width=2)

f_price(v) =>
    str.tostring(v, format.mintick)

f_int(v) =>
    str.tostring(math.round(v))

if barstate.islast
    if showTable
        // Header
        table.cell(t, 0, 0, "Metric", text_color=color.white, bgcolor=color.rgb(25, 25, 25), text_size=size.large)
        table.cell(t, 1, 0, "Value",  text_color=color.white, bgcolor=color.rgb(25, 25, 25), text_size=size.large)

        // Rows
        table.cell(t, 0, 1, "Daily Open", text_color=color.white, bgcolor=color.rgb(45, 45, 45), text_size=size.normal)
        table.cell(t, 1, 1, f_price(dayOpen), text_color=color.white, bgcolor=color.rgb(45, 45, 45), text_size=size.normal)

        table.cell(t, 0, 2, "Daily ATR", text_color=color.white, bgcolor=color.rgb(35, 35, 35), text_size=size.normal)
        table.cell(t, 1, 2, f_price(dailyATR) + " (" + f_int(dailyATR / tickSize) + " ticks)", text_color=color.white, bgcolor=color.rgb(35, 35, 35), text_size=size.normal)

        table.cell(t, 0, 3, "Avg ATR (" + str.tostring(avgDays) + "D)", text_color=color.white, bgcolor=color.rgb(45, 45, 45), text_size=size.normal)
        table.cell(t, 1, 3, f_price(avgDailyATR) + " (" + f_int(avgAtrTicks) + " ticks)", text_color=color.white, bgcolor=color.rgb(45, 45, 45), text_size=size.normal)

        table.cell(t, 0, 4, "0.5 ATR", text_color=color.white, bgcolor=color.rgb(35, 35, 35), text_size=size.normal)
        table.cell(t, 1, 4, f_price(halfATR) + " (" + f_int(avgAtrTicks * 0.5) + " ticks)", text_color=color.white, bgcolor=color.rgb(35, 35, 35), text_size=size.normal)

        table.cell(t, 0, 5, "Today's Range", text_color=color.white, bgcolor=color.rgb(45, 45, 45), text_size=size.normal)
        table.cell(t, 1, 5, f_price(todayRange) + " (" + f_int(todayRangeTicks) + " ticks)", text_color=color.white, bgcolor=color.rgb(45, 45, 45), text_size=size.normal)

        table.cell(t, 0, 6, "% ATR Used", text_color=color.white, bgcolor=color.rgb(35, 35, 35), text_size=size.normal)
        table.cell(t, 1, 6, str.tostring(pctATRUsed, "#.##") + "%", text_color=color.white, bgcolor=color.rgb(35, 35, 35), text_size=size.normal)

        table.cell(t, 0, 7, "ATR Remaining", text_color=color.white, bgcolor=color.rgb(45, 45, 45), text_size=size.normal)
        table.cell(t, 1, 7, f_price(atrRemaining) + " (" + f_int(atrRemainingTicks) + " ticks)", text_color=color.white, bgcolor=color.rgb(45, 45, 45), text_size=size.normal)
    else
        table.clear(t, 0, 0, 1, 7)
