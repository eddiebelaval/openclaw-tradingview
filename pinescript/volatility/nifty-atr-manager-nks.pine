//@version=6
indicator("Nifty ATR Manager", overlay=true, max_lines_count=500, max_labels_count=500)

// ==================== 📊 INPUT PARAMETERS ====================

// --- 1. ATR Settings ---
atr_period = input.int(14, "ATR Period", minval=1, maxval=100, group="1. ATR Settings",
     tooltip="Number of periods for ATR calculation (Default: 14)")
smoothing_method = input.string("RMA", "Smoothing Method", 
     options=["RMA", "SMA", "EMA", "WMA"], group="1. ATR Settings",
     tooltip="Moving average type for ATR calculation")
atr_source = input.source(hl2, "ATR Source", group="1. ATR Settings",
     tooltip="Price source for ATR calculation (Default: (High+Low)/2)")

// --- Multi-Timeframe Settings (Advanced) ---
use_mtf = input.bool(false, "Use Multi-Timeframe", group="1. ATR Settings",
     tooltip="Enable to view ATR from higher timeframe")
mtf_timeframe = input.timeframe("", "MTF Timeframe", group="1. ATR Settings",
     tooltip="Higher timeframe for MTF ATR (leave empty for chart timeframe)")
wait_for_close = input.bool(true, "Wait for Timeframe Close", group="1. ATR Settings",
     tooltip="Prevents repainting when using MTF")

// --- 2. Multipliers ---
sl_multiplier = input.float(1.5, "Stop Loss Multiplier", minval=0.1, step=0.1, group="2. Multipliers",
     tooltip="Multiplier for stop loss distance (Nifty intraday: 1.0-1.5 recommended)")
tp1_multiplier = input.float(1.0, "TP1 Multiplier", minval=0.0, step=0.1, group="2. Multipliers",
     tooltip="Multiplier for first take profit target")
tp2_multiplier = input.float(2.0, "TP2 Multiplier", minval=0.0, step=0.1, group="2. Multipliers",
     tooltip="Multiplier for second take profit target")

// --- 3. Table Settings ---
show_table = input.bool(true, "Show Table", group="3. Table Settings",
     tooltip="Display ATR information table on chart")
table_position_str = input.string("Top Right", "Table Position", 
     options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"],
     group="3. Table Settings")

// --- 4. Visual Settings ---
atr_line_color = input.color(color.new(#FF9800, 0), "ATR Line Color", group="4. Visual Settings")
sl_long_color = input.color(color.new(#FF5252, 0), "SL Long Color", group="4. Visual Settings")
sl_short_color = input.color(color.new(#4CAF50, 0), "SL Short Color", group="4. Visual Settings")
tp_color = input.color(color.new(#2196F3, 0), "TP Lines Color", group="4. Visual Settings")
show_sl_lines = input.bool(true, "Show Stop Loss Lines", group="4. Visual Settings")
show_tp_lines = input.bool(true, "Show Target Lines", group="4. Visual Settings")
show_atr_label = input.bool(true, "Show ATR Value Label", group="4. Visual Settings")

// ==================== 🧮 CORE ATR CALCULATION ====================

// Calculate True Range (not using built-in ta.atr directly for custom smoothing)
true_range = ta.tr(true)

// Apply selected smoothing method to True Range
calculateATR(tr, period, method) =>
    switch method
        "RMA" => ta.rma(tr, period)
        "SMA" => ta.sma(tr, period)
        "EMA" => ta.ema(tr, period)
        "WMA" => ta.wma(tr, period)
        => ta.rma(tr, period)  // Default to RMA

// Calculate ATR based on current timeframe
atr_value = calculateATR(true_range, atr_period, smoothing_method)

// Multi-Timeframe ATR calculation (if enabled)
mtf_atr_value = use_mtf ? 
     request.security(syminfo.tickerid, mtf_timeframe == "" ? timeframe.period : mtf_timeframe, 
          calculateATR(ta.tr(true), atr_period, smoothing_method), 
          gaps=wait_for_close ? barmerge.gaps_off : barmerge.gaps_on) : 
     atr_value

// Use MTF ATR if enabled, otherwise use regular ATR
final_atr = use_mtf ? mtf_atr_value : atr_value

// ==================== 📈 STOP LOSS & TARGET LEVELS ====================

// For Long/Buy Positions
stop_loss_long = low - (final_atr * sl_multiplier)
tp1_long = close + (final_atr * tp1_multiplier)
tp2_long = close + (final_atr * tp2_multiplier)

// For Short/Sell Positions
stop_loss_short = high + (final_atr * sl_multiplier)
tp1_short = close - (final_atr * tp1_multiplier)
tp2_short = close - (final_atr * tp2_multiplier)

// ==================== 🎨 PLOTTING ====================

// Plot Stop Loss Lines
plot(show_sl_lines ? stop_loss_long : na, 
     title="Long Stop Loss", 
     color=sl_long_color, 
     linewidth=2, 
     style=plot.style_linebr,
     trackprice=false)

plot(show_sl_lines ? stop_loss_short : na, 
     title="Short Stop Loss", 
     color=sl_short_color, 
     linewidth=2, 
     style=plot.style_linebr,
     trackprice=false)

// Plot Take Profit Lines
plot(show_tp_lines ? tp1_long : na, 
     title="Long TP1", 
     color=color.new(tp_color, 50), 
     linewidth=1, 
     style=plot.style_circles)

plot(show_tp_lines ? tp2_long : na, 
     title="Long TP2", 
     color=color.new(tp_color, 30), 
     linewidth=1, 
     style=plot.style_circles)

plot(show_tp_lines ? tp1_short : na, 
     title="Short TP1", 
     color=color.new(tp_color, 50), 
     linewidth=1, 
     style=plot.style_circles)

plot(show_tp_lines ? tp2_short : na, 
     title="Short TP2", 
     color=color.new(tp_color, 30), 
     linewidth=1, 
     style=plot.style_circles)

// ==================== 🏷️ ATR VALUE LABEL ====================

// Show current ATR value as label on chart
if show_atr_label and barstate.islast
    label.new(
         x=bar_index,
         y=high,
         text="ATR: " + str.tostring(final_atr, "#.##"),
         style=label.style_label_down,
         color=atr_line_color,
         textcolor=color.white,
         size=size.large
         )

// ==================== 📊 INFORMATION TABLE ====================

// Convert table position string to position constant
getTablePosition(pos_str) =>
    switch pos_str
        "Top Right" => position.top_right
        "Top Left" => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left" => position.bottom_left
        "Middle Right" => position.middle_right
        "Middle Left" => position.middle_left
        => position.top_right

// Create table
if show_table
    var table info_table = table.new(getTablePosition(table_position_str), 2, 8, 
         bgcolor=color.new(color.black, 85), 
         border_width=2, 
         border_color=atr_line_color,
         frame_width=2,
         frame_color=atr_line_color)
    
    if barstate.islast
        // Header
        table.cell(info_table, 0, 0, "📊 Nifty ATR Manager", 
             text_color=color.white, bgcolor=color.new(atr_line_color, 20), 
             text_size=size.normal, text_halign=text.align_center)
        table.merge_cells(info_table, 0, 0, 1, 0)
        
        // ATR Information
        table.cell(info_table, 0, 1, "ATR (" + str.tostring(atr_period) + ")", 
             text_color=color.white, text_size=size.normal)
        table.cell(info_table, 1, 1, str.tostring(final_atr, "#.##") + " pts", 
             text_color=color.yellow, text_size=size.normal, text_halign=text.align_right)
        
        // Smoothing Method
        table.cell(info_table, 0, 2, "Method", 
             text_color=color.white, text_size=size.small)
        table.cell(info_table, 1, 2, smoothing_method + (use_mtf ? " (MTF)" : ""), 
             text_color=color.gray, text_size=size.small, text_halign=text.align_right)
        
        // Stop Loss Distance
        sl_distance = final_atr * sl_multiplier
        table.cell(info_table, 0, 3, "SL Distance (" + str.tostring(sl_multiplier, "#.#") + "x)", 
             text_color=color.white, text_size=size.normal)
        table.cell(info_table, 1, 3, str.tostring(sl_distance, "#.##") + " pts", 
             text_color=color.new(color.red, 0), text_size=size.normal, text_halign=text.align_right)
        
        // TP1 Distance
        tp1_distance = final_atr * tp1_multiplier
        table.cell(info_table, 0, 4, "TP1 (" + str.tostring(tp1_multiplier, "#.#") + "x)", 
             text_color=color.white, text_size=size.small)
        table.cell(info_table, 1, 4, str.tostring(tp1_distance, "#.##") + " pts", 
             text_color=color.new(color.green, 0), text_size=size.small, text_halign=text.align_right)
        
        // TP2 Distance
        tp2_distance = final_atr * tp2_multiplier
        table.cell(info_table, 0, 5, "TP2 (" + str.tostring(tp2_multiplier, "#.#") + "x)", 
             text_color=color.white, text_size=size.small)
        table.cell(info_table, 1, 5, str.tostring(tp2_distance, "#.##") + " pts", 
             text_color=color.new(color.green, 30), text_size=size.small, text_halign=text.align_right)
        
        // Daily True Range %
        dtr_percent = (true_range / final_atr) * 100
        table.cell(info_table, 0, 6, "DTR %", 
             text_color=color.white, text_size=size.small,
             tooltip="Daily True Range as % of ATR")
        table.cell(info_table, 1, 6, str.tostring(dtr_percent, "#.#") + "%", 
             text_color=dtr_percent > 100 ? color.orange : color.gray, 
             text_size=size.small, text_halign=text.align_right)
        
        // Risk-Reward Ratio
        risk_reward = tp1_multiplier / sl_multiplier
        table.cell(info_table, 0, 7, "R:R (TP1)", 
             text_color=color.white, text_size=size.small,
             tooltip="Risk to Reward Ratio (TP1)")
        table.cell(info_table, 1, 7, "1:" + str.tostring(risk_reward, "#.##"), 
             text_color=risk_reward >= 2 ? color.lime : color.yellow, 
             text_size=size.small, text_halign=text.align_right)

// ==================== 📉 SEPARATE PANE ATR PLOT (OPTIONAL) ====================
// Uncomment the following line to add ATR as oscillator in separate pane
// Note: Change overlay=true to overlay=false in indicator() declaration above
// plot(final_atr, title="ATR Value", color=atr_line_color, linewidth=2)

// ==================== 🚨 ALERTS ====================

// High volatility alert (ATR exceeds 1.5x of 20-period average)
atr_avg = ta.sma(final_atr, 20)
high_volatility = final_atr > (atr_avg * 1.5)

alertcondition(high_volatility and not high_volatility[1], 
     title="High Volatility Alert",
     message="NIFTY: ATR has spiked above 1.5x average. Current ATR: {{plot_0}}")

// Low volatility alert (ATR below 0.7x of 20-period average)
low_volatility = final_atr < (atr_avg * 0.7)

alertcondition(low_volatility and not low_volatility[1],
     title="Low Volatility Alert",
     message="NIFTY: ATR has dropped below 0.7x average. Current ATR: {{plot_0}}")

// Background color for volatility regime
bgcolor(high_volatility ? color.new(color.red, 95) : 
     low_volatility ? color.new(color.green, 95) : na, 
     title="Volatility Regime")

// ==================== 📝 RISK MANAGEMENT HELPERS ====================

// Calculate position size based on risk percentage
// Example: For 2% risk on 100,000 capital with SL of 367 points
// Position Size = (100,000 * 0.02) / (367 * lot_size)
// For Nifty: lot_size = 25 (as of 2024)

// Add helpful comments visible in code
// Nifty Intraday Guidelines:
// - 1-3 min charts: Use ATR(14) with 1.0-1.2x multiplier
// - 5-15 min charts: Use ATR(14) with 1.2-1.5x multiplier  
// - 15-60 min charts: Use ATR(14) with 1.5-2.0x multiplier
// - Position sizing: Risk 1-2% of capital per trade
// - For Nifty Futures (lot size 25): Adjust quantity based on SL distance

// ==================== 🔍 DEBUGGING & VALIDATION ====================
// Plot for validation against built-in ta.atr() when smoothing = RMA
// builtin_atr = ta.atr(atr_period)
// plot(builtin_atr, title="Built-in ATR (Validation)", color=color.purple, display=display.none)
// Verify that final_atr matches builtin_atr when smoothing_method == "RMA"

// ==================== 📊 ADDITIONAL FEATURES ====================

// Volatility Classification
volatility_state = final_atr > atr_avg * 1.3 ? "High" : 
     final_atr < atr_avg * 0.8 ? "Low" : "Normal"

// Add label showing volatility state
if barstate.islast and show_atr_label
    var label vol_state_label = label.new(
         x=bar_index - 10,
         y=low,
         text="Vol: " + volatility_state,
         style=label.style_label_up,
         color=volatility_state == "High" ? color.red : 
              volatility_state == "Low" ? color.green : color.gray,
         textcolor=color.white,
         size=size.small
         )
    label.set_xy(vol_state_label, bar_index - 10, low)
    label.set_text(vol_state_label, "Vol: " + volatility_state)
    label.set_color(vol_state_label, 
         volatility_state == "High" ? color.red : 
         volatility_state == "Low" ? color.green : color.gray)

// ==================== END OF SCRIPT ====================
// Script developed according to requirements document
// Optimized for Nifty 50 Index but works on all asset classes
// Pine Script v6 - No repainting (except MTF with user consent)
// All parameters are user-configurable via inputs
// Code is heavily commented for easy understanding and modification
