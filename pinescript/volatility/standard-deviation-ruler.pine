//@version=6
indicator("𝕜 | Standard Deviation Ruler", overlay = true)

type cfgSTDV
    string anchorPeriod
    int len
    float source

    float bMult1
    float bMult2
    float bMult3

    int offset
    int lineLen

type cssSTDV
    color centerClr
    int centerW
    
    color upperAClr
    color lowerAClr
    int AWd

    color upperBClr
    color lowerBClr
    int BWd

    color upperCClr
    color lowerCClr
    int CWd

    color bgClr

string confGroup = "Configuration\n________________________________________________________"

cfgSTDV cfgSTDVObj = cfgSTDV.new(
    anchorPeriod = input.string("Auto", "Anchor Period", options = ["Auto", "Highest High", "Lowest Low", "Highest Volume", "Session", "Week", "Month", "Year", "Earnings", "Dividends", "Splits"]),
    len = input.int(14, "Length", minval = 1, tooltip = "Applies to Highest High, Lowest Low and Highest Volume anchor periods."),
    source = input.source(close, "Source"),
    offset = input.int(5, 'Offset', minval = 2, maxval = 50),
    lineLen = input.int(10, 'Line Length', minval = 2, maxval = 50),
    bMult1 = input.float(1.0, "—A", step = 0.1, inline = 'A', group = confGroup),
    bMult2 = input.float(2.0, "—B", step = 0.1, inline = 'B', group = confGroup),
    bMult3 = input.float(2.5, "—C", step = 0.1, inline = 'C', group = confGroup))


cssSTDV cssSTDVObj = cssSTDV.new(
    
    upperAClr = input.color(color.new(color.white, 50), "+", group = confGroup, inline = 'A'),
    lowerAClr = input.color(color.new(color.white, 50), "-",   group = confGroup, inline = 'A'),
    AWd       = input.int(1, '', minval = 1, maxval = 5, group = confGroup, inline = 'A'),

    upperBClr = input.color(color.new(color.white, 50), title = "+", group = confGroup, inline = 'B'),
    lowerBClr = input.color(color.new(color.white, 50), title = "-", group = confGroup, inline = 'B'),
    BWd       = input.int(1, title = '', minval = 1, maxval = 5, group = confGroup, inline = 'B'),

    upperCClr = input.color(color.new(color.white, 50), title = "+", group = confGroup, inline = 'C'),
    lowerCClr = input.color(color.new(color.white, 50), title = "-", group = confGroup, inline = 'C'),
    CWd       = input.int(1, title = '', minval = 1, maxval = 5, group = confGroup, inline = 'C'),
    
    centerClr = input.color(color.new(color.white, 50), "CENTER", group = confGroup, inline = 'center'),
    centerW = input.int(1, "", minval = 1, maxval = 5, group = confGroup, inline = 'center'),
    bgClr = input.color(color.new(color.white, 90), "BACKGROUND", group = confGroup))

type STDVData
    float vwap
    float devUA
    float devLA
    float devUB
    float devLB
    float devUC
    float devLC

    chart.point devUAPt1
    chart.point devUAPt2
    string devUALblTxt
    chart.point devLAPt1
    chart.point devLAPt2
    string devLALblTxt
    
    chart.point devUBPt1
    chart.point devUBPt2
    string devUBLblTxt
    chart.point devLBPt1
    chart.point devLBPt2
    string devLBLblTxt

    chart.point devUCPt1
    chart.point devUCPt2
    string devUCLblTxt
    chart.point devLCPt1
    chart.point devLCPt2
    string devLCLblTxt

    chart.point centerPt1
    chart.point centerPt2
    string centerLblTxt

    chart.point pricePt2
    string priceLblTxt

calcDevPoints(source, anchorPeriod, len) =>
    [vwap, devUA, devLA] = ta.vwap(source, timeframe.change('1D'), stdev_mult = cfgSTDVObj.bMult1)
    [discard_00, devUB, devLB] = ta.vwap(source, timeframe.change('1D'), stdev_mult = cfgSTDVObj.bMult2)
    [discard_01, devUC, devLC] = ta.vwap(source, timeframe.change('1D'), stdev_mult = cfgSTDVObj.bMult3)

    devUAPt1 = chart.point.new(0, bar_index + cfgSTDVObj.offset, devUA)
    devUAPt2 = chart.point.new(0, bar_index + cfgSTDVObj.offset + cfgSTDVObj.lineLen, devUA)
    devUALblTxt = '+' + str.tostring(cfgSTDVObj.bMult1) + ' σ'

    devLAPt1 = chart.point.new(0, bar_index + cfgSTDVObj.offset, devLA)
    devLAPt2 = chart.point.new(0, bar_index + cfgSTDVObj.offset + cfgSTDVObj.lineLen, devLA)
    devLALblTxt = '-' + str.tostring(cfgSTDVObj.bMult1) + ' σ'

    devUBPt1 = chart.point.new(0, bar_index + cfgSTDVObj.offset, devUB)
    devUBPt2 = chart.point.new(0, bar_index + cfgSTDVObj.offset + cfgSTDVObj.lineLen, devUB)
    devUBLblTxt = '+' + str.tostring(cfgSTDVObj.bMult2) + ' σ'

    devLBPt1 = chart.point.new(0, bar_index + cfgSTDVObj.offset, devLB)
    devLBPt2 = chart.point.new(0, bar_index + cfgSTDVObj.offset + cfgSTDVObj.lineLen, devLB)
    devLBLblTxt = '-' + str.tostring(cfgSTDVObj.bMult2) + ' σ'

    devUCPt1 = chart.point.new(0, bar_index + cfgSTDVObj.offset, devUC)
    devUCPt2 = chart.point.new(0, bar_index + cfgSTDVObj.offset + cfgSTDVObj.lineLen, devUC)
    devUCLblTxt = '+' + str.tostring(cfgSTDVObj.bMult3) + ' σ'

    devLCPt1 = chart.point.new(0, bar_index + cfgSTDVObj.offset, devLC)
    devLCPt2 = chart.point.new(0, bar_index + cfgSTDVObj.offset + cfgSTDVObj.lineLen, devLC)
    devLCLblTxt = '-' + str.tostring(cfgSTDVObj.bMult3) + ' σ'

    centerPt1 = chart.point.new(0, bar_index + cfgSTDVObj.offset, vwap)
    centerPt2 = chart.point.new(0, bar_index + cfgSTDVObj.offset + cfgSTDVObj.lineLen, vwap)
    centerLblTxt = '0 σ'

    // Calculate the current standard deviation level of price relative to VWAP
    stdevLevel = (source - vwap) / (devUA - vwap)
    priceLblTxt = (math.sign(stdevLevel) == 1 ? '+': '') + str.tostring(math.round(stdevLevel, 2)) + ' σ'
    pricePt2 = chart.point.new(0, bar_index + cfgSTDVObj.offset + cfgSTDVObj.lineLen, close)


    dvDataObj = STDVData.new(vwap, devUA, devLA, devUB, devLB, devUC, devLC, 
         devUAPt1, devUAPt2, devUALblTxt, devLAPt1, devLAPt2, devLALblTxt, 
         devUBPt1, devUBPt2, devUBLblTxt, devLBPt1, devLBPt2, devLBLblTxt, 
         devUCPt1, devUCPt2, devUCLblTxt, devLCPt1, devLCPt2, devLCLblTxt, 
         centerPt1, centerPt2, centerLblTxt, pricePt2, priceLblTxt)
    dvDataObj

type STDVDrawObj
    STDVData dvData
    line upperALine
    line lowerALine
    line upperBLine
    line lowerBLine
    line upperCLine
    line lowerCLine
    line centerLine
    line priceLine
    box bgBox

    label upperALabel
    label lowerALabel
    label upperBLabel
    label lowerBLabel
    label upperCLabel
    label lowerCLabel
    label centerLabel
    label priceLabel

drawSTDVObject(dvData, drawObj) =>
    if not na(dvData)
        line upperALine = line.new(dvData.devUAPt1, dvData.devUAPt2, width = cssSTDVObj.AWd, color = cssSTDVObj.upperAClr)
        label upperALabel = label.new(dvData.devUAPt2, dvData.devUALblTxt, xloc.bar_index, yloc.price, color = color.new(color.black, 100), textcolor = cssSTDVObj.upperAClr, style = label.style_label_left, size = size.normal, text_font_family = font.family_monospace)
        
        line lowerALine = line.new(dvData.devLAPt1, dvData.devLAPt2, width = cssSTDVObj.AWd, color = cssSTDVObj.lowerAClr)
        label lowerALabel = label.new(dvData.devLAPt2, dvData.devLALblTxt, xloc.bar_index, yloc.price, color = color.new(color.black, 100), textcolor = cssSTDVObj.lowerAClr, style = label.style_label_left, size = size.normal, text_font_family = font.family_monospace)

        line upperBLine = line.new(dvData.devUBPt1, dvData.devUBPt2, width = cssSTDVObj.BWd, color = cssSTDVObj.upperBClr)
        label upperBLabel = label.new(dvData.devUBPt2, dvData.devUBLblTxt, xloc.bar_index, yloc.price, color = color.new(color.black, 100), textcolor = cssSTDVObj.upperBClr, style = label.style_label_left, size = size.normal, text_font_family = font.family_monospace)

        line lowerBLine = line.new(dvData.devLBPt1, dvData.devLBPt2, width = cssSTDVObj.BWd, color = cssSTDVObj.lowerBClr)
        label lowerBLabel = label.new(dvData.devLBPt2, dvData.devLBLblTxt, xloc.bar_index, yloc.price, color = color.new(color.black, 100), textcolor = cssSTDVObj.lowerBClr, style = label.style_label_left, size = size.normal, text_font_family = font.family_monospace)

        line upperCLine = line.new(dvData.devUCPt1, dvData.devUCPt2, width = cssSTDVObj.CWd, color = cssSTDVObj.upperCClr)
        label upperCLabel = label.new(dvData.devUCPt2, dvData.devUCLblTxt, xloc.bar_index, yloc.price, color = color.new(color.black, 100), textcolor = cssSTDVObj.upperCClr, style = label.style_label_left, size = size.normal, text_font_family = font.family_monospace)

        line lowerCLine = line.new(dvData.devLCPt1, dvData.devLCPt2, width = cssSTDVObj.CWd, color = cssSTDVObj.lowerCClr)
        label lowerCLabel = label.new(dvData.devLCPt2, dvData.devLCLblTxt, xloc.bar_index, yloc.price, color = color.new(color.black, 100), textcolor = cssSTDVObj.lowerCClr, style = label.style_label_left, size = size.normal, text_font_family = font.family_monospace)

        line centerLine = line.new(dvData.centerPt1, dvData.centerPt2, width = cssSTDVObj.centerW, color = cssSTDVObj.centerClr)
        label centerLabel = label.new(dvData.centerPt2, dvData.centerLblTxt, xloc.bar_index, yloc.price, color = color.new(color.black, 100), textcolor = cssSTDVObj.centerClr, style = label.style_label_left, size = size.normal, text_font_family = font.family_monospace)

        line priceLine = line.new(chart.point.new(0, bar_index, close), dvData.pricePt2, width = cssSTDVObj.centerW, color = color.new(cssSTDVObj.centerClr, 0))
        label priceLabel = label.new(dvData.pricePt2, dvData.priceLblTxt, xloc.bar_index, yloc.price, color = color.new(color.black, 100), textcolor = cssSTDVObj.centerClr, style = label.style_label_left, size = size.normal, text_font_family = font.family_monospace)

        box bgBox = box.new(dvData.devUAPt1, dvData.devLAPt2, color.new(color.black, 100), border_width = 0, bgcolor = cssSTDVObj.bgClr)

        drawObject = STDVDrawObj.new(dvData, upperALine, lowerALine, upperBLine, lowerBLine, upperCLine, lowerCLine, centerLine, priceLine, bgBox, upperALabel, lowerALabel, upperBLabel, lowerBLabel, upperCLabel, lowerCLabel, centerLabel, priceLabel)
        drawObject

dvData = calcDevPoints(cfgSTDVObj.source, cfgSTDVObj.anchorPeriod, cfgSTDVObj.len)
var STDVDrawObj drawObj = na

if not na(drawObj)
    line.delete(drawObj.upperALine)
    line.delete(drawObj.lowerALine)
    line.delete(drawObj.upperBLine)
    line.delete(drawObj.lowerBLine)
    line.delete(drawObj.upperCLine)
    line.delete(drawObj.lowerCLine)
    line.delete(drawObj.centerLine)
    line.delete(drawObj.priceLine)

    label.delete(drawObj.upperALabel)
    label.delete(drawObj.lowerALabel)
    label.delete(drawObj.upperBLabel)
    label.delete(drawObj.lowerBLabel)
    label.delete(drawObj.upperCLabel)
    label.delete(drawObj.lowerCLabel)
    label.delete(drawObj.centerLabel)
    label.delete(drawObj.priceLabel)

    box.delete(drawObj.bgBox)

drawObj := drawSTDVObject(dvData, drawObj)
