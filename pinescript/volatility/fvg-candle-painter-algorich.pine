//@version=6
indicator('FVG Candle Painter [AlgoRich]', overlay = true)

// --- Configuración ---
group_colors = 'Colores'
c_bull = input.color(color.new(color.green, 0), 'Color FVG Alcista', group = group_colors)
c_bear = input.color(color.new(color.red, 0), 'Color FVG Bajista', group = group_colors)

group_filter = 'Filtro de Tamaño'
use_filter = input.bool(true, '¿Filtrar FVG pequeños?', group = group_filter)
atr_length = input.int(14, 'Longitud ATR', group = group_filter)
atr_multi = input.float(0.5, 'Multiplicador ATR (Umbral)', step = 0.1, tooltip = 'El tamaño del hueco debe ser mayor que el ATR x este valor. Aumenta este número para filtrar más.', group = group_filter)

// --- Cálculos ---
atr_val = ta.atr(atr_length)

// Tamaño del Gap Alcista (Low actual - High de hace 2 velas)
gap_bull_size = low - high[2]
// Tamaño del Gap Bajista (Low de hace 2 velas - High actual)
gap_bear_size = low[2] - high

// --- Condiciones FVG ---
// 1. Debe existir el hueco
is_fvg_bull = low > high[2] and close[1] > open[1]
is_fvg_bear = high < low[2] and close[1] < open[1]

// 2. Aplicar el Filtro de Tamaño (Si está activado)
// Si el tamaño del hueco es menor que (ATR * Multiplicador), lo ignoramos.
filter_pass_bull = use_filter ? gap_bull_size > atr_val * atr_multi : true
filter_pass_bear = use_filter ? gap_bear_size > atr_val * atr_multi : true

// --- Resultado Final ---
valid_bull = is_fvg_bull and filter_pass_bull
valid_bear = is_fvg_bear and filter_pass_bear

// --- Pintar ---
// Usamos offset=-1 para pintar la vela que generó el imbalance
barcolor(valid_bull ? c_bull : na, offset = -1, title = 'FVG Alcista')
barcolor(valid_bear ? c_bear : na, offset = -1, title = 'FVG Bajista')
