//@version=6
indicator("TP RSI + EMA Band Signale", overlay=true)

// === Inputs ===
src = input.source(close, "Source")
rsi_len = input.int(50, "RSI Period", minval=2)
ema_len = input.int(206, "Signal EMA Length")
matype = input.string("EMA", "Signal EMA Type", options=["EMA","SMA","WMA","HMA","RMA","ALMA"])
bb_len = input.int(50, "BB Length")
bb_mult = input.float(2.0, "BB Mult")
bb_max_width = input.float(22.0, "Max BB Width (Squeeze)")
ema89_len = input.int(89, "EMA Length")
ema89_type = input.string("EMA", "EMA Type", options=["EMA","SMA","WMA","HMA","RMA","ALMA"])
ema89_color = input.color(color.new(color.white, 40), "EMA Color")
ema89_width = input.int(3, "EMA Line Width")
ema50_len = input.int(50, "Signal Band EMA Length")

// === MA Function ===
f_ma(src, len, type) =>
    float out = na
    if type == "EMA"
        out := ta.ema(src, len)
    else if type == "SMA"
        out := ta.sma(src, len)
    else if type == "WMA"
        out := ta.wma(src, len)
    else if type == "HMA"
        out := ta.hma(src, len)
    else if type == "RMA"
        out := ta.rma(src, len)
    else
        out := ta.ema(src, len)
    out

// === RSI & EMA ===
rsi = ta.rsi(src, rsi_len)
ema5 = f_ma(rsi, ema_len, matype)

// === EMA ===
ema89 = f_ma(close, ema89_len, ema89_type)
plot(ema89, "EMA", color=ema89_color, linewidth=ema89_width)

// === EMA Direction ===
ema_turn_up = ema5 > ema5[1]
ema_turn_down = ema5 < ema5[1]

// === Bollinger Bands on RSI ===
bb_basis = ta.sma(rsi, bb_len)
bb_dev = bb_mult * ta.stdev(rsi, bb_len)
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev
bb_width = bb_upper - bb_lower

// === Squeeze ===
var bool squeeze_active = false
if bb_width < bb_max_width
    squeeze_active := true

bb_expanding = bb_upper > bb_upper[1] and bb_lower < bb_lower[1]

// === Entries ===
strong_long = squeeze_active and bb_expanding and ema_turn_up
strong_short = squeeze_active and bb_expanding and ema_turn_down

if strong_long or strong_short
    squeeze_active := false

small_long = ema_turn_up and not strong_long
small_short = ema_turn_down and not strong_short

// === Plot Signals ===
plotshape(small_long, title="Small Long", style=shape.circle, location=location.belowbar, color=color.lime, size=size.tiny)
plotshape(small_short, title="Small Short", style=shape.circle, location=location.abovebar, color=color.red, size=size.tiny)
plotshape(strong_long, title="Strong Long", style=shape.circle, location=location.belowbar, color=color.lime, size=size.small)
plotshape(strong_short, title="Strong Short", style=shape.circle, location=location.abovebar, color=color.red, size=size.small)

// === SIGNAL BAND EMA ===
ema50 = ta.ema(close, ema50_len)

// Signal-State (holds last direction)
var int signal_state = 0
signal_state :=
     (strong_long or small_long)  ?  1 :
     (strong_short or small_short)? -1 :
     signal_state[1]

// === Detect color change ===
signal_changed = signal_state != signal_state[1]

// === Band color ===
band_color =
     signal_state > 0 ? color.new(color.green, 0) :
     signal_state < 0 ? color.new(color.red, 0) :
     color.new(color.gray, 60)

// === Plot Band ===
plot(ema50, "Signal Band EMA", color=band_color, linewidth=2)

// === SINGLE ALERT: Color change ===
alertcondition(
    signal_changed,
    title="Signal Band EMA Farbwechsel",
    message="Signal Band EMA hat die Farbe gewechselt | {{ticker}} | TF {{interval}}"
)
