//@version=6
// Extended from script from (Math by Thomas) 
//    - https://www.tradingview.com/script/MWsKGNKn-Anchored-VWAP-by-Time-Math-by-Thomas/
//
// Updated so input.time is confirm=true, when you choose from indicators/favorites 
//    this will prompt you to choose a time on the chart and that time will be used 
//     even if it is on a one minute chart
//
//  Known "issue": The timestamp in the status bar is UTC, have tried various ways to get 
//    the value to show as eastern, etc without success
indicator("Anchored VWAP by Time (MatteoArroz)", overlay=true)

// === INPUTS ===

// Date selector
selectedDate = input.time(title="Select Date", defval=0, confirm=true, display=display.status_line)

// Extract date parts
yearVar = year(selectedDate)
monthVar = month(selectedDate)
dayVar = dayofmonth(selectedDate)
hourVar = hour(selectedDate)
minuteVar = minute(selectedDate)

// Build final timestamp
startDate = timestamp("America/New_York", yearVar, monthVar, dayVar, hourVar, minuteVar)

// === VWAP Logic ===
var float cumVol = na
var float cumPV = na
var float vwapVal = na
var bool inVWAP = false

if (time >= startDate)
    inVWAP := true

if inVWAP
    cumVol := na(cumVol) ? volume : cumVol + volume
    cumPV := na(cumPV) ? close * volume : cumPV + close * volume
    vwapVal := cumPV / cumVol

// === Plot ===
plot(vwapVal, title="Anchored VWAP", color=color.new(color.white, 10), linewidth=2, linestyle = plot.linestyle_dashed)

var int crossCount = 0

vwapValCrossHigh = (ta.cross(high, vwapVal))
vwapValCrossLow = (ta.cross(low, vwapVal))

if (vwapValCrossHigh or vwapValCrossLow)
    crossCount += 1

plot(crossCount, title="Price Cross Count", display = display.status_line)
