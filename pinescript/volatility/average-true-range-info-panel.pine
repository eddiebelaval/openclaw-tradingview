//@version=5
indicator("ATR Panel", overlay=true)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
atrLength = input.int(14, "ATR Length", minval=1)

// ─────────────────────────────────────────────
// ATR CALCULATION
// ─────────────────────────────────────────────
atr    = ta.atr(atrLength)
anchor = close[1]

atr05Up   = anchor + (atr * 0.5)
atr05Down = anchor - (atr * 0.5)
atr10Up   = anchor + atr
atr10Down = anchor - atr

// 1.0 ATR dollar range value
atr10Range = atr10Up - atr10Down  // = 2 * ATR... but shown as the full range span

// ─────────────────────────────────────────────
// TRUE RANGE — last 5 candles
// ─────────────────────────────────────────────
tr(i) => math.max(high[i], close[i+1]) - math.min(low[i], close[i+1])

tr0 = tr(0)
tr1 = tr(1)
tr2 = tr(2)
tr3 = tr(3)
tr4 = tr(4)

// Candle color — solid teal/red background
candleBG(i)   => close[i] >= open[i] ? color.new(#00897B, 0) : color.new(#C62828, 0)

c0 = candleBG(0)
c1 = candleBG(1)
c2 = candleBG(2)
c3 = candleBG(3)
c4 = candleBG(4)

// ─────────────────────────────────────────────
// TABLE — single horizontal row, bottom left
// ─────────────────────────────────────────────
var table p = table.new(position.bottom_left, 11, 1,
     bgcolor      = color.new(#1a1a1a, 0),
     border_color = color.new(#444444, 0),
     border_width = 1,
     frame_color  = color.new(#444444, 0),
     frame_width  = 1)

if barstate.islast
    // ATR value
    table.cell(p, 0, 0, "ATR: " + str.tostring(math.round(atr, 2)),
         text_color=color.new(#FFD700, 0), text_size=size.normal, bgcolor=color.new(#1a1a1a, 0))

    // 0.5 spread
    table.cell(p, 1, 0, "0.5 $" + str.tostring(math.round(atr * 0.5, 2)),
         text_color=color.new(#00E5FF, 0), text_size=size.normal, bgcolor=color.new(#1a1a1a, 0))

    // 1.0 ATR as dollar range
    table.cell(p, 2, 0, "1.0 $" + str.tostring(math.round(atr, 2)),
         text_color=color.new(#FFFFFF, 0), text_size=size.normal, bgcolor=color.new(#1a1a1a, 0))

    // Divider
    table.cell(p, 3, 0, "|",
         text_color=color.new(#666666, 0), text_size=size.normal, bgcolor=color.new(#1a1a1a, 0))

    // "Last 5" label — white
    table.cell(p, 4, 0, "Last 5",
         text_color=color.new(#FFFFFF, 0), text_size=size.normal, bgcolor=color.new(#1a1a1a, 0))

    // R values — oldest left, most recent right, colored bg, white text
    table.cell(p, 5,  0, "R:" + str.tostring(math.round(tr4, 2)), text_color=color.new(#FFFFFF, 0), text_size=size.normal, bgcolor=c4)
    table.cell(p, 6,  0, "R:" + str.tostring(math.round(tr3, 2)), text_color=color.new(#FFFFFF, 0), text_size=size.normal, bgcolor=c3)
    table.cell(p, 7,  0, "R:" + str.tostring(math.round(tr2, 2)), text_color=color.new(#FFFFFF, 0), text_size=size.normal, bgcolor=c2)
    table.cell(p, 8,  0, "R:" + str.tostring(math.round(tr1, 2)), text_color=color.new(#FFFFFF, 0), text_size=size.normal, bgcolor=c1)
    table.cell(p, 9, 0, "R:" + str.tostring(math.round(tr0, 2)), text_color=color.new(#FFFFFF, 0), text_size=size.normal, bgcolor=c0)
