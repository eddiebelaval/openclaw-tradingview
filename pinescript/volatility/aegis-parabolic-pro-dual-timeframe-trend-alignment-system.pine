//@version=6
// ===================================================================
// Aegis Parabolic Pro - Dual Timeframe Trend Alignment System
// Author: [TheScalpingAnt]
// License: Mozilla Public License 2.0
// Description: Open-source indicator. See publication for full details.
// ===================================================================
indicator("Aegis Parabolic Pro - Dual Timeframe Trend Alignment System", overlay=true, max_bars_back=500)

// --- TOOLTIP CONSTANTS -----------------------------------------------
var string TT_CONFIRM     = "When ON: both SAR calculations reference the last fully closed bar of their respective timeframe (bar[1] inside the HTF context). This prevents the signal from changing while a bar is still forming. Strongly recommended for all live trading use. When OFF: uses the current in-progress bar close - useful for chart analysis but not for automated alerts."

var string TT_MA_TF       = "Timeframe for the Macro (trend-filter) Parabolic SAR and the Macro EMA. Default Daily. The Macro layer defines the dominant structural trend. Signals that align with this layer carry the highest statistical weight."

var string TT_MA_START    = "Acceleration Factor (AF) starting value for the Macro SAR. Lower values (0.005 to 0.01) make the SAR respond more slowly, reducing noise on higher timeframes. Classic default is 0.02."

var string TT_MA_INC      = "AF increment applied each time a new extreme point is set on the Macro SAR. Smaller increments (0.005 to 0.01) reduce whipsaw on the trend-filter layer."

var string TT_MA_MAX      = "Maximum AF cap for the Macro SAR. Prevents the SAR from hugging price too tightly in extended trends. Range 0.10 to 0.20 is standard."

var string TT_MA_MULT     = "ATR multiplier applied to the Macro SAR to create the Aegis offset band. The raw SAR value is shifted away from price by (ATR * multiplier), reducing false reversals on volatile instruments. Range 1.0 to 2.5 recommended."

var string TT_MI_TF       = "Timeframe for the Micro (entry-signal) Parabolic SAR. Default 4H. The Micro layer generates the actual buy and sell circle signals. It should be set higher than your chart timeframe to avoid chart-timeframe noise."

var string TT_MI_START    = "AF start for the Micro SAR. Higher values (0.03 to 0.05) make the Micro layer more sensitive, generating earlier entries. Lower values reduce noise."

var string TT_MI_INC      = "AF increment for the Micro SAR. Controls how quickly the SAR accelerates toward price after a new extreme. Higher = faster trailing stop."

var string TT_MI_MAX      = "Maximum AF cap for the Micro SAR. Classic default is 0.20."

var string TT_MI_MULT     = "ATR multiplier for the Micro SAR offset. A value of 1.0 gives tighter signals suitable for trending markets. Raise to 1.5 to 2.0 for choppy conditions."

var string TT_EMA_LEN     = "Period of the Macro EMA plotted on the chart from the Macro timeframe. Default 21. This acts as a dynamic support and resistance reference within the macro trend context. A 21-period EMA on the Daily tracks the short-term institutional moving average."

var string TT_EMA_COL     = "Color of the Macro EMA line."

var string TT_MACRO_BULL  = "Color of the Macro SAR circles when price is in a bullish macro state. Default white. Independently adjustable from the background bull tint color. Changing this does NOT automatically change the background tint."

var string TT_MACRO_BEAR  = "Color of the Macro SAR circles when price is in a bearish macro state. Default black. Classic high-contrast scheme: white circles below price for bull, black circles above price for bear. Independently adjustable from the background bear tint color."

var string TT_MICRO_BULL  = "Color of the Micro SAR entry circles when both Macro and Micro layers are simultaneously bullish. Full alignment = highest confidence long entry zone."

var string TT_MICRO_BEAR  = "Color of the Micro SAR entry circles when both Macro and Micro layers are simultaneously bearish. Full alignment = highest confidence short entry zone."

var string TT_SHOW_TABLE  = "Show or hide the trade-style reference table in the top-right corner. The table provides pre-configured AF and EMA settings for four trading styles: Scalping, Day Trading, Swing Trading, and Long Term investing. Hidden by default."

var string TT_SHOW_BG     = "Show a background tint driven by the Macro SAR trend state. Bull state uses the Background Bull Color input. Bear state uses the Background Bear Color input. These are fully independent from the Macro SAR circle colors. Disable if using other background indicators."

var string TT_BG_BULL     = "Color of the background tint when the Macro SAR is in a bullish state. Default white. Independent from the Macro SAR Bullish Color input. Recommended: use a softer or more transparent version of your Macro SAR bullish color."

var string TT_BG_BEAR     = "Color of the background tint when the Macro SAR is in a bearish state. Default black. Independent from the Macro SAR Bearish Color input. Recommended: use a softer or more transparent version of your Macro SAR bearish color."

var string TT_BG_TRANSP   = "Transparency of the background tint. 0 = fully opaque, 99 = invisible. Default 92. Raise to 96-98 for a subtle ambient hint, lower to 85 for a stronger zone marker. Applies equally to both bull and bear tint colors."

var string TT_ALERT_BULL  = "Alert fires once when both Macro and Micro SAR simultaneously turn bullish from a non-aligned state. This is the primary long entry confluence signal."

var string TT_ALERT_BEAR  = "Alert fires once when both Macro and Micro SAR simultaneously turn bearish from a non-aligned state. This is the primary short entry confluence signal."

var string TT_ALERT_MBULL = "Alert fires once when the Macro SAR alone transitions to bullish. Early structural shift - the trend filter has turned up but Micro has not yet confirmed."

var string TT_ALERT_MBEAR = "Alert fires once when the Macro SAR alone transitions to bearish. Primary trend layer has reversed. Treat open longs with caution."

var string TT_ALERT_UBULL = "Alert fires once when the Micro SAR alone turns bullish. Entry-level momentum has shifted up. Watch for Macro alignment to confirm."

var string TT_ALERT_UBEAR = "Alert fires once when the Micro SAR alone turns bearish. Entry-level momentum has shifted down."

// --- INPUTS: CONFIRMATION --------------------------------------------
G_CONF = "Confirmation Settings"
use_confirmed = input.bool(true,  "Wait for Bar Confirmation",          tooltip=TT_CONFIRM,    group=G_CONF)

// --- INPUTS: MACRO SAR -----------------------------------------------
G1 = "Macro SAR Settings (Trend Filter)"
ma_tf    = input.timeframe("1D",  "Macro Timeframe",                    tooltip=TT_MA_TF,      group=G1)
ma_start = input.float(0.01, "Macro Start AF",     step=0.005, minval=0.001, maxval=0.1,       tooltip=TT_MA_START,   group=G1)
ma_inc   = input.float(0.01, "Macro Increment AF", step=0.005, minval=0.001, maxval=0.1,       tooltip=TT_MA_INC,     group=G1)
ma_max   = input.float(0.15, "Macro Max AF",       step=0.01,  minval=0.05,  maxval=0.5,       tooltip=TT_MA_MAX,     group=G1)
ma_mult  = input.float(1.5,  "Macro ATR Multiplier", step=0.1, minval=0.1,   maxval=5.0,       tooltip=TT_MA_MULT,    group=G1)

// --- INPUTS: MICRO SAR -----------------------------------------------
G2 = "Micro SAR Settings (Entry Signals)"
mi_tf    = input.timeframe("240", "Micro Timeframe",                    tooltip=TT_MI_TF,      group=G2)
mi_start = input.float(0.02, "Micro Start AF",     step=0.005, minval=0.001, maxval=0.1,       tooltip=TT_MI_START,   group=G2)
mi_inc   = input.float(0.02, "Micro Increment AF", step=0.005, minval=0.001, maxval=0.1,       tooltip=TT_MI_INC,     group=G2)
mi_max   = input.float(0.2,  "Micro Max AF",       step=0.01,  minval=0.05,  maxval=0.5,       tooltip=TT_MI_MAX,     group=G2)
mi_mult  = input.float(1.0,  "Micro ATR Multiplier", step=0.1, minval=0.1,   maxval=5.0,       tooltip=TT_MI_MULT,    group=G2)

// --- INPUTS: MACRO EMA -----------------------------------------------
G3 = "Macro EMA Settings"
ema_len  = input.int(21,           "EMA Length", minval=1, maxval=500,                         tooltip=TT_EMA_LEN,    group=G3)
ema_col  = input.color(color.blue, "EMA Color",                                                tooltip=TT_EMA_COL,    group=G3)

// --- INPUTS: DISPLAY -------------------------------------------------
G4 = "Display"
macro_bull_col = input.color(color.white,            "Macro SAR - Bullish Color",               tooltip=TT_MACRO_BULL, group=G4)
macro_bear_col = input.color(color.rgb(0, 0, 0),    "Macro SAR - Bearish Color",               tooltip=TT_MACRO_BEAR, group=G4)
micro_bull_col = input.color(color.rgb(7, 247, 15), "Micro SAR - Aligned Bullish Color",       tooltip=TT_MICRO_BULL, group=G4)
micro_bear_col = input.color(color.rgb(245, 7, 7),  "Micro SAR - Aligned Bearish Color",       tooltip=TT_MICRO_BEAR, group=G4)
show_table     = input.bool(false, "Show Trade Style Table",                                    tooltip=TT_SHOW_TABLE, group=G4)
show_bg        = input.bool(true,  "Show Background Tint",                                      tooltip=TT_SHOW_BG,    group=G4)
bg_bull_col    = input.color(color.white,            "Background - Bull Color",                 tooltip=TT_BG_BULL,    group=G4)
bg_bear_col    = input.color(color.rgb(0, 0, 0),    "Background - Bear Color",                 tooltip=TT_BG_BEAR,    group=G4)
bg_transp      = input.int(92, "Background Tint Transparency", minval=0, maxval=99,             tooltip=TT_BG_TRANSP,  group=G4)

// --- INPUTS: ALERTS --------------------------------------------------
G5 = "Alerts"
alert_bull_align = input.bool(true,  "Alert: Bullish Full Alignment",   tooltip=TT_ALERT_BULL,  group=G5)
alert_bear_align = input.bool(true,  "Alert: Bearish Full Alignment",   tooltip=TT_ALERT_BEAR,  group=G5)
alert_macro_bull = input.bool(false, "Alert: Macro SAR Turns Bullish",  tooltip=TT_ALERT_MBULL, group=G5)
alert_macro_bear = input.bool(false, "Alert: Macro SAR Turns Bearish",  tooltip=TT_ALERT_MBEAR, group=G5)
alert_micro_bull = input.bool(false, "Alert: Micro SAR Turns Bullish",  tooltip=TT_ALERT_UBULL, group=G5)
alert_micro_bear = input.bool(false, "Alert: Micro SAR Turns Bearish",  tooltip=TT_ALERT_UBEAR, group=G5)

// --- AEGIS SAR FUNCTION ----------------------------------------------
// idx = 0 (live bar close) or 1 (last confirmed close).
// use_confirmed is input.bool - produces a simple int constant - safe as [] offset.
f_sar(s, inc, mx, am, idx) =>
    sar_val  = ta.sar(s, inc, mx)[idx]
    atr_val  = ta.atr(14)[idx] * am
    is_bull  = close[idx] > sar_val
    res_val  = is_bull ? sar_val - atr_val : sar_val + atr_val
    [res_val, is_bull]

// --- CONFIRMATION INDEX ----------------------------------------------
idx = use_confirmed ? 1 : 0

// --- SECURITY CALLS - ALL lookahead_off ------------------------------
[u_lsar, u_bull] = request.security(
    syminfo.tickerid, mi_tf,
    f_sar(mi_start, mi_inc, mi_max, mi_mult, idx),
    lookahead = barmerge.lookahead_off)

[m_lsar, m_bull] = request.security(
    syminfo.tickerid, ma_tf,
    f_sar(ma_start, ma_inc, ma_max, ma_mult, idx),
    lookahead = barmerge.lookahead_off)

m_ema = request.security(
    syminfo.tickerid, ma_tf,
    ta.ema(close, ema_len)[idx],
    lookahead = barmerge.lookahead_off)

// --- ALIGNMENT STATE -------------------------------------------------
bull_align = u_bull and m_bull
bear_align = not u_bull and not m_bull

// --- STATE TRANSITIONS (fire once per change) ------------------------
bull_align_new  = bull_align  and not bull_align[1]
bear_align_new  = bear_align  and not bear_align[1]
macro_bull_new  = m_bull      and not m_bull[1]
macro_bear_new  = not m_bull  and m_bull[1]
micro_bull_new  = u_bull      and not u_bull[1]
micro_bear_new  = not u_bull  and u_bull[1]

// --- ALERT CONDITIONS ------------------------------------------------
alertcondition(alert_bull_align and bull_align_new,
    title   = "Aegis - Bullish Full Alignment",
    message = "{{ticker}} [{{interval}}] - Macro + Micro SAR both BULLISH. Full trend confluence.")

alertcondition(alert_bear_align and bear_align_new,
    title   = "Aegis - Bearish Full Alignment",
    message = "{{ticker}} [{{interval}}] - Macro + Micro SAR both BEARISH. Full downtrend confluence.")

alertcondition(alert_macro_bull and macro_bull_new,
    title   = "Aegis - Macro SAR Turned Bullish",
    message = "{{ticker}} [{{interval}}] - Macro SAR flipped BULLISH. Watch for Micro alignment.")

alertcondition(alert_macro_bear and macro_bear_new,
    title   = "Aegis - Macro SAR Turned Bearish",
    message = "{{ticker}} [{{interval}}] - Macro SAR flipped BEARISH. Exercise caution on open longs.")

alertcondition(alert_micro_bull and micro_bull_new,
    title   = "Aegis - Micro SAR Turned Bullish",
    message = "{{ticker}} [{{interval}}] - Micro SAR flipped BULLISH. Check Macro alignment.")

alertcondition(alert_micro_bear and micro_bear_new,
    title   = "Aegis - Micro SAR Turned Bearish",
    message = "{{ticker}} [{{interval}}] - Micro SAR flipped BEARISH. Entry-level momentum down.")

// --- DISPLAY FILTER (clean price scale) ------------------------------
d_f = display.all - display.price_scale - display.status_line

// --- PLOTS -----------------------------------------------------------
// Macro EMA
plot(m_ema,   "Macro EMA",       color=ema_col,                                         linewidth=2, display=d_f)

// Macro SAR: macro_bull_col (bullish, default white) / macro_bear_col (bearish, default black)
// Both colors are fully user-configurable from the Display input group.
plot(m_lsar,  "Macro Trend SAR", color=m_bull ? macro_bull_col : macro_bear_col,         style=plot.style_circles, linewidth=4, display=d_f)

// Micro SAR entry circles: aligned bull = micro_bull_col, aligned bear = micro_bear_col, mixed = hidden (na)
u_col = bull_align ? micro_bull_col : bear_align ? micro_bear_col : na
plot(u_lsar,  "Entry Signal SAR", color=u_col,                                           style=plot.style_circles, linewidth=3, display=d_f)

// --- BACKGROUND TINT -------------------------------------------------
// bg_bull_col and bg_bear_col are independent from Macro SAR circle colors.
// Both are user-configurable. bg_transp applies equally to both states.
bgcolor(show_bg ? (m_bull ? color.new(bg_bull_col, bg_transp) : color.new(bg_bear_col, bg_transp)) : na, title="Macro Trend Background Tint")

// --- TRADE STYLE REFERENCE TABLE -------------------------------------
// Table background is color.white. Header text: color.gray.
// Style names: color.gray. AF/TF values: color.purple. EMA col: color.rgb(138,3,3).
if barstate.islast and show_table
    var table t = table.new(position.top_right, 5, 5,
         bgcolor=color.white, border_width=2, border_color=color.rgb(0,0,0))

    table.cell(t, 0, 0, "Trade Style", text_color=color.gray, text_size=size.normal)
    table.cell(t, 1, 0, "Micro AF",    text_color=color.gray, text_size=size.normal)
    table.cell(t, 2, 0, "Macro AF",    text_color=color.gray, text_size=size.normal)
    table.cell(t, 3, 0, "EMA Length",  text_color=color.gray, text_size=size.normal)
    table.cell(t, 4, 0, "TF Suggest",  text_color=color.gray, text_size=size.normal)

    table.cell(t, 0, 1, "Scalping",    text_color=color.gray,          text_size=size.small)
    table.cell(t, 1, 1, "0.04 / 0.2",  text_color=color.purple,        text_size=size.small)
    table.cell(t, 2, 1, "0.02 / 0.2",  text_color=color.purple,        text_size=size.small)
    table.cell(t, 3, 1, "13",          text_color=color.rgb(138, 3, 3), text_size=size.small)
    table.cell(t, 4, 1, "1m / 15m",    text_color=color.purple,        text_size=size.small)

    table.cell(t, 0, 2, "Day Trade",   text_color=color.gray,          text_size=size.small)
    table.cell(t, 1, 2, "0.02 / 0.2",  text_color=color.purple,        text_size=size.small)
    table.cell(t, 2, 2, "0.01 / 0.1",  text_color=color.purple,        text_size=size.small)
    table.cell(t, 3, 2, "21",          text_color=color.rgb(138, 3, 3), text_size=size.small)
    table.cell(t, 4, 2, "15m / 4H",    text_color=color.purple,        text_size=size.small)

    table.cell(t, 0, 3, "Swing",       text_color=color.gray,          text_size=size.small)
    table.cell(t, 1, 3, "0.01 / 0.1",  text_color=color.purple,        text_size=size.small)
    table.cell(t, 2, 3, "0.005 / 0.1", text_color=color.purple,        text_size=size.small)
    table.cell(t, 3, 3, "50",          text_color=color.rgb(138, 3, 3), text_size=size.small)
    table.cell(t, 4, 3, "1H / 1D",     text_color=color.purple,        text_size=size.small)

    table.cell(t, 0, 4, "Long Term",   text_color=color.gray,          text_size=size.small)
    table.cell(t, 1, 4, "0.005 / 0.1", text_color=color.purple,        text_size=size.small)
    table.cell(t, 2, 4, "0.002 / 0.05",text_color=color.purple,        text_size=size.small)
    table.cell(t, 3, 4, "100 / 200",   text_color=color.rgb(138, 3, 3), text_size=size.small)
    table.cell(t, 4, 4, "4H / 1W",     text_color=color.purple,        text_size=size.small)
