// @description 更改为无未来函数版本。支持自主控制MACD快慢线参数。看板涵盖：月、周、日、4H、1H、45m。

//@version=6
indicator("MACD Full-TF [Custom Params]", shorttitle="MACD_FullTF_Custom", overlay = true)

// ==========================================
// 1. Settings | 设置面板
// ==========================================
group_ui   = "UI & Language | 界面与语言"
displayLang = input.string("中文", "Language | 语言选择", options=["中文", "English"], group=group_ui)
tableLoc    = input.string(position.top_right, "Position | 看板位置", options=["top_right", "bottom_right", "top_left", "bottom_left"], group=group_ui)

group_macd  = "MACD Parameters | MACD 参数设置"
fastLen     = input.int(12, "Fast Length | 快线长度", minval=1, group=group_macd)
slowLen     = input.int(26, "Slow Length | 慢线长度", minval=1, group=group_macd)
signalLen   = input.int(9,  "Signal Smoothing | 信号线平滑", minval=1, group=group_macd)

group_div   = "Divergence Engine | 背离引擎"
pivotLeft   = input.int(5, "Pivot Left | 左侧回溯", group=group_div)
pivotRight  = input.int(5, "Pivot Right | 右侧确认", group=group_div, tooltip="信号在极点后第N根K线确认。")

// ==========================================
// 2. Core Detection Function | 核心检测函数
// ==========================================
detectDiv(f, s, sig) =>
    macdLine = ta.ema(close, f) - ta.ema(close, s)
    
    // 寻找价格枢轴点
    pHi = ta.pivothigh(high, pivotLeft, pivotRight)
    pLo = ta.pivotlow(low, pivotLeft, pivotRight)
    
    // 获取（回溯确认周期）的 MACD 值
    macdAtPeakHi = macdLine[pivotRight]
    macdAtPeakLo = macdLine[pivotRight]
    
    // 获取历史巅峰数据用于对比
    prevPriceHi = ta.valuewhen(not na(pHi), pHi, 1)
    prevMacdHi  = ta.valuewhen(not na(pHi), macdAtPeakHi, 1)
    
    prevPriceLo = ta.valuewhen(not na(pLo), pLo, 1)
    prevMacdLo  = ta.valuewhen(not na(pLo), macdAtPeakLo, 1)
    
    int signal = 0
    // 顶背离判定逻辑]
    if not na(pHi) and pHi > prevPriceHi and macdAtPeakHi < prevMacdHi
        signal := -1
    // 底背离判定逻辑]
    if not na(pLo) and pLo < prevPriceLo and macdAtPeakLo > prevMacdLo
        signal := 1
    signal

// ==========================================
// 3. Multi-Timeframe Data | 多周期同步聚合
// ==========================================
// 将自定义参数传递给每个周期请求]
div_M  = request.security(syminfo.tickerid, "M",   detectDiv(fastLen, slowLen, signalLen))
div_W  = request.security(syminfo.tickerid, "W",   detectDiv(fastLen, slowLen, signalLen))
div_D  = request.security(syminfo.tickerid, "D",   detectDiv(fastLen, slowLen, signalLen))
div_4H = request.security(syminfo.tickerid, "240", detectDiv(fastLen, slowLen, signalLen))
div_1H = request.security(syminfo.tickerid, "60",  detectDiv(fastLen, slowLen, signalLen))
div_45 = request.security(syminfo.tickerid, "45",  detectDiv(fastLen, slowLen, signalLen))

currentDiv = detectDiv(fastLen, slowLen, signalLen)

// ==========================================
// 4. UI Rendering | 看板绘制逻辑
// ==========================================
isCN = displayLang == "中文"
f_txt(cn, en) => isCN ? cn : en

statusText(s) => 
    s == 1 ? f_txt("底背离确认", "Bullish Conf") : 
     s == -1 ? f_txt("顶背离确认", "Bearish Conf") : 
     f_txt("趋势延续", "Neutral")

statusColor(s) => 
    s == 1 ? color.new(color.lime, 20) : 
     s == -1 ? color.new(color.red, 20) : 
     color.new(color.gray, 50)

var table dash = table.new(tableLoc, 2, 7, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(dash, 0, 0, f_txt("周期 (TF)", "Timeframe"), text_color=color.white)
    table.cell(dash, 1, 0, f_txt("背离状态", "Status"), text_color=color.white)
    
    tfNames = array.from(f_txt("月线", "Monthly"), f_txt("周线", "Weekly"), f_txt("日线", "Daily"), "4H", "1H", "45m")
    tfVals  = array.from(div_M, div_W, div_D, div_4H, div_1H, div_45)
    
    for i = 0 to 5
        table.cell(dash, 0, i + 1, array.get(tfNames, i), text_color=color.white, text_size=size.small)
        table.cell(dash, 1, i + 1, statusText(array.get(tfVals, i)), bgcolor=statusColor(array.get(tfVals, i)), text_color=color.white, text_size=size.small)

// ==========================================
// 5. Signal Plotting | 主图信号显示
// ==========================================
isEN = displayLang == "English"
plotshape(isCN and currentDiv == 1, title="Bullish CH", text="底背离\nCONFIRMED", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.small)
plotshape(isEN and currentDiv == 1, title="Bullish EN", text="Bullish\nCONFIRMED", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.small)

plotshape(isCN and currentDiv == -1, title="Bearish CH", text="顶背离\nCONFIRMED", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.small)
plotshape(isEN and currentDiv == -1, title="Bearish EN", text="Bearish\nCONFIRMED", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.small)
