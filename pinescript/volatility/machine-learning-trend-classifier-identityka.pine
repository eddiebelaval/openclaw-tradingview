//@version=5
indicator("Machine Learning: Trend Classifier [identityKa]", shorttitle="ML Classifier [identityKa]", overlay=true, max_lines_count=500, max_labels_count=500)

// ==========================================
// 1. AI ENGINE INPUTS
// ==========================================
grp_ai = "🧠 Machine Learning Settings"
ai_sensitivity = input.int(14, "Classifier Sensitivity", minval=5, maxval=50, group=grp_ai, tooltip="Lower values are more responsive, higher values are smoother.")
train_length = input.int(50, "Training Memory (Bars)", group=grp_ai)

grp_theme = "🎨 Neon Data Theme"
col_bull = input.color(#00e676, "AI Bullish", group=grp_theme)
col_bear = input.color(#ff1744, "AI Bearish", group=grp_theme)
col_neut = input.color(#ff9800, "AI Neutral / Dangerous", group=grp_theme) // Choppy bölge rengi güncellendi

grp_ui = "📊 Dashboard"
show_dash = input.bool(true, "Show AI Dashboard", group=grp_ui)

// ==========================================
// 2. ALGORITHMIC CLASSIFICATION ENGINE
// ==========================================
f_rsi = ta.rsi(close, ai_sensitivity)
f_cci = ta.cci(close, ai_sensitivity)
f_atr = ta.atr(ai_sensitivity)
f_macd = ta.ema(close, 12) - ta.ema(close, 26)

// Normalize Features
norm_rsi = f_rsi
norm_cci = (f_cci + 200) / 4 
norm_macd = f_macd > 0 ? 80 : 20

// AI Confidence Score (-100 to +100)
var float ai_score = 0.0
ai_score := ((norm_rsi + norm_cci + norm_macd) / 3) * 2 - 100

// Sınıflandırma
bool is_bull = ai_score > 20
bool is_bear = ai_score < -20
bool is_neut = ai_score >= -20 and ai_score <= 20

color current_col = is_bull ? col_bull : is_bear ? col_bear : col_neut

// ==========================================
// 3. VISUALIZATION (NEON RIBBON)
// ==========================================
base_line = ta.wma(close, ai_sensitivity)
upper_ribbon = base_line + (f_atr * 1.5)
lower_ribbon = base_line - (f_atr * 1.5)

p_base = plot(base_line, color=current_col, linewidth=2, title="AI Base Line")
p_up = plot(upper_ribbon, color=color.new(current_col, 70), title="Upper Ribbon")
p_dn = plot(lower_ribbon, color=color.new(current_col, 70), title="Lower Ribbon")

fill(p_up, p_dn, color=color.new(current_col, 90), title="Ribbon Fill")

bull_signal = is_bull and not is_bull[1]
bear_signal = is_bear and not is_bear[1]

plotshape(bull_signal, title="AI Bullish Shift", style=shape.triangleup, location=location.belowbar, color=col_bull, size=size.small)
plotshape(bear_signal, title="AI Bearish Shift", style=shape.triangledown, location=location.abovebar, color=col_bear, size=size.small)

// ==========================================
// 4. ALPHA AI DASHBOARD (STRICTLY TOP RIGHT & CLEAN)
// ==========================================
if show_dash
    var table hud = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.new(color.gray, 80))
    if barstate.islast
        table.cell(hud, 0, 0, "ML CLASSIFIER", text_color=color.white, text_size=size.small, bgcolor=color.black)
        table.cell(hud, 1, 0, "[identityKa]", text_color=color.gray, text_size=size.small, bgcolor=color.black)
        
        table.cell(hud, 0, 1, "Classified State", text_color=color.white, text_size=size.small, text_halign=text.align_left)
        string state_txt = is_bull ? "BULLISH" : is_bear ? "BEARISH" : "NEUTRAL"
        table.cell(hud, 1, 1, state_txt, text_color=color.black, text_size=size.small, bgcolor=current_col)
        
        table.cell(hud, 0, 2, "AI Confidence", text_color=color.white, text_size=size.small, text_halign=text.align_left)
        string conf_txt = str.tostring(math.round(math.abs(ai_score))) + "%"
        table.cell(hud, 1, 2, conf_txt, text_color=current_col, text_size=size.small)
        
        table.cell(hud, 0, 3, "Volatility Status", text_color=color.white, text_size=size.small, text_halign=text.align_left)
        table.cell(hud, 1, 3, f_atr > ta.sma(f_atr, 50) ? "HIGH" : "LOW", text_color=color.white, text_size=size.small)
        
        // Standart AI Suggestion Formatı
        string ai_rec = is_bull ? "LONG" : is_bear ? "SHORT" : "Dangerous"
        color ai_rec_col = is_bull ? col_bull : is_bear ? col_bear : col_neut
        color ai_rec_txt = is_bear ? color.white : color.black
        
        table.cell(hud, 0, 4, "AI Suggestion", text_color=color.white, text_size=size.small, text_halign=text.align_left)
        table.cell(hud, 1, 4, ai_rec, text_color=ai_rec_txt, text_size=size.small, bgcolor=ai_rec_col, text_font_family=font.family_monospace)

// ==========================================
// 5. ALERTS
// ==========================================
alertcondition(bull_signal, "🟢 AI Bullish Shift", "identityKa: Machine Learning Engine classified trend as BULLISH.")
alertcondition(bear_signal, "🔴 AI Bearish Shift", "identityKa: Machine Learning Engine classified trend as BEARISH.")
