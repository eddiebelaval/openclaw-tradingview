//@version=6
indicator("Move from Day's Low (%)", "Move from Day's Low", precision = 2)

// --- Calculations ---

// Get the low of the current day's session.
// This function fetches data from the daily timeframe for the current symbol.
// The value will update in real-time on intraday charts as the day's low changes.
float dailyLow = request.security(syminfo.tickerid, "D", low)

// Calculate the percentage move from the day's low to the current price (close).
// We check if dailyLow is greater than 0 to prevent division-by-zero errors.
float percentMove = if dailyLow > 0
    (close - dailyLow) / dailyLow * 100
else
    0.0

// --- Plotting for Screener ---

// Plot the calculated percentage move.
// This is the output value that the TradingView Screener will use for filtering and sorting.
plot(percentMove, "Move from Day Low %", color.new(color.teal, 0))

// Add a horizontal line at 0 for visual reference on the chart.
hline(0, "Zero Line", color = color.new(color.gray, 50))
