//@version=6
indicator("ST Squeeze Pro with ABC Waves", shorttitle = "SqzPro+ABC", overlay = false)

// --- Constants ---
const string G_SQZ = "Squeeze Settings"
const string G_WAV = "ABC Wave Settings"
const string G_STY = "Style Settings"

// --- Squeeze Pro Inputs ---
lengthSqz        = input.int(20, "Squeeze Length", minval = 1, group = G_SQZ, tooltip = "Lookback period for BB and KC.")
bbMult           = input.float(2.0, "BB Multiplier", minval = 0.1, step = 0.1, group = G_SQZ)
kcMultLow        = input.float(2.0, "KC Mult (Low)", minval = 0.1, step = 0.1, group = G_SQZ, tooltip = "Multiplier for Black dots (Low Compression).")
kcMultMid        = input.float(1.5, "KC Mult (Mid)", minval = 0.1, step = 0.1, group = G_SQZ, tooltip = "Multiplier for Red dots (Mid Compression).")
kcMultHigh       = input.float(1.0, "KC Mult (High)", minval = 0.1, step = 0.1, group = G_SQZ, tooltip = "Multiplier for Orange dots (High Compression).")

// --- ABC Wave Inputs ---
showWaveA        = input.bool(true, "Show Wave A (Fast)", group = G_WAV)
lenWaveA         = input.int(55, "Wave A Length", minval = 1, group = G_WAV)
showWaveB        = input.bool(true, "Show Wave B (Medium)", group = G_WAV)
lenWaveB         = input.int(144, "Wave B Length", minval = 1, group = G_WAV)
showWaveC        = input.bool(true, "Show Wave C (Slow)", group = G_WAV)
lenWaveC         = input.int(233, "Wave C Length", minval = 1, group = G_WAV)

// --- Style Inputs ---
colMomUp         = input.color(#00ffff, "Hist Up", group = G_STY, inline = "H1")
colMomUpW        = input.color(#0000ff, "Hist Up Weak", group = G_STY, inline = "H1")
colMomDn         = input.color(#ff0000, "Hist Down", group = G_STY, inline = "H2")
colMomDnW        = input.color(#ffff00, "Hist Down Weak", group = G_STY, inline = "H2")

colSqzNo         = input.color(#00ff00, "No Squeeze", group = G_STY, inline = "S1")
colSqzLow        = input.color(#000000, "Low Comp", group = G_STY, inline = "S1")
colSqzMid        = input.color(#ff0000, "Mid Comp", group = G_STY, inline = "S2")
colSqzHigh       = input.color(#ff9800, "High Comp", group = G_STY, inline = "S2")

colWaveA         = input.color(#03BF85, "Wave A Color", group = G_STY)
colWaveB         = input.color(#FF7800, "Wave B Color", group = G_STY)
colWaveC         = input.color(#FBFF00, "Wave C Color", group = G_STY)

// --- Squeeze Pro Logic ---
bbBasis = ta.sma(close, lengthSqz)
bbDev   = bbMult * ta.stdev(close, lengthSqz)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

kcBasis = ta.sma(close, lengthSqz)
kcTR    = ta.sma(ta.tr, lengthSqz)

// Compression Zones
isHighSqz = (bbUpper <= kcBasis + kcTR * kcMultHigh) and (bbLower >= kcBasis - kcTR * kcMultHigh)
isMidSqz  = (bbUpper <= kcBasis + kcTR * kcMultMid)  and (bbLower >= kcBasis - kcTR * kcMultMid)
isLowSqz  = (bbUpper <= kcBasis + kcTR * kcMultLow)  and (bbLower >= kcBasis - kcTR * kcMultLow)

sqzColor = isHighSqz ? colSqzHigh : (isMidSqz ? colSqzMid : (isLowSqz ? colSqzLow : colSqzNo))

// Squeeze Momentum (Standard calculation for the main histogram)
avgHL    = (ta.highest(high, lengthSqz) + ta.lowest(low, lengthSqz)) / 2
smaClose = ta.sma(close, lengthSqz)
momVal   = ta.linreg(close - (avgHL + smaClose) / 2, lengthSqz, 0)
momColor = momVal > 0 ? (momVal > nz(momVal[1]) ? colMomUp : colMomUpW) : (momVal < nz(momVal[1]) ? colMomDn : colMomDnW)

// --- ABC Wave Logic ---
// Waves are essentially MACD histograms with longer periodicities to filter noise
calcWave(len) =>
    fastMA = ta.ema(close, 8)
    slowMA = ta.ema(close, len)
    macd   = fastMA - slowMA
    signal = ta.ema(macd, len)
    macd - signal

waveA = showWaveA ? calcWave(lenWaveA) : na
waveB = showWaveB ? calcWave(lenWaveB) : na
waveC = showWaveC ? calcWave(lenWaveC) : na

// --- Entry/Exit Logic ---
// Typical Squeeze Pro entry: Momentum turns up (cyan) while coming out of a red/black squeeze
// High quality "ABC" filter: Wave A or B is in alignment with the trade direction
bullishSqzFire = not isLowSqz and isLowSqz[1] and momVal > 0 and momVal > momVal[1]
bearishSqzFire = not isLowSqz and isLowSqz[1] and momVal < 0 and momVal < momVal[1]

// ABC alignment filter
bullishABC = (showWaveA ? waveA > 0 : true) and (showWaveB ? waveB > 0 : true)
bearishABC = (showWaveA ? waveA < 0 : true) and (showWaveB ? waveB < 0 : true)

longEntry  = bullishSqzFire and bullishABC
shortEntry = bearishSqzFire and bearishABC

// Exit: Momentum weakens (color change from bright to dark blue/yellow)
longExit   = momVal > 0 and momVal < momVal[1]
shortExit  = momVal < 0 and momVal > momVal[1]

// --- Visualization ---
// Plot Waves First (Background)
plot(waveC, "Wave C", color = color.new(colWaveC, 30), style = plot.style_area)
plot(waveB, "Wave B", color = color.new(colWaveB, 30), style = plot.style_area)
plot(waveA, "Wave A", color = color.new(colWaveA, 30), style = plot.style_area)

// Plot Main Squeeze Momentum
plot(momVal, "Momentum Histogram", color = momColor, style = plot.style_columns, linewidth = 2)

// Squeeze Dots on Zero Line
plot(0, "Squeeze Dots", color = sqzColor, style = plot.style_circles, linewidth = 2)

// Signal Markers
plotshape(longEntry,  "Long Entry",  style = shape.triangleup,   location = location.bottom, color = color.green, size = size.small)
plotshape(shortEntry, "Short Entry", style = shape.triangledown, location = location.top,    color = color.red,   size = size.small)

// Alerts
alertcondition(longEntry,  "Long Entry Signal",  "Squeeze fired long with ABC alignment")
alertcondition(shortEntry, "Short Entry Signal", "Squeeze fired short with ABC alignment")
alertcondition(longExit,   "Long Exit",          "Long momentum weakening")
alertcondition(shortExit,  "Short Exit",         "Short momentum weakening")
