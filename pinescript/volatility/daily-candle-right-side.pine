//@version=5
indicator("Daily Candle - Right Side", overlay=true)

// Settings
offset = input.int(10, "Offset from Right Edge", minval=1, maxval=200)
candleWidth = input.int(4, "Candle Width", minval=2, maxval=30)
topLabelOffset = input.float(2.0, "Top Label Offset %", minval=0.1, maxval=10.0, step=0.1)
bottomLabelOffset = input.float(2.0, "Bottom Label Offset %", minval=0.1, maxval=10.0, step=0.1)

// Color settings
bodyColor = input.color(color.black, "Body Color")
borderColor = input.color(color.white, "Border Color")
wickColor = input.color(color.white, "Wick Color")

// Get daily timeframe data
dailyOpen = request.security(syminfo.tickerid, "D", open, lookahead=barmerge.lookahead_on)
dailyHigh = request.security(syminfo.tickerid, "D", high, lookahead=barmerge.lookahead_on)
dailyLow = request.security(syminfo.tickerid, "D", low, lookahead=barmerge.lookahead_on)
dailyClose = request.security(syminfo.tickerid, "D", close, lookahead=barmerge.lookahead_on)
dailyTime = request.security(syminfo.tickerid, "D", time, lookahead=barmerge.lookahead_on)

// Get day of week (1=Sunday, 2=Monday, etc.)
dayOfWeek = dayofweek(dailyTime)
dayText = dayOfWeek == 1 ? "SUN" : dayOfWeek == 2 ? "MON" : dayOfWeek == 3 ? "TUE" : dayOfWeek == 4 ? "WED" : dayOfWeek == 5 ? "THU" : dayOfWeek == 6 ? "FRI" : "SAT"

// Draw the daily candle on the right side
var line highWick = na
var line lowWick = na
var box candleBody = na
var label topLabel = na
var label bottomLabel = na

if barstate.islast
    // Delete previous drawings
    if not na(highWick)
        line.delete(highWick)
        line.delete(lowWick)
        box.delete(candleBody)
        label.delete(topLabel)
        label.delete(bottomLabel)
    
    // Calculate positions - centered wick
    leftEdge = bar_index + offset
    rightEdge = bar_index + offset + candleWidth
    centerX = leftEdge + (candleWidth / 2)
    
    // Calculate label offset based on price range
    priceRange = dailyHigh - dailyLow
    topGap = priceRange * (topLabelOffset / 100)
    bottomGap = priceRange * (bottomLabelOffset / 100)
    
    // Create the candle body - customizable colors
    candleBody := box.new(
         left=leftEdge, 
         top=math.max(dailyOpen, dailyClose), 
         right=rightEdge, 
         bottom=math.min(dailyOpen, dailyClose),
         bgcolor=bodyColor,
         border_color=borderColor,
         border_width=1
     )
    
    // Create upper wick - customizable color, centered
    highWick := line.new(
         x1=centerX, 
         y1=dailyHigh, 
         x2=centerX, 
         y2=math.max(dailyOpen, dailyClose),
         color=wickColor,
         width=1
     )
    
    // Create lower wick - customizable color, centered
    lowWick := line.new(
         x1=centerX, 
         y1=dailyLow, 
         x2=centerX, 
         y2=math.min(dailyOpen, dailyClose),
         color=wickColor,
         width=1
     )
    
    // Add "D" label at the top (offset above the high) - CENTERED
    topLabel := label.new(
         x=centerX, 
         y=dailyHigh + topGap, 
         text="D",
         style=label.style_none,
         textcolor=color.white,
         size=size.tiny,
         textalign=text.align_center,
         yloc=yloc.price
     )
    
    // Add day of week label at the bottom (offset below the low) - CENTERED
    bottomLabel := label.new(
         x=centerX, 
         y=dailyLow - bottomGap, 
         text=dayText,
         style=label.style_none,
         textcolor=color.white,
         size=size.tiny,
         textalign=text.align_center,
         yloc=yloc.price
     )

// Plot invisible lines to show the levels in the price scale
plot(dailyHigh, "Daily High", color=color.new(color.gray, 100))
plot(dailyLow, "Daily Low", color=color.new(color.gray, 100))
plot(dailyOpen, "Daily Open", color=color.new(color.gray, 100))
plot(dailyClose, "Daily Close", color=color.new(color.gray, 100))
