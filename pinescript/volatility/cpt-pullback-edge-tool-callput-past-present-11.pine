//@version=6
//@version=5
indicator("Fair Value Gap (FVG) CALL/PUT - Past + Present (Fixed)", overlay=true,
     max_boxes_count=500, max_labels_count=500, max_lines_count=500)

//──────────────────────────────────────────────────────────────────────────────
// Inputs
//──────────────────────────────────────────────────────────────────────────────
extendMode        = input.string("Right", "Extend Active FVGs", options=["None", "Right", "Bars"])
extendBars        = input.int(200, "Extend Bars (if Extend = Bars)", minval=1)

minGapTicks       = input.float(0.0, "Minimum FVG size (in ticks)", minval=0.0, step=1.0)

keepHistory       = input.bool(true, "Keep past (mitigated) FVGs on chart")
markMitigated     = input.bool(true, "Mark mitigated FVGs (change style)")
stopExtendOnFill  = input.bool(true, "Stop extending once mitigated")

maxFVGsToKeep     = input.int(250, "Max total FVGs to keep", minval=50, maxval=500)
showMidline       = input.bool(false, "Show 50% midline")

bullColor         = input.color(color.new(color.lime, 85), "Bullish FVG Color")
bearColor         = input.color(color.new(color.red,  85), "Bearish FVG Color")
bullBorder        = input.color(color.new(color.lime, 35), "Bullish Border")
bearBorder        = input.color(color.new(color.red,  35), "Bearish Border")

mitBullColor      = input.color(color.new(color.lime, 92), "Mitigated Bull Color")
mitBearColor      = input.color(color.new(color.red,  92), "Mitigated Bear Color")
mitBorderColor    = input.color(color.new(color.gray, 60), "Mitigated Border")

//──────────────────────────────────────────────────────────────────────────────
// Storage
//──────────────────────────────────────────────────────────────────────────────
var box[]   allBoxes      = array.new_box()
var bool[]  allIsBull     = array.new_bool()
var float[] allTop        = array.new_float()
var float[] allBot        = array.new_float()
var bool[]  allMitigated  = array.new_bool()
var line[]  allMidLines   = array.new_line()

//──────────────────────────────────────────────────────────────────────────────
// Helpers
//──────────────────────────────────────────────────────────────────────────────
tickSize = syminfo.mintick
minGap   = minGapTicks * tickSize

f_set_extend(box b) =>
    if extendMode == "Right"
        box.set_extend(b, extend.right)
    else if extendMode == "Bars"
        box.set_extend(b, extend.none)
        box.set_right(b, bar_index + extendBars)
    else
        box.set_extend(b, extend.none)

f_trim_to_max() =>
    while array.size(allBoxes) > maxFVGsToKeep
        oldB = array.shift(allBoxes)
        box.delete(oldB)

        array.shift(allIsBull)
        array.shift(allTop)
        array.shift(allBot)
        array.shift(allMitigated)

        oldL = array.shift(allMidLines)
        if not na(oldL)
            line.delete(oldL)

//──────────────────────────────────────────────────────────────────────────────
// FVG Detection (3-candle ICT style)
// Bullish: low > high[2]  => zone [high[2], low]
// Bearish: high < low[2]  => zone [high, low[2]]
//──────────────────────────────────────────────────────────────────────────────
bullFVG = (low > high[2]) and ((low - high[2]) >= minGap)
bearFVG = (high < low[2]) and ((low[2] - high) >= minGap)

//──────────────────────────────────────────────────────────────────────────────
// Create FVGs
//──────────────────────────────────────────────────────────────────────────────
if bullFVG
    top    = low
    bot    = high[2]

    b = box.new(left=bar_index-2, right=bar_index, top=top, bottom=bot,
        bgcolor=bullColor, border_color=bullBorder)
    f_set_extend(b)

    array.push(allBoxes, b)
    array.push(allIsBull, true)
    array.push(allTop, top)
    array.push(allBot, bot)
    array.push(allMitigated, false)

    if showMidline
        mid = (top + bot) / 2.0
        ln  = line.new(bar_index-2, mid, bar_index, mid, color=color.lime, style=line.style_dotted, width=1)
        array.push(allMidLines, ln)
    else
        array.push(allMidLines, na)

    label.new(bar_index, top, "CALL", style=label.style_label_down, color=color.new(color.lime, 0), textcolor=color.white)

    f_trim_to_max()

if bearFVG
    top    = low[2]
    bot    = high

    b = box.new(left=bar_index-2, right=bar_index, top=top, bottom=bot,
        bgcolor=bearColor, border_color=bearBorder)
    f_set_extend(b)

    array.push(allBoxes, b)
    array.push(allIsBull, false)
    array.push(allTop, top)
    array.push(allBot, bot)
    array.push(allMitigated, false)

    if showMidline
        mid = (top + bot) / 2.0
        ln  = line.new(bar_index-2, mid, bar_index, mid, color=color.red, style=line.style_dotted, width=1)
        array.push(allMidLines, ln)
    else
        array.push(allMidLines, na)

    label.new(bar_index, bot, "PUT", style=label.style_label_up, color=color.new(color.red, 0), textcolor=color.white)

    f_trim_to_max()

//──────────────────────────────────────────────────────────────────────────────
// Update "Bars" extension each bar (only for active unless stopExtendOnFill=false)
//──────────────────────────────────────────────────────────────────────────────
if extendMode == "Bars" and array.size(allBoxes) > 0
    for i = 0 to array.size(allBoxes) - 1
        mit = array.get(allMitigated, i)
        if not mit or not stopExtendOnFill
            box.set_right(array.get(allBoxes, i), bar_index + extendBars)

//──────────────────────────────────────────────────────────────────────────────
// Mitigation handling (safe reverse loop)
// Bull mitigated when low <= bot
// Bear mitigated when high >= top
//──────────────────────────────────────────────────────────────────────────────
if array.size(allBoxes) > 0
    for i = array.size(allBoxes) - 1 to 0
        if not array.get(allMitigated, i)
            isBull = array.get(allIsBull, i)
            top    = array.get(allTop, i)
            bot    = array.get(allBot, i)

            mitigatedNow = (isBull and low <= bot) or ((not isBull) and high >= top)

            if mitigatedNow
                if keepHistory
                    array.set(allMitigated, i, true)

                    if markMitigated
                        b = array.get(allBoxes, i)
                        box.set_bgcolor(b, isBull ? mitBullColor : mitBearColor)
                        box.set_border_color(b, mitBorderColor)

                    if stopExtendOnFill
                        box.set_extend(array.get(allBoxes, i), extend.none)
                else
                    // delete + remove everything in sync
                    box.delete(array.get(allBoxes, i))
                    array.remove(allBoxes, i)
                    array.remove(allIsBull, i)
                    array.remove(allTop, i)
                    array.remove(allBot, i)
                    array.remove(allMitigated, i)

                    ln = array.remove(allMidLines, i)
                    if not na(ln)
                        line.delete(ln)

//──────────────────────────────────────────────────────────────────────────────
// Alerts
//──────────────────────────────────────────────────────────────────────────────
alertcondition(bullFVG, title="Bullish FVG (CALL)", message="Bullish FVG formed on {{ticker}} (CALL).")
alertcondition(bearFVG, title="Bearish FVG (PUT)", message="Bearish FVG formed on {{ticker}} (PUT).")
