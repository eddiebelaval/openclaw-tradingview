//@version=5
indicator("Relative Volatility (Stock HV / VIX)", overlay=false)

// === Inputs ===
length     = input.int(20, "HV Lookback (days)")
vix_symbol = input.symbol("CBOE:VIX", "VIX Symbol")

// === Historical Volatility Function ===
f_hv(src, length) =>
    returns = math.log(src / src[1])
    stdev   = ta.stdev(returns, length)
    hv      = stdev * math.sqrt(252) * 100
    hv

// === Calculate Stock HV ===
stock_hv = f_hv(close, length)

// === Get VIX Data ===
vix_close = request.security(vix_symbol, timeframe.period, close)

// === Relative Volatility ===
relative_vol = stock_hv / vix_close

// === Plot ONLY the relative volatility ===
plot(relative_vol,
     color=color.green,
     title="Relative Volatility (HV / VIX)",
     linewidth=2)

// Reference line for ratio
hline(1, "Equal Volatility", color=color.gray, linestyle=hline.style_dotted)
