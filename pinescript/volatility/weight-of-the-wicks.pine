//@version=6
indicator("Wickedness", overlay = false)

//---------------------------------------------------------
// Inputs
//---------------------------------------------------------
len           = input.int(20, "Lookback", minval = 1)
atrLen        = input.int(15, "ATR Length", minval = 1)
mode          = input.string("ATR", "Normalization", options = ["ATR", "Bar Range", "% of Candle"])
smoothLen     = input.int(3, "Smoothing", minval = 1)

showHistogram = input.bool(true, "Show Net Histogram")
showSignal    = input.bool(true, "Show Signal Line")
showTotal     = input.bool(true, "Show Total Wickiness")
showConvict   = input.bool(false, "Show Body Conviction")
showQuality   = input.bool(true, "Show Auction Quality")

//---------------------------------------------------------
// Candle geometry
//---------------------------------------------------------
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
bodySize  = math.abs(close - open)
barRange  = math.max(high - low, syminfo.mintick)
atr       = ta.atr(atrLen)

//---------------------------------------------------------
// Normalization
//---------------------------------------------------------
normBase = mode == "ATR" ? math.max(atr, syminfo.mintick) : barRange

upperNorm = mode == "% of Candle" ? upperWick / barRange : upperWick / normBase
lowerNorm = mode == "% of Candle" ? lowerWick / barRange : lowerWick / normBase
bodyNorm  = mode == "% of Candle" ? bodySize  / barRange : bodySize  / normBase

//---------------------------------------------------------
// Core measures
//---------------------------------------------------------
rawNet       = lowerNorm - upperNorm
rawTotal     = lowerNorm + upperNorm
rawQuality   = bodyNorm - rawTotal

net          = ta.ema(rawNet, smoothLen)
signal       = ta.sma(net, len)
totalWick    = ta.ema(rawTotal, smoothLen)
conviction   = ta.ema(bodyNorm, smoothLen)
auctionQual  = ta.ema(rawQuality, smoothLen)

//---------------------------------------------------------
// Histogram colors
//---------------------------------------------------------
histColor =
     net > 0 ?
         (net > net[1] ? color.lime : color.green) :
         (net < net[1] ? color.red : color.maroon)

//---------------------------------------------------------
// Plots
//---------------------------------------------------------
hline(0, "Zero", color = color.gray)

plot(showHistogram ? net : na, "Net Rejection Pressure", style = plot.style_histogram, color = histColor, linewidth = 3)
plot(showSignal ? signal : na, "Signal", color = color.white, linewidth = 2)
plot(showTotal ? totalWick : na, "Total Wickiness", color = color.orange, linewidth = 2)
plot(showConvict ? conviction : na, "Body Conviction", color = color.aqua, linewidth = 2)
plot(showQuality ? auctionQual : na, "Auction Quality", color = color.fuchsia, linewidth = 2)
