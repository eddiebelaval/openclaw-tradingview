//@version=6
indicator("Symmetric Triangle Breakout [KedArc Quant]", overlay=true, max_lines_count=200, max_labels_count=200)

//────────────────────────────────────────────────────────────────────
// Inputs
//────────────────────────────────────────────────────────────────────
groupTri   = "Triangle Detection"
pivotLen        = input.int(8,   "Pivot Lookback", minval=4, maxval=30, group=groupTri)
minPoints       = input.int(2,   "Min Points per Side", minval=2, maxval=5, group=groupTri)
maxTriangleBars = input.int(180, "Max triangle age (bars)", minval=30, maxval=400, group=groupTri)
priceTolPct     = input.float(0.20, "Pivot tolerance %", minval=0.0, step=0.05, group=groupTri)
slopeTol        = input.float(0.0010,"Convergence tolerance", minval=0.0, step=0.0001, group=groupTri)

groupFilters = "Filters"
useTrendFilter  = input.bool(true, "EMA Trend Filter", group=groupFilters)
emaLen          = input.int(50,   "EMA Length", group=groupFilters)
volConfirm      = input.bool(false, "Volume Confirmation", group=groupFilters)
volMult         = input.float(1.3,  "Volume Multiplier", minval=0.5, step=0.1, group=groupFilters)
useSqueeze      = input.bool(true, "Volatility Squeeze (ATR < ATR SMA)", group=groupFilters)
squeezeLen      = input.int(20,   "ATR SMA Length", minval=5, maxval=100, group=groupFilters)
atrLen          = input.int(14,   "ATR Length", minval=2, group=groupFilters)
minHeightAtr    = input.float(1.2,"Min Triangle Height (ATR x)", minval=0.2, step=0.1, group=groupFilters)
breakBufAtr     = input.float(0.10,"Breakout buffer (ATR x)", minval=0.0, step=0.05, group=groupFilters)
useMaturity     = input.bool(true, "Triangle Maturity Filter", group=groupFilters)
minMaturityPct  = input.float(0.35,"Min maturity (0.25–0.55)", minval=0.05, maxval=0.95, step=0.05, group=groupFilters)

groupState = "Signal Behavior"
noDuplicateSignals = input.bool(true, "No duplicate signals (stateful)", group=groupState)
onePerTriangle     = input.bool(true, "Max 1 LONG/SHORT per triangle", group=groupState)

groupVis = "Visuals"
showTriangleZone = input.bool(true, "Shade triangle zone", group=groupVis)
showLines        = input.bool(true, "Draw projected triangle lines", group=groupVis)
showLevels       = input.bool(true, "Plot breakout levels (upper/lower)", group=groupVis)
showDashboard    = input.bool(true, "Show dashboard", group=groupVis)

//────────────────────────────────────────────────────────────────────
// Pivots
//────────────────────────────────────────────────────────────────────
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)

var float[] highs    = array.new_float()
var int[]   highBars = array.new_int()
var float[] lows     = array.new_float()
var int[]   lowBars  = array.new_int()

if not na(ph)
    array.push(highs, ph)
    array.push(highBars, bar_index - pivotLen)
    if array.size(highs) > 12
        array.shift(highs)
        array.shift(highBars)

if not na(pl)
    array.push(lows, pl)
    array.push(lowBars, bar_index - pivotLen)
    if array.size(lows) > 12
        array.shift(lows)
        array.shift(lowBars)

tol(x) => x * (priceTolPct * 0.01)

//────────────────────────────────────────────────────────────────────
// Filters
//────────────────────────────────────────────────────────────────────
emaTrend = ta.ema(close, emaLen)
atrValue = ta.atr(atrLen)
atrAvg   = ta.sma(atrValue, squeezeLen)
squeeze  = atrValue < atrAvg
avgVol   = ta.sma(volume, 20)

trendOKLong  = not useTrendFilter or close > emaTrend
trendOKShort = not useTrendFilter or close < emaTrend
volOK        = not volConfirm or volume > avgVol * volMult

//────────────────────────────────────────────────────────────────────
// Triangle detection + projection
//────────────────────────────────────────────────────────────────────
bool  inTriangle  = false
float upperNow    = na
float lowerNow    = na
float triHeight   = na
int   triStartBar = na
int   triLastBar  = na
float triProgress = na

if array.size(highs) >= minPoints and array.size(lows) >= minPoints
    int h1 = array.size(highBars) - 1
    int h0 = array.size(highBars) - minPoints
    int l1 = array.size(lowBars)  - 1
    int l0 = array.size(lowBars)  - minPoints

    int hb1 = array.get(highBars, h1)
    int hb0 = array.get(highBars, h0)
    int lb1 = array.get(lowBars,  l1)
    int lb0 = array.get(lowBars,  l0)

    triStartBar := math.min(hb0, lb0)
    triLastBar  := math.max(hb1, lb1)

    bool ageOK = (bar_index - triStartBar) <= maxTriangleBars

    float hv1 = array.get(highs, h1)
    float hv0 = array.get(highs, h0)
    float lv1 = array.get(lows,  l1)
    float lv0 = array.get(lows,  l0)

    bool decHighs = true
    bool risLows  = true

    for i = 1 to minPoints - 1
        float hA = array.get(highs, array.size(highs) - i)
        float hB = array.get(highs, array.size(highs) - i - 1)
        if hA > hB + tol(hB)
            decHighs := false

        float lA = array.get(lows, array.size(lows) - i)
        float lB = array.get(lows, array.size(lows) - i - 1)
        if lA < lB - tol(lB)
            risLows := false

    float highSlope = (hv1 - hv0) / math.max(1, (hb1 - hb0))
    float lowSlope  = (lv1 - lv0) / math.max(1, (lb1 - lb0))

    bool converging = (highSlope <= 0 and lowSlope >= 0) or math.abs(highSlope + lowSlope) < slopeTol
    inTriangle := ageOK and decHighs and risLows and converging

    if inTriangle
        upperNow  := hv1 + highSlope * (bar_index - hb1)
        lowerNow  := lv1 + lowSlope  * (bar_index - lb1)
        triHeight := math.abs(hv0 - lv0)

// Robustness filters
heightOK = not na(triHeight) and triHeight >= atrValue * minHeightAtr

maturityOK = true
float _prog = na
if useMaturity and not na(triStartBar) and not na(triLastBar)
    int totalSpan = math.max(1, triLastBar - triStartBar)
    _prog         := (bar_index - triStartBar) / totalSpan
    maturityOK    := _prog >= minMaturityPct

if inTriangle and not na(_prog)
    triProgress := math.min(_prog, 1.0) * 100
else
    triProgress := na

squeezeOK = (not useSqueeze) or squeeze

// Breakout (buffered)
crossUp   = inTriangle and not na(upperNow) and ta.crossover(close, upperNow + atrValue * breakBufAtr)
crossDown = inTriangle and not na(lowerNow) and ta.crossunder(close, lowerNow - atrValue * breakBufAtr)

// Raw signals
rawLong  = crossUp   and trendOKLong  and volOK and heightOK and maturityOK and squeezeOK
rawShort = crossDown and trendOKShort and volOK and heightOK and maturityOK and squeezeOK

//────────────────────────────────────────────────────────────────────
// Stateful signal engine (prevents repeated L/L/L or S/S/S)
//────────────────────────────────────────────────────────────────────
var int  posState = 0
var int  lastTriStart = na
var bool longUsedThisTri = false
var bool shortUsedThisTri = false

newTriangle = inTriangle and not na(triStartBar) and (na(lastTriStart) or triStartBar != lastTriStart)
if newTriangle
    lastTriStart := triStartBar
    longUsedThisTri := false
    shortUsedThisTri := false

bool longTrig  = rawLong
bool shortTrig = rawShort

if noDuplicateSignals
    longTrig  := rawLong  and (posState != 1)
    shortTrig := rawShort and (posState != -1)

if onePerTriangle
    longTrig  := longTrig  and not longUsedThisTri
    shortTrig := shortTrig and not shortUsedThisTri

if longTrig
    posState := 1
    longUsedThisTri := true
if shortTrig
    posState := -1
    shortUsedThisTri := true

if not inTriangle
    longUsedThisTri := false
    shortUsedThisTri := false

//────────────────────────────────────────────────────────────────────
// Visuals (projected lines)
//────────────────────────────────────────────────────────────────────
var line upperLine = na
var line lowerLine = na

// Clean up lines when triangle ends
if (not inTriangle) and (not na(upperLine) or not na(lowerLine))
    if not na(upperLine)
        line.delete(upperLine)
        upperLine := na
    if not na(lowerLine)
        line.delete(lowerLine)
        lowerLine := na

if showLines and inTriangle and not na(upperNow) and not na(lowerNow)
    if na(upperLine)
        upperLine := line.new(bar_index - 1, upperNow[1], bar_index, upperNow, color=color.red, width=2)
    else
        line.set_xy1(upperLine, bar_index - 1, upperNow[1])
        line.set_xy2(upperLine, bar_index,     upperNow)

    if na(lowerLine)
        lowerLine := line.new(bar_index - 1, lowerNow[1], bar_index, lowerNow, color=color.lime, width=2)
    else
        line.set_xy1(lowerLine, bar_index - 1, lowerNow[1])
        line.set_xy2(lowerLine, bar_index,     lowerNow)

bgcolor(showTriangleZone and inTriangle ? color.new(color.blue, 92) : na)
plot(showLevels ? upperNow : na, "Triangle Upper (projected)", color=color.new(color.red, 0), linewidth=1)
plot(showLevels ? lowerNow : na, "Triangle Lower (projected)", color=color.new(color.lime, 0), linewidth=1)
plot(useTrendFilter ? emaTrend : na, "EMA Trend", color=color.orange, linewidth=2)

plotshape(longTrig,  title="Triangle Breakout LONG",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.green, 0), size=size.small, text="L")
plotshape(shortTrig, title="Triangle Breakout SHORT", style=shape.triangledown, location=location.abovebar, color=color.new(color.red,   0), size=size.small, text="S")

alertcondition(longTrig,  title="Triangle Breakout LONG",  message="KedArcQuant Triangle Breakout LONG on {{exchange}}:{{ticker}} ({{interval}})")
alertcondition(shortTrig, title="Triangle Breakout SHORT", message="KedArcQuant Triangle Breakout SHORT on {{exchange}}:{{ticker}} ({{interval}})")

//────────────────────────────────────────────────────────────────────
// Dashboard
//────────────────────────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 11, bgcolor=color.new(color.gray, 85), border_width=1)

progColor =
     na(triProgress) ? color.white :
     triProgress < 40 ? color.red :
     triProgress < 70 ? color.orange :
     color.lime

if showDashboard and barstate.islast
    // Clear table cells to avoid stale values
    for r = 0 to 10
        table.cell(t, 0, r, "", text_size=size.small)
        table.cell(t, 1, r, "", text_size=size.small)

    table.cell(t,0,0,"Triangle", text_color=color.white, bgcolor=color.new(color.navy, 20), text_size=size.small)
    table.cell(t,1,0, inTriangle ? "YES" : "no", text_color=inTriangle ? color.lime : color.red, bgcolor=color.new(color.navy, 20), text_size=size.small)

    table.cell(t,0,1,"Height OK", text_color=color.white, text_size=size.small)
    table.cell(t,1,1, heightOK ? "YES" : "no", text_color=heightOK ? color.lime : color.red, text_size=size.small)

    table.cell(t,0,2,"Maturity OK", text_color=color.white, text_size=size.small)
    table.cell(t,1,2, maturityOK ? "YES" : "no", text_color=maturityOK ? color.lime : color.red, text_size=size.small)

    table.cell(t,0,3,"Tri Progress", text_color=color.white, text_size=size.small)
    table.cell(t,1,3, na(triProgress) ? "—" : str.tostring(triProgress, "#.0") + "%", text_color=progColor, text_size=size.small)

    table.cell(t,0,4,"Squeeze", text_color=color.white, text_size=size.small)
    table.cell(t,1,4, useSqueeze ? (squeeze ? "YES" : "no") : "OFF",
        text_color=useSqueeze ? (squeeze ? color.lime : color.red) : color.yellow, text_size=size.small)

    table.cell(t,0,5,"Trend", text_color=color.white, text_size=size.small)
    string tr = not useTrendFilter ? "OFF" : close > emaTrend ? "Bull" : "Bear"
    table.cell(t,1,5, tr, text_color=tr=="Bull"?color.lime:tr=="Bear"?color.red:color.yellow, text_size=size.small)

    table.cell(t,0,6,"Vol OK", text_color=color.white, text_size=size.small)
    table.cell(t,1,6, volOK ? "YES" : "no", text_color=volOK ? color.lime : color.red, text_size=size.small)

    table.cell(t,0,7,"Upper", text_color=color.white, text_size=size.small)
    table.cell(t,1,7, na(upperNow) ? "—" : str.tostring(upperNow, "#.##"), text_color=color.white, text_size=size.small)

    table.cell(t,0,8,"Lower", text_color=color.white, text_size=size.small)
    table.cell(t,1,8, na(lowerNow) ? "—" : str.tostring(lowerNow, "#.##"), text_color=color.white, text_size=size.small)

    table.cell(t,0,9,"State", text_color=color.white, text_size=size.small)
    string st = posState==1 ? "LONG" : posState==-1 ? "SHORT" : "FLAT"
    table.cell(t,1,9, st, text_color=posState==1?color.lime:posState==-1?color.red:color.white, text_size=size.small)

    table.cell(t,0,10,"Signal", text_color=color.white, bgcolor=color.new(color.navy, 20), text_size=size.small)
    string sig = longTrig ? "LONG" : shortTrig ? "SHORT" : "—"
    color  sc  = longTrig ? color.lime : shortTrig ? color.red : color.white
    table.cell(t,1,10, sig, text_color=sc, bgcolor=color.new(color.navy, 20), text_size=size.small)
