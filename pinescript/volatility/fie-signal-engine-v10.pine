//@version=6
// FIE Signal Engine v1.0 - Financial Intelligence Engine
// Jhaveri Securities - Comprehensive Technical Intelligence via Webhook
// Computes 25+ indicators and sends rich JSON payload via webhook alert

indicator("FIE Signal Engine v1.0", shorttitle="FIE", overlay=true, max_labels_count=50)

// ---------------------------------------------------------------------------
// SECTION 1: USER INPUTS
// ---------------------------------------------------------------------------

i_alert_name    = input.string("",       title="Alert Name",         group="Alert Config", tooltip="Descriptive name for this alert")
i_signal_type   = input.string("BULLISH", title="Signal Direction",  group="Alert Config", options=["BULLISH", "BEARISH", "NEUTRAL"])
i_alert_type    = input.string("ABSOLUTE", title="Alert Type",      group="Alert Config", options=["ABSOLUTE", "RELATIVE"])
i_custom_msg    = input.string("",       title="Custom Message",     group="Alert Config", tooltip="Optional custom note for fund managers")
i_asset_class   = input.string("EQUITY", title="Asset Class",       group="Alert Config", options=["EQUITY", "INDEX", "COMMODITY", "CURRENCY", "CRYPTO", "BOND", "RATIO"])
i_sector        = input.string("",       title="Sector",            group="Alert Config", tooltip="e.g., IT, Banking, Pharma, Auto, Metal, Energy")

i_trigger       = input.string("Manual (Always)", title="Trigger Condition", group="Trigger", options=["Manual (Always)", "RSI Oversold/Overbought", "EMA Cross (9/21)", "EMA Cross (20/50)", "MACD Signal Cross", "SuperTrend Flip", "Bollinger Band Touch", "VWAP Cross", "Price Above/Below EMA 200", "Volume Spike"])

i_htf           = input.timeframe("D",   title="Higher Timeframe",   group="Multi-Timeframe", tooltip="Used for HTF trend context (Daily recommended)")

i_rsi_len       = input.int(14,          title="RSI Length",          group="Indicator Settings", minval=2)
i_macd_fast     = input.int(12,          title="MACD Fast",           group="Indicator Settings", minval=1)
i_macd_slow     = input.int(26,          title="MACD Slow",           group="Indicator Settings", minval=1)
i_macd_signal   = input.int(9,           title="MACD Signal",         group="Indicator Settings", minval=1)
i_bb_len        = input.int(20,          title="BB Length",           group="Indicator Settings", minval=2)
i_bb_mult       = input.float(2.0,       title="BB Multiplier",      group="Indicator Settings", minval=0.1, step=0.1)
i_atr_len       = input.int(14,          title="ATR Length",          group="Indicator Settings", minval=1)
i_st_factor     = input.float(3.0,       title="SuperTrend Factor",  group="Indicator Settings", minval=0.1, step=0.1)
i_st_atr_len    = input.int(10,          title="SuperTrend ATR Len", group="Indicator Settings", minval=1)
i_vol_spike_mult = input.float(2.0,      title="Volume Spike Mult",  group="Indicator Settings", minval=1.0, step=0.1)
i_stoch_k       = input.int(14,          title="Stochastic K",       group="Indicator Settings", minval=1)
i_stoch_d       = input.int(3,           title="Stochastic D",       group="Indicator Settings", minval=1)
i_stoch_smooth   = input.int(3,          title="Stochastic Smooth",  group="Indicator Settings", minval=1)
i_adx_len       = input.int(14,          title="ADX Length",          group="Indicator Settings", minval=1)
i_cci_len       = input.int(20,          title="CCI Length",          group="Indicator Settings", minval=1)
i_mfi_len       = input.int(14,          title="MFI Length",          group="Indicator Settings", minval=1)
i_willy_len     = input.int(14,          title="Williams R Length",   group="Indicator Settings", minval=1)


// ---------------------------------------------------------------------------
// SECTION 2: CURRENT TIMEFRAME INDICATORS
// ---------------------------------------------------------------------------

float price_open  = open
float price_high  = high
float price_low   = low
float price_close = close
float price_vol   = volume

// Moving Averages
float ema_9   = ta.ema(close, 9)
float ema_20  = ta.ema(close, 20)
float ema_21  = ta.ema(close, 21)
float ema_50  = ta.ema(close, 50)
float ema_100 = ta.ema(close, 100)
float ema_200 = ta.ema(close, 200)
float sma_20  = ta.sma(close, 20)
float sma_50  = ta.sma(close, 50)
float sma_200 = ta.sma(close, 200)
float vwap_val = ta.vwap(hlc3)

// RSI
float rsi_val  = ta.rsi(close, i_rsi_len)

// MACD
[macd_line, macd_signal_line, macd_hist] = ta.macd(close, i_macd_fast, i_macd_slow, i_macd_signal)

// Bollinger Bands
float bb_basis = ta.sma(close, i_bb_len)
float bb_dev   = i_bb_mult * ta.stdev(close, i_bb_len)
float bb_upper = bb_basis + bb_dev
float bb_lower = bb_basis - bb_dev
float bb_width = (bb_upper - bb_lower) / bb_basis * 100
float bb_pctb  = (close - bb_lower) / (bb_upper - bb_lower) * 100

// ATR
float atr_val     = ta.atr(i_atr_len)
float atr_pct     = atr_val / close * 100

// SuperTrend
[st_value, st_direction] = ta.supertrend(i_st_factor, i_st_atr_len)
string st_trend = st_direction < 0 ? "BULLISH" : "BEARISH"

// Stochastic
float stoch_k = ta.sma(ta.stoch(close, high, low, i_stoch_k), i_stoch_smooth)
float stoch_d = ta.sma(stoch_k, i_stoch_d)

// ADX / DMI
[di_plus, di_minus, adx_val] = ta.dmi(i_adx_len, i_adx_len)

// CCI
float cci_val = ta.cci(close, i_cci_len)

// MFI
float mfi_val = ta.mfi(hlc3, i_mfi_len)

// Williams %R
float willy_val = ta.wpr(i_willy_len)

// OBV
float obv_val = ta.obv

// Volume Analysis
float vol_sma_20  = ta.sma(volume, 20)
float vol_ratio   = volume / vol_sma_20
bool  vol_spike   = vol_ratio > i_vol_spike_mult

// Pivot Points
float pivot_pp = (high[1] + low[1] + close[1]) / 3
float pivot_r1 = 2 * pivot_pp - low[1]
float pivot_s1 = 2 * pivot_pp - high[1]
float pivot_r2 = pivot_pp + (high[1] - low[1])
float pivot_s2 = pivot_pp - (high[1] - low[1])

// Price Position vs MAs
float dist_ema_20  = (close - ema_20) / ema_20 * 100
float dist_ema_50  = (close - ema_50) / ema_50 * 100
float dist_ema_200 = (close - ema_200) / ema_200 * 100
float dist_vwap    = (close - vwap_val) / vwap_val * 100

// Trend Assessment
var string ma_alignment = "MIXED"
if ema_9 > ema_21 and ema_21 > ema_50 and ema_50 > ema_200
    ma_alignment := "STRONG_BULL"
else if ema_9 < ema_21 and ema_21 < ema_50 and ema_50 < ema_200
    ma_alignment := "STRONG_BEAR"
else if ema_9 > ema_21 and ema_21 > ema_50
    ma_alignment := "BULL"
else if ema_9 < ema_21 and ema_21 < ema_50
    ma_alignment := "BEAR"
else
    ma_alignment := "MIXED"

// Encode string values as numbers for plot placeholders
// (alertcondition can only use {{plot("name")}} which returns numbers)
float ma_align_code = ma_alignment == "STRONG_BULL" ? 2 : ma_alignment == "BULL" ? 1 : ma_alignment == "STRONG_BEAR" ? -2 : ma_alignment == "BEAR" ? -1 : 0
float st_dir_code = st_direction < 0 ? 1 : -1

// Candlestick Patterns
bool is_doji     = math.abs(close - open) <= (high - low) * 0.1
bool is_hammer   = (math.min(open, close) - low) >= 2 * math.abs(close - open) and (high - math.max(open, close)) <= math.abs(close - open) * 0.5
bool is_engulf_bull = close[1] < open[1] and close > open and close > open[1] and open < close[1]
bool is_engulf_bear = close[1] > open[1] and close < open and close < open[1] and open > close[1]

var string candle_pattern = "NONE"
if is_engulf_bull
    candle_pattern := "BULLISH_ENGULFING"
else if is_engulf_bear
    candle_pattern := "BEARISH_ENGULFING"
else if is_hammer
    candle_pattern := "HAMMER"
else if is_doji
    candle_pattern := "DOJI"
else
    candle_pattern := "NONE"

float candle_code = is_engulf_bull ? 2 : is_engulf_bear ? -2 : is_hammer ? 1 : is_doji ? 0.5 : 0

// Bar Stats
float bar_range    = high - low
float bar_body     = math.abs(close - open)
float body_pct     = bar_range > 0 ? bar_body / bar_range * 100 : 0

// Recent High/Low
float high_20  = ta.highest(high, 20)
float low_20   = ta.lowest(low, 20)
float high_52w = ta.highest(high, 252)
float low_52w  = ta.lowest(low, 252)
float pct_from_high_20 = (close - high_20) / high_20 * 100
float pct_from_low_20  = (close - low_20) / low_20 * 100


// ---------------------------------------------------------------------------
// SECTION 3: HIGHER TIMEFRAME (MTF) INDICATORS
// ---------------------------------------------------------------------------

float htf_rsi      = request.security(syminfo.tickerid, i_htf, ta.rsi(close, i_rsi_len), lookahead=barmerge.lookahead_off)
float htf_ema_20   = request.security(syminfo.tickerid, i_htf, ta.ema(close, 20), lookahead=barmerge.lookahead_off)
float htf_ema_50   = request.security(syminfo.tickerid, i_htf, ta.ema(close, 50), lookahead=barmerge.lookahead_off)
float htf_ema_200  = request.security(syminfo.tickerid, i_htf, ta.ema(close, 200), lookahead=barmerge.lookahead_off)
float htf_atr      = request.security(syminfo.tickerid, i_htf, ta.atr(i_atr_len), lookahead=barmerge.lookahead_off)
[htf_macd_l, htf_macd_s, htf_macd_h] = request.security(syminfo.tickerid, i_htf, ta.macd(close, i_macd_fast, i_macd_slow, i_macd_signal), lookahead=barmerge.lookahead_off)
[htf_st_val, htf_st_dir] = request.security(syminfo.tickerid, i_htf, ta.supertrend(i_st_factor, i_st_atr_len), lookahead=barmerge.lookahead_off)
string htf_st_trend = htf_st_dir < 0 ? "BULLISH" : "BEARISH"
float htf_close    = request.security(syminfo.tickerid, i_htf, close, lookahead=barmerge.lookahead_off)

var string htf_trend = "NEUTRAL"
if htf_close > htf_ema_20 and htf_ema_20 > htf_ema_50
    htf_trend := "BULLISH"
else if htf_close < htf_ema_20 and htf_ema_20 < htf_ema_50
    htf_trend := "BEARISH"
else
    htf_trend := "NEUTRAL"

float htf_trend_code = htf_trend == "BULLISH" ? 1 : htf_trend == "BEARISH" ? -1 : 0
float htf_st_code = htf_st_dir < 0 ? 1 : -1


// ---------------------------------------------------------------------------
// SECTION 4: CONFLUENCE SCORING
// ---------------------------------------------------------------------------

int bull_score = 0
bull_score += rsi_val < 40 ? 1 : 0
bull_score += close > ema_20 ? 1 : 0
bull_score += close > ema_50 ? 1 : 0
bull_score += close > ema_200 ? 1 : 0
bull_score += macd_hist > 0 ? 1 : 0
bull_score += st_direction < 0 ? 1 : 0
bull_score += close > vwap_val ? 1 : 0
bull_score += adx_val > 20 and di_plus > di_minus ? 1 : 0
bull_score += htf_trend == "BULLISH" ? 1 : 0
bull_score += vol_ratio > 1.2 ? 1 : 0

int bear_score = 0
bear_score += rsi_val > 60 ? 1 : 0
bear_score += close < ema_20 ? 1 : 0
bear_score += close < ema_50 ? 1 : 0
bear_score += close < ema_200 ? 1 : 0
bear_score += macd_hist < 0 ? 1 : 0
bear_score += st_direction > 0 ? 1 : 0
bear_score += close < vwap_val ? 1 : 0
bear_score += adx_val > 20 and di_minus > di_plus ? 1 : 0
bear_score += htf_trend == "BEARISH" ? 1 : 0
bear_score += vol_ratio > 1.2 ? 1 : 0

int confluence_score = bull_score - bear_score
float signal_strength = i_signal_type == "BULLISH" ? bull_score : i_signal_type == "BEARISH" ? bear_score : 5


// ---------------------------------------------------------------------------
// SECTION 5: ALERT TRIGGER CONDITIONS
// ---------------------------------------------------------------------------

bool cross_rsi_above_30    = ta.crossover(rsi_val, 30)
bool cross_rsi_below_70    = ta.crossunder(rsi_val, 70)
bool cross_ema9_over_21    = ta.crossover(ema_9, ema_21)
bool cross_ema9_under_21   = ta.crossunder(ema_9, ema_21)
bool cross_ema20_over_50   = ta.crossover(ema_20, ema_50)
bool cross_ema20_under_50  = ta.crossunder(ema_20, ema_50)
bool cross_macd_over       = ta.crossover(macd_line, macd_signal_line)
bool cross_macd_under      = ta.crossunder(macd_line, macd_signal_line)
bool cross_st_over         = ta.crossover(st_direction, 0)
bool cross_st_under        = ta.crossunder(st_direction, 0)
bool cross_vwap_over       = ta.crossover(close, vwap_val)
bool cross_vwap_under      = ta.crossunder(close, vwap_val)
bool cross_ema200_over     = ta.crossover(close, ema_200)
bool cross_ema200_under    = ta.crossunder(close, ema_200)

bool trigger_condition = false

if i_trigger == "Manual (Always)"
    trigger_condition := true
else if i_trigger == "RSI Oversold/Overbought"
    trigger_condition := cross_rsi_above_30 or cross_rsi_below_70
else if i_trigger == "EMA Cross (9/21)"
    trigger_condition := cross_ema9_over_21 or cross_ema9_under_21
else if i_trigger == "EMA Cross (20/50)"
    trigger_condition := cross_ema20_over_50 or cross_ema20_under_50
else if i_trigger == "MACD Signal Cross"
    trigger_condition := cross_macd_over or cross_macd_under
else if i_trigger == "SuperTrend Flip"
    trigger_condition := cross_st_over or cross_st_under
else if i_trigger == "Bollinger Band Touch"
    trigger_condition := close <= bb_lower or close >= bb_upper
else if i_trigger == "VWAP Cross"
    trigger_condition := cross_vwap_over or cross_vwap_under
else if i_trigger == "Price Above/Below EMA 200"
    trigger_condition := cross_ema200_over or cross_ema200_under
else if i_trigger == "Volume Spike"
    trigger_condition := vol_spike


// ---------------------------------------------------------------------------
// SECTION 6: DATA PLOTS (hidden - used by alertcondition placeholders)
// These plots carry indicator values that {{plot("name")}} reads at alert time
// ---------------------------------------------------------------------------

// Hidden data plots for alert message placeholders
plot(rsi_val,       "p_rsi",        display=display.none, editable=false)
plot(macd_hist,     "p_macd_hist",  display=display.none, editable=false)
plot(adx_val,       "p_adx",        display=display.none, editable=false)
plot(st_dir_code,   "p_st_dir",     display=display.none, editable=false)
plot(stoch_k,       "p_stoch_k",    display=display.none, editable=false)
plot(stoch_d,       "p_stoch_d",    display=display.none, editable=false)
plot(cci_val,       "p_cci",        display=display.none, editable=false)
plot(mfi_val,       "p_mfi",        display=display.none, editable=false)
plot(willy_val,     "p_willy",      display=display.none, editable=false)
plot(atr_val,       "p_atr",        display=display.none, editable=false)
plot(atr_pct,       "p_atr_pct",    display=display.none, editable=false)
plot(bb_pctb,       "p_bb_pctb",    display=display.none, editable=false)
plot(bb_width,      "p_bb_width",   display=display.none, editable=false)
plot(vol_ratio,     "p_vol_ratio",  display=display.none, editable=false)
plot(ma_align_code, "p_ma_align",   display=display.none, editable=false)
plot(candle_code,   "p_candle",     display=display.none, editable=false)
plot(htf_trend_code,"p_htf_trend",  display=display.none, editable=false)
plot(htf_rsi,       "p_htf_rsi",    display=display.none, editable=false)
plot(bull_score,    "p_bull",       display=display.none, editable=false)
plot(bear_score,    "p_bear",       display=display.none, editable=false)


// ---------------------------------------------------------------------------
// SECTION 7: ALERT CONDITIONS
// alertcondition() appears in the alert dropdown
// alert() sends the full dynamic JSON via webhook
// ---------------------------------------------------------------------------

// Build dynamic JSON for alert() function
f_round(float val) =>
    math.round(val * 100) / 100

f_str(float val) =>
    na(val) ? "null" : str.tostring(f_round(val))

f_str4(float val) =>
    na(val) ? "null" : str.tostring(math.round(val * 10000) / 10000)

f_q(string val) =>
    '"' + val + '"'

string s_ticker   = str.tostring(syminfo.ticker)
string s_exchange = str.tostring(syminfo.tickerid)
string s_currency = str.tostring(syminfo.currency)
string s_type     = str.tostring(syminfo.type)
string s_interval = str.tostring(timeframe.period)

string j = '{"fie_version":"1.0","source":"pine"'
j += ',"ticker":' + f_q(s_ticker)
j += ',"exchange":' + f_q(s_exchange)
j += ',"interval":' + f_q(s_interval)
j += ',"currency":' + f_q(s_currency)
j += ',"market_type":' + f_q(s_type)
j += ',"alert_name":' + f_q(i_alert_name)
j += ',"signal":' + f_q(i_signal_type)
j += ',"alert_type":' + f_q(i_alert_type)
j += ',"asset_class":' + f_q(i_asset_class)
j += ',"sector":' + f_q(i_sector)
j += ',"custom_message":' + f_q(i_custom_msg)
j += ',"trigger_condition":' + f_q(i_trigger)
j += ',"price":{"open":' + f_str(price_open) + ',"high":' + f_str(price_high) + ',"low":' + f_str(price_low) + ',"close":' + f_str(price_close) + ',"volume":' + f_str(price_vol) + '}'
j += ',"momentum":{"rsi":' + f_str(rsi_val) + ',"stoch_k":' + f_str(stoch_k) + ',"stoch_d":' + f_str(stoch_d) + ',"cci":' + f_str(cci_val) + ',"mfi":' + f_str(mfi_val) + ',"williams_r":' + f_str(willy_val) + '}'
j += ',"trend":{"macd_line":' + f_str4(macd_line) + ',"macd_signal":' + f_str4(macd_signal_line) + ',"macd_hist":' + f_str4(macd_hist) + ',"supertrend":' + f_str(st_value) + ',"supertrend_dir":' + f_q(st_trend) + ',"adx":' + f_str(adx_val) + ',"di_plus":' + f_str(di_plus) + ',"di_minus":' + f_str(di_minus) + '}'
j += ',"moving_averages":{"ema_9":' + f_str(ema_9) + ',"ema_20":' + f_str(ema_20) + ',"ema_50":' + f_str(ema_50) + ',"ema_200":' + f_str(ema_200) + ',"vwap":' + f_str(vwap_val) + ',"ma_alignment":"' + ma_alignment + '"}'
j += ',"volatility":{"atr":' + f_str(atr_val) + ',"atr_pct":' + f_str(atr_pct) + ',"bb_upper":' + f_str(bb_upper) + ',"bb_lower":' + f_str(bb_lower) + ',"bb_pctb":' + f_str(bb_pctb) + '}'
j += ',"volume_analysis":{"volume":' + f_str(price_vol) + ',"vol_ratio":' + f_str(vol_ratio) + ',"vol_spike":' + (vol_spike ? 'true' : 'false') + '}'
j += ',"levels":{"pivot_pp":' + f_str(pivot_pp) + ',"high_20":' + f_str(high_20) + ',"low_20":' + f_str(low_20) + '}'
j += ',"htf":{"timeframe":"' + i_htf + '","trend":"' + htf_trend + '","rsi":' + f_str(htf_rsi) + '}'
j += ',"confluence":{"bull_score":' + str.tostring(bull_score) + ',"bear_score":' + str.tostring(bear_score) + ',"net_score":' + str.tostring(confluence_score) + '}'
j += ',"candle_pattern":"' + candle_pattern + '"}'

string full_json = j

// alertcondition — this shows "FIE Signal" in the alert condition dropdown
alertcondition(trigger_condition, title="FIE Signal", message='FIE Signal Triggered')

// alert() — this sends the full JSON payload to the webhook
if trigger_condition
    alert(full_json, alert.freq_once_per_bar_close)


// ---------------------------------------------------------------------------
// SECTION 8: VISUAL OVERLAYS
// ---------------------------------------------------------------------------

plot(ema_9,   "EMA 9",   color=color.new(color.blue, 70),   linewidth=1)
plot(ema_21,  "EMA 21",  color=color.new(color.orange, 70), linewidth=1)
plot(ema_50,  "EMA 50",  color=color.new(color.red, 70),    linewidth=1)
plot(ema_200, "EMA 200", color=color.new(color.purple, 50), linewidth=2)

plot(st_value, "SuperTrend", color=st_direction < 0 ? color.green : color.red, linewidth=2, style=plot.style_linebr)

plot(vwap_val, "VWAP", color=color.new(color.yellow, 50), linewidth=1, style=plot.style_circles)

plotshape(trigger_condition and i_signal_type == "BULLISH", "Bull Signal", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(trigger_condition and i_signal_type == "BEARISH", "Bear Signal", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small)

p_bb_upper = plot(bb_upper, "BB Upper", color=color.new(color.gray, 80))
p_bb_lower = plot(bb_lower, "BB Lower", color=color.new(color.gray, 80))
fill(p_bb_upper, p_bb_lower, color=color.new(color.blue, 95))
