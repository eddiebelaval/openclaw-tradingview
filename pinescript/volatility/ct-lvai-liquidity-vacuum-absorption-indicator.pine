//═════════════════════════════════════════════════════════════════════
// CT LVAI ⊕ Liquidity Vacuum & Absorption Indicator
// Structural Liquidity & Market Stability Diagnostics
//═════════════════════════════════════════════════════════════════════
//
// WHAT THIS INDICATOR DOES:
// Measures how well the market is absorbing volatility.
// Identifies when volatility becomes instability (liquidity failure).
//
// CORE IDEA:
// Not all volatility is dangerous.
// Markets can be volatile AND stable — or volatile AND fragile.
// LVAI detects the difference.
//
// HOW IT WORKS:
// Combines:
// 1) Volatility Shock (True Range expansion)
// 2) Price Efficiency (trend vs chop behavior)
//
// High volatility + low efficiency = Liquidity Vacuum (risk)
//
// OUTPUT (0–100 SCALE):
// 0–40   → Healthy liquidity (stable, efficient movement)
// 40–70  → Transitional (degrading structure, more noise)
// 70–100 → Liquidity vacuum (fragile, unstable conditions)
//
// HOW TO USE:
//
// • LOW LVAI (<40):
//   - Trend-following works best
//   - Breakouts are cleaner
//
// • MID LVAI (40–70):
//   - Increased chop and fakeouts
//   - Reduce expectations and risk
//
// • HIGH LVAI (>70):
//   - Market is fragile
//   - Expect sharp moves, wicks, or cascades
//
// IMPORTANT:
// This is NOT a directional signal.
// It does NOT tell you what to buy or sell.
// It tells you how stable (or unstable) the environment is.
//
// SPEED MODES:
// TWITCHY → very fast, noisy, early warnings
// FAST    → default, responsive (recommended)
// MEDIUM  → balanced, smoother
// SLOW    → structural, macro regime detection
//
// RELATION TO MFSRM (CT ⊕ Market Fragility & Systemic Risk Monitor v1.0):
//
// MFSRM → measures SYSTEM STRESS (how much pressure exists)
// LVAI  → measures MARKET CAPACITY (can it handle that pressure?)
//
// Together:
// Stress + Weak Absorption = True Fragility
//@version=6
indicator("CT LVAI ⊕ Liquidity Vacuum & Absorption Indicator", overlay=false)

//==================================================
// 🔧 INPUTS (WITH PRESETS + HINTS)
//==================================================

// Preset selector
preset = input.string("FAST", "Speed Preset",
     options=["TWITCHY", "FAST", "MEDIUM", "SLOW"],
     tooltip="Controls overall responsiveness.\n\nTWITCHY = very fast, noisy\nFAST = default, responsive\nMEDIUM = balanced\nSLOW = structural / macro")

// Manual override toggle
useCustom = input.bool(false, "Use Custom Settings",
     tooltip="Enable to manually control Lookback & Normalization lengths.\n\nDisable to use preset behavior.")

// Custom inputs (used only if override is ON)
lv_len_input = input.int(30, "Lookback Length",
     minval=10,
     tooltip="Controls responsiveness.\n\nLower = faster, noisier\nHigher = smoother, slower")

normLen_input = input.int(100, "Normalization Length",
     minval=50,
     tooltip="Controls structural smoothing.\n\nLower = faster adaptation\nHigher = more stable regimes")

//==================================================
// 🧠 PRESET LOGIC
//==================================================

// Assign values based on preset
lv_len =
     useCustom ? lv_len_input :
     preset == "TWITCHY" ? 15 :
     preset == "FAST"    ? 30 :
     preset == "MEDIUM"  ? 50 :
                           100

normLen =
     useCustom ? normLen_input :
     preset == "TWITCHY" ? 60 :
     preset == "FAST"    ? 100 :
     preset == "MEDIUM"  ? 200 :
                           400

// Thresholds (unchanged)
vacThresh  = input.float(70, "Vacuum Threshold")
healThresh = input.float(40, "Healthy Threshold")
//==================================================
// 🧠 HELPER FUNCTIONS
//==================================================
f_norm(x, len) =>
    lo = ta.lowest(x, len)
    hi = ta.highest(x, len)
    100 * (x - lo) / math.max(hi - lo, 1e-6)

f_zscore(x, len) =>
    mean = ta.sma(x, len)
    std  = ta.stdev(x, len)
    std != 0 ? (x - mean) / std : 0

//==================================================
// 📊 CORE LOGIC
//==================================================

// True range & volatility
tr = ta.tr(true)

// Efficiency ratio
netMove   = math.abs(close - close[lv_len])
totalMove = math.sum(math.abs(ta.change(close)), lv_len)
efficiency = totalMove != 0 ? netMove / totalMove : 0

// Volatility shock
volShock = math.abs(f_zscore(tr, lv_len))

// Liquidity vacuum score
lvai_raw = volShock * (1 - efficiency)

// Normalize
lvai = f_norm(lvai_raw, normLen)

//==================================================
// 🚨 STATES
//==================================================
vacuum      = lvai > vacThresh and efficiency < 0.3
healthy     = lvai < healThresh and efficiency > 0.5
transitional = not vacuum and not healthy

//==================================================
// 📈 PLOTS
//==================================================
lvaiColor =
     lvai < 40 ? color.lime :
     lvai < 70 ? color.orange :
                 color.red

plot(lvai, title="LVAI", color=lvaiColor, linewidth=2)
hline(vacThresh, "Vacuum Zone", color=color.red)
hline(healThresh, "Healthy Zone", color=color.green)



//==================================================
// 🎨 ZONE SHADING (FIXED VARIABLE NAMES)
//==================================================
p_lv_0   = plot(0,   display=display.none)
p_lv_40  = plot(40,  display=display.none)
p_lv_70  = plot(70,  display=display.none)
p_lv_100 = plot(100, display=display.none)

fill(p_lv_0,  p_lv_40,  color=color.new(color.green, 90))
fill(p_lv_40, p_lv_70,  color=color.new(color.yellow, 90))
fill(p_lv_70, p_lv_100, color=color.new(color.red, 90))
// Background states
bgcolor(vacuum ? color.new(color.red, 85) : na)
bgcolor(healthy ? color.new(color.green, 90) : na)

//==================================================
// 🔔 ALERTS
//==================================================
alertcondition(vacuum and not vacuum[1],
     title="Liquidity Vacuum",
     message="Liquidity vacuum detected: volatility rising but price not efficiently moving.")

alertcondition(healthy and not healthy[1],
     title="Liquidity Healthy",
     message="Market liquidity absorption is healthy.")
