//@version=6
indicator("Adaptive RR (ATR-based)", "ATR RR", overlay=true)

// ============================================
// SETTINGS
// ============================================

// Group: ATR Parameters
atr_timeframe = input.timeframe("", "ATR Timeframe", group="ATR Settings")
atr_period = input.int(14, "ATR Period", minval=1, group="ATR Settings")
atr_avg_period = input.int(30, "ATR Averaging Period", minval=2, group="ATR Settings")

// Group: Thresholds and Scaling
atr_low_threshold = input.float(0.8, "ATR Low Threshold", minval=0.1, step=0.1, group="Thresholds")
atr_high_threshold = input.float(1.2, "ATR High Threshold", minval=0.1, step=0.1, group="Thresholds")
atr_max_scaling = input.float(2.0, "Max Scaling", minval=1.0, step=0.1, group="Thresholds")

// Group: Target RR
target_rr = input.float(2.0, "Target RR (Base)", minval=0.1, step=0.1, group="Risk/Reward")
rr_absolute_min = input.float(1.0, "Absolute Minimum RR", minval=0.1, step=0.1, group="Risk/Reward")
rr_absolute_max = input.float(3.5, "Absolute Maximum RR", minval=0.1, step=0.5, group="Risk/Reward")

// Group: Table Settings
table_position = input.string("Top Right", "Table Position", 
     options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], 
     group="Display")
table_size = input.string("Normal", "Table Size", 
     options=["Auto", "Tiny", "Small", "Normal", "Large", "Huge"], 
     group="Display")
text_color = input.color(color.white, "Text Color", group="Display")
bg_color = input.color(color.new(#1a1a1a, 10), "Background Color", group="Display")

// Group: Volatility Colors
color_low = input.color(color.new(#2196F3, 0), "Color: Low Volatility", group="Volatility Colors")
color_normal = input.color(color.new(#4CAF50, 0), "Color: Normal Volatility", group="Volatility Colors")
color_high = input.color(color.new(#FF9800, 0), "Color: High Volatility", group="Volatility Colors")

// ============================================
// ATR CALCULATION
// ============================================

// Get ATR on selected timeframe
current_atr = request.security(syminfo.tickerid, atr_timeframe, ta.atr(atr_period))

// Calculate average ATR for averaging period
average_atr = request.security(syminfo.tickerid, atr_timeframe, ta.sma(ta.atr(atr_period), atr_avg_period))

// ATR Ratio = current ATR / average ATR
atr_ratio = average_atr > 0 ? current_atr / average_atr : 1.0

// ============================================
// SCALING FACTOR CALCULATION
// ============================================

float scaling = 1.0

if atr_ratio < atr_low_threshold
    // Low volatility: decrease RR
    float atr_range = atr_low_threshold
    float min_scaling = 1.0 / atr_max_scaling
    scaling := min_scaling + (1.0 - min_scaling) * (atr_ratio / atr_range)
else if atr_ratio > atr_high_threshold
    // High volatility: increase RR
    float atr_range = atr_high_threshold
    float ratio_above = atr_ratio - atr_high_threshold
    scaling := 1.0 + (atr_max_scaling - 1.0) * math.min(ratio_above / atr_range, 1.0)
else
    // Normal volatility: smooth interpolation
    float normalized = (atr_ratio - atr_low_threshold) / (atr_high_threshold - atr_low_threshold)
    scaling := 0.9 + 0.2 * normalized

// ============================================
// ADAPTIVE RR
// ============================================

float adaptive_rr = target_rr * scaling

// Apply limits
float adaptive_rr_final = math.max(rr_absolute_min, math.min(adaptive_rr, rr_absolute_max))

// ============================================
// VOLATILITY STATUS
// ============================================

string volatility_status = atr_ratio < atr_low_threshold ? "Low" : 
                           atr_ratio > atr_high_threshold ? "High" : "Normal"

color volatility_color = atr_ratio < atr_low_threshold ? color_low : 
                         atr_ratio > atr_high_threshold ? color_high : color_normal

// ============================================
// TABLE DISPLAY
// ============================================

// Define table position
string table_pos = switch table_position
    "Top Left" => position.top_left
    "Top Center" => position.top_center
    "Top Right" => position.top_right
    "Middle Left" => position.middle_left
    "Middle Center" => position.middle_center
    "Middle Right" => position.middle_right
    "Bottom Left" => position.bottom_left
    "Bottom Center" => position.bottom_center
    "Bottom Right" => position.bottom_right
    => position.top_right

// Define table size
string table_text_size = switch table_size
    "Auto" => size.auto
    "Tiny" => size.tiny
    "Small" => size.small
    "Normal" => size.normal
    "Large" => size.large
    "Huge" => size.huge
    => size.normal

// Create table
var table info_table = table.new(table_pos, 2, 4, border_width=1)

if barstate.islast
    // Header
    table.cell(info_table, 0, 0, "Adaptive RR", 
               text_color=text_color, bgcolor=bg_color, 
               text_size=table_text_size, text_halign=text.align_center)
    table.merge_cells(info_table, 0, 0, 1, 0)
    
    // Row 1: Recommended RR
    table.cell(info_table, 0, 1, "Recommended RR:", 
               text_color=text_color, bgcolor=bg_color, 
               text_size=table_text_size, text_halign=text.align_left)
    table.cell(info_table, 1, 1, str.format("{0,number,#.##}", adaptive_rr_final), 
               text_color=volatility_color, bgcolor=bg_color, 
               text_size=table_text_size, text_halign=text.align_right)
    
    // Row 2: ATR Ratio
    table.cell(info_table, 0, 2, "ATR Ratio:", 
               text_color=text_color, bgcolor=bg_color, 
               text_size=table_text_size, text_halign=text.align_left)
    table.cell(info_table, 1, 2, str.format("{0,number,#.##}", atr_ratio), 
               text_color=volatility_color, bgcolor=bg_color, 
               text_size=table_text_size, text_halign=text.align_right)
    
    // Row 3: Volatility
    table.cell(info_table, 0, 3, "Volatility:", 
               text_color=text_color, bgcolor=bg_color, 
               text_size=table_text_size, text_halign=text.align_left)
    table.cell(info_table, 1, 3, volatility_status, 
               text_color=volatility_color, bgcolor=bg_color, 
               text_size=table_text_size, text_halign=text.align_right)

// ============================================
// ALERTS (optional)
// ============================================

// Alerts for volatility changes
alertcondition(ta.cross(atr_ratio, atr_low_threshold), 
               title="Volatility Changed", 
               message="ATR Ratio crossed low threshold")

alertcondition(ta.cross(atr_ratio, atr_high_threshold), 
               title="High Volatility", 
               message="ATR Ratio crossed high threshold")

// ============================================
// PLOT (for debugging and Data Window)
// ============================================

// Output values for chart (invisible but available in Data Window)
plot(adaptive_rr_final, "Adaptive RR", display=display.data_window)
plot(atr_ratio, "ATR Ratio", display=display.data_window)
plot(scaling, "Scaling Factor", display=display.data_window)
