// This Pine Script™ source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/

//@version=5
indicator("Esco Theory — Geometry Model [CRACKED]", overlay=true, max_lines_count=500, max_labels_count=400, max_boxes_count=200)


// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════

grp_swing = "━━━ Structure ━━━"
swingLen       = input.int(21, "Swing Lookback", minval=5, maxval=100, group=grp_swing)
majorSwingLen  = input.int(55, "Major Swing Lookback", minval=10, maxval=200, group=grp_swing)
maxMinorSwings = input.int(10, "Max Minor Swings", minval=4, maxval=20, group=grp_swing)
maxMajorSwings = input.int(6, "Max Major Swings", minval=2, maxval=10, group=grp_swing)

grp_ms = "━━━ Market Structure ━━━"
showMSS        = input.bool(true, "Show BOS / MSS", group=grp_ms)
msBullCol      = input.color(color.new(#4CAF50, 20), "Bullish", group=grp_ms)
msBearCol      = input.color(color.new(#F44336, 20), "Bearish", group=grp_ms)
showDisplacement = input.bool(true, "Highlight Displacement", group=grp_ms, tooltip="Colors candles where body > 1.5x ATR")

grp_geo = "━━━ Geometric Rails ━━━"
showRails          = input.bool(true, "Show Rails", group=grp_geo)
showMajorRails     = input.bool(true, "Show Major Cycle Rails", group=grp_geo)
showFan            = input.bool(true, "Show Cycle Fan", group=grp_geo)
railExtend         = input.int(150, "Extension (bars)", minval=20, maxval=500, group=grp_geo)
railColor          = input.color(color.new(#2B2B2B, 20), "Rail Color", group=grp_geo)
majorRailColor     = input.color(color.new(#000000, 0), "Major Rail Color", group=grp_geo)
railWidth          = input.int(1, "Rail Width", minval=1, maxval=3, group=grp_geo)
majorRailWidth     = input.int(2, "Major Rail Width", minval=1, maxval=4, group=grp_geo)
maxCrossRails      = input.int(2, "Max Cross-Rails Per Side", minval=0, maxval=4, group=grp_geo)

grp_sr = "━━━ Support / Resistance ━━━"
showSR             = input.bool(true, "Show S/R Levels", group=grp_sr)
srMinTouches       = input.int(2, "Min Touches", minval=1, maxval=5, group=grp_sr)
srTolerance        = input.float(0.4, "Cluster Tolerance (%)", minval=0.05, maxval=3.0, step=0.05, group=grp_sr)
srSupportCol       = input.color(color.new(#E69138, 25), "Support Color", group=grp_sr)
srResistCol        = input.color(color.new(#E69138, 25), "Resistance Color", group=grp_sr)
srLineWidth        = input.int(2, "Line Width", minval=1, maxval=4, group=grp_sr)

grp_sd = "━━━ Supply / Demand ━━━"
showSD             = input.bool(true, "Show S/D Zones", group=grp_sd)
sdLookback         = input.int(15, "S/D Pivot Length", minval=5, maxval=50, group=grp_sd)
sdMaxZones         = input.int(4, "Max Zones Per Side", minval=1, maxval=8, group=grp_sd)
sdMitigate         = input.bool(true, "Auto-Remove Mitigated", group=grp_sd)
sdFadeRetests      = input.bool(true, "Fade on Retests", group=grp_sd)
sdSupplyEdge       = input.color(color.new(#D98880, 40), "Supply Color", group=grp_sd)
sdDemandEdge       = input.color(color.new(#85C1E9, 40), "Demand Color", group=grp_sd)

grp_fvg = "━━━ Fair Value Gaps ━━━"
showFVG            = input.bool(true, "Show FVGs", group=grp_fvg)
fvgMinSize         = input.float(0.1, "Min Gap Size (%)", minval=0.01, maxval=2.0, step=0.05, group=grp_fvg)
fvgMaxAge          = input.int(100, "Max Age (bars)", minval=20, maxval=500, group=grp_fvg)
fvgMitigate        = input.bool(true, "Auto-Remove Filled", group=grp_fvg)
fvgBullCol         = input.color(color.new(#85C1E9, 88), "Bullish FVG", group=grp_fvg)
fvgBearCol         = input.color(color.new(#D98880, 88), "Bearish FVG", group=grp_fvg)
showIFVG           = input.bool(true, "Show iFVGs", group=grp_fvg)
ifvgBullCol        = input.color(color.new(#85C1E9, 92), "Bullish iFVG", group=grp_fvg)
ifvgBearCol        = input.color(color.new(#D98880, 92), "Bearish iFVG", group=grp_fvg)

grp_pd = "━━━ Premium / Discount ━━━"
showPD             = input.bool(true, "Show Premium/Discount", group=grp_pd)
pdPremCol          = input.color(color.new(#D98880, 94), "Premium", group=grp_pd)
pdDiscCol          = input.color(color.new(#85C1E9, 94), "Discount", group=grp_pd)

grp_conf = "━━━ Confluence ━━━"
showConfluence     = input.bool(true, "Highlight Confluence Zones", group=grp_conf)
confThreshold      = input.float(2.0, "Cluster Width (%)", minval=0.5, maxval=10.0, step=0.5, group=grp_conf)
confMinLevels      = input.int(3, "Min Levels", minval=2, maxval=6, group=grp_conf)
confBullCol        = input.color(color.new(#85C1E9, 88), "Support Confluence", group=grp_conf)
confBearCol        = input.color(color.new(#D98880, 88), "Resistance Confluence", group=grp_conf)

grp_comp = "━━━ Compression ━━━"
showCompression    = input.bool(true, "Show Compression", group=grp_comp)
compLen            = input.int(13, "Compression Pivot Length", minval=5, maxval=50, group=grp_comp)
compColor          = input.color(color.new(#2B2B2B, 50), "Wedge Color", group=grp_comp)
showBG             = input.bool(true, "Background Shading", group=grp_comp)

grp_liq = "━━━ Liquidity ━━━"
showLiquidity      = input.bool(true, "Show EQH / EQL", group=grp_liq)
liqColor           = input.color(color.new(#5DADE2, 35), "Liquidity Color", group=grp_liq)
eqThreshold        = input.float(0.3, "Equal Level Tolerance (%)", minval=0.05, maxval=2.0, step=0.05, group=grp_liq)
showLiqSweep       = input.bool(true, "Mark Liquidity Sweeps", group=grp_liq)
sweepCol           = input.color(color.new(#FF5722, 0), "Sweep Color", group=grp_liq)


// ═══════════════════════════════════════════════════════════════
// PIVOT DETECTION
// ═══════════════════════════════════════════════════════════════

pivHi    = ta.pivothigh(high, swingLen, swingLen)
pivLo    = ta.pivotlow(low, swingLen, swingLen)
majPivHi = ta.pivothigh(high, majorSwingLen, majorSwingLen)
majPivLo = ta.pivotlow(low, majorSwingLen, majorSwingLen)

var float[] hiP = array.new_float(0),  var int[] hiB = array.new_int(0)
var float[] loP = array.new_float(0),  var int[] loB = array.new_int(0)
var float[] mhP = array.new_float(0),  var int[] mhB = array.new_int(0)
var float[] mlP = array.new_float(0),  var int[] mlB = array.new_int(0)

_push(arr_p, arr_b, price, idx, cap) =>
    array.unshift(arr_p, price)
    array.unshift(arr_b, idx)
    if array.size(arr_p) > cap
        array.pop(arr_p)
        array.pop(arr_b)

if not na(pivHi)
    _push(hiP, hiB, pivHi, bar_index - swingLen, maxMinorSwings)
if not na(pivLo)
    _push(loP, loB, pivLo, bar_index - swingLen, maxMinorSwings)
if not na(majPivHi)
    _push(mhP, mhB, majPivHi, bar_index - majorSwingLen, maxMajorSwings)
if not na(majPivLo)
    _push(mlP, mlB, majPivLo, bar_index - majorSwingLen, maxMajorSwings)


// ═══════════════════════════════════════════════════════════════
// MARKET STRUCTURE -- BOS / MSS
// ═══════════════════════════════════════════════════════════════

var float msLastHH = na
var float msLastLL = na
var int   msTrend  = 0

if showMSS
    if not na(pivHi)
        if not na(msLastHH) and pivHi > msLastHH
            pB = bar_index - swingLen
            if msTrend != 1
                label.new(pB, pivHi, " MSS ", style=label.style_label_down, color=msBullCol, textcolor=color.white, size=size.tiny)
                msTrend := 1
            else
                label.new(pB, pivHi, " BOS ", style=label.style_label_down, color=color.new(msBullCol, 65), textcolor=color.new(color.white, 20), size=size.tiny)
        msLastHH := pivHi

    if not na(pivLo)
        if not na(msLastLL) and pivLo < msLastLL
            pB = bar_index - swingLen
            if msTrend != -1
                label.new(pB, pivLo, " MSS ", style=label.style_label_up, color=msBearCol, textcolor=color.white, size=size.tiny)
                msTrend := -1
            else
                label.new(pB, pivLo, " BOS ", style=label.style_label_up, color=color.new(msBearCol, 65), textcolor=color.new(color.white, 20), size=size.tiny)
        msLastLL := pivLo


// ═══════════════════════════════════════════════════════════════
// DISPLACEMENT CANDLES -- barcolor instead of bgcolor (cleaner)
// ═══════════════════════════════════════════════════════════════

dispATR = ta.atr(14)
isDisplacement = math.abs(close - open) > dispATR * 1.5
dispIsBull = isDisplacement and close > open
dispIsBear = isDisplacement and close < open
barcolor(showDisplacement and dispIsBull ? color.new(#00E676, 0) : showDisplacement and dispIsBear ? color.new(#FF5252, 0) : na, title="Displacement Candles")


// ═══════════════════════════════════════════════════════════════
// SUPPLY & DEMAND
// ═══════════════════════════════════════════════════════════════

sdPivHi = ta.pivothigh(high, sdLookback, sdLookback)
sdPivLo = ta.pivotlow(low, sdLookback, sdLookback)

var float[] sTopArr = array.new_float(0), var float[] sBotArr = array.new_float(0)
var int[]   sBarArr = array.new_int(0),   var bool[]  sActArr = array.new_bool(0)
var float[] dTopArr = array.new_float(0), var float[] dBotArr = array.new_float(0)
var int[]   dBarArr = array.new_int(0),   var bool[]  dActArr = array.new_bool(0)
var int[]   sTestArr = array.new_int(0)
var int[]   dTestArr = array.new_int(0)

if showSD
    if not na(sdPivHi)
        pb = bar_index - sdLookback
        pH = high[sdLookback]
        pO = open[sdLookback]
        pC = close[sdLookback]
        bodySize = math.abs(pO - pC)
        
        dispOK = false
        if sdLookback > 1
            nxtBody = math.abs(open[sdLookback - 1] - close[sdLookback - 1])
            dispOK := close[sdLookback - 1] < math.min(pO, pC) and nxtBody > bodySize * 0.5
        
        if dispOK
            zt = pH
            zb = math.min(pO, pC)
            if (zt - zb) / zt * 100 > 0.1
                array.unshift(sTopArr, zt)
                array.unshift(sBotArr, zb)
                array.unshift(sBarArr, pb)
                array.unshift(sActArr, true)
                array.unshift(sTestArr, 0)
                if array.size(sTopArr) > sdMaxZones * 3
                    array.pop(sTopArr)
                    array.pop(sBotArr)
                    array.pop(sBarArr)
                    array.pop(sActArr)
                    array.pop(sTestArr)

    if not na(sdPivLo)
        pb = bar_index - sdLookback
        pL = low[sdLookback]
        pO = open[sdLookback]
        pC = close[sdLookback]
        bodySize = math.abs(pO - pC)
        
        dispOK = false
        if sdLookback > 1
            nxtBody = math.abs(open[sdLookback - 1] - close[sdLookback - 1])
            dispOK := close[sdLookback - 1] > math.max(pO, pC) and nxtBody > bodySize * 0.5
        
        if dispOK
            zt = math.max(pO, pC)
            zb = pL
            if zb > 0 and (zt - zb) / zb * 100 > 0.1
                array.unshift(dTopArr, zt)
                array.unshift(dBotArr, zb)
                array.unshift(dBarArr, pb)
                array.unshift(dActArr, true)
                array.unshift(dTestArr, 0)
                if array.size(dTopArr) > sdMaxZones * 3
                    array.pop(dTopArr)
                    array.pop(dBotArr)
                    array.pop(dBarArr)
                    array.pop(dActArr)
                    array.pop(dTestArr)

    // Mitigation
    if sdMitigate
        if array.size(sActArr) > 0
            for i = 0 to array.size(sActArr) - 1
                if array.get(sActArr, i) and close > array.get(sTopArr, i)
                    array.set(sActArr, i, false)
        if array.size(dActArr) > 0
            for i = 0 to array.size(dActArr) - 1
                if array.get(dActArr, i) and close < array.get(dBotArr, i)
                    array.set(dActArr, i, false)

    // Retest tracking
    if sdFadeRetests
        if array.size(sActArr) > 0
            for i = 0 to array.size(sActArr) - 1
                if array.get(sActArr, i) and high >= array.get(sBotArr, i) and high[1] < array.get(sBotArr, i)
                    array.set(sTestArr, i, array.get(sTestArr, i) + 1)
        if array.size(dActArr) > 0
            for i = 0 to array.size(dActArr) - 1
                if array.get(dActArr, i) and low <= array.get(dTopArr, i) and low[1] > array.get(dTopArr, i)
                    array.set(dTestArr, i, array.get(dTestArr, i) + 1)


// ═══════════════════════════════════════════════════════════════
// FAIR VALUE GAPS + iFVGs
// ═══════════════════════════════════════════════════════════════

var float[] fvgTop = array.new_float(0)
var float[] fvgBot = array.new_float(0)
var int[]   fvgBar = array.new_int(0)
var int[]   fvgDir = array.new_int(0)
var bool[]  fvgAct = array.new_bool(0)
var bool[]  ifvgAct = array.new_bool(0)

if showFVG and bar_index > 2
    bull1 = close > open
    bull2 = close[1] > open[1]
    bull3 = close[2] > open[2]
    if bull1 and bull2 and bull3 and low > high[2]
        gapSize = (low - high[2]) / high[2] * 100
        if gapSize > fvgMinSize
            array.unshift(fvgTop, low)
            array.unshift(fvgBot, high[2])
            array.unshift(fvgBar, bar_index - 1)
            array.unshift(fvgDir, 1)
            array.unshift(fvgAct, true)
            array.unshift(ifvgAct, false)

    bear1 = close < open
    bear2 = close[1] < open[1]
    bear3 = close[2] < open[2]
    if bear1 and bear2 and bear3 and low[2] > high
        gapSize = (low[2] - high) / high * 100
        if gapSize > fvgMinSize
            array.unshift(fvgTop, low[2])
            array.unshift(fvgBot, high)
            array.unshift(fvgBar, bar_index - 1)
            array.unshift(fvgDir, -1)
            array.unshift(fvgAct, true)
            array.unshift(ifvgAct, false)

    if array.size(fvgTop) > 30
        array.pop(fvgTop)
        array.pop(fvgBot)
        array.pop(fvgBar)
        array.pop(fvgDir)
        array.pop(fvgAct)
        array.pop(ifvgAct)

if showFVG and array.size(fvgAct) > 0
    for i = 0 to array.size(fvgAct) - 1
        if array.get(fvgAct, i)
            if bar_index - array.get(fvgBar, i) > fvgMaxAge
                array.set(fvgAct, i, false)
            else if fvgMitigate
                mid = (array.get(fvgTop, i) + array.get(fvgBot, i)) / 2
                if array.get(fvgDir, i) == 1 and low < mid
                    array.set(fvgAct, i, false)
                    if showIFVG
                        array.set(ifvgAct, i, true)
                if array.get(fvgDir, i) == -1 and high > mid
                    array.set(fvgAct, i, false)
                    if showIFVG
                        array.set(ifvgAct, i, true)
        else if array.get(ifvgAct, i)
            if bar_index - array.get(fvgBar, i) > fvgMaxAge
                array.set(ifvgAct, i, false)
            else
                d = array.get(fvgDir, i)
                if d == 1 and close > array.get(fvgTop, i)
                    array.set(ifvgAct, i, false)
                if d == -1 and close < array.get(fvgBot, i)
                    array.set(ifvgAct, i, false)


// ═══════════════════════════════════════════════════════════════
// LIQUIDITY SWEEP DETECTION
// ═══════════════════════════════════════════════════════════════

// Track sweeps as simple plotshape instead of label arrays (cleaner, no label bloat)
var float lastEQH = na
var float lastEQL = na

// Recalculate nearest EQH/EQL each bar for sweep detection
nearEQH = false
nearEQL = false

if showLiqSweep and array.size(hiP) >= 2
    for i = 0 to math.min(array.size(hiP) - 2, 4)
        for j = i + 1 to math.min(array.size(hiP) - 1, i + 3)
            p1 = array.get(hiP, i)
            p2 = array.get(hiP, j)
            if math.abs(p1 - p2) / p1 * 100 < eqThreshold
                eq = math.avg(p1, p2)
                if high > eq and close < eq and high[1] <= eq
                    nearEQH := true
                    lastEQH := eq

if showLiqSweep and array.size(loP) >= 2
    for i = 0 to math.min(array.size(loP) - 2, 4)
        for j = i + 1 to math.min(array.size(loP) - 1, i + 3)
            p1 = array.get(loP, i)
            p2 = array.get(loP, j)
            if math.abs(p1 - p2) / p1 * 100 < eqThreshold
                eq = math.avg(p1, p2)
                if low < eq and close > eq and low[1] >= eq
                    nearEQL := true
                    lastEQL := eq

// Clean plotshape for sweeps -- no label accumulation
plotshape(nearEQH, title="EQH Sweep", style=shape.xcross, location=location.abovebar, color=sweepCol, size=size.small)
plotshape(nearEQL, title="EQL Sweep", style=shape.xcross, location=location.belowbar, color=sweepCol, size=size.small)

// Count recent sweeps for dashboard
var int recentSweepCount = 0
if nearEQH or nearEQL
    recentSweepCount := recentSweepCount + 1
if bar_index % 50 == 0
    recentSweepCount := 0


// ═══════════════════════════════════════════════════════════════
// COMPRESSION
// ═══════════════════════════════════════════════════════════════

atrFast = ta.atr(7)
atrSlow = ta.atr(50)
atrRatio = atrFast / atrSlow
isCompressing = atrRatio < 0.6

compPivHi = ta.pivothigh(high, compLen, compLen)
compPivLo = ta.pivotlow(low, compLen, compLen)

var float cH1 = na, var int cHB1 = na, var float cH2 = na, var int cHB2 = na
var float cL1 = na, var int cLB1 = na, var float cL2 = na, var int cLB2 = na

if not na(compPivHi)
    cH2 := cH1, cHB2 := cHB1
    cH1 := compPivHi, cHB1 := bar_index - compLen
if not na(compPivLo)
    cL2 := cL1, cLB2 := cLB1
    cL1 := compPivLo, cLB1 := bar_index - compLen

isWedge = false
if not na(cH1) and not na(cH2) and not na(cL1) and not na(cL2)
    if cHB1 != cHB2 and cLB1 != cLB2
        curRange  = cH1 - cL1
        prevRange = cH2 - cL2
        if prevRange > 0 and curRange > 0
            isWedge := curRange < prevRange * 0.85

bgcolor(showBG and isCompressing ? color.new(#FFEB3B, 96) : na, title="Compression BG")

bbBasis  = ta.sma(close, 20)
bbDev    = 2.0 * ta.stdev(close, 20)
bbWidth  = (bbDev * 2) / bbBasis * 100
kcBasis  = ta.ema(close, 20)
kcRange  = ta.atr(10) * 1.5
inSqueeze = (bbBasis + bbDev) < (kcBasis + kcRange) and (bbBasis - bbDev) > (kcBasis - kcRange)

plotshape(inSqueeze and showCompression, title="Squeeze", style=shape.diamond, location=location.bottom, color=color.new(#FF5722, 20), size=size.tiny)
plotshape(inSqueeze[1] and not inSqueeze and showCompression, title="Fire", style=shape.triangleup, location=location.bottom, color=color.new(#4CAF50, 0), size=size.small)


// ═══════════════════════════════════════════════════════════════
// DRAWING -- LAST BAR ONLY
// ═══════════════════════════════════════════════════════════════

_rail(b1, p1, b2, p2, col, w, sty) =>
    _b1 = math.max(b1, bar_index - 500)
    _b2 = math.max(b2, bar_index - 500)
    if _b1 != _b2
        slope = (p2 - p1) / (b2 - b1)
        extP  = p2 + slope * (bar_index + railExtend - b2)
        line.new(_b1, p1 + slope * (_b1 - b1), bar_index + railExtend, extP, color=col, width=w, style=sty)

_safeBar(b) =>
    math.max(b, bar_index - 500)

if barstate.islast

    // ─── MINOR RAILS ───
    if showRails
        if array.size(hiP) >= 2
            for i = 0 to math.min(array.size(hiP) - 2, 4)
                _rail(array.get(hiB, i+1), array.get(hiP, i+1), array.get(hiB, i), array.get(hiP, i), railColor, railWidth, line.style_solid)
        if array.size(loP) >= 2
            for i = 0 to math.min(array.size(loP) - 2, 4)
                _rail(array.get(loB, i+1), array.get(loP, i+1), array.get(loB, i), array.get(loP, i), railColor, railWidth, line.style_solid)

        if maxCrossRails > 0 and array.size(hiP) >= 1 and array.size(loP) >= 1
            drawn = 0
            for hi = 0 to math.min(array.size(hiP) - 1, maxCrossRails)
                for lo = 0 to math.min(array.size(loP) - 1, maxCrossRails)
                    if drawn < maxCrossRails * 2
                        bH = array.get(hiB, hi), pH_ = array.get(hiP, hi)
                        bL = array.get(loB, lo), pL_ = array.get(loP, lo)
                        if bH != bL and math.abs(bH - bL) > swingLen
                            sb = math.min(bH, bL), sp = bH < bL ? pH_ : pL_
                            eb = math.max(bH, bL), ep = bH > bL ? pH_ : pL_
                            _rail(sb, sp, eb, ep, color.new(railColor, 55), 1, line.style_dotted)
                            drawn += 1

    // ─── MAJOR RAILS ───
    if showMajorRails
        if array.size(mhP) >= 2
            for i = 0 to math.min(array.size(mhP) - 2, 3)
                _rail(array.get(mhB, i+1), array.get(mhP, i+1), array.get(mhB, i), array.get(mhP, i), majorRailColor, majorRailWidth, line.style_solid)
        if array.size(mlP) >= 2
            for i = 0 to math.min(array.size(mlP) - 2, 3)
                _rail(array.get(mlB, i+1), array.get(mlP, i+1), array.get(mlB, i), array.get(mlP, i), majorRailColor, majorRailWidth, line.style_solid)

    // ─── CYCLE FAN ───
    if showFan and array.size(mlP) >= 1 and array.size(mhP) >= 1
        lowIdx = 0
        lowP_  = array.get(mlP, 0)
        if array.size(mlP) > 1
            for i = 1 to array.size(mlP) - 1
                if array.get(mlP, i) < lowP_
                    lowP_ := array.get(mlP, i)
                    lowIdx := i
        aB = array.get(mlB, lowIdx)
        aP = lowP_
        for i = 0 to math.min(array.size(mhP) - 1, 4)
            tB = array.get(mhB, i), tP = array.get(mhP, i)
            if tB > aB
                _rail(aB, aP, tB, tP, color.new(railColor, 10), 2, line.style_solid)

        highIdx = 0
        highP_  = array.get(mhP, 0)
        if array.size(mhP) > 1
            for i = 1 to array.size(mhP) - 1
                if array.get(mhP, i) > highP_
                    highP_ := array.get(mhP, i)
                    highIdx := i
        aB2 = array.get(mhB, highIdx)
        aP2 = highP_
        for i = 0 to math.min(array.size(mlP) - 1, 4)
            tB = array.get(mlB, i), tP = array.get(mlP, i)
            if tB > aB2
                _rail(aB2, aP2, tB, tP, color.new(majorRailColor, 10), 2, line.style_solid)

    // ─── S/R LEVELS ───
    if showSR
        float[] cands = array.new_float(0)
        if array.size(mhP) > 0
            for i = 0 to array.size(mhP) - 1
                array.push(cands, array.get(mhP, i))
        if array.size(mlP) > 0
            for i = 0 to array.size(mlP) - 1
                array.push(cands, array.get(mlP, i))
        if array.size(hiP) > 0
            for i = 0 to math.min(array.size(hiP) - 1, 6)
                array.push(cands, array.get(hiP, i))
        if array.size(loP) > 0
            for i = 0 to math.min(array.size(loP) - 1, 6)
                array.push(cands, array.get(loP, i))

        if array.size(cands) > 1
            array.sort(cands, order.ascending)
            float[] srLvl = array.new_float(0)
            int[]   srCnt = array.new_int(0)
            ci = 0
            while ci < array.size(cands)
                base = array.get(cands, ci)
                upper = base * (1 + srTolerance / 100)
                cnt = 1
                total = base
                cj = ci + 1
                scanning = cj < array.size(cands)
                while scanning
                    if cj >= array.size(cands)
                        scanning := false
                    else if array.get(cands, cj) <= upper
                        cnt += 1
                        total += array.get(cands, cj)
                        cj += 1
                    else
                        scanning := false
                if cnt >= srMinTouches
                    array.push(srLvl, total / cnt)
                    array.push(srCnt, cnt)
                ci := cj
            
            if array.size(srLvl) > 0
                for i = 0 to array.size(srLvl) - 1
                    lvl = array.get(srLvl, i)
                    cnt = array.get(srCnt, i)
                    isSup = lvl < close
                    col = isSup ? srSupportCol : srResistCol
                    w   = cnt >= 4 ? srLineWidth + 1 : srLineWidth
                    line.new(bar_index - 200, lvl, bar_index + 50, lvl, color=col, width=w, style=line.style_dashed)
                    label.new(bar_index + 52, lvl, (isSup ? "S" : "R") + " (" + str.tostring(cnt) + ")", style=label.style_none, textcolor=col, size=size.tiny)

    // ─── SUPPLY & DEMAND ZONES ───
    if showSD
        drawnS = 0
        if array.size(sTopArr) > 0
            for i = 0 to array.size(sTopArr) - 1
                if drawnS < sdMaxZones and array.get(sActArr, i)
                    zb_ = _safeBar(array.get(sBarArr, i))
                    tests = array.get(sTestArr, i)
                    alpha = sdFadeRetests ? math.min(85 + tests * 4, 96) : 85
                    box.new(zb_, array.get(sTopArr, i), bar_index + 30, array.get(sBotArr, i), bgcolor=color.new(sdSupplyEdge, alpha), border_color=sdSupplyEdge, border_width=1)
                    tag = tests > 0 ? "S x" + str.tostring(tests) : "S"
                    label.new(zb_ + 3, array.get(sTopArr, i), tag, style=label.style_none, textcolor=sdSupplyEdge, size=size.tiny)
                    drawnS += 1
        drawnD = 0
        if array.size(dTopArr) > 0
            for i = 0 to array.size(dTopArr) - 1
                if drawnD < sdMaxZones and array.get(dActArr, i)
                    zb_ = _safeBar(array.get(dBarArr, i))
                    tests = array.get(dTestArr, i)
                    alpha = sdFadeRetests ? math.min(85 + tests * 4, 96) : 85
                    box.new(zb_, array.get(dTopArr, i), bar_index + 30, array.get(dBotArr, i), bgcolor=color.new(sdDemandEdge, alpha), border_color=sdDemandEdge, border_width=1)
                    tag = tests > 0 ? "D x" + str.tostring(tests) : "D"
                    label.new(zb_ + 3, array.get(dBotArr, i), tag, style=label.style_none, textcolor=sdDemandEdge, size=size.tiny)
                    drawnD += 1

    // ─── FVGs + iFVGs ───
    if showFVG and array.size(fvgAct) > 0
        fvgDrawn = 0
        for i = 0 to array.size(fvgAct) - 1
            if fvgDrawn >= 12
                break
            ft = array.get(fvgTop, i)
            fb = array.get(fvgBot, i)
            fb_ = _safeBar(array.get(fvgBar, i))
            d  = array.get(fvgDir, i)
            if array.get(fvgAct, i)
                fvgCol = d == 1 ? fvgBullCol : fvgBearCol
                box.new(fb_, ft, bar_index + 15, fb, bgcolor=fvgCol, border_color=color.new(fvgCol, -20), border_width=1)
                fvgDrawn += 1
            else if showIFVG and array.get(ifvgAct, i)
                ifCol = d == 1 ? ifvgBearCol : ifvgBullCol
                box.new(fb_, ft, bar_index + 15, fb, bgcolor=ifCol, border_color=color.new(ifCol, -20), border_width=1)
                fvgDrawn += 1

    // ─── PREMIUM / DISCOUNT ───
    if showPD and array.size(mhP) >= 1 and array.size(mlP) >= 1
        pdHigh = array.get(mhP, 0)
        pdLow  = array.get(mlP, 0)
        if pdHigh > pdLow
            pdMid  = (pdHigh + pdLow) / 2
            pd75   = pdLow + (pdHigh - pdLow) * 0.75
            pd25   = pdLow + (pdHigh - pdLow) * 0.25
            box.new(bar_index - 40, pdHigh, bar_index + 20, pd75, bgcolor=pdPremCol, border_color=color.new(color.white, 100))
            box.new(bar_index - 40, pd25, bar_index + 20, pdLow, bgcolor=pdDiscCol, border_color=color.new(color.white, 100))
            line.new(bar_index - 40, pdMid, bar_index + 20, pdMid, color=color.new(#888888, 40), width=1, style=line.style_dotted)
            label.new(bar_index + 22, pdMid, "EQ", style=label.style_none, textcolor=color.new(#888888, 30), size=size.tiny)

    // ─── LIQUIDITY ───
    if showLiquidity
        if array.size(hiP) >= 2
            for i = 0 to math.min(array.size(hiP) - 2, 6)
                for j = i + 1 to math.min(array.size(hiP) - 1, i + 4)
                    p1 = array.get(hiP, i), p2 = array.get(hiP, j)
                    b1 = array.get(hiB, i), b2 = array.get(hiB, j)
                    if math.abs(p1 - p2) / p1 * 100 < eqThreshold and b1 != b2
                        eq = math.avg(p1, p2)
                        line.new(_safeBar(math.min(b1, b2)), eq, bar_index + 25, eq, color=liqColor, width=2, style=line.style_dashed)
                        label.new(bar_index + 27, eq, "EQH", style=label.style_none, textcolor=liqColor, size=size.tiny)
        if array.size(loP) >= 2
            for i = 0 to math.min(array.size(loP) - 2, 6)
                for j = i + 1 to math.min(array.size(loP) - 1, i + 4)
                    p1 = array.get(loP, i), p2 = array.get(loP, j)
                    b1 = array.get(loB, i), b2 = array.get(loB, j)
                    if math.abs(p1 - p2) / p1 * 100 < eqThreshold and b1 != b2
                        eq = math.avg(p1, p2)
                        line.new(_safeBar(math.min(b1, b2)), eq, bar_index + 25, eq, color=liqColor, width=2, style=line.style_dashed)
                        label.new(bar_index + 27, eq, "EQL", style=label.style_none, textcolor=liqColor, size=size.tiny)

    // ─── CONFLUENCE ───
    if showConfluence
        float[] allLvl = array.new_float(0)
        if array.size(mhP) > 0
            for i = 0 to array.size(mhP) - 1
                array.push(allLvl, array.get(mhP, i))
        if array.size(mlP) > 0
            for i = 0 to array.size(mlP) - 1
                array.push(allLvl, array.get(mlP, i))
        if array.size(hiP) > 0
            for i = 0 to math.min(array.size(hiP) - 1, 8)
                array.push(allLvl, array.get(hiP, i))
        if array.size(loP) > 0
            for i = 0 to math.min(array.size(loP) - 1, 8)
                array.push(allLvl, array.get(loP, i))

        if array.size(allLvl) > 1
            array.sort(allLvl, order.ascending)
            ci2 = 0
            while ci2 < array.size(allLvl)
                base = array.get(allLvl, ci2)
                upper = base * (1 + confThreshold / 100)
                cnt = 1
                cj2 = ci2 + 1
                scanning = cj2 < array.size(allLvl)
                while scanning
                    if cj2 >= array.size(allLvl)
                        scanning := false
                    else if array.get(allLvl, cj2) <= upper
                        cnt += 1
                        cj2 += 1
                    else
                        scanning := false
                if cnt >= confMinLevels
                    zHi = array.get(allLvl, math.min(cj2 - 1, array.size(allLvl) - 1))
                    zLo = base
                    zMid = (zHi + zLo) / 2
                    col = zMid < close ? confBullCol : confBearCol
                    box.new(bar_index - 120, zHi, bar_index + 40, zLo, bgcolor=col, border_color=color.new(color.white, 100))
                    label.new(bar_index - 125, zMid, "CONF (" + str.tostring(cnt) + ")", style=label.style_none, textcolor=color.new(col, -40), size=size.small)
                    ci2 := cj2
                else
                    ci2 += 1

    // ─── COMPRESSION WEDGE ───
    if showCompression
        if not na(cH1) and not na(cH2) and cHB1 != cHB2
            _rail(cHB2, cH2, cHB1, cH1, compColor, 2, line.style_dashed)
        if not na(cL1) and not na(cL2) and cLB1 != cLB2
            _rail(cLB2, cL2, cLB1, cL1, compColor, 2, line.style_dashed)


// ═══════════════════════════════════════════════════════════════
// DASHBOARD
// ═══════════════════════════════════════════════════════════════

var table panel = table.new(position.top_right, 2, 10, bgcolor=color.new(#0D1117, 5), border_width=0)

if barstate.islast
    // Header
    table.cell(panel, 0, 0, "ESCO THEORY", text_color=#C9A84C, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 0, "CRACKED", text_color=#C9A84C, text_size=size.tiny, text_halign=text.align_right)

    // Bias
    biasStr = msTrend == 1 ? "BULLISH" : msTrend == -1 ? "BEARISH" : "NEUTRAL"
    biasCol = msTrend == 1 ? #4CAF50 : msTrend == -1 ? #F44336 : #888888
    table.cell(panel, 0, 1, "Bias:", text_color=#AAAAAA, text_size=size.tiny, text_halign=text.align_left)
    table.cell(panel, 1, 1, biasStr, text_color=biasCol, text_size=size.tiny, text_halign=text.align_right)

    // Zone position
    zoneStr = "--"
    zoneCol = #888888
    if array.size(mhP) >= 1 and array.size(mlP) >= 1
        pdH = array.get(mhP, 0)
        pdL = array.get(mlP, 0)
        if pdH > pdL
            pdPct = (close - pdL) / (pdH - pdL) * 100
            zoneStr := pdPct > 75 ? "PREMIUM " + str.tostring(pdPct, "#") + "%" : pdPct < 25 ? "DISCOUNT " + str.tostring(pdPct, "#") + "%" : "EQ " + str.tostring(pdPct, "#") + "%"
            zoneCol := pdPct > 75 ? #F44336 : pdPct < 25 ? #4CAF50 : #888888
    table.cell(panel, 0, 2, "Zone:", text_color=#AAAAAA, text_size=size.tiny, text_halign=text.align_left)
    table.cell(panel, 1, 2, zoneStr, text_color=zoneCol, text_size=size.tiny, text_halign=text.align_right)

    // Separator
    table.cell(panel, 0, 3, "", text_size=size.tiny)
    table.cell(panel, 1, 3, "", text_size=size.tiny)

    // Volatility
    cs = inSqueeze ? "SQUEEZE" : isCompressing ? "COMPRESS" : "EXPAND"
    cc = inSqueeze ? #FF5722 : isCompressing ? #FFEB3B : #4CAF50
    table.cell(panel, 0, 4, "Vol:", text_color=#AAAAAA, text_size=size.tiny, text_halign=text.align_left)
    table.cell(panel, 1, 4, cs, text_color=cc, text_size=size.tiny, text_halign=text.align_right)

    table.cell(panel, 0, 5, "ATR:", text_color=#AAAAAA, text_size=size.tiny, text_halign=text.align_left)
    table.cell(panel, 1, 5, str.tostring(atrRatio, "#.##"), text_color=atrRatio < 0.6 ? #FFEB3B : #CCCCCC, text_size=size.tiny, text_halign=text.align_right)

    table.cell(panel, 0, 6, "BBW:", text_color=#AAAAAA, text_size=size.tiny, text_halign=text.align_left)
    table.cell(panel, 1, 6, str.tostring(bbWidth, "#.##") + "%", text_color=#CCCCCC, text_size=size.tiny, text_halign=text.align_right)

    ws = isWedge ? "ACTIVE" : "--"
    table.cell(panel, 0, 7, "Wedge:", text_color=#AAAAAA, text_size=size.tiny, text_halign=text.align_left)
    table.cell(panel, 1, 7, ws, text_color=isWedge ? #FFEB3B : #666666, text_size=size.tiny, text_halign=text.align_right)

    // FVG count
    activeFVG = 0
    activeIFVG = 0
    if array.size(fvgAct) > 0
        for i = 0 to array.size(fvgAct) - 1
            if array.get(fvgAct, i)
                activeFVG += 1
            else if array.get(ifvgAct, i)
                activeIFVG += 1
    table.cell(panel, 0, 8, "FVG:", text_color=#AAAAAA, text_size=size.tiny, text_halign=text.align_left)
    table.cell(panel, 1, 8, str.tostring(activeFVG) + " / " + str.tostring(activeIFVG) + "i", text_color=#CCCCCC, text_size=size.tiny, text_halign=text.align_right)

    // Sweeps
    table.cell(panel, 0, 9, "Sweeps:", text_color=#AAAAAA, text_size=size.tiny, text_halign=text.align_left)
    table.cell(panel, 1, 9, str.tostring(recentSweepCount), text_color=recentSweepCount > 0 ? #FF5722 : #666666, text_size=size.tiny, text_halign=text.align_right)
