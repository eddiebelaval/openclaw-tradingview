//@version=6
//──────────────────────────────────────────────────────────────────────────────
//  [TL5 Alerts] Day High Low Tracker
//──────────────────────────────────────────────────────────────────────────────
//  Author      : TL5
//  Version     : 2.0
//  Pine Version: 6
//──────────────────────────────────────────────────────────────────────────────
//
//  OVERVIEW
//  ────────────────────────────────────────────────────────────────────────────
//  The Day High Low Tracker dynamically monitors the current trading session’s
//  High and Low in real time.
//
//  As price evolves throughout the day, the script:
//
//    • Continuously recalculates the session High
//    • Continuously recalculates the session Low
//    • Detects when a NEW High is formed
//    • Detects when a NEW Low is formed
//    • Optionally plots visual labels
//    • Sends alert notifications (including webhook-ready JSON)
//
//  Recommended usage: 1-minute timeframe for precise intraday tracking.
//  Works on other intraday timeframes as well.
//
//──────────────────────────────────────────────────────────────────────────────
//  HOW IT WORKS
//──────────────────────────────────────────────────────────────────────────────
//
//  1. Detects the start of each regular trading session.
//  2. Counts the number of bars since the session began.
//  3. Calculates:
//        • Highest High since session start
//        • Lowest Low since session start
//  4. Compares the current session extreme to the previous bar.
//  5. When a new extreme is formed:
//        → A label is plotted (if enabled)
//        → An alert is triggered
//
//  The logic is non-repainting and updates in real time.
//
//──────────────────────────────────────────────────────────────────────────────
//  INPUTS
//──────────────────────────────────────────────────────────────────────────────

indicator('[TL5 Alerts] Day High Low Tracker', overlay = true)

// ── User Inputs
Show_Labels = input.bool(true, 'Show Labels?', group = 'Display Settings')

//──────────────────────────────────────────────────────────────────────────────
//  SESSION DETECTION
//──────────────────────────────────────────────────────────────────────────────

// Detect start of new regular trading session
_day = time('1440', session.regular)
is_first = na(_day[1]) and not na(_day) or _day[1] < _day

// Count bars since session start
bar_count = ta.barssince(is_first) + 1

//──────────────────────────────────────────────────────────────────────────────
//  SESSION HIGH / LOW CALCULATION
//──────────────────────────────────────────────────────────────────────────────

new_high = bar_count > 0 ? ta.highest(high, bar_count) : na
new_low  = bar_count > 0 ? ta.lowest(low, bar_count) : na


//──────────────────────────────────────────────────────────────────────────────
//  LABELS WHEN NEW EXTREMES FORM
//──────────────────────────────────────────────────────────────────────────────

newHighCondition = not barstate.isfirst and new_high > new_high[1]
newLowCondition  = not barstate.isfirst and new_low < new_low[1]

if newHighCondition and Show_Labels
    label.new(bar_index, new_high,
         text = 'Hi',
         textcolor = color.white,
         color = color.new(color.green, 10),
         style = label.style_label_down,
         size = size.small)

if newLowCondition and Show_Labels
    label.new(bar_index, new_low,
         text = 'Lo',
         textcolor = color.white,
         color = color.new(color.red, 30),
         style = label.style_label_up,
         size = size.small)

//──────────────────────────────────────────────────────────────────────────────
//  ALERT GENERATION
//──────────────────────────────────────────────────────────────────────────────

tf_label = timeframe.period == 'D' ? ' Daily TF' :
           timeframe.period == 'S' ? ' Seconds'  :
           timeframe.period == 'W' ? ' Week'     :
           ' Minutes'

// JSON alert for new High (webhook ready)
if newHighCondition
    alert(
         '{"type": "New High!", "signal": "Bullish", "price": ' +
         str.tostring(close < 10 ? math.round(close, 4) : math.round(close, 2)) +
         ', "symbol": "' + syminfo.ticker + '"}',
         alert.freq_once_per_bar)

// Text alert for new Low
if newLowCondition
    alert(
         '{"type": "New Low!", "signal": "Bearish", "price": ' +
         str.tostring(close < 10 ? math.round(close, 4) : math.round(close, 2)) +
         ', "symbol": "' + syminfo.ticker + '"}',
         alert.freq_once_per_bar)

//──────────────────────────────────────────────────────────────────────────────
//  END OF SCRIPT
//──────────────────────────────────────────────────────────────────────────────
