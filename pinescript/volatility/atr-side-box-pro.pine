//@version=6
indicator("ATR Side Box PRO", overlay=true)

// ───── INPUT ─────
len = input.int(14, "ATR Length")

positionInput = input.string("Bottom Right", "Box Position",
     options=["Bottom Right", "Bottom Left", "Top Right", "Top Left"])

bgColorInput   = input.color(color.black, "Background Color")
textColorInput = input.color(color.white, "Text Color")

textSizeInput = input.string("Large", "Text Size",
     options=["Tiny", "Small", "Normal", "Large", "Huge"])

decimalsInput = input.int(2, "Decimals", minval=0, maxval=6)

// ───── ATR CALCOLO ─────
atrValue = ta.atr(len)
atrFormatted = str.tostring(atrValue, format.mintick)

// personalizza decimali
atrRounded = str.tostring(math.round(atrValue * math.pow(10, decimalsInput)) / math.pow(10, decimalsInput))

// ───── POSIZIONE ─────
pos =
     positionInput == "Bottom Right" ? position.bottom_right :
     positionInput == "Bottom Left"  ? position.bottom_left  :
     positionInput == "Top Right"    ? position.top_right    :
                                       position.top_left

// ───── TEXT SIZE ─────
sizeOption =
     textSizeInput == "Tiny"   ? size.tiny   :
     textSizeInput == "Small"  ? size.small  :
     textSizeInput == "Normal" ? size.normal :
     textSizeInput == "Large"  ? size.large  :
                                 size.huge

// ───── TABELLA ─────
var table atrTable = table.new(pos, 1, 1)

if barstate.islast
    table.cell(
        atrTable,
        0,
        0,
        "ATR: " + atrRounded,
        bgcolor=bgColorInput,
        text_color=textColorInput,
        text_size=sizeOption
    )
