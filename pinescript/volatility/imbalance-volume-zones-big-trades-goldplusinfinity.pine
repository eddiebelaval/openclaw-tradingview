//@version=5
indicator("GoldPlusInfinity - Imbalance + Volume + Zones + Big trades", overlay=true, max_boxes_count=500)

// --- Moyenne mobile ---
group_ma = "MOYENNE MOBILE"
show_ma20 = input.bool(true, " Activer MA 20 ", group = group_ma)
maLen20 = 20
ma20 = ta.sma(close, maLen20)
plot(show_ma20 ? ma20 : na, color=color.new(#3b82f6, 60), title="MA20 Trend", linewidth=2)

show_ma50 = input.bool(true, " Activer MA 50 ", group = group_ma)
maLen50 = 50
ma50 = ta.sma(close, maLen50)
plot(show_ma50 ? ma50 : na, color=color.new(#f6643b, 60), title="MA50 Trend", linewidth=2)

// --- Paramètres ---
group_imb = "TRAÇAGE DES IMBALANCES"
afficher_imb = input.bool(true, "Traçage des imbalances (Rectangles)", group=group_imb)
afficher_vol = input.bool(true, "Afficher le volume dans la zone", group=group_imb)
afficher_pre_imb = input.bool(true, "Tracer bougie avant l'imbalance", group=group_imb)
couleur_imb_h = input.color(color.new(#98fb98, 75), "Couleur Imbalance Hausse", group=group_imb)
couleur_imb_b = input.color(color.new(#ff8a8a, 75), "Couleur Imbalance Baisse", group=group_imb)
couleur_pre_imb = input.color(color.new(#b2b5be, 85), "Couleur Bougie Pré-Imbalance", group=group_imb)

show_bt        = input.bool(true, "Afficher Big Trades (Whales)", group="Big Trades")
asset_type     = input.string("Automatique", "Type d'actif", options=["Automatique", "Manuel"], group="Big Trades")
custom_bt_mult = input.float(1.0, "Multiplicateur Big Trades (si Manuel)", group="Big Trades")
custom_lookback = input.int(300, "Lookback Big Trades (si Manuel)", group="Big Trades")
trend_filter   = input.bool(false, "Filtrer par tendance (MA)", group="Big Trades")
ma_length      = input.int(200, "Longueur MA Tendance", group="Big Trades")

couleur_bordure = input.color(color.new(#b2b5be, 80), "Couleur Bordure")
couleur_impulsion = input.color(color.yellow, "Couleur Bougies d'Impulsion")

// --- LOGIQUE BIG TRADES ---
var float final_bt_mult = 3.0
var int final_lookback = 500
ma_trend = ta.sma(close, ma_length)

if asset_type == "Automatique"
    is_btc = str.contains(syminfo.ticker, "BTC")
    is_gold = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")
    is_index = str.contains(syminfo.ticker, "US30") or str.contains(syminfo.ticker, "NAS100")
    if is_index
        final_bt_mult := 3.5
        final_lookback := 100
    else if is_btc
        final_bt_mult := 3.2
        final_lookback := 80
    else if is_gold
        final_bt_mult := 2.0
        final_lookback := 250
else
    final_bt_mult := custom_bt_mult
    final_lookback := custom_lookback

range_size = high - low
raw_buy_vol = range_size == 0 ? 0 : (close - low) / range_size * volume
raw_sell_vol = range_size == 0 ? 0 : (high - close) / range_size * volume
avg_buy_vol = ta.sma(raw_buy_vol, final_lookback)[1]
std_buy_vol = ta.stdev(raw_buy_vol, final_lookback)[1]
avg_sell_vol = ta.sma(raw_sell_vol, final_lookback)[1]
std_sell_vol = ta.stdev(raw_sell_vol, final_lookback)[1]

thresh_buy = avg_buy_vol + std_buy_vol * final_bt_mult
thresh_sell = avg_sell_vol + std_sell_vol * final_bt_mult
is_bt_buy = raw_buy_vol > thresh_buy and (not trend_filter or close > ma_trend)
is_bt_sell = raw_sell_vol > thresh_sell and (not trend_filter or close < ma_trend)

plotshape(show_bt and is_bt_buy ? math.avg(close, low) : na, "Whale Buy", shape.circle, location.absolute, color.new(color.lime, 20), size=size.small)
plotshape(show_bt and is_bt_sell ? math.avg(close, high) : na, "Whale Sell", shape.circle, location.absolute, color.new(color.red, 20), size=size.small)

// --- Gestion des Zones (Persistance) ---
var box[] zones_actives = array.new_box()

// --- Détection des Imbalances (Fair Value Gaps) ---
est_imb_h = low > high[2]
est_imb_b = high < low[2]

// Vérification si la bougie à bar_index-2 était elle-même une imbalance
pre_est_imb = (low[2] > high[4]) or (high[2] < low[4])

// --- Création des Rectangles ---
if afficher_imb
    string vol_str = afficher_vol ? "Vol: " + str.tostring(volume[1], format.volume) : ""
    
    if est_imb_h
        // 1. Trace la bougie AVANT l'imbalance (Bar index - 2)
        if afficher_pre_imb and not pre_est_imb
            box b_pre = box.new(bar_index - 2, high[2], bar_index, low[2], 
                 bgcolor=couleur_pre_imb, 
                 border_color=couleur_bordure, 
                 extend=extend.right)
            array.push(zones_actives, b_pre)

        // 2. Trace l'Imbalance elle-même
        box b = box.new(bar_index - 2, low, bar_index, high[2], 
             bgcolor=couleur_imb_h, 
             border_color=couleur_bordure, 
             border_width=1,
             text=vol_str,
             text_size=size.tiny,
             text_color=color.new(color.white, 20),
             text_halign=text.align_right,
             text_valign=text.align_center,
             extend=extend.right)
        array.push(zones_actives, b)
        
    if est_imb_b
        // 1. Trace la bougie AVANT l'imbalance (Bar index - 2)
        if afficher_pre_imb and not pre_est_imb
            box b_pre = box.new(bar_index - 2, high[2], bar_index, low[2], 
                 bgcolor=couleur_pre_imb, 
                 border_color=couleur_bordure, 
                 extend=extend.right)
            array.push(zones_actives, b_pre)

        // 2. Trace l'Imbalance elle-même
        box b = box.new(bar_index - 2, low[2], bar_index, high, 
             bgcolor=couleur_imb_b, 
             border_color=couleur_bordure, 
             border_width=1,
             text=vol_str,
             text_size=size.tiny,
             text_color=color.new(color.white, 20),
             text_halign=text.align_right,
             text_valign=text.align_center,
             extend=extend.right)
        array.push(zones_actives, b)

// --- Logique d'atténuation ---
if array.size(zones_actives) > 0
    for i = array.size(zones_actives) - 1 to 0
        box b = array.get(zones_actives, i)
        float b_top = box.get_top(b)
        float b_bottom = box.get_bottom(b)
        int b_start = box.get_left(b)
        
        if bar_index > b_start + 2
            if high > math.min(b_top, b_bottom) and low < math.max(b_top, b_bottom)
                box.set_extend(b, extend.none)
                box.set_right(b, bar_index)
                array.remove(zones_actives, i)

// Coloration des bougies centrales d'imbalance
barcolor(est_imb_h or est_imb_b ? couleur_impulsion : na, offset=-1)
