//@version=5
indicator("ATR Ratio Z-Score", overlay=false)

// ===== INPUTS =====
shortLen  = input.int(5,  title="Short ATR Length")
longLen   = input.int(20, title="Long ATR Length")
zLen      = input.int(50, title="Z-Score Lookback")
smoothLen = input.int(1,  title="Smoothing Length (1 = off)")

// ===== ATR CALC =====
atrShort = ta.atr(shortLen)
atrLong  = ta.atr(longLen)

// Avoid divide-by-zero
atrRatioRaw = atrLong != 0 ? atrShort / atrLong : na

// Optional smoothing
atrRatio = smoothLen > 1 ? ta.sma(atrRatioRaw, smoothLen) : atrRatioRaw

// ===== Z-SCORE =====
mean = ta.sma(atrRatio, zLen)
std  = ta.stdev(atrRatio, zLen)
zScore = std != 0 ? (atrRatio - mean) / std : na

// ===== PLOTTING =====
plot(zScore, title="ATR Ratio Z-Score", linewidth=2)

// Regime Levels
hline(0,  "Mean", color=color.gray)
hline(1,  "+1 Expansion", color=color.green)
hline(2,  "+2 Strong Expansion", color=color.lime)
hline(-1, "-1 Compression", color=color.red)
hline(-2, "-2 Deep Compression", color=color.maroon)

// ===== Dynamic Coloring =====
color regimeColor =
     zScore > 1  ? color.lime :
     zScore > 0  ? color.green :
     zScore < -1 ? color.red :
     color.orange

plot(zScore, title="Colored Z-Score", color=regimeColor, linewidth=2)
