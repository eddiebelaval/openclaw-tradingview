//@version=6
indicator("Volatility Regime Engine [JOAT]", shorttitle="VRE [JOAT]", overlay=false, max_bars_back=500)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VOLATILITY REGIME ENGINE
// Quantitative Trading Systems - Volatility Cycle & Regime Detection
// Purpose: Identify expansion/contraction cycles and adaptive volatility states
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

//───────────────────────────────────────────────────────────────────────────────
// CONFIGURATION
//───────────────────────────────────────────────────────────────────────────────

g_atr = "═══════════ ATR Settings ═══════════"
int     i_atr_fast      = input.int(7, "Fast ATR Period", minval=3, maxval=20, group=g_atr)
int     i_atr_slow      = input.int(21, "Slow ATR Period", minval=10, maxval=50, group=g_atr)
int     i_atr_baseline  = input.int(50, "Baseline Period", minval=20, maxval=100, group=g_atr)

g_regime = "═══════════ Regime Thresholds ═══════════"
float   i_exp_thresh    = input.float(1.4, "Expansion Threshold", minval=1.1, maxval=2.0, step=0.1, group=g_regime)
float   i_con_thresh    = input.float(0.6, "Contraction Threshold", minval=0.3, maxval=0.9, step=0.1, group=g_regime)
int     i_regime_confirm = input.int(3, "Regime Confirmation Bars", minval=1, maxval=10, group=g_regime)

g_squeeze = "═══════════ Squeeze Detection ═══════════"
int     i_bb_len        = input.int(20, "Bollinger Period", minval=10, maxval=50, group=g_squeeze)
float   i_bb_mult       = input.float(2.0, "Bollinger Multiplier", minval=1.0, maxval=3.0, step=0.1, group=g_squeeze)
int     i_kc_len        = input.int(20, "Keltner Period", minval=10, maxval=50, group=g_squeeze)
float   i_kc_mult       = input.float(1.5, "Keltner Multiplier", minval=1.0, maxval=3.0, step=0.1, group=g_squeeze)

g_hv = "═══════════ Historical Volatility ═══════════"
bool    i_use_hv        = input.bool(true, "Enable HV Analysis", group=g_hv)
int     i_hv_len        = input.int(20, "HV Period", minval=5, maxval=50, group=g_hv)
int     i_hv_annual     = input.int(252, "Annual Trading Days", minval=200, maxval=365, group=g_hv)

g_visual = "═══════════ Visual Settings ═══════════"
color   i_exp_col       = input.color(color.new(#ff0040, 0), "Expansion Color", group=g_visual)
color   i_exp_glow      = input.color(color.new(#ff3366, 0), "Expansion Glow", group=g_visual)
color   i_con_col       = input.color(color.new(#0080ff, 0), "Contraction Color", group=g_visual)
color   i_con_glow      = input.color(color.new(#3399ff, 0), "Contraction Glow", group=g_visual)
color   i_normal_col    = input.color(color.new(#8000ff, 0), "Normal Color", group=g_visual)
color   i_squeeze_col   = input.color(color.new(#ffaa00, 0), "Squeeze Color", group=g_visual)
color   i_squeeze_glow  = input.color(color.new(#ffcc33, 0), "Squeeze Glow", group=g_visual)
color   i_premium_col   = input.color(color.new(#00ff00, 0), "Premium Signal Color", group=g_visual)
bool    i_show_bands    = input.bool(true, "Show Volatility Bands", group=g_visual)
bool    i_show_hv       = input.bool(true, "Show HV Overlay", group=g_visual)
bool    i_show_glow     = input.bool(true, "Enable Glow Effects", group=g_visual)
bool    i_show_dash     = input.bool(true, "Show Dashboard", group=g_visual)
bool    i_show_signals  = input.bool(true, "Show Volatility Signals", group=g_visual)
bool    i_show_zones    = input.bool(true, "Show Volatility Zones", group=g_visual)
bool    i_show_labels   = input.bool(true, "Show Signal Labels", group=g_visual)

//───────────────────────────────────────────────────────────────────────────────
// ATR CALCULATIONS
//───────────────────────────────────────────────────────────────────────────────

// Multiple ATR timeframes
float atr_fast = ta.atr(i_atr_fast)
float atr_slow = ta.atr(i_atr_slow)
float atr_baseline = ta.sma(ta.atr(i_atr_slow), i_atr_baseline)

// ATR ratios
float atr_ratio = atr_baseline > 0 ? atr_slow / atr_baseline : 1.0
float atr_momentum = atr_fast / atr_slow

// Normalized ATR (percentage of price)
float atr_pct = atr_slow / close * 100

// ATR percentile ranking
var array<float> atr_history = array.new_float(0)
if barstate.isconfirmed
    array.push(atr_history, atr_slow)
    if array.size(atr_history) > i_atr_baseline
        array.shift(atr_history)

float atr_percentile = 50.0
if array.size(atr_history) > 10
    int below_count = 0
    for i = 0 to array.size(atr_history) - 1
        if array.get(atr_history, i) < atr_slow
            below_count += 1
    atr_percentile := float(below_count) / float(array.size(atr_history)) * 100

//───────────────────────────────────────────────────────────────────────────────
// SQUEEZE DETECTION (Bollinger inside Keltner)
//───────────────────────────────────────────────────────────────────────────────

// Bollinger Bands
float bb_basis = ta.sma(close, i_bb_len)
float bb_dev = ta.stdev(close, i_bb_len) * i_bb_mult
float bb_upper = bb_basis + bb_dev
float bb_lower = bb_basis - bb_dev

// Keltner Channels
float kc_basis = ta.ema(close, i_kc_len)
float kc_range = ta.atr(i_kc_len) * i_kc_mult
float kc_upper = kc_basis + kc_range
float kc_lower = kc_basis - kc_range

// Squeeze state
bool squeeze_on = bb_lower > kc_lower and bb_upper < kc_upper
bool squeeze_off = bb_lower < kc_lower and bb_upper > kc_upper

// Squeeze momentum (using linear regression)
float squeeze_val = ta.linreg(close - math.avg(math.avg(ta.highest(high, i_kc_len), ta.lowest(low, i_kc_len)), kc_basis), i_kc_len, 0)

// Squeeze duration tracking
var int squeeze_duration = 0
if squeeze_on
    squeeze_duration := squeeze_duration + 1
else
    squeeze_duration := 0

// Squeeze intensity (longer squeeze = more explosive release)
float squeeze_intensity = math.min(float(squeeze_duration) / 20.0 * 100, 100)

//───────────────────────────────────────────────────────────────────────────────
// HISTORICAL VOLATILITY
//───────────────────────────────────────────────────────────────────────────────

f_historical_vol(int period, int annual_days) =>
    float log_return = math.log(close / close[1])
    float hv = ta.stdev(log_return, period) * math.sqrt(annual_days) * 100
    hv

float hv_current = i_use_hv ? f_historical_vol(i_hv_len, i_hv_annual) : 0
float hv_avg = i_use_hv ? ta.sma(hv_current, i_hv_len * 2) : 0
float hv_ratio = hv_avg > 0 ? hv_current / hv_avg : 1.0

// HV regime
int hv_regime = 0
if hv_ratio > 1.3
    hv_regime := 1  // High HV
else if hv_ratio < 0.7
    hv_regime := -1  // Low HV

//───────────────────────────────────────────────────────────────────────────────
// VOLATILITY REGIME CLASSIFICATION
//───────────────────────────────────────────────────────────────────────────────

// Raw regime based on ATR ratio
int raw_vol_regime = 0
if atr_ratio >= i_exp_thresh
    raw_vol_regime := 1    // Expansion
else if atr_ratio <= i_con_thresh
    raw_vol_regime := -1   // Contraction

// Confirmed regime with bar count filter
var int regime_counter = 0
var int confirmed_vol_regime = 0

if raw_vol_regime == raw_vol_regime[1] and raw_vol_regime != 0
    regime_counter := math.min(regime_counter + 1, i_regime_confirm + 1)
else if raw_vol_regime != raw_vol_regime[1]
    regime_counter := 1

if regime_counter >= i_regime_confirm
    confirmed_vol_regime := raw_vol_regime
else if raw_vol_regime == 0
    confirmed_vol_regime := 0

// Regime transitions
bool entering_expansion = confirmed_vol_regime == 1 and confirmed_vol_regime[1] != 1
bool entering_contraction = confirmed_vol_regime == -1 and confirmed_vol_regime[1] != -1
bool exiting_expansion = confirmed_vol_regime != 1 and confirmed_vol_regime[1] == 1
bool exiting_contraction = confirmed_vol_regime != -1 and confirmed_vol_regime[1] == -1

//───────────────────────────────────────────────────────────────────────────────
// VOLATILITY CYCLE PHASE
//───────────────────────────────────────────────────────────────────────────────

// Cycle phases: 0=neutral, 1=building, 2=peak, 3=declining, 4=trough
var int vol_cycle_phase = 0

float atr_slope = atr_slow - atr_slow[5]
float atr_accel = atr_slope - nz(atr_slope[5])

if confirmed_vol_regime == 1
    if atr_accel > 0
        vol_cycle_phase := 1  // Building expansion
    else
        vol_cycle_phase := 2  // Peak expansion
else if confirmed_vol_regime == -1
    if atr_accel < 0
        vol_cycle_phase := 3  // Declining to contraction
    else
        vol_cycle_phase := 4  // Trough contraction
else
    vol_cycle_phase := 0  // Neutral

// Cycle momentum (are we accelerating into or out of a phase?)
float cycle_momentum = atr_slope / atr_baseline * 100

// Volatility regime quality score
float vol_regime_quality = 0.0
if confirmed_vol_regime == 1
    vol_regime_quality := math.min(atr_ratio / i_exp_thresh * 50 + (atr_accel > 0 ? 25 : 0) + (hv_regime == 1 ? 25 : 0), 100)
else if confirmed_vol_regime == -1
    vol_regime_quality := math.min((1 - atr_ratio) / (1 - i_con_thresh) * 50 + (atr_accel < 0 ? 25 : 0) + (hv_regime == -1 ? 25 : 0), 100)
else if squeeze_on
    vol_regime_quality := squeeze_intensity

//───────────────────────────────────────────────────────────────────────────────
// ADAPTIVE MULTIPLIERS
//───────────────────────────────────────────────────────────────────────────────

// Dynamic stop multiplier based on regime
float adaptive_stop_mult = switch confirmed_vol_regime
    1 => 1.5   // Wider stops in expansion
    -1 => 0.8  // Tighter stops in contraction
    => 1.0     // Normal

// Dynamic target multiplier
float adaptive_target_mult = switch confirmed_vol_regime
    1 => 2.0   // Larger targets in expansion
    -1 => 1.2  // Smaller targets in contraction
    => 1.5     // Normal

// Volatility-adjusted ATR
float adaptive_atr = atr_slow * adaptive_stop_mult

//───────────────────────────────────────────────────────────────────────────────
// COMPOSITE VOLATILITY SCORE
//───────────────────────────────────────────────────────────────────────────────

// Normalized score (-100 to +100)
// Positive = high volatility, Negative = low volatility
float vol_score = (atr_ratio - 1.0) * 100
vol_score := math.max(math.min(vol_score, 100), -100)

// Squeeze adjustment
if squeeze_on
    vol_score := vol_score - 20  // Penalize score when in squeeze

// Volatility forecast (simple mean reversion expectation)
float vol_forecast = 0.0
if atr_percentile > 80
    vol_forecast := -1  // Expect contraction
else if atr_percentile < 20
    vol_forecast := 1   // Expect expansion
else if squeeze_on and squeeze_duration > 10
    vol_forecast := 1   // Squeeze release expected

//───────────────────────────────────────────────────────────────────────────────
// VOLATILITY SIGNALS
//───────────────────────────────────────────────────────────────────────────────

// Expansion breakout signal
bool expansion_breakout = entering_expansion and atr_momentum > 1.2 and vol_regime_quality > 60
bool premium_expansion = expansion_breakout and squeeze_duration > 10 and hv_regime == 1

// Contraction entry signal
bool contraction_entry = entering_contraction and atr_momentum < 0.8 and vol_regime_quality > 60
bool premium_contraction = contraction_entry and squeeze_duration < 5 and hv_regime == -1

// Squeeze momentum signal
bool squeeze_release = not squeeze_on and squeeze_on[1]
bool squeeze_momentum_signal = squeeze_release and squeeze_intensity > 70
bool squeeze_ignition = squeeze_on and squeeze_duration > 15 and atr_percentile < 20

// Volatility regime shift
bool regime_shift = confirmed_vol_regime != confirmed_vol_regime[1] and confirmed_vol_regime != 0
bool extreme_volatility = atr_percentile > 90 or atr_percentile < 10

// Cycle turning points
bool cycle_top = vol_cycle_phase == 2 and vol_cycle_phase[1] != 2
bool cycle_bottom = vol_cycle_phase == 4 and vol_cycle_phase[1] != 4

//───────────────────────────────────────────────────────────────────────────────
// SIGNAL LABELS
//───────────────────────────────────────────────────────────────────────────────

var label expansion_label = na
var label contraction_label = na
var label squeeze_label = na
var label premium_label = na

// Create and manage signal labels
if barstate.isconfirmed
    // Clean up old labels
    if not na(expansion_label)
        label.delete(expansion_label)
    if not na(contraction_label)
        label.delete(contraction_label)
    if not na(squeeze_label)
        label.delete(squeeze_label)
    if not na(premium_label)
        label.delete(premium_label)
    
    // Expansion breakout label
    if expansion_breakout and i_show_labels
        expansion_label := label.new(bar_index, high * 1.02, "\nVOLATILITY BREAKOUT\nATR: " + str.tostring(atr_ratio, "#.##") + "\n", 
                                    style=label.style_label_up, color=color.new(i_exp_col, 20), 
                                    textcolor=color.white, size=size.small, yloc=yloc.price)
    
    // Contraction entry label
    if contraction_entry and i_show_labels
        contraction_label := label.new(bar_index, low * 0.98, "\nCONTRACTION ENTRY\nATR: " + str.tostring(atr_ratio, "#.##") + "\n", 
                                      style=label.style_label_down, color=color.new(i_con_col, 20), 
                                      textcolor=color.white, size=size.small, yloc=yloc.price)
    
    // Squeeze release label
    if squeeze_momentum_signal and i_show_labels
        squeeze_label := label.new(bar_index, high, "\nSQUEEZE RELEASE\nDuration: " + str.tostring(squeeze_duration) + " bars\n", 
                                 style=label.style_label_left, color=color.new(i_squeeze_col, 20), 
                                 textcolor=color.black, size=size.small, yloc=yloc.price)
    
    // Premium signal label
    if (premium_expansion or premium_contraction) and i_show_labels
        string premium_text = premium_expansion ? "\nPREMIUM EXPANSION\n" : "\nPREMIUM CONTRACTION\n"
        premium_label := label.new(bar_index, premium_expansion ? low * 0.98 : high * 1.02, 
                                   premium_text + "Quality: " + str.tostring(vol_regime_quality, "#") + "%\n", 
                                   style=label.style_label_right, color=color.new(i_premium_col, 0), 
                                   textcolor=color.black, size=size.normal, yloc=yloc.price)

//───────────────────────────────────────────────────────────────────────────────
// VISUALIZATION
//───────────────────────────────────────────────────────────────────────────────

// Dynamic color with intensity
f_vol_color(int regime, float quality, color exp, color exp_glow, color con, color con_glow, color normal) =>
    if regime == 1
        int transp = math.round(math.max(20, 60 - quality * 0.4))
        color.new(exp, transp)
    else if regime == -1
        int transp = math.round(math.max(20, 60 - quality * 0.4))
        color.new(con, transp)
    else
        normal

// Regime color with intensity
color regime_col = f_vol_color(confirmed_vol_regime, vol_regime_quality, i_exp_col, i_exp_glow, i_con_col, i_con_glow, i_normal_col)

// Squeeze color with intensity based on duration
color squeeze_color = squeeze_on ? color.new(i_squeeze_col, math.round(math.max(20, 70 - squeeze_intensity * 0.5))) : na

// Final bar color
color bar_col = squeeze_on ? squeeze_color : regime_col

// Glow effect
color glow_col = na
if i_show_glow
    if confirmed_vol_regime == 1 and vol_regime_quality > 50
        glow_col := color.new(i_exp_glow, math.round(80 - vol_regime_quality * 0.3))
    else if confirmed_vol_regime == -1 and vol_regime_quality > 50
        glow_col := color.new(i_con_glow, math.round(80 - vol_regime_quality * 0.3))
    else if squeeze_on and squeeze_intensity > 50
        glow_col := color.new(i_squeeze_glow, math.round(80 - squeeze_intensity * 0.3))

// Multi-layer gradient glow effect
plot(atr_ratio * 50 + 5, "Outer Glow", color=color.new(glow_col, 50), style=plot.style_columns, linewidth=7)
plot(atr_ratio * 50 + 3, "Inner Glow", color=color.new(glow_col, 30), style=plot.style_columns, linewidth=5)

// Main volatility ratio with enhanced gradient
plot(atr_ratio * 50, "Volatility Ratio", color=bar_col, style=plot.style_columns, linewidth=5)
plot(atr_ratio * 50, "Volatility Core", color=color.new(bar_col, 0), style=plot.style_line, linewidth=3)

// Enhanced HV overlay with gradient
plot((i_show_hv and i_use_hv) ? hv_ratio * 50 : na, "HV Base", color=(i_show_hv and i_use_hv) ? (hv_ratio > 1 ? color.new(i_exp_col, 60) : color.new(i_con_col, 60)) : na, style=plot.style_area, linewidth=1)
plot((i_show_hv and i_use_hv) ? hv_ratio * 50 : na, "HV Line", color=(i_show_hv and i_use_hv) ? (hv_ratio > 1 ? color.new(i_exp_col, 30) : color.new(i_con_col, 30)) : na, style=plot.style_line, linewidth=2)

// Enhanced reference lines with gradient zones
hline(50, "Normal (1.0)", color=color.new(#8000ff, 60), linestyle=hline.style_solid, linewidth=3)
hline(i_exp_thresh * 50, "Expansion Threshold", color=color.new(i_exp_col, 50), linestyle=hline.style_dashed, linewidth=3)
hline(i_con_thresh * 50, "Contraction Threshold", color=color.new(i_con_col, 50), linestyle=hline.style_dashed, linewidth=3)

// Multi-layer volatility zones
bgcolor(i_show_zones ? (atr_ratio > i_exp_thresh ? color.new(i_exp_col, 97) : atr_ratio < i_con_thresh ? color.new(i_con_col, 97) : na) : na)
bgcolor(i_show_zones ? (atr_ratio > i_exp_thresh * 1.2 ? color.new(i_exp_glow, 98) : atr_ratio < i_con_thresh * 0.8 ? color.new(i_con_glow, 98) : na) : na)

// Enhanced ATR momentum with gradient
plot(atr_momentum * 50, "ATR Momentum Base", color=atr_momentum > 1 ? color.new(i_exp_col, 80) : atr_momentum < 1 ? color.new(i_con_col, 80) : color.new(#8000ff, 80), style=plot.style_area, linewidth=1)
plot(atr_momentum * 50, "ATR Momentum Line", color=atr_momentum > 1 ? color.new(i_exp_col, 0) : atr_momentum < 1 ? color.new(i_con_col, 0) : color.new(#8000ff, 0), style=plot.style_line, linewidth=3)

// Squeeze momentum with enhanced pulsing
plot(squeeze_val * 10 + 50, "Squeeze Momentum", color=squeeze_on ? color.new(i_squeeze_col, math.round(40 - squeeze_intensity * 0.4)) : color.new(#8000ff, 70), style=plot.style_columns, linewidth=3)

// Cycle momentum with ribbon effect
plot(cycle_momentum + 50, "Cycle Momentum", color=color.new(#ff0080, 70), style=plot.style_area, linewidth=1)
plot(cycle_momentum + 50, "Cycle Line", color=color.new(#ff0080, 0), style=plot.style_line, linewidth=3)

// Enhanced background gradient based on regime and quality
color bg_col = na
color bg_col2 = na
if confirmed_vol_regime == 1
    bg_col := color.new(i_exp_col, math.round(97 - vol_regime_quality * 0.05))
    bg_col2 := color.new(i_exp_glow, math.round(98 - vol_regime_quality * 0.03))
else if confirmed_vol_regime == -1
    bg_col := color.new(i_con_col, math.round(97 - vol_regime_quality * 0.05))
    bg_col2 := color.new(i_con_glow, math.round(98 - vol_regime_quality * 0.03))
else if squeeze_on
    bg_col := color.new(i_squeeze_col, math.round(97 - squeeze_intensity * 0.04))
    bg_col2 := color.new(i_squeeze_glow, math.round(98 - squeeze_intensity * 0.02))
bgcolor(bg_col)
bgcolor(bg_col2)

// Enhanced volatility signals
plotshape(expansion_breakout and i_show_signals, "Expansion Breakout", shape.triangleup, location.bottom, 
          color=color.new(i_exp_col, 0), size=size.small)
plotshape(premium_expansion and i_show_signals, "Premium Expansion", shape.diamond, location.bottom, 
          color=color.new(i_premium_col, 0), size=size.normal)

// Contraction entry signals
plotshape(contraction_entry and i_show_signals, "Contraction Entry", shape.triangledown, location.top, 
          color=color.new(i_con_col, 0), size=size.small)
plotshape(premium_contraction and i_show_signals, "Premium Contraction", shape.diamond, location.top, 
          color=color.new(i_premium_col, 0), size=size.normal)

// Squeeze signals
plotshape(squeeze_momentum_signal and i_show_signals, "Squeeze Release", shape.circle, location.absolute, 
          color=color.new(i_squeeze_col, 0), size=size.normal)
plotshape(squeeze_ignition and i_show_signals, "Squeeze Ignition", shape.xcross, location.absolute, 
          color=color.new(#ff3366, 0), size=size.small)

// Cycle turning points
plotshape(cycle_top and i_show_signals, "Cycle Top", shape.flag, location.top, 
          color=color.new(#ff3366, 0), size=size.tiny)
plotshape(cycle_bottom and i_show_signals, "Cycle Bottom", shape.flag, location.bottom, 
          color=color.new(#00ffcc, 0), size=size.tiny)

// Extreme volatility alerts
plotshape(extreme_volatility and i_show_signals, "Extreme Volatility", shape.square, location.absolute, 
          color=color.new(#ffcc00, 0), size=size.tiny)

//───────────────────────────────────────────────────────────────────────────────
// DASHBOARD
//───────────────────────────────────────────────────────────────────────────────

if i_show_dash and barstate.islast
    var table dash = table.new(position.top_right, 3, 11, bgcolor=color.new(#000000, 95),
                               border_width=2, border_color=color.new(#00ffcc, 50), frame_width=2, frame_color=color.new(#00ffcc, 30))
    
    string regime_text = switch confirmed_vol_regime
        1 => "EXPANSION"
        -1 => "CONTRACTION"
        => "NORMAL"
    
    string phase_text = switch vol_cycle_phase
        1 => "BUILDING"
        2 => "PEAK"
        3 => "DECLINING"
        4 => "TROUGH"
        => "NEUTRAL"
    
    string squeeze_text = squeeze_on ? "ACTIVE" : "INACTIVE"
    
    // Enhanced header with red gradient
    table.merge_cells(dash, 0, 0, 2, 0)
    table.cell(dash, 0, 0, "VOLATILITY ENGINE", text_color=color.new(#ffffff, 0), 
               text_size=size.normal, bgcolor=color.new(#ff0040, 20))
    
    // Column headers
    table.cell(dash, 0, 1, "METRIC", text_color=color.new(#ffffff, 0), text_size=size.tiny, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 1, 1, "VALUE", text_color=color.new(#ffffff, 0), text_size=size.tiny, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 2, 1, "SIGNAL", text_color=color.new(#00ffcc, 0), text_size=size.tiny, bgcolor=color.new(#1a1f2e, 80))
    
    table.cell(dash, 0, 2, "VOL REGIME", text_color=color.new(#ffffff, 0), text_size=size.small, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 1, 2, regime_text, text_color=color.new(#000000, 0), text_size=size.small, bgcolor=color.new(regime_col, 30))
    table.cell(dash, 2, 2, expansion_breakout ? "BREAKOUT" : contraction_entry ? "ENTRY" : "---", 
               text_color=expansion_breakout ? color.new(#ff3366, 0) : contraction_entry ? color.new(#00ffcc, 0) : color.new(#78909c, 0), 
               text_size=size.tiny, bgcolor=color.new(#1a1f2e, 80))
    
    table.cell(dash, 0, 3, "CYCLE PHASE", text_color=color.new(#ffffff, 0), text_size=size.small, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 1, 3, phase_text, text_color=color.new(#000000, 0), text_size=size.small, bgcolor=color.new(#ff66cc, 30))
    table.cell(dash, 2, 3, cycle_top ? "TOP" : cycle_bottom ? "BOTTOM" : "---", 
               text_color=cycle_top or cycle_bottom ? color.new(#ff66cc, 0) : color.new(#78909c, 0), 
               text_size=size.tiny, bgcolor=color.new(#1a1f2e, 80))
    
    table.cell(dash, 0, 4, "ATR RATIO", text_color=color.new(#ffffff, 0), text_size=size.small, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 1, 4, str.tostring(atr_ratio, "#.##"), text_color=color.new(#000000, 0), text_size=size.small, bgcolor=color.new(regime_col, 30))
    table.cell(dash, 2, 4, "MOM: " + str.tostring(atr_momentum, "#.##"), text_color=color.new(#00ffcc, 0), text_size=size.tiny, bgcolor=color.new(#1a1f2e, 80))
    
    table.cell(dash, 0, 5, "ATR %", text_color=color.new(#ffffff, 0), text_size=size.small, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 1, 5, str.tostring(atr_pct, "#.##") + "%", text_color=color.new(#000000, 0), text_size=size.small, bgcolor=color.new(#ffcc00, 30))
    table.cell(dash, 2, 5, extreme_volatility ? "EXTREME" : "NORMAL", 
               text_color=extreme_volatility ? color.new(#ffcc00, 0) : color.new(#78909c, 0), 
               text_size=size.tiny, bgcolor=color.new(#1a1f2e, 80))
    
    table.cell(dash, 0, 6, "PERCENTILE", text_color=color.new(#ffffff, 0), text_size=size.small, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 1, 6, str.tostring(atr_percentile, "#") + "%", text_color=color.new(#000000, 0), text_size=size.small, bgcolor=color.new(#9966ff, 30))
    table.cell(dash, 2, 6, hv_regime == 1 ? "HIGH HV" : hv_regime == -1 ? "LOW HV" : "NORMAL", 
               text_color=hv_regime == 1 ? color.new(#ff3366, 0) : hv_regime == -1 ? color.new(#00ffcc, 0) : color.new(#78909c, 0), 
               text_size=size.tiny, bgcolor=color.new(#1a1f2e, 80))
    
    table.cell(dash, 0, 7, "SQUEEZE", text_color=color.new(#ffffff, 0), text_size=size.small, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 1, 7, squeeze_text, text_color=color.new(#000000, 0), text_size=size.small, bgcolor=color.new(squeeze_on ? i_squeeze_col : i_normal_col, 30))
    table.cell(dash, 2, 7, squeeze_ignition ? "IGNITION" : squeeze_momentum_signal ? "RELEASE" : "---", 
               text_color=squeeze_ignition or squeeze_momentum_signal ? color.new(#ffcc00, 0) : color.new(#78909c, 0), 
               text_size=size.tiny, bgcolor=color.new(#1a1f2e, 80))
    
    table.cell(dash, 0, 8, "SQ DURATION", text_color=color.new(#ffffff, 0), text_size=size.small, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 1, 8, squeeze_on ? str.tostring(squeeze_duration) + " bars" : "---", text_color=color.new(#000000, 0), text_size=size.small, bgcolor=color.new(squeeze_on ? i_squeeze_col : i_normal_col, 30))
    table.cell(dash, 2, 8, squeeze_intensity > 70 ? "HIGH" : squeeze_intensity > 40 ? "MED" : "LOW", 
               text_color=color.new(#ffcc00, 0), text_size=size.tiny, bgcolor=color.new(#1a1f2e, 80))
    
    table.cell(dash, 0, 9, "QUALITY", text_color=color.new(#ffffff, 0), text_size=size.small, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 1, 9, str.tostring(vol_regime_quality, "#") + "%", text_color=color.new(#000000, 0), text_size=size.small, bgcolor=color.new(vol_regime_quality > 70 ? i_premium_col : #9966ff, 30))
    table.cell(dash, 2, 9, premium_expansion or premium_contraction ? "PREMIUM" : "STANDARD", 
               text_color=premium_expansion or premium_contraction ? color.new(i_premium_col, 0) : color.new(#78909c, 0), 
               text_size=size.tiny, bgcolor=color.new(#1a1f2e, 80))
    
    string forecast_text = vol_forecast > 0 ? "EXPANSION" : vol_forecast < 0 ? "CONTRACTION" : "NEUTRAL"
    color forecast_col = vol_forecast > 0 ? i_exp_col : vol_forecast < 0 ? i_con_col : i_normal_col
    table.cell(dash, 0, 10, "FORECAST", text_color=color.new(#ffffff, 0), text_size=size.small, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 1, 10, forecast_text, text_color=color.new(#000000, 0), text_size=size.small, bgcolor=color.new(forecast_col, 30))
    table.cell(dash, 2, 10, "R:R " + str.tostring(adaptive_target_mult, "#.#"), text_color=color.new(#ffcc00, 0), text_size=size.tiny, bgcolor=color.new(#1a1f2e, 80))

//───────────────────────────────────────────────────────────────────────────────
// EXPORT PLOTS (for strategy integration)
//───────────────────────────────────────────────────────────────────────────────

plot(atr_ratio, "ATR Ratio Export", display=display.none)
plot(float(confirmed_vol_regime), "Vol Regime Export", display=display.none)
plot(atr_percentile, "ATR Percentile Export", display=display.none)
plot(adaptive_atr, "Adaptive ATR Export", display=display.none)
plot(adaptive_stop_mult, "Stop Multiplier Export", display=display.none)
plot(adaptive_target_mult, "Target Multiplier Export", display=display.none)
plot(squeeze_on ? 1 : 0, "Squeeze State Export", display=display.none)
plot(squeeze_val, "Squeeze Momentum Export", display=display.none)
plot(vol_score, "Vol Score Export", display=display.none)

//───────────────────────────────────────────────────────────────────────────────
// ALERTS
//───────────────────────────────────────────────────────────────────────────────

alertcondition(entering_expansion, "Entering Expansion", "Volatility entering expansion regime")
alertcondition(entering_contraction, "Entering Contraction", "Volatility entering contraction regime")
alertcondition(squeeze_on and not squeeze_on[1], "Squeeze Started", "Volatility squeeze started")
alertcondition(not squeeze_on and squeeze_on[1], "Squeeze Released", "Volatility squeeze released")
alertcondition(atr_percentile > 90, "Extreme High Volatility", "ATR in 90th percentile")
alertcondition(atr_percentile < 10, "Extreme Low Volatility", "ATR in 10th percentile")
