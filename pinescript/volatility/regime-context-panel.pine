// • No trade signals, entries, exits, or automated execution.
// • Context / observation tool only. Always confirm with your own process.
// • Past performance is not indicative of future results.
// ============================================================================

indicator("Regime Context Panel", shorttitle="RCP", overlay=true)

// ============================================================================
// INPUTS
// ============================================================================
groupCore = "Regime Engine"

emaLen   = input.int(200, "Trend EMA Length", minval=50, group=groupCore)
slopeLen = input.int(20,  "EMA Slope Lookback", minval=5, group=groupCore)

adxLen    = input.int(14, "ADX Length", group=groupCore)
adxSmooth = input.int(14, "ADX Smoothing", group=groupCore)
adxTrend  = input.float(20.0, "ADX Trend Threshold", step=0.5, group=groupCore)

atrLen     = input.int(14,  "ATR Length", group=groupCore)
atrAvgLen  = input.int(100, "ATR% Avg Length", group=groupCore)
atrExpMult = input.float(1.25, "Vol Expansion Mult", group=groupCore)

rangeLen     = input.int(50, "Range Window", group=groupCore)
rangeAtrMult = input.float(6.0, "Range ATR Mult", group=groupCore)

groupUI = "UI"
showHUD   = input.bool(true, "Show HUD", group=groupUI)

posOpt = input.string("Top Right", "Location",
     options=["Top Left","Top Center","Top Right","Bottom Left","Bottom Center","Bottom Right"],
     group=groupUI)

sizeOpt = input.string("Normal", "Text Size",
     options=["Tiny","Small","Normal"],
     group=groupUI)

compactHUD = input.bool(false, "Compact Mode (1 line)", group=groupUI)

// ============================================================================
// ALERT INPUTS
// ============================================================================
groupAlerts = "Alerts"
alertsOnConfirmedOnly = input.bool(true,  "Only on confirmed bar close", group=groupAlerts)
alertOnRegimeChange   = input.bool(true,  "Alert: Regime changed", group=groupAlerts)

// Optional: per-regime alerts (fires only on transition INTO that regime)
alertOnTrendUp   = input.bool(false, "Alert: TREND UP", group=groupAlerts)
alertOnTrendDown = input.bool(false, "Alert: TREND DOWN", group=groupAlerts)
alertOnBalanced  = input.bool(false, "Alert: BALANCED (Range/Flag)", group=groupAlerts)
alertOnVolExp    = input.bool(false, "Alert: VOL EXP", group=groupAlerts)
alertOnChop      = input.bool(false, "Alert: CHOP", group=groupAlerts)
alertOnTrans     = input.bool(false, "Alert: TRANSITION", group=groupAlerts)

// Optional: dynamic alert() (rich message). Requires creating alert with:
// “Any alert() function call”
useDynamicAlertCall = input.bool(false, "Also fire dynamic alert() message", group=groupAlerts)

// ============================================================================
// ENGINE (environment classification only)
// ============================================================================
ema = ta.ema(close, emaLen)
emaSlope = (ema - ema[slopeLen]) / slopeLen

aboveEma = close >= ema
slopeUp  = emaSlope > 0
slopeDn  = emaSlope < 0

[_, _, adx] = ta.dmi(adxLen, adxSmooth)
trendStrong = adx >= adxTrend

atr = ta.atr(atrLen)
atrPct    = close != 0 ? (atr / close) * 100.0 : na
atrPctAvg = ta.sma(atrPct, atrAvgLen)
atrPctSt  = ta.stdev(atrPct, atrAvgLen)
atrPctZ   = (not na(atrPctAvg) and not na(atrPctSt) and atrPctSt > 0) ? ((atrPct - atrPctAvg) / atrPctSt) : na

volExp = not na(atrPctAvg) and atrPct > atrPctAvg * atrExpMult

hi = ta.highest(high, rangeLen)
lo = ta.lowest(low, rangeLen)
rangeWidth = hi - lo

// Normalized compression ratio (dimensionless)
rangeRatio = (atr > 0) ? (rangeWidth / (atr * rangeAtrMult)) : na
rangeBound = not na(rangeRatio) and rangeRatio < 1.0

chop = not trendStrong and not rangeBound

string regime =
     volExp ? "VOLATILITY EXPANSION" :
     (trendStrong and aboveEma and slopeUp) ? "TREND UP (STRONG)" :
     (trendStrong and not aboveEma and slopeDn) ? "TREND DOWN (STRONG)" :
     rangeBound ? "RANGE-BOUND / FLAG" :
     chop ? "CHOP / TWO-WAY" :
     "TRANSITION"

// ============================================================================
// BEHAVIORAL TRANSLATION (context language only)
// ============================================================================
string regimeLabel =
     regime == "TREND UP (STRONG)"    ? "TREND UP" :
     regime == "TREND DOWN (STRONG)"  ? "TREND DOWN" :
     regime == "RANGE-BOUND / FLAG"   ? "BALANCED" :
     regime == "VOLATILITY EXPANSION" ? "VOL EXP" :
     regime == "CHOP / TWO-WAY"       ? "CHOP" :
     "TRANSITION"

string behavior =
     regime == "TREND UP (STRONG)"        ? "Dips bought" :
     regime == "TREND DOWN (STRONG)"      ? "Rips sold" :
     regime == "RANGE-BOUND / FLAG"       ? "Two-way rotation" :
     regime == "VOLATILITY EXPANSION"     ? "Wide swings" :
     regime == "CHOP / TWO-WAY"           ? "Whipsaw risk" :
     "Await resolution"

string posture =
     regime == "TREND UP (STRONG)"        ? "Long-friendly" :
     regime == "TREND DOWN (STRONG)"      ? "Defensive posture" :
     regime == "RANGE-BOUND / FLAG"       ? "Edges only or wait" :
     regime == "VOLATILITY EXPANSION"     ? "Reduce size" :
     regime == "CHOP / TWO-WAY"           ? "Reduce trades" :
     "Wait break + hold"

// Posture color
color postureCol =
     regime == "TREND UP (STRONG)"    ? color.lime :
     regime == "TREND DOWN (STRONG)"  ? color.red :
     regime == "RANGE-BOUND / FLAG"   ? color.yellow :
     regime == "VOLATILITY EXPANSION" ? color.orange :
     regime == "CHOP / TWO-WAY"       ? color.orange :
     color.yellow

// Regime highlight color
color regCol =
     regime == "TREND UP (STRONG)"    ? color.lime :
     regime == "TREND DOWN (STRONG)"  ? color.red :
     regime == "RANGE-BOUND / FLAG"   ? color.aqua :
     regime == "VOLATILITY EXPANSION" ? color.orange :
     regime == "CHOP / TWO-WAY"       ? color.gray :
     color.yellow

// ============================================================================
// VOLATILITY REGIME (ATR% Z-score)
// ============================================================================
string volReg =
     na(atrPctZ) ? "N/A" :
     (atrPctZ > 0.75) ? "HIGH" :
     (atrPctZ < -0.75) ? "LOW" :
     "NORMAL"

color volCol =
     volReg == "HIGH"   ? color.new(color.orange, 0) :
     volReg == "LOW"    ? color.new(color.aqua, 0) :
     volReg == "NORMAL" ? color.new(color.lime, 0) :
     color.new(color.gray, 0)

// ============================================================================
// CONFIDENCE (agreement score for CURRENT regime) - math unchanged
// ============================================================================
f_confidence(_regime) =>
    int hit = 0
    int max = 3

    if _regime == "TREND UP (STRONG)"
        hit := (trendStrong ? 1 : 0) + (aboveEma ? 1 : 0) + (slopeUp ? 1 : 0)
        max := 3
    else if _regime == "TREND DOWN (STRONG)"
        hit := (trendStrong ? 1 : 0) + ((not aboveEma) ? 1 : 0) + (slopeDn ? 1 : 0)
        max := 3
    else if _regime == "RANGE-BOUND / FLAG"
        hit := (rangeBound ? 1 : 0) + ((not trendStrong) ? 1 : 0) + ((not volExp) ? 1 : 0)
        max := 3
    else if _regime == "VOLATILITY EXPANSION"
        hit := (volExp ? 1 : 0) + ((not rangeBound) ? 1 : 0) + ((not na(atrPctZ) and atrPctZ > 0) ? 1 : 0)
        max := 3
    else if _regime == "CHOP / TWO-WAY"
        hit := ((not trendStrong) ? 1 : 0) + ((not rangeBound) ? 1 : 0) + ((not volExp) ? 1 : 0)
        max := 3
    else
        hit := ((trendStrong ? 1 : 0) + (rangeBound ? 1 : 0) + (volExp ? 1 : 0))
        max := 3

    float pct = max > 0 ? (float(hit) / float(max)) * 100.0 : na
    pct

confPct = f_confidence(regime)

string confLabel =
     na(confPct) ? "N/A" :
     (confPct >= 85) ? "STRONG" :
     (confPct >= 50) ? "MODERATE" :
     "WEAK"

color confCol =
     confLabel == "STRONG"   ? color.new(color.lime, 0) :
     confLabel == "MODERATE" ? color.new(color.orange, 0) :
     confLabel == "WEAK"     ? color.new(color.red, 0) :
     color.new(color.gray, 0)

// ============================================================================
// ALERT ENGINE (clean + safe)
// ============================================================================
series bool alertBarOk = alertsOnConfirmedOnly ? barstate.isconfirmed : true
string prevRegime = na(regime[1]) ? regime : regime[1]
series bool regimeChanged = alertBarOk and (regime != prevRegime)

series bool intoTrendUp   = regimeChanged and regime == "TREND UP (STRONG)"
series bool intoTrendDown = regimeChanged and regime == "TREND DOWN (STRONG)"
series bool intoBalanced  = regimeChanged and regime == "RANGE-BOUND / FLAG"
series bool intoVolExp    = regimeChanged and regime == "VOLATILITY EXPANSION"
series bool intoChop      = regimeChanged and regime == "CHOP / TWO-WAY"
series bool intoTrans     = regimeChanged and regime == "TRANSITION"

// alertcondition() requires CONST strings for title/message -> use literals.
alertcondition(alertOnRegimeChange and regimeChanged,
     "RCP: Regime Changed",
     "RCP: Regime changed {{ticker}} {{interval}}")

alertcondition(alertOnTrendUp and intoTrendUp,
     "RCP: Trend Up (Strong)",
     "RCP: TREND UP (Strong) {{ticker}} {{interval}}")

alertcondition(alertOnTrendDown and intoTrendDown,
     "RCP: Trend Down (Strong)",
     "RCP: TREND DOWN (Strong) {{ticker}} {{interval}}")

alertcondition(alertOnBalanced and intoBalanced,
     "RCP: Range-Bound / Flag (Balanced)",
     "RCP: RANGE-BOUND / FLAG {{ticker}} {{interval}}")

alertcondition(alertOnVolExp and intoVolExp,
     "RCP: Volatility Expansion",
     "RCP: VOLATILITY EXPANSION {{ticker}} {{interval}}")

alertcondition(alertOnChop and intoChop,
     "RCP: Chop / Two-Way",
     "RCP: CHOP / TWO-WAY {{ticker}} {{interval}}")

alertcondition(alertOnTrans and intoTrans,
     "RCP: Transition",
     "RCP: TRANSITION {{ticker}} {{interval}}")

// Optional dynamic alert() (rich message). Create alert: “Any alert() function call”
if useDynamicAlertCall and regimeChanged
    string dynMsg = "RCP " + syminfo.ticker + " " + timeframe.period +
         " | Regime: " + prevRegime + " -> " + regime +
         " | Vol: " + volReg +
         " | Conf: " + (na(confPct) ? "N/A" : str.tostring(confPct, "0") + "%")
    alert(dynMsg, alert.freq_once_per_bar_close)

// ============================================================================
// HELPERS
// ============================================================================
f_pos(_p) =>
    _pos = position.top_right
    if _p == "Top Left"
        _pos := position.top_left
    else if _p == "Top Center"
        _pos := position.top_center
    else if _p == "Top Right"
        _pos := position.top_right
    else if _p == "Bottom Left"
        _pos := position.bottom_left
    else if _p == "Bottom Center"
        _pos := position.bottom_center
    else
        _pos := position.bottom_right
    _pos

f_size(_s) =>
    _sz = size.normal
    if _s == "Tiny"
        _sz := size.tiny
    else if _s == "Small"
        _sz := size.small
    else
        _sz := size.normal
    _sz

SZ = f_size(sizeOpt)

// ============================================================================
// TABLE HUD
// ============================================================================
var table  hud     = na
var string lastKey = ""

// Rebuild key (position + compact mode)
string keyNow = posOpt + "|" + (compactHUD ? "C" : "F")

if barstate.isfirst
    lastKey := keyNow

// Create/rebuild on first run or key change
if showHUD and (barstate.isfirst or keyNow != lastKey)
    if not na(hud)
        table.delete(hud)
    hud := table.new(f_pos(posOpt), 2, compactHUD ? 2 : 6, border_width=1)
    lastKey := keyNow

if not showHUD and not na(hud)
    table.delete(hud)
    hud := na

if showHUD and barstate.islast and not na(hud)

    if compactHUD
        table.clear(hud, 0, 0, 1, 1)

        string summary = regimeLabel + " • " + posture + " • Vol " + volReg + " • Conf " + (na(confPct) ? "N/A" : str.tostring(confPct, "0") + "%")

        table.cell(hud, 0, 0, "REGIME", text_color=color.white, bgcolor=color.black, text_size=SZ)
        table.cell(hud, 1, 0, syminfo.ticker, text_color=color.white, bgcolor=color.black, text_size=SZ)

        table.cell(hud, 0, 1, "STATE", text_color=color.white, bgcolor=color.black, text_size=SZ)
        table.cell(hud, 1, 1, summary, text_color=color.black, bgcolor=postureCol, text_size=SZ)

    else
        table.clear(hud, 0, 0, 1, 5)

        table.cell(hud, 0, 0, "REGIME CONTEXT", text_color=color.white, bgcolor=color.black, text_size=SZ)
        table.cell(hud, 1, 0, syminfo.ticker, text_color=color.white, bgcolor=color.black, text_size=SZ)

        table.cell(hud, 0, 1, "REGIME", text_color=color.white, bgcolor=color.black, text_size=SZ)
        table.cell(hud, 1, 1, regimeLabel, text_color=color.black, bgcolor=regCol, text_size=SZ)

        table.cell(hud, 0, 2, "FLOW", text_color=color.white, bgcolor=color.black, text_size=SZ)
        table.cell(hud, 1, 2, behavior, text_color=color.white, bgcolor=color.new(color.black, 80), text_size=SZ)

        table.cell(hud, 0, 3, "POSTURE", text_color=color.white, bgcolor=color.black, text_size=SZ)
        table.cell(hud, 1, 3, posture, text_color=color.black, bgcolor=postureCol, text_size=SZ)

        table.cell(hud, 0, 4, "VOL REGIME", text_color=color.white, bgcolor=color.black, text_size=SZ,
             tooltip="ATR% Z-score vs its own history. Context only.")
        table.cell(hud, 1, 4, volReg, text_color=color.black, bgcolor=volCol, text_size=SZ,
             tooltip="HIGH = elevated volatility vs history. LOW = muted volatility. NORMAL = typical range.")

        string confText = na(confPct) ? "N/A" : (confLabel + " • " + str.tostring(confPct, "0") + "%")
        string rrText   = na(rangeRatio) ? "N/A" : str.tostring(rangeRatio, "0.00")

        table.cell(hud, 0, 5, "CONFIDENCE", text_color=color.white, bgcolor=color.black, text_size=SZ,
             tooltip="Agreement score for the current regime classification. Higher = more inputs aligned.\n\nRangeRatio = rangeWidth / (ATR * RangeATRMult). < 1.0 suggests compression.")
        table.cell(hud, 1, 5, confText, text_color=color.black, bgcolor=confCol, text_size=SZ,
             tooltip="Confidence summarizes alignment across structure/strength/volatility inputs.\n\nRangeRatio: " + rrText)
