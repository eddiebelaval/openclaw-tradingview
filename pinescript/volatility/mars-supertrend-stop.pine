//@version=6
indicator("M.A.R.S. - Supertrend Stop + 200 SMA", overlay=true)

// =====================
// Parameters
// =====================
atrPeriod = input.int(14, "ST: ATR Length", minval = 1)
factor = input.float(2.0, "ST: Factor", minval = 0.01, step = 0.01)
smaLength = input.int(200, "SMA Length", minval = 1)

// =====================
// Supertrend
// =====================
[supertrend, direction] = ta.supertrend(factor, atrPeriod)

upTrend = plot(direction < 0 ? supertrend : na,
     "Up Trend",
     color = color.green,
     style = plot.style_linebr,
     linewidth = 2)

downTrend = plot(direction < 0 ? na : supertrend,
     "Down Trend",
     color = color.red,
     style = plot.style_linebr,
     linewidth = 2)

// =====================
// ATR
// =====================
atrValue = ta.atr(atrPeriod)

// =====================
// 200-Day SMA
// =====================
sma200 = ta.sma(close, smaLength)
plot(sma200,
     title = "SMA 200",
     color = color.blue,
     linewidth = 2)

// =====================
// Info Table
// =====================
var table infoTable = table.new(position.top_right, 1, 4, border_width = 2)

bgColor = direction < 0 ? color.new(color.green, 0) : color.new(color.red, 0)
txtColor = color.white

if barstate.islast
    table.cell(infoTable, 0, 0,
         "Price: " + str.tostring(close, format.mintick),
         bgcolor = bgColor, text_color = txtColor)

    table.cell(infoTable, 0, 1,
         "ATR (14): " + str.tostring(atrValue, format.mintick),
         bgcolor = bgColor, text_color = txtColor)

    table.cell(infoTable, 0, 2,
         "Supertrend: " + str.tostring(supertrend, format.mintick),
         bgcolor = bgColor, text_color = txtColor)

    table.cell(infoTable, 0, 3,
         "SMA 200: " + str.tostring(sma200, format.mintick),
         bgcolor = color.new(color.blue, 0), text_color = txtColor)

// =====================
// Alerts
// =====================
alertcondition(close < supertrend,
     title = "Close Below Supertrend",
     message = "Close below Supertrend - Potential stop signal")

alertcondition(close > supertrend,
     title = "Close Above Supertrend",
     message = "Close above Supertrend - Bullish trend")
