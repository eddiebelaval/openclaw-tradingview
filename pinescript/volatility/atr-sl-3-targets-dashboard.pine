//@version=5
indicator("ATR Risk Manager PRO – %, SL, Targets, Risk", shorttitle="ATR RM PRO", overlay=true, precision=2)

//──────────────── INPUTS ────────────────
groupTrade = "Trade Settings"
priceSrc = input.source(close, "Entry Price", group=groupTrade)
accountSize = input.float(10000, "Account Size ($)", group=groupTrade)
riskPercent = input.float(1, "Risk % Per Trade", group=groupTrade)

groupATR = "ATR Settings"
lenATR = input.int(14, "ATR Period", group=groupATR)

groupMult = "ATR Multipliers"
multSL = input.float(1.5, "Stop Loss ATR", group=groupMult)
multT1 = input.float(2.0, "Target 1 ATR", group=groupMult)
multT2 = input.float(3.0, "Target 2 ATR", group=groupMult)
multT3 = input.float(4.5, "Target 3 ATR", group=groupMult)

groupVis = "Display Settings"
showLines = input.bool(true, "Show SL/TP Lines", group=groupVis)
showLabels = input.bool(true, "Show Price Labels", group=groupVis)
showTable = input.bool(true, "Show Dashboard", group=groupVis)
extendBars = input.int(40, "Line Length", group=groupVis)

//──────────────── TABLE SETTINGS ────────────────
groupTable = "Dashboard Style"

tblPosInput = input.string(
     "Top Right",
     "Table Position",
     options=["Top Right","Top Left","Bottom Right","Bottom Left"],
     group=groupTable)

tblBg = input.color(color.new(color.black,80),"Table Background",group=groupTable)
tblHeader = input.color(color.rgb(35,90,160),"Header Color",group=groupTable)
tblRow1 = input.color(color.new(color.black,0),"Row Color 1",group=groupTable)
tblRow2 = input.color(color.new(color.gray,85),"Row Color 2",group=groupTable)
tblText = input.color(color.white,"Text Color",group=groupTable)

//──────────────── ROW TOGGLES ────────────────
groupRows = "Dashboard Rows"

showATR = input.bool(true,"ATR Row",group=groupRows)
showSL = input.bool(true,"Stop Loss Row",group=groupRows)
showTP1 = input.bool(true,"Target 1 Row",group=groupRows)
showTP2 = input.bool(true,"Target 2 Row",group=groupRows)
showTP3 = input.bool(true,"Target 3 Row",group=groupRows)
showAccount = input.bool(true,"Account / Position Rows",group=groupRows)

//──────────────── TABLE POSITION LOGIC ────────────────
tblPosition =
     tblPosInput == "Top Left" ? position.top_left :
     tblPosInput == "Bottom Left" ? position.bottom_left :
     tblPosInput == "Bottom Right" ? position.bottom_right :
     position.top_right

//──────────────── ATR ────────────────
atr = ta.atr(lenATR)
atrPct = atr / priceSrc * 100

//──────────────── PRICE LEVELS ────────────────
slPrice = priceSrc - atr * multSL
t1Price = priceSrc + atr * multT1
t2Price = priceSrc + atr * multT2
t3Price = priceSrc + atr * multT3

//──────────────── % CALCULATIONS ────────────────
riskPct = math.abs((priceSrc - slPrice) / priceSrc * 100)
reward1Pct = math.abs((t1Price - priceSrc) / priceSrc * 100)
reward2Pct = math.abs((t2Price - priceSrc) / priceSrc * 100)
reward3Pct = math.abs((t3Price - priceSrc) / priceSrc * 100)

//──────────────── RISK CALCULATIONS ────────────────
riskDistance = math.abs(priceSrc - slPrice)
riskAmount = accountSize * (riskPercent / 100)
positionSize = riskDistance > 0 ? riskAmount / riskDistance : na

//──────────────── PROFITS ────────────────
profit1 = positionSize * (t1Price - priceSrc)
profit2 = positionSize * (t2Price - priceSrc)
profit3 = positionSize * (t3Price - priceSrc)

rr1 = profit1 / riskAmount
rr2 = profit2 / riskAmount
rr3 = profit3 / riskAmount

//──────────────── LINES ────────────────
var line slLine = na
var line t1Line = na
var line t2Line = na
var line t3Line = na

if showLines and barstate.islast

    x1 = bar_index
    x2 = bar_index + extendBars

    if na(slLine)

        slLine := line.new(x1, slPrice, x2, slPrice, color=color.red, width=2)
        t1Line := line.new(x1, t1Price, x2, t1Price, color=color.green)
        t2Line := line.new(x1, t2Price, x2, t2Price, color=color.lime)
        t3Line := line.new(x1, t3Price, x2, t3Price, color=color.teal)

    else

        line.set_xy1(slLine, x1, slPrice)
        line.set_xy2(slLine, x2, slPrice)

        line.set_xy1(t1Line, x1, t1Price)
        line.set_xy2(t1Line, x2, t1Price)

        line.set_xy1(t2Line, x1, t2Price)
        line.set_xy2(t2Line, x2, t2Price)

        line.set_xy1(t3Line, x1, t3Price)
        line.set_xy2(t3Line, x2, t3Price)

//──────────────── LABELS ────────────────
var label lbSL = na
var label lbT1 = na
var label lbT2 = na
var label lbT3 = na

if showLabels and barstate.islast

    if na(lbSL)

        lbSL := label.new(bar_index+extendBars,slPrice,"",style=label.style_label_left,size=size.small,color=color.red)
        lbT1 := label.new(bar_index+extendBars,t1Price,"",style=label.style_label_left,size=size.small,color=color.green)
        lbT2 := label.new(bar_index+extendBars,t2Price,"",style=label.style_label_left,size=size.small,color=color.lime)
        lbT3 := label.new(bar_index+extendBars,t3Price,"",style=label.style_label_left,size=size.small,color=color.teal)

    label.set_xy(lbSL,bar_index+extendBars,slPrice)
    label.set_text(lbSL,"SL "+str.tostring(slPrice,"#.##"))

    label.set_xy(lbT1,bar_index+extendBars,t1Price)
    label.set_text(lbT1,"TP1 "+str.tostring(t1Price,"#.##"))

    label.set_xy(lbT2,bar_index+extendBars,t2Price)
    label.set_text(lbT2,"TP2 "+str.tostring(t2Price,"#.##"))

    label.set_xy(lbT3,bar_index+extendBars,t3Price)
    label.set_text(lbT3,"TP3 "+str.tostring(t3Price,"#.##"))

//──────────────── DASHBOARD ────────────────
var table dash = na

if showTable

    if na(dash)
        dash := table.new(tblPosition,3,12,bgcolor=tblBg)

    if barstate.islast

        table.cell(dash,0,0,"Metric",bgcolor=tblHeader,text_color=tblText,text_size=size.normal)
        table.cell(dash,1,0,"Value",bgcolor=tblHeader,text_color=tblText,text_size=size.normal)
        table.cell(dash,2,0,"%",bgcolor=tblHeader,text_color=tblText,text_size=size.normal)

        row = 1

        bg = row % 2 == 0 ? tblRow1 : tblRow2

        if showATR
            bg := row % 2 == 0 ? tblRow1 : tblRow2
            table.cell(dash,0,row,"ATR",bgcolor=bg,text_color=tblText)
            table.cell(dash,1,row,str.tostring(atr,"#.##"),bgcolor=bg,text_color=tblText)
            table.cell(dash,2,row,str.tostring(atrPct,"#.##")+"%",bgcolor=bg,text_color=tblText)
            row += 1

        if showSL
            bg := row % 2 == 0 ? tblRow1 : tblRow2
            table.cell(dash,0,row,"Stop Loss",bgcolor=bg,text_color=tblText)
            table.cell(dash,1,row,str.tostring(slPrice,"#.##"),bgcolor=bg,text_color=tblText)
            table.cell(dash,2,row,str.tostring(riskPct,"#.##")+"%",bgcolor=bg,text_color=tblText)
            row += 1

        if showTP1
            bg := row % 2 == 0 ? tblRow1 : tblRow2
            table.cell(dash,0,row,"Target 1",bgcolor=bg,text_color=tblText)
            table.cell(dash,1,row,str.tostring(t1Price,"#.##"),bgcolor=bg,text_color=tblText)
            table.cell(dash,2,row,str.tostring(reward1Pct,"#.##")+"%",bgcolor=bg,text_color=tblText)
            row += 1

        if showTP2
            bg := row % 2 == 0 ? tblRow1 : tblRow2
            table.cell(dash,0,row,"Target 2",bgcolor=bg,text_color=tblText)
            table.cell(dash,1,row,str.tostring(t2Price,"#.##"),bgcolor=bg,text_color=tblText)
            table.cell(dash,2,row,str.tostring(reward2Pct,"#.##")+"%",bgcolor=bg,text_color=tblText)
            row += 1

        if showTP3
            bg := row % 2 == 0 ? tblRow1 : tblRow2
            table.cell(dash,0,row,"Target 3",bgcolor=bg,text_color=tblText)
            table.cell(dash,1,row,str.tostring(t3Price,"#.##"),bgcolor=bg,text_color=tblText)
            table.cell(dash,2,row,str.tostring(reward3Pct,"#.##")+"%",bgcolor=bg,text_color=tblText)
            row += 1

        if showAccount
            bg := row % 2 == 0 ? tblRow1 : tblRow2
            table.cell(dash,0,row,"Account",bgcolor=bg,text_color=tblText)
            table.cell(dash,1,row,"$"+str.tostring(accountSize,"#.##"),bgcolor=bg,text_color=tblText)
            row += 1

            bg := row % 2 == 0 ? tblRow1 : tblRow2
            table.cell(dash,0,row,"Position Size",bgcolor=bg,text_color=tblText)
            table.cell(dash,1,row,str.tostring(positionSize,"#.##"),bgcolor=bg,text_color=tblText)
            row += 1

            bg := row % 2 == 0 ? tblRow1 : tblRow2
            table.cell(dash,0,row,"Loss @ SL",bgcolor=bg,text_color=tblText)
            table.cell(dash,1,row,"$"+str.tostring(riskAmount,"#.##"),bgcolor=bg,text_color=tblText)
            row += 1

// hidden plot
plot(close,color=color.new(color.white,100))
