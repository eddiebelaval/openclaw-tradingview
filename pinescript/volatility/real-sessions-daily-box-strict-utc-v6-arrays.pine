//@version=6
indicator("Real Sessions + Daily Box (Strict UTC + V6 Arrays)", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

//==================== Schedules (Strict UTC - 7 Days)
string S_ASIA    = input.session("0000-0900:1234567", "Tokyo (Asia) [UTC]")
string S_EUROPA  = input.session("0800-1700:1234567", "London (Europe) [UTC]")
string S_AMERICA = input.session("1300-2200:1234567", "New York (America) [UTC]") 

color ASIA_FILL_DEF = input.color(color.new(color.yellow, 85), "Asia: Background")
color ASIA_BORDER   = input.color(color.yellow,               "Asia: Border")
color EURO_FILL_DEF = input.color(color.new(color.blue, 85),  "Europe: Background")
color EURO_BORDER   = input.color(color.blue,                 "Europe: Border")
color USA_FILL_DEF  = input.color(color.new(color.red, 85),   "America: Background")
color USA_BORDER    = input.color(color.red,                  "America: Border")
color DAY_FILL_DEF  = input.color(color.new(color.lime, 90),  "Daily: Background")
color DAY_BORDER    = input.color(color.new(color.lime, 25),  "Daily: Border")

//==================== Toggles & Limits
groupD = "Daily Box (00:00→24:00)"
bool showDayHist    = input.bool(true , "Show Daily Historical", inline="d1", group=groupD)
bool showDayLive    = input.bool(true , "Show Current Daily" , inline="d1", group=groupD)
int  keepDays       = input.int (120  , "Max Daily Boxes", minval=1, maxval=500, group=groupD)
int  maxDaysBackDay = input.int (0    , "Purge Daily > N days (0=no limit)", minval=0, maxval=2000, group=groupD)
bool dayOutlineOnly = input.bool(false, "Outline Only", group=groupD)

groupL = "Daily Labels (Min/Max)"
bool showDayLblHist = input.bool(true , "Historical Labels", inline="l1", group=groupL)
bool showDayLblLive = input.bool(true , "Current Day Labels", inline="l1", group=groupL)
// NOU: Control dimensiune text
string lblSizeOpt   = input.string("Normal", "Label Text Size", options=["Tiny", "Small", "Normal", "Large"], group=groupL)
int  keepDayLbl     = input.int (120  , "Max Days with Labels", minval=1, maxval=500, group=groupL)
int  maxDaysBackLbl = input.int (0    , "Purge Labels > N days (0=no limit)", minval=0, maxval=2000, group=groupL)
int  decPx          = input.int (2    , "Label Decimals", minval=0, maxval=8, group=groupL)
int  offYTicksHi    = input.int (2    , "Y Offset Max (ticks)", minval=0, maxval=200, group=groupL)
int  offYTicksLo    = input.int (2    , "Y Offset Min (ticks)",  minval=0, maxval=200, group=groupL)
color colLblHiTxt   = input.color(color.white, "Max Text Color", group=groupL)
color colLblLoTxt   = input.color(color.white, "Min Text Color", group=groupL)
color colLblHiBg    = input.color(color.new(color.green, 0), "Max Background", group=groupL)
color colLblLoBg    = input.color(color.new(color.red  , 0), "Min Background", group=groupL)

groupA = "Tokyo Session"
bool showAsiaHist    = input.bool(true , "Asia Historical", inline="a1", group=groupA)
bool showAsiaLive    = input.bool(true , "Asia Current",  inline="a1", group=groupA)
int  keepAsia        = input.int (200  , "Max Asia", minval=1, maxval=500, group=groupA)
bool asiaOutlineOnly = input.bool(false, "Outline Only", group=groupA)

groupE = "London Session"
bool showEuroHist    = input.bool(true , "Europe Historical", inline="e1", group=groupE)
bool showEuroLive    = input.bool(true , "Europe Current" , inline="e1", group=groupE)
int  keepEuro        = input.int (200  , "Max Europe", minval=1, maxval=500, group=groupE)
bool euroOutlineOnly = input.bool(false, "Outline Only", group=groupE)

groupU = "New York Session"
bool showUsaHist     = input.bool(true , "America Historical", inline="u1", group=groupU)
bool showUsaLive     = input.bool(true , "America Current" , inline="u1", group=groupU)
int  keepUsa         = input.int (200  , "Max America", minval=1, maxval=500, group=groupU)
bool usaOutlineOnly  = input.bool(false, "Outline Only", group=groupU)

groupG1 = "GLOBAL"
bool gShowAsia = input.bool(true , "Show Asia"  , group=groupG1)
bool gShowEuro = input.bool(true , "Show Europe", group=groupG1)
bool gShowUsa  = input.bool(true , "Show America", group=groupG1)
bool useGlobalLimits = input.bool(true , "Use GLOBAL LIMIT", group=groupG1)
int  gKeepAll        = input.int (100 , "GLOBAL Limit: Max items", minval=1, maxval=500, group=groupG1)

groupGuard = "GUARDS"
bool guardEnable       = input.bool(true , "Enable TF protections", group=groupGuard)
int  guardHeadroom     = input.int (490  , "Hard ceiling (≤500)", minval=100, maxval=500, group=groupGuard)
int  guardMax_S_1to15  = input.int(7  , "Max days 1s–15s", minval=1, maxval=500, group=groupGuard)
int  guardMax_S_30to45 = input.int(10 , "Max days 30s–45s", minval=1, maxval=500, group=groupGuard)
int  guardMax_M_1      = input.int(30 , "Max days 1m", minval=1, maxval=500, group=groupGuard)
int  guardMax_M_2to5   = input.int(60 , "Max days 2m–5m", minval=1, maxval=500, group=groupGuard)
int  guardMax_M_10to15 = input.int(120, "Max days 10m–15m", minval=1, maxval=500, group=groupGuard)
int  guardMax_M_30     = input.int(240, "Max days 30m", minval=1, maxval=500, group=groupGuard)
int  guardMax_H_1      = input.int(500, "Max days 1h", minval=1, maxval=500, group=groupGuard)
int  guardMax_H_2to3   = input.int(500, "Max days 2h–3h", minval=1, maxval=500, group=groupGuard)
int  guardMax_H_4to12  = input.int(500, "Max days 4h–12h", minval=1, maxval=500, group=groupGuard)
int  guardMax_D_1      = input.int(500, "Max days 1D", minval=1, maxval=500, group=groupGuard)

groupOC = "Daily Lines"
bool  showDayOpenClose  = input.bool(true , "Show Open/Close Lines", group=groupOC)
bool  showOCLblHist     = input.bool(true , "Open/Close Labels HIST", inline="oc1", group=groupOC)
bool  showOCLblLive     = input.bool(true , "Open/Close Labels LIVE", inline="oc1", group=groupOC)
color colOpenLine       = input.color(color.new(color.purple, 0), "Open Line", group=groupOC)
color colCloseLineBase  = input.color(color.new(color.gray  , 0), "Close Line", group=groupOC)
bool  closeLblCondColor = input.bool(true , "Conditional Close Color", group=groupOC)
int   wOpen             = input.int(2, "Open Width", minval=1, maxval=4, group=groupOC)
int   wClose            = input.int(2, "Close Width", minval=1, maxval=4, group=groupOC)
string ocOffsetMode     = input.string("Ticks", "Offset Mode", options=["Ticks","%Range"], group=groupOC)
int    offOpenLblTicks  = input.int(6, "Open Offset Ticks", minval=0, maxval=500, group=groupOC)
int    offCloseLblTicks = input.int(6, "Close Offset Ticks", minval=0, maxval=500, group=groupOC)
float  offOpenLblPct    = input.float(2.0, "Open Offset %", minval=0, maxval=50, step=0.1, group=groupOC)
float  offCloseLblPct   = input.float(2.0, "Close Offset %", minval=0, maxval=50, step=0.1, group=groupOC)

//==================== Utils & Helpers
getLblSize() => lblSizeOpt == "Tiny" ? size.tiny : lblSizeOpt == "Small" ? size.small : lblSizeOpt == "Large" ? size.large : size.normal
snap(float x) => math.round(x/syminfo.mintick) * syminfo.mintick
fillOrOutline(color c, bool out) => out ? color.new(c, 100) : c
fmtPx(float x) => str.tostring(x, "#."+str.repeat("#", decPx))
cap(int v, int lo, int hi) => math.max(lo, math.min(hi, v))
tf_minutes() => timeframe.isseconds ? timeframe.multiplier/60.0 : timeframe.isminutes ? timeframe.multiplier : timeframe.isdaily ? 1440.0 : timeframe.isweekly ? 10080.0 : 43200.0
ocOffAbove(float top, float rng) => ocOffsetMode == "Ticks" ? top + offOpenLblTicks*syminfo.mintick  : top + (rng * offOpenLblPct/100.0)
ocOffBelow(float bot, float rng) => ocOffsetMode == "Ticks" ? bot - offCloseLblTicks*syminfo.mintick : bot - (rng * offCloseLblPct/100.0)

clearB(array<box> a) =>
    while array.size(a) > 0
        box.delete(array.pop(a))
clearL(array<label> a) =>
    while array.size(a) > 0
        label.delete(array.pop(a))
clearLn(array<line> a) =>
    while array.size(a) > 0
        line.delete(array.pop(a))
purgeB(array<box> a, int cut) =>
    if cut > 0
        for i = array.size(a) - 1 to 0
            if box.get_left(array.get(a, i)) < cut
                box.delete(array.remove(a, i))
purgeL(array<label> a, int cut) =>
    if cut > 0
        for i = array.size(a) - 1 to 0
            if label.get_x(array.get(a, i)) < cut
                label.delete(array.remove(a, i))
purgeLn(array<line> a, int cut) =>
    if cut > 0
        for i = array.size(a) - 1 to 0
            if line.get_x1(array.get(a, i)) < cut
                line.delete(array.remove(a, i))

float tfm = tf_minutes()
int guardDays = guardEnable ? (timeframe.isseconds and timeframe.multiplier <= 15 ? guardMax_S_1to15 : timeframe.isseconds ? guardMax_S_30to45 : tfm <= 1 ? guardMax_M_1 : tfm <= 5 ? guardMax_M_2to5 : tfm <= 15 ? guardMax_M_10to15 : tfm <= 30 ? guardMax_M_30 : tfm <= 60 ? guardMax_H_1 : tfm <= 180 ? guardMax_H_2to3 : tfm <= 720 ? guardMax_H_4to12 : guardMax_D_1) : 500
int guardCap = cap(guardDays, 1, guardHeadroom)
getCap(int localMax) => useGlobalLimits ? cap(gKeepAll, 1, guardCap) : cap(localMax, 1, guardCap)

bool isIntraday = tfm < 1440.0

//==================== DAILY LOGIC
int   dayMs = 86400000
float mt    = syminfo.mintick

var float dHigh = na
var float dLow  = na
var int   tsHigh = na
var int   tsLow  = na
float dOpen = request.security(syminfo.tickerid, "D", open, lookahead=barmerge.lookahead_on)

if na(dHigh) or na(dLow)
    dHigh  := dOpen
    dLow   := dOpen
    tsHigh := time
    tsLow  := time

var array<box>   dayHist       = array.new<box>()
var box          dayLive       = na
var array<label> dayLblHistArr = array.new<label>()
var array<line>  dayOpenHist   = array.new<line>()
var array<line>  dayCloseHist  = array.new<line>()
var array<label> lblOpenHist   = array.new<label>()
var array<label> lblCloseHist  = array.new<label>()

var line   dayOpenLive    = na
var line   dayCloseLive   = na
var label  lblOpenLive    = na
var label  lblCloseLive   = na
var float  rngLive        = na
var label  dayLblLiveHi   = na
var label  dayLblLiveLo   = na

var bool prevShowDayLblLive = showDayLblLive
if prevShowDayLblLive and not showDayLblLive
    if not na(dayLblLiveHi)
        label.delete(dayLblLiveHi)
        dayLblLiveHi := na
    if not na(dayLblLiveLo)
        label.delete(dayLblLiveLo)
        dayLblLiveLo := na
prevShowDayLblLive := showDayLblLive

var bool prevShowDayHist = showDayHist
if prevShowDayHist and not showDayHist
    clearB(dayHist)
    if not na(dayLive)
        box.delete(dayLive)
        dayLive := na
prevShowDayHist := showDayHist

var bool prevShowDayOpenClose = showDayOpenClose
if prevShowDayOpenClose and not showDayOpenClose
    clearLn(dayOpenHist)
    clearLn(dayCloseHist)
    clearL(lblOpenHist)
    clearL(lblCloseHist)
    if not na(dayOpenLive)
        line.delete(dayOpenLive)
        dayOpenLive := na
    if not na(dayCloseLive)
        line.delete(dayCloseLive)
        dayCloseLive := na
    if not na(lblOpenLive)
        label.delete(lblOpenLive)
        lblOpenLive := na
    if not na(lblCloseLive)
        label.delete(lblCloseLive)
        lblCloseLive := na
prevShowDayOpenClose := showDayOpenClose

if ta.change(time("D")) != 0
    int   startPrev = timestamp(syminfo.timezone, year(time[1]), month(time[1]), dayofmonth(time[1]), 0, 0)
    int   endPrev   = startPrev + dayMs
    float topPrev   = snap(dHigh[1])
    float botPrev   = snap(dLow[1])
    float rngPrev   = math.max(topPrev - botPrev, mt)
    int   tsHighPrev = nz(tsHigh[1], endPrev)
    int   tsLowPrev  = nz(tsLow[1] , endPrev)

    if showDayHist
        color dayFill = fillOrOutline(DAY_FILL_DEF, dayOutlineOnly)
        array.push(dayHist, box.new(startPrev, topPrev, endPrev, botPrev, xloc=xloc.bar_time, bgcolor=dayFill, border_color=DAY_BORDER))
        purgeB(dayHist, maxDaysBackDay > 0 ? (timenow - maxDaysBackDay * dayMs) : 0)
        while array.size(dayHist) > getCap(keepDays)
            box.delete(array.shift(dayHist))

    if showDayLblHist
        array.push(dayLblHistArr, label.new(tsHighPrev, topPrev + offYTicksHi*mt, xloc=xloc.bar_time, style=label.style_label_down, text="D Hi\n"+fmtPx(topPrev), color=colLblHiBg, textcolor=colLblHiTxt, size=getLblSize()))
        array.push(dayLblHistArr, label.new(tsLowPrev , botPrev - offYTicksLo*mt, xloc=xloc.bar_time, style=label.style_label_up, text="D Lo\n"+fmtPx(botPrev), color=colLblLoBg, textcolor=colLblLoTxt, size=getLblSize()))
        purgeL(dayLblHistArr, maxDaysBackLbl > 0 ? (timenow - maxDaysBackLbl * dayMs) : 0)
        while array.size(dayLblHistArr) > (getCap(keepDayLbl) * 2)
            label.delete(array.shift(dayLblHistArr))

    if showDayOpenClose
        float oPrev = snap(dOpen[1])
        float cPrev = snap(close[1])
        array.push(dayOpenHist, line.new(startPrev, oPrev, endPrev, oPrev, xloc=xloc.bar_time, color=colOpenLine, width=wOpen))
        array.push(dayCloseHist, line.new(startPrev, cPrev, endPrev, cPrev, xloc=xloc.bar_time, color=colCloseLineBase, width=wClose))

        if showOCLblHist
            color clHist = closeLblCondColor ? (cPrev > oPrev ? color.new(color.green,0) : cPrev < oPrev ? color.new(color.red,0) : color.new(color.gray,0)) : color.new(color.gray,0)
            float yOpenHist  = (cPrev >= oPrev) ? ocOffBelow(botPrev, rngPrev) : ocOffAbove(topPrev, rngPrev)
            float yCloseHist = (cPrev >= oPrev) ? ocOffAbove(topPrev, rngPrev) : ocOffBelow(botPrev, rngPrev)
            array.push(lblOpenHist, label.new(startPrev, yOpenHist, xloc=xloc.bar_time, style=label.style_label_left, text="Open: "+fmtPx(oPrev), color=color.new(colOpenLine,0), textcolor=color.white, size=getLblSize()))
            array.push(lblCloseHist, label.new(endPrev, yCloseHist, xloc=xloc.bar_time, style=label.style_label_right, text="Close: "+fmtPx(cPrev), color=clHist, textcolor=color.white, size=getLblSize()))

        int cutoff = maxDaysBackDay > 0 ? (timenow - maxDaysBackDay * dayMs) : 0
        purgeLn(dayOpenHist, cutoff)
        purgeLn(dayCloseHist, cutoff)
        purgeL(lblOpenHist, cutoff)
        purgeL(lblCloseHist, cutoff)
        
        while array.size(dayOpenHist) > getCap(keepDays)
            line.delete(array.shift(dayOpenHist))
        while array.size(dayCloseHist) > getCap(keepDays)
            line.delete(array.shift(dayCloseHist))
        while array.size(lblOpenHist) > getCap(keepDayLbl)
            label.delete(array.shift(lblOpenHist))
        while array.size(lblCloseHist) > getCap(keepDayLbl)
            label.delete(array.shift(lblCloseHist))

    dHigh := dOpen
    dLow := dOpen
    tsHigh := time
    tsLow := time
    
    if not na(dayLblLiveHi)
        label.delete(dayLblLiveHi)
        dayLblLiveHi := na
    if not na(dayLblLiveLo)
        label.delete(dayLblLiveLo)
        dayLblLiveLo := na
    if not na(dayLive)
        box.delete(dayLive)
        dayLive := na
    if not na(dayOpenLive)
        line.delete(dayOpenLive)
        dayOpenLive := na
    if not na(dayCloseLive)
        line.delete(dayCloseLive)
        dayCloseLive := na
    if not na(lblOpenLive)
        label.delete(lblOpenLive)
        lblOpenLive := na
    if not na(lblCloseLive)
        label.delete(lblCloseLive)
        lblCloseLive := na

if high > dHigh
    dHigh := high
    tsHigh := time
if low < dLow
    dLow := low
    tsLow := time

int startCur = timestamp(syminfo.timezone, year(time), month(time), dayofmonth(time), 0, 0)
int endCur   = startCur + dayMs
rngLive := math.max(snap(dHigh) - snap(dLow), mt)

if showDayLive
    if na(dayLive)
        dayLive := box.new(startCur, snap(dHigh), endCur, snap(dLow), xloc=xloc.bar_time, bgcolor=fillOrOutline(DAY_FILL_DEF, dayOutlineOnly), border_color=DAY_BORDER)
    else
        box.set_lefttop(dayLive, startCur, snap(dHigh))
        box.set_rightbottom(dayLive, endCur, snap(dLow))

if showDayLblLive
    if na(dayLblLiveHi)
        dayLblLiveHi := label.new(tsHigh, snap(dHigh) + offYTicksHi*mt, xloc=xloc.bar_time, style=label.style_label_down, text="D Hi\n"+fmtPx(dHigh), color=colLblHiBg, textcolor=colLblHiTxt, size=getLblSize())
    else
        label.set_xy(dayLblLiveHi, tsHigh, snap(dHigh) + offYTicksHi*mt)
        label.set_text(dayLblLiveHi, "D Hi\n"+fmtPx(dHigh))
        label.set_size(dayLblLiveHi, getLblSize())
    if na(dayLblLiveLo)
        dayLblLiveLo := label.new(tsLow, snap(dLow) - offYTicksLo*mt, xloc=xloc.bar_time, style=label.style_label_up, text="D Lo\n"+fmtPx(dLow), color=colLblLoBg, textcolor=colLblLoTxt, size=getLblSize())
    else
        label.set_xy(dayLblLiveLo, tsLow, snap(dLow) - offYTicksLo*mt)
        label.set_text(dayLblLiveLo, "D Lo\n"+fmtPx(dLow))
        label.set_size(dayLblLiveLo, getLblSize())

if showDayOpenClose
    float oCur = snap(dOpen)
    float cCur = snap(close)
    if na(dayOpenLive)
        dayOpenLive := line.new(startCur, oCur, endCur, oCur, xloc=xloc.bar_time, color=colOpenLine, width=wOpen)
    else
        line.set_xy1(dayOpenLive, startCur, oCur)
        line.set_xy2(dayOpenLive, endCur, oCur)
    if na(dayCloseLive)
        dayCloseLive := line.new(startCur, cCur, endCur, cCur, xloc=xloc.bar_time, color=colCloseLineBase, width=wClose)
    else
        line.set_xy1(dayCloseLive, startCur, cCur)
        line.set_xy2(dayCloseLive, endCur, cCur)

    if showOCLblLive
        color clLive = closeLblCondColor ? (cCur > oCur ? color.new(color.green,0) : cCur < oCur ? color.new(color.red,0) : color.new(color.gray,0)) : color.new(color.gray,0)
        float yOpenLive  = (cCur >= oCur) ? ocOffBelow(snap(dLow), rngLive) : ocOffAbove(snap(dHigh), rngLive)
        float yCloseLive = (cCur >= oCur) ? ocOffAbove(snap(dHigh), rngLive) : ocOffBelow(snap(dLow), rngLive)
        
        if na(lblOpenLive)
            lblOpenLive := label.new(startCur, yOpenLive, xloc=xloc.bar_time, style=label.style_label_left, text="Open: "+fmtPx(oCur), color=color.new(colOpenLine,0), textcolor=color.white, size=getLblSize())
        else
            label.set_xy(lblOpenLive, startCur, yOpenLive)
            label.set_text(lblOpenLive, "Open: "+fmtPx(oCur))
            label.set_size(lblOpenLive, getLblSize())
            
        if na(lblCloseLive)
            lblCloseLive := label.new(endCur, yCloseLive, xloc=xloc.bar_time, style=label.style_label_right, text="Close: "+fmtPx(cCur), color=clLive, textcolor=color.white, size=getLblSize())
        else
            label.set_xy(lblCloseLive, endCur, yCloseLive)
            label.set_text(lblCloseLive, "Close: "+fmtPx(cCur))
            label.set_color(lblCloseLive, clLive)
            label.set_size(lblCloseLive, getLblSize())
    else
        if not na(lblOpenLive)
            label.delete(lblOpenLive)
            lblOpenLive := na
        if not na(lblCloseLive)
            label.delete(lblCloseLive)
            lblCloseLive := na

//==================== SESSIONS
bool sessionsEnabled = isIntraday

var array<box> s1_hist = array.new<box>()
var box   s1_live = na
var int   s1_startI = na
var float s1_hi = na
var float s1_lo = na

var array<box> s2_hist = array.new<box>()
var box   s2_live = na
var int   s2_startI = na
var float s2_hi = na
var float s2_lo = na

var array<box> s3_hist = array.new<box>()
var box   s3_live = na
var int   s3_startI = na
var float s3_hi = na
var float s3_lo = na

if not sessionsEnabled
    clearB(s1_hist)
    clearB(s2_hist)
    clearB(s3_hist)
    if not na(s1_live)
        box.delete(s1_live)
        s1_live := na
    if not na(s2_live)
        box.delete(s2_live)
        s2_live := na
    if not na(s3_live)
        box.delete(s3_live)
        s3_live := na
    s1_startI := na
    s2_startI := na
    s3_startI := na

if sessionsEnabled
    bool effShowAsiaHist = gShowAsia and showAsiaHist
    bool effShowAsiaLive = gShowAsia and showAsiaLive
    bool effShowEuroHist = gShowEuro and showEuroHist
    bool effShowEuroLive = gShowEuro and showEuroLive
    bool effShowUsaHist  = gShowUsa  and showUsaHist
    bool effShowUsaLive  = gShowUsa  and showUsaLive

    // ASIA
    bool s1_in = not na(time(timeframe.period, S_ASIA, "UTC"))
    bool s1_inPrev = not na(time(timeframe.period, S_ASIA, "UTC")[1])
    
    if s1_in and not s1_inPrev
        s1_startI := bar_index
        s1_hi := high
        s1_lo := low
    else if s1_in and na(s1_startI)
        s1_startI := bar_index
        s1_hi := high
        s1_lo := low
        
    if s1_in
        s1_hi := math.max(s1_hi, high)
        s1_lo := math.min(s1_lo, low)
        if effShowAsiaLive
            if na(s1_live)
                s1_live := box.new(s1_startI, snap(s1_hi), bar_index, snap(s1_lo), bgcolor=fillOrOutline(ASIA_FILL_DEF, asiaOutlineOnly), border_color=ASIA_BORDER)
            else
                box.set_lefttop(s1_live, s1_startI, snap(s1_hi))
                box.set_rightbottom(s1_live, bar_index, snap(s1_lo))
                
    if not s1_in and s1_inPrev and not na(s1_startI)
        if effShowAsiaHist
            array.push(s1_hist, box.new(s1_startI, snap(s1_hi), bar_index - 1, snap(s1_lo), bgcolor=fillOrOutline(ASIA_FILL_DEF, asiaOutlineOnly), border_color=ASIA_BORDER))
            while array.size(s1_hist) > getCap(keepAsia)
                box.delete(array.shift(s1_hist))
        if not na(s1_live)
            box.delete(s1_live)
            s1_live := na
        s1_startI := na

    // EUROPE
    bool s2_in = not na(time(timeframe.period, S_EUROPA, "UTC"))
    bool s2_inPrev = not na(time(timeframe.period, S_EUROPA, "UTC")[1])
    
    if s2_in and not s2_inPrev
        s2_startI := bar_index
        s2_hi := high
        s2_lo := low
    else if s2_in and na(s2_startI)
        s2_startI := bar_index
        s2_hi := high
        s2_lo := low
        
    if s2_in
        s2_hi := math.max(s2_hi, high)
        s2_lo := math.min(s2_lo, low)
        if effShowEuroLive
            if na(s2_live)
                s2_live := box.new(s2_startI, snap(s2_hi), bar_index, snap(s2_lo), bgcolor=fillOrOutline(EURO_FILL_DEF, euroOutlineOnly), border_color=EURO_BORDER)
            else
                box.set_lefttop(s2_live, s2_startI, snap(s2_hi))
                box.set_rightbottom(s2_live, bar_index, snap(s2_lo))
                
    if not s2_in and s2_inPrev and not na(s2_startI)
        if effShowEuroHist
            array.push(s2_hist, box.new(s2_startI, snap(s2_hi), bar_index - 1, snap(s2_lo), bgcolor=fillOrOutline(EURO_FILL_DEF, euroOutlineOnly), border_color=EURO_BORDER))
            while array.size(s2_hist) > getCap(keepEuro)
                box.delete(array.shift(s2_hist))
        if not na(s2_live)
            box.delete(s2_live)
            s2_live := na
        s2_startI := na

    // AMERICA
    bool s3_in = not na(time(timeframe.period, S_AMERICA, "UTC"))
    bool s3_inPrev = not na(time(timeframe.period, S_AMERICA, "UTC")[1])
    
    if s3_in and not s3_inPrev
        s3_startI := bar_index
        s3_hi := high
        s3_lo := low
    else if s3_in and na(s3_startI)
        s3_startI := bar_index
        s3_hi := high
        s3_lo := low
        
    if s3_in
        s3_hi := math.max(s3_hi, high)
        s3_lo := math.min(s3_lo, low)
        if effShowUsaLive
            if na(s3_live)
                s3_live := box.new(s3_startI, snap(s3_hi), bar_index, snap(s3_lo), bgcolor=fillOrOutline(USA_FILL_DEF, usaOutlineOnly), border_color=USA_BORDER)
            else
                box.set_lefttop(s3_live, s3_startI, snap(s3_hi))
                box.set_rightbottom(s3_live, bar_index, snap(s3_lo))
                
    if not s3_in and s3_inPrev and not na(s3_startI)
        if effShowUsaHist
            array.push(s3_hist, box.new(s3_startI, snap(s3_hi), bar_index - 1, snap(s3_lo), bgcolor=fillOrOutline(USA_FILL_DEF, usaOutlineOnly), border_color=USA_BORDER))
            while array.size(s3_hist) > getCap(keepUsa)
                box.delete(array.shift(s3_hist))
        if not na(s3_live)
            box.delete(s3_live)
            s3_live := na
        s3_startI := na
