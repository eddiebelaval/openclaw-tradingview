//@version=6
indicator("RegalRides Pro Indicator", overlay=true, max_labels_count=500, max_lines_count=500)

// =========================
// Inputs
// =========================
sessionHour   = input.int(9, "Session Start Hour", minval=0, maxval=23)
sessionMinute = input.int(15, "Session Start Minute", minval=0, maxval=59)
tz            = input.string("Asia/Kolkata", "Timezone")

showLevels    = input.bool(true, "Show First Candle High/Low")
showLabels    = input.bool(true, "Show Buy/Sell Labels")
showSLTP      = input.bool(true, "Show Stop Loss / Target")
rrMultiple    = input.float(2.0, "Target Risk:Reward", minval=0.5, step=0.5)

// =========================
// 15-minute chart check
// =========================
is15m = timeframe.isminutes and timeframe.multiplier == 15

barH = hour(time, tz)
barM = minute(time, tz)
barD = dayofmonth(time, tz)
barMo = month(time, tz)
barY = year(time, tz)

dayKey = barY * 10000 + barMo * 100 + barD

// =========================
// First and second candle detection
// =========================
isFirstCandle = is15m and barH == sessionHour and barM == sessionMinute

secondHour   = sessionMinute + 15 >= 60 ? (sessionHour + 1) % 24 : sessionHour
secondMinute = (sessionMinute + 15) % 60

isSecondCandle = is15m and barH == secondHour and barM == secondMinute

// =========================
// Persistent variables
// =========================
var float firstHigh = na
var float firstLow = na
var int savedDay = na
var bool signalTriggered = false

var float entryPrice = na
var float stopLoss = na
var float targetPrice = na
var string tradeSide = ""

// line references
var line highLine = na
var line lowLine = na
var line slLine = na
var line tpLine = na
var line entryLine = na

// =========================
// Reset each new day
// =========================
if na(savedDay) or dayKey != savedDay
    firstHigh := na
    firstLow := na
    signalTriggered := false
    entryPrice := na
    stopLoss := na
    targetPrice := na
    tradeSide := ""
    savedDay := dayKey

    if not na(highLine)
        line.delete(highLine)
    if not na(lowLine)
        line.delete(lowLine)
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(entryLine)
        line.delete(entryLine)

    highLine := na
    lowLine := na
    slLine := na
    tpLine := na
    entryLine := na

// =========================
// Save first candle range
// =========================
if isFirstCandle
    firstHigh := high
    firstLow := low

    if showLevels
        highLine := line.new(bar_index, firstHigh, bar_index + 20, firstHigh, extend=extend.right, color=color.green, width=2)
        lowLine  := line.new(bar_index, firstLow, bar_index + 20, firstLow, extend=extend.right, color=color.red, width=2)

// =========================
// Breakout logic on second candle only
// Uses closed candle values -> non repaint
// =========================
buySignal = isSecondCandle and not signalTriggered and not na(firstHigh) and close > firstHigh
sellSignal = isSecondCandle and not signalTriggered and not na(firstLow) and close < firstLow

if buySignal
    signalTriggered := true
    tradeSide := "BUY"
    entryPrice := close
    stopLoss := firstLow
    risk = entryPrice - stopLoss
    targetPrice := entryPrice + (risk * rrMultiple)

    if showLabels
        label.new(bar_index, high, "BUY\nRegalRides Pro", style=label.style_label_up, color=color.green, textcolor=color.white)

    if showSLTP
        entryLine := line.new(bar_index, entryPrice, bar_index + 20, entryPrice, extend=extend.right, color=color.blue, width=2)
        slLine := line.new(bar_index, stopLoss, bar_index + 20, stopLoss, extend=extend.right, color=color.red, width=2)
        tpLine := line.new(bar_index, targetPrice, bar_index + 20, targetPrice, extend=extend.right, color=color.green, width=2)

if sellSignal
    signalTriggered := true
    tradeSide := "SELL"
    entryPrice := close
    stopLoss := firstHigh
    risk = stopLoss - entryPrice
    targetPrice := entryPrice - (risk * rrMultiple)

    if showLabels
        label.new(bar_index, low, "SELL\nRegalRides Pro", style=label.style_label_down, color=color.red, textcolor=color.white)

    if showSLTP
        entryLine := line.new(bar_index, entryPrice, bar_index + 20, entryPrice, extend=extend.right, color=color.blue, width=2)
        slLine := line.new(bar_index, stopLoss, bar_index + 20, stopLoss, extend=extend.right, color=color.red, width=2)
        tpLine := line.new(bar_index, targetPrice, bar_index + 20, targetPrice, extend=extend.right, color=color.green, width=2)

// =========================
// Plot values
// =========================
plot(showLevels ? firstHigh : na, "First 15m High", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
plot(showLevels ? firstLow : na, "First 15m Low", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)

plot(showSLTP and signalTriggered ? entryPrice : na, "Entry", color=color.new(color.blue, 0), linewidth=2, style=plot.style_linebr)
plot(showSLTP and signalTriggered ? stopLoss : na, "Stop Loss", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(showSLTP and signalTriggered ? targetPrice : na, "Target", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)

// =========================
// Alerts
// =========================
alertcondition(buySignal, title="RegalRides Pro BUY", message="RegalRides Pro Indicator: BUY signal on second 15-minute candle breakout above first candle high.")
alertcondition(sellSignal, title="RegalRides Pro SELL", message="RegalRides Pro Indicator: SELL signal on second 15-minute candle breakout below first candle low.")

// =========================
// Warning label
// =========================
if barstate.islast and not is15m
    label.new(bar_index, close, "Use RegalRides Pro on 15-minute chart", style=label.style_label_center, color=color.orange, textcolor=color.white)
