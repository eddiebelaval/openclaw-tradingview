//@version=6
// -----------------------------------------------------------------------------------------------------------------------
// 📜 NAME: The Oliver Velez "Realist" Legacy Suite
// 🛠️ VERSION: 3.4 (High-Visibility Elephant Bars)
// 👤 ATTRIBUTION: Methodology by Oliver Velez.
// -----------------------------------------------------------------------------------------------------------------------
indicator("The Oliver Velez Realist Legacy Suite", "OV LEGACY V3.4", overlay=true, max_lines_count=500)

// =====================================================
// 🎨 COLORS
// =====================================================
color_bull     = #00FF13
color_bear     = #FF0000 
color_gold     = #D4AF37 
color_white    = #FFFFFF
color_halt     = #0080FF
color_mark     = #FFD700 
color_squeeze  = #00FFFF 
color_alert    = #FFFF00 

// =====================================================
// ⚙️ INPUTS
// =====================================================
grp_180      = "🔄 180 PATTERN (U-TURNS)"
show_180     = input.bool(true, "Enable 180 Detection", group=grp_180)
min_body_pct = input.float(70.0, "Min Body %", group=grp_180)
extension    = input.int(5, "Pillar Extension", group=grp_180)

grp_sqz      = "🌀 CONSOLIDATION (THE SQUEEZE)"
show_sqz_zone = input.bool(true, "Fill Squeeze Zone", group=grp_sqz)
show_sqz_bars = input.bool(true, "Color Squeeze Candles", group=grp_sqz)
flat_thresh  = input.float(8.0, "Flatness Sensitivity", group=grp_sqz)
sqz_dist_atr = input.float(100.0, "MA Gap Tolerance (ATR)", group=grp_sqz)

grp_velez    = "🐘 INSTITUTIONAL SIGNALS"
show_elephant = input.bool(true, "Show Elephant Bars", group=grp_velez)
show_ign      = input.bool(true, "Show RBI/GBI (Ignored Bars)", group=grp_velez)
show_halt     = input.bool(true, "Show 20 MA Halt (Blue Dots)", group=grp_velez)
e_body_mult   = input.float(2.0, "Elephant Size Mult", group=grp_velez)
e_clear_bars  = input.int(3, "Clearing Lookback", group=grp_velez)
e_min_solid   = input.float(85.0, "Body Solidness %", group=grp_velez)
show_x_marks  = input.bool(true, "Show Clearing 'X'", group=grp_velez)

grp_sync     = "📏 SYSTEM ARCHITECTURE"
dev_target   = input.float(2.0, "STD Deviation Trigger", group=grp_sync)
slow_len     = input.int(20, "Moving Average (Home Base)", group=grp_sync)
trend_len    = input.int(200, "Institutional Anchor", group=grp_sync)

grp_alert    = "🔔 ALERT CONTROL (UNCHECK TO DISABLE)"
alert_all    = input.bool(true, "Active: Master (Any Signal)", group=grp_alert)
alert_e      = input.bool(true, "Active: Elephant Bars", group=grp_alert)
alert_180    = input.bool(true, "Active: 180 U-Turns", group=grp_alert)
alert_ign    = input.bool(true, "Active: Ignored Bars (RBI/GBI)", group=grp_alert)
alert_halt   = input.bool(true, "Active: 20 MA Halts", group=grp_alert)

// =====================================================
// 🚀 ENGINES
// =====================================================
float ma_slow  = ta.sma(close, slow_len)
float ma_trend = ta.sma(close, trend_len)
float atr_curr = ta.atr(14)

f_angle(_src) => 180 / math.pi * math.atan((_src - _src[5]) / 5)
float angle_20  = f_angle(ma_slow)
float angle_200 = f_angle(ma_trend)

bool is_squeeze = math.abs(angle_20) <= flat_thresh and math.abs(angle_200) <= (flat_thresh * 0.5) and math.abs(ma_slow - ma_trend) < (atr_curr * sqz_dist_atr)
float dist_p_20 = (close - ma_slow) / ta.stdev(close, slow_len)

// =====================================================
// 🎯 PATTERN LOGIC
// =====================================================
float body = math.abs(open - close)
float candle_range = high - low

bool clears_bull = close > ta.highest(high[1], e_clear_bars)
bool clears_bear = close < ta.lowest(low[1], e_clear_bars)
bool is_bull_e   = show_elephant and close > open and body >= (ta.sma(body, 20) * e_body_mult) and (body/candle_range * 100 >= e_min_solid) and clears_bull
bool is_bear_e   = show_elephant and close < open and body >= (ta.sma(body, 20) * e_body_mult) and (body/candle_range * 100 >= e_min_solid) and clears_bear

bool bull_180 = show_180 and (open[1] > close[1]) and (close > open) and (close >= open[1]) and (body[1]/(high[1]-low[1])*100 >= min_body_pct)
bool bear_180 = show_180 and (close[1] > open[1]) and (open > close) and (close <= open[1]) and (body[1]/(high[1]-low[1])*100 >= min_body_pct)

bool is_gbi = show_ign and close[2] > open[2] and close[1] < open[1] and close > high[1] and close > open and (body[2] > body[1])
bool is_rbi = show_ign and close[2] < open[2] and close[1] > open[1] and close < low[1] and close < open and (body[2] > body[1])

bool is_halt_bull = show_halt and low <= (ma_slow + (atr_curr * 0.15)) and low >= (ma_slow - (atr_curr * 0.15)) and ta.rising(ma_slow, 1) and close > ma_slow
bool is_halt_bear = show_halt and high >= (ma_slow - (atr_curr * 0.15)) and high <= (ma_slow + (atr_curr * 0.15)) and ta.falling(ma_slow, 1) and close < ma_slow

var int p_cnt = 0
if (bull_180 or bear_180 or is_bull_e or is_bear_e or is_gbi or is_rbi)
    p_cnt := extension + 1
else
    p_cnt := math.max(0, p_cnt - 1)

// =====================================================
// 🔔 ALERT ENGINE
// =====================================================
bool any_signal = is_bull_e or is_bear_e or bull_180 or bear_180 or is_gbi or is_rbi or is_halt_bull or is_halt_bear
if alert_all and any_signal
    alert("Velez Signal: " + syminfo.ticker + " @ " + str.tostring(close), alert.freq_once_per_bar)
if alert_e and (is_bull_e or is_bear_e)
    alert("Elephant Bar: " + syminfo.ticker, alert.freq_once_per_bar)
if alert_180 and (bull_180 or bear_180)
    alert("180 U-Turn: " + syminfo.ticker, alert.freq_once_per_bar)
if alert_ign and (is_gbi or is_rbi)
    alert("Ignored Bar: " + syminfo.ticker, alert.freq_once_per_bar)
if alert_halt and (is_halt_bull or is_halt_bear)
    alert("20 MA Halt: " + syminfo.ticker, alert.freq_once_per_bar)

// =====================================================
// 🖌️ VISUAL RENDERING
// =====================================================
p1 = plot(ma_slow, "20 SMA", color=ta.rising(ma_slow, 1) ? color_bull : color_bear, linewidth=3)
p2 = plot(ma_trend, "200 SMA", color=color.new(color_gold, 35), linewidth=3)
fill(p1, p2, color = is_squeeze and show_sqz_zone ? color.new(color_squeeze, 75) : color.new(color_squeeze, 100), title="Squeeze Fill")

plot(is_halt_bull or is_halt_bear ? ma_slow : na, "20 MA Halt Dot", color=color_halt, style=plot.style_circles, linewidth=4)
plot(p_cnt > 0 ? ma_slow : na, "Legacy Pillar", color=color_white, style=plot.style_linebr, linewidth=3)

var table dash = table.new(position.top_right, 2, 2, bgcolor=color.new(#131722, 10), border_width=1, border_color=color.new(color_white, 20))
if barstate.islast
    table.cell(dash, 0, 0, "20 SMA Angle", text_color=color_white, text_size=size.small)
    table.cell(dash, 1, 0, str.tostring(angle_20, "#.##") + "°", text_color=is_squeeze ? color_squeeze : color_white, text_size=size.small)
    table.cell(dash, 0, 1, "Dev", text_color=color_white, text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(math.abs(dist_p_20), "#.##") + "σ", text_color=math.abs(dist_p_20) >= dev_target ? color_bull : color_white, text_size=size.small)

if show_x_marks and (is_bull_e or is_bear_e)
    for i = 1 to e_clear_bars
        y_loc = is_bull_e ? low[i] - (atr_curr * 0.15) : high[i] + (atr_curr * 0.15)
        label.new(bar_index[i], y_loc, "x", color=color.new(#000000, 100), textcolor=color_mark, style=label.style_none, size=size.small)

plotshape(is_gbi, "GBI", shape.arrowup, location.belowbar, color_bull, size=size.tiny)
plotshape(is_rbi, "RBI", shape.arrowdown, location.abovebar, color_bear, size=size.tiny)
plotshape(bull_180, "Bull 180", shape.triangleup, location.belowbar, color_bull, size=size.small)
plotshape(bear_180, "Bear 180", shape.triangledown, location.abovebar, color_bear, size=size.small)

//  ELEPHANT BAR ARROWS
plotshape(is_bull_e, "Bull E", shape.triangleup, location.belowbar, color_white, size=size.normal)
plotshape(is_bear_e, "Bear E", shape.triangledown, location.abovebar, color_white, size=size.normal)

barcolor(color = (show_sqz_bars and is_squeeze) ? color_alert : (p_cnt > 0 ? (close > open ? color.new(color_bull, 60) : color.new(color_bear, 60)) : na))
