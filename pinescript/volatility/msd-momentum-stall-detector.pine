//@version=6
indicator("◈ 𝗦𝗣𝗨𝗧𝗡𝗜𝗞 ── Momentum Stall Detector", overlay=true, max_labels_count=500)

// ═══════════════════════════════════════════════════════
//  𝗦𝗣𝗨𝗧𝗡𝗜𝗞  ·  Mo stl dtctr
//  Logic extracted · No modifications
// ═══════════════════════════════════════════════════════

// ── Colors ──
var color SPUTNIK_PURPLE   = color.rgb(155, 89, 255)
var color SPUTNIK_DARK     = color.rgb(130, 60, 230)
var color SPUTNIK_GLOW     = color.rgb(185, 140, 255)
var color SPUTNIK_BG       = color.rgb(12, 8, 20)
var color SPUTNIK_BG_LIGHT = color.rgb(22, 16, 35)
var color SPUTNIK_WHITE    = color.rgb(220, 215, 235)
var color SPUTNIK_DIM      = color.rgb(90, 80, 110)
var color SPUTNIK_RED      = color.rgb(255, 50, 80)

// ── Moving Averages ──
sma5  = ta.sma(close, 5)
sma20 = ta.sma(close, 20)

// ── Slopes (2-bar = 8hr, 3-bar = 12hr lookback) ──
sell_slope5_2  = (sma5 - sma5[2]) / 2
sell_slope5_3  = (sma5 - sma5[3]) / 3
sell_slope20_2 = (sma20 - sma20[2]) / 2
sell_slope20_3 = (sma20 - sma20[3]) / 3

// ── Accelerations & Delta ──
sell_accel5    = sell_slope5_2 - sell_slope5_3
sell_accel20   = sell_slope20_2 - sell_slope20_3
sell_delta2    = sell_slope5_2 - sell_slope20_2
sell_delta3    = sell_slope5_3 - sell_slope20_3
sell_deltaConv = math.abs(sell_delta2) - math.abs(sell_delta3)

// ── Distances ──
sell_dist5   = ((close - sma5) / sma5) * 100
sell_dist20  = ((close - sma20) / sma20) * 100
sell_spread  = ((sma5 - sma20) / sma20) * 100

// ── SELL Conditions (untouched) ──
sell_c1 = close > sma5 and sell_dist5 < 1.0
sell_c2 = close > sma20 and sell_dist20 < 1.5
sell_c3 = math.abs(sell_spread) < 0.5
sell_c4 = sell_accel5 < -0.3
sell_c5 = sell_accel20 < 0
sell_c6 = sell_deltaConv < -0.3

crash_sell = sell_c1 and sell_c2 and sell_c3 and sell_c4 and sell_c5 and sell_c6

// ═══════════════════════════════════════════════════════
//  𝗦𝗜𝗚𝗡𝗔𝗟  𝗣𝗟𝗢𝗧
// ═══════════════════════════════════════════════════════

plotshape(crash_sell, title="Crash Sell", style=shape.triangledown, 
     location=location.abovebar, color=SPUTNIK_PURPLE, size=size.small)

barcolor(crash_sell ? SPUTNIK_DARK : na, title="Signal Bar Tint")

// ═══════════════════════════════════════════════════════
//  𝗗𝗔𝗦𝗛𝗕𝗢𝗔𝗥𝗗
// ═══════════════════════════════════════════════════════

// ── Status helpers ──
c1_txt = sell_c1 ? "● PASS" : "○ fail"
c2_txt = sell_c2 ? "● PASS" : "○ fail"
c3_txt = sell_c3 ? "● PASS" : "○ fail"
c4_txt = sell_c4 ? "● PASS" : "○ fail"
c5_txt = sell_c5 ? "● PASS" : "○ fail"
c6_txt = sell_c6 ? "● PASS" : "○ fail"

c1_col = sell_c1 ? SPUTNIK_GLOW : SPUTNIK_DIM
c2_col = sell_c2 ? SPUTNIK_GLOW : SPUTNIK_DIM
c3_col = sell_c3 ? SPUTNIK_GLOW : SPUTNIK_DIM
c4_col = sell_c4 ? SPUTNIK_GLOW : SPUTNIK_DIM
c5_col = sell_c5 ? SPUTNIK_GLOW : SPUTNIK_DIM
c6_col = sell_c6 ? SPUTNIK_GLOW : SPUTNIK_DIM

if barstate.islast
    var table dash = table.new(position.top_right, 2, 9, 
         bgcolor=SPUTNIK_BG, border_color=SPUTNIK_DIM, border_width=1)

    // ── Header ──
    table.cell(dash, 0, 0, "◈  𝗦𝗣𝗨𝗧𝗡𝗜𝗞", 
         text_color=SPUTNIK_PURPLE, text_size=size.normal, 
         bgcolor=SPUTNIK_BG, text_font_family=font.family_monospace, 
         text_halign=text.align_left)
    table.cell(dash, 1, 0, "CRASH  DET.", 
         text_color=SPUTNIK_DIM, text_size=size.small, 
         bgcolor=SPUTNIK_BG, text_font_family=font.family_monospace,
         text_halign=text.align_right)

    // ── Separator ──
    table.cell(dash, 0, 1, "────────", 
         text_color=SPUTNIK_DIM, text_size=size.tiny, 
         bgcolor=SPUTNIK_BG, text_font_family=font.family_monospace)
    table.cell(dash, 1, 1, "────────", 
         text_color=SPUTNIK_DIM, text_size=size.tiny, 
         bgcolor=SPUTNIK_BG, text_font_family=font.family_monospace)

    // ── Condition Readout ──
    table.cell(dash, 0, 2, "dist5  ", text_color=SPUTNIK_WHITE, text_size=size.tiny, 
         bgcolor=SPUTNIK_BG, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 2, c1_txt, text_color=c1_col, text_size=size.tiny, 
         bgcolor=SPUTNIK_BG, text_font_family=font.family_monospace, text_halign=text.align_right)

    table.cell(dash, 0, 3, "dist20 ", text_color=SPUTNIK_WHITE, text_size=size.tiny, 
         bgcolor=SPUTNIK_BG, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 3, c2_txt, text_color=c2_col, text_size=size.tiny, 
         bgcolor=SPUTNIK_BG, text_font_family=font.family_monospace, text_halign=text.align_right)

    table.cell(dash, 0, 4, "spread ", text_color=SPUTNIK_WHITE, text_size=size.tiny, 
         bgcolor=SPUTNIK_BG, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 4, c3_txt, text_color=c3_col, text_size=size.tiny, 
         bgcolor=SPUTNIK_BG, text_font_family=font.family_monospace, text_halign=text.align_right)

    table.cell(dash, 0, 5, "accel5 ", text_color=SPUTNIK_WHITE, text_size=size.tiny, 
         bgcolor=SPUTNIK_BG, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 5, c4_txt, text_color=c4_col, text_size=size.tiny, 
         bgcolor=SPUTNIK_BG, text_font_family=font.family_monospace, text_halign=text.align_right)

    table.cell(dash, 0, 6, "accel20", text_color=SPUTNIK_WHITE, text_size=size.tiny, 
         bgcolor=SPUTNIK_BG, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 6, c5_txt, text_color=c5_col, text_size=size.tiny, 
         bgcolor=SPUTNIK_BG, text_font_family=font.family_monospace, text_halign=text.align_right)

    table.cell(dash, 0, 7, "deltaCV", text_color=SPUTNIK_WHITE, text_size=size.tiny, 
         bgcolor=SPUTNIK_BG, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 7, c6_txt, text_color=c6_col, text_size=size.tiny, 
         bgcolor=SPUTNIK_BG, text_font_family=font.family_monospace, text_halign=text.align_right)

    // ── Final Verdict ──
    table.cell(dash, 0, 8, "STATUS", text_color=SPUTNIK_WHITE, text_size=size.tiny, 
         bgcolor=SPUTNIK_BG_LIGHT, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 8, crash_sell ? "▼ CRASH SELL" : "—  neutral", 
         text_color=crash_sell ? SPUTNIK_RED : SPUTNIK_DIM, text_size=size.tiny, 
         bgcolor=SPUTNIK_BG_LIGHT, text_font_family=font.family_monospace, text_halign=text.align_right)

// ── Alert ──
alertcondition(crash_sell, title="Sputnik · Crash Sell", 
     message="◈ SPUTNIK ── sell signal")
