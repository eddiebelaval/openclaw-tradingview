//@version=5
indicator("God's Eye", overlay=true, max_labels_count=50)

// Thresholds (adjustable)
t_asia = input.float(defval=1.5, title="Asia Drop %",    minval=0.1)
t_mena = input.float(defval=1.5, title="MENA Drop %",    minval=0.1)
t_eur  = input.float(defval=1.0, title="Europe Drop %",  minval=0.1)
t_oil  = input.float(defval=3.0, title="Oil Spike %",    minval=0.1)
t_gold = input.float(defval=1.5, title="Gold Spike %",   minval=0.1)
t_vix  = input.float(defval=8.0, title="VIX Spike %",    minval=1.0)
t_fut  = input.float(defval=0.8, title="Futures Drop %",  minval=0.1)
t_dxy  = input.float(defval=0.5, title="Dollar Spike %", minval=0.1)

show_table    = input.bool(defval=true, title="Show Dashboard")
show_scores   = input.bool(defval=true, title="Plot Scores")
score_display = input.string(defval="US Open", title="Score to Plot", options=["MENA Open", "Europe Open", "US Open", "All"])

alert_severe = input.float(defval=-6.0, title="Severe Alert <=", minval=-10.0, maxval=0.0)
alert_warn   = input.float(defval=-3.0, title="Warning Alert <=", minval=-10.0, maxval=0.0)

// Weights are hardcoded for compilation stability. Edit values here:
// --- MENA prediction weights ---
W_MENA_ASIA  = 2.5
W_MENA_OIL   = 3.0
W_MENA_GOLD  = 1.5
W_MENA_FUT   = 1.0
// --- Europe prediction weights ---
W_EUR_ASIA   = 1.5
W_EUR_MENA   = 1.5
W_EUR_OIL    = 2.0
W_EUR_FUT    = 2.5
W_EUR_VIX    = 1.5
// --- US prediction weights ---
W_US_ASIA    = 1.0
W_US_MENA    = 1.0
W_US_EUR     = 2.5
W_US_FUT     = 3.0
W_US_VIX     = 2.0
W_US_OIL     = 1.5
W_US_DXY     = 1.0
W_US_GOLD    = 1.0

// ============================================================
//  DATA FEEDS
// ============================================================

pct(c, p) =>
    p != 0 and not na(c) and not na(p) ? ((c - p) / math.abs(p)) * 100.0 : 0.0

// ASIA (4 calls)
[nik_c, nik_p, nik_p2] = request.security("TVC:NI225",  timeframe.period, [close, close[1], close[2]])
[hsi_c, hsi_p, hsi_p2] = request.security("TVC:HSI",        timeframe.period, [close, close[1], close[2]])
[sha_c, sha_p, sha_p2] = request.security("SSE:000001", timeframe.period, [close, close[1], close[2]])
[asx_c, asx_p]         = request.security("ASX:XJO",    timeframe.period, [close, close[1]])

// MENA (3 calls)
[tasi_c, tasi_p, tasi_p2] = request.security("TADAWUL:TASI", timeframe.period, [close, close[1], close[2]])
[egx_c,  egx_p,  egx_p2]  = request.security("EGX:EGX30",   timeframe.period, [close, close[1], close[2]])
[dfm_c,  dfm_p]           = request.security("DFM:DFMGI",    timeframe.period, [close, close[1]])

// EUROPE (4 calls)
[dax_c, dax_p]  = request.security("XETR:DAX",      timeframe.period, [close, close[1]])
[ftse_c, ftse_p]= request.security("TVC:UKX",      timeframe.period, [close, close[1]])
[cac_c, cac_p]  = request.security("EURONEXT:PX1",  timeframe.period, [close, close[1]])
[stx_c, stx_p]  = request.security("TVC:SX5E", timeframe.period, [close, close[1]])

// COMMODITIES (4 calls)
[wti_c, wti_p] = request.security("NYMEX:CL1!",  timeframe.period, [close, close[1]])
[brt_c, brt_p] = request.security("NYMEX:BZ1!",  timeframe.period, [close, close[1]])
[gld_c, gld_p] = request.security("COMEX:GC1!",  timeframe.period, [close, close[1]])
[slv_c, slv_p] = request.security("COMEX:SI1!",  timeframe.period, [close, close[1]])

// US FUTURES (3 calls)
[es_c, es_p] = request.security("CME_MINI:ES1!", timeframe.period, [close, close[1]])
[nq_c, nq_p] = request.security("CME_MINI:NQ1!", timeframe.period, [close, close[1]])
[ym_c, ym_p] = request.security("CBOT_MINI:YM1!", timeframe.period, [close, close[1]])

// RISK GAUGES (2 calls)
[vix_c, vix_p] = request.security("CBOE:VIX", timeframe.period, [close, close[1]])
[dxy_c, dxy_p] = request.security("TVC:DXY",  timeframe.period, [close, close[1]])

// ============================================================
//  PERCENT CHANGES
// ============================================================

// Asia: timezone buffer - use worse of today/yesterday
nik_t = pct(nik_c, nik_p)
nik_y = pct(nik_p, nik_p2)
hsi_t = pct(hsi_c, hsi_p)
hsi_y = pct(hsi_p, hsi_p2)
sha_t = pct(sha_c, sha_p)
sha_y = pct(sha_p, sha_p2)
asx_chg = pct(asx_c, asx_p)

nik_chg = math.abs(nik_y) > math.abs(nik_t) and math.abs(nik_y) > t_asia ? nik_y : nik_t
hsi_chg = math.abs(hsi_y) > math.abs(hsi_t) and math.abs(hsi_y) > t_asia ? hsi_y : hsi_t
sha_chg = math.abs(sha_y) > math.abs(sha_t) and math.abs(sha_y) > t_asia ? sha_y : sha_t

asia_avg = (nik_chg + hsi_chg + sha_chg + asx_chg) / 4.0
asia_drops = (nik_chg < -t_asia ? 1 : 0) + (hsi_chg < -t_asia ? 1 : 0) + (sha_chg < -t_asia ? 1 : 0) + (asx_chg < -t_asia ? 1 : 0)

// MENA: timezone buffer
tasi_t = pct(tasi_c, tasi_p)
tasi_y = pct(tasi_p, tasi_p2)
egx_t  = pct(egx_c, egx_p)
egx_y  = pct(egx_p, egx_p2)
dfm_chg = pct(dfm_c, dfm_p)

tasi_chg = math.abs(tasi_y) > math.abs(tasi_t) and math.abs(tasi_y) > t_mena ? tasi_y : tasi_t
egx_chg  = math.abs(egx_y) > math.abs(egx_t) and math.abs(egx_y) > t_mena ? egx_y : egx_t

mena_avg = (tasi_chg + egx_chg + dfm_chg) / 3.0
mena_drops = (tasi_chg < -t_mena ? 1 : 0) + (egx_chg < -t_mena ? 1 : 0) + (dfm_chg < -t_mena ? 1 : 0)

// Europe
dax_chg  = pct(dax_c, dax_p)
ftse_chg = pct(ftse_c, ftse_p)
cac_chg  = pct(cac_c, cac_p)
stx_chg  = pct(stx_c, stx_p)

eur_avg = (dax_chg + ftse_chg + cac_chg + stx_chg) / 4.0
eur_drops = (dax_chg < -t_eur ? 1 : 0) + (ftse_chg < -t_eur ? 1 : 0) + (cac_chg < -t_eur ? 1 : 0) + (stx_chg < -t_eur ? 1 : 0)

// Commodities
wti_chg = pct(wti_c, wti_p)
brt_chg = pct(brt_c, brt_p)
oil_avg = (wti_chg + brt_chg) / 2.0
gld_chg = pct(gld_c, gld_p)
slv_chg = pct(slv_c, slv_p)
metals_avg = (gld_chg + slv_chg) / 2.0

// Brent-WTI spread widening = supply disruption
brent_wti_spread = brt_c - wti_c
brent_wti_prev   = brt_p - wti_p
spread_widening  = brent_wti_spread > brent_wti_prev * 1.2 and brent_wti_spread > 3.0

// US Futures
es_chg  = pct(es_c, es_p)
nq_chg  = pct(nq_c, nq_p)
ym_chg  = pct(ym_c, ym_p)
fut_avg = (es_chg + nq_chg + ym_chg) / 3.0

// Risk
vix_chg = pct(vix_c, vix_p)
dxy_chg = pct(dxy_c, dxy_p)

// ============================================================
//  SCORING: each component -> [-1.0, +1.0]
// ============================================================

score_index(chg, thresh) =>
    chg <= -thresh * 2.0 ? -1.0 :
     chg <= -thresh       ? -0.7 :
     chg <= -thresh * 0.5 ? -0.3 :
     chg >= thresh         ?  0.7 :
     chg >= thresh * 0.5   ?  0.3 : 0.0

score_spike(chg, thresh) =>
    chg >= thresh * 2.0 ? -1.0 :
     chg >= thresh       ? -0.7 :
     chg >= thresh * 0.5 ? -0.5 :
     chg <= -thresh       ?  0.7 :
     chg <= -thresh * 0.5 ?  0.3 : 0.0

consensus(drops, total) =>
    drops >= total     ? 1.0 :
     drops >= total - 1 ? 0.8 :
     drops >= 2         ? 0.6 :
     drops == 1         ? 0.35 : 0.0

normalize(raw, max_w) =>
    max_w != 0.0 ? math.max(-10.0, math.min(10.0, (raw / max_w) * 10.0)) : 0.0

// --- Component scores ---
s_asia_raw  = score_index(asia_avg, t_asia)
s_asia_mult = consensus(asia_drops, 4)
s_asia      = s_asia_raw < 0.0 ? s_asia_raw * math.max(s_asia_mult, 0.25) : s_asia_raw

s_mena_raw  = score_index(mena_avg, t_mena)
s_mena_mult = consensus(mena_drops, 3)
s_mena      = s_mena_raw < 0.0 ? s_mena_raw * math.max(s_mena_mult, 0.25) : s_mena_raw

s_eur_raw   = score_index(eur_avg, t_eur)
s_eur_mult  = consensus(eur_drops, 4)
s_eur       = s_eur_raw < 0.0 ? s_eur_raw * math.max(s_eur_mult, 0.25) : s_eur_raw

s_oil     = score_spike(oil_avg, t_oil)
s_oil_adj = spread_widening ? math.min(s_oil - 0.2, -1.0) : s_oil

gold_flight = metals_avg > t_gold and (s_asia < -0.3 or s_mena < -0.3 or s_eur < -0.3)
s_gold = gold_flight ? -0.7 : metals_avg > t_gold * 2.0 ? -0.5 : metals_avg > t_gold ? -0.3 : metals_avg < -t_gold ? 0.3 : 0.0

s_fut = score_index(fut_avg, t_fut)
s_vix = score_spike(vix_chg, t_vix)
s_dxy = score_spike(dxy_chg, t_dxy)

// ============================================================
//  CASCADE PREDICTIONS
// ============================================================

// Stage 1: MENA Open (from Asia + Oil + Gold + Futures)
raw_mena = (s_asia * W_MENA_ASIA) + (s_oil_adj * W_MENA_OIL) + (s_gold * W_MENA_GOLD) + (s_fut * W_MENA_FUT)
pred_mena = normalize(raw_mena, W_MENA_ASIA + W_MENA_OIL + W_MENA_GOLD + W_MENA_FUT)

// Stage 2: Europe Open (Asia + MENA + Oil + Futures + VIX)
raw_eur = (s_asia * W_EUR_ASIA) + (s_mena * W_EUR_MENA) + (s_oil_adj * W_EUR_OIL) + (s_fut * W_EUR_FUT) + (s_vix * W_EUR_VIX)
pred_eur = normalize(raw_eur, W_EUR_ASIA + W_EUR_MENA + W_EUR_OIL + W_EUR_FUT + W_EUR_VIX)

// Stage 3: US Open (everything)
raw_us = (s_asia * W_US_ASIA) + (s_mena * W_US_MENA) + (s_eur * W_US_EUR) + (s_fut * W_US_FUT) + (s_vix * W_US_VIX) + (s_oil_adj * W_US_OIL) + (s_dxy * W_US_DXY) + (s_gold * W_US_GOLD)
pred_us = normalize(raw_us, W_US_ASIA + W_US_MENA + W_US_EUR + W_US_FUT + W_US_VIX + W_US_OIL + W_US_DXY + W_US_GOLD)

pred_all = (pred_mena + pred_eur + pred_us) / 3.0

// ============================================================
//  FORECAST HELPERS
// ============================================================

forecast_text(score) =>
    score <= -7.0 ? "CRASH RISK" : score <= -5.0 ? "HARD SELL-OFF" : score <= -3.0 ? "GAP DOWN" : score <= -1.5 ? "WEAK OPEN" : score >= 7.0 ? "STRONG RALLY" : score >= 5.0 ? "GAP UP" : score >= 3.0 ? "FIRM OPEN" : score >= 1.5 ? "SLIGHT BID" : "NEUTRAL"

forecast_color(score) =>
    score <= -5.0 ? color.red : score <= -3.0 ? color.orange : score <= -1.5 ? color.new(color.orange, 40) : score >= 5.0 ? color.green : score >= 3.0 ? color.teal : score >= 1.5 ? color.new(color.teal, 40) : color.gray

cell_color(val, thresh, invert) =>
    v = invert ? -val : val
    v <= -thresh * 1.5 ? color.red : v <= -thresh ? color.orange : v <= -thresh * 0.5 ? color.new(color.orange, 40) : v >= thresh ? color.green : v >= thresh * 0.5 ? color.teal : color.gray

// ============================================================
//  VISUALS
// ============================================================

worst_pred = math.min(pred_mena, math.min(pred_eur, pred_us))
best_pred  = math.max(pred_mena, math.max(pred_eur, pred_us))
dominant   = math.abs(worst_pred) > math.abs(best_pred) ? worst_pred : best_pred

bg = dominant <= -5.0 ? color.new(color.red, 78) : dominant <= -3.0 ? color.new(color.red, 87) : dominant <= -1.5 ? color.new(color.orange, 90) : dominant >= 5.0 ? color.new(color.green, 78) : dominant >= 3.0 ? color.new(color.teal, 87) : dominant >= 1.5 ? color.new(color.teal, 92) : na
bgcolor(bg, title="Stress Heatmap")

all_negative = pred_mena <= alert_warn and pred_eur <= alert_warn and pred_us <= alert_warn

plotshape(all_negative and pred_us <= alert_severe, title="Contagion", location=location.abovebar, color=color.new(color.purple, 0), style=shape.labeldown, text="GLOBAL\nCONTAGION", textcolor=color.white, size=size.normal)

plotshape(all_negative and pred_us > alert_severe, title="Warning", location=location.abovebar, color=color.new(color.orange, 0), style=shape.labeldown, text="CASCADE\nWARNING", textcolor=color.white, size=size.small)

all_positive = pred_mena >= 2.0 and pred_eur >= 2.0 and pred_us >= 2.0
bars_since_neg = ta.barssince(all_negative)
recovery = all_positive and not na(bars_since_neg) and bars_since_neg > 0 and bars_since_neg <= 7

plotshape(recovery, title="Recovery", location=location.belowbar, color=color.new(color.teal, 0), style=shape.labelup, text="CASCADE\nCLEARED", textcolor=color.white, size=size.normal)

plot_score = score_display == "MENA Open" ? pred_mena : score_display == "Europe Open" ? pred_eur : score_display == "US Open" ? pred_us : pred_all
plot(show_scores ? plot_score : na, title="Score", color=forecast_color(plot_score), linewidth=2, style=plot.style_columns)
hline(0, "Zero", color=color.gray, linestyle=hline.style_dotted)
hline(-3, "Warn", color=color.orange, linestyle=hline.style_dashed)
hline(-6, "Severe", color=color.red, linestyle=hline.style_dashed)
hline(3, "Bullish", color=color.teal, linestyle=hline.style_dashed)

// ============================================================
//  DASHBOARD TABLE
// ============================================================

if show_table and barstate.islast
    var tbl = table.new(position.top_right, 4, 18, bgcolor=color.new(#0a0a14, 5), border_width=1, border_color=color.new(color.gray, 70))

    // Header
    table.cell(tbl, 0, 0, "CASCADE PREDICTOR", text_color=#8888ff, text_size=size.small, bgcolor=color.new(#1a1a3e, 0), text_halign=text.align_left)
    table.cell(tbl, 1, 0, "Chg %",  text_color=color.white, text_size=size.tiny, bgcolor=color.new(#1a1a3e, 0))
    table.cell(tbl, 2, 0, "Score",  text_color=color.white, text_size=size.tiny, bgcolor=color.new(#1a1a3e, 0))
    table.cell(tbl, 3, 0, "Signal", text_color=color.white, text_size=size.tiny, bgcolor=color.new(#1a1a3e, 0))

    // Commodities section
    table.cell(tbl, 0, 1, "-- COMMODITIES --", text_color=#aaaacc, text_size=size.tiny, bgcolor=color.new(#12122a, 0), text_halign=text.align_left)
    table.cell(tbl, 1, 1, "", bgcolor=color.new(#12122a, 0))
    table.cell(tbl, 2, 1, "", bgcolor=color.new(#12122a, 0))
    table.cell(tbl, 3, 1, "", bgcolor=color.new(#12122a, 0))

    table.cell(tbl, 0, 2, "Oil (WTI/Brent)", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 2, str.tostring(oil_avg, "#.##") + "%", text_color=cell_color(oil_avg, t_oil, true), text_size=size.tiny)
    table.cell(tbl, 2, 2, str.tostring(s_oil_adj, "#.##"), text_color=s_oil_adj < 0.0 ? color.red : color.green, text_size=size.tiny)
    table.cell(tbl, 3, 2, spread_widening ? "! SPREAD" : "", text_color=color.orange, text_size=size.tiny)

    table.cell(tbl, 0, 3, "Gold / Silver", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 3, str.tostring(metals_avg, "#.##") + "%", text_color=cell_color(metals_avg, t_gold, false), text_size=size.tiny)
    table.cell(tbl, 2, 3, str.tostring(s_gold, "#.##"), text_color=s_gold < 0.0 ? color.red : color.green, text_size=size.tiny)
    table.cell(tbl, 3, 3, gold_flight ? "FLIGHT" : "", text_color=color.yellow, text_size=size.tiny)

    table.cell(tbl, 0, 4, "VIX | DXY", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 4, str.tostring(vix_chg, "#.#") + "% | " + str.tostring(dxy_chg, "#.##") + "%", text_color=vix_chg > t_vix ? color.red : color.gray, text_size=size.tiny)
    table.cell(tbl, 2, 4, str.tostring(s_vix, "#.#") + " | " + str.tostring(s_dxy, "#.#"), text_color=s_vix < 0.0 ? color.red : color.gray, text_size=size.tiny)
    table.cell(tbl, 3, 4, "", text_size=size.tiny)

    // Asia section
    table.cell(tbl, 0, 5, "-- 1. ASIA --", text_color=#ffcc44, text_size=size.tiny, bgcolor=color.new(#12122a, 0), text_halign=text.align_left)
    table.cell(tbl, 1, 5, str.tostring(asia_drops) + "/4 drop", text_color=asia_drops >= 3 ? color.red : color.gray, text_size=size.tiny, bgcolor=color.new(#12122a, 0))
    table.cell(tbl, 2, 5, "Avg:" + str.tostring(asia_avg, "#.##") + "%", text_color=cell_color(asia_avg, t_asia, false), text_size=size.tiny, bgcolor=color.new(#12122a, 0))
    table.cell(tbl, 3, 5, str.tostring(s_asia, "#.##"), text_color=s_asia < 0.0 ? color.red : color.green, text_size=size.tiny, bgcolor=color.new(#12122a, 0))

    table.cell(tbl, 0, 6, "  JP Nikkei", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 6, str.tostring(nik_chg, "#.##") + "%", text_color=cell_color(nik_chg, t_asia, false), text_size=size.tiny)
    table.cell(tbl, 0, 7, "  HK HSI | CN SSE", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 7, str.tostring(hsi_chg, "#.#") + "% | " + str.tostring(sha_chg, "#.#") + "%", text_color=cell_color((hsi_chg + sha_chg) / 2.0, t_asia, false), text_size=size.tiny)
    table.cell(tbl, 0, 8, "  AU ASX 200", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 8, str.tostring(asx_chg, "#.##") + "%", text_color=cell_color(asx_chg, t_asia, false), text_size=size.tiny)

    // MENA Prediction
    p1c = forecast_color(pred_mena)
    table.cell(tbl, 0, 9, "  >> MENA FORECAST", text_color=color.white, text_size=size.small, bgcolor=color.new(p1c, 60), text_halign=text.align_left)
    table.cell(tbl, 1, 9, str.tostring(pred_mena, "#.#"), text_color=p1c, text_size=size.small, bgcolor=color.new(p1c, 60))
    table.cell(tbl, 2, 9, forecast_text(pred_mena), text_color=p1c, text_size=size.small, bgcolor=color.new(p1c, 60))
    table.cell(tbl, 3, 9, "", bgcolor=color.new(p1c, 60))

    // MENA section
    table.cell(tbl, 0, 10, "-- 2. MENA/GULF --", text_color=#44ddaa, text_size=size.tiny, bgcolor=color.new(#12122a, 0), text_halign=text.align_left)
    table.cell(tbl, 1, 10, str.tostring(mena_drops) + "/3 drop", text_color=mena_drops >= 2 ? color.red : color.gray, text_size=size.tiny, bgcolor=color.new(#12122a, 0))
    table.cell(tbl, 2, 10, "Avg:" + str.tostring(mena_avg, "#.##") + "%", text_color=cell_color(mena_avg, t_mena, false), text_size=size.tiny, bgcolor=color.new(#12122a, 0))
    table.cell(tbl, 3, 10, str.tostring(s_mena, "#.##"), text_color=s_mena < 0.0 ? color.red : color.green, text_size=size.tiny, bgcolor=color.new(#12122a, 0))

    table.cell(tbl, 0, 11, "  SA TASI", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 11, str.tostring(tasi_chg, "#.##") + "%", text_color=cell_color(tasi_chg, t_mena, false), text_size=size.tiny)
    table.cell(tbl, 0, 12, "  EG EGX30 | AE DFM", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 12, str.tostring(egx_chg, "#.#") + "% | " + str.tostring(dfm_chg, "#.#") + "%", text_color=cell_color((egx_chg + dfm_chg) / 2.0, t_mena, false), text_size=size.tiny)

    // Europe Prediction
    p2c = forecast_color(pred_eur)
    table.cell(tbl, 0, 13, "  >> EUROPE FORECAST", text_color=color.white, text_size=size.small, bgcolor=color.new(p2c, 60), text_halign=text.align_left)
    table.cell(tbl, 1, 13, str.tostring(pred_eur, "#.#"), text_color=p2c, text_size=size.small, bgcolor=color.new(p2c, 60))
    table.cell(tbl, 2, 13, forecast_text(pred_eur), text_color=p2c, text_size=size.small, bgcolor=color.new(p2c, 60))
    table.cell(tbl, 3, 13, "", bgcolor=color.new(p2c, 60))

    // Europe section
    table.cell(tbl, 0, 14, "-- 3. EUROPE --", text_color=#4488ff, text_size=size.tiny, bgcolor=color.new(#12122a, 0), text_halign=text.align_left)
    table.cell(tbl, 1, 14, str.tostring(eur_drops) + "/4 drop", text_color=eur_drops >= 3 ? color.red : color.gray, text_size=size.tiny, bgcolor=color.new(#12122a, 0))
    table.cell(tbl, 2, 14, "Avg:" + str.tostring(eur_avg, "#.##") + "%", text_color=cell_color(eur_avg, t_eur, false), text_size=size.tiny, bgcolor=color.new(#12122a, 0))
    table.cell(tbl, 3, 14, str.tostring(s_eur, "#.##"), text_color=s_eur < 0.0 ? color.red : color.green, text_size=size.tiny, bgcolor=color.new(#12122a, 0))

    table.cell(tbl, 0, 15, "  DE DAX | GB FTSE | FR CAC", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 15, str.tostring(dax_chg, "#.#") + " | " + str.tostring(ftse_chg, "#.#") + " | " + str.tostring(cac_chg, "#.#"), text_color=cell_color(eur_avg, t_eur, false), text_size=size.tiny)

    // US Prediction (main)
    p3c = forecast_color(pred_us)
    table.cell(tbl, 0, 16, "  >> US OPEN FORECAST", text_color=color.white, text_size=size.normal, bgcolor=color.new(p3c, 40), text_halign=text.align_left)
    table.cell(tbl, 1, 16, str.tostring(pred_us, "#.#") + " / 10", text_color=color.white, text_size=size.normal, bgcolor=color.new(p3c, 40))
    table.cell(tbl, 2, 16, forecast_text(pred_us), text_color=color.white, text_size=size.normal, bgcolor=color.new(p3c, 40))
    table.cell(tbl, 3, 16, "", bgcolor=color.new(p3c, 40))

    // US Futures row
    table.cell(tbl, 0, 17, "US Futures (ES/NQ/YM)", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 17, str.tostring(fut_avg, "#.##") + "%", text_color=cell_color(fut_avg, t_fut, false), text_size=size.tiny)
    table.cell(tbl, 2, 17, str.tostring(s_fut, "#.##"), text_color=s_fut < 0.0 ? color.red : color.green, text_size=size.tiny)
    table.cell(tbl, 3, 17, "", text_size=size.tiny)

// ============================================================
//  ALERTS
// ============================================================

alertcondition(pred_us <= alert_severe and all_negative, title="Global Contagion", message="GLOBAL CONTAGION - All regions cascading negative. Hard sell-off expected.")
alertcondition(pred_us <= alert_warn and pred_us > alert_severe, title="US Gap Down Warning", message="US OPEN GAP DOWN WARNING - Cascade building negative momentum.")
alertcondition(pred_mena <= alert_warn and asia_drops >= 3, title="MENA Weak Open", message="MENA OPEN WARNING - Asia closed weak. Expect soft TASI/EGX.")
alertcondition(recovery, title="Recovery", message="CASCADE CLEARING - All prediction stages positive. Stress subsiding.")
