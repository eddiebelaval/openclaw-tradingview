//@version=6
indicator("Flux AlgoSpike V6", overlay=true, max_labels_count=500, dynamic_requests=true)

// -------------------- Settings: Mode
grpMode = "Quick Setup"
settingsMode = input.string("Simple", "Settings Mode", options=["Simple", "Advanced"], group=grpMode, tooltip="Simple keeps the most-used controls active. Advanced unlocks all tuning controls.")
settingsAdvanced = settingsMode == "Advanced"

// -------------------- Settings: Signal Filters
grpFilters = "Signal Filters"
newsGuard = input.bool(false, "Pause All Signals", group=grpFilters, tooltip="Manual kill switch. Blocks all chart marks and alert events.")
cooldownBars = input.int(5, "Cooldown After Signal (Bars)", minval=0, group=grpFilters, tooltip="After any emitted mark, suppress new marks for this many bars.")

// -------------------- Settings: Pattern Model
grpPattern = "Pattern Model"
atrLen = input.int(14, "ATR Length", minval=1, group=grpPattern, tooltip="ATR smoothing length used for range-normalized pattern checks.")
atrMult = input.float(1.4, "Momentum Range Multiplier (TR > ATR x)", step=0.1, group=grpPattern, tooltip="Momentum needs TR > ATR x this multiplier. Higher is stricter.")
useVolRegimeFilter = input.bool(true, "Use ATR/VIX Regime Filter", group=grpPattern, tooltip="When enabled, high-volatility regimes raise thresholds to reduce turbulence-driven false positives.")
vixSymbol = input.symbol("CBOE:VIX", "VIX Symbol", group=grpPattern, tooltip="Volatility index used for regime checks. If unavailable, ATR percentile still works.", active=settingsAdvanced)
vixHighThreshold = input.float(22.0, "VIX High Threshold", step=0.5, group=grpPattern, tooltip="If VIX is at or above this level, stricter filtering is applied.", active=settingsAdvanced)
vixShockThresholdPct = input.float(8.0, "VIX Shock Threshold (% vs prior day)", step=0.5, group=grpPattern, tooltip="If daily VIX change is at or above this percent, stricter filtering is applied.", active=settingsAdvanced)
atrRegimeLookback = input.int(200, "ATR Percentile Lookback", minval=50, group=grpPattern, tooltip="Lookback for ATR percentile ranking used in volatility regime detection.", active=settingsAdvanced)
atrHighPercentile = input.float(80.0, "ATR High Percentile Trigger", minval=50.0, maxval=99.0, step=1.0, group=grpPattern, tooltip="If ATR percentile is at or above this value, stricter filtering is applied.", active=settingsAdvanced)
regimeZBump = input.float(0.35, "Regime Z Threshold Add", step=0.05, group=grpPattern, tooltip="Added to elevated/institutional z thresholds during high-volatility regime.", active=settingsAdvanced)
regimeScoreBump = input.float(0.5, "Regime Min Score Add", step=0.1, group=grpPattern, tooltip="Added to the minimum pattern score during high-volatility regime.", active=settingsAdvanced)

// -------------------- Settings: Economic Context (Backup Layer)
grpEcon = "Advanced: Economic Context"
useEconomicContext = input.bool(false, "Use Economic Context Layer", group=grpEcon, tooltip="Optional backup context from request.economic() series. Affects regime strictness only.", active=settingsAdvanced)
econUnrateLevel = input.float(4.5, "US Unemployment Caution Level", step=0.1, group=grpEcon, tooltip="If UR (US unemployment rate) is at/above this level, context regime is considered cautious.", active=settingsAdvanced)
econUnrateMoMJump = input.float(0.2, "US Unemployment MoM Jump Trigger", step=0.1, group=grpEcon, tooltip="If UR monthly change is at/above this value, context regime is considered cautious.", active=settingsAdvanced)
econZBump = input.float(0.2, "Economic Regime Z Add", step=0.05, group=grpEcon, tooltip="Added to z-threshold gates when economic caution regime is active.", active=settingsAdvanced)
econScoreBump = input.float(0.3, "Economic Regime Score Add", step=0.1, group=grpEcon, tooltip="Added to min pattern score when economic caution regime is active.", active=settingsAdvanced)

// -------------------- Settings: High-Impact Releases (News Row)
grpImpact = "High-Impact Releases (News Row)"
useHighImpactActivity = input.bool(true, "Show High-Impact Releases In News Row", group=grpImpact, tooltip="Flags release bars from request.economic() in the News row. This is release-detection context, not a forward calendar.")
impactHoldBars = input.int(3, "Release Highlight Hold (Bars)", minval=0, maxval=240, group=grpImpact, tooltip="Keep release context active for this many bars after a detected update.", active=settingsAdvanced)
trackImpactAHE = input.bool(true, "Track Average Hourly Earnings", group=grpImpact, active=settingsAdvanced)
trackImpactCoreCPI = input.bool(true, "Track Core CPI", group=grpImpact, active=settingsAdvanced)
trackImpactCorePCE = input.bool(true, "Track Core PCE", group=grpImpact, active=settingsAdvanced)
trackImpactCoreRetail = input.bool(true, "Track Core Retail Sales", group=grpImpact, tooltip="Uses Retail Sales Excluding Autos as the closest TradingView economic series.", active=settingsAdvanced)
trackImpactCPI = input.bool(true, "Track CPI", group=grpImpact, active=settingsAdvanced)
trackImpactPCE = input.bool(true, "Track PCE", group=grpImpact, active=settingsAdvanced)
trackImpactPPI = input.bool(true, "Track PPI", group=grpImpact, active=settingsAdvanced)
trackImpactNFP = input.bool(true, "Track NFP", group=grpImpact, active=settingsAdvanced)
trackImpactClaims = input.bool(true, "Track Initial Jobless Claims", group=grpImpact, active=settingsAdvanced)
trackImpactADP = input.bool(true, "Track ADP Employment Change", group=grpImpact, active=settingsAdvanced)
trackImpactRetailSales = input.bool(true, "Track Retail Sales", group=grpImpact, active=settingsAdvanced)
trackImpactUnemployment = input.bool(true, "Track Unemployment Rate", group=grpImpact, active=settingsAdvanced)
trackImpactCCI = input.bool(true, "Track CCI", group=grpImpact, active=settingsAdvanced)
trackImpactFOMCProxy = input.bool(true, "Track FOMC Proxy (US INTR)", group=grpImpact, tooltip="FOMC proxy uses US Interest Rate (INTR) updates via request.economic().", active=settingsAdvanced)

// -------------------- Settings: MTF Gate
grpMTF = "MTF Gate"
requireMTF = input.bool(false, "Force HTF Confirmation Gate", group=grpMTF, tooltip="Always enforces HTF pass as a hard signal gate, regardless of Advanced Mode.")
higherTF_override = input.string("60", "HTF Override (e.g. 60,120,240,1D)", group=grpMTF, tooltip="Default is 60 minutes. If blank, 60 is used. If not higher than chart timeframe, script auto-raises to the next higher timeframe.", active=settingsAdvanced)
zThreshHTF = input.float(0.8, "HTF Gate Threshold (Z >)", step=0.1, group=grpMTF, tooltip="HTF passes when confirmed HTF z is greater than this threshold.", active=settingsAdvanced)

// -------------------- Settings: Relative Activity
grpRel = "Advanced: Relative Activity"
useRelativeActivity = input.bool(false, "Use Relative Activity vs Benchmark", group=grpRel, tooltip="Uses symbol z minus benchmark z to isolate symbol-specific activity.", active=settingsAdvanced)
benchmarkSymbol = input.symbol("AMEX:SPY", "Benchmark Symbol", group=grpRel, tooltip="Reference symbol used when Relative Activity mode is ON.", active=settingsAdvanced)
relativeZOffset = input.float(0.0, "Relative Z Offset", step=0.1, group=grpRel, tooltip="Extra strictness in relative mode. Positive values require stronger relative activity.", active=settingsAdvanced)

// -------------------- Settings: Session Context
grpSession = "Advanced: Session Context"
sessionModel = input.string("Futures (24h)", "Session Model", options=["Futures (24h)", "Auto (Exchange Session)"], group=grpSession, tooltip="Session phase model for non-futures symbols. Futures symbols always use the Futures (24h) phase map.", active=settingsAdvanced)
futSessionStartHour = input.int(18, "Futures Session Start Hour (NY)", minval=0, maxval=23, group=grpSession, tooltip="NY-time hour when the futures trading day starts.", active=settingsAdvanced)
futSessionStartMin = input.int(0, "Futures Session Start Minute (NY)", minval=0, maxval=59, group=grpSession, tooltip="NY-time minute when the futures trading day starts.", active=settingsAdvanced)
tokyoOpenHour = input.int(21, "Tokyo Session Hour (NY)", minval=0, maxval=23, group=grpSession, tooltip="Hour marker for Tokyo phase start in the futures footprint map.", active=settingsAdvanced)
tokyoOpenMin = input.int(0, "Tokyo Session Minute (NY)", minval=0, maxval=59, group=grpSession, tooltip="Minute marker for Tokyo phase start in the futures footprint map.", active=settingsAdvanced)
preLondonHour = input.int(2, "PreLondon Hour (NY)", minval=0, maxval=23, group=grpSession, tooltip="Hour marker for PreLondon phase start in the futures footprint map.", active=settingsAdvanced)
preLondonMin = input.int(0, "PreLondon Minute (NY)", minval=0, maxval=59, group=grpSession, tooltip="Minute marker for PreLondon phase start in the futures footprint map.", active=settingsAdvanced)
londonOpenHour = input.int(3, "London Session Hour (NY)", minval=0, maxval=23, group=grpSession, tooltip="Hour marker for London phase start in the futures phase map.", active=settingsAdvanced)
londonOpenMin = input.int(0, "London Session Minute (NY)", minval=0, maxval=59, group=grpSession, tooltip="Minute marker for London phase start in the futures phase map.", active=settingsAdvanced)
usOpenHour = input.int(8, "NY Open Hour", minval=0, maxval=23, group=grpSession, tooltip="Hour marker for NY Open phase start in the futures phase map.", active=settingsAdvanced)
usOpenMin = input.int(30, "NY Open Minute", minval=0, maxval=59, group=grpSession, tooltip="Minute marker for NY Open phase start in the futures phase map.", active=settingsAdvanced)
usMiddayHour = input.int(11, "NY Midday Hour", minval=0, maxval=23, group=grpSession, tooltip="Hour marker for NY Midday phase start in the futures phase map.", active=settingsAdvanced)
usMiddayMin = input.int(0, "NY Midday Minute", minval=0, maxval=59, group=grpSession, tooltip="Minute marker for NY Midday phase start in the futures phase map.", active=settingsAdvanced)
usClosePhaseHour = input.int(13, "NY Close Phase Hour", minval=0, maxval=23, group=grpSession, tooltip="Hour marker for NY Close phase start in the futures phase map.", active=settingsAdvanced)
usClosePhaseMin = input.int(30, "NY Close Phase Minute", minval=0, maxval=59, group=grpSession, tooltip="Minute marker for NY Close phase start in the futures phase map.", active=settingsAdvanced)
futSessionEndHour = input.int(17, "Futures Session End Hour (NY)", minval=0, maxval=23, group=grpSession, tooltip="NY-time hour when the futures session ends before maintenance.", active=settingsAdvanced)
futSessionEndMin = input.int(0, "Futures Session End Minute (NY)", minval=0, maxval=59, group=grpSession, tooltip="NY-time minute when the futures session ends before maintenance.", active=settingsAdvanced)

// -------------------- Settings: Footprint (Futures)
grpFootprint = "Footprint (Futures)"
useFootprintContext = input.bool(true, "Enable Footprint", group=grpFootprint, tooltip="Turns ON the futures footprint module in the dashboard and signal gating.")
footprintGateMode = input.string("Soft", "Signal Filter Mode", options=["Soft", "Hard"], group=grpFootprint, tooltip="Soft = reduce confidence on mismatch. Hard = block directional signals on mismatch.", active=settingsAdvanced and useFootprintContext)
fpProfile = input.string("Manual", "Instrument Preset", options=["Manual", "ES", "NQ", "Generic Futures", "GC", "CL", "YM"], group=grpFootprint, tooltip="Quick preset for ES/NQ/GC/CL/YM. Choose Manual to use custom values below.")
fpRowsPerFootprint = input.int(100, "Footprint Detail (Ticks/Row)", minval=10, group=grpFootprint, tooltip="Smaller row size = more detailed footprint rows.", active=settingsAdvanced and useFootprintContext)
fpValueAreaPct = input.int(70, "Value Area (%)", minval=50, maxval=99, group=grpFootprint, tooltip="Value-area parameter used by request.footprint().", active=settingsAdvanced and useFootprintContext)
fpDeltaPctThreshold = input.float(0.08, "Bias Threshold (0.08 = 8%)", minval=0.01, maxval=0.50, step=0.01, group=grpFootprint, tooltip="Bull if session delta/volume is above +threshold. Bear if below -threshold.", active=settingsAdvanced and useFootprintContext)
fpMinSessionVol = input.float(120000, "Base Min Session Volume", minval=0, step=1000, group=grpFootprint, tooltip="Base volume threshold used by Footprint. In Adaptive mode, this scales by session length.", active=settingsAdvanced and useFootprintContext)
fpVolumeCheckMode = input.string("Adaptive", "Volume Check Mode", options=["Adaptive", "Fixed"], group=grpFootprint, tooltip="Adaptive scales volume threshold by session length. Fixed uses the base threshold directly.", active=settingsAdvanced and useFootprintContext)
fpBreakoutBufferTicks = input.int(2, "Breakout Buffer (Ticks)", minval=0, group=grpFootprint, tooltip="Buffer added beyond session high/low for breakout confirmation state.", active=settingsAdvanced and useFootprintContext)
fpConfirmBars = input.int(2, "Confirm Bars", minval=1, maxval=3, group=grpFootprint, tooltip="Consecutive bars required for breakout confirmation.", active=settingsAdvanced and useFootprintContext)
fpDeltaConfirm = input.float(500, "Delta Confirm (Per Bar)", minval=0, step=50, group=grpFootprint, tooltip="Per-bar footprint delta threshold used in breakout confirmation.", active=settingsAdvanced and useFootprintContext)
fpMinBarsWithData = input.int(3, "Min Bars With Footprint", minval=1, maxval=500, group=grpFootprint, tooltip="Minimum bars in a session that must include footprint data.", active=settingsAdvanced and useFootprintContext)
fpRegimeFilter = input.string("VWAP", "Trend Filter", options=["VWAP", "EMA200"], group=grpFootprint, tooltip="Directional filter used before breakout confirmation.", active=settingsAdvanced and useFootprintContext)
fpOneSignalPerSide = input.bool(true, "One Signal Per Direction", group=grpFootprint, tooltip="Prevents repeated same-side breakout signals until next completed session context.", active=settingsAdvanced and useFootprintContext)
fpSoftPenaltyPct = input.float(8.0, "Soft Penalty (%)", minval=0.0, maxval=50.0, step=0.5, group=grpFootprint, tooltip="Confidence penalty applied in Soft mode during bias mismatch.", active=settingsAdvanced and useFootprintContext)
allowAbsorptionAgainstBias = input.bool(true, "Allow Absorption Against Bias", group=grpFootprint, tooltip="If ON, absorption marks are not hard-blocked by footprint mismatch.", active=settingsAdvanced and useFootprintContext)

// -------------------- Settings: Dashboard Layout
grpDisplay = "Dashboard Layout"
showDashboard = input.bool(true, "Show Dashboard", group=grpDisplay, tooltip="Shows the 2-column activity dashboard.")
showIconBanner = input.bool(true, "Show Bottom Icon Banner", group=grpDisplay, tooltip="Shows an icon legend banner on the chart.")
dashboardPosition = input.string("Top Right", "Dashboard Location", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=grpDisplay, tooltip="Move dashboard to any chart corner/side.")
dashboardTextSize = input.string("Normal", "Dashboard Text Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=grpDisplay, tooltip="Text size used for all dashboard rows.", active=settingsAdvanced)
bannerPosition = input.string("Bottom Center", "Icon Banner Location", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=grpDisplay, tooltip="Move the icon banner.", active=settingsAdvanced and showIconBanner)
bannerTextSize = input.string("Small", "Banner Text Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=grpDisplay, tooltip="Text size used for the icon banner.", active=settingsAdvanced and showIconBanner)

// -------------------- Fixed Internal Defaults (inputs intentionally removed)
zscore_period = 50
normal_threshold = 1.0
elevated_threshold = 2.0
institutional_threshold = 3.0
allowLowVolumeAnomaly = false
use_adaptive = true
smallBodyP = 0.33
useDollarVolume = false
contractMultiplier = 1.0
openPhaseFrac = 0.25
closePhaseFrac = 0.75
sessionLenEma = 20
minScore = 3.0
confidenceSmoothLen = 5
fpReadMinDeltaPct = 0.01

// -------------------- Stats & Z-Score
atr_current = ta.atr(atrLen)
atr_avg = ta.sma(atr_current, 20)
ma20 = ta.sma(close, 20)
ma_slope = (ma20 - ma20[5]) / ta.atr(10) * 100
is_trending = math.abs(ma_slope) > 0.5
is_high_vol = atr_current > atr_avg * 1.2

adaptive_multiplier = use_adaptive ? ((is_trending ? 1.3 : 0.8) * (is_high_vol ? 1.2 : 1.0)) : 1.0
current_normal = normal_threshold * adaptive_multiplier
current_elevated = elevated_threshold * adaptive_multiplier
current_institutional = institutional_threshold * adaptive_multiplier

// Internal volatility regime: tightens activity filters during broad market stress.
vixDaily = request.security(vixSymbol, "D", close, barmerge.gaps_off, barmerge.lookahead_off)
vixDailyPrev = vixDaily[1]
vixDailyChgPct = not na(vixDailyPrev) and vixDailyPrev != 0 ? ((vixDaily - vixDailyPrev) / vixDailyPrev) * 100.0 : 0.0
atrPctRankRaw = ta.percentrank(atr_current, atrRegimeLookback)
atrPctRank = nz(atrPctRankRaw, 0.0)
atrHighRegime = atrPctRank >= atrHighPercentile
vixHighRegime = not na(vixDaily) and vixDaily >= vixHighThreshold
vixShockRegime = not na(vixDaily) and vixDailyChgPct >= vixShockThresholdPct
volRegimeActive = useVolRegimeFilter and (atrHighRegime or vixHighRegime or vixShockRegime)

// Optional macro-economic context backup (series-level context only; not event timing).
usUnrate = request.economic("US", "UR")
usUnratePrev = usUnrate[1]
usUnrateMoMDelta = not na(usUnrate) and not na(usUnratePrev) ? (usUnrate - usUnratePrev) : 0.0
econRegimeByLevel = not na(usUnrate) and usUnrate >= econUnrateLevel
econRegimeByJump = not na(usUnrate) and usUnrateMoMDelta >= econUnrateMoMJump
econRegimeActive = useEconomicContext and (econRegimeByLevel or econRegimeByJump)

f_recent_release(lastBar, holdBars) =>
    not na(lastBar) and (bar_index - lastBar) <= holdBars

f_pad2(v) =>
    v < 10 ? "0" + str.tostring(v) : str.tostring(v)

f_time_ny(ts) =>
    hh = hour(ts, "America/New_York")
    mm = minute(ts, "America/New_York")
    f_pad2(hh) + ":" + f_pad2(mm) + " NY"

// High-impact release detection using gaps_on. Non-na values mark update bars.
impactAheRaw = request.economic("US", "AHE", barmerge.gaps_on, true)
impactCoreCpiRaw = request.economic("US", "CCPI", barmerge.gaps_on, true)
impactCorePceRaw = request.economic("US", "CPCEPI", barmerge.gaps_on, true)
impactCoreRetailRaw = request.economic("US", "RSEA", barmerge.gaps_on, true)
impactCpiRaw = request.economic("US", "CPI", barmerge.gaps_on, true)
impactPceRaw = request.economic("US", "PCEPI", barmerge.gaps_on, true)
impactPpiRaw = request.economic("US", "PPI", barmerge.gaps_on, true)
impactNfpRaw = request.economic("US", "NFP", barmerge.gaps_on, true)
impactClaimsRaw = request.economic("US", "IJC", barmerge.gaps_on, true)
impactAdpRaw = request.economic("US", "EC", barmerge.gaps_on, true)
impactRetailSalesRaw = request.economic("US", "RSMM", barmerge.gaps_on, true)
impactUnrateRaw = request.economic("US", "UR", barmerge.gaps_on, true)
impactCciRaw = request.economic("US", "CCI", barmerge.gaps_on, true)
impactFomcProxyRaw = request.economic("US", "INTR", barmerge.gaps_on, true)

impactAheNow = useHighImpactActivity and trackImpactAHE and not na(impactAheRaw)
impactCoreCpiNow = useHighImpactActivity and trackImpactCoreCPI and not na(impactCoreCpiRaw)
impactCorePceNow = useHighImpactActivity and trackImpactCorePCE and not na(impactCorePceRaw)
impactCoreRetailNow = useHighImpactActivity and trackImpactCoreRetail and not na(impactCoreRetailRaw)
impactCpiNow = useHighImpactActivity and trackImpactCPI and not na(impactCpiRaw)
impactPceNow = useHighImpactActivity and trackImpactPCE and not na(impactPceRaw)
impactPpiNow = useHighImpactActivity and trackImpactPPI and not na(impactPpiRaw)
impactNfpNow = useHighImpactActivity and trackImpactNFP and not na(impactNfpRaw)
impactClaimsNow = useHighImpactActivity and trackImpactClaims and not na(impactClaimsRaw)
impactAdpNow = useHighImpactActivity and trackImpactADP and not na(impactAdpRaw)
impactRetailSalesNow = useHighImpactActivity and trackImpactRetailSales and not na(impactRetailSalesRaw)
impactUnrateNow = useHighImpactActivity and trackImpactUnemployment and not na(impactUnrateRaw)
impactCciNow = useHighImpactActivity and trackImpactCCI and not na(impactCciRaw)
impactFomcProxyNow = useHighImpactActivity and trackImpactFOMCProxy and not na(impactFomcProxyRaw)

var int lastImpactAheBar = na
var int lastImpactCoreCpiBar = na
var int lastImpactCorePceBar = na
var int lastImpactCoreRetailBar = na
var int lastImpactCpiBar = na
var int lastImpactPceBar = na
var int lastImpactPpiBar = na
var int lastImpactNfpBar = na
var int lastImpactClaimsBar = na
var int lastImpactAdpBar = na
var int lastImpactRetailSalesBar = na
var int lastImpactUnrateBar = na
var int lastImpactCciBar = na
var int lastImpactFomcProxyBar = na
var int lastImpactAheTs = na
var int lastImpactCoreCpiTs = na
var int lastImpactCorePceTs = na
var int lastImpactCoreRetailTs = na
var int lastImpactCpiTs = na
var int lastImpactPceTs = na
var int lastImpactPpiTs = na
var int lastImpactNfpTs = na
var int lastImpactClaimsTs = na
var int lastImpactAdpTs = na
var int lastImpactRetailSalesTs = na
var int lastImpactUnrateTs = na
var int lastImpactCciTs = na
var int lastImpactFomcProxyTs = na

if impactAheNow
    lastImpactAheBar := bar_index
    lastImpactAheTs := time
if impactCoreCpiNow
    lastImpactCoreCpiBar := bar_index
    lastImpactCoreCpiTs := time
if impactCorePceNow
    lastImpactCorePceBar := bar_index
    lastImpactCorePceTs := time
if impactCoreRetailNow
    lastImpactCoreRetailBar := bar_index
    lastImpactCoreRetailTs := time
if impactCpiNow
    lastImpactCpiBar := bar_index
    lastImpactCpiTs := time
if impactPceNow
    lastImpactPceBar := bar_index
    lastImpactPceTs := time
if impactPpiNow
    lastImpactPpiBar := bar_index
    lastImpactPpiTs := time
if impactNfpNow
    lastImpactNfpBar := bar_index
    lastImpactNfpTs := time
if impactClaimsNow
    lastImpactClaimsBar := bar_index
    lastImpactClaimsTs := time
if impactAdpNow
    lastImpactAdpBar := bar_index
    lastImpactAdpTs := time
if impactRetailSalesNow
    lastImpactRetailSalesBar := bar_index
    lastImpactRetailSalesTs := time
if impactUnrateNow
    lastImpactUnrateBar := bar_index
    lastImpactUnrateTs := time
if impactCciNow
    lastImpactCciBar := bar_index
    lastImpactCciTs := time
if impactFomcProxyNow
    lastImpactFomcProxyBar := bar_index
    lastImpactFomcProxyTs := time

impactAheRecent = useHighImpactActivity and trackImpactAHE and f_recent_release(lastImpactAheBar, impactHoldBars)
impactCoreCpiRecent = useHighImpactActivity and trackImpactCoreCPI and f_recent_release(lastImpactCoreCpiBar, impactHoldBars)
impactCorePceRecent = useHighImpactActivity and trackImpactCorePCE and f_recent_release(lastImpactCorePceBar, impactHoldBars)
impactCoreRetailRecent = useHighImpactActivity and trackImpactCoreRetail and f_recent_release(lastImpactCoreRetailBar, impactHoldBars)
impactCpiRecent = useHighImpactActivity and trackImpactCPI and f_recent_release(lastImpactCpiBar, impactHoldBars)
impactPceRecent = useHighImpactActivity and trackImpactPCE and f_recent_release(lastImpactPceBar, impactHoldBars)
impactPpiRecent = useHighImpactActivity and trackImpactPPI and f_recent_release(lastImpactPpiBar, impactHoldBars)
impactNfpRecent = useHighImpactActivity and trackImpactNFP and f_recent_release(lastImpactNfpBar, impactHoldBars)
impactClaimsRecent = useHighImpactActivity and trackImpactClaims and f_recent_release(lastImpactClaimsBar, impactHoldBars)
impactAdpRecent = useHighImpactActivity and trackImpactADP and f_recent_release(lastImpactAdpBar, impactHoldBars)
impactRetailSalesRecent = useHighImpactActivity and trackImpactRetailSales and f_recent_release(lastImpactRetailSalesBar, impactHoldBars)
impactUnrateRecent = useHighImpactActivity and trackImpactUnemployment and f_recent_release(lastImpactUnrateBar, impactHoldBars)
impactCciRecent = useHighImpactActivity and trackImpactCCI and f_recent_release(lastImpactCciBar, impactHoldBars)
impactFomcProxyRecent = useHighImpactActivity and trackImpactFOMCProxy and f_recent_release(lastImpactFomcProxyBar, impactHoldBars)

highImpactNow = impactFomcProxyNow or impactAheNow or impactCoreCpiNow or impactCorePceNow or impactCoreRetailNow or impactCpiNow or impactPceNow or impactPpiNow or impactNfpNow or impactClaimsNow or impactAdpNow or impactRetailSalesNow or impactUnrateNow or impactCciNow
highImpactRecent = impactFomcProxyRecent or impactAheRecent or impactCoreCpiRecent or impactCorePceRecent or impactCoreRetailRecent or impactCpiRecent or impactPceRecent or impactPpiRecent or impactNfpRecent or impactClaimsRecent or impactAdpRecent or impactRetailSalesRecent or impactUnrateRecent or impactCciRecent

highImpactLabel = "None"
if impactFomcProxyNow or (not highImpactNow and impactFomcProxyRecent)
    highImpactLabel := "FOMC*"
else if impactCoreCpiNow or (not highImpactNow and impactCoreCpiRecent)
    highImpactLabel := "Core CPI"
else if impactCpiNow or (not highImpactNow and impactCpiRecent)
    highImpactLabel := "CPI"
else if impactNfpNow or (not highImpactNow and impactNfpRecent)
    highImpactLabel := "NFP"
else if impactUnrateNow or (not highImpactNow and impactUnrateRecent)
    highImpactLabel := "Unemployment"
else if impactAheNow or (not highImpactNow and impactAheRecent)
    highImpactLabel := "Avg Earnings"
else if impactCorePceNow or (not highImpactNow and impactCorePceRecent)
    highImpactLabel := "Core PCE"
else if impactPceNow or (not highImpactNow and impactPceRecent)
    highImpactLabel := "PCE"
else if impactRetailSalesNow or (not highImpactNow and impactRetailSalesRecent)
    highImpactLabel := "Retail Sales"
else if impactCoreRetailNow or (not highImpactNow and impactCoreRetailRecent)
    highImpactLabel := "Core Retail"
else if impactPpiNow or (not highImpactNow and impactPpiRecent)
    highImpactLabel := "PPI"
else if impactClaimsNow or (not highImpactNow and impactClaimsRecent)
    highImpactLabel := "Jobless Claims"
else if impactAdpNow or (not highImpactNow and impactAdpRecent)
    highImpactLabel := "ADP"
else if impactCciNow or (not highImpactNow and impactCciRecent)
    highImpactLabel := "CCI"
int activeImpactBar = na
int activeImpactTs = na
if highImpactLabel == "FOMC*"
    activeImpactBar := lastImpactFomcProxyBar
    activeImpactTs := lastImpactFomcProxyTs
else if highImpactLabel == "NFP"
    activeImpactBar := lastImpactNfpBar
    activeImpactTs := lastImpactNfpTs
else if highImpactLabel == "Unemployment"
    activeImpactBar := lastImpactUnrateBar
    activeImpactTs := lastImpactUnrateTs
else if highImpactLabel == "Avg Earnings"
    activeImpactBar := lastImpactAheBar
    activeImpactTs := lastImpactAheTs
else if highImpactLabel == "Core CPI"
    activeImpactBar := lastImpactCoreCpiBar
    activeImpactTs := lastImpactCoreCpiTs
else if highImpactLabel == "Core PCE"
    activeImpactBar := lastImpactCorePceBar
    activeImpactTs := lastImpactCorePceTs
else if highImpactLabel == "Core Retail"
    activeImpactBar := lastImpactCoreRetailBar
    activeImpactTs := lastImpactCoreRetailTs
else if highImpactLabel == "PCE"
    activeImpactBar := lastImpactPceBar
    activeImpactTs := lastImpactPceTs
else if highImpactLabel == "Retail Sales"
    activeImpactBar := lastImpactRetailSalesBar
    activeImpactTs := lastImpactRetailSalesTs
else if highImpactLabel == "CPI"
    activeImpactBar := lastImpactCpiBar
    activeImpactTs := lastImpactCpiTs
else if highImpactLabel == "PPI"
    activeImpactBar := lastImpactPpiBar
    activeImpactTs := lastImpactPpiTs
else if highImpactLabel == "Jobless Claims"
    activeImpactBar := lastImpactClaimsBar
    activeImpactTs := lastImpactClaimsTs
else if highImpactLabel == "ADP"
    activeImpactBar := lastImpactAdpBar
    activeImpactTs := lastImpactAdpTs
else if highImpactLabel == "CCI"
    activeImpactBar := lastImpactCciBar
    activeImpactTs := lastImpactCciTs
activeImpactBarsAgo = na(activeImpactBar) ? na : (bar_index - activeImpactBar)
activeImpactBarsAgoText = na(activeImpactBarsAgo) ? "?" : str.tostring(activeImpactBarsAgo)
activeImpactTimeText = na(activeImpactTs) ? "time?" : f_time_ny(activeImpactTs)

normal_gate = current_normal + (volRegimeActive ? regimeZBump * 0.5 : 0.0) + (econRegimeActive ? econZBump * 0.5 : 0.0)
elevated_gate = current_elevated + (volRegimeActive ? regimeZBump : 0.0) + (econRegimeActive ? econZBump : 0.0)
institutional_gate = current_institutional + (volRegimeActive ? regimeZBump : 0.0) + (econRegimeActive ? econZBump : 0.0)
minScoreGate = minScore + (volRegimeActive ? regimeScoreBump : 0.0) + (econRegimeActive ? econScoreBump : 0.0)

f_zscore(srcVol) =>
    m = ta.sma(srcVol, zscore_period)
    s = ta.stdev(srcVol, zscore_period)
    s > 0 ? (srcVol - m) / s : 0.0

f_benchmark_z() =>
    benchVol = useDollarVolume ? close * volume : volume
    f_zscore(benchVol)

volRaw = useDollarVolume ? close * volume * contractMultiplier : volume
zLocal = f_zscore(volRaw)
benchmarkZ = request.security(benchmarkSymbol, timeframe.period, f_benchmark_z(), barmerge.gaps_off, barmerge.lookahead_off)
relativeDataReady = not na(benchmarkZ)
usingRelativeNow = useRelativeActivity and relativeDataReady
relativeFallback = useRelativeActivity and not relativeDataReady
zRelative = zLocal - benchmarkZ
zBase = usingRelativeNow ? zRelative : zLocal
z = zBase - (usingRelativeNow ? relativeZOffset : 0.0)
zSignal = allowLowVolumeAnomaly ? math.abs(z) : z

// -------------------- Session Context
f_in_window(curMin, startMin, endMin) =>
    startMin < endMin ? (curMin >= startMin and curMin < endMin) : (curMin >= startMin or curMin < endMin)

f_fp_phase(curMin, futStartAbs, tokyoAbs, preLondonAbs, londonOpenAbs, usOpenAbs, futEndAbs) =>
    out = "Maintenance"
    if f_in_window(curMin, futStartAbs, tokyoAbs)
        out := "Asia"
    else if f_in_window(curMin, tokyoAbs, preLondonAbs)
        out := "Tokyo"
    else if f_in_window(curMin, preLondonAbs, londonOpenAbs)
        out := "PreLondon"
    else if f_in_window(curMin, londonOpenAbs, usOpenAbs)
        out := "London"
    else if f_in_window(curMin, usOpenAbs, futEndAbs)
        out := "NY"
    out

f_rel_from_anchor(ts, anchor) =>
    ts >= anchor ? (ts - anchor) : (ts + 1440 - anchor)

f_phase_span_mins(phase, futStartAbs, tokyoAbs, preLondonAbs, londonOpenAbs, usOpenAbs, futEndAbs) =>
    out = 0
    if phase == "Asia"
        out := f_rel_from_anchor(tokyoAbs, futStartAbs)
    else if phase == "Tokyo"
        out := f_rel_from_anchor(preLondonAbs, tokyoAbs)
    else if phase == "PreLondon"
        out := f_rel_from_anchor(londonOpenAbs, preLondonAbs)
    else if phase == "London"
        out := f_rel_from_anchor(usOpenAbs, londonOpenAbs)
    else if phase == "NY"
        out := f_rel_from_anchor(futEndAbs, usOpenAbs)
    out

f_phase_max_bars(phase, chartSec, futStartAbs, tokyoAbs, preLondonAbs, londonOpenAbs, usOpenAbs, futEndAbs) =>
    mins = f_phase_span_mins(phase, futStartAbs, tokyoAbs, preLondonAbs, londonOpenAbs, usOpenAbs, futEndAbs)
    barsFloat = chartSec > 0 ? math.floor((mins * 60.0) / chartSec) : 1.0
    int(math.max(1.0, barsFloat))

f_fp_layout_valid(futStartAbs, tokyoAbs, preLondonAbs, londonOpenAbs, usOpenAbs, futEndAbs) =>
    tokyoRel = f_rel_from_anchor(tokyoAbs, futStartAbs)
    preLondonRel = f_rel_from_anchor(preLondonAbs, futStartAbs)
    londonRel = f_rel_from_anchor(londonOpenAbs, futStartAbs)
    usOpenRel = f_rel_from_anchor(usOpenAbs, futStartAbs)
    futEndRel = f_rel_from_anchor(futEndAbs, futStartAbs)
    tokyoRel > 0 and preLondonRel > tokyoRel and londonRel > preLondonRel and usOpenRel > londonRel and futEndRel > usOpenRel and futEndRel < 1440

f_sum_last(src, len) =>
    float out = 0.0
    for i = 0 to len - 1
        out += nz(src[i], 0.0)
    out

f_pad_int4(v) =>
    v >= 1000 ? str.tostring(v) : v >= 100 ? " " + str.tostring(v) : v >= 10 ? "  " + str.tostring(v) : "   " + str.tostring(v)

f_fixed_1dp_4int(v) =>
    rounded10 = int(math.round(v * 10.0))
    intPart = int(math.floor(rounded10 / 10.0))
    fracPart = rounded10 - intPart * 10
    f_pad_int4(intPart) + "." + str.tostring(fracPart)

f_delta_raw_token(deltaNow) =>
    na(deltaNow) ? "δ        ?" : math.abs(deltaNow) >= 1000 ? "δ " + (deltaNow >= 0 ? "+" : "-") + f_fixed_1dp_4int(math.abs(deltaNow) / 1000.0) + "k" : "δ " + (deltaNow >= 0 ? "+" : "-") + f_pad_int4(int(math.round(math.abs(deltaNow))))

f_delta_pct_token(deltaPct) =>
    na(deltaPct) ? "Δ        ?.?%" : "Δ " + (deltaPct >= 0 ? "+" : "-") + f_fixed_1dp_4int(math.abs(deltaPct) * 100.0) + "%"

f_vol_token_k(volNow) =>
    na(volNow) ? "Vol    ?.?" : volNow >= 1000 ? "Vol " + f_fixed_1dp_4int(volNow / 1000.0) + "k" : "Vol " + f_pad_int4(int(math.round(volNow)))

f_dash_position(posText) =>
    out = position.bottom_right
    if posText == "Top Left"
        out := position.top_left
    else if posText == "Top Center"
        out := position.top_center
    else if posText == "Top Right"
        out := position.top_right
    else if posText == "Middle Left"
        out := position.middle_left
    else if posText == "Middle Center"
        out := position.middle_center
    else if posText == "Middle Right"
        out := position.middle_right
    else if posText == "Bottom Left"
        out := position.bottom_left
    else if posText == "Bottom Center"
        out := position.bottom_center
    out

f_dash_text_size(sizeText) =>
    out = size.normal
    if sizeText == "Tiny"
        out := size.tiny
    else if sizeText == "Small"
        out := size.small
    else if sizeText == "Large"
        out := size.large
    else if sizeText == "Huge"
        out := size.huge
    out

f_banner_pos_safe(dPos, bPos) =>
    out = bPos
    if bPos == dPos
        if bPos == position.top_left
            out := position.top_center
        else if bPos == position.top_center
            out := position.top_right
        else if bPos == position.top_right
            out := position.middle_right
        else if bPos == position.middle_left
            out := position.middle_center
        else if bPos == position.middle_center
            out := position.middle_right
        else if bPos == position.middle_right
            out := position.bottom_right
        else if bPos == position.bottom_left
            out := position.bottom_center
        else if bPos == position.bottom_center
            out := position.bottom_right
        else
            out := position.bottom_center
    out

curMin = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
dashPos = f_dash_position(dashboardPosition)
dashTextSize = f_dash_text_size(dashboardTextSize)
bannerPosRaw = f_dash_position(bannerPosition)
bannerPos = f_banner_pos_safe(dashPos, bannerPosRaw)
bannerSize = f_dash_text_size(bannerTextSize)
futStartAbs = futSessionStartHour * 60 + futSessionStartMin
tokyoAbs = tokyoOpenHour * 60 + tokyoOpenMin
preLondonAbs = preLondonHour * 60 + preLondonMin
londonOpenAbs = londonOpenHour * 60 + londonOpenMin
usOpenAbs = usOpenHour * 60 + usOpenMin
usMiddayAbs = usMiddayHour * 60 + usMiddayMin
usCloseAbs = usClosePhaseHour * 60 + usClosePhaseMin
futEndAbs = futSessionEndHour * 60 + futSessionEndMin
fpLayoutValid = f_fp_layout_valid(futStartAbs, tokyoAbs, preLondonAbs, londonOpenAbs, usOpenAbs, futEndAbs)
fpPhaseNow = fpLayoutValid ? f_fp_phase(curMin, futStartAbs, tokyoAbs, preLondonAbs, londonOpenAbs, usOpenAbs, futEndAbs) : "Maintenance"

futInSession = f_in_window(curMin, futStartAbs, futEndAbs)
futPhase = "Maintenance"
if futInSession
    if f_in_window(curMin, futStartAbs, londonOpenAbs)
        futPhase := "Asia"
    else if f_in_window(curMin, londonOpenAbs, usOpenAbs)
        futPhase := "London"
    else if f_in_window(curMin, usOpenAbs, usMiddayAbs)
        futPhase := "NY Open"
    else if f_in_window(curMin, usMiddayAbs, usCloseAbs)
        futPhase := "NY Midday"
    else
        futPhase := "NY Close"

inRegular = timeframe.isintraday ? session.ismarket : false
newRegular = inRegular and not inRegular[1]
endRegular = not inRegular and inRegular[1]

var int regularBars = 0
var int prevRegularBars = na
var float expectedRegularBars = na

if newRegular
    regularBars := 1
else if inRegular
    regularBars += 1
else
    regularBars := 0

if endRegular
    prevRegularBars := math.max(1, nz(regularBars[1], 1))
    alpha = 2.0 / (sessionLenEma + 1.0)
    expectedRegularBars := na(expectedRegularBars) ? prevRegularBars : expectedRegularBars + alpha * (prevRegularBars - expectedRegularBars)

barsExpected = na(expectedRegularBars) ? (na(prevRegularBars) ? math.max(1, regularBars) : prevRegularBars) : expectedRegularBars
sessionProgress = inRegular and barsExpected > 0 ? regularBars / barsExpected : na

autoPhase = timeframe.isintraday ? "Overnight" : "Non-Intraday"
if inRegular
    if sessionProgress <= openPhaseFrac
        autoPhase := "Open"
    else if sessionProgress >= closePhaseFrac
        autoPhase := "Close"
    else
        autoPhase := "Midday"

// For futures symbols, always use futures session phases for display and regime logic.
isFuturesSymbol = syminfo.type == "futures"
sessionPhase = isFuturesSymbol ? (useFootprintContext and fpLayoutValid ? fpPhaseNow : futPhase) : (sessionModel == "Futures (24h)" ? futPhase : autoPhase)

// -------------------- Footprint Context Engine (Futures)
fpModuleEnabled = useFootprintContext and isFuturesSymbol
fpModuleActive = fpModuleEnabled and fpLayoutValid
fpSessionConfigInvalid = fpModuleEnabled and not fpLayoutValid
footprint fpCtx = na
if fpModuleEnabled
    fpCtx := request.footprint(fpRowsPerFootprint, fpValueAreaPct)
fpBarDelta = not na(fpCtx) ? fpCtx.delta() : na
fpBarVol = not na(fpCtx) ? fpCtx.total_volume() : na
fpBarDeltaPct = not na(fpBarVol) and fpBarVol > 0 ? (fpBarDelta / fpBarVol) : na
// Previous footprint row always refers to the prior completed chart bar.
fpPrevDelta = fpBarDelta[1]
fpPrevVol = fpBarVol[1]
fpPrevDeltaPct = not na(fpPrevVol) and fpPrevVol > 0 ? (fpPrevDelta / fpPrevVol) : na
fpEffDeltaPctThreshold = fpProfile == "ES" ? 0.08 : fpProfile == "NQ" ? 0.10 : fpProfile == "GC" ? 0.06 : fpProfile == "CL" ? 0.06 : fpProfile == "YM" ? 0.07 : fpProfile == "Generic Futures" ? 0.07 : fpDeltaPctThreshold
fpEffMinSessionVol = fpProfile == "ES" ? 120000.0 : fpProfile == "NQ" ? 70000.0 : fpProfile == "GC" ? 25000.0 : fpProfile == "CL" ? 30000.0 : fpProfile == "YM" ? 55000.0 : fpProfile == "Generic Futures" ? 45000.0 : fpMinSessionVol
fpEffBreakoutBufferTicks = fpProfile == "ES" ? 2 : fpProfile == "NQ" ? 2 : fpProfile == "GC" ? 2 : fpProfile == "CL" ? 2 : fpProfile == "YM" ? 2 : fpProfile == "Generic Futures" ? 2 : fpBreakoutBufferTicks
fpEffConfirmBars = fpProfile == "ES" ? 2 : fpProfile == "NQ" ? 2 : fpProfile == "GC" ? 2 : fpProfile == "CL" ? 2 : fpProfile == "YM" ? 2 : fpProfile == "Generic Futures" ? 2 : fpConfirmBars
fpEffDeltaConfirm = fpProfile == "ES" ? 500.0 : fpProfile == "NQ" ? 400.0 : fpProfile == "GC" ? 120.0 : fpProfile == "CL" ? 180.0 : fpProfile == "YM" ? 280.0 : fpProfile == "Generic Futures" ? 250.0 : fpDeltaConfirm
fpBreakoutBuffer = fpEffBreakoutBufferTicks * syminfo.mintick
fpRegimeLine = fpRegimeFilter == "VWAP" ? ta.vwap(hlc3) : ta.ema(close, 200)
fpRegimeLongOk = not na(fpRegimeLine) and close > fpRegimeLine
fpRegimeShortOk = not na(fpRegimeLine) and close < fpRegimeLine

var string fpCollectSession = "Maintenance"
var bool fpCollectorActive = false
var float fpLiveHigh = na
var float fpLiveLow = na
var float fpLiveCumDelta = na
var float fpLiveTotalVol = na
var int fpLiveBarsWithFp = 0

var string fpContextSession = "None"
var float fpContextHigh = na
var float fpContextLow = na
var float fpContextDeltaPct = na
var float fpContextTotalVol = na
var int fpContextBarsWithFp = na
var int fpContextMaxBars = 1
var bool fpLongFired = false
var bool fpShortFired = false

if fpModuleActive
    if fpCollectSession != fpPhaseNow
        if fpCollectorActive and fpCollectSession != "Maintenance"
            fpContextSession := fpCollectSession
            fpContextHigh := fpLiveHigh
            fpContextLow := fpLiveLow
            fpContextTotalVol := fpLiveTotalVol
            fpContextDeltaPct := fpLiveTotalVol > 0 ? (fpLiveCumDelta / fpLiveTotalVol) : na
            fpContextBarsWithFp := fpLiveBarsWithFp
            fpContextMaxBars := f_phase_max_bars(fpCollectSession, nz(timeframe.in_seconds(), 0), futStartAbs, tokyoAbs, preLondonAbs, londonOpenAbs, usOpenAbs, futEndAbs)
            fpLongFired := false
            fpShortFired := false

        if fpPhaseNow != "Maintenance"
            fpLiveHigh := high
            fpLiveLow := low
            fpLiveCumDelta := 0.0
            fpLiveTotalVol := 0.0
            fpLiveBarsWithFp := 0
            fpCollectorActive := true
        else
            fpCollectorActive := false
        fpCollectSession := fpPhaseNow

    if fpCollectorActive and fpPhaseNow != "Maintenance"
        fpLiveHigh := math.max(nz(fpLiveHigh, high), high)
        fpLiveLow := math.min(nz(fpLiveLow, low), low)
        if not na(fpCtx)
            fpLiveCumDelta += fpCtx.delta()
            fpLiveTotalVol += fpCtx.total_volume()
            fpLiveBarsWithFp += 1
else
    fpCollectSession := "Maintenance"
    fpCollectorActive := false

fpLiveDeltaPct = not na(fpLiveTotalVol) and fpLiveTotalVol > 0 ? (fpLiveCumDelta / fpLiveTotalVol) : na

fpRequiredBars = int(math.max(1, math.min(fpMinBarsWithData, fpContextMaxBars)))
fpContextDataReady = fpModuleActive and fpContextSession != "None" and fpContextBarsWithFp >= fpRequiredBars and not na(fpContextDeltaPct)
fpContextMins = fpContextSession != "None" ? f_phase_span_mins(fpContextSession, futStartAbs, tokyoAbs, preLondonAbs, londonOpenAbs, usOpenAbs, futEndAbs) : na
fpVolScale = not na(fpContextMins) ? math.max(0.25, fpContextMins / 300.0) : 1.0
fpMinVolRequired = fpVolumeCheckMode == "Adaptive" ? (fpEffMinSessionVol * fpVolScale) : fpEffMinSessionVol
fpContextVolPass = fpModuleActive and fpContextSession != "None" and not na(fpContextTotalVol) and fpContextTotalVol >= fpMinVolRequired
fpContextBias = fpModuleActive and fpContextSession != "None" and fpContextDataReady and fpContextVolPass and not na(fpContextDeltaPct) ? (fpContextDeltaPct > fpEffDeltaPctThreshold ? "Bull" : fpContextDeltaPct < -fpEffDeltaPctThreshold ? "Bear" : "Neutral") : "Neutral"
fpContextReady = fpModuleActive and fpContextDataReady and fpContextVolPass and not na(fpContextDeltaPct)
fpBiasBull = fpContextReady and fpContextBias == "Bull"
fpBiasBear = fpContextReady and fpContextBias == "Bear"
fpDataFallback = fpModuleActive and fpContextSession != "None" and (not fpContextDataReady or not fpContextVolPass)

fpHaveLevels = fpContextReady and not na(fpContextHigh) and not na(fpContextLow)
fpUpBreakCount = f_sum_last(fpHaveLevels and close > (fpContextHigh + fpBreakoutBuffer) ? 1.0 : 0.0, fpEffConfirmBars)
fpDownBreakCount = f_sum_last(fpHaveLevels and close < (fpContextLow - fpBreakoutBuffer) ? 1.0 : 0.0, fpEffConfirmBars)
fpUpDeltaCount = f_sum_last(nz(fpBarDelta, 0) > fpEffDeltaConfirm ? 1.0 : 0.0, fpEffConfirmBars)
fpDownDeltaCount = f_sum_last(nz(fpBarDelta, 0) < -fpEffDeltaConfirm ? 1.0 : 0.0, fpEffConfirmBars)
fpLongConfirmed = fpBiasBull and fpRegimeLongOk and fpUpBreakCount >= fpEffConfirmBars and fpUpDeltaCount >= fpEffConfirmBars
fpShortConfirmed = fpBiasBear and fpRegimeShortOk and fpDownBreakCount >= fpEffConfirmBars and fpDownDeltaCount >= fpEffConfirmBars
fpLongSignal = fpLongConfirmed and (not fpOneSignalPerSide or not fpLongFired)
fpShortSignal = fpShortConfirmed and (not fpOneSignalPerSide or not fpShortFired)

if fpLongSignal
    fpLongFired := true
if fpShortSignal
    fpShortFired := true

fpBreakState = "OFF"
if fpModuleEnabled
    if not fpLayoutValid
        fpBreakState := "Invalid Session Times"
    else if fpContextSession == "None"
        fpBreakState := fpCollectSession != "Maintenance" ? "Collecting" : "Waiting"
    else if not fpContextReady
        fpBreakState := "NA"
    else if fpLongSignal
        fpBreakState := "Long"
    else if fpShortSignal
        fpBreakState := "Short"
    else if fpOneSignalPerSide and fpLongFired and not fpShortFired
        fpBreakState := "Locked Long"
    else if fpOneSignalPerSide and fpShortFired and not fpLongFired
        fpBreakState := "Locked Short"
    else
        fpBreakState := "Pending"

// -------------------- HTF Z-Score
f_htf_z() =>
    srcVol = useDollarVolume ? close * volume * contractMultiplier : volume
    f_zscore(srcVol)

f_next_higher_tf(chartSec) =>
    out = "12M"
    if chartSec <= 60
        out := "5"
    else if chartSec <= 300
        out := "15"
    else if chartSec <= 900
        out := "60"
    else if chartSec <= 1800
        out := "120"
    else if chartSec <= 3600
        out := "240"
    else if chartSec <= 14400
        out := "1D"
    else if chartSec <= 86400
        out := "1W"
    else if chartSec <= 604800
        out := "1M"
    else if chartSec <= 2592000
        out := "3M"
    out

// HTF precedence: input override (blank -> 60), then auto-raised to next higher TF if needed.
manualHTF = higherTF_override == "" ? "60" : higherTF_override
chartTfSec = timeframe.in_seconds()
manualTfSec = timeframe.in_seconds(manualHTF)
higherTF = na(manualTfSec) ? f_next_higher_tf(chartTfSec) : (manualTfSec > chartTfSec ? manualHTF : f_next_higher_tf(chartTfSec))

// Confirmed HTF value only (reduces live HTF flicker/repaint in gate logic)
zHTF_live = request.security(syminfo.tickerid, higherTF, f_htf_z(), barmerge.gaps_off, barmerge.lookahead_off)
zHTF = zHTF_live[1]

useMTFGate = requireMTF
okMTF = not useMTFGate or na(zHTF) or zHTF > zThreshHTF

// -------------------- Candle / Pattern Features
prevClose = close[1]
tr = math.max(high - low, math.max(math.abs(high - prevClose), math.abs(low - prevClose)))
atr_bar = ta.rma(tr, atrLen)
rng = high - low
body = math.abs(close - open)
bodyPct = rng > 0 ? body / rng : 0.0

rangeSpike = tr > atr_bar * atrMult
smallBody = rng > 0 and bodyPct < smallBodyP

isElevated = zSignal >= elevated_gate
isInstitutional = zSignal >= institutional_gate

rawMomentum = isElevated and rangeSpike
rawAbsorption = isElevated and smallBody

volScore = math.min(3.0, math.max(0.0, zSignal - normal_gate))
rangeScore = atr_bar > 0 ? math.min(2.0, math.max(0.0, tr / atr_bar - atrMult)) : 0.0
tightBody = math.min(2.0, math.max(0.0, (smallBodyP - bodyPct) * 4.0))
scoreMomentum = rawMomentum ? (volScore + rangeScore + (isInstitutional ? 1.0 : 0.0)) : 0.0
scoreAbsorption = rawAbsorption ? (volScore + tightBody + (isInstitutional ? 1.0 : 0.0)) : 0.0

// Mutually exclusive output: if both patterns occur, pick the stronger one (tie -> momentum)
preferMomentum = rawMomentum and (not rawAbsorption or scoreMomentum >= scoreAbsorption)
preferAbsorption = rawAbsorption and not preferMomentum

var int lastMarkBar = na
onCooldown = not na(lastMarkBar) and (bar_index - lastMarkBar) < cooldownBars

canShow = not newsGuard
canEmit = canShow and not onCooldown and okMTF
isClosedBar = barstate.isconfirmed

fpDirBullBar = not na(fpBarDelta) ? fpBarDelta > 0 : close > open
fpDirBearBar = not na(fpBarDelta) ? fpBarDelta < 0 : close < open
fpDirectionalBiasActive = fpContextReady and (fpBiasBull or fpBiasBear)
fpDirectionalMatch = not fpDirectionalBiasActive or (fpBiasBull and fpDirBullBar) or (fpBiasBear and fpDirBearBar)
fpHardMode = fpModuleEnabled and footprintGateMode == "Hard"
fpSoftMode = fpModuleEnabled and footprintGateMode == "Soft"
fpHardDirectionalBlock = fpHardMode and fpDirectionalBiasActive and not fpDirectionalMatch
fpHardAbsorptionBlock = fpHardDirectionalBlock and not allowAbsorptionAgainstBias

markMomentumRaw = isClosedBar and canEmit and preferMomentum and scoreMomentum >= minScoreGate
markAbsRaw = isClosedBar and canEmit and preferAbsorption and scoreAbsorption >= minScoreGate
markActivityElevRaw = isClosedBar and canEmit and isElevated and not isInstitutional
markActivityInstRaw = isClosedBar and canEmit and isInstitutional

markMomentum = markMomentumRaw and not fpHardDirectionalBlock
markAbs = markAbsRaw and not fpHardAbsorptionBlock
markActivityElev = markActivityElevRaw and not fpHardDirectionalBlock
markActivityInst = markActivityInstRaw and not fpHardDirectionalBlock

fpHardGateBlocked = fpHardMode and ((markMomentumRaw and not markMomentum) or (markActivityElevRaw and not markActivityElev) or (markActivityInstRaw and not markActivityInst) or (markAbsRaw and not markAbs))

hasAnyMark = markMomentum or markAbs or markActivityElev or markActivityInst

var int lastHighActivityBar = na

if isClosedBar and hasAnyMark
    lastMarkBar := bar_index

if isClosedBar and (markActivityElev or markActivityInst)
    lastHighActivityBar := bar_index

maintenanceBreak = sessionPhase == "Maintenance"

barsSinceHighActivity = na(lastHighActivityBar) ? na : (bar_index - lastHighActivityBar)
activityRecencyText = na(barsSinceHighActivity) ? "none" : (barsSinceHighActivity == 0 ? "now" : "last " + str.tostring(barsSinceHighActivity) + " bars")

// -------------------- Soft Context Flags
softGateActive = maintenanceBreak or (useMTFGate and not okMTF) or relativeFallback or onCooldown

// -------------------- Confidence Model (Gated-State Synced)
confBase = markActivityInst ? 88.0 : markMomentum ? 74.0 : markAbs ? 70.0 : markActivityElev ? 60.0 : 22.0
fpSoftMismatchPenalty = fpSoftMode and fpDirectionalBiasActive and not fpDirectionalMatch and (markMomentum or markAbs or markActivityElev or markActivityInst)
confAdj = confBase - (softGateActive ? 5.0 : 0.0) - (fpSoftMismatchPenalty ? fpSoftPenaltyPct : 0.0)
confRawPct = math.min(100.0, math.max(0.0, confAdj))
confPct = ta.ema(confRawPct, confidenceSmoothLen)

// -------------------- Dashboard (Compact Activity View)
var table dash = table.new(position.top_right, 2, 7, border_width=1)
var table iconBanner = table.new(position.bottom_center, 5, 1, border_width=1)

if barstate.islast
    if showDashboard
        table.set_position(dash, dashPos)
        labelBg = color.new(color.black, 0)
        valueBg = color.new(color.black, 70)
        headBg = color.new(color.blue, 75)
        sessionBg = color.new(color.red, 70)
        if sessionPhase == "NY Open" or sessionPhase == "Open" or sessionPhase == "NY"
            sessionBg := color.new(color.green, 75)
        else if sessionPhase == "NY Midday" or sessionPhase == "Midday"
            sessionBg := color.new(color.orange, 70)
        else if sessionPhase == "NY Close" or sessionPhase == "Close"
            sessionBg := color.new(color.blue, 65)
        else if sessionPhase == "London"
            sessionBg := color.new(color.aqua, 70)
        else if sessionPhase == "Asia"
            sessionBg := color.new(color.yellow, 70)
        else if sessionPhase == "Tokyo"
            sessionBg := color.new(color.yellow, 55)
        else if sessionPhase == "PreLondon"
            sessionBg := color.new(color.aqua, 55)
        else if sessionPhase == "Overnight"
            sessionBg := color.new(color.gray, 75)
        activityLevelText = markActivityInst ? "Extreme" : markActivityElev ? "High" : (not na(barsSinceHighActivity) and barsSinceHighActivity <= cooldownBars ? "Normal" : "Low")
        activityText = activityLevelText + " | " + activityRecencyText
        activityBg = markActivityInst ? color.new(color.fuchsia, 70) : markActivityElev ? color.new(color.yellow, 70) : activityLevelText == "Normal" ? color.new(color.blue, 70) : valueBg
        pressureText = "Balanced"
        if econRegimeActive
            pressureText := "Macro Econ Caution"
        else if markAbs
            pressureText := "Absorption"
        else if markActivityInst or markMomentum
            pressureText := "Push Likely"
        else if softGateActive
            pressureText := "Caution"
        pressureBg = valueBg
        if econRegimeActive
            pressureBg := color.new(color.yellow, 70)
        else if markAbs
            pressureBg := color.new(color.orange, 70)
        else if markActivityInst or markMomentum
            pressureBg := color.new(color.green, 75)
        else if softGateActive
            pressureBg := color.new(color.yellow, 70)
        newsText = "None"
        if highImpactNow
            newsText := highImpactLabel + " now @ " + activeImpactTimeText + " | " + activeImpactBarsAgoText + " bars ago"
        else if highImpactRecent
            newsText := highImpactLabel + " recent @ " + activeImpactTimeText + " | " + activeImpactBarsAgoText + " bars ago"
        newsBg = highImpactNow ? color.new(color.red, 70) : highImpactRecent ? color.new(color.orange, 70) : valueBg
        sessionTextColor = color.white
        activityTextColor = color.white
        pressureTextColor = color.white
        newsTextColor = color.white
        fpPrevText = "Module disabled"
        fpPrevBg = valueBg
        fpPrevTextColor = color.white
        fpLiveText = "Module disabled"
        fpLiveBg = valueBg
        fpLiveTextColor = color.white
        fpReadText = "Balanced"
        fpReadBg = color.new(color.black, 65)
        fpReadTextColor = color.white
        if useFootprintContext and not isFuturesSymbol
            fpPrevText := "Futures only"
            fpPrevBg := color.new(color.gray, 75)
            fpLiveText := "Futures only"
            fpLiveBg := color.new(color.gray, 75)
            fpReadText := "Futures only"
            fpReadBg := color.new(color.gray, 75)
        else if fpModuleEnabled
            fpPrevDeltaToken = f_delta_raw_token(fpPrevDelta)
            fpPrevPctToken = f_delta_pct_token(fpPrevDeltaPct)
            fpPrevVolToken = f_vol_token_k(fpPrevVol)
            fpPrevText := fpPrevDeltaToken + " | " + fpPrevPctToken + " | " + fpPrevVolToken
            fpPrevBg := color.new(color.black, 65)

            fpLiveDeltaToken = f_delta_raw_token(fpBarDelta)
            fpLivePctToken = f_delta_pct_token(fpBarDeltaPct)
            fpLiveVolToken = f_vol_token_k(fpBarVol)
            fpLiveText := fpLiveDeltaToken + " | " + fpLivePctToken + " | " + fpLiveVolToken
            fpLiveBg := color.new(color.blue, 83)

            if not na(fpPrevDeltaPct)
                fpPrevTextColor := fpPrevDeltaPct > 0 ? color.lime : fpPrevDeltaPct < 0 ? color.red : color.white
            if not na(fpBarDeltaPct)
                fpLiveTextColor := fpBarDeltaPct > 0 ? color.lime : fpBarDeltaPct < 0 ? color.red : color.white

            fpPrevBull = not na(fpPrevDeltaPct) and fpPrevDeltaPct > fpReadMinDeltaPct
            fpPrevBear = not na(fpPrevDeltaPct) and fpPrevDeltaPct < -fpReadMinDeltaPct
            fpLiveBull = not na(fpBarDeltaPct) and fpBarDeltaPct > fpReadMinDeltaPct
            fpLiveBear = not na(fpBarDeltaPct) and fpBarDeltaPct < -fpReadMinDeltaPct
            fpLiveStronger = not na(fpBarDeltaPct) and not na(fpPrevDeltaPct) and math.abs(fpBarDeltaPct) > math.abs(fpPrevDeltaPct)
            fpLiveUpBar = close > open
            fpLiveDownBar = close < open

            if fpLiveUpBar and fpLiveBear
                fpReadText := "Sell absorption"
                fpReadTextColor := color.orange
            else if fpLiveDownBar and fpLiveBull
                fpReadText := "Buy absorption"
                fpReadTextColor := color.aqua
            else if fpPrevBull and fpLiveBull
                fpReadText := fpLiveStronger ? "Buyers strengthening" : "Buyers fading"
                fpReadTextColor := fpLiveStronger ? color.lime : color.yellow
            else if fpPrevBear and fpLiveBear
                fpReadText := fpLiveStronger ? "Sellers strengthening" : "Sellers fading"
                fpReadTextColor := fpLiveStronger ? color.red : color.yellow
            else if fpLiveBull
                fpReadText := "Buyers strengthening"
                fpReadTextColor := color.lime
            else if fpLiveBear
                fpReadText := "Sellers strengthening"
                fpReadTextColor := color.red

        table.cell(dash, 0, 0, "AlgoSpike", text_color=color.white, bgcolor=headBg, text_size=dashTextSize)
        table.cell(dash, 1, 0, sessionPhase, text_color=sessionTextColor, bgcolor=sessionBg, text_size=dashTextSize)
        table.cell(dash, 0, 1, "Activity", text_color=color.white, bgcolor=labelBg, text_size=dashTextSize)
        table.cell(dash, 1, 1, activityText, text_color=activityTextColor, bgcolor=activityBg, text_size=dashTextSize)
        table.cell(dash, 0, 2, "Activity Bias", text_color=color.white, bgcolor=labelBg, text_size=dashTextSize)
        table.cell(dash, 1, 2, pressureText, text_color=pressureTextColor, bgcolor=pressureBg, text_size=dashTextSize)
        table.cell(dash, 0, 3, "News", text_color=color.white, bgcolor=labelBg, text_size=dashTextSize)
        table.cell(dash, 1, 3, newsText, text_color=newsTextColor, bgcolor=newsBg, text_size=dashTextSize)
        table.cell(dash, 0, 4, "FP Prev", text_color=color.white, bgcolor=labelBg, text_size=dashTextSize)
        table.cell(dash, 1, 4, fpPrevText, text_color=fpPrevTextColor, bgcolor=fpPrevBg, text_size=dashTextSize)
        table.cell(dash, 0, 5, "FP Live", text_color=color.white, bgcolor=labelBg, text_size=dashTextSize)
        table.cell(dash, 1, 5, fpLiveText, text_color=fpLiveTextColor, bgcolor=fpLiveBg, text_size=dashTextSize)
        table.cell(dash, 0, 6, "FP Read", text_color=color.white, bgcolor=labelBg, text_size=dashTextSize)
        table.cell(dash, 1, 6, fpReadText, text_color=fpReadTextColor, bgcolor=fpReadBg, text_size=dashTextSize)
    else
        for r = 0 to 6
            for c = 0 to 1
                table.cell(dash, c, r, "", text_color=color.new(color.white, 100), bgcolor=color.new(color.black, 100))

    // Bottom-center icon legend banner (separate from dashboard).
    if showIconBanner
        table.set_position(iconBanner, bannerPos)
        table.cell(iconBanner, 0, 0, "Activity Icons", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=bannerSize)
        table.cell(iconBanner, 1, 0, "✕ Elev", text_color=color.yellow, bgcolor=color.new(color.black, 70), text_size=bannerSize)
        table.cell(iconBanner, 2, 0, "○ Inst", text_color=color.fuchsia, bgcolor=color.new(color.black, 70), text_size=bannerSize)
        table.cell(iconBanner, 3, 0, "■ Mom", text_color=color.aqua, bgcolor=color.new(color.black, 70), text_size=bannerSize)
        table.cell(iconBanner, 4, 0, "◆ Abs", text_color=color.orange, bgcolor=color.new(color.black, 70), text_size=bannerSize)
    else
        for c = 0 to 4
            table.cell(iconBanner, c, 0, "", text_color=color.new(color.white, 100), bgcolor=color.new(color.black, 100))

// -------------------- Plots & Alerts
plotshape(markActivityElev, title="Activity (Elevated)", style=shape.xcross, location=location.abovebar, color=color.yellow, size=size.small)
plotshape(markActivityInst, title="Activity (Institutional)", style=shape.circle, location=location.abovebar, color=color.fuchsia, size=size.small)

plotshape(markMomentum, title="Momentum Activity", style=shape.square, location=location.abovebar, color=color.aqua, size=size.small)
plotshape(markAbs, title="Absorption Activity", style=shape.diamond, location=location.abovebar, color=color.orange, size=size.small)

alertsEnabled = not newsGuard
gatedEventAlert = alertsEnabled and isClosedBar and hasAnyMark
patternEventAlert = alertsEnabled and isClosedBar and (markMomentum or markAbs)
econContextAlert = alertsEnabled and isClosedBar and econRegimeActive and not (econRegimeActive[1] == true)
highImpactReleaseAlert = alertsEnabled and isClosedBar and highImpactNow
fpContextReadyAlert = alertsEnabled and isClosedBar and fpContextReady and not fpContextReady[1]
fpBiasBullAlert = alertsEnabled and isClosedBar and fpBiasBull and not fpBiasBull[1]
fpBiasBearAlert = alertsEnabled and isClosedBar and fpBiasBear and not fpBiasBear[1]
fpBreakLongAlert = alertsEnabled and isClosedBar and fpLongSignal
fpBreakShortAlert = alertsEnabled and isClosedBar and fpShortSignal
fpHardGateBlockedAlert = alertsEnabled and isClosedBar and fpHardGateBlocked
fpDataFallbackAlert = alertsEnabled and isClosedBar and fpDataFallback and not fpDataFallback[1]
fpSessionConfigInvalidAlert = alertsEnabled and isClosedBar and fpSessionConfigInvalid and not fpSessionConfigInvalid[1]

alertcondition(markActivityElev, "Activity (Elevated)", "Elevated activity detected (gated).")
alertcondition(markActivityInst, "Activity (Institutional)", "Institutional activity detected (gated).")
alertcondition(gatedEventAlert, "Activity NOW (Gated Event)", "Gated activity event fired.")
alertcondition(patternEventAlert, "Pattern Activity (Mode Only)", "Pattern activity event fired (Momentum/Absorption).")
alertcondition(alertsEnabled and isClosedBar and relativeFallback, "Relative Mode Fallback", "Relative mode is ON but benchmark data is unavailable; using local z-score fallback.")
alertcondition(econContextAlert, "Economic Context Caution", "Economic context caution regime is active (UR level or MoM jump trigger).")
alertcondition(highImpactReleaseAlert, "High-Impact Release Detected", "High-impact macro release update detected (CPI/PPI/NFP/CCI/FOMC proxy).")
alertcondition(fpContextReadyAlert, "Flow Bias Context Ready", "Completed session flow-bias context is ready.")
alertcondition(fpBiasBullAlert, "Flow Bias Bull", "Flow-bias session context turned bullish.")
alertcondition(fpBiasBearAlert, "Flow Bias Bear", "Flow-bias session context turned bearish.")
alertcondition(fpBreakLongAlert, "Flow Bias Confirmed Long", "Flow-bias breakout confirmation is long.")
alertcondition(fpBreakShortAlert, "Flow Bias Confirmed Short", "Flow-bias breakout confirmation is short.")
alertcondition(fpHardGateBlockedAlert, "Flow Bias Hard-Gate Blocked Event", "Directional event was blocked by hard flow-bias gate.")
alertcondition(fpDataFallbackAlert, "Flow Bias Data Fallback", "Flow-bias context is in low-quality fallback mode (low volume or sparse data).")
alertcondition(fpSessionConfigInvalidAlert, "Flow Bias Session Config Invalid", "Flow-bias session boundaries are invalid. Check Tokyo/PreLondon/London/NY times.")

// Legacy alert titles kept for backward compatibility with existing user alert setups.
alertcondition(fpContextReadyAlert, "Footprint Context Ready", "Completed session flow-bias context is ready.")
alertcondition(fpBiasBullAlert, "Footprint Bias Bull", "Flow-bias session context turned bullish.")
alertcondition(fpBiasBearAlert, "Footprint Bias Bear", "Flow-bias session context turned bearish.")
alertcondition(fpBreakLongAlert, "Footprint Confirmed Long", "Flow-bias breakout confirmation is long.")
alertcondition(fpBreakShortAlert, "Footprint Confirmed Short", "Flow-bias breakout confirmation is short.")
alertcondition(fpHardGateBlockedAlert, "Footprint Hard-Gate Blocked Event", "Directional event was blocked by hard flow-bias gate.")
alertcondition(fpDataFallbackAlert, "Footprint Data Fallback", "Flow-bias context is in low-quality fallback mode (low volume or sparse data).")
