//@version=6
indicator("Squeeze Impulse Oscillator", "SIO", overlay=false)

string GRP_CORE = "Core"
int    i_period   = input.int(14, "Period", minval=3, maxval=50, group=GRP_CORE)
int    i_smooth   = input.int(3, "Smoothing", minval=1, maxval=10, group=GRP_CORE)
float  i_impTh    = input.float(0.6, "Impulse Threshold", minval=0.1, maxval=1.0, step=0.05, group=GRP_CORE)
float  i_sqzTh    = input.float(-0.5, "Squeeze Threshold", minval=-1.0, maxval=-0.1, step=0.05, group=GRP_CORE)

string GRP_SIG = "Signals"
bool   i_showSig  = input.bool(true, "Show Signals", group=GRP_SIG)
int    i_sqzMin   = input.int(3, "Min Squeeze Bars", minval=1, maxval=10, group=GRP_SIG)
bool   i_showBG   = input.bool(true, "Highlight Squeeze Zones", group=GRP_SIG)

string GRP_VIS = "Colors"
color  i_bullCol  = input.color(color.new(#00E676, 0), "Bull Impulse", group=GRP_VIS)
color  i_bearCol  = input.color(color.new(#FF5252, 0), "Bear Impulse", group=GRP_VIS)
color  i_sqzCol   = input.color(color.new(#7C4DFF, 0), "Squeeze", group=GRP_VIS)
color  i_neutCol  = input.color(color.new(#616161, 0), "Neutral", group=GRP_VIS)

float bodySize  = math.abs(close - open)
float range_    = high - low
float bodyEff   = range_ > 0 ? bodySize / range_ : 0.0

float upperWick = high - math.max(open, close)
float lowerWick = math.min(open, close) - low
float totalWick = upperWick + lowerWick
float wickRatio = range_ > 0 ? totalWick / range_ : 0.0

float chg       = close - close[1]
float prevChg   = close[1] - close[2]
float persist   = (chg > 0 and prevChg > 0) or (chg < 0 and prevChg < 0) ? 1.0 : 0.0

float avgRange   = ta.sma(range_, i_period)
float rangeRatio = avgRange > 0 ? range_ / avgRange : 1.0

float impulseScore = bodyEff * rangeRatio * (0.5 + 0.5 * persist)
float squeezeScore = wickRatio * (2.0 - rangeRatio) * (1.0 - persist * 0.5)

float rawSIO = impulseScore - squeezeScore
float sio    = ta.ema(rawSIO, i_smooth)

var int sqzCount = 0
if sio < i_sqzTh
    sqzCount += 1
else if sio > 0
    sqzCount := 0

float wickBias    = range_ > 0 ? (lowerWick - upperWick) / range_ : 0.0
float avgWickBias = ta.sma(wickBias, i_period)

bool wasSqueeze    = sqzCount[1] >= i_sqzMin
bool impulseFired  = ta.crossover(sio, i_impTh)
bool bullSignal    = i_showSig and wasSqueeze and impulseFired and avgWickBias > 0
bool bearSignal    = i_showSig and wasSqueeze and impulseFired and avgWickBias <= 0
bool sqzWarning    = ta.crossunder(sio, i_sqzTh)

color histCol = sio > i_impTh ? (close > open ? i_bullCol : i_bearCol) :
                 sio < i_sqzTh ? i_sqzCol :
                 i_neutCol

plot(sio, "SIO", style=plot.style_columns, color=histCol, linewidth=2)
plot(avgWickBias * 2, "Wick Bias", color=color.new(#FFD600, 50), linewidth=1)
plot(sqzCount > 0 ? -0.8 - sqzCount * 0.05 : na, "Squeeze Counter", style=plot.style_stepline, color=i_sqzCol, linewidth=2)

hline(i_impTh, "Impulse", color=color.new(#00E676, 70), linestyle=hline.style_dashed)
hline(0, "Zero", color=color.new(#FFFFFF, 80), linestyle=hline.style_dotted)
hline(i_sqzTh, "Squeeze", color=color.new(#7C4DFF, 70), linestyle=hline.style_dashed)

bgcolor(i_showBG and sio < i_sqzTh ? color.new(i_sqzCol, 90) : na)

plotshape(bullSignal, "Bull", shape.triangleup, location.bottom, i_bullCol, size=size.small)
plotshape(bearSignal, "Bear", shape.triangledown, location.bottom, i_bearCol, size=size.small)
plotshape(sqzWarning, "Squeeze Start", shape.diamond, location.top, color.new(i_sqzCol, 30), size=size.tiny)

alertcondition(bullSignal, title="Bull Impulse", message="SIO: Bullish impulse after squeeze")
alertcondition(bearSignal, title="Bear Impulse", message="SIO: Bearish impulse after squeeze")
alertcondition(sqzWarning, title="Squeeze Started", message="SIO: Squeeze detected — energy building")
alertcondition(bullSignal or bearSignal, title="Any Impulse", message="SIO: Impulse signal")
