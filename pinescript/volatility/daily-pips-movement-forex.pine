//@version=6
indicator("Daily Pips Movement (Forex)", overlay=true)

// --- Condiciones ---
isForex = syminfo.type == "forex"
isDaily = timeframe.isdaily

// --- Pips Forex ---
pip = syminfo.mintick * 10
dailyPips = (high - low) / pip

// --- Dirección vela ---
isBull = close > open
labelColor = isBull ? color.lime : color.red

// --- Dibujar ---
if isForex and isDaily and barstate.isconfirmed
    label.new(
        bar_index,
        high,
        str.tostring(math.round(dailyPips, 1)),
        xloc = xloc.bar_index,
        yloc = yloc.abovebar,
        textcolor = labelColor,
        style = label.style_label_down,
        size = size.small
    )
