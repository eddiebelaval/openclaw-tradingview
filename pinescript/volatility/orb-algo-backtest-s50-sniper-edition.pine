//@version=6
strategy("ORB Algo Backtest | S50 Sniper Edition", 
     overlay=true, 
     initial_capital=300000, 
     default_qty_type=strategy.fixed, 
     default_qty_value=10, 
     commission_value=21)

// --- [ Inputs ] ---
orbTime     = input.int(30, "ORB Timeframe (นาที)", minval=1)
tp1Mult     = input.float(0.75, "TP 1 (ATR Mult)", group="Exits")
tp2Mult     = input.float(1.50, "TP 2 (ATR Mult)", group="Exits")
tp3Mult     = input.float(2.25, "TP 3 (ATR Mult)", group="Exits")

// --- [ ORB Calculation ] ---
var float orbHigh = na
var float orbLow  = na
var bool  isTrading = false

// ตรวจสอบการเริ่มต้น Session ใหม่ (S50 เริ่ม 10:00 น.)
is_new_session = ta.change(time("D")) != 0

if is_new_session
    orbHigh := na
    orbLow  := na
    isTrading := false

// กำหนดกรอบ High/Low ในช่วง ORB Time
in_orb_period = time < (ta.valuewhen(is_new_session, time, 0) + orbTime * 60 * 1000)

if in_orb_period
    orbHigh := math.max(nz(orbHigh, high), high)
    orbLow  := math.min(nz(orbLow, low), low)

// --- [ Signals ] ---
// เทรดหลังจากจบช่วง ORB และยังไม่มีออเดอร์ในวันนั้น
can_trade = not in_orb_period and not isTrading and not na(orbHigh)

longCond  = can_trade and ta.crossover(close, orbHigh)
shortCond = can_trade and ta.crossunder(close, orbLow)

// --- [ Entry & Risk Management ] ---
atr = ta.atr(14)
var float slPrice = na
var float tp1 = na
var float tp2 = na
var float tp3 = na

if longCond
    strategy.entry("Long", strategy.long, comment="ORB-Buy")
    isTrading := true
    slPrice := (orbHigh + orbLow) / 2 // Balanced SL (กึ่งกลางกรอบ)
    tp1 := close + (atr * tp1Mult)
    tp2 := close + (atr * tp2Mult)
    tp3 := close + (atr * tp3Mult)

if shortCond
    strategy.entry("Short", strategy.short, comment="ORB-Sell")
    isTrading := true
    slPrice := (orbHigh + orbLow) / 2
    tp1 := close - (atr * tp1Mult)
    tp2 := close - (atr * tp2Mult)
    tp3 := close - (atr * tp3Mult)

// --- [ Exit Logic ] ---
if strategy.position_size > 0
    // แบ่งปิดทำกำไร หรือโดน Stop Loss
    strategy.exit("Exit-L", "Long", stop=slPrice, limit=tp2, comment="Exit")

if strategy.position_size < 0
    strategy.exit("Exit-S", "Short", stop=slPrice, limit=tp2, comment="Exit")

// ปิดออเดอร์เมื่อสิ้นวัน (EOD)
if ta.change(time("D")) != 0
    strategy.close_all("End of Day")

// --- [ Visuals ] ---
plot(orbHigh, "ORB High", color=color.green, style=plot.style_linebr, linewidth=2)
plot(orbLow, "ORB Low", color=color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? slPrice : na, "Stop Loss", color=color.orange, style=plot.style_linebr)
