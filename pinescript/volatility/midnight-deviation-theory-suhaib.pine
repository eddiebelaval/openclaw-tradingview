//@version=6
indicator("Midnight Deviation Theory - Suhaib", overlay=true)

// SESH
midnightSession = input.session("2300-2355", "Pre-Midnight Leg")
tz = "America/New_York"

inSession = not na(time(timeframe.period, midnightSession, tz))
sessionStart = inSession and not inSession[1]
sessionEnd = not inSession and inSession[1]

// COLOR INPUTS
mainFibColor = input.color(color.black, "Main Fib Color (-2 to -2.5)")
extraFibColor = input.color(color.gray, "Extended Fib Color (-3.5 to -4.5)")
highColor = input.color(color.green, "Midnight High Color")
lowColor = input.color(color.red, "Midnight Low Color")

// VARIABLES
var float midnightHigh = na
var float midnightLow = na
var int startBar = na

// SESSION START
if sessionStart
    midnightHigh := high
    midnightLow := low
    startBar := bar_index

// BUILD RANGE
if inSession
    midnightHigh := math.max(midnightHigh, high)
    midnightLow := math.min(midnightLow, low)

// AFTER SESSION
if sessionEnd
    rng = midnightHigh - midnightLow

    fibs = array.from(-2.0, -2.25, -2.5, -3.5, -4.0, -4.5)

    for i = 0 to array.size(fibs) - 1
        f = array.get(fibs, i)

        // COLOR RULES (now customizable)
        col = (f == -2.0 or f == -2.25 or f == -2.5) ? mainFibColor : extraFibColor

        // LOW → HIGH projection
        priceUp = midnightLow + rng * (1 - f)
        line.new(startBar, priceUp, startBar + 12, priceUp, color=col)
        label.new(startBar, priceUp, str.tostring(f), style=label.style_none, textcolor=col)

        // HIGH → LOW projection
        priceDown = midnightHigh - rng * (1 - f)
        line.new(startBar, priceDown, startBar + 12, priceDown, color=col)
        label.new(startBar, priceDown, str.tostring(f), style=label.style_none, textcolor=col)

    // RANGE LINES (customizable)
    line.new(startBar, midnightHigh, startBar + 12, midnightHigh, color=highColor, width=2)
    line.new(startBar, midnightLow, startBar + 12, midnightLow, color=lowColor, width=2)

    label.new(startBar, midnightHigh, "PM High", style=label.style_none, textcolor=highColor)
    label.new(startBar, midnightLow, "PM Low", style=label.style_none, textcolor=lowColor)
