//@version=5
indicator("Round Numbers ATR Plotter v3", overlay=true, max_lines_count=500)

// ── INPUTS ─────────────────────────────
number_of_lines = input.int(5,"Number of Levels (per side)",minval=1,maxval=41)

// ATR settings
atr_tf   = input.string("D","ATR Timeframe",options=["D","W"])
atr_len  = input.int(26,"ATR Length")
atr_mult = input.float(0.7,"ATR Multiplier",minval=0.1,maxval=2.0)

// round alignment
round_levels = input.bool(true,"Align levels to round numbers")

// style
ln_color   = input.color(color.new(color.gray,70),"Level color")
ln_width   = input.int(1,"Level width")
ln_style_s = input.string("dotted","Level style",options=["solid","dashed","dotted"])

// gravitation
grav_on  = input.bool(true,"Show gravitation lines")
grav_pct = input.float(25,"Gravitation % of step")

grav_color = input.color(color.new(color.blue,60),"Gravitation color")
grav_width = input.int(1,"Gravitation width")
grav_style_s = input.string("dashed","Gravitation style",options=["solid","dashed","dotted"])

// fill
fill_on  = input.bool(false,"Show gravitation fill")
fill_col = input.color(color.new(color.blue,90),"Fill color")

// ── STYLE HELPERS ──────────────────────
ln_style =
     ln_style_s == "solid"  ? line.style_solid :
     ln_style_s == "dashed" ? line.style_dashed :
                              line.style_dotted

grav_style = grav_style_s == "solid"  ? line.style_solid : grav_style_s == "dashed" ? line.style_dashed : line.style_dotted

// ── ATR STEP ───────────────────────────
atr_val = request.security(syminfo.tickerid, atr_tf, ta.atr(atr_len))

raw_step = atr_val * atr_mult

round_step(x) =>
    pow10 = math.pow(10, math.floor(math.log10(x)))
    math.round(x / pow10) * pow10

step_px = round_levels ? round_step(raw_step) : raw_step

grav_off = step_px * grav_pct * 0.01

// ── ROUND HELPER ───────────────────────
round_level(price,s)=>
    s>0 ? math.round(price/s)*s : na

// ── STATE ARRAYS ───────────────────────
var line[] lines_all = array.new_line()
var linefill[] fills_all = array.new_linefill()
var label stepLabel = na

clear_all() =>
    if array.size(fills_all)>0
        for i=0 to array.size(fills_all)-1
            linefill.delete(array.get(fills_all,i))
        array.clear(fills_all)

    if array.size(lines_all)>0
        for i=0 to array.size(lines_all)-1
            line.delete(array.get(lines_all,i))
        array.clear(lines_all)

// ── DRAW ───────────────────────────────
if step_px > 0 and barstate.islast

    clear_all()

    center = round_levels ? round_level(close,step_px) : close

    for counter = 0 to number_of_lines-1

        // UP
        yUp = center + counter*step_px
        baseUp = line.new(bar_index,yUp,bar_index-1,yUp,xloc=xloc.bar_index,extend=extend.both,color=ln_color,width=ln_width,style=ln_style)
        array.push(lines_all,baseUp)

        if grav_on
            gUpTop = line.new(bar_index,yUp+grav_off,bar_index-1,yUp+grav_off,xloc=xloc.bar_index,extend=extend.both,color=grav_color,width=grav_width,style=grav_style)
            gUpBot = line.new(bar_index,yUp-grav_off,bar_index-1,yUp-grav_off,xloc=xloc.bar_index,extend=extend.both,color=grav_color,width=grav_width,style=grav_style)

            array.push(lines_all,gUpTop)
            array.push(lines_all,gUpBot)

            if fill_on
                array.push(fills_all,linefill.new(gUpTop,gUpBot,color=fill_col))

        // DOWN
        if counter>0
            yDn = center - counter*step_px
            baseDn = line.new(bar_index,yDn,bar_index-1,yDn,xloc=xloc.bar_index,extend=extend.both,color=ln_color,width=ln_width,style=ln_style)
            array.push(lines_all,baseDn)

            if grav_on
                gDnTop = line.new(bar_index,yDn+grav_off,bar_index-1,yDn+grav_off,xloc=xloc.bar_index,extend=extend.both,color=grav_color,width=grav_width,style=grav_style)
                gDnBot = line.new(bar_index,yDn-grav_off,bar_index-1,yDn-grav_off,xloc=xloc.bar_index,extend=extend.both,color=grav_color,width=grav_width,style=grav_style)

                array.push(lines_all,gDnTop)
                array.push(lines_all,gDnBot)

                if fill_on
                    array.push(fills_all,linefill.new(gDnTop,gDnBot,color=fill_col))

    // STEP LABEL
    label_offset = 50
    if not na(stepLabel)
        label.delete(stepLabel)

    stepLabel := label.new(bar_index + label_offset,center - step_px,"ATR Step: "+str.tostring(step_px,format.mintick),style=label.style_label_right,color=color.black,textcolor=color.white)
