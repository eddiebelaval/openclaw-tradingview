//@version=6
indicator(shorttitle="BB 3SD Dom Curves", title="BB 3SD Volume Segmentation Curves", overlay=false)

//──────────────────────────────────────────────────────────────
// INPUTS
//──────────────────────────────────────────────────────────────
length = input.int(20, minval=1)
maType = input.string("EMA", "Basis MA Type", options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"])
src    = input(close, title="Source")

plotMode = input.string("Delta", "Plot Mode", options = ["Dominance %", "Delta", "Volume"])

//──────────────────────────────────────────────────────────────
// MOVING AVERAGE FUNCTION
//──────────────────────────────────────────────────────────────
ma(source, length, _type) =>
    switch _type
        "SMA"        => ta.sma(source, length)
        "EMA"        => ta.ema(source, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA"        => ta.wma(source, length)
        "VWMA"       => ta.vwma(source, length)

//──────────────────────────────────────────────────────────────
// BOLLINGER BANDS (1, 2, 3 SD)
//──────────────────────────────────────────────────────────────
basis = ma(src, length, maType)
dev   = ta.stdev(src, length)

upper1 = basis + dev * 1
lower1 = basis - dev * 1

upper2 = basis + dev * 2
lower2 = basis - dev * 2

upper3 = basis + dev * 3
lower3 = basis - dev * 3

//──────────────────────────────────────────────────────────────
// BUY/SELL VOLUME RECONSTRUCTION
//──────────────────────────────────────────────────────────────
buyVol  = close > open ? volume : close < open ? 0.0 : volume * 0.5
sellVol = close < open ? volume : close > open ? 0.0 : volume * 0.5
deltaVol = buyVol - sellVol

//──────────────────────────────────────────────────────────────
// TOTAL VOLUME PER BB ZONE
//──────────────────────────────────────────────────────────────
volAboveUpper3  = math.sum(volume * (close > upper3  ? 1.0 : 0.0), length)
volU2_U3        = math.sum(volume * (close <= upper3 and close > upper2 ? 1.0 : 0.0), length)
volU1_U2        = math.sum(volume * (close <= upper2 and close > upper1 ? 1.0 : 0.0), length)
volMid_U1       = math.sum(volume * (close <= upper1 and close > basis ? 1.0 : 0.0), length)

volL1_Mid       = math.sum(volume * (close <= basis and close > lower1 ? 1.0 : 0.0), length)
volL2_L1        = math.sum(volume * (close <= lower1 and close > lower2 ? 1.0 : 0.0), length)
volL3_L2        = math.sum(volume * (close <= lower2 and close > lower3 ? 1.0 : 0.0), length)
volBelowLower3  = math.sum(volume * (close <= lower3 ? 1.0 : 0.0), length)

//──────────────────────────────────────────────────────────────
// DELTA PER BB ZONE
//──────────────────────────────────────────────────────────────
deltaAboveUpper3 = math.sum(deltaVol * (close > upper3 ? 1.0 : 0.0), length)
deltaU2_U3       = math.sum(deltaVol * (close <= upper3 and close > upper2 ? 1.0 : 0.0), length)
deltaU1_U2       = math.sum(deltaVol * (close <= upper2 and close > upper1 ? 1.0 : 0.0), length)
deltaMid_U1      = math.sum(deltaVol * (close <= upper1 and close > basis ? 1.0 : 0.0), length)

deltaL1_Mid      = math.sum(deltaVol * (close <= basis and close > lower1 ? 1.0 : 0.0), length)
deltaL2_L1       = math.sum(deltaVol * (close <= lower1 and close > lower2 ? 1.0 : 0.0), length)
deltaL3_L2       = math.sum(deltaVol * (close <= lower2 and close > lower3 ? 1.0 : 0.0), length)
deltaBelowLower3 = math.sum(deltaVol * (close <= lower3 ? 1.0 : 0.0), length)

//──────────────────────────────────────────────────────────────
// TOTAL VOLUME (NORMALIZATION BASE)
//──────────────────────────────────────────────────────────────
totalVol = math.sum(volume, length) + 0.000001

//──────────────────────────────────────────────────────────────
// NORMALIZED VOLUME & DELTA
//──────────────────────────────────────────────────────────────
volAboveUpper3_n  = volAboveUpper3  / totalVol
volU2_U3_n        = volU2_U3        / totalVol
volU1_U2_n        = volU1_U2        / totalVol
volMid_U1_n       = volMid_U1       / totalVol

volL1_Mid_n       = volL1_Mid       / totalVol
volL2_L1_n        = volL2_L1        / totalVol
volL3_L2_n        = volL3_L2        / totalVol
volBelowLower3_n  = volBelowLower3  / totalVol

deltaAboveUpper3_n = deltaAboveUpper3 / totalVol
deltaU2_U3_n       = deltaU2_U3       / totalVol
deltaU1_U2_n       = deltaU1_U2       / totalVol
deltaMid_U1_n      = deltaMid_U1      / totalVol

deltaL1_Mid_n      = deltaL1_Mid      / totalVol
deltaL2_L1_n       = deltaL2_L1       / totalVol
deltaL3_L2_n       = deltaL3_L2       / totalVol
deltaBelowLower3_n = deltaBelowLower3 / totalVol

//──────────────────────────────────────────────────────────────
// DOMINANCE % PER ZONE (UNCHANGED)
//──────────────────────────────────────────────────────────────
domAboveUpper3  = (deltaAboveUpper3  / (volAboveUpper3  + 0.000001)) * 100
domU2_U3        = (deltaU2_U3        / (volU2_U3        + 0.000001)) * 100
domU1_U2        = (deltaU1_U2        / (volU1_U2        + 0.000001)) * 100
domMid_U1       = (deltaMid_U1       / (volMid_U1       + 0.000001)) * 100

domL1_Mid       = (deltaL1_Mid       / (volL1_Mid       + 0.000001)) * 100
domL2_L1        = (deltaL2_L1        / (volL2_L1        + 0.000001)) * 100
domL3_L2        = (deltaL3_L2        / (volL3_L2        + 0.000001)) * 100
domBelowLower3  = (deltaBelowLower3  / (volBelowLower3  + 0.000001)) * 100

//──────────────────────────────────────────────────────────────
// TOTAL CURVE (CUMULATIVE OVER LENGTH WINDOW)
//──────────────────────────────────────────────────────────────

// Total normalized volume (sum of all zones)
totalVolCurve = volAboveUpper3_n + volU2_U3_n + volU1_U2_n + volMid_U1_n + volL1_Mid_n + volL2_L1_n + volL3_L2_n + volBelowLower3_n

// Total normalized delta (sum of all zones)
totalDeltaCurve = deltaAboveUpper3_n + deltaU2_U3_n + deltaU1_U2_n + deltaMid_U1_n + deltaL1_Mid_n + deltaL2_L1_n + deltaL3_L2_n + deltaBelowLower3_n

//──────────────────────────────────────────────────────────────
// METRIC SELECTOR
//──────────────────────────────────────────────────────────────
getMetric(zoneDom, zoneDelta, zoneVol) =>
    plotMode == "Dominance %" ? zoneDom : plotMode == "Delta" ? zoneDelta : zoneVol

//──────────────────────────────────────────────────────────────
// PLOT CURVES BASED ON SELECTED MODE
//──────────────────────────────────────────────────────────────
plot(getMetric(domAboveUpper3,  deltaAboveUpper3_n,  volAboveUpper3_n),  "U3",    color=color.new(color.red,   0), linewidth=2)
plot(getMetric(domU2_U3,        deltaU2_U3_n,        volU2_U3_n),        "U2–U3", color=color.new(color.red,  30), linewidth=2)
plot(getMetric(domU1_U2,        deltaU1_U2_n,        volU1_U2_n),        "U1–U2", color=color.new(color.red,  60), linewidth=2)

plot(getMetric(domMid_U1,       deltaMid_U1_n,       volMid_U1_n),       "Mid–U1", color=color.new(color.blue, 40), linewidth=2)

plot(getMetric(domL1_Mid,       deltaL1_Mid_n,       volL1_Mid_n),       "L1–Mid", color=color.new(color.green, 40), linewidth=2)
plot(getMetric(domL2_L1,        deltaL2_L1_n,        volL2_L1_n),        "L2–L1",  color=color.new(color.green, 60), linewidth=2)
plot(getMetric(domL3_L2,        deltaL3_L2_n,        volL3_L2_n),        "L3–L2",  color=color.new(color.green, 80), linewidth=2)
plot(getMetric(domBelowLower3,  deltaBelowLower3_n,  volBelowLower3_n),  "<L3",    color=color.new(color.green, 90), linewidth=2)

//──────────────────────────────────────────────────────────────
// PLOT TOTAL CURVE (ONLY FOR DELTA OR VOLUME MODES)
//──────────────────────────────────────────────────────────────
plot(plotMode == "Delta"  ? totalDeltaCurve : plotMode == "Volume" ? totalVolCurve : na, "TOTAL", color=color.new(color.white, 0), linewidth=3)
