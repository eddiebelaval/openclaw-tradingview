//@version=6
indicator("ATR Stop Distance (Ticks, mintick-based)", overlay=false)

// Inputs
atrLen   = input.int(20, "ATR length", minval=1)
mult     = input.float(1.5, "ATR multiplier", minval=0.0, step=0.1)
roundMode = input.string("Round", "Tick rounding", options=["Round", "Ceil", "Floor"])

// ATR in price units
atrPrice = ta.atr(atrLen)

// Convert ATR -> ticks using mintick
rawTicks = atrPrice / syminfo.mintick * mult

// Apply rounding
stopTicks = roundMode == "Ceil"  ? int(math.ceil(rawTicks))  :     roundMode == "Floor" ? int(math.floor(rawTicks)) :                            int(math.round(rawTicks))

// Plot
plot(stopTicks, "Stop distance (ticks)", linewidth=2)

// Show info label
var label lbl = na
if barstate.islast
    label.delete(lbl)
    lbl := label.new(bar_index, stopTicks,
        "ATR(" + str.tostring(atrLen) + ") = " + str.tostring(atrPrice) +
        "\nmintick = " + str.tostring(syminfo.mintick) +
        "\nStop = " + str.tostring(stopTicks) + " ticks",
        style=label.style_label_left)
