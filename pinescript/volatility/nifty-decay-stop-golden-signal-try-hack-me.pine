//@version=5
indicator("NIFTY Decay Stop Golden Signal", overlay=true)

// Inputs
ltp_threshold = input.float(6.5, "Call LTP Trigger")
p_ltp_threshold = input.float(220, "Put LTP Trigger") 
lookback = input.int(3, "LTP Momentum Bars")

// Manual inputs 
call_ltp_25500 = input.float(4.4, "25500C LTP")
put_ltp_25500 = input.float(187, "25500P LTP")

// LTP Momentum
ltp_momentum_c = call_ltp_25500 > ltp_threshold
ltp_momentum_p = put_ltp_25500 > p_ltp_threshold

// Rest unchanged...
spot = close
resistance_25600 = spot > 25520 and spot[1] <= 25520
support_25480 = spot < 25480 and spot[1] >= 25480

green_candle = close > open and (high-low) > (ta.atr(14)*0.7)
red_candle = close < open and (high-low) > (ta.atr(14)*0.7)

buy_golden = ltp_momentum_c and resistance_25600 and green_candle
sell_golden = ltp_momentum_p and support_25480 and red_candle

plotshape(buy_golden, "BUY 50PTS", shape.triangleup, location.belowbar, color.green, size=size.large)
plotshape(sell_golden, "SELL 50PTS", shape.triangledown, location.abovebar, color.red, size=size.large)

alertcondition(buy_golden, "Golden BUY", "NIFTY 50pt UP - Enter Long Now!")
alertcondition(sell_golden, "Golden SELL", "NIFTY 50pt DOWN - Enter Short Now!")
