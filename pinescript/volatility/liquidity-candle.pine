//@version=6
indicator('Liquidity candle', overlay = true, max_boxes_count = 500, max_labels_count = 500)

// ─── INPUTS ───
atr_length = input.int(14, 'Période ATR Daily')
atr_threshold = input.float(0.25, 'Seuil (%)', step = 0.01)
show_label = input.bool(true, 'Afficher les labels')
box_width = input.int(15, 'Largeur du rectangle (bougies)', minval = 1)

// ─── ATR DAILY ───
atr_daily = request.security(syminfo.tickerid, 'D', ta.atr(atr_length), lookahead = barmerge.lookahead_on)
seuil = atr_daily * atr_threshold

// ─── BOUGIE 9h30 15M ───
[h15, l15, o15, c15, t15] = request.security(syminfo.tickerid, '15', [high, low, open, close, time], lookahead = barmerge.lookahead_off)

is_930 = hour(t15, 'America/New_York') == 9 and minute(t15, 'America/New_York') == 30

// ─── DÉTECTION NOUVEAU SIGNAL 9h30 ───
// On dessine à chaque fois qu'on détecte une bougie 9h30 (historique compris)
var int last_drawn_day = na

is_new_930 = is_930 and (na(last_drawn_day) or dayofmonth(time) != last_drawn_day)

if is_new_930
    last_drawn_day := dayofmonth(time)

    rng = h15 - l15
    liquid = rng >= seuil
    bullish = c15 > o15

    rect_col = liquid ? color.new(color.green, 55) : color.new(color.red, 55)
    border_col = liquid ? color.green : color.red

    // ─── RECTANGLE ───
    box.new(left = bar_index, top = h15, right = bar_index + box_width, bottom = l15, border_color = border_col, border_width = 2, bgcolor = rect_col)

    // ─── LABEL ───
    if show_label
        pct = math.round(rng / atr_daily * 100, 1)
        dir = bullish ? '⬇️ SHORT' : '⬆️ LONG'
        txt = (liquid ? '✅ ' : '❌ ') + str.tostring(pct) + '% ATR' + (liquid ? '\n' + dir : '')

        label.new(bar_index + box_width / 2, liquid ? h15 : l15, txt, style = liquid ? label.style_label_down : label.style_label_up, color = liquid ? color.new(color.green, 15) : color.new(color.red, 15), textcolor = color.white, size = size.small)
