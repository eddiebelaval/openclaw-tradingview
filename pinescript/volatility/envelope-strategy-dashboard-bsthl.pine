// This Pine Script™ v6 indicator is subject to the terms of the Mozilla Public License 2.0
// © Trading Strategy - Extended Envelope Alerts + Data Pack

//@version=6
indicator("Envelope Strategy Dashboard", overlay=true, max_labels_count=50)

// ============================================
// НАСТРОЙКИ КАНАЛА
// ============================================
grpEnv      = "Envelope канал"
length      = input.int(30, "Length", minval=1, group=grpEnv)
percent     = input.float(2.0, "Percent", minval=0.01, step=0.1, group=grpEnv)
src         = input.source(ohlc4, "Source", group=grpEnv)
useEMA      = input.bool(true, "Exponential", group=grpEnv)

grpAlert    = "Алерты"
alertZone   = input.float(0.15, "Alert Zone (%)", minval=0.01, step=0.05, group=grpAlert,
              tooltip="Насколько близко к уровню для срабатывания")

grpTrend    = "Тренд (5H на текущем ТФ)"
emaFast     = input.int(21, "EMA быстрая", group=grpTrend)
emaSlow     = input.int(50, "EMA медленная", group=grpTrend)
adxLen      = input.int(14, "ADX Length", group=grpTrend)

grpDiv      = "Дивергенции"
macdFast    = input.int(12, "MACD Fast", group=grpDiv)
macdSlow    = input.int(26, "MACD Slow", group=grpDiv)
macdSignal  = input.int(9, "MACD Signal", group=grpDiv)
rsiLen      = input.int(14, "RSI Length", group=grpDiv)
bbpLen      = input.int(13, "BBPower Length", group=grpDiv)
efiLen      = input.int(5, "EFI Length", group=grpDiv)
divLookback = input.int(5, "Lookback для дивергенций (свечей)", group=grpDiv)

grpSpeed    = "Скорость"
speedLen    = input.int(10, "Период расчёта скорости (свечей)", group=grpSpeed)

// ============================================
// РАСЧЁТ КАНАЛА
// ============================================
basis       = useEMA ? ta.ema(src, length) : ta.sma(src, length)
upperEnv    = basis * (1 + percent / 100)
lowerEnv    = basis * (1 - percent / 100)

pBasis      = plot(basis, "Середина", color=color.new(color.yellow, 0), linewidth=2)
pUpper      = plot(upperEnv, "Верхняя", color=color.new(color.red, 0), linewidth=2)
pLower      = plot(lowerEnv, "Нижняя", color=color.new(color.green, 0), linewidth=2)
fill(pUpper, pBasis, color=color.new(color.red, 90))
fill(pBasis, pLower, color=color.new(color.green, 90))

// ============================================
// СКОРОСТЬ ДВИЖЕНИЯ ЦЕНЫ
// ============================================
priceSpeed  = (close - close[speedLen]) / speedLen  // $/свеча
absSpeed    = math.abs(priceSpeed)

// Расстояния
distUpper   = upperEnv - close
distMiddle  = basis - close
distLower   = close - lowerEnv

distUpperPct  = distUpper / close * 100
distMiddlePct = distMiddle / close * 100
distLowerPct  = distLower / close * 100

// Часов до границ (при текущей скорости)
hoursToUpper  = absSpeed > 0 ? math.abs(distUpper) / absSpeed : na
hoursToMiddle = absSpeed > 0 ? math.abs(distMiddle) / absSpeed : na
hoursToLower  = absSpeed > 0 ? math.abs(distLower) / absSpeed : na

// Ближайшая граница
nearestDist   = math.min(math.abs(distUpper), math.abs(distMiddle), math.abs(distLower))
nearestName = math.abs(distUpper) == nearestDist ? "ВЕРХНЯЯ" : math.abs(distLower) == nearestDist ? "НИЖНЯЯ" : "СЕРЕДИНА"
nearestHours = math.abs(distUpper) == nearestDist ? hoursToUpper : math.abs(distLower) == nearestDist ? hoursToLower : hoursToMiddle

// ============================================
// ИНДИКАТОРЫ ДЛЯ ДИВЕРГЕНЦИЙ
// ============================================
// MACD
[macdLine, signalLine, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)

// RSI
rsiVal = ta.rsi(close, rsiLen)

// BBPower
bbpBull = high - ta.ema(close, bbpLen)
bbpBear = low - ta.ema(close, bbpLen)

// EFI
efiVal = ta.ema(close - close[1], efiLen) * volume

// ============================================
// ДЕТЕКЦИЯ ДИВЕРГЕНЦИЙ (упрощённая)
// ============================================
// Бычья дивергенция: цена делает новый лоу, индикатор — более высокий лоу
// Медвежья дивергенция: цена делает новый хай, индикатор — более низкий хай

priceLow  = ta.lowest(low, divLookback)
priceHigh = ta.highest(high, divLookback)

// MACD дивергенции
macdLow      = ta.lowest(macdHist, divLookback)
macdHigh     = ta.highest(macdHist, divLookback)
macdBullDiv  = (low <= priceLow) and (macdHist > macdLow)     // бычья
macdBearDiv  = (high >= priceHigh) and (macdHist < macdHigh)   // медвежья

// RSI дивергенции
rsiLow       = ta.lowest(rsiVal, divLookback)
rsiHigh      = ta.highest(rsiVal, divLookback)
rsiBullDiv   = (low <= priceLow) and (rsiVal > rsiLow)
rsiBearDiv   = (high >= priceHigh) and (rsiVal < rsiHigh)

// BBPower дивергенции
bbpLow       = ta.lowest(bbpBear, divLookback)
bbpHigh      = ta.highest(bbpBull, divLookback)
bbpBullDiv   = (low <= priceLow) and (bbpBear > bbpLow)
bbpBearDiv   = (high >= priceHigh) and (bbpBull < bbpHigh)

// EFI дивергенции
efiLow       = ta.lowest(efiVal, divLookback)
efiHigh      = ta.highest(efiVal, divLookback)
efiBullDiv   = (low <= priceLow) and (efiVal > efiLow)
efiBearDiv   = (high >= priceHigh) and (efiVal < efiHigh)

// Подсчёт баллов
bullScore = (macdBullDiv ? 3.0 : 0.0) + (bbpBullDiv ? 2.0 : 0.0) + (rsiBullDiv ? 2.0 : 0.0) + (efiBullDiv ? 1.0 : 0.0)
bearScore = (macdBearDiv ? 3.0 : 0.0) + (bbpBearDiv ? 2.0 : 0.0) + (rsiBearDiv ? 2.0 : 0.0) + (efiBearDiv ? 1.0 : 0.0)

// ============================================
// ADX (встроенный расчёт)
// ============================================
upMove   = high - high[1]
downMove = low[1] - low
plusDM   = (upMove > downMove and upMove > 0) ? upMove : 0
minusDM  = (downMove > upMove and downMove > 0) ? downMove : 0
atrVal   = ta.atr(adxLen)
plusDI    = 100 * ta.ema(plusDM, adxLen) / atrVal
minusDI  = 100 * ta.ema(minusDM, adxLen) / atrVal
dx       = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adxVal   = ta.ema(dx, adxLen)

// EMA тренд
emaF = ta.ema(close, emaFast)
emaS = ta.ema(close, emaSlow)

// Режим рынка
trendDir = emaF > emaS ? "↑" : emaF < emaS ? "↓" : "→"
regime = adxVal >= 40 ? (emaF > emaS ? "Сильный ↑" : "Сильный ↓") :
         adxVal >= 25 ? (emaF > emaS ? "Восходящий" : "Нисходящий") : "Боковик"

// ============================================
// ЗОНЫ КАСАНИЯ
// ============================================
zoneSize        = close * alertZone / 100
touchUpper      = math.abs(high - upperEnv) <= zoneSize or high >= upperEnv
touchMiddle     = math.abs(close - basis) <= zoneSize
touchLower      = math.abs(low - lowerEnv) <= zoneSize or low <= lowerEnv
breakAbove      = close > upperEnv
breakBelow      = close < lowerEnv

newTouchUpper   = touchUpper and not touchUpper[1]
newTouchMiddle  = touchMiddle and not touchMiddle[1]
newTouchLower   = touchLower and not touchLower[1]
newBreakAbove   = breakAbove and not breakAbove[1]
newBreakBelow   = breakBelow and not breakBelow[1]

anyTouch        = newTouchUpper or newTouchMiddle or newTouchLower or newBreakAbove or newBreakBelow

// ============================================
// МЕТКИ НА ГРАФИКЕ
// ============================================
plotshape(newTouchUpper, "Upper", shape.triangledown, location.abovebar, color.red, size=size.small, text="▼ Upper")
plotshape(newTouchMiddle, "Middle", shape.diamond, location.abovebar, color.yellow, size=size.small, text="◆ Mid")
plotshape(newTouchLower, "Lower", shape.triangleup, location.belowbar, color.green, size=size.small, text="▲ Lower")
plotshape(newBreakAbove, "Break↑", shape.triangledown, location.abovebar, color.fuchsia, size=size.normal, text="BREAK ↑")
plotshape(newBreakBelow, "Break↓", shape.triangleup, location.belowbar, color.fuchsia, size=size.normal, text="BREAK ↓")

// Дивергенции на графике
plotshape(bullScore >= 3 and touchLower, "Bull Div Signal", shape.labelup, location.belowbar,
          color.new(color.green, 0), size=size.normal, text="BULL DIV", textcolor=color.white)
plotshape(bearScore >= 3 and touchUpper, "Bear Div Signal", shape.labeldown, location.abovebar,
          color.new(color.red, 0), size=size.normal, text="BEAR DIV", textcolor=color.white)

// ============================================
// ИНФОРМАЦИОННАЯ ТАБЛИЦА
// ============================================
var table dash = table.new(position.top_right, 2, 16, bgcolor=color.new(color.black, 70), border_width=1)

if barstate.islast
    // Заголовок
    table.cell(dash, 0, 0, "📊 DASHBOARD", text_color=color.yellow, text_size=size.small, bgcolor=color.new(#162447, 50))
    table.cell(dash, 1, 0, "", bgcolor=color.new(#162447, 50))
    
    // Канал
    table.cell(dash, 0, 1, "▲ Верх", text_color=color.red, text_size=size.tiny)
    table.cell(dash, 1, 1, str.tostring(upperEnv, "#.#") + " (" + str.tostring(distUpperPct, "#.##") + "%)", text_color=color.red, text_size=size.tiny)
    
    table.cell(dash, 0, 2, "● Середина", text_color=color.yellow, text_size=size.tiny)
    table.cell(dash, 1, 2, str.tostring(basis, "#.#") + " (" + str.tostring(distMiddlePct, "#.##") + "%)", text_color=color.yellow, text_size=size.tiny)
    
    table.cell(dash, 0, 3, "▼ Низ", text_color=color.green, text_size=size.tiny)
    table.cell(dash, 1, 3, str.tostring(lowerEnv, "#.#") + " (-" + str.tostring(distLowerPct, "#.##") + "%)", text_color=color.green, text_size=size.tiny)
    
    // Скорость и прогноз
    table.cell(dash, 0, 4, "Скорость ($/свеча)", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 4, str.tostring(priceSpeed, "#.#"), text_color=priceSpeed > 0 ? color.green : color.red, text_size=size.tiny)
    
    table.cell(dash, 0, 5, "→ Ближайшая", text_color=color.orange, text_size=size.tiny)
    table.cell(dash, 1, 5, nearestName + " ~" + str.tostring(nearestHours, "#.#") + "ч", text_color=color.orange, text_size=size.tiny)
    
    table.cell(dash, 0, 6, "→ До верхней", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 6, str.tostring(hoursToUpper, "#.#") + " ч", text_color=color.white, text_size=size.tiny)
    
    table.cell(dash, 0, 7, "→ До середины", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 7, str.tostring(hoursToMiddle, "#.#") + " ч", text_color=color.white, text_size=size.tiny)
    
    table.cell(dash, 0, 8, "→ До нижней", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 8, str.tostring(hoursToLower, "#.#") + " ч", text_color=color.white, text_size=size.tiny)
    
    // Тренд
    table.cell(dash, 0, 9, "Режим", text_color=color.aqua, text_size=size.tiny)
    regimeColor = str.contains(regime, "↑") ? color.green : str.contains(regime, "↓") ? color.red : color.yellow
    table.cell(dash, 1, 9, regime + " | ADX:" + str.tostring(adxVal, "#.#"), text_color=regimeColor, text_size=size.tiny)
    
    // Дивергенции
    table.cell(dash, 0, 10, "🐂 Bull баллы", text_color=color.green, text_size=size.tiny)
    macdBullStr = macdBullDiv ? "✓" : "✗"
    bbpBullStr = bbpBullDiv ? "✓" : "✗"
    rsiBullStr = rsiBullDiv ? "✓" : "✗"
    efiBullStr = efiBullDiv ? "✓" : "✗"
    table.cell(dash, 1, 10, str.tostring(bullScore, "#") + "/8 (M:" + macdBullStr + " B:" + bbpBullStr + " R:" + rsiBullStr + " E:" + efiBullStr + ")", 
               text_color=bullScore >= 3 ? color.green : color.gray, text_size=size.tiny)
    
    table.cell(dash, 0, 11, "🐻 Bear баллы", text_color=color.red, text_size=size.tiny)
    macdBearStr = macdBearDiv ? "✓" : "✗"
    bbpBearStr = bbpBearDiv ? "✓" : "✗"
    rsiBearStr = rsiBearDiv ? "✓" : "✗"
    efiBearStr = efiBearDiv ? "✓" : "✗"
    table.cell(dash, 1, 11, str.tostring(bearScore, "#") + "/8 (M:" + macdBearStr + " B:" + bbpBearStr + " R:" + rsiBearStr + " E:" + efiBearStr + ")", 
               text_color=bearScore >= 3 ? color.red : color.gray, text_size=size.tiny)

    // MACD / RSI текущие
    table.cell(dash, 0, 12, "MACD hist", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 12, str.tostring(macdHist, "#.#"), text_color=macdHist > 0 ? color.green : color.red, text_size=size.tiny)

    table.cell(dash, 0, 13, "RSI", text_color=color.white, text_size=size.tiny)
    rsiColor = rsiVal > 70 ? color.red : rsiVal < 30 ? color.green : color.white
    table.cell(dash, 1, 13, str.tostring(rsiVal, "#.#"), text_color=rsiColor, text_size=size.tiny)

    // Рекомендация
    table.cell(dash, 0, 14, "⚡ СИГНАЛ", text_color=color.yellow, text_size=size.small, bgcolor=color.new(#162447, 50))
    string sigText = "Ожидание"
    color sigColor = color.gray
    if touchLower and bullScore >= 3
        sigText := "ЛОНГ (" + str.tostring(bullScore, "#") + " балл.)"
        sigColor := color.green
    else if touchUpper and bearScore >= 3
        sigText := "ШОРТ (" + str.tostring(bearScore, "#") + " балл.)"
        sigColor := color.red
    else if touchMiddle
        sigText := "Середина — по тренду"
        sigColor := color.yellow
    table.cell(dash, 1, 14, sigText, text_color=sigColor, text_size=size.small, bgcolor=color.new(#162447, 50))

// ============================================
// АЛЕРТЫ С ПОЛНЫМ ПАКЕТОМ ДАННЫХ
// ============================================

// Формируем текст алерта
alertText = "📊 ENVELOPE ALERT\n" +
     "━━━━━━━━━━━━━━━━━━\n" +
     "💰 Цена: " + str.tostring(close, "#.##") + "\n" +
     "━━━━━━━━━━━━━━━━━━\n" +
     "📐 КАНАЛ:\n" +
     "  ▲ Верх: " + str.tostring(upperEnv, "#.#") + " (" + str.tostring(distUpperPct, "#.##") + "%)\n" +
     "  ● Серед: " + str.tostring(basis, "#.#") + " (" + str.tostring(distMiddlePct, "#.##") + "%)\n" +
     "  ▼ Низ: " + str.tostring(lowerEnv, "#.#") + " (-" + str.tostring(distLowerPct, "#.##") + "%)\n" +
     "━━━━━━━━━━━━━━━━━━\n" +
     "⏱ ПРОГНОЗ:\n" +
     "  Скорость: " + str.tostring(priceSpeed, "#.#") + " $/свеча\n" +
     "  → Ближайшая: " + nearestName + " ~" + str.tostring(nearestHours, "#.#") + " ч\n" +
     "━━━━━━━━━━━━━━━━━━\n" +
     "📈 ТРЕНД: " + regime + " | ADX: " + str.tostring(adxVal, "#.#") + "\n" +
     "  EMA" + str.tostring(emaFast) + ": " + str.tostring(emaF, "#.#") + 
     " | EMA" + str.tostring(emaSlow) + ": " + str.tostring(emaS, "#.#") + "\n" +
     "━━━━━━━━━━━━━━━━━━\n" +
     "🔍 ДИВЕРГЕНЦИИ:\n" +
     "  🐂 Bull: " + str.tostring(bullScore, "#") + "/8" +
     " (MACD:" + (macdBullDiv ? "✓" : "✗") +
     " BBP:" + (bbpBullDiv ? "✓" : "✗") +
     " RSI:" + (rsiBullDiv ? "✓" : "✗") +
     " EFI:" + (efiBullDiv ? "✓" : "✗") + ")\n" +
     "  🐻 Bear: " + str.tostring(bearScore, "#") + "/8" +
     " (MACD:" + (macdBearDiv ? "✓" : "✗") +
     " BBP:" + (bbpBearDiv ? "✓" : "✗") +
     " RSI:" + (rsiBearDiv ? "✓" : "✗") +
     " EFI:" + (efiBearDiv ? "✓" : "✗") + ")\n" +
     "━━━━━━━━━━━━━━━━━━\n" +
     "📊 ИНДИКАТОРЫ:\n" +
     "  MACD: " + str.tostring(macdHist, "#.#") +
     " | RSI: " + str.tostring(rsiVal, "#.#") + "\n" +
     "━━━━━━━━━━━━━━━━━━"

// Алерты
if newTouchUpper
    alert("🔴 ВЕРХНЯЯ ГРАНИЦА\n" + alertText, alert.freq_once_per_bar)
if newTouchMiddle
    alert("🟡 СЕРЕДИНА\n" + alertText, alert.freq_once_per_bar)
if newTouchLower
    alert("🟢 НИЖНЯЯ ГРАНИЦА\n" + alertText, alert.freq_once_per_bar)
if newBreakAbove
    alert("🟣 ПРОБОЙ ВВЕРХ!\n" + alertText, alert.freq_once_per_bar)
if newBreakBelow
    alert("🟣 ПРОБОЙ ВНИЗ!\n" + alertText, alert.freq_once_per_bar)
strongBull = touchLower and bullScore >= 3
strongBear = touchUpper and bearScore >= 3
if strongBull
    alert("⚡⚡⚡ СИЛЬНЫЙ ЛОНГ ⚡⚡⚡\nГраница + дивергенция!\n" + alertText, alert.freq_once_per_bar)
if strongBear
    alert("⚡⚡⚡ СИЛЬНЫЙ ШОРТ ⚡⚡⚡\nГраница + дивергенция!\n" + alertText, alert.freq_once_per_bar)
