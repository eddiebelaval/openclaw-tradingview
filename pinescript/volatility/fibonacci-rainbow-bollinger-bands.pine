//@version=5

indicator(shorttitle="FBB", title="Fibonacci Bollinger Bands", overlay=true)

length = input.int(300, minval=1)
src = input(ohlc4, title="Source")
mult = input.float(3.5, minval=0.001, maxval=50)

basis = ta.vwma(src, length)
dev = mult * ta.stdev(src, length)

dev_6 = 1 * dev
dev_5 = 0.764 * dev
dev_4 = 0.618 * dev
dev_3 = 0.5 * dev
dev_2 = 0.382 * dev
dev_1 = 0.236 * dev

trans=90

color_basis_dev_1 = color.new(color.gray, trans)
color_basis_dev_2 = color.new(color.blue, trans)
color_basis_dev_3 = color.new(color.green, trans)
color_basis_dev_4 = color.new(color.yellow, trans)
color_basis_dev_5 = color.new(color.orange, trans)
color_basis_dev_6 = color.new(color.red, trans)

basis_plot = plot(basis, color=color.fuchsia, linewidth=2)

p6 = plot(basis + dev_6, color=color_basis_dev_6, linewidth=2, title="1")
p5 = plot(basis + dev_5, color=color_basis_dev_5, linewidth=1, title="0.764")
p4 = plot(basis + dev_4, color=color_basis_dev_4, linewidth=1, title="0.618")
p3 = plot(basis + dev_3, color=color_basis_dev_3, linewidth=1, title="0.5")
p2 = plot(basis + dev_2, color=color_basis_dev_2, linewidth=1, title="0.382")
p1 = plot(basis + dev_1, color=color_basis_dev_1, linewidth=1, title="0.236")

p01 = plot(basis - dev_1, color=color_basis_dev_1, linewidth=1, title="0.236")
p02 = plot(basis - dev_2, color=color_basis_dev_2, linewidth=1, title="0.382")
p03 = plot(basis - dev_3, color=color_basis_dev_3, linewidth=1, title="0.5")
p04 = plot(basis - dev_4, color=color_basis_dev_4, linewidth=1, title="0.618")
p05 = plot(basis - dev_5, color=color_basis_dev_5, linewidth=1, title="0.764")
p06 = plot(basis - dev_6, color=color_basis_dev_6, linewidth=2, title="1")

fill(p5, p6, color=color_basis_dev_6)
fill(p4, p5, color=color_basis_dev_5)
fill(p3, p4, color=color_basis_dev_4)
fill(p2, p3, color=color_basis_dev_3)
fill(p1, p2, color=color_basis_dev_2)
fill(basis_plot, p1, color=color_basis_dev_1)

fill(basis_plot, p01, color=color_basis_dev_1)
fill(p01, p02, color=color_basis_dev_2)
fill(p02, p03, color=color_basis_dev_3)
fill(p03, p04, color=color_basis_dev_4)
fill(p04, p05, color=color_basis_dev_5)
fill(p05, p06, color=color_basis_dev_6)
