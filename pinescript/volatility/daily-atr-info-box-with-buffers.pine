//@version=6
indicator("Daily ATR Info Box (Corner)", overlay=true)

//────────────────────────────────────────────
// AUTO-DETECT PIP SIZE
//────────────────────────────────────────────
symbol      = syminfo.tickerid
symbolUpper = str.upper(symbol)
isJPY       = str.contains(symbolUpper, "JPY")

autoPip = 
     syminfo.type == "forex" and isJPY      ? 0.01 :
     syminfo.type == "forex" and not isJPY  ? 0.0001 :
     syminfo.type == "index"                ? 1 :
     str.contains(symbolUpper, "XAU")       ? 0.1 :
     str.contains(symbolUpper, "GOLD")      ? 0.1 :
     str.contains(symbolUpper, "OIL")       ? 0.01 :
     syminfo.type == "crypto"               ? 1 :
                                             syminfo.mintick

useAutoPip     = input.bool(true,  "Auto Select Pip Size")
manualPipSize  = input.float(0.0001, "Manual Pip Size", minval=0.0000001)
pipSize        = useAutoPip ? autoPip : manualPipSize

//────────────────────────────────────────────
// USER INPUTS
//────────────────────────────────────────────
atrLength      = input.int(14, "ATR Length", minval=1)
corner         = input.string("Top Right", "Panel Position", options=["Top Left","Top Right","Bottom Left","Bottom Right"])
showRangeClass = input.bool(true, "Show Current Range vs ATR")
txtColor       = input.color(color.white, "Text Colour")

//────────────────────────────────────────────
// ATR CALCULATIONS
//────────────────────────────────────────────
dailyATR = request.security(syminfo.tickerid, "D", ta.atr(atrLength))
atrPips  = dailyATR / pipSize
atr10    = atrPips * 0.10
atr5     = atrPips * 0.05

//────────────────────────────────────────────
// CURRENT DAILY RANGE
//────────────────────────────────────────────
dailyHigh    = request.security(syminfo.tickerid, "D", high)
dailyLow     = request.security(syminfo.tickerid, "D", low)
currentRange = (dailyHigh - dailyLow) / pipSize

rangePct = currentRange / atrPips * 100

rangeClass = rangePct < 30 ? "Very Small" :
             rangePct < 60 ? "Small" :
             rangePct < 90 ? "Normal" :
             rangePct < 120 ? "Large" : "Very Large"

//────────────────────────────────────────────
// CORNER POSITION
//────────────────────────────────────────────
pos = corner == "Top Left" ? position.top_left :
      corner == "Top Right" ? position.top_right :
      corner == "Bottom Left" ? position.bottom_left :
      position.bottom_right

//────────────────────────────────────────────
// TABLE SETUP (dynamic height based on toggle)
//────────────────────────────────────────────
rows = showRangeClass ? 6 : 4
var t = table.new(pos, 1, rows, border_width=1,
                  frame_color=color.new(color.white, 0),
                  border_color=color.new(color.white, 0))

//────────────────────────────────────────────
// TABLE UPDATE
//────────────────────────────────────────────
if barstate.islast
    table.cell(t, 0, 0, "📊 DAILY ATR", text_color=txtColor, bgcolor=color.new(color.blue, 60))
    table.cell(t, 0, 1, "ATR:  " + str.tostring(atrPips, "#.##") + " pips", text_color=txtColor)
    table.cell(t, 0, 2, "10%: " + str.tostring(atr10, "#.##") + " pips",   text_color=txtColor)
    table.cell(t, 0, 3, "5%:  " + str.tostring(atr5, "#.##") + " pips",    text_color=txtColor)

    if showRangeClass
        table.cell(t, 0, 4, "Current Range: " + str.tostring(currentRange, "#.##") + " pips", text_color=txtColor)
        table.cell(t, 0, 5, "Current Range Class: " + rangeClass, text_color=txtColor)
