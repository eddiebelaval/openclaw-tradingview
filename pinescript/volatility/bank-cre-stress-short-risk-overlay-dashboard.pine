//@version=6
indicator("🏦 Bank CRE Stress & Short Risk Overlay + Dashboard", overlay=true, max_labels_count=500, max_bars_back=500)

// ─────────────────────────────────────
// 📋 BANK RISK DATABASE (static, dashboard-aligned, latest known ~Q3/Q4 2025 exposures)
// Update manually from FDIC/FAU/FFIEC when new Call Reports drop
// ─────────────────────────────────────
criticalBanks = array.from("DCOM", "EGBN", "OZK", "LOB")          // Typically >500%
highBanks     = array.from("VLY", "FLG", "ZION", "WAL")           // ~375–480%
elevatedBanks = array.from("SNV", "RF", "CMA", "TFC")             // ~300–350%
shortBiasBanks= array.from("FVCB", "BHB", "VLY", "FLG", "EGBN")  // High-conviction shorts
failedBanks   = array.from("MCBT")                                // 2026 failure

// ─────────────────────────────────────
// Ticker check (case-insensitive)
ticker = str.upper(syminfo.ticker)

isCritical   = array.includes(criticalBanks,  ticker)
isHigh       = array.includes(highBanks,      ticker)
isElevated   = array.includes(elevatedBanks,  ticker)
isShortBias  = array.includes(shortBiasBanks, ticker)
isFailed     = array.includes(failedBanks,    ticker)

// ─────────────────────────────────────
// Price stress (breakdown conditions)
ema50   = ta.ema(close, 50)
ema200  = ta.ema(close, 200)
atr     = ta.atr(14)
atrAvg  = ta.sma(atr, 20)

trendBreak  = close < ema200
rangeBreak  = close < ta.lowest(low, 20)
volStress   = atr > atrAvg * 1.3   // tunable

priceStress = trendBreak and rangeBreak  // and volStress if you want stricter

// ─────────────────────────────────────
// Background color on stress bars
color bgColor = na
if isFailed
    bgColor := color.new(color.black, 75)
else if (isCritical or isShortBias) and priceStress
    bgColor := color.new(color.red, 80)
else if isHigh and priceStress
    bgColor := color.new(color.orange, 85)
else if isElevated and priceStress
    bgColor := color.new(color.yellow, 90)

bgcolor(bgColor)

// ─────────────────────────────────────
// Per-bar risk LABEL (only shows if relevant category)
var label riskLabel = na
label.delete(riskLabel[1])

string lblTxt = na
color  lblCol = na
if isFailed
    lblTxt := "❌ FAILED BANK\nFDIC Receivership"
    lblCol := color.black
else if isCritical or isShortBias
    lblTxt := "🔴 CRITICAL / SHORT BIAS\nHigh CRE + Breakdown"
    lblCol := color.red
else if isHigh
    lblTxt := "🟠 HIGH CRE RISK\nMonitor Short Setup"
    lblCol := color.orange
else if isElevated
    lblTxt := "🟡 ELEVATED CRE\nProvisions Watch"
    lblCol := color.yellow

if not na(lblTxt)
    riskLabel := label.new(bar_index, high, lblTxt,
         yloc=yloc.abovebar, style=label.style_label_down,
         color=lblCol, textcolor=color.white, size=size.normal)

// ─────────────────────────────────────
// FIXED DASHBOARD TABLE (top-right corner)
// ─────────────────────────────────────
var table dash = table.new(position.top_right, columns=1, rows=6,
     bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

// Only update on last bar (real-time efficiency)
if barstate.islastconfirmedhistory or barstate.isrealtime
    // Row 0: Title
    table.cell(dash, 0, 0, "🏦 Bank CRE Dashboard", text_color=color.white, text_size=size.large)
    
    // Row 1: Current Ticker Risk
    string riskLevel = isFailed ? "❌ FAILED" : isCritical ? "🔴 CRITICAL" : isShortBias ? "🔴 SHORT BIAS" : isHigh ? "🟠 HIGH" : isElevated ? "🟡 ELEVATED" : "🟢 LOW / NONE"
    color riskBg = isFailed ? color.black : isCritical or isShortBias ? color.red : isHigh ? color.orange : isElevated ? color.yellow : color.green
    table.cell(dash, 0, 1, ticker + "\nRisk: " + riskLevel, bgcolor=riskBg, text_color=color.white, text_size=size.normal)
    
    // Row 2: Price Stress
    string stressTxt = priceStress ? "🔥 STRESS ACTIVE\n(Trend + Range Break)" : "No Stress"
    table.cell(dash, 0, 2, stressTxt, bgcolor=priceStress ? color.new(color.red, 60) : color.new(color.gray, 80), text_color=color.white)
    
    // Row 3: EMA Status
    string emaStatus = close < ema200 ? "Below EMA200 → Bearish" : "Above EMA200"
    table.cell(dash, 0, 3, emaStatus, text_color=close < ema200 ? color.orange : color.lime)
    
    // Row 4: Quick High-Risk Watchlist (static)
    table.cell(dash, 0, 4, "High Risk Watch:\nDCOM EGBN OZK LOB\nVLY FLG ZION WAL", text_color=color.orange, text_size=size.small)
    
    // Row 5: Note / Update
    table.cell(dash, 0, 5, "Static data • Update quarterly\nNot advice • High risk", text_color=color.gray, text_size=size.tiny)

// ─────────────────────────────────────
// Plots
plot(ema50,  "EMA 50",  color.gray)
plot(ema200, "EMA 200", color.white)

// ─────────────────────────────────────
// Alerts
alertcondition(priceStress and (isCritical or isShortBias), title="Critical/Short Bias Breakdown", message="{{ticker}} CRE stress + breakdown!")
alertcondition(isFailed, title="Failed Bank Symbol", message="{{ticker}} in FDIC receivership")
