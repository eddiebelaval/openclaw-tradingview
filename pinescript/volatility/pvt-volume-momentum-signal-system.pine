//@version=5
indicator("PVT + Volume Momentum Signal System", overlay=true)

// ═════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═════════════════════════════════════════════════════════════════════════════
grpPVT = "PVT Settings"
pvtSmoothing = input.int(1, "PVT Smoothing", minval=1, group=grpPVT)
pvtAnchorLookback = input.int(200, "PVT Price Anchor Lookback", minval=50, group=grpPVT)

grpMA = "PVT Moving Averages"
ema10_show = input.bool(true, "Show EMA 10", group=grpMA)
ema10_col = input.color(color.orange, "EMA 10 Color", group=grpMA)
ema20_show = input.bool(true, "Show EMA 20", group=grpMA)
ema20_col = input.color(color.blue, "EMA 20 Color", group=grpMA)
ema50_show = input.bool(true, "Show EMA 50", group=grpMA)
ema50_col = input.color(color.purple, "EMA 50 Color", group=grpMA)

grpVol = "Volume Momentum Settings"
volLength = input.int(14, "Volume Momentum Length", minval=1, group=grpVol)
volSmoothing = input.int(3, "Volume Smoothing", minval=1, group=grpVol)
volEmaLength = input.int(20, "Volume Momentum EMA Length", minval=1, group=grpVol)

grpSig = "Signal Settings"
requireBoth = input.bool(true, "Require both PVT and Volume confirmation", group=grpSig)
showSignals = input.bool(true, "Show Buy/Sell Signals", group=grpSig)

// ═════════════════════════════════════════════════════════════════════════════
// PVT CALCULATION - ANCHORED TO PRICE
// ═════════════════════════════════════════════════════════════════════════════
// Calculate raw PVT with na protection
priceChange = close != 0 and close[1] != 0 ? (close - close[1]) / close[1] : 0
rawPVT = ta.cum(volume * priceChange)

// Smooth PVT
smoothedPVT = pvtSmoothing > 1 ? ta.sma(rawPVT, pvtSmoothing) : rawPVT

// Anchor PVT to current price level
pvtMean = ta.sma(smoothedPVT, pvtAnchorLookback)
pvtStd = ta.stdev(smoothedPVT, pvtAnchorLookback)
priceMean = ta.sma(close, pvtAnchorLookback)

// Scale PVT to price level
pvtLine = priceMean + (smoothedPVT - pvtMean) / (pvtStd != 0 ? pvtStd : 1) * (ta.atr(pvtAnchorLookback) * 2)

// ═════════════════════════════════════════════════════════════════════════════
// PVT EMAs
// ═════════════════════════════════════════════════════════════════════════════
pvtEMA10 = ta.ema(pvtLine, 10)
pvtEMA20 = ta.ema(pvtLine, 20)
pvtEMA50 = ta.ema(pvtLine, 50)

// ═════════════════════════════════════════════════════════════════════════════
// VOLUME MOMENTUM
// ═════════════════════════════════════════════════════════════════════════════
smoothVol = ta.sma(volume, volSmoothing)

// Volume momentum with division by zero protection
volChange = smoothVol[volLength] != 0 ? (smoothVol - smoothVol[volLength]) / smoothVol[volLength] * 100 : 0
volMomentum = volChange

// Volume Momentum EMA 20
volMomEMA20 = ta.ema(volMomentum, volEmaLength)

// ═════════════════════════════════════════════════════════════════════════════
// SIGNAL GENERATION
// ═════════════════════════════════════════════════════════════════════════════
pvtBullish = ta.crossover(pvtLine, pvtEMA20)
pvtBearish = ta.crossunder(pvtLine, pvtEMA20)

volBullish = ta.crossover(volMomentum, volMomEMA20)
volBearish = ta.crossunder(volMomentum, volMomEMA20)

buySignal = requireBoth ? (pvtBullish and volBullish) : pvtBullish
sellSignal = requireBoth ? (pvtBearish and volBearish) : pvtBearish

// ═════════════════════════════════════════════════════════════════════════════
// PLOTTING
// ═════════════════════════════════════════════════════════════════════════════
plot(pvtLine, "PVT Line", color.new(color.gray, 50), 1)
plot(ema10_show ? pvtEMA10 : na, "PVT EMA 10", ema10_col, 1)
plot(ema20_show ? pvtEMA20 : na, "PVT EMA 20", ema20_col, 2)
plot(ema50_show ? pvtEMA50 : na, "PVT EMA 50", ema50_col, 1)

plotshape(showSignals and buySignal, "Buy Signal", shape.triangleup, location.belowbar, color.green, size=size.normal, text="BUY", textcolor=color.white)
plotshape(showSignals and sellSignal, "Sell Signal", shape.triangledown, location.abovebar, color.red, size=size.normal, text="SELL", textcolor=color.white)

// Background highlight
bullishBg = pvtLine > pvtEMA20 and volMomentum > volMomEMA20
bearishBg = pvtLine < pvtEMA20 and volMomentum < volMomEMA20
bgcolor(bullishBg ? color.new(color.green, 90) : bearishBg ? color.new(color.red, 90) : na, title="Trend Background")

// ═════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═════════════════════════════════════════════════════════════════════════════
alertcondition(buySignal, "PVT + Volume Buy", "PVT crossed above EMA 20 with Volume Momentum confirmation")
alertcondition(sellSignal, "PVT + Volume Sell", "PVT crossed below EMA 20 with Volume Momentum confirmation")

// ═════════════════════════════════════════════════════════════════════════════
// INFO PANEL
// ═════════════════════════════════════════════════════════════════════════════
var table infoPanel = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 80), frame_width=1)

if barstate.islast
    table.cell(infoPanel, 0, 0, "PVT vs EMA20", text_color=color.white, text_size=size.tiny)
    table.cell(infoPanel, 1, 0, pvtLine > pvtEMA20 ? "BULLISH ✓" : "BEARISH ✗", 
               text_color=pvtLine > pvtEMA20 ? color.green : color.red, text_size=size.tiny)
    
    table.cell(infoPanel, 0, 1, "Vol Mom vs EMA20", text_color=color.white, text_size=size.tiny)
    table.cell(infoPanel, 1, 1, volMomentum > volMomEMA20 ? "BULLISH ✓" : "BEARISH ✗", 
               text_color=volMomentum > volMomEMA20 ? color.green : color.red, text_size=size.tiny)
    
    table.cell(infoPanel, 0, 2, "PVT Value", text_color=color.white, text_size=size.tiny)
    table.cell(infoPanel, 1, 2, str.tostring(pvtLine, "#.##"), text_color=color.gray, text_size=size.tiny)
    
    table.cell(infoPanel, 0, 3, "Status", text_color=color.white, text_size=size.tiny)
    status = buySignal ? "🟢 BUY" : sellSignal ? "🔴 SELL" : "⚪ WAIT"
    statusColor = buySignal ? color.green : sellSignal ? color.red : color.gray
    table.cell(infoPanel, 1, 3, status, text_color=statusColor, text_size=size.tiny)
