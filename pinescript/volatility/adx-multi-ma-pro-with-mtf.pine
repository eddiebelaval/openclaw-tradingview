//@version=5
indicator("ADX Multi-MA Pro with MTF", 
         overlay=false, precision=2)

// ───────────────────────────────────────────────────────────────────────────
// ALL INPUTS
// ───────────────────────────────────────────────────────────────────────────

// ADX Mode Selection
adx_mode = input.string(defval="Scaled", title="ADX Mode", options=["Original", "Clipped", "Scaled"])

// Minimum Level for Clipped/Scaled Modes
min_level = input.float(defval=20, title="Minimum ADX Level", minval=0, maxval=100, step=1)

// ADX Parameters
adx_len = input.int(defval=14, title="ADX Smoothing", minval=1)
di_len = input.int(defval=14, title="DI Length", minval=1)

// Moving Average Periods
ma5_len = input.int(defval=5, title="MA 5 Length", minval=1)
ma9_len = input.int(defval=9, title="MA 9 Length", minval=1)
ma10_len = input.int(defval=10, title="MA 10 Length", minval=1)
ma20_len = input.int(defval=20, title="MA 20 Length", minval=1)
ma50_len = input.int(defval=50, title="MA 50 Length", minval=1)
ma100_len = input.int(defval=100, title="MA 100 Length", minval=1)

// Moving Average Type Selection
ma_type = input.string(defval="EMA", title="Moving Average Type", 
                      options=["EMA", "DEMA", "TEMA", "KAUFMAN", "ALMA", "HULL"])

// ALMA Parameters
alma_offset = input.float(defval=0.85, title="ALMA Offset", minval=0, maxval=1, step=0.05)
alma_sigma = input.float(defval=6, title="ALMA Sigma", minval=1, maxval=20, step=1)

// Kaufman Parameters
kaufman_fast = input.int(defval=2, title="Kaufman Fast SC", minval=1, maxval=10)
kaufman_slow = input.int(defval=30, title="Kaufman Slow SC", minval=10, maxval=100)

// Colors for all MAs
ma5_col = input.color(defval=color.purple, title="MA 5 Color")
ma9_col = input.color(defval=color.blue, title="MA 9 Color")
ma10_col = input.color(defval=color.teal, title="MA 10 Color")
ma20_col = input.color(defval=color.green, title="MA 20 Color")
ma50_col = input.color(defval=color.orange, title="MA 50 Color")
ma100_col = input.color(defval=color.red, title="MA 100 Color")

// ADX Line Color
adx_col = input.color(defval=color.gray, title="ADX Line Color")

// Threshold Line 20
show_thresh20 = input.bool(defval=true, title="Show Threshold 20")
thresh20_col = input.color(defval=color.gray, title="Threshold 20 Color")

// Threshold Line 25
show_thresh25 = input.bool(defval=true, title="Show Threshold 25")
thresh25_col = input.color(defval=color.gray, title="Threshold 25 Color")

// Threshold Line 30
show_thresh30 = input.bool(defval=true, title="Show Threshold 30")
thresh30_col = input.color(defval=color.gray, title="Threshold 30 Color")

// Threshold Line 35
show_thresh35 = input.bool(defval=true, title="Show Threshold 35")
thresh35_col = input.color(defval=color.gray, title="Threshold 35 Color")

// ───────────────────────────────────────────────────────────────────────────
// MTF (Multi-TimeFrame) INPUTS
// ───────────────────────────────────────────────────────────────────────────

// MTF Enable Toggle
enable_mtf = input.bool(defval=false, title="🔷 Enable MTF Overlay")

// MTF Timeframes Selection
mtf1_tf = input.string(defval="60", title="MTF 1 Timeframe", options=["5", "15", "30", "60", "120", "240", "D", "W", "M"])
mtf2_tf = input.string(defval="240", title="MTF 2 Timeframe", options=["5", "15", "30", "60", "120", "240", "D", "W", "M"])
mtf3_tf = input.string(defval="D", title="MTF 3 Timeframe", options=["5", "15", "30", "60", "120", "240", "D", "W", "M"])

// MTF Colors
mtf1_col = input.color(defval=color.new(color.blue, 70), title="MTF 1 Color")
mtf2_col = input.color(defval=color.new(color.orange, 70), title="MTF 2 Color")
mtf3_col = input.color(defval=color.new(color.purple, 70), title="MTF 3 Color")

// MTF Line Width
mtf_linewidth = input.int(defval=2, title="MTF Line Width", minval=1, maxval=4)

// Display Options
glow_enable = input.bool(defval=false, title="Enable Glow Effect on ADX")

// ───────────────────────────────────────────────────────────────────────────
// CALCULATIONS
// ───────────────────────────────────────────────────────────────────────────

// Calculate raw ADX first
[diplus, diminus, raw_adx] = ta.dmi(di_len, adx_len)

// Apply ADX transformation based on selected mode
scaling_factor = (100 - min_level) / 100

// Determine ADX line based on mode
adx = if adx_mode == "Original"
    raw_adx
else if adx_mode == "Clipped"
    math.max(raw_adx, min_level)
else
    min_level + raw_adx * scaling_factor

// ───────────────────────────────────────────────────────────────────────────
// ADVANCED MA FUNCTIONS
// ───────────────────────────────────────────────────────────────────────────

// DEMA - Double Exponential Moving Average
dema(src, len) =>
    ema1 = ta.ema(src, len)
    ema2 = ta.ema(ema1, len)
    2 * ema1 - ema2

// TEMA - Triple Exponential Moving Average
tema(src, len) =>
    ema1 = ta.ema(src, len)
    ema2 = ta.ema(ema1, len)
    ema3 = ta.ema(ema2, len)
    3 * (ema1 - ema2) + ema3

// Kaufman Adaptive Moving Average
kaufman(src, len, fastSC, slowSC) =>
    change = math.abs(src - src[len])
    volatility = 0.0
    for i = 0 to len - 1
        volatility := volatility + math.abs(src[i] - src[i+1])
    er = change / volatility
    fast = 2.0 / (fastSC + 1.0)
    slow = 2.0 / (slowSC + 1.0)
    sc = er * (fast - slow) + slow
    sc := sc * sc
    kama = 0.0
    kama := sc * src + (1 - sc) * nz(kama[1], src)
    kama

// ALMA - Arnaud Legoux Moving Average
alma(src, len, offset, sigma) =>
    m = math.floor(offset * (len - 1))
    s = len / sigma
    sum = 0.0
    wsum = 0.0
    for i = 0 to len - 1
        w = math.exp(-math.pow(i - m, 2) / (2 * s * s))
        sum := sum + src[i] * w
        wsum := wsum + w
    sum / wsum

// Hull Moving Average
hull(src, len) =>
    wma1 = ta.wma(src, len / 2)
    wma2 = ta.wma(src, len)
    ta.wma(2 * wma1 - wma2, math.round(math.sqrt(len)))

// Master MA function
f_ma(src, len, type) =>
    if type == "EMA"
        ta.ema(src, len)
    else if type == "DEMA"
        dema(src, len)
    else if type == "TEMA"
        tema(src, len)
    else if type == "KAUFMAN"
        kaufman(src, len, kaufman_fast, kaufman_slow)
    else if type == "ALMA"
        alma(src, len, alma_offset, alma_sigma)
    else if type == "HULL"
        hull(src, len)
    else
        ta.ema(src, len)

// ───────────────────────────────────────────────────────────────────────────
// CALCULATE MOVING AVERAGES
// ───────────────────────────────────────────────────────────────────────────

// Calculate all moving averages on the ADX line
ma5 = f_ma(adx, ma5_len, ma_type)
ma9 = f_ma(adx, ma9_len, ma_type)
ma10 = f_ma(adx, ma10_len, ma_type)
ma20 = f_ma(adx, ma20_len, ma_type)
ma50 = f_ma(adx, ma50_len, ma_type)
ma100 = f_ma(adx, ma100_len, ma_type)

// ───────────────────────────────────────────────────────────────────────────
// MTF FUNCTIONS & CALCULATIONS
// ───────────────────────────────────────────────────────────────────────────

// Function to get ADX from higher timeframe
f_mtf_adx(_tf) =>
    // Request higher timeframe data
    request.security(syminfo.tickerid, _tf, raw_adx)

// Calculate MTF ADX values directly (no initialization needed)
mtf1_raw = enable_mtf ? f_mtf_adx(mtf1_tf) : na
mtf2_raw = enable_mtf ? f_mtf_adx(mtf2_tf) : na
mtf3_raw = enable_mtf ? f_mtf_adx(mtf3_tf) : na

// Apply normalization to MTF values
mtf1 = if enable_mtf
    if adx_mode == "Original"
        mtf1_raw
    else if adx_mode == "Clipped"
        math.max(mtf1_raw, min_level)
    else
        min_level + mtf1_raw * ((100 - min_level) / 100)
else
    na

mtf2 = if enable_mtf
    if adx_mode == "Original"
        mtf2_raw
    else if adx_mode == "Clipped"
        math.max(mtf2_raw, min_level)
    else
        min_level + mtf2_raw * ((100 - min_level) / 100)
else
    na

mtf3 = if enable_mtf
    if adx_mode == "Original"
        mtf3_raw
    else if adx_mode == "Clipped"
        math.max(mtf3_raw, min_level)
    else
        min_level + mtf3_raw * ((100 - min_level) / 100)
else
    na

// ───────────────────────────────────────────────────────────────────────────
// PLOTTING
// ───────────────────────────────────────────────────────────────────────────

// ADX Glow (conditional)
plot(glow_enable ? adx : na, "ADX Glow", color=color.new(adx_col, 70), linewidth=4)

// Main ADX Line (always visible)
plot(adx, "ADX", color=adx_col, linewidth=2)

// Plot all moving averages of ADX
plot(ma5, "MA 5", color=ma5_col, linewidth=1)
plot(ma9, "MA 9", color=ma9_col, linewidth=1)
plot(ma10, "MA 10", color=ma10_col, linewidth=1)
plot(ma20, "MA 20", color=ma20_col, linewidth=1)
plot(ma50, "MA 50", color=ma50_col, linewidth=1)
plot(ma100, "MA 100", color=ma100_col, linewidth=1)

// ───────────────────────────────────────────────────────────────────────────
// PLOT MTF LINES
// ───────────────────────────────────────────────────────────────────────────

plot(enable_mtf ? mtf1 : na, "MTF 1", color=mtf1_col, linewidth=mtf_linewidth)
plot(enable_mtf ? mtf2 : na, "MTF 2", color=mtf2_col, linewidth=mtf_linewidth)
plot(enable_mtf ? mtf3 : na, "MTF 3", color=mtf3_col, linewidth=mtf_linewidth)

// Threshold Line 20
plot(show_thresh20 ? 20 : na, "Threshold 20", color=thresh20_col, linewidth=1, style=plot.style_line)

// Threshold Line 25
plot(show_thresh25 ? 25 : na, "Threshold 25", color=thresh25_col, linewidth=1, style=plot.style_line)

// Threshold Line 30
plot(show_thresh30 ? 30 : na, "Threshold 30", color=thresh30_col, linewidth=1, style=plot.style_line)

// Threshold Line 35
plot(show_thresh35 ? 35 : na, "Threshold 35", color=thresh35_col, linewidth=1, style=plot.style_line)
