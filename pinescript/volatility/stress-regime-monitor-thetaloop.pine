//@version=6
indicator("Z-Score Vanilla [ThetaLoop]", shorttitle="Z-Score V", overlay=false, precision=2)

// ═══════════════════════════════════════════════════════════════
//  Z-SCORE VANILLA — Pure Statistical Deviation Indicator
//  by ThetaLoop Research
//
//  A clean, no-frills Z-Score that works on ANY symbol or data.
//  Measures how many standard deviations the current value is
//  from its own rolling mean — regime-independent by design.
//
//  Recommended sources:
//    • FRED:BAMLH0A0HYM2  — Credit Spread stress monitor
//    • ^VIX               — Volatility context
//    • Any price series   — Mean-reversion setups
// ═══════════════════════════════════════════════════════════════

// ─── INPUTS ───────────────────────────────────────────────────
grp_calc   = "Z-Score Settings"
length     = input.int   (20,   "Lookback Period",    minval=5, maxval=200, group=grp_calc,
                          tooltip="Rolling window for mean and standard deviation (trading days)")
src        = input.source(close, "Source",            group=grp_calc)

grp_levels = "Threshold Levels"
upper_alert = input.float( 2.0, "Upper Alert (σ)",   minval=0.5,  step=0.25, group=grp_levels)
upper_warn  = input.float( 1.5, "Upper Warning (σ)", minval=0.5,  step=0.25, group=grp_levels)
lower_warn  = input.float(-1.5, "Lower Warning (σ)", maxval=-0.5, step=0.25, group=grp_levels)
lower_alert = input.float(-2.0, "Lower Alert (σ)",   maxval=-0.5, step=0.25, group=grp_levels)

grp_style  = "Display"
show_fill  = input.bool(true,  "Show background fill",    group=grp_style)
show_ma    = input.bool(false, "Show smoothed Z (EMA 3)", group=grp_style)

// ─── CALCULATION ──────────────────────────────────────────────
mean    = ta.sma(src, length)
stddev  = ta.stdev(src, length)

// v6: explicit comparison required (no implicit float→bool cast)
zscore  = stddev != 0.0 ? (src - mean) / stddev : 0.0
zsmooth = ta.ema(zscore, 3)

// ─── COLORS ───────────────────────────────────────────────────
col_alert = color.new(color.red,    0)
col_warn  = color.new(color.orange, 0)
col_neut  = color.new(color.teal,   0)

bar_col = zscore >  upper_alert ? col_alert :
          zscore >  upper_warn  ? col_warn  :
          zscore <  lower_alert ? col_alert :
          zscore <  lower_warn  ? col_warn  : col_neut

// ─── PLOTS ────────────────────────────────────────────────────
plot(zscore,                          "Z-Score",           color=bar_col,                        linewidth=2)
plot(show_ma ? zsmooth : na,          "Z Smoothed (EMA3)", color=color.new(color.white, 50),     linewidth=1)

hline(0,            "Zero",           color=color.new(color.gray, 50))
h_ua = hline( upper_alert, "+Xσ Alert",  color=col_alert, linewidth=2)
h_uw = hline( upper_warn,  "+Xσ Warn",   color=col_warn,  linewidth=1, linestyle=hline.style_dashed)
h_lw = hline( lower_warn,  "-Xσ Warn",   color=col_warn,  linewidth=1, linestyle=hline.style_dashed)
h_la = hline( lower_alert, "-Xσ Alert",  color=col_alert, linewidth=2)

// Background fills
h_top = hline( 3.5, display=display.none)
h_bot = hline(-3.5, display=display.none)
fill(h_ua, h_top, color=show_fill ? color.new(color.red,   88) : na)
fill(h_la, h_bot, color=show_fill ? color.new(color.green, 88) : na)

// ─── INFO TABLE ───────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 4,
     bgcolor=color.new(color.black, 70), border_width=1, border_color=color.new(color.gray, 60))

if barstate.islast
    table.cell(t, 0, 0, "Z-Score", text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 0, str.tostring(zscore, "#.##"),
               text_color=bar_col, text_size=size.normal, text_font_family=font.family_monospace)
    table.cell(t, 0, 1, "Mean",    text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 1, str.tostring(mean,   "#.###"),
               text_color=color.white, text_size=size.small, text_font_family=font.family_monospace)
    table.cell(t, 0, 2, "StdDev",  text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 2, str.tostring(stddev, "#.###"),
               text_color=color.white, text_size=size.small, text_font_family=font.family_monospace)
    table.cell(t, 0, 3, "Period",  text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 3, str.tostring(length) + "d",
               text_color=color.white, text_size=size.small)

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(zscore > upper_alert,                              "Z > +2σ (Stress)",         "Z-Score exceeded +2σ")
alertcondition(zscore < upper_alert and zscore[1] >= upper_alert, "Z crossed back below +2σ", "Z-Score normalized")
alertcondition(zscore < lower_alert,                              "Z < -2σ (Extreme Low)",    "Z-Score dropped below -2σ")
