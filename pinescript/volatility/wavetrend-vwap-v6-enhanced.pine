//@version=6
indicator(title="WaveTrend + VWAP [v6 Enhanced]", shorttitle="WT_VWAP_v6", overlay=false)

// ─── INPUTS ───────────────────────────────────────────────
n1         = input.int(10,   "Channel Length",      minval=1)
n2         = input.int(21,   "Average Length",      minval=1)
obLevel1   = input.int(60,   "OB Level 1 Strong",  minval=1)
obLevel2   = input.int(53,   "OB Level 2 Mild",    minval=1)
osLevel1   = input.int(-60,  "OS Level 1 Strong",  maxval=-1)
osLevel2   = input.int(-53,  "OS Level 2 Mild",    maxval=-1)
showLabels = input.bool(true, "Show BUY/SELL Labels")
showBarClr = input.bool(true, "Color Candles")

// ─── WAVETREND ────────────────────────────────────────────
ap     = hlc3
esa    = ta.ema(ap, n1)
d      = ta.ema(math.abs(ap - esa), n1)
ci     = (ap - esa) / (0.015 * d)
tci    = ta.ema(ci, n2)
wt1    = tci
wt2    = ta.sma(wt1, 4)
wtDiff = wt1 - wt2

// ─── VWAP ─────────────────────────────────────────────────
vwapVal   = ta.vwap(hlc3)
aboveVwap = close > vwapVal
belowVwap = close < vwapVal

// ─── CROSS DETECTION ──────────────────────────────────────
wtCross     = ta.cross(wt1, wt2)
wtCrossBull = wtCross and wt1 > wt2
wtCrossBear = wtCross and wt1 < wt2

// ─── ZONES ────────────────────────────────────────────────
inOB       = wt2 >= obLevel2
inOS       = wt2 <= osLevel2
inStrongOB = wt2 >= obLevel1
inStrongOS = wt2 <= osLevel1

// ─── SIGNALS ──────────────────────────────────────────────
strongBuy  = wtCrossBull and inOS and aboveVwap
buySignal  = wtCrossBull and aboveVwap and not inOS
strongSell = wtCrossBear and inOB and belowVwap
sellSignal = wtCrossBear and belowVwap and not inOB

// ─── CANDLE COLOR ─────────────────────────────────────────
// Only color reversal signal candles, all others stay default
candleColor = strongBuy  ? color.new(color.lime,   0) :
              buySignal  ? color.new(color.green,  0) :
              strongSell ? color.new(color.red,    0) :
              sellSignal ? color.new(color.orange, 0) :
              na

barcolor(showBarClr ? candleColor : na)

// ─── PLOTS ────────────────────────────────────────────────
plot(0,        "Zero",      color=color.new(color.gray,  30))
plot(obLevel1, "OB Strong", color=color.new(color.red,   20))
plot(obLevel2, "OB Mild",   color=color.new(color.red,   55))
plot(osLevel1, "OS Strong", color=color.new(color.green, 20))
plot(osLevel2, "OS Mild",   color=color.new(color.green, 55))

vwapBias = aboveVwap ? 3.0 : -3.0
plot(vwapBias, "VWAP Bias", color=color.new(color.aqua, 50), style=plot.style_stepline)

plot(wt1,    "WT1",     color=color.new(color.green, 0), linewidth=2)
plot(wt2,    "WT2",     color=color.new(color.red,   0), linewidth=2)
plot(wtDiff, "WT Diff", color=color.new(color.blue, 75), style=plot.style_area)

plot(wtCross ? wt2 : na, "Cross BG", color=color.new(color.black, 0), style=plot.style_circles, linewidth=4)

crossColor = wtCrossBull ? color.new(color.lime, 0) : color.new(color.red, 0)
plot(wtCross ? wt2 : na, "Cross FG", color=crossColor, style=plot.style_circles, linewidth=2)

// ─── LABELS ───────────────────────────────────────────────
if showLabels
    if strongBuy
        label.new(bar_index, wt2 - 5, "STRONG BUY", color=color.lime,   textcolor=color.black, style=label.style_label_up,   size=size.small)
    else if buySignal
        label.new(bar_index, wt2 - 5, "BUY",        color=color.green,  textcolor=color.white, style=label.style_label_up,   size=size.small)
    else if strongSell
        label.new(bar_index, wt2 + 5, "STRONG SELL",color=color.red,    textcolor=color.white, style=label.style_label_down, size=size.small)
    else if sellSignal
        label.new(bar_index, wt2 + 5, "SELL",       color=color.orange, textcolor=color.white, style=label.style_label_down, size=size.small)

// ─── ALERTS ───────────────────────────────────────────────
alertcondition(strongBuy,  "Strong BUY",  "WT+VWAP: STRONG BUY")
alertcondition(buySignal,  "BUY",         "WT+VWAP: BUY")
alertcondition(strongSell, "Strong SELL", "WT+VWAP: STRONG SELL")
alertcondition(sellSignal, "SELL",        "WT+VWAP: SELL")

// ─── INFO TABLE ───────────────────────────────────────────
var table tbl = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 70), border_color=color.new(color.gray, 50), border_width=1)

if barstate.islast
    bias    = aboveVwap ? "BULLISH" : "BEARISH"
    biasClr = aboveVwap ? color.lime : color.red
    zone    = inStrongOB ? "Strong OB" : inOB ? "Mild OB" : inStrongOS ? "Strong OS" : inOS ? "Mild OS" : "Neutral"

    table.cell(tbl, 0, 0, "VWAP Bias", text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 0, bias,        text_color=biasClr,      text_size=size.small)
    table.cell(tbl, 0, 1, "WT Zone",   text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 1, zone,        text_color=color.white,  text_size=size.small)
    table.cell(tbl, 0, 2, "WT1",       text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(math.round(wt1, 2)), text_color=color.green, text_size=size.small)
    table.cell(tbl, 0, 3, "WT2",       text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(math.round(wt2, 2)), text_color=color.red,   text_size=size.small)
    table.cell(tbl, 0, 4, "VWAP",      text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 4, str.tostring(math.round(vwapVal, 2)), text_color=color.aqua, text_size=size.small)
