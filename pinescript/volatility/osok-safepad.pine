//@version=6
indicator("OSOK SafePad", overlay=true, max_lines_count=10)

// ──────────────────────────────────────────────────────────
// Inputs
// ──────────────────────────────────────────────────────────

// Pad
padSize   = input.float(25.0, title="Pad Size (Points)", minval=0.01, step=1.0, group="SafePad",
             tooltip="Distance in points above and below the reference price.")
orderSize = input.int(6, title="Order Size (Contracts)", minval=1, step=1, group="SafePad",
             tooltip="Number of contracts/shares per order. Used to convert USD targets to price distance.")

// Upper line
upperClr = input.color(color.blue, title="Color", group="Upper Line")
upperSty = input.string("Solid", title="Style", options=["Solid", "Dashed", "Dotted"], group="Upper Line")
upperWid = input.int(2, title="Width", minval=1, maxval=10, group="Upper Line")

// Lower line
lowerClr = input.color(color.red, title="Color", group="Lower Line")
lowerSty = input.string("Solid", title="Style", options=["Solid", "Dashed", "Dotted"], group="Lower Line")
lowerWid = input.int(2, title="Width", minval=1, maxval=10, group="Lower Line")

// Freeze
freezeOn      = input.bool(true, title="Enable Freeze", group="Freeze",
                 tooltip="Lock pad lines at the start of the session window below.")
freezeSession = input.session("0830-1659", title="Freeze Window", group="Freeze",
                 tooltip="Lines freeze at the START of this window and remain frozen for the rest of the day.")
freezeTZ      = input.string("America/New_York", title="Timezone", options=[
                 "America/New_York", "America/Chicago", "America/Denver", "America/Los_Angeles",
                 "Europe/London", "Europe/Berlin", "Europe/Paris", "Europe/Moscow",
                 "Asia/Tokyo", "Asia/Hong_Kong", "Asia/Shanghai", "Asia/Singapore", "Asia/Kolkata",
                 "Australia/Sydney", "Pacific/Auckland", "UTC"],
                 group="Freeze")

// Take Profit lines
showTP = input.bool(true, title="Show Take Profit", group="Take Profit",
          tooltip="Draw take-profit level lines for both buy-stop and sell-stop entries.")
tpAmt  = input.float(3000.0, title="Target ($)", minval=0.01, step=100.0, group="Take Profit",
          tooltip="Total take-profit in account currency across all contracts.")
tpClr  = input.color(color.green, title="Color", group="Take Profit")
tpSty  = input.string("Dashed", title="Style", options=["Solid", "Dashed", "Dotted"], group="Take Profit")
tpWid  = input.int(1, title="Width", minval=1, maxval=10, group="Take Profit")

// Stop Loss lines
showSL = input.bool(false, title="Show Stop Loss", group="Stop Loss",
          tooltip="Draw stop-loss level lines for both buy-stop and sell-stop entries.")
slAmt  = input.float(2000.0, title="Target ($)", minval=0.01, step=100.0, group="Stop Loss",
          tooltip="Total stop-loss in account currency across all contracts.")
slClr  = input.color(color.orange, title="Color", group="Stop Loss")
slSty  = input.string("Dashed", title="Style", options=["Solid", "Dashed", "Dotted"], group="Stop Loss")
slWid  = input.int(1, title="Width", minval=1, maxval=10, group="Stop Loss")

// ──────────────────────────────────────────────────────────
// Helpers
// ──────────────────────────────────────────────────────────

getLineStyle(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

// ──────────────────────────────────────────────────────────
// Freeze Logic
// ──────────────────────────────────────────────────────────

var float frozenPrice   = na
var bool  isFrozen      = false
var int   freezeBarIdx  = na
var int   prevDay       = -1

currDay = dayofmonth(time, freezeTZ)

// Reset on new calendar day in the selected timezone
if currDay != prevDay
    frozenPrice  := na
    isFrozen     := false
    freezeBarIdx := na
    prevDay      := currDay

// Detect whether the current bar falls inside the freeze session
inFreezeWindow = not na(time(timeframe.period, freezeSession, freezeTZ))

// Capture price on the first bar that enters the freeze window
if freezeOn and not isFrozen and inFreezeWindow
    frozenPrice  := open
    freezeBarIdx := bar_index
    isFrozen     := true

// ──────────────────────────────────────────────────────────
// Compute Pad Levels
// ──────────────────────────────────────────────────────────

refPrice   = freezeOn and isFrozen and not na(frozenPrice) ? frozenPrice : close
upperLevel = refPrice + padSize
lowerLevel = refPrice - padSize

// TP / SL distances in price units (USD → points)
// e.g. NQ: pointvalue=20, orderSize=6 → $3000 / (20*6) = 25 pts
pointVal = syminfo.pointvalue != 0 ? syminfo.pointvalue : 1.0
tpPoints = tpAmt / (pointVal * orderSize)
slPoints = slAmt / (pointVal * orderSize)

// Buy-stop entry at upperLevel (long)
buyTpLevel  = upperLevel + tpPoints
buySlLevel  = upperLevel - slPoints

// Sell-stop entry at lowerLevel (short)
sellTpLevel = lowerLevel - tpPoints
sellSlLevel = lowerLevel + slPoints

// ──────────────────────────────────────────────────────────
// Draw Lines (recreated every tick on the realtime bar)
// ──────────────────────────────────────────────────────────

var line upperLine  = na
var line lowerLine  = na
var line buyTpLine  = na
var line buySlLine  = na
var line sellTpLine = na
var line sellSlLine = na

if barstate.islast
    // Delete all existing lines
    if not na(upperLine)
        line.delete(upperLine)
    if not na(lowerLine)
        line.delete(lowerLine)
    if not na(buyTpLine)
        line.delete(buyTpLine)
    if not na(buySlLine)
        line.delete(buySlLine)
    if not na(sellTpLine)
        line.delete(sellTpLine)
    if not na(sellSlLine)
        line.delete(sellSlLine)

    // When frozen, lines start from the freeze candle; otherwise from the current bar
    startBar = isFrozen and not na(freezeBarIdx) ? freezeBarIdx : bar_index

    // Pad lines
    upperLine := line.new(
         x1     = startBar,
         y1     = upperLevel,
         x2     = startBar + 1,
         y2     = upperLevel,
         xloc   = xloc.bar_index,
         extend = extend.right,
         color  = upperClr,
         style  = getLineStyle(upperSty),
         width  = upperWid)

    lowerLine := line.new(
         x1     = startBar,
         y1     = lowerLevel,
         x2     = startBar + 1,
         y2     = lowerLevel,
         xloc   = xloc.bar_index,
         extend = extend.right,
         color  = lowerClr,
         style  = getLineStyle(lowerSty),
         width  = lowerWid)

    // Take Profit lines
    if showTP
        buyTpLine := line.new(
             x1     = startBar,
             y1     = buyTpLevel,
             x2     = startBar + 1,
             y2     = buyTpLevel,
             xloc   = xloc.bar_index,
             extend = extend.right,
             color  = tpClr,
             style  = getLineStyle(tpSty),
             width  = tpWid)

        sellTpLine := line.new(
             x1     = startBar,
             y1     = sellTpLevel,
             x2     = startBar + 1,
             y2     = sellTpLevel,
             xloc   = xloc.bar_index,
             extend = extend.right,
             color  = tpClr,
             style  = getLineStyle(tpSty),
             width  = tpWid)

    // Stop Loss lines
    if showSL
        buySlLine := line.new(
             x1     = startBar,
             y1     = buySlLevel,
             x2     = startBar + 1,
             y2     = buySlLevel,
             xloc   = xloc.bar_index,
             extend = extend.right,
             color  = slClr,
             style  = getLineStyle(slSty),
             width  = slWid)

        sellSlLine := line.new(
             x1     = startBar,
             y1     = sellSlLevel,
             x2     = startBar + 1,
             y2     = sellSlLevel,
             xloc   = xloc.bar_index,
             extend = extend.right,
             color  = slClr,
             style  = getLineStyle(slSty),
             width  = slWid)

// ──────────────────────────────────────────────────────────
// Data Window & Status Line
// ──────────────────────────────────────────────────────────

plot(upperLevel, "Upper Pad", color=color.new(upperClr, 100), display=display.data_window + display.status_line)
plot(lowerLevel, "Lower Pad", color=color.new(lowerClr, 100), display=display.data_window + display.status_line)
plot(refPrice,   "Ref Price", color=color.new(color.gray, 100), display=display.data_window + display.status_line)
plot(showTP ? buyTpLevel  : na, "Buy TP",  color=color.new(tpClr, 100), display=display.data_window + display.status_line)
plot(showTP ? sellTpLevel : na, "Sell TP", color=color.new(tpClr, 100), display=display.data_window + display.status_line)
plot(showSL ? buySlLevel  : na, "Buy SL",  color=color.new(slClr, 100), display=display.data_window + display.status_line)
plot(showSL ? sellSlLevel : na, "Sell SL", color=color.new(slClr, 100), display=display.data_window + display.status_line)
