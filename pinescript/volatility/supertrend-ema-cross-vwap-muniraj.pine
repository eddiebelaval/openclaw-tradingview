//@version=5
indicator("Supertrend + EMA Cross + VWAP (Rajamathi)", overlay=true, timeframe="")

// ─────────────────────────────
// Inputs
// ─────────────────────────────
emaFastLen = input.int(9, "Fast EMA")
emaSlowLen = input.int(21, "Slow EMA")
atrPeriod = input.int(10, "Supertrend ATR Period")
atrMult = input.float(3.0, "Supertrend Multiplier")

// ─────────────────────────────
// EMA Calculation
// ─────────────────────────────
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

// ─────────────────────────────
// VWAP
// ─────────────────────────────
vwapVal = ta.vwap(close)

// ─────────────────────────────
// Supertrend Calculation
// ─────────────────────────────
[supertrend, direction] = ta.supertrend(atrMult, atrPeriod)

// ─────────────────────────────
// Conditions
// ─────────────────────────────
emaBull = emaFast > emaSlow
emaBear = emaFast < emaSlow

superBull = direction == 1
superBear = direction == -1

vwapBull = close > vwapVal
vwapBear = close < vwapVal

// Final Signal
buySignal = emaBull and superBull and vwapBull
sellSignal = emaBear and superBear and vwapBear

// ─────────────────────────────
// Plotting
// ─────────────────────────────
plot(emaFast, color=color.new(color.green, 0), title="EMA Fast")
plot(emaSlow, color=color.new(color.red, 0), title="EMA Slow")
plot(vwapVal, color=color.new(color.blue, 0), title="VWAP")

plot(supertrend, color = direction == 1 ? color.green : color.red, linewidth=2, title="Supertrend")

// Signals on chart
plotshape(buySignal, title="BUY", style=shape.labelup, color=color.green, text="BUY", size=size.tiny, location=location.belowbar)
plotshape(sellSignal, title="SELL", style=shape.labeldown, color=color.red, text="SELL", size=size.tiny, location=location.abovebar)
