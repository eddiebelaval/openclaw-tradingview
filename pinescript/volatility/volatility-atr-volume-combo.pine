//@version=6
indicator("NQ Volatility (ATR + Volume Combo)", shorttitle="NQ Vol", overlay=false)

// === Inputs ===
atrLength = input.int(14, "ATR Length")
volSmoothing = input.int(20, "Volume SMA Length")
atrWeight = input.float(0.5, "ATR Weight (0–1)", minval=0, maxval=1)
showLabels = input.bool(true, "Show Volatility Labels")

// === Core Calculations ===
// Average True Range
atrValue = ta.atr(atrLength)
atrNorm = atrValue / close * 100  // normalize ATR as % of price

// Volume and smoothed volume
avgVol = ta.sma(volume, volSmoothing)
volRatio = volume / avgVol

// === Combined Volatility Index ===
volatilityScore = atrWeight * atrNorm + (1 - atrWeight) * (volRatio * 100)
vScoreSmooth = ta.sma(volatilityScore, 5)
baseline = ta.sma(vScoreSmooth, 50)

// === Define Volatility Regimes ===
highVol = vScoreSmooth > baseline * 1.2
lowVol = vScoreSmooth < baseline * 0.8

// === Plotting ===
plot(vScoreSmooth, title="Volatility Score", color=color.new(color.orange, 0), linewidth=2)
plot(baseline, title="Volatility Baseline", color=color.new(color.gray, 60), linewidth=1, style=plot.style_line)

bgcolor(
     highVol ? color.new(color.red, 85) : 
     lowVol  ? color.new(color.green, 85) : na,
     title="Volatility Regime Background"
)

// === Labels Instead of Plotshapes ===
if showLabels
    if (highVol)
        label.new(bar_index, vScoreSmooth, "High Vol", 
            style=label.style_label_up, 
            color=color.new(color.red, 0), 
            textcolor=color.white, 
            size=size.tiny)
    if (lowVol)
        label.new(bar_index, vScoreSmooth, "Low Vol", 
            style=label.style_label_down, 
            color=color.new(color.green, 0), 
            textcolor=color.white, 
            size=size.tiny)

// === Optional Display Info ===
var label lbl = na
if barstate.islast
    label.delete(lbl)
    lbl := label.new(bar_index, vScoreSmooth, "Volatility: " + str.tostring(vScoreSmooth, "#.##"),
         style=label.style_label_left, color=color.new(color.orange, 70))
