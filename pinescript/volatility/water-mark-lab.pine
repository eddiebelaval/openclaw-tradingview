//@version=5
indicator("Water Mark LAB", shorttitle="Mark LAB", overlay=true)

// =======================================================================
// INTERFACE DE CONFIGURAÇÃO (PT-BR)
// =======================================================================
grp_title = "Configuração do Título"
i_show_title = input.bool(true, "Mostrar Título?", group=grp_title)
i_title = input.string("@wagnerhuhn_", "Texto do Título", group=grp_title)
i_col_title = input.color(color.new(#2e2e2e, 40), "Cor do Título", group=grp_title)
i_size_title = input.string("enorme", "Tamanho do Título", options=["minúsculo", "pequeno", "normal", "grande", "enorme", "automático"], group=grp_title)

grp_sub = "Configuração do Subtítulo"
i_show_sub = input.bool(true, "Mostrar Subtítulo?", group=grp_sub)
i_sub   = input.string("Smart Money Lab  ©", "Texto do Subtítulo", group=grp_sub)
i_col_sub = input.color(color.new(#2e2e2e, 40), "Cor do Subtítulo", group=grp_sub)
i_size_sub = input.string("grande", "Tamanho do Subtítulo", options=["minúsculo", "pequeno", "normal", "grande", "enorme", "automático"], group=grp_sub)

grp_insta = "Configuração do Instagram"
i_show_insta = input.bool(false, "Mostrar Instagram?", group=grp_insta)
i_insta = input.string("@_smartmoneylab e @wagnerhuhn_", "Seus @", group=grp_insta)
i_col_insta = input.color(color.new(#2e2e2e, 40), "Cor do Insta", group=grp_insta)
i_size_insta = input.string("normal", "Tamanho do Insta", options=["minúsculo", "pequeno", "normal", "grande", "enorme", "automático"], group=grp_insta)

grp_sym = "Informações do Gráfico"
i_show_sym = input.bool(true, "Mostrar Ativo e Tempo Gráfico?", group=grp_sym)
i_col_sym = input.color(color.new(#2e2e2e, 40), "Cor da Info", group=grp_sym)
// Tamanho alterado para "grande" conforme a sua preguiça exigiu
i_size_sym = input.string("grande", "Tamanho da Info", options=["minúsculo", "pequeno", "normal", "grande", "enorme", "automático"], group=grp_sym)

grp_pos = "Posicionamento no Gráfico"
i_pos_v = input.string("inferior", "Posição Vertical", options=["superior", "meio", "inferior"], group=grp_pos)
i_pos_h = input.string("direita", "Posição Horizontal", options=["esquerda", "centro", "direita"], group=grp_pos)

// =======================================================================
// TRADUÇÃO DAS OPÇÕES PARA O PINE SCRIPT
// =======================================================================
pos_v_str = i_pos_v == "superior" ? "top" : i_pos_v == "meio" ? "middle" : "bottom"
pos_h_str = i_pos_h == "esquerda" ? "left" : i_pos_h == "centro" ? "center" : "right"

get_size(s) =>
    s == "minúsculo" ? "tiny" : s == "pequeno" ? "small" : s == "normal" ? "normal" : s == "grande" ? "large" : s == "enorme" ? "huge" : "auto"

size_title_str = get_size(i_size_title)
size_sub_str   = get_size(i_size_sub)
size_insta_str = get_size(i_size_insta)
size_sym_str   = get_size(i_size_sym)

// =======================================================================
// LÓGICA DO INDICADOR E TEMPO GRÁFICO
// =======================================================================

var string tf_string = ""
if timeframe.isseconds
    tf_string := str.tostring(timeframe.multiplier) + "seg"
else if timeframe.isminutes
    if timeframe.multiplier >= 60
        tf_string := str.tostring(math.round(timeframe.multiplier / 60)) + "H (" + str.tostring(timeframe.multiplier) + "m)"
    else
        tf_string := str.tostring(timeframe.multiplier) + "m"
else if timeframe.isdaily
    tf_string := str.tostring(timeframe.multiplier) + "D"
else if timeframe.isweekly
    tf_string := str.tostring(timeframe.multiplier) + "S"
else if timeframe.ismonthly
    tf_string := str.tostring(timeframe.multiplier) + "M"
else
    tf_string := timeframe.period

string symbol_info = syminfo.ticker + " • " + tf_string

// Criação da Tabela com 4 linhas máximas (0 a 3)
var table watermark = table.new(pos_v_str + "_" + pos_h_str, 1, 4, bgcolor=color.new(color.white, 100), frame_color=color.new(color.white, 100), border_width=0)

if barstate.islast
    // Limpa todas as células primeiro para evitar texto fantasma
    for i = 0 to 3
        table.cell(watermark, 0, i, text="")
        
    // Lógica de empilhamento dinâmico
    int row_idx = 0
    
    if i_show_title
        table.cell(watermark, 0, row_idx, text=i_title, text_color=i_col_title, text_size=size_title_str)
        row_idx += 1
        
    if i_show_sub
        table.cell(watermark, 0, row_idx, text=i_sub, text_color=i_col_sub, text_size=size_sub_str)
        row_idx += 1
        
    if i_show_insta
        table.cell(watermark, 0, row_idx, text=i_insta, text_color=i_col_insta, text_size=size_insta_str)
        row_idx += 1
        
    if i_show_sym
        table.cell(watermark, 0, row_idx, text=symbol_info, text_color=i_col_sym, text_size=size_sym_str)
