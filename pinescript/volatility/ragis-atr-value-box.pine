//@version=6
indicator("Ragi's ATR Value Box", overlay=true)
//@version=6
// Inputs
length = input.int(14, "ATR Length")
threshold = input.float(15.0, "High ATR Threshold")

positionInput = input.string("Bottom Right", "Box Position",
     options = ["Top Left","Top Right","Bottom Left","Bottom Right","Top Middle","Bottom Middle"])

bgColor = input.color(color.rgb(35,35,35), "Box Background")
normalText = input.color(color.white, "Normal ATR Color")
highText = input.color(color.orange, "High ATR Color")
txtSize = input.string("Large", "Text Size", options=["Small","Normal","Large","Huge"])

// Convert position
pos = position.bottom_right
if positionInput == "Top Left"
    pos := position.top_left
if positionInput == "Top Right"
    pos := position.top_right
if positionInput == "Bottom Left"
    pos := position.bottom_left
if positionInput == "Top Middle"
    pos := position.top_center
if positionInput == "Bottom Middle"
    pos := position.bottom_center

// Convert text size
sizeValue = size.large
if txtSize == "Small"
    sizeValue := size.small
if txtSize == "Normal"
    sizeValue := size.normal
if txtSize == "Huge"
    sizeValue := size.huge

// ATR
atrValue = ta.atr(length)

// Color logic
textColor = atrValue >= threshold ? highText : normalText

// Create table once
var table atrTable = table.new(pos, 1, 1)

// Update table
table.cell(
     atrTable,
     0,
     0,
     "ATR " + str.tostring(atrValue, "#.##"),
     text_color = textColor,
     bgcolor = bgColor,
     text_size = sizeValue
)
