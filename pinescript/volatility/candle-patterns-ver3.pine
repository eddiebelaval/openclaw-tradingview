//@version=6

indicator('Candle Patterns Ver.3', shorttitle = 'Candles', overlay = true)

// === Inputs ===
showPB    = input.bool(true,  "Show Pin Bars")
showEG    = input.bool(true,  "Show Engulfing")
showStochX = input.bool(true, "Show Stch Cross at levels")
showDTrend = input.bool(true, "Show Daily Trend")
stochUpper = input.int(80, "Stoch Upper Limit")
stochLower = input.int(20, "Stoch Lower Limit")
lookback  = input.int(5, "Show patterns for last N candles", minval=2, maxval=200)
offsetPct = input.float(0.5, "Offset (% of candle range)", step=0.05)
shapeSize = input.string("small", "Shape size", options=["tiny", "small", "normal", "large"])

// Input for trend detection
trendLength = input.int(10, "Trend Length (Bars)", minval=1)
ma = ta.sma(close, trendLength)

// === NEW: Bollinger Bands Inputs ===
bbLength = input.int(20, "BB Length", minval=1)
bbMult = input.float(2.0, "BB StdDev Multiplier", minval=0.1, step=0.1)
bbTolerance = input.float(0.2, "BB Tolerance %", minval=0, step=0.1)
showBB = input.bool(true, "Show Bollinger Bands")

// === Calculate Bollinger Bands ===
bbBasis = ta.sma(close, bbLength)
bbDev = bbMult * ta.stdev(close, bbLength)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

// Plot Bollinger Bands
plot(showBB ? bbBasis : na, "BB Basis", color=color.blue, linewidth=1)
plot(showBB ? bbUpper : na, "BB Upper", color=color.red, linewidth=1)
plot(showBB ? bbLower : na, "BB Lower", color=color.green, linewidth=1)
fill(plot(showBB ? bbUpper : na), plot(showBB ? bbLower : na), color=color.new(color.blue, 95))

// === Helpers ===
body(o, c) => math.abs(c - o)
upperWick(h, o, c) => h - math.max(o, c)
lowerWick(l, o, c) => math.min(o, c) - l
candleRange(h, l) => h - l
pipSize = syminfo.mintick * 10

// === Pattern Detection ===
// Calculate the components of the candle
body = math.abs(close - open)
lower_shadow = math.min(open, close) - low
upper_shadow = high - math.max(open, close)
candle_range = high - low

// === Stochastic calculation - USING BUILT-IN ta.sma for smoothing ===
kLength = input.int(5, title="K Length", minval=1)
dLength = input.int(3, title="D Length", minval=1)
smoothK = input.int(3, title="Smooth K", minval=1)

// Method 1: Using TradingView's built-in stochastic (which already does smoothing)
stochK = ta.sma(ta.stoch(close, high, low, kLength), smoothK)
stochD = ta.sma(stochK, dLength)

// === Stochastic crossing position ===
// For BULLISH signal (UP arrow): %K crosses above %D while in or coming from oversold zone
bullishCross = ta.crossover(stochK, stochD)
// Check if EITHER current bar OR previous bar had values in oversold zone
inOversold = (stochK <= stochLower or stochD <= stochLower) or (stochK[1] <= stochLower or stochD[1] <= stochLower)
isStochCrossBelow = bullishCross and inOversold

// For BEARISH signal (DOWN arrow): %K crosses below %D while in or coming from overbought zone
bearishCross = ta.crossunder(stochK, stochD)
// Check if EITHER current bar OR previous bar had values in overbought zone
inOverbought = (stochK >= stochUpper or stochD >= stochUpper) or (stochK[1] >= stochUpper or stochD[1] >= stochUpper)
isStochCrossAbove = bearishCross and inOverbought

// Define the conditions for a Hammer
isBullishPB = lower_shadow > (2 * body) and close > (((high-low)/2)+low) and body > 0 and upper_shadow < body / 2 and body > 0

isBearishPB = showPB and close < open and upperWick(high, open, close) >= body(open, close) * 2 and lowerWick(low, open, close) <= body(open, close)

//Define Engulfing conditions
isBullishEG = showEG and close > open and close[1] < open[1] and close > open[1] and open < close[1]
isBearishEG = showEG and close < open and close[1] > open[1] and close < open[1] and open > close[1]

// === NEW: Check if Open is near Bollinger Bands ===
toleranceRange = bbLower * (bbTolerance / 100)
openNearLowerBB = open >= (bbLower - toleranceRange) and open <= (bbLower + toleranceRange)
openNearUpperBB = open >= (bbUpper - toleranceRange) and open <= (bbUpper + toleranceRange)

// === NEW: Engulfing at Bollinger Bands Conditions ===
// Bullish Engulfing after bearish bar opening near lower BB
bullishEG_at_LowerBB = isBullishEG and openNearLowerBB and close[1] < open[1]

// Bearish Engulfing after bullish bar opening near upper BB
bearishEG_at_UpperBB = isBearishEG and openNearUpperBB and close[1] > open[1]

// === Limit to last N bars ===
withinLookback = bar_index >= (bar_index - 5)

// === Plot Shapes ===
plotshape(isBullishPB and withinLookback, title="Bullish PB", style=shape.triangleup, location=location.belowbar, color=color.green, size="small", text="HMR", textcolor=color.white, show_last=lookback)
plotshape(isBearishPB and withinLookback, title="Bearish PB", style=shape.triangledown, location=location.abovebar, color=color.red, size="small", text="PBAR", textcolor=color.white, show_last=lookback)

plotshape(isBullishEG and withinLookback, title="Bullish Engulfing", style=shape.triangleup, location=location.belowbar, color=color.lime, size="small", text="EG", textcolor=color.white, show_last=lookback)
plotshape(isBearishEG and withinLookback, title="Bearish Engulfing", style=shape.triangledown, location=location.abovebar, color=color.orange, size="small", text="EG", textcolor=color.white, show_last=lookback)

// === NEW: Plot Engulfing at BB with different colors ===
plotshape(bullishEG_at_LowerBB and withinLookback, title="Bullish EG at Lower BB", style=shape.triangleup, location=location.belowbar, color=color.new(color.aqua, 0), size="normal", text="BB EG", textcolor=color.white, show_last=lookback)
plotshape(bearishEG_at_UpperBB and withinLookback, title="Bearish EG at Upper BB", style=shape.triangledown, location=location.abovebar, color=color.new(color.fuchsia, 0), size="normal", text="BB EG", textcolor=color.white, show_last=lookback)

// === Alerts ===
alertcondition(isBullishPB, title="Bullish PB", message="Bullish Pin Bar detected")
alertcondition(isBearishPB, title="Bearish PB", message="Bearish Pin Bar detected")
alertcondition(isBullishEG, title="Bullish EG", message="Bullish Engulfing detected")
alertcondition(isBearishEG, title="Bearish EG", message="Bearish Engulfing detected")
alertcondition(bullishEG_at_LowerBB, title="Bullish EG at Lower BB", message="Bullish Engulfing at Lower Bollinger Band")
alertcondition(bearishEG_at_UpperBB, title="Bearish EG at Upper BB", message="Bearish Engulfing at Upper Bollinger Band")

// === RND Numbers Inputs ===
var number_of_lines = input(6, title="Number of Lines")
var range_size = input(500, title="Range Size ")

// === Daily Trend Code ===
emaLen = input.int(200, "Daily EMA Length", minval=1)
showRND = input.bool(true,"Show RND Numbers")

// Daily data
dailyClose = request.security(syminfo.tickerid, "D", close)
dailyEma   = request.security(syminfo.tickerid, "D", ta.ema(close, emaLen))

// Trend
dailyTrendUp   = dailyClose > dailyEma
dailyTrendDown = dailyClose < dailyEma

isdailyUp = dailyClose > dailyEma
isdailyDown = dailyClose < dailyEma

// === NEW: Momentum using Daily EMA(50) ===
dailyEma50 = request.security(syminfo.tickerid, "D", ta.ema(close, 50))
momentumUp = dailyClose > dailyEma50
momentumDown = dailyClose < dailyEma50

/// === Display Trend + Momentum + Condition in Three Rows ===
var trendTable = table.new(position.top_right, 1, 3)

// Trend row
trendText = dailyTrendUp ? "🟢 DAILY TREND => UP\nOnly BUY" :
             dailyTrendDown ? "🔴 DAILY TREND => DOWN\nOnly SELL" :
             "⚪ DAILY TREND => FLAT\nNO TRADE"

trendColor = dailyTrendUp ? color.new(color.green, 0) :
               dailyTrendDown ? color.new(color.red, 0) :
               color.new(color.gray, 0)

// === TRADE CONDITION LOGIC ===
tradeConditionText = ""
tradeConditionColor = color.white

// BUY conditions
if dailyTrendUp and momentumUp
    tradeConditionText  := "🟢 CONDITIONS: READY TO BUY. \nCheck other parameters"
    tradeConditionColor := color.new(color.green, 0)

// SELL conditions
else if dailyTrendDown and momentumDown
    tradeConditionText  := "🔴 CONDITIONS: READY TO SELL.  \nCheck other parameters"
    tradeConditionColor := color.new(color.red, 0)

// WAIT conditions
else
    tradeConditionText  := "🟡 CONDITIONS: WAIT FOR DIRECTION"
    tradeConditionColor := color.new(color.navy, 0)

// === Update table each bar ===
if barstate.islast
    if showDTrend
        table.cell(trendTable, 0, 0, text = trendText, text_color = color.white, bgcolor = trendColor)
        table.cell(trendTable, 0, 2, text = tradeConditionText, text_color = color.white, bgcolor = tradeConditionColor)

//plot Stochastic - ONLY VALID SIGNALS (ALL HISTORY)
// Valid bullish cross - GREEN arrow with TRUE
plotshape(showStochX and isStochCrossBelow, title="Stoch X Bull TRUE", style=shape.triangleup, location=location.belowbar, color=color.green, size="small", text = "UP\nTRUE", textcolor=color.white)

// Valid bearish cross - ORANGE arrow with TRUE
plotshape(showStochX and isStochCrossAbove, title="Stoch X Bear TRUE", style=shape.triangledown, location=location.abovebar, color=color.orange, size="small", text="DOWN\nTRUE", textcolor=color.white)

// Debug circles removed - using labels instead

// === RND Numbers ===
var step = syminfo.mintick * range_size
if barstate.islast and showRND
    for counter = 0 to number_of_lines - 1
        stepUp = math.ceil(close / step) * step + (counter * step)
        line.new(bar_index, stepUp, bar_index - 1, stepUp, xloc=xloc.bar_index, extend=extend.both, color=color.gray, width=1, style=line.style_dashed)
        stepDown = math.floor(close / step) * step - (counter * step)
        line.new(bar_index, stepDown, bar_index - 1, stepDown, xloc=xloc.bar_index, extend=extend.both, color=color.gray, width=1, style=line.style_dashed)
