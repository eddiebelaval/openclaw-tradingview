//@version=6
indicator(title = "BTC Volatility-Weighted Trend Matrix [QuantAlgo]", overlay = true)

// ╔════════════════════════════════╗
// ║        USER SETTINGS           ║
// ╚════════════════════════════════╝

group_vol = "════ Volume Engine ════"
group_trend = "════ Trend Engine ════"
group_visual = "════ Visual Engine ════"

volLen     = input.int(40, "Volume MA Period", group = group_vol)
volFactor  = input.float(1.1, "Volume Strength Multiplier", step = 0.1, group = group_vol)

fastLen    = input.int(21, "Fast EMA Length", group = group_trend)
slowLen    = input.int(55, "Slow EMA Length", group = group_trend)
atrLen     = input.int(14, "ATR Length", group = group_trend)
atrFilter  = input.float(1.0, "ATR Volatility Threshold", step = 0.1, group = group_trend)

showBG     = input.bool(true, "Enable Background Bias", group = group_visual)
bullColor  = input.color(#00ff88, "Bull Color", group = group_visual)
bearColor  = input.color(#ff3355, "Bear Color", group = group_visual)

// ╔════════════════════════════════╗
// ║        CORE CALCULATIONS       ║
// ╚════════════════════════════════╝

// Volume Confirmation
avgVol = ta.sma(volume, volLen)
strongVol = volume > avgVol * volFactor

// Volatility Filter (BTC loves volatility expansion)
atrValue = ta.atr(atrLen)
atrMA = ta.sma(atrValue, atrLen)
highVolatility = atrValue > atrMA * atrFilter

// Trend Engine
fastEMA = ta.ema(close, fastLen)
slowEMA = ta.ema(close, slowLen)

bullTrend = fastEMA > slowEMA and strongVol and highVolatility
bearTrend = fastEMA < slowEMA and strongVol and highVolatility

// Trend Strength Meter (0-100)
emaDistance = math.abs(fastEMA - slowEMA)
strengthRaw = emaDistance / close
trendStrength = math.min(100, strengthRaw * 10000)

// State
var int trendState = 0
if bullTrend
    trendState := 1
if bearTrend
    trendState := -1

longSignal  = trendState == 1 and trendState[1] != 1
shortSignal = trendState == -1 and trendState[1] != -1

trendColor = trendState == 1 ? bullColor : bearColor

// ╔════════════════════════════════╗
// ║        VISUALIZATION           ║
// ╚════════════════════════════════╝

plot(fastEMA, title="Fast EMA", color=color.new(trendColor, 0), linewidth=2)
plot(slowEMA, title="Slow EMA", color=color.new(trendColor, 0), linewidth=2)

fill(plot(fastEMA), plot(slowEMA), color=color.new(trendColor, 85))

bgcolor(showBG ? color.new(trendColor, 92) : na)

// Strength Label
var label strengthLabel = na
if barstate.islast
    label.delete(strengthLabel)
    strengthLabel := label.new(bar_index, high, 
         "Trend Strength: " + str.tostring(math.round(trendStrength)) + "/100",
         style=label.style_label_down,
         color=trendColor,
         textcolor=color.white)

// ╔════════════════════════════════╗
// ║             ALERTS             ║
// ╚════════════════════════════════╝

alertcondition(longSignal,  title="BTC Bullish Expansion", message="BTC Trend Matrix turned BULLISH on {{interval}}")
alertcondition(shortSignal, title="BTC Bearish Expansion", message="BTC Trend Matrix turned BEARISH on {{interval}}")
alertcondition(longSignal or shortSignal, title="BTC Trend Change", message="BTC Trend Matrix direction changed")
