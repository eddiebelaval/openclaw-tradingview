//@version=6
indicator("VIX Range Levels", overlay = true, max_lines_count = 20, max_labels_count = 20)

// ── Inputs ─────────────────────────────────────────────────────────
i_multiplier = input.float(1.0, "Volatility Multiplier", minval = 0.5, maxval = 2.0, step = 0.1)
i_colUpper   = input.color(color.new(color.red,    0),  "Upper Color")
i_colLower   = input.color(color.new(color.lime,   0),  "Lower Color")
i_colFill1x  = input.color(color.new(color.gray,  85),  "1× Fill Color")
i_colFill15x = input.color(color.new(color.orange, 90), "1.5× Fill Color")
i_colFill2x  = input.color(color.new(color.red,    90), "2× Fill Color")
i_lineLen    = input.int(20, "Line Length (bars, right)", minval = 5, maxval = 100)

// ── Track the bar index where the current day began ────────────────
var int dayStartBar = na
if ta.change(time("D")) != 0
    dayStartBar := bar_index

// ── Data ───────────────────────────────────────────────────────────
float prevClose = close[1]
float vixValue  = request.security("NSE:INDIAVIX", "D", close[1], lookahead = barmerge.lookahead_off)

// ── Range Calculations (Rule of 16) ────────────────────────────────
float movePct  = (vixValue / 16.0) * i_multiplier
float expMove  = prevClose * movePct / 100.0

float upper1x  = prevClose + expMove
float lower1x  = prevClose - expMove
float upper15x = prevClose + expMove * 1.5
float lower15x = prevClose - expMove * 1.5
float upper2x  = prevClose + expMove * 2.0
float lower2x  = prevClose - expMove * 2.0

// ── Var declarations ──────────────────────────────────────────
var line     ln_upper2x  = line(na)
var line     ln_upper15x = line(na)
var line     ln_upper1x  = line(na)
var line     ln_mid      = line(na)
var line     ln_lower1x  = line(na)
var line     ln_lower15x = line(na)
var line     ln_lower2x  = line(na)
var linefill lf_1x       = linefill(na)
var linefill lf_15x_up   = linefill(na)
var linefill lf_15x_dn   = linefill(na)
var linefill lf_2x_up    = linefill(na)
var linefill lf_2x_dn    = linefill(na)
var label    lb_upper    = label(na)
var label    lb_lower    = label(na)

// ── Draw on last bar only ───────────────────────────────────────────
if barstate.islast
    // Delete previous drawings
    line.delete(ln_upper2x),  line.delete(ln_upper15x), line.delete(ln_upper1x)
    line.delete(ln_mid)
    line.delete(ln_lower1x),  line.delete(ln_lower15x), line.delete(ln_lower2x)
    linefill.delete(lf_1x),   linefill.delete(lf_15x_up), linefill.delete(lf_15x_dn)
    linefill.delete(lf_2x_up),linefill.delete(lf_2x_dn)
    label.delete(lb_upper),   label.delete(lb_lower)

    // x1 = first bar of today (left anchor at previous day boundary)
    // x2 = i_lineLen bars beyond the current bar (right projection)
    int x1 = na(dayStartBar) ? bar_index : dayStartBar
    int x2 = bar_index + i_lineLen

    // Draw horizontal lines spanning left-to-right
    ln_upper2x  := line.new(x1, upper2x,   x2, upper2x,   xloc = xloc.bar_index, color = color.new(i_colUpper, 25), width = 1, style = line.style_dashed)
    ln_upper15x := line.new(x1, upper15x,  x2, upper15x,  xloc = xloc.bar_index, color = color.new(i_colUpper, 45), width = 1, style = line.style_dashed)
    ln_upper1x  := line.new(x1, upper1x,   x2, upper1x,   xloc = xloc.bar_index, color = i_colUpper,                width = 2, style = line.style_solid)
    ln_mid      := line.new(x1, prevClose, x2, prevClose,  xloc = xloc.bar_index, color = color.yellow,              width = 1, style = line.style_dotted)
    ln_lower1x  := line.new(x1, lower1x,   x2, lower1x,   xloc = xloc.bar_index, color = i_colLower,                width = 2, style = line.style_solid)
    ln_lower15x := line.new(x1, lower15x,  x2, lower15x,  xloc = xloc.bar_index, color = color.new(i_colLower, 45), width = 1, style = line.style_dashed)
    ln_lower2x  := line.new(x1, lower2x,   x2, lower2x,   xloc = xloc.bar_index, color = color.new(i_colLower, 25), width = 1, style = line.style_dashed)

    // Fills between line pairs
    lf_1x     := linefill.new(ln_upper1x,  ln_lower1x,  color = i_colFill1x)
    lf_15x_up := linefill.new(ln_upper15x, ln_upper1x,  color = i_colFill15x)
    lf_15x_dn := linefill.new(ln_lower1x,  ln_lower15x, color = i_colFill15x)
    lf_2x_up  := linefill.new(ln_upper2x,  ln_upper15x, color = i_colFill2x)
    lf_2x_dn  := linefill.new(ln_lower15x, ln_lower2x,  color = i_colFill2x)

    // Floating labels at right end of lines
    lb_upper := label.new(
         x         = x2,
         y         = upper1x,
         text      = "▲  " + str.tostring(upper1x, "#.##") +
                     "  ( VIX " + str.tostring(vixValue, "#.##") +
                     "  |  +" + str.tostring(math.abs(movePct), "#.##") + "% )",
         style     = label.style_none,
         textcolor = i_colUpper,
         size      = size.normal)

    lb_lower := label.new(
         x         = x2,
         y         = lower1x,
         text      = "( VIX " + str.tostring(vixValue, "#.##") +
                     "  |  -" + str.tostring(math.abs(movePct), "#.##") + "% )" +
                     "  ▼  " + str.tostring(lower1x, "#.##"),
         style     = label.style_none,
         textcolor = i_colLower,
         size      = size.normal)
// ══════════════════════════════════════════════════════════════════════════════
//  C O P Y R I G H T
// ══════════════════════════════════════════════════════════════════════════════
var table cpytbl = table.new(position.bottom_left, 1, 1)
if barstate.islast
    table.cell(cpytbl, 0, 0,
         text        = '© Copyrights Reserved\nKingshuk Ghosh',
         text_color  = #FFD600,
         text_size   = size.small,
         bgcolor     = color.rgb(0, 0, 0),
         text_halign = text.align_left)
// ══════════════════════════════════════════════════════════════════════════════
//  END OF SCRIPT
// ══════════════════════════════════════════════════════════════════════════════
