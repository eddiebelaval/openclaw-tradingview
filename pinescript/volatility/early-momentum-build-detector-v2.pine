//@version=5
indicator("Early Momentum Build Detector V2", overlay=true)

// ===== Inputs =====
lookback = input.int(10, "Structure Lookback", minval=5)
volMultiplier = input.float(1.2, "Volume Multiplier", step=0.1)
emaFastLen = input.int(5, "Fast EMA")
emaSlowLen = input.int(9, "Slow EMA")
offsetATR  = input.float(0.5, "Signal Distance (ATR Multiplier)", step=0.1)

// ===== EMAs =====
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

// ===== EMA Expansion =====
emaSpread = math.abs(emaFast - emaSlow)
emaSpreadRising = emaSpread > emaSpread[1]

// ===== Volatility Expansion =====
atr = ta.atr(14)
atrRising = atr > atr[1]

// ===== Structure Break =====
highestHigh = ta.highest(high, lookback)
lowestLow = ta.lowest(low, lookback)

bullBreak = close > highestHigh[1]
bearBreak = close < lowestLow[1]

// ===== Volume =====
avgVol = ta.sma(volume, lookback)
volOK = volume > avgVol * volMultiplier

// ===== Final Conditions =====
bullSignal = bullBreak and emaSpreadRising and atrRising and volOK
bearSignal = bearBreak and emaSpreadRising and atrRising and volOK

// ===== Adjusted Visual Placement =====
bullY = low - (atr * offsetATR)
bearY = high + (atr * offsetATR)

plotshape(bullSignal ? bullY : na,
     style=shape.circle,
     size=size.tiny,
     color=color.lime,
     location=location.absolute)

plotshape(bearSignal ? bearY : na,
     style=shape.circle,
     size=size.tiny,
     color=color.red,
     location=location.absolute)

// ===== Alerts =====
alertcondition(bullSignal, title="Bullish Early Momentum",
     message="Bullish Early Momentum Detected")

alertcondition(bearSignal, title="Bearish Early Momentum",
     message="Bearish Early Momentum Detected")
