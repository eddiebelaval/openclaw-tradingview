//@version=6
indicator("Master Portfolio Lab PRO [The Quant Science]", overlay = false)

app_mode = input.string("Cumulative (%)", "Analysis:", options = ["Equity ($)", "SMA Ribbon", "Volatility", "Cumulative (%)"], group = "DASHBOARD")
fixed_cap_input = input.bool(false, "Fixed capital ($)", group = "CAPITAL CONFIGURATION", inline = "fixedCapital", confirm = true)
fixed_cap_sel = input.string("10,000.00 $", "", group = "CAPITAL CONFIGURATION", inline = "fixedCapital", options = ["1,000.00 $", "10,000.00 $", "100,000.00 $", "1,000,000.00 $"], confirm = true)
custom_cap_input = input.bool(false, "Custom capital ($)", group = "CAPITAL CONFIGURATION", inline = "customCapital", confirm = true)
capital_value = input.float(10000, "", minval = 100, step = 100, group = "CAPITAL CONFIGURATION", tooltip = "Defines the initial capital base used for custom performance tracking and portfolio simulations.", inline = "customCapital", confirm = true)

var tt_fee = "Portfolio Fee\nRefers to the average transaction cost incurred during portfolio construction and rebalancing."
cost_fee = input.float(0.10, "Portfolio fee (%)", minval = 0.01, step = 0.01, group = "COST CONFIGURATION", tooltip = tt_fee)

var tt_benchmark = "Benchmark\nMarket index (e.g., S&P 500) used to evaluate whether the portfolio generates Alpha compared to passive market exposure."
symbol_benchmark = input.symbol("SP:SPX", "Benchmark Index", group = "BENCHMARK CONFIGURATION", tooltip = tt_benchmark)

s01 = input.symbol("FX:EURUSD", "Asset 01", group="ASSET ALLOCATION", inline="1"), w01 = input.float(0, "- %", group="ASSET ALLOCATION", inline="1")
s02 = input.symbol("FX:EURUSD", "Asset 02", group="ASSET ALLOCATION", inline="2"), w02 = input.float(0, "- %", group="ASSET ALLOCATION", inline="2")
s03 = input.symbol("FX:EURUSD", "Asset 03", group="ASSET ALLOCATION", inline="3"), w03 = input.float(0, "- %", group="ASSET ALLOCATION", inline="3")
s04 = input.symbol("FX:EURUSD", "Asset 04", group="ASSET ALLOCATION", inline="4"), w04 = input.float(0, "- %", group="ASSET ALLOCATION", inline="4")
s05 = input.symbol("FX:EURUSD", "Asset 05", group="ASSET ALLOCATION", inline="5"), w05 = input.float(0, "- %", group="ASSET ALLOCATION", inline="5")
s06 = input.symbol("FX:EURUSD", "Asset 06", group="ASSET ALLOCATION", inline="6"), w06 = input.float(0, "- %", group="ASSET ALLOCATION", inline="6")
s07 = input.symbol("FX:EURUSD", "Asset 07", group="ASSET ALLOCATION", inline="7"), w07 = input.float(0, "- %", group="ASSET ALLOCATION", inline="7")
s08 = input.symbol("FX:EURUSD", "Asset 08", group="ASSET ALLOCATION", inline="8"), w08 = input.float(0, "- %", group="ASSET ALLOCATION", inline="8")
s09 = input.symbol("FX:EURUSD", "Asset 09", group="ASSET ALLOCATION", inline="9"), w09 = input.float(0, "- %", group="ASSET ALLOCATION", inline="9")
s10 = input.symbol("FX:EURUSD", "Asset 10", group="ASSET ALLOCATION", inline="10"), w10 = input.float(0, "- %", group="ASSET ALLOCATION", inline="10")
s11 = input.symbol("FX:EURUSD", "Asset 11", group="ASSET ALLOCATION", inline="11"), w11 = input.float(0, "- %", group="ASSET ALLOCATION", inline="11")
s12 = input.symbol("FX:EURUSD", "Asset 12", group="ASSET ALLOCATION", inline="12"), w12 = input.float(0, "- %", group="ASSET ALLOCATION", inline="12")

start_date  = input.int(1, "D", minval=1, maxval=31, inline='Start', group="DATE PERIOD ANALYSIS")
start_month = input.int(1, "M", minval=1, maxval=12, inline='Start', group="DATE PERIOD ANALYSIS")
start_year  = input.int(2023, "Y", minval=1800, maxval=2100, inline='Start', group="DATE PERIOD ANALYSIS")
in_range = time >= timestamp(syminfo.timezone, start_year, start_month, start_date, 0, 0)

float start_cap = 0
if fixed_cap_input
    if fixed_cap_sel == "1,000.00 $" 
        start_cap := 1000
    if fixed_cap_sel == "10,000.00 $" 
        start_cap := 10000
    if fixed_cap_sel == "100,000.00 $" 
        start_cap := 100000
    if fixed_cap_sel == "1,000,000.00 $" 
        start_cap := 1000000
if custom_cap_input
    start_cap := capital_value

calc_net(sym, weight, cap) =>
    price = request.security(sym, timeframe.period, close)
    roc = ta.roc(price, 1)
    var float p = 0.0
    var float n = 0.0
    if in_range
        if roc > 0 
            p += roc
        if roc < 0 
            n += roc
    total = ((cap * weight) / 100) * (1 + (p + n) / 100)
    total - (total * cost_fee / 100)

n01=calc_net(s01,w01,start_cap), n02=calc_net(s02,w02,start_cap), n03=calc_net(s03,w03,start_cap), n04=calc_net(s04,w04,start_cap)
n05=calc_net(s05,w05,start_cap), n06=calc_net(s06,w06,start_cap), n07=calc_net(s07,w07,start_cap), n08=calc_net(s08,w08,start_cap)
n09=calc_net(s09,w09,start_cap), n10=calc_net(s10,w10,start_cap), n11=calc_net(s11,w11,start_cap), n12=calc_net(s12,w12,start_cap)

tot_net = n01+n02+n03+n04+n05+n06+n07+n08+n09+n10+n11+n12
port_diff_pct = (100 * tot_net / start_cap) - 100

bench_sec = request.security(symbol_benchmark, timeframe.period, close)
bench_roc = ta.roc(bench_sec, 1)
var float bp = 0.0, var float bn = 0.0
if in_range 
    if bench_roc > 0 
        bp += bench_roc
    if bench_roc < 0 
        bn += bench_roc
bench_cum = (100 * (start_cap * (1 + (bp + bn) / 100)) / start_cap) - 100

color_bull    = #00ffbb 
color_bear    = #ff0055
color_neutral = color.new(#9598a1, 70)
color_bg_glow = color.new(color.black, 100)

p_bench = plot(app_mode == "Cumulative (%)" ? bench_cum : na, "Benchmark", color.new(color.white, 70), 1)
color dynamicPortColor = color.from_gradient(port_diff_pct, -10, 10, color_bear, color_bull)
p_port = plot(app_mode == "Cumulative (%)" ? port_diff_pct : na, "Portfolio %", dynamicPortColor, 2)

isPositive = port_diff_pct > 0

fill(p_port, p_bench, 
     top_color    = isPositive ? color.new(color_bull, 70) : color.new(color_bear, 70), 
     bottom_color = isPositive ? color.new(color_bull, 98) : color.new(color_bear, 98), 
     title        = "Cumulative Performance Fill")

hline(0, "Zero Line", color.new(color.gray, 50), hline.style_dashed)

vol_val = ta.wma(ta.stdev(ta.roc(tot_net, 1), 50), 5) 
vol_col = color.from_gradient(vol_val, 0.5, 2.5, color_bull, color_bear)
p_vol   = plot(app_mode == "Volatility" ? vol_val : na, "Volatility", vol_col, 2)
p_v_mid = plot(app_mode == "Volatility" ? 0 : na, "Zero", color.new(color.gray, 100))

fill(p_vol, p_v_mid, 
     top_color    = color.new(vol_col, 60), 
     bottom_color = color.new(vol_col, 98), 
     title        = "Vol Glow")

p_base_cap = plot(app_mode == "Equity ($)" or app_mode == "SMA Ribbon" ? start_cap : na, "Start Capital", color.new(color.white, 80), 1, plot.style_linebr)
p_eq_val   = plot(app_mode == "Equity ($)" or app_mode == "SMA Ribbon" ? tot_net : na, "Equity $", color.white, 2)
p_sma_line = plot(app_mode == "SMA Ribbon" ? ta.sma(tot_net, 200) : na, "SMA 200", color_neutral, 1)

fill(p_eq_val, p_base_cap, 
     top_color    = tot_net > start_cap ? color.new(color_bull, 75) : color.new(color_bear, 75), 
     bottom_color = color_bg_glow, 
     title        = "Equity Cash Fill")

var table visual_table = table.new(position.bottom_right, 2, 5, bgcolor = #111111, border_color = #333333, border_width = 1)
if barstate.islast
    table.cell(visual_table, 0, 0, "PORTFOLIO LAB", text_color = color.white, text_size = size.small, bgcolor=#160d0d)
    table.cell(visual_table, 1, 0, "V1.0", text_color = color_bull, text_size = size.small, bgcolor=#160d0d)
    
    table.cell(visual_table, 0, 1, "Net Portfolio", text_color = color.gray, text_size = size.small)
    table.cell(visual_table, 1, 1, str.format("{0,number,#.##} $", tot_net), text_color = color.white, text_size = size.small)

    table.cell(visual_table, 0, 2, "Return %", text_color = color.gray, text_size = size.small)
    table.cell(visual_table, 1, 2, str.format("{0,number,#.##} %", port_diff_pct), text_color = port_diff_pct > 0 ? color_bull : color_bear, text_size = size.small)
    
    alpha_v = port_diff_pct - bench_cum
    table.cell(visual_table, 0, 3, "Alpha vs Index", text_color = color.gray, text_size = size.small)
    table.cell(visual_table, 1, 3, str.format("{0,number,+#.##} %", alpha_v), text_color = alpha_v > 0 ? color_bull : color_bear, text_size = size.small)
