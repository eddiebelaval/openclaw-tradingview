//@version=6
indicator("4 Bollinger Bands Configurables", overlay = true)

//────────────────────────────────────────────
// FUNCIÓN MA (idéntica a tu código)
//────────────────────────────────────────────
ma(source, length, _type) =>
    switch _type
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)

//────────────────────────────────────────────
// BANDA 1
//────────────────────────────────────────────
length1 = input.int(20, "BB1 Length")
maType1 = input.string("SMA", "BB1 MA Type", options = ["SMA","EMA","SMMA (RMA)","WMA","VWMA"])
src1    = input(close, "BB1 Source")
mult1   = input.float(2.0, "BB1 StdDev")
offset1 = input.int(0, "BB1 Offset", display = display.none)

basis1 = ma(src1, length1, maType1)
dev1   = mult1 * ta.stdev(src1, length1)
upper1 = basis1 + dev1
lower1 = basis1 - dev1

plot(basis1, "BB1 Basis", color = color.blue, offset = offset1)
p1u = plot(upper1, "BB1 Upper", color = color.red, offset = offset1)
p1l = plot(lower1, "BB1 Lower", color = color.green, offset = offset1)
fill(p1u, p1l, color = color.new(color.blue, 85))

//────────────────────────────────────────────
// BANDA 2
//────────────────────────────────────────────
length2 = input.int(20, "BB2 Length")
maType2 = input.string("SMA", "BB2 MA Type", options = ["SMA","EMA","SMMA (RMA)","WMA","VWMA"])
src2    = input(close, "BB2 Source")
mult2   = input.float(2.0, "BB2 StdDev")
offset2 = input.int(0, "BB2 Offset", display = display.none)

basis2 = ma(src2, length2, maType2)
dev2   = mult2 * ta.stdev(src2, length2)
upper2 = basis2 + dev2
lower2 = basis2 - dev2

plot(basis2, "BB2 Basis", color = color.orange, offset = offset2)
p2u = plot(upper2, "BB2 Upper", color = color.red, offset = offset2)
p2l = plot(lower2, "BB2 Lower", color = color.green, offset = offset2)
fill(p2u, p2l, color = color.new(color.orange, 85))

//────────────────────────────────────────────
// BANDA 3
//────────────────────────────────────────────
length3 = input.int(20, "BB3 Length")
maType3 = input.string("SMA", "BB3 MA Type", options = ["SMA","EMA","SMMA (RMA)","WMA","VWMA"])
src3    = input(close, "BB3 Source")
mult3   = input.float(2.0, "BB3 StdDev")
offset3 = input.int(0, "BB3 Offset", display = display.none)

basis3 = ma(src3, length3, maType3)
dev3   = mult3 * ta.stdev(src3, length3)
upper3 = basis3 + dev3
lower3 = basis3 - dev3

plot(basis3, "BB3 Basis", color = color.purple, offset = offset3)
p3u = plot(upper3, "BB3 Upper", color = color.red, offset = offset3)
p3l = plot(lower3, "BB3 Lower", color = color.green, offset = offset3)
fill(p3u, p3l, color = color.new(color.purple, 85))

//────────────────────────────────────────────
// BANDA 4
//────────────────────────────────────────────
length4 = input.int(20, "BB4 Length")
maType4 = input.string("SMA", "BB4 MA Type", options = ["SMA","EMA","SMMA (RMA)","WMA","VWMA"])
src4    = input(close, "BB4 Source")
mult4   = input.float(2.0, "BB4 StdDev")
offset4 = input.int(0, "BB4 Offset", display = display.none)

basis4 = ma(src4, length4, maType4)
dev4   = mult4 * ta.stdev(src4, length4)
upper4 = basis4 + dev4
lower4 = basis4 - dev4

plot(basis4, "BB4 Basis", color = color.teal, offset = offset4)
p4u = plot(upper4, "BB4 Upper", color = color.red, offset = offset4)
p4l = plot(lower4, "BB4 Lower", color = color.green, offset = offset4)
fill(p4u, p4l, color = color.new(color.teal, 85))
//────────────────────────────────────────────
// RELLENOS ENTRE BANDAS
//────────────────────────────────────────────

// Colores configurables
fill_U1U2 = input.color(color.new(color.red, 80), "Relleno BB1 Upper ↔ BB2 Upper")
fill_U3U4 = input.color(color.new(color.orange, 80), "Relleno BB3 Upper ↔ BB4 Upper")
fill_L1L2 = input.color(color.new(color.green, 80), "Relleno BB1 Lower ↔ BB2 Lower")
fill_L3L4 = input.color(color.new(color.teal, 80), "Relleno BB3 Lower ↔ BB4 Lower")

// Rellenos Upper–Upper
fill(p1u, p2u, color = fill_U1U2, title = "BB1–BB2 Upper Fill")
fill(p3u, p4u, color = fill_U3U4, title = "BB3–BB4 Upper Fill")

// Rellenos Lower–Lower
fill(p1l, p2l, color = fill_L1L2, title = "BB1–BB2 Lower Fill")
fill(p3l, p4l, color = fill_L3L4, title = "BB3–BB4 Lower Fill")
