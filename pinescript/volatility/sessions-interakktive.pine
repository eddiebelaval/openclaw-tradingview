//@version=6
// ══════════════════════════════════════════════════════════════════════════════
// ATLAS - SESSIONS +
// Professional Trading Sessions Intelligence
// ══════════════════════════════════════════════════════════════════════════════
//
// Professional Trading Sessions Intelligence
// - All features preserved — minimal refactor approach
//
// THE MOST COMPREHENSIVE SESSION ANALYSIS TOOL FOR TRADINGVIEW
//
// GROUNDBREAKING FEATURES (Industry First):
//
// 1. SESSION STATISTICS ENGINE
//    - Historical win rate tracking per session
//    - Average range per session with live comparison
//    - Session efficiency scoring (clean vs choppy)
//    - Volatility percentile ranking
//
// 2. ADR INTEGRATION (Average Daily Range)
//    - Real-time ADR calculation
//    - Session contribution to ADR (% used)
//    - ADR exhaustion warnings
//    - Projected session targets based on ADR
//
// 3. POWER OF 3 DETECTION (ICT Concept)
//    - Accumulation phase detection
//    - Manipulation phase detection
//    - Distribution/Expansion phase detection
//    - Phase labels on chart
//
// 4. SILVER BULLET WINDOWS (ICT)
//    - 10:00-11:00 NY (London close setup)
//    - 14:00-15:00 NY (PM session setup)
//    - Visual highlighting + alerts
//
// 5. SESSION REVERSAL TIME ANALYSIS
//    - Tracks when reversals historically occur
//    - Identifies high-probability reversal windows
//    - Per-session reversal statistics
//
// 6. SESSION MOMENTUM PHASES
//    - Early session (first 1/3) momentum
//    - Mid session (middle 1/3) momentum
//    - Late session (final 1/3) momentum
//    - Phase-based trading suggestions
//
// 7. SESSION GAP ANALYSIS
//    - Detects gaps between sessions
//    - Gap fill probability based on history
//    - Gap as support/resistance
//
// 8. OPTIMAL TRADE WINDOWS (OTW)
//    - Data-driven best trading times for THIS asset
//    - Based on historical volatility patterns
//    - Personalized to the specific instrument
//
// 9. SESSION VWAP
//    - Volume-weighted average price per session
//    - VWAP bands (1σ, 2σ)
//    - Position relative to VWAP
//
// 10. TIME & PRICE QUADRANTS
//     - Divides session into 4 quadrants
//     - Identifies which quadrant price is in
//     - Quadrant-based bias calculation
//
// 11. SESSION COMPLETION PROJECTION
//     - Projects where session might close
//     - Based on current momentum + historical patterns
//     - Confidence level indicator
//
// 12. INTER-SESSION FLOW ANALYSIS
//     - Does Asian direction predict London?
//     - Does London direction predict NY?
//     - Session continuation vs reversal probability
//
// ══════════════════════════════════════════════════════════════════════════════
//
// © 2026 Interakktive Ltd. All Rights Reserved.
// For support: Visit interakktive.com
// ══════════════════════════════════════════════════════════════════════════════

indicator("Sessions + [Interakktive]", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ══════════════════════════════════════════════════════════════════════════════


// ══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ══════════════════════════════════════════════════════════════════════════════

// Session identifiers
var int SESSION_NONE    = 0
var int SESSION_ASIAN   = 1
var int SESSION_LONDON  = 2
var int SESSION_NEWYORK = 3
var int SESSION_OVERLAP = 4

// Killzone identifiers
var int KZ_NONE         = 0
var int KZ_ASIAN        = 1
var int KZ_LONDON_OPEN  = 2
var int KZ_NY_AM        = 3
var int KZ_LONDON_CLOSE = 4
var int KZ_SILVER_AM    = 5
var int KZ_SILVER_PM    = 6

// Power of 3 phases
var int PO3_NONE         = 0
var int PO3_ACCUMULATION = 1
var int PO3_MANIPULATION = 2
var int PO3_DISTRIBUTION = 3

// Momentum phases
var int PHASE_EARLY = 1
var int PHASE_MID   = 2
var int PHASE_LATE  = 3

// Session Regime types
var int REGIME_NONE     = 0
var int REGIME_TRENDING = 1
var int REGIME_RANGING  = 2
var int REGIME_VOLATILE = 3
var int REGIME_DEAD     = 4

// ══════════════════════════════════════════════════════════════════════════════
// USER DEFINED TYPES
// ══════════════════════════════════════════════════════════════════════════════

// Session DNA - Fingerprint of a session's characteristics
type SessionDNA
    float range_pct     // Range as percentile vs history (0-100)
    float efficiency    // Move cleanliness (0-100)
    int time_high       // When high formed (1=early, 2=mid, 3=late)
    int time_low        // When low formed (1=early, 2=mid, 3=late)
    float close_pos     // Close position in range (0=low, 100=high)
    int direction       // Session direction (1=bull, -1=bear)
    int next_dir        // Next session direction (for prediction)

// ══════════════════════════════════════════════════════════════════════════════
// INPUT GROUPS - Streamlined Layer-Based Architecture
// ══════════════════════════════════════════════════════════════════════════════

GRP_MAIN     = "═══ MAIN SETTINGS ═══"
GRP_SESSIONS = "═══ SESSION CONFIG ═══"
GRP_LEVELS   = "═══ Levels Layer ═══"
GRP_ICT      = "═══ ICT Layer ═══"
GRP_ANALYTICS = "═══ Analytics Layer ═══"
GRP_DISPLAY  = "═══ DISPLAY ═══"
GRP_COLORS   = "═══ COLORS ═══"

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS - MAIN SETTINGS
// ══════════════════════════════════════════════════════════════════════════════

// All session times are defined in UTC — TradingView handles display timezone automatically
string i_timezone = "UTC"
i_asset_class = input.string("Auto", "Asset Class", options=["Auto", "Forex", "Crypto", "Stocks", "Commodities", "Indices/CFDs"], group=GRP_MAIN, tooltip="Auto: Detects from symbol info. Affects which sessions are relevant, ADR calculation, and regime sensitivity. Forex: All sessions, 24/5. Crypto: All sessions, 24/7. Stocks: Home exchange hours only. Commodities: Gold, Oil, Silver etc — session-sensitive with London/NY focus. Indices/CFDs: Primary + overlap sessions.")
i_lookback_days = input.int(5, "Session History (Days)", minval=1, maxval=30, group=GRP_MAIN, tooltip="How many days of session boxes to show on the chart. Higher values = more historical context but busier chart.")
i_stats_lookback = input.int(20, "Statistics Lookback", minval=5, maxval=100, group=GRP_MAIN, tooltip="How many past sessions to use for averages, pattern matching, and flow analysis. Higher = smoother but slower to adapt.")

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS - SESSION CONFIG
// All times are UTC. TradingView displays them in your chart's timezone automatically.
// ══════════════════════════════════════════════════════════════════════════════

i_asian_input = input.bool(true, "Asian Session", inline="asn", group=GRP_SESSIONS, tooltip="Toggle the Asian session box and related analytics on/off.")
i_asian_start = input.session("2000-0400", "", inline="asn", group=GRP_SESSIONS, tooltip="Asian session window in UTC (8:00 PM – 4:00 AM UTC). Covers Sydney open through Tokyo close. Default times follow forex convention — adjust for your market if needed.")
i_london_input = input.bool(true, "London Session", inline="ldn", group=GRP_SESSIONS, tooltip="Toggle the London session box and related analytics on/off.")
i_london_start = input.session("0700-1600", "", inline="ldn", group=GRP_SESSIONS, tooltip="London session window in UTC (7:00 AM – 4:00 PM UTC). Covers European cash equities and London forex hours.")
i_ny_input = input.bool(true, "New York Session", inline="ny", group=GRP_SESSIONS, tooltip="Toggle the New York session box and related analytics on/off.")
i_ny_start = input.session("1300-2200", "", inline="ny", group=GRP_SESSIONS, tooltip="New York session window in UTC (1:00 PM – 10:00 PM UTC / 8:00 AM – 5:00 PM ET). Pre-market activity starts before NYSE 9:30 AM open.")
i_overlap_input = input.bool(false, "Highlight LDN-NY Overlap", group=GRP_SESSIONS, tooltip="Highlights the period when London and New York sessions are both active. This is typically the highest-volume, highest-volatility window of the day for Forex and Index markets.")
i_box_style_input = input.string("Filled", "Session Box Style", options=["Filled", "Border Only", "Filled + Border"], group=GRP_SESSIONS, tooltip="How session boxes appear on the chart. Filled: Shaded background. Border Only: Just the outline, no fill. Filled + Border: Both with a thicker border.")
i_adaptive_sensitivity = input.string("Medium", "Detection Sensitivity", options=["Low", "Medium", "High"], group=GRP_SESSIONS, tooltip="Controls how easily a volatility surge is detected for Early Start and Extended Session detection. Low: only major spikes. Medium: balanced. High: catches smaller surges.")
i_adaptive_early = input.bool(false, "Detect Early Starts", group=GRP_SESSIONS, tooltip="Detects when significant price action begins BEFORE the official session open. Shows an EARLY label and ◆ marker on the chart. London and NY frequently start early on high-impact news days.")
i_adaptive_extended = input.bool(false, "Detect Extended Sessions", group=GRP_SESSIONS, tooltip="Detects when volatility remains elevated after the official session close. Shows an EXT label on the chart. Extended sessions often mean unfinished business — the move may continue into the next session or reverse sharply at the next open.")

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS - LEVELS LAYER (Toggle + Config together)
// ══════════════════════════════════════════════════════════════════════════════

i_layer_levels = input.bool(true, "◆ Enable Levels Layer", group=GRP_LEVELS, tooltip="Master toggle for all level features: PDH/PDL/PDC, ADR levels, Opening Range, Session High/Low, VWAP")

i_levels_phhl = input.bool(true, "Previous Hour High/Low", group=GRP_LEVELS, tooltip="Last hour's high and low — key micro-levels for intraday scalping and momentum trading. Breaks of the previous hour's range often signal the start of a new move.")
i_levels_pdhl = input.bool(false, "Previous Day High/Low", group=GRP_LEVELS, tooltip="Yesterday's high and low — key support/resistance levels that institutional traders watch for liquidity grabs and breakout targets.")
i_levels_pdc = input.bool(false, "Previous Day Close", group=GRP_LEVELS, tooltip="Yesterday's closing price — a key reference for daily bias. Price above PDC suggests bullish, below suggests bearish.")
i_levels_pwhl = input.bool(false, "Previous Week High/Low", group=GRP_LEVELS, tooltip="Last week's high and low — major institutional levels for swing traders. Weekly liquidity rests above PWH and below PWL. Breaks often lead to significant moves.")
i_levels_pmhl = input.bool(false, "Previous Month High/Low", group=GRP_LEVELS, tooltip="Last month's high and low — heavyweight institutional levels. Monthly ranges define the macro structure. Breaks of PMH/PML often signal trend continuation or major reversals.")
i_levels_pqhl = input.bool(false, "Previous Quarter High/Low", group=GRP_LEVELS, tooltip="Last quarter's high and low — the highest-timeframe institutional levels. Quarterly liquidity sweeps drive the largest moves in the market. These are the levels hedge funds and central banks care about.")
i_levels_adr = input.bool(false, "ADR Projection Levels", group=GRP_LEVELS, tooltip="Average Daily Range projected from the midnight open. Shows expected high/low targets for the day based on historical volatility.")
i_adr_period = input.int(14, "ADR Period (Days)", minval=5, maxval=50, group=GRP_LEVELS, tooltip="Number of past days used to calculate the Average Daily Range. Higher = smoother, lower = more reactive to recent volatility.")
i_levels_or = input.bool(false, "Opening Range", group=GRP_LEVELS, tooltip="The high/low range formed during the first N minutes of a session. OR breakouts are a classic entry strategy — price breaking above/below signals directional intent.")
i_or_session = input.string("New York", "OR Session", options=["Asian", "London", "New York"], group=GRP_LEVELS, tooltip="Which session to calculate the Opening Range for. New York is most common for US equities and forex.")
i_or_period = input.string("30 min", "OR Period", options=["5 min", "15 min", "30 min", "60 min"], group=GRP_LEVELS, tooltip="How long the Opening Range is measured. 5 min: Scalping. 15 min: Aggressive. 30 min: Standard for most markets. 60 min: Conservative, wider range.")
i_levels_vwap = input.bool(true, "Session VWAP", group=GRP_LEVELS, tooltip="Volume-Weighted Average Price calculated per session. Institutional benchmark — price above VWAP suggests buyers in control, below suggests sellers.")
i_vwap_bands = input.bool(false, "VWAP Bands", group=GRP_LEVELS, tooltip="Standard deviation bands around VWAP. Acts as dynamic support/resistance. Price reaching the upper band may be overextended, lower band may be oversold.")
i_sess_levels_asian = input.bool(false, "Asian High/Low/Open", group=GRP_LEVELS, tooltip="Show Asian session High, Low, and Open level lines during the Asian session")
i_sess_levels_london = input.bool(false, "London High/Low/Open", group=GRP_LEVELS, tooltip="Show London session High, Low, and Open level lines during the London session")
i_sess_levels_ny = input.bool(false, "New York High/Low/Open", group=GRP_LEVELS, tooltip="Show New York session High, Low, and Open level lines during the NY session")
i_sess_equilibrium = input.bool(false, "Session Equilibrium (50%)", group=GRP_LEVELS, tooltip="The midpoint of each session's range — ICT 'Equilibrium' concept. A powerful magnet for price. Retracements to the 50% often present re-entry opportunities in the direction of the session trend.")
i_session_level_style = input.string("Dotted", "Level Line Style", options=["Solid", "Dashed", "Dotted"], group=GRP_LEVELS, tooltip="Visual style for all level lines (PDH/L, ADR, Session H/L/O).")
i_extend_levels = input.bool(false, "Extend Levels Right", group=GRP_LEVELS, tooltip="Extend level lines to the right edge of the chart. Useful to see where key levels project into future price action.")
i_extend_labels = input.bool(false, "Extend Labels Right", group=GRP_LEVELS, tooltip="Push level labels further to the right for better visibility when many levels are close together. Default position keeps labels near price action.")
i_levels_range_proj = input.bool(false, "Session Range Projections", group=GRP_LEVELS, tooltip="Project expected high/low targets based on historical session ranges, regime, and bias")
i_range_proj_style = input.string("Zone", "Projection Style", options=["Zone", "Lines", "Both"], group=GRP_LEVELS, tooltip="Zone: Shaded area | Lines: Just the levels | Both: Zone with level lines")
i_range_proj_mode = input.string("Adaptive", "Projection Mode", options=["Historical", "Adaptive", "Conservative"], group=GRP_LEVELS, tooltip="Historical: Pure avg range | Adaptive: Adjusts for regime/ADR | Conservative: Tighter targets")

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS - ICT LAYER (Toggle + Config together)
// ══════════════════════════════════════════════════════════════════════════════

i_layer_ict = input.bool(true, "◆ Enable ICT Layer", group=GRP_ICT, tooltip="Master toggle for ICT concepts: Killzones, Silver Bullet, Power of 3, Macro Times, Midnight/Weekly Open")
i_ict_killzones = input.bool(false, "Killzones", group=GRP_ICT, tooltip="ICT Killzones — high-probability time windows where institutional order flow creates significant moves. Background highlights when active.")
i_kz_asian_on = input.bool(true, "Asian KZ", inline="kz_asn", group=GRP_ICT, tooltip="Toggle Asian Killzone on/off. Sets the range that London often sweeps.")
i_kz_asian_time = input.session("0000-0400", "", inline="kz_asn", group=GRP_ICT)
i_kz_london_on = input.bool(true, "London Open KZ", inline="kz_ldn", group=GRP_ICT, tooltip="Toggle London Open Killzone on/off. Highest-probability reversal window of the day.")
i_kz_london_time = input.session("0700-1000", "", inline="kz_ldn", group=GRP_ICT)
i_kz_ny_am_on = input.bool(true, "NY AM KZ", inline="kz_ny", group=GRP_ICT, tooltip="Toggle NY AM Killzone on/off. Second major opportunity window.")
i_kz_ny_am_time = input.session("1200-1500", "", inline="kz_ny", group=GRP_ICT)
i_kz_lc_on = input.bool(true, "London Close KZ", inline="kz_lc", group=GRP_ICT, tooltip="Toggle London Close Killzone on/off. Late-session reversals as London desks square positions.")
i_kz_london_close_time = input.session("1500-1700", "", inline="kz_lc", group=GRP_ICT)
i_kz_effectiveness = input.bool(true, "KZ Effectiveness Scoring", group=GRP_ICT, tooltip="Grades each killzone A+ through D based on historical reversal success rate and move quality (% of ADR captured). Helps you focus on the killzones that actually work for THIS specific instrument.")
i_kz_score_lookback = input.int(20, "KZ Score Lookback", minval=5, maxval=50, group=GRP_ICT, tooltip="Number of past killzone entries to analyze for grading. Higher = more stable grades, lower = more reactive to recent performance.")
i_ict_silver = input.bool(false, "Silver Bullet Windows", group=GRP_ICT, tooltip="ICT Silver Bullet — specific 1-hour windows with historically high reversal probability. Highlights the AM (10:00-11:00 NY) and PM (14:00-15:00 NY) windows.")
i_silver_am_time = input.session("1500-1600", "Silver Bullet AM (UTC)", group=GRP_ICT, tooltip="AM Silver Bullet window in UTC (15:00–16:00 UTC = 10:00–11:00 NY). Historically the strongest reversal window during the NY AM session.")
i_silver_pm_time = input.session("1900-2000", "Silver Bullet PM (UTC)", group=GRP_ICT, tooltip="PM Silver Bullet window in UTC (19:00–20:00 UTC = 14:00–15:00 NY). Afternoon reversal window, often coincides with institutional position adjustments.")
i_ict_po3 = input.bool(false, "Power of 3 Detection", group=GRP_ICT, tooltip="ICT Power of 3 — detects the three phases of institutional price delivery: Accumulation (range building), Manipulation (false break/liquidity grab), Distribution (true directional move).")
i_po3_session = input.string("London", "PO3 Session", options=["Asian", "London", "New York"], group=GRP_ICT, tooltip="Which session to detect Power of 3 phases in. London is most common as it often manipulates the Asian range.")
i_ict_macro = input.bool(false, "Macro Times", group=GRP_ICT, tooltip="ICT Macro reversal windows — 5-minute windows at :50 and :10 past the hour (9:50, 10:10, 10:50, 11:10 NY time). High-probability moments for reversals and liquidity grabs. Works on timeframes up to 5m.")
i_ict_cbdr = input.bool(false, "CBDR Projections", group=GRP_ICT, tooltip="Central Bank Dealers Range — the range formed during 20:00–00:00 UTC (Asian session first half). ICT concept: project 1x, 2x, and 3x the CBDR above and below the range as expansion targets. The real move often targets 2x CBDR.")
i_ict_midnight = input.bool(false, "Midnight Open", group=GRP_ICT, tooltip="ICT Midnight Open (True Day Open) — the price at 00:00 UTC. Key reference for daily bias and a frequent target for price to retrace to.")
i_ict_weekly = input.bool(false, "Weekly Open", group=GRP_ICT, tooltip="Monday's opening price. Institutional traders use the weekly open as a bias reference — price above it suggests bullish weekly bias.")

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS - ANALYTICS LAYER (Toggle + Config together)
// ══════════════════════════════════════════════════════════════════════════════

i_layer_analytics = input.bool(true, "◆ Enable Analytics Layer", group=GRP_ANALYTICS, tooltip="Master toggle for analytics: Session DNA, Statistics, Flow Analysis, Regime Detection, Projections")
i_analytics_momentum = input.bool(false, "Momentum Phases", group=GRP_ANALYTICS, tooltip="Marks Early, Mid, and Late phases of each session on the chart. Early = range building, direction unclear. Mid = direction establishing, key moves happen here. Late = trend exhaustion possible, be cautious of reversals.")
i_analytics_dna = input.bool(true, "Session DNA", group=GRP_ANALYTICS, tooltip="Live session predictor — analyzes opening gap, direction, momentum, VWAP, and efficiency at two points per session (Early and Mid) to predict direction. Non-repainting.")
i_dna_show_history = input.bool(false, "Show Previous DNA", group=GRP_ANALYTICS, tooltip="Show DNA labels for completed sessions. Turn off for a cleaner chart — only the current session's DNA will be visible.")
i_analytics_regime = input.bool(true, "Regime Detection", group=GRP_ANALYTICS, tooltip="Classifies the current market regime based on efficiency ratio, volatility ratio, and directional consistency. Trending = follow the move. Ranging = fade extremes. Volatile = widen stops. Dead = wait for breakout.")
i_regime_lookback = input.int(10, "Regime Lookback (Bars)", minval=5, maxval=50, group=GRP_ANALYTICS, tooltip="Number of bars used to classify the current market regime. Lower = faster detection of regime shifts. Default 10 bars (2.5 hours on 15m) captures the current session's character.")
i_analytics_flow = input.bool(true, "Inter-Session Flow", group=GRP_ANALYTICS, tooltip="Tracks whether London tends to continue or reverse Asian's direction, and whether NY tends to continue or reverse London's direction. Shows historical continuation percentage for the current session pair.")
i_analytics_score = input.bool(true, "Session Score", group=GRP_ANALYTICS, tooltip="Rates each session's energy level (0-100) by combining range vs average, efficiency, and volatility into a single score. Answers: 'Is this session worth trading right now?' Score > 70 = high energy, < 30 = dead session. Also tracks historical win rate — the percentage of sessions that delivered a tradeable move on this instrument.")
i_analytics_anomaly = input.bool(true, "Anomaly Detection", group=GRP_ANALYTICS, tooltip="Monitors 6 anomaly types in real-time: Range (unusual session range), Volatility (sudden spikes), Timing (high/low at unusual phases), Gap (large inter-session gap), Flow (direction contradicts history), ADR (unusual consumption rate). Flags when z-scores exceed thresholds.")
i_anomaly_sensitivity = input.string("Medium", "Anomaly Sensitivity", options=["Low", "Medium", "High"], group=GRP_ANALYTICS, tooltip="Low: Only extreme anomalies | Medium: Balanced | High: More sensitive")
i_anomaly_show_markers = input.bool(false, "Show Anomaly Markers", group=GRP_ANALYTICS, tooltip="Display warning markers on chart when anomalies detected")

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS - DISPLAY SETTINGS
// ══════════════════════════════════════════════════════════════════════════════

i_dash_view = input.string("Minimal", "Dashboard", options=["Off", "Minimal", "Status", "Trade", "Analytics", "Full"], group=GRP_DISPLAY, tooltip="Off: No dashboard | Minimal: Session+Bias | Status: +KZ+ADR | Trade: +PO3+Regime+Score | Analytics: DNA+Flow+Stats | Full: Everything")
i_dash_position = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=GRP_DISPLAY, tooltip="Where the dashboard table appears on the chart.")
i_dash_size = input.string("Normal", "Dashboard Size", options=["Tiny", "Small", "Normal"], group=GRP_DISPLAY, tooltip="Text size for the dashboard. Small recommended for clean charts.")
i_label_size = input.string("Small", "Label Size", options=["Tiny", "Small", "Normal", "Large"], group=GRP_DISPLAY, tooltip="Size of all chart labels (session names, level labels, markers).")
i_show_level_labels = input.bool(true, "Level Labels", group=GRP_DISPLAY, tooltip="Show text labels on level lines (PDH, PDL, ADR High, etc). Turn off to keep the lines but remove label clutter when many levels are active.")
i_show_level_prices = input.bool(true, "Show Prices on Labels", group=GRP_DISPLAY, tooltip="Include the price value on level labels (e.g. 'PDH 73826.5' vs just 'PDH'). Turn off for cleaner labels when price scale already shows the value.")
i_show_current_only = input.bool(false, "Show Current Session Only", group=GRP_DISPLAY, tooltip="Hides historical session boxes and shows only the currently active session. Reduces visual clutter on busy charts.")

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS - COLORS
// ══════════════════════════════════════════════════════════════════════════════

// Session Colors
// Session Box Colors (fill + border on same row)
i_asian_color = input.color(color.new(#9C27B0, 85), "Asian", inline="asn_col", group=GRP_COLORS)
i_asian_border = input.color(color.new(#9C27B0, 50), "Border", inline="asn_col", group=GRP_COLORS)
i_london_color = input.color(color.new(#2196F3, 85), "London", inline="ldn_col", group=GRP_COLORS)
i_london_border = input.color(color.new(#2196F3, 50), "Border", inline="ldn_col", group=GRP_COLORS)
i_ny_color = input.color(color.new(#FF9800, 85), "New York", inline="ny_col", group=GRP_COLORS)
i_ny_border = input.color(color.new(#FF9800, 50), "Border", inline="ny_col", group=GRP_COLORS)
i_overlap_color = input.color(color.new(#4CAF50, 80), "Overlap", inline="ovl_col", group=GRP_COLORS)
i_vwap_color = input.color(color.new(#FF9800, 0), "VWAP", inline="ovl_col", group=GRP_COLORS)
// Level Colors (high + low paired)
i_pdl_color_high = input.color(color.new(#26A69A, 30), "PDH", inline="pd_col", group=GRP_COLORS)
i_pdl_color_low = input.color(color.new(#EF5350, 30), "PDL", inline="pd_col", group=GRP_COLORS)
i_pdl_color_close = input.color(color.new(#FFB300, 30), "PDC", inline="pd_col", group=GRP_COLORS)
i_adr_high_color = input.color(color.new(#26A69A, 50), "ADR High", inline="adr_col", group=GRP_COLORS)
i_adr_low_color = input.color(color.new(#EF5350, 50), "ADR Low", inline="adr_col", group=GRP_COLORS)
i_or_color = input.color(color.new(#9E9E9E, 70), "Opening Range", inline="adr_col", group=GRP_COLORS)
i_proj_high_color = input.color(color.new(#26A69A, 75), "Proj High", inline="proj_col", group=GRP_COLORS)
i_proj_low_color = input.color(color.new(#EF5350, 75), "Proj Low", inline="proj_col", group=GRP_COLORS)
// ICT Colors (paired)
i_kz_color = input.color(color.new(#FFEB3B, 85), "Killzone", inline="kz_col", group=GRP_COLORS)
i_silver_color = input.color(color.new(#00E676, 70), "Silver Bullet", inline="kz_col", group=GRP_COLORS)
i_macro_color = input.color(color.new(#FF5722, 70), "Macro", inline="kz_col", group=GRP_COLORS)
i_midnight_color = input.color(color.new(#FFFFFF, 30), "Midnight Open", inline="open_col", group=GRP_COLORS)
i_weekly_color = input.color(color.new(#00BCD4, 30), "Weekly Open", inline="open_col", group=GRP_COLORS)
i_po3_manip_color = input.color(color.new(#FF9800, 70), "PO3 Manip", inline="po3_col", group=GRP_COLORS)
i_po3_dist_color = input.color(color.new(#4CAF50, 70), "PO3 Dist", inline="po3_col", group=GRP_COLORS)

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS - ALERTS (Grouped by Layer)
// ══════════════════════════════════════════════════════════════════════════════


// ══════════════════════════════════════════════════════════════════════════════
// INPUTS - ADVANCED
// ══════════════════════════════════════════════════════════════════════════════

i_regime_trend_thresh = 0.45
i_regime_dead_thresh = 0.3
i_regime_volatile_thresh = 1.8
i_vwap_band_mult = 1.0
i_export_enabled = false

// ══════════════════════════════════════════════════════════════════════════════
// DERIVED SETTINGS (Layer + Chart Style Logic)
// ══════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────
// ASSET CLASS DETECTION
// Auto-detect from symbol type, or use manual override
// ─────────────────────────────────────────────────────────────────────────────

// Auto-detection via syminfo.type: "stock", "fund", "future", "forex", "crypto", "index", "cfd", "dr", "bond", "warrant", "option", "economic"
// Note: Commodities (Gold/XAUUSD, Oil/USOIL) often report as "cfd" or "forex" depending on broker.
// Auto-detection maps "cfd" → Indices/CFDs. Users trading commodity CFDs should manually select Commodities.
string _detected_class = switch syminfo.type
    "forex"   => "Forex"
    "crypto"  => "Crypto"
    "stock"   => "Stocks"
    "fund"    => "Stocks"
    "dr"      => "Stocks"
    "index"   => "Indices/CFDs"
    "cfd"     => "Indices/CFDs"
    "future"  => "Commodities"
    => "Forex"

// Resolve final asset class (Auto uses detection, manual overrides)
string asset_class = i_asset_class == "Auto" ? _detected_class : i_asset_class

// Asset class flags (used by downstream features)
bool is_forex       = asset_class == "Forex"
bool is_crypto      = asset_class == "Crypto"
bool is_stocks      = asset_class == "Stocks"
bool is_commodities = asset_class == "Commodities"
bool is_indices     = asset_class == "Indices/CFDs"

// Asset class characteristics
bool has_all_sessions    = is_forex or is_crypto or is_indices or is_commodities   // All 3 sessions relevant
bool has_24h_market      = is_forex or is_crypto or is_commodities                 // Market open around the clock (commodity CFDs trade 24/5)
bool has_exchange_hours  = is_stocks                                                // Only home exchange session matters
bool sessions_overlap    = is_forex or is_indices or is_commodities                // LDN-NY overlap is tradeable

// Session relevance per asset class (informational — does NOT override user toggles)
// Used by dashboard to show context hints, not to gate functionality
bool asian_relevant   = has_all_sessions
bool london_relevant  = has_all_sessions or is_stocks              // Stocks: relevant if LSE-listed
bool ny_relevant      = has_all_sessions or is_stocks              // Stocks: relevant if NYSE/NASDAQ
bool overlap_relevant = sessions_overlap

// ─────────────────────────────────────────────────────────────────────────────
// TIMEFRAME AWARENESS
// Sessions are intraday concepts — features gracefully degrade on higher TFs
// ─────────────────────────────────────────────────────────────────────────────

float _tf_mins = timeframe.in_seconds() / 60
bool is_intraday      = timeframe.isintraday                        // Sub-daily (1m to 12H)
bool is_sub_hourly    = is_intraday and _tf_mins < 60               // 1m to 45m — full feature set
bool is_hourly        = is_intraday and _tf_mins >= 60 and _tf_mins <= 240   // 1H to 4H — sessions work, fine detail doesn't
bool is_daily_plus    = not is_intraday                              // D, W, M — sessions are meaningless

// Feature suitability flags (gate downstream features)
bool tf_sessions_ok   = is_intraday                                 // Session boxes need intraday
bool tf_boxes_ok      = is_intraday and _tf_mins <= 240             // Session boxes up to 4H
bool tf_labels_ok     = is_intraday and _tf_mins <= 240             // Session name labels up to 4H
bool tf_killzones_ok  = is_sub_hourly                               // KZ/Silver Bullet need sub-hourly to be meaningful
bool tf_macro_ok      = is_intraday and _tf_mins <= 5               // Macro times only work up to 5m
bool tf_or_ok         = is_intraday and _tf_mins <= 60              // OR needs TF <= OR period (capped at 60m)
bool tf_po3_ok        = is_intraday and _tf_mins <= 60              // PO3 needs enough bars within a session
bool tf_vwap_ok       = is_intraday                                 // VWAP needs intraday volume bars
bool tf_levels_ok     = true                                        // PDH/PDL/PDC/PWH/PWL work on all TFs
bool tf_adaptive_ok   = is_sub_hourly                               // Adaptive boundaries need granular data
bool tf_analytics_ok  = is_intraday                                 // DNA/Regime/Flow need session-level data

// Session box enables — gated by timeframe
i_asian_enabled   = i_asian_input and tf_boxes_ok
i_london_enabled  = i_london_input and tf_boxes_ok
i_ny_enabled      = i_ny_input and tf_boxes_ok
i_overlap_enabled = i_overlap_input and tf_boxes_ok


// Dashboard determines what info is shown
bool dash_off = i_dash_view == "Off"
bool dash_minimal = i_dash_view == "Minimal"
bool dash_status = i_dash_view == "Status" or i_dash_view == "Full"
bool dash_trade = i_dash_view == "Trade" or i_dash_view == "Full"
bool dash_analytics_view = i_dash_view == "Analytics" or i_dash_view == "Full"
bool dash_full = i_dash_view == "Full"

// Compatibility mappings - Layer enables + chart style + timeframe gating
// Features gracefully degrade: Daily+ = only PDH/PDL/PDC/PWH/PWL. 1H+ = no KZ/macro/adaptive.
// OR requires chart TF <= OR period. Midnight/Weekly Open work on all TFs.

// Levels Layer features (PDH/PDL/PDC/PWH/PWL work on all TFs, session features need intraday)
// Auto-enable one-timeframe-up levels on higher TFs so chart always has context
// Sub-hourly: auto PHH/PHL  |  1H-4H: auto PDH/PDL/PDC  |  Daily: +PWH/PWL  |  Weekly: +PMH/PML  |  Monthly: +PQH/PQL
i_pdl_enabled = i_layer_levels
i_phhl_enabled = i_layer_levels and i_levels_phhl and is_sub_hourly
i_pdl_high = i_layer_levels and i_levels_pdhl
i_pdl_low = i_layer_levels and i_levels_pdhl
i_pdl_close = i_layer_levels and i_levels_pdc
i_pwhl_enabled = i_layer_levels and i_levels_pwhl
i_pmhl_enabled = i_layer_levels and i_levels_pmhl
i_pqhl_enabled = i_layer_levels and i_levels_pqhl
i_adr_enabled = i_layer_levels and i_levels_adr
i_adr_show_levels = i_layer_levels and i_levels_adr
i_adr_show_used = i_layer_levels and i_levels_adr
i_adr_warn_exhaustion = i_layer_levels and i_levels_adr and is_intraday
i_or_enabled = i_layer_levels and i_levels_or and tf_or_ok
i_vwap_enabled = i_layer_levels and i_levels_vwap and tf_vwap_ok
i_vwap_session = "Current"
i_vwap_band_color = color.new(i_vwap_color, 70)
i_show_session_levels = i_layer_levels and tf_sessions_ok
i_show_session_open = i_layer_levels and tf_sessions_ok
i_show_equilibrium = i_layer_levels and i_sess_equilibrium and tf_sessions_ok

// Per-session level visibility (master gate + per-session toggle)
i_show_asian_levels = i_show_session_levels and i_sess_levels_asian
i_show_asian_open = i_show_session_open and i_sess_levels_asian
i_show_london_levels = i_show_session_levels and i_sess_levels_london
i_show_london_open = i_show_session_open and i_sess_levels_london
i_show_ny_levels = i_show_session_levels and i_sess_levels_ny
i_show_ny_open = i_show_session_open and i_sess_levels_ny

i_range_proj_enabled = i_layer_levels and i_levels_range_proj and tf_sessions_ok
i_range_proj_show_zone = i_range_proj_enabled and (i_range_proj_style == "Zone" or i_range_proj_style == "Both")
i_range_proj_show_lines = i_range_proj_enabled and (i_range_proj_style == "Lines" or i_range_proj_style == "Both")

// ICT Layer features (KZ/Silver need sub-hourly, Macro needs <=5m, Midnight/Weekly work everywhere)
i_ict_enabled = i_layer_ict and tf_sessions_ok
i_kz_enabled = i_layer_ict and i_ict_killzones and tf_killzones_ok
i_kz_asian = i_kz_enabled and i_kz_asian_on
i_kz_london = i_kz_enabled and i_kz_london_on
i_kz_ny_am = i_kz_enabled and i_kz_ny_am_on
i_kz_london_close = i_kz_enabled and i_kz_lc_on
i_silver_enabled = i_layer_ict and i_ict_silver and tf_killzones_ok
i_silver_am = i_layer_ict and i_ict_silver and tf_killzones_ok
i_silver_pm = i_layer_ict and i_ict_silver and tf_killzones_ok
i_po3_enabled = i_layer_ict and i_ict_po3 and tf_po3_ok
i_macro_times = i_layer_ict and i_ict_macro and tf_macro_ok
i_cbdr_enabled = i_layer_ict and i_ict_cbdr and tf_sessions_ok
i_midnight_open = i_layer_ict and i_ict_midnight
i_weekly_open = i_layer_ict and i_ict_weekly
i_po3_accum_color = color.new(#2196F3, 70)

// Analytics Layer features (need session-level intraday data)
i_stats_enabled = i_layer_analytics and tf_analytics_ok
i_stats_show_range = i_layer_analytics and tf_analytics_ok
i_stats_show_volatility = i_layer_analytics and tf_analytics_ok
i_stats_show_efficiency = i_layer_analytics and tf_analytics_ok
i_stats_show_best_time = i_layer_analytics and tf_analytics_ok
i_stats_show_otw_marker = false  // OTW marker disabled — data feeds dashboard only
i_dna_enabled = i_layer_analytics and i_analytics_dna and tf_analytics_ok
i_dna_show_prediction = i_layer_analytics and i_analytics_dna and tf_analytics_ok
i_dna_show_pattern = i_layer_analytics and i_analytics_dna and tf_analytics_ok
i_regime_enabled = i_layer_analytics and i_analytics_regime and tf_analytics_ok
i_regime_show_strategy = i_layer_analytics and i_analytics_regime and tf_analytics_ok
i_flow_enabled = i_layer_analytics and i_analytics_flow and tf_analytics_ok
i_flow_show_continuation = i_layer_analytics and i_analytics_flow and tf_analytics_ok
i_flow_show_reversal = i_layer_analytics and i_analytics_flow and tf_analytics_ok
i_score_enabled = i_layer_analytics and i_analytics_score and tf_analytics_ok
i_anomaly_enabled = i_layer_analytics and i_analytics_anomaly and tf_analytics_ok
i_momentum_enabled = i_layer_analytics and i_analytics_momentum and tf_analytics_ok

// Adaptive features (merged into Session Config — no separate layer toggle)
i_adaptive_enabled = tf_adaptive_ok
i_adaptive_show_activity = tf_adaptive_ok
i_adaptive_early_detect = i_adaptive_early and tf_adaptive_ok
i_adaptive_late_detect = i_adaptive_extended and tf_adaptive_ok

// Visual settings derived from chart style + user display toggles
i_box_style = i_box_style_input
i_show_labels_input = input.bool(true, "Session Labels", group=GRP_DISPLAY, tooltip="Show session name labels (ASN/LDN/NY) above session boxes. Auto-disabled on 1H+ timeframes to prevent clutter.")
i_show_labels = i_show_labels_input and tf_labels_ok
i_level_labels = i_show_level_labels
i_level_prices = i_show_level_prices and i_show_level_labels
int label_offset = i_extend_labels ? 20 : 10
i_show_phase_labels = i_momentum_enabled and is_sub_hourly
i_show_po3_labels = i_po3_enabled
i_show_regime_labels = false  // Regime merged into Verdict — no separate chart labels
i_show_adaptive_labels = i_adaptive_enabled

// Alert mappings
i_alert_session_start = true
i_alert_killzone_start = true
i_alert_silver_bullet = true
i_alert_or_break = true
i_alert_adr_exhaustion = true
i_alert_po3_phase = true
i_alert_macro_time = true
i_alert_dna_signal = true
i_alert_regime_change = true

// Dashboard compatibility
i_dash_enabled = not dash_off

// Momentum phase colors (fixed)
i_momentum_early_color = color.new(#2196F3, 0)
i_momentum_mid_color = color.new(#FFB300, 0)
i_momentum_late_color = color.new(#9C27B0, 0)

