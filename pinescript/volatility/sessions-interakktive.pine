// ══════════════════════════════════════════════════════════════════════════════
// SESSION STORAGE
// ══════════════════════════════════════════════════════════════════════════════

// Current session tracking
var float asian_open = na, var float asian_high = na, var float asian_low = na
var float london_open = na, var float london_high = na, var float london_low = na
var float ny_open = na, var float ny_high = na, var float ny_low = na
var int asian_start_bar = na, var int london_start_bar = na, var int ny_start_bar = na

// Session Range Projections
var float srp_high = na              // Projected session high target
var float srp_low = na               // Projected session low target
var float srp_mid = na               // Midpoint (session open)
var int srp_session = SESSION_NONE   // Which session owns current projection
var float srp_confidence = na        // Confidence in projection (0-100)
var bool srp_high_hit = false        // Has projected high been reached?
var bool srp_low_hit = false         // Has projected low been reached?

// CBDR (Central Bank Dealers Range) — 20:00-00:00 UTC
var float cbdr_high = na
var float cbdr_low = na
var float cbdr_range = na
var int cbdr_start_bar = na
var bool cbdr_complete = false

// Session statistics arrays
var float[] asian_ranges = array.new_float(0)
var float[] london_ranges = array.new_float(0)
var float[] ny_ranges = array.new_float(0)
var float[] asian_efficiency = array.new_float(0)
var float[] london_efficiency = array.new_float(0)
var float[] ny_efficiency = array.new_float(0)

// Inter-session flow tracking
var int[] asian_direction = array.new_int(0)  // 1 = bullish, -1 = bearish
var int[] london_direction = array.new_int(0)
var int[] ny_direction = array.new_int(0)
var int[] london_followed_asian = array.new_int(0)  // 1 = continued, 0 = reversed
var int[] ny_followed_london = array.new_int(0)

// Session VWAP
var float vwap_sum = 0.0
var float vwap_vol_sum = 0.0
var float vwap_sq_sum = 0.0

// Power of 3 tracking
var int po3_phase = PO3_NONE
var float po3_range_start = na
var float po3_manipulation_high = na
var float po3_manipulation_low = na
var int po3_manip_start_bar = na       // Bar where manipulation phase started
var int po3_dist_start_bar = na        // Bar where distribution phase started

// Opening Range
var float or_high = na, var float or_low = na
var bool or_complete = false
var int or_start_bar = na

// Session DNA Storage (UDT-based for memory efficiency)
// Each SessionDNA object contains all fingerprint data for one session
var array<SessionDNA> asian_dna = array.new<SessionDNA>()
var array<SessionDNA> london_dna = array.new<SessionDNA>()
var array<SessionDNA> ny_dna = array.new<SessionDNA>()

// Track when high/low formed in current session (bar index)
var int asian_high_bar = na, var int asian_low_bar = na
var int london_high_bar = na, var int london_low_bar = na
var int ny_high_bar = na, var int ny_low_bar = na

// DNA Analysis Results
var float dna_match_pct = na           // How well current session matches historical patterns
var float dna_bull_prob = na           // Probability of bullish outcome based on similar sessions
var string dna_pattern_name = na       // Descriptive name of the pattern

