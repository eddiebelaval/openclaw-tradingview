// KILLZONE EFFECTIVENESS STORAGE
// Tracks historical KZ performance for adaptive scoring
// ══════════════════════════════════════════════════════════════════════════════

// KZ Performance Arrays (per killzone type)
// Each entry: 1 = reversal success, 0 = no significant move, -1 = failed reversal
var int[] kz_london_results = array.new_int(0)      // London Open KZ outcomes
var int[] kz_ny_am_results = array.new_int(0)       // NY AM KZ outcomes
var int[] kz_london_close_results = array.new_int(0) // London Close KZ outcomes
var int[] kz_silver_am_results = array.new_int(0)   // Silver Bullet AM outcomes
var int[] kz_silver_pm_results = array.new_int(0)   // Silver Bullet PM outcomes

// KZ Move Quality Arrays (how much of ADR was captured during KZ)
var float[] kz_london_moves = array.new_float(0)
var float[] kz_ny_am_moves = array.new_float(0)
var float[] kz_london_close_moves = array.new_float(0)
var float[] kz_silver_am_moves = array.new_float(0)
var float[] kz_silver_pm_moves = array.new_float(0)

// Tracking current KZ state (for collection at KZ end)
var int current_kz_type = 0             // Which KZ we're in
var float kz_entry_price = na           // Price at KZ start
var float kz_high = na                  // High during KZ
var float kz_low = na                   // Low during KZ
var int kz_start_bar = na               // Bar when KZ started

// Live KZ Effectiveness Results (current KZ)
