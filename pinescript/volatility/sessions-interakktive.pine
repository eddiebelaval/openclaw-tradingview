var string kz_current_grade = na        // Letter grade (A+, A, B, C, D)
var float kz_reversal_rate = na         // % of successful reversals
var float kz_avg_move = na              // Average move quality

// All KZ Scores (for dashboard display)
var float kz_score_london = na
var float kz_score_ny = na
var float kz_score_lc = na
var float kz_score_sb_am = na
var float kz_score_sb_pm = na
var string kz_grade_london = "—"
var string kz_grade_ny = "—"
var string kz_grade_lc = "—"
var string kz_grade_sb_am = "—"
var string kz_grade_sb_pm = "—"

// Adaptive Session Boundaries Storage
// Tracks when sessions TRULY become active based on volatility, not just time

// Baseline volatility (calculated from quiet periods)
var float baseline_volatility = na
var float[] volatility_history = array.new_float(0)

// Current session activity tracking
var float session_activity_score = 0.0      // 0-100 score of current activity level
var bool true_session_active = false        // Is the session truly active (not just by time)

// Adaptive boundary timestamps
var int asian_true_start = na               // Bar when Asian truly became active
var int asian_true_end = na                 // Bar when Asian activity truly ended
var int london_true_start = na
var int london_true_end = na
var int ny_true_start = na
var int ny_true_end = na

// Early/Late detection flags
var bool asian_started_early = false
var bool london_started_early = false
var bool ny_started_early = false
var bool asian_extended = false
var bool london_extended = false
var bool ny_extended = false

// Rolling volatility for detection
var float rolling_vol_fast = na             // Fast EMA of volatility (reactive)
var float rolling_vol_slow = na             // Slow EMA of volatility (baseline)

// Session Regime Detection Storage
var int current_regime = REGIME_NONE        // Current detected regime
var int prev_regime = REGIME_NONE           // Previous regime (for change detection)
var int regime_start_bar = na               // Bar when current regime started
var int regime_bar_count = 0                // How many bars in current regime
var int regime_session_count = 0            // How many sessions in current regime
var float regime_efficiency = na            // Current efficiency score for regime
var float regime_volatility_ratio = na      // Current volatility ratio for regime
var float regime_directional_score = na     // Directional consistency score

// Regime history per session (for tracking regime persistence across sessions)
var int[] asian_regime_history = array.new_int(0)
var int[] london_regime_history = array.new_int(0)
var int[] ny_regime_history = array.new_int(0)

// ══════════════════════════════════════════════════════════════════════════════
// SESSION ANOMALY DETECTION STORAGE
// Tracks unusual session behavior vs historical norms
// ══════════════════════════════════════════════════════════════════════════════

// Anomaly detection thresholds (based on sensitivity)
var float anomaly_z_threshold = 2.0          // Z-score threshold for anomaly

// Current anomaly state
var int anomaly_count = 0                     // Number of active anomalies
var string anomaly_primary_type = "None"      // Most significant anomaly type
var float anomaly_severity = 0.0              // Overall severity (0-100)
var string anomaly_description = ""           // Human-readable description

// Individual anomaly flags (for current bar)
var bool anomaly_range = false                // Range anomaly active
var bool anomaly_volatility = false           // Volatility spike anomaly
var bool anomaly_timing = false               // Timing anomaly (H/L at unusual time)
var bool anomaly_gap = false                  // Gap anomaly
var bool anomaly_flow = false                 // Flow contradiction anomaly
var bool anomaly_adr = false                  // ADR consumption anomaly

// Anomaly scores (0-100 for each type)
var float anomaly_range_score = 0.0
var float anomaly_volatility_score = 0.0
var float anomaly_timing_score = 0.0
var float anomaly_gap_score = 0.0
var float anomaly_flow_score = 0.0
var float anomaly_adr_score = 0.0

// Historical data for z-score calculations
var float[] hist_session_ranges = array.new_float(0)      // Historical ranges for z-score
var float[] hist_session_volatility = array.new_float(0)  // Historical volatility
var float[] hist_session_gaps = array.new_float(0)        // Historical gap sizes
var float[] hist_adr_usage_rate = array.new_float(0)      // Historical ADR consumption rate

// Session-specific anomaly tracking
var float session_open_gap = na               // Gap from previous session close
var float session_volatility_ratio = na       // Current vs historical volatility
var float session_range_z_score = na          // Z-score of current range
var int session_high_phase = 0                // Phase when high formed (1/2/3)
var int session_low_phase = 0                 // Phase when low formed (1/2/3)

// Anomaly history (for pattern recognition)
var int[] anomaly_history = array.new_int(0)  // Recent anomaly counts per session

// ══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ══════════════════════════════════════════════════════════════════════════════

get_line_style(string style) =>
    switch style
        "Solid" => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_dotted

get_label_size(string size) =>
    switch size
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        => size.small

get_table_size(string size) =>
    switch size
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        => size.small

get_table_position(string pos) =>
    switch pos
        "Top Right" => position.top_right
        "Top Left" => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left" => position.bottom_left
        => position.bottom_right

format_price(float price) =>
    if na(price)
        "N/A"
    else if price >= 100
        str.tostring(price, "#.##")      // 2403.6429 → 2403.64
    else if price >= 1
        str.tostring(price, "#.####")    // 1.08765 → 1.0877
    else
        str.tostring(price, "#.######")  // 0.008567 → 0.008567

format_pct(float pct) =>
    (pct >= 0 ? "+" : "") + str.tostring(pct, "#.#") + "%"

// ══════════════════════════════════════════════════════════════════════════════
// SESSION DNA HELPER FUNCTIONS
// ══════════════════════════════════════════════════════════════════════════════

// Calculate time phase (1=early, 2=mid, 3=late) based on when event occurred in session
get_time_phase(int event_bar, int session_start_bar, int session_end_bar) =>
    if na(event_bar) or na(session_start_bar) or na(session_end_bar)
        2  // Default to mid if unknown
    else
        int total_bars = math.max(1, session_end_bar - session_start_bar)
        int elapsed = event_bar - session_start_bar
        float progress = elapsed / total_bars
        if progress < 0.33
            1  // Early
        else if progress < 0.66
            2  // Mid
        else
            3  // Late

// Calculate range percentile (where does this range rank vs history)
calc_range_percentile(float range_val, float[] range_history) =>
    if na(range_val) or array.size(range_history) < 3
        50.0  // Default to middle if not enough data
    else
        int count_below = 0
        int total = array.size(range_history)
        for i = 0 to total - 1
            if array.get(range_history, i) < range_val
                count_below += 1
        (count_below / total) * 100

// Calculate close position in session range (0 = closed at low, 100 = closed at high)
calc_close_position(float close_price, float sess_high, float sess_low) =>
    if na(close_price) or na(sess_high) or na(sess_low) or sess_high == sess_low
        50.0
    else
        ((close_price - sess_low) / (sess_high - sess_low)) * 100

// Get pattern name based on DNA components
get_pattern_name(int time_high, int time_low, float efficiency, int direction) =>
    string time_high_str = time_high == 1 ? "Early" : time_high == 2 ? "Mid" : "Late"
    string time_low_str = time_low == 1 ? "Early" : time_low == 2 ? "Mid" : "Late"
    string dir_str = direction > 0 ? "Bull" : "Bear"
    string eff_str = efficiency > 60 ? "Clean" : efficiency < 30 ? "Choppy" : "Mixed"

    // Create descriptive pattern name
    if direction > 0
        time_low_str + " Low → " + time_high_str + " High (" + eff_str + ")"
    else
        time_high_str + " High → " + time_low_str + " Low (" + eff_str + ")"

// Calculate DNA similarity between current live values and a historical SessionDNA entry
// Returns similarity score 0-100
calc_dna_similarity(float curr_range_pct, float curr_eff, int curr_time_high, int curr_time_low, float curr_close_pos, int curr_dir, SessionDNA hist) =>
    // Weight factors for each DNA component
    float range_weight = 0.15
    float eff_weight = 0.20
    float time_high_weight = 0.15
    float time_low_weight = 0.15
    float close_weight = 0.15
    float dir_weight = 0.20

    // Calculate individual similarities (0-100 each)
    float range_sim = 100 - math.min(100, math.abs(curr_range_pct - hist.range_pct))
    float eff_sim = 100 - math.min(100, math.abs(curr_eff - hist.efficiency))
    float time_high_sim = curr_time_high == hist.time_high ? 100 : (math.abs(curr_time_high - hist.time_high) == 1 ? 50 : 0)
    float time_low_sim = curr_time_low == hist.time_low ? 100 : (math.abs(curr_time_low - hist.time_low) == 1 ? 50 : 0)
    float close_sim = 100 - math.min(100, math.abs(curr_close_pos - hist.close_pos))
    float dir_sim = curr_dir == hist.direction ? 100 : 0

    // Weighted average
    (range_sim * range_weight) + (eff_sim * eff_weight) + (time_high_sim * time_high_weight) + (time_low_sim * time_low_weight) + (close_sim * close_weight) + (dir_sim * dir_weight)

// Trim DNA array to keep only recent history
trim_dna_array(array<SessionDNA> dna_arr, int max_size) =>
    while array.size(dna_arr) > max_size
        array.shift(dna_arr)

// Update the "next direction" for the previous session entry (called when new session starts)
update_previous_next_dir(array<SessionDNA> dna_arr, int new_direction) =>
    int arr_size = array.size(dna_arr)
    if arr_size > 0
        SessionDNA last_entry = array.get(dna_arr, arr_size - 1)
        last_entry.next_dir := new_direction

// ══════════════════════════════════════════════════════════════════════════════
// KILLZONE EFFECTIVENESS HELPER FUNCTIONS
// ══════════════════════════════════════════════════════════════════════════════

// Trim KZ arrays to keep only recent entries
trim_kz_arrays(int[] results, float[] moves, int max_size) =>
    while array.size(results) > max_size
        array.shift(results)
        array.shift(moves)

// Calculate KZ effectiveness score from results array
// Returns: [score (0-100), reversal_rate, avg_move_quality]
calc_kz_effectiveness(int[] results, float[] moves) =>
    int size = array.size(results)
    if size == 0
        [na, na, na]
    else
        int successes = 0
        int total_trades = 0
        float total_move = 0.0

        for i = 0 to size - 1
            int result = array.get(results, i)
            float move = array.get(moves, i)
            if result == 1
                successes += 1
            if result != 0  // Counted as a trade attempt
                total_trades += 1
            total_move += nz(move, 0)

        float reversal_rate = total_trades > 0 ? (successes / total_trades) * 100 : na
        float avg_move = size > 0 ? total_move / size : na

        // Score = weighted combination of reversal rate (70%) and move quality (30%)
        float score = na
        if not na(reversal_rate)
            float move_score = math.min(100, nz(avg_move, 0) * 2)  // 50% ADR move = 100 score
            score := (reversal_rate * 0.7) + (move_score * 0.3)

        [score, reversal_rate, avg_move]

// Convert score to letter grade
get_kz_grade(float score) =>
    if na(score)
        "—"
    else if score >= 90
        "A+"
    else if score >= 80
        "A"
    else if score >= 70
        "B"
    else if score >= 60
        "C"
    else
        "D"

// Get grade color
get_kz_grade_color(float score) =>
    if na(score)
        color.gray
    else if score >= 80
        color.new(#00E676, 0)  // Green for A+/A
    else if score >= 70
        color.new(#FFEB3B, 0)  // Yellow for B
    else if score >= 60
        color.new(#FF9800, 0)  // Orange for C
    else
        color.new(#F44336, 0)  // Red for D

// Get arrays for specific KZ type
get_kz_arrays(int kz_type) =>
    switch kz_type
        KZ_LONDON_OPEN => [kz_london_results, kz_london_moves]
        KZ_NY_AM => [kz_ny_am_results, kz_ny_am_moves]
        KZ_LONDON_CLOSE => [kz_london_close_results, kz_london_close_moves]
        KZ_SILVER_AM => [kz_silver_am_results, kz_silver_am_moves]
        KZ_SILVER_PM => [kz_silver_pm_results, kz_silver_pm_moves]
        => [kz_london_results, kz_london_moves]  // Default

// ══════════════════════════════════════════════════════════════════════════════
// ADAPTIVE BOUNDARY HELPER FUNCTIONS
// ══════════════════════════════════════════════════════════════════════════════

// Get sensitivity multiplier based on user setting
get_adaptive_sensitivity() =>
    switch i_adaptive_sensitivity
        "Low" => 2.0      // Requires 2x baseline volatility to trigger
        "Medium" => 1.5   // Requires 1.5x baseline
        "High" => 1.2     // Requires 1.2x baseline (more sensitive)
        => 1.5

// Calculate instantaneous volatility (True Range based)
calc_instant_volatility() =>
    float tr = math.max(high - low, math.max(math.abs(high - nz(close[1], close)), math.abs(low - nz(close[1], close))))
    tr

// Pre-calculate ta.* functions for activity score (must be at global scope for consistency)
float _activity_volume_avg = ta.sma(volume, 20)
float _activity_recent_range = ta.highest(high, 5) - ta.lowest(low, 5)
float _activity_avg_range = ta.sma(high - low, 20)
float atr_14 = ta.atr(14)

// Calculate session activity score (0-100)
// Based on: current volatility vs baseline, volume vs average, range expansion
calc_activity_score(float current_vol, float baseline_vol, float vol_ratio, float volume_avg, float recent_range, float avg_range) =>
    if na(current_vol) or na(baseline_vol) or baseline_vol == 0
        50.0  // Default to neutral if no data
    else
        // Volatility component (0-50 points)
        float vol_score = math.min(50, (current_vol / baseline_vol) * 25)

        // Volume component (0-30 points) - if volume data available
        float vol_component = volume > 0 and nz(volume_avg, 0) > 0 ? math.min(30, (volume / volume_avg) * 15) : 15

        // Range expansion component (0-20 points)
        float range_component = nz(avg_range, 0) > 0 ? math.min(20, (recent_range / (avg_range * 5)) * 20) : 10

        math.min(100, vol_score + vol_component + range_component)

// Detect if volatility surge indicates true session start
is_volatility_surge(float fast_vol, float slow_vol, float sensitivity) =>
    if na(fast_vol) or na(slow_vol) or slow_vol == 0
        false
    else
        fast_vol > slow_vol * sensitivity

// Detect if volatility drop indicates true session end
is_volatility_drop(float fast_vol, float slow_vol) =>
    if na(fast_vol) or na(slow_vol) or slow_vol == 0
        false
    else
        fast_vol < slow_vol * 0.6  // Activity dropped to 60% of baseline

// Check if we're in the "pre-session" window (30 mins before official start)
is_pre_session_window(string session_time, string tz) =>
    // Create a 30-minute earlier window
    not na(time(timeframe.period, session_time, tz))

// ══════════════════════════════════════════════════════════════════════════════
// SESSION REGIME HELPER FUNCTIONS
// ══════════════════════════════════════════════════════════════════════════════

// Get regime name from ID
get_regime_name(int regime_id) =>
    switch regime_id
        REGIME_TRENDING => "Trending"
        REGIME_RANGING  => "Ranging"
        REGIME_VOLATILE => "Volatile"
        REGIME_DEAD     => "Dead"
        => "Normal"

// Get regime color
get_regime_color(int regime_id) =>
    switch regime_id
        REGIME_TRENDING => color.new(#26A69A, 0)   // Teal - good for trends
        REGIME_RANGING  => color.new(#2196F3, 0)   // Blue - mean reversion
        REGIME_VOLATILE => color.new(#FF9800, 0)   // Orange - caution
        REGIME_DEAD     => color.new(#9E9E9E, 0)   // Gray - avoid
        => color.new(#888888, 0)

// Get strategy suggestion for regime
get_regime_strategy(int regime_id) =>
    switch regime_id
        REGIME_TRENDING => "Trend follow, trail stops"
        REGIME_RANGING  => "Fade extremes, mean revert"
        REGIME_VOLATILE => "Wide stops, reduce size"
        REGIME_DEAD     => "Avoid, wait for breakout"
        => "Analyzing..."

// Calculate efficiency ratio (directional movement vs total movement)
// Higher = more trending, Lower = more choppy
calc_regime_efficiency(int lookback) =>
    if lookback < 2
        0.5
    else
        float net_move = math.abs(close - close[lookback])
        float total_move = 0.0
        for i = 0 to lookback - 1
            total_move += math.abs(close[i] - close[i + 1])
        total_move > 0 ? net_move / total_move : 0.5

// Calculate directional consistency (how many bars move in same direction)
calc_directional_score(int lookback) =>
    if lookback < 2
        50.0
    else
        int up_bars = 0
        int down_bars = 0
        for i = 0 to lookback - 1
            if close[i] > close[i + 1]
                up_bars += 1
            else if close[i] < close[i + 1]
                down_bars += 1
        int dominant = math.max(up_bars, down_bars)
        (int(dominant) * 100.0) / int(lookback)

// Pre-calculate ta.* functions for volatility ratio (must be at global scope for consistency)
float _vol_atr_fast = ta.atr(5)
float _vol_atr_slow = ta.atr(i_regime_lookback)

// Calculate volatility ratio (current vs average)
calc_volatility_ratio(float current_atr, float avg_atr) =>
    if na(current_atr) or na(avg_atr) or avg_atr == 0
        1.0
    else
        current_atr / avg_atr

// Classify regime based on metrics
classify_regime(float efficiency, float vol_ratio, float directional) =>
    // Dead: Very low volatility, market is asleep
    if vol_ratio < i_regime_dead_thresh
        REGIME_DEAD
    // Volatile: High volatility but low efficiency (chaotic)
    else if vol_ratio > i_regime_volatile_thresh and efficiency < 0.35
        REGIME_VOLATILE
    // Trending: High efficiency OR strong directional consistency
    // Either condition alone is enough — a clean move (high efficiency) or
    // persistent direction (high directional score) both indicate a trend
    else if efficiency >= i_regime_trend_thresh or (directional >= 65 and efficiency >= 0.35)
        REGIME_TRENDING
    // Ranging: Everything else (moderate volatility, low efficiency, no clear direction)
    else
        REGIME_RANGING

// ══════════════════════════════════════════════════════════════════════════════
// SESSION RANGE PROJECTION HELPER FUNCTIONS
// Calculate projected high/low targets based on multiple factors
// ══════════════════════════════════════════════════════════════════════════════

// Get regime multiplier for range projection
// Trending = extend range, Ranging = compress, Volatile = widen, Dead = minimal
get_regime_range_multiplier(int regime) =>
    switch regime
        REGIME_TRENDING => 1.15    // Expect 15% larger range in trends
        REGIME_RANGING  => 0.85    // Expect 15% smaller range in ranges
        REGIME_VOLATILE => 1.25    // Expect 25% larger range in volatile
        REGIME_DEAD     => 0.60    // Expect 40% smaller range in dead markets
        => 1.0

// Get projection mode multiplier
get_projection_mode_mult() =>
    switch i_range_proj_mode
        "Historical" => 1.0       // Use exact historical average
        "Adaptive" => 1.0         // Base (will be modified by other factors)
        "Conservative" => 0.75    // Use 75% of projected range
        => 1.0

// Calculate ADR constraint factor
// If ADR is almost used up, reduce projection
get_adr_constraint(float adr_used_pct, float adr_val, float proj_range) =>
    if na(adr_used_pct) or na(adr_val)
        1.0  // No constraint if no ADR data
    else
        float adr_remaining = adr_val * (1 - adr_used_pct / 100)
        if proj_range <= adr_remaining
            1.0  // Projection fits within remaining ADR
        else if adr_remaining > 0
            adr_remaining / proj_range  // Scale down to fit ADR
        else
            0.5  // ADR exhausted, minimal projection

// Calculate bias skew factor
// Bullish bias = more upside projection, less downside
// Returns [high_mult, low_mult]
get_bias_skew(float bias) =>
    if na(bias) or math.abs(bias) < 15
        [1.0, 1.0]  // Neutral - symmetric projections
    else if bias > 0
        // Bullish - skew projections upward
        float strength = math.min(50, math.abs(bias)) / 50  // 0 to 1
        float high_mult = 1.0 + (strength * 0.3)    // Up to 30% more upside
        float low_mult = 1.0 - (strength * 0.2)     // Up to 20% less downside
        [high_mult, low_mult]
    else
        // Bearish - skew projections downward
        float strength = math.min(50, math.abs(bias)) / 50
        float high_mult = 1.0 - (strength * 0.2)    // Up to 20% less upside
        float low_mult = 1.0 + (strength * 0.3)     // Up to 30% more downside
        [high_mult, low_mult]

// Master projection calculation
// Returns [srp_high, srp_low, confidence]
calc_session_range_projection(float sess_open, float avg_range, int regime, float adr_used_pct, float adr_val, float bias) =>
    if na(sess_open) or na(avg_range) or avg_range <= 0
        [na, na, na]
    else
        // Start with historical average range
        float base_range = avg_range
        
        // Apply regime multiplier (only in Adaptive mode)
        float regime_mult = i_range_proj_mode == "Adaptive" ? get_regime_range_multiplier(regime) : 1.0
        
        // Apply projection mode multiplier
        float mode_mult = get_projection_mode_mult()
        
        // Calculate adjusted range
        float adj_range = base_range * regime_mult * mode_mult
        
        // Apply ADR constraint (only in Adaptive mode)
        float adr_mult = i_range_proj_mode == "Adaptive" ? get_adr_constraint(adr_used_pct, adr_val, adj_range) : 1.0
        float constrained_range = adj_range * adr_mult
        
        // Get bias skew
        [high_mult, low_mult] = get_bias_skew(bias)
        
        // Calculate half-ranges (from open)
        float half_range = constrained_range / 2
        float upside = half_range * high_mult
        float downside = half_range * low_mult
        
        // Calculate projected levels
        float p_high = sess_open + upside
        float p_low = sess_open - downside
        
        // Calculate confidence (0-100)
        // Higher confidence if: good historical data, clear regime, moderate ADR usage
        float conf = 50.0  // Base confidence
        
        // Regime clarity bonus
        if regime == REGIME_TRENDING or regime == REGIME_RANGING
            conf += 15  // Clear regime
        else if regime == REGIME_DEAD
            conf -= 10  // Low confidence in dead markets
        
        // ADR factor
        if not na(adr_used_pct)
            if adr_used_pct < 30
                conf += 15  // Plenty of ADR remaining
            else if adr_used_pct > 80
                conf -= 20  // ADR exhausted
        
        // Bias alignment bonus
        if not na(bias) and math.abs(bias) > 30
            conf += 10  // Clear directional bias
        
        // Clamp confidence
        conf := math.max(20, math.min(90, conf))
        
        [p_high, p_low, conf]

// Get anomaly sensitivity threshold (z-score)
get_anomaly_z_threshold() =>
    switch i_anomaly_sensitivity
        "Low" => 2.5       // Only extreme anomalies (>2.5 standard deviations)
        "Medium" => 2.0    // Moderate sensitivity (>2.0 std dev)
        "High" => 1.5      // High sensitivity (>1.5 std dev)
        => 2.0

// Calculate z-score for a value given mean and standard deviation
calc_z_score(float value, float mean_val, float std_val) =>
    if na(value) or na(mean_val) or na(std_val) or std_val == 0
        0.0
    else
        (value - mean_val) / std_val

// Calculate mean of array
calc_array_mean(float[] arr) =>
    int size = array.size(arr)
    if size == 0
        na
    else
        array.avg(arr)

// Calculate standard deviation of array
calc_array_std(float[] arr) =>
    int size = array.size(arr)
    if size < 2
        na
    else
        array.stdev(arr)

// Detect range anomaly (session range significantly different from historical)
detect_range_anomaly(float current_range, float[] range_history, float z_thresh) =>
    int size = array.size(range_history)
    if size < 5 or na(current_range)
        [false, 0.0, 0.0]
    else
        float mean_range = calc_array_mean(range_history)
        float std_range = calc_array_std(range_history)
        float z = calc_z_score(current_range, mean_range, std_range)
        bool is_anomaly = math.abs(z) > z_thresh
        float score = math.min(100, math.abs(z) * 33.3)  // 3 std dev = 100 score
        [is_anomaly, score, z]

// Detect volatility spike anomaly (sudden increase in volatility)
detect_volatility_anomaly(float current_vol, float baseline_vol, float z_thresh) =>
    if na(current_vol) or na(baseline_vol) or baseline_vol == 0
        [false, 0.0, 0.0]
    else
        float ratio = current_vol / baseline_vol
        // Anomaly if volatility is more than threshold times baseline
        float anomaly_mult = z_thresh  // Use z_thresh as multiplier
        bool is_anomaly = ratio > (1 + anomaly_mult) or ratio < (1 / (1 + anomaly_mult * 0.5))
        float score = ratio > 1 ? math.min(100, (ratio - 1) * 50) : math.min(100, (1 / ratio - 1) * 50)
        [is_anomaly, score, ratio]

// Detect timing anomaly (high/low forming at unusual phase)
// Normal: Asian high/low in early/mid, London/NY high/low spread across phases
// Anomaly: High AND Low both in same extreme phase (both early or both late)
detect_timing_anomaly(int high_phase, int low_phase, int session_type) =>
    if high_phase == 0 or low_phase == 0
        [false, 0.0]
    else
        // Anomaly if both high and low form in same phase (unusual consolidation)
        bool same_phase = high_phase == low_phase
        // Or if reversal pattern (high early + low late or vice versa) in ranging session
        bool extreme_reversal = (high_phase == 1 and low_phase == 3) or (high_phase == 3 and low_phase == 1)
        bool is_anomaly = same_phase
        float score = same_phase ? 70.0 : extreme_reversal ? 50.0 : 0.0
        [is_anomaly, score]

// Detect gap anomaly (significant gap from previous session)
detect_gap_anomaly(float gap_size, float[] gap_history, float z_thresh) =>
    int size = array.size(gap_history)
    if size < 5 or na(gap_size)
        [false, 0.0, 0.0]
    else
        float mean_gap = calc_array_mean(gap_history)
        float std_gap = calc_array_std(gap_history)
        float z = calc_z_score(math.abs(gap_size), mean_gap, std_gap)
        bool is_anomaly = z > z_thresh
        float score = math.min(100, z * 33.3)
        [is_anomaly, score, z]

// Detect flow anomaly (direction contradicts strong historical flow)
detect_flow_anomaly(int current_dir, int prev_sess_dir, float continuation_pct) =>
    if current_dir == 0 or prev_sess_dir == 0 or na(continuation_pct)
        [false, 0.0]
    else
        bool same_dir = current_dir == prev_sess_dir
        // Anomaly if strong continuation tendency but reversed, or strong reversal tendency but continued
        bool is_anomaly = false
        float score = 0.0
        if continuation_pct >= 70 and not same_dir
            // Strong continuation tendency but we reversed
            is_anomaly := true
            score := continuation_pct
        else if continuation_pct <= 30 and same_dir
            // Strong reversal tendency but we continued
            is_anomaly := true
            score := 100 - continuation_pct
        [is_anomaly, score]

// Detect ADR consumption anomaly (unusual rate of ADR usage)
detect_adr_anomaly(float adr_used_pct, float session_progress, float[] adr_rate_history) =>
    if na(adr_used_pct) or na(session_progress) or session_progress == 0
        [false, 0.0, 0.0]
    else
        // Expected ADR usage based on session progress
        float expected_rate = session_progress * 100  // Linear expectation
        float actual_rate = adr_used_pct / session_progress  // Actual rate
        float deviation = actual_rate - expected_rate

        // Anomaly if using ADR much faster or slower than expected
        bool is_anomaly = math.abs(deviation) > 50  // More than 50% deviation from expected
        float score = math.min(100, math.abs(deviation))
        [is_anomaly, score, deviation]

// Get anomaly type name
get_anomaly_type_name(bool range_a, bool vol_a, bool timing_a, bool gap_a, bool flow_a, bool adr_a) =>
    if range_a
        "Range"
    else if vol_a
        "Volatility"
    else if timing_a
        "Timing"
    else if gap_a
        "Gap"
    else if flow_a
        "Flow"
    else if adr_a
        "ADR"
    else
        "None"

// Get anomaly severity level
get_anomaly_severity_level(float severity) =>
    if severity >= 80
        "Critical"
    else if severity >= 50
        "Warning"
    else if severity > 0
        "Minor"
    else
        "Normal"

// Get anomaly color based on severity
get_anomaly_color(float severity) =>
    if severity >= 80
        color.new(#F44336, 0)   // Red - Critical
    else if severity >= 50
        color.new(#FF9800, 0)   // Orange - Warning
    else if severity > 0
        color.new(#FFEB3B, 0)   // Yellow - Minor
    else
        color.new(#9E9E9E, 50)  // Gray - Normal

// Get anomaly marker text
get_anomaly_marker(float severity) =>
    if severity >= 80
        "‼"   // Double exclamation for critical
    else if severity >= 50
        "⚠"   // Warning symbol
    else
        "•"   // Dot for minor

// ══════════════════════════════════════════════════════════════════════════════
// SESSION DETECTION
// ══════════════════════════════════════════════════════════════════════════════

in_asian() => not na(time(timeframe.period, i_asian_start, i_timezone))
in_london() => not na(time(timeframe.period, i_london_start, i_timezone))
in_ny() => not na(time(timeframe.period, i_ny_start, i_timezone))
in_overlap() => in_london() and in_ny()

asian_start() => in_asian() and not in_asian()[1]
london_start() => in_london() and not in_london()[1]
ny_start() => in_ny() and not in_ny()[1]
asian_end() => not in_asian() and in_asian()[1]
london_end() => not in_london() and in_london()[1]
ny_end() => not in_ny() and in_ny()[1]

get_session() =>
    if in_overlap()
        SESSION_OVERLAP
    else if in_ny()
        SESSION_NEWYORK
    else if in_london()
        SESSION_LONDON
    else if in_asian()
        SESSION_ASIAN
    else
        SESSION_NONE

get_session_name(int id) =>
    switch id
        SESSION_ASIAN => "ASIAN"
        SESSION_LONDON => "LONDON"
        SESSION_NEWYORK => "NEW YORK"
        SESSION_OVERLAP => "LDN-NY"
        => "CLOSED"

// ══════════════════════════════════════════════════════════════════════════════
// KILLZONE & SILVER BULLET DETECTION
// ══════════════════════════════════════════════════════════════════════════════

in_kz_asian() => i_kz_enabled and i_kz_asian and not na(time(timeframe.period, i_kz_asian_time, i_timezone))
in_kz_london() => i_kz_enabled and i_kz_london and not na(time(timeframe.period, i_kz_london_time, i_timezone))
in_kz_ny_am() => i_kz_enabled and i_kz_ny_am and not na(time(timeframe.period, i_kz_ny_am_time, i_timezone))
in_kz_london_close() => i_kz_enabled and i_kz_london_close and not na(time(timeframe.period, i_kz_london_close_time, i_timezone))

in_silver_am() => i_silver_enabled and i_silver_am and not na(time(timeframe.period, i_silver_am_time, i_timezone))
in_silver_pm() => i_silver_enabled and i_silver_pm and not na(time(timeframe.period, i_silver_pm_time, i_timezone))

silver_am_start() => in_silver_am() and not in_silver_am()[1]
silver_pm_start() => in_silver_pm() and not in_silver_pm()[1]
kz_london_start() => in_kz_london() and not in_kz_london()[1]
kz_ny_am_start() => in_kz_ny_am() and not in_kz_ny_am()[1]

get_killzone() =>
    if in_silver_am()
        KZ_SILVER_AM
    else if in_silver_pm()
        KZ_SILVER_PM
    else if in_kz_london()
        KZ_LONDON_OPEN
    else if in_kz_ny_am()
        KZ_NY_AM
    else if in_kz_london_close()
        KZ_LONDON_CLOSE
    else if in_kz_asian()
        KZ_ASIAN
    else
        KZ_NONE

get_kz_name(int id) =>
    switch id
        KZ_ASIAN => "Asian KZ"
        KZ_LONDON_OPEN => "London Open"
        KZ_NY_AM => "NY AM"
        KZ_LONDON_CLOSE => "LDN Close"
        KZ_SILVER_AM => "Silver Bullet AM"
        KZ_SILVER_PM => "Silver Bullet PM"
        => "None"

// ══════════════════════════════════════════════════════════════════════════════
// MACRO TIME DETECTION (ICT)
// ══════════════════════════════════════════════════════════════════════════════

is_macro_time() =>
    if not i_ict_enabled or not i_macro_times
        false
    else
        bool result = not na(time(timeframe.period, "0950-0955", "America/New_York"))
        result := result or not na(time(timeframe.period, "1010-1015", "America/New_York"))
        result := result or not na(time(timeframe.period, "1050-1055", "America/New_York"))
        result := result or not na(time(timeframe.period, "1110-1115", "America/New_York"))
        result

macro_start() => is_macro_time() and not is_macro_time()[1]

// ══════════════════════════════════════════════════════════════════════════════
// CBDR DETECTION (Central Bank Dealers Range — 20:00-00:00 UTC)
// ══════════════════════════════════════════════════════════════════════════════

// CBDR window: 20:00-00:00 UTC (first 4 hours of Asian session)
bool in_cbdr_window = not na(time(timeframe.period, "2000-0000", i_timezone))
bool cbdr_window_start = in_cbdr_window and not in_cbdr_window[1]
bool cbdr_window_end = not in_cbdr_window and in_cbdr_window[1]

// Track CBDR range
if i_cbdr_enabled
    if cbdr_window_start
        cbdr_high := high
        cbdr_low := low
        cbdr_start_bar := bar_index
        cbdr_complete := false
    else if in_cbdr_window and not cbdr_complete
        cbdr_high := math.max(nz(cbdr_high, high), high)
        cbdr_low := math.min(nz(cbdr_low, low), low)
    if cbdr_window_end and not cbdr_complete
        cbdr_range := cbdr_high - cbdr_low
        cbdr_complete := true

// ══════════════════════════════════════════════════════════════════════════════
// PREVIOUS DAY & KEY LEVELS
// ══════════════════════════════════════════════════════════════════════════════

[pdh, pdl, pdc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)
[day_open] = request.security(syminfo.tickerid, "D", [open], lookahead=barmerge.lookahead_on)
[week_open, pwh, pwl] = request.security(syminfo.tickerid, "W", [open, high[1], low[1]], lookahead=barmerge.lookahead_on)
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[pqh, pql] = request.security(syminfo.tickerid, "3M", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[phh, phl] = request.security(syminfo.tickerid, "60", [high[1], low[1]], lookahead=barmerge.lookahead_on)

float prev_day_high = pdh
float prev_day_low = pdl
float prev_day_close = pdc
float midnight_open_price = day_open
float weekly_open_price = week_open
float prev_week_high = pwh
float prev_week_low = pwl
float prev_month_high = pmh
float prev_month_low = pml
float prev_quarter_high = pqh
float prev_quarter_low = pql
float prev_hour_high = phh
float prev_hour_low = phl

// ══════════════════════════════════════════════════════════════════════════════
// ADR CALCULATION (Average Daily Range)
// ══════════════════════════════════════════════════════════════════════════════

[daily_high, daily_low] = request.security(syminfo.tickerid, "D", [high, low], lookahead=barmerge.lookahead_on)
float today_range = daily_high - daily_low

// Calculate ADR
var float[] daily_ranges = array.new_float(0)
var float adr_value = na

int day_change = ta.change(time("D"))
bool new_day = day_change != 0
if new_day
    if array.size(daily_ranges) >= i_adr_period
        array.shift(daily_ranges)
    if not na(pdh) and not na(pdl)
        array.push(daily_ranges, pdh - pdl)
    if array.size(daily_ranges) > 0
        adr_value := array.avg(daily_ranges)

// ADR projections from midnight open
float adr_high_proj = not na(midnight_open_price) and not na(adr_value) ? midnight_open_price + (adr_value / 2) : na
float adr_low_proj = not na(midnight_open_price) and not na(adr_value) ? midnight_open_price - (adr_value / 2) : na

// ADR % used today
float adr_used_pct = not na(today_range) and not na(adr_value) and adr_value > 0 ? (today_range / adr_value) * 100 : na
bool adr_exhausted = not na(adr_used_pct) and adr_used_pct >= 80

// ══════════════════════════════════════════════════════════════════════════════
// ADAPTIVE BOUNDARY DETECTION
// ══════════════════════════════════════════════════════════════════════════════

// Calculate rolling volatility metrics
float instant_vol = calc_instant_volatility()
float vol_ema_fast = ta.ema(instant_vol, 5)    // Fast: 5-bar EMA (reactive)
float vol_ema_slow = ta.ema(instant_vol, 20)   // Slow: 20-bar EMA (baseline)

// Update rolling volatility trackers
rolling_vol_fast := vol_ema_fast
rolling_vol_slow := vol_ema_slow

// Store volatility history for baseline calculation
if barstate.isconfirmed
    if array.size(volatility_history) >= 100
        array.shift(volatility_history)
    array.push(volatility_history, instant_vol)

// Calculate baseline volatility (median of quiet periods)
if array.size(volatility_history) >= 20
    baseline_volatility := array.percentile_nearest_rank(volatility_history, 50)

// Get sensitivity setting
float adaptive_sens = get_adaptive_sensitivity()

// Calculate current session activity score
session_activity_score := calc_activity_score(vol_ema_fast, vol_ema_slow, vol_ema_fast / nz(vol_ema_slow, vol_ema_fast), _activity_volume_avg, _activity_recent_range, _activity_avg_range)

// Determine if true session is active (volatility-based)
true_session_active := is_volatility_surge(vol_ema_fast, vol_ema_slow, adaptive_sens)

// ─────────────────────────────────────────────────────────────────────────────
// ASIAN SESSION ADAPTIVE DETECTION
// ─────────────────────────────────────────────────────────────────────────────

// Detect true Asian start (volatility surge within session window)
if i_adaptive_enabled and in_asian()
    // Check for true session activation
    if na(asian_true_start) and is_volatility_surge(vol_ema_fast, vol_ema_slow, adaptive_sens)
        asian_true_start := bar_index

    // Check for extended session (activity continues past normal end)
    if asian_end() and is_volatility_surge(vol_ema_fast, vol_ema_slow, adaptive_sens * 0.8)
        asian_extended := true

// Reset on new session
if asian_start()
    asian_true_start := na
    asian_true_end := na
    asian_started_early := false
    asian_extended := false

// Detect early Asian start (volatility surge 30 mins before official start)
if i_adaptive_enabled and i_adaptive_early_detect
    // Check if we're just before Asian session and seeing volatility surge
    bool pre_asian = not in_asian() and in_asian()[1] == false
    if pre_asian and is_volatility_surge(vol_ema_fast, vol_ema_slow, adaptive_sens * 1.2)
        // Could be early start - will confirm when official session begins
        asian_started_early := true

// ─────────────────────────────────────────────────────────────────────────────
// LONDON SESSION ADAPTIVE DETECTION
// ─────────────────────────────────────────────────────────────────────────────

if i_adaptive_enabled and in_london()
    if na(london_true_start) and is_volatility_surge(vol_ema_fast, vol_ema_slow, adaptive_sens)
        london_true_start := bar_index

    if london_end() and is_volatility_surge(vol_ema_fast, vol_ema_slow, adaptive_sens * 0.8)
        london_extended := true

if london_start()
    london_true_start := na
    london_true_end := na
    london_started_early := false
    london_extended := false

// Early London detection
if i_adaptive_enabled and i_adaptive_early_detect and not in_london() and not in_asian()
    if is_volatility_surge(vol_ema_fast, vol_ema_slow, adaptive_sens * 1.2)
        london_started_early := true

// ─────────────────────────────────────────────────────────────────────────────
// NEW YORK SESSION ADAPTIVE DETECTION
// ─────────────────────────────────────────────────────────────────────────────

if i_adaptive_enabled and in_ny()
    if na(ny_true_start) and is_volatility_surge(vol_ema_fast, vol_ema_slow, adaptive_sens)
        ny_true_start := bar_index

    if ny_end() and is_volatility_surge(vol_ema_fast, vol_ema_slow, adaptive_sens * 0.8)
        ny_extended := true

if ny_start()
    ny_true_start := na
    ny_true_end := na
    ny_started_early := false
    ny_extended := false

// Early NY detection
if i_adaptive_enabled and i_adaptive_early_detect and not in_ny() and in_london()
    if is_volatility_surge(vol_ema_fast, vol_ema_slow, adaptive_sens * 1.3)  // Higher threshold during London
        ny_started_early := true

// ─────────────────────────────────────────────────────────────────────────────
// ADAPTIVE BOUNDARY HELPER VALUES (for dashboard/alerts)
// ─────────────────────────────────────────────────────────────────────────────

// Calculate delay from official start to true start (in bars)
int asian_start_delay = not na(asian_true_start) and not na(asian_start_bar) ? asian_true_start - asian_start_bar : na
int london_start_delay = not na(london_true_start) and not na(london_start_bar) ? london_true_start - london_start_bar : na
int ny_start_delay = not na(ny_true_start) and not na(ny_start_bar) ? ny_true_start - ny_start_bar : na

// Get current session's adaptive status
string adaptive_status = "Normal"
if i_adaptive_enabled
    int curr_sess = get_session()
    if curr_sess == SESSION_ASIAN
        if asian_started_early
            adaptive_status := "Early Start"
        else if not na(asian_true_start) and asian_start_delay > 5
            adaptive_status := "Delayed (" + str.tostring(asian_start_delay) + " bars)"
        else if asian_extended
            adaptive_status := "Extended"
        else if not na(asian_true_start)
            adaptive_status := "Active"
        else
            adaptive_status := "Waiting..."
    else if curr_sess == SESSION_LONDON or curr_sess == SESSION_OVERLAP
        if london_started_early
            adaptive_status := "Early Start"
        else if not na(london_true_start) and london_start_delay > 5
            adaptive_status := "Delayed (" + str.tostring(london_start_delay) + " bars)"
        else if london_extended
            adaptive_status := "Extended"
        else if not na(london_true_start)
            adaptive_status := "Active"
        else
            adaptive_status := "Waiting..."
    else if curr_sess == SESSION_NEWYORK
        if ny_started_early
            adaptive_status := "Early Start"
        else if not na(ny_true_start) and ny_start_delay > 5
            adaptive_status := "Delayed (" + str.tostring(ny_start_delay) + " bars)"
        else if ny_extended
            adaptive_status := "Extended"
        else if not na(ny_true_start)
            adaptive_status := "Active"
        else
            adaptive_status := "Waiting..."

// ══════════════════════════════════════════════════════════════════════════════
// SESSION REGIME DETECTION
// ══════════════════════════════════════════════════════════════════════════════

// Calculate regime metrics
if i_regime_enabled
    regime_efficiency := calc_regime_efficiency(i_regime_lookback)
    regime_volatility_ratio := calc_volatility_ratio(_vol_atr_fast, _vol_atr_slow)
    regime_directional_score := calc_directional_score(i_regime_lookback)

    // Classify current regime
    int new_regime = classify_regime(regime_efficiency, regime_volatility_ratio, regime_directional_score)

    // Only update regime during active sessions
    if get_session() != SESSION_NONE
        // Check for regime change
        if new_regime != current_regime
            prev_regime := current_regime
            current_regime := new_regime
            regime_start_bar := bar_index
            regime_bar_count := 0
        else
            regime_bar_count += 1
    else
        // Outside sessions, keep tracking but mark as NONE
        if current_regime != REGIME_NONE
            prev_regime := current_regime
        current_regime := REGIME_NONE

// Track regime at session end (for persistence tracking across sessions)
if i_regime_enabled and asian_end() and current_regime != REGIME_NONE
    if array.size(asian_regime_history) >= 20
        array.shift(asian_regime_history)
    array.push(asian_regime_history, current_regime)

if i_regime_enabled and london_end() and current_regime != REGIME_NONE
    if array.size(london_regime_history) >= 20
        array.shift(london_regime_history)
    array.push(london_regime_history, current_regime)

if i_regime_enabled and ny_end() and current_regime != REGIME_NONE
    if array.size(ny_regime_history) >= 20
        array.shift(ny_regime_history)
    array.push(ny_regime_history, current_regime)

// Calculate regime persistence (how many consecutive sessions same regime)
calc_regime_persistence(int[] regime_history, int current_reg) =>
    int count = 0
    int size = array.size(regime_history)
    if size > 0
        for i = size - 1 to 0
            if array.get(regime_history, i) == current_reg
                count += 1
            else
                break
    count

// Get current session's regime persistence
int regime_persistence = 0
if i_regime_enabled and get_session() != SESSION_NONE
    int curr_sess = get_session()
    if curr_sess == SESSION_ASIAN
        regime_persistence := calc_regime_persistence(asian_regime_history, current_regime)
    else if curr_sess == SESSION_LONDON or curr_sess == SESSION_OVERLAP
        regime_persistence := calc_regime_persistence(london_regime_history, current_regime)
    else if curr_sess == SESSION_NEWYORK
        regime_persistence := calc_regime_persistence(ny_regime_history, current_regime)

// Format regime duration string
string regime_duration_str = str.tostring(regime_bar_count) + " bars"
if regime_persistence > 0
    regime_duration_str := regime_duration_str + " (" + str.tostring(regime_persistence) + " sessions)"

// ══════════════════════════════════════════════════════════════════════════════
// SESSION HIGH/LOW TRACKING
// ══════════════════════════════════════════════════════════════════════════════

// Asian
if asian_start()
    asian_open := open
    asian_high := high
    asian_low := low
    asian_start_bar := bar_index
    asian_high_bar := bar_index
    asian_low_bar := bar_index
else if in_asian()
    if high > nz(asian_high, high)
        asian_high := high
        asian_high_bar := bar_index
    if low < nz(asian_low, low)
        asian_low := low
        asian_low_bar := bar_index

// London
if london_start()
    london_open := open
    london_high := high
    london_low := low
    london_start_bar := bar_index
    london_high_bar := bar_index
    london_low_bar := bar_index
else if in_london()
    if high > nz(london_high, high)
        london_high := high
        london_high_bar := bar_index
    if low < nz(london_low, low)
        london_low := low
        london_low_bar := bar_index

// NY
if ny_start()
    ny_open := open
    ny_high := high
    ny_low := low
    ny_start_bar := bar_index
    ny_high_bar := bar_index
    ny_low_bar := bar_index
else if in_ny()
    if high > nz(ny_high, high)
        ny_high := high
        ny_high_bar := bar_index
    if low < nz(ny_low, low)
        ny_low := low
        ny_low_bar := bar_index

// ══════════════════════════════════════════════════════════════════════════════
// SESSION RANGE PROJECTION CALCULATION
// Project expected high/low at session start, track hits during session
// ══════════════════════════════════════════════════════════════════════════════

// Calculate initial bias for projections (using previous session direction)
get_initial_projection_bias(int sess) =>
    // Use inter-session flow + position vs PDC for initial bias
    float bias = 0.0
    
    // Previous session direction influence
    if sess == SESSION_LONDON and array.size(asian_direction) > 0
        int asian_dir = array.get(asian_direction, array.size(asian_direction) - 1)
        // London often continues Asian direction
        float continuation_rate = array.size(london_followed_asian) > 2 ? (array.sum(london_followed_asian) / array.size(london_followed_asian)) : 0.5
        if continuation_rate > 0.55
            bias += asian_dir * 20 * continuation_rate
        else if continuation_rate < 0.45
            bias += -asian_dir * 20 * (1 - continuation_rate)
    else if sess == SESSION_NEWYORK and array.size(london_direction) > 0
        int london_dir = array.get(london_direction, array.size(london_direction) - 1)
        float continuation_rate = array.size(ny_followed_london) > 2 ? (array.sum(ny_followed_london) / array.size(ny_followed_london)) : 0.5
        if continuation_rate > 0.55
            bias += london_dir * 20 * continuation_rate
        else if continuation_rate < 0.45
            bias += -london_dir * 20 * (1 - continuation_rate)
    
    // Position vs PDC influence
    if not na(prev_day_close)
        if open > prev_day_close
            bias += 15
        else if open < prev_day_close
            bias -= 15
    
    bias

// Calculate projections at session start
if i_range_proj_enabled and asian_start()
    float avg_rng = array.size(asian_ranges) > 2 ? array.avg(asian_ranges) : na
    float init_bias = get_initial_projection_bias(SESSION_ASIAN)
    [p_high, p_low, p_conf] = calc_session_range_projection(open, avg_rng, current_regime, adr_used_pct, adr_value, init_bias)
    srp_high := p_high
    srp_low := p_low
    srp_mid := open
    srp_session := SESSION_ASIAN
    srp_confidence := p_conf
    srp_high_hit := false
    srp_low_hit := false

if i_range_proj_enabled and london_start()
    float avg_rng = array.size(london_ranges) > 2 ? array.avg(london_ranges) : na
    float init_bias = get_initial_projection_bias(SESSION_LONDON)
    [p_high, p_low, p_conf] = calc_session_range_projection(open, avg_rng, current_regime, adr_used_pct, adr_value, init_bias)
    srp_high := p_high
    srp_low := p_low
    srp_mid := open
    srp_session := SESSION_LONDON
    srp_confidence := p_conf
    srp_high_hit := false
    srp_low_hit := false

if i_range_proj_enabled and ny_start()
    float avg_rng = array.size(ny_ranges) > 2 ? array.avg(ny_ranges) : na
    float init_bias = get_initial_projection_bias(SESSION_NEWYORK)
    [p_high, p_low, p_conf] = calc_session_range_projection(open, avg_rng, current_regime, adr_used_pct, adr_value, init_bias)
    srp_high := p_high
    srp_low := p_low
    srp_mid := open
    srp_session := SESSION_NEWYORK
    srp_confidence := p_conf
    srp_high_hit := false
    srp_low_hit := false

// Track projection target hits during session
if i_range_proj_enabled and get_session() != SESSION_NONE and get_session() == srp_session
    if not srp_high_hit and not na(srp_high) and high >= srp_high
        srp_high_hit := true
    if not srp_low_hit and not na(srp_low) and low <= srp_low
        srp_low_hit := true

// Clear projections when session ends
if i_range_proj_enabled
    if asian_end() and srp_session == SESSION_ASIAN
        srp_session := SESSION_NONE
    if london_end() and srp_session == SESSION_LONDON
        srp_session := SESSION_NONE
    if ny_end() and srp_session == SESSION_NEWYORK
        srp_session := SESSION_NONE
// How "clean" the move is: (Close - Open) / (High - Low)
// 1.0 = Perfect trend, 0.0 = Pure chop
// ══════════════════════════════════════════════════════════════════════════════

calc_efficiency(float sess_open, float sess_high, float sess_low, float sess_close) =>
    if na(sess_open) or na(sess_high) or na(sess_low) or na(sess_close)
        na
    else
        float range_val = sess_high - sess_low
        if range_val == 0
            na
        else
            math.abs(sess_close - sess_open) / range_val

// ══════════════════════════════════════════════════════════════════════════════
// SESSION STATISTICS UPDATE
// ══════════════════════════════════════════════════════════════════════════════

// When Asian ends (collect stats for analytics and/or range projections)
if (i_stats_enabled or i_range_proj_enabled) and asian_end() and not na(asian_high) and not na(asian_low)
    float asian_range = asian_high - asian_low
    if array.size(asian_ranges) >= i_stats_lookback
        array.shift(asian_ranges)
    array.push(asian_ranges, asian_range)

    float eff = calc_efficiency(asian_open, asian_high, asian_low, close[1])
    if not na(eff)
        if array.size(asian_efficiency) >= i_stats_lookback
            array.shift(asian_efficiency)
        array.push(asian_efficiency, eff)

    // Track direction
    int dir = close[1] > asian_open ? 1 : -1
    if array.size(asian_direction) >= i_stats_lookback
        array.shift(asian_direction)
    array.push(asian_direction, dir)

// When London ends (collect stats for analytics and/or range projections)
if (i_stats_enabled or i_range_proj_enabled) and london_end() and not na(london_high) and not na(london_low)
    float london_range = london_high - london_low
    if array.size(london_ranges) >= i_stats_lookback
        array.shift(london_ranges)
    array.push(london_ranges, london_range)

    float eff = calc_efficiency(london_open, london_high, london_low, close[1])
    if not na(eff)
        if array.size(london_efficiency) >= i_stats_lookback
            array.shift(london_efficiency)
        array.push(london_efficiency, eff)

    // Track direction and if it followed Asian
    int dir = close[1] > london_open ? 1 : -1
    if array.size(london_direction) >= i_stats_lookback
        array.shift(london_direction)
    array.push(london_direction, dir)

    // Did London follow Asian direction?
    if array.size(asian_direction) > 0
        int asian_dir = array.get(asian_direction, array.size(asian_direction) - 1)
        int followed = dir == asian_dir ? 1 : 0
        if array.size(london_followed_asian) >= i_stats_lookback
            array.shift(london_followed_asian)
        array.push(london_followed_asian, followed)

// When NY ends (collect stats for analytics and/or range projections)
if (i_stats_enabled or i_range_proj_enabled) and ny_end() and not na(ny_high) and not na(ny_low)
    float ny_range = ny_high - ny_low
    if array.size(ny_ranges) >= i_stats_lookback
        array.shift(ny_ranges)
    array.push(ny_ranges, ny_range)

    float eff = calc_efficiency(ny_open, ny_high, ny_low, close[1])
    if not na(eff)
        if array.size(ny_efficiency) >= i_stats_lookback
            array.shift(ny_efficiency)
        array.push(ny_efficiency, eff)

    // Track direction and if it followed London
    int dir = close[1] > ny_open ? 1 : -1
    if array.size(ny_direction) >= i_stats_lookback
        array.shift(ny_direction)
    array.push(ny_direction, dir)

    if array.size(london_direction) > 0
        int london_dir = array.get(london_direction, array.size(london_direction) - 1)
        int followed = dir == london_dir ? 1 : 0
        if array.size(ny_followed_london) >= i_stats_lookback
            array.shift(ny_followed_london)
        array.push(ny_followed_london, followed)

// ══════════════════════════════════════════════════════════════════════════════
// SESSION DNA COLLECTION
// ══════════════════════════════════════════════════════════════════════════════

// Collect Asian DNA when session ends
if i_dna_enabled and asian_end() and not na(asian_high) and not na(asian_low)
    float asian_range = asian_high - asian_low
    float range_pct = calc_range_percentile(asian_range, asian_ranges)
    float eff = calc_efficiency(asian_open, asian_high, asian_low, close[1]) * 100
    int time_high = get_time_phase(asian_high_bar, asian_start_bar, bar_index)
    int time_low = get_time_phase(asian_low_bar, asian_start_bar, bar_index)
    float close_pos = calc_close_position(close[1], asian_high, asian_low)
    int dir = close[1] > asian_open ? 1 : -1

    // Store DNA as single UDT entry
    trim_dna_array(asian_dna, 50)
    SessionDNA new_dna = SessionDNA.new(range_pct, nz(eff, 50), time_high, time_low, close_pos, dir, 0)
    array.push(asian_dna, new_dna)

// Collect London DNA when session ends
if i_dna_enabled and london_end() and not na(london_high) and not na(london_low)
    float london_range = london_high - london_low
    float range_pct = calc_range_percentile(london_range, london_ranges)
    float eff = calc_efficiency(london_open, london_high, london_low, close[1]) * 100
    int time_high = get_time_phase(london_high_bar, london_start_bar, bar_index)
    int time_low = get_time_phase(london_low_bar, london_start_bar, bar_index)
    float close_pos = calc_close_position(close[1], london_high, london_low)
    int dir = close[1] > london_open ? 1 : -1

    // Update previous Asian DNA's next_dir
    update_previous_next_dir(asian_dna, dir)

    // Store DNA as single UDT entry
    trim_dna_array(london_dna, 50)
    SessionDNA new_dna = SessionDNA.new(range_pct, nz(eff, 50), time_high, time_low, close_pos, dir, 0)
    array.push(london_dna, new_dna)

// Collect NY DNA when session ends
if i_dna_enabled and ny_end() and not na(ny_high) and not na(ny_low)
    float ny_range = ny_high - ny_low
    float range_pct = calc_range_percentile(ny_range, ny_ranges)
    float eff = calc_efficiency(ny_open, ny_high, ny_low, close[1]) * 100
    int time_high = get_time_phase(ny_high_bar, ny_start_bar, bar_index)
    int time_low = get_time_phase(ny_low_bar, ny_start_bar, bar_index)
    float close_pos = calc_close_position(close[1], ny_high, ny_low)
    int dir = close[1] > ny_open ? 1 : -1

    // Update previous London DNA's next_dir
    update_previous_next_dir(london_dna, dir)

    // Store DNA as single UDT entry
    trim_dna_array(ny_dna, 50)
    SessionDNA new_dna = SessionDNA.new(range_pct, nz(eff, 50), time_high, time_low, close_pos, dir, 0)
    array.push(ny_dna, new_dna)

// ══════════════════════════════════════════════════════════════════════════════
// KILLZONE EFFECTIVENESS DATA COLLECTION
// ══════════════════════════════════════════════════════════════════════════════

// Detect KZ transitions and track performance
int live_kz = get_killzone()
bool kz_just_started = live_kz != KZ_NONE and live_kz != KZ_ASIAN and (live_kz != live_kz[1] or na(live_kz[1]))
bool kz_just_ended = live_kz == KZ_NONE and live_kz[1] != KZ_NONE and live_kz[1] != KZ_ASIAN

// Track KZ entry when starting (exclude Asian KZ - less tradeable)
if i_kz_effectiveness and kz_just_started
    current_kz_type := live_kz
    kz_entry_price := close
    kz_high := high
    kz_low := low
    kz_start_bar := bar_index

// Update KZ high/low during active KZ
if i_kz_effectiveness and live_kz != KZ_NONE and live_kz != KZ_ASIAN and not na(kz_entry_price)
    kz_high := math.max(nz(kz_high, high), high)
    kz_low := math.min(nz(kz_low, low), low)

// Collect data when KZ ends
if i_kz_effectiveness and kz_just_ended and not na(kz_entry_price) and current_kz_type != KZ_NONE and current_kz_type != KZ_ASIAN
    // Calculate KZ performance
    float kz_range = kz_high - kz_low
    float kz_move_pct = not na(adr_value) and adr_value > 0 ? (kz_range / adr_value) * 100 : 0

    // Determine if reversal occurred (price moved significantly from entry)
    float entry_to_close = close - kz_entry_price
    float kz_mid = (kz_high + kz_low) / 2
    bool formed_high_first = kz_high == high[bar_index - kz_start_bar] ? false : true  // Simplified check

    // Result: 1 = good reversal move, 0 = no significant move, -1 = failed
    int kz_result = 0
    if kz_move_pct >= 15  // At least 15% of ADR moved
        // Check if there was a tradeable reversal pattern
        if (kz_entry_price > kz_mid and close < kz_entry_price) or (kz_entry_price < kz_mid and close > kz_entry_price)
            kz_result := 1  // Good reversal
        else if math.abs(entry_to_close) > kz_range * 0.3
            kz_result := 1  // Good continuation move
        else
            kz_result := -1  // Move happened but not tradeable from entry

    // Store in appropriate arrays
    switch current_kz_type
        KZ_LONDON_OPEN =>
            trim_kz_arrays(kz_london_results, kz_london_moves, i_kz_score_lookback)
            array.push(kz_london_results, kz_result)
            array.push(kz_london_moves, kz_move_pct)
        KZ_NY_AM =>
            trim_kz_arrays(kz_ny_am_results, kz_ny_am_moves, i_kz_score_lookback)
            array.push(kz_ny_am_results, kz_result)
            array.push(kz_ny_am_moves, kz_move_pct)
        KZ_LONDON_CLOSE =>
            trim_kz_arrays(kz_london_close_results, kz_london_close_moves, i_kz_score_lookback)
            array.push(kz_london_close_results, kz_result)
            array.push(kz_london_close_moves, kz_move_pct)
        KZ_SILVER_AM =>
            trim_kz_arrays(kz_silver_am_results, kz_silver_am_moves, i_kz_score_lookback)
            array.push(kz_silver_am_results, kz_result)
            array.push(kz_silver_am_moves, kz_move_pct)
        KZ_SILVER_PM =>
            trim_kz_arrays(kz_silver_pm_results, kz_silver_pm_moves, i_kz_score_lookback)
            array.push(kz_silver_pm_results, kz_result)
            array.push(kz_silver_pm_moves, kz_move_pct)

    // Reset tracking vars
    kz_entry_price := na
    kz_high := na
    kz_low := na
    current_kz_type := 0

// ══════════════════════════════════════════════════════════════════════════════
// STATISTICS CALCULATIONS
// ══════════════════════════════════════════════════════════════════════════════

// Average ranges
avg_asian_range = array.size(asian_ranges) > 0 ? array.avg(asian_ranges) : na
avg_london_range = array.size(london_ranges) > 0 ? array.avg(london_ranges) : na
avg_ny_range = array.size(ny_ranges) > 0 ? array.avg(ny_ranges) : na

// Average efficiency
avg_asian_eff = array.size(asian_efficiency) > 0 ? array.avg(asian_efficiency) * 100 : na
avg_london_eff = array.size(london_efficiency) > 0 ? array.avg(london_efficiency) * 100 : na
avg_ny_eff = array.size(ny_efficiency) > 0 ? array.avg(ny_efficiency) * 100 : na

// Current session range
current_range() =>
    int sess = get_session()
    switch sess
        SESSION_ASIAN => not na(asian_high) and not na(asian_low) ? asian_high - asian_low : na
        SESSION_LONDON => not na(london_high) and not na(london_low) ? london_high - london_low : na
        SESSION_NEWYORK => not na(ny_high) and not na(ny_low) ? ny_high - ny_low : na
        SESSION_OVERLAP => not na(ny_high) and not na(ny_low) ? ny_high - ny_low : na
        => na

current_avg_range() =>
    int sess = get_session()
    switch sess
        SESSION_ASIAN => avg_asian_range
        SESSION_LONDON => avg_london_range
        SESSION_NEWYORK => avg_ny_range
        SESSION_OVERLAP => avg_ny_range
        => na

float curr_range = current_range()
float curr_avg = current_avg_range()
float range_vs_avg = not na(curr_range) and not na(curr_avg) and curr_avg > 0 ? ((curr_range - curr_avg) / curr_avg) * 100 : na

// Inter-session flow probabilities
float london_continuation_pct = array.size(london_followed_asian) > 2 ? (array.sum(london_followed_asian) / array.size(london_followed_asian)) * 100 : na
float ny_continuation_pct = array.size(ny_followed_london) > 2 ? (array.sum(ny_followed_london) / array.size(ny_followed_london)) * 100 : na

// ══════════════════════════════════════════════════════════════════════════════
// SESSION SCORE & WIN RATE
// Composite energy score (0-100) and historical win rate per session
// ══════════════════════════════════════════════════════════════════════════════

// Win rate tracking arrays (1 = tradeable move, 0 = no tradeable move)
var int[] asian_wins = array.new_int(0)
var int[] london_wins = array.new_int(0)
var int[] ny_wins = array.new_int(0)

// Collect win/loss at session end (tradeable = range > 50% avg AND efficiency > 0.4)
if (i_score_enabled or i_stats_enabled) and asian_end() and not na(asian_high) and not na(asian_low)
    float rng = asian_high - asian_low
    float eff = calc_efficiency(asian_open, asian_high, asian_low, close[1])
    bool tradeable = not na(avg_asian_range) and avg_asian_range > 0 ? (rng > avg_asian_range * 0.5 and nz(eff, 0) > 0.4) : false
    if array.size(asian_wins) >= i_stats_lookback
        array.shift(asian_wins)
    array.push(asian_wins, tradeable ? 1 : 0)

if (i_score_enabled or i_stats_enabled) and london_end() and not na(london_high) and not na(london_low)
    float rng = london_high - london_low
    float eff = calc_efficiency(london_open, london_high, london_low, close[1])
    bool tradeable = not na(avg_london_range) and avg_london_range > 0 ? (rng > avg_london_range * 0.5 and nz(eff, 0) > 0.4) : false
    if array.size(london_wins) >= i_stats_lookback
        array.shift(london_wins)
    array.push(london_wins, tradeable ? 1 : 0)

if (i_score_enabled or i_stats_enabled) and ny_end() and not na(ny_high) and not na(ny_low)
    float rng = ny_high - ny_low
    float eff = calc_efficiency(ny_open, ny_high, ny_low, close[1])
    bool tradeable = not na(avg_ny_range) and avg_ny_range > 0 ? (rng > avg_ny_range * 0.5 and nz(eff, 0) > 0.4) : false
    if array.size(ny_wins) >= i_stats_lookback
        array.shift(ny_wins)
    array.push(ny_wins, tradeable ? 1 : 0)

// Calculate win rates
float asian_win_rate = array.size(asian_wins) > 3 ? (array.sum(asian_wins) / array.size(asian_wins)) * 100 : na
float london_win_rate = array.size(london_wins) > 3 ? (array.sum(london_wins) / array.size(london_wins)) * 100 : na
float ny_win_rate = array.size(ny_wins) > 3 ? (array.sum(ny_wins) / array.size(ny_wins)) * 100 : na

// Calculate live session score (0-100)
// Combines: range vs avg (40%), efficiency (30%), volatility ratio (30%)
calc_session_score() =>
    int sess = get_session()
    if sess == SESSION_NONE or not i_score_enabled
        na
    else
        float range_score = not na(range_vs_avg) ? math.min(40, math.max(0, (range_vs_avg + 50) * 0.4)) : 20
        float eff_val = switch sess
            SESSION_ASIAN => avg_asian_eff
            SESSION_LONDON => avg_london_eff
            SESSION_NEWYORK => avg_ny_eff
            SESSION_OVERLAP => avg_ny_eff
            => na
        float eff_score = not na(eff_val) ? math.min(30, eff_val * 0.3) : 15
        float vol_score = not na(regime_volatility_ratio) ? math.min(30, regime_volatility_ratio * 15) : 15
        math.min(100, range_score + eff_score + vol_score)

float session_score = calc_session_score()

// Get current session win rate
float current_win_rate = switch get_session()
    SESSION_ASIAN => asian_win_rate
    SESSION_LONDON => london_win_rate
    SESSION_NEWYORK => ny_win_rate
    SESSION_OVERLAP => ny_win_rate
    => na

// ══════════════════════════════════════════════════════════════════════════════
// SESSION DNA — LIVE SESSION PREDICTOR
// Real-time intelligence: "Where is THIS session heading?"
// Uses current session metrics (not historical matching) to predict outcome
// ══════════════════════════════════════════════════════════════════════════════

calc_live_dna() =>
    int sess = get_session()
    if sess == SESSION_NONE or not i_dna_enabled
        [na, na, "No Active Session"]
    else
        // Get current session data
        float sess_open_val = switch sess
            SESSION_ASIAN => asian_open
            SESSION_LONDON => london_open
            SESSION_NEWYORK => ny_open
            SESSION_OVERLAP => ny_open
            => na

        float sess_high_val = switch sess
            SESSION_ASIAN => asian_high
            SESSION_LONDON => london_high
            SESSION_NEWYORK => ny_high
            SESSION_OVERLAP => ny_high
            => na

        float sess_low_val = switch sess
            SESSION_ASIAN => asian_low
            SESSION_LONDON => london_low
            SESSION_NEWYORK => ny_low
            SESSION_OVERLAP => ny_low
            => na

        if na(sess_open_val) or na(sess_high_val) or na(sess_low_val) or sess_high_val == sess_low_val
            [na, na, "Calculating..."]
        else
            float sess_range = sess_high_val - sess_low_val

            // Factor 1: Position in range (0 = at low, 100 = at high)
            float range_pos = ((close - sess_low_val) / sess_range) * 100

            // Factor 2: Direction from open
            float move_from_open = close - sess_open_val
            float dir_score = sess_range > 0 ? (move_from_open / sess_range) * 100 : 0

            // Factor 3: Momentum — are recent bars pushing in one direction?
            float recent_momentum = 0.0
            int mom_bars = math.min(4, bar_index)
            if mom_bars > 0
                for i = 0 to mom_bars - 1
                    recent_momentum += (close[i] - open[i])
            float momentum_score = sess_range > 0 ? (recent_momentum / sess_range) * 100 : 0

            // Factor 4: Close vs VWAP (if available) — institutional bias
            float vwap_score = 0.0
            if not na(vwap_sum) and not na(vwap_vol_sum) and vwap_vol_sum > 0
                float curr_vwap = vwap_sum / vwap_vol_sum
                vwap_score := sess_range > 0 ? ((close - curr_vwap) / sess_range) * 50 : 0

            // Factor 5: Efficiency — how clean is the move?
            float eff = calc_efficiency(sess_open_val, sess_high_val, sess_low_val, close)
            float eff_bonus = nz(eff, 0.5) > 0.5 ? (dir_score > 0 ? 10 : -10) : 0

            // Composite score: -100 (max bearish) to +100 (max bullish)
            // Weights: range position 25%, direction 30%, momentum 25%, VWAP 10%, efficiency 10%
            float composite = (range_pos - 50) * 0.5 + dir_score * 0.3 + momentum_score * 0.25 + vwap_score * 0.1 + eff_bonus

            // Convert to bull probability (0-100)
            float bull_prob = math.max(0, math.min(100, 50 + composite))

            // Confidence based on session maturity (more data = higher confidence)
            int sess_start = switch sess
                SESSION_ASIAN => asian_start_bar
                SESSION_LONDON => london_start_bar
                SESSION_NEWYORK => ny_start_bar
                SESSION_OVERLAP => ny_start_bar
                => na
            float maturity = not na(sess_start) and bar_index > sess_start ? math.min(100, ((bar_index - sess_start) / 16.0) * 100) : 20
            float confidence = math.max(20, maturity)

            // Generate read
            string read = bull_prob >= 65 ? "Bullish" : bull_prob <= 35 ? "Bearish" : "Neutral"
            read := read + " (" + str.tostring(confidence, "#") + "%)"

            [confidence, bull_prob, read]

// Execute live DNA analysis
[dna_match_result, dna_bull_result, dna_pattern_result] = calc_live_dna()
dna_match_pct := dna_match_result
dna_bull_prob := dna_bull_result
dna_pattern_name := dna_pattern_result

// ─────────────────────────────────────────────────────────────────────────────
// ─────────────────────────────────────────────────────────────────────────────
// ─────────────────────────────────────────────────────────────────────────────
// ─────────────────────────────────────────────────────────────────────────────
// ─────────────────────────────────────────────────────────────────────────────
// DNA — LIVE NARRATIVE BOX PER SESSION
// Single box below each session that builds a running story.
// Starts with current read, appends when direction changes.
// E.g. "Bull" → "Bull - Bear" → "Bull - Bear - Neutral"
// Previous session DNA shows last 5 sessions when toggled on.
// ─────────────────────────────────────────────────────────────────────────────

// VWAP-based DNA read
calc_vwap_dna() =>
    if not na(vwap_sum) and not na(vwap_vol_sum) and vwap_vol_sum > 0
        float curr_vwap = vwap_sum / vwap_vol_sum
        float dist = (close - curr_vwap) / nz(atr_14, close * 0.001)
        dist > 0.3 ? 80.0 : dist < -0.3 ? 20.0 : 50.0
    else
        close > open ? 65.0 : close < open ? 35.0 : 50.0

bool dna_tf_ok = _tf_mins < 60

// DNA state tracking per session
var string dna_asian_story = ""
var string dna_london_story = ""
var string dna_ny_story = ""
var string dna_asian_last = ""
var string dna_london_last = ""
var string dna_ny_last = ""
// Confirmation counters — new read must hold 5 bars before appending
var string dna_asian_pending = ""
var string dna_london_pending = ""
var string dna_ny_pending = ""
var int dna_asian_hold = 0
var int dna_london_hold = 0
var int dna_ny_hold = 0
var int dna_asian_count = 0
var int dna_london_count = 0
var int dna_ny_count = 0
int DNA_CONFIRM_BARS = 5
int DNA_MAX_ENTRIES = 4

// DNA display objects
var box dna_asian_box = na
var label dna_asian_lbl = na
var box dna_london_box = na
var label dna_london_lbl = na
var box dna_ny_box = na
var label dna_ny_lbl = na

// Reset story at session start
if asian_start()
    dna_asian_story := ""
    dna_asian_last := ""
    dna_asian_pending := ""
    dna_asian_hold := 0
    dna_asian_count := 0
if london_start()
    dna_london_story := ""
    dna_london_last := ""
    dna_london_pending := ""
    dna_london_hold := 0
    dna_london_count := 0
if ny_start()
    dna_ny_story := ""
    dna_ny_last := ""
    dna_ny_pending := ""
    dna_ny_hold := 0
    dna_ny_count := 0

// Get current DNA word
dna_word(float prob) =>
    prob >= 60 ? "Bull" : prob <= 40 ? "Bear" : "Neutral"

dna_color_from_word(string word) =>
    word == "Bull" ? COLOR_BULL : word == "Bear" ? COLOR_BEAR : COLOR_NEUT

// Update story with confirmation: new read must hold N bars before appending
update_dna_story(string story, string last_read, string new_read, string pending, int hold_count, int entry_count) =>
    if new_read == last_read or new_read == "" or entry_count >= DNA_MAX_ENTRIES
        // Same as current or max reached — reset pending
        ["", 0, story, last_read]
    else if new_read == pending
        // Same as pending — increment hold
        int new_hold = hold_count + 1
        if new_hold >= DNA_CONFIRM_BARS
            // Confirmed! Append to story
            string new_story = story == "" ? new_read : story + " - " + new_read
            ["", 0, new_story, new_read]
        else
            [pending, new_hold, story, last_read]
    else
        // New direction starting — reset pending counter
        [new_read, 1, story, last_read]

// Draw DNA narrative box below session
draw_dna_narrative(box bx, label lbl, int sess_start, int sess_end, float box_bottom, string story, string current_word) =>
    box.delete(bx)
    label.delete(lbl)
    if story != ""
        float panel_h = nz(atr_14, box_bottom * 0.001) * 0.5
        float panel_top = box_bottom - (nz(atr_14, box_bottom * 0.001) * 0.3)
        float panel_bot = panel_top - panel_h
        int mid_x = sess_start + (sess_end - sess_start) / 2
        color last_col = dna_color_from_word(current_word)
        box new_box = box.new(sess_start, panel_top, sess_end, panel_bot, border_color=color.new(last_col, 50), bgcolor=color.new(#1a1a2e, 30), border_width=1)
        label new_lbl = label.new(mid_x, (panel_top + panel_bot) / 2, story, style=label.style_label_center, color=color.new(#000000, 100), textcolor=color.new(last_col, 0), size=get_label_size(i_label_size), tooltip="Session DNA — Live narrative\nTrack: " + story + "\nBased on price vs VWAP. Updates when direction changes.")
        [new_box, new_lbl]
    else
        [box(na), label(na)]

// ── UPDATE DNA STORIES ──
if i_dna_enabled and dna_tf_ok
    float dna_prob = calc_vwap_dna()
    string dna_now = dna_word(dna_prob)

    // Asian
    if in_asian()
        [p, h, s, l] = update_dna_story(dna_asian_story, dna_asian_last, dna_now, dna_asian_pending, dna_asian_hold, dna_asian_count)
        dna_asian_pending := p
        dna_asian_hold := h
        dna_asian_story := s
        if l != dna_asian_last
            dna_asian_count += 1
        dna_asian_last := l

    // London
    if in_london()
        [p, h, s, l] = update_dna_story(dna_london_story, dna_london_last, dna_now, dna_london_pending, dna_london_hold, dna_london_count)
        dna_london_pending := p
        dna_london_hold := h
        dna_london_story := s
        if l != dna_london_last
            dna_london_count += 1
        dna_london_last := l

    // NY
    if in_ny()
        [p, h, s, l] = update_dna_story(dna_ny_story, dna_ny_last, dna_now, dna_ny_pending, dna_ny_hold, dna_ny_count)
        dna_ny_pending := p
        dna_ny_hold := h
        dna_ny_story := s
        if l != dna_ny_last
            dna_ny_count += 1
        dna_ny_last := l

// ── DRAW DNA NARRATIVE BOXES ──
// Current sessions always draw, previous sessions only with toggle

// Asian
if i_dna_enabled and dna_tf_ok and i_asian_enabled and in_asian()
    int asn_right = bar_index
    [b, l] = draw_dna_narrative(dna_asian_box, dna_asian_lbl, nz(asian_start_bar, bar_index), asn_right, nz(asian_low, low), dna_asian_story, dna_asian_last)
    dna_asian_box := b
    dna_asian_lbl := l
else if not in_asian() and not i_dna_show_history
    box.delete(dna_asian_box)
    label.delete(dna_asian_lbl)

// London
if i_dna_enabled and dna_tf_ok and i_london_enabled and in_london()
    int ldn_right = bar_index
    [b, l] = draw_dna_narrative(dna_london_box, dna_london_lbl, nz(london_start_bar, bar_index), ldn_right, nz(london_low, low), dna_london_story, dna_london_last)
    dna_london_box := b
    dna_london_lbl := l
else if not in_london() and not i_dna_show_history
    box.delete(dna_london_box)
    label.delete(dna_london_lbl)

// NY
if i_dna_enabled and dna_tf_ok and i_ny_enabled and in_ny()
    int ny_right = bar_index
    [b, l] = draw_dna_narrative(dna_ny_box, dna_ny_lbl, nz(ny_start_bar, bar_index), ny_right, nz(ny_low, low), dna_ny_story, dna_ny_last)
    dna_ny_box := b
    dna_ny_lbl := l
else if not in_ny() and not i_dna_show_history
    box.delete(dna_ny_box)
    label.delete(dna_ny_lbl)

// ══════════════════════════════════════════════════════════════════════════════
// KILLZONE EFFECTIVENESS LIVE ANALYSIS
// ══════════════════════════════════════════════════════════════════════════════

// Calculate effectiveness for ALL killzones (for dashboard summary)
if i_kz_effectiveness
    // London Open
    [ldn_score, ldn_rev, ldn_mv] = calc_kz_effectiveness(kz_london_results, kz_london_moves)
    kz_score_london := ldn_score
    kz_grade_london := get_kz_grade(ldn_score)

    // NY AM
    [ny_score, ny_rev, ny_mv] = calc_kz_effectiveness(kz_ny_am_results, kz_ny_am_moves)
    kz_score_ny := ny_score
    kz_grade_ny := get_kz_grade(ny_score)

    // London Close
    [lc_score, lc_rev, lc_mv] = calc_kz_effectiveness(kz_london_close_results, kz_london_close_moves)
    kz_score_lc := lc_score
    kz_grade_lc := get_kz_grade(lc_score)

    // Silver Bullet AM
    [sbam_score, sbam_rev, sbam_mv] = calc_kz_effectiveness(kz_silver_am_results, kz_silver_am_moves)
    kz_score_sb_am := sbam_score
    kz_grade_sb_am := get_kz_grade(sbam_score)

    // Silver Bullet PM
    [sbpm_score, sbpm_rev, sbpm_mv] = calc_kz_effectiveness(kz_silver_pm_results, kz_silver_pm_moves)
    kz_score_sb_pm := sbpm_score
    kz_grade_sb_pm := get_kz_grade(sbpm_score)

    // Set current KZ stats (for alerts and detailed view)
    bool kz_calc_active = live_kz != KZ_NONE and live_kz != KZ_ASIAN
    if kz_calc_active
        kz_current_score := switch live_kz
            KZ_LONDON_OPEN => kz_score_london
            KZ_NY_AM => kz_score_ny
            KZ_LONDON_CLOSE => kz_score_lc
            KZ_SILVER_AM => kz_score_sb_am
            KZ_SILVER_PM => kz_score_sb_pm
            => na
        kz_current_grade := switch live_kz
            KZ_LONDON_OPEN => kz_grade_london
            KZ_NY_AM => kz_grade_ny
            KZ_LONDON_CLOSE => kz_grade_lc
            KZ_SILVER_AM => kz_grade_sb_am
            KZ_SILVER_PM => kz_grade_sb_pm
            => na

// KZ Grade Labels on Chart (show grade when killzone starts)
if i_kz_effectiveness and kz_just_started and not na(kz_current_grade) and not na(kz_current_score)
    string kz_label_text = get_kz_name(live_kz) + " " + kz_current_grade
    color kz_lbl_col = get_kz_grade_color(kz_current_score)
    string kz_grade_tip = get_kz_name(live_kz) + " Effectiveness: " + kz_current_grade + " (" + str.tostring(kz_current_score, "#") + "%)\nBased on last " + str.tostring(i_kz_score_lookback) + " entries.\nA+/A = High probability setup\nB = Decent, proceed with caution\nC/D = Low reliability — consider skipping"
    label.new(bar_index, low - (nz(atr_14, low * 0.001) * 0.5), kz_label_text, style=label.style_label_up, color=color.new(kz_lbl_col, 20), textcolor=color.white, size=get_label_size(i_label_size), tooltip=kz_grade_tip)

// ══════════════════════════════════════════════════════════════════════════════
// SESSION ANOMALY DETECTION
// Real-time detection of unusual session behavior
// ══════════════════════════════════════════════════════════════════════════════

// Get anomaly detection threshold based on sensitivity
float anomaly_threshold = get_anomaly_z_threshold()

// Get current session data for anomaly detection
int anomaly_sess = get_session()
float anomaly_sess_high = switch anomaly_sess
    SESSION_ASIAN => asian_high
    SESSION_LONDON => london_high
    SESSION_NEWYORK => ny_high
    SESSION_OVERLAP => ny_high
    => na

float anomaly_sess_low = switch anomaly_sess
    SESSION_ASIAN => asian_low
    SESSION_LONDON => london_low
    SESSION_NEWYORK => ny_low
    SESSION_OVERLAP => ny_low
    => na

float anomaly_sess_open = switch anomaly_sess
    SESSION_ASIAN => asian_open
    SESSION_LONDON => london_open
    SESSION_NEWYORK => ny_open
    SESSION_OVERLAP => ny_open
    => na

int anomaly_sess_start = switch anomaly_sess
    SESSION_ASIAN => asian_start_bar
    SESSION_LONDON => london_start_bar
    SESSION_NEWYORK => ny_start_bar
    SESSION_OVERLAP => ny_start_bar
    => na

// Get historical range data for the current session type
float[] anomaly_range_hist = switch anomaly_sess
    SESSION_ASIAN => asian_ranges
    SESSION_LONDON => london_ranges
    SESSION_NEWYORK => ny_ranges
    SESSION_OVERLAP => ny_ranges
    => array.new_float(0)

// Calculate current session range
float anomaly_current_range = not na(anomaly_sess_high) and not na(anomaly_sess_low) ? anomaly_sess_high - anomaly_sess_low : na

// Calculate session progress (0.0 to 1.0)
float anomaly_tf_minutes = timeframe.in_seconds() / 60
float anomaly_est_bars = (8 * 60) / anomaly_tf_minutes  // Estimated 8-hour session
float anomaly_session_progress = not na(anomaly_sess_start) ? math.min(1.0, (bar_index - anomaly_sess_start) / anomaly_est_bars) : 0

// Get previous session close for gap calculation
float prev_session_close = switch anomaly_sess
    SESSION_LONDON => not na(asian_high) ? (asian_high + asian_low) / 2 : na  // Use Asian midpoint
    SESSION_NEWYORK => not na(london_high) ? (london_high + london_low) / 2 : na
    SESSION_OVERLAP => not na(london_high) ? (london_high + london_low) / 2 : na
    => na

// Calculate gap from previous session
float anomaly_gap_size = not na(anomaly_sess_open) and not na(prev_session_close) ? anomaly_sess_open - prev_session_close : na

// Get current direction
int anomaly_current_dir = not na(anomaly_sess_open) ? (close > anomaly_sess_open ? 1 : -1) : 0

// Get previous session direction
int anomaly_prev_dir = switch anomaly_sess
    SESSION_LONDON => array.size(asian_direction) > 0 ? array.get(asian_direction, array.size(asian_direction) - 1) : 0
    SESSION_NEWYORK => array.size(london_direction) > 0 ? array.get(london_direction, array.size(london_direction) - 1) : 0
    SESSION_OVERLAP => array.size(london_direction) > 0 ? array.get(london_direction, array.size(london_direction) - 1) : 0
    => 0

// Get flow continuation percentage
float anomaly_flow_pct = switch anomaly_sess
    SESSION_LONDON => london_continuation_pct
    SESSION_NEWYORK => ny_continuation_pct
    SESSION_OVERLAP => ny_continuation_pct
    => na

// ─────────────────────────────────────────────────────────────────────────────
// RUN ANOMALY DETECTION (only when enabled and in active session)
// ─────────────────────────────────────────────────────────────────────────────

if i_anomaly_enabled and anomaly_sess != SESSION_NONE
    // Reset anomaly flags
    anomaly_range := false
    anomaly_volatility := false
    anomaly_timing := false
    anomaly_gap := false
    anomaly_flow := false
    anomaly_adr := false
    anomaly_count := 0
    anomaly_severity := 0.0

    // 1. Range Anomaly Detection
    [range_is_anomaly, range_score, range_z] = detect_range_anomaly(anomaly_current_range, anomaly_range_hist, anomaly_threshold)
    if range_is_anomaly
        anomaly_range := true
        anomaly_range_score := range_score
        anomaly_count += 1
        session_range_z_score := range_z
    else
        anomaly_range_score := 0.0

    // 2. Volatility Anomaly Detection
    [vol_is_anomaly, vol_score, vol_ratio] = detect_volatility_anomaly(rolling_vol_fast, rolling_vol_slow, anomaly_threshold)
    if vol_is_anomaly
        anomaly_volatility := true
        anomaly_volatility_score := vol_score
        anomaly_count += 1
        session_volatility_ratio := vol_ratio
    else
        anomaly_volatility_score := 0.0

    // 3. Timing Anomaly Detection (only after mid-session)
    if anomaly_session_progress > 0.4
        [timing_is_anomaly, timing_score] = detect_timing_anomaly(session_high_phase, session_low_phase, anomaly_sess)
        if timing_is_anomaly
            anomaly_timing := true
            anomaly_timing_score := timing_score
            anomaly_count += 1
        else
            anomaly_timing_score := 0.0

    // 4. Gap Anomaly Detection (only at session start)
    if anomaly_session_progress < 0.1 and not na(anomaly_gap_size)
        [gap_is_anomaly, gap_score, gap_z] = detect_gap_anomaly(anomaly_gap_size, hist_session_gaps, anomaly_threshold)
        if gap_is_anomaly
            anomaly_gap := true
            anomaly_gap_score := gap_score
            anomaly_count += 1
            session_open_gap := anomaly_gap_size
        else
            anomaly_gap_score := 0.0

    // 5. Flow Anomaly Detection
    [flow_is_anomaly, flow_score] = detect_flow_anomaly(anomaly_current_dir, anomaly_prev_dir, anomaly_flow_pct)
    if flow_is_anomaly
        anomaly_flow := true
        anomaly_flow_score := flow_score
        anomaly_count += 1
    else
        anomaly_flow_score := 0.0

    // 6. ADR Anomaly Detection
    [adr_is_anomaly, adr_score, adr_dev] = detect_adr_anomaly(adr_used_pct, anomaly_session_progress, hist_adr_usage_rate)
    if adr_is_anomaly
        anomaly_adr := true
        anomaly_adr_score := adr_score
        anomaly_count += 1
    else
        anomaly_adr_score := 0.0

    // Calculate overall severity (max of all anomaly scores)
    anomaly_severity := math.max(anomaly_range_score, math.max(anomaly_volatility_score, math.max(anomaly_timing_score, math.max(anomaly_gap_score, math.max(anomaly_flow_score, anomaly_adr_score)))))

    // Determine primary anomaly type (highest score)
    anomaly_primary_type := get_anomaly_type_name(anomaly_range and anomaly_range_score == anomaly_severity, anomaly_volatility and anomaly_volatility_score == anomaly_severity, anomaly_timing and anomaly_timing_score == anomaly_severity, anomaly_gap and anomaly_gap_score == anomaly_severity, anomaly_flow and anomaly_flow_score == anomaly_severity, anomaly_adr and anomaly_adr_score == anomaly_severity)

    // Build description
    if anomaly_count > 0
        anomaly_description := anomaly_primary_type + " (" + str.tostring(anomaly_severity, "#") + "%)"
        if anomaly_count > 1
            anomaly_description := str.tostring(anomaly_count) + " anomalies: " + anomaly_description
    else
        anomaly_description := "Normal"
        anomaly_primary_type := "None"

else if anomaly_sess == SESSION_NONE
    // Reset when outside sessions
    anomaly_count := 0
    anomaly_severity := 0.0
    anomaly_primary_type := "None"
    anomaly_description := "—"
    session_high_phase := 0
    session_low_phase := 0

// ─────────────────────────────────────────────────────────────────────────────
// ANOMALY DATA COLLECTION (for historical tracking)
// ─────────────────────────────────────────────────────────────────────────────

// Store gap data when session starts
if i_anomaly_enabled and (asian_start() or london_start() or ny_start())
    if not na(anomaly_gap_size)
        if array.size(hist_session_gaps) >= 30
            array.shift(hist_session_gaps)
        array.push(hist_session_gaps, math.abs(anomaly_gap_size))

// Store ADR usage rate at session end
if i_anomaly_enabled and (asian_end() or london_end() or ny_end())
    if not na(adr_used_pct)
        if array.size(hist_adr_usage_rate) >= 30
            array.shift(hist_adr_usage_rate)
        array.push(hist_adr_usage_rate, adr_used_pct)

    // Store anomaly count in history
    if array.size(anomaly_history) >= 30
        array.shift(anomaly_history)
    array.push(anomaly_history, anomaly_count)

// ══════════════════════════════════════════════════════════════════════════════
// SESSION VWAP CALCULATION
// ══════════════════════════════════════════════════════════════════════════════

// Determine which session to use for VWAP
bool vwap_session_active = switch i_vwap_session
    "Asian" => in_asian()
    "London" => in_london()
    "New York" => in_ny()
    "Current" => get_session() != SESSION_NONE
    => false

bool vwap_session_start = switch i_vwap_session
    "Asian" => asian_start()
    "London" => london_start()
    "New York" => ny_start()
    "Current" => asian_start() or london_start() or ny_start()
    => false

// Reset VWAP on session start
if vwap_session_start and i_vwap_enabled
    vwap_sum := 0.0
    vwap_vol_sum := 0.0
    vwap_sq_sum := 0.0

// Calculate VWAP
float typical_price = (high + low + close) / 3
float vol = volume

if vwap_session_active and i_vwap_enabled
    vwap_sum := vwap_sum + (typical_price * vol)
    vwap_vol_sum := vwap_vol_sum + vol
    vwap_sq_sum := vwap_sq_sum + (typical_price * typical_price * vol)

float session_vwap = vwap_vol_sum > 0 ? vwap_sum / vwap_vol_sum : na
float vwap_variance = vwap_vol_sum > 0 ? (vwap_sq_sum / vwap_vol_sum) - (session_vwap * session_vwap) : na
float vwap_std = vwap_variance > 0 ? math.sqrt(vwap_variance) : na
float vwap_upper = not na(session_vwap) and not na(vwap_std) ? session_vwap + (vwap_std * i_vwap_band_mult) : na
float vwap_lower = not na(session_vwap) and not na(vwap_std) ? session_vwap - (vwap_std * i_vwap_band_mult) : na

// ══════════════════════════════════════════════════════════════════════════════
// OPENING RANGE CALCULATION
// ══════════════════════════════════════════════════════════════════════════════

or_minutes = switch i_or_period
    "5 min" => 5
    "15 min" => 15
    "30 min" => 30
    "60 min" => 60
    => 30

or_session_active = switch i_or_session
    "Asian" => in_asian()
    "London" => in_london()
    "New York" => in_ny()
    => in_ny()

or_session_start = switch i_or_session
    "Asian" => asian_start()
    "London" => london_start()
    "New York" => ny_start()
    => ny_start()

tf_minutes = timeframe.in_seconds() / 60
or_bars = math.max(1, math.floor(or_minutes / tf_minutes))

if or_session_start and i_or_enabled
    or_high := high
    or_low := low
    or_complete := false
    or_start_bar := bar_index
else if or_session_active and i_or_enabled and not or_complete
    or_high := math.max(nz(or_high, high), high)
    or_low := math.min(nz(or_low, low), low)
    if bar_index - nz(or_start_bar, bar_index) >= or_bars
        or_complete := true

// Pre-calculate crossover/crossunder for consistent execution
bool _or_cross_high = ta.crossover(close, nz(or_high, close))
bool _or_cross_low = ta.crossunder(close, nz(or_low, close))
or_break_high = i_or_enabled and or_complete and _or_cross_high
or_break_low = i_or_enabled and or_complete and _or_cross_low

// ══════════════════════════════════════════════════════════════════════════════
// POWER OF 3 DETECTION
// ══════════════════════════════════════════════════════════════════════════════

// Power of 3 for selected session
po3_session_active = switch i_po3_session
    "Asian" => in_asian()
    "London" => in_london()
    "New York" => in_ny()
    => in_london()

po3_session_start = switch i_po3_session
    "Asian" => asian_start()
    "London" => london_start()
    "New York" => ny_start()
    => london_start()

po3_session_open = switch i_po3_session
    "Asian" => asian_open
    "London" => london_open
    "New York" => ny_open
    => london_open

po3_session_high = switch i_po3_session
    "Asian" => asian_high
    "London" => london_high
    "New York" => ny_high
    => london_high

po3_session_low = switch i_po3_session
    "Asian" => asian_low
    "London" => london_low
    "New York" => ny_low
    => london_low

po3_start_bar = switch i_po3_session
    "Asian" => asian_start_bar
    "London" => london_start_bar
    "New York" => ny_start_bar
    => london_start_bar

if i_po3_enabled and po3_session_start
    po3_phase := PO3_ACCUMULATION
    po3_range_start := close
    po3_manipulation_high := high
    po3_manipulation_low := low
    po3_manip_start_bar := na
    po3_dist_start_bar := na
else if i_po3_enabled and po3_session_active and not na(po3_start_bar)
    int bars_in_session = bar_index - po3_start_bar
    float session_third = math.max(1, bars_in_session / 3)

    // Update manipulation extremes in first third
    if bars_in_session <= session_third
        po3_manipulation_high := math.max(nz(po3_manipulation_high, high), high)
        po3_manipulation_low := math.min(nz(po3_manipulation_low, low), low)

    // Determine phase based on time and price action
    int prev_phase = po3_phase
    if bars_in_session <= session_third
        po3_phase := PO3_ACCUMULATION
    else if bars_in_session <= session_third * 2
        // Check for manipulation (sweep of accumulation range)
        bool swept_high = high > po3_manipulation_high
        bool swept_low = low < po3_manipulation_low
        if swept_high or swept_low
            po3_phase := PO3_MANIPULATION
        else
            po3_phase := PO3_ACCUMULATION
    else
        // Distribution phase - look for directional expansion
        float range_now = not na(po3_session_high) and not na(po3_session_low) ? po3_session_high - po3_session_low : 0
        float accum_range = po3_manipulation_high - po3_manipulation_low
        if range_now > accum_range * 1.5
            po3_phase := PO3_DISTRIBUTION
        else
            po3_phase := PO3_MANIPULATION

    // Record transition bars (first time each phase triggers)
    if po3_phase == PO3_MANIPULATION and prev_phase != PO3_MANIPULATION and na(po3_manip_start_bar)
        po3_manip_start_bar := bar_index
    if po3_phase == PO3_DISTRIBUTION and prev_phase != PO3_DISTRIBUTION and na(po3_dist_start_bar)
        po3_dist_start_bar := bar_index

po3_phase_changed = po3_phase != po3_phase[1]

// ─────────────────────────────────────────────────────────────────────────────
// POWER OF 3 ZONE VISUALS (vertical dividers + phase text inside session box)
// ─────────────────────────────────────────────────────────────────────────────

var line po3_manip_divider = na
var line po3_dist_divider = na
var label po3_accum_lbl = na
var label po3_manip_lbl = na
var label po3_dist_lbl = na

if i_po3_enabled and po3_session_active and not na(po3_start_bar)
    // Get session high/low for label positioning (place text at bottom of session range)
    float po3_label_y = nz(po3_session_low, low) - (nz(atr_14, low * 0.001) * 0.15)

    // Clean previous drawings
    line.delete(po3_manip_divider)
    line.delete(po3_dist_divider)
    label.delete(po3_accum_lbl)
    label.delete(po3_manip_lbl)
    label.delete(po3_dist_lbl)

    // Accumulation label (always from session start)
    int accum_end = nz(po3_manip_start_bar, bar_index)
    int accum_mid = po3_start_bar + (accum_end - po3_start_bar) / 2
    po3_accum_lbl := label.new(accum_mid, po3_label_y, "Accum", style=label.style_label_up, color=color.new(#2196F3, 85), textcolor=color.new(#2196F3, 20), size=get_label_size(i_label_size), tooltip="Power of 3: ACCUMULATION — Range is building. Smart money is positioning. Wait for the manipulation sweep before acting.")

    // Manipulation divider + label (if phase has triggered)
    if not na(po3_manip_start_bar)
        po3_manip_divider := line.new(po3_manip_start_bar, nz(po3_session_high, high), po3_manip_start_bar, nz(po3_session_low, low), color=color.new(i_po3_manip_color, 40), style=line.style_dotted, width=1)
        int manip_end = nz(po3_dist_start_bar, bar_index)
        int manip_mid = po3_manip_start_bar + (manip_end - po3_manip_start_bar) / 2
        po3_manip_lbl := label.new(manip_mid, po3_label_y, "Manip", style=label.style_label_up, color=color.new(i_po3_manip_color, 85), textcolor=color.new(i_po3_manip_color, 20), size=get_label_size(i_label_size), tooltip="Power of 3: MANIPULATION — Price swept beyond the Accumulation range. This is the liquidity grab / fake move. Wait for reversal confirmation.")

    // Distribution divider + label (if phase has triggered)
    if not na(po3_dist_start_bar)
        po3_dist_divider := line.new(po3_dist_start_bar, nz(po3_session_high, high), po3_dist_start_bar, nz(po3_session_low, low), color=color.new(i_po3_dist_color, 40), style=line.style_dotted, width=1)
        int dist_mid = po3_dist_start_bar + (bar_index - po3_dist_start_bar) / 2
        po3_dist_lbl := label.new(dist_mid, po3_label_y, "Dist", style=label.style_label_up, color=color.new(i_po3_dist_color, 85), textcolor=color.new(i_po3_dist_color, 20), size=get_label_size(i_label_size), tooltip="Power of 3: DISTRIBUTION — The real directional move is underway. Range expanded beyond 1.5x Accumulation. Smart money is delivering price to their target.")

get_po3_name(int phase) =>
    switch phase
        PO3_ACCUMULATION => "Accumulation"
        PO3_MANIPULATION => "Manipulation"
        PO3_DISTRIBUTION => "Distribution"
        => "None"

// ══════════════════════════════════════════════════════════════════════════════
// MOMENTUM PHASE DETECTION
// ══════════════════════════════════════════════════════════════════════════════

get_momentum_phase() =>
    int sess = get_session()
    if sess == SESSION_NONE
        PHASE_EARLY
    else
        int start_bar = switch sess
            SESSION_ASIAN => asian_start_bar
            SESSION_LONDON => london_start_bar
            SESSION_NEWYORK => ny_start_bar
            SESSION_OVERLAP => ny_start_bar
            => na

        if na(start_bar)
            PHASE_EARLY
        else
            int bars_elapsed = bar_index - start_bar
            // Estimate session length (8-9 hours typical)
            float est_session_bars = (8 * 60) / tf_minutes
            float progress = bars_elapsed / est_session_bars

            if progress < 0.33
                PHASE_EARLY
            else if progress < 0.66
                PHASE_MID
            else
                PHASE_LATE

int momentum_phase = get_momentum_phase()

// Track high/low phase for timing anomaly (must be after momentum_phase is calculated)
if i_anomaly_enabled and anomaly_sess != SESSION_NONE
    // Update phase when new high/low forms
    if not na(anomaly_sess_high) and high >= anomaly_sess_high
        session_high_phase := momentum_phase
    if not na(anomaly_sess_low) and low <= anomaly_sess_low
        session_low_phase := momentum_phase

get_phase_name(int phase) =>
    switch phase
        PHASE_EARLY => "Early"
        PHASE_MID => "Mid"
        PHASE_LATE => "Late"
        => "N/A"

// Momentum Phase Change Labels on Chart
bool momentum_phase_changed = momentum_phase != momentum_phase[1]
int curr_session = get_session()

if i_momentum_enabled and i_show_phase_labels and momentum_phase_changed and curr_session != SESSION_NONE
    // Get the appropriate color for the phase
    color phase_col = switch momentum_phase
        PHASE_EARLY => i_momentum_early_color
        PHASE_MID => i_momentum_mid_color
        PHASE_LATE => i_momentum_late_color
        => COLOR_DIM

    // Get phase name and session name for tooltip
    string phase_name = get_phase_name(momentum_phase)
    string sess_name = get_session_name(curr_session)

    // Build data-rich tooltip with live data
    string phase_tip = sess_name + " Session: " + phase_name + " Phase\n"
    phase_tip := phase_tip + (momentum_phase == PHASE_EARLY ? "First third — range building, direction unclear\n" : momentum_phase == PHASE_MID ? "Middle third — direction establishing\n" : "Final third — trend exhaustion possible\n")
    phase_tip := phase_tip + "\nSession Range: " + (not na(curr_range) ? format_price(curr_range) : "—")
    phase_tip := phase_tip + (not na(range_vs_avg) ? " (" + format_pct(range_vs_avg) + " vs avg)" : "")
    phase_tip := phase_tip + "\nADR Used: " + (not na(adr_used_pct) ? str.tostring(adr_used_pct, "#") + "%" : "—")

    // Create label at bottom of chart (below price action)
    label.new(bar_index, low - (nz(atr_14, low * 0.001) * 0.3), phase_name,
         style=label.style_label_up,
         color=color.new(phase_col, 30),
         textcolor=color.white,
         size=size.small,
         tooltip=phase_tip)

// ══════════════════════════════════════════════════════════════════════════════
// SESSION BIAS CALCULATION (Multi-factor)
// ══════════════════════════════════════════════════════════════════════════════

calc_session_bias() =>
    float bias = 0.0
    int factors = 0

    // Factor 1: vs Previous Day Close
    if not na(prev_day_close)
        bias += close > prev_day_close ? 25 : -25
        factors += 1

    // Factor 2: vs Midnight Open
    if not na(midnight_open_price)
        bias += close > midnight_open_price ? 25 : -25
        factors += 1

    // Factor 3: vs Session Open
    int sess = get_session()
    float sess_open = switch sess
        SESSION_ASIAN => asian_open
        SESSION_LONDON => london_open
        SESSION_NEWYORK => ny_open
        SESSION_OVERLAP => ny_open
        => na

    if not na(sess_open)
        bias += close > sess_open ? 25 : -25
        factors += 1

    // Factor 4: vs Session VWAP
    if not na(session_vwap)
        bias += close > session_vwap ? 25 : -25
        factors += 1

    // Factor 5: Position in session range (upper half = bullish)
    float sess_high_val = switch sess
        SESSION_ASIAN => asian_high
        SESSION_LONDON => london_high
        SESSION_NEWYORK => ny_high
        SESSION_OVERLAP => ny_high
        => na

    float sess_low_val = switch sess
        SESSION_ASIAN => asian_low
        SESSION_LONDON => london_low
        SESSION_NEWYORK => ny_low
        SESSION_OVERLAP => ny_low
        => na

    if not na(sess_high_val) and not na(sess_low_val) and sess_high_val != sess_low_val
        float position = (close - sess_low_val) / (sess_high_val - sess_low_val)
        bias += position > 0.5 ? 15 : -15
        factors += 1

    factors > 0 ? bias : 0

float session_bias = calc_session_bias()

// ══════════════════════════════════════════════════════════════════════════════
// OPTIMAL TRADE WINDOW DETECTION
// ══════════════════════════════════════════════════════════════════════════════

// Determine if we're in an optimal trade window
is_optimal_window() =>
    bool optimal = false
    string reason = ""

    // Check Silver Bullet (highest priority)
    if in_silver_am() or in_silver_pm()
        optimal := true
        reason := "Silver Bullet"
    // Check Killzone with good efficiency history
    else if in_kz_london() and not na(avg_london_eff) and avg_london_eff > 40
        optimal := true
        reason := "London KZ (High Eff)"
    else if in_kz_ny_am() and not na(avg_ny_eff) and avg_ny_eff > 40
        optimal := true
        reason := "NY AM KZ (High Eff)"
    // Check if overlap with good continuation rate
    else if in_overlap() and not na(ny_continuation_pct) and ny_continuation_pct > 60
        optimal := true
        reason := "Overlap (High Cont)"

    [optimal, reason]

[is_otw, otw_reason] = is_optimal_window()

// ══════════════════════════════════════════════════════════════════════════════
// DRAWING - SESSION BOXES
// ══════════════════════════════════════════════════════════════════════════════

max_boxes = i_lookback_days * 3
var box[] asian_boxes = array.new_box()
var box[] london_boxes = array.new_box()
var box[] ny_boxes = array.new_box()

clean_boxes(box[] boxes, int max_size) =>
    while array.size(boxes) > max_size
        box old = array.shift(boxes)
        box.delete(old)

// Helper function for box style
get_box_bgcolor(color fill_color, string style) =>
    style == "Border Only" ? color.new(fill_color, 100) : fill_color

get_box_border_width(string style) =>
    style == "Filled + Border" ? 2 : 1

// Asian box
var box curr_asian_box = na
if i_asian_enabled
    if asian_start()
        curr_asian_box := box.new(bar_index, high, bar_index, low, border_color=i_asian_border, bgcolor=get_box_bgcolor(i_asian_color, i_box_style), border_width=get_box_border_width(i_box_style))
        if i_show_labels
            label.new(bar_index, high + (nz(atr_14, high * 0.001) * 0.5), "ASN", style=label.style_label_down, color=color.new(i_asian_border, 30), textcolor=color.white, size=get_label_size(i_label_size), tooltip="Asian Session Start (20:00–04:00 UTC)\nCovers Sydney, Tokyo, Singapore, Hong Kong\nOpen: " + format_price(open) + "\nADR Used: " + (not na(adr_used_pct) ? str.tostring(adr_used_pct, "#") + "%" : "—"))
    else if in_asian() and not na(curr_asian_box)
        box.set_right(curr_asian_box, bar_index)
        box.set_top(curr_asian_box, math.max(box.get_top(curr_asian_box), high))
        box.set_bottom(curr_asian_box, math.min(box.get_bottom(curr_asian_box), low))
    if asian_end() and not na(curr_asian_box)
        array.push(asian_boxes, curr_asian_box)
        clean_boxes(asian_boxes, max_boxes)

// London box
var box curr_london_box = na
if i_london_enabled
    if london_start()
        curr_london_box := box.new(bar_index, high, bar_index, low, border_color=i_london_border, bgcolor=get_box_bgcolor(i_london_color, i_box_style), border_width=get_box_border_width(i_box_style))
        if i_show_labels
            label.new(bar_index, high + (nz(atr_14, high * 0.001) * 0.5), "LDN", style=label.style_label_down, color=color.new(i_london_border, 30), textcolor=color.white, size=get_label_size(i_label_size), tooltip="London Session Start (07:00–16:00 UTC)\nHighest liquidity European session\nOpen: " + format_price(open) + "\nADR Used: " + (not na(adr_used_pct) ? str.tostring(adr_used_pct, "#") + "%" : "—") + "\nAsian Range: " + (not na(asian_high) and not na(asian_low) ? format_price(asian_high - asian_low) : "—"))
    else if in_london() and not na(curr_london_box)
        box.set_right(curr_london_box, bar_index)
        box.set_top(curr_london_box, math.max(box.get_top(curr_london_box), high))
        box.set_bottom(curr_london_box, math.min(box.get_bottom(curr_london_box), low))
    if london_end() and not na(curr_london_box)
        array.push(london_boxes, curr_london_box)
        clean_boxes(london_boxes, max_boxes)

// NY box
var box curr_ny_box = na
if i_ny_enabled
    if ny_start()
        curr_ny_box := box.new(bar_index, high, bar_index, low, border_color=i_ny_border, bgcolor=get_box_bgcolor(i_ny_color, i_box_style), border_width=get_box_border_width(i_box_style))
        if i_show_labels
            label.new(bar_index, high + (nz(atr_14, high * 0.001) * 0.5), "NY", style=label.style_label_down, color=color.new(i_ny_border, 30), textcolor=color.white, size=get_label_size(i_label_size), tooltip="New York Session Start (13:00–22:00 UTC)\nHighest volume session globally\nOpen: " + format_price(open) + "\nADR Used: " + (not na(adr_used_pct) ? str.tostring(adr_used_pct, "#") + "%" : "—") + "\nLDN Range: " + (not na(london_high) and not na(london_low) ? format_price(london_high - london_low) : "—"))
    else if in_ny() and not na(curr_ny_box)
        box.set_right(curr_ny_box, bar_index)
        box.set_top(curr_ny_box, math.max(box.get_top(curr_ny_box), high))
        box.set_bottom(curr_ny_box, math.min(box.get_bottom(curr_ny_box), low))
    if ny_end() and not na(curr_ny_box)
        array.push(ny_boxes, curr_ny_box)
        clean_boxes(ny_boxes, max_boxes)

// ══════════════════════════════════════════════════════════════════════════════
// SHOW CURRENT SESSION ONLY - Hide historical boxes
// ══════════════════════════════════════════════════════════════════════════════

// Function to hide all boxes in an array
hide_all_boxes(box[] boxes) =>
    int size = array.size(boxes)
    if size > 0
        for i = 0 to size - 1
            b = array.get(boxes, i)
            if not na(b)
                box.set_bgcolor(b, color.new(color.black, 100))
                box.set_border_color(b, color.new(color.black, 100))

// Function to restore all boxes in an array with given colors
restore_all_boxes(box[] boxes, color fill_col, color border_col, string box_style) =>
    int size = array.size(boxes)
    if size > 0
        for i = 0 to size - 1
            b = array.get(boxes, i)
            if not na(b)
                box.set_bgcolor(b, get_box_bgcolor(fill_col, box_style))
                box.set_border_color(b, border_col)
                box.set_border_width(b, get_box_border_width(box_style))

// Track previous state to know when setting changes
var bool prev_show_current_only = false

// When "Show Current Session Only" is enabled, hide historical boxes
if i_show_current_only
    // Hide all historical session boxes
    hide_all_boxes(asian_boxes)
    hide_all_boxes(london_boxes)
    hide_all_boxes(ny_boxes)

    // Also hide current boxes that aren't from the active session
    int active_session = get_session()

    // Hide Asian box if not in Asian session
    if active_session != SESSION_ASIAN and not na(curr_asian_box)
        box.set_bgcolor(curr_asian_box, color.new(color.black, 100))
        box.set_border_color(curr_asian_box, color.new(color.black, 100))

    // Hide London box if not in London session (and not in overlap)
    if active_session != SESSION_LONDON and active_session != SESSION_OVERLAP and not na(curr_london_box)
        box.set_bgcolor(curr_london_box, color.new(color.black, 100))
        box.set_border_color(curr_london_box, color.new(color.black, 100))

    // Hide NY box if not in NY session (and not in overlap)
    if active_session != SESSION_NEWYORK and active_session != SESSION_OVERLAP and not na(curr_ny_box)
        box.set_bgcolor(curr_ny_box, color.new(color.black, 100))
        box.set_border_color(curr_ny_box, color.new(color.black, 100))

// When setting is turned OFF, restore box visibility
else if prev_show_current_only and not i_show_current_only
    restore_all_boxes(asian_boxes, i_asian_color, i_asian_border, i_box_style)
    restore_all_boxes(london_boxes, i_london_color, i_london_border, i_box_style)
    restore_all_boxes(ny_boxes, i_ny_color, i_ny_border, i_box_style)

prev_show_current_only := i_show_current_only

// ══════════════════════════════════════════════════════════════════════════════
// DRAWING - KEY LEVELS
// ══════════════════════════════════════════════════════════════════════════════

// Previous Hour High
var line phh_line = na
var label phh_lbl = na
if i_phhl_enabled and not na(prev_hour_high)
    line.delete(phh_line)
    label.delete(phh_lbl)
    phh_line := line.new(bar_index - 20, prev_hour_high, bar_index + 20, prev_hour_high, color=color.new(#26A69A, 50), style=line.style_dotted, width=1, extend=i_extend_levels ? extend.right : extend.none)
    if i_level_labels
        string lbl_text = "PHH" + (i_level_prices ? " " + format_price(prev_hour_high) : "")
        phh_lbl := label.new(bar_index + label_offset, prev_hour_high, lbl_text, style=label.style_label_left, color=color.new(#26A69A, 70), textcolor=color.new(#26A69A, 0), size=get_label_size(i_label_size), tooltip="Previous Hour High — micro-level for intraday momentum. Breaks above signal bullish intent for the current hour.")

// Previous Hour Low
var line phl_line = na
var label phl_lbl = na
if i_phhl_enabled and not na(prev_hour_low)
    line.delete(phl_line)
    label.delete(phl_lbl)
    phl_line := line.new(bar_index - 20, prev_hour_low, bar_index + 20, prev_hour_low, color=color.new(#EF5350, 50), style=line.style_dotted, width=1, extend=i_extend_levels ? extend.right : extend.none)
    if i_level_labels
        string lbl_text = "PHL" + (i_level_prices ? " " + format_price(prev_hour_low) : "")
        phl_lbl := label.new(bar_index + label_offset, prev_hour_low, lbl_text, style=label.style_label_left, color=color.new(#EF5350, 70), textcolor=color.new(#EF5350, 0), size=get_label_size(i_label_size), tooltip="Previous Hour Low — micro-level for intraday momentum. Breaks below signal bearish intent for the current hour.")

// Previous Day High
var line pdh_line = na
var label pdh_lbl = na
if i_pdl_enabled and i_pdl_high and not na(prev_day_high)
    line.delete(pdh_line)
    label.delete(pdh_lbl)
    pdh_line := line.new(bar_index - 50, prev_day_high, bar_index + 20, prev_day_high, color=i_pdl_color_high, style=line.style_dashed, width=1, extend=i_extend_levels ? extend.right : extend.none)
    if i_level_labels
        string lbl_text = "PDH" + (i_level_prices ? " " + format_price(prev_day_high) : "")
        pdh_lbl := label.new(bar_index + label_offset, prev_day_high, lbl_text, style=label.style_label_left, color=color.new(i_pdl_color_high, 80), textcolor=i_pdl_color_high, size=get_label_size(i_label_size), tooltip="Previous Day High — key resistance level. Breaks above may signal continuation; rejections may signal reversal.")

// Previous Day Low
var line pdl_line = na
var label pdl_lbl = na
if i_pdl_enabled and i_pdl_low and not na(prev_day_low)
    line.delete(pdl_line)
    label.delete(pdl_lbl)
    pdl_line := line.new(bar_index - 50, prev_day_low, bar_index + 20, prev_day_low, color=i_pdl_color_low, style=line.style_dashed, width=1, extend=i_extend_levels ? extend.right : extend.none)
    if i_level_labels
        string lbl_text = "PDL" + (i_level_prices ? " " + format_price(prev_day_low) : "")
        pdl_lbl := label.new(bar_index + label_offset, prev_day_low, lbl_text, style=label.style_label_left, color=color.new(i_pdl_color_low, 80), textcolor=i_pdl_color_low, size=get_label_size(i_label_size), tooltip="Previous Day Low — key support level. Breaks below may signal continuation; rejections may signal reversal.")

// Previous Day Close
var line pdc_line = na
var label pdc_lbl = na
if i_pdl_enabled and i_pdl_close and not na(prev_day_close)
    line.delete(pdc_line)
    label.delete(pdc_lbl)
    pdc_line := line.new(bar_index - 50, prev_day_close, bar_index + 20, prev_day_close, color=i_pdl_color_close, style=line.style_dashed, width=1, extend=i_extend_levels ? extend.right : extend.none)
    if i_level_labels
        string lbl_text = "PDC" + (i_level_prices ? " " + format_price(prev_day_close) : "")
        pdc_lbl := label.new(bar_index + label_offset, prev_day_close, lbl_text, style=label.style_label_left, color=color.new(i_pdl_color_close, 80), textcolor=i_pdl_color_close, size=get_label_size(i_label_size), tooltip="Previous Day Close — daily bias reference. Price above = bullish bias, below = bearish bias.")

// Previous Week High
var line pwh_line = na
var label pwh_lbl = na
if i_pwhl_enabled and not na(prev_week_high)
    line.delete(pwh_line)
    label.delete(pwh_lbl)
    pwh_line := line.new(bar_index - 50, prev_week_high, bar_index + 20, prev_week_high, color=i_pdl_color_high, style=line.style_solid, width=2, extend=i_extend_levels ? extend.right : extend.none)
    if i_level_labels
        string lbl_text = "PWH" + (i_level_prices ? " " + format_price(prev_week_high) : "")
        pwh_lbl := label.new(bar_index + label_offset, prev_week_high, lbl_text, style=label.style_label_left, color=color.new(i_pdl_color_high, 40), textcolor=color.white, size=get_label_size(i_label_size), tooltip="Previous Week High — major institutional resistance. Weekly liquidity rests above this level. Breaks often trigger significant continuation moves.")

// Previous Week Low
var line pwl_line = na
var label pwl_lbl = na
if i_pwhl_enabled and not na(prev_week_low)
    line.delete(pwl_line)
    label.delete(pwl_lbl)
    pwl_line := line.new(bar_index - 50, prev_week_low, bar_index + 20, prev_week_low, color=i_pdl_color_low, style=line.style_solid, width=2, extend=i_extend_levels ? extend.right : extend.none)
    if i_level_labels
        string lbl_text = "PWL" + (i_level_prices ? " " + format_price(prev_week_low) : "")
        pwl_lbl := label.new(bar_index + label_offset, prev_week_low, lbl_text, style=label.style_label_left, color=color.new(i_pdl_color_low, 40), textcolor=color.white, size=get_label_size(i_label_size), tooltip="Previous Week Low — major institutional support. Weekly liquidity rests below this level. Breaks often trigger significant continuation moves.")

// Previous Month High
var line pmh_line = na
var label pmh_lbl = na
if i_pmhl_enabled and not na(prev_month_high)
    line.delete(pmh_line)
    label.delete(pmh_lbl)
    pmh_line := line.new(bar_index - 50, prev_month_high, bar_index + 20, prev_month_high, color=i_pdl_color_high, style=line.style_solid, width=2, extend=i_extend_levels ? extend.right : extend.none)
    if i_level_labels
        string lbl_text = "PMH" + (i_level_prices ? " " + format_price(prev_month_high) : "")
        pmh_lbl := label.new(bar_index + label_offset, prev_month_high, lbl_text, style=label.style_label_left, color=color.new(i_pdl_color_high, 30), textcolor=color.white, size=get_label_size(i_label_size), tooltip="Previous Month High — heavyweight institutional resistance. Monthly ranges define macro structure. Breaks of PMH often signal trend continuation or major reversals.")

// Previous Month Low
var line pml_line = na
var label pml_lbl = na
if i_pmhl_enabled and not na(prev_month_low)
    line.delete(pml_line)
    label.delete(pml_lbl)
    pml_line := line.new(bar_index - 50, prev_month_low, bar_index + 20, prev_month_low, color=i_pdl_color_low, style=line.style_solid, width=2, extend=i_extend_levels ? extend.right : extend.none)
    if i_level_labels
        string lbl_text = "PML" + (i_level_prices ? " " + format_price(prev_month_low) : "")
        pml_lbl := label.new(bar_index + label_offset, prev_month_low, lbl_text, style=label.style_label_left, color=color.new(i_pdl_color_low, 30), textcolor=color.white, size=get_label_size(i_label_size), tooltip="Previous Month Low — heavyweight institutional support. Monthly ranges define macro structure. Breaks of PML often signal trend continuation or major reversals.")

// Previous Quarter High
var line pqh_line = na
var label pqh_lbl = na
if i_pqhl_enabled and not na(prev_quarter_high)
    line.delete(pqh_line)
    label.delete(pqh_lbl)
    pqh_line := line.new(bar_index - 50, prev_quarter_high, bar_index + 20, prev_quarter_high, color=i_pdl_color_high, style=line.style_solid, width=3, extend=i_extend_levels ? extend.right : extend.none)
    if i_level_labels
        string lbl_text = "PQH" + (i_level_prices ? " " + format_price(prev_quarter_high) : "")
        pqh_lbl := label.new(bar_index + label_offset, prev_quarter_high, lbl_text, style=label.style_label_left, color=color.new(i_pdl_color_high, 20), textcolor=color.white, size=get_label_size(i_label_size), tooltip="Previous Quarter High — the highest-timeframe institutional level. Quarterly liquidity sweeps drive the largest moves. This is where hedge funds and central banks position.")

// Previous Quarter Low
var line pql_line = na
var label pql_lbl = na
if i_pqhl_enabled and not na(prev_quarter_low)
    line.delete(pql_line)
    label.delete(pql_lbl)
    pql_line := line.new(bar_index - 50, prev_quarter_low, bar_index + 20, prev_quarter_low, color=i_pdl_color_low, style=line.style_solid, width=3, extend=i_extend_levels ? extend.right : extend.none)
    if i_level_labels
        string lbl_text = "PQL" + (i_level_prices ? " " + format_price(prev_quarter_low) : "")
        pql_lbl := label.new(bar_index + label_offset, prev_quarter_low, lbl_text, style=label.style_label_left, color=color.new(i_pdl_color_low, 20), textcolor=color.white, size=get_label_size(i_label_size), tooltip="Previous Quarter Low — the highest-timeframe institutional level. Quarterly liquidity sweeps drive the largest moves. This is where hedge funds and central banks position.")

// Midnight Open (True Day Open)
var line midnight_line = na
var label midnight_lbl = na
if i_ict_enabled and i_midnight_open and not na(midnight_open_price)
    line.delete(midnight_line)
    label.delete(midnight_lbl)
    midnight_line := line.new(bar_index - 50, midnight_open_price, bar_index + 20, midnight_open_price, color=i_midnight_color, style=line.style_dashed, width=1, extend=i_extend_levels ? extend.right : extend.none)
    if i_level_labels
        string lbl_text = "00:00 Open" + (i_level_prices ? " " + format_price(midnight_open_price) : "")
        midnight_lbl := label.new(bar_index + label_offset, midnight_open_price, lbl_text, style=label.style_label_left, color=color.new(i_midnight_color, 80), textcolor=i_midnight_color, size=get_label_size(i_label_size), tooltip="ICT Midnight Open (True Day Open) — price at 00:00 UTC. Institutional reference for daily directional bias.")

// Weekly Open
var line weekly_line = na
var label weekly_lbl = na
if i_ict_enabled and i_weekly_open and not na(weekly_open_price)
    line.delete(weekly_line)
    label.delete(weekly_lbl)
    weekly_line := line.new(bar_index - 50, weekly_open_price, bar_index + 20, weekly_open_price, color=i_weekly_color, style=line.style_solid, width=2, extend=i_extend_levels ? extend.right : extend.none)
    if i_level_labels
        string lbl_text = "Weekly Open" + (i_level_prices ? " " + format_price(weekly_open_price) : "")
        weekly_lbl := label.new(bar_index + label_offset, weekly_open_price, lbl_text, style=label.style_label_left, color=color.new(i_weekly_color, 80), textcolor=i_weekly_color, size=get_label_size(i_label_size), tooltip="Weekly Open — Monday's opening price. Price above = bullish weekly bias. Institutional reference.")

// CBDR Projections (Central Bank Dealers Range — expansion targets)
var line cbdr_high_line = na
var line cbdr_low_line = na
var line cbdr_2x_high_line = na
var line cbdr_2x_low_line = na
var label cbdr_high_lbl = na
var label cbdr_low_lbl = na
var label cbdr_2x_high_lbl = na
var label cbdr_2x_low_lbl = na

if i_cbdr_enabled and cbdr_complete and not na(cbdr_high) and not na(cbdr_low) and not na(cbdr_range) and cbdr_range > 0
    line.delete(cbdr_high_line)
    line.delete(cbdr_low_line)
    line.delete(cbdr_2x_high_line)
    line.delete(cbdr_2x_low_line)
    label.delete(cbdr_high_lbl)
    label.delete(cbdr_low_lbl)
    label.delete(cbdr_2x_high_lbl)
    label.delete(cbdr_2x_low_lbl)

    float cbdr_1x_high = cbdr_high + cbdr_range
    float cbdr_1x_low = cbdr_low - cbdr_range
    float cbdr_2x_high = cbdr_high + (cbdr_range * 2)
    float cbdr_2x_low = cbdr_low - (cbdr_range * 2)

    color cbdr_col = color.new(#00BCD4, 40)

    // 1x CBDR expansion
    cbdr_high_line := line.new(nz(cbdr_start_bar, bar_index - 20), cbdr_1x_high, bar_index + 20, cbdr_1x_high, color=cbdr_col, style=line.style_dashed, width=1)
    cbdr_low_line := line.new(nz(cbdr_start_bar, bar_index - 20), cbdr_1x_low, bar_index + 20, cbdr_1x_low, color=cbdr_col, style=line.style_dashed, width=1)

    // 2x CBDR expansion (primary target)
    cbdr_2x_high_line := line.new(nz(cbdr_start_bar, bar_index - 20), cbdr_2x_high, bar_index + 20, cbdr_2x_high, color=cbdr_col, style=line.style_solid, width=2)
    cbdr_2x_low_line := line.new(nz(cbdr_start_bar, bar_index - 20), cbdr_2x_low, bar_index + 20, cbdr_2x_low, color=cbdr_col, style=line.style_solid, width=2)

    if i_level_labels
        cbdr_high_lbl := label.new(bar_index + label_offset, cbdr_1x_high, "CBDR 1x" + (i_level_prices ? " " + format_price(cbdr_1x_high) : ""), style=label.style_label_left, color=color.new(cbdr_col, 70), textcolor=color.new(#00BCD4, 0), size=get_label_size(i_label_size), tooltip="CBDR 1x Expansion — 1 times the Central Bank Dealers Range projected above. First expansion target.")
        cbdr_low_lbl := label.new(bar_index + label_offset, cbdr_1x_low, "CBDR 1x" + (i_level_prices ? " " + format_price(cbdr_1x_low) : ""), style=label.style_label_left, color=color.new(cbdr_col, 70), textcolor=color.new(#00BCD4, 0), size=get_label_size(i_label_size), tooltip="CBDR 1x Expansion — 1 times the Central Bank Dealers Range projected below. First expansion target.")
        cbdr_2x_high_lbl := label.new(bar_index + label_offset, cbdr_2x_high, "CBDR 2x" + (i_level_prices ? " " + format_price(cbdr_2x_high) : ""), style=label.style_label_left, color=color.new(cbdr_col, 60), textcolor=color.new(#00BCD4, 0), size=get_label_size(i_label_size), tooltip="CBDR 2x Expansion — 2 times the Central Bank Dealers Range projected above. Primary institutional target — the real move often reaches this level.")
        cbdr_2x_low_lbl := label.new(bar_index + label_offset, cbdr_2x_low, "CBDR 2x" + (i_level_prices ? " " + format_price(cbdr_2x_low) : ""), style=label.style_label_left, color=color.new(cbdr_col, 60), textcolor=color.new(#00BCD4, 0), size=get_label_size(i_label_size), tooltip="CBDR 2x Expansion — 2 times the Central Bank Dealers Range projected below. Primary institutional target — the real move often reaches this level.")

// ADR Projections
var line adr_high_line = na
var line adr_low_line = na
var label adr_high_lbl = na
var label adr_low_lbl = na
if i_adr_enabled and i_adr_show_levels
    if not na(adr_high_proj)
        line.delete(adr_high_line)
        label.delete(adr_high_lbl)
        adr_high_line := line.new(bar_index - 20, adr_high_proj, bar_index + 20, adr_high_proj, color=i_adr_high_color, style=line.style_dotted, width=1, extend=extend.right)
        if i_level_labels
            string lbl_text = "ADR High" + (i_level_prices ? " " + format_price(adr_high_proj) : "")
            adr_high_lbl := label.new(bar_index + label_offset, adr_high_proj, lbl_text, style=label.style_label_left, color=color.new(i_adr_high_color, 80), textcolor=i_adr_high_color, size=get_label_size(i_label_size), tooltip="ADR High Projection — expected upper range limit based on average daily range. Price reaching this level suggests the day's upside may be exhausted.")
    if not na(adr_low_proj)
        line.delete(adr_low_line)
        label.delete(adr_low_lbl)
        adr_low_line := line.new(bar_index - 20, adr_low_proj, bar_index + 20, adr_low_proj, color=i_adr_low_color, style=line.style_dotted, width=1, extend=extend.right)
        if i_level_labels
            string lbl_text = "ADR Low" + (i_level_prices ? " " + format_price(adr_low_proj) : "")
            adr_low_lbl := label.new(bar_index + label_offset, adr_low_proj, lbl_text, style=label.style_label_left, color=color.new(i_adr_low_color, 80), textcolor=i_adr_low_color, size=get_label_size(i_label_size), tooltip="ADR Low Projection — expected lower range limit based on average daily range. Price reaching this level suggests the day's downside may be exhausted.")

// ─────────────────────────────────────────────────────────────────────────────
// SESSION RANGE PROJECTIONS - VISUAL ELEMENTS
// Projected high/low targets based on historical session ranges
// ─────────────────────────────────────────────────────────────────────────────

var line sess_proj_high_line = na
var line sess_proj_low_line = na
var box sess_proj_high_zone = na
var box sess_proj_low_zone = na
var label sess_proj_high_lbl = na
var label sess_proj_low_lbl = na

// Only draw when projection is active for current session (also during overlap if NY)
int curr_chart_session = get_session()
bool srp_session_match = curr_chart_session == srp_session or (curr_chart_session == SESSION_OVERLAP and srp_session == SESSION_NEWYORK)
bool srp_active = i_range_proj_enabled and srp_session != SESSION_NONE and srp_session_match and not na(srp_high) and not na(srp_low)

if srp_active
    // Clean up previous drawings
    line.delete(sess_proj_high_line)
    line.delete(sess_proj_low_line)
    box.delete(sess_proj_high_zone)
    box.delete(sess_proj_low_zone)
    label.delete(sess_proj_high_lbl)
    label.delete(sess_proj_low_lbl)
    
    // Get session name for labels
    string sess_abbr = switch srp_session
        SESSION_ASIAN => "ASN"
        SESSION_LONDON => "LDN"
        SESSION_NEWYORK => "NY"
        => "SESS"
    
    // Colors - dim if target already hit
    color high_col = srp_high_hit ? color.new(i_proj_high_color, 85) : i_proj_high_color
    color low_col = srp_low_hit ? color.new(i_proj_low_color, 85) : i_proj_low_color
    color high_line_col = srp_high_hit ? color.new(#26A69A, 70) : color.new(#26A69A, 40)
    color low_line_col = srp_low_hit ? color.new(#EF5350, 70) : color.new(#EF5350, 40)
    
    // Calculate zone size (10% of range for visual zone)
    float zone_size = (srp_high - srp_low) * 0.08
    
    // Get session start bar for zone left edge
    int sess_start = switch srp_session
        SESSION_ASIAN => asian_start_bar
        SESSION_LONDON => london_start_bar
        SESSION_NEWYORK => ny_start_bar
        => bar_index - 10
    
    // Draw projection zones (shaded areas around targets — forward-looking from current bar)
    if i_range_proj_show_zone
        // High zone - from srp_high down a bit
        sess_proj_high_zone := box.new(bar_index, srp_high, bar_index + 20, srp_high - zone_size, bgcolor=high_col, border_color=color.new(color.white, 100))
        // Low zone - from srp_low up a bit
        sess_proj_low_zone := box.new(bar_index, srp_low + zone_size, bar_index + 20, srp_low, bgcolor=low_col, border_color=color.new(color.white, 100))
    
    // Draw projection lines (from session start to current bar + offset)
    if i_range_proj_show_lines
        sess_proj_high_line := line.new(nz(sess_start, bar_index - 10), srp_high, bar_index + 20, srp_high, color=high_line_col, style=get_line_style(i_session_level_style), width=1)
        sess_proj_low_line := line.new(nz(sess_start, bar_index - 10), srp_low, bar_index + 20, srp_low, color=low_line_col, style=get_line_style(i_session_level_style), width=1)
    
    // Draw labels (solid colors for readability)
    if i_level_labels
        string high_status = srp_high_hit ? " ✓" : ""
        string low_status = srp_low_hit ? " ✓" : ""
        string conf_str = not na(srp_confidence) ? " (" + str.tostring(srp_confidence, "#") + "%)" : ""
        
        string high_text = sess_abbr + " Proj Hi" + high_status + (i_level_prices ? " " + format_price(srp_high) : "") + (not srp_high_hit ? conf_str : "")
        string low_text = sess_abbr + " Proj Lo" + low_status + (i_level_prices ? " " + format_price(srp_low) : "") + (not srp_low_hit ? conf_str : "")
        
        color high_lbl_bg = srp_high_hit ? color.new(COLOR_BULL, 60) : color.new(COLOR_BULL, 30)
        color low_lbl_bg = srp_low_hit ? color.new(COLOR_BEAR, 60) : color.new(COLOR_BEAR, 30)
        
        sess_proj_high_lbl := label.new(bar_index + label_offset, srp_high, high_text, style=label.style_label_left, color=high_lbl_bg, textcolor=color.white, size=get_label_size(i_label_size), tooltip="Projected session high target based on historical range, regime, ADR remaining, and bias. Dims when target is reached.")
        sess_proj_low_lbl := label.new(bar_index + label_offset, srp_low, low_text, style=label.style_label_left, color=low_lbl_bg, textcolor=color.white, size=get_label_size(i_label_size), tooltip="Projected session low target based on historical range, regime, ADR remaining, and bias. Dims when target is reached.")

// Clear drawings when projection becomes inactive
else if i_range_proj_enabled
    line.delete(sess_proj_high_line)
    line.delete(sess_proj_low_line)
    box.delete(sess_proj_high_zone)
    box.delete(sess_proj_low_zone)
    label.delete(sess_proj_high_lbl)
    label.delete(sess_proj_low_lbl)

// Opening Range
var line or_high_line = na
var line or_low_line = na
var box or_box = na
var label or_high_lbl = na
var label or_low_lbl = na
if i_or_enabled and or_complete
    line.delete(or_high_line)
    line.delete(or_low_line)
    box.delete(or_box)
    label.delete(or_high_lbl)
    label.delete(or_low_lbl)
    // Solid filled box from OR start to end of OR period
    int or_left = nz(or_start_bar, bar_index - or_bars)
    int or_right = or_left + or_bars
    or_box := box.new(or_left, or_high, or_right, or_low, border_color=i_or_color, bgcolor=color.new(i_or_color, 80), border_width=1, border_style=line.style_solid)
    // Extend level lines from OR box right edge into future price action
    or_high_line := line.new(or_right, or_high, bar_index + 20, or_high, color=i_or_color, style=line.style_dotted, width=1, extend=i_extend_levels ? extend.right : extend.none)
    or_low_line := line.new(or_right, or_low, bar_index + 20, or_low, color=i_or_color, style=line.style_dotted, width=1, extend=i_extend_levels ? extend.right : extend.none)
    if i_level_labels
        string or_prefix = i_or_session == "Asian" ? "ASN" : i_or_session == "London" ? "LDN" : "NY"
        string high_text = or_prefix + " OR High" + (i_level_prices ? " " + format_price(or_high) : "")
        string low_text = or_prefix + " OR Low" + (i_level_prices ? " " + format_price(or_low) : "")
        or_high_lbl := label.new(bar_index + label_offset, or_high, high_text, style=label.style_label_left, color=color.new(i_or_color, 80), textcolor=i_or_color, size=get_label_size(i_label_size), tooltip="Opening Range High — break above signals bullish session intent. Often used as entry trigger with OR Low as stop reference.")
        or_low_lbl := label.new(bar_index + label_offset, or_low, low_text, style=label.style_label_left, color=color.new(i_or_color, 80), textcolor=i_or_color, size=get_label_size(i_label_size), tooltip="Opening Range Low — break below signals bearish session intent. Often used as entry trigger with OR High as stop reference.")

// ══════════════════════════════════════════════════════════════════════════════
// SESSION HIGH/LOW & OPEN LEVELS
// ══════════════════════════════════════════════════════════════════════════════

// Get line style from setting
session_line_style = get_line_style(i_session_level_style)

// Asian Session Levels
var line asian_high_line = na
var line asian_low_line = na
var line asian_open_line = na
var label asian_high_lbl = na
var label asian_low_lbl = na
var label asian_open_lbl = na

if i_asian_enabled and in_asian()
    // Session High
    if i_show_asian_levels and not na(asian_high)
        line.delete(asian_high_line)
        label.delete(asian_high_lbl)
        asian_high_line := line.new(nz(asian_start_bar, bar_index), asian_high, bar_index + 20, asian_high, color=i_asian_border, style=session_line_style, width=1, extend=i_extend_levels ? extend.right : extend.none)
        if i_level_labels
            string lbl_text = "ASN High" + (i_level_prices ? " " + format_price(asian_high) : "")
            asian_high_lbl := label.new(bar_index + label_offset, asian_high, lbl_text, style=label.style_label_left, color=color.new(i_asian_border, 80), textcolor=i_asian_border, size=get_label_size(i_label_size), tooltip="ASN Session High — highest price reached during the Asian session. Key resistance if price revisits.")

    // Session Low
    if i_show_asian_levels and not na(asian_low)
        line.delete(asian_low_line)
        label.delete(asian_low_lbl)
        asian_low_line := line.new(nz(asian_start_bar, bar_index), asian_low, bar_index + 20, asian_low, color=i_asian_border, style=session_line_style, width=1, extend=i_extend_levels ? extend.right : extend.none)
        if i_level_labels
            string lbl_text = "ASN Low" + (i_level_prices ? " " + format_price(asian_low) : "")
            asian_low_lbl := label.new(bar_index + label_offset, asian_low, lbl_text, style=label.style_label_left, color=color.new(i_asian_border, 80), textcolor=i_asian_border, size=get_label_size(i_label_size), tooltip="ASN Session Low — lowest price reached during the Asian session. Key support if price revisits.")

    // Session Open
    if i_show_asian_open and not na(asian_open)
        line.delete(asian_open_line)
        label.delete(asian_open_lbl)
        asian_open_line := line.new(nz(asian_start_bar, bar_index), asian_open, bar_index + 20, asian_open, color=color.new(i_asian_border, 50), style=session_line_style, width=1, extend=i_extend_levels ? extend.right : extend.none)
        if i_level_labels
            string lbl_text = "ASN Open" + (i_level_prices ? " " + format_price(asian_open) : "")
            asian_open_lbl := label.new(bar_index + label_offset, asian_open, lbl_text, style=label.style_label_left, color=color.new(i_asian_border, 90), textcolor=color.new(i_asian_border, 30), size=get_label_size(i_label_size), tooltip="ASN Session Open — opening price of the Asian session. Price above = session bullish, below = session bearish.")

// London Session Levels
var line london_high_line = na
var line london_low_line = na
var line london_open_line = na
var label london_high_lbl = na
var label london_low_lbl = na
var label london_open_lbl = na

if i_london_enabled and in_london()
    // Session High
    if i_show_london_levels and not na(london_high)
        line.delete(london_high_line)
        label.delete(london_high_lbl)
        london_high_line := line.new(nz(london_start_bar, bar_index), london_high, bar_index + 20, london_high, color=i_london_border, style=session_line_style, width=1, extend=i_extend_levels ? extend.right : extend.none)
        if i_level_labels
            string lbl_text = "LDN High" + (i_level_prices ? " " + format_price(london_high) : "")
            london_high_lbl := label.new(bar_index + label_offset, london_high, lbl_text, style=label.style_label_left, color=color.new(i_london_border, 80), textcolor=i_london_border, size=get_label_size(i_label_size), tooltip="LDN Session High — highest price reached during the London session. Key resistance if price revisits.")

    // Session Low
    if i_show_london_levels and not na(london_low)
        line.delete(london_low_line)
        label.delete(london_low_lbl)
        london_low_line := line.new(nz(london_start_bar, bar_index), london_low, bar_index + 20, london_low, color=i_london_border, style=session_line_style, width=1, extend=i_extend_levels ? extend.right : extend.none)
        if i_level_labels
            string lbl_text = "LDN Low" + (i_level_prices ? " " + format_price(london_low) : "")
            london_low_lbl := label.new(bar_index + label_offset, london_low, lbl_text, style=label.style_label_left, color=color.new(i_london_border, 80), textcolor=i_london_border, size=get_label_size(i_label_size), tooltip="LDN Session Low — lowest price reached during the London session. Key support if price revisits.")

    // Session Open
    if i_show_london_open and not na(london_open)
        line.delete(london_open_line)
        label.delete(london_open_lbl)
        london_open_line := line.new(nz(london_start_bar, bar_index), london_open, bar_index + 20, london_open, color=color.new(i_london_border, 50), style=session_line_style, width=1, extend=i_extend_levels ? extend.right : extend.none)
        if i_level_labels
            string lbl_text = "LDN Open" + (i_level_prices ? " " + format_price(london_open) : "")
            london_open_lbl := label.new(bar_index + label_offset, london_open, lbl_text, style=label.style_label_left, color=color.new(i_london_border, 90), textcolor=color.new(i_london_border, 30), size=get_label_size(i_label_size), tooltip="LDN Session Open — opening price of the London session. Price above = session bullish, below = session bearish.")

// New York Session Levels
var line ny_high_line = na
var line ny_low_line = na
var line ny_open_line = na
var label ny_high_lbl = na
var label ny_low_lbl = na
var label ny_open_lbl = na

if i_ny_enabled and in_ny()
    // Session High
    if i_show_ny_levels and not na(ny_high)
        line.delete(ny_high_line)
        label.delete(ny_high_lbl)
        ny_high_line := line.new(nz(ny_start_bar, bar_index), ny_high, bar_index + 20, ny_high, color=i_ny_border, style=session_line_style, width=1, extend=i_extend_levels ? extend.right : extend.none)
        if i_level_labels
            string lbl_text = "NY High" + (i_level_prices ? " " + format_price(ny_high) : "")
            ny_high_lbl := label.new(bar_index + label_offset, ny_high, lbl_text, style=label.style_label_left, color=color.new(i_ny_border, 80), textcolor=i_ny_border, size=get_label_size(i_label_size), tooltip="NY Session High — highest price reached during the New York session. Key resistance if price revisits.")

    // Session Low
    if i_show_ny_levels and not na(ny_low)
        line.delete(ny_low_line)
        label.delete(ny_low_lbl)
        ny_low_line := line.new(nz(ny_start_bar, bar_index), ny_low, bar_index + 20, ny_low, color=i_ny_border, style=session_line_style, width=1, extend=i_extend_levels ? extend.right : extend.none)
        if i_level_labels
            string lbl_text = "NY Low" + (i_level_prices ? " " + format_price(ny_low) : "")
            ny_low_lbl := label.new(bar_index + label_offset, ny_low, lbl_text, style=label.style_label_left, color=color.new(i_ny_border, 80), textcolor=i_ny_border, size=get_label_size(i_label_size), tooltip="NY Session Low — lowest price reached during the New York session. Key support if price revisits.")

    // Session Open
    if i_show_ny_open and not na(ny_open)
        line.delete(ny_open_line)
        label.delete(ny_open_lbl)
        ny_open_line := line.new(nz(ny_start_bar, bar_index), ny_open, bar_index + 20, ny_open, color=color.new(i_ny_border, 50), style=session_line_style, width=1, extend=i_extend_levels ? extend.right : extend.none)
        if i_level_labels
            string lbl_text = "NY Open" + (i_level_prices ? " " + format_price(ny_open) : "")
            ny_open_lbl := label.new(bar_index + label_offset, ny_open, lbl_text, style=label.style_label_left, color=color.new(i_ny_border, 90), textcolor=color.new(i_ny_border, 30), size=get_label_size(i_label_size), tooltip="NY Session Open — opening price of the New York session. Price above = session bullish, below = session bearish.")

// ══════════════════════════════════════════════════════════════════════════════
// DRAWING - SESSION EQUILIBRIUM (50% of Session Range)
// ══════════════════════════════════════════════════════════════════════════════

var line asian_eq_line = na
var label asian_eq_lbl = na
var line london_eq_line = na
var label london_eq_lbl = na
var line ny_eq_line = na
var label ny_eq_lbl = na

// Asian Equilibrium
if i_show_equilibrium and i_asian_enabled and in_asian() and not na(asian_high) and not na(asian_low) and asian_high != asian_low
    float eq_price = (asian_high + asian_low) / 2
    line.delete(asian_eq_line)
    label.delete(asian_eq_lbl)
    asian_eq_line := line.new(nz(asian_start_bar, bar_index), eq_price, bar_index + 20, eq_price, color=color.new(i_asian_border, 40), style=line.style_dashed, width=1, extend=i_extend_levels ? extend.right : extend.none)
    if i_level_labels
        string lbl_text = "ASN EQ" + (i_level_prices ? " " + format_price(eq_price) : "")
        asian_eq_lbl := label.new(bar_index + label_offset, eq_price, lbl_text, style=label.style_label_left, color=color.new(i_asian_border, 85), textcolor=color.new(i_asian_border, 20), size=get_label_size(i_label_size), tooltip="Asian Session Equilibrium — 50% of the session range. Price magnet for retracements. Re-entry opportunity in the direction of the session trend.")

// London Equilibrium
if i_show_equilibrium and i_london_enabled and in_london() and not na(london_high) and not na(london_low) and london_high != london_low
    float eq_price = (london_high + london_low) / 2
    line.delete(london_eq_line)
    label.delete(london_eq_lbl)
    london_eq_line := line.new(nz(london_start_bar, bar_index), eq_price, bar_index + 20, eq_price, color=color.new(i_london_border, 40), style=line.style_dashed, width=1, extend=i_extend_levels ? extend.right : extend.none)
    if i_level_labels
        string lbl_text = "LDN EQ" + (i_level_prices ? " " + format_price(eq_price) : "")
        london_eq_lbl := label.new(bar_index + label_offset, eq_price, lbl_text, style=label.style_label_left, color=color.new(i_london_border, 85), textcolor=color.new(i_london_border, 20), size=get_label_size(i_label_size), tooltip="London Session Equilibrium — 50% of the session range. Price magnet for retracements. Re-entry opportunity in the direction of the session trend.")

// NY Equilibrium
if i_show_equilibrium and i_ny_enabled and in_ny() and not na(ny_high) and not na(ny_low) and ny_high != ny_low
    float eq_price = (ny_high + ny_low) / 2
    line.delete(ny_eq_line)
    label.delete(ny_eq_lbl)
    ny_eq_line := line.new(nz(ny_start_bar, bar_index), eq_price, bar_index + 20, eq_price, color=color.new(i_ny_border, 40), style=line.style_dashed, width=1, extend=i_extend_levels ? extend.right : extend.none)
    if i_level_labels
        string lbl_text = "NY EQ" + (i_level_prices ? " " + format_price(eq_price) : "")
        ny_eq_lbl := label.new(bar_index + label_offset, eq_price, lbl_text, style=label.style_label_left, color=color.new(i_ny_border, 85), textcolor=color.new(i_ny_border, 20), size=get_label_size(i_label_size), tooltip="NY Session Equilibrium — 50% of the session range. Price magnet for retracements. Re-entry opportunity in the direction of the session trend.")

// ══════════════════════════════════════════════════════════════════════════════
// DRAWING - SESSION VWAP
// ══════════════════════════════════════════════════════════════════════════════

plot(i_vwap_enabled and vwap_session_active ? session_vwap : na, title="Session VWAP", color=i_vwap_color, linewidth=2, style=plot.style_line)
plot(i_vwap_enabled and i_vwap_bands and vwap_session_active ? vwap_upper : na, title="VWAP Upper", color=i_vwap_band_color, linewidth=1, style=plot.style_line)
plot(i_vwap_enabled and i_vwap_bands and vwap_session_active ? vwap_lower : na, title="VWAP Lower", color=i_vwap_band_color, linewidth=1, style=plot.style_line)

// ══════════════════════════════════════════════════════════════════════════════
// DRAWING - KILLZONES & HIGHLIGHTS
// ══════════════════════════════════════════════════════════════════════════════

// Killzone backgrounds
bgcolor(in_kz_asian() ? i_kz_color : na, title="Asian KZ")
bgcolor(in_kz_london() ? i_kz_color : na, title="London KZ")
bgcolor(in_kz_ny_am() ? i_kz_color : na, title="NY AM KZ")
bgcolor(in_kz_london_close() ? i_kz_color : na, title="London Close KZ")

// Silver Bullet backgrounds (distinct color)
bgcolor(in_silver_am() ? i_silver_color : na, title="Silver Bullet AM")
bgcolor(in_silver_pm() ? i_silver_color : na, title="Silver Bullet PM")

// Macro time highlight
bgcolor(is_macro_time() ? i_macro_color : na, title="Macro Time")

// Overlap highlight
bgcolor(i_overlap_enabled and in_overlap() ? i_overlap_color : na, title="LDN-NY Overlap")

// Optimal Trade Window indicator
plotshape(i_stats_enabled and i_stats_show_otw_marker and is_otw and is_otw[1] == false, title="OTW Start", style=shape.diamond, location=location.top, color=color.new(#00E676, 0), size=size.tiny, text="OTW")

// ─────────────────────────────────────────────────────────────────────────────
// ADAPTIVE BOUNDARY MARKERS
// ─────────────────────────────────────────────────────────────────────────────

// True Session Start Markers (when volatility confirms session is truly active)
// Asian True Start
bool asian_true_start_trigger = i_adaptive_enabled and i_show_adaptive_labels and in_asian() and not na(asian_true_start) and bar_index == asian_true_start
if asian_true_start_trigger
    label.new(bar_index, low - (nz(atr_14, low * 0.001) * 0.4), "◆",
         style=label.style_label_up,
         color=color.new(#9C27B0, 20),
         textcolor=color.white,
         size=size.tiny,
         tooltip="Asian TRUE Start - Volatility confirmed session activity")

// London True Start
bool london_true_start_trigger = i_adaptive_enabled and i_show_adaptive_labels and in_london() and not na(london_true_start) and bar_index == london_true_start
if london_true_start_trigger
    label.new(bar_index, low - (nz(atr_14, low * 0.001) * 0.4), "◆",
         style=label.style_label_up,
         color=color.new(#2196F3, 20),
         textcolor=color.white,
         size=size.tiny,
         tooltip="London TRUE Start - Volatility confirmed session activity")

// NY True Start
bool ny_true_start_trigger = i_adaptive_enabled and i_show_adaptive_labels and in_ny() and not na(ny_true_start) and bar_index == ny_true_start
if ny_true_start_trigger
    label.new(bar_index, low - (nz(atr_14, low * 0.001) * 0.4), "◆",
         style=label.style_label_up,
         color=color.new(#FF9800, 20),
         textcolor=color.white,
         size=size.tiny,
         tooltip="NY TRUE Start - Volatility confirmed session activity")

// Early Session Start Warnings
if i_adaptive_enabled and i_show_adaptive_labels and i_adaptive_early_detect
    // Asian early
    if asian_started_early and asian_start()
        label.new(bar_index, high + (nz(atr_14, high * 0.001) * 0.3), "EARLY",
             style=label.style_label_down,
             color=color.new(#9C27B0, 30),
             textcolor=color.white,
             size=size.tiny,
             tooltip="Asian started EARLY - Volatility surge detected before official open")
    // London early
    if london_started_early and london_start()
        label.new(bar_index, high + (nz(atr_14, high * 0.001) * 0.3), "EARLY",
             style=label.style_label_down,
             color=color.new(#2196F3, 30),
             textcolor=color.white,
             size=size.tiny,
             tooltip="London started EARLY - Volatility surge detected before official open")
    // NY early
    if ny_started_early and ny_start()
        label.new(bar_index, high + (nz(atr_14, high * 0.001) * 0.3), "EARLY",
             style=label.style_label_down,
             color=color.new(#FF9800, 30),
             textcolor=color.white,
             size=size.tiny,
             tooltip="NY started EARLY - Volatility surge detected before official open")

// Extended Session Markers
if i_adaptive_enabled and i_show_adaptive_labels and i_adaptive_late_detect
    // Show extended marker when session ends but activity continues
    if asian_extended and asian_end()
        label.new(bar_index, high + (nz(atr_14, high * 0.001) * 0.3), "EXT",
             style=label.style_label_down,
             color=color.new(#9C27B0, 50),
             textcolor=color.white,
             size=size.tiny,
             tooltip="Asian EXTENDED - Activity continues past official close")
    if london_extended and london_end()
        label.new(bar_index, high + (nz(atr_14, high * 0.001) * 0.3), "EXT",
             style=label.style_label_down,
             color=color.new(#2196F3, 50),
             textcolor=color.white,
             size=size.tiny,
             tooltip="London EXTENDED - Activity continues past official close")
    if ny_extended and ny_end()
        label.new(bar_index, high + (nz(atr_14, high * 0.001) * 0.3), "EXT",
             style=label.style_label_down,
             color=color.new(#FF9800, 50),
             textcolor=color.white,
             size=size.tiny,
             tooltip="NY EXTENDED - Activity continues past official close")

// ADR Exhaustion Visual Warning
// Shows warning label when ADR is 80%+ used (range may be exhausted)
bool adr_just_exhausted = adr_exhausted and not adr_exhausted[1]
if i_adr_enabled and i_adr_warn_exhaustion and adr_just_exhausted
    label.new(bar_index, high + (nz(atr_14, high * 0.001) * 0.5), "ADR 80%+",
         style=label.style_label_down,
         color=color.new(COLOR_BEAR, 20),
         textcolor=color.white,
         size=size.small,
         tooltip="ADR Exhaustion Warning: Daily range has used 80%+ of average. Expect reduced volatility or reversal.")

// ─────────────────────────────────────────────────────────────────────────────
// REGIME CHANGE MARKERS
// Logic: Show at session start (instant). During session, show when regime
// changes to something new AND holds for 3 bars (filters flicker).
// Same regime never shows twice in a row.
// ─────────────────────────────────────────────────────────────────────────────

var int regime_shown = REGIME_NONE          // Last regime we put a label for
var int regime_hold_count = 0               // How many bars current regime has held

bool is_session_start = asian_start() or london_start() or ny_start()

// Reset at session start
if is_session_start
    regime_shown := REGIME_NONE
    regime_hold_count := 0

// Count consecutive bars of same regime
if current_regime == current_regime[1] and current_regime != REGIME_NONE
    regime_hold_count += 1
else
    regime_hold_count := 0

// Show label: at session start (instant) OR after holding 3 bars (confirmed change)
bool regime_show_label = false
if i_regime_enabled and i_show_regime_labels and current_regime != REGIME_NONE and current_regime != regime_shown
    if is_session_start
        regime_show_label := true
    else if regime_hold_count >= 3
        regime_show_label := true

if regime_show_label
    regime_shown := current_regime
    string regime_label = get_regime_name(current_regime)
    color regime_col = get_regime_color(current_regime)
    string regime_tip = "Regime: " + regime_label + "\n" + get_regime_strategy(current_regime) + "\n\nEfficiency: " + str.tostring(regime_efficiency * 100, "#") + "%" + "\nVolatility Ratio: " + str.tostring(regime_volatility_ratio, "#.#") + "x" + "\nDirectional Score: " + str.tostring(regime_directional_score, "#") + "%"
    label.new(bar_index, low - (nz(atr_14, low * 0.001) * 0.5), regime_label,
         style=label.style_label_up,
         color=color.new(regime_col, 20),
         textcolor=color.white,
         size=size.tiny,
         tooltip=regime_tip)

// ─────────────────────────────────────────────────────────────────────────────
// ANOMALY DETECTION MARKERS
// ─────────────────────────────────────────────────────────────────────────────

// Track previous anomaly state to detect new anomalies
var float prev_anomaly_severity = 0.0
var int prev_anomaly_count = 0

// Detect when new significant anomaly appears (severity increased significantly or new anomaly type)
// Anomaly markers — only show when severity is HIGH (70+) and limit to one per session
var bool anomaly_shown_this_session = false

if asian_start() or london_start() or ny_start()
    anomaly_shown_this_session := false

bool new_anomaly_detected = i_anomaly_enabled and i_anomaly_show_markers and not anomaly_shown_this_session and anomaly_count >= 2 and anomaly_severity >= 70

// Show anomaly marker when detected
if new_anomaly_detected
    anomaly_shown_this_session := true
    color anomaly_marker_col = get_anomaly_color(anomaly_severity)
    string anomaly_marker = get_anomaly_marker(anomaly_severity)
    string severity_text = get_anomaly_severity_level(anomaly_severity)

    // Build actionable tooltip — tell users WHAT TO EXPECT, not just numbers
    string anomaly_tip = "⚠ SESSION ANOMALY — " + severity_text + "\n\n"

    // Add details + expectations for each active anomaly
    if anomaly_range
        anomaly_tip := anomaly_tip + "RANGE ANOMALY (Z=" + str.tostring(session_range_z_score, "#.#") + ")\n"
        anomaly_tip := anomaly_tip + (session_range_z_score > 0 ? "Session range is unusually WIDE. Expect: extended moves, potential trend day. Widen stops, don't fade." : "Session range is unusually NARROW. Expect: breakout incoming. Compression precedes expansion — watch for the trigger.") + "\n\n"
    if anomaly_volatility
        anomaly_tip := anomaly_tip + "VOLATILITY SPIKE (" + str.tostring(session_volatility_ratio, "#.#") + "x normal)\n"
        anomaly_tip := anomaly_tip + "Volatility " + str.tostring(session_volatility_ratio, "#.#") + "x above baseline. Expect: large candles, fast moves, stop hunts. Reduce position size, widen stops, avoid tight entries.\n\n"
    if anomaly_timing
        anomaly_tip := anomaly_tip + "TIMING ANOMALY\n"
        anomaly_tip := anomaly_tip + "Session high AND low formed in the same phase — unusual. Expect: choppy, directionless action. The session may be front-loaded with the real move already done.\n\n"
    if anomaly_gap
        anomaly_tip := anomaly_tip + "SESSION GAP (" + format_price(math.abs(session_open_gap)) + ")\n"
        anomaly_tip := anomaly_tip + (session_open_gap > 0 ? "Large gap UP from prior session. Expect: gap fill attempt early, then direction decision. If gap holds, bullish continuation likely." : "Large gap DOWN from prior session. Expect: gap fill attempt early, then direction decision. If gap holds, bearish continuation likely.") + "\n\n"
    if anomaly_flow
        anomaly_tip := anomaly_tip + "FLOW CONTRADICTION\n"
        anomaly_tip := anomaly_tip + "Session direction contradicts historical flow pattern. Expect: either a reversal back to the norm, or a genuine regime change. Monitor closely — this is unusual behavior.\n\n"
    if anomaly_adr
        anomaly_tip := anomaly_tip + "ADR EXHAUSTION\n"
        anomaly_tip := anomaly_tip + "Daily range consumed faster than normal. Expect: reduced volatility ahead, potential reversal. The day's move may be nearly done — avoid chasing.\n\n"

    anomaly_tip := anomaly_tip + "Action: Adjust risk management. " + str.tostring(anomaly_count) + " anomalies active — this is NOT a normal session."

    // Create marker label
    label.new(bar_index, high + (nz(atr_14, high * 0.001) * 0.4), anomaly_marker,
         style=label.style_label_down,
         color=color.new(anomaly_marker_col, 20),
         textcolor=color.white,
         size=size.small,
         tooltip=anomaly_tip)

// Update previous state
prev_anomaly_severity := anomaly_severity
prev_anomaly_count := anomaly_count

// ══════════════════════════════════════════════════════════════════════════════
// DASHBOARD - Unified View Mode System
// ══════════════════════════════════════════════════════════════════════════════
// View Modes:
//   Off       - No dashboard
//   Minimal   - Session + Bias (3 rows)
//   Status    - Session + KZ + Phase + Bias + ADR (6 rows)
//   Trade     - Session + PO3 + Regime + OTW + Target (7 rows)
//   Analytics - Session + DNA + Flow + Efficiency (8 rows)
// ══════════════════════════════════════════════════════════════════════════════

// Get current session info
int curr_sess_dash = get_session()
string sess_name_dash = get_session_name(curr_sess_dash)
color sess_color_dash = switch curr_sess_dash
    SESSION_ASIAN => color.new(#9C27B0, 0)
    SESSION_LONDON => color.new(#2196F3, 0)
    SESSION_NEWYORK => color.new(#FF9800, 0)
    SESSION_OVERLAP => color.new(#4CAF50, 0)
    => COLOR_DIM

// Pre-calculate values used by dashboard
string bias_text = session_bias > 30 ? "BULLISH" : session_bias < -30 ? "BEARISH" : "NEUTRAL"
color bias_color = session_bias > 30 ? COLOR_BULL : session_bias < -30 ? COLOR_BEAR : COLOR_NEUT
int curr_kz = get_killzone()
string kz_name = get_kz_name(curr_kz)
color kz_color = curr_kz != KZ_NONE ? (curr_kz == KZ_SILVER_AM or curr_kz == KZ_SILVER_PM ? color.new(#00E676, 0) : COLOR_NEUT) : COLOR_DIM
string phase_name = get_phase_name(momentum_phase)
color phase_color = switch momentum_phase
    PHASE_EARLY => i_momentum_early_color
    PHASE_MID => i_momentum_mid_color
    PHASE_LATE => i_momentum_late_color
    => COLOR_DIM

var table dashboard = na

if i_dash_enabled
    table.delete(dashboard)
    dashboard := table.new(get_table_position(i_dash_position), 2, 25, bgcolor=COLOR_BG, border_width=1, border_color=color.new(#333333, 0))

    int row = 0
    tsize = get_table_size(i_dash_size)

    // ═══════════════════════════════════════════════════════════════════════
    // HEADER — Mode shown in brackets after +
    // ═══════════════════════════════════════════════════════════════════════
    string mode_text = dash_minimal ? "" : dash_full ? " (FULL)" : dash_status ? " (STATUS)" : dash_trade ? " (TRADE)" : dash_analytics_view ? " (ANALYTICS)" : ""
    table.cell(dashboard, 0, row, "SESSIONS", text_color=COLOR_TEXT, text_size=tsize, bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_right)
    table.cell(dashboard, 1, row, "+" + mode_text, text_color=color.new(#00BCD4, 0), text_size=tsize, bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_left)
    row += 1

    // Session (intraday only — meaningless on Daily+)
    if is_intraday
        table.cell(dashboard, 0, row, "Session", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
        table.cell(dashboard, 1, row, sess_name_dash, text_color=sess_color_dash, text_size=tsize, text_halign=text.align_left)
        row += 1

    // ═══════════════════════════════════════════════════════════════════════
    // TOP VERDICT — Single answer for the session (All views)
    // Combines bias + DNA + energy into one plain English call
    // ═══════════════════════════════════════════════════════════════════════
    string verdict = "Analyzing..."
    color verdict_col = COLOR_DIM

    if is_intraday and curr_sess_dash != SESSION_NONE
        // ── INTRADAY VERDICT: session bias + DNA + regime ──
        float bull_strength = nz(session_bias, 0)
        float vwap_dna_verdict = calc_vwap_dna()
        bool dna_bull = vwap_dna_verdict >= 60
        bool dna_bear = vwap_dna_verdict <= 40

        string dir_text = ""
        if bull_strength > 50 and dna_bull
            dir_text := "Strong Bullish"
            verdict_col := COLOR_BULL
        else if bull_strength > 20 or dna_bull
            dir_text := "Leaning Bullish"
            verdict_col := COLOR_BULL
        else if bull_strength < -50 and dna_bear
            dir_text := "Strong Bearish"
            verdict_col := COLOR_BEAR
        else if bull_strength < -20 or dna_bear
            dir_text := "Leaning Bearish"
            verdict_col := COLOR_BEAR
        else
            dir_text := "No Clear Edge"
            verdict_col := COLOR_NEUT

        if i_regime_enabled and current_regime != REGIME_NONE
            string regime_char = switch current_regime
                REGIME_TRENDING => " — Trending"
                REGIME_RANGING  => " — Ranging"
                REGIME_VOLATILE => " — Volatile"
                REGIME_DEAD     => " — Dead"
                => ""
            verdict := dir_text + regime_char
        else
            verdict := dir_text

    else if not is_intraday
        // ── HIGHER TF VERDICT: price vs previous period levels ──
        // Use close vs previous period high/low/mid to determine trend
        float ref_high = na
        float ref_low = na
        if timeframe.isdaily
            ref_high := prev_week_high
            ref_low := prev_week_low
        else if timeframe.isweekly
            ref_high := prev_month_high
            ref_low := prev_month_low
        else
            ref_high := prev_quarter_high
            ref_low := prev_quarter_low

        if not na(ref_high) and not na(ref_low)
            float ref_mid = (ref_high + ref_low) / 2
            bool above_high = close > ref_high
            bool below_low = close < ref_low
            bool upper_half = close > ref_mid
            // Also check candle direction
            bool candle_bull = close > open
            if above_high and candle_bull
                verdict := "Strong Bullish"
                verdict_col := COLOR_BULL
            else if above_high
                verdict := "Bullish — Stalling"
                verdict_col := COLOR_NEUT
            else if below_low and not candle_bull
                verdict := "Strong Bearish"
                verdict_col := COLOR_BEAR
            else if below_low
                verdict := "Bearish — Bouncing"
                verdict_col := COLOR_NEUT
            else if upper_half and candle_bull
                verdict := "Leaning Bullish"
                verdict_col := COLOR_BULL
            else if not upper_half and not candle_bull
                verdict := "Leaning Bearish"
                verdict_col := COLOR_BEAR
            else
                verdict := "Ranging"
                verdict_col := COLOR_NEUT
        else
            verdict := "Insufficient Data"
            verdict_col := COLOR_DIM

    table.cell(dashboard, 0, row, "Verdict", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
    table.cell(dashboard, 1, row, verdict, text_color=verdict_col, text_size=tsize, text_halign=text.align_left)
    row += 1

    // ═══════════════════════════════════════════════════════════════════════
    // MINIMAL VIEW: Verdict only (above already shown)
    // ═══════════════════════════════════════════════════════════════════════
    if dash_minimal
        // Minimal already has Session + Verdict — nothing more needed
        true

    // ═══════════════════════════════════════════════════════════════════════
    // HIGHER TIMEFRAME CONTEXT (Daily, Weekly, Monthly)
    // Sessions don't apply — show level context instead
    // ═══════════════════════════════════════════════════════════════════════
    if not is_intraday and not dash_minimal
        // ── DAILY TIMEFRAME ──
        if timeframe.isdaily
            // Price vs Yesterday
            if not na(prev_day_high) and not na(prev_day_low) and not na(prev_day_close)
                string daily_ctx = close > prev_day_high ? "Above Yesterday's High" : close < prev_day_low ? "Below Yesterday's Low" : close > prev_day_close ? "Above Yesterday's Close" : "Below Yesterday's Close"
                color daily_col = close > prev_day_close ? COLOR_BULL : COLOR_BEAR
                table.cell(dashboard, 0, row, "vs Yesterday", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
                table.cell(dashboard, 1, row, daily_ctx, text_color=daily_col, text_size=tsize, text_halign=text.align_left)
                row += 1

            // Weekly position
            if not na(prev_week_high) and not na(prev_week_low)
                float wk_range = prev_week_high - prev_week_low
                float wk_pos = wk_range > 0 ? (close - prev_week_low) / wk_range * 100 : 50
                string wk_ctx = wk_pos > 75 ? "Near Weekly High" : wk_pos < 25 ? "Near Weekly Low" : "Mid Weekly Range"
                color wk_col = wk_pos > 50 ? COLOR_BULL : COLOR_BEAR
                table.cell(dashboard, 0, row, "Weekly", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
                table.cell(dashboard, 1, row, wk_ctx, text_color=wk_col, text_size=tsize, text_halign=text.align_left)
                row += 1

            // Monthly position
            if not na(prev_month_high) and not na(prev_month_low)
                float mo_range = prev_month_high - prev_month_low
                float mo_pos = mo_range > 0 ? (close - prev_month_low) / mo_range * 100 : 50
                string mo_ctx = mo_pos > 75 ? "Near Monthly High" : mo_pos < 25 ? "Near Monthly Low" : "Mid Monthly Range"
                color mo_col = mo_pos > 50 ? COLOR_BULL : COLOR_BEAR
                table.cell(dashboard, 0, row, "Monthly", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
                table.cell(dashboard, 1, row, mo_ctx, text_color=mo_col, text_size=tsize, text_halign=text.align_left)
                row += 1

        // ── WEEKLY TIMEFRAME ──
        if timeframe.isweekly
            // Price vs Last Week
            if not na(prev_week_high) and not na(prev_week_low)
                string wk_ctx = close > prev_week_high ? "Above Last Week's High" : close < prev_week_low ? "Below Last Week's Low" : close > (prev_week_high + prev_week_low) / 2 ? "Upper Half of Last Week" : "Lower Half of Last Week"
                color wk_col = close > (prev_week_high + prev_week_low) / 2 ? COLOR_BULL : COLOR_BEAR
                table.cell(dashboard, 0, row, "vs Last Week", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
                table.cell(dashboard, 1, row, wk_ctx, text_color=wk_col, text_size=tsize, text_halign=text.align_left)
                row += 1

            // Monthly position
            if not na(prev_month_high) and not na(prev_month_low)
                float mo_range = prev_month_high - prev_month_low
                float mo_pos = mo_range > 0 ? (close - prev_month_low) / mo_range * 100 : 50
                string mo_ctx = mo_pos > 75 ? "Near Monthly High" : mo_pos < 25 ? "Near Monthly Low" : "Mid Monthly Range"
                color mo_col = mo_pos > 50 ? COLOR_BULL : COLOR_BEAR
                table.cell(dashboard, 0, row, "Monthly", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
                table.cell(dashboard, 1, row, mo_ctx, text_color=mo_col, text_size=tsize, text_halign=text.align_left)
                row += 1

            // Quarterly position
            if not na(prev_quarter_high) and not na(prev_quarter_low)
                float qt_range = prev_quarter_high - prev_quarter_low
                float qt_pos = qt_range > 0 ? (close - prev_quarter_low) / qt_range * 100 : 50
                string qt_ctx = qt_pos > 75 ? "Near Quarterly High" : qt_pos < 25 ? "Near Quarterly Low" : "Mid Quarterly Range"
                color qt_col = qt_pos > 50 ? COLOR_BULL : COLOR_BEAR
                table.cell(dashboard, 0, row, "Quarterly", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
                table.cell(dashboard, 1, row, qt_ctx, text_color=qt_col, text_size=tsize, text_halign=text.align_left)
                row += 1

        // ── MONTHLY TIMEFRAME ──
        if timeframe.ismonthly
            // Price vs Last Month
            if not na(prev_month_high) and not na(prev_month_low)
                string mo_ctx = close > prev_month_high ? "Above Last Month's High" : close < prev_month_low ? "Below Last Month's Low" : close > (prev_month_high + prev_month_low) / 2 ? "Upper Half of Last Month" : "Lower Half of Last Month"
                color mo_col = close > (prev_month_high + prev_month_low) / 2 ? COLOR_BULL : COLOR_BEAR
                table.cell(dashboard, 0, row, "vs Last Month", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
                table.cell(dashboard, 1, row, mo_ctx, text_color=mo_col, text_size=tsize, text_halign=text.align_left)
                row += 1

            // Quarterly position
            if not na(prev_quarter_high) and not na(prev_quarter_low)
                float qt_range = prev_quarter_high - prev_quarter_low
                float qt_pos = qt_range > 0 ? (close - prev_quarter_low) / qt_range * 100 : 50
                string qt_ctx = qt_pos > 75 ? "Near Quarterly High" : qt_pos < 25 ? "Near Quarterly Low" : "Mid Quarterly Range"
                color qt_col = qt_pos > 50 ? COLOR_BULL : COLOR_BEAR
                table.cell(dashboard, 0, row, "Quarterly", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
                table.cell(dashboard, 1, row, qt_ctx, text_color=qt_col, text_size=tsize, text_halign=text.align_left)
                row += 1

        // ADR available on all higher TFs
        if not na(adr_used_pct)
            color adr_col = adr_used_pct >= 80 ? COLOR_BEAR : adr_used_pct >= 50 ? COLOR_NEUT : COLOR_BULL
            table.cell(dashboard, 0, row, "ADR", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
            table.cell(dashboard, 1, row, (adr_used_pct >= 80 ? "Range Exhausted" : adr_used_pct >= 60 ? "Slowing Down" : adr_used_pct >= 30 ? "Room to Move" : "Fresh Day"), text_color=adr_col, text_size=tsize, text_halign=text.align_left)
            row += 1

    // ═══════════════════════════════════════════════════════════════════════
    // STATUS VIEW: KZ + Phase + Bias + ADR (intraday only)
    // ═══════════════════════════════════════════════════════════════════════
    if (dash_status or dash_trade or dash_analytics_view) and is_intraday
        // Killzone (sub-hourly only — KZs are too short on 1H+)
        if i_layer_ict and is_sub_hourly
            table.cell(dashboard, 0, row, "Killzone", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
            table.cell(dashboard, 1, row, (kz_name == "None" ? "—" : kz_name), text_color=kz_color, text_size=tsize, text_halign=text.align_left)
            row += 1

            // KZ Effectiveness Grades (sub-hourly only)
            if i_kz_effectiveness and is_sub_hourly
                // Row 1: Session KZs (London, NY, London Close)
                string sess_grades = (kz_grade_london == "—" and kz_grade_ny == "—" and kz_grade_lc == "—") ? "Building data..." : "LDN:" + kz_grade_london + " | NY:" + kz_grade_ny + " | LC:" + kz_grade_lc
                // Use the worst grade's color as the row color for attention
                float min_sess_score = math.min(nz(kz_score_london, 50), math.min(nz(kz_score_ny, 50), nz(kz_score_lc, 50)))
                table.cell(dashboard, 0, row, "KZ Grades", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
                table.cell(dashboard, 1, row, sess_grades, text_color=get_kz_grade_color(math.avg(nz(kz_score_london, 50), nz(kz_score_ny, 50), nz(kz_score_lc, 50))), text_size=tsize, text_halign=text.align_left)
                row += 1

                // Row 2: Silver Bullet KZs (AM, PM)
                string sb_grades = (kz_grade_sb_am == "—" and kz_grade_sb_pm == "—") ? "Building data..." : "AM:" + kz_grade_sb_am + " | PM:" + kz_grade_sb_pm
                table.cell(dashboard, 0, row, "SB Grades", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
                table.cell(dashboard, 1, row, sb_grades, text_color=get_kz_grade_color(math.avg(nz(kz_score_sb_am, 50), nz(kz_score_sb_pm, 50))), text_size=tsize, text_halign=text.align_left)
                row += 1

        // Phase
        if i_layer_analytics
            table.cell(dashboard, 0, row, "Timing", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
            table.cell(dashboard, 1, row, phase_name, text_color=phase_color, text_size=tsize, text_halign=text.align_left)
            row += 1

        // Bias
        table.cell(dashboard, 0, row, "Bias", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
        table.cell(dashboard, 1, row, bias_text, text_color=bias_color, text_size=tsize, text_halign=text.align_left)
        row += 1

        // ADR
        if i_layer_levels and not na(adr_used_pct)
            color adr_col = adr_used_pct >= 80 ? COLOR_BEAR : adr_used_pct >= 50 ? COLOR_NEUT : COLOR_BULL
            string adr_warn = adr_used_pct >= 80 ? " !" : ""
            table.cell(dashboard, 0, row, "ADR", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
            table.cell(dashboard, 1, row, (adr_used_pct >= 80 ? "Range Exhausted" : adr_used_pct >= 60 ? "Slowing Down" : adr_used_pct >= 30 ? "Room to Move" : "Fresh Day"), text_color=adr_col, text_size=tsize, text_halign=text.align_left)
            row += 1

        // Activity (adaptive detection — always runs on sub-hourly)
        if i_adaptive_enabled
            color act_col = session_activity_score >= 70 ? COLOR_BULL : session_activity_score >= 40 ? COLOR_NEUT : COLOR_DIM
            string act_lvl = session_activity_score >= 70 ? "Active" : session_activity_score >= 40 ? "Normal" : "Quiet"
            table.cell(dashboard, 0, row, "Activity", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
            table.cell(dashboard, 1, row, act_lvl, text_color=act_col, text_size=tsize, text_halign=text.align_left)
            row += 1

    // ═══════════════════════════════════════════════════════════════════════
    // TRADE VIEW: PO3 + Energy (intraday only)
    // ═══════════════════════════════════════════════════════════════════════
    if dash_trade and is_intraday
        // Power of 3
        if i_layer_ict and po3_session_active
            color po3_col = switch po3_phase
                PO3_ACCUMULATION => color.new(#2196F3, 0)
                PO3_MANIPULATION => color.new(#FF9800, 0)
                PO3_DISTRIBUTION => color.new(#4CAF50, 0)
                => COLOR_DIM
            table.cell(dashboard, 0, row, "PO3", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
            table.cell(dashboard, 1, row, (po3_phase == 0 ? "—" : get_po3_name(po3_phase)), text_color=po3_col, text_size=tsize, text_halign=text.align_left)
            row += 1







        // Session Score (live energy rating)
        if i_score_enabled and not na(session_score)
            color score_col = session_score >= 70 ? COLOR_BULL : session_score >= 40 ? COLOR_NEUT : COLOR_BEAR
            string score_text = session_score >= 70 ? "High Energy" : session_score >= 40 ? "Moderate" : "Low Energy"
            table.cell(dashboard, 0, row, "Energy", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
            table.cell(dashboard, 1, row, score_text, text_color=score_col, text_size=tsize, text_halign=text.align_left)
            row += 1



        // Session Range Projections (replaces AI Projection - fixed targets set at session start)
        // Also show during overlap if NY projection is active
        bool srp_matches_session = srp_session == curr_sess_dash or (curr_sess_dash == SESSION_OVERLAP and srp_session == SESSION_NEWYORK)
        if i_range_proj_enabled and srp_session != SESSION_NONE and srp_matches_session
            // High target with hit status (full color, slightly dimmed when hit)
            string high_hit_str = srp_high_hit ? "✓ " : ""
            color high_col = srp_high_hit ? color.new(COLOR_BULL, 20) : COLOR_BULL
            table.cell(dashboard, 0, row, "Proj High", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
            table.cell(dashboard, 1, row, high_hit_str + format_price(srp_high), text_color=high_col, text_size=tsize, text_halign=text.align_left)
            row += 1
            
            // Low target with hit status (full color, slightly dimmed when hit)
            string low_hit_str = srp_low_hit ? "✓ " : ""
            color low_col = srp_low_hit ? color.new(COLOR_BEAR, 20) : COLOR_BEAR
            table.cell(dashboard, 0, row, "Proj Low", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
            table.cell(dashboard, 1, row, low_hit_str + format_price(srp_low), text_color=low_col, text_size=tsize, text_halign=text.align_left)
            row += 1
            
            // Confidence
            if not na(srp_confidence)
                color conf_col = srp_confidence >= 70 ? COLOR_BULL : srp_confidence >= 50 ? COLOR_NEUT : COLOR_BEAR
                table.cell(dashboard, 0, row, "Proj Conf", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
                table.cell(dashboard, 1, row, str.tostring(srp_confidence, "#") + "%", text_color=conf_col, text_size=tsize, text_halign=text.align_left)
                row += 1

    // ═══════════════════════════════════════════════════════════════════════
    // ANALYTICS VIEW: DNA + Flow + Efficiency (intraday only)
    // ═══════════════════════════════════════════════════════════════════════
    if dash_analytics_view and is_intraday
        // Range vs Avg
        if i_layer_analytics and not na(range_vs_avg)
            table.cell(dashboard, 0, row, "Range", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
            table.cell(dashboard, 1, row, (range_vs_avg > 20 ? "Expanding" : range_vs_avg > 0 ? "Above Average" : range_vs_avg > -20 ? "Below Average" : "Compressed"), text_color=range_vs_avg > 20 ? COLOR_BULL : range_vs_avg < -20 ? COLOR_BEAR : COLOR_NEUT, text_size=tsize, text_halign=text.align_left)
            row += 1

        // Efficiency
        if i_layer_analytics
            float curr_eff = switch curr_sess_dash
                SESSION_ASIAN => avg_asian_eff
                SESSION_LONDON => avg_london_eff
                SESSION_NEWYORK => avg_ny_eff
                SESSION_OVERLAP => avg_ny_eff
                => na
            if not na(curr_eff)
                table.cell(dashboard, 0, row, "Efficiency", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
                table.cell(dashboard, 1, row, (curr_eff > 60 ? "Clean Move" : curr_eff > 40 ? "Moderate" : "Choppy"), text_color=curr_eff > 50 ? COLOR_BULL : COLOR_NEUT, text_size=tsize, text_halign=text.align_left)
                row += 1

        // DNA Live — real-time VWAP read (updates every bar)
        if i_dna_enabled and curr_sess_dash != SESSION_NONE
            float cc_dna = calc_vwap_dna()
            string dna_pred = cc_dna >= 60 ? "▲ Bullish" : cc_dna <= 40 ? "▼ Bearish" : "◆ Neutral"
            color dna_pred_col = cc_dna >= 60 ? COLOR_BULL : cc_dna <= 40 ? COLOR_BEAR : COLOR_NEUT
            table.cell(dashboard, 0, row, "DNA (Live)", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
            table.cell(dashboard, 1, row, dna_pred, text_color=dna_pred_col, text_size=tsize, text_halign=text.align_left)
            row += 1

        // Flow
        if i_layer_analytics and not na(ny_continuation_pct)
            // Determine London's direction for context
            bool ldn_was_bull = not na(london_open) and not na(london_high) and not na(london_low) and close > london_open
            string flow_text = ny_continuation_pct > 60 ? (ldn_was_bull ? "NY likely bullish" : "NY likely bearish") : ny_continuation_pct < 40 ? (ldn_was_bull ? "NY may reverse" : "NY may bounce") : "No clear pattern"
            table.cell(dashboard, 0, row, "Flow", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
            table.cell(dashboard, 1, row, flow_text, text_color=ny_continuation_pct > 60 ? COLOR_BULL : ny_continuation_pct < 40 ? COLOR_BEAR : COLOR_NEUT, text_size=tsize, text_halign=text.align_left)
            row += 1

        // Anomaly Detection
        if i_anomaly_enabled and curr_sess_dash != SESSION_NONE
            // Anomaly count and severity
            color anomaly_dash_col = get_anomaly_color(anomaly_severity)
            string anomaly_status = anomaly_count > 0 ? str.tostring(anomaly_count) + " Active" : "None"
            table.cell(dashboard, 0, row, "Anomalies", text_color=COLOR_DIM, text_size=tsize, text_halign=text.align_right)
            table.cell(dashboard, 1, row, anomaly_status, text_color=anomaly_dash_col, text_size=tsize, text_halign=text.align_left)
            row += 1

            // If anomalies detected, show primary type
            if anomaly_count > 0
                string severity_lvl = get_anomaly_severity_level(anomaly_severity)
                table.cell(dashboard, 0, row, "Warning", text_color=anomaly_dash_col, text_size=tsize, text_halign=text.align_right)
                table.cell(dashboard, 1, row, (anomaly_primary_type == "ADR" ? "Daily range used up" : anomaly_primary_type == "Range" ? "Unusual session range" : anomaly_primary_type == "Volatility" ? "Extreme volatility" : anomaly_primary_type == "Gap" ? "Large session gap" : anomaly_primary_type == "Flow" ? "Against the flow" : anomaly_primary_type == "Timing" ? "Unusual timing" : anomaly_primary_type), text_color=anomaly_dash_col, text_size=tsize, text_halign=text.align_left)
                row += 1

// ══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════════════════════════════════════════

// Session alerts
alertcondition(asian_start() and i_alert_session_start, title="Asian Start", message="Asian session started")
alertcondition(london_start() and i_alert_session_start, title="London Start", message="London session started")
alertcondition(ny_start() and i_alert_session_start, title="NY Start", message="New York session started")

// Killzone alerts
alertcondition(kz_london_start() and i_alert_killzone_start, title="London KZ", message="London Open Killzone active")
alertcondition(kz_ny_am_start() and i_alert_killzone_start, title="NY AM KZ", message="NY AM Killzone active")

// Silver Bullet alerts
alertcondition(silver_am_start() and i_alert_silver_bullet, title="Silver Bullet AM", message="Silver Bullet AM window open (10:00-11:00 NY)")
alertcondition(silver_pm_start() and i_alert_silver_bullet, title="Silver Bullet PM", message="Silver Bullet PM window open (14:00-15:00 NY)")

// KZ Effectiveness alerts (high-grade killzone entered)
bool kz_high_grade_entry = i_kz_effectiveness and kz_just_started and not na(kz_current_score) and kz_current_score >= 80
bool kz_low_grade_warning = i_kz_effectiveness and kz_just_started and not na(kz_current_score) and kz_current_score < 60 and kz_current_score > 0
alertcondition(kz_high_grade_entry and i_alert_killzone_start, title="KZ High Grade", message="High-grade Killzone entered (A/A+ rating) - High probability setup")
alertcondition(kz_low_grade_warning and i_alert_killzone_start, title="KZ Low Grade", message="Low-grade Killzone entered (C/D rating) - Use caution")

// Opening Range alerts
alertcondition(or_break_high and i_alert_or_break, title="OR Break High", message="Opening Range High broken")
alertcondition(or_break_low and i_alert_or_break, title="OR Break Low", message="Opening Range Low broken")

// ADR alert
alertcondition(adr_exhausted and not adr_exhausted[1] and i_alert_adr_exhaustion, title="ADR Exhausted", message="ADR 80%+ used - Potential range exhaustion")

// Power of 3 alerts
alertcondition(po3_phase_changed and po3_phase == PO3_MANIPULATION and i_alert_po3_phase, title="PO3 Manipulation", message="Power of 3: Manipulation phase")
alertcondition(po3_phase_changed and po3_phase == PO3_DISTRIBUTION and i_alert_po3_phase, title="PO3 Distribution", message="Power of 3: Distribution/Expansion phase")

// Macro time alert
alertcondition(macro_start() and i_alert_macro_time, title="Macro Time", message="ICT Macro time window - High probability reversal")

// Session DNA high-confidence signal alerts (split for const string requirement)
bool dna_bullish_signal = i_dna_enabled and not na(dna_bull_prob) and dna_bull_prob >= 75
bool dna_bearish_signal = i_dna_enabled and not na(dna_bull_prob) and dna_bull_prob <= 25
alertcondition(dna_bullish_signal and not dna_bullish_signal[1] and i_alert_dna_signal, title="DNA Signal Bullish", message="High-confidence DNA pattern: BULLISH bias detected")
alertcondition(dna_bearish_signal and not dna_bearish_signal[1] and i_alert_dna_signal, title="DNA Signal Bearish", message="High-confidence DNA pattern: BEARISH bias detected")

// Session Range Projection alerts
bool range_proj_high_hit = i_range_proj_enabled and srp_high_hit and not srp_high_hit[1]
bool range_proj_low_hit = i_range_proj_enabled and srp_low_hit and not srp_low_hit[1]
bool range_proj_both_hit = i_range_proj_enabled and srp_high_hit and srp_low_hit and (not srp_high_hit[1] or not srp_low_hit[1])

alertcondition(range_proj_high_hit, title="Proj High Reached", message="Session Range Projection: Projected HIGH target REACHED")
alertcondition(range_proj_low_hit, title="Proj Low Reached", message="Session Range Projection: Projected LOW target REACHED")
alertcondition(range_proj_both_hit, title="Proj Range Complete", message="Session Range Projection: Both targets HIT - Full projected range achieved")

// Adaptive boundary alerts
bool asian_true_start_alert = i_adaptive_enabled and in_asian() and not na(asian_true_start) and bar_index == asian_true_start
bool london_true_start_alert = i_adaptive_enabled and in_london() and not na(london_true_start) and bar_index == london_true_start
bool ny_true_start_alert = i_adaptive_enabled and in_ny() and not na(ny_true_start) and bar_index == ny_true_start

alertcondition(asian_true_start_alert, title="Asian True Start", message="Asian session TRULY active - Volatility confirmed")
alertcondition(london_true_start_alert, title="London True Start", message="London session TRULY active - Volatility confirmed")
alertcondition(ny_true_start_alert, title="NY True Start", message="NY session TRULY active - Volatility confirmed")

// Early session alerts
bool asian_early_alert = i_adaptive_enabled and i_adaptive_early_detect and asian_started_early and asian_start()
bool london_early_alert = i_adaptive_enabled and i_adaptive_early_detect and london_started_early and london_start()
bool ny_early_alert = i_adaptive_enabled and i_adaptive_early_detect and ny_started_early and ny_start()

alertcondition(asian_early_alert, title="Asian Early Start", message="Asian session started EARLY - Pre-session volatility detected")
alertcondition(london_early_alert, title="London Early Start", message="London session started EARLY - Pre-session volatility detected")
alertcondition(ny_early_alert, title="NY Early Start", message="NY session started EARLY - Pre-session volatility detected")

// Extended session alerts
bool asian_ext_alert = i_adaptive_enabled and i_adaptive_late_detect and asian_extended and asian_end()
bool london_ext_alert = i_adaptive_enabled and i_adaptive_late_detect and london_extended and london_end()
bool ny_ext_alert = i_adaptive_enabled and i_adaptive_late_detect and ny_extended and ny_end()

alertcondition(asian_ext_alert, title="Asian Extended", message="Asian session EXTENDED - Activity continues past close")
alertcondition(london_ext_alert, title="London Extended", message="London session EXTENDED - Activity continues past close")
alertcondition(ny_ext_alert, title="NY Extended", message="NY session EXTENDED - Activity continues past close")

// Regime change alerts
bool regime_to_trending = i_regime_enabled and current_regime == REGIME_TRENDING and prev_regime != REGIME_TRENDING and prev_regime != REGIME_NONE
bool regime_to_ranging = i_regime_enabled and current_regime == REGIME_RANGING and prev_regime != REGIME_RANGING and prev_regime != REGIME_NONE
bool regime_to_volatile = i_regime_enabled and current_regime == REGIME_VOLATILE and prev_regime != REGIME_VOLATILE and prev_regime != REGIME_NONE
bool regime_to_dead = i_regime_enabled and current_regime == REGIME_DEAD and prev_regime != REGIME_DEAD and prev_regime != REGIME_NONE

alertcondition(regime_to_trending and i_alert_regime_change, title="Regime: Trending", message="Session regime changed to TRENDING - Trend following strategies recommended")
alertcondition(regime_to_ranging and i_alert_regime_change, title="Regime: Ranging", message="Session regime changed to RANGING - Mean reversion strategies recommended")
alertcondition(regime_to_volatile and i_alert_regime_change, title="Regime: Volatile", message="Session regime changed to VOLATILE - Use caution and wide stops")
alertcondition(regime_to_dead and i_alert_regime_change, title="Regime: Dead", message="Session regime changed to DEAD - Low activity; avoid trading or wait for breakout")

// Anomaly detection alerts
bool anomaly_critical = i_anomaly_enabled and anomaly_severity >= 80 and anomaly_severity[1] < 80
bool anomaly_warning = i_anomaly_enabled and anomaly_severity >= 50 and anomaly_severity < 80 and anomaly_severity[1] < 50
bool anomaly_range_alert = i_anomaly_enabled and anomaly_range and not anomaly_range[1]
bool anomaly_volatility_alert = i_anomaly_enabled and anomaly_volatility and not anomaly_volatility[1]
bool anomaly_gap_alert = i_anomaly_enabled and anomaly_gap and not anomaly_gap[1]
bool anomaly_flow_alert = i_anomaly_enabled and anomaly_flow and not anomaly_flow[1]

alertcondition(anomaly_critical, title="Anomaly: Critical", message="CRITICAL Session Anomaly Detected - Unusual market behavior, exercise extreme caution")
alertcondition(anomaly_warning, title="Anomaly: Warning", message="Session Anomaly Warning - Unusual behavior detected, monitor closely")
alertcondition(anomaly_range_alert, title="Anomaly: Range", message="Range Anomaly - Session range significantly different from historical average")
alertcondition(anomaly_volatility_alert, title="Anomaly: Volatility", message="Volatility Anomaly - Sudden volatility spike detected")
alertcondition(anomaly_gap_alert, title="Anomaly: Gap", message="Gap Anomaly - Significant gap from previous session detected")
alertcondition(anomaly_flow_alert, title="Anomaly: Flow", message="Flow Anomaly - Session direction contradicts historical flow tendency")

// ══════════════════════════════════════════════════════════════════════════════
// DATA EXPORT (For external integration)
// Reduced to essential exports only - staying within Pine Script's 64 plot limit
// External indicators can derive other values from these core metrics
// ══════════════════════════════════════════════════════════════════════════════

// Core Session Data (essential identifiers only)
plot(i_export_enabled ? get_session() : na, title="Export: Session ID", display=display.none)
plot(i_export_enabled ? get_killzone() : na, title="Export: Killzone ID", display=display.none)
plot(i_export_enabled ? session_bias : na, title="Export: Session Bias", display=display.none)
plot(i_export_enabled ? adr_used_pct : na, title="Export: ADR Used %", display=display.none)
plot(i_export_enabled and i_regime_enabled ? current_regime : na, title="Export: Regime ID", display=display.none)

// Note: Following exports removed to stay within 64 plot limit:
// - KZ Score (derive from KZ ID + price action)
// - ADR Value (use ADR Used % with chart ATR)
// - PO3 Phase (derive from session timing)
// - SRP High/Low/Conf (available via chart levels, not needed as data export)

// ══════════════════════════════════════════════════════════════════════════════
// END OF INDICATOR
