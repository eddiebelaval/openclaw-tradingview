//@version=6
indicator("BB + EMA 200 Breakout System (Selectable Exit)", overlay = true)

// === Inputs ===
bbLength = input.int(20, "BB Length")
bbStd    = input.float(2.0, "BB Std Dev")
emaLen   = input.int(200, "EMA Length")

exitType = input.string("Lower Band Exit", 
     options = ["Lower Band Exit", "Middle Band Exit"],
     title = "Close Condition Type")

// === Bollinger Bands ===
basis   = ta.sma(close, bbLength)
dev     = bbStd * ta.stdev(close, bbLength)
upperBB = basis + dev
lowerBB = basis - dev

// === EMA 200 ===
ema200 = ta.ema(close, emaLen)

// === Entry Conditions ===
longEntryRaw  = close > ema200 and close > upperBB and close[1] > upperBB[1] and close[2] > upperBB[2]
shortEntryRaw = close < ema200 and close < lowerBB and close[1] < lowerBB[1] and close[2] < lowerBB[2]

// === State ===
var int state = 0

longEntry  = longEntryRaw  and state != 1
shortEntry = shortEntryRaw and state != -1

// === Selectable Close Logic ===
closeLong = false
closeShort = false

if exitType == "Lower Band Exit"
    closeLong  := state == 1 and close < lowerBB
    closeShort := state == -1 and close > upperBB

if exitType == "Middle Band Exit"
    closeLong  := state == 1 and close < basis
    closeShort := state == -1 and close > basis

// === State Switching ===
if longEntry
    state := 1
else if shortEntry
    state := -1
else if closeLong or closeShort
    state := 0

// === Chart Arrows ===
plotshape(longEntry,
     location=location.belowbar,
     style=shape.arrowup,
     color=color.lime,
     size=size.small,
     text="LONG")

plotshape(closeLong,
     location=location.abovebar,
     style=shape.xcross,
     color=color.yellow,
     size=size.small,
     text="CLOSE LONG")

plotshape(shortEntry,
     location=location.abovebar,
     style=shape.arrowdown,
     color=color.red,
     size=size.small,
     text="SHORT")

plotshape(closeShort,
     location=location.belowbar,
     style=shape.xcross,
     color=color.orange,
     size=size.small,
     text="CLOSE SHORT")

// === CSV Export Columns (Exportable but Invisible) ===
longPrice       = longEntry  ? close : na
closeLongPrice  = closeLong  ? close : na
shortPrice      = shortEntry ? close : na
closeShortPrice = closeShort ? close : na

plot(longPrice,       title="Long",        color=color.new(color.green, 100))
plot(closeLongPrice,  title="Close Long",  color=color.new(color.yellow, 100))
plot(shortPrice,      title="Short",       color=color.new(color.red, 100))
plot(closeShortPrice, title="Close Short", color=color.new(color.orange, 100))
