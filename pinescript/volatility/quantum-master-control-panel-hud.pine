//@version=6
indicator("Quantum Master Control Panel [HUD]", "Quant_Master_HUD", overlay=true)

// =============================================================================
// 1. SETTINGS
// =============================================================================
grp_acc = "Account & Risk Management"
acc_bal = input.float(2000.0, "Account Balance ($)", group=grp_acc)
risk_pc = input.float(2.5, "Risk Per Trade (%)", step=0.5, group=grp_acc)

grp_dyn = "Volatility & Asset Settings"
atr_len = input.int(14, "ATR Length", group=grp_dyn)
atr_mul = input.float(1.5, "ATR Stop Loss Multiplier", step=0.5, group=grp_dyn)
tick_v  = input.float(100.0, "Value of $1.00 move per 1.0 Lot ($)", group=grp_dyn, tooltip="XAUUSD standard is $100 per $1.00 move (1 Lot). Adjust for your broker.")

grp_rci = "RCI Settings (Heatmap)"
rci_len = input.int(10, "RCI Length", group=grp_rci)

grp_mac = "Macro Alignment (Heatmap)"
ema_len = input.int(200, "Macro Trend EMA", group=grp_mac)

grp_vis = "HUD Visuals"
hud_pos = input.string("Bottom Right", "Panel Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=grp_vis)

// =============================================================================
// 2. MATHEMATICS & MULTI-TIMEFRAME ENGINE
// =============================================================================
// Risk Math (Calculated on the chart's current timeframe)
float current_atr = ta.atr(atr_len)
float dynamic_sl_points = current_atr * atr_mul
float risk_usd = acc_bal * (risk_pc / 100.0)
float lot_size = risk_usd / (dynamic_sl_points * tick_v)
float safe_lot = math.max(0.01, lot_size)

// Functions for MTF Data Retrieval
f_rci(len) => ta.rci(close, len)
f_ema_state(len) => close > ta.ema(close, len)

// Secure MTF Data Calls (1m, 5m, 15m, 1h)
float rci_1m  = request.security(syminfo.tickerid, "1",  f_rci(rci_len))
float rci_5m  = request.security(syminfo.tickerid, "5",  f_rci(rci_len))
float rci_15m = request.security(syminfo.tickerid, "15", f_rci(rci_len))
float rci_1h  = request.security(syminfo.tickerid, "60", f_rci(rci_len))

bool ema_1m  = request.security(syminfo.tickerid, "1",  f_ema_state(ema_len))
bool ema_5m  = request.security(syminfo.tickerid, "5",  f_ema_state(ema_len))
bool ema_15m = request.security(syminfo.tickerid, "15", f_ema_state(ema_len))
bool ema_1h  = request.security(syminfo.tickerid, "60", f_ema_state(ema_len))

// =============================================================================
// 3. HUD RENDERING (THE MASTER TABLE)
// =============================================================================
var table hud = table.new(
     hud_pos == "Top Right" ? position.top_right : 
     hud_pos == "Bottom Right" ? position.bottom_right : 
     hud_pos == "Top Left" ? position.top_left : position.bottom_left, 
     columns=3, rows=11, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.new(color.gray, 80))

color c_head = color.new(color.blue, 80)
color c_text = color.white
color c_bull = #00FFFF // Cyan for Bullish
color c_bear = #FF00FF // Fuchsia for Bearish
color c_val  = color.yellow

if barstate.islast
    // --- SECTION 1: RISK MANAGER ---
    table.cell(hud, 0, 0, "QUANTUM MASTER HUD", text_color=c_text, text_halign=text.align_center, bgcolor=c_head, text_size=size.small)
    table.merge_cells(hud, 0, 0, 2, 0)
    
    table.cell(hud, 0, 1, "Balance:", text_color=c_text, text_halign=text.align_left, text_size=size.small)
    table.cell(hud, 1, 1, "$" + str.tostring(acc_bal, "#.##"), text_color=c_text, text_halign=text.align_right, text_size=size.small)
    table.merge_cells(hud, 1, 1, 2, 1)
    
    table.cell(hud, 0, 2, "Risk (" + str.tostring(risk_pc) + "%):", text_color=c_text, text_halign=text.align_left, text_size=size.small)
    table.cell(hud, 1, 2, "-$" + str.tostring(risk_usd, "#.##"), text_color=c_bear, text_halign=text.align_right, text_size=size.small)
    table.merge_cells(hud, 1, 2, 2, 2)
    
    table.cell(hud, 0, 3, "Dynamic SL:", text_color=c_text, text_halign=text.align_left, text_size=size.small)
    table.cell(hud, 1, 3, str.tostring(dynamic_sl_points, "#.##") + " pts", text_color=c_bear, text_halign=text.align_right, text_size=size.small)
    table.merge_cells(hud, 1, 3, 2, 3)
    
    table.cell(hud, 0, 4, "LOT SIZE:", text_color=c_text, text_halign=text.align_left, text_size=size.normal)
    table.cell(hud, 1, 4, str.tostring(safe_lot, "#.##"), text_color=c_val, text_halign=text.align_right, text_size=size.normal)
    table.merge_cells(hud, 1, 4, 2, 4)

    // --- SECTION 2: MTF HEATMAP ---
    table.cell(hud, 0, 5, "MTF CONFLUENCE", text_color=c_text, text_halign=text.align_center, bgcolor=c_head, text_size=size.small)
    table.merge_cells(hud, 0, 5, 2, 5)
    
    table.cell(hud, 0, 6, "TF", text_color=color.gray, text_size=size.small)
    table.cell(hud, 1, 6, "RCI STATE", text_color=color.gray, text_size=size.small)
    table.cell(hud, 2, 6, "MACRO (EMA)", text_color=color.gray, text_size=size.small)
    
    // 1m Row
    table.cell(hud, 0, 7, "1m", text_color=c_text, text_size=size.small)
    table.cell(hud, 1, 7, rci_1m > 0 ? "BULL" : "BEAR", text_color=rci_1m > 0 ? c_bull : c_bear, text_size=size.small)
    table.cell(hud, 2, 7, ema_1m ? "BULL" : "BEAR", text_color=ema_1m ? c_bull : c_bear, text_size=size.small)
    
    // 5m Row
    table.cell(hud, 0, 8, "5m", text_color=c_text, text_size=size.small)
    table.cell(hud, 1, 8, rci_5m > 0 ? "BULL" : "BEAR", text_color=rci_5m > 0 ? c_bull : c_bear, text_size=size.small)
    table.cell(hud, 2, 8, ema_5m ? "BULL" : "BEAR", text_color=ema_5m ? c_bull : c_bear, text_size=size.small)
    
    // 15m Row
    table.cell(hud, 0, 9, "15m", text_color=c_text, text_size=size.small)
    table.cell(hud, 1, 9, rci_15m > 0 ? "BULL" : "BEAR", text_color=rci_15m > 0 ? c_bull : c_bear, text_size=size.small)
    table.cell(hud, 2, 9, ema_15m ? "BULL" : "BEAR", text_color=ema_15m ? c_bull : c_bear, text_size=size.small)
    
    // 1h Row
    table.cell(hud, 0, 10, "1h", text_color=c_text, text_size=size.small)
    table.cell(hud, 1, 10, rci_1h > 0 ? "BULL" : "BEAR", text_color=rci_1h > 0 ? c_bull : c_bear, text_size=size.small)
    table.cell(hud, 2, 10, ema_1h ? "BULL" : "BEAR", text_color=ema_1h ? c_bull : c_bear, text_size=size.small)
