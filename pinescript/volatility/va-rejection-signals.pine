//@version=6
indicator("VA Rejection Signals", overlay=true)

// --- Settings & Inputs ---
lookback      = input.int(30, "Volume Profile Lookback")
va_mult       = input.float(1.0, "VA Width Multiplier")
use_time_filter = input.bool(true, "Signal Only During High Volume Hours?")

// --- Session Filters (Institutional Hours) ---
is_high_vol_time = not na(time(timeframe.period, "0930-1130,1330-1600:23456"))

// --- Volume Profile Logic (VWAP Based) ---
vwap_val      = ta.vwap(hlc3)
price_stddev  = ta.stdev(close, lookback)
// Per user instructions: VAH is Green, VAL is Red
vah = vwap_val + (price_stddev * va_mult) 
val = vwap_val - (price_stddev * va_mult) 

// --- Signal Logic ---
// BUY: Low went below VAL (Red line), but candle closed back above it + Bullish candle
signal_buy  = low < val and close > val and close > open and (use_time_filter ? is_high_vol_time : true)

// SELL: High went above VAH (Green line), but candle closed back below it + Bearish candle
signal_sell = high > vah and close < vah and close < open and (use_time_filter ? is_high_vol_time : true)

// --- Visuals ---
// Plot the Value Area lines
plot(vah, "VAH (Green)", color=color.new(color.green, 50), linewidth=2) 
plot(val, "VAL (Red)", color=color.new(color.red, 50), linewidth=2)

// Display Labels for Manual Trading
plotshape(signal_buy, "BUY Signal", shape.labelup, location.belowbar, color.green, size=size.small, text="BUY", textcolor=color.white)
plotshape(signal_sell, "SELL Signal", shape.labeldown, location.abovebar, color.red, size=size.small, text="SELL", textcolor=color.white)

// Visualizing the High-Volume Window (Blue background)
bgcolor(use_time_filter and is_high_vol_time ? color.new(color.blue, 96) : na)

// --- Alerts ---
// These allow you to get a notification on your phone/desktop when a signal appears
alertcondition(signal_buy, title="New BUY Signal", message="VA Rejection BUY: Price rejected VAL")
alertcondition(signal_sell, title="New SELL Signal", message="VA Rejection SELL: Price rejected VAH")
