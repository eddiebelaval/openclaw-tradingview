//@version=6
indicator(title="ATR+ (Stop Loss Indicator)", shorttitle="ATR+", overlay=false)

// Import Zen library
import ZenAndTheArtOfTrading/ZenLibrary/9 as zen

//────────────────────────────────────────────────────────────────────
// Inputs
//────────────────────────────────────────────────────────────────────
length    = input.int(title="ATR Length", defval=14, minval=1)
smoothing = input.string(title="ATR Smoothing", defval="RMA", options=["RMA","SMA","EMA","WMA"])

riskratio      = input.float(title="R/R", defval=1, minval=0.1, tooltip="Risk:Reward profile")
lookback       = input.int(title="Lookback", defval=3, minval=1, tooltip="How many bars to look back for highs/lows")
stopSizeInput  = input.float(title="Stop Distance (in pips or ATR)", defval=1.0, minval=0.0, tooltip="Stop loss distance (pips or ATR multiplier)")
stopSizeUseATR = input.bool(title="Use ATR Multiplier for stop loss", defval=true, tooltip="Turns on/off the ATR multiplier / pip-based stop loss")

grpV        = "Visual"
showTargets = input.bool(false, "Show Target Sizes (Long/Short)", group=grpV)

// Table
grpT         = "Table"
showTable    = input.bool(true, "Show ATR Table", group=grpT)
posInput     = input.string("Top Right", "Table Position", options=["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right","Middle Left","Top Center","Bottom Center","Middle Center"], group=grpT)
txtSizeInput = input.string("Normal", "Text Size", options=["Tiny","Small","Normal","Large","Huge"], group=grpT)

// Display rules:
// - Only ATR is eligible for Status Line
dispNoStatus = display.pane + display.data_window
dispATRStat  = display.status_line + display.data_window

//────────────────────────────────────────────────────────────────────
// ATR
//────────────────────────────────────────────────────────────────────
ma_function(source, len) =>
    switch smoothing
        "RMA" => ta.rma(source, len)
        "SMA" => ta.sma(source, len)
        "EMA" => ta.ema(source, len)
        => ta.wma(source, len)

atrValue   = ma_function(ta.tr(true), length)
atrPercent = 100.0 * atrValue / close
atrPane    = zen.toWhole(atrValue)

// Use the exact color + transparency values from your reference script
atrColor  = color.new(#e02222, 0)  // table value font red
atrpColor = color.new(#9a27cb, 0)  // table value font purple

atrBg  = color.new(#b71c1c, 62)    // table value backdrop red
atrpBg = color.new(#7b1fa2, 62)    // table value backdrop purple

titleCol = color.rgb(255, 255, 255, 16)  // table title font (white, same alpha)

// Status line colors (original red/purple as in the reference)
plot(atrPercent, title="ATR %", color=#7b1fa2, style=plot.style_line, linewidth=1,
     display=display.status_line, format=format.percent, precision=2)

plot(atrValue, title="ATR", color=color.new(#B71C1C, 0), style=plot.style_line, linewidth=2,
     display=dispATRStat)

plot(atrPane, title="ATR (Pane)", color=color.new(#B71C1C, 0), style=plot.style_line, linewidth=2,
     display=display.pane, precision=2, linestyle=plot.linestyle_dotted)

//────────────────────────────────────────────────────────────────────
// ATR+ Stop/Size logic
//────────────────────────────────────────────────────────────────────
stopSize = zen.toPips(stopSizeInput)
if stopSizeUseATR
    stopSize := atrValue * stopSizeInput

longEntrySize  = zen.toWhole(close - ta.lowest(low, lookback) + stopSize)
shortEntrySize = zen.toWhole(ta.highest(high, lookback) - close + stopSize)

longTargetSize  = longEntrySize * riskratio
shortTargetSize = shortEntrySize * riskratio

// Entry sizes (solid, 2pt, 100% opacity, NOT in status line)
plot(longEntrySize,  title="Long Entry Size",  color=color.new(color.green, 0), style=plot.style_line, linewidth=2,
     display=dispNoStatus, precision=2)
plot(shortEntrySize, title="Short Entry Size", color=color.new(color.red,   0), style=plot.style_line, linewidth=2,
     display=dispNoStatus, precision=2)

// Targets (hidden by default, solid, 1pt, NOT in status line)
plot(showTargets ? longTargetSize  : na, title="Long Target Size",  color=color.new(color.green, 0), style=plot.style_line, linewidth=1,
     display=dispNoStatus, precision=2)
plot(showTargets ? shortTargetSize : na, title="Short Target Size", color=color.new(color.red,   0), style=plot.style_line, linewidth=1,
     display=dispNoStatus, precision=2)

//────────────────────────────────────────────────────────────────────
// Table (ATR / ATR% / Long Entry / Short Entry)
//────────────────────────────────────────────────────────────────────
tblPos = switch posInput
    "Top Right"     => position.top_right
    "Top Left"      => position.top_left
    "Bottom Right"  => position.bottom_right
    "Bottom Left"   => position.bottom_left
    "Middle Right"  => position.middle_right
    "Middle Left"   => position.middle_left
    "Top Center"    => position.top_center
    "Bottom Center" => position.bottom_center
    => position.middle_center

txtSize = switch txtSizeInput
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large
    => size.huge

// Long/Short table colors (keep the same style logic: full-opacity font + darker backdrop with transp=62)
longColor  = color.new(color.green, 0)
shortColor = color.new(color.red,   0)

longBg  = color.new(#1b5e20, 62)   // dark green backdrop (same transp=62 style)
shortBg = color.new(#b71c1c, 62)   // dark red backdrop (same as atrBg values)

var table  t = na
var string prevPosInput = na

// Recreate table if position changes (table position can't be edited after creation)
if barstate.isfirst or posInput != prevPosInput or na(t)
    prevPosInput := posInput
    if not na(t)
        table.delete(t)
    t := table.new(tblPos, 2, 4,
        bgcolor=color.new(color.black, 80),
        frame_color=color.new(color.gray, 60), frame_width=1,
        border_color=color.new(color.gray, 75), border_width=1)

atrTxt   = str.tostring(atrValue, format.mintick)
atrpTxt  = str.tostring(atrPercent, "#.##") + "%"
longTxt  = str.tostring(longEntrySize,  "#.##")
shortTxt = str.tostring(shortEntrySize, "#.##")

if barstate.islast
    if showTable
        // Titles (left column) = WHITE (with the same alpha value you provided)
        table.cell(t, 0, 0, "ATR",        text_color=titleCol, text_size=txtSize)
        table.cell(t, 0, 1, "ATR%",       text_color=titleCol, text_size=txtSize)
        table.cell(t, 0, 2, "Long-sl", text_color=titleCol, text_size=txtSize)
        table.cell(t, 0, 3, "Short-sl",text_color=titleCol, text_size=txtSize)

        // Values (right column) = COLORED + matching backdrops
        table.cell(t, 1, 0, atrTxt,   text_color=atrColor,  text_size=txtSize, bgcolor=atrBg)
        table.cell(t, 1, 1, atrpTxt,  text_color=atrpColor, text_size=txtSize, bgcolor=atrpBg)
        table.cell(t, 1, 2, longTxt,  text_color=longColor, text_size=txtSize, bgcolor=longBg)
        table.cell(t, 1, 3, shortTxt, text_color=shortColor,text_size=txtSize, bgcolor=shortBg)
    else
        table.clear(t, 0, 0, 1, 3)

//────────────────────────────────────────────────────────────────────
// Alerts (4 total)
//────────────────────────────────────────────────────────────────────
main = longEntrySize
sig  = shortEntrySize

crossUp    = ta.crossover(main, sig)
crossDown  = ta.crossunder(main, sig)
movingUp   = main > main[1]
movingDown = main < main[1]

alertcondition(crossUp,    title="ATR+ Cross Up",    message="ATR+ Cross Up")
alertcondition(crossDown,  title="ATR+ Cross Down",  message="ATR+ Cross Down")
alertcondition(movingUp,   title="ATR+ Moving Up",   message="ATR+ Moving Up")
alertcondition(movingDown, title="ATR+ Moving Down", message="ATR+ Moving Down")
