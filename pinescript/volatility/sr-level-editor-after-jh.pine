//@version=5
indicator("S/R Level Editor", overlay=true, max_lines_count=6)

// ─── SUPPORT INPUTS ─────────────────────────────────────────────────────────
s1 = input.float(0.0, title="S1 — Support 1", group="Support Levels")
s1Alert = input.bool(false, title="S1 Alert", group="Support Levels")
s2 = input.float(0.0, title="S2 — Support 2", group="Support Levels")
s2Alert = input.bool(false, title="S2 Alert", group="Support Levels")
s3 = input.float(0.0, title="S3 — Support 3", group="Support Levels")
s3Alert = input.bool(false, title="S3 Alert", group="Support Levels")

// ─── RESISTANCE INPUTS ──────────────────────────────────────────────────────
r1 = input.float(0.0, title="R1 — Resistance 1", group="Resistance Levels")
r1Alert = input.bool(false, title="R1 Alert", group="Resistance Levels")
r2 = input.float(0.0, title="R2 — Resistance 2", group="Resistance Levels")
r2Alert = input.bool(false, title="R2 Alert", group="Resistance Levels")
r3 = input.float(0.0, title="R3 — Resistance 3", group="Resistance Levels")
r3Alert = input.bool(false, title="R3 Alert", group="Resistance Levels")

// ─── STYLE INPUTS ───────────────────────────────────────────────────────────
lineWidth = input.int(2, title="Line Width", minval=1, maxval=4, group="Style")
showLabels = input.bool(true, title="Show Labels", group="Style")
extendLines = input.bool(true, title="Extend Lines Both Directions", group="Style")

// ─── COLOURS ────────────────────────────────────────────────────────────────
// Support: S1 green, S2 yellow, S3 red
color colS1 = color.new(#00C853, 0)   // Bright green
color colS2 = color.new(#FFD600, 0)   // Yellow
color colS3 = color.new(#FF1744, 0)   // Red

// Resistance: Varying shades of green (light → dark)
color colR1 = color.new(#B9F6CA, 0)   // Light green
color colR2 = color.new(#69F0AE, 0)   // Medium green
color colR3 = color.new(#00E676, 0)   // Vivid green

// ─── LINE EXTENSION ─────────────────────────────────────────────────────────
ext = extendLines ? extend.both : extend.right

// ─── DRAW FUNCTION ──────────────────────────────────────────────────────────
drawLevel(float price, color col, string label) =>
    var line ln = na
    var label lb = na
    if not na(price) and price != 0.0
        if not na(ln)
            line.delete(ln)
        if not na(lb)
            label.delete(lb)
        ln := line.new(bar_index - 1, price, bar_index + 1, price,
             xloc=xloc.bar_index, extend=ext, color=col,
             style=line.style_solid, width=lineWidth)
        if showLabels
            lb := label.new(bar_index + 5, price, label,
                 xloc=xloc.bar_index, style=label.style_none,
                 textcolor=col, size=size.normal)

// ─── DRAW ALL LEVELS ────────────────────────────────────────────────────────
drawLevel(s1, colS1, "S1")
drawLevel(s2, colS2, "S2")
drawLevel(s3, colS3, "S3")

drawLevel(r1, colR1, "R1")
drawLevel(r2, colR2, "R2")
drawLevel(r3, colR3, "R3")

// ─── ALERT CONDITIONS ───────────────────────────────────────────────────────
// Crosses detect price moving through the level in either direction

crossS1 = s1Alert and s1 != 0.0 and ta.cross(close, s1)
crossS2 = s2Alert and s2 != 0.0 and ta.cross(close, s2)
crossS3 = s3Alert and s3 != 0.0 and ta.cross(close, s3)

crossR1 = r1Alert and r1 != 0.0 and ta.cross(close, r1)
crossR2 = r2Alert and r2 != 0.0 and ta.cross(close, r2)
crossR3 = r3Alert and r3 != 0.0 and ta.cross(close, r3)

alertcondition(crossS1, title="S1 Touch", message="Price crossed S1 ({{close}})")
alertcondition(crossS2, title="S2 Touch", message="Price crossed S2 ({{close}})")
alertcondition(crossS3, title="S3 Touch", message="Price crossed S3 ({{close}})")

alertcondition(crossR1, title="R1 Touch", message="Price crossed R1 ({{close}})")
alertcondition(crossR2, title="R2 Touch", message="Price crossed R2 ({{close}})")
alertcondition(crossR3, title="R3 Touch", message="Price crossed R3 ({{close}})")

// ─── MASTER ALERT (any level touched) ───────────────────────────────────────
anyTouch = crossS1 or crossS2 or crossS3 or crossR1 or crossR2 or crossR3
alertcondition(anyTouch, title="Any S/R Touch", message="Price crossed an S/R level ({{close}})")
