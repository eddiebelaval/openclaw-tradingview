//@version=6
indicator("Fast Moving Average Period", shorttitle = "FMAP", overlay=false, precision=0)

// --- Inputs ---
string ma_type  = input.string("EMA", "MA Type", options=["EMA", "SMA"])
int min_p       = input.int(2, "Min Period", minval=1)
int max_p       = input.int(200, "Max Period", minval=2)
int step        = input.int(1, "Step", minval=1)
int lookback    = input.int(1, "Trailing Lookback Window", minval=1)

// --- Volatility Inputs ---
int   atr_len     = input.int(20, "ATR Current Length")
float vol_thresh  = input.float(1.0, "Volatility Sensitivity", step=0.1)

// --- Color Inputs ---
color aqua_col  = input.color(color.new(color.olive, 70), "Pullback periods (S > R)")
color olive_col = input.color(color.new(color.maroon, 70), "Throwback periods (R > S)")
color bidir_col = input.color(color.new(color.blue, 70), "Bi-directional flipping (S <-> R)")
color chaos_col = input.color(color.new(color.fuchsia, 70), "Chaotic Expansion (High Vol)")
color cons_col  = input.color(color.new(color.aqua, 70), "Slacking Squeeze (Low Vol)")

// --- Matrix Setup ---
var matrix<float> ma_history = matrix.new<float>(max_p + 1, lookback + 1, 0.0)

// --- Calculation ---
for p = min_p to max_p by step
    float current_ma_val = 0.0
    
    // --- MANUAL MA CALCULATIONS (Avoids Series Int error) ---
    if ma_type == "EMA"
        float alpha = 2.0 / (p + 1.0)
        float prev_ma = matrix.get(ma_history, p, 0)
        current_ma_val := prev_ma == 0.0 ? close : (close * alpha) + (prev_ma * (1.0 - alpha))
    else
        // Manual SMA Calculation: Summing the last 'p' bars
        float sum_price = 0.0
        for i = 0 to p - 1
            sum_price += close[i]
        current_ma_val := sum_price / p
    
    // Shift history in the matrix
    for col = lookback to 1
        matrix.set(ma_history, p, col, matrix.get(ma_history, p, col - 1))
    
    // Store current calculation
    matrix.set(ma_history, p, 0, current_ma_val)

// --- The Lagged Path-Accurate Check ---
float fastest_lower_p = na
float fastest_upper_p = na

for p = min_p to max_p by step
    bool lower_u = true, bool upper_u = true
    
    for j = 0 to lookback - 1
        float hist_ma = matrix.get(ma_history, p, j + 1)
        
        if hist_ma == 0.0 or na(hist_ma)
            lower_u := false, upper_u := false
            break
        
        if low[j] <= hist_ma
            lower_u := false
        if high[j] >= hist_ma
            upper_u := false
            
    if lower_u and na(fastest_lower_p)
        fastest_lower_p := float(p)
    if upper_u and na(fastest_upper_p)
        fastest_upper_p := float(p)

// --- Volatility Logic ---
bool is_high_vol = ta.tr(true) > (ta.atr(atr_len) * vol_thresh)

// --- Consecutive Homogeneity & Interspersed Logic ---
bool both_exist = not na(fastest_lower_p) and not na(fastest_upper_p)
bool s_over_r   = fastest_lower_p > fastest_upper_p
bool r_over_s   = fastest_upper_p > fastest_lower_p

bool is_homog_aqua  = both_exist and both_exist[1] and s_over_r and s_over_r[1]
bool is_homog_olive = both_exist and both_exist[1] and r_over_s and r_over_s[1]
bool is_flipping    = both_exist and both_exist[1] and ((s_over_r and r_over_s[1]) or (r_over_s and s_over_r[1]))

color dynamic_fill = is_homog_aqua ? aqua_col : is_homog_olive ? olive_col : is_flipping ? bidir_col : na

// --- Visualization ---
hline(max_p, "Max Period", color=color.new(color.purple, 50), linestyle=hline.style_dotted)
hline(0, "Zero", color=color.new(color.blue, 50))

p_low = plot(fastest_lower_p, "Support Period", color=color.green, style=plot.style_cross)
p_up  = plot(fastest_upper_p, "Resistance Period", color=color.red, style=plot.style_circles)

fill(p_low, p_up, color=dynamic_fill, title="Squeeze Fill")

bool chaos = na(fastest_lower_p) and na(fastest_upper_p)
bgcolor(chaos ? (is_high_vol ? chaos_col : cons_col) : na)
