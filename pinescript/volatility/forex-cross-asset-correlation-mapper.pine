//@version=5
indicator("Forex Cross-Asset Correlation Mapper", shorttitle="FX Corr Map", overlay=false)

// ═══════════════════════════════════════════════════════════════════════════
// INPUT PARAMETERS
// ═══════════════════════════════════════════════════════════════════════════

showEURUSD = input.bool(true, "EURUSD", group="Pairs")
showGBPUSD = input.bool(true, "GBPUSD", group="Pairs")
showUSDJPY = input.bool(true, "USDJPY", group="Pairs")
showAUDUSD = input.bool(true, "AUDUSD", group="Pairs")
showUSDCAD = input.bool(true, "USDCAD", group="Pairs")
showUSDCHF = input.bool(true, "USDCHF", group="Pairs")
showNZDUSD = input.bool(true, "NZDUSD", group="Pairs")

corrLength       = input.int(20,   "Correlation Period",       minval=5,   maxval=200,        group="Correlation")
anomalyThreshold = input.float(2.0,"Anomaly Threshold (σ)",   minval=0.5, maxval=5.0, step=0.1, group="Correlation")
anomalyPeriod    = input.int(50,   "Anomaly Detection Period", minval=20,  maxval=200,        group="Correlation")

posColor     = input.color(color.new(color.green, 0), "Positive Correlation", group="Colors")
negColor     = input.color(color.new(color.red,   0), "Negative Correlation", group="Colors")
neutralColor = input.color(color.new(color.gray,  0), "Neutral Correlation",  group="Colors")
anomalyColor = input.color(color.yellow,              "Anomaly Highlight",    group="Colors")

showHeatmap         = input.bool(true, "Show Heatmap",          group="Display")
showCorrelationPlot = input.bool(true, "Show Correlation Plot", group="Display")

// ═══════════════════════════════════════════════════════════════════════════
// AUTO-DETECT CURRENT CHART PAIR
// ═══════════════════════════════════════════════════════════════════════════

currentTicker = syminfo.ticker
selectedPair =
     str.contains(currentTicker, "EUR") and str.contains(currentTicker, "USD") ? "EURUSD" :
     str.contains(currentTicker, "GBP") and str.contains(currentTicker, "USD") ? "GBPUSD" :
     str.contains(currentTicker, "USD") and str.contains(currentTicker, "JPY") ? "USDJPY" :
     str.contains(currentTicker, "AUD") and str.contains(currentTicker, "USD") ? "AUDUSD" :
     str.contains(currentTicker, "USD") and str.contains(currentTicker, "CAD") ? "USDCAD" :
     str.contains(currentTicker, "USD") and str.contains(currentTicker, "CHF") ? "USDCHF" :
     str.contains(currentTicker, "NZD") and str.contains(currentTicker, "USD") ? "NZDUSD" :
     "EURUSD"

// ═══════════════════════════════════════════════════════════════════════════
// PRICE DATA
// ═══════════════════════════════════════════════════════════════════════════

eurusd = request.security("EURUSD", timeframe.period, close)
gbpusd = request.security("GBPUSD", timeframe.period, close)
usdjpy = request.security("USDJPY", timeframe.period, close)
audusd = request.security("AUDUSD", timeframe.period, close)
usdcad = request.security("USDCAD", timeframe.period, close)
usdchf = request.security("USDCHF", timeframe.period, close)
nzdusd = request.security("NZDUSD", timeframe.period, close)
dxy    = request.security("DX1!",   timeframe.period, close)

// ═══════════════════════════════════════════════════════════════════════════
// CORRELATIONS WITH DXY
// ═══════════════════════════════════════════════════════════════════════════

corrEURUSD_DXY = ta.correlation(eurusd, dxy, corrLength)
corrGBPUSD_DXY = ta.correlation(gbpusd, dxy, corrLength)
corrUSDJPY_DXY = ta.correlation(usdjpy, dxy, corrLength)
corrAUDUSD_DXY = ta.correlation(audusd, dxy, corrLength)
corrUSDCAD_DXY = ta.correlation(usdcad, dxy, corrLength)
corrUSDCHF_DXY = ta.correlation(usdchf, dxy, corrLength)
corrNZDUSD_DXY = ta.correlation(nzdusd, dxy, corrLength)

// ═══════════════════════════════════════════════════════════════════════════
// CROSS-PAIR CORRELATIONS
// ═══════════════════════════════════════════════════════════════════════════

corrEURUSD_GBPUSD = ta.correlation(eurusd, gbpusd, corrLength)
corrEURUSD_USDJPY = ta.correlation(eurusd, usdjpy, corrLength)
corrEURUSD_AUDUSD = ta.correlation(eurusd, audusd, corrLength)
corrEURUSD_USDCAD = ta.correlation(eurusd, usdcad, corrLength)
corrEURUSD_USDCHF = ta.correlation(eurusd, usdchf, corrLength)
corrEURUSD_NZDUSD = ta.correlation(eurusd, nzdusd, corrLength)

corrGBPUSD_USDJPY = ta.correlation(gbpusd, usdjpy, corrLength)
corrGBPUSD_AUDUSD = ta.correlation(gbpusd, audusd, corrLength)
corrGBPUSD_USDCAD = ta.correlation(gbpusd, usdcad, corrLength)
corrGBPUSD_USDCHF = ta.correlation(gbpusd, usdchf, corrLength)
corrGBPUSD_NZDUSD = ta.correlation(gbpusd, nzdusd, corrLength)

corrUSDJPY_AUDUSD = ta.correlation(usdjpy, audusd, corrLength)
corrUSDJPY_USDCAD = ta.correlation(usdjpy, usdcad, corrLength)
corrUSDJPY_USDCHF = ta.correlation(usdjpy, usdchf, corrLength)
corrUSDJPY_NZDUSD = ta.correlation(usdjpy, nzdusd, corrLength)

corrAUDUSD_USDCAD = ta.correlation(audusd, usdcad, corrLength)
corrAUDUSD_USDCHF = ta.correlation(audusd, usdchf, corrLength)
corrAUDUSD_NZDUSD = ta.correlation(audusd, nzdusd, corrLength)

corrUSDCAD_USDCHF = ta.correlation(usdcad, usdchf, corrLength)
corrUSDCAD_NZDUSD = ta.correlation(usdcad, nzdusd, corrLength)

corrUSDCHF_NZDUSD = ta.correlation(usdchf, nzdusd, corrLength)

// ═══════════════════════════════════════════════════════════════════════════
// ANOMALY DETECTION
// ═══════════════════════════════════════════════════════════════════════════

meanEURUSD_DXY = ta.sma(corrEURUSD_DXY, anomalyPeriod)
stdEURUSD_DXY  = ta.stdev(corrEURUSD_DXY, anomalyPeriod)
anomalyEURUSD  = math.abs(corrEURUSD_DXY - meanEURUSD_DXY) > anomalyThreshold * stdEURUSD_DXY

meanGBPUSD_DXY = ta.sma(corrGBPUSD_DXY, anomalyPeriod)
stdGBPUSD_DXY  = ta.stdev(corrGBPUSD_DXY, anomalyPeriod)
anomalyGBPUSD  = math.abs(corrGBPUSD_DXY - meanGBPUSD_DXY) > anomalyThreshold * stdGBPUSD_DXY

meanUSDJPY_DXY = ta.sma(corrUSDJPY_DXY, anomalyPeriod)
stdUSDJPY_DXY  = ta.stdev(corrUSDJPY_DXY, anomalyPeriod)
anomalyUSDJPY  = math.abs(corrUSDJPY_DXY - meanUSDJPY_DXY) > anomalyThreshold * stdUSDJPY_DXY

meanAUDUSD_DXY = ta.sma(corrAUDUSD_DXY, anomalyPeriod)
stdAUDUSD_DXY  = ta.stdev(corrAUDUSD_DXY, anomalyPeriod)
anomalyAUDUSD  = math.abs(corrAUDUSD_DXY - meanAUDUSD_DXY) > anomalyThreshold * stdAUDUSD_DXY

meanUSDCAD_DXY = ta.sma(corrUSDCAD_DXY, anomalyPeriod)
stdUSDCAD_DXY  = ta.stdev(corrUSDCAD_DXY, anomalyPeriod)
anomalyUSDCAD  = math.abs(corrUSDCAD_DXY - meanUSDCAD_DXY) > anomalyThreshold * stdUSDCAD_DXY

meanUSDCHF_DXY = ta.sma(corrUSDCHF_DXY, anomalyPeriod)
stdUSDCHF_DXY  = ta.stdev(corrUSDCHF_DXY, anomalyPeriod)
anomalyUSDCHF  = math.abs(corrUSDCHF_DXY - meanUSDCHF_DXY) > anomalyThreshold * stdUSDCHF_DXY

meanNZDUSD_DXY = ta.sma(corrNZDUSD_DXY, anomalyPeriod)
stdNZDUSD_DXY  = ta.stdev(corrNZDUSD_DXY, anomalyPeriod)
anomalyNZDUSD  = math.abs(corrNZDUSD_DXY - meanNZDUSD_DXY) > anomalyThreshold * stdNZDUSD_DXY

currentPairAnomaly =
     selectedPair == "EURUSD" ? (showEURUSD and anomalyEURUSD) :
     selectedPair == "GBPUSD" ? (showGBPUSD and anomalyGBPUSD) :
     selectedPair == "USDJPY" ? (showUSDJPY and anomalyUSDJPY) :
     selectedPair == "AUDUSD" ? (showAUDUSD and anomalyAUDUSD) :
     selectedPair == "USDCAD" ? (showUSDCAD and anomalyUSDCAD) :
     selectedPair == "USDCHF" ? (showUSDCHF and anomalyUSDCHF) :
     (showNZDUSD and anomalyNZDUSD)

// ═══════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════

getCorrColor(corr) =>
    corr > 0 ?
         color.from_gradient(corr, 0, 1, neutralColor, posColor) :
         color.from_gradient(corr, -1, 0, negColor, neutralColor)

// FIX 1: DXY as pair1 now handled correctly via normalization
getCorr(pair1, pair2) =>
    float result = 1.0
    // Normalize: ensure DXY is always in p2 slot for the lookup
    p1 = pair1 == "DXY" ? pair2 : pair1
    p2 = pair1 == "DXY" ? "DXY" : pair2

    if p1 == p2
        result := 1.0
    else if p2 == "DXY"
        result :=
             p1 == "EURUSD" ? corrEURUSD_DXY :
             p1 == "GBPUSD" ? corrGBPUSD_DXY :
             p1 == "USDJPY" ? corrUSDJPY_DXY :
             p1 == "AUDUSD" ? corrAUDUSD_DXY :
             p1 == "USDCAD" ? corrUSDCAD_DXY :
             p1 == "USDCHF" ? corrUSDCHF_DXY :
             corrNZDUSD_DXY
    else if (p1 == "EURUSD" and p2 == "GBPUSD") or (p1 == "GBPUSD" and p2 == "EURUSD")
        result := corrEURUSD_GBPUSD
    else if (p1 == "EURUSD" and p2 == "USDJPY") or (p1 == "USDJPY" and p2 == "EURUSD")
        result := corrEURUSD_USDJPY
    else if (p1 == "EURUSD" and p2 == "AUDUSD") or (p1 == "AUDUSD" and p2 == "EURUSD")
        result := corrEURUSD_AUDUSD
    else if (p1 == "EURUSD" and p2 == "USDCAD") or (p1 == "USDCAD" and p2 == "EURUSD")
        result := corrEURUSD_USDCAD
    else if (p1 == "EURUSD" and p2 == "USDCHF") or (p1 == "USDCHF" and p2 == "EURUSD")
        result := corrEURUSD_USDCHF
    else if (p1 == "EURUSD" and p2 == "NZDUSD") or (p1 == "NZDUSD" and p2 == "EURUSD")
        result := corrEURUSD_NZDUSD
    else if (p1 == "GBPUSD" and p2 == "USDJPY") or (p1 == "USDJPY" and p2 == "GBPUSD")
        result := corrGBPUSD_USDJPY
    else if (p1 == "GBPUSD" and p2 == "AUDUSD") or (p1 == "AUDUSD" and p2 == "GBPUSD")
        result := corrGBPUSD_AUDUSD
    else if (p1 == "GBPUSD" and p2 == "USDCAD") or (p1 == "USDCAD" and p2 == "GBPUSD")
        result := corrGBPUSD_USDCAD
    else if (p1 == "GBPUSD" and p2 == "USDCHF") or (p1 == "USDCHF" and p2 == "GBPUSD")
        result := corrGBPUSD_USDCHF
    else if (p1 == "GBPUSD" and p2 == "NZDUSD") or (p1 == "NZDUSD" and p2 == "GBPUSD")
        result := corrGBPUSD_NZDUSD
    else if (p1 == "USDJPY" and p2 == "AUDUSD") or (p1 == "AUDUSD" and p2 == "USDJPY")
        result := corrUSDJPY_AUDUSD
    else if (p1 == "USDJPY" and p2 == "USDCAD") or (p1 == "USDCAD" and p2 == "USDJPY")
        result := corrUSDJPY_USDCAD
    else if (p1 == "USDJPY" and p2 == "USDCHF") or (p1 == "USDCHF" and p2 == "USDJPY")
        result := corrUSDJPY_USDCHF
    else if (p1 == "USDJPY" and p2 == "NZDUSD") or (p1 == "NZDUSD" and p2 == "USDJPY")
        result := corrUSDJPY_NZDUSD
    else if (p1 == "AUDUSD" and p2 == "USDCAD") or (p1 == "USDCAD" and p2 == "AUDUSD")
        result := corrAUDUSD_USDCAD
    else if (p1 == "AUDUSD" and p2 == "USDCHF") or (p1 == "USDCHF" and p2 == "AUDUSD")
        result := corrAUDUSD_USDCHF
    else if (p1 == "AUDUSD" and p2 == "NZDUSD") or (p1 == "NZDUSD" and p2 == "AUDUSD")
        result := corrAUDUSD_NZDUSD
    else if (p1 == "USDCAD" and p2 == "USDCHF") or (p1 == "USDCHF" and p2 == "USDCAD")
        result := corrUSDCAD_USDCHF
    else if (p1 == "USDCAD" and p2 == "NZDUSD") or (p1 == "NZDUSD" and p2 == "USDCAD")
        result := corrUSDCAD_NZDUSD
    else if (p1 == "USDCHF" and p2 == "NZDUSD") or (p1 == "NZDUSD" and p2 == "USDCHF")
        result := corrUSDCHF_NZDUSD
    result

hasAnomaly(pair) =>
    pair == "EURUSD" and showEURUSD ? anomalyEURUSD :
     pair == "GBPUSD" and showGBPUSD ? anomalyGBPUSD :
     pair == "USDJPY" and showUSDJPY ? anomalyUSDJPY :
     pair == "AUDUSD" and showAUDUSD ? anomalyAUDUSD :
     pair == "USDCAD" and showUSDCAD ? anomalyUSDCAD :
     pair == "USDCHF" and showUSDCHF ? anomalyUSDCHF :
     pair == "NZDUSD" and showNZDUSD ? anomalyNZDUSD : false

// ═══════════════════════════════════════════════════════════════════════════
// BUILD ENABLED PAIRS LIST
// FIX 3: rebuilt every bar so toggling pairs updates table immediately
// ═══════════════════════════════════════════════════════════════════════════

var string[] enabledPairs = array.new_string(0)
array.clear(enabledPairs)
if showEURUSD
    array.push(enabledPairs, "EURUSD")
if showGBPUSD
    array.push(enabledPairs, "GBPUSD")
if showUSDJPY
    array.push(enabledPairs, "USDJPY")
if showAUDUSD
    array.push(enabledPairs, "AUDUSD")
if showUSDCAD
    array.push(enabledPairs, "USDCAD")
if showUSDCHF
    array.push(enabledPairs, "USDCHF")
if showNZDUSD
    array.push(enabledPairs, "NZDUSD")
array.push(enabledPairs, "DXY")

numPairs = array.size(enabledPairs)

// ═══════════════════════════════════════════════════════════════════════════
// SELECTED PAIR METRICS
// ═══════════════════════════════════════════════════════════════════════════

selectedCorr =
     selectedPair == "EURUSD" ? corrEURUSD_DXY :
     selectedPair == "GBPUSD" ? corrGBPUSD_DXY :
     selectedPair == "USDJPY" ? corrUSDJPY_DXY :
     selectedPair == "AUDUSD" ? corrAUDUSD_DXY :
     selectedPair == "USDCAD" ? corrUSDCAD_DXY :
     selectedPair == "USDCHF" ? corrUSDCHF_DXY :
     corrNZDUSD_DXY

selectedMean =
     selectedPair == "EURUSD" ? meanEURUSD_DXY :
     selectedPair == "GBPUSD" ? meanGBPUSD_DXY :
     selectedPair == "USDJPY" ? meanUSDJPY_DXY :
     selectedPair == "AUDUSD" ? meanAUDUSD_DXY :
     selectedPair == "USDCAD" ? meanUSDCAD_DXY :
     selectedPair == "USDCHF" ? meanUSDCHF_DXY :
     meanNZDUSD_DXY

selectedStd =
     selectedPair == "EURUSD" ? stdEURUSD_DXY :
     selectedPair == "GBPUSD" ? stdGBPUSD_DXY :
     selectedPair == "USDJPY" ? stdUSDJPY_DXY :
     selectedPair == "AUDUSD" ? stdAUDUSD_DXY :
     selectedPair == "USDCAD" ? stdUSDCAD_DXY :
     selectedPair == "USDCHF" ? stdUSDCHF_DXY :
     stdNZDUSD_DXY

upperBound = selectedMean + anomalyThreshold * selectedStd
lowerBound = selectedMean - anomalyThreshold * selectedStd

// ═══════════════════════════════════════════════════════════════════════════
// INFO PANEL
// ═══════════════════════════════════════════════════════════════════════════

var table infoPanel = table.new(position.top_left, 2, 5,
     border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(infoPanel, 0, 0, "Current Pair",
         text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.small)
    table.cell(infoPanel, 1, 0, selectedPair,
         text_color=color.white, bgcolor=color.new(color.orange, 70), text_size=size.small)

    corrCol = getCorrColor(selectedCorr)
    table.cell(infoPanel, 0, 1, "DXY Correlation",
         text_color=color.gray, text_size=size.small)
    table.cell(infoPanel, 1, 1, str.tostring(selectedCorr, "#.##"),
         text_color=color.white, bgcolor=color.new(corrCol, 50), text_size=size.small)

    table.cell(infoPanel, 0, 2, "Average",
         text_color=color.gray, text_size=size.tiny)
    table.cell(infoPanel, 1, 2, str.tostring(selectedMean, "#.##"),
         text_color=color.white, text_size=size.tiny)

    // FIX: guard against zero std
    deviation = selectedStd > 0 ? math.abs(selectedCorr - selectedMean) / selectedStd : 0.0
    devCol = deviation > anomalyThreshold ? color.red : color.green
    table.cell(infoPanel, 0, 3, "Deviation (σ)",
         text_color=color.gray, text_size=size.tiny)
    table.cell(infoPanel, 1, 3, str.tostring(deviation, "#.##") + "σ",
         text_color=devCol, text_size=size.tiny)

    statusText  = currentPairAnomaly ? "! ANOMALY" : "Normal"
    statusColor = currentPairAnomaly ? color.new(color.red, 50) : color.new(color.green, 70)
    table.cell(infoPanel, 0, 4, "Status",
         text_color=color.gray, text_size=size.small)
    table.cell(infoPanel, 1, 4, statusText,
         text_color=color.white, bgcolor=statusColor, text_size=size.small)

// ═══════════════════════════════════════════════════════════════════════════
// HEATMAP TABLE
// FIX 2: anomalies shown with "!" marker in cell text + yellow text color
//         (table.cell has no per-cell border — this is the only workaround)
// ═══════════════════════════════════════════════════════════════════════════

var table heatmapTable = table.new(position.top_right, numPairs + 1, numPairs + 1,
     border_width=1, border_color=color.gray)

if barstate.islast and showHeatmap
    table.cell(heatmapTable, 0, 0, "", bgcolor=color.new(color.gray, 80))

    for i = 0 to numPairs - 1
        pairName = array.get(enabledPairs, i)
        isCurrentPair = pairName == selectedPair
        headerBg = isCurrentPair ? color.new(color.orange, 50) : color.new(color.blue, 70)
        table.cell(heatmapTable, i + 1, 0, pairName,
             text_color=color.white, bgcolor=headerBg, text_size=size.tiny)
        table.cell(heatmapTable, 0, i + 1, pairName,
             text_color=color.white, bgcolor=headerBg, text_size=size.tiny)

    for i = 0 to numPairs - 1
        pair1 = array.get(enabledPairs, i)
        for j = 0 to numPairs - 1
            pair2 = array.get(enabledPairs, j)
            if i == j
                table.cell(heatmapTable, j + 1, i + 1, "1.00",
                     text_color=color.white, bgcolor=color.new(posColor, 50), text_size=size.tiny)
            else
                corr      = getCorr(pair1, pair2)
                corrCol   = getCorrColor(corr)
                isDxyCor  = pair1 == "DXY" or pair2 == "DXY"
                nonDxy    = pair1 == "DXY" ? pair2 : pair1
                hasAnom   = isDxyCor and hasAnomaly(nonDxy)
                cellText  = str.tostring(corr, "#.##") + (hasAnom ? " !" : "")
                textCol   = hasAnom ? anomalyColor : color.white
                table.cell(heatmapTable, j + 1, i + 1, cellText,
                     text_color=textCol,
                     bgcolor=color.new(corrCol, 30),
                     text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════
// CORRELATION PLOT
// ═══════════════════════════════════════════════════════════════════════════

corrLineColor = currentPairAnomaly ? anomalyColor : color.blue
plot(showCorrelationPlot ? selectedCorr : na, "Correlation", color=corrLineColor, linewidth=3)
plot(showCorrelationPlot ? selectedMean : na, "Mean",        color=color.yellow,  linewidth=1)
plot(showCorrelationPlot ? upperBound   : na, "Upper Bound", color=color.new(color.red, 50), linewidth=1, style=plot.style_linebr)
plot(showCorrelationPlot ? lowerBound   : na, "Lower Bound", color=color.new(color.red, 50), linewidth=1, style=plot.style_linebr)

hline(0,  "Zero",             color=color.new(color.gray,  70), linestyle=hline.style_dotted)
hline(1,  "Perfect Positive", color=color.new(color.green, 80), linestyle=hline.style_dotted)
hline(-1, "Perfect Negative", color=color.new(color.red,   80), linestyle=hline.style_dotted)

upperPlot = plot(showCorrelationPlot ? upperBound : na, display=display.none)
lowerPlot = plot(showCorrelationPlot ? lowerBound : na, display=display.none)
fill(upperPlot, lowerPlot, color=color.new(color.red, 95), title="Normal Range")

bgcolor(showCorrelationPlot and currentPairAnomaly ? color.new(anomalyColor, 85) : na,
     title="Anomaly Background")

// ═══════════════════════════════════════════════════════════════════════════
// ALERT
// ═══════════════════════════════════════════════════════════════════════════

alertcondition(currentPairAnomaly, "Current Pair Anomaly",
     "Correlation anomaly detected for current pair vs DXY")
