//@version=6
// © tradingbauhaus
// Liquidity Rejection Study
// A technical analysis tool designed to visualize price exhaustion at historical pivot levels.
indicator("Liquidity Rejection Study", shorttitle="LRS", overlay=true, max_labels_count=500)

// --- Settings ---
group_trend  = "Structural Context"
useTrend     = input.bool(true, "Filter by Macro Baseline (EMA 200)", group=group_trend)
emaLen       = input.int(200, "Baseline Period", minval=1, group=group_trend)

group_levels = "Pivot Analysis"
lookbackSR   = input.int(20, "Pivot Lookback", minval=5, group=group_levels)
showSR       = input.bool(true, "Display Historical Pivots", group=group_levels)

group_flow   = "Volatility Confirmation"
volMult      = input.float(1.2, "Volume Threshold Multiplier", minval=0.5, group=group_flow)
atrLen       = input.int(14, "Volatility (ATR) Period", group=group_flow)

// --- Structural Calculations ---
emaTrend = ta.ema(close, emaLen)
plot(useTrend ? emaTrend : na, "Macro Baseline", color.new(color.gray, 50), 2)

resLevel = ta.highest(high, lookbackSR)[1]
supLevel = ta.lowest(low, lookbackSR)[1]

plot(showSR ? resLevel : na, "Upper Pivot", color.new(#ff0055, 70), 1, plot.style_linebr)
plot(showSR ? supLevel : na, "Lower Pivot", color.new(#00ffbb, 70), 1, plot.style_linebr)

// --- Liquidity Rejection Logic ---
atr    = ta.atr(atrLen)
body   = math.abs(close - open)
uWick  = high - math.max(open, close)
lWick  = math.min(open, close) - low
avgVol = ta.sma(volume, 20)

isAboveBaseline = not useTrend or close > emaTrend
isBelowBaseline = not useTrend or close < emaTrend

inSupportZone = low <= supLevel + (atr * 0.5)
inResistZone  = high >= resLevel - (atr * 0.5)

rejectionUp = lWick > (body * 2) and inSupportZone and volume > (avgVol * volMult) and isAboveBaseline
rejectionDn = uWick > (body * 2) and inResistZone and volume > (avgVol * volMult) and isBelowBaseline

// --- Structural Confirmation Engine ---
var float limitPrice = na
var int   state      = 0 

if rejectionUp
    limitPrice := high
    state      := 1
else if rejectionDn
    limitPrice := low
    state      := -1

// SOLUCIÓN A LOS WARNINGS: Ejecución global de funciones de historial
checkCrossover   = ta.crossover(close, limitPrice)
checkCrossunder  = ta.crossunder(close, limitPrice)
barsSinceTrigger = ta.barssince(rejectionUp or rejectionDn)

// Uso de las variables globales dentro de la lógica condicional
bool pivotConfirmedUp = state == 1 and checkCrossover
bool pivotConfirmedDn = state == -1 and checkCrossunder

// Lógica de reset corregida
if pivotConfirmedUp or pivotConfirmedDn or barsSinceTrigger > 3
    state      := 0
    limitPrice := na

// --- Visual Diagnostics ---
plotshape(pivotConfirmedUp, "Structural Pivot Up", shape.diamond, location.belowbar, color.new(#00ffbb, 0), size=size.small)
plotshape(pivotConfirmedDn, "Structural Pivot Dn", shape.diamond, location.abovebar, color.new(#ff0055, 0), size=size.small)

// --- Technical Notifications ---
alertcondition(pivotConfirmedUp, "Structural Pivot Expansion Up", "Price has breached the rejection high.")
alertcondition(pivotConfirmedDn, "Structural Pivot Expansion Down", "Price has breached the rejection low.")
