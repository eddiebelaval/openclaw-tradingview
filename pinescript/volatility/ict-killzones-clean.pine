//@version=6
indicator("ICT Killzones [TFO] - Clean", "ICT Killzones [TFO] - Clean", true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ---------------------------------------- Constant Functions --------------------------------------------------
get_line_type(_style) =>
    switch _style
        "Solid"  => line.style_solid
        "Dotted" => line.style_dotted
        "Dashed" => line.style_dashed

get_size(x) =>
    switch x
        "Auto"   => size.auto
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
// ---------------------------------------- Constant Functions --------------------------------------------------

// ---------------------------------------- Inputs --------------------------------------------------
var g_SETTINGS      = "Settings"
max_days            = input.int(3, "Session Drawing Limit", 1, tooltip = "Only this many drawings will be kept on the chart for each selected drawing type", group = g_SETTINGS)
tf_limit            = input.timeframe("60", "Timeframe Limit", tooltip = "Drawings will not appear on timeframes greater than or equal to this", group = g_SETTINGS)
gmt_tz              = input.string("America/New_York", "Timezone", options = ["America/New_York","GMT-12","GMT-11","GMT-10","GMT-9","GMT-8","GMT-7","GMT-6","GMT-5","GMT-4","GMT-3","GMT-2","GMT-1","GMT+0","GMT+1","GMT+2","GMT+3","GMT+4","GMT+5","GMT+6","GMT+7","GMT+8","GMT+9","GMT+10","GMT+11","GMT+12","GMT+13","GMT+14"], tooltip = "America/New_York adjusts automatically for DST", group = g_SETTINGS)
txt_color           = input.color(color.black, "Text Color", group = g_SETTINGS)
use_cutoff          = input.bool(false, "Drawing Cutoff Time", inline = "CO", group = g_SETTINGS)
cutoff              = input.session("1800-1801", "", inline = "CO", group = g_SETTINGS)

var tf_limit_is_equal_or_more_chart_tf = timeframe.in_seconds("") <= timeframe.in_seconds(tf_limit)

var g_KZ            = "Killzones"
show_kz             = input.bool(false, "Show Killzone Boxes", group = g_KZ)

use_asia            = input.bool(true, "", inline = "ASIA", group = g_KZ)
as_txt              = input.string("Asia", "", inline = "ASIA", group = g_KZ)
asia                = input.session("2000-0000", "", inline = "ASIA", group = g_KZ)
as_color            = input.color(#5b9cf6, "", inline = "ASIA", group = g_KZ)

use_london          = input.bool(true, "", inline = "LONDON", group = g_KZ)
lo_txt              = input.string("London", "", inline = "LONDON", group = g_KZ)
london              = input.session("0200-0500", "", inline = "LONDON", group = g_KZ)
lo_color            = input.color(#f77c80, "", inline = "LONDON", group = g_KZ)

use_nyam            = input.bool(true, "", inline = "NYAM", group = g_KZ)
na_txt              = input.string("NY", "", inline = "NYAM", group = g_KZ)
nyam                = input.session("0700-1100", "", inline = "NYAM", group = g_KZ)
na_color            = input.color(#81c784, "", inline = "NYAM", group = g_KZ)

use_nylu            = input.bool(true, "", inline = "NYLU", group = g_KZ)
nl_txt              = input.string("NY Lunch", "", inline = "NYLU", group = g_KZ)
nylu                = input.session("1050-1110", "", inline = "NYLU", group = g_KZ)
nl_color            = input.color(#ba68c8, "", inline = "NYLU", group = g_KZ)

use_nypm            = input.bool(true, "", inline = "NYPM", group = g_KZ)
np_txt              = input.string("NY PM", "", inline = "NYPM", group = g_KZ)
nypm                = input.session("1200-1330", "", inline = "NYPM", group = g_KZ)
np_color            = input.color(#fff176, "", inline = "NYPM", group = g_KZ)

box_transparency    = input.int(85, "Box Transparency", 0, 100, group = g_KZ)
kz_margin_width     = input.int(1, "Outer Dashed Line Width", minval = 1, maxval = 5, group = g_KZ)

var g_OPEN          = "Opening Prices"
open_unlimited      = input.bool(false, "Unlimited", tooltip = "Unlimited will show as many selected lines as possible. Otherwise, the session drawing limit will be used", group = g_OPEN)
open_lbl_size       = get_size(input.string("Tiny", "Opening Label Size", options = ["Auto", "Tiny", "Small", "Normal", "Large", "Huge"], group = g_OPEN))

use_h1              = input.bool(true, "", inline = "H1", group = g_OPEN)
h1_text             = input.string("True Day Open", "", inline = "H1", group = g_OPEN)
h1                  = input.session("0000-0001", "", inline = "H1", group = g_OPEN)
h1_color            = input.color(color.black, "", inline = "H1", group = g_OPEN)

hz_style            = get_line_type(input.string(defval = "Dotted", title = "Style", options = ["Solid", "Dotted", "Dashed"], inline = "H0", group = g_OPEN))
hz_width            = input.int(1, "", inline = "H0", group = g_OPEN)

var g_VERTICAL      = "Timestamps"
v_unlimited         = input.bool(false, "Unlimited", tooltip = "Unlimited will show as many selected lines as possible. Otherwise, the session drawing limit will be used", group = g_VERTICAL)

use_v1              = input.bool(true, "", inline = "V1", group = g_VERTICAL)
v1                  = input.session("0000-0001", "", inline = "V1", group = g_VERTICAL)
v1_color            = input.color(color.black, "", inline = "V1", group = g_VERTICAL)

vl_style            = get_line_type(input.string(defval = "Dotted", title = "Style", options = ["Solid", "Dotted", "Dashed"], inline = "V0", group = g_VERTICAL))
vl_width            = input.int(1, "", inline = "V0", group = g_VERTICAL)
// ---------------------------------------- Inputs --------------------------------------------------

// ---------------------------------------- Types --------------------------------------------------
type kz
    string _title
    array<box> _box
    array<line> _m_top
    array<line> _m_bottom
    array<line> _m_left
    array<line> _m_right

type hz
    array<line> LN
    array<label> LB
    array<bool> CO

type lines_helper
    hz _hz
    string h
    string h_text
    color h_color

type kz_helper
    kz _kz
    string session
    color c
    string box_txt

type ts_helper
    string session
    array<line> lines
    color c
// ---------------------------------------- Types --------------------------------------------------

// ---------------------------------------- Init --------------------------------------------------
initLines() =>
    array<lines_helper> res = array.new<lines_helper>()
    if use_h1
        res.push(lines_helper.new(hz.new(array.new_line(), array.new_label(), array.new_bool()), h1, h1_text, h1_color))
    res

initKZ() =>
    array<kz_helper> res = array.new<kz_helper>()
    if use_asia
        res.push(kz_helper.new(kz.new(as_txt, array.new_box(), array.new_line(), array.new_line(), array.new_line(), array.new_line()), asia, as_color, as_txt))
    if use_london
        res.push(kz_helper.new(kz.new(lo_txt, array.new_box(), array.new_line(), array.new_line(), array.new_line(), array.new_line()), london, lo_color, lo_txt))
    if use_nyam
        res.push(kz_helper.new(kz.new(na_txt, array.new_box(), array.new_line(), array.new_line(), array.new_line(), array.new_line()), nyam, na_color, na_txt))
    if use_nylu
        res.push(kz_helper.new(kz.new(nl_txt, array.new_box(), array.new_line(), array.new_line(), array.new_line(), array.new_line()), nylu, nl_color, nl_txt))
    if use_nypm
        res.push(kz_helper.new(kz.new(np_txt, array.new_box(), array.new_line(), array.new_line(), array.new_line(), array.new_line()), nypm, np_color, np_txt))
    res

initTS() =>
    array<ts_helper> res = array.new<ts_helper>()
    if use_v1
        res.push(ts_helper.new(v1, array.new_line(), v1_color))
    res

var array<lines_helper> lines = initLines()
var array<kz_helper> _kz = initKZ()
var array<ts_helper> ts_data = initTS()

t_co = not na(time("", cutoff, gmt_tz))
var transparent = #ffffff00
// ---------------------------------------- Init --------------------------------------------------

// ---------------------------------------- Helpers --------------------------------------------------
get_box_color(color c) =>
    color.new(c, box_transparency)

update_margin_lines(kz kzData, int idx, float topVal, float bottomVal, int leftTime, int rightTime) =>
    if idx < kzData._m_top.size()
        kzData._m_top.get(idx).set_xy1(leftTime, topVal)
        kzData._m_top.get(idx).set_xy2(rightTime, topVal)
        kzData._m_bottom.get(idx).set_xy1(leftTime, bottomVal)
        kzData._m_bottom.get(idx).set_xy2(rightTime, bottomVal)
        kzData._m_left.get(idx).set_xy1(leftTime, topVal)
        kzData._m_left.get(idx).set_xy2(leftTime, bottomVal)
        kzData._m_right.get(idx).set_xy1(rightTime, topVal)
        kzData._m_right.get(idx).set_xy2(rightTime, bottomVal)

delete_extra_kz(kz k) =>
    if k._box.size() > max_days
        k._box.pop().delete()
    if k._m_top.size() > max_days
        k._m_top.pop().delete()
        k._m_bottom.pop().delete()
        k._m_left.pop().delete()
        k._m_right.pop().delete()
// ---------------------------------------- Helpers --------------------------------------------------

// ---------------------------------------- Timestamps --------------------------------------------------
method vline(ts_helper this) =>
    bool t = not na(time("", this.session, gmt_tz))
    bool t_prev = not na(time("", this.session, gmt_tz, bars_back = 1))
    array<line> arr = this.lines
    color col = this.c

    if t and not t_prev
        arr.unshift(line.new(bar_index, high, bar_index, low, style = vl_style, width = vl_width, extend = extend.both, color = col))

    if not v_unlimited and arr.size() > max_days
        arr.pop().delete()

vlines() =>
    if tf_limit_is_equal_or_more_chart_tf
        for [_, value] in ts_data
            vline(value)
// ---------------------------------------- Timestamps --------------------------------------------------

// ---------------------------------------- Opening Prices --------------------------------------------------
method hz_line(lines_helper this) =>
    bool t = not na(time("", this.h, gmt_tz))
    bool t_prev = not na(time("", this.h, gmt_tz, bars_back = 1))
    hz hz_data = this._hz
    string txt = this.h_text
    color col = this.h_color

    if t and not t_prev
        hz_data.LN.unshift(line.new(bar_index, open, bar_index, open, style = hz_style, width = hz_width, color = col))
        hz_data.LB.unshift(label.new(bar_index, open, txt, style = label.style_label_left, color = transparent, textcolor = txt_color, size = open_lbl_size))
        array.unshift(hz_data.CO, false)

        if not open_unlimited and hz_data.LN.size() > max_days
            hz_data.LN.pop().delete()
            hz_data.LB.pop().delete()
            hz_data.CO.pop()

    if not t and hz_data.CO.size() > 0
        if not hz_data.CO.get(0)
            hz_data.LN.get(0).set_x2(bar_index)
            hz_data.LB.get(0).set_x(bar_index)
            if (use_cutoff ? t_co : false)
                hz_data.CO.set(0, true)

hz_lines() =>
    if tf_limit_is_equal_or_more_chart_tf
        for [_, value] in lines
            hz_line(value)
// ---------------------------------------- Opening Prices --------------------------------------------------

// ---------------------------------------- Killzones --------------------------------------------------
adjust_in_kz(kz kzData, bool t) =>
    if t and kzData._box.size() > 0
        kzBox0 = kzData._box.get(0)
        kzBox0.set_right(time)
        newTop = math.max(kzBox0.get_top(), high)
        newBottom = math.min(kzBox0.get_bottom(), low)
        kzBox0.set_top(newTop)
        kzBox0.set_bottom(newBottom)
        update_margin_lines(kzData, 0, newTop, newBottom, kzBox0.get_left(), kzBox0.get_right())

method manage_kz(kz_helper this) =>
    kz kzData = this._kz
    color c = this.c

    if tf_limit_is_equal_or_more_chart_tf
        bool t = not na(time("", this.session, gmt_tz))
        bool t_prev = not na(time("", this.session, gmt_tz, bars_back = 1))

        if t and not t_prev
            _c = get_box_color(c)

            kzData._box.unshift(
                box.new(
                    time,
                    high,
                    time,
                    low,
                    xloc = xloc.bar_time,
                    border_color = show_kz ? _c : na,
                    bgcolor = show_kz ? _c : na,
                    text = na
                )
            )

            kzData._m_top.unshift(line.new(time, high, time, high, xloc = xloc.bar_time, style = line.style_dashed, color = c, width = kz_margin_width))
            kzData._m_bottom.unshift(line.new(time, low, time, low, xloc = xloc.bar_time, style = line.style_dashed, color = c, width = kz_margin_width))
            kzData._m_left.unshift(line.new(time, high, time, low, xloc = xloc.bar_time, style = line.style_dashed, color = c, width = kz_margin_width))
            kzData._m_right.unshift(line.new(time, high, time, low, xloc = xloc.bar_time, style = line.style_dashed, color = c, width = kz_margin_width))

            delete_extra_kz(kzData)

        adjust_in_kz(kzData, t)
// ---------------------------------------- Killzones --------------------------------------------------

// ---------------------------------------- Run --------------------------------------------------
for [_, value] in _kz
    manage_kz(value)

vlines()
hz_lines()
// ---------------------------------------- Run --------------------------------------------------
