//@version=5
indicator(title="Coinbase Premium(/binance)", shorttitle="CB/BN Premium (White)", precision=2, overlay=false)

// 1. 데이터 호출 (Binance, Coinbase, Bitfinex)
binance_btc  = request.security("BINANCE:BTCUSDT", timeframe.period, close)
coinbase_btc = request.security("COINBASE:BTCUSD", timeframe.period, close)
usdt_peg     = request.security("BITFINEX:USTUSD", timeframe.period, close)

// 2. 프리미엄 계산 (기존 로직 유지)
adj_binance = binance_btc * usdt_peg
difference  = coinbase_btc - adj_binance

// 2봉 전 데이터를 기준으로 한 퍼센트 계산
diff_delayed = nz(coinbase_btc[2]) - (nz(binance_btc[2]) * nz(usdt_peg[2]))
percent      = (diff_delayed / (nz(binance_btc[2]) * nz(usdt_peg[2]))) * 100

// 3. 차트 출력 (색상: White)
// % 프리미엄 히스토그램
plot(percent, title="CME % Premium", style=plot.style_histogram, linewidth=2, color=color.white)

// USD 차이 히스토그램 (약간의 투명도를 주어 겹침 방지)
plot(difference, title="CME USD Premium", style=plot.style_columns, color=color.new(color.white, 60))

// 기준선 (0선)
hline(0, "Zero Line", color=color.white, linestyle=hline.style_solid)
