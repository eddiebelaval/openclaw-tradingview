//@version=6
indicator("XRP Buyer Pro - @hitz2kk", shorttitle="XRPBuyer", overlay=true, max_labels_count=500, max_boxes_count=200, max_lines_count=200)

//====================================================
// INPUTS
//====================================================
groupTrend = "Trend Engine"
fastEmaLen = input.int(21, "Fast EMA", minval=1, group=groupTrend)
slowEmaLen = input.int(55, "Slow EMA", minval=1, group=groupTrend)
baseEmaLen = input.int(200, "Base EMA", minval=1, group=groupTrend)

groupMomentum = "Momentum Engine"
rsiLen = input.int(14, "RSI Length", minval=1, group=groupMomentum)
rsiBullLevel = input.int(55, "RSI Bull Threshold", minval=1, maxval=100, group=groupMomentum)
macdFast = input.int(12, "MACD Fast", minval=1, group=groupMomentum)
macdSlow = input.int(26, "MACD Slow", minval=1, group=groupMomentum)
macdSignal = input.int(9, "MACD Signal", minval=1, group=groupMomentum)

groupVolume = "Volume / Smart Money"
volLen = input.int(20, "Volume Average Length", minval=1, group=groupVolume)
smartVolMult = input.float(1.8, "Smart Money Volume Multiplier", minval=0.5, step=0.1, group=groupVolume)
dispAtrMult = input.float(1.2, "Displacement ATR Multiplier", minval=0.5, step=0.1, group=groupVolume)

groupZones = "Institutional Buy Zones"
zoneLookback = input.int(12, "Impulse Lookback", minval=3, group=groupZones)
zoneExtend = input.int(25, "Zone Extend Bars", minval=5, group=groupZones)
maxZones = input.int(5, "Max Active Zones", minval=1, maxval=10, group=groupZones)

groupSignals = "Signal Logic"
breakoutLen = input.int(20, "Breakout Lookback", minval=2, group=groupSignals)
pullbackLen = input.int(10, "Pullback Lookback", minval=2, group=groupSignals)
atrLen = input.int(14, "ATR Length", minval=1, group=groupSignals)
probThreshold = input.int(70, "Probability Threshold", minval=1, maxval=100, group=groupSignals)

groupDisplay = "Display"
showBg = input.bool(true, "Show Bullish Background", group=groupDisplay)
showLabels = input.bool(true, "Show BUY Labels", group=groupDisplay)
showTable = input.bool(true, "Show Probability Panel", group=groupDisplay)
showZones = input.bool(true, "Show Institutional Buy Zones", group=groupDisplay)
showSignals = input.bool(true, "Show Signal Markers", group=groupDisplay)
showBarColor = input.bool(true, "Color Bullish Bars", group=groupDisplay)

//====================================================
// CORE DATA
//====================================================
fastEMA = ta.ema(close, fastEmaLen)
slowEMA = ta.ema(close, slowEmaLen)
baseEMA = ta.ema(close, baseEmaLen)

rsiVal = ta.rsi(close, rsiLen)
[macdLine, signalLine, histLine] = ta.macd(close, macdFast, macdSlow, macdSignal)

volMA = ta.sma(volume, volLen)
relVol = volMA > 0 ? volume / volMA : 0.0

atr = ta.atr(atrLen)
candleRange = high - low
bodySize = math.abs(close - open)

//====================================================
// TREND / MOMENTUM / BREAKOUT
//====================================================
trendBull = fastEMA > slowEMA and slowEMA > baseEMA and close > fastEMA
trendStrong = close > baseEMA and fastEMA > slowEMA

lowestPullback = ta.lowest(low, pullbackLen)
pullbackStructure = lowestPullback <= fastEMA
pullbackRecovered = low <= fastEMA and close > fastEMA and close > open

momentumBull = rsiVal > rsiBullLevel and macdLine > signalLine and histLine > histLine[1]
momentumStrong = rsiVal > 60 and macdLine > signalLine

priorHigh = ta.highest(high[1], breakoutLen)
breakoutBull = close > priorHigh

//====================================================
// SMART MONEY MODE
//====================================================
bullClosePosition = candleRange > 0 ? (close - low) / candleRange : 0.0
displacementBull = candleRange > atr * dispAtrMult and close > open and bullClosePosition > 0.65
smartMoneyBull = relVol >= smartVolMult and displacementBull and close > slowEMA

lowestRecent = ta.lowest(low, 6)
lowestPrev = ta.lowest(low[6], 6)
recentFlush = lowestRecent < lowestPrev
reclaimBull = recentFlush and close > fastEMA and close > open and relVol > 1.1

smartMoneyMode = smartMoneyBull or reclaimBull

//====================================================
// INSTITUTIONAL BUY ZONES
//====================================================
highestPrevHigh = ta.highest(high[1], zoneLookback)
impulseBull = close > open and close > highestPrevHigh and candleRange > atr and relVol > 1.2

zoneTopCandidate = math.max(open, close)
zoneBotCandidate = math.min(open, close)

var box[] demandZones = array.new_box()
var float[] zoneTops = array.new_float()
var float[] zoneBots = array.new_float()

if impulseBull and showZones
    newBox = box.new(
         left=bar_index,
         top=zoneTopCandidate,
         right=bar_index + zoneExtend,
         bottom=zoneBotCandidate,
         bgcolor=color.new(color.aqua, 88),
         border_color=color.new(color.aqua, 35)
     )
    array.push(demandZones, newBox)
    array.push(zoneTops, zoneTopCandidate)
    array.push(zoneBots, zoneBotCandidate)

    if array.size(demandZones) > maxZones
        oldBox = array.shift(demandZones)
        box.delete(oldBox)
        array.shift(zoneTops)
        array.shift(zoneBots)

if array.size(demandZones) > 0
    for i = 0 to array.size(demandZones) - 1
        bx = array.get(demandZones, i)
        box.set_right(bx, bar_index + zoneExtend)

inInstitutionalZone = false
if array.size(zoneTops) > 0
    for i = 0 to array.size(zoneTops) - 1
        zTop = array.get(zoneTops, i)
        zBot = array.get(zoneBots, i)
        zoneTouched = low <= zTop and high >= zBot
        if zoneTouched
            inInstitutionalZone := true

//====================================================
// PROBABILITY SCORE 0-100
//====================================================
trendScore = trendBull ? 20 : trendStrong ? 10 : 0
pullbackScore = (pullbackRecovered and pullbackStructure) ? 15 : pullbackRecovered ? 10 : 0
momentumScore = momentumBull ? 20 : momentumStrong ? 10 : 0
volumeScore = relVol >= 1.2 ? 10 : relVol >= 1.0 ? 5 : 0
breakoutScore = breakoutBull ? 15 : 0
smartMoneyScore = smartMoneyMode ? 10 : 0
zoneScore = inInstitutionalZone ? 10 : 0

probabilityScoreRaw = trendScore + pullbackScore + momentumScore + volumeScore + breakoutScore + smartMoneyScore + zoneScore
probabilityScore = math.min(probabilityScoreRaw, 100)

//====================================================
// SIGNALS
//====================================================
buyerSignal = probabilityScore >= probThreshold and close > baseEMA and (smartMoneyMode or inInstitutionalZone or breakoutBull)
earlyBuyerSignal = probabilityScore >= math.max(probThreshold - 15, 1) and trendBull and momentumBull

freshBuyerSignal = buyerSignal and not buyerSignal[1]
freshEarlySignal = earlyBuyerSignal and not earlyBuyerSignal[1] and not freshBuyerSignal

signalStop = close - atr * 1.5
signalTarget = close + atr * 3.0

//====================================================
// PLOTS
//====================================================
plot(baseEMA, "Base EMA", color=color.new(color.orange, 0), linewidth=2)
plot(fastEMA, "Fast EMA", color=color.new(color.lime, 0), linewidth=2)
plot(slowEMA, "Slow EMA", color=color.new(color.blue, 0), linewidth=2)

bgColorValue = showBg ? (
     probabilityScore >= probThreshold ? color.new(color.green, 90) :
     probabilityScore >= probThreshold - 10 ? color.new(color.aqua, 92) :
     na
) : na
bgcolor(bgColorValue)

plotshape(showSignals and freshBuyerSignal, title="XRP Buyer Signal", style=shape.triangleup, location=location.belowbar, size=size.large, color=color.lime, text="BUY")
plotshape(showSignals and freshEarlySignal, title="XRP Early Buyer", style=shape.circle, location=location.belowbar, size=size.small, color=color.aqua, text="EARLY")

if showLabels and freshBuyerSignal
    label.new(
         bar_index,
         low - atr * 0.45,
         "XRP BUYER\nProb: " + str.tostring(probabilityScore) + "%" +
         "\nStop: " + str.tostring(signalStop, format.mintick) +
         "\nTarget: " + str.tostring(signalTarget, format.mintick),
         style=label.style_label_up,
         color=color.new(color.green, 0),
         textcolor=color.white,
         size=size.small
     )

barColorValue = showBarColor ? (
     probabilityScore >= probThreshold and close > open ? color.new(color.lime, 0) :
     probabilityScore >= probThreshold - 10 and close > open ? color.new(color.aqua, 0) :
     smartMoneyMode and close > open ? color.new(color.blue, 0) :
     na
) : na
barcolor(barColorValue)

//====================================================
// WATERMARK / TRADEMARK
//====================================================
var table trademark = table.new(position.bottom_right, 1, 1, border_width=0)
if barstate.islast
    table.cell(
         trademark,
         0,
         0,
         "@hitz2kk™",
         text_color=color.new(color.gray, 20),
         bgcolor=color.new(color.black, 100),
         text_size=size.small
     )

//====================================================
// INFO PANEL
//====================================================
var table panel = table.new(position.top_right, 2, 9, border_width=1)

if barstate.islast
    if showTable
        table.cell(panel, 0, 0, "XRP Buyer Pro", text_color=color.white, bgcolor=color.new(color.black, 0))
        table.cell(panel, 1, 0, str.tostring(probabilityScore) + "%", text_color=color.white, bgcolor=probabilityScore >= probThreshold ? color.new(color.green, 0) : color.new(color.orange, 0))

        table.cell(panel, 0, 1, "Trend", text_color=color.white, bgcolor=color.new(color.black, 20))
        table.cell(panel, 1, 1, trendBull ? "BULL" : "NO", text_color=color.white, bgcolor=trendBull ? color.new(color.green, 20) : color.new(color.red, 20))

        table.cell(panel, 0, 2, "Pullback", text_color=color.white, bgcolor=color.new(color.black, 20))
        table.cell(panel, 1, 2, pullbackRecovered ? "READY" : "NO", text_color=color.white, bgcolor=pullbackRecovered ? color.new(color.green, 20) : color.new(color.red, 20))

        table.cell(panel, 0, 3, "Momentum", text_color=color.white, bgcolor=color.new(color.black, 20))
        table.cell(panel, 1, 3, momentumBull ? "UP" : "NO", text_color=color.white, bgcolor=momentumBull ? color.new(color.green, 20) : color.new(color.red, 20))

        table.cell(panel, 0, 4, "Volume", text_color=color.white, bgcolor=color.new(color.black, 20))
        table.cell(panel, 1, 4, str.tostring(relVol, "#.00") + "x", text_color=color.white, bgcolor=relVol >= 1.2 ? color.new(color.green, 20) : color.new(color.orange, 20))

        table.cell(panel, 0, 5, "Breakout", text_color=color.white, bgcolor=color.new(color.black, 20))
        table.cell(panel, 1, 5, breakoutBull ? "YES" : "NO", text_color=color.white, bgcolor=breakoutBull ? color.new(color.green, 20) : color.new(color.red, 20))

        table.cell(panel, 0, 6, "Smart Money", text_color=color.white, bgcolor=color.new(color.black, 20))
        table.cell(panel, 1, 6, smartMoneyMode ? "ACTIVE" : "OFF", text_color=color.white, bgcolor=smartMoneyMode ? color.new(color.aqua, 20) : color.new(color.red, 20))

        table.cell(panel, 0, 7, "Inst. Zone", text_color=color.white, bgcolor=color.new(color.black, 20))
        table.cell(panel, 1, 7, inInstitutionalZone ? "INSIDE" : "NO", text_color=color.white, bgcolor=inInstitutionalZone ? color.new(color.aqua, 20) : color.new(color.red, 20))

        table.cell(panel, 0, 8, "RSI", text_color=color.white, bgcolor=color.new(color.black, 20))
        table.cell(panel, 1, 8, str.tostring(rsiVal, "#.0"), text_color=color.white, bgcolor=rsiVal > rsiBullLevel ? color.new(color.green, 20) : color.new(color.orange, 20))
    else
        table.clear(panel, 0, 0, 1, 8)

//====================================================
// ALERTS
//====================================================
alertcondition(freshBuyerSignal, title="XRP Buyer Strong Signal", message="XRP Buyer Pro - @hitz2kk: Strong bullish setup detected.")
alertcondition(freshEarlySignal, title="XRP Buyer Early Signal", message="XRP Buyer Pro - @hitz2kk: Early bullish setup detected.")
alertcondition(smartMoneyMode, title="XRP Smart Money Mode", message="XRP Buyer Pro - @hitz2kk: Smart money style activity detected.")
alertcondition(inInstitutionalZone, title="Institutional Buy Zone Active", message="XRP Buyer Pro - @hitz2kk: Price is trading inside an institutional buy zone.")
