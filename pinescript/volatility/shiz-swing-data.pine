//@version=6
indicator(title='Swing Data - Final', shorttitle='SwingData', overlay=true, max_bars_back=253)

// ==== Inputs ====
show_empty_row    = input(true, title='Add an empty row above the displayed values', tooltip='Prevents pane icons from overlapping with text')
add_empty_row_dn  = input.int(0, title='Add empty rows under the displayed values', minval=0, maxval=5, step=1)
txt_col           = input(color.orange, title='Text Color', group='Table')
posTable          = input.string('Top Right', title='Table Position', options=['Top Left', 'Top Right', 'Bottom Left', 'Bottom Right'], group='Table')
tbl_size          = input.string('Normal', title='Table Size', options=['Tiny', 'Small', 'Normal', 'Large'], group='Table')
txt_align_left    = input.string('Center', title='Left Column Text Align', options=['Left', 'Center', 'Right'], group='Table')
txt_align_right   = input.string('Center', title='Right Column Text Align', options=['Left', 'Center', 'Right'], group='Table')
bg_col            = input.color(#00000000, title='Background Color', group='Table')

// Parameters
adrp_len          = input.int(20, title='ADR% Length', group='Parameters')
atr_len           = input.int(14, title='ATR Length', group='Parameters')
beta_ref_symbol   = input.string('SP:SPX', title='Beta Reference Symbol', group='Parameters')
beta_len          = input.int(252, title='Beta Lookback (bars)', group='Parameters')

// ==== Table config ====
tablePos = switch posTable
    'Top Left'     => position.top_left
    'Top Right'    => position.top_right
    'Bottom Left'  => position.bottom_left
    'Bottom Right' => position.bottom_right

size_tbl = switch tbl_size
    'Normal'  => size.normal
    'Tiny'    => size.tiny
    'Small'   => size.small
    'Large'   => size.large

align_txt_left = switch txt_align_left
    'Left'   => text.align_left
    'Center' => text.align_center
    'Right'  => text.align_right

align_txt_right = switch txt_align_right
    'Left'   => text.align_left
    'Center' => text.align_center
    'Right'  => text.align_right

// ==== Core calculations ====
tf = timeframe.period
s  = syminfo.tickerid

// ADR%
arp = 100 * (ta.sma(high / low, adrp_len) - 1)

// ATR (on chart TF)
atrValue = ta.atr(atr_len)

// Market Cap
MCap = request.financial(s, 'MARKET_CAP_BASIC', 'D', ignore_invalid_symbol=true)
if na(MCap)
    totalShares = syminfo.shares_outstanding_total
    MCap := totalShares * close

MCapDisplay = MCap
uM = ''
if MCapDisplay >= 1000 and MCapDisplay < 1000000
    MCapDisplay := MCapDisplay / 1000
    uM := 'K'
else if MCapDisplay >= 1000000 and MCapDisplay < 1000000000
    MCapDisplay := MCapDisplay / 1000000
    uM := 'M'
else if MCapDisplay >= 1000000000
    MCapDisplay := MCapDisplay / 1000000000
    uM := 'B'

// Shares Float
sharesFloat = syminfo.shares_outstanding_float
sharesFloatDisplay = sharesFloat
uF = ''
if sharesFloatDisplay >= 1000 and sharesFloatDisplay < 1000000
    sharesFloatDisplay := sharesFloatDisplay / 1000
    uF := 'K'
else if sharesFloatDisplay >= 1000000 and sharesFloatDisplay < 1000000000
    sharesFloatDisplay := sharesFloatDisplay / 1000000
    uF := 'M'
else if sharesFloatDisplay >= 1000000000
    sharesFloatDisplay := sharesFloatDisplay / 1000000000
    uF := 'B'

// Distance % from 52 Week High
closeDa = request.security(s, tf, close)
fiftyTwoWeekHigh = request.security(syminfo.tickerid, 'W', ta.highest(high, 52))
distFromHigh = 100 * (closeDa / fiftyTwoWeekHigh - 1)

// Beta vs reference index (daily log returns)
assetCloseDaily = request.security(s, 'D', close)
indexCloseDaily = request.security(beta_ref_symbol, 'D', close)

assetRet = math.log(assetCloseDaily / assetCloseDaily[1])
indexRet = math.log(indexCloseDaily / indexCloseDaily[1])

corr     = ta.correlation(assetRet, indexRet, beta_len)
assetDev = ta.stdev(assetRet, beta_len)
indexDev = ta.stdev(indexRet, beta_len)

beta = na(assetRet) or na(indexRet) or na(corr) or indexDev == 0 ? na : corr * (assetDev / indexDev)

// Volume (current bar, formatted)
vol = volume
volDisplay = vol
uV = ''
if volDisplay >= 1000 and volDisplay < 1000000
    volDisplay := volDisplay / 1000
    uV := 'K'
else if volDisplay >= 1000000 and volDisplay < 1000000000
    volDisplay := volDisplay / 1000000
    uV := 'M'
else if volDisplay >= 1000000000
    volDisplay := volDisplay / 1000000000
    uV := 'B'

// Short volume % of daily volume
short_vol  = request.security(syminfo.ticker + "_SHORT_VOLUME", "D", close)
daily_vol  = request.security(syminfo.tickerid, "D", volume)
short_pct  = daily_vol == 0 ? na : short_vol / daily_vol * 100
short_text = not na(short_pct) and short_pct < 1000 ? str.tostring(short_pct, "#.0") + "%" : "N/A"

// RS Rating
n63  = math.min(bar_index, 63)
n126 = math.min(bar_index, 126)
n189 = math.min(bar_index, 189)
n252 = math.min(bar_index, 252)

closeDaRs    = request.security(syminfo.tickerid, 'D', close)
spxcloseDaRs = request.security('SP:SPX', 'D', close)

perfTicker63  = closeDaRs / closeDaRs[n63]
perfTicker126 = closeDaRs / closeDaRs[n126]
perfTicker189 = closeDaRs / closeDaRs[n189]
perfTicker252 = closeDaRs / closeDaRs[n252]

perfComp63    = spxcloseDaRs / spxcloseDaRs[n63]
perfComp126   = spxcloseDaRs / spxcloseDaRs[n126]
perfComp189   = spxcloseDaRs / spxcloseDaRs[n189]
perfComp252   = spxcloseDaRs / spxcloseDaRs[n252]

rs_stock = 0.4 * perfTicker63 + 0.2 * perfTicker126 + 0.2 * perfTicker189 + 0.2 * perfTicker252
rs_ref   = 0.4 * perfComp63   + 0.2 * perfComp126   + 0.2 * perfComp189   + 0.2 * perfComp252
totalRsScore   = (rs_stock / rs_ref) * 100
totalRsRating  = na(totalRsScore) ? 0 : math.min(99, math.max(1, totalRsScore / 2))

tfDaily = timeframe.isdaily

// ==== Single table instance ====
var table t = table.new(tablePos, 2, 20, bgcolor=bg_col)

// ==== Draw only on last bar ====
if barstate.islast
    row = show_empty_row ? 1 : 0
    if show_empty_row
        table.cell(t, 0, 0, '')
        table.cell(t, 1, 0, '')

    table.cell(t, 0, row + 0, 'Market Cap', text_color=txt_col, text_size=size_tbl)
    table.cell(t, 1, row + 0, str.tostring(MCapDisplay, '0.00') + uM, text_color=txt_col, text_size=size_tbl)
    table.cell_set_text_halign(t, 0, row + 0, align_txt_left)
    table.cell_set_text_halign(t, 1, row + 0, align_txt_right)

    table.cell(t, 0, row + 1, 'Shares Float', text_color=txt_col, text_size=size_tbl)
    table.cell(t, 1, row + 1, str.tostring(sharesFloatDisplay, '0.00') + uF, text_color=txt_col, text_size=size_tbl)
    table.cell_set_text_halign(t, 0, row + 1, align_txt_left)
    table.cell_set_text_halign(t, 1, row + 1, align_txt_right)

    table.cell(t, 0, row + 2, 'ADR%', text_color=txt_col, text_size=size_tbl)
    table.cell(t, 1, row + 2, str.tostring(arp, '0.00') + '%', text_color=txt_col, text_size=size_tbl)
    table.cell_set_text_halign(t, 0, row + 2, align_txt_left)
    table.cell_set_text_halign(t, 1, row + 2, align_txt_right)

    table.cell(t, 0, row + 3, 'Off 52W High', text_color=txt_col, text_size=size_tbl)
    table.cell(t, 1, row + 3, str.tostring(distFromHigh, '0.0') + '%', text_color=txt_col, text_size=size_tbl)
    table.cell_set_text_halign(t, 0, row + 3, align_txt_left)
    table.cell_set_text_halign(t, 1, row + 3, align_txt_right)

    table.cell(t, 0, row + 4, 'RS Rating', text_color=txt_col, text_size=size_tbl)
    table.cell(t, 1, row + 4, tfDaily ? str.tostring(totalRsRating, '0.0') : '-', text_color=txt_col, text_size=size_tbl)
    table.cell_set_text_halign(t, 0, row + 4, align_txt_left)
    table.cell_set_text_halign(t, 1, row + 4, align_txt_right)

    atrText = na(atrValue) ? '-' : str.tostring(atrValue, '0.00')
    table.cell(t, 0, row + 5, 'ATR (' + str.tostring(atr_len) + ')', text_color=txt_col, text_size=size_tbl)
    table.cell(t, 1, row + 5, atrText, text_color=txt_col, text_size=size_tbl)
    table.cell_set_text_halign(t, 0, row + 5, align_txt_left)
    table.cell_set_text_halign(t, 1, row + 5, align_txt_right)

    betaText = na(beta) ? '-' : str.tostring(beta, '0.00')
    table.cell(t, 0, row + 6, 'Beta vs ' + beta_ref_symbol, text_color=txt_col, text_size=size_tbl)
    table.cell(t, 1, row + 6, betaText, text_color=txt_col, text_size=size_tbl)
    table.cell_set_text_halign(t, 0, row + 6, align_txt_left)
    table.cell_set_text_halign(t, 1, row + 6, align_txt_right)

    table.cell(t, 0, row + 7, 'Volume', text_color=txt_col, text_size=size_tbl)
    table.cell(t, 1, row + 7, str.tostring(volDisplay, '0.00') + uV, text_color=txt_col, text_size=size_tbl)
    table.cell_set_text_halign(t, 0, row + 7, align_txt_left)
    table.cell_set_text_halign(t, 1, row + 7, align_txt_right)

    table.cell(t, 0, row + 8, 'Short %', text_color=txt_col, text_size=size_tbl)
    table.cell(t, 1, row + 8, short_text, text_color=txt_col, text_size=size_tbl)
    table.cell_set_text_halign(t, 0, row + 8, align_txt_left)
    table.cell_set_text_halign(t, 1, row + 8, align_txt_right)

    table.cell(t, 0, row + 9, 'Target Price', text_color=txt_col, text_size=size_tbl)
    table.cell(t, 1, row + 9, 'N/A', text_color=txt_col, text_size=size_tbl)
    table.cell_set_text_halign(t, 0, row + 9, align_txt_left)
    table.cell_set_text_halign(t, 1, row + 9, align_txt_right)

    for i = 1 to add_empty_row_dn
        table.cell(t, 0, row + 9 + i, '')
        table.cell(t, 1, row + 9 + i, '')
