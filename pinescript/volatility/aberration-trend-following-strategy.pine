//@version=6
strategy("Aberration Trend-Following Strategy", 
     overlay=true, 
     initial_capital=100000, 
     default_qty_type=strategy.percent_of_equity, 
     default_qty_value=10)

// === 1. Bollinger Band Calculations ===
length = input.int(20, title="Bollinger Band Period", minval=1)
mult   = input.float(2.0, title="Bollinger Band Multiplier", minval=0.1, step=0.1)

basis     = ta.sma(close, length)
dev       = mult * ta.stdev(close, length)
upperBand = basis + dev
lowerBand = basis - dev

// === 2. Volatility Filter ===
vol_window       = input.int(50, title="Volatility Lookback Period", minval=1)
vol_threshold_lo = input.float(0.80, title="Min Volatility vs. Median", minval=0, step=0.01)
vol_threshold_hi = input.float(2.00, title="Max Volatility vs. Median", minval=0, step=0.01)
atr_len          = input.int(20, title="ATR Length", minval=1)

atr_val    = ta.atr(atr_len)
hist_vol   = ta.sma(atr_val, vol_window)
median_vol = ta.percentile_nearest_rank(hist_vol, vol_window, 50)
vol_ok     = (atr_val > median_vol * vol_threshold_lo) and (atr_val < median_vol * vol_threshold_hi)

// === 3. Entry & Exit Logic ===
long_entry  = ta.crossover(close, upperBand) and vol_ok
short_entry = ta.crossunder(close, lowerBand) and vol_ok

exit_long  = (strategy.position_size > 0) and ta.crossunder(close, basis)
exit_short = (strategy.position_size < 0) and ta.crossover(close, basis)

// === 4. Strategy Orders ===
if long_entry
    strategy.entry("Long", strategy.long)

if short_entry
    strategy.entry("Short", strategy.short)

if exit_long
    strategy.close("Long")

if exit_short
    strategy.close("Short")

// === 5. Plotting & Visualization ===
plot(upperBand, color=color.blue, linewidth=1, title="Upper Band")
plot(lowerBand, color=color.blue, linewidth=1, title="Lower Band")
plot(basis, color=color.orange, linewidth=1, title="Basis (SMA)")

// Signal markers
plotshape(long_entry, location=location.belowbar, color=color.green, style=shape.triangleup, title="LONG Signal", size=size.small)
plotshape(short_entry, location=location.abovebar, color=color.red, style=shape.triangledown, title="SHORT Signal", size=size.small)
plotshape(exit_long, location=location.abovebar, color=color.yellow, style=shape.xcross, title="EXIT Long", size=size.small)
plotshape(exit_short, location=location.belowbar, color=color.yellow, style=shape.xcross, title="EXIT Short", size=size.small)

// Bar coloring for entries
barcolor(long_entry ? color.new(color.green, 80) : short_entry ? color.new(color.red, 80) : na)
