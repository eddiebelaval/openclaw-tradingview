//@version=5
indicator("Pseudo Footprint Price Levels", overlay=true, max_labels_count=500)

// nombre de niveaux dans la bougie
levels = input.int(6, "Price levels")

// estimation volume acheteur / vendeur
buyVol  = close >= open ? volume : volume * 0.35
sellVol = close < open ? volume : volume * 0.35

// range de la bougie
priceRange = high - low

// taille d’un niveau
step = priceRange / levels

for i = 0 to levels - 1

    priceLevel = low + step * i

    // distribution simplifiée
    buyLevel  = buyVol / levels
    sellLevel = sellVol / levels

    delta = buyLevel - sellLevel

    txt =
     str.tostring(buyLevel, format.volume) +
     " | " +
     str.tostring(sellLevel, format.volume)

    col =
     delta > 0 ? color.new(color.green,70) :
     delta < 0 ? color.new(color.red,70) :
     color.gray

    label.new(
     bar_index,
     priceLevel,
     txt,
     style=label.style_label_left,
     textcolor=color.white,
     color=col,
     size=size.tiny)
