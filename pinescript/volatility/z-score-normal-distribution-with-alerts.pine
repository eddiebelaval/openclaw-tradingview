//@version=5
indicator("Normal Distribution (Z-Score) with Alerts", shorttitle="Z-Score+Alert", overlay=false)

// --- การตั้งค่า (Inputs) ---
length = input.int(20, title="Period (Length)", minval=1)
src    = input.source(close, title="Source")

// --- การคำนวณ (Calculations) ---
// สูตร: Z = (ราคา - ค่าเฉลี่ย) / ส่วนเบี่ยงเบนมาตรฐาน
mean   = ta.sma(src, length)          
stdDev = ta.stdev(src, length)      
zScore = (src - mean) / stdDev      

// --- การแสดงผล (Plotting) ---
plot(zScore, title="Z-Score", color=color.blue, linewidth=2)

// เส้นระดับ (Thresholds)
h0  = hline(0, "Mean", color=color.gray, linestyle=hline.style_dotted)
h2  = hline(2.0, "+2 SD (95%)", color=color.red, linestyle=hline.style_dashed)
h_2 = hline(-2.0, "-2 SD (95%)", color=color.green, linestyle=hline.style_dashed)
h3  = hline(3.0, "+3 SD (99.7%)", color=color.red)
h_3 = hline(-3.0, "-3 SD (99.7%)", color=color.green)

// --- การระบายสี (Fills) ---
fill(h2, h3, title="Extreme High Zone", color=color.new(color.red, 80))
fill(h_2, h_3, title="Extreme Low Zone", color=color.new(color.green, 80))

// --- ระบบการแจ้งเตือน (Alerts) ---

// 1. แจ้งเตือนเมื่อหลุดกรอบ 2 SD (โอกาสเกิดน้อยกว่า 5%)
alertcondition(ta.crossover(zScore, 2.0),  title="Z-Score Cross Over +2SD",  message="Z-Score: {{ticker}} ราคาสูงเกินไป (+2 SD)")
alertcondition(ta.crossunder(zScore, -2.0), title="Z-Score Cross Under -2SD", message="Z-Score: {{ticker}} ราคาต่ำเกินไป (-2 SD)")

// 2. แจ้งเตือนเมื่อหลุดกรอบ 3 SD (Extreme Case - โอกาสเกิดน้อยกว่า 0.3%)
alertcondition(ta.crossover(zScore, 3.0),  title="Z-Score Cross Over +3SD",  message="Extreme! {{ticker}} Z-Score ทะลุ +3 SD")
alertcondition(ta.crossunder(zScore, -3.0), title="Extreme! {{ticker}} Z-Score ทะลุ -3 SD", message="Extreme! {{ticker}} Z-Score ทะลุ -3 SD")

// 3. แจ้งเตือนเมื่อกลับเข้าสู่ค่าเฉลี่ย (Mean Reversion)
alertcondition(ta.cross(zScore, 0), title="Z-Score Back to Mean", message="Z-Score: {{ticker}} ราคากลับมาที่ค่าเฉลี่ยแล้ว")
