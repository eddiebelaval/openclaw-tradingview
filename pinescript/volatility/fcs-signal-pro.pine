//@version=5
indicator("FCS TRADE", overlay=true)

// Create a table to display the message - made smaller
var table infoTable = table.new(position.top_right, 1, 2, 
     bgcolor=color.new(color.blue, 90), 
     border_width=1, 
     border_color=color.blue,
     frame_color=color.blue,
     frame_width=1)

// Update table content
if barstate.islast
    // Welcome message - with smaller text
    table.cell(infoTable, 0, 0, "WELCOME TO FCS", 
         text_color=color.white,  // Changed to white
         text_size=size.small,
         bgcolor=color.new(color.blue, 70),
         text_halign=text.align_center,
         width=20)
    
    // Contact information - with smaller text
    table.cell(infoTable, 0, 1, "TELEGRAM: @FCS_TRADE", 
         text_color=color.white,  // Changed from yellow to white
         text_size=size.small,
         bgcolor=color.new(color.blue, 70),
         text_halign=text.align_center,
         width=20)
