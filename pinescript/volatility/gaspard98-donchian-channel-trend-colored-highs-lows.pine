//@version=6
indicator("Gaspard98 - Canal de Donchian - Plus Hauts/Bas", overlay=true)

// === Paramètres ===
length = input.int(20, "Période du Canal", minval=1)

show_bands      = input.bool(true, "Afficher les bornes")
show_median     = input.bool(true, "Afficher la médiane")
show_background = input.bool(true, "Afficher fond entre les bornes")

bull_color = input.color(color.green, "Couleur haussière (plus hauts)")
bear_color = input.color(color.red,   "Couleur baissière (plus bas)")

// === Calcul du canal Donchian ===
donchian_high = ta.highest(high, length)
donchian_low  = ta.lowest(low,  length)
donchian_mid  = (donchian_high + donchian_low) / 2

// === Détection de nouveaux plus hauts / plus bas ===
new_high = donchian_high > donchian_high[1]
new_low  = donchian_low  < donchian_low[1]

// === Détermination de la tendance ===
// Priorité aux nouveaux plus bas → baissier > haussier
var bool is_bull = true

if new_high
    is_bull := true
if new_low
    is_bull := false

current_color = is_bull ? bull_color : bear_color

// === Tracés ===
ph = plot(show_bands  ? donchian_high : na, title="Borne haute", color=current_color, linewidth=1)
pl = plot(show_bands  ? donchian_low  : na, title="Borne basse", color=current_color, linewidth=1)
plot(show_median ? donchian_mid  : na, title="Médiane",    color=current_color, linewidth=2)

// === Fond coloré entre les bandes uniquement ===
fill(ph, pl, color=show_background ? color.new(current_color, 85) : na)
