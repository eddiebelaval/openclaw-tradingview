// https://mozilla.org/MPL/2.0/
// Regime - Market Intelligence Indicator
// https://getregime.com

//@version=6
indicator("Regime - Market Intelligence", overlay=true, max_labels_count=500, max_boxes_count=500)

grp_sma     = "SMA Crossover"
smaFast     = input.int(50,  "Fast SMA Length", minval=5,  maxval=100, group=grp_sma)
smaSlow     = input.int(200, "Slow SMA Length", minval=50, maxval=500, group=grp_sma)
showSMA     = input.bool(true, "Show SMA Lines", group=grp_sma)

grp_vol     = "Volatility"
atrFast     = input.int(20,  "ATR Fast Length", minval=5,  maxval=50,  group=grp_vol)
atrSlow     = input.int(90,  "ATR Slow Length", minval=20, maxval=200, group=grp_vol)

grp_volume  = "Volume"
volAvgLen   = input.int(20,  "Volume Average Length", minval=5, maxval=100, group=grp_volume)

grp_rsi     = "RSI"
rsiLen      = input.int(14,  "RSI Length", minval=5, maxval=50, group=grp_rsi)
rsiOB       = input.int(70,  "RSI Overbought", minval=60, maxval=90, group=grp_rsi)
rsiOS       = input.int(30,  "RSI Oversold",   minval=10, maxval=40, group=grp_rsi)

grp_macd    = "MACD"
macdFast    = input.int(12,  "MACD Fast",   minval=5,  maxval=30, group=grp_macd)
macdSlow    = input.int(26,  "MACD Slow",   minval=10, maxval=50, group=grp_macd)
macdSig     = input.int(9,   "MACD Signal", minval=3,  maxval=20, group=grp_macd)

grp_display = "Display"
showBG      = input.bool(true,  "Background Color Overlay", group=grp_display)
showTable   = input.bool(true,  "Signal Breakdown Table",   group=grp_display)
showMarkers = input.bool(true,  "Regime Change Markers",    group=grp_display)
showBrand   = input.bool(true,  "Show Branding Label",      group=grp_display)
bgAlpha     = input.int(92,     "Background Transparency",  minval=80, maxval=98, group=grp_display)

grp_weights = "Signal Weights"
w_sma       = input.float(0.25, "SMA Crossover Weight",    minval=0, maxval=1, step=0.05, group=grp_weights)
w_vol       = input.float(0.15, "Volatility Weight",       minval=0, maxval=1, step=0.05, group=grp_weights)
w_volume    = input.float(0.15, "Volume Profile Weight",   minval=0, maxval=1, step=0.05, group=grp_weights)
w_rsi       = input.float(0.15, "RSI Momentum Weight",     minval=0, maxval=1, step=0.05, group=grp_weights)
w_macd      = input.float(0.15, "MACD Trend Weight",       minval=0, maxval=1, step=0.05, group=grp_weights)
w_fg        = input.float(0.15, "Fear/Greed Proxy Weight", minval=0, maxval=1, step=0.05, group=grp_weights)

sma50  = ta.sma(close, smaFast)
sma200 = ta.sma(close, smaSlow)
smaRatio = sma200 > 0 ? sma50 / sma200 : 1.0
smaSignal = smaRatio > 1.02 ? 1.0 : smaRatio < 0.98 ? -1.0 : 0.0
smaDesc   = smaRatio > 1.02 ? "Golden Cross" : smaRatio < 0.98 ? "Death Cross" : "Neutral"

atr20  = ta.atr(atrFast)
atr90  = ta.atr(atrSlow)
volRatio = atr90 > 0 ? atr20 / atr90 : 1.0
volSignal = volRatio > 1.5 ? -1.0 : volRatio < 0.7 ? 1.0 : 0.0
volDesc   = volRatio > 1.5 ? "Expansion" : volRatio < 0.7 ? "Compression" : "Normal"

volAvg   = ta.sma(volume, volAvgLen)
volLevel = volAvg > 0 ? volume / volAvg : 1.0
volumeSignal = volLevel > 1.3 ? 1.0 : volLevel < 0.7 ? -1.0 : 0.0
volumeDesc   = volLevel > 1.3 ? "High (Confirming)" : volLevel < 0.7 ? "Low (Fatigue)" : "Normal"

rsiVal = ta.rsi(close, rsiLen)
rsiSignal = rsiVal >= 50 and rsiVal <= rsiOB ? 1.0 : rsiVal <= 50 and rsiVal >= rsiOS ? -1.0 : 0.0
rsiDesc   = rsiVal >= rsiOB ? "Overbought" : rsiVal <= rsiOS ? "Oversold" : rsiVal >= 50 ? "Bullish" : "Bearish"

[macdLine, signalLine, histLine] = ta.macd(close, macdFast, macdSlow, macdSig)
macdSignal = macdLine > signalLine ? 1.0 : macdLine < signalLine ? -1.0 : 0.0
macdDesc   = macdLine > signalLine ? "Bullish Cross" : "Bearish Cross"

fgDistance = sma200 > 0 ? ((close - sma200) / sma200) * 100 : 0.0
fgValue   = math.max(0, math.min(100, 50 + fgDistance * 2))
fgSignal = fgValue >= 65 ? 1.0 : fgValue <= 35 ? -1.0 : 0.0
fgDesc   = fgValue >= 75 ? "Extreme Greed" : fgValue >= 65 ? "Greed" : fgValue <= 25 ? "Extreme Fear" : fgValue <= 35 ? "Fear" : "Neutral"

totalWeight = w_sma + w_vol + w_volume + w_rsi + w_macd + w_fg
safeWeight  = totalWeight > 0 ? totalWeight : 1.0

bullScore = (math.max(0, smaSignal) * w_sma + math.max(0, volSignal) * w_vol + math.max(0, volumeSignal) * w_volume + math.max(0, rsiSignal) * w_rsi + math.max(0, macdSignal) * w_macd + math.max(0, fgSignal) * w_fg) / safeWeight
bearScore = (math.max(0, -smaSignal) * w_sma + math.max(0, -volSignal) * w_vol + math.max(0, -volumeSignal) * w_volume + math.max(0, -rsiSignal) * w_rsi + math.max(0, -macdSignal) * w_macd + math.max(0, -fgSignal) * w_fg) / safeWeight

netScore = bullScore - bearScore
isBull = netScore > 0.2
isBear = netScore < -0.2
isChop = not isBull and not isBear

confidence = isBull ? math.min(1.0, netScore / 0.6) : isBear ? math.min(1.0, math.abs(netScore) / 0.6) : 1.0 - math.abs(netScore) / 0.2
confidencePct = math.round(confidence * 100)

regimeNum    = isBull ? 1 : isBear ? -1 : 0
regimeNumPrev = isBull[1] ? 1 : isBear[1] ? -1 : 0
regimeChanged = regimeNum != regimeNumPrev
regimeText = isBull ? "BULL" : isBear ? "BEAR" : "CHOP"

plot(showSMA ? sma50  : na, "SMA 50",  color=color.new(#3b82f6, 30), linewidth=2)
plot(showSMA ? sma200 : na, "SMA 200", color=color.new(#f59e0b, 30), linewidth=2)

bullColor = color.new(#22c55e, bgAlpha)
bearColor = color.new(#ef4444, bgAlpha)
chopColor = color.new(#eab308, bgAlpha)

bgcolor(showBG and isBull ? bullColor : na, title="Bull Background")
bgcolor(showBG and isBear ? bearColor : na, title="Bear Background")
bgcolor(showBG and isChop ? chopColor : na, title="Chop Background")

bullTransition = showMarkers and regimeChanged and isBull
bearTransition = showMarkers and regimeChanged and isBear
chopTransition = showMarkers and regimeChanged and isChop

plotshape(bullTransition, "Bull Transition", shape.triangleup,   location.belowbar, color.new(#22c55e, 0), size=size.normal)
plotshape(bearTransition, "Bear Transition", shape.triangledown, location.abovebar, color.new(#ef4444, 0), size=size.normal)
plotshape(chopTransition, "Chop Transition", shape.diamond,      location.abovebar, color.new(#eab308, 0), size=size.small)

_signalColor(sig) =>
    sig > 0 ? #22c55e : sig < 0 ? #ef4444 : #eab308

if showTable and barstate.islast
    var table sigTable = table.new(position.top_right, 3, 9, border_width=1)
    headerColor = isBull ? #22c55e : isBear ? #ef4444 : #eab308
    table.cell(sigTable, 0, 0, regimeText + " " + str.tostring(confidencePct) + "%", bgcolor=headerColor, text_color=color.white, text_size=size.large, text_halign=text.align_center)
    table.cell(sigTable, 1, 0, "Signal", bgcolor=#1e293b, text_color=#94a3b8, text_size=size.small)
    table.cell(sigTable, 2, 0, "Value", bgcolor=#1e293b, text_color=#94a3b8, text_size=size.small)
    table.cell(sigTable, 0, 1, "SMA " + str.tostring(smaFast) + "/" + str.tostring(smaSlow), bgcolor=#0f172a, text_color=#e2e8f0, text_size=size.small)
    table.cell(sigTable, 1, 1, smaDesc, bgcolor=#0f172a, text_color=_signalColor(smaSignal), text_size=size.small)
    table.cell(sigTable, 2, 1, str.tostring(smaRatio, "#.####"), bgcolor=#0f172a, text_color=#94a3b8, text_size=size.small)
    table.cell(sigTable, 0, 2, "Volatility", bgcolor=#1e293b, text_color=#e2e8f0, text_size=size.small)
    table.cell(sigTable, 1, 2, volDesc, bgcolor=#1e293b, text_color=_signalColor(volSignal), text_size=size.small)
    table.cell(sigTable, 2, 2, str.tostring(volRatio, "#.##") + "x", bgcolor=#1e293b, text_color=#94a3b8, text_size=size.small)
    table.cell(sigTable, 0, 3, "Volume", bgcolor=#0f172a, text_color=#e2e8f0, text_size=size.small)
    table.cell(sigTable, 1, 3, volumeDesc, bgcolor=#0f172a, text_color=_signalColor(volumeSignal), text_size=size.small)
    table.cell(sigTable, 2, 3, str.tostring(volLevel, "#.##") + "x avg", bgcolor=#0f172a, text_color=#94a3b8, text_size=size.small)
    table.cell(sigTable, 0, 4, "RSI", bgcolor=#1e293b, text_color=#e2e8f0, text_size=size.small)
    table.cell(sigTable, 1, 4, rsiDesc, bgcolor=#1e293b, text_color=_signalColor(rsiSignal), text_size=size.small)
    table.cell(sigTable, 2, 4, str.tostring(rsiVal, "#.#"), bgcolor=#1e293b, text_color=#94a3b8, text_size=size.small)
    table.cell(sigTable, 0, 5, "MACD", bgcolor=#0f172a, text_color=#e2e8f0, text_size=size.small)
    table.cell(sigTable, 1, 5, macdDesc, bgcolor=#0f172a, text_color=_signalColor(macdSignal), text_size=size.small)
    table.cell(sigTable, 2, 5, str.tostring(macdLine, "#.##"), bgcolor=#0f172a, text_color=#94a3b8, text_size=size.small)
    table.cell(sigTable, 0, 6, "Fear/Greed", bgcolor=#1e293b, text_color=#e2e8f0, text_size=size.small)
    table.cell(sigTable, 1, 6, fgDesc, bgcolor=#1e293b, text_color=_signalColor(fgSignal), text_size=size.small)
    table.cell(sigTable, 2, 6, str.tostring(fgValue, "#") + "/100", bgcolor=#1e293b, text_color=#94a3b8, text_size=size.small)
    table.cell(sigTable, 0, 7, "Net Score", bgcolor=#0f172a, text_color=#e2e8f0, text_size=size.small)
    scoreColor = netScore > 0.2 ? #22c55e : netScore < -0.2 ? #ef4444 : #eab308
    table.cell(sigTable, 1, 7, str.tostring(netScore, "+#.###;-#.###"), bgcolor=#0f172a, text_color=scoreColor, text_size=size.small)
    table.cell(sigTable, 2, 7, str.tostring(bullScore, "#.##") + " / " + str.tostring(bearScore, "#.##"), bgcolor=#0f172a, text_color=#94a3b8, text_size=size.small)
    table.cell(sigTable, 0, 8, "getregime.com", bgcolor=#0f172a, text_color=#60a5fa, text_size=size.tiny, tooltip="Full regime API at getregime.com")
    table.cell(sigTable, 1, 8, "Full API", bgcolor=#0f172a, text_color=#60a5fa, text_size=size.tiny, tooltip="Free: regime, signals. Pro $49/mo: crowd positioning, divergences, alerts. getregime.com/quickstart")
    table.cell(sigTable, 2, 8, "", bgcolor=#0f172a, text_color=#94a3b8, text_size=size.tiny)

if showBrand and barstate.islast
    var table brandTable = table.new(position.bottom_right, 1, 1)
    table.cell(brandTable, 0, 0, "Regime Intelligence | getregime.com/quickstart", bgcolor=color.new(#0f172a, 40), text_color=#60a5fa, text_size=size.small, tooltip="On-chart regime classifier. Full API at getregime.com/quickstart")

alertcondition(bullTransition, "Regime: Bull", "Regime shifted to BULL")
alertcondition(bearTransition, "Regime: Bear", "Regime shifted to BEAR")
alertcondition(chopTransition, "Regime: Chop", "Regime shifted to CHOP")
alertcondition(regimeChanged,  "Regime Changed", "Regime transition detected")
