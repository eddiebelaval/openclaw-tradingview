//@version=6
indicator("Supertrend Signals Only - v6", 
     overlay=true, 
     format=format.price, 
     precision=2)

// ===== INPUTS =====
atrPeriod   = input.int(10, "ATR Period")
multiplier  = input.float(3.0, "ATR Multiplier", step=0.1)
src         = input.source(hl2, "Source")
useRmaAtr   = input.bool(true, "Use Built-in ATR (RMA)?")
showSignals = input.bool(true, "Show Buy/Sell Signals?")

// ===== ATR CALCULATION =====
atrAlt  = ta.sma(ta.tr(true), atrPeriod)
atrVal  = useRmaAtr ? ta.atr(atrPeriod) : atrAlt

// ===== BAND CALCULATION (INTERNAL ONLY) =====
upperBand = src - (multiplier * atrVal)
lowerBand = src + (multiplier * atrVal)

prevUpper = na(upperBand[1]) ? upperBand : upperBand[1]
prevLower = na(lowerBand[1]) ? lowerBand : lowerBand[1]

upperBand := close[1] > prevUpper ? math.max(upperBand, prevUpper) : upperBand
lowerBand := close[1] < prevLower ? math.min(lowerBand, prevLower) : lowerBand

// ===== TREND LOGIC =====
var int trend = 1
trend := trend == -1 and close > prevLower ? 1 :
         trend == 1 and close < prevUpper ? -1 :
         trend

// ===== SIGNALS =====
buySignal  = trend == 1 and trend[1] == -1
sellSignal = trend == -1 and trend[1] == 1

// ===== PLOT SIGNALS ONLY =====
plotshape(showSignals and buySignal,
     title="Buy Signal",
     location=location.belowbar,
     style=shape.labelup,
     size=size.small,
     color=color.green,
     text="BUY",
     textcolor=color.white)

plotshape(showSignals and sellSignal,
     title="Sell Signal",
     location=location.abovebar,
     style=shape.labeldown,
     size=size.small,
     color=color.red,
     text="SELL",
     textcolor=color.white)

// ===== ALERTS =====
alertcondition(buySignal, title="Supertrend Buy", message="Supertrend Buy Signal")
alertcondition(sellSignal, title="Supertrend Sell", message="Supertrend Sell Signal")
alertcondition(trend != trend[1], title="Supertrend Direction Change", message="Supertrend Direction Changed")
