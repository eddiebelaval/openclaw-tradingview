//@version=6
//Mercy
indicator("TPI 15m ONLY - by Mercy", overlay=false, max_lines_count=500)

//───────────────────────────────
// FIXED VALUES (previous inputs removed)
//───────────────────────────────
debugMode = false

// SUPER TREND (formerly inputs)
st_atr    = 96
st_factor = 2.0
st_tf     = "30"

// TSI (formerly inputs)
tsi_long   = 25
tsi_short  = 13
tsi_signal = 13

// EMA (formerly inputs)
emaS_len = 18
emaB_len = 36

// SWING / BOS (formerly inputs)
leftBars  = 1
rightBars = 1
showSwing = false
showBOS   = false
showBg    = false
lineStyleValue = line.style_solid

//───────────────────────────────
// SUPER TREND
//───────────────────────────────
[st_val, st_dir] = request.security(syminfo.tickerid, st_tf, ta.supertrend(st_factor, st_atr), lookahead=barmerge.lookahead_off)
closeST = request.security(syminfo.tickerid, st_tf, close, lookahead=barmerge.lookahead_off)

isAboveSupertrend = closeST > st_val
supertrendScore = isAboveSupertrend ? 1.0 : -1.0

//───────────────────────────────
// TSI - Fixed 15m
//───────────────────────────────
double_smooth(src, longLen, shortLen) =>
    f = ta.ema(src, longLen)
    ta.ema(f, shortLen)

close15TSI = request.security(syminfo.tickerid, "15", close, lookahead=barmerge.lookahead_off)
pc = ta.change(close15TSI)
num = double_smooth(pc, tsi_long, tsi_short)
den = double_smooth(math.abs(pc), tsi_long, tsi_short)

tsi_val = den == 0 ? 0.0 : 100 * (num / den)
tsi_sig = ta.ema(tsi_val, tsi_signal)

tsi_above_signal = tsi_val > tsi_sig
tsi_above_zero   = tsi_val > 0
tsiScore = tsi_above_signal and tsi_above_zero ? 1 :
     tsi_above_signal and not tsi_above_zero ? 0.5 :
     not tsi_above_signal and not tsi_above_zero ? -1 : 0.5

//───────────────────────────────
// EMA LOGIC
//───────────────────────────────
close15EMA = request.security(syminfo.tickerid, "15", close, lookahead=barmerge.lookahead_off)
emaS = request.security(syminfo.tickerid, "15", ta.ema(close, emaS_len), lookahead=barmerge.lookahead_off)
emaB = request.security(syminfo.tickerid, "15", ta.ema(close, emaB_len), lookahead=barmerge.lookahead_off)

emaGreen = emaS >= emaB
priceAboveBoth = close15EMA > emaS and close15EMA > emaB
priceBelowBoth = close15EMA < emaS and close15EMA < emaB
priceBetween  = close15EMA > math.min(emaS, emaB) and close15EMA < math.max(emaS, emaB)

emaScore = emaGreen ?
     (priceAboveBoth ? 1 : priceBetween ? 0.5 : 0.5) :
     (priceBelowBoth ? -1 : priceBetween ? -0.5 : -0.5)

//───────────────────────────────
// DYNAMIC SWING + BOS/MSB + TREND
//───────────────────────────────
var float currentSH = na
var int   currentSHIndex = na
var float currentSL = na
var int   currentSLIndex = na
var float prevSH = na
var int   prevSHIndex = na
var float prevSL = na
var int   prevSLIndex = na

var string lastSwingType = ""
var bool bosReady = true
var string lastBOSDirection = ""
var string trendDir = "NEUTRAL"
var color trendColor = na

// === DYNAMIC SWINGS ===
if lastSwingType == ""
    if close > open
        currentSH := close
        currentSHIndex := bar_index
        lastSwingType := "SH"
    else
        currentSL := close
        currentSLIndex := bar_index
        lastSwingType := "SL"

if lastSwingType == "SH"
    if close > currentSH
        currentSH := close
        currentSHIndex := bar_index
    else if close < currentSH
        prevSH := currentSH
        prevSHIndex := currentSHIndex
        currentSL := close
        currentSLIndex := bar_index
        lastSwingType := "SL"
        bosReady := true

if lastSwingType == "SL"
    if close < currentSL
        currentSL := close
        currentSLIndex := bar_index
    else if close > currentSL
        prevSL := currentSL
        prevSLIndex := currentSLIndex
        currentSH := close
        currentSHIndex := bar_index
        lastSwingType := "SH"
        bosReady := true

// BOS / MSB SYSTEM
var float lastBullishOriginSL = na
var int   lastBullishOriginSLIndex = na
var float lastBearishOriginSH = na
var int   lastBearishOriginSHIndex = na
var string prevBOSDirection = ""
var int    consecutiveBOSCount = 0

if bosReady and not na(prevSH) and not na(prevSL)
    if close > prevSH
        isMSB = lastBOSDirection == "DOWN" and not na(lastBearishOriginSH) and close > lastBearishOriginSH
        if prevBOSDirection == "UP" and not isMSB
            consecutiveBOSCount += 1
        else
            consecutiveBOSCount := 1
        prevBOSDirection := "UP"
        if isMSB or consecutiveBOSCount >= 2
            trendDir := "UP"
            trendColor := color.new(color.green, 90)
        lastBOSDirection := "UP"
        lastBullishOriginSL := prevSL
        lastBullishOriginSLIndex := prevSLIndex
        bosReady := false

    if close < prevSL
        isMSB = lastBOSDirection == "UP" and not na(lastBullishOriginSL) and close < lastBullishOriginSL
        if prevBOSDirection == "DOWN" and not isMSB
            consecutiveBOSCount += 1
        else
            consecutiveBOSCount := 1
        prevBOSDirection := "DOWN"
        if isMSB or consecutiveBOSCount >= 2
            trendDir := "DOWN"
            trendColor := color.new(color.red, 90)
        lastBOSDirection := "DOWN"
        lastBearishOriginSH := prevSH
        lastBearishOriginSHIndex := prevSHIndex
        bosReady := false

//───────────────────────────────
// MULTI-TF TPI
//───────────────────────────────
trend_4H  = request.security(syminfo.tickerid, "240", trendDir, lookahead=barmerge.lookahead_on)
trend_1H  = request.security(syminfo.tickerid, "60", trendDir, lookahead=barmerge.lookahead_on)
trend_15m = trendDir

tpi_4H  = trend_4H  == "UP" ? 1 : trend_4H  == "DOWN" ? -1 : 0
tpi_1H  = trend_1H  == "UP" ? 1 : trend_1H  == "DOWN" ? -1 : 0
tpi_15m = trend_15m == "UP" ? 1 : trend_15m == "DOWN" ? -1 : 0

TPI = (tpi_4H + tpi_1H + tpi_15m + tsiScore + emaScore + supertrendScore) / 6
TPI_rounded = math.round(TPI * 100) / 100
TPI_str = str.tostring(TPI, "#.##")

//───────────────────────────────
// COLOR GRADIENT DOT SYSTEM
//───────────────────────────────
f_colorGradient(_from, _to, _step) =>
    color.rgb(color.r(_from) + (color.r(_to) - color.r(_from)) * _step, color.g(_from) + (color.g(_to) - color.g(_from)) * _step, color.b(_from) + (color.b(_to) - color.b(_from)) * _step)

rLow  = color.rgb(253, 236, 234)
rHigh = color.rgb(183, 28, 28)
gLow  = color.rgb(232, 245, 233)
gHigh = color.rgb(27, 94, 32)

normTPI = math.max(-1, math.min(TPI, 1))

dotColor = normTPI > 0 ? f_colorGradient(gLow, gHigh, normTPI) :
           normTPI < 0 ? f_colorGradient(rLow, rHigh, math.abs(normTPI)) :
           color.rgb(150,150,150)

plot(TPI, style=plot.style_circles, color=dotColor, linewidth=3, precision=2)

hline(1.0,  "Upper Limit", color=color.new(color.green, 50))
hline(0.5,  "Upper med",   color=color.new(color.gray, 50))
hline(0.0,  "Zero",        color=color.new(color.white, 50))
hline(-0.5, "Lower med",   color=color.new(color.gray, 50))
hline(-1.0, "Lower Limit", color=color.new(color.red, 50))
