//@version=6
indicator("JEETU SR FINAL — VISUAL AUTO", overlay=true, max_labels_count=500)

// =====================================================
// INPUTS
// =====================================================
sup_level_in = input.float(0.0, "Manual Support (0 OFF)")
res_level_in = input.float(0.0, "Manual Resistance (0 OFF)")
buffer_pts   = input.int(0, "Buffer")

sl_points = input.float(10, "SL")
ce_tp_pts = input.float(20, "BUY TP")
pe_tp_pts = input.float(20, "SELL TP")

// =====================================================
// MANUAL LEVELS
// =====================================================
use_sup = sup_level_in > 0
use_res = res_level_in > 0

sup = use_sup ? sup_level_in - buffer_pts : na
res = use_res ? res_level_in + buffer_pts : na

plot(sup, "Manual Support", color=color.green, linewidth=2)
plot(res, "Manual Resistance", color=color.red, linewidth=2)

// =====================================================
// DAY OPEN LOGIC
// =====================================================
is_new_day = ta.change(time("D"))
var float day_open = na
var float prev_day_open = na

if bool(is_new_day)
    prev_day_open := na(day_open) ? open : day_open
    day_open := open

day_open := na(day_open) ? open : day_open
plot(day_open, "Day Open", color=color.yellow, linewidth=2)

// =====================================================
// AUTO OPEN LEVELS
// =====================================================
var float auto_sup = na
var float auto_res = na

round100_up   = math.ceil(day_open / 100) * 100
round100_down = math.floor(day_open / 100) * 100
round50_down  = math.floor(day_open / 50) * 50

is_green_day = day_open > prev_day_open
is_red_day   = day_open < prev_day_open

// RED DAY → 100 grid
if is_red_day
    auto_res := round100_up
    auto_sup := round100_down

// GREEN DAY → 50 + 100 grid
if is_green_day
    auto_sup := round50_down
    auto_res := round50_down + 100

plot(auto_sup, "AUTO SUPPORT", color=color.new(color.green,0), linewidth=3)
plot(auto_res, "AUTO RESIST", color=color.new(color.red,0), linewidth=3)

// =====================================================
// TRADE STATE
// =====================================================
var int trade = 0
var float entry = na
var float sl = na
var float tp = na

// =====================================================
// ENTRY
// =====================================================
buy_signal =
     use_sup and trade == 0 and
     close[1] <= sup and close > sup

sell_signal =
     use_res and trade == 0 and
     close[1] >= res and close < res

if buy_signal
    trade := 1
    entry := close
    sl := sup - sl_points
    tp := sup + ce_tp_pts

if sell_signal
    trade := -1
    entry := close
    sl := res + sl_points
    tp := res - pe_tp_pts

// =====================================================
// CROSS GLOBAL
// =====================================================
cross_tp_up   = ta.crossover(close, tp)
cross_tp_down = ta.crossunder(close, tp)
cross_sl_up   = ta.crossover(close, sl)
cross_sl_down = ta.crossunder(close, sl)

// =====================================================
// EXIT
// =====================================================
buy_exit  = trade == 1 and (cross_tp_up or cross_sl_down)
sell_exit = trade == -1 and (cross_tp_down or cross_sl_up)

if buy_exit or sell_exit
    trade := 0

// =====================================================
// VISUALS
// =====================================================

// entry arrows
plotshape(buy_signal,  style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.small, title="BUY")
plotshape(sell_signal, style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.small, title="SELL")

// exit marks
plotshape(buy_exit,  style=shape.xcross, location=location.abovebar, color=color.green, title="BUY EXIT")
plotshape(sell_exit, style=shape.xcross, location=location.belowbar, color=color.red, title="SELL EXIT")

// tp/sl/entry lines
plot(trade != 0 ? tp : na, "TP", color=color.blue, linewidth=2, style=plot.style_linebr)
plot(trade != 0 ? sl : na, "SL", color=color.orange, linewidth=2, style=plot.style_linebr)
plot(trade != 0 ? entry : na, "ENTRY", color=color.white, linewidth=2, style=plot.style_linebr)

// =====================================================
// ALERTS (SIMPLE)
// =====================================================
alertcondition(buy_signal,  title="BUY", message="BUY")
alertcondition(sell_signal, title="SELL", message="SELL")
alertcondition(buy_exit,    title="BUY EXIT", message="BUY EXIT")
alertcondition(sell_exit,   title="SELL EXIT", message="SELL EXIT")
