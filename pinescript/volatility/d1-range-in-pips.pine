//@version=5
indicator("Daily Range in Pips", overlay=true)

// Input settings
cornerPosition = input.string("Top Right", "Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"])
boxColor = input.color(color.red, "Box Color")
textColor = input.color(color.white, "Text Color")
textSizeOption = input.string("Normal", "Text Size", options=["Small", "Normal", "Large"])

// Get daily high and low
dailyHigh = request.security(syminfo.tickerid, "D", high)
dailyLow = request.security(syminfo.tickerid, "D", low)

// Calculate range
dailyRange = dailyHigh - dailyLow

// Convert to pips (for forex pairs, 1 pip = 0.0001 for most pairs, 0.01 for JPY pairs)
pipMultiplier = str.contains(syminfo.ticker, "JPY") ? 100 : 10000
rangeInPips = dailyRange * pipMultiplier

// Determine table position
tablePosition = cornerPosition == "Top Left" ? position.top_left : cornerPosition == "Top Right" ? position.top_right : cornerPosition == "Bottom Left" ? position.bottom_left : position.bottom_right

// Determine text size
fontSize = textSizeOption == "Small" ? size.small : textSizeOption == "Normal" ? size.normal : size.large

// Display in table
var table pipTable = table.new(tablePosition, 1, 1)
table.cell(pipTable, 0, 0, "D1\n" + str.tostring(rangeInPips, "#.#") + " pips", bgcolor=boxColor, text_color=textColor, text_size=fontSize)
