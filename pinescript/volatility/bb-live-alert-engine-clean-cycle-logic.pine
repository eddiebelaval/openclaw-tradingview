//@version=6
indicator("BB Live Alert Engine - Production", overlay=true, max_labels_count=500)

//====================================================
// INPUTS
//====================================================
bbLength = input.int(21, "Bollinger Length", minval=1)
bbMult   = input.float(2.1, "Bollinger Multiplier", step=0.1)
showSignals = input.bool(true, "Show Signal Markers")

//====================================================
// BOLLINGER BANDS (CALCULATION ONLY)
// Keep TradingView's standard BB on chart for visuals
//====================================================
[bbBasis, bbUpper, bbLower] = ta.bb(close, bbLength, bbMult)

//====================================================
// TRADE CYCLE STATE
//  0 = flat
//  1 = long cycle active
// -1 = short cycle active
//====================================================
var int cycleState    = 0
var int entryBarIndex = na
var int entryCount    = 0

//====================================================
// INTRABAR / PER-BAR GUARDS
// These prevent duplicate alerts on the same candle
//====================================================
varip bool openLongFiredThisBar   = false
varip bool openShortFiredThisBar  = false
varip bool avgLongFiredThisBar    = false
varip bool avgShortFiredThisBar   = false
varip bool closeLongFiredThisBar  = false
varip bool closeShortFiredThisBar = false
varip bool closedThisBar          = false

//====================================================
// MARKER MEMORY
// Using varip keeps markers stable during realtime bar updates
//====================================================
varip bool  longMarkerThisBar  = false
varip bool  shortMarkerThisBar = false
varip bool  closeMarkerThisBar = false
varip float closeMarkerPrice   = na

//====================================================
// RESET AT START OF EACH NEW BAR
//====================================================
if barstate.isnew
    openLongFiredThisBar   := false
    openShortFiredThisBar  := false
    avgLongFiredThisBar    := false
    avgShortFiredThisBar   := false
    closeLongFiredThisBar  := false
    closeShortFiredThisBar := false
    closedThisBar          := false

    longMarkerThisBar      := false
    shortMarkerThisBar     := false
    closeMarkerThisBar     := false
    closeMarkerPrice       := na

//====================================================
// OPEN LOGIC (REALTIME)
//====================================================
canOpenLong =
     cycleState == 0 and
     not closedThisBar and
     not openLongFiredThisBar and
     not openShortFiredThisBar and
     low < bbLower

canOpenShort =
     cycleState == 0 and
     not closedThisBar and
     not openLongFiredThisBar and
     not openShortFiredThisBar and
     high > bbUpper

if canOpenLong
    cycleState := 1
    entryBarIndex := bar_index
    entryCount := 1

    openLongFiredThisBar := true
    longMarkerThisBar := true

    alert("OPEN LONG | " + syminfo.ticker + " | TF " + timeframe.period, alert.freq_once_per_bar)

if canOpenShort
    cycleState := -1
    entryBarIndex := bar_index
    entryCount := 1

    openShortFiredThisBar := true
    shortMarkerThisBar := true

    alert("OPEN SHORT | " + syminfo.ticker + " | TF " + timeframe.period, alert.freq_once_per_bar)

//====================================================
// CLOSE LOGIC (REALTIME)
// First touch of middle band closes the entire active cycle
// One close marker only for that cycle
//====================================================
canCloseLong =
     cycleState == 1 and
     entryCount > 0 and
     not closeLongFiredThisBar and
     high >= bbBasis

canCloseShort =
     cycleState == -1 and
     entryCount > 0 and
     not closeShortFiredThisBar and
     low <= bbBasis

if canCloseLong
    closeLongFiredThisBar := true
    closedThisBar := true
    closeMarkerThisBar := true
    closeMarkerPrice := bbBasis

    cycleState := 0
    entryBarIndex := na
    entryCount := 0

    alert("CLOSE LONG | " + syminfo.ticker + " | TF " + timeframe.period, alert.freq_once_per_bar)

if canCloseShort
    closeShortFiredThisBar := true
    closedThisBar := true
    closeMarkerThisBar := true
    closeMarkerPrice := bbBasis

    cycleState := 0
    entryBarIndex := na
    entryCount := 0

    alert("CLOSE SHORT | " + syminfo.ticker + " | TF " + timeframe.period, alert.freq_once_per_bar)

//====================================================
// AVERAGING LOGIC (ONLY ON BAR CLOSE)
// No averaging on entry bar
//====================================================
canAverageLong =
     barstate.isconfirmed and
     cycleState == 1 and
     not closedThisBar and
     not avgLongFiredThisBar and
     not na(entryBarIndex) and
     bar_index > entryBarIndex and
     close < bbLower

canAverageShort =
     barstate.isconfirmed and
     cycleState == -1 and
     not closedThisBar and
     not avgShortFiredThisBar and
     not na(entryBarIndex) and
     bar_index > entryBarIndex and
     close > bbUpper

if canAverageLong
    entryCount += 1
    avgLongFiredThisBar := true
    longMarkerThisBar := true

    alert("AVERAGE LONG | " + syminfo.ticker + " | TF " + timeframe.period, alert.freq_once_per_bar_close)

if canAverageShort
    entryCount += 1
    avgShortFiredThisBar := true
    shortMarkerThisBar := true

    alert("AVERAGE SHORT | " + syminfo.ticker + " | TF " + timeframe.period, alert.freq_once_per_bar_close)

//====================================================
// PLOTS
// Green triangle = long open / average
// Red triangle   = short open / average
// Orange cross   = cycle close at exact middle-band price
//====================================================
plotshape(
     showSignals and longMarkerThisBar,
     title="Long Event",
     style=shape.triangleup,
     location=location.belowbar,
     size=size.tiny,
     color=color.lime
)

plotshape(
     showSignals and shortMarkerThisBar,
     title="Short Event",
     style=shape.triangledown,
     location=location.abovebar,
     size=size.tiny,
     color=color.red
)

// Using plot.style_cross instead of plotshape() keeps the X pinned
// exactly to the middle-band price, so it should not look like it is floating.
plot(
     showSignals and closeMarkerThisBar ? closeMarkerPrice : na,
     title="Close Marker",
     style=plot.style_cross,
     linewidth=3,
     color=color.orange
)
