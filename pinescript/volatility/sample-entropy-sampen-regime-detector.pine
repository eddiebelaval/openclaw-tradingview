//@version=6
indicator("Sample Entropy (SampEn) Regime Detector", overlay=true, max_bars_back=500)

// --- Inputs ---
int   len      = input.int(50, "Lookback Window (N)", minval=10, tooltip="Number of bars to analyze. Larger window = more stability, but slower reaction.")
int   m        = input.int(2, "Embedding Dimension (m)", minval=1, maxval=4, tooltip="The sequence length for pattern matching.")
float r_mult   = input.float(0.2, "Tolerance (r)", step=0.05, tooltip="Multiplier for StdDev to define a match between price points.")
float thresh_L = input.float(1.2, "Low Entropy Threshold", step=0.1, tooltip="Below this value, market is 'Predictable' (Green).")
float thresh_H = input.float(2.0, "High Entropy Threshold", step=0.1, tooltip="Above this value, market is 'Chaotic' (Red).")

// --- Core SampEn Function ---
f_sampen(float source, int length, int dim, float tolerance_mult) =>
    float sd = ta.stdev(source, length)
    float r = tolerance_mult * sd
    int A = 0
    int B = 0
    for i = 0 to length - dim - 1
        for j = i + 1 to length - dim
            bool match_m = true
            for k = 0 to dim - 1
                if math.abs(source[i+k] - source[j+k]) >= r
                    match_m := false
                    break
            if match_m
                B += 1
                if math.abs(source[i+dim] - source[j+dim]) < r
                    A += 1
    A > 0 and B > 0 ? -math.log(A / float(B)) : 3.0

// --- Calculation ---
float sampen_val = f_sampen(close, len, m, r_mult)

// --- Adaptive Smoothing (Yellow EMA) ---
float alpha = 2.0 / (10.0 + (sampen_val * 15.0) + 1.0)
var float adaptive_ema = close
adaptive_ema := (close * alpha) + (nz(adaptive_ema, close) * (1.0 - alpha))
plot(adaptive_ema, "Adaptive EMA", color=color.yellow, linewidth=2)

// --- Regime Visuals ---
bool is_predictable = sampen_val < thresh_L
bool is_chaotic     = sampen_val > thresh_H
color bg_color = is_predictable ? color.new(color.lime, 85) : is_chaotic ? color.new(color.red, 85) : na
bgcolor(bg_color, title="Market Regime Background")

// --- Corrected Alerts (v6 compatible) ---
if ta.crossunder(sampen_val, thresh_L)
    alert("SampEn PREDICTABLE: Market structure found. Trend-following or Mean-reversion systems ACTIVE.", alert.freq_once_per_bar)

if ta.crossover(sampen_val, thresh_H)
    alert("SampEn CHAOTIC: Random price action detected. Reduce risk or wait for stabilization.", alert.freq_once_per_bar)

// Info Dashboard
var table dash = table.new(position.top_right, 2, 1, bgcolor=color.new(color.black, 50), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "SampEn Score:", text_color=color.white)
    table.cell(dash, 1, 0, str.tostring(sampen_val, "#.##"), text_color=is_predictable ? color.lime : is_chaotic ? color.red : color.orange)
