//@version=5
indicator("Smart Money Engine PRO", overlay=false)

//--------------------------------------------------
// INPUTS
//--------------------------------------------------

cvdSmoothLen = input.int(40, "CVD Smooth Length")
volLen = input.int(20, "Volume Average")
atrLen = input.int(14, "ATR Length")
trendLen = input.int(50, "Trend Length")

//--------------------------------------------------
// DELTA HESABI
//--------------------------------------------------

buyVol = close > open ? volume : 0.0
sellVol = close < open ? volume : 0.0

delta = buyVol - sellVol

// CVD
cvd = ta.cum(delta)
cvdSmooth = ta.ema(cvd, cvdSmoothLen)

//--------------------------------------------------
// CVD SLOPE
//--------------------------------------------------

cvdSlope = cvdSmooth - cvdSmooth[1]

//--------------------------------------------------
// VOLUME PRESSURE
//--------------------------------------------------

volAvg = ta.sma(volume, volLen)
volPressure = volume / volAvg

//--------------------------------------------------
// VOLATILITY PRESSURE
//--------------------------------------------------

atr = ta.atr(atrLen)
atrAvg = ta.sma(atr, 50)
volatilityPressure = atr / atrAvg

//--------------------------------------------------
// TREND FILTER
//--------------------------------------------------

emaTrend = ta.ema(close, trendLen)

trendBull = close > emaTrend
trendBear = close < emaTrend

//--------------------------------------------------
// SMART MONEY PRESSURE
//--------------------------------------------------

pressure =
     (cvdSlope * 0.55) +
     (volPressure * 0.30) +
     (volatilityPressure * 0.15)

//--------------------------------------------------
// TRAP DETECTION
//--------------------------------------------------

bullTrap =
     close > close[1] and
     cvdSlope < 0

bearTrap =
     close < close[1] and
     cvdSlope > 0

//--------------------------------------------------
// CVD DIVERGENCE
//--------------------------------------------------

bullDiv =
     low < low[1] and
     cvdSmooth > cvdSmooth[1]

bearDiv =
     high > high[1] and
     cvdSmooth < cvdSmooth[1]

//--------------------------------------------------
// TREND MODE
//--------------------------------------------------

trendStrength = ta.ema(math.abs(cvdSlope), 20)

trendMode = trendStrength > ta.sma(trendStrength, 50)

//--------------------------------------------------
// PLOTS
//--------------------------------------------------

hline(0)

plot(pressure, title="Smart Money Pressure", linewidth=2,
     color = pressure > 0 ? color.lime : color.red)

plot(cvdSmooth, title="CVD", color=color.orange)

// traps
plotshape(bullTrap, title="Bull Trap",
     style=shape.triangledown,
     location=location.top,
     color=color.red)

plotshape(bearTrap, title="Bear Trap",
     style=shape.triangleup,
     location=location.bottom,
     color=color.green)

// divergence
plotshape(bullDiv, title="Bull Div",
     style=shape.circle,
     location=location.bottom,
     color=color.lime)

plotshape(bearDiv, title="Bear Div",
     style=shape.circle,
     location=location.top,
     color=color.red)

// trend mode
bgcolor(trendMode ? color.new(color.green,90) : color.new(color.gray,90))
