//@version=6
indicator('Bollinger MTF', shorttitle = 'Bollinger MTF', overlay = true)

// --- INPUTS ---


// --- BOLLINGER BANDS ---
bbLength    = input.int(20, 'Length', minval = 1, group = 'General BB Settings', inline = 'BBGen')
bbStdDev    = input.float(2.0, 'StdDev', minval = 0.001, step = 0.1, group = 'General BB Settings', inline = 'BBGen')

// Chart BB
showBB       = input.bool(true, 'Chart BB', group = 'Chart BB', inline = 'BBChart')
bbColor      = input.color(color.new(#29D9E6, 0), '', group = 'Chart BB', inline = 'BBChart')
bbFillColor  = input.color(color.new(#29D9E6, 80), '', group = 'Chart BB', inline = 'BBChart')
showBBCenter = input.bool(false, 'Center', group = 'Chart BB', inline = 'BBChart')

// Multiple Timeframes
showBB15       = input.bool(false, '15m BB', group = 'Multiple Timeframes', inline = 'BB15')
bbColor15      = input.color(color.new(#299DE6, 0), '', group = 'Multiple Timeframes', inline = 'BB15')
bbFillColor15  = input.color(color.new(#299DE6, 80), '', group = 'Multiple Timeframes', inline = 'BB15')
showBBCenter15 = input.bool(false, 'Center', group = 'Multiple Timeframes', inline = 'BB15')

showBB60       = input.bool(false, '1h BB', group = 'Multiple Timeframes', inline = 'BB60')
bbColor60      = input.color(color.new(#2962E6, 0), '', group = 'Multiple Timeframes', inline = 'BB60')
bbFillColor60  = input.color(color.new(#2962E6, 80), '', group = 'Multiple Timeframes', inline = 'BB60')
showBBCenter60 = input.bool(false, 'Center', group = 'Multiple Timeframes', inline = 'BB60')

showBB240       = input.bool(true, '4h BB', group = 'Multiple Timeframes', inline = 'BB240')
bbColor240      = input.color(color.new(#2C29E6, 0), '', group = 'Multiple Timeframes', inline = 'BB240')
bbFillColor240  = input.color(color.new(#2C29E6, 80), '', group = 'Multiple Timeframes', inline = 'BB240')
showBBCenter240 = input.bool(false, 'Center', group = 'Multiple Timeframes', inline = 'BB240')

showBB1D       = input.bool(true, '1d BB', group = 'Multiple Timeframes', inline = 'BB1D')
bbColor1D      = input.color(color.new(#29E6B3, 0), '', group = 'Multiple Timeframes', inline = 'BB1D')
bbFillColor1D  = input.color(color.new(#29E6B3, 90), '', group = 'Multiple Timeframes', inline = 'BB1D')
showBBCenter1D = input.bool(true, 'Center', group = 'Multiple Timeframes', inline = 'BB1D')

showBB1W       = input.bool(true, '1w BB', group = 'Multiple Timeframes', inline = 'BB1W')
bbColor1W      = input.color(color.new(#87D673, 0), '', group = 'Multiple Timeframes', inline = 'BB1W')
bbFillColor1W  = input.color(color.new(#87D673, 95), '', group = 'Multiple Timeframes', inline = 'BB1W')
showBBCenter1W = input.bool(false, 'Center', group = 'Multiple Timeframes', inline = 'BB1W')

showBB1M       = input.bool(false, '1M BB', group = 'Multiple Timeframes', inline = 'BB1M')
bbColor1M      = input.color(color.new(#EDDE54, 0), '', group = 'Multiple Timeframes', inline = 'BB1M')
bbFillColor1M  = input.color(color.new(#EDDE54, 90), '', group = 'Multiple Timeframes', inline = 'BB1M')
showBBCenter1M = input.bool(false, 'Center', group = 'Multiple Timeframes', inline = 'BB1M')


// BB calculation
[bbBasisRaw, bbUpperRaw, bbLowerRaw] = ta.bb(close, bbLength, bbStdDev)

// Chart BB
bbBasis  = bbBasisRaw
bbUpper  = bbUpperRaw
bbLower  = bbLowerRaw

// MTF Security Calls
[bbBasis15, bbUpper15, bbLower15]   = request.security(syminfo.tickerid, "15", [bbBasisRaw, bbUpperRaw, bbLowerRaw], gaps = barmerge.gaps_off)
[bbBasis60, bbUpper60, bbLower60]   = request.security(syminfo.tickerid, "60", [bbBasisRaw, bbUpperRaw, bbLowerRaw], gaps = barmerge.gaps_off)
[bbBasis240, bbUpper240, bbLower240] = request.security(syminfo.tickerid, "240", [bbBasisRaw, bbUpperRaw, bbLowerRaw], gaps = barmerge.gaps_off)
[bbBasis1D, bbUpper1D, bbLower1D]   = request.security(syminfo.tickerid, "D", [bbBasisRaw, bbUpperRaw, bbLowerRaw], gaps = barmerge.gaps_off)
[bbBasis1W, bbUpper1W, bbLower1W]   = request.security(syminfo.tickerid, "W", [bbBasisRaw, bbUpperRaw, bbLowerRaw], gaps = barmerge.gaps_off)
[bbBasis1M, bbUpper1M, bbLower1M]   = request.security(syminfo.tickerid, "M", [bbBasisRaw, bbUpperRaw, bbLowerRaw], gaps = barmerge.gaps_off)




// --- BOLLINGER BANDS PLOTTING ---
// Chart BB
bbUpperPlot  = plot(showBB ? bbUpper : na, title = 'BB Upper', color = bbColor, linewidth = 1, display = display.pane)
bbLowerPlot  = plot(showBB ? bbLower : na, title = 'BB Lower', color = bbColor, linewidth = 1, display = display.pane)
bbCenterPlot = plot(showBB ? bbBasis : na, title = 'BB Center', color = showBB and showBBCenter ? color.new(bbColor, 50) : na, linewidth = 1, style = plot.style_linebr, display = display.pane)
fill(bbUpperPlot, bbCenterPlot, color = bbFillColor, title = 'BB Upper Fill')
fill(bbCenterPlot, bbLowerPlot, color = showBB and showBBCenter ? color.new(bbFillColor, math.max(0, color.t(bbFillColor) - 10)) : bbFillColor, title = 'BB Lower Fill')

// 15m BB
bbUpperPlot15  = plot(showBB15 ? bbUpper15 : na, title = 'BB 15m Upper', color = bbColor15, linewidth = 1, display = display.pane)
bbLowerPlot15  = plot(showBB15 ? bbLower15 : na, title = 'BB 15m Lower', color = bbColor15, linewidth = 1, display = display.pane)
bbCenterPlot15 = plot(showBB15 ? bbBasis15 : na, title = 'BB 15m Center', color = showBB15 and showBBCenter15 ? color.new(bbColor15, 70) : na, linewidth = 1, style = plot.style_linebr, display = display.pane)
fill(bbUpperPlot15, bbCenterPlot15, color = bbFillColor15, title = 'BB 15m Upper Fill')
fill(bbCenterPlot15, bbLowerPlot15, color = showBB15 and showBBCenter15 ? color.new(bbFillColor15, math.max(0, color.t(bbFillColor15) - 10)) : bbFillColor15, title = 'BB 15m Lower Fill')

// 1h BB
bbUpperPlot60  = plot(showBB60 ? bbUpper60 : na, title = 'BB 1h Upper', color = bbColor60, linewidth = 1, display = display.pane)
bbLowerPlot60  = plot(showBB60 ? bbLower60 : na, title = 'BB 1h Lower', color = bbColor60, linewidth = 1, display = display.pane)
bbCenterPlot60 = plot(showBB60 ? bbBasis60 : na, title = 'BB 1h Center', color = showBB60 and showBBCenter60 ? color.new(bbColor60, 70) : na, linewidth = 1, style = plot.style_linebr, display = display.pane)
fill(bbUpperPlot60, bbCenterPlot60, color = bbFillColor60, title = 'BB 1h Upper Fill')
fill(bbCenterPlot60, bbLowerPlot60, color = showBB60 and showBBCenter60 ? color.new(bbFillColor60, math.max(0, color.t(bbFillColor60) - 10)) : bbFillColor60, title = 'BB 1h Lower Fill')

// 4h BB
bbUpperPlot240  = plot(showBB240 ? bbUpper240 : na, title = 'BB 4h Upper', color = bbColor240, linewidth = 1, display = display.pane)
bbLowerPlot240  = plot(showBB240 ? bbLower240 : na, title = 'BB 4h Lower', color = bbColor240, linewidth = 1, display = display.pane)
bbCenterPlot240 = plot(showBB240 ? bbBasis240 : na, title = 'BB 4h Center', color = showBB240 and showBBCenter240 ? color.new(bbColor240, 70) : na, linewidth = 1, style = plot.style_linebr, display = display.pane)
fill(bbUpperPlot240, bbCenterPlot240, color = bbFillColor240, title = 'BB 4h Upper Fill')
fill(bbCenterPlot240, bbLowerPlot240, color = showBB240 and showBBCenter240 ? color.new(bbFillColor240, math.max(0, color.t(bbFillColor240) - 10)) : bbFillColor240, title = 'BB 4h Lower Fill')

// 1d BB
bbUpperPlot1D  = plot(showBB1D ? bbUpper1D : na, title = 'BB 1d Upper', color = bbColor1D, linewidth = 1, display = display.pane)
bbLowerPlot1D  = plot(showBB1D ? bbLower1D : na, title = 'BB 1d Lower', color = bbColor1D, linewidth = 1, display = display.pane)
bbCenterPlot1D = plot(showBB1D ? bbBasis1D : na, title = 'BB 1d Center', color = showBB1D and showBBCenter1D ? color.new(bbColor1D, 70) : na, linewidth = 1, style = plot.style_linebr, display = display.pane)
fill(bbUpperPlot1D, bbCenterPlot1D, color = bbFillColor1D, title = 'BB 1d Upper Fill')
fill(bbCenterPlot1D, bbLowerPlot1D, color = showBB1D and showBBCenter1D ? color.new(bbFillColor1D, math.max(0, color.t(bbFillColor1D) - 10)) : bbFillColor1D, title = 'BB 1d Lower Fill')

// 1w BB
bbUpperPlot1W  = plot(showBB1W ? bbUpper1W : na, title = 'BB 1w Upper', color = bbColor1W, linewidth = 1, display = display.pane)
bbLowerPlot1W  = plot(showBB1W ? bbLower1W : na, title = 'BB 1w Lower', color = bbColor1W, linewidth = 1, display = display.pane)
bbCenterPlot1W = plot(showBB1W ? bbBasis1W : na, title = 'BB 1w Center', color = showBB1W and showBBCenter1W ? color.new(bbColor1W, 70) : na, linewidth = 1, style = plot.style_linebr, display = display.pane)
fill(bbUpperPlot1W, bbCenterPlot1W, color = bbFillColor1W, title = 'BB 1w Upper Fill')
fill(bbCenterPlot1W, bbLowerPlot1W, color = showBB1W and showBBCenter1W ? color.new(bbFillColor1W, math.max(0, color.t(bbFillColor1W) - 10)) : bbFillColor1W, title = 'BB 1w Lower Fill')

// 1M BB
bbUpperPlot1M  = plot(showBB1M ? bbUpper1M : na, title = 'BB 1M Upper', color = bbColor1M, linewidth = 1, display = display.pane)
bbLowerPlot1M  = plot(showBB1M ? bbLower1M : na, title = 'BB 1M Lower', color = bbColor1M, linewidth = 1, display = display.pane)
bbCenterPlot1M = plot(showBB1M ? bbBasis1M : na, title = 'BB 1M Center', color = showBB1M and showBBCenter1M ? color.new(bbColor1M, 70) : na, linewidth = 1, style = plot.style_linebr, display = display.pane)
fill(bbUpperPlot1M, bbCenterPlot1M, color = bbFillColor1M, title = 'BB 1M Upper Fill')
fill(bbCenterPlot1M, bbLowerPlot1M, color = showBB1M and showBBCenter1M ? color.new(bbFillColor1M, math.max(0, color.t(bbFillColor1M) - 10)) : bbFillColor1M, title = 'BB 1M Lower Fill')
