//@version=6
indicator("Session Anchor Range", overlay = true)

// --- Inputs ---
var group_sess  = "Session Settings"
sessInput       = input.session("0930-1600", "New York Session", group = group_sess, tooltip = "The New York RTH session time range.")
tzInput         = input.string("America/New_York", "Timezone", group = group_sess, tooltip = "The timezone for the session input.")

var group_style = "Visual Settings"
borderColor     = input.color(color.new(#5b9cf6, 0), "Border Color", group = group_style)
fillColor       = input.color(color.new(#5b9cf6, 80), "Fill Color", group = group_style)
borderWidth     = input.int(1, "Border Width", minval = 1, maxval = 5, group = group_style)
extendMode      = input.string("Only during session", "Extend Mode", options = ["Only during session", "Keep extending"], group = group_style)

// --- Logic ---
// Function to determine the first 15m bar range and its start time
get_session_range() =>
    inSess  = not na(time("15", sessInput, tzInput))
    isFirst = inSess and not inSess[1]
    [isFirst ? high : na, isFirst ? low : na, isFirst ? time : na]

// Fetch data from 15m timeframe
[rawHigh, rawLow, rawTime] = request.security(syminfo.tickerid, "15", get_session_range(), lookahead = barmerge.lookahead_on)

// Persistent variables for the anchor
var float anchorHigh = na
var float anchorLow = na
var int anchorStartTime = na
var box anchorBox = na

// Detect a new anchor (new session start)
if not na(rawHigh) and (na(anchorStartTime) or rawTime != anchorStartTime)
    anchorHigh      := rawHigh
    anchorLow       := rawLow
    anchorStartTime := rawTime
    
    // Delete existing box to keep only one on the chart
    if not na(anchorBox)
        box.delete(anchorBox)
    
    // Create new box using time-based coordinates
    // Top = High of first 15m candle, Bottom = Low of first 15m candle
    anchorBox := box.new(
         left         = anchorStartTime, 
         top          = anchorHigh, 
         right        = time, 
         bottom       = anchorLow, 
         border_color = borderColor, 
         border_width = borderWidth, 
         bgcolor      = fillColor, 
         xloc         = xloc.bar_time
         )

// --- Extension Logic ---
inSessionChart = not na(time(timeframe.period, sessInput, tzInput))

if not na(anchorBox)
    bool shouldExtend = extendMode == "Keep extending" or inSessionChart
    
    if shouldExtend
        box.set_right(anchorBox, time)
