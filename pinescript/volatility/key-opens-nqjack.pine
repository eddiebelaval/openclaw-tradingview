// =========================================================================
// FORMATTING
// =========================================================================
l_style = line_style_str == "Dashed" ? line.style_dashed : line_style_str == "Dotted" ? line.style_dotted : line.style_solid
t_style = test_style_str == "Dashed" ? line.style_dashed : test_style_str == "Dotted" ? line.style_dotted : test_style_str == "Solid" ? line.style_solid : l_style
l_size  = lbl_size_str == "tiny" ? size.tiny : lbl_size_str == "small" ? size.small : lbl_size_str == "normal" ? size.normal : lbl_size_str == "large" ? size.large : size.normal

get_pos(p) => p == "Top Right" ? position.top_right : p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : position.bottom_left
get_sz(s) => s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Large" ? size.large : size.normal

tz = "America/New_York"

// =========================================================================
// 1-MINUTE ENGINE (LOWER TIMEFRAME PULLS)
// =========================================================================
arr_t = request.security_lower_tf(syminfo.tickerid, "1", time)
arr_o = request.security_lower_tf(syminfo.tickerid, "1", open)
arr_h = request.security_lower_tf(syminfo.tickerid, "1", high)
arr_l = request.security_lower_tf(syminfo.tickerid, "1", low)
arr_c = request.security_lower_tf(syminfo.tickerid, "1", close)
bool use_ltf = timeframe.in_seconds() > 60 and not na(arr_t) and array.size(arr_t) > 0

// =========================================================================
// DATA STRUCTURES
// =========================================================================
type Lvl
    string key_name
    line l
    label lbl
    bool drawn
    float p
    int trig_idx
    int trig_time
    bool tested
    int tap_time

type Gap
    string key_name
    line l_top
    line l_btm
    line l_mid
    box bx
    label lbl_top
    label lbl_btm
    label lbl_mid 
    bool drawn
    float p_top
    float p_btm
    float p_mid
    int trig_idx
    int trig_time
    bool tested_top
    bool tested_btm
    bool tested_mid
    bool tested_box
    color c
    bool show_top
    bool show_btm
    bool show_mid
    int tap_time_top
    int tap_time_btm
    int tap_time_mid
    int tap_time_box

// Standard Levels
var lvl_1800 = Lvl.new("18:00 Open", na, na, false, na, na, na, false, na)
var lvl_1930 = Lvl.new("19:30 Asia", na, na, false, na, na, na, false, na)
var lvl_0000 = Lvl.new("00:00 Mid", na, na, false, na, na, na, false, na)
var lvl_0130 = Lvl.new("01:30 Lon", na, na, false, na, na, na, false, na)
var lvl_0200 = Lvl.new("02:00 Open", na, na, false, na, na, na, false, na)
var lvl_0300 = Lvl.new("03:00 Lon", na, na, false, na, na, na, false, na)
var lvl_0600 = Lvl.new("06:00 Open", na, na, false, na, na, na, false, na)
var lvl_0730 = Lvl.new("07:30 NY", na, na, false, na, na, na, false, na)
var lvl_0830 = Lvl.new("08:30 Pre", na, na, false, na, na, na, false, na)
var lvl_0930 = Lvl.new("09:30 NY", na, na, false, na, na, na, false, na)
var lvl_1000 = Lvl.new("10:00 Open", na, na, false, na, na, na, false, na)
var lvl_wo   = Lvl.new("Weekly", na, na, false, na, na, na, false, na)
var lvl_two  = Lvl.new("True Wk", na, na, false, na, na, na, false, na)
var lvl_mo   = Lvl.new("Monthly", na, na, false, na, na, na, false, na)
var lvl_tmo  = Lvl.new("True Mo", na, na, false, na, na, na, false, na)
var lvl_pdh  = Lvl.new("PDH", na, na, false, na, na, na, false, na)
var lvl_pdl  = Lvl.new("PDL", na, na, false, na, na, na, false, na)

// Gaps
var gap_ndog = Gap.new("NDOG", na, na, na, na, na, na, na, false, na, na, na, na, na, false, false, false, false, na, false, false, false, na, na, na, na)
var gap_nwog = Gap.new("NWOG", na, na, na, na, na, na, na, false, na, na, na, na, na, false, false, false, false, na, false, false, false, na, na, na, na)

// =========================================================================
// CORE METHODS FOR LEVELS
// =========================================================================
method wipe_lvl(Lvl obj) =>
    obj.drawn := false, obj.p := na, obj.trig_idx := na, obj.trig_time := na, obj.tested := false, obj.tap_time := na
    line.delete(obj.l), label.delete(obj.lbl)
    int _dummy = 0

method draw_lvl(Lvl obj, string name, color c, float y_val, int x_idx, int real_time) =>
    line.delete(obj.l), label.delete(obj.lbl)
    obj.l := line.new(x_idx, y_val, bar_index, y_val, color=color.new(c, line_transp), style=l_style, width=line_width)
    obj.lbl := label.new(bar_index, y_val, text=name, color=color.new(color.white, 100), textcolor=color.new(c, line_transp), style=label.style_label_left, size=l_size)
    obj.drawn := true, obj.p := y_val, obj.trig_idx := x_idx, obj.trig_time := real_time, obj.tested := false, obj.tap_time := na
    int _dummy = 0

method check_test_lvl(Lvl obj, bool ltf_on, int[] t_arr, float[] h_arr, float[] l_arr) =>
    if obj.drawn and not obj.tested
        if ltf_on
            for i = 0 to array.size(t_arr) - 1
                t1 = array.get(t_arr, i)
                h1 = array.get(h_arr, i)
                l1 = array.get(l_arr, i)
                if t1 >= obj.trig_time + (test_time_m * 60000) and bar_index >= obj.trig_idx + test_delay
                    if h1 >= obj.p and l1 <= obj.p
                        obj.tested := true, obj.tap_time := t1
                        if mark_tested and test_style_str != "Unchanged" and not na(obj.l)
                            line.set_style(obj.l, t_style)
                        break
        if not ltf_on
            if time >= obj.trig_time + (test_time_m * 60000) and bar_index >= obj.trig_idx + test_delay
                if high >= obj.p and low <= obj.p
                    obj.tested := true, obj.tap_time := time
                    if mark_tested and test_style_str != "Unchanged" and not na(obj.l)
                        line.set_style(obj.l, t_style)
    int _dummy = 0

// =========================================================================
// CORE METHODS FOR GAPS 
// =========================================================================
method wipe_gap(Gap obj) =>
    obj.drawn := false
    obj.tested_top := false, obj.tested_btm := false, obj.tested_mid := false, obj.tested_box := false
    obj.tap_time_top := na, obj.tap_time_btm := na, obj.tap_time_mid := na, obj.tap_time_box := na
    line.delete(obj.l_top), line.delete(obj.l_btm), line.delete(obj.l_mid)
    box.delete(obj.bx), label.delete(obj.lbl_top), label.delete(obj.lbl_btm), label.delete(obj.lbl_mid)
    int _dummy = 0

method draw_gap(Gap obj, string name, color c_bull, color c_bear, string style, bool show_mid, bool show_top, bool show_btm, float c_close, float c_open, int x_idx, int real_time) =>
    obj.wipe_gap()
    bull = c_open > c_close
    c = bull ? c_bull : c_bear
    obj.c := c, obj.show_top := show_top, obj.show_btm := show_btm, obj.show_mid := show_mid
    max_p = math.max(c_open, c_close)
    min_p = math.min(c_open, c_close)
    mid_p = math.avg(max_p, min_p)
    obj.p_top := max_p, obj.p_btm := min_p, obj.p_mid := mid_p
    obj.trig_idx := bar_index, obj.trig_time := real_time, obj.drawn := true
    obj.tap_time_top := na, obj.tap_time_btm := na, obj.tap_time_mid := na, obj.tap_time_box := na
    
    show_boxes = style == "Boxes" or style == "Both"
    show_lines = style == "Lines" or style == "Both"
    
    if show_boxes
        obj.bx := box.new(x_idx, max_p, bar_index, min_p, border_color=na, bgcolor=color.new(c, box_transp))
    if show_lines
        if show_top
            obj.l_top := line.new(x_idx, max_p, bar_index, max_p, color=color.new(c, line_transp), style=l_style, width=line_width)
            obj.lbl_top := label.new(bar_index, max_p, text=name + " Top", color=color.new(color.white, 100), textcolor=color.new(c, line_transp), style=label.style_label_left, size=l_size)
        if show_btm
            obj.l_btm := line.new(x_idx, min_p, bar_index, min_p, color=color.new(c, line_transp), style=l_style, width=line_width)
            obj.lbl_btm := label.new(bar_index, min_p, text=name + " Btm", color=color.new(color.white, 100), textcolor=color.new(c, line_transp), style=label.style_label_left, size=l_size)
        if show_mid
            obj.l_mid := line.new(x_idx, mid_p, bar_index, mid_p, color=color.new(c, line_transp), style=line.style_dotted, width=line_width)
            obj.lbl_mid := label.new(bar_index, mid_p, text=name + " Mid", color=color.new(color.white, 100), textcolor=color.new(c, line_transp), style=label.style_label_left, size=l_size)
    int _dummy = 0

method check_test_gap(Gap obj, bool ltf_on, int[] t_arr, float[] h_arr, float[] l_arr) =>
    if obj.drawn
        if ltf_on
            for i = 0 to array.size(t_arr) - 1
                t1 = array.get(t_arr, i)
                h1 = array.get(h_arr, i)
                l1 = array.get(l_arr, i)
                if t1 >= obj.trig_time + (test_time_m * 60000) and bar_index >= obj.trig_idx + test_delay
                    if not obj.tested_top and h1 >= obj.p_top and l1 <= obj.p_top
                        obj.tested_top := true, obj.tap_time_top := t1
                        if mark_tested and test_style_str != "Unchanged" and not na(obj.l_top)
                            line.set_style(obj.l_top, t_style)
                    if not obj.tested_btm and h1 >= obj.p_btm and l1 <= obj.p_btm
                        obj.tested_btm := true, obj.tap_time_btm := t1
                        if mark_tested and test_style_str != "Unchanged" and not na(obj.l_btm)
                            line.set_style(obj.l_btm, t_style)
                    if not obj.tested_mid and h1 >= obj.p_mid and l1 <= obj.p_mid
                        obj.tested_mid := true, obj.tap_time_mid := t1
                        if mark_tested and test_style_str != "Unchanged" and not na(obj.l_mid)
                            line.set_style(obj.l_mid, t_style)
                    if not obj.tested_box and h1 >= obj.p_btm and l1 <= obj.p_top
                        obj.tested_box := true, obj.tap_time_box := t1
                        if mark_tested and not na(obj.bx)
                            box.set_bgcolor(obj.bx, color.new(obj.c, 95))
        if not ltf_on
            if time >= obj.trig_time + (test_time_m * 60000) and bar_index >= obj.trig_idx + test_delay
                if not obj.tested_top and high >= obj.p_top and low <= obj.p_top
                    obj.tested_top := true, obj.tap_time_top := time
                    if mark_tested and test_style_str != "Unchanged" and not na(obj.l_top)
                        line.set_style(obj.l_top, t_style)
                if not obj.tested_btm and high >= obj.p_btm and low <= obj.p_btm
                    obj.tested_btm := true, obj.tap_time_btm := time
                    if mark_tested and test_style_str != "Unchanged" and not na(obj.l_btm)
                        line.set_style(obj.l_btm, t_style)
                if not obj.tested_mid and high >= obj.p_mid and low <= obj.p_mid
                    obj.tested_mid := true, obj.tap_time_mid := time
                    if mark_tested and test_style_str != "Unchanged" and not na(obj.l_mid)
                        line.set_style(obj.l_mid, t_style)
                if not obj.tested_box and high >= obj.p_btm and low <= obj.p_top
                    obj.tested_box := true, obj.tap_time_box := time
                    if mark_tested and not na(obj.bx)
                        box.set_bgcolor(obj.bx, color.new(obj.c, 95))
    int _dummy = 0

// =========================================================================
// CONTINUOUS 1M DATA TRACKERS 
// =========================================================================
var float last_1m_c = na
var float prev_session_c = na
var float prev_week_c = na

if use_ltf and array.size(arr_c) > 0
    last_1m_c := array.get(arr_c, array.size(arr_c) - 1)
if not use_ltf
    last_1m_c := close

// =========================================================================
// PERFECT 1M PDH / PDL TRACKER (FIXED)
// =========================================================================
var float cur_dh = na
var int cur_dh_idx = na
var float cur_dl = na
var int cur_dl_idx = na

// =========================================================================
// NEW SESSION SWEEPS
// =========================================================================
shift_ms = (24 - reset_hr) * 3600000
session_day = dayofmonth(time + shift_ms, tz)
is_new_session = session_day != nz(session_day[1], session_day)

session_week = weekofyear(time + shift_ms, tz)
is_new_week = session_week != nz(session_week[1], session_week)

if is_new_session
    // Trigger PDH and PDL drawing BEFORE wiping tracking variables so they remember yesterday
    if show_pdh and not na(cur_dh)
        lvl_pdh.draw_lvl(txt_pdh, c_pdh_in, cur_dh, cur_dh_idx, time)
    if show_pdl and not na(cur_dl)
        lvl_pdl.draw_lvl(txt_pdl, c_pdl_in, cur_dl, cur_dl_idx, time)
        
    // Reset trackers for the NEW day
    cur_dh := use_ltf ? array.max(arr_h) : high
    cur_dh_idx := bar_index
    cur_dl := use_ltf ? array.min(arr_l) : low
    cur_dl_idx := bar_index

    prev_session_c := nz(last_1m_c[1], close[1])
    lvl_1800.wipe_lvl(), lvl_1930.wipe_lvl(), lvl_0000.wipe_lvl(), lvl_0130.wipe_lvl(), lvl_0200.wipe_lvl()
    lvl_0300.wipe_lvl(), lvl_0600.wipe_lvl(), lvl_0730.wipe_lvl(), lvl_0830.wipe_lvl(), lvl_0930.wipe_lvl(), lvl_1000.wipe_lvl()
    
    float gap_open = use_ltf ? array.get(arr_o, 0) : open
    int gap_time = use_ltf ? array.get(arr_t, 0) : time
    
    if show_ndog and gap_open != prev_session_c
        gap_ndog.draw_gap(txt_ndog, c_ndog_bl, c_ndog_br, ndog_style, ndog_mid, show_ndog_top, show_ndog_btm, prev_session_c, gap_open, bar_index, gap_time)
else
    // Continuously update tracking variables during the session to find accurate high/low
    h_val = use_ltf ? array.max(arr_h) : high
    l_val = use_ltf ? array.min(arr_l) : low
    
    if na(cur_dh) or h_val > cur_dh
        cur_dh := h_val
        cur_dh_idx := bar_index
    if na(cur_dl) or l_val < cur_dl
        cur_dl := l_val
        cur_dl_idx := bar_index

if is_new_week
    prev_week_c := nz(last_1m_c[1], close[1])
    float gap_w_open = use_ltf ? array.get(arr_o, 0) : open
    int gap_w_time = use_ltf ? array.get(arr_t, 0) : time
    
    if show_nwog and gap_w_open != prev_week_c
        gap_nwog.draw_gap(txt_nwog, c_nwog_bl, c_nwog_br, nwog_style, nwog_mid, show_nwog_top, show_nwog_btm, prev_week_c, gap_w_open, bar_index, gap_w_time)

// =========================================================================
// STRICT 1M TIMING TRIGGERS (FIXED EARLY PLOT BUG)
// =========================================================================
check_daily_trig(Lvl obj, bool show, string name, color c, int h, int m, bool ltf_on, int[] t_arr, float[] o_arr) =>
    if show
        t_target = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), h, m, 0)
        
        // This physically prevents the 9:59 candle from claiming the 10:00 trigger boundary
        is_inside = (t_target >= time and t_target < time_close)
        is_gap_cross = (time > t_target) and (nz(time[1], time) < t_target) and ((time - t_target) <= 14400000)
        
        if (is_inside or is_gap_cross) and (na(obj.trig_time) or obj.trig_time != t_target)
            if ltf_on
                for i = 0 to array.size(t_arr) - 1
                    t1 = array.get(t_arr, i)
                    if t1 >= t_target
                        obj.draw_lvl(name, c, array.get(o_arr, i), bar_index, t1)
                        obj.trig_time := t_target
                        break
            if not ltf_on
                obj.draw_lvl(name, c, open, bar_index, time)
                obj.trig_time := t_target
    int _dummy = 0

check_daily_trig(lvl_1800, show_1800, txt_1800, c_1800_in, 18, 00, use_ltf, arr_t, arr_o)
check_daily_trig(lvl_1930, show_1930, txt_1930, c_1930_in, 19, 30, use_ltf, arr_t, arr_o)
check_daily_trig(lvl_0000, show_0000, txt_0000, c_0000_in, 00, 00, use_ltf, arr_t, arr_o)
check_daily_trig(lvl_0130, show_0130, txt_0130, c_0130_in, 01, 30, use_ltf, arr_t, arr_o)
check_daily_trig(lvl_0200, show_0200, txt_0200, c_0200_in, 02, 00, use_ltf, arr_t, arr_o)
check_daily_trig(lvl_0300, show_0300, txt_0300, c_0300_in, 03, 00, use_ltf, arr_t, arr_o)
check_daily_trig(lvl_0600, show_0600, txt_0600, c_0600_in, 06, 00, use_ltf, arr_t, arr_o)
check_daily_trig(lvl_0730, show_0730, txt_0730, c_0730_in, 07, 30, use_ltf, arr_t, arr_o)
check_daily_trig(lvl_0830, show_0830, txt_0830, c_0830_in, 08, 30, use_ltf, arr_t, arr_o)
check_daily_trig(lvl_0930, show_0930, txt_0930, c_0930_in, 09, 30, use_ltf, arr_t, arr_o)
check_daily_trig(lvl_1000, show_1000, txt_1000, c_1000_in, 10, 00, use_ltf, arr_t, arr_o)

if show_wo and weekofyear(time, tz) != weekofyear(nz(time[1], time), tz)
    if na(lvl_wo.trig_time) or weekofyear(lvl_wo.trig_time, tz) != weekofyear(time, tz)
        lvl_wo.draw_lvl(txt_wo, c_wo_in, use_ltf ? array.get(arr_o, 0) : open, bar_index, use_ltf ? array.get(arr_t, 0) : time)
        lvl_wo.trig_time := time

var int last_two_week = na
if show_two
    t_target = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), 9, 30, 0)
    is_inside = (t_target >= time and t_target < time_close)
    is_gap_cross = (time > t_target) and (nz(time[1], time) < t_target) and (time - t_target <= 14400000)
    if (is_inside or is_gap_cross) and (na(last_two_week) or last_two_week != weekofyear(time, tz))
        if use_ltf
            for i = 0 to array.size(arr_t) - 1
                t1 = array.get(arr_t, i)
                if t1 >= t_target
                    lvl_two.draw_lvl(txt_two, c_two_in, array.get(arr_o, i), bar_index, t1)
                    last_two_week := weekofyear(time, tz)
                    break
        if not use_ltf
            if time >= t_target
                lvl_two.draw_lvl(txt_two, c_two_in, open, bar_index, time)
                last_two_week := weekofyear(time, tz)

if show_mo and month(time, tz) != month(nz(time[1], time), tz)
    if na(lvl_mo.trig_time) or month(lvl_mo.trig_time, tz) != month(time, tz)
        lvl_mo.draw_lvl(txt_mo, c_mo_in, use_ltf ? array.get(arr_o, 0) : open, bar_index, use_ltf ? array.get(arr_t, 0) : time)
        lvl_mo.trig_time := time

var int last_tmo_month = na
if show_tmo
    t_target = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), 9, 30, 0)
    is_inside = (t_target >= time and t_target < time_close)
    is_gap_cross = (time > t_target) and (nz(time[1], time) < t_target) and (time - t_target <= 14400000)
    if (is_inside or is_gap_cross) and (na(last_tmo_month) or last_tmo_month != month(time, tz))
        if use_ltf
            for i = 0 to array.size(arr_t) - 1
                t1 = array.get(arr_t, i)
                if t1 >= t_target
                    lvl_tmo.draw_lvl(txt_tmo, c_tmo_in, array.get(arr_o, i), bar_index, t1)
                    last_tmo_month := month(time, tz)
                    break
        if not use_ltf
            if time >= t_target
                lvl_tmo.draw_lvl(txt_tmo, c_tmo_in, open, bar_index, time)
                last_tmo_month := month(time, tz)

// =========================================================================
// RUBBER-BAND ENGINE & HIDING LOGIC
// =========================================================================
var float[] active_ys = array.new_float()
array.clear(active_ys)

get_stagger(float y_val) =>
    int stagger = 0
    for y in active_ys
        if math.abs(y - y_val) <= (overlap_ticks * syminfo.mintick)
            stagger += 1
    array.push(active_ys, y_val)
    stagger

method refresh_lvl(Lvl obj, string name) =>
    if obj.drawn
        bool is_hidden = hide_lvls and obj.tested
        if is_hidden
            line.delete(obj.l), label.delete(obj.lbl)
            obj.l := na, obj.lbl := na
            
        if not is_hidden
            stagger = get_stagger(obj.p)
            final_x = bar_index + lbl_dist + (stagger * stagger_bars)
            p_str = show_price_lbl ? " [" + str.tostring(obj.p, format.mintick) + "]" : ""
            final_name = (mark_tested and obj.tested) ? name + p_str + test_text : name + p_str
            
            if not na(obj.l)
                line.set_x2(obj.l, final_x)
            if not na(obj.lbl)
                label.set_xy(obj.lbl, final_x, obj.p)
                label.set_text(obj.lbl, final_name)
    int _dummy = 0

method refresh_gap(Gap obj, string name) =>
    if obj.drawn
        final_x = bar_index + lbl_dist
        bool hide_bx = hide_gaps and obj.tested_box
        
        if hide_bx and not na(obj.bx)
            box.delete(obj.bx)
            obj.bx := na
        if not hide_bx and not na(obj.bx)
            box.set_right(obj.bx, final_x)
            
        if obj.show_top
            bool hide_top = hide_gaps and obj.tested_top
            if hide_top
                line.delete(obj.l_top), label.delete(obj.lbl_top)
                obj.l_top := na, obj.lbl_top := na
            if not hide_top
                stagger_top = get_stagger(obj.p_top)
                final_x_top = bar_index + lbl_dist + (stagger_top * stagger_bars)
                p_str = show_price_lbl ? " [" + str.tostring(obj.p_top, format.mintick) + "]" : ""
                final_name = (mark_tested and obj.tested_top) ? name + " Top" + p_str + test_text : name + " Top" + p_str
                if not na(obj.l_top)
                    line.set_x2(obj.l_top, final_x_top)
                if not na(obj.lbl_top)
                    label.set_xy(obj.lbl_top, final_x_top, obj.p_top)
                    label.set_text(obj.lbl_top, final_name)
                
        if obj.show_btm
            bool hide_btm = hide_gaps and obj.tested_btm
            if hide_btm
                line.delete(obj.l_btm), label.delete(obj.lbl_btm)
                obj.l_btm := na, obj.lbl_btm := na
            if not hide_btm
                stagger_btm = get_stagger(obj.p_btm)
                final_x_btm = bar_index + lbl_dist + (stagger_btm * stagger_bars)
                p_str = show_price_lbl ? " [" + str.tostring(obj.p_btm, format.mintick) + "]" : ""
                final_name = (mark_tested and obj.tested_btm) ? name + " Btm" + p_str + test_text : name + " Btm" + p_str
                if not na(obj.l_btm)
                    line.set_x2(obj.l_btm, final_x_btm)
                if not na(obj.lbl_btm)
                    label.set_xy(obj.lbl_btm, final_x_btm, obj.p_btm)
                    label.set_text(obj.lbl_btm, final_name)

        if obj.show_mid
            bool hide_mid = hide_gaps and obj.tested_mid
            if hide_mid
                line.delete(obj.l_mid), label.delete(obj.lbl_mid)
                obj.l_mid := na, obj.lbl_mid := na
            if not hide_mid
                stagger_mid = get_stagger(obj.p_mid)
                final_x_mid = bar_index + lbl_dist + (stagger_mid * stagger_bars)
                p_str = show_price_lbl ? " [" + str.tostring(obj.p_mid, format.mintick) + "]" : ""
                final_name = (mark_tested and obj.tested_mid) ? name + " Mid" + p_str + test_text : name + " Mid" + p_str
                if not na(obj.l_mid)
                    line.set_x2(obj.l_mid, final_x_mid)
                if not na(obj.lbl_mid)
                    label.set_xy(obj.lbl_mid, final_x_mid, obj.p_mid)
                    label.set_text(obj.lbl_mid, final_name)
    int _dummy = 0

lvl_1800.check_test_lvl(use_ltf, arr_t, arr_h, arr_l), lvl_1930.check_test_lvl(use_ltf, arr_t, arr_h, arr_l)
lvl_0000.check_test_lvl(use_ltf, arr_t, arr_h, arr_l), lvl_0130.check_test_lvl(use_ltf, arr_t, arr_h, arr_l)
lvl_0200.check_test_lvl(use_ltf, arr_t, arr_h, arr_l), lvl_0300.check_test_lvl(use_ltf, arr_t, arr_h, arr_l)
lvl_0600.check_test_lvl(use_ltf, arr_t, arr_h, arr_l), lvl_0730.check_test_lvl(use_ltf, arr_t, arr_h, arr_l)
lvl_0830.check_test_lvl(use_ltf, arr_t, arr_h, arr_l), lvl_0930.check_test_lvl(use_ltf, arr_t, arr_h, arr_l)
lvl_1000.check_test_lvl(use_ltf, arr_t, arr_h, arr_l), lvl_wo.check_test_lvl(use_ltf, arr_t, arr_h, arr_l)
lvl_two.check_test_lvl(use_ltf, arr_t, arr_h, arr_l), lvl_mo.check_test_lvl(use_ltf, arr_t, arr_h, arr_l)
lvl_tmo.check_test_lvl(use_ltf, arr_t, arr_h, arr_l), lvl_pdh.check_test_lvl(use_ltf, arr_t, arr_h, arr_l)
lvl_pdl.check_test_lvl(use_ltf, arr_t, arr_h, arr_l)
gap_ndog.check_test_gap(use_ltf, arr_t, arr_h, arr_l), gap_nwog.check_test_gap(use_ltf, arr_t, arr_h, arr_l)

lvl_1800.refresh_lvl(txt_1800), lvl_1930.refresh_lvl(txt_1930), lvl_0000.refresh_lvl(txt_0000)
lvl_0130.refresh_lvl(txt_0130), lvl_0200.refresh_lvl(txt_0200), lvl_0300.refresh_lvl(txt_0300)
lvl_0600.refresh_lvl(txt_0600), lvl_0730.refresh_lvl(txt_0730), lvl_0830.refresh_lvl(txt_0830)
lvl_0930.refresh_lvl(txt_0930), lvl_1000.refresh_lvl(txt_1000)
lvl_wo.refresh_lvl(txt_wo), lvl_two.refresh_lvl(txt_two), lvl_mo.refresh_lvl(txt_mo), lvl_tmo.refresh_lvl(txt_tmo)
lvl_pdh.refresh_lvl(txt_pdh), lvl_pdl.refresh_lvl(txt_pdl)
gap_ndog.refresh_gap(txt_ndog), gap_nwog.refresh_gap(txt_nwog)

// =========================================================================
// INFO PANEL (TABLE) - DYNAMIC ROWS
// =========================================================================
type TableRow
    string name
    float p
    bool tested
    int tap_t

if barstate.islast and show_panel
    var rows = array.new<TableRow>()
    array.clear(rows)
    
    if lvl_1800.drawn
        array.push(rows, TableRow.new(txt_1800, lvl_1800.p, lvl_1800.tested, lvl_1800.tap_time))
    if lvl_1930.drawn
        array.push(rows, TableRow.new(txt_1930, lvl_1930.p, lvl_1930.tested, lvl_1930.tap_time))
    if lvl_0000.drawn
        array.push(rows, TableRow.new(txt_0000, lvl_0000.p, lvl_0000.tested, lvl_0000.tap_time))
    if lvl_0130.drawn
        array.push(rows, TableRow.new(txt_0130, lvl_0130.p, lvl_0130.tested, lvl_0130.tap_time))
    if lvl_0200.drawn
        array.push(rows, TableRow.new(txt_0200, lvl_0200.p, lvl_0200.tested, lvl_0200.tap_time))
    if lvl_0300.drawn
        array.push(rows, TableRow.new(txt_0300, lvl_0300.p, lvl_0300.tested, lvl_0300.tap_time))
    if lvl_0600.drawn
        array.push(rows, TableRow.new(txt_0600, lvl_0600.p, lvl_0600.tested, lvl_0600.tap_time))
    if lvl_0730.drawn
        array.push(rows, TableRow.new(txt_0730, lvl_0730.p, lvl_0730.tested, lvl_0730.tap_time))
    if lvl_0830.drawn
        array.push(rows, TableRow.new(txt_0830, lvl_0830.p, lvl_0830.tested, lvl_0830.tap_time))
    if lvl_0930.drawn
        array.push(rows, TableRow.new(txt_0930, lvl_0930.p, lvl_0930.tested, lvl_0930.tap_time))
    if lvl_1000.drawn
        array.push(rows, TableRow.new(txt_1000, lvl_1000.p, lvl_1000.tested, lvl_1000.tap_time))
    
    if lvl_wo.drawn
        array.push(rows, TableRow.new(txt_wo, lvl_wo.p, lvl_wo.tested, lvl_wo.tap_time))
    if lvl_two.drawn
        array.push(rows, TableRow.new(txt_two, lvl_two.p, lvl_two.tested, lvl_two.tap_time))
    if lvl_mo.drawn
        array.push(rows, TableRow.new(txt_mo, lvl_mo.p, lvl_mo.tested, lvl_mo.tap_time))
    if lvl_tmo.drawn
        array.push(rows, TableRow.new(txt_tmo, lvl_tmo.p, lvl_tmo.tested, lvl_tmo.tap_time))
        
    if lvl_pdh.drawn
        array.push(rows, TableRow.new(txt_pdh, lvl_pdh.p, lvl_pdh.tested, lvl_pdh.tap_time))
    if lvl_pdl.drawn
        array.push(rows, TableRow.new(txt_pdl, lvl_pdl.p, lvl_pdl.tested, lvl_pdl.tap_time))

    if gap_ndog.drawn
        if gap_ndog.show_top
            array.push(rows, TableRow.new(txt_ndog + " Top", gap_ndog.p_top, gap_ndog.tested_top, gap_ndog.tap_time_top))
        if gap_ndog.show_mid
            array.push(rows, TableRow.new(txt_ndog + " Mid", gap_ndog.p_mid, gap_ndog.tested_mid, gap_ndog.tap_time_mid))
        if gap_ndog.show_btm
            array.push(rows, TableRow.new(txt_ndog + " Btm", gap_ndog.p_btm, gap_ndog.tested_btm, gap_ndog.tap_time_btm))

    if gap_nwog.drawn
        if gap_nwog.show_top
            array.push(rows, TableRow.new(txt_nwog + " Top", gap_nwog.p_top, gap_nwog.tested_top, gap_nwog.tap_time_top))
        if gap_nwog.show_mid
            array.push(rows, TableRow.new(txt_nwog + " Mid", gap_nwog.p_mid, gap_nwog.tested_mid, gap_nwog.tap_time_mid))
        if gap_nwog.show_btm
            array.push(rows, TableRow.new(txt_nwog + " Btm", gap_nwog.p_btm, gap_nwog.tested_btm, gap_nwog.tap_time_btm))

    int total_rows = array.size(rows)
    int total_cols = 2
    if show_panel_price
        total_cols += 1
    if show_panel_time
        total_cols += 1
    
    var table info_panel = na
    if not na(info_panel)
        table.delete(info_panel)
        
    if total_rows > 0
        info_panel := table.new(get_pos(panel_pos_str), total_cols, total_rows + 1, bgcolor=panel_bg, border_width=1, border_color=panel_border, frame_color=panel_border, frame_width=1)
        sz = get_sz(panel_size_str)
        
        int col_idx = 0
        table.cell(info_panel, col_idx, 0, "LEVEL", text_color=panel_txt_col, text_size=sz, text_halign=text.align_left, bgcolor=color.new(color.black, 50))
        col_idx += 1
        
        if show_panel_price
            table.cell(info_panel, col_idx, 0, "PRICE", text_color=panel_txt_col, text_size=sz, text_halign=text.align_left, bgcolor=color.new(color.black, 50))
            col_idx += 1
            
        table.cell(info_panel, col_idx, 0, "STATUS", text_color=panel_txt_col, text_size=sz, text_halign=text.align_left, bgcolor=color.new(color.black, 50))
        col_idx += 1
        
        if show_panel_time
            table.cell(info_panel, col_idx, 0, "TAPPED (" + tz + ")", text_color=panel_txt_col, text_size=sz, text_halign=text.align_left, bgcolor=color.new(color.black, 50))

        for i = 0 to total_rows - 1
            r = array.get(rows, i)
            stat_col = r.tested ? color.gray : color.new(color.green, 20)
            stat_txt = r.tested ? "Tapped" + test_text : "Active"
            
            int curr_col = 0
            table.cell(info_panel, curr_col, i+1, r.name, text_color=panel_txt_col, text_size=sz, text_halign=text.align_left)
            curr_col += 1
            
            if show_panel_price
                table.cell(info_panel, curr_col, i+1, str.tostring(r.p, format.mintick), text_color=panel_txt_col, text_size=sz, text_halign=text.align_left)
                curr_col += 1
                
            table.cell(info_panel, curr_col, i+1, stat_txt, text_color=stat_col, text_size=sz, text_halign=text.align_left)
            curr_col += 1
            
            if show_panel_time
                time_str = not na(r.tap_t) ? str.format_time(r.tap_t, "MM/dd HH:mm", tz) : "-"
                table.cell(info_panel, curr_col, i+1, time_str, text_color=panel_txt_col, text_size=sz, text_halign=text.align_left)
