//@version=6
indicator("BTC Intraday Advanced Spot M5", overlay=true)

// === INPUTS ===
emaHTF_length = input.int(200, "EMA HTF Length")
emaPullback = input.int(20, "EMA Pullback Length")
atrLength = input.int(14, "ATR Length")
atrMultiplier = input.float(1.3, "SL ATR Multiplier")
beTrigger = input.float(1.5, "Break Even Trigger (R)")
tp1RR = input.float(1.0, "TP1 RR")
tp2RR = input.float(3.0, "TP2 RR")
useSessionFilter = input.bool(true, "US Session Only")

// === HTF TREND (M15) ===
htfClose = request.security(syminfo.tickerid, "15", close)
htfEMA = request.security(syminfo.tickerid, "15", ta.ema(close, emaHTF_length))

trendBull = htfClose > htfEMA

// === VOLATILITY FILTER ===
atr = ta.atr(atrLength)
atrAvg = ta.sma(atr, 20)
volatilityOK = atr > atrAvg

// === SESSION FILTER (14h–22h Chypre approx UTC+2) ===
sessionOK = not useSessionFilter or (hour >= 14 and hour <= 22)

// === IMPULSE DETECTION ===
volumeAvg = ta.sma(volume, 20)
impulse = close > open and volume > volumeAvg and (close - open) > atr * 0.5

// === PULLBACK ===
ema20 = ta.ema(close, emaPullback)
pullback = close <= ema20

// === ENTRY CONDITION ===
longSignal = trendBull and volatilityOK and impulse and pullback and sessionOK

// === TRADE LEVELS ===
entry = close
sl = entry - atr * atrMultiplier
risk = entry - sl
tp1 = entry + risk * tp1RR
tp2 = entry + risk * tp2RR

// === PLOT ===
plotshape(longSignal, style=shape.labelup, location=location.belowbar, color=color.green, size=size.large, text="LONG")

plot(longSignal ? sl : na, color=color.red, linewidth=2)
plot(longSignal ? tp1 : na, color=color.orange, linewidth=2)
plot(longSignal ? tp2 : na, color=color.green, linewidth=2)
