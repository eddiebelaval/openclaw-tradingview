//@version=5
indicator("RTH SD+ | 6-9 Strategy PRO", overlay=true, max_boxes_count=30, max_lines_count=70, max_labels_count=60)

// ==================== TIME SETTINGS ====================
sessionStart = input.session("0600-0900", "6-9 AM Range", group="Time Settings")
timeZone = input.string("UTC-5", "Timezone (UTC Offset)", options=["UTC-12", "UTC-11", "UTC-10", "UTC-9", "UTC-8", "UTC-7", "UTC-6", "UTC-5", "UTC-4", "UTC-3", "UTC-2", "UTC-1", "UTC", "UTC+1", "UTC+2", "UTC+3", "UTC+4", "UTC+5", "UTC+6", "UTC+7", "UTC+8", "UTC+9", "UTC+10", "UTC+11", "UTC+12"], group="Time Settings")

// ==================== DISPLAY SETTINGS ====================
showSDLevels = input.bool(true, "Show SD Levels", group="Display")
showPriceLabels = input.bool(true, "Show Price Labels", group="Display")
showDashboard = input.bool(true, "Show Dashboard", group="Display")
dashboardPosition = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="Display")

// RTH Highlighting
showRTHCandles = input.bool(true, "Highlight RTH Candles (9:30+)", group="Display")
rthCandleColor = input.color(color.new(#2962FF, 85), "RTH Highlight Color", group="Display")

// ==================== ETH SESSION LEVELS ====================
showONSLevels = input.bool(true, "Show ONS H/L", group="ETH Session Levels")
onsSession = input.session("1800-0600", "ONS Session Time", group="ETH Session Levels", tooltip="Default: 6 PM to 6 AM ET (1800-0600). Format uses 24-hour time.")
onsLineStyle = input.string("Dashed", "ONS Line Style", options=["Solid", "Dashed", "Dotted"], group="ETH Session Levels")
keepONSAfterSweep = input.bool(true, "Keep Lines After Sweep", group="ETH Session Levels", tooltip="Keep ONS lines visible after they're swept (shown as dotted gray)")


// ==================== KEY STRATEGY ELEMENTS ====================
show940_950Window = input.bool(true, "Show 9:40-9:50 Reversal Window", group="Strategy Elements")
showQuartiles = input.bool(true, "Show 25%/75% Quartiles", group="Strategy Elements")

// ==================== MEAN REVERSION BOXES ====================
showMeanRevBoxes = input.bool(true, "Show R/R Zone Boxes (±1.33/1.66)", group="Mean Reversion Zones")
boxColorRR = input.color(color.new(color.orange, 90), "R/R Zone Box Color", group="Mean Reversion Zones")

// ==================== EDGE DETECTION ====================
minRangeSize = input.float(60.0, "Minimum Range Size (pts)", group="Edge Detection")
maxRangeSize = input.float(200.0, "Maximum Range Size (pts)", group="Edge Detection")
onsMultiplier = input.float(1.5, "Extended ONS Multiplier", group="Edge Detection")

// ==================== LINE COLORS ====================
colorHL = input.color(color.white, "6-9 High/Low", inline="hl", group="Line Colors")
widthHL = input.int(2, "", inline="hl", group="Line Colors")

colorEQ = input.color(color.blue, "Equilibrium", inline="eq", group="Line Colors")
widthEQ = input.int(2, "", inline="eq", group="Line Colors")

colorOpen = input.color(color.yellow, "Open", inline="open", group="Line Colors")
widthOpen = input.int(1, "", inline="open", group="Line Colors")

colorQuartiles = input.color(color.red, "25%/75%", inline="q", group="Line Colors")
widthQuartiles = input.int(1, "", inline="q", group="Line Colors")

// Individual SD Level Colors
colorSD05 = input.color(color.lime, "±0.5 SD (KEY)", inline="sd05", group="Line Colors")
widthSD05 = input.int(3, "", inline="sd05", group="Line Colors")

colorSD10 = input.color(color.yellow, "±1.0 SD", inline="sd10", group="Line Colors")
widthSD10 = input.int(1, "", inline="sd10", group="Line Colors")

colorSD20 = input.color(color.gray, "±2.0 SD", inline="sd20", group="Line Colors")
widthSD20 = input.int(1, "", inline="sd20", group="Line Colors")

colorRR = input.color(color.orange, "R/R Zone (±1.33/1.66)", inline="rr", group="Line Colors")
widthRR = input.int(1, "", inline="rr", group="Line Colors")

colorONS = input.color(color.purple, "ONS High/Low", inline="ons", group="Line Colors")
widthONS = input.int(2, "", inline="ons", group="Line Colors")

// Convert ONS line style string to Pine Script constant
onsStyle = onsLineStyle == "Solid" ? line.style_solid : onsLineStyle == "Dotted" ? line.style_dotted : line.style_dashed

// Parse 6-9 session
sessionParts = str.split(sessionStart, "-")
startTime = array.get(sessionParts, 0)
endTime = array.get(sessionParts, 1)
startHour = str.tonumber(str.substring(startTime, 0, 2))
startMin = str.tonumber(str.substring(startTime, 2, 4))
endHour = str.tonumber(str.substring(endTime, 0, 2))
endMin = str.tonumber(str.substring(endTime, 2, 4))

// Parse ONS session
onsParts = str.split(onsSession, "-")
onsStartTime = array.get(onsParts, 0)
onsEndTime = array.get(onsParts, 1)
onsStartHour = str.tonumber(str.substring(onsStartTime, 0, 2))
onsStartMin = str.tonumber(str.substring(onsStartTime, 2, 4))
onsEndHour = str.tonumber(str.substring(onsEndTime, 0, 2))
onsEndMin = str.tonumber(str.substring(onsEndTime, 2, 4))

currentHour = hour(time, timeZone)
currentMin = minute(time, timeZone)

// ==================== 6-9 RANGE STORAGE ====================
var line lineHigh = na
var line lineLow = na
var line lineOpen = na
var line lineEQ = na
var line lineQ25 = na
var line lineQ75 = na

var line lineMR05h = na
var line lineMR05l = na
var line lineMR10h = na
var line lineMR10l = na
var line lineMR20h = na
var line lineMR20l = na

var line lineRR133h = na
var line lineRR133l = na
var line lineRR166h = na
var line lineRR166l = na

var box boxRR_upper = na
var box boxRR_lower = na

var label lblHigh = na
var label lblLow = na
var label lblOpen = na
var label lblEQ = na
var label lblQ25 = na
var label lblQ75 = na
var label lblMR05h = na
var label lblMR05l = na
var label lblMR10h = na
var label lblMR10l = na
var label lblMR20h = na
var label lblMR20l = na
var label lblRR133h = na
var label lblRR133l = na
var label lblRR166h = na
var label lblRR166l = na

var float rangeHigh = na
var float rangeLow = na
var float rangeOpen = na
var int rangeStart = 0
var int highBar = 0
var int lowBar = 0
var bool drawn = false

// ==================== ONS STORAGE ====================
var float onsHigh = na
var float onsLow = na
var int onsHighBar = 0  // Track which bar made the ONS high
var int onsLowBar = 0   // Track which bar made the ONS low
var line lineONSHigh = na
var line lineONSLow = na
var label lblONSHigh = na
var label lblONSLow = na

// ONS Sweep Tracking (for Judas prediction)
var bool onsHighSwept = false
var bool onsLowSwept = false
var float onsHighValue = na  // Store for display even after sweep
var float onsLowValue = na
var int onsHighBarValue = 0  // Store bar index for line drawing
var int onsLowBarValue = 0

// ==================== TRACKING ====================
var float avgRangeSize = na
var int rangeCount = 0
var float onsRangeSize = na

// ==================== SESSION DETECTION ====================
in6_9Session = (currentHour > startHour or (currentHour == startHour and currentMin >= startMin)) and (currentHour < endHour or (currentHour == endHour and currentMin < endMin))

prevHour = hour(time[1], timeZone)
prevMin = minute(time[1], timeZone)
prev6_9Session = (prevHour > startHour or (prevHour == startHour and prevMin >= startMin)) and (prevHour < endHour or (prevHour == endHour and prevMin < endMin))

// ONS Session (customizable, default 6 PM to 6 AM ET)
// Handle sessions that cross midnight (e.g., 18:00-06:00)
onsSessionCrossesMidnight = onsEndHour < onsStartHour
bool inONSSession = false
if onsSessionCrossesMidnight
    // Session crosses midnight (e.g., 18:00-06:00)
    inONSSession := (currentHour > onsStartHour or (currentHour == onsStartHour and currentMin >= onsStartMin)) or (currentHour < onsEndHour or (currentHour == onsEndHour and currentMin < onsEndMin))
else
    // Session doesn't cross midnight (e.g., 02:00-08:00)
    inONSSession := (currentHour > onsStartHour or (currentHour == onsStartHour and currentMin >= onsStartMin)) and (currentHour < onsEndHour or (currentHour == onsEndHour and currentMin < onsEndMin))

// RTH Session (9:30 AM to 4:00 PM ET)
inRTHSession = (currentHour > 9 or (currentHour == 9 and currentMin >= 30)) and currentHour < 16

// 9:40-9:50 Reversal Window
in940_950Window = currentHour == 9 and currentMin >= 40 and currentMin <= 50

// ==================== ONS TRACKING ====================
if inONSSession
    if na(onsHigh) or high > onsHigh
        onsHigh := high
        onsHighBar := bar_index  // Track the bar that made this high
    if na(onsLow) or low < onsLow
        onsLow := low
        onsLowBar := bar_index  // Track the bar that made this low

// Reset ONS at session end - store values when we EXIT the ONS session
// This triggers when current bar is OUT of session but previous bar was IN
if not inONSSession and inONSSession[1]
    onsRangeSize := na(onsHigh) or na(onsLow) ? na : onsHigh - onsLow
    // Store values before reset for dashboard display
    onsHighValue := onsHigh
    onsLowValue := onsLow
    onsHighBarValue := onsHighBar  // Store bar indices for line drawing
    onsLowBarValue := onsLowBar
    // Reset tracking
    onsHigh := na
    onsLow := na
    onsHighBar := 0
    onsLowBar := 0
    onsHighSwept := false
    onsLowSwept := false

// Detect ONS sweeps after ONS session ends (6 AM onward)
// This includes pre-market (6-9 AM) AND RTH (9:30 AM+)
// Framework logic: track whether liquidity was purged BEFORE Judas window
if not inONSSession and not na(onsHighValue) and not na(onsLowValue)
    // Check if price swept ONS high
    if not onsHighSwept and high >= onsHighValue
        onsHighSwept := true
    
    // Check if price swept ONS low
    if not onsLowSwept and low <= onsLowValue
        onsLowSwept := true

// ==================== START NEW 6-9 RANGE ====================
if currentHour == startHour and currentMin == startMin and not prev6_9Session
    rangeHigh := high
    rangeLow := low
    rangeOpen := open
    rangeStart := bar_index
    highBar := bar_index
    lowBar := bar_index
    drawn := false
    
    // Delete old 6-9 objects
    line.delete(lineHigh)
    line.delete(lineLow)
    line.delete(lineOpen)
    line.delete(lineEQ)
    line.delete(lineQ25)
    line.delete(lineQ75)
    line.delete(lineMR05h)
    line.delete(lineMR05l)
    line.delete(lineMR10h)
    line.delete(lineMR10l)
    line.delete(lineMR20h)
    line.delete(lineMR20l)
    line.delete(lineRR133h)
    line.delete(lineRR133l)
    line.delete(lineRR166h)
    line.delete(lineRR166l)
    
    box.delete(boxRR_upper)
    box.delete(boxRR_lower)
    
    label.delete(lblHigh)
    label.delete(lblLow)
    label.delete(lblOpen)
    label.delete(lblEQ)
    label.delete(lblQ25)
    label.delete(lblQ75)
    label.delete(lblMR05h)
    label.delete(lblMR05l)
    label.delete(lblMR10h)
    label.delete(lblMR10l)
    label.delete(lblMR20h)
    label.delete(lblMR20l)
    label.delete(lblRR133h)
    label.delete(lblRR133l)
    label.delete(lblRR166h)
    label.delete(lblRR166l)
    
    // Delete old ONS objects
    line.delete(lineONSHigh)
    line.delete(lineONSLow)
    label.delete(lblONSHigh)
    label.delete(lblONSLow)

// ==================== UPDATE 6-9 RANGE ====================
if in6_9Session
    if high > rangeHigh
        rangeHigh := high
        highBar := bar_index
    if low < rangeLow
        rangeLow := low
        lowBar := bar_index

// ==================== CALCULATE LEVELS ====================
rangeSize = rangeHigh - rangeLow
rangeMid = (rangeHigh + rangeLow) / 2
valid = not na(rangeHigh) and not na(rangeLow)

// Quartiles (25%, 75%)
q25 = rangeLow + (rangeSize * 0.25)
q75 = rangeLow + (rangeSize * 0.75)

// Mean Reversion Levels
mr05_h = rangeHigh + (rangeSize * 0.5)
mr05_l = rangeLow - (rangeSize * 0.5)
mr10_h = rangeHigh + rangeSize
mr10_l = rangeLow - rangeSize
mr20_h = rangeHigh + (rangeSize * 2.0)
mr20_l = rangeLow - (rangeSize * 2.0)

// R/R Zone (Retracement/Reversal)
rr133_h = rangeHigh + (rangeSize * 1.33)
rr133_l = rangeLow - (rangeSize * 1.33)
rr166_h = rangeHigh + (rangeSize * 1.66)
rr166_l = rangeLow - (rangeSize * 1.66)

// ==================== DRAW 6-9 RANGE AT 9:00 AM ====================
if valid and not in6_9Session and prev6_9Session and not drawn
    drawn := true
    
    // Update tracking
    rangeCount += 1
    if na(avgRangeSize)
        avgRangeSize := rangeSize
    else
        avgRangeSize := (avgRangeSize * (rangeCount - 1) + rangeSize) / rangeCount
    
    // 6-9 Range Lines
    lineHigh := line.new(highBar, rangeHigh, bar_index + 30, rangeHigh, color=colorHL, width=widthHL)
    lineLow := line.new(lowBar, rangeLow, bar_index + 30, rangeLow, color=colorHL, width=widthHL)
    lineEQ := line.new(bar_index, rangeMid, bar_index + 30, rangeMid, color=colorEQ, width=widthEQ)
    lineOpen := line.new(bar_index, rangeOpen, bar_index + 30, rangeOpen, color=colorOpen, width=widthOpen, style=line.style_dotted)
    
    // Quartiles
    if showQuartiles
        lineQ25 := line.new(bar_index, q25, bar_index + 30, q25, color=colorQuartiles, width=widthQuartiles, style=line.style_dotted)
        lineQ75 := line.new(bar_index, q75, bar_index + 30, q75, color=colorQuartiles, width=widthQuartiles, style=line.style_dotted)
    
    // Mean Reversion Levels
    if showSDLevels
        // ±0.5 LEVELS - THE KEY LEVELS (86.46%)
        lineMR05h := line.new(bar_index, mr05_h, bar_index + 30, mr05_h, color=colorSD05, width=widthSD05, style=line.style_solid)
        lineMR05l := line.new(bar_index, mr05_l, bar_index + 30, mr05_l, color=colorSD05, width=widthSD05, style=line.style_solid)
        
        // ±1.0 LEVELS - Secondary targets (74%)
        lineMR10h := line.new(bar_index, mr10_h, bar_index + 30, mr10_h, color=colorSD10, width=widthSD10, style=line.style_solid)
        lineMR10l := line.new(bar_index, mr10_l, bar_index + 30, mr10_l, color=colorSD10, width=widthSD10, style=line.style_solid)
        
        // ±2.0 LEVELS
        lineMR20h := line.new(bar_index, mr20_h, bar_index + 30, mr20_h, color=colorSD20, width=widthSD20, style=line.style_dotted)
        lineMR20l := line.new(bar_index, mr20_l, bar_index + 30, mr20_l, color=colorSD20, width=widthSD20, style=line.style_dotted)
    
    // R/R Zone
    if showSDLevels
        lineRR133h := line.new(bar_index, rr133_h, bar_index + 30, rr133_h, color=colorRR, width=widthRR, style=line.style_dotted)
        lineRR133l := line.new(bar_index, rr133_l, bar_index + 30, rr133_l, color=colorRR, width=widthRR, style=line.style_dotted)
        lineRR166h := line.new(bar_index, rr166_h, bar_index + 30, rr166_h, color=colorRR, width=widthRR, style=line.style_dotted)
        lineRR166l := line.new(bar_index, rr166_l, bar_index + 30, rr166_l, color=colorRR, width=widthRR, style=line.style_dotted)
    
    // R/R Zone Boxes
    if showMeanRevBoxes
        boxRR_upper := box.new(bar_index, rr166_h, bar_index + 30, rr133_h, border_color=color.new(colorRR, 70), bgcolor=boxColorRR)
        boxRR_lower := box.new(bar_index, rr133_l, bar_index + 30, rr166_l, border_color=color.new(colorRR, 70), bgcolor=boxColorRR)
    
    // ONS High/Low Lines (attached to actual candles where high/low occurred)
    // Note: Labels are created in the dynamic update section below, not here
    if showONSLevels and not na(onsHighValue) and not na(onsLowValue)
        // Draw ONS High line (no label here)
        if not onsHighSwept
            // Active (unswept) line
            lineONSHigh := line.new(onsHighBarValue, onsHighValue, bar_index + 30, onsHighValue, color=colorONS, width=widthONS, style=onsStyle)
        else if keepONSAfterSweep
            // Already swept but keep visible (dotted gray)
            lineONSHigh := line.new(onsHighBarValue, onsHighValue, bar_index + 30, onsHighValue, color=color.gray, width=1, style=line.style_dotted)
        
        // Draw ONS Low line (no label here)
        if not onsLowSwept
            // Active (unswept) line
            lineONSLow := line.new(onsLowBarValue, onsLowValue, bar_index + 30, onsLowValue, color=colorONS, width=widthONS, style=onsStyle)
        else if keepONSAfterSweep
            // Already swept but keep visible (dotted gray)
            lineONSLow := line.new(onsLowBarValue, onsLowValue, bar_index + 30, onsLowValue, color=color.gray, width=1, style=line.style_dotted)
    
    // 6-9 Labels
    highText = showPriceLabels ? "HIGH (" + str.tostring(rangeHigh, format.mintick) + ")" : "HIGH"
    lowText = showPriceLabels ? "LOW (" + str.tostring(rangeLow, format.mintick) + ")" : "LOW"
    openText = showPriceLabels ? "OPEN (" + str.tostring(rangeOpen, format.mintick) + ")" : "OPEN"
    eqText = showPriceLabels ? "EQ (" + str.tostring(rangeMid, format.mintick) + ")" : "EQ"
    
    lblHigh := label.new(bar_index + 30, rangeHigh, highText, style=label.style_none, textcolor=colorHL, size=size.normal, textalign=text.align_left)
    lblLow := label.new(bar_index + 30, rangeLow, lowText, style=label.style_none, textcolor=colorHL, size=size.normal, textalign=text.align_left)
    lblOpen := label.new(bar_index + 30, rangeOpen, openText, style=label.style_none, textcolor=colorOpen, size=size.normal, textalign=text.align_left)
    lblEQ := label.new(bar_index + 30, rangeMid, eqText, style=label.style_none, textcolor=colorEQ, size=size.normal, textalign=text.align_left)
    
    if showQuartiles
        lblQ25 := label.new(bar_index + 30, q25, "25%", style=label.style_none, textcolor=colorQuartiles, size=size.small, textalign=text.align_left)
        lblQ75 := label.new(bar_index + 30, q75, "75%", style=label.style_none, textcolor=colorQuartiles, size=size.small, textalign=text.align_left)
    
    // Mean Reversion Level Labels
    if showSDLevels
        // ±0.5 KEY LEVELS - Make them prominent (86.46% probability)
        mr05hText = showPriceLabels ? "⚡ +0.5 KEY (" + str.tostring(mr05_h, format.mintick) + ")" : "⚡ +0.5 KEY"
        mr05lText = showPriceLabels ? "⚡ -0.5 KEY (" + str.tostring(mr05_l, format.mintick) + ")" : "⚡ -0.5 KEY"
        
        // ±1.0 LEVELS - Secondary targets (74%)
        mr10hText = showPriceLabels ? "+1.0 (" + str.tostring(mr10_h, format.mintick) + ")" : "+1.0"
        mr10lText = showPriceLabels ? "-1.0 (" + str.tostring(mr10_l, format.mintick) + ")" : "-1.0"
        
        mr20hText = showPriceLabels ? "+2.0 (" + str.tostring(mr20_h, format.mintick) + ")" : "+2.0"
        mr20lText = showPriceLabels ? "-2.0 (" + str.tostring(mr20_l, format.mintick) + ")" : "-2.0"
        
        // ±0.5 KEY LABELS
        lblMR05h := label.new(bar_index + 30, mr05_h, mr05hText, style=label.style_none, textcolor=colorSD05, size=size.normal, textalign=text.align_left)
        lblMR05l := label.new(bar_index + 30, mr05_l, mr05lText, style=label.style_none, textcolor=colorSD05, size=size.normal, textalign=text.align_left)
        
        // ±1.0 LABELS
        lblMR10h := label.new(bar_index + 30, mr10_h, mr10hText, style=label.style_none, textcolor=colorSD10, size=size.small, textalign=text.align_left)
        lblMR10l := label.new(bar_index + 30, mr10_l, mr10lText, style=label.style_none, textcolor=colorSD10, size=size.small, textalign=text.align_left)
        
        // ±2.0 LABELS
        lblMR20h := label.new(bar_index + 30, mr20_h, mr20hText, style=label.style_none, textcolor=colorSD20, size=size.small, textalign=text.align_left)
        lblMR20l := label.new(bar_index + 30, mr20_l, mr20lText, style=label.style_none, textcolor=colorSD20, size=size.small, textalign=text.align_left)
        
        // R/R Zone Labels
        rr133hText = showPriceLabels ? "+1.33 (" + str.tostring(rr133_h, format.mintick) + ")" : "+1.33"
        rr133lText = showPriceLabels ? "-1.33 (" + str.tostring(rr133_l, format.mintick) + ")" : "-1.33"
        rr166hText = showPriceLabels ? "+1.66 (" + str.tostring(rr166_h, format.mintick) + ")" : "+1.66"
        rr166lText = showPriceLabels ? "-1.66 (" + str.tostring(rr166_l, format.mintick) + ")" : "-1.66"
        
        lblRR133h := label.new(bar_index + 30, rr133_h, rr133hText, style=label.style_none, textcolor=colorRR, size=size.small, textalign=text.align_left)
        lblRR133l := label.new(bar_index + 30, rr133_l, rr133lText, style=label.style_none, textcolor=colorRR, size=size.small, textalign=text.align_left)
        lblRR166h := label.new(bar_index + 30, rr166_h, rr166hText, style=label.style_none, textcolor=colorRR, size=size.small, textalign=text.align_left)
        lblRR166l := label.new(bar_index + 30, rr166_l, rr166lText, style=label.style_none, textcolor=colorRR, size=size.small, textalign=text.align_left)
    
    // ONS Labels
    if showONSLevels and not na(onsHighValue) and not na(onsLowValue)
        // ONS High label
        if not onsHighSwept
            // Active (unswept) label
            onsHighText = showPriceLabels ? "ONS HIGH (" + str.tostring(onsHighValue, format.mintick) + ")" : "ONS HIGH"
            lblONSHigh := label.new(bar_index + 30, onsHighValue, onsHighText, style=label.style_none, textcolor=colorONS, size=size.small, textalign=text.align_left)
        else if keepONSAfterSweep
            // Swept but keep visible (gray with checkmark)
            onsHighText = showPriceLabels ? "ONS HIGH ✓ (" + str.tostring(onsHighValue, format.mintick) + ")" : "ONS HIGH ✓"
            lblONSHigh := label.new(bar_index + 30, onsHighValue, onsHighText, style=label.style_none, textcolor=color.gray, size=size.small, textalign=text.align_left)
        
        // ONS Low label
        if not onsLowSwept
            // Active (unswept) label
            onsLowText = showPriceLabels ? "ONS LOW (" + str.tostring(onsLowValue, format.mintick) + ")" : "ONS LOW"
            lblONSLow := label.new(bar_index + 30, onsLowValue, onsLowText, style=label.style_none, textcolor=colorONS, size=size.small, textalign=text.align_left)
        else if keepONSAfterSweep
            // Swept but keep visible (gray with checkmark)
            onsLowText = showPriceLabels ? "ONS LOW ✓ (" + str.tostring(onsLowValue, format.mintick) + ")" : "ONS LOW ✓"
            lblONSLow := label.new(bar_index + 30, onsLowValue, onsLowText, style=label.style_none, textcolor=color.gray, size=size.small, textalign=text.align_left)

// ==================== UPDATE POSITIONS ====================
if valid and not na(lineHigh)
    line.set_x2(lineHigh, bar_index + 30)
    line.set_x2(lineLow, bar_index + 30)
    line.set_x2(lineEQ, bar_index + 30)
    line.set_x2(lineOpen, bar_index + 30)
    
    label.set_x(lblHigh, bar_index + 30)
    label.set_x(lblLow, bar_index + 30)
    label.set_x(lblOpen, bar_index + 30)
    label.set_x(lblEQ, bar_index + 30)
    
    if not na(lineQ25)
        line.set_x2(lineQ25, bar_index + 30)
        line.set_x2(lineQ75, bar_index + 30)
        label.set_x(lblQ25, bar_index + 30)
        label.set_x(lblQ75, bar_index + 30)
    
    if showSDLevels and not na(lineMR05h)
        line.set_x2(lineMR05h, bar_index + 30)
        line.set_x2(lineMR05l, bar_index + 30)
        line.set_x2(lineMR10h, bar_index + 30)
        line.set_x2(lineMR10l, bar_index + 30)
        line.set_x2(lineMR20h, bar_index + 30)
        line.set_x2(lineMR20l, bar_index + 30)
        line.set_x2(lineRR133h, bar_index + 30)
        line.set_x2(lineRR133l, bar_index + 30)
        line.set_x2(lineRR166h, bar_index + 30)
        line.set_x2(lineRR166l, bar_index + 30)
        
        label.set_x(lblMR05h, bar_index + 30)
        label.set_x(lblMR05l, bar_index + 30)
        label.set_x(lblMR10h, bar_index + 30)
        label.set_x(lblMR10l, bar_index + 30)
        label.set_x(lblMR20h, bar_index + 30)
        label.set_x(lblMR20l, bar_index + 30)
        label.set_x(lblRR133h, bar_index + 30)
        label.set_x(lblRR133l, bar_index + 30)
        label.set_x(lblRR166h, bar_index + 30)
        label.set_x(lblRR166l, bar_index + 30)
    
    if not na(boxRR_upper)
        box.set_right(boxRR_upper, bar_index + 30)
        box.set_right(boxRR_lower, bar_index + 30)
    
    // Update ONS High line
    if showONSLevels and not na(onsHighValue)
        if not onsHighSwept
            // Active (unswept) line
            if na(lineONSHigh)
                lineONSHigh := line.new(onsHighBarValue, onsHighValue, bar_index + 30, onsHighValue, color=colorONS, width=widthONS, style=onsStyle)
                lblONSHigh := label.new(bar_index + 30, onsHighValue, showPriceLabels ? "ONS HIGH (" + str.tostring(onsHighValue, format.mintick) + ")" : "ONS HIGH", style=label.style_none, textcolor=colorONS, size=size.small, textalign=text.align_left)
            else
                line.set_x2(lineONSHigh, bar_index + 30)
                label.set_x(lblONSHigh, bar_index + 30)
        else if keepONSAfterSweep
            // Swept but keep visible (change to dotted gray)
            if na(lineONSHigh)
                lineONSHigh := line.new(onsHighBarValue, onsHighValue, bar_index + 30, onsHighValue, color=color.gray, width=1, style=line.style_dotted)
                lblONSHigh := label.new(bar_index + 30, onsHighValue, showPriceLabels ? "ONS HIGH ✓ (" + str.tostring(onsHighValue, format.mintick) + ")" : "ONS HIGH ✓", style=label.style_none, textcolor=color.gray, size=size.small, textalign=text.align_left)
            else
                // Update swept line appearance and extend
                line.set_color(lineONSHigh, color.gray)
                line.set_width(lineONSHigh, 1)
                line.set_style(lineONSHigh, line.style_dotted)
                line.set_x2(lineONSHigh, bar_index + 30)
                label.set_textcolor(lblONSHigh, color.gray)
                label.set_text(lblONSHigh, showPriceLabels ? "ONS HIGH ✓ (" + str.tostring(onsHighValue, format.mintick) + ")" : "ONS HIGH ✓")
                label.set_x(lblONSHigh, bar_index + 30)
        else
            // Swept and don't keep - delete
            line.delete(lineONSHigh)
            label.delete(lblONSHigh)
            lineONSHigh := na
            lblONSHigh := na
    else if not showONSLevels
        // Toggle OFF - delete
        line.delete(lineONSHigh)
        label.delete(lblONSHigh)
        lineONSHigh := na
        lblONSHigh := na
    

    // Update ONS Low line
    if showONSLevels and not na(onsLowValue)
        if not onsLowSwept
            // Active (unswept) line
            if na(lineONSLow)
                lineONSLow := line.new(onsLowBarValue, onsLowValue, bar_index + 30, onsLowValue, color=colorONS, width=widthONS, style=onsStyle)
                lblONSLow := label.new(bar_index + 30, onsLowValue, showPriceLabels ? "ONS LOW (" + str.tostring(onsLowValue, format.mintick) + ")" : "ONS LOW", style=label.style_none, textcolor=colorONS, size=size.small, textalign=text.align_left)
            else
                line.set_x2(lineONSLow, bar_index + 30)
                label.set_x(lblONSLow, bar_index + 30)
        else if keepONSAfterSweep
            // Swept but keep visible (change to dotted gray)
            if na(lineONSLow)
                lineONSLow := line.new(onsLowBarValue, onsLowValue, bar_index + 30, onsLowValue, color=color.gray, width=1, style=line.style_dotted)
                lblONSLow := label.new(bar_index + 30, onsLowValue, showPriceLabels ? "ONS LOW ✓ (" + str.tostring(onsLowValue, format.mintick) + ")" : "ONS LOW ✓", style=label.style_none, textcolor=color.gray, size=size.small, textalign=text.align_left)
            else
                // Update swept line appearance and extend
                line.set_color(lineONSLow, color.gray)
                line.set_width(lineONSLow, 1)
                line.set_style(lineONSLow, line.style_dotted)
                line.set_x2(lineONSLow, bar_index + 30)
                label.set_textcolor(lblONSLow, color.gray)
                label.set_text(lblONSLow, showPriceLabels ? "ONS LOW ✓ (" + str.tostring(onsLowValue, format.mintick) + ")" : "ONS LOW ✓")
                label.set_x(lblONSLow, bar_index + 30)
        else
            // Swept and don't keep - delete
            line.delete(lineONSLow)
            label.delete(lblONSLow)
            lineONSLow := na
            lblONSLow := na
    else if not showONSLevels
        // Toggle OFF - delete
        line.delete(lineONSLow)
        label.delete(lblONSLow)
        lineONSLow := na
        lblONSLow := na

// ==================== BACKGROUND HIGHLIGHTING ====================
bgcolor(showRTHCandles and inRTHSession ? rthCandleColor : na, title="RTH Candles")
bgcolor(show940_950Window and in940_950Window ? color.new(color.yellow, 90) : na, title="9:40-9:50 Reversal Window")

// ==================== ENHANCED DASHBOARD ====================
if showDashboard and valid and barstate.islast
    var table dashboard = table.new(
         dashboardPosition == "Top Right" ? position.top_right : 
         dashboardPosition == "Top Left" ? position.top_left :
         dashboardPosition == "Bottom Right" ? position.bottom_right : position.bottom_left,
         3, 26)
    
    table.clear(dashboard, 0, 0, 2, 25)
    
    // Calculate stats
    rangePts = math.round(rangeSize, 2)
    rangePercent = (rangeSize / close) * 100
    
    // MARKET CONDITION DETECTION
    extendedONS = not na(onsRangeSize) and onsRangeSize > rangeSize * onsMultiplier
    shrankONS = not na(onsRangeSize) and onsRangeSize < rangeSize * 0.7
    
    // EDGE DETECTION
    rangeTooSmall = rangeSize < minRangeSize
    rangeTooLarge = rangeSize > maxRangeSize
    rangeOptimal = not rangeTooSmall and not rangeTooLarge
    
    // Window edge strength
    windowEdgeStrength = in940_950Window ? 86 : currentHour < 10 ? 75 : currentHour >= 10 and currentHour < 12 ? 60 : 40
    
    // Overall edge
    hasEdge = rangeOptimal and not extendedONS and windowEdgeStrength >= 60
    
    // Session Correlation (AM vs PM expectation)
    amExpansion = rangeSize > avgRangeSize * 1.2
    amConsolidation = rangeSize < avgRangeSize * 0.8
    pmExpectation = amExpansion ? "PM Consolidation" : amConsolidation ? "PM Expansion" : "PM Mixed"
    pmColor = amExpansion ? color.red : amConsolidation ? color.lime : color.yellow
    
    // Trade setup priority
    priceAboveEQ = close > rangeMid
    priceNearLevel = false
    priorityLevel = ""
    priorityColor = color.gray
    
    // Check distance to key levels
    distToHigh = math.abs(close - rangeHigh)
    distToLow = math.abs(close - rangeLow)
    distToEQ = math.abs(close - rangeMid)
    distToMR05h = math.abs(close - mr05_h)
    distToMR05l = math.abs(close - mr05_l)
    
    // Distance to nearest ±0.5 KEY level (THE 86% EDGE)
    distToNearestKey = math.min(distToMR05h, distToMR05l)
    nearestKeyLevel = distToMR05h < distToMR05l ? "+0.5" : "-0.5"
    
    // Trade window detection (MUST come before tradeWindowGuidance)
    tradeWindow = currentHour < 9 or (currentHour == 9 and currentMin < 30) ? "Pre-Market" : 
                   currentHour == 9 and currentMin >= 30 and currentMin < 40 ? "🎯 Judas" :
                   in940_950Window ? "⚡ REVERSAL" : 
                   currentHour >= 10 and currentHour < 12 ? "AM Session" :
                   currentHour >= 12 and currentHour < 16 ? "PM Session" : "After Hours"
    windowColor = in940_950Window ? color.new(color.yellow, 0) : 
                  currentHour == 9 and currentMin >= 30 and currentMin < 40 ? color.orange : 
                  color.gray
    
    // Trade Window Specific Guidance
    tradeWindowGuidance = ""
    tradeWindowColor = color.gray
    
    if tradeWindow == "Pre-Market"
        tradeWindowGuidance := "Wait for 9:30 Open"
        tradeWindowColor := color.gray
    else if tradeWindow == "🎯 Judas"
        tradeWindowGuidance := "Position toward ±0.5 KEY"
        tradeWindowColor := color.yellow
    else if tradeWindow == "⚡ REVERSAL"
        tradeWindowGuidance := "⚡ 86% EDGE at ±0.5 KEY"
        tradeWindowColor := color.lime
    else if tradeWindow == "AM Session"
        if currentHour < 10
            tradeWindowGuidance := "Close by 10:00 AM"
            tradeWindowColor := color.orange
        else
            tradeWindowGuidance := "AM Session Complete"
            tradeWindowColor := color.gray
    else if tradeWindow == "PM Session"
        tradeWindowGuidance := pmExpectation
        tradeWindowColor := pmColor
    
    minDist = math.min(distToHigh, distToLow, distToEQ, distToMR05h, distToMR05l)
    
    if minDist == distToMR05h or minDist == distToMR05l
        priorityLevel := "AT KEY LEVEL ⚡ ±0.5"
        priorityColor := color.lime
        priceNearLevel := true
    else if minDist == distToHigh
        priorityLevel := "AT 6-9 HIGH"
        priorityColor := color.yellow
        priceNearLevel := true
    else if minDist == distToLow
        priorityLevel := "AT 6-9 LOW"
        priorityColor := color.yellow
        priceNearLevel := true
    else if minDist == distToEQ
        priorityLevel := "AT EQUILIBRIUM"
        priorityColor := color.blue
        priceNearLevel := true
    else
        priorityLevel := priceAboveEQ ? "Above EQ" : "Below EQ"
        priorityColor := color.gray
    
    // ========== HEADER ==========
    table.cell(dashboard, 0, 0, "6-9 STRATEGY", text_color=color.white, bgcolor=color.new(#2962FF, 0), text_size=size.large)
    table.merge_cells(dashboard, 0, 0, 2, 0)
    
    // ========== CURRENT WINDOW ==========
    table.cell(dashboard, 0, 1, tradeWindow, text_color=color.white, bgcolor=color.new(windowColor, 30), text_size=size.large)
    table.merge_cells(dashboard, 0, 1, 2, 1)
    
    // ========== WINDOW GUIDANCE ==========
    table.cell(dashboard, 0, 2, tradeWindowGuidance, text_color=color.white, bgcolor=color.new(tradeWindowColor, 30), text_size=size.small)
    table.merge_cells(dashboard, 0, 2, 2, 2)
    
    // ========== DIVIDER ==========
    table.cell(dashboard, 0, 3, "═══════════════", text_color=color.gray, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.merge_cells(dashboard, 0, 3, 2, 3)
    
    rowOffset = 0  // Reset rowOffset since we removed conditional sections
    
    // ========== RANGE STATS ==========
    table.cell(dashboard, 0, 4, "6-9 Range", text_color=color.yellow, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(dashboard, 1, 4, str.tostring(rangePts) + " pts", text_color=rangeOptimal ? color.lime : color.red, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(dashboard, 2, 4, str.tostring(math.round(rangePercent, 2)) + "%", text_color=color.gray, bgcolor=color.new(color.black, 20), text_size=size.small)
    
    // ========== ONS STATUS (SIMPLIFIED) ==========
    if not na(onsRangeSize)
        table.cell(dashboard, 0, 5, "ONS Status", text_color=color.purple, bgcolor=color.new(color.black, 20), text_size=size.small)
        onsStatus = extendedONS ? "⚠️ EXTENDED" : "✓ Normal"
        onsStatusColor = extendedONS ? color.orange : color.lime
        table.cell(dashboard, 1, 5, onsStatus, text_color=onsStatusColor, bgcolor=color.new(color.black, 20), text_size=size.small)
        table.merge_cells(dashboard, 1, 5, 2, 5)
    
    // ========== ONS SWEEP STATUS ==========
    if not na(onsHighValue) and not na(onsLowValue)
        table.cell(dashboard, 0, 6, "ONS High", text_color=color.silver, bgcolor=color.new(color.black, 20), text_size=size.small)
        onsHighStatus = onsHighSwept ? "✓ Swept" : "✗ Unswept"
        onsHighColor = onsHighSwept ? color.gray : color.orange
        table.cell(dashboard, 1, 6, onsHighStatus, text_color=onsHighColor, bgcolor=color.new(color.black, 20), text_size=size.small)
        table.merge_cells(dashboard, 1, 6, 2, 6)
        
        table.cell(dashboard, 0, 7, "ONS Low", text_color=color.silver, bgcolor=color.new(color.black, 20), text_size=size.small)
        onsLowStatus = onsLowSwept ? "✓ Swept" : "✗ Unswept"
        onsLowColor = onsLowSwept ? color.gray : color.orange
        table.cell(dashboard, 1, 7, onsLowStatus, text_color=onsLowColor, bgcolor=color.new(color.black, 20), text_size=size.small)
        table.merge_cells(dashboard, 1, 7, 2, 7)
    
    // ========== FRAMEWORK SCENARIO & JUDAS ==========
    if not na(onsHighValue) and not na(onsLowValue)
        // Determine framework scenario based on sweeps
        string scenario = ""
        string judasDirection = ""
        string reversalTarget = ""
        color scenarioColor = color.gray
        
        // Scenario 1: Both swept = Stop Hunt
        if onsHighSwept and onsLowSwept
            scenario := "🚀 STOP HUNT"
            judasDirection := "No Judas Expected"
            reversalTarget := "±1.0 SD+ Expansion"
            scenarioColor := color.new(color.blue, 0)
        
        // Scenario 2: Both unswept = Extended ONS
        else if not onsHighSwept and not onsLowSwept
            scenario := "⚠️ EXTENDED ONS"
            judasDirection := "Watch 9:30 Direction"
            reversalTarget := "±0.5 KEY Only"
            scenarioColor := color.new(color.orange, 0)
        
        // Scenario 3: High unswept = Bullish Judas
        else if not onsHighSwept and onsLowSwept
            scenario := "⚡ JUDAS SETUP"
            judasDirection := "→ UP (Target: " + str.tostring(math.round(onsHighValue)) + ")"
            reversalTarget := "SHORT at +0.5 KEY"
            scenarioColor := color.new(color.lime, 0)
        
        // Scenario 4: Low unswept = Bearish Judas
        else if onsHighSwept and not onsLowSwept
            scenario := "⚡ JUDAS SETUP"
            judasDirection := "→ DOWN (Target: " + str.tostring(math.round(onsLowValue)) + ")"
            reversalTarget := "LONG at -0.5 KEY"
            scenarioColor := color.new(color.red, 0)
        
        table.cell(dashboard, 0, 8, scenario, text_color=color.white, bgcolor=scenarioColor, text_size=size.normal)
        table.merge_cells(dashboard, 0, 8, 2, 8)
        
        table.cell(dashboard, 0, 9, "Judas (9:30-9:40)", text_color=color.silver, bgcolor=color.new(color.black, 20), text_size=size.small)
        table.cell(dashboard, 1, 9, judasDirection, text_color=color.white, bgcolor=color.new(color.black, 30), text_size=size.small)
        table.merge_cells(dashboard, 1, 9, 2, 9)
        
        table.cell(dashboard, 0, 10, "Reversal (9:40-9:50)", text_color=color.silver, bgcolor=color.new(color.black, 20), text_size=size.small)
        table.cell(dashboard, 1, 10, reversalTarget, text_color=color.lime, bgcolor=color.new(color.black, 30), text_size=size.small)
        table.merge_cells(dashboard, 1, 10, 2, 10)
    
    // ========== DIVIDER ==========
    table.cell(dashboard, 0, 11, "═══════════════", text_color=color.gray, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.merge_cells(dashboard, 0, 11, 2, 11)
    
    // ========== FRAMEWORK TARGETS ==========
    table.cell(dashboard, 0, 12, "Framework Targets", text_color=color.yellow, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.merge_cells(dashboard, 0, 12, 2, 12)
    
    // Display targets based on scenario
    string target1 = ""
    string target2 = ""
    
    if onsHighSwept and onsLowSwept
        // Stop Hunt: Higher projections
        target1 := "Primary: ±1.0 SD (74%)"
        target2 := "Extended: ±2.0 SD+ (26%)"
    else if extendedONS
        // Extended ONS: Limited targets
        target1 := "Primary: 6-9 High/Low"
        target2 := "Max: ±0.5 KEY (86%)"
    else
        // Normal: Standard targets
        target1 := "Primary: ±0.5 KEY (86%)"
        target2 := "Extended: ±1.0 SD (74%)"
    
    table.cell(dashboard, 0, 13, target1, text_color=color.lime, bgcolor=color.new(color.black, 30), text_size=size.small)
    table.merge_cells(dashboard, 0, 13, 2, 13)
    
    table.cell(dashboard, 0, 14, target2, text_color=color.gray, bgcolor=color.new(color.black, 30), text_size=size.small)
    table.merge_cells(dashboard, 0, 14, 2, 14)
