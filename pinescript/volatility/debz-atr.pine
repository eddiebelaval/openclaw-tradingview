//@version=5
indicator(title="DEBZ - ATR", overlay=true)

// ═══════════════════════════════════════════════════════════
//  INPUTS
// ═══════════════════════════════════════════════════════════
length         = input.int   (14,    title="Length",      minval=1)
smoothing      = input.string("RMA", title="Smoothing",   options=["RMA","SMA","EMA","WMA"])
multiplier     = input.float (1.5,   title="Multiplier",  minval=0.1, step=0.1)
src1           = input.source(high,  title="Src1")
src2           = input.source(low,   title="Src2")
showPriceLines = input.bool  (true,  title="Show Price Lines")

// ── Color Inputs ────────────────────────────────────────────
atrTextColor  = input.color(color.new(#2196F3,  0), title="ATR Text Color")
lowTextColor  = input.color(color.new(#00BCD4,  0), title="Low Text Color")
lowLineColor  = input.color(color.new(#00BCD4,  0), title="Low Line Color")
highTextColor = input.color(color.new(#F44336,  0), title="High Text Color")
highLineColor = input.color(color.new(#F44336,  0), title="High Line Color")

// ═══════════════════════════════════════════════════════════
//  ATR CALCULATION
// ═══════════════════════════════════════════════════════════
trueRange = ta.tr(true)

atrVal = switch smoothing
    "RMA" => ta.rma(trueRange, length)
    "SMA" => ta.sma(trueRange, length)
    "EMA" => ta.ema(trueRange, length)
    "WMA" => ta.wma(trueRange, length)
    =>       ta.rma(trueRange, length)

// ═══════════════════════════════════════════════════════════
//  BANDS  (Short SL = upper, Long SL = lower)
// ═══════════════════════════════════════════════════════════
upperBand = src1 + atrVal * multiplier   // ATR Short Stop Loss
lowerBand = src2 - atrVal * multiplier   // ATR Long Stop Loss

// ─── Main Band Plots ────────────────────────────────────────
plot(upperBand, title="ATR Short Stop Loss", color=highLineColor, linewidth=2)
plot(lowerBand, title="ATR Long Stop Loss",  color=lowLineColor,  linewidth=2)

// ═══════════════════════════════════════════════════════════
//  PRICE LINES (extending horizontal dashed lines at bar close)
// ═══════════════════════════════════════════════════════════
var line pLineUpper = na
var line pLineLower = na

if showPriceLines and barstate.islast
    if not na(pLineUpper)
        line.delete(pLineUpper)
    if not na(pLineLower)
        line.delete(pLineLower)

    pLineUpper := line.new(bar_index - 1, upperBand, bar_index, upperBand,
                           extend   = extend.right,
                           color    = highLineColor,
                           style    = line.style_dashed,
                           width    = 1)
    pLineLower := line.new(bar_index - 1, lowerBand, bar_index, lowerBand,
                           extend   = extend.right,
                           color    = lowLineColor,
                           style    = line.style_dashed,
                           width    = 1)

// ═══════════════════════════════════════════════════════════
//  LABELS AT LAST BAR
// ═══════════════════════════════════════════════════════════
var label lblUpper = na
var label lblLower = na
var label lblATR   = na

if barstate.islast
    label.delete(lblUpper)
    label.delete(lblLower)
    label.delete(lblATR)

    lblUpper := label.new(
         x         = bar_index + 2,
         y         = upperBand,
         text      = "Short SL  " + str.tostring(upperBand, format.mintick),
         xloc      = xloc.bar_index,
         yloc      = yloc.price,
         color     = color.new(color.black, 100),
         textcolor = highTextColor,
         size      = size.small,
         style     = label.style_label_left)

    lblLower := label.new(
         x         = bar_index + 2,
         y         = lowerBand,
         text      = "Long SL  " + str.tostring(lowerBand, format.mintick),
         xloc      = xloc.bar_index,
         yloc      = yloc.price,
         color     = color.new(color.black, 100),
         textcolor = lowTextColor,
         size      = size.small,
         style     = label.style_label_left)

    lblATR := label.new(
         x         = bar_index + 2,
         y         = (upperBand + lowerBand) / 2,
         text      = "ATR(" + str.tostring(length) + ")  " + str.tostring(atrVal, format.mintick),
         xloc      = xloc.bar_index,
         yloc      = yloc.price,
         color     = color.new(color.black, 100),
         textcolor = atrTextColor,
         size      = size.small,
         style     = label.style_label_left)

// ═══════════════════════════════════════════════════════════
//  TABLE (top-right corner)
// ═══════════════════════════════════════════════════════════
var table atrTable = table.new(
     position     = position.top_right,
     columns      = 2,
     rows         = 3,
     bgcolor      = color.new(color.black, 75),
     border_color = color.new(color.gray,  50),
     border_width = 1)

if barstate.islast
    // Row 0 – ATR value
    table.cell(atrTable, 0, 0, "ATR (" + str.tostring(length) + ")",
               text_color=atrTextColor, text_size=size.small, bgcolor=color.new(color.black,75))
    table.cell(atrTable, 1, 0, str.tostring(atrVal, format.mintick),
               text_color=atrTextColor, text_size=size.small, bgcolor=color.new(color.black,75))
    // Row 1 – Short Stop Loss
    table.cell(atrTable, 0, 1, "Short SL",
               text_color=highTextColor, text_size=size.small, bgcolor=color.new(color.black,75))
    table.cell(atrTable, 1, 1, str.tostring(upperBand, format.mintick),
               text_color=highTextColor, text_size=size.small, bgcolor=color.new(color.black,75))
    // Row 2 – Long Stop Loss
    table.cell(atrTable, 0, 2, "Long SL",
               text_color=lowTextColor, text_size=size.small, bgcolor=color.new(color.black,75))
    table.cell(atrTable, 1, 2, str.tostring(lowerBand, format.mintick),
               text_color=lowTextColor, text_size=size.small, bgcolor=color.new(color.black,75))

// ═══════════════════════════════════════════════════════════
//  CROSSOVER / TOUCH DOTS  (blue circles where price meets bands)
// ═══════════════════════════════════════════════════════════
touchUpper = ta.crossunder(close, upperBand) or ta.crossover(close, upperBand)
touchLower = ta.crossover(close, lowerBand)  or ta.crossunder(close, lowerBand)

plotshape(touchUpper, title="Upper Touch", style=shape.circle,
          location=location.absolute, color=color.new(#2196F3, 0),
          size=size.tiny, offset=0)

plotshape(touchLower, title="Lower Touch", style=shape.circle,
          location=location.absolute, color=color.new(#2196F3, 0),
          size=size.tiny, offset=0)
