//@version=5
indicator("SPX Realized Volatility (1M & 3M)", overlay=false)

// Parameters
trading_days = 252

// Log returns
ret = math.log(close / close[1])

// Realized volatility
rv_1m = ta.stdev(ret, 21) * math.sqrt(trading_days)
rv_3m = ta.stdev(ret, 63) * math.sqrt(trading_days)

// Plot
plot(rv_1m, title="1M Realized Vol", linewidth=2)
plot(rv_3m, title="3M Realized Vol", linewidth=2)
