//@version=6
indicator("NOA Trading Sessions Pro", overlay = true, max_lines_count = 500, max_labels_count = 500)

//------------------------------------------------------------------------------
// General Settings
//------------------------------------------------------------------------------
string modeInput            = input.string("Intraday", "Indicator Mode", options = ["Intraday", "ETH", "RTH", "Full Day"], tooltip = "Intraday mode uses the 4 sessions defined below. ETH/RTH/Full Day track singular specific periods.")
bool   showSessionNames     = input.bool(true, "Show session names")
bool   showSessionLines     = input.bool(true, "Draw session OHLC lines")
string midVwapChoice        = input.string("Mid", "Plot Mid or VWAP Line", options = ["Mid", "VWAP", "Both", "None"], tooltip = "Requires 'Draw session OHLC lines' to be enabled.")
bool   showSessionTickRange = input.bool(true, "Show tick range for each session")
int    atrLength            = input.int(14, "Session Avg Length (Days)", minval = 1, tooltip = "Calculates the average range and volume over the last X days.")
int    fillTransparency     = input.int(85, "Fill zone transparency", minval = 0, maxval = 100)
int    maxHistorySessions   = input.int(20, "Max completed sessions to keep", minval = 0, maxval = 100)
string labelSizeInput       = input.string("Tiny", "Text Size", options = ["Tiny", "Small", "Normal"])
float  labelOffsetAtr       = input.float(0.5, "Label Offset (ATR)", minval = 0.0, step = 0.1, tooltip = "Pushes the label down dynamically based on chart volatility.")

//------------------------------------------------------------------------------
// Global / Extended Session Settings
//------------------------------------------------------------------------------
bool   isNotIntraday        = modeInput != "Intraday"
const string GLOB_GROUP     = "Extended Mode Settings"
string globSessionName      = input.string("Session", "Displayed Name", group = GLOB_GROUP, active = isNotIntraday)
color  globSessionColor     = input.color(color.new(color.gray, 50), "Session Color", group = GLOB_GROUP, active = isNotIntraday)
color  specialLineColor     = input.color(color.red, "Mid/VWAP Line Color", group = GLOB_GROUP, tooltip = "Distinct color for Mid and VWAP lines.")
string ethSessionTime       = input.session("1800-0930", "ETH Time", group = GLOB_GROUP, active = modeInput == "ETH")
string rthSessionTime       = input.session("0930-1600", "RTH Time", group = GLOB_GROUP, active = modeInput == "RTH")

//------------------------------------------------------------------------------
// ATR Volatility Heatmap
//------------------------------------------------------------------------------
const string HEATMAP_GROUP  = "ATR Volatility Heatmap"
bool   useAtrColors         = input.bool(true, "Enable ATR Heatmap Colors", group = HEATMAP_GROUP)
float  atrTierExpansion     = input.float(120.0, "Red: Expansion Threshold (%)", group = HEATMAP_GROUP)
float  atrTierTarget        = input.float(100.0, "Yellow: Exhaustion Threshold (%)", group = HEATMAP_GROUP)
float  atrTierNormal        = input.float(70.0, "White: Normal Threshold (%)", group = HEATMAP_GROUP)

const string TZ_TOOLTIP_TEXT = "The session's time zone (e.g., 'GMT-5' or 'America/New_York')."

//------------------------------------------------------------------------------
// Intraday Sessions Configuration (Hidden unless Mode is Intraday)
//------------------------------------------------------------------------------
bool   isIntradayMode       = modeInput == "Intraday"

const string FIRST_SESSION_GROUP = "First Session"
bool   showFirst         = input.bool(true, "Show", group = FIRST_SESSION_GROUP, inline = "s1_1", active = isIntradayMode)
string firstSessionName  = input.string("Tokyo", "", group = FIRST_SESSION_GROUP, inline = "s1_1", active = isIntradayMode)
string firstSessionTime  = input.session("0900-1530", "", group = FIRST_SESSION_GROUP, inline = "s1_1", active = isIntradayMode)
string firstSessionTZ    = input.string("Asia/Tokyo", "TZ", group = FIRST_SESSION_GROUP, inline = "s1_2", tooltip = TZ_TOOLTIP_TEXT, active = isIntradayMode)
color  firstSessionColor = input.color(color.new(#2962FF, 50), "Color", group = FIRST_SESSION_GROUP, inline = "s1_2", active = isIntradayMode)

const string SECOND_SESSION_GROUP = "Second Session"
bool   showSecond         = input.bool(true, "Show", group = SECOND_SESSION_GROUP, inline = "s2_1", active = isIntradayMode)
string secondSessionName  = input.string("London", "", group = SECOND_SESSION_GROUP, inline = "s2_1", active = isIntradayMode)
string secondSessionTime  = input.session("0800-1430", "", group = SECOND_SESSION_GROUP, inline = "s2_1", active = isIntradayMode)
string secondSessionTZ    = input.string("Europe/London", "TZ", group = SECOND_SESSION_GROUP, inline = "s2_2", tooltip = TZ_TOOLTIP_TEXT, active = isIntradayMode)
color  secondSessionColor = input.color(color.new(#FF9800, 50), "Color", group = SECOND_SESSION_GROUP, inline = "s2_2", active = isIntradayMode)

const string THIRD_SESSION_GROUP = "Third Session"
bool   showThird         = input.bool(true, "Show", group = THIRD_SESSION_GROUP, inline = "s3_1", active = isIntradayMode)
string thirdSessionName  = input.string("Atlantic", "", group = THIRD_SESSION_GROUP, inline = "s3_1", active = isIntradayMode)
string thirdSessionTime  = input.session("0930-1130", "", group = THIRD_SESSION_GROUP, inline = "s3_1", active = isIntradayMode)
string thirdSessionTZ    = input.string("America/New_York", "TZ", group = THIRD_SESSION_GROUP, inline = "s3_2", tooltip = TZ_TOOLTIP_TEXT, active = isIntradayMode)
color  thirdSessionColor = input.color(color.new(#00BCD4, 50), "Color", group = THIRD_SESSION_GROUP, inline = "s3_2", active = isIntradayMode)

const string FOURTH_SESSION_GROUP = "Fourth Session (New York)"
bool   showFourth         = input.bool(true, "Show", group = FOURTH_SESSION_GROUP, inline = "s4_1", active = isIntradayMode)
string fourthSessionName  = input.string("New York", "", group = FOURTH_SESSION_GROUP, inline = "s4_1", active = isIntradayMode)
string fourthSessionTime  = input.session("1130-1600", "", group = FOURTH_SESSION_GROUP, inline = "s4_1", active = isIntradayMode)
string fourthSessionTZ    = input.string("America/New_York", "TZ", group = FOURTH_SESSION_GROUP, inline = "s4_2", tooltip = TZ_TOOLTIP_TEXT, active = isIntradayMode)
color  fourthSessionColor = input.color(color.new(#E91E63, 50), "Color", group = FOURTH_SESSION_GROUP, inline = "s4_2", active = isIntradayMode)

//------------------------------------------------------------------------------
// Global Calculations
//------------------------------------------------------------------------------
float globalAtr = ta.atr(14)

//------------------------------------------------------------------------------
// Helpers
//------------------------------------------------------------------------------
getLabelSize(string sz) =>
    sz == "Tiny" ? size.tiny : sz == "Small" ? size.small : size.normal

fmtNum(float x) => str.format("{0,number,########0.#####}", x)
fmtPct(float x) => na(x) ? "" : str.format(" ({0,number,0.00}%)", x * 100.0)
fmtVWAP(float x) =>
    na(x) ? "—" :
     syminfo.mintick >= 1.0 ? str.format("{0,number,###,###,###}", x) :
     syminfo.mintick >= 0.01 ? str.format("{0,number,###,###,###.00}", x) :
     syminfo.mintick >= 0.0001 ? str.format("{0,number,###,###,###.0000}", x) :
     str.format("{0,number,###,###,###.########}", x)
fmtVol(float v) =>
    float vAbs = math.abs(v)
    vAbs >= 1e9 ? str.format("{0,number,0.00} B", v / 1e9) :
     vAbs >= 1e6 ? str.format("{0,number,0.00} M", v / 1e6) :
     vAbs >= 1e3 ? str.format("{0,number,0.00} K", v / 1e3) :
     str.format("{0,number,0}", v)

//------------------------------------------------------------------------------
// Types
//------------------------------------------------------------------------------
type SessionDisplay
    label    sessionLabel
    line     openLine
    line     hiLine
    line     loLine
    line     midLine
    line     vwapLine
    line     closeLine
    linefill bgFill
    float    openPrice
    float    hiPrice
    float    loPrice
    float    volSum
    float    pvSum
    int      startIndex
    float    sessionAvgRange
    float    sessionAvgVol

type SessionState
    array<float>          histRanges
    array<float>          histVolumes
    array<SessionDisplay> history
    SessionDisplay        active = na

//------------------------------------------------------------------------------
// SessionDisplay Methods
//------------------------------------------------------------------------------
method destroy(SessionDisplay this) =>
    label.delete(this.sessionLabel)
    linefill.delete(this.bgFill)
    line.delete(this.openLine), line.delete(this.hiLine), line.delete(this.loLine)
    line.delete(this.midLine), line.delete(this.vwapLine), line.delete(this.closeLine)

method refreshLabel(SessionDisplay this, color baseColor, string name) =>
    float safeOpen   = this.openPrice != 0.0 ? this.openPrice : na
    float priceRange = this.hiPrice - this.loPrice
    float pctRange   = not na(safeOpen) ? priceRange / safeOpen : na
    int   rangeTicks = int(math.round(priceRange / syminfo.mintick))
    float delta      = close - this.openPrice
    float deltaPct   = not na(safeOpen) ? delta / safeOpen : na
    int   deltaTicks = int(math.round(delta / syminfo.mintick))
    float avgRangePct = (not na(safeOpen) and not na(this.sessionAvgRange)) ? this.sessionAvgRange / safeOpen : na
    int   avgRangeTicks = not na(this.sessionAvgRange) ? int(math.round(this.sessionAvgRange / syminfo.mintick)) : na
    float vwapValue = this.volSum > 0.0 ? this.pvSum / this.volSum : na

    color txtColor = color.new(baseColor, 0)
    if useAtrColors and not na(this.sessionAvgRange) and this.sessionAvgRange > 0.0
        float atrRatio = (priceRange / this.sessionAvgRange) * 100.0
        if atrRatio >= atrTierExpansion
            txtColor := color.red
        else if atrRatio >= atrTierTarget
            txtColor := color.yellow
        else if atrRatio >= atrTierNormal
            txtColor := color.white
        else
            txtColor := color.gray

    string boxText = ""
    if showSessionNames
        boxText += name + "\n"
    if showSessionTickRange
        boxText += "Range: " + fmtNum(priceRange) + fmtPct(pctRange) + ", " + str.tostring(rangeTicks) + " Ticks\n"
        if not na(this.sessionAvgRange)
            boxText += "Avg R: " + fmtNum(this.sessionAvgRange) + fmtPct(avgRangePct) + ", " + str.tostring(avgRangeTicks) + " Ticks\n"

    boxText += "Delta: " + fmtNum(delta) + fmtPct(deltaPct) + ", " + str.tostring(deltaTicks) + " Ticks\n"
    boxText += "Vol: " + fmtVol(this.volSum)
    if not na(this.sessionAvgVol) and this.sessionAvgVol > 0.0
        boxText += " | " + str.format("{0,number,0.00}x", this.volSum / this.sessionAvgVol)
    boxText += "\nVWAP: " + fmtVWAP(vwapValue)

    int centerIndex = int(math.round((this.startIndex + bar_index) * 0.5))
    float safeAtr = na(globalAtr) ? 0.0 : globalAtr
    label.set_x(this.sessionLabel, centerIndex)
    label.set_y(this.sessionLabel, this.loPrice - (safeAtr * labelOffsetAtr))
    label.set_text(this.sessionLabel, boxText)
    label.set_textcolor(this.sessionLabel, txtColor)

//------------------------------------------------------------------------------
// SessionState Methods
//------------------------------------------------------------------------------
method pruneHistory(SessionState this, int keepCount) =>
    while array.size(this.history) > keepCount
        SessionDisplay oldest = array.shift(this.history)
        oldest.destroy()

method archiveActive(SessionState this, int avgLength, int keepCount) =>
    if not na(this.active)
        array.push(this.histRanges, this.active.hiPrice - this.active.loPrice)
        if array.size(this.histRanges) > avgLength
            array.shift(this.histRanges)
        array.push(this.histVolumes, this.active.volSum)
        if array.size(this.histVolumes) > avgLength
            array.shift(this.histVolumes)
        if keepCount > 0
            array.push(this.history, this.active)
            this.pruneHistory(keepCount)
        else
            this.active.destroy()
        this.active := na

//------------------------------------------------------------------------------
// Session Runtime Functions
//------------------------------------------------------------------------------
createSessionDisplay(SessionState state, color baseColor, string name) =>
    color opaqueColor = color.new(baseColor, 0)
    line oLine = na, line hLine = na, line lLine = na, line cLine = na, line mLine = na, line vLine = na, linefill bFill = na

    if showSessionLines
        oLine := line.new(bar_index, open, bar_index, open, color = opaqueColor, style = line.style_solid, width = 1)
        hLine := line.new(bar_index, high, bar_index, high, color = opaqueColor, style = line.style_dashed, width = 1)
        lLine := line.new(bar_index, low, bar_index, low, color = opaqueColor, style = line.style_dashed, width = 1)
        cLine := line.new(bar_index, close, bar_index, close, color = opaqueColor, style = line.style_solid, width = 1)
        if midVwapChoice == "Mid" or midVwapChoice == "Both"
            float initialMid = (high + low) * 0.5
            mLine := line.new(bar_index, initialMid, bar_index, initialMid, color = specialLineColor, style = line.style_dotted, width = 1)
        if midVwapChoice == "VWAP" or midVwapChoice == "Both"
            vLine := line.new(bar_index, hlc3, bar_index, hlc3, color = specialLineColor, style = line.style_dashed, width = 1)
        color initialFillColor = close >= open ? color.new(color.green, fillTransparency) : color.new(color.red, fillTransparency)
        bFill := linefill.new(oLine, cLine, initialFillColor)

    float avgRange = array.size(state.histRanges) > 0 ? array.avg(state.histRanges) : na
    float avgVol   = array.size(state.histVolumes) > 0 ? array.avg(state.histVolumes) : na

    SessionDisplay disp = SessionDisplay.new(
         sessionLabel    = label.new(bar_index, low, "", style = label.style_label_up, size = getLabelSize(labelSizeInput), textalign = text.align_center, textcolor = opaqueColor, color = color(na)),
         openLine        = oLine, hiLine = hLine, loLine = lLine, midLine = mLine, vwapLine = vLine, closeLine = cLine, bgFill = bFill,
         openPrice = open, hiPrice = high, loPrice = low, volSum = volume, pvSum = hlc3 * volume, startIndex = bar_index, sessionAvgRange = avgRange, sessionAvgVol = avgVol
     )
    disp.refreshLabel(baseColor, name)
    disp

updateSessionDisplay(SessionDisplay disp, color baseColor, string name) =>
    disp.hiPrice := math.max(disp.hiPrice, high), disp.loPrice := math.min(disp.loPrice, low)
    disp.volSum  += volume, disp.pvSum   += hlc3 * volume
    float midPrice = (disp.hiPrice + disp.loPrice) * 0.5
    float vwapVal  = disp.volSum > 0.0 ? disp.pvSum / disp.volSum : close

    if showSessionLines
        line.set_x2(disp.openLine, bar_index)
        line.set_x2(disp.hiLine, bar_index), line.set_y1(disp.hiLine, disp.hiPrice), line.set_y2(disp.hiLine, disp.hiPrice)
        line.set_x2(disp.loLine, bar_index), line.set_y1(disp.loLine, disp.loPrice), line.set_y2(disp.loLine, disp.loPrice)
        if not na(disp.midLine)
            line.set_x2(disp.midLine, bar_index), line.set_y1(disp.midLine, midPrice), line.set_y2(disp.midLine, midPrice)
        if not na(disp.vwapLine)
            line.set_x2(disp.vwapLine, bar_index), line.set_y1(disp.vwapLine, vwapVal), line.set_y2(disp.vwapLine, vwapVal)
        line.set_x2(disp.closeLine, bar_index), line.set_y1(disp.closeLine, close), line.set_y2(disp.closeLine, close)
        if not na(disp.bgFill)
            color fillColor = close >= disp.openPrice ? color.new(color.green, fillTransparency) : color.new(color.red, fillTransparency)
            linefill.set_color(disp.bgFill, fillColor)
    disp.refreshLabel(baseColor, name)

processSession(SessionState state, bool enabled, string name, string sessionStr, string sessionTz, color baseColor, bool manualDeactivate = false) =>
    bool inSession = enabled and not na(time(timeframe.period, sessionStr, sessionTz))
    if inSession and not manualDeactivate
        if na(state.active)
            state.active := createSessionDisplay(state, baseColor, name)
        else
            updateSessionDisplay(state.active, baseColor, name)
    else
        if not na(state.active)
            state.archiveActive(atrLength, maxHistorySessions)
    bool isProcessed = true 

//------------------------------------------------------------------------------
// Runtime Execution
//------------------------------------------------------------------------------
if barstate.isfirst and not timeframe.isintraday
    runtime.error("Intraday timeframes only.")

var SessionState firstState  = SessionState.new(array.new<float>(), array.new<float>(), array.new<SessionDisplay>())
var SessionState secondState = SessionState.new(array.new<float>(), array.new<float>(), array.new<SessionDisplay>())
var SessionState thirdState  = SessionState.new(array.new<float>(), array.new<float>(), array.new<SessionDisplay>())
var SessionState fourthState = SessionState.new(array.new<float>(), array.new<float>(), array.new<SessionDisplay>())
var SessionState masterState = SessionState.new(array.new<float>(), array.new<float>(), array.new<SessionDisplay>())

if modeInput == "Intraday"
    processSession(firstState, showFirst, firstSessionName, firstSessionTime, firstSessionTZ, firstSessionColor)
    processSession(secondState, showSecond, secondSessionName, secondSessionTime, secondSessionTZ, secondSessionColor)
    processSession(thirdState, showThird, thirdSessionName, thirdSessionTime, thirdSessionTZ, thirdSessionColor)
    processSession(fourthState, showFourth, fourthSessionName, fourthSessionTime, fourthSessionTZ, fourthSessionColor)
else if modeInput == "Full Day"
    bool isNewDay = ta.change(time("D")) != 0
    if isNewDay and not na(masterState.active)
        processSession(masterState, true, globSessionName, "", "", globSessionColor, true)
    processSession(masterState, true, globSessionName, "0000-0000:1234567", syminfo.timezone, globSessionColor)
else if modeInput == "ETH"
    processSession(masterState, true, globSessionName, ethSessionTime, syminfo.timezone, globSessionColor)
else if modeInput == "RTH"
    processSession(masterState, true, globSessionName, rthSessionTime, syminfo.timezone, globSessionColor)
