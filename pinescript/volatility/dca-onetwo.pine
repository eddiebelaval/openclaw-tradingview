//@version=5
indicator("Alert every 10 minutes", overlay = false, max_labels_count = 500)

// Самый стабильный способ: детектим начало нового 10-минутного бара
new_10min_bar = ta.change(time("10")) != 0

// Визуальная метка для теста (чтобы видеть, когда триггерится)
if new_10min_bar
    label.new(
         x       = bar_index,
         y       = high,
         text    = "10 min",
         color   = color.new(color.green, 0),
         textcolor = color.white,
         style   = label.style_label_down,
         size    = size.small
         )

// Отправляем alert только на realtime-баре и только один раз за бар
if new_10min_bar
    alert("OPEN DEAL NOW", alert.freq_once_per_bar_close)
