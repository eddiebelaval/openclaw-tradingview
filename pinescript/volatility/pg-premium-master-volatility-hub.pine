//@version=6
//@ipuneet
indicator("Master Volatility Hub: Blue/Black Conviction", shorttitle="VolHub", overlay = false, precision = 3)

// --- INPUTS ---
group_v = "Volatility Crossover"
atrFastLen = input.int(10, "Fast ATR Length", minval=1, group=group_v, tooltip="Short-term volatility window. Standard is 5 or 10.")
atrSlowLen = input.int(14, "Slow ATR (Base) Length", minval=1, group=group_v, tooltip="The baseline volatility. Usually 14.")

group_t = "Thresholds & Scaling"
sqzLevel   = input.float(0.7, "Squeeze Threshold", minval=0.1, maxval=1.0, step=0.05, group=group_t, tooltip="Bars below this ratio of ATR turn Orange (Squeeze).")
normLen    = input.int(30, "Normalization Lookback", minval=1, group=group_t, tooltip="Used to scale the White Line (Relative Volatility Trend).")

group_vol = "Volume Filter"
volLen     = input.int(20, "Volume MA Length", group=group_vol)
volMult    = input.float(1.2, "Volume Multiplier", step=0.1, group=group_vol, tooltip="Volume must be this many times the average to trigger Blue/Black bars.")

// --- CALCULATIONS ---
fastATR = ta.atr(atrFastLen)
slowATR = ta.atr(atrSlowLen)
// Normalized Trend (Raw ATR vs its own moving average)
normATR = slowATR / ta.sma(slowATR, normLen)

atrCrossoverRatio = fastATR / slowATR
barRangeRatio      = (high - low) / slowATR

// Volume & Directional Logic
avgVol    = ta.sma(volume, volLen)
isVolHigh = volume > (avgVol * volMult)
isBullish = close > open
isBearish = close < open

// --- COLOR LOGIC ---
c_blue   = #2196f3 // Royal Blue
c_black  = #000000 // Pure Black
c_orange = #ff9800 // Vivid Orange
c_hollow = #9e9e9e // Dark Gray
c_noise  = #e0e0e0 // Light Gray

barColor = if barRangeRatio < sqzLevel
    color.new(c_orange, 20)
else if barRangeRatio > 1.0 and isVolHigh and isBullish
    color.new(c_blue, 0)
else if barRangeRatio > 1.0 and isVolHigh and isBearish
    color.new(c_black, 0)
else if barRangeRatio > 1.0 and not isVolHigh
    color.new(c_hollow, 40)
else
    color.new(c_noise, 50)

// --- PLOTTING ---

// 1. The Conviction Histogram
plot(barRangeRatio, "Conviction Histogram", color = barColor, style = plot.style_columns)

// 2. The Speedometer (Crossover Line) - UPDATED TO GREEN
plot(atrCrossoverRatio, "Volatility Crossover", color = #009688, linewidth = 2)

// 3. The Context Line (Normalized ATR Trend) - UPDATED TO RED
plot(normATR, "Relative Volatility Trend", color = #b71c1c, linewidth = 1)

// --- LEVELS ---
// Using plot instead of hline to allow variable inputs
plot(1.0, "ATR Mean", color = color.gray, style = plot.style_linebr, linewidth = 1)
plot(sqzLevel, "Squeeze Level", color = c_orange, style = plot.style_linebr, linewidth = 1)

// --- ALERTS ---
alertcondition(barRangeRatio < sqzLevel, title="Squeeze Detected", message="Volatility Squeeze on {{ticker}}")
alertcondition(barRangeRatio > 1.0 and isVolHigh and (isBullish or isBearish), title="High Conviction Breakout", message="High Conviction Volatility Move on {{ticker}}")
