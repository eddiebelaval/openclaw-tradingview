//@version=6
indicator("MultiTF Strategy Suite V2 [Enhanced]", shorttitle="MTF V2", overlay=true, max_labels_count=500, max_lines_count=500)

// ============================================================================
// INPUT CONFIGURATION
// ============================================================================
group_core = "🔧 Core Settings"
group_mtf = "🔄 Multi-Timeframe"
group_fast = "⚡ Fast Mode (1-5min)"
group_mid = "📊 Balanced Mode (15min-1H)"
group_swing = "🐢 Swing Mode (4H+)"
group_regime = "🎯 Market Regime"
group_session = "🌍 Session Filter"
group_exits = "🚪 Advanced Exits"
group_risk = "🛡️ Risk Management"
group_visual = "🎨 Visual Settings"
group_backtest = "📊 Performance Panel"

// Core Settings
auto_mode = input.bool(true, "Auto-Detect Timeframe Mode", group=group_core)
manual_mode = input.string("Balanced", "Manual Mode", options=["Fast", "Balanced", "Swing"], group=group_core)

// Multi-Timeframe
use_mtf = input.bool(true, "Use Higher TF Confirmation", group=group_mtf)
htf_tf = input.timeframe("240", "Higher TF", group=group_mtf)
htf_min_strength = input.int(60, "Min HTF Trend Strength", minval=0, maxval=100, group=group_mtf)

// Market Regime Detection
use_regime = input.bool(true, "Detect Market Regime", group=group_regime)
adx_len = input.int(14, "ADX Length", minval=5, maxval=50, group=group_regime)
adx_threshold = input.int(25, "ADX Trend Threshold", minval=10, maxval=50, group=group_regime)

// Session Filter
use_session = input.bool(false, "Enable Session Filter", group=group_session)
london_session = input.bool(true, "London (08-17 UTC)", group=group_session)
ny_session = input.bool(true, "New York (13-22 UTC)", group=group_session)

// Advanced Exits
use_trailing = input.bool(true, "Enable Trailing Stop", group=group_exits)
trail_activate = input.float(1.0, "Trail Activation (R)", minval=0.5, maxval=5.0, step=0.1, group=group_exits)
trail_dist = input.float(1.5, "Trail Distance (ATR)", minval=0.5, maxval=5.0, step=0.1, group=group_exits)

// ============================================================================
// TIMEFRAME DETECTION
// ============================================================================
get_tf_mins() =>
    tf = timeframe.period
    tf == "1" ? 1 :
         tf == "3" ? 3 :
         tf == "5" ? 5 :
         tf == "15" ? 15 :
         tf == "30" ? 30 :
         tf == "45" ? 45 :
         tf == "60" ? 60 :
         tf == "120" ? 120 :
         tf == "180" ? 180 :
         tf == "240" ? 240 :
         tf == "1D" ? 1440 :
         tf == "1W" ? 10080 :
         tf == "1M" ? 43200 :
         timeframe.multiplier

tf_mins = get_tf_mins()
is_fast = tf_mins <= 5
is_balanced = tf_mins > 5 and tf_mins <= 60
is_swing = tf_mins > 60

current_mode = auto_mode ? (is_fast ? "⚡ Fast" : is_balanced ? "📊 Balanced" : "🐢 Swing") : (manual_mode == "Fast" ? "⚡ Fast" : manual_mode == "Balanced" ? "📊 Balanced" : "🐢 Swing")
mode_fast = current_mode == "⚡ Fast"
mode_balanced = current_mode == "📊 Balanced"
mode_swing = current_mode == "🐢 Swing"

// ============================================================================
// MARKET REGIME DETECTION
// ============================================================================
[di_plus, di_minus, adx] = ta.dmi(adx_len, adx_len)
[bb_mid, bb_upper, bb_lower] = ta.bb(close, 20, 2)
bb_width = bb_mid != 0 ? (bb_upper - bb_lower) / bb_mid : na
bb_squeeze = bb_width < ta.sma(bb_width, 20) * 0.8
is_trending = adx > adx_threshold
regime = is_trending ? "📈 TRENDING" : "↔️ RANGING"

// ============================================================================
// HIGHER TIMEFRAME ANALYSIS
// ============================================================================
htf_close = request.security(syminfo.tickerid, htf_tf, close)
htf_ema20 = request.security(syminfo.tickerid, htf_tf, ta.ema(close, 20))
htf_ema50 = request.security(syminfo.tickerid, htf_tf, ta.ema(close, 50))
htf_rsi = request.security(syminfo.tickerid, htf_tf, ta.rsi(close, 14))

htf_bull = htf_ema20 > htf_ema50 and htf_rsi > 50
htf_bear = htf_ema20 < htf_ema50 and htf_rsi < 50
htf_strength = math.abs(htf_rsi - 50) * 2

htf_long_ok = htf_bull and htf_strength >= htf_min_strength
htf_short_ok = htf_bear and htf_strength >= htf_min_strength

// ============================================================================
// SESSION FILTER
// ============================================================================
hour_utc = hour(time, "UTC")
time_val = hour_utc * 100 + minute(time, "UTC")
in_london = time_val >= 800 and time_val < 1700
in_ny = time_val >= 1300 and time_val < 2200
session_ok = use_session ? ((london_session and in_london) or (ny_session and in_ny)) : true

// ============================================================================
// FAST MODE (Momentum Breakout)
// ============================================================================
fast_rsi = ta.rsi(close, 7)
fast_ema9 = ta.ema(close, 9)
fast_ema21 = ta.ema(close, 21)
fast_vol_avg = ta.sma(volume, 20)
fast_vol_spike = volume > fast_vol_avg * 1.8

[fast_bb_mid, fast_bb_upper, fast_bb_lower] = ta.bb(close, 10, 1.5)
fast_breakout_long = close > fast_bb_upper and close[1] <= fast_bb_upper[1]
fast_breakout_short = close < fast_bb_lower and close[1] >= fast_bb_lower[1]

fast_long = fast_breakout_long and fast_ema9 > fast_ema21 and fast_vol_spike and (not use_regime or is_trending)
fast_short = fast_breakout_short and fast_ema9 < fast_ema21 and fast_vol_spike and (not use_regime or is_trending)

// ============================================================================
// BALANCED MODE (Trend Pullback)
// ============================================================================
bal_rsi = ta.rsi(close, 14)
bal_ema12 = ta.ema(close, 12)
bal_ema26 = ta.ema(close, 26)
bal_macd = ta.ema(close, 12) - ta.ema(close, 26)
bal_macd_sig = ta.ema(bal_macd, 9)
bal_macd_hist = bal_macd - bal_macd_sig

bal_trend_up = bal_ema12 > bal_ema26
bal_trend_down = bal_ema12 < bal_ema26
bal_pullback_long = bal_trend_up and close < bal_ema12 and close > bal_ema26
bal_pullback_short = bal_trend_down and close > bal_ema12 and close < bal_ema26

bal_long = bal_pullback_long and bal_macd > bal_macd_sig and bal_rsi > 35 and bal_rsi < 50 and (not use_regime or is_trending)
bal_short = bal_pullback_short and bal_macd < bal_macd_sig and bal_rsi < 65 and bal_rsi > 50 and (not use_regime or is_trending)

// ============================================================================
// SWING MODE (Mean Reversion)
// ============================================================================
swing_rsi = ta.rsi(close, 21)
swing_ema20 = ta.ema(close, 20)
swing_ema50 = ta.ema(close, 50)
[swing_bb_mid, swing_bb_upper, swing_bb_lower] = ta.bb(close, 20, 2)

swing_long = close <= swing_bb_lower and swing_rsi < 40 and htf_long_ok
swing_short = close >= swing_bb_upper and swing_rsi > 60 and htf_short_ok

// ============================================================================
// SIGNAL CONSOLIDATION
// ============================================================================
base_long = mode_fast ? fast_long : mode_balanced ? bal_long : swing_long
base_short = mode_fast ? fast_short : mode_balanced ? bal_short : swing_short

final_long = base_long and (not use_mtf or htf_long_ok or mode_fast) and session_ok
final_short = base_short and (not use_mtf or htf_short_ok or mode_fast) and session_ok

long_signal = final_long and not final_long[1]
short_signal = final_short and not final_short[1]

// ============================================================================
// RISK MANAGEMENT
// ============================================================================
atr = ta.atr(14)
sl_mult = mode_fast ? 1.4 : mode_balanced ? 2.0 : 3.0
tp_mult = mode_fast ? 2.0 : mode_balanced ? 2.5 : 3.0

sl_long = close - (atr * sl_mult)
tp_long = close + (atr * tp_mult)
sl_short = close + (atr * sl_mult)
tp_short = close - (atr * tp_mult)

// ============================================================================
// TRAILING STOP LOGIC
// ============================================================================
var float entry_p = na
var string pos = "none"
var float highest = na
var float lowest = na
var float init_sl = na

if long_signal and pos == "none"
    entry_p := close
    pos := "long"
    init_sl := sl_long
    highest := close
    lowest := na

if short_signal and pos == "none"
    entry_p := close
    pos := "short"
    init_sl := sl_short
    lowest := close
    highest := na

if pos == "long"
    highest := math.max(highest, high)
if pos == "short"
    lowest := math.min(lowest, low)

long_risk = math.max(math.abs(entry_p - init_sl), syminfo.mintick)
short_risk = math.max(math.abs(init_sl - entry_p), syminfo.mintick)
r_mult_long = not na(entry_p) ? (highest - entry_p) / long_risk : 0
r_mult_short = not na(entry_p) ? (entry_p - lowest) / short_risk : 0

trail_sl_long = use_trailing and r_mult_long >= trail_activate ? highest - (atr * trail_dist) : init_sl
trail_sl_short = use_trailing and r_mult_short >= trail_activate ? lowest + (atr * trail_dist) : init_sl

curr_sl_long = use_trailing ? math.max(trail_sl_long, init_sl) : init_sl
curr_sl_short = use_trailing ? math.min(trail_sl_short, init_sl) : init_sl

exit_long = pos == "long" and (low <= curr_sl_long or high >= tp_long or short_signal)
exit_short = pos == "short" and (high >= curr_sl_short or low <= tp_short or long_signal)

if exit_long
    pos := "none"
    entry_p := na
    highest := na
    lowest := na
    init_sl := na
if exit_short
    pos := "none"
    entry_p := na
    highest := na
    lowest := na
    init_sl := na

// ============================================================================
// PERFORMANCE TRACKING
// ============================================================================
var int wins = 0
var int losses = 0
var float total_pnl = 0.0
var float max_dd = 0.0
var float peak_eq = 100.0
var float curr_eq = 100.0
var float gross_profit = 0.0
var float gross_loss = 0.0

if exit_long and not na(entry_p[1])
    exit_p = low <= curr_sl_long ? curr_sl_long : high >= tp_long ? tp_long : close
    pnl = (exit_p - entry_p[1]) / entry_p[1] * 100
    total_pnl += pnl
    curr_eq += pnl
    wins += pnl > 0 ? 1 : 0
    losses += pnl <= 0 ? 1 : 0
    gross_profit += pnl > 0 ? pnl : 0
    gross_loss += pnl <= 0 ? math.abs(pnl) : 0

if exit_short and not na(entry_p[1])
    exit_p = high >= curr_sl_short ? curr_sl_short : low <= tp_short ? tp_short : close
    pnl = (entry_p[1] - exit_p) / entry_p[1] * 100
    total_pnl += pnl
    curr_eq += pnl
    wins += pnl > 0 ? 1 : 0
    losses += pnl <= 0 ? 1 : 0
    gross_profit += pnl > 0 ? pnl : 0
    gross_loss += pnl <= 0 ? math.abs(pnl) : 0

peak_eq := math.max(peak_eq, curr_eq)
max_dd := math.max(max_dd, (peak_eq - curr_eq) / peak_eq * 100)

total_trades = wins + losses
win_rate = total_trades > 0 ? (wins / total_trades) * 100 : 0.0
pf = gross_loss > 0 ? gross_profit / gross_loss : na

// ============================================================================
// VISUALS
// ============================================================================
bgcolor(use_regime and is_trending ? (close > open ? color.new(color.green, 92) : color.new(color.red, 92)) : na)

plotshape(series=long_signal, title="Long", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.normal, text="L")
plotshape(series=short_signal, title="Short", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.normal, text="S")
plotshape(series=exit_long, title="Exit L", style=shape.xcross, location=location.abovebar, color=color.orange, size=size.tiny)
plotshape(series=exit_short, title="Exit S", style=shape.xcross, location=location.belowbar, color=color.orange, size=size.tiny)

plot(mode_fast ? fast_ema9 : mode_balanced ? bal_ema12 : swing_ema20, "Fast EMA", color.blue, 2)
plot(mode_fast ? fast_ema21 : mode_balanced ? bal_ema26 : swing_ema50, "Slow EMA", color.orange, 2)
plot(use_mtf ? htf_ema20 : na, "HTF EMA20", color.purple, 1)

// Info Panel
var table tbl = table.new(position.top_right, 2, 10, bgcolor=color.black, border_color=color.gray)
if barstate.islast
    table.clear(tbl, 0, 0, 1, 9)
    table.cell(tbl, 0, 0, "MTF Suite V2", text_color=color.white, text_size=size.normal)
    table.cell(tbl, 0, 1, "Mode:", text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 1, current_mode, text_color=color.yellow, text_size=size.small)
    table.cell(tbl, 0, 2, "Regime:", text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 2, regime, text_color=is_trending ? color.lime : color.orange, text_size=size.small)
    table.cell(tbl, 0, 3, "HTF Strength:", text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(htf_strength, "#.0"), text_color=color.aqua, text_size=size.small)
    table.cell(tbl, 0, 4, "Trades:", text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 4, str.tostring(total_trades), text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 5, "Win Rate:", text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 5, str.tostring(win_rate, "#.0") + "%", text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 6, "PnL:", text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 6, str.tostring(total_pnl, "#.00") + "%", text_color=total_pnl >= 0 ? color.lime : color.red, text_size=size.small)
    table.cell(tbl, 0, 7, "PF:", text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 7, na(pf) ? "n/a" : str.tostring(pf, "#.00"), text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 8, "Max DD:", text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 8, str.tostring(max_dd, "#.00") + "%", text_color=color.orange, text_size=size.small)
    table.cell(tbl, 0, 9, "Session:", text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 9, session_ok ? "OPEN" : "CLOSED", text_color=session_ok ? color.lime : color.red, text_size=size.small)
