// ═══════════════════════════════════════════════════════════════════════════════
// VIX TERM STRUCTURE — Contango / Backwardation Regime Detector
// ═══════════════════════════════════════════════════════════════════════════════
// 
// WHAT IT DOES:
// Plots the VIX/VIX3M ratio to identify whether the volatility term structure
// is in contango (normal, calm) or backwardation (stressed, fearful).
//
// HOW TO READ IT:
// • Ratio < 1.0 (green zone)  = CONTANGO — structural tailwind for premium selling
//   Iron condors, short strangles, and short puts have a statistical edge here
//   because IV tends to overstate realized vol in contango environments.
//
// • Ratio > 1.0 (red zone)    = BACKWARDATION — stress/fear regime
//   Reduce or avoid short premium. Consider long puts, debit spreads, or
//   cash-secured puts at extreme levels (buying the fear).
//
// • Ratio > 1.10 (dark red)   = DEEP BACKWARDATION — panic / dislocation
//   Historically marks the best opportunities to sell elevated premium,
//   but ONLY after the ratio begins to roll over (mean-revert). Wait for
//   the "hook" — don't sell into a rising backwardation spike.
//
// SIGNALS:
// ▲ Green triangle  = Flip from backwardation → contango (re-enter premium selling)
// ▼ Red triangle    = Flip from contango → backwardation (reduce exposure)
//
// SUGGESTED USE:
// Apply to any chart. This indicator uses external VIX data so it works
// regardless of what ticker you're viewing. Pairs with VIX Z-Score and
// Put/Call Ratio indicators for a full regime detection system.
// ═══════════════════════════════════════════════════════════════════════════════

//@version=6
indicator('VIX Term Structure — Contango/Backwardation', shorttitle = 'VIX Term Struct', overlay = false, precision = 3)

// ── Inputs ──────────────────────────────────────────────────────────────────
grp_data = 'Data Sources'
vixSym = input.symbol('CBOE:VIX', 'VIX Symbol', group = grp_data)
vix3mSym = input.symbol('CBOE:VIX3M', 'VIX3M Symbol', group = grp_data)

grp_params = 'Parameters'
smoothLen = input.int(5, 'Smoothing Length (SMA)', minval = 1, maxval = 50, group = grp_params, tooltip = 'Smooths the ratio to reduce noise. 5 = responsive, 10 = smoother.')
bbLen = input.int(20, 'Bollinger Band Length', minval = 10, maxval = 100, group = grp_params)
bbMult = input.float(2.0, 'Bollinger Band StdDev', minval = 0.5, maxval = 4.0, step = 0.1, group = grp_params)

grp_thresh = 'Regime Thresholds'
deepBackwd = input.float(1.10, 'Deep Backwardation Threshold', minval = 1.01, maxval = 1.50, step = 0.01, group = grp_thresh)
mildBackwd = input.float(1.00, 'Backwardation Line', group = grp_thresh)
deepContgo = input.float(0.85, 'Deep Contango Threshold', minval = 0.50, maxval = 0.99, step = 0.01, group = grp_thresh)

grp_style = 'Style'
showBB = input.bool(true, 'Show Bollinger Bands', group = grp_style)
showFills = input.bool(true, 'Show Regime Shading', group = grp_style)
showSignals = input.bool(true, 'Show Flip Signals', group = grp_style)

// ── Data ────────────────────────────────────────────────────────────────────
vixVal = request.security(vixSym, timeframe.period, close)
vix3mVal = request.security(vix3mSym, timeframe.period, close)

// ── Ratio Calculation ───────────────────────────────────────────────────────
rawRatio = vixVal / vix3mVal
smoothRatio = ta.sma(rawRatio, smoothLen)

// ── Bollinger Bands on the Ratio ────────────────────────────────────────────
bbBasis = ta.sma(smoothRatio, bbLen)
bbDev = ta.stdev(smoothRatio, bbLen) * bbMult
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

// ── Regime Detection ────────────────────────────────────────────────────────
isDeepBackwardation = smoothRatio >= deepBackwd
isBackwardation = smoothRatio >= mildBackwd and smoothRatio < deepBackwd
isContango = smoothRatio < mildBackwd and smoothRatio >= deepContgo
isDeepContango = smoothRatio < deepContgo

// ── Flip Signals ────────────────────────────────────────────────────────────
flipToContango = ta.crossunder(smoothRatio, mildBackwd)
flipToBackwardation = ta.crossover(smoothRatio, mildBackwd)

// ── Colors ──────────────────────────────────────────────────────────────────
ratioColor = isDeepBackwardation ? color.new(#B71C1C, 0) : isBackwardation ? color.new(#EF5350, 0) : isDeepContango ? color.new(#1B5E20, 0) : color.new(#66BB6A, 0)

// ── Plots ───────────────────────────────────────────────────────────────────
// Main ratio line
plot(smoothRatio, 'VIX/VIX3M Ratio', color = ratioColor, linewidth = 3)

// Raw ratio (faint)
plot(rawRatio, 'Raw Ratio', color = color.new(color.gray, 70), linewidth = 1)

// Reference lines
hDeepBack = hline(deepBackwd, 'Deep Backwardation', color = color.new(#B71C1C, 50), linestyle = hline.style_dotted)
hBackwd = hline(mildBackwd, 'Contango/Backwardation', color = color.new(color.white, 20), linestyle = hline.style_solid)
hDeepCont = hline(deepContgo, 'Deep Contango', color = color.new(#1B5E20, 50), linestyle = hline.style_dotted)

// Regime shading
fill(hDeepBack, hBackwd, color = showFills ? color.new(#EF5350, 88) : na, title = 'Backwardation Zone')
fill(hBackwd, hDeepCont, color = showFills ? color.new(#66BB6A, 88) : na, title = 'Contango Zone')

// Bollinger Bands
plot(showBB ? bbUpper : na, 'BB Upper', color = color.new(color.orange, 60), linewidth = 1)
plot(showBB ? bbBasis : na, 'BB Mid', color = color.new(color.orange, 40), linewidth = 1, style = plot.style_circles)
plot(showBB ? bbLower : na, 'BB Lower', color = color.new(color.orange, 60), linewidth = 1)

// Flip signals
plotshape(showSignals and flipToContango ? smoothRatio : na, '→ Contango', style = shape.triangleup, location = location.absolute, color = color.new(#66BB6A, 0), size = size.small, text = 'Contango')
plotshape(showSignals and flipToBackwardation ? smoothRatio : na, '→ Backwardation', style = shape.triangledown, location = location.absolute, color = color.new(#EF5350, 0), size = size.small, text = 'Backwd')

// ── Info Table ──────────────────────────────────────────────────────────────
var table infoPanel = table.new(position.top_right, 2, 4, bgcolor = color.new(#1B2A4A, 10), border_width = 1, border_color = color.new(color.gray, 60))

regimeText = isDeepBackwardation ? 'DEEP BACKWARDATION' : isBackwardation ? 'BACKWARDATION' : isDeepContango ? 'DEEP CONTANGO' : 'CONTANGO'
regimeColor = isDeepBackwardation ? color.new(#FF0000, 0) : isBackwardation ? color.new(#EF5350, 0) : isDeepContango ? color.new(#1B5E20, 0) : color.new(#66BB6A, 0)
actionText = isDeepBackwardation ? 'Reduce short premium' : isBackwardation ? 'Caution - directional bias' : isDeepContango ? 'Prime premium selling' : 'Sell premium OK'

if barstate.islast
    table.cell(infoPanel, 0, 0, 'VIX', text_color = color.gray, text_size = size.small)
    table.cell(infoPanel, 1, 0, str.tostring(vixVal, '#.##'), text_color = color.white, text_size = size.small)
    table.cell(infoPanel, 0, 1, 'VIX3M', text_color = color.gray, text_size = size.small)
    table.cell(infoPanel, 1, 1, str.tostring(vix3mVal, '#.##'), text_color = color.white, text_size = size.small)
    table.cell(infoPanel, 0, 2, 'Ratio', text_color = color.gray, text_size = size.small)
    table.cell(infoPanel, 1, 2, str.tostring(smoothRatio, '#.###'), text_color = ratioColor, text_size = size.normal)
    table.cell(infoPanel, 0, 3, 'Regime', text_color = color.gray, text_size = size.small)
    table.cell(infoPanel, 1, 3, regimeText, text_color = regimeColor, text_size = size.small)

// ── Alerts ──────────────────────────────────────────────────────────────────
alertcondition(flipToBackwardation, title = 'Backwardation Flip', message = '⚠ VIX term structure flipped to BACKWARDATION — reduce short premium exposure')
alertcondition(flipToContango, title = 'Contango Flip', message = '✓ VIX term structure returned to CONTANGO — premium selling environment restored')
alertcondition(isDeepBackwardation, title = 'Deep Backwardation', message = '🔴 DEEP BACKWARDATION — VIX/VIX3M ratio above {{deepBackwd}}. High stress regime.')
alertcondition(isDeepContango, title = 'Deep Contango', message = '🟢 DEEP CONTANGO — VIX/VIX3M ratio below {{deepContgo}}. Ideal premium selling.')
