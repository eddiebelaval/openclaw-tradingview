//@version=5
indicator("OA V2 - Institutional Scanner V2", overlay=true, max_labels_count=500)

// =====================================================
// INPUTS
// =====================================================
groupGeneral = "General"
swingLen       = input.int(5, "Swing Length", minval=2, group=groupGeneral)
atrLen         = input.int(14, "ATR Length", minval=5, group=groupGeneral)
volLen         = input.int(20, "Volume SMA Length", minval=5, group=groupGeneral)
compLen        = input.int(10, "Compression Lookback", minval=5, group=groupGeneral)
momLen         = input.int(20, "Momentum Length", minval=5, group=groupGeneral)

groupThreshold = "Thresholds"
dispATRmult    = input.float(1.2, "Displacement > ATR x", step=0.1, group=groupThreshold)
volSpikeMult   = input.float(1.5, "Volume Spike > Vol SMA x", step=0.1, group=groupThreshold)
compFactor     = input.float(0.85, "Compression Factor", step=0.05, group=groupThreshold)
bodyMinPct     = input.float(60.0, "Min Candle Body %", step=1.0, group=groupThreshold)
scoreTrigger   = input.int(7, "Minimum Score For Setup", minval=1, maxval=10, group=groupThreshold)

groupDisplay = "Display"
showTable     = input.bool(true, "Show Score Table", group=groupDisplay)
showLabels    = input.bool(true, "Show Labels", group=groupDisplay)
showBg        = input.bool(true, "Highlight Signal Bars", group=groupDisplay)
showBOSLines  = input.bool(true, "Show Last Swing Lines", group=groupDisplay)

// =====================================================
// CORE CALCULATIONS
// =====================================================
atr = ta.atr(atrLen)
volMA = ta.sma(volume, volLen)

candleRange = high - low
candleBody = math.abs(close - open)
bodyPct = candleRange > 0 ? candleBody / candleRange * 100.0 : 0.0

bullCandle = close > open
bearCandle = close < open

bullDisplacement = bullCandle and candleRange > atr * dispATRmult and bodyPct >= bodyMinPct
bearDisplacement = bearCandle and candleRange > atr * dispATRmult and bodyPct >= bodyMinPct

volSpike = volume > volMA * volSpikeMult

// =====================================================
// STRUCTURE
// =====================================================
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh = na
var float lastSwingLow  = na

if not na(ph)
    lastSwingHigh := ph

if not na(pl)
    lastSwingLow := pl

bullBOS = not na(lastSwingHigh) and close > lastSwingHigh
bearBOS = not na(lastSwingLow) and close < lastSwingLow

// =====================================================
// COMPRESSION
// =====================================================
avgBarRange = ta.sma(high - low, compLen)
avgATR = ta.sma(atr, compLen)
compression = avgBarRange < avgATR * compFactor

// =====================================================
// MOMENTUM / CONTEXT
// =====================================================
emaFast = ta.ema(close, 10)
emaSlow = ta.ema(close, momLen)

bullMomentum = close > emaFast and emaFast > emaSlow
bearMomentum = close < emaFast and emaFast < emaSlow

// =====================================================
// RELATIVE RANGE EXPANSION
// =====================================================
rangeExpansion = candleRange > ta.sma(high - low, 20) * 1.2

// =====================================================
// SCORE MODEL
// =====================================================
// Structure = 3
bullStructureScore = bullBOS ? 3 : 0
bearStructureScore = bearBOS ? 3 : 0

// Displacement = 2
bullDispScore = bullDisplacement ? 2 : 0
bearDispScore = bearDisplacement ? 2 : 0

// Volume = 2
volScore = volSpike ? 2 : 0

// Compression = 1
compScore = compression[1] ? 1 : 0

// Momentum = 1
bullMomScore = bullMomentum ? 1 : 0
bearMomScore = bearMomentum ? 1 : 0

// Range expansion = 1
rangeScore = rangeExpansion ? 1 : 0

bullScore = bullStructureScore + bullDispScore + volScore + compScore + bullMomScore + rangeScore
bearScore = bearStructureScore + bearDispScore + volScore + compScore + bearMomScore + rangeScore

// =====================================================
// SIGNALS
// =====================================================
longSetup = bullScore >= scoreTrigger and bullBOS and bullDisplacement
shortSetup = bearScore >= scoreTrigger and bearBOS and bearDisplacement

// =====================================================
// CLASSIFICATION
// =====================================================
bullContinuation = longSetup and bullMomentum
bullReversal = longSetup and not bullMomentum

bearContinuation = shortSetup and bearMomentum
bearReversal = shortSetup and not bearMomentum

setupText =
     bullContinuation ? "LONG CONTINUATION" :
     bullReversal     ? "LONG REVERSAL" :
     bearContinuation ? "SHORT CONTINUATION" :
     bearReversal     ? "SHORT REVERSAL" :
     "NO SETUP"

// =====================================================
// PLOTS
// =====================================================
plotshape(longSetup, title="LONG Setup", style=shape.triangleup, location=location.belowbar, size=size.large, color=color.lime, text="LONG")
plotshape(shortSetup, title="SHORT Setup", style=shape.triangledown, location=location.abovebar, size=size.large, color=color.red, text="SHORT")

bgcolor(showBg and longSetup ? color.new(color.lime, 85) : na)
bgcolor(showBg and shortSetup ? color.new(color.red, 85) : na)

plot(showBOSLines ? lastSwingHigh : na, title="Last Swing High", color=color.new(color.green, 60), linewidth=1, style=plot.style_linebr)
plot(showBOSLines ? lastSwingLow : na, title="Last Swing Low", color=color.new(color.red, 60), linewidth=1, style=plot.style_linebr)

// =====================================================
// LABELS
// =====================================================
if showLabels and longSetup
    label.new(
         bar_index, low,
         "OA V2 LONG\n" +
         "Type: " + (bullContinuation ? "Continuation" : "Reversal") + "\n" +
         "Score: " + str.tostring(bullScore) + "/10",
         style=label.style_label_up,
         color=color.new(color.lime, 0),
         textcolor=color.black
     )

if showLabels and shortSetup
    label.new(
         bar_index, high,
         "OA V2 SHORT\n" +
         "Type: " + (bearContinuation ? "Continuation" : "Reversal") + "\n" +
         "Score: " + str.tostring(bearScore) + "/10",
         style=label.style_label_down,
         color=color.new(color.red, 0),
         textcolor=color.white
     )

// =====================================================
// TABLE
// =====================================================
var table t = table.new(position.top_right, 2, 9, border_width=1)

if barstate.islast and showTable
    table.cell(t, 0, 0, "OA V2 Scanner", text_color=color.white, bgcolor=color.black)
    table.cell(t, 1, 0, syminfo.ticker, text_color=color.yellow, bgcolor=color.black)

    table.cell(t, 0, 1, "Setup", text_color=color.white)
    table.cell(t, 1, 1, setupText, text_color=longSetup ? color.lime : shortSetup ? color.red : color.silver)

    table.cell(t, 0, 2, "Bull Score", text_color=color.white)
    table.cell(t, 1, 2, str.tostring(bullScore) + "/10", text_color=color.lime)

    table.cell(t, 0, 3, "Bear Score", text_color=color.white)
    table.cell(t, 1, 3, str.tostring(bearScore) + "/10", text_color=color.red)

    table.cell(t, 0, 4, "Compression", text_color=color.white)
    table.cell(t, 1, 4, compression[1] ? "Yes" : "No", text_color=compression[1] ? color.yellow : color.silver)

    table.cell(t, 0, 5, "Volume Spike", text_color=color.white)
    table.cell(t, 1, 5, volSpike ? "Yes" : "No", text_color=volSpike ? color.orange : color.silver)

    table.cell(t, 0, 6, "Bull BOS", text_color=color.white)
    table.cell(t, 1, 6, bullBOS ? "Yes" : "No", text_color=bullBOS ? color.lime : color.silver)

    table.cell(t, 0, 7, "Bear BOS", text_color=color.white)
    table.cell(t, 1, 7, bearBOS ? "Yes" : "No", text_color=bearBOS ? color.red : color.silver)

    table.cell(t, 0, 8, "Range Exp.", text_color=color.white)
    table.cell(t, 1, 8, rangeExpansion ? "Yes" : "No", text_color=rangeExpansion ? color.aqua : color.silver)

// =====================================================
// ALERTS
// =====================================================
alertcondition(longSetup, title="OA V2 LONG Setup", message="OA V2 LONG Setup on {{ticker}} | Score={{plot_0}}")
alertcondition(shortSetup, title="OA V2 SHORT Setup", message="OA V2 SHORT Setup on {{ticker}} | Score={{plot_1}}")

// Hidden plots for alert placeholders
plot(bullScore, title="Bull Score Plot", display=display.none)
plot(bearScore, title="Bear Score Plot", display=display.none)
