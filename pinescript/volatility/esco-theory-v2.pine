// https://mozilla.org/MPL/2.0/

//@version=5
indicator("Esco Theory — Geometry Model V2", overlay=true, max_lines_count=400, max_labels_count=200, max_boxes_count=100)


// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════

grp_swing = "━━━ Structure ━━━"
swingLen       = input.int(21, "Swing Lookback", minval=5, maxval=100, group=grp_swing, tooltip="Bars to look back for standard pivot detection.")
majorSwingLen  = input.int(55, "Major Swing Lookback", minval=10, maxval=200, group=grp_swing, tooltip="Bars for major structural pivots — the backbone of geometry.")
maxMinorSwings = input.int(10, "Max Minor Swings", minval=4, maxval=20, group=grp_swing)
maxMajorSwings = input.int(6, "Max Major Swings", minval=2, maxval=10, group=grp_swing)

grp_geo = "━━━ Geometric Rails ━━━"
showRails          = input.bool(true, "Show Rails", group=grp_geo)
showMajorRails     = input.bool(true, "Show Major Cycle Rails", group=grp_geo)
showFan            = input.bool(true, "Show Cycle Fan", group=grp_geo)
railExtend         = input.int(150, "Extension (bars)", minval=20, maxval=500, group=grp_geo)
railColor          = input.color(color.new(#00BCD4, 30), "Rail Color", group=grp_geo)
majorRailColor     = input.color(color.new(#7C4DFF, 15), "Major Rail Color", group=grp_geo)
railWidth          = input.int(1, "Rail Width", minval=1, maxval=3, group=grp_geo)
majorRailWidth     = input.int(2, "Major Rail Width", minval=1, maxval=4, group=grp_geo)
maxCrossRails      = input.int(2, "Max Cross-Rails Per Side", minval=0, maxval=4, group=grp_geo, tooltip="Cross-connections between highs and lows. 0 = off.")

grp_sr = "━━━ Support / Resistance ━━━"
showSR             = input.bool(true, "Show S/R Levels", group=grp_sr)
srMinTouches       = input.int(2, "Min Touches", minval=1, maxval=5, group=grp_sr, tooltip="Pivot cluster count to qualify as S/R.")
srTolerance        = input.float(0.4, "Cluster Tolerance (%)", minval=0.05, maxval=3.0, step=0.05, group=grp_sr)
srSupportCol       = input.color(color.new(#4CAF50, 25), "Support Color", group=grp_sr)
srResistCol        = input.color(color.new(#F44336, 25), "Resistance Color", group=grp_sr)
srLineWidth        = input.int(2, "Line Width", minval=1, maxval=4, group=grp_sr)

grp_sd = "━━━ Supply / Demand ━━━"
showSD             = input.bool(true, "Show S/D Zones", group=grp_sd)
sdLookback         = input.int(15, "S/D Pivot Length", minval=5, maxval=50, group=grp_sd)
sdMaxZones         = input.int(4, "Max Zones Per Side", minval=1, maxval=8, group=grp_sd)
sdMitigate         = input.bool(true, "Auto-Remove Mitigated", group=grp_sd)
sdSupplyFill       = input.color(color.new(#EF5350, 88), "Supply Fill", group=grp_sd)
sdSupplyEdge       = input.color(color.new(#EF5350, 50), "Supply Border", group=grp_sd)
sdDemandFill       = input.color(color.new(#26A69A, 88), "Demand Fill", group=grp_sd)
sdDemandEdge       = input.color(color.new(#26A69A, 50), "Demand Border", group=grp_sd)

grp_conf = "━━━ Confluence ━━━"
showConfluence     = input.bool(true, "Highlight Confluence Zones", group=grp_conf)
confThreshold      = input.float(2.0, "Cluster Width (%)", minval=0.5, maxval=10.0, step=0.5, group=grp_conf)
confMinLevels      = input.int(3, "Min Levels", minval=2, maxval=6, group=grp_conf)
confBullCol        = input.color(color.new(#4CAF50, 82), "Support Confluence", group=grp_conf)
confBearCol        = input.color(color.new(#F44336, 82), "Resistance Confluence", group=grp_conf)

grp_comp = "━━━ Compression ━━━"
showCompression    = input.bool(true, "Show Compression", group=grp_comp)
compLen            = input.int(13, "Compression Pivot Length", minval=5, maxval=50, group=grp_comp)
compColor          = input.color(color.new(#FFEB3B, 40), "Wedge Color", group=grp_comp)
showBG             = input.bool(true, "Background Shading", group=grp_comp)

grp_liq = "━━━ Liquidity ━━━"
showLiquidity      = input.bool(true, "Show EQH / EQL", group=grp_liq)
liqColor           = input.color(color.new(#E91E63, 45), "Liquidity Color", group=grp_liq)
eqThreshold        = input.float(0.3, "Equal Level Tolerance (%)", minval=0.05, maxval=2.0, step=0.05, group=grp_liq)


// ═══════════════════════════════════════════════════════════════
// PIVOT DETECTION
// ═══════════════════════════════════════════════════════════════

pivHi    = ta.pivothigh(high, swingLen, swingLen)
pivLo    = ta.pivotlow(low, swingLen, swingLen)
majPivHi = ta.pivothigh(high, majorSwingLen, majorSwingLen)
majPivLo = ta.pivotlow(low, majorSwingLen, majorSwingLen)

var float[] hiP = array.new_float(0),  var int[] hiB = array.new_int(0)
var float[] loP = array.new_float(0),  var int[] loB = array.new_int(0)
var float[] mhP = array.new_float(0),  var int[] mhB = array.new_int(0)
var float[] mlP = array.new_float(0),  var int[] mlB = array.new_int(0)

_push(arr_p, arr_b, price, idx, cap) =>
    array.unshift(arr_p, price)
    array.unshift(arr_b, idx)
    if array.size(arr_p) > cap
        array.pop(arr_p)
        array.pop(arr_b)

if not na(pivHi)
    _push(hiP, hiB, pivHi, bar_index - swingLen, maxMinorSwings)
if not na(pivLo)
    _push(loP, loB, pivLo, bar_index - swingLen, maxMinorSwings)
if not na(majPivHi)
    _push(mhP, mhB, majPivHi, bar_index - majorSwingLen, maxMajorSwings)
if not na(majPivLo)
    _push(mlP, mlB, majPivLo, bar_index - majorSwingLen, maxMajorSwings)


// ═══════════════════════════════════════════════════════════════
// SUPPLY & DEMAND — Detect on pivot, draw on last bar
// ═══════════════════════════════════════════════════════════════

sdPivHi = ta.pivothigh(high, sdLookback, sdLookback)
sdPivLo = ta.pivotlow(low, sdLookback, sdLookback)

var float[] sTopArr = array.new_float(0), var float[] sBotArr = array.new_float(0)
var int[]   sBarArr = array.new_int(0),   var bool[]  sActArr = array.new_bool(0)
var float[] dTopArr = array.new_float(0), var float[] dBotArr = array.new_float(0)
var int[]   dBarArr = array.new_int(0),   var bool[]  dActArr = array.new_bool(0)

if showSD
    // Supply: pivot high + bearish displacement
    if not na(sdPivHi)
        pb = bar_index - sdLookback
        pH = high[sdLookback]
        pO = open[sdLookback]
        pC = close[sdLookback]
        bodySize = math.abs(pO - pC)
        
        // Require displacement: next candle closes below origin body
        dispOK = false
        if sdLookback > 1
            nxtBody = math.abs(open[sdLookback - 1] - close[sdLookback - 1])
            dispOK := close[sdLookback - 1] < math.min(pO, pC) and nxtBody > bodySize * 0.5
        
        if dispOK
            zt = pH
            zb = math.min(pO, pC)
            if (zt - zb) / zt * 100 > 0.1
                array.unshift(sTopArr, zt)
                array.unshift(sBotArr, zb)
                array.unshift(sBarArr, pb)
                array.unshift(sActArr, true)
                if array.size(sTopArr) > sdMaxZones * 3
                    array.pop(sTopArr)
                    array.pop(sBotArr)
                    array.pop(sBarArr)
                    array.pop(sActArr)

    // Demand: pivot low + bullish displacement
    if not na(sdPivLo)
        pb = bar_index - sdLookback
        pL = low[sdLookback]
        pO = open[sdLookback]
        pC = close[sdLookback]
        bodySize = math.abs(pO - pC)
        
        dispOK = false
        if sdLookback > 1
            nxtBody = math.abs(open[sdLookback - 1] - close[sdLookback - 1])
            dispOK := close[sdLookback - 1] > math.max(pO, pC) and nxtBody > bodySize * 0.5
        
        if dispOK
            zt = math.max(pO, pC)
            zb = pL
            if zb > 0 and (zt - zb) / zb * 100 > 0.1
                array.unshift(dTopArr, zt)
                array.unshift(dBotArr, zb)
                array.unshift(dBarArr, pb)
                array.unshift(dActArr, true)
                if array.size(dTopArr) > sdMaxZones * 3
                    array.pop(dTopArr)
                    array.pop(dBotArr)
                    array.pop(dBarArr)
                    array.pop(dActArr)

    // Mitigation
    if sdMitigate
        if array.size(sActArr) > 0
            for i = 0 to array.size(sActArr) - 1
                if array.get(sActArr, i) and close > array.get(sTopArr, i)
                    array.set(sActArr, i, false)
        if array.size(dActArr) > 0
            for i = 0 to array.size(dActArr) - 1
                if array.get(dActArr, i) and close < array.get(dBotArr, i)
                    array.set(dActArr, i, false)


// ═══════════════════════════════════════════════════════════════
// COMPRESSION
// ═══════════════════════════════════════════════════════════════

atrFast = ta.atr(7)
atrSlow = ta.atr(50)
atrRatio = atrFast / atrSlow
isCompressing = atrRatio < 0.6

compPivHi = ta.pivothigh(high, compLen, compLen)
compPivLo = ta.pivotlow(low, compLen, compLen)

var float cH1 = na, var int cHB1 = na, var float cH2 = na, var int cHB2 = na
var float cL1 = na, var int cLB1 = na, var float cL2 = na, var int cLB2 = na

if not na(compPivHi)
    cH2 := cH1, cHB2 := cHB1
    cH1 := compPivHi, cHB1 := bar_index - compLen
if not na(compPivLo)
    cL2 := cL1, cLB2 := cLB1
    cL1 := compPivLo, cLB1 := bar_index - compLen

isWedge = false
if not na(cH1) and not na(cH2) and not na(cL1) and not na(cL2)
    if cHB1 != cHB2 and cLB1 != cLB2
        curRange  = cH1 - cL1
        prevRange = cH2 - cL2
        if prevRange > 0 and curRange > 0
            isWedge := curRange < prevRange * 0.85

bgcolor(showBG and isCompressing ? color.new(#FFEB3B, 95) : na, title="Compression BG")

// Squeeze
bbBasis  = ta.sma(close, 20)
bbDev    = 2.0 * ta.stdev(close, 20)
bbWidth  = (bbDev * 2) / bbBasis * 100
kcBasis  = ta.ema(close, 20)
kcRange  = ta.atr(10) * 1.5
inSqueeze = (bbBasis + bbDev) < (kcBasis + kcRange) and (bbBasis - bbDev) > (kcBasis - kcRange)

plotshape(inSqueeze and showCompression, title="Squeeze", style=shape.diamond, location=location.bottom, color=color.new(#FF5722, 20), size=size.tiny)
plotshape(inSqueeze[1] and not inSqueeze and showCompression, title="Fire", style=shape.triangleup, location=location.bottom, color=color.new(#4CAF50, 0), size=size.small)


// ═══════════════════════════════════════════════════════════════
// DRAWING — LAST BAR ONLY
// ═══════════════════════════════════════════════════════════════

_rail(b1, p1, b2, p2, col, w, sty) =>
    if b1 != b2
        slope = (p2 - p1) / (b2 - b1)
        extP  = p2 + slope * (bar_index + railExtend - b2)
        line.new(b1, p1, bar_index + railExtend, extP, color=col, width=w, style=sty)

if barstate.islast

    // ─── MINOR RAILS ───
    if showRails
        if array.size(hiP) >= 2
            for i = 0 to math.min(array.size(hiP) - 2, 4)
                _rail(array.get(hiB, i+1), array.get(hiP, i+1), array.get(hiB, i), array.get(hiP, i), railColor, railWidth, line.style_solid)
        if array.size(loP) >= 2
            for i = 0 to math.min(array.size(loP) - 2, 4)
                _rail(array.get(loB, i+1), array.get(loP, i+1), array.get(loB, i), array.get(loP, i), railColor, railWidth, line.style_solid)

        // Cross-rails (limited)
        if maxCrossRails > 0 and array.size(hiP) >= 1 and array.size(loP) >= 1
            drawn = 0
            for hi = 0 to math.min(array.size(hiP) - 1, maxCrossRails)
                for lo = 0 to math.min(array.size(loP) - 1, maxCrossRails)
                    if drawn < maxCrossRails * 2
                        bH = array.get(hiB, hi), pH_ = array.get(hiP, hi)
                        bL = array.get(loB, lo), pL_ = array.get(loP, lo)
                        if bH != bL and math.abs(bH - bL) > swingLen
                            sb = math.min(bH, bL), sp = bH < bL ? pH_ : pL_
                            eb = math.max(bH, bL), ep = bH > bL ? pH_ : pL_
                            _rail(sb, sp, eb, ep, color.new(railColor, 55), 1, line.style_dotted)
                            drawn += 1

    // ─── MAJOR RAILS ───
    if showMajorRails
        if array.size(mhP) >= 2
            for i = 0 to math.min(array.size(mhP) - 2, 3)
                _rail(array.get(mhB, i+1), array.get(mhP, i+1), array.get(mhB, i), array.get(mhP, i), majorRailColor, majorRailWidth, line.style_solid)
        if array.size(mlP) >= 2
            for i = 0 to math.min(array.size(mlP) - 2, 3)
                _rail(array.get(mlB, i+1), array.get(mlP, i+1), array.get(mlB, i), array.get(mlP, i), majorRailColor, majorRailWidth, line.style_solid)

    // ─── CYCLE FAN ───
    if showFan and array.size(mlP) >= 1 and array.size(mhP) >= 1
        // Fan from cycle low
        lowIdx = 0
        lowP_  = array.get(mlP, 0)
        if array.size(mlP) > 1
            for i = 1 to array.size(mlP) - 1
                if array.get(mlP, i) < lowP_
                    lowP_ := array.get(mlP, i)
                    lowIdx := i
        aB = array.get(mlB, lowIdx)
        aP = lowP_
        for i = 0 to math.min(array.size(mhP) - 1, 4)
            tB = array.get(mhB, i), tP = array.get(mhP, i)
            if tB > aB
                _rail(aB, aP, tB, tP, color.new(railColor, 10), 2, line.style_solid)

        // Fan from cycle high
        highIdx = 0
        highP_  = array.get(mhP, 0)
        if array.size(mhP) > 1
            for i = 1 to array.size(mhP) - 1
                if array.get(mhP, i) > highP_
                    highP_ := array.get(mhP, i)
                    highIdx := i
        aB2 = array.get(mhB, highIdx)
        aP2 = highP_
        for i = 0 to math.min(array.size(mlP) - 1, 4)
            tB = array.get(mlB, i), tP = array.get(mlP, i)
            if tB > aB2
                _rail(aB2, aP2, tB, tP, color.new(majorRailColor, 10), 2, line.style_solid)


    // ─── S/R LEVELS ───
    if showSR
        float[] cands = array.new_float(0)
        if array.size(mhP) > 0
            for i = 0 to array.size(mhP) - 1
                array.push(cands, array.get(mhP, i))
        if array.size(mlP) > 0
            for i = 0 to array.size(mlP) - 1
                array.push(cands, array.get(mlP, i))
        if array.size(hiP) > 0
            for i = 0 to math.min(array.size(hiP) - 1, 6)
                array.push(cands, array.get(hiP, i))
        if array.size(loP) > 0
            for i = 0 to math.min(array.size(loP) - 1, 6)
                array.push(cands, array.get(loP, i))

        if array.size(cands) > 1
            array.sort(cands, order.ascending)
            float[] srLvl = array.new_float(0)
            int[]   srCnt = array.new_int(0)
            
            ci = 0
            while ci < array.size(cands)
                base = array.get(cands, ci)
                upper = base * (1 + srTolerance / 100)
                cnt = 1
                total = base
                cj = ci + 1
                scanning = cj < array.size(cands)
                while scanning
                    if cj >= array.size(cands)
                        scanning := false
                    else if array.get(cands, cj) <= upper
                        cnt += 1
                        total += array.get(cands, cj)
                        cj += 1
                    else
                        scanning := false
                if cnt >= srMinTouches
                    array.push(srLvl, total / cnt)
                    array.push(srCnt, cnt)
                ci := cj
            
            if array.size(srLvl) > 0
                for i = 0 to array.size(srLvl) - 1
                    lvl = array.get(srLvl, i)
                    cnt = array.get(srCnt, i)
                    isSup = lvl < close
                    col = isSup ? srSupportCol : srResistCol
                    w   = cnt >= 4 ? srLineWidth + 1 : srLineWidth
                    line.new(bar_index - 200, lvl, bar_index + 50, lvl, color=col, width=w, style=line.style_dashed)
                    tag = (isSup ? "S" : "R") + " (" + str.tostring(cnt) + ")"
                    label.new(bar_index + 52, lvl, tag, style=label.style_none, textcolor=col, size=size.tiny)


    // ─── SUPPLY & DEMAND ZONES ───
    if showSD
        drawnS = 0
        if array.size(sTopArr) > 0
            for i = 0 to array.size(sTopArr) - 1
                if drawnS < sdMaxZones and array.get(sActArr, i)
                    box.new(array.get(sBarArr, i), array.get(sTopArr, i), bar_index + 30, array.get(sBotArr, i), bgcolor=sdSupplyFill, border_color=sdSupplyEdge, border_width=1)
                    label.new(array.get(sBarArr, i) + 3, array.get(sTopArr, i), "S", style=label.style_none, textcolor=sdSupplyEdge, size=size.tiny)
                    drawnS += 1
        drawnD = 0
        if array.size(dTopArr) > 0
            for i = 0 to array.size(dTopArr) - 1
                if drawnD < sdMaxZones and array.get(dActArr, i)
                    box.new(array.get(dBarArr, i), array.get(dTopArr, i), bar_index + 30, array.get(dBotArr, i), bgcolor=sdDemandFill, border_color=sdDemandEdge, border_width=1)
                    label.new(array.get(dBarArr, i) + 3, array.get(dBotArr, i), "D", style=label.style_none, textcolor=sdDemandEdge, size=size.tiny)
                    drawnD += 1


    // ─── LIQUIDITY ───
    if showLiquidity
        if array.size(hiP) >= 2
            for i = 0 to math.min(array.size(hiP) - 2, 6)
                for j = i + 1 to math.min(array.size(hiP) - 1, i + 4)
                    p1 = array.get(hiP, i), p2 = array.get(hiP, j)
                    b1 = array.get(hiB, i), b2 = array.get(hiB, j)
                    if math.abs(p1 - p2) / p1 * 100 < eqThreshold and b1 != b2
                        eq = math.avg(p1, p2)
                        line.new(math.min(b1, b2), eq, bar_index + 25, eq, color=liqColor, width=2, style=line.style_dashed)
                        label.new(bar_index + 27, eq, "EQH", style=label.style_none, textcolor=liqColor, size=size.tiny)
        if array.size(loP) >= 2
            for i = 0 to math.min(array.size(loP) - 2, 6)
                for j = i + 1 to math.min(array.size(loP) - 1, i + 4)
                    p1 = array.get(loP, i), p2 = array.get(loP, j)
                    b1 = array.get(loB, i), b2 = array.get(loB, j)
                    if math.abs(p1 - p2) / p1 * 100 < eqThreshold and b1 != b2
                        eq = math.avg(p1, p2)
                        line.new(math.min(b1, b2), eq, bar_index + 25, eq, color=liqColor, width=2, style=line.style_dashed)
                        label.new(bar_index + 27, eq, "EQL", style=label.style_none, textcolor=liqColor, size=size.tiny)


    // ─── CONFLUENCE ───
    if showConfluence
        float[] allLvl = array.new_float(0)
        if array.size(mhP) > 0
            for i = 0 to array.size(mhP) - 1
                array.push(allLvl, array.get(mhP, i))
        if array.size(mlP) > 0
            for i = 0 to array.size(mlP) - 1
                array.push(allLvl, array.get(mlP, i))
        if array.size(hiP) > 0
            for i = 0 to math.min(array.size(hiP) - 1, 8)
                array.push(allLvl, array.get(hiP, i))
        if array.size(loP) > 0
            for i = 0 to math.min(array.size(loP) - 1, 8)
                array.push(allLvl, array.get(loP, i))

        if array.size(allLvl) > 1
            array.sort(allLvl, order.ascending)
            ci2 = 0
            while ci2 < array.size(allLvl)
                base = array.get(allLvl, ci2)
                upper = base * (1 + confThreshold / 100)
                cnt = 1
                cj2 = ci2 + 1
                scanning = cj2 < array.size(allLvl)
                while scanning
                    if cj2 >= array.size(allLvl)
                        scanning := false
                    else if array.get(allLvl, cj2) <= upper
                        cnt += 1
                        cj2 += 1
                    else
                        scanning := false
                if cnt >= confMinLevels
                    zHi = array.get(allLvl, math.min(cj2 - 1, array.size(allLvl) - 1))
                    zLo = base
                    zMid = (zHi + zLo) / 2
                    col = zMid < close ? confBullCol : confBearCol
                    box.new(bar_index - 120, zHi, bar_index + 40, zLo, bgcolor=col, border_color=color.new(color.white, 100))
                    label.new(bar_index - 125, zMid, "CONF (" + str.tostring(cnt) + ")", style=label.style_none, textcolor=color.new(col, -40), size=size.small)
                    ci2 := cj2
                else
                    ci2 += 1


    // ─── COMPRESSION WEDGE ───
    if showCompression
        if not na(cH1) and not na(cH2) and cHB1 != cHB2
            _rail(cHB2, cH2, cHB1, cH1, compColor, 2, line.style_dashed)
        if not na(cL1) and not na(cL2) and cLB1 != cLB2
            _rail(cLB2, cL2, cLB1, cL1, compColor, 2, line.style_dashed)


// ═══════════════════════════════════════════════════════════════
// INFO TABLE
// ═══════════════════════════════════════════════════════════════

var table panel = table.new(position.top_right, 2, 6, bgcolor=color.new(#0D1117, 5), border_width=0)

if barstate.islast
    table.cell(panel, 0, 0, "ESCO THEORY", text_color=#C9A84C, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 0, "Geometry V2", text_color=color.gray, text_size=size.tiny, text_halign=text.align_right)

    cs = inSqueeze ? "🔴 SQUEEZE" : isCompressing ? "🟡 COMPRESS" : "🟢 EXPAND"
    cc = inSqueeze ? #FF5722 : isCompressing ? #FFEB3B : #4CAF50
    table.cell(panel, 0, 1, "Vol:", text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
    table.cell(panel, 1, 1, cs, text_color=cc, text_size=size.tiny, text_halign=text.align_right)

    table.cell(panel, 0, 2, "ATR:", text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
    table.cell(panel, 1, 2, str.tostring(atrRatio, "#.##"), text_color=atrRatio < 0.6 ? #FFEB3B : color.white, text_size=size.tiny, text_halign=text.align_right)

    table.cell(panel, 0, 3, "BBW:", text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
    table.cell(panel, 1, 3, str.tostring(bbWidth, "#.##") + "%", text_color=color.white, text_size=size.tiny, text_halign=text.align_right)

    ws = isWedge ? "✓ ACTIVE" : "—"
    table.cell(panel, 0, 4, "Wedge:", text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
    table.cell(panel, 1, 4, ws, text_color=isWedge ? #FFEB3B : color.gray, text_size=size.tiny, text_halign=text.align_right)

    table.cell(panel, 0, 5, "Pivots:", text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
    table.cell(panel, 1, 5, str.tostring(array.size(hiP)) + "H / " + str.tostring(array.size(loP)) + "L", text_color=color.white, text_size=size.tiny, text_halign=text.align_right)
