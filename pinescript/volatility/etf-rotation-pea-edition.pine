// Stratégie de rotation ETF (momentum / volatilité) – affichage sur EURONEXT:CW8 uniquement
// Affiche l'ETF du mois dans un tableau et courbe de backtest superposée au prix.

//@version=5
indicator("ETF Rotation CW8", overlay=true)

// ——— Paramètres (ETFs et volatilité fixes) ———
var string TICKER_CW8 = "CW8"
string etf1 = "EURONEXT:ESE"
string etf2 = "EURONEXT:PUST"
string etf3 = "EURONEXT:MEUD"
string etf4 = "EURONEXT:PAEEM"
int volLen = 252

// Options des 2 tableaux : localisation + taille (groupe "Tableaux" uniquement)
string table1PosInput = input.string("Haut droite", "Tableau ETF du mois — Position", options=["Haut gauche", "Haut centre", "Haut droite", "Milieu gauche", "Milieu centre", "Milieu droite", "Bas gauche", "Bas centre", "Bas droite"], group="Tableaux")
string table2PosInput = input.string("Bas centre", "Tableau Légende — Position", options=["Haut gauche", "Haut centre", "Haut droite", "Milieu gauche", "Milieu centre", "Milieu droite", "Bas gauche", "Bas centre", "Bas droite"], group="Tableaux")
string tableSizeInput = input.string("Small", "Taille des tableaux", options=["Tiny", "Small", "Medium", "Large", "Extra-large"], group="Tableaux")

// Date d'ancrage de la courbe (10 juin 2019, fixe)
int anchorYear = 2019
int anchorMonth = 6
int anchorDay = 10

// ——— Affichage imposé : CW8 + timeframe Daily uniquement ———
bool isCW8 = (syminfo.ticker == TICKER_CW8) or str.contains(syminfo.tickerid, TICKER_CW8)
bool isDaily = (timeframe.period == "D")
bool doShow = isCW8 and isDaily

// Mapping position string → position
getPos(s) => s == "Haut gauche" ? position.top_left : s == "Haut centre" ? position.top_center : s == "Haut droite" ? position.top_right : s == "Milieu gauche" ? position.middle_left : s == "Milieu centre" ? position.middle_center : s == "Milieu droite" ? position.middle_right : s == "Bas gauche" ? position.bottom_left : s == "Bas centre" ? position.bottom_center : position.bottom_right
tableTextSize = tableSizeInput == "Tiny" ? size.tiny : tableSizeInput == "Small" ? size.small : tableSizeInput == "Medium" ? size.normal : tableSizeInput == "Large" ? size.large : size.large

// ——— Clôtures mensuelles (1 à 12 mois) pour chaque ETF ———
fwdM(id, n) => request.security(id, "M", close[n], lookahead=barmerge.lookahead_off)
fwdM0(id) => request.security(id, "M", close, lookahead=barmerge.lookahead_off)

float m0_1 = fwdM0(etf1)
float m1_1 = fwdM(etf1, 1)
float m3_1 = fwdM(etf1, 3)
float m6_1 = fwdM(etf1, 6)
float m12_1 = fwdM(etf1, 12)

float m0_2 = fwdM0(etf2)
float m1_2 = fwdM(etf2, 1)
float m3_2 = fwdM(etf2, 3)
float m6_2 = fwdM(etf2, 6)
float m12_2 = fwdM(etf2, 12)

float m0_3 = fwdM0(etf3)
float m1_3 = fwdM(etf3, 1)
float m3_3 = fwdM(etf3, 3)
float m6_3 = fwdM(etf3, 6)
float m12_3 = fwdM(etf3, 12)

float m0_4 = fwdM0(etf4)
float m1_4 = fwdM(etf4, 1)
float m3_4 = fwdM(etf4, 3)
float m6_4 = fwdM(etf4, 6)
float m12_4 = fwdM(etf4, 12)

// Rendement mensuel (safe)
retM(c, cLag) => (math.abs(cLag) > 1e-10) ? (c / cLag - 1.0) : 0.0

// Momentum composite = moyenne des rendements 1, 3, 6, 12 mois
float mom1 = 0.25 * (retM(m0_1, m1_1) + retM(m0_1, m3_1) + retM(m0_1, m6_1) + retM(m0_1, m12_1))
float mom2 = 0.25 * (retM(m0_2, m1_2) + retM(m0_2, m3_2) + retM(m0_2, m6_2) + retM(m0_2, m12_2))
float mom3 = 0.25 * (retM(m0_3, m1_3) + retM(m0_3, m3_3) + retM(m0_3, m6_3) + retM(m0_3, m12_3))
float mom4 = 0.25 * (retM(m0_4, m1_4) + retM(m0_4, m3_4) + retM(m0_4, m6_4) + retM(m0_4, m12_4))

// Volatilité annualisée (252j) par ETF
float vol1 = request.security(etf1, timeframe.period, ta.stdev(ta.change(close) / math.max(close[1], 1e-10), volLen) * math.sqrt(252), lookahead=barmerge.lookahead_off)
float vol2 = request.security(etf2, timeframe.period, ta.stdev(ta.change(close) / math.max(close[1], 1e-10), volLen) * math.sqrt(252), lookahead=barmerge.lookahead_off)
float vol3 = request.security(etf3, timeframe.period, ta.stdev(ta.change(close) / math.max(close[1], 1e-10), volLen) * math.sqrt(252), lookahead=barmerge.lookahead_off)
float vol4 = request.security(etf4, timeframe.period, ta.stdev(ta.change(close) / math.max(close[1], 1e-10), volLen) * math.sqrt(252), lookahead=barmerge.lookahead_off)

// Score = momentum / vol (éviter division par zéro)
safeVol(v) => math.max(v, 1e-6)
float score1 = mom1 / safeVol(vol1)
float score2 = mom2 / safeVol(vol2)
float score3 = mom3 / safeVol(vol3)
float score4 = mom4 / safeVol(vol4)

// Changement de mois (premier bar du nouveau mois)
bool newMonth = ta.change(month(time)) != 0

// Sélection : meilleur score (persistant jusqu'au prochain mois)
var int selectedIdx = 0
var string selectedName = "CW8"
if newMonth
    float s1 = score1
    float s2 = score2
    float s3 = score3
    float s4 = score4
    float best = math.max(math.max(s1, s2), math.max(s3, s4))
    if best == s1
        selectedIdx := 1
        selectedName := syminfo.ticker(etf1)
    else if best == s2
        selectedIdx := 2
        selectedName := syminfo.ticker(etf2)
    else if best == s3
        selectedIdx := 3
        selectedName := syminfo.ticker(etf3)
    else
        selectedIdx := 4
        selectedName := syminfo.ticker(etf4)

// ========== COURBE D'ÉQUITÉ ==========
// Capitalisation depuis la 1re barre (tout calculé en amont). À la date d'ancrage on ne réinitialise pas :
// on utilise l'équité déjà construite et on met à l'échelle pour que la courbe passe par le prix à l'ancre.

float c1 = request.security(etf1, timeframe.period, close, lookahead=barmerge.lookahead_off)
float c2 = request.security(etf2, timeframe.period, close, lookahead=barmerge.lookahead_off)
float c3 = request.security(etf3, timeframe.period, close, lookahead=barmerge.lookahead_off)
float c4 = request.security(etf4, timeframe.period, close, lookahead=barmerge.lookahead_off)

float closeToday = selectedIdx == 1 ? c1 : selectedIdx == 2 ? c2 : selectedIdx == 3 ? c3 : selectedIdx == 4 ? c4 : close
float closeYesterday = selectedIdx == 1 ? c1[1] : selectedIdx == 2 ? c2[1] : selectedIdx == 3 ? c3[1] : selectedIdx == 4 ? c4[1] : close[1]

int anchorTime = timestamp(syminfo.timezone, anchorYear, anchorMonth, anchorDay, 0, 0, 0)
bool anchorBar = (time >= anchorTime) and (bar_index == 0 or na(time[1]) or time[1] < anchorTime)

// Équité capitalisée depuis la 1re barre (tout calculé en amont ; pas de reset à l'ancre)
var float equity = 1.0
if math.abs(closeYesterday) > 1e-10 and not na(closeToday)
    equity := equity * (closeToday / closeYesterday)

// Début de la courbe à la date d'ancrage : échelle = prix et équité à l'ancre (courbe = 1 à l'ancre)
float anchorEquityVal = ta.valuewhen(anchorBar, equity, 0)
float anchorPriceVal = ta.valuewhen(anchorBar, close, 0)
float equityPlot = (not na(anchorEquityVal) and math.abs(anchorEquityVal) > 1e-10) ? (anchorPriceVal * equity / anchorEquityVal) : float(na)

// Couleurs par ETF (réutilisées pour courbe et légende)
color colorEtf1 = color.new(#ee2525, 0)
color colorEtf2 = color.new(#FF6D00, 0)
color colorEtf3 = color.new(#00C853, 0)
color colorEtf4 = color.new(#AA00FF, 0)
color colorCw8 = color.new(color.gray, 30)
color equityColor = selectedIdx == 1 ? colorEtf1 : selectedIdx == 2 ? colorEtf2 : selectedIdx == 3 ? colorEtf3 : selectedIdx == 4 ? colorEtf4 : colorCw8

// ——— Affichage ———

// Message d'erreur si pas CW8 ou pas Daily (label supprimée quand tout est OK)
var label errLabel = na
if not doShow and barstate.islast
    if not na(errLabel)
        label.delete(errLabel)
    errLabel := label.new(bar_index, high, "Indicateur non disponible\nAffichez le graphique sur le CW8 en timeframe Daily.", style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.normal)
else if doShow and not na(errLabel)
    label.delete(errLabel)
    errLabel := na

var table tbl = table.new(getPos(table1PosInput), 2, 2, bgcolor=color.new(color.black, 85), border_width=1)
if doShow
    table.cell(tbl, 0, 0, "ETF du mois", text_color=color.white, text_size=tableTextSize)
    table.cell(tbl, 1, 0, selectedName, text_color=color.lime, text_size=tableTextSize)
    table.cell(tbl, 0, 1, "Ticker", text_color=color.gray, text_size=tableTextSize)
    string tickerStr = selectedIdx == 1 ? etf1 : selectedIdx == 2 ? etf2 : selectedIdx == 3 ? etf3 : selectedIdx == 4 ? etf4 : "CW8"
    table.cell(tbl, 1, 1, tickerStr, text_color=color.gray, text_size=tableTextSize)

var table legendTbl = table.new(getPos(table2PosInput), 6, 1, bgcolor=color.new(color.black, 85), border_width=1)
if doShow
    table.cell(legendTbl, 0, 0, "Légende", text_color=color.white, text_size=tableTextSize)
    table.cell(legendTbl, 1, 0, syminfo.ticker(etf1), bgcolor=colorEtf1, text_color=color.white, text_size=tableTextSize)
    table.cell(legendTbl, 2, 0, syminfo.ticker(etf2), bgcolor=colorEtf2, text_color=color.white, text_size=tableTextSize)
    table.cell(legendTbl, 3, 0, syminfo.ticker(etf3), bgcolor=colorEtf3, text_color=color.white, text_size=tableTextSize)
    table.cell(legendTbl, 4, 0, syminfo.ticker(etf4), bgcolor=colorEtf4, text_color=color.white, text_size=tableTextSize)
    table.cell(legendTbl, 5, 0, "CW8", bgcolor=colorCw8, text_color=color.white, text_size=tableTextSize)

plot(doShow ? equityPlot : na, "Courbe d'équité", color=equityColor, linewidth=2)
