//@version=6
// ===================================================================
// Aegis Parabolic Oscillator - Triple Confluence Histogram
// Author: [TheScalpingAnt]
// License: Mozilla Public License 2.0
// Description: Open-source indicator.
// ===================================================================

indicator("Aegis Parabolic Oscillator - Triple Confluence Histogram", shorttitle="Aegis Osc", overlay=false)

// --- TOOLTIP CONSTANTS -----------------------------------------------
var string TT_MA_TF      = "Timeframe for the Macro SAR trend filter."
var string TT_MA_START   = "AF starting value for the Macro SAR."
var string TT_MA_INC     = "AF increment for the Macro SAR."
var string TT_MA_MAX     = "Maximum AF cap for the Macro SAR."
var string TT_MI_TF      = "Timeframe for the Micro SAR entry-level momentum signal."
var string TT_MI_START   = "AF start for the Micro SAR."
var string TT_MI_INC     = "AF increment for the Micro SAR."
var string TT_MI_MAX     = "Maximum AF cap for the Micro SAR."
var string TT_EMA_LEN    = "Period of the EMA filter applied on the Macro timeframe."
var string TT_SHOW_TABLE = "Show/Hide the Trade Style Table."

// --- INPUTS: MACRO SAR (Updated to Screenshot Defaults) --------------
G1 = "Macro SAR Settings"
ma_tf    = input.timeframe("D", "Macro Timeframe",                      tooltip=TT_MA_TF,    group=G1)
ma_start = input.float(0.01, "Macro Start AF",       step=0.005,        tooltip=TT_MA_START, group=G1)
ma_inc   = input.float(0.01, "Macro Increment AF",   step=0.005,        tooltip=TT_MA_INC,   group=G1)
ma_max   = input.float(0.15, "Macro Max AF",         step=0.01,         tooltip=TT_MA_MAX,   group=G1)

// --- INPUTS: MICRO SAR (Updated to Screenshot Defaults) --------------
G2 = "Micro SAR Settings"
mi_tf    = input.timeframe("60",  "Micro Timeframe",                     tooltip=TT_MI_TF,    group=G2)
mi_start = input.float(0.02, "Micro Start AF",       step=0.005,        tooltip=TT_MI_START, group=G2)
mi_inc   = input.float(0.02, "Micro Increment AF",   step=0.005,        tooltip=TT_MI_INC,   group=G2)
mi_max   = input.float(0.2,  "Micro Max AF",         step=0.01,         tooltip=TT_MI_MAX,   group=G2)

// --- INPUTS: MACRO EMA FILTER ----------------------------------------
G3 = "Macro EMA Filter"
ema_len  = input.int(21, "EMA Length", minval=1, maxval=500,            tooltip=TT_EMA_LEN,  group=G3)

// --- INPUTS: DISPLAY -------------------------------------------------
G4 = "Display"
fullBullCol   = input.color(#1FFF00,                  "Full Confluence Bull (+100)", group=G4)
halfBullCol   = input.color(color.new(#1FFF00, 50),   "Partial Confluence Bull (+50)", group=G4)
fullBearCol   = input.color(#B10606,                  "Full Confluence Bear (-100)", group=G4)
halfBearCol   = input.color(color.new(#B10606, 50),   "Partial Confluence Bear (-50)", group=G4)
ribbonBullCol = input.color(color.white,              "Macro Ribbon Bull Color", group=G4)
ribbonBearCol = input.color(color.rgb(0, 0, 0),       "Macro Ribbon Bear Color", group=G4)
show_table    = input.bool(true, "Show Trade Style Table",             tooltip=TT_SHOW_TABLE, group=G4)
show_bg       = input.bool(false, "Show Background Tint", group=G4)
bg_transp     = input.int(90, "Background Tint Transparency", minval=0, maxval=99, group=G4)

// --- CALCULATIONS ----------------------------------------------------
mi_sar_local = ta.sar(mi_start, mi_inc, mi_max)
ma_sar_local = ta.sar(ma_start, ma_inc, ma_max)
ema_local    = ta.ema(close, ema_len)

u_bull_raw = request.security(syminfo.tickerid, mi_tf, close[1] > mi_sar_local[1] ? 1.0 : 0.0, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
m_bull_raw = request.security(syminfo.tickerid, ma_tf, close[1] > ma_sar_local[1] ? 1.0 : 0.0, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
m_ema      = request.security(syminfo.tickerid, ma_tf, ema_local[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
m_close    = request.security(syminfo.tickerid, ma_tf, close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

bool u_bull   = na(u_bull_raw) ? (close[1] > mi_sar_local[1]) : (u_bull_raw == 1.0)
bool m_bull   = na(m_bull_raw) ? (close[1] > ma_sar_local[1]) : (m_bull_raw == 1.0)
bool ema_bull = na(m_ema) ? (close[1] > ema_local[1]) : (m_close > m_ema)

float oscValue = 0.0
color histColor = color.new(color.gray, 100)

if m_bull
    if u_bull and ema_bull
        oscValue := 100
        histColor := fullBullCol
    else if u_bull
        oscValue := 50
        histColor := halfBullCol
else
    if not u_bull and not ema_bull
        oscValue := -100
        histColor := fullBearCol
    else if not u_bull
        oscValue := -50
        histColor := halfBearCol

d_f = display.all - display.price_scale - display.status_line
plot(oscValue, title="Aegis Confluence", color=histColor, style=plot.style_columns, histbase=0, display=d_f)
hline(0, "Zero Line", color=color.new(color.gray, 90))
plot(m_bull ? 15 : -15, "Macro Ribbon Top",    color=m_bull ? ribbonBullCol : ribbonBearCol, style=plot.style_columns, histbase=0, linewidth=3, display=d_f)
plot(m_bull ? -15 : 15, "Macro Ribbon Bottom", color=m_bull ? ribbonBullCol : ribbonBearCol, style=plot.style_columns, histbase=0, linewidth=3, display=d_f)
bgcolor(show_bg ? (m_bull ? color.new(ribbonBullCol, bg_transp) : color.new(ribbonBearCol, bg_transp)) : na)

// --- TRADE STYLE TABLE (Updated Styling) -----------------------------
if barstate.islast and show_table
    var table matrix = table.new(position.top_right, 5, 5, bgcolor=color.white, border_width=1, border_color=color.gray)
    
    // Header Colors
    header_bg = color.gray
    header_tx = color.white
    
    // Data Colors
    c_style = color.black
    c_data  = color.purple
    c_ema_v = #800020 // Burgundy
    t_size  = size.small

    // Row 1: Headers
    table.cell(matrix, 0, 0, "Trade Style", bgcolor=header_bg, text_color=header_tx, text_size=t_size)
    table.cell(matrix, 1, 0, "Micro AF",    bgcolor=header_bg, text_color=header_tx, text_size=t_size)
    table.cell(matrix, 2, 0, "Macro AF",    bgcolor=header_bg, text_color=header_tx, text_size=t_size)
    table.cell(matrix, 3, 0, "EMA Length",  bgcolor=header_bg, text_color=header_tx, text_size=t_size)
    table.cell(matrix, 4, 0, "TF Suggest",  bgcolor=header_bg, text_color=header_tx, text_size=t_size)

    // Row 2: Scalping
    table.cell(matrix, 0, 1, "Scalping",  text_color=c_style, text_size=t_size)
    table.cell(matrix, 1, 1, "0.04/0.2",  text_color=c_data,  text_size=t_size)
    table.cell(matrix, 2, 1, "0.02/0.2",  text_color=c_data,  text_size=t_size)
    table.cell(matrix, 3, 1, "13",        text_color=c_ema_v, text_size=t_size)
    table.cell(matrix, 4, 1, "1m/15m",    text_color=c_data,  text_size=t_size)

    // Row 3: Day Trade
    table.cell(matrix, 0, 2, "Day Trade", text_color=c_style, text_size=t_size)
    table.cell(matrix, 1, 2, "0.02/0.2",  text_color=c_data,  text_size=t_size)
    table.cell(matrix, 2, 2, "0.01/0.1",  text_color=c_data,  text_size=t_size)
    table.cell(matrix, 3, 2, "21",        text_color=c_ema_v, text_size=t_size)
    table.cell(matrix, 4, 2, "15m/4H",    text_color=c_data,  text_size=t_size)

    // Row 4: Swing
    table.cell(matrix, 0, 3, "Swing",     text_color=c_style, text_size=t_size)
    table.cell(matrix, 1, 3, "0.01/0.1",  text_color=c_data,  text_size=t_size)
    table.cell(matrix, 2, 3, "0.005/0.1", text_color=c_data,  text_size=t_size)
    table.cell(matrix, 3, 3, "50",        text_color=c_ema_v, text_size=t_size)
    table.cell(matrix, 4, 3, "1H/1D",     text_color=c_data,  text_size=t_size)

    // Row 5: Long Term
    table.cell(matrix, 0, 4, "Long Term", text_color=c_style, text_size=t_size)
    table.cell(matrix, 1, 4, "0.005/0.1", text_color=c_data,  text_size=t_size)
    table.cell(matrix, 2, 4, "0.002/0.05",text_color=c_data,  text_size=t_size)
    table.cell(matrix, 3, 4, "100/200",   text_color=c_ema_v, text_size=t_size)
    table.cell(matrix, 4, 4, "4H/1W",     text_color=c_data,  text_size=t_size)
