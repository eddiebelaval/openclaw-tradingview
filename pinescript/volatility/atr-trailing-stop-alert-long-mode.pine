//@version=6
indicator("ATR Trailing Stop (Long Mode)", overlay=true)

// === Inputs ===
atrLen = input.int(14, "ATR Period", minval=1)
hhvLen = input.int(10, "HHV Period", minval=1)
mult   = input.float(2.5, "Multiplier", minval=0.1, step=0.1)
warmup = input.int(15, "Warmup Bars", minval=0)

// === Core ===
atrValue = ta.atr(atrLen)
rawStop  = high - mult * atrValue
tsCore   = ta.highest(rawStop, hhvLen)
ts       = bar_index < warmup ? close : tsCore

// === Long Mode ===
longMode = close > ts
stopPlot = longMode ? ts : na

// Stop als kleine Kreise (grau)
plot(stopPlot,
     "ATR Long Stop",
     color=color.gray,
     linewidth=1,
     style=plot.style_circles)

// === Alert bei Stopbruch ===
stopBreak = ta.crossunder(close, ts)

alertcondition(stopBreak,
     title="ATR Long Stop Hit",
     message="Preis hat den ATR Long Stop unterschritten – Chart prüfen.")

// Stop-Hit: sehr kleine Dreiecke abwärts
plotshape(stopBreak,
     title="Stop Hit",
     location=location.abovebar,
     style=shape.triangledown,
     color=color.red,
     size=size.tiny)
