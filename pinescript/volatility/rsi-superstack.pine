//@version=5
indicator("RSI Superstack", shorttitle="RSI SS", overlay=true)

// Input parameters
rsiLength = input.int(14, title="RSI Length", minval=1)
oversoldLevel = input.int(30, title="Oversold Level", minval=0, maxval=50)
overboughtLevel = input.int(70, title="Overbought Level", minval=50, maxval=100)
useExtendedHours = input.bool(true, title="Use Extended Hours")

// Timeframes to check
tf5m = "5"
tf15m = "15"
tf30m = "30"
tf1h = "60"
tf4h = "240"
tf1d = "D"
tf1w = "W"

// Calculate RSI for each timeframe
tickerID = useExtendedHours ? syminfo.tickerid : ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
rsi5m = request.security(tickerID, tf5m, ta.rsi(close, rsiLength))
rsi15m = request.security(tickerID, tf15m, ta.rsi(close, rsiLength))
rsi30m = request.security(tickerID, tf30m, ta.rsi(close, rsiLength))
rsi1h = request.security(tickerID, tf1h, ta.rsi(close, rsiLength))
rsi4h = request.security(tickerID, tf4h, ta.rsi(close, rsiLength))
rsi1d = request.security(tickerID, tf1d, ta.rsi(close, rsiLength))
rsi1w = request.security(tickerID, tf1w, ta.rsi(close, rsiLength))

// Check if each timeframe is oversold
is5mOversold = rsi5m < oversoldLevel
is15mOversold = rsi15m < oversoldLevel
is30mOversold = rsi30m < oversoldLevel
is1hOversold = rsi1h < oversoldLevel
is4hOversold = rsi4h < oversoldLevel
is1dOversold = rsi1d < oversoldLevel
is1wOversold = rsi1w < oversoldLevel

// Check if each timeframe is overbought
is5mOverbought = rsi5m > overboughtLevel
is15mOverbought = rsi15m > overboughtLevel
is30mOverbought = rsi30m > overboughtLevel
is1hOverbought = rsi1h > overboughtLevel
is4hOverbought = rsi4h > overboughtLevel
is1dOverbought = rsi1d > overboughtLevel
is1wOverbought = rsi1w > overboughtLevel

// Count how many timeframes are oversold
oversoldCount = (is5mOversold ? 1 : 0) + (is15mOversold ? 1 : 0) + (is30mOversold ? 1 : 0) + (is1hOversold ? 1 : 0) + (is4hOversold ? 1 : 0) + (is1dOversold ? 1 : 0) + (is1wOversold ? 1 : 0)

// Count how many timeframes are overbought
overboughtCount = (is5mOverbought ? 1 : 0) + (is15mOverbought ? 1 : 0) + (is30mOverbought ? 1 : 0) + (is1hOverbought ? 1 : 0) + (is4hOverbought ? 1 : 0) + (is1dOverbought ? 1 : 0) + (is1wOverbought ? 1 : 0)

// Check if all timeframes are oversold
allOversold = oversoldCount == 7

// Check if all timeframes are overbought
allOverbought = overboughtCount == 7

// Visual alerts on chart
bgcolor(allOversold ? color.new(color.red, 90) : allOverbought ? color.new(color.green, 90) : na, title="All Oversold/Overbought Background")

// Plot signal when all timeframes are oversold
plotshape(allOversold, title="All Oversold Signal", location=location.belowbar, color=color.new(color.red, 0), style=shape.triangleup, size=size.normal, text="ALL OS")

// Plot signal when all timeframes are overbought
plotshape(allOverbought, title="All Overbought Signal", location=location.abovebar, color=color.new(color.green, 0), style=shape.triangledown, size=size.normal, text="ALL OB")

// Plot signals for partial alignment (5+ timeframes)
strongOversoldSignal = oversoldCount >= 5 and not allOversold
plotshape(strongOversoldSignal, title="Strong Oversold (5+)", location=location.belowbar, color=color.new(color.red, 60), style=shape.triangleup, size=size.small, text="5+")

strongOverboughtSignal = overboughtCount >= 5 and not allOverbought
plotshape(strongOverboughtSignal, title="Strong Overbought (5+)", location=location.abovebar, color=color.new(color.green, 60), style=shape.triangledown, size=size.small, text="5+")

// Create a table to display RSI values and status
var table rsiTable = table.new(position.top_right, 3, 8, border_width=1)

if barstate.islast
    table.cell(rsiTable, 0, 0, "Timeframe", bgcolor=color.gray, text_color=color.white)
    table.cell(rsiTable, 1, 0, "RSI", bgcolor=color.gray, text_color=color.white)
    table.cell(rsiTable, 2, 0, "Status", bgcolor=color.gray, text_color=color.white)
    
    table.cell(rsiTable, 0, 1, "5m", text_color=color.white)
    table.cell(rsiTable, 1, 1, str.tostring(rsi5m, "#.##"), text_color=color.white)
    table.cell(rsiTable, 2, 1, is5mOversold ? "OS" : is5mOverbought ? "OB" : "", bgcolor=is5mOversold ? color.new(color.red, 50) : is5mOverbought ? color.new(color.green, 50) : color.new(color.gray, 80), text_color=color.white)
    
    table.cell(rsiTable, 0, 2, "15m", text_color=color.white)
    table.cell(rsiTable, 1, 2, str.tostring(rsi15m, "#.##"), text_color=color.white)
    table.cell(rsiTable, 2, 2, is15mOversold ? "OS" : is15mOverbought ? "OB" : "", bgcolor=is15mOversold ? color.new(color.red, 50) : is15mOverbought ? color.new(color.green, 50) : color.new(color.gray, 80), text_color=color.white)
    
    table.cell(rsiTable, 0, 3, "30m", text_color=color.white)
    table.cell(rsiTable, 1, 3, str.tostring(rsi30m, "#.##"), text_color=color.white)
    table.cell(rsiTable, 2, 3, is30mOversold ? "OS" : is30mOverbought ? "OB" : "", bgcolor=is30mOversold ? color.new(color.red, 50) : is30mOverbought ? color.new(color.green, 50) : color.new(color.gray, 80), text_color=color.white)
    
    table.cell(rsiTable, 0, 4, "1H", text_color=color.white)
    table.cell(rsiTable, 1, 4, str.tostring(rsi1h, "#.##"), text_color=color.white)
    table.cell(rsiTable, 2, 4, is1hOversold ? "OS" : is1hOverbought ? "OB" : "", bgcolor=is1hOversold ? color.new(color.red, 50) : is1hOverbought ? color.new(color.green, 50) : color.new(color.gray, 80), text_color=color.white)
    
    table.cell(rsiTable, 0, 5, "4H", text_color=color.white)
    table.cell(rsiTable, 1, 5, str.tostring(rsi4h, "#.##"), text_color=color.white)
    table.cell(rsiTable, 2, 5, is4hOversold ? "OS" : is4hOverbought ? "OB" : "", bgcolor=is4hOversold ? color.new(color.red, 50) : is4hOverbought ? color.new(color.green, 50) : color.new(color.gray, 80), text_color=color.white)
    
    table.cell(rsiTable, 0, 6, "1D", text_color=color.white)
    table.cell(rsiTable, 1, 6, str.tostring(rsi1d, "#.##"), text_color=color.white)
    table.cell(rsiTable, 2, 6, is1dOversold ? "OS" : is1dOverbought ? "OB" : "", bgcolor=is1dOversold ? color.new(color.red, 50) : is1dOverbought ? color.new(color.green, 50) : color.new(color.gray, 80), text_color=color.white)
    
    table.cell(rsiTable, 0, 7, "1W", text_color=color.white)
    table.cell(rsiTable, 1, 7, str.tostring(rsi1w, "#.##"), text_color=color.white)
    table.cell(rsiTable, 2, 7, is1wOversold ? "OS" : is1wOverbought ? "OB" : "", bgcolor=is1wOversold ? color.new(color.red, 50) : is1wOverbought ? color.new(color.green, 50) : color.new(color.gray, 80), text_color=color.white)

// Alert conditions
alertcondition(allOversold, title="All Timeframes Oversold", message="RSI is oversold on ALL timeframes (5m, 15m, 30m, 1H, 4H, 1D, 1W)")
alertcondition(oversoldCount >= 5, title="5+ Timeframes Oversold", message="RSI is oversold on 5+ timeframes")
alertcondition(allOverbought, title="All Timeframes Overbought", message="RSI is overbought on ALL timeframes (5m, 15m, 30m, 1H, 4H, 1D, 1W)")
alertcondition(overboughtCount >= 5, title="5+ Timeframes Overbought", message="RSI is overbought on 5+ timeframes")
