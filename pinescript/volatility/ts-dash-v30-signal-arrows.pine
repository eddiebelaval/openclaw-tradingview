//@version=5
indicator("TS-DASH-v3.0 - Signal Arrows", shorttitle="TS Signals", overlay=true)

// ============================================================================
// SETTINGS
// ============================================================================

grp_sig = "Signal Settings"
i_show_arrows = input.bool(true, "Show Signal Arrows", group=grp_sig)
i_min_conditions = input.int(4, "Minimum Conditions", minval=1, maxval=6, group=grp_sig, tooltip="How many metrics must align for a signal")
i_confirm_bars = input.int(2, "Confirmation Bars", minval=1, maxval=5, group=grp_sig, tooltip="Consecutive bars needed to confirm signal")

grp_enable = "Enable/Disable Metrics"
i_sig_ma_enabled = input.bool(true, "Use MA Alignment", group=grp_enable)
i_sig_ma_count = input.int(5, "MA Min Count", minval=1, maxval=8, group=grp_enable)
i_sig_mfi_enabled = input.bool(true, "Use MFI", group=grp_enable)
i_sig_tm_enabled = input.bool(true, "Use Trend Meter", group=grp_enable)
i_sig_cvd_enabled = input.bool(true, "Use CVD", group=grp_enable)
i_sig_vold_enabled = input.bool(true, "Use VOLD", group=grp_enable)
i_sig_add_enabled = input.bool(true, "Use ADD", group=grp_enable)

grp_vis = "Visual Settings"
c_sig_bull = input.color(#00C853, "Bullish Arrow Color", group=grp_vis)
c_sig_bear = input.color(#FF1744, "Bearish Arrow Color", group=grp_vis)

grp_kill = "Kill Switch"
i_kill_enabled = input.bool(true, "Enable Kill Switch", group=grp_kill)
i_kill_min_count = input.int(2, "Kill Switch Threshold", minval=1, maxval=4, group=grp_kill, tooltip="Blocks signals if this many kill conditions are met")
i_kill_session = input.bool(true, "Kill: Avoid Sessions", group=grp_kill, tooltip="11:30-13:30 and 15:45-16:00")
i_kill_rvol = input.bool(true, "Kill: Low RVOL", group=grp_kill)
i_kill_rvol_thresh = input.float(0.8, "RVOL Threshold", group=grp_kill)
i_kill_vix_term = input.bool(true, "Kill: VIX Term Structure", group=grp_kill)
i_kill_vix_term_thresh = input.float(1.15, "VIX/VIX3M Threshold", group=grp_kill)
i_kill_yields = input.bool(true, "Kill: Rising Yields", group=grp_kill)
i_kill_yields_thresh = input.float(0.5, "ZN % Change Threshold", group=grp_kill)

grp_ses = "Session Settings"
i_ses_rth = input.session("0930-1600", "RTH Session", group=grp_ses)
i_ses_tz = input.string("America/New_York", "Timezone", group=grp_ses)

// ============================================================================
// MA ALIGNMENT
// ============================================================================
i_ma_30w_len = 30
i_ma_5d_len = 5
i_ma_1d_len = 78
i_ma_4h_len = 240
i_ma_1h_len = 60
i_ma_15m_len = 15
i_ma_5m_len = 5
i_ma_1m_len = 20

f_calc_ma(src, len, maType) =>
    result = ta.ema(src, len)
    if maType == "SMA"
        result := ta.sma(src, len)
    else if maType == "Wilder (RMA)"
        result := ta.rma(src, len)
    result

getTrend(maVal, thresholdPct) =>
    result = 0
    if not na(maVal)
        thresholdAmt = maVal * (thresholdPct / 100)
        if close > maVal + thresholdAmt
            result := 1
        else if close < maVal - thresholdAmt
            result := -1
    result

[ma_30w, ma_30w_close] = request.security(syminfo.tickerid, "W", [ta.sma(close, i_ma_30w_len), close], lookahead=barmerge.lookahead_on)
[ma_5d, ma_5d_close] = request.security(syminfo.tickerid, "D", [ta.ema(close, i_ma_5d_len), close], lookahead=barmerge.lookahead_on)
[ma_1d, ma_1d_close] = request.security(syminfo.tickerid, "D", [ta.ema(close, i_ma_1d_len), close], lookahead=barmerge.lookahead_on)
[ma_4h, ma_4h_close] = request.security(syminfo.tickerid, "240", [ta.ema(close, i_ma_4h_len), close], lookahead=barmerge.lookahead_on)
[ma_1h, ma_1h_close] = request.security(syminfo.tickerid, "60", [ta.ema(close, i_ma_1h_len), close], lookahead=barmerge.lookahead_on)
[ma_15m, ma_15m_close] = request.security(syminfo.tickerid, "15", [ta.ema(close, i_ma_15m_len), close], lookahead=barmerge.lookahead_on)
[ma_5m, ma_5m_close] = request.security(syminfo.tickerid, "5", [ta.ema(close, i_ma_5m_len), close], lookahead=barmerge.lookahead_on)
[ma_1m, ma_1m_close] = request.security(syminfo.tickerid, "1", [ta.ema(close, i_ma_1m_len), close], lookahead=barmerge.lookahead_on)

tr_30w = getTrend(ma_30w, 0.0)
tr_5d = getTrend(ma_5d, 0.0)
tr_1d = getTrend(ma_1d, 0.0)
tr_4h = getTrend(ma_4h, 0.0)
tr_1h = getTrend(ma_1h, 0.0)
tr_15m = getTrend(ma_15m, 0.0)
tr_5m = getTrend(ma_5m, 0.0)
tr_1m = getTrend(ma_1m, 0.0)

b_cnt = 0
r_cnt = 0
arr = array.from(tr_30w, tr_5d, tr_1d, tr_4h, tr_1h, tr_15m, tr_5m, tr_1m)
for i = 0 to 7
    v = array.get(arr, i)
    if v == 1
        b_cnt += 1
    if v == -1
        r_cnt += 1

// ============================================================================
// INTERNALS
// ============================================================================
i_mkt_source = "NASDAQ (USI)"
var string uvol_sym = "USI:UPVOL.NQ"
var string dvol_sym = "USI:DNVOL.NQ"
var string add_sym = "USI:ADDQ"

val_uvol = request.security(uvol_sym, "D", close, ignore_invalid_symbol=true, lookahead=barmerge.lookahead_on)
val_dvol = request.security(dvol_sym, "D", close, ignore_invalid_symbol=true, lookahead=barmerge.lookahead_on)
val_add = request.security(add_sym, "1", close, ignore_invalid_symbol=true)

safe_up = nz(val_uvol, 0)
safe_down = nz(val_dvol, 0)
vold_calc = 0.0
if safe_down > 0 and safe_up > 0
    vold_calc := safe_up >= safe_down ? safe_up / safe_down : -(safe_down / safe_up)

add_calc = nz(val_add, 0)

// ============================================================================
// MFI
// ============================================================================
i_mfi_len = 14
i_mfi_current_tf = 5
i_mfi_higher_tf = 15
i_mfi_m1_thresh = 2.0
i_mfi_m5_thresh = 2.0

mfi_raw = ta.mfi(close, i_mfi_len * 2) - 50
htf_multiplier = i_mfi_higher_tf / i_mfi_current_tf
adjusted_mfi_length = math.round(i_mfi_len * htf_multiplier)
mfi_htf = ta.mfi(close, int(math.max(1, adjusted_mfi_length))) - 50
mfi_bullish = mfi_raw > i_mfi_m1_thresh and mfi_htf > i_mfi_m5_thresh
mfi_bearish = mfi_raw < -i_mfi_m1_thresh and mfi_htf < -i_mfi_m5_thresh

// ============================================================================
// TREND METER
// ============================================================================
i_tm_fast = 9
i_tm_slow = 21
i_tm_bias = 35
i_tm_min_metrics = 4

fast_ema = ta.ema(close, i_tm_fast)
slow_ema = ta.ema(close, i_tm_slow)
bias_ema = ta.ema(close, i_tm_bias)
vwap_val = ta.vwap(hlc3)

in_rth = not na(time(timeframe.period, i_ses_rth + ":1234567", i_ses_tz))

trend_state = fast_ema > slow_ema ? 1 : fast_ema < slow_ema ? -1 : 0
bias_state = close > bias_ema ? 1 : close < bias_ema ? -1 : 0
vwap_state = close > vwap_val ? 1 : close < vwap_val ? -1 : 0

bullish_count = (trend_state == 1 ? 1 : 0) + (bias_state == 1 ? 1 : 0) + (vwap_state == 1 ? 1 : 0)
bearish_count = (trend_state == -1 ? 1 : 0) + (bias_state == -1 ? 1 : 0) + (vwap_state == -1 ? 1 : 0)
tm_bullish = bullish_count >= 2
tm_bearish = bearish_count >= 2

// ============================================================================
// CVD
// ============================================================================
i_cvd_len = 20
i_cvd_reset = "D"

cvd_reset = timeframe.change("D")
bar_delta = close > open ? volume : close < open ? -volume : 0.0

var float cvd = 0.0
if cvd_reset
    cvd := bar_delta
else
    cvd += bar_delta

cvd_sm = ta.sma(cvd, i_cvd_len)
cvd_bullish = cvd > cvd_sm
cvd_bearish = cvd < cvd_sm

// ============================================================================
// KILL SWITCH
// ============================================================================
i_rvol_len = 20
rv_a = ta.sma(volume, i_rvol_len)
rv_v = rv_a != 0 ? volume / rv_a : 0.0

i_sym_vix = "VIX"
i_sym_v3m = "VIX3M"
i_sym_zn = "ZN1!"

vix_cl = request.security(i_sym_vix, timeframe.period, close, ignore_invalid_symbol=true)
v3_c = request.security(i_sym_v3m, timeframe.period, close, ignore_invalid_symbol=true)
zn_c = request.security(i_sym_zn, timeframe.period, close, ignore_invalid_symbol=true)
zn_p = request.security(i_sym_zn, timeframe.period, close[1], ignore_invalid_symbol=true)

zn_ch = nz(zn_p) != 0 ? (nz(zn_c) - nz(zn_p)) / nz(zn_p) * 100 : 0.0
v_tm = nz(v3_c) != 0 ? nz(vix_cl) / nz(v3_c) : 1.0

hr = hour(time, i_ses_tz)
mn = minute(time, i_ses_tz)
tod = hr * 100 + mn
ses_avoid = (tod >= 1130 and tod < 1330) or (tod >= 1545 and tod < 1600)

k_cnt = 0
if i_kill_session and ses_avoid
    k_cnt += 1
if i_kill_rvol and rv_v < i_kill_rvol_thresh
    k_cnt += 1
if i_kill_vix_term and v_tm > i_kill_vix_term_thresh
    k_cnt += 1
if i_kill_yields and zn_ch > i_kill_yields_thresh
    k_cnt += 1

// ============================================================================
// SIGNAL LOGIC
// ============================================================================
bull_conditions = (i_sig_ma_enabled and b_cnt >= i_sig_ma_count ? 1 : 0) + (i_sig_mfi_enabled and mfi_bullish ? 1 : 0) + (i_sig_tm_enabled and tm_bullish ? 1 : 0) + (i_sig_cvd_enabled and cvd_bullish ? 1 : 0) + (i_sig_vold_enabled and vold_calc > 0 ? 1 : 0) + (i_sig_add_enabled and add_calc > 0 ? 1 : 0)
bear_conditions = (i_sig_ma_enabled and r_cnt >= i_sig_ma_count ? 1 : 0) + (i_sig_mfi_enabled and mfi_bearish ? 1 : 0) + (i_sig_tm_enabled and tm_bearish ? 1 : 0) + (i_sig_cvd_enabled and cvd_bearish ? 1 : 0) + (i_sig_vold_enabled and vold_calc < 0 ? 1 : 0) + (i_sig_add_enabled and add_calc < 0 ? 1 : 0)

f_bull_r = bull_conditions >= i_min_conditions
f_bear_r = bear_conditions >= i_min_conditions

var int b_cfm = 0
var int r_cfm = 0
b_cfm := f_bull_r ? b_cfm + 1 : 0
r_cfm := f_bear_r ? r_cfm + 1 : 0

bull_s = b_cfm >= i_confirm_bars and (i_kill_enabled ? k_cnt < i_kill_min_count : true)
bear_s = r_cfm >= i_confirm_bars and (i_kill_enabled ? k_cnt < i_kill_min_count : true)

// ============================================================================
// PLOT ARROWS
// ============================================================================
plotshape(i_show_arrows and bull_s, title="Bullish Signal", location=location.belowbar, color=c_sig_bull, style=shape.triangleup, size=size.small)
plotshape(i_show_arrows and bear_s, title="Bearish Signal", location=location.abovebar, color=c_sig_bear, style=shape.triangledown, size=size.small)
