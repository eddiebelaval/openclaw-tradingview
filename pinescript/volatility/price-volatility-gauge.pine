//@version=6
indicator("Price Volatility Gauge", shorttitle="PriceVol", precision=3)

spot = input.source(close, "Source")
volatility_choice = input.string(title="Choose Volatility Data", defval="IV Rank", options=["Implied Volatility", "IV Rank", "IV Percentile", "Volatility Skew Index"])
pricevol_length = input.int(22, "PriceVol Length (recommended: 9, 22, 66, 132, 252)", minval=1)
pricevol_rank_len = input.int(252, "PriceVol Rank/Percentile Length", minval=1)

inside_high_vol_color = input.color(color.orange, "Inside High Volatility")
outside_high_vol_color = input.color(color.aqua, "Outside High Volatility")

spot_stdev = ta.stdev(spot, pricevol_length)
low_stdev = ta.stdev(low, pricevol_length)

pricevol_side(float mult, bool is_up) =>
    float spot_adj = is_up ? spot + spot_stdev * mult : spot - spot_stdev * mult
    float low_adj = is_up ? low + low_stdev * mult : low - low_stdev * mult
    float spot_hi = ta.highest(spot_adj, pricevol_length)
    spot_hi != 0.0 ? (spot_hi - low_adj) / spot_hi * 100.0 : na

avg_up = (pricevol_side(1.0, true) + pricevol_side(2.0, true) + pricevol_side(3.0, true)) / 3.0
avg_dn = (pricevol_side(1.0, false) + pricevol_side(2.0, false) + pricevol_side(3.0, false)) / 3.0
pricevol_skew = avg_up - avg_dn

spot_hi0 = ta.highest(spot, pricevol_length)
price_vol = spot_hi0 != 0.0 ? (spot_hi0 - low) / spot_hi0 * 100.0 : na

lo = ta.lowest(price_vol, pricevol_rank_len)
hi = ta.highest(price_vol, pricevol_rank_len)
rng = hi - lo
ivr = rng != 0.0 ? (price_vol - lo) / rng * 100.0 : na
pct_rank = ta.percentrank(price_vol, pricevol_rank_len)

float out = na
if volatility_choice == "IV Percentile"
    out := pct_rank
else if volatility_choice == "IV Rank"
    out := ivr
else if volatility_choice == "Volatility Skew Index"
    out := pricevol_skew
else
    out := price_vol * 100.0

color out_color = inside_high_vol_color
if volatility_choice == "IV Percentile" or volatility_choice == "IV Rank"
    out_color := out < 50.0 ? outside_high_vol_color : inside_high_vol_color

plot(out, color=out_color, title="PriceVol Data")
