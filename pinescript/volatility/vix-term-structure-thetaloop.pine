//@version=6
indicator("VIX Term Structure [ThetaLoop]", shorttitle="VIX Term", overlay=false, precision=3)

// ═══════════════════════════════════════════════════════════════
//  VIX TERM STRUCTURE — Backwardation Detector
//  TEST INDICATOR: Validate theory before bot implementation
//
//  Load on ANY chart (e.g. SPY Daily).
//  It pulls VIX and VIX3M automatically via request.security().
//
//  WHAT TO LOOK FOR:
//  - Ratio > 1.0 (red zone) = Backwardation = Panic regime
//  - Ratio < 1.0 (green zone) = Contango = Normal
//  - Compare red zones with SPY drops → does it catch crashes?
// ═══════════════════════════════════════════════════════════════

// ─── DATA ─────────────────────────────────────────────────────
vix   = request.security("CBOE:VIX",   timeframe.period, close)
vix3m = request.security("CBOE:VIX3M", timeframe.period, close)

// ─── CALCULATION ──────────────────────────────────────────────
// Core ratio: VIX / VIX3M
// > 1.0 = Backwardation (short-term fear > long-term)
// < 1.0 = Contango (normal, healthy)
ratio = vix3m != 0 ? vix / vix3m : 0.0

// Smoothed version (3-day EMA to reduce noise)
ratio_smooth = ta.ema(ratio, 3)

// Persistence: how many consecutive days in backwardation?
var int backwardation_streak = 0
if ratio > 1.0
    backwardation_streak := backwardation_streak + 1
else
    backwardation_streak := 0

// VIX Rate of Change (5 trading days)
vix_roc = vix[5] != 0 ? (vix - vix[5]) / vix[5] : 0.0

// ─── COLORS ───────────────────────────────────────────────────
col_danger = color.new(color.red,    0)
col_warn   = color.new(color.orange, 0)
col_normal = color.new(color.teal,   0)

bar_col = ratio > 1.05 ? col_danger :
          ratio > 1.00 ? col_warn   : col_normal

// ─── PLOTS ────────────────────────────────────────────────────
plot(ratio,        "VIX/VIX3M Ratio",  color=bar_col,                    linewidth=2)
plot(ratio_smooth, "Smoothed (EMA3)",  color=color.new(color.white, 60), linewidth=1)

// Threshold lines
hline(1.00, "Parity",           color=color.new(color.gray, 30),   linewidth=2)
hline(1.05, "Alarm (1.05)",     color=color.new(color.red, 40),    linewidth=1, linestyle=hline.style_dashed)
hline(0.95, "Deep Contango",    color=color.new(color.green, 40),  linewidth=1, linestyle=hline.style_dashed)

// Background zones
h_top = hline(1.30, display=display.none)
h_par = hline(1.00, display=display.none)
h_bot = hline(0.70, display=display.none)
fill(h_top, h_par, color=color.new(color.red,   90))
fill(h_par, h_bot, color=color.new(color.green,  92))

// VIX RoC as separate plot (optional, shows speed)
plot(vix_roc, "VIX 5d RoC", color=color.new(color.yellow, 40), linewidth=1, display=display.none)

// ─── INFO TABLE ───────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 5,
     bgcolor=color.new(color.black, 70), border_width=1, border_color=color.new(color.gray, 60))

regime_text = ratio > 1.05 ? "BACKWARDATION" : ratio > 1.0 ? "MILD INVERSION" : "CONTANGO"
regime_col  = ratio > 1.05 ? col_danger : ratio > 1.0 ? col_warn : col_normal

if barstate.islast
    table.cell(t, 0, 0, "Regime",   text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 0, regime_text, text_color=regime_col,  text_size=size.normal)
    table.cell(t, 0, 1, "Ratio",    text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 1, str.tostring(ratio, "#.###"), text_color=regime_col, text_size=size.small)
    table.cell(t, 0, 2, "VIX",      text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 2, str.tostring(vix, "#.##"),    text_color=color.white, text_size=size.small)
    table.cell(t, 0, 3, "VIX3M",    text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 3, str.tostring(vix3m, "#.##"),  text_color=color.white, text_size=size.small)
    table.cell(t, 0, 4, "5d RoC",   text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 4, str.tostring(vix_roc * 100, "#.#") + "%",
               text_color=vix_roc > 0.40 ? col_danger : color.white, text_size=size.small)

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(ratio > 1.05 and ratio[1] <= 1.05, "Backwardation Entry",  "VIX Term Structure flipped to Backwardation")
alertcondition(ratio < 1.00 and ratio[1] >= 1.00, "Contango Recovery",    "VIX Term Structure normalized to Contango")
alertcondition(vix_roc > 0.40,                     "VIX Explosion (+40%)", "VIX rose >40% in 5 trading days")
