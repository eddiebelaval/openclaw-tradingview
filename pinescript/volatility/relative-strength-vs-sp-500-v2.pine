//@version=6
indicator("EGU • Relative Strength vs S&P 500 v2 — Emilien", overlay=false, max_lines_count=100, max_labels_count=100)

//==============================
// INPUTS
//==============================
grpMain = "⚙️ Core Settings"
benchSymbol  = input.symbol("SP:SPX",  "Benchmark (S&P 500)", confirm=true, group=grpMain)
useLog       = input.bool(false,  "Use log ratio (ln(asset/benchmark))", group=grpMain)
normalize100 = input.bool(true,   "Normalize to 100 at lookback start",  group=grpMain)
normLookback = input.int(200,     "Normalization lookback (bars)", minval=20, group=grpMain)
useSPYFallback = input.bool(false,"Fallback to SPY (if SPX unavailable)", group=grpMain)

grpSmooth = "📈 Smoothing"
smoothType = input.string("EMA", "Smoothing type", options=["None","SMA","EMA","RMA","WMA"], group=grpSmooth)
smoothLen  = input.int(20, "Smoothing length", minval=1, group=grpSmooth)
showRaw    = input.bool(false, "Show raw RS (faint)", group=grpSmooth)

grpViz = "🎨 Visuel"
colorBySlope  = input.bool(true,  "Color by slope (up=green, down=red)", group=grpViz)
showZeroLine  = input.bool(true,  "Show baseline",        group=grpViz)
showFill      = input.bool(true,  "Fill above/below baseline", group=grpViz)
showBands     = input.bool(true,  "Show Bollinger Bands on RS", group=grpViz)
bandLen       = input.int(20,     "BB Length", minval=5,  group=grpViz)
bandMult      = input.float(2.0,  "BB Multiplier", minval=0.5, step=0.1, group=grpViz)

grpDiv = "📐 Divergences"
showDiv    = input.bool(true, "Afficher divergences RS vs Prix", group=grpDiv)
pivotLen   = input.int(5,    "Pivot length", minval=2, group=grpDiv)
minBarsGap = input.int(5,    "Min bars entre pivots",  minval=0, group=grpDiv)
showDivLines = input.bool(true, "Tracer lignes de divergence", group=grpDiv)

grpAlert = "🔔 Alertes"
alertCross = input.bool(true, "Alerte croisement baseline", group=grpAlert)
alertSlope = input.bool(true, "Alerte changement de slope", group=grpAlert)
alertDiv   = input.bool(true, "Alerte divergences",         group=grpAlert)
alertExtreme = input.bool(true, "Alerte zones extrêmes (BB)", group=grpAlert)

//==============================
// DATA
//==============================
benchResolved = useSPYFallback ? "AMEX:SPY" : benchSymbol
assetClose    = close
benchClose    = request.security(benchResolved, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
valid         = not na(benchClose) and benchClose != 0.0

//==============================
// RELATIVE STRENGTH
//==============================
rsRaw  = valid ? (assetClose / benchClose) : na
rs     = useLog ? (valid ? math.log(rsRaw) : na) : rsRaw

rsNorm = rs
if normalize100
    base = rs[normLookback]
    rsNorm := not na(base) and base != 0.0 ? (rs / base) * 100.0 : na

//==============================
// SMOOTHING
//==============================
smooth(src, len, typ) =>
    switch typ
        "SMA" => ta.sma(src, len)
        "EMA" => ta.ema(src, len)
        "RMA" => ta.rma(src, len)
        "WMA" => ta.wma(src, len)
        => src

rsSm = smoothType == "None" ? rsNorm : smooth(rsNorm, smoothLen, smoothType)

//==============================
// BASELINE
//==============================
baseline = normalize100 ? 100.0 : (useLog ? 0.0 : 1.0)

//==============================
// BOLLINGER BANDS sur le RS
//==============================
bbMid   = ta.sma(rsSm, bandLen)
bbStd   = ta.stdev(rsSm, bandLen)
bbUpper = bbMid + bandMult * bbStd
bbLower = bbMid - bandMult * bbStd

// RS en zone extrême (touche les bandes)
rsOverbought  = rsSm >= bbUpper
rsOversold    = rsSm <= bbLower

//==============================
// RS MOMENTUM — vitesse de changement
//==============================
rsMomentum = rsSm - rsSm[smoothLen]  // variation sur N barres

//==============================
// PLOTS
//==============================
slopeUp    = rsSm > rsSm[1]
plotColor  = colorBySlope ? (slopeUp ? color.new(#00e5ff, 0) : color.new(#ff1744, 0)) : color.new(color.blue, 0)

// Ligne RS principale
rsPlot       = plot(rsSm,    "RS (smoothed)", color=plotColor, linewidth=2)
baselinePlot = plot(showZeroLine ? baseline : na, "Baseline", color=color.new(color.white, 60), linewidth=1, style=plot.style_line)

// Fill au-dessus / en-dessous de la baseline
fill(rsPlot, baselinePlot,
     color = showFill ? (rsSm > baseline ? color.new(#00e5ff, 88) : color.new(#ff1744, 88)) : na,
     title = "Fill RS vs Baseline")

// Raw RS (faint)
plot(showRaw ? rsNorm : na, "RS (raw)", color=color.new(color.blue, 75), linewidth=1)

// Bollinger Bands
bbUpPlot  = plot(showBands ? bbUpper : na, "BB Upper", color=color.new(color.orange, 50), linewidth=1, style=plot.style_line)
bbLowPlot = plot(showBands ? bbLower : na, "BB Lower", color=color.new(color.orange, 50), linewidth=1, style=plot.style_line)
bbMidPlot = plot(showBands ? bbMid   : na, "BB Mid",   color=color.new(color.orange, 75), linewidth=1, style=plot.style_line)

fill(bbUpPlot, bbLowPlot,
     color = showBands ? color.new(color.orange, 93) : na,
     title = "BB Fill")

// Momentum histogramme
plot(rsMomentum, "RS Momentum", style=plot.style_columns,
     color = rsMomentum >= 0 ? color.new(#00e5ff, 60) : color.new(#ff1744, 60))

// Signaux extrêmes
plotshape(rsOverbought and showBands, "RS Overbought", style=shape.triangledown,
     location=location.top,    color=color.new(#ff1744, 0), size=size.tiny)
plotshape(rsOversold   and showBands, "RS Oversold",   style=shape.triangleup,
     location=location.bottom, color=color.new(#00e5ff, 0), size=size.tiny)

//==============================
// DIVERGENCES RS vs PRIX
//==============================
phPrice = ta.pivothigh(high,  pivotLen, pivotLen)
plPrice = ta.pivotlow(low,    pivotLen, pivotLen)
phRs    = ta.pivothigh(rsSm,  pivotLen, pivotLen)
plRs    = ta.pivotlow(rsSm,   pivotLen, pivotLen)

var float lastPH_price = na
var int   lastPH_bar   = na
var float lastPH_rs    = na

var float lastPL_price = na
var int   lastPL_bar   = na
var float lastPL_rs    = na

// Bearish : prix HH mais RS LH → l'actif surperforme moins → signe de faiblesse
if showDiv and not na(phPrice) and not na(phRs)
    curBar      = bar_index - pivotLen
    curPH_price = phPrice
    curPH_rs    = phRs
    if not na(lastPH_price) and (curBar - lastPH_bar >= minBarsGap)
        if curPH_price > lastPH_price and curPH_rs < lastPH_rs
            label.new(curBar, rsSm, "🔴 RS Bear",
                 style=label.style_label_down,
                 color=color.new(#ff1744, 15),
                 textcolor=color.white, size=size.small)
            if showDivLines
                line.new(lastPH_bar, lastPH_rs, curBar, curPH_rs,
                     color=#ff1744, width=2, style=line.style_dashed)
            if alertDiv
                alert("🔴 Divergence BEARISH RS vs Prix — affaiblissement relatif", alert.freq_once_per_bar)
    lastPH_price := curPH_price
    lastPH_rs    := curPH_rs
    lastPH_bar   := curBar

// Bullish : prix LL mais RS HL → l'actif résiste mieux → signe de force
if showDiv and not na(plPrice) and not na(plRs)
    curBar      = bar_index - pivotLen
    curPL_price = plPrice
    curPL_rs    = plRs
    if not na(lastPL_price) and (curBar - lastPL_bar >= minBarsGap)
        if curPL_price < lastPL_price and curPL_rs > lastPL_rs
            label.new(curBar, rsSm, "🟢 RS Bull",
                 style=label.style_label_up,
                 color=color.new(#00e5ff, 15),
                 textcolor=color.white, size=size.small)
            if showDivLines
                line.new(lastPL_bar, lastPL_rs, curBar, curPL_rs,
                     color=#00e5ff, width=2, style=line.style_dashed)
            if alertDiv
                alert("🟢 Divergence BULLISH RS vs Prix — force relative cachée", alert.freq_once_per_bar)
    lastPL_price := curPL_price
    lastPL_rs    := curPL_rs
    lastPL_bar   := curBar

//==============================
// ALERTES
//==============================
bullCross    = ta.crossover(rsSm, baseline)
bearCross    = ta.crossunder(rsSm, baseline)
slopeUpCross = ta.crossover(rsSm - rsSm[1], 0)
slopeDnCross = ta.crossunder(rsSm - rsSm[1], 0)

alertcondition(bullCross,    "RS Bullish Cross",   "RS crossed ABOVE baseline — outperforming S&P 500")
alertcondition(bearCross,    "RS Bearish Cross",   "RS crossed BELOW baseline — underperforming S&P 500")
alertcondition(slopeUpCross, "RS Slope Turns Up",  "RS slope turned UP")
alertcondition(slopeDnCross, "RS Slope Turns Down","RS slope turned DOWN")

if alertCross and bullCross
    alert("🟢 RS croise la baseline vers le HAUT — surperformance vs S&P 500", alert.freq_once_per_bar)
if alertCross and bearCross
    alert("🔴 RS croise la baseline vers le BAS — sous-performance vs S&P 500", alert.freq_once_per_bar)
if alertExtreme and rsOverbought
    alert("⚠️ RS en zone extrême HAUTE (BB Upper) — surperformance excessive", alert.freq_once_per_bar)
if alertExtreme and rsOversold
    alert("⚠️ RS en zone extrême BASSE (BB Lower) — sous-performance excessive", alert.freq_once_per_bar)

//==============================
// TABLE INFO
//==============================
var table infoTable = table.new(position.bottom_right, 2, 5,
     bgcolor=color.new(color.black, 60), border_width=1)

if barstate.islast
    rsState   = rsSm > baseline ? "🟢 Surperformance" : "🔴 Sous-performance"
    rsZone    = rsOverbought ? "⚠️ Extrême haut" : rsOversold ? "⚠️ Extrême bas" : "✅ Zone normale"
    trendStr  = slopeUp ? "↑ Hausse" : "↓ Baisse"
    rsVal     = str.tostring(math.round(rsSm * 100) / 100)

    table.cell(infoTable, 0, 0, "État RS",    text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, rsState,      text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 1, "Tendance",   text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, trendStr,     text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 2, "Zone BB",    text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, rsZone,       text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 3, "Valeur RS",  text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, rsVal,        text_color=color.new(color.white, 30), text_size=size.small)
    table.cell(infoTable, 0, 4, "Benchmark",  text_color=color.new(color.white, 50), text_size=size.tiny)
    table.cell(infoTable, 1, 4, benchResolved,text_color=color.new(color.white, 50), text_size=size.tiny)
