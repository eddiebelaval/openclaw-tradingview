//@version=5
indicator("Auto Trendline", overlay=true)

// Inputs
lookbackRight = input.int(5, "Lookback Right (Strength)", minval=1)
lookbackLeft = input.int(10, "Lookback Left", minval=1)
lineColorUp = input.color(color.green, "Bullish Trendline")
lineColorDown = input.color(color.red, "Bearish Trendline")

// Pivot Highs and Lows find karna
pHi = ta.pivothigh(high, lookbackLeft, lookbackRight)
pLo = ta.pivotlow(low, lookbackLeft, lookbackRight)

// Trendline logic for Resistance (Highs)
var line trendHigh = na
if not na(pHi)
    line.delete(trendHigh) // Purani temporary line hatane ke liye
    trendHigh := line.new(bar_index[lookbackRight], pHi, bar_index, pHi, extend=extend.right, color=lineColorDown, width=2)

// Trendline logic for Support (Lows)
var line trendLow = na
if not na(pLo)
    line.delete(trendLow)
    trendLow := line.new(bar_index[lookbackRight], pLo, bar_index, pLo, extend=extend.right, color=lineColorUp, width=2)

// Breakout Alerts (Basic)
plotshape(ta.crossover(close, line.get_y2(trendHigh)), "Bullish Breakout", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(ta.crossunder(close, line.get_y2(trendLow)), "Bearish Breakout", shape.triangledown, location.abovebar, color.red, size=size.small)
