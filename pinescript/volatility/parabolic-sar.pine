//@version=5
indicator("Parabolic SAR (连线版)", overlay=true)

// --- 输入参数 (对应 TOS 截图) ---
af      = input.float(0.02, "acceleration factor (步进)")
afLimit = input.float(0.2, "acceleration limit (上限)")

// --- 核心计算 ---
psar = ta.sar(af, af, afLimit)

// --- 绘图 ---
// 1. 定义颜色逻辑：收盘价在 PSAR 上方为绿色，下方为红色
psarColor = close > psar ? color.green : color.red

// 2. 将 style 改为 plot.style_line (线形)
// 使用 linewidth=2 让线条更清晰
plot(psar, "Parabolic SAR Line", style=plot.style_line, color=psarColor, linewidth=2)
