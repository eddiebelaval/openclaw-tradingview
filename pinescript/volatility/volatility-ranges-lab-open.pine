            wlbL150 := updateLabel(wlbL150, l150, buildLabelText(aWRRange, name_AWR + " -150%", l150, final_ref_W), awrColorIntermediate, awrColorIntermediate, awrDeslocamentoDireita)
        h175 = h + (week_adr * 0.75), l175 = l - (week_adr * 0.75)
        var line wlH175=line(na), var line wlL175=line(na)
        var label wlbH175=label(na), var label wlbL175=label(na)
        wlH175 := updateLine(wlH175, final_draw_idx_W, h175, awrColorIntermediate, s_awr, awrWidthIntermediate, awrDeslocamentoDireita)
        wlL175 := updateLine(wlL175, final_draw_idx_W, l175, awrColorIntermediate, s_awr, awrWidthIntermediate, awrDeslocamentoDireita)
        if showAWRLabels
            wlbH175 := updateLabel(wlbH175, h175, buildLabelText(aWRRange, name_AWR + " +175%", h175, final_ref_W), awrColorIntermediate, awrColorIntermediate, awrDeslocamentoDireita)
            wlbL175 := updateLabel(wlbL175, l175, buildLabelText(aWRRange, name_AWR + " -175%", l175, final_ref_W), awrColorIntermediate, awrColorIntermediate, awrDeslocamentoDireita)
        h200 = h + week_adr, l200 = l - week_adr
        var line wlH200=line(na), var line wlL200=line(na)
        var label wlbH200=label(na), var label wlbL200=label(na)
        wlH200 := updateLine(wlH200, final_draw_idx_W, h200, awrColorHigh, s_awr, awrWidth, awrDeslocamentoDireita)
        wlL200 := updateLine(wlL200, final_draw_idx_W, l200, awrColorLow, s_awr, awrWidth, awrDeslocamentoDireita)
        if showAWRLabels
            wlbH200 := updateLabel(wlbH200, h200, buildLabelText(aWRRange, name_AWR + " +200%", h200, final_ref_W), awrColorHigh, awrColorHigh, awrDeslocamentoDireita)
            wlbL200 := updateLabel(wlbL200, l200, buildLabelText(aWRRange, name_AWR + " -200%", l200, final_ref_W), awrColorLow, awrColorLow, awrDeslocamentoDireita)

// --- PROCESSAMENTO AMR (MENSAL) ---
month_adr = request.security(syminfo.tickerid, "M", adr(aMRRange, 1), lookahead=barmerge.lookahead_on)

if showAMR and not na(month_adr)
    h = adr_high_calc(final_ref_M, month_adr)
    l = adr_low_calc(final_ref_M, month_adr)
    var line mlH=line(na), var line mlL=line(na), var line ml0=line(na)
    var label mlbH=label(na), var label mlbL=label(na), var label mlb0=label(na)
    mlH := updateLine(mlH, final_draw_idx_M, h, amrColorHigh, s_amr, amrWidth, amrDeslocamentoDireita)
    mlL := updateLine(mlL, final_draw_idx_M, l, amrColorLow, s_amr, amrWidth, amrDeslocamentoDireita)
    if showAMR_0
        ml0 := updateLine(ml0, final_draw_idx_M, final_ref_M, amrColor0, s0_amr, amr0Width, amrDeslocamentoDireita)
    if showAMRLabels
        mlbH := updateLabel(mlbH, h, buildLabelText(aMRRange, name_AMR + " +100%", h, final_ref_M), amrColorHigh, amrColorHigh, amrDeslocamentoDireita)
        mlbL := updateLabel(mlbL, l, buildLabelText(aMRRange, name_AMR + " -100%", l, final_ref_M), amrColorLow, amrColorLow, amrDeslocamentoDireita)
        if showAMR_0
            mlb0 := updateLabel(mlb0, final_ref_M, buildLabelText(aMRRange, name_AMR + " 0%", final_ref_M, final_ref_M), amrColor0, amrColor0, amrDeslocamentoDireita)
    if showAMR_Thirds
        h33 = h - (month_adr * 0.6666), l33 = l + (month_adr * 0.6666)
        h66 = h - (month_adr * 0.3333), l66 = l + (month_adr * 0.3333)
        var line mlH33=line(na), var line mlL33=line(na), var line mlH66=line(na), var line mlL66=line(na)
        var label mlbH33=label(na), var label mlbL33=label(na), var label mlbH66=label(na), var label mlbL66=label(na)
        mlH33 := updateLine(mlH33, final_draw_idx_M, h33, amrColorThirds, s_amr, amrWidthIntermediate, amrDeslocamentoDireita)
        mlL33 := updateLine(mlL33, final_draw_idx_M, l33, amrColorThirds, s_amr, amrWidthIntermediate, amrDeslocamentoDireita)
        mlH66 := updateLine(mlH66, final_draw_idx_M, h66, amrColorThirds, s_amr, amrWidthIntermediate, amrDeslocamentoDireita)
        mlL66 := updateLine(mlL66, final_draw_idx_M, l66, amrColorThirds, s_amr, amrWidthIntermediate, amrDeslocamentoDireita)
        if showAMRLabels
            mlbH33 := updateLabel(mlbH33, h33, buildLabelText(aMRRange, name_AMR + " +33.3%", h33, final_ref_M), amrColorThirds, amrColorThirds, amrDeslocamentoDireita)
            mlbL33 := updateLabel(mlbL33, l33, buildLabelText(aMRRange, name_AMR + " -33.3%", l33, final_ref_M), amrColorThirds, amrColorThirds, amrDeslocamentoDireita)
            mlbH66 := updateLabel(mlbH66, h66, buildLabelText(aMRRange, name_AMR + " +66.6%", h66, final_ref_M), amrColorThirds, amrColorThirds, amrDeslocamentoDireita)
            mlbL66 := updateLabel(mlbL66, l66, buildLabelText(aMRRange, name_AMR + " -66.6%", l66, final_ref_M), amrColorThirds, amrColorThirds, amrDeslocamentoDireita)
    if showAMR_25
        h25 = h - (month_adr * 0.75), l25 = l + (month_adr * 0.75)
        var line mlH25=line(na), var line mlL25=line(na)
        var label mlbH25=label(na), var label mlbL25=label(na)
        mlH25 := updateLine(mlH25, final_draw_idx_M, h25, amrColorIntermediate, s_amr, amrWidthIntermediate, amrDeslocamentoDireita)
        mlL25 := updateLine(mlL25, final_draw_idx_M, l25, amrColorIntermediate, s_amr, amrWidthIntermediate, amrDeslocamentoDireita)
        if showAMRLabels
            mlbH25 := updateLabel(mlbH25, h25, buildLabelText(aMRRange, name_AMR + " +25%", h25, final_ref_M), amrColorIntermediate, amrColorIntermediate, amrDeslocamentoDireita)
            mlbL25 := updateLabel(mlbL25, l25, buildLabelText(aMRRange, name_AMR + " -25%", l25, final_ref_M), amrColorIntermediate, amrColorIntermediate, amrDeslocamentoDireita)
    if showAMR_50
        h50 = h - (month_adr * 0.50), l50 = l + (month_adr * 0.50)
        var line mlH50=line(na), var line mlL50=line(na)
        var label mlbH50=label(na), var label mlbL50=label(na)
        mlH50 := updateLine(mlH50, final_draw_idx_M, h50, amrColorIntermediate, s_amr, amrWidthIntermediate, amrDeslocamentoDireita)
        mlL50 := updateLine(mlL50, final_draw_idx_M, l50, amrColorIntermediate, s_amr, amrWidthIntermediate, amrDeslocamentoDireita)
        if showAMRLabels
            mlbH50 := updateLabel(mlbH50, h50, buildLabelText(aMRRange, name_AMR + " +50%", h50, final_ref_M), amrColorIntermediate, amrColorIntermediate, amrDeslocamentoDireita)
            mlbL50 := updateLabel(mlbL50, l50, buildLabelText(aMRRange, name_AMR + " -50%", l50, final_ref_M), amrColorIntermediate, amrColorIntermediate, amrDeslocamentoDireita)
    if showAMR_75
        h75 = h - (month_adr * 0.25), l75 = l + (month_adr * 0.25)
        var line mlH75=line(na), var line mlL75=line(na)
        var label mlbH75=label(na), var label mlbL75=label(na)
        mlH75 := updateLine(mlH75, final_draw_idx_M, h75, amrColorIntermediate, s_amr, amrWidthIntermediate, amrDeslocamentoDireita)
        mlL75 := updateLine(mlL75, final_draw_idx_M, l75, amrColorIntermediate, s_amr, amrWidthIntermediate, amrDeslocamentoDireita)
        if showAMRLabels
            mlbH75 := updateLabel(mlbH75, h75, buildLabelText(aMRRange, name_AMR + " +75%", h75, final_ref_M), amrColorIntermediate, amrColorIntermediate, amrDeslocamentoDireita)
            mlbL75 := updateLabel(mlbL75, l75, buildLabelText(aMRRange, name_AMR + " -75%", l75, final_ref_M), amrColorIntermediate, amrColorIntermediate, amrDeslocamentoDireita)
    if showAMR_Expanded
        h125 = h + (month_adr * 0.25), l125 = l - (month_adr * 0.25)
        var line mlH125=line(na), var line mlL125=line(na)
        var label mlbH125=label(na), var label mlbL125=label(na)
        mlH125 := updateLine(mlH125, final_draw_idx_M, h125, amrColorIntermediate, s_amr, amrWidthIntermediate, amrDeslocamentoDireita)
        mlL125 := updateLine(mlL125, final_draw_idx_M, l125, amrColorIntermediate, s_amr, amrWidthIntermediate, amrDeslocamentoDireita)
        if showAMRLabels
            mlbH125 := updateLabel(mlbH125, h125, buildLabelText(aMRRange, name_AMR + " +125%", h125, final_ref_M), amrColorIntermediate, amrColorIntermediate, amrDeslocamentoDireita)
            mlbL125 := updateLabel(mlbL125, l125, buildLabelText(aMRRange, name_AMR + " -125%", l125, final_ref_M), amrColorIntermediate, amrColorIntermediate, amrDeslocamentoDireita)
        h150 = h + (month_adr * 0.50), l150 = l - (month_adr * 0.50)
        var line mlH150=line(na), var line mlL150=line(na)
        var label mlbH150=label(na), var label mlbL150=label(na)
        mlH150 := updateLine(mlH150, final_draw_idx_M, h150, amrColorIntermediate, s_amr, amrWidthIntermediate, amrDeslocamentoDireita)
        mlL150 := updateLine(mlL150, final_draw_idx_M, l150, amrColorIntermediate, s_amr, amrWidthIntermediate, amrDeslocamentoDireita)
        if showAMRLabels
            mlbH150 := updateLabel(mlbH150, h150, buildLabelText(aMRRange, name_AMR + " +150%", h150, final_ref_M), amrColorIntermediate, amrColorIntermediate, amrDeslocamentoDireita)
            mlbL150 := updateLabel(mlbL150, l150, buildLabelText(aMRRange, name_AMR + " -150%", l150, final_ref_M), amrColorIntermediate, amrColorIntermediate, amrDeslocamentoDireita)
        h175 = h + (month_adr * 0.75), l175 = l - (month_adr * 0.75)
        var line mlH175=line(na), var line mlL175=line(na)
        var label mlbH175=label(na), var label mlbL175=label(na)
        mlH175 := updateLine(mlH175, final_draw_idx_M, h175, amrColorIntermediate, s_amr, amrWidthIntermediate, amrDeslocamentoDireita)
        mlL175 := updateLine(mlL175, final_draw_idx_M, l175, amrColorIntermediate, s_amr, amrWidthIntermediate, amrDeslocamentoDireita)
        if showAMRLabels
            mlbH175 := updateLabel(mlbH175, h175, buildLabelText(aMRRange, name_AMR + " +175%", h175, final_ref_M), amrColorIntermediate, amrColorIntermediate, amrDeslocamentoDireita)
            mlbL175 := updateLabel(mlbL175, l175, buildLabelText(aMRRange, name_AMR + " -175%", l175, final_ref_M), amrColorIntermediate, amrColorIntermediate, amrDeslocamentoDireita)
        h200 = h + month_adr, l200 = l - month_adr
        var line mlH200=line(na), var line mlL200=line(na)
        var label mlbH200=label(na), var label mlbL200=label(na)
        mlH200 := updateLine(mlH200, final_draw_idx_M, h200, amrColorHigh, s_amr, amrWidth, amrDeslocamentoDireita)
        mlL200 := updateLine(mlL200, final_draw_idx_M, l200, amrColorLow, s_amr, amrWidth, amrDeslocamentoDireita)
        if showAMRLabels
            mlbH200 := updateLabel(mlbH200, h200, buildLabelText(aMRRange, name_AMR + " +200%", h200, final_ref_M), amrColorHigh, amrColorHigh, amrDeslocamentoDireita)
            mlbL200 := updateLabel(mlbL200, l200, buildLabelText(aMRRange, name_AMR + " -200%", l200, final_ref_M), amrColorLow, amrColorLow, amrDeslocamentoDireita)

// ----------------------------------------------------------------------
// 7. DASHBOARD (CÓDIGO #47)
// ----------------------------------------------------------------------
if showDashboard
    [d_high, d_low, d_close, d_open] = request.security(syminfo.tickerid, "D", [high, low, close, open], lookahead=barmerge.lookahead_on)
    float current_day_range = d_high - d_low
    float day_percent_used = day_adr > 0 ? (current_day_range / day_adr) * 100 : 0
    string day_falta_str = getFaltaStr(day_adr, current_day_range, d_close, d_open)
    color day_falta_col = getFaltaColor(day_adr, current_day_range, d_close, d_open)
    float day_pos_pct = day_adr > 0 ? ((d_close - final_ref_D) / day_adr) * 100 : 0
    string day_pos_str = (day_pos_pct > 0 ? "+" : "") + str.tostring(day_pos_pct, "#") + "%"
    color day_pos_col = getPosColor(day_pos_pct)
    
    [w_high, w_low, w_close, w_open] = request.security(syminfo.tickerid, "W", [high, low, close, open], lookahead=barmerge.lookahead_on)
    float current_week_range = w_high - w_low
    float week_percent_used = week_adr > 0 ? (current_week_range / week_adr) * 100 : 0
    string week_falta_str = getFaltaStr(week_adr, current_week_range, w_close, w_open)
    color week_falta_col = getFaltaColor(week_adr, current_week_range, w_close, w_open)
    float week_pos_pct = week_adr > 0 ? ((w_close - final_ref_W) / week_adr) * 100 : 0
    string week_pos_str = (week_pos_pct > 0 ? "+" : "") + str.tostring(week_pos_pct, "#") + "%"
    color week_pos_col = getPosColor(week_pos_pct)
    
    [m_high, m_low, m_close, m_open] = request.security(syminfo.tickerid, "M", [high, low, close, open], lookahead=barmerge.lookahead_on)
    float current_month_range = m_high - m_low
    float month_percent_used = month_adr > 0 ? (current_month_range / month_adr) * 100 : 0
    string month_falta_str = getFaltaStr(month_adr, current_month_range, m_close, m_open)
    color month_falta_col = getFaltaColor(month_adr, current_month_range, m_close, m_open)
    float month_pos_pct = month_adr > 0 ? ((m_close - final_ref_M) / month_adr) * 100 : 0
    string month_pos_str = (month_pos_pct > 0 ? "+" : "") + str.tostring(month_pos_pct, "#") + "%"
    color month_pos_col = getPosColor(month_pos_pct)

    tablePos = getTablePos()
    var table dash = table.new(tablePos, 6, 4, border_width=1, border_color=color.new(color.gray, 80))
    
    tableSize = getTableSize()
    
    color bgColor = na
    color headerBgColor = na
    color txtColor = na
    color headerTxtColor = na

    if dashBgTheme == "Escuro (Padrão)"
        bgColor := color.new(color.black, 100) 
        headerBgColor := color.new(color.gray, 90)
        txtColor := color.white
        headerTxtColor := color.gray
    else
        bgColor := color.new(color.white, 100)
        headerBgColor := color.new(color.gray, 90)
        txtColor := color.black
        headerTxtColor := color.gray

    // Headers
    table.cell(dash, 0, 0, "Período", bgcolor=headerBgColor, text_color=headerTxtColor, text_size=tableSize)
    table.cell(dash, 1, 0, "Média", bgcolor=headerBgColor, text_color=headerTxtColor, text_size=tableSize)
    table.cell(dash, 2, 0, "Andou", bgcolor=headerBgColor, text_color=headerTxtColor, text_size=tableSize)
    table.cell(dash, 3, 0, "% Uso", bgcolor=headerBgColor, text_color=headerTxtColor, text_size=tableSize)
    table.cell(dash, 4, 0, "Posição", bgcolor=headerBgColor, text_color=headerTxtColor, text_size=tableSize)
    table.cell(dash, 5, 0, "Falta", bgcolor=headerBgColor, text_color=headerTxtColor, text_size=tableSize)

    // Diario
    colDayText = getColorText(day_percent_used, d_close, d_open)
    iconDay = getStatusIcon(day_percent_used, d_close, d_open)
    dirDay = getDirIcon(d_close, d_open)
    txtDay = name_ADR + " (" + str.tostring(aDRRange) + ")"
    
    table.cell(dash, 0, 1, txtDay, bgcolor=bgColor, text_color=txtColor, text_size=tableSize)
    table.cell(dash, 1, 1, formatPoints(day_adr), bgcolor=bgColor, text_color=txtColor, text_size=tableSize)
    table.cell(dash, 2, 1, dirDay + " " + formatPoints(current_day_range), bgcolor=bgColor, text_color=colDayText, text_size=tableSize)
    table.cell(dash, 3, 1, iconDay + " " + str.tostring(day_percent_used, "#") + "%", bgcolor=bgColor, text_color=colDayText, text_size=tableSize)
    table.cell(dash, 4, 1, day_pos_str, bgcolor=bgColor, text_color=day_pos_col, text_size=tableSize)
    table.cell(dash, 5, 1, day_falta_str, bgcolor=bgColor, text_color=day_falta_col, text_size=tableSize)

    // Semanal
    colWeekText = getColorText(week_percent_used, w_close, w_open)
    iconWeek = getStatusIcon(week_percent_used, w_close, w_open)
    dirWeek = getDirIcon(w_close, w_open)
    txtWeek = name_AWR + " (" + str.tostring(aWRRange) + ")"

    table.cell(dash, 0, 2, txtWeek, bgcolor=bgColor, text_color=txtColor, text_size=tableSize)
    table.cell(dash, 1, 2, formatPoints(week_adr), bgcolor=bgColor, text_color=txtColor, text_size=tableSize)
    table.cell(dash, 2, 2, dirWeek + " " + formatPoints(current_week_range), bgcolor=bgColor, text_color=colWeekText, text_size=tableSize)
    table.cell(dash, 3, 2, iconWeek + " " + str.tostring(week_percent_used, "#") + "%", bgcolor=bgColor, text_color=colWeekText, text_size=tableSize)
    table.cell(dash, 4, 2, week_pos_str, bgcolor=bgColor, text_color=week_pos_col, text_size=tableSize)
    table.cell(dash, 5, 2, week_falta_str, bgcolor=bgColor, text_color=week_falta_col, text_size=tableSize)

    // Mensal
    colMonthText = getColorText(month_percent_used, m_close, m_open)
    iconMonth = getStatusIcon(month_percent_used, m_close, m_open)
    dirMonth = getDirIcon(m_close, m_open)
    txtMonth = name_AMR + " (" + str.tostring(aMRRange) + ")"

    table.cell(dash, 0, 3, txtMonth, bgcolor=bgColor, text_color=txtColor, text_size=tableSize)
    table.cell(dash, 1, 3, formatPoints(month_adr), bgcolor=bgColor, text_color=txtColor, text_size=tableSize)
    table.cell(dash, 2, 3, dirMonth + " " + formatPoints(current_month_range), bgcolor=bgColor, text_color=colMonthText, text_size=tableSize)
    table.cell(dash, 3, 3, iconMonth + " " + str.tostring(month_percent_used, "#") + "%", bgcolor=bgColor, text_color=colMonthText, text_size=tableSize)
    table.cell(dash, 4, 3, month_pos_str, bgcolor=bgColor, text_color=month_pos_col, text_size=tableSize)
    table.cell(dash, 5, 3, month_falta_str, bgcolor=bgColor, text_color=month_falta_col, text_size=tableSize)
