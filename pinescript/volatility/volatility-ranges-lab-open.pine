//@version=6
// CÓDIGO #47 - Volatility Ranges LAB
indicator("Volatility Ranges LAB [Open]", shorttitle="VR LAB", overlay=true, max_lines_count=500, max_labels_count=500)

// ----------------------------------------------------------------------
// 1. DEFINIÇÃO DOS GRUPOS
// ----------------------------------------------------------------------

g_labels    = "══════════════ 0. RÓTULOS (CUSTOMIZAÇÃO) ══════════════"
g_geral     = "══════════════ 1. GERAL ══════════════"
g_adr_calc  = "════════ 2.1 ADR (DIÁRIO) - CÁLCULO ════════"
g_adr_style = "════════ 2.2 ADR (DIÁRIO) - ESTILO ════════"
g_awr_calc  = "════════ 3.1 AWR (SEMANAL) - CÁLCULO ════════"
g_awr_style = "════════ 3.2 AWR (SEMANAL) - ESTILO ════════"
g_amr_calc  = "════════ 4.1 AMR (MENSAL) - CÁLCULO ════════"
g_amr_style = "════════ 4.2 AMR (MENSAL) - ESTILO ════════"
g_dash      = "══════════════ 5. DASHBOARD ══════════════"

// ----------------------------------------------------------------------
// 2. INPUTS
// ----------------------------------------------------------------------

// --- 0. RÓTULOS ---
lblSize      = input.string("Pequeno", "Tamanho do Texto (Rótulos)", options=["Minúsculo", "Pequeno", "Normal", "Grande"], group=g_labels, tooltip="Tamanho é documento? Aqui sim.\n• Minúsculo: Para quem tem visão de águia ou monitor 4K.\n• Pequeno: O equilíbrio perfeito.\n• Grande: Para quem opera da cozinha.")
showL_Period = input.bool(true, "Mostrar Período (ex: 14)", group=g_labels, tooltip="Mostra o número de períodos usados na média.")
showL_Name   = input.bool(true, "Mostrar Nome (ex: ADR +100%)", group=g_labels, tooltip="Identifica a linha. Essencial para não confundir os níveis.")
showL_Price  = input.bool(false, "Mostrar Preço (ex: 1.1250)", group=g_labels, tooltip="Mostra a cotação exata da linha. Essencial para pendurar ordens (Limit Orders).")
showL_Perc   = input.bool(false, "Mostrar Variação Real % (ex: +0.55%)", group=g_labels, tooltip="Calcula a % exata da Abertura até o nível.")

// --- 1. GERAL ---
escalaGrafico = input.string("Linear", "Escala do Gráfico", options=["Linear", "Logarítmica"], group=g_geral, tooltip="A Geometria do Gráfico:\n• Linear: Padrão para Forex e Índices (Pontos fixos).\n• Logarítmica: Obrigatório para Criptos ou ativos com movimentos exponenciais.")
metodoCalc    = input.string("SMA (Média Simples)", "Método de Cálculo da Média", options=["SMA (Média Simples)", "RMA (Wilder/ATR)"], group=g_geral, tooltip="O Motor Matemático:\n• SMA: Média Aritmética. Rápida e reativa. Padrão ADR.\n• RMA: Média Suavizada (Wilder). Mais lenta e estável. Padrão ATR.")

// --- 2. ADR (DIÁRIO) ---
showADR       = input.bool(false, "Ativar ADR", group=g_adr_calc, tooltip="O GPS do Intraday.")
adrRefMode    = input.string("Atual", "Período de Referência", options=["Atual", "Anterior"], group=g_adr_calc, tooltip="Viaje no Tempo:\n• Atual: Linha nasce na abertura de HOJE.\n• Anterior: Linha nasce na abertura de ONTEM (vê a continuidade).")
aDRRange      = input.int(5, "Período Média (dias)", minval=1, maxval=31, group=g_adr_calc, tooltip="Memória do Mercado:\n• 5 dias: Scalping/Semanal.\n• 14 dias: Padrão.\n• 22 dias: Mensal.")
usarNYOpen    = input.bool(true, "Usar NY Midnight Open (00:00 NY)", group=g_adr_calc, tooltip="Sincroniza com o dia bancário americano (IPDA).")
adrDeslocamentoDireita = input.int(20, "Projeção Futura (Barras)", minval=0, maxval=500, group=g_adr_calc, tooltip="Empurra as linhas para a direita.")
showADR_Expanded = input.bool(false, "Mostrar Expansões (125% - 200%)", group=g_adr_calc, tooltip="Zonas de exaustão intraday.")

// ADR Estilo (LARANJA #fb923c)
showADRLabels = input.bool(true, "Exibir Legendas (ON/OFF)", group=g_adr_style, tooltip="Interruptor geral das legendas do Diário.")
adrColorHigh  = input.color(color.new(#fb923c, 0), "Cor Máxima +100% ADR", group=g_adr_style, tooltip="Teto do Dia (Laranja).")
adrColorLow   = input.color(color.new(#fb923c, 0), "Cor Mínima -100% ADR", group=g_adr_style, tooltip="Piso do Dia (Laranja).")
adrColorIntermediate = input.color(color.new(#ff9800, 50), "Cor Níveis (25%, 50%, 75%)", group=g_adr_style, tooltip="Níveis parciais de volatilidade.")
adrColorThirds = input.color(color.new(#9C27B0, 30), "Cor Terços (33%, 66%)", group=g_adr_style, tooltip="Níveis de Geometria/Terços.")
adrColor0     = input.color(color.new(#ff9800, 30), "Cor Abertura (Nível 0%)", group=g_adr_style, tooltip="Abertura do Dia (Marco Zero).")

adrWidth      = input.int(1, "Espessura Máx/Mín (±100%)", minval=1, maxval=5, group=g_adr_style, tooltip="Espessura das linhas principais.")
adrWidthIntermediate = input.int(1, "Espessura Intermediária/Terços", minval=1, maxval=3, group=g_adr_style, tooltip="Espessura das linhas internas.")
adr0Width     = input.int(1, "Espessura Linha 0%", minval=1, maxval=3, group=g_adr_style, tooltip="Espessura da linha de abertura.")

adrStyleX     = input.string("Pontilhada", "Estilo Linha", options=["Sólida", "Tracejada", "Pontilhada"], group=g_adr_style)
adr0StyleX    = input.string("Tracejada", "Estilo Linha 0%", options=["Sólida", "Tracejada", "Pontilhada"], group=g_adr_style)

showADR_0     = input.bool(true, "Mostrar Linha Zero (Abertura)", group=g_adr_style, tooltip="Referência inicial do dia.")
showADR_Thirds= input.bool(false, "Mostrar Terços (33% e 66%)", group=g_adr_style, tooltip="Níveis de 1/3 e 2/3.")
showADR_25    = input.bool(true, "Mostrar 25%", group=g_adr_style, tooltip="Primeiro nível de expansão.")
showADR_50    = input.bool(true, "Mostrar 50%", group=g_adr_style, tooltip="Midline (Metade do range).")
showADR_75    = input.bool(true, "Mostrar 75%", group=g_adr_style, tooltip="Última barreira antes do alvo.")

// --- 3. AWR (SEMANAL) ---
showAWR       = input.bool(true, "Ativar AWR", group=g_awr_calc, tooltip="Visão Tática (Swing).")
awrRefMode    = input.string("Atual", "Período de Referência", options=["Atual", "Anterior"], group=g_awr_calc, tooltip="Viaje no Tempo:\n• Atual: Linha nasce na SEGUNDA-FEIRA desta semana.\n• Anterior: Linha nasce na SEGUNDA-FEIRA da semana passada.")
aWRRange      = input.int(13, "Período Média (semanas)", minval=1, maxval=52, group=g_awr_calc, tooltip="13 Semanas = 1 Trimestre (Quarter).")
awrDeslocamentoDireita = input.int(10, "Projeção Futura (Barras)", minval=0, maxval=500, group=g_awr_calc)
showAWR_Expanded = input.bool(false, "Mostrar Expansões (125% - 200%)", group=g_awr_calc, tooltip="Zonas de exaustão semanal.")

// AWR Estilo (CIANO #22d3ee)
showAWRLabels = input.bool(true, "Exibir Legendas (ON/OFF)", group=g_awr_style, tooltip="Interruptor geral das legendas Semanais.")
awrColorHigh  = input.color(color.new(#22d3ee, 0), "Cor Máxima +100% AWR", group=g_awr_style, tooltip="Resistência Semanal (Ciano).")
awrColorLow   = input.color(color.new(#22d3ee, 0), "Cor Mínima -100% AWR", group=g_awr_style, tooltip="Suporte Semanal (Ciano).")
awrColorIntermediate = input.color(color.new(#00bcd4, 50), "Cor Níveis (25%, 50%, 75%)", group=g_awr_style, tooltip="Níveis parciais da semana.")
awrColorThirds = input.color(color.new(#9C27B0, 30), "Cor Terços (33%, 66%)", group=g_awr_style, tooltip="Terços da semana.")
awrColor0     = input.color(color.new(#00bcd4, 0), "Cor Abertura (Nível 0%)", group=g_awr_style, tooltip="Abertura da Semana (Segunda/Domingo).")

awrWidth      = input.int(1, "Espessura Máx/Mín (±100%)", minval=1, maxval=5, group=g_awr_style)
awrWidthIntermediate = input.int(1, "Espessura Intermediária/Terços", minval=1, maxval=3, group=g_awr_style)
awr0Width     = input.int(1, "Espessura Linha 0%", minval=1, maxval=3, group=g_awr_style)

awrStyleX     = input.string("Pontilhada", "Estilo Linha", options=["Sólida", "Tracejada", "Pontilhada"], group=g_awr_style)
awr0StyleX    = input.string("Tracejada", "Estilo Linha 0%", options=["Sólida", "Tracejada", "Pontilhada"], group=g_awr_style)

showAWR_0     = input.bool(true, "Mostrar Linha Zero (Abertura)", group=g_awr_style, tooltip="Mostra a abertura semanal.")
showAWR_Thirds= input.bool(false, "Mostrar Terços (33% e 66%)", group=g_awr_style, tooltip="Ativa terços semanais.")
showAWR_25    = input.bool(true, "Mostrar 25%", group=g_awr_style, tooltip="25% do range semanal.")
showAWR_50    = input.bool(true, "Mostrar 50%", group=g_awr_style, tooltip="50% do range semanal.")
showAWR_75    = input.bool(true, "Mostrar 75%", group=g_awr_style, tooltip="75% do range semanal.")

// --- 4. AMR (MENSAL) ---
showAMR       = input.bool(true, "Ativar AMR", group=g_amr_calc, tooltip="Visão Estratégica (Position).")
amrRefMode    = input.string("Atual", "Período de Referência", options=["Atual", "Anterior"], group=g_amr_calc, tooltip="Viaje no Tempo:\n• Atual: Linha nasce dia 1º DESTE mês.\n• Anterior: Linha nasce dia 1º do MÊS PASSADO.")
aMRRange      = input.int(6, "Período Média (meses)", minval=1, maxval=12, group=g_amr_calc, tooltip="6 Meses = 1 Semestre.")
amrDeslocamentoDireita = input.int(20, "Projeção Futura (Barras)", minval=0, maxval=500, group=g_amr_calc)
showAMR_Expanded = input.bool(false, "Mostrar Expansões (125% - 200%)", group=g_amr_calc, tooltip="Zonas de exaustão mensal.")

// AMR Estilo (AZUL ROYAL #1e40f4)
showAMRLabels = input.bool(true, "Exibir Legendas (ON/OFF)", group=g_amr_style, tooltip="Disjuntor Geral das legendas Mensais.")
amrColorHigh  = input.color(color.new(#1e40f4, 0), "Cor Máxima +100% AMR", group=g_amr_style, tooltip="Resistência Mensal (Azul).")
amrColorLow   = input.color(color.new(#1e40f4, 0), "Cor Mínima -100% AMR", group=g_amr_style, tooltip="Suporte Mensal (Azul).")
amrColorIntermediate = input.color(color.new(#2994ff, 50), "Cor Níveis (25%, 50%, 75%)", group=g_amr_style, tooltip="Níveis parciais do mês.")
amrColorThirds = input.color(color.new(#9C27B0, 30), "Cor Terços (33%, 66%)", group=g_amr_style, tooltip="Terços do mês.")
amrColor0     = input.color(color.new(#2962ff, 0), "Cor Abertura (Nível 0%)", group=g_amr_style, tooltip="Abertura do Mês.")

amrWidth      = input.int(1, "Espessura Máx/Mín (±100%)", minval=1, maxval=5, group=g_amr_style)
amrWidthIntermediate = input.int(1, "Espessura Intermediária/Terços", minval=1, maxval=3, group=g_amr_style)
amr0Width     = input.int(1, "Espessura Linha 0%", minval=1, maxval=3, group=g_amr_style)

amrStyleX     = input.string("Pontilhada", "Estilo Linha", options=["Sólida", "Tracejada", "Pontilhada"], group=g_amr_style)
amr0StyleX    = input.string("Tracejada", "Estilo Linha 0%", options=["Sólida", "Tracejada", "Pontilhada"], group=g_amr_style)

showAMR_0     = input.bool(true, "Mostrar Linha Zero (Abertura)", group=g_amr_style, tooltip="Mostra a abertura mensal.")
showAMR_Thirds= input.bool(false, "Mostrar Terços (33% e 66%)", group=g_amr_style, tooltip="Ativa terços mensais.")
showAMR_25    = input.bool(true, "Mostrar 25%", group=g_amr_style, tooltip="Nível 25% mensal.")
showAMR_50    = input.bool(true, "Mostrar 50%", group=g_amr_style, tooltip="Nível 50% mensal.")
showAMR_75    = input.bool(true, "Mostrar 75%", group=g_amr_style, tooltip="Nível 75% mensal.")

// --- 5. DASHBOARD ---
showDashboard = input.bool(true, "Mostrar Dashboard", group=g_dash, tooltip="Painel de Controle.\nResumo rápido do status da volatilidade.")
dashBgTheme   = input.string("Escuro (Padrão)", "Tema de Fundo", options=["Escuro (Padrão)", "Claro (Light Mode)"], group=g_dash, tooltip="Ajuste de contraste.")
dashUnidade   = input.string("Pips (1/10)", "Unidade de Medida", options=["Pontos", "Pips (1/10)"], group=g_dash, tooltip="Pontos (Índices) ou Pips (Forex).")
dashTheme     = input.string("Semáforo (Risco)", "Psicologia das Cores", options=["Semáforo (Risco)", "Intensidade (Calor)"], group=g_dash, tooltip="Cores da tabela: Semáforo (Verde/Vermelho) ou Calor (Quente/Frio).")
dashSize      = input.string("Pequeno", "Tamanho do Texto", options=["Minúsculo", "Pequeno", "Normal", "Grande"], group=g_dash, tooltip="Tamanho da fonte da tabela.")
dashPos       = input.string("Bottom Right", "Posição na Tela", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=g_dash, tooltip="Posição da tabela na tela.")

// ----------------------------------------------------------------------
// 2.5 CONVERSÃO DE ESTILOS
// ----------------------------------------------------------------------
s_adr = adrStyleX == "Pontilhada" ? line.style_dotted : adrStyleX == "Tracejada" ? line.style_dashed : line.style_solid
s0_adr = adr0StyleX == "Pontilhada" ? line.style_dotted : adr0StyleX == "Tracejada" ? line.style_dashed : line.style_solid

s_awr = awrStyleX == "Pontilhada" ? line.style_dotted : awrStyleX == "Tracejada" ? line.style_dashed : line.style_solid
s0_awr = awr0StyleX == "Pontilhada" ? line.style_dotted : awr0StyleX == "Tracejada" ? line.style_dashed : line.style_solid

s_amr = amrStyleX == "Pontilhada" ? line.style_dotted : amrStyleX == "Tracejada" ? line.style_dashed : line.style_solid
s0_amr = amr0StyleX == "Pontilhada" ? line.style_dotted : amr0StyleX == "Tracejada" ? line.style_dashed : line.style_solid

// ----------------------------------------------------------------------
// 3. FUNÇÕES AUXILIARES
// ----------------------------------------------------------------------
formatPercent(percent) => str.tostring(percent, "#.##") + "%"
formatPrice(price) => str.tostring(price, format.mintick)

formatPoints(val) =>
    float points = val / syminfo.mintick
    if dashUnidade == "Pips (1/10)"
        str.tostring(points / 10, "#.#") 
    else
        str.tostring(math.round(points), "#") 

getColorText(pct, cls, opn) =>
    if dashTheme == "Semáforo (Risco)"
        if pct >= 100
            cls > opn ? color.new(#00FFFF, 0) : color.new(color.red, 0)
        else if pct >= 70
            color.new(color.orange, 0)
        else
            color.new(color.lime, 0)
    else 
        if pct >= 100
            cls > opn ? color.new(color.lime, 0) : color.new(color.red, 0)
        else if pct >= 70
            color.new(color.orange, 0)
        else
            color.new(color.teal, 30)

// Helper para cor da nova coluna Posição
getPosColor(posPct) =>
    if posPct > 0
        color.new(color.lime, 20) // Positivo (Verde)
    else
        color.new(color.red, 20)  // Negativo (Vermelho)

getStatusIcon(pct, cls, opn) =>
    if pct >= 100
        "⛔" 
    else if pct >= 70
        "⚠️"
    else
        "✔"

getDirIcon(cls, opn) => cls >= opn ? "▲" : "▼"

getTablePos() =>
    if dashPos == "Top Left"
        position.top_left
    else if dashPos == "Top Center"
        position.top_center
    else if dashPos == "Top Right"
        position.top_right
    else if dashPos == "Middle Left"
        position.middle_left
    else if dashPos == "Middle Center"
        position.middle_center
    else if dashPos == "Middle Right"
        position.middle_right
    else if dashPos == "Bottom Left"
        position.bottom_left
    else if dashPos == "Bottom Center"
        position.bottom_center
    else
        position.bottom_right

getFaltaColor(avg, current, close_p, open_p) =>
    diff = avg - current
    if diff >= 0
        color.new(color.gray, 30) 
    else
        close_p >= open_p ? color.new(#00FFFF, 0) : color.new(color.red, 0)

getFaltaStr(avg, current, close_p, open_p) =>
    diff = avg - current
    if diff >= 0
        formatPoints(diff)
    else
        sign = close_p >= open_p ? "+" : "-"
        sign + formatPoints(math.abs(diff))

adr(length, barsBack) =>
    tr = na(high[1]) ? high - low : math.max(math.max(high - low, math.abs(high - close[1])), math.abs(low - close[1]))
    if metodoCalc == "RMA (Wilder/ATR)"
        ta.rma(tr[barsBack], length)
    else
        ta.sma(tr[barsBack], length)

adr_high_calc(ref_price, adr_val) => ref_price + adr_val
adr_low_calc(ref_price, adr_val) => ref_price - adr_val

calcNivelLog(referencia, rangeValue, multiplicador) =>
    variacaoPercentual = rangeValue / referencia
    referencia * (1 + (variacaoPercentual * multiplicador))

// ----------------------------------------------------------------------
// 4. CONSTRUTOR DE RÓTULO
// ----------------------------------------------------------------------
buildLabelText(periodVal, labelName, priceVal, refPrice) =>
    string txt = ""
    if showL_Period
        txt := str.tostring(periodVal) + " "
    if showL_Name
        txt := txt + labelName
    if showL_Price
        string sep = (txt != "") ? " | " : ""
        txt := txt + sep + formatPrice(priceVal)
    if showL_Perc
        float pctVal = ((priceVal - refPrice) / refPrice) * 100
        string sep = (txt != "") ? " | " : ""
        string pctStr = pctVal > 0 ? "+" + formatPercent(pctVal) : formatPercent(pctVal)
        if pctVal == 0
            pctStr := "0.00%"
        txt := txt + sep + pctStr
    txt

getLabelSize() =>
    if lblSize == "Minúsculo"
        size.tiny
    else if lblSize == "Pequeno"
        size.small
    else if lblSize == "Grande"
        size.large
    else
        size.normal

getTableSize() =>
    if dashSize == "Minúsculo"
        size.tiny
    else if dashSize == "Pequeno"
        size.small
    else if dashSize == "Grande"
        size.large
    else
        size.normal

// ----------------------------------------------------------------------
// 5. LÓGICA DE ANCORAGEM HÍBRIDA + MEMÓRIA DE PERÍODO ANTERIOR
// ----------------------------------------------------------------------

// 1. Busca Valores do Servidor (Segurança de Preço HTF)
[anchor_D_cur, anchor_D_prev] = request.security(syminfo.tickerid, "D", [open, open[1]], lookahead=barmerge.lookahead_on)
[anchor_W_cur, anchor_W_prev] = request.security(syminfo.tickerid, "W", [open, open[1]], lookahead=barmerge.lookahead_on)
[anchor_M_cur, anchor_M_prev] = request.security(syminfo.tickerid, "M", [open, open[1]], lookahead=barmerge.lookahead_on)

// 2. Detectores de Mudança de Período (Visual Local)
bool new_day_ny = dayofmonth(time, "America/New_York") != dayofmonth(time[1], "America/New_York")
bool new_day_std = ta.change(time("D")) != 0
bool new_week    = ta.change(time("W")) != 0
bool new_month   = ta.change(time("M")) != 0

// 3. Sistema de Memória de Índices (Shift Register)
var int start_idx_D = na
var int start_idx_D_prev = na

var int start_idx_W = na
var int start_idx_W_prev = na

var int start_idx_M = na
var int start_idx_M_prev = na

if usarNYOpen
    if new_day_ny
        start_idx_D_prev := start_idx_D
        start_idx_D := bar_index
    else if not timeframe.isintraday and new_day_std
        start_idx_D_prev := start_idx_D
        start_idx_D := bar_index
else
    if new_day_std
        start_idx_D_prev := start_idx_D
        start_idx_D := bar_index

if new_week
    start_idx_W_prev := start_idx_W
    start_idx_W := bar_index

if new_month
    start_idx_M_prev := start_idx_M
    start_idx_M := bar_index

// 4. Definição Final das Âncoras de PREÇO (Y-Axis)
var float anchor_D_ny_calc = na
if new_day_ny
    anchor_D_ny_calc := open 

// Lógica Diária
float ref_D_raw = na
if adrRefMode == "Atual"
    ref_D_raw := usarNYOpen ? (timeframe.isintraday ? anchor_D_ny_calc : anchor_D_cur) : anchor_D_cur
else
    ref_D_raw := anchor_D_prev

float final_ref_D = ref_D_raw

// Lógica Semanal e Mensal
float final_ref_W = awrRefMode == "Atual" ? anchor_W_cur : anchor_W_prev
float final_ref_M = amrRefMode == "Atual" ? anchor_M_cur : anchor_M_prev

// 5. Definição Final das Posições de DESENHO (X-Axis)
int final_draw_idx_D = na
if adrRefMode == "Atual"
    final_draw_idx_D := na(start_idx_D) ? bar_index : start_idx_D
else
    final_draw_idx_D := na(start_idx_D_prev) ? (na(start_idx_D) ? bar_index : start_idx_D) : start_idx_D_prev

int final_draw_idx_W = na
if awrRefMode == "Atual"
    final_draw_idx_W := na(start_idx_W) ? bar_index : start_idx_W
else
    final_draw_idx_W := na(start_idx_W_prev) ? (na(start_idx_W) ? bar_index : start_idx_W) : start_idx_W_prev

int final_draw_idx_M = na
if amrRefMode == "Atual"
    final_draw_idx_M := na(start_idx_M) ? bar_index : start_idx_M
else
    final_draw_idx_M := na(start_idx_M_prev) ? (na(start_idx_M) ? bar_index : start_idx_M) : start_idx_M_prev

// ----------------------------------------------------------------------
// 5.1 NOMEAÇÃO DINÂMICA (PARA LEGENDAS E TABELA)
// ----------------------------------------------------------------------
string name_ADR = adrRefMode == "Anterior" ? "ADR (Prev)" : "ADR"
string name_AWR = awrRefMode == "Anterior" ? "AWR (Prev)" : "AWR"
string name_AMR = amrRefMode == "Anterior" ? "AMR (Prev)" : "AMR"

// ----------------------------------------------------------------------
// 6. CÁLCULOS E PLOTAGEM
// ----------------------------------------------------------------------

updateLine(lineObj, sBar, val, col, sty, wid, offsetR) =>
    if na(lineObj)
        line.new(sBar, val, last_bar_index + offsetR, val, color=col, style=sty, width=wid, force_overlay=true)
    else
        line.set_xy1(lineObj, sBar, val)
        line.set_xy2(lineObj, last_bar_index + offsetR, val)
        lineObj

updateLabel(lblObj, val, txt, col, txtCol, offsetR) =>
    if txt == ""
        if not na(lblObj)
            label.delete(lblObj)
        label(na)
    else
        if na(lblObj)
            label.new(last_bar_index + offsetR, val, txt, style=label.style_label_left, color=color.new(color.white,100), textcolor=txtCol, size=getLabelSize())
        else
            label.set_xy(lblObj, last_bar_index + offsetR, val)
            label.set_text(lblObj, txt)
            label.set_size(lblObj, getLabelSize())
            lblObj

// --- PROCESSAMENTO ADR (DIÁRIO) ---
day_adr = request.security(syminfo.tickerid, "D", adr(aDRRange, 1), lookahead=barmerge.lookahead_on)

if showADR and not na(day_adr)
    h = adr_high_calc(final_ref_D, day_adr)
    l = adr_low_calc(final_ref_D, day_adr)
    
    var line lH = line(na), var line lL = line(na), var line l0 = line(na)
    var label lbH = label(na), var label lbL = label(na), var label lb0 = label(na)
    
    lH := updateLine(lH, final_draw_idx_D, h, adrColorHigh, s_adr, adrWidth, adrDeslocamentoDireita)
    lL := updateLine(lL, final_draw_idx_D, l, adrColorLow, s_adr, adrWidth, adrDeslocamentoDireita)
    if showADR_0
        l0 := updateLine(l0, final_draw_idx_D, final_ref_D, adrColor0, s0_adr, adr0Width, adrDeslocamentoDireita)

    if showADRLabels
        // Usa name_ADR dinâmico aqui
        lbH := updateLabel(lbH, h, buildLabelText(aDRRange, name_ADR + " +100%", h, final_ref_D), adrColorHigh, adrColorHigh, adrDeslocamentoDireita)
        lbL := updateLabel(lbL, l, buildLabelText(aDRRange, name_ADR + " -100%", l, final_ref_D), adrColorLow, adrColorLow, adrDeslocamentoDireita)
        if showADR_0
            lb0 := updateLabel(lb0, final_ref_D, buildLabelText(aDRRange, name_ADR + " 0%", final_ref_D, final_ref_D), adrColor0, adrColor0, adrDeslocamentoDireita)

    if showADR_Thirds
        h33 = h - (day_adr * 0.6666), l33 = l + (day_adr * 0.6666)
        h66 = h - (day_adr * 0.3333), l66 = l + (day_adr * 0.3333)
        var line lH33=line(na), var line lL33=line(na), var line lH66=line(na), var line lL66=line(na)
        var label lbH33=label(na), var label lbL33=label(na), var label lbH66=label(na), var label lbL66=label(na)
        lH33 := updateLine(lH33, final_draw_idx_D, h33, adrColorThirds, s_adr, adrWidthIntermediate, adrDeslocamentoDireita)
        lL33 := updateLine(lL33, final_draw_idx_D, l33, adrColorThirds, s_adr, adrWidthIntermediate, adrDeslocamentoDireita)
        lH66 := updateLine(lH66, final_draw_idx_D, h66, adrColorThirds, s_adr, adrWidthIntermediate, adrDeslocamentoDireita)
        lL66 := updateLine(lL66, final_draw_idx_D, l66, adrColorThirds, s_adr, adrWidthIntermediate, adrDeslocamentoDireita)
        if showADRLabels
            lbH33 := updateLabel(lbH33, h33, buildLabelText(aDRRange, name_ADR + " +33.3%", h33, final_ref_D), adrColorThirds, adrColorThirds, adrDeslocamentoDireita)
            lbL33 := updateLabel(lbL33, l33, buildLabelText(aDRRange, name_ADR + " -33.3%", l33, final_ref_D), adrColorThirds, adrColorThirds, adrDeslocamentoDireita)
            lbH66 := updateLabel(lbH66, h66, buildLabelText(aDRRange, name_ADR + " +66.6%", h66, final_ref_D), adrColorThirds, adrColorThirds, adrDeslocamentoDireita)
            lbL66 := updateLabel(lbL66, l66, buildLabelText(aDRRange, name_ADR + " -66.6%", l66, final_ref_D), adrColorThirds, adrColorThirds, adrDeslocamentoDireita)

    if showADR_25
        h25 = h - (day_adr * 0.75), l25 = l + (day_adr * 0.75)
        var line lH25=line(na), var line lL25=line(na)
        var label lbH25=label(na), var label lbL25=label(na)
        lH25 := updateLine(lH25, final_draw_idx_D, h25, adrColorIntermediate, s_adr, adrWidthIntermediate, adrDeslocamentoDireita)
        lL25 := updateLine(lL25, final_draw_idx_D, l25, adrColorIntermediate, s_adr, adrWidthIntermediate, adrDeslocamentoDireita)
        if showADRLabels
            lbH25 := updateLabel(lbH25, h25, buildLabelText(aDRRange, name_ADR + " +25%", h25, final_ref_D), adrColorIntermediate, adrColorIntermediate, adrDeslocamentoDireita)
            lbL25 := updateLabel(lbL25, l25, buildLabelText(aDRRange, name_ADR + " -25%", l25, final_ref_D), adrColorIntermediate, adrColorIntermediate, adrDeslocamentoDireita)

    if showADR_50
        h50 = h - (day_adr * 0.50), l50 = l + (day_adr * 0.50)
        var line lH50=line(na), var line lL50=line(na)
        var label lbH50=label(na), var label lbL50=label(na)
        lH50 := updateLine(lH50, final_draw_idx_D, h50, adrColorIntermediate, s_adr, adrWidthIntermediate, adrDeslocamentoDireita)
        lL50 := updateLine(lL50, final_draw_idx_D, l50, adrColorIntermediate, s_adr, adrWidthIntermediate, adrDeslocamentoDireita)
        if showADRLabels
            lbH50 := updateLabel(lbH50, h50, buildLabelText(aDRRange, name_ADR + " +50%", h50, final_ref_D), adrColorIntermediate, adrColorIntermediate, adrDeslocamentoDireita)
            lbL50 := updateLabel(lbL50, l50, buildLabelText(aDRRange, name_ADR + " -50%", l50, final_ref_D), adrColorIntermediate, adrColorIntermediate, adrDeslocamentoDireita)

    if showADR_75
        h75 = h - (day_adr * 0.25), l75 = l + (day_adr * 0.25)
        var line lH75=line(na), var line lL75=line(na)
        var label lbH75=label(na), var label lbL75=label(na)
        lH75 := updateLine(lH75, final_draw_idx_D, h75, adrColorIntermediate, s_adr, adrWidthIntermediate, adrDeslocamentoDireita)
        lL75 := updateLine(lL75, final_draw_idx_D, l75, adrColorIntermediate, s_adr, adrWidthIntermediate, adrDeslocamentoDireita)
        if showADRLabels
            lbH75 := updateLabel(lbH75, h75, buildLabelText(aDRRange, name_ADR + " +75%", h75, final_ref_D), adrColorIntermediate, adrColorIntermediate, adrDeslocamentoDireita)
            lbL75 := updateLabel(lbL75, l75, buildLabelText(aDRRange, name_ADR + " -75%", l75, final_ref_D), adrColorIntermediate, adrColorIntermediate, adrDeslocamentoDireita)

    if showADR_Expanded
        h125 = h + (day_adr * 0.25), l125 = l - (day_adr * 0.25)
        var line lH125=line(na), var line lL125=line(na)
        var label lbH125=label(na), var label lbL125=label(na)
        lH125 := updateLine(lH125, final_draw_idx_D, h125, adrColorIntermediate, s_adr, adrWidthIntermediate, adrDeslocamentoDireita)
        lL125 := updateLine(lL125, final_draw_idx_D, l125, adrColorIntermediate, s_adr, adrWidthIntermediate, adrDeslocamentoDireita)
        if showADRLabels
            lbH125 := updateLabel(lbH125, h125, buildLabelText(aDRRange, name_ADR + " +125%", h125, final_ref_D), adrColorIntermediate, adrColorIntermediate, adrDeslocamentoDireita)
            lbL125 := updateLabel(lbL125, l125, buildLabelText(aDRRange, name_ADR + " -125%", l125, final_ref_D), adrColorIntermediate, adrColorIntermediate, adrDeslocamentoDireita)
        h150 = h + (day_adr * 0.50), l150 = l - (day_adr * 0.50)
        var line lH150=line(na), var line lL150=line(na)
        var label lbH150=label(na), var label lbL150=label(na)
        lH150 := updateLine(lH150, final_draw_idx_D, h150, adrColorIntermediate, s_adr, adrWidthIntermediate, adrDeslocamentoDireita)
        lL150 := updateLine(lL150, final_draw_idx_D, l150, adrColorIntermediate, s_adr, adrWidthIntermediate, adrDeslocamentoDireita)
        if showADRLabels
            lbH150 := updateLabel(lbH150, h150, buildLabelText(aDRRange, name_ADR + " +150%", h150, final_ref_D), adrColorIntermediate, adrColorIntermediate, adrDeslocamentoDireita)
            lbL150 := updateLabel(lbL150, l150, buildLabelText(aDRRange, name_ADR + " -150%", l150, final_ref_D), adrColorIntermediate, adrColorIntermediate, adrDeslocamentoDireita)
        h175 = h + (day_adr * 0.75), l175 = l - (day_adr * 0.75)
        var line lH175=line(na), var line lL175=line(na)
        var label lbH175=label(na), var label lbL175=label(na)
        lH175 := updateLine(lH175, final_draw_idx_D, h175, adrColorIntermediate, s_adr, adrWidthIntermediate, adrDeslocamentoDireita)
        lL175 := updateLine(lL175, final_draw_idx_D, l175, adrColorIntermediate, s_adr, adrWidthIntermediate, adrDeslocamentoDireita)
        if showADRLabels
            lbH175 := updateLabel(lbH175, h175, buildLabelText(aDRRange, name_ADR + " +175%", h175, final_ref_D), adrColorIntermediate, adrColorIntermediate, adrDeslocamentoDireita)
            lbL175 := updateLabel(lbL175, l175, buildLabelText(aDRRange, name_ADR + " -175%", l175, final_ref_D), adrColorIntermediate, adrColorIntermediate, adrDeslocamentoDireita)
        h200 = h + day_adr, l200 = l - day_adr
        var line lH200=line(na), var line lL200=line(na)
        var label lbH200=label(na), var label lbL200=label(na)
        lH200 := updateLine(lH200, final_draw_idx_D, h200, adrColorHigh, s_adr, adrWidth, adrDeslocamentoDireita)
        lL200 := updateLine(lL200, final_draw_idx_D, l200, adrColorLow, s_adr, adrWidth, adrDeslocamentoDireita)
        if showADRLabels
            lbH200 := updateLabel(lbH200, h200, buildLabelText(aDRRange, name_ADR + " +200%", h200, final_ref_D), adrColorHigh, adrColorHigh, adrDeslocamentoDireita)
            lbL200 := updateLabel(lbL200, l200, buildLabelText(aDRRange, name_ADR + " -200%", l200, final_ref_D), adrColorLow, adrColorLow, adrDeslocamentoDireita)

// --- PROCESSAMENTO AWR (SEMANAL) ---
week_adr = request.security(syminfo.tickerid, "W", adr(aWRRange, 1), lookahead=barmerge.lookahead_on)

if showAWR and not na(week_adr)
    h = adr_high_calc(final_ref_W, week_adr)
    l = adr_low_calc(final_ref_W, week_adr)
    var line wlH=line(na), var line wlL=line(na), var line wl0=line(na)
    var label wlbH=label(na), var label wlbL=label(na), var label wlb0=label(na)
    wlH := updateLine(wlH, final_draw_idx_W, h, awrColorHigh, s_awr, awrWidth, awrDeslocamentoDireita)
    wlL := updateLine(wlL, final_draw_idx_W, l, awrColorLow, s_awr, awrWidth, awrDeslocamentoDireita)
    if showAWR_0
        wl0 := updateLine(wl0, final_draw_idx_W, final_ref_W, awrColor0, s0_awr, awr0Width, awrDeslocamentoDireita)
    if showAWRLabels
        wlbH := updateLabel(wlbH, h, buildLabelText(aWRRange, name_AWR + " +100%", h, final_ref_W), awrColorHigh, awrColorHigh, awrDeslocamentoDireita)
        wlbL := updateLabel(wlbL, l, buildLabelText(aWRRange, name_AWR + " -100%", l, final_ref_W), awrColorLow, awrColorLow, awrDeslocamentoDireita)
        if showAWR_0
            wlb0 := updateLabel(wlb0, final_ref_W, buildLabelText(aWRRange, name_AWR + " 0%", final_ref_W, final_ref_W), awrColor0, awrColor0, awrDeslocamentoDireita)
    if showAWR_Thirds
        h33 = h - (week_adr * 0.6666), l33 = l + (week_adr * 0.6666)
        h66 = h - (week_adr * 0.3333), l66 = l + (week_adr * 0.3333)
        var line wlH33=line(na), var line wlL33=line(na), var line wlH66=line(na), var line wlL66=line(na)
        var label wlbH33=label(na), var label wlbL33=label(na), var label wlbH66=label(na), var label wlbL66=label(na)
        wlH33 := updateLine(wlH33, final_draw_idx_W, h33, awrColorThirds, s_awr, awrWidthIntermediate, awrDeslocamentoDireita)
        wlL33 := updateLine(wlL33, final_draw_idx_W, l33, awrColorThirds, s_awr, awrWidthIntermediate, awrDeslocamentoDireita)
        wlH66 := updateLine(wlH66, final_draw_idx_W, h66, awrColorThirds, s_awr, awrWidthIntermediate, awrDeslocamentoDireita)
        wlL66 := updateLine(wlL66, final_draw_idx_W, l66, awrColorThirds, s_awr, awrWidthIntermediate, awrDeslocamentoDireita)
        if showAWRLabels
            wlbH33 := updateLabel(wlbH33, h33, buildLabelText(aWRRange, name_AWR + " +33.3%", h33, final_ref_W), awrColorThirds, awrColorThirds, awrDeslocamentoDireita)
            wlbL33 := updateLabel(wlbL33, l33, buildLabelText(aWRRange, name_AWR + " -33.3%", l33, final_ref_W), awrColorThirds, awrColorThirds, awrDeslocamentoDireita)
            wlbH66 := updateLabel(wlbH66, h66, buildLabelText(aWRRange, name_AWR + " +66.6%", h66, final_ref_W), awrColorThirds, awrColorThirds, awrDeslocamentoDireita)
            wlbL66 := updateLabel(wlbL66, l66, buildLabelText(aWRRange, name_AWR + " -66.6%", l66, final_ref_W), awrColorThirds, awrColorThirds, awrDeslocamentoDireita)
    if showAWR_25
        h25 = h - (week_adr * 0.75), l25 = l + (week_adr * 0.75)
        var line wlH25=line(na), var line wlL25=line(na)
        var label wlbH25=label(na), var label wlbL25=label(na)
        wlH25 := updateLine(wlH25, final_draw_idx_W, h25, awrColorIntermediate, s_awr, awrWidthIntermediate, awrDeslocamentoDireita)
        wlL25 := updateLine(wlL25, final_draw_idx_W, l25, awrColorIntermediate, s_awr, awrWidthIntermediate, awrDeslocamentoDireita)
        if showAWRLabels
            wlbH25 := updateLabel(wlbH25, h25, buildLabelText(aWRRange, name_AWR + " +25%", h25, final_ref_W), awrColorIntermediate, awrColorIntermediate, awrDeslocamentoDireita)
            wlbL25 := updateLabel(wlbL25, l25, buildLabelText(aWRRange, name_AWR + " -25%", l25, final_ref_W), awrColorIntermediate, awrColorIntermediate, awrDeslocamentoDireita)
    if showAWR_50
        h50 = h - (week_adr * 0.50), l50 = l + (week_adr * 0.50)
        var line wlH50=line(na), var line wlL50=line(na)
        var label wlbH50=label(na), var label wlbL50=label(na)
        wlH50 := updateLine(wlH50, final_draw_idx_W, h50, awrColorIntermediate, s_awr, awrWidthIntermediate, awrDeslocamentoDireita)
        wlL50 := updateLine(wlL50, final_draw_idx_W, l50, awrColorIntermediate, s_awr, awrWidthIntermediate, awrDeslocamentoDireita)
        if showAWRLabels
            wlbH50 := updateLabel(wlbH50, h50, buildLabelText(aWRRange, name_AWR + " +50%", h50, final_ref_W), awrColorIntermediate, awrColorIntermediate, awrDeslocamentoDireita)
            wlbL50 := updateLabel(wlbL50, l50, buildLabelText(aWRRange, name_AWR + " -50%", l50, final_ref_W), awrColorIntermediate, awrColorIntermediate, awrDeslocamentoDireita)
    if showAWR_75
        h75 = h - (week_adr * 0.25), l75 = l + (week_adr * 0.25)
        var line wlH75=line(na), var line wlL75=line(na)
        var label wlbH75=label(na), var label wlbL75=label(na)
        wlH75 := updateLine(wlH75, final_draw_idx_W, h75, awrColorIntermediate, s_awr, awrWidthIntermediate, awrDeslocamentoDireita)
        wlL75 := updateLine(wlL75, final_draw_idx_W, l75, awrColorIntermediate, s_awr, awrWidthIntermediate, awrDeslocamentoDireita)
        if showAWRLabels
