            wlbL125 := updateLabel(wlbL125, l125, buildLabelText(aWRRange, name_AWR + " -125%", l125, final_ref_W), awrColorIntermediate, awrColorIntermediate, awrDeslocamentoDireita)
        h150 = h + (week_adr * 0.50), l150 = l - (week_adr * 0.50)
        var line wlH150=line(na), var line wlL150=line(na)
        var label wlbH150=label(na), var label wlbL150=label(na)
