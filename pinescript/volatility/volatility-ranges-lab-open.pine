            wlbL75 := updateLabel(wlbL75, l75, buildLabelText(aWRRange, name_AWR + " -75%", l75, final_ref_W), awrColorIntermediate, awrColorIntermediate, awrDeslocamentoDireita)
    if showAWR_Expanded
        h125 = h + (week_adr * 0.25), l125 = l - (week_adr * 0.25)
        var line wlH125=line(na), var line wlL125=line(na)
        var label wlbH125=label(na), var label wlbL125=label(na)
        wlH125 := updateLine(wlH125, final_draw_idx_W, h125, awrColorIntermediate, s_awr, awrWidthIntermediate, awrDeslocamentoDireita)
        wlL125 := updateLine(wlL125, final_draw_idx_W, l125, awrColorIntermediate, s_awr, awrWidthIntermediate, awrDeslocamentoDireita)
