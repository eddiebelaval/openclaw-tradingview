//@version=5
indicator("Pro Minimalist ATR + Stats Box", overlay=true)

// --- 1. Calculations ---
atrLen   = 14
dma20    = ta.sma(close, 20)
atrValue = ta.atr(atrLen)
atrPct   = (atrValue / close) * 100

// Define Levels
p2 = dma20 + (atrValue * 2)
p1 = dma20 + (atrValue * 1)
m1 = dma20 - (atrValue * 1)
m2 = dma20 - (atrValue * 2)

// --- 2. Plotting (The Lines) ---
plot(dma20, "20 DMA", color=color.new(color.gray, 50), style=plot.style_linebr)

// Plotting price scale markers (Right side axis)
plot(p2, "2ATR Axis", display=display.price_scale, color=color.black)
plot(p1, "1ATR Axis", display=display.price_scale, color=color.black)
plot(m1, "-1ATR Axis", display=display.price_scale, color=color.black)
plot(m2, "-2ATR Axis", display=display.price_scale, color=color.black)

// --- 3. The Black Box (Top Right Table) ---
var table statsBox = table.new(position.top_right, 2, 4, bgcolor = color.black, border_width = 1, border_color = color.gray)

if barstate.islast
    // Header
    table.cell(statsBox, 0, 0, "ATR STATS", text_color = color.white, text_size = size.small)
    table.cell(statsBox, 1, 0, "", text_color = color.white)

    // ATR % Row
    table.cell(statsBox, 0, 1, "ATR %:", text_color = color.white, text_halign = text.align_left)
    table.cell(statsBox, 1, 1, str.format("{0,number,#.##}%", atrPct), text_color = color.yellow, text_halign = text.align_right)

    // Raw ATR Value Row
    table.cell(statsBox, 0, 2, "ATR Val:", text_color = color.white, text_halign = text.align_left)
    table.cell(statsBox, 1, 2, str.tostring(atrValue, format.mintick), text_color = color.white, text_halign = text.align_right)

    // Daily Range Row
    table.cell(statsBox, 0, 3, "1x Range:", text_color = color.white, text_halign = text.align_left)
    table.cell(statsBox, 1, 3, str.tostring(atrValue * 2, format.mintick), text_color = color.aqua, text_halign = text.align_right)

// --- 4. Dynamic Labels (The floating text next to price) ---
var label lblP2 = na, var label lblP1 = na, var label lblDMA = na, var label lblM1 = na, var label lblM2 = na

if barstate.islast
    label.delete(lblP2), label.delete(lblP1), label.delete(lblDMA), label.delete(lblM1), label.delete(lblM2)
    
    // Offset labels to the right of the current bar (bar_index + 5)
    lblP2  := label.new(bar_index + 5, p2,    "2ATR: " + str.tostring(p2, format.mintick),    color=color.new(color.white, 100), textcolor=color.black, style=label.style_label_left, size=size.small)
    lblP1  := label.new(bar_index + 5, p1,    "1ATR: " + str.tostring(p1, format.mintick),    color=color.new(color.white, 100), textcolor=color.black, style=label.style_label_left, size=size.small)
    lblDMA := label.new(bar_index + 5, dma20, "DMA: "  + str.tostring(dma20, format.mintick), color=color.new(color.white, 100), textcolor=color.black, style=label.style_label_left, size=size.small)
    lblM1  := label.new(bar_index + 5, m1,    "-1ATR: "+ str.tostring(m1, format.mintick),    color=color.new(color.white, 100), textcolor=color.black, style=label.style_label_left, size=size.small)
    lblM2  := label.new(bar_index + 5, m2,    "-2ATR: "+ str.tostring(m2, format.mintick),    color=color.new(color.white, 100), textcolor=color.black, style=label.style_label_left, size=size.small)
