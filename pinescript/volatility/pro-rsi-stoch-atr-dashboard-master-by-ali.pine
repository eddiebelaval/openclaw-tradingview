//@version=5
indicator("Pro RSI + Stoch + ATR Dashboard (MASTER) by Ali", overlay=true)

// ===== INPUTS =====
grpVisual = "Visual"
pos = input.string("Top Right", "Table Position", options=["Top Right","Bottom Right","Top Left","Bottom Left"], group=grpVisual)

grpInd = "Indicator Settings"
rsiLen   = input.int(14, "RSI Length", group=grpInd)
stochLen = input.int(14, "Stochastic Length", group=grpInd)
kSmooth  = input.int(3,  "Stoch K Smoothing", group=grpInd)
dSmooth  = input.int(3,  "Stoch D Smoothing", group=grpInd)
atrLen   = input.int(14, "ATR Length", group=grpInd)

grpThr = "Thresholds"
rsiOB = input.int(70, "RSI Overbought", group=grpThr)
rsiOS = input.int(30, "RSI Oversold", group=grpThr)
stOB  = input.int(80, "Stoch Overbought", group=grpThr)
stOS  = input.int(20, "Stoch Oversold", group=grpThr)

grpMaster = "MASTER Settings"
trendTF        = input.string("4H", "RSI 50 Trend TF", options=["1H","4H","D"], group=grpMaster)
minBullForBuy  = input.int(3, "Min Bull TF for BUY (0-4)", minval=0, maxval=4, group=grpMaster)
maxBullForSell = input.int(1, "Max Bull TF for SELL (0-4)", minval=0, maxval=4, group=grpMaster)
showMasterShapes = input.bool(true, "Show MASTER Shapes (BUY/SELL)", group=grpMaster)
showInfoLbl      = input.bool(true, "Center Info Label (Trend/Score/ATR%)", group=grpMaster)

// ===== TABLE COLOR SETTINGS =====
grpTbl = "Table Colors"
tblBg       = input.color(color.new(color.black, 40), "Table Background", group=grpTbl)
hdrBg       = input.color(color.black, "Header Background", group=grpTbl)
hdrTextCol  = input.color(color.white, "Header Text", group=grpTbl)
cellTextCol = input.color(color.white, "Cell Text (General)", group=grpTbl)
frameCol    = input.color(color.gray,  "Frame/Border", group=grpTbl)
atrTextCol  = input.color(color.yellow,"ATR Text Color", group=grpTbl)

// ===== TABLE POSITION (no ternary) =====
posEnum = position.top_right
if pos == "Top Right"
    posEnum := position.top_right
else if pos == "Bottom Right"
    posEnum := position.bottom_right
else if pos == "Top Left"
    posEnum := position.top_left
else
    posEnum := position.bottom_left

// ===== MTF DATA (security one-liner) =====
f_getData(tf) =>
    request.security(syminfo.tickerid, tf,
     [ta.rsi(close, rsiLen),
      ta.sma(ta.stoch(ta.rsi(close, stochLen), ta.rsi(close, stochLen), ta.rsi(close, stochLen), stochLen), kSmooth),
      ta.sma(ta.sma(ta.stoch(ta.rsi(close, stochLen), ta.rsi(close, stochLen), ta.rsi(close, stochLen), stochLen), kSmooth), dSmooth),
      ta.atr(atrLen),
      (ta.atr(atrLen)/close)*100.0],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// ===== STATUS (table signal logic stays same) =====
f_getStatus(rsiV, kV, dV) =>
    txt = "NEUTRAL ⚪"
    col = color.gray
    if rsiV > rsiOB and kV > stOB and dV > stOB
        txt := "OVERHEATED! (SELL) 🔴"
        col := color.red
    else if rsiV > (rsiOB - 10) and kV > (stOB - 10)
        txt := "RISING ↗️"
        col := color.orange
    else if rsiV < rsiOS and kV < stOS and dV < stOS
        txt := "OVERSOLD! (BUY) 🟢"
        col := color.green
    else if rsiV < (rsiOS + 10) and kV < (stOS + 10)
        txt := "FALLING ↘️"
        col := color.teal
    [txt, col]

// ===== GET MTF =====
[rsi_15m, k_15m, d_15m, atr_15m, atrp_15m] = f_getData("15")
[rsi_1h,  k_1h,  d_1h,  atr_1h,  atrp_1h ] = f_getData("60")
[rsi_4h,  k_4h,  d_4h,  atr_4h,  atrp_4h ] = f_getData("240")
[rsi_D,   k_D,   d_D,   atr_D,   atrp_D  ] = f_getData("D")

// ===== TREND FILTER (RSI 50 on chosen TF) =====
trendRsi  = trendTF == "1H" ? rsi_1h : trendTF == "4H" ? rsi_4h : rsi_D
trendBull = trendRsi >= 50
trendTxt  = trendBull ? "TREND: LONG ONLY ✅" : "TREND: SHORT ONLY ✅"

// ===== ALIGNMENT SCORE (RSI>=50 count) =====
bullCount = (rsi_15m >= 50 ? 1 : 0) + (rsi_1h >= 50 ? 1 : 0) + (rsi_4h >= 50 ? 1 : 0) + (rsi_D >= 50 ? 1 : 0)
scorePct  = (bullCount/4.0)*100.0
scoreTxt  = "ALIGN: " + str.tostring(bullCount) + "/4 BULL (" + str.tostring(scorePct, "#.0") + "%)"

// ===== 15m K/D CROSS (trigger) =====
xUp_15m = ta.crossover(k_15m, d_15m)
xDn_15m = ta.crossunder(k_15m, d_15m)

// ===== MASTER SIGNALS (Trend + Alignment + Trigger) =====
masterBuy  = trendBull and (bullCount >= minBullForBuy) and xUp_15m
masterSell = (not trendBull) and (bullCount <= maxBullForSell) and xDn_15m

// ===== MASTER ALERTS =====
alertcondition(masterBuy,  "MASTER BUY",  "MASTER BUY: Trend LONG + Alignment OK + 15m K/D Cross Up")
alertcondition(masterSell, "MASTER SELL", "MASTER SELL: Trend SHORT + Alignment OK + 15m K/D Cross Down")

// ===== MASTER SHAPES (global scope) =====
plotshape(showMasterShapes and masterBuy,  title="MASTER BUY",  style=shape.labelup,   location=location.belowbar, size=size.small, text="BUY ✅")
plotshape(showMasterShapes and masterSell, title="MASTER SELL", style=shape.labeldown, location=location.abovebar, size=size.small, text="SELL ✅")

// ===== TABLE (unchanged columns, colors customizable) =====
var table tbl = table.new(posEnum, 6, 6, bgcolor=tblBg, frame_color=frameCol, frame_width=1, border_color=frameCol, border_width=1)

f_row(row, name, rsiV, kV, dV, atrV) =>
    [t, c] = f_getStatus(rsiV, kV, dV)
    table.cell(tbl, 0, row, name, text_color=cellTextCol)
    table.cell(tbl, 1, row, str.tostring(rsiV, "#.0"), text_color=rsiV > rsiOB ? color.red : rsiV < rsiOS ? color.green : cellTextCol)
    table.cell(tbl, 2, row, str.tostring(kV,  "#.0"), text_color=kV  > stOB  ? color.red : kV  < stOS  ? color.green : cellTextCol)
    table.cell(tbl, 3, row, str.tostring(dV,  "#.0"), text_color=dV  > stOB  ? color.red : dV  < stOS  ? color.green : cellTextCol)
    table.cell(tbl, 4, row, str.tostring(atrV, format.mintick), text_color=atrTextCol)
    table.cell(tbl, 5, row, t, text_color=cellTextCol, bgcolor=c)

if barstate.islast
    table.cell(tbl, 0, 0, "TIME",   text_color=hdrTextCol, bgcolor=hdrBg)
    table.cell(tbl, 1, 0, "RSI",    text_color=hdrTextCol, bgcolor=hdrBg)
    table.cell(tbl, 2, 0, "K",      text_color=hdrTextCol, bgcolor=hdrBg)
    table.cell(tbl, 3, 0, "D",      text_color=hdrTextCol, bgcolor=hdrBg)
    table.cell(tbl, 4, 0, "ATR",    text_color=hdrTextCol, bgcolor=hdrBg)
    table.cell(tbl, 5, 0, "STATUS", text_color=hdrTextCol, bgcolor=hdrBg)
    f_row(1, "15m", rsi_15m, k_15m, d_15m, atr_15m)
    f_row(2, "1H",  rsi_1h,  k_1h,  d_1h,  atr_1h)
    f_row(3, "4H",  rsi_4h,  k_4h,  d_4h,  atr_4h)
    f_row(4, "1D",  rsi_D,   k_D,   d_D,   atr_D)

// ===== INFO LABEL (the "center" box) =====
var label infoLbl = na
if barstate.islast and showInfoLbl
    label.delete(infoLbl)
    infoTxt = trendTxt + "\n" + scoreTxt + "\n" +
      "ATR% 15m: " + str.tostring(atrp_15m, "#.2") + "% | 1H: " + str.tostring(atrp_1h, "#.2") + "%\n" +
      "ATR% 4H: " + str.tostring(atrp_4h, "#.2") + "% | 1D: " + str.tostring(atrp_D,  "#.2") + "%"
    infoLbl := label.new(bar_index, high, infoTxt, style=label.style_label_left, textcolor=color.white, color=color.new(color.black, 65))
