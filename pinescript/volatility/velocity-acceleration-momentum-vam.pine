//@version=6
indicator("Velocity Acceleration Momentum [VAM]", shorttitle="VAM", overlay=false)

// === INPUTS ===
src        = input.source(close, "Source")
vel_len    = input.int(14, "Velocity Length",    minval=2, maxval=100)
acc_len    = input.int(5,  "Acceleration Smooth",minval=1, maxval=20)
signal_len = input.int(9,  "Signal Line Length", minval=1, maxval=50)
adx_len    = input.int(14, "ADX Length",         minval=1, maxval=50)
show_signal = input.bool(true, "Show Signal Line")
show_zones  = input.bool(false, "Show Zone Backgrounds")
show_adx    = input.bool(true, "Show ADX Histogram")

// === VELOCITY / ACCELERATION ===
raw_velocity = (src - src[vel_len]) / src[vel_len] * 100
velocity     = ta.ema(raw_velocity, 3)
raw_accel    = velocity - velocity[acc_len]
acceleration = ta.ema(raw_accel, 3)
signal_line  = ta.ema(velocity, signal_len)
histogram    = velocity - signal_line

// === ADX + DMI ===
[diplus, diminus, adx_val] = ta.dmi(adx_len, adx_len)

// Directional: positive = bullish, negative = bearish
adx_hist    = diplus > diminus ? adx_val : -adx_val

// ADX strength as 0-100 normalized transparency (strong = vivid, weak = faded)
// adx_val 0..60 mapped to transparency 90..10 (higher adx = lower transparency = more vivid)
adx_strength   = math.min(adx_val, 60)
adx_transp_bar = int(math.round(90 - adx_strength * 1.33))  // 90 at adx=0, ~10 at adx=60

// ADX bar colors with gradient
adx_col_bull = color.new(color.rgb(0, 132, 68), adx_transp_bar)
adx_col_bear = color.new(color.red,  adx_transp_bar)
adx_color    = adx_hist >= 0 ? adx_col_bull : adx_col_bear

// Background: ADX-driven opacity — stronger trend = more visible background
bg_transp = int(math.round(97 - adx_strength * 0.7))  // 97 at adx=0, ~55 at adx=60
bg_col    = adx_hist >= 0 ? color.new(color.lime, bg_transp) : color.new(color.red, bg_transp)

bgcolor(show_zones ? bg_col : na)

// === REGIME DETECTION (for velocity line color) ===
is_rocket    = velocity > 0 and acceleration > 0
is_topping   = velocity > 0 and acceleration < 0
is_freefall  = velocity < 0 and acceleration < 0
is_bottoming = velocity < 0 and acceleration > 0

vel_color  = is_rocket ? color.new(color.lime, 0) : is_topping ? color.new(color.yellow, 0) : is_freefall ? color.new(color.red, 0) : is_bottoming ? color.new(color.orange, 0) : color.new(color.gray, 0)

// === REFERENCE LINES ===
hline(0,   "Zero",   color=color.new(color.white, 60), linestyle=hline.style_solid,  linewidth=1)
hline(25,  "ADX 25", color=color.new(color.white, 85), linestyle=hline.style_dashed, linewidth=1)
hline(-25, "ADX-25", color=color.new(color.white, 85), linestyle=hline.style_dashed, linewidth=1)

// === PLOTS ===

// ADX histogram with strength gradient (behind)
plot(show_adx ? adx_hist : na, "ADX Histogram", color=adx_color, style=plot.style_columns, linewidth=1)


// Acceleration wave (purple above 0, light red below 0)
accel_color = acceleration >= 0 ? color.new(#a221b9, 40) : color.new(#efd723, 62)
plot(acceleration, "Acceleration", color=accel_color, style=plot.style_area, linewidth=1)

// Signal line
plot(show_signal ? signal_line : na, "Signal", color=color.new(color.white, 40), style=plot.style_line, linewidth=1)

// Velocity main line
plot(velocity, "Velocity", color=vel_color, style=plot.style_line, linewidth=3)
