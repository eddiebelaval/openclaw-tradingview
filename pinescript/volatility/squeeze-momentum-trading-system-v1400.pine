//@version=6
indicator("NQ: Squeeze Momentum Trading System v14.0.0", overlay=true, max_bars_back=1000)

// ==========================================
// --- INPUTS: STRATEGY ENGINE ---
// ==========================================
grp_engine  = "🎯 Strategy Core"
use_htf     = input.bool(false, "Use HTF Settings (20 Period)?", tooltip="Default is 10/1.5 for Scalping. Turn this ON for 20/2.0 on higher timeframes.", group=grp_engine)
bb_len      = use_htf ? 20 : input.int(10, "Lookback Period", minval=5, group=grp_engine)
bb_mult     = use_htf ? 2.0 : input.float(1.5, "Standard Deviation", step=0.1, group=grp_engine)
bb_offset   = input.int(3, "Offset (Lag Filter)", group=grp_engine)
use_vwap    = input.bool(true, "Filter via VWAP Baseline", group=grp_engine)

// ==========================================
// --- INPUTS: VISUAL ENGINE ---
// ==========================================
grp_vis     = "💎 Visual Aesthetics"
col_up      = input.color(#00FFFF, "Upper Momentum (Aqua)", group=grp_vis)
col_lo      = input.color(#ff0055, "Lower Momentum (Magenta)", group=grp_vis)
cloud_op    = input.int(92, "Cloud Opacity", minval=0, maxval=100, group=grp_vis)
showBarCol  = input.bool(true, "Enable Momentum Bar Coloring", group=grp_vis)

grp_sqz     = "🌀 Squeeze Analytics"
sqz_thresh  = input.int(20, "Squeeze Threshold (%)", minval=5, maxval=50, group=grp_sqz)
col_sqz     = input.color(color.new(#FF0000, 40), "Squeeze Highlight Color", group=grp_sqz)

// ==========================================
// --- CALCULATIONS ---
// ==========================================
v_val = ta.vwap(hlc3)

[basis, bb_up, bb_lo] = ta.bb(close, bb_len, bb_mult)
float shift_bb_up = bb_up[bb_offset]
float shift_bb_lo = bb_lo[bb_offset]

bw          = (bb_up - bb_lo) / basis
bw_perc     = ta.percentrank(bw, 100) 
is_squeezing = bw_perc < sqz_thresh

bool bullBreak = ta.crossover(close, shift_bb_up)
bool bearBreak = ta.crossunder(close, shift_bb_lo)

bool longCondition  = use_vwap ? (bullBreak and close > v_val) : bullBreak
bool shortCondition = use_vwap ? (bearBreak and close < v_val) : bearBreak

// ==========================================
// --- PLOTTING & GRADIENTS ---
// ==========================================
plot(v_val, "VWAP Baseline", color=color.new(#C0C0C0, 60), style=plot.style_stepline_diamond, linewidth=1)

p_up = plot(bb_up, "Upper Boundary", color=color.new(col_up, 0), offset=bb_offset, linewidth=2)
p_lo = plot(bb_lo, "Lower Boundary", color=color.new(col_lo, 0), offset=bb_offset, linewidth=2)

color fill_col = is_squeezing ? color.new(col_sqz, cloud_op - 10) : color.new(#0000FF, cloud_op)
fill(p_up, p_lo, color=fill_col, title="Squeeze Momentum Cloud")

plotshape(longCondition, "Long Momentum", shape.triangleup, location.belowbar, color=col_up, size=size.small)
plotshape(shortCondition, "Short Momentum", shape.triangledown, location.abovebar, color=col_lo, size=size.small)

barcolor(showBarCol ? (close > shift_bb_up ? col_up : close < shift_bb_lo ? col_lo : na) : na)
bgcolor(is_squeezing ? color.new(col_sqz, 94) : na, title="Squeeze Background Alert")

// Alerts
alertcondition(longCondition, "Squeeze Momentum Buy", "Breakout Above Offset Upper BB")
alertcondition(shortCondition, "Squeeze Momentum Sell", "Breakout Below Offset Lower BB")
