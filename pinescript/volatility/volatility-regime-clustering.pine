//@version=5
indicator("Volatility Regime Clustering", shorttitle="VRC", overlay=true)


// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════
atrLength = input.int(14, "ATR Length", minval=1)
lookback = input.int(200, "Clustering Lookback", minval=50, maxval=500, 
     tooltip="Number of bars for k-means clustering calculation")
numClusters = input.int(3, "Number of Regimes", minval=2, maxval=4,
     tooltip="2=Low/High, 3=Low/Medium/High, 4=Low/Medium/High/Extreme")
smoothing = input.int(3, "Regime Smoothing", minval=1, maxval=10,
     tooltip="Number of consecutive bars required to confirm regime change (prevents false switches)")

// Visual settings
showBgColor = input.bool(true, "Show Background Color")
showLabels = input.bool(true, "Show Regime Labels")
showRiskInfo = input.bool(true, "Show Risk Adjustment Info")
tableSizeOption = input.string("Small", "Info Panel Size", options=["Tiny", "Small", "Normal", "Large"], group="Display")

// Colors for each regime
colorLow = input.color(color.new(color.green, 85), "Low Volatility", group="Colors")
colorMed = input.color(color.new(color.yellow, 85), "Medium Volatility", group="Colors")
colorHigh = input.color(color.new(color.orange, 85), "High Volatility", group="Colors")
colorExtreme = input.color(color.new(color.red, 85), "Extreme Volatility", group="Colors")

// ═══════════════════════════════════════════════════════════════════════════
// VOLATILITY CALCULATION
// ═══════════════════════════════════════════════════════════════════════════
atr = ta.atr(atrLength)
atrNormalized = atr / close * 10000  // Normalize to basis points

// Create array of historical ATR values for clustering
var float[] atrHistory = array.new_float(lookback, 0.0)
array.push(atrHistory, atrNormalized)
if array.size(atrHistory) > lookback
    array.shift(atrHistory)

// ═══════════════════════════════════════════════════════════════════════════
// K-MEANS CLUSTERING IMPLEMENTATION (CORRECTED)
// ═══════════════════════════════════════════════════════════════════════════

// Initialize centroids using min-max range (already sorted by design)
initCentroidsCorrect() =>
    float[] initialCentroids = array.new_float(numClusters)
    
    // Calculate min/max ATR over lookback period
    minATR = array.min(atrHistory)
    maxATR = array.max(atrHistory)
    atrRange = maxATR - minATR
    
    // Distribute centroids evenly across the range (guarantees sorting)
    if numClusters == 1
        array.set(initialCentroids, 0, (minATR + maxATR) / 2)
    else
        for i = 0 to numClusters - 1
            position = i / (numClusters - 1)  // 0.0 to 1.0
            centroidValue = minATR + (atrRange * position)
            array.set(initialCentroids, i, centroidValue)
    
    initialCentroids

// Assign each value to nearest centroid (no changes needed here)
assignClusters(currentCentroids) =>
    int[] clusterAssignments = array.new_int(array.size(atrHistory), 0)
    
    for i = 0 to array.size(atrHistory) - 1
        value = array.get(atrHistory, i)
        minDist = 999999.0
        cluster = 0
        
        for j = 0 to numClusters - 1
            centroid = array.get(currentCentroids, j)
            dist = math.abs(value - centroid)
            if dist < minDist
                minDist := dist
                cluster := j
        
        array.set(clusterAssignments, i, cluster)
    
    clusterAssignments

// Update centroids based on assignments (with safeguards)
updateCentroidsCorrect(clusterAssignments) =>
    float[] newCentroids = array.new_float(numClusters, 0.0)
    int[] counts = array.new_int(numClusters, 0)
    
    // Sum values for each cluster
    for i = 0 to array.size(atrHistory) - 1
        cluster = array.get(clusterAssignments, i)
        value = array.get(atrHistory, i)
        array.set(newCentroids, cluster, array.get(newCentroids, cluster) + value)
        array.set(counts, cluster, array.get(counts, cluster) + 1)
    
    // Calculate means (with protection against empty clusters)
    minATR = array.min(atrHistory)
    maxATR = array.max(atrHistory)
    atrRange = maxATR - minATR
    
    for i = 0 to numClusters - 1
        count = array.get(counts, i)
        if count > 0
            array.set(newCentroids, i, array.get(newCentroids, i) / count)
        else
            // Empty cluster: reinitialize at evenly spaced position
            position = numClusters > 1 ? i / (numClusters - 1) : 0.5
            array.set(newCentroids, i, minATR + (atrRange * position))
    
    newCentroids

// Main k-means with adaptive updates
var float[] centroids = array.new_float(numClusters, 0.0)
var int[] assignments = array.new_int(lookback, 0)
var bool initialized = false

// Initialize on first bar with enough data
if bar_index >= lookback and not initialized
    centroids := initCentroidsCorrect()
    initialized := true

// Update clustering more frequently (every 5 bars instead of 10)
if initialized and bar_index % 5 == 0
    // Run limited iterations for performance
    for iteration = 0 to 2  // 3 iterations per update
        assignments := assignClusters(centroids)
        centroids := updateCentroidsCorrect(assignments)

// ═══════════════════════════════════════════════════════════════════════════
// CURRENT REGIME DETECTION WITH THRESHOLD-BASED SMOOTHING
// ═══════════════════════════════════════════════════════════════════════════

// Find raw regime for current bar
findCurrentRegime() =>
    if not initialized
        0  // Default to low volatility until initialized
    else
        value = atrNormalized
        minDist = 999999.0
        regime = 0
        
        for i = 0 to numClusters - 1
            centroid = array.get(centroids, i)
            dist = math.abs(value - centroid)
            if dist < minDist
                minDist := dist
                regime := i
        regime

rawRegime = findCurrentRegime()

// Threshold-based smoothing: regime changes only after N consecutive bars
var int confirmedRegime = 0
var int candidateRegime = rawRegime
var int candidateCount = 0

if rawRegime != confirmedRegime
    // New regime candidate
    if rawRegime == candidateRegime
        candidateCount += 1
        // Switch regime after 'smoothing' consecutive confirmations
        if candidateCount >= smoothing
            confirmedRegime := rawRegime
            candidateCount := 0
    else
        // Different candidate, reset counter
        candidateRegime := rawRegime
        candidateCount := 1
else
    // Current regime confirmed, reset candidate tracking
    candidateRegime := rawRegime
    candidateCount := 0

currentRegime = confirmedRegime

// Store regime history for statistics (shorter period for more relevant data)
var int[] regimeHistory = array.new_int(50)  // Reduced from 100 to 50 bars
array.push(regimeHistory, currentRegime)
if array.size(regimeHistory) > 50
    array.shift(regimeHistory)

// ═══════════════════════════════════════════════════════════════════════════
// REGIME STATISTICS
// ═══════════════════════════════════════════════════════════════════════════

// Calculate regime stability (percentage of time in current regime over last N bars)
regimeStability = 0.0
if array.size(regimeHistory) >= 10  // Wait for minimum data
    sameRegimeCount = 0
    historySize = array.size(regimeHistory)
    
    for i = 0 to historySize - 1
        if array.get(regimeHistory, i) == currentRegime
            sameRegimeCount += 1
    
    regimeStability := 100 * sameRegimeCount / historySize

// Calculate relative position within current regime (with safety check)
currentCentroid = initialized and numClusters > 0 ? array.get(centroids, currentRegime) : atrNormalized
regimeDeviation = currentCentroid > 0 ? (atrNormalized - currentCentroid) / currentCentroid * 100 : 0.0

// ═══════════════════════════════════════════════════════════════════════════
// RISK MANAGEMENT RECOMMENDATIONS
// ═══════════════════════════════════════════════════════════════════════════

// Risk multipliers based on regime
getRiskMultiplier() =>
    if numClusters == 2
        currentRegime == 0 ? 1.0 : 0.5
    else if numClusters == 3
        currentRegime == 0 ? 1.0 : currentRegime == 1 ? 0.75 : 0.4
    else  // 4 clusters
        currentRegime == 0 ? 1.0 : currentRegime == 1 ? 0.8 : 
             currentRegime == 2 ? 0.5 : 0.25

riskMultiplier = getRiskMultiplier()
recommendedRisk = 100 * riskMultiplier

// ═══════════════════════════════════════════════════════════════════════════
// VISUALIZATION
// ═══════════════════════════════════════════════════════════════════════════

// Background color (only show after initialization)
getBgColor() =>
    if not initialized
        na  // Don't color background during warmup period
    else if numClusters == 2
        currentRegime == 0 ? colorLow : colorHigh
    else if numClusters == 3
        currentRegime == 0 ? colorLow : currentRegime == 1 ? colorMed : colorHigh
    else  // 4 clusters
        currentRegime == 0 ? colorLow : currentRegime == 1 ? colorMed : 
             currentRegime == 2 ? colorHigh : colorExtreme

bgcolor(showBgColor ? getBgColor() : na)

// Regime labels (only after initialization)
getRegimeLabel() =>
    if not initialized
        "WARMUP"
    else if numClusters == 2
        currentRegime == 0 ? "LOW VOL" : "HIGH VOL"
    else if numClusters == 3
        currentRegime == 0 ? "LOW VOL" : currentRegime == 1 ? "MED VOL" : "HIGH VOL"
    else  // 4 clusters
        currentRegime == 0 ? "LOW VOL" : currentRegime == 1 ? "MEDIUM" : 
             currentRegime == 2 ? "HIGH VOL" : "EXTREME"

// Create label on regime change
var label regimeLabel = na
if showLabels and bar_index > 0
    prevRegime = currentRegime[1]
    if currentRegime != prevRegime or bar_index % 50 == 0  // Update label every 50 bars
        label.delete(regimeLabel)
        labelColor = not initialized ? color.new(color.gray, 70) : getBgColor()
        labelText = getRegimeLabel()
        regimeLabel := label.new(bar_index, high, 
             text=labelText, 
             style=label.style_label_down,
             color=labelColor,
             textcolor=color.white,
             size=size.small)

// ═══════════════════════════════════════════════════════════════════════════
// TABLE WITH REGIME INFO
// ═══════════════════════════════════════════════════════════════════════════

// Convert size option to size constant
getTableSize(sizeOption) =>
    sizeOption == "Tiny" ? size.tiny : 
         sizeOption == "Small" ? size.small : 
         sizeOption == "Normal" ? size.normal : size.large

tableTextSize = getTableSize(tableSizeOption)
tableHeaderSize = tableSizeOption == "Tiny" ? size.small : 
     tableSizeOption == "Small" ? size.normal : 
     tableSizeOption == "Normal" ? size.large : size.huge

var table infoTable = table.new(position.top_right, 2, 7, 
     border_width=1, 
     border_color=color.gray,
     frame_width=1,
     frame_color=color.gray)

if barstate.islast and showRiskInfo
    if not initialized
        // Show warmup message
        table.cell(infoTable, 0, 0, "Warming Up...", 
             text_color=color.white, bgcolor=color.new(color.orange, 70), text_size=tableHeaderSize)
        table.cell(infoTable, 1, 0, str.tostring(bar_index) + "/" + str.tostring(lookback), 
             text_color=color.white, bgcolor=color.new(color.orange, 70), text_size=tableHeaderSize)
        
        table.cell(infoTable, 0, 1, "Status", 
             text_color=color.gray, text_size=tableTextSize)
        table.cell(infoTable, 1, 1, "Collecting data...", 
             text_color=color.yellow, text_size=tableTextSize)
    else
        // Normal operation - show all stats
        // Header
        table.cell(infoTable, 0, 0, "Volatility Regime", 
             text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=tableHeaderSize)
        table.cell(infoTable, 1, 0, getRegimeLabel(), 
             text_color=color.white, bgcolor=getBgColor(), text_size=tableHeaderSize)
        
        // ATR info
        table.cell(infoTable, 0, 1, "ATR (bp)", 
             text_color=color.gray, text_size=tableTextSize)
        table.cell(infoTable, 1, 1, str.tostring(atrNormalized, "#.##"), 
             text_color=color.white, text_size=tableTextSize)
        
        // Centroid
        table.cell(infoTable, 0, 2, "Regime Center", 
             text_color=color.gray, text_size=tableTextSize)
        table.cell(infoTable, 1, 2, str.tostring(currentCentroid, "#.##"), 
             text_color=color.white, text_size=tableTextSize)
        
        // Deviation
        table.cell(infoTable, 0, 3, "Deviation", 
             text_color=color.gray, text_size=tableTextSize)
        deviationColor = regimeDeviation > 0 ? color.orange : color.green
        table.cell(infoTable, 1, 3, str.tostring(regimeDeviation, "#.#") + "%", 
             text_color=deviationColor, text_size=tableTextSize)
        
        // Stability
        table.cell(infoTable, 0, 4, "Stability", 
             text_color=color.gray, text_size=tableTextSize)
        stabilityColor = regimeStability > 70 ? color.green : regimeStability > 40 ? color.yellow : color.red
        table.cell(infoTable, 1, 4, str.tostring(regimeStability, "#.#") + "%", 
             text_color=stabilityColor, text_size=tableTextSize)
        
        // Risk recommendation
        table.cell(infoTable, 0, 5, "Risk Multiplier", 
             text_color=color.gray, text_size=tableTextSize)
        table.cell(infoTable, 1, 5, str.tostring(riskMultiplier, "#.##") + "x", 
             text_color=color.white, text_size=tableTextSize)
        
        table.cell(infoTable, 0, 6, "Recommended Size", 
             text_color=color.gray, text_size=tableTextSize)
        table.cell(infoTable, 1, 6, str.tostring(recommendedRisk, "#") + "%", 
             text_color=color.white, text_size=tableTextSize)

// ═══════════════════════════════════════════════════════════════════════════
// PLOTS FOR INDICATOR PANE (OPTIONAL)
// ═══════════════════════════════════════════════════════════════════════════

// Plot ATR normalized
plot(atrNormalized, "ATR Normalized", color=color.white, linewidth=1, display=display.none)

// Plot regime as line
plot(currentRegime, "Current Regime", color=getBgColor(), linewidth=2, display=display.none)

// Plot centroids (conditional via na instead of if blocks)
plot(array.get(centroids, 0), "Cluster 0", color=colorLow, linewidth=1, display=display.none)
plot(numClusters >= 2 ? array.get(centroids, 1) : na, "Cluster 1", color=colorMed, linewidth=1, display=display.none)
plot(numClusters >= 3 ? array.get(centroids, 2) : na, "Cluster 2", color=colorHigh, linewidth=1, display=display.none)
plot(numClusters == 4 ? array.get(centroids, 3) : na, "Cluster 3", color=colorExtreme, linewidth=1, display=display.none)

// Alert conditions
alertcondition(ta.change(currentRegime) != 0, "Regime Change", "Volatility regime changed to {{plot(\"Current Regime\")}}")
alertcondition(currentRegime == numClusters - 1, "Extreme Volatility", "Market entered EXTREME volatility regime")
alertcondition(currentRegime == 0, "Low Volatility", "Market entered LOW volatility regime")
