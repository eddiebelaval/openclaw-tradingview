//@version=6
indicator('Volatility-Adjusted Rate of Change [QuantAlgo]', overlay=false, precision=4)

//              ╔════════════════════════════════╗              //
//              ║      USER-DEFINED SETTINGS     ║              //
//              ╚════════════════════════════════╝              //

var string calculation_settings = '════════ Calculation Parameters ════════'
var string threshold_settings = '════════ Threshold Parameters ════════'
var string visual_settings = '════════ Visualization Settings ════════'

tooltip_sensitivity = 'Scales the normalized momentum value. Lower values (0.3–0.7) compress the oscillator, requiring stronger moves to reach extreme zones — suited for volatile assets or higher timeframes where you want fewer, higher-conviction signals. Medium values (0.8–1.5) provide balanced scaling for most instruments and timeframes — ideal for swing trading on 4H and daily charts. Higher values (1.8–3.0) amplify small price changes, making the oscillator more reactive to minor momentum shifts — best for calm markets or scalping setups where early detection matters. Standard value is 1.0 for neutral scaling.'
tooltip_atr = 'Lookback period for the Average True Range used to normalize price changes. Shorter periods (5–8) make the ATR responsive to recent volatility spikes, causing the oscillator to compress quickly during expansions and expand during contractions — suited for intraday and fast-moving markets. Medium periods (10–16) provide a stable volatility baseline that smooths out day-to-day fluctuations — ideal for swing trading. Longer periods (20–40) create a slowly adapting volatility anchor, making the oscillator more consistent across varying market conditions — best for position trading and trend-following systems. Standard value is 10 for balanced volatility normalization.'
tooltip_ma_type = 'Moving average type used to smooth the raw volatility-adjusted momentum. SMA provides equal weighting across the smoothing window for the most transparent signal. EMA (default) reacts faster to recent momentum changes, producing timelier signals with slightly more noise. WMA applies linearly increasing weight to recent bars for a middle ground. HMA dramatically reduces lag while maintaining smoothness, useful for fast-moving markets. RMA is a smoothed moving average that reacts slowly and steadily, reducing false signals in choppy conditions. VWMA incorporates volume weighting, giving more influence to high-volume bars. DEMA and TEMA are double and triple exponential averages that progressively reduce lag for maximum responsiveness.'
tooltip_smooth = 'Number of bars used by the smoothing moving average. Lower values (1–2) preserve raw momentum detail with minimal lag, showing every twist in the rate of change — suited for scalpers and short-term traders who need immediate feedback. Medium values (3–5) filter out bar-to-bar noise while keeping the oscillator responsive to genuine momentum shifts — ideal for swing trading. Higher values (6–12) produce a heavily smoothed oscillator that only reflects sustained directional pressure, reducing whipsaws at the cost of delayed entries — best for position trading and trend confirmation. Standard value is 3 for effective noise reduction with minimal lag.'
tooltip_preset = 'Select a predefined configuration optimized for different trading styles, timeframes, and market conditions. Presets override the Momentum Sensitivity, ATR Lookback Length, Baseline MA Type, and Smoothing Length settings.\n\nDefault (EMA, Sens 1.0, ATR 10, Smooth 3): Standard configuration suitable for swing trading on 4H and daily charts. Balanced sensitivity and moderate smoothing capture meaningful momentum changes without excessive noise. Ideal for most traders and market conditions.\n\nFast Response (EMA, Sens 1.5, ATR 6, Smooth 2): Aggressive configuration for intraday trading and scalping on 5min–1H charts. Higher sensitivity amplifies small moves, shorter ATR adapts quickly to recent volatility, and minimal smoothing preserves rapid momentum shifts. Best for active traders capitalizing on short-term directional moves.\n\nSmooth Trend (HMA, Sens 0.7, ATR 20, Smooth 6): Conservative configuration for position trading on daily and weekly charts. Lower sensitivity compresses the oscillator to highlight only significant moves, longer ATR provides a stable volatility baseline, and heavier smoothing eliminates minor fluctuations. Best for patient traders seeking high-conviction signals with minimal false positives.'

tooltip_upper_ext = 'Defines the upper boundary of the extreme bullish zone. When the oscillator reaches this level, momentum is exceptionally strong — often indicating climactic buying pressure or a potential exhaustion point. Values between 1.2 and 2.0 work well for most instruments. Higher values reserve the extreme zone for only the most powerful moves, while lower values flag strong momentum more frequently. Standard value is 1.5.'
tooltip_upper_thr = 'The threshold above which the oscillator enters bullish territory. Crossings above this level signal that upward momentum has exceeded normal fluctuation. Values between 0.3 and 0.8 suit most trading styles. Lower values trigger earlier bullish signals with more noise, while higher values require stronger confirmation. Standard value is 0.5.'
tooltip_lower_thr = 'The threshold below which the oscillator enters bearish territory. Crossings below this level signal that downward momentum has exceeded normal fluctuation. Should mirror the Upper Threshold as a negative value for symmetric behavior. Standard value is -0.5.'
tooltip_lower_ext = 'Defines the lower boundary of the extreme bearish zone. When the oscillator reaches this level, selling pressure is exceptionally strong — often indicating panic selling or a potential reversal point. Should mirror the Upper Extreme as a negative value. Standard value is -1.5.'

tooltip_color_preset = 'Pre-configured color schemes optimized for different chart themes and visual preferences. Classic uses traditional green and red. Aqua provides ocean-inspired blues and oranges. Cosmic offers futuristic cyan and purple. Cyber features warm orange and cool cyan contrast. Neon delivers high-contrast yellow and magenta for maximum visibility. Custom allows full color customization using the color pickers below.'
tooltip_bull_col = 'Color applied to the oscillator columns when momentum is bullish, meaning the Volatility-Adjusted Rate of Change has crossed above the upper threshold. Use vibrant, distinctive colors to clearly identify upward momentum zones and potential long opportunities on the oscillator.'
tooltip_bear_col = 'Color applied to the oscillator columns when momentum is bearish, meaning the Volatility-Adjusted Rate of Change has fallen below the lower threshold. Use contrasting warning colors to signal downward momentum zones and potential short opportunities or exits.'
tooltip_neutral_col = 'Color applied to the oscillator columns when momentum is neutral, meaning the Volatility-Adjusted Rate of Change is between the upper and lower thresholds. Subdued colors work best here to visually separate indecisive periods from active momentum zones.'

sensitivity = input.float(1.0, 'Momentum Sensitivity', minval=0.1, step=0.1, group=calculation_settings, tooltip=tooltip_sensitivity)
atr_length = input.int(10, 'ATR Lookback Length', minval=2, group=calculation_settings, tooltip=tooltip_atr)
ma_type = input.string('EMA', 'Baseline MA Type', options=['SMA', 'EMA', 'WMA', 'RMA', 'HMA', 'VWMA', 'DEMA', 'TEMA'], group=calculation_settings, tooltip=tooltip_ma_type)
ma_length = input.int(3, 'Smoothing Length', minval=1, group=calculation_settings, tooltip=tooltip_smooth)
preset_config = input.string('Default', 'Preset Configuration', options=['Default', 'Fast Response', 'Smooth Trend'], group=calculation_settings, tooltip=tooltip_preset)

upper_extreme = input.float(1.5, 'Upper Extreme', step=0.1, group=threshold_settings, tooltip=tooltip_upper_ext)
upper_threshold = input.float(0.5, 'Upper Threshold', step=0.1, group=threshold_settings, tooltip=tooltip_upper_thr)
lower_threshold = input.float(-0.5, 'Lower Threshold', step=0.1, group=threshold_settings, tooltip=tooltip_lower_thr)
lower_extreme = input.float(-1.5, 'Lower Extreme', step=0.1, group=threshold_settings, tooltip=tooltip_lower_ext)

color_preset = input.string('Custom', 'Color Preset', options=['Classic', 'Aqua', 'Cosmic', 'Cyber', 'Neon', 'Custom'], group=visual_settings, tooltip=tooltip_color_preset)
bull_input = input.color(#00ffaa, 'Bullish Color', group=visual_settings, tooltip=tooltip_bull_col)
bear_input = input.color(#ff0000, 'Bearish Color', group=visual_settings, tooltip=tooltip_bear_col)
neutral_input = input.color(#1a1a2e, 'Neutral Color', group=visual_settings, tooltip=tooltip_neutral_col)
color_bars = input.bool(true, 'Color Price Bars', group=visual_settings, tooltip='When enabled, price bars on the chart are colored to match the bullish or bearish state of the oscillator histogram. Bars remain uncolored when the oscillator is in the neutral zone.')

if preset_config == 'Fast Response'
    sensitivity := 1.5
    atr_length := 6
    ma_type := 'EMA'
    ma_length := 2
else if preset_config == 'Smooth Trend'
    sensitivity := 0.7
    atr_length := 20
    ma_type := 'HMA'
    ma_length := 6

[bull_col, bear_col, neutral_col] = switch color_preset
    'Classic' => [#00ff00, #ff0000, #333333]
    'Aqua' => [#00d4ff, #ff8c00, #1a2a3a]
    'Cosmic' => [#49ffce, #9932cc, #1a1a2e]
    'Cyber' => [#00cccc, #ff6600, #1c1c2e]
    'Neon' => [#ffff00, #ff00ff, #1a1a1a]
    'Custom' => [bull_input, bear_input, neutral_input]

//              ╔════════════════════════════════╗              //
//              ║        CORE CALCULATION        ║              //
//              ╚════════════════════════════════╝              //

calc_ma(src, len, type) =>
    switch type
        'SMA' => ta.sma(src, len)
        'EMA' => ta.ema(src, len)
        'WMA' => ta.wma(src, len)
        'RMA' => ta.rma(src, len)
        'HMA' => ta.hma(src, len)
        'VWMA' => ta.vwma(src, len)
        'DEMA' =>
            e1 = ta.ema(src, len)
            2 * e1 - ta.ema(e1, len)
        'TEMA' =>
            e1 = ta.ema(src, len)
            e2 = ta.ema(e1, len)
            3 * e1 - 3 * e2 + ta.ema(e2, len)

price_momentum = ta.change(close) / ta.atr(atr_length)
va_roc = calc_ma(price_momentum * sensitivity, ma_length, ma_type)

is_bullish = va_roc > upper_threshold
is_bearish = va_roc < lower_threshold

turned_bullish = is_bullish and not is_bullish[1]
turned_bearish = is_bearish and not is_bearish[1]
crossed_zero_up = ta.crossover(va_roc, 0.0)
crossed_zero_down = ta.crossunder(va_roc, 0.0)
entered_upper_extreme = ta.crossover(va_roc, upper_extreme)
entered_lower_extreme = ta.crossunder(va_roc, lower_extreme)

//              ╔════════════════════════════════╗              //
//              ║          VISUALIZATION         ║              //
//              ╚════════════════════════════════╝              //

get_momentum_color(val) =>
    val > upper_threshold ? color.from_gradient(val, upper_threshold, upper_extreme, color.new(bull_col, 60), bull_col) :
     val < lower_threshold ? color.from_gradient(val, lower_extreme, lower_threshold, bear_col, color.new(bear_col, 60)) :
     color.new(neutral_col, 50)

plot(va_roc, 'Volatility-Adjusted Rate of Change', color=get_momentum_color(va_roc), style=plot.style_columns, histbase=0)

plot(upper_extreme, 'Upper Extreme Level', color=bull_col, linestyle=plot.linestyle_solid, editable=true)
plot(upper_threshold, 'Upper Threshold Level', color=color.new(bull_col, 50), linestyle=plot.linestyle_solid, editable=true)
plot(lower_threshold, 'Lower Threshold Level', color=color.new(bear_col, 50), linestyle=plot.linestyle_solid, editable=true)
plot(lower_extreme, 'Lower Extreme Level', color=bear_col, linestyle=plot.linestyle_solid, editable=true)

bar_color = color_bars ? is_bullish ? color.from_gradient(va_roc, upper_threshold, upper_extreme, color.new(bull_col, 60), bull_col) : is_bearish ? color.from_gradient(va_roc, lower_extreme, lower_threshold, bear_col, color.new(bear_col, 60)) : na : na
barcolor(bar_color)

//              ╔════════════════════════════════╗              //
//              ║             ALERTS             ║              //
//              ╚════════════════════════════════╝              //

alertcondition(turned_bullish, title='Bullish Momentum Signal', message='Volatility-Adjusted Rate of Change: Bullish momentum confirmed on {{exchange}}:{{ticker}} — {{interval}}')
alertcondition(turned_bearish, title='Bearish Momentum Signal', message='Volatility-Adjusted Rate of Change: Bearish momentum confirmed on {{exchange}}:{{ticker}} — {{interval}}')
alertcondition(turned_bullish or turned_bearish, title='Momentum Direction Changed', message='Volatility-Adjusted Rate of Change: Momentum direction changed on {{exchange}}:{{ticker}} — {{interval}}')
alertcondition(crossed_zero_up, title='Zero Line Cross Up', message='Volatility-Adjusted Rate of Change: Crossed above zero on {{exchange}}:{{ticker}} — {{interval}}')
alertcondition(crossed_zero_down, title='Zero Line Cross Down', message='Volatility-Adjusted Rate of Change: Crossed below zero on {{exchange}}:{{ticker}} — {{interval}}')
alertcondition(entered_upper_extreme, title='Upper Extreme Reached', message='Volatility-Adjusted Rate of Change: Entered upper extreme zone on {{exchange}}:{{ticker}} — {{interval}}')
alertcondition(entered_lower_extreme, title='Lower Extreme Reached', message='Volatility-Adjusted Rate of Change: Entered lower extreme zone on {{exchange}}:{{ticker}} — {{interval}}')

