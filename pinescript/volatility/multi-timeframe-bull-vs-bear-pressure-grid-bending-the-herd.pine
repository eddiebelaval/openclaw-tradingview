//@version=6
indicator("Multi-Timeframe Bull vs Bear Pressure Grid", overlay=true)

//----------------------------------------------------
// Inputs
//----------------------------------------------------
groupGeneral = "General Settings"
lookbackBars = input.int(20, "Lookback Bars", minval=1, group=groupGeneral)
showPercentages = input.bool(true, "Show Bull/Bear %", group=groupGeneral)
showDominance = input.bool(true, "Show Dominance", group=groupGeneral)
showNetScore = input.bool(true, "Show Net Score", group=groupGeneral)

tablePositionInput = input.string(
     "Bottom Center",
     "Table Position",
     options = [
         "Top Left", "Top Center", "Top Right",
         "Middle Left", "Middle Center", "Middle Right",
         "Bottom Left", "Bottom Center", "Bottom Right"
     ],
     group = groupGeneral)

groupTimeframes = "Timeframes"
tf1 = input.timeframe("240", "Timeframe 1", group=groupTimeframes)
tf2 = input.timeframe("60",  "Timeframe 2", group=groupTimeframes)
tf3 = input.timeframe("15",  "Timeframe 3", group=groupTimeframes)
tf4 = input.timeframe("5",   "Timeframe 4", group=groupTimeframes)

groupDisplay = "Display"
textSizeInput = input.string("Small", "Text Size", options=["Tiny", "Small", "Normal", "Large"], group=groupDisplay)

//----------------------------------------------------
// Helpers
//----------------------------------------------------
f_tablePosition(pos) =>
    switch pos
        "Top Left"       => position.top_left
        "Top Center"     => position.top_center
        "Top Right"      => position.top_right
        "Middle Left"    => position.middle_left
        "Middle Center"  => position.middle_center
        "Middle Right"   => position.middle_right
        "Bottom Left"    => position.bottom_left
        "Bottom Center"  => position.bottom_center
        "Bottom Right"   => position.bottom_right

f_textSize(sz) =>
    switch sz
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large

// Manual true range so we control everything directly
f_tr() =>
    prevClose = nz(close[1], close)
    math.max(high - low, math.max(math.abs(high - prevClose), math.abs(low - prevClose)))

// Returns:
// [bullCount, bearCount, bullAvgTR, bearAvgTR, bullPct, bearPct, netScore]
f_stats(len) =>
    float bullCount = 0.0
    float bearCount = 0.0
    float bullTRSum = 0.0
    float bearTRSum = 0.0

    for i = 0 to len - 1
        float o = open[i]
        float c = close[i]
        float h = high[i]
        float l = low[i]
        float pc = nz(close[i + 1], close[i])

        float tr = math.max(h - l, math.max(math.abs(h - pc), math.abs(l - pc)))

        if c > o
            bullCount += 1
            bullTRSum += tr
        else if c < o
            bearCount += 1
            bearTRSum += tr

    float bullAvgTR = bullCount > 0 ? bullTRSum / bullCount : na
    float bearAvgTR = bearCount > 0 ? bearTRSum / bearCount : na

    float totalDirectional = bullCount + bearCount
    float bullPct = totalDirectional > 0 ? bullCount / totalDirectional * 100.0 : na
    float bearPct = totalDirectional > 0 ? bearCount / totalDirectional * 100.0 : na

    float netScore = (bullCount * nz(bullAvgTR, 0)) - (bearCount * nz(bearAvgTR, 0))

    [bullCount, bearCount, bullAvgTR, bearAvgTR, bullPct, bearPct, netScore]

f_dominanceText(bullCount, bearCount, bullAvgTR, bearAvgTR) =>
    bool bullsLeadCount = bullCount > bearCount
    bool bearsLeadCount = bearCount > bullCount
    bool bullsLeadRange = nz(bullAvgTR, 0) > nz(bearAvgTR, 0)
    bool bearsLeadRange = nz(bearAvgTR, 0) > nz(bullAvgTR, 0)

    string result = "Mixed"

    if bullsLeadCount and bullsLeadRange
        result := "Bull Control"
    else if bearsLeadCount and bearsLeadRange
        result := "Bear Control"
    else if bullCount == bearCount and nz(bullAvgTR, 0) == nz(bearAvgTR, 0)
        result := "Balanced"
    else
        result := "Mixed"

    result

f_domBgColor(domText) =>
    domText == "Bull Control" ? color.new(color.green, 75) :
     domText == "Bear Control" ? color.new(color.red, 75) :
     domText == "Balanced" ? color.new(color.gray, 75) :
     color.new(color.orange, 75)

f_countBgColor(bullCount, bearCount) =>
    bullCount > bearCount ? color.new(color.green, 82) :
     bearCount > bullCount ? color.new(color.red, 82) :
     color.new(color.gray, 82)

f_rangeBgColor(bullAvgTR, bearAvgTR) =>
    nz(bullAvgTR, 0) > nz(bearAvgTR, 0) ? color.new(color.green, 82) :
     nz(bearAvgTR, 0) > nz(bullAvgTR, 0) ? color.new(color.red, 82) :
     color.new(color.gray, 82)

f_netBgColor(netScore) =>
    netScore > 0 ? color.new(color.green, 80) :
     netScore < 0 ? color.new(color.red, 80) :
     color.new(color.gray, 80)

f_fmt(v) =>
    na(v) ? "n/a" : str.tostring(v, format.mintick)

f_fmtInt(v) =>
    str.tostring(int(math.round(v)))

//----------------------------------------------------
// MTF calculations
//----------------------------------------------------
[bull1, bear1, bullAtr1, bearAtr1, bullPct1, bearPct1, net1] = request.security(syminfo.tickerid, tf1, f_stats(lookbackBars), lookahead=barmerge.lookahead_off)
[bull2, bear2, bullAtr2, bearAtr2, bullPct2, bearPct2, net2] = request.security(syminfo.tickerid, tf2, f_stats(lookbackBars), lookahead=barmerge.lookahead_off)
[bull3, bear3, bullAtr3, bearAtr3, bullPct3, bearPct3, net3] = request.security(syminfo.tickerid, tf3, f_stats(lookbackBars), lookahead=barmerge.lookahead_off)
[bull4, bear4, bullAtr4, bearAtr4, bullPct4, bearPct4, net4] = request.security(syminfo.tickerid, tf4, f_stats(lookbackBars), lookahead=barmerge.lookahead_off)

dom1 = f_dominanceText(bull1, bear1, bullAtr1, bearAtr1)
dom2 = f_dominanceText(bull2, bear2, bullAtr2, bearAtr2)
dom3 = f_dominanceText(bull3, bear3, bullAtr3, bearAtr3)
dom4 = f_dominanceText(bull4, bear4, bullAtr4, bearAtr4)

//----------------------------------------------------
// Table
//----------------------------------------------------
int cols = showNetScore ? 8 : 7
int rows = 5

var table grid = table.new(f_tablePosition(tablePositionInput), cols, rows, border_width=1)
txtSize = f_textSize(textSizeInput)

if barstate.islast
    table.clear(grid, 0, 0, cols - 1, rows - 1)

    // Header
    table.cell(grid, 0, 0, "TF", text_color=color.white, bgcolor=color.rgb(35, 35, 35), text_size=txtSize)
    table.cell(grid, 1, 0, "Bull Bars", text_color=color.white, bgcolor=color.rgb(35, 35, 35), text_size=txtSize)
    table.cell(grid, 2, 0, "Bear Bars", text_color=color.white, bgcolor=color.rgb(35, 35, 35), text_size=txtSize)
    table.cell(grid, 3, 0, "Bull Avg TR", text_color=color.white, bgcolor=color.rgb(35, 35, 35), text_size=txtSize)
    table.cell(grid, 4, 0, "Bear Avg TR", text_color=color.white, bgcolor=color.rgb(35, 35, 35), text_size=txtSize)
    table.cell(grid, 5, 0, showPercentages ? "Bull / Bear %" : "Count Edge", text_color=color.white, bgcolor=color.rgb(35, 35, 35), text_size=txtSize)
    table.cell(grid, 6, 0, "Dominance", text_color=color.white, bgcolor=color.rgb(35, 35, 35), text_size=txtSize)
    if showNetScore
        table.cell(grid, 7, 0, "Net Score", text_color=color.white, bgcolor=color.rgb(35, 35, 35), text_size=txtSize)

    // 4H row
    countBg1 = f_countBgColor(bull1, bear1)
    rangeBg1 = f_rangeBgColor(bullAtr1, bearAtr1)
    domBg1 = f_domBgColor(dom1)
    netBg1 = f_netBgColor(net1)

    table.cell(grid, 0, 1, tf1, text_size=txtSize, bgcolor=color.new(color.silver, 85))
    table.cell(grid, 1, 1, f_fmtInt(bull1), text_size=txtSize, bgcolor=countBg1)
    table.cell(grid, 2, 1, f_fmtInt(bear1), text_size=txtSize, bgcolor=countBg1)
    table.cell(grid, 3, 1, f_fmt(bullAtr1), text_size=txtSize, bgcolor=rangeBg1)
    table.cell(grid, 4, 1, f_fmt(bearAtr1), text_size=txtSize, bgcolor=rangeBg1)
    table.cell(grid, 5, 1, showPercentages ? (f_fmt(bullPct1) + "% / " + f_fmt(bearPct1) + "%") : f_fmtInt(bull1 - bear1), text_size=txtSize)
    table.cell(grid, 6, 1, showDominance ? dom1 : "", text_size=txtSize, bgcolor=domBg1)
    if showNetScore
        table.cell(grid, 7, 1, f_fmt(net1), text_size=txtSize, bgcolor=netBg1)

    // 1H row
    countBg2 = f_countBgColor(bull2, bear2)
    rangeBg2 = f_rangeBgColor(bullAtr2, bearAtr2)
    domBg2 = f_domBgColor(dom2)
    netBg2 = f_netBgColor(net2)

    table.cell(grid, 0, 2, tf2, text_size=txtSize, bgcolor=color.new(color.silver, 85))
    table.cell(grid, 1, 2, f_fmtInt(bull2), text_size=txtSize, bgcolor=countBg2)
    table.cell(grid, 2, 2, f_fmtInt(bear2), text_size=txtSize, bgcolor=countBg2)
    table.cell(grid, 3, 2, f_fmt(bullAtr2), text_size=txtSize, bgcolor=rangeBg2)
    table.cell(grid, 4, 2, f_fmt(bearAtr2), text_size=txtSize, bgcolor=rangeBg2)
    table.cell(grid, 5, 2, showPercentages ? (f_fmt(bullPct2) + "% / " + f_fmt(bearPct2) + "%") : f_fmtInt(bull2 - bear2), text_size=txtSize)
    table.cell(grid, 6, 2, showDominance ? dom2 : "", text_size=txtSize, bgcolor=domBg2)
    if showNetScore
        table.cell(grid, 7, 2, f_fmt(net2), text_size=txtSize, bgcolor=netBg2)

    // 15M row
    countBg3 = f_countBgColor(bull3, bear3)
    rangeBg3 = f_rangeBgColor(bullAtr3, bearAtr3)
    domBg3 = f_domBgColor(dom3)
    netBg3 = f_netBgColor(net3)

    table.cell(grid, 0, 3, tf3, text_size=txtSize, bgcolor=color.new(color.silver, 85))
    table.cell(grid, 1, 3, f_fmtInt(bull3), text_size=txtSize, bgcolor=countBg3)
    table.cell(grid, 2, 3, f_fmtInt(bear3), text_size=txtSize, bgcolor=countBg3)
    table.cell(grid, 3, 3, f_fmt(bullAtr3), text_size=txtSize, bgcolor=rangeBg3)
    table.cell(grid, 4, 3, f_fmt(bearAtr3), text_size=txtSize, bgcolor=rangeBg3)
    table.cell(grid, 5, 3, showPercentages ? (f_fmt(bullPct3) + "% / " + f_fmt(bearPct3) + "%") : f_fmtInt(bull3 - bear3), text_size=txtSize)
    table.cell(grid, 6, 3, showDominance ? dom3 : "", text_size=txtSize, bgcolor=domBg3)
    if showNetScore
        table.cell(grid, 7, 3, f_fmt(net3), text_size=txtSize, bgcolor=netBg3)

    // 5M row
    countBg4 = f_countBgColor(bull4, bear4)
    rangeBg4 = f_rangeBgColor(bullAtr4, bearAtr4)
    domBg4 = f_domBgColor(dom4)
    netBg4 = f_netBgColor(net4)

    table.cell(grid, 0, 4, tf4, text_size=txtSize, bgcolor=color.new(color.silver, 85))
    table.cell(grid, 1, 4, f_fmtInt(bull4), text_size=txtSize, bgcolor=countBg4)
    table.cell(grid, 2, 4, f_fmtInt(bear4), text_size=txtSize, bgcolor=countBg4)
    table.cell(grid, 3, 4, f_fmt(bullAtr4), text_size=txtSize, bgcolor=rangeBg4)
    table.cell(grid, 4, 4, f_fmt(bearAtr4), text_size=txtSize, bgcolor=rangeBg4)
    table.cell(grid, 5, 4, showPercentages ? (f_fmt(bullPct4) + "% / " + f_fmt(bearPct4) + "%") : f_fmtInt(bull4 - bear4), text_size=txtSize)
    table.cell(grid, 6, 4, showDominance ? dom4 : "", text_size=txtSize, bgcolor=domBg4)
    if showNetScore
        table.cell(grid, 7, 4, f_fmt(net4), text_size=txtSize, bgcolor=netBg4)
