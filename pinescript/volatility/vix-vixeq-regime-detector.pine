//@version=6
//By Henrique Centieiro. Idea suggested by @m_chromatic. Thanks
indicator("VIX-VIXEQ Regime Detector", shorttitle="VIX/VIXEQ Regime", overlay=false)

// ═══════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════

lookback = input.int(100, "Z-Score Lookback Period", minval=20, maxval=500)
showSpread = input.bool(true, "Show Spread (VIXEQ - VIX)", group="Display")
showRatio = input.bool(true, "Show Ratio (VIXEQ / VIX)", group="Display")
showRegimeZones = input.bool(true, "Show Regime Background", group="Display")
showLabels = input.bool(true, "Show Line Labels", group="Display")

// Table settings
tableFontSize = input.string("Normal", "Table Font Size", options=["Small", "Normal", "Large"], group="Table Settings")

// ═══════════════════════════════════════════════════════════════════════
// DATA FETCHING
// ═══════════════════════════════════════════════════════════════════════

vix = request.security("CBOE:VIX", timeframe.period, close)
vixeq = request.security("CBOE:VIXEQ", timeframe.period, close)

// ═══════════════════════════════════════════════════════════════════════
// MODERN COLOR PALETTE
// ═══════════════════════════════════════════════════════════════════════

// Professional color scheme
colorSpreadBull = #26A69A  // Teal
colorSpreadBear = #EF5350  // Red
colorRatioBull = #7E57C2   // Deep Purple
colorRatioBear = #FF7043   // Deep Orange
colorNeutral = #78909C     // Blue Grey

// Regime colors (more vibrant and clear)
colorSystemic = #D32F2F      // Strong Red
colorDispersion = #FF6F00    // Amber/Orange
colorElevated = #FDD835      // Yellow
colorNormal = #43A047        // Green
colorConcentration = #1E88E5 // Blue

// ═══════════════════════════════════════════════════════════════════════
// CALCULATIONS
// ═══════════════════════════════════════════════════════════════════════

// Spread: VIXEQ - VIX
spread = vixeq - vix

// Ratio: VIXEQ / VIX
ratio = vixeq / vix

// Z-Score of Spread
spreadMean = ta.sma(spread, lookback)
spreadStdDev = ta.stdev(spread, lookback)
zScore = (spread - spreadMean) / spreadStdDev

// Moving averages for context
spreadMA = ta.sma(spread, 20)
ratioMA = ta.sma(ratio, 50)

// Ratio scaled for display alongside spread
ratioScaled = (ratio - 1) * 10  // Scale ratio to similar range as spread

// Adaptive regime thresholds based on ratio percentiles
ratioMean = ta.sma(ratio, lookback)
ratioStdDev = ta.stdev(ratio, lookback)

// Calculate adaptive thresholds using percentiles (approximate via z-score)
// Using standard deviations to create dynamic regime bands
concentrationThreshold = ratioMean - 1.0 * ratioStdDev
normalUpperThreshold = ratioMean - 0.25 * ratioStdDev
dispersionThreshold = ratioMean + 0.5 * ratioStdDev
systemicThreshold = ratioMean + 1.5 * ratioStdDev

// ═══════════════════════════════════════════════════════════════════════
// REGIME CLASSIFICATION
// ═══════════════════════════════════════════════════════════════════════

// Regime based on ratio levels
isConcentration = ratio < concentrationThreshold
isNormal = ratio >= concentrationThreshold and ratio < normalUpperThreshold
isElevated = ratio >= normalUpperThreshold and ratio < dispersionThreshold
isDispersion = ratio >= dispersionThreshold and ratio < systemicThreshold
isSystemic = ratio >= systemicThreshold

// Regime colors
regimeColor = isSystemic ? color.new(colorSystemic, 80) :
              isDispersion ? color.new(colorDispersion, 85) :
              isElevated ? color.new(colorElevated, 90) :
              isNormal ? color.new(colorNormal, 95) :
              color.new(colorConcentration, 90)

// ═══════════════════════════════════════════════════════════════════════
// PLOTTING - MAIN PANEL
// ═══════════════════════════════════════════════════════════════════════

// Background shading for regime zones
bgcolor(showRegimeZones ? regimeColor : na, title="Regime Background")

// Spread Plot (Teal/Red)
spreadColor = spread > spreadMA ? color.new(colorSpreadBull, 0) : color.new(colorSpreadBear, 0)
spreadPlot = plot(showSpread ? spread : na, "Spread (VIXEQ-VIX)", spreadColor, 2)
spreadMAPlot = plot(showSpread ? spreadMA : na, "Spread MA(20)", color.new(colorNeutral, 40), 1, plot.style_line)

// Ratio Plot (Purple/Orange) - MAIN SIGNAL
ratioColor = ratio > ratioMA ? color.new(colorRatioBull, 0) : color.new(colorRatioBear, 0)
ratioPlot = plot(showRatio ? ratioScaled : na, "Ratio (×10)", ratioColor, 3)
ratioMAPlot = plot(showRatio ? (ratioMA - 1) * 10 : na, "Ratio MA(50) (×10)", color.new(colorRatioBull, 60), 1)

// Ratio Area Fill (color-coded by regime)
ratioAreaColor = ratio > 1.15 ? color.new(colorSystemic, 85) :
                 ratio > 1.1 ? color.new(colorDispersion, 90) :
                 ratio < 1.0 ? color.new(colorConcentration, 90) :
                 color.new(colorNormal, 92)
zeroLine = 0
fill(plot(showRatio ? zeroLine : na, display=display.none), ratioPlot, ratioAreaColor, title="Ratio Area")

// ═══════════════════════════════════════════════════════════════════════
// LINE LABELS (on the right side)
// ═══════════════════════════════════════════════════════════════════════

if barstate.islast and showLabels
    labelOffset = 5

    // Spread label
    if showSpread
        label.new(
            x=bar_index + labelOffset,
            y=spread,
            text="Spread",
            style=label.style_label_left,
            color=spreadColor,
            textcolor=color.white,
            size=size.small
        )

    // Ratio label (MAIN SIGNAL)
    if showRatio
        label.new(
            x=bar_index + labelOffset,
            y=ratioScaled,
            text="Ratio: " + str.tostring(ratio, "#.##"),
            style=label.style_label_left,
            color=ratioColor,
            textcolor=color.white,
            size=size.small
        )

// ═══════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════

// Regime transition alerts
alertcondition(ta.cross(ratio, dispersionThreshold), "Dispersion Regime", "VIX/VIXEQ ratio crossed dispersion threshold (1.15)")
alertcondition(ta.cross(ratio, systemicThreshold), "Systemic Risk Alert", "VIX/VIXEQ ratio crossed systemic threshold (1.25)")
alertcondition(ta.crossover(ratio, 1.5), "Extreme Ratio Alert", "Ratio crossed above 1.5 - mean reversion setup")
alertcondition(ta.crossunder(ratio, 1.25), "De-escalation Signal", "Ratio fell below 1.25 - exiting systemic regime")
alertcondition(ta.cross(zScore, 2), "Z-Score Extreme", "Spread Z-Score crossed +2σ")
alertcondition(ta.cross(zScore, -2), "Z-Score Extreme Low", "Spread Z-Score crossed -2σ")

// Rapid expansion alert
spreadChange = ta.change(spread, 5)
alertcondition(spreadChange > 2, "Rapid Spread Expansion", "Spread expanded rapidly")

// ═══════════════════════════════════════════════════════════════════════
// INFO TABLE - Enhanced readability
// ═══════════════════════════════════════════════════════════════════════

var table infoTable = table.new(position.top_right, 3, 10, border_width=2)

// Font size conversion
fontSize = tableFontSize == "Small" ? size.small :
           tableFontSize == "Large" ? size.normal :
           size.small

if barstate.islast
    // Header - Key Metrics with better contrast
    table.cell(infoTable, 0, 0, "VIX", bgcolor=color.new(#37474F, 0), text_color=color.white, text_size=fontSize)
    table.cell(infoTable, 1, 0, "VIXEQ", bgcolor=color.new(#37474F, 0), text_color=color.white, text_size=fontSize)
    table.cell(infoTable, 2, 0, "Spread", bgcolor=color.new(#37474F, 0), text_color=color.white, text_size=fontSize)

    // Values Row 1 - Better background for readability
    table.cell(infoTable, 0, 1, str.tostring(vix, "#.##"), bgcolor=color.new(#263238, 0), text_color=color.white, text_size=fontSize)
    table.cell(infoTable, 1, 1, str.tostring(vixeq, "#.##"), bgcolor=color.new(#263238, 0), text_color=color.white, text_size=fontSize)
    spreadColorCell = spread > 0 ? colorSpreadBull : colorSpreadBear
    table.cell(infoTable, 2, 1, str.tostring(spread, "#.##"), bgcolor=color.new(spreadColorCell, 60), text_color=color.white, text_size=fontSize)

    // Ratio Row with emphasis
    table.cell(infoTable, 0, 2, "Ratio", bgcolor=color.new(#37474F, 0), text_color=color.white, text_size=fontSize)
    ratioColorCell = ratio > 1.15 ? colorDispersion : ratio < 1.0 ? colorConcentration : colorNormal
    table.cell(infoTable, 1, 2, str.tostring(ratio, "#.###"), bgcolor=color.new(ratioColorCell, 60), text_color=color.white, text_size=fontSize)
    zColorCell = math.abs(zScore) > 2 ? colorSystemic : math.abs(zScore) > 1 ? colorDispersion : colorNeutral
    table.cell(infoTable, 2, 2, "Z: " + str.tostring(zScore, "#.##") + "σ", bgcolor=color.new(zColorCell, 70), text_color=color.white, text_size=fontSize)

    // Spacer row for better visual separation
    table.cell(infoTable, 0, 3, " ", bgcolor=color.new(#1E1E1E, 0), text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 3, " ", bgcolor=color.new(#1E1E1E, 0), text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 2, 3, " ", bgcolor=color.new(#1E1E1E, 0), text_color=color.gray, text_size=size.tiny)

    // Regime header
    table.cell(infoTable, 0, 4, "Range", bgcolor=color.new(#37474F, 0), text_color=color.white, text_size=fontSize)
    table.cell(infoTable, 1, 4, "Regime", bgcolor=color.new(#37474F, 0), text_color=color.white, text_size=fontSize)
    table.cell(infoTable, 2, 4, "Status", bgcolor=color.new(#37474F, 0), text_color=color.white, text_size=fontSize)

    // Row 5: CONCENTRATION
    concBg = isConcentration ? color.new(colorConcentration, 30) : color.new(#424242, 0)
    concText = isConcentration ? color.white : color.new(color.gray, 40)
    table.cell(infoTable, 0, 5, str.tostring(concentrationThreshold, "#.##"), bgcolor=concBg, text_color=concText, text_size=fontSize)
    table.cell(infoTable, 1, 5, "CONCENTRATION", bgcolor=concBg, text_color=concText, text_size=fontSize)
    table.cell(infoTable, 2, 5, "Mega-cap", bgcolor=concBg, text_color=concText, text_size=fontSize)

    // Row 6: NORMAL
    normBg = isNormal ? color.new(colorNormal, 30) : color.new(#424242, 0)
    normText = isNormal ? color.white : color.new(color.gray, 40)
    table.cell(infoTable, 0, 6, str.tostring(concentrationThreshold, "#.##") + "-" + str.tostring(normalUpperThreshold, "#.##"), bgcolor=normBg, text_color=normText, text_size=fontSize)
    table.cell(infoTable, 1, 6, "NORMAL", bgcolor=normBg, text_color=normText, text_size=fontSize)
    table.cell(infoTable, 2, 6, "Healthy", bgcolor=normBg, text_color=normText, text_size=fontSize)

    // Row 7: ELEVATED
    elevBg = isElevated ? color.new(colorElevated, 30) : color.new(#424242, 0)
    elevText = isElevated ? color.black : color.new(color.gray, 40)
    table.cell(infoTable, 0, 7, str.tostring(normalUpperThreshold, "#.##") + "-" + str.tostring(dispersionThreshold, "#.##"), bgcolor=elevBg, text_color=elevText, text_size=fontSize)
    table.cell(infoTable, 1, 7, "ELEVATED", bgcolor=elevBg, text_color=elevText, text_size=fontSize)
    table.cell(infoTable, 2, 7, "Early Warn", bgcolor=elevBg, text_color=elevText, text_size=fontSize)

    // Row 8: DISPERSION
    dispBg = isDispersion ? color.new(colorDispersion, 30) : color.new(#424242, 0)
    dispText = isDispersion ? color.white : color.new(color.gray, 40)
    table.cell(infoTable, 0, 8, str.tostring(dispersionThreshold, "#.##") + "-" + str.tostring(systemicThreshold, "#.##"), bgcolor=dispBg, text_color=dispText, text_size=fontSize)
    table.cell(infoTable, 1, 8, "DISPERSION", bgcolor=dispBg, text_color=dispText, text_size=fontSize)
    table.cell(infoTable, 2, 8, "Broad Stress", bgcolor=dispBg, text_color=dispText, text_size=fontSize)

    // Row 9: SYSTEMIC
    sysBg = isSystemic ? color.new(colorSystemic, 30) : color.new(#424242, 0)
    sysText = isSystemic ? color.white : color.new(color.gray, 40)
    table.cell(infoTable, 0, 9, "> " + str.tostring(systemicThreshold, "#.##"), bgcolor=sysBg, text_color=sysText, text_size=fontSize)
    table.cell(infoTable, 1, 9, "SYSTEMIC", bgcolor=sysBg, text_color=sysText, text_size=fontSize)
    table.cell(infoTable, 2, 9, "Crisis", bgcolor=sysBg, text_color=sysText, text_size=fontSize)
