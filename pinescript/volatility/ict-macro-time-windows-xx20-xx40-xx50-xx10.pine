//#region[PLOT MACROS]
plotMacro(_show, _LINES, _time, _lbl) =>
    if _show
        macroOC(_LINES, _time, _lbl, dayofweek(time) == dayofweek.friday and syminfo.type != 'crypto')

plotMacro(show1,  _LINES1,  time1,  "00:50 - 01:10")
