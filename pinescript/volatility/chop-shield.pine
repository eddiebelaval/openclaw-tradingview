//@version=5
indicator("Ultimate Chop Shield v10 [Adaptive Vol]", overlay=true)

// --- INPUTS ---
sqzLength = input.int(20, "Squeeze Length")
adxThreshold = input.int(20, "ADX Threshold")
rvolThreshold = input.float(1.2, "RVOL Threshold")
useLunchFilter = input.bool(true, "Color Lunch (11:30-13:30 EST)")

// --- COLORS ---
colorBull  = #ffffff // White
colorBear  = #000000 // Black
colorChop  = #708090 // Slate Blue
colorSignalBull = #00ff00 // Green
colorSignalBear = #ff0000 // Red

// --- TIME FILTERS ---
is_rth = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
is_open = not na(time(timeframe.period, "0930-1015:23456", "America/New_York"))
isLunch = useLunchFilter and (hour == 11 and minute >= 30 or hour == 12 or (hour == 13 and minute <= 30))

// --- LOGIC: CHOP ---
[_, _, adx] = ta.dmi(14, 14)
basis = ta.sma(close, sqzLength)
dev = 2.0 * ta.stdev(close, sqzLength)
upperBB = basis + dev
lowerBB = basis - dev
ma = ta.sma(close, sqzLength)
rangema = ta.sma(high - low, sqzLength)
upperKC = ma + rangema * 1.5
lowerKC = ma - rangema * 1.5
sqzOn = (lowerBB > lowerKC) and (upperBB < upperKC)

// --- ADAPTIVE VOLUME SPIKE LOGIC ---
avgVol = ta.sma(volume, 20)
// During the open, we require 2.5x the average. After 10:15, we only require 1.5x.
// This filters out the standard morning noise.
dynamicMult = is_open ? 2.5 : 1.5
isVolSpike = volume > (avgVol * dynamicMult) and volume > volume[1]

// --- HIGH CONFIDENCE & PRESSURE ---
isSolidBody = (math.abs(close - open) / (high - low)) > 0.7
closeNearHigh = (close - low) / (high - low) > 0.85
closeNearLow = (high - close) / (high - low) > 0.85

bullConf = is_rth and isSolidBody and close > open and closeNearHigh and (volume / avgVol) > rvolThreshold and not sqzOn
bearConf = is_rth and isSolidBody and close < open and closeNearLow and (volume / avgVol) > rvolThreshold and not sqzOn

// --- BAR COLORING ---
isChop = is_rth and (sqzOn or adx < adxThreshold or isLunch)
mainColor = is_rth ? (isChop ? colorChop : (close > open ? colorBull : colorBear)) : na
barcolor(mainColor)

// --- SIGNALS ---
// Diamonds
plotshape(bullConf, "Bull Confidence", shape.diamond, location.abovebar, colorSignalBull, size=size.tiny)
plotshape(bearConf, "Bear Confidence", shape.diamond, location.belowbar, colorSignalBear, size=size.tiny)

// Volume Spike Marker (Only if it's truly "Abnormal")
plotchar(is_rth and isVolSpike ? low : na, "Adaptive Volume Spike", "┃", location.belowbar, color=color.new(#ffeb3b, 0), size=size.tiny)

// --- VISUALS: BACKGROUNDS & VWAP ---
bgcolor(is_rth and sqzOn ? color.new(color.orange, 92) : na)
plot(is_rth ? ta.vwap : na, "VWAP", color=color.blue, style=plot.style_linebr, linewidth=1)
