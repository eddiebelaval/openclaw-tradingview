//@version=5
indicator("Smart Money: Close-Basis 123 & Sweeps [Coding Partner]", shorttitle="SM Pure Line", overlay=true, max_lines_count=500)

// =========================================================================
// 1. INPUT SETTINGS
// =========================================================================
grp_swing = "Volatility Engine (ATR)"
atrLen = input.int(14, title="ATR Length", group=grp_swing)
atrMult = input.float(1.5, title="ATR Multiplier", step=0.1, group=grp_swing)

grp_rules = "Smart Money Rules"
sweepTol = input.float(1.0, title="Max 2B/2T Sweep (%)", step=0.1, group=grp_rules)

grp_trade = "Trade Management"
rrRatio = input.float(2.0, title="Risk:Reward Ratio (1:X)", minval=1.0, maxval=25.0, step=0.5, group=grp_trade)

// --- NEW VISUAL CUSTOMIZATION GROUP ---
grp_vis = "Visual Customization & Colors"
col_line_bull = input.color(color.blue, title="Bullish Setup Line (2B/123B)", group=grp_vis)
col_line_bear = input.color(color.blue, title="Bearish Setup Line (2T/123S)", group=grp_vis)
col_break_bull= input.color(color.lime, title="Bullish Breakout & Label", group=grp_vis)
col_break_bear= input.color(color.red, title="Bearish Breakout & Label", group=grp_vis)

style_2b2t = input.string("Solid", title="2B / 2T Line Style", options=["Solid", "Dashed", "Dotted"], group=grp_vis)
style_123  = input.string("Dashed", title="123 Line Style", options=["Solid", "Dashed", "Dotted"], group=grp_vis)
lineWidth  = input.int(2, title="Main Line Width", minval=1, maxval=4, group=grp_vis)

col_sl = input.color(color.red, title="Stop Loss Line", group=grp_vis)
col_tp = input.color(color.green, title="Take Profit Line", group=grp_vis)

tol = sweepTol / 100

// Helper function to convert string style to line style
get_style(s) =>
    s == "Solid" ? line.style_solid : s == "Dashed" ? line.style_dashed : line.style_dotted

line_style_sweep = get_style(style_2b2t)
line_style_123   = get_style(style_123)

// =========================================================================
// 2. DUAL-CORE ZIGZAG ENGINES (Wick vs Close)
// =========================================================================
atr = ta.atr(atrLen) * atrMult

// Engine A: WICK BASIS (For 2B/2T)
var int dir = 1
var float ch = high
var int ch_bar = bar_index
var float cl = low
var int cl_bar = bar_index

bool new_ph = false
bool new_pl = false

if dir == 1
    if high > ch
        ch := high
        ch_bar := bar_index
    if close < ch - atr 
        dir := -1
        new_ph := true
        cl := low
        cl_bar := bar_index
else
    if low < cl
        cl := low
        cl_bar := bar_index
    if close > cl + atr 
        dir := 1
        new_pl := true
        ch := high
        ch_bar := bar_index

// Engine B: CLOSE BASIS (For 1-2-3)
var int dir_c = 1
var float ch_c = close
var int ch_bar_c = bar_index
var float cl_c = close
var int cl_bar_c = bar_index

bool new_ph_c = false
bool new_pl_c = false

if dir_c == 1
    if close > ch_c
        ch_c := close
        ch_bar_c := bar_index
    if close < ch_c - atr 
        dir_c := -1
        new_ph_c := true
        cl_c := close
        cl_bar_c := bar_index
else
    if close < cl_c
        cl_c := close
        cl_bar_c := bar_index
    if close > cl_c + atr 
        dir_c := 1
        new_pl_c := true
        ch_c := close
        ch_bar_c := bar_index

// =========================================================================
// 3. PIVOT MEMORY (Tracking the Swings)
// =========================================================================
// Wick Memory (2B/2T)
var float last_ph = na
var int last_ph_bar = na
var float prev_ph = na
var int prev_ph_bar = na

var float last_pl = na
var int last_pl_bar = na
var float prev_pl = na
var int prev_pl_bar = na

var bool active_2t = false
var bool sweep_2t_mode = false
var float sweep_2t_high = na

var bool active_2b = false
var bool sweep_2b_mode = false
var float sweep_2b_low = na

if new_ph
    prev_ph := last_ph
    prev_ph_bar := last_ph_bar
    last_ph := ch
    last_ph_bar := ch_bar
    active_2t := true
    sweep_2t_mode := false
    sweep_2t_high := na 

if new_pl
    prev_pl := last_pl
    prev_pl_bar := last_pl_bar
    last_pl := cl
    last_pl_bar := cl_bar
    active_2b := true
    sweep_2b_mode := false
    sweep_2b_low := na 

// Close Memory (123)
var float last_ph_c = na
var int last_ph_bar_c = na
var float prev_ph_c = na
var int prev_ph_bar_c = na

var float last_pl_c = na
var int last_pl_bar_c = na
var float prev_pl_c = na
var int prev_pl_bar_c = na

if new_ph_c
    prev_ph_c := last_ph_c
    prev_ph_bar_c := last_ph_bar_c
    last_ph_c := ch_c
    last_ph_bar_c := ch_bar_c
if new_pl_c
    prev_pl_c := last_pl_c
    prev_pl_bar_c := last_pl_bar_c
    last_pl_c := cl_c
    last_pl_bar_c := cl_bar_c

// =========================================================================
// 4. THE 123 LOGIC ENGINE (Line Chart Basis)
// =========================================================================
var bool active_123b = false
var float trig_123b = na
var float sl_123b = na
var int start_123b = na

var bool active_123s = false
var float trig_123s = na
var float sl_123s = na
var int start_123s = na

if new_pl_c and not na(prev_pl_c) and not na(last_ph_c)
    if last_ph_bar_c > prev_pl_bar_c and last_ph_bar_c < last_pl_bar_c 
        if last_pl_c > prev_pl_c 
            active_123b := true
            trig_123b := last_ph_c
            sl_123b := last_pl_c
            start_123b := last_ph_bar_c

if new_ph_c and not na(prev_ph_c) and not na(last_pl_c)
    if last_pl_bar_c > prev_ph_bar_c and last_pl_bar_c < last_ph_bar_c 
        if last_ph_c < prev_ph_c 
            active_123s := true
            trig_123s := last_pl_c
            sl_123s := last_ph_c
            start_123s := last_pl_bar_c

// =========================================================================
// 5. VISUAL EXECUTION ENGINE
// =========================================================================
bool trigger_2b = false
bool trigger_2t = false
bool trigger_123b = false
bool trigger_123s = false

if active_2b and not na(last_pl) and bar_index > last_pl_bar
    if low < last_pl
        sweep_2b_mode := true
        sweep_2b_low := na(sweep_2b_low) ? low : math.min(sweep_2b_low, low)
    if sweep_2b_mode and ((last_pl - sweep_2b_low) / last_pl) > tol
        active_2b := false
        sweep_2b_mode := false
    if sweep_2b_mode and close > last_pl
        trigger_2b := true
        active_2b := false
        sweep_2b_mode := false

if active_2t and not na(last_ph) and bar_index > last_ph_bar
    if high > last_ph
        sweep_2t_mode := true
        sweep_2t_high := na(sweep_2t_high) ? high : math.max(sweep_2t_high, high)
    if sweep_2t_mode and ((sweep_2t_high - last_ph) / last_ph) > tol
        active_2t := false
        sweep_2t_mode := false
    if sweep_2t_mode and close < last_ph
        trigger_2t := true
        active_2t := false
        sweep_2t_mode := false

if active_123b and close > trig_123b
    trigger_123b := true
    active_123b := false

if active_123s and close < trig_123s
    trigger_123s := true
    active_123s := false

// =========================================================================
// 6. VISUAL TRADE MANAGEMENT & DYNAMIC DRAWING
// =========================================================================
var int trade_dir = 0 
var float stop_loss = na
var float target_price = na
var line sl_line = na
var line tp_line = na

if trigger_2b
    trade_dir := 1
    stop_loss := sweep_2b_low
    target_price := close + ((close - stop_loss) * rrRatio)
    line.new(last_pl_bar, last_pl, bar_index, last_pl, color=col_line_bull, width=lineWidth, style=line_style_sweep)
    sl_line := line.new(bar_index, stop_loss, bar_index, stop_loss, color=col_sl, width=1, style=line.style_dotted)
    tp_line := line.new(bar_index, target_price, bar_index, target_price, color=col_tp, width=1, style=line.style_dotted)
    label.new(bar_index, low, "2B Buy", style=label.style_label_up, color=col_break_bull, textcolor=color.black)

if trigger_2t
    trade_dir := -1
    stop_loss := sweep_2t_high
    target_price := close - ((stop_loss - close) * rrRatio)
    line.new(last_ph_bar, last_ph, bar_index, last_ph, color=col_line_bear, width=lineWidth, style=line_style_sweep)
    sl_line := line.new(bar_index, stop_loss, bar_index, stop_loss, color=col_sl, width=1, style=line.style_dotted)
    tp_line := line.new(bar_index, target_price, bar_index, target_price, color=col_tp, width=1, style=line.style_dotted)
    label.new(bar_index, high, "2T Sell", style=label.style_label_down, color=col_break_bear, textcolor=color.white)

if trigger_123b
    trade_dir := 1
    stop_loss := sl_123b
    target_price := close + ((close - stop_loss) * rrRatio)
    line.new(start_123b, trig_123b, bar_index, trig_123b, color=col_line_bull, width=lineWidth, style=line_style_123)
    sl_line := line.new(bar_index, stop_loss, bar_index, stop_loss, color=col_sl, width=1, style=line.style_dotted)
    tp_line := line.new(bar_index, target_price, bar_index, target_price, color=col_tp, width=1, style=line.style_dotted)
    label.new(bar_index, low, "123 Buy", style=label.style_label_up, color=col_break_bull, textcolor=color.black)

if trigger_123s
    trade_dir := -1
    stop_loss := sl_123s
    target_price := close - ((stop_loss - close) * rrRatio)
    line.new(start_123s, trig_123s, bar_index, trig_123s, color=col_line_bear, width=lineWidth, style=line_style_123)
    sl_line := line.new(bar_index, stop_loss, bar_index, stop_loss, color=col_sl, width=1, style=line.style_dotted)
    tp_line := line.new(bar_index, target_price, bar_index, target_price, color=col_tp, width=1, style=line.style_dotted)
    label.new(bar_index, high, "123 Sell", style=label.style_label_down, color=col_break_bear, textcolor=color.white)

if trade_dir != 0
    if not na(sl_line)
        line.set_x2(sl_line, bar_index)
    if not na(tp_line)
        line.set_x2(tp_line, bar_index)

if trade_dir == 1
    if open < stop_loss or low <= stop_loss or high >= target_price 
        trade_dir := 0

if trade_dir == -1
    if open > stop_loss or high >= stop_loss or low <= target_price 
        trade_dir := 0

// =========================================================================
// 7. HIGHLIGHTS & AESTHETICS (Driven by Custom Colors)
// =========================================================================
c_bg  = trigger_2b or trigger_123b ? color.new(col_break_bull, 85) : trigger_2t or trigger_123s ? color.new(col_break_bear, 85) : na
c_bar = trigger_2b or trigger_123b ? col_break_bull : trigger_2t or trigger_123s ? col_break_bear : na

bgcolor(c_bg, title="Breakout Background")
barcolor(c_bar, title="Breakout Candle Color")
