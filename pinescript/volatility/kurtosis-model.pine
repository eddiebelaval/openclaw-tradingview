// Kurtosis Tailedness v2
// Computes the rolling excess kurtosis of log returns and visualises the
// resulting probability density function (Gram‑Charlier Type A expansion)
// alongside a standard Gaussian reference curve.
// v2 adds an Adam-style online neural network to project kurtosis, plus
// a rolling backtest engine that reports projection MAE.

//@version=6
import PineCoders/VisibleChart/5 as vc
indicator("Kurtosis Tailedness", overlay = false,
     max_polylines_count = 100, max_labels_count = 50)

// ─────────────────── Math Helpers ─────────────────────────────
// math.tanh is not available in Pine Script v6 — implement via math.exp identity:
//   tanh(x) = (e^x - e^(-x)) / (e^x + e^(-x))
// Clamp input to avoid overflow on large |x| (tanh saturates at ±1 beyond ~20)
tanhF(float x) =>
    float xc = math.max(-20.0, math.min(x, 20.0))
    float ep  = math.exp(xc)
    float em  = math.exp(-xc)
    (ep - em) / (ep + em)
    
// ─────────────────────────── Inputs ───────────────────────────
string i_lookback  = input.string("30", "Lookback Period", options = ["30", "60"],
     tooltip = "Rolling window used to compute log-return statistics")
int    i_length    = int(str.tonumber(i_lookback))

int   i_resolution = input.int(200,           "Curve Resolution",
     minval = 50, maxval = 500,
     tooltip = "Number of sample points per curve (higher = smoother)")
bool  i_showBern   = input.bool(true,            "Show Bernoulli Lower Bound",
     tooltip = "Draw the K = −2 curve (minimum possible excess kurtosis,\nrealised by the Bernoulli distribution with p = 0.5)")
color i_kurtColor  = input.color(color.aqua,   "Kurtosis Curve Color")
color i_normColor  = input.color(color.gray,   "Normal Curve Color")
color i_bernColor  = input.color(color.orange,  "Bernoulli Bound Color")
bool  i_showProj   = input.bool(true,           "Show NN Projected Kurtosis Curve")
color i_projColor  = input.color(color.lime,    "Projected Curve Color")

// ── Neural Network hyperparameters ──
float i_lr    = input.float(0.01,  "NN Learning Rate",
     minval = 0.0001, maxval = 1.0, step = 0.001,
     tooltip = "Adam optimizer learning rate. Lower = more stable, slower adaptation.",
     group = "Neural Network")
float i_beta1 = input.float(0.9,   "Adam Beta1 (momentum)",
     minval = 0.5, maxval = 0.9999, step = 0.01,
     tooltip = "Exponential decay rate for first moment estimates.",
     group = "Neural Network")
float i_beta2 = input.float(0.999, "Adam Beta2 (RMSProp)",
     minval = 0.5, maxval = 0.9999, step = 0.001,
     tooltip = "Exponential decay rate for second moment estimates.",
     group = "Neural Network")

// ── Backtest toggle ──
bool  i_showBT = input.bool(true, "Show Backtest Table",
     tooltip = "Display rolling backtest MAE of NN projections vs realized kurtosis.",
     group = "Backtest")

// ───────────────── Visible chart bounds (must run on every bar) ─
int leftVis  = vc.leftBarIndex()
int rightVis = math.min(vc.rightBarIndex(), bar_index + 500)

// ─────────────────────── Log Returns ──────────────────────────
float logRet = math.log(close / close[1])

// ─────────────────── Rolling Mean & Std Dev ───────────────────
float mu    = ta.sma(logRet, i_length)
float sigma = ta.stdev(logRet, i_length)

// ─────────── Excess Kurtosis via 4th Central Moment ───────────
float kurtRaw = 0.0
if bar_index >= i_length and not na(sigma) and sigma > 0
    float sum4 = 0.0
    for i = 0 to i_length - 1
        float dev = nz(logRet[i]) - mu
        float d2  = dev * dev
        sum4 += d2 * d2
    float s2 = sigma * sigma
    kurtRaw := sum4 / i_length / (s2 * s2) - 3.0

// Clamp to keep the Gram‑Charlier expansion well‑behaved
float kurt = math.max(-2.0, math.min(kurtRaw, 30.0))

// ══════════════════════════════════════════════════════════════
//  NEURAL NETWORK — Adam-style online single-layer projection
// ══════════════════════════════════════════════════════════════
//
//  Architecture: 4 lagged kurtosis inputs → linear combination → tanh activation
//  Supervision:  each bar the NN output from the previous bar is compared to
//                the current realized kurtosis; gradients flow back to weights.
//  Optimizer:    Adam (momentum + adaptive second moment).
//
//  Input features (all lagged relative to current bar):
//    x0 = kurt          (most recent)
//    x1 = kurt[L/4]     (quarter lookback ago)
//    x2 = kurt[L/2]     (half lookback ago)
//    x3 = kurt[3*L/4]   (three-quarter lookback ago)
//
//  Forward pass:
//    net    = w0*x0 + w1*x1 + w2*x2 + w3*x3
//    nnOut  = 28.0 * tanh(net / 28.0)          -- softly bounded to (-30, 30)
//
//  Adam constants
float _eps   = 1e-8

// ── Persistent NN state ──
var float w0 = 0.25  // weights initialised to equal contribution
var float w1 = 0.25
var float w2 = 0.25
var float w3 = 0.25

var float m0 = 0.0   // first moment (momentum)
var float m1 = 0.0
var float m2 = 0.0
var float m3 = 0.0

var float v0 = 0.0   // second moment (uncentred variance)
var float v1 = 0.0
var float v2 = 0.0
var float v3 = 0.0

var int   adamT = 0  // time step counter for bias correction

// ── Persistent: store previous bar's inputs for gradient computation ──
var float px0 = 0.0
var float px1 = 0.0
var float px2 = 0.0
var float px3 = 0.0
var float pNet = 0.0  // net activation on previous bar (needed for tanh gradient)

// ── Input features (current bar) ──
int   lag1 = math.max(1, i_length / 4)
int   lag2 = math.max(1, i_length / 2)
int   lag3 = math.max(1, 3 * i_length / 4)

float x0 = kurt
float x1 = nz(kurt[lag1])
float x2 = nz(kurt[lag2])
float x3 = nz(kurt[lag3])

// ── Forward pass (current bar) ──
float netCur = w0 * x0 + w1 * x1 + w2 * x2 + w3 * x3
float nnOut  = 28.0 * tanhF(netCur / 28.0)

// ── Adam weight update using previous bar's prediction error ──
if bar_index > lag3 + 1
    adamT := adamT + 1

    // Prediction error: prev bar's nnOut vs current realized kurt (supervision signal)
    float err    = pNet == 0.0 and px0 == 0.0 ? 0.0 : (28.0 * tanhF(pNet / 28.0)) - kurt
    float dTanh  = 1.0 - tanhF(pNet / 28.0) * tanhF(pNet / 28.0)
    float dLoss  = 2.0 * err * dTanh  // common factor (chain rule through tanh)

    float g0 = dLoss * px0
    float g1 = dLoss * px1
    float g2 = dLoss * px2
    float g3 = dLoss * px3

    // Adam first moment (momentum)
    m0 := i_beta1 * m0 + (1.0 - i_beta1) * g0
    m1 := i_beta1 * m1 + (1.0 - i_beta1) * g1
    m2 := i_beta1 * m2 + (1.0 - i_beta1) * g2
    m3 := i_beta1 * m3 + (1.0 - i_beta1) * g3

    // Adam second moment
    v0 := i_beta2 * v0 + (1.0 - i_beta2) * g0 * g0
    v1 := i_beta2 * v1 + (1.0 - i_beta2) * g1 * g1
    v2 := i_beta2 * v2 + (1.0 - i_beta2) * g2 * g2
    v3 := i_beta2 * v3 + (1.0 - i_beta2) * g3 * g3

    // Bias-corrected estimates
    float tF     = float(adamT)
    float mh0 = m0 / (1.0 - math.pow(i_beta1, tF))
    float mh1 = m1 / (1.0 - math.pow(i_beta1, tF))
    float mh2 = m2 / (1.0 - math.pow(i_beta1, tF))
    float mh3 = m3 / (1.0 - math.pow(i_beta1, tF))

    float vh0 = v0 / (1.0 - math.pow(i_beta2, tF))
    float vh1 = v1 / (1.0 - math.pow(i_beta2, tF))
    float vh2 = v2 / (1.0 - math.pow(i_beta2, tF))
    float vh3 = v3 / (1.0 - math.pow(i_beta2, tF))

    // Weight update
    w0 -= i_lr * mh0 / (math.sqrt(vh0) + _eps)
    w1 -= i_lr * mh1 / (math.sqrt(vh1) + _eps)
    w2 -= i_lr * mh2 / (math.sqrt(vh2) + _eps)
    w3 -= i_lr * mh3 / (math.sqrt(vh3) + _eps)

// Store current bar's inputs for next bar's gradient
px0  := x0
px1  := x1
px2  := x2
px3  := x3
pNet := netCur

// ── NN-based projection (clamped) ──
float kurtProj_nn = math.max(-2.0, math.min(nnOut, 30.0))

// ── Derived NN metrics ──
// Trend: direction NN sees kurtosis heading relative to current
float nnTrendVal  = kurtProj_nn - kurt
// Acceleration: how fast the NN projection itself is changing bar-to-bar
float nnAccelVal  = kurtProj_nn - nz(kurtProj_nn[1], kurtProj_nn)

// ══════════════════════════════════════════════════════════════
//  BACKTEST — rolling MAE of NN projection vs realized kurtosis
// ══════════════════════════════════════════════════════════════
//
//  kurtProj_nn[i_length] is the projection made i_length bars ago.
//  We compare it to the kurtosis realized now (kurt).
//  Rolling MAE = simple moving average of absolute errors over i_length bars.
//
float btError   = math.abs(nz(kurtProj_nn[i_length]) - kurt)
float btMAE     = ta.sma(btError, i_length)

// Count valid backtest samples (bars where we have a full lookback of predictions)
var int btCount = 0
if bar_index >= i_length * 2
    btCount := btCount + 1

// ─────────────────── PDF Helper Functions ─────────────────────
gaussPDF(float z) =>
    1.0 / math.sqrt(2.0 * math.pi) * math.exp(-0.5 * z * z)

gcPDF(float z, float K) =>
    float phi = gaussPDF(z)
    float z2  = z * z
    phi * (1.0 + K / 24.0 * (z2 * z2 - 6.0 * z2 + 3.0))

// ──────────── Persistent drawing object references ────────────
var polyline kurtPoly = na
var polyline normPoly = na
var polyline bernPoly = na
var label    kurtLbl  = na
var label    normLbl  = na
var label    bernLbl  = na
var polyline projPoly = na
var label    projLbl  = na

// ──────────── Info table (top‑right corner, 10 rows) ──────────
var table infoTbl = table.new(position.top_right, 2, 10,
     bgcolor = color.new(color.black, 80), border_width = 1)

// ──────────── Backtest table (bottom-right corner, 3 rows) ────
var table btTbl = table.new(position.bottom_right, 2, 3,
     bgcolor = color.new(color.black, 80), border_width = 1)

// ══════════════════ Draw on the last bar ══════════════════════
if barstate.islast and not na(sigma) and sigma > 0

    // ── Remove previous drawings ──
    if not na(kurtPoly)
        kurtPoly.delete()
    if not na(normPoly)
        normPoly.delete()
    if not na(bernPoly)
        bernPoly.delete()
    if not na(kurtLbl)
        kurtLbl.delete()
    if not na(normLbl)
        normLbl.delete()
    if not na(bernLbl)
        bernLbl.delete()
    if not na(projPoly)
        projPoly.delete()
    if not na(projLbl)
        projLbl.delete()

    // ── Build curve point arrays ──
    array<chart.point> kPts = array.new<chart.point>()
    array<chart.point> nPts = array.new<chart.point>()
    array<chart.point> bPts = array.new<chart.point>()
    array<chart.point> pPts = array.new<chart.point>()

    float zMin     = -4.0
    float zMax     =  4.0
    float zStep    = (zMax - zMin) / (i_resolution - 1)
    int   leftBi   = leftVis
    int   rightBi  = rightVis
    int   span     = math.max(1, rightBi - leftBi)
    float biStep   = 1.0 * span / (i_resolution - 1)

    float peakK   = 0.0
    int   peakKBi = bar_index
    float peakN   = 0.0
    int   peakNBi = bar_index
    float peakB   = 0.0
    int   peakBBi = bar_index
    float peakP   = 0.0
    int   peakPBi = bar_index

    float bernK  = -2.0   // Bernoulli(0.5) excess kurtosis — the absolute lower bound

    for i = 0 to i_resolution - 1
        float z  = zMin + i * zStep
        int   bi = leftBi + math.round(i * biStep)
        float yK = gcPDF(z, kurt)
        float yN = gaussPDF(z)
        float yB = gcPDF(z, bernK)
        float yP = gcPDF(z, kurtProj_nn)

        array.push(kPts, chart.point.from_index(bi, yK))
        array.push(nPts, chart.point.from_index(bi, yN))
        if i_showBern
            array.push(bPts, chart.point.from_index(bi, yB))
        if i_showProj
            array.push(pPts, chart.point.from_index(bi, yP))

        if yK > peakK
            peakK   := yK
            peakKBi := bi
        if yN > peakN
            peakN   := yN
            peakNBi := bi
        if yB > peakB
            peakB   := yB
            peakBBi := bi
        if yP > peakP
            peakP   := yP
            peakPBi := bi

    // Close kurtosis polygon at y = 0 so the fill covers the area under the curve
    array.push(kPts, chart.point.from_index(rightBi, 0.0))
    array.push(kPts, chart.point.from_index(leftBi,  0.0))

    // ── Draw polylines ──
    kurtPoly := polyline.new(kPts, closed = true,
         line_color = i_kurtColor, line_width = 2,
         fill_color = color.new(i_kurtColor, 85))

    normPoly := polyline.new(nPts,
         line_color = i_normColor, line_width = 1,
         line_style = line.style_dashed)

    if i_showBern
        bernPoly := polyline.new(bPts,
             line_color = i_bernColor, line_width = 1,
             line_style = line.style_dotted)

    if i_showProj
        projPoly := polyline.new(pPts,
             line_color = i_projColor, line_width = 2,
             line_style = line.style_dashed)

    // ── Labels at each curve's peak ──
    kurtLbl := label.new(peakKBi, peakK,
         "Kurtosis Dist  (K = " + str.tostring(kurt, "#.##") + ")",
         color     = color.new(i_kurtColor, 80),
         textcolor = i_kurtColor,
         style     = label.style_label_down,
         size      = size.small)

    normLbl := label.new(peakNBi, peakN + peakN * 0.06,
         "Normal Ref  (K = 0)",
         color     = color.new(i_normColor, 80),
         textcolor = color.white,
         style     = label.style_label_down,
         size      = size.small)

    if i_showBern
        bernLbl := label.new(peakBBi, peakB + peakB * 0.06,
             "Bernoulli Lower Bound  (K = −2)",
             color     = color.new(i_bernColor, 80),
             textcolor = i_bernColor,
             style     = label.style_label_down,
             size      = size.small)

    if i_showProj
        projLbl := label.new(peakPBi, peakP + peakP * 0.06,
             "NN Projected  (K = " + str.tostring(kurtProj_nn, "#.##") + ")",
             color     = color.new(i_projColor, 80),
             textcolor = i_projColor,
             style     = label.style_label_down,
             size      = size.small)

    // ── Info table (rows 0-9) ──
    string kType = kurt > 0.5 ? "Leptokurtic  (fat tails)"
         : kurt < -0.5 ? "Platykurtic  (thin tails)"
         : "Mesokurtic  (≈ normal)"
    color tClr = kurt > 0.5 ? color.orange
         : kurt < -0.5 ? color.lime
         : color.white

    // Row 0: Excess Kurtosis
    table.cell(infoTbl, 0, 0, "Excess Kurtosis",
         text_color = color.white, text_size = size.small)
    table.cell(infoTbl, 1, 0, str.tostring(kurt, "#.####"),
         text_color = i_kurtColor,  text_size = size.small)

    // Row 1: Classification
    table.cell(infoTbl, 0, 1, "Classification",
         text_color = color.white, text_size = size.small)
    table.cell(infoTbl, 1, 1, kType,
         text_color = tClr,         text_size = size.small)

    // Row 2: Bernoulli bound
    table.cell(infoTbl, 0, 2, "Lower Bound (Bernoulli)",
         text_color = color.white, text_size = size.small)
    table.cell(infoTbl, 1, 2, "K = −2" + (kurt < -1.5 ? "  ⚠ near bound" : ""),
         text_color = i_bernColor,  text_size = size.small)

    // Row 3: Lookback
    table.cell(infoTbl, 0, 3, "Lookback",
         text_color = color.white, text_size = size.small)
    table.cell(infoTbl, 1, 3, str.tostring(i_length) + " bars",
         text_color = color.white, text_size = size.small)

    // Row 4: NN training steps
    table.cell(infoTbl, 0, 4, "NN Training Steps",
         text_color = color.white, text_size = size.small)
    table.cell(infoTbl, 1, 4, str.tostring(adamT),
         text_color = color.silver, text_size = size.small)

    // Row 5: separator label
    table.cell(infoTbl, 0, 5, "─── NN Projection ───",
         text_color = color.silver, text_size = size.tiny)
    table.cell(infoTbl, 1, 5, "",
         text_color = color.silver, text_size = size.tiny)

    // Row 6: NN Projected K
    table.cell(infoTbl, 0, 6, "NN Projected K",
         text_color = color.white, text_size = size.small)
    table.cell(infoTbl, 1, 6, str.tostring(kurtProj_nn, "#.####"),
         text_color = i_projColor,  text_size = size.small)

    // Row 7: NN Trend direction
    string nnTrendStr = nnTrendVal >= 0.0
         ? "Rising  (" + str.tostring(nnTrendVal, "#.####") + ")"
         : "Falling  (" + str.tostring(nnTrendVal, "#.####") + ")"
    color nnTrendClr  = nnTrendVal >= 0.0 ? color.orange : color.lime

    table.cell(infoTbl, 0, 7, "NN Trend",
         text_color = color.white,  text_size = size.small)
    table.cell(infoTbl, 1, 7, nnTrendStr,
         text_color = nnTrendClr,   text_size = size.small)

    // Row 8: NN Acceleration
    string nnAccelStr = nnAccelVal >= 0.0
         ? "Accelerating  (" + str.tostring(nnAccelVal, "#.####") + ")"
         : "Decelerating  (" + str.tostring(nnAccelVal, "#.####") + ")"
    color nnAccelClr  = nnAccelVal >= 0.0 ? color.orange : color.lime

    table.cell(infoTbl, 0, 8, "NN Acceleration",
         text_color = color.white,  text_size = size.small)
    table.cell(infoTbl, 1, 8, nnAccelStr,
         text_color = nnAccelClr,   text_size = size.small)

    // Row 9: NN weights summary (diagnostic)
    table.cell(infoTbl, 0, 9, "NN Weights (w0..w3)",
         text_color = color.silver, text_size = size.tiny)
    table.cell(infoTbl, 1, 9,
         str.tostring(w0, "#.##") + " " + str.tostring(w1, "#.##") + " " +
         str.tostring(w2, "#.##") + " " + str.tostring(w3, "#.##"),
         text_color = color.silver, text_size = size.tiny)

    // ── Backtest table ──
    if i_showBT
        table.cell(btTbl, 0, 0, "─── Backtest (" + str.tostring(i_length) + "-bar) ───",
             text_color = color.silver, text_size = size.tiny)
        table.cell(btTbl, 1, 0, "",
             text_color = color.silver, text_size = size.tiny)
        table.cell(btTbl, 0, 1, "Rolling MAE",
             text_color = color.white, text_size = size.small)
        table.cell(btTbl, 1, 1, str.tostring(nz(btMAE), "#.####"),
             text_color = btMAE < 1.0 ? color.lime : btMAE < 3.0 ? color.orange : color.red,
             text_size = size.small)
        table.cell(btTbl, 0, 2, "Samples",
             text_color = color.white, text_size = size.small)
        table.cell(btTbl, 1, 2, str.tostring(btCount),
             text_color = color.silver, text_size = size.small)
