//@version=6
indicator("ES Volatility Dashboard", overlay=true, max_lines_count=10)

// ══════════════════════════════════════════════════════════════════
//  DATI
// ══════════════════════════════════════════════════════════════════
vix   = request.security("VIX",   timeframe.period, close)
vix9d = request.security("VIX9D", timeframe.period, close)
vix3m = request.security("VIX3M", timeframe.period, close)
vvix  = request.security("VVIX",  timeframe.period, close)
spx   = request.security("SPX",   timeframe.period, close)

// ══════════════════════════════════════════════════════════════════
//  CALCOLI
// ══════════════════════════════════════════════════════════════════
daily_em   = spx * (vix / 100) / math.sqrt(252)
weekly_em  = spx * (vix / 100) / math.sqrt(52)
monthly_em = spx * (vix / 100) / math.sqrt(12)

slope_9d = vix9d - vix
slope_3m = vix3m - vix
ratio_3m = vix / vix3m

// ══════════════════════════════════════════════════════════════════
//  SEMAFORO — colore + label per ogni metrica
// ══════════════════════════════════════════════════════════════════
//
// ── VIX regime ──────────────────────────────────────────────────


// ── Term structure ───────────────────────────────────────────────
// Slope 9D: più sensibile, segnala stress imminente
f_vix_col(float v) => v < 15 ? color.green : v < 20 ? color.yellow : v < 30 ? color.orange : color.red
f_vix_txt(float v) => v < 15 ? "QUIET" : v < 20 ? "NEUTRAL" : v < 30 ? "STRESS" : "FEAR"

f_slope9_col(float s) => s >= 0 ? color.green : s >= -2 ? color.yellow : s >= -5 ? color.orange : color.red
f_slope9_txt(float s) => s >= 0 ? "NORMAL" : s >= -2 ? "CAUTION" : s >= -5 ? "STRESS" : "FEAR"

f_slope3_col(float s) => s > 3 ? color.green : s >= 0 ? color.yellow : s >= -3 ? color.orange : color.red
f_slope3_txt(float s) => s > 3 ? "CONTINUATION" : s >= 0 ? "NEUTRAL" : s >= -3 ? "CAUTION" : "INVERSION"

f_ratio_col(float r) => r < 0.9 ? color.green : r < 1.0 ? color.yellow : r < 1.1 ? color.orange : color.red
f_ratio_txt(float r) => r < 0.9 ? "CALM" : r < 1.0 ? "ELEVATED" : r < 1.1 ? "STRESS" : "PANIC"

f_vvix_col(float v) => v < 80 ? color.green : v < 100 ? color.yellow : v < 120 ? color.orange : color.red
f_vvix_txt(float v) => v < 80 ? "STABLE" : v < 100 ? "ACTIVE" : v < 120 ? "UNSTABLE" : "VOL SPIKE"

// ── Global risk score (0–4 semaforo unico) ──────────────────────
score =
     (vix > 20 ? 1 : 0) +
     (slope_9d < -2 ? 1 : 0) +
     (ratio_3m > 1 ? 1 : 0) +
     (vvix > 100 ? 1 : 0)

global_col =
     score == 0 ? color.green :
     score == 1 ? color.yellow :
     score == 2 ? color.orange :
                  color.red
global_txt =
     score == 0 ? "● QUIET"  :
     score == 1 ? "● CAUTION" :
     score == 2 ? "● STRESS" :
                  "● FEAR"

// ══════════════════════════════════════════════════════════════════
//  TABELLA
// ══════════════════════════════════════════════════════════════════
var color BG     = color.new(color.black, 25)
var color BG_HDR = color.new(color.black, 10)
var color DIM    = color.new(color.gray,  20)

var table t = table.new(position.top_right, 3, 13,
                         bgcolor      = BG,
                         border_color = color.new(color.gray, 70),
                         border_width = 1,
                         frame_color  = color.new(color.gray, 50),
                         frame_width  = 1)

// Helper riga: label | valore | badge semaforo
row(int r, string lbl, string val, color vcol, string badge, color bcol) =>
    table.cell(t, 0, r, lbl,
               text_color  = DIM,
               text_size   = size.small,
               bgcolor     = BG)
    table.cell(t, 1, r, val,
               text_color  = vcol,
               text_size   = size.small,
               bgcolor     = BG,
               text_halign = text.align_right)
    table.cell(t, 2, r, badge,
               text_color  = bcol,
               text_size   = size.small,
               bgcolor     = color.new(bcol, 80),
               text_halign = text.align_center)

// Helper riga senza badge (Expected Move)
row2(int r, string lbl, string val, color vcol) =>
    table.cell(t, 0, r, lbl,
               text_color  = DIM,
               text_size   = size.small,
               bgcolor     = BG)
    table.cell(t, 1, r, val,
               text_color  = vcol,
               text_size   = size.small,
               bgcolor     = BG,
               text_halign = text.align_right)
    table.cell(t, 2, r, "",
               bgcolor     = BG)

if barstate.islast

    // ── Global header ────────────────────────────────────────
    table.cell(t, 0, 0, "ES VOL  " + global_txt,
               text_color  = global_col,
               text_size   = size.small,
               bgcolor     = color.new(global_col, 80),
               text_halign = text.align_center)
    table.merge_cells(t, 0, 0, 2, 0)

    // ── VIX block ────────────────────────────────────────────
    row(1, "VIX",   str.tostring(vix,   "#.##"), f_vix_col(vix),   f_vix_txt(vix),   f_vix_col(vix))
    row(2, "VIX9D", str.tostring(vix9d, "#.##"), color.white,      "",               BG)
    row(3, "VIX3M", str.tostring(vix3m, "#.##"), color.white,      "",               BG)

    // ── Term structure ───────────────────────────────────────
    table.cell(t, 0, 4, "  TERM STRUCTURE",
               text_color  = DIM,
               text_size   = size.tiny,
               bgcolor     = BG_HDR,
               text_halign = text.align_left)
    table.merge_cells(t, 0, 4, 2, 4)

    row(5, "Slope 9D",   str.tostring(slope_9d, "#.##"), f_slope9_col(slope_9d), f_slope9_txt(slope_9d), f_slope9_col(slope_9d))
    row(6, "Slope 3M",   str.tostring(slope_3m, "#.##"), f_slope3_col(slope_3m), f_slope3_txt(slope_3m), f_slope3_col(slope_3m))
    row(7, "VIX/VIX3M",  str.tostring(ratio_3m, "#.###"), f_ratio_col(ratio_3m), f_ratio_txt(ratio_3m),  f_ratio_col(ratio_3m))
    row(8, "VVIX",       str.tostring(vvix,     "#.##"), f_vvix_col(vvix),       f_vvix_txt(vvix),       f_vvix_col(vvix))

    // ── Expected Move ────────────────────────────────────────
    table.cell(t, 0, 9, "  EXPECTED MOVE (1σ)",
               text_color  = DIM,
               text_size   = size.tiny,
               bgcolor     = BG_HDR,
               text_halign = text.align_left)
    table.merge_cells(t, 0, 9, 2, 9)

    row2(10, "Daily",   "± " + str.tostring(daily_em,   "#.#") + " pt", color.white)
    row2(11, "Weekly",  "± " + str.tostring(weekly_em,  "#.#") + " pt", color.white)
    row2(12, "Monthly", "± " + str.tostring(monthly_em, "#.#") + " pt", color.white)
