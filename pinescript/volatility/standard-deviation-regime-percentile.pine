//@version=6
indicator(
    "Standard Deviation Regime Percentile",
    shorttitle = "SDRegime",
    overlay = false,
    precision = 6
)

//=============================
// Inputs
//=============================
string grpSd = "Standard Deviation"
src = input.source(close, "Source", group = grpSd)
int sdLength = input.int(20, "Length", minval = 2, group = grpSd)
string estimator = input.string(
    "Population (n)",
    "Estimator",
    options = ["Population (n)", "Sample (n-1)"],
    group = grpSd
)

string grpRegime = "Regime"
int regimeLookback = input.int(100, "Percentile Lookback", minval = 5, group = grpRegime)
int lowPctInput = input.int(33, "Low %", minval = 0, maxval = 100, inline = "pct", group = grpRegime)
int highPctInput = input.int(67, "High %", minval = 0, maxval = 100, inline = "pct", group = grpRegime)

// Auto-sort percentiles in case user flips them
int lowPct = lowPctInput <= highPctInput ? lowPctInput : highPctInput
int highPct = lowPctInput <= highPctInput ? highPctInput : lowPctInput

bool useSample = estimator == "Sample (n-1)"

//=============================
// Raw Standard Deviation
//=============================
// SSD = sum(x^2) - (sum(x)^2 / n)
// Population variance = SSD / n
// Sample variance     = SSD / (n - 1)
calcStdDev(float x, int len, bool sample) =>
    float n = float(len)
    float sumX = math.sum(x, len)
    float sumX2 = math.sum(x * x, len)
    float variance = na

    if not na(sumX) and not na(sumX2)
        float ssd = sumX2 - (sumX * sumX) / n
        variance := sample ? ssd / (n - 1.0) : ssd / n

    not na(variance) ? math.sqrt(math.max(variance, 0.0)) : na

float stdev = calcStdDev(src, sdLength, useSample)

//=============================
// Percentile boundaries on SD series
//=============================
float lowBoundary = ta.percentile_nearest_rank(stdev, regimeLookback, lowPct)
float highBoundary = ta.percentile_nearest_rank(stdev, regimeLookback, highPct)

//=============================
// Regime classification
//=============================
string regime = if na(stdev) or na(lowBoundary) or na(highBoundary)
    "NA"
else if stdev < lowBoundary
    "Low"
else if stdev > highBoundary
    "High"
else
    "Mid"

color regimeColor = switch regime
    "Low"  => color.teal
    "High" => color.orange
    "Mid"  => color.gray
    => color.gray

color bgColor = switch regime
    "Low"  => color.new(color.teal, 94)
    "High" => color.new(color.orange, 94)
    "Mid"  => color.new(color.gray, 96)
    => na

//=============================
// Plots
//=============================
plotStdev = plot(
    stdev,
    title = "Standard Deviation",
    color = regimeColor,
    linewidth = 2
)

plotLow = plot(
    lowBoundary,
    title = "Low Percentile Boundary",
    color = color.new(color.teal, 0),
    linewidth = 1
)

plotHigh = plot(
    highBoundary,
    title = "High Percentile Boundary",
    color = color.new(color.orange, 0),
    linewidth = 1
)

fill(plotLow, plotHigh, color = color.new(color.gray, 92), title = "Mid Regime Band")
hline(0.0, "Zero", color = color.new(color.gray, 85))
bgcolor(bgColor, title = "Regime Background")
