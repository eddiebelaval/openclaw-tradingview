//@version=6
// ----------------------------------------------------------------------------
// Capital Leadership Review Weekly
// 2026
//
// Released under the MIT License.
// https://opensource.org/licenses/MIT
//
// Higher-timeframe market context tool for evaluating structural
// leadership characteristics relative to a benchmark.
//
// Research / screening tool only.
// Does not generate trade entries, exits, or execution instructions.
// Educational use only.
// ----------------------------------------------------------------------------

indicator("Capital Leadership Review Weekly", shorttitle="CLR Weekly", overlay=true)

// =====================================================================
// INPUTS
// =====================================================================
groupCore = "Core Logic"
benchmarkSymbol = input.symbol("SPY", "Benchmark Source", group=groupCore)

// Relative leadership
groupRS = "Relative Leadership"
rsFastLen       = input.int(10, "RS Fast Length", minval=2, group=groupRS)
rsSlowLen       = input.int(30, "RS Slow Length", minval=5, group=groupRS)
rsSlopeLookback = input.int(8, "RS Slow Slope Lookback", minval=1, group=groupRS)

// Absolute trend
groupTrend = "Absolute Trend"
trendFastLen       = input.int(10, "Fast SMA Length", minval=2, group=groupTrend)
trendSlowLen       = input.int(30, "Slow SMA Length", minval=5, group=groupTrend)
trendSlopeLookback = input.int(8, "Slow SMA Slope Lookback", minval=1, group=groupTrend)

// Positioning
groupPos = "Range Position"
rangeLookback    = input.int(30, "Range Lookback (Weeks)", minval=5, group=groupPos)
minRangePosition = input.float(0.65, "Minimum Range Position", minval=0.0, maxval=1.0, step=0.05, group=groupPos)
maxPctFromHigh   = input.float(15.0, "Max % Below Range High", minval=0.0, step=0.5, group=groupPos)

// Orderliness
groupOrder = "Trend Orderliness"
orderStdevLen  = input.int(20, "StDev Length", minval=5, group=groupOrder)
orderAtrLen    = input.int(14, "ATR Length", minval=2, group=groupOrder)
maxOrderliness = input.float(2.5, "Max Orderliness Ratio", minval=0.1, step=0.1, group=groupOrder)

// Liquidity
groupLiq = "Liquidity"
liquidityLen     = input.int(20, "Dollar Volume Average Length", minval=2, group=groupLiq)
minDollarVolumeM = input.float(20.0, "Minimum Avg Dollar Volume ($M)", minval=0.0, step=1.0, group=groupLiq)

// Alerts
groupAlerts = "Alerts"
enableAlerts = input.bool(true, "Enable Alert Conditions", group=groupAlerts)

// UI
groupVis = "UI / UX Settings"
panelLoc  = input.string("Top Right", "Panel Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=groupVis)
panelSize = input.string("Normal", "Text Size", options=["Small", "Normal", "Large"], group=groupVis)

// =====================================================================
// HELPERS
// =====================================================================
f_pos(_panelLoc) =>
    _panelLoc == "Top Right" ? position.top_right :
     _panelLoc == "Bottom Right" ? position.bottom_right :
     _panelLoc == "Top Left" ? position.top_left :
     position.bottom_left

f_txt_size(_panelSize) =>
    _panelSize == "Small" ? size.small :
     _panelSize == "Large" ? size.large :
     size.normal

f_pass_fail(_cond) =>
    _cond ? "PASS" : "FAIL"

// =====================================================================
// CONFIRMED WEEKLY DATA
// Uses prior completed weekly bar values so results remain stable when
// viewed on lower timeframes.
// =====================================================================
wClose = request.security(syminfo.tickerid, "W", close[1], lookahead=barmerge.lookahead_on)
wHigh  = request.security(syminfo.tickerid, "W", high[1],  lookahead=barmerge.lookahead_on)
wLow   = request.security(syminfo.tickerid, "W", low[1],   lookahead=barmerge.lookahead_on)
wVol   = request.security(syminfo.tickerid, "W", volume[1], lookahead=barmerge.lookahead_on)

bClose = request.security(benchmarkSymbol, "W", close[1], lookahead=barmerge.lookahead_on)

// =====================================================================
// 1) RELATIVE LEADERSHIP
// =====================================================================
rsLine = wClose / math.max(bClose, 0.001)
rsFast = ta.sma(rsLine, rsFastLen)
rsSlow = ta.sma(rsLine, rsSlowLen)
reqRS  = rsFast > rsSlow and rsSlow > rsSlow[rsSlopeLookback]

// =====================================================================
// 2) ABSOLUTE TREND CONFIRMATION
// =====================================================================
trendFast = ta.sma(wClose, trendFastLen)
trendSlow = ta.sma(wClose, trendSlowLen)
reqTrend  = trendFast > trendSlow and wClose > trendSlow and trendSlow > trendSlow[trendSlopeLookback]

// =====================================================================
// 3) UPPER-RANGE POSITION
// =====================================================================
rangeHigh = ta.highest(wHigh, rangeLookback)
rangeLow  = ta.lowest(wLow, rangeLookback)

rangePos = (wClose - rangeLow) / math.max(rangeHigh - rangeLow, 1e-10)
pctFromHigh = (rangeHigh - wClose) / math.max(rangeHigh, 0.001) * 100.0

reqPosition = rangePos >= minRangePosition and pctFromHigh <= maxPctFromHigh

// =====================================================================
// 4) VOLATILITY-ADJUSTED TREND ORDERLINESS
// Note: ATR reconstructed from weekly OHLC series
// =====================================================================
wPrevClose = wClose[1]
wTR = math.max(wHigh - wLow, math.max(math.abs(wHigh - wPrevClose), math.abs(wLow - wPrevClose)))
wATR = ta.rma(wTR, orderAtrLen)

orderliness = ta.stdev(wClose, orderStdevLen) / math.max(wATR, 0.001)
reqOrderly = orderliness <= maxOrderliness

// =====================================================================
// 5) LIQUIDITY
// =====================================================================
avgDollarVol = ta.sma(wClose * wVol, liquidityLen)
minDollarVolume = minDollarVolumeM * 1000000.0
reqLiquidity = avgDollarVol >= minDollarVolume

// =====================================================================
// COMPOSITE STATE
// =====================================================================
score = (reqRS ? 1 : 0) + (reqTrend ? 1 : 0) + (reqPosition ? 1 : 0) + (reqOrderly ? 1 : 0) + (reqLiquidity ? 1 : 0)
leadershipConditionsMet = score >= 4

// =====================================================================
// STATE DURATION
// Duration is tracked in completed weekly bars.
// =====================================================================
var int stateWeeks = 1

if timeframe.change("W")
    bool prevState = bar_index > 0 ? leadershipConditionsMet[1] : leadershipConditionsMet
    if leadershipConditionsMet == prevState
        stateWeeks += 1
    else
        stateWeeks := 1

// =====================================================================
// ALERTS
// =====================================================================
stateImproved = enableAlerts and leadershipConditionsMet and not leadershipConditionsMet[1]
stateDeteriorated = enableAlerts and not leadershipConditionsMet and leadershipConditionsMet[1]

alertcondition(stateImproved, "Leadership conditions improved", "Leadership conditions improved for {{ticker}}.")
alertcondition(stateDeteriorated, "Leadership conditions deteriorated", "Leadership conditions deteriorated for {{ticker}}.")

// =====================================================================
// PANEL
// =====================================================================
txt = f_txt_size(panelSize)
var table panel = table.new(f_pos(panelLoc), 1, 8, border_width=1, frame_color=color.gray)

if barstate.islast
    headerText = leadershipConditionsMet ? "LEADERSHIP CONDITIONS MET" : "LEADERSHIP CONDITIONS NOT MET"
    headerBg   = leadershipConditionsMet ? color.new(color.lime, 15) : color.new(color.gray, 20)

    table.cell(panel, 0, 0, headerText, bgcolor=headerBg, text_color=color.white, text_size=txt)
    table.cell(panel, 0, 1, "State Duration: " + str.tostring(stateWeeks) + " weeks", text_color=color.white, text_size=txt)
    table.cell(panel, 0, 2, "Leadership Score: " + str.tostring(score) + " / 5", text_color=color.white, text_size=txt)
    table.cell(panel, 0, 3, "Relative Strength: " + f_pass_fail(reqRS), text_color=reqRS ? color.lime : color.red, text_size=size.small)
    table.cell(panel, 0, 4, "Trend Structure: " + f_pass_fail(reqTrend), text_color=reqTrend ? color.lime : color.red, text_size=size.small)
    table.cell(panel, 0, 5, "Range Position: " + f_pass_fail(reqPosition), text_color=reqPosition ? color.lime : color.red, text_size=size.small)
    table.cell(panel, 0, 6, "Orderliness: " + f_pass_fail(reqOrderly), text_color=reqOrderly ? color.lime : color.red, text_size=size.small)
    table.cell(panel, 0, 7, "Liquidity: " + f_pass_fail(reqLiquidity), text_color=reqLiquidity ? color.lime : color.red, text_size=size.small)
