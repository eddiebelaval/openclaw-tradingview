//@version=6
indicator("Liquidity Pressure Index (LPI)", overlay = false)

//================ INPUTS =================
oi_symbol = input.symbol("BINANCE:BTCUSDT.P_OI","OI Symbol")

vol_len = input.int(20,"Volume Avg")
atr_len = input.int(14,"ATR Length")
smooth = input.int(5,"LPI Smoothing")

//================ CORE =================
vwap = ta.vwap(hlc3)
atr = ta.atr(atr_len)

//================ VOLUME SCORE =================
vol_avg = ta.sma(volume, vol_len)
vol_score = volume / vol_avg

//================ OI SCORE =================
oi = request.security(oi_symbol, timeframe.period, close)
oi_delta = (oi - oi[1]) / oi
oi_score = oi_delta * 10

//================ RANGE SCORE =================
candle_range = high - low
range_score = candle_range / atr

//================ VWAP DISTANCE =================
dist = math.abs(close - vwap)
vwap_score = dist / atr

//================ LPI =================
raw_lpi = vol_score + oi_score + range_score + vwap_score
lpi = ta.ema(raw_lpi, smooth)

//================ DIRECTIONAL PRESSURE =================
bull_pressure = lpi * (close > vwap ? 1 : 0)
bear_pressure = lpi * (close < vwap ? 1 : 0)

//================ PLOTS =================
plot(lpi, color=color.white, linewidth=2, title="LPI")

plot(bull_pressure, color=color.green, style=plot.style_columns, title="Bull Pressure")
plot(bear_pressure, color=color.red, style=plot.style_columns, title="Bear Pressure")

hline(2, "Low Pressure", color=color.gray)
hline(4, "Expansion", color=color.orange)
hline(6, "Ignition", color=color.red)
