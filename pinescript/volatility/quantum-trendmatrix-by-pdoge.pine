//@version=6
// Quantum TrendMatrix — dynamic Supertrend with MTF dashboard.

indicator("Quantum TrendMatrix", overlay=true, shorttitle="QTM", format=format.price, precision=2)

// ─── Inputs ───────────────────────────────────────────────────────────────────
atrPeriod      = input.int(10,    title="ATR Period",              minval=1)
source         = input.source(hl2, title="Source")
baseMultiplier = input.float(3.0,  title="ATR Multiplier",         step=0.1)
useDynamicMult = input.bool(true,  title="Use Dynamic Multiplier?")
lookback       = input.int(20,    title="Dynamic Lookback",        minval=1)
sensitivity    = input.float(0.5,  title="Volatility Sensitivity", step=0.1)
useRMAatr      = input.bool(true,  title="Use RMA ATR instead of SMA?")
showSignals    = input.bool(true,  title="Show Buy/Sell Signals?")
highlighting   = input.bool(true,  title="Highlight Trend?")
enableMTF      = input.bool(true,  title="Show MTF Dashboard?")

// ─── Dashboard timeframe lists ────────────────────────────────────────────────
tfList  = array.from("5", "15", "30", "60", "240", "720", "D")
tfLabel = array.from("5m", "15m", "30m", "1h", "4h", "12h", "1D")

// ─── Dynamic Supertrend function ──────────────────────────────────────────────
calcST(_src, _period, _multBase, _useDyn, _lb, _sens, _useRMA) =>
    atrSMA    = ta.sma(ta.tr(true), _period)
    atrRMA    = ta.atr(_period)
    atrVal    = _useRMA ? atrRMA : atrSMA
    avgAtr    = ta.sma(atrVal, _lb)
    ratio     = avgAtr > 0 ? (atrVal - avgAtr) / avgAtr : 0.0
    mult      = _useDyn ? _multBase * (1 + _sens * ratio) : _multBase

    upperBasic = _src + mult * atrVal
    lowerBasic = _src - mult * atrVal

    var float upperBand = na
    var float lowerBand = na
    var int   dir       = 1

    upperBand := nz(upperBand[1], upperBasic)
    lowerBand := nz(lowerBand[1], lowerBasic)

    upperBand := close[1] < upperBand ? math.min(upperBasic, upperBand) : upperBasic
    lowerBand := close[1] > lowerBand ? math.max(lowerBasic, lowerBand) : lowerBasic

    dir := nz(dir[1], 1)
    dir := dir == -1 and close > upperBand[1] ? 1 : dir == 1 and close < lowerBand[1] ? -1 : dir

    trendLine = dir == 1 ? lowerBand : upperBand
    [dir, trendLine]

// ─── Current timeframe Supertrend ─────────────────────────────────────────────
[curDir, curLine] = calcST(source, atrPeriod, baseMultiplier, useDynamicMult, lookback, sensitivity, useRMAatr)

// ─── MTF Supertrend — all request.security calls at TOP-LEVEL scope ───────────
[tfDir0, _l0] = request.security(syminfo.tickerid, array.get(tfList, 0), calcST(source, atrPeriod, baseMultiplier, useDynamicMult, lookback, sensitivity, useRMAatr), barmerge.gaps_off, barmerge.lookahead_off)
[tfDir1, _l1] = request.security(syminfo.tickerid, array.get(tfList, 1), calcST(source, atrPeriod, baseMultiplier, useDynamicMult, lookback, sensitivity, useRMAatr), barmerge.gaps_off, barmerge.lookahead_off)
[tfDir2, _l2] = request.security(syminfo.tickerid, array.get(tfList, 2), calcST(source, atrPeriod, baseMultiplier, useDynamicMult, lookback, sensitivity, useRMAatr), barmerge.gaps_off, barmerge.lookahead_off)
[tfDir3, _l3] = request.security(syminfo.tickerid, array.get(tfList, 3), calcST(source, atrPeriod, baseMultiplier, useDynamicMult, lookback, sensitivity, useRMAatr), barmerge.gaps_off, barmerge.lookahead_off)
[tfDir4, _l4] = request.security(syminfo.tickerid, array.get(tfList, 4), calcST(source, atrPeriod, baseMultiplier, useDynamicMult, lookback, sensitivity, useRMAatr), barmerge.gaps_off, barmerge.lookahead_off)
[tfDir5, _l5] = request.security(syminfo.tickerid, array.get(tfList, 5), calcST(source, atrPeriod, baseMultiplier, useDynamicMult, lookback, sensitivity, useRMAatr), barmerge.gaps_off, barmerge.lookahead_off)
[tfDir6, _l6] = request.security(syminfo.tickerid, array.get(tfList, 6), calcST(source, atrPeriod, baseMultiplier, useDynamicMult, lookback, sensitivity, useRMAatr), barmerge.gaps_off, barmerge.lookahead_off)

tfDirs = array.from(tfDir0, tfDir1, tfDir2, tfDir3, tfDir4, tfDir5, tfDir6)

// ─── Plot ─────────────────────────────────────────────────────────────────────
bullLine = plot(curDir == 1  ? curLine : na, title="Up Trend",   color=color.green, linewidth=2, style=plot.style_linebr)
bearLine = plot(curDir == -1 ? curLine : na, title="Down Trend", color=color.red,   linewidth=2, style=plot.style_linebr)

// ─── Signals ──────────────────────────────────────────────────────────────────
buySignal  = curDir == 1  and curDir[1] == -1
sellSignal = curDir == -1 and curDir[1] == 1

// FIX: Extract ta.atr() outside the ternary so it is computed on every bar,
//      then use the pre-computed value inside the condition expression.
atrValue = ta.atr(atrPeriod)

plotshape(showSignals and buySignal  ? low  - atrValue : na,
          title="Buy",  text="Buy",  location=location.absolute,
          style=shape.labelup,   color=color.green, textcolor=color.white, size=size.tiny)

plotshape(showSignals and sellSignal ? high + atrValue : na,
          title="Sell", text="Sell", location=location.absolute,
          style=shape.labeldown, color=color.red,   textcolor=color.white, size=size.tiny)

// ─── Highlighting ─────────────────────────────────────────────────────────────
mPlot         = plot(ohlc4, title="", style=plot.style_circles, linewidth=1)
fillColorUp   = highlighting ? (curDir == 1  ? color.new(color.green, 85) : color.new(color.white, 100)) : color.new(color.white, 100)
fillColorDown = highlighting ? (curDir == -1 ? color.new(color.red,   85) : color.new(color.white, 100)) : color.new(color.white, 100)
fill(mPlot, bullLine, title="Highlight Up",   color=fillColorUp)
fill(mPlot, bearLine, title="Highlight Down", color=fillColorDown)

// ─── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(buySignal,           title="Quantum TrendMatrix Buy",              message="Quantum TrendMatrix Buy!")
alertcondition(sellSignal,          title="Quantum TrendMatrix Sell",             message="Quantum TrendMatrix Sell!")
alertcondition(curDir != curDir[1], title="Quantum TrendMatrix Direction Change", message="Quantum TrendMatrix direction change!")

// ─── MTF Dashboard ────────────────────────────────────────────────────────────
if enableMTF
    var table mtfTable = na
    if barstate.isfirst
        mtfTable := table.new(position.bottom_right, 2, array.size(tfList) + 1,
                              border_width=1, border_color=color.gray)
        table.cell(mtfTable, 0, 0, "TF",    text_color=color.white, bgcolor=color.black, text_size=size.tiny)
        table.cell(mtfTable, 1, 0, "Trend", text_color=color.white, bgcolor=color.black, text_size=size.tiny)

    for i = 0 to array.size(tfList) - 1
        string lbl    = array.get(tfLabel, i)
        int    tfDir  = array.get(tfDirs,  i)
        string arrow  = tfDir == 1 ? "▲" : tfDir == -1 ? "▼" : "-"
        color  cellBg = tfDir == 1 ? color.new(color.green, 80) : tfDir == -1 ? color.new(color.red, 80) : color.new(color.gray, 80)
        table.cell(mtfTable, 0, i + 1, lbl,   text_color=color.white, bgcolor=color.black, text_size=size.tiny)
        table.cell(mtfTable, 1, i + 1, arrow, text_color=color.white, bgcolor=cellBg,      text_size=size.tiny)

// End of script
