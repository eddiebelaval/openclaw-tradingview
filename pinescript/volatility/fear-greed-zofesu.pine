//@version=6
indicator('Fear & Greed [Zofesu]', overlay=true, shorttitle='Zofesu - F&G')

// --- INPUTS ---
group_main   = "Basic Settings"
source       = input.source(ohlc4, title='Source', group=group_main)
lookback_cal = input.int(300, title='Historical Sample (Calibration)', minval=42, group=group_main)

group_vol    = "Volume Filter"
vol_target   = input.float(98, title="Target Volume Percentile (0-100)", minval=0, maxval=100, group=group_vol)

group_mtf    = "Multi-Timeframe"
htf_val      = input.timeframe("480", title="Higher Timeframe (HTF)", group=group_mtf)
show_htf     = input.bool(true, title="Show HTF Tags", group=group_mtf)

// --- COMPUTATIONAL LOGIC ---
calc_fg(src, vol, lb, v_pct) =>
    // Raw emotions - distance from 30-bar extremes
    g_raw = (src - ta.lowest(src, 30)) / math.max(src, 1e-6)
    f_raw = (ta.highest(src, 30) - src) / math.max(src, 1e-6)
    
    // Self-calibration via Percentile Rank
    g_rank = ta.percentrank(g_raw, lb)
    f_rank = ta.percentrank(f_raw, lb)
    v_rank = ta.percentrank(vol, lb)
    
    is_greed = g_rank > 94 and v_rank > v_pct
    is_fear  = f_rank > 94 and v_rank > v_pct
    [is_greed, is_fear]

// --- CALCULATIONS FOR CURRENT TF ---
[curr_greed, curr_fear] = calc_fg(source, volume, lookback_cal, vol_target)

// --- CALCULATIONS FOR HTF ---
// Requesting raw data to ensure stability and avoid repainting
htf_src = request.security(syminfo.tickerid, htf_val, source, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
htf_vol = request.security(syminfo.tickerid, htf_val, volume, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[htf_greed, htf_fear] = calc_fg(htf_src, htf_vol, lookback_cal, vol_target)

// --- VISUALIZATION ---

// Current Timeframe (White highlight for extremes)
barcolor(curr_greed ? color.new(#ffffff, 0) : curr_fear ? color.new(#ffffff, 0) : na)

// Signal Dots (Local extremes)
plotshape(curr_greed and not curr_greed[1], "Greed Dot", shape.circle, location.abovebar, color.green, size=size.tiny)
plotshape(curr_fear and not curr_fear[1], "Fear Dot", shape.circle, location.belowbar, color.red, size=size.tiny)

// HTF Tags (Higher timeframe confirmation)
plotshape(show_htf and htf_greed and not htf_greed[1], "HTF Greed Label", shape.labeldown, location.abovebar, color.rgb(2, 177, 8), size=size.small, text="G", textcolor=color.white)
plotshape(show_htf and htf_fear and not htf_fear[1], "HTF Fear Label", shape.labelup, location.belowbar, color.rgb(212, 2, 2), size=size.small, text="F", textcolor=color.white)

// --- ALERTS ---
if curr_greed and not curr_greed[1]
    alert("Zofesu F&G: Auto-Greed detected!", alert.freq_once_per_bar)
if curr_fear and not curr_fear[1]
    alert("Zofesu F&G: Auto-Fear detected!", alert.freq_once_per_bar)
