//@version=6
indicator("Squeeze Zones S/R AA",
     overlay=true, max_boxes_count=500, max_lines_count=500)

//──────────────────────────────────────────────────────────────────────────────
// Zones (visuals + capacity)
//──────────────────────────────────────────────────────────────────────────────
groupZones = "Zones"
fillColor  = input.color(color.rgb(8, 153, 129, 70), "Fill Color", group=groupZones)
edgeColor  = input.color(color.rgb(242, 54, 69, 70), "Border",     group=groupZones)
maxZones   = input.int(200, "Max Zones", minval=1, group=groupZones)

activeFill = color.new(fillColor, 50)
frozenFill = color.new(fillColor, 50)
activeEdge = edgeColor
frozenEdge = color.new(edgeColor, 60)

// Midline styling
midActiveCol = color.new(color.white, 0)
midFrozenCol = color.new(color.white, 70)

//──────────────────────────────────────────────────────────────────────────────
// Vertical Zone Control
//──────────────────────────────────────────────────────────────────────────────
groupV = "Vertical Zone Control"
atrLowMulti  = input.float(0.5, "Minimum Zone Width (ATR)", step=0.1, minval=0.0, group=groupV)
atrHighMulti = input.float(2.5, "Maximum Zone Width (ATR)", step=0.1, minval=0.0, group=groupV)

// ATR helper
atrWidth(_multi) =>
    nz(ta.atr(200) * _multi, ta.cum(high - low) / (bar_index + 1))

//──────────────────────────────────────────────────────────────────────────────
// Squeeze (BB in KC)
//──────────────────────────────────────────────────────────────────────────────
groupSQZ       = "Squeeze (BB in KC)"
sqz_length     = input.int(14, "Length", minval=2, group=groupSQZ)
bb_mult        = input.float(2.0, "BB Multiplier", group=groupSQZ)
kc_mult        = input.float(1.5, "KC Multiplier", group=groupSQZ)
minSqueezeBars = input.int(12, "Minimum Squeeze Bars", minval=2, group=groupSQZ)

int chartTfSec = int(timeframe.in_seconds(timeframe.period))
findBBKCSqueeze() =>
    bb_mid = ta.sma(close, sqz_length)
    bb_up  = bb_mid + bb_mult * ta.stdev(close, sqz_length)
    bb_dn  = bb_mid - bb_mult * ta.stdev(close, sqz_length)

    tr_    = ta.tr(true)
    kc_mid = ta.ema(close, sqz_length)
    kc_up  = kc_mid + kc_mult * ta.sma(tr_, sqz_length)
    kc_dn  = kc_mid - kc_mult * ta.sma(tr_, sqz_length)

    inSqz  = (bb_up < kc_up) and (bb_dn > kc_dn)

    runOK     = math.sum(inSqz ? 1.0 : 0.0, minSqueezeBars) == minSqueezeBars
    prevRunOK = runOK[1] == true
    fired     = runOK and not prevRunOK
    firedC    = fired and barstate.isconfirmed

    hi     = ta.highest(high, minSqueezeBars)
    lo     = ta.lowest(low,  minSqueezeBars)

    tConf  = time_close
    spanMs = chartTfSec * 1000 * minSqueezeBars

    [firedC, tConf, hi, lo, spanMs]

//──────────────────────────────────────────────────────────────────────────────
// Zone type + storage
//──────────────────────────────────────────────────────────────────────────────
type Zone
    box  b
    line m
    int  bornBar
    int  state
    int  rightT

var array<Zone> Z = array.new<Zone>()

// parallel arrays for fixed bounds + wick-breach latch (freeze condition)
var float[] boxTop = array.new_float()
var float[] boxBot = array.new_float()
var int[]   hitTop = array.new_int()
var int[]   hitBot = array.new_int()

var string[] seenKeys = array.new_string()
isNewEvent(tConf) =>
    key = str.tostring(tConf)
    idx = array.indexof(seenKeys, key)
    if idx == -1
        array.push(seenKeys, key)
        if array.size(seenKeys) > 5000
            array.shift(seenKeys)
        true
    else
        false

//──────────────────────────────────────────────────────────────────────────────
// Create zone
//──────────────────────────────────────────────────────────────────────────────
newZone(tConf, h, l, spanMs) =>
    int leftT  = tConf
    int rightT = tConf + spanMs
    float mid  = (h + l) * 0.5

    b = box.new(left=leftT, top=h, right=rightT, bottom=l,
         bgcolor=activeFill, border_color=activeEdge,
         extend=extend.none, xloc=xloc.bar_time)

    m = line.new(x1=leftT, y1=mid, x2=rightT, y2=mid,
         xloc=xloc.bar_time, extend=extend.none,
         color=midActiveCol, style=line.style_solid, width=2)

    array.push(Z, Zone.new(b, m, bar_index, 1, rightT))
    array.push(boxTop, h)
    array.push(boxBot, l)
    array.push(hitTop, 0)
    array.push(hitBot, 0)

    if array.size(Z) > maxZones
        old = array.shift(Z)
        box.delete(old.b)
        line.delete(old.m)
        array.shift(boxTop)
        array.shift(boxBot)
        array.shift(hitTop)
        array.shift(hitBot)


//──────────────────────────────────────────────────────────────────────────────
// Spawn squeeze zones on CHART timeframe only
//──────────────────────────────────────────────────────────────────────────────
[j, tc, h, l, sp] = findBBKCSqueeze()
zoneWidth = h - l
zonePass  = not na(zoneWidth) and zoneWidth >= atrWidth(atrLowMulti) and zoneWidth <= atrWidth(atrHighMulti)

bool squeezeBoxFired = j and isNewEvent(tc) and not na(h) and not na(l) and zonePass

if squeezeBoxFired
    newZone(tc, h, l, sp)

alertcondition(squeezeBoxFired, title="Squeeze Box Fired", message="Squeeze box fired")

//──────────────────────────────────────────────────────────────────────────────
// ENGINE
//──────────────────────────────────────────────────────────────────────────────
int szZ = array.size(Z)
if szZ > 0
    for i = 0 to szZ - 1
        Zone z = array.get(Z, i)
        if z.state == 1
            float topFix = array.get(boxTop, i)
            float botFix = array.get(boxBot, i)
            float midFix = (topFix + botFix) * 0.5

            // right edge: projected end until reached, then extend with time
            int dynRight = time < z.rightT ? z.rightT : time
            box.set_right(z.b, dynRight)

            // midline pinned to fixed mid and right edge
            line.set_x2(z.m, dynRight)
            line.set_y1(z.m, midFix)
            line.set_y2(z.m, midFix)

            // active visuals while alive
            box.set_bgcolor(z.b, activeFill)
            box.set_border_color(z.b, activeEdge)
            line.set_color(z.m, midActiveCol)

            bool afterBorn = bar_index > z.bornBar
            if afterBorn
                // latch wick breaches (fixed bounds) for freeze condition
                int tHit = array.get(hitTop, i)
                int bHit = array.get(hitBot, i)

                if high >= topFix
                    tHit := 1
                if low <= botFix
                    bHit := 1

                array.set(hitTop, i, tHit)
                array.set(hitBot, i, bHit)

                // freeze only when BOTH sides have been breached
                if tHit == 1 and bHit == 1
                    box.set_right(z.b, time)
                    box.set_bgcolor(z.b, frozenFill)
                    box.set_border_color(z.b, frozenEdge)

                    line.set_x2(z.m, time)
                    line.set_color(z.m, midFrozenCol)

                    z.state := 0

            array.set(Z, i, z)
