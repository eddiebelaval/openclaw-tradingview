//@version=6
strategy("S50 ATR Sniper Pro V2", 
     overlay=true, 
     initial_capital=300000, 
     currency=currency.NONE,
     margin_long=0, 
     margin_short=0)

// --- [ Money Management Settings ] ---
totalQty    = input.int(10, "Total Order Size (จำนวนสัญญา)", minval=1, group="Money Management")


// --- [ Optimized Strategy Settings ] ---
// ค่าเริ่มต้นปรับตามผลการ Optimization ที่ให้ Quality Score สูงสุด
atrPeriod   = input.int(28, "ATR Period (รอบการคำนวณ)", group="Strategy Settings")
atrMult     = input.float(5.0, "ATR Multiplier (ความกว้างเส้น)", step=0.1, group="Strategy Settings")
emaFilter   = input.int(100, "Trend Filter (EMA)", group="Strategy Settings")

// --- [ Indicators Calculation ] ---
atrVal = ta.atr(atrPeriod)
emaVal = ta.ema(close, emaFilter)

// คำนวณเส้น ATR Trailing Stop (แบบเดียวกับระบบใน Excel)
var float trailingStop = 0.0
var int trend = 0 // 1 = Long, -1 = Short

if close > trailingStop[1] and close[1] > trailingStop[1]
    trailingStop := math.max(trailingStop[1], close - (atrVal * atrMult))
    trend := 1
else if close < trailingStop[1] and close[1] < trailingStop[1]
    trailingStop := math.min(trailingStop[1], close + (atrVal * atrMult))
    trend := -1
else
    // จังหวะเปลี่ยนเทรนด์ (Flip)
    trailingStop := close > trailingStop[1] ? close - (atrVal * atrMult) : close + (atrVal * atrMult)
    trend := close > trailingStop[1] ? 1 : -1

// --- [ Entry Logic ] ---
// เข้าเทรดเมื่อราคายืนเหนือ/ใต้เส้น ATR และทิศทางเดียวกับ EMA
longCond  = ta.change(trend) > 0 and close > emaVal
shortCond = ta.change(trend) < 0 and close < emaVal

if longCond
    strategy.entry("Long", strategy.long, qty=totalQty, comment="ATR-Buy")

if shortCond
    strategy.entry("Short", strategy.short, qty=totalQty, comment="ATR-Sell")

// --- [ Exit Logic ] ---
// ออกเมื่อแนวโน้มเปลี่ยนทิศ (ราคาปิดตัดเส้น Trailing Stop)
if trend == -1
    strategy.close("Long", comment="Exit-Buy")

if trend == 1
    strategy.close("Short", comment="Exit-Sell")

// --- [ Visuals ] ---
lineColor = trend == 1 ? color.lime : color.red
plot(trailingStop, color=color.new(lineColor, 0), linewidth=2, title="ATR Sniper Line")
plot(emaVal, color=color.new(color.white, 50), linewidth=2, title="Trend Filter (EMA)")

// วาดลูกศรจุดเข้า
plotshape(longCond, style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, title="Long Signal")
plotshape(shortCond, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Short Signal")
