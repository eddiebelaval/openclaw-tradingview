//@version=6
indicator("Institutional Decision Engine [JOAT]", shorttitle="IDE [JOAT]", overlay=true, 
         max_bars_back=500, max_lines_count=500, max_labels_count=200, max_boxes_count=100)

//═══════════════════════════════════════════════════════════════════════════════════════════════════
// [JOAT] COLOR ARCHITECTURE - Institutional Gradient System
//═══════════════════════════════════════════════════════════════════════════════════════════════════

// Primary Directional Palette - Gradient System
var color NEXUS_BULL_CORE      = #00E5FF
var color NEXUS_BULL_GLOW      = #00BCD4
var color NEXUS_BULL_SOFT      = #4DD0E1
var color NEXUS_BULL_DEEP      = #006064
var color NEXUS_BEAR_CORE      = #FF1493
var color NEXUS_BEAR_GLOW      = #E91E63
var color NEXUS_BEAR_SOFT      = #F48FB1
var color NEXUS_BEAR_DEEP      = #880E4F
var color NEXUS_NEUTRAL        = #546E7A
var color NEXUS_VOID           = #263238
var color NEXUS_VOID_GLOW      = #37474F

// Signal Quality Palette - Institutional Grade
var color NEXUS_PREMIUM        = #FFD700
var color NEXUS_PREMIUM_GLOW   = #FFC107
var color NEXUS_HIGH_CONF      = #00E676
var color NEXUS_HIGH_GLOW      = #69F0AE
var color NEXUS_MED_CONF       = #FFA726
var color NEXUS_LOW_CONF       = #78909C
var color NEXUS_SQUEEZE        = #7C4DFF
var color NEXUS_SQUEEZE_GLOW   = #B388FF

//═══════════════════════════════════════════════════════════════════════════════════════════════════
// CONFIGURATION MATRIX
//═══════════════════════════════════════════════════════════════════════════════════════════════════

g_regime = "═══ REGIME ENGINE ═══"
int     i_adx_period        = input.int(14, "ADX Computation Period", minval=5, maxval=30, group=g_regime)
float   i_trend_threshold   = input.float(25, "Trend Activation Level", minval=15, maxval=45, group=g_regime)
int     i_volatility_len    = input.int(14, "Volatility Baseline", minval=5, maxval=30, group=g_regime)
float   i_expansion_mult    = input.float(1.4, "Expansion Threshold", minval=1.1, maxval=2.0, step=0.1, group=g_regime)
float   i_contraction_mult  = input.float(0.6, "Contraction Threshold", minval=0.3, maxval=0.9, step=0.1, group=g_regime)

g_structure = "═══ STRUCTURE ENGINE ═══"
int     i_swing_sensitivity = input.int(10, "Swing Detection Bars", minval=3, maxval=30, group=g_structure)
int     i_structure_confirm = input.int(3, "Structure Confirmation", minval=1, maxval=10, group=g_structure)
bool    i_show_structure    = input.bool(true, "Visualize Structure", group=g_structure)
bool    i_show_liquidity    = input.bool(true, "Show Liquidity Zones", group=g_structure)

g_momentum = "═══ MOMENTUM ENGINE ═══"
int     i_pressure_period   = input.int(14, "Pressure Computation", minval=5, maxval=30, group=g_momentum)
int     i_wavetrend_ch      = input.int(10, "WaveTrend Channel", minval=5, maxval=20, group=g_momentum)
int     i_wavetrend_avg     = input.int(21, "WaveTrend Average", minval=10, maxval=40, group=g_momentum)
int     i_rsi_period        = input.int(14, "RSI Period", minval=5, maxval=30, group=g_momentum)

g_volatility = "═══ VOLATILITY LAYER ═══"
int     i_bb_period         = input.int(20, "Bollinger Period", minval=10, maxval=50, group=g_volatility)
float   i_bb_mult           = input.float(2.0, "Bollinger Deviation", minval=1.0, maxval=4.0, step=0.1, group=g_volatility)
int     i_kc_period         = input.int(20, "Keltner Period", minval=10, maxval=50, group=g_volatility)
float   i_kc_mult           = input.float(1.5, "Keltner Multiplier", minval=1.0, maxval=3.0, step=0.1, group=g_volatility)

g_bias = "═══ DIRECTIONAL BIAS ═══"
int     i_fast_ma           = input.int(21, "Fast Trend MA", minval=5, maxval=50, group=g_bias)
int     i_slow_ma           = input.int(55, "Slow Trend MA", minval=20, maxval=100, group=g_bias)
int     i_anchor_ma         = input.int(200, "Anchor MA", minval=100, maxval=500, group=g_bias)
float   i_bias_threshold    = input.float(60, "Bias Activation", minval=30, maxval=80, group=g_bias)

g_signal = "═══ SIGNAL QUALIFICATION ═══"
int     i_min_confluence    = input.int(5, "Minimum Confluence Score", minval=3, maxval=8, group=g_signal)
int     i_signal_cooldown   = input.int(5, "Signal Cooldown Bars", minval=1, maxval=20, group=g_signal)
bool    i_require_confirm   = input.bool(true, "Require Bar Confirmation", group=g_signal)
float   i_min_rr            = input.float(1.5, "Minimum R:R Ratio", minval=1.0, maxval=5.0, step=0.5, group=g_signal)

g_visual = "═══ VISUAL ENGINEERING ═══"
bool    i_show_cloud        = input.bool(true, "Directional Cloud", group=g_visual)
bool    i_show_signals      = input.bool(true, "Signal Markers", group=g_visual)
bool    i_show_levels       = input.bool(true, "Risk Levels", group=g_visual)
bool    i_show_dashboard    = input.bool(true, "Intelligence Panel", group=g_visual)
int     i_cloud_smoothing   = input.int(3, "Cloud Smoothing", minval=1, maxval=10, group=g_visual)

//═══════════════════════════════════════════════════════════════════════════════════════════════════
// ENGINE 1: MARKET REGIME CLASSIFICATION
//═══════════════════════════════════════════════════════════════════════════════════════════════════

// Directional Movement Index Computation
f_compute_dmi(int period) =>
    float tr_val = ta.tr(true)
    float pos_dm = math.max(high - high[1], 0)
    float neg_dm = math.max(low[1] - low, 0)
    if pos_dm > neg_dm
        neg_dm := 0
    else
        pos_dm := 0
    float smooth_tr = ta.rma(tr_val, period)
    float smooth_pos = ta.rma(pos_dm, period)
    float smooth_neg = ta.rma(neg_dm, period)
    float pos_di = smooth_tr > 0 ? 100 * smooth_pos / smooth_tr : 0
    float neg_di = smooth_tr > 0 ? 100 * smooth_neg / smooth_tr : 0
    float di_sum = pos_di + neg_di
    float dx = di_sum > 0 ? 100 * math.abs(pos_di - neg_di) / di_sum : 0
    float adx_val = ta.rma(dx, period)
    [adx_val, pos_di, neg_di]

// Volatility Regime Detection
f_volatility_regime(int period, float exp_mult, float con_mult) =>
    float atr_current = ta.atr(period)
    float atr_baseline = ta.sma(atr_current, period * 3)
    float vol_ratio = atr_baseline > 0 ? atr_current / atr_baseline : 1.0
    int vol_state = vol_ratio > exp_mult ? 1 : vol_ratio < con_mult ? -1 : 0
    [vol_ratio, vol_state]

// Execute Regime Engine
[adx_value, pos_di, neg_di] = f_compute_dmi(i_adx_period)
[volatility_ratio, volatility_state] = f_volatility_regime(i_volatility_len, i_expansion_mult, i_contraction_mult)

// Regime Classification: 0=Neutral, 1=Trending, 2=Ranging, 3=Volatile
int market_regime = 0
if volatility_state == 1 and adx_value < i_trend_threshold
    market_regime := 3  // Volatile Expansion
else if adx_value >= i_trend_threshold
    market_regime := 1  // Trending
else if volatility_state == -1
    market_regime := 2  // Ranging/Consolidation

// Trend Direction from DI
int trend_direction = pos_di > neg_di ? 1 : pos_di < neg_di ? -1 : 0

// Regime Strength (0-100)
float regime_strength = 0.0
if market_regime == 1
    regime_strength := math.min(adx_value / 50.0 * 100, 100)
else if market_regime == 2
    regime_strength := math.min((1 - volatility_ratio) / (1 - i_contraction_mult) * 100, 100)
else if market_regime == 3
    regime_strength := math.min(volatility_ratio / i_expansion_mult * 100, 100)
else
    regime_strength := 50.0

//═══════════════════════════════════════════════════════════════════════════════════════════════════
// ENGINE 2: STRUCTURAL BEHAVIOR ANALYSIS
//═══════════════════════════════════════════════════════════════════════════════════════════════════

// Swing Point Detection
float swing_high_val = ta.pivothigh(high, i_swing_sensitivity, i_structure_confirm)
float swing_low_val = ta.pivotlow(low, i_swing_sensitivity, i_structure_confirm)

// Track Structure
var float last_swing_high = na
var float last_swing_low = na
var int last_sh_bar = 0
var int last_sl_bar = 0
var float prev_swing_high = na
var float prev_swing_low = na

if not na(swing_high_val)
    prev_swing_high := last_swing_high
    last_swing_high := swing_high_val
    last_sh_bar := bar_index - i_structure_confirm

if not na(swing_low_val)
    prev_swing_low := last_swing_low
    last_swing_low := swing_low_val
    last_sl_bar := bar_index - i_structure_confirm

// Structure Analysis
bool higher_high = not na(last_swing_high) and not na(prev_swing_high) and last_swing_high > prev_swing_high
bool lower_low = not na(last_swing_low) and not na(prev_swing_low) and last_swing_low < prev_swing_low
bool higher_low = not na(last_swing_low) and not na(prev_swing_low) and last_swing_low > prev_swing_low
bool lower_high = not na(last_swing_high) and not na(prev_swing_high) and last_swing_high < prev_swing_high

// Structure State: 1=Bullish, -1=Bearish, 0=Neutral
int structure_bias = 0
if higher_high and higher_low
    structure_bias := 1
else if lower_low and lower_high
    structure_bias := -1

// Break of Structure Detection
bool bos_bullish = close > nz(last_swing_high, high) and close[1] <= nz(last_swing_high[1], high[1])
bool bos_bearish = close < nz(last_swing_low, low) and close[1] >= nz(last_swing_low[1], low[1])

// Liquidity Zones (Equal Highs/Lows)
float atr_base = ta.atr(14)
float eq_threshold = atr_base * 0.3
bool equal_highs = not na(last_swing_high) and not na(prev_swing_high) and math.abs(last_swing_high - prev_swing_high) < eq_threshold
bool equal_lows = not na(last_swing_low) and not na(prev_swing_low) and math.abs(last_swing_low - prev_swing_low) < eq_threshold

// Structure Score (0-100)
float structure_score = 0.0
structure_score += structure_bias == 1 ? 30 : structure_bias == -1 ? 0 : 15
structure_score += higher_high ? 20 : lower_low ? 0 : 10
structure_score += higher_low ? 20 : lower_high ? 0 : 10
structure_score += bos_bullish ? 30 : bos_bearish ? 0 : 15

//═══════════════════════════════════════════════════════════════════════════════════════════════════
// ENGINE 3: MOMENTUM PRESSURE ANALYSIS
//═══════════════════════════════════════════════════════════════════════════════════════════════════

// WaveTrend Computation
f_wavetrend(int channel_len, int avg_len) =>
    float ap = hlc3
    float esa = ta.ema(ap, channel_len)
    float d = ta.ema(math.abs(ap - esa), channel_len)
    float ci = d != 0 ? (ap - esa) / (0.015 * d) : 0
    float wt1 = ta.ema(ci, avg_len)
    float wt2 = ta.sma(wt1, 4)
    [wt1, wt2]

[wt1, wt2] = f_wavetrend(i_wavetrend_ch, i_wavetrend_avg)
float wt_cross = wt1 - wt2
bool wt_bullish = wt1 > wt2 and wt1 > wt1[1]
bool wt_bearish = wt1 < wt2 and wt1 < wt1[1]
bool wt_oversold = wt1 < -60
bool wt_overbought = wt1 > 60

// RSI Momentum
float rsi_val = ta.rsi(close, i_rsi_period)
float rsi_momentum = rsi_val - rsi_val[5]
bool rsi_bullish = rsi_val > 50 and rsi_val < 70 and rsi_momentum > 0
bool rsi_bearish = rsi_val < 50 and rsi_val > 30 and rsi_momentum < 0

// Buying/Selling Pressure
float buying_pressure = high - math.min(open, close)
float selling_pressure = math.max(open, close) - low
float total_range = high - low
float pressure_ratio = total_range > 0 ? (buying_pressure - selling_pressure) / total_range : 0
float pressure_smooth = ta.ema(pressure_ratio, i_pressure_period)
float pressure_momentum = pressure_smooth - pressure_smooth[5]

// Volume Weighted Pressure
float vol_sma = ta.sma(volume, i_pressure_period)
float vol_weight = vol_sma > 0 ? math.min(volume / vol_sma, 3.0) / 3.0 : 0.5
float weighted_pressure = pressure_smooth * (1 + vol_weight * 0.5)

// MACD Component
float macd_line = ta.ema(close, 12) - ta.ema(close, 26)
float macd_signal = ta.ema(macd_line, 9)
float macd_hist = macd_line - macd_signal
bool macd_bullish = macd_hist > 0 and macd_hist > macd_hist[1]
bool macd_bearish = macd_hist < 0 and macd_hist < macd_hist[1]

// Composite Momentum Score
float momentum_bull_score = 0.0
momentum_bull_score += wt_bullish ? 25 : 0
momentum_bull_score += rsi_bullish ? 25 : 0
momentum_bull_score += weighted_pressure > 0.1 ? 25 : weighted_pressure > 0 ? 12.5 : 0
momentum_bull_score += macd_bullish ? 25 : 0

float momentum_bear_score = 0.0
momentum_bear_score += wt_bearish ? 25 : 0
momentum_bear_score += rsi_bearish ? 25 : 0
momentum_bear_score += weighted_pressure < -0.1 ? 25 : weighted_pressure < 0 ? 12.5 : 0
momentum_bear_score += macd_bearish ? 25 : 0

// Net Momentum State
float net_momentum = momentum_bull_score - momentum_bear_score
int momentum_state = net_momentum > 25 ? 1 : net_momentum < -25 ? -1 : 0

//═══════════════════════════════════════════════════════════════════════════════════════════════════
// ENGINE 4: VOLATILITY INTELLIGENCE LAYER
//═══════════════════════════════════════════════════════════════════════════════════════════════════

// Bollinger Bands
float bb_basis = ta.sma(close, i_bb_period)
float bb_dev = ta.stdev(close, i_bb_period) * i_bb_mult
float bb_upper = bb_basis + bb_dev
float bb_lower = bb_basis - bb_dev

// Keltner Channels
float kc_basis = ta.ema(close, i_kc_period)
float kc_range = ta.atr(i_kc_period) * i_kc_mult
float kc_upper = kc_basis + kc_range
float kc_lower = kc_basis - kc_range

// Squeeze Detection
bool squeeze_on = bb_lower > kc_lower and bb_upper < kc_upper
bool squeeze_off = bb_lower < kc_lower or bb_upper > kc_upper

// Squeeze Duration & Intensity
var int squeeze_duration = 0
squeeze_duration := squeeze_on ? squeeze_duration + 1 : 0
float squeeze_intensity = math.min(float(squeeze_duration) / 20.0 * 100, 100)

// Volatility Cycle Phase
int vol_cycle_phase = 0
if squeeze_on and squeeze_duration > 5
    vol_cycle_phase := 1  // Compression
else if squeeze_off and squeeze_duration[1] > 0
    vol_cycle_phase := 2  // Expansion Trigger
else if volatility_ratio > 1.2
    vol_cycle_phase := 3  // Active Expansion
else
    vol_cycle_phase := 0  // Normal

// Adaptive Multipliers
float stop_multiplier = vol_cycle_phase == 3 ? 1.5 : vol_cycle_phase == 1 ? 0.8 : 1.0
float target_multiplier = vol_cycle_phase == 3 ? 1.3 : vol_cycle_phase == 1 ? 1.5 : 1.0

// Volatility Score
float volatility_score = 0.0
volatility_score += squeeze_on ? 30 : 0
volatility_score += volatility_ratio > 1 ? math.min((volatility_ratio - 1) * 100, 40) : 0
volatility_score += vol_cycle_phase == 2 ? 30 : 0

//═══════════════════════════════════════════════════════════════════════════════════════════════════
// ENGINE 5: DIRECTIONAL BIAS MODEL
//═══════════════════════════════════════════════════════════════════════════════════════════════════

// Moving Average Structure
float ma_fast = ta.ema(close, i_fast_ma)
float ma_slow = ta.ema(close, i_slow_ma)
float ma_anchor = ta.ema(close, i_anchor_ma)

// MA Relationships
bool ma_bullish_stack = ma_fast > ma_slow and ma_slow > ma_anchor
bool ma_bearish_stack = ma_fast < ma_slow and ma_slow < ma_anchor
bool price_above_structure = close > ma_fast and close > ma_slow
bool price_below_structure = close < ma_fast and close < ma_slow

// MA Slopes
float fast_slope = (ma_fast - ma_fast[5]) / ma_fast[5] * 100
float slow_slope = (ma_slow - ma_slow[10]) / ma_slow[10] * 100
bool slopes_aligned_bull = fast_slope > 0 and slow_slope > 0
bool slopes_aligned_bear = fast_slope < 0 and slow_slope < 0

// Bias Computation
float bullish_bias = 0.0
bullish_bias += ma_bullish_stack ? 30 : 0
bullish_bias += price_above_structure ? 20 : 0
bullish_bias += close > ma_anchor ? 15 : 0
bullish_bias += pos_di > neg_di ? 20 : 0
bullish_bias += slopes_aligned_bull ? 15 : 0

float bearish_bias = 0.0
bearish_bias += ma_bearish_stack ? 30 : 0
bearish_bias += price_below_structure ? 20 : 0
bearish_bias += close < ma_anchor ? 15 : 0
bearish_bias += neg_di > pos_di ? 20 : 0
bearish_bias += slopes_aligned_bear ? 15 : 0

// Net Bias
float net_bias = bullish_bias - bearish_bias
int bias_direction = net_bias > i_bias_threshold / 2 ? 1 : net_bias < -i_bias_threshold / 2 ? -1 : 0

// Bias Strength (0-100)
float bias_strength = math.abs(net_bias)

//═══════════════════════════════════════════════════════════════════════════════════════════════════
// ENGINE 6: SIGNAL QUALIFICATION SYSTEM
//═══════════════════════════════════════════════════════════════════════════════════════════════════

// Confluence Scoring
int bull_confluence = 0
bull_confluence += market_regime == 1 and trend_direction == 1 ? 2 : 0
bull_confluence += structure_bias == 1 ? 1 : 0
bull_confluence += bos_bullish ? 1 : 0
bull_confluence += momentum_state == 1 ? 2 : 0
bull_confluence += bias_direction == 1 ? 2 : 0
bull_confluence += squeeze_off and net_momentum > 0 ? 1 : 0
bull_confluence += vol_cycle_phase == 2 and trend_direction == 1 ? 1 : 0

int bear_confluence = 0
bear_confluence += market_regime == 1 and trend_direction == -1 ? 2 : 0
bear_confluence += structure_bias == -1 ? 1 : 0
bear_confluence += bos_bearish ? 1 : 0
bear_confluence += momentum_state == -1 ? 2 : 0
bear_confluence += bias_direction == -1 ? 2 : 0
bear_confluence += squeeze_off and net_momentum < 0 ? 1 : 0
bear_confluence += vol_cycle_phase == 2 and trend_direction == -1 ? 1 : 0

// Qualification Check
bool bull_qualified = bull_confluence >= i_min_confluence
bool bear_qualified = bear_confluence >= i_min_confluence

// Signal Triggers
bool bull_trigger = ta.crossover(close, ma_fast) or (wt_oversold and ta.crossover(wt1, wt2)) or bos_bullish
bool bear_trigger = ta.crossunder(close, ma_fast) or (wt_overbought and ta.crossunder(wt1, wt2)) or bos_bearish

// Cooldown Management
var int bars_since_bull = 999
var int bars_since_bear = 999
bars_since_bull := bars_since_bull + 1
bars_since_bear := bars_since_bear + 1

// Bar Confirmation
bool bar_confirmed = i_require_confirm ? barstate.isconfirmed : true

// Final Signal Generation
bool long_signal = bull_qualified and bull_trigger and bars_since_bull > i_signal_cooldown and bar_confirmed and market_regime != 3
bool short_signal = bear_qualified and bear_trigger and bars_since_bear > i_signal_cooldown and bar_confirmed and market_regime != 3

// Premium Signal Detection
bool long_premium = long_signal and bull_confluence >= i_min_confluence + 2
bool short_premium = short_signal and bear_confluence >= i_min_confluence + 2

// Reset Cooldowns
if long_signal
    bars_since_bull := 0
if short_signal
    bars_since_bear := 0

// Quality Grade
float bull_quality = float(bull_confluence) / 10.0 * 100
float bear_quality = float(bear_confluence) / 10.0 * 100
string bull_grade = bull_quality >= 80 ? "A" : bull_quality >= 60 ? "B" : bull_quality >= 40 ? "C" : "D"
string bear_grade = bear_quality >= 80 ? "A" : bear_quality >= 60 ? "B" : bear_quality >= 40 ? "C" : "D"

//═══════════════════════════════════════════════════════════════════════════════════════════════════
// RISK ARCHITECTURE
//═══════════════════════════════════════════════════════════════════════════════════════════════════

float atr_risk = ta.atr(14) * stop_multiplier

// Dynamic Stop Levels
float long_stop = nz(last_swing_low, close - atr_risk * 2) - atr_risk * 0.2
float short_stop = nz(last_swing_high, close + atr_risk * 2) + atr_risk * 0.2

// Risk Amounts
float long_risk = close - long_stop
float short_risk = short_stop - close

// Target Levels
float long_tp1 = close + long_risk * i_min_rr * target_multiplier
float long_tp2 = close + long_risk * (i_min_rr + 1.0) * target_multiplier
float short_tp1 = close - short_risk * i_min_rr * target_multiplier
float short_tp2 = close - short_risk * (i_min_rr + 1.0) * target_multiplier

//═══════════════════════════════════════════════════════════════════════════════════════════════════
// VISUAL ENGINEERING - DIRECTIONAL CLOUD SYSTEM
//═══════════════════════════════════════════════════════════════════════════════════════════════════

// Composite Directional Score (-100 to +100)
float directional_score = (net_bias + net_momentum) / 2
float smoothed_score = ta.ema(directional_score, i_cloud_smoothing)

// Cloud Basis Calculations
float cloud_upper = ta.ema(high, i_fast_ma) + atr_risk * 0.5
float cloud_lower = ta.ema(low, i_fast_ma) - atr_risk * 0.5
float cloud_mid = (cloud_upper + cloud_lower) / 2

// Dynamic Cloud Colors with Enhanced Gradient Glow
f_gradient_color(float score, float intensity) =>
    int alpha_base = math.round(math.max(60, 88 - intensity * 0.3))
    if score > 60
        color.new(NEXUS_BULL_CORE, alpha_base - 20)
    else if score > 40
        color.new(NEXUS_BULL_CORE, alpha_base - 10)
    else if score > 25
        color.new(NEXUS_BULL_GLOW, alpha_base)
    else if score > 10
        color.new(NEXUS_BULL_SOFT, alpha_base + 5)
    else if score < -60
        color.new(NEXUS_BEAR_CORE, alpha_base - 20)
    else if score < -40
        color.new(NEXUS_BEAR_CORE, alpha_base - 10)
    else if score < -25
        color.new(NEXUS_BEAR_GLOW, alpha_base)
    else if score < -10
        color.new(NEXUS_BEAR_SOFT, alpha_base + 5)
    else
        color.new(NEXUS_NEUTRAL, 88)

f_glow_gradient(float score) =>
    if score > 40
        color.new(NEXUS_BULL_DEEP, 92)
    else if score > 20
        color.new(NEXUS_BULL_DEEP, 94)
    else if score < -40
        color.new(NEXUS_BEAR_DEEP, 92)
    else if score < -20
        color.new(NEXUS_BEAR_DEEP, 94)
    else
        color.new(NEXUS_VOID, 95)

color cloud_color = f_gradient_color(smoothed_score, regime_strength)
color cloud_glow = f_glow_gradient(smoothed_score)

// Cloud Glow Layer Calculations
float cloud_glow_upper = cloud_upper + atr_risk * 0.15
float cloud_glow_lower = cloud_lower - atr_risk * 0.15

// Cloud Plots with Glow Effect
p_glow_upper = plot(i_show_cloud ? cloud_glow_upper : na, "Glow Upper", color=cloud_glow, linewidth=1)
p_upper = plot(i_show_cloud ? cloud_upper : na, "Cloud Upper", color=color.new(cloud_color, 60), linewidth=1)
p_mid = plot(i_show_cloud ? cloud_mid : na, "Cloud Mid", color=cloud_color, linewidth=2)
p_lower = plot(i_show_cloud ? cloud_lower : na, "Cloud Lower", color=color.new(cloud_color, 60), linewidth=1)
p_glow_lower = plot(i_show_cloud ? cloud_glow_lower : na, "Glow Lower", color=cloud_glow, linewidth=1)

// Cloud Fills with Glow
fill(p_glow_upper, p_upper, color=cloud_glow, title="Upper Glow Fill")
fill(p_upper, p_mid, color=cloud_color, title="Upper Cloud Fill")
fill(p_lower, p_mid, color=cloud_color, title="Lower Cloud Fill")
fill(p_lower, p_glow_lower, color=cloud_glow, title="Lower Glow Fill")

// MA Plots with Dynamic Colors
color ma_fast_color = ma_bullish_stack ? color.new(NEXUS_BULL_CORE, 40) : ma_bearish_stack ? color.new(NEXUS_BEAR_CORE, 40) : color.new(NEXUS_NEUTRAL, 50)
color ma_slow_color = ma_bullish_stack ? color.new(NEXUS_BULL_GLOW, 50) : ma_bearish_stack ? color.new(NEXUS_BEAR_GLOW, 50) : color.new(NEXUS_NEUTRAL, 60)
color ma_anchor_color = close > ma_anchor ? color.new(NEXUS_BULL_DEEP, 60) : color.new(NEXUS_BEAR_DEEP, 60)

plot(ma_fast, "Fast MA", color=ma_fast_color, linewidth=1)
plot(ma_slow, "Slow MA", color=ma_slow_color, linewidth=2)
plot(ma_anchor, "Anchor MA", color=ma_anchor_color, linewidth=3)

//═══════════════════════════════════════════════════════════════════════════════════════════════════
// SIGNAL VISUALIZATION
//═══════════════════════════════════════════════════════════════════════════════════════════════════

// Signal Markers
color long_sig_color = long_premium ? NEXUS_PREMIUM : NEXUS_BULL_CORE
color short_sig_color = short_premium ? NEXUS_PREMIUM : NEXUS_BEAR_CORE

plotshape(i_show_signals and long_signal, "Long Signal", shape.triangleup, location.belowbar, 
          color=long_sig_color, size=size.small)
plotshape(i_show_signals and short_signal, "Short Signal", shape.triangledown, location.abovebar, 
          color=short_sig_color, size=size.small)

// Premium Markers
plotshape(i_show_signals and long_premium, "Premium Long", shape.diamond, location.belowbar, 
          color=color.new(NEXUS_PREMIUM, 0), size=size.tiny, offset=-1)
plotshape(i_show_signals and short_premium, "Premium Short", shape.diamond, location.abovebar, 
          color=color.new(NEXUS_PREMIUM, 0), size=size.tiny, offset=-1)

// Structure Markers
plotshape(i_show_structure and not na(swing_high_val), "Swing High", shape.circle, location.abovebar, 
          color=color.new(NEXUS_BEAR_GLOW, 50), size=size.tiny)
plotshape(i_show_structure and not na(swing_low_val), "Swing Low", shape.circle, location.belowbar, 
          color=color.new(NEXUS_BULL_GLOW, 50), size=size.tiny)

// BOS Markers
plotshape(i_show_structure and bos_bullish, "BOS Bull", shape.arrowup, location.belowbar, 
          color=color.new(NEXUS_HIGH_CONF, 30), size=size.tiny)
plotshape(i_show_structure and bos_bearish, "BOS Bear", shape.arrowdown, location.abovebar, 
          color=color.new(NEXUS_BEAR_CORE, 30), size=size.tiny)

// Squeeze Indicator Background
color squeeze_bg = squeeze_on ? color.new(NEXUS_SQUEEZE, 95) : na
bgcolor(squeeze_bg)

// Signal Background
color signal_bg = na
if long_signal
    signal_bg := long_premium ? color.new(NEXUS_PREMIUM, 85) : color.new(NEXUS_BULL_CORE, 90)
if short_signal
    signal_bg := short_premium ? color.new(NEXUS_PREMIUM, 85) : color.new(NEXUS_BEAR_CORE, 90)
bgcolor(signal_bg)

//═══════════════════════════════════════════════════════════════════════════════════════════════════
// RISK LEVEL VISUALIZATION
//═══════════════════════════════════════════════════════════════════════════════════════════════════

var line stop_line = na
var line tp1_line = na
var line tp2_line = na
var label entry_label = na

if long_signal and i_show_levels
    if not na(stop_line)
        line.delete(stop_line)
    if not na(tp1_line)
        line.delete(tp1_line)
    if not na(tp2_line)
        line.delete(tp2_line)
    if not na(entry_label)
        label.delete(entry_label)
    
    stop_line := line.new(bar_index, long_stop, bar_index + 20, long_stop, 
                          color=color.new(NEXUS_BEAR_CORE, 30), style=line.style_dashed, width=2)
    tp1_line := line.new(bar_index, long_tp1, bar_index + 20, long_tp1, 
                         color=color.new(NEXUS_BULL_CORE, 40), style=line.style_dotted, width=1)
    tp2_line := line.new(bar_index, long_tp2, bar_index + 20, long_tp2, 
                         color=color.new(NEXUS_BULL_CORE, 60), style=line.style_dotted, width=1)
    entry_label := label.new(bar_index + 10, close, (long_premium ? "★ " : "") + "LONG " + bull_grade, 
                             style=label.style_label_left, color=long_sig_color, textcolor=color.white, size=size.small)

if short_signal and i_show_levels
    if not na(stop_line)
        line.delete(stop_line)
    if not na(tp1_line)
        line.delete(tp1_line)
    if not na(tp2_line)
        line.delete(tp2_line)
    if not na(entry_label)
        label.delete(entry_label)
    
    stop_line := line.new(bar_index, short_stop, bar_index + 20, short_stop, 
                          color=color.new(NEXUS_BULL_CORE, 30), style=line.style_dashed, width=2)
    tp1_line := line.new(bar_index, short_tp1, bar_index + 20, short_tp1, 
                         color=color.new(NEXUS_BEAR_CORE, 40), style=line.style_dotted, width=1)
    tp2_line := line.new(bar_index, short_tp2, bar_index + 20, short_tp2, 
                         color=color.new(NEXUS_BEAR_CORE, 60), style=line.style_dotted, width=1)
    entry_label := label.new(bar_index + 10, close, (short_premium ? "★ " : "") + "SHORT " + bear_grade, 
                             style=label.style_label_left, color=short_sig_color, textcolor=color.white, size=size.small)

//═══════════════════════════════════════════════════════════════════════════════════════════════════
// INTELLIGENCE DASHBOARD
//═══════════════════════════════════════════════════════════════════════════════════════════════════

if i_show_dashboard and barstate.islast
    var table dash = table.new(position.top_right, 3, 12, bgcolor=color.new(#0D1117, 5), 
                               border_width=1, border_color=color.new(#30363D, 40))
    
    // Regime Text
    string regime_text = switch market_regime
        1 => "TRENDING"
        2 => "RANGING"
        3 => "VOLATILE"
        => "NEUTRAL"
    color regime_color = market_regime == 1 ? NEXUS_BULL_CORE : market_regime == 3 ? NEXUS_BEAR_CORE : NEXUS_NEUTRAL
    
    // Direction Text
    string dir_text = trend_direction == 1 ? "BULLISH" : trend_direction == -1 ? "BEARISH" : "NEUTRAL"
    color dir_color = trend_direction == 1 ? NEXUS_BULL_CORE : trend_direction == -1 ? NEXUS_BEAR_CORE : NEXUS_NEUTRAL
    
    // Headers
    table.cell(dash, 0, 0, "[JOAT] ENGINE", text_color=NEXUS_PREMIUM, text_size=size.small, bgcolor=color.new(#1A1A2E, 50))
    table.cell(dash, 1, 0, "STATUS", text_color=color.new(#B2B5BE, 0), text_size=size.small, bgcolor=color.new(#1A1A2E, 50))
    table.cell(dash, 2, 0, "SCORE", text_color=color.new(#B2B5BE, 0), text_size=size.small, bgcolor=color.new(#1A1A2E, 50))
    
    // Regime Engine
    table.cell(dash, 0, 1, "REGIME", text_color=color.new(#B2B5BE, 0), text_size=size.small)
    table.cell(dash, 1, 1, regime_text, text_color=regime_color, text_size=size.small)
    table.cell(dash, 2, 1, str.tostring(regime_strength, "#") + "%", text_color=regime_color, text_size=size.small)
    
    // Structure Engine
    string struct_text = structure_bias == 1 ? "BULLISH" : structure_bias == -1 ? "BEARISH" : "NEUTRAL"
    color struct_color = structure_bias == 1 ? NEXUS_BULL_CORE : structure_bias == -1 ? NEXUS_BEAR_CORE : NEXUS_NEUTRAL
    table.cell(dash, 0, 2, "STRUCTURE", text_color=color.new(#B2B5BE, 0), text_size=size.small)
    table.cell(dash, 1, 2, struct_text, text_color=struct_color, text_size=size.small)
    table.cell(dash, 2, 2, str.tostring(structure_score, "#") + "%", text_color=struct_color, text_size=size.small)
    
    // Momentum Engine
    string mom_text = momentum_state == 1 ? "BULLISH" : momentum_state == -1 ? "BEARISH" : "NEUTRAL"
    color mom_color = momentum_state == 1 ? NEXUS_BULL_CORE : momentum_state == -1 ? NEXUS_BEAR_CORE : NEXUS_NEUTRAL
    table.cell(dash, 0, 3, "MOMENTUM", text_color=color.new(#B2B5BE, 0), text_size=size.small)
    table.cell(dash, 1, 3, mom_text, text_color=mom_color, text_size=size.small)
    table.cell(dash, 2, 3, str.tostring(momentum_bull_score > momentum_bear_score ? momentum_bull_score : momentum_bear_score, "#") + "%", text_color=mom_color, text_size=size.small)
    
    // Volatility Layer
    string vol_text = squeeze_on ? "SQUEEZE" : vol_cycle_phase == 2 ? "EXPANSION" : volatility_ratio > 1.2 ? "HIGH" : "NORMAL"
    color vol_color = squeeze_on ? color.new(#7C4DFF, 0) : vol_cycle_phase == 2 ? NEXUS_PREMIUM : NEXUS_NEUTRAL
    table.cell(dash, 0, 4, "VOLATILITY", text_color=color.new(#B2B5BE, 0), text_size=size.small)
    table.cell(dash, 1, 4, vol_text, text_color=vol_color, text_size=size.small)
    table.cell(dash, 2, 4, str.tostring(volatility_ratio, "#.##") + "x", text_color=vol_color, text_size=size.small)
    
    // Bias Model
    table.cell(dash, 0, 5, "BIAS", text_color=color.new(#B2B5BE, 0), text_size=size.small)
    table.cell(dash, 1, 5, dir_text, text_color=dir_color, text_size=size.small)
    table.cell(dash, 2, 5, str.tostring(bias_strength, "#") + "%", text_color=dir_color, text_size=size.small)
    
    // Separator
    table.cell(dash, 0, 6, "───────", text_color=color.new(#30363D, 0), text_size=size.small)
    table.cell(dash, 1, 6, "───────", text_color=color.new(#30363D, 0), text_size=size.small)
    table.cell(dash, 2, 6, "───────", text_color=color.new(#30363D, 0), text_size=size.small)
    
    // Signal Qualification
    table.cell(dash, 0, 7, "LONG CONF", text_color=color.new(#B2B5BE, 0), text_size=size.small)
    table.cell(dash, 1, 7, str.tostring(bull_confluence) + "/" + str.tostring(i_min_confluence), 
               text_color=bull_qualified ? NEXUS_BULL_CORE : NEXUS_NEUTRAL, text_size=size.small)
    table.cell(dash, 2, 7, bull_grade, text_color=bull_qualified ? NEXUS_BULL_CORE : NEXUS_NEUTRAL, text_size=size.small)
    
    table.cell(dash, 0, 8, "SHORT CONF", text_color=color.new(#B2B5BE, 0), text_size=size.small)
    table.cell(dash, 1, 8, str.tostring(bear_confluence) + "/" + str.tostring(i_min_confluence), 
               text_color=bear_qualified ? NEXUS_BEAR_CORE : NEXUS_NEUTRAL, text_size=size.small)
    table.cell(dash, 2, 8, bear_grade, text_color=bear_qualified ? NEXUS_BEAR_CORE : NEXUS_NEUTRAL, text_size=size.small)
    
    // ADX & Squeeze
    table.cell(dash, 0, 9, "ADX", text_color=color.new(#B2B5BE, 0), text_size=size.small)
    table.cell(dash, 1, 9, str.tostring(adx_value, "#.#"), 
               text_color=adx_value >= i_trend_threshold ? NEXUS_HIGH_CONF : NEXUS_NEUTRAL, text_size=size.small)
    table.cell(dash, 2, 9, adx_value >= i_trend_threshold ? "STRONG" : "WEAK", 
               text_color=adx_value >= i_trend_threshold ? NEXUS_HIGH_CONF : NEXUS_NEUTRAL, text_size=size.small)
    
    // Squeeze Duration
    table.cell(dash, 0, 10, "SQUEEZE", text_color=color.new(#B2B5BE, 0), text_size=size.small)
    table.cell(dash, 1, 10, squeeze_on ? str.tostring(squeeze_duration) + " bars" : "OFF", 
               text_color=squeeze_on ? color.new(#7C4DFF, 0) : NEXUS_NEUTRAL, text_size=size.small)
    table.cell(dash, 2, 10, str.tostring(squeeze_intensity, "#") + "%", 
               text_color=squeeze_on ? color.new(#7C4DFF, 0) : NEXUS_NEUTRAL, text_size=size.small)
    
    // RSI
    table.cell(dash, 0, 11, "RSI", text_color=color.new(#B2B5BE, 0), text_size=size.small)
    table.cell(dash, 1, 11, str.tostring(rsi_val, "#.#"), 
               text_color=rsi_val > 50 ? NEXUS_BULL_CORE : NEXUS_BEAR_CORE, text_size=size.small)
    table.cell(dash, 2, 11, rsi_val > 70 ? "OB" : rsi_val < 30 ? "OS" : "NORMAL", 
               text_color=rsi_val > 70 or rsi_val < 30 ? NEXUS_PREMIUM : NEXUS_NEUTRAL, text_size=size.small)

//═══════════════════════════════════════════════════════════════════════════════════════════════════
// EXPORT PLOTS (Strategy Integration)
//═══════════════════════════════════════════════════════════════════════════════════════════════════

plot(long_signal ? 1 : 0, "Long Signal Export", display=display.none)
plot(short_signal ? 1 : 0, "Short Signal Export", display=display.none)
plot(float(bull_confluence), "Bull Confluence Export", display=display.none)
plot(float(bear_confluence), "Bear Confluence Export", display=display.none)
plot(float(market_regime), "Regime Export", display=display.none)
plot(smoothed_score, "Directional Score Export", display=display.none)
plot(regime_strength, "Regime Strength Export", display=display.none)
plot(long_stop, "Long Stop Export", display=display.none)
plot(short_stop, "Short Stop Export", display=display.none)
plot(long_tp1, "Long TP1 Export", display=display.none)
plot(short_tp1, "Short TP1 Export", display=display.none)
plot(volatility_ratio, "Volatility Ratio Export", display=display.none)
plot(squeeze_on ? 1 : 0, "Squeeze Active Export", display=display.none)
plot(net_momentum, "Net Momentum Export", display=display.none)
plot(net_bias, "Net Bias Export", display=display.none)

//═══════════════════════════════════════════════════════════════════════════════════════════════════
// ALERT CONDITIONS
//═══════════════════════════════════════════════════════════════════════════════════════════════════

alertcondition(long_signal, "NEXUS Long Signal", "NEXUS: Qualified long signal generated")
alertcondition(short_signal, "NEXUS Short Signal", "NEXUS: Qualified short signal generated")
alertcondition(long_premium, "NEXUS Premium Long", "NEXUS: Premium long signal - high confluence")
alertcondition(short_premium, "NEXUS Premium Short", "NEXUS: Premium short signal - high confluence")
alertcondition(bos_bullish, "NEXUS Bullish BOS", "NEXUS: Bullish break of structure")
alertcondition(bos_bearish, "NEXUS Bearish BOS", "NEXUS: Bearish break of structure")
alertcondition(squeeze_off and squeeze_duration[1] > 10, "NEXUS Squeeze Release", "NEXUS: Volatility squeeze released after compression")
alertcondition(market_regime == 1 and market_regime[1] != 1, "NEXUS Trend Regime", "NEXUS: Market entered trending regime")
