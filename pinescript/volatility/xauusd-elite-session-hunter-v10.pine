//@version=6
strategy("XAUUSD Elite Session Hunter V1.0", overlay=true, initial_capital=10000, currency=currency.USD, default_qty_type=strategy.fixed, default_qty_value=10)

// ==========================================
// 🛡️ Inputs
// ==========================================
string resGroup    = "Session Settings"
string sessionInput = input.session("1300-1400", "Trading Session (GMT+0)", group=resGroup)
color  sessionColor = input.color(color.new(color.blue, 90), "Session Box Color", group=resGroup)

string filterGroup = "Strategy Filters"
int   emaLen       = input.int(150, "Main Trend (EMA)", group=filterGroup)
int   adxThres     = input.int(12, "ADX Threshold", group=filterGroup)

string rmGroup     = "Risk Management"
float tpPoints     = input.float(80.0, "Take Profit (Points)", group=rmGroup)
float slPoints     = input.float(60.0, "Stop Loss (Points)", group=rmGroup)
bool  useTrail     = input.bool(true, "Use Trailing Stop", group=rmGroup)

// ==========================================
// 📈 Global Indicators
// ==========================================
emaVal = ta.ema(close, emaLen)
[plusDI, minusDI, adx] = ta.dmi(14, 14)
rsiVal = ta.rsi(close, 14)

// แก้ Warning: ดึงค่า change ออกมาไว้ด้านนอก
float dayTime     = time("D")
bool  isNewDay    = ta.change(dayTime) != 0

// ==========================================
// 🔍 Session Detection Logic
// ==========================================
// แก้ Error: ใช้ na() กับฟังก์ชัน time (ซึ่งเป็น int) แทนการใช้กับ bool
float sessionTime = time(timeframe.period, sessionInput, "UTC+0")
bool inSession    = not na(sessionTime)

// การเช็คจุดเริ่ม Session สำหรับ bool ใน v6
bool isSessionStart = inSession and not (inSession[1])

var float sessionHigh = na
var float sessionLow  = na

if inSession
    // ถ้าเป็นแท่งแรก หรือค่าเดิมเป็น na (ใช้ na() กับ float ได้ปกติ)
    if isSessionStart or na(sessionHigh)
        sessionHigh := high
        sessionLow  := low
    else
        sessionHigh := math.max(sessionHigh, high)
        sessionLow  := math.min(sessionLow, low)

// Visuals
bgcolor(inSession ? sessionColor : na)
plot(not inSession ? sessionHigh : na, "Session High", color.green, 2, plot.style_linebr)
plot(not inSession ? sessionLow : na, "Session Low", color.red, 2, plot.style_linebr)
plot(emaVal, "Major Trend", color.white, 2)

// ==========================================
// 🚀 Entry Signals
// ==========================================
bool crossHigh = ta.crossover(close, sessionHigh)
bool crossLow  = ta.crossunder(close, sessionLow)

// รวมเงื่อนไข: v6 จะจัดการ na ใน boolean ให้เป็น false โดยอัตโนมัติในคำสั่ง if
bool canTrade      = not inSession and not na(sessionHigh)
bool buyCondition  = canTrade and crossHigh and close > emaVal and adx > adxThres and rsiVal > 55
bool sellCondition = canTrade and crossLow and close < emaVal and adx > adxThres and rsiVal < 45

if buyCondition
    strategy.entry("Long", strategy.long, comment="B-Out L")

if sellCondition
    strategy.entry("Short", strategy.short, comment="B-Out S")

// ==========================================
// 🏁 Exit Logic
// ==========================================
float tpTicks = tpPoints * 10
float slTicks = slPoints * 10

if strategy.position_size != 0
    strategy.exit("Exit", loss=slTicks, profit=tpTicks, trail_points = useTrail ? tpTicks * 0.5 : na, trail_offset = useTrail ? 50 : na)

// ล้างค่าเมื่อเริ่มวันใหม่
if isNewDay
    sessionHigh := na
    sessionLow  := na
