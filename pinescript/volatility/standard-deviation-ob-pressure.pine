//@version=6
indicator("SMA + StdDev", overlay=true, max_bars_back=500, max_labels_count=500)

len       = input.int(20, "Length", minval=2)
src       = input.source(close, "Source")
maxSigma  = input.int(6, "Max Sigma Level", minval=1, maxval=6)
fillZone  = input.bool(false, "Fill ±1σ Zone")
showLabels = input.bool(true, "Show Labels")
maColor   = input.color(#2962FF, "Center Line")
posColor  = input.color(#089981, "Positive Sigma")
negColor  = input.color(#F23645, "Negative Sigma")

ma  = ta.rma(src, len)
dev = ta.stdev(src, len)

plot(ma, "Smoothed MA", color=maColor, linewidth=2)
plot(maxSigma >= 1 ? ma + dev   : na, "Upper 1σ", color=color.new(posColor, 0),   linewidth=1)
plot(maxSigma >= 1 ? ma - dev   : na, "Lower 1σ", color=color.new(negColor, 0),   linewidth=1)
plot(maxSigma >= 2 ? ma + 2*dev : na, "Upper 2σ", color=color.new(posColor, 15),  linewidth=1)
plot(maxSigma >= 2 ? ma - 2*dev : na, "Lower 2σ", color=color.new(negColor, 15),  linewidth=1)
plot(maxSigma >= 3 ? ma + 3*dev : na, "Upper 3σ", color=color.new(posColor, 30),  linewidth=1)
plot(maxSigma >= 3 ? ma - 3*dev : na, "Lower 3σ", color=color.new(negColor, 30),  linewidth=1)
plot(maxSigma >= 4 ? ma + 4*dev : na, "Upper 4σ", color=color.new(posColor, 45),  linewidth=1)
plot(maxSigma >= 4 ? ma - 4*dev : na, "Lower 4σ", color=color.new(negColor, 45),  linewidth=1)
plot(maxSigma >= 5 ? ma + 5*dev : na, "Upper 5σ", color=color.new(posColor, 60),  linewidth=1)
plot(maxSigma >= 5 ? ma - 5*dev : na, "Lower 5σ", color=color.new(negColor, 60),  linewidth=1)
plot(maxSigma >= 6 ? ma + 6*dev : na, "Upper 6σ", color=color.new(posColor, 75),  linewidth=1)
plot(maxSigma >= 6 ? ma - 6*dev : na, "Lower 6σ", color=color.new(negColor, 75),  linewidth=1)

fill(plot(ma + dev, display=fillZone ? display.all : display.none),
     plot(ma - dev, display=fillZone ? display.all : display.none),
     color=color.new(#787B86, 92))

// Alternative to barstate: last bar is the one with highest bar_index so far
var int lastBarIndex = na
if na(lastBarIndex) or bar_index > lastBarIndex
    lastBarIndex := bar_index
isLastBar = bar_index == lastBarIndex and not na(lastBarIndex)

// Reusable labels
var label lMa = na
var label l1u = na
var label l1d = na
var label l2u = na
var label l2d = na
var label l3u = na
var label l3d = na
var label l4u = na
var label l4d = na
var label l5u = na
var label l5d = na
var label l6u = na
var label l6d = na

if showLabels
    if isLastBar
        // Update label positions each bar (realtime)
        if not na(lMa)
            label.set_xy(lMa, bar_index, ma)
        if maxSigma >= 1 and not na(l1u)
            label.set_xy(l1u, bar_index, ma + dev)
            label.set_xy(l1d, bar_index, ma - dev)
        if maxSigma >= 2 and not na(l2u)
            label.set_xy(l2u, bar_index, ma + 2*dev)
            label.set_xy(l2d, bar_index, ma - 2*dev)
        if maxSigma >= 3 and not na(l3u)
            label.set_xy(l3u, bar_index, ma + 3*dev)
            label.set_xy(l3d, bar_index, ma - 3*dev)
        if maxSigma >= 4 and not na(l4u)
            label.set_xy(l4u, bar_index, ma + 4*dev)
            label.set_xy(l4d, bar_index, ma - 4*dev)
        if maxSigma >= 5 and not na(l5u)
            label.set_xy(l5u, bar_index, ma + 5*dev)
            label.set_xy(l5d, bar_index, ma - 5*dev)
        if maxSigma >= 6 and not na(l6u)
            label.set_xy(l6u, bar_index, ma + 6*dev)
            label.set_xy(l6d, bar_index, ma - 6*dev)

    // Create labels once when we first see the last bar
    if isLastBar and na(lMa)
        lMa := label.new(bar_index, ma, "MA", color=maColor, textcolor=color.white, style=label.style_label_left, size=size.small)
        l1u := label.new(bar_index, ma + dev,   "+1σ", color=posColor, textcolor=color.white, style=label.style_label_left, size=size.small)
        l1d := label.new(bar_index, ma - dev,   "-1σ", color=negColor, textcolor=color.white, style=label.style_label_left, size=size.small)
        l2u := label.new(bar_index, ma + 2*dev, "+2σ", color=posColor, textcolor=color.white, style=label.style_label_left, size=size.small)
        l2d := label.new(bar_index, ma - 2*dev, "-2σ", color=negColor, textcolor=color.white, style=label.style_label_left, size=size.small)
        l3u := label.new(bar_index, ma + 3*dev, "+3σ", color=posColor, textcolor=color.white, style=label.style_label_left, size=size.small)
        l3d := label.new(bar_index, ma - 3*dev, "-3σ", color=negColor, textcolor=color.white, style=label.style_label_left, size=size.small)
        l4u := label.new(bar_index, ma + 4*dev, "+4σ", color=posColor, textcolor=color.white, style=label.style_label_left, size=size.small)
        l4d := label.new(bar_index, ma - 4*dev, "-4σ", color=negColor, textcolor=color.white, style=label.style_label_left, size=size.small)
        l5u := label.new(bar_index, ma + 5*dev, "+5σ", color=posColor, textcolor=color.white, style=label.style_label_left, size=size.small)
        l5d := label.new(bar_index, ma - 5*dev, "-5σ", color=negColor, textcolor=color.white, style=label.style_label_left, size=size.small)
        l6u := label.new(bar_index, ma + 6*dev, "+6σ", color=posColor, textcolor=color.white, style=label.style_label_left, size=size.small)
        l6d := label.new(bar_index, ma - 6*dev, "-6σ", color=negColor, textcolor=color.white, style=label.style_label_left, size=size.small)
