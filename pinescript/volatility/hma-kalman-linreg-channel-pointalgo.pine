//@version=5
indicator("HMA + Kalman + LinReg Channel [Pointalgo]", overlay=true)

// --- Inputs ---
len         = input.int(16, "Length", minval=1)
src         = input.source(close, "Source")
baseMult    = input.float(1.5, "Standard Multiplier (Sideways)", step=0.1)
trendLook   = input.int(20, "Trend Lookback Candles")
trendThresh = input.float(1.0, "Trend Threshold (ATR Multiples)", step=0.1, tooltip="If the mid-line moves more than this * ATR over the lookback period, it is considered 'Trending'.")

// Kalman Inputs
R_in = input.float(0.01, "Kalman R", step=0.001)
Q_in = input.float(0.10, "Kalman Q", step=0.01)

// --- Calculations ---

// 1. Kalman Filter Function
kalman_filter(_src, _length, _R, _Q) =>
    var float estimate   = na
    var float error_est  = 1.0
    float error_meas     = _R * _length
    float kalman_gain    = 0.0
    float prediction     = na
    
    if na(estimate)
        estimate := _src[1]
        
    prediction  := estimate
    kalman_gain := error_est / (error_est + error_meas)
    estimate    := prediction + kalman_gain * (_src - prediction)
    error_est   := (1.0 - kalman_gain) * error_est + _Q / _length
    estimate

// 2. Calculate Three Components
hmaLine    = ta.hma(src, len)
kalmanLine = kalman_filter(src, len, R_in, Q_in)
linregLine = ta.linreg(src, len, 0)

// 3. Average Line (Mid Line)
avgLine = (hmaLine + kalmanLine + linregLine) / 3.0

// 4. Dynamic Multiplier Logic
// Calculate ATR for normalization
atrVal = ta.atr(len)

// Calculate change of the Mid Line over 'trendLook' candles
// "Mid line trending any side up or down" vs "Same price zone"
midLineChange = math.abs(avgLine - avgLine[trendLook])

// Determine threshold for "Trending" vs "Sideways"
// We use ATR * trendThresh to define the "Price Zone" size relative to volatility
isTrending = midLineChange > (atrVal * trendThresh)

// Select Multiplier: Half if trending, Full if sideways
finalMult = isTrending ? (baseMult * 0.5) : baseMult

// 5. Calculate Bands
upperBand = avgLine + (atrVal * finalMult)
lowerBand = avgLine - (atrVal * finalMult)

// --- Plotting ---
// Plot Mid Line
colMid = isTrending ? color.orange : color.aqua
plot(avgLine, "Average Line", color=colMid, linewidth=2)

// Plot Bands
p1 = plot(upperBand, "Upper Band", color=color.gray)
p2 = plot(lowerBand, "Lower Band", color=color.gray)
fill(p1, p2, color=isTrending ? color.new(color.orange, 90) : color.new(color.blue, 90))

// Breakout Signals
bullBreak = ta.crossover(close, upperBand)
bearBreak = ta.crossunder(close, lowerBand)

plotshape(bullBreak, "Bull Break", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(bearBreak, "Bear Break", shape.triangledown, location.abovebar, color.red, size=size.small)
