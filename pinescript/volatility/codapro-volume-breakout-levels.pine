//
// Volume Breakout Levels V1.0
// Designed by ArisCodes (The Architect) | Built by ARiS (CodaPro AI Engine)
// [CodaPro] Volume Breakout Levels — Auto S&R with Volume-Confirmed Breaks

//@version=6
indicator("[CodaPro] Volume Breakout Levels", overlay=true, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════
grpSR   = "Support & Resistance"
leftLen  = input.int(15, "Left Bars", minval=5, maxval=50, group=grpSR, tooltip="Bars to the left for pivot detection. Higher = stronger levels.")
rightLen = input.int(15, "Right Bars", minval=5, maxval=50, group=grpSR, tooltip="Bars to the right for pivot confirmation. Higher = more confirmed.")

grpVol  = "Volume Filter"
volLen  = input.int(20, "Volume Average Length", minval=5, maxval=100, group=grpVol, tooltip="Lookback for average volume calculation.")
volMult = input.float(1.5, "Volume Spike Multiplier", minval=1.0, maxval=5.0, step=0.1, group=grpVol, tooltip="Break candle volume must exceed average by this multiplier. Higher = stricter filter.")

grpVis  = "Visuals"
resColor = input.color(#FF4466, "Resistance Color", group=grpVis)
supColor = input.color(#00BBFF, "Support Color", group=grpVis)
showWicks = input.bool(true, "Show Wick Breaks", group=grpVis, tooltip="Flag breaks driven by wicks instead of body — signals hesitation.")
showVolBar = input.bool(true, "Color Break Candles", group=grpVis, tooltip="Highlight candles that break levels with volume confirmation.")

grpAlert = "Alerts"
enableAlerts = input.bool(true, "Enable Alerts", group=grpAlert)

// ═══════════════════════════════════════════════════════════════════════════════
// S&R DETECTION
// ═══════════════════════════════════════════════════════════════════════════════
resistance = fixnan(ta.pivothigh(leftLen, rightLen)[1])
support    = fixnan(ta.pivotlow(leftLen, rightLen)[1])

// ═══════════════════════════════════════════════════════════════════════════════
// VOLUME SEPARATION (CodaPro Engine)
// ═══════════════════════════════════════════════════════════════════════════════
// Bull/Bear volume split — this is what makes it CodaPro
float bodyRange = math.abs(close - open)
float candleRange = high - low
float bodyRatio = candleRange > 0 ? bodyRange / candleRange : 0.5

float bullVolume = close >= open ? volume * (0.5 + bodyRatio * 0.5) : volume * (0.5 - bodyRatio * 0.5)
float bearVolume = volume - bullVolume

// Volume spike detection
float volAvg = ta.sma(volume, volLen)
bool volSpike = volume >= volAvg * volMult

// Bull/Bear dominance on the break candle
bool bullDominant = bullVolume > bearVolume
bool bearDominant = bearVolume > bullVolume

// ═══════════════════════════════════════════════════════════════════════════════
// BREAK DETECTION
// ═══════════════════════════════════════════════════════════════════════════════
// Body break vs wick break classification
bool bodyBreakUp   = close > resistance and close[1] <= resistance[1]
bool bodyBreakDown = close < support and close[1] >= support[1]

// Wick characteristics
bool longLowerWick = (open - low) > (close - open) and close > open
bool longUpperWick = (high - open) > (open - close) and close < open

// Confirmed breaks (volume + direction)
bool bullBreak = bodyBreakUp and volSpike and bullDominant and barstate.isconfirmed
bool bearBreak = bodyBreakDown and volSpike and bearDominant and barstate.isconfirmed

// Wick breaks (break happened but candle shows hesitation)
bool bullWickBreak = bodyBreakUp and volSpike and longLowerWick and barstate.isconfirmed
bool bearWickBreak = bodyBreakDown and volSpike and longUpperWick and barstate.isconfirmed

// ═══════════════════════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════════════════════
// S&R Lines
rPlot = plot(resistance, "Resistance", color=ta.change(resistance) != 0 ? na : resColor, linewidth=2, offset=-(rightLen + 1), style=plot.style_stepline)
sPlot = plot(support, "Support", color=ta.change(support) != 0 ? na : supColor, linewidth=2, offset=-(rightLen + 1), style=plot.style_stepline)

// Break Labels
if bullBreak and not bullWickBreak
    label.new(bar_index, low, "BUY\n" + str.tostring(volume, format.volume), 
         style=label.style_label_up, color=color.new(supColor, 20), textcolor=color.white, size=size.tiny)

if bearBreak and not bearWickBreak
    label.new(bar_index, high, "SELL\n" + str.tostring(volume, format.volume), 
         style=label.style_label_down, color=color.new(resColor, 20), textcolor=color.white, size=size.tiny)

// Wick Break Labels
if showWicks and bullWickBreak
    label.new(bar_index, low, "WICK", 
         style=label.style_label_up, color=color.new(supColor, 50), textcolor=color.white, size=size.tiny)

if showWicks and bearWickBreak
    label.new(bar_index, high, "WICK", 
         style=label.style_label_down, color=color.new(resColor, 50), textcolor=color.white, size=size.tiny)

// Break Candle Coloring
barcolor(showVolBar and bullBreak ? supColor : showVolBar and bearBreak ? resColor : na)

// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════
alertcondition(bullBreak, "Resistance Broken (Volume Confirmed)", "CodaPro: Resistance broken with volume confirmation")
alertcondition(bearBreak, "Support Broken (Volume Confirmed)", "CodaPro: Support broken with volume confirmation")
alertcondition(bullWickBreak, "Resistance Wick Break", "CodaPro: Resistance broken but wick shows hesitation")
alertcondition(bearWickBreak, "Support Wick Break", "CodaPro: Support broken but wick shows hesitation")

