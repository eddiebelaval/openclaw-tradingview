//@version=5
indicator("ASIA/LONDON/NY Session Highs/lows", overlay=true, max_lines_count=500)

// --- Inställningar ---
as_sess = input.session("0100-0700", "Asien", group="Tider")
lo_sess = input.session("0900-1730", "London", group="Tider")
ny_sess = input.session("1530-2200", "New York", group="Tider")

as_col = input.color(color.green, "Asia", inline="1")
lo_col = input.color(color.blue, "London", inline="2")
ny_col = input.color(color.black, "NY", inline="3")

// --- Funktion för linjer som bryts vid touch ---
draw_purge(sess, name, col) =>
    var float s_hi = na
    var float s_lo = na
    var int hi_bar = na
    var int lo_bar = na
    var line l_hi = na
    var line l_lo = na
    var bool hi_purged = false
    var bool lo_purged = false
    
    in_s = not na(time(timeframe.period, sess, "Europe/Stockholm"))
    is_new = in_s and not in_s[1]
    is_midnight = hour(time, "Europe/Stockholm") == 0 and minute(time, "Europe/Stockholm") == 0

    if is_new
        s_hi := high
        s_lo := low
        hi_bar := bar_index
        lo_bar := bar_index
        hi_purged := false
        lo_purged := false
        l_hi := line.new(bar_index, s_hi, bar_index, s_hi, color=col, width=1)
        l_lo := line.new(bar_index, s_lo, bar_index, s_lo, color=col, width=1)
    
    // Under sessionen: Hitta High/Low
    if in_s
        if high > s_hi
            s_hi := high
            hi_bar := bar_index
            line.set_xy1(l_hi, hi_bar, s_hi)
        if low < s_lo
            s_lo := low
            lo_bar := bar_index
            line.set_xy1(l_lo, lo_bar, s_lo)

    // Efter start (inklusive under sessionen): Kolla efter Purge eller Midnatt
    if not na(l_hi)
        // Kolla High Purge
        if not hi_purged
            line.set_xy2(l_hi, bar_index, s_hi)
            if high > s_hi and bar_index > hi_bar
                hi_purged := true
            if is_midnight
                hi_purged := true

        // Kolla Low Purge
        if not lo_purged
            line.set_xy2(l_lo, bar_index, s_lo)
            if low < s_lo and bar_index > lo_bar
                lo_purged := true
            if is_midnight
                lo_purged := true

// --- Kör ---
draw_purge(as_sess, "Asia", as_col)
draw_purge(lo_sess, "London", lo_col)
draw_purge(ny_sess, "NY", ny_col)
