//@version=5
indicator("DAX: Pure RTH Frankfurt + Dynamic Wicks", overlay=true, explicit_plot_zorder = true)

// --- VSTUPY ---
session_input = "0900-1530:1234567"
ib_period     = "0900-1000:1234567"

// Barvy pro svíčky
up_color   = input.color(color.new(#089981, 0), "Růstová svíčka")
down_color = input.color(color.new(#f23645, 0), "Poklesová svíčka")

// --- ČASOVÁ LOGIKA ---
is_in_session = not na(time(timeframe.period, session_input, "Europe/Berlin"))
is_ib_time    = not na(time(timeframe.period, ib_period, "Europe/Berlin"))
is_new_day    = ta.change(time("D", "Europe/Berlin"))

// --- DYNAMICKÁ BARVA ---
candle_color = close >= open ? up_color : down_color

// --- VYKRESLENÍ SVÍČEK (DYNAMICKÉ KNOTY A OHRANIČENÍ) ---
plotcandle(is_in_session ? open : na, is_in_session ? high : na, is_in_session ? low : na, is_in_session ? close : na, 
     title="RTH Candles", 
     color     = candle_color, 
     wickcolor = candle_color, 
     bordercolor = candle_color)

// --- LOGIKA INITIAL BALANCE (IB) ---
var float ib_high = na
var float ib_low  = na

if is_new_day
    ib_high := na
    ib_low  := na

if is_ib_time
    ib_high := na(ib_high) ? high : math.max(high, ib_high)
    ib_low  := na(ib_low) ? low : math.min(low, ib_low)

// --- VYKRESLENÍ IB ---
plot(is_in_session ? ib_high : na, "IB High", color=color.blue, style=plot.style_circles, linewidth=1)
plot(is_in_session ? ib_low : na, "IB Low", color=color.blue, style=plot.style_circles, linewidth=1)
