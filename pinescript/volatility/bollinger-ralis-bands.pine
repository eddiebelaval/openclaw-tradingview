//@version=6
indicator("Bollinger + Ralis Bands", shorttitle="B+RB", overlay=true)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS — BOLLINGER BANDS
// ─────────────────────────────────────────────────────────────────────────────

string G_BB = "═══ BOLLINGER BANDS ═══"
i_length = input.int(20,    "Length",            minval=1,             group=G_BB)
i_mult   = input.float(2.0, "StdDev Multiplier", minval=0.1, step=0.1, group=G_BB)
i_src    = input.source(close, "Source",                               group=G_BB)
i_adaptBB      = input.bool(false,  "Adaptive BB Width",               group=G_BB,
     tooltip="When ON: StdDev multiplier scales dynamically between Min and Max based on ATR ratio (current ATR / average ATR). High-vol widens bands, low-vol tightens them.")
i_adaptATRLen  = input.int(14,      "Adaptive ATR Length",             group=G_BB, minval=1,   maxval=200)
i_adaptAvgLen  = input.int(100,     "Adaptive ATR Avg Length",         group=G_BB, minval=10,  maxval=500)
i_adaptMinMult = input.float(1.2,   "Adaptive Min Mult",              group=G_BB, minval=0.1, maxval=10.0, step=0.1)
i_adaptMaxMult = input.float(3.0,   "Adaptive Max Mult",              group=G_BB, minval=0.1, maxval=10.0, step=0.1)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS — DISPLAY
// ─────────────────────────────────────────────────────────────────────────────

string G_VIZ = "═══ DISPLAY ═══"
i_showBands = input.bool(true,     "Show Bollinger Bands",  group=G_VIZ)
i_showMid   = input.bool(true,     "Show Midline",          group=G_VIZ)
i_showFill  = input.bool(true,     "Show Band Fill",        group=G_VIZ)
i_fillColor = input.color(#FF8C00, "Band Fill Color",       group=G_VIZ)
i_fillOpac  = input.int(90,       "Band Fill Transparency", group=G_VIZ, minval=0, maxval=99, step=5)
i_bullColor = input.color(#00FFFF, "Buy Signal Color",      group=G_VIZ)
i_bearColor = input.color(#FF00FF, "Sell Signal Color",     group=G_VIZ)
i_bandColor = input.color(#FF6600, "Band Color",            group=G_VIZ)
i_midColor  = input.color(#888888, "Midline Color",         group=G_VIZ)
i_showTable = input.bool(true,     "Show Info Table",       group=G_VIZ)
i_tblPos    = input.string("Bottom Center", "Table Position",
     options=["Top Left","Top Center","Top Right","Middle Left","Middle Center","Middle Right","Bottom Left","Bottom Center","Bottom Right"],
     group=G_VIZ)
i_showRsiDiv   = input.bool(true,    "Show RSI Divergence",   group=G_VIZ)
i_rsiDivLen    = input.int(14,       "RSI Div Length",        minval=5,  maxval=30,  group=G_VIZ)
i_pivotLookL   = input.int(5,        "Pivot Lookback Left",   minval=2,  maxval=20,  group=G_VIZ)
i_pivotLookR   = input.int(2,        "Pivot Lookback Right",  minval=1,  maxval=10,  group=G_VIZ)
i_divLookback  = input.int(60,       "Max Bars Between Pivots", minval=10, maxval=200, group=G_VIZ)
i_bullDivColor = input.color(#00FF88, "Bullish Div Color",    group=G_VIZ)
i_bearDivColor = input.color(#FF4444, "Bearish Div Color",    group=G_VIZ)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS — SIGNALS
// ─────────────────────────────────────────────────────────────────────────────

string G_SIG = "═══ SIGNALS ═══"
i_buyCooldown     = input.int(2,      "Buy Cooldown (bars)",          group=G_SIG, minval=0, maxval=50,
     tooltip="Minimum bars between buy signals. 0 = no cooldown.")
i_sellCooldown    = input.int(2,      "Sell Cooldown (bars)",         group=G_SIG, minval=0, maxval=50,
     tooltip="Minimum bars between sell signals. 0 = no cooldown.")
i_maxBuyTiers     = input.int(6,      "Max Buy Tiers",               group=G_SIG, minval=1, maxval=26,
     tooltip="Max buy signals per cycle before capping. Default 6 (A through F).")
i_maxSellTiers    = input.int(10,     "Max Sell Tiers",              group=G_SIG, minval=1, maxval=26,
     tooltip="Max sell signals per cycle before capping. Default 6 (A through F).")

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS — RALIS RIBBON
// ─────────────────────────────────────────────────────────────────────────────

string G_RIBBON = "═══ RALIS RIBBON ═══"
i_enableRibbon  = input.bool(true,  "Enable Ribbon Filter",      group=G_RIBBON,
     tooltip="When ON: buys only fire in bear regime (fast < slow). Sells only fire in bull regime (fast > slow).")
i_ribbonFast    = input.int(12,     "Fast SMMA Length",          group=G_RIBBON, minval=2, maxval=50)
i_ribbonSlow    = input.int(24,     "Slow SMMA Length",          group=G_RIBBON, minval=3, maxval=100)
i_showRibbon    = input.bool(true,  "Show Ribbon on Chart",      group=G_RIBBON)
i_enableGap     = input.bool(true,  "Enable Gap Filter",         group=G_RIBBON)
i_minGapPct     = input.float(0.24, "Min Ribbon Gap %",          group=G_RIBBON, minval=0.01, maxval=5.0, step=0.05)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS — BBWP (Bollinger Band Width Percentile)
// ─────────────────────────────────────────────────────────────────────────────

string G_BBWP = "═══ BBWP BACKGROUND ═══"
i_showBBWP     = input.bool(true,   "Show BBWP Background",       group=G_BBWP,
     tooltip="Gradient background shading based on Bollinger Band Width Percentile. Low BBWP (compressed bands) = volatility coiling, big move loading.")
i_bbwpLen      = input.int(124,     "BBWP Lookback",              group=G_BBWP, minval=50, maxval=1000,
     tooltip="Lookback period for percentile rank of BB width. 124 = ~5 days on 1H.")
i_bbwpCompMax  = input.int(15,      "Compression Zone (≤ %)",     group=G_BBWP, minval=5, maxval=50, step=5,
     tooltip="BBWP at or below this = compression zone (purple/cyan background). Default 20%.")
i_bbwpExpMin   = input.int(85,      "Expansion Zone (≥ %)",       group=G_BBWP, minval=50, maxval=95, step=5,
     tooltip="BBWP at or above this = expansion zone (orange/red background). Default 80%.")
i_bbwpOpacity  = input.int(88,      "Background Opacity",         group=G_BBWP, minval=50, maxval=96, step=2,
     tooltip="Transparency of BBWP background. Higher = more transparent. 88 = subtle, 75 = visible, 60 = bold.")

// ─────────────────────────────────────────────────────────────────────────────
// BOLLINGER BAND CALCULATION
// ─────────────────────────────────────────────────────────────────────────────

float basis = ta.sma(i_src, i_length)
float _atr       = ta.atr(i_adaptATRLen)
float _atrAvg    = ta.sma(_atr, i_adaptAvgLen)
float _volRatio  = _atrAvg > 0 ? _atr / _atrAvg : 1.0
float _adaptMult = i_adaptMinMult + (_volRatio - 1.0) * (i_adaptMaxMult - i_adaptMinMult)
float _clampMult = math.max(i_adaptMinMult, math.min(_adaptMult, i_adaptMaxMult))
float effMult    = i_adaptBB ? _clampMult : i_mult
float dev   = effMult * ta.stdev(i_src, i_length)
float upper = basis + dev
float lower = basis - dev

// ─────────────────────────────────────────────────────────────────────────────
// BBWP (Bollinger Band Width Percentile)
// ─────────────────────────────────────────────────────────────────────────────

float bbWidth = basis != 0 ? (upper - lower) / basis * 100.0 : 0.0
float bbwp    = ta.percentrank(bbWidth, i_bbwpLen)

// ─────────────────────────────────────────────────────────────────────────────
// MULTI-TIMEFRAME EMA (1H and Daily)
// ─────────────────────────────────────────────────────────────────────────────

float ema1h24 = request.security(syminfo.tickerid, "60", ta.ema(close, 24), lookahead=barmerge.lookahead_off)
float emaD24  = request.security(syminfo.tickerid, "D",  ta.ema(close, 24), lookahead=barmerge.lookahead_off)
bool priceAbove1hEma    = close > ema1h24
bool priceAboveDailyEma = close > emaD24

// ─────────────────────────────────────────────────────────────────────────────
// RSI & ADX
// ─────────────────────────────────────────────────────────────────────────────

float tblRsi = ta.rsi(close, 14)

// Manual DMI/ADX calculation (Pine v6 compatible)
float _hiDiff = high - high[1]
float _loDiff = low[1] - low
float _plusDM  = _hiDiff > _loDiff and _hiDiff > 0 ? _hiDiff : 0.0
float _minusDM = _loDiff > _hiDiff and _loDiff > 0 ? _loDiff : 0.0
float _atrDmi  = ta.rma(ta.tr, 14)
float diPlus   = _atrDmi > 0 ? 100 * ta.rma(_plusDM, 14)  / _atrDmi : 0.0
float diMinus  = _atrDmi > 0 ? 100 * ta.rma(_minusDM, 14) / _atrDmi : 0.0
float _dx      = (diPlus + diMinus) > 0 ? 100 * math.abs(diPlus - diMinus) / (diPlus + diMinus) : 0.0
float tblAdxVal = ta.rma(_dx, 14)

// ─────────────────────────────────────────────────────────────────────────────
// RALIS RIBBON
// ─────────────────────────────────────────────────────────────────────────────

smma_r(float src, int len) =>
    var float _s = na
    _s := na(_s) ? ta.sma(src, len) : (_s * (len - 1) + src) / len
    _s

float ribbonFast   = smma_r(hl2, i_ribbonFast)
float ribbonSlow   = smma_r(hl2, i_ribbonSlow)
bool  ribbonBull   = ribbonFast > ribbonSlow
float ribbonGapPct = ribbonSlow != 0 ? math.abs(ribbonFast - ribbonSlow) / ribbonSlow * 100 : 0.0
bool  ribbonGapOK  = not i_enableGap or ribbonGapPct >= i_minGapPct
bool  ribbonBuyOK  = not i_enableRibbon or (not ribbonBull and ribbonGapOK)
bool  ribbonSellOK = not i_enableRibbon or (ribbonBull    and ribbonGapOK)

// ─────────────────────────────────────────────────────────────────────────────
// SIGNAL LOGIC + PYRAMID COUNTERS
// ─────────────────────────────────────────────────────────────────────────────

var int lastBuyBar  = na
var int lastSellBar = na
bool buyCdOK  = na(lastBuyBar)  or (bar_index - lastBuyBar)  >= i_buyCooldown
bool sellCdOK = na(lastSellBar) or (bar_index - lastSellBar) >= i_sellCooldown
bool buyRaw  = barstate.isconfirmed and close < lower
bool sellRaw = barstate.isconfirmed and close > upper

var int  buyCount    = 0
var int  sellCount   = 0
var bool inSellPhase = false

bool buySignal  = buyRaw  and buyCdOK  and (buyCount < i_maxBuyTiers)   and ribbonBuyOK
bool sellSignal = sellRaw and sellCdOK and (sellCount < i_maxSellTiers) and ribbonSellOK

if buySignal
    lastBuyBar := bar_index
if sellSignal
    lastSellBar := bar_index

if buySignal
    if inSellPhase
        sellCount   := 0
        inSellPhase := false
    buyCount += 1

if sellSignal
    if not inSellPhase
        buyCount    := 0
        inSellPhase := true
    sellCount += 1

// Tier letter: 1→A, 2→B, ... 26→Z
f_tierLetter(int count) =>
    string letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    int idx = math.max(1, math.min(count, 26))
    str.substring(letters, idx - 1, idx)

// ─────────────────────────────────────────────────────────────────────────────
// PERFORMANCE METRICS
// ─────────────────────────────────────────────────────────────────────────────

string G_PERF = "═══ PERFORMANCE ═══"
i_showPerf  = input.bool(true, "Show Performance Rows", group=G_PERF,
     tooltip="WR, PF, Expectancy, Best/Worst. Round trips counted as entry cycle → 2 sells.")
i_statsDays = input.int(90,    "Lookback (days)",       group=G_PERF, minval=7, maxval=730, step=7)

var float[] pos_prices      = array.new_float(0)
var int[]   pos_bars        = array.new_int(0)
var int     perf_sell_count = 0
var float   perf_sell1_price = na
var int     perf_sell1_bar   = na
var int     perf_buyCount   = 0
var int     perf_sellCount  = 0
var float[] perf_pnlWindow  = array.new_float(0)
var int[]   perf_timeWindow = array.new_int(0)
var float   w_sumPnl   = 0.0
var int     w_winCnt   = 0
var float   w_bestRun  = na
var float   w_worstRun = na

f_avgCost() =>
    int   _n   = array.size(pos_prices)
    float _sum = 0.0
    if _n > 0
        for _i = 0 to _n - 1
            _sum += array.get(pos_prices, _i)
        _sum / _n
    else
        float(na)

if buySignal
    perf_buyCount += 1
    array.push(pos_prices, close)
    array.push(pos_bars,   bar_index)

if sellSignal and array.size(pos_prices) > 0
    perf_sellCount  += 1
    perf_sell_count += 1
    if perf_sell_count == 1
        perf_sell1_price := close
        perf_sell1_bar   := bar_index
    else if perf_sell_count >= 2
        float _avgCost     = f_avgCost()
        float _blendedExit = (perf_sell1_price + close) / 2.0
        float _tradePnl    = not na(_avgCost) and _avgCost != 0 ? (_blendedExit - _avgCost) / _avgCost * 100.0 : 0.0
        array.push(perf_pnlWindow, _tradePnl)
        array.push(perf_timeWindow, time)
        w_sumPnl += _tradePnl
        w_winCnt += _tradePnl > 0 ? 1 : 0
        w_bestRun  := na(w_bestRun)  ? _tradePnl : math.max(w_bestRun,  _tradePnl)
        w_worstRun := na(w_worstRun) ? _tradePnl : math.min(w_worstRun, _tradePnl)
        int _cutoff = time - i_statsDays * 86400000
        while array.size(perf_timeWindow) > 0 and array.get(perf_timeWindow, 0) < _cutoff
            float _old = array.shift(perf_pnlWindow)
            array.shift(perf_timeWindow)
            w_sumPnl -= _old
            if _old > 0
                w_winCnt -= 1
            if (_old == w_bestRun) or (_old == w_worstRun)
                int _sz = array.size(perf_pnlWindow)
                w_bestRun  := _sz > 0 ? array.get(perf_pnlWindow, 0) : na
                w_worstRun := _sz > 0 ? array.get(perf_pnlWindow, 0) : na
                if _sz > 0
                    for _pi = 0 to _sz - 1
                        float _p = array.get(perf_pnlWindow, _pi)
                        w_bestRun  := math.max(w_bestRun,  _p)
                        w_worstRun := math.min(w_worstRun, _p)
        array.clear(pos_prices)
        array.clear(pos_bars)
        perf_sell_count  := 0
        perf_sell1_price := na
        perf_sell1_bar   := na

int   w_trades     = array.size(perf_pnlWindow)
float w_avgPnl     = w_trades > 0 ? w_sumPnl / w_trades : 0.0
float w_winRate    = w_trades > 0 ? w_winCnt / w_trades * 100.0 : 0.0
float w_grossWin   = 0.0
float w_grossLoss  = 0.0
if w_trades > 0
    for _i = 0 to w_trades - 1
        float _p = array.get(perf_pnlWindow, _i)
        if _p > 0
            w_grossWin  += _p
        else
            w_grossLoss += math.abs(_p)
float w_pf         = w_grossLoss > 0 ? w_grossWin / w_grossLoss : na
int   w_losses     = w_trades - w_winCnt
float w_avgWin     = w_winCnt > 0 ? w_grossWin  / w_winCnt  : 0.0
float w_avgLoss    = w_losses > 0 ? w_grossLoss / w_losses  : 0.0
float w_lossRate   = w_trades > 0 ? w_losses / w_trades * 100.0 : 0.0
float w_expectancy = w_trades > 0 ? (w_avgWin * (w_winRate / 100.0)) - (w_avgLoss * (w_lossRate / 100.0)) : na

bool  perf_inPosition  = array.size(pos_prices) > 0
float perf_avgCostNow  = f_avgCost()
float perf_openPnlPct  = perf_inPosition and not na(perf_avgCostNow) and perf_avgCostNow != 0 ? (close - perf_avgCostNow) / perf_avgCostNow * 100.0 : na
bool  perf_sell1Pending = perf_sell_count == 1

string perf_wrStr    = w_trades > 0 ? str.tostring(w_winRate, "#.#") + "%" : "—"
string perf_avgStr   = w_trades > 0 ? (w_avgPnl >= 0 ? "+" : "") + str.tostring(w_avgPnl, "#.##") + "%" : "—"
string perf_bestStr  = not na(w_bestRun)  ? str.tostring(w_bestRun,  "#.##") + "%" : "—"
string perf_worstStr = not na(w_worstRun) ? str.tostring(w_worstRun, "#.##") + "%" : "—"
string perf_pfStr    = na(w_pf) ? (w_winCnt > 0 ? "∞" : "—") : str.tostring(w_pf, "#.##")
string perf_expStr   = na(w_expectancy) ? "—" : (w_expectancy >= 0 ? "+" : "") + str.tostring(w_expectancy, "#.##") + "%"

color perf_pfColor   = w_trades == 0 ? color.new(color.gray, 50) : na(w_pf) and w_winCnt > 0 ? color.new(color.green, 30) : na(w_pf) ? color.new(color.gray, 50) : w_pf >= 2.0 ? color.new(color.green, 30) : w_pf >= 1.0 ? color.new(color.yellow, 50) : color.new(color.red, 50)
color perf_expColor  = na(w_expectancy) ? color.new(color.gray, 50) : w_expectancy > 0 ? color.new(color.green, 50) : color.new(color.red, 50)
color perf_wrColor   = w_trades == 0 ? color.new(color.gray, 50) : w_winRate >= 70 ? color.new(color.green, 40) : w_winRate >= 50 ? color.new(color.yellow, 50) : color.new(color.red, 50)
color perf_avgColor  = w_trades == 0 ? color.new(color.gray, 50) : w_avgPnl > 0 ? color.new(color.green, 50) : color.new(color.red, 50)

// ─────────────────────────────────────────────────────────────────────────────
// INFO TABLE
// ─────────────────────────────────────────────────────────────────────────────

string sigText  = buySignal ? "BUY ▲" : sellSignal ? "SELL ▼" : "—"
color  sigColor = buySignal ? color.new(#00FFFF, 0) : sellSignal ? color.new(#FF00FF, 0) : color.new(color.gray, 50)

if i_showTable and barstate.islast
    var tblPos = switch i_tblPos
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        =>                 position.bottom_right

    var table t = table.new(tblPos, 4, 9, bgcolor=color.new(color.black, 30), border_width=1)

    color _lbl = color.new(color.silver, 20)
    color _hdr = color.new(color.black,  20)

    // Row 0: Header — Bollinger + Ralis Bands | Ticker | TF | Signal
    table.cell(t, 0, 0, "B+RB",             bgcolor=_hdr, text_color=color.white,  text_size=size.small, text_halign=text.align_center)
    table.cell(t, 1, 0, syminfo.ticker,    bgcolor=_hdr, text_color=color.yellow, text_size=size.small, text_halign=text.align_center)
    table.cell(t, 2, 0, timeframe.period,  bgcolor=_hdr, text_color=color.yellow, text_size=size.small, text_halign=text.align_center)
    table.cell(t, 3, 0, sigText,           bgcolor=sigColor, text_color=color.white, text_size=size.small, text_halign=text.align_center)

    // Row 1: Buy Tier | Sell Tier (A-F labels)
    string _buyTierStr  = buyCount  == 0 ? "Next: A" : f_tierLetter(buyCount) + " ✓  Next: " + (buyCount < i_maxBuyTiers ? f_tierLetter(buyCount + 1) : "MAX")
    string _sellTierStr = sellCount == 0 ? "Next: A" : f_tierLetter(sellCount) + " ✓  Next: " + (sellCount < i_maxSellTiers ? f_tierLetter(sellCount + 1) : "MAX")
    color _buyTierBg    = buyCount  == 0 ? color.new(color.gray, 50) : color.new(#00FFFF, 30)
    color _sellTierBg   = sellCount == 0 ? color.new(color.gray, 50) : color.new(#FF00FF, 30)
    table.cell(t, 0, 1, "Buy Tier",    bgcolor=_hdr, text_color=_lbl, text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 1, 1, _buyTierStr,   bgcolor=_buyTierBg,  text_color=color.white, text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 2, 1, "Sell Tier",   bgcolor=_hdr, text_color=_lbl, text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 3, 1, _sellTierStr,  bgcolor=_sellTierBg, text_color=color.white, text_size=size.tiny, text_halign=text.align_center)

    // Row 2: Ribbon status
    string _ribbonRegime = not i_enableRibbon ? "OFF" : ribbonBull ? "▲ GOLD" : "▼ BLUE"
    color  _ribbonRegBg  = not i_enableRibbon ? color.new(color.gray, 60) : ribbonBull ? color.new(#FFD700, 35) : color.new(#1E90FF, 35)
    color  _ribbonRegTxt = not i_enableRibbon ? color.white : ribbonBull ? color.black : color.white
    string _ribbonGapStr = not i_enableRibbon ? "—" : str.tostring(ribbonGapPct, "#.###") + "%  " + (ribbonGapOK ? "✓" : "✗ <" + str.tostring(i_minGapPct, "#.##") + "%")
    color  _ribbonGapBg  = not i_enableRibbon ? color.new(color.gray, 60) : ribbonGapOK ? color.new(color.teal, 45) : color.new(color.red, 45)
    table.cell(t, 0, 2, "Ribbon",      bgcolor=_hdr,          text_color=_lbl,          text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 1, 2, _ribbonRegime, bgcolor=_ribbonRegBg,  text_color=_ribbonRegTxt, text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 2, 2, "Gap",         bgcolor=_hdr,          text_color=_lbl,          text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 3, 2, _ribbonGapStr, bgcolor=_ribbonGapBg,  text_color=color.white,   text_size=size.tiny, text_halign=text.align_center)

    // Row 3: Buy/Sell Gate
    string _ribbonBuyStr  = not i_enableRibbon ? "—" : ribbonBuyOK  ? "✓ OPEN" : (not ribbonGapOK ? "✗ GAP" : "✗ GOLD")
    string _ribbonSellStr = not i_enableRibbon ? "—" : ribbonSellOK ? "✓ OPEN" : (not ribbonGapOK ? "✗ GAP" : "✗ BLUE")
    color  _ribbonBuyBg   = not i_enableRibbon ? color.new(color.gray, 60) : ribbonBuyOK  ? color.new(color.teal, 45) : color.new(color.gray, 60)
    color  _ribbonSellBg  = not i_enableRibbon ? color.new(color.gray, 60) : ribbonSellOK ? color.new(color.teal, 45) : color.new(color.gray, 60)
    table.cell(t, 0, 3, "Buy Gate",       bgcolor=_hdr,          text_color=_lbl,        text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 1, 3, _ribbonBuyStr,    bgcolor=_ribbonBuyBg,  text_color=color.white, text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 2, 3, "Sell Gate",      bgcolor=_hdr,          text_color=_lbl,        text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 3, 3, _ribbonSellStr,   bgcolor=_ribbonSellBg, text_color=color.white, text_size=size.tiny, text_halign=text.align_center)

    // Row 4: BBWP
    string _bbwpStr = str.tostring(bbwp, "#.#") + "%"
    float _compMid = i_bbwpCompMax * 0.75
    float _expMid  = i_bbwpExpMin + (100 - i_bbwpExpMin) * 0.25
    string _bbwpState = bbwp <= _compMid ? "COILED" : bbwp <= i_bbwpCompMax ? "TIGHT" : bbwp >= (100 - (100 - i_bbwpExpMin) * 0.25) ? "EXTREME" : bbwp >= i_bbwpExpMin ? "EXPANDED" : "NORMAL"
    color _bbwpBg = bbwp <= _compMid ? color.new(#6A1B9A, 30) : bbwp <= i_bbwpCompMax ? color.new(#00BCD4, 40) : bbwp >= _expMid + (100 - _expMid) * 0.5 ? color.new(#D32F2F, 30) : bbwp >= i_bbwpExpMin ? color.new(#FF9800, 40) : color.new(color.gray, 50)
    string _bbWidthStr = str.tostring(bbWidth, "#.##") + "%"
    table.cell(t, 0, 4, "BBWP",         bgcolor=_hdr,   text_color=_lbl,        text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 1, 4, _bbwpStr,       bgcolor=_bbwpBg, text_color=color.white, text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 2, 4, _bbwpState,     bgcolor=_bbwpBg, text_color=color.white, text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 3, 4, "W:" + _bbWidthStr, bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.tiny, text_halign=text.align_center)

    // Row 5: 1H EMA24 | D EMA24
    color _ema1hBg    = priceAbove1hEma    ? color.new(color.green, 40) : color.new(color.red, 40)
    color _emaDailyBg = priceAboveDailyEma ? color.new(color.green, 40) : color.new(color.red, 40)
    table.cell(t, 0, 5, "1H EMA24",   bgcolor=_hdr,       text_color=_lbl,        text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 1, 5, str.tostring(ema1h24, "#.##"), bgcolor=_ema1hBg, text_color=color.white, text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 2, 5, "D EMA24",    bgcolor=_hdr,       text_color=_lbl,        text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 3, 5, str.tostring(emaD24, "#.##"),  bgcolor=_emaDailyBg, text_color=color.white, text_size=size.tiny, text_halign=text.align_center)

    // Row 6: RSI | ADX | +DI | -DI
    color _rsiBg = tblRsi >= 70 ? color.new(color.red, 40) : tblRsi <= 30 ? color.new(color.green, 40) : color.new(color.gray, 50)
    color _adxBg = tblAdxVal >= 25 ? color.new(color.orange, 40) : color.new(color.gray, 50)
    table.cell(t, 0, 6, "RSI",    bgcolor=_hdr,  text_color=_lbl,        text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 1, 6, str.tostring(tblRsi, "#"), bgcolor=_rsiBg, text_color=color.white, text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 2, 6, "ADX",    bgcolor=_hdr,  text_color=_lbl,        text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 3, 6, str.tostring(tblAdxVal, "#") + "  +" + str.tostring(diPlus, "#.#") + " -" + str.tostring(diMinus, "#.#"), bgcolor=_adxBg, text_color=color.white, text_size=size.tiny, text_halign=text.align_center)

    // Row 7-8: Performance (conditional)
    if i_showPerf
        table.cell(t, 0, 7, "PF: "   + perf_pfStr,  bgcolor=perf_pfColor,  text_color=color.white, text_size=size.tiny, text_halign=text.align_center)
        table.cell(t, 1, 7, "EXP: "  + perf_expStr, bgcolor=perf_expColor, text_color=color.white, text_size=size.tiny, text_halign=text.align_center)
        table.cell(t, 2, 7, "Trades", bgcolor=_hdr,  text_color=_lbl,       text_size=size.tiny, text_halign=text.align_center)
        table.cell(t, 3, 7, str.tostring(w_trades) + (perf_inPosition ? "+" : ""), bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.tiny, text_halign=text.align_center)
        table.cell(t, 0, 8, "WR: "  + perf_wrStr,   bgcolor=perf_wrColor,              text_color=color.white, text_size=size.tiny, text_halign=text.align_center)
        table.cell(t, 1, 8, "Avg: " + perf_avgStr,  bgcolor=perf_avgColor,             text_color=color.white, text_size=size.tiny, text_halign=text.align_center)
        table.cell(t, 2, 8, "▲"    + perf_bestStr,  bgcolor=color.new(color.green, 55), text_color=color.white, text_size=size.tiny, text_halign=text.align_center)
        table.cell(t, 3, 8, "▼"    + perf_worstStr, bgcolor=color.new(color.red,   55), text_color=color.white, text_size=size.tiny, text_halign=text.align_center)

// ─────────────────────────────────────────────────────────────────────────────
// PLOTS
// ─────────────────────────────────────────────────────────────────────────────

// Ralis Ribbon
color _ribbonColor = ribbonBull ? color.new(#FFD700, 0) : color.new(#1E90FF, 0)
color _ribbonFill  = ribbonBull ? color.new(#FFD700, 82) : color.new(#1E90FF, 82)
p_rFast = plot(i_showRibbon ? ribbonFast : na, "Ribbon Fast", color=_ribbonColor, linewidth=1)
p_rSlow = plot(i_showRibbon ? ribbonSlow : na, "Ribbon Slow", color=_ribbonColor, linewidth=1)
fill(p_rFast, p_rSlow, color=_ribbonFill, title="Ribbon Fill")

// Bollinger Bands
p_upper = plot(i_showBands ? upper : na, "Upper Band", color=color.new(i_bandColor, 20), linewidth=2)
p_lower = plot(i_showBands ? lower : na, "Lower Band", color=color.new(i_bandColor, 20), linewidth=2)
plot(i_showMid ? basis : na, "Midline", color=color.new(i_midColor, 30), linewidth=1)
fill(p_upper, p_lower, color=i_showFill ? color.new(i_fillColor, i_fillOpac) : na, title="Band Fill")

// Signal arrows
plotshape(buySignal,  title="BUY",  style=shape.triangleup,   location=location.belowbar, color=i_bullColor, size=size.small, display=display.pane)
plotshape(sellSignal, title="SELL", style=shape.triangledown, location=location.abovebar, color=i_bearColor, size=size.small, display=display.pane)

// Tier labels A-F via plotchar, G+ via label.new
bool _buyA  = buySignal and buyCount == 1
bool _buyB  = buySignal and buyCount == 2
bool _buyC  = buySignal and buyCount == 3
bool _buyD  = buySignal and buyCount == 4
bool _buyE  = buySignal and buyCount == 5
bool _buyF  = buySignal and buyCount == 6
bool _sellA = sellSignal and sellCount == 1
bool _sellB = sellSignal and sellCount == 2
bool _sellC = sellSignal and sellCount == 3
bool _sellD = sellSignal and sellCount == 4
bool _sellE = sellSignal and sellCount == 5
bool _sellF = sellSignal and sellCount == 6

plotchar(_buyA,  title="Buy A",  char=" ", location=location.belowbar, text="A", textcolor=i_bullColor, size=size.tiny, display=display.pane)
plotchar(_buyB,  title="Buy B",  char=" ", location=location.belowbar, text="B", textcolor=i_bullColor, size=size.tiny, display=display.pane)
plotchar(_buyC,  title="Buy C",  char=" ", location=location.belowbar, text="C", textcolor=i_bullColor, size=size.tiny, display=display.pane)
plotchar(_buyD,  title="Buy D",  char=" ", location=location.belowbar, text="D", textcolor=i_bullColor, size=size.tiny, display=display.pane)
plotchar(_buyE,  title="Buy E",  char=" ", location=location.belowbar, text="E", textcolor=i_bullColor, size=size.tiny, display=display.pane)
plotchar(_buyF,  title="Buy F",  char=" ", location=location.belowbar, text="F", textcolor=i_bullColor, size=size.tiny, display=display.pane)
plotchar(_sellA, title="Sell A", char=" ", location=location.abovebar, text="A", textcolor=i_bearColor, size=size.tiny, display=display.pane)
plotchar(_sellB, title="Sell B", char=" ", location=location.abovebar, text="B", textcolor=i_bearColor, size=size.tiny, display=display.pane)
plotchar(_sellC, title="Sell C", char=" ", location=location.abovebar, text="C", textcolor=i_bearColor, size=size.tiny, display=display.pane)
plotchar(_sellD, title="Sell D", char=" ", location=location.abovebar, text="D", textcolor=i_bearColor, size=size.tiny, display=display.pane)
plotchar(_sellE, title="Sell E", char=" ", location=location.abovebar, text="E", textcolor=i_bearColor, size=size.tiny, display=display.pane)
plotchar(_sellF, title="Sell F", char=" ", location=location.abovebar, text="F", textcolor=i_bearColor, size=size.tiny, display=display.pane)

// G-J+ overflow via label.new
if buySignal and buyCount > 6
    label.new(bar_index, low, f_tierLetter(buyCount), style=label.style_label_up, textcolor=i_bullColor, color=color.new(color.black, 100), size=size.tiny, yloc=yloc.belowbar)
if sellSignal and sellCount > 6
    label.new(bar_index, high, f_tierLetter(sellCount), style=label.style_label_down, textcolor=i_bearColor, color=color.new(color.black, 100), size=size.tiny, yloc=yloc.abovebar)

barcolor(buySignal ? i_bullColor : sellSignal ? i_bearColor : na, title="Signal Bar Color")

// ─────────────────────────────────────────────────────────────────────────────
// RSI DIVERGENCE (display only)
// ─────────────────────────────────────────────────────────────────────────────

float divRsi = ta.rsi(close, i_rsiDivLen)
float pricePivotLow  = ta.pivotlow(low,    i_pivotLookL, i_pivotLookR)
float rsiPivotLow    = ta.pivotlow(divRsi, i_pivotLookL, i_pivotLookR)
float pricePivotHigh = ta.pivothigh(high,    i_pivotLookL, i_pivotLookR)
float rsiPivotHigh   = ta.pivothigh(divRsi, i_pivotLookL, i_pivotLookR)

var float prevPriceLow = na, var float prevRsiLow = na
var float prevPriceHigh = na, var float prevRsiHigh = na
var int prevLowBar = na, var int prevHighBar = na

bool bullDiv = false
if not na(pricePivotLow) and not na(rsiPivotLow)
    if not na(prevPriceLow) and not na(prevRsiLow) and (bar_index - prevLowBar) <= i_divLookback and low[i_pivotLookR] < prevPriceLow and divRsi[i_pivotLookR] > prevRsiLow
        bullDiv := true
    prevPriceLow := low[i_pivotLookR]
    prevRsiLow   := divRsi[i_pivotLookR]
    prevLowBar   := bar_index - i_pivotLookR

bool bearDiv = false
if not na(pricePivotHigh) and not na(rsiPivotHigh)
    if not na(prevPriceHigh) and not na(prevRsiHigh) and (bar_index - prevHighBar) <= i_divLookback and high[i_pivotLookR] > prevPriceHigh and divRsi[i_pivotLookR] < prevRsiHigh
        bearDiv := true
    prevPriceHigh := high[i_pivotLookR]
    prevRsiHigh   := divRsi[i_pivotLookR]
    prevHighBar   := bar_index - i_pivotLookR

plotshape(i_showRsiDiv and bullDiv, title="Bull RSI Div", style=shape.labelup, location=location.belowbar, color=i_bullDivColor, textcolor=color.black, text="D", size=size.tiny, offset=-i_pivotLookR, display=display.pane)
plotshape(i_showRsiDiv and bearDiv, title="Bear RSI Div", style=shape.labeldown, location=location.abovebar, color=i_bearDivColor, textcolor=color.white, text="D", size=size.tiny, offset=-i_pivotLookR, display=display.pane)

// ─────────────────────────────────────────────────────────────────────────────
// BBWP GRADIENT BACKGROUND
// ─────────────────────────────────────────────────────────────────────────────

color bbwpBg = na
if i_showBBWP and not na(bbwp)
    if bbwp <= i_bbwpCompMax
        float t = (i_bbwpCompMax - bbwp) / i_bbwpCompMax
        int opac = math.round(i_bbwpOpacity - t * 25)
        color base = color.from_gradient(bbwp, 0, i_bbwpCompMax, #6A1B9A, #00BCD4)
        bbwpBg := color.new(base, opac)
    else if bbwp >= i_bbwpExpMin
        float _expRange = 100.0 - i_bbwpExpMin
        float t = (bbwp - i_bbwpExpMin) / _expRange
        int opac = math.round(i_bbwpOpacity - t * 20)
        color base = color.from_gradient(bbwp, i_bbwpExpMin, 100, #FF9800, #D32F2F)
        bbwpBg := color.new(base, opac)

bgcolor(bbwpBg, title="BBWP Background")

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────

alertcondition(buySignal,  title="Bollinger + Ralis Bands BUY",  message="Bollinger + Ralis Bands: BUY {{ticker}} at {{close}}")
alertcondition(sellSignal, title="Bollinger + Ralis Bands SELL", message="Bollinger + Ralis Bands: SELL {{ticker}} at {{close}}")
alertcondition(buySignal or sellSignal, title="Bollinger + Ralis Bands Signal", message="Bollinger + Ralis Bands: Signal on {{ticker}} at {{close}}")
