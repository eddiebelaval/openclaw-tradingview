//@version=6
indicator("Momentum Lifecycle Detector [BullByte]",
     shorttitle  = "MLD [BullByte]",
     overlay     = false,
     max_boxes_count  = 200,
     max_labels_count = 50)

// ══════════════════════════════════════════════════════════════════════════════
//
//  MOMENTUM LIFECYCLE DETECTOR (MLD)
//
//  ─────────────────────────────────────────────────────────────────────────
//  WHAT THIS INDICATOR DOES
//  ─────────────────────────────────────────────────────────────────────────
//
//  Traditional trend indicators like ADX tell you a trend exists AFTER
//  it's already obvious. By the time ADX crosses 25, you've missed
//  the best entry. This indicator solves that by detecting the BIRTH
//  of momentum — the exact moment a new trend is being born.
//
//  It does this by measuring the acceleration of the gap between
//  bullish pressure (+DI) and bearish pressure (-DI):
//
//      Spread       = |+DI − −DI|              → How far apart are bulls and bears?
//      Velocity     = Spread − Spread[1]        → Is that gap widening or narrowing?
//      Acceleration = Velocity − Velocity[1]    → Is the widening speeding up?
//
//  When acceleration is positive while ADX is still low, momentum is
//  being BORN — not yet visible on traditional indicators.
//
//  ─────────────────────────────────────────────────────────────────────────
//  THE FIVE LIFECYCLE PHASES
//  ─────────────────────────────────────────────────────────────────────────
//
//  Every trend move goes through a predictable lifecycle:
//
//      IGNITION → THRUST → PRIME → FADING → DEAD
//      (birth)    (young)   (mature) (dying)   (no trend)
//
//  • IGNITION : DI lines just crossed, spread is accelerating, ADX waking up.
//                This is the earliest possible signal — momentum is being born.
//
//  • THRUST   : Young trend gaining steam. Spread velocity is high, ADX surging.
//                The trend is real and building strength.
//
//  • PRIME    : Mature, strong trend. ADX is high, spread is wide.
//                Maximum trend strength — but also where exhaustion can begin.
//
//  • FADING   : ADX rolling over, spread velocity turning negative.
//                The trend is dying. Time to tighten stops or take profit.
//
//  • DEAD     : No meaningful directional movement.
//                Stay patient or trade range strategies.
//
//  ─────────────────────────────────────────────────────────────────────────
//  ADDITIONAL FEATURES
//  ─────────────────────────────────────────────────────────────────────────
//
//  • ATR-Normalized Momentum Oscillator : Comparable readings across all
//    instruments and timeframes. A reading of +50 means the same thing
//    on Bitcoin as it does on AAPL.
//
//  • Consolidation Zones : Yellow boxes appear when momentum and signal
//    converge — coiling energy before a breakout. Boxes change color
//    on breakout direction.
//
//  • Reversal Atmosphere : A soft glow appears around the momentum line
//    when curvature suggests a reversal is forming. Green glow = potential
//    bullish reversal, Red glow = potential bearish reversal.
//
//  • Regime Detection : Gray background warns you when the market is
//    choppy — low efficiency ratio + weak ADX + momentum inside the
//    dead zone. Signals in choppy markets are unreliable.
//
//  • Weather Dashboard : A compact panel showing Phase, Birth status,
//    Flow direction, Weather assessment, and Reversal Pressure.
//
//  ─────────────────────────────────────────────────────────────────────────
//  HOW TO USE THIS
//  ─────────────────────────────────────────────────────────────────────────
//
//  1. Wait for IGNITION phase (cyan band) — this is your early warning.
//  2. Look for THRUST confirmation (green/red band) before committing.
//  3. Ride PRIME phase with trailing stops.
//  4. Tighten or exit on FADING (orange band).
//  5. Avoid signals when background is gray (choppy market).
//  6. Watch for reversal glow near extremes for counter-trend setups.
//
// ══════════════════════════════════════════════════════════════════════════════


// ┌──────────────────────────────────────────────────────────────────────────┐
// │                        SECTION 1: USER INPUTS                           │
// │                                                                          │
// │  All configurable parameters organized by function.                     │
// │  Hover over any input's (i) icon in the settings panel for guidance.    │
// └──────────────────────────────────────────────────────────────────────────┘

// ── Core Momentum Oscillator ────────────────────────────────────────────────
// These control the main oscillator — the wavy line you see on the chart.
// The oscillator measures the gap between a fast and slow moving average,
// normalized by ATR so readings are comparable across any instrument.

g_core = "Core Momentum Oscillator"

i_fastLen = input.int(9, "Fast ZLEMA Length", minval=2, group=g_core,
     tooltip="Fast Zero-Lag EMA reacts quickly to price changes. Lower = more responsive but noisier.")

i_slowLen = input.int(21, "Slow ZLEMA Length", minval=5, group=g_core,
     tooltip="Slow Zero-Lag EMA provides the baseline. The gap between fast and slow IS the momentum reading.")

i_sigLen = input.int(5, "Signal Line Length", minval=2, group=g_core,
     tooltip="EMA smoothing on momentum creates the signal line (orange). Crossovers highlight momentum shifts.")

i_momSmooth = input.int(3, "Momentum Smoothing", minval=1, group=g_core,
     tooltip="Extra smoothing on the raw momentum. Increase to reduce noise, decrease for faster response.")

i_atrLen = input.int(14, "ATR Period", minval=5, group=g_core,
     tooltip="ATR normalizes momentum so a reading of 50 means the same thing on any chart.")

// ── Consolidation Zones ─────────────────────────────────────────────────────
// Consolidation = momentum coiling like a spring before a move.
// These yellow boxes appear when momentum and signal converge and flatten.
// A breakout from a valid zone often produces a strong directional move.

g_cz = "Consolidation Zones"

i_czShow = input.bool(true, "Show Consolidation Zones", group=g_cz,
     tooltip="Yellow boxes marking periods where momentum is coiling — potential energy building before a breakout.")

i_czHistSens = input.float(1.0, "Histogram Sensitivity", minval=0.2, maxval=3.0, step=0.1, group=g_cz,
     tooltip="How close momentum and signal must be. Lower = they must nearly touch. Higher = more zones detected.")

i_czSlopeSens = input.float(1.0, "Slope Sensitivity", minval=0.2, maxval=3.0, step=0.1, group=g_cz,
     tooltip="How flat momentum must be. Lower = must be nearly horizontal. Higher = allows slight slopes.")

i_czMinBars = input.int(5, "Minimum Bars", minval=3, maxval=30, group=g_cz,
     tooltip="A zone must last at least this many bars to be considered valid. Filters out noise.")

i_czDrift = input.float(0.4, "Drift Tolerance", minval=0.1, maxval=1.0, step=0.05, group=g_cz,
     tooltip="Maximum allowed drift relative to zone height. Too much drift means it's trending, not consolidating.")

// ── Regime Detection ────────────────────────────────────────────────────────
// The market alternates between trending and choppy regimes.
// Momentum signals are reliable in trends, unreliable in chop.
// These settings control how the indicator identifies each regime.

g_regime = "Regime Detection"

i_erLen = input.int(10, "Efficiency Ratio Period", minval=5, group=g_regime,
     tooltip="Kaufman's Efficiency Ratio: net movement ÷ total movement. High ER = trending. Low ER = choppy.")

i_erSmooth = input.int(5, "ER Smoothing", minval=1, group=g_regime,
     tooltip="Smoothing on ER to prevent rapid regime flipping.")

i_trendThr = input.float(0.4, "Trend Threshold", minval=0.1, maxval=0.9, step=0.05, group=g_regime,
     tooltip="ER above this value = market is trending. Price is moving efficiently in one direction.")

i_dzMult = input.float(0.5, "Dead Zone Multiplier", minval=0.1, maxval=2.0, step=0.1, group=g_regime,
     tooltip="Momentum readings within this many standard deviations of zero are treated as noise — no real trend.")

i_choppyER = input.float(0.30, "Choppy ER Threshold", minval=0.1, maxval=0.5, step=0.05, group=g_regime,
     tooltip="ER below this = very inefficient price movement. Combined with weak ADX, triggers choppy background.")

i_choppyADX = input.float(18.0, "Choppy ADX Threshold", minval=10.0, maxval=30.0, step=1.0, group=g_regime,
     tooltip="ADX below this = no significant trend. Combined with low ER, triggers choppy background.")

// ── Momentum Lifecycle ──────────────────────────────────────────────────────
// The heart of this indicator. These settings control how the five lifecycle
// phases (IGNITION, THRUST, PRIME, FADING, DEAD) are detected.
// The lifecycle band is the colored strip at the bottom of the indicator.

g_band = "Momentum Lifecycle"

i_bandShow = input.bool(true, "Show Lifecycle Band", group=g_band,
     tooltip="Colored band at the bottom showing which lifecycle phase momentum is currently in.")

i_qLen = input.int(14, "DI Calculation Length", minval=5, maxval=30, group=g_band,
     tooltip="Period for +DI and -DI calculation. Uses Gaussian weighting (recent bars matter more).")

i_adxLen = input.int(14, "ADX Smoothing", minval=5, maxval=30, group=g_band,
     tooltip="Zero-Lag EMA smoothing on the DX to produce ADX. Lower = faster ADX response.")

i_adxMALen = input.int(5, "ADX Signal Length", minval=2, maxval=15, group=g_band,
     tooltip="EMA of ADX. When ADX crosses below this signal, the trend may be fading.")

i_ignitionBars = input.int(4, "Ignition Window", minval=2, maxval=8, group=g_band,
     tooltip="How many bars after a DI crossover count as 'early' enough for IGNITION phase.")

i_flowInertia = input.int(2, "State Inertia", minval=1, maxval=5, group=g_band,
     tooltip="Bars a new state must persist before the lifecycle officially transitions. Prevents flickering.")

i_ignitionAccelThr = input.float(0.2, "Ignition Accel Threshold", minval=0.05, maxval=0.5, step=0.05, group=g_band,
     tooltip="Minimum spread acceleration required to confirm IGNITION. The 'spark' must be strong enough.")

i_ignitionVelThr = input.float(0.3, "Ignition Velocity Threshold", minval=0.1, maxval=0.6, step=0.05, group=g_band,
     tooltip="Minimum spread velocity required for IGNITION. The DI gap must be actively widening.")

i_thrustVelThr = input.float(0.5, "Thrust Velocity Threshold", minval=0.2, maxval=1.0, step=0.1, group=g_band,
     tooltip="Minimum spread velocity for THRUST phase. Higher bar than ignition — trend must be accelerating.")

i_adxSurgeThr = input.float(1.5, "ADX Surge Threshold", minval=0.5, maxval=3.0, step=0.25, group=g_band,
     tooltip="Minimum ADX increase over 3 bars to qualify as 'surging'. Confirms THRUST is real.")

i_adxStrongThr = input.float(20.0, "ADX Strong Threshold", minval=15.0, maxval=30.0, step=1.0, group=g_band,
     tooltip="ADX above this level = strong trend. Required for PRIME and FADING phases.")

i_diSpreadMinThr = input.float(10.0, "DI Spread Minimum", minval=5.0, maxval=20.0, step=1.0, group=g_band,
     tooltip="Minimum gap between +DI and -DI for PRIME phase. Bulls and bears must be clearly separated.")

// ── Reversal Atmosphere ─────────────────────────────────────────────────────
// A visual glow that appears around the momentum line when the math
// suggests a reversal is forming. Based on momentum curvature — when
// momentum is negative but curving upward, bullish pressure is building.

g_atmos = "Reversal Atmosphere"

i_atmosShow = input.bool(true, "Show Reversal Atmosphere", group=g_atmos,
     tooltip="Soft glow around momentum when reversal conditions form. Green = bullish reversal brewing. Red = bearish.")

i_atmosWidth = input.float(8.0, "Glow Width", minval=2.0, maxval=20.0, step=1.0, group=g_atmos,
     tooltip="Visual width of the atmospheric glow. Purely cosmetic — doesn't affect detection.")

// ── Display ─────────────────────────────────────────────────────────────────
// Visual preferences for the histogram, fill, and background.

g_disp = "Display"

i_histShow = input.bool(true, "Show Histogram", group=g_disp,
     tooltip="Vertical bars showing the gap between momentum and signal. Expanding = strengthening, contracting = weakening.")

i_fillShow = input.bool(true, "Show Momentum-Signal Fill", group=g_disp,
     tooltip="Shaded area between momentum and signal lines. Teal = momentum above signal. Maroon = below.")

i_bgShow = input.bool(true, "Show Choppy Background", group=g_disp,
     tooltip="Gray background tint when the market is choppy. A visual warning to be cautious with signals.")

// ── Dashboard ───────────────────────────────────────────────────────────────
// A compact panel summarizing the momentum weather report at a glance.

g_dash = "Dashboard"

i_dashShow = input.bool(true, "Show Dashboard", group=g_dash,
     tooltip="Panel showing Phase, Birth status, Flow direction, Weather, and Reversal Pressure.")

i_dashPos = input.string("Top Right", "Dashboard Position",
     options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Top Center", "Bottom Center"],
     group=g_dash)

i_dashSize = input.string("Small", "Dashboard Size",
     options=["Tiny", "Small", "Normal"], group=g_dash)

// ── Alerts ──────────────────────────────────────────────────────────────────
// Notifications for the two most actionable lifecycle transitions.

g_alerts = "Alerts"

i_alertIgnition = input.bool(true, "Alert on Ignition", group=g_alerts,
     tooltip="Get notified when momentum enters IGNITION — the earliest actionable signal.")

i_alertFading = input.bool(true, "Alert on Fading", group=g_alerts,
     tooltip="Get notified when momentum enters FADING — time to manage risk.")

i_alertOnClose = input.bool(true, "Confirm on Bar Close", group=g_alerts,
     tooltip="When enabled, alerts only fire after the bar closes. Prevents false signals from intra-bar noise.")


// ┌──────────────────────────────────────────────────────────────────────────┐
// │                      SECTION 2: CORE FUNCTIONS                          │
// │                                                                          │
// │  Reusable building blocks used throughout the indicator.                │
// └──────────────────────────────────────────────────────────────────────────┘

// ── Zero-Lag EMA ────────────────────────────────────────────────────────────
// A standard EMA always lags behind price because it's averaging past data.
// ZLEMA reduces this lag by compensating: it looks at how far the current
// price has moved from where it was 'lag' bars ago, and adds that difference
// before smoothing. The result tracks price more closely without extra noise.

zlema(float src, int length) =>
    int lag = math.max(0, math.floor((length - 1) / 2))
    ta.ema(src + (src - nz(src[lag])), length)

// ── Gaussian Decay Weight ───────────────────────────────────────────────────
// Returns a bell-curve weight for bar position 'n' within a window of 'len'.
// Bar 1 (most recent) gets the highest weight. Bars further back get
// exponentially less influence. This is smoother and more natural than
// the sharp cutoff of a simple moving average.

decay(int n, int len) =>
    math.exp(-math.pow(float(n) / float(len), 2))


// ┌──────────────────────────────────────────────────────────────────────────┐
// │                 SECTION 3: MOMENTUM OSCILLATOR ENGINE                   │
// │                                                                          │
// │  The main oscillator: fast ZLEMA minus slow ZLEMA, normalized by ATR.   │
// │  This gives us a number that says "how strong is the current move       │
// │  relative to normal volatility" — independent of instrument or TF.      │
// └──────────────────────────────────────────────────────────────────────────┘

// ATR for normalization — ensures a reading of +50 means the same strength
// whether you're looking at a $5 stock or Bitcoin at $60,000
float atrVal  = ta.atr(i_atrLen)
float safeATR = math.max(atrVal, syminfo.mintick * 10)  // Prevent division by zero on illiquid instruments

// Fast and slow Zero-Lag EMAs form the backbone of the oscillator
float fastLine = zlema(close, i_fastLen)
float slowLine = zlema(close, i_slowLen)

// Raw momentum = percentage gap between fast and slow, scaled by ATR
// Positive = fast above slow = bullish momentum
// Negative = fast below slow = bearish momentum
float momRaw = ((fastLine - slowLine) / safeATR) * 100.0

// Smooth the raw momentum to reduce noise, then create a signal line from it
float mom = ta.ema(momRaw, i_momSmooth)
float sig = ta.ema(mom, i_sigLen)

// First and second derivatives of momentum tell us about direction and conviction
float momSlope = mom - nz(mom[1])       // Is momentum rising or falling right now?
float sigSlope = sig - nz(sig[1])       // Is the signal line rising or falling?
float momCurve = momSlope - nz(momSlope[1])  // Is the slope itself changing? (curvature)

// Histogram = gap between momentum and its signal line
// When this expands, the trend is strengthening. When it contracts, weakening.
float hist     = mom - sig
float histPrev = nz(hist[1])
bool  histExpanding = math.abs(hist) > math.abs(histPrev)

// Multi-bar gap analysis — confirms the histogram trend isn't just a one-bar fluke
bool gapWidening  = math.abs(hist) > math.abs(histPrev) and math.abs(hist) > math.abs(nz(hist[2]))
bool gapNarrowing = math.abs(hist) < math.abs(histPrev) and math.abs(hist) < math.abs(nz(hist[2]))


// ┌──────────────────────────────────────────────────────────────────────────┐
// │                     SECTION 4: REGIME DETECTION                         │
// │                                                                          │
// │  Is the market trending or chopping? This determines whether momentum   │
// │  signals should be trusted or treated with skepticism.                  │
// └──────────────────────────────────────────────────────────────────────────┘

// Kaufman's Efficiency Ratio: net distance ÷ total distance traveled
// If price moves 10 points net but traveled 100 points total, ER = 0.10 (very choppy)
// If price moves 10 points net and traveled 12 points total, ER = 0.83 (very efficient/trending)
float priceDir = math.abs(close - nz(close[i_erLen]))
float priceVol = math.sum(math.abs(close - nz(close[1])), i_erLen)
float safeVol  = math.max(priceVol, syminfo.mintick)  // Prevent division by zero
float erRaw    = priceDir / safeVol
float er       = ta.ema(erRaw, i_erSmooth)

// Dead zone: momentum readings this close to zero are just noise, not a real trend
// Based on the standard deviation of momentum over the last 50 bars
float momStdev = ta.stdev(mom, 50)
float deadZone = math.max(nz(momStdev) * i_dzMult, 0.5)

// Market regime classification
bool isTrending = er > i_trendThr               // Price moving efficiently in one direction
bool isSideways = er < (i_trendThr * 0.5)       // Price going nowhere fast
bool momAlive   = math.abs(mom) > deadZone       // Momentum strong enough to matter


// ┌──────────────────────────────────────────────────────────────────────────┐
// │                    SECTION 5: CONSOLIDATION ZONES                       │
// │                                                                          │
// │  When momentum and signal converge and flatten, price is consolidating. │
// │  These zones represent coiled energy — breakouts from valid zones       │
// │  often produce strong directional moves.                                │
// │                                                                          │
// │  Zone lifecycle: Created → Extended → Validated (solid border) →        │
// │  Broken (colored by direction) or Invalidated (deleted).               │
// │                                                                          │
// │  Only one active zone exists at a time to keep the chart clean.         │
// └──────────────────────────────────────────────────────────────────────────┘

// Dynamic thresholds based on recent behavior — adapts to each instrument
float histStdev  = math.max(ta.stdev(hist, 50), 0.01)
float slopeStdev = math.max(ta.stdev(momSlope, 50), 0.001)

// Two conditions must be true simultaneously for consolidation:
// 1. The histogram (momentum-signal gap) must be unusually tight
// 2. Momentum's slope must be unusually flat
bool histTight   = math.abs(hist) < (histStdev * i_czHistSens)
bool slopeFlat   = math.abs(momSlope) < (slopeStdev * i_czSlopeSens * 1.5)
bool isConverged = histTight and slopeFlat

// Persistent state variables for tracking the active consolidation zone
var bool  czActive   = false     // Is a zone currently being built?
var int   czStartBar = 0         // Bar index where the zone began
var float czHi       = na        // Upper boundary of the zone
var float czLo       = na        // Lower boundary of the zone
var float czMomStart = na        // Momentum value when zone started (for drift calculation)
var box   czBox      = na        // The visual box object
var int   czCount    = 0         // How many bars the zone has lasted

if i_czShow
    if isConverged
        if not czActive
            // ── Start a new consolidation zone ──
            czActive   := true
            czStartBar := bar_index
            czHi       := math.max(mom, sig)
            czLo       := math.min(mom, sig)
            czMomStart := mom
            czCount    := 1
            czBox      := box.new(bar_index, czHi, bar_index, czLo,
                 bgcolor      = color.new(color.yellow, 90),
                 border_color = color.new(color.yellow, 70),
                 border_width = 1,
                 border_style = line.style_dotted)
        else
            // ── Extend the existing zone ──
            czCount += 1
            czHi := math.max(czHi, math.max(mom, sig))
            czLo := math.min(czLo, math.min(mom, sig))

            // Drift check: is momentum wandering away from where the zone started?
            // If so, this isn't consolidation — it's a slow trend, and the zone should be killed
            float czHeight  = math.max(czHi - czLo, 0.01)
            float czDisp    = math.abs(mom - czMomStart)
            float driftRatio = czDisp / czHeight

            if driftRatio > (i_czDrift * czCount / i_czMinBars)
                // Momentum has drifted too far — this zone is invalid
                if driftRatio > i_czDrift * 3.0 or czCount > i_czMinBars
                    czActive := false
                    if not na(czBox)
                        box.delete(czBox)
                    czCount := 0
                    czBox   := na
                else
                    // Drifting but not fatally — keep extending for now
                    if not na(czBox)
                        box.set_top(czBox, czHi)
                        box.set_bottom(czBox, czLo)
                        box.set_right(czBox, bar_index)
            else
                // Zone is healthy — extend it and upgrade visuals if mature enough
                if not na(czBox)
                    box.set_top(czBox, czHi)
                    box.set_bottom(czBox, czLo)
                    box.set_right(czBox, bar_index)

                    if czCount >= i_czMinBars
                        // Zone has lasted long enough to be considered valid
                        // Upgrade from dotted/thin to solid/thick border
                        box.set_border_style(czBox, line.style_solid)
                        box.set_border_width(czBox, 2)
                        box.set_bgcolor(czBox, color.new(color.yellow, 82))
                        box.set_border_color(czBox, color.new(color.yellow, 50))
    else
        if czActive
            // ── Convergence broken — zone ends ──
            czActive := false
            float finalHeight = math.max(czHi - czLo, 0.01)
            float finalDisp   = math.abs(mom - czMomStart)
            float finalDrift  = finalDisp / finalHeight

            if czCount >= i_czMinBars and finalDrift < i_czDrift * 2.0
                // Valid zone with a clean breakout — color it by breakout direction
                // Teal = bullish breakout, Maroon = bearish breakout
                color breakClr  = hist > 0 ? color.new(color.teal, 65) : color.new(color.maroon, 65)
                color borderClr = hist > 0 ? color.new(color.teal, 30) : color.new(color.maroon, 30)
                if not na(czBox)
                    box.set_bgcolor(czBox, breakClr)
                    box.set_border_color(czBox, borderClr)
                    box.set_border_width(czBox, 3)
                    box.set_border_style(czBox, line.style_solid)
            else
                // Zone was too short or drifted too much — delete it entirely
                if not na(czBox)
                    box.delete(czBox)

            czCount    := 0
            czBox      := na
            czMomStart := na


// ┌──────────────────────────────────────────────────────────────────────────┐
// │                   SECTION 6: REVERSAL ATMOSPHERE                        │
// │                                                                          │
// │  Detects when momentum's curvature suggests a reversal is forming.      │
// │  When momentum is negative but curving upward, bullish energy is        │
// │  building even though the trend still looks bearish. The reverse        │
// │  applies for bearish reversals.                                          │
// │                                                                          │
// │  Visualized as a soft glow around the momentum line — the stronger      │
// │  the reversal signal, the more visible the glow becomes.               │
// └──────────────────────────────────────────────────────────────────────────┘

// Dynamic curvature thresholds based on recent curvature volatility
// curveThr = minimum curvature to start glowing (the first hint)
// curveFull = curvature level for maximum glow intensity
float curveThr  = math.max(ta.stdev(momCurve, 30) * 0.3, 0.0005)
float curveFull = math.max(ta.stdev(momCurve, 30) * 0.7, 0.001)

// Bullish reversal conditions:
// Momentum is negative (below zero), BUT the slope has turned positive (it's rising),
// AND the curvature is positive (the rise is accelerating). This is the math signature
// of a bottom forming — momentum is still negative but fighting its way back.
float bullCurveStr = mom < 0 and momSlope > 0 and momCurve > curveThr ?
     math.min((momCurve - curveThr) / math.max(curveFull - curveThr, 0.0001), 1.0) : 0.0

// Bearish reversal conditions: mirror image of bullish
// Momentum is positive but curving downward = a top is forming
float bearCurveStr = mom > 0 and momSlope < 0 and momCurve < -curveThr ?
     math.min((math.abs(momCurve) - curveThr) / math.max(curveFull - curveThr, 0.0001), 1.0) : 0.0

// Smooth the raw strength readings to prevent visual flickering
float bullAtmos = ta.ema(bullCurveStr, 3)
float bearAtmos = ta.ema(bearCurveStr, 3)

// Convert strength to visual opacity: stronger signal = more visible glow
float atmosStrength = math.max(bullAtmos, bearAtmos)
int   atmosAlpha    = i_atmosShow ? math.round(95 - atmosStrength * 55) : 100

// Green glow for bullish reversal building, red glow for bearish
color atmosColor = bullAtmos > bearAtmos ?
     color.new(color.rgb(0, 200, 83), atmosAlpha) :
     bearAtmos > 0 ?
     color.new(color.rgb(255, 82, 82), atmosAlpha) :
     color.new(color.gray, 100)


// ┌──────────────────────────────────────────────────────────────────────────┐
// │                SECTION 7: MOMENTUM LIFECYCLE DETECTION                  │
// │                                                                          │
// │  This is the core innovation of MLD. It tracks momentum through five    │
// │  phases using DI spread dynamics and ADX behavior.                      │
// │                                                                          │
// │  The key insight: by measuring the ACCELERATION of the DI spread,      │
// │  we can detect momentum being born before ADX confirms a trend.        │
// │                                                                          │
// │  A state machine with inertia prevents phase flickering.               │
// └──────────────────────────────────────────────────────────────────────────┘

// ── Gaussian-Weighted Directional Indicators ────────────────────────────────
// Standard +DI/-DI give equal weight to all bars in the lookback period.
// We improve this by applying Gaussian (bell-curve) weighting — recent bars
// get much more influence than older ones. This makes DI more responsive
// to fresh directional moves without increasing false signals.

float sumPlus  = 0.0
float sumMinus = 0.0
float sumTR    = 0.0

for int k = 0 to (i_qLen - 1)
    float w      = decay(k + 1, i_qLen)         // Gaussian weight for this bar position
    float hiCurr = nz(high[k])
    float hiPrev = nz(high[k + 1])
    float loCurr = nz(low[k])
    float loPrev = nz(low[k + 1])
    float upMove   = hiCurr - hiPrev              // Bullish directional movement
    float downMove = loPrev - loCurr              // Bearish directional movement
    // Only count the larger of the two (standard DM logic), weighted by Gaussian decay
    sumPlus  += (upMove > 0 and upMove > downMove ? upMove : 0.0) * w
    sumMinus += (downMove > 0 and downMove > upMove ? downMove : 0.0) * w
    sumTR    += nz(ta.tr[k]) * w

// Calculate DI values from Gaussian-weighted sums
float plusDI  = sumTR != 0 ? 100.0 * sumPlus / sumTR : 0.0
float minusDI = sumTR != 0 ? 100.0 * sumMinus / sumTR : 0.0

// ADX: smoothed version of the Directional Index
// DX measures the difference between +DI and -DI as a percentage of their sum
// ADX smooths DX to show the overall trend strength over time
float sumDI = plusDI + minusDI
float dx    = sumDI != 0 ? math.abs(plusDI - minusDI) / sumDI * 100.0 : 0.0
float adx   = zlema(dx, i_adxLen)              // ZLEMA-smoothed ADX for faster response
float adxMA = ta.ema(adx, i_adxMALen)          // Signal line for ADX crossover detection

// ── DI Spread Dynamics (The Innovation) ─────────────────────────────────────
// Spread = how far apart +DI and -DI are (absolute gap)
// Velocity = is that gap growing or shrinking? (first derivative)
// Acceleration = is the growth speeding up or slowing down? (second derivative)
//
// Think of it like a car:
//   Spread = distance from starting point
//   Velocity = speed (are you moving?)
//   Acceleration = are you pressing the gas or brake?
//
// When acceleration is positive and velocity is positive — the trend is
// actively being born, even if ADX hasn't caught up yet.

float diSpread = math.abs(plusDI - minusDI)

float spreadVel       = diSpread - nz(diSpread[1])
float spreadVelSmooth = ta.ema(spreadVel, 3)

float spreadAccel       = spreadVel - nz(spreadVel[1])
float spreadAccelSmooth = ta.ema(spreadAccel, 3)

// ── DI Cross Tracking ───────────────────────────────────────────────────────
// Track how many bars ago the last DI crossover happened.
// A recent cross (low crossAge) combined with acceleration = IGNITION.
bool diCrossUp = ta.crossover(plusDI, minusDI)
bool diCrossDn = ta.crossunder(plusDI, minusDI)
bool diCross   = diCrossUp or diCrossDn

var int crossAge = 999  // Start high to prevent false ignition on first bars
if diCross
    crossAge := 0
else
    crossAge := math.min(crossAge + 1, 999)

// ── ADX Behavior Flags ─────────────────────────────────────────────────────
bool adxRising  = adx > nz(adx[1])
bool adxFalling = adx < nz(adx[1])
bool adxWaking  = adx > nz(adx[1]) and adx > nz(adx[2])  // Two consecutive rises = waking up
bool adxSurging = adx - nz(adx[3]) > i_adxSurgeThr        // Sharp rise over 3 bars
bool adxStrong  = adx >= i_adxStrongThr                     // Above the "strong trend" line
bool adxWeak    = adx < 15                                  // Very weak — essentially no trend

// Current directional bias: which DI is on top?
float flowDir = plusDI > minusDI ? 1.0 : -1.0

// ── Phase Detection Logic ───────────────────────────────────────────────────
// Each phase has specific conditions that must be met simultaneously.
// Phases are mutually exclusive and checked in priority order.

// IGNITION: The earliest signal. DI just crossed, spread is accelerating,
// velocity is positive, and ADX is starting to wake up.
// This fires BEFORE ADX confirms anything — that's the point.
bool isIgnition = crossAge <= i_ignitionBars and
                  spreadAccelSmooth > i_ignitionAccelThr and
                  spreadVelSmooth > i_ignitionVelThr and
                  adxWaking

// THRUST: The trend is young and gaining power. Past the ignition window
// but still fresh. Spread velocity is high and ADX is surging upward.
bool isThrust = crossAge > i_ignitionBars and crossAge <= i_ignitionBars * 3 and  spreadVelSmooth > i_thrustVelThr and  adxSurging

// PRIME: Mature, strong trend. ADX is high and either still rising or
// above its signal line. DI spread is wide — clear directional dominance.
bool isPrime = adxStrong and
               (adxRising or adx > adxMA) and
               diSpread > i_diSpreadMinThr

// FADING: The trend is dying. ADX is strong but falling below its signal,
// OR spread velocity has turned sharply negative (gap closing fast).
bool isFading = (adxStrong and adxFalling and adx < adxMA) or (adxStrong and spreadVelSmooth < -0.5)

// ── State Machine with Inertia ─────────────────────────────────────────────
// Raw phase detection can flicker between states on noisy bars.
// The state machine requires a phase to persist for 'flowInertia' bars
// before officially transitioning. Exception: IGNITION and THRUST
// transition immediately (inertia = 1) because speed matters for early signals.

var int flowState   = 0    // Current confirmed lifecycle state
var int flowHoldCnt = 0    // How many bars the pending state has persisted
var int flowPendTgt = 0    // What state is trying to become active

// Determine what state the raw signals want
int flowDesired = 0
if isIgnition
    flowDesired := 1
else if isThrust
    flowDesired := 2
else if isPrime
    flowDesired := 3
else if isFading
    flowDesired := 4
else
    flowDesired := 0

// Apply inertia gating
if flowDesired != flowState
    if flowDesired == flowPendTgt
        flowHoldCnt += 1
    else
        flowPendTgt := flowDesired
        flowHoldCnt := 1

    // Fast states (IGNITION, THRUST) get instant confirmation
    // Slower states must wait for the inertia period
    int requiredInertia = (flowDesired == 1 or flowDesired == 2) ? 1 : i_flowInertia

    if flowHoldCnt >= requiredInertia
        flowState   := flowDesired
        flowHoldCnt := 0
else
    flowHoldCnt := 0
    flowPendTgt := flowState

// ── Transition Detection for Alerts ─────────────────────────────────────────
// We only want to alert on the FIRST bar of a new phase, not every bar within it
bool ignitionOnset = flowState == 1 and nz(flowState[1], 0) != 1
bool fadingOnset   = flowState == 4 and nz(flowState[1], 0) != 4

// Optionally require bar close confirmation to avoid repainting alerts
bool ignitionConfirmed = i_alertOnClose ? (ignitionOnset and barstate.isconfirmed) : ignitionOnset
bool fadingConfirmed   = i_alertOnClose ? (fadingOnset and barstate.isconfirmed) : fadingOnset


// ┌──────────────────────────────────────────────────────────────────────────┐
// │                      SECTION 8: VISUAL SYSTEM                           │
// │                                                                          │
// │  Color logic for all visual elements. Separated from plotting for       │
// │  clarity. Colors encode multiple dimensions of information:             │
// │  direction, strength, regime, and lifecycle phase.                      │
// └──────────────────────────────────────────────────────────────────────────┘

// ── Choppy Market Detection ────────────────────────────────────────────────
// Three conditions must ALL be true for choppy classification:
// Low efficiency ratio + Weak ADX + Momentum inside the dead zone
bool isChoppy = er < i_choppyER and adx < i_choppyADX and not momAlive

// Gray background tint during choppy markets — a visual "stay cautious" warning
color bgColor = na
if i_bgShow and isChoppy
    bgColor := color.new(color.gray, 88)
bgcolor(bgColor)

// ── Momentum Line Color ────────────────────────────────────────────────────
// Gray = momentum is inside the dead zone (noise, not signal)
// Bright green = bullish and strengthening (positive slope)
// Faded green = bullish but weakening (negative slope)
// Bright red = bearish and strengthening (negative slope)
// Faded red = bearish but weakening (positive slope)
color momColor = na
if not momAlive
    momColor := color.rgb(120, 120, 120)
else if mom > 0
    momColor := momSlope >= 0 ? color.rgb(0, 200, 83) : color.rgb(0, 200, 83, 50)
else
    momColor := momSlope <= 0 ? color.rgb(255, 82, 82) : color.rgb(255, 82, 82, 50)

// ── Histogram Color ─────────────────────────────────────────────────────────
// Bright = histogram expanding (momentum strengthening vs signal)
// Faded = histogram contracting (momentum weakening vs signal)
color histColor = na
if i_histShow
    if hist >= 0
        histColor := histExpanding ? color.new(color.rgb(0, 200, 83), 30) :
                                     color.new(color.rgb(0, 200, 83), 70)
    else
        histColor := histExpanding ? color.new(color.rgb(255, 82, 82), 30) :
                                     color.new(color.rgb(255, 82, 82), 70)

// ── Lifecycle Band Color ────────────────────────────────────────────────────
// Each phase gets a distinct color for instant visual recognition:
// DEAD = dark gray, IGNITION = cyan, THRUST = green/red by direction,
// PRIME = deeper green/red, FADING = orange (warning)
color bandColor = switch flowState
    0 => color.rgb(70, 70, 70)                                        // DEAD
    1 => color.rgb(0, 210, 210)                                       // IGNITION (cyan — attention!)
    2 => flowDir > 0 ? color.rgb(0, 220, 120) : color.rgb(220, 90, 90)  // THRUST (direction-coded)
    3 => flowDir > 0 ? color.rgb(0, 180, 80) : color.rgb(200, 70, 70)   // PRIME (deeper direction)
    4 => color.rgb(200, 130, 50)                                      // FADING (orange — caution)
    => color.gray

// Phase label text for the band and dashboard
string bandText = switch flowState
    0 => "DEAD"
    1 => "IGNITION"
    2 => "THRUST"
    3 => "PRIME"
    4 => "FADING"
    => ""


// ┌──────────────────────────────────────────────────────────────────────────┐
// │                     SECTION 9: PLOT RENDERING                           │
// │                                                                          │
// │  All visual output — plots, fills, labels, and the lifecycle band.     │
// │  Elements are layered from back to front for proper visual stacking.   │
// └──────────────────────────────────────────────────────────────────────────┘

// ── Lifecycle Band (bottom strip) ───────────────────────────────────────────
// A thin colored bar at the bottom of the indicator showing the current phase.
// Positioned at y = -93 to -100 so it stays below the oscillator.

float bandY1  = -70.0
float bandY2  = -100.0
float bandMid = (bandY1 + bandY2) / 2.0

p_bTop = plot(i_bandShow ? bandY1 : na, "Band Top",
     color=color.new(color.gray, 100), display=display.pane, editable=false)
p_bBot = plot(i_bandShow ? bandY2 : na, "Band Bottom",
     color=color.new(color.gray, 100), display=display.pane, editable=false)
fill(p_bTop, p_bBot, color=i_bandShow ? bandColor : na, title="Lifecycle Band")

// Thin separator line above the band for visual clarity
plot(i_bandShow ? bandY1 + 2.0 : na, "Band Separator",
     color=color.new(color.gray, 80), style=plot.style_line, linewidth=1,
     display=display.pane, editable=false)

// Phase label at the right edge of the band
var label bandLbl = na
if i_bandShow and barstate.islast
    if not na(bandLbl)
        label.delete(bandLbl)
    bandLbl := label.new(bar_index + 3, bandMid, bandText,
         style     = label.style_label_left,
         color     = color.new(bandColor, 20),
         textcolor = flowState == 1 ? color.black : color.white,
         size      = size.small)

// ── Dead Zone ──────────────────────────────────────────────────────────────
// Shaded area around zero where momentum is considered noise.
// When the momentum line is inside this zone, the trend has no conviction.
p_dzUp = plot(deadZone, color=color.new(color.gray, 88), linewidth=1, title="Dead Zone Upper")
p_dzDn = plot(-deadZone, color=color.new(color.gray, 88), linewidth=1, title="Dead Zone Lower")
fill(p_dzUp, p_dzDn, color=color.new(color.gray, 94), title="Dead Zone Fill")

// ── Reversal Atmosphere Glow ────────────────────────────────────────────────
// Soft colored region around the momentum line that appears when reversal
// curvature is detected. The plots are invisible — only the fill between them shows.
float glowOffset = i_atmosShow ? i_atmosWidth : 0.0
p_atmosUp = plot(i_atmosShow ? mom + glowOffset : na, "Atmos Upper",
     color=color.new(color.gray, 100), display=display.pane, editable=false)
p_atmosDn = plot(i_atmosShow ? mom - glowOffset : na, "Atmos Lower",
     color=color.new(color.gray, 100), display=display.pane, editable=false)
fill(p_atmosUp, p_atmosDn, color=atmosColor, title="Reversal Atmosphere")

// ── Histogram ──────────────────────────────────────────────────────────────
// Vertical bars showing the momentum-signal gap. The visual heartbeat of the indicator.
plot(i_histShow ? hist : na, style=plot.style_columns, color=histColor,
     linewidth=2, title="Histogram")

// ── Zero Line ──────────────────────────────────────────────────────────────
hline(0, "Zero Line", color=color.new(color.gray, 60), linestyle=hline.style_dotted)

// ── Momentum and Signal Lines ──────────────────────────────────────────────
p_mom = plot(mom, color=momColor, linewidth=2, title="Momentum")
p_sig = plot(sig, color=color.new(color.orange, 30), linewidth=1, title="Signal")

// ── Momentum-Signal Fill ────────────────────────────────────────────────────
// Teal fill when momentum is above signal (bullish bias)
// Maroon fill when momentum is below signal (bearish bias)
color fillClr = na
if i_fillShow
    fillClr := mom > sig ? color.new(color.teal, 82) : color.new(color.maroon, 82)
fill(p_mom, p_sig, color=fillClr, title="Momentum Signal Fill")


// ┌──────────────────────────────────────────────────────────────────────────┐
// │                       SECTION 10: DASHBOARD                             │
// │                                                                          │
// │  A compact "weather report" panel showing five key readings:            │
// │  Phase, Birth, Flow, Weather, and Pressure. Everything a trader needs   │
// │  to assess the current momentum environment at a glance.               │
// └──────────────────────────────────────────────────────────────────────────┘

// ── Helper: Convert user-friendly position string to Pine position ──────────
f_getTablePosition(string userPos) =>
    switch userPos
        "Top Left"      => position.top_left
        "Top Right"     => position.top_right
        "Bottom Left"   => position.bottom_left
        "Bottom Right"  => position.bottom_right
        "Top Center"    => position.top_center
        "Bottom Center" => position.bottom_center
        => position.top_right

// ── Helper: Convert user-friendly size string to Pine size ──────────────────
f_getTextSize(string userSize) =>
    switch userSize
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        => size.small

// ── Weather Assessment ──────────────────────────────────────────────────────
// FAVORABLE: Active momentum phase with life = conditions support trading
// CAUTION: Fading or weakening momentum = manage risk
// UNFAVORABLE: Dead momentum = wait for better conditions
f_getWeather(int state, bool alive, float spreadV) =>
    string txt = "---"
    color  clr = color.gray
    if (state == 1 or state == 2 or state == 3) and alive
        txt := "FAVORABLE"
        clr := color.rgb(0, 230, 118)
    else if state == 4 or (state == 3 and spreadV < 0)
        txt := "CAUTION"
        clr := color.rgb(255, 152, 0)
    else
        txt := "UNFAVORABLE"
        clr := color.rgb(255, 82, 82)
    [txt, clr]

// ── Reversal Pressure Reading ───────────────────────────────────────────────
// Shows whether bullish or bearish reversal pressure is building
f_getPressure(float bullAtm, float bearAtm) =>
    string txt = "NONE"
    color  clr = color.gray
    if bullAtm > 0.7
        txt := "BULLISH REV"
        clr := color.rgb(0, 230, 118)
    else if bearAtm > 0.7
        txt := "BEARISH REV"
        clr := color.rgb(255, 82, 82)
    else if bullAtm > 0.3 or bearAtm > 0.3
        txt := "BUILDING"
        clr := color.rgb(0, 188, 212)
    [txt, clr]

// ── Momentum Birth Status ──────────────────────────────────────────────────
// Shows whether new momentum is being created, building, or dying
f_getBirth(float accel) =>
    string txt = "QUIET"
    color  clr = color.gray
    if accel > 0.5
        txt := "ACCELERATING"
        clr := color.rgb(0, 255, 255)
    else if accel > 0.2
        txt := "BUILDING"
        clr := color.rgb(0, 230, 118)
    else if accel < -0.2
        txt := "DECELERATING"
        clr := color.rgb(255, 82, 82)
    [txt, clr]

// ── Directional Flow ────────────────────────────────────────────────────────
// Shows current direction (BULL/BEAR) with DI spread magnitude, or FLAT if dead
f_getFlow(float dir, float spread, bool alive) =>
    string txt = "FLAT"
    color  clr = color.gray
    if alive
        txt := (dir > 0 ? "BULL " : "BEAR ") + str.tostring(spread, "#.0")
        clr := dir > 0 ? color.rgb(0, 200, 83) : color.rgb(255, 82, 82)
    [txt, clr]

// ── Dashboard Rendering ────────────────────────────────────────────────────
var table dashTable = na

if i_dashShow
    // Create the table once, then update cells every bar
    if na(dashTable)
        dashTable := table.new(f_getTablePosition(i_dashPos), 2, 5,
             bgcolor      = color.new(color.black, 30),
             border_width = 1,
             border_color = color.new(color.gray, 60),
             frame_width  = 2,
             frame_color  = color.new(color.gray, 40))

    txtSize = f_getTextSize(i_dashSize)

    // Calculate all dashboard values
    [weatherText, weatherClr]   = f_getWeather(flowState, momAlive, spreadVelSmooth)
    [pressureText, pressureClr] = f_getPressure(bullAtmos, bearAtmos)
    [birthText, birthClr]       = f_getBirth(spreadAccelSmooth)
    [flowText, flowClr]         = f_getFlow(flowDir, diSpread, momAlive)

    // Row 0: Current lifecycle phase
    table.cell(dashTable, 0, 0, "PHASE",
         text_color=color.rgb(180, 180, 180), text_size=txtSize, text_halign=text.align_left)
    table.cell(dashTable, 1, 0, bandText,
         text_color=bandColor, text_size=txtSize, text_halign=text.align_right)

    // Row 1: Momentum birth status (accelerating, building, quiet, decelerating)
    table.cell(dashTable, 0, 1, "BIRTH",
         text_color=color.rgb(180, 180, 180), text_size=txtSize, text_halign=text.align_left)
    table.cell(dashTable, 1, 1, birthText,
         text_color=birthClr, text_size=txtSize, text_halign=text.align_right)

    // Row 2: Directional flow with DI spread magnitude
    table.cell(dashTable, 0, 2, "FLOW",
         text_color=color.rgb(180, 180, 180), text_size=txtSize, text_halign=text.align_left)
    table.cell(dashTable, 1, 2, flowText,
         text_color=flowClr, text_size=txtSize, text_halign=text.align_right)

    // Row 3: Overall momentum weather assessment
    table.cell(dashTable, 0, 3, "WEATHER",
         text_color=color.rgb(180, 180, 180), text_size=txtSize, text_halign=text.align_left)
    table.cell(dashTable, 1, 3, weatherText,
         text_color=weatherClr, text_size=txtSize, text_halign=text.align_right)

    // Row 4: Reversal pressure from curvature analysis
    table.cell(dashTable, 0, 4, "PRESSURE",
         text_color=color.rgb(180, 180, 180), text_size=txtSize, text_halign=text.align_left)
    table.cell(dashTable, 1, 4, pressureText,
         text_color=pressureClr, text_size=txtSize, text_halign=text.align_right)


// ┌──────────────────────────────────────────────────────────────────────────┐
// │                         SECTION 11: ALERTS                              │
// │                                                                          │
// │  Two alert types for the most actionable lifecycle transitions:         │
// │  IGNITION (early entry opportunity) and FADING (risk management).       │
// │                                                                          │
// │  alertcondition() creates templates visible in TradingView's alert UI. │
// │  alert() fires runtime alerts with detailed context information.        │
// └──────────────────────────────────────────────────────────────────────────┘

// Alert templates — these appear in the TradingView alert creation dialog
// when you select this indicator as the alert source
alertcondition(ignitionConfirmed, title="MLD: Ignition Onset",
     message="{{ticker}} {{interval}} — IGNITION detected. Early momentum birth signal.")

alertcondition(fadingConfirmed, title="MLD: Fading Onset",
     message="{{ticker}} {{interval}} — Momentum FADING. Consider reducing exposure.")

// Runtime alerts with enriched context
// These fire automatically when conditions are met and alerts are enabled
if i_alertIgnition and ignitionConfirmed
    string ignDir = flowDir > 0 ? "Bullish" : "Bearish"
    alert(ignDir + " IGNITION on " + syminfo.ticker + " " + timeframe.period +
         ". ADX: " + str.tostring(adx, "#.0") +
         ", Cross age: " + str.tostring(crossAge) + " bars.",
         alert.freq_once_per_bar_close)

if i_alertFading and fadingConfirmed
    alert("FADING on " + syminfo.ticker + " " + timeframe.period +
         ". ADX: " + str.tostring(adx, "#.0") +
         ", Spread velocity: " + str.tostring(spreadVelSmooth, "#.00"),
         alert.freq_once_per_bar_close)

// ══════════════════════════════════════════════════════════════════════════════
//  END OF INDICATOR
// ══════════════════════════════════════════════════════════════════════════════
