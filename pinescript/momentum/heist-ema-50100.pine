//@version=6
indicator(title="EMA 50/100 - Locked Labels", shorttitle="EMA 50/100", overlay=true)

// --- 50 EMA ---
len50 = 50
src50 = close
out50 = ta.ema(src50, len50)
plot(out50, title="EMA 50", color=color.red, linewidth=2)

// --- 100 EMA ---
len100 = 100
src100 = close
out100 = ta.ema(src100, len100)
plot(out100, title="EMA 100", color=color.aqua, linewidth=2)

// --- DYNAMIC LABELS (STOPS THE SHIFTING) ---
// Using 'var' ensures they only create once. 
// Using 'last_bar_index' ensures they stay pinned to the right regardless of panning.
var label lbl50  = label.new(na, na, "", xloc=xloc.bar_index, style=label.style_label_left, color=color.red,  textcolor=color.white, size=size.small)
var label lbl100 = label.new(na, na, "", xloc=xloc.bar_index, style=label.style_label_left, color=color.aqua, textcolor=color.black, size=size.small)

if barstate.islast
    // This pushes the label into the right-hand margin/padding area
    int labelX = last_bar_index + 2
    
    label.set_xy(lbl50,  labelX, out50)
    label.set_text(lbl50, "EMA 50: " + str.tostring(out50, format.mintick))

    label.set_xy(lbl100, labelX, out100)
    label.set_text(lbl100, "EMA 100: " + str.tostring(out100, format.mintick))
