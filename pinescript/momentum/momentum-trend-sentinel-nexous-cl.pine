//@version=5
// © NEXOUS_cl - Professional Trend Sentinel
// This indicator provides non-repainting entry signals based on momentum and volatility.
indicator("Momentum Trend Sentinel NEXOUS_cl", overlay=true, max_boxes_count=500)

// --- Copyright & Technical Details ---
// Author: NEXOUS_cl
// Strategy: High-Precision Trend Breakout using adaptive ATR bands.

// --- Parameters ---
atrPeriod = input.int(14, "ATR Period", minval=1)
mult      = input.float(2.0, "ATR Multiplier", step=0.1)
src       = input(close, "Source")

// --- Technical Analysis Logic ---
atr = ta.atr(atrPeriod)
upperBand = src + (atr * mult)
lowerBand = src - (atr * mult)

var float trendStop = 0.0
var int   trendDir  = 0

// Momentum Engine Calculation
if ta.crossover(close, trendStop) or trendDir == 0
    trendDir  := 1
    trendStop := lowerBand
else if ta.crossunder(close, trendStop)
    trendDir  := -1
    trendStop := upperBand
else
    if trendDir == 1
        trendStop := math.max(lowerBand, trendStop)
    else
        trendStop := math.min(upperBand, trendStop)

// --- Signal Generation (Zero Repaint) ---
longSignal  = trendDir == 1 and trendDir[1] == -1
shortSignal = trendDir == -1 and trendDir[1] == 1

// --- Visuals (Labels & Boxes) ---
plotshape(longSignal,  title="BUY Signal",  style=shape.labelup,   location=location.belowbar, color=color.new(color.green, 0), text="BUY",  textcolor=color.white, size=size.small)
plotshape(shortSignal, title="SELL Signal", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0),   text="SELL", textcolor=color.white, size=size.small)

// Dynamic Profit/Loss Boxes
if longSignal
    box.new(left=bar_index, top=high + (atr * 1.5), bottom=trendStop, right=bar_index + 5, bgcolor=color.new(color.green, 85), border_color=color.new(color.green, 50))
if shortSignal
    box.new(left=bar_index, top=trendStop, bottom=low - (atr * 1.5), right=bar_index + 5, bgcolor=color.new(color.red, 85), border_color=color.new(color.red, 50))

// Trend Line
plot(trendStop, "Trailing Stop", color=trendDir == 1 ? color.green : color.red, linewidth=2, style=plot.style_linebr)

// --- Alerts ---
alertcondition(longSignal,  title="NEXOUS_cl Long Entry",  message="Momentum Trend Sentinel: Long Position Signal")
alertcondition(shortSignal, title="NEXOUS_cl Short Entry", message="Momentum Trend Sentinel: Short Position Signal")
