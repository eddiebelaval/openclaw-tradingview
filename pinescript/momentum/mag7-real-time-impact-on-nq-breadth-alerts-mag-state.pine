//@version=6
indicator("MAG7 — Real-Time Impact on NQ (pts) | PRE/RTH/POS + BREADTH + ALERT + MAG STATE", overlay=true)

// Inputs
posOpt = input.string("Bottom Left", "Position", options=["Top Right","Top Left","Bottom Right","Bottom Left"])

colorHeader = input.color(color.rgb(40,40,40), "Header Color")
colorBg     = input.color(color.rgb(10,10,10), "Background Color")
colorText   = input.color(color.white, "Text Color")
colorNum    = input.color(color.yellow,"Number Color")
colorUp     = input.color(color.lime,  "Up Color")
colorDown   = input.color(color.red,   "Down Color")
colorFlat   = input.color(color.gray,  "Flat Color")

// ==============================
// FONT SIZE
// ==============================
fontSize = input.string("Normal", "Font Size", options=["Small", "Normal", "Large", "Extra Large"])

// Levels / Alerts
divLevel    = input.float(120.0, "Divergence Level (pts)", step=1)
persistBars = input.int(3, "Persistence (bars) for alert", minval=1)

// Share / Regime
shareStrong = input.float(0.70, "MAG7 Strong Share (0-1)", step=0.05)
shareWeak   = input.float(0.40, "MAG7 Weak Share (0-1)", step=0.05)

// MAG State (vs previous session)
magTrendLevel = input.float(0.30, "MAG Filter (% daily)", step=0.05)

// Weights
wAAPL  = input.float(0.095, "AAPL Weight",  step=0.001)
wMSFT  = input.float(0.095, "MSFT Weight",  step=0.001)
wNVDA  = input.float(0.085, "NVDA Weight",  step=0.001)
wAMZN  = input.float(0.065, "AMZN Weight",  step=0.001)
wMETA  = input.float(0.055, "META Weight",  step=0.001)
wGOOGL = input.float(0.045, "GOOGL Weight", step=0.001)
wTSLA  = input.float(0.035, "TSLA Weight",  step=0.001)

// ==============================
// 1M FLOW ANALYSIS
// ==============================
divCandles     = input.int(6, "Candles for analysis (3-7)", minval=3, maxval=7)
divAmplitude   = input.float(0.40, "Minimum Amplitude (%)", step=0.05)
enableDivAlerts = input.bool(true, "Enable divergence alerts?")

// NY Sessions
sessPre  = input.session("0400-0930", "Pre (NY)")
sessRTH  = input.session("0930-1600", "RTH (NY)")
sessPost = input.session("1600-2000", "Post (NY)")
tzNY     = "America/New_York"

// Table
posEnum =
     posOpt == "Top Left" ? position.top_left :
     posOpt == "Bottom Left" ? position.bottom_left :
     posOpt == "Bottom Right" ? position.bottom_right :
     position.top_right

var table t = table.new(posEnum, 1, 13, bgcolor=color.new(colorBg, 0), border_width=1)

// Helpers
f_fmtPct(x) => na(x) ? "NA" : str.tostring(x, "#.###") + "%"
f_fmtPts(x) => na(x) ? "NA" : str.tostring(x, "#.##") + " pts"
f_col(x) => na(x) ? colorFlat : (x > 0 ? colorUp : x < 0 ? colorDown : colorFlat)

// NY Phase
inPre_chart  = not na(time("1", sessPre,  tzNY))
inRTH_chart  = not na(time("1", sessRTH,  tzNY))
inPost_chart = not na(time("1", sessPost, tzNY))
phaseTxt = inPre_chart ? "PRE" : inRTH_chart ? "RTH" : inPost_chart ? "POS" : "OFF"

// Price fetch
f_tick(sym) => request.security(sym, "1", close, barmerge.gaps_off, barmerge.lookahead_off)
f_prev_close(sym) => request.security(sym, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)

// 1m MAG7 ticks
aapl_tick  = f_tick("AAPL")
msft_tick  = f_tick("MSFT")
nvda_tick  = f_tick("NVDA")
amzn_tick  = f_tick("AMZN")
meta_tick  = f_tick("META")
googl_tick = f_tick("GOOGL")
tsla_tick  = f_tick("TSLA")

// Previous 1m close
aapl_prev1  = request.security("AAPL", "1", close[1], barmerge.gaps_off, barmerge.lookahead_off)
msft_prev1  = request.security("MSFT", "1", close[1], barmerge.gaps_off, barmerge.lookahead_off)
nvda_prev1  = request.security("NVDA", "1", close[1], barmerge.gaps_off, barmerge.lookahead_off)
amzn_prev1  = request.security("AMZN", "1", close[1], barmerge.gaps_off, barmerge.lookahead_off)
meta_prev1  = request.security("META", "1", close[1], barmerge.gaps_off, barmerge.lookahead_off)
googl_prev1 = request.security("GOOGL", "1", close[1], barmerge.gaps_off, barmerge.lookahead_off)
tsla_prev1  = request.security("TSLA", "1", close[1], barmerge.gaps_off, barmerge.lookahead_off)

// 1m MAG7 %
pct_aapl_1m  = aapl_prev1  != 0 ? (aapl_tick  - aapl_prev1)  / aapl_prev1  * 100 : 0
pct_msft_1m  = msft_prev1  != 0 ? (msft_tick  - msft_prev1)  / msft_prev1  * 100 : 0
pct_nvda_1m  = nvda_prev1  != 0 ? (nvda_tick  - nvda_prev1)  / nvda_prev1  * 100 : 0
pct_amzn_1m  = amzn_prev1  != 0 ? (amzn_tick  - amzn_prev1)  / amzn_prev1  * 100 : 0
pct_meta_1m  = meta_prev1  != 0 ? (meta_tick  - meta_prev1)  / meta_prev1  * 100 : 0
pct_googl_1m = googl_prev1 != 0 ? (googl_tick - googl_prev1) / googl_prev1 * 100 : 0
pct_tsla_1m  = tsla_prev1  != 0 ? (tsla_tick  - tsla_prev1)  / tsla_prev1  * 100 : 0

impactPct_1m = (
    pct_aapl_1m  * wAAPL +
    pct_msft_1m  * wMSFT +
    pct_nvda_1m  * wNVDA +
    pct_amzn_1m  * wAMZN +
    pct_meta_1m  * wMETA +
    pct_googl_1m * wGOOGL +
    pct_tsla_1m  * wTSLA
)

// Index
idxPx   = close
idxPrev = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)

idxRetNow = idxPrev != 0 ? (idxPx - idxPrev) / idxPrev * 100 : na
idxPtsNow = idxPx - idxPrev

// MAG7 vs previous session
aapl_prev  = f_prev_close("AAPL")
msft_prev  = f_prev_close("MSFT")
nvda_prev  = f_prev_close("NVDA")
amzn_prev  = f_prev_close("AMZN")
meta_prev  = f_prev_close("META")
googl_prev = f_prev_close("GOOGL")
tsla_prev  = f_prev_close("TSLA")

pct_aapl_now  = aapl_prev  != 0 ? (aapl_tick  - aapl_prev)  / aapl_prev  * 100 : na
pct_msft_now  = msft_prev  != 0 ? (msft_tick  - msft_prev)  / msft_prev  * 100 : na
pct_nvda_now  = nvda_prev  != 0 ? (nvda_tick  - nvda_prev)  / nvda_prev  * 100 : na
pct_amzn_now  = amzn_prev  != 0 ? (amzn_tick  - amzn_prev)  / amzn_prev  * 100 : na
pct_meta_now  = meta_prev  != 0 ? (meta_tick  - meta_prev)  / meta_prev  * 100 : na
pct_googl_now = googl_prev != 0 ? (googl_tick - googl_prev) / googl_prev * 100 : na
pct_tsla_now  = tsla_prev  != 0 ? (tsla_tick  - tsla_prev)  / tsla_prev  * 100 : na

impactPct_now = (
    nz(pct_aapl_now)  * wAAPL +
    nz(pct_msft_now)  * wMSFT +
    nz(pct_nvda_now)  * wNVDA +
    nz(pct_amzn_now)  * wAMZN +
    nz(pct_meta_now)  * wMETA +
    nz(pct_googl_now) * wGOOGL +
    nz(pct_tsla_now)  * wTSLA
)

// ==============================
// MAG STATE (VS PREVIOUS SESSION)
// ==============================
magState =
     impactPct_now >  magTrendLevel ? "MAG7 UP VS PREVIOUS SESSION" :
     impactPct_now < -magTrendLevel ? "MAG7 DOWN VS PREVIOUS SESSION"  :
     "MAG7 FLAT VS PREVIOUS SESSION"

impactPts_now = (impactPct_now/100.0) * idxPrev
breadthPts_now = idxPtsNow - impactPts_now

den = math.max(math.abs(idxPtsNow), 1.0)
magShare = math.abs(impactPts_now) / den

regimeTxt =
     (magShare >= shareStrong and math.sign(impactPts_now) == math.sign(idxPtsNow)) ? "INDEX LED BY MAG7" :
     (magShare <= shareWeak) ? "INDEX LED BY REST OF MARKET" :
     "UNDEFINED - BE PATIENT"

// 1M Flow
impactPts_1m = (impactPct_1m / 100.0) * idxPx
idxPrev1m = request.security(syminfo.tickerid, "1", close[1], barmerge.gaps_off, barmerge.lookahead_off)
idxPts_1m = na(idxPrev1m) ? na : (idxPx - idxPrev1m)
breadthPts_1m = idxPts_1m - impactPts_1m

divPtsNow = breadthPts_now

divStrongPos = divPtsNow >  divLevel
divStrongNeg = divPtsNow < -divLevel

posCount = ta.sma(divStrongPos ? 1.0 : 0.0, persistBars)
negCount = ta.sma(divStrongNeg ? 1.0 : 0.0, persistBars)

divPosPersist = posCount > 0.999
divNegPersist = negCount > 0.999

misalign = (idxPtsNow > 0 and impactPts_now < 0) or (idxPtsNow < 0 and impactPts_now > 0)

alert_struct_pos = divPosPersist or (misalign and idxPtsNow > 0)
alert_struct_neg = divNegPersist or (misalign and idxPtsNow < 0)

alertcondition(alert_struct_pos, title="STRUCTURAL ALERT (MAG7 DOMINANCE)", message="ALERT: MAG7 dominance (index >> MAG7) or misalignment. Check for rotation.")
alertcondition(alert_struct_neg, title="STRUCTURAL ALERT (HIDDEN PRESSURE)", message="ALERT: Hidden pressure (MAG7 >> index) or misalignment. Watch for reversal.")

// ==============================
// 1M FLOW ANALYSIS
// ==============================

float bearishAmplitude = 0.0
float bullishAmplitude = 0.0
int bearishCount = 0
int bullishCount = 0
int lateralCount = 0

for i = 0 to divCandles - 1
    if close[i] < open[i]
        bearishAmplitude := bearishAmplitude + (open[i] - close[i]) / open[i] * 100
        bearishCount := bearishCount + 1
    else if close[i] > open[i]
        bullishAmplitude := bullishAmplitude + (close[i] - open[i]) / open[i] * 100
        bullishCount := bullishCount + 1
    else
        lateralCount := lateralCount + 1

float netAmplitude = bullishAmplitude - bearishAmplitude

string flowText = ""
color flowColor = color.gray

if magState == "MAG7 UP VS PREVIOUS SESSION" and netAmplitude <= -divAmplitude
    flowText := "🔴 DIVERGENCE DETECTED - POSSIBLE ABSORPTION - SELLERS TESTING"
    flowColor := color.red
else if magState == "MAG7 DOWN VS PREVIOUS SESSION" and netAmplitude >= divAmplitude
    flowText := "🟢 DIVERGENCE DETECTED - POSSIBLE ACCUMULATION - BUYERS TESTING"
    flowColor := color.lime
else if magState == "MAG7 FLAT VS PREVIOUS SESSION" and math.abs(netAmplitude) >= divAmplitude
    flowText := "🔵 TEST WITHOUT CONFIRMATION"
    flowColor := color.blue
else if magState == "MAG7 UP VS PREVIOUS SESSION" and netAmplitude < 0
    flowText := "🟠 DIVERGENCE DETECTED - SELLERS ACTING - ATTENTION"
    flowColor := color.orange
else if magState == "MAG7 DOWN VS PREVIOUS SESSION" and netAmplitude > 0
    flowText := "🟡 DIVERGENCE DETECTED - BUYERS ACTING - ATTENTION"
    flowColor := color.yellow
else if bearishCount == 0 and bullishCount == 0
    flowText := "⚪ SIDEWAYS MARKET"
    flowColor := color.gray
else if (magState == "MAG7 UP VS PREVIOUS SESSION" and netAmplitude > 0) or (magState == "MAG7 DOWN VS PREVIOUS SESSION" and netAmplitude < 0)
    flowText := "✅ TREND ALIGNED CURRENTLY"
    flowColor := color.green
else
    flowText := "⏳ SIDEWAYS RANGE - WAIT"
    flowColor := color.gray

// Alerts
alert_absorcao = magState == "MAG7 UP VS PREVIOUS SESSION" and netAmplitude <= -divAmplitude
alertcondition(enableDivAlerts and alert_absorcao, 
     title="🔴 ABSORPTION IN PROGRESS", 
     message="SELLING PRESSURE IS GROWING DESPITE BULLISH MAG STATE")

alert_acumulacao = magState == "MAG7 DOWN VS PREVIOUS SESSION" and netAmplitude >= divAmplitude
alertcondition(enableDivAlerts and alert_acumulacao, 
     title="🟢 ACCUMULATION IN PROGRESS", 
     message="BUYING PRESSURE IS GROWING DESPITE BEARISH MAG STATE")

// Plot
divMA = ta.sma(divPtsNow, 20)
plot(divPtsNow, title="Divergence/Breadth (pts)", color=color.orange, linewidth=2)
plot(divMA, title="Divergence MA", color=color.aqua, linewidth=2)
hline(0, color=color.gray)
hline(divLevel, color=color.red)
hline(-divLevel, color=color.green)

// Render table
if barstate.islast
    // Determine font size
    font_size = fontSize == "Small" ? size.tiny : fontSize == "Normal" ? size.small : fontSize == "Large" ? size.normal : size.large
    
    table.cell(t, 0, 0, "MAG7 — Real-Time Impact", bgcolor=colorHeader, text_color=colorText, text_size=font_size)
    table.cell(t, 0, 1, "PHASE: " + phaseTxt + " | REGIME: " + regimeTxt, bgcolor=colorBg, text_color=colorNum, text_size=font_size)
    
    // LINE 2: MAG7 impact now (1M)
    table.cell(t, 0, 2, "MAG7 IMPACT NOW (1M): " + f_fmtPts(impactPts_1m) + " | " + f_fmtPct(impactPct_1m), bgcolor=colorBg, text_color=f_col(impactPts_1m), text_size=font_size)
    
    // LINE 3: Rest of market impact now (1M)
    table.cell(t, 0, 3, "REST OF MARKET IMPACT NOW (1M): " + f_fmtPts(breadthPts_1m) + " | " + f_fmtPct(breadthPts_1m/idxPx*100), bgcolor=colorBg, text_color=f_col(breadthPts_1m), text_size=font_size)
    
    // LINE 4: Total variation now (1M)
    table.cell(t, 0, 4, "TOTAL AMPLITUDE NOW (1M): " + f_fmtPts(idxPts_1m) + " | " + f_fmtPct(idxPts_1m/idxPx*100), bgcolor=colorBg, text_color=f_col(idxPts_1m), text_size=font_size)
    
    // LINE 5: MAG7 impact today
    table.cell(t, 0, 5, "MAG7 IMPACT TODAY: " + f_fmtPts(impactPts_now) + " | " + f_fmtPct(impactPct_now), bgcolor=colorBg, text_color=f_col(impactPts_now), text_size=font_size)
    
    // LINE 6: Total amplitude today
    table.cell(t, 0, 6, "TOTAL INDEX TODAY: " + f_fmtPts(idxPtsNow) + " | " + f_fmtPct(idxRetNow), bgcolor=colorBg, text_color=f_col(idxPtsNow), text_size=font_size)
    
    // LINE 7: Rest of market impact today
    table.cell(t, 0, 7, "REST OF MARKET IMPACT TODAY: " + f_fmtPts(breadthPts_now), bgcolor=colorBg, text_color=f_col(breadthPts_now), text_size=font_size)
    
    // LINE 8: MAG7 participation
    table.cell(t, 0, 8, "MAG7 SHARE: " + str.tostring(magShare * 100, "#.0") + "%", bgcolor=colorBg, text_color=colorText, text_size=font_size)
    
    // LINE 9: MAG State
    stateColor = magState == "MAG7 UP VS PREVIOUS SESSION" ? colorUp : magState == "MAG7 DOWN VS PREVIOUS SESSION" ? colorDown : colorNum
    table.cell(t, 0, 9, "STATE: " + magState, bgcolor=colorBg, text_color=stateColor, text_size=font_size)
    
    // LINE 10: Structural alerts
    table.cell(t, 0, 10, (alert_struct_pos ? "⚠️ ALERT: MAG7 DOMINANCE" : alert_struct_neg ? "⚠️ ALERT: HIDDEN PRESSURE" : "OK"), bgcolor=colorBg, text_color=alert_struct_pos ? colorUp : alert_struct_neg ? colorDown : colorFlat, text_size=font_size)
    
    // LINE 11: 1M Flow (divergence)
    table.cell(t, 0, 11, "1M FLOW: " + flowText, bgcolor=colorBg, text_color=flowColor, text_size=font_size)
    
    // LINE 12: Time
    table.cell(t, 0, 12, "⏱ " + str.tostring(hour(time), "00") + ":" + str.tostring(minute(time), "00") + ":" + str.tostring(second(time), "00"), bgcolor=colorBg, text_color=colorText, text_size=font_size)

// VWAP
showVWAP     = input.bool(true, "Plot Daily VWAP")
vwapTimezone = input.string("GMT+1", "VWAP Timezone", options=["GMT+1", "UTC", "Europe/Zurich", "America/Chicago"])
vwapColor    = input.color(color.orange, "VWAP Color")
vwapWidth    = input.int(2, "VWAP Width", minval=1, maxval=5)

newDay = ta.change(time("D", vwapTimezone)) != 0

var float cumVol = 0.0
var float cumPV  = 0.0

if newDay
    cumVol := 0.0
    cumPV  := 0.0

cumVol += volume
cumPV  += hlc3 * volume

vwapDaily = cumVol != 0.0 ? (cumPV / cumVol) : na

plot(showVWAP ? vwapDaily : na, "Daily VWAP", color=vwapColor, linewidth=vwapWidth)  
plot(na)
