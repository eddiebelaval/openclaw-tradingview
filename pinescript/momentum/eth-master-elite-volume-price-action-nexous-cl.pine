//@version=6
// © NEXOUS_cl
indicator("ETH Master Elite: Volume & PA - NEXOUS_cl", shorttitle="ETH_Elite_666", overlay=true, max_labels_count=500)

// --- ⚙️ SETTINGS ---
group_db    = "Dashboard Layout"
tablePos    = input.string("Bottom Center", "Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Bottom Center"], group=group_db)
tableSize   = input.string("tiny", "Text Size", options=["tiny", "small", "normal", "large"], group=group_db)

group_vol   = "Shark Engine (Automatic)"
sharkMult   = input.float(2.0, "Shark Multiplier (x)", minval=1.1, group=group_vol)
avgLength   = input.int(20, "Avg Volume Period", minval=5, group=group_vol)

bullNeon    = #00ff00 
bearNeon    = #ff0000 
headerBg    = #1a1a1a 

// --- 📊 1. SMART SHARK LOGIC (Fixed for NaN) ---
[ltfH, ltfL, ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, "1", [high, low, close, volume])

f_calcVol(highs, lows, closes, volumes) =>
    float bV = 0.0, float sV = 0.0
    if array.size(volumes) > 0
        for i = 0 to array.size(volumes) - 1
            h = array.get(highs, i), l = array.get(lows, i), c = array.get(closes, i), v = array.get(volumes, i)
            p_range = math.max(h - l, syminfo.mintick)
            p = (c - l) / p_range
            bV += nz(v) * p, sV += nz(v) * (1 - p)
    [bV, sV]

[currBuy, currSell] = f_calcVol(ltfH, ltfL, ltfC, ltfV)
totalV = currBuy + currSell
avgV = ta.sma(volume, avgLength)
// Χρήση nz() για να αποφύγουμε το NaN αν δεν υπάρχουν ακόμα δεδομένα
isShark = totalV >= (nz(avgV) * sharkMult)
delta = currBuy - currSell

// --- 📉 2. PRICE ACTION STRUCTURE ---
ph = ta.pivothigh(high, 3, 3), pl = ta.pivotlow(low, 3, 3)
if not na(ph)
    label.new(bar_index[3], ph, ph > nz(ph[1]) ? "HH" : "LH", color=color.new(color.black, 100), textcolor=bullNeon, style=label.style_label_down, size=size.small)
if not na(pl)
    label.new(bar_index[3], pl, pl < nz(pl[1]) ? "LL" : "HL", color=color.new(color.black, 100), textcolor=bearNeon, style=label.style_label_up, size=size.small)

// --- 🖥️ 3. CLEAN DASHBOARD ---
get_pos(p) =>
    p == "Top Right" ? position.top_right : p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : position.bottom_center

var table eliteTable = table.new(get_pos(tablePos), 11, 2, bgcolor=color.new(color.black, 10), border_color=color.new(color.gray, 50), border_width=1)

if barstate.islast
    headers = array.from("ASSET", "STATUS", "TOTAL VOL", "BUY VOL", "SELL VOL", "DELTA", "BUY %", "SELL %", "SHARK", "STRUCT", "SIGNAL")
    for i = 0 to 10
        table.cell(eliteTable, i, 0, array.get(headers, i), text_color=color.white, bgcolor=headerBg, text_size=tableSize)
    
    buyPct = (currBuy / math.max(totalV, 1)) * 100
    
    table.cell(eliteTable, 0, 1, syminfo.ticker, text_color=color.white, text_size=tableSize)
    table.cell(eliteTable, 1, 1, close > open ? "BULL" : "BEAR", text_color=close > open ? bullNeon : bearNeon, text_size=tableSize)
    table.cell(eliteTable, 2, 1, str.tostring(totalV, "#"), text_color=isShark ? color.aqua : color.white, text_size=tableSize)
    table.cell(eliteTable, 3, 1, str.tostring(currBuy, "#"), text_color=bullNeon, text_size=tableSize)
    table.cell(eliteTable, 4, 1, str.tostring(currSell, "#"), text_color=bearNeon, text_size=tableSize)
    table.cell(eliteTable, 5, 1, str.tostring(delta, "#"), bgcolor=delta > 0 ? color.new(color.green, 70) : color.new(color.red, 70), text_size=tableSize)
    table.cell(eliteTable, 6, 1, str.tostring(buyPct, "#.#") + "%", text_color=bullNeon, text_size=tableSize)
    table.cell(eliteTable, 7, 1, str.tostring(100-buyPct, "#.#") + "%", text_color=bearNeon, text_size=tableSize)
    table.cell(eliteTable, 8, 1, isShark ? "🦈" : "-", text_color=color.aqua, text_size=tableSize)
    table.cell(eliteTable, 9, 1, delta > 0 ? "ACCUM" : "DIST", text_color=color.yellow, text_size=tableSize)
    table.cell(eliteTable, 10, 1, isShark and delta > 0 ? "BUY" : "WAIT", bgcolor=isShark and delta > 0 ? color.green : na, text_color=color.white, text_size=tableSize)
