//@version=6
indicator("Ligne Verticale 00H00 Paris", overlay=true, max_lines_count=500)

// === TIMEZONE ===
tz = "Europe/Paris"

// === INPUTS ===
lineColor   = input.color(color.blue, "Couleur ligne")
opacity     = input.int(0, "Opacité (0 = visible / 100 = invisible)", minval=0, maxval=100)
lineWidth   = input.int(2, "Épaisseur ligne", minval=1, maxval=5)
lineStyle   = input.string("Solid", "Style ligne", options=["Solid", "Dashed", "Dotted"])

// === STYLE SELECTION ===
style =
     lineStyle == "Solid"  ? line.style_solid  :
     lineStyle == "Dashed" ? line.style_dashed :
                             line.style_dotted

// === DETECTION 00H00 ===
isMidnight = (hour(time, tz) == 0 and minute(time, tz) == 0)

// === DRAW LINE ===
if isMidnight
    line.new(
        x1=bar_index,
        y1=low - (ta.atr(14) * 5),
        x2=bar_index,
        y2=high + (ta.atr(14) * 5),
        color=color.new(lineColor, opacity),
        width=lineWidth,
        style=style
    )
