//@version=6
indicator("EMA14CHANUT", overlay=true)

// ===== INPUT =====
showDashboard = input.bool(true,"Show Dashboard")
showEMA       = input.bool(true,"Show EMA Line")
emaPeriod     = input.int(14,"EMA Period")

dashboardPosition = input.string("Bottom Left","Dashboard Position",
 options=["Top Left","Top Right","Bottom Left","Bottom Right"])

headerColor   = input.color(color.yellow,"Header Text Color")
tfColor       = input.color(color.white,"Timeframe Text Color")
distanceColor = input.color(color.orange,"Distance Normal Color")

distanceAlert = input.int(500,"Distance Alert Threshold (Points)")
blinkDistance = input.int(200,"Blink Distance Threshold (Points)")
enableBlink   = input.bool(true,"Enable Blink")

// ===== POSITION =====
pos = position.bottom_left
if dashboardPosition == "Top Left"
    pos := position.top_left
else if dashboardPosition == "Top Right"
    pos := position.top_right
else if dashboardPosition == "Bottom Right"
    pos := position.bottom_right

// ===== EMA =====
emaValue = ta.ema(close,emaPeriod)

plot(showEMA ? emaValue : na,
 title="EMA",
 color=color.orange,
 linewidth=2)

// ===== BLINK TIMER =====
blink = math.floor(timenow / 500) % 2 == 0

// ===== STATUS FUNCTION =====
f_status(tf)=>
    c = request.security(syminfo.tickerid,tf,close)
    e = request.security(syminfo.tickerid,tf,ta.ema(close,emaPeriod))
    
    dist = (c-e)/syminfo.mintick
    status = c>e ? "Up":"Down"
    statusColor = c>e ? color.green : color.red
    
    absDist = math.abs(dist)

    distColor =
         enableBlink and absDist < blinkDistance ?
             (blink ? color.red : color.white) :
         absDist < distanceAlert ?
             color.red :
             distanceColor
    
    [status,dist,statusColor,distColor]

// ===== CURRENT TF =====
currentTF = timeframe.period

f_isCurrent(tfCode)=>
    (
     (tfCode == "D" and (currentTF == "D" or currentTF == "1D")) or
     (tfCode == "W" and (currentTF == "W" or currentTF == "1W")) or
     (tfCode != "D" and tfCode != "W" and currentTF == tfCode)
    )

f_tfLabel(name,code)=>
    f_isCurrent(code) ? name + "\n────" : name

// ===== TIMEFRAMES =====
[st1,d1,sc1,dc1]=f_status("1")
[st2,d2,sc2,dc2]=f_status("5")
[st3,d3,sc3,dc3]=f_status("15")
[st4,d4,sc4,dc4]=f_status("30")
[st5,d5,sc5,dc5]=f_status("60")
[st6,d6,sc6,dc6]=f_status("240")
[st7,d7,sc7,dc7]=f_status("D")
[st8,d8,sc8,dc8]=f_status("W")

// ===== TABLE =====
var table dashboard = table.new(pos,3,9,border_width=1)

if barstate.islast and showDashboard

    table.cell(dashboard,0,0,"Time Frame",text_color=headerColor)
    table.cell(dashboard,1,0,"Status",text_color=headerColor)
    table.cell(dashboard,2,0,"Distance (Points)",text_color=headerColor)

    table.cell(dashboard,0,1,f_tfLabel("M1","1"),text_color=tfColor)
    table.cell(dashboard,1,1,st1,text_color=sc1)
    table.cell(dashboard,2,1,str.tostring(d1,"#.##"),text_color=dc1)

    table.cell(dashboard,0,2,f_tfLabel("M5","5"),text_color=tfColor)
    table.cell(dashboard,1,2,st2,text_color=sc2)
    table.cell(dashboard,2,2,str.tostring(d2,"#.##"),text_color=dc2)

    table.cell(dashboard,0,3,f_tfLabel("M15","15"),text_color=tfColor)
    table.cell(dashboard,1,3,st3,text_color=sc3)
    table.cell(dashboard,2,3,str.tostring(d3,"#.##"),text_color=dc3)

    table.cell(dashboard,0,4,f_tfLabel("M30","30"),text_color=tfColor)
    table.cell(dashboard,1,4,st4,text_color=sc4)
    table.cell(dashboard,2,4,str.tostring(d4,"#.##"),text_color=dc4)

    table.cell(dashboard,0,5,f_tfLabel("H1","60"),text_color=tfColor)
    table.cell(dashboard,1,5,st5,text_color=sc5)
    table.cell(dashboard,2,5,str.tostring(d5,"#.##"),text_color=dc5)

    table.cell(dashboard,0,6,f_tfLabel("H4","240"),text_color=tfColor)
    table.cell(dashboard,1,6,st6,text_color=sc6)
    table.cell(dashboard,2,6,str.tostring(d6,"#.##"),text_color=dc6)

    table.cell(dashboard,0,7,f_tfLabel("D","D"),text_color=tfColor)
    table.cell(dashboard,1,7,st7,text_color=sc7)
    table.cell(dashboard,2,7,str.tostring(d7,"#.##"),text_color=dc7)

    table.cell(dashboard,0,8,f_tfLabel("W","W"),text_color=tfColor)
    table.cell(dashboard,1,8,st8,text_color=sc8)
    table.cell(dashboard,2,8,str.tostring(d8,"#.##"),text_color=dc8)
