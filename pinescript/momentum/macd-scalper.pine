//@version=6
indicator("MACD Scalper", overlay=true)

// ─── MACD SETTINGS ───────────────────────────────────────────────
fast       = input.int(12,  "Fast Length",   minval=1)
slow       = input.int(26,  "Slow Length",   minval=1)
signal_len = input.int(9,   "Signal Length", minval=1)

// ─── TABLE SETTINGS ──────────────────────────────────────────────
size_input = input.string("Large", "Table Size",
     options=["Tiny", "Small", "Normal", "Large", "Huge"])

pos_input  = input.string("Top Right", "Position",
     options=["Top Right", "Top Center", "Top Left",
              "Middle Right", "Middle Center", "Middle Left",
              "Bottom Right", "Bottom Center", "Bottom Left"])

// ─── MAP INPUTS ───────────────────────────────────────────────────
table_size =
     size_input == "Tiny"   ? size.tiny   :
     size_input == "Small"  ? size.small  :
     size_input == "Normal" ? size.normal :
     size_input == "Large"  ? size.large  :
     size.huge

table_pos =
     pos_input == "Top Right"      ? position.top_right    :
     pos_input == "Top Center"     ? position.top_center   :
     pos_input == "Top Left"       ? position.top_left     :
     pos_input == "Middle Right"   ? position.middle_right :
     pos_input == "Middle Center"  ? position.middle_center:
     pos_input == "Middle Left"    ? position.middle_left  :
     pos_input == "Bottom Right"   ? position.bottom_right :
     pos_input == "Bottom Center"  ? position.bottom_center:
     position.bottom_left

// ─── MACD CALCULATION ────────────────────────────────────────────
[macd_line, signal_line, _] = ta.macd(close, fast, slow, signal_len)

// ─── COLOR LOGIC ─────────────────────────────────────────────────
// Dark Green  → MACD above zero AND above signal  (full bullish)
// Light Green → MACD above zero BUT below signal  (bullish fading)
// Light Red   → MACD below zero BUT above signal  (bearish recovering)
// Dark Red    → MACD below zero AND below signal  (full bearish)

color bg_color =
     macd_line > 0 and macd_line > signal_line ? color.new(#006400, 0) :  // dark green
     macd_line > 0 and macd_line < signal_line ? color.new(#90EE90, 0) :  // light green
     macd_line < 0 and macd_line > signal_line ? color.new(#FF6B6B, 0) :  // light red
     color.new(#8B0000, 0)                                                  // dark red

// ─── LABEL TEXT ──────────────────────────────────────────────────
string label_text =
     macd_line > 0 and macd_line > signal_line ? "▲▲ BULL" :
     macd_line > 0 and macd_line < signal_line ? "▲  bull" :
     macd_line < 0 and macd_line > signal_line ? "▼  bear" :
     "▼▼ BEAR"

color text_color =
     macd_line > 0 ? color.white : color.white

// ─── DRAW TABLE ───────────────────────────────────────────────────
var table macd_table = table.new(table_pos, 1, 1)

if barstate.islast
    table.cell(macd_table, 0, 0,
         text          = label_text,
         text_color    = text_color,
         text_size     = table_size,
         bgcolor       = bg_color,
         text_halign   = text.align_center,
         text_valign   = text.align_center)
