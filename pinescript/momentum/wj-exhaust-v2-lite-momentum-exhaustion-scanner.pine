//@version=5
indicator("WJ Exhaust v2 Lite - Momentum + Exhaustion Scanner", shorttitle="WJ Exhaust Lite", overlay=true)

// ────────────────────────────────────────────────
// WJ Exhaust v2 Lite – Momentum + Exhaustion Scanner (Public Preview)
// Green upward arrows: Oversold exhaustion → potential bounce/long setups
// Red downward arrows: Overbought exhaustion → potential tops/exit zones
// Lite version: Visuals & alerts only. Full version (with TP/SL, backtest) is invite-only – DM for access.
// Version 2.0 Lite – March 2026

// ────────────────────────────────────────────────
// INPUTS - User-friendly customization
momLength     = input.int(14, "Momentum Length", minval=1)
rsiLength     = input.int(14, "RSI Length", minval=1)
exhaustCount  = input.int(9, "Exhaustion Count (bars)", minval=1)
overbought    = input.int(70, "RSI Overbought")
oversold      = input.int(30, "RSI Oversold")
atrMult       = input.float(2.5, "Overextended ATR Multiplier", minval=0.1)

// ────────────────────────────────────────────────
// CALCULATIONS
mom         = ta.mom(close, momLength)
rsi         = ta.rsi(close, rsiLength)
emaFast     = ta.ema(close, 9)
vwapVal     = ta.vwap(hlc3)
atrVal      = ta.atr(14)
distFromEMA = (close - emaFast) / atrVal

overExtUp   = distFromEMA > atrMult
overExtDown = distFromEMA < -atrMult

var int bullExhaust = 0
var int bearExhaust = 0

if close > close[4]
    bullExhaust := bullExhaust + 1
else
    bullExhaust := 0

if close < close[4]
    bearExhaust := bearExhaust + 1
else
    bearExhaust := 0

bullMomentum = mom > 0 and rsi > 50 and bullExhaust >= exhaustCount / 2

exhaustUp   = (rsi > overbought or bullExhaust >= exhaustCount) and mom < mom[1] and overExtUp
exhaustDown = (rsi < oversold   or bearExhaust >= exhaustCount) and mom > mom[1] and overExtDown

// ────────────────────────────────────────────────
// PLOTS & VISUALS
plot(emaFast, color=color.blue, title="Fast EMA")
plot(vwapVal, color=color.orange, title="VWAP")

bgcolor(bullMomentum ? color.new(color.green, 90) : na, title="Momentum Build")
bgcolor(exhaustUp   ? color.new(color.red, 70)   : na, title="Exhaust Up (Potential Top)")
bgcolor(exhaustDown ? color.new(color.green, 70) : na, title="Exhaust Down (Potential Bounce)")

plotshape(exhaustUp,   style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small, title="Exhaust Up")
plotshape(exhaustDown, style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small, title="Exhaust Down")

// ────────────────────────────────────────────────
// ALERTS - For live trading buzz
alertcondition(exhaustDown, title="WJ Lite - Bounce Alert", message="Potential exhaustion down - Bounce setup on {{ticker}}")
alertcondition(exhaustUp,   title="WJ Lite - Top Alert", message="Potential exhaustion up - Watch for exit or fade on {{ticker}}")
