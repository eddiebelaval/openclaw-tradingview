// © NEXOUS_cl
//@version=5
indicator("NEXOUS_cl Quantum Pulse Alpha", overlay=true, max_labels_count=500)

// --- INPUTS ---
q_src = close
q_len = input.int(14, "Quantum Lookback")
q_sens = input.float(2.0, "Signal Sensitivity")

// --- QUANTUM ENGINE ---
q_sma = ta.sma(q_src, q_len)
q_stdev = ta.stdev(q_src, q_len)
q_zscore = (q_src - q_sma) / q_stdev

// --- QUANTUM RIBBON ---
up_line = ta.sma(q_src, 20) + (ta.stdev(q_src, 20) * q_sens)
dn_line = ta.sma(q_src, 20) - (ta.stdev(q_src, 20) * q_sens)

// PLOTS - Χρησιμοποιούμε σταθερά χρώματα για αποφυγή σφαλμάτων επικόλλησης
p1 = plot(up_line, color=#00FFFF, title="Upper Band") // Aqua
p2 = plot(dn_line, color=#FF00FF, title="Lower Band") // Magenta
fill(p1, p2, color=color.new(#2196F3, 90), title="Quantum Area")

// --- SIGNALS ---
is_long = ta.crossover(q_zscore, -1.5) and q_src > ta.ema(q_src, 50)
is_short = ta.crossunder(q_zscore, 1.5) and q_src < ta.ema(q_src, 50)

// DISPLAY
plotshape(is_long, style=shape.triangleup, location=location.belowbar, color=#00FFFF, size=size.small, text="Q-BUY")
plotshape(is_short, style=shape.triangledown, location=location.abovebar, color=#FF00FF, size=size.small, text="Q-SELL")

// CANDLE COLORS
dynamic_c = q_zscore > 0 ? (q_zscore > 2 ? #00FFFF : #2196F3) : (q_zscore < -2 ? #FF00FF : #F44336)
barcolor(dynamic_c)

// --- ALERTS ---
alertcondition(is_long, "Quantum Buy", "🌌 NEXOUS_cl: Quantum Buy Signal!")
alertcondition(is_short, "Quantum Sell", "🌌 NEXOUS_cl: Quantum Sell Signal!")
