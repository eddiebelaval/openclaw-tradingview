//@version=6
indicator("3 Ranges Horaires Paris", overlay=true, max_boxes_count=500, max_lines_count=500)

// === TIMEZONE ===
tz = "Europe/Paris"

// === INPUTS ===
extendLevels = input.bool(true, "Étendre les niveaux après le range")
showLevels   = input.bool(true, "Afficher High / Low")

// === RANGE 1 ===
range1       = input.session("0000-0705", "Range 1")
color1       = input.color(color.purple, "Couleur Range 1")
opacity1     = input.int(85, "Opacité Range 1 (0-100)", minval=0, maxval=100)

// === RANGE 2 ===
range2       = input.session("0800-1235", "Range 2")
color2       = input.color(color.blue, "Couleur Range 2")
opacity2     = input.int(85, "Opacité Range 2 (0-100)", minval=0, maxval=100)

// === RANGE 3 ===
range3       = input.session("1300-1505", "Range 3")
color3       = input.color(color.red, "Couleur Range 3")
opacity3     = input.int(85, "Opacité Range 3 (0-100)", minval=0, maxval=100)

// === SESSION DETECTION ===
inR1 = not na(time(timeframe.period, range1, tz))
inR2 = not na(time(timeframe.period, range2, tz))
inR3 = not na(time(timeframe.period, range3, tz))

// === FUNCTION RANGE ===
f_range(_inSession, _color, _opacity) =>
    var float rHigh = na
    var float rLow  = na
    var box   rBox  = na
    var line  hLine = na
    var line  lLine = na

    newSession = _inSession and not _inSession[1]

    if newSession
        rHigh := high
        rLow  := low
        
        rBox := box.new(bar_index, high, bar_index, low,
             bgcolor=color.new(_color, _opacity),
             border_width=0)

        if showLevels
            hLine := line.new(bar_index, high, bar_index, high, color=_color, width=2)
            lLine := line.new(bar_index, low, bar_index, low, color=_color, width=2)

    if _inSession
        rHigh := math.max(rHigh, high)
        rLow  := math.min(rLow, low)

        box.set_top(rBox, rHigh)
        box.set_bottom(rBox, rLow)
        box.set_right(rBox, bar_index)

        if showLevels
            line.set_y1(hLine, rHigh)
            line.set_y2(hLine, rHigh)
            line.set_y1(lLine, rLow)
            line.set_y2(lLine, rLow)
            line.set_x2(hLine, bar_index)
            line.set_x2(lLine, bar_index)

    if not _inSession and _inSession[1] and extendLevels and showLevels
        line.set_x2(hLine, bar_index + 100)
        line.set_x2(lLine, bar_index + 100)

// === APPLY ===
f_range(inR1, color1, opacity1)
f_range(inR2, color2, opacity2)
f_range(inR3, color3, opacity3)
