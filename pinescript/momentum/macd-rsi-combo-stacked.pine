//@version=5
indicator("MACD + RSI Combo (Stacked)", overlay=false)

// ---------- MACD SETTINGS ----------
fastLength = input.int(12, title="MACD Fast Length")
slowLength = input.int(26, title="MACD Slow Length")
signalLength = input.int(9, title="MACD Signal Length")

[macdLine, signalLine, hist] = ta.macd(close, fastLength, slowLength, signalLength)

// Histogram Colors
histColor =
 hist >= 0 ?
     (hist > hist[1] ? color.green : color.new(color.green, 40)) :
     (hist < hist[1] ? color.red : color.new(color.red, 40))

// Plot MACD
plot(hist, title="MACD Histogram", style=plot.style_columns, color=histColor)
plot(macdLine, title="MACD Line", color=color.orange, linewidth=2)
plot(signalLine, title="Signal Line", color=color.yellow, linewidth=2)


// ---------- RSI SETTINGS ----------
rsiLength = input.int(14, title="RSI Length")
rsiSource = hlcc4
rsiValue = ta.rsi(rsiSource, rsiLength)

// Offset RSI downward so it sits below MACD
rsiOffset = -100
rsiPlot = rsiValue + rsiOffset

// Plot RSI
plot(rsiPlot, title="RSI (HLCC4)", color=color.lime, linewidth=2)

// RSI Levels
hline(70 + rsiOffset, "RSI Overbought", color=color.red)
hline(30 + rsiOffset, "RSI Oversold", color=color.green)
hline(50 + rsiOffset, "RSI Midline", color=color.gray)
