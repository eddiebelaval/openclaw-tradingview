//@version=5
indicator("Momentum de Pips Institucional", overlay=true)

// Parámetros
periodos = input.int(200, "Número de velas analizadas")

// Tamaño pip aproximado
pip = syminfo.mintick * 10

// Movimiento en pips
mov = (close - open) / pip

// Clasificación de pips
pips_pos = mov > 0 ? mov : 0
pips_neg = mov < 0 ? mov : 0

// Acumulados
sum_pos = math.sum(pips_pos, periodos)
sum_neg = math.sum(pips_neg, periodos)

// Delta
delta = sum_pos + sum_neg

// Conteo de velas
bull = close > open ? 1 : 0
bear = close < open ? 1 : 0

bull_count = math.sum(bull, periodos)
bear_count = math.sum(bear, periodos)

bull_percent = bull_count / periodos * 100

// Ratio
ratio = math.abs(sum_pos / sum_neg)

// Momentum
momentum = delta / periodos

// Dominancia
bull_dom = bull_percent > 60 and delta > 0
bear_dom = bull_percent < 40 and delta < 0

bgcolor(bull_dom ? color.new(color.green,85) : na)
bgcolor(bear_dom ? color.new(color.red,85) : na)

// Tabla
var table t = table.new(position.top_right, 2, 7, border_width=1)

if barstate.islast
    table.cell(t,0,0,"Velas analizadas")
    table.cell(t,1,0,str.tostring(periodos))

    table.cell(t,0,1,"Pips positivos")
    table.cell(t,1,1,str.tostring(sum_pos), text_color=color.green)

    table.cell(t,0,2,"Pips negativos")
    table.cell(t,1,2,str.tostring(sum_neg), text_color=color.red)

    table.cell(t,0,3,"Delta pips")
    table.cell(t,1,3,str.tostring(delta))

    table.cell(t,0,4,"% velas alcistas")
    table.cell(t,1,4,str.tostring(bull_percent, "#.##") + "%")

    table.cell(t,0,5,"Ratio Bull/Bear")
    table.cell(t,1,5,str.tostring(ratio, "#.##"))

    table.cell(t,0,6,"Momentum")
    table.cell(t,1,6,str.tostring(momentum, "#.##"))
