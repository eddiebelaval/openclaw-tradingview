//@version=6
indicator("Aura Sentiment & Risk Flow [Pineify]", shorttitle="Aura Flow", overlay=false, format=format.price, precision=2, max_lines_count=500, max_labels_count=500)

//---------------------------------------------------------------------------------------------------------------------}
// SETTINGS
//---------------------------------------------------------------------------------------------------------------------{

groupSentiment = "Sentiment Settings"
rsiLen    = input.int(14, "Sentiment Length", minval=1, group=groupSentiment, tooltip="Sensitivity of the oscillator based on RSI logic")
smoothLen = input.int(3, "Smoothing Factor", minval=1, group=groupSentiment)

groupRisk = "Risk & Volatility Settings"
atrLen    = input.int(22, "Risk Lookback", minval=1, group=groupRisk, tooltip="Based on Chandelier Exit Oscillator concepts")
atrMult   = input.float(3.0, "Risk Multiplier", minval=0.1, step=0.1, group=groupRisk)

groupStyle = "Visuals"
colBull   = input.color(#089981, "Bullish Color", group=groupStyle)
colBear   = input.color(#f23645, "Bearish Color", group=groupStyle)
colNeut   = input.color(#787b86, "Neutral/Risk Color", group=groupStyle)

//---------------------------------------------------------------------------------------------------------------------}
// CALCULATIONS
//---------------------------------------------------------------------------------------------------------------------{

// 1. Sentiment Calculation (Normalized Momentum)
// Inspired by Market Sentiment Technicals
rawRSI = ta.rsi(close, rsiLen)
// Normalize RSI to -50 to +50 scale for better visual centering
sentimentOsc = ta.sma(rawRSI - 50, smoothLen)

// 2. Risk Calculation (Chandelier Exit Logic)
// Inspired by Chandelier Exit Oscillator
atrValue = ta.atr(atrLen)
highestHigh = ta.highest(close, atrLen)
lowestLow   = ta.lowest(close, atrLen)

// Calculate Chandelier Exits
chandLong  = highestHigh - atrValue * atrMult
chandShort = lowestLow + atrValue * atrMult

// Normalize Risk into a 0-100 Oscillator format
riskRange = highestHigh - lowestLow
riskOsc   = riskRange > 0 ? ((close - chandShort) / riskRange) * 50 : 0
riskOscInv = riskRange > 0 ? ((chandLong - close) / riskRange) * 50 : 0

// 3. Flow Logic (Trend Strength)
// Determine trend direction
isUptrend   = sentimentOsc > 0
isDowntrend = sentimentOsc < 0

//---------------------------------------------------------------------------------------------------------------------}
// PLOTTING & VISUALS
//---------------------------------------------------------------------------------------------------------------------{

// Dynamic Gradient Color for the Histogram
// Uses gradients similar to Squeeze Index
colorAura = color.from_gradient(sentimentOsc, -50, 50, color.new(colBear, 20), color.new(colBull, 20))

// Fade color if momentum is decreasing (Risk Warning)
// Fixed: Compare with previous value to detect momentum weakening
momentumFading = (isUptrend and sentimentOsc < sentimentOsc[1]) or (isDowntrend and sentimentOsc > sentimentOsc[1])

if momentumFading
    colorAura := color.new(colNeut, 50)

// Plot the Sentiment Histogram
plot(sentimentOsc, "Sentiment Aura", color=colorAura, style=plot.style_columns, linewidth=3, display=display.all)

// Plot the Risk Ribbon (Signal Line)
plot(sentimentOsc, "Signal Edge", color=color.new(color.white, 80), style=plot.style_line, linewidth=1, display=display.all)

// Zero Line
hline(0, "Zero Line", color=color.new(colNeut, 70), linestyle=hline.style_dotted, display=display.all)

//---------------------------------------------------------------------------------------------------------------------}
// SIGNALS
//---------------------------------------------------------------------------------------------------------------------{

// Crossover Detection
crossUp = ta.crossover(sentimentOsc, 0)
crossDn = ta.crossunder(sentimentOsc, 0)

// Signals
// Only signal if the move is significant (filters noise)
buySignal  = crossUp
sellSignal = crossDn

// Visual Signals on the Oscillator
plotshape(buySignal ? -5 : na, title="Buy Signal", style=shape.labelup, location=location.absolute, color=colBull, text="BUY", textcolor=color.white, size=size.tiny, display=display.all)
plotshape(sellSignal ? 5 : na, title="Sell Signal", style=shape.labeldown, location=location.absolute, color=colBear, text="SELL", textcolor=color.white, size=size.tiny, display=display.all)

// Background color to indicate high risk zones (Extreme Sentiment)
// Inspired by Squeeze Index compression concepts
isExtreme = math.abs(sentimentOsc) > 40
bgcolor(isExtreme ? color.new(colNeut, 90) : na, title="Extreme Risk Zone")

//---------------------------------------------------------------------------------------------------------------------}
// ADDITIONAL ENHANCEMENTS
//---------------------------------------------------------------------------------------------------------------------{

// Risk Flow Ribbon - Shows volatility expansion/contraction
// When risk expands, the ribbon width increases
riskFlow = math.abs(sentimentOsc) - math.abs(riskOsc - riskOscInv)
plot(riskFlow, "Risk Flow", color=color.new(colNeut, 70), style=plot.style_area, histbase=-50, linewidth=1, display=display.none)

// Alert conditions for TradingView alerts
alertcondition(buySignal, title="Aura Buy Signal", message="Aura Flow: BUY Signal - Bullish Sentiment Crossing Up")
alertcondition(sellSignal, title="Aura Sell Signal", message="Aura Flow: SELL Signal - Bearish Sentiment Crossing Down")
alertcondition(isExtreme, title="Aura Extreme Risk", message="Aura Flow: Extreme Risk Zone - Sentiment at extremes")
