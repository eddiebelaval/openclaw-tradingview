//@version=5
indicator("SuperTrend Pro + EMA + RSI + Trailing Stop", overlay=true, max_labels_count=500)

// =======================
// INPUT PARAMETERS
// =======================

// SuperTrend Inputs
factor     = input.float(3.0, "Main Factor (Buy & Plot)", minval=0.01, step=0.01)
sellFactor = input.float(2.4, "Sell Factor (Early Warning)", minval=0.01, step=0.01)
atrLen     = input.int(10, "ATR Length", minval=1)

// Volume Inputs
volLen     = input.int(20, "Vol Avg Length")
volMult    = input.float(1.5, "Vol Multiplier")

// New Safety Filter Inputs (EMA & RSI)
emaLen     = input.int(200, "EMA Filter Length")
rsiLen     = input.int(14, "RSI Length")
rsiMax     = input.float(65.0, "RSI Max for Buy (Avoid overbought)")

// Trailing Stop Input
trailPct   = input.float(2.0, "Trailing Stop %", minval=0.1, step=0.1)

// =======================
// CALCULATIONS
// =======================

[st, dir]         = ta.supertrend(factor, atrLen)
[stSell, dirSell] = ta.supertrend(sellFactor, atrLen)

avgVol = ta.sma(volume, volLen)
ema200 = ta.ema(close, emaLen)
rsiVal = ta.rsi(close, rsiLen)

// =======================
// CONDITIONS & LOGIC
// =======================

// 1. Is Volume high?
volCondition = (volume > (avgVol * volMult))

// 2. Are we in a macro Bull Trend? (Price above 200 EMA)
emaBullCondition = (close > ema200)

// 3. Is there still room to grow? (RSI not overbought)
rsiCondition = (rsiVal < rsiMax)

// Buy Signal Logic: Supertrend turns Green + High Vol + Above EMA + Under RSI
rawBuy = (dir == -1) and (dir[1] == 1) 
buySignal = rawBuy and volCondition and emaBullCondition and rsiCondition

// =======================
// TRAILING STOP STATE 
// =======================

var float trailStop = na
var bool inTrade = false
var bool sellSignal = false

sellSignal := false // Reset sell signal every bar

// Enter a trade if we get a buy signal
if buySignal and not inTrade
    inTrade := true
    trailStop := close * (1 - (trailPct / 100))

// If we are currently in a trade, manage the Stop Loss or Early Sell
if inTrade
    // Move the trailing stop UP if the price increases, but NEVER down
    trailStop := math.max(trailStop, close * (1 - (trailPct / 100)))
    
    // Condition A: Did we hit the Trailing Stop Loss?
    hitStop = (close < trailStop)
    
    // Condition B: Did the early SuperTrend flip Red with High Volume?
    rawSell = (dirSell == 1) and (dirSell[1] == -1)
    earlySell = rawSell and volCondition

    // If either scenario happens, SELL and exit the trade
    if hitStop or earlySell
        inTrade := false
        trailStop := na
        sellSignal := true

// =======================
// PLOTTING
// =======================

// Plot the main SuperTrend Line
plot(st, "Main SuperTrend", color = dir == -1 ? color.green : color.red, linewidth=2)

// Plot the 200 EMA Line
plot(ema200, "200 EMA", color=color.blue, linewidth=2, title="200 EMA")

// Plot the Trailing Stop Line (only shows up when we are secretly 'in a trade')
plot(inTrade ? trailStop : na, "Trailing Stop", color=color.orange, style=plot.style_cross, linewidth=2)

// Plot Buy & Sell Arrows
plotshape(buySignal,  title="BUY",  location=location.belowbar, color=color.lime, style=shape.triangleup,   size=size.large, text="BUY")
plotshape(sellSignal, title="SELL", location=location.abovebar, color=color.red,  style=shape.triangledown, size=size.large, text="SELL")

// =======================
// ALERTS
// =======================
alertcondition(buySignal,  "Pro Buy Signal",  "BUY! High Vol, Bullish EMA, Good RSI.")
alertcondition(sellSignal, "Pro Sell Signal", "SELL! Trailing Stop or Indicator flip triggered.")
