//                                 ██║       ██║     ████████║  ██║ ███║  ██║   ██║       ██████╔╝ ██║   ██║ ██║      ████████║ ████████║
//                                 ██║       ██║     ██╔═══██║  ██║  ██║  ██║   ██║       ██╔══██╗ ██║   ██║ ██║      ██║   ██║ ██╔═══██║
//                                 ██║    ████████╗  ██║   ██║  ███████║  ╚██████╔╝       ██║  ██║ ╚██████╔╝ ╚██████╗ ██║   ██║ ██║   ██║
//@version=6
indicator('Double Momentum - DMOM | TR', 'DMOM | TR →', false)
import TradingView/ta/12
//╔═════════════════╗
//║     Input's     ║
//╚═════════════════╝
Color_Mode =        input.string('Classic', 'Color Choice', group = '🎨 Color', options = ['Classic', 'Modern', 'Robust', 'Accented', 'Monochrome', 'Moderate', 'Aqua', 'Cosmic'])
Length_DMOM =       input.int(36, title = 'Length DMOM:', group='⚙️ DMOM Setting', inline = 'MOM')
Source_DMOM =       input(close, title = '', group='⚙️ DMOM Setting', inline = 'MOM')
Signal_DMOM =       input.string('0', 'Entry/Exit Signal', group='⚙️ DMOM Setting', options = ['0', 'DMOM MA'],tooltip = 'Choose Entry/Exit Point')
Length_MA_DMOM =    input.int(365, title = 'Length MA', group='📊 DMOM MA', inline = 'MA')
Source_MA_DMOM =    input.string('EMA', 'Moving Average', group='📊 DMOM MA', inline = 'MA', options=['EMA', 'SMA', 'RMA', 'WMA', 'VWMA', 'HMA', 'DEMA', 'TEMA', 'TRIMA', 'FRAMA', 'SWMA', 'T3'])
T_Factor =          input.float(0.7, 'T3 Factor', minval=0, maxval=1, step=0.05, group='📊 DMOM MA', tooltip = 'For Moving Average = T3')
//╔═════════════════════════════════╗
//║     MOVING AVERAGE ENGINE       ║
//╚═════════════════════════════════╝
ma(source, length, factor, type) =>
     type == 'EMA'   ? ta.ema(source, length) :
     type == 'SMA'   ? ta.sma(source, length) :
     type == 'RMA'   ? ta.rma(source, length) :
     type == 'WMA'   ? ta.wma(source, length) :
     type == 'VWMA'  ? ta.vwma(source, length) :
     type == 'HMA'   ? ta.hma(source, length) :
     type == 'DEMA'  ? ta.dema(source, length) :
     type == 'TEMA'  ? ta.tema(source, length) :
     type == 'TRIMA' ? ta.trima(source, length) :
     type == 'FRAMA' ? ta.frama(source, length) :
     type == 'SWMA'  ? ta.swma(source) :
     type == 'T3'    ? ta.t3(source, length, factor) :
     na
//╔═════════════════╗
//║     Color       ║
//╚═════════════════╝
[UpC, DnC] = switch Color_Mode
    'Classic' =>    [#008800, #ff0000]
    'Modern' =>     [#ffffff, #b721ff]
    'Robust' =>     [#ffbb00, #770737]
    'Accented' =>   [#8c5cf7, #e83e8c]
    'Monochrome' => [#e9ecef, #495057]
    'Moderate' =>   [#43a047, #e53935]
    'Aqua' =>       [#00a8e8, #f18f01]
    'Cosmic' =>     [#e83e8c, #6f2da8]
//╔════════════════════════╗
//║      Calculation       ║
//╚════════════════════════╝
MOM = ta.mom(Source_DMOM,Length_DMOM)
DMOM = 2 * MOM - ta.mom(MOM, Length_DMOM)
DMOM_MA =  ma(DMOM, Length_MA_DMOM, T_Factor, Source_MA_DMOM)
float Entry_DMOM = Signal_DMOM == 'DMOM MA' ? DMOM_MA : 0.0
isBull_DMOM = DMOM > Entry_DMOM
isBear_DMOM = DMOM < Entry_DMOM
Bull_DMOM = ta.crossover(DMOM, Entry_DMOM)
Bear_DMOM = ta.crossunder(DMOM, Entry_DMOM)
//╔════════════════════════╗
//║          Plot          ║
//╚════════════════════════╝
Plot_DMOM =         plot(DMOM, color = DMOM > Entry_DMOM ? color.new(UpC, 50):color.new(DnC, 50), linewidth = 3)
Plot_Entry_DMOM =   plot(Entry_DMOM,color = color.yellow)
fill(Plot_DMOM, Plot_Entry_DMOM, 30000, Entry_DMOM, top_color = color.new(UpC, 0),    bottom_color = color.new(UpC, 100), title = 'Overbought Fill')
fill(Plot_DMOM, Plot_Entry_DMOM, Entry_DMOM, -30000, top_color = color.new(DnC, 100), bottom_color = color.new(DnC, 0), title = 'Oversold Fill')
fill(Plot_DMOM, Plot_Entry_DMOM, DMOM < Entry_DMOM ? DMOM : Entry_DMOM, DMOM < Entry_DMOM ? Entry_DMOM : DMOM, DMOM < Entry_DMOM ? DnC : #00000000, DMOM < Entry_DMOM ? #00000000 : UpC)
plotcandle(open, high, low, close, 'Bar Color', isBull_DMOM ? UpC : isBear_DMOM ? DnC : na, isBull_DMOM ? UpC : isBear_DMOM ? DnC : na, bordercolor = isBull_DMOM ? UpC : isBear_DMOM ? DnC : na, force_overlay = true)
plotshape(Bull_DMOM, 'LONG' , shape.triangleup  , location.belowbar, UpC,    0, size = size.small, force_overlay = true)
plotshape(Bear_DMOM, 'SHORT', shape.triangledown, location.abovebar, DnC,    0, size = size.small, force_overlay = true)
bgcolor(isBull_DMOM ? color.new(UpC, 95) : isBear_DMOM ? color.new(DnC, 95) : na, title='Zone Background', force_overlay = true)
//╔════════════════════════╗
//║          VIEW          ║
//╚════════════════════════╝
var table Table_DMOM = table.new(position.middle_right, 1, 1, border_width = 1)
var label DMOMLabel = na
if barstate.islast
    table.cell(Table_DMOM, 0, 0, text = isBull_DMOM ? '⬆️ Bullish' : '⬇️ Bearish', text_color = isBull_DMOM ? UpC : DnC,text_size = size.huge)
    if not na(DMOMLabel)
        label.delete(DMOMLabel)
    DMOMLabel := label.new(bar_index + 5, DMOM, text =  str.tostring(DMOM, '#.##'), color = DMOM > Entry_DMOM ? color.new(UpC, 20) : DMOM < Entry_DMOM ? color.new(DnC, 20) : color.gray, style = label.style_label_left, size = size.large, textcolor = #000000)
//╔════════════════════════╗
//║         Alerts         ║
//╚════════════════════════╝
alertcondition(Bull_DMOM, title= 'LONG', message= '{{ticker}} LONG')
alertcondition(Bear_DMOM, title= 'SHORT', message= '{{ticker}} SHORT')
