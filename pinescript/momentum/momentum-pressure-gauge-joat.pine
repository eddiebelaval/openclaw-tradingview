//@version=6
indicator("Momentum Pressure Gauge [JOAT] ", shorttitle="MPG [JOAT]", overlay=false, max_bars_back=500)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MOMENTUM PRESSURE GAUGE
// Quantitative Trading Systems - Buy/Sell Pressure & Momentum Analysis
// Purpose: Measure institutional pressure differential and momentum state
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

//───────────────────────────────────────────────────────────────────────────────
// CONFIGURATION
//───────────────────────────────────────────────────────────────────────────────

g_pressure = "═══════════ Pressure Settings ═══════════"
int     i_pressure_len  = input.int(14, "Pressure Period", minval=5, maxval=50, group=g_pressure)
int     i_smooth_len    = input.int(5, "Smoothing Period", minval=1, maxval=20, group=g_pressure)
int     i_momentum_len  = input.int(10, "Momentum Lookback", minval=3, maxval=30, group=g_pressure)

g_thresh = "═══════════ Thresholds ═══════════"
float   i_extreme_high  = input.float(0.7, "Extreme Buying", minval=0.5, maxval=0.95, step=0.05, group=g_thresh)
float   i_extreme_low   = input.float(0.3, "Extreme Selling", minval=0.05, maxval=0.5, step=0.05, group=g_thresh)
float   i_momentum_thresh = input.float(0.05, "Momentum Threshold", minval=0.01, maxval=0.2, step=0.01, group=g_thresh)

g_wavetrend = "═══════════ WaveTrend Integration ═══════════"
bool    i_use_wt        = input.bool(true, "Enable WaveTrend Layer", group=g_wavetrend)
int     i_wt_channel    = input.int(9, "WT Channel Length", minval=5, maxval=20, group=g_wavetrend)
int     i_wt_avg        = input.int(12, "WT Average Length", minval=5, maxval=30, group=g_wavetrend)

g_visual = "═══════════ Visual Settings ═══════════"
color   i_buy_col       = input.color(color.new(#00dbff, 0), "Buying Pressure", group=g_visual)
color   i_buy_core      = input.color(color.new(#0099cc, 0), "Buy Core", group=g_visual)
color   i_buy_glow      = input.color(color.new(#00e5ff, 0), "Buy Glow", group=g_visual)
color   i_buy_soft      = input.color(color.new(#4dd0e1, 0), "Buy Soft", group=g_visual)
color   i_sell_col      = input.color(color.new(#ff1493, 0), "Selling Pressure", group=g_visual)
color   i_sell_core     = input.color(color.new(#880e4f, 0), "Sell Core", group=g_visual)
color   i_sell_glow     = input.color(color.new(#ff69b4, 0), "Sell Glow", group=g_visual)
color   i_sell_soft     = input.color(color.new(#f48fb1, 0), "Sell Soft", group=g_visual)
color   i_neutral_col   = input.color(color.new(#546e7a, 0), "Neutral", group=g_visual)
color   i_momentum_col  = input.color(color.new(#40c4ff, 0), "Momentum Line", group=g_visual)
color   i_energy_col    = input.color(color.new(#ea80fc, 0), "Energy Wave", group=g_visual)
color   i_energy_glow   = input.color(color.new(#ce93d8, 0), "Energy Glow", group=g_visual)
bool    i_show_zones    = input.bool(true, "Show Extreme Zones", group=g_visual)
bool    i_show_energy   = input.bool(true, "Show Energy Wave", group=g_visual)
bool    i_show_glow     = input.bool(true, "Enable Glow Effects", group=g_visual)
bool    i_show_dash     = input.bool(true, "Show Dashboard", group=g_visual)
bool    i_show_labels   = input.bool(true, "Show Pressure Labels", group=g_visual)
bool    i_show_intensity = input.bool(true, "Show Intensity Bands", group=g_visual)
string  i_label_size    = input.string("Small", "Label Size", ["Tiny", "Small", "Normal"], group=g_visual)

// Helper function to convert string to size
f_string_to_size(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : size.normal

//───────────────────────────────────────────────────────────────────────────────
// CORE PRESSURE CALCULATIONS
//───────────────────────────────────────────────────────────────────────────────

// Raw buying/selling pressure
f_pressure_raw() =>
    float range_val = high - low
    float buy_pressure = range_val > 0 ? (close - low) / range_val : 0.5
    float sell_pressure = range_val > 0 ? (high - close) / range_val : 0.5
    [buy_pressure, sell_pressure]

[raw_buy, raw_sell] = f_pressure_raw()

// Smoothed pressure ratio
float pressure_ratio = ta.ema(raw_buy, i_pressure_len)
float pressure_smooth = ta.ema(pressure_ratio, i_smooth_len)

// Pressure momentum (rate of change)
float pressure_momentum = pressure_smooth - pressure_smooth[i_momentum_len]

// Pressure acceleration
float pressure_accel = pressure_momentum - pressure_momentum[i_momentum_len]

//───────────────────────────────────────────────────────────────────────────────
// VOLUME-WEIGHTED PRESSURE
//───────────────────────────────────────────────────────────────────────────────

// Volume relative strength
float vol_sma = ta.sma(volume, i_pressure_len)
float vol_ratio = vol_sma > 0 ? volume / vol_sma : 1.0
float vol_weight = math.min(vol_ratio, 3.0) / 3.0  // Cap at 3x average

// Volume-weighted pressure
float vw_pressure = pressure_smooth * (0.7 + vol_weight * 0.3)

// Cumulative pressure over period
float cum_pressure = ta.sma(raw_buy, i_pressure_len) - 0.5  // Centered at 0

//───────────────────────────────────────────────────────────────────────────────
// WAVETREND OSCILLATOR
//───────────────────────────────────────────────────────────────────────────────

f_wavetrend(int channel_len, int avg_len) =>
    float ap = hlc3
    float esa = ta.ema(ap, channel_len)
    float d = ta.ema(math.abs(ap - esa), channel_len)
    float ci = d > 0 ? (ap - esa) / (0.015 * d) : 0.0
    float wt1_local = ta.ema(ci, avg_len)
    float wt2_local = ta.sma(wt1_local, 4)
    [wt1_local, wt2_local]

var float wt1 = 0.0
var float wt2 = 0.0

if i_use_wt
    [wt1, wt2] = f_wavetrend(i_wt_channel, i_wt_avg)
else
    wt1 = 0.0
    wt2 = 0.0
float wt_cross = wt1 - wt2
bool wt_bullish = wt1 > wt2 and wt1 > wt1[1]
bool wt_bearish = wt1 < wt2 and wt1 < wt1[1]

//───────────────────────────────────────────────────────────────────────────────
// ENERGY WAVE CALCULATION
//───────────────────────────────────────────────────────────────────────────────

// Energy combines pressure momentum with volume energy
float vol_energy = vol_sma > 0 ? (volume - vol_sma) / vol_sma * 100 : 0
float atr_14 = ta.atr(14)
float price_energy = atr_14 > 0 ? (close - open) / atr_14 * 100 : 0
float combined_energy = (pressure_momentum * 100 + vol_energy * 0.3 + price_energy * 0.2) / 1.5
float energy_smooth = ta.ema(combined_energy, 5)

//───────────────────────────────────────────────────────────────────────────────
// DIVERGENCE DETECTION
//───────────────────────────────────────────────────────────────────────────────

// Price direction
float price_change = close - close[i_momentum_len]
int price_dir = price_change > 0 ? 1 : price_change < 0 ? -1 : 0

// Pressure direction
int pressure_dir = pressure_momentum > i_momentum_thresh ? 1 : pressure_momentum < -i_momentum_thresh ? -1 : 0

// Divergence detection
bool bullish_divergence = price_dir == -1 and pressure_dir == 1
bool bearish_divergence = price_dir == 1 and pressure_dir == -1

//───────────────────────────────────────────────────────────────────────────────
// STATE CLASSIFICATION
//───────────────────────────────────────────────────────────────────────────────

// Pressure state
// 2 = extreme buying, 1 = buying, 0 = neutral, -1 = selling, -2 = extreme selling
var int pressure_state = 0

if pressure_smooth >= i_extreme_high
    pressure_state := 2
else if pressure_smooth > 0.5 + i_momentum_thresh
    pressure_state := 1
else if pressure_smooth <= i_extreme_low
    pressure_state := -2
else if pressure_smooth < 0.5 - i_momentum_thresh
    pressure_state := -1

// Momentum state
// 1 = accelerating, 0 = steady, -1 = decelerating
var int momentum_state = 0
if pressure_accel > i_momentum_thresh / 2
    momentum_state := 1
else if pressure_accel < -i_momentum_thresh / 2
    momentum_state := -1

// Multi-factor confluence score
int confluence_bull = 0
int confluence_bear = 0

if pressure_state >= 1
    confluence_bull += 1
if momentum_state == 1
    confluence_bull += 1
if wt_bullish and i_use_wt
    confluence_bull += 1
if energy_smooth > 10
    confluence_bull += 1

if pressure_state <= -1
    confluence_bear += 1
if momentum_state == -1
    confluence_bear += 1
if wt_bearish and i_use_wt
    confluence_bear += 1
if energy_smooth < -10
    confluence_bear += 1

// Confluence quality (0-100)
float confluence_quality = float(math.max(confluence_bull, confluence_bear)) / 4.0 * 100

//───────────────────────────────────────────────────────────────────────────────
// COMPOSITE SCORE
//───────────────────────────────────────────────────────────────────────────────

// Normalized composite pressure score (-100 to +100)
float composite_score = (pressure_smooth - 0.5) * 200

// Momentum-adjusted score
float momentum_adjustment = pressure_momentum * 100
var float adjusted_score = composite_score + momentum_adjustment * 0.3

// Clamp to range
adjusted_score := math.max(math.min(adjusted_score, 100), -100)

// WaveTrend integration into score
if i_use_wt
    float wt_contribution = wt_cross * 0.5
    adjusted_score := math.max(math.min(adjusted_score + wt_contribution, 100), -100)

//───────────────────────────────────────────────────────────────────────────────
// VISUALIZATION
//───────────────────────────────────────────────────────────────────────────────

// Enhanced multi-tier gradient color system with glowing gradients
f_gradient_color(float value, color pos_col, color pos_core, color pos_soft, color neg_col, color neg_core, color neg_soft, color neutral) =>
    if value >= 80
        pos_core
    else if value >= 60
        color.new(pos_col, math.round(10 - (value - 60) * 0.2))
    else if value >= 40
        color.new(pos_col, math.round(30 - (value - 40) * 0.4))
    else if value >= 20
        color.new(pos_soft, math.round(50 - (value - 20) * 0.3))
    else if value <= -80
        neg_core
    else if value <= -60
        color.new(neg_col, math.round(10 - (math.abs(value) - 60) * 0.2))
    else if value <= -40
        color.new(neg_col, math.round(30 - (math.abs(value) - 40) * 0.4))
    else if value <= -20
        color.new(neg_soft, math.round(50 - (math.abs(value) - 20) * 0.3))
    else
        neutral

// Multi-layer glow intensity
f_glow_intensity(float value) =>
    math.abs(value) > 70 ? 3 : math.abs(value) > 40 ? 2 : 1

// Main bar color with enhanced gradient
color bar_col = f_gradient_color(adjusted_score, i_buy_col, i_buy_core, i_buy_soft, i_sell_col, i_sell_core, i_sell_soft, i_neutral_col)

// Multi-layer glow effect with enhanced radiance
var color glow_col = na
var color glow_mid = na
var color glow_outer = na
if i_show_glow
    int intensity = f_glow_intensity(adjusted_score)
    if adjusted_score >= 40
        glow_col := color.new(i_buy_glow, math.round(60 - adjusted_score * 0.3))
        glow_mid := intensity >= 2 ? color.new(i_buy_soft, math.round(70 - adjusted_score * 0.2)) : na
        glow_outer := intensity >= 3 ? color.new(i_buy_col, math.round(80 - adjusted_score * 0.1)) : na
    else if adjusted_score <= -40
        glow_col := color.new(i_sell_glow, math.round(60 - math.abs(adjusted_score) * 0.3))
        glow_mid := intensity >= 2 ? color.new(i_sell_soft, math.round(70 - math.abs(adjusted_score) * 0.2)) : na
        glow_outer := intensity >= 3 ? color.new(i_sell_col, math.round(80 - math.abs(adjusted_score) * 0.1)) : na

// Multi-layer glow effects
plot(adjusted_score * 1.15, "Outer Glow", color=glow_outer, style=plot.style_columns, linewidth=8)
plot(adjusted_score * 1.1, "Mid Glow", color=glow_mid, style=plot.style_columns, linewidth=6)
plot(adjusted_score * 1.05, "Inner Glow", color=glow_col, style=plot.style_columns, linewidth=4)

// Main histogram with enhanced core
plot(adjusted_score, "Pressure Score", color=bar_col, style=plot.style_columns, linewidth=3)

// Institutional pressure labels with spacing
if i_show_labels and barstate.isconfirmed and math.abs(adjusted_score) >= 70
    // Only show label if previous bar didn't have extreme pressure
    bool prev_extreme = math.abs(adjusted_score[1]) >= 70
    if not prev_extreme
        string pressure_text = adjusted_score > 0 ? "EXTREME BUYING" : "EXTREME SELLING"
        color label_bg = adjusted_score > 0 ? color.new(i_buy_core, 85) : color.new(i_sell_core, 85)
        label.new(bar_index, adjusted_score + (adjusted_score > 0 ? 20 : -20), pressure_text, 
                  style=adjusted_score > 0 ? label.style_label_down : label.style_label_up,
                  color=label_bg, textcolor=color.new(#ffffff, 0), 
                  size=size.normal, yloc=yloc.price)

// Enhanced energy wave with glow
color energy_color = i_show_energy ? (energy_smooth > 0 ? color.new(i_energy_col, math.round(60 - math.min(math.abs(energy_smooth), 40))) : 
                         color.new(i_energy_col, math.round(60 - math.min(math.abs(energy_smooth), 40)))) : na
color energy_glow = i_show_energy ? color.new(i_energy_glow, math.round(80 - math.min(math.abs(energy_smooth), 30))) : na
plot(i_show_energy ? energy_smooth * 1.2 : na, "Energy Glow", color=energy_glow, style=plot.style_line, linewidth=6)
plot(i_show_energy ? energy_smooth : na, "Energy Wave", color=energy_color, style=plot.style_line, linewidth=2)

// Energy spike labels with better spacing
if i_show_labels and i_show_energy and math.abs(energy_smooth) > 30 and barstate.isconfirmed
    // Check if there was a recent energy spike
    bool recent_energy = math.abs(energy_smooth[1]) > 30
    bool recent_pressure = math.abs(adjusted_score) >= 70
    if not recent_energy and not recent_pressure
        string energy_text = "ENERGY: " + str.tostring(energy_smooth, "#.#")
        float y_pos = energy_smooth > 0 ? energy_smooth + 25 : energy_smooth - 25
        label.new(bar_index, y_pos, energy_text,
                  style=energy_smooth > 0 ? label.style_label_up : label.style_label_down,
                  color=color.new(i_energy_glow, 85), textcolor=color.new(#ffffff, 0),
                  size=size.small, yloc=yloc.price)

// Momentum line with enhanced gradient
color mom_color = pressure_momentum * 100 > 20 ? color.new(i_buy_col, 0) : 
                  pressure_momentum * 100 < -20 ? color.new(i_sell_col, 0) : i_momentum_col
plot(pressure_momentum * 100, "Momentum", color=mom_color, style=plot.style_line, linewidth=2)

// Momentum divergence labels with limited frequency
var int last_div_bar = 0
if i_show_labels and (bullish_divergence or bearish_divergence) and barstate.isconfirmed
    // Limit divergence labels to every 10 bars minimum
    bool bar_limit_reached = bar_index - last_div_bar >= 10
    
    // Check for other signals on this bar
    bool has_energy = math.abs(energy_smooth) > 30
    bool has_pressure = math.abs(adjusted_score) >= 70
    
    // Only show if conditions are met
    if not has_energy and not has_pressure and bar_limit_reached
        string div_text = bullish_divergence ? "BULL DIV" : "BEAR DIV"
        color div_bg = bullish_divergence ? color.new(i_buy_core, 85) : color.new(i_sell_core, 85)
        
        // Position on the momentum line itself
        float y_pos = pressure_momentum * 100
        
        label.new(bar_index, y_pos, div_text,
                  style=bullish_divergence ? label.style_label_left : label.style_label_right,
                  color=div_bg, textcolor=color.new(#ffffff, 0),
                  size=size.small, yloc=yloc.price)
        
        last_div_bar := bar_index

// Enhanced WaveTrend with gradient
color wt_color = i_use_wt ? (wt1 > wt2 ? color.new(i_buy_col, 60) : color.new(i_sell_col, 60)) : na
color wt_glow = i_use_wt ? (wt1 > wt2 ? color.new(i_buy_glow, 80) : color.new(i_sell_glow, 80)) : na
plot(i_use_wt ? wt1 / 2 : na, "WT1", color=wt_glow, style=plot.style_line, linewidth=4)
plot(i_use_wt ? wt1 / 2 : na, "WT1 Core", color=wt_color, style=plot.style_line, linewidth=1)
plot(i_use_wt ? wt2 / 2 : na, "WT2", color=color.new(#78909c, 70), style=plot.style_line, linewidth=1)

// Zero line
hline(0, "Zero", color=color.new(#37474f, 50), linestyle=hline.style_solid)

// Extreme zones with gradient fill
hline(50, "Upper Threshold", color=color.new(i_buy_col, 70), linestyle=hline.style_dotted)
hline(-50, "Lower Threshold", color=color.new(i_sell_col, 70), linestyle=hline.style_dotted)

hline(i_show_zones ? 80 : na, "Extreme Buy", color=color.new(i_buy_glow, 40), linestyle=hline.style_dashed)
hline(i_show_zones ? -80 : na, "Extreme Sell", color=color.new(i_sell_glow, 40), linestyle=hline.style_dashed)

// Intensity bands
hline(i_show_intensity ? 70 : na, "High Intensity", color=color.new(i_buy_soft, 85), linestyle=hline.style_solid)
hline(i_show_intensity ? -70 : na, "Low Intensity", color=color.new(i_sell_soft, 85), linestyle=hline.style_solid)
hline(i_show_intensity ? 30 : na, "Moderate Bull", color=color.new(i_buy_col, 92), linestyle=hline.style_solid)
hline(i_show_intensity ? -30 : na, "Moderate Bear", color=color.new(i_sell_col, 92), linestyle=hline.style_solid)

// Background gradient based on confluence
var color bg_col = na
if confluence_bull >= 3
    bg_col := color.new(i_buy_col, 94)
else if confluence_bear >= 3
    bg_col := color.new(i_sell_col, 94)
else if pressure_state == 2
    bg_col := color.new(i_buy_col, 96)
else if pressure_state == -2
    bg_col := color.new(i_sell_col, 96)
bgcolor(bg_col)

// Divergence markers with glow
plotshape(bullish_divergence and barstate.isconfirmed, "Bullish Div", shape.circle, location.bottom, 
          color=color.new(i_buy_glow, 20), size=size.tiny)
plotshape(bearish_divergence and barstate.isconfirmed, "Bearish Div", shape.circle, location.top, 
          color=color.new(i_sell_glow, 20), size=size.tiny)

// Confluence markers
plotshape(confluence_bull >= 3 and confluence_bull[1] < 3 and barstate.isconfirmed, "Bull Confluence", 
          shape.diamond, location.bottom, color=color.new(i_buy_col, 0), size=size.small, offset=-5)
plotshape(confluence_bear >= 3 and confluence_bear[1] < 3 and barstate.isconfirmed, "Bear Confluence", 
          shape.diamond, location.top, color=color.new(i_sell_col, 0), size=size.small, offset=5)

//───────────────────────────────────────────────────────────────────────────────
// DASHBOARD
//───────────────────────────────────────────────────────────────────────────────

if i_show_dash and barstate.islast
    var table dash = table.new(position.top_right, 3, 10, bgcolor=color.new(#000000, 95), 
                               border_width=1, border_color=color.new(#00dbff, 70), frame_width=1, frame_color=color.new(#00dbff, 50))
    
    // Header with high contrast
    table.merge_cells(dash, 0, 0, 2, 0)
    table.cell(dash, 0, 0, "MOMENTUM PRESSURE GAUGE", text_color=color.new(#ffffff, 0), 
               text_size=size.normal, bgcolor=color.new(#00dbff, 20))
    
    string state_text = switch pressure_state
        2 => "EXTREME BUY"
        1 => "BUYING"
        -1 => "SELLING"
        -2 => "EXTREME SELL"
        => "NEUTRAL"
    
    string mom_text = momentum_state == 1 ? "ACCELERATING" : 
                      momentum_state == -1 ? "DECELERATING" : "STEADY"
    
    color state_col = pressure_state > 0 ? i_buy_col : 
                      pressure_state < 0 ? i_sell_col : i_neutral_col
    
    // Enhanced pressure row with intensity indicator
    string intensity_bar = ""
    for i = 1 to math.abs(math.round(adjusted_score / 20))
        intensity_bar := intensity_bar + "■"
    
    table.cell(dash, 0, 1, "PRESSURE", text_color=color.new(#ffffff, 0), text_size=size.small, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 1, 1, state_text, text_color=color.new(#000000, 0), text_size=size.small, bgcolor=color.new(state_col, 30))
    table.cell(dash, 2, 1, intensity_bar, text_color=state_col, text_size=size.tiny, bgcolor=color.new(#000000, 80))
    
    table.cell(dash, 0, 2, "MOMENTUM", text_color=color.new(#ffffff, 0), text_size=size.small, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 1, 2, mom_text, text_color=color.new(#000000, 0), text_size=size.small, bgcolor=color.new(i_momentum_col, 30))
    table.cell(dash, 2, 2, str.tostring(pressure_momentum * 100, "+#.#;-#.#"), text_color=color.new(#ffffff, 0), text_size=size.tiny, bgcolor=color.new(#000000, 80))
    
    // Score with color-coded background
    table.cell(dash, 0, 3, "SCORE", text_color=color.new(#ffffff, 0), text_size=size.small, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 1, 3, str.tostring(adjusted_score, "+#.#;-#.#"), text_color=color.new(#000000, 0), text_size=size.small, bgcolor=color.new(state_col, 30))
    table.cell(dash, 2, 3, adjusted_score > 0 ? "UP" : adjusted_score < 0 ? "DOWN" : "NEUTRAL", text_color=color.new(#ffffff, 0), text_size=size.tiny, bgcolor=color.new(#000000, 80))
    
    // Volume analysis
    table.cell(dash, 0, 4, "VOL WEIGHT", text_color=color.new(#ffffff, 0), text_size=size.small, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 1, 4, str.tostring(vol_weight * 100, "#") + "%", text_color=color.new(#000000, 0), text_size=size.small, bgcolor=color.new(#ffa726, 30))
    table.cell(dash, 2, 4, vol_ratio > 2 ? "HIGH" : vol_ratio > 1.5 ? "MED" : "LOW", text_color=color.new(#ffffff, 0), text_size=size.tiny, bgcolor=color.new(#000000, 80))
    
    // Divergence with alert indicator
    string div_text = bullish_divergence ? "BULLISH" : bearish_divergence ? "BEARISH" : "NONE"
    color div_col = bullish_divergence ? i_buy_col : bearish_divergence ? i_sell_col : i_neutral_col
    table.cell(dash, 0, 5, "DIVERGENCE", text_color=color.new(#ffffff, 0), text_size=size.small, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 1, 5, div_text, text_color=color.new(#000000, 0), text_size=size.small, bgcolor=color.new(div_col, 30))
    table.cell(dash, 2, 5, (bullish_divergence or bearish_divergence) ? "ALERT" : "OK", text_color=color.new(#ffffff, 0), text_size=size.tiny, bgcolor=color.new(#000000, 80))
    
    // Energy with trend indicator
    table.cell(dash, 0, 6, "ENERGY", text_color=color.new(#ffffff, 0), text_size=size.small, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 1, 6, str.tostring(energy_smooth, "+#.#;-#.#"), text_color=color.new(#000000, 0), text_size=size.small, bgcolor=color.new(i_energy_col, 30))
    table.cell(dash, 2, 6, energy_smooth > 20 ? "HIGH" : energy_smooth < -20 ? "LOW" : "NEUTRAL", text_color=color.new(#ffffff, 0), text_size=size.tiny, bgcolor=color.new(#000000, 80))
    
    // Confluence score
    string conf_text = confluence_bull >= 3 ? "BULL " + str.tostring(confluence_bull) + "/4" :
                       confluence_bear >= 3 ? "BEAR " + str.tostring(confluence_bear) + "/4" : "---"
    color conf_col = confluence_bull >= 3 ? i_buy_col : confluence_bear >= 3 ? i_sell_col : i_neutral_col
    table.cell(dash, 0, 7, "CONFLUENCE", text_color=color.new(#ffffff, 0), text_size=size.small, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 1, 7, conf_text, text_color=color.new(#000000, 0), text_size=size.small, bgcolor=color.new(conf_col, 30))
    table.cell(dash, 2, 7, confluence_quality > 75 ? "STRONG" : confluence_quality > 50 ? "GOOD" : "WEAK", text_color=color.new(#ffffff, 0), text_size=size.tiny, bgcolor=color.new(#000000, 80))
    
    // WaveTrend status
    string wt_status = i_use_wt ? (wt_bullish ? "BULLISH" : wt_bearish ? "BEARISH" : "NEUTRAL") : "OFF"
    color wt_col = i_use_wt ? (wt_bullish ? i_buy_col : wt_bearish ? i_sell_col : i_neutral_col) : color.new(#78909c, 0)
    table.cell(dash, 0, 8, "WAVETREND", text_color=color.new(#ffffff, 0), text_size=size.small, bgcolor=color.new(#1a1f2e, 80))
    table.cell(dash, 1, 8, wt_status, text_color=color.new(#000000, 0), text_size=size.small, bgcolor=color.new(wt_col, 30))
    table.cell(dash, 2, 8, i_use_wt ? "ON" : "OFF", text_color=color.new(#ffffff, 0), text_size=size.tiny, bgcolor=color.new(#000000, 80))
    
    // Overall signal strength
    string signal_strength = confluence_quality >= 75 ? "STRONG" : confluence_quality >= 50 ? "MODERATE" : "WEAK"
    color signal_col = confluence_quality >= 75 ? color.new(#00dbff, 0) : confluence_quality >= 50 ? color.new(#ffa726, 0) : color.new(#78909c, 0)
    table.merge_cells(dash, 0, 9, 2, 9)
    table.cell(dash, 0, 9, "SIGNAL: " + signal_strength, text_color=color.new(#000000, 0), 
               text_size=size.normal, bgcolor=color.new(signal_col, 25))
    

//───────────────────────────────────────────────────────────────────────────────
// EXPORT PLOTS (for strategy integration)
//───────────────────────────────────────────────────────────────────────────────

plot(pressure_smooth, "Pressure Ratio Export", display=display.none)
plot(adjusted_score, "Composite Score Export", display=display.none)
plot(float(pressure_state), "Pressure State Export", display=display.none)
plot(float(momentum_state), "Momentum State Export", display=display.none)
plot(vw_pressure, "Volume Weighted Pressure Export", display=display.none)
plot(bullish_divergence ? 1 : bearish_divergence ? -1 : 0, "Divergence Export", display=display.none)
plot(energy_smooth, "Energy Export", display=display.none)
plot(confluence_quality, "Confluence Quality Export", display=display.none)
plot(float(confluence_bull), "Confluence Bull Export", display=display.none)
plot(float(confluence_bear), "Confluence Bear Export", display=display.none)
plot(wt1, "WaveTrend1 Export", display=display.none)
plot(wt_cross, "WaveTrend Cross Export", display=display.none)

//───────────────────────────────────────────────────────────────────────────────
// ALERTS
//───────────────────────────────────────────────────────────────────────────────

alertcondition(pressure_state == 2 and pressure_state[1] != 2, "Extreme Buying", "Extreme buying pressure detected")
alertcondition(pressure_state == -2 and pressure_state[1] != -2, "Extreme Selling", "Extreme selling pressure detected")
alertcondition(ta.cross(adjusted_score, 0.0), "Pressure Cross Zero", "Pressure crossed zero line")
alertcondition(bullish_divergence, "Bullish Divergence", "Bullish pressure divergence detected")
alertcondition(bearish_divergence, "Bearish Divergence", "Bearish pressure divergence detected")
