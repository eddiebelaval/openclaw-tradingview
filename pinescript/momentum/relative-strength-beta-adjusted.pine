//@version=6
indicator('Relative Strength Beta-Adjusted', overlay = false)

// ─── Core Inputs ───
benchmarkSymbol = input.symbol('SPY', 'Benchmark Symbol')
betaLength = input.int(60, 'Beta Calculation Length', minval = 10)
maType = input.string('EMA', 'MA Type', options = ['EMA', 'SMA'], group = 'Moving Average')
maLength = input.int(21, 'MA Length', minval = 2, group = 'Moving Average')

// ─── RS Line Color Inputs ───
useRSColoring = input.bool(true, 'Color RS Line by MA Position', group = 'RS Line Style')
rsAboveColor = input.color(#2962ff, 'RS Above MA Color', group = 'RS Line Style')
rsBelowColor = input.color(#f23645, 'RS Below MA Color', group = 'RS Line Style')
rsDefaultColor = input.color(#ffffff, 'RS Default Color (when coloring off)', group = 'RS Line Style')

// ─── MA Line Inputs ───
maLineColor = input.color(#ff9800, 'MA Color', group = 'Moving Average')

// ─── Fill Inputs ───
useFill = input.bool(true, 'Show Fill Between Lines', group = 'Fill Style')
fillAboveColor = input.color(#081433, 'Fill Above Color', group = 'Fill Style')
fillBelowColor = input.color(#300B0E, 'Fill Below Color', group = 'Fill Style')

// ─── Fetch Benchmark Data ───
benchClose = request.security(benchmarkSymbol, timeframe.period, close)

// ─── 1-Bar Percentage Returns ───
symReturn = (close - close[1]) / close[1]
benchReturn = (benchClose - benchClose[1]) / benchClose[1]

// ─── Rolling Beta ───
correlation = ta.correlation(symReturn, benchReturn, betaLength)
symStdev = ta.stdev(symReturn, betaLength)
benchStdev = ta.stdev(benchReturn, betaLength)
beta = correlation * (symStdev / benchStdev)

// ─── Idiosyncratic (True RS) Return ───
expectedReturn = beta * benchReturn
idiosyncraticReturn = symReturn - expectedReturn

// ─── Cumulative Index Line (na-safe) ───
var float cumulativeRS = 100.0
if not na(idiosyncraticReturn)
    cumulativeRS := cumulativeRS + idiosyncraticReturn * 100
    cumulativeRS

// ─── MA of Cumulative Line ───
maLine = maType == 'EMA' ? ta.ema(cumulativeRS, maLength) : ta.sma(cumulativeRS, maLength)

// ─── RS Line Color Logic ───
bool isAbove = cumulativeRS >= maLine
rsColor = useRSColoring ? isAbove ? rsAboveColor : rsBelowColor : rsDefaultColor

// ─── Plots ───
rsPlot = plot(cumulativeRS, 'True RS', color = rsColor, linewidth = 2)
maPlot = plot(maLine, 'MA', color = maLineColor, linewidth = 1)

// ─── Conditional Fill ───
fillColor = useFill ? isAbove ? fillAboveColor : fillBelowColor : color.new(color.white, 100)
fill(rsPlot, maPlot, color = fillColor)
