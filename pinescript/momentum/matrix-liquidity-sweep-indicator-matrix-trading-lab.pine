//@version=5
indicator("Matrix Liquidity Sweep Indicator — GÖKTUĞ ÖZIŞIK | Matrix Trading Lab", shorttitle="Matrix Sweep | GÖKTUĞ", overlay=true, max_lines_count=300, max_labels_count=300)

//══════════════════════════════════════════════════════════════════════════════
// INPUTS
//══════════════════════════════════════════════════════════════════════════════
groupCore  = "1. Core Settings"
groupSweep = "2. Sweep Engine"
groupDash  = "3. Dashboard"
groupAlrt  = "4. Alerts"

swingLen       = input.int(20, "Swing Length", minval=3, maxval=100, group=groupCore)
eqThresholdATR = input.float(0.10, "Equal High / Low Threshold ATR", step=0.01, minval=0.01, maxval=1.0, group=groupCore)
showEQH        = input.bool(true, "Show Equal Highs", group=groupCore)
showEQL        = input.bool(true, "Show Equal Lows", group=groupCore)
showLevels     = input.bool(true, "Show Liquidity Levels", group=groupCore)

sweepMode = input.string("Wick Reclaim", "Sweep Confirmation", options=["Wick Reclaim", "Close Back Inside"], group=groupSweep)
keepSweptLevels = input.bool(true, "Keep Swept Levels Visible", group=groupSweep)
showSweepLabels = input.bool(true, "Show Sweep Labels", group=groupSweep)

showDashboard = input.bool(true, "Show Dashboard", group=groupDash)
dashboardPos  = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=groupDash)

enableEQAlerts    = input.bool(true, "Enable EQH / EQL Alerts", group=groupAlrt)
enableSweepAlerts = input.bool(true, "Enable Sweep Alerts", group=groupAlrt)

//══════════════════════════════════════════════════════════════════════════════
// COLORS
//══════════════════════════════════════════════════════════════════════════════
bullColor    = #10b981
bearColor    = #ef4444
liqHighColor = #f59e0b
liqLowColor  = #3b82f6
neutralColor = #9ca3af
panelBg      = color.new(color.black, 15)

//══════════════════════════════════════════════════════════════════════════════
// HELPERS
//══════════════════════════════════════════════════════════════════════════════
BULL = 1
BEAR = -1
NEUTRAL = 0

f_dash_pos(_pos) =>
    _pos == "Top Left" ? position.top_left : _pos == "Bottom Right" ? position.bottom_right : _pos == "Bottom Left" ? position.bottom_left : position.top_right

f_bias_text(_bias) =>
    _bias == BULL ? "Bullish" : _bias == BEAR ? "Bearish" : "Neutral"

f_bias_color(_bias) =>
    _bias == BULL ? bullColor : _bias == BEAR ? bearColor : neutralColor

//══════════════════════════════════════════════════════════════════════════════
// CORE DATA
//══════════════════════════════════════════════════════════════════════════════
atr = ta.atr(14)

pivotHigh = ta.pivothigh(high, swingLen, swingLen)
pivotLow  = ta.pivotlow(low, swingLen, swingLen)

//══════════════════════════════════════════════════════════════════════════════
// STATE
//══════════════════════════════════════════════════════════════════════════════
var float prevPivotHigh = na
var int   prevPivotHighBar = na
var float lastPivotHigh = na
var int   lastPivotHighBar = na

var float prevPivotLow = na
var int   prevPivotLowBar = na
var float lastPivotLow = na
var int   lastPivotLowBar = na

var float activeEQH = na
var int   activeEQHBar = na
var line  activeEQHLine = na
var label activeEQHLabel = na
var bool  activeEQHSwept = false

var float activeEQL = na
var int   activeEQLBar = na
var line  activeEQLLine = na
var label activeEQLLabel = na
var bool  activeEQLSwept = false

var int bias = NEUTRAL
var string lastEvent = "None"

var bool alertEQH = false
var bool alertEQL = false
var bool alertBSL = false
var bool alertSSL = false

alertEQH := false
alertEQL := false
alertBSL := false
alertSSL := false

//══════════════════════════════════════════════════════════════════════════════
// STORE PIVOTS
//══════════════════════════════════════════════════════════════════════════════
if not na(pivotHigh)
    prevPivotHigh := lastPivotHigh
    prevPivotHighBar := lastPivotHighBar
    lastPivotHigh := pivotHigh
    lastPivotHighBar := bar_index - swingLen

    if showEQH and not na(prevPivotHigh) and math.abs(lastPivotHigh - prevPivotHigh) <= atr * eqThresholdATR
        activeEQH := math.max(lastPivotHigh, prevPivotHigh)
        activeEQHBar := lastPivotHighBar
        activeEQHSwept := false

        if not na(activeEQHLine)
            line.delete(activeEQHLine)
        if not na(activeEQHLabel)
            label.delete(activeEQHLabel)

        if showLevels
            activeEQHLine := line.new(prevPivotHighBar, activeEQH, bar_index, activeEQH, xloc=xloc.bar_index, extend=extend.right, color=liqHighColor, style=line.style_dotted, width=1)
        activeEQHLabel := label.new(math.round((prevPivotHighBar + lastPivotHighBar) * 0.5), activeEQH, "EQH", xloc=xloc.bar_index, style=label.style_label_down, textcolor=liqHighColor, color=color.new(color.black, 100), size=size.tiny)

        alertEQH := true
        lastEvent := "Equal Highs Detected"

if not na(pivotLow)
    prevPivotLow := lastPivotLow
    prevPivotLowBar := lastPivotLowBar
    lastPivotLow := pivotLow
    lastPivotLowBar := bar_index - swingLen

    if showEQL and not na(prevPivotLow) and math.abs(lastPivotLow - prevPivotLow) <= atr * eqThresholdATR
        activeEQL := math.min(lastPivotLow, prevPivotLow)
        activeEQLBar := lastPivotLowBar
        activeEQLSwept := false

        if not na(activeEQLLine)
            line.delete(activeEQLLine)
        if not na(activeEQLLabel)
            label.delete(activeEQLLabel)

        if showLevels
            activeEQLLine := line.new(prevPivotLowBar, activeEQL, bar_index, activeEQL, xloc=xloc.bar_index, extend=extend.right, color=liqLowColor, style=line.style_dotted, width=1)
        activeEQLLabel := label.new(math.round((prevPivotLowBar + lastPivotLowBar) * 0.5), activeEQL, "EQL", xloc=xloc.bar_index, style=label.style_label_up, textcolor=liqLowColor, color=color.new(color.black, 100), size=size.tiny)

        alertEQL := true
        lastEvent := "Equal Lows Detected"

//══════════════════════════════════════════════════════════════════════════════
// BIAS
//══════════════════════════════════════════════════════════════════════════════
if not na(lastPivotHigh) and close > lastPivotHigh
    bias := BULL
if not na(lastPivotLow) and close < lastPivotLow
    bias := BEAR

//══════════════════════════════════════════════════════════════════════════════
// SWEEP DETECTION
//══════════════════════════════════════════════════════════════════════════════
bool buySideSweep = false
bool sellSideSweep = false

if not na(activeEQH) and not activeEQHSwept
    buySideSweep := sweepMode == "Wick Reclaim" ? (high > activeEQH and close < activeEQH) : (high > activeEQH and close <= activeEQH)
    if buySideSweep
        activeEQHSwept := true
        if showSweepLabels
            label.new(bar_index, high, "BSL Sweep", xloc=xloc.bar_index, style=label.style_label_down, textcolor=bearColor, color=color.new(color.black, 100), size=size.small)
        if not keepSweptLevels
            if not na(activeEQHLine)
                line.delete(activeEQHLine)
                activeEQHLine := na
            if not na(activeEQHLabel)
                label.delete(activeEQHLabel)
                activeEQHLabel := na
            activeEQH := na
            activeEQHBar := na
        else
            if not na(activeEQHLine)
                line.set_color(activeEQHLine, color.new(liqHighColor, 70))
            if not na(activeEQHLabel)
                label.set_text(activeEQHLabel, "EQH Swept")
        alertBSL := true
        lastEvent := "Buy-Side Liquidity Sweep"

if not na(activeEQL) and not activeEQLSwept
    sellSideSweep := sweepMode == "Wick Reclaim" ? (low < activeEQL and close > activeEQL) : (low < activeEQL and close >= activeEQL)
    if sellSideSweep
        activeEQLSwept := true
        if showSweepLabels
            label.new(bar_index, low, "SSL Sweep", xloc=xloc.bar_index, style=label.style_label_up, textcolor=bullColor, color=color.new(color.black, 100), size=size.small)
        if not keepSweptLevels
            if not na(activeEQLLine)
                line.delete(activeEQLLine)
                activeEQLLine := na
            if not na(activeEQLLabel)
                label.delete(activeEQLLabel)
                activeEQLLabel := na
            activeEQL := na
            activeEQLBar := na
        else
            if not na(activeEQLLine)
                line.set_color(activeEQLLine, color.new(liqLowColor, 70))
            if not na(activeEQLLabel)
                label.set_text(activeEQLLabel, "EQL Swept")
        alertSSL := true
        lastEvent := "Sell-Side Liquidity Sweep"

// Extend active lines
if not na(activeEQHLine)
    line.set_x2(activeEQHLine, bar_index + 1)
if not na(activeEQLLine)
    line.set_x2(activeEQLLine, bar_index + 1)

//══════════════════════════════════════════════════════════════════════════════
// DASHBOARD
//══════════════════════════════════════════════════════════════════════════════
var table dash = table.new(position.top_right, 2, 7, border_width=1)

if barstate.islast
    table.set_position(dash, f_dash_pos(dashboardPos))

    if showDashboard
        string eqhState = na(activeEQH) ? "None" : activeEQHSwept ? "Swept" : "Active"
        string eqlState = na(activeEQL) ? "None" : activeEQLSwept ? "Swept" : "Active"
        string eqhText = na(activeEQH) ? "N/A" : str.tostring(activeEQH, format.mintick)
        string eqlText = na(activeEQL) ? "N/A" : str.tostring(activeEQL, format.mintick)

        table.cell(dash, 0, 0, "Matrix Trading Lab", text_color=color.white, bgcolor=color.new(color.black, 0))
        table.cell(dash, 1, 0, "Liquidity Sweep", text_color=color.white, bgcolor=color.new(color.black, 0))

        table.cell(dash, 0, 1, "Bias", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 1, f_bias_text(bias), text_color=f_bias_color(bias), bgcolor=panelBg)

        table.cell(dash, 0, 2, "EQH State", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 2, eqhState, text_color=na(activeEQH) ? neutralColor : activeEQHSwept ? bearColor : liqHighColor, bgcolor=panelBg)

        table.cell(dash, 0, 3, "EQL State", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 3, eqlState, text_color=na(activeEQL) ? neutralColor : activeEQLSwept ? bullColor : liqLowColor, bgcolor=panelBg)

        table.cell(dash, 0, 4, "EQH Level", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 4, eqhText, text_color=liqHighColor, bgcolor=panelBg)

        table.cell(dash, 0, 5, "EQL Level", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 5, eqlText, text_color=liqLowColor, bgcolor=panelBg)

        table.cell(dash, 0, 6, "Last Event", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 6, lastEvent, text_color=color.white, bgcolor=panelBg)
    else
        for r = 0 to 6
            table.cell(dash, 0, r, "", bgcolor=color.new(color.black, 100))
            table.cell(dash, 1, r, "", bgcolor=color.new(color.black, 100))

//══════════════════════════════════════════════════════════════════════════════
// ALERTS
//══════════════════════════════════════════════════════════════════════════════
alertcondition(enableEQAlerts and alertEQH, "Equal Highs Detected", "Matrix Liquidity Sweep Indicator: Equal highs detected")
alertcondition(enableEQAlerts and alertEQL, "Equal Lows Detected", "Matrix Liquidity Sweep Indicator: Equal lows detected")

alertcondition(enableSweepAlerts and alertBSL, "Buy-Side Liquidity Sweep", "Matrix Liquidity Sweep Indicator: Buy-side liquidity sweep detected")
alertcondition(enableSweepAlerts and alertSSL, "Sell-Side Liquidity Sweep", "Matrix Liquidity Sweep Indicator: Sell-side liquidity sweep detected")
