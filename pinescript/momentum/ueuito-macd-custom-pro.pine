// indicators/macd_full_pro.pine
//@version=5
indicator("MACD Custom PRO", overlay=false)

//--------------------------------------------------
// MACD PARAMETERS
//--------------------------------------------------
fastLength = input.int(12, "Fast EMA")
slowLength = input.int(26, "Slow EMA")
signalLength = input.int(9, "Signal Length")

//--------------------------------------------------
// ATR FILTER
//--------------------------------------------------
useATR = input.bool(true, "Use ATR Filter")
atrLength = input.int(14, "ATR Length")
atrMultiplier = input.float(1.0, "ATR Threshold Multiplier")

//--------------------------------------------------
// ZERO LINE FILTER
//--------------------------------------------------
useZeroFilter = input.bool(false, "Use Zero Line Filter")

//--------------------------------------------------
// TREND FILTER
//--------------------------------------------------
useTrendFilter = input.bool(false, "Use Trend Filter")
trendLength = input.int(200, "Trend EMA Length")

//--------------------------------------------------
// HISTOGRAM MA
//--------------------------------------------------
useHistMA = input.bool(true, "Enable Histogram MA")
histMALength = input.int(9, "Histogram MA Length")
histMAType = input.string("EMA","Histogram MA Type", options=["EMA","SMA","WMA","RMA"])

histMAAboveColor = input.color(color.yellow, "MA Color Above")
histMABelowColor = input.color(color.purple, "MA Color Below")
histMAWidth = input.int(2, "Histogram MA Width")

// Histogram color modes
useHistMAColors = input.bool(false, "Histogram Use MA Colors")
useMomentumColors = input.bool(false, "Histogram Momentum Mode")

//--------------------------------------------------
// HISTOGRAM CLASSIC COLORS
//--------------------------------------------------
histAboveUp = input.color(color.lime, "Above 0 Rising")
histAboveDown = input.color(color.green, "Above 0 Falling")
histBelowUp = input.color(color.orange, "Below 0 Rising")
histBelowDown = input.color(color.red, "Below 0 Falling")

//--------------------------------------------------
// MOMENTUM COLORS
//--------------------------------------------------
momAboveUp = input.color(color.lime, "MA Above Rising")
momAboveDown = input.color(color.green, "MA Above Falling")
momBelowUp = input.color(color.orange, "MA Below Rising")
momBelowDown = input.color(color.red, "MA Below Falling")

//--------------------------------------------------
// LINE COLORS
//--------------------------------------------------
lineUpColor = input.color(color.aqua, "Line Rising")
lineDownColor = input.color(color.blue, "Line Falling")

//--------------------------------------------------
// CROSS SETTINGS
//--------------------------------------------------
showCross = input.bool(true, "Show Cross Marker")
crossColor = input.color(color.white, "Cross Color")

shapeOpt = input.string("Circle","Shape",options=["Circle","Triangle Up","Triangle Down","Diamond","Square"])

shapeStyle =
     shapeOpt == "Circle" ? shape.circle :
     shapeOpt == "Triangle Up" ? shape.triangleup :
     shapeOpt == "Triangle Down" ? shape.triangledown :
     shapeOpt == "Diamond" ? shape.diamond :
     shape.square

//--------------------------------------------------
// BACKGROUND TREND
//--------------------------------------------------
useBgTrend = input.bool(false, "Enable Trend Background")

//--------------------------------------------------
// MACD CALCULATION
//--------------------------------------------------
fastEMA = ta.ema(close, fastLength)
slowEMA = ta.ema(close, slowLength)

macdLine = fastEMA - slowEMA
signalLine = ta.ema(macdLine, signalLength)
hist = macdLine - signalLine

//--------------------------------------------------
// TREND EMA
//--------------------------------------------------
trendEMA = ta.ema(close, trendLength)

//--------------------------------------------------
// HISTOGRAM MA
//--------------------------------------------------
histMA =
     histMAType == "EMA" ? ta.ema(hist, histMALength) :
     histMAType == "SMA" ? ta.sma(hist, histMALength) :
     histMAType == "WMA" ? ta.wma(hist, histMALength) :
     ta.rma(hist, histMALength)

//--------------------------------------------------
// ATR
//--------------------------------------------------
atr = ta.atr(atrLength)
atrFilter = atr > ta.sma(atr, atrLength) * atrMultiplier

//--------------------------------------------------
// DIRECTION
//--------------------------------------------------
histRising = hist > hist[1]
macdRising = macdLine > macdLine[1]
signalRising = signalLine > signalLine[1]

//--------------------------------------------------
// HISTOGRAM COLOR LOGIC
//--------------------------------------------------

// Classic MACD
histColorClassic =
     hist >= 0 and histRising ? histAboveUp :
     hist >= 0 and not histRising ? histAboveDown :
     hist < 0 and histRising ? histBelowUp :
     histBelowDown

// MA based colors
histColorMA =
     hist >= histMA ? histMAAboveColor :
     histMABelowColor

// Momentum colors
histColorMomentum =
     hist >= histMA and histRising ? momAboveUp :
     hist >= histMA and not histRising ? momAboveDown :
     hist < histMA and histRising ? momBelowUp :
     momBelowDown

histColor =
     useMomentumColors and useHistMA ? histColorMomentum :
     useHistMAColors and useHistMA ? histColorMA :
     histColorClassic

//--------------------------------------------------
// LINE COLORS
//--------------------------------------------------
macdColor = macdRising ? lineUpColor : lineDownColor
signalColor = signalRising ? lineUpColor : lineDownColor

//--------------------------------------------------
// CROSS DETECTION
//--------------------------------------------------
bullCross = ta.crossover(macdLine, signalLine)
bearCross = ta.crossunder(macdLine, signalLine)

//--------------------------------------------------
// HISTOGRAM MA CROSS
//--------------------------------------------------
histBullCross = ta.crossover(hist, histMA)
histBearCross = ta.crossunder(hist, histMA)

//--------------------------------------------------
// FILTERS
//--------------------------------------------------
zeroBull = not useZeroFilter or macdLine > 0
zeroBear = not useZeroFilter or macdLine < 0

trendBull = not useTrendFilter or close > trendEMA
trendBear = not useTrendFilter or close < trendEMA

atrOk = not useATR or atrFilter

validBull = bullCross and zeroBull and trendBull and atrOk
validBear = bearCross and zeroBear and trendBear and atrOk

//--------------------------------------------------
// BACKGROUND TREND
//--------------------------------------------------
bgBull = macdLine > signalLine and hist > histMA
bgBear = macdLine < signalLine and hist < histMA

bgcolor(useBgTrend and bgBull ? color.new(color.green,85) : na)
bgcolor(useBgTrend and bgBear ? color.new(color.red,85) : na)

//--------------------------------------------------
// HIST MA COLOR
//--------------------------------------------------
histMAColor = hist >= histMA ? histMAAboveColor : histMABelowColor

//--------------------------------------------------
// PLOTS
//--------------------------------------------------
plot(hist,"Histogram",style=plot.style_histogram,color=histColor,linewidth=3)

plot(macdLine,"MACD",color=macdColor,linewidth=2)
plot(signalLine,"Signal",color=signalColor,linewidth=2)

plot(useHistMA ? histMA : na,"Histogram MA",color=histMAColor,linewidth=histMAWidth)

hline(0,"Zero Line",color=color.gray)

//--------------------------------------------------
// CROSS MARKERS
//--------------------------------------------------
plotshape(showCross and validBull ? macdLine : na,
     style=shapeStyle,
     size=size.tiny,
     color=crossColor,
     location=location.absolute)

plotshape(showCross and validBear ? macdLine : na,
     style=shapeStyle,
     size=size.tiny,
     color=crossColor,
     location=location.absolute)

//--------------------------------------------------
// ALERTS
//--------------------------------------------------
alertcondition(validBull,"MACD Bullish Cross","MACD bullish cross")
alertcondition(validBear,"MACD Bearish Cross","MACD bearish cross")

alertcondition(histBullCross,"Histogram MA Bullish","Histogram crossed above MA")
alertcondition(histBearCross,"Histogram MA Bearish","Histogram crossed below MA")
