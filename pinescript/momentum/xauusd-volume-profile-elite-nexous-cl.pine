//@version=6
// © NEXOUS_cl
indicator("XAUUSD Volume Profile Elite - NEXOUS_cl", shorttitle="XAU_Volume_Elite", overlay=true, max_labels_count=500)

// --- ⚙️ SETTINGS & CUSTOMIZATION ---
tablePos    = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group="Dashboard Layout")
textSize    = input.string("tiny", "Text Size", options=["tiny", "small", "normal", "large"], group="Dashboard Layout")
alertLevel  = input.int(60, "Signal Threshold %", minval=50, maxval=90, group="Signals")

// Χρώματα Υψηλής Αντίθεσης
bullColor   = #00ff00 // Neon Green
bearColor   = #ff0000 // Pure Red
headerBg    = #1a1a1a // Deep Charcoal

// Μετατροπή επιλογής θέσης
get_pos(p) =>
    p == "Top Right" ? position.top_right : 
     p == "Top Left" ? position.top_left : 
     p == "Bottom Right" ? position.bottom_right : 
     p == "Bottom Left" ? position.bottom_left : position.middle_right

// --- 📊 1. LOWER TIMEFRAME DATA (1-min) ---
[ltfH, ltfL, ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, "1", [high, low, close, volume])

f_calcVolume(highs, lows, closes, volumes) =>
    float buyV = 0.0, float sellV = 0.0
    if array.size(volumes) > 0
        for i = 0 to array.size(volumes) - 1
            h = array.get(highs, i), l = array.get(lows, i), c = array.get(closes, i), v = array.get(volumes, i)
            // ΔΙΟΡΘΩΣΗ BUG: Αλλαγή ονόματος από 'range' σε 'p_range'
            p_range = math.max(h - l, syminfo.mintick)
            buyPct = (c - l) / p_range
            buyV += (v * buyPct), sellV += (v * (1 - buyPct))
    [buyV, sellV]

[currBuy, currSell] = f_calcVolume(ltfH, ltfL, ltfC, ltfV)
currTotal = currBuy + currSell
currDelta = currBuy - currSell
currBuyPct = (currBuy / math.max(currTotal, 1)) * 100

// --- 🛡️ 2. PREVIOUS DATA & SIGNALS ---
var float prevTotal = 0.0
if barstate.isconfirmed
    prevTotal := currTotal

string signal = "WAIT"
color sigCol = color.new(color.gray, 50)
if currDelta > 0 and currBuyPct > alertLevel
    signal := "STRONG BUY", sigCol := color.new(bullColor, 20)
else if currDelta < 0 and (100 - currBuyPct) > alertLevel
    signal := "STRONG SELL", sigCol := color.new(bearColor, 20)

// Progress Bar Logic (ASCII)
f_progress(pct) =>
    str = ""
    filled = math.round(pct / 10)
    for i = 1 to 10
        str := str + (i <= filled ? "█" : "░")
    str

// --- 🖥️ 3. COMPACT DASHBOARD (Fixed Version) ---
var table ptsTable = table.new(get_pos(tablePos), 11, 2, bgcolor=color.new(color.black, 15), border_color=color.new(color.gray, 50), border_width=1)

if barstate.islast
    headers = array.from("PERIOD", "RANGE", "TOTAL VOL", "BUY VOL", "SELL VOL", "DELTA", "BUY %", "SELL %", "POC", "PROGRESS", "SIGNAL")
    for i = 0 to 10
        table.cell(ptsTable, i, 0, array.get(headers, i), text_color=color.white, bgcolor=headerBg, text_size=textSize)
    
    table.cell(ptsTable, 0, 1, "XAU " + (close > open ? "↑" : "↓"), text_color=color.white, text_size=textSize)
    table.cell(ptsTable, 1, 1, str.tostring(low, "#.#") + "-" + str.tostring(high, "#.#"), text_color=color.gray, text_size=textSize)
    table.cell(ptsTable, 2, 1, str.tostring(currTotal, "format.volume"), text_color=color.white, text_size=textSize)
    table.cell(ptsTable, 3, 1, str.tostring(currBuy, "format.volume"), text_color=bullColor, text_size=textSize)
    table.cell(ptsTable, 4, 1, str.tostring(currSell, "format.volume"), text_color=bearColor, text_size=textSize)
    table.cell(ptsTable, 5, 1, str.tostring(currDelta, "format.volume"), text_color=currDelta > 0 ? bullColor : bearColor, text_size=textSize)
    table.cell(ptsTable, 6, 1, str.tostring(currBuyPct, "#.#") + "%", text_color=bullColor, text_size=textSize)
    table.cell(ptsTable, 7, 1, str.tostring(100 - currBuyPct, "#.#") + "%", text_color=bearColor, text_size=textSize)
    table.cell(ptsTable, 8, 1, str.tostring((high+low+close)/3, "#.##"), text_color=color.yellow, text_size=textSize)
    table.cell(ptsTable, 9, 1, f_progress(currBuyPct), text_color=bullColor, text_size=textSize)
    table.cell(ptsTable, 10, 1, signal, bgcolor=sigCol, text_color=color.white, text_size=textSize)

// --- 🔔 4. ALERTS ---
alertcondition(signal == "STRONG BUY", "Gold Strong Buy", "NEXOUS XAU: Institutional Buying Pressure!")
alertcondition(signal == "STRONG SELL", "Gold Strong Sell", "NEXOUS XAU: Institutional Selling Pressure!")
