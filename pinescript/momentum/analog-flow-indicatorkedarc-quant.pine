//@version=6
indicator("Analog Flow [KedArc Quant]", overlay=true, max_bars_back=5000, max_lines_count=400)

// ---------- inputs
winLen     = input.int(40, "Pattern bars", minval=8,  maxval=400)
ahead      = input.int(30, "Projection bars", minval=5, maxval=200)     // we’ll draw with lines
scanDepth  = input.int(600,"Search depth (bars back)", minval=50, maxval=8000)
feed       = input.source(close, "Price source")

metric     = input.string("Euclidean","Distance", options=["Euclidean","Manhattan","Cosine"])
pickMode   = input.string("Top-3","Matches", options=["Top-1","Top-2","Top-3","Top-5"])
buildMode  = input.string("EMA-Blend","Build", options=["Cumulative","MeanStep","EMA-Blend"])
sLen       = input.int(15, "EMA blend length", minval=1, maxval=200)
normOn     = input.bool(true,  "Z-score step vectors")
seekOpp    = input.bool(false, "Prefer dissimilarity (farthest)")

lineColor  = input.color(color.new(color.blue, 0), "Path color")
lineWidth  = input.int(2, "Path width", minval=1, maxval=4)

// ---------- helpers
f_steps(a) =>
    m = array.size(a)
    out = array.new_float(math.max(m-1, 0), 0.0)
    for i = 1 to m-1
        array.set(out, i-1, array.get(a,i) - array.get(a,i-1))
    out

f_z(v) =>
    mu = array.avg(v)
    sd = array.stdev(v)
    out = array.new_float(array.size(v), 0.0)
    for i = 0 to array.size(v)-1
        x = array.get(v,i)
        array.set(out, i, sd == 0.0 ? 0.0 : (x - mu)/sd)
    out

f_dist(a,b,kind) =>
    n = math.min(array.size(a), array.size(b))
    if kind == "Euclidean"
        acc = 0.0
        for i = 0 to n-1
            d = array.get(a,i) - array.get(b,i)
            acc += d*d
        math.sqrt(acc)
    else if kind == "Manhattan"
        acc = 0.0
        for i = 0 to n-1
            acc += math.abs(array.get(a,i) - array.get(b,i))
        acc
    else
        dot = 0.0, na2 = 0.0, nb2 = 0.0
        for i = 0 to n-1
            va = array.get(a,i), vb = array.get(b,i)
            dot += va*vb
            na2 += va*va
            nb2 += vb*vb
        denom = math.sqrt(na2) * math.sqrt(nb2)
        denom == 0.0 ? 1.0 : 1.0 - dot/denom

f_ema_arr(a, len) =>
    n = array.size(a)
    out = array.new_float(n, na)
    if n > 0
        k = 2.0/(len+1.0)
        acc = array.get(a,0)
        array.set(out,0,acc)
        for i = 1 to n-1
            acc := array.get(a,i)*k + acc*(1.0 - k)
            array.set(out,i,acc)
    out

f_idx_of_max(arr) =>
    n = array.size(arr)
    idx = 0
    maxv = array.get(arr, 0)
    for i = 1 to n-1
        v = array.get(arr, i)
        if v > maxv
            maxv := v, idx := i
    idx

f_idx_of_min(arr) =>
    n = array.size(arr)
    idx = 0
    minv = array.get(arr, 0)
    for i = 1 to n-1
        v = array.get(arr, i)
        if v < minv
            minv := v, idx := i
    idx

// ---------- preparation (recomputed each bar to avoid consistency warnings)
effScan  = math.max(scanDepth, winLen + ahead + 20)
effAhead = ahead

// reference window
refP = array.new_float(winLen+1, na)
for i = 0 to winLen
    array.set(refP, i, feed[winLen - i])
refSraw = f_steps(refP)
refS    = normOn ? f_z(refSraw) : refSraw

// ---------- line pool (one segment per forward step)
var segs = array.new_line()
if barstate.isfirst
    // preallocate a generous pool; we’ll only use first effAhead each bar
    MAXPOOL = 220
    for i = 0 to MAXPOOL-1
        array.push(segs, line.new(na, na, na, na))

// ---------- main (only draw on last bar)
if barstate.islast and bar_index > effScan + winLen + effAhead + 10
    // pick how many analogues to blend
    kWant = pickMode == "Top-1" ? 1 : pickMode == "Top-2" ? 2 : pickMode == "Top-3" ? 3 : 5

    // keep top-K without sorting (safe / no OOB)
    float[] topD = array.new_float(0)
    int[]   topE = array.new_int(0)

    firstEnd = effAhead + 1
    lastEnd  = effAhead + effScan
    lastAllowed = math.min(lastEnd, bar_index - winLen)

    for endAgo = firstEnd to lastAllowed
        // candidate pattern
        candP = array.new_float(winLen+1, na)
        for k = 0 to winLen
            array.set(candP, k, feed[endAgo + (winLen - k)])
        candS = f_steps(candP)
        candS := normOn ? f_z(candS) : candS
        dist  = f_dist(refS, candS, metric)

        if array.size(topD) < kWant
            array.push(topD, dist), array.push(topE, endAgo)
        else
            if not seekOpp
                worst = f_idx_of_max(topD)
                if dist < array.get(topD, worst)
                    array.set(topD, worst, dist), array.set(topE, worst, endAgo)
            else
                worst = f_idx_of_min(topD)
                if dist > array.get(topD, worst)
                    array.set(topD, worst, dist), array.set(topE, worst, endAgo)

    kHave = array.size(topE)
    if kHave > 0
        // inverse-distance weights
        eps = 1e-10
        wSum = 0.0
        float[] wts = array.new_float(0)
        for i = 0 to kHave-1
            d = array.get(topD, i)
            w = 1.0 / math.max(d, eps)
            wSum += w
            array.push(wts, w)

        // weighted forward steps
        agg = array.new_float(effAhead, 0.0)
        for i = 0 to kHave-1
            endAgo = array.get(topE, i)
            wi     = array.get(wts, i) / wSum
            for h = 0 to effAhead-1
                vNext = feed[endAgo - 1 - h]
                vCurr = feed[endAgo - h]
                step  = vNext - vCurr
                array.set(agg, h, array.get(agg,h) + wi * step)

        // optional smoothing
        agg := buildMode == "EMA-Blend" ? f_ema_arr(agg, sLen) : agg

        // convert to price path & draw with line segments
        base = feed
        cur  = base
        for h = 0 to effAhead-1
            st = array.get(agg, h)
            nxt = (buildMode == "MeanStep") ? base + st : cur + st

            // pull a segment from pool and draw next step
            L = array.get(segs, h)
            line.set_xy1(L, bar_index + h,     cur)
            line.set_xy2(L, bar_index + h + 1, nxt)
            line.set_color(L, lineColor)
            line.set_width(L, lineWidth)

            cur := nxt

        // hide any unused preallocated segments by making them transparent
        hideFrom = effAhead
        hideTo   = array.size(segs) - 1
        for h = hideFrom to hideTo
            L = array.get(segs, h)
            line.set_color(L, color.new(lineColor, 100))  // fully transparent
            // move off this bar to avoid clutter
            line.set_xy1(L, bar_index, na)
            line.set_xy2(L, bar_index, na)

// price for context (1 plot only)
plot(feed, title="Price", color=color.new(color.gray, 0))
