//@version=6
indicator("Squeeze/IntraDay Scalps", overlay=true)

// ─────────────────────────────
// GENERAL INPUTS
// ─────────────────────────────
priceSource = input.source(hlc3, "Price Source", group="General")

// ─────────────────────────────
// SIGNAL TIMING
// ─────────────────────────────
cooldownMinutes = input.int(20, "Signal Cooldown (minutes)", minval=5, maxval=120, group="Signal Timing")
useTextLabels   = input.bool(true, "Use Text Labels?", group="Signal Timing")

// ─────────────────────────────
// CORE EMA SETTINGS (FIXED)
// ─────────────────────────────
showMAs = input.bool(true, "Show MA Lines?", group="MAs")
ema5Len  = input.int(5,  "EMA 5",  group="MAs")
ema9Len  = input.int(9,  "EMA 9",  group="MAs")
ema21Len = input.int(21, "EMA 21", group="MAs")
ema34Len = input.int(34, "EMA 34", group="MAs")

// ─────────────────────────────
// MA COLORS (NEW — DEFAULTS MATCH EXISTING)
// ─────────────────────────────
ema5Color   = input.color(color.rgb(115, 156, 164), "EMA 5 Color",  group="MA Colors")
ema9Color   = input.color(color.rgb(80, 153, 182),  "EMA 9 Color",  group="MA Colors")
ema21Color  = input.color(color.blue,                "EMA 21 Color", group="MA Colors")
ema34Color  = input.color(color.rgb(215, 19, 176),   "EMA 34 Color", group="MA Colors")
ma50Color   = input.color(color.rgb(181, 2, 251),    "MA 50 Color",  group="MA Colors")
ma100Color  = input.color(color.rgb(190, 0, 0),      "MA 100 Color", group="MA Colors")

// ─────────────────────────────
// OPTIONAL STRUCTURE MAs (50 / 100)
// ─────────────────────────────
use50  = input.bool(true,  "Use 50 MA",  group="Structure MAs")
use100 = input.bool(false, "Use 100 MA", group="Structure MAs")
maType50  = input.string("EMA", "50 MA Type",  options=["EMA","SMA"], group="Structure MAs")
maType100 = input.string("EMA", "100 MA Type", options=["EMA","SMA"], group="Structure MAs")

// ─────────────────────────────
// PRICE AND VOLUME
// ─────────────────────────────
price = priceSource
vol = volume

// ─────────────────────────────
// MA FUNCTIONS
// ─────────────────────────────
f_ma(_type, _src, _len) =>
    _type == "EMA" ? ta.ema(_src, _len) : ta.sma(_src, _len)

// ─────────────────────────────
// MA CALCULATIONS
// ─────────────────────────────
ema5  = ta.ema(price, ema5Len)
ema9  = ta.ema(price, ema9Len)
ema21 = ta.ema(price, ema21Len)
ema34 = ta.ema(price, ema34Len)

ma50  = use50  ? f_ma(maType50,  price, 50)  : na
ma100 = use100 ? f_ma(maType100, price, 100) : na

// ─────────────────────────────
// TREND LOGIC
// ─────────────────────────────
bullStructure =
     ema21 > ema34 and
     (not use50  or ema34 > ma50) and
     (not use100 or ma50  > ma100)

bearStructure =
     ema21 < ema34 and
     (not use50  or ema34 < ma50) and
     (not use100 or ma50  < ma100)

trendBullish = ema5 > ema9 and bullStructure
trendBearish = ema5 < ema9 and bearStructure

// ─────────────────────────────
// SIGNAL LOGIC
// ─────────────────────────────
bullCross = ta.crossover(ema5, ema9)
bearCross = ta.crossunder(ema5, ema9)

callSignal =
     bullCross and
     price > ema34 and
     trendBullish

putSignal =
     bearCross and
     price < ema34 and
     trendBearish

// ─────────────────────────────
// TIME-BASED COOLDOWN
// ─────────────────────────────
intervalMs = cooldownMinutes * 60 * 1000
var int lastSignalTime = na

canFire = na(lastSignalTime) or (time - lastSignalTime >= intervalMs)

fireCall = callSignal and canFire
firePut  = putSignal  and canFire

if fireCall or firePut
    lastSignalTime := time

// ─────────────────────────────
// SIGNAL LABELS
// ─────────────────────────────
plotshape(fireCall, title="Calls",
     style=useTextLabels ? shape.labelup : shape.triangleup,
     location=location.belowbar,
     color=color.new(color.green, 20),
     text="CALLS",
     textcolor=color.white)

plotshape(firePut, title="Puts",
     style=useTextLabels ? shape.labeldown : shape.triangledown,
     location=location.abovebar,
     color=color.new(color.red, 20),
     text="PUTS",
     textcolor=color.white)

// ─────────────────────────────
// VOLUME CONTEXT
// ─────────────────────────────
volAvg = ta.sma(vol, 20)
volumeSupportive = vol >= volAvg * 0.9

// ─────────────────────────────
// DASHBOARD TABLE (Vertical Layout)
// ─────────────────────────────
var table dash = table.new(position.bottom_left, 3, 1, border_width=1)

gradientIntensity = input.int(40, "Gradient Strength (%)", minval=0, maxval=100, group="Visuals")

trendStrength  = math.min(math.abs(ema21 - ema34) / ema34 * 100, 100)
signalStrength = math.min(math.abs(ema5 - ema9) / ema9 * 100, 100)
volumeStrength = math.min(vol / volAvg * 100, 100)

trendBg = trendBullish ? color.new(color.aqua, 100 - trendStrength * gradientIntensity / 100) : trendBearish ? color.new(color.red, 100 - trendStrength * gradientIntensity / 100) : color.new(color.gray, 90)
signalBg = fireCall ? color.new(color.aqua, 100 - signalStrength * gradientIntensity / 100) : firePut ? color.new(color.red, 100 - signalStrength * gradientIntensity / 100) : not canFire ? color.new(color.orange, 85) : color.new(color.gray, 90)
volBg = volumeSupportive ? color.new(color.aqua, 100 - volumeStrength * gradientIntensity / 100) : color.new(color.gray, 90)

trendText  = trendBullish ? "TREND: BULLISH" : trendBearish ? "TREND: BEARISH" : "TREND: CHOP"
signalText = fireCall ? "SIGNAL: CALL" : firePut ? "SIGNAL: PUT" : not canFire ? "SIGNAL: COOLDOWN" : "SIGNAL: NONE"
volText    = volumeSupportive ? "VOLUME: SUPPORTIVE" : "VOLUME: LIGHT"

if barstate.islast
    table.cell(dash, 0, 0, trendText,  text_color=color.white, bgcolor=trendBg)
    table.cell(dash, 1, 0, signalText, text_color=color.white, bgcolor=signalBg)
    table.cell(dash, 2, 0, volText,    text_color=color.white, bgcolor=volBg)

// ─────────────────────────────
// MA PLOTS (COLOR NOW USER-CONTROLLABLE)
// ─────────────────────────────
plot(showMAs ? ema5  : na, "EMA 5",  color=ema5Color,  linewidth=2)
plot(showMAs ? ema9  : na, "EMA 9",  color=ema9Color,  linewidth=2)
plot(showMAs ? ema21 : na, "EMA 21", color=ema21Color, linewidth=1)
plot(showMAs ? ema34 : na, "EMA 34", color=ema34Color, linewidth=1)
plot(showMAs and use50  ? ma50  : na, "MA 50",  color=ma50Color,  linewidth=1)
plot(showMAs and use100 ? ma100 : na, "MA 100", color=ma100Color, linewidth=1)

// ─────────────────────────────
// LOGO
// ─────────────────────────────
var table logo = table.new(position.bottom_right, 1, 1)
if barstate.islast
    table.cell(logo, 0, 0, "// © TylerisTrading", text_color=color.teal)
