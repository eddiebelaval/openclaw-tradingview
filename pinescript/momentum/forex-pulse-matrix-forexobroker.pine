//@version=6
indicator("Forex Pulse Matrix [forexobroker]",
     shorttitle="FX Pulse Matrix",
     overlay=true)

// ══════════════════════════════════════════════════════════════════════════════
// Forex Pulse Matrix [forexobroker]
// Version 1.0
//
// Real-time currency strength heatmap dashboard for 8 major currencies
// across 4 customizable timeframes with momentum scoring, trend detection,
// and automatic best-trade pair suggestion.
//
// Methodology:
//   Strength is calculated from Rate of Change (ROC) contributions across
//   7 USD-denominated pairs. Each pair's ROC is distributed to the base and
//   quote currencies. Values are normalized to a 0-100 scale per timeframe,
//   then combined into a weighted composite score.
//
// (c) forexobroker | Open-source | Educational use
// ══════════════════════════════════════════════════════════════════════════════

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ INPUTS                                                                  │
// └──────────────────────────────────────────────────────────────────────────┘

// Timeframes
tf1 = input.timeframe("15", "Timeframe 1", group="Timeframes", tooltip="Fastest timeframe for near-term momentum")
tf2 = input.timeframe("60", "Timeframe 2", group="Timeframes", tooltip="Short-term trend direction")
tf3 = input.timeframe("240", "Timeframe 3", group="Timeframes", tooltip="Medium-term trend bias")
tf4 = input.timeframe("1D", "Timeframe 4", group="Timeframes", tooltip="Primary trend timeframe — highest weight in composite score")

// Calculation
rocLength = input.int(14, "ROC Length", minval=1, maxval=100, group="Calculation", tooltip="Rate of Change lookback period for strength measurement")
smoothLength = input.int(5, "Smoothing", minval=1, maxval=20, group="Calculation", tooltip="EMA smoothing applied to strength values to reduce noise")

// Scoring Weights
w1 = input.float(10, "TF1 Weight %", minval=0, maxval=100, group="Scoring Weights", tooltip="Weight for fastest timeframe in composite score")
w2 = input.float(20, "TF2 Weight %", minval=0, maxval=100, group="Scoring Weights", tooltip="Weight for short-term timeframe")
w3 = input.float(30, "TF3 Weight %", minval=0, maxval=100, group="Scoring Weights", tooltip="Weight for medium-term timeframe")
w4 = input.float(40, "TF4 Weight %", minval=0, maxval=100, group="Scoring Weights", tooltip="Weight for primary trend timeframe")

// Display
tablePosition = input.string("top_right", "Table Position", options=["top_left", "top_center", "top_right", "bottom_left", "bottom_center", "bottom_right"], group="Display")
textSize = input.string("small", "Text Size", options=["tiny", "small", "normal"], group="Display")
showTopTrade = input.bool(true, "Show Best Trade Suggestion", group="Display", tooltip="Display the strongest-vs-weakest pair recommendation at the bottom")
showPulse = input.bool(false, "Show Pulse Plot", group="Display", tooltip="Show an FX market dispersion oscillator in a separate pane")

// Colors
bullColor = input.color(#00C853, "Strong Color", group="Colors", tooltip="Color for strongest currencies")
bearColor = input.color(#FF3D3D, "Weak Color", group="Colors", tooltip="Color for weakest currencies")

// Alerts
alertThreshold = input.float(10, "Strength Change Threshold", minval=1, maxval=50, group="Alerts", tooltip="Alert when a currency composite score changes by this amount between bars")

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ THEME-AWARE COLORS                                                      │
// └──────────────────────────────────────────────────────────────────────────┘
headerBg    = color.new(chart.fg_color, 85)
headerText  = chart.fg_color
cellBg      = color.new(chart.bg_color, 20)
borderCol   = color.new(chart.fg_color, 75)
mutedText   = color.new(chart.fg_color, 50)

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ HELPER FUNCTIONS                                                        │
// └──────────────────────────────────────────────────────────────────────────┘
getTablePos(pos) =>
    switch pos
        "top_left" => position.top_left
        "top_center" => position.top_center
        "top_right" => position.top_right
        "bottom_left" => position.bottom_left
        "bottom_center" => position.bottom_center
        "bottom_right" => position.bottom_right
        => position.top_right

getTextSize(s) =>
    switch s
        "tiny" => size.tiny
        "small" => size.small
        "normal" => size.normal
        => size.small

getHeatColor(value) =>
    color.from_gradient(value, 0, 100, bearColor, bullColor)

getTrendArrow(delta) =>
    delta > 3.0 ? "▲▲" : delta > 0.5 ? " ▲" : delta < -3.0 ? "▼▼" : delta < -0.5 ? " ▼" : " ◆"

normalize(val, minVal, maxVal) =>
    na(val) or na(minVal) or na(maxVal) or maxVal == minVal ? 50.0 : math.max(0, math.min(100, ((val - minVal) / (maxVal - minVal)) * 100))

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ SECURITY CALLS — 7 Pairs x 4 Timeframes = 28 calls                     │
// └──────────────────────────────────────────────────────────────────────────┘
getPairROC(sym, tf) =>
    request.security(sym, tf, ta.roc(close, rocLength), lookahead=barmerge.lookahead_off)

// EURUSD
eu_1 = getPairROC("FX:EURUSD", tf1)
eu_2 = getPairROC("FX:EURUSD", tf2)
eu_3 = getPairROC("FX:EURUSD", tf3)
eu_4 = getPairROC("FX:EURUSD", tf4)

// GBPUSD
gu_1 = getPairROC("FX:GBPUSD", tf1)
gu_2 = getPairROC("FX:GBPUSD", tf2)
gu_3 = getPairROC("FX:GBPUSD", tf3)
gu_4 = getPairROC("FX:GBPUSD", tf4)

// USDJPY
uj_1 = getPairROC("FX:USDJPY", tf1)
uj_2 = getPairROC("FX:USDJPY", tf2)
uj_3 = getPairROC("FX:USDJPY", tf3)
uj_4 = getPairROC("FX:USDJPY", tf4)

// AUDUSD
au_1 = getPairROC("FX:AUDUSD", tf1)
au_2 = getPairROC("FX:AUDUSD", tf2)
au_3 = getPairROC("FX:AUDUSD", tf3)
au_4 = getPairROC("FX:AUDUSD", tf4)

// NZDUSD
nu_1 = getPairROC("FX:NZDUSD", tf1)
nu_2 = getPairROC("FX:NZDUSD", tf2)
nu_3 = getPairROC("FX:NZDUSD", tf3)
nu_4 = getPairROC("FX:NZDUSD", tf4)

// USDCAD
uc_1 = getPairROC("FX:USDCAD", tf1)
uc_2 = getPairROC("FX:USDCAD", tf2)
uc_3 = getPairROC("FX:USDCAD", tf3)
uc_4 = getPairROC("FX:USDCAD", tf4)

// USDCHF
uf_1 = getPairROC("FX:USDCHF", tf1)
uf_2 = getPairROC("FX:USDCHF", tf2)
uf_3 = getPairROC("FX:USDCHF", tf3)
uf_4 = getPairROC("FX:USDCHF", tf4)

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ CURRENCY STRENGTH ENGINE                                                │
// └──────────────────────────────────────────────────────────────────────────┘
// Raw ROC contributions per currency per timeframe
// USD appears in all 7 pairs: -EU, -GU, +UJ, -AU, -NU, +UC, +UF
// Other currencies appear in 1 pair each

// --- Timeframe 1 ---
usd_r1 = nz((-eu_1 - gu_1 + uj_1 - au_1 - nu_1 + uc_1 + uf_1) / 7)
eur_r1 = nz(eu_1)
gbp_r1 = nz(gu_1)
jpy_r1 = nz(-uj_1)
aud_r1 = nz(au_1)
nzd_r1 = nz(nu_1)
cad_r1 = nz(-uc_1)
chf_r1 = nz(-uf_1)

// --- Timeframe 2 ---
usd_r2 = nz((-eu_2 - gu_2 + uj_2 - au_2 - nu_2 + uc_2 + uf_2) / 7)
eur_r2 = nz(eu_2)
gbp_r2 = nz(gu_2)
jpy_r2 = nz(-uj_2)
aud_r2 = nz(au_2)
nzd_r2 = nz(nu_2)
cad_r2 = nz(-uc_2)
chf_r2 = nz(-uf_2)

// --- Timeframe 3 ---
usd_r3 = nz((-eu_3 - gu_3 + uj_3 - au_3 - nu_3 + uc_3 + uf_3) / 7)
eur_r3 = nz(eu_3)
gbp_r3 = nz(gu_3)
jpy_r3 = nz(-uj_3)
aud_r3 = nz(au_3)
nzd_r3 = nz(nu_3)
cad_r3 = nz(-uc_3)
chf_r3 = nz(-uf_3)

// --- Timeframe 4 ---
usd_r4 = nz((-eu_4 - gu_4 + uj_4 - au_4 - nu_4 + uc_4 + uf_4) / 7)
eur_r4 = nz(eu_4)
gbp_r4 = nz(gu_4)
jpy_r4 = nz(-uj_4)
aud_r4 = nz(au_4)
nzd_r4 = nz(nu_4)
cad_r4 = nz(-uc_4)
chf_r4 = nz(-uf_4)

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ NORMALIZATION (0-100 per timeframe)                                     │
// └──────────────────────────────────────────────────────────────────────────┘
// TF1
min1 = math.min(usd_r1, math.min(eur_r1, math.min(gbp_r1, math.min(jpy_r1, math.min(aud_r1, math.min(nzd_r1, math.min(cad_r1, chf_r1)))))))
max1 = math.max(usd_r1, math.max(eur_r1, math.max(gbp_r1, math.max(jpy_r1, math.max(aud_r1, math.max(nzd_r1, math.max(cad_r1, chf_r1)))))))

usd_n1 = normalize(usd_r1, min1, max1)
eur_n1 = normalize(eur_r1, min1, max1)
gbp_n1 = normalize(gbp_r1, min1, max1)
jpy_n1 = normalize(jpy_r1, min1, max1)
aud_n1 = normalize(aud_r1, min1, max1)
nzd_n1 = normalize(nzd_r1, min1, max1)
cad_n1 = normalize(cad_r1, min1, max1)
chf_n1 = normalize(chf_r1, min1, max1)

// TF2
min2 = math.min(usd_r2, math.min(eur_r2, math.min(gbp_r2, math.min(jpy_r2, math.min(aud_r2, math.min(nzd_r2, math.min(cad_r2, chf_r2)))))))
max2 = math.max(usd_r2, math.max(eur_r2, math.max(gbp_r2, math.max(jpy_r2, math.max(aud_r2, math.max(nzd_r2, math.max(cad_r2, chf_r2)))))))

usd_n2 = normalize(usd_r2, min2, max2)
eur_n2 = normalize(eur_r2, min2, max2)
gbp_n2 = normalize(gbp_r2, min2, max2)
jpy_n2 = normalize(jpy_r2, min2, max2)
aud_n2 = normalize(aud_r2, min2, max2)
nzd_n2 = normalize(nzd_r2, min2, max2)
cad_n2 = normalize(cad_r2, min2, max2)
chf_n2 = normalize(chf_r2, min2, max2)

// TF3
min3 = math.min(usd_r3, math.min(eur_r3, math.min(gbp_r3, math.min(jpy_r3, math.min(aud_r3, math.min(nzd_r3, math.min(cad_r3, chf_r3)))))))
max3 = math.max(usd_r3, math.max(eur_r3, math.max(gbp_r3, math.max(jpy_r3, math.max(aud_r3, math.max(nzd_r3, math.max(cad_r3, chf_r3)))))))

usd_n3 = normalize(usd_r3, min3, max3)
eur_n3 = normalize(eur_r3, min3, max3)
gbp_n3 = normalize(gbp_r3, min3, max3)
jpy_n3 = normalize(jpy_r3, min3, max3)
aud_n3 = normalize(aud_r3, min3, max3)
nzd_n3 = normalize(nzd_r3, min3, max3)
cad_n3 = normalize(cad_r3, min3, max3)
chf_n3 = normalize(chf_r3, min3, max3)

// TF4
min4 = math.min(usd_r4, math.min(eur_r4, math.min(gbp_r4, math.min(jpy_r4, math.min(aud_r4, math.min(nzd_r4, math.min(cad_r4, chf_r4)))))))
max4 = math.max(usd_r4, math.max(eur_r4, math.max(gbp_r4, math.max(jpy_r4, math.max(aud_r4, math.max(nzd_r4, math.max(cad_r4, chf_r4)))))))

usd_n4 = normalize(usd_r4, min4, max4)
eur_n4 = normalize(eur_r4, min4, max4)
gbp_n4 = normalize(gbp_r4, min4, max4)
jpy_n4 = normalize(jpy_r4, min4, max4)
aud_n4 = normalize(aud_r4, min4, max4)
nzd_n4 = normalize(nzd_r4, min4, max4)
cad_n4 = normalize(cad_r4, min4, max4)
chf_n4 = normalize(chf_r4, min4, max4)

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ EMA SMOOTHING                                                           │
// └──────────────────────────────────────────────────────────────────────────┘
usd_s1 = ta.ema(usd_n1, smoothLength)
eur_s1 = ta.ema(eur_n1, smoothLength)
gbp_s1 = ta.ema(gbp_n1, smoothLength)
jpy_s1 = ta.ema(jpy_n1, smoothLength)
aud_s1 = ta.ema(aud_n1, smoothLength)
nzd_s1 = ta.ema(nzd_n1, smoothLength)
cad_s1 = ta.ema(cad_n1, smoothLength)
chf_s1 = ta.ema(chf_n1, smoothLength)

usd_s2 = ta.ema(usd_n2, smoothLength)
eur_s2 = ta.ema(eur_n2, smoothLength)
gbp_s2 = ta.ema(gbp_n2, smoothLength)
jpy_s2 = ta.ema(jpy_n2, smoothLength)
aud_s2 = ta.ema(aud_n2, smoothLength)
nzd_s2 = ta.ema(nzd_n2, smoothLength)
cad_s2 = ta.ema(cad_n2, smoothLength)
chf_s2 = ta.ema(chf_n2, smoothLength)

usd_s3 = ta.ema(usd_n3, smoothLength)
eur_s3 = ta.ema(eur_n3, smoothLength)
gbp_s3 = ta.ema(gbp_n3, smoothLength)
jpy_s3 = ta.ema(jpy_n3, smoothLength)
aud_s3 = ta.ema(aud_n3, smoothLength)
nzd_s3 = ta.ema(nzd_n3, smoothLength)
cad_s3 = ta.ema(cad_n3, smoothLength)
chf_s3 = ta.ema(chf_n3, smoothLength)

usd_s4 = ta.ema(usd_n4, smoothLength)
eur_s4 = ta.ema(eur_n4, smoothLength)
gbp_s4 = ta.ema(gbp_n4, smoothLength)
jpy_s4 = ta.ema(jpy_n4, smoothLength)
aud_s4 = ta.ema(aud_n4, smoothLength)
nzd_s4 = ta.ema(nzd_n4, smoothLength)
cad_s4 = ta.ema(cad_n4, smoothLength)
chf_s4 = ta.ema(chf_n4, smoothLength)

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ COMPOSITE SCORE (Weighted average across timeframes)                    │
// └──────────────────────────────────────────────────────────────────────────┘
wTotal = w1 + w2 + w3 + w4
wn1 = wTotal > 0 ? w1 / wTotal : 0.25
wn2 = wTotal > 0 ? w2 / wTotal : 0.25
wn3 = wTotal > 0 ? w3 / wTotal : 0.25
wn4 = wTotal > 0 ? w4 / wTotal : 0.25

usd_sc = nz(usd_s1) * wn1 + nz(usd_s2) * wn2 + nz(usd_s3) * wn3 + nz(usd_s4) * wn4
eur_sc = nz(eur_s1) * wn1 + nz(eur_s2) * wn2 + nz(eur_s3) * wn3 + nz(eur_s4) * wn4
gbp_sc = nz(gbp_s1) * wn1 + nz(gbp_s2) * wn2 + nz(gbp_s3) * wn3 + nz(gbp_s4) * wn4
jpy_sc = nz(jpy_s1) * wn1 + nz(jpy_s2) * wn2 + nz(jpy_s3) * wn3 + nz(jpy_s4) * wn4
aud_sc = nz(aud_s1) * wn1 + nz(aud_s2) * wn2 + nz(aud_s3) * wn3 + nz(aud_s4) * wn4
nzd_sc = nz(nzd_s1) * wn1 + nz(nzd_s2) * wn2 + nz(nzd_s3) * wn3 + nz(nzd_s4) * wn4
cad_sc = nz(cad_s1) * wn1 + nz(cad_s2) * wn2 + nz(cad_s3) * wn3 + nz(cad_s4) * wn4
chf_sc = nz(chf_s1) * wn1 + nz(chf_s2) * wn2 + nz(chf_s3) * wn3 + nz(chf_s4) * wn4

// Momentum delta (change from previous bar)
usd_dl = usd_sc - nz(usd_sc[1], usd_sc)
eur_dl = eur_sc - nz(eur_sc[1], eur_sc)
gbp_dl = gbp_sc - nz(gbp_sc[1], gbp_sc)
jpy_dl = jpy_sc - nz(jpy_sc[1], jpy_sc)
aud_dl = aud_sc - nz(aud_sc[1], aud_sc)
nzd_dl = nzd_sc - nz(nzd_sc[1], nzd_sc)
cad_dl = cad_sc - nz(cad_sc[1], cad_sc)
chf_dl = chf_sc - nz(chf_sc[1], chf_sc)

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ BEST TRADE DETECTION                                                    │
// └──────────────────────────────────────────────────────────────────────────┘
var string strongCcy = "USD"
var string weakCcy   = "JPY"
var string tradeText = ""

if barstate.islast
    scores = array.from(usd_sc, eur_sc, gbp_sc, jpy_sc, aud_sc, nzd_sc, cad_sc, chf_sc)
    names  = array.from("USD", "EUR", "GBP", "JPY", "AUD", "NZD", "CAD", "CHF")

    maxIdx = 0
    minIdx = 0
    maxV   = array.get(scores, 0)
    minV   = array.get(scores, 0)

    for i = 1 to 7
        v = array.get(scores, i)
        if v > maxV
            maxV := v
            maxIdx := i
        if v < minV
            minV := v
            minIdx := i

    strongCcy := array.get(names, maxIdx)
    weakCcy   := array.get(names, minIdx)

    // FX convention priority: EUR > GBP > AUD > NZD > USD > CAD > CHF > JPY
    ccyPriority = array.from(1, 2, 4, 5, 0, 6, 7, 3)
    strongP = array.indexof(ccyPriority, maxIdx)
    weakP   = array.indexof(ccyPriority, minIdx)

    pairBase  = strongP < weakP ? strongCcy : weakCcy
    pairQuote = strongP < weakP ? weakCcy : strongCcy
    direction = strongP < weakP ? "Buy " : "Sell "

    gap = str.tostring(maxV - minV, "#.#")
    tradeText := direction + pairBase + "/" + pairQuote + "  (" + strongCcy + " +" + str.tostring(maxV, "#.#") + " vs " + weakCcy + " " + str.tostring(minV, "#.#") + "  gap:" + gap + ")"

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ PULSE PLOT (Optional FX dispersion oscillator)                          │
// └──────────────────────────────────────────────────────────────────────────┘
pulse = math.sqrt((math.pow(usd_sc - 50, 2) + math.pow(eur_sc - 50, 2) + math.pow(gbp_sc - 50, 2) + math.pow(jpy_sc - 50, 2) + math.pow(aud_sc - 50, 2) + math.pow(nzd_sc - 50, 2) + math.pow(cad_sc - 50, 2) + math.pow(chf_sc - 50, 2)) / 8)

plot(showPulse ? pulse : na, "FX Pulse Index", color=color.new(#FFD600, 20), linewidth=2, display=display.pane)
hline(showPulse ? 20 : na, "Low Dispersion", color=color.new(color.gray, 70), linestyle=hline.style_dotted)
hline(showPulse ? 35 : na, "High Dispersion", color=color.new(color.orange, 70), linestyle=hline.style_dotted)

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ HEATMAP TABLE                                                           │
// └──────────────────────────────────────────────────────────────────────────┘
var table matrix = table.new(getTablePos(tablePosition), 7, 11,
     bgcolor=cellBg,
     border_width=1,
     border_color=borderCol,
     frame_width=2,
     frame_color=borderCol)

if barstate.islast
    sz = getTextSize(textSize)
    heatText = color.white

    // ─── Title Row ───
    table.cell(matrix, 0, 0, "FX PULSE MATRIX", bgcolor=color.new(#1565C0, 15), text_color=headerText, text_size=sz, text_halign=text.align_center)
    table.cell(matrix, 1, 0, "", bgcolor=color.new(#1565C0, 15), text_size=sz)
    table.cell(matrix, 2, 0, "", bgcolor=color.new(#1565C0, 15), text_size=sz)
    table.cell(matrix, 3, 0, "", bgcolor=color.new(#1565C0, 15), text_size=sz)
    table.cell(matrix, 4, 0, "", bgcolor=color.new(#1565C0, 15), text_size=sz)
    table.cell(matrix, 5, 0, "", bgcolor=color.new(#1565C0, 15), text_size=sz)
    table.cell(matrix, 6, 0, "forexobroker", bgcolor=color.new(#1565C0, 15), text_color=mutedText, text_size=size.tiny, text_halign=text.align_center)

    // ─── Header Row ───
    table.cell(matrix, 0, 1, "CURRENCY", bgcolor=headerBg, text_color=headerText, text_size=sz, text_halign=text.align_center)
    table.cell(matrix, 1, 1, tf1, bgcolor=headerBg, text_color=headerText, text_size=sz, text_halign=text.align_center)
    table.cell(matrix, 2, 1, tf2, bgcolor=headerBg, text_color=headerText, text_size=sz, text_halign=text.align_center)
    table.cell(matrix, 3, 1, tf3, bgcolor=headerBg, text_color=headerText, text_size=sz, text_halign=text.align_center)
    table.cell(matrix, 4, 1, tf4, bgcolor=headerBg, text_color=headerText, text_size=sz, text_halign=text.align_center)
    table.cell(matrix, 5, 1, "SCORE", bgcolor=headerBg, text_color=headerText, text_size=sz, text_halign=text.align_center)
    table.cell(matrix, 6, 1, "TREND", bgcolor=headerBg, text_color=headerText, text_size=sz, text_halign=text.align_center)

    // ─── Currency Data Rows ───
    ccyNames = array.from("USD", "EUR", "GBP", "JPY", "AUD", "NZD", "CAD", "CHF")

    tf1v = array.from(nz(usd_s1, 50), nz(eur_s1, 50), nz(gbp_s1, 50), nz(jpy_s1, 50), nz(aud_s1, 50), nz(nzd_s1, 50), nz(cad_s1, 50), nz(chf_s1, 50))
    tf2v = array.from(nz(usd_s2, 50), nz(eur_s2, 50), nz(gbp_s2, 50), nz(jpy_s2, 50), nz(aud_s2, 50), nz(nzd_s2, 50), nz(cad_s2, 50), nz(chf_s2, 50))
    tf3v = array.from(nz(usd_s3, 50), nz(eur_s3, 50), nz(gbp_s3, 50), nz(jpy_s3, 50), nz(aud_s3, 50), nz(nzd_s3, 50), nz(cad_s3, 50), nz(chf_s3, 50))
    tf4v = array.from(nz(usd_s4, 50), nz(eur_s4, 50), nz(gbp_s4, 50), nz(jpy_s4, 50), nz(aud_s4, 50), nz(nzd_s4, 50), nz(cad_s4, 50), nz(chf_s4, 50))
    scv  = array.from(usd_sc, eur_sc, gbp_sc, jpy_sc, aud_sc, nzd_sc, cad_sc, chf_sc)
    dlv  = array.from(usd_dl, eur_dl, gbp_dl, jpy_dl, aud_dl, nzd_dl, cad_dl, chf_dl)

    for i = 0 to 7
        row = i + 2
        v1 = array.get(tf1v, i)
        v2 = array.get(tf2v, i)
        v3 = array.get(tf3v, i)
        v4 = array.get(tf4v, i)
        sc = array.get(scv, i)
        dl = array.get(dlv, i)
        ccyName = array.get(ccyNames, i)

        // Currency label (highlight strongest/weakest)
        ccyBg = ccyName == strongCcy ? color.new(bullColor, 75) : ccyName == weakCcy ? color.new(bearColor, 75) : headerBg
        table.cell(matrix, 0, row, ccyName, bgcolor=ccyBg, text_color=headerText, text_size=sz, text_halign=text.align_center)

        // Heatmap cells
        table.cell(matrix, 1, row, str.tostring(v1, "#.#"), bgcolor=getHeatColor(v1), text_color=heatText, text_size=sz, text_halign=text.align_center)
        table.cell(matrix, 2, row, str.tostring(v2, "#.#"), bgcolor=getHeatColor(v2), text_color=heatText, text_size=sz, text_halign=text.align_center)
        table.cell(matrix, 3, row, str.tostring(v3, "#.#"), bgcolor=getHeatColor(v3), text_color=heatText, text_size=sz, text_halign=text.align_center)
        table.cell(matrix, 4, row, str.tostring(v4, "#.#"), bgcolor=getHeatColor(v4), text_color=heatText, text_size=sz, text_halign=text.align_center)

        // Score cell (composite)
        scBg = getHeatColor(sc)
        table.cell(matrix, 5, row, str.tostring(sc, "#.#"), bgcolor=scBg, text_color=heatText, text_size=sz, text_halign=text.align_center)

        // Trend arrow
        arrow = getTrendArrow(dl)
        arrowCol = dl > 0.5 ? bullColor : dl < -0.5 ? bearColor : mutedText
        table.cell(matrix, 6, row, arrow, bgcolor=cellBg, text_color=arrowCol, text_size=sz, text_halign=text.align_center)

    // ─── Best Trade Footer ───
    if showTopTrade
        footerBg = color.new(#1565C0, 15)
        table.cell(matrix, 0, 10, "TOP TRADE", bgcolor=footerBg, text_color=headerText, text_size=size.tiny, text_halign=text.align_center)
        table.cell(matrix, 1, 10, tradeText, bgcolor=footerBg, text_color=headerText, text_size=size.tiny, text_halign=text.align_left)
        table.cell(matrix, 2, 10, "", bgcolor=footerBg, text_size=size.tiny)
        table.cell(matrix, 3, 10, "", bgcolor=footerBg, text_size=size.tiny)
        table.cell(matrix, 4, 10, "", bgcolor=footerBg, text_size=size.tiny)
        table.cell(matrix, 5, 10, "", bgcolor=footerBg, text_size=size.tiny)
        table.cell(matrix, 6, 10, "", bgcolor=footerBg, text_size=size.tiny)

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ DATA WINDOW PLOTS                                                       │
// └──────────────────────────────────────────────────────────────────────────┘
plot(usd_sc, "USD Strength", display=display.data_window)
plot(eur_sc, "EUR Strength", display=display.data_window)
plot(gbp_sc, "GBP Strength", display=display.data_window)
plot(jpy_sc, "JPY Strength", display=display.data_window)
plot(aud_sc, "AUD Strength", display=display.data_window)
plot(nzd_sc, "NZD Strength", display=display.data_window)
plot(cad_sc, "CAD Strength", display=display.data_window)
plot(chf_sc, "CHF Strength", display=display.data_window)
plot(pulse,  "FX Pulse Index", display=display.data_window)

// ┌──────────────────────────────────────────────────────────────────────────┐
// │ ALERTS                                                                  │
// └──────────────────────────────────────────────────────────────────────────┘
usdShift = math.abs(usd_dl) > alertThreshold
eurShift = math.abs(eur_dl) > alertThreshold
gbpShift = math.abs(gbp_dl) > alertThreshold
jpyShift = math.abs(jpy_dl) > alertThreshold
audShift = math.abs(aud_dl) > alertThreshold
nzdShift = math.abs(nzd_dl) > alertThreshold
cadShift = math.abs(cad_dl) > alertThreshold
chfShift = math.abs(chf_dl) > alertThreshold
anyShift = usdShift or eurShift or gbpShift or jpyShift or audShift or nzdShift or cadShift or chfShift

alertcondition(usdShift, "USD Strength Shift", "USD strength changed significantly on Forex Pulse Matrix")
alertcondition(eurShift, "EUR Strength Shift", "EUR strength changed significantly on Forex Pulse Matrix")
alertcondition(gbpShift, "GBP Strength Shift", "GBP strength changed significantly on Forex Pulse Matrix")
alertcondition(jpyShift, "JPY Strength Shift", "JPY strength changed significantly on Forex Pulse Matrix")
alertcondition(audShift, "AUD Strength Shift", "AUD strength changed significantly on Forex Pulse Matrix")
alertcondition(nzdShift, "NZD Strength Shift", "NZD strength changed significantly on Forex Pulse Matrix")
alertcondition(cadShift, "CAD Strength Shift", "CAD strength changed significantly on Forex Pulse Matrix")
alertcondition(chfShift, "CHF Strength Shift", "CHF strength changed significantly on Forex Pulse Matrix")
alertcondition(anyShift, "Any Currency Shift", "A major currency strength shift was detected on Forex Pulse Matrix")
// ══════════════════════════════════════════════════════════════════════════════
