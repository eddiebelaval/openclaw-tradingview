//@version=6
indicator("Quantum Dynamic Mitigation Zones v1", "Quant_Mitigation_v1", overlay=true, max_boxes_count=100)

// =============================================================================
// 1. SETTINGS
// =============================================================================
group_vol  = "Institutional Volume Anomaly"
vol_len    = input.int(20, "Volume Moving Average Length", group=group_vol)
vol_mult   = input.float(3.0, "Volume Spike Multiplier (e.g., 3.0 = 300%)", step=0.5, group=group_vol)

group_col  = "Zone Colors"
c_bull     = input.color(#00FFFF, "Bullish Demand Zone", group=group_col)
c_bear     = input.color(#FF00FF, "Bearish Supply Zone", group=group_col)
bg_transp  = input.int(80, "Background Transparency", minval=0, maxval=100, group=group_col)

// =============================================================================
// 2. VOLUME ANOMALY DETECTION
// =============================================================================
// Calculate average volume
avg_vol = ta.sma(volume, vol_len)

// Detect anomalies (Volume is X times higher than average)
is_anomaly = volume > (avg_vol * vol_mult)

bool is_bull_spike = is_anomaly and close > open
bool is_bear_spike = is_anomaly and close < open

// =============================================================================
// 3. DYNAMIC BOX ARRAYS (The Memory Bank)
// =============================================================================
var box[] bull_zones = array.new_box()
var box[] bear_zones = array.new_box()

// =============================================================================
// 4. ZONE CREATION
// =============================================================================
if is_bull_spike
    // Draw from High to Low of the anomaly candle
    new_box = box.new(left=bar_index, top=high, right=bar_index, bottom=low, 
                      border_color=c_bull, border_style=line.style_solid, 
                      bgcolor=color.new(c_bull, bg_transp))
    array.unshift(bull_zones, new_box)

if is_bear_spike
    new_box = box.new(left=bar_index, top=high, right=bar_index, bottom=low, 
                      border_color=c_bear, border_style=line.style_solid, 
                      bgcolor=color.new(c_bear, bg_transp))
    array.unshift(bear_zones, new_box)

// =============================================================================
// 5. MITIGATION ENGINE (The "Eating" Logic)
// =============================================================================
// Process Bullish Zones (Demand)
if array.size(bull_zones) > 0
    for i = array.size(bull_zones) - 1 to 0
        cur_box = array.get(bull_zones, i)
        box_top = box.get_top(cur_box)
        box_bot = box.get_bottom(cur_box)
        
        // Always extend the box to the current bar to keep it alive
        box.set_right(cur_box, bar_index)
        
        // If price dips into the zone, it "eats" the top boundary
        if low < box_top and low > box_bot
            box.set_top(cur_box, low) // Shrink the box
        
        // If price closes below the bottom, the zone is destroyed
        if close < box_bot
            array.remove(bull_zones, i) // Remove from memory

// Process Bearish Zones (Supply)
if array.size(bear_zones) > 0
    for i = array.size(bear_zones) - 1 to 0
        cur_box = array.get(bear_zones, i)
        box_top = box.get_top(cur_box)
        box_bot = box.get_bottom(cur_box)
        
        box.set_right(cur_box, bar_index)
        
        // If price rallies into the zone, it "eats" the bottom boundary
        if high > box_bot and high < box_top
            box.set_bottom(cur_box, high) // Shrink the box
            
        // If price closes above the top, the zone is destroyed
        if close > box_top
            array.remove(bear_zones, i)
