//@version=6
indicator("Commodity Channel Index Pullback (CCI/P) v1", "CCI/P v1", overlay=false)

RED   = color.rgb(255, 0, 0)
GREEN = color.rgb(0, 128, 0)
BLUE  = color.rgb(41, 98, 255)
UP2   = color.rgb(8, 153, 129)
DN2   = color.rgb(178, 181, 190)

grp1 = "CCI #1 Settings"
grp2 = "CCI #2 Settings"
grpc = "Candle Colors (CCI #2)"

len1     = input.int(defval=20, minval=1, title="Length", group=grp1)
absLevel = input.int(defval=150, title="Absolute Level (OB/OS)", group=grp1)
src1     = input.source(defval=close, title="Source", group=grp1)

show2Mode = input.string(defval="Off", title="Plot Mode", options=["Off", "CCI #2", "MA of CCI #2"], group=grp2)
src2      = input.source(defval=close, title="Source", group=grp2)
len2      = input.int(defval=20, minval=1, title="Length", group=grp2)
maType    = input.string(defval="SMA", title="MA Type", options=["SMA", "EMA", "WMA", "RMA"], group=grp2)
maLen     = input.int(defval=14, minval=1, title="MA Length", group=grp2)

c2_up = input.color(defval=color.new(UP2, 40), title="Color 0", group=grp2, inline="c2col")
c2_dn = input.color(defval=color.new(DN2, 40), title="Color 1", group=grp2, inline="c2col")

colorCandles = input.bool(defval=false, title="Color Candles by CCI #2", group=grpc)
barUpColor   = input.color(defval=color.new(UP2, 40), title="Above 0", group=grpc, inline="bar")
barDnColor   = input.color(defval=color.new(DN2, 40), title="Below 0", group=grpc, inline="bar")

ob = absLevel
os = -absLevel

cci1 = ta.cci(src1, len1)
cci2 = ta.cci(src2, len2)

cci2_ma = switch maType
    "SMA" => ta.sma(cci2, maLen)
    "EMA" => ta.ema(cci2, maLen)
    "WMA" => ta.wma(cci2, maLen)
    => ta.rma(cci2, maLen)

c2_enabled = show2Mode != "Off"
c2_series  = show2Mode == "CCI #2" ? cci2 : show2Mode == "MA of CCI #2" ? cci2_ma : na
c2_color   = c2_series >= 0 ? c2_up : c2_dn

greenCond = c2_enabled and (cci1 < os) and (c2_series > 0)
redCond   = c2_enabled and (cci1 > ob) and (c2_series < 0)

// Triangles should only print on confirmed (closed) bars
greenCondC = greenCond and barstate.isconfirmed
redCondC   = redCond   and barstate.isconfirmed

// Triangle alerts should also only fire on confirmed bars (first bar condition becomes true)
greenTrigEvent = greenCondC and not greenCondC[1]
redTrigEvent   = redCondC   and not redCondC[1]

// Candle coloring (entire candle body)
barCol = (colorCandles and c2_enabled) ? (c2_series >= 0 ? barUpColor : barDnColor) : na
barcolor(barCol)

// Plots (CCI #2 first so it's behind)
plot(series=c2_series, title="CCI #2 (Area)", color=c2_color, style=plot.style_area, linewidth=1)
plot(series=cci1, title="CCI #1", color=BLUE, linewidth=2)

band100  = hline(price=100,  title="100",  color=RED,   linestyle=hline.style_solid)
band200  = hline(price=200,  title="200",  color=RED,   linestyle=hline.style_solid)
bandN100 = hline(price=-100, title="-100", color=GREEN, linestyle=hline.style_solid)
bandN200 = hline(price=-200, title="-200", color=GREEN, linestyle=hline.style_solid)

hline(price=0, title="0", color=color.new(color.white, 50), linestyle=hline.style_dashed)
hline(price=150,  title="150",  color=color.new(color.white, 50), linestyle=hline.style_dashed, display=display.none)
hline(price=-150, title="-150", color=color.new(color.white, 50), linestyle=hline.style_dashed, display=display.none)

gray5 = color.new(color.rgb(128, 128, 128), 95)
fill(band100,  band200,  title="Overbought background", color=gray5)
fill(bandN100, bandN200, title="Oversold background",  color=gray5)

blue60 = color.new(BLUE, 40)
red50  = color.new(RED, 50)
grn50  = color.new(GREEN, 50)

leveldw = cci1 <= os ? cci1 : os
p1 = plot(series=os,      title="Oversold level", color=blue60)
p2 = plot(series=leveldw, title="Oversold fill",  color=blue60)
fill(p1, p2, title="Oversold plot", color=grn50)

levelht = cci1 >= ob ? cci1 : ob
p3 = plot(series=ob,      title="Overbought level", color=blue60)
p4 = plot(series=levelht, title="Overbought fill",  color=blue60)
fill(p3, p4, title="Overbought plot", color=red50)

// Triangles (confirmed-only)
plotshape(series=greenCondC, title="Green Triangle", style=shape.triangleup,   location=location.bottom, color=GREEN, size=size.small)
plotshape(series=redCondC,   title="Red Triangle",   style=shape.triangledown, location=location.top,    color=RED,   size=size.small)

cci1_cross_overbought = ta.crossover(cci1, ob)
cci1_cross_oversold   = ta.crossunder(cci1, os)
cci1_back_below_ob    = ta.crossunder(cci1, ob)
cci1_back_above_os    = ta.crossover(cci1, os)

c2_cross_up0 = c2_enabled and ta.crossover(c2_series, 0)
c2_cross_dn0 = c2_enabled and ta.crossunder(c2_series, 0)

alertcondition(condition=greenTrigEvent, title="CCI/P Long Pullback Setup",  message="CCI/P: LONG setup (CCI1 < -AbsLevel AND CCI2/MA2 > 0).")
alertcondition(condition=redTrigEvent,   title="CCI/P Short Pullback Setup", message="CCI/P: SHORT setup (CCI1 > +AbsLevel AND CCI2/MA2 < 0).")

alertcondition(condition=cci1_cross_overbought, title="CCI #1 Crossed Above +AbsLevel",      message="CCI #1 crossed ABOVE +AbsLevel.")
alertcondition(condition=cci1_cross_oversold,   title="CCI #1 Crossed Below -AbsLevel",      message="CCI #1 crossed BELOW -AbsLevel.")
alertcondition(condition=cci1_back_below_ob,    title="CCI #1 Crossed Back Below +AbsLevel", message="CCI #1 crossed back BELOW +AbsLevel.")
alertcondition(condition=cci1_back_above_os,    title="CCI #1 Crossed Back Above -AbsLevel", message="CCI #1 crossed back ABOVE -AbsLevel.")

alertcondition(condition=c2_cross_up0, title="CCI #2 / MA2 Crossed Above 0", message="CCI #2 / MA2 crossed ABOVE 0 (based on Plot Mode).")
alertcondition(condition=c2_cross_dn0, title="CCI #2 / MA2 Crossed Below 0", message="CCI #2 / MA2 crossed BELOW 0 (based on Plot Mode).")
