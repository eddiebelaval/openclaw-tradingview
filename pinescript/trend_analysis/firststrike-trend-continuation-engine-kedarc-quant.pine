//@version=6
strategy("FirstStrike Trend Continuation Engine [KedArc Quant]",
     overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10,
     commission_type=strategy.commission.percent,
     commission_value=0.01,
     pyramiding=0,
     calc_on_every_tick=false,
     process_orders_on_close=true)

// ========= Inputs =========
groupRSI   = "RSI / Trigger"
rsiLen     = input.int(14, "RSI Length", minval=2, group=groupRSI)
rsiTrigger = input.int(50, "Trigger Level (RSI >= this)", minval=1, maxval=99, group=groupRSI)
triggerMode = input.string("Any bar >= trigger", "Trigger mode",
     options=["Cross only", "Cross+Grace", "Cross+Grace+Sustain", "Any bar >= trigger"], group=groupRSI)
graceBars   = input.int(30, "Grace window (bars) after cross", minval=0, maxval=500, group=groupRSI)
sustainBars = input.int(3, "Sustain bars (RSI >= trigger)", minval=1, maxval=100, group=groupRSI)
requireDip  = input.bool(false, "Require RSI dip below Rearm before any entry?", group=groupRSI)
rsiRearm    = input.int(45, "Rearm level (if requireDip=true)", minval=1, maxval=99, group=groupRSI)

groupEMA   = "Trend / Filters"
emaFastLen = input.int(20, "EMA (fast) confirmation", minval=1, group=groupEMA)
emaTrend   = input.int(200, "EMA (trend filter)", minval=50, group=groupEMA)

groupTime  = "Optional Hour Window"
useSession = input.bool(false, "Restrict by Session?", group=groupTime)
sessionStr = input.session("0930-1600", "Session", group=groupTime)
useTime    = input.bool(false, "Restrict by Hour Range?", group=groupTime)
startHour  = input.int(9,  "Start Hour", minval=0, maxval=23, group=groupTime)
endHour    = input.int(15, "End Hour",   minval=0, maxval=23, group=groupTime)

groupVol = "Volume Filter"
useVol = input.bool(false, "Require Volume > SMA?", group=groupVol)
volLen = input.int(20, "Volume SMA Length", minval=1, group=groupVol)

groupRisk  = "Risk / Exits"
atrLen    = input.int(14, "ATR Length", minval=1, group=groupRisk)
atrMult   = input.float(1.5, "ATR Stop Multiplier", step=0.1, group=groupRisk)
riskRR    = input.float(2.0, "Take-Profit R Multiple", step=0.1, group=groupRisk)
useTrail  = input.bool(false, "Use Trailing Stop?", group=groupRisk)
trailMult = input.float(2.0, "Trailing ATR Multiplier", step=0.1, group=groupRisk)

// ========= Calculations =========
hr = hour(time)
inSession = useSession ? (time(timeframe.period, sessionStr) != 0) : true
inHours = useSession ? inSession :
     (useTime ? (startHour <= endHour ? (hr >= startHour and hr <= endHour) : (hr >= startHour or hr <= endHour)) : true)

emaFast = ta.ema(close, emaFastLen)
ema200  = ta.ema(close, emaTrend)
rsi     = ta.rsi(close, rsiLen)
atr     = ta.atr(atrLen)
volSMA  = ta.sma(volume, volLen)

trendOK = close > ema200
priceOK = close > emaFast
volOK   = useVol ? (volume > volSMA) : true

// ----- One-trade-per-day gate -----
newDay = dayofmonth != dayofmonth[1]
var bool tookTradeToday = false
if newDay
    tookTradeToday := false

// ----- Rearm -----
var bool rearmed = not requireDip
if newDay
    rearmed := not requireDip
if requireDip and rsi < rsiRearm
    rearmed := true

// ----- Trigger logic variants -----
crossNow = ta.crossover(rsi, rsiTrigger)

var int lastCrossBarIndex = na
if newDay
    lastCrossBarIndex := na
if crossNow
    lastCrossBarIndex := bar_index

withinGrace = graceBars > 0 and not na(lastCrossBarIndex) and (bar_index - lastCrossBarIndex) <= graceBars and rsi >= rsiTrigger

// TRUE consecutive sustain
sustainOK = ta.lowest(rsi, sustainBars) >= rsiTrigger

anyBarOK = rsi >= rsiTrigger

bool triggerOK = switch triggerMode
    "Cross only"          => crossNow
    "Cross+Grace"         => (crossNow or withinGrace)
    "Cross+Grace+Sustain" => ((crossNow or withinGrace) and sustainOK)
    "Any bar >= trigger"  => anyBarOK

longCond = inHours and trendOK and priceOK and rearmed and triggerOK and volOK and not tookTradeToday and strategy.position_size == 0

// ========= Orders =========
if longCond
    strategy.entry("Long", strategy.long)
    tookTradeToday := true
    rearmed := false
    label.new(bar_index, low, "LONG\nRSI:" + str.tostring(rsi, "#.#"), color=color.green, style=label.style_label_up, size=size.small)

// Proper trailing: one exit, ratcheting stop
var float hiSinceEntry = na
if strategy.position_size > 0
    hiSinceEntry := na(hiSinceEntry) ? high : math.max(hiSinceEntry, high)
else
    hiSinceEntry := na

if strategy.position_size > 0
    avg         = strategy.position_avg_price
    initialStop = avg - atrMult * atr
    riskPS      = avg - initialStop
    limitPx     = avg + riskRR * riskPS

    trailStop   = hiSinceEntry - trailMult * atr
    finalStop   = useTrail ? math.max(initialStop, trailStop) : initialStop

    strategy.exit("Exit", from_entry="Long", stop=finalStop, limit=limitPx)

// ========= Visuals =========
plot(ema200, "EMA 200 (Trend)", color=color.new(color.blue, 0), linewidth=2)
plot(emaFast, "EMA Fast", color=color.new(color.orange, 0))
plot(strategy.position_size != 0 ? strategy.position_avg_price : na, "Entry Px", color=color.new(color.green, 0), style=plot.style_linebr)
bgcolor(longCond ? color.new(color.green, 90) : na, title="Entry Signal")

alertcondition(longCond, title="FirstStrike Long Entry", message="Long entry triggered at {{close}}")
