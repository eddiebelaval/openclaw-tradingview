//@version=6

indicator("Swing Levels", overlay=true, max_bars_back=499, max_lines_count=499, max_labels_count=499)

// ==========================================
// Inputs: Swing Levels
// ==========================================
pivotDepth = input.int(34, "Pivot Depth", minval=2, group="Swing Levels")
pivotDeviation = input.float(6.0, "Pivot Deviation (ticks)", minval=0.0, group="Swing Levels")
maxLevelCount = input.int(6, "Max Horizontal Levels", minval=1, group="Swing Levels")
extendLevels = input.bool(true, "Extend Levels Right", group="Swing Levels")

// Colors are aligned with your Trend Structure defaults.
levelAbovePriceColor = input.color(color.new(color.rgb(64, 217, 143), 20), "Level Color Above Price", group="Swing Level Colors")
levelBelowPriceColor = input.color(color.new(color.rgb(246, 113, 113), 20), "Level Color Below Price", group="Swing Level Colors")

// ==========================================
// Inputs: Diagonal Structure
// ==========================================
diagonalLineThickness = input.int(1, "Diagonal Line Thickness", minval=1, group="Diagonal Structure", inline="diag1")
maxDiagonalObjects = input.int(200, "Max Diagonal Objects", minval=10, group="Diagonal Structure")
showDiagonalSrLines = input.bool(true, "Show Last Extremes Lines", group="Diagonal Structure", inline="diag2")
diagonalSrLineCount = input.int(2, "Count", minval=1, group="Diagonal Structure", inline="diag2")
extremeHighLineColor = input.color(color.new(color.rgb(64, 217, 143), 20), "High Extremes Color", group="Diagonal Structure", inline="diag3")
extremeLowLineColor = input.color(color.new(color.rgb(246, 113, 113), 20), "Low Extremes Color", group="Diagonal Structure", inline="diag3")

// ==========================================
// Constants and storage
// ==========================================
highPivotType = 1
lowPivotType = -1
diagonalFixedColor = color.gray

var horizontalLevels = array.new_line()
var diagonalLines = array.new_line()
var diagonalSrLines = array.new_line()
var diagonalLabels = array.new_label()

var pivotValues = array.new_float()
var pivotTypes = array.new_int()
var pivotBarIndexes = array.new_int()

// ==========================================
// Drawing helpers
// ==========================================
drawDiagonalLine(x1, x2, y1, y2, lineColor, lineThickness, lineStyle, lineExtend) =>
    line.new(x1=x1, y1=y1, x2=x2, y2=y2, color=lineColor, style=lineStyle, width=lineThickness, extend=lineExtend)

drawDiagonalLabel(xValue, yValue, textValue, labelColor, isDownPivot) =>
    adjustedY = isDownPivot ? yValue * 1.005 : yValue * 0.995
    diagonalLabel = label.new(xValue, adjustedY, textValue, xloc.bar_index, yloc.price, #00000000, label.style_none, labelColor)
    if array.size(diagonalLabels) == maxDiagonalObjects
        label.delete(array.shift(diagonalLabels))
    array.push(diagonalLabels, diagonalLabel)

createDiagonalLabelText(yValue) =>
    yValue >= close ? "▲" : "▼"

pushManagedLine(x1, x2, y1, y2, lineColor, lineThickness, lineStyle, lineLimit, targetArray, lineExtend) =>
    newLine = drawDiagonalLine(x1, x2, y1, y2, lineColor, lineThickness, lineStyle, lineExtend)
    if array.size(targetArray) == lineLimit
        line.delete(array.shift(targetArray))
    array.push(targetArray, newLine)

// ==========================================
// Pivot storage and structure logic
// ==========================================
storePivot(barIndexValue, yValue, pivotType) =>
    if array.size(pivotValues) == maxDiagonalObjects
        array.shift(pivotValues)
        array.shift(pivotBarIndexes)
        array.shift(pivotTypes)
    array.push(pivotValues, yValue)
    array.push(pivotBarIndexes, barIndexValue)
    array.push(pivotTypes, pivotType)

getLastPivot() =>
    lastIndex = array.size(pivotValues) - 1
    x1 = array.get(pivotBarIndexes, lastIndex)
    y1 = array.get(pivotValues, lastIndex)
    [x1, y1]

addMainDiagonalLine(x2, y2) =>
    hasPivotData = array.size(pivotValues) >= 1
    if hasPivotData
        [x1, y1] = getLastPivot()
        pushManagedLine(x1, x2, y1, y2, diagonalFixedColor, diagonalLineThickness, line.style_solid, maxDiagonalObjects, diagonalLines, extend.none)

addDiagonalSrLine(xValue, yValue) =>
    previousIndex = array.size(pivotValues) - 2
    if showDiagonalSrLines and previousIndex >= 0
        previousPivotType = array.get(pivotTypes, previousIndex)
        previousPivotValue = array.get(pivotValues, previousIndex)
        previousXValue = array.get(pivotBarIndexes, previousIndex)
        srLineColor = previousPivotType == highPivotType ? extremeHighLineColor : extremeLowLineColor
        pushManagedLine(previousXValue, xValue, previousPivotValue, yValue, srLineColor, diagonalLineThickness, line.style_dashed, diagonalSrLineCount, diagonalSrLines, extend.right)

// Zigzag detection adapted for Pine Script v6.
calculateZigzag(depthValue, deviationValue) =>
    var lowIndex = 1
    var highIndex = 1
    lowIndex := lowIndex + 1
    highIndex := highIndex + 1

    lowestBarOffset = -ta.lowestbars(depthValue)
    highestBarOffset = -ta.highestbars(depthValue)
    isMakingLow = lowIndex == lowestBarOffset or low - low[lowestBarOffset] > deviationValue * syminfo.mintick
    isMakingHigh = highIndex == highestBarOffset or high[highestBarOffset] - high > deviationValue * syminfo.mintick
    barsSinceNoHigh = ta.barssince(not isMakingHigh)
    barsSinceNoLow = ta.barssince(not isMakingLow)
    isDownSwing = barsSinceNoHigh > barsSinceNoLow
    hasHigherLow = low[lowIndex] > low[lowestBarOffset]
    hasLowerHigh = high[highIndex] < high[highestBarOffset]

    if lowIndex != lowestBarOffset and (not isDownSwing[1] or hasHigherLow)
        lowIndex := lowestBarOffset < highIndex ? lowestBarOffset : 0
        lowIndex
    if highIndex != highestBarOffset and (isDownSwing[1] or hasLowerHigh)
        highIndex := highestBarOffset < lowIndex ? highestBarOffset : 0
        highIndex

    [isDownSwing != isDownSwing[1], lowIndex, highIndex, isDownSwing]

// ==========================================
// Horizontal level helpers
// ==========================================
getLevelColor(yValue) =>
    yValue > close ? levelAbovePriceColor : levelBelowPriceColor

drawHorizontalLevel(x1, x2, yValue, lineColor) =>
    line.new(x1=x1, y1=yValue, x2=x2, y2=yValue, color=lineColor, style=line.style_solid, width=2)

extendAndRecolorLevels(levelArray, shouldExtend) =>
    if array.size(levelArray) > 0
        for levelIndex = array.size(levelArray) - 1 to 0 by 1
            levelLine = array.get(levelArray, levelIndex)
            x2 = line.get_x2(levelLine)
            yValue = line.get_y1(levelLine)

            if shouldExtend or (bar_index - 1 == x2 and not (high > yValue and low < yValue))
                line.set_x2(levelLine, bar_index)

            // Recolor each level every bar depending on current price relation.
            line.set_color(levelLine, getLevelColor(yValue))

addHorizontalLevel(switchDetected, lowIndex, highIndex, isDownSwing) =>
    if switchDetected
        line newLevel = na
        pivotIndex = isDownSwing ? highIndex : lowIndex
        yValue = isDownSwing ? high[pivotIndex] : low[pivotIndex]
        x1 = bar_index - pivotIndex
        x2 = bar_index

        if isDownSwing != isDownSwing[1] and not na(yValue)
            addMainDiagonalLine(x1, yValue)
            addDiagonalSrLine(x1, yValue)
            currentPivotType = isDownSwing ? highPivotType : lowPivotType
            storePivot(x1, yValue, currentPivotType)
            newLevel := drawHorizontalLevel(x1, x2, yValue, getLevelColor(yValue))

        if array.size(horizontalLevels) == maxLevelCount
            line.delete(array.shift(horizontalLevels))

        drawDiagonalLabel(x1, yValue, createDiagonalLabelText(yValue), diagonalFixedColor, isDownSwing)
        array.push(horizontalLevels, newLevel)

// ==========================================
// Main calculation flow
// ==========================================
[switchDetected, lowIndex, highIndex, isDownSwing] = calculateZigzag(pivotDepth, pivotDeviation)
addHorizontalLevel(switchDetected, lowIndex, highIndex, isDownSwing)
extendAndRecolorLevels(horizontalLevels, extendLevels)
