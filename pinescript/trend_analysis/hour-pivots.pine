//@version=6
indicator("Weekly Pivots - Full Range R5-S5", overlay=true, shorttitle="WklyPivots_Full")

// --- 1. Inputs & High-Vis Colors ---
pColor  = input.color(#00ffff, "Pivot Point") 
r1Color = input.color(#ffffff, "R1 (White)"), r2Color = input.color(#ffff00, "R2 (Yellow)")
r3Color = input.color(#ffaa00, "R3 (Orange)"), r4Color = input.color(#ff5500, "R4 (Deep Orange)")
r5Color = input.color(#ff0000, "R5 (Red)")
sColor  = input.color(#39ff14, "Support Color (Neon Green)") 

groupG   = "Graphics & Dashboard"
lineExt  = input.int(15, "Label Offset (Bars)", minval=0, group=groupG)
showDash = input.bool(true, "Show MTF Dashboard", group=groupG)

// --- 2. Global Function for Table ---
f_cell(table_id, row, label, value, val_col) => 
    table.cell(table_id, 0, row, label, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(table_id, 1, row, value, text_color=val_col, text_size=size.small, text_halign=text.align_left)

// --- 3. Pivot Calculations (Standard Floor Pivots) ---
[prevH, prevL, prevC] = request.security(syminfo.tickerid, "1W", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)

float p  = (prevH + prevL + prevC) / 3
float rng = prevH - prevL 

// Resistances
float r1 = (2 * p) - prevL
float s1 = (2 * p) - prevH
float r2 = p + rng
float s2 = p - rng
float r3 = prevH + 2 * (p - prevL)
float s3 = prevL - 2 * (prevH - p)
float r4 = p + 3 * rng
float s4 = p - 3 * rng
float r5 = p + 4 * rng
float s5 = p - 4 * rng

// --- 4. Drawing Logic ---
bool isCurrentWeek = weekofyear(time) == weekofyear(timenow) and year(time) == year(timenow)
var int weekStartBar = na
if isCurrentWeek and (na(weekStartBar[1]) or ta.change(weekofyear(time)) != 0)
    weekStartBar := bar_index

var line[] pLines = array.new_line()
var label[] pLabels = array.new_label()

if barstate.islast == true and isCurrentWeek == true and not na(weekStartBar)
    // Cleanup
    if array.size(pLines) > 0
        for i = 0 to array.size(pLines) - 1
            line.delete(array.get(pLines, i))
        array.clear(pLines)
    if array.size(pLabels) > 0
        for i = 0 to array.size(pLabels) - 1
            label.delete(array.get(pLabels, i))
        array.clear(pLabels)

    // Ensure all 11 levels are in the array
    lvls = array.from(p, r1, r2, r3, r4, r5, s1, s2, s3, s4, s5)
    nm   = array.from("P", "R1", "R2", "R3", "R4", "R5", "S1", "S2", "S3", "S4", "S5")
    clrs = array.from(pColor, r1Color, r2Color, r3Color, r4Color, r5Color, sColor, sColor, sColor, sColor, sColor)
    
    for i = 0 to array.size(lvls) - 1
        float val = array.get(lvls, i)
        color c = array.get(clrs, i)
        // Uniform lines starting at Monday open
        ln = line.new(weekStartBar, val, bar_index + lineExt, val, color=c, width=(i==0 or i==5 or i==10 ? 2 : 1))
        array.push(pLines, ln)
        lb = label.new(bar_index + lineExt, val, array.get(nm, i) + " " + str.tostring(val, format.mintick), color=color.new(color.black, 80), textcolor=c, style=label.style_label_left)
        array.push(pLabels, lb)

// --- 5. Dashboard Table ---
var table dash = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)
if barstate.islast == true and showDash == true
    trendW = close > p ? "BULL" : "BEAR"
    f_cell(dash, 0, "WEEKLY BIAS", trendW, trendW == "BULL" ? #39ff14 : #ff007f)
    f_cell(dash, 1, "PIVOT (P)", str.tostring(p, format.mintick), pColor)
    f_cell(dash, 2, "EXTREME R5", str.tostring(r5, format.mintick), r5Color)
    f_cell(dash, 3, "EXTREME S5", str.tostring(s5, format.mintick), sColor)
