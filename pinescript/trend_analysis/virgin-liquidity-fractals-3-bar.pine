//@version=6
indicator("Virgin Fractals 3-bar", overlay=true, max_labels_count=500)

// === COLORS
bearColor  = color.new(color.red, transp = 40)
bullColor  = color.new(color.lime, transp = 40)
sweptColor = color.new(color.gray, transp = 60)
fractalSize = size.auto

// === SMALL OFFSET SO TRIANGLES ARE VISIBLE
atr = ta.atr(14)
offsetY = atr * 0.2

// === 3-BAR FRACTALS
bearFractal = high[1] > high[2] and high[1] > high
bullFractal = low[1] < low[2] and low[1] < low

// === STORAGE
var label[] bearLabels = array.new_label()
var float[] bearPrices = array.new_float()
var bool[]  bearSwept  = array.new_bool()
var int[]   bearBars   = array.new_int()

var label[] bullLabels = array.new_label()
var float[] bullPrices = array.new_float()
var bool[]  bullSwept  = array.new_bool()
var int[]   bullBars   = array.new_int()

// === CREATE BEARISH FRACTAL LABEL
if bearFractal
    lbl = label.new(
         x=bar_index - 1,
         y=high[1] + offsetY,
         text="",
         xloc=xloc.bar_index,
         yloc=yloc.price,
         style=label.style_triangledown,
         color=bearColor,
         size=fractalSize)
    array.push(bearLabels, lbl)
    array.push(bearPrices, high[1])
    array.push(bearSwept, false)
    array.push(bearBars, bar_index - 1)

// === CREATE BULLISH FRACTAL LABEL
if bullFractal
    lbl = label.new(
         x=bar_index - 1,
         y=low[1] - offsetY,
         text="",
         xloc=xloc.bar_index,
         yloc=yloc.price,
         style=label.style_triangleup,
         color=bullColor,
         size=fractalSize)
    array.push(bullLabels, lbl)
    array.push(bullPrices, low[1])
    array.push(bullSwept, false)
    array.push(bullBars, bar_index - 1)

// === TURN BEARISH FRACTALS GRAY AFTER SWEEP
if array.size(bearLabels) > 0
    for i = 0 to array.size(bearLabels) - 1
        alreadySwept = array.get(bearSwept, i)
        fractalPrice = array.get(bearPrices, i)
        fractalBar   = array.get(bearBars, i)

        if not alreadySwept and bar_index > fractalBar and high > fractalPrice
            lbl = array.get(bearLabels, i)
            label.set_color(lbl, sweptColor)
            array.set(bearSwept, i, true)

// === TURN BULLISH FRACTALS GRAY AFTER SWEEP
if array.size(bullLabels) > 0
    for i = 0 to array.size(bullLabels) - 1
        alreadySwept = array.get(bullSwept, i)
        fractalPrice = array.get(bullPrices, i)
        fractalBar   = array.get(bullBars, i)

        if not alreadySwept and bar_index > fractalBar and low < fractalPrice
            lbl = array.get(bullLabels, i)
            label.set_color(lbl, sweptColor)
            array.set(bullSwept, i, true)
