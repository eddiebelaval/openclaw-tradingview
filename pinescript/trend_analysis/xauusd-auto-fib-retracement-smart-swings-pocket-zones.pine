//@version=5
indicator("XAUUSD Auto Fib Swings [Clean Final + Auto TF]", overlay=true, max_bars_back=5000, max_lines_count=200, max_labels_count=200, max_boxes_count=50)

// ============================================================================
// INPUTS
// ============================================================================
grpSwing = "Swing Detection"
useAutoTFPresets = input.bool(true, "Auto-detect timeframe presets", group=grpSwing)
leftLenManual    = input.int(10, "Manual Pivot Left Bars", minval=1, group=grpSwing)
rightLenManual   = input.int(5, "Manual Pivot Right Bars", minval=1, group=grpSwing)
anchorModeInput  = input.string("Auto", "Anchor Mode", options=["Auto", "Wick", "Body"], group=grpSwing, tooltip="Auto = Wick for intraday, Body for daily+ charts.")

grpFib = "Fib Levels"
use382     = input.bool(false, "Show 0.382", group=grpFib)
use705     = input.bool(true,  "Show 0.705", group=grpFib)
// FIX #8: Добавен toggle за 0.786
use786     = input.bool(true,  "Show 0.786", group=grpFib)
showExt    = input.bool(true,  "Show Extensions", group=grpFib)
pocketMode = input.string("0.618-0.705", "Primary Pocket", options=["0.618-0.705", "0.618-0.786"], group=grpFib)

grpVisual = "Visual"
showPocketBox    = input.bool(true,  "Show Pocket Zone", group=grpVisual)
showPivotMarkers = input.bool(true,  "Show Confirmed Pivot Markers", group=grpVisual)
showSwingLine    = input.bool(true,  "Show Active Swing Line", group=grpVisual)
showAnchorTags   = input.bool(true,  "Show Active Swing Tags", group=grpVisual)
showPriceInLabel = input.bool(false, "Show Price In Labels", group=grpVisual)
labelXOffsetManual = input.int(20,   "Manual Label X Offset (bars)", minval=5, maxval=200, group=grpVisual)
labelYOffsetATR  = input.float(0.20, "Label Y Offset (ATR x)", step=0.05, minval=0.0, maxval=3.0, group=grpVisual)
pocketAlpha      = input.int(82,     "Pocket Opacity (0-100)", minval=0, maxval=100, group=grpVisual)

// ============================================================================
// AUTO TF PRESETS
// ============================================================================
f_autoLeft() =>
    int out = na
    if timeframe.isseconds
        out := 5
    else if timeframe.isminutes and timeframe.multiplier <= 1
        out := 5
    else if timeframe.isminutes and timeframe.multiplier <= 3
        out := 6
    else if timeframe.isminutes and timeframe.multiplier <= 5
        out := 7
    else if timeframe.isminutes and timeframe.multiplier <= 15
        out := 10
    else if timeframe.isminutes and timeframe.multiplier <= 30
        out := 12
    else if timeframe.isminutes and timeframe.multiplier <= 60
        out := 14
    else if timeframe.isminutes and timeframe.multiplier <= 240
        out := 18
    else if timeframe.isdaily
        out := 20
    else if timeframe.isweekly
        out := 24
    else
        out := 28
    out

f_autoRight() =>
    int out = na
    if timeframe.isseconds
        out := 2
    else if timeframe.isminutes and timeframe.multiplier <= 1
        out := 2
    else if timeframe.isminutes and timeframe.multiplier <= 3
        out := 3
    else if timeframe.isminutes and timeframe.multiplier <= 5
        out := 4
    else if timeframe.isminutes and timeframe.multiplier <= 15
        out := 5
    else if timeframe.isminutes and timeframe.multiplier <= 30
        out := 6
    else if timeframe.isminutes and timeframe.multiplier <= 60
        out := 7
    else if timeframe.isminutes and timeframe.multiplier <= 240
        out := 9
    else if timeframe.isdaily
        out := 10
    else if timeframe.isweekly
        out := 12
    else
        out := 14
    out

f_autoLabelX() =>
    int out = na
    if timeframe.isseconds
        out := 10
    else if timeframe.isminutes and timeframe.multiplier <= 1
        out := 10
    else if timeframe.isminutes and timeframe.multiplier <= 3
        out := 12
    else if timeframe.isminutes and timeframe.multiplier <= 5
        out := 14
    else if timeframe.isminutes and timeframe.multiplier <= 15
        out := 18
    else if timeframe.isminutes and timeframe.multiplier <= 30
        out := 22
    else if timeframe.isminutes and timeframe.multiplier <= 60
        out := 26
    else if timeframe.isminutes and timeframe.multiplier <= 240
        out := 30
    else if timeframe.isdaily
        out := 36
    else if timeframe.isweekly
        out := 42
    else
        out := 48
    out

f_autoAnchorMode() =>
    string out = na
    if timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly
        out := "Body"
    else
        out := "Wick"
    out

leftLen      = useAutoTFPresets ? f_autoLeft()      : leftLenManual
rightLen     = useAutoTFPresets ? f_autoRight()     : rightLenManual
labelXOffset = useAutoTFPresets ? f_autoLabelX()    : labelXOffsetManual
anchorMode   = anchorModeInput == "Auto" ? f_autoAnchorMode() : anchorModeInput

// ============================================================================
// SOURCE FOR PIVOTS
// ============================================================================
srcHigh = anchorMode == "Wick" ? high : math.max(open, close)
srcLow  = anchorMode == "Wick" ? low  : math.min(open, close)
atr     = ta.atr(14)

// FIX #3: ATR guard — предпазва от na в началото на графиката
safeATR = na(atr) ? syminfo.mintick * 10 : atr

ph = ta.pivothigh(srcHigh, leftLen, rightLen)
pl = ta.pivotlow(srcLow,  leftLen, rightLen)

// ============================================================================
// PIVOT / SWING STATE
// ============================================================================
var float prevPivotPrice = na
var int   prevPivotBar   = na
var int   prevPivotType  = 0

var float currPivotPrice = na
var int   currPivotBar   = na
var int   currPivotType  = 0

var float swingStartPrice = na
var int   swingStartBar   = na
var int   swingStartType  = 0

var float swingEndPrice = na
var int   swingEndBar   = na
var int   swingEndType  = 0

// ============================================================================
// PROCESS HIGH PIVOT
// ============================================================================
if not na(ph)
    float newPriceH = ph
    int   newBarH   = bar_index[rightLen]
    int   newTypeH  = 1

    if currPivotType == 0
        currPivotPrice := newPriceH
        currPivotBar   := newBarH
        currPivotType  := newTypeH
    else if newTypeH == currPivotType
        if newPriceH >= currPivotPrice
            currPivotPrice := newPriceH
            currPivotBar   := newBarH
            if prevPivotType != 0 and prevPivotType != currPivotType
                swingStartPrice := prevPivotPrice
                swingStartBar   := prevPivotBar
                swingStartType  := prevPivotType
                swingEndPrice   := currPivotPrice
                swingEndBar     := currPivotBar
                swingEndType    := currPivotType
    else
        prevPivotPrice := currPivotPrice
        prevPivotBar   := currPivotBar
        prevPivotType  := currPivotType

        currPivotPrice := newPriceH
        currPivotBar   := newBarH
        currPivotType  := newTypeH

        swingStartPrice := prevPivotPrice
        swingStartBar   := prevPivotBar
        swingStartType  := prevPivotType
        swingEndPrice   := currPivotPrice
        swingEndBar     := currPivotBar
        swingEndType    := currPivotType

// ============================================================================
// PROCESS LOW PIVOT
// ============================================================================
if not na(pl)
    float newPriceL = pl
    int   newBarL   = bar_index[rightLen]
    int   newTypeL  = -1

    if currPivotType == 0
        currPivotPrice := newPriceL
        currPivotBar   := newBarL
        currPivotType  := newTypeL
    else if newTypeL == currPivotType
        if newPriceL <= currPivotPrice
            currPivotPrice := newPriceL
            currPivotBar   := newBarL
            if prevPivotType != 0 and prevPivotType != currPivotType
                swingStartPrice := prevPivotPrice
                swingStartBar   := prevPivotBar
                swingStartType  := prevPivotType
                swingEndPrice   := currPivotPrice
                swingEndBar     := currPivotBar
                swingEndType    := currPivotType
    else
        prevPivotPrice := currPivotPrice
        prevPivotBar   := currPivotBar
        prevPivotType  := currPivotType

        currPivotPrice := newPriceL
        currPivotBar   := newBarL
        currPivotType  := newTypeL

        swingStartPrice := prevPivotPrice
        swingStartBar   := prevPivotBar
        swingStartType  := prevPivotType
        swingEndPrice   := currPivotPrice
        swingEndBar     := currPivotBar
        swingEndType    := currPivotType

// ============================================================================
// SWING DIRECTION
// ============================================================================
fibLegUp   = swingStartType == -1 and swingEndType == 1
fibLegDn   = swingStartType ==  1 and swingEndType == -1
validSwing = not na(swingStartPrice) and not na(swingEndPrice) and swingStartPrice != swingEndPrice

// ============================================================================
// FIB LEVELS
// 0.000 = swing end (точката на impulse върха/дъното)
// 1.000 = swing start (точката на impulse старта)
// ============================================================================
var float fib0      = na
var float fib382    = na
var float fib500    = na
var float fib618    = na
var float fib705    = na
var float fib786    = na
var float fib100    = na
var float ext1272   = na
var float ext1618   = na
var float deepLevel = na

if validSwing
    float diff = math.abs(swingEndPrice - swingStartPrice)

    if fibLegUp
        fib0    := swingEndPrice
        fib382  := swingEndPrice - 0.382 * diff
        fib500  := swingEndPrice - 0.500 * diff
        fib618  := swingEndPrice - 0.618 * diff
        fib705  := swingEndPrice - 0.705 * diff
        fib786  := swingEndPrice - 0.786 * diff
        fib100  := swingStartPrice
        ext1272 := swingEndPrice + 0.272 * diff
        ext1618 := swingEndPrice + 0.618 * diff
    else if fibLegDn
        fib0    := swingEndPrice
        fib382  := swingEndPrice + 0.382 * diff
        fib500  := swingEndPrice + 0.500 * diff
        fib618  := swingEndPrice + 0.618 * diff
        fib705  := swingEndPrice + 0.705 * diff
        fib786  := swingEndPrice + 0.786 * diff
        fib100  := swingStartPrice
        ext1272 := swingEndPrice - 0.272 * diff
        ext1618 := swingEndPrice - 0.618 * diff

    deepLevel := pocketMode == "0.618-0.705" ? fib705 : fib786

// ============================================================================
// FIX #7: ALERTS — pocket entry detection
// ============================================================================
inPocket = validSwing and (
     fibLegUp ? (close <= fib618 and close >= deepLevel) :
     fibLegDn ? (close >= fib618 and close <= deepLevel) : false)

alertcondition(inPocket, "Price in Fib Pocket", "XAU влезе в Pocket зона (0.618–deep)!")

// ============================================================================
// DRAWING HELPERS
// ============================================================================
var line[]  fibLines  = array.new_line()
var label[] fibLabels = array.new_label()

var box   pocketBox = na
var line  swingLine = na
var label startTag  = na
var label endTag    = na

f_txt(_txt, _price) =>
    showPriceInLabel ? (_txt + " • " + str.tostring(_price, format.mintick)) : _txt

// FIX #3 (usage): ползва safeATR вместо atr директно
// FIX #4: премахнат излишния bar_index като x2 при extend.right
draw_level(_price, _txt, _col, _style, _width, _x1) =>
    if not na(_price)
        line l = line.new(_x1, _price, _x1 + 1, _price, color=_col, style=_style, width=_width, extend=extend.right)
        float y = _price + safeATR * labelYOffsetATR
        label lb = label.new(bar_index + labelXOffset, y, f_txt(_txt, _price), style=label.style_label_left, color=color.new(color.black, 10), textcolor=_col, size=size.small)
        array.push(fibLines, l)
        array.push(fibLabels, lb)

// ============================================================================
// CLEAR + REDRAW
// ============================================================================
if barstate.islast
    // FIX #6: Lines и Labels се изчистват в отделни loops — по-безопасно
    if array.size(fibLines) > 0
        for i = 0 to array.size(fibLines) - 1
            line.delete(array.get(fibLines, i))
        array.clear(fibLines)

    if array.size(fibLabels) > 0
        for i = 0 to array.size(fibLabels) - 1
            label.delete(array.get(fibLabels, i))
        array.clear(fibLabels)

    if not na(pocketBox)
        box.delete(pocketBox)
        pocketBox := na

    if not na(swingLine)
        line.delete(swingLine)
        swingLine := na

    if not na(startTag)
        label.delete(startTag)
        startTag := na

    if not na(endTag)
        label.delete(endTag)
        endTag := na

    if validSwing
        if showSwingLine
            swingLine := line.new(swingStartBar, swingStartPrice, swingEndBar, swingEndPrice, color=color.new(color.blue, 0), width=2)

        // FIX #5: Директен label style без intermediate string variable
        if showAnchorTags
            string startText = fibLegUp ? "Swing Low"  : "Swing High"
            string endText   = fibLegUp ? "Swing High" : "Swing Low"
            color  startCol  = fibLegUp ? color.new(color.lime,   0) : color.new(color.red,    0)
            color  endCol    = fibLegUp ? color.new(color.green,  0) : color.new(color.maroon, 0)

            startTag := label.new(swingStartBar, swingStartPrice, startText,
                 style     = fibLegUp ? label.style_label_up   : label.style_label_down,
                 color     = startCol,
                 textcolor = color.white,
                 size      = size.small)

            endTag := label.new(swingEndBar, swingEndPrice, endText,
                 style     = fibLegUp ? label.style_label_down : label.style_label_up,
                 color     = endCol,
                 textcolor = color.white,
                 size      = size.small)

        // FIX #1 + #2: Pocket box започва от swingEndBar (не swingStartBar)
        // и дясната граница се разширява с labelXOffset за визуален breathing room
        if showPocketBox and not na(fib618) and not na(deepLevel)
            float top = math.max(fib618, deepLevel)
            float bot = math.min(fib618, deepLevel)
            pocketBox := box.new(
                 swingEndBar,
                 top,
                 bar_index + labelXOffset,
                 bot,
                 bgcolor      = color.new(color.orange, pocketAlpha),
                 border_color = color.new(color.orange, 10),
                 border_width = 1)

        if showExt
            draw_level(ext1618, "EXT 1.618", color.fuchsia, line.style_dashed, 2, swingStartBar)
            draw_level(ext1272, "EXT 1.272", color.purple,  line.style_dashed, 2, swingStartBar)

        draw_level(fib0,   "0.000", color.new(color.blue,  0), line.style_solid,  2, swingStartBar)

        if use382
            draw_level(fib382, "0.382", color.new(color.green, 0), line.style_dotted, 1, swingStartBar)

        draw_level(fib500, "0.500", color.new(color.aqua,   0), line.style_dashed, 2, swingStartBar)
        draw_level(fib618, "0.618", color.new(color.orange, 0), line.style_solid,  3, swingStartBar)

        if use705
            draw_level(fib705, "0.705", color.new(color.yellow, 0), line.style_solid, 3, swingStartBar)

        // FIX #8: Показва 0.786 само ако е включено
        if use786
            draw_level(fib786, "0.786", color.new(color.red, 0), line.style_solid, 3, swingStartBar)

        draw_level(fib100, "1.000", color.new(color.silver, 0), line.style_dashed, 2, swingStartBar)

// ============================================================================
// PIVOT MARKERS
// ============================================================================
phPlot = showPivotMarkers ? ph : na
plPlot = showPivotMarkers ? pl : na

plotshape(phPlot, title="Pivot High", style=shape.circle, location=location.absolute, color=color.new(color.red,  0), size=size.tiny, offset=-rightLen)
plotshape(plPlot, title="Pivot Low",  style=shape.circle, location=location.absolute, color=color.new(color.lime, 0), size=size.tiny, offset=-rightLen)
