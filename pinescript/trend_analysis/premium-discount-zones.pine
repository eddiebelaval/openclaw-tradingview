//@version=6
indicator("Premium / Discount Zones", overlay=true, max_boxes_count=500, max_labels_count=500)

//──────────────────────────────────────────────────────────────────────────────
// INPUTS
//──────────────────────────────────────────────────────────────────────────────
grpZones  = "Zones"
rangeLen  = input.int(50, "Range Length (bars)", minval=5, maxval=500, group=grpZones)
styleMode = input.string("Colored", "Style", options=["Colored","Monochrome"], group=grpZones)

premiumColorIn     = input.color(#F23645, "Premium Color", group=grpZones)
equilibriumColorIn = input.color(#878b94, "Equilibrium Color", group=grpZones)
discountColorIn    = input.color(#089981, "Discount Color", group=grpZones)

grpUI      = "UI"
showLabels = input.bool(true, "Show Labels", group=grpUI)

//──────────────────────────────────────────────────────────────────────────────
// COLORS (Style handling)
//──────────────────────────────────────────────────────────────────────────────
MONO_LIGHT = color.new(#b2b5be, 0)
MONO_DARK  = color.new(#5d606b, 0)

premiumColor     = styleMode == "Monochrome" ? MONO_DARK  : premiumColorIn
discountColor    = styleMode == "Monochrome" ? MONO_LIGHT : discountColorIn
equilibriumColor = styleMode == "Monochrome" ? color.new(#878b94, 0) : equilibriumColorIn

bgAlpha = 80

//──────────────────────────────────────────────────────────────────────────────
// STATE
//──────────────────────────────────────────────────────────────────────────────
var box   bPremium  = na
var box   bDiscount = na
var box   bEQ       = na

var label lPremium  = na
var label lDiscount = na
var label lEQ       = na

//──────────────────────────────────────────────────────────────────────────────
// WATERMARK (fixed, not user-configurable)
//──────────────────────────────────────────────────────────────────────────────
var table wm = table.new(position.bottom_right, 1, 1)

// Sabit watermark stili (kurcalanamaz)
table.cell(
     wm, 0, 0, "tradewsamet",
     text_color=color.new(#000000, 70),
     text_size=size.large,
     bgcolor=color.new(color.black, 100)
)

//──────────────────────────────────────────────────────────────────────────────
// HELPERS
//──────────────────────────────────────────────────────────────────────────────
f_delBox(box bx) =>
    if not na(bx)
        box.delete(bx)

f_delLabel(label lb) =>
    if not na(lb)
        label.delete(lb)

//──────────────────────────────────────────────────────────────────────────────
// MAIN (Chart TF only)
//──────────────────────────────────────────────────────────────────────────────
if bar_index >= rangeLen
    float swingHigh = ta.highest(high, rangeLen)
    float swingLow  = ta.lowest(low,  rangeLen)

    if not na(swingHigh) and not na(swingLow)
        float top    = swingHigh
        float bottom = swingLow

        // Lux-like ratios
        float premTop    = top
        float premBottom = 0.95 * top + 0.05 * bottom

        float discTop    = 0.95 * bottom + 0.05 * top
        float discBottom = bottom

        float eqTop      = 0.525 * top + 0.475 * bottom
        float eqBottom   = 0.525 * bottom + 0.475 * top
        float eqLevel    = math.avg(top, bottom)

        int leftTime  = time[rangeLen - 1]
        int rightTime = time
        int midIndex  = bar_index - math.round((rangeLen - 1) * 0.5)

        if barstate.isnew
            // Cleanup
            f_delBox(bPremium),  f_delBox(bDiscount), f_delBox(bEQ)
            f_delLabel(lPremium), f_delLabel(lDiscount), f_delLabel(lEQ)

            // Boxes
            bPremium := box.new(leftTime, premTop, rightTime, premBottom,
                 xloc=xloc.bar_time,
                 bgcolor=color.new(premiumColor, bgAlpha),
                 border_color=premiumColor)

            bDiscount := box.new(leftTime, discTop, rightTime, discBottom,
                 xloc=xloc.bar_time,
                 bgcolor=color.new(discountColor, bgAlpha),
                 border_color=discountColor)

            bEQ := box.new(leftTime, eqTop, rightTime, eqBottom,
                 xloc=xloc.bar_time,
                 bgcolor=color.new(equilibriumColor, bgAlpha),
                 border_color=equilibriumColor)

            // Labels (optional)
            if showLabels
                lPremium := label.new(midIndex, top, "Premium",
                    xloc=xloc.bar_index, style=label.style_label_down,
                    color=color.new(color.black, 100),
                    textcolor=premiumColor, size=size.small)

                lDiscount := label.new(midIndex, bottom, "Discount",
                    xloc=xloc.bar_index, style=label.style_label_up,
                    color=color.new(color.black, 100),
                    textcolor=discountColor, size=size.small)

                lEQ := label.new(bar_index, eqLevel, "Equilibrium",
                    xloc=xloc.bar_index, style=label.style_label_left,
                    color=color.new(color.black, 100),
                    textcolor=equilibriumColor, size=size.small)
