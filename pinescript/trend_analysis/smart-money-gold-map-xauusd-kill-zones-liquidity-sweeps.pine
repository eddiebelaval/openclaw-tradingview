//@version=5
indicator("Gold Session Intelligence [DefinedEdge]",
     shorttitle="Gold Sessions",
     overlay=true,
     max_lines_count=500,
     max_boxes_count=500,
     max_labels_count=500,
     max_bars_back=500)

// ============================================================================
// GOLD SESSION INTELLIGENCE — All-in-One XAUUSD Session & Levels Tool
// ============================================================================
// Designed specifically for Gold (XAUUSD) traders.
// Combines session timing, psychological levels, Asian range mapping,
// liquidity sweep detection, and real-time session analytics.
//
// Recommended timeframes: 15m, 30m, 1H
// Non-repainting. No signals. Pure market structure intelligence.
// ============================================================================

// ─── SESSION SETTINGS ───────────────────────────────────────────────────────

string sessGrp   = "Session Settings"
string tzInput   = input.string("GMT", "Timezone", options=["GMT", "GMT+1", "GMT+2", "GMT+3", "GMT+7", "GMT+8", "GMT-4", "GMT-5", "GMT-8"], group=sessGrp, tooltip="Set to your broker's server timezone or your local timezone.")
string asianSess = input.session("2200-0600", "Asian Session", group=sessGrp, tooltip="22:00-06:00 GMT. Low volatility consolidation. Defines the range that London/NY will target.")
string londonKZ  = input.session("0700-1000", "London Kill Zone", group=sessGrp, tooltip="07:00-10:00 GMT. Most aggressive institutional price action on gold. Recommended: 15m-1H timeframes.")
string nyKZ      = input.session("1200-1500", "NY AM Kill Zone", group=sessGrp, tooltip="12:00-15:00 GMT. US data releases + continuation/reversal of London move.")
string londonFull = input.session("0600-1500", "London Full Session", group=sessGrp, tooltip="06:00-15:00 GMT. Full London session for range tracking.")
string nyFull    = input.session("1200-2100", "NY Full Session", group=sessGrp, tooltip="12:00-21:00 GMT. Full NY session for range tracking.")

// ─── DISPLAY SETTINGS ───────────────────────────────────────────────────────

string dispGrp    = "Display"
bool   showAsianBox  = input.bool(true, "Show Asian Range Box", group=dispGrp)
bool   showLondonBG  = input.bool(true, "Highlight London Kill Zone", group=dispGrp)
bool   showNYBG      = input.bool(true, "Highlight NY Kill Zone", group=dispGrp)
bool   showSessLabels = input.bool(true, "Show Session Labels (LDN/NY)", group=dispGrp, tooltip="Shows a label at the start of each kill zone.")
bool   showSweeps    = input.bool(true, "Show Asian Sweep Detection", group=dispGrp)
bool   showPsychLvls = input.bool(true, "Show Psychological Levels", group=dispGrp)
bool   showMidpoints = input.bool(false, "Show $25 Midpoints", group=dispGrp, tooltip="Show $25 levels between the major $50 levels.")
bool   showDash      = input.bool(true, "Show Dashboard", group=dispGrp)
bool   showSessionRanges = input.bool(true, "Show Session High/Low Lines", group=dispGrp)

// ─── PSYCHOLOGICAL LEVELS ───────────────────────────────────────────────────

string psychGrp  = "Psychological Levels"
float  majorStep = input.float(100.0, "Major Level Step ($)", minval=25.0, maxval=500.0, step=25.0, group=psychGrp, tooltip="$100 = round hundreds (5000, 5100, 5200). Gold's strongest S/R levels.")
float  minorStep = input.float(50.0, "Minor Level Step ($)", minval=10.0, maxval=100.0, step=10.0, group=psychGrp, tooltip="$50 = half-hundreds (5050, 5150, 5250). Secondary reaction levels.")
int    numLevels = input.int(3, "Levels Above/Below Price", minval=1, maxval=10, group=psychGrp, tooltip="How many levels to show above and below current price.")
color  majorCol  = input.color(color.new(#ffd700, 20), "Major Level Color", group=psychGrp)
color  minorCol  = input.color(color.new(#ffd700, 60), "Minor Level Color", group=psychGrp)
color  midCol    = input.color(color.new(#ffd700, 80), "$25 Midpoint Color", group=psychGrp)

// ─── STYLE SETTINGS ─────────────────────────────────────────────────────────

string styleGrp   = "Style"
color  asianBoxCol = input.color(color.new(#ffa726, 85), "Asian Range Box", group=styleGrp)
color  asianBorder = input.color(color.new(#ffa726, 40), "Asian Range Border", group=styleGrp)
color  londonBGCol = input.color(color.new(#42a5f5, 90), "London KZ Background", group=styleGrp)
color  nyBGCol     = input.color(color.new(#ab47bc, 90), "NY KZ Background", group=styleGrp)
color  sweepBullCol = input.color(color.new(#26a69a, 0), "Bull Sweep Color", group=styleGrp)
color  sweepBearCol = input.color(color.new(#ef5350, 0), "Bear Sweep Color", group=styleGrp)
color  londonRngCol = input.color(color.new(#42a5f5, 50), "London Range Lines", group=styleGrp)
color  nyRngCol     = input.color(color.new(#ab47bc, 50), "NY Range Lines", group=styleGrp)

// ─── ATR SETTINGS ───────────────────────────────────────────────────────────

string atrGrp  = "Volatility"
int    atrLen  = input.int(14, "ATR Length", minval=7, maxval=50, group=atrGrp)

// ============================================================================
// SESSION DETECTION
// ============================================================================

bool inAsian    = not na(time(timeframe.period, asianSess, tzInput))
bool inLondonKZ = not na(time(timeframe.period, londonKZ, tzInput))
bool inNYKZ     = not na(time(timeframe.period, nyKZ, tzInput))
bool inLondonFull = not na(time(timeframe.period, londonFull, tzInput))
bool inNYFull   = not na(time(timeframe.period, nyFull, tzInput))
bool inKillZone = inLondonKZ or inNYKZ

// Session transitions
bool asianStart    = inAsian and not inAsian[1]
bool asianEnd      = not inAsian and inAsian[1]
bool londonKZStart = inLondonKZ and not inLondonKZ[1]
bool londonKZEnd   = not inLondonKZ and inLondonKZ[1]
bool nyKZStart     = inNYKZ and not inNYKZ[1]
bool nyKZEnd       = not inNYKZ and inNYKZ[1]

// ============================================================================
// ASIAN RANGE TRACKING
// ============================================================================

var float asianHigh = na
var float asianLow  = na
var float asianHighFinal = na
var float asianLowFinal  = na
var bool  asianRangeSet = false
var int   asianStartBar = na
var int   asianEndBar   = na

if asianStart
    asianHigh := high
    asianLow  := low
    asianRangeSet := false
    asianStartBar := bar_index

if inAsian
    asianHigh := math.max(nz(asianHigh, high), high)
    asianLow  := math.min(nz(asianLow, low), low)

if asianEnd
    asianHighFinal := asianHigh
    asianLowFinal  := asianLow
    asianRangeSet  := true
    asianEndBar    := bar_index

// ─── ASIAN RANGE BOX ────────────────────────────────────────────────────────

var box asianBox = na
if showAsianBox and asianEnd
    box.delete(asianBox)
    asianBox := box.new(asianStartBar, asianHighFinal, bar_index + 200, asianLowFinal, bgcolor=asianBoxCol, border_color=asianBorder, border_width=1)

if showAsianBox and asianStart
    box.delete(asianBox)

// ============================================================================
// ASIAN SWEEP DETECTION
// ============================================================================

var bool hadBullSweep = false
var bool hadBearSweep = false

if asianStart
    hadBullSweep := false
    hadBearSweep := false

bool asianBullSweep = asianRangeSet and not inAsian and low < asianLowFinal and close > asianLowFinal and not hadBullSweep
bool asianBearSweep = asianRangeSet and not inAsian and high > asianHighFinal and close < asianHighFinal and not hadBearSweep

if asianBullSweep
    hadBullSweep := true
if asianBearSweep
    hadBearSweep := true

// Plot sweep markers (once per day only)
plotshape(showSweeps and asianBullSweep, "Bull Sweep", shape.diamond, location.belowbar, sweepBullCol, size=size.small)
plotshape(showSweeps and asianBearSweep, "Bear Sweep", shape.diamond, location.abovebar, sweepBearCol, size=size.small)

// ============================================================================
// SESSION RANGE TRACKING (London + NY)
// ============================================================================

var float londonHigh = na
var float londonLow  = na
var float nyHigh     = na
var float nyLow      = na

if inLondonFull and not inLondonFull[1]
    londonHigh := high
    londonLow  := low

if inLondonFull
    londonHigh := math.max(nz(londonHigh, high), high)
    londonLow  := math.min(nz(londonLow, low), low)

if inNYFull and not inNYFull[1]
    nyHigh := high
    nyLow  := low

if inNYFull
    nyHigh := math.max(nz(nyHigh, high), high)
    nyLow  := math.min(nz(nyLow, low), low)

// Plot session range lines
plot(showSessionRanges and inLondonFull ? londonHigh : na, "London High", londonRngCol, 1, plot.style_linebr)
plot(showSessionRanges and inLondonFull ? londonLow : na, "London Low", londonRngCol, 1, plot.style_linebr)
plot(showSessionRanges and inNYFull ? nyHigh : na, "NY High", nyRngCol, 1, plot.style_linebr)
plot(showSessionRanges and inNYFull ? nyLow : na, "NY Low", nyRngCol, 1, plot.style_linebr)

// ============================================================================
// SESSION LABELS
// ============================================================================

if showSessLabels and londonKZStart
    label.new(bar_index, high + ta.atr(14) * 0.3, "LDN", color=color.new(#42a5f5, 20), textcolor=color.white, style=label.style_label_down, size=size.tiny)

if showSessLabels and nyKZStart
    label.new(bar_index, high + ta.atr(14) * 0.3, "NY", color=color.new(#ab47bc, 20), textcolor=color.white, style=label.style_label_down, size=size.tiny)

// ============================================================================
// KILL ZONE BACKGROUNDS
// ============================================================================

bgcolor(showLondonBG and inLondonKZ ? londonBGCol : na, title="London KZ BG")
bgcolor(showNYBG and inNYKZ ? nyBGCol : na, title="NY KZ BG")

// ============================================================================
// PSYCHOLOGICAL LEVELS
// ============================================================================

if barstate.islast and showPsychLvls
    float baseMajor = math.floor(close / majorStep) * majorStep

    for i = -numLevels to numLevels
        float majorLvl = baseMajor + (i * majorStep)
        line.new(bar_index - 50, majorLvl, bar_index + 50, majorLvl, color=majorCol, width=2, style=line.style_solid, extend=extend.both)
        label.new(bar_index + 5, majorLvl, "$" + str.tostring(majorLvl, "#"), color=color.new(color.black, 100), textcolor=majorCol, style=label.style_label_left, size=size.small)

        if minorStep < majorStep
            float minorLvl = majorLvl + minorStep
            line.new(bar_index - 50, minorLvl, bar_index + 50, minorLvl, color=minorCol, width=1, style=line.style_dashed, extend=extend.both)
            label.new(bar_index + 5, minorLvl, "$" + str.tostring(minorLvl, "#"), color=color.new(color.black, 100), textcolor=minorCol, style=label.style_label_left, size=size.tiny)

        if showMidpoints
            float mid1 = majorLvl + 25.0
            float mid2 = majorLvl + 75.0
            line.new(bar_index - 50, mid1, bar_index + 50, mid1, color=midCol, width=1, style=line.style_dotted, extend=extend.both)
            line.new(bar_index - 50, mid2, bar_index + 50, mid2, color=midCol, width=1, style=line.style_dotted, extend=extend.both)

// ============================================================================
// INDICATORS FOR DASHBOARD
// ============================================================================

float atr       = ta.atr(atrLen)
float vwapVal   = ta.vwap(hlc3)
float rsiVal    = ta.rsi(close, 14)
float asianRange = asianRangeSet ? asianHighFinal - asianLowFinal : na
float londonRange = inLondonFull ? londonHigh - londonLow : na
float nyRange    = inNYFull ? nyHigh - nyLow : na

// Distance to nearest psychological levels
float nearestMajorAbove = math.ceil(close / majorStep) * majorStep
float nearestMajorBelow = math.floor(close / majorStep) * majorStep
float distAbove = nearestMajorAbove - close
float distBelow = close - nearestMajorBelow

// ============================================================================
// DASHBOARD
// ============================================================================

var table dash = table.new(position.top_right, 2, 13, bgcolor=color.new(color.black, 80), border_color=color.new(color.white, 85), border_width=1, frame_color=color.new(#ffd700, 60), frame_width=2)

if showDash and barstate.islast
    // Title
    table.cell(dash, 0, 0, "⚡ GOLD SESSIONS", text_color=#ffd700, text_size=size.small, bgcolor=color.new(#ffd700, 85), text_halign=text.align_center)
    table.merge_cells(dash, 0, 0, 1, 0)

    // Row 1: Active Session
    string sessText = inLondonKZ ? "🔵 LONDON KZ" : inNYKZ ? "🟣 NY AM KZ" : inAsian ? "🟠 ASIAN" : inLondonFull ? "LONDON" : inNYFull ? "NY" : "OFF-HOURS"
    color  sessCol  = inLondonKZ ? color.new(#42a5f5, 0) : inNYKZ ? color.new(#ab47bc, 0) : inAsian ? color.new(#ffa726, 0) : color.gray
    table.cell(dash, 0, 1, "Session", text_color=color.gray, text_size=size.normal)
    table.cell(dash, 1, 1, sessText, text_color=sessCol, text_size=size.normal)

    // Row 2: VWAP
    string vwapBias = close > vwapVal ? "PREMIUM" : "DISCOUNT"
    color  vwapCol  = close > vwapVal ? color.new(#ef5350, 0) : color.new(#26a69a, 0)
    table.cell(dash, 0, 2, "VWAP", text_color=color.gray, text_size=size.normal)
    table.cell(dash, 1, 2, vwapBias, text_color=vwapCol, text_size=size.normal)

    // Row 3: RSI
    color rsiCol = rsiVal < 30 ? color.new(#26a69a, 0) : rsiVal > 70 ? color.new(#ef5350, 0) : color.gray
    table.cell(dash, 0, 3, "RSI", text_color=color.gray, text_size=size.normal)
    table.cell(dash, 1, 3, str.tostring(rsiVal, "#.#"), text_color=rsiCol, text_size=size.normal)

    // Row 4: ATR
    table.cell(dash, 0, 4, "ATR", text_color=color.gray, text_size=size.normal)
    table.cell(dash, 1, 4, "$" + str.tostring(atr, "#.#"), text_color=color.white, text_size=size.normal)

    // Row 5: Asian Range
    string arText = asianRangeSet ? "$" + str.tostring(asianRange, "#.#") : "..."
    table.cell(dash, 0, 5, "Asian Rng", text_color=color.gray, text_size=size.normal)
    table.cell(dash, 1, 5, arText, text_color=color.new(#ffa726, 0), text_size=size.normal)

    // Row 6: Asian Sweep Status
    string sweepText = hadBullSweep and hadBearSweep ? "BOTH" : hadBullSweep ? "LOW ✓" : hadBearSweep ? "HIGH ✓" : "None"
    color  sweepCol  = hadBullSweep or hadBearSweep ? color.new(#ffd700, 0) : color.gray
    table.cell(dash, 0, 6, "Sweep", text_color=color.gray, text_size=size.normal)
    table.cell(dash, 1, 6, sweepText, text_color=sweepCol, text_size=size.normal)

    // Row 7: London Range
    string lrText = inLondonFull ? "$" + str.tostring(londonRange, "#.#") : "—"
    table.cell(dash, 0, 7, "LDN Rng", text_color=color.gray, text_size=size.normal)
    table.cell(dash, 1, 7, lrText, text_color=color.new(#42a5f5, 0), text_size=size.normal)

    // Row 8: NY Range
    string nrText = inNYFull ? "$" + str.tostring(nyRange, "#.#") : "—"
    table.cell(dash, 0, 8, "NY Rng", text_color=color.gray, text_size=size.normal)
    table.cell(dash, 1, 8, nrText, text_color=color.new(#ab47bc, 0), text_size=size.normal)

    // Row 9: Nearest Resistance
    table.cell(dash, 0, 9, "Resist", text_color=color.gray, text_size=size.normal)
    table.cell(dash, 1, 9, "$" + str.tostring(nearestMajorAbove, "#") + " (" + str.tostring(distAbove, "#") + ")", text_color=#ffd700, text_size=size.normal)

    // Row 10: Nearest Support
    table.cell(dash, 0, 10, "Support", text_color=color.gray, text_size=size.normal)
    table.cell(dash, 1, 10, "$" + str.tostring(nearestMajorBelow, "#") + " (" + str.tostring(distBelow, "#") + ")", text_color=#ffd700, text_size=size.normal)

    // Row 11: Psych Zone Position
    float rangePct = majorStep > 0 ? (close - nearestMajorBelow) / majorStep * 100 : 0
    string rangePos = rangePct < 25 ? "NEAR SUPPORT" : rangePct > 75 ? "NEAR RESIST" : "MID-RANGE"
    color  rangePosCol = rangePct < 25 ? color.new(#26a69a, 0) : rangePct > 75 ? color.new(#ef5350, 0) : color.gray
    table.cell(dash, 0, 11, "Zone", text_color=color.gray, text_size=size.normal)
    table.cell(dash, 1, 11, rangePos, text_color=rangePosCol, text_size=size.normal)

    // Row 12: Volatility Context
    string volCtx = na(asianRange) ? "—" : asianRange > atr * 1.5 ? "WIDE" : asianRange < atr * 0.5 ? "TIGHT ⚡" : "NORMAL"
    color  volCol = na(asianRange) ? color.gray : asianRange < atr * 0.5 ? color.new(#ffd700, 0) : asianRange > atr * 1.5 ? color.new(#ef5350, 0) : color.gray
    table.cell(dash, 0, 12, "Vol", text_color=color.gray, text_size=size.normal)
    table.cell(dash, 1, 12, volCtx, text_color=volCol, text_size=size.normal)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(asianBullSweep, "Asian Low Swept", "Gold Sessions: Price swept Asian low and recovered — watch for long setup")
alertcondition(asianBearSweep, "Asian High Swept", "Gold Sessions: Price swept Asian high and rejected — watch for short setup")
alertcondition(londonKZStart, "London Kill Zone Open", "Gold Sessions: London Kill Zone is now active")
alertcondition(nyKZStart, "NY Kill Zone Open", "Gold Sessions: NY AM Kill Zone is now active")
alertcondition(close >= nearestMajorAbove, "Hit Major Resistance", "Gold Sessions: Price reached major psychological resistance level")
alertcondition(close <= nearestMajorBelow, "Hit Major Support", "Gold Sessions: Price reached major psychological support level")
