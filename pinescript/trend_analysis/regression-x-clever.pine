//@version=5
indicator("Regression X  [Clever]", overlay=true)

// --- Inputs ---
lr_len = input.int(11, "Linear Regression Length", minval=1)
sm_len = input.int(7, "Signal Smoothing", minval=1)
show_signal = input.bool(true, "Show Signal Line")
up_color = input.color(color.rgb(14, 223, 216), "Up Color")
down_color = input.color(color.rgb(132, 85, 226), "Down Color")
buy_text_color = input.color(color.rgb(24, 23, 23, 95), "Buy Text Color")
sell_text_color = input.color(color.rgb(12, 12, 12), "Sell Text Color")
ema_len = input.int(200, "EMA Length", minval=1)
ema_color = input.color(color.white, "EMA Color")
sig_color = input.color(color.white, "Signal Line Color")
table_size = input.string(size.normal, "Table Size", options=[size.tiny, size.small, size.normal, size.large])
pv_len_l = input.int(25, "Pivot Left Bar Length", minval=1)
pv_len_r = input.int(15, "Pivot Right Bar Length", minval=1)
show_pv = input.bool(true, "Show High/Low Points")
show_sr = input.bool(true, "Show S/R Zones")
sr_transp = input.int(90, "Zone Transparency", minval=0, maxval=100)
sr_limit = input.int(5, "Max Zones to Show", minval=1, maxval=50)
sr_extend = input.bool(false, "Extend Zones to Right?")
sr_width = input.int(50, "Zone Width (if not extended)", minval=1)

// --- Linear Regression Calculation ---
// Helper function for LR calculation
calc_lr(src, len) =>
    ta.linreg(src, len, 0)

lr_open  = calc_lr(open, lr_len)
lr_high  = calc_lr(high, lr_len)
lr_low   = calc_lr(low, lr_len)
lr_close = calc_lr(close, lr_len)

// --- Signal Line ---
signal_line = ta.sma(lr_close, sm_len)

// --- EMA 200 ---
ema_200 = ta.ema(close, ema_len)

// --- Colors and Logic ---
is_up = lr_close >= lr_open
candle_color = is_up ? up_color : down_color

// --- Plotting ---
plotcandle(lr_open, lr_high, lr_low, lr_close, title="Linear Regression Candles", color=candle_color, wickcolor=candle_color, bordercolor=candle_color)

plot(show_signal ? signal_line : na, color=sig_color, title="Signal Line")
plot(ema_200, color=ema_color, title="EMA 200", linewidth=2)

// --- Signals & Alerts ---
buy_signal  = ta.crossover(lr_close, signal_line)
sell_signal = ta.crossunder(lr_close, signal_line)

plotshape(buy_signal, title="Buy Signal", style=shape.labelup, location=location.belowbar, color=up_color, size=size.small, text="BUY", textcolor=buy_text_color)
plotshape(sell_signal, title="Sell Signal", style=shape.labeldown, location=location.abovebar, color=down_color, size=size.small, text="SELL", textcolor=sell_text_color)

// --- High/Low Points (Pivots) ---
ph = ta.pivothigh(high, pv_len_l, pv_len_r)
pl = ta.pivotlow(low, pv_len_l, pv_len_r)

plotshape(show_pv ? ph : na, style=shape.labeldown, location=location.abovebar, color=down_color, text="H", textcolor=color.white, offset=-pv_len_r, title="Pivot High")
plotshape(show_pv ? pl : na, style=shape.labelup, location=location.belowbar, color=up_color, text="L", textcolor=color.white, offset=-pv_len_r, title="Pivot Low")

// --- Support/Resistance Zones Management ---
var box[] res_boxes = array.new_box()
var box[] sup_boxes = array.new_box()

if show_sr
    if ph
        // Resistance Zone - Fixed to the high/low of the pivot candle
        sr_right = sr_extend ? bar_index : bar_index[pv_len_r] + sr_width
        new_res = box.new(bar_index[pv_len_r], high[pv_len_r], sr_right, low[pv_len_r], bgcolor=color.new(down_color, sr_transp), border_color=na, extend=sr_extend ? extend.right : extend.none)
        array.push(res_boxes, new_res)
        if array.size(res_boxes) > sr_limit
            box.delete(array.shift(res_boxes))
            
    if pl
        // Support Zone - Fixed to the high/low of the pivot candle
        sr_right = sr_extend ? bar_index : bar_index[pv_len_r] + sr_width
        new_sup = box.new(bar_index[pv_len_r], high[pv_len_r], sr_right, low[pv_len_r], bgcolor=color.new(up_color, sr_transp), border_color=na, extend=sr_extend ? extend.right : extend.none)
        array.push(sup_boxes, new_sup)
        if array.size(sup_boxes) > sr_limit
            box.delete(array.shift(sup_boxes))

alertcondition(buy_signal, title="LR Buy Alert", message="Linear Regression Candle Buy Signal!")
alertcondition(sell_signal, title="LR Sell Alert", message="Linear Regression Candle Sell Signal!")

// --- Dashboard Table Implementation ---

// Trend Calculation Function for MTF
get_trend(tf) =>
    o = request.security(syminfo.tickerid, tf, lr_open)
    c = request.security(syminfo.tickerid, tf, lr_close)
    c >= o ? 1 : -1

trend_1m  = get_trend("1")
trend_5m  = get_trend("5")
trend_15m = get_trend("15")
trend_1h  = get_trend("60")
trend_4h  = get_trend("240")
trend_d   = get_trend("D")

// Daily Trade Counting
var int daily_buys = 0
var int daily_sells = 0

if ta.change(time("D"))
    daily_buys := 0
    daily_sells := 0

if buy_signal
    daily_buys += 1
if sell_signal
    daily_sells += 1

// Table Creation
var table dash = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

// Helper function for table cells (Global Scope)
f_set_cell(row, label, trend, up_color, down_color, dash, t_size) =>
    t_color = trend == 1 ? up_color : down_color
    t_text  = trend == 1 ? "BULL" : "BEAR"
    table.cell(dash, 0, row, label, text_color=color.white, text_size=t_size)
    table.cell(dash, 1, row, t_text, text_color=t_color, text_size=t_size)

if barstate.islast
    // Header
    table.cell(dash, 0, 0, "Dashboard", text_color=color.white, text_size=table_size)
    table.cell(dash, 1, 0, "Status", text_color=color.white, text_size=table_size)
    
    // Daily Stats
    table.cell(dash, 0, 1, "Daily Buys", text_color=color.white, text_size=table_size)
    table.cell(dash, 1, 1, str.tostring(daily_buys), text_color=up_color, text_size=table_size)
    table.cell(dash, 0, 2, "Daily Sells", text_color=color.white, text_size=table_size)
    table.cell(dash, 1, 2, str.tostring(daily_sells), text_color=down_color, text_size=table_size)
    
    // MTF Trends
    f_set_cell(3, "Trend 1m", trend_1m, up_color, down_color, dash, table_size)
    f_set_cell(4, "Trend 5m", trend_5m, up_color, down_color, dash, table_size)
    f_set_cell(5, "Trend 15m", trend_15m, up_color, down_color, dash, table_size)
    f_set_cell(6, "Trend 1h", trend_1h, up_color, down_color, dash, table_size)
    f_set_cell(7, "Trend 4h", trend_4h, up_color, down_color, dash, table_size)
    f_set_cell(8, "Trend Daily", trend_d, up_color, down_color, dash, table_size)
