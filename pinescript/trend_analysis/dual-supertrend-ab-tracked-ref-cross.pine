//@version=6
indicator('Dual Supertrend A/B — Tracked Ref Cross', overlay = true)

// ===== INPUTS =====
PeriodsA = input(10, title = 'ATR Period A')
MultA = input(3.0, title = 'ATR Multiplier A')

PeriodsB = input(10, title = 'ATR Period B')
MultB = input(3.0, title = 'ATR Multiplier B')

src = hl2

// ===== SUPERtrend A =====
atrA = ta.atr(PeriodsA)
upA = src - MultA * atrA
upA1 = nz(upA[1], upA)
upA := close[1] > upA1 ? math.max(upA, upA1) : upA
dnA = src + MultA * atrA
dnA1 = nz(dnA[1], dnA)
dnA := close[1] < dnA1 ? math.min(dnA, dnA1) : dnA
trendA = 1
trendA := nz(trendA[1], trendA)
trendA := trendA == -1 and close > dnA1 ? 1 : trendA == 1 and close < upA1 ? -1 : trendA

// ===== SUPERtrend B =====
atrB = ta.atr(PeriodsB)
upB = src - MultB * atrB
upB1 = nz(upB[1], upB)
upB := close[1] > upB1 ? math.max(upB, upB1) : upB
dnB = src + MultB * atrB
dnB1 = nz(dnB[1], dnB)
dnB := close[1] < dnB1 ? math.min(dnB, dnB1) : dnB
trendB = 1
trendB := nz(trendB[1], trendB)
trendB := trendB == -1 and close > dnB1 ? 1 : trendB == 1 and close < upB1 ? -1 : trendB

// ===== BROKEN BANDS =====
A_white_plot = trendA == 1 ? upA : na
A_black_plot = trendA == -1 ? dnA : na
B_green_plot = trendB == 1 ? upB : na
B_red_plot = trendB == -1 ? dnB : na

plot(A_white_plot, title = 'A White (Up)', style = plot.style_linebr, linewidth = 2, color = color.new(color.white, 0))
plot(A_black_plot, title = 'A Black (Down)', style = plot.style_linebr, linewidth = 2, color = color.new(color.black, 0))
plot(B_green_plot, title = 'B Green (Up)', style = plot.style_linebr, linewidth = 2, color = color.new(color.green, 0))
plot(B_red_plot, title = 'B Red (Down)', style = plot.style_linebr, linewidth = 2, color = color.new(color.red, 0))

// ===== TRACKED REFERENCE LEVELS =====
var float A_white = na
var float A_black = na
var float B_green = na
var float B_red = na

A_white := trendA == 1 ? upA : nz(A_white[1], upA)
A_black := trendA == -1 ? dnA : nz(A_black[1], dnA)
B_green := trendB == 1 ? upB : nz(B_green[1], upB)
B_red := trendB == -1 ? dnB : nz(B_red[1], dnB)

// ===== Logic =====
sell = ta.crossunder(B_red, A_white)
buy = ta.crossover(B_green, A_black)

// Optional: only fire when the relevant color is currently active
sell := sell and trendB == -1
buy := buy and trendB == 1

plotshape(buy, title = 'BUY', text = 'BUY', style = shape.labelup, location = location.belowbar, color = color.new(color.green, 0), textcolor = color.new(color.white, 0))
plotshape(sell, title = 'SELL', text = 'SELL', style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 0), textcolor = color.new(color.white, 0))

alertcondition(buy, title = 'BUY', message = 'BUY: B green crossed above A black')
alertcondition(sell, title = 'SELL', message = 'SELL: B red crossed below A white')
