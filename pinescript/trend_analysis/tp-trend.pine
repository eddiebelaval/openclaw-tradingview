//@version=5
// @description 这是一个基于典型价格(Typical Price)的双重EMA趋势跟踪系统。
// @description 核心逻辑：利用典型价格的中轴平滑交叉，捕捉趋势启动点并进行K线颜色标记。
indicator("典型价格趋势加速器 (TP-Trend)", shorttitle="TP-Trend", overlay=true, timeframe="", timeframe_gaps=true)

// ==========================================
// 1. 输入参数 (Inputs)
// ==========================================
grp_calc = "计算参数"
src      = input.source(hlc3, "数据源 (Typical Price)", group=grp_calc)
len_fast = input.int(6, "快线EMA长度", minval=1, group=grp_calc)
len_slow = input.int(5, "慢线EMA长度 (基于快线)", minval=1, group=grp_calc)

grp_vis  = "视觉设置"
show_ema = input.bool(true, "显示辅助线", group=grp_vis)
up_col   = input.color(color.red, "看多颜色", group=grp_vis)
dn_col   = input.color(color.green, "看空颜色", group=grp_vis)

// ==========================================
// 2. 核心逻辑计算 (Core Logic)
// ==========================================
// X1: 典型价格 (High+Low+Close)/3
x1 = src

// X2: 快线 (对典型价格进行平滑)
x2 = ta.ema(x1, len_fast)

// X3: 慢线 (对快线进行二次平滑，增强趋势过滤)
x3 = ta.ema(x2, len_slow)

// 信号判定：金叉与死叉
gold_cross  = ta.crossover(x2, x3)
death_cross = ta.crossunder(x2, x3)

// ==========================================
// 3. 图表绘图与视觉增强 (Visualization)
// ==========================================
// 3.1 趋势背景与K线变色 (Bar Coloring)
// 逻辑：交叉信号优先级 > 趋势持续优先级
color final_bar_color = color.gray

if x2 >= x3
    // 多头区域：默认红色，金叉瞬间标记为黄色
    final_bar_color := gold_cross ? color.yellow : up_col
else
    // 空头区域：默认绿色，死叉瞬间标记为蓝色
    final_bar_color := death_cross ? color.blue : dn_col

barcolor(final_bar_color, title="K线着色")

// 3.2 信号图标 (Signal Shapes)
plotshape(gold_cross, 
     title     = "买入信号", 
     style     = shape.arrowup, 
     location  = location.belowbar, 
     color     = up_col, 
     textcolor = up_col, 
     size      = size.small, 
     text      = "BUY")

plotshape(death_cross, 
     title     = "卖出信号", 
     style     = shape.arrowdown, 
     location  = location.abovebar, 
     color     = dn_col, 
     textcolor = dn_col, 
     size      = size.small, 
     text      = "SELL")

// 3.3 辅助线绘图
plot(show_ema ? x2 : na, color=color.new(color.orange, 50), title="快线 X2 (EMA 6)")
plot(show_ema ? x3 : na, color=color.new(color.gray, 50),   title="慢线 X3 (EMA 5)")

// ==========================================
// 4. 警报条件 (Alerts)
// ==========================================
alertcondition(gold_cross,  title="多头金叉", message="价格出现多头趋势信号 ({{ticker}})")
alertcondition(death_cross, title="空头死叉", message="价格出现空头趋势信号 ({{ticker}})")
