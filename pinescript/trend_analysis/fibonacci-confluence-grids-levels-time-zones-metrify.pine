//@Metrify - https://creativecommons.org/licenses/by-nc-sa/4.0/
//@version=6
indicator('Fibonacci Confluence Grids (Levels + Time Zones) [Metrify]', 'Metrify Fibonacci Grids', overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 200)

// Inputs
// Core
useWicks = input.bool(true, 'Use Wicks (else Close)', display = display.none, group = 'Core')
atr_len = input.int(14, 'ATR Length', minval = 1, display = display.none, group = 'Core')

ab_mode = input.string('ZigZag', 'A–B Mode', options = ['ZigZag', 'Pivots'], group = 'A–B Engine')
minAbAtr = input.float(9.0, 'Min Size (x ATR)', minval = 0.0, step = 0.1, display = display.none, group = 'A–B Engine', inline = 'abmin', tooltip = 'Minimum price move (in ATR) to form a new A-B swing. Keeps the tool from drawing Fibs on tiny, meaningless chops.')
min_bars = input.int(5, 'Min Bars', minval = 1, maxval = 2000, display = display.none, group = 'A–B Engine', inline = 'abmin', tooltip = 'Minimum time (in bars) between point A and B. Alongside with Min Size, this ensures we only catch significant, clear market swings.')
zzMult = input.float(5.0, 'Reversal (x ATR)', minval = 0.5, step = 0.5, display = display.none, group = 'ZigZag', tooltip = 'How much price needs to pull back (in ATR) to confirm a ZigZag reversal. Higher value = fewer, bigger swings. Lower value = catches smaller micro-trends.')
pivlen = input.int(10, 'Pivot Length', minval = 1, display = display.none, group = 'Pivots')

// Price fibonacci
onlyKeyLvls = input.bool(false, 'Key Levels Only', display = display.none, group = 'Price Fib', inline = 'pfw')
hltg = input.bool(true, 'Highlight TG', display = display.none, group = 'Price Fib', inline = 'pfw')
minsepATR = input.float(2.0, 'Min Sep (x ATR)', minval = 0.0, step = 0.01, display = display.none, group = 'Price Fib', tooltip = 'Minimum vertical separation between drawn Fibonacci levels, expressed in ATR. Increase to reduce clutter when many levels overlap in tight ranges.')
prcLvls = input.text_area('0, 0.382, 0.5, 0.618, 0.786, 1, 1.272, 1.618', 'Levels (comma separated)', display = display.none, group = 'Price Fib')
t_seq = input.text_area('13, 21, 34, 55, 89', 'Time Gates Sequence (comma separated)', display = display.none, group = 'Price Fib')

// Styling
showZZ = input.bool(true, '', display = display.none, group = 'Styling', inline = 'zzS')
zzc = input.color(color.new(color.blue, 0), 'ZigZag', display = display.none, group = 'Styling', inline = 'zzS')
zz_w = input.int(1, '', minval = 1, maxval = 4, display = display.none, group = 'Styling', inline = 'zzS')
zzStyle = input.string('Solid', '', options = ['Solid', 'Dotted', 'Dashed'], display = display.none, group = 'Styling', inline = 'zzS')
show_pf = input.bool(true, '', display = display.none, group = 'Styling', inline = 'pfS')
fibUpC = input.color(color.new(color.lime, 0), 'Price Fib Up', display = display.none, group = 'Styling', inline = 'pfS')
fibDn_c = input.color(color.new(color.red, 0), 'Down', display = display.none, group = 'Styling', inline = 'pfS')
f_w = input.int(2, '', minval = 1, maxval = 4, display = display.none, group = 'Styling', inline = 'pfS')
fibSty = input.string('Solid', '', options = ['Solid', 'Dotted', 'Dashed'], display = display.none, group = 'Styling', inline = 'pfS')
showTg = input.bool(true, '', display = display.none, group = 'Styling', inline = 'tgS')
tg_col = input.color(color.new(color.aqua, 0), 'Time Gates', display = display.none, group = 'Styling', inline = 'tgS')
tgSpine = input.string('Solid', '', options = ['Solid', 'Dotted', 'Dashed'], display = display.none, group = 'Styling', inline = 'tgS')
frzLastGate = input.bool(false, 'Freeze Until Last Gate', display = display.none, group = 'A–B Engine', tooltip = 'If enabled, the active A→B anchor (and its time gates/heatmap) will not update until the furthest time gate has fully passed. Reduces visual churn.')

// Swing line styling
show_AB = input.bool(true, '', display = display.none, group = 'Styling', inline = 'abS')
abw = input.int(2, 'A→B', minval = 1, maxval = 4, display = display.none, group = 'Styling', inline = 'abS')
abStyle = input.string('Dashed', '', options = ['Solid', 'Dotted', 'Dashed'], display = display.none, group = 'Styling', inline = 'abS')
showLbls = input.bool(true, 'Show Labels', display = display.none, group = 'Styling')

// Custom functions
atr = ta.atr(atr_len)
parseFloatArr(str_input) =>
    string clnStr = str.replace_all(str.replace_all(str_input, ' ', ''), '\n', '')
    array<string> pts = str.split(clnStr, ',')
    array<float> resFloat = array.new_float()
    for i = 0 to array.size(pts) - 1 by 1
        float valF = str.tonumber(array.get(pts, i))
        if not na(valF)
            array.push(resFloat, valF)
    resFloat

parse_int_csv(s_in) =>
    string clean_s = str.replace_all(str.replace_all(s_in, ' ', ''), '\n', '')
    array<string> arr_parts = str.split(clean_s, ',')
    array<int> out_int = array.new_int()
    for i = 0 to array.size(arr_parts) - 1 by 1
        float vf = str.tonumber(array.get(arr_parts, i))
        if not na(vf)
            array.push(out_int, int(vf))
    out_int

calcTransp(opacityPct) =>
    int(math.max(0, math.min(100, 100 - opacityPct)))

get_ls(_s) =>
    _s == 'Dotted' ? line.style_dotted : _s == 'Dashed' ? line.style_dashed : line.style_solid

clrLines(_arr) =>
    while array.size(_arr) > 0
        line.delete(array.pop(_arr))

clear_lbls(_arr) =>
    while array.size(_arr) > 0
        label.delete(array.pop(_arr))

delBoxes(_arr) =>
    while array.size(_arr) > 0
        box.delete(array.pop(_arr))

// Parsed inputs
array<float> lvls = parseFloatArr(prcLvls)
array<int> tseq = parse_int_csv(t_seq)
float minSep = minsepATR * atr
float srcH = useWicks ? high : close
float src_l = useWicks ? low : close

// Global zigzag state
var array<line> arrZZ = array.new_line()
var float zzPrev = na
var int zzPrev_bar = na
var float zzLast = na
var int zzLastB = na
var float zzExt = na
var int zzExtBar = na
var int zDir = 0 

// Initialize zigzag
if barstate.isfirst
    zzLast := close
    zzLastB := bar_index
    zzPrev := na
    zzPrev_bar := na
    zzExt := zzLast
    zzExtBar := zzLastB
    zDir := 0
    zDir

// Update zigzag
if showZZ
    float thresh = zzMult * atr

    if zDir == 0
        if srcH - zzLast >= thresh
            zDir := +1
            zzExt := srcH
            zzExtBar := bar_index
            zzExtBar
        else if zzLast - src_l >= thresh
            zDir := -1
            zzExt := src_l
            zzExtBar := bar_index
            zzExtBar
    else if zDir == +1
        if srcH > zzExt
            zzExt := srcH
            zzExtBar := bar_index
            zzExtBar
        if zzExt - src_l >= thresh
            line seg = line.new(zzLastB, zzLast, zzExtBar, zzExt, color = zzc, width = zz_w, style = get_ls(zzStyle))
            array.push(arrZZ, seg)
            // Shift pivots
            zzPrev := zzLast
            zzPrev_bar := zzLastB
            zzLast := zzExt
            zzLastB := zzExtBar
            // Start down leg
            zDir := -1
            zzExt := src_l
            zzExtBar := bar_index
            zzExtBar
    else
        if src_l < zzExt
            zzExt := src_l
            zzExtBar := bar_index
            zzExtBar
        if srcH - zzExt >= thresh
            line seg = line.new(zzLastB, zzLast, zzExtBar, zzExt, color = zzc, width = zz_w, style = get_ls(zzStyle))
            array.push(arrZZ, seg)
            zzPrev := zzLast
            zzPrev_bar := zzLastB
            zzLast := zzExt
            zzLastB := zzExtBar
            zDir := +1
            zzExt := srcH
            zzExtBar := bar_index
            zzExtBar

// Pivot-based swing
pHigh = ta.pivothigh(useWicks ? high : close, pivlen, pivlen)
pLow = ta.pivotlow(useWicks ? low : close, pivlen, pivlen)

var float last_h = na
var int lastH_b = na
var float lastLow = na
var int lastLBar = na

var float pivA = na
var int pA_bar = na
var float piv_b = na
var int pB_b = na

if not na(pHigh)
    last_h := pHigh
    lastH_b := bar_index - pivlen
    lastH_b

if not na(pLow)
    lastLow := pLow
    lastLBar := bar_index - pivlen
    lastLBar

if not na(last_h) and not na(lastLow)
    bool isHighLatest = lastH_b > lastLBar
    if isHighLatest
        pivA := lastLow
        pA_bar := lastLBar
        piv_b := last_h
        pB_b := lastH_b
        pB_b
    else
        pivA := last_h
        pA_bar := lastH_b
        piv_b := lastLow
        pB_b := lastLBar
        pB_b

// A-B selection
float A = na
int aBar = na
float B = na
int b_bar = na

if ab_mode == 'ZigZag'
    A := zzPrev
    aBar := zzPrev_bar
    B := zzLast
    b_bar := zzLastB
    b_bar
else
    A := pivA
    aBar := pA_bar
    B := piv_b
    b_bar := pB_b
    b_bar

bool hasCand = not na(A) and not na(B) and not na(aBar) and not na(b_bar) and aBar < b_bar

// Minimum significance filter
float abSz = hasCand ? math.abs(B - A) : na
int abBars = hasCand ? b_bar - aBar : na
bool pass_min = hasCand and abSz >= minAbAtr * atr and abBars >= min_bars

// active A-B
var float actA = na
var int actA_b = na
var float act_b = na
var int actBBar = na

if pass_min
    actA := A
    actA_b := aBar
    act_b := B
    actBBar := b_bar
    actBBar

bool hasAB = not na(actA) and not na(act_b) and not na(actA_b) and not na(actBBar) and actA_b < actBBar

// Time horizon limit
int maxTLive = 0
for ti = 0 to array.size(tseq) - 1 by 1
    maxTLive := math.max(maxTLive, array.get(tseq, ti))
    maxTLive

// Optional freeze
var float lk_a = na
var int lkA_b = na
var float lk_b = na
var int lkB_bar = na

bool has_lock = not na(lk_a) and not na(lk_b) and not na(lkA_b) and not na(lkB_bar)
bool gatePassed = has_lock ? bar_index > lkB_bar + maxTLive + 1 : true // +1 for the default gate box width

if not frzLastGate
    // Follow active A-B
    lk_a := actA
    lkA_b := actA_b
    lk_b := act_b
    lkB_bar := actBBar
    lkB_bar
else
    // Init lock on active A-B
    if hasAB and not has_lock
        lk_a := actA
        lkA_b := actA_b
        lk_b := act_b
        lkB_bar := actBBar
        lkB_bar
    // Update lock after last gate passes
    if hasAB and has_lock and gatePassed and actBBar != lkB_bar
        lk_a := actA
        lkA_b := actA_b
        lk_b := act_b
        lkB_bar := actBBar
        lkB_bar

bool canDraw = not na(lk_a) and not na(lk_b) and not na(lkA_b) and not na(lkB_bar) and lkA_b < lkB_bar
int dr = canDraw ? lk_b > lk_a ? +1 : -1 : 0

// =====================================================
// Drawing containers
// =====================================================
var array<line> fibLines = array.new_line()
var array<label> f_lbls = array.new_label()
var array<box> gBoxes = array.new_box()
var array<line> gate_spines = array.new_line()
var array<line> abLines = array.new_line()

// Redraw trigger
var int lastDrawB = na
bool doRedraw = canDraw and (na(lastDrawB) or lkB_bar != lastDrawB)

if doRedraw
    lastDrawB := lkB_bar

    // Clear previous overlays
    clrLines(fibLines)
    clear_lbls(f_lbls)
    delBoxes(gBoxes)
    clrLines(gate_spines)
    clrLines(abLines)

    float rng = lk_b - lk_a

    // Right horizon
    int maxT = 0
    for ti = 0 to array.size(tseq) - 1 by 1
        maxT := math.max(maxT, array.get(tseq, ti))
        maxT
    int xRight = lkB_bar + maxT + 3 // Added standard padding

    // A-B line and anchors
    color abCol = dr == 1 ? fibUpC : fibDn_c
    if show_AB
        line aLine = line.new(lkA_b, lk_a, lkB_bar, lk_b, color = abCol, width = abw, style = get_ls(abStyle))
        array.push(abLines, aLine)

    if showLbls
        array.push(f_lbls, label.new(lkA_b, lk_a, 'A', style = label.style_label_up, textcolor = color.white, color = color.new(color.black, 100), size = size.small))
        array.push(f_lbls, label.new(lkB_bar, lk_b, 'B', style = label.style_label_up, textcolor = color.white, color = color.new(color.black, 100), size = size.small))

    // Y-span for gates
    float pad = math.max(atr * 1.0, math.abs(rng) * 0.10)
    float yMin = math.min(lk_a, lk_b)
    float y_max = math.max(lk_a, lk_b)

    // Widen span using active fib levels
    float fMin = na
    float f_max = na
    for ii = 0 to array.size(lvls) - 1 by 1
        float rr = array.get(lvls, ii)
        bool is_key2 = math.abs(rr - 0.5) < 0.0001 or math.abs(rr - 0.618) < 0.0001 or math.abs(rr - 0.786) < 0.0001 or math.abs(rr - 1.0) < 0.0001 or math.abs(rr - 1.618) < 0.0001
        if not onlyKeyLvls or is_key2
            float yy = lk_a + (lk_b - lk_a) * rr
            fMin := na(fMin) ? yy : math.min(fMin, yy)
            f_max := na(f_max) ? yy : math.max(f_max, yy)
            f_max

    if not na(fMin) and not na(f_max)
        yMin := math.min(yMin, fMin)
        y_max := math.max(y_max, f_max)
        y_max

    float top = y_max + pad
    float bot = yMin - pad

    // Draw fibs
    float lastY = na
    for i = 0 to array.size(lvls) - 1 by 1
        float r = array.get(lvls, i)
        bool is_key = math.abs(r - 0.5) < 0.0001 or math.abs(r - 0.618) < 0.0001 or math.abs(r - 0.786) < 0.0001 or math.abs(r - 1.0) < 0.0001 or math.abs(r - 1.618) < 0.0001

        if not onlyKeyLvls or is_key
            float y = lk_a + rng * r
            bool far_enough = na(lastY) ? true : math.abs(y - lastY) >= minSep
            if far_enough
                lastY := y

                color base = dr == 1 ? fibUpC : fibDn_c
                color c2 = is_key ? color.new(base, 0) : color.new(base, 35)
                int w = is_key ? math.min(4, f_w + 1) : f_w

                if show_pf
                    line ln = line.new(lkA_b, y, xRight, y, color = c2, width = w, style = get_ls(fibSty))
                    array.push(fibLines, ln)
                    if showLbls
                        array.push(f_lbls, label.new(xRight, y, str.tostring(r), style = label.style_label_left, textcolor = color.white, color = color.new(c2, 70), size = size.tiny))

    // Draw time gates
    if showTg
        for j = 0 to array.size(tseq) - 1 by 1
            int t = array.get(tseq, j)
            int xC = lkB_bar + t
            int x1 = xC - 1 
            int x2 = xC + 1
            
            if hltg
                int op_gate = j % 2 == 0 ? 22 : 14
                box g = box.new(x1, top, x2, bot, bgcolor = color.new(tg_col, calcTransp(op_gate)), border_color = color.new(tg_col, 80))
                array.push(gBoxes, g)
                
            line sp = line.new(xC, bot, xC, top, color = tg_col, width = 1, style = get_ls(tgSpine))
            array.push(gate_spines, sp)
            if showLbls
                array.push(f_lbls, label.new(xC, top, 'T ' + str.tostring(t), style = label.style_label_down, textcolor = color.new(color.aqua, 0), color = color.new(color.black, 100), size = size.tiny))
