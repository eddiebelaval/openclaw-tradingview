//@version=6
indicator("Adaptive Supertrend+", overlay=true)

//────────────────────────────
// Inputs
//────────────────────────────
length = input.int(
     10,
     "ATR Length",
     tooltip = "Number of bars used to measure volatility."
)

minFactor = input.float(
     2.0,
     "Min Factor",
     tooltip = "Smallest Supertrend multiplier tested."
)

maxFactor = input.float(
     5.0,
     "Max Factor",
     tooltip = "Largest Supertrend multiplier tested."
)

step = input.float(
     0.5,
     "Factor Step",
     tooltip = "Increment between tested multipliers."
)
perfAlpha  =10

//────────────────────────────
// ATR
//────────────────────────────
atr = ta.atr(length)

//────────────────────────────
// Storage
//────────────────────────────
var factors = array.new<float>()
var perf    = array.new<float>()
var trends  = array.new<int>()
var uppers  = array.new<float>()
var lowers  = array.new<float>()

// Initialize once
if barstate.isfirst
    stepsCount = int((maxFactor - minFactor) / step)
    for i = 0 to stepsCount
        f = minFactor + i * step
        array.push(factors, f)
        array.push(perf, 0.)
        array.push(trends, 1)
        array.push(uppers, hl2)
        array.push(lowers, hl2)

//────────────────────────────
// Compute Supertrend + Performance (per factor)
//────────────────────────────
for i = 0 to array.size(factors) - 1
    factor = array.get(factors, i)

    up = hl2 + atr * factor
    dn = hl2 - atr * factor

    upperPrev = array.get(uppers, i)
    lowerPrev = array.get(lowers, i)

    // Band ratcheting: upper band can only tighten in a downtrend, lower band can only tighten in an uptrend
    upper = close[1] < upperPrev ? math.min(up, upperPrev) : up
    lower = close[1] > lowerPrev ? math.max(dn, lowerPrev) : dn

    // Trend state: 1 = bullish, 0 = bearish — flips only on a confirmed band breach
    trend_i = array.get(trends, i)
    trend_i := close > upper ? 1 : close < lower ? 0 : trend_i

    // Performance scoring: reward the factor when price moves in the direction of its trend.
    // diff is +1 if price moved with the trend, -1 if against it, 0 if unchanged.
    diff = trend_i == 1 ? close - nz(close[1],close) : nz(close[1],close) - close
    diff := math.sign(diff)

    p = array.get(perf, i)
    p += 2 / (perfAlpha + 1) * (diff - p)

    array.set(uppers, i, upper)
    array.set(lowers, i, lower)
    array.set(trends, i, trend_i)
    array.set(perf, i, p)

//────────────────────────────
// Select BEST performing factor (hardcoded)
//────────────────────────────
var int bestIdx = 0
bestVal = array.get(perf, 0)

for i = 1 to array.size(perf) - 1
    val = array.get(perf, i)
    if val > bestVal
        bestVal := val
        bestIdx := i

targetFactor = array.get(factors, bestIdx)

//────────────────────────────
// FINAL Supertrend using selected factor
//────────────────────────────
up = hl2 + atr * targetFactor
dn = hl2 - atr * targetFactor

var float upper = na
var float lower = na
var int os = 1

upper := na(upper[1]) ? up : close[1] < upper[1] ? math.min(up, upper[1]) : up
lower := na(lower[1]) ? dn : close[1] > lower[1] ? math.max(dn, lower[1]) : dn

os := close > upper[1] ? 1 : close < lower[1] ? 0 : os[1]

//────────────────────────────
// Plot TWO Supertrend lines
//────────────────────────────
plot(os == 1 ? lower : na, title="Bullish Supertrend", color=color.teal, linewidth=2,style = plot.style_linebr)
plot(os == 0 ? upper : na, title="Bearish Supertrend", color=color.red, linewidth=2,style = plot.style_linebr)

//────────────────────────────
// Signals (always on)
//────────────────────────────
buy  = os == 1 and os[1] == 0
sell = os == 0 and os[1] == 1

plotshape(buy,  style=shape.triangleup,   location=location.belowbar, color=color.teal, size=size.tiny)
plotshape(sell, style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.tiny)
