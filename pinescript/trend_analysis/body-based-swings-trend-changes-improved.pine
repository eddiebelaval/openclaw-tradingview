//@version=5
indicator("Body-Based Swings + Trend Changes (Improved)", overlay=true, max_labels_count=500)

// ── Inputs
leftBars   = input.int(5,  "Left Bars", minval=1, group="Pivot Settings")
rightBars  = input.int(5,  "Right Bars", minval=1, group="Pivot Settings")
showSwings = input.bool(true,  "Show HH/HL/LH/LL Labels")
showPrice  = input.bool(false, "Show Price in Swing Labels")
offsetMult = input.float(0.6, "Label Offset (× ATR)", minval=0.1, step=0.1, group="Display")
showTrend  = input.bool(true,  "Show Trend Change Labels (Reversals)", group="Display")

// ── Body extremes
bodyHigh = math.max(open, close)
bodyLow  = math.min(open, close)

// ── Pivots (body only)
pHigh = ta.pivothigh(bodyHigh, leftBars, rightBars)
pLow  = ta.pivotlow(bodyLow, leftBars, rightBars)

// ── Persistent last swing values & types
var float lastHighPrice = na
var string lastHighType = na
var float lastLowPrice  = na
var string lastLowType  = na

var string trendState   = "Neutral"   // Bullish / Bearish / Neutral

if not na(pHigh)
    lastHighPrice := pHigh
    lastHighType  := na(lastHighPrice[1]) ? "HH" : pHigh > lastHighPrice[1] ? "HH" : "LH"

if not na(pLow)
    lastLowPrice := pLow
    lastLowType   := na(lastLowPrice[1]) ? "HL" : pLow > lastLowPrice[1] ? "HL" : "LL"

// ── Trend state update (simple: last swing direction dominates)
if not na(lastHighType)
    trendState := lastHighType == "HH" ? "Bullish" : "Bearish"
else if not na(lastLowType)
    trendState := lastLowType == "HL" ? "Bullish" : "Bearish"

// ── Detect reversals (trend change signals)
string revLabel = na
color revColor  = na

if showTrend
    // Bullish reversal: HL after bearish trend (or after LH/LL structure)
    if not na(pLow) and lastLowType == "HL" and trendState[1] == "Bearish"
        revLabel := "Bullish\nReversal"
        revColor := color.new(color.green, 10)
    
    // Bearish reversal: LH after bullish trend (or after HH/HL)
    if not na(pHigh) and lastHighType == "LH" and trendState[1] == "Bullish"
        revLabel := "Bearish\nReversal"
        revColor := color.new(color.red, 10)

// ── ATR for dynamic spacing
atr = ta.atr(14)

// ── Swing labels with offset
if showSwings and not na(pHigh)
    string txtH = showPrice ? lastHighType + "\n" + str.tostring(pHigh, format.mintick) : lastHighType
    colH = lastHighType == "HH" ? color.green : color.red
    yPosH = pHigh + atr * offsetMult
    label.new(bar_index - rightBars, yPosH, txtH,
         color=colH, textcolor=color.white, style=label.style_label_down, size=size.normal)

if showSwings and not na(pLow)
    string txtL = showPrice ? lastLowType + "\n" + str.tostring(pLow, format.mintick) : lastLowType
    colL = lastLowType == "HL" ? color.green : color.red
    yPosL = pLow - atr * offsetMult
    label.new(bar_index - rightBars, yPosL, txtL,
         color=colL, textcolor=color.white, style=label.style_label_up, size=size.normal)

// ── Trend reversal labels (placed near the confirming pivot)
if not na(revLabel)
    bool isBullRev = str.contains(revLabel, "Bullish")
    float yRev = isBullRev ? nz(pLow, pHigh) - atr * offsetMult : nz(pHigh, pLow) + atr * offsetMult
    stlRev = isBullRev ? label.style_label_up : label.style_label_down
    label.new(bar_index - rightBars, yRev, revLabel,
         color=revColor, textcolor=color.white, style=stlRev, size=size.small)
