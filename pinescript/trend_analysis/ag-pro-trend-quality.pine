//@version=6
indicator("AG Pro Trend Quality", overlay=true, max_labels_count=50, max_lines_count=50)

//──────────────────────────────────────────────────────────────────────────────
// AG Pro Trend Quality v1.4
//──────────────────────────────────────────────────────────────────────────────

// ──────────────────────────────────────────────────────────────────────────────
// Inputs
// ──────────────────────────────────────────────────────────────────────────────
groupCore = "Core"
adxLen      = input.int(14,  "ADX Length",              minval=2, group=groupCore)
erLen       = input.int(20,  "Efficiency Length",       minval=2, group=groupCore)
slopeLen    = input.int(50,  "Slope EMA Length",        minval=2, group=groupCore)
atrLen      = input.int(14,  "ATR Length",              minval=1, group=groupCore)
threshold   = input.int(55,  "TREND Threshold (0–100)", minval=1, maxval=99, group=groupCore)
confirmBars = input.int(1,   "Confirmation Bars",       minval=1, maxval=10, group=groupCore)

strongOffset      = input.int(15, "Strong Trend Offset", minval=5, maxval=35, group=groupCore)
requireStrongHTF  = input.bool(false, "Strong Trend requires HTF Strong", group=groupCore)

groupMTF = "MTF"
useHTFConfirm = input.bool(true, "HTF Confirmation (MTF)", group=groupMTF)
autoHTF       = input.bool(true, "Auto HTF (Smart Default)", group=groupMTF)
autoHTFMode   = input.string("Strict", "Auto HTF Mode", options=["Strict","Relaxed"], group=groupMTF)
manualHTF     = input.timeframe("240", "Manual HTF Timeframe", group=groupMTF)

groupStab = "Stability"
cooldownBars  = input.int(2, "Change Cooldown Bars", minval=0, maxval=20, group=groupStab)

groupPanel = "Panel"
showPanel        = input.bool(true,  "Show Panel", group=groupPanel)
panelPosition    = input.string("Top Right", "Position",
     options=["Top Right","Top Left","Top Center","Middle Right","Middle Left","Middle Center","Bottom Right","Bottom Left","Bottom Center"], group=groupPanel)
panelTextSize    = input.string("Normal", "Text Size", options=["Tiny","Small","Normal","Large","Huge"], group=groupPanel)
topPadRows       = input.int(3, "Top Padding Rows", minval=0, maxval=12, group=groupPanel)
borderWidth      = input.int(1, "Border Width", minval=0, maxval=5, group=groupPanel)

groupLayout = "Layout"
panelLinesMode   = input.string("Auto", "Main Panel Lines", options=["Auto","1 Line","2 Lines","3 Lines"], group=groupLayout)
separatorStyle   = input.string("Bullet", "Separator Style", options=["Dot","Bullet","Pipe"], group=groupLayout)
leadSpaces       = input.int(1, "Leading Spaces", minval=0, maxval=10, group=groupLayout)

adaptiveChopLayout = input.bool(true, "Adaptive CHOP Layout (fewer lines)", group=groupLayout)

groupLabels = "Labels"
labelStyle        = input.string("Full", "Label Style", options=["Full","Short"], group=groupLabels)
smartClamp        = input.bool(true, "Smart Clamp (Auto shorten)", group=groupLabels)
maxChars          = input.int(44, "Max Chars (approx)", minval=28, maxval=80, group=groupLabels)

groupContent = "Content"
showGauge        = input.bool(false, "Show Score Gauge", group=groupContent)
gaugeWidth       = input.int(10, "Gauge Width", minval=5, maxval=20, group=groupContent)
dirStyle         = input.string("Arrows", "Direction Style", options=["Arrows","Text","Off"], group=groupContent)
showBlockedHint  = input.bool(true,  "Show BLOCK hint", group=groupContent)
hideChopPanel    = input.bool(false, "Hide Panel in CHOP", group=groupContent)

highlightBlockedRow = input.bool(true, "Highlight BLOCKED row", group=groupContent)
blockedTintStrength = input.int(78, "Blocked Tint Strength (0..95)", minval=50, maxval=95, group=groupContent)

groupBadge = "Badge"
badgeStyle       = input.string("Solid", "Style", options=["Solid","Soft","Glass"], group=groupBadge)
badgeTransp      = input.int(10, "Transparency (0..95)", minval=0, maxval=95, group=groupBadge)
trendAccent      = input.color(color.rgb(0, 120, 90),  "TREND Background", group=groupBadge)
chopAccent       = input.color(color.rgb(90, 90, 90),  "CHOP Background", group=groupBadge)
glassBg          = input.color(color.rgb(18, 18, 18),  "Glass Background", group=groupBadge)
textMode         = input.string("Auto", "Text Color Mode", options=["Auto","White","Black"], group=groupBadge)

groupPremium = "Premium Polish"
fadeChop        = input.bool(true, "Fade CHOP", group=groupPremium)
chopFadeAmount  = input.int(25, "CHOP Fade Amount", minval=0, maxval=80, group=groupPremium)
fadeChopText    = input.bool(true, "Fade CHOP Text", group=groupPremium)
chopTextFade    = input.int(35, "CHOP Text Fade", minval=0, maxval=90, group=groupPremium)
trendBoost      = input.bool(true, "Boost TREND", group=groupPremium)
trendBoostAmt   = input.int(10, "TREND Boost Amount", minval=0, maxval=40, group=groupPremium)
showSeverity     = input.bool(true, "Show Severity Tag (STRONG)", group=groupPremium)

groupHelp = "Help"
helpLines     = input.string("3 Lines", "Help Lines", options=["Off","1 Line","2 Lines","3 Lines"], group=groupHelp)
helpStyle      = input.string("Dark", "Help Background", options=["Dark","Light","Match Badge","Auto"], group=groupHelp)
helpTransp     = input.int(15, "Help Transparency (0..95)", minval=0, maxval=95, group=groupHelp)
helpRowDepth   = input.int(8, "Help Row Depth Step", minval=0, maxval=25, group=groupHelp)
helpTextMode   = input.string("Auto", "Help Text Mode", options=["Auto","White","Black"], group=groupHelp)
helpTextSize   = input.string("Normal", "Help Text Size", options=["Tiny","Small","Normal"], group=groupHelp)
swapMainHelpBg = input.bool(true, "Swap MAIN <-> HELP backgrounds (default)", group=groupHelp)

groupChart = "Chart"
showBackground   = input.bool(true, "Background Highlight (Regime)", group=groupChart)
highlightMode    = input.string("TREND", "Highlight Mode", options=["TREND","CHOP","Both"], group=groupChart)
scorePlotMode    = input.string("Pane", "Score Plot Mode", options=["Pane","Overlay"], group=groupChart)
bgStrength       = input.int(88, "Background Strength (0..100)", minval=0, maxval=100, group=groupChart)
showScorePlot    = input.bool(false, "Plot Score", group=groupChart)

groupEvents = "Events"
showEvents       = input.bool(false, "Show Minimal Event Markers", group=groupEvents)

groupAlerts = "Alerts"
alertBlocked      = input.bool(true, "Alert: HTF Blocked/Unblocked", group=groupAlerts)

// ──────────────────────────────────────────────────────────────────────────────
// Helpers
// ──────────────────────────────────────────────────────────────────────────────
pos =
     panelPosition == "Top Left"      ? position.top_left :
     panelPosition == "Top Center"    ? position.top_center :
     panelPosition == "Top Right"     ? position.top_right :
     panelPosition == "Middle Left"   ? position.middle_left :
     panelPosition == "Middle Center" ? position.middle_center :
     panelPosition == "Middle Right"  ? position.middle_right :
     panelPosition == "Bottom Left"   ? position.bottom_left :
     panelPosition == "Bottom Center" ? position.bottom_center :
                                       position.bottom_right

txtSize = size.normal
if panelTextSize == "Tiny"
    txtSize := size.tiny
else if panelTextSize == "Small"
    txtSize := size.small
else if panelTextSize == "Large"
    txtSize := size.large
else if panelTextSize == "Huge"
    txtSize := size.huge
else
    txtSize := size.normal

helpSize = size.small
if helpTextSize == "Tiny"
    helpSize := size.tiny
else if helpTextSize == "Normal"
    helpSize := size.normal
else
    helpSize := size.small

sep = " • "
if separatorStyle == "Dot"
    sep := " · "
else if separatorStyle == "Pipe"
    sep := " | "
else
    sep := " • "

f_spaces(n) =>
    string s = ""
    if n > 0
        for i = 0 to n - 1
            s := s + " "
    s
pad = f_spaces(leadSpaces)

f_luma(c) =>
    float(color.r(c)) * 0.2126 + float(color.g(c)) * 0.7152 + float(color.b(c)) * 0.0722

f_textColorMode(bgBase, mode) =>
    color tc = color.white
    if mode == "White"
        tc := color.white
    else if mode == "Black"
        tc := color.black
    else
        tc := f_luma(bgBase) > 140.0 ? color.black : color.white
    tc

f_fmtTf(tfStr) =>
    string out = tfStr
    float n = str.tonumber(tfStr)
    if not na(n)
        if n >= 1440
            out := str.tostring(math.round(n / 1440.0)) + "D"
        else if n >= 60
            out := str.tostring(math.round(n / 60.0)) + "H"
        else
            out := str.tostring(math.round(n)) + "m"
    out

f_autoHTF(_sec, _mode) =>
    string tf = "M"
    if _mode == "Strict"
        if _sec <= 30 * 60
            tf := "240"
        else if _sec <= 2 * 60 * 60
            tf := "D"
        else if _sec <= 24 * 60 * 60
            tf := "W"
        else
            tf := "M"
    else
        if _sec <= 30 * 60
            tf := "60"
        else if _sec <= 2 * 60 * 60
            tf := "240"
        else if _sec <= 12 * 60 * 60
            tf := "D"
        else if _sec <= 24 * 60 * 60
            tf := "W"
        else
            tf := "M"
    tf

chartSec = timeframe.in_seconds(timeframe.period)
autoTf   = f_autoHTF(chartSec, autoHTFMode)
htfTf    = autoHTF ? autoTf : manualHTF
htfLabel = f_fmtTf(htfTf)

// Help lines count
int helpN = 0
if helpLines == "Off"
    helpN := 0
else if helpLines == "1 Line"
    helpN := 1
else if helpLines == "2 Lines"
    helpN := 2
else
    helpN := 3

// Label style
f_lbl_TQ() =>
    labelStyle == "Full" ? "Trend Quality" : "TQ"
f_lbl_Score() =>
    "Score"
f_lbl_Dir() =>
    labelStyle == "Full" ? "Direction" : "Dir"
f_lbl_LTF() => "LTF"
f_lbl_HTF() => "HTF"
f_lbl_MTF() => "MTF"
f_lbl_Block() => "BLOCK"

// badge base + transp with fade/boost
f_badgeBase(_isTrend) =>
    badgeStyle == "Glass" ? glassBg : (_isTrend ? trendAccent : chopAccent)

f_badgeTransp(_isTrend, _isStrong) =>
    int t = badgeTransp
    if badgeStyle == "Soft"
        t := math.min(85, badgeTransp + 25)
    if (not _isTrend) and fadeChop
        t := math.min(95, t + chopFadeAmount)
    if _isTrend and trendBoost
        t := math.max(0, t - trendBoostAmt)
    if _isStrong
        t := math.max(0, t - 6)
    t

f_badgeBg(_isTrend, _isStrong) =>
    base = f_badgeBase(_isTrend)
    t    = f_badgeTransp(_isTrend, _isStrong)
    color.new(base, t)

f_badgeText(_isTrend) =>
    base = f_badgeBase(_isTrend)
    tc   = f_textColorMode(base, textMode)
    if (not _isTrend) and fadeChop and fadeChopText
        tc := color.new(tc, chopTextFade)
    tc

f_subBg(_isTrend, _isStrong) =>
    base = f_badgeBase(_isTrend)
    t0   = f_badgeTransp(_isTrend, _isStrong)
    t1   = math.min(95, t0 + 18)
    color.new(base, t1)

// help colors
f_helpBase(badgeBgBase) =>
    color bgBase = badgeBgBase
    if helpStyle == "Dark"
        bgBase := color.rgb(20, 20, 20)
    else if helpStyle == "Light"
        bgBase := color.rgb(245, 245, 245)
    else if helpStyle == "Match Badge"
        bgBase := badgeBgBase
    else
        bgBase := f_luma(badgeBgBase) > 140.0 ? color.rgb(20, 20, 20) : color.rgb(245, 245, 245)
    bgBase

f_helpBgEx(badgeBgBase, extra) =>
    base = f_helpBase(badgeBgBase)
    t = math.min(95, helpTransp + extra)
    color.new(base, t)

f_helpText(badgeBgBase) =>
    base = f_helpBase(badgeBgBase)
    f_textColorMode(base, helpTextMode)

// gauge
f_gauge(_score, _w) =>
    int filled = int(math.round(_w * _score / 100.0))
    string g = ""
    for i = 0 to _w - 1
        g := g + (i < filled ? "█" : "░")
    g

// direction formatting
f_dir(_up) =>
    string s = ""
    if dirStyle == "Off"
        s := ""
    else if dirStyle == "Text"
        s := _up ? "UP" : "DOWN"
    else
        s := _up ? "▲" : "▼"
    s

f_regimeTxt(_isTrend) =>
    _isTrend ? "TREND" : "CHOP"

// Smart clamp: if too long, return a shorter alternative
f_clamp(primary, alt) =>
    string out = primary
    if smartClamp
        if str.length(primary) > maxChars
            out := alt
    out

// Warning tint for BLOCKED row
f_blockTint(bg) =>
    // slight amber overlay, controlled by strength; applied as background replacement
    color.new(color.rgb(140, 90, 0), blockedTintStrength)

// ──────────────────────────────────────────────────────────────────────────────
// Core calculation
// ──────────────────────────────────────────────────────────────────────────────
f_core(_adxLen, _erLen, _slopeLen, _atrLen, _threshold, _confirmBars, _strongOffset) =>
    [pdi, mdi, adxVal] = ta.dmi(_adxLen, _adxLen)
    adxNorm = math.min(adxVal / 50.0, 1.0)

    erStep = math.abs(close - close[1])
    erDen  = ta.sma(erStep, _erLen) * _erLen
    erNum  = math.abs(close - close[_erLen])
    er     = erDen != 0.0 ? erNum / erDen : 0.0
    erNorm = math.min(math.max(er, 0.0), 1.0)

    emaVal    = ta.ema(close, _slopeLen)
    atrVal    = ta.atr(_atrLen)
    slopeRaw  = math.abs(emaVal - emaVal[1])
    slopeNorm = atrVal != 0.0 ? math.min((slopeRaw / atrVal) * 10.0, 1.0) : 0.0

    score = 100.0 * (0.45 * adxNorm + 0.35 * erNorm + 0.20 * slopeNorm)

    hyst = 3.0
    var int regime = 0
    var int trendCount = 0
    var int chopCount  = 0

    trendCandidate = score > (_threshold + hyst)
    chopCandidate  = score < (_threshold - hyst)

    trendCount := trendCandidate ? (trendCount + 1) : 0
    chopCount  := chopCandidate  ? (chopCount  + 1) : 0

    if regime == 0 and trendCount >= _confirmBars
        regime := 1
        chopCount := 0
    else if regime == 1 and chopCount >= _confirmBars
        regime := 0
        trendCount := 0

    dirUp  = pdi >= mdi
    strong = (regime == 1) and (score >= math.min(_threshold + _strongOffset, 95.0))
    [score, regime, dirUp, strong]

// confirmed HTF wrapper
f_core_confirmed(_adxLen, _erLen, _slopeLen, _atrLen, _threshold, _confirmBars, _strongOffset) =>
    [s, r, d, st] = f_core(_adxLen, _erLen, _slopeLen, _atrLen, _threshold, _confirmBars, _strongOffset)
    [barstate.isconfirmed ? s : s[1], barstate.isconfirmed ? r : r[1], barstate.isconfirmed ? d : d[1], barstate.isconfirmed ? st : st[1]]

// LTF
[scoreLTF, regLTF, dirUpLTF, strongLTF] = f_core(adxLen, erLen, slopeLen, atrLen, threshold, confirmBars, strongOffset)
isTrendLTF = regLTF == 1

// HTF
[scoreHTF, regHTF, dirUpHTF, strongHTF] = request.security(
     syminfo.tickerid, htfTf,
     f_core_confirmed(adxLen, erLen, slopeLen, atrLen, threshold, confirmBars, strongOffset),
     barmerge.gaps_off, barmerge.lookahead_off
)
isTrendHTF = regHTF == 1

// gate
isTrendRaw   = useHTFConfirm ? (isTrendLTF and isTrendHTF) : isTrendLTF
rawRegime    = isTrendRaw ? 1 : 0
blockedByHTF = useHTFConfirm and isTrendLTF and not isTrendHTF

// cooldown filter
var int regimeFinal = na
var int cd = 0
if barstate.isfirst
    regimeFinal := rawRegime
    cd := 0
else
    cd := math.max(cd - 1, 0)
    if cd > 0
        regimeFinal := regimeFinal[1]
    else
        regimeFinal := rawRegime
        if regimeFinal != regimeFinal[1]
            cd := cooldownBars

isTrend   = regimeFinal == 1
isStrong  = isTrend and strongLTF and (not requireStrongHTF or (not useHTFConfirm) or strongHTF)
isChop    = not isTrend

// Determine main lines (post-regime adaptation)
int baseLines = 3
if panelLinesMode == "1 Line"
    baseLines := 1
else if panelLinesMode == "2 Lines"
    baseLines := 2
else if panelLinesMode == "3 Lines"
    baseLines := 3
else
    if chartSec <= 60 * 60
        baseLines := 2
    else
        baseLines := 3

mainLines = baseLines
if adaptiveChopLayout and isChop
    mainLines := math.min(baseLines, 2)

// Total table rows
contentRows = mainLines + helpN
rows        = topPadRows + contentRows

// plots
scoreDisp = display.none
if showScorePlot
    scoreDisp := scorePlotMode == "Pane" ? display.pane : display.all

plot(scoreLTF, "Trend Quality Score (LTF)", display=scoreDisp)
plot(scoreHTF, "Trend Quality Score (HTF)", display=display.none)
thrPaneDisp = display.none
if showScorePlot and scorePlotMode == "Pane"
    thrPaneDisp := display.pane

plot(threshold, "Threshold (Pane)", display=thrPaneDisp)

showThrOverlay = showScorePlot and scorePlotMode == "Overlay"
hline(threshold, "Threshold", display=showThrOverlay ? display.all : display.none)

// hidden exports
plot(regimeFinal, "TQ Regime (0=CHOP,1=TREND)", display=display.none)
plot(blockedByHTF ? 1 : 0, "TQ Blocked By HTF (0/1)", display=display.none)
plot(dirUpLTF ? 1 : 0, "TQ Direction UP (0/1)", display=display.none)

doBg = false
if showBackground
    if highlightMode == "Both"
        doBg := true
    else if highlightMode == "TREND"
        doBg := isTrend
    else
        doBg := not isTrend

bgCol = isTrend ? color.new(color.green, bgStrength) : color.new(color.gray, bgStrength)
bgcolor(doBg ? bgCol : na)


// minimal event markers
chopToTrend = (regimeFinal == 1 and regimeFinal[1] == 0)
trendToChop = (regimeFinal == 0 and regimeFinal[1] == 1)
plotshape(showEvents and chopToTrend, title="TQ CHOP→TREND", style=shape.circle, size=size.tiny, location=location.top, color=color.new(color.green, 0), text="")
plotshape(showEvents and trendToChop, title="TQ TREND→CHOP", style=shape.circle, size=size.tiny, location=location.top, color=color.new(color.red, 0), text="")

// ──────────────────────────────────────────────────────────────────────────────
// Panel (table) — rebuild safely when layout changes
// ──────────────────────────────────────────────────────────────────────────────
var table t = na
var int prevRows = na
var string prevPosStr = ""
var int prevBorder = na

needRebuild = barstate.isfirst
if not na(prevRows)
    if prevRows != rows
        needRebuild := true
if prevPosStr != ""
    if prevPosStr != panelPosition
        needRebuild := true
if not na(prevBorder)
    if prevBorder != borderWidth
        needRebuild := true

if needRebuild
    if not na(t)
        table.delete(t)
    t := table.new(pos, 1, rows, border_width=borderWidth)
    prevRows := rows
    prevPosStr := panelPosition
    prevBorder := borderWidth

// ──────────────────────────────────────────────────────────────────────────────
// Render panel
// ──────────────────────────────────────────────────────────────────────────────
if showPanel and not na(t)
    // clear entire table each bar (prevents leftover text when layout shrinks)
    for i = 0 to rows - 1
        table.cell(t, 0, i, "", text_size=txtSize, bgcolor=na)

    // padding
    if topPadRows > 0
        for i = 0 to topPadRows - 1
            table.cell(t, 0, i, "", text_size=txtSize, bgcolor=na)

    bool panelVisible = (not hideChopPanel) or isTrend
    baseRow = topPadRows

    if panelVisible
        // Labels
        tq = f_lbl_TQ()
        sc = f_lbl_Score()
        dr = f_lbl_Dir()

        // Severity tag
        sev = f_regimeTxt(isTrend)
        if showSeverity and isStrong
            sev := "STRONG"

        // MTF state
        mtfStr = f_lbl_MTF() + ": OFF"
        if useHTFConfirm
            mtfStr := blockedByHTF ? (f_lbl_MTF() + ": BLOCKED") : (f_lbl_MTF() + ": PASS")

        // LTF/HTF
        ltfStr  = f_lbl_LTF() + ": " + f_regimeTxt(isTrendLTF) + (isTrendLTF ? " ✓" : " ✗")
        htfStr  = f_lbl_HTF() + "(" + htfLabel + "): " + f_regimeTxt(isTrendHTF) + (isTrendHTF ? " ✓" : " ✗")

        // Direction + score
        dirStr  = f_dir(dirUpLTF)
        scoreStr = str.tostring(math.round(scoreLTF)) + "/100"
        gaugeStr = showGauge ? f_gauge(scoreLTF, gaugeWidth) : ""

        // Lines with clamp
        l1_full = pad + tq + sep + sev + sep + sc + " " + scoreStr + (showGauge ? (sep + gaugeStr) : "")
        l1_alt  = pad + "TQ" + sep + sev + sep + scoreStr + (showGauge ? (sep + gaugeStr) : "")
        line1   = f_clamp(l1_full, l1_alt)

        l2_full = pad + ltfStr + (dirStr != "" ? (sep + dr + ": " + dirStr) : "")
        l2_alt  = pad + ltfStr
        line2   = f_clamp(l2_full, l2_alt)

        blk = (showBlockedHint and blockedByHTF) ? (sep + f_lbl_Block()) : ""
        l3_full = pad + htfStr + (useHTFConfirm ? (sep + mtfStr) : "") + blk
        l3_alt  = pad + htfStr + blk
        line3   = f_clamp(l3_full, l3_alt)

        // Base colors
        badgeBase = f_badgeBase(isTrend)
        mainBg1   = f_badgeBg(isTrend, isStrong)
        mainBg2   = f_subBg(isTrend, isStrong)
        mainTc    = f_badgeText(isTrend)

        // Help backgrounds
        helpTcBase = f_helpText(badgeBase)
        helpBg0 = f_helpBgEx(badgeBase, 0)
        helpBg1 = f_helpBgEx(badgeBase, helpRowDepth)
        helpBg2 = f_helpBgEx(badgeBase, helpRowDepth * 2)

        // Swap backgrounds (default ON)
        if swapMainHelpBg
            mainBg1 := f_helpBgEx(badgeBase, 0)
            mainBg2 := f_helpBgEx(badgeBase, 10)

            helpBg0 := mainBg2
            helpBg1 := color.new(f_badgeBase(isTrend), math.min(95, f_badgeTransp(isTrend, isStrong) + 26))
            helpBg2 := color.new(f_badgeBase(isTrend), math.min(95, f_badgeTransp(isTrend, isStrong) + 30))

        // Apply blocked highlight to HTF/MTF row when present
        row3Bg = mainBg2
        if highlightBlockedRow and blockedByHTF and mainLines >= 3
            row3Bg := f_blockTint(mainBg2)

        // Write rows
        r = baseRow
        table.cell(t, 0, r, line1, text_color=mainTc, text_size=txtSize, bgcolor=mainBg1)
        r += 1

        if mainLines >= 2
            table.cell(t, 0, r, line2, text_color=mainTc, text_size=txtSize, bgcolor=mainBg2)
            r += 1

        if mainLines >= 3
            table.cell(t, 0, r, line3, text_color=mainTc, text_size=txtSize, bgcolor=row3Bg)
            r += 1

        // Help block
        if helpN > 0
            h1 = pad + "Score = ADX + ER + Slope"
            h2 = pad + "TREND when Score > Threshold (after confirm)"
            h3 = pad + "MTF: HTF confirmed → PASS / BLOCK"

            table.cell(t, 0, r, h1, text_color=helpTcBase, text_size=helpSize, bgcolor=helpBg0)
            r += 1
            if helpN >= 2
                table.cell(t, 0, r, h2, text_color=helpTcBase, text_size=helpSize, bgcolor=helpBg1)
                r += 1
            if helpN >= 3
                table.cell(t, 0, r, h3, text_color=helpTcBase, text_size=helpSize, bgcolor=helpBg2)
                r += 1

// ──────────────────────────────────────────────────────────────────────────────
// Alerts
// ──────────────────────────────────────────────────────────────────────────────
strongFinal = isStrong
blockedOn  = alertBlocked and blockedByHTF and not blockedByHTF[1]
blockedOff = alertBlocked and (not blockedByHTF) and blockedByHTF[1]

alertcondition(chopToTrend, "TQ: CHOP -> TREND", "Trend Quality -> TREND | LTF={{plot_0}} HTF={{plot_1}} | {{ticker}} {{interval}}")
alertcondition(trendToChop, "TQ: TREND -> CHOP", "Trend Quality -> CHOP  | LTF={{plot_0}} HTF={{plot_1}} | {{ticker}} {{interval}}")
alertcondition(strongFinal, "TQ: Strong Trend",  "Strong Trend regime     | LTF={{plot_0}} HTF={{plot_1}} | {{ticker}} {{interval}}")
alertcondition(blockedOn,  "TQ: HTF Blocked",   "HTF is blocking TREND (LTF=TREND, HTF=CHOP) | {{ticker}} {{interval}}")
alertcondition(blockedOff, "TQ: HTF Unblocked", "HTF no longer blocks TREND | {{ticker}} {{interval}}")
