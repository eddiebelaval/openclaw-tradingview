//@version=6
indicator("Parkinson Supertrend ~ CharonQuant",overlay = true)

showBars = input.bool(true, "Color Bars", group="UI")
src       = input.source(high, title="Source", group="Supertrend Settings")
factor    = input.float(4.0,  "Factor", minval=0.01, step=0.01, group="Supertrend Settings")
period    = input.int(30,     "Parkinson Period", minval=1, group="Volatility Settings")
ln_hl     = math.log(high / low)
ln_hl_sq  = math.pow(ln_hl, 2)
c         = 4 * math.log(2)          
park_var  = ta.rma(ln_hl_sq / c, period)
park_sigma = math.sqrt(park_var)
park_vol  = park_sigma * close     
vol       = na(park_vol) ? ta.atr(period) : park_vol
up_band_base  = src - (factor * vol)
dn_band_base  = src + (factor * vol)
var float upper = na
var float lower = na
var int   dir   = 0
upper := close[1] > upper[1] ? math.max(up_band_base, upper[1]) : up_band_base
lower := close[1] < lower[1] ? math.min(dn_band_base, lower[1]) : dn_band_base
dir   := close > lower[1] ? 1 : close < upper[1] ? -1 : nz(dir[1], 1)
supertrend = dir == 1 ? upper : lower

LongCondition  = dir ==1
ShortCondition = dir ==-1
var int CharonQuant = 0
if LongCondition and not ShortCondition
    CharonQuant := 1
if ShortCondition
    CharonQuant := -1

//plots
BULL = #D4A017
BEAR = #6B2A3A
plot(
     supertrend,
     title = "Parkinson Supertrend",
     color = CharonQuant == 1 ? BULL :
             CharonQuant == -1 ? BEAR : color.gray,
     linewidth = 2
)
plot(
     upper,
     title = "Upper Band",
     color = color.new(color.gray, 55),
     linewidth = 1
)
plot(
     lower,
     title = "Lower Band",
     color = color.new(color.gray, 55),
     linewidth = 1
)
plot(
     src,
     title = "Source Midline",
     color = color.new(color.orange, 70),
     linewidth = 2
)
barcolor(
     showBars ?
     CharonQuant == 1  ? color.new(BULL, 25) :
     CharonQuant == -1 ? color.new(BEAR, 15) : na
     : na,
     title = "Trend Bar Coloring"
)
