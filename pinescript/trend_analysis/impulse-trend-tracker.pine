//@version=6
indicator("Impulse Trend Tracker", overlay=true, max_lines_count=500)

// === USER INPUTS ======
phi                  = input.float(1.5, "Impulse Acceleration Factor (φ)", minval=1.0, step=0.001)
wickThreshold = input.float(0.382, "Wick Ratio Threshold", minval=0.0, maxval=1.0, step=0.001)
targetDisplacement   = input.float(1.0, "Target Cumulative Displacement", step=0.001)
bullColor = input.color(color.green, "Bullish Candle Color")
bearColor = input.color(color.red, "Bearish Candle Color")
neutralColor = input.color(color.rgb(54, 58, 69, 25), "Neutral Candle Color")


// === User Inputs ===
showBearishOrderBlocks = input.bool(true, title="Show Supply Zones")
showBullishOrderBlocks = input.bool(true, title="Show Demand Zones")
candleCount = input.float(3, "# of Candles for Zones", minval=1, maxval=5, step=1)
orderBlockDuration = input.int(10, title="Zone Duration (bars)")
deleteBrokenBoxes= input.bool(true, title = "Delete Broken Zones")
dimMitigatedBoxes = input.bool(true, title="Dim Mitigated Zones")
deleteMitigatedBoxes = input.bool(false, title="Delete Mitigated Zones")
bearishBlockColor = input.color(color.rgb(255, 82, 82, 50), title="Supply Zone Fill")
bearishBorderColor = input.color(color.rgb(255, 82, 82, 50), title="Supply Zone Border")
bullishBlockColor = input.color(color.rgb(76, 175, 79, 50), title="Demand Zone Fill")
bullishBorderColor = input.color(color.rgb(76, 175, 79, 50), title="Demand Zone Border")
lighterBullishColor = color.new(bullishBlockColor, 85)  // More transparent
lighterBearishColor = color.new(bearishBlockColor, 85)

// === CANDLE BODY & IMPULSE RATIO ===
body     = math.abs(close - open)
prevBody = math.abs(close[1] - open[1])
range1     = high - low
upperWick  = high - math.max(open, close)
lowerWick  = math.min(open, close) - low
impulseRatio = prevBody > 0 ? body / prevBody : na
bullWickSuppressed = range1 > 0 ? (upperWick / range1) < wickThreshold : false
bearWickSuppressed = range1 > 0 ? (lowerWick / range1) < wickThreshold : false



// Bullish / bearish candle acceleration
bullCandleAccel =
     close > open and bullWickSuppressed and (
         (not na(impulseRatio) and impulseRatio >= phi) or
         na(impulseRatio)
     )

bearCandleAccel =
     close < open and bearWickSuppressed and (
         (not na(impulseRatio) and impulseRatio >= phi) or
         na(impulseRatio)
     )


// === CUMULATIVE DISPLACEMENT ===
var float bullDisp = 0
var float bearDisp = 0
var int bullAccelIndex = na
var int bearAccelIndex = na

// Only accumulate accelerating candles
if bullCandleAccel
    bullDisp += body
if bearCandleAccel
    bearDisp += body

// Gated impulses for true alternation
bullImpulse = bullDisp >= targetDisplacement
bearImpulse = bearDisp >= targetDisplacement

// Reset displacement and update lastImpulse
if bullImpulse
    bullDisp := 0
    bullAccelIndex := bar_index

if bearImpulse
    bearDisp := 0
    bearAccelIndex := bar_index

// === CANDLE COLORING ===
barcolor(
     bullImpulse ? bullColor :
     bearImpulse ? bearColor :
     neutralColor
)


// === Track Boxes ===
var box[] bullishBoxes = array.new<box>()
var box[] bearishBoxes = array.new<box>()

// === Mitigation Flags ===
var bool bullishMitigated = false
var bool bearishMitigated = false
var bool bullishBreak = false
var bool bearishBreak = false
var float zoneHigh = na
var float zoneLow  = na
bullishMitigated := false
bearishMitigated := false


if bullImpulse or bearImpulse
    float lookback = math.min(candleCount, bar_index)
    float hh = high[1]
    float ll = low[1]
    for i = 1 to lookback
        hh := math.max(hh, high[i])
        ll := math.min(ll, low[i])
    zoneHigh := hh
    zoneLow  := ll

// === Delete invalidated boxes ===
if deleteBrokenBoxes
    if array.size(bullishBoxes) > 0
        for i = array.size(bullishBoxes) - 1 to 0
            boxItem = array.get(bullishBoxes, i)
            if close < box.get_bottom(boxItem)
                box.delete(boxItem)
                array.remove(bullishBoxes, i)

    if array.size(bearishBoxes) > 0
        for i = array.size(bearishBoxes) - 1 to 0
            boxItem = array.get(bearishBoxes, i)
            if close > box.get_top(boxItem)
                box.delete(boxItem)
                array.remove(bearishBoxes, i)

// === Delete mitigated boxes (optional) ===
if deleteMitigatedBoxes
    if array.size(bullishBoxes) > 0
        for i = array.size(bullishBoxes) - 1 to 0
            boxItem = array.get(bullishBoxes, i)
            if low < box.get_top(boxItem)
                bullishMitigated := true
                box.delete(boxItem)
                array.remove(bullishBoxes, i)
    if array.size(bearishBoxes) > 0
        for i = array.size(bearishBoxes) - 1 to 0
            boxItem = array.get(bearishBoxes, i)
            if high > box.get_bottom(boxItem)
                bearishMitigated := true
                box.delete(boxItem)
                array.remove(bearishBoxes, i)

if dimMitigatedBoxes
    if array.size(bullishBoxes) > 0
        for i = 0 to array.size(bullishBoxes) - 1
            boxItem = array.get(bullishBoxes, i)
            if low < box.get_top(boxItem)
                bullishMitigated := true
                box.set_bgcolor(boxItem, lighterBullishColor)
                box.set_border_color(boxItem, lighterBullishColor)


    if array.size(bearishBoxes) > 0
        for i = 0 to array.size(bearishBoxes) - 1
            boxItem = array.get(bearishBoxes, i)
            if high > box.get_bottom(boxItem)
                bearishMitigated := true
                box.set_bgcolor(boxItem, lighterBearishColor)
                box.set_border_color(boxItem, lighterBearishColor)

// Create new order blocks with adjusted alignment
if showBullishOrderBlocks and bullImpulse
    bullishBox = box.new(left=bar_index[candleCount], right=bar_index[candleCount] + orderBlockDuration, top=zoneHigh, bottom=zoneLow, border_color=bullishBlockColor, bgcolor=bullishBlockColor)
    array.push(bullishBoxes, bullishBox)

if showBearishOrderBlocks and bearImpulse
    bearishBox = box.new(left=bar_index[candleCount], right=bar_index[candleCount] + orderBlockDuration, top=zoneHigh, bottom=zoneLow, border_color=bearishBlockColor, bgcolor=bearishBlockColor)
    array.push(bearishBoxes, bearishBox)

// === PLOT SHAPES & ALERTS ===
plotshape(bullImpulse, style=shape.triangleup, location=location.belowbar, size=size.tiny, color=color.green, title="Bullish Impulse")
plotshape(bearImpulse, style=shape.triangledown, location=location.abovebar, size=size.tiny, color=color.red, title="Bearish Impulse")

alertcondition(bullImpulse, "Bullish Impulse", "Bullish trend impulse detected")
alertcondition(bearImpulse, "Bearish Impulse", "Bearish trend impulse detected")
