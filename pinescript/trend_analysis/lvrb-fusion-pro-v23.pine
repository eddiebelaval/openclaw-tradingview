//@version=6
indicator("LVRB Fusion PRO v2.3", shorttitle="LVRB Fusion PRO v2.3", overlay=true, max_boxes_count=150, max_lines_count=300, max_labels_count=500)

// =========================================================
// INPUTS
// =========================================================

// --- Trend
groupTrend = "1. Trend"
emaLen            = input.int(200, "EMA Length", minval=20, group=groupTrend)
useEmaSlope       = input.bool(true, "Use EMA Slope Filter", group=groupTrend)
emaSlopeLookback  = input.int(5, "EMA Slope Lookback", minval=1, group=groupTrend)

// --- Box Detection
groupBox = "2. Box Detection"
volWindow               = input.int(20, "Volatility Window", minval=5, group=groupBox)
trThreshold             = input.float(0.95, "TR <= avgTR ×", minval=0.10, maxval=2.00, step=0.05, group=groupBox)
bodyThreshold           = input.float(1.10, "Body <= avgBody ×", minval=0.10, maxval=3.00, step=0.05, group=groupBox)
minBarsInBox            = input.int(4, "Min Bars In Box", minval=3, maxval=20, group=groupBox)
maxBarsInBox            = input.int(12, "Max Bars In Box", minval=3, maxval=40, group=groupBox)
minLowVolFraction       = input.float(0.55, "Min Low-Vol Fraction", minval=0.10, maxval=1.00, step=0.05, group=groupBox)
allowedNonLowVolConsec  = input.int(2, "Allowed Consecutive Non-Low-Vol Bars", minval=0, maxval=10, group=groupBox)
maxBoxHeightATR         = input.float(1.30, "Max Box Height = ATR ×", minval=0.10, maxval=5.00, step=0.05, group=groupBox)
maxBreakoutBars         = input.int(12, "Max Bars To Wait For Breakout", minval=1, maxval=50, group=groupBox)

// --- Impulse
groupImpulse = "3. Impulse"
atrLen             = input.int(14, "ATR Length", minval=2, group=groupImpulse)
impulseLookback    = input.int(8, "Impulse Lookback", minval=2, group=groupImpulse)
impulseATRMult     = input.float(0.90, "Min Impulse Size (ATR ×)", minval=0.10, maxval=10.0, step=0.05, group=groupImpulse)
minExpansionBarATR = input.float(0.90, "At Least One Expansion Bar (ATR ×)", minval=0.10, maxval=10.0, step=0.05, group=groupImpulse)

// --- ADX / Momentum
groupADX = "4. ADX + Momentum"
adxLen          = input.int(14, "ADX Length", minval=2, group=groupADX)
adxThreshold    = input.float(20.0, "ADX Threshold", minval=1.0, maxval=100.0, step=0.5, group=groupADX)
useMomentum     = input.bool(true, "Use Momentum In Score", group=groupADX)
momLen          = input.int(20, "Momentum Length", minval=5, group=groupADX)

// --- Entry / Fake Breakout Filters
groupEntry = "5. Entry + Fake Filters"
entryMode               = input.string("Conservative", "Entry Mode", options=["Conservative", "Aggressive"], group=groupEntry)
breakoutBodyMultCons    = input.float(1.00, "Conservative Breakout Body × AvgBody", minval=0.10, maxval=5.0, step=0.05, group=groupEntry)
breakoutBodyMultAgg     = input.float(0.85, "Aggressive Breakout Body × AvgBody", minval=0.10, maxval=5.0, step=0.05, group=groupEntry)
closePosThreshold       = input.float(0.55, "Conservative Close Position In Candle", minval=0.10, maxval=0.95, step=0.05, group=groupEntry)
maxWickToBodyAgg        = input.float(1.50, "Aggressive Max Wick / Body", minval=0.10, maxval=10.0, step=0.05, group=groupEntry)
useFakeFilters          = input.bool(true, "Use Additional Fake Breakout Filters", group=groupEntry)
minBreakoutRangeATR     = input.float(0.70, "Min Breakout Candle Range (ATR ×)", minval=0.10, maxval=10.0, step=0.05, group=groupEntry)
maxOppWickRatioCons     = input.float(1.00, "Conservative Max Opposite Wick / Body", minval=0.10, maxval=10.0, step=0.05, group=groupEntry)
maxBoxRetestDepthATR    = input.float(0.25, "Max Breakout Rejection Inside Box (ATR ×)", minval=0.01, maxval=2.0, step=0.01, group=groupEntry)

// --- Market Context
groupContext = "6. BTC + TOTAL3"
useBTCBonus       = input.bool(true, "Use BTC Context", group=groupContext)
btcSymbol         = input.symbol("BINANCE:BTCUSDT", "BTC Symbol", group=groupContext)
useTOTAL3Bonus    = input.bool(true, "Use TOTAL3 Context", group=groupContext)
total3Symbol      = input.symbol("CRYPTOCAP:TOTAL3", "TOTAL3 Symbol", group=groupContext)

// --- Risk
groupRisk = "7. Risk"
slAtrBuffer      = input.float(0.15, "SL ATR Buffer", minval=0.01, maxval=5.0, step=0.01, group=groupRisk)
tp1R             = input.float(1.0, "TP1 (R)", minval=0.1, maxval=20.0, step=0.1, group=groupRisk)
tp2R             = input.float(2.0, "TP2 (R)", minval=0.1, maxval=20.0, step=0.1, group=groupRisk)
tp3R             = input.float(3.0, "TP3 (R)", minval=0.1, maxval=20.0, step=0.1, group=groupRisk)

// --- Visual
groupVisual = "8. Visual"
showEMA              = input.bool(true, "Show EMA", group=groupVisual)
showActiveLevels     = input.bool(true, "Show Active Entry/SL/TP", group=groupVisual)
showHistoricalLabel  = input.bool(true, "Show Historical Result Labels", group=groupVisual)
showPrepareState     = input.bool(true, "Color Box In Prepare State", group=groupVisual)
showScoreLabel       = input.bool(true, "Show Trade Label", group=groupVisual)
showStatsPanel       = input.bool(true, "Show Stats Panel", group=groupVisual)

// =========================================================
// HELPERS
// =========================================================

f_body(_o, _c) =>
    math.abs(_c - _o)

f_upperWick(_h, _o, _c) =>
    _h - math.max(_o, _c)

f_lowerWick(_l, _o, _c) =>
    math.min(_o, _c) - _l

f_closePos(_c, _h, _l) =>
    rng = _h - _l
    rng > 0 ? (_c - _l) / rng : 0.5

f_grade(_score) =>
    _score >= 8 ? "A" : _score >= 6 ? "B" : _score >= 5 ? "C" : "X"

f_histColor(_dir) =>
    _dir == 1 ? color.new(color.lime, 0) : color.new(color.red, 0)

f_boxBg(_dir, _isPrepare) =>
    _dir == 1 ? (_isPrepare ? color.new(color.lime, 82) : color.new(color.gray, 86)) : (_isPrepare ? color.new(color.red, 82) : color.new(color.gray, 86))

f_addReason(_base, _cond, _txt) =>
    _cond ? (_base == "" ? _txt : _base + " " + _txt) : _base

// =========================================================
// CORE SERIES
// =========================================================

ema200   = ta.ema(close, emaLen)
emaSlope = ema200 - ema200[emaSlopeLookback]

atr      = ta.atr(atrLen)
tr       = ta.tr(true)
body     = f_body(open, close)
rangeBar = high - low
avgTR    = ta.sma(tr, volWindow)
avgBody  = ta.sma(body, volWindow)
atrSma   = ta.sma(atr, 20)

[diplus, diminus, adx] = ta.dmi(adxLen, adxLen)

momentum = ta.linreg(close - ta.sma(close, momLen), momLen, 0)
momUp    = momentum > momentum[1] or momentum > 0
momDown  = momentum < momentum[1] or momentum < 0

trendLong  = close > ema200
trendShort = close < ema200
slopeLong  = not useEmaSlope or emaSlope > 0
slopeShort = not useEmaSlope or emaSlope < 0

volRegimeOK = atr > atrSma * 0.85

// BTC context
btcClose = request.security(btcSymbol, timeframe.period, close)
btcEMA   = request.security(btcSymbol, timeframe.period, ta.ema(close, emaLen))
btcSlope = request.security(btcSymbol, timeframe.period, ta.ema(close, emaLen) - ta.ema(close, emaLen)[emaSlopeLookback])
btcLongOK  = btcClose > btcEMA and btcSlope >= 0
btcShortOK = btcClose < btcEMA and btcSlope <= 0

// TOTAL3 context
t3Close = request.security(total3Symbol, timeframe.period, close)
t3EMA   = request.security(total3Symbol, timeframe.period, ta.ema(close, emaLen))
t3Slope = request.security(total3Symbol, timeframe.period, ta.ema(close, emaLen) - ta.ema(close, emaLen)[emaSlopeLookback])
t3LongOK  = t3Close > t3EMA and t3Slope >= 0
t3ShortOK = t3Close < t3EMA and t3Slope <= 0

btcScoreLong  = useBTCBonus ? (btcLongOK ? 1 : btcShortOK ? -1 : 0) : 0
btcScoreShort = useBTCBonus ? (btcShortOK ? 1 : btcLongOK ? -1 : 0) : 0
t3ScoreLong   = useTOTAL3Bonus ? (t3LongOK ? 1 : t3ShortOK ? -1 : 0) : 0
t3ScoreShort  = useTOTAL3Bonus ? (t3ShortOK ? 1 : t3LongOK ? -1 : 0) : 0

// =========================================================
// STATE
// =========================================================

var int   state                = 0
var int   dir                  = 0
var int   boxStartIndex        = na
var int   boxEndIndex          = na
var int   boxBars              = na
var float boxTop               = na
var float boxBottom            = na
var float boxAtrAtCreation     = na
var float boxHeightAtCreation  = na
var float scoreAtEntry         = na
var string gradeAtEntry        = ""
var string reasonAtEntry       = ""
var float entryPrice           = na
var float slPrice              = na
var float tp1Price             = na
var float tp2Price             = na
var float tp3Price             = na
var bool  hitTP1               = false
var bool  hitTP2               = false
var bool  hitTP3               = false

var box   activeBox            = na
var line  lineEntry            = na
var line  lineSL               = na
var line  lineTP1              = na
var line  lineTP2              = na
var line  lineTP3              = na
var label activeTradeLabel     = na

// =========================================================
// STATS
// =========================================================

var int statsTrades = 0
var int statsWins = 0
var int statsSL = 0

var int statsTP1Hit = 0
var int statsTP2Hit = 0
var int statsTP3Hit = 0

var int statsA = 0
var int statsB = 0
var int statsC = 0

var int statsLong = 0
var int statsShort = 0
var int statsLongWins = 0
var int statsShortWins = 0

var float statsScoreSum = 0.0

var table statsTable = table.new(position.bottom_right, 2, 12, border_width=1)

// =========================================================
// CANDIDATE SEARCH
// =========================================================

var bool  foundCandidate = false
var int   foundDir = 0
var int   foundBoxStart = na
var int   foundBoxEnd = na
var int   foundBoxBars = na
var float foundBoxTop = na
var float foundBoxBottom = na
var float foundBoxATR = na
var float foundBoxHeight = na
var bool  foundPrepare = false

foundCandidate := false
foundDir := 0
foundBoxStart := na
foundBoxEnd := na
foundBoxBars := na
foundBoxTop := na
foundBoxBottom := na
foundBoxATR := na
foundBoxHeight := na
foundPrepare := false

enoughBars = bar_index > (maxBarsInBox + impulseLookback + emaSlopeLookback + volWindow + 20)

if state == 0 and enoughBars
    for L = minBarsInBox to maxBarsInBox
        if not foundCandidate
            int lowVolCount = 0
            int invalidRun = 0
            int maxInvalidRun = 0
            float wTop = high
            float wBottom = low

            for j = L - 1 to 0
                isLowTR = tr[j] <= avgTR[j] * trThreshold
                isLowBody = body[j] <= avgBody[j] * bodyThreshold
                isLowVol = isLowTR and isLowBody

                if isLowVol
                    lowVolCount += 1
                    invalidRun := 0
                else
                    invalidRun += 1
                    maxInvalidRun := math.max(maxInvalidRun, invalidRun)

                wTop := math.max(wTop, high[j])
                wBottom := math.min(wBottom, low[j])

            lowVolFrac = L > 0 ? lowVolCount / L : 0.0
            boxHeight = wTop - wBottom

            boxShapeGood = boxHeight <= atr * maxBoxHeightATR
            boxCompactGood = boxHeight <= atr * 1.10 or L <= 8

            boxValid =
                 lowVolFrac >= minLowVolFraction and
                 maxInvalidRun <= allowedNonLowVolConsec and
                 boxShapeGood and
                 boxCompactGood and
                 volRegimeOK

            impulseMove = close[L] - close[L + impulseLookback]
            expansionBarOK = ta.highest(high - low, impulseLookback)[L] >= atr[L] * minExpansionBarATR

            impulseLong = impulseMove >= atr[L] * impulseATRMult
            impulseShort = impulseMove <= -atr[L] * impulseATRMult

            canLongSoft = trendLong and slopeLong and (impulseLong or expansionBarOK)
            canShortSoft = trendShort and slopeShort and (impulseShort or expansionBarOK)

            if boxValid and (canLongSoft or canShortSoft)
                foundCandidate := true
                foundDir := canLongSoft ? 1 : -1
                foundBoxStart := bar_index - (L - 1)
                foundBoxEnd := bar_index
                foundBoxBars := L
                foundBoxTop := wTop
                foundBoxBottom := wBottom
                foundBoxATR := atr
                foundBoxHeight := boxHeight

                prepLong = foundDir == 1 and trendLong and slopeLong
                prepShort = foundDir == -1 and trendShort and slopeShort
                foundPrepare := prepLong or prepShort

// =========================================================
// CREATE BOX
// =========================================================

if state == 0 and foundCandidate
    dir := foundDir
    boxStartIndex := foundBoxStart
    boxEndIndex := foundBoxEnd
    boxBars := foundBoxBars
    boxTop := foundBoxTop
    boxBottom := foundBoxBottom
    boxAtrAtCreation := foundBoxATR
    boxHeightAtCreation := foundBoxHeight

    scoreAtEntry := na
    gradeAtEntry := ""
    reasonAtEntry := ""
    entryPrice := na
    slPrice := na
    tp1Price := na
    tp2Price := na
    tp3Price := na
    hitTP1 := false
    hitTP2 := false
    hitTP3 := false

    activeBox := box.new(
         left = boxStartIndex,
         top = boxTop,
         right = bar_index,
         bottom = boxBottom,
         border_color = dir == 1 ? color.new(color.lime, 0) : color.new(color.red, 0),
         bgcolor = f_boxBg(dir, foundPrepare)
     )

    state := foundPrepare ? 2 : 1

// =========================================================
// MANAGE BOX / PREPARE
// =========================================================

if state == 1 or state == 2
    if not na(activeBox)
        box.set_right(activeBox, bar_index)
        box.set_top(activeBox, boxTop)
        box.set_bottom(activeBox, boxBottom)

    prepareLong = dir == 1 and trendLong and slopeLong
    prepareShort = dir == -1 and trendShort and slopeShort
    nowPrepare = prepareLong or prepareShort

    if state == 1 and nowPrepare
        state := 2

    if not na(activeBox)
        box.set_bgcolor(activeBox, showPrepareState ? f_boxBg(dir, state == 2) : color.new(color.gray, 86))

    waitedBars = bar_index - boxEndIndex
    if waitedBars > maxBreakoutBars
        if not na(activeBox)
            box.delete(activeBox)
        activeBox := na
        state := 0
        dir := 0
        boxStartIndex := na
        boxEndIndex := na
        boxBars := na
        boxTop := na
        boxBottom := na
        boxAtrAtCreation := na
        boxHeightAtCreation := na

// =========================================================
// ENTRY CONDITIONS + FAKE BREAKOUT FILTERS
// =========================================================

upperWick = f_upperWick(high, open, close)
lowerWick = f_lowerWick(low, open, close)
candleClosePos = f_closePos(close, high, low)
breakoutRangeOK = rangeBar >= atr * minBreakoutRangeATR

oppWickLongCons = lowerWick <= body * maxOppWickRatioCons
oppWickShortCons = upperWick <= body * maxOppWickRatioCons

retestDepthLong = boxTop - low
retestDepthShort = high - boxBottom
retestOKLong = retestDepthLong <= atr * maxBoxRetestDepthATR
retestOKShort = retestDepthShort <= atr * maxBoxRetestDepthATR

consFakeLongOK =
     not useFakeFilters or
     (breakoutRangeOK and oppWickLongCons and retestOKLong)

consFakeShortOK =
     not useFakeFilters or
     (breakoutRangeOK and oppWickShortCons and retestOKShort)

aggFakeLongOK =
     not useFakeFilters or
     (breakoutRangeOK and upperWick <= body * maxWickToBodyAgg and retestOKLong)

aggFakeShortOK =
     not useFakeFilters or
     (breakoutRangeOK and lowerWick <= body * maxWickToBodyAgg and retestOKShort)

conservativeLong =
     state == 2 and dir == 1 and
     close > boxTop and
     body >= avgBody * breakoutBodyMultCons and
     candleClosePos >= closePosThreshold and
     consFakeLongOK

conservativeShort =
     state == 2 and dir == -1 and
     close < boxBottom and
     body >= avgBody * breakoutBodyMultCons and
     candleClosePos <= (1.0 - closePosThreshold) and
     consFakeShortOK

aggressiveLong =
     state == 2 and dir == 1 and
     high > boxTop and
     body >= avgBody * breakoutBodyMultAgg and
     upperWick <= body * maxWickToBodyAgg and
     aggFakeLongOK

aggressiveShort =
     state == 2 and dir == -1 and
     low < boxBottom and
     body >= avgBody * breakoutBodyMultAgg and
     lowerWick <= body * maxWickToBodyAgg and
     aggFakeShortOK

longTriggered = entryMode == "Conservative" ? conservativeLong : aggressiveLong
shortTriggered = entryMode == "Conservative" ? conservativeShort : aggressiveShort

// =========================================================
// SCORE
// =========================================================

boxLenIdeal = boxBars >= 4 and boxBars <= 8
boxTight = boxHeightAtCreation <= boxAtrAtCreation * 0.85
boxVeryTight = boxHeightAtCreation <= boxAtrAtCreation * 0.65
adxGood = adx >= adxThreshold
adxStrong = adx >= 25.0
squeezeGoodLong = not useMomentum or momUp
squeezeGoodShort = not useMomentum or momDown

breakoutQualityLong =
     (entryMode == "Conservative" and body >= avgBody * breakoutBodyMultCons and candleClosePos >= closePosThreshold and consFakeLongOK) or
     (entryMode == "Aggressive" and body >= avgBody * breakoutBodyMultAgg and upperWick <= body * maxWickToBodyAgg and aggFakeLongOK)

breakoutQualityShort =
     (entryMode == "Conservative" and body >= avgBody * breakoutBodyMultCons and candleClosePos <= (1.0 - closePosThreshold) and consFakeShortOK) or
     (entryMode == "Aggressive" and body >= avgBody * breakoutBodyMultAgg and lowerWick <= body * maxWickToBodyAgg and aggFakeShortOK)

scoreLong =
     (trendLong ? 1 : 0) +
     (slopeLong ? 1 : 0) +
     (boxLenIdeal ? 1 : 0) +
     (boxTight ? 1 : 0) +
     (boxVeryTight ? 1 : 0) +
     (adxGood ? 1 : 0) +
     (adxStrong ? 1 : 0) +
     (squeezeGoodLong ? 1 : 0) +
     (breakoutQualityLong ? 1 : 0) +
     (volRegimeOK ? 1 : 0) +
     btcScoreLong +
     t3ScoreLong

scoreShort =
     (trendShort ? 1 : 0) +
     (slopeShort ? 1 : 0) +
     (boxLenIdeal ? 1 : 0) +
     (boxTight ? 1 : 0) +
     (boxVeryTight ? 1 : 0) +
     (adxGood ? 1 : 0) +
     (adxStrong ? 1 : 0) +
     (squeezeGoodShort ? 1 : 0) +
     (breakoutQualityShort ? 1 : 0) +
     (volRegimeOK ? 1 : 0) +
     btcScoreShort +
     t3ScoreShort

reasonLong = ""
reasonLong := f_addReason(reasonLong, adxGood, "ADX")
reasonLong := f_addReason(reasonLong, boxTight, "BOX")
reasonLong := f_addReason(reasonLong, squeezeGoodLong, "MOM")
reasonLong := f_addReason(reasonLong, volRegimeOK, "VOL")
reasonLong := f_addReason(reasonLong, btcScoreLong > 0, "BTC+")
reasonLong := f_addReason(reasonLong, btcScoreLong < 0, "BTC-")
reasonLong := f_addReason(reasonLong, t3ScoreLong > 0, "T3+")
reasonLong := f_addReason(reasonLong, t3ScoreLong < 0, "T3-")

reasonShort = ""
reasonShort := f_addReason(reasonShort, adxGood, "ADX")
reasonShort := f_addReason(reasonShort, boxTight, "BOX")
reasonShort := f_addReason(reasonShort, squeezeGoodShort, "MOM")
reasonShort := f_addReason(reasonShort, volRegimeOK, "VOL")
reasonShort := f_addReason(reasonShort, btcScoreShort > 0, "BTC+")
reasonShort := f_addReason(reasonShort, btcScoreShort < 0, "BTC-")
reasonShort := f_addReason(reasonShort, t3ScoreShort > 0, "T3+")
reasonShort := f_addReason(reasonShort, t3ScoreShort < 0, "T3-")

// =========================================================
// TRIGGER TRADE
// =========================================================

if longTriggered or shortTriggered
    scoreNow = longTriggered ? scoreLong : scoreShort
    gradeNow = f_grade(scoreNow)

    if gradeNow != "X"
        state := 3
        scoreAtEntry := scoreNow
        gradeAtEntry := gradeNow
        reasonAtEntry := longTriggered ? reasonLong : reasonShort
        entryPrice := close

        statsScoreSum += scoreAtEntry

        if dir == 1
            statsLong += 1
        else
            statsShort += 1

        if gradeAtEntry == "A"
            statsA += 1
        else if gradeAtEntry == "B"
            statsB += 1
        else if gradeAtEntry == "C"
            statsC += 1

        if dir == 1
            slPrice := boxBottom - boxAtrAtCreation * slAtrBuffer
            risk = entryPrice - slPrice
            tp1Price := entryPrice + risk * tp1R
            tp2Price := entryPrice + risk * tp2R
            tp3Price := entryPrice + risk * tp3R
        else
            slPrice := boxTop + boxAtrAtCreation * slAtrBuffer
            risk = slPrice - entryPrice
            tp1Price := entryPrice - risk * tp1R
            tp2Price := entryPrice - risk * tp2R
            tp3Price := entryPrice - risk * tp3R

        if showActiveLevels
            lineEntry := line.new(bar_index, entryPrice, bar_index + 1, entryPrice, extend=extend.right, color=color.new(color.white, 0), style=line.style_solid, width=2)
            lineSL := line.new(bar_index, slPrice, bar_index + 1, slPrice, extend=extend.right, color=color.new(color.red, 0), style=line.style_solid, width=2)
            lineTP1 := line.new(bar_index, tp1Price, bar_index + 1, tp1Price, extend=extend.right, color=color.new(color.yellow, 0), style=line.style_dotted, width=1)
            lineTP2 := line.new(bar_index, tp2Price, bar_index + 1, tp2Price, extend=extend.right, color=color.new(color.aqua, 0), style=line.style_dotted, width=1)
            lineTP3 := line.new(bar_index, tp3Price, bar_index + 1, tp3Price, extend=extend.right, color=color.new(color.lime, 0), style=line.style_dotted, width=1)

        if showScoreLabel
            txt =
                 (dir == 1 ? "LONG " : "SHORT ") + gradeAtEntry +
                 "\nScore: " + str.tostring(scoreAtEntry) +
                 "\nEntry: " + str.tostring(entryPrice, format.mintick) +
                 "\nSL: " + str.tostring(slPrice, format.mintick) +
                 "\nWhy: " + reasonAtEntry

            labelY = dir == 1 ? (boxBottom - atr * 0.40) : (boxTop + atr * 0.40)

            activeTradeLabel := label.new(
                 bar_index,
                 labelY,
                 txt,
                 style=label.style_label_center,
                 textcolor=color.white,
                 color=f_histColor(dir),
                 size=size.small
             )
    else
        if not na(activeBox)
            box.delete(activeBox)
        activeBox := na
        state := 0
        dir := 0
        boxStartIndex := na
        boxEndIndex := na
        boxBars := na
        boxTop := na
        boxBottom := na
        boxAtrAtCreation := na
        boxHeightAtCreation := na

// =========================================================
// ACTIVE TRADE MANAGEMENT
// Tracks TP1/TP2/TP3 simultaneously
// Same-bar ambiguity handled pessimistically: SL first
// =========================================================

if state == 3
    if showActiveLevels
        if not na(lineEntry)
            line.set_x2(lineEntry, bar_index)
        if not na(lineSL)
            line.set_x2(lineSL, bar_index)
        if not na(lineTP1)
            line.set_x2(lineTP1, bar_index)
        if not na(lineTP2)
            line.set_x2(lineTP2, bar_index)
        if not na(lineTP3)
            line.set_x2(lineTP3, bar_index)

    resultText = ""
    tradeDone = false

    tp1Now = dir == 1 ? high >= tp1Price : low <= tp1Price
    tp2Now = dir == 1 ? high >= tp2Price : low <= tp2Price
    tp3Now = dir == 1 ? high >= tp3Price : low <= tp3Price
    stopNow = dir == 1 ? low <= slPrice : high >= slPrice

    if tp1Now
        hitTP1 := true
    if tp2Now
        hitTP2 := true
    if tp3Now
        hitTP3 := true

    if stopNow
        tradeDone := true
        resultText := hitTP3 ? "TP3" : hitTP2 ? "TP2" : hitTP1 ? "TP1" : "SL"
    else if hitTP3
        tradeDone := true
        resultText := "TP3"

    if tradeDone
        statsTrades += 1

        if resultText == "SL"
            statsSL += 1
        else if resultText == "TP1"
            statsTP1Hit += 1
            statsWins += 1
            if dir == 1
                statsLongWins += 1
            else
                statsShortWins += 1
        else if resultText == "TP2"
            statsTP1Hit += 1
            statsTP2Hit += 1
            statsWins += 1
            if dir == 1
                statsLongWins += 1
            else
                statsShortWins += 1
        else if resultText == "TP3"
            statsTP1Hit += 1
            statsTP2Hit += 1
            statsTP3Hit += 1
            statsWins += 1
            if dir == 1
                statsLongWins += 1
            else
                statsShortWins += 1

        if showHistoricalLabel
            histTxt = (dir == 1 ? "LONG " : "SHORT ") + gradeAtEntry + " " + resultText
            histY = dir == 1 ? (low - atr * 0.20) : (high + atr * 0.20)
            label.new(
                 bar_index,
                 histY,
                 histTxt,
                 style=label.style_label_center,
                 textcolor=color.white,
                 color=f_histColor(dir),
                 size=size.tiny
             )

        if not na(activeBox)
            box.delete(activeBox)
        if not na(lineEntry)
            line.delete(lineEntry)
        if not na(lineSL)
            line.delete(lineSL)
        if not na(lineTP1)
            line.delete(lineTP1)
        if not na(lineTP2)
            line.delete(lineTP2)
        if not na(lineTP3)
            line.delete(lineTP3)
        if not na(activeTradeLabel)
            label.delete(activeTradeLabel)

        activeBox := na
        lineEntry := na
        lineSL := na
        lineTP1 := na
        lineTP2 := na
        lineTP3 := na
        activeTradeLabel := na

        state := 0
        dir := 0
        boxStartIndex := na
        boxEndIndex := na
        boxBars := na
        boxTop := na
        boxBottom := na
        boxAtrAtCreation := na
        boxHeightAtCreation := na
        scoreAtEntry := na
        gradeAtEntry := ""
        reasonAtEntry := ""
        entryPrice := na
        slPrice := na
        tp1Price := na
        tp2Price := na
        tp3Price := na
        hitTP1 := false
        hitTP2 := false
        hitTP3 := false

// =========================================================
// STATS PANEL
// =========================================================

if showStatsPanel and barstate.islast
    winrate = statsTrades > 0 ? (statsWins / statsTrades) * 100.0 : 0.0
    longWR = statsLong > 0 ? (statsLongWins / statsLong) * 100.0 : 0.0
    shortWR = statsShort > 0 ? (statsShortWins / statsShort) * 100.0 : 0.0
    avgScore = (statsLong + statsShort) > 0 ? (statsScoreSum / (statsLong + statsShort)) : 0.0
    slRate = statsTrades > 0 ? (statsSL / statsTrades) * 100.0 : 0.0
    tp1WR = statsTrades > 0 ? (statsTP1Hit / statsTrades) * 100.0 : 0.0
    tp2WR = statsTrades > 0 ? (statsTP2Hit / statsTrades) * 100.0 : 0.0
    tp3WR = statsTrades > 0 ? (statsTP3Hit / statsTrades) * 100.0 : 0.0

    table.cell(statsTable, 0, 0, "Metric", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(statsTable, 1, 0, "Value", text_color=color.white, bgcolor=color.new(color.black, 0))

    table.cell(statsTable, 0, 1, "Trades", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(statsTable, 1, 1, str.tostring(statsTrades), text_color=color.white, bgcolor=color.new(color.black, 20))

    table.cell(statsTable, 0, 2, "Winrate", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(statsTable, 1, 2, str.tostring(winrate, "#.0") + "%", text_color=color.white, bgcolor=color.new(color.black, 20))

    table.cell(statsTable, 0, 3, "Long / Short", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(statsTable, 1, 3, str.tostring(statsLong) + " / " + str.tostring(statsShort), text_color=color.white, bgcolor=color.new(color.black, 20))

    table.cell(statsTable, 0, 4, "LWR / SWR", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(statsTable, 1, 4, str.tostring(longWR, "#.0") + "% / " + str.tostring(shortWR, "#.0") + "%", text_color=color.white, bgcolor=color.new(color.black, 20))

    table.cell(statsTable, 0, 5, "A / B / C", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(statsTable, 1, 5, str.tostring(statsA) + " / " + str.tostring(statsB) + " / " + str.tostring(statsC), text_color=color.white, bgcolor=color.new(color.black, 20))

    table.cell(statsTable, 0, 6, "Avg Score", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(statsTable, 1, 6, str.tostring(avgScore, "#.0"), text_color=color.white, bgcolor=color.new(color.black, 20))

    table.cell(statsTable, 0, 7, "SL Rate", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(statsTable, 1, 7, str.tostring(slRate, "#.0") + "%", text_color=color.white, bgcolor=color.new(color.black, 20))

    table.cell(statsTable, 0, 8, "TP1 WR", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(statsTable, 1, 8, str.tostring(tp1WR, "#.0") + "%", text_color=color.white, bgcolor=color.new(color.black, 20))

    table.cell(statsTable, 0, 9, "TP2 WR", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(statsTable, 1, 9, str.tostring(tp2WR, "#.0") + "%", text_color=color.white, bgcolor=color.new(color.black, 20))

    table.cell(statsTable, 0, 10, "TP3 WR", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(statsTable, 1, 10, str.tostring(tp3WR, "#.0") + "%", text_color=color.white, bgcolor=color.new(color.black, 20))

    table.cell(statsTable, 0, 11, "TP1/2/3", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(statsTable, 1, 11, str.tostring(statsTP1Hit) + "/" + str.tostring(statsTP2Hit) + "/" + str.tostring(statsTP3Hit), text_color=color.white, bgcolor=color.new(color.black, 20))

// =========================================================
// PLOTS
// =========================================================

plot(showEMA ? ema200 : na, "EMA 200", color=color.new(color.orange, 0), linewidth=2)

plotshape(longTriggered and state == 3, title="Long Trigger", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), size=size.small, text="L")
plotshape(shortTriggered and state == 3, title="Short Trigger", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small, text="S")
