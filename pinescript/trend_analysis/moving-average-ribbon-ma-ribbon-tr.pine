//                                 ██║       ██║     ██╔═══██║  ██║  ██║  ██║   ██║       ██╔══██╗ ██║   ██║ ██║      ██║   ██║ ██╔═══██║
//                                 ██║    ████████╗  ██║   ██║  ███████║  ╚██████╔╝       ██║  ██║ ╚██████╔╝ ╚██████╗ ██║   ██║ ██║   ██║
//@version=6
indicator('Moving Average Ribbon - MA Ribbon | TR', 'MA Ribbon | TR →', true)
import TradingView/ta/12
//╔═════════════════╗
//║     Input's     ║
//╚═════════════════╝
Color_Mode =    input.string('Classic', 'Color Choice', group = '🎨 Color', options = ['Classic', 'Modern', 'Robust', 'Accented', 'Monochrome', 'Moderate', 'Aqua', 'Cosmic'])
Length_1 =      input.int(21, '1º Length', minval = 1, inline = '1º Length', group='⚙️ MA Setting')
Source_1 =      input.source(close, 'Source', inline = '1º Length', group='⚙️ MA Setting')
Length_2 =      input.int(50, '2º Length', minval = 1, inline = '2º Length', group='⚙️ MA Setting')
Source_2 =      input.source(close, 'Source', inline = '2º Length', group='⚙️ MA Setting')
MA_Type =       input.string('EMA', 'Moving Average', group='📊 MA', inline = 'MA', options=['EMA', 'SMA', 'RMA', 'WMA', 'VWMA', 'HMA', 'DEMA', 'TEMA', 'TRIMA', 'FRAMA'])
//╔═════════════════════════════════╗
//║     MOVING AVERAGE ENGINE       ║
//╚═════════════════════════════════╝
ma(source, length, type) =>
     type == 'EMA'   ? ta.ema(source, length) :
     type == 'SMA'   ? ta.sma(source, length) :
     type == 'RMA'   ? ta.rma(source, length) :
     type == 'WMA'   ? ta.wma(source, length) :
     type == 'VWMA'  ? ta.vwma(source, length) :
     type == 'HMA'   ? ta.hma(source, length) :
     type == 'DEMA'  ? ta.dema(source, length) :
     type == 'TEMA'  ? ta.tema(source, length) :
     type == 'TRIMA' ? ta.trima(source, length) :
     type == 'FRAMA' ? ta.frama(source, length) :
     na
//╔═════════════════╗
//║     Color       ║
//╚═════════════════╝
[UpC, DnC] = switch Color_Mode
    'Classic' =>    [#008800, #ff0000]
    'Modern' =>     [#ffffff, #b721ff]
    'Robust' =>     [#ffbb00, #770737]
    'Accented' =>   [#8c5cf7, #e83e8c]
    'Monochrome' => [#e9ecef, #495057]
    'Moderate' =>   [#43a047, #e53935]
    'Aqua' =>       [#00a8e8, #f18f01]
    'Cosmic' =>     [#e83e8c, #6f2da8]
//╔════════════════════════╗
//║      Calculation       ║
//╚════════════════════════╝
Value_1 = ma(Source_1, Length_1, MA_Type)
Value_2 = ma(Source_2, Length_2, MA_Type)
Spread = Value_1 - Value_2
Min_Spread = ta.lowest(Spread, 70)
Max_Spread = ta.highest(Spread, 70)
Range_Spread = Max_Spread - Min_Spread
N_Dist = Range_Spread != 0 ? (Spread - Min_Spread) / Range_Spread : 0.5
Trend_Color = color.from_gradient(N_Dist, 0, 1, DnC, UpC)
Momentum = math.abs(Value_1 - Value_1[5])
Max_Momentum = ta.highest(Momentum, 50)
Norm_Momentum = Max_Momentum > 0 ? math.min(Momentum / Max_Momentum, 1) : 0
Fill_Transp = int(math.max(0, math.min(100, 35 - (Norm_Momentum * 25))))
isBull_MA = Value_1 > Value_2
isBear_MA = Value_1 < Value_2
Bull_MA = ta.crossover(Value_1,Value_2)
Bear_MA = ta.crossunder(Value_1,Value_2)
//╔════════════════════════╗
//║          Plot          ║
//╚════════════════════════╝
Plot_Fast = plot(Value_1, 'Fast', Trend_Color)
Plot_Slow = plot(Value_2, 'Slow', Trend_Color)
fill(Plot_Fast, Plot_Slow, title='Ribbon Fill', color = color.new(Trend_Color, Fill_Transp))
barcolor(isBull_MA ? UpC : isBear_MA ? DnC : na, title='Bar Color')
plotshape(Bull_MA, 'LONG' , shape.triangleup  , location.belowbar, UpC,    0, size = size.normal, force_overlay = true)
plotshape(Bear_MA, 'SHORT', shape.triangledown, location.abovebar, DnC,    0, size = size.normal, force_overlay = true)
bgcolor(isBull_MA ? color.new(UpC, 95) : isBear_MA ? color.new(DnC, 95) : na, title='Zone Background', force_overlay = true)
//╔════════════════════════╗
//║          VIEW          ║
//╚════════════════════════╝
var table infoTable = table.new(position.middle_right, 1, 1, border_width = 1)
var label infoLabel = na
if barstate.islast
    table.cell(infoTable, 0, 0, text = isBull_MA ? '⬆️ Bullish' : '⬇️ Bearish', text_color = isBull_MA ? UpC : DnC, text_size = size.huge)
    if not na(infoLabel)
        label.delete(infoLabel)
    infoLabel := label.new(bar_index, Value_1, text = str.tostring(Spread, '#.##'), color = color.new(isBull_MA ? UpC : DnC, 20), style = label.style_label_left, size = size.large, textcolor = #000000)
//╔════════════════════════╗
//║         Alerts         ║
//╚════════════════════════╝
alertcondition(isBull_MA, title="Bullish Crossover",  message="Fast > Slow")
alertcondition(isBear_MA, title="Bearish Crossover",  message="Fast < Slow")
alertcondition(ta.cross(Spread, 0), title="Zero Crossover", message="Spread crosses zero")
