//@version=6
indicator("Trend Analysis [Mr_Rakun]", overlay=true)

// ============================================
// TREND DETERMINATION FUNCTION
// ============================================
// Optimized trend analysis for price action
// Parameters:
//   src: Price data for analysis (close, high, low, hl2 etc.)
//   length: Trend calculation period
//   method: Trend determination method
// Returns: 1 (Bullish), -1 (Bearish), 0 (Neutral/Uncertain)

determinePriceTrend(series float src, int length, string mode) =>
    float trend = 0
    
    if mode == "Linear Regression"
        // METHOD 1: Linear Regression
        sumX = 0.0
        sumY = 0.0
        sumXY = 0.0
        sumX2 = 0.0
        
        for i = 0 to length - 1
            x = float(i)
            y = src[length - 1 - i]
            sumX := sumX + x
            sumY := sumY + y
            sumXY := sumXY + (x * y)
            sumX2 := sumX2 + (x * x)
        
        slope = (length * sumXY - sumX * sumY) / (length * sumX2 - sumX * sumX)
        
        // Sensitive threshold values for price
        average = src
        normalized = (slope / average) * 100
        trend := normalized > 0.1 ? 1 : normalized < -0.1 ? -1 : 0
        
    else if mode == "MA Crossover"
        // METHOD 2: Moving Average Crossover
        // Comparison of short and long term MA
        shortMA = ta.sma(src, math.round(length / 2))
        longMA = ta.sma(src, length)
        
        trend := shortMA > longMA ? 1 : shortMA < longMA ? -1 : 0
        
    else if mode == "High/Low"
        // METHOD 3: High/Low Peak Analysis
        // Higher Highs / Lower Lows logic
        prevHigh = high[length]
        prevLow = low[length]
        currentHigh = high
        currentLow = low
        
        risingLowsCount = 0
        risingHighsCount = 0
        
        for i = 1 to length - 1
            if low[i] > low[i + 1]
                risingLowsCount := risingLowsCount + 1
            if high[i] > high[i + 1]
                risingHighsCount := risingHighsCount + 1
        
        bullishRatio = (risingLowsCount + risingHighsCount) / (length * 2)
        trend := bullishRatio > 0.6 ? 1 : bullishRatio < 0.4 ? -1 : 0
        
    else if mode == "Momentum"
        // METHOD 4: Momentum Based Trend
        momentum = ta.mom(src, length)
        momentumMA = ta.sma(momentum, math.round(length / 2))
        
        trend := momentumMA > 0 ? 1 : momentumMA < 0 ? -1 : 0
        
    else if mode == "ADX"
        // METHOD 5: Trend Strength + Direction with ADX
        [diPlus, diMinus, adx] = ta.dmi(length, length)
        
        // ADX > 25 indicates a strong trend
        isTrendStrong = adx > 25
        trend := isTrendStrong ? (diPlus > diMinus ? 1 : -1) : 0
    
    trend

// ============================================
// TREND STRENGTH FUNCTION
// ============================================
// Measures trend strength between 0-100

calculateTrendStrength(series float src, int length) =>
    // Linear regression R-squared (Coefficient of Determination)
    sumX = 0.0
    sumY = 0.0
    sumXY = 0.0
    sumX2 = 0.0
    sumY2 = 0.0
    
    for i = 0 to length - 1
        x = float(i)
        y = src[length - 1 - i]
        sumX := sumX + x
        sumY := sumY + y
        sumXY := sumXY + (x * y)
        sumX2 := sumX2 + (x * x)
        sumY2 := sumY2 + (y * y)
    
    n = float(length)
    r = (n * sumXY - sumX * sumY) / math.sqrt((n * sumX2 - sumX * sumX) * (n * sumY2 - sumY * sumY))
    rSquared = r * r * 100
    rSquared

// ============================================
// USER INPUTS
// ============================================

// Price Selection
srcInput = input.source(close, "Source")

// Trend Parameters
trendPeriod = input.int(20, "Trend Period", minval=5, maxval=200)
trendMethod = input.string("Linear Regression", "Trend Method", ["Linear Regression", "MA Crossover", "High/Low", "Momentum", "ADX"])

// Visualization
colorBars = input.bool(true, "Color Bars Based on Trend")
showTrendLine = input.bool(true, "Show Trend Line")
showStrength = input.bool(true, "Show Trend Strength")

// ============================================
// CALCULATIONS
// ============================================

// Trend Calculation
priceTrend = determinePriceTrend(srcInput, trendPeriod, trendMethod)
trendStrength = calculateTrendStrength(srcInput, trendPeriod)

// Regression line for visual trend
regLine = ta.linreg(srcInput, trendPeriod, 0)

// ============================================
// VISUALIZATION
// ============================================

// Trend line color
trendColor = priceTrend == 1 ? color.new(color.green, 0) : 
     priceTrend == -1 ? color.new(color.red, 0) : 
     color.new(color.gray, 30)

plot(showTrendLine ? regLine : na, "Trend Line", 
     trendColor, linewidth=3, style=plot.style_line)

// Bar coloring
barCol = priceTrend == 1 ? color.new(color.lime, 0) : 
     priceTrend == -1 ? color.new(color.red, 0) : 
     color.new(color.gray, 0)

barcolor(colorBars ? barCol : na, title="Trend Bar Color")

// Trend change markers
bullishStart = ta.change(priceTrend) == 2
bearishStart = ta.change(priceTrend) == -2

plotshape(bullishStart, "Bullish Start", shape.triangleup, 
     location.belowbar, color.new(color.green, 0), size=size.normal, 
     text="▲ BULLISH")

plotshape(bearishStart, "Bearish Start", shape.triangledown, 
     location.abovebar, color.new(color.red, 0), size=size.normal, 
     text="▼ BEARISH")


// ============================================
// ALERT SIGNALS
// ============================================

// Strong bullish trend started
strongBullish = bullishStart and trendStrength > 50
alertcondition(strongBullish, "Strong Bullish", 
     "Strong bullish trend started! Strength: {{plot_0}}%")

// Strong bearish trend started
strongBearish = bearishStart and trendStrength > 50
alertcondition(strongBearish, "Strong Bearish", 
     "Strong bearish trend started! Strength: {{plot_0}}%")

// Trend weakening
trendWeakened = trendStrength < 30 and trendStrength[1] > 40
alertcondition(trendWeakened, "Trend Weakened", 
     "Current trend is weakening, be careful!")

// Special labels
plotshape(strongBullish, "Strong Buy", shape.labelup, 
     location.belowbar, color.new(color.green, 0), 
     text="STRONG BUY", textcolor=color.white, size=size.large)

plotshape(strongBearish, "Strong Sell", shape.labeldown, 
     location.abovebar, color.new(color.red, 0), 
     text="STRONG SELL", textcolor=color.white, size=size.large)



var table panel = table.new(position.top_right, 2, 7,
     bgcolor=color.new(#0A0E1A, 5),
     border_width=1,
     border_color=color.new(#1E2D4A, 0),
     frame_width=1,
     frame_color=color.new(#1E2D4A, 0))

_C_BG_HEAD   = color.new(#0D1B2E, 0)
_C_BG_ROW1   = color.new(#0A1220, 0)
_C_BG_ROW2   = color.new(#0C1628, 0)
_C_LABEL     = color.new(#4A6FA5, 0)
_C_WHITE     = color.new(#E8EDF5, 0)
_C_GOLD      = color.new(#FFD166, 0)
_C_CYAN      = color.new(#00E5FF, 0)
_C_RED       = color.new(#FF3D5A, 0)
_C_GRAY      = color.new(#6B7FA3, 0)
_C_GREEN_DIM = color.new(#00C896, 0)
_C_ORANGE    = color.new(#FF9F43, 0)

var int txtSize = 10

if barstate.islast
    // ── HEADER ──────────────────────────────────
    table.cell(panel, 0, 0, "  TREND ANALYSIS",
         text_color=_C_WHITE,
         bgcolor=_C_BG_HEAD,
         text_size=txtSize + 4)
    table.cell(panel, 1, 0, trendMethod,
         text_color=_C_LABEL,
         bgcolor=_C_BG_HEAD,
         text_size=txtSize)

    // ── PRICE ───────────────────────────────────
    table.cell(panel, 0, 1, "PRICE",
         text_color=_C_LABEL, bgcolor=_C_BG_ROW1, text_size=txtSize)
    table.cell(panel, 1, 1, str.tostring(srcInput, format.mintick),
         text_color=_C_GOLD, bgcolor=_C_BG_ROW1, text_size=size.normal)

    // ── TREND DIRECTION ─────────────────────────
    trendIcon  = priceTrend == 1 ? "▲  BULLISH" : priceTrend == -1 ? "▼  BEARISH" : "─  NEUTRAL"
    trendColTable = priceTrend == 1 ? _C_CYAN       : priceTrend == -1 ? _C_RED     : _C_GRAY
    table.cell(panel, 0, 2, "DIRECTION",
         text_color=_C_LABEL, bgcolor=_C_BG_ROW2, text_size=txtSize)
    table.cell(panel, 1, 2, trendIcon,
         text_color=trendColTable, bgcolor=_C_BG_ROW2, text_size=size.normal)

    // ── TREND STRENGTH ──────────────────────────
    if showStrength
        strColor  = trendStrength > 70 ? _C_GREEN_DIM : trendStrength > 40 ? _C_GOLD : _C_ORANGE
        strBar   = trendStrength > 80 ? "████████" : trendStrength > 60 ? "██████░░" :
             trendStrength > 40 ? "████░░░░" : trendStrength > 20 ? "██░░░░░░" : "█░░░░░░░"
        strComment = trendStrength > 70 ? "EXTREME" : trendStrength > 50 ? "STRONG" :
             trendStrength > 30 ? "MODERATE"    : "WEAK"

        table.cell(panel, 0, 3, "STR  R²",
             text_color=_C_LABEL, bgcolor=_C_BG_ROW1, text_size=txtSize)
        table.cell(panel, 1, 3, str.tostring(trendStrength, "#.0") + "%  " + strComment,
             text_color=strColor, bgcolor=_C_BG_ROW1, text_size=txtSize + 2)

        table.cell(panel, 0, 4, "BAR",
             text_color=_C_LABEL, bgcolor=_C_BG_ROW2, text_size=txtSize)
        table.cell(panel, 1, 4, strBar,
             text_color=strColor, bgcolor=_C_BG_ROW2, text_size=txtSize + 2)

    // ── PERIOD ─────────────────────────────────
    table.cell(panel, 0, 5, "PERIOD",
         text_color=_C_LABEL, bgcolor=_C_BG_ROW1, text_size=txtSize)
    table.cell(panel, 1, 5, str.tostring(trendPeriod) + " bars",
         text_color=_C_WHITE, bgcolor=_C_BG_ROW1, text_size=txtSize + 2)

    // ── STATUS BAR ──────────────────────────────
    statusTxt  = strongBullish ? "◉  STRONG BUY SIGNAL" :
         strongBearish ? "◉  STRONG SELL SIGNAL" :
         trendWeakened ? "◎  TREND WEAKENING"     :
         priceTrend == 1  ? "○  Bullish continue"    :
         priceTrend == -1 ? "○  Bearish continue"    : "○  Waiting for dir."
    statusCol  = strongBullish ? _C_CYAN : strongBearish ? _C_RED :
         trendWeakened ? _C_ORANGE : _C_GRAY

    table.cell(panel, 0, 6, "STATUS",
         text_color=_C_LABEL, bgcolor=_C_BG_ROW2, text_size=txtSize)
    table.cell(panel, 1, 6, statusTxt,
         text_color=statusCol, bgcolor=_C_BG_ROW2, text_size=txtSize)


plot(priceTrend, "Trendin Yönü", display = display.none)
plot(trendStrength, "Trendin Gücü", display = display.none)
