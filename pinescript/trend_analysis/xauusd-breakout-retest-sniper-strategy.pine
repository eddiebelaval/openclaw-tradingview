//@version=6
strategy("XAUUSD Breakout Retest Sniper Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=2)

// ───── INPUTS ─────
emaLen      = input.int(50, "Trend EMA Length")
rr          = input.float(2.0, "Risk Reward (TP Multiplier)", step=0.1)
lookback    = input.int(20, "Breakout Lookback", minval=5)

// ───── TREND FILTER ─────
ema = ta.ema(close, emaLen)
plot(ema, color=color.orange, linewidth=2, title="Trend EMA")

bullTrend = close > ema
bearTrend = close < ema

// ───── BREAKOUT LEVELS ─────
highestHigh = ta.highest(high, lookback)
lowestLow   = ta.lowest(low, lookback)

plot(highestHigh, "Resistance", color=color.red)
plot(lowestLow, "Support", color=color.green)

// ───── BUY SETUP ─────
buyBreak = ta.crossover(close, highestHigh[1]) and bullTrend
buyRetest = low <= highestHigh[1]

buyCondition = buyBreak and buyRetest

// ───── SELL SETUP ─────
sellBreak = ta.crossunder(close, lowestLow[1]) and bearTrend
sellRetest = high >= lowestLow[1]

sellCondition = sellBreak and sellRetest

// ───── RISK MANAGEMENT ─────
atr = ta.atr(14)
slBuy = close - atr
tpBuy = close + (atr * rr)

slSell = close + atr
tpSell = close - (atr * rr)

// ───── EXECUTION ─────
if buyCondition
    strategy.entry("BUY", strategy.long)
    strategy.exit("TP/SL BUY", from_entry="BUY", stop=slBuy, limit=tpBuy)

if sellCondition
    strategy.entry("SELL", strategy.short)
    strategy.exit("TP/SL SELL", from_entry="SELL", stop=slSell, limit=tpSell)

// ───── SIGNAL LABELS ─────
plotshape(buyCondition, title="BUY", location=location.belowbar, color=color.lime, style=shape.labelup, text="BUY")
plotshape(sellCondition, title="SELL", location=location.abovebar, color=color.red, style=shape.labeldown, text="SELL")
