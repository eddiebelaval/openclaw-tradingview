//@version=6
indicator("Clean Institutional Levels", overlay=true, max_lines_count=500, max_labels_count=500)

// --- INPUTS (Only Lines and Pivot Strength) ---
leftBars   = input.int(3, "Pivot Left Strength", minval=1)
rightBars  = input.int(3, "Pivot Right Strength", minval=1)
ithColor   = input.color(color.red, "ITH (Resistance) Line")
itlColor   = input.color(color.teal, "ITL (Support) Line")
lineWidth  = input.int(1, "Line Width", minval=1, maxval=5)
showLabels = input.bool(true, "Show Level Labels")

// --- DYNAMIC ARRAYS ---
var line[]  activeLines  = array.new_line()
var label[] activeLabels = array.new_label()
var string[] lineTypes   = array.new_string()

// --- DETECTION LOGIC ---
ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low, leftBars, rightBars)

// Arrays to track pivot history
var float[] hVals = array.new_float()
var int[]   hIdxs = array.new_int()
var float[] lVals = array.new_float()
var int[]   lIdxs = array.new_int()

// Logic for ITH (Intermediate Swing High)
if not na(ph)
    array.push(hVals, ph), array.push(hIdxs, bar_index - rightBars)
    if array.size(hVals) >= 3
        v1 = array.get(hVals, array.size(hVals)-3), v2 = array.get(hVals, array.size(hVals)-2), v3 = array.get(hVals, array.size(hVals)-1)
        if v2 > v1 and v2 > v3
            idx = array.get(hIdxs, array.size(hIdxs)-2)
            array.push(activeLines, line.new(idx, v2, bar_index, v2, color=ithColor, width=lineWidth))
            array.push(lineTypes, "ITH")
            array.push(activeLabels, showLabels ? label.new(bar_index, v2, "ITH", style=label.style_label_left, color=ithColor, textcolor=color.white, size=size.tiny) : na)

// Logic for ITL (Intermediate Swing Low)
if not na(pl)
    array.push(lVals, pl), array.push(lIdxs, bar_index - rightBars)
    if array.size(lVals) >= 3
        v1 = array.get(lVals, array.size(lVals)-3), v2 = array.get(lVals, array.size(lVals)-2), v3 = array.get(lVals, array.size(lVals)-1)
        if v2 < v1 and v2 < v3
            idx = array.get(lIdxs, array.size(lIdxs)-2)
            array.push(activeLines, line.new(idx, v2, bar_index, v2, color=itlColor, width=lineWidth))
            array.push(lineTypes, "ITL")
            array.push(activeLabels, showLabels ? label.new(bar_index, v2, "ITL", style=label.style_label_left, color=itlColor, textcolor=color.white, size=size.tiny) : na)

// --- THE MITIGATION ENGINE ---
if array.size(activeLines) > 0
    for i = array.size(activeLines) - 1 to 0
        ln    = array.get(activeLines, i)
        lb    = array.get(activeLabels, i)
        lType = array.get(lineTypes, i)
        price = line.get_y1(ln)
        
        // Check if price has crossed the line
        isHit = (lType == "ITH" and high >= price) or (lType == "ITL" and low <= price)
        
        if isHit
            // Finalize the line/label at the point of impact
            line.set_x2(ln, bar_index)
            if not na(lb)
                label.set_x(lb, bar_index)
            // Remove from active array so it stops extending
            array.remove(activeLines, i)
            array.remove(activeLabels, i)
            array.remove(lineTypes, i)
        else
            // Extend the level to the current candle
            line.set_x2(ln, bar_index)
            if not na(lb)
                label.set_x(lb, bar_index)
