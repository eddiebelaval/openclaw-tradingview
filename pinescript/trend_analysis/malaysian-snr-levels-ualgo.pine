//@version=6
indicator("Malaysian SnR Levels [UAlgo]", overlay = true, max_lines_count = 500, max_labels_count = 500)

type SnRLevel
    float price
    string levelType
    bool isFresh
    bool isActive
    line lvlLine
    label lvlLabel

var array<SnRLevel> levels = array.new<SnRLevel>()

string tf       = input.timeframe("", "Multi-Timeframe (MTF)", group="Core Settings", tooltip="Leave empty for current chart timeframe. For Emperor strategy, try 240 (4H) or 1D (Daily).")
int pivotLength = input.int(5, "Pivot Lookback (A/V Levels)", minval=1, group="Core Settings")
int maxLevels   = input.int(30, "Max Active Levels", minval=5, maxval=100, group="Core Settings")
float minGapTicks = input.float(2.0, "Minimum Gap Size (Ticks)", minval=0.0, step=0.5, group="Core Settings")

bool showA      = input.bool(true, "Show A-Levels (Resistance)", group="Visibility")
bool showV      = input.bool(true, "Show V-Levels (Support)", group="Visibility")
bool showGap    = input.bool(true, "Show Gap Levels", group="Visibility")

color colAFresh     = input.color(#ff5252, "A-Level Fresh", group="Style (Colors)")
color colAUnfresh   = input.color(color.new(#ff5252, 50), "A-Level Unfresh", group="Style (Colors)")
color colVFresh     = input.color(#00bfa5, "V-Level Fresh", group="Style (Colors)")
color colVUnfresh   = input.color(color.new(#00bfa5, 50), "V-Level Unfresh", group="Style (Colors)")
color colGapFresh   = input.color(#2962ff, "Gap Fresh", group="Style (Colors)")
color colGapUnfresh = input.color(color.new(#2962ff, 50), "Gap Unfresh", group="Style (Colors)")

int lineWidthFresh   = input.int(2, "Line Width (Fresh)", minval=1, maxval=4, group="Style (Sizes)")
int lineWidthUnfresh = input.int(1, "Line Width (Unfresh)", minval=1, maxval=4, group="Style (Sizes)")
string labelSizeStr  = input.string("Normal", "Label Size", options=["Tiny", "Small", "Normal", "Large"], group="Style (Sizes)")

string labelSize = labelSizeStr == "Tiny" ? size.tiny : labelSizeStr == "Small" ? size.small : labelSizeStr == "Large" ? size.large : size.normal

method updateState(SnRLevel this, float h, float l, float c, float o, float c_prev, int curTime, int timeStep) =>
    if this.isActive
        bool crossedUp   = (o <= this.price and c > this.price) or (c_prev < this.price and c > this.price)
        bool crossedDown = (o >= this.price and c < this.price) or (c_prev > this.price and c < this.price)
        
        if crossedUp or crossedDown
            this.isActive := false
            this.lvlLine.set_x2(curTime)
            this.lvlLine.set_extend(extend.none)
            this.lvlLabel.set_x(curTime)
        else
            this.lvlLabel.set_x(curTime + timeStep * 5)
            
            if this.isFresh
                bool touchedWick = false
                if this.levelType == "A"
                    touchedWick := h >= this.price
                else if this.levelType == "V"
                    touchedWick := l <= this.price
                else
                    touchedWick := h >= this.price and l <= this.price
                    
                if touchedWick
                    this.isFresh := false
                    this.lvlLine.set_style(line.style_dashed)
                    this.lvlLine.set_width(lineWidthUnfresh)
                    
                    if this.levelType == "A"
                        this.lvlLine.set_color(colAUnfresh)
                        this.lvlLabel.set_textcolor(colAUnfresh)
                    else if this.levelType == "V"
                        this.lvlLine.set_color(colVUnfresh)
                        this.lvlLabel.set_textcolor(colVUnfresh)
                    else
                        this.lvlLine.set_color(colGapUnfresh)
                        this.lvlLabel.set_textcolor(colGapUnfresh)

method addLevel(array<SnRLevel> this, float p, string t, int start_time, int cur_time, int timeStep) =>
    color c = t == "A" ? colAFresh : t == "V" ? colVFresh : colGapFresh
    
    bool exists = false
    for lvl in this
        if lvl.isActive and math.abs(lvl.price - p) < syminfo.mintick * 10
            exists := true
            break
            
    if not exists and not na(p)
        int st = na(start_time) ? cur_time : start_time
        line l = line.new(st, p, st + timeStep, p, xloc=xloc.bar_time, color=c, width=lineWidthFresh, extend=extend.right)
        label lb = label.new(cur_time + timeStep * 5, p, t, xloc=xloc.bar_time, style=label.style_none, textcolor=c, size=labelSize)
        this.push(SnRLevel.new(p, t, true, true, l, lb))
        
        if this.size() > maxLevels
            int removeIdx = 0
            for i = 0 to this.size() - 1
                SnRLevel lvl = this.get(i)
                if not lvl.isActive
                    removeIdx := i
                    break
            SnRLevel removedLvl = this.remove(removeIdx)
            removedLvl.lvlLine.delete()
            removedLvl.lvlLabel.delete()

f_get_data() =>
    float ph = ta.pivothigh(close, pivotLength, pivotLength)
    float pl = ta.pivotlow(close, pivotLength, pivotLength)
    
    bool isBullish    = close > open
    bool prevBullish  = close[1] > open[1]
    bool isBearish    = close < open
    bool prevBearish  = close[1] < open[1]

    bool bullishGap   = prevBullish and isBullish and (open - close[1]) >= syminfo.mintick * minGapTicks
    bool bearishGap   = prevBearish and isBearish and (close[1] - open) >= syminfo.mintick * minGapTicks

    float gap_price = na
    if bullishGap or bearishGap
        gap_price := close[1]
        
    int ph_t = not na(ph) ? time[pivotLength] : na
    int pl_t = not na(pl) ? time[pivotLength] : na
    int gap_t = not na(gap_price) ? time[1] : na
    
    [ph, pl, gap_price, ph_t, pl_t, gap_t]

[sec_ph, sec_pl, sec_gap, sec_ph_t, sec_pl_t, sec_gap_t] = request.security(syminfo.tickerid, tf != "" ? tf : timeframe.period, f_get_data(), lookahead=barmerge.lookahead_off)
[loc_ph, loc_pl, loc_gap, loc_ph_t, loc_pl_t, loc_gap_t] = f_get_data()

float ph = tf == "" ? loc_ph : sec_ph
float pl = tf == "" ? loc_pl : sec_pl
float gap_price = tf == "" ? loc_gap : sec_gap
int ph_t = tf == "" ? loc_ph_t : sec_ph_t
int pl_t = tf == "" ? loc_pl_t : sec_pl_t
int gap_t = tf == "" ? loc_gap_t : sec_gap_t

// Using nz() to prevent "na != na" bug which evaluates to na in Pine Script and prevents drawing
bool new_ph  = not na(ph_t) and ph_t != nz(ph_t[1])
bool new_pl  = not na(pl_t) and pl_t != nz(pl_t[1])
bool new_gap = not na(gap_t) and gap_t != nz(gap_t[1])

int timeStep = bar_index > 0 ? time - time[1] : 60000

if showA and new_ph
    levels.addLevel(ph, "A", ph_t, time, timeStep)

if showV and new_pl
    levels.addLevel(pl, "V", pl_t, time, timeStep)

if showGap and new_gap
    levels.addLevel(gap_price, "Gap", gap_t, time, timeStep)

for lvl in levels
    lvl.updateState(high, low, close, open, close[1], time, timeStep)
