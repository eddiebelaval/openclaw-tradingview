//@version=5
indicator("Inverse Golden Pocket MTF Zones", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// TF COMBO & PER-TF SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════

grp_combo = "Timeframe Combo"
combo = input.string("Chart + 15m + 30m", "Preset", options=[
     "Chart Only",
     "Chart + 15m",
     "Chart + 15m + 30m",
     "Chart + 15m + 30m + 1h",
     "Custom"], group=grp_combo)

grp_ctf = "Chart TF"
chartTF_on   = input.bool(true, "Show Chart TF Zones", group=grp_ctf)
extR0        = input.int(15,    "Extend Right (bars)", minval=0, maxval=200, group=grp_ctf)
freeze0      = input.bool(true, "Freeze Inverted",     group=grp_ctf)
freezeB0     = input.int(10,    "Freeze After (bars)", minval=0, maxval=100, group=grp_ctf)
lblPos0      = input.string("Top-Left", "Label Position", options=["Top-Left", "Top-Right", "Bot-Left", "Bot-Right"], group=grp_ctf)

grp_h1 = "HTF 1"
c_tf1        = input.timeframe("15",  "Timeframe",          group=grp_h1)
c_tf1_on     = input.bool(true,       "Enabled",            group=grp_h1)
minSwing1    = input.float(45,        "Min Swing (pts)",    minval=5, step=5, group=grp_h1)
extR1        = input.int(30,          "Extend Right (bars)", minval=0, maxval=200, group=grp_h1)
freeze1      = input.bool(true,       "Freeze Inverted",     group=grp_h1)
freezeB1     = input.int(10,          "Freeze After (bars)", minval=0, maxval=100, group=grp_h1)
lblPos1      = input.string("Top-Left", "Label Position", options=["Top-Left", "Top-Right", "Bot-Left", "Bot-Right"], group=grp_h1)

grp_h2 = "HTF 2"
c_tf2        = input.timeframe("30",  "Timeframe",          group=grp_h2)
c_tf2_on     = input.bool(true,       "Enabled",            group=grp_h2)
minSwing2    = input.float(80,        "Min Swing (pts)",    minval=5, step=5, group=grp_h2)
extR2        = input.int(50,          "Extend Right (bars)", minval=0, maxval=200, group=grp_h2)
freeze2      = input.bool(false,      "Freeze Inverted",     group=grp_h2)
freezeB2     = input.int(20,          "Freeze After (bars)", minval=0, maxval=100, group=grp_h2)
lblPos2      = input.string("Top-Left", "Label Position", options=["Top-Left", "Top-Right", "Bot-Left", "Bot-Right"], group=grp_h2)

grp_h3 = "HTF 3"
c_tf3        = input.timeframe("60",  "Timeframe",          group=grp_h3)
c_tf3_on     = input.bool(false,      "Enabled",            group=grp_h3)
minSwing3    = input.float(145,       "Min Swing (pts)",    minval=5, step=5, group=grp_h3)
extR3        = input.int(80,          "Extend Right (bars)", minval=0, maxval=200, group=grp_h3)
freeze3      = input.bool(false,      "Freeze Inverted",     group=grp_h3)
freezeB3     = input.int(30,          "Freeze After (bars)", minval=0, maxval=100, group=grp_h3)
lblPos3      = input.string("Top-Left", "Label Position", options=["Top-Left", "Top-Right", "Bot-Left", "Bot-Right"], group=grp_h3)

// Resolve TFs
htf1_tf = combo == "Custom" ? c_tf1 : "15"
htf2_tf = combo == "Custom" ? c_tf2 : "30"
htf3_tf = combo == "Custom" ? c_tf3 : "60"

htf1_on = combo == "Chart Only" ? false : combo == "Custom" ? c_tf1_on : true
htf2_on = switch combo
    "Chart Only"   => false
    "Chart + 15m"  => false
    "Custom"       => c_tf2_on
    => true
htf3_on = switch combo
    "Chart + 15m + 30m + 1h" => true
    "Custom" => c_tf3_on
    => false

// ═══════════════════════════════════════════════════════════════════════════════
// SWING DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

grp_swing = "Swing Detection"
pivotLen     = input.int(5,      "Pivot Lookback",              minval=2, maxval=20,  group=grp_swing)
minSwing0    = input.float(25,   "Min Swing (pts) — Chart TF", minval=5, step=5,     group=grp_swing)

grp_fib = "Fibonacci"
entryFib  = input.float(0.618, "Entry Level", options=[0.618, 0.705, 0.786], group=grp_fib)
showEntry = input.bool(true,   "Show Entry Lines", group=grp_fib)
showCE    = input.bool(true,   "Show CE Line", group=grp_fib)
show786   = input.bool(true,   "Show 0.786 Line (uninverted)", group=grp_fib)
show886   = input.bool(false,  "Show 0.886 Line (uninverted)", group=grp_fib)

grp_dir = "Direction"
showLong  = input.bool(true, "Long Setups (Bearish GP)", group=grp_dir)
showShort = input.bool(true, "Short Setups (Bullish GP)", group=grp_dir)

// ═══════════════════════════════════════════════════════════════════════════════
// IDs & SWING LABELS
// ═══════════════════════════════════════════════════════════════════════════════

grp_ids = "IDs & Swing Labels"
showZoneIDs     = input.bool(true,    "Show Zone IDs",       group=grp_ids)
showSwingIDs    = input.bool(true,    "Show Swing IDs",      group=grp_ids)
showSwingLines  = input.bool(true,    "Show Swing Lines",    group=grp_ids)
swingIDSize     = input.string("tiny","Swing ID Size",       options=["tiny", "small", "normal"], group=grp_ids)
swingHColor     = input.color(color.new(#FF9800, 10), "Swing High ID Color", group=grp_ids)
swingLColor     = input.color(color.new(#2196F3, 10), "Swing Low ID Color",  group=grp_ids)
zoneIDSize      = input.string("tiny","Zone ID Size",        options=["tiny", "small", "normal"], group=grp_ids)

// ═══════════════════════════════════════════════════════════════════════════════
// ZONE LIFECYCLE
// ═══════════════════════════════════════════════════════════════════════════════

grp_life = "Zone Lifecycle"
hideInvalidated = input.bool(true,  "Delete Invalidated Zones",  group=grp_life)
maxPerTF        = input.int(6,      "Max Zones Per TF",          minval=2, maxval=50, group=grp_life)

grp_inv = "Invalidation"
invalidateOnBreak = input.bool(true, "Invalidate on Swing Break", group=grp_inv)

// ═══════════════════════════════════════════════════════════════════════════════
// VISUALS
// ═══════════════════════════════════════════════════════════════════════════════

grp_vis = "Visuals"
showLabels    = input.bool(true,     "Show Zone Labels",    group=grp_vis)
labelSize     = input.string("tiny", "Zone Label Size", options=["tiny", "small", "normal"], group=grp_vis)

grp_lbl = "Zone Label Content"
lblShowID       = input.bool(true,  "Zone ID (Z123)",           group=grp_lbl)
lblShowTF       = input.bool(true,  "Timeframe + Direction",    group=grp_lbl)
lblShowSize     = input.bool(true,  "Swing Size (42pt)",        group=grp_lbl)
lblShowSwRef    = input.bool(false, "Swing Refs [H→L]",         group=grp_lbl)
lblShowSwTime   = input.bool(true,  "Swing Time",               group=grp_lbl)
lblShowInvTime  = input.bool(true,  "Inversion Time",           group=grp_lbl)
lblShowCE       = input.bool(true,  "CE Value",                 group=grp_lbl)

grp_cols = "TF Colors"
col0 = input.color(#9C27B0, "Chart TF",  group=grp_cols)
col1 = input.color(#2196F3, "HTF 1",     group=grp_cols)
col2 = input.color(#FF9800, "HTF 2",     group=grp_cols)
col3 = input.color(#00BCD4, "HTF 3",     group=grp_cols)
ceColor      = input.color(#FFFFFF, "CE Line",        group=grp_cols)
invLongCol   = input.color(color.new(#00E676, 65), "Inverted Long",  group=grp_cols)
invShortCol  = input.color(color.new(#FF5252, 65), "Inverted Short", group=grp_cols)

// ═══════════════════════════════════════════════════════════════════════════════
// SIZE HELPERS
// ═══════════════════════════════════════════════════════════════════════════════

toLblSize(s) =>
    switch s
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        => size.tiny

lblSize     = toLblSize(labelSize)
swIDLblSize = toLblSize(swingIDSize)
zIDLblSize  = toLblSize(zoneIDSize)

getExtR(tfIdx) =>
    switch tfIdx
        0 => extR0
        1 => extR1
        2 => extR2
        3 => extR3
        => extR0

// Label style from position string + direction
// Returns [label_style, use_box_top]
// For longs: box top = 0.786, box bot = 0.618
// For shorts: box top = 0.618, box bot = 0.786
getLblStyle(tfIdx, dir) =>
    pos = switch tfIdx
        0 => lblPos0
        1 => lblPos1
        2 => lblPos2
        3 => lblPos3
        => lblPos0
    
    bool useTop = (pos == "Top-Left" or pos == "Top-Right")
    [label.style_none, useTop]

getLblX(tfIdx, leftBar) =>
    pos = switch tfIdx
        0 => lblPos0
        1 => lblPos1
        2 => lblPos2
        3 => lblPos3
        => lblPos0
    
    int xBar = leftBar
    if pos == "Top-Right" or pos == "Bot-Right"
        xBar := bar_index + getExtR(tfIdx)
    else
        // Clamp left positions so old zones don't error
        xBar := math.max(leftBar, bar_index - 500)
    xBar

isRightPos(tfIdx) =>
    pos = switch tfIdx
        0 => lblPos0
        1 => lblPos1
        2 => lblPos2
        3 => lblPos3
        => lblPos0
    pos == "Top-Right" or pos == "Bot-Right"

// ═══════════════════════════════════════════════════════════════════════════════
// ZONE ARRAYS
// ═══════════════════════════════════════════════════════════════════════════════

var int[]   z_tfIdx      = array.new_int()
var int[]   z_dir        = array.new_int()
var float[] z_swH        = array.new_float()
var float[] z_swL        = array.new_float()
var float[] z_618        = array.new_float()
var float[] z_786        = array.new_float()
var float[] z_886        = array.new_float()
var float[] z_ce         = array.new_float()
var int[]   z_barStart   = array.new_int()
var int[]   z_barEnd     = array.new_int()
var int[]   z_state      = array.new_int()
var int[]   z_stateBar   = array.new_int()
var int[]   z_createTime = array.new_int()
var int[]   z_id         = array.new_int()
var int[]   z_swHID      = array.new_int()
var int[]   z_swLID      = array.new_int()
var box[]   z_box        = array.new_box()
var line[]  z_eLine      = array.new_line()
var line[]  z_ceLine     = array.new_line()
var line[]  z_786Line    = array.new_line()
var line[]  z_886Line    = array.new_line()
var line[]  z_swHLine    = array.new_line()
var line[]  z_swLLine    = array.new_line()
var label[] z_swHLbl     = array.new_label()
var label[] z_swLLbl     = array.new_label()
var label[] z_lbl        = array.new_label()

var int nextZoneID = 1
var int swCtr0H = 1, var int swCtr0L = 1
var int swCtr1H = 1, var int swCtr1L = 1
var int swCtr2H = 1, var int swCtr2L = 1
var int swCtr3H = 1, var int swCtr3L = 1

// ═══════════════════════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════════════════════

deleteZone(i) =>
    box.delete(array.get(z_box, i))
    line.delete(array.get(z_eLine, i))
    line.delete(array.get(z_ceLine, i))
    line.delete(array.get(z_786Line, i))
    line.delete(array.get(z_886Line, i))
    label.delete(array.get(z_lbl, i))
    line.delete(array.get(z_swHLine, i))
    line.delete(array.get(z_swLLine, i))
    label.delete(array.get(z_swHLbl, i))
    label.delete(array.get(z_swLLbl, i))

removeAt(i) =>
    deleteZone(i)
    array.remove(z_tfIdx, i)
    array.remove(z_dir, i)
    array.remove(z_swH, i)
    array.remove(z_swL, i)
    array.remove(z_618, i)
    array.remove(z_786, i)
    array.remove(z_886, i)
    array.remove(z_ce, i)
    array.remove(z_barStart, i)
    array.remove(z_barEnd, i)
    array.remove(z_state, i)
    array.remove(z_stateBar, i)
    array.remove(z_createTime, i)
    array.remove(z_id, i)
    array.remove(z_swHID, i)
    array.remove(z_swLID, i)
    array.remove(z_box, i)
    array.remove(z_eLine, i)
    array.remove(z_ceLine, i)
    array.remove(z_786Line, i)
    array.remove(z_886Line, i)
    array.remove(z_lbl, i)
    array.remove(z_swHLine, i)
    array.remove(z_swLLine, i)
    array.remove(z_swHLbl, i)
    array.remove(z_swLLbl, i)

getTFColor(tfIdx) =>
    switch tfIdx
        0 => col0
        1 => col1
        2 => col2
        3 => col3
        => col0

fmtTF(raw) =>
    string result = raw
    if str.contains(raw, "S")
        result := str.replace_all(raw, "S", "s")
    else if raw == "D" or raw == "1D"
        result := "D"
    else if raw == "W" or raw == "1W"
        result := "W"
    else if raw == "M" or raw == "1M"
        result := "M"
    else
        mins = str.tonumber(raw)
        if not na(mins)
            if mins >= 60
                hrs = mins / 60
                if hrs == math.floor(hrs)
                    result := str.tostring(math.round(hrs)) + "h"
                else
                    result := str.tostring(mins) + "m"
            else
                result := raw + "m"
    result

getTFLabel(tfIdx) =>
    switch tfIdx
        0 => fmtTF(timeframe.period)
        1 => fmtTF(htf1_tf)
        2 => fmtTF(htf2_tf)
        3 => fmtTF(htf3_tf)
        => ""

getBorderWidth(tfIdx) =>
    switch tfIdx
        0 => 1
        1 => 1
        2 => 2
        3 => 2
        => 1

getTransparency(tfIdx) =>
    switch tfIdx
        0 => 78
        1 => 73
        2 => 68
        3 => 63
        => 75

fmtTime(unixMs) =>
    str.format_time(unixMs, "M/d HH:mm", "America/New_York")

countTFZones(tfIdx) =>
    count = 0
    if array.size(z_tfIdx) > 0
        for i = 0 to array.size(z_tfIdx) - 1
            if array.get(z_tfIdx, i) == tfIdx
                count += 1
    count

// ═══════════════════════════════════════════════════════════════════════════════
// ADD ZONE
// ═══════════════════════════════════════════════════════════════════════════════

addZone(tfIdx, direction, swHigh, swLow, swHBar, swLBar, swingTime, shID, slID, thisID) =>
    swingSize = swHigh - swLow
    
    float lvl618 = na
    float lvl786 = na
    float lvlCE  = na
    float boxTop = na
    float boxBot = na
    
    if direction == 1
        lvl618 := swLow + entryFib * swingSize
        lvl786 := swLow + 0.786 * swingSize
        lvlCE  := (lvl618 + lvl786) / 2.0
        boxTop := lvl786
        boxBot := lvl618
    else
        lvl618 := swHigh - entryFib * swingSize
        lvl786 := swHigh - 0.786 * swingSize
        lvlCE  := (lvl618 + lvl786) / 2.0
        boxTop := lvl618
        boxBot := lvl786
    
    float lvl886 = na
    if direction == 1
        lvl886 := swLow + 0.886 * swingSize
    else
        lvl886 := swHigh - 0.886 * swingSize
    
    extR    = getExtR(tfIdx)
    rEdge   = bar_index + extR
    tfCol   = getTFColor(tfIdx)
    bw      = getBorderWidth(tfIdx)
    trans   = getTransparency(tfIdx)
    maxBack  = 500
    leftBar  = math.max(math.min(swHBar, swLBar), bar_index - maxBack)
    clampedH = math.max(swHBar, bar_index - maxBack)
    clampedL = math.max(swLBar, bar_index - maxBack)
    
    // Data
    array.push(z_tfIdx, tfIdx)
    array.push(z_dir, direction)
    array.push(z_swH, swHigh)
    array.push(z_swL, swLow)
    array.push(z_618, lvl618)
    array.push(z_786, lvl786)
    array.push(z_886, lvl886)
    array.push(z_ce, lvlCE)
    array.push(z_barStart, leftBar)
    array.push(z_barEnd, math.max(swHBar, swLBar))
    array.push(z_state, 0)
    array.push(z_stateBar, 0)
    array.push(z_createTime, swingTime)
    array.push(z_id, thisID)
    array.push(z_swHID, shID)
    array.push(z_swLID, slID)
    
    // Box
    array.push(z_box, box.new(
         leftBar, boxTop, rEdge, boxBot,
         bgcolor=color.new(tfCol, trans), border_color=color.new(tfCol, trans - 20), border_width=bw))
    
    // Entry line
    array.push(z_eLine, showEntry ? line.new(
         leftBar, lvl618, rEdge, lvl618,
         color=color.new(tfCol, 20), style=line.style_dashed, width=1) : na)
    
    // CE line
    array.push(z_ceLine, showCE ? line.new(
         leftBar, lvlCE, rEdge, lvlCE,
         color=color.new(ceColor, 35), style=line.style_solid, width=1) : na)
    
    // 0.786 line
    array.push(z_786Line, show786 ? line.new(
         leftBar, lvl786, rEdge, lvl786,
         color=color.new(tfCol, 30), style=line.style_dotted, width=1) : na)
    
    // 0.886 line
    array.push(z_886Line, show886 ? line.new(
         leftBar, lvl886, rEdge, lvl886,
         color=color.new(#E040FB, 30), style=line.style_dotted, width=1) : na)
    
    // Swing lines
    array.push(z_swHLine, showSwingLines ? line.new(
         clampedH, swHigh, rEdge, swHigh,
         color=color.new(swingHColor, 40), style=line.style_dotted, width=1) : na)
    
    array.push(z_swLLine, showSwingLines ? line.new(
         clampedL, swLow, rEdge, swLow,
         color=color.new(swingLColor, 40), style=line.style_dotted, width=1) : na)
    
    // Swing H label (merge overlaps with /)
    zTag  = "Z" + str.tostring(thisID)
    tfTag = getTFLabel(tfIdx)
    swHtxt = zTag + " " + tfTag + " H"
    swLtxt = zTag + " " + tfTag + " L"
    mergedH = label(na)
    if showSwingIDs and array.size(z_swHLbl) > 0
        for k = 0 to array.size(z_swHLbl) - 1
            lbl_k = array.get(z_swHLbl, k)
            if not na(lbl_k)
                if label.get_x(lbl_k) == clampedH and math.abs(label.get_y(lbl_k) - swHigh) < 0.01
                    mergedH := lbl_k
                    break
    
    if showSwingIDs and not na(mergedH)
        label.set_text(mergedH, label.get_text(mergedH) + " / " + swHtxt)
        array.push(z_swHLbl, na)
    else
        array.push(z_swHLbl, showSwingIDs ? label.new(
             clampedH, swHigh,
             swHtxt,
             color=color.new(color.black, 100), textcolor=swingHColor,
             style=label.style_label_down, size=swIDLblSize) : na)
    
    // Swing L label (merge overlaps with /)
    mergedL = label(na)
    if showSwingIDs and array.size(z_swLLbl) > 0
        for k = 0 to array.size(z_swLLbl) - 1
            lbl_k = array.get(z_swLLbl, k)
            if not na(lbl_k)
                if label.get_x(lbl_k) == clampedL and math.abs(label.get_y(lbl_k) - swLow) < 0.01
                    mergedL := lbl_k
                    break
    
    if showSwingIDs and not na(mergedL)
        label.set_text(mergedL, label.get_text(mergedL) + " / " + swLtxt)
        array.push(z_swLLbl, na)
    else
        array.push(z_swLLbl, showSwingIDs ? label.new(
             clampedL, swLow,
             swLtxt,
             color=color.new(color.black, 100), textcolor=swingLColor,
             style=label.style_label_up, size=swIDLblSize) : na)
    
    // Zone label — configurable content
    dirTxt   = direction == 1 ? "↑" : "↓"
    tfLbl    = getTFLabel(tfIdx)
    
    // Build line 1: ID | TF GP↑ 42pt [H→L]
    line1 = ""
    if lblShowID
        line1 += "Z" + str.tostring(thisID)
    if lblShowTF
        line1 += (str.length(line1) > 0 ? " | " : "") + tfLbl + " GP" + dirTxt
    if lblShowSize
        line1 += " " + str.tostring(math.round(swingSize)) + "pt"
    if lblShowSwRef
        if direction == 1
            line1 += " [H" + str.tostring(shID) + "→L" + str.tostring(slID) + "]"
        else
            line1 += " [L" + str.tostring(slID) + "→H" + str.tostring(shID) + "]"
    
    // Build line 2+: time, CE
    line2 = ""
    if lblShowSwTime
        line2 += fmtTime(swingTime)
    if lblShowCE
        line2 += (str.length(line2) > 0 ? "  " : "") + "CE:" + str.tostring(lvlCE, "#.##")
    
    lblTxt = line1 + (str.length(line2) > 0 ? "\n" + line2 : "")
    
    [lblStyle, useTop] = getLblStyle(tfIdx, direction)
    lblX               = getLblX(tfIdx, leftBar)
    lblY               = useTop ? boxTop : boxBot
    
    array.push(z_lbl, showLabels ? label.new(
         lblX, lblY,
         lblTxt,
         color=color.new(color.black, 100), textcolor=color.new(tfCol, 10),
         style=lblStyle, size=lblSize) : na)

// ═══════════════════════════════════════════════════════════════════════════════
// TRIM
// ═══════════════════════════════════════════════════════════════════════════════

trimTF(tfIdx) =>
    while countTFZones(tfIdx) > maxPerTF
        found = -1
        if array.size(z_tfIdx) > 0
            for i = 0 to array.size(z_tfIdx) - 1
                if array.get(z_tfIdx, i) == tfIdx
                    found := i
                    break
        if found >= 0
            removeAt(found)

// ═══════════════════════════════════════════════════════════════════════════════
// CHART TF — PIVOTS
// ═══════════════════════════════════════════════════════════════════════════════

pvtH0 = ta.pivothigh(high, pivotLen, pivotLen)
pvtL0 = ta.pivotlow(low, pivotLen, pivotLen)

var float last0H = na, var int last0HBar = na, var int last0HTime = na, var int last0HID = 0
var float last0L = na, var int last0LBar = na, var int last0LTime = na, var int last0LID = 0

if not na(pvtH0)
    last0H := pvtH0, last0HBar := bar_index - pivotLen, last0HTime := time[pivotLen], last0HID := swCtr0H, swCtr0H += 1

if not na(pvtL0)
    last0L := pvtL0, last0LBar := bar_index - pivotLen, last0LTime := time[pivotLen], last0LID := swCtr0L, swCtr0L += 1

// Bearish GP → Long
if not na(pvtL0) and showLong and chartTF_on
    if not na(last0H) and last0HBar < (bar_index - pivotLen)
        if (last0H - pvtL0) >= minSwing0
            addZone(0, 1, last0H, pvtL0, last0HBar, bar_index - pivotLen, last0HTime, last0HID, last0LID, nextZoneID)
            nextZoneID += 1
            trimTF(0)

// Bullish GP → Short
if not na(pvtH0) and showShort and chartTF_on
    if not na(last0L) and last0LBar < (bar_index - pivotLen)
        if (pvtH0 - last0L) >= minSwing0
            addZone(0, -1, pvtH0, last0L, bar_index - pivotLen, last0LBar, last0LTime, last0HID, last0LID, nextZoneID)
            nextZoneID += 1
            trimTF(0)

// ═══════════════════════════════════════════════════════════════════════════════
// HTF PIVOTS
// ═══════════════════════════════════════════════════════════════════════════════

// --- HTF 1 ---
htf1_pvtH = htf1_on ? request.security(syminfo.tickerid, htf1_tf, ta.pivothigh(high, pivotLen, pivotLen)) : float(na)
htf1_pvtL = htf1_on ? request.security(syminfo.tickerid, htf1_tf, ta.pivotlow(low, pivotLen, pivotLen))   : float(na)

var float last1H = na, var int last1HBar = na, var int last1HTime = na, var int last1HID = 0
var float last1L = na, var int last1LBar = na, var int last1LTime = na, var int last1LID = 0

htf1_newH = htf1_on and not na(htf1_pvtH) and (na(htf1_pvtH[1]) or htf1_pvtH != htf1_pvtH[1])
htf1_newL = htf1_on and not na(htf1_pvtL) and (na(htf1_pvtL[1]) or htf1_pvtL != htf1_pvtL[1])

if htf1_newH
    last1H := htf1_pvtH, last1HBar := bar_index, last1HTime := time, last1HID := swCtr1H, swCtr1H += 1
if htf1_newL
    last1L := htf1_pvtL, last1LBar := bar_index, last1LTime := time, last1LID := swCtr1L, swCtr1L += 1

if htf1_newL and showLong and not na(last1H) and last1HBar < bar_index
    if (last1H - htf1_pvtL) >= minSwing1
        addZone(1, 1, last1H, htf1_pvtL, last1HBar, bar_index, last1HTime, last1HID, last1LID, nextZoneID)
        nextZoneID += 1
        trimTF(1)

if htf1_newH and showShort and not na(last1L) and last1LBar < bar_index
    if (htf1_pvtH - last1L) >= minSwing1
        addZone(1, -1, htf1_pvtH, last1L, bar_index, last1LBar, last1LTime, last1HID, last1LID, nextZoneID)
        nextZoneID += 1
        trimTF(1)

// --- HTF 2 ---
htf2_pvtH = htf2_on ? request.security(syminfo.tickerid, htf2_tf, ta.pivothigh(high, pivotLen, pivotLen)) : float(na)
htf2_pvtL = htf2_on ? request.security(syminfo.tickerid, htf2_tf, ta.pivotlow(low, pivotLen, pivotLen))   : float(na)

var float last2H = na, var int last2HBar = na, var int last2HTime = na, var int last2HID = 0
var float last2L = na, var int last2LBar = na, var int last2LTime = na, var int last2LID = 0

htf2_newH = htf2_on and not na(htf2_pvtH) and (na(htf2_pvtH[1]) or htf2_pvtH != htf2_pvtH[1])
htf2_newL = htf2_on and not na(htf2_pvtL) and (na(htf2_pvtL[1]) or htf2_pvtL != htf2_pvtL[1])

if htf2_newH
    last2H := htf2_pvtH, last2HBar := bar_index, last2HTime := time, last2HID := swCtr2H, swCtr2H += 1
if htf2_newL
    last2L := htf2_pvtL, last2LBar := bar_index, last2LTime := time, last2LID := swCtr2L, swCtr2L += 1

if htf2_newL and showLong and not na(last2H) and last2HBar < bar_index
    if (last2H - htf2_pvtL) >= minSwing2
        addZone(2, 1, last2H, htf2_pvtL, last2HBar, bar_index, last2HTime, last2HID, last2LID, nextZoneID)
        nextZoneID += 1
        trimTF(2)

if htf2_newH and showShort and not na(last2L) and last2LBar < bar_index
    if (htf2_pvtH - last2L) >= minSwing2
        addZone(2, -1, htf2_pvtH, last2L, bar_index, last2LBar, last2LTime, last2HID, last2LID, nextZoneID)
        nextZoneID += 1
        trimTF(2)

// --- HTF 3 ---
htf3_pvtH = htf3_on ? request.security(syminfo.tickerid, htf3_tf, ta.pivothigh(high, pivotLen, pivotLen)) : float(na)
htf3_pvtL = htf3_on ? request.security(syminfo.tickerid, htf3_tf, ta.pivotlow(low, pivotLen, pivotLen))   : float(na)

var float last3H = na, var int last3HBar = na, var int last3HTime = na, var int last3HID = 0
var float last3L = na, var int last3LBar = na, var int last3LTime = na, var int last3LID = 0

htf3_newH = htf3_on and not na(htf3_pvtH) and (na(htf3_pvtH[1]) or htf3_pvtH != htf3_pvtH[1])
htf3_newL = htf3_on and not na(htf3_pvtL) and (na(htf3_pvtL[1]) or htf3_pvtL != htf3_pvtL[1])

if htf3_newH
    last3H := htf3_pvtH, last3HBar := bar_index, last3HTime := time, last3HID := swCtr3H, swCtr3H += 1
if htf3_newL
    last3L := htf3_pvtL, last3LBar := bar_index, last3LTime := time, last3LID := swCtr3L, swCtr3L += 1

if htf3_newL and showLong and not na(last3H) and last3HBar < bar_index
    if (last3H - htf3_pvtL) >= minSwing3
        addZone(3, 1, last3H, htf3_pvtL, last3HBar, bar_index, last3HTime, last3HID, last3LID, nextZoneID)
        nextZoneID += 1
        trimTF(3)

if htf3_newH and showShort and not na(last3L) and last3LBar < bar_index
    if (htf3_pvtH - last3L) >= minSwing3
        addZone(3, -1, htf3_pvtH, last3L, bar_index, last3LBar, last3LTime, last3HID, last3LID, nextZoneID)
        nextZoneID += 1
        trimTF(3)

// ═══════════════════════════════════════════════════════════════════════════════
// ZONE UPDATE LOOP
// ═══════════════════════════════════════════════════════════════════════════════

var int[] removeQueue = array.new_int()
array.clear(removeQueue)

if array.size(z_state) > 0
    for i = 0 to array.size(z_state) - 1
        state  = array.get(z_state, i)
        dir    = array.get(z_dir, i)
        lvl786 = array.get(z_786, i)
        lvl618 = array.get(z_618, i)
        lvlCE  = array.get(z_ce, i)
        swH    = array.get(z_swH, i)
        swL    = array.get(z_swL, i)
        stBar  = array.get(z_stateBar, i)
        tfIdx  = array.get(z_tfIdx, i)
        cTime  = array.get(z_createTime, i)
        zID    = array.get(z_id, i)
        shID   = array.get(z_swHID, i)
        slID   = array.get(z_swLID, i)
        bx     = array.get(z_box, i)
        eln    = array.get(z_eLine, i)
        celn   = array.get(z_ceLine, i)
        lb     = array.get(z_lbl, i)
        shLn   = array.get(z_swHLine, i)
        slLn   = array.get(z_swLLine, i)
        l786   = array.get(z_786Line, i)
        l886   = array.get(z_886Line, i)
        leftBar = array.get(z_barStart, i)
        
        extR   = getExtR(tfIdx)
        
        if state == 0
            inverted    = false
            invalidated = false
            
            if dir == 1
                inverted    := close > lvl786
                invalidated := invalidateOnBreak and close < swL
            else
                inverted    := close < lvl786
                invalidated := invalidateOnBreak and close > swH
            
            if inverted
                array.set(z_state, i, 1)
                array.set(z_stateBar, i, bar_index)
                invCol = dir == 1 ? invLongCol : invShortCol
                box.set_bgcolor(bx, invCol)
                box.set_border_color(bx, invCol)
                box.set_border_width(bx, getBorderWidth(tfIdx) + 1)
                
                if not na(celn)
                    line.set_color(celn, dir == 1 ? color.new(#00E676, 20) : color.new(#FF5252, 20))
                    line.set_width(celn, 2)
                
                if not na(shLn)
                    line.set_style(shLn, line.style_solid)
                    line.set_color(shLn, color.new(swingHColor, 20))
                if not na(slLn)
                    line.set_style(slLn, line.style_solid)
                    line.set_color(slLn, color.new(swingLColor, 20))
                
                if not na(l786)
                    line.delete(l786)
                    array.set(z_786Line, i, na)
                if not na(l886)
                    line.delete(l886)
                    array.set(z_886Line, i, na)
                
                // Update label
                if showLabels and not na(lb)
                    tfLbl2   = getTFLabel(tfIdx)
                    dirTxt2  = dir == 1 ? "↑" : "↓"
                    
                    // Line 1: ID | TF IGP↑ [H→L]
                    iLine1 = ""
                    if lblShowID
                        iLine1 += "Z" + str.tostring(zID)
                    if lblShowTF
                        iLine1 += (str.length(iLine1) > 0 ? " | " : "") + tfLbl2 + " IGP" + dirTxt2
                    if lblShowSwRef
                        if dir == 1
                            iLine1 += " [H" + str.tostring(shID) + "→L" + str.tostring(slID) + "]"
                        else
                            iLine1 += " [L" + str.tostring(slID) + "→H" + str.tostring(shID) + "]"
                    
                    // Additional lines
                    iExtra = ""
                    if lblShowSwTime
                        iExtra += "\nSwing: " + fmtTime(cTime)
                    if lblShowInvTime
                        iExtra += "\nInv: " + fmtTime(time)
                    if lblShowCE
                        iExtra += "\nCE: " + str.tostring(lvlCE, "#.##")
                    
                    label.set_text(lb, iLine1 + iExtra)
                    label.set_textcolor(lb, dir == 1 ? #00E676 : #FF5252)
                    if isRightPos(tfIdx)
                        label.set_x(lb, getLblX(tfIdx, leftBar))
            
            else if invalidated
                if hideInvalidated
                    array.push(removeQueue, i)
                else
                    array.set(z_state, i, -1)
                    array.set(z_stateBar, i, bar_index)
                    box.set_bgcolor(bx, color.new(color.gray, 92))
                    box.set_border_color(bx, color.new(color.gray, 85))
                    box.set_border_style(bx, line.style_dotted)
                    box.set_border_width(bx, 1)
                    if not na(eln)
                        line.set_color(eln, color.new(color.gray, 85))
                    if not na(celn)
                        line.set_color(celn, color.new(color.gray, 85))
                    if not na(shLn)
                        line.set_color(shLn, color.new(color.gray, 85))
                    if not na(slLn)
                        line.set_color(slLn, color.new(color.gray, 85))
                    if not na(l786)
                        line.set_color(l786, color.new(color.gray, 85))
                    if not na(l886)
                        line.set_color(l886, color.new(color.gray, 85))
                    if showLabels and not na(lb)
                        idPfx = showZoneIDs ? "Z" + str.tostring(zID) + " " : ""
                        label.set_text(lb, idPfx + "✗")
                        label.set_textcolor(lb, color.new(color.gray, 65))
            
            else
                // Potential — extend everything
                rEdge = bar_index + extR
                if not na(bx)
                    box.set_right(bx, rEdge)
                if not na(eln)
                    line.set_x2(eln, rEdge)
                if not na(celn)
                    line.set_x2(celn, rEdge)
                if not na(shLn)
                    line.set_x2(shLn, rEdge)
                if not na(slLn)
                    line.set_x2(slLn, rEdge)
                if not na(l786)
                    line.set_x2(l786, rEdge)
                if not na(l886)
                    line.set_x2(l886, rEdge)
                // Update right-positioned labels
                if not na(lb) and isRightPos(tfIdx)
                    label.set_x(lb, getLblX(tfIdx, leftBar))
        
        else if state == 1
            doFreeze = switch tfIdx
                0 => freeze0
                1 => freeze1
                2 => freeze2
                3 => freeze3
                => true
            fBars = switch tfIdx
                0 => freezeB0
                1 => freezeB1
                2 => freezeB2
                3 => freezeB3
                => 10
            if not doFreeze or (bar_index - stBar) <= fBars
                rEdge2 = bar_index + extR
                if not na(bx)
                    box.set_right(bx, rEdge2)
                if not na(eln)
                    line.set_x2(eln, rEdge2)
                if not na(celn)
                    line.set_x2(celn, rEdge2)
                if not na(shLn)
                    line.set_x2(shLn, rEdge2)
                if not na(slLn)
                    line.set_x2(slLn, rEdge2)
                if not na(lb) and isRightPos(tfIdx)
                    lblXupd2 = getLblX(tfIdx, leftBar)
                    label.set_x(lb, lblXupd2)

// Remove queued
if array.size(removeQueue) > 0
    array.sort(removeQueue, order.descending)
    prevRm = -1
    for j = 0 to array.size(removeQueue) - 1
        idx = array.get(removeQueue, j)
        if idx != prevRm and idx < array.size(z_state)
            removeAt(idx)
            prevRm := idx

// ═══════════════════════════════════════════════════════════════════════════════
// INFO TABLE
// ═══════════════════════════════════════════════════════════════════════════════

var table tbl = table.new(position.top_right, 4, 6, bgcolor=color.new(color.black, 85), border_width=1, border_color=color.new(color.gray, 70))

if barstate.islast
    var int pot0 = 0, var int inv0 = 0
    var int pot1 = 0, var int inv1 = 0
    var int pot2 = 0, var int inv2 = 0
    var int pot3 = 0, var int inv3 = 0
    pot0 := 0, inv0 := 0
    pot1 := 0, inv1 := 0
    pot2 := 0, inv2 := 0
    pot3 := 0, inv3 := 0
    
    if array.size(z_state) > 0
        for i = 0 to array.size(z_state) - 1
            tf = array.get(z_tfIdx, i)
            st = array.get(z_state, i)
            if tf == 0
                if st == 0
                    pot0 += 1
                else if st == 1
                    inv0 += 1
            else if tf == 1
                if st == 0
                    pot1 += 1
                else if st == 1
                    inv1 += 1
            else if tf == 2
                if st == 0
                    pot2 += 1
                else if st == 1
                    inv2 += 1
            else if tf == 3
                if st == 0
                    pot3 += 1
                else if st == 1
                    inv3 += 1
    
    table.cell(tbl, 0, 0, "TF",    text_color=color.white, text_size=size.tiny, bgcolor=color.new(#9C27B0, 50))
    table.cell(tbl, 1, 0, "Pot",   text_color=color.white, text_size=size.tiny, bgcolor=color.new(#9C27B0, 50))
    table.cell(tbl, 2, 0, "Inv",   text_color=color.white, text_size=size.tiny, bgcolor=color.new(#9C27B0, 50))
    table.cell(tbl, 3, 0, "MinPt", text_color=color.white, text_size=size.tiny, bgcolor=color.new(#9C27B0, 50))
    
    if chartTF_on
        table.cell(tbl, 0, 1, fmtTF(timeframe.period), text_color=col0, text_size=size.tiny)
        table.cell(tbl, 1, 1, str.tostring(pot0), text_color=pot0 > 0 ? #FFFF00 : color.gray, text_size=size.tiny)
        table.cell(tbl, 2, 1, str.tostring(inv0), text_color=inv0 > 0 ? #00E676 : color.gray, text_size=size.tiny)
        table.cell(tbl, 3, 1, str.tostring(math.round(minSwing0)), text_color=color.gray, text_size=size.tiny)
    
    if htf1_on
        table.cell(tbl, 0, 2, fmtTF(htf1_tf), text_color=col1, text_size=size.tiny)
        table.cell(tbl, 1, 2, str.tostring(pot1), text_color=pot1 > 0 ? #FFFF00 : color.gray, text_size=size.tiny)
        table.cell(tbl, 2, 2, str.tostring(inv1), text_color=inv1 > 0 ? #00E676 : color.gray, text_size=size.tiny)
        table.cell(tbl, 3, 2, str.tostring(math.round(minSwing1)), text_color=color.gray, text_size=size.tiny)
    
    if htf2_on
        table.cell(tbl, 0, 3, fmtTF(htf2_tf), text_color=col2, text_size=size.tiny)
        table.cell(tbl, 1, 3, str.tostring(pot2), text_color=pot2 > 0 ? #FFFF00 : color.gray, text_size=size.tiny)
        table.cell(tbl, 2, 3, str.tostring(inv2), text_color=inv2 > 0 ? #00E676 : color.gray, text_size=size.tiny)
        table.cell(tbl, 3, 3, str.tostring(math.round(minSwing2)), text_color=color.gray, text_size=size.tiny)
    
    if htf3_on
        table.cell(tbl, 0, 4, fmtTF(htf3_tf), text_color=col3, text_size=size.tiny)
        table.cell(tbl, 1, 4, str.tostring(pot3), text_color=pot3 > 0 ? #FFFF00 : color.gray, text_size=size.tiny)
        table.cell(tbl, 2, 4, str.tostring(inv3), text_color=inv3 > 0 ? #00E676 : color.gray, text_size=size.tiny)
        table.cell(tbl, 3, 4, str.tostring(math.round(minSwing3)), text_color=color.gray, text_size=size.tiny)
    
    totPot = pot0 + pot1 + pot2 + pot3
    totInv = inv0 + inv1 + inv2 + inv3
    table.cell(tbl, 0, 5, "TOTAL", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.gray, 70))
    table.cell(tbl, 1, 5, str.tostring(totPot), text_color=totPot > 0 ? #FFFF00 : color.gray, text_size=size.tiny, bgcolor=color.new(color.gray, 70))
    table.cell(tbl, 2, 5, str.tostring(totInv), text_color=totInv > 0 ? #00E676 : color.gray, text_size=size.tiny, bgcolor=color.new(color.gray, 70))
    table.cell(tbl, 3, 5, "", bgcolor=color.new(color.gray, 70))
