//@version=6
indicator('MTF Swing Point Trend Lines', overlay = true, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS — CURRENT TIMEFRAME
// ─────────────────────────────────────────────────────────────────────────────
swingSize       = input.int(6, 'Swing Length', minval = 1,
     tooltip    = 'Bars left & right for pivot detection. Higher = fewer, more significant swings')
showSwingLabels = input.bool(true,  'Show Swing Labels (HH/LH/HL/LL)', group = 'Display')
showHalfRetrace = input.bool(false, 'Show 0.5 Retracement Level',       group = 'Display')

labelColorHigh  = input.color(color.white, 'Label Color (Highs)', group = 'Appearance')
labelColorLow   = input.color(color.white, 'Label Color (Lows)',  group = 'Appearance')
halfColor       = input.color(color.blue,  '0.5 Retrace Color',  group = 'Appearance')
halfStyleIn     = input.string('Solid', '0.5 Line Style', options = ['Solid','Dashed','Dotted'], group = 'Appearance')
halfWidth       = input.int(1, '0.5 Line Width', minval = 1, group = 'Appearance')

// ── Current TF Trendlines ──
showTrendLines    = input.bool(true, 'Show Swing Trendlines', group = 'Trendlines')
maxLinesPerAnchor = input.int(3, 'Max Lines Per Swing Point', minval = 1, maxval = 50,
     tooltip    = 'Maximum trendlines allowed from a single anchor point (HH or LL). '
                + 'When exceeded, the oldest line from that anchor is deleted.',
     group      = 'Trendlines')
minWickTouches  = input.int(1, 'Min Wick Touches to Keep Line', minval = 0,
     tooltip    = 'Minimum wick touches required AFTER the second anchor point (LH/HL). '
                + 'Lines with fewer touches are deleted when broken. Set 0 to keep all lines.',
     group      = 'Trendlines')
breakPct        = input.float(100.0, 'Body % Required to Break Line', minval = 1.0, maxval = 100.0, step = 5.0,
     tooltip    = 'Percentage of the candle body that must close beyond the line to register a valid break.',
     group      = 'Trendlines')
trendColorDown  = input.color(color.red,  'Downtrend Line Color', group = 'Trendlines')
trendColorUp    = input.color(color.lime, 'Uptrend Line Color',   group = 'Trendlines')
trendWidthIn    = input.int(1, 'Trendline Width', minval = 1, group = 'Trendlines')
trendStyleIn    = input.string('Solid', 'Trendline Style', options = ['Solid','Dashed','Dotted'], group = 'Trendlines')

// ── HTF Trendlines ──
htfEnabled      = input.bool(false, 'Enable HTF Trendlines', group = 'HTF Trendlines')
htfTimeframe    = input.timeframe('D', 'HTF Timeframe', group = 'HTF Trendlines')
htfSwingSize    = input.int(3, 'HTF Swing Length', minval = 1,
     tooltip    = 'Bars left & right for pivot detection on the higher timeframe.',
     group      = 'HTF Trendlines')
htfMaxLines     = input.int(3, 'HTF Max Lines Per Swing Point', minval = 1, maxval = 50,
     group      = 'HTF Trendlines')
htfMinTouches   = input.int(1, 'HTF Min Wick Touches to Keep Line', minval = 0,
     group      = 'HTF Trendlines')
htfBreakPct     = input.float(100.0, 'HTF Body % Required to Break Line', minval = 1.0, maxval = 100.0, step = 5.0,
     group      = 'HTF Trendlines')
htfColorDown    = input.color(color.orange, 'HTF Downtrend Line Color', group = 'HTF Trendlines')
htfColorUp      = input.color(color.aqua,   'HTF Uptrend Line Color',   group = 'HTF Trendlines')
htfWidthIn      = input.int(2, 'HTF Line Width', minval = 1, group = 'HTF Trendlines')
htfStyleIn      = input.string('Dashed', 'HTF Line Style', options = ['Solid','Dashed','Dotted'], group = 'HTF Trendlines')

// ── Break Triangles — Current TF ──
showBreakTriangles  = input.bool(true, 'Show Break Triangles', group = 'Break Triangles')
triUpColor          = input.color(color.green,  'Up Break Color',   group = 'Break Triangles')
triDnColor          = input.color(color.red,    'Down Break Color', group = 'Break Triangles')
triSize             = input.string('Tiny', 'Size',
     options     = ['Auto','Tiny','Small','Normal','Large','Huge'],
     tooltip     = 'Auto = adapts to chart zoom level.',
     group       = 'Break Triangles')
triAnchor           = input.string('Below Bar', 'Up-Break Position',
     options     = ['Below Bar', 'Above Bar', 'Bar Extreme', 'Break Level', 'Close', 'Open'],
     tooltip     = 'Where the up-break triangle is anchored.\n'
                + '• Below Bar  — always at the low\n'
                + '• Above Bar  — always at the high\n'
                + '• Bar Extreme — wick tip in the break direction (low for up, high for down)\n'
                + '• Break Level — price where the line was crossed\n'
                + '• Close / Open — those candle prices',
     group       = 'Break Triangles')
triAnchorDn         = input.string('Above Bar', 'Down-Break Position',
     options     = ['Below Bar', 'Above Bar', 'Bar Extreme', 'Break Level', 'Close', 'Open'],
     group       = 'Break Triangles')
triOffsetMode       = input.string('% of Bar Range', 'Offset Mode',
     options     = ['% of Bar Range', 'Fixed Price Units'],
     tooltip     = '% of Bar Range: offset scales with candle size.\nFixed Price Units: offset is an absolute price amount.',
     group       = 'Break Triangles')
triOffset           = input.float(123.0, 'Offset Value', minval = -10000.0, maxval = 10000.0, step = 0.5,
     tooltip     = 'Shifts the triangle by this amount (in the chosen Offset Mode). '
                + 'Negative = toward candle body. Positive = away from candle body.',
     group       = 'Break Triangles')

// ── Break Triangles — HTF ──
showHtfTriangles    = input.bool(true, 'Show HTF Break Triangles', group = 'Break Triangles')
htfTriUpColor       = input.color(color.green,  'HTF Up Break Color',   group = 'Break Triangles')
htfTriDnColor       = input.color(color.red,    'HTF Down Break Color', group = 'Break Triangles')
htfTriSize          = input.string('Normal', 'HTF Size',
     options     = ['Auto','Tiny','Small','Normal','Large','Huge'],
     group       = 'Break Triangles')
htfTriAnchor        = input.string('Below Bar', 'HTF Up-Break Position',
     options     = ['Below Bar', 'Above Bar', 'Bar Extreme', 'Break Level', 'Close', 'Open'],
     group       = 'Break Triangles')
htfTriAnchorDn      = input.string('Above Bar', 'HTF Down-Break Position',
     options     = ['Below Bar', 'Above Bar', 'Bar Extreme', 'Break Level', 'Close', 'Open'],
     group       = 'Break Triangles')
htfTriOffsetMode    = input.string('% of Bar Range', 'HTF Offset Mode',
     options     = ['% of Bar Range', 'Fixed Price Units'],
     group       = 'Break Triangles')
htfTriOffset        = input.float(0.0, 'HTF Offset Value', minval = -10000.0, maxval = 10000.0, step = 0.5,
     group       = 'Break Triangles')

// ─────────────────────────────────────────────────────────────────────────────
// HELPER FUNCTIONS
// ─────────────────────────────────────────────────────────────────────────────
getStyle(s) =>
    switch s
        'Dashed' => line.style_dashed
        'Dotted' => line.style_dotted
        =>          line.style_solid

getTriSize(s) =>
    switch s
        'Auto'   => size.auto
        'Tiny'   => size.tiny
        'Small'  => size.small
        'Large'  => size.large
        'Huge'   => size.huge
        =>          size.normal

// Resolve triangle Y position from anchor name, break level, and direction (isUp)
triYPos(anchorName, lv, isUp, offsetMode, offsetVal) =>
    _barRange = high - low
    _base = switch anchorName
        'Below Bar'   => low
        'Above Bar'   => high
        'Break Level' => lv
        'Close'       => close
        'Open'        => open
        // 'Bar Extreme' — wick tip in the break direction
        =>  isUp ? low : high
    _off = offsetMode == 'Fixed Price Units' ? offsetVal : _barRange * offsetVal / 100.0
    // For up-break triangles we subtract (triangle below); for down-break we add (above)
    isUp ? _base - _off : _base + _off

lineY(x1, y1, x2, y2, b) =>
    x1 == x2 ? y1 : y1 + (y2 - y1) / (x2 - x1) * (b - x1)

lineYTime(t1, y1, t2, y2, t) =>
    t1 == t2 ? y1 : y1 + (y2 - y1) / float(t2 - t1) * float(t - t1)

bodyPctAcross(lv, dn) =>
    bodyTop  = math.max(open, close)
    bodyBot  = math.min(open, close)
    bodySize = bodyTop - bodyBot
    if bodySize <= 0.0
        0.0
    else if dn
        math.max(0.0, bodyTop - lv) / bodySize * 100.0
    else
        math.max(0.0, lv - bodyBot) / bodySize * 100.0

// ─────────────────────────────────────────────────────────────────────────────
// PIVOT DETECTION — CURRENT TF
// ─────────────────────────────────────────────────────────────────────────────
pivHi = ta.pivothigh(high, swingSize, swingSize)
pivLo = ta.pivotlow (low,  swingSize, swingSize)

var float prevHigh      = na
var float prevLow       = na
var int   prevHighIndex = na
var int   prevLowIndex  = na
var int   prevSwing     = 0

bool hh = false
bool lh = false
bool hl = false
bool ll = false

int pivotHighBar = na
int pivotLowBar  = na

var float lastHH_price = na
var int   lastHH_bar   = na
var float lastLL_price = na
var int   lastLL_bar   = na

if not na(pivHi)
    pivotHighBar := bar_index - swingSize
    if not na(prevHigh)
        if pivHi >= prevHigh
            hh        := true
            prevSwing := 2
        else
            lh        := true
            prevSwing := 1
    prevHigh      := pivHi
    prevHighIndex := pivotHighBar

if not na(pivLo)
    pivotLowBar := bar_index - swingSize
    if not na(prevLow)
        if pivLo >= prevLow
            hl        := true
            prevSwing := -1
        else
            ll        := true
            prevSwing := -2
    prevLow      := pivLo
    prevLowIndex := pivotLowBar

if hh
    lastHH_price := pivHi
    lastHH_bar   := bar_index - swingSize

if ll
    lastLL_price := pivLo
    lastLL_bar   := bar_index - swingSize

// ─────────────────────────────────────────────────────────────────────────────
// TRENDLINE STORAGE — CURRENT TF
// ─────────────────────────────────────────────────────────────────────────────
var line[]  tl_obj     = array.new_line()
var int[]   tl_x1      = array.new_int()
var float[] tl_y1      = array.new_float()
var int[]   tl_x2      = array.new_int()
var float[] tl_y2      = array.new_float()
var int[]   tl_touches = array.new_int()
var bool[]  tl_isDown  = array.new_bool()
var bool[]  tl_broken  = array.new_bool()

// ─────────────────────────────────────────────────────────────────────────────
// CREATE TRENDLINES — CURRENT TF
// ─────────────────────────────────────────────────────────────────────────────
if showTrendLines
    if lh and not na(lastHH_bar)
        int   x1 = lastHH_bar
        float y1 = lastHH_price
        int   x2 = bar_index - swingSize
        float y2 = pivHi
        if x2 > x1
            int anchorCount = 0
            int oldestIdx   = -1
            int oldestX2    = int(na)
            int sz          = array.size(tl_obj)
            if sz > 0
                for i = 0 to sz - 1
                    if array.get(tl_x1, i) == x1 and not array.get(tl_broken, i)
                        anchorCount += 1
                        int tx2 = array.get(tl_x2, i)
                        if na(oldestX2) or tx2 < oldestX2
                            oldestX2  := tx2
                            oldestIdx := i
            if anchorCount >= maxLinesPerAnchor and oldestIdx >= 0
                line.delete(array.get(tl_obj, oldestIdx))
                array.set(tl_broken, oldestIdx, true)
            l = line.new(x1, y1, x2, y2,
                 extend = extend.right, color = trendColorDown,
                 style  = getStyle(trendStyleIn), width = trendWidthIn)
            array.push(tl_obj,     l)
            array.push(tl_x1,      x1)
            array.push(tl_y1,      y1)
            array.push(tl_x2,      x2)
            array.push(tl_y2,      y2)
            array.push(tl_touches, 0)
            array.push(tl_isDown,  true)
            array.push(tl_broken,  false)

    if hl and not na(lastLL_bar)
        int   x1 = lastLL_bar
        float y1 = lastLL_price
        int   x2 = bar_index - swingSize
        float y2 = pivLo
        if x2 > x1
            int anchorCount = 0
            int oldestIdx   = -1
            int oldestX2    = int(na)
            int sz          = array.size(tl_obj)
            if sz > 0
                for i = 0 to sz - 1
                    if array.get(tl_x1, i) == x1 and not array.get(tl_broken, i)
                        anchorCount += 1
                        int tx2 = array.get(tl_x2, i)
                        if na(oldestX2) or tx2 < oldestX2
                            oldestX2  := tx2
                            oldestIdx := i
            if anchorCount >= maxLinesPerAnchor and oldestIdx >= 0
                line.delete(array.get(tl_obj, oldestIdx))
                array.set(tl_broken, oldestIdx, true)
            l = line.new(x1, y1, x2, y2,
                 extend = extend.right, color = trendColorUp,
                 style  = getStyle(trendStyleIn), width = trendWidthIn)
            array.push(tl_obj,     l)
            array.push(tl_x1,      x1)
            array.push(tl_y1,      y1)
            array.push(tl_x2,      x2)
            array.push(tl_y2,      y2)
            array.push(tl_touches, 0)
            array.push(tl_isDown,  false)
            array.push(tl_broken,  false)

// ─────────────────────────────────────────────────────────────────────────────
// SYNC TRENDLINE APPEARANCE — CURRENT TF
// FIX: Re-apply color/style/width every bar so input changes take effect
// immediately on all existing (unbroken) lines.
// ─────────────────────────────────────────────────────────────────────────────
int tlSyncCount = array.size(tl_obj)
if tlSyncCount > 0
    for i = 0 to tlSyncCount - 1
        if not array.get(tl_broken, i)
            l    = array.get(tl_obj, i)
            bool dn = array.get(tl_isDown, i)
            line.set_color(l, dn ? trendColorDown : trendColorUp)
            line.set_style(l, getStyle(trendStyleIn))
            line.set_width(l, trendWidthIn)

// ─────────────────────────────────────────────────────────────────────────────
// UPDATE TRENDLINES — CURRENT TF
// ─────────────────────────────────────────────────────────────────────────────
int tlCount = array.size(tl_obj)
if tlCount > 0
    for i = 0 to tlCount - 1
        if not array.get(tl_broken, i)
            int   x1 = array.get(tl_x1, i)
            float y1 = array.get(tl_y1, i)
            int   x2 = array.get(tl_x2, i)
            float y2 = array.get(tl_y2, i)
            bool  dn = array.get(tl_isDown, i)
            if bar_index > x2
                float lv  = lineY(x1, y1, x2, y2, bar_index)
                float pct = bodyPctAcross(lv, dn)
                if dn
                    if pct >= breakPct
                        l = array.get(tl_obj, i)
                        line.set_extend(l, extend.none)
                        line.set_x2(l, bar_index)
                        line.set_y2(l, lv)
                        array.set(tl_broken, i, true)
                        if array.get(tl_touches, i) < minWickTouches
                            line.delete(l)
                        if showBreakTriangles
                            _yUp = triYPos(triAnchor, lv, true, triOffsetMode, triOffset)
                            label.new(bar_index, _yUp, style = label.style_triangleup,
                                 color = triUpColor, size = getTriSize(triSize))
                    else if high >= lv
                        array.set(tl_touches, i, array.get(tl_touches, i) + 1)
                else
                    if pct >= breakPct
                        l = array.get(tl_obj, i)
                        line.set_extend(l, extend.none)
                        line.set_x2(l, bar_index)
                        line.set_y2(l, lv)
                        array.set(tl_broken, i, true)
                        if array.get(tl_touches, i) < minWickTouches
                            line.delete(l)
                        if showBreakTriangles
                            _yDn = triYPos(triAnchorDn, lv, false, triOffsetMode, triOffset)
                            label.new(bar_index, _yDn, style = label.style_triangledown,
                                 color = triDnColor, size = getTriSize(triSize))
                    else if low <= lv
                        array.set(tl_touches, i, array.get(tl_touches, i) + 1)

// ─────────────────────────────────────────────────────────────────────────────
// HTF DATA
// ─────────────────────────────────────────────────────────────────────────────
htfPivHi     = request.security(syminfo.tickerid, htfTimeframe,
                 ta.pivothigh(high, htfSwingSize, htfSwingSize),
                 lookahead = barmerge.lookahead_off)
htfPivLo     = request.security(syminfo.tickerid, htfTimeframe,
                 ta.pivotlow(low,  htfSwingSize, htfSwingSize),
                 lookahead = barmerge.lookahead_off)
htfPivHiBarTime = request.security(syminfo.tickerid, htfTimeframe,
                 not na(ta.pivothigh(high, htfSwingSize, htfSwingSize)) ? time[htfSwingSize] : na,
                 lookahead = barmerge.lookahead_off)
htfPivLoBarTime = request.security(syminfo.tickerid, htfTimeframe,
                 not na(ta.pivotlow(low,  htfSwingSize, htfSwingSize)) ? time[htfSwingSize] : na,
                 lookahead = barmerge.lookahead_off)

bool htfNewHi = not na(htfPivHiBarTime) and (na(htfPivHiBarTime[1]) or htfPivHiBarTime != htfPivHiBarTime[1])
bool htfNewLo = not na(htfPivLoBarTime) and (na(htfPivLoBarTime[1]) or htfPivLoBarTime != htfPivLoBarTime[1])

// ─────────────────────────────────────────────────────────────────────────────
// HTF SWING CLASSIFICATION
// ─────────────────────────────────────────────────────────────────────────────
var float htfPrevHigh    = na
var float htfPrevLow     = na
var int   htfPrevHiTime  = na
var int   htfPrevLoTime  = na

bool htfHH = false
bool htfLH = false
bool htfHL = false
bool htfLL = false

var float htfLastHH_price = na
var int   htfLastHH_time  = na
var float htfLastLL_price = na
var int   htfLastLL_time  = na

if htfNewHi
    if not na(htfPrevHigh)
        if htfPivHi >= htfPrevHigh
            htfHH := true
        else
            htfLH := true
    htfPrevHigh   := htfPivHi
    htfPrevHiTime := htfPivHiBarTime

if htfHH
    htfLastHH_price := htfPivHi
    htfLastHH_time  := htfPivHiBarTime

if htfNewLo
    if not na(htfPrevLow)
        if htfPivLo >= htfPrevLow
            htfHL := true
        else
            htfLL := true
    htfPrevLow    := htfPivLo
    htfPrevLoTime := htfPivLoBarTime

if htfLL
    htfLastLL_price := htfPivLo
    htfLastLL_time  := htfPivLoBarTime

// ─────────────────────────────────────────────────────────────────────────────
// TRENDLINE STORAGE — HTF
// ─────────────────────────────────────────────────────────────────────────────
var line[]  htf_obj     = array.new_line()
var int[]   htf_t1      = array.new_int()
var float[] htf_y1      = array.new_float()
var int[]   htf_t2      = array.new_int()
var float[] htf_y2      = array.new_float()
var int[]   htf_touches = array.new_int()
var bool[]  htf_isDown  = array.new_bool()
var bool[]  htf_broken  = array.new_bool()

// ─────────────────────────────────────────────────────────────────────────────
// CREATE TRENDLINES — HTF
// ─────────────────────────────────────────────────────────────────────────────
if htfEnabled
    if htfLH and not na(htfLastHH_time)
        int   t1 = htfLastHH_time
        float y1 = htfLastHH_price
        int   t2 = htfPivHiBarTime
        float y2 = htfPivHi
        if t2 > t1
            int anchorCount = 0
            int oldestIdx   = -1
            int oldestT2    = int(na)
            int sz          = array.size(htf_obj)
            if sz > 0
                for i = 0 to sz - 1
                    if array.get(htf_t1, i) == t1 and not array.get(htf_broken, i)
                        anchorCount += 1
                        int tt2 = array.get(htf_t2, i)
                        if na(oldestT2) or tt2 < oldestT2
                            oldestT2  := tt2
                            oldestIdx := i
            if anchorCount >= htfMaxLines and oldestIdx >= 0
                line.delete(array.get(htf_obj, oldestIdx))
                array.set(htf_broken, oldestIdx, true)
            l = line.new(t1, y1, t2, y2,
                 xloc   = xloc.bar_time,
                 extend = extend.right,
                 color  = htfColorDown,
                 style  = getStyle(htfStyleIn),
                 width  = htfWidthIn)
            array.push(htf_obj,     l)
            array.push(htf_t1,      t1)
            array.push(htf_y1,      y1)
            array.push(htf_t2,      t2)
            array.push(htf_y2,      y2)
            array.push(htf_touches, 0)
            array.push(htf_isDown,  true)
            array.push(htf_broken,  false)

    if htfHL and not na(htfLastLL_time)
        int   t1 = htfLastLL_time
        float y1 = htfLastLL_price
        int   t2 = htfPivLoBarTime
        float y2 = htfPivLo
        if t2 > t1
            int anchorCount = 0
            int oldestIdx   = -1
            int oldestT2    = int(na)
            int sz          = array.size(htf_obj)
            if sz > 0
                for i = 0 to sz - 1
                    if array.get(htf_t1, i) == t1 and not array.get(htf_broken, i)
                        anchorCount += 1
                        int tt2 = array.get(htf_t2, i)
                        if na(oldestT2) or tt2 < oldestT2
                            oldestT2  := tt2
                            oldestIdx := i
            if anchorCount >= htfMaxLines and oldestIdx >= 0
                line.delete(array.get(htf_obj, oldestIdx))
                array.set(htf_broken, oldestIdx, true)
            l = line.new(t1, y1, t2, y2,
                 xloc   = xloc.bar_time,
                 extend = extend.right,
                 color  = htfColorUp,
                 style  = getStyle(htfStyleIn),
                 width  = htfWidthIn)
            array.push(htf_obj,     l)
            array.push(htf_t1,      t1)
            array.push(htf_y1,      y1)
            array.push(htf_t2,      t2)
            array.push(htf_y2,      y2)
            array.push(htf_touches, 0)
            array.push(htf_isDown,  false)
            array.push(htf_broken,  false)

// ─────────────────────────────────────────────────────────────────────────────
// SYNC TRENDLINE APPEARANCE — HTF
// FIX: Re-apply color/style/width every bar so input changes take effect
// immediately on all existing (unbroken) HTF lines.
// ─────────────────────────────────────────────────────────────────────────────
int htfSyncCount = array.size(htf_obj)
if htfEnabled and htfSyncCount > 0
    for i = 0 to htfSyncCount - 1
        if not array.get(htf_broken, i)
            l    = array.get(htf_obj, i)
            bool dn = array.get(htf_isDown, i)
            line.set_color(l, dn ? htfColorDown : htfColorUp)
            line.set_style(l, getStyle(htfStyleIn))
            line.set_width(l, htfWidthIn)

// ─────────────────────────────────────────────────────────────────────────────
// UPDATE TRENDLINES — HTF
// ─────────────────────────────────────────────────────────────────────────────
int htfCount = array.size(htf_obj)
if htfEnabled and htfCount > 0
    for i = 0 to htfCount - 1
        if not array.get(htf_broken, i)
            int   t1 = array.get(htf_t1, i)
            float y1 = array.get(htf_y1, i)
            int   t2 = array.get(htf_t2, i)
            float y2 = array.get(htf_y2, i)
            bool  dn = array.get(htf_isDown, i)
            if time > t2
                float lv  = lineYTime(t1, y1, t2, y2, time)
                float pct = bodyPctAcross(lv, dn)
                if dn
                    if pct >= htfBreakPct
                        l = array.get(htf_obj, i)
                        line.set_extend(l, extend.none)
                        line.set_x2(l, time)
                        line.set_y2(l, lv)
                        array.set(htf_broken, i, true)
                        if array.get(htf_touches, i) < htfMinTouches
                            line.delete(l)
                        if showHtfTriangles
                            _yHtfUp = triYPos(htfTriAnchor, lv, true, htfTriOffsetMode, htfTriOffset)
                            label.new(bar_index, _yHtfUp, style = label.style_triangleup,
                                 color = htfTriUpColor, size = getTriSize(htfTriSize))
                    else if high >= lv
                        array.set(htf_touches, i, array.get(htf_touches, i) + 1)
                else
                    if pct >= htfBreakPct
                        l = array.get(htf_obj, i)
                        line.set_extend(l, extend.none)
                        line.set_x2(l, time)
                        line.set_y2(l, lv)
                        array.set(htf_broken, i, true)
                        if array.get(htf_touches, i) < htfMinTouches
                            line.delete(l)
                        if showHtfTriangles
                            _yHtfDn = triYPos(htfTriAnchorDn, lv, false, htfTriOffsetMode, htfTriOffset)
                            label.new(bar_index, _yHtfDn, style = label.style_triangledown,
                                 color = htfTriDnColor, size = getTriSize(htfTriSize))
                    else if low <= lv
                        array.set(htf_touches, i, array.get(htf_touches, i) + 1)

// ─────────────────────────────────────────────────────────────────────────────
// SWING LABELS
// ─────────────────────────────────────────────────────────────────────────────
color CLEAR = color.new(color.black, 100)

if hh and showSwingLabels
    label.new(bar_index - swingSize, pivHi, 'HH',
         color = CLEAR, style = label.style_label_down, textcolor = labelColorHigh)
    if prevSwing[1] == -1 and showHalfRetrace and not na(prevLow)
        line.new(prevLowIndex, (prevLow + pivHi) / 2,
             bar_index - swingSize, (prevLow + pivHi) / 2,
             color = halfColor, style = getStyle(halfStyleIn), width = halfWidth)

if lh and showSwingLabels
    label.new(bar_index - swingSize, pivHi, 'LH',
         color = CLEAR, style = label.style_label_down, textcolor = labelColorHigh)

if hl and showSwingLabels
    label.new(bar_index - swingSize, pivLo, 'HL',
         color = CLEAR, style = label.style_label_up, textcolor = labelColorLow)

if ll and showSwingLabels
    label.new(bar_index - swingSize, pivLo, 'LL',
         color = CLEAR, style = label.style_label_up, textcolor = labelColorLow)
    if prevSwing[1] == 1 and showHalfRetrace and not na(prevHigh)
        line.new(prevHighIndex, (prevHigh + pivLo) / 2,
             bar_index - swingSize, (prevHigh + pivLo) / 2,
             color = halfColor, style = getStyle(halfStyleIn), width = halfWidth)

// ─────────────────────────────────────────────────────────────────────────────
// PIVOT CIRCLES
// ─────────────────────────────────────────────────────────────────────────────
plot(pivHi, 'Pivot High', color = color.new(color.red,   80),
     style = plot.style_circles, linewidth = 2, offset = -swingSize)
plot(pivLo, 'Pivot Low',  color = color.new(color.green, 80),
     style = plot.style_circles, linewidth = 2, offset = -swingSize)
