//@version=6
indicator(title="Alpha Trend Master Pro (Excellent TP5)", overlay=true)

//━━━━━━━━━━━━━━━━━━━
// INPUTS
src = close
keyvalue = input.float(50.0, title="Sensitivity", step=0.5)
atrperiod = input.int(5, title="ATR Period")

// SL & TP Percentage (5% SL, 15-55% TP)
sl_perc  = 5.0  / 100
tp1_p = 0.15, tp2_p = 0.25, tp3_p = 0.35, tp4_p = 0.45, tp5_p = 0.55

// MA Filter
maValue = ta.ema(src, 1000)
plot(maValue, color=color.new(color.yellow, 50), linewidth=2, title="Trend MA")

//━━━━━━━━━━━━━━━━━━━
// LOGIC
xATR = ta.atr(atrperiod)
nLoss = keyvalue * xATR
var float xATRTrailingStop = 0.0
xATRTrailingStop := (src > nz(xATRTrailingStop[1]) and src[1] > nz(xATRTrailingStop[1])) ? math.max(nz(xATRTrailingStop[1]), src - nLoss) : (src < nz(xATRTrailingStop[1]) and src[1] < nz(xATRTrailingStop[1])) ? math.min(nz(xATRTrailingStop[1]), src + nLoss) : (src > nz(xATRTrailingStop[1]) ? src - nLoss : src + nLoss)

buyFinal  = ta.crossover(src, xATRTrailingStop) and src > maValue and barstate.isconfirmed
sellFinal = ta.crossunder(src, xATRTrailingStop) and src < maValue and barstate.isconfirmed

//━━━━━━━━━━━━━━━━━━━
// TARGET TRACKING VARS
var float c_tp1 = 0.0, var float c_tp2 = 0.0, var float c_tp3 = 0.0, var float c_tp4 = 0.0, var float c_tp5 = 0.0
var float c_sl = 0.0
var bool h1 = false, var bool h2 = false, var bool h3 = false, var bool h4 = false, var bool h5 = false
var int trade_dir = 0 

if buyFinal
    c_ep = close
    c_sl := c_ep * (1 - sl_perc)
    c_tp1 := c_ep * (1 + tp1_p), c_tp2 := c_ep * (1 + tp2_p), c_tp3 := c_ep * (1 + tp3_p), c_tp4 := c_ep * (1 + tp4_p), c_tp5 := c_ep * (1 + tp5_p)
    h1 := false, h2 := false, h3 := false, h4 := false, h5 := false
    trade_dir := 1
    
    txt = "🟢 BUY | Entry: " + str.tostring(c_ep, format.mintick) + "\n🛑 SL (5%): " + str.tostring(c_sl, format.mintick) + "\n🎯 T1:" + str.tostring(c_tp1, format.mintick) + " | T2:" + str.tostring(c_tp2, format.mintick) + "\n🎯 T3:" + str.tostring(c_tp3, format.mintick) + " | T4:" + str.tostring(c_tp4, format.mintick) + "\n🎯 T5:" + str.tostring(c_tp5, format.mintick)
    label.new(bar_index, low, txt, style=label.style_label_up, color=color.new(color.green, 15), textcolor=color.white, size=size.large)

if sellFinal
    c_ep = close
    c_sl := c_ep * (1 + sl_perc)
    c_tp1 := c_ep * (1 - tp1_p), c_tp2 := c_ep * (1 - tp2_p), c_tp3 := c_ep * (1 - tp3_p), c_tp4 := c_ep * (1 - tp4_p), c_tp5 := c_ep * (1 - tp5_p)
    h1 := false, h2 := false, h3 := false, h4 := false, h5 := false
    trade_dir := -1

    txt = "🔴 SELL | Entry: " + str.tostring(c_ep, format.mintick) + "\n🛑 SL (5%): " + str.tostring(c_sl, format.mintick) + "\n🎯 T1:" + str.tostring(c_tp1, format.mintick) + " | T2:" + str.tostring(c_tp2, format.mintick) + "\n🎯 T3:" + str.tostring(c_tp3, format.mintick) + " | T4:" + str.tostring(c_tp4, format.mintick) + "\n🎯 T5:" + str.tostring(c_tp5, format.mintick)
    label.new(bar_index, high, txt, style=label.style_label_down, color=color.new(color.red, 15), textcolor=color.white, size=size.large)

//━━━━━━━━━━━━━━━━━━━
// HIT DETECTION (Large Labels)
if trade_dir == 1 // Buy
    if high >= c_tp1 and not h1
        label.new(bar_index, high, "TP1 ✅", style=label.style_none, textcolor=color.lime, size=size.large), h1 := true
    if high >= c_tp2 and not h2
        label.new(bar_index, high, "TP2 ✅", style=label.style_none, textcolor=color.lime, size=size.large), h2 := true
    if high >= c_tp3 and not h3
        label.new(bar_index, high, "TP3 ✅", style=label.style_none, textcolor=color.lime, size=size.large), h3 := true
    if high >= c_tp4 and not h4
        label.new(bar_index, high, "TP4 ✅", style=label.style_none, textcolor=color.lime, size=size.large), h4 := true
    if high >= c_tp5 and not h5
        label.new(bar_index, high, "🔥 !!TP5 HIT - EXCELLENT!! 🔥", style=label.style_none, textcolor=color.yellow, size=size.huge), h5 := true

if trade_dir == -1 // Sell
    if low <= c_tp1 and not h1
        label.new(bar_index, low, "TP1 ✅", style=label.style_none, textcolor=color.orange, size=size.large), h1 := true
    if low <= c_tp2 and not h2
        label.new(bar_index, low, "TP2 ✅", style=label.style_none, textcolor=color.orange, size=size.large), h2 := true
    if low <= c_tp3 and not h3
        label.new(bar_index, low, "TP3 ✅", style=label.style_none, textcolor=color.orange, size=size.large), h3 := true
    if low <= c_tp4 and not h4
        label.new(bar_index, low, "TP4 ✅", style=label.style_none, textcolor=color.orange, size=size.large), h4 := true
    if low <= c_tp5 and not h5
        label.new(bar_index, low, "🔥 !!TP5 HIT - EXCELLENT!! 🔥", style=label.style_none, textcolor=color.yellow, size=size.huge), h5 := true

barcolor(src > xATRTrailingStop ? color.green : color.red)
