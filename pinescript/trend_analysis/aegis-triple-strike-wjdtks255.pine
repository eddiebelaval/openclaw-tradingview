//@version=5
indicator("Aegis Triple Strike [wjdtks255]", overlay = true, max_lines_count = 100)

// [1] 고성능 모멘텀 엔진
lenSmooth = 8, lenFast = 20, lenSlow = 50
glide     = ta.ema(close, lenSmooth)
fast      = ta.ema(glide, lenFast)
slow      = ta.ema(glide, lenSlow)
osc       = fast - slow
sig       = ta.sma(osc, lenSmooth)

longSignal  = ta.crossover(osc, sig)
shortSignal = ta.crossunder(osc, sig)

// [2] 오류 없는 개별 변수 구조체 (쉼표 오류 해결)
type TargetSystem
    line enLine
    line slLine
    line tp1Line
    line tp2Line
    line tp3Line
    label enLbl
    label slLbl
    label tp1Lbl
    label tp2Lbl
    label tp3Lbl

var TargetSystem ts = TargetSystem.new(na, na, na, na, na, na, na, na, na, na)

// [3] ATR 기반 정밀 타겟 계산 및 생성
if (longSignal or shortSignal)
    // 이전 객체 완전 삭제 (메모리 최적화)
    line.delete(ts.enLine), line.delete(ts.slLine)
    line.delete(ts.tp1Line), line.delete(ts.tp2Line), line.delete(ts.tp3Line)
    label.delete(ts.enLbl), label.delete(ts.slLbl)
    label.delete(ts.tp1Lbl), label.delete(ts.tp2Lbl), label.delete(ts.tp3Lbl)
    
    float dir = longSignal ? 1 : -1
    float atr = ta.atr(14)
    int   ext = 55 // 우측 패널 위치

    // 수학적 타겟 계산 (ATR 배수 활용)
    float pEN  = close
    float pSL  = close - dir * (atr * 2.0)
    float pTP1 = close + dir * (atr * 2.0)
    float pTP2 = close + dir * (atr * 4.0)
    float pTP3 = close + dir * (atr * 6.0)

    // 라인 생성 (가독성 스타일 적용)
    ts.enLine  := line.new(bar_index, pEN, bar_index + ext, pEN, color=color.new(color.gray, 20), width=2)
    ts.slLine  := line.new(bar_index, pSL, bar_index + ext, pSL, color=color.new(color.red, 20), width=2)
    ts.tp1Line := line.new(bar_index, pTP1, bar_index + ext, pTP1, color=color.new(color.teal, 30), width=1, style=line.style_dashed)
    ts.tp2Line := line.new(bar_index, pTP2, bar_index + ext, pTP2, color=color.new(color.teal, 30), width=1, style=line.style_dashed)
    ts.tp3Line := line.new(bar_index, pTP3, bar_index + ext, pTP3, color=color.new(color.teal, 30), width=2)

    // 패널 생성 (요청하신 1.5배 size.normal 및 가격 명시)
    ts.enLbl  := label.new(bar_index + ext, pEN, "ENTRY: " + str.tostring(pEN, "#.#"), style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.normal)
    ts.slLbl  := label.new(bar_index + ext, pSL, "STOP: " + str.tostring(pSL, "#.#"), style=label.style_label_left, color=color.red, textcolor=color.white, size=size.normal)
    ts.tp1Lbl := label.new(bar_index + ext, pTP1, "TP1: " + str.tostring(pTP1, "#.#"), style=label.style_label_left, color=color.teal, textcolor=color.white, size=size.normal)
    ts.tp2Lbl := label.new(bar_index + ext, pTP2, "TP2: " + str.tostring(pTP2, "#.#"), style=label.style_label_left, color=color.teal, textcolor=color.white, size=size.normal)
    ts.tp3Lbl := label.new(bar_index + ext, pTP3, "TP3: " + str.tostring(pTP3, "#.#"), style=label.style_label_left, color=color.teal, textcolor=color.white, size=size.normal)

// [4] 실시간 추격 (캔들이 움직여도 우측 패널 고정)
if not na(ts.enLine)
    newX = bar_index + 55
    line.set_x2(ts.enLine, newX), line.set_x2(ts.slLine, newX)
    line.set_x2(ts.tp1Line, newX), line.set_x2(ts.tp2Line, newX), line.set_x2(ts.tp3Line, newX)
    label.set_x(ts.enLbl, newX), label.set_x(ts.slLbl, newX)
    label.set_x(ts.tp1Lbl, newX), label.set_x(ts.tp2Lbl, newX), label.set_x(ts.tp3Lbl, newX)

// 시그널 플롯
plotshape(longSignal, "LONG", shape.triangleup, location.belowbar, color.teal, size=size.small)
plotshape(shortSignal, "SHORT", shape.triangledown, location.abovebar, color.orange, size=size.small)
