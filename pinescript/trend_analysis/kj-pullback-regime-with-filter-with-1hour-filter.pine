//@version=6
indicator("KJ Pullback Regime with Filter", overlay=true)

// =====================================================
// ===================== INPUTS =========================
// =====================================================

// ----- Structure -----
pacLen = input.int(34, "PAC Length")
emaLen = input.int(100, "EMA Length")

// ----- Regime Filter -----
atrLen        = input.int(14, "ATR Length")
slopeLookback = input.int(12, "PAC slope lookback")
flatAtrFrac   = input.float(0.10, "Flat PAC threshold (ATR frac)", step=0.01)
minSpaceFrac  = input.float(0.15, "Min EMA–PAC spacing (ATR frac)", step=0.01)
minBarsAway   = input.int(6, "Min bars price must stay away from EMA")

// ----- Higher Timeframe Filter -----
useHTF = input.bool(false, "Use Higher Timeframe Filter")

htfOption = input.string(
     "1H",
     "HTF Timeframe",
     options = ["4H", "1H", "15m", "5m"]
)

// Convert dropdown to timeframe string
htfTF = switch htfOption
    "4H"  => "240"
    "1H"  => "60"
    "15m" => "15"
    "5m"  => "5"

// =====================================================
// ================= CORE INDICATORS ===================
// =====================================================

ema100   = ta.ema(close, emaLen)
pacUpper = ta.ema(high, pacLen)
pacLower = ta.ema(low, pacLen)
pacMid   = ta.ema(close, pacLen)
atr      = ta.atr(atrLen)

// =====================================================
// ================= HTF INDICATORS ====================
// =====================================================

htfPacMid = request.security(
     syminfo.tickerid,
     htfTF,
     ta.ema(close, pacLen),
     barmerge.gaps_off,
     barmerge.lookahead_off)

htfEma100 = request.security(
     syminfo.tickerid,
     htfTF,
     ta.ema(close, emaLen),
     barmerge.gaps_off,
     barmerge.lookahead_off)

// =====================================================
// ================= REGIME FILTER =====================
// =====================================================

// 1️⃣ Flat PAC (raw)
pacSlope   = math.abs(pacMid - pacMid[slopeLookback])
pacFlatRaw = pacSlope < atr * flatAtrFrac

// 2️⃣ EMA–PAC congestion
emaPacDist = math.abs(ema100 - pacMid)
noSpace    = emaPacDist < atr * minSpaceFrac

// 3️⃣ EMA rotation / chop
barsSinceCross = ta.barssince(ta.cross(close, ema100))
tooMuchChop    = barsSinceCross < minBarsAway

// 4️⃣ Flat is only bad if rotating
flatBad = pacFlatRaw and tooMuchChop

// FINAL NO-TRADE FLAG
noTrade = flatBad or noSpace or tooMuchChop

// Background visualization
bgcolor(noTrade ? color.new(color.red, 85) : na)

// =====================================================
// ================= TREND LOGIC =======================
// =====================================================

longTrend  = pacMid > ema100
shortTrend = pacMid < ema100

// =====================================================
// ================= STATE VARIABLES ===================
// =====================================================

var bool wasOutLong         = false
var bool validPullbackLong  = false
var bool wasOutShort        = false
var bool validPullbackShort = false

// =====================================================
// ===================== LONG ===========================
// =====================================================

// 1️⃣ Price must be fully above PAC
if longTrend and close > pacUpper
    wasOutLong := true

// 2️⃣ Price must CLOSE inside PAC and cross mid
if wasOutLong and close < pacUpper and close > pacLower and close <= pacMid
    validPullbackLong := true

// 3️⃣ Signal only when price exits PAC upward
longSignal = longTrend and wasOutLong and validPullbackLong and close > pacUpper

// Reset after signal
if longSignal
    wasOutLong := false
    validPullbackLong := false

// Reset if trend flips
if not longTrend
    wasOutLong := false
    validPullbackLong := false

// =====================================================
// ===================== SHORT ==========================
// =====================================================

// 1️⃣ Price must be fully below PAC
if shortTrend and close < pacLower
    wasOutShort := true

// 2️⃣ Price must CLOSE inside PAC and cross mid
if wasOutShort and close > pacLower and close < pacUpper and close >= pacMid
    validPullbackShort := true

// 3️⃣ Signal only when price exits PAC downward
shortSignal = shortTrend and wasOutShort and validPullbackShort and close < pacLower

// Reset after signal
if shortSignal
    wasOutShort := false
    validPullbackShort := false

// Reset if trend flips
if not shortTrend
    wasOutShort := false
    validPullbackShort := false

// =====================================================
// ================= FINAL GATING ======================
// =====================================================

longHTFpass  = not useHTF or (htfPacMid > htfEma100)
shortHTFpass = not useHTF or (htfPacMid < htfEma100)

finalLong  = longSignal  and not noTrade and longHTFpass
finalShort = shortSignal and not noTrade and shortHTFpass

// =====================================================
// ===================== PLOTS =========================
// =====================================================

plot(ema100,   color=color.orange, linewidth=2)
plot(pacUpper, color=color.gray)
plot(pacMid,   color=color.gray)
plot(pacLower, color=color.gray)

plotshape(finalLong,  style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.small)
plotshape(finalShort, style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.small)
