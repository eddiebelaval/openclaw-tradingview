//@version=5
indicator("KG's Gann Pro ⚡", overlay=true, max_lines_count=500, max_labels_count=60, max_boxes_count=30)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────
lookback = input.int(200,   "Lookback (bars)",        minval=50,  maxval=1000, group="Settings")
zoneW    = input.float(0.8, "Zone Width %",           minval=0.1, maxval=5.0,  group="Settings")
extR     = input.int(60,    "Extend Right (bars)",    minval=5,   maxval=300,  group="Settings")
vEvery   = input.int(30,    "Vertical Line Spacing",  minval=5,   maxval=200,  group="Settings")

cSell   = input.color(color.new(#FF1744, 60), "Sell Zone",    group="Colors")
cBuy    = input.color(color.new(#00C853, 60), "Buy Zone",     group="Colors")
cPivot  = input.color(color.new(#546E7A, 65), "Pivot Zone",   group="Colors")
cOrange = input.color(#FF9800,                "Orange Lines", group="Colors")
cGannU  = input.color(color.new(#76FF03, 60), "Gann Up",      group="Colors")
cGannD  = input.color(color.new(#C6FF00, 60), "Gann Down",    group="Colors")
cVline  = input.color(color.new(#00BCD4, 75), "Vert Lines",   group="Colors")

// ─────────────────────────────────────────────────────────────────────────────
// SERIES — at top level 
// ─────────────────────────────────────────────────────────────────────────────
hh          = ta.highest(high, lookback)
ll          = ta.lowest(low,  lookback)
hhBarsBack  = ta.highestbars(high, lookback)   // how many bars back is HH
llBarsBack  = ta.lowestbars(low,  lookback)    // how many bars back is LL

// ─────────────────────────────────────────────────────────────────────────────
// PERSISTENT ARRAYS
// ─────────────────────────────────────────────────────────────────────────────
var line[]  aGannU = array.new_line()
var line[]  aGannD = array.new_line()
var line[]  aOther = array.new_line()
var line[]  aVline = array.new_line()
var box[]   aZone  = array.new_box()
var label[] aLbl   = array.new_label()

// ─────────────────────────────────────────────────────────────────────────────
// DRAW ON LAST BAR ONLY
// ─────────────────────────────────────────────────────────────────────────────
if barstate.islast

    // Derived values
    float rng      = hh - ll
    float sellLvl  = ll + rng * 0.6667
    float pivotLvl = ll + rng * 0.5000
    float buyLvl   = ll + rng * 0.3333
    float zoneOff  = rng * zoneW / 100.0

    int hhBar  = bar_index + hhBarsBack   // hhBarsBack is negative
    int llBar  = bar_index + llBarsBack   // llBarsBack is negative
    int rBar   = bar_index + extR
    int lBar   = bar_index - lookback

    // ── Delete old drawings ───────────────────────────────────────────────────
    if array.size(aGannU) > 0
        for i = 0 to array.size(aGannU) - 1
            line.delete(array.get(aGannU, i))
    if array.size(aGannD) > 0
        for i = 0 to array.size(aGannD) - 1
            line.delete(array.get(aGannD, i))
    if array.size(aOther) > 0
        for i = 0 to array.size(aOther) - 1
            line.delete(array.get(aOther, i))
    if array.size(aVline) > 0
        for i = 0 to array.size(aVline) - 1
            line.delete(array.get(aVline, i))
    if array.size(aZone) > 0
        for i = 0 to array.size(aZone) - 1
            box.delete(array.get(aZone, i))
    if array.size(aLbl) > 0
        for i = 0 to array.size(aLbl) - 1
            label.delete(array.get(aLbl, i))

    array.clear(aGannU)
    array.clear(aGannD)
    array.clear(aOther)
    array.clear(aVline)
    array.clear(aZone)
    array.clear(aLbl)

    // ── 1. S/R HORIZONTAL ZONES ───────────────────────────────────────────────
    array.push(aZone, box.new(lBar, sellLvl + zoneOff, rBar, sellLvl - zoneOff, border_color=color.new(color.red, 20), bgcolor=cSell, border_width=1))
    array.push(aZone, box.new(lBar, pivotLvl + zoneOff * 0.4, rBar, pivotLvl - zoneOff * 0.4, border_color=color.new(color.gray, 20), bgcolor=cPivot, border_width=1))
    array.push(aZone, box.new(lBar, buyLvl + zoneOff, rBar, buyLvl - zoneOff, border_color=color.new(color.green, 20), bgcolor=cBuy, border_width=1))

    // HH and LL flat dotted lines
    array.push(aOther, line.new(lBar, hh, rBar, hh, color=color.new(#AEEA00, 50), style=line.style_dotted, width=1))
    array.push(aOther, line.new(lBar, ll, rBar, ll, color=color.new(#AEEA00, 50), style=line.style_dotted, width=1))

    // ── 2. ORANGE X LINES ────────────────────────────────────────────────────
    // Ascending: from LL bar at LL price, to right edge
    float slopeUp = rng / math.max(hhBar - llBar, 1)
    array.push(aOther, line.new(llBar, ll, rBar, ll + slopeUp * (rBar - llBar), color=cOrange, style=line.style_solid, width=2))
    // Descending: from HH bar at HH price, to right edge (same slope magnitude, downward)
    array.push(aOther, line.new(hhBar, hh, rBar, hh - slopeUp * (rBar - hhBar), color=cOrange, style=line.style_solid, width=2))

    // ── 3. GANN FAN UP — from Lowest Low ─────────────────────────────────────
    float spanBars = math.max(math.abs(hhBar - llBar), 1)
    float unit     = rng / spanBars

    float eb = rBar - llBar
    array.push(aGannU, line.new(llBar, ll, rBar, ll + unit * 8.000 * eb, color=cGannU, style=line.style_dashed, width=1))
    array.push(aGannU, line.new(llBar, ll, rBar, ll + unit * 4.000 * eb, color=cGannU, style=line.style_dashed, width=1))
    array.push(aGannU, line.new(llBar, ll, rBar, ll + unit * 3.000 * eb, color=cGannU, style=line.style_dashed, width=1))
    array.push(aGannU, line.new(llBar, ll, rBar, ll + unit * 2.000 * eb, color=cGannU, style=line.style_dashed, width=1))
    array.push(aGannU, line.new(llBar, ll, rBar, ll + unit * 1.000 * eb, color=cGannU, style=line.style_dashed, width=1))
    array.push(aGannU, line.new(llBar, ll, rBar, ll + unit * 0.500 * eb, color=cGannU, style=line.style_dashed, width=1))
    array.push(aGannU, line.new(llBar, ll, rBar, ll + unit * 0.333 * eb, color=cGannU, style=line.style_dashed, width=1))
    array.push(aGannU, line.new(llBar, ll, rBar, ll + unit * 0.250 * eb, color=cGannU, style=line.style_dashed, width=1))
    array.push(aGannU, line.new(llBar, ll, rBar, ll + unit * 0.125 * eb, color=cGannU, style=line.style_dashed, width=1))

    // ── 4. GANN FAN DOWN — from Highest High ──────────────────────────────────
    float ed = rBar - hhBar
    array.push(aGannD, line.new(hhBar, hh, rBar, hh - unit * 8.000 * ed, color=cGannD, style=line.style_dashed, width=1))
    array.push(aGannD, line.new(hhBar, hh, rBar, hh - unit * 4.000 * ed, color=cGannD, style=line.style_dashed, width=1))
    array.push(aGannD, line.new(hhBar, hh, rBar, hh - unit * 3.000 * ed, color=cGannD, style=line.style_dashed, width=1))
    array.push(aGannD, line.new(hhBar, hh, rBar, hh - unit * 2.000 * ed, color=cGannD, style=line.style_dashed, width=1))
    array.push(aGannD, line.new(hhBar, hh, rBar, hh - unit * 1.000 * ed, color=cGannD, style=line.style_dashed, width=1))
    array.push(aGannD, line.new(hhBar, hh, rBar, hh - unit * 0.500 * ed, color=cGannD, style=line.style_dashed, width=1))
    array.push(aGannD, line.new(hhBar, hh, rBar, hh - unit * 0.333 * ed, color=cGannD, style=line.style_dashed, width=1))
    array.push(aGannD, line.new(hhBar, hh, rBar, hh - unit * 0.250 * ed, color=cGannD, style=line.style_dashed, width=1))
    array.push(aGannD, line.new(hhBar, hh, rBar, hh - unit * 0.125 * ed, color=cGannD, style=line.style_dashed, width=1))

    // ── 5. VERTICAL DASHED LINES ──────────────────────────────────────────────
    int vc = lBar
    while vc <= rBar
        array.push(aVline, line.new(vc, ll - rng * 0.1, vc, hh + rng * 0.1, color=cVline, style=line.style_dashed, width=1))
        vc := vc + vEvery

    // ── 6. LABELS ─────────────────────────────────────────────────────────────
    int lx = bar_index + 2
    array.push(aLbl, label.new(lx, hh,      "Highest High\n"                    + str.tostring(math.round(hh,      2)), color=#1565C0, textcolor=color.white, style=label.style_label_left, size=size.small))
    array.push(aLbl, label.new(lx, sellLvl, "SELL LEVEL\nResistance\n"          + str.tostring(math.round(sellLvl, 2)), color=#C62828, textcolor=color.white, style=label.style_label_left, size=size.small))
    array.push(aLbl, label.new(lx, pivotLvl,"PIVOT\n"                           + str.tostring(math.round(pivotLvl,2)), color=#455A64, textcolor=color.white, style=label.style_label_left, size=size.small))
    array.push(aLbl, label.new(lx, buyLvl,  "BUY LEVEL\nSupport\n"              + str.tostring(math.round(buyLvl,  2)), color=#1B5E20, textcolor=color.white, style=label.style_label_left, size=size.small))
    array.push(aLbl, label.new(lx, ll,      "Lowest Low\n"                      + str.tostring(math.round(ll,      2)), color=#E65100, textcolor=color.white, style=label.style_label_left, size=size.small))
    array.push(aLbl, label.new(bar_index, close, str.tostring(math.round(close, 2)),                                     color=#263238, textcolor=color.white, style=label.style_label_left, size=size.small))
    int midBar = math.round((lBar + bar_index) / 2)
    //------------End of script---------------
