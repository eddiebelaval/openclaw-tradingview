//@version=6
indicator("Q Squeeze Momentum", shorttitle="QSM", overlay=false)

// INPUTS
groupSQ = "Squeeze"
src        = input.source(close, "Source", group=groupSQ)
bbLen      = input.int(20, "BB Length", group=groupSQ)
bbMult     = input.float(2.0, "BB Mult", group=groupSQ)
kcLen      = input.int(20, "KC Length", group=groupSQ)
kcMultLow  = input.float(1.0, "KC Low Mult", group=groupSQ)
kcMultMid  = input.float(1.5, "KC Mid Mult", group=groupSQ)
kcMultHigh = input.float(2.0, "KC High Mult", group=groupSQ)

groupMom = "Momentum"
momLen    = input.int(20, "Length", group=groupMom)
momSmooth = input.int(8, "Smoothing", group=groupMom)
normLen   = input.int(20, "Normalization", group=groupMom)
threshold = input.float(0.18, "Noise Threshold", group=groupMom)

groupTrend = "Trend"
trendLen = input.int(50, "EMA Length", group=groupTrend)

groupVis = "Visual"
showHistogram   = input.bool(true, "Histogram", group=groupVis)
showLine        = input.bool(true, "Momentum Line", group=groupVis)
showZero        = input.bool(true, "Zero Line", group=groupVis)
showTable       = input.bool(true, "Status Table", group=groupVis)
showRegimeBg    = input.bool(true, "Trend Background", group=groupVis)
showMarkers     = input.bool(true, "Signal Markers", group=groupVis)
showMarkerText  = input.bool(true, "Marker Text", group=groupVis)
showSqDots      = input.bool(true, "Squeeze Dots", group=groupVis)
showReleaseMark = input.bool(true, "Release Markers", group=groupVis)
markerOffset    = input.float(0.30, "Marker Offset", step=0.05, group=groupVis)
labelOffset     = input.float(0.75, "Label Offset", step=0.05, group=groupVis)

// SQUEEZE
bbBasis = ta.sma(src, bbLen)
bbDev   = ta.stdev(src, bbLen)
bbUpper = bbBasis + bbMult * bbDev
bbLower = bbBasis - bbMult * bbDev

kcBasis = ta.ema(src, kcLen)
kcRange = ta.ema(ta.tr, kcLen)

kcUpperLow  = kcBasis + kcMultLow * kcRange
kcLowerLow  = kcBasis - kcMultLow * kcRange
kcUpperMid  = kcBasis + kcMultMid * kcRange
kcLowerMid  = kcBasis - kcMultMid * kcRange
kcUpperHigh = kcBasis + kcMultHigh * kcRange
kcLowerHigh = kcBasis - kcMultHigh * kcRange

sqStrong = bbUpper < kcUpperLow and bbLower > kcLowerLow
sqMid    = bbUpper < kcUpperMid and bbLower > kcLowerMid
sqWeak   = bbUpper < kcUpperHigh and bbLower > kcLowerHigh

int squeezeLevel = 0
if sqStrong
    squeezeLevel := 3
else if sqMid
    squeezeLevel := 2
else if sqWeak
    squeezeLevel := 1

release = squeezeLevel == 0 and squeezeLevel[1] > 0

// MOMENTUM
hh  = ta.highest(high, momLen)
ll  = ta.lowest(low, momLen)
mid = (hh + ll) / 2.0

momRaw = src - mid
momLin = ta.linreg(momRaw, momLen, 0)
mom    = ta.ema(momLin, momSmooth)

normBase = ta.atr(normLen)
momNorm  = normBase != 0 ? mom / normBase : 0.0

momDelta   = momNorm - momNorm[1]
deltaFloor = threshold * ta.ema(math.abs(momDelta), normLen)

bullRise = momNorm >= 0 and momDelta > deltaFloor
bullFade = momNorm >= 0 and momDelta <= deltaFloor
bearFall = momNorm < 0 and momDelta < -deltaFloor
bearFade = momNorm < 0 and momDelta >= -deltaFloor

// TREND
trendEma = ta.ema(close, trendLen)
trendUp  = close >= trendEma
trendDn  = close < trendEma

// SIGNAL LOGIC
releaseUp   = release and momNorm > 0
releaseDown = release and momNorm < 0

bullAlignRaw = releaseUp and trendUp and bullRise
bearAlignRaw = releaseDown and trendDn and bearFall

// only confirmed bar signals
bullSignal = bullAlignRaw and barstate.isconfirmed
bearSignal = bearAlignRaw and barstate.isconfirmed

var int lastDir = 0
bullAlign = bullSignal and lastDir != 1
bearAlign = bearSignal and lastDir != -1

if bullAlign
    lastDir := 1
else if bearAlign
    lastDir := -1

// persistent directional bias for optional future use
var string sig = "NONE"
if bullAlign
    sig := "LONG"
else if bearAlign
    sig := "SHORT"

// MOMENTUM TEXT
string momTxt = "BEAR FADE"
if bullRise
    momTxt := "BULL PUSH"
else if bullFade
    momTxt := "BULL FADE"
else if bearFall
    momTxt := "BEAR PUSH"

// COLORS
color histColor =
     bullRise ? color.aqua :
     bullFade ? color.teal :
     bearFall ? color.orange :
     color.red

color lineColor =
     bullRise ? color.lime :
     bullFade ? color.green :
     bearFall ? color.red :
     color.maroon

color regimeBg =
     trendUp ? color.new(color.lime, 94) :
     trendDn ? color.new(color.red, 94) : na

color sqDotColor =
     squeezeLevel == 3 ? color.red :
     squeezeLevel == 2 ? color.orange :
     squeezeLevel == 1 ? color.yellow :
     color.new(color.gray, 65)

releaseColor =
     releaseUp ? color.lime :
     releaseDown ? color.red :
     color.new(color.gray, 50)

// PLOTS
plot(showZero ? 0 : na, title="Zero Line", color=color.new(color.gray, 70))

plot(showHistogram ? momNorm : na,
     title="Momentum Histogram",
     style=plot.style_columns,
     color=color.new(histColor, 15),
     linewidth=2)

plot(showLine ? momNorm : na,
     title="Momentum Line",
     color=lineColor,
     linewidth=3)

plot(showSqDots ? 0 : na,
     title="Squeeze Dots",
     style=plot.style_circles,
     color=sqDotColor,
     linewidth=2)

bgcolor(showRegimeBg ? regimeBg : na)

// RELEASE MARKERS
plotshape(showReleaseMark and release ? 0 : na,
     title="Release Marker",
     style=shape.diamond,
     location=location.absolute,
     color=releaseColor,
     size=size.tiny)

// SIGNAL MARKERS - triangles
plotshape(showMarkers and bullAlign ? momNorm + markerOffset : na,
     title="LONG Marker",
     style=shape.triangleup,
     location=location.absolute,
     color=color.lime,
     size=size.tiny)

plotshape(showMarkers and bearAlign ? momNorm - markerOffset : na,
     title="SHORT Marker",
     style=shape.triangledown,
     location=location.absolute,
     color=color.red,
     size=size.tiny)

// SIGNAL MARKERS - text
plotshape(showMarkerText and bullAlign ? momNorm + labelOffset : na,
     title="LONG Text",
     style=shape.labeldown,
     location=location.absolute,
     color=color.new(color.lime, 85),
     text="LONG",
     textcolor=color.white,
     size=size.tiny)

plotshape(showMarkerText and bearAlign ? momNorm - labelOffset : na,
     title="SHORT Text",
     style=shape.labelup,
     location=location.absolute,
     color=color.new(color.red, 85),
     text="SHORT",
     textcolor=color.white,
     size=size.tiny)

// TABLE
var table t = table.new(position.top_right, 2, 3, border_width=1, force_overlay=true)

if barstate.islast
    if showTable
        table.cell(t, 0, 0, "", text_color=color.white)
        table.cell(t, 1, 0, "", text_color=color.white)

        table.cell(t, 0, 1, "MOMENTUM", text_color=color.white)
        table.cell(t, 1, 1, momTxt, text_color=color.white, bgcolor=lineColor)

        table.cell(t, 0, 2, "TREND", text_color=color.white)
        table.cell(t, 1, 2, trendUp ? "UP" : "DOWN",
            text_color=color.white,
            bgcolor=trendUp ? color.new(color.green, 20) : color.new(color.red, 20))
    else
        table.clear(t, 0, 0, 1, 2)

// ALERTS
trendFlipUp   = trendUp and not trendUp[1] and barstate.isconfirmed
trendFlipDown = trendDn and not trendDn[1] and barstate.isconfirmed


alertcondition(bullAlign, title="QSM LONG", message="Q Squeeze Momentum: LONG signal")
alertcondition(bearAlign, title="QSM SHORT", message="Q Squeeze Momentum: SHORT signal")
alertcondition(release and barstate.isconfirmed, title="QSM Release", message="Q Squeeze Momentum: Squeeze released")
