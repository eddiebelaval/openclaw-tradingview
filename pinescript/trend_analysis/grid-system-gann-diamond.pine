//@version=5
indicator("Grid System + Gann Diamond - Groups Managed", overlay = true, max_lines_count = 500, max_bars_back = 2000)

// ────────────────────────────────────────
// INPUTS
// ────────────────────────────────────────
string g_general = "General Settings"
bool show_on_last_bar_only = input.bool(false, "Redraw only on last bar (cleaner chart)", group = g_general)
int anchor_time = input.time(timestamp("2026-02-25 07:00"), "Anchor start (drag me)", confirm = true, group = g_general)

string g_toggles = "Visible Elements (Original)"
bool show_current_high_vert = input.bool(true, "Show current bar: High → Mid vertical", group = g_toggles)
bool show_current_low_vert  = input.bool(true, "Show current bar: Low → Mid vertical", group = g_toggles)

string g_proj = "Forward Projections & Grid (Gann Diamond Style)"
bool   show_grid          = input.bool(true, "Show interior subdivisions / grid", group = g_proj)
string subdiv_type        = input.string("Equal", "Subdivision type", options = ["Equal", "Fibonacci"], group = g_proj)
int    grid_levels        = input.int(8, "Equal: number of grid lines (2-20)", minval=2, maxval=20, group = g_proj)
int    grid_future_bars   = input.int(300, "Grid extension to the right (bars)", minval=50, maxval=1000, group = g_proj)
int    diag_extend_bars   = input.int(300, "Diagonals extension to the right (bars)", minval=50, maxval=1500, group = g_proj)

// bool show_prop_from_mids  = input.bool(true,  "Propagate new diagonals FROM horizontal MIDPOINTS", group = g_proj)
bool show_quarter_diags   = input.bool(false, "Show ¼ & ¾ diagonals from Low (up) & High (down)", group = g_proj)

string g_appear = "Appearance – Grid & Propagated Lines"
color grid_color_equal = input.color(color.new(color.gray, 30), "Equal grid lines color", group = g_appear)
color grid_color_fib   = input.color(color.new(color.gray, 30), "Fibonacci grid lines color", group = g_appear)
color prop_mid_color   = input.color(color.new(#00ffff, 30), "Propagated from midpoints color", group = g_appear)
color quarter_color    = input.color(color.new(#00ffff, 30), "¼ & ¾ resolution diagonals color", group = g_appear)

int    prop_diag_width  = input.int(1, "Propagated diagonals width", minval=1, maxval=4, group = g_appear)
string prop_style_input = input.string("Dashed", "Propagated diagonals style", options=["Solid","Dashed","Dotted"], group = g_appear)

string g_colors = "Colors & Widths – Main Elements"
color mid_color      = input.color(color.white, "Mid line (horizontal full)", group = g_colors)
color range_v_color  = input.color(color.gray,  "Vertical range line (at t/2)", group = g_colors)
color high_line      = input.color(color.red,   "High horizontal (top line)", group = g_colors)
color low_line       = input.color(color.green, "Low horizontal (bottom line)", group = g_colors)
color curr_high_vert = input.color(color.red,   "Current bar: High → Mid (vertical)", group = g_colors)
color curr_low_vert  = input.color(color.green, "Current bar: Low → Mid (vertical)", group = g_colors)
color bottom_to_mid  = input.color(color.green, "Bottom → Mid vertical (at t)", group = g_colors)
color mid_to_top     = input.color(color.red,   "Mid → Top vertical (at t)", group = g_colors)
color upper_diag     = input.color(color.red,   "Upper diagonal(s)", group = g_colors)
color lower_diag     = input.color(color.green, "Lower diagonal(s)", group = g_colors)

int mid_width      = input.int(1, "Mid line width", minval=1, maxval=5, group = g_colors)
int high_low_width = input.int(2, "High/Low lines & current verts width", minval=1, group = g_colors)
int bottom_width   = input.int(2, "Bottom horizontal width", minval=1, group = g_colors)

// ────────────────────────────────────────
// HELPER
// ────────────────────────────────────────
get_prop_style(string choice) =>
    switch choice
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_dashed

// ────────────────────────────────────────
// ANCHOR & LOOKBACK
// ────────────────────────────────────────
var int anchor_bar = na
if time >= anchor_time and na(anchor_bar)
    anchor_bar := bar_index

if time >= anchor_time and not na(anchor_bar) and bar_index < anchor_bar
    anchor_bar := bar_index

int lookback = na(anchor_bar) ? 10 : math.max(10, bar_index - anchor_bar)

// ────────────────────────────────────────
// DRAW CONDITION
// ────────────────────────────────────────
bool should_draw = barstate.islast or not show_on_last_bar_only

// ────────────────────────────────────────
// CORE CALCULATIONS
// ────────────────────────────────────────
float hh = ta.highest(high, lookback)
float ll = ta.lowest(low, lookback)
float mid = (hh + ll) / 2

float slope_upper = (hh - mid) / (lookback / 2.0)
float slope_lower = (ll - mid) / (lookback / 2.0)

int left_bar     = bar_index - lookback
int mid_bar      = left_bar + math.round(lookback * 0.5)
int bar_at_25pct = left_bar + math.round(lookback * 0.25)
int bar_at_75pct = left_bar + math.round(lookback * 0.75)

int future_x = bar_index + diag_extend_bars

// ────────────────────────────────────────
// PERSISTENT OBJECTS
// ────────────────────────────────────────
var line ln_mid        = na
var line ln_range_vert = na
var line ln_high_curr  = na
var line ln_low_curr   = na
var line ln_bottom     = na
var line ln_bottom_mid = na
var line ln_mid_top    = na
var line ln_top        = na

var array<line> dynamic_grid     = array.new_line()
var array<line> dynamic_prop     = array.new_line()
var array<line> dynamic_quarters = array.new_line()
var array<line> dynamic_group1   = array.new_line()

// ────────────────────────────────────────
// MAIN DRAWING
// ────────────────────────────────────────
if should_draw
    // ─── CLEANUP ───
    if array.size(dynamic_grid) > 0
        for i = 0 to array.size(dynamic_grid) - 1
            array.get(dynamic_grid, i).delete()
        array.clear(dynamic_grid)

    if array.size(dynamic_prop) > 0
        for i = 0 to array.size(dynamic_prop) - 1
            array.get(dynamic_prop, i).delete()
        array.clear(dynamic_prop)

    if array.size(dynamic_quarters) > 0
        for i = 0 to array.size(dynamic_quarters) - 1
            array.get(dynamic_quarters, i).delete()
        array.clear(dynamic_quarters)

    if array.size(dynamic_group1) > 0
        for i = 0 to array.size(dynamic_group1) - 1
            array.get(dynamic_group1, i).delete()
        array.clear(dynamic_group1)

    if not na(ln_mid)
        ln_mid.delete()
    ln_mid := na

    if not na(ln_range_vert)
        ln_range_vert.delete()
    ln_range_vert := na

    if not na(ln_high_curr)
        ln_high_curr.delete()
    ln_high_curr := na

    if not na(ln_low_curr)
        ln_low_curr.delete()
    ln_low_curr := na

    if not na(ln_bottom)
        ln_bottom.delete()
    ln_bottom := na

    if not na(ln_bottom_mid)
        ln_bottom_mid.delete()
    ln_bottom_mid := na

    if not na(ln_mid_top)
        ln_mid_top.delete()
    ln_mid_top := na

    if not na(ln_top)
        ln_top.delete()
    ln_top := na

    // ─── MAIN STRUCTURE ───
    ln_mid        := line.new(left_bar, mid, bar_index, mid,        color = mid_color, width = mid_width)
    ln_range_vert := line.new(mid_bar,  ll,  mid_bar,  hh,         color = range_v_color)

    if show_current_high_vert
        ln_high_curr := line.new(bar_index, hh, bar_index, mid, color = curr_high_vert, width = high_low_width)

    if show_current_low_vert
        ln_low_curr  := line.new(bar_index, ll, bar_index, mid, color = curr_low_vert,  width = high_low_width)

    ln_bottom := line.new(left_bar, ll, bar_index, ll, color = low_line,  width = bottom_width)
    ln_top    := line.new(left_bar, hh, bar_index, hh, color = high_line, width = 3)

    ln_bottom_mid := line.new(left_bar, ll, left_bar, mid, color = bottom_to_mid, width = 3)
    ln_mid_top    := line.new(left_bar, mid, left_bar, hh, color = mid_to_top,    width = 2)

    // ─── GROUP 1: Up from LOW horizontal @ 0, ½, 1 ───
    array.push(dynamic_group1, line.new(left_bar,     ll, future_x, ll + slope_upper * (future_x - left_bar),     extend=extend.right, color=lower_diag, width=2))
    array.push(dynamic_group1, line.new(mid_bar,      ll, future_x, ll + slope_upper * (future_x - mid_bar),      extend=extend.right, color=lower_diag, width=2))
    array.push(dynamic_group1, line.new(bar_index,    ll, future_x, ll + slope_upper * (future_x - bar_index),    extend=extend.right, color=lower_diag, width=2))

    // ─── GROUP 1: Down from HIGH horizontal @ 0, ½, 1 ───
    array.push(dynamic_group1, line.new(left_bar,     hh, future_x, hh + slope_lower * (future_x - left_bar),     extend=extend.right, color=upper_diag, width=2))
    array.push(dynamic_group1, line.new(mid_bar,      hh, future_x, hh + slope_lower * (future_x - mid_bar),      extend=extend.right, color=upper_diag, width=2))
    array.push(dynamic_group1, line.new(bar_index,    hh, future_x, hh + slope_lower * (future_x - bar_index),    extend=extend.right, color=upper_diag, width=2))

    // ─── INTERIOR GRID ───
    if show_grid
        if subdiv_type == "Equal"
            for i = 1 to grid_levels - 1
                float lvl = ll + (hh - ll) * i / grid_levels
                line l = line.new(left_bar, lvl, bar_index + grid_future_bars, lvl, color = grid_color_equal, style = line.style_dashed)
                array.push(dynamic_grid, l)
        else
            array<float> fib_ratios = array.from(0.236, 0.382, 0.5, 0.618, 0.786)
            for ratio in fib_ratios
                float lvl = ll + (hh - ll) * ratio
                line l = line.new(left_bar, lvl, bar_index + grid_future_bars, lvl, color = grid_color_fib, style = line.style_dotted)
                array.push(dynamic_grid, l)

    // ─── PROPAGATED FROM MIDPOINTS (optional) ───
    line_style = get_prop_style(prop_style_input)
    // if show_prop_from_mids
    //     float y_top_mid_right = hh + slope_lower * (future_x - mid_bar)
    //     float y_bot_mid_right = ll + slope_upper * (future_x - mid_bar)

    //     array.push(dynamic_prop, line.new(mid_bar, hh, future_x, y_top_mid_right, color = prop_mid_color, width = prop_diag_width, style = line_style, extend = extend.right))
    //     array.push(dynamic_prop, line.new(mid_bar, ll, future_x, y_bot_mid_right, color = prop_mid_color, width = prop_diag_width, style = line_style, extend = extend.right))

    // ─── GROUP 2: Finer resolution (¼ & ¾) ───
    if show_quarter_diags
        int w = math.max(1, prop_diag_width - 1)

        // Up from LOW @ ¼, ¾
        float y_25_up = ll + slope_upper * (future_x - bar_at_25pct)
        float y_75_up = ll + slope_upper * (future_x - bar_at_75pct)
        array.push(dynamic_quarters, line.new(bar_at_25pct, ll, future_x, y_25_up, color = quarter_color, width = w, style = line_style, extend = extend.right))
        array.push(dynamic_quarters, line.new(bar_at_75pct, ll, future_x, y_75_up, color = quarter_color, width = w, style = line_style, extend = extend.right))

        // Down from HIGH @ ¼, ¾
        float y_25_dn = hh + slope_lower * (future_x - bar_at_25pct)
        float y_75_dn = hh + slope_lower * (future_x - bar_at_75pct)
        array.push(dynamic_quarters, line.new(bar_at_25pct, hh, future_x, y_25_dn, color = quarter_color, width = w, style = line_style, extend = extend.right))
        array.push(dynamic_quarters, line.new(bar_at_75pct, hh, future_x, y_75_dn, color = quarter_color, width = w, style = line_style, extend = extend.right))

    // ─── LABELS ───
    if barstate.islast
        label.new(bar_index, mid, "Mid " + str.tostring(mid, "#.#####"), color = mid_color, style = label.style_label_left, textcolor = color.black, size = size.small)
        label.new(bar_index, hh,  "HH "  + str.tostring(hh,  "#.#####"), color = high_line, style = label.style_label_left, textcolor = color.white, size = size.normal)
        label.new(bar_index, ll,  "LL "  + str.tostring(ll,  "#.#####"), color = low_line,  style = label.style_label_left, textcolor = color.white, size = size.normal)

// ────────────────────────────────────────
// ANCHOR LINE
// ────────────────────────────────────────
var line anchorLine = na
if ta.change(anchor_time) or barstate.isfirst
    if na(anchorLine)
        anchorLine := line.new(x1 = anchor_time, y1 = -1e12, x2 = anchor_time, y2 = 1e12, xloc = xloc.bar_time, extend = extend.both, color = color.blue, style = line.style_dashed, width = 2)
    else
        line.set_x1(anchorLine, anchor_time)
        line.set_x2(anchorLine, anchor_time)
