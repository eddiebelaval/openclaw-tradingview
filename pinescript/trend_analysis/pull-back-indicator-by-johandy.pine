//@version=6
indicator("Pull Back indicator by Johandy", overlay=true, max_boxes_count=500)

// --- INPUTS ---
useAuto = input.bool(true, "Auto Impulse by Timeframe")
tp_points = input.int(60, "Take Profit")
sl_points = input.int(40, "Stop Loss")

// --- AUTO IMPULSE BY TIMEFRAME ---
tf = timeframe.multiplier

impulse_points = useAuto ? (
    timeframe.isseconds ? 50 :
    timeframe.isintraday ? (
        tf <= 1 ? 100 : tf == 2 ? 130 : tf == 3 ? 150 : tf == 4 ? 180 :
        tf == 5 ? 220 : tf == 6 ? 250 : tf == 7 ? 280 : tf == 8 ? 300 :
        tf == 9 ? 330 : tf == 10 ? 350 : tf == 12 ? 380 : tf == 15 ? 400 :
        tf == 20 ? 450 : tf == 25 ? 500 : tf == 30 ? 550 : tf == 45 ? 650 :
        tf == 60 ? 800 : tf == 120 ? 1000 : tf == 180 ? 1200 : tf == 240 ? 1500 : 100
    ) :
    timeframe.isdaily ? 2000 : timeframe.isweekly ? 4000 : timeframe.ismonthly ? 8000 : 100
) : input.int(100, "Manual Impulse Size")

// --- COLORS ---
greenColor = color.rgb(8, 153, 129)
greenTint  = color.new(greenColor, 85)
greenLive  = color.new(greenColor, 60)

redColor   = color.red
redTint    = color.new(redColor, 85)
redLive    = color.new(redColor, 60)

grayColor  = color.gray

// --- TRACK IMPULSE ---
var float impulseHigh = na
var float impulseLow = na
var bool impulseActive = false

moveUp = high - low[10] >= impulse_points
moveDown = high[10] - low >= impulse_points

if moveUp
    impulseHigh := high
    impulseLow := low[10]
    impulseActive := true

if moveDown
    impulseHigh := high[10]
    impulseLow := low
    impulseActive := true

// --- SWEEP CONDITIONS ---
sellSweep = impulseActive and high > impulseHigh and close < impulseHigh
buySweep  = impulseActive and low < impulseLow and close > impulseLow

// --- COOLDOWN ---
var int lastTradeBar = na
cooldown = 10

// --- TRADE STATE ---
var float entry = na
var float tp = na
var float sl = na
var bool inTrade = false
var bool isLong = false

// --- OBJECTS ---
var box tpBox = na
var box slBox = na
var box liveBox = na
var box entryBox = na
var label pnlLabel = na

// Hover labels
var label tpLabel = na
var label slLabel = na
var label entryLabel = na

// --- ENTRY CONDITIONS (BLOCK IF IN TRADE) ---
canSell = not inTrade and sellSweep and (na(lastTradeBar) or bar_index - lastTradeBar > cooldown)
canBuy  = not inTrade and buySweep and (na(lastTradeBar) or bar_index - lastTradeBar > cooldown)

// --- ENTRY LOGIC ---
// SELL
if canSell
    lastTradeBar := bar_index
    entry := close
    tp := entry - tp_points
    sl := entry + sl_points
    isLong := false
    inTrade := true

    tpBox := box.new(bar_index, entry, bar_index, tp, bgcolor=greenTint, border_color=na)
    slBox := box.new(bar_index, sl, bar_index, entry, bgcolor=redTint, border_color=na)
    liveBox := box.new(bar_index, entry, bar_index, entry, bgcolor=na, border_color=na)
    entryBox := box.new(bar_index, entry + 0.0001, bar_index, entry - 0.0001, bgcolor=grayColor, border_color=grayColor)

    // Labels with solid white text
    tpLabel := label.new(bar_index, tp, str.format("TP: ${0,number,#.##}", tp), style=label.style_label_down, color=color.new(color.green, 80), textcolor=color.white, size=size.small)
    slLabel := label.new(bar_index, sl, str.format("SL: ${0,number,#.##}", sl), style=label.style_label_up, color=color.new(color.red, 80), textcolor=color.white, size=size.small)
    entryLabel := label.new(bar_index, entry, str.format("Entry: ${0,number,#.##}", entry), style=label.style_label_center, color=color.new(grayColor, 80), textcolor=color.white, size=size.small)

// BUY
if canBuy
    lastTradeBar := bar_index
    entry := close
    tp := entry + tp_points
    sl := entry - sl_points
    isLong := true
    inTrade := true

    tpBox := box.new(bar_index, tp, bar_index, entry, bgcolor=greenTint, border_color=na)
    slBox := box.new(bar_index, entry, bar_index, sl, bgcolor=redTint, border_color=na)
    liveBox := box.new(bar_index, entry, bar_index, entry, bgcolor=na, border_color=na)
    entryBox := box.new(bar_index, entry + 0.0001, bar_index, entry - 0.0001, bgcolor=grayColor, border_color=grayColor)

    // Labels with solid white text
    tpLabel := label.new(bar_index, tp, str.format("TP: ${0,number,#.##}", tp), style=label.style_label_up, color=color.new(color.green, 80), textcolor=color.white, size=size.small)
    slLabel := label.new(bar_index, sl, str.format("SL: ${0,number,#.##}", sl), style=label.style_label_down, color=color.new(color.red, 80), textcolor=color.white, size=size.small)
    entryLabel := label.new(bar_index, entry, str.format("Entry: ${0,number,#.##}", entry), style=label.style_label_center, color=color.new(grayColor, 80), textcolor=color.white, size=size.small)

// --- UPDATE LIVE TRADE ---
if inTrade
    box.set_right(tpBox, bar_index)
    box.set_right(slBox, bar_index)
    box.set_right(liveBox, bar_index)
    box.set_right(entryBox, bar_index)

    // --- LONG ---
    if isLong
        if close >= entry
            box.set_top(liveBox, close)
            box.set_bottom(liveBox, entry)
            box.set_bgcolor(liveBox, greenLive)
        else
            box.set_top(liveBox, entry)
            box.set_bottom(liveBox, close)
            box.set_bgcolor(liveBox, redLive)
    // --- SHORT ---
    else
        if close <= entry
            box.set_top(liveBox, entry)
            box.set_bottom(liveBox, close)
            box.set_bgcolor(liveBox, greenLive)
        else
            box.set_top(liveBox, close)
            box.set_bottom(liveBox, entry)
            box.set_bgcolor(liveBox, redLive)

    // --- LIVE PnL LABEL ---
    pnlPoints = isLong ? (close - entry) : (entry - close)
    pnlDollar = pnlPoints * 2  // 1 micro MNQ = $2 per point
    pnlText = str.format("1 MNQ PnL: ${0,number,#.##}", pnlDollar)

    midBar = math.round((lastTradeBar + bar_index) / 2)
    midPrice = entry  // vertical = gray line

    labelColor = pnlDollar >= 0 ? color.new(color.green, 0) : color.new(color.red, 0)

    if na(pnlLabel)
        pnlLabel := label.new(midBar, midPrice, pnlText, 
                              color=labelColor, textcolor=color.white, 
                              style=label.style_label_center, size=size.small)
    else
        label.set_xy(pnlLabel, midBar, midPrice)
        label.set_text(pnlLabel, pnlText)
        label.set_color(pnlLabel, labelColor)

    // --- EXIT CONDITIONS ---
    hitTP = (isLong and close >= tp) or (not isLong and close <= tp)
    hitSL = (isLong and close <= sl) or (not isLong and close >= sl)

    if hitTP or hitSL
        inTrade := false
        label.delete(pnlLabel)
        pnlLabel := na
        label.delete(tpLabel)
        label.delete(slLabel)
        label.delete(entryLabel)
