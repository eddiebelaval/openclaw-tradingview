//@version=6
indicator("[JOAT] Directional Bias Aggregator", shorttitle="DBA [JOAT]", overlay=false, max_bars_back=500)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DIRECTIONAL BIAS AGGREGATOR
// Quantitative Trading Systems - Multi-Timeframe Bias Scoring Engine
// Purpose: Aggregate directional bias across multiple timeframes with weighted scoring
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

//───────────────────────────────────────────────────────────────────────────────
// CONFIGURATION
//───────────────────────────────────────────────────────────────────────────────

g_tf = "═══════════ Timeframe Settings ═══════════"
string  i_tf1           = input.timeframe("15", "Timeframe 1 (Fastest)", group=g_tf)
string  i_tf2           = input.timeframe("60", "Timeframe 2", group=g_tf)
string  i_tf3           = input.timeframe("240", "Timeframe 3", group=g_tf)
string  i_tf4           = input.timeframe("D", "Timeframe 4 (Slowest)", group=g_tf)

g_weights = "═══════════ Weighting ═══════════"
float   i_w1            = input.float(0.15, "TF1 Weight", minval=0.05, maxval=0.5, step=0.05, group=g_weights)
float   i_w2            = input.float(0.25, "TF2 Weight", minval=0.05, maxval=0.5, step=0.05, group=g_weights)
float   i_w3            = input.float(0.30, "TF3 Weight", minval=0.05, maxval=0.5, step=0.05, group=g_weights)
float   i_w4            = input.float(0.30, "TF4 Weight", minval=0.05, maxval=0.5, step=0.05, group=g_weights)

g_calc = "═══════════ Calculation Settings ═══════════"
int     i_ma_fast       = input.int(8, "Fast MA Period", minval=3, maxval=30, group=g_calc)
int     i_ma_slow       = input.int(21, "Slow MA Period", minval=10, maxval=100, group=g_calc)
int     i_rsi_len       = input.int(14, "RSI Period", minval=5, maxval=30, group=g_calc)
int     i_macd_fast     = input.int(12, "MACD Fast", minval=5, maxval=20, group=g_calc)
int     i_macd_slow     = input.int(26, "MACD Slow", minval=15, maxval=50, group=g_calc)
int     i_macd_sig      = input.int(9, "MACD Signal", minval=3, maxval=15, group=g_calc)

g_thresh = "═══════════ Thresholds ═══════════"
float   i_strong_thresh = input.float(60, "Strong Bias Threshold", minval=40, maxval=80, group=g_thresh)
float   i_weak_thresh   = input.float(30, "Weak Bias Threshold", minval=10, maxval=50, group=g_thresh)

g_trend = "═══════════ Trend Integration ═══════════"
bool    i_use_trend     = input.bool(true, "Enable Trend Layer", group=g_trend)
int     i_trend_ma      = input.int(200, "Trend MA Period", minval=50, maxval=500, group=g_trend)
float   i_trend_weight  = input.float(0.2, "Trend Weight Bonus", minval=0.0, maxval=0.5, step=0.05, group=g_trend)

g_visual = "═══════════ Visual Settings ═══════════"
color   i_bull_col      = input.color(color.new(#00c853, 0), "Bullish Color", group=g_visual)
color   i_bull_glow     = input.color(color.new(#69f0ae, 0), "Bullish Glow", group=g_visual)
color   i_bear_col      = input.color(color.new(#ff1744, 0), "Bearish Color", group=g_visual)
color   i_bear_glow     = input.color(color.new(#ff8a80, 0), "Bearish Glow", group=g_visual)
color   i_neutral_col   = input.color(color.new(#546e7a, 0), "Neutral Color", group=g_visual)
color   i_tf1_col       = input.color(color.new(#29b6f6, 0), "TF1 Color", group=g_visual)
color   i_tf2_col       = input.color(color.new(#ab47bc, 0), "TF2 Color", group=g_visual)
color   i_tf3_col       = input.color(color.new(#ffa726, 0), "TF3 Color", group=g_visual)
color   i_tf4_col       = input.color(color.new(#66bb6a, 0), "TF4 Color", group=g_visual)
bool    i_show_mtf      = input.bool(true, "Show MTF Breakdown", group=g_visual)
bool    i_show_glow     = input.bool(true, "Enable Glow Effects", group=g_visual)
bool    i_show_ribbon   = input.bool(true, "Show Bias Ribbon", group=g_visual)
bool    i_show_dash     = input.bool(true, "Show Dashboard", group=g_visual)

//───────────────────────────────────────────────────────────────────────────────
// BIAS CALCULATION FUNCTIONS
//───────────────────────────────────────────────────────────────────────────────

// Calculate single timeframe bias score (-100 to +100)
f_calc_bias(float src_close, float src_high, float src_low) =>
    // MA trend component
    float ma_fast = ta.ema(src_close, i_ma_fast)
    float ma_slow = ta.ema(src_close, i_ma_slow)
    float ma_diff = ma_slow != 0 ? (ma_fast - ma_slow) / ma_slow * 100 : 0
    float ma_score = math.max(math.min(ma_diff * 10, 100), -100)
    
    // Price position relative to MAs
    float price_pos = 0.0
    if src_close > ma_fast and ma_fast > ma_slow
        price_pos := 100
    else if src_close < ma_fast and ma_fast < ma_slow
        price_pos := -100
    else if src_close > ma_slow
        price_pos := 50
    else if src_close < ma_slow
        price_pos := -50
    
    // RSI component
    float rsi_val = ta.rsi(src_close, i_rsi_len)
    float rsi_score = (rsi_val - 50) * 2
    
    // MACD component
    float macd_line = ta.ema(src_close, i_macd_fast) - ta.ema(src_close, i_macd_slow)
    float macd_signal = ta.ema(macd_line, i_macd_sig)
    float macd_hist = macd_line - macd_signal
    float atr_val = ta.atr(14)
    float macd_score = atr_val > 0 ? (macd_hist > 0 ? math.min(macd_hist / atr_val * 50, 100) : 
                       math.max(macd_hist / atr_val * 50, -100)) : 0
    
    // Composite score (weighted average)
    float composite = ma_score * 0.35 + price_pos * 0.30 + rsi_score * 0.15 + macd_score * 0.20
    
    composite

//───────────────────────────────────────────────────────────────────────────────
// MULTI-TIMEFRAME DATA REQUESTS
//───────────────────────────────────────────────────────────────────────────────

// Request data from each timeframe (using confirmed bars to prevent repainting)
f_request_bias(string tf) =>
    request.security(syminfo.tickerid, tf, f_calc_bias(close, high, low)[1], lookahead=barmerge.lookahead_on)

float bias_tf1 = f_request_bias(i_tf1)
float bias_tf2 = f_request_bias(i_tf2)
float bias_tf3 = f_request_bias(i_tf3)
float bias_tf4 = f_request_bias(i_tf4)

// Current timeframe bias
float bias_current = f_calc_bias(close, high, low)

//───────────────────────────────────────────────────────────────────────────────
// WEIGHTED AGGREGATION
//───────────────────────────────────────────────────────────────────────────────

// Normalize weights
float total_weight = i_w1 + i_w2 + i_w3 + i_w4
float w1_norm = total_weight > 0 ? i_w1 / total_weight : 0.25
float w2_norm = total_weight > 0 ? i_w2 / total_weight : 0.25
float w3_norm = total_weight > 0 ? i_w3 / total_weight : 0.25
float w4_norm = total_weight > 0 ? i_w4 / total_weight : 0.25

// Aggregate bias score
float aggregate_bias = nz(bias_tf1) * w1_norm + nz(bias_tf2) * w2_norm + nz(bias_tf3) * w3_norm + nz(bias_tf4) * w4_norm

// Smoothed aggregate
float smooth_bias = ta.ema(aggregate_bias, 3)

//───────────────────────────────────────────────────────────────────────────────
// TREND FILTER INTEGRATION
//───────────────────────────────────────────────────────────────────────────────

float trend_ma = ta.ema(close, i_trend_ma)
bool above_trend = close > trend_ma
bool below_trend = close < trend_ma
float trend_distance = trend_ma != 0 ? (close - trend_ma) / trend_ma * 100 : 0

// Trend-adjusted bias
float trend_adjusted_bias = smooth_bias
if i_use_trend
    if above_trend and smooth_bias > 0
        trend_adjusted_bias := smooth_bias * (1 + i_trend_weight)
    else if below_trend and smooth_bias < 0
        trend_adjusted_bias := smooth_bias * (1 + i_trend_weight)
    else if above_trend and smooth_bias < 0
        trend_adjusted_bias := smooth_bias * (1 - i_trend_weight * 0.5)  // Reduce conviction
    else if below_trend and smooth_bias > 0
        trend_adjusted_bias := smooth_bias * (1 - i_trend_weight * 0.5)

// Clamp adjusted bias
trend_adjusted_bias := math.max(math.min(trend_adjusted_bias, 100), -100)

//───────────────────────────────────────────────────────────────────────────────
// BIAS ALIGNMENT ANALYSIS
//───────────────────────────────────────────────────────────────────────────────

// Count aligned timeframes
int bullish_count = 0
int bearish_count = 0

if nz(bias_tf1) > i_weak_thresh
    bullish_count += 1
else if nz(bias_tf1) < -i_weak_thresh
    bearish_count += 1

if nz(bias_tf2) > i_weak_thresh
    bullish_count += 1
else if nz(bias_tf2) < -i_weak_thresh
    bearish_count += 1

if nz(bias_tf3) > i_weak_thresh
    bullish_count += 1
else if nz(bias_tf3) < -i_weak_thresh
    bearish_count += 1

if nz(bias_tf4) > i_weak_thresh
    bullish_count += 1
else if nz(bias_tf4) < -i_weak_thresh
    bearish_count += 1

// Alignment score (0-4)
int alignment_score = math.max(bullish_count, bearish_count)

// Alignment direction
int alignment_direction = bullish_count > bearish_count ? 1 : 
                          bearish_count > bullish_count ? -1 : 0

// Perfect alignment check
bool perfect_bullish = bullish_count == 4
bool perfect_bearish = bearish_count == 4

//───────────────────────────────────────────────────────────────────────────────
// BIAS STATE CLASSIFICATION
//───────────────────────────────────────────────────────────────────────────────

// State: 2=strong bull, 1=weak bull, 0=neutral, -1=weak bear, -2=strong bear
int bias_state = 0

if smooth_bias >= i_strong_thresh
    bias_state := 2
else if smooth_bias >= i_weak_thresh
    bias_state := 1
else if smooth_bias <= -i_strong_thresh
    bias_state := -2
else if smooth_bias <= -i_weak_thresh
    bias_state := -1

// Confluence quality (alignment + strength)
float confluence_quality = (float(alignment_score) / 4.0) * (math.abs(smooth_bias) / 100.0) * 100

// Bias conviction score (combines multiple factors)
float conviction_score = 0.0
conviction_score += float(alignment_score) * 15  // Max 60
conviction_score += math.abs(smooth_bias) * 0.3  // Max 30
if i_use_trend
    if (above_trend and smooth_bias > 0) or (below_trend and smooth_bias < 0)
        conviction_score += 10  // Trend alignment bonus
conviction_score := math.min(conviction_score, 100)

// Bias consistency (how stable is the bias over time)
var int bias_consistency_counter = 0
if smooth_bias > i_weak_thresh and smooth_bias[1] > i_weak_thresh
    bias_consistency_counter := math.min(bias_consistency_counter + 1, 20)
else if smooth_bias < -i_weak_thresh and smooth_bias[1] < -i_weak_thresh
    bias_consistency_counter := math.min(bias_consistency_counter + 1, 20)
else
    bias_consistency_counter := math.max(bias_consistency_counter - 1, 0)

float bias_consistency = float(bias_consistency_counter) / 20.0 * 100

//───────────────────────────────────────────────────────────────────────────────
// BIAS MOMENTUM
//───────────────────────────────────────────────────────────────────────────────

float bias_momentum = smooth_bias - smooth_bias[5]
bool momentum_confirming = (smooth_bias > 0 and bias_momentum > 0) or (smooth_bias < 0 and bias_momentum < 0)

// Bias acceleration
float bias_accel = bias_momentum - nz(bias_momentum[5])
bool accelerating = (bias_momentum > 0 and bias_accel > 0) or (bias_momentum < 0 and bias_accel < 0)

//───────────────────────────────────────────────────────────────────────────────
// VISUALIZATION
//───────────────────────────────────────────────────────────────────────────────

// Dynamic gradient color based on bias intensity
f_bias_gradient(float value, float strong, float weak, color bull, color bull_glow, color bear, color bear_glow, color neutral) =>
    if value >= strong
        int intensity = math.round(math.min((value - strong) / (100 - strong) * 40, 40))
        color.new(bull, math.max(0, 20 - intensity))
    else if value >= weak
        int intensity = math.round((value - weak) / (strong - weak) * 40)
        color.new(bull, 60 - intensity)
    else if value <= -strong
        int intensity = math.round(math.min((math.abs(value) - strong) / (100 - strong) * 40, 40))
        color.new(bear, math.max(0, 20 - intensity))
    else if value <= -weak
        int intensity = math.round((math.abs(value) - weak) / (strong - weak) * 40)
        color.new(bear, 60 - intensity)
    else
        neutral

// Main bias color with gradient
color bias_color = f_bias_gradient(trend_adjusted_bias, i_strong_thresh, i_weak_thresh, i_bull_col, i_bull_glow, i_bear_col, i_bear_glow, i_neutral_col)

// Glow color
color glow_col = na
if i_show_glow
    if trend_adjusted_bias >= i_strong_thresh
        glow_col := color.new(i_bull_glow, math.round(70 - conviction_score * 0.4))
    else if trend_adjusted_bias <= -i_strong_thresh
        glow_col := color.new(i_bear_glow, math.round(70 - conviction_score * 0.4))

// Glow layer
plot(trend_adjusted_bias * 1.08, "Bias Glow", color=glow_col, style=plot.style_columns, linewidth=5)

// Aggregate bias histogram
plot(trend_adjusted_bias, "Aggregate Bias", color=bias_color, style=plot.style_columns, linewidth=3)

// Conviction ribbon
color ribbon_col = i_show_ribbon ? (trend_adjusted_bias > 0 ? color.new(i_bull_col, math.round(85 - conviction_score * 0.2)) :
                   trend_adjusted_bias < 0 ? color.new(i_bear_col, math.round(85 - conviction_score * 0.2)) :
                   color.new(i_neutral_col, 90)) : na
plot(i_show_ribbon ? conviction_score / 1.5 : na, "Conviction Ribbon", color=ribbon_col, style=plot.style_area)

// Reference lines
hline(0, "Zero", color=color.new(#37474f, 50), linestyle=hline.style_solid)
hline(i_strong_thresh, "Strong Bull", color=color.new(i_bull_col, 60), linestyle=hline.style_dotted)
hline(-i_strong_thresh, "Strong Bear", color=color.new(i_bear_col, 60), linestyle=hline.style_dotted)
hline(i_weak_thresh, "Weak Bull", color=color.new(i_bull_col, 80), linestyle=hline.style_dotted)
hline(-i_weak_thresh, "Weak Bear", color=color.new(i_bear_col, 80), linestyle=hline.style_dotted)

// MTF breakdown lines with unique colors
plot(i_show_mtf ? bias_tf1 : na, "TF1 Bias", color=i_show_mtf ? color.new(i_tf1_col, 50) : na, style=plot.style_line, linewidth=1)
plot(i_show_mtf ? bias_tf2 : na, "TF2 Bias", color=i_show_mtf ? color.new(i_tf2_col, 50) : na, style=plot.style_line, linewidth=1)
plot(i_show_mtf ? bias_tf3 : na, "TF3 Bias", color=i_show_mtf ? color.new(i_tf3_col, 50) : na, style=plot.style_line, linewidth=1)
plot(i_show_mtf ? bias_tf4 : na, "TF4 Bias", color=i_show_mtf ? color.new(i_tf4_col, 50) : na, style=plot.style_line, linewidth=1)

// Bias momentum with dynamic color
color mom_col = bias_momentum > 0 ? color.new(i_bull_col, 70) : bias_momentum < 0 ? color.new(i_bear_col, 70) : color.new(i_neutral_col, 80)
plot(bias_momentum * 2, "Bias Momentum", color=mom_col, style=plot.style_area)

// Background gradient based on state and conviction
color bg_col = na
if bias_state == 2 and conviction_score > 50
    bg_col := color.new(i_bull_col, math.round(96 - conviction_score * 0.08))
else if bias_state == 2
    bg_col := color.new(i_bull_col, 95)
else if bias_state == -2 and conviction_score > 50
    bg_col := color.new(i_bear_col, math.round(96 - conviction_score * 0.08))
else if bias_state == -2
    bg_col := color.new(i_bear_col, 95)
bgcolor(bg_col)

// Perfect alignment markers with glow
plotshape(perfect_bullish and barstate.isconfirmed, "Perfect Bull Align", shape.diamond, 
          location.top, color=color.new(i_bull_glow, 0), size=size.tiny)
plotshape(perfect_bearish and barstate.isconfirmed, "Perfect Bear Align", shape.diamond, 
          location.bottom, color=color.new(i_bear_glow, 0), size=size.tiny)

// Acceleration markers
plotshape(accelerating and bias_state == 2 and barstate.isconfirmed, "Bull Accelerating", 
          shape.triangleup, location.bottom, color=color.new(i_bull_col, 30), size=size.tiny)
plotshape(accelerating and bias_state == -2 and barstate.isconfirmed, "Bear Accelerating", 
          shape.triangledown, location.top, color=color.new(i_bear_col, 30), size=size.tiny)

//───────────────────────────────────────────────────────────────────────────────
// DASHBOARD
//───────────────────────────────────────────────────────────────────────────────

if i_show_dash and barstate.islast
    var table dash = table.new(position.top_right, 3, 9, bgcolor=color.new(#0d1117, 5),
                               border_width=1, border_color=color.new(#30363d, 40))
    
    string state_text = switch bias_state
        2 => "STRONG BULL"
        1 => "WEAK BULL"
        -1 => "WEAK BEAR"
        -2 => "STRONG BEAR"
        => "NEUTRAL"
    
    string align_text = str.tostring(alignment_score) + "/4 " + (alignment_direction == 1 ? "BULL" : alignment_direction == -1 ? "BEAR" : "MIXED")
    
    // Headers
    table.cell(dash, 0, 0, "TIMEFRAME", text_color=color.new(#b2b5be, 0), text_size=size.small)
    table.cell(dash, 1, 0, "BIAS", text_color=color.new(#b2b5be, 0), text_size=size.small)
    table.cell(dash, 2, 0, "WEIGHT", text_color=color.new(#b2b5be, 0), text_size=size.small)
    
    // TF1
    table.cell(dash, 0, 1, i_tf1, text_color=color.new(#b2b5be, 0), text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(nz(bias_tf1), "#"), text_color=nz(bias_tf1) > 0 ? i_bull_col : nz(bias_tf1) < 0 ? i_bear_col : i_neutral_col, text_size=size.small)
    table.cell(dash, 2, 1, str.tostring(w1_norm * 100, "#") + "%", text_color=i_tf1_col, text_size=size.small)
    
    // TF2
    table.cell(dash, 0, 2, i_tf2, text_color=color.new(#b2b5be, 0), text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(nz(bias_tf2), "#"), text_color=nz(bias_tf2) > 0 ? i_bull_col : nz(bias_tf2) < 0 ? i_bear_col : i_neutral_col, text_size=size.small)
    table.cell(dash, 2, 2, str.tostring(w2_norm * 100, "#") + "%", text_color=i_tf2_col, text_size=size.small)
    
    // TF3
    table.cell(dash, 0, 3, i_tf3, text_color=color.new(#b2b5be, 0), text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(nz(bias_tf3), "#"), text_color=nz(bias_tf3) > 0 ? i_bull_col : nz(bias_tf3) < 0 ? i_bear_col : i_neutral_col, text_size=size.small)
    table.cell(dash, 2, 3, str.tostring(w3_norm * 100, "#") + "%", text_color=i_tf3_col, text_size=size.small)
    
    // TF4
    table.cell(dash, 0, 4, i_tf4, text_color=color.new(#b2b5be, 0), text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(nz(bias_tf4), "#"), text_color=nz(bias_tf4) > 0 ? i_bull_col : nz(bias_tf4) < 0 ? i_bear_col : i_neutral_col, text_size=size.small)
    table.cell(dash, 2, 4, str.tostring(w4_norm * 100, "#") + "%", text_color=i_tf4_col, text_size=size.small)
    
    // Aggregate
    table.cell(dash, 0, 5, "AGGREGATE", text_color=color.new(#b2b5be, 0), text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(trend_adjusted_bias, "#.#"), text_color=bias_color, text_size=size.small)
    table.cell(dash, 2, 5, state_text, text_color=bias_color, text_size=size.small)
    
    // Alignment
    table.cell(dash, 0, 6, "ALIGNMENT", text_color=color.new(#b2b5be, 0), text_size=size.small)
    table.cell(dash, 1, 6, align_text, text_color=alignment_direction == 1 ? i_bull_col : 
               alignment_direction == -1 ? i_bear_col : i_neutral_col, text_size=size.small)
    table.cell(dash, 2, 6, str.tostring(confluence_quality, "#") + "%", text_color=color.new(#ffa726, 0), text_size=size.small)
    
    // Conviction
    table.cell(dash, 0, 7, "CONVICTION", text_color=color.new(#b2b5be, 0), text_size=size.small)
    table.cell(dash, 1, 7, str.tostring(conviction_score, "#") + "%", text_color=color.new(#e91e63, 0), text_size=size.small)
    table.cell(dash, 2, 7, accelerating ? "ACCEL" : "STEADY", text_color=accelerating ? i_bull_col : i_neutral_col, text_size=size.small)
    
    // Trend
    string trend_text = i_use_trend ? (above_trend ? "ABOVE" : below_trend ? "BELOW" : "AT") : "OFF"
    color trend_col = above_trend ? i_bull_col : below_trend ? i_bear_col : i_neutral_col
    table.cell(dash, 0, 8, "TREND MA", text_color=color.new(#b2b5be, 0), text_size=size.small)
    table.cell(dash, 1, 8, trend_text, text_color=trend_col, text_size=size.small)
    table.cell(dash, 2, 8, str.tostring(trend_distance, "#.#") + "%", text_color=trend_col, text_size=size.small)

//───────────────────────────────────────────────────────────────────────────────
// EXPORT PLOTS (for strategy integration)
//───────────────────────────────────────────────────────────────────────────────

plot(smooth_bias, "Aggregate Bias Export", display=display.none)
plot(float(bias_state), "Bias State Export", display=display.none)
plot(float(alignment_score), "Alignment Score Export", display=display.none)
plot(float(alignment_direction), "Alignment Direction Export", display=display.none)
plot(confluence_quality, "Confluence Quality Export", display=display.none)
plot(bias_momentum, "Bias Momentum Export", display=display.none)
plot(momentum_confirming ? 1 : 0, "Momentum Confirming Export", display=display.none)
plot(bias_current, "Current TF Bias Export", display=display.none)
plot(trend_adjusted_bias, "Trend Adjusted Bias Export", display=display.none)
plot(conviction_score, "Conviction Score Export", display=display.none)
plot(bias_consistency, "Bias Consistency Export", display=display.none)
plot(bias_accel, "Bias Acceleration Export", display=display.none)
plot(trend_distance, "Trend Distance Export", display=display.none)

//───────────────────────────────────────────────────────────────────────────────
// ALERTS
//───────────────────────────────────────────────────────────────────────────────

alertcondition(bias_state == 2 and bias_state[1] != 2, "Strong Bullish Bias", "Strong bullish bias detected")
alertcondition(bias_state == -2 and bias_state[1] != -2, "Strong Bearish Bias", "Strong bearish bias detected")
alertcondition(perfect_bullish and not perfect_bullish[1], "Perfect Bull Alignment", "All timeframes aligned bullish")
alertcondition(perfect_bearish and not perfect_bearish[1], "Perfect Bear Alignment", "All timeframes aligned bearish")
alertcondition(ta.cross(smooth_bias, 0.0), "Bias Cross Zero", "Aggregate bias crossed zero")
