//@version=5
indicator("Session & FVG Untapped", overlay=true, max_lines_count=500, max_boxes_count=500)

// --- Inputs: Session Settings ---
grp_sess = "Session Settings (UTC)"
// Definimos las sesiones como strings para mayor precisión (HHMM-HHMM)
asiaSessInput = input.session("1800-0100", title="Asia Session", group=grp_sess)
lonSessInput  = input.session("0200-0500", title="London Session", group=grp_sess)
nySessInput   = input.session("0800-1100", title="NY Session", group=grp_sess)

asiaColor = input.color(#ff4d4d, title="Asia Color", group=grp_sess)
lonColor  = input.color(#4dff4d, title="London Color", group=grp_sess)
nyColor   = input.color(#4da6ff, title="NY Color", group=grp_sess)

sessLineWidth = input.int(1, title="Session Line Width", minval=1, maxval=5, group=grp_sess)

// --- Inputs: FVG Settings ---
grp_fvg = "FVG Settings"
fvgMinSize   = input.float(0.5, title="FVG Min Size (Points/Ticks)", group=grp_fvg)
fvgMaxSize   = input.float(20.0, title="FVG Max Size", group=grp_fvg)
bullFvgColor = input.color(color.new(#00ff99, 85), title="Bullish FVG Color", group=grp_fvg)
bearFvgColor = input.color(color.new(#ff3399, 85), title="Bearish FVG Color", group=grp_fvg)

// --- Helper Functions ---
inSession(sess) => not na(time(timeframe.period, sess, "UTC"))

// --- State and Arrays ---
var line[] activeHighLines = array.new_line()
var line[] activeLowLines  = array.new_line()
var box[]  activeBullFvgs  = array.new_box()
var box[]  activeBearFvgs  = array.new_box()

// Función para procesar la lógica de cada sesión
processSession(sessionStr, sessColor) =>
    bool isIn = inSession(sessionStr)
    bool isNew = isIn and not isIn[1]
    bool isEnd = not isIn and isIn[1]
    
    var float sHigh = na
    var float sLow  = na
    var int sStartIdx = na

    if isNew
        sHigh := high
        sLow  := low
        sStartIdx := bar_index
    else if isIn
        sHigh := math.max(sHigh, high)
        sLow  := math.min(sLow, low)
    
    if isEnd
        array.push(activeHighLines, line.new(sStartIdx, sHigh, bar_index, sHigh, color=sessColor, width=sessLineWidth))
        array.push(activeLowLines, line.new(sStartIdx, sLow, bar_index, sLow, color=sessColor, width=sessLineWidth))

// Ejecutar para cada sesión
processSession(asiaSessInput, asiaColor)
processSession(lonSessInput, lonColor)
processSession(nySessInput, nyColor)

// =========================================================================
// 1. MITIGATION LOGIC (Lines)
// =========================================================================
if array.size(activeHighLines) > 0
    for i = array.size(activeHighLines) - 1 to 0
        l = array.get(activeHighLines, i)
        lvl = line.get_y1(l)
        if high >= lvl 
            line.delete(l)
            array.remove(activeHighLines, i)
        else
            line.set_x2(l, bar_index)

if array.size(activeLowLines) > 0
    for i = array.size(activeLowLines) - 1 to 0
        l = array.get(activeLowLines, i)
        lvl = line.get_y1(l)
        if low <= lvl 
            line.delete(l)
            array.remove(activeLowLines, i)
        else
            line.set_x2(l, bar_index)

// =========================================================================
// 2. FVG LOGIC
// =========================================================================
prevHigh = high[2]
prevLow  = low[2]
nextHigh = high[0]
nextLow  = low[0]

bullGapSize = nextLow - prevHigh
isBullFvg = (prevHigh < nextLow) and (bullGapSize >= fvgMinSize) and (bullGapSize <= fvgMaxSize)

bearGapSize = prevLow - nextHigh
isBearFvg = (prevLow > nextHigh) and (bearGapSize >= fvgMinSize) and (bearGapSize <= fvgMaxSize)

if isBullFvg
    array.push(activeBullFvgs, box.new(bar_index[2], nextLow, bar_index, prevHigh, border_color=na, bgcolor=bullFvgColor))

if isBearFvg
    array.push(activeBearFvgs, box.new(bar_index[2], prevLow, bar_index, nextHigh, border_color=na, bgcolor=bearFvgColor))

// Mitigation FVG
if array.size(activeBullFvgs) > 0
    for i = array.size(activeBullFvgs) - 1 to 0
        b = array.get(activeBullFvgs, i)
        if low <= box.get_bottom(b)
            box.delete(b)
            array.remove(activeBullFvgs, i)
        else
            box.set_right(b, bar_index)

if array.size(activeBearFvgs) > 0
    for i = array.size(activeBearFvgs) - 1 to 0
        b = array.get(activeBearFvgs, i)
        if high >= box.get_top(b)
            box.delete(b)
            array.remove(activeBearFvgs, i)
        else
            box.set_right(b, bar_index)
