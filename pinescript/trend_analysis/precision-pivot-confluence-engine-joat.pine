//@version=6
indicator("Precision Pivot Confluence Engine [JOAT]", shorttitle="PPC [JOAT]", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ────────────────────────────────────────────────────────────────────────────────
// INPUTS
// ────────────────────────────────────────────────────────────────────────────────

// Theme
themeGroup = "Theme & Display"
colorScheme = input.string("Professional Dark", "Color Scheme", options=["Professional Dark", "Institutional Blue", "Trader Green", "Custom"], group=themeGroup)

// CPR Settings
cprGroup = "CPR Settings"
showDailyCPR = input.bool(true, "Show Daily CPR", group=cprGroup)
showWeeklyCPR = input.bool(true, "Show Weekly CPR", group=cprGroup)
showPDHL = input.bool(true, "Show Previous Day High/Low", group=cprGroup)

// Volume Analysis
volGroup = "Volume Analysis"
volMaLength = input.int(20, "Volume MA Length", minval=1, group=volGroup)
volThreshold = input.float(1.5, "High Volume Threshold", minval=1.0, step=0.1, group=volGroup)

// Divergence Detection
divGroup = "Divergence Detection"
rsiLength = input.int(14, "RSI Length", minval=2, group=divGroup)
pivotLookback = input.int(5, "Pivot Lookback", minval=1, group=divGroup)
showDivergence = input.bool(true, "Show Divergences", group=divGroup)

// Smart Money Concepts
smcGroup = "Smart Money Concepts"
showLiquiditySweeps = input.bool(true, "Show Liquidity Sweeps", group=smcGroup)
showFVG = input.bool(true, "Show Fair Value Gaps", group=smcGroup)
fvgThreshold = input.float(0.5, "FVG Threshold %", minval=0.1, step=0.1, group=smcGroup)
showOrderBlocks = input.bool(true, "Show Order Blocks", group=smcGroup)
obStrength = input.float(0.3, "Order Block Strength %", minval=0.1, step=0.1, group=smcGroup)

// Advanced Settings
advGroup = "Advanced Settings"
showMonthlyCPR = input.bool(false, "Show Monthly CPR", group=advGroup)
showCPRWidth = input.bool(true, "Show CPR Width Analysis", group=advGroup)
showVolumeProfile = input.bool(true, "Show Volume Profile Zones", group=advGroup)
enableSmartAlerts = input.bool(true, "Enable Smart Confluence Alerts", group=advGroup)

// ────────────────────────────────────────────────────────────────────────────────
// COLOR SCHEME DEFINITIONS
// ────────────────────────────────────────────────────────────────────────────────

var color pivotColor = na
var color tcColor = na
var color bcColor = na
var color supportColor = na
var color resistColor = na
var color pdhColor = na
var color pdlColor = na
var color bullVolColor = na
var color bearVolColor = na
var color fvgBullColor = na
var color fvgBearColor = na

if colorScheme == "Professional Dark"
    pivotColor := color.rgb(255, 215, 0)      // Gold
    tcColor := color.rgb(100, 181, 246)       // Light Blue
    bcColor := color.rgb(100, 181, 246)       // Light Blue
    supportColor := color.rgb(102, 187, 106)  // Green
    resistColor := color.rgb(239, 83, 80)     // Red
    pdhColor := color.rgb(171, 71, 188)       // Purple
    pdlColor := color.rgb(255, 167, 38)       // Orange
    bullVolColor := color.rgb(76, 175, 80)    // Green
    bearVolColor := color.rgb(244, 67, 54)    // Red
    fvgBullColor := color.rgb(129, 199, 132)  // Light Green
    fvgBearColor := color.rgb(229, 115, 115)  // Light Red
else if colorScheme == "Institutional Blue"
    pivotColor := color.rgb(33, 150, 243)
    tcColor := color.rgb(100, 181, 246)
    bcColor := color.rgb(100, 181, 246)
    supportColor := color.rgb(38, 198, 218)
    resistColor := color.rgb(255, 82, 82)
    pdhColor := color.rgb(63, 81, 181)
    pdlColor := color.rgb(255, 152, 0)
    bullVolColor := color.rgb(0, 188, 212)
    bearVolColor := color.rgb(255, 87, 34)
    fvgBullColor := color.rgb(128, 222, 234)
    fvgBearColor := color.rgb(255, 138, 101)
else if colorScheme == "Trader Green"
    pivotColor := color.rgb(255, 235, 59)
    tcColor := color.rgb(156, 204, 101)
    bcColor := color.rgb(156, 204, 101)
    supportColor := color.rgb(102, 187, 106)
    resistColor := color.rgb(239, 83, 80)
    pdhColor := color.rgb(0, 150, 136)
    pdlColor := color.rgb(255, 193, 7)
    bullVolColor := color.rgb(139, 195, 74)
    bearVolColor := color.rgb(244, 67, 54)
    fvgBullColor := color.rgb(165, 214, 167)
    fvgBearColor := color.rgb(239, 154, 154)

// ────────────────────────────────────────────────────────────────────────────────
// CPR CALCULATIONS
// ────────────────────────────────────────────────────────────────────────────────

calcCPR(h, l, c) =>
    pivot = (h + l + c) / 3
    bc = (h + l) / 2
    tc = (pivot - bc) + pivot
    [pivot, bc, tc]

calcSR(pivot, h, l) =>
    s1 = (pivot * 2) - h
    r1 = (pivot * 2) - l
    [s1, r1]

// Daily CPR
dHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
dLow = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
dClose = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
[dPivot, dBC, dTC] = calcCPR(dHigh, dLow, dClose)
[dS1, dR1] = calcSR(dPivot, dHigh, dLow)

// Weekly CPR
wHigh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_on)
wLow = request.security(syminfo.tickerid, "W", low[1], lookahead=barmerge.lookahead_on)
wClose = request.security(syminfo.tickerid, "W", close[1], lookahead=barmerge.lookahead_on)
[wPivot, wBC, wTC] = calcCPR(wHigh, wLow, wClose)

// Monthly CPR
mHigh = request.security(syminfo.tickerid, "M", high[1], lookahead=barmerge.lookahead_on)
mLow = request.security(syminfo.tickerid, "M", low[1], lookahead=barmerge.lookahead_on)
mClose = request.security(syminfo.tickerid, "M", close[1], lookahead=barmerge.lookahead_on)
[mPivot, mBC, mTC] = calcCPR(mHigh, mLow, mClose)

// CPR Width Analysis (Narrow = Breakout potential, Wide = Range-bound)
cprWidth = math.abs(dTC - dBC)
avgCPRWidth = ta.sma(cprWidth, 20)
cprNarrow = cprWidth < avgCPRWidth * 0.7
cprWide = cprWidth > avgCPRWidth * 1.3

// Previous Day High/Low
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)

// ────────────────────────────────────────────────────────────────────────────────
// VOLUME ANALYSIS
// ────────────────────────────────────────────────────────────────────────────────

volMA = ta.sma(volume, volMaLength)
isHighVol = volume > volMA * volThreshold
isBullishBar = close > open
isBearishBar = close < open

// Advanced Volume Analysis
volDelta = volume - volMA
volMomentum = ta.change(volume, 3)
climaxVolume = volume > volMA * 2.5

// Volume-weighted color with gradient
volIntensity = math.min(100, (volume / volMA - 1) * 50)
volColor = isHighVol and isBullishBar ? color.from_gradient(volIntensity, 0, 100, color.new(bullVolColor, 70), bullVolColor) : 
           isHighVol and isBearishBar ? color.from_gradient(volIntensity, 0, 100, color.new(bearVolColor, 70), bearVolColor) : 
           color.new(color.gray, 70)

// Volume Profile Zones (High Volume Nodes)
var array<float> volProfilePrices = array.new<float>()
var array<float> volProfileVolumes = array.new<float>()

if showVolumeProfile and bar_index % 10 == 0
    priceLevel = math.round(close / syminfo.mintick) * syminfo.mintick
    volIndex = array.indexof(volProfilePrices, priceLevel)
    
    if volIndex >= 0
        currentVol = array.get(volProfileVolumes, volIndex)
        array.set(volProfileVolumes, volIndex, currentVol + volume)
    else if array.size(volProfilePrices) < 50
        array.push(volProfilePrices, priceLevel)
        array.push(volProfileVolumes, volume)

// ────────────────────────────────────────────────────────────────────────────────
// RSI DIVERGENCE DETECTION
// ────────────────────────────────────────────────────────────────────────────────

rsi = ta.rsi(close, rsiLength)
pivotHigh = ta.pivothigh(rsi, pivotLookback, pivotLookback)
pivotLow = ta.pivotlow(rsi, pivotLookback, pivotLookback)

var float lastPivotHighRSI = na
var float lastPivotHighPrice = na
var int lastPivotHighBar = na

var float lastPivotLowRSI = na
var float lastPivotLowPrice = na
var int lastPivotLowBar = na

// Divergence boolean variables
bearishDivergence = false
bullishDivergence = false

// Track last divergence label to prevent overlap
var int lastDivLabelBar = 0
int minBarsBetweenDivLabels = 15

// Bearish Divergence Detection
if not na(pivotHigh)
    currentHighPrice = high[pivotLookback]
    currentHighRSI = rsi[pivotLookback]
    
    if not na(lastPivotHighPrice)
        if currentHighPrice > lastPivotHighPrice and currentHighRSI < lastPivotHighRSI
            bearishDivergence := true
            if showDivergence and (bar_index - lastDivLabelBar) >= minBarsBetweenDivLabels
                line.new(lastPivotHighBar, lastPivotHighPrice, bar_index - pivotLookback, currentHighPrice, 
                         color=color.new(resistColor, 0), width=2, style=line.style_dashed)
                label.new(bar_index - pivotLookback, currentHighPrice, "Bear Div", 
                         style=label.style_label_down, color=resistColor, textcolor=color.white, size=size.small)
                lastDivLabelBar := bar_index
    
    lastPivotHighRSI := currentHighRSI
    lastPivotHighPrice := currentHighPrice
    lastPivotHighBar := bar_index - pivotLookback

// Bullish Divergence Detection
if not na(pivotLow)
    currentLowPrice = low[pivotLookback]
    currentLowRSI = rsi[pivotLookback]
    
    if not na(lastPivotLowPrice)
        if currentLowPrice < lastPivotLowPrice and currentLowRSI > lastPivotLowRSI
            bullishDivergence := true
            if showDivergence and (bar_index - lastDivLabelBar) >= minBarsBetweenDivLabels
                line.new(lastPivotLowBar, lastPivotLowPrice, bar_index - pivotLookback, currentLowPrice, 
                         color=color.new(supportColor, 0), width=2, style=line.style_dashed)
                label.new(bar_index - pivotLookback, currentLowPrice, "Bull Div", 
                         style=label.style_label_up, color=supportColor, textcolor=color.white, size=size.small)
                lastDivLabelBar := bar_index
    
    lastPivotLowRSI := currentLowRSI
    lastPivotLowPrice := currentLowPrice
    lastPivotLowBar := bar_index - pivotLookback

// ────────────────────────────────────────────────────────────────────────────────
// FAIR VALUE GAPS (FVG) - LIMITED TO PREVENT CLUTTER
// ────────────────────────────────────────────────────────────────────────────────

bullishFVG = low > high[2] and close[1] > high[2]
bearishFVG = high < low[2] and close[1] < low[2]

fvgSize = math.abs(close - close[2]) / close * 100

// Only show significant FVGs and limit the number on chart
var int fvgCount = 0
int maxFVGsOnChart = 5

if bullishFVG and fvgSize > fvgThreshold and showFVG and fvgCount < maxFVGsOnChart
    box.new(bar_index - 2, high[2], bar_index + 15, low, 
            border_color=color.new(fvgBullColor, 50), 
            bgcolor=color.new(fvgBullColor, 90),
            border_width=1)
    fvgCount += 1

if bearishFVG and fvgSize > fvgThreshold and showFVG and fvgCount < maxFVGsOnChart
    box.new(bar_index - 2, low[2], bar_index + 15, high, 
            border_color=color.new(fvgBearColor, 50), 
            bgcolor=color.new(fvgBearColor, 90),
            border_width=1)
    fvgCount += 1

// Reset counter periodically
if bar_index % 50 == 0
    fvgCount := 0

// ────────────────────────────────────────────────────────────────────────────────
// LIQUIDITY SWEEPS (WITH ANTI-OVERLAP LOGIC)
// ────────────────────────────────────────────────────────────────────────────────

lookbackBars = 20
recentHigh = ta.highest(high, lookbackBars)
recentLow = ta.lowest(low, lookbackBars)

liquiditySweepHigh = high > recentHigh[1] and close < recentHigh[1]
liquiditySweepLow = low < recentLow[1] and close > recentLow[1]

// Enhanced liquidity detection with volume confirmation
strongLiqSweepHigh = liquiditySweepHigh and isHighVol
strongLiqSweepLow = liquiditySweepLow and isHighVol

// Track last liquidity label to prevent overlap
var int lastLiqLabelBar = 0
int minBarsBetweenLiqLabels = 10

if liquiditySweepHigh and showLiquiditySweeps and (bar_index - lastLiqLabelBar) >= minBarsBetweenLiqLabels
    label.new(bar_index, high, strongLiqSweepHigh ? "STRONG LIQ" : "Liq", 
             style=label.style_label_down, color=color.new(resistColor, strongLiqSweepHigh ? 0 : 30), 
             textcolor=color.white, size=strongLiqSweepHigh ? size.small : size.tiny,
             yloc=yloc.abovebar)
    lastLiqLabelBar := bar_index

if liquiditySweepLow and showLiquiditySweeps and (bar_index - lastLiqLabelBar) >= minBarsBetweenLiqLabels
    label.new(bar_index, low, strongLiqSweepLow ? "STRONG LIQ" : "Liq", 
             style=label.style_label_up, color=color.new(supportColor, strongLiqSweepLow ? 0 : 30), 
             textcolor=color.white, size=strongLiqSweepLow ? size.small : size.tiny,
             yloc=yloc.belowbar)
    lastLiqLabelBar := bar_index

// ────────────────────────────────────────────────────────────────────────────────
// ORDER BLOCKS (LIMITED DISPLAY)
// ────────────────────────────────────────────────────────────────────────────────

// Bullish Order Block: Strong bearish candles followed by bullish reversal
isBullishOB = close[2] < open[2] and close[1] < open[1] and close > open and 
              (close - low[1]) / low[1] * 100 > obStrength

// Bearish Order Block: Strong bullish candles followed by bearish reversal  
isBearishOB = close[2] > open[2] and close[1] > open[1] and close < open and 
              (high[1] - close) / close * 100 > obStrength

// Track order blocks to limit display
var int obCount = 0
int maxOBsOnChart = 5

if showOrderBlocks and isBullishOB and obCount < maxOBsOnChart
    box.new(bar_index - 1, low[1], bar_index + 20, high[1],
            border_color=color.new(supportColor, 40),
            bgcolor=color.new(supportColor, 92),
            border_width=2,
            text="OB",
            text_size=size.tiny)
    obCount += 1

if showOrderBlocks and isBearishOB and obCount < maxOBsOnChart
    box.new(bar_index - 1, low[1], bar_index + 20, high[1],
            border_color=color.new(resistColor, 40),
            bgcolor=color.new(resistColor, 92),
            border_width=2,
            text="OB",
            text_size=size.tiny)
    obCount += 1

// Reset counter periodically
if bar_index % 50 == 0
    obCount := 0

// ────────────────────────────────────────────────────────────────────────────────
// PLOTTING
// ────────────────────────────────────────────────────────────────────────────────

// Daily CPR with fills
dPivotPlot = plot(showDailyCPR ? dPivot : na, "Daily Pivot", pivotColor, 3, plot.style_line)
dTCPlot = plot(showDailyCPR ? dTC : na, "Daily TC", tcColor, 2, plot.style_circles)
dBCPlot = plot(showDailyCPR ? dBC : na, "Daily BC", bcColor, 2, plot.style_circles)

// CPR Zone Fill
fill(dTCPlot, dBCPlot, color.new(tcColor, 92), title="CPR Zone")

// Support/Resistance
plot(showDailyCPR ? dS1 : na, "Daily S1", supportColor, 2, plot.style_stepline)
plot(showDailyCPR ? dR1 : na, "Daily R1", resistColor, 2, plot.style_stepline)

// Weekly CPR
plot(showWeeklyCPR ? wPivot : na, "Weekly Pivot", color.new(pivotColor, 30), 3, plot.style_cross)
plot(showWeeklyCPR ? wTC : na, "Weekly TC", color.new(tcColor, 40), 2)
plot(showWeeklyCPR ? wBC : na, "Weekly BC", color.new(bcColor, 40), 2)

// Monthly CPR
plot(showMonthlyCPR ? mPivot : na, "Monthly Pivot", color.new(pivotColor, 50), 2, plot.style_stepline_diamond)
plot(showMonthlyCPR ? mTC : na, "Monthly TC", color.new(tcColor, 60), 1)
plot(showMonthlyCPR ? mBC : na, "Monthly BC", color.new(bcColor, 60), 1)

// PDH/PDL
plot(showPDHL ? pdh : na, "PDH", pdhColor, 3, plot.style_stepline)
plot(showPDHL ? pdl : na, "PDL", pdlColor, 3, plot.style_stepline)

// CPR Width Indicator (Background)
bgcolor(showCPRWidth and cprNarrow ? color.new(color.yellow, 95) : na, title="Narrow CPR")
bgcolor(showCPRWidth and cprWide ? color.new(color.purple, 95) : na, title="Wide CPR")

// Volume coloring with gradient
barcolor(volColor, title="Volume Color")

// ────────────────────────────────────────────────────────────────────────────────
// INFORMATION TABLE
// ────────────────────────────────────────────────────────────────────────────────

var table infoTable = table.new(position.top_right, 3, 9, 
                                 bgcolor=color.new(color.black, 85), 
                                 frame_color=color.new(color.gray, 50), 
                                 frame_width=1, 
                                 border_width=1, 
                                 border_color=color.new(color.gray, 50))

if barstate.islast
    // Header
    table.cell(infoTable, 0, 0, "Level", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, "Price", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 0, "Dist %", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.small)
    
    // Daily Pivot
    table.cell(infoTable, 0, 1, "D Pivot", text_color=pivotColor, text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(dPivot, format.mintick), text_color=color.white, text_size=size.small)
    distPivot = (close - dPivot) / dPivot * 100
    table.cell(infoTable, 2, 1, str.tostring(distPivot, "#.##") + "%", 
               text_color=distPivot > 0 ? supportColor : resistColor, text_size=size.small)
    
    // Daily R1
    table.cell(infoTable, 0, 2, "D R1", text_color=resistColor, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(dR1, format.mintick), text_color=color.white, text_size=size.small)
    distR1 = (close - dR1) / dR1 * 100
    table.cell(infoTable, 2, 2, str.tostring(distR1, "#.##") + "%", 
               text_color=distR1 > 0 ? supportColor : resistColor, text_size=size.small)
    
    // Daily S1
    table.cell(infoTable, 0, 3, "D S1", text_color=supportColor, text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(dS1, format.mintick), text_color=color.white, text_size=size.small)
    distS1 = (close - dS1) / dS1 * 100
    table.cell(infoTable, 2, 3, str.tostring(distS1, "#.##") + "%", 
               text_color=distS1 > 0 ? supportColor : resistColor, text_size=size.small)
    
    // PDH
    table.cell(infoTable, 0, 4, "PDH", text_color=pdhColor, text_size=size.small)
    table.cell(infoTable, 1, 4, str.tostring(pdh, format.mintick), text_color=color.white, text_size=size.small)
    distPDH = (close - pdh) / pdh * 100
    table.cell(infoTable, 2, 4, str.tostring(distPDH, "#.##") + "%", 
               text_color=distPDH > 0 ? supportColor : resistColor, text_size=size.small)
    
    // PDL
    table.cell(infoTable, 0, 5, "PDL", text_color=pdlColor, text_size=size.small)
    table.cell(infoTable, 1, 5, str.tostring(pdl, format.mintick), text_color=color.white, text_size=size.small)
    distPDL = (close - pdl) / pdl * 100
    table.cell(infoTable, 2, 5, str.tostring(distPDL, "#.##") + "%", 
               text_color=distPDL > 0 ? supportColor : resistColor, text_size=size.small)
    
    // CPR Width Analysis
    table.cell(infoTable, 0, 6, "CPR Width", text_color=color.white, text_size=size.small)
    cprWidthText = cprNarrow ? "NARROW" : cprWide ? "WIDE" : "NORMAL"
    cprWidthColor = cprNarrow ? color.new(color.yellow, 30) : cprWide ? color.new(color.purple, 30) : color.new(color.gray, 70)
    table.cell(infoTable, 1, 6, cprWidthText, bgcolor=cprWidthColor, text_color=color.white, text_size=size.small)
    table.merge_cells(infoTable, 1, 6, 2, 6)
    
    // Volume Status
    table.cell(infoTable, 0, 7, "Volume", text_color=color.white, text_size=size.small)
    volStatus = climaxVolume ? "CLIMAX" : isHighVol ? "HIGH" : "NORMAL"
    volStatusColor = climaxVolume ? color.new(color.orange, 20) : isHighVol ? color.new(color.yellow, 30) : color.new(color.gray, 70)
    table.cell(infoTable, 1, 7, volStatus, bgcolor=volStatusColor, text_color=color.white, text_size=size.small)
    table.merge_cells(infoTable, 1, 7, 2, 7)
    
    // RSI
    table.cell(infoTable, 0, 8, "RSI", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 8, str.tostring(rsi, "#.#"), text_color=color.white, text_size=size.small)
    rsiStatus = rsi > 70 ? "OB" : rsi < 30 ? "OS" : "NEU"
    rsiColor = rsi > 70 ? color.new(resistColor, 30) : rsi < 30 ? color.new(supportColor, 30) : color.new(color.gray, 70)
    table.cell(infoTable, 2, 8, rsiStatus, bgcolor=rsiColor, text_color=color.white, text_size=size.small)

// ────────────────────────────────────────────────────────────────────────────────
// ALERTS
// ────────────────────────────────────────────────────────────────────────────────

// Basic CPR Alerts
alertcondition(ta.crossover(close, dPivot), "Price Above Daily Pivot", "Price crossed above Daily Pivot")
alertcondition(ta.crossunder(close, dPivot), "Price Below Daily Pivot", "Price crossed below Daily Pivot")

// Liquidity Alerts
alertcondition(liquiditySweepHigh, "Liquidity Sweep High", "Liquidity sweep detected at highs")
alertcondition(liquiditySweepLow, "Liquidity Sweep Low", "Liquidity sweep detected at lows")
alertcondition(strongLiqSweepHigh, "STRONG Liquidity Sweep High", "Strong liquidity sweep with high volume at highs")
alertcondition(strongLiqSweepLow, "STRONG Liquidity Sweep Low", "Strong liquidity sweep with high volume at lows")

// FVG Alerts
alertcondition(bullishFVG and fvgSize > fvgThreshold, "Bullish FVG", "Bullish Fair Value Gap detected")
alertcondition(bearishFVG and fvgSize > fvgThreshold, "Bearish FVG", "Bearish Fair Value Gap detected")

// Order Block Alerts
alertcondition(isBullishOB, "Bullish Order Block", "Bullish Order Block formed")
alertcondition(isBearishOB, "Bearish Order Block", "Bearish Order Block formed")

// CPR Width Alerts
alertcondition(cprNarrow and not cprNarrow[1], "Narrow CPR", "CPR narrowing - potential breakout setup")
alertcondition(cprWide and not cprWide[1], "Wide CPR", "CPR widening - range-bound conditions")

// Volume Alerts
alertcondition(climaxVolume, "Climax Volume", "Climax volume detected - potential reversal")

// Confluence Alerts (Multiple signals)
confluenceBullish = bullishDivergence and bullishFVG and close > dPivot
confluenceBearish = bearishDivergence and bearishFVG and close < dPivot

alertcondition(enableSmartAlerts and confluenceBullish, "BULLISH CONFLUENCE", "Multiple bullish signals aligned")
alertcondition(enableSmartAlerts and confluenceBearish, "BEARISH CONFLUENCE", "Multiple bearish signals aligned")
