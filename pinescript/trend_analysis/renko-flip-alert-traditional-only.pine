//@version=6
indicator("Renko Flip Alert", overlay=true)

// Current + previous brick direction
isBull = close > open
isBear = close < open

wasBull = close[1] > open[1]
wasBear = close[1] < open[1]

// Flip on confirmed close
bullFlip = barstate.isconfirmed and isBull and wasBear
bearFlip = barstate.isconfirmed and isBear and wasBull

// Minimal markers
plotshape(bullFlip, title="Bull Flip", style=shape.triangleup, location=location.belowbar, size=size.small, color=color.blue)
plotshape(bearFlip, title="Bear Flip", style=shape.triangledown, location=location.abovebar, size=size.small, color=color.red)
// Alerts
alertcondition(bullFlip, title="Bullish Renko Flip", message="Bullish Renko flip on {{ticker}} @ {{close}}")
alertcondition(bearFlip, title="Bearish Renko Flip", message="Bearish Renko flip on {{ticker}} @ {{close}}")
