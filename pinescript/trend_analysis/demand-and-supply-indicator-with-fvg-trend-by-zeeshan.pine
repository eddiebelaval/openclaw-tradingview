//@version=5
indicator("Minimal ND/NS + POSSIBLE by Body", overlay=true, max_labels_count=500)

// Inputs
thinBodyPct = input.float(0.6, "Thin body < prev body ×", step=0.01)
minVol      = input.float(1.0, "Min volume", step=1)
showPossible = input.bool(true, "Show POSSIBLE flags")

// Body (ignore wicks) and volume check
b = math.abs(close - open)
baselineLen = input.int(5, "Baseline body length", minval=1)
baseline_body = ta.median(math.abs(close[1] - open[1]), baselineLen)
thin_b = baseline_body > 0 ? b < baseline_body * thinBodyPct : b == 0

low_vol = volume >= minVol and volume < volume[1] and volume < volume[2]

// Direction
up = close >= close[1]
dn = close <= close[1]

// temporary debug label (paste after thin_b and dn)
//if barstate.islast or true
//   label.new(bar_index, high, "b:"+str.tostring(b)+" base:"+str.tostring(baseline_body)+" thin?"+(thin_b?"1":"0")+" dn?"+(dn?"1":"0"), style=label.style_label_left, color=color.new(color.black,0), textcolor=color.white, size=size.tiny)

oppWickFactor = input.float(1.0, "Max opposing wick ≤ body ×", step=0.05)
// opposing wick (relative to bar direction)
upper_wick = high - math.max(open, close)
lower_wick = math.min(open, close) - low
opposing_wick = up ? upper_wick : lower_wick
long_opposing = opposing_wick > b * oppWickFactor

// Signals (disallow very long opposing wick for final ND/NS)
nd = up and thin_b and low_vol and not long_opposing
ns = dn and thin_b and low_vol and not long_opposing


// POSSIBLE when only thin body holds (volume condition not met)
p_nd = showPossible and up and thin_b and not nd
p_ns = showPossible and dn and thin_b and not ns 
// volume direction
vol_up = close > open
vol_dn = close < open

volSmaLen = input.int(20, "Volume SMA Length for POSSIBLE vol", minval=1)
volSma_possible = ta.sma(volume, volSmaLen)

// Very low volume only flags (no other checks)
veryLowVolFactor = input.float(0.6, "Very low vol < SMA ×", step=0.05)
veryLowVolFlag = volume >= minVol and volume < ta.sma(volume, volSmaLen) * veryLowVolFactor

p_vol_only_nd = showPossible and up and veryLowVolFlag and vol_up
p_vol_only_ns = showPossible and dn and veryLowVolFlag and vol_dn

// previous-10 low check (exclude current bar)
prev10_low = ta.lowest(volume[1], 10)
isLowestPrev10 = volume < prev10_low


// scale offset by current bar range (works across timeframes)
barRange = high - low
offsetPct = 0.3 // 2% of bar range; tweak smaller on 1m if needed

// draw pure-volume POSSIBLE labels only if not already labeled by other logic
if p_vol_only_nd and not nd
    y = high + barRange * offsetPct
    label.new(bar_index, y, isLowestPrev10 ? "Weakest Demand" : "Weak Demand", style=label.style_label_down, color=color.new(color.gray, 50), textcolor=color.white, size=size.tiny)
if p_vol_only_ns and not ns
    y = low - barRange * offsetPct
    label.new(bar_index, y, isLowestPrev10 ? "Weakest Supply" : "Weak Supply", style=label.style_label_up, color=color.new(color.gray, 50), textcolor=color.white, size=size.tiny)

// Labels
if nd
    label.new(bar_index, high, "No Demand", style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
if ns
    label.new(bar_index, low, "No Supply", style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.small)
if p_nd
    label.new(bar_index, high, "Low Demand", style=label.style_label_down, color=color.new(color.red, 50), textcolor=color.white, size=size.tiny)
if p_ns
    label.new(bar_index, low, "Low supply", style=label.style_label_up, color=color.new(color.green, 50), textcolor=color.white, size=size.tiny)


////////////////////////////////////////////////////////////////////////////////////////
//@version=5
//@version=5

// Inputs
lb = input.int(5, "Left Bars", minval=1)
rb = input.int(5, "Right Bars", minval=1)
mb = lb + rb + 1
lineOpacity = input.int(70, "Line opacity (0-255)", minval=0, maxval=255)
lineWidth = input.int(1, "Line width", minval=1, maxval=6)

// detect pivots (price at pivot is referenced at offset -lb)
isPH = not na(high[mb]) and ta.highestbars(mb) == -lb
isPL = not na(low[mb])  and ta.lowestbars(mb)  == -lb
ph_price = isPH ? high[lb] : na
pl_price = isPL ? low[lb]  : na
ph_bar   = isPH ? bar_index - lb : na
pl_bar   = isPL ? bar_index - lb : na

// store previous pivot highs/lows
var int prev_ph_bar = na
var float prev_ph_price = na
var int prev_pl_bar = na
var float prev_pl_price = na

// when a pivot high appears, draw a line from previous high to current high and label HH/LH
if isPH
    if not na(prev_ph_bar)
        col = ph_price > prev_ph_price ? color.green : color.red
        line.new(prev_ph_bar, prev_ph_price, ph_bar, ph_price, xloc=xloc.bar_index, extend=extend.none, color=color.new(col, lineOpacity), width=lineWidth)
    // determine label text and color for this pivot high
    ph_label = not na(prev_ph_price) ? (ph_price > prev_ph_price ? "HH" : "LH") : "PH"
    ph_col   = not na(prev_ph_price) ? (ph_price > prev_ph_price ? color.green : color.red) : color.yellow
    // draw dynamic text label at the pivot bar and price
    label.new(ph_bar, ph_price, ph_label, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_upper_right, color=color.new(ph_col, 50), textcolor=color.white, size=size.tiny)
    prev_ph_bar := ph_bar
    prev_ph_price := ph_price

// when a pivot low appears, draw a line from previous low to current low and label HL/LL
if isPL
    if not na(prev_pl_bar)
        col = pl_price > prev_pl_price ? color.green : color.red
        line.new(prev_pl_bar, prev_pl_price, pl_bar, pl_price, xloc=xloc.bar_index, extend=extend.none, color=color.new(col, lineOpacity), width=lineWidth)
    // determine label text and color for this pivot low
    pl_label = not na(prev_pl_price) ? (pl_price > prev_pl_price ? "HL" : "LL") : "PL"
    pl_col   = not na(prev_pl_price) ? (pl_price > prev_pl_price ? color.green : color.red) : color.yellow
    // draw dynamic text label at the pivot bar and price
    label.new(pl_bar, pl_price, pl_label, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_lower_right, color=color.new(pl_col, 50), textcolor=color.white, size=size.tiny)
    prev_pl_bar := pl_bar
    prev_pl_price := pl_price


////////////////////////////////////////////////////////////


// -------------------- Inputs --------------------
fvg_leftBars      = input.int(5, "FVG Left Bars", minval=1)
fvg_rightBars     = input.int(5, "FVG Right Bars", minval=1)
fvg_midBars       = fvg_leftBars + fvg_rightBars + 1

fvg_boxOpacityPct = input.int(63, "Box opacity % (0-100)", minval=0, maxval=100)
fvg_boxLength     = input.int(10, "Visual box length in bars (if not extending)", minval=1)
fvg_boxBorderWidth= input.int(1, "Box border width", minval=0, maxval=4)
fvg_boxHeightPadPct = input.float(0.0, "Vertical padding % of bar range", step=0.1)
fvg_autoExtend    = input.bool(true, "Extend box to the right until mitigated")
fvg_maxStoredBoxes= input.int(200, "Max stored boxes", minval=10, maxval=500)
fvg_expiryBars    = input.int(100, "FVG expiry (bars, delete if not mitigated)", minval=1)

// -------------------- Derived --------------------
fvg_transpVal = int((100 - fvg_boxOpacityPct) * 2.55)  // Pine transp (0 opaque .. 255 transparent)
fvg_range     = high - low
fvg_pad       = fvg_range * fvg_boxHeightPadPct * 0.01

// -------------------- FVG detection --------------------
// require at least 3 bars of history to reference [2]
hasEnoughHistory = bar_index >= 2
isBullFVG = hasEnoughHistory and (low > high[2])   // C.low > A.high
isBearFVG = hasEnoughHistory and (high < low[2])   // C.high < A.low

// -------------------- Arrays to track boxes --------------------
var box[]    fvg_boxes       = array.new_box()
var int[]    fvg_boxType     = array.new_int()   // 1 = bull FVG, -1 = bear FVG
var float[]  fvg_boxThresh   = array.new_float() // threshold price to consider mitigated (A.high for bull, A.low for bear)
var int[]    fvg_boxStartBar = array.new_int()   // start bar index (bar_index - 2)
var int[]    fvg_boxEndBar   = array.new_int()   // expiry bar (bar_index + fvg_expiryBars)

// helper: safely delete oldest tracked box when exceeding storage
fvg_enforce_max() =>
    if array.size(fvg_boxes) > fvg_maxStoredBoxes
        old_box = array.shift(fvg_boxes)
        array.shift(fvg_boxType)
        array.shift(fvg_boxThresh)
        array.shift(fvg_boxStartBar)
        array.shift(fvg_boxEndBar)
        if not na(old_box)
            box.delete(old_box)

// -------------------- Create and track boxes --------------------
if isBullFVG
    if not na(high[2])
        fvg_top    = high[2] + fvg_pad      // A.high + pad
        fvg_bottom = low - fvg_pad          // C.low - pad
        fvg_box_id = box.new(bar_index - 2, fvg_top, bar_index + fvg_boxLength, fvg_bottom, xloc=xloc.bar_index, border_color=color.new(color.lime, fvg_transpVal), bgcolor=color.new(color.gray, fvg_transpVal), border_width=fvg_boxBorderWidth)
        if fvg_autoExtend
            box.set_extend(fvg_box_id, extend.right)
        array.push(fvg_boxes, fvg_box_id)
        array.push(fvg_boxType, 1)
        array.push(fvg_boxThresh, high[2])
        array.push(fvg_boxStartBar, bar_index - 2)
        array.push(fvg_boxEndBar, bar_index + fvg_expiryBars)
        fvg_enforce_max()

if isBearFVG
    if not na(low[2])
        fvg_top    = high + fvg_pad         // C.high + pad
        fvg_bottom = low[2] - fvg_pad       // A.low - pad
        fvg_box_id = box.new(bar_index - 2, fvg_bottom, bar_index + fvg_boxLength, fvg_top, xloc=xloc.bar_index, border_color=color.new(color.red, fvg_transpVal), bgcolor=color.new(color.gray, fvg_transpVal), border_width=fvg_boxBorderWidth)
        if fvg_autoExtend
            box.set_extend(fvg_box_id, extend.right)
        array.push(fvg_boxes, fvg_box_id)
        array.push(fvg_boxType, -1)
        array.push(fvg_boxThresh, low[2])
        array.push(fvg_boxStartBar, bar_index - 2)
        array.push(fvg_boxEndBar, bar_index + fvg_expiryBars)
        fvg_enforce_max()

// -------------------- Check tracked boxes each bar and delete when mitigated OR expired --------------------
fvg_n = array.size(fvg_boxes)
if fvg_n > 0
    // iterate from newest to oldest by computing reverse index to allow safe removal
    for fvg_j = 0 to fvg_n - 1
        fvg_i = fvg_n - 1 - fvg_j
        // safe access because fvg_n > 0 and fvg_i in range
        fvg_box_id = array.get(fvg_boxes, fvg_i)
        fvg_t      = array.get(fvg_boxType, fvg_i)
        fvg_thresh = array.get(fvg_boxThresh, fvg_i)
        fvg_endBar = array.get(fvg_boxEndBar, fvg_i)
        fvg_mitigated = false
        if fvg_t == 1
            // bullish FVG mitigated when price trades into or below A.high
            fvg_mitigated := low <= fvg_thresh
        else
            // bearish FVG mitigated when price trades into or above A.low
            fvg_mitigated := high >= fvg_thresh
        // expired if current bar passed stored expiry bar
        fvg_expired = bar_index > fvg_endBar
        if fvg_mitigated or fvg_expired
            if not na(fvg_box_id)
                box.delete(fvg_box_id)
            array.remove(fvg_boxes, fvg_i)
            array.remove(fvg_boxType, fvg_i)
            array.remove(fvg_boxThresh, fvg_i)
            array.remove(fvg_boxStartBar, fvg_i)
            array.remove(fvg_boxEndBar, fvg_i)

// -------------------- Optional: debug counts (uncomment if needed) --------------------
//plotchar(array.size(fvg_boxes), title="FVG count", location=location.top, char='•', size=size.tiny)
