//@version=5
indicator("NAVI by Ravi Devraj Saxena (Gold RR2)", overlay=true, max_boxes_count=500, max_labels_count=500)

// ───────── SESSION ─────────
sessionIST = "0900-0100"
inSession = not na(time(timeframe.period, sessionIST, "Asia/Kolkata"))
bgcolor(inSession ? color.new(color.teal, 90) : na)

// ───────── BOLLINGER BANDS ─────────
length = 20
mult = 2.0
basis = ta.sma(close, length)
dev = mult * ta.stdev(close, length)
upper = basis + dev
lower = basis - dev  

bbPercent = (close - lower) / (upper - lower)

// ───────── CONDITIONS ─────────
isGreen = close > open
isRed = close < open
touchLower = low <= lower
touchUpper = high >= upper

// ───────── ORIGINAL SIGNALS (UNCHANGED) ─────────
buySignal = inSession and isGreen and touchLower and bbPercent > 0.05
sellSignal = inSession and isRed and touchUpper and bbPercent < 0.95

rr = 1.30
entryPad = syminfo.mintick * 5
offset = syminfo.mintick * 10

// ───────── LONG STATE (ORIGINAL) ─────────
var bool longActive = false
var float longEntry = na
var float longSL = na
var float longTGT = na
var float longRisk = na
var int longStart = na
var box longSLBox = na
var box longEntryBox = na
var box longTGTBox = na

// ───────── SHORT STATE (ORIGINAL) ─────────
var bool shortActive = false
var float shortEntry = na
var float shortSL = na
var float shortTGT = na
var float shortRisk = na
var int shortStart = na
var box shortSLBox = na
var box shortEntryBox = na
var box shortTGTBox = na

// ─────────────────────────────────────────────────────────────
// ── EXTRA TRADE LOGIC (ADDED AS SEPARATE TRADES) ─────────────
// ─────────────────────────────────────────────────────────────

// You can tweak this if needed from the code (constant for now)
minPoints = 15.0
rrExtra = 0.70

greenBody = close - open
redBody   = open - close

// Extra signals: independent of original signals
extraLongSignal  = inSession and isGreen and (greenBody >= minPoints) and touchUpper
extraShortSignal = inSession and isRed   and (redBody  >= minPoints) and touchLower

// ───────── EXTRA LONG STATE ─────────
var bool  longExtraActive = false
var float longExtraEntry = na
var float longExtraSL = na
var float longExtraTGT = na
var float longExtraRisk = na
var int   longExtraStart = na
var box   longExtraSLBox = na
var box   longExtraEntryBox = na
var box   longExtraTGTBox = na

// ───────── EXTRA SHORT STATE ─────────
var bool  shortExtraActive = false
var float shortExtraEntry = na
var float shortExtraSL = na
var float shortExtraTGT = na
var float shortExtraRisk = na
var int   shortExtraStart = na
var box   shortExtraSLBox = na
var box   shortExtraEntryBox = na
var box   shortExtraTGTBox = na

// ───────── LONG ENTRY (ORIGINAL) ─────────
if buySignal and not longActive and not shortActive
    longEntry := close
    longSL := math.min(low, lower)
    longRisk := longEntry - longSL
    longTGT := longEntry + longRisk * rr
    longStart := bar_index
    longActive := true

    longSLBox := box.new(bar_index, longSL, bar_index + 1, longEntry, bgcolor=color.new(color.red, 85), border_color=color.red)
    longEntryBox := box.new(bar_index, longEntry, bar_index + 1, longEntry + entryPad, bgcolor=color.new(color.blue, 85), border_color=color.blue)
    longTGTBox := box.new(bar_index, longEntry, bar_index + 1, longTGT, bgcolor=color.new(color.green, 85), border_color=color.green)

// ───────── SHORT ENTRY (ORIGINAL) ─────────
if sellSignal and not shortActive and not longActive
    shortEntry := close
    shortSL := math.max(high, upper)
    shortRisk := shortSL - shortEntry
    shortTGT := shortEntry - shortRisk * rr
    shortStart := bar_index
    shortActive := true

    shortSLBox := box.new(bar_index, shortEntry, bar_index + 1, shortSL, bgcolor=color.new(color.red, 85), border_color=color.red)
    shortEntryBox := box.new(bar_index, shortEntry - entryPad, bar_index + 1, shortEntry, bgcolor=color.new(color.blue, 85), border_color=color.blue)
    shortTGTBox := box.new(bar_index, shortTGT, bar_index + 1, shortEntry, bgcolor=color.new(color.green, 85), border_color=color.green)

// ───────── EXTRA LONG ENTRY (ADDED) ─────────
if extraLongSignal and not longExtraActive
    _entry = close
    _sl    = low                     // SL = same candle low
    _risk  = _entry - _sl
    if _risk > 0                     // safety guard
        longExtraEntry := _entry
        longExtraSL := _sl
        longExtraRisk := _risk
        longExtraTGT := longExtraEntry + longExtraRisk * rrExtra
        longExtraStart := bar_index
        longExtraActive := true

        // Different tint to distinguish EXTRA trade visually
        longExtraSLBox := box.new(bar_index, longExtraSL, bar_index + 1, longExtraEntry, bgcolor=color.new(color.red, 80), border_color=color.new(color.red, 0))
        longExtraEntryBox := box.new(bar_index, longExtraEntry, bar_index + 1, longExtraEntry + entryPad, bgcolor=color.new(color.blue, 80), border_color=color.new(color.blue, 0))
        longExtraTGTBox := box.new(bar_index, longExtraEntry, bar_index + 1, longExtraTGT, bgcolor=color.new(color.green, 80), border_color=color.new(color.green, 0))

// ───────── EXTRA SHORT ENTRY (ADDED) ─────────
if extraShortSignal and not shortExtraActive
    _entry = close
    _sl    = high                    // SL = same candle high
    _risk  = _sl - _entry
    if _risk > 0                     // safety guard
        shortExtraEntry := _entry
        shortExtraSL := _sl
        shortExtraRisk := _risk
        shortExtraTGT := shortExtraEntry - shortExtraRisk * rrExtra
        shortExtraStart := bar_index
        shortExtraActive := true

        shortExtraSLBox := box.new(bar_index, shortExtraEntry, bar_index + 1, shortExtraSL, bgcolor=color.new(color.red, 80), border_color=color.new(color.red, 0))
        shortExtraEntryBox := box.new(bar_index, shortExtraEntry - entryPad, bar_index + 1, shortExtraEntry, bgcolor=color.new(color.blue, 80), border_color=color.new(color.blue, 0))
        shortExtraTGTBox := box.new(bar_index, shortExtraTGT, bar_index + 1, shortExtraEntry, bgcolor=color.new(color.green, 80), border_color=color.new(color.green, 0))

// ───────── LONG MANAGEMENT (ORIGINAL) ─────────
if longActive
    box.set_right(longSLBox, bar_index + 1)
    box.set_right(longEntryBox, bar_index + 1)
    box.set_right(longTGTBox, bar_index + 1)

    if bar_index > longStart and low <= longSL
        label.new(bar_index, longSL + offset, "SL HIT\n-" + str.tostring(longRisk, format.mintick), style=label.style_label_up, textcolor=color.white, color=color.red)
        longActive := false

    else if bar_index > longStart and high >= longTGT
        label.new(bar_index, longTGT - offset, "TP HIT\n+" + str.tostring(longRisk * rr, format.mintick), style=label.style_label_down, textcolor=color.white, color=color.green)
        longActive := false

// ───────── SHORT MANAGEMENT (ORIGINAL) ─────────
if shortActive
    box.set_right(shortSLBox, bar_index + 1)
    box.set_right(shortEntryBox, bar_index + 1)
    box.set_right(shortTGTBox, bar_index + 1)

    if bar_index > shortStart and high >= shortSL
        label.new(bar_index, shortSL - offset, "SL HIT\n-" + str.tostring(shortRisk, format.mintick), style=label.style_label_down, textcolor=color.white, color=color.red)
        shortActive := false

    else if bar_index > shortStart and low <= shortTGT
        label.new(bar_index, shortTGT + offset, "TP HIT\n+" + str.tostring(shortRisk * rr, format.mintick), style=label.style_label_up, textcolor=color.white, color=color.green)
        shortActive := false

// ───────── EXTRA LONG MANAGEMENT (ADDED) ─────────
if longExtraActive
    box.set_right(longExtraSLBox, bar_index + 1)
    box.set_right(longExtraEntryBox, bar_index + 1)
    box.set_right(longExtraTGTBox, bar_index + 1)

    if bar_index > longExtraStart and low <= longExtraSL
        label.new(bar_index, longExtraSL + offset, "EXTRA SL HIT\n-" + str.tostring(longExtraRisk, format.mintick), style=label.style_label_up, textcolor=color.white, color=color.new(color.red, 0))
        longExtraActive := false
    else if bar_index > longExtraStart and high >= longExtraTGT
        label.new(bar_index, longExtraTGT - offset, "EXTRA TP HIT\n+" + str.tostring(longExtraRisk * rrExtra, format.mintick), style=label.style_label_down, textcolor=color.white, color=color.new(color.green, 0))
        longExtraActive := false

// ───────── EXTRA SHORT MANAGEMENT (ADDED) ─────────
if shortExtraActive
    box.set_right(shortExtraSLBox, bar_index + 1)
    box.set_right(shortExtraEntryBox, bar_index + 1)
    box.set_right(shortExtraTGTBox, bar_index + 1)

    if bar_index > shortExtraStart and high >= shortExtraSL
        label.new(bar_index, shortExtraSL - offset, "EXTRA SL HIT\n-" + str.tostring(shortExtraRisk, format.mintick), style=label.style_label_down, textcolor=color.white, color=color.new(color.red, 0))
        shortExtraActive := false
    else if bar_index > shortExtraStart and low <= shortExtraTGT
        label.new(bar_index, shortExtraTGT + offset, "EXTRA TP HIT\n+" + str.tostring(shortExtraRisk * rrExtra, format.mintick), style=label.style_label_up, textcolor=color.white, color=color.new(color.green, 0))
        shortExtraActive := false
