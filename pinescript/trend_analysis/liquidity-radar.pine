// Liquidity Radar v1.0 [FREE]
// A visually stunning Smart Money Concepts (SMC) indicator with innovative Liquidity Heatmap technology.

//@version=6
indicator("Liquidity Radar", "LR", overlay = true,
  max_boxes_count  = 500,
  max_lines_count  = 500,
  max_labels_count = 500)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 📐 INPUTS — Market Structure
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

group_structure = "📐 Market Structure"
i_showStructure = input.bool(true, "Show BOS / CHoCH", group = group_structure, tooltip = "Zeigt Break of Structure und Change of Character Linien an.")
i_swingAuto     = input.bool(true, "Auto Swing Lookback", group = group_structure, tooltip = "Passt die Swing-Erkennung automatisch an den Timeframe an.")
i_swingLen      = input.int(10, "Manual Swing Lookback", minval = 3, maxval = 100, group = group_structure, tooltip = "Manuelle Lookback-Periode für Swing-Erkennung (nur wenn Auto deaktiviert).")
i_bosStyle      = input.string("Dashed", "BOS Line Style", options = ["Solid", "Dashed", "Dotted"], group = group_structure)
i_chochStyle    = input.string("Solid", "CHoCH Line Style", options = ["Solid", "Dashed", "Dotted"], group = group_structure)
i_structLineW   = input.int(1, "Structure Line Width", minval = 1, maxval = 4, group = group_structure)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🔥 INPUTS — Liquidity Heatmap
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

group_liquidity = "🔥 Liquidity Heatmap"
i_showHeatmap   = input.bool(true, "Show Liquidity Heatmap", group = group_liquidity, tooltip = "Zeigt Liquiditätszonen mit thermischer Heatmap-Färbung an.")
i_heatDecay     = input.int(80, "Heatmap Decay (Bars)", minval = 10, maxval = 500, group = group_liquidity, tooltip = "Anzahl Bars bis eine Zone vollständig verblasst.")
i_heatDecayAuto = input.bool(true, "Auto Decay Period", group = group_liquidity, tooltip = "Passt die Decay-Periode automatisch an den Timeframe an.")
i_maxZones      = input.int(16, "Max Active Zones", minval = 4, maxval = 20, group = group_liquidity)
i_heatZoneWidth = input.float(0.3, "Zone Width (ATR mult)", minval = 0.05, maxval = 2.0, step = 0.05, group = group_liquidity, tooltip = "Breite der Liquidity-Zonen als ATR-Multiplikator.")
i_heatVolWeight = input.bool(true, "Volume-Weighted Intensity", group = group_liquidity, tooltip = "Zonen mit höherem Volumen werden intensiver eingefärbt.")

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 📦 INPUTS — Order Blocks
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

group_ob = "📦 Order Blocks"
i_showOB     = input.bool(true, "Show Order Blocks", group = group_ob, tooltip = "Zeigt institutionelle Order Blocks auf dem Chart an.")
i_maxOB      = input.int(4, "Max OBs per Side", minval = 1, maxval = 6, group = group_ob)
i_obMitThres = input.float(0.5, "OB Mitigation Threshold", minval = 0.0, maxval = 1.0, step = 0.1, group = group_ob, tooltip = "0 = nur Wick, 1 = voller Close durch den Block nötig für Mitigation.")

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 📊 INPUTS — Fair Value Gaps
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

group_fvg = "📊 Fair Value Gaps"
i_showFVG      = input.bool(false, "Show Fair Value Gaps", group = group_fvg, tooltip = "Zeigt 3-Kerzen Fair Value Gaps an. Standard: AUS.")
i_fvgFilter    = input.float(0.3, "Min FVG Size (ATR mult)", minval = 0.05, maxval = 2.0, step = 0.05, group = group_fvg, tooltip = "Mindestgröße der FVG als ATR-Multiplikator (Noise-Filter).")
i_maxFVG       = input.int(6, "Max Active FVGs", minval = 2, maxval = 15, group = group_fvg)
i_fvgExtend    = input.int(50, "FVG Extend (Bars)", minval = 5, maxval = 200, group = group_fvg)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🎯 INPUTS — Premium / Discount
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

group_zones = "🎯 Premium / Discount"
i_showPD     = input.bool(false, "Show Premium / Discount Zones", group = group_zones, tooltip = "Zeigt Premium/Discount-Bereiche basierend auf dem aktuellen Swing-Range. Standard: AUS.")
i_pdTransp   = input.int(92, "Zone Transparency", minval = 80, maxval = 98, group = group_zones)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 📋 INPUTS — Dashboard
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

group_dashboard = "📋 Dashboard"
i_showDash   = input.bool(true, "Show Dashboard", group = group_dashboard)
i_dashPos    = input.string("Top Right", "Dashboard Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = group_dashboard)
i_dashSize   = input.string("Small", "Dashboard Size", options = ["Tiny", "Small", "Normal"], group = group_dashboard)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🎨 INPUTS — Visual Settings
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

group_visual = "🎨 Visual Settings"
i_bullColor1 = input.color(#00e5ff, "Bullish Primary (Cyan)", group = group_visual)
i_bullColor2 = input.color(#00bfa5, "Bullish Secondary (Teal)", group = group_visual)
i_bearColor1 = input.color(#ff1744, "Bearish Primary (Red-Pink)", group = group_visual)
i_bearColor2 = input.color(#e040fb, "Bearish Secondary (Magenta)", group = group_visual)
i_neutralClr = input.color(#ffd740, "Neutral / Info (Amber)", group = group_visual)
i_showWater  = input.bool(true, "Show Watermark", group = group_visual)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🔔 INPUTS — Alerts
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

group_alerts = "🔔 Alerts"
i_alertBOS   = input.bool(true, "Alert on BOS", group = group_alerts)
i_alertCHOCH = input.bool(true, "Alert on CHoCH", group = group_alerts)
i_alertSweep = input.bool(true, "Alert on Liquidity Sweep", group = group_alerts)
i_alertOB    = input.bool(true, "Alert on OB Entry", group = group_alerts)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🛠 UTILITY FUNCTIONS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// --- Timeframe Detection ---
f_tfInMinutes() =>
    mult = timeframe.multiplier
    switch
        timeframe.isseconds => mult / 60.0
        timeframe.isminutes => mult * 1.0
        timeframe.isdaily   => mult * 1440.0
        timeframe.isweekly  => mult * 10080.0
        timeframe.ismonthly => mult * 43200.0
        => mult * 60.0  // default hourly

// --- Auto Swing Lookback based on timeframe ---
f_autoSwingLen() =>
    tfMin = f_tfInMinutes()
    if tfMin <= 5
        6
    else if tfMin <= 15
        10
    else if tfMin <= 30
        12
    else if tfMin <= 60
        15
    else if tfMin <= 240
        22
    else if tfMin <= 1440
        35
    else
        50

// --- Auto Decay Period based on timeframe ---
f_autoDecay() =>
    tfMin = f_tfInMinutes()
    if tfMin <= 5
        100
    else if tfMin <= 15
        80
    else if tfMin <= 60
        60
    else if tfMin <= 240
        50
    else if tfMin <= 1440
        40
    else
        30

// --- Asset Type Detection ---
f_isCrypto() =>
    syminfo.type == "crypto"

f_isForex() =>
    syminfo.type == "forex"

// --- Line Style Helper ---
f_lineStyle(_s) =>
    switch _s
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_dashed

// --- Dashboard Position Helper ---
f_dashPosition(_s) =>
    switch _s
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        => position.top_right

// --- Dashboard Size Helper ---
f_dashSize(_s) =>
    switch _s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        => size.small

// --- Resolved Parameters ---
swingLen  = i_swingAuto ? f_autoSwingLen() : i_swingLen
heatDecay = i_heatDecayAuto ? f_autoDecay() : i_heatDecay
atrVal    = ta.atr(14)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 📐 MARKET STRUCTURE — Swing Detection & BOS/CHoCH
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// --- Swing High / Low Detection (Pivot based, confirmed) ---
swH = ta.pivothigh(high, swingLen, swingLen)
swL = ta.pivotlow(low, swingLen, swingLen)

// Persistent tracking of swing points for structure
var float lastSwH     = na
var float lastSwL     = na
var int   lastSwHBar  = na
var int   lastSwLBar  = na
var float prevSwH     = na
var float prevSwL     = na
var int   prevSwHBar  = na
var int   prevSwLBar  = na

// Market trend state: 1 = bullish, -1 = bearish
var int   mktTrend    = 0
var int   lastSigBar  = 0

// Signal flags (reset each bar)
bossBull  = false
bossBear  = false
chochBull = false
chochBear = false

// Track structure points
if not na(swH)
    prevSwH    := lastSwH
    prevSwHBar := lastSwHBar
    lastSwH    := swH
    lastSwHBar := bar_index - swingLen

if not na(swL)
    prevSwL    := lastSwL
    prevSwLBar := lastSwLBar
    lastSwL    := swL
    lastSwLBar := bar_index - swingLen

// --- BOS / CHoCH Logic ---
// We check on every confirmed bar whether price has broken a prior swing level.
// BOS = continuation break (trend direction maintained)
// CHoCH = reversal break (trend direction changed)

// Bullish break: close above last swing high
bullBreak = not na(lastSwH) and close > lastSwH and close[1] <= lastSwH and bar_index - lastSigBar > 2
// Bearish break: close below last swing low
bearBreak = not na(lastSwL) and close < lastSwL and close[1] >= lastSwL and bar_index - lastSigBar > 2

if bullBreak
    if mktTrend == 1
        bossBull := true
    else
        chochBull := true
    mktTrend  := 1
    lastSigBar := bar_index

if bearBreak
    if mktTrend == -1
        bossBear := true
    else
        chochBear := true
    mktTrend  := -1
    lastSigBar := bar_index

// --- Draw Structure Lines & Labels ---
if i_showStructure and bossBull and not na(lastSwH)
    line.new(lastSwHBar, lastSwH, bar_index, lastSwH,
      color = i_bullColor1, style = f_lineStyle(i_bosStyle), width = i_structLineW)
    label.new(bar_index, lastSwH, "BOS ▲",
      color = color.new(i_bullColor1, 85), textcolor = i_bullColor1,
      style = label.style_label_down, size = size.tiny)

if i_showStructure and bossBear and not na(lastSwL)
    line.new(lastSwLBar, lastSwL, bar_index, lastSwL,
      color = i_bearColor1, style = f_lineStyle(i_bosStyle), width = i_structLineW)
    label.new(bar_index, lastSwL, "BOS ▼",
      color = color.new(i_bearColor1, 85), textcolor = i_bearColor1,
      style = label.style_label_up, size = size.tiny)

if i_showStructure and chochBull and not na(lastSwH)
    line.new(lastSwHBar, lastSwH, bar_index, lastSwH,
      color = i_bullColor2, style = f_lineStyle(i_chochStyle), width = i_structLineW + 1)
    label.new(bar_index, lastSwH, "CHoCH ▲",
      color = color.new(i_bullColor2, 80), textcolor = i_bullColor2,
      style = label.style_label_down, size = size.small)

if i_showStructure and chochBear and not na(lastSwL)
    line.new(lastSwLBar, lastSwL, bar_index, lastSwL,
      color = i_bearColor2, style = f_lineStyle(i_chochStyle), width = i_structLineW + 1)
    label.new(bar_index, lastSwL, "CHoCH ▼",
      color = color.new(i_bearColor2, 80), textcolor = i_bearColor2,
      style = label.style_label_up, size = size.small)

// --- Track last structure signal for dashboard ---
var string lastStructSig = "—"
var color  lastStructClr = color.gray
if bossBull
    lastStructSig := "BOS ▲"
    lastStructClr := i_bullColor1
if bossBear
    lastStructSig := "BOS ▼"
    lastStructClr := i_bearColor1
if chochBull
    lastStructSig := "CHoCH ▲"
    lastStructClr := i_bullColor2
if chochBear
    lastStructSig := "CHoCH ▼"
    lastStructClr := i_bearColor2

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🔥 LIQUIDITY HEATMAP — Zone Creation, Decay & Sweep
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// UDT for liquidity zones
type LiqZone
    box     bx
    float   priceTop
    float   priceBot
    float   level        // the swing level
    int     birthBar
    int     side         // 1 = above (swing high), -1 = below (swing low)
    float   volScore     // normalized volume intensity at creation
    bool    swept

// Persistent array of active zones
var array<LiqZone> liqZones = array.new<LiqZone>()

// Volume normalization reference
volSma  = ta.sma(volume, 20)
volNorm = volSma > 0 ? math.min(volume / volSma, 3.0) : 1.0

// --- Heatmap Color Gradient (warm → cold → transparent) ---
f_heatColor(_age, _decay, _volScore, _side) =>
    agePct = math.min(_age / math.max(_decay, 1.0), 1.0)
    // Intensity boost from volume (1.0 to 1.5)
    volBoost = i_heatVolWeight ? 0.7 + 0.3 * math.min(_volScore, 2.0) / 2.0 : 1.0
    // Base transparency: 55 (fresh) → 95 (old)
    baseTransp = 55.0 + 40.0 * agePct
    transp = math.max(baseTransp - (1.0 - volBoost) * 10.0, 40.0)
    transp := math.min(transp, 96.0)
    if _side == 1
        // Above price (swing high zones) — red/orange/yellow to blue
        color.from_gradient(agePct, 0, 1, color.new(#ff6d00, int(transp)), color.new(#4a148c, int(math.min(transp + 15, 97))))
    else
        // Below price (swing low zones) — yellow/cyan to blue
        color.from_gradient(agePct, 0, 1, color.new(#ffd600, int(transp)), color.new(#1a237e, int(math.min(transp + 15, 97))))

// --- Create new zones on confirmed swing points ---
if i_showHeatmap and not na(swH)
    zoneW = atrVal * i_heatZoneWidth
    newZone = LiqZone.new(
      bx       = box.new(bar_index - swingLen, swH + zoneW, bar_index + heatDecay, swH,
                   bgcolor = f_heatColor(0, heatDecay, volNorm, 1), border_color = color.new(#ff6d00, 70), border_width = 0),
      priceTop = swH + zoneW,
      priceBot = swH,
      level    = swH,
      birthBar = bar_index,
      side     = 1,
      volScore = volNorm,
      swept    = false)
    array.push(liqZones, newZone)

if i_showHeatmap and not na(swL)
    zoneW = atrVal * i_heatZoneWidth
    newZone = LiqZone.new(
      bx       = box.new(bar_index - swingLen, swL, bar_index + heatDecay, swL - zoneW,
                   bgcolor = f_heatColor(0, heatDecay, volNorm, -1), border_color = color.new(#ffd600, 70), border_width = 0),
      priceTop = swL,
      priceBot = swL - zoneW,
      level    = swL,
      birthBar = bar_index,
      side     = -1,
      volScore = volNorm,
      swept    = false)
    array.push(liqZones, newZone)

// --- Update, Decay & Sweep Detection ---
var bool sweepBull = false
var bool sweepBear = false
sweepBull := false
sweepBear := false

if i_showHeatmap and array.size(liqZones) > 0
    for i = array.size(liqZones) - 1 to 0
        z = array.get(liqZones, i)
        age = bar_index - z.birthBar

        // Check sweep: price wick through zone level
        isSwept = false
        if z.side == 1 and high >= z.level
            isSwept := true
            sweepBull := true
        if z.side == -1 and low <= z.level
            isSwept := true
            sweepBear := true

        // Remove if swept or expired
        if isSwept or age > heatDecay
            box.delete(z.bx)
            array.remove(liqZones, i)
        else
            // Update color with decay
            newClr = f_heatColor(age, heatDecay, z.volScore, z.side)
            box.set_bgcolor(z.bx, newClr)
            box.set_right(z.bx, bar_index + math.max(heatDecay - age, 5))

    // Enforce max zones: remove oldest if over limit
    while array.size(liqZones) > i_maxZones
        oldest = array.get(liqZones, 0)
        box.delete(oldest.bx)
        array.remove(liqZones, 0)

// --- Nearest zone tracking for dashboard ---
var float nearestZoneDist = na
var float nearestZonePrice = na
nearestZoneDist  := na
nearestZonePrice := na
if i_showHeatmap and array.size(liqZones) > 0
    minDist = 999999999.0
    for i = 0 to array.size(liqZones) - 1
        z = array.get(liqZones, i)
        dist = math.abs(close - z.level)
        if dist < minDist
            minDist := dist
            nearestZoneDist  := dist
            nearestZonePrice := z.level

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 📦 ORDER BLOCKS — Detection & Mitigation
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

type OBlock
    box     bx
    float   top
    float   bot
    int     birthBar
    int     side      // 1 = bullish, -1 = bearish
    bool    mitigated

var array<OBlock> bullOBs = array.new<OBlock>()
var array<OBlock> bearOBs = array.new<OBlock>()

// --- Bullish OB: last bearish candle before a strong bullish move (at swing low) ---
if i_showOB and not na(swL)
    // Look for the bearish candle at the swing low area
    obIdx = bar_index - swingLen
    float obHigh = high[swingLen]
    float obLow  = low[swingLen]
    // Verify it was a bearish or indecisive candle followed by bullish movement
    if close[swingLen] <= open[swingLen] or (swingLen > 1 and close[swingLen - 1] > open[swingLen - 1])
        newOB = OBlock.new(
          bx       = box.new(obIdx, obHigh, bar_index + 30, obLow,
                      bgcolor = color.new(i_bullColor2, 82), border_color = color.new(i_bullColor2, 60), border_width = 1),
          top      = obHigh,
          bot      = obLow,
          birthBar = obIdx,
          side     = 1,
          mitigated = false)
        array.push(bullOBs, newOB)
        // Enforce max
        while array.size(bullOBs) > i_maxOB
            old = array.get(bullOBs, 0)
            box.delete(old.bx)
            array.remove(bullOBs, 0)

// --- Bearish OB: last bullish candle before a strong bearish move (at swing high) ---
if i_showOB and not na(swH)
    obIdx = bar_index - swingLen
    float obHigh = high[swingLen]
    float obLow  = low[swingLen]
    if close[swingLen] >= open[swingLen] or (swingLen > 1 and close[swingLen - 1] < open[swingLen - 1])
        newOB = OBlock.new(
          bx       = box.new(obIdx, obHigh, bar_index + 30, obLow,
                      bgcolor = color.new(i_bearColor2, 82), border_color = color.new(i_bearColor2, 60), border_width = 1),
          top      = obHigh,
          bot      = obLow,
          birthBar = obIdx,
          side     = -1,
          mitigated = false)
        array.push(bearOBs, newOB)
        while array.size(bearOBs) > i_maxOB
            old = array.get(bearOBs, 0)
            box.delete(old.bx)
            array.remove(bearOBs, 0)

// --- OB Mitigation Check ---
var bool obEntryBull = false
var bool obEntryBear = false
obEntryBull := false
obEntryBear := false

// Bullish OB mitigation: price closes below the OB (threshold-based)
if i_showOB and array.size(bullOBs) > 0
    for i = array.size(bullOBs) - 1 to 0
        ob = array.get(bullOBs, i)
        // Check if price enters the OB zone (for alerts)
        if low <= ob.top and high >= ob.bot and not ob.mitigated
            obEntryBull := true
        mitLevel = ob.bot + (ob.top - ob.bot) * i_obMitThres
        if close < mitLevel and close[1] >= mitLevel
            box.delete(ob.bx)
            array.remove(bullOBs, i)
        else
            box.set_right(ob.bx, bar_index + 10)

// Bearish OB mitigation: price closes above the OB
if i_showOB and array.size(bearOBs) > 0
    for i = array.size(bearOBs) - 1 to 0
        ob = array.get(bearOBs, i)
        if high >= ob.bot and low <= ob.top and not ob.mitigated
            obEntryBear := true
        mitLevel = ob.top - (ob.top - ob.bot) * i_obMitThres
        if close > mitLevel and close[1] <= mitLevel
            box.delete(ob.bx)
            array.remove(bearOBs, i)
        else
            box.set_right(ob.bx, bar_index + 10)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 📊 FAIR VALUE GAPS — Detection & Fill Tracking
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

type FVGap
    box   bx
    float top
    float bot
    int   side     // 1 = bullish, -1 = bearish
    int   birthBar

var array<FVGap> fvgArr = array.new<FVGap>()

// --- FVG Detection (confirmed bars only to prevent repainting) ---
if i_showFVG and barstate.isconfirmed
    // Bullish FVG: low[0] > high[2] (gap between candle 0 and candle 2, with candle 1 in between)
    bullFvgTop = low[0]
    bullFvgBot = high[2]
    bullFvgSize = bullFvgTop - bullFvgBot
    if bullFvgBot < bullFvgTop and bullFvgSize > atrVal * i_fvgFilter
        newFvg = FVGap.new(
          bx   = box.new(bar_index - 1, bullFvgTop, bar_index + i_fvgExtend, bullFvgBot,
                   bgcolor = color.new(i_bullColor1, 88), border_color = color.new(i_bullColor1, 75), border_width = 0),
          top  = bullFvgTop,
          bot  = bullFvgBot,
          side = 1,
          birthBar = bar_index)
        array.push(fvgArr, newFvg)

    // Bearish FVG: high[0] < low[2]
    bearFvgTop = low[2]
    bearFvgBot = high[0]
    bearFvgSize = bearFvgTop - bearFvgBot
    if bearFvgBot < bearFvgTop and bearFvgSize > atrVal * i_fvgFilter
        newFvg = FVGap.new(
          bx   = box.new(bar_index - 1, bearFvgTop, bar_index + i_fvgExtend, bearFvgBot,
                   bgcolor = color.new(i_bearColor1, 88), border_color = color.new(i_bearColor1, 75), border_width = 0),
          top  = bearFvgTop,
          bot  = bearFvgBot,
          side = -1,
          birthBar = bar_index)
        array.push(fvgArr, newFvg)

    // Enforce max
    while array.size(fvgArr) > i_maxFVG
        old = array.get(fvgArr, 0)
        box.delete(old.bx)
        array.remove(fvgArr, 0)

// --- FVG Fill check & extend (runs every bar for prompt removal) ---
if i_showFVG and array.size(fvgArr) > 0
    for i = array.size(fvgArr) - 1 to 0
        f = array.get(fvgArr, i)
        filled = false
        if f.side == 1 and low <= f.bot
            filled := true
        if f.side == -1 and high >= f.top
            filled := true
        age = bar_index - f.birthBar
        if filled or age > i_fvgExtend
            box.delete(f.bx)
            array.remove(fvgArr, i)
        else
            box.set_right(f.bx, bar_index + 5)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🎯 PREMIUM / DISCOUNT ZONES
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var box  pdPremBox  = na
var box  pdDiscBox  = na
var line pdEqLine   = na

if i_showPD and barstate.islast and not na(lastSwH) and not na(lastSwL) and lastSwH > lastSwL
    eqLevel  = (lastSwH + lastSwL) / 2.0
    leftBar  = math.max(bar_index - 60, 0)
    rightBar = bar_index + 5

    // Delete previous objects
    box.delete(pdPremBox)
    box.delete(pdDiscBox)
    line.delete(pdEqLine)

    // Premium zone (above equilibrium)
    pdPremBox := box.new(leftBar, lastSwH, rightBar, eqLevel,
      bgcolor = color.new(i_bearColor1, i_pdTransp), border_color = na, border_width = 0)
    // Discount zone (below equilibrium)
    pdDiscBox := box.new(leftBar, eqLevel, rightBar, lastSwL,
      bgcolor = color.new(i_bullColor2, i_pdTransp), border_color = na, border_width = 0)
    // Equilibrium line
    pdEqLine := line.new(leftBar, eqLevel, rightBar, eqLevel,
      color = color.new(i_neutralClr, 50), style = line.style_dashed, width = 1)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 📋 DASHBOARD — Compact Live Info Panel
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var table dash = na

if i_showDash and barstate.islast
    dashPos  = f_dashPosition(i_dashPos)
    dashSz   = f_dashSize(i_dashSize)
    bgDark   = #1a1a2e
    bgMedium = #16213e
    txtLight = #e0e0e0
    txtBright = #ffffff

    if na(dash)
        dash := table.new(dashPos, 2, 7, border_width = 1, border_color = color.new(#ffffff, 85), frame_width = 2, frame_color = color.new(i_bullColor1, 70))

    // Row 0: Header
    table.cell(dash, 0, 0, "  LQ Radar  ", text_color = i_bullColor1, bgcolor = bgDark, text_size = dashSz, text_halign = text.align_left)
    table.cell(dash, 1, 0, "v1.0", text_color = color.new(txtLight, 40), bgcolor = bgDark, text_size = dashSz, text_halign = text.align_right)

    // Row 1: Trend
    trendTxt  = mktTrend == 1 ? "BULLISH" : mktTrend == -1 ? "BEARISH" : "NEUTRAL"
    trendClr  = mktTrend == 1 ? i_bullColor1 : mktTrend == -1 ? i_bearColor1 : color.gray
    table.cell(dash, 0, 1, "Trend", text_color = txtLight, bgcolor = bgMedium, text_size = dashSz, text_halign = text.align_left)
    table.cell(dash, 1, 1, trendTxt, text_color = trendClr, bgcolor = bgMedium, text_size = dashSz, text_halign = text.align_right)

    // Row 2: Last Structure Signal
    table.cell(dash, 0, 2, "Structure", text_color = txtLight, bgcolor = bgDark, text_size = dashSz, text_halign = text.align_left)
    table.cell(dash, 1, 2, lastStructSig, text_color = lastStructClr, bgcolor = bgDark, text_size = dashSz, text_halign = text.align_right)

    // Row 3: Liquidity Heat Level
    activeZones = array.size(liqZones)
    nearZones = 0
    if activeZones > 0
        for i = 0 to activeZones - 1
            z = array.get(liqZones, i)
            if math.abs(close - z.level) < atrVal * 3
                nearZones += 1
    heatTxt = nearZones >= 4 ? "HIGH" : nearZones >= 2 ? "MEDIUM" : "LOW"
    heatClr = nearZones >= 4 ? #ff6d00 : nearZones >= 2 ? i_neutralClr : color.new(txtLight, 30)
    table.cell(dash, 0, 3, "Liq. Heat", text_color = txtLight, bgcolor = bgMedium, text_size = dashSz, text_halign = text.align_left)
    table.cell(dash, 1, 3, heatTxt, text_color = heatClr, bgcolor = bgMedium, text_size = dashSz, text_halign = text.align_right)

    // Row 4: Volume
    volAbove = volume > volSma
    volTxt = volAbove ? "ABOVE AVG" : "BELOW AVG"
    volClr = volAbove ? i_bullColor1 : color.new(txtLight, 30)
    table.cell(dash, 0, 4, "Volume", text_color = txtLight, bgcolor = bgDark, text_size = dashSz, text_halign = text.align_left)
    table.cell(dash, 1, 4, volTxt, text_color = volClr, bgcolor = bgDark, text_size = dashSz, text_halign = text.align_right)

    // Row 5: RSI Momentum
    rsiVal = ta.rsi(close, 14)
    rsiTxt = rsiVal > 70 ? "OVERBOUGHT" : rsiVal < 30 ? "OVERSOLD" : "NEUTRAL"
    rsiClr = rsiVal > 70 ? i_bearColor1 : rsiVal < 30 ? i_bullColor2 : color.new(txtLight, 20)
    table.cell(dash, 0, 5, "Momentum", text_color = txtLight, bgcolor = bgMedium, text_size = dashSz, text_halign = text.align_left)
    table.cell(dash, 1, 5, rsiTxt, text_color = rsiClr, bgcolor = bgMedium, text_size = dashSz, text_halign = text.align_right)

    // Row 6: Nearest Zone
    nzTxt  = "—"
    nzClr  = color.new(txtLight, 30)
    if not na(nearestZonePrice) and not na(nearestZoneDist)
        distPct = nearestZoneDist / close * 100
        nzTxt := str.tostring(nearestZonePrice, format.mintick) + " (" + str.tostring(distPct, "#.##") + "%)"
        nzClr := distPct < 0.5 ? #ff6d00 : i_neutralClr
    table.cell(dash, 0, 6, "Next Zone", text_color = txtLight, bgcolor = bgDark, text_size = dashSz, text_halign = text.align_left)
    table.cell(dash, 1, 6, nzTxt, text_color = nzClr, bgcolor = bgDark, text_size = dashSz, text_halign = text.align_right)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🔔 ALERTS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

alertcondition(bossBull,  title = "Bullish BOS",           message = "Liquidity Radar: Bullish Break of Structure confirmed")
alertcondition(bossBear,  title = "Bearish BOS",           message = "Liquidity Radar: Bearish Break of Structure confirmed")
alertcondition(chochBull, title = "Bullish CHoCH",         message = "Liquidity Radar: Bullish Change of Character detected — potential reversal")
alertcondition(chochBear, title = "Bearish CHoCH",         message = "Liquidity Radar: Bearish Change of Character detected — potential reversal")
alertcondition(sweepBull, title = "Liquidity Sweep Bull",  message = "Liquidity Radar: Bullish Liquidity Sweep — swing high taken")
alertcondition(sweepBear, title = "Liquidity Sweep Bear",  message = "Liquidity Radar: Bearish Liquidity Sweep — swing low taken")
alertcondition(obEntryBull or obEntryBear, title = "Price Entering OB", message = "Liquidity Radar: Price is entering an Order Block zone")

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🏷 WATERMARK / BRANDING
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var label wmLabel = na
if i_showWater and barstate.islast
    label.delete(wmLabel)
    wmLabel := label.new(bar_index - 60, low * 0.998,
      "Liquidity Radar  ·  v1.0 FREE",
      color = color.new(color.black, 100),
      textcolor = color.new(#ffffff, 75),
      style = label.style_label_up,
      size = size.small,
      textalign = text.align_left)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// END OF SCRIPT
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
