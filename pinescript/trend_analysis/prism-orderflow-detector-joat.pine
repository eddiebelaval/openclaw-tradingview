// © officialjackofalltrades
//@version=6
indicator("Prism Orderflow Detector [JOAT]", shorttitle="POD [JOAT]", overlay=true, max_bars_back=500, max_lines_count=500, max_boxes_count=50, max_labels_count=100)

// ═══════════════════════════════════════════════════════════════════════════════
// PRISM ORDERFLOW DETECTOR - Institutional Liquidity & Order Flow System
// REDESIGNED: Clean, unique visuals with arrows, gradients, and smart filtering
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════

// Liquidity Settings
liqGroup = "Liquidity Settings"
showEqualHighs = input.bool(true, "Show Equal Highs", group=liqGroup)
showEqualLows = input.bool(true, "Show Equal Lows", group=liqGroup)
equalThreshold = input.float(0.1, "Equal Price Threshold %", minval=0.01, step=0.01, group=liqGroup)
liqLookback = input.int(50, "Liquidity Lookback", minval=10, group=liqGroup)

// Order Block Settings
obGroup = "Order Block Settings"
showOrderBlocks = input.bool(true, "Show Order Blocks", group=obGroup)
obStrength = input.int(3, "Order Block Strength", minval=1, maxval=10, group=obGroup)
obExtend = input.int(20, "Extend Order Blocks", minval=0, group=obGroup)

// Fair Value Gap Settings
fvgGroup = "Fair Value Gap Settings"
showFVG = input.bool(true, "Show Fair Value Gaps", group=fvgGroup)
fvgMinSize = input.float(0.1, "Min FVG Size %", minval=0.01, step=0.01, group=fvgGroup)

// Breaker Block Settings
breakerGroup = "Breaker Block Settings"
showBreakers = input.bool(true, "Show Breaker Blocks", group=breakerGroup)
breakerLookback = input.int(20, "Breaker Lookback", minval=5, group=breakerGroup)

// Advanced Features
advGroup = "Advanced Features"
showLiquidityHeatmap = input.bool(true, "Show Liquidity Heatmap", group=advGroup, tooltip="Visual heatmap of liquidity concentration")
showVolumeDelta = input.bool(true, "Show Volume Delta", group=advGroup, tooltip="Buy vs Sell volume pressure")
showImbalances = input.bool(true, "Show Imbalance Zones", group=advGroup, tooltip="Price inefficiency zones")
showPremiumDiscount = input.bool(true, "Show Premium/Discount Zones", group=advGroup, tooltip="Price above/below equilibrium")
showOrderflowStrength = input.bool(true, "Show Orderflow Strength", group=advGroup, tooltip="Real-time orderflow pressure gauge")
heatmapPeriod = input.int(100, "Heatmap Period", minval=20, maxval=500, group=advGroup)

// Color Settings - UNIQUE PRISM GRADIENT THEME
colorGroup = "Color Settings"
bullLiqColor = input.color(#00FFD1, "Bullish Liquidity", inline="liq", group=colorGroup, tooltip="Cyan-teal gradient")
bearLiqColor = input.color(#FF006E, "Bearish Liquidity", inline="liq", group=colorGroup, tooltip="Hot pink gradient")
bullOBColor = input.color(#00D9FF, "Bullish Order Block", inline="ob", group=colorGroup, tooltip="Sky blue glow")
bearOBColor = input.color(#FF3366, "Bearish Order Block", inline="ob", group=colorGroup, tooltip="Red-pink glow")
fvgBullColor = input.color(#10B981, "Bullish FVG", inline="fvg", group=colorGroup, tooltip="Emerald green")
fvgBearColor = input.color(#EF4444, "Bearish FVG", inline="fvg", group=colorGroup, tooltip="Ruby red")
breakerColor = input.color(#A855F7, "Breaker Blocks", inline="breaker", group=colorGroup, tooltip="Royal purple")
structureColor = input.color(#FFD700, "Market Structure", inline="struct", group=colorGroup, tooltip="Gold")
imbalanceColor = input.color(#FF8800, "Imbalance Zones", inline="imb", group=colorGroup, tooltip="Vibrant orange")

// ═══════════════════════════════════════════
// LIQUIDITY DETECTION
// ═══════════════════════════════════════════

// Equal Highs (Buy-Side Liquidity)
equalHighThreshold = high * (equalThreshold / 100)
equalHigh1 = high == high[1]
equalHigh2 = math.abs(high - high[1]) <= equalHighThreshold and high > high[2]
highestHigh = ta.highest(high, liqLookback)
equalHighs = (equalHigh1 or equalHigh2) and high == highestHigh

// Equal Lows (Sell-Side Liquidity)
equalLowThreshold = low * (equalThreshold / 100)
equalLow1 = low == low[1]
equalLow2 = math.abs(low - low[1]) <= equalLowThreshold and low < low[2]
lowestLow = ta.lowest(low, liqLookback)
equalLows = (equalLow1 or equalLow2) and low == lowestLow

// Swing Highs/Lows (Liquidity Pools)
swingHigh = ta.pivothigh(high, 5, 5)
swingLow = ta.pivotlow(low, 5, 5)

// Liquidity Sweep Detection - Confirmed on bar close
lowestLow10 = ta.lowest(low[1], 10)
highestHigh10 = ta.highest(high[1], 10)
bullSweep = low[1] < lowestLow10 and close > open and close > lowestLow10 and barstate.isconfirmed
bearSweep = high[1] > highestHigh10 and close < open and close < highestHigh10 and barstate.isconfirmed

// ═══════════════════════════════════════════
// ORDER BLOCK DETECTION
// ═══════════════════════════════════════════

// Bullish Order Block: Last down candle before strong up move - Confirmed
atrValue = ta.atr(14)
bullishOB = close[2] < open[2] and close[1] > open[1] and close[1] > high[2] and (high[1] - low[1]) > (atrValue * obStrength) and barstate.isconfirmed

// Bearish Order Block: Last up candle before strong down move - Confirmed
bearishOB = close[2] > open[2] and close[1] < open[1] and close[1] < low[2] and (high[1] - low[1]) > (atrValue * obStrength) and barstate.isconfirmed

// Order Block Zones
var float bullOBTop = na
var float bullOBBottom = na
var int bullOBBar = na

var float bearOBTop = na
var float bearOBBottom = na
var int bearOBBar = na

if bullishOB
    bullOBTop := high[1]
    bullOBBottom := low[1]
    bullOBBar := bar_index

if bearishOB
    bearOBTop := high[1]
    bearOBBottom := low[1]
    bearOBBar := bar_index

// ═══════════════════════════════════════════
// FAIR VALUE GAP DETECTION
// ═══════════════════════════════════════════

// Bullish FVG: Gap between candle 2 high and current low - Confirmed
bullFVG = low[1] > high[3] and close[1] > open[1] and barstate.isconfirmed
bullFVGTop = low[1]
bullFVGBottom = high[3]
bullFVGSize = ((bullFVGTop - bullFVGBottom) / close) * 100
bullFVGValid = bullFVG and bullFVGSize >= fvgMinSize

// Bearish FVG: Gap between candle 2 low and current high - Confirmed
bearFVG = high[1] < low[3] and close[1] < open[1] and barstate.isconfirmed
bearFVGTop = low[3]
bearFVGBottom = high[1]
bearFVGSize = ((bearFVGTop - bearFVGBottom) / close) * 100
bearFVGValid = bearFVG and bearFVGSize >= fvgMinSize

// ═══════════════════════════════════════════
// BREAKER BLOCK DETECTION
// ═══════════════════════════════════════════

// Bullish Breaker: Failed bearish OB that becomes support
bullBreaker = not na(bearOBBottom) and 
              bar_index - bearOBBar <= breakerLookback and
              low <= bearOBBottom and 
              close > bearOBTop

// Bearish Breaker: Failed bullish OB that becomes resistance
bearBreaker = not na(bullOBTop) and 
              bar_index - bullOBBar <= breakerLookback and
              high >= bullOBTop and 
              close < bullOBBottom

// ═══════════════════════════════════════════
// MARKET STRUCTURE
// ═══════════════════════════════════════════

// Higher Highs / Lower Lows
highest10 = ta.highest(high[1], 10)
lowest10 = ta.lowest(low[1], 10)
higherHigh = high > highest10 and close > open
lowerLow = low < lowest10 and close < open

// Break of Structure (BOS)
highest20 = ta.highest(high[1], 20)
lowest20 = ta.lowest(low[1], 20)
bos_bull = higherHigh and close > highest20
bos_bear = lowerLow and close < lowest20

// Change of Character (CHOCH)
choch_bull = lowerLow[1] and higherHigh
choch_bear = higherHigh[1] and lowerLow

// ═══════════════════════════════════════════
// ADVANCED ORDERFLOW FEATURES
// ═══════════════════════════════════════════

// LIQUIDITY HEATMAP - Concentration of liquidity pools
var array<float> liquidityLevels = array.new_float(0)
var array<int> liquidityStrength = array.new_int(0)

if barstate.isfirst
    array.clear(liquidityLevels)
    array.clear(liquidityStrength)

// Track liquidity at swing points
if not na(swingHigh)
    array.push(liquidityLevels, high[5])
    array.push(liquidityStrength, 1)
if not na(swingLow)
    array.push(liquidityLevels, low[5])
    array.push(liquidityStrength, 1)

// Calculate liquidity concentration
liquidityHigh = ta.highest(high, heatmapPeriod)
liquidityLow = ta.lowest(low, heatmapPeriod)
liquidityRange = liquidityHigh - liquidityLow
liquidityMid = (liquidityHigh + liquidityLow) / 2

// Heatmap intensity based on touch count
touchCountHigh = 0
touchCountLow = 0
for i = 1 to 20
    if math.abs(high[i] - liquidityHigh) < (liquidityRange * 0.01)
        touchCountHigh += 1
    if math.abs(low[i] - liquidityLow) < (liquidityRange * 0.01)
        touchCountLow += 1

heatmapIntensityHigh = math.min(touchCountHigh * 5, 100)
heatmapIntensityLow = math.min(touchCountLow * 5, 100)

// VOLUME DELTA - Buy vs Sell pressure
buyVolume = close > open ? volume : 0
sellVolume = close < open ? volume : 0
volumeDelta = ta.sma(buyVolume - sellVolume, 14)
volumeDeltaNormalized = (volumeDelta / ta.sma(volume, 14)) * 100

// Volume Delta Strength
deltaStrong = math.abs(volumeDeltaNormalized) > 50
deltaBullish = volumeDeltaNormalized > 0
deltaBearish = volumeDeltaNormalized < 0

// IMBALANCE ZONES - Price inefficiencies (enhanced FVG detection)
// Bullish Imbalance: Large gap up with no fill
bullImbalance = low > high[2] and (low - high[2]) > (ta.atr(14) * 0.5)
bullImbalanceTop = low
bullImbalanceBottom = high[2]
bullImbalanceSize = ((bullImbalanceTop - bullImbalanceBottom) / close) * 100

// Bearish Imbalance: Large gap down with no fill
bearImbalance = high < low[2] and (low[2] - high) > (ta.atr(14) * 0.5)
bearImbalanceTop = low[2]
bearImbalanceBottom = high
bearImbalanceSize = ((bearImbalanceTop - bearImbalanceBottom) / close) * 100

// PREMIUM / DISCOUNT ZONES
priceRange = ta.highest(high, 50) - ta.lowest(low, 50)
equilibrium = ta.lowest(low, 50) + (priceRange / 2)
premiumZone = close > equilibrium + (priceRange * 0.25)
discountZone = close < equilibrium - (priceRange * 0.25)
equilibriumZone = not premiumZone and not discountZone

// Premium/Discount levels
premiumLevel = equilibrium + (priceRange * 0.25)
discountLevel = equilibrium - (priceRange * 0.25)

// ORDERFLOW STRENGTH METER
// Combines multiple factors for real-time strength
obStrengthFactor = (bullishOB ? 20 : 0) + (bearishOB ? -20 : 0)
fvgStrengthFactor = (bullFVGValid ? 15 : 0) + (bearFVGValid ? -15 : 0)
sweepStrengthFactor = (bullSweep ? 25 : 0) + (bearSweep ? -25 : 0)
deltaStrengthFactor = volumeDeltaNormalized * 0.3
structureStrengthFactor = (bos_bull ? 20 : 0) + (bos_bear ? -20 : 0)

orderflowStrength = obStrengthFactor + fvgStrengthFactor + sweepStrengthFactor + deltaStrengthFactor + structureStrengthFactor
orderflowStrengthSmooth = ta.ema(orderflowStrength, 5)

// Orderflow pressure classification
extremeBullPressure = orderflowStrengthSmooth > 60
strongBullPressure = orderflowStrengthSmooth > 30 and orderflowStrengthSmooth <= 60
extremeBearPressure = orderflowStrengthSmooth < -60
strongBearPressure = orderflowStrengthSmooth < -30 and orderflowStrengthSmooth >= -60

// LIQUIDITY VOID DETECTION - Areas with no liquidity
volumeProfile = volume / ta.sma(volume, 50)
liquidityVoid = volumeProfile < 0.3 and (high - low) > ta.atr(14)

// ABSORPTION DETECTION - Large volume with small price movement
absorption = volume > ta.sma(volume, 20) * 2 and (high - low) < ta.atr(14) * 0.5
absorptionBullish = absorption and close > open
absorptionBearish = absorption and close < open

// ═══════════════════════════════════════════
// PLOTS & VISUAL ELEMENTS - REDESIGNED
// ═══════════════════════════════════════════

// LIQUIDITY POOLS - Arrows instead of X marks
var int lastEQHBar = 0
var int lastEQLBar = 0

// Equal Highs - Downward arrow (resistance)
if showEqualHighs and equalHighs and (bar_index - lastEQHBar) > 15 and barstate.isconfirmed
    line.new(bar_index, high, bar_index, high + ta.atr(14) * 0.5, color=color.new(bearLiqColor, 0), width=3, style=line.style_arrow_right)
    label.new(bar_index, high + ta.atr(14) * 0.7, "EQH", style=label.style_none, color=color.new(bearLiqColor, 0), textcolor=bearLiqColor, size=size.small)
    lastEQHBar := bar_index

// Equal Lows - Upward arrow (support)
if showEqualLows and equalLows and (bar_index - lastEQLBar) > 15 and barstate.isconfirmed
    line.new(bar_index, low, bar_index, low - ta.atr(14) * 0.5, color=color.new(bullLiqColor, 0), width=3, style=line.style_arrow_right)
    label.new(bar_index, low - ta.atr(14) * 0.7, "EQL", style=label.style_none, color=color.new(bullLiqColor, 0), textcolor=bullLiqColor, size=size.small)
    lastEQLBar := bar_index

// LIQUIDITY SWEEPS - Clean labels WITHOUT triangles
var int lastBullSweepBar = 0
var int lastBearSweepBar = 0

if bullSweep and (bar_index - lastBullSweepBar) > 25
    line.new(bar_index - 3, low[1], bar_index, low, color=color.new(bullLiqColor, 0), width=2, style=line.style_arrow_right)
    label.new(bar_index, low, "SWEEP", style=label.style_none, color=na, textcolor=bullLiqColor, size=size.small)
    lastBullSweepBar := bar_index

if bearSweep and (bar_index - lastBearSweepBar) > 25
    line.new(bar_index - 3, high[1], bar_index, high, color=color.new(bearLiqColor, 0), width=2, style=line.style_arrow_right)
    label.new(bar_index, high, "SWEEP", style=label.style_none, color=na, textcolor=bearLiqColor, size=size.small)
    lastBearSweepBar := bar_index

// ORDER BLOCKS - Gradient boxes with diagonal lines
var int lastBullOBBar = 0
var int lastBearOBBar = 0

if showOrderBlocks and bullishOB and (bar_index - lastBullOBBar) > 40
    // Gradient box
    box.new(bar_index[2], high[2], bar_index[2] + obExtend, low[2], 
            border_color=color.new(bullOBColor, 0), 
            bgcolor=color.new(bullOBColor, 90), 
            border_width=2)
    // Diagonal line across box
    line.new(bar_index[2], low[2], bar_index[2] + obExtend, high[2], 
             color=color.new(bullOBColor, 50), width=1, style=line.style_dashed)
    // Plain text at bottom middle - NO BOX
    boxMidBar = bar_index[2] + math.round(obExtend / 2)
    label.new(boxMidBar, low[2], "OB", style=label.style_none, 
              color=na, textcolor=bullOBColor, size=size.normal)
    lastBullOBBar := bar_index

if showOrderBlocks and bearishOB and (bar_index - lastBearOBBar) > 40
    // Gradient box
    box.new(bar_index[2], high[2], bar_index[2] + obExtend, low[2], 
            border_color=color.new(bearOBColor, 0), 
            bgcolor=color.new(bearOBColor, 90), 
            border_width=2)
    // Diagonal line across box
    line.new(bar_index[2], high[2], bar_index[2] + obExtend, low[2], 
             color=color.new(bearOBColor, 50), width=1, style=line.style_dashed)
    // Plain text at top middle - NO BOX
    boxMidBar = bar_index[2] + math.round(obExtend / 2)
    label.new(boxMidBar, high[2], "OB", style=label.style_none, 
              color=na, textcolor=bearOBColor, size=size.normal)
    lastBearOBBar := bar_index

// FAIR VALUE GAPS - Horizontal lines with gradient fill
var int lastBullFVGBar = 0
var int lastBearFVGBar = 0

if showFVG and bullFVGValid and (bar_index - lastBullFVGBar) > 40
    // Top and bottom lines
    line.new(bar_index[1], bullFVGTop, bar_index[1] + 20, bullFVGTop, 
             color=color.new(fvgBullColor, 0), width=2, style=line.style_solid)
    line.new(bar_index[1], bullFVGBottom, bar_index[1] + 20, bullFVGBottom, 
             color=color.new(fvgBullColor, 0), width=2, style=line.style_solid)
    // Gradient fill
    box.new(bar_index[1], bullFVGTop, bar_index[1] + 20, bullFVGBottom, 
            border_color=na, bgcolor=color.new(fvgBullColor, 92))
    // Plain text at bottom middle - NO BOX
    fvgMidBar = bar_index[1] + 10
    label.new(fvgMidBar, bullFVGBottom, "FVG", style=label.style_none, 
              color=na, textcolor=fvgBullColor, size=size.normal)
    lastBullFVGBar := bar_index

if showFVG and bearFVGValid and (bar_index - lastBearFVGBar) > 40
    // Top and bottom lines
    line.new(bar_index[1], bearFVGTop, bar_index[1] + 20, bearFVGTop, 
             color=color.new(fvgBearColor, 0), width=2, style=line.style_solid)
    line.new(bar_index[1], bearFVGBottom, bar_index[1] + 20, bearFVGBottom, 
             color=color.new(fvgBearColor, 0), width=2, style=line.style_solid)
    // Gradient fill
    box.new(bar_index[1], bearFVGTop, bar_index[1] + 20, bearFVGBottom, 
            border_color=na, bgcolor=color.new(fvgBearColor, 92))
    // Plain text at top middle - NO BOX
    fvgMidBar = bar_index[1] + 10
    label.new(fvgMidBar, bearFVGTop, "FVG", style=label.style_none, 
              color=na, textcolor=fvgBearColor, size=size.normal)
    lastBearFVGBar := bar_index

// BREAKER BLOCKS - Diamond markers
plotshape(showBreakers and bullBreaker and not bullBreaker[1], "Bull Breaker", 
          shape.diamond, location.belowbar, color=color.new(breakerColor, 0), 
          size=size.small, text="BRK")
plotshape(showBreakers and bearBreaker and not bearBreaker[1], "Bear Breaker", 
          shape.diamond, location.abovebar, color=color.new(breakerColor, 0), 
          size=size.small, text="BRK")

// MARKET STRUCTURE - CHoCH with arrows
var int lastChochBullBar = 0
var int lastChochBearBar = 0

if choch_bull and not choch_bull[1] and (bar_index - lastChochBullBar) > 15
    line.new(bar_index - 5, low[5], bar_index, low, 
             color=color.new(structureColor, 0), width=2, style=line.style_arrow_right)
    label.new(bar_index, low, "CHoCH", style=label.style_label_up, 
              color=color.new(structureColor, 0), textcolor=color.black, size=size.tiny)
    lastChochBullBar := bar_index

if choch_bear and not choch_bear[1] and (bar_index - lastChochBearBar) > 15
    line.new(bar_index - 5, high[5], bar_index, high, 
             color=color.new(structureColor, 0), width=2, style=line.style_arrow_right)
    label.new(bar_index, high, "CHoCH", style=label.style_label_down, 
              color=color.new(structureColor, 0), textcolor=color.black, size=size.tiny)
    lastChochBearBar := bar_index

// IMBALANCE ZONES - Unique design with crossing lines
var int lastBullImbalanceBar = 0
var int lastBearImbalanceBar = 0

if showImbalances and bullImbalance and bullImbalanceSize > 0.5 and (bar_index - lastBullImbalanceBar) > 40 and barstate.isconfirmed
    // Box with gradient
    box.new(bar_index[1], bullImbalanceTop, bar_index[1] + 25, bullImbalanceBottom, 
            border_color=color.new(imbalanceColor, 0), 
            bgcolor=color.new(imbalanceColor, 94), 
            border_width=2)
    // Crossing diagonal lines
    line.new(bar_index[1], bullImbalanceBottom, bar_index[1] + 25, bullImbalanceTop, 
             color=color.new(imbalanceColor, 60), width=1, style=line.style_dotted)
    line.new(bar_index[1], bullImbalanceTop, bar_index[1] + 25, bullImbalanceBottom, 
             color=color.new(imbalanceColor, 60), width=1, style=line.style_dotted)
    // Plain text at bottom middle - NO BOX
    imbMidBar = bar_index[1] + 12
    label.new(imbMidBar, bullImbalanceBottom, "IMB", style=label.style_none, 
              color=na, textcolor=imbalanceColor, size=size.normal)
    lastBullImbalanceBar := bar_index

if showImbalances and bearImbalance and bearImbalanceSize > 0.5 and (bar_index - lastBearImbalanceBar) > 40 and barstate.isconfirmed
    // Box with gradient
    box.new(bar_index[1], bearImbalanceTop, bar_index[1] + 25, bearImbalanceBottom, 
            border_color=color.new(imbalanceColor, 0), 
            bgcolor=color.new(imbalanceColor, 94), 
            border_width=2)
    // Crossing diagonal lines
    line.new(bar_index[1], bearImbalanceTop, bar_index[1] + 25, bearImbalanceBottom, 
             color=color.new(imbalanceColor, 60), width=1, style=line.style_dotted)
    line.new(bar_index[1], bearImbalanceBottom, bar_index[1] + 25, bearImbalanceTop, 
             color=color.new(imbalanceColor, 60), width=1, style=line.style_dotted)
    // Plain text at top middle - NO BOX
    imbMidBar = bar_index[1] + 12
    label.new(imbMidBar, bearImbalanceTop, "IMB", style=label.style_none, 
              color=na, textcolor=imbalanceColor, size=size.normal)
    lastBearImbalanceBar := bar_index

// LIQUIDITY HEATMAP - Only show significant levels
if showLiquidityHeatmap and heatmapIntensityHigh > 80 and barstate.isconfirmed
    line.new(bar_index - 40, liquidityHigh, bar_index, liquidityHigh, 
             color=color.new(bearLiqColor, 30), width=3, style=line.style_solid)
    label.new(bar_index - 20, liquidityHigh, "LIQ", style=label.style_label_down, 
              color=color.new(bearLiqColor, 0), textcolor=color.white, size=size.tiny)

if showLiquidityHeatmap and heatmapIntensityLow > 80 and barstate.isconfirmed
    line.new(bar_index - 40, liquidityLow, bar_index, liquidityLow, 
             color=color.new(bullLiqColor, 30), width=3, style=line.style_solid)
    label.new(bar_index - 20, liquidityLow, "LIQ", style=label.style_label_up, 
              color=color.new(bullLiqColor, 0), textcolor=color.white, size=size.tiny)

// VOLUME DELTA - Only extreme signals
if showVolumeDelta and deltaStrong and math.abs(volumeDeltaNormalized) > 70 and barstate.isconfirmed
    barColor = deltaBullish ? color.new(bullLiqColor, 0) : color.new(bearLiqColor, 0)
    label.new(bar_index, deltaBullish ? low : high, deltaBullish ? "Δ+" : "Δ-", 
              style=deltaBullish ? label.style_label_up : label.style_label_down, 
              color=barColor, textcolor=color.white, size=size.tiny)

// ORDERFLOW STRENGTH - Subtle background
strengthBg = extremeBullPressure ? color.new(bullLiqColor, 97) : 
             strongBullPressure ? color.new(bullLiqColor, 98) : 
             extremeBearPressure ? color.new(bearLiqColor, 97) : 
             strongBearPressure ? color.new(bearLiqColor, 98) : na
bgcolor(showOrderflowStrength ? strengthBg : na, title="Orderflow Strength")

// ═══════════════════════════════════════════
// DASHBOARD - FIXED TO SHOW ACTUAL STATUS
// ═══════════════════════════════════════════

var table dashboard = table.new(position.bottom_right, 2, 12, border_width=2, border_color=color.new(#A855F7, 30), frame_width=2, frame_color=color.new(#A855F7, 30))

if barstate.islast
    // Header
    table.cell(dashboard, 0, 0, "PRISM ORDERFLOW", text_color=color.white, bgcolor=color.new(#A855F7, 10), text_size=size.normal)
    table.cell(dashboard, 1, 0, "STATUS", text_color=color.white, bgcolor=color.new(#A855F7, 10), text_size=size.normal)
    
    // Equal Highs - Check last 50 bars
    eqhDetected = false
    for i = 0 to 49
        if equalHighs[i]
            eqhDetected := true
            break
    eqhText = eqhDetected ? "DETECTED" : "Clear"
    eqhBg = eqhDetected ? color.new(bearLiqColor, 50) : color.new(color.gray, 80)
    table.cell(dashboard, 0, 1, "Equal Highs", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(dashboard, 1, 1, eqhText, text_color=color.white, bgcolor=eqhBg, text_size=size.small)
    
    // Equal Lows - Check last 50 bars
    eqlDetected = false
    for i = 0 to 49
        if equalLows[i]
            eqlDetected := true
            break
    eqlText = eqlDetected ? "DETECTED" : "Clear"
    eqlBg = eqlDetected ? color.new(bullLiqColor, 50) : color.new(color.gray, 80)
    table.cell(dashboard, 0, 2, "Equal Lows", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(dashboard, 1, 2, eqlText, text_color=color.white, bgcolor=eqlBg, text_size=size.small)
    
    // Order Blocks - Check last 30 bars
    obBullDetected = false
    obBearDetected = false
    for i = 0 to 29
        if bullishOB[i]
            obBullDetected := true
        if bearishOB[i]
            obBearDetected := true
    obText = obBullDetected ? "BULLISH" : obBearDetected ? "BEARISH" : "Clear"
    obBg = obBullDetected ? color.new(bullOBColor, 50) : obBearDetected ? color.new(bearOBColor, 50) : color.new(color.gray, 80)
    table.cell(dashboard, 0, 3, "Order Block", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(dashboard, 1, 3, obText, text_color=color.white, bgcolor=obBg, text_size=size.small)
    
    // Fair Value Gaps - Check last 30 bars
    fvgBullDetected = false
    fvgBearDetected = false
    for i = 0 to 29
        if bullFVGValid[i]
            fvgBullDetected := true
        if bearFVGValid[i]
            fvgBearDetected := true
    fvgText = fvgBullDetected ? "BULLISH" : fvgBearDetected ? "BEARISH" : "Clear"
    fvgBg = fvgBullDetected ? color.new(fvgBullColor, 50) : fvgBearDetected ? color.new(fvgBearColor, 50) : color.new(color.gray, 80)
    table.cell(dashboard, 0, 4, "FVG", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(dashboard, 1, 4, fvgText, text_color=color.white, bgcolor=fvgBg, text_size=size.small)
    
    // Liquidity Sweep - Check last 20 bars
    sweepBullDetected = false
    sweepBearDetected = false
    for i = 0 to 19
        if bullSweep[i]
            sweepBullDetected := true
        if bearSweep[i]
            sweepBearDetected := true
    sweepText = sweepBullDetected ? "BULL SWEEP" : sweepBearDetected ? "BEAR SWEEP" : "Clear"
    sweepBg = sweepBullDetected ? color.new(bullLiqColor, 50) : sweepBearDetected ? color.new(bearLiqColor, 50) : color.new(color.gray, 80)
    table.cell(dashboard, 0, 5, "Sweep", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(dashboard, 1, 5, sweepText, text_color=color.white, bgcolor=sweepBg, text_size=size.small)
    
    // Market Structure - Check last 20 bars
    bosDetected = false
    chochDetected = false
    structureBull = false
    for i = 0 to 19
        if bos_bull[i] or choch_bull[i]
            bosDetected := true
            structureBull := true
        if bos_bear[i] or choch_bear[i]
            bosDetected := true
            structureBull := false
    msText = bosDetected ? (structureBull ? "BULLISH" : "BEARISH") : "Neutral"
    msBg = bosDetected ? color.new(structureColor, 50) : color.new(color.gray, 80)
    table.cell(dashboard, 0, 6, "Structure", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(dashboard, 1, 6, msText, text_color=color.white, bgcolor=msBg, text_size=size.small)
    
    // Breaker Blocks - Check last 20 bars
    breakerBullDetected = false
    breakerBearDetected = false
    for i = 0 to 19
        if bullBreaker[i]
            breakerBullDetected := true
        if bearBreaker[i]
            breakerBearDetected := true
    breakerText = breakerBullDetected ? "BULL BRK" : breakerBearDetected ? "BEAR BRK" : "Clear"
    breakerBg = breakerBullDetected or breakerBearDetected ? color.new(breakerColor, 50) : color.new(color.gray, 80)
    table.cell(dashboard, 0, 7, "Breaker", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(dashboard, 1, 7, breakerText, text_color=color.white, bgcolor=breakerBg, text_size=size.small)
    
    // Orderflow Strength - Current bar
    strengthText = extremeBullPressure ? "EXTREME↑" : strongBullPressure ? "STRONG↑" : extremeBearPressure ? "EXTREME↓" : strongBearPressure ? "STRONG↓" : "NEUTRAL"
    strengthBg = extremeBullPressure or strongBullPressure ? color.new(bullLiqColor, 50) : extremeBearPressure or strongBearPressure ? color.new(bearLiqColor, 50) : color.new(color.gray, 80)
    table.cell(dashboard, 0, 8, "Orderflow", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(dashboard, 1, 8, strengthText, text_color=color.white, bgcolor=strengthBg, text_size=size.small)
    
    // Volume Delta - Current bar
    deltaText = deltaStrong and deltaBullish ? "BULL Δ" : deltaStrong and deltaBearish ? "BEAR Δ" : "Neutral"
    deltaBg = deltaStrong and deltaBullish ? color.new(bullLiqColor, 50) : deltaStrong and deltaBearish ? color.new(bearLiqColor, 50) : color.new(color.gray, 80)
    table.cell(dashboard, 0, 9, "Vol Delta", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(dashboard, 1, 9, deltaText, text_color=color.white, bgcolor=deltaBg, text_size=size.small)
    
    // Premium/Discount - Current bar
    pdText = premiumZone ? "PREMIUM" : discountZone ? "DISCOUNT" : "EQUILIBRIUM"
    pdBg = premiumZone ? color.new(bearLiqColor, 50) : discountZone ? color.new(bullLiqColor, 50) : color.new(color.gray, 80)
    table.cell(dashboard, 0, 10, "Zone", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(dashboard, 1, 10, pdText, text_color=color.white, bgcolor=pdBg, text_size=size.small)
    
    // Liquidity Heatmap - Current bar
    heatText = heatmapIntensityHigh > 60 or heatmapIntensityLow > 60 ? "HOT" : "Normal"
    heatBg = heatmapIntensityHigh > 60 or heatmapIntensityLow > 60 ? color.new(imbalanceColor, 50) : color.new(color.gray, 80)
    table.cell(dashboard, 0, 11, "Heatmap", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(dashboard, 1, 11, heatText, text_color=color.white, bgcolor=heatBg, text_size=size.small)

// ═══════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════

alertcondition(equalHighs, "Equal Highs Detected", "Prism Orderflow: Equal Highs - Buy-Side Liquidity Pool")
alertcondition(equalLows, "Equal Lows Detected", "Prism Orderflow: Equal Lows - Sell-Side Liquidity Pool")
alertcondition(bullishOB, "Bullish Order Block", "Prism Orderflow: Bullish Order Block Formed")
alertcondition(bearishOB, "Bearish Order Block", "Prism Orderflow: Bearish Order Block Formed")
alertcondition(bullFVGValid, "Bullish Fair Value Gap", "Prism Orderflow: Bullish FVG Detected")
alertcondition(bearFVGValid, "Bearish Fair Value Gap", "Prism Orderflow: Bearish FVG Detected")
alertcondition(bullSweep, "Bullish Liquidity Sweep", "Prism Orderflow: Bullish Liquidity Sweep - Potential Reversal")
alertcondition(bearSweep, "Bearish Liquidity Sweep", "Prism Orderflow: Bearish Liquidity Sweep - Potential Reversal")
alertcondition(bos_bull, "Bullish Break of Structure", "Prism Orderflow: Bullish BOS - Trend Continuation")
alertcondition(bos_bear, "Bearish Break of Structure", "Prism Orderflow: Bearish BOS - Trend Continuation")
alertcondition(choch_bull, "Bullish Change of Character", "Prism Orderflow: Bullish CHoCH - Potential Trend Change")
alertcondition(choch_bear, "Bearish Change of Character", "Prism Orderflow: Bearish CHoCH - Potential Trend Change")
