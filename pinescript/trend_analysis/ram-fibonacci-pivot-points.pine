//@version=5
indicator(title="Fibonacci Pivot Points", shorttitle="Fib Pivots", overlay=true)

// ═══════════════════════════════════════════════════════════════
//  FIBONACCI PIVOT POINTS
//  Calculates pivot levels using Fibonacci ratios (38.2%, 61.8%, 100%)
//  applied to the prior session's High, Low, and Close.
//
//  Levels:
//    PP  = (H + L + C) / 3
//    R1  = PP + 0.382 * (H - L)
//    R2  = PP + 0.618 * (H - L)
//    R3  = PP + 1.000 * (H - L)
//    S1  = PP - 0.382 * (H - L)
//    S2  = PP - 0.618 * (H - L)
//    S3  = PP - 1.000 * (H - L)
// ═══════════════════════════════════════════════════════════════

// ─── INPUTS ─────────────────────────────────────────────────────
pivotRes    = input.string("D", "Pivot Timeframe", options=["W", "D", "240", "60"],
                 tooltip="Resolution of the candle used to calculate pivots.\nD=Daily | W=Weekly | 240=4H | 60=1H")
showLabels  = input.bool(true,  "Show Labels")
showR3S3    = input.bool(true,  "Show R3 / S3")
showR2S2    = input.bool(true,  "Show R2 / S2")
showR1S1    = input.bool(true,  "Show R1 / S1")
lineWidth   = input.int(1,      "Line Width", minval=1, maxval=4)

// ─── COLOURS ─────────────────────────────────────────────────────
col_pp = input.color(color.new(#00e5a0, 0), "Pivot (PP)")
col_r1 = input.color(color.new(#ffd166, 0), "R1 / S1  (38.2%)")
col_r2 = input.color(color.new(#ff8c42, 0), "R2 / S2  (61.8%)")
col_r3 = input.color(color.new(#ff4d4d, 0), "R3 / S3  (100%)")

// ─── FIBONACCI RATIOS ────────────────────────────────────────────
FIB_1 = 0.382
FIB_2 = 0.618
FIB_3 = 1.000

// ─── FETCH PRIOR SESSION OHLC ───────────────────────────────────
pH = request.security(syminfo.tickerid, pivotRes, high[1],  lookahead=barmerge.lookahead_on)
pL = request.security(syminfo.tickerid, pivotRes, low[1],   lookahead=barmerge.lookahead_on)
pC = request.security(syminfo.tickerid, pivotRes, close[1], lookahead=barmerge.lookahead_on)

// ─── CALCULATE PIVOT LEVELS ─────────────────────────────────────
pivot_range = pH - pL

PP = (pH + pL + pC) / 3
R1 = PP + FIB_1 * pivot_range
R2 = PP + FIB_2 * pivot_range
R3 = PP + FIB_3 * pivot_range
S1 = PP - FIB_1 * pivot_range
S2 = PP - FIB_2 * pivot_range
S3 = PP - FIB_3 * pivot_range

// ─── LABEL HELPER (must be defined at top level in Pine v5) ─────
makeLabel(lvl, txt, col) =>
    label.new(
         x         = bar_index + 3,
         y         = lvl,
         text      = txt + "  " + str.tostring(math.round(lvl, 5)),
         xloc      = xloc.bar_index,
         yloc      = yloc.price,
         color     = color.new(col, 85),
         textcolor = col,
         style     = label.style_label_left,
         size      = size.small)

// ─── PLOT LEVELS ─────────────────────────────────────────────────
plot(PP,                  title="PP", color=col_pp, linewidth=lineWidth + 1)
plot(showR1S1 ? R1 : na,  title="R1", color=col_r1, linewidth=lineWidth)
plot(showR1S1 ? S1 : na,  title="S1", color=col_r1, linewidth=lineWidth)
plot(showR2S2 ? R2 : na,  title="R2", color=col_r2, linewidth=lineWidth)
plot(showR2S2 ? S2 : na,  title="S2", color=col_r2, linewidth=lineWidth)
plot(showR3S3 ? R3 : na,  title="R3", color=col_r3, linewidth=lineWidth)
plot(showR3S3 ? S3 : na,  title="S3", color=col_r3, linewidth=lineWidth)

// ─── LABELS (only drawn on the last bar) ─────────────────────────
if barstate.islast and showLabels
    makeLabel(PP, "PP", col_pp)
    if showR1S1
        makeLabel(R1, "R1 · 38.2%", col_r1)
        makeLabel(S1, "S1 · 38.2%", col_r1)
    if showR2S2
        makeLabel(R2, "R2 · 61.8%", col_r2)
        makeLabel(S2, "S2 · 61.8%", col_r2)
    if showR3S3
        makeLabel(R3, "R3 · 100%",  col_r3)
        makeLabel(S3, "S3 · 100%",  col_r3)

// ─── BACKGROUND HIGHLIGHT (price inside R1/S1 = neutral zone) ───
inZone = close > S1 and close < R1
bgcolor(inZone ? color.new(col_pp, 95) : na, title="Inside R1/S1 Zone")

// ─── ALERTS ──────────────────────────────────────────────────────
alertcondition(ta.cross(close, PP), title="Crossed PP", message="Price crossed Pivot Point (PP)")
alertcondition(ta.cross(close, R1), title="Crossed R1", message="Price crossed R1 - 38.2%")
alertcondition(ta.cross(close, R2), title="Crossed R2", message="Price crossed R2 - 61.8%")
alertcondition(ta.cross(close, R3), title="Crossed R3", message="Price crossed R3 - 100%")
alertcondition(ta.cross(close, S1), title="Crossed S1", message="Price crossed S1 - 38.2%")
alertcondition(ta.cross(close, S2), title="Crossed S2", message="Price crossed S2 - 61.8%")
alertcondition(ta.cross(close, S3), title="Crossed S3", message="Price crossed S3 - 100%")
