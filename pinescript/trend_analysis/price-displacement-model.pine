//@version=6
indicator("Price Displacement Model", overlay=true)

// =====================================================================
// =============================== INPUTS ===============================
// =====================================================================
showInternalColor = input.bool(true, title="Show Internal Flow Overlay")
internalDisplacement = input.float(0.0005, "Internal Displacement Threshold", step=0.0001)
internalBarColorBullish = input.color(color.green, title="Internal Bullish Bar Color")
internalBarColorBearish = input.color(color.red, title="Internal Bearish Bar Color")
externalDisplacement = input.float(0.0010, "External Displacement Threshold", step=0.0001)
breakSource          = input.string("Close", "Break Source", options=["Close","Wick"])
// === ZIGZAG (EXTERNAL ONLY) ===
zigzagColor = input.color(color.black, "ZigZag Line Color")
zigzagWidth = input.int(2, "ZigZag Line Width", minval=1)

showBearishOrderBlocks = input.bool(true, title="Show Supply Zones")
showBullishOrderBlocks = input.bool(true, title="Show Demand Zones")
orderBlockDuration = input.int(10, title="Zone Duration (bars)")
deleteMitigatedBoxes = input.bool(false, title="Delete Mitigated Zones")
deleteBrokenBoxes= input.bool(false, title = "Delete Broken Zones")
dimMitigatedBoxes = input.bool(true, title="Dim Mitigated Zones")
bearishBlockColor = input.color(color.rgb(255, 82, 82, 50), title="Supply Zone Fill")
bullishBlockColor = input.color(color.rgb(76, 175, 79, 50), title="Demand Zone Fill")
lighterBullishColor = color.new(bullishBlockColor, 85)  // More transparent
lighterBearishColor = color.new(bearishBlockColor, 85)

// =====================================================================
// ============================ BREAK SOURCE ============================
// =====================================================================

float breakerBullish = breakSource == "Close" ? close : high
float breakerBearish = breakSource == "Close" ? close : low

// =====================================================================
// ===================== INTERNAL DISPLACEMENT (STRUCTURE) ===============
// =====================================================================

var float intRunningHigh = na
var float intRunningLow  = na
var bool  intLastWasDemand = false
var bool  intFirstSignal   = true
var int   internalBias     = 0   // 1 = bullish, -1 = bearish

if na(intRunningHigh)
    intRunningHigh := high
    intRunningLow  := low

bool internalDemand = false
bool internalSupply = false

intRunningHigh := math.max(intRunningHigh, high)
intRunningLow  := math.min(intRunningLow, low)

// === INTERNAL DEMAND ===
if intFirstSignal or not intLastWasDemand
    if breakerBullish > intRunningLow + internalDisplacement and close > open
        internalDemand    := true
        intLastWasDemand  := true
        intFirstSignal    := false
        intRunningHigh    := high
        intRunningLow     := low
        internalBias      := 1

// === INTERNAL SUPPLY ===
if intFirstSignal or intLastWasDemand
    if breakerBearish < intRunningHigh - internalDisplacement and close < open
        internalSupply    := true
        intLastWasDemand  := false
        intFirstSignal    := false
        intRunningHigh    := high
        intRunningLow     := low
        internalBias      := -1

// === INTERNAL CANDLE COLORING ===
color internalBarCol =
     showInternalColor ?
         internalBias == 1  ? internalBarColorBullish :
         internalBias == -1 ? internalBarColorBearish :
         na
     : na

barcolor(internalBarCol)

// =====================================================================
// ===================== EXTERNAL DISPLACEMENT (STRUCTURE) ===============
// =====================================================================

var float extRunningHigh = na
var float extRunningLow  = na
var bool  extLastWasDemand = false
var bool  extFirstSignal   = true
var int   demandIndex      = na
var int   supplyIndex      = na

if na(extRunningHigh)
    extRunningHigh := high
    extRunningLow  := low

bool demandOccured = false
bool supplyOccured = false

extRunningHigh := math.max(extRunningHigh, high)
extRunningLow  := math.min(extRunningLow, low)

// === EXTERNAL DEMAND ===
if extFirstSignal or not extLastWasDemand
    if breakerBullish > extRunningLow + externalDisplacement and close > open
        demandOccured   := true
        extLastWasDemand := true
        extFirstSignal   := false
        extRunningHigh   := high
        extRunningLow    := low
        demandIndex      := bar_index

// === EXTERNAL SUPPLY ===
if extFirstSignal or extLastWasDemand
    if breakerBearish < extRunningHigh - externalDisplacement and close < open
        supplyOccured   := true
        extLastWasDemand := false
        extFirstSignal   := false
        extRunningHigh   := high
        extRunningLow    := low
        supplyIndex      := bar_index

// =====================================================================
// ============================ EXTERNAL PLOTS ===========================
// =====================================================================

plotshape(demandOccured, title="External Demand",
     location=location.belowbar, style=shape.triangleup,
     color=color.green, size=size.tiny)

plotshape(supplyOccured, title="External Supply",
     location=location.abovebar, style=shape.triangledown,
     color=color.red, size=size.tiny)

// =====================================================================
// ============================ SWING LABELS =============================
// =====================================================================

var float lastSwingHigh = na
var float lastSwingLow  = na

if demandOccured
    float swingLow = low
    int   swingBar = bar_index
    int   lookback = bar_index - supplyIndex
    for i = 0 to lookback
        if low[i] < swingLow
            swingLow := low[i]
            swingBar := bar_index - i
    string lbl = not na(lastSwingLow) ? (swingLow > lastSwingLow ? "HL" : "LL") : "LL"
    color  clr = lbl == "HL" ? color.green : color.red
    lastSwingLow := swingLow
    label.new(swingBar, swingLow, lbl,
        style=label.style_label_up, color=clr,
        textcolor=color.white, size=size.tiny)

if supplyOccured
    float swingHigh = high
    int   swingBar  = bar_index
    int   lookback  = bar_index - demandIndex
    for i = 0 to lookback
        if high[i] > swingHigh
            swingHigh := high[i]
            swingBar := bar_index - i
    string lbl = not na(lastSwingHigh) ? (swingHigh > lastSwingHigh ? "HH" : "LH") : "HH"
    color  clr = lbl == "HH" ? color.green : color.red
    lastSwingHigh := swingHigh
    label.new(swingBar, swingHigh, lbl,
        style=label.style_label_down, color=clr,
        textcolor=color.white, size=size.tiny)

// =====================================================================
// ============================== ZIG ZAG ================================
// =====================================================================

var float lastSwingPrice = na
var int   lastSwingBar   = na
var line[] zigzagLines   = array.new_line()

if demandOccured
    float swingLow = low
    int   swingBar = bar_index
    int   lookback = bar_index - supplyIndex
    for i = 0 to lookback
        if low[i] < swingLow
            swingLow := low[i]
            swingBar := bar_index - i
    if not na(lastSwingPrice)
        array.push(
            zigzagLines,
            line.new(lastSwingBar, lastSwingPrice,
                     swingBar, swingLow,
                     color=zigzagColor, width=zigzagWidth)
        )
    lastSwingPrice := swingLow
    lastSwingBar   := swingBar

if supplyOccured
    float swingHigh = high
    int   swingBar  = bar_index
    int   lookback  = bar_index - demandIndex
    for i = 0 to lookback
        if high[i] > swingHigh
            swingHigh := high[i]
            swingBar := bar_index - i
    if not na(lastSwingPrice)
        array.push(
            zigzagLines,
            line.new(lastSwingBar, lastSwingPrice,
                     swingBar, swingHigh,
                     color=zigzagColor, width=zigzagWidth)
        )
    lastSwingPrice := swingHigh
    lastSwingBar   := swingBar

// === Track Boxes ===
var box[] bullishBoxes = array.new<box>()
var box[] bearishBoxes = array.new<box>()

// === Mitigation Flags ===
var bool bullishMitigated = false
var bool bearishMitigated = false
var bool bullishBreak = false
var bool bearishBreak = false
bullishMitigated := false
bearishMitigated := false

// === Delete invalidated boxes ===
if deleteBrokenBoxes
    if array.size(bullishBoxes) > 0
        for i = array.size(bullishBoxes) - 1 to 0
            boxItem = array.get(bullishBoxes, i)
            if close < box.get_bottom(boxItem)
                box.delete(boxItem)
                array.remove(bullishBoxes, i)

    if array.size(bearishBoxes) > 0
        for i = array.size(bearishBoxes) - 1 to 0
            boxItem = array.get(bearishBoxes, i)
            if close > box.get_top(boxItem)
                box.delete(boxItem)
                array.remove(bearishBoxes, i)

// === Delete mitigated boxes (optional) ===
if deleteMitigatedBoxes
    if array.size(bullishBoxes) > 0
        for i = array.size(bullishBoxes) - 1 to 0
            boxItem = array.get(bullishBoxes, i)
            if low < box.get_top(boxItem)
                bullishMitigated := true
                box.delete(boxItem)
                array.remove(bullishBoxes, i)
    if array.size(bearishBoxes) > 0
        for i = array.size(bearishBoxes) - 1 to 0
            boxItem = array.get(bearishBoxes, i)
            if high > box.get_bottom(boxItem)
                bearishMitigated := true
                box.delete(boxItem)
                array.remove(bearishBoxes, i)

if dimMitigatedBoxes
    if array.size(bullishBoxes) > 0
        for i = 0 to array.size(bullishBoxes) - 1
            boxItem = array.get(bullishBoxes, i)
            if low < box.get_top(boxItem)
                bullishMitigated := true
                box.set_bgcolor(boxItem, lighterBullishColor)
                box.set_border_color(boxItem, lighterBullishColor)


    if array.size(bearishBoxes) > 0
        for i = 0 to array.size(bearishBoxes) - 1
            boxItem = array.get(bearishBoxes, i)
            if high > box.get_bottom(boxItem)
                bearishMitigated := true
                box.set_bgcolor(boxItem, lighterBearishColor)
                box.set_border_color(boxItem, lighterBearishColor)

// Create new order blocks with adjusted alignment
if showBullishOrderBlocks and demandOccured
    bullishBox = box.new(left=lastSwingBar, right=bar_index + orderBlockDuration, top=extRunningHigh, bottom=lastSwingLow, border_color=bullishBlockColor, bgcolor=bullishBlockColor)
    array.push(bullishBoxes, bullishBox)

if showBearishOrderBlocks and supplyOccured
    bearishBox = box.new(left=lastSwingBar, right=bar_index + orderBlockDuration, top=lastSwingHigh, bottom=extRunningLow, border_color=bearishBlockColor, bgcolor=bearishBlockColor)
    array.push(bearishBoxes, bearishBox)


// =====================================================================
// ================================ ALERTS ===============================
// =====================================================================

alertcondition(demandOccured, "External Bullish Reversal", "External bullish reversal occurred.")
alertcondition(supplyOccured, "External Bearish Reversal", "External bearish reversal occurred.")
