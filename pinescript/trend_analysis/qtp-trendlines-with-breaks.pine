// ═══════════════════════════════════════════════════════════════════════════
//
//  QTP - Trendlines with Breaks
//  ─────────────────────────────
//  Automatic pivot-based trendline detection with real-time breakout
//  signals, neon glow lines, and dynamic trend zone fill.
//
//  Features:
//  • Auto-detected trendlines from swing highs/lows
//  • 3 slope calculation methods (ATR, StdDev, LinReg)
//  • Neon glow effect on trendlines for high-visibility
//  • Dynamic trend zone fill between upper/lower lines
//  • Breakout arrows on the main chart
//  • Breakout bar highlighting (candle coloring)
//  • Extended dashed projection lines
//  • Built-in alert conditions for breakouts
//
// ═══════════════════════════════════════════════════════════════════════════

//@version=6
indicator("QTP - Trendlines with Breaks", shorttitle="QTP TLBreak", overlay=true)

// ─────────────────────────────────────────────────────────────────────────
//  SETTINGS
// ─────────────────────────────────────────────────────────────────────────
length     = input.int(14, "Swing Detection Lookback",          group="Detection")
mult       = input.float(1.0, "Slope Multiplier", minval=0, step=0.1, group="Detection")
calcMethod = input.string("Atr", "Slope Calculation Method",
             options=["Atr", "Stdev", "Linreg"],                group="Detection")
backpaint  = input.bool(true, "Backpaint",
             tooltip="Backpainting offsets displayed elements in the past. Disable to see real-time information.",
                                                                 group="Detection")

// ─────────────────────────────────────────────────────────────────────────
//  STYLE
// ─────────────────────────────────────────────────────────────────────────
showExt    = input.bool(true,  "Show Extended Lines",            group="Style")
showGlow   = input.bool(true,  "Neon Glow Effect",              group="Style")
showFill   = input.bool(true,  "Trend Zone Fill",               group="Style")
showArrows = input.bool(true,  "Breakout Arrows",               group="Style")
showBarCol = input.bool(true,  "Color Breakout Bars",           group="Style")

// ─────────────────────────────────────────────────────────────────────────
//  COLORS
// ─────────────────────────────────────────────────────────────────────────
col_bull      = color.new(#00D4FF, 0)     // electric blue
col_bear      = color.new(#FF1493, 0)     // hot pink
col_bull_glow = color.new(#00D4FF, 70)    // blue glow
col_bear_glow = color.new(#FF1493, 70)    // pink glow
col_bull_fill = color.new(#00D4FF, 90)    // blue zone fill
col_bear_fill = color.new(#FF1493, 90)    // pink zone fill
col_neutral   = color.new(#000000, 85)    // dark neutral fill

// ─────────────────────────────────────────────────────────────────────────
//  CALCULATIONS
// ─────────────────────────────────────────────────────────────────────────
var float upper    = 0.0
var float lower    = 0.0
var float slope_ph = 0.0
var float slope_pl = 0.0

n      = bar_index
src    = close
ph     = ta.pivothigh(length, length)
pl     = ta.pivotlow(length, length)
hasPh  = not na(ph)
hasPl  = not na(pl)

// Slope calculation
slope = switch calcMethod
    "Atr"    => ta.atr(length) / length * mult
    "Stdev"  => ta.stdev(src, length) / length * mult
    "Linreg" => math.abs(ta.sma(src * n, length) - ta.sma(src, length) * ta.sma(n, length)) / ta.variance(n, length) / 2 * mult

// Update slopes and trendlines on new pivots
slope_ph := hasPh ? slope : slope_ph
slope_pl := hasPl ? slope : slope_pl

upper := hasPh ? ph : upper - slope_ph
lower := hasPl ? pl : lower + slope_pl

// Breakout detection
var int upos = 0
var int dnos = 0
upos := hasPh ? 0 : close > upper - slope_ph * length ? 1 : upos
dnos := hasPl ? 0 : close < lower + slope_pl * length ? 1 : dnos

bullBreak = upos > upos[1]
bearBreak = dnos > dnos[1]

// ─────────────────────────────────────────────────────────────────────────
//  TRENDLINE VALUES FOR PLOTTING
// ─────────────────────────────────────────────────────────────────────────
upperPlot = backpaint ? upper : upper - slope_ph * length
lowerPlot = backpaint ? lower : lower + slope_pl * length

upperCol = hasPh ? na : col_bull
lowerCol = hasPl ? na : col_bear
upperGlowCol = hasPh ? na : col_bull_glow
lowerGlowCol = hasPl ? na : col_bear_glow

// ─────────────────────────────────────────────────────────────────────────
//  EXTENDED LINES
// ─────────────────────────────────────────────────────────────────────────
var line uptl = line.new(na, na, na, na, color=col_bull, style=line.style_dashed, extend=extend.right)
var line dntl = line.new(na, na, na, na, color=col_bear, style=line.style_dashed, extend=extend.right)

if hasPh and showExt
    uptl.set_xy1(n - length, backpaint ? ph : upper - slope_ph * length)
    uptl.set_xy2(n - length + 1, backpaint ? ph - slope : upper - slope_ph * (length + 1))

if hasPl and showExt
    dntl.set_xy1(n - length, backpaint ? pl : lower + slope_pl * length)
    dntl.set_xy2(n - length + 1, backpaint ? pl + slope : lower + slope_pl * (length + 1))

// ─────────────────────────────────────────────────────────────────────────
//  PLOTS — GLOW EFFECT (wider, transparent line behind main line)
// ─────────────────────────────────────────────────────────────────────────
plot(showGlow ? upperPlot : na, "Upper Glow", color=upperGlowCol, linewidth=4, offset=-length)
plot(showGlow ? lowerPlot : na, "Lower Glow", color=lowerGlowCol, linewidth=4, offset=-length)

// ─────────────────────────────────────────────────────────────────────────
//  PLOTS — MAIN TRENDLINES
// ─────────────────────────────────────────────────────────────────────────
p_up  = plot(upperPlot, "Upper Trendline", color=upperCol, linewidth=1, offset=-length)
p_low = plot(lowerPlot, "Lower Trendline", color=lowerCol, linewidth=1, offset=-length)

// ─────────────────────────────────────────────────────────────────────────
//  TREND ZONE FILL
// ─────────────────────────────────────────────────────────────────────────
fillColor = showFill ? col_neutral : na
fill(p_up, p_low, color=fillColor, title="Trend Zone")

// ─────────────────────────────────────────────────────────────────────────
//  BREAKOUT ARROWS
// ─────────────────────────────────────────────────────────────────────────
plotshape(showArrows and bullBreak, "Bullish Break",
  style=shape.triangleup, location=location.belowbar,
  color=col_bull, size=size.small)

plotshape(showArrows and bearBreak, "Bearish Break",
  style=shape.triangledown, location=location.abovebar,
  color=col_bear, size=size.small)

// ─────────────────────────────────────────────────────────────────────────
//  BREAKOUT BAR COLORING
// ─────────────────────────────────────────────────────────────────────────
barcolor(showBarCol and bullBreak ? col_bull : showBarCol and bearBreak ? col_bear : na)

// ─────────────────────────────────────────────────────────────────────────
//  ALERTS
// ─────────────────────────────────────────────────────────────────────────
alertcondition(bullBreak, "Bullish Breakout", "Price broke the down-trendline upward")
alertcondition(bearBreak, "Bearish Breakout", "Price broke the up-trendline downward")
