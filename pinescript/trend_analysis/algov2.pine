//@version=5
indicator("2 EMA Break + Arrows + Fixed 350 TP (Clean)", overlay=true)

// ===== SETTINGS =====
ema50_length = 50
ema2_length  = 2
tp_fixed_points = 350  // BTC-style fixed TP

// ===== EMAs =====
ema50_high = ta.ema(high, ema50_length)
ema50_low  = ta.ema(low, ema50_length)
ema2       = ta.ema(close, ema2_length)

// ===== BREAKOUT CONDITIONS =====
above_zone = ema2 > ema50_high and close > ema50_high
below_zone = ema2 < ema50_low and close < ema50_low

// ===== STATE =====
var int market_state = 0   // 1 = bullish, -1 = bearish
var float tp_price = na
var line tp_line = na

buy_signal = false
sell_signal = false

// ===== TP CALC =====
pip_value = syminfo.mintick
tp_distance = tp_fixed_points * pip_value

// ===== SIGNAL LOGIC =====
if above_zone and market_state != 1
    buy_signal := true
    market_state := 1
    tp_price := close + tp_distance

    // Remove old TP line
    if not na(tp_line)
        line.delete(tp_line)
    // Draw TP line
    tp_line := line.new(bar_index, tp_price, bar_index + 10, tp_price, color=color.green, width=2)

else if below_zone and market_state != -1
    sell_signal := true
    market_state := -1
    tp_price := close - tp_distance

    if not na(tp_line)
        line.delete(tp_line)
    tp_line := line.new(bar_index, tp_price, bar_index + 10, tp_price, color=color.red, width=2)

// ===== REMOVE TP LINE WHEN HIT =====
tp_hit_long  = market_state == 1 and high >= tp_price
tp_hit_short = market_state == -1 and low <= tp_price

if tp_hit_long or tp_hit_short
    if not na(tp_line)
        line.delete(tp_line)
    tp_price := na

// ===== TREND CLOUD (VISUAL ONLY) =====
midline = (ema50_high + ema50_low) / 2
trend_up = ema2 > midline

cloudTop = trend_up ? ema50_high : ema50_low
cloudBot = trend_up ? ema50_low : ema50_high

p1 = plot(cloudTop, display=display.none)
p2 = plot(cloudBot, display=display.none)
fill(p1, p2, color=trend_up ? color.new(color.green, 80) : color.new(color.red, 80))

// ===== PLOT SIGNALS (ARROWS ONLY) =====
plotshape(buy_signal, location=location.belowbar, style=shape.triangleup, size=size.small, color=color.lime)
plotshape(sell_signal, location=location.abovebar, style=shape.triangledown, size=size.small, color=color.red)
