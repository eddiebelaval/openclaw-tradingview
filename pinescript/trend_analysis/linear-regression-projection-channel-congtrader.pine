//@version=5
indicator("Linear Regression Projection Channel [CongTrader]", overlay = true)

// ───── Inputs ─────
length      = input.int(100,  "Regression Length",      minval = 10)
mult        = input.float(2.0,"Channel Multiplier",     step = 0.1)
extendBars  = input.int(30,   "Projection Bars",        minval = 1)
pivotLen    = input.int(5,    "Pivot Strength",         minval = 1)


// ───── Linear Regression Function ─────
f_linearRegression(_length) =>
    var float[] yVals = array.new_float()

    if bar_index == 0 or bar_index < _length
        array.clear(yVals)

    array.push(yVals, close)

    if array.size(yVals) > _length
        array.shift(yVals)

    n = array.size(yVals)

    sumX  = 0.0
    sumY  = 0.0
    sumXY = 0.0
    sumXX = 0.0

    for i = 0 to n - 1
        x = i
        y = array.get(yVals, i)
        sumX  += x
        sumY  += y
        sumXY += x * y
        sumXX += x * x

    denom     = n * sumXX - sumX * sumX
    slope     = denom != 0 ? (n * sumXY - sumX * sumY) / denom : 0.0
    intercept = (sumY - slope * sumX) / n
    regVal    = slope * (n - 1) + intercept

    sumDev = 0.0
    for i = 0 to n - 1
        y   = array.get(yVals, i)
        dev = y - (slope * i + intercept)
        sumDev += dev * dev

    stdDev = math.sqrt(sumDev / n)

    [slope, intercept, regVal, stdDev, n]


// ───── Calculations ─────
[slope, intercept, regVal, stdDev, n] = f_linearRegression(length)

trendUp    = slope > 0
trendDown  = slope < 0
trendColor = trendUp ? color.lime : color.red

upperNow = regVal + mult * stdDev
lowerNow = regVal - mult * stdDev


// ───── Regression Channel ─────
var line lineCenter = na
var line lineUpper  = na
var line lineLower  = na

if not na(lineCenter)
    line.delete(lineCenter)
if not na(lineUpper)
    line.delete(lineUpper)
if not na(lineLower)
    line.delete(lineLower)

lineCenter := line.new(
     bar_index - n + 1, intercept,
     bar_index + extendBars, regVal + slope * extendBars,
     color = color.new(color.orange, 20),
     width = 2)

lineUpper := line.new(
     bar_index - n + 1, intercept + mult * stdDev,
     bar_index + extendBars, regVal + mult * stdDev + slope * extendBars,
     color = color.new(color.red, 0))

lineLower := line.new(
     bar_index - n + 1, intercept - mult * stdDev,
     bar_index + extendBars, regVal - mult * stdDev + slope * extendBars,
     color = color.new(color.green, 0))


// ───── Pivot Detection ─────
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)


// ───── Pivot Storage ─────
var float pivot1 = na
var float pivot2 = na
var int   bar1   = na
var int   bar2   = na


// ───── Projection Variables ─────
var float slopeSwing = na
var float futurePrice = na
var line  predictLine = na
var label zoneLabel   = na

if not na(predictLine)
    line.delete(predictLine)


// ───── Trend UP → Pivot LOW ─────
if trendUp and not na(pl)
    pivotPrice = pl
    pivotBar   = bar_index - pivotLen

    pivot2 := pivot1
    bar2   := bar1

    pivot1 := pivotPrice
    bar1   := pivotBar

    label.new(
         pivotBar, pivotPrice,
         "HL",
         style = label.style_label_up,
         color = color.new(color.green, 60),
         textcolor = color.white)


// ───── Trend DOWN → Pivot HIGH ─────
if trendDown and not na(ph)
    pivotPrice = ph
    pivotBar   = bar_index - pivotLen

    pivot2 := pivot1
    bar2   := bar1

    pivot1 := pivotPrice
    bar1   := pivotBar

    label.new(
         pivotBar, pivotPrice,
         "LH",
         style = label.style_label_down,
         color = color.new(color.red, 60),
         textcolor = color.white)


// ───── Price Projection ─────
if not na(pivot1) and not na(pivot2) and (bar1 != bar2)

    slopeSwing := (pivot1 - pivot2) / (bar1 - bar2)
    futurePrice := pivot1 + slopeSwing * extendBars

    predictLine := line.new(
         bar1, pivot1,
         bar1 + extendBars, futurePrice,
         color = trendColor,
         width = 2,
         style = line.style_dashed)

    // Remove previous zone label
    if not na(zoneLabel)
        label.delete(zoneLabel)

    zoneColor = trendUp
         ? color.new(color.green, 50)
         : color.new(color.red, 50)

    zoneLabel := label.new(
         bar1 + extendBars,
         futurePrice,
         trendUp ? "BUY ZONE" : "SELL ZONE",
         style = label.style_label_center,
         color = zoneColor,
         textcolor = color.white)
