//@version=6
indicator("[Viprasol] Volume Weighted Trend Engine", shorttitle = "VP - VWTE", overlay = true, max_labels_count = 500)

// ══════════════════════════════════════════════════════════════
// Constants
// ══════════════════════════════════════════════════════════════

const color DASH_BG        = #111725
const color DASH_BORDER    = #000000
const color DASH_HEADER_BG = #18233a
const int   VOL_AVG_LEN    = 20

// ══════════════════════════════════════════════════════════════
// Inputs
// ══════════════════════════════════════════════════════════════

// — Core Settings
grpCore = "Core Settings"
vwmaPeriodInput   = input.int(34, "VWMA Length", minval = 5, maxval = 500, group = grpCore, tooltip = "Period for the Volume Weighted Moving Average. Shorter = more responsive to price, longer = smoother trend line.")
atrMultInput      = input.float(1.5, "ATR Multiplier", minval = 0.1, step = 0.1, group = grpCore, tooltip = "Width of the volatility bands around the VWMA. Higher values create wider bands and generate fewer, more significant signals.")
priceSourceInput  = input.source(close, "Price Source", group = grpCore, tooltip = "Price source for the VWMA calculation.")

// — Signal Filters
grpFilter = "Signal Filters"
cooldownInput     = input.int(0, "Signal Cooldown (Bars)", minval = 0, maxval = 50, group = grpFilter, tooltip = "Minimum bars between consecutive signals. 0 = no cooldown. Higher values reduce noise in choppy markets.")
volFilterInput    = input.bool(false, "Require Volume Confirmation", group = grpFilter, tooltip = "When enabled, signals only fire if volume is above the 20-bar average. Filters out low-conviction breakouts.")
squeezeThreshInput = input.float(0.8, "Squeeze Threshold", minval = 0.1, maxval = 2.0, step = 0.1, group = grpFilter, tooltip = "Band width percentage below which a squeeze is detected. Lower = tighter squeeze required.")

// — Visual Settings
grpVisual = "Visual Settings"
bullColorInput    = input.color(#00ffaa, "Bullish Color", group = grpVisual, tooltip = "Color for bullish trend state across all visual elements.")
bearColorInput    = input.color(#ff0000, "Bearish Color", group = grpVisual, tooltip = "Color for bearish trend state across all visual elements.")
showFillsInput    = input.bool(true, "Show Band Fills", group = grpVisual, tooltip = "Fill the area between the VWMA and the bands with semi-transparent color.")
showGlowInput     = input.bool(true, "Show Glow Effect", group = grpVisual, tooltip = "Display a soft glow behind the VWMA line for enhanced visibility.")
showBarsInput     = input.bool(true, "Color Bars", group = grpVisual, tooltip = "Color candlesticks based on the current trend direction.")
showLabelsInput   = input.bool(true, "Show Signal Labels", group = grpVisual, tooltip = "Display detailed labels with price at signal points.")
showStrengthBgInput = input.bool(false, "Show Trend Strength Background", group = grpVisual, tooltip = "Subtle background tint that intensifies as price moves further from the VWMA toward the bands.")

// — Dashboard
grpDash = "Dashboard"
showDashInput     = input.bool(true, "Show Dashboard", group = grpDash, tooltip = "Display the real-time trend information dashboard.")
dashPositionInput = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpDash, tooltip = "Dashboard position on the chart.")
dashSizeInput     = input.string("Small", "Font Size", options = ["Tiny", "Small", "Normal", "Large"], group = grpDash, tooltip = "Text size for dashboard cells.")

// ══════════════════════════════════════════════════════════════
// Core Calculations
// ══════════════════════════════════════════════════════════════

vwmaLine   = ta.vwma(priceSourceInput, vwmaPeriodInput)
atrValue   = ta.atr(vwmaPeriodInput)
upperBand  = vwmaLine + atrValue * atrMultInput
lowerBand  = vwmaLine - atrValue * atrMultInput

// Trend detection — holds direction until opposite band is breached
var int trendDirection = 0
if priceSourceInput > upperBand
    trendDirection := 1
else if priceSourceInput < lowerBand
    trendDirection := -1

// Raw signals (before filters)
rawBullSignal = trendDirection == 1 and trendDirection[1] != 1
rawBearSignal = trendDirection == -1 and trendDirection[1] != -1

// ══════════════════════════════════════════════════════════════
// Signal Filters
// ══════════════════════════════════════════════════════════════

// Cooldown filter
var int lastSignalBar = 0
cooldownOk = cooldownInput == 0 or (bar_index - lastSignalBar) >= cooldownInput

// Volume confirmation filter
volAvg       = ta.sma(volume, VOL_AVG_LEN)
isVolAboveAvg = volume > volAvg
volOk        = volFilterInput ? isVolAboveAvg : true

// Final filtered signals
bullSignal = rawBullSignal and cooldownOk and volOk
bearSignal = rawBearSignal and cooldownOk and volOk

if bullSignal or bearSignal
    lastSignalBar := bar_index

// ══════════════════════════════════════════════════════════════
// Trend Strength & Squeeze Detection
// ══════════════════════════════════════════════════════════════

// Trend strength: position within bands as percentage (-100 to +100)
// 0 = at VWMA, +100 = at upper band, -100 = at lower band
bandWidth     = upperBand - lowerBand
trendStrength = bandWidth > 0 ? ((priceSourceInput - vwmaLine) / (bandWidth / 2.0)) * 100.0 : 0.0
trendStrength := math.max(-100.0, math.min(100.0, trendStrength))

// Band width as percentage of price
bandWidthPct  = vwmaLine > 0 ? (bandWidth / vwmaLine) * 100.0 : 0.0

// Squeeze detection: band width below its own SMA * threshold
bandWidthAvg  = ta.sma(bandWidthPct, 50)
isSqueeze     = bandWidthPct < bandWidthAvg * squeezeThreshInput
squeezeStart  = isSqueeze and not isSqueeze[1]

// Bars since last signal
barsSinceSignal = math.min(ta.barssince(bullSignal or bearSignal), 9999)

// ══════════════════════════════════════════════════════════════
// Visuals — VWMA & Bands
// ══════════════════════════════════════════════════════════════

trendColor = trendDirection == 1 ? bullColorInput : bearColorInput

// Glow layers
plot(showGlowInput ? vwmaLine : na, "Glow 1", color.new(trendColor, 85), 10)
plot(showGlowInput ? vwmaLine : na, "Glow 2", color.new(trendColor, 60), 6)
vwmaPlot = plot(vwmaLine, "VWMA", color.new(trendColor, 0), 2)

upperPlot = plot(upperBand, "Upper Band", color = color.new(trendColor, 88))
upperMidPlot = plot(math.avg(upperBand, vwmaLine), "Upper Mid", color = color.new(trendColor, 95))
lowerPlot = plot(lowerBand, "Lower Band", color = color.new(trendColor, 88))
lowerMidPlot = plot(math.avg(lowerBand, vwmaLine), "Lower Mid", color = color.new(trendColor, 95))

// Band fills
fillColOuter = showFillsInput ? color.new(trendColor, 90) : color(na)
fillColInner = showFillsInput ? color.new(trendColor, 78) : color(na)
fill(upperPlot, upperMidPlot, fillColOuter, title = "Upper Outer")
fill(upperMidPlot, vwmaPlot, fillColInner, title = "Upper Inner")
fill(lowerPlot, lowerMidPlot, fillColOuter, title = "Lower Outer")
fill(lowerMidPlot, vwmaPlot, fillColInner, title = "Lower Inner")

// ══════════════════════════════════════════════════════════════
// Visuals — Trend Strength Background
// ══════════════════════════════════════════════════════════════

strengthAlpha = math.round(95 - math.abs(trendStrength) * 0.15)
strengthBgCol = trendDirection == 1 ? color.new(bullColorInput, strengthAlpha) : trendDirection == -1 ? color.new(bearColorInput, strengthAlpha) : na
bgcolor(showStrengthBgInput ? strengthBgCol : na, title = "Trend Strength Background")

// ══════════════════════════════════════════════════════════════
// Visuals — Bar Coloring
// ══════════════════════════════════════════════════════════════

barCol = trendDirection == 1 ? color.new(bullColorInput, 30) : color.new(bearColorInput, 30)
barcolor(showBarsInput ? barCol : color(na), title = "Bar Color")

// ══════════════════════════════════════════════════════════════
// Visuals — Signal Shapes & Labels
// ══════════════════════════════════════════════════════════════

plotshape(bullSignal, "Bull Signal", shape.triangleup, location.belowbar, bullColorInput, size = size.small)
plotshape(bearSignal, "Bear Signal", shape.triangledown, location.abovebar, bearColorInput, size = size.small)

if showLabelsInput and bullSignal
    label.new(bar_index, low * 0.999, "LONG\n" + str.tostring(close, format.mintick), color = color.new(bullColorInput, 15), textcolor = color.white, style = label.style_label_up, size = size.small)

if showLabelsInput and bearSignal
    label.new(bar_index, high * 1.001, "SHORT\n" + str.tostring(close, format.mintick), color = color.new(bearColorInput, 15), textcolor = color.white, style = label.style_label_down, size = size.small)

// Squeeze diamond markers on VWMA
plotshape(isSqueeze, "Squeeze", shape.diamond, location.absolute, color.new(#FFC107, 40), size = size.tiny, offset = 0)

// ══════════════════════════════════════════════════════════════
// Visuals — Dashboard
// ══════════════════════════════════════════════════════════════

tablePos  = dashPositionInput == "Top Right" ? position.top_right : dashPositionInput == "Top Left" ? position.top_left : dashPositionInput == "Bottom Right" ? position.bottom_right : position.bottom_left
tableSize = dashSizeInput == "Tiny" ? size.tiny : dashSizeInput == "Small" ? size.small : dashSizeInput == "Normal" ? size.normal : size.large

var table dashTable = table.new(tablePos, 2, 9, bgcolor = color.new(DASH_BG, 35), border_color = color.new(#373a46, 100), border_width = 1, frame_color = DASH_BORDER, frame_width = 1)

if showDashInput and barstate.islast
    table.clear(dashTable, 0, 0, 1, 8)

    // Row 0 — Header
    table.cell(dashTable, 0, 0, "  VIPRASOL  ", text_color = color.white, text_size = tableSize, bgcolor = DASH_HEADER_BG, text_halign = text.align_left)
    table.cell(dashTable, 1, 0, "VWT Engine", text_color = color.new(color.white, 40), text_size = tableSize, bgcolor = DASH_HEADER_BG)

    // Row 1 — Trend
    trendTxt = trendDirection == 1 ? "BULLISH" : trendDirection == -1 ? "BEARISH" : "NEUTRAL"
    trendClr = trendDirection == 1 ? bullColorInput : trendDirection == -1 ? bearColorInput : color.gray
    table.cell(dashTable, 0, 1, "Trend", text_color = color.new(color.white, 30), text_size = tableSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 1, trendTxt, text_color = trendClr, text_size = tableSize)

    // Row 2 — Trend Strength
    strengthTxt = str.tostring(trendStrength, "#.0") + "%"
    strengthClr = math.abs(trendStrength) > 70 ? (trendDirection == 1 ? bullColorInput : bearColorInput) : math.abs(trendStrength) > 30 ? color.yellow : color.gray
    table.cell(dashTable, 0, 2, "Strength", text_color = color.new(color.white, 30), text_size = tableSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 2, strengthTxt, text_color = strengthClr, text_size = tableSize)

    // Row 3 — VWMA Value
    table.cell(dashTable, 0, 3, "VWMA(" + str.tostring(vwmaPeriodInput) + ")", text_color = color.new(color.white, 30), text_size = tableSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 3, str.tostring(vwmaLine, format.mintick), text_color = color.new(color.white, 50), text_size = tableSize)

    // Row 4 — ATR
    table.cell(dashTable, 0, 4, "ATR", text_color = color.new(color.white, 30), text_size = tableSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 4, str.tostring(atrValue, format.mintick), text_color = color.new(color.white, 50), text_size = tableSize)

    // Row 5 — Band Width
    table.cell(dashTable, 0, 5, "Band Width", text_color = color.new(color.white, 30), text_size = tableSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 5, str.tostring(bandWidthPct, "#.##") + "%", text_color = color.new(color.white, 50), text_size = tableSize)

    // Row 6 — Squeeze
    squeezeTxt = isSqueeze ? "ACTIVE" : "None"
    squeezeClr = isSqueeze ? #FFC107 : color.gray
    table.cell(dashTable, 0, 6, "Squeeze", text_color = color.new(color.white, 30), text_size = tableSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 6, squeezeTxt, text_color = squeezeClr, text_size = tableSize)

    // Row 7 — Volume
    volTxt = isVolAboveAvg ? "ABOVE AVG" : "BELOW AVG"
    volClr = isVolAboveAvg ? bullColorInput : color.gray
    table.cell(dashTable, 0, 7, "Volume", text_color = color.new(color.white, 30), text_size = tableSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 7, volTxt, text_color = volClr, text_size = tableSize)

    // Row 8 — Footer
    table.cell(dashTable, 0, 8, "(c) Viprasol", text_color = color.new(color.white, 70), text_size = size.tiny, text_halign = text.align_left)
    table.cell(dashTable, 1, 8, "v1.0.0", text_color = color.new(color.white, 70), text_size = size.tiny)

// ══════════════════════════════════════════════════════════════
// Alerts
// ══════════════════════════════════════════════════════════════

alertcondition(bullSignal, "Bullish Signal", "VWT BULLISH on {{ticker}} at {{close}} on {{interval}}")
alertcondition(bearSignal, "Bearish Signal", "VWT BEARISH on {{ticker}} at {{close}} on {{interval}}")
alertcondition(bullSignal or bearSignal, "Trend Change", "VWT trend changed on {{ticker}} at {{close}} on {{interval}}")
alertcondition(squeezeStart, "Squeeze Started", "VWT squeeze detected on {{ticker}} on {{interval}} — bands compressing")
alertcondition(bullSignal and isVolAboveAvg, "Volume Confirmed Bull", "VWT BULLISH with volume confirmation on {{ticker}} at {{close}} on {{interval}}")
alertcondition(bearSignal and isVolAboveAvg, "Volume Confirmed Bear", "VWT BEARISH with volume confirmation on {{ticker}} at {{close}} on {{interval}}")
alertcondition(math.abs(trendStrength) > 90, "Trend Strength Extreme", "VWT trend strength extreme on {{ticker}} at {{close}} on {{interval}}")
alertcondition(priceSourceInput > upperBand or priceSourceInput < lowerBand, "Band Touch", "VWT price touching band on {{ticker}} at {{close}} on {{interval}}")
