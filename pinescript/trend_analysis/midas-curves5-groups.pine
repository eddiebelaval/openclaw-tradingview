//------------------------------------------------------------------------------
// Helper label function
plabel(ptext, pcolor, ptextcolor, psize) =>
    label.new(bar_index, na, text=str.tostring(ptext), color=pcolor, textcolor=ptextcolor, size=psize, style=label.style_label_down, yloc=yloc.abovebar)

//------------------------------------------------------------------------------
// MIDAS Curve Calculation ORIGINAL
// midasCurve(src, anchor_time) =>
//     var float startVol = na
//     var float startVolPrice = na
//     var float cumVol = 0.0
//     var float cumVolPrice = 0.0
//     float result = na

//     in_range = time >= anchor_time
//     if in_range
//         cumVol += volume
//         cumVolPrice += volume * src
//         if na(startVol)
//             startVol := cumVol
//             startVolPrice := cumVolPrice
//         result := (cumVolPrice - startVolPrice) / (cumVol - startVol)

//     result

//------------------------------------------------------------------------------
// MIDAS Curve Calculation 
midasCurve(src, anchor_time) =>
    var float startVol = na
    var float startVolPrice = na
    var float cumVol = 0.0
    var float cumVolPrice = 0.0
    float result = na

    in_range = time >= anchor_time
    if in_range
        cumVol += volume
        cumVolPrice += volume * src
        if na(startVol)
            startVol := volume
            startVolPrice := volume * src
            result := src  // set the first value directly to the price at anchor
            result
        else
            cumVol += volume
            cumVolPrice += volume * src
            result := (cumVolPrice - startVolPrice) / (cumVol - startVol)
            result
    result

//------------------------------------------------------------------------------

