//@version=5
indicator('MIDAS Curves[5 groups]', shorttitle='MIDAS [5]', overlay=true)

//plot(bar_index, style=plot.style_area, color=color.yellow, transp=100) DEBUG for TB-F

//------------------------------------------------------------------------------
// Inputs

md1_enabled = input.bool(false, '#1 Enable', group='1')
