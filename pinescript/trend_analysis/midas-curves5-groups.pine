md1_enabled_ofset = input.bool(false, '#1 Offset channel', group='1')
md1_offset_source = input.source(low, '#1 Offset source', group='1')
md1_offset_value_high = input.float(0, '#1 Offset high', step=0.0001, group='1')
md1_offset_value_low = input.float(0, '#1 Offset low', step=0.0001, group='1')

