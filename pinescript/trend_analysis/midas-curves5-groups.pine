//     var float vol_at_anchor = na
//     var float priceVol_at_anchor = na
//     float result = na
//     float xi = 0.0
//     float yi = 0.0

//     in_range = time >= anchor_time
//     if in_range
//         xi := nz(xi[1]) + volume
//         yi := nz(yi[1]) + src * volume
//         if na(vol_at_anchor)
//             vol_at_anchor := xi
//             priceVol_at_anchor := yi
//         dij = xi - vol_at_anchor
//         e = dij * (1 - dij / D)
//         result := e != 0 ? (yi - priceVol_at_anchor) / e : na

//     result

//------------------------------------------------------------------------------
// MIDAS #1

md1_active = md1_enabled and time >= md1_date
midas1_high = midasCurve(md1_src_high, md1_date)
midas1_mid = midasCurve(md1_src_mid, md1_date)
midas1_low = midasCurve(md1_src_low, md1_date)

midas1_offset_high = midasCurve(md1_offset_source, md1_date)
midas1_offset_low = midasCurve(md1_offset_source, md1_date)

// tbf1_high = tbfCurve(md1_src_high, md1_date, tbf_D)
// tbf1_mid  = tbfCurve(md1_src_mid, md1_date, tbf_D)
// tbf1_low  = tbfCurve(md1_src_low, md1_date, tbf_D)

if md1_active and time[0] <= md1_date
    plabel(md1_lbl_text, md1_lbl_color, md1_lbl_text_color, md1_lbl_size)

plot1_high = plot(md1_enabled ? midas1_high : na, color=color.new(color.red, 0), title='1 MIDAS High', linewidth=1)
plot1_mid = plot(md1_enabled ? midas1_mid : na, color=color.new(color.red, 0), title='1 MIDAS Mid', linewidth=1)
plot1_low = plot(md1_enabled ? midas1_low : na, color=color.new(color.red, 0), title='1 MIDAS Low', linewidth=1)
fill(plot1_high, plot1_low, color=color.new(color.red, 50), title='1 MIDAS Fill')

plot1_high_offset = plot(md1_enabled_ofset ? midas1_offset_high + md1_offset_value_high : na, color=color.new(color.red, 0), title='1 Offset high', linewidth=1)
plot1_low_offset = plot(md1_enabled_ofset ? midas1_offset_low - md1_offset_value_low : na, color=color.new(color.red, 0), title='1 Offset low', linewidth=1)


