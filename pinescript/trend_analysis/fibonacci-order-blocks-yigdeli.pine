//──────────────────────────────────────────────────────────────────────────────
// SUP / RES VOLUME
// DESTEK / DIRENC HACIM
//──────────────────────────────────────────────────────────────────────────────
int prd1 = input.int(
     30,
     "Pivot Period            ",
     minval = 5,
     maxval = 200,
     inline = "sr1",
     group = "SUP / RES VOLUME",
     tooltip = "Number of bars used for pivot detection and support/resistance anchoring.\nTürkçesi: Pivot tespiti ve destek/direnç konumlandırması için kullanılan bar sayısı."
)

int maxLookback = input.int(
     900,
     "Maximum Lookback",
     minval = 100,
     maxval = 1000,
     inline = "sr2",
     group = "SUP / RES VOLUME",
     tooltip = "Maximum number of historical bars checked while calculating support/resistance volume.\nTürkçesi: Destek/direnç hacmi hesaplanırken taranacak maksimum geçmiş bar sayısı."
)

int levs = input.int(
     24,
     "Volume Segments    ",
