     maxval = 50,
     inline = "sr3",
     group = "SUP / RES VOLUME",
     tooltip = "Number of price segments used to distribute volume inside support/resistance zones.\nTürkçesi: Destek/direnç bölgeleri içindeki hacmi dağıtmak için kullanılan fiyat dilim sayısı."
)

SupCol = input.color(
     color.new(#0E2C38, 0),
     "Support Zone Color    ",
     inline = "sr4",
     group = "SUP / RES VOLUME",
     tooltip = "Background color of the main support zone box.\nTürkçesi: Ana destek bölgesi kutusunun arka plan rengi."
)

