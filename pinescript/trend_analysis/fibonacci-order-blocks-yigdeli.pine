//---------------------------------------------------------------------------------------------------------------------//
// OBJECT STORAGE
// OBJE DEPOLAMA
//---------------------------------------------------------------------------------------------------------------------//
type store
    line[] ln
    label[] lb
    box[] bx
    box[] fibBx
    box[] infoBx
    linefill[] lf

var store data = store.new(
    array.new<line>(),
    array.new<label>(),
    array.new<box>(),
    array.new<box>(),
    array.new<box>(),
    array.new<linefill>()
)

//---------------------------------------------------------------------------------------------------------------------//
// CLEANUP FUNCTIONS
// TEMIZLEME FONKSIYONLARI
//---------------------------------------------------------------------------------------------------------------------//
if barstate.islast
    for obj in data.ln
        line.delete(obj)
    for obj in data.lb
        label.delete(obj)
    for obj in data.lf
        linefill.delete(obj)
    for obj in data.fibBx
        box.delete(obj)
    for obj in data.infoBx
        box.delete(obj)

    data.ln.clear()
    data.lb.clear()
    data.lf.clear()
    data.fibBx.clear()
    data.infoBx.clear()


    for obj in data.bx
        box.delete(obj)
    data.bx.clear()


//---------------------------------------------------------------------------------------------------------------------//
// COMMON HELPERS
// ORTAK YARDIMCILAR
//---------------------------------------------------------------------------------------------------------------------//
get_line_style(style) =>
    switch style
        "⎯⎯⎯" => line.style_solid
        "----" => line.style_dashed
        "····" => line.style_dotted

get_text_size(sizeInput) =>
    switch sizeInput
        "Auto"   => size.auto
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge

textSize = get_text_size(boxTextSizeInput)

_crossing_level(sr, r) =>
    (r > sr and r < sr[1]) or (r < sr and r > sr[1])

zone_volumes(zoneTop, zoneBot) =>
    float buyVol = 0.0
    float sellVol = 0.0

    int lookback = math.min(maxLookback, bar_index)

    for i = 0 to lookback
        float bHigh = high[i]
        float bLow = low[i]
        float bOpen = open[i]
        float bClose = close[i]
        float bVol = nz(volume[i], 0)

        if bVol > 0
            float overlapLo = math.max(bLow, zoneBot)
            float overlapHi = math.min(bHigh, zoneTop)
            float overlap = overlapHi - overlapLo

            if overlap > 0
                float rangeSize = bHigh - bLow
                rangeSize := rangeSize <= 0 ? syminfo.mintick : rangeSize

                float vAdd = bVol * (overlap / rangeSize)

                if bClose >= bOpen
                    buyVol += vAdd
                else
                    sellVol += vAdd

    [buyVol, sellVol]

//---------------------------------------------------------------------------------------------------------------------//
// SUP / RES CORE
// DESTEK / DIRENC ANA MANTIK
//---------------------------------------------------------------------------------------------------------------------//
int atrLen = 30
float mult = 0.5
float per = 10.0
float percent = close * (per / 100)
float srdatr = ta.atr(atrLen) * mult
float band = math.min(srdatr, percent)[20] / 2

var int phL11 = na
var int plL11 = na

pvtHi = ta.pivothigh(high, prd1, prd1)
pvtLo = ta.pivotlow(low, prd1, prd1)

if bool(pvtHi)
    phL11 := bar_index[prd1]

if bool(pvtLo)
    plL11 := bar_index[prd1]

if barstate.islast

    float lowestValueLast = low
    float highestValueLast = high
    int lowestIndexLast = bar_index
    int highestIndexLast = bar_index

    int lastPivotIndex = na(phL11) and na(plL11) ? na : na(phL11) ? plL11 : na(plL11) ? phL11 : math.max(phL11, plL11)
    int count = na(lastPivotIndex) ? prd1 : math.max(1, bar_index - lastPivotIndex)
    int limit = math.min(count, maxLookback)

    for i = 1 to limit
        if low[i] <= lowestValueLast
            lowestValueLast := low[i]
            lowestIndexLast := bar_index - i

        if high[i] >= highestValueLast
            highestValueLast := high[i]
            highestIndexLast := bar_index - i

    [supBuyVol, supSellVol] = zone_volumes(lowestValueLast + (band * 2), lowestValueLast)
    [resBuyVol, resSellVol] = zone_volumes(highestValueLast, highestValueLast - (band * 2))

    int xRight = bar_index + uzaklik
    int supTotalWidth = math.max(xRight - lowestIndexLast, 1)
    int resTotalWidth = math.max(xRight - highestIndexLast, 1)

    float supTotalVol = supBuyVol + supSellVol
    if supTotalVol > 0
        int supBuyW = int(math.round(supTotalWidth * supBuyVol / supTotalVol))
        int supSellW = int(math.round(supTotalWidth * supSellVol / supTotalVol))

        if supBuyVol > 0 and supBuyW == 0
            supBuyW := 1
        if supSellVol > 0 and supSellW == 0
            supSellW := 1

        color buyColorSup = color.new(obactup, supBuyVol >= supSellVol ? 30 : 65)
        color sellColorSup = color.new(obactdn, supSellVol > supBuyVol ? 30 : 65)

        box supBox = box.new(
            lowestIndexLast,
            lowestValueLast + (band * 2),
            xRight,
            lowestValueLast,
            bgcolor = SupCol,
            border_color = chart.bg_color,
            text = str.tostring(supTotalVol, format.volume),
            text_color = color.white,
            text_halign = text.align_right,
            text_valign = text.align_center,
            text_size = textSize
        )
        data.bx.unshift(supBox)

        box buyBox1 = box.new(
            lowestIndexLast,
            lowestValueLast + (band * 2),
            lowestIndexLast + supBuyW,
            lowestValueLast + band,
            border_color = chart.bg_color,
            bgcolor = buyColorSup,
            text = str.tostring(supBuyVol, format.volume),
            text_color = color.white,
            text_size = textSize
        )
        data.bx.unshift(buyBox1)

        box sellBox1 = box.new(
            lowestIndexLast,
            lowestValueLast + band,
            lowestIndexLast + supSellW,
            lowestValueLast,
            border_color = chart.bg_color,
            bgcolor = sellColorSup,
            text = str.tostring(supSellVol, format.volume),
            text_color = color.white,
            text_size = textSize
        )
        data.bx.unshift(sellBox1)

    float resTotalVol = resBuyVol + resSellVol
    if resTotalVol > 0
        int resBuyW = int(math.round(resTotalWidth * resBuyVol / resTotalVol))
        int resSellW = int(math.round(resTotalWidth * resSellVol / resTotalVol))

        if resBuyVol > 0 and resBuyW == 0
            resBuyW := 1
        if resSellVol > 0 and resSellW == 0
            resSellW := 1

        color buyColorRes = color.new(obactup, resBuyVol >= resSellVol ? 30 : 65)
        color sellColorRes = color.new(obactdn, resSellVol > resBuyVol ? 30 : 65)

        box resBox = box.new(
            highestIndexLast,
            highestValueLast,
            xRight,
            highestValueLast - (band * 2),
            bgcolor = ResCol,
            border_color = chart.bg_color,
            text = str.tostring(resTotalVol, format.volume),
            text_color = color.white,
            text_halign = text.align_right,
            text_valign = text.align_center,
            text_size = textSize
        )
        data.bx.unshift(resBox)

        box buyBox2 = box.new(
            highestIndexLast,
            highestValueLast,
            highestIndexLast + resBuyW,
            highestValueLast - band,
            border_color = chart.bg_color,
            bgcolor = buyColorRes,
            text = str.tostring(resBuyVol, format.volume),
            text_color = color.white,
            text_size = textSize
        )
        data.bx.unshift(buyBox2)

        box sellBox2 = box.new(
            highestIndexLast,
            highestValueLast - band,
            highestIndexLast + resSellW,
            highestValueLast - (band * 2),
            border_color = chart.bg_color,
            bgcolor = sellColorRes,
            text = str.tostring(resSellVol, format.volume),
            text_color = color.white,
            text_size = textSize
        )
        data.bx.unshift(sellBox2)

//---------------------------------------------------------------------------------------------------------------------//
// FIBONACCI CORE
// FIBONACCI ANA MANTIK
//---------------------------------------------------------------------------------------------------------------------//
var int backgroundTransparency = 100
var line lineLast = na
var int iLast = 0
var int iPrev = 0
var float pLast = 0.0
var bool isHighLast = false

var extending = extend.none
extending :=
     extendLeft and extendRight ? extend.both :
     extendLeft and not extendRight ? extend.left :
     not extendLeft and extendRight ? extend.right :
     extend.none

string levelsFormat = "Values"
int pivotLen = math.max(1, int(math.floor(depth / 2)))
dev_threshold = ta.atr(10) / close * 100 * threshold_multiplier

pivots(src, length, isHigh) =>
    int l2 = length * 2
    float c = nz(src[length])
    bool ok = true
    for i = 0 to l2
        if isHigh and src[i] > c
            ok := false
        if not isHigh and src[i] < c
            ok := false
    if ok
        [bar_index[length], c]
    else
        [int(na), float(na)]

calc_dev(base_price, price) =>
    100 * (price - base_price) / price

pivotFound(dev, isHigh, index, price) =>
    if isHighLast == isHigh and not na(lineLast)
        if isHighLast ? price > pLast : price < pLast
            line.set_xy2(lineLast, index, price)
            [lineLast, isHighLast]
        else
            [line(na), bool(na)]
    else
        if math.abs(dev) > dev_threshold
            id = line.new(iLast, pLast, index, price, color = color.rgb(221, 221, 221), width = 1, style = line.style_dashed)
            [id, isHigh]
        else
            [line(na), bool(na)]

[iH1, pH] = pivots(high, pivotLen, true)
[iL1, pL] = pivots(low, pivotLen, false)

if not na(iH1)
    dev = calc_dev(pLast, pH)
    [id, isHigh] = pivotFound(dev, true, iH1, pH)
    if not na(id)
        if id != lineLast and not na(lineLast)
            line.delete(lineLast)
        lineLast := id
        isHighLast := isHigh
        iPrev := iLast
        iLast := iH1
        pLast := pH
else if not na(iL1)
    dev = calc_dev(pLast, pL)
    [id, isHigh] = pivotFound(dev, false, iL1, pL)
    if not na(id)
        if id != lineLast and not na(lineLast)
            line.delete(lineLast)
        lineLast := id
        isHighLast := isHigh
        iPrev := iLast
        iLast := iL1
        pLast := pL

_draw_line(price, col) =>
    int x1 = not na(lineLast) ? line.get_x1(lineLast) : iLast
    int x2 = bar_index + uzaklik

    id = line.new(
         x1,
         price,
         x2,
         price,
         color = col,
         width = 1,
         style = get_line_style(fib_style),
         extend = extending
     )

    data.ln.unshift(id)
    id
draw_info_box(level, price, colorL) =>
    int fibX2 = bar_index + uzaklik
    int totalX1 = fibX2 + 10

    int totalX2 = totalX1 + totalBoxWidth
    int infoX1 = totalX2
    int infoX2 = infoX1 + infoBoxWidth

    float yTop = price + band
    float yMid = price
    float yBot = price - band

    [buyVol, sellVol] = zone_volumes(price + band, price - band)
    float totalVol = buyVol + sellVol

    color infoTopColor = color.new(colorL, 85)
    color infoBotColor = color.new(colorL, 85)
    color totalBoxColor = color.new(colorL, 85)

    string levelTxt = levelsFormat == "Values" ? str.tostring(level) : str.tostring(level * 100) + "%"
    string priceTxt = str.tostring(price, format.mintick)
    string totalTxt = totalVol > 0 ? str.tostring(totalVol, format.volume) : "0"

    box totalBox = box.new(
         totalX1,
         yTop,
         totalX2,
         yBot,
         border_color = chart.bg_color,
         bgcolor = totalBoxColor,
         text = totalTxt,
         text_color = color.white,
         text_size = textSize
     )
    data.infoBx.unshift(totalBox)

    box levelBox = box.new(
         infoX1,
         yTop,
         infoX2,
         yMid,
         border_color = chart.bg_color,
         bgcolor = infoTopColor,
         text = levelTxt,
         text_color = color.white,
         text_size = textSize
     )
    data.infoBx.unshift(levelBox)

    box priceBox = box.new(
         infoX1,
         yMid,
         infoX2,
         yBot,
         border_color = chart.bg_color,
         bgcolor = infoBotColor,
         text = priceTxt,
         text_color = color.white,
         text_size = textSize
     )
    data.infoBx.unshift(priceBox)

draw_fib_boxes(price, colorL) =>
    int x1 = not na(lineLast) ? line.get_x1(lineLast) : iLast
    int x2 = bar_index + uzaklik
    int totalWidth = math.max(x2 - x1, 1)

    [buyVol, sellVol] = zone_volumes(price + band, price - band)
    float totalVol = buyVol + sellVol

    box mainBox = box.new(
         x1,
         price + band,
         x2,
         price - band,
         bgcolor = color.new(colorL, 85),
         border_color = chart.bg_color
     )
    data.fibBx.unshift(mainBox)

    if totalVol <= 0
        int halfW = math.max(int(math.round(totalWidth * 0.5)), 1)

        box buyBox = box.new(
            x1,
            price + band,
            x1 + halfW,
            price,
            border_color = chart.bg_color,
            bgcolor = color.new(obactup, 80),
            text = "0",
            text_color = color.white,
            text_size = textSize
        )
        data.fibBx.unshift(buyBox)

        box sellBox = box.new(
            x1,
            price,
            x1 + halfW,
            price - band,
            border_color = chart.bg_color,
            bgcolor = color.new(obactdn, 80),
            text = "0",
            text_color = color.white,
            text_size = textSize
        )
        data.fibBx.unshift(sellBox)
    else
        int buyW = int(math.round(totalWidth * buyVol / totalVol))
        int sellW = int(math.round(totalWidth * sellVol / totalVol))

        if buyVol > 0 and buyW == 0
            buyW := 1
        if sellVol > 0 and sellW == 0
            sellW := 1

        color buyColor = color.new(obactup, buyVol >= sellVol ? 30 : 65)
        color sellColor = color.new(obactdn, sellVol > buyVol ? 30 : 65)

        if buyW > 0
            box buyBox = box.new(
                 x1,
                 price + band,
                 x1 + buyW,
                 price,
                 border_color = chart.bg_color,
                 bgcolor = buyColor,
                 text = str.tostring(buyVol, format.volume),
                 text_color = color.white,
                 text_size = textSize
             )
            data.fibBx.unshift(buyBox)

        if sellW > 0
            box sellBox = box.new(
                 x1,
                 price,
                 x1 + sellW,
                 price - band,
                 border_color = chart.bg_color,
                 bgcolor = sellColor,
                 text = str.tostring(sellVol, format.volume),
                 text_color = color.white,
                 text_size = textSize
             )
            data.fibBx.unshift(sellBox)

processLevel(show, value, colorL, lineIdOther, startPrice, diff) =>
    if show and not na(startPrice) and not na(diff)
        float m = value
        float r = startPrice + diff * m

        draw_fib_boxes(r, colorL)

        lineId = _draw_line(r, colorL)
        draw_info_box(m, r, colorL)

        if not na(lineIdOther)
            fillId = linefill.new(lineId, lineIdOther, color = color.new(colorL, backgroundTransparency))
            data.lf.unshift(fillId)

        lineId
    else
        lineIdOther

if barstate.islast


    float startPrice = na
    float endPrice = na
    float diff = na

    if not na(lineLast)
        startPrice := reverse ? line.get_y1(lineLast) : pLast
        endPrice := reverse ? pLast : line.get_y1(lineLast)

        bool iHL = startPrice > endPrice
        diff := (iHL ? -1 : 1) * math.abs(startPrice - endPrice)

    lineId0  = processLevel(show_neg_0_65,  value_neg_0_65,  color_neg_0_65,  line(na), startPrice, diff)
    lineId1  = processLevel(show_neg_0_618, value_neg_0_618, color_neg_0_618, lineId0,  startPrice, diff)
    lineId2  = processLevel(show_neg_0_382, value_neg_0_382, color_neg_0_382, lineId1,  startPrice, diff)
    lineId3  = processLevel(show_neg_0_236, value_neg_0_236, color_neg_0_236, lineId2,  startPrice, diff)

    lineId4  = processLevel(show_0,         value_0,         color_0,         lineId3,  startPrice, diff)
    lineId5  = processLevel(show_0_236,     value_0_236,     color_0_236,     lineId4,  startPrice, diff)
    lineId6  = processLevel(show_0_382,     value_0_382,     color_0_382,     lineId5,  startPrice, diff)
    lineId7  = processLevel(show_0_5,       value_0_5,       color_0_5,       lineId6,  startPrice, diff)
    lineId8  = processLevel(show_0_618,     value_0_618,     color_0_618,     lineId7,  startPrice, diff)
    lineId9  = processLevel(show_0_65,      value_0_65,      color_0_65,      lineId8,  startPrice, diff)
    lineId10 = processLevel(show_0_786,     value_0_786,     color_0_786,     lineId9,  startPrice, diff)
    lineId11 = processLevel(show_1,         value_1,         color_11,        lineId10, startPrice, diff)
    lineId12 = processLevel(show_1_272,     value_1_272,     color_1_272,     lineId11, startPrice, diff)
    lineId13 = processLevel(show_1_414,     value_1_414,     color_1_414,     lineId12, startPrice, diff)
    lineId14 = processLevel(show_1_618,     value_1_618,     color_1_618,     lineId13, startPrice, diff)
    lineId15 = processLevel(show_1_65,      value_1_65,      color_1_65,      lineId14, startPrice, diff)
    lineId16 = processLevel(show_2_618,     value_2_618,     color_2_618,     lineId15, startPrice, diff)
    lineId17 = processLevel(show_2_65,      value_2_65,      color_2_65,      lineId16, startPrice, diff)
    lineId18 = processLevel(show_3_618,     value_3_618,     color_3_618,     lineId17, startPrice, diff)
    lineId19 = processLevel(show_3_65,      value_3_65,      color_3_65,      lineId18, startPrice, diff)
    lineId20 = processLevel(show_4_236,     value_4_236,     color_4_236,     lineId19, startPrice, diff)
    lineId21 = processLevel(show_4_618,     value_4_618,     color_4_618,     lineId20, startPrice, diff)
