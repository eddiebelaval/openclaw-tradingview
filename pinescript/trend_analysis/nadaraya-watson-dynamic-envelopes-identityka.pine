//@version=5
indicator("Nadaraya-Watson Dynamic Envelopes [identityKa]", overlay=true, max_lines_count=50, max_labels_count=50)

// ==========================================
// 1. USER INPUTS (GLOBAL ENGLISH)
// ==========================================
grp1 = "⚙️ Envelope Settings"
h = input.float(8.0, title="Bandwidth (Smoothness)", step=0.5, group=grp1)
mult = input.float(2.0, title="Envelope Multiplier", step=0.1, group=grp1)
src = input.source(close, title="Source", group=grp1)

grp3 = "🎨 Theme & Colors"
col_buy = input.color(#00ffbb, title="Support (Green)", group=grp3)
col_sell = input.color(#ff1744, title="Resistance (Red)", group=grp3)
col_mid = input.color(#ffffff, title="Midline (White)", group=grp3)

grp4 = "📊 HUD Dashboard Settings"
show_dash = input.bool(true, "Show Dashboard", group=grp4)
dash_pos = input.string("Bottom Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], group=grp4)
dash_size = input.string("Small", "Dashboard Text Size", options=["Tiny", "Small", "Normal", "Large"], group=grp4)

// ==========================================
// 2. MATHEMATICAL ENGINE (Gaussian Smoothing)
// ==========================================
// Using ALMA to mimic Non-Repainting Nadaraya-Watson Kernel
window = math.floor(h * 10)
sigma = h
offset = 0.85

alma_val = ta.alma(src, window == 0 ? 1 : window, offset, sigma)
atr = ta.atr(100)

upper_band = alma_val + (atr * mult)
lower_band = alma_val - (atr * mult)

// Reversal Signals
bullish_rev = ta.crossunder(low, lower_band)
bearish_rev = ta.crossover(high, upper_band)

// ==========================================
// 3. VISUALIZATION
// ==========================================
p_mid = plot(alma_val, color=color.new(col_mid, 50), title="NW Midline", linewidth=1)
p_upper = plot(upper_band, color=col_sell, title="NW Upper Band", linewidth=2)
p_lower = plot(lower_band, color=col_buy, title="NW Lower Band", linewidth=2)

fill(p_upper, p_mid, color=color.new(col_sell, 90), title="Upper Zone Fill")
fill(p_lower, p_mid, color=color.new(col_buy, 90), title="Lower Zone Fill")

plotshape(bullish_rev, title="Reversal Buy", style=shape.triangleup, location=location.belowbar, color=col_buy, size=size.small)
plotshape(bearish_rev, title="Reversal Sell", style=shape.triangledown, location=location.abovebar, color=col_sell, size=size.small)

// ==========================================
// 4. HUD DASHBOARD & AI SUGGESTION
// ==========================================
var string p_pos = dash_pos == "Top Right" ? position.top_right : dash_pos == "Top Left" ? position.top_left : dash_pos == "Bottom Right" ? position.bottom_right : dash_pos == "Bottom Left" ? position.bottom_left : dash_pos == "Middle Right" ? position.middle_right : position.middle_left
var string p_size = dash_size == "Tiny" ? size.tiny : dash_size == "Small" ? size.small : dash_size == "Normal" ? size.normal : size.large

var table hud = table.new(p_pos, 2, 3, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 80))

// AI Suggestion based on position relative to envelope
string ai_suggestion = close < lower_band ? "LONG" : close > upper_band ? "SHORT" : "Dangerous"
color ai_color = ai_suggestion == "LONG" ? col_buy : ai_suggestion == "SHORT" ? col_sell : color.new(#ff9800, 0)

if barstate.islast and show_dash
    table.cell(hud, 0, 0, "NW ENGINE", text_color=color.gray, text_size=p_size)
    table.cell(hud, 1, 0, "SMOOTHED", text_color=color.yellow, text_size=p_size)
    
    table.cell(hud, 0, 1, "PRICE POSITION", text_color=color.gray, text_size=p_size)
    table.cell(hud, 1, 1, close > alma_val ? "UPPER HALF" : "LOWER HALF", text_color=color.white, text_size=p_size)
    
    table.cell(hud, 0, 2, "AI SUGGESTION", text_color=color.gray, text_size=p_size)
    table.cell(hud, 1, 2, ai_suggestion, text_color=ai_color, text_size=p_size)

// ==========================================
// 5. ALERTS
// ==========================================
alertcondition(bullish_rev, "🟢 NW Support Bounce", "identityKa: Price hit lower envelope bounds!")
alertcondition(bearish_rev, "🔴 NW Resistance Reject", "identityKa: Price hit upper envelope bounds!")
