//@version=6
indicator(title="Volume Clock", shorttitle="Vol Clock", overlay=true)

// ════════════════════════════════════════
// VOLUME CLOCK
// 1 minute to 1 month
// Current + Previous candle volume
// 37 calls under 40 limit free plan safe
// ════════════════════════════════════════

// TABLE SETTINGS
table_pos  = input.string("Bottom Center", "Table Position",
     options=["Top Left","Top Center","Top Right","Middle Left","Middle Center","Middle Right","Bottom Left","Bottom Center","Bottom Right"],
     group="-- Table --")
tbl_mode   = input.string("Normal", "Table Mode",  options=["Compact","Normal","Full"], group="-- Table --")
tbl_size   = input.string("Small",  "Font Size",   options=["Tiny","Small","Normal","Large"], group="-- Table --")
vol_length = input.int(20, "Volume Average Length", minval=5, maxval=100, group="-- Table --")

// ROW TOGGLES
show_label = input.bool(true,  "TF Label Row",           group="-- Rows --")
show_vol   = input.bool(true,  "Current Volume Row",     group="-- Rows --")
show_pvol  = input.bool(true,  "Previous Candle Volume", group="-- Rows --")
show_rvol  = input.bool(true,  "VS AVG Row",             group="-- Rows --")
show_level = input.bool(true,  "STATUS Row",             group="-- Rows --")

// COLORS
col_hdr_txt = input.color(color.white,                "Header Font",    group="-- Colors --")
col_tbl_bg  = input.color(color.new(color.black, 60), "Table BG",       group="-- Colors --")
col_border  = input.color(color.gray,                 "Border",         group="-- Colors --")
col_bull    = input.color(color.green,                "High Vol Color", group="-- Colors --")
col_norm    = input.color(color.white,                "Normal Color",   group="-- Colors --")
col_low     = input.color(color.red,                  "Low Vol Color",  group="-- Colors --")
col_flash   = input.color(color.new(#FFD700, 0),      "Extreme Flash",  group="-- Colors --")
col_prev    = input.color(color.gray,                 "Prev Vol Color", group="-- Colors --")

// SLOTS
s1_on=input.bool(true,  "Slot 1  On", group="-- Slot 1 --")
s1_min=input.int(1,     "Minutes", minval=1, maxval=43200, group="-- Slot 1 --")
s1_bg=input.color(color.new(color.black,60),"Box Color",group="-- Slot 1 --")
s1_txt=input.color(color.white,"Font Color",group="-- Slot 1 --")
s2_on=input.bool(true,  "Slot 2  On", group="-- Slot 2 --")
s2_min=input.int(5,     "Minutes", minval=1, maxval=43200, group="-- Slot 2 --")
s2_bg=input.color(color.new(color.black,60),"Box Color",group="-- Slot 2 --")
s2_txt=input.color(color.white,"Font Color",group="-- Slot 2 --")
s3_on=input.bool(true,  "Slot 3  On", group="-- Slot 3 --")
s3_min=input.int(15,    "Minutes", minval=1, maxval=43200, group="-- Slot 3 --")
s3_bg=input.color(color.new(color.black,60),"Box Color",group="-- Slot 3 --")
s3_txt=input.color(color.white,"Font Color",group="-- Slot 3 --")
s4_on=input.bool(true,  "Slot 4  On", group="-- Slot 4 --")
s4_min=input.int(30,    "Minutes", minval=1, maxval=43200, group="-- Slot 4 --")
s4_bg=input.color(color.new(color.black,60),"Box Color",group="-- Slot 4 --")
s4_txt=input.color(color.white,"Font Color",group="-- Slot 4 --")
s5_on=input.bool(true,  "Slot 5  On", group="-- Slot 5 --")
s5_min=input.int(60,    "Minutes", minval=1, maxval=43200, group="-- Slot 5 --")
s5_bg=input.color(color.new(color.black,60),"Box Color",group="-- Slot 5 --")
s5_txt=input.color(color.white,"Font Color",group="-- Slot 5 --")
s6_on=input.bool(true,  "Slot 6  On", group="-- Slot 6 --")
s6_min=input.int(240,   "Minutes", minval=1, maxval=43200, group="-- Slot 6 --")
s6_bg=input.color(color.new(color.black,60),"Box Color",group="-- Slot 6 --")
s6_txt=input.color(color.white,"Font Color",group="-- Slot 6 --")
s7_on=input.bool(true,  "Slot 7  On", group="-- Slot 7 --")
s7_min=input.int(1440,  "Minutes", minval=1, maxval=43200, group="-- Slot 7 --")
s7_bg=input.color(color.new(color.black,60),"Box Color",group="-- Slot 7 --")
s7_txt=input.color(color.white,"Font Color",group="-- Slot 7 --")
s8_on=input.bool(false, "Slot 8  On", group="-- Slot 8 --")
s8_min=input.int(120,   "Minutes", minval=1, maxval=43200, group="-- Slot 8 --")
s8_bg=input.color(color.new(color.black,60),"Box Color",group="-- Slot 8 --")
s8_txt=input.color(color.white,"Font Color",group="-- Slot 8 --")
s9_on=input.bool(false, "Slot 9  On", group="-- Slot 9 --")
s9_min=input.int(180,   "Minutes", minval=1, maxval=43200, group="-- Slot 9 --")
s9_bg=input.color(color.new(color.black,60),"Box Color",group="-- Slot 9 --")
s9_txt=input.color(color.white,"Font Color",group="-- Slot 9 --")
s10_on=input.bool(false,"Slot 10 On", group="-- Slot 10 --")
s10_min=input.int(480,  "Minutes", minval=1, maxval=43200, group="-- Slot 10 --")
s10_bg=input.color(color.new(color.black,60),"Box Color",group="-- Slot 10 --")
s10_txt=input.color(color.white,"Font Color",group="-- Slot 10 --")
s11_on=input.bool(false,"Slot 11 On", group="-- Slot 11 --")
s11_min=input.int(720,  "Minutes", minval=1, maxval=43200, group="-- Slot 11 --")
s11_bg=input.color(color.new(color.black,60),"Box Color",group="-- Slot 11 --")
s11_txt=input.color(color.white,"Font Color",group="-- Slot 11 --")
s12_on=input.bool(false,"Slot 12 On", group="-- Slot 12 --")
s12_min=input.int(10080,"Minutes", minval=1, maxval=43200, group="-- Slot 12 --")
s12_bg=input.color(color.new(color.black,60),"Box Color",group="-- Slot 12 --")
s12_txt=input.color(color.white,"Font Color",group="-- Slot 12 --")
s13_on=input.bool(false,"Slot 13 On", group="-- Slot 13 --")
s13_min=input.int(43200,"Minutes", minval=1, maxval=43200, group="-- Slot 13 --")
s13_bg=input.color(color.new(color.black,60),"Box Color",group="-- Slot 13 --")
s13_txt=input.color(color.white,"Font Color",group="-- Slot 13 --")
s14_on=input.bool(false,"Slot 14 On", group="-- Slot 14 --")
s14_min=input.int(3,    "Minutes", minval=1, maxval=43200, group="-- Slot 14 --")
s14_bg=input.color(color.new(color.black,60),"Box Color",group="-- Slot 14 --")
s14_txt=input.color(color.white,"Font Color",group="-- Slot 14 --")
s15_on=input.bool(false,"Slot 15 On", group="-- Slot 15 --")
s15_min=input.int(10,   "Minutes", minval=1, maxval=43200, group="-- Slot 15 --")
s15_bg=input.color(color.new(color.black,60),"Box Color",group="-- Slot 15 --")
s15_txt=input.color(color.white,"Font Color",group="-- Slot 15 --")

// HELPERS
get_pos(p) =>
    switch p
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.bottom_center

get_sz(s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

ts = get_sz(tbl_size)
fmt_vol(v) => v >= 1000000000 ? str.tostring(math.round(v/1000000000,2))+"B" : v >= 1000000 ? str.tostring(math.round(v/1000000,2))+"M" : v >= 1000 ? str.tostring(math.round(v/1000,2))+"K" : str.tostring(math.round(v,2))
fmt_lbl(m) => m >= 43200 ? "1MO" : m >= 10080 ? "1W" : m >= 1440 ? "1D" : m >= 60 ? str.tostring(int(m/60))+"H" : str.tostring(m)+"M"

// SECURITY CALLS — 37 TOTAL
// Current vol = 15  Previous vol = 15  Avg = 7
vol_1m  = request.security(syminfo.tickerid,"1",  volume,                    lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
vol_3m  = request.security(syminfo.tickerid,"3",  volume,                    lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
vol_5m  = request.security(syminfo.tickerid,"5",  volume,                    lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
vol_10m = request.security(syminfo.tickerid,"10", volume,                    lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
vol_15m = request.security(syminfo.tickerid,"15", volume,                    lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
vol_30m = request.security(syminfo.tickerid,"30", volume,                    lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
vol_1h  = request.security(syminfo.tickerid,"60", volume,                    lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
vol_2h  = request.security(syminfo.tickerid,"120",volume,                    lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
vol_3h  = request.security(syminfo.tickerid,"180",volume,                    lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
vol_4h  = request.security(syminfo.tickerid,"240",volume,                    lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
vol_8h  = request.security(syminfo.tickerid,"480",volume,                    lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
vol_12h = request.security(syminfo.tickerid,"720",volume,                    lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
vol_1d  = request.security(syminfo.tickerid,"1D", volume,                    lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
vol_1w  = request.security(syminfo.tickerid,"1W", volume,                    lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
vol_1mo = request.security(syminfo.tickerid,"1M", volume,                    lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)

pv_1m   = request.security(syminfo.tickerid,"1",  volume[1],                 lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pv_3m   = request.security(syminfo.tickerid,"3",  volume[1],                 lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pv_5m   = request.security(syminfo.tickerid,"5",  volume[1],                 lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pv_10m  = request.security(syminfo.tickerid,"10", volume[1],                 lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pv_15m  = request.security(syminfo.tickerid,"15", volume[1],                 lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pv_30m  = request.security(syminfo.tickerid,"30", volume[1],                 lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pv_1h   = request.security(syminfo.tickerid,"60", volume[1],                 lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pv_2h   = request.security(syminfo.tickerid,"120",volume[1],                 lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pv_3h   = request.security(syminfo.tickerid,"180",volume[1],                 lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pv_4h   = request.security(syminfo.tickerid,"240",volume[1],                 lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pv_8h   = request.security(syminfo.tickerid,"480",volume[1],                 lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pv_12h  = request.security(syminfo.tickerid,"720",volume[1],                 lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pv_1d   = request.security(syminfo.tickerid,"1D", volume[1],                 lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pv_1w   = request.security(syminfo.tickerid,"1W", volume[1],                 lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pv_1mo  = request.security(syminfo.tickerid,"1M", volume[1],                 lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

avg_1m  = request.security(syminfo.tickerid,"1",  ta.sma(volume,vol_length), lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
avg_5m  = request.security(syminfo.tickerid,"5",  ta.sma(volume,vol_length), lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
avg_15m = request.security(syminfo.tickerid,"15", ta.sma(volume,vol_length), lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
avg_1h  = request.security(syminfo.tickerid,"60", ta.sma(volume,vol_length), lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
avg_4h  = request.security(syminfo.tickerid,"240",ta.sma(volume,vol_length), lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
avg_1d  = request.security(syminfo.tickerid,"1D", ta.sma(volume,vol_length), lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
avg_1w  = request.security(syminfo.tickerid,"1W", ta.sma(volume,vol_length), lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)

// MAP MINUTES TO DATA
get_vol(m) =>
    if m >= 43200
        vol_1mo
    else if m >= 10080
        vol_1w
    else if m >= 1440
        vol_1d
    else if m >= 720
        vol_12h
    else if m >= 480
        vol_8h
    else if m >= 240
        vol_4h
    else if m >= 180
        vol_3h
    else if m >= 120
        vol_2h
    else if m >= 60
        vol_1h
    else if m >= 30
        vol_30m
    else if m >= 15
        vol_15m
    else if m >= 10
        vol_10m
    else if m >= 5
        vol_5m
    else if m >= 3
        vol_3m
    else
        vol_1m

get_pvol(m) =>
    if m >= 43200
        pv_1mo
    else if m >= 10080
        pv_1w
    else if m >= 1440
        pv_1d
    else if m >= 720
        pv_12h
    else if m >= 480
        pv_8h
    else if m >= 240
        pv_4h
    else if m >= 180
        pv_3h
    else if m >= 120
        pv_2h
    else if m >= 60
        pv_1h
    else if m >= 30
        pv_30m
    else if m >= 15
        pv_15m
    else if m >= 10
        pv_10m
    else if m >= 5
        pv_5m
    else if m >= 3
        pv_3m
    else
        pv_1m

get_avg(m) =>
    if m >= 10080
        avg_1w
    else if m >= 1440
        avg_1d
    else if m >= 240
        avg_4h
    else if m >= 60
        avg_1h
    else if m >= 15
        avg_15m
    else if m >= 5
        avg_5m
    else
        avg_1m

// REQUIRED PLOT
plot(close,"Close",color=color.new(color.white,100),display=display.none)

// BUILD TABLE
if barstate.islast or barstate.isrealtime

    mins_arr = array.new_int()
    bg_arr   = array.new_color()
    txt_arr  = array.new_color()

    if s1_on
        array.push(mins_arr,s1_min)
        array.push(bg_arr,s1_bg)
        array.push(txt_arr,s1_txt)
    if s2_on
        array.push(mins_arr,s2_min)
        array.push(bg_arr,s2_bg)
        array.push(txt_arr,s2_txt)
    if s3_on
        array.push(mins_arr,s3_min)
        array.push(bg_arr,s3_bg)
        array.push(txt_arr,s3_txt)
    if s4_on
        array.push(mins_arr,s4_min)
        array.push(bg_arr,s4_bg)
        array.push(txt_arr,s4_txt)
    if s5_on
        array.push(mins_arr,s5_min)
        array.push(bg_arr,s5_bg)
        array.push(txt_arr,s5_txt)
    if s6_on
        array.push(mins_arr,s6_min)
        array.push(bg_arr,s6_bg)
        array.push(txt_arr,s6_txt)
    if s7_on
        array.push(mins_arr,s7_min)
        array.push(bg_arr,s7_bg)
        array.push(txt_arr,s7_txt)
    if s8_on
        array.push(mins_arr,s8_min)
        array.push(bg_arr,s8_bg)
        array.push(txt_arr,s8_txt)
    if s9_on
        array.push(mins_arr,s9_min)
        array.push(bg_arr,s9_bg)
        array.push(txt_arr,s9_txt)
    if s10_on
        array.push(mins_arr,s10_min)
        array.push(bg_arr,s10_bg)
        array.push(txt_arr,s10_txt)
    if s11_on
        array.push(mins_arr,s11_min)
        array.push(bg_arr,s11_bg)
        array.push(txt_arr,s11_txt)
    if s12_on
        array.push(mins_arr,s12_min)
        array.push(bg_arr,s12_bg)
        array.push(txt_arr,s12_txt)
    if s13_on
        array.push(mins_arr,s13_min)
        array.push(bg_arr,s13_bg)
        array.push(txt_arr,s13_txt)
    if s14_on
        array.push(mins_arr,s14_min)
        array.push(bg_arr,s14_bg)
        array.push(txt_arr,s14_txt)
    if s15_on
        array.push(mins_arr,s15_min)
        array.push(bg_arr,s15_bg)
        array.push(txt_arr,s15_txt)

    n_cols = array.size(mins_arr)

    if n_cols > 0
        is_compact = tbl_mode == "Compact"

        n_rows = 0
        if show_label
            n_rows := n_rows + 1
        if show_vol
            n_rows := n_rows + 1
        if show_pvol
            n_rows := n_rows + 1
        if show_rvol and not is_compact
            n_rows := n_rows + 1
        if show_level
            n_rows := n_rows + 1
        if n_rows < 1
            n_rows := 1

        t = table.new(get_pos(table_pos), n_cols, n_rows,
             bgcolor=col_tbl_bg,
             border_color=col_border,
             border_width=1,
             frame_color=col_border,
             frame_width=1)

        for col = 0 to n_cols - 1
            m       = array.get(mins_arr, col)
            slot_bg = array.get(bg_arr,   col)

            vol  = get_vol(m)
            pvol = get_pvol(m)
            avg  = get_avg(m)

            rvol    = avg > 0 ? vol / avg : 1.0
            is_abn  = rvol >= 2.0
            vol_up  = vol >= pvol

            rvol_lbl = rvol >= 3.0 ? "EXTREME" : rvol >= 2.0 ? "VERY HIGH" : rvol >= 1.5 ? "HIGH" : rvol >= 1.2 ? "ABOVE" : rvol >= 0.8 ? "NORMAL" : rvol >= 0.5 ? "BELOW" : rvol >= 0.3 ? "LOW" : "DEAD"

            rvol_col     = rvol >= 2.0 ? col_flash : rvol >= 1.2 ? col_bull : rvol >= 0.8 ? col_norm : col_low
            rvol_lbl_col = rvol >= 2.0 ? col_flash : rvol >= 1.2 ? col_bull : rvol >= 0.8 ? col_norm : col_low
            vol_col      = is_abn ? col_flash : rvol >= 0.8 ? col_bull : col_low
            cell_bg      = is_abn ? color.new(col_flash, 75) : slot_bg
            hdr_bg       = vol_up ? color.new(color.green, 60) : color.new(color.red, 60)

            row = 0

            if show_label
                table.cell(t, col, row, fmt_lbl(m),
                     text_color=col_hdr_txt, bgcolor=hdr_bg,
                     text_size=ts, text_halign=text.align_center)
                row := row + 1

            if show_vol
                table.cell(t, col, row, fmt_vol(vol),
                     text_color=vol_col, bgcolor=cell_bg,
                     text_size=ts, text_halign=text.align_center)
                row := row + 1

            if show_pvol
                table.cell(t, col, row, "P " + fmt_vol(pvol),
                     text_color=col_prev, bgcolor=cell_bg,
                     text_size=ts, text_halign=text.align_center)
                row := row + 1

            if show_rvol and not is_compact
                table.cell(t, col, row, str.tostring(math.round(rvol,2)) + "x",
                     text_color=rvol_col, bgcolor=cell_bg,
                     text_size=ts, text_halign=text.align_center)
                row := row + 1

            if show_level
                table.cell(t, col, row, rvol_lbl,
                     text_color=rvol_lbl_col, bgcolor=cell_bg,
                     text_size=ts, text_halign=text.align_center)
