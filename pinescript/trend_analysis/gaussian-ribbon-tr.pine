//                                 ██║       ██║     ██╔═══██║  ██║  ██║  ██║   ██║       ██╔══██╗ ██║   ██║ ██║      ██║   ██║ ██╔═══██║
//                                 ██║    ████████╗  ██║   ██║  ███████║  ╚██████╔╝       ██║  ██║ ╚██████╔╝ ╚██████╗ ██║   ██║ ██║   ██║
//@version=6
indicator('Gaussian Ribbon - Gaussian | TR', 'Gaussian | TR →', true)
import TradingView/ta/12
//╔═════════════════╗
//║     Input's     ║
//╚═════════════════╝
Color_Mode =        input.string('Classic', 'Color Choice', group = '🎨 Color', options = ['Classic', 'Modern', 'Robust', 'Accented', 'Monochrome', 'Moderate', 'Aqua', 'Cosmic'])
Length_Gaussian =   input.int(49, 'Length Gaussian', minval = 1, inline = 'Gaussian', group='⚙️ Gaussian Setting')
Source_Gaussian =   input.source(close, 'Source', inline = 'Gaussian', group='⚙️ Gaussian Setting')
MA_Type_Gaussian =  input.string('ALMA', 'Moving Average', group='📊 Gaussian MA', inline = 'Gaussian MA', options=['ALMA', 'T3'])
factor_1 =          input.float(0.85, 'Offset 1º', 0.0, 1.0, 0.01, inline = 'First', group='📊 Gaussian MA')
Sigma_1 =           input.float(6.0,  'Sigma 1º Alma',  1.0, 15.0, 0.5, inline = 'First', group='📊 Gaussian MA', tooltip = 'Only For ALMA')
factor_2 =          input.float(0.55, 'Offset 2º', 0.0, 1.0, 0.05, inline = 'Second', group='📊 Gaussian MA')
Sigma_2 =           input.float(7.0,  'Sigma 2º Alma',  1.0, 15.0, 0.5, inline = 'Second', group='📊 Gaussian MA', tooltip = 'Only For ALMA')
//╔═════════════════════════════════╗
//║     MOVING AVERAGE ENGINE       ║
//╚═════════════════════════════════╝
ma(source, length, factor, sigma, type) =>
     type == 'ALMA'  ? ta.alma(source, length, factor, sigma) :
     type == 'T3'    ? ta.t3(source, length, factor) :
     na
//╔═════════════════╗
//║     Color       ║
//╚═════════════════╝
[UpC, DnC] = switch Color_Mode
    'Classic' =>    [#008800, #ff0000]
    'Modern' =>     [#ffffff, #b721ff]
    'Robust' =>     [#ffbb00, #770737]
    'Accented' =>   [#8c5cf7, #e83e8c]
    'Monochrome' => [#e9ecef, #495057]
    'Moderate' =>   [#43a047, #e53935]
    'Aqua' =>       [#00a8e8, #f18f01]
    'Cosmic' =>     [#e83e8c, #6f2da8]
//╔════════════════════════╗
//║      Calculation       ║
//╚════════════════════════╝
Alma_Value_1 = ma(Source_Gaussian, Length_Gaussian, factor_1, Sigma_1, MA_Type_Gaussian)
Alma_Value_2 = ma(Source_Gaussian, Length_Gaussian, factor_2, Sigma_2, MA_Type_Gaussian)
Spread = Alma_Value_1 - Alma_Value_2
Min_Spread = ta.lowest(Spread, 70)
Max_Spread = ta.highest(Spread, 70)
Range_Spread = Max_Spread - Min_Spread
N_Dist = Range_Spread != 0 ? (Spread - Min_Spread) / Range_Spread : 0.5
Trend_Color = color.from_gradient(N_Dist, 0, 1, DnC, UpC)
Momentum = math.abs(Alma_Value_1 - Alma_Value_1[5])
Max_Momentum = ta.highest(Momentum, 50)
Norm_Momentum = Max_Momentum > 0 ? math.min(Momentum / Max_Momentum, 1) : 0
Fill_Transp = int(math.max(0, math.min(100, 35 - (Norm_Momentum * 25))))
isBull_Gaussian = Alma_Value_1 > Alma_Value_2
isBear_Gaussian = Alma_Value_1 < Alma_Value_2
Bull_Gaussian = ta.crossover(Alma_Value_1,Alma_Value_2)
Bear_Gaussian = ta.crossunder(Alma_Value_1,Alma_Value_2)
//╔════════════════════════╗
//║          Plot          ║
//╚════════════════════════╝
Plot_Fast = plot(Alma_Value_1, 'Fast', Trend_Color)
Plot_Slow = plot(Alma_Value_2, 'Slow', Trend_Color)
fill(Plot_Fast, Plot_Slow, title='Ribbon Fill', color = color.new(Trend_Color, Fill_Transp))
barcolor(isBull_Gaussian ? UpC : isBear_Gaussian ? DnC : na, title='Bar Color')
plotshape(Bull_Gaussian, 'LONG' , shape.triangleup  , location.belowbar, UpC,    0, size = size.normal, force_overlay = true)
plotshape(Bear_Gaussian, 'SHORT', shape.triangledown, location.abovebar, DnC,    0, size = size.normal, force_overlay = true)
bgcolor(isBull_Gaussian ? color.new(UpC, 95) : isBear_Gaussian ? color.new(DnC, 95) : na, title='Zone Background', force_overlay = true)
//╔════════════════════════╗
//║          VIEW          ║
//╚════════════════════════╝
var table infoTable = table.new(position.middle_right, 1, 1, border_width = 1)
var label infoLabel = na
if barstate.islast
    table.cell(infoTable, 0, 0, text = isBull_Gaussian ? '⬆️ Bullish' : '⬇️ Bearish', text_color = isBull_Gaussian ? UpC : DnC, text_size = size.huge)
    if not na(infoLabel)
        label.delete(infoLabel)
    infoLabel := label.new(bar_index, Alma_Value_1, text = str.tostring(Spread, '#.##'), color = color.new(isBull_Gaussian ? UpC : DnC, 20), style = label.style_label_left, size = size.large, textcolor = #000000)
//╔════════════════════════╗
//║         Alerts         ║
//╚════════════════════════╝
alertcondition(isBull_Gaussian, title="Bullish Crossover",  message="Fast > Slow")
alertcondition(isBear_Gaussian, title="Bearish Crossover",  message="Fast < Slow")
alertcondition(ta.cross(Spread, 0), title="Zero Crossover", message="Spread crosses zero")
