//@version=6
indicator("Vector Logic: Gator Trend Hunter [Trend Rider]", shorttitle="VL: Gator Trend Hunter", overlay=true)

// -----------------------------------------------------------------------------
// VECTOR LOGIC LABS - TREND RIDER EDITION
// Logic: 200 DEMA Filter + Alligator Expansion.
// Update: Exit Logic changed to "Price Break of Teeth" to ride trends longer.
// -----------------------------------------------------------------------------

// --- 1. SETTINGS ---
group_ema = "Trend Filter"
len_dema  = input.int(200, "Double EMA Length", group=group_ema)

group_gator = "Alligator Settings"
len_jaw   = input.int(13, "Jaw Length", group=group_gator)
off_jaw   = input.int(8, "Jaw Offset", group=group_gator)
len_teeth = input.int(8, "Teeth Length", group=group_gator)
off_teeth = input.int(5, "Teeth Offset", group=group_gator)
len_lips  = input.int(5, "Lips Length", group=group_gator)
off_lips  = input.int(3, "Lips Offset", group=group_gator)

group_dash = "Dashboard Settings"
show_dash = input.bool(true, "Show Info Dashboard?", group=group_dash)

// --- 2. CALCULATIONS ---

// A. Double EMA (The Macro Filter)
dema_e1 = ta.ema(close, len_dema)
dema    = ta.ema(dema_e1, len_dema)

// B. Williams Alligator (Standard Calculation)
jaw_raw   = ta.sma(ohlc4, len_jaw)
teeth_raw = ta.sma(ohlc4, len_teeth)
lips_raw  = ta.sma(ohlc4, len_lips)

// Logic Shift
v_jaw   = jaw_raw[off_jaw]
v_teeth = teeth_raw[off_teeth]
v_lips  = lips_raw[off_lips]

// --- 3. LOGIC ENGINE ---

// Trend Regimes
is_bull_macro = close > dema
is_bear_macro = close < dema

// Gator Phases
// Eating (Expansion)
gator_eat_bull = v_lips > v_teeth and v_teeth > v_jaw
gator_eat_bear = v_lips < v_teeth and v_teeth < v_jaw

// Sleeping (Contraction)
gator_sleep = not gator_eat_bull and not gator_eat_bear

// Triggers
// BUY: Macro Bullish + Gator Eating + Price crosses OVER Lips
trig_buy = is_bull_macro and gator_eat_bull and ta.crossover(close, v_lips)

// SELL (SHORT): Macro Bearish + Gator Eating + Price crosses UNDER Lips
trig_sell = is_bear_macro and gator_eat_bear and ta.crossunder(close, v_lips)

// --- EXITS (The Fix) ---
// OLD: ta.crossunder(v_lips, v_teeth) -> Too sensitive.
// NEW: ta.crossunder(close, v_teeth) -> Rides the Red Line.

// Exit Long: Price closes BELOW the Red Line (Teeth)
exit_long = ta.crossunder(close, v_teeth)

// Exit Short: Price closes ABOVE the Red Line (Teeth)
exit_short = ta.crossover(close, v_teeth)

// --- 4. STATE MACHINE ---
var int state = 0

bool signal_buy = false
bool signal_sell = false
bool signal_exit_long = false
bool signal_exit_short = false

// Long Logic
if trig_buy and state == 0
    state := 1
    signal_buy := true

if exit_long and state == 1
    state := 0
    signal_exit_long := true

// Short Logic
if trig_sell and state == 0
    state := -1
    signal_sell := true

if exit_short and state == -1
    state := 0
    signal_exit_short := true

// --- 5. VISUALIZATION ---

// Plot DEMA
plot(dema, "Macro Trend (200)", color=color.orange, linewidth=2)

// Plot Gator
p_jaw   = plot(jaw_raw, "Jaw", offset=off_jaw, color=color.new(color.blue, 50))
p_teeth = plot(teeth_raw, "Teeth", offset=off_teeth, color=color.new(color.red, 50))
p_lips  = plot(lips_raw, "Lips", offset=off_lips, color=color.new(color.lime, 50))

// Trend Cloud
fill(p_lips, p_jaw, color = gator_eat_bull ? color.new(#00E5FF, 85) : (gator_eat_bear ? color.new(#FF2E63, 85) : na), title="Gator Cloud")

// Signal Labels
plotshape(signal_buy, title="LONG", location=location.belowbar, color=#00E5FF, style=shape.labelup, text="BUY", textcolor=color.black, size=size.small)
plotshape(signal_sell, title="SHORT", location=location.abovebar, color=#FF2E63, style=shape.labeldown, text="SELL", textcolor=color.white, size=size.small)

// Exit Labels
plotshape(signal_exit_long, title="EXIT LONG", location=location.abovebar, color=color.yellow, style=shape.xcross, size=size.small)
plotshape(signal_exit_short, title="EXIT SHORT", location=location.belowbar, color=color.yellow, style=shape.xcross, size=size.small)

// --- 6. STATUS DASHBOARD ---
var table dash = table.new(position.bottom_right, 2, 4, bgcolor=color.new(color.black, 40), border_color=color.gray, border_width=1)

if show_dash and barstate.islast
    // Header
    table.cell(dash, 0, 0, "VL: Gator Pro", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 0, "Status", text_color=color.gray, text_size=size.small)
    
    // Row 1: Macro Trend
    string t_txt = is_bull_macro ? "BULLISH" : "BEARISH"
    color t_col  = is_bull_macro ? #00E5FF : #FF2E63
    table.cell(dash, 0, 1, "Macro Trend:", text_color=color.white, text_halign=text.align_right)
    table.cell(dash, 1, 1, t_txt, text_color=t_col, text_halign=text.align_left)
    
    // Row 2: Gator Phase
    string g_txt = gator_eat_bull or gator_eat_bear ? "EXPANSION" : "SLEEPING"
    color g_col  = gator_eat_bull ? #00E5FF : (gator_eat_bear ? #FF2E63 : color.gray)
    table.cell(dash, 0, 2, "Gator Phase:", text_color=color.white, text_halign=text.align_right)
    table.cell(dash, 1, 2, g_txt, text_color=g_col, text_halign=text.align_left)
    
    // Row 3: Active Trade
    string s_txt = state == 1 ? "LONG" : (state == -1 ? "SHORT" : "WAIT")
    color s_col  = state == 1 ? #00E5FF : (state == -1 ? #FF2E63 : color.yellow)
    
    table.cell(dash, 0, 3, "Action:", text_color=color.white, text_halign=text.align_right)
    table.cell(dash, 1, 3, s_txt, text_color=s_col, bgcolor=color.new(s_col, 85), text_halign=text.align_center)
