//@version=6
indicator(title="GCM Golden Edge of Market Clouds", shorttitle="GCM GEM C", overlay=true, max_labels_count=500, max_boxes_count=500, max_lines_count=500)

// ==========================================
// 1. INPUTS & MASTER ENGINE SWITCH
// ==========================================

// --- Master Trading Mode ---
grp_mode      = "Master Engine Settings"
trading_mode  = input.string("Classic Swing", "Trading Mode", options=["Classic Swing", "Fast Scalping"], group=grp_mode)
is_scalp      = trading_mode == "Fast Scalping"

// --- Dynamic Settings (Controlled by Master Mode) ---
lookback      = is_scalp ? 2 : 10
conv_len      = is_scalp ? 6 : 9
base_len      = is_scalp ? 13 : 26
lead_span_b   = is_scalp ? 26 : 52
ichi_offset   = is_scalp ? 5 : 26
actual_prd    = is_scalp ? 2 : 10

// --- Market Structure (Macro) ---
grp_ms        = "Market Structure Filters"
displacement  = input.float(1.2, "Displacement Factor", minval=1.0, group=grp_ms)
show_fvg      = input.bool(true, "Show Unmitigated FVGs", group=grp_ms)
show_ob       = input.bool(true, "Show Unmitigated OBs", group=grp_ms)
max_zones     = input.int(4, "Max Active Zones", minval=1, maxval=5, group=grp_ms)
fvg_min_size  = input.float(0.2, "Min FVG Size (ATR %)", minval=0.0, group=grp_ms)
bg_trans_inp  = input.int(85, "BG Bias Transparency", minval=0, maxval=100, group=grp_ms) 

// --- Ichimoku Cloud Visuals ---
grp_ichi      = "Ichimoku Visuals"
show_kumo     = input.bool(true, "Show Main Cloud (Kumo)", group=grp_ichi)
show_tk       = input.bool(false, "Show TK Ribbon (Trend)", group=grp_ichi)
ribbon_transp = input.int(85, "Kumo Ribbon Transparency", minval=0, maxval=100, group=grp_ichi) 
tk_transp     = input.int(75, "TK Ribbon Transparency", minval=0, maxval=100, group=grp_ichi) 
lag_transp    = input.int(65, "Lagging Line Transparency", minval=0, maxval=100, group=grp_ichi) 

// --- Stealth Volatility (Bollinger) ---
grp_bb        = "Stealth Volatility (Bollinger)"
show_bb_lines = input.bool(true, "Show BB Lines", group=grp_bb)
bb_line_transp= input.int(50, "BB Line Transparency", minval=0, maxval=100, group=grp_bb)
show_bb_color = input.bool(true, "Color Candles at BB Extremes", group=grp_bb)
bb_len        = input.int(20, "BB Length", group=grp_bb)
bb_mult       = input.float(2.0, "BB StdDev", group=grp_bb)

// --- Seamless Trend Lines (Aether) ---
grp_scalp     = "Seamless Trend Lines (Aether)"
show_struc    = input.bool(true, "Show Seamless Projector", group=grp_scalp)
len_scalp     = input.int(7, "Scalper Length (HMA)", group=grp_scalp)

// --- Pivot S/R Alternating Lines ---
grp_sr        = "Active S/R Lines"
show_sr       = input.bool(true, "Show S/R Lines", group=grp_sr)
resColor      = input.color(color.red, "Resistance Color", group=grp_sr)
supColor      = input.color(color.lime, "Support Color", group=grp_sr)
lineWidth_sr  = input.int(2, "Line Width", minval = 1, group=grp_sr)

// --- Smart HUD Dashboard ---
grp_hud       = "Smart HUD Dashboard"
show_hud      = input.bool(true, "Show Dashboard", group=grp_hud)
// SET TO BOTTOM RIGHT AND SMALL AS DEFAULT
hud_pos       = input.string("Bottom Right", "Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=grp_hud)
hud_size      = input.string("Small", "Size", options=["Small", "Normal", "Large"], group=grp_hud)

// --- Alerts ---
grp_alerts    = "Alerts Engine"
use_alerts    = input.bool(true, "Enable Sniper Alerts", group=grp_alerts)

// ==========================================
// 2. CUSTOM COLOR PALETTES
// ==========================================
c_bull_1 = #2dff00
c_bear_1 = #ff0000
c_bull_2 = #089981
c_bear_2 = #f23645

// ==========================================
// 3. ICHIMOKU CLOUD LOGIC
// ==========================================
donchian(len) => math.avg(ta.lowest(len), ta.highest(len))

conversionLine = donchian(conv_len)
baseLine       = donchian(base_len)
leadLine1      = math.avg(conversionLine, baseLine)
leadLine2      = donchian(lead_span_b)

p_conv = plot(show_tk ? conversionLine : na, display = display.none, title="Conversion Line")
p_base = plot(show_tk ? baseLine : na,       display = display.none, title="Base Line")
fill(p_conv, p_base, title="TK Ribbon", color = conversionLine > baseLine ? color.new(c_bull_2, tk_transp) : color.new(c_bear_2, tk_transp))

p_lead1 = plot(show_kumo ? leadLine1 : na, offset = ichi_offset - 1, display = display.none, title="Leading Span A")
p_lead2 = plot(show_kumo ? leadLine2 : na, offset = ichi_offset - 1, display = display.none, title="Leading Span B")
fill(p_lead1, p_lead2, title="Kumo Cloud Ribbon", color = leadLine1 > leadLine2 ? color.new(c_bull_1, ribbon_transp) : color.new(c_bear_1, ribbon_transp))

lag_is_bull = close > close[ichi_offset - 1]
lag_color_line = lag_is_bull ? color.new(c_bull_1, lag_transp) : color.new(c_bear_1, lag_transp)
lag_color_dot  = lag_is_bull ? color.new(c_bull_1, 0) : color.new(c_bear_1, 0)

plot(close, offset = -ichi_offset + 1, color=lag_color_line, title="Dynamic Lagging Span", linewidth=2)
plot(close, offset = -ichi_offset + 1, color=lag_color_dot, style=plot.style_circles, linewidth=3, title="Lagging Span Dot", show_last=1)

// ==========================================
// 4. STEALTH BOLLINGER BANDS
// ==========================================
bb_basis = ta.sma(close, bb_len)
bb_dev   = bb_mult * ta.stdev(close, bb_len)
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev

plot(show_bb_lines ? bb_upper : na, title="BB Upper", color=color.new(#808080, bb_line_transp), linewidth=3)
plot(show_bb_lines ? bb_lower : na, title="BB Lower", color=color.new(#808080, bb_line_transp), linewidth=3)

is_bb_extreme  = high >= bb_upper or low <= bb_lower
is_bull_candle = close > open
is_bear_candle = close < open

bb_color = is_bb_extreme ? (is_bull_candle ? color.new(c_bull_1, 0) : is_bear_candle ? color.new(color.fuchsia, 0) : na) : na
barcolor(show_bb_color ? bb_color : na)

// ==========================================
// 5. STATE VARIABLES & ARRAYS
// ==========================================
var bool  is_bull_struct = true
var float v_high     = na
var float v_low      = na
var int   v_high_idx = na
var int   v_low_idx  = na

var box[] active_bull_fvgs = array.new_box()
var box[] active_bear_fvgs = array.new_box()
var box[] active_bull_obs  = array.new_box()
var box[] active_bear_obs  = array.new_box()

// ==========================================
// 6. AETHER INTEGRATION: SEAMLESS SCALPER
// ==========================================
var line struct_line = na 
scalp_val = ta.hma(close, len_scalp)
bool scalp_turn_up = ta.crossover(scalp_val, scalp_val[1])
bool scalp_turn_dn = ta.crossunder(scalp_val, scalp_val[1])
var int active_state = 0 

if barstate.isconfirmed
    if scalp_turn_up
        active_state := 1
    if scalp_turn_dn
        active_state := -1

if ta.change(active_state) != 0 and show_struc
    line.delete(struct_line)
    if active_state == 1
        struct_line := line.new(bar_index-1, low[1], bar_index + 5, low, width=1, style=line.style_dashed, color=c_bull_2) 
    if active_state == -1
        struct_line := line.new(bar_index-1, high[1], bar_index + 5, high, width=1, style=line.style_dashed, color=c_bear_2) 

if show_struc and not na(struct_line)
    bool freeze_condition = (active_state == 1 and scalp_turn_dn) or (active_state == -1 and scalp_turn_up)
    if freeze_condition
        line.set_xy2(struct_line, bar_index + 4, (active_state == 1) ? low[1] : high[1])
    else
        line.set_xy2(struct_line, bar_index + 5, (active_state == 1) ? low : high)

// ==========================================
// 7. CORE MARKET STRUCTURE ENGINE (Macro)
// ==========================================
ph = ta.pivothigh(lookback, lookback)
pl = ta.pivotlow(lookback, lookback)

if not na(ph)
    v_high := ph, v_high_idx := bar_index[lookback]
if not na(pl)
    v_low := pl, v_low_idx := bar_index[lookback]

body_size = math.abs(close - open)
avg_body  = ta.sma(body_size, 20)
atr_val   = ta.atr(14)
is_disp   = body_size > (avg_body * displacement)

bool bos_bull   = close > v_high and is_bull_struct and is_disp
bool choch_bull = close > v_high and not is_bull_struct and is_disp
bool bos_bear   = close < v_low and not is_bull_struct and is_disp
bool choch_bear = close < v_low and is_bull_struct and is_disp

clean_array(box_array, max_size) =>
    if array.size(box_array) > max_size
        box.delete(array.shift(box_array))

if (bos_bull or choch_bull)
    if show_ob
        int limit = math.min(int(bar_index - v_low_idx), 300) 
        for i = 1 to limit
            if close[i] < open[i]
                ob_box = box.new(bar_index[i], high[i], bar_index + 5, low[i], bgcolor=color.new(c_bull_1, 75), border_color=color.new(c_bull_1, 0), border_style=line.style_solid, text="OB", text_color=c_bull_1, text_size=size.small, text_halign=text.align_right, text_valign=text.align_center)
                array.push(active_bull_obs, ob_box)
                clean_array(active_bull_obs, max_zones)
                break

    line.new(v_high_idx, v_high, bar_index - 1, v_high, color=c_bull_1, width=1, style=line.style_dashed)
    label.new(int(math.avg(v_high_idx, bar_index-1)), v_high, (bos_bull ? "BOS" : "CHoCH"), color=color.new(color.black, 100), textcolor=c_bull_1, style=label.style_none, size=size.small, textalign=text.align_center)
    is_bull_struct := true, v_high := na 

if (bos_bear or choch_bear)
    if show_ob
        int limit = math.min(int(bar_index - v_high_idx), 300) 
        for i = 1 to limit
            if close[i] > open[i]
                ob_box = box.new(bar_index[i], high[i], bar_index + 5, low[i], bgcolor=color.new(c_bear_1, 75), border_color=color.new(c_bear_1, 0), border_style=line.style_solid, text="OB", text_color=c_bear_1, text_size=size.small, text_halign=text.align_right, text_valign=text.align_center)
                array.push(active_bear_obs, ob_box)
                clean_array(active_bear_obs, max_zones)
                break

    line.new(v_low_idx, v_low, bar_index - 1, v_low, color=c_bear_1, width=1, style=line.style_dashed)
    label.new(int(math.avg(v_low_idx, bar_index-1)), v_low, (bos_bear ? "BOS" : "CHoCH"), color=color.new(color.black, 100), textcolor=c_bear_1, style=label.style_none, size=size.small, textalign=text.align_center)
    is_bull_struct := false, v_low := na 

if show_fvg
    middle_is_disp = math.abs(close[1] - open[1]) > (avg_body * displacement)
    
    if low > high[2] and close[1] > high[2] and middle_is_disp
        if (low - high[2]) > (atr_val * fvg_min_size) 
            fvg_box = box.new(bar_index[2], low, bar_index + 5, high[2], bgcolor=color.new(c_bull_1, 75), border_color=color.new(c_bull_1, 20), border_style=line.style_dotted, text="FVG", text_color=c_bull_1, text_size=size.small, text_halign=text.align_right, text_valign=text.align_center)
            array.push(active_bull_fvgs, fvg_box)
            clean_array(active_bull_fvgs, max_zones)
            
    if high < low[2] and close[1] < low[2] and middle_is_disp
        if (low[2] - high) > (atr_val * fvg_min_size) 
            fvg_box = box.new(bar_index[2], low[2], bar_index + 5, high, bgcolor=color.new(c_bear_1, 75), border_color=color.new(c_bear_1, 20), border_style=line.style_dotted, text="FVG", text_color=c_bear_1, text_size=size.small, text_halign=text.align_right, text_valign=text.align_center)
            array.push(active_bear_fvgs, fvg_box)
            clean_array(active_bear_fvgs, max_zones)

bool in_bull_ob = false
bool in_bear_ob = false

if array.size(active_bull_fvgs) > 0
    for i = array.size(active_bull_fvgs) - 1 to 0
        b = array.get(active_bull_fvgs, i)
        if box.get_right(b) < bar_index + 5 and low <= box.get_top(b)
            box.delete(array.remove(active_bull_fvgs, i))
        else
            box.set_right(b, bar_index + 5)

if array.size(active_bear_fvgs) > 0
    for i = array.size(active_bear_fvgs) - 1 to 0
        b = array.get(active_bear_fvgs, i)
        if box.get_right(b) < bar_index + 5 and high >= box.get_bottom(b)
            box.delete(array.remove(active_bear_fvgs, i))
        else
            box.set_right(b, bar_index + 5)

if array.size(active_bull_obs) > 0
    for i = array.size(active_bull_obs) - 1 to 0
        b = array.get(active_bull_obs, i)
        if box.get_right(b) < bar_index + 5 and low <= box.get_top(b)
            in_bull_ob := true 
            box.delete(array.remove(active_bull_obs, i))
        else
            box.set_right(b, bar_index + 5)

if array.size(active_bear_obs) > 0
    for i = array.size(active_bear_obs) - 1 to 0
        b = array.get(active_bear_obs, i)
        if box.get_right(b) < bar_index + 5 and high >= box.get_bottom(b)
            in_bear_ob := true 
            box.delete(array.remove(active_bear_obs, i))
        else
            box.set_right(b, bar_index + 5)

// ==========================================
// 8. ACTIVE-ONLY PIVOT S/R LINES (Immortal with Bias)
// ==========================================
float ph_sr = ta.pivothigh(actual_prd, actual_prd)
float pl_sr = ta.pivotlow(actual_prd, actual_prd)

var line activeRes = na
var line activeSup = na
var bool bullBias = true 

if show_sr
    if not na(ph_sr)
        if not na(activeRes)
            line.delete(activeRes)
        activeRes := line.new(x1 = bar_index - actual_prd, y1 = ph_sr, x2 = bar_index + 5, y2 = ph_sr, color = resColor, width = lineWidth_sr)
        bullBias := false 

    if not na(pl_sr)
        if not na(activeSup)
            line.delete(activeSup)
        activeSup := line.new(x1 = bar_index - actual_prd, y1 = pl_sr, x2 = bar_index + 5, y2 = pl_sr, color = supColor, width = lineWidth_sr)
        bullBias := true 

    if not na(activeRes)
        line.set_x2(activeRes, bar_index + 5)
        line.set_style(activeRes, bullBias ? line.style_dotted : line.style_solid)

    if not na(activeSup)
        line.set_x2(activeSup, bar_index + 5)
        line.set_style(activeSup, bullBias ? line.style_solid : line.style_dotted)

// ==========================================
// 9. CONSTANT BACKGROUND BIAS (Locked to Lookback 10)
// ==========================================
ph_static = ta.pivothigh(10, 10)
pl_static = ta.pivotlow(10, 10)
var float v_high_static = na
var float v_low_static  = na
var bool  is_bull_bg    = true

if not na(ph_static)
    v_high_static := ph_static
if not na(pl_static)
    v_low_static  := pl_static

avg_body_static = ta.sma(body_size, 20)
is_disp_static  = body_size > (avg_body_static * 1.2)

if close > v_high_static and is_disp_static
    is_bull_bg := true
if close < v_low_static and is_disp_static
    is_bull_bg := false

bgcolor(is_bull_bg ? color.new(color.teal, bg_trans_inp) : color.new(color.maroon, bg_trans_inp), title="Constant Trend Background")

// ==========================================
// 10. SMART HUD DASHBOARD LOGIC
// ==========================================
if show_hud and barstate.islast
    t_pos = hud_pos == "Top Right" ? position.top_right : hud_pos == "Bottom Right" ? position.bottom_right : hud_pos == "Top Left" ? position.top_left : position.bottom_left
    t_size = hud_size == "Small" ? size.small : hud_size == "Normal" ? size.normal : size.large
    
    rsi_val    = ta.rsi(close, 14)
    vol_avg    = ta.sma(volume, 20)
    vol_cond  = volume > vol_avg * 1.5 ? "Surging" : volume > vol_avg ? "Steady" : "Thin"
    vol_color = volume > vol_avg * 1.5 ? color.aqua : volume > vol_avg ? c_bull_1 : c_bear_1
    bias_text  = bullBias ? "BULLISH" : "BEARISH"
    bias_color = bullBias ? c_bull_1 : c_bear_1
    mom_text   = lag_is_bull ? "BULLISH" : "BEARISH"
    mom_color  = lag_is_bull ? c_bull_1 : c_bear_1
    
    var table hud = table.new(t_pos, 2, 7, border_width = 1, border_color = color.gray, frame_color = color.gray, frame_width = 2, bgcolor = color.new(color.black, 20))
    
    table.cell(hud, 0, 0, "GEM C METRICS", text_color=color.white, text_size=t_size, bgcolor=color.new(color.gray, 50))
    table.cell(hud, 1, 0, "VALUE", text_color=color.white, text_size=t_size, bgcolor=color.new(color.gray, 50))
    table.cell(hud, 0, 1, "Mode", text_color=color.white, text_size=t_size)
    table.cell(hud, 1, 1, trading_mode, text_color=color.yellow, text_size=t_size)
    table.cell(hud, 0, 2, "Market Bias", text_color=color.white, text_size=t_size)
    table.cell(hud, 1, 2, bias_text, text_color=bias_color, text_size=t_size)
    table.cell(hud, 0, 3, "Momentum", text_color=color.white, text_size=t_size)
    table.cell(hud, 1, 3, mom_text, text_color=mom_color, text_size=t_size)
    
    rsi_str = na(rsi_val) ? "---" : str.tostring(rsi_val, "0.0")
    table.cell(hud, 0, 4, "RSI (14)", text_color=color.white, text_size=t_size)
    table.cell(hud, 1, 4, rsi_str, text_color = (na(rsi_val) ? color.white : (rsi_val > 70 ? c_bear_1 : rsi_val < 30 ? c_bull_1 : color.white)), text_size=t_size)
    table.cell(hud, 0, 5, "Vol Status", text_color=color.white, text_size=t_size)
    table.cell(hud, 1, 5, vol_cond, text_color=vol_color, text_size=t_size)
    table.cell(hud, 0, 6, "ATR", text_color=color.white, text_size=t_size)
    table.cell(hud, 1, 6, str.tostring(atr_val, "0.00"), text_color=color.white, text_size=t_size)

// ==========================================
// 11. ALERTS ENGINE
// ==========================================
if use_alerts
    if in_bull_ob and is_bb_extreme and is_bull_candle
        alert("🟢 Sniper BUY: Price tapped Bullish OB at Volatility Extreme!", alert.freq_once_per_bar_close)
    if in_bear_ob and is_bb_extreme and is_bear_candle
        alert("🔴 Sniper SELL: Price tapped Bearish OB at Volatility Extreme!", alert.freq_once_per_bar_close)
    if bos_bull
        alert("📈 Market Structure: Bullish Break of Structure Confirmed", alert.freq_once_per_bar_close)
    if bos_bear
        alert("📉 Market Structure: Bearish Break of Structure Confirmed", alert.freq_once_per_bar_close)
