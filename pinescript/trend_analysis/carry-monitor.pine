//@version=6
indicator("Carry Monitor", overlay = false)

////////////
// INPUTS /{


use_current_root = input.bool(true, title = "Use Current Product Root?")

exchange = input.string("", title = "Future Exchange", tooltip = 'Keep empty if there is no ambiguity if roots')
root     = input.string('SI', title = "Product Root")

carry_type = input.string('Simple Carry (Absolute)', title = "Carry Type", options = ['Simple Carry (Absolute)', 'Percent Carry', 'Annualized Carry (Absolute)', 'Percent Annualized Carry'])

show_1y_min_max = input.bool(true, title = "Show 1Y Min/Max Carry")

pos = input.string("Top Right", "Table Position", options=["Top Right","Top Left","Bottom Right","Bottom Left"])

//}

fut_month_codes = array.from('F', 'G', 'H', 'J', 'K', 'M', 'N', 'Q', 'U', 'V', 'X', 'Z')

product_root = use_current_root ? syminfo.root : root

///////////////
// FUNCTIONS /{


// ───── MA function ─────
ma(src, len, typ) =>
    typ == "SMA" ? ta.sma(src, len) : ta.ema(src, len)

f_pos(_pos) =>
    _pos  == "Top Right"     ? position.top_right :
     _pos == "Top Left"      ? position.top_left :
     _pos == "Bottom Right"  ? position.bottom_right :
                               position.bottom_left

f_fmt_num(x) =>
    // Formats numbers with K/M/B suffixes and sign.
    na(x) ? "n/a" :
     math.abs(x) >= 1e9 ? str.format("{0}{1,number,0.00}B", x < 0 ? "-" : "", math.abs(x)/1e9) :
     math.abs(x) >= 1e6 ? str.format("{0}{1,number,0.00}M", x < 0 ? "-" : "", math.abs(x)/1e6) :
     math.abs(x) >= 1e3 ? str.format("{0}{1,number,0.0}K",  x < 0 ? "-" : "", math.abs(x)/1e3) :
                          str.format("{0,number,0}", x)

f_fmt_pct(x) =>
    na(x) ? "n/a" : str.format("{0}{1,number,0.0}%", x > 0 ? "" : "", x)

f_col_val(x) =>
    na(x) ? color.new(color.gray, 0) :
     x > 0 ? color.new(color.lime, 0) :
     x < 0 ? color.new(color.red, 0) :
             color.new(color.silver, 0)

gen_futures(future_numbers) => 
    cur_year  = year(timenow)
    cur_month = month(timenow)

    exch_string = exchange != '' ?  exchange + ":": ""

    month_code = exch_string + product_root + fut_month_codes.get(cur_month - 1) + str.tostring(cur_year)

    //log.info(month_code)

    code_arr = array.new_string(1, month_code)

    // ES Hack
    if str.upper(product_root) == 'ES' and cur_month % 3 != 0 
        code_arr := array.new_string()

    for i = 0 to future_numbers-2 

        cur_month += 1
        cur_year  := cur_month == 13 ? cur_year + 1 : cur_year
        cur_month := cur_month == 13 ?            1 : cur_month

        // Hack for ES Futures
        if str.upper(product_root) == 'ES' and cur_month % 3 != 0
            continue

        month_code := exch_string + product_root + fut_month_codes.get(cur_month - 1) + str.tostring(cur_year)

        code_arr.push(month_code)

    code_arr

//}

symbols = gen_futures(39)

prices        = array.new_float(0)
prices_prev   = array.new_float(0)
price_symbols = array.new_string(0)
dtes          = array.new_int(0)
times         = array.new_int(0)

for s in symbols
    [price, prev_close, exp_date, contr_time] = request.security(s, 'D', [close, close[1], syminfo.expiration_date, time], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_on)

    if exp_date >= time
        if not na(price) and prices.size() < 12 // and root == product_root
            prices.push(price) 
            prices_prev.push(prev_close) 
            price_symbols.push(s)
            tte = (exp_date - time) / 1000 / 60 / 60 / 24
            dtes.push(math.ceil(tte))
            times.push(contr_time)

if prices.size() > 1

    if times.get(1) != times.max()
        prices.remove(1)
        prices_prev.remove(1)
        price_symbols.remove(1)
        dtes.remove(1)
        times.remove(1)
    
    if times.get(0) != times.max()
        prices.remove(0)
        prices_prev.remove(0)
        price_symbols.remove(0)
        dtes.remove(0)
        times.remove(0)

price_front  = 0.0 
price_second = 0.0

dte_front = 0
dte_second = 0 

if prices.size() >= 2
    price_front  := prices.get(0)
    price_second := prices.get(1)

    dte_front  := dtes.get(0)
    dte_second := dtes.get(1)

    log.info(str.tostring(dte_front))
    log.info(str.tostring(dte_second))
 
carry = 0.0

if carry_type == 'Simple Carry (Absolute)'
    carry := price_second - price_front
else if carry_type == 'Annualized Carry (Absolute)'
    carry := (price_second - price_front) / (dte_second - dte_front) * 365
else if carry_type == 'Percent Carry'
    carry := (price_second - price_front) / price_front
else if carry_type == 'Percent Annualized Carry'
    carry := (price_second - price_front) / price_front / (dte_second - dte_front) * 365

carry_1y_min = ta.lowest(carry, 252)
carry_1y_max = ta.highest(carry, 252)

carry_perc = ta.percentrank(carry, 252)

carry_color = carry > 0 ? #2ECC71 : #E74C3C

cont_days  = 0
backw_days = 0 

cont_days  := carry <= 0 ? 0 : nz(cont_days[1])  + 1
backw_days := carry >  0 ? 0 : nz(backw_days[1]) + 1

//------------------------------------------------------------
// Table
//-----------------------------------------------------------{


zerol  = plot(0, title = "0", color = #7F8C8D, linewidth = 1)
carryl = plot(carry, title = "Carry", linewidth = 2, color = carry_color)

plot(carry_1y_min, title = "1Y Min", color = color.new(#1ABC9C, 70), linestyle = plot.linestyle_dashed, display = show_1y_min_max ? display.all : display.none)
plot(carry_1y_max, title = "1Y Max", color = color.new(#8E44AD, 70), linestyle = plot.linestyle_dashed, display = show_1y_min_max ? display.all : display.none)

fill(zerol, carryl, color = color.new(carry_color, 85))

//}

//------------------------------------------------------------
// Table
//-----------------------------------------------------------{

var int rows =  6 
var table t = table.new(f_pos(pos), 2, rows, frame_color=color.new(color.gray, 75), frame_width=1)

f_set_row(r, label, valueText, valueColor) =>
    table.cell(t, 0, r, label, text_color=color.new(color.white, 0), bgcolor=color.new(color.black, 70), text_halign=text.align_left)
    table.cell(t, 1, r, valueText, text_color=valueColor, bgcolor=color.new(color.black, 70), text_halign=text.align_right)

if barstate.islast
    // Optional header row
    int r0 = 1

    table.cell(t, 0, 0, "Carry Analysis", text_color=color.new(color.white, 0), bgcolor=color.new(color.black, 55), text_halign=text.align_left)
    table.merge_cells(t, 0, 0, 1, 0)

    f_set_row(1, "Today Carry",         str.tostring(math.round(carry, 2)),            f_col_val(carry) )
    f_set_row(2, "1D Δ Carry",          str.tostring(math.round(carry - carry[1], 2)), f_col_val(carry - carry[1]))
    f_set_row(3, "5D Δ Carry",          str.tostring(math.round(carry - carry[5], 2)), f_col_val(carry - carry[5]))
    f_set_row(4, "Carry 1Y Percentile", f_fmt_pct(carry_perc), color.new(color.white, 0))
    
    f_set_row(5, cont_days > 0 ? "Contango" : 'Bacwardation' + " Days", 
     str.tostring(cont_days > 0 ? cont_days : backw_days), 
     cont_days > 0 ? color.green : color.red)
 
//}

// ////////////
// // ALERTS /{

if ta.crossover(carry, 0)
    alert("Carry Turned Positive", alert.freq_once_per_bar_close)

if ta.crossunder(carry, 0)
    alert("Carry Turned Negative", alert.freq_once_per_bar_close)

// //}
