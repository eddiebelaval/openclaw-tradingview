//@version=6
indicator("[blackcat] L1 Dynamic Defense Line", shorttitle="L1 Defense Line", overlay=false, max_bars_back=5000)

// ============================================
// INPUT PARAMETERS
// ============================================
showLabels = input.bool(true, "Show Buy/Sell Labels", group="Display Settings")
showTable = input.bool(true, "Show Status Table", group="Display Settings")
labelSize = input.string(size.normal, "Label Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group="Display Settings")

// ============================================
// CYBERPUNK COLOR PALETTE
// ============================================
// Primary Neon Colors
color NEON_CYAN      = color.new(#00FFFF, 0)      // Bright cyan highlights
color NEON_MAGENTA   = color.new(#FF00FF, 0)      // Magenta accents
color NEON_GREEN     = color.new(#39FF14, 0)      // Buy signals
color NEON_RED       = color.new(#FF073A, 0)      // Sell signals
color ELECTRIC_BLUE  = color.new(#0080FF, 0)      // Primary lines
color HOT_PINK       = color.new(#FF69B4, 0)      // Secondary accents
color DEEP_PURPLE    = color.new(#9D00FF, 0)      // Gradients
color LASER_YELLOW   = color.new(#FFFF00, 0)      // Warning highlights

// Background Colors
color MIDNIGHT_BLUE  = color.new(#0D1B2A, 10)     // Table background
color CYBER_GRAY     = color.new(#1A1A2E, 20)     // Panel backgrounds
color VOID_BLACK     = color.new(#0D0D0D, 0)      // Dark background

// Glow Effect Colors (with transparency)
color NEON_CYAN_GLOW1   = color.new(#00FFFF, 50)  // Inner glow
color NEON_CYAN_GLOW2   = color.new(#00FFFF, 75)  // Outer glow
color NEON_MAGENTA_GLOW = color.new(#FF00FF, 60)
color NEON_GREEN_GLOW   = color.new(#39FF14, 60)
color NEON_RED_GLOW     = color.new(#FF073A, 60)

// ============================================
// CALCULATION VARIABLES
// ============================================

// Calculate ninePeriodRange: 9-period high - 9-period low
ninePeriodRange = ta.highest(high, 9) - ta.lowest(low, 9)

// Calculate distanceFromHigh9: 9-period high - close
distanceFromHigh9 = ta.highest(high, 9) - close

// Calculate distanceFromLow9: close - 9-period low
distanceFromLow9 = close - ta.lowest(low, 9)

// Calculate normalizedValue: distanceFromHigh9/ninePeriodRange*100-70
normalizedValue = ninePeriodRange != 0 ? distanceFromHigh9 / ninePeriodRange * 100 - 70 : 0

// Calculate sixtyPeriodPosition: (close-60-period low)/(60-period high-60-period low)*100
sixtyPeriodHigh = ta.highest(high, 60)
sixtyPeriodLow = ta.lowest(low, 60)
sixtyPeriodPosition = sixtyPeriodHigh != sixtyPeriodLow ? (close - sixtyPeriodLow) / (sixtyPeriodHigh - sixtyPeriodLow) * 100 : 50

// Calculate typicalPrice: (2*close+high+low)/4
typicalPrice = (2 * close + high + low) / 4

// Calculate smaDistanceFromLow: 3-period SMA of (distanceFromLow9/ninePeriodRange*100)
normalizedLowDistance = ninePeriodRange != 0 ? distanceFromLow9 / ninePeriodRange * 100 : 0
smaDistanceFromLow = ta.sma(normalizedLowDistance, 3)

// Calculate lowest34: 34-period low
lowest34 = ta.lowest(low, 34)

// Calculate momentumIndicator: 3-period SMA of smaDistanceFromLow - 9-period SMA of normalizedValue
momentumIndicator = ta.sma(smaDistanceFromLow, 3) - ta.sma(normalizedValue, 9)

// Calculate cappedMomentum: momentumIndicator-100 if momentumIndicator>100, else 0
cappedMomentum = momentumIndicator > 100 ? momentumIndicator - 100 : 0

// Calculate highest34: 34-period high
highest34 = ta.highest(high, 34)

// Calculate defenseLineB: 8-period EMA of Stochastic-like value
stochasticValue = (typicalPrice - lowest34) / (highest34 - lowest34) * 100
// Calculate EMA first for consistency (must be called on every bar)
stochasticEma = ta.ema(stochasticValue, 8)
// Then choose between EMA value and fallback based on range check
defenseLineB = highest34 != lowest34 ? stochasticEma : 50

// Calculate defenseLineB1: 5-period EMA of defenseLineB
defenseLineB1 = ta.ema(defenseLineB, 5)

// Calculate buySellDiff: defenseLineB - defenseLineB1
buySellDiff = defenseLineB - defenseLineB1

// Calculate shortLine: negative of buySellDiff
shortLine = -buySellDiff

// Calculate sellSignal: (previous buySellDiff>0 and current buySellDiff<=0) OR (buySellDiff between 0 and 1 and bearish candle)
sellSignal = (buySellDiff[1] > 0 and buySellDiff <= 0) or (buySellDiff < 1 and buySellDiff >= 0 and close < open)

// Calculate buySignal: no sell signal AND previous buySellDiff<0 AND current buySellDiff>0
buySignal = not sellSignal and buySellDiff[1] < 0 and buySellDiff > 0

// ============================================
// VISUALIZATION - HISTOGRAMS WITH GLOW EFFECTS
// ============================================

// Defense Line B rising (Neon Cyan with glow effect)
// Outer glow layer
plot(defenseLineB > 0 and buySellDiff >= 0 ? 19.5 : na, title="Defense Line B Rising Glow 2", style=plot.style_columns, color=NEON_CYAN_GLOW2, linewidth=28)
// Inner glow layer
plot(defenseLineB > 0 and buySellDiff >= 0 ? 19.5 : na, title="Defense Line B Rising Glow 1", style=plot.style_columns, color=NEON_CYAN_GLOW1, linewidth=24)
// Core layer
plot(defenseLineB > 0 and buySellDiff >= 0 ? 19.5 : na, title="Defense Line B Rising", style=plot.style_columns, color=NEON_CYAN, linewidth=20)

// Defense Line B falling (Neon Magenta with glow effect)
// Outer glow layer
plot(defenseLineB > 0 and buySellDiff < 0 ? 19.5 : na, title="Defense Line B Falling Glow 2", style=plot.style_columns, color=NEON_MAGENTA_GLOW, linewidth=28)
// Inner glow layer
plot(defenseLineB > 0 and buySellDiff < 0 ? 19.5 : na, title="Defense Line B Falling Glow 1", style=plot.style_columns, color=color.new(#FF00FF, 40), linewidth=24)
// Core layer
plot(defenseLineB > 0 and buySellDiff < 0 ? 19.5 : na, title="Defense Line B Falling", style=plot.style_columns, color=NEON_MAGENTA, linewidth=20)

// Buy signal histogram (Neon Green with glow effect)
// Outer glow
plot(buySignal ? 14 : na, title="Buy Signal Glow 2", style=plot.style_columns, color=NEON_GREEN_GLOW, linewidth=36)
// Inner glow
plot(buySignal ? 14 : na, title="Buy Signal Glow 1", style=plot.style_columns, color=color.new(#39FF14, 40), linewidth=32)
// Core
plot(buySignal ? 14 : na, title="Buy Signal Histogram", style=plot.style_columns, color=NEON_GREEN, linewidth=28)

// Sell signal histogram (Neon Red with glow effect)
// Outer glow
plot(sellSignal ? 14 : na, title="Sell Signal Glow 2", style=plot.style_columns, color=NEON_RED_GLOW, linewidth=36)
// Inner glow
plot(sellSignal ? 14 : na, title="Sell Signal Glow 1", style=plot.style_columns, color=color.new(#FF073A, 40), linewidth=32)
// Core
plot(sellSignal ? 14 : na, title="Sell Signal Histogram", style=plot.style_columns, color=NEON_RED, linewidth=28)

// ============================================
// VISUALIZATION - LINES WITH GLOW EFFECTS
// ============================================

// Buy/Sell Diff line with glow (Neon Cyan)
// Outer glow
plot(buySellDiff, title="Buy/Sell Diff Glow 2", color=NEON_CYAN_GLOW2, linewidth=7)
// Inner glow
plot(buySellDiff, title="Buy/Sell Diff Glow 1", color=NEON_CYAN_GLOW1, linewidth=5)
// Core line
plot(buySellDiff, title="Buy/Sell Diff", color=NEON_CYAN, linewidth=3)

// Short line with glow (Hot Pink)
// Outer glow
plot(shortLine, title="Short Line Glow 2", color=color.new(#FF69B4, 70), linewidth=7)
// Inner glow
plot(shortLine, title="Short Line Glow 1", color=color.new(#FF69B4, 45), linewidth=5)
// Core line
plot(shortLine, title="Short Line", color=HOT_PINK, linewidth=3)

// ============================================
// STATUS TABLE - CYBERPUNK STYLE
// ============================================

var table statusTable = table.new(position.top_right, 2, 5, bgcolor=MIDNIGHT_BLUE, border_width=2, border_color=NEON_CYAN, frame_width=1, frame_color=color.new(#00FFFF, 50))

if showTable and barstate.islast
    // Header row with cyberpunk styling
    table.cell(statusTable, 0, 0, "◆ DEFENSE MONITOR ◆", text_color=NEON_CYAN, text_size=size.small, bgcolor=color.new(#0A1628, 0))
    table.cell(statusTable, 1, 0, "◈ STATUS ◈", text_color=NEON_CYAN, text_size=size.small, bgcolor=color.new(#0A1628, 0))
    
    // Defense Line B value with trend indicator
    defenseTrend = defenseLineB > defenseLineB[1] ? " ▲" : " ▼"
    defenseColor = defenseLineB > defenseLineB[1] ? NEON_GREEN : NEON_RED
    table.cell(statusTable, 0, 1, "▸ DEFENSE B", text_color=color.new(#E0E0E0, 0), text_size=size.small)
    table.cell(statusTable, 1, 1, str.tostring(defenseLineB, "#.##") + defenseTrend, text_color=defenseColor, text_size=size.small)
    
    // Buy/Sell Diff with visual bar
    diffColor = buySellDiff > 0 ? NEON_GREEN : buySellDiff < 0 ? NEON_RED : color.new(#808080, 0)
    diffBar = buySellDiff > 0 ? " ████████" : buySellDiff < 0 ? " ░░░░░░░░" : " ────────"
    table.cell(statusTable, 0, 2, "▸ DIFF", text_color=color.new(#E0E0E0, 0), text_size=size.small)
    table.cell(statusTable, 1, 2, str.tostring(buySellDiff, "#.##") + diffBar, text_color=diffColor, text_size=size.small)
    
    // Signal status with emoji
    string signalText = "● NEUTRAL"
    color signalColor = color.new(#808080, 0)
    if buySignal
        signalText := "⚡ BUY SIGNAL"
        signalColor := NEON_GREEN
    else if sellSignal
        signalText := "⚠ SELL SIGNAL"
        signalColor := NEON_RED
    
    table.cell(statusTable, 0, 3, "▸ SIGNAL", text_color=color.new(#E0E0E0, 0), text_size=size.small)
    table.cell(statusTable, 1, 3, signalText, text_color=signalColor, text_size=size.small)
    
    // Trend direction
    string trendText = "◆ NEUTRAL"
    color trendColor = color.new(#808080, 0)
    if buySellDiff > 0
        trendText := "▲ UP TREND"
        trendColor := NEON_GREEN
    else if buySellDiff < 0
        trendText := "▼ DOWN TREND"
        trendColor := NEON_RED
    
    table.cell(statusTable, 0, 4, "▸ TREND", text_color=color.new(#E0E0E0, 0), text_size=size.small)
    table.cell(statusTable, 1, 4, trendText, text_color=trendColor, text_size=size.small)

// ============================================
// BUY/SELL LABELS - CYBERPUNK STYLE
// ============================================

if showLabels and barstate.isconfirmed
    // Buy Signal Labels with cyberpunk styling
    if buySignal
        // Neon Green arrow at position 40
        label.new(bar_index, 40, "⚡", color=color.new(#0D1B2A, 20), textcolor=NEON_GREEN, style=label.style_label_up, size=labelSize, yloc=yloc.price)
        
        // Glowing "BUY" text at position 30
        label.new(bar_index, 30, "▶ BUY ◀", color=NEON_GREEN, textcolor=color.new(#0D1B2A, 0), style=label.style_label_up, size=labelSize, yloc=yloc.price)
    
    // Sell Signal Labels with cyberpunk styling
    if sellSignal
        // Neon Red arrow at position 36
        label.new(bar_index, 36, "▼", color=color.new(#0D1B2A, 20), textcolor=NEON_RED, style=label.style_label_down, size=labelSize, yloc=yloc.price)
        
        // Glowing "SELL" text at position 30
        label.new(bar_index, 30, "◀ SELL ▶", color=NEON_RED, textcolor=color.new(#0D1B2A, 0), style=label.style_label_down, size=labelSize, yloc=yloc.price)

// ============================================
// HORIZONTAL LINES - NEON STYLING
// ============================================

// Zero line with neon glow effect
hline(0, "Zero Line", color=color.new(#00FFFF, 60), linestyle=hline.style_solid, linewidth=2)

// Defense Lines with Electric Blue
hline(19, "Defense Line Low", color=color.new(#0080FF, 70), linestyle=hline.style_dotted, linewidth=1)
hline(20, "Defense Line High", color=color.new(#0080FF, 70), linestyle=hline.style_dotted, linewidth=1)

// Signal Level with Neon Magenta
hline(28, "Signal Level", color=color.new(#FF00FF, 70), linestyle=hline.style_dashed, linewidth=1)

// Label Levels with Deep Purple
hline(30, "Label Level", color=color.new(#9D00FF, 80), linestyle=hline.style_dotted, linewidth=1)
hline(36, "Sell Arrow Level", color=color.new(#9D00FF, 80), linestyle=hline.style_dotted, linewidth=1)
hline(40, "Buy Arrow Level", color=color.new(#9D00FF, 80), linestyle=hline.style_dotted, linewidth=1)

// ============================================
// BACKGROUND COLORING - GRADIENT EFFECTS
// ============================================

// Primary signal background
bgColor = buySignal ? color.new(#39FF14, 92) : sellSignal ? color.new(#FF073A, 92) : na
bgcolor(bgColor, title="Signal Background")

// Secondary glow effect for signals
bgColorGlow = buySignal ? color.new(#00FF00, 97) : sellSignal ? color.new(#FF0000, 97) : na
bgcolor(bgColorGlow, title="Signal Glow")

// Trend-based subtle background tint
trendBgColor = buySellDiff > 5 ? color.new(#00FFFF, 98) : buySellDiff < -5 ? color.new(#FF00FF, 98) : na
bgcolor(trendBgColor, title="Trend Background")
