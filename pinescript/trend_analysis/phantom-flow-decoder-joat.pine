// ══════════════════════════════════════════════════════════════════════════════
// PHANTOM FLOW DECODER
// Institutional-grade market structure analysis with smart money flow detection
// Features: Order Block Detection, Premium/Discount Zones, Liquidity Voids,
//           Smart Money Traps, Institutional Accumulation/Distribution,
//           Volume-Weighted Structure, Multi-Layer FVG Analysis
// ══════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────
// COLOR PALETTE - Phantom Neon Theme (Dark Mode Optimized)
// ─────────────────────────────────────────────────────────────────────────────
// Primary Gradient - Bullish Spectrum
var color PFD_BULL_NEON         = #00ffcc  // Electric Cyan
var color PFD_BULL_GLOW         = #00e5b8  // Bright Teal
var color PFD_BULL_CORE         = #00cca3  // Deep Teal
var color PFD_BULL_FADE         = #00b38f  // Muted Teal
var color PFD_BULL_SHADOW       = #009a7a  // Shadow Teal

// Primary Gradient - Bearish Spectrum  
var color PFD_BEAR_NEON         = #ff3366  // Hot Pink
var color PFD_BEAR_GLOW         = #e62e5c  // Bright Magenta
var color PFD_BEAR_CORE         = #cc2952  // Deep Magenta
var color PFD_BEAR_FADE         = #b32448  // Muted Magenta
var color PFD_BEAR_SHADOW       = #99203e  // Shadow Magenta

// Structure Colors
var color PFD_BOS_BULL          = #00ffd5  // Neon Aqua
var color PFD_BOS_BEAR          = #ff2d55  // Neon Rose
var color PFD_CHOCH_BULL        = #7b68ee  // Medium Slate Blue
var color PFD_CHOCH_BEAR        = #ff6b9d  // Soft Pink

// Order Block Colors
var color PFD_OB_BULL           = color.new(#00e5cc, 70)
var color PFD_OB_BEAR           = color.new(#ff4d6d, 70)
var color PFD_OB_MITIGATED      = color.new(#4a5568, 85)

// FVG Colors with Gradient Support
var color PFD_FVG_BULL_STRONG   = color.new(#00ffcc, 65)
var color PFD_FVG_BULL_WEAK     = color.new(#00cca3, 80)
var color PFD_FVG_BEAR_STRONG   = color.new(#ff3366, 65)
var color PFD_FVG_BEAR_WEAK     = color.new(#cc2952, 80)

// Liquidity Colors
var color PFD_LIQ_POOL_BULL     = #00ffd5
var color PFD_LIQ_POOL_BEAR     = #ff2d55
var color PFD_LIQ_SWEPT         = #ffd700  // Gold for swept liquidity
var color PFD_LIQ_TRAP          = #ff00ff  // Magenta for traps

// Premium/Discount Zone Colors
var color PFD_PREMIUM_ZONE      = color.new(#ff6b6b, 88)
var color PFD_DISCOUNT_ZONE     = color.new(#4ecdc4, 88)
var color PFD_EQUILIBRIUM       = #a8b5c4

// Neutral & UI Colors
var color PFD_NEUTRAL           = #5d6d7e
var color PFD_NEON_CYAN         = #00ffff  // Added missing color
var color PFD_GRID              = color.new(#2d3748, 70)
var color PFD_TEXT_PRIMARY      = #e2e8f0
var color PFD_TEXT_SECONDARY    = #a0aec0
var color PFD_DASHBOARD_BG      = color.new(#1a1a2e, 5)
var color PFD_DASHBOARD_BORDER  = color.new(#2d2d44, 50)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────
string grpStructure = "Structure Detection"
int pivotLookback   = input.int(5, "Pivot Sensitivity", minval=2, maxval=20, group=grpStructure, tooltip="Lower = more sensitive, Higher = stronger pivots only")
bool showBOS        = input.bool(true, "Show Break of Structure (BOS)", group=grpStructure)
bool showCHoCH      = input.bool(true, "Show Change of Character (CHoCH)", group=grpStructure)
bool showStructure  = input.bool(true, "Show Structure Lines", group=grpStructure)
bool showSwingPoints = input.bool(true, "Show Swing Points", group=grpStructure)
string structureStyle = input.string("Solid", "Structure Line Style", options=["Solid", "Dashed", "Dotted"], group=grpStructure)

string grpOrderBlock = "Order Block Detection"
bool showOrderBlocks = input.bool(true, "Show Order Blocks", group=grpOrderBlock)
int obStrength      = input.int(3, "Order Block Strength", minval=1, maxval=10, group=grpOrderBlock, tooltip="Minimum candles for valid OB")
bool showOBMitigation = input.bool(true, "Track OB Mitigation", group=grpOrderBlock)
float obMinSize     = input.float(0.5, "Min OB Size (ATR)", minval=0.1, maxval=3.0, step=0.1, group=grpOrderBlock)

string grpLiquidity = "Liquidity Detection"
bool showLiqPools   = input.bool(true, "Show Liquidity Pools", group=grpLiquidity)
bool showSweeps     = input.bool(true, "Show Liquidity Sweeps", group=grpLiquidity)
bool showTraps      = input.bool(true, "Show Smart Money Traps", group=grpLiquidity)
int liqSensitivity  = input.int(3, "Liquidity Sensitivity", minval=1, maxval=10, group=grpLiquidity)
float sweepThresh   = input.float(0.5, "Sweep Threshold (ATR)", minval=0.1, maxval=2.0, step=0.1, group=grpLiquidity)
bool volumeWeighted = input.bool(true, "Volume-Weighted Liquidity", group=grpLiquidity)

string grpFVG       = "Fair Value Gaps"
bool showFVG        = input.bool(true, "Show FVG Zones", group=grpFVG)
int fvgMaxAge       = input.int(50, "FVG Max Age (bars)", minval=10, maxval=200, group=grpFVG)
bool fvgMitigation  = input.bool(true, "Track FVG Mitigation", group=grpFVG)
float minFVGSize    = input.float(0.3, "Min FVG Size (ATR)", minval=0.1, maxval=2.0, step=0.1, group=grpFVG)
bool showFVGCE      = input.bool(true, "Show Consequent Encroachment", group=grpFVG, tooltip="50% level of FVG")

string grpPremDisc  = "Premium/Discount Zones"
bool showPremDisc   = input.bool(true, "Show Premium/Discount", group=grpPremDisc)
int pdLookback      = input.int(50, "Zone Lookback", minval=20, maxval=200, group=grpPremDisc)
bool showEquilibrium = input.bool(true, "Show Equilibrium Line", group=grpPremDisc)

string grpVisual    = "Visual Settings"
int maxStructures   = input.int(25, "Max Structure Elements", minval=5, maxval=50, group=grpVisual)
bool showDashboard  = input.bool(true, "Show Dashboard", group=grpVisual)
bool colorCandles   = input.bool(true, "Color Candles by Trend", group=grpVisual)
bool showGradientBG = input.bool(false, "Show Gradient Background", group=grpVisual)
bool showAccumDist  = input.bool(false, "Show Accumulation/Distribution", group=grpVisual)
bool showAccumDistLine = input.bool(false, "Show A/D Line", group=grpVisual)
string dashPosition = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grpVisual)

// ─────────────────────────────────────────────────────────────────────────────
// TYPE DEFINITIONS
// ─────────────────────────────────────────────────────────────────────────────
type PivotPoint
    float price
    int barIdx
    bool isHigh
    bool isValid
    float vol
    label marker

type StructureBreak
    float price
    int barIdx
    bool isBullish
    bool isCHoCH
    float strength
    line drawLine
    label drawLabel

type OrderBlock
    float top
    float bottom
    int barIdx
    bool isBullish
    bool isMitigated
    float vol
    int touchCount
    box drawBox
    line midLine

type LiquidityPool
    float price
    int barIdx
    float vol
    float volumeWeight
    bool isBullish
    bool isSwept
    bool isTrap
    int touchCount
    box drawBox
    label volLabel
    label trapLabel
    label sweepLabel
    
type FairValueGap
    float top
    float bottom
    float ce  // Consequent Encroachment (50%)
    int barIdx
    bool isBullish
    bool isMitigated
    float size
    box drawBox
    line ceLine

type PremiumDiscount
    float premiumTop
    float premiumBot
    float discountTop
    float discountBot
    float equilibrium
    box premBox
    box discBox
    line eqLine

// Type method definitions (constructors)
PivotPoint_new(float price, int barIdx, bool isHigh, bool isValid, float vol, label marker) =>
    PivotPoint.new(price, barIdx, isHigh, isValid, vol, marker)

StructureBreak_new(float price, int barIdx, bool isBullish, bool isCHoCH, float strength, line drawLine, label drawLabel) =>
    StructureBreak.new(price, barIdx, isBullish, isCHoCH, strength, drawLine, drawLabel)

OrderBlock_new(float top, float bottom, int barIdx, bool isBullish, bool isMitigated, float vol, int touchCount, box drawBox, line midLine) =>
    OrderBlock.new(top, bottom, barIdx, isBullish, isMitigated, vol, touchCount, drawBox, midLine)

LiquidityPool_new(float price, int barIdx, float vol, float volumeWeight, bool isBullish, bool isSwept, bool isTrap, int touchCount, box drawBox, label volLabel, label trapLabel, label sweepLabel) =>
    LiquidityPool.new(price, barIdx, vol, volumeWeight, isBullish, isSwept, isTrap, touchCount, drawBox, volLabel, trapLabel, sweepLabel)

FairValueGap_new(float top, float bottom, float ce, int barIdx, bool isBullish, bool isMitigated, float size, box drawBox, line ceLine) =>
    FairValueGap.new(top, bottom, ce, barIdx, isBullish, isMitigated, size, drawBox, ceLine)

PremiumDiscount_new(float premiumTop, float premiumBot, float discountTop, float discountBot, float equilibrium, box premBox, box discBox, line eqLine) =>
    PremiumDiscount.new(premiumTop, premiumBot, discountTop, discountBot, equilibrium, premBox, discBox, eqLine)

// ─────────────────────────────────────────────────────────────────────────────
// GLOBAL VARIABLES
// ─────────────────────────────────────────────────────────────────────────────
var array<PivotPoint> pivotHighs = array.new<PivotPoint>()
var array<PivotPoint> pivotLows = array.new<PivotPoint>()
var array<StructureBreak> structures = array.new<StructureBreak>()
var array<OrderBlock> orderBlocks = array.new<OrderBlock>()
var array<LiquidityPool> liqPools = array.new<LiquidityPool>()
var array<FairValueGap> fvgZones = array.new<FairValueGap>()


var int trendDirection = 0
var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na
var int structureStrength = 0
var int bosCount = 0
var int chochCount = 0
var int sweepCount = 0
var int trapCount = 0

// Track last BOS levels to prevent duplicates
var float lastBOSHigh = na
var float lastBOSLow = na

// Track last CHoCH levels to prevent duplicates
var float lastCHoCHHigh = na
var float lastCHoCHLow = na

// Premium/Discount tracking
var PremiumDiscount pdZone = PremiumDiscount.new(na, na, na, na, na, na, na, na)

// Cached values for consistency
var float cachedAtr = na
var float cachedVolSma = na

// ─────────────────────────────────────────────────────────────────────────────
// UTILITY FUNCTIONS
// ─────────────────────────────────────────────────────────────────────────────
atrValue() => ta.atr(14)
volSMA() => ta.sma(volume, 20)

// Advanced gradient with intensity
gradientColor(float value, float minVal, float maxVal, color colMin, color colMax) =>
    color.from_gradient(value, minVal, maxVal, colMin, colMax)

// Get line style from input
getLineStyle(string style) =>
    switch style
        "Solid" => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

// Calculate structure strength based on volume and price movement
calcStructureStrength(float priceMove, float vol, float atrVal, float volSmaVal) =>
    float volRatio = vol / volSmaVal
    float priceRatio = priceMove / atrVal
    math.min(100, (volRatio * 30 + priceRatio * 70))

// Dashboard position helper
getDashPosition(string pos) =>
    switch pos
        "Top Right" => position.top_right
        "Top Left" => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left" => position.bottom_left
        => position.top_right

cleanupArraySize(array<StructureBreak> arr, int maxSize) =>
    while array.size(arr) > maxSize
        StructureBreak old = array.shift(arr)
        if not na(old.drawLine)
            line.delete(old.drawLine)
        if not na(old.drawLabel)
            label.delete(old.drawLabel)

cleanupOrderBlocks(array<OrderBlock> arr, int maxSize) =>
    while array.size(arr) > maxSize
        OrderBlock old = array.shift(arr)
        if not na(old.drawBox)
            box.delete(old.drawBox)
        if not na(old.midLine)
            line.delete(old.midLine)

cleanupLiquiditySize(array<LiquidityPool> arr, int maxSize) =>
    while array.size(arr) > maxSize
        LiquidityPool old = array.shift(arr)
        if not na(old.drawBox)
            box.delete(old.drawBox)
        if not na(old.volLabel)
            label.delete(old.volLabel)
        if not na(old.trapLabel)
            label.delete(old.trapLabel)
        if not na(old.sweepLabel)
            label.delete(old.sweepLabel)

cleanupFVGSize(array<FairValueGap> arr, int maxSize) =>
    while array.size(arr) > maxSize
        FairValueGap old = array.shift(arr)
        if not na(old.drawBox)
            box.delete(old.drawBox)
        if not na(old.ceLine)
            line.delete(old.ceLine)

cleanupStructures(array<StructureBreak> arr, int maxSize) =>
    while array.size(arr) > maxSize
        StructureBreak old = array.shift(arr)
        if not na(old.drawLine)
            line.delete(old.drawLine)
        if not na(old.drawLabel)
            label.delete(old.drawLabel)

// ─────────────────────────────────────────────────────────────────────────────
// PIVOT DETECTION
// ─────────────────────────────────────────────────────────────────────────────
detectPivots() =>
    float pivotHigh = ta.pivothigh(high, pivotLookback, pivotLookback)
    float pivotLow = ta.pivotlow(low, pivotLookback, pivotLookback)
    PivotPoint newHighPivot = na
    PivotPoint newLowPivot = na
    float newLastSwingHigh = na
    int newLastSwingHighBar = na
    float newLastSwingLow = na
    int newLastSwingLowBar = na

    if not na(pivotHigh)
        newHighPivot := PivotPoint_new(pivotHigh, bar_index - pivotLookback, true, false, volume[pivotLookback], na)
        if showSwingPoints
            // Determine if this is HH or LH by comparing to previous swing high
            string pivotLabel = "SH"
            color pivotColor = PFD_NEUTRAL
            color textCol = color.white
            if not na(lastSwingHigh)
                if pivotHigh > lastSwingHigh
                    pivotLabel := "HH"
                    pivotColor := PFD_BULL_NEON
                else
                    pivotLabel := "LH"
                    pivotColor := PFD_BEAR_GLOW
            // Clean small label positioned above swing high
            float circleOffset = high[pivotLookback] + (cachedAtr * 0.2)
            newHighPivot.marker := label.new(bar_index - pivotLookback, circleOffset, pivotLabel, 
                                      color=color.new(pivotColor, 15), textcolor=textCol, 
                                      size=size.small, style=label.style_label_down)
        newLastSwingHigh := pivotHigh
        newLastSwingHighBar := bar_index - pivotLookback

    if not na(pivotLow)
        newLowPivot := PivotPoint_new(pivotLow, bar_index - pivotLookback, false, false, volume[pivotLookback], na)
        if showSwingPoints
            // Determine if this is LL or HL by comparing to previous swing low
            string pivotLabel = "SL"
            color pivotColor = PFD_NEUTRAL
            color textCol = color.white
            if not na(lastSwingLow)
                if pivotLow < lastSwingLow
                    pivotLabel := "LL"
                    pivotColor := PFD_BEAR_NEON
                else
                    pivotLabel := "HL"
                    pivotColor := PFD_BULL_GLOW
            // Clean small label positioned below swing low
            float circleOffset = low[pivotLookback] - (cachedAtr * 0.2)
            newLowPivot.marker := label.new(bar_index - pivotLookback, circleOffset, pivotLabel, 
                                      color=color.new(pivotColor, 15), textcolor=textCol, 
                                      size=size.small, style=label.style_label_up)
        newLastSwingLow := pivotLow
        newLastSwingLowBar := bar_index - pivotLookback
    
    [newHighPivot, newLowPivot, newLastSwingHigh, newLastSwingHighBar, newLastSwingLow, newLastSwingLowBar]

// ─────────────────────────────────────────────────────────────────────────────
// ORDER BLOCK DETECTION
// ─────────────────────────────────────────────────────────────────────────────
detectOrderBlocks() =>
    if array.size(pivotHighs) >= 2 and showOrderBlocks
        // Bearish Order Block (last down candle before pivot high)
        PivotPoint lastHigh = array.get(pivotHighs, array.size(pivotHighs) - 1)
        int barsSince = bar_index - lastHigh.barIdx
        if barsSince > 1 and barsSince <= 100
            float obTop = high[barsSince - 1]
            float obBot = low[barsSince - 1]
            float obSize = obTop - obBot
            
            if obSize >= cachedAtr * obMinSize
                OrderBlock newOB = OrderBlock_new(obTop, obBot, lastHigh.barIdx, false, false, volume[barsSince - 1], 0, na, na)
                array.push(orderBlocks, newOB)
    
    if array.size(pivotLows) >= 2 and showOrderBlocks
        // Bullish Order Block (last up candle before pivot low)
        PivotPoint lastLow = array.get(pivotLows, array.size(pivotLows) - 1)
        int barsSince = bar_index - lastLow.barIdx
        if barsSince > 1 and barsSince <= 100
            float obTop = high[barsSince - 1]
            float obBot = low[barsSince - 1]
            float obSize = obTop - obBot
            
            if obSize >= cachedAtr * obMinSize
                OrderBlock newOB = OrderBlock_new(obTop, obBot, lastLow.barIdx, true, false, volume[barsSince - 1], 0, na, na)
                array.push(orderBlocks, newOB)

// ─────────────────────────────────────────────────────────────────────────────
// LIQUIDITY POOL DETECTION
// ─────────────────────────────────────────────────────────────────────────────
detectLiquidityPools() =>
    // Detect swing liquidity pools
    if array.size(pivotHighs) >= 2
        for i = 0 to array.size(pivotHighs) - 2
            PivotPoint curr = array.get(pivotHighs, i)
            PivotPoint next = array.get(pivotHighs, i + 1)
            
            if curr.price < next.price and not curr.isValid
                curr.isValid := true
                float volWeight = volumeWeighted ? curr.vol / cachedVolSma : 1.0
                LiquidityPool newPool = LiquidityPool_new(curr.price, curr.barIdx, curr.vol, volWeight, true, false, false, 0, na, na, na, na)
                array.push(liqPools, newPool)
    
    if array.size(pivotLows) >= 2
        for i = 0 to array.size(pivotLows) - 2
            PivotPoint curr = array.get(pivotLows, i)
            PivotPoint next = array.get(pivotLows, i + 1)
            
            if curr.price > next.price and not curr.isValid
                curr.isValid := true
                float volWeight = volumeWeighted ? curr.vol / cachedVolSma : 1.0
                LiquidityPool newPool = LiquidityPool_new(curr.price, curr.barIdx, curr.vol, volWeight, false, false, false, 0, na, na, na, na)
                array.push(liqPools, newPool)

// ─────────────────────────────────────────────────────────────────────────────
// FVG DETECTION
// ─────────────────────────────────────────────────────────────────────────────
detectFVG() =>
    // Bullish FVG - gap up: current bar's low is above 2-bars-ago high
    if low > high[2]
        float fvgTop = low
        float fvgBottom = high[2]
        float fvgSize = fvgTop - fvgBottom
        
        if fvgSize >= cachedAtr * minFVGSize
            float ce = (fvgTop + fvgBottom) / 2
            FairValueGap newFVG = FairValueGap_new(fvgTop, fvgBottom, ce, bar_index, true, false, fvgSize, na, na)
            array.push(fvgZones, newFVG)
    
    // Bearish FVG - gap down: current bar's high is below 2-bars-ago low
    if high < low[2]
        float fvgTop = low[2]
        float fvgBottom = high
        float fvgSize = fvgTop - fvgBottom
        
        if fvgSize >= cachedAtr * minFVGSize
            float ce = (fvgTop + fvgBottom) / 2
            FairValueGap newFVG = FairValueGap_new(fvgTop, fvgBottom, ce, bar_index, false, false, fvgSize, na, na)
            array.push(fvgZones, newFVG)

// ─────────────────────────────────────────────────────────────────────────────
// PREMIUM/DISCOUNT ZONE CALCULATION
// ─────────────────────────────────────────────────────────────────────────────
calculatePremiumDiscount() =>
    if showPremDisc
        float highestHigh = ta.highest(high, pdLookback)
        float lowestLow = ta.lowest(low, pdLookback)
        float priceRange = highestHigh - lowestLow
        
        // Premium zone (top 20%)
        pdZone.premiumTop := highestHigh
        pdZone.premiumBot := highestHigh - priceRange * 0.2
        
        // Discount zone (bottom 20%)
        pdZone.discountTop := lowestLow + priceRange * 0.2
        pdZone.discountBot := lowestLow
        
        // Equilibrium (50% level)
        pdZone.equilibrium := lowestLow + priceRange * 0.5

// ─────────────────────────────────────────────────────────────────────────────
// FVG MITIGATION CHECK
// ─────────────────────────────────────────────────────────────────────────────
checkFVGMitigation() =>
    if fvgMitigation and array.size(fvgZones) > 0
        for i = 0 to array.size(fvgZones) - 1
            FairValueGap fvg = array.get(fvgZones, i)
            
            if not fvg.isMitigated
                int age = bar_index - fvg.barIdx
                
                if age > fvgMaxAge
                    fvg.isMitigated := true
                else if fvg.isBullish and low <= fvg.bottom
                    fvg.isMitigated := true
                else if not fvg.isBullish and high >= fvg.top
                    fvg.isMitigated := true

// ─────────────────────────────────────────────────────────────────────────────
// ORDER BLOCK MITIGATION CHECK
// ─────────────────────────────────────────────────────────────────────────────
checkOBMitigation() =>
    if showOBMitigation and array.size(orderBlocks) > 0
        for i = 0 to array.size(orderBlocks) - 1
            OrderBlock ob = array.get(orderBlocks, i)
            
            if not ob.isMitigated
                if ob.isBullish and low <= ob.bottom
                    ob.isMitigated := true
                else if not ob.isBullish and high >= ob.top
                    ob.isMitigated := true

// ─────────────────────────────────────────────────────────────────────────────
// DRAWING FUNCTIONS
// ─────────────────────────────────────────────────────────────────────────────
drawOrderBlocks() =>
    if showOrderBlocks and array.size(orderBlocks) > 0
        for i = 0 to array.size(orderBlocks) - 1
            OrderBlock ob = array.get(orderBlocks, i)
            
            // Skip mitigated OBs
            if ob.isMitigated
                if not na(ob.drawBox)
                    box.delete(ob.drawBox)
                    ob.drawBox := na
                if not na(ob.midLine)
                    line.delete(ob.midLine)
                    ob.midLine := na
                continue
            
            // Calculate dynamic box width - extends further for better visibility
            int obAge = bar_index - ob.barIdx
            int boxRight = obAge < 30 ? bar_index : ob.barIdx + 30
            
            if na(ob.drawBox)
                // Institutional-grade OB styling with gradient transparency
                color obColor = ob.isBullish ? color.new(PFD_BULL_CORE, 82) : color.new(PFD_BEAR_CORE, 85)
                color obBorder = ob.isBullish ? PFD_BULL_NEON : PFD_BEAR_NEON
                
                ob.drawBox := box.new(ob.barIdx, ob.top, boxRight, ob.bottom, 
                                     bgcolor=obColor, border_color=color.new(obBorder, 40), border_width=2)
                // Add EQ line in middle - dashed style for clean look
                ob.midLine := line.new(ob.barIdx, (ob.top + ob.bottom) / 2, 
                                      boxRight, (ob.top + ob.bottom) / 2, 
                                      color=color.new(PFD_EQUILIBRIUM, 30), style=line.style_dashed, width=1)
                ob.midLine := ob.midLine
            else
                // Update box right edge for recent OBs
                if obAge < 30
                    box.set_right(ob.drawBox, bar_index)
                    if not na(ob.midLine)
                        line.set_x2(ob.midLine, bar_index)
                ob.midLine := ob.midLine

drawStructure() =>
    if showStructure and array.size(structures) > 0
        for i = 0 to array.size(structures) - 1
            StructureBreak s = array.get(structures, i)
            if na(s.drawLine)
                color sColor = s.isBullish ? PFD_BOS_BULL : PFD_BOS_BEAR
                if s.isCHoCH
                    sColor := s.isBullish ? PFD_CHOCH_BULL : PFD_CHOCH_BEAR
                
                // Draw structure line - extend to current bar if recent
                int lineAge = bar_index - s.barIdx
                int lineRight = lineAge < 40 ? bar_index : s.barIdx + 40
                s.drawLine := line.new(s.barIdx, s.price, lineRight, s.price, 
                                      color=sColor, style=getLineStyle(structureStyle), width=2)
                
                // Always show BOS/CHoCH labels - compact precise styling
                if (s.isCHoCH and showCHoCH) or (not s.isCHoCH and showBOS)
                    float labelOffset = s.isBullish ? cachedAtr * 0.25 : -cachedAtr * 0.25
                    string labelText = s.isCHoCH ? "CHoCH" : "BOS"
                    color lblBg = s.isCHoCH ? color.new(sColor, 5) : color.new(sColor, 10)
                    s.drawLabel := label.new(s.barIdx + 2, s.price + labelOffset, labelText, 
                                           color=lblBg, textcolor=color.white, 
                                           size=size.small, style=s.isBullish ? label.style_label_down : label.style_label_up)
                s.drawLabel := s.drawLabel
            else
                // Update line right edge for recent structures
                int lineAge = bar_index - s.barIdx
                if lineAge < 40
                    line.set_x2(s.drawLine, bar_index)
                s.drawLabel := s.drawLabel

drawLiquidityPools() =>
    if showLiqPools and array.size(liqPools) > 0
        for i = 0 to array.size(liqPools) - 1
            LiquidityPool pool = array.get(liqPools, i)
            
            // Calculate dynamic box width
            int poolAge = bar_index - pool.barIdx
            int boxRight = poolAge < 30 ? bar_index : pool.barIdx + 30
            float boxHeight = cachedAtr * 0.08
            
            if na(pool.drawBox)
                color poolColor = pool.isBullish ? PFD_LIQ_POOL_BULL : PFD_LIQ_POOL_BEAR
                color poolBgColor = color.new(poolColor, 80)
                
                if pool.isSwept
                    poolColor := PFD_LIQ_SWEPT
                    poolBgColor := color.new(PFD_LIQ_SWEPT, 65)
                else if pool.isTrap
                    poolColor := PFD_LIQ_TRAP
                    poolBgColor := color.new(PFD_LIQ_TRAP, 65)
                
                // Clean liquidity pool box with subtle border
                pool.drawBox := box.new(pool.barIdx, pool.price + boxHeight, 
                                       boxRight, pool.price - boxHeight, 
                                       bgcolor=poolBgColor, 
                                       border_color=color.new(poolColor, 50), border_width=1)
                
                // Draw TRAP label - compact magenta
                if pool.isTrap and showTraps and na(pool.trapLabel)
                    float trapOffset = pool.isBullish ? cachedAtr * 0.3 : -cachedAtr * 0.3
                    pool.trapLabel := label.new(pool.barIdx, pool.price + trapOffset, "TRAP", 
                                              color=color.new(PFD_LIQ_TRAP, 5), textcolor=color.white, 
                                              size=size.small, style=pool.isBullish ? label.style_label_down : label.style_label_up)
                
                // Draw SWEEP label - compact gold with dark text
                if pool.isSwept and showSweeps and na(pool.sweepLabel)
                    float sweepOffset = pool.isBullish ? -cachedAtr * 0.3 : cachedAtr * 0.3
                    pool.sweepLabel := label.new(pool.barIdx, pool.price + sweepOffset, "SWEEP", 
                                                color=color.new(PFD_LIQ_SWEPT, 5), textcolor=#1a1a2e, 
                                                size=size.small, style=pool.isBullish ? label.style_label_up : label.style_label_down)
                pool.sweepLabel := pool.sweepLabel
            else
                // Update box right edge for recent pools
                if poolAge < 30
                    box.set_right(pool.drawBox, bar_index)
                
                // Update sweep label position if newly swept
                if pool.isSwept and showSweeps
                    if na(pool.sweepLabel)
                        float sweepOffset = pool.isBullish ? -cachedAtr * 0.3 : cachedAtr * 0.3
                        pool.sweepLabel := label.new(bar_index, pool.price + sweepOffset, "SWEEP", 
                                                    color=color.new(PFD_LIQ_SWEPT, 5), textcolor=#1a1a2e, 
                                                    size=size.small, style=pool.isBullish ? label.style_label_up : label.style_label_down)
                    // Update box color when swept - gold highlight
                    box.set_bgcolor(pool.drawBox, color.new(PFD_LIQ_SWEPT, 65))
                    box.set_border_color(pool.drawBox, color.new(PFD_LIQ_SWEPT, 40))
                pool.sweepLabel := pool.sweepLabel

drawFVGZones() =>
    if showFVG and array.size(fvgZones) > 0
        for i = 0 to array.size(fvgZones) - 1
            FairValueGap fvg = array.get(fvgZones, i)
            // Skip mitigated FVGs - don't draw them at all
            if fvg.isMitigated
                if not na(fvg.drawBox)
                    box.delete(fvg.drawBox)
                    fvg.drawBox := na
                if not na(fvg.ceLine)
                    line.delete(fvg.ceLine)
                    fvg.ceLine := na
                continue
            
            // Calculate dynamic box width based on age (max 20 bars, extends to current bar if recent)
            int fvgAge = bar_index - fvg.barIdx
            int boxRight = fvgAge < 20 ? bar_index : fvg.barIdx + 20
            
            if na(fvg.drawBox)
                color fvgColor = fvg.isBullish ? PFD_FVG_BULL_STRONG : PFD_FVG_BEAR_STRONG
                if fvg.size < cachedAtr * 0.5
                    fvgColor := fvg.isBullish ? PFD_FVG_BULL_WEAK : PFD_FVG_BEAR_WEAK
                fvg.drawBox := box.new(fvg.barIdx, fvg.top, boxRight, fvg.bottom, 
                                       bgcolor=fvgColor, border_color=color.new(fvg.isBullish ? PFD_BULL_NEON : PFD_BEAR_NEON, 70), border_width=1)
                if showFVGCE and na(fvg.ceLine)
                    fvg.ceLine := line.new(fvg.barIdx, fvg.ce, boxRight, fvg.ce, 
                                          color=color.new(PFD_EQUILIBRIUM, 40), 
                                          style=line.style_dotted, width=1)
                // Align branch return type
                fvg.ceLine := fvg.ceLine
            else
                // Update box right edge for recent FVGs
                if fvgAge < 20
                    box.set_right(fvg.drawBox, bar_index)
                    if not na(fvg.ceLine)
                        line.set_x2(fvg.ceLine, bar_index)
                // Align branch return type
                fvg.ceLine := fvg.ceLine

drawPremiumDiscount() =>
    if showPremDisc and not na(pdZone)
        // Update existing boxes or create new ones
        if not na(pdZone.premBox)
            box.set_right(pdZone.premBox, bar_index)
            box.set_top(pdZone.premBox, pdZone.premiumTop)
            box.set_bottom(pdZone.premBox, pdZone.premiumBot)
        else
            pdZone.premBox := box.new(bar_index - pdLookback, pdZone.premiumTop, 
                                    bar_index, pdZone.premiumBot, 
                                    bgcolor=PFD_PREMIUM_ZONE, border_color=na)
        
        if not na(pdZone.discBox)
            box.set_right(pdZone.discBox, bar_index)
            box.set_top(pdZone.discBox, pdZone.discountTop)
            box.set_bottom(pdZone.discBox, pdZone.discountBot)
        else
            pdZone.discBox := box.new(bar_index - pdLookback, pdZone.discountTop, 
                                    bar_index, pdZone.discountBot, 
                                    bgcolor=PFD_DISCOUNT_ZONE, border_color=na)
        
        if showEquilibrium
            if not na(pdZone.eqLine)
                line.set_x2(pdZone.eqLine, bar_index)
            else
                pdZone.eqLine := line.new(bar_index - pdLookback, pdZone.equilibrium, 
                                        bar_index, pdZone.equilibrium, 
                                        color=PFD_EQUILIBRIUM, width=2, style=line.style_dashed)
            // Align branch return type
            pdZone.eqLine := pdZone.eqLine

// ─────────────────────────────────────────────────────────────────────────────
// SMART MONEY TRAP DETECTION
// ─────────────────────────────────────────────────────────────────────────────
detectSmartMoneyTraps() =>
    array<LiquidityPool> newTraps = array.new<LiquidityPool>()
    int newTrapCount = 0
    
    if showTraps
        if array.size(pivotLows) >= 2
            PivotPoint recentLow = array.get(pivotLows, array.size(pivotLows) - 1)
            
            // Bullish trap (liquidity grab below recent low then close back above)
            if low < recentLow.price and close > recentLow.price and low[1] >= recentLow.price
                newTrapCount += 1
                LiquidityPool trap = LiquidityPool_new(recentLow.price, bar_index, volume, 1.5, true, false, true, 0, na, na, na, na)
                array.push(newTraps, trap)
        if array.size(pivotHighs) >= 2
            PivotPoint recentHigh = array.get(pivotHighs, array.size(pivotHighs) - 1)
            
            // Bearish trap (liquidity grab above recent high then close back below)
            if high > recentHigh.price and close < recentHigh.price and high[1] <= recentHigh.price
                newTrapCount += 1
                LiquidityPool trap = LiquidityPool_new(recentHigh.price, bar_index, volume, 1.5, false, false, true, 0, na, na, na, na)
                array.push(newTraps, trap)
    
    [newTraps, newTrapCount]

// ─────────────────────────────────────────────────────────────────────────────
// LIQUIDITY SWEEP DETECTION
// ─────────────────────────────────────────────────────────────────────────────
detectLiquiditySweeps() =>
    int newSweepCount = 0
    
    if array.size(liqPools) > 0
        for i = 0 to array.size(liqPools) - 1
            LiquidityPool pool = array.get(liqPools, i)
            
            if not pool.isSwept
                float sweepDist = sweepThresh * cachedAtr
                
                if pool.isBullish and high > pool.price + sweepDist
                    pool.isSwept := true
                    newSweepCount += 1
                    pool.touchCount += 1
                else if not pool.isBullish and low < pool.price - sweepDist
                    pool.isSwept := true
                    newSweepCount += 1
                    pool.touchCount += 1
            else
                // Track touches after sweep
                if pool.isBullish and high > pool.price
                    pool.touchCount += 1
                else if not pool.isBullish and low < pool.price
                    pool.touchCount += 1
    
    newSweepCount

// ─────────────────────────────────────────────────────────────────────────────
// MAIN EXECUTION
// ─────────────────────────────────────────────────────────────────────────────
// Update cached values - moved before detectPivots() to ensure ATR is available
cachedAtr := atrValue()
cachedVolSma := volSMA()

// Declare variables for trap detection
var array<LiquidityPool> detectedTraps = array.new<LiquidityPool>()
var int newTrapDetected = 0

// Detect all elements - CALL detectPivots() to actually detect pivots!
[detectedHighPivot, detectedLowPivot, detectedNewSwingHigh, detectedNewSwingHighBar, detectedNewSwingLow, detectedNewSwingLowBar] = detectPivots()

// Update arrays and global variables
if not na(detectedHighPivot)
    array.push(pivotHighs, detectedHighPivot)
    if array.size(pivotHighs) > 50
        array.shift(pivotHighs)
    lastSwingHigh := detectedNewSwingHigh
    lastSwingHighBar := detectedNewSwingHighBar

if not na(detectedLowPivot)
    array.push(pivotLows, detectedLowPivot)
    if array.size(pivotLows) > 50
        array.shift(pivotLows)
    lastSwingLow := detectedNewSwingLow
    lastSwingLowBar := detectedNewSwingLowBar

detectOrderBlocks()
detectLiquidityPools()
detectFVG()
calculatePremiumDiscount()
checkFVGMitigation()
checkOBMitigation()

// Detect smart money traps and sweeps
array.clear(detectedTraps)
newTrapDetected := 0

// Detect traps - tuple declaration creates fresh local variables each bar
[detectedTrapArray, detectedTrapCount] = detectSmartMoneyTraps()

if array.size(detectedTrapArray) > 0
    for trap in detectedTrapArray
        array.push(detectedTraps, trap)
        array.push(liqPools, trap)
if detectedTrapCount > 0
    trapCount += detectedTrapCount

int currentSweeps = detectLiquiditySweeps()
sweepCount += currentSweeps

// Structure Break Detection (moved to main scope to handle global variables)
if array.size(pivotHighs) >= 2 and array.size(pivotLows) >= 2
    PivotPoint lastHigh = array.get(pivotHighs, array.size(pivotHighs) - 1)
    PivotPoint prevHigh = array.get(pivotHighs, array.size(pivotHighs) - 2)
    PivotPoint lastLow = array.get(pivotLows, array.size(pivotLows) - 1)
    PivotPoint prevLow = array.get(pivotLows, array.size(pivotLows) - 2)
    
    // Bullish BOS - close breaks above last swing high
    if close > lastHigh.price and close[1] <= lastHigh.price and lastHigh.price != lastBOSHigh
        if trendDirection != -1
            trendDirection := 1
            bosCount += 1
            float strength = calcStructureStrength(close - lastHigh.price, volume, cachedAtr, cachedVolSma)
            StructureBreak newBreak = StructureBreak_new(lastHigh.price, bar_index, true, false, strength, na, na)
            array.push(structures, newBreak)
            lastBOSHigh := lastHigh.price
        else
            // Was bearish, now breaking high = CHoCH
            trendDirection := 1
            chochCount += 1
            float strength = calcStructureStrength(close - lastHigh.price, volume, cachedAtr, cachedVolSma)
            StructureBreak newBreak = StructureBreak_new(lastHigh.price, bar_index, true, true, strength, na, na)
            array.push(structures, newBreak)
            lastCHoCHHigh := lastHigh.price
    
    // Bearish BOS - close breaks below last swing low
    if close < lastLow.price and close[1] >= lastLow.price and lastLow.price != lastBOSLow
        if trendDirection != 1
            trendDirection := -1
            bosCount += 1
            float strength = calcStructureStrength(lastLow.price - close, volume, cachedAtr, cachedVolSma)
            StructureBreak newBreak = StructureBreak_new(lastLow.price, bar_index, false, false, strength, na, na)
            array.push(structures, newBreak)
            lastBOSLow := lastLow.price
        else
            // Was bullish, now breaking low = CHoCH
            trendDirection := -1
            chochCount += 1
            float strength = calcStructureStrength(lastLow.price - close, volume, cachedAtr, cachedVolSma)
            StructureBreak newBreak = StructureBreak_new(lastLow.price, bar_index, false, true, strength, na, na)
            array.push(structures, newBreak)
            lastCHoCHLow := lastLow.price


// Cleanup old elements
cleanupStructures(structures, maxStructures)
cleanupFVGSize(fvgZones, maxStructures * 2)
cleanupOrderBlocks(orderBlocks, maxStructures)
cleanupLiquiditySize(liqPools, maxStructures)

// Draw all elements
drawOrderBlocks()
drawStructure()
drawLiquidityPools()
drawFVGZones()
drawPremiumDiscount()

// ─────────────────────────────────────────────────────────────────────────────
// ACCUMULATION/DISTRIBUTION VISUALIZATION
// ─────────────────────────────────────────────────────────────────────────────
// Calculate accumulation/distribution based on volume and price action
float adValue = ta.cum(close > open ? volume : close < open ? -volume : 0)
float adEma = ta.ema(adValue, 50)
float adSignal = ta.ema(adEma, 20)

// Plot accumulation/distribution as background gradient
float adRatio = showAccumDist ? math.min(10, math.max(-10, (adValue - adEma) / ta.stdev(adValue - adEma, 100))) : 0
color adColor = adRatio > 0 ? color.new(PFD_BULL_NEON, 95 - math.abs(adRatio) * 3) : color.new(PFD_BEAR_NEON, 95 - math.abs(adRatio) * 3)

// ─────────────────────────────────────────────────────────────────────────────
// TREND VISUALIZATION
// ─────────────────────────────────────────────────────────────────────────────
color trendColor = trendDirection > 0 ? PFD_BULL_NEON : trendDirection < 0 ? PFD_BEAR_NEON : PFD_NEON_CYAN
barcolor(color.new(trendColor, 70))

// Gradient background
color bgColor = na
if showGradientBG
    float gradientIntensity = math.abs(trendDirection) / 1.0
    bgColor := trendDirection > 0 ? color.new(PFD_BULL_NEON, 95) : trendDirection < 0 ? color.new(PFD_BEAR_NEON, 95) : color.new(PFD_NEON_CYAN, 98)

// Apply backgrounds - blend A/D with gradient if both enabled
color finalBg = na
if showAccumDist and showGradientBG
    // Blend both backgrounds
    finalBg := adRatio != 0 ? adColor : bgColor
else if showAccumDist
    finalBg := adRatio != 0 ? adColor : na
else if showGradientBG
    finalBg := bgColor

bgcolor(finalBg)

// Plot A/D line as separate indicator (only if enabled)
plot(showAccumDist and showAccumDistLine ? adEma : na, "A/D EMA", PFD_NEON_CYAN, 1)
plot(showAccumDist and showAccumDistLine ? adSignal : na, "A/D Signal", color.new(PFD_NEON_CYAN, 50), 1)

// ─────────────────────────────────────────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────────────────────────────────────────
if showDashboard
    // Calculate trend strength outside of conditional scope
    float trendStrength = math.abs(ta.change(close, 20) / close)

    if barstate.islast
        var table dashboard = table.new(
            dashPosition == "Top Right" ? position.top_right : 
            dashPosition == "Top Left" ? position.top_left : 
            dashPosition == "Bottom Right" ? position.bottom_right : position.bottom_left, 
            3, 9, 
            bgcolor=color.new(#0a0a0f, 5), 
            border_color=color.new(PFD_NEON_CYAN, 50),
            border_width=1,
            frame_width=1,
            frame_color=color.new(PFD_NEON_CYAN, 30))
        
        string trendText = trendDirection > 0 ? "BULLISH" : trendDirection < 0 ? "BEARISH" : "NEUTRAL"
        color trendCol = trendDirection > 0 ? PFD_BULL_NEON : trendDirection < 0 ? PFD_BEAR_NEON : PFD_NEON_CYAN
        
        int activeFVG = 0
        int strongFVG = 0
        int pivotHighCount = array.size(pivotHighs)
        int pivotLowCount = array.size(pivotLows)
        for fvg in fvgZones
            if not fvg.isMitigated
                activeFVG += 1
                if fvg.size > cachedAtr * 0.5
                    strongFVG += 1
        
        // Header - gradient themed header row
        table.cell(dashboard, 0, 0, "PHANTOM FLOW DECODER", text_color=color.white, text_size=size.normal, bgcolor=color.new(PFD_NEON_CYAN, 15))
        table.cell(dashboard, 1, 0, "", bgcolor=color.new(PFD_NEON_CYAN, 15))
        table.cell(dashboard, 2, 0, "", bgcolor=color.new(PFD_NEON_CYAN, 15))
        
        // Trend row
        table.cell(dashboard, 0, 1, "  TREND  ", text_color=PFD_NEON_CYAN, text_size=size.normal, bgcolor=color.new(#0a0a0f, 5))
        table.cell(dashboard, 1, 1, "  " + trendText + "  ", text_color=color.white, text_size=size.normal, bgcolor=color.new(trendCol, 60))
        table.cell(dashboard, 2, 1, "  " + str.tostring(math.round(trendStrength * 100)) + "%  ", text_color=trendCol, text_size=size.normal, bgcolor=color.new(#0a0a0f, 5))
        
        // FVG Count
        color fvgCountColor = activeFVG > 0 ? PFD_BULL_GLOW : PFD_NEUTRAL
        table.cell(dashboard, 0, 2, "  FVG ZONES  ", text_color=PFD_NEON_CYAN, text_size=size.normal, bgcolor=color.new(#0a0a0f, 5))
        table.cell(dashboard, 1, 2, "  " + str.tostring(activeFVG) + " active  ", text_color=fvgCountColor, text_size=size.normal, bgcolor=color.new(#0a0a0f, 5))
        table.cell(dashboard, 2, 2, "  " + str.tostring(strongFVG) + " strong  ", text_color=PFD_BULL_NEON, text_size=size.normal, bgcolor=color.new(#0a0a0f, 5))
        
        // Liquidity
        int activeLiq = 0
        int sweptLiq = 0
        for pool in liqPools
            if not pool.isSwept
                activeLiq += 1
            else
                sweptLiq += 1
        color liqColor = activeLiq > 0 ? PFD_BULL_GLOW : PFD_NEUTRAL
        table.cell(dashboard, 0, 3, "  LIQUIDITY  ", text_color=PFD_NEON_CYAN, text_size=size.normal, bgcolor=color.new(#0a0a0f, 5))
        table.cell(dashboard, 1, 3, "  " + str.tostring(activeLiq) + " active  ", text_color=liqColor, text_size=size.normal, bgcolor=color.new(#0a0a0f, 5))
        table.cell(dashboard, 2, 3, "  " + str.tostring(sweptLiq) + " swept  ", text_color=PFD_LIQ_SWEPT, text_size=size.normal, bgcolor=color.new(#0a0a0f, 5))
        
        // Order Blocks
        int activeOB = 0
        int mitigatedOB = 0
        for ob in orderBlocks
            if not ob.isMitigated
                activeOB += 1
            else
                mitigatedOB += 1
        color obColor = activeOB > 0 ? PFD_BULL_GLOW : PFD_NEUTRAL
        table.cell(dashboard, 0, 4, "  ORDER BLOCKS  ", text_color=PFD_NEON_CYAN, text_size=size.normal, bgcolor=color.new(#0a0a0f, 5))
        table.cell(dashboard, 1, 4, "  " + str.tostring(activeOB) + " active  ", text_color=obColor, text_size=size.normal, bgcolor=color.new(#0a0a0f, 5))
        table.cell(dashboard, 2, 4, "  " + str.tostring(mitigatedOB) + " mitig.  ", text_color=PFD_NEUTRAL, text_size=size.normal, bgcolor=color.new(#0a0a0f, 5))
        
        // Structure Count - BOS/CHoCH with gradient colors
        table.cell(dashboard, 0, 5, "  STRUCTURE  ", text_color=PFD_NEON_CYAN, text_size=size.normal, bgcolor=color.new(#0a0a0f, 5))
        table.cell(dashboard, 1, 5, "  BOS: " + str.tostring(bosCount) + "  ", text_color=PFD_BOS_BULL, text_size=size.normal, bgcolor=color.new(PFD_BOS_BULL, 80))
        table.cell(dashboard, 2, 5, "  CHoCH: " + str.tostring(chochCount) + "  ", text_color=PFD_CHOCH_BULL, text_size=size.normal, bgcolor=color.new(PFD_CHOCH_BULL, 80))
        
        // Sweeps & Traps - highlighted row
        table.cell(dashboard, 0, 6, "  EVENTS  ", text_color=PFD_NEON_CYAN, text_size=size.normal, bgcolor=color.new(#0a0a0f, 5))
        table.cell(dashboard, 1, 6, "  Sweeps: " + str.tostring(sweepCount) + "  ", text_color=PFD_LIQ_SWEPT, text_size=size.normal, bgcolor=color.new(PFD_LIQ_SWEPT, 80))
        table.cell(dashboard, 2, 6, "  Traps: " + str.tostring(trapCount) + "  ", text_color=PFD_LIQ_TRAP, text_size=size.normal, bgcolor=color.new(PFD_LIQ_TRAP, 80))
        
        // Zone Status
        string zoneStatus = ""
        color zoneColor = PFD_NEON_CYAN
        if showPremDisc
            if close > pdZone.premiumBot
                zoneStatus := "PREMIUM"
                zoneColor := PFD_BEAR_NEON
            else if close < pdZone.discountTop
                zoneStatus := "DISCOUNT"
                zoneColor := PFD_BULL_NEON
            else
                zoneStatus := "EQUILIBRIUM"
                zoneColor := PFD_EQUILIBRIUM
        
        table.cell(dashboard, 0, 7, "  ZONE  ", text_color=PFD_NEON_CYAN, text_size=size.normal, bgcolor=color.new(#0a0a0f, 5))
        table.cell(dashboard, 1, 7, "  " + zoneStatus + "  ", text_color=color.white, text_size=size.normal, bgcolor=color.new(zoneColor, 60))
        table.cell(dashboard, 2, 7, volumeWeighted ? "  VOL-ON  " : "  VOL-OFF  ", text_color=volumeWeighted ? PFD_BULL_NEON : PFD_NEUTRAL, text_size=size.normal, bgcolor=color.new(#0a0a0f, 5))
        
        // Pivots row
        table.cell(dashboard, 0, 8, "  PIVOTS  ", text_color=PFD_NEON_CYAN, text_size=size.normal, bgcolor=color.new(#0a0a0f, 5))
        table.cell(dashboard, 1, 8, "  H: " + str.tostring(pivotHighCount) + "  ", text_color=PFD_BULL_NEON, text_size=size.normal, bgcolor=color.new(#0a0a0f, 5))
        table.cell(dashboard, 2, 8, "  L: " + str.tostring(pivotLowCount) + "  ", text_color=PFD_BEAR_NEON, text_size=size.normal, bgcolor=color.new(#0a0a0f, 5))

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(trendDirection == 1 and trendDirection[1] != 1, "Bullish BOS", "Bullish Break of Structure detected")
alertcondition(trendDirection == -1 and trendDirection[1] != -1, "Bearish BOS", "Bearish Break of Structure detected")
alertcondition(chochCount > chochCount[1], "CHoCH Detected", "Change of Character detected")
alertcondition(sweepCount > sweepCount[1], "Liquidity Sweep", "Liquidity sweep detected")
alertcondition(trapCount > trapCount[1], "Smart Money Trap", "Smart money trap detected")
alertcondition(close > pdZone.premiumBot and close[1] <= (pdZone[1]).premiumBot, "Entered Premium", "Price entered premium zone")
alertcondition(close < pdZone.discountTop and close[1] >= (pdZone[1]).discountTop, "Entered Discount", "Price entered discount zone")
