//@version=6
indicator(
    "Renko Structure Trend - Labels Split",
    overlay = true,
    max_labels_count = 500
)

// Trend state
var int   trend      = 0      // 1 = BUY, -1 = SELL
var float entryPrice = na
var float entrySL    = na
var int   entryTime  = na
var label entryLabel = na

// Candle color
isGreen = close > open
isRed   = close < open

// Entry signals (2-brick reversal)
twoGreen = isGreen and isGreen[1]
twoRed   = isRed   and isRed[1]

// Fire once at the moment a new 2-candle opposite sequence appears.
buySetup  = twoGreen and not twoGreen[1]
sellSetup = twoRed   and not twoRed[1]

buySignal  = trend != 1  and buySetup
sellSignal = trend != -1 and sellSetup
buyAllowed  = true
sellAllowed = true

// Structural SL (display only)
buySL  = ta.valuewhen(isRed, low, 1)
sellSL = ta.valuewhen(isGreen, high, 1)

// Renko geometry
brickSize = math.max(high - low, syminfo.mintick)

// Dynamic padding
labelPadEntry = brickSize * 2.5
labelPadExit  = brickSize * 5.5
labelPadSkip  = brickSize * 7.0

buyColor    = color.purple
sellColor   = color.yellow
profitColor = color.green
lossColor   = color.red
skipColor   = color.new(color.gray, 80)

formatHeldTime(_ms) =>
    totalMinutes = math.max(1, int(_ms / 60000))
    totalHours   = int(_ms / 3600000)
    totalDays    = int(_ms / 86400000)
    totalDays >= 1 ? str.tostring(totalDays) + "d" : totalHours >= 1 ? str.tostring(totalHours) + "h" : str.tostring(totalMinutes) + "m"

// BUY SIGNAL (exit SELL -> enter BUY)
if buySignal
    skipShown = false

    // EXIT SELL
    if trend == -1 and not na(entryPrice)
        profit   = entryPrice - close
        heldText = formatHeldTime(time - entryTime)
        risk     = math.abs(entryPrice - entrySL)
        rr       = risk > 0 ? profit / risk : 0.0
        winTag   = profit >= 0 ? "WIN" : "LOSS"

        // Always show exit label.
        label.new(
            bar_index,
            low - labelPadExit,
            "EXIT SELL" +
            "\nExit: " + str.tostring(close) +
            "\nProfit: " + str.tostring(profit) + " pts" +
            "\nHeld: " + heldText,
            yloc = yloc.price,
            style = label.style_label_up,
            color = profit >= 0 ? profitColor : lossColor,
            textcolor = color.white
        )

        // If entry is filtered, also show skipped bubble.
        if not buyAllowed
            label.new(
                bar_index,
                low - labelPadSkip,
                "SKIPPED BUY",
                yloc = yloc.price,
                style = label.style_label_up,
                color = skipColor,
                textcolor = color.white
            )
            skipShown := true

        // EXIT SELL ALERT
        exitSellMsg = (
            "EXIT SELL (" + winTag + ")\n" +
            "Symbol: " + syminfo.ticker + "\n" +
            "Exit: " + str.tostring(close) + "\n" +
            "Profit: " + str.tostring(profit) + " pts\n" +
            "RR: " + str.tostring(rr, "#.##") + "\n" +
            "Held: " + heldText
        )
        if buyAllowed
            alert(exitSellMsg, alert.freq_once_per_bar_close)

    // ENTER BUY label
    if buyAllowed
        trend      := 1
        entryPrice := close
        entryTime  := time
        entrySL    := buySL

        entryLabel := label.new(
            bar_index,
            low - labelPadEntry,
            "BUY" +
            "\nEntry: " + str.tostring(close) +
            "\nSL: " + str.tostring(buySL),
            yloc = yloc.price,
            style = label.style_label_up,
            color = buyColor,
            textcolor = color.white
        )

        // BUY ENTRY ALERT
        buyMsg = (
            "BUY SIGNAL\n" +
            "Symbol: " + syminfo.ticker + "\n" +
            "Entry: " + str.tostring(close) + "\n" +
            "SL: " + str.tostring(buySL) + "\n" +
            "Time: " + str.tostring(time, "yyyy-MM-dd HH:mm")
        )
        alert(buyMsg, alert.freq_once_per_bar_close)
    else
        trend      := 0
        entryPrice := na
        entryTime  := na
        entrySL    := na
        if not skipShown
            label.new(
                bar_index,
                low - labelPadSkip,
                "SKIPPED BUY",
                yloc = yloc.price,
                style = label.style_label_up,
                color = skipColor,
                textcolor = color.white
            )

// SELL SIGNAL (exit BUY -> enter SELL)
if sellSignal
    skipShown = false

    // EXIT BUY
    if trend == 1 and not na(entryPrice)
        profit   = close - entryPrice
        heldText = formatHeldTime(time - entryTime)
        risk     = math.abs(entrySL - entryPrice)
        rr       = risk > 0 ? profit / risk : 0.0
        winTag   = profit >= 0 ? "WIN" : "LOSS"

        // Always show exit label.
        label.new(
            bar_index,
            high + labelPadExit,
            "EXIT BUY" +
            "\nExit: " + str.tostring(close) +
            "\nProfit: " + str.tostring(profit) + " pts" +
            "\nHeld: " + heldText,
            yloc = yloc.price,
            style = label.style_label_down,
            color = profit >= 0 ? profitColor : lossColor,
            textcolor = color.white
        )

        // If entry is filtered, also show skipped bubble.
        if not sellAllowed
            label.new(
                bar_index,
                high + labelPadSkip,
                "SKIPPED SELL",
                yloc = yloc.price,
                style = label.style_label_down,
                color = skipColor,
                textcolor = color.white
            )
            skipShown := true

        // EXIT BUY ALERT
        exitBuyMsg = (
            "EXIT BUY (" + winTag + ")\n" +
            "Symbol: " + syminfo.ticker + "\n" +
            "Exit: " + str.tostring(close) + "\n" +
            "Profit: " + str.tostring(profit) + " pts\n" +
            "RR: " + str.tostring(rr, "#.##") + "\n" +
            "Held: " + heldText
        )
        if sellAllowed
            alert(exitBuyMsg, alert.freq_once_per_bar_close)

    // ENTER SELL label
    if sellAllowed
        trend      := -1
        entryPrice := close
        entryTime  := time
        entrySL    := sellSL

        entryLabel := label.new(
            bar_index,
            high + labelPadEntry,
            "SELL" +
            "\nEntry: " + str.tostring(close) +
            "\nSL: " + str.tostring(sellSL),
            yloc = yloc.price,
            style = label.style_label_down,
            color = sellColor,
            textcolor = color.black
        )

        // SELL ENTRY ALERT
        sellMsg = (
            "SELL SIGNAL\n" +
            "Symbol: " + syminfo.ticker + "\n" +
            "Entry: " + str.tostring(close) + "\n" +
            "SL: " + str.tostring(sellSL) + "\n" +
            "Time: " + str.tostring(time, "yyyy-MM-dd HH:mm")
        )
        alert(sellMsg, alert.freq_once_per_bar_close)
    else
        trend      := 0
        entryPrice := na
        entryTime  := na
        entrySL    := na
        if not skipShown
            label.new(
                bar_index,
                high + labelPadSkip,
                "SKIPPED SELL",
                yloc = yloc.price,
                style = label.style_label_down,
                color = skipColor,
                textcolor = color.white
            )
