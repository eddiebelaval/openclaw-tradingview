//@version=5
indicator("Dow Triple Moving Average", overlay=true)

// Períodos das médias
periodo1 = 32
periodo2 = 154
periodo3 = 495

// Cálculo das Médias Móveis Aritméticas (SMA)
sma32  = ta.sma(close, periodo1)
sma154 = ta.sma(close, periodo2)
sma495 = ta.sma(close, periodo3)

// Plotagem das médias no gráfico
plot(sma32,  title="SMA 32",  color=color.blue,  linewidth=2)
plot(sma154, title="SMA 154", color=color.orange, linewidth=2)
plot(sma495, title="SMA 495", color=color.red, linewidth=3)
