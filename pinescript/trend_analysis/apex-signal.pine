//@version=6
indicator("Apex Signal", overlay = true)

// --- Moving Average Calculation ---
ma_calc(source, length, MAtype) =>
    switch MAtype
        "SMA"        => ta.sma(source,  length) 
        "EMA"        => ta.ema(source,  length) 
        "SMMA (RMA)" => ta.rma(source,  length) 
        "WMA"        => ta.wma(source,  length) 
        "VWMA"       => ta.vwma(source, length) 
        => na

// --- Inputs ---
tf_input     = input.timeframe("60", "Indicator Timeframe")
ma1_len      = input.int(100, "MA 1 Length")
ma2_len      = input.int(200, "MA 2 Length")
ma_type      = input.string("SMA", "MA Type", options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"])
line_ext     = input.int(10, "Line Extension (Bars)", minval = 1)
swing_lookback = input.int(30, "Swing Lookback (Bars)", minval = 5)
pip_buffer   = input.int(10, "Pip Buffer", minval = 0)

// Calculate Pip Value
pip_value = syminfo.mintick * 10

// --- Security Call ---
[ma1, ma2] = request.security(syminfo.tickerid, tf_input, [ma_calc(close, ma1_len, ma_type), ma_calc(close, ma2_len, ma_type)])

plot(ma1, "MA 1", color.new(color.orange, 0), 2)
plot(ma2, "MA 2", color.new(color.red, 0), 2)

// --- Swing Detection ---
// We find the lowest low / highest high in the lookback period
last_swing_low  = ta.lowest(low, swing_lookback)
last_swing_high = ta.highest(high, swing_lookback)

// --- Trade Logic ---
longCondition  = ta.crossover(ma1, ma2)
shortCondition = ta.crossunder(ma1, ma2)

// --- Visual Position Replication ---
if longCondition
    float entryPrice = close
    // SL: Last swing low minus 10 pips
    float slPrice = last_swing_low - (pip_buffer * pip_value)
    float risk = math.abs(entryPrice - slPrice)
    float tpPrice = entryPrice + (risk * 3)
    
    line.new(bar_index, entryPrice, bar_index + line_ext, entryPrice, color=color.gray, width=1, style=line.style_dashed)
    line.new(bar_index, tpPrice, bar_index + line_ext, tpPrice, color=color.green, width=3)
    line.new(bar_index, slPrice, bar_index + line_ext, slPrice, color=color.red, width=3)
    
    label.new(bar_index + line_ext, tpPrice, "TP: " + str.tostring(tpPrice, "#.####"), color=color.green, textcolor=color.white, style=label.style_label_left)
    label.new(bar_index + line_ext, slPrice, "SL: " + str.tostring(slPrice, "#.####"), color=color.red, textcolor=color.white, style=label.style_label_left)

if shortCondition
    float entryPrice = close
    // SL: Last swing high plus 10 pips
    float slPrice = last_swing_high + (pip_buffer * pip_value)
    float risk = math.abs(entryPrice - slPrice)
    float tpPrice = entryPrice - (risk * 3)
    
    line.new(bar_index, entryPrice, bar_index + line_ext, entryPrice, color=color.gray, width=1, style=line.style_dashed)
    line.new(bar_index, tpPrice, bar_index + line_ext, tpPrice, color=color.green, width=3)
    line.new(bar_index, slPrice, bar_index + line_ext, slPrice, color=color.red, width=3)

    label.new(bar_index + line_ext, tpPrice, "TP: " + str.tostring(tpPrice, "#.####"), color=color.green, textcolor=color.white, style=label.style_label_left)
    label.new(bar_index + line_ext, slPrice, "SL: " + str.tostring(slPrice, "#.####"), color=color.red, textcolor=color.white, style=label.style_label_left)

// --- Shapes and Alerts ---
plotshape(longCondition,  "Long",  shape.triangleup,   location.belowbar, color.green, size=size.small, text="LONG")
plotshape(shortCondition, "Short", shape.triangledown, location.abovebar, color.red,   size=size.small, text="SHORT")
