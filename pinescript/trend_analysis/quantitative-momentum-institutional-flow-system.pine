//@version=5
// @description 该系统融合了市场广量情绪、机构资金流向以及动能衰竭模型。
// @description 通过对比标的物与参考基准（大盘）的资金共振，识别趋势的底部积蓄与顶部过热状态。
// @description 核心逻辑：基于加权价格偏差的二阶平滑算法，提取纯净的资金流入/流出特征。
indicator("Quantitative Momentum & Institutional Flow System", shorttitle="QuantFlow_MSVO", overlay=false, precision=2)

// ==========================================
// 1.   全局配置与基准引用 (Benchmark Configuration)
// ==========================================
grp_index    = "基准配置 (Benchmark)"
ref_symbol   = input.symbol("SSE:000001", "参考指数 (如上证指数)", group=grp_index)
ref_close    = request.security(ref_symbol, timeframe.period, close)
ref_high     = request.security(ref_symbol, timeframe.period, high)
ref_low      = request.security(ref_symbol, timeframe.period, low)

// ==========================================
// 2. 机构资金流向引擎 (Institutional Flow Engine)
// ==========================================
// 基于加权中轴价格的动能差值计算
capital_basis = (close * 2 + high + low) / 4 * 10
fast_capital_ema = ta.ema(capital_basis, 13)
slow_capital_ema = ta.ema(capital_basis, 34)
capital_diff = fast_capital_ema - slow_capital_ema
capital_signal = ta.ema(capital_diff, 5)

// 提取机构净流量 (Institutional Net Flow)
net_flow_hist = 2 * (capital_diff - capital_signal) * 5.5
inst_flow_in  = net_flow_hist >= 0 ? net_flow_hist : 0
inst_flow_out = net_flow_hist <= 0 ? net_flow_hist : 0

// ==========================================
// 3. 市场情绪与广量动能 (Market Sentiment Dynamics)
// ==========================================
// 计算基准指数的超买超卖状态 (Stochastic-based)
ref_stoch_range = ta.highest(ref_high, 8) - ta.lowest(ref_low, 8)
ref_stoch_raw   = (ta.highest(ref_high, 8) - ref_close) / math.max(ref_stoch_range, 0.001) * 8
sentiment_osc   = ta.ema(3 * ref_stoch_raw - 2 * ta.sma(ref_stoch_raw, 18), 5)

// 基准指数的资金波动逻辑
ref_basis_ema = (ref_close * 2 + ref_high + ref_low) / 4
ref_flow_diff = ta.ema(ref_basis_ema, 13) - ta.ema(ref_basis_ema, 34)
ref_flow_signal = ta.ema(ref_flow_diff, 3)
ref_net_flow = (ref_flow_diff - ref_flow_signal) / 2

market_sentiment_in  = ref_net_flow >= 0 ? ref_net_flow : 0
market_sentiment_out = ref_net_flow <= 0 ? ref_net_flow : 0

// ==========================================
// 4. 趋势收敛矩阵 (Trend Convergence Matrix)
// ==========================================
trend_raw = (close - ta.lowest(low, 55)) / math.max(ta.highest(high, 55) - ta.lowest(low, 55), 0.001) * 100
trend_smoothed = 3 * ta.sma(trend_raw, 5) - 2 * ta.sma(ta.sma(trend_raw, 5), 3)
trend_main = ta.ema(trend_smoothed, 3)

// 动能加速度 (Momentum Acceleration)
mom_accel = (trend_main - trend_main[1]) / math.max(trend_main[1], 0.001) * 100

// ==========================================
// 5. 视觉渲染系统 (Visual Presentation)
// ==========================================
// 5.1 核心动能线
plot(inst_flow_out, "机构撤离", color=color.new(#0000ff, 0), linewidth=2)
plot(inst_flow_in,  "机构入场", color=color.new(#ff00ff, 0), linewidth=2)
plot(market_sentiment_in,  "基准动能正向", color=color.new(color.red, 0), linewidth=1)
plot(market_sentiment_out, "基准动能负向", color=color.new(color.green, 0), linewidth=1)
plot(trend_main, "主趋势线", color=color.new(#ffa500, 0), linewidth=2)

// 5.2 状态脉冲柱 (Status Pulse Histograms)
// 筑底阶段 (Bottom Accumulation)
is_accumulating = trend_main <= 13
plot(is_accumulating ? 20 : na, "蓄势脉冲", color=color.new(#cc9900, 40), style=plot.style_columns)

// 爆发阶段 (Breakout Initiation)
is_breaking_out = trend_main <= 13 and mom_accel > 13
plot(is_breaking_out ? 50 : na, "爆发确认", color=color.new(#0099ff, 30), style=plot.style_columns)

// 极度超买 (Extreme Exhaustion)
is_exhausted = trend_main > 90 and trend_main > trend_main[1]
plot(is_exhausted ? 100 : na, "抛压警戒", color=color.new(color.red, 20), style=plot.style_columns, histbase=95)

// 5.3 资金共振增强 (Resonance Indicators)
plot(market_sentiment_in > 0 and trend_main < 13 ? 30 : na, "基准低位共振", color=color.new(color.red, 50), style=plot.style_columns)
plot(inst_flow_in > 0 and trend_main < 13 ? 40 : na, "机构低位共振", color=color.new(#ff00ff, 50), style=plot.style_columns)

// ==========================================
// 6. 信号提示与警报 (Signals & Alerts)
// ==========================================
f_is_new_event(cond) => cond and not cond[1]

if f_is_new_event(is_accumulating)
    label.new(bar_index, 30, "筑底区域", color=color.new(color.white, 100), textcolor=#cc9900, style=label.style_label_up, size=size.small)

if f_is_new_event(is_breaking_out)
    label.new(bar_index, 60, "买入确认", color=color.new(color.white, 100), textcolor=#0099ff, style=label.style_label_up, size=size.small)

// 顶部背离/逃顶逻辑
top_risk = trend_main > 90 and trend_main < trend_main[1] and inst_flow_in < inst_flow_in[1]
if f_is_new_event(top_risk)
    label.new(bar_index, 90, "趋势衰减", color=color.new(color.yellow, 0), textcolor=color.black, style=label.style_label_down, size=size.small)

// 参考阈值线
hline(0,   "平衡轴", color=color.new(color.gray, 50), linestyle=hline.style_dotted)
hline(13,  "吸筹阈值", color=color.new(color.gray, 50), linestyle=hline.style_dotted)
hline(90,  "超买阈值", color=color.new(color.gray, 50), linestyle=hline.style_dotted)
