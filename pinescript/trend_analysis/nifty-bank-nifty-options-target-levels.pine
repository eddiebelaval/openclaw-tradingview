// ────────────────────────────────────────────────
// Draw boxes
// ────────────────────────────────────────────────
drawZone(_en,_hi,_lo)=>
    if masterShow and _en
        top=math.max(_hi,_lo)
        bot=math.min(_hi,_lo)
        col=close>top?color.new(color.rgb(0, 230, 119, 41),fillAlphaAbove):close<bot?color.new(color.rgb(255, 82, 82, 40),fillAlphaBelow):na
        bord=showBorders?color.new(color.gray,borderAlpha):na
        box.new(time-timeOffset,top,time+timeOffset,bot,
            xloc=xloc.bar_time,bgcolor=col,border_color=bord,border_width=borderWidth)

if barstate.islastconfirmedhistory or barstate.isrealtime
    drawZone(en1,hi1,lo1), drawZone(en2,hi2,lo2), drawZone(en3,hi3,lo3), drawZone(en4,hi4,lo4)
    drawZone(en5,hi5,lo5), drawZone(en6,hi6,lo6), drawZone(en7,hi7,lo7), drawZone(en8,hi8,lo8)
    drawZone(en9,hi9,lo9), drawZone(en10,hi10,lo10), drawZone(en11,hi11,lo11), drawZone(en12,hi12,lo12)
    drawZone(en13,hi13,lo13), drawZone(en14,hi14,lo14), drawZone(en15,hi15,lo15), drawZone(en16,hi16,lo16)
    drawZone(en17,hi17,lo17), drawZone(en18,hi18,lo18), drawZone(en19,hi19,lo19), drawZone(en20,hi20,lo20)
    drawZone(en21,hi21,lo21), drawZone(en22,hi22,lo22), drawZone(en23,hi23,lo23), drawZone(en24,hi24,lo24)
    drawZone(en25,hi25,lo25), drawZone(en26,hi26,lo26), drawZone(en27,hi27,lo27), drawZone(en28,hi28,lo28)
    drawZone(en29,hi29,lo29), drawZone(en30,hi30,lo30)
