//@version=6
indicator("Nifty Options Targets", overlay = true, max_boxes_count = 500)

// ────────────────────────────────────────────────
// Display Settings
// ────────────────────────────────────────────────
groupDisp        = "Display Settings"
masterShow       = input.bool(true,  "Show All Zones", group = groupDisp)
showBorders      = input.bool(true,  "Show Borders", group = groupDisp)
borderWidth      = input.int(1,      "Border Width", minval = 0, maxval = 4, group = groupDisp)
borderAlpha      = input.int(80,     "Border Transparency", minval = 50, maxval = 85, group = groupDisp)
fillAlphaAbove   = input.int(85,     "Fill Transparency (Above / Green)", minval = 50, maxval = 85, group = groupDisp)
fillAlphaBelow   = input.int(85,     "Fill Transparency (Below / Red)", minval = 50, maxval = 85, group = groupDisp)

// Time offset ≈ 3 years
timeOffset = 3 * 365 * 24 * 60 * 60 * 1000

// ────────────────────────────────────────────────
// Zone Inputs (±150 applied externally)
