//@version=6
indicator("xATR Distance Meter — Label", overlay=true)

//==================== Inputs ====================
atrTFMode = input.string("Chart", "ATR Timeframe",
     options=["Chart","1H","4H","Daily"])

atrLen = input.int(14, "ATR Length", minval=1)

startPrice = input.float(0.0, "Start Price (0 disables)")
endPrice = input.float(0.0, "End Price (0 disables)")

//==================== ATR ====================
string atrTF =
     atrTFMode == "Chart" ? timeframe.period :
     atrTFMode == "1H" ? "60" :
     atrTFMode == "4H" ? "240" : "D"

atrVal = request.security(
     syminfo.tickerid,
     atrTF,
     ta.atr(atrLen),
     barmerge.gaps_off,
     barmerge.lookahead_off)

//==================== Calculations ====================
valid = startPrice != 0.0 and endPrice != 0.0

distPts = valid ? math.abs(endPrice - startPrice) : na
xATR = (valid and atrVal != 0 and not na(atrVal)) ? distPts / atrVal : na

direction =
     valid ?
     (endPrice > startPrice ? "UP ↑" :
      endPrice < startPrice ? "DOWN ↓" : "FLAT")
     : "OFF"

//==================== Label Text ====================
f_fmt(x) => na(x) ? "na" : str.tostring(x, "#.##")

txt =
     "xATR Distance\n" +
     "Dir: " + direction + "\n" +
     "Move: " + f_fmt(distPts) + " pts\n" +
     "ATR: " + f_fmt(atrVal) + "\n" +
     "Total: " + f_fmt(xATR) + " xATR"

//==================== Persistent Label ====================
var label info = label.new(
     bar_index,
     low,
     "",
     xloc=xloc.bar_index,
     yloc=yloc.price,
     style=label.style_label_left,
     size=size.small,
     textcolor=color.white,
     color=color.new(color.black, 0))

// keep label anchored bottom-left visually
if barstate.islast
    label.set_x(info, bar_index - 50)
    label.set_y(info, ta.lowest(low, 50))
    label.set_text(info, txt)
