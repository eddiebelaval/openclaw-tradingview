//@version=6
// Vortex Volatility Engine - A volatility momentum indicator that measures
// directional market strength using True Range and price change components.
// It identifies volatility squeezes (consolidation periods) and breakout signals.
indicator("Vortex Volatility Engine [Pineify]", "VVE [Pineify]", overlay = false)

// =========================================================================
// SETTINGS - User-configurable parameters for the indicator
// =========================================================================
// length: Lookback period for calculating volatility and momentum components
//         Higher values = smoother but more lagged signals
// smooth: Smoothing period for the final delta histogram to reduce noise
//         Higher values = smoother histogram but slower signals
// squeezeMult: Threshold for detecting low volatility periods (squeeze)
//              Lower values = stricter squeeze detection (fewer squeeze signals)
// bandMult: Multiplier for dynamic volatility bands around the delta
//           Higher values = wider bands, fewer breakout signals
length      = input.int(14, "Volatility Length", minval=2, tooltip="Length for True Range and Directional Momentum calculations.")
smooth      = input.int(5, "Signal Smoothing", minval=1, tooltip="Smooths the histogram to prevent fakeouts.")
squeezeMult = input.float(0.8, "Squeeze Threshold", step=0.1, tooltip="Lower value = stricter squeeze detection.")
bandMult    = input.float(2.0, "Volatility Band Multiplier", step=0.1)

// =========================================================================
// COLORS - Neon aesthetic color scheme for visual clarity
// =========================================================================
// col_bull_strong: Bright green for strong bullish momentum (delta > 0 and increasing)
// col_bull_weak: Dark green for weak bullish momentum (delta > 0 but decreasing)
// col_bear_strong: Bright red for strong bearish momentum (delta < 0 and decreasing)
// col_bear_weak: Dark red for weak bearish momentum (delta < 0 but increasing)
// col_squeeze: Semi-transparent gray for squeeze indicator dots
// col_bands: Semi-transparent gray for volatility band lines
col_bull_strong = #00E676 // Bright Neon Green
col_bull_weak   = #1B5E20 // Dark Green
col_bear_strong = #FF1744 // Bright Neon Red
col_bear_weak   = #b71c1c // Dark Red
col_squeeze     = color.new(color.gray, 30)
col_bands       = color.new(#787b86, 70)

// =========================================================================
// CALCULATIONS - Core volatility and momentum computations
// =========================================================================
// The indicator calculates directional volatility momentum using True Range
// as the baseline, then decomposes it into bullish and bearish components.

// 1. Calculate Smoothed True Range (TR)
// RMA (Running Moving Average) provides smooth average of True Range over the length period
// True Range = max of: High-Low, |High-PrevClose|, |Low-PrevClose|
tr_smooth = ta.rma(ta.tr, length)

// 2. Calculate Directional Volatility (Up and Down components)
// Separate positive price changes (up_move) from negative changes (dn_move)
// Then smooth each using RMA to get directional volatility strength
up_move = math.max(ta.change(close), 0)  // Only positive price changes
dn_move = math.max(-ta.change(close), 0) // Only negative price changes (converted to positive)

up_vol = ta.rma(up_move, length)  // Average upward volatility
dn_vol = ta.rma(dn_move, length) // Average downward volatility

// 3. Normalize Volatility into Power (0 to 100 scale based on TR)
// Expresses directional volatility as a percentage of total range
// Values above 50 indicate bullish dominance, below 50 indicates bearish
bull_power = (up_vol / tr_smooth) * 100
bear_power = (dn_vol / tr_smooth) * 100

// 4. The Vortex Delta (Bull Power - Bear Power)
// Positive = bullish volatility dominance, Negative = bearish
// Applied additional SMA smoothing to reduce noise
vortex_delta = ta.sma(bull_power - bear_power, smooth)

// 5. Squeeze Detection (Comparing short-term TR to long-term TR)
// Squeeze = short-term volatility is significantly lower than long-term
// This often precedes explosive moves (either direction)
long_tr = ta.sma(ta.tr, length * 3)  // Long-term TR baseline
is_squeeze = ta.sma(ta.tr, length) < (long_tr * squeezeMult)  // Short-term compression

// 6. Dynamic Volatility Bands (Standard Deviation of the Delta)
// Creates upper and lower bounds based on historical delta volatility
// Used to identify when delta "breaks out" of normal ranges
vortex_stdev = ta.stdev(vortex_delta, length * 2)  // Standard deviation of delta
vortex_basis = ta.sma(vortex_delta, length * 2)     // Center line (moving average)
upper_band   = vortex_basis + (vortex_stdev * bandMult)  // Upper volatility bound
lower_band   = vortex_basis - (vortex_stdev * bandMult)  // Lower volatility bound

// =========================================================================
// VISUALS & PLOTTING - Rendering the indicator on the chart
// =========================================================================
// The histogram displays the Vortex Delta, colored based on direction and momentum strength.
// Color logic: Bright colors indicate strengthening momentum, dim colors indicate weakening.

// Determine Histogram Color based on direction and momentum
// vortex_change > 0 means momentum is accelerating (stronger signal)
// vortex_change < 0 means momentum is decelerating (weaker signal)
vortex_change = ta.change(vortex_delta)

hist_col = vortex_delta > 0 ? 
             (vortex_change > 0 ? col_bull_strong : col_bull_weak) : 
             (vortex_change < 0 ? col_bear_strong : col_bear_weak)

// Plot Dynamic Bands - Visual reference for normal volatility range
// Dotted circular markers create a channel around the histogram
plot(upper_band, "Upper Volatility Band", color=col_bands, style=plot.style_circles, linewidth=1)
plot(lower_band, "Lower Volatility Band", color=col_bands, style=plot.style_circles, linewidth=1)

// Plot Vortex Histogram - Main indicator visualization
// Width 3 provides good visibility while showing fine detail
plot(vortex_delta, "Vortex Delta", color=hist_col, style=plot.style_histogram, linewidth=3)

// Plot Zero Line - Reference for bullish/bearish transition
hline(0, "Zero Line", color=color.new(color.gray, 50), linestyle=hline.style_dotted)

// Plot Squeeze Nodes (Grey Dots on Zero Line)
// Visual indicator for low volatility periods (potential setup for big moves)
// Only shows when is_squeeze is true, otherwise displays na (nothing)
plot(is_squeeze ? 0 : na, "Squeeze Nodes", color=col_squeeze, style=plot.style_circles, linewidth=4)

// =========================================================================
// BREAKOUT SIGNALS - Trading opportunities from volatility expansions
// =========================================================================
// Breakouts occur when delta moves outside the dynamic bands while NOT in a squeeze.
// This indicates strong volatility expansion that often leads to trending moves.
// The squeeze condition filters out false signals during consolidation periods.

// bull_break: Delta crosses above upper band (volatility expanding upward)
// is_squeeze check ensures we only trade breakouts, not random spikes
bull_break = ta.crossover(vortex_delta, upper_band) and not is_squeeze

// bear_break: Delta crosses below lower band (volatility expanding downward)
// is_squeeze check ensures we only trade breakouts, not random spikes
bear_break = ta.crossunder(vortex_delta, lower_band) and not is_squeeze

// Plot Breakout Flares - Visual markers for breakout signals
// Small circles at the delta value location when breakout occurs
plotshape(bull_break ? vortex_delta : na, "Bullish Volatility Breakout", shape.circle, location.absolute, color.new(col_bull_strong, 0), size=size.tiny)
plotshape(bear_break ? vortex_delta : na, "Bearish Volatility Breakout", shape.circle, location.absolute, color.new(col_bear_strong, 0), size=size.tiny)

// =========================================================================
// ALERTS - Automated notifications for key market conditions
// =========================================================================
// Alert conditions allow users to receive notifications without constantly watching the chart.

// Bullish breakout alert: Delta crosses above upper band during non-squeeze
alertcondition(bull_break, title="Bullish Vortex Breakout", message="Bullish Volatility Expansion Detected!")

// Bearish breakout alert: Delta crosses below lower band during non-squeeze
alertcondition(bear_break, title="Bearish Vortex Breakout", message="Bearish Volatility Expansion Detected!")

// Alert for squeeze start (transition from not squeezed to squeezed)
// This marks the beginning of a compression phase - potential setup for big move
squeeze_started = is_squeeze and not is_squeeze[1]
alertcondition(squeeze_started, title="Squeeze Started", message="Market volatility is compressing. Prepare for a breakout.")

// Alert for squeeze firing (transition from squeezed to not squeezed)
// This marks the release of compression - explosive move may be underway
squeeze_fired = not is_squeeze and is_squeeze[1]
alertcondition(squeeze_fired, title="Squeeze Fired", message="Squeeze has released! Watch for breakout direction.")
