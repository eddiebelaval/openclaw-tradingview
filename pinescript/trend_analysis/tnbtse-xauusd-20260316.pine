//@version=5
indicator("TNBT.se_XAUUSD Institutional Long Setup + Trend Lines + Channel", overlay=true, max_boxes_count=40, max_lines_count=80, max_labels_count=60)

//====================
// Inputs
//====================
entryLow      = input.float(4975.0, "Entry Zone Low", step=0.1)
entryHigh     = input.float(5000.0, "Entry Zone High", step=0.1)
stopLoss      = input.float(4950.0, "Stop Loss", step=0.1)
targetPrice   = input.float(5150.0, "Target Price", step=0.1)

rrBoxBars     = input.int(35, "Risk/Reward Box Width (bars)", minval=5, maxval=300)
projBars      = input.int(25, "Projection Length (bars)", minval=5, maxval=200)
thesisBars    = input.int(36, "Text Box Width (bars)", minval=10, maxval=150)
thesisOffset  = input.int(6, "Text Box Right Offset (bars)", minval=0, maxval=50)

showRRBox     = input.bool(true, "Show True Risk/Reward Box")
showEntryZone = input.bool(true, "Show Entry Zone")
showSLLine    = input.bool(true, "Show Stop Line")
showTPLine    = input.bool(true, "Show Target Line")
showPath      = input.bool(true, "Show Projection Path")
showLabels    = input.bool(true, "Show Price Labels")
showPanel     = input.bool(true, "Show Info Panel")
showThesis    = input.bool(true, "Show Thesis / Conclusion Box")
showTrend     = input.bool(true, "Show Trend Lines")
showChannel   = input.bool(true, "Show Channel")
showMidline   = input.bool(true, "Show Channel Midline")
latestOnly    = input.bool(true, "Draw Only Near Latest Bars")

//====================
// Trend line controls
//====================
supportBarsBack    = input.int(22, "Support Trend Start (bars back)", minval=5, maxval=300)
supportStartPrice  = input.float(4925.0, "Support Trend Start Price", step=0.1)
recoveryBarsBack   = input.int(18, "Recovery Trend Start (bars back)", minval=5, maxval=300)
recoveryStartPrice = input.float(5075.0, "Recovery Trend Start Price", step=0.1)
trendExtendRight   = input.int(25, "Trend Line Extend Right (bars)", minval=5, maxval=200)

//====================
// Channel controls
//====================
channelBarsBack       = input.int(30, "Channel Start (bars back)", minval=5, maxval=400)
channelSupportStart   = input.float(4915.0, "Channel Support Start Price", step=0.1)
channelSupportEnd     = input.float(5000.0, "Channel Support End Price", step=0.1)
channelHeight         = input.float(120.0, "Channel Height", step=0.1)
channelExtendRight    = input.int(35, "Channel Extend Right (bars)", minval=5, maxval=300)

//====================
// Thesis text
//====================
thesisTitle = input.string("LONG BIAS: Support Reversal", "Text Box Title")
thesisLine1 = input.string("Recommendation: Go LONG at current market price.", "Text Line 1")
thesisLine2 = input.string("Zone 4975-5000 is a high-probability reversal area.", "Text Line 2")
thesisLine3 = input.string("Confluence: S/R + Wyckoff + 78.6% Fib + Elliott C.", "Text Line 3")
thesisLine4 = input.string("Stop below 4950 to allow wick volatility.", "Text Line 4")
thesisLine5 = input.string("Primary target: 5150 swing-high recovery.", "Text Line 5")

//====================
// Core values
//====================
entryMid      = (entryLow + entryHigh) / 2.0
riskPoints    = entryMid - stopLoss
rewardPoints  = targetPrice - entryMid
rr            = riskPoints != 0 ? rewardPoints / riskPoints : na

//====================
// Colors
//====================
colEntryFill     = color.new(color.teal, 88)
colEntryBorder   = color.new(color.teal, 20)

colRiskFill      = color.new(color.red, 84)
colRiskBorder    = color.new(color.red, 20)

colRewardFill    = color.new(color.blue, 84)
colRewardBorder  = color.new(color.blue, 20)

colStop          = color.new(color.red, 0)
colTarget        = color.new(color.blue, 0)
colPath          = color.new(color.aqua, 10)

colSupportTrend  = color.new(color.teal, 0)
colRecoverTrend  = color.new(color.orange, 0)

colChannelLow    = color.new(color.lime, 0)
colChannelHigh   = color.new(color.fuchsia, 0)
colChannelMid    = color.new(color.silver, 20)
colChannelFill   = color.new(color.blue, 92)

colText          = color.white
colPanelHead     = color.new(color.black, 0)
colPanelRow      = color.new(color.gray, 82)

colThesisBg      = color.new(color.black, 18)
colThesisBorder  = color.new(color.silver, 55)

//====================
// Objects
//====================
var box entryBox    = na
var box riskBox     = na
var box rewardBox   = na
var box thesisBox   = na

var line slLine     = na
var line tpLine     = na
var line pathLine   = na
var line supportTL  = na
var line recoverTL  = na

var line chSupport  = na
var line chResist   = na
var line chMid      = na
var linefill chFill = na

var label lblEntry  = na
var label lblSL     = na
var label lblTP     = na

var label thesisHdr = na
var label thesisL1  = na
var label thesisL2  = na
var label thesisL3  = na
var label thesisL4  = na
var label thesisL5  = na

var table panel     = table.new(position.top_right, 2, 7, border_width=1)

//====================
// Drawing window
//====================
leftX  = latestOnly ? math.max(bar_index - 3, 0) : math.max(bar_index - rrBoxBars, 0)
rightX = bar_index + rrBoxBars

//====================
// Entry zone
//====================
if showEntryZone
    if na(entryBox)
        entryBox := box.new(leftX, entryHigh, rightX, entryLow, bgcolor=colEntryFill, border_color=colEntryBorder, border_width=1)
    else
        box.set_left(entryBox, leftX)
        box.set_right(entryBox, rightX)
        box.set_top(entryBox, entryHigh)
        box.set_bottom(entryBox, entryLow)
        box.set_bgcolor(entryBox, colEntryFill)
        box.set_border_color(entryBox, colEntryBorder)
else
    if not na(entryBox)
        box.delete(entryBox)
        entryBox := na

//====================
// True risk/reward boxes
//====================
if showRRBox
    if na(rewardBox)
        rewardBox := box.new(leftX, targetPrice, rightX, entryMid, bgcolor=colRewardFill, border_color=colRewardBorder, border_width=1)
    else
        box.set_left(rewardBox, leftX)
        box.set_right(rewardBox, rightX)
        box.set_top(rewardBox, targetPrice)
        box.set_bottom(rewardBox, entryMid)
        box.set_bgcolor(rewardBox, colRewardFill)
        box.set_border_color(rewardBox, colRewardBorder)

    if na(riskBox)
        riskBox := box.new(leftX, entryMid, rightX, stopLoss, bgcolor=colRiskFill, border_color=colRiskBorder, border_width=1)
    else
        box.set_left(riskBox, leftX)
        box.set_right(riskBox, rightX)
        box.set_top(riskBox, entryMid)
        box.set_bottom(riskBox, stopLoss)
        box.set_bgcolor(riskBox, colRiskFill)
        box.set_border_color(riskBox, colRiskBorder)
else
    if not na(rewardBox)
        box.delete(rewardBox)
        rewardBox := na
    if not na(riskBox)
        box.delete(riskBox)
        riskBox := na

//====================
// Stop / Target lines
//====================
if showSLLine
    if na(slLine)
        slLine := line.new(leftX, stopLoss, rightX, stopLoss, color=colStop, width=2)
    else
        line.set_xy1(slLine, leftX, stopLoss)
        line.set_xy2(slLine, rightX, stopLoss)
        line.set_color(slLine, colStop)
        line.set_width(slLine, 2)
else
    if not na(slLine)
        line.delete(slLine)
        slLine := na

if showTPLine
    if na(tpLine)
        tpLine := line.new(leftX, targetPrice, rightX, targetPrice, color=colTarget, width=2)
    else
        line.set_xy1(tpLine, leftX, targetPrice)
        line.set_xy2(tpLine, rightX, targetPrice)
        line.set_color(tpLine, colTarget)
        line.set_width(tpLine, 2)
else
    if not na(tpLine)
        line.delete(tpLine)
        tpLine := na

//====================
// Projection path
//====================
if showPath
    if na(pathLine)
        pathLine := line.new(bar_index, entryMid, bar_index + projBars, targetPrice, color=colPath, width=2, style=line.style_dashed)
    else
        line.set_xy1(pathLine, bar_index, entryMid)
        line.set_xy2(pathLine, bar_index + projBars, targetPrice)
        line.set_color(pathLine, colPath)
        line.set_width(pathLine, 2)
        line.set_style(pathLine, line.style_dashed)
else
    if not na(pathLine)
        line.delete(pathLine)
        pathLine := na

//====================
// Trend lines
//====================
supportX1 = math.max(bar_index - supportBarsBack, 0)
supportY1 = supportStartPrice
supportX2 = bar_index + trendExtendRight
supportY2 = entryLow

recoverX1 = math.max(bar_index - recoveryBarsBack, 0)
recoverY1 = recoveryStartPrice
recoverX2 = bar_index + trendExtendRight
recoverY2 = targetPrice

if showTrend
    if na(supportTL)
        supportTL := line.new(supportX1, supportY1, supportX2, supportY2, color=colSupportTrend, width=2)
    else
        line.set_xy1(supportTL, supportX1, supportY1)
        line.set_xy2(supportTL, supportX2, supportY2)
        line.set_color(supportTL, colSupportTrend)
        line.set_width(supportTL, 2)

    if na(recoverTL)
        recoverTL := line.new(recoverX1, recoverY1, recoverX2, recoverY2, color=colRecoverTrend, width=2, style=line.style_dashed)
    else
        line.set_xy1(recoverTL, recoverX1, recoverY1)
        line.set_xy2(recoverTL, recoverX2, recoverY2)
        line.set_color(recoverTL, colRecoverTrend)
        line.set_width(recoverTL, 2)
        line.set_style(recoverTL, line.style_dashed)
else
    if not na(supportTL)
        line.delete(supportTL)
        supportTL := na
    if not na(recoverTL)
        line.delete(recoverTL)
        recoverTL := na

//====================
// Channel
//====================
chX1 = math.max(bar_index - channelBarsBack, 0)
chX2 = bar_index + channelExtendRight
chSupportY1 = channelSupportStart
chSupportY2 = channelSupportEnd
chResistY1  = channelSupportStart + channelHeight
chResistY2  = channelSupportEnd + channelHeight
chMidY1     = (chSupportY1 + chResistY1) / 2.0
chMidY2     = (chSupportY2 + chResistY2) / 2.0

if showChannel
    if na(chSupport)
        chSupport := line.new(chX1, chSupportY1, chX2, chSupportY2, color=colChannelLow, width=2)
    else
        line.set_xy1(chSupport, chX1, chSupportY1)
        line.set_xy2(chSupport, chX2, chSupportY2)
        line.set_color(chSupport, colChannelLow)
        line.set_width(chSupport, 2)

    if na(chResist)
        chResist := line.new(chX1, chResistY1, chX2, chResistY2, color=colChannelHigh, width=2)
    else
        line.set_xy1(chResist, chX1, chResistY1)
        line.set_xy2(chResist, chX2, chResistY2)
        line.set_color(chResist, colChannelHigh)
        line.set_width(chResist, 2)

    if showMidline
        if na(chMid)
            chMid := line.new(chX1, chMidY1, chX2, chMidY2, color=colChannelMid, width=1, style=line.style_dashed)
        else
            line.set_xy1(chMid, chX1, chMidY1)
            line.set_xy2(chMid, chX2, chMidY2)
            line.set_color(chMid, colChannelMid)
            line.set_width(chMid, 1)
            line.set_style(chMid, line.style_dashed)
    else
        if not na(chMid)
            line.delete(chMid)
            chMid := na

    if na(chFill)
        chFill := linefill.new(chSupport, chResist, colChannelFill)
else
    if not na(chSupport)
        line.delete(chSupport)
        chSupport := na
    if not na(chResist)
        line.delete(chResist)
        chResist := na
    if not na(chMid)
        line.delete(chMid)
        chMid := na
    chFill := na

//====================
// Price labels
//====================
if showLabels
    if na(lblEntry)
        lblEntry := label.new(bar_index, entryMid, "", style=label.style_label_right, textcolor=colText, color=color.new(color.teal, 0), size=size.normal)
    if na(lblSL)
        lblSL := label.new(bar_index, stopLoss, "", style=label.style_label_right, textcolor=colText, color=color.new(color.red, 0), size=size.normal)
    if na(lblTP)
        lblTP := label.new(bar_index, targetPrice, "", style=label.style_label_right, textcolor=colText, color=color.new(color.blue, 0), size=size.normal)

    label.set_x(lblEntry, rightX)
    label.set_y(lblEntry, entryMid)
    label.set_text(lblEntry, "LONG " + str.tostring(entryLow) + " - " + str.tostring(entryHigh))
    label.set_size(lblEntry, size.normal)

    label.set_x(lblSL, rightX)
    label.set_y(lblSL, stopLoss)
    label.set_text(lblSL, "SL " + str.tostring(stopLoss))
    label.set_size(lblSL, size.normal)

    label.set_x(lblTP, rightX)
    label.set_y(lblTP, targetPrice)
    label.set_text(lblTP, "TP " + str.tostring(targetPrice))
    label.set_size(lblTP, size.normal)
else
    if not na(lblEntry)
        label.delete(lblEntry)
        lblEntry := na
    if not na(lblSL)
        label.delete(lblSL)
        lblSL := na
    if not na(lblTP)
        label.delete(lblTP)
        lblTP := na

//====================
// Thesis / conclusion text box
//====================
thesisLeft   = bar_index + thesisOffset
thesisRight  = thesisLeft + thesisBars
thesisTop    = targetPrice + 55
thesisBottom = targetPrice - 115

if showThesis
    if na(thesisBox)
        thesisBox := box.new(thesisLeft, thesisTop, thesisRight, thesisBottom, bgcolor=colThesisBg, border_color=colThesisBorder, border_width=1)
    else
        box.set_left(thesisBox, thesisLeft)
        box.set_right(thesisBox, thesisRight)
        box.set_top(thesisBox, thesisTop)
        box.set_bottom(thesisBox, thesisBottom)
        box.set_bgcolor(thesisBox, colThesisBg)
        box.set_border_color(thesisBox, colThesisBorder)

    step = (thesisTop - thesisBottom) / 7.0

    if na(thesisHdr)
        thesisHdr := label.new(thesisLeft + 1, thesisTop - step * 0.8, "", style=label.style_none, textcolor=color.white, size=size.large)
    if na(thesisL1)
        thesisL1 := label.new(thesisLeft + 1, thesisTop - step * 1.8, "", style=label.style_none, textcolor=color.white, size=size.normal)
    if na(thesisL2)
        thesisL2 := label.new(thesisLeft + 1, thesisTop - step * 2.8, "", style=label.style_none, textcolor=color.white, size=size.normal)
    if na(thesisL3)
        thesisL3 := label.new(thesisLeft + 1, thesisTop - step * 3.8, "", style=label.style_none, textcolor=color.white, size=size.normal)
    if na(thesisL4)
        thesisL4 := label.new(thesisLeft + 1, thesisTop - step * 4.8, "", style=label.style_none, textcolor=color.white, size=size.normal)
    if na(thesisL5)
        thesisL5 := label.new(thesisLeft + 1, thesisTop - step * 5.8, "", style=label.style_none, textcolor=color.white, size=size.normal)

    label.set_x(thesisHdr, thesisLeft + 1)
    label.set_y(thesisHdr, thesisTop - step * 0.8)
    label.set_text(thesisHdr, thesisTitle)
    label.set_size(thesisHdr, size.large)

    label.set_x(thesisL1, thesisLeft + 1)
    label.set_y(thesisL1, thesisTop - step * 1.8)
    label.set_text(thesisL1, thesisLine1)
    label.set_size(thesisL1, size.normal)

    label.set_x(thesisL2, thesisLeft + 1)
    label.set_y(thesisL2, thesisTop - step * 2.8)
    label.set_text(thesisL2, thesisLine2)
    label.set_size(thesisL2, size.normal)

    label.set_x(thesisL3, thesisLeft + 1)
    label.set_y(thesisL3, thesisTop - step * 3.8)
    label.set_text(thesisL3, thesisLine3)
    label.set_size(thesisL3, size.normal)

    label.set_x(thesisL4, thesisLeft + 1)
    label.set_y(thesisL4, thesisTop - step * 4.8)
    label.set_text(thesisL4, thesisLine4)
    label.set_size(thesisL4, size.normal)

    label.set_x(thesisL5, thesisLeft + 1)
    label.set_y(thesisL5, thesisTop - step * 5.8)
    label.set_text(thesisL5, thesisLine5)
    label.set_size(thesisL5, size.normal)
else
    if not na(thesisBox)
        box.delete(thesisBox)
        thesisBox := na
    if not na(thesisHdr)
        label.delete(thesisHdr)
        thesisHdr := na
    if not na(thesisL1)
        label.delete(thesisL1)
        thesisL1 := na
    if not na(thesisL2)
        label.delete(thesisL2)
        thesisL2 := na
    if not na(thesisL3)
        label.delete(thesisL3)
        thesisL3 := na
    if not na(thesisL4)
        label.delete(thesisL4)
        thesisL4 := na
    if not na(thesisL5)
        label.delete(thesisL5)
        thesisL5 := na

//====================
// Info panel
//====================
if showPanel and barstate.islast
    table.cell(panel, 0, 0, "SETUP", text_color=colText, bgcolor=colPanelHead, text_size=size.normal)
    table.cell(panel, 1, 0, "Institutional Long", text_color=colText, bgcolor=colPanelHead, text_size=size.normal)

    table.cell(panel, 0, 1, "Entry", text_color=colText, bgcolor=colPanelRow, text_size=size.normal)
    table.cell(panel, 1, 1, str.tostring(entryLow) + " - " + str.tostring(entryHigh), text_color=colText, bgcolor=colPanelRow, text_size=size.normal)

    table.cell(panel, 0, 2, "Stop", text_color=colText, bgcolor=colPanelRow, text_size=size.normal)
    table.cell(panel, 1, 2, str.tostring(stopLoss), text_color=colText, bgcolor=colPanelRow, text_size=size.normal)

    table.cell(panel, 0, 3, "Target", text_color=colText, bgcolor=colPanelRow, text_size=size.normal)
    table.cell(panel, 1, 3, str.tostring(targetPrice), text_color=colText, bgcolor=colPanelRow, text_size=size.normal)

    table.cell(panel, 0, 4, "Risk:Reward", text_color=colText, bgcolor=colPanelRow, text_size=size.normal)
    table.cell(panel, 1, 4, na(rr) ? "n/a" : "1 : " + str.tostring(rr, "#.##"), text_color=colText, bgcolor=colPanelRow, text_size=size.normal)

    table.cell(panel, 0, 5, "Bias", text_color=colText, bgcolor=colPanelRow, text_size=size.normal)
    table.cell(panel, 1, 5, "Support reversal", text_color=colText, bgcolor=colPanelRow, text_size=size.normal)

    table.cell(panel, 0, 6, "Channel", text_color=colText, bgcolor=colPanelRow, text_size=size.normal)
    table.cell(panel, 1, 6, showChannel ? "Active" : "Off", text_color=colText, bgcolor=colPanelRow, text_size=size.normal)
