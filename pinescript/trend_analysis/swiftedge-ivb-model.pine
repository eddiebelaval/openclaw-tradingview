//@version=5
indicator("Swiftedge IVB model", overlay=true, max_lines_count=500)

// ────────────────────────────────────────────────
// Inputs – tid og OR box..
// ────────────────────────────────────────────────
tz            = input.string("Europe/Berlin", "Timezone", options=["UTC", "Europe/Berlin", "America/New_York"])
or_start      = input.session("0900-0930", "Open Range Session (f.eks. 09:00-09:30)")
or_box_color  = input.color(color.orange, "Open Range Box Color")
or_transp     = input.int(85, "OR Box Transparency", minval=0, maxval=100)

up_target_color   = input.color(color.green,  "Up Targets Color")
down_target_color = input.color(color.red,    "Down Targets Color")

show_targets = input.bool(true, "Vis target-linjer", group="Targets")
show_labels  = input.bool(true,  "Vis breakout labels", group="Visuals")

// ────────────────────────────────────────────────
// Daily ATR – samme værdi uanset chart-timeframe
// ────────────────────────────────────────────────
atr_period   = input.int(14, "Daily ATR Period", minval=1, group="ATR Targets")

// Hent ATR fra DAILY timeframe – brug [1] for at få gårsdagens færdige ATR
daily_atr = request.security(syminfo.tickerid, "D", ta.atr(atr_period)[1], lookahead=barmerge.lookahead_off)

// Fallback hvis daily ATR ikke er tilgængelig (meget sjældent)
atr_val = na(daily_atr) ? ta.atr(atr_period) : daily_atr

// Multipler – tunet mod typisk DAX London ORB (kan ændres frit)
atr_mult_1   = input.float(0.1,  "Target 1 × Daily ATR", step=0.1, group="ATR Targets")
atr_mult_2   = input.float(0.2,  "Target 2 × Daily ATR", step=0.1, group="ATR Targets")
atr_mult_3   = input.float(0.3,  "Target 3 × Daily ATR", step=0.1, group="ATR Targets")
atr_mult_4   = input.float(0.4,  "Target 4 × Daily ATR", step=0.1, group="ATR Targets")
atr_mult_5   = input.float(0.5,  "Target 5 × Daily ATR", step=0.1, group="ATR Targets")
atr_mult_6   = input.float(0.0,  "Target 6 × Daily ATR (0 = slå fra)", step=0.1, group="ATR Targets")

// ────────────────────────────────────────────────
// Open Range logik
// ────────────────────────────────────────────────
in_or = not na(time(timeframe.period, or_start, tz))

var float or_high      = na
var float or_low       = na
var int   or_start_bar = na
var box   or_box       = na

if ta.change(time("D"))
    or_high      := na
    or_low       := na
    or_start_bar := na
    if not na(or_box)
        box.delete(or_box)
    or_box := na

if in_or and na(or_start_bar)
    or_start_bar := bar_index
    or_high      := high
    or_low       := low
    or_box := box.new(
         left       = bar_index,
         top        = high,
         right      = bar_index + 1,
         bottom     = low,
         bgcolor    = color.new(or_box_color, or_transp),
         border_color = or_box_color)

if in_or
    or_high := math.max(or_high, high)
    or_low  := math.min(or_low,  low)
    box.set_top(or_box, or_high)
    box.set_bottom(or_box, or_low)
    box.set_right(or_box, bar_index + 1)

if not in_or and not na(or_start_bar) and not na(or_box)
    box.set_right(or_box, bar_index)

// ────────────────────────────────────────────────
// Breakout detektion
// ────────────────────────────────────────────────
after_or = not in_or and not na(or_high)

up_break = after_or and ta.crossover(close, or_high) and close[1] <= or_high
dn_break = after_or and ta.crossunder(close, or_low)  and close[1] >= or_low

var float break_level = na
var bool  is_long     = false

if up_break
    break_level := or_high
    is_long     := true

if dn_break
    break_level := or_low
    is_long     := false

// ────────────────────────────────────────────────
// Tegn Daily ATR-baserede targets
// ────────────────────────────────────────────────
if (up_break or dn_break) and show_targets
    dir   = is_long ? 1 : -1
    col   = is_long ? up_target_color : down_target_color
    end_x = bar_index + 500

    if atr_mult_1 > 0
        line.new(bar_index, break_level + dir * atr_val * atr_mult_1, end_x, break_level + dir * atr_val * atr_mult_1, color=col, style=line.style_dashed)
    if atr_mult_2 > 0
        line.new(bar_index, break_level + dir * atr_val * atr_mult_2, end_x, break_level + dir * atr_val * atr_mult_2, color=col, style=line.style_dashed)
    if atr_mult_3 > 0
        line.new(bar_index, break_level + dir * atr_val * atr_mult_3, end_x, break_level + dir * atr_val * atr_mult_3, color=col, style=line.style_dashed)
    if atr_mult_4 > 0
        line.new(bar_index, break_level + dir * atr_val * atr_mult_4, end_x, break_level + dir * atr_val * atr_mult_4, color=col, style=line.style_dashed)
    if atr_mult_5 > 0
        line.new(bar_index, break_level + dir * atr_val * atr_mult_5, end_x, break_level + dir * atr_val * atr_mult_5, color=col, style=line.style_dashed)
    if atr_mult_6 > 0
        line.new(bar_index, break_level + dir * atr_val * atr_mult_6, end_x, break_level + dir * atr_val * atr_mult_6, color=col, style=line.style_dashed)

// ────────────────────────────────────────────────
// Labels ved breakout
// ────────────────────────────────────────────────
if up_break and show_labels
    label.new(bar_index, high, "↑ Break", yloc=yloc.abovebar, color=color.green, style=label.style_label_down, size=size.small)

if dn_break and show_labels
    label.new(bar_index, low,  "↓ Break", yloc=yloc.belowbar, color=color.red,   style=label.style_label_up,   size=size.small)

// ────────────────────────────────────────────────
// Reference plot af OR high/low
// ────────────────────────────────────────────────
plot(after_or ? or_high : na, "OR High", color=color.orange, linewidth=1, style=plot.style_circles)
plot(after_or ? or_low  : na, "OR Low",  color=color.orange, linewidth=1, style=plot.style_circles)
