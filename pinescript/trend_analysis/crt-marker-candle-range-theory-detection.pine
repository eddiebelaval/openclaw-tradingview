//@version=5
indicator("CRT Marker", overlay=true, max_lines_count=500, max_labels_count=500)

// ─── Inputs ───────────────────────────────────────────────────────────
showAll         = input.bool(false, "Show All CRTs (Replay Mode)", tooltip="Enable this during bar replay to bypass the lookback day filter and show all CRTs")
lookbackDays    = input.int(2, "Show CRTs from last N days", minval=1, maxval=30, tooltip="Only display CRT markings from the last N calendar days. Ignored when 'Show All' is enabled.")
bullColor       = input.color(color.new(color.green, 20), "Bullish CRT Color")
bearColor       = input.color(color.new(color.red, 20), "Bearish CRT Color")
slColor         = input.color(color.new(color.red, 40), "SL Line Color")
tpColor         = input.color(color.new(color.green, 40), "TP Line Color")
lineStyle       = input.string("Dashed", "Line Style", options=["Solid", "Dashed", "Dotted"])
lineWidth       = input.int(1, "Line Width", minval=1, maxval=4)
showLabels      = input.bool(true, "Show Labels")
labelSize       = input.string("small", "Label Size", options=["tiny", "small", "normal"])

// ─── Helpers ──────────────────────────────────────────────────────────
getLineStyle(s) =>
    s == "Solid" ? line.style_solid : s == "Dashed" ? line.style_dashed : line.style_dotted

getLabelSize(s) =>
    s == "tiny" ? size.tiny : s == "small" ? size.small : size.normal

cutoffTime = timenow - lookbackDays * 86400000
isInWindow = showAll or time >= cutoffTime

// ─── CRT Tracking Arrays ─────────────────────────────────────────────
var line[]  slLines   = array.new_line()
var line[]  tpLines   = array.new_line()
var label[] crtLabels = array.new_label()
var float[] slLevels  = array.new_float()
var float[] tpLevels  = array.new_float()
var int[]   crtTypes  = array.new_int()    // 1 = bearish (high swept), -1 = bullish (low swept)
var int[]   originTs  = array.new_int()

// ─── Helper: remove CRT at index ─────────────────────────────────────
removeCRT(idx) =>
    line.delete(array.get(slLines, idx))
    line.delete(array.get(tpLines, idx))
    array.remove(slLines, idx)
    array.remove(tpLines, idx)
    if idx < array.size(crtLabels)
        label.delete(array.get(crtLabels, idx))
        array.remove(crtLabels, idx)
    array.remove(slLevels, idx)
    array.remove(tpLevels, idx)
    array.remove(crtTypes, idx)
    array.remove(originTs, idx)

// ─── Purge CRTs outside the lookback window (skip if Show All) ──────
if not showAll and array.size(slLines) > 0
    int idx = array.size(slLines) - 1
    while idx >= 0
        if array.get(originTs, idx) < cutoffTime
            removeCRT(idx)
        idx -= 1

// ─── Invalidation: remove CRTs where SL or TP is hit ────────────────
if array.size(slLines) > 0
    int idx = array.size(slLines) - 1
    while idx >= 0
        sl      = array.get(slLevels, idx)
        tp      = array.get(tpLevels, idx)
        cType   = array.get(crtTypes, idx)
        hit     = false

        if cType == -1  // bullish CRT
            if close < sl or close > tp
                hit := true
        if cType == 1   // bearish CRT
            if close > sl or close < tp
                hit := true

        if hit
            removeCRT(idx)
        idx -= 1

// ─── Extend surviving lines to current bar ───────────────────────────
if array.size(slLines) > 0
    for i = 0 to array.size(slLines) - 1
        line.set_x2(array.get(slLines, i), time)
        line.set_x2(array.get(tpLines, i), time)

// ─── Detect new CRTs ─────────────────────────────────────────────────
refHigh = high[1]
refLow  = low[1]

bearishCRT = isInWindow and high > refHigh and close < refHigh
bullishCRT = isInWindow and low < refLow and close > refLow

if bearishCRT
    slLn = line.new(time[1], refHigh, time, refHigh, xloc=xloc.bar_time, color=slColor, style=getLineStyle(lineStyle), width=lineWidth)
    tpLn = line.new(time[1], refLow, time, refLow, xloc=xloc.bar_time, color=tpColor, style=getLineStyle(lineStyle), width=lineWidth)
    array.push(slLines, slLn)
    array.push(tpLines, tpLn)
    array.push(slLevels, refHigh)
    array.push(tpLevels, refLow)
    array.push(crtTypes, 1)
    array.push(originTs, time[1])
    if showLabels
        lb = label.new(time[1], refHigh, "CRT ▼", xloc=xloc.bar_time, style=label.style_label_down, color=bearColor, textcolor=color.white, size=getLabelSize(labelSize))
        array.push(crtLabels, lb)

if bullishCRT
    slLn = line.new(time[1], refLow, time, refLow, xloc=xloc.bar_time, color=slColor, style=getLineStyle(lineStyle), width=lineWidth)
    tpLn = line.new(time[1], refHigh, time, refHigh, xloc=xloc.bar_time, color=tpColor, style=getLineStyle(lineStyle), width=lineWidth)
    array.push(slLines, slLn)
    array.push(tpLines, tpLn)
    array.push(slLevels, refLow)
    array.push(tpLevels, refHigh)
    array.push(crtTypes, -1)
    array.push(originTs, time[1])
    if showLabels
        lb = label.new(time[1], refLow, "CRT ▲", xloc=xloc.bar_time, style=label.style_label_up, color=bullColor, textcolor=color.white, size=getLabelSize(labelSize))
        array.push(crtLabels, lb)
