//@version=6
indicator("VIDYA Rejection RR Tracker 🧬", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ─── VIDYA SETTINGS ───────────────────────────────────────────────────────────
vidya_length    = input.int(10,  "VIDYA Length",    minval=1, group="VIDYA Settings 🧬")
vidya_momentum  = input.int(20,  "VIDYA Momentum",  minval=1, group="VIDYA Settings 🧬")
showVidyaLine   = input.bool(true, "Show VIDYA Line",          group="VIDYA Settings 🧬")
vidyaUpColor    = input.color(color.new(#17dfad, 0), "VIDYA Uptrend Color",   group="VIDYA Settings 🧬")
vidyaDownColor  = input.color(color.new(#dd326b, 0), "VIDYA Downtrend Color", group="VIDYA Settings 🧬")
vidyaThickness  = input.int(1, "VIDYA Line Thickness", minval=1, maxval=4,    group="VIDYA Settings 🧬")

// ─── VIDYA REJECTION SETTINGS ─────────────────────────────────────────────────
useVidyaEMAFilter  = input.bool(true,  "Enable EMA Filter for VIDYA Rejection",          group="VIDYA Rejection Settings 🧬")
vidyaRejEMAPeriod  = input.int(5,     "VIDYA Rejection EMA Period", minval=1,            group="VIDYA Rejection Settings 🧬")
showVidyaSignals   = input.bool(true,  "Show VIDYA Rejection Signals 🟢🔴",              group="VIDYA Rejection Settings 🧬")
enableVidyaTol     = input.bool(false, "Enable Wick Tolerance 📏",                       group="VIDYA Rejection Settings 🧬", tooltip="When enabled, the wick does not need to touch the VIDYA exactly — it is considered valid if it comes within the specified distance.")
vidyaTolPips       = input.float(2.0,  "Wick Tolerance (pips)", minval=0.1, step=0.1,   group="VIDYA Rejection Settings 🧬")

// ─── FILTERS ──────────────────────────────────────────────────────────────────
enableVWAPFilter   = input.bool(true,  "Enable VWAP Filter",      group="Filters 🔍")
enableEMA750Filter = input.bool(true,  "Enable EMA 750 Filter",   group="Filters 🔍")
ema750FilterPeriod = input.int(750,    "EMA Filter Period", minval=1, group="Filters 🔍")
enableATRFilter    = input.bool(false, "Enable ATR Band Filter",   group="Filters 🔍")
atrMult            = input.float(10.0, "ATR Multiplier", minval=1, maxval=100, step=0.5, group="Filters 🔍")

// ─── DISPLAY ──────────────────────────────────────────────────────────────────
showEMA750       = input.bool(true,  "Show EMA 750",          group="Display 🎨")
showVWAP         = input.bool(true,  "Show VWAP",             group="Display 🎨")
showATRBandLines = input.bool(false, "Show ATR Band Lines",   group="Display 🎨")
enableATRFill    = input.bool(false, "Show ATR Band Fill",    group="Display 🎨")
ema750Col        = input.color(color.new(#f8f8f8, 50),        "EMA 750 Color",     group="Display 🎨")
vwapCol          = input.color(color.new(#c2185c, 35),        "VWAP Color",        group="Display 🎨")
upperBandCol     = input.color(color.rgb(139,139,139,50),     "Upper Band Color",  group="Display 🎨")
lowerBandCol     = input.color(color.rgb(139,139,139,50),     "Lower Band Color",  group="Display 🎨")
upperFillCol     = input.color(color.new(#00bcd4, 90),        "Upper Fill Color",  group="Display 🎨")
lowerFillCol     = input.color(color.new(#ff5252, 90),        "Lower Fill Color",  group="Display 🎨")

// ─── TRADE VISUALIZATION ──────────────────────────────────────────────────────
showRR        = input.bool(true,  "Show Trade Visualization (RR Boxes)", group="Trade Settings 📊")
overlapTrades = input.bool(false, "Overlap Trades 🔀",                   group="Trade Settings 📊")
rrSlPips      = input.float(10.0, "SL Buffer (pips beyond wick)", minval=0.1, group="Trade Settings 📊")
rrRatio       = input.float(3.0,  "Risk:Reward Ratio", minval=0.1, step=0.1,  group="Trade Settings 📊")
showPipLabels = input.bool(true,  "Show TP/SL Pip Labels",               group="Trade Settings 📊")
showTable     = input.bool(true,  "Show Win Rate Table",                  group="Trade Settings 📊")

// ─── SESSION ──────────────────────────────────────────────────────────────────
utcOffset        = input.int(1,     "UTC Offset (hours)", minval=-12, maxval=14, group="Sessions 🕐")
useSessionFilter = input.bool(true, "Enable Session Filter",                      group="Sessions 🕐")
showSessionStats = input.bool(false,"Show Session Stats in Table",                group="Sessions 🕐")
bestByPips       = input.bool(true, "Best Session: rank by Pips",                 group="Sessions 🕐")
useAsia          = input.bool(true, "Include Asia",                               group="Sessions 🕐")
asiaSession      = input.session("0000-0800", "Asia Range",                       group="Sessions 🕐")
useLondon        = input.bool(true, "Include London",                             group="Sessions 🕐")
londonSession    = input.session("0700-1600", "London Range",                     group="Sessions 🕐")
useNewYork       = input.bool(true, "Include New York",                           group="Sessions 🕐")
nySession        = input.session("1300-2200", "New York Range",                   group="Sessions 🕐")
useCustom        = input.bool(false,"Enable Custom Exclusion Window",             group="Sessions 🕐")
customExcl       = input.session("2200-0700","Exclusion Window",                  group="Sessions 🕐")
showAsiaBg       = input.bool(false,"Show Asia Background",                       group="Sessions 🕐")
asiaBgColor      = input.color(color.new(#8e21f3, 97), "Asia BG Color",           group="Sessions 🕐")
showLondonBg     = input.bool(false,"Show London Background",                     group="Sessions 🕐")
londonBgColor    = input.color(color.new(#003bfd, 97), "London BG Color",         group="Sessions 🕐")
showNYBg         = input.bool(false,"Show NY Background",                         group="Sessions 🕐")
nyBgColor        = input.color(color.new(#fffb00, 97), "NY BG Color",             group="Sessions 🕐")

// ─── ALERTS ───────────────────────────────────────────────────────────────────
enableBullAlert  = input.bool(true, "Enable Bullish VIDYA Rejection Alert 🟢", group="Alerts 🔊")
enableBearAlert  = input.bool(true, "Enable Bearish VIDYA Rejection Alert 🔴", group="Alerts 🔊")
enableTPSLAlert  = input.bool(true, "Enable TP/SL Hit Alert 🎯",               group="Alerts 🔊")
enableEntryAlert = input.bool(true, "Enable Trade Entry Alert 🚀",             group="Alerts 🔊")

// ─── SESSION HELPERS ──────────────────────────────────────────────────────────
getTZ() =>
    "UTC" + (utcOffset >= 0 ? "+" + str.tostring(utcOffset) : str.tostring(utcOffset))

inAsia       = useAsia    and not na(time(timeframe.period, asiaSession,   getTZ()))
inLondon     = useLondon  and not na(time(timeframe.period, londonSession, getTZ()))
inNewYork    = useNewYork and not na(time(timeframe.period, nySession,     getTZ()))
inCustomExcl = useCustom  and not na(time(timeframe.period, customExcl,   getTZ()))

inAnySession   = inAsia or inLondon or inNewYork
sessionAllowed = not inCustomExcl and (not useSessionFilter or inAnySession)

sessionTag(bool inA, bool inL, bool inNY) =>
    inNY and inL ? "LN+NY" : inL ? "London" : inNY ? "NY" : inA ? "Asia" : "Off-Session"
curSession = sessionTag(inAsia, inLondon, inNewYork)

// ─── INDICATORS ───────────────────────────────────────────────────────────────
vwap         = ta.vwap(hl2)
ema750       = ta.ema(close, ema750FilterPeriod)
vidyaRejEMA  = ta.ema(close, vidyaRejEMAPeriod)

smoothATR    = ta.ema(ta.tr, 750)
upperBand    = ema750 + atrMult * smoothATR
lowerBand    = ema750 - atrMult * smoothATR

// ─── PIP SIZE ─────────────────────────────────────────────────────────────────
pipSize = syminfo.mintick * (syminfo.type == "forex" ? 10 : 1)

// ─── VIDYA CALCULATION ────────────────────────────────────────────────────────
vidya_calc(src, len, mom) =>
    float momentum   = ta.change(src)
    float sum_pos    = math.sum(momentum >= 0 ? momentum : 0.0, mom)
    float sum_neg    = math.sum(momentum >= 0 ? 0.0 : -momentum, mom)
    float abs_cmo    = math.abs(100 * (sum_pos - sum_neg) / (sum_pos + sum_neg))
    float alpha      = 2 / (len + 1)
    var float vidya  = 0.0
    vidya := alpha * abs_cmo / 100 * src + (1 - alpha * abs_cmo / 100) * nz(vidya[1])
    ta.sma(vidya, 15)

float atr_vidya        = ta.atr(200)
float vidya_value      = vidya_calc(close, vidya_length, vidya_momentum)
float upper_band_vidya = vidya_value + atr_vidya * 0.0
float lower_band_vidya = vidya_value - atr_vidya * 0.0

var bool is_trend_up_vidya = false
if ta.crossover(close, upper_band_vidya)
    is_trend_up_vidya := true
if ta.crossunder(close, lower_band_vidya)
    is_trend_up_vidya := false

var float vidya_plot_value = na
if is_trend_up_vidya
    vidya_plot_value := lower_band_vidya
if not is_trend_up_vidya
    vidya_plot_value := upper_band_vidya
if ta.change(is_trend_up_vidya)
    vidya_plot_value := na

// ─── PLOTS ────────────────────────────────────────────────────────────────────
plot(showEMA750 ? ema750 : na, "EMA 750", color=ema750Col, linewidth=1)
plot(showVWAP   ? vwap   : na, "VWAP",    color=vwapCol,   linewidth=1)

vidya_trend_color = is_trend_up_vidya ? vidyaUpColor : vidyaDownColor
plot(showVidyaLine ? vidya_plot_value : na, "VIDYA Line", color=vidya_trend_color, linewidth=vidyaThickness, style=plot.style_linebr)

upperBandPlot     = plot(showATRBandLines ? upperBand : na, "Upper Band",            color=upperBandCol,               linewidth=1)
upperBandFillPlot = plot(enableATRFill    ? upperBand : na, "Upper Band (fill ref)", color=color.new(color.white,100), linewidth=1)
ema750Plot        = plot(ema750,                            "EMA 750 (bands ref)",   color=color.new(color.white,100), linewidth=1)
lowerBandFillPlot = plot(enableATRFill    ? lowerBand : na, "Lower Band (fill ref)", color=color.new(color.white,100), linewidth=1)
lowerBandPlot     = plot(showATRBandLines ? lowerBand : na, "Lower Band",            color=lowerBandCol,               linewidth=1)

fill(ema750Plot, upperBandFillPlot, color=enableATRFill ? upperFillCol : color.new(color.white,100), title="Upper Band Fill")
fill(ema750Plot, lowerBandFillPlot, color=enableATRFill ? lowerFillCol : color.new(color.white,100), title="Lower Band Fill")

// ─── VIDYA REJECTION LOGIC ────────────────────────────────────────────────────
bool vidyaBullRejection = false
bool vidyaBearRejection = false

if not na(vidya_value) and sessionAllowed
    tolDist = enableVidyaTol ? vidyaTolPips * pipSize : 0.0

    isBullishCandle       = close > open
    lowerWickTouchesVidya = low <= vidya_value + tolDist
    bodyAboveVidya        = math.min(open, close) > vidya_value
    emaCondBull           = not useVidyaEMAFilter  or close > vidyaRejEMA
    vwapCondBull          = not enableVWAPFilter   or close > vwap
    ema750CondBull        = not enableEMA750Filter or close > ema750
    atrCondBull           = not enableATRFilter    or close <= upperBand

    if isBullishCandle and lowerWickTouchesVidya and bodyAboveVidya and emaCondBull and vwapCondBull and ema750CondBull and atrCondBull
        vidyaBullRejection := true

    isBearishCandle       = close < open
    upperWickTouchesVidya = high >= vidya_value - tolDist
    bodyBelowVidya        = math.max(open, close) < vidya_value
    emaCondBear           = not useVidyaEMAFilter  or close < vidyaRejEMA
    vwapCondBear          = not enableVWAPFilter   or close < vwap
    ema750CondBear        = not enableEMA750Filter or close < ema750
    atrCondBear           = not enableATRFilter    or close >= lowerBand

    if isBearishCandle and upperWickTouchesVidya and bodyBelowVidya and emaCondBear and vwapCondBear and ema750CondBear and atrCondBear
        vidyaBearRejection := true

// ─── VISUAL SIGNALS ───────────────────────────────────────────────────────────
plotshape(showVidyaSignals and vidyaBullRejection, "VIDYA Bull Rejection", shape.triangleup,   location.belowbar, color=color.rgb(23,223,173,0), size=size.small)
plotshape(showVidyaSignals and vidyaBearRejection, "VIDYA Bear Rejection", shape.triangledown, location.abovebar, color=color.rgb(221,50,107,0),  size=size.small)

// ─── TRADE TYPE ───────────────────────────────────────────────────────────────
type RRTrade
    box    slBox
    box    tpBox
    label  tpLabel
    label  slLabel
    float  slLevel
    float  tpLevel
    float  entryPrice
    bool   isBull
    string session

var array<RRTrade> activeTrades = array.new<RRTrade>()

// ─── WIN RATE (global) ────────────────────────────────────────────────────────
var int   totTrades   = 0
var int   totWins     = 0
var float totWinPips  = 0.0
var float totLossPips = 0.0

// ─── WIN RATE (sessioni) ──────────────────────────────────────────────────────
var int   asia_t  = 0
var int   asia_w  = 0
var float asia_wp = 0.0
var float asia_lp = 0.0
var int   lon_t   = 0
var int   lon_w   = 0
var float lon_wp  = 0.0
var float lon_lp  = 0.0
var int   ny_t    = 0
var int   ny_w    = 0
var float ny_wp   = 0.0
var float ny_lp   = 0.0
var int   off_t   = 0
var int   off_w   = 0
var float off_wp  = 0.0
var float off_lp  = 0.0

// ─── UPDATE TRADES ────────────────────────────────────────────────────────────
if array.size(activeTrades) > 0
    for i = array.size(activeTrades) - 1 to 0
        t     = array.get(activeTrades, i)
        slHit = t.isBull ? low  <= t.slLevel : high >= t.slLevel
        tpHit = t.isBull ? high >= t.tpLevel : low  <= t.tpLevel
        if slHit or tpHit
            box.set_right(t.slBox, bar_index)
            box.set_right(t.tpBox, bar_index)
            pips = math.abs(tpHit ? t.tpLevel - t.entryPrice : t.slLevel - t.entryPrice) / pipSize
            if tpHit
                label.set_x(t.tpLabel, bar_index)
                label.set_text(t.tpLabel, showPipLabels ? "+" + str.tostring(pips, "#.#") + " pips" : "")
                label.set_color(t.tpLabel, showPipLabels ? color.new(#00e676, 50) : color.new(#00e676, 100))
                label.delete(t.slLabel)
                totWins    += 1
                totWinPips += pips
                if t.session == "Asia"
                    asia_t += 1
                    asia_w += 1
                    asia_wp += pips
                else if t.session == "London" or t.session == "LN+NY"
                    lon_t += 1
                    lon_w += 1
                    lon_wp += pips
                else if t.session == "NY"
                    ny_t += 1
                    ny_w += 1
                    ny_wp += pips
                else
                    off_t += 1
                    off_w += 1
                    off_wp += pips
                if enableTPSLAlert
                    alert("VIDYA TP HIT ✅ +" + str.tostring(pips, "#.#") + " pips at " + str.tostring(close), alert.freq_once_per_bar)
            else
                label.set_x(t.slLabel, bar_index)
                label.set_text(t.slLabel, showPipLabels ? "-" + str.tostring(pips, "#.#") + " pips" : "")
                label.set_color(t.slLabel, showPipLabels ? color.new(#ff1744, 50) : color.new(#ff1744, 100))
                label.delete(t.tpLabel)
                totLossPips += pips
                if t.session == "Asia"
                    asia_t += 1
                    asia_lp += pips
                else if t.session == "London" or t.session == "LN+NY"
                    lon_t += 1
                    lon_lp += pips
                else if t.session == "NY"
                    ny_t += 1
                    ny_lp += pips
                else
                    off_t += 1
                    off_lp += pips
                if enableTPSLAlert
                    alert("VIDYA SL HIT ❌ -" + str.tostring(pips, "#.#") + " pips at " + str.tostring(close), alert.freq_once_per_bar)
            totTrades += 1
            array.remove(activeTrades, i)
        else
            box.set_right(t.slBox, bar_index + 1)
            box.set_right(t.tpBox, bar_index + 1)

// ─── OPEN TRADE ───────────────────────────────────────────────────────────────
openTrade(bool isBull, float spikeWick, string sess) =>
    entry  = close
    slDist = (isBull ? entry - spikeWick : spikeWick - entry) + rrSlPips * pipSize
    sl     = isBull ? entry - slDist : entry + slDist
    tp     = isBull ? entry + slDist * rrRatio : entry - slDist * rrRatio

    slB = isBull ?
      box.new(bar_index, entry, bar_index+1, sl, bgcolor=color.new(#ff1744,85), border_color=color.new(#ff1744,100), border_width=0) :
      box.new(bar_index, sl,    bar_index+1, entry, bgcolor=color.new(#ff1744,85), border_color=color.new(#ff1744,100), border_width=0)
    tpB = isBull ?
      box.new(bar_index, tp,    bar_index+1, entry, bgcolor=color.new(#00e676,85), border_color=color.new(#00e676,100), border_width=0) :
      box.new(bar_index, entry, bar_index+1, tp,    bgcolor=color.new(#00e676,85), border_color=color.new(#00e676,100), border_width=0)

    tpPips = math.abs(tp - entry) / pipSize
    slPips = slDist / pipSize
    tpTxt  = showPipLabels ? "+" + str.tostring(tpPips, "#.#") + "p" : ""
    slTxt  = showPipLabels ? "-" + str.tostring(slPips, "#.#") + "p" : ""

    tpLbl = label.new(bar_index+1, tp, tpTxt, style=label.style_label_left, textcolor=color.white,
              color=showPipLabels ? color.new(#00e676,50) : color.new(#00e676,100), size=size.small)
    slLbl = label.new(bar_index+1, sl, slTxt, style=label.style_label_left, textcolor=color.white,
              color=showPipLabels ? color.new(#ff1744,50) : color.new(#ff1744,100), size=size.small)

    array.push(activeTrades, RRTrade.new(slB, tpB, tpLbl, slLbl, sl, tp, entry, isBull, sess))

    if enableEntryAlert
        dir = isBull ? "🟢 LONG" : "🔴 SHORT"
        alert(dir + " VIDYA Rejection Entry | Entry: " + str.tostring(entry) +
          " | SL: " + str.tostring(sl) + " | TP: " + str.tostring(tp) +
          " | Session: " + sess, alert.freq_once_per_bar_close)

noActiveTrade = overlapTrades or array.size(activeTrades) == 0

if showRR and vidyaBullRejection and noActiveTrade
    openTrade(true,  low,  curSession)
if showRR and vidyaBearRejection and noActiveTrade
    openTrade(false, high, curSession)

// ─── ALERT CONDITIONS ─────────────────────────────────────────────────────────
alertcondition(vidyaBullRejection and enableBullAlert, "VIDYA Bullish Rejection 🟢", "🟢 VIDYA BULLISH REJECTION SIGNAL")
alertcondition(vidyaBearRejection and enableBearAlert, "VIDYA Bearish Rejection 🔴", "🔴 VIDYA BEARISH REJECTION SIGNAL")
if vidyaBullRejection and enableBullAlert
    alert("🟢 VIDYA BULLISH REJECTION at " + str.tostring(close), alert.freq_once_per_bar_close)
if vidyaBearRejection and enableBearAlert
    alert("🔴 VIDYA BEARISH REJECTION at " + str.tostring(close), alert.freq_once_per_bar_close)

// ─── HELPER FUNCTIONS (TABLE) ─────────────────────────────────────────────────
wrStr(int wins, int tot) =>
    tot > 0 ? str.tostring(math.round((wins / tot) * 100, 1), "#.#") + "%" : "—"
wrColor(int wins, int tot) =>
    tot == 0 ? color.rgb(150,150,150) : (wins / tot) >= 0.5 ? color.rgb(0,230,118) : color.rgb(255,70,70)
diffStr(float wp, float lp) =>
    d = wp - lp
    d >= 0 ? "+" + str.tostring(d, "#.#") : str.tostring(d, "#.#")
diffColor(float wp, float lp) =>
    (wp - lp) >= 0 ? color.rgb(0,230,118) : color.rgb(255,70,70)

bestSession() =>
    scores = bestByPips ?
      array.from(
        asia_t > 0 ? asia_wp - asia_lp : -999999.0,
        lon_t  > 0 ? lon_wp  - lon_lp  : -999999.0,
        ny_t   > 0 ? ny_wp   - ny_lp   : -999999.0,
        off_t  > 0 ? off_wp  - off_lp  : -999999.0) :
      array.from(
        asia_t > 0 ? asia_w / asia_t : -1.0,
        lon_t  > 0 ? lon_w  / lon_t  : -1.0,
        ny_t   > 0 ? ny_w   / ny_t   : -1.0,
        off_t  > 0 ? off_w  / off_t  : -1.0)
    best = array.indexof(scores, array.max(scores))
    best == 0 ? "Asia" : best == 1 ? "London" : best == 2 ? "NY" : "Off-Session"

// ─── WIN RATE TABLE ───────────────────────────────────────────────────────────
nRows = showSessionStats ? 11 : 5
var table statsTable = table.new(position.bottom_right, 7, nRows,
  border_width=1, border_color=color.rgb(255,255,255,70),
  frame_width=1,  frame_color=color.rgb(255,255,255,40))

if barstate.islast and showTable
    wr    = totTrades > 0 ? (totWins / totTrades) * 100.0 : 0.0
    diff  = totWinPips - totLossPips
    bSess = bestSession()
    hdr   = #121212
    dark  = #1a1a1a
    mid   = #222222
    gold  = color.rgb(255,215,0)
    wht   = color.white
    grey  = color.rgb(180,180,180)

    titleTxt = showSessionStats ? "VIDYA Rejection RR Tracker — Session Stats 📊" : "VIDYA Rejection RR Tracker 🧬"
    table.cell(statsTable, 0, 0, titleTxt, text_color=wht, text_size=size.normal, bgcolor=hdr)
    table.merge_cells(statsTable, 0, 0, 6, 0)

    tolTxt   = enableVidyaTol ? "  |  Tolerance: " + str.tostring(vidyaTolPips, "#.#") + " pips" : "  |  Tolerance: OFF"
    paramTxt = "RR: " + str.tostring(rrRatio, "#.#") + "  |  SL Buffer: " + str.tostring(rrSlPips, "#.#") + " pips" + tolTxt
    table.cell(statsTable, 0, 1, "⚙️  " + paramTxt, text_color=color.rgb(180,220,255), text_size=size.small, bgcolor=#1a2a3a)
    table.merge_cells(statsTable, 0, 1, 6, 1)

    colBg = #2a2a2a
    table.cell(statsTable, 0, 2, "Session",   text_color=grey, text_size=size.small, bgcolor=colBg)
    table.cell(statsTable, 1, 2, "Signal",    text_color=grey, text_size=size.small, bgcolor=colBg)
    table.cell(statsTable, 2, 2, "Trades",    text_color=grey, text_size=size.small, bgcolor=colBg)
    table.cell(statsTable, 3, 2, "Win Rate",  text_color=grey, text_size=size.small, bgcolor=colBg)
    table.cell(statsTable, 4, 2, "Win Pips",  text_color=grey, text_size=size.small, bgcolor=colBg)
    table.cell(statsTable, 5, 2, "Loss Pips", text_color=grey, text_size=size.small, bgcolor=colBg)
    table.cell(statsTable, 6, 2, "Diff",      text_color=grey, text_size=size.small, bgcolor=colBg)

    if showSessionStats
        sessions = array.from("Asia",  "London", "NY",  "Off-Session")
        trades_a = array.from(asia_t,  lon_t,    ny_t,  off_t)
        wins_a   = array.from(asia_w,  lon_w,    ny_w,  off_w)
        wp_a     = array.from(asia_wp, lon_wp,   ny_wp, off_wp)
        lp_a     = array.from(asia_lp, lon_lp,   ny_lp, off_lp)

        for r = 0 to 3
            sess   = array.get(sessions, r)
            tot    = array.get(trades_a, r)
            wins   = array.get(wins_a,   r)
            wp     = array.get(wp_a,     r)
            lp     = array.get(lp_a,     r)
            isBest = sess == bSess and tot > 0
            rowBg  = isBest ? #2a2200 : #1a1a1a
            txtC   = isBest ? gold : color.rgb(200,200,200)

            table.cell(statsTable, 0, r+3, sess,              text_color=txtC,                   text_size=size.small, bgcolor=rowBg)
            table.cell(statsTable, 1, r+3, "🟢🔴 VIDYA",      text_color=color.rgb(23,223,173),   text_size=size.small, bgcolor=rowBg)
            table.cell(statsTable, 2, r+3, str.tostring(tot), text_color=wht,                    text_size=size.small, bgcolor=rowBg)
            table.cell(statsTable, 3, r+3, wrStr(wins, tot),  text_color=wrColor(wins, tot),     text_size=size.small, bgcolor=rowBg)
            table.cell(statsTable, 4, r+3, tot>0 ? str.tostring(wp,"#.#") : "—", text_color=color.rgb(0,230,118), text_size=size.small, bgcolor=rowBg)
            table.cell(statsTable, 5, r+3, tot>0 ? str.tostring(lp,"#.#") : "—", text_color=color.rgb(255,70,70), text_size=size.small, bgcolor=rowBg)
            table.cell(statsTable, 6, r+3, tot>0 ? diffStr(wp,lp) : "—", text_color=tot>0 ? diffColor(wp,lp) : grey, text_size=size.small, bgcolor=rowBg)

        bestTxt = "⭐ Best Session: " + bSess
        table.cell(statsTable, 0, 7, bestTxt, text_color=gold, text_size=size.small, bgcolor=#1a1a00)
        table.merge_cells(statsTable, 0, 7, 6, 7)

    totRow = showSessionStats ? 8 : 3

    table.cell(statsTable, 0, totRow, "TOTAL",         text_color=gold, text_size=size.small, bgcolor=dark)
    table.cell(statsTable, 1, totRow, "🟢🔴 VIDYA",    text_color=color.rgb(23,223,173), text_size=size.small, bgcolor=dark)
    table.cell(statsTable, 2, totRow, str.tostring(totTrades), text_color=wht, text_size=size.small, bgcolor=dark)
    table.cell(statsTable, 3, totRow, str.tostring(wr, "#.##") + "%", text_color=wr >= 50 ? color.rgb(0,230,118) : color.rgb(255,70,70), text_size=size.small, bgcolor=dark)
    table.cell(statsTable, 4, totRow, str.tostring(totWinPips,  "#.#"), text_color=color.rgb(0,230,118), text_size=size.small, bgcolor=dark)
    table.cell(statsTable, 5, totRow, str.tostring(totLossPips, "#.#"), text_color=color.rgb(255,70,70), text_size=size.small, bgcolor=dark)
    table.cell(statsTable, 6, totRow, str.tostring(diff, "#.#"), text_color=diff>=0 ? color.rgb(0,230,118) : color.rgb(255,70,70), text_size=size.small, bgcolor=dark)

    livePips = 0.0
    if array.size(activeTrades) > 0
        for i = 0 to array.size(activeTrades) - 1
            t = array.get(activeTrades, i)
            livePips += t.isBull ? (close - t.entryPrice) / pipSize : (t.entryPrice - close) / pipSize
    liveTxt   = array.size(activeTrades) > 0 ? (livePips >= 0 ? "  |  +" : "  |  ") + str.tostring(livePips, "#.#") + " pips live" : ""
    openTxt   = str.tostring(array.size(activeTrades)) + " trade" + (array.size(activeTrades) == 1 ? "" : "s") + " open" + liveTxt + (overlapTrades ? "  |  Overlap ON 🔀" : "")
    liveColor = array.size(activeTrades) > 0 and livePips >= 0 ? color.rgb(0,230,118) : array.size(activeTrades) > 0 ? color.rgb(255,70,70) : color.rgb(180,220,255)
    table.cell(statsTable, 0, totRow+1, openTxt, text_color=liveColor, text_size=size.small, bgcolor=mid)
    table.merge_cells(statsTable, 0, totRow+1, 6, totRow+1)

// ─── SESSION BACKGROUNDS ──────────────────────────────────────────────────────
bgcolor(showAsiaBg   and inAsia    ? asiaBgColor   : na, title="Asia Background")
bgcolor(showLondonBg and inLondon  ? londonBgColor : na, title="London Background")
bgcolor(showNYBg     and inNewYork ? nyBgColor     : na, title="NY Background")
