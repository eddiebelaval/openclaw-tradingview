//@version=6
indicator('trend line [odnac]', overlay = true, max_labels_count = 500, max_lines_count = 500)

// ── MODE SELECTION ──
var string GRP0 = 'Mode'
modeOptions = input.string('Swing Confirm', 'Trendline Mode', group = GRP0,
     options = ['Swing Confirm', 'Pivot High/Low', 'Williams Fractal', 'Donchian'],
     tooltip = 'Swing Confirm: bearish/bullish confirmed swing points | Pivot High/Low: raw pivot values | Williams Fractal: 5-bar fractal pattern | Donchian: highest/lowest over N bars')

// ── SWING CONFIRM SETTINGS ──
var string GRP1 = 'Swing Confirm Settings'
leftBars  = input.int(20, 'Swing Left Bars',  minval = 1, group = GRP1, tooltip = 'Number of bars to the left to detect a pivot')
rightBars = input.int(7,  'Swing Right Bars', minval = 1, group = GRP1, tooltip = 'Number of bars to the right to confirm a pivot')

// ── PIVOT HIGH/LOW SETTINGS ──
var string GRP2 = 'Pivot High/Low Settings'
pivotLeft  = input.int(20, 'Pivot Left Bars',  minval = 1, group = GRP2, tooltip = 'Number of bars to the left to detect a pivot')
pivotRight = input.int(3,  'Pivot Right Bars', minval = 1, group = GRP2, tooltip = 'Number of bars to the right to confirm a pivot')

// ── WILLIAMS FRACTAL SETTINGS ──
var string GRP3 = 'Williams Fractal Settings'
fractalBars = input.int(2, 'Fractal Bars', minval = 2, group = GRP3, tooltip = 'Number of bars on each side for fractal detection (default 2 = classic 5-bar fractal)')

// ── DONCHIAN SETTINGS ──
var string GRP4 = 'Donchian Settings'
donchianLen = input.int(20, 'Donchian Length', minval = 1, group = GRP4, tooltip = 'Lookback period for highest high / lowest low')

// ── TRENDLINE SETTINGS ──
var string GRP5 = 'Trendline Settings'
showLabels    = input.bool(true,                        'Show Labels',          group = GRP5)
showHighLines = input.bool(true,                        'Show High Trendlines', group = GRP5)
showLowLines  = input.bool(true,                        'Show Low Trendlines',  group = GRP5)
highLineColor = input.color(color.new(color.green, 30), 'High Line Color',      group = GRP5)
lowLineColor  = input.color(color.new(color.red,   30), 'Low Line Color',       group = GRP5)

// CONFIRMATION FUNCTIONS
confirmBearish() =>
    float lastBearClose = na
    int renewCount = 0
    for i = 0 to rightBars - 1
        int j = rightBars - 1 - i
        if close[j] < open[j]
            if na(lastBearClose)
                renewCount := 1
                lastBearClose := close[j]
            else if close[j] < lastBearClose
                renewCount += 1
                lastBearClose := close[j]
    int consecutiveBears = 0
    int maxConsecutive = 0
    for i = 1 to rightBars
        if close[i] < open[i]
            consecutiveBears += 1
            maxConsecutive := math.max(maxConsecutive, consecutiveBears)
        else
            consecutiveBears := 0
    renewCount >= 3 or maxConsecutive >= 3

confirmBullish() =>
    float lastBullClose = na
    int renewCount = 0
    for i = 0 to rightBars - 1
        int j = rightBars - 1 - i
        if close[j] > open[j]
            if na(lastBullClose)
                renewCount := 1
                lastBullClose := close[j]
            else if close[j] > lastBullClose
                renewCount += 1
                lastBullClose := close[j]
    int consecutiveBulls = 0
    int maxConsecutive = 0
    for i = 1 to rightBars
        if close[i] > open[i]
            consecutiveBulls += 1
            maxConsecutive := math.max(maxConsecutive, consecutiveBulls)
        else
            consecutiveBulls := 0
    renewCount >= 3 or maxConsecutive >= 3

// Linear interpolation — calculate trendline price at a given bar
trendlinePrice(x1, y1, x2, y2, x) =>
    x2 == x1 ? float(na) : y1 + (y2 - y1) * (x - x1) / (x2 - x1)

// Check if candle wicks between two swing highs breach the trendline
isClearHigh(x1, y1, x2, y2) =>
    bool clear = true
    int span = x2 - x1 - 1
    if span > 0
        for i = 1 to span
            int   barIdx  = x2 - i
            float lineAt  = trendlinePrice(x1, y1, x2, y2, barIdx)
            float barHigh = high[bar_index - barIdx]
            if not na(lineAt) and barHigh >= lineAt
                clear := false
                break
    clear

// Check if candle wicks between two swing lows breach the trendline
isClearLow(x1, y1, x2, y2) =>
    bool clear = true
    int span = x2 - x1 - 1
    if span > 0
        for i = 1 to span
            int   barIdx = x2 - i
            float lineAt = trendlinePrice(x1, y1, x2, y2, barIdx)
            float barLow = low[bar_index - barIdx]
            if not na(lineAt) and barLow <= lineAt
                clear := false
                break
    clear

// ── PIVOT DETECTION per mode ──

// Swing Confirm
ph_swing = ta.pivothigh(high, leftBars,  rightBars)
pl_swing = ta.pivotlow(low,   leftBars,  rightBars)

// Pivot High/Low
ph_pivot = ta.pivothigh(high, pivotLeft, pivotRight)
pl_pivot = ta.pivotlow(low,   pivotLeft, pivotRight)

// Williams Fractal — high: center bar highest over fractalBars each side
// low: center bar lowest over fractalBars each side
fractalHigh() =>
    bool isHigh = true
    for i = 1 to fractalBars
        if high[fractalBars] <= high[fractalBars - i] or high[fractalBars] <= high[fractalBars + i]
            isHigh := false
            break
    isHigh

fractalLow() =>
    bool isLow = true
    for i = 1 to fractalBars
        if low[fractalBars] >= low[fractalBars - i] or low[fractalBars] >= low[fractalBars + i]
            isLow := false
            break
    isLow

ph_fractal = fractalHigh() ? high[fractalBars] : float(na)
pl_fractal = fractalLow()  ? low[fractalBars]  : float(na)

// Donchian — highest high / lowest low over N bars, confirmed 1 bar later
ph_donchian = ta.highestbars(high, donchianLen) == -1 ? high[1] : float(na)
pl_donchian = ta.lowestbars(low,  donchianLen) == -1 ? low[1]  : float(na)

// Select active pivot values by mode
ph_raw = switch modeOptions
    'Swing Confirm'    => ph_swing
    'Pivot High/Low'   => ph_pivot
    'Williams Fractal' => ph_fractal
    'Donchian'         => ph_donchian
    => float(na)

pl_raw = switch modeOptions
    'Swing Confirm'    => pl_swing
    'Pivot High/Low'   => pl_pivot
    'Williams Fractal' => pl_fractal
    'Donchian'         => pl_donchian
    => float(na)

isValidHigh = switch modeOptions
    'Swing Confirm' => not na(ph_raw) and confirmBearish()
    =>                 not na(ph_raw)

isValidLow = switch modeOptions
    'Swing Confirm' => not na(pl_raw) and confirmBullish()
    =>                 not na(pl_raw)

ph = ph_raw
pl = pl_raw

// Offset — how many bars back the pivot is confirmed
int confirmOffset = switch modeOptions
    'Swing Confirm'    => rightBars
    'Pivot High/Low'   => pivotRight
    'Williams Fractal' => fractalBars
    'Donchian'         => 1
    => 0

// SWING POINT & LINE tracking variables
var int   prevHighBar   = na
var float prevHighPrice = na
var int   prevLowBar    = na
var float prevLowPrice  = na

var line  activHighLine = na
var line  activLowLine  = na

int currentBar = bar_index - confirmOffset
colWhite = color.white

// ── Every bar: update active line endpoint or terminate on breakout ──

if showHighLines and not na(activHighLine)
    x1 = line.get_x1(activHighLine)
    y1 = line.get_y1(activHighLine)
    x2 = line.get_x2(activHighLine)
    y2 = line.get_y2(activHighLine)
    lineNow = trendlinePrice(x1, y1, x2, y2, bar_index)
    if not na(lineNow)
        if close > lineNow
            line.set_x2(activHighLine, bar_index)
            line.set_y2(activHighLine, lineNow)
            activHighLine := na
        else
            line.set_x2(activHighLine, bar_index)
            line.set_y2(activHighLine, lineNow)

if showLowLines and not na(activLowLine)
    x1 = line.get_x1(activLowLine)
    y1 = line.get_y1(activLowLine)
    x2 = line.get_x2(activLowLine)
    y2 = line.get_y2(activLowLine)
    lineNow = trendlinePrice(x1, y1, x2, y2, bar_index)
    if not na(lineNow)
        if close < lineNow
            line.set_x2(activLowLine, bar_index)
            line.set_y2(activLowLine, lineNow)
            activLowLine := na
        else
            line.set_x2(activLowLine, bar_index)
            line.set_y2(activLowLine, lineNow)

// ── On new swing point: draw trendline + label ──

if isValidHigh
    if showHighLines and not na(prevHighBar)
        if not na(activHighLine)
            line.delete(activHighLine)
            activHighLine := na
        // Draw only if swing high is descending and no wick breach between points
        if prevHighPrice > ph and isClearHigh(prevHighBar, prevHighPrice, currentBar, ph)
            activHighLine := line.new(
                 x1    = prevHighBar,
                 y1    = prevHighPrice,
                 x2    = currentBar,
                 y2    = ph,
                 xloc  = xloc.bar_index,
                 style = line.style_solid,
                 color = highLineColor
             )
    prevHighBar   := currentBar
    prevHighPrice := ph

    if showLabels
        label.new(
             x         = currentBar,
             y         = ph,
             text      = "◈",
             xloc      = xloc.bar_index,
             yloc      = yloc.abovebar,
             style     = label.style_label_down,
             color     = color(na),
             textcolor = color.new(colWhite, 50),
             size      = size.tiny,
             tooltip   = modeOptions + ' High'
         )

if isValidLow
    if showLowLines and not na(prevLowBar)
        if not na(activLowLine)
            line.delete(activLowLine)
            activLowLine := na
        // Draw only if swing low is ascending and no wick breach between points
        if prevLowPrice < pl and isClearLow(prevLowBar, prevLowPrice, currentBar, pl)
            activLowLine := line.new(
                 x1    = prevLowBar,
                 y1    = prevLowPrice,
                 x2    = currentBar,
                 y2    = pl,
                 xloc  = xloc.bar_index,
                 style = line.style_solid,
                 color = lowLineColor
             )
    prevLowBar   := currentBar
    prevLowPrice := pl

    if showLabels
        label.new(
             x         = currentBar,
             y         = pl,
             text      = "◈",
             xloc      = xloc.bar_index,
             yloc      = yloc.belowbar,
             style     = label.style_label_up,
             color     = color(na),
             textcolor = color.new(colWhite, 50),
             size      = size.tiny,
             tooltip   = modeOptions + ' Low'
         )
