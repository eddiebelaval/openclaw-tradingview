// Based on "Volume Weighted Trend [QuantAlgo]" by QuantAlgo
// Original: https://www.tradingview.com/script/hxhFpihu-Volume-Weighted-Trend-QuantAlgo/
// Modified by JaxonJackFX — converted to strategy with position sizing & risk management
// This source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/

//@version=6
strategy('Volume Weighted Trend Strategy [JaxonJackFX]',
     shorttitle='VWT-S',
     overlay=true,
     max_labels_count=500,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.1)

// ═══════════════════════════════════════════════════════════════════
//  CREDIT
//  Core logic adapted from "Volume Weighted Trend [QuantAlgo]"
//  by QuantAlgo on TradingView.
//  https://www.tradingview.com/script/hxhFpihu-Volume-Weighted-Trend-QuantAlgo/
//
//  HOW IT WORKS
//  A Volume Weighted Moving Average (VWMA) forms the central trend
//  baseline. ATR-based bands expand and contract around it. When
//  price closes above the upper band the trend turns bullish; below
//  the lower band it turns bearish. The indicator holds the last
//  confirmed direction until the opposite band is breached, keeping
//  signals clean and avoiding constant flip-flopping.
// ═══════════════════════════════════════════════════════════════════

// ── Inputs ──────────────────────────────────────────────────────
vwma_len    = input.int  (34,   'VWMA Length',       minval=5, maxval=500,
     tooltip='Period for the Volume Weighted Moving Average. Shorter = more responsive, longer = smoother.')
atr_mult    = input.float(1.5,  'ATR Multiplier',    minval=0.1, step=0.1,
     tooltip='Width of the volatility bands around the VWMA. Higher = wider bands, fewer signals.')
src         = input.source(close, 'Source')

bull_col    = input.color(#00ffaa, 'Bullish Color')
bear_col    = input.color(#ff0000, 'Bearish Color')
show_fills  = input.bool(true,  'Show Band Fills')
show_glow   = input.bool(true,  'Show Glow Effect')
show_bars   = input.bool(true,  'Color Bars')
show_labels = input.bool(true,  'Show Signal Labels')

// ── Strategy Settings ───────────────────────────────────────────
trade_dir   = input.string('Both', 'Trade Direction', options=['Both', 'Long Only', 'Short Only'])
use_sl      = input.bool(false, 'Use Stop Loss')
sl_mult     = input.float(2.0,  'Stop Loss ATR Multiplier', minval=0.1, step=0.1)
use_tp      = input.bool(false, 'Use Take Profit')
tp_mult     = input.float(3.0,  'Take Profit ATR Multiplier', minval=0.1, step=0.1)

// ── Core Calculation ────────────────────────────────────────────
basis       = ta.vwma(src, vwma_len)
atr_val     = ta.atr(vwma_len)
upper       = basis + atr_val * atr_mult
lower       = basis - atr_val * atr_mult

var int trend = 0
if src > upper
    trend := 1
else if src < lower
    trend := -1

bull_signal = trend == 1  and trend[1] != 1
bear_signal = trend == -1 and trend[1] != -1

t_col = trend == 1 ? bull_col : bear_col

// ── Strategy Entries & Exits ─────────────────────────────────────
if bull_signal
    if trade_dir != 'Short Only'
        strategy.entry('Long', strategy.long)
    if trade_dir == 'Both'
        strategy.close('Short')

if bear_signal
    if trade_dir != 'Long Only'
        strategy.entry('Short', strategy.short)
    if trade_dir == 'Both'
        strategy.close('Long')

// Stop Loss
if use_sl and strategy.position_size > 0
    strategy.exit('Long SL/TP', 'Long',
         stop  = use_sl ? strategy.position_avg_price - atr_val * sl_mult : na,
         limit = use_tp ? strategy.position_avg_price + atr_val * tp_mult : na)

if use_sl and strategy.position_size < 0
    strategy.exit('Short SL/TP', 'Short',
         stop  = use_sl ? strategy.position_avg_price + atr_val * sl_mult : na,
         limit = use_tp ? strategy.position_avg_price - atr_val * tp_mult : na)

// ── Plots ───────────────────────────────────────────────────────
plot(show_glow ? basis : na, 'Glow 1', color.new(t_col, 85), 10)
plot(show_glow ? basis : na, 'Glow 2', color.new(t_col, 60),  6)
vwma_p = plot(basis, 'VWMA', color.new(t_col, 0), 2)

upper_p = plot(upper, 'Upper Band', color=color.new(t_col, 88))
upper_m = plot(math.avg(upper, basis), 'Upper Mid', color=color.new(t_col, 95))
lower_p = plot(lower, 'Lower Band', color=color.new(t_col, 88))
lower_m = plot(math.avg(lower, basis), 'Lower Mid', color=color.new(t_col, 95))

fill_col_o = show_fills ? color.new(t_col, 90) : color(na)
fill_col_i = show_fills ? color.new(t_col, 78) : color(na)
fill(upper_p, upper_m, fill_col_o, 'Upper Outer')
fill(upper_m, vwma_p,  fill_col_i, 'Upper Inner')
fill(lower_p, lower_m, fill_col_o, 'Lower Outer')
fill(lower_m, vwma_p,  fill_col_i, 'Lower Inner')

bar_c = trend == 1 ? color.new(bull_col, 30) : color.new(bear_col, 30)
barcolor(show_bars ? bar_c : color(na), title='Bar Color')

plotshape(bull_signal, 'Bull Signal', shape.triangleup,
     location.belowbar, bull_col, size=size.small)
plotshape(bear_signal, 'Bear Signal', shape.triangledown,
     location.abovebar, bear_col, size=size.small)

if show_labels and bull_signal
    label.new(bar_index, low * 0.999, '▲ LONG\n' + str.tostring(close, format.mintick),
         color=color.new(bull_col, 15), textcolor=color.white,
         style=label.style_label_up, size=size.small)

if show_labels and bear_signal
    label.new(bar_index, high * 1.001, '▼ SHORT\n' + str.tostring(close, format.mintick),
         color=color.new(bear_col, 15), textcolor=color.white,
         style=label.style_label_down, size=size.small)

// ── Alerts ──────────────────────────────────────────────────────
alertcondition(bull_signal, title='VWT Bullish',
     message='VWT: BULLISH on {{exchange}}:{{ticker}} | {{interval}} | {{close}}')
alertcondition(bear_signal, title='VWT Bearish',
     message='VWT: BEARISH on {{exchange}}:{{ticker}} | {{interval}} | {{close}}')
alertcondition(bull_signal or bear_signal, title='VWT Trend Change',
     message='VWT: Trend changed on {{exchange}}:{{ticker}} | {{interval}} | {{close}}')
