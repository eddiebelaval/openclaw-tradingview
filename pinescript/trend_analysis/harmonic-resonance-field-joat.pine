//@version=6
indicator("Harmonic Resonance Field [JOAT]", "HRF [JOAT]", overlay=true, max_lines_count=500, max_boxes_count=300, max_labels_count=200)

// ══════════════════════════════════════════════════════════════════════════════
// HARMONIC RESONANCE FIELD
// Institutional-grade range detection with harmonic frequency analysis
// Features: Multi-harmonic bands, Magnetic field visualization, Resonance detection
// ══════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────
// COLOR PALETTE - Harmonic Resonance Theme
// ─────────────────────────────────────────────────────────────────────────────
// Primary harmonic colors
var color HRF_HARMONIC_CYAN      = #00ffff  // Primary harmonic
var color HRF_HARMONIC_MAGENTA   = #ff00ff  // Secondary harmonic
var color HRF_HARMONIC_GOLD      = #ffd700  // Tertiary harmonic
var color HRF_HARMONIC_VIOLET    = #9945ff  // Resonance color

// Band colors
var color HRF_BAND_UPPER         = #c792ea  // Upper band
var color HRF_BAND_LOWER         = #82aaff  // Lower band
var color HRF_BAND_EXTREME_UP    = #ff0080  // Extreme upper
var color HRF_BAND_EXTREME_DOWN  = #00ff88  // Extreme lower

// Trend colors
var color HRF_TREND_BULL         = #00ffcc  // Bullish trend
var color HRF_TREND_BEAR         = #ff4466  // Bearish trend
var color HRF_TREND_NEUTRAL      = #4a5568  // Neutral

// Reversal colors
var color HRF_REVERSAL_BULL      = #00ffd5  // Bull reversal
var color HRF_REVERSAL_BEAR      = #ff2d55  // Bear reversal
var color HRF_MEAN_LINE          = #ffcb6b  // Mean line

// Field colors
var color HRF_FIELD_POSITIVE     = #00ff88  // Positive field
var color HRF_FIELD_NEGATIVE     = #ff0066  // Negative field
var color HRF_FIELD_NEUTRAL      = #5d6d7e  // Neutral field

// Special effect colors
var color HRF_RESONANCE_GLOW     = #00ffff  // Resonance glow
var color HRF_MAGNETIC_NORTH     = #ff6b35  // Magnetic north
var color HRF_MAGNETIC_SOUTH     = #1e90ff  // Magnetic south

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────
string grpRange = "🎯 Range Detection"
int rangeLookback     = input.int(200, "Range Lookback", minval=50, maxval=500, group=grpRange)
int adxLength         = input.int(14, "ADX Length", minval=5, maxval=30, group=grpRange)
float adxThreshold    = input.float(25, "ADX Trend Threshold", minval=15, maxval=50, group=grpRange)
bool showRangeBox     = input.bool(true, "Show Range Box", group=grpRange)
bool showDynamicRange = input.bool(true, "Show Dynamic Range Levels", group=grpRange)
int dynamicRangePeriod = input.int(50, "Dynamic Range Period", minval=20, maxval=200, group=grpRange)

string grpBands = "🌐 Harmonic Band Configuration"
string bandStyle      = input.string("ATR", "Band Style", options=["ATR", "Percentage", "Standard Dev", "Harmonic"], group=grpBands)
int bandLength        = input.int(20, "Band Length", minval=5, maxval=100, group=grpBands)
float bandMultiplier  = input.float(2.0, "Band Multiplier", minval=0.5, maxval=5.0, step=0.1, group=grpBands)
bool showBands        = input.bool(true, "Show Bands", group=grpBands)
bool showHarmonicBands = input.bool(true, "Show Harmonic Bands", group=grpBands)
float harmonicRatio1  = input.float(0.618, "Harmonic Ratio 1 (Golden)", minval=0.1, maxval=1.0, step=0.01, group=grpBands)
float harmonicRatio2  = input.float(0.786, "Harmonic Ratio 2", minval=0.1, maxval=1.0, step=0.01, group=grpBands)
float harmonicRatio3  = input.float(1.272, "Harmonic Ratio 3 (Extension)", minval=1.0, maxval=2.0, step=0.01, group=grpBands)

string grpRenko = "🧱 Renko-Style Trend"
string brickStyle     = input.string("ATR", "Brick Size Style", options=["ATR", "Percentage", "Static"], group=grpRenko)
int brickAtrLength    = input.int(14, "Brick ATR Length", minval=5, maxval=50, group=grpRenko)
float brickPercent    = input.float(1.0, "Brick Percentage", minval=0.1, maxval=5.0, step=0.1, group=grpRenko)
float brickStatic     = input.float(10, "Static Brick Size", minval=0.1, group=grpRenko)
int renkoSmoothing    = input.int(3, "Renko Smoothing", minval=1, maxval=10, group=grpRenko)
bool showRenkoLevels  = input.bool(true, "Show Renko Levels", group=grpRenko)

string grpReversal = "🔄 Reversal Detection"
bool showReversals    = input.bool(true, "Show Reversal Signals", group=grpReversal)
float reversalThresh  = input.float(0.8, "Reversal Threshold", minval=0.5, maxval=1.0, step=0.05, group=grpReversal)
bool showMeanRev      = input.bool(true, "Show Mean Reversion Points", group=grpReversal)
bool showResonancePoints = input.bool(true, "Show Resonance Points", group=grpReversal)
float resonanceThreshold = input.float(0.9, "Resonance Threshold", minval=0.7, maxval=1.0, step=0.05, group=grpReversal)

string grpMagnetic = "🧲 Magnetic Field"
bool showMagneticField = input.bool(true, "Show Magnetic Field", group=grpMagnetic)
int magneticStrength  = input.int(3, "Magnetic Strength", minval=1, maxval=5, group=grpMagnetic)
bool showFieldLines   = input.bool(true, "Show Field Lines", group=grpMagnetic)
int fieldLineCount    = input.int(5, "Field Line Count", minval=3, maxval=10, group=grpMagnetic)

string grpVisual = "✨ Visual Effects"
bool colorCandles     = input.bool(true, "Color Candles by Trend", group=grpVisual)
bool showGradient     = input.bool(true, "Show Gradient Fill", group=grpVisual)
bool showDashboard    = input.bool(true, "Show Dashboard", group=grpVisual)
bool showGlowEffect   = input.bool(true, "Show Glow Effects", group=grpVisual)
bool showPulseEffect  = input.bool(true, "Show Pulse Animation", group=grpVisual)
string colorScheme    = input.string("Harmonic", "Color Scheme", options=["Harmonic", "Neon", "Aurora", "Monochrome"], group=grpVisual)

// ─────────────────────────────────────────────────────────────────────────────
// TYPE DEFINITIONS
// ─────────────────────────────────────────────────────────────────────────────
type RenkoState
    float level
    int direction
    int brickCount
    float brickSize
    float prevLevel
    int flipCount

type RangeState
    float rangeHigh
    float rangeLow
    float rangeMid
    bool isRanging
    int rangeDuration
    float dynamicHigh
    float dynamicLow
    box rangeBox

type ReversalSignal
    int barIdx
    float price
    bool isBullish
    float strength
    label marker
    line trendLine

type HarmonicBand
    float upper
    float lower
    float ratio
    color bandColor
    line upperLine
    line lowerLine

type MagneticField
    float northPole
    float southPole
    float fieldStrength
    array<line> fieldLines
    array<label> fieldLabels

type ResonancePoint
    int barIdx
    float price
    float frequency
    float amplitude
    label marker
    box resonanceBox

// ─────────────────────────────────────────────────────────────────────────────
// CORE CALCULATIONS
// ─────────────────────────────────────────────────────────────────────────────
atrVal = ta.atr(brickAtrLength)
volAvg = ta.sma(volume, 20)

// Initialize arrays and variables
var array<ReversalSignal> reversals = array.new<ReversalSignal>()
var array<HarmonicBand> harmonicBands = array.new<HarmonicBand>()
var array<ResonancePoint> resonancePoints = array.new<ResonancePoint>()
var MagneticField magField = MagneticField.new(high, low, 0, array.new<line>(), array.new<label>())
var RenkoState renko = RenkoState.new(close, 0, 0, atrVal, close, 0)
var RangeState rangeState = RangeState.new(high, low, hl2, false, 0, high, low, na)

// Harmonic frequency calculation
harmonicPhase = (time / 100000) % (2 * math.pi)
harmonicAmplitude = math.sin(harmonicPhase) * 0.5 + 0.5

getBrickSize() =>
    float size = 0.0
    switch brickStyle
        "ATR" => size := atrVal
        "Percentage" => size := close * brickPercent / 100
        "Static" => size := brickStatic
    size

getBandWidth() =>
    float width = 0.0
    switch bandStyle
        "ATR" => width := ta.atr(bandLength) * bandMultiplier
        "Percentage" => width := close * bandMultiplier / 100
        "Standard Dev" => width := ta.stdev(close, bandLength) * bandMultiplier
        "Harmonic" => 
            float baseWidth = ta.atr(bandLength)
            float harmonicWidth = baseWidth * (1 + harmonicAmplitude * 0.5)
            width := harmonicWidth * bandMultiplier
    width

// Harmonic band calculations
calculateHarmonicBands(float basis, float baseWidth) =>
    array<HarmonicBand> bands = array.new<HarmonicBand>()
    
    // Golden ratio band (0.618)
    float h1Upper = basis + baseWidth * harmonicRatio1
    float h1Lower = basis - baseWidth * harmonicRatio1
    HarmonicBand band1 = HarmonicBand.new(h1Upper, h1Lower, harmonicRatio1, HRF_HARMONIC_GOLD, na, na)
    array.push(bands, band1)
    
    // Secondary harmonic band (0.786)
    float h2Upper = basis + baseWidth * harmonicRatio2
    float h2Lower = basis - baseWidth * harmonicRatio2
    HarmonicBand band2 = HarmonicBand.new(h2Upper, h2Lower, harmonicRatio2, HRF_HARMONIC_CYAN, na, na)
    array.push(bands, band2)
    
    // Extension band (1.272)
    float h3Upper = basis + baseWidth * harmonicRatio3
    float h3Lower = basis - baseWidth * harmonicRatio3
    HarmonicBand band3 = HarmonicBand.new(h3Upper, h3Lower, harmonicRatio3, HRF_HARMONIC_MAGENTA, na, na)
    array.push(bands, band3)
    
    bands

// Magnetic field calculation
calculateMagneticField() =>
    northPole = ta.highest(high, dynamicRangePeriod)
    southPole = ta.lowest(low, dynamicRangePeriod)
    
    // Field strength based on price position
    pricePos = (close - southPole) / (northPole - southPole)
    fieldStrength = math.abs(pricePos - 0.5) * 2 * magneticStrength
    
    [northPole, southPole, fieldStrength]

[magNorth, magSouth, fieldStrength] = calculateMagneticField()
magField.northPole := magNorth
magField.southPole := magSouth
magField.fieldStrength := fieldStrength

// Resonance detection - pre-compute ta.* at global scope for consistency
float _resPriceChange = ta.change(close)
float _resPriceChangeSmooth = ta.sma(_resPriceChange, 5)
bool _resCrossOver = ta.crossover(_resPriceChangeSmooth, 0)
bool _resCrossUnder = ta.crossunder(_resPriceChangeSmooth, 0)
bool _resZeroCross = _resCrossOver or _resCrossUnder
float _resAmplitude = ta.stdev(close, 10) / atrVal
float _resBarsSince = ta.barssince(_resZeroCross[1])

bool isResonance = _resAmplitude > resonanceThreshold and _resZeroCross
float resFrequency = isResonance and _resBarsSince > 0 ? 1 / _resBarsSince : 0.0
float resAmplitude = _resAmplitude

// ─────────────────────────────────────────────────────────────────────────────
// ADX CALCULATION FOR REGIME
// ─────────────────────────────────────────────────────────────────────────────
calcADX(int len) =>
    up = ta.change(high)
    down = -ta.change(low)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    trueRange = ta.rma(ta.tr, len)
    plusDI = 100 * ta.rma(plusDM, len) / trueRange
    minusDI = 100 * ta.rma(minusDM, len) / trueRange
    dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
    adx = ta.rma(dx, len)
    [adx, plusDI, minusDI]

[adx, plusDI, minusDI] = calcADX(adxLength)
isTrending = adx > adxThreshold
trendDirection = plusDI > minusDI ? 1 : -1
adxStrength = math.min(100, adx * 2)

// ─────────────────────────────────────────────────────────────────────────────
// RENKO-STYLE TREND CALCULATION
// ─────────────────────────────────────────────────────────────────────────────
brickSize = getBrickSize()
renko.brickSize := brickSize

renkoUpdate() =>
    int newDirection = renko.direction
    float newLevel = renko.level
    int bricks = 0
    bool flipped = false
    
    if renko.direction >= 0
        if close >= renko.level + brickSize
            bricksUp = math.floor((close - renko.level) / brickSize)
            newLevel := renko.level + bricksUp * brickSize
            newDirection := 1
            bricks := int(bricksUp)
        else if close <= renko.level - brickSize * 2
            bricksDown = math.floor((renko.level - close) / brickSize)
            newLevel := renko.level - bricksDown * brickSize
            newDirection := -1
            bricks := -int(bricksDown)
            flipped := true
    else
        if close <= renko.level - brickSize
            bricksDown = math.floor((renko.level - close) / brickSize)
            newLevel := renko.level - bricksDown * brickSize
            newDirection := -1
            bricks := -int(bricksDown)
        else if close >= renko.level + brickSize * 2
            bricksUp = math.floor((close - renko.level) / brickSize)
            newLevel := renko.level + bricksUp * brickSize
            newDirection := 1
            bricks := int(bricksUp)
            flipped := true
    
    [newDirection, newLevel, bricks, flipped]

[newRenkoDir, newRenkoLevel, brickChange, renkoFlipped] = renkoUpdate()

if newRenkoDir != renko.direction or newRenkoLevel != renko.level
    renko.prevLevel := renko.level
    renko.direction := newRenkoDir
    renko.level := newRenkoLevel
    renko.brickCount += math.abs(brickChange)
    if renkoFlipped
        renko.flipCount += 1

renkoSmoothed = ta.rma(renko.level, renkoSmoothing)
renkoMomentum = ta.change(renkoSmoothed, 3)

// ─────────────────────────────────────────────────────────────────────────────
// RANGE DETECTION
// ─────────────────────────────────────────────────────────────────────────────
rangeHighest = ta.highest(high, rangeLookback)
rangeLowest = ta.lowest(low, rangeLookback)
rangeMidpoint = (rangeHighest + rangeLowest) / 2

// Dynamic range levels
dynamicHigh = ta.highest(high, dynamicRangePeriod)
dynamicLow = ta.lowest(low, dynamicRangePeriod)
dynamicMid = (dynamicHigh + dynamicLow) / 2

rangeState.rangeHigh := rangeHighest
rangeState.rangeLow := rangeLowest
rangeState.rangeMid := rangeMidpoint
rangeState.dynamicHigh := dynamicHigh
rangeState.dynamicLow := dynamicLow
rangeState.isRanging := not isTrending

if rangeState.isRanging
    rangeState.rangeDuration += 1
else
    rangeState.rangeDuration := 0

// Range quality score
rangeWidth = rangeHighest - rangeLowest
rangeQuality = 100 - (ta.stdev(close, rangeLookback) / rangeWidth * 100)

// ─────────────────────────────────────────────────────────────────────────────
// BAND CALCULATIONS
// ─────────────────────────────────────────────────────────────────────────────
bandWidth = getBandWidth()
basis = ta.sma(close, bandLength)
upperBand = basis + bandWidth
lowerBand = basis - bandWidth

// Harmonic band levels
harmonic1Upper = basis + bandWidth * harmonicRatio1
harmonic1Lower = basis - bandWidth * harmonicRatio1
harmonic2Upper = basis + bandWidth * harmonicRatio2
harmonic2Lower = basis - bandWidth * harmonicRatio2
harmonic3Upper = basis + bandWidth * harmonicRatio3
harmonic3Lower = basis - bandWidth * harmonicRatio3

pricePosition = (close - lowerBand) / (upperBand - lowerBand)
pricePositionClamped = math.max(0, math.min(1, pricePosition))

// Harmonic zone detection
inHarmonic1Zone = close >= harmonic1Lower and close <= harmonic1Upper
inHarmonic2Zone = close >= harmonic2Lower and close <= harmonic2Upper
inExtensionZone = close >= harmonic3Upper or close <= harmonic3Lower

// ─────────────────────────────────────────────────────────────────────────────
// REVERSAL DETECTION
// ─────────────────────────────────────────────────────────────────────────────
detectReversal() =>
    bool bullReversal = false
    bool bearReversal = false
    float strength = 0.0
    
    atExtreme = pricePositionClamped > reversalThresh or pricePositionClamped < (1 - reversalThresh)
    
    // Enhanced reversal conditions with volume confirmation
    volSpike = volume > volAvg * 1.5
    
    bullCondition = pricePositionClamped < (1 - reversalThresh) and 
                   close > open and 
                   close[1] < open[1] and
                   low < lowerBand and
                   (volSpike or inExtensionZone)
    
    bearCondition = pricePositionClamped > reversalThresh and 
                   close < open and 
                   close[1] > open[1] and
                   high > upperBand and
                   (volSpike or inExtensionZone)
    
    if bullCondition
        bullReversal := true
        strength := (lowerBand - low) / bandWidth * 100
        if volSpike
            strength := strength * 1.5
    
    if bearCondition
        bearReversal := true
        strength := (high - upperBand) / bandWidth * 100
        if volSpike
            strength := strength * 1.5
    
    [bullReversal, bearReversal, strength]

[bullRev, bearRev, revStrength] = detectReversal()

if showReversals and (bullRev or bearRev)
    ReversalSignal rs = ReversalSignal.new(bar_index, bullRev ? low : high, bullRev, revStrength, na, na)
    array.push(reversals, rs)
    if array.size(reversals) > 50
        oldRev = array.shift(reversals)
        if not na(oldRev.marker)
            label.delete(oldRev.marker)
        if not na(oldRev.trendLine)
            line.delete(oldRev.trendLine)

// Resonance point detection
if showResonancePoints and isResonance
    ResonancePoint rp = ResonancePoint.new(bar_index, close, resFrequency, resAmplitude, na, na)
    array.push(resonancePoints, rp)
    if array.size(resonancePoints) > 20
        oldRes = array.shift(resonancePoints)
        if not na(oldRes.marker)
            label.delete(oldRes.marker)
        if not na(oldRes.resonanceBox)
            box.delete(oldRes.resonanceBox)

// ─────────────────────────────────────────────────────────────────────────────
// MEAN REVERSION DETECTION
// ─────────────────────────────────────────────────────────────────────────────
meanReversionBull = close[1] < rangeMidpoint and close > rangeMidpoint and rangeState.isRanging
meanReversionBear = close[1] > rangeMidpoint and close < rangeMidpoint and rangeState.isRanging

distanceFromMean = math.abs(close - rangeMidpoint) / (rangeState.rangeHigh - rangeState.rangeLow) * 100

// ─────────────────────────────────────────────────────────────────────────────
// PLOTTING - HARMONIC BANDS
// ─────────────────────────────────────────────────────────────────────────────
// Main basis line with glow effect
basisPlot = plot(showBands ? basis : na, "Basis", color=HRF_MEAN_LINE, linewidth=2)
plot(showBands and showGlowEffect ? basis : na, "Basis Glow", color=color.new(HRF_MEAN_LINE, 70), linewidth=5)

// Main bands
upperPlot = plot(showBands ? upperBand : na, "Upper Band", color=HRF_BAND_UPPER, linewidth=2)
lowerPlot = plot(showBands ? lowerBand : na, "Lower Band", color=HRF_BAND_LOWER, linewidth=2)

// Harmonic bands (Golden ratio, 0.786, Extension)
h1UpperPlot = plot(showHarmonicBands ? harmonic1Upper : na, "Harmonic 1 Upper", color=color.new(HRF_HARMONIC_GOLD, 50), linewidth=1, style=plot.style_line)
h1LowerPlot = plot(showHarmonicBands ? harmonic1Lower : na, "Harmonic 1 Lower", color=color.new(HRF_HARMONIC_GOLD, 50), linewidth=1, style=plot.style_line)

h2UpperPlot = plot(showHarmonicBands ? harmonic2Upper : na, "Harmonic 2 Upper", color=color.new(HRF_HARMONIC_CYAN, 60), linewidth=1, style=plot.style_line)
h2LowerPlot = plot(showHarmonicBands ? harmonic2Lower : na, "Harmonic 2 Lower", color=color.new(HRF_HARMONIC_CYAN, 60), linewidth=1, style=plot.style_line)

h3UpperPlot = plot(showHarmonicBands ? harmonic3Upper : na, "Extension Upper", color=color.new(HRF_HARMONIC_MAGENTA, 40), linewidth=1)
h3LowerPlot = plot(showHarmonicBands ? harmonic3Lower : na, "Extension Lower", color=color.new(HRF_HARMONIC_MAGENTA, 40), linewidth=1)

// Dynamic gradient fill based on price position and harmonic phase
fillColor = showGradient ? 
           color.from_gradient(pricePositionClamped, 0, 1, 
                              color.new(HRF_BAND_LOWER, 85), 
                              color.new(HRF_BAND_UPPER, 85)) : 
           color.new(HRF_TREND_NEUTRAL, 88)

fill(upperPlot, lowerPlot, color=fillColor)

// Harmonic zone fills
fill(h1UpperPlot, h1LowerPlot, color=showHarmonicBands ? color.new(HRF_HARMONIC_GOLD, 92) : na)
fill(h3UpperPlot, upperPlot, color=showHarmonicBands ? color.new(HRF_BAND_EXTREME_UP, 90) : na)
fill(lowerPlot, h3LowerPlot, color=showHarmonicBands ? color.new(HRF_BAND_EXTREME_DOWN, 90) : na)

// ─────────────────────────────────────────────────────────────────────────────
// PLOTTING - RENKO TREND LINE
// ─────────────────────────────────────────────────────────────────────────────
renkoColor = renko.direction > 0 ? HRF_TREND_BULL : HRF_TREND_BEAR
renkoGlowColor = showGlowEffect ? color.new(renkoColor, 70) : na

plot(renkoSmoothed, "Renko Trend", color=renkoColor, linewidth=3, style=plot.style_stepline)
plot(showGlowEffect ? renkoSmoothed : na, "Renko Glow", color=renkoGlowColor, linewidth=7, style=plot.style_stepline)

// Renko levels
if showRenkoLevels and barstate.islast
    line.new(bar_index - 20, renko.level, bar_index, renko.level, color=renkoColor, width=2, style=line.style_dashed)
    if not na(renko.prevLevel)
        line.new(bar_index - 20, renko.prevLevel, bar_index, renko.prevLevel, color=color.new(renkoColor, 60), width=1, style=line.style_dotted)

// ─────────────────────────────────────────────────────────────────────────────
// PLOTTING - MAGNETIC FIELD
// ─────────────────────────────────────────────────────────────────────────────
if showMagneticField and barstate.islast
    // Clear old field lines
    for ln in magField.fieldLines
        line.delete(ln)
    array.clear(magField.fieldLines)
    
    for lbl in magField.fieldLabels
        label.delete(lbl)
    array.clear(magField.fieldLabels)
    
    // Draw magnetic poles
    northLabel = label.new(bar_index + 5, magNorth, "🧲 N", color=HRF_MAGNETIC_NORTH, textcolor=color.white, size=size.small)
    southLabel = label.new(bar_index + 5, magSouth, "🧲 S", color=HRF_MAGNETIC_SOUTH, textcolor=color.white, size=size.small)
    array.push(magField.fieldLabels, northLabel)
    array.push(magField.fieldLabels, southLabel)
    
    // Draw field lines
    if showFieldLines
        fieldRange = magNorth - magSouth
        for i = 1 to fieldLineCount
            fieldY = magSouth + fieldRange * i / (fieldLineCount + 1)
            fieldAlpha = 100 - (fieldStrength * 20)
            fieldCol = close > fieldY ? color.new(HRF_FIELD_POSITIVE, fieldAlpha) : color.new(HRF_FIELD_NEGATIVE, fieldAlpha)
            
            fieldLine = line.new(bar_index - dynamicRangePeriod, fieldY, bar_index, fieldY, color=fieldCol, width=1, style=line.style_dotted)
            array.push(magField.fieldLines, fieldLine)

// ─────────────────────────────────────────────────────────────────────────────
// PLOTTING - DYNAMIC RANGE LEVELS
// ─────────────────────────────────────────────────────────────────────────────
plot(showDynamicRange ? dynamicHigh : na, "Dynamic High", color=color.new(HRF_BAND_EXTREME_UP, 30), linewidth=2, style=plot.style_stepline)
plot(showDynamicRange ? dynamicLow : na, "Dynamic Low", color=color.new(HRF_BAND_EXTREME_DOWN, 30), linewidth=2, style=plot.style_stepline)
plot(showDynamicRange ? dynamicMid : na, "Dynamic Mid", color=color.new(HRF_TREND_NEUTRAL, 50), linewidth=1, style=plot.style_stepline)

// ─────────────────────────────────────────────────────────────────────────────
// PLOTTING - RANGE BOX
// ─────────────────────────────────────────────────────────────────────────────
var box rangeBox = na

if showRangeBox and rangeState.isRanging
    rangeQualityColor = color.from_gradient(rangeQuality, 0, 100, 
                                           color.new(HRF_TREND_NEUTRAL, 95), 
                                           color.new(HRF_HARMONIC_VIOLET, 90))
    if na(rangeBox)
        rangeBox := box.new(bar_index - math.min(rangeState.rangeDuration, 500), rangeState.rangeHigh, 
                           bar_index, rangeState.rangeLow,
                           border_color=color.new(HRF_HARMONIC_VIOLET, 60),
                           bgcolor=rangeQualityColor,
                           border_width=1, border_style=line.style_dotted,
                           text="RANGE", text_color=HRF_HARMONIC_VIOLET, text_size=size.tiny)
    else
        box.set_right(rangeBox, bar_index)
        box.set_top(rangeBox, rangeState.rangeHigh)
        box.set_bottom(rangeBox, rangeState.rangeLow)
        box.set_bgcolor(rangeBox, rangeQualityColor)
else if not rangeState.isRanging and not na(rangeBox)
    box.delete(rangeBox)
    rangeBox := na

// ─────────────────────────────────────────────────────────────────────────────
// PLOTTING - CANDLE COLORING
// ─────────────────────────────────────────────────────────────────────────────
getCandleColor() =>
    color result = na
    
    // Apply color scheme
    color bullColor = switch colorScheme
        "Neon" => HRF_HARMONIC_CYAN
        "Aurora" => HRF_FIELD_POSITIVE
        "Monochrome" => color.new(color.white, 20)
        => HRF_TREND_BULL
    
    color bearColor = switch colorScheme
        "Neon" => HRF_HARMONIC_MAGENTA
        "Aurora" => HRF_FIELD_NEGATIVE
        "Monochrome" => color.new(color.gray, 20)
        => HRF_TREND_BEAR
    
    if isTrending
        if renko.direction > 0
            intensity = math.min(100, adxStrength)
            result := color.from_gradient(intensity, 0, 100, 
                                         color.new(bullColor, 50), 
                                         bullColor)
        else
            intensity = math.min(100, adxStrength)
            result := color.from_gradient(intensity, 0, 100, 
                                         color.new(bearColor, 50), 
                                         bearColor)
    else
        // Harmonic coloring in range
        if inHarmonic1Zone
            result := HRF_HARMONIC_GOLD
        else if inExtensionZone
            result := close > basis ? HRF_BAND_EXTREME_UP : HRF_BAND_EXTREME_DOWN
        else
            result := color.from_gradient(pricePositionClamped, 0, 1, 
                                         HRF_BAND_LOWER, HRF_BAND_UPPER)
    
    // Apply pulse effect
    if showPulseEffect
        pulseAlpha = math.sin(time / 1000) * 15 + 85
        result := color.new(result, 100 - pulseAlpha)
    
    result

candleCol = getCandleColor()
barcolor(colorCandles ? candleCol : na)

// ─────────────────────────────────────────────────────────────────────────────
// PLOTTING - REVERSAL SIGNALS
// ─────────────────────────────────────────────────────────────────────────────
// Reversal signals - text labels
plotshape(showReversals and bullRev, "Bull Reversal", shape.labelup, location.belowbar, 
         HRF_REVERSAL_BULL, text="REVERSAL", textcolor=color.white, size=size.tiny)
plotshape(showReversals and bearRev, "Bear Reversal", shape.labeldown, location.abovebar, 
         HRF_REVERSAL_BEAR, text="REVERSAL", textcolor=color.white, size=size.tiny)

// Mean Reversion signals - text labels
plotshape(showMeanRev and meanReversionBull, "Mean Rev Bull", shape.labelup, location.belowbar, 
         color.new(HRF_MEAN_LINE, 10), text="MEAN REV", textcolor=color.white, size=size.tiny)
plotshape(showMeanRev and meanReversionBear, "Mean Rev Bear", shape.labeldown, location.abovebar, 
         color.new(HRF_MEAN_LINE, 10), text="MEAN REV", textcolor=color.white, size=size.tiny)

// Resonance signals - text labels (no emoji)
if showResonancePoints and isResonance
    resonanceLabel = label.new(bar_index, close, "RESONANCE", color=color.new(HRF_RESONANCE_GLOW, 20), textcolor=color.white, size=size.tiny, style=label.style_label_center)
    resonanceBox = box.new(bar_index - 1, close + atrVal * 0.5, bar_index + 1, close - atrVal * 0.5, 
                          bgcolor=color.new(HRF_RESONANCE_GLOW, 90), border_color=HRF_RESONANCE_GLOW)
    
    // Update last resonance point
    if array.size(resonancePoints) > 0
        lastRes = array.get(resonancePoints, array.size(resonancePoints) - 1)
        lastRes.marker := resonanceLabel
        lastRes.resonanceBox := resonanceBox

// ─────────────────────────────────────────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────────────────────────────────────────
if showDashboard
    var table dashboard = table.new(position.top_right, 3, 13, 
                                   bgcolor=color.new(#0a0a1a, 0), 
                                   border_color=color.new(HRF_HARMONIC_VIOLET, 30),
                                   border_width=1,
                                   frame_color=color.new(HRF_HARMONIC_VIOLET, 40),
                                   frame_width=2)
    
    if barstate.islast
        regimeText = isTrending ? "TRENDING" : "RANGING"
        regimeCol = isTrending ? (trendDirection > 0 ? HRF_TREND_BULL : HRF_TREND_BEAR) : HRF_TREND_NEUTRAL
        
        trendText = renko.direction > 0 ? "▲ BULLISH" : "▼ BEARISH"
        trendCol = renko.direction > 0 ? HRF_TREND_BULL : HRF_TREND_BEAR
        
        positionText = pricePositionClamped > 0.8 ? "UPPER EXTREME" : pricePositionClamped < 0.2 ? "LOWER EXTREME" : pricePositionClamped > 0.5 ? "UPPER HALF" : "LOWER HALF"
        positionCol = color.from_gradient(pricePositionClamped, 0, 1, HRF_BAND_LOWER, HRF_BAND_UPPER)
        
        harmonicText = inHarmonic1Zone ? "GOLDEN RATIO" : inExtensionZone ? "EXTENSION" : "NORMAL"
        harmonicCol = inHarmonic1Zone ? HRF_HARMONIC_GOLD : inExtensionZone ? HRF_HARMONIC_MAGENTA : #a8b5c4
        
        fieldText = fieldStrength > 2 ? "STRONG" : fieldStrength > 1 ? "MODERATE" : "WEAK"
        fieldCol = fieldStrength > 2 ? HRF_FIELD_POSITIVE : fieldStrength > 1 ? HRF_FIELD_NEUTRAL : #a8b5c4
        
        // ADX strength bar
        int adxBars = math.round(math.min(adx, 50) / 5)
        string adxBar = ""
        for i = 0 to 9
            adxBar += i < adxBars ? "█" : "░"
        
        // Band position bar
        int posBars = math.round(pricePositionClamped * 10)
        string posBar = ""
        for i = 0 to 9
            posBar += i < posBars ? "█" : "░"
        
        // Title row
        table.cell(dashboard, 0, 0, "  HARMONIC RESONANCE FIELD  ", text_color=HRF_HARMONIC_VIOLET, text_size=size.normal, bgcolor=color.new(#0a0a1a, 0))
        table.cell(dashboard, 1, 0, "", bgcolor=color.new(#0a0a1a, 0))
        table.cell(dashboard, 2, 0, "", bgcolor=color.new(#0a0a1a, 0))
        table.merge_cells(dashboard, 0, 0, 2, 0)
        
        // Regime
        table.cell(dashboard, 0, 1, "  Regime  ", text_color=color.new(#b0b0b0, 0), text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
        table.cell(dashboard, 1, 1, regimeText, text_color=regimeCol, text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
        table.cell(dashboard, 2, 1, isTrending ? "ADX: " + str.tostring(adx, "#.#") : str.tostring(rangeState.rangeDuration) + " bars", text_color=color.new(#808080, 0), text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
        
        // ADX with bar
        table.cell(dashboard, 0, 2, "  ADX  ", text_color=color.new(#b0b0b0, 0), text_size=size.small, bgcolor=color.new(#12121f, 0))
        table.cell(dashboard, 1, 2, str.tostring(adx, "#.#"), text_color=adx > adxThreshold ? HRF_HARMONIC_MAGENTA : #a8b5c4, text_size=size.small, bgcolor=color.new(#12121f, 0))
        table.cell(dashboard, 2, 2, adxBar, text_color=adx > adxThreshold ? HRF_HARMONIC_MAGENTA : #a8b5c4, text_size=size.small, bgcolor=color.new(#12121f, 0))
        
        // Trend
        table.cell(dashboard, 0, 3, "  Trend  ", text_color=color.new(#b0b0b0, 0), text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
        table.cell(dashboard, 1, 3, trendText, text_color=trendCol, text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
        table.cell(dashboard, 2, 3, str.tostring(renko.brickCount) + " bricks", text_color=color.new(#808080, 0), text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
        
        // Band Position with bar
        table.cell(dashboard, 0, 4, "  Band Pos  ", text_color=color.new(#b0b0b0, 0), text_size=size.small, bgcolor=color.new(#12121f, 0))
        table.cell(dashboard, 1, 4, positionText, text_color=positionCol, text_size=size.small, bgcolor=color.new(#12121f, 0))
        table.cell(dashboard, 2, 4, posBar, text_color=positionCol, text_size=size.small, bgcolor=color.new(#12121f, 0))
        
        // Distance from Mean
        table.cell(dashboard, 0, 5, "  From Mean  ", text_color=color.new(#b0b0b0, 0), text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
        table.cell(dashboard, 1, 5, str.tostring(distanceFromMean, "#.#") + "%", text_color=distanceFromMean > 30 ? HRF_BAND_EXTREME_UP : #a8b5c4, text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
        table.cell(dashboard, 2, 5, distanceFromMean > 40 ? "EXTREME" : distanceFromMean > 20 ? "STRETCHED" : "NORMAL", text_color=distanceFromMean > 40 ? HRF_BAND_EXTREME_UP : distanceFromMean > 20 ? HRF_HARMONIC_GOLD : HRF_TREND_NEUTRAL, text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
        
        // Harmonic Zone
        table.cell(dashboard, 0, 6, "  Harmonic  ", text_color=color.new(#b0b0b0, 0), text_size=size.small, bgcolor=color.new(#12121f, 0))
        table.cell(dashboard, 1, 6, harmonicText, text_color=harmonicCol, text_size=size.small, bgcolor=color.new(#12121f, 0))
        table.cell(dashboard, 2, 6, str.tostring(harmonicAmplitude, "#.##"), text_color=harmonicCol, text_size=size.small, bgcolor=color.new(#12121f, 0))
        
        // Magnetic Field
        table.cell(dashboard, 0, 7, "  Field  ", text_color=color.new(#b0b0b0, 0), text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
        table.cell(dashboard, 1, 7, fieldText, text_color=fieldCol, text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
        table.cell(dashboard, 2, 7, str.tostring(fieldStrength, "#.##"), text_color=fieldCol, text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
        
        // Range Quality
        table.cell(dashboard, 0, 8, "  Range Q  ", text_color=color.new(#b0b0b0, 0), text_size=size.small, bgcolor=color.new(#12121f, 0))
        table.cell(dashboard, 1, 8, str.tostring(rangeQuality, "#.#"), text_color=rangeQuality > 70 ? HRF_HARMONIC_GOLD : #a8b5c4, text_size=size.small, bgcolor=color.new(#12121f, 0))
        table.cell(dashboard, 2, 8, rangeQuality > 70 ? "HIGH QUALITY" : rangeQuality > 40 ? "MODERATE" : "LOW", text_color=rangeQuality > 70 ? HRF_HARMONIC_GOLD : rangeQuality > 40 ? #a8b5c4 : HRF_TREND_BEAR, text_size=size.small, bgcolor=color.new(#12121f, 0))
        
        // Renko Flips
        table.cell(dashboard, 0, 9, "  Flips  ", text_color=color.new(#b0b0b0, 0), text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
        table.cell(dashboard, 1, 9, str.tostring(renko.flipCount), text_color=HRF_HARMONIC_CYAN, text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
        table.cell(dashboard, 2, 9, renkoFlipped ? "JUST FLIPPED" : "STABLE", text_color=renkoFlipped ? HRF_HARMONIC_MAGENTA : HRF_TREND_NEUTRAL, text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
        
        // Resonance
        table.cell(dashboard, 0, 10, "  Resonance  ", text_color=color.new(#b0b0b0, 0), text_size=size.small, bgcolor=color.new(#12121f, 0))
        table.cell(dashboard, 1, 10, isResonance ? "ACTIVE" : "INACTIVE", text_color=isResonance ? HRF_RESONANCE_GLOW : HRF_TREND_NEUTRAL, text_size=size.small, bgcolor=color.new(#12121f, 0))
        table.cell(dashboard, 2, 10, str.tostring(resAmplitude, "#.##"), text_color=isResonance ? HRF_RESONANCE_GLOW : #a8b5c4, text_size=size.small, bgcolor=color.new(#12121f, 0))
        
        // Reversal Strength
        table.cell(dashboard, 0, 11, "  Rev Str  ", text_color=color.new(#b0b0b0, 0), text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
        table.cell(dashboard, 1, 11, str.tostring(revStrength, "#.#"), text_color=revStrength > 50 ? HRF_HARMONIC_GOLD : #a8b5c4, text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
        table.cell(dashboard, 2, 11, bullRev ? "▲ BULL REV" : bearRev ? "▼ BEAR REV" : "NO SIGNAL", text_color=bullRev ? HRF_REVERSAL_BULL : bearRev ? HRF_REVERSAL_BEAR : HRF_TREND_NEUTRAL, text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
        
        // Momentum
        table.cell(dashboard, 0, 12, "  Momentum  ", text_color=color.new(#b0b0b0, 0), text_size=size.small, bgcolor=color.new(#12121f, 0))
        table.cell(dashboard, 1, 12, renkoMomentum > 0 ? "▲ " + str.tostring(renkoMomentum, "#.##") : "▼ " + str.tostring(renkoMomentum, "#.##"), text_color=renkoMomentum > 0 ? HRF_TREND_BULL : HRF_TREND_BEAR, text_size=size.small, bgcolor=color.new(#12121f, 0))
        table.cell(dashboard, 2, 12, math.abs(renkoMomentum) > atrVal ? "ACCELERATING" : "DECELERATING", text_color=math.abs(renkoMomentum) > atrVal ? HRF_HARMONIC_CYAN : HRF_TREND_NEUTRAL, text_size=size.small, bgcolor=color.new(#12121f, 0))

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(renkoFlipped and renko.direction > 0, "Renko Bullish Flip", "Renko trend flipped bullish")
alertcondition(renkoFlipped and renko.direction < 0, "Renko Bearish Flip", "Renko trend flipped bearish")
alertcondition(bullRev, "Bullish Reversal", "Bullish reversal signal at band extreme")
alertcondition(bearRev, "Bearish Reversal", "Bearish reversal signal at band extreme")
alertcondition(isTrending and not isTrending[1], "Trend Regime Start", "Market entered trending regime")
alertcondition(not isTrending and isTrending[1], "Range Regime Start", "Market entered ranging regime")
alertcondition(meanReversionBull, "Mean Reversion Bull", "Bullish mean reversion cross")
alertcondition(meanReversionBear, "Mean Reversion Bear", "Bearish mean reversion cross")
alertcondition(inHarmonic1Zone and not inHarmonic1Zone[1], "Harmonic Zone Entry", "Price entered golden ratio zone")
alertcondition(inExtensionZone and not inExtensionZone[1], "Extension Zone Entry", "Price entered extension zone")
alertcondition(isResonance, "Resonance Point", "Price resonance detected")
