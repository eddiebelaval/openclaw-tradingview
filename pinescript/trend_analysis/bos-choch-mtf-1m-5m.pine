//@version=6
indicator("BOS (CHOCH) — MTF 1m + 5m (Clean FIX)", overlay=true, max_lines_count=500, max_labels_count=500)

//======================
// Inputs
//======================
len1  = input.int(3, "1m Structure Strength", minval=1)
len5  = input.int(3, "5m Structure Strength", minval=1)

requireClose = input.bool(true, "Require CLOSE for Break")

showActive1m = input.bool(true, "Show Active 1m High/Low")
showActive5m = input.bool(true, "Show Active 5m High/Low")

maxBos1m = input.int(6, "Max BOS (1m)", minval=1, maxval=50)
maxBos5m = input.int(2, "Max BOS (5m)", minval=1, maxval=50)

colHigh = input.color(color.green, "High Color (bull)")
colLow  = input.color(color.red, "Low Color (bear)")

//======================
// Draw BOS line + centered label (bar_time sticks)
//======================
f_drawBosLine(_pivotTime, _breakTime, _lvl, _isBull, _lineArr, _labArr, _maxKeep) =>
    ln = line.new(chart.point.new(_pivotTime, na, _lvl), chart.point.new(_breakTime, na, _lvl), xloc=xloc.bar_time, color=(_isBull ? colHigh : colLow), width=2)
    midT = int(math.round((_pivotTime + _breakTime) * 0.5))
    lb = label.new(chart.point.new(midT, na, _lvl), "BOS", xloc=xloc.bar_time, style=(_isBull ? label.style_label_down : label.style_label_up), color=color.new(color.white, 100), textcolor=(_isBull ? colHigh : colLow), size=size.small)
    array.push(_lineArr, ln)
    array.push(_labArr, lb)
    while array.size(_lineArr) > _maxKeep
        oldLn = array.shift(_lineArr)
        line.delete(oldLn)
    while array.size(_labArr) > _maxKeep
        oldLb = array.shift(_labArr)
        label.delete(oldLb)

//======================
// Active line helper (single active line, extends right)
//======================
f_setActiveLine(_old, _t, _lvl, _col) =>
    if not na(_old)
        line.delete(_old)
    line.new(chart.point.new(_t, na, _lvl), chart.point.new(last_bar_time, na, _lvl), xloc=xloc.bar_time, color=_col, width=3)

//======================
// Engine (Lux leg logic) — returns 9 values
//======================
f_engine(_len) =>
    var int legv = 0
    newLegHigh = high[_len] > ta.highest(_len)
    newLegLow  = low[_len]  < ta.lowest(_len)
    if newLegHigh
        legv := 0
    else if newLegLow
        legv := 1

    newPivot  = ta.change(legv) != 0
    startBear = ta.change(legv) == -1
    startBull = ta.change(legv) == +1

    var float hiLvl = na
    var int   hiTime = na
    var bool  hiCrossed = false

    var float loLvl = na
    var int   loTime = na
    var bool  loCrossed = false

    var int trend = 0 // -1 bearish, +1 bullish, 0 unknown

    if newPivot and startBear
        hiLvl := high[_len]
        hiTime := time[_len]
        hiCrossed := false

    if newPivot and startBull
        loLvl := low[_len]
        loTime := time[_len]
        loCrossed := false

    upSrc = requireClose ? close : high
    dnSrc = requireClose ? close : low

    if trend == 0
        if not na(hiLvl) and upSrc > hiLvl
            trend := +1
        else if not na(loLvl) and dnSrc < loLvl
            trend := -1

    breakUp = not na(hiLvl) and not hiCrossed and upSrc > hiLvl
    breakDn = not na(loLvl) and not loCrossed and dnSrc < loLvl

    bool bullBos = false
    bool bearBos = false
    float bosLvl = na
    int bosPivotTime = na
    int bosBreakTime = na

    if breakUp
        if trend == -1
            bullBos := true
            bosLvl := hiLvl
            bosPivotTime := hiTime
            bosBreakTime := time
        trend := +1
        hiCrossed := true

    if breakDn
        if trend == +1
            bearBos := true
            bosLvl := loLvl
            bosPivotTime := loTime
            bosBreakTime := time
        trend := -1
        loCrossed := true

    [hiLvl, hiTime, loLvl, loTime, bullBos, bearBos, bosLvl, bosPivotTime, bosBreakTime]

//======================
// Pull 1m + 5m tuples (SINGLE-LINE to avoid parser issues)
//======================
[hi1, hiT1, lo1, loT1, bull1, bear1, bosLvl1, bosPT1, bosBT1] = request.security(syminfo.tickerid, "1", f_engine(len1), barmerge.gaps_off, barmerge.lookahead_off)
[hi5, hiT5, lo5, loT5, bull5, bear5, bosLvl5, bosPT5, bosBT5] = request.security(syminfo.tickerid, "5", f_engine(len5), barmerge.gaps_off, barmerge.lookahead_off)

//======================
// Active lines (one high + one low per TF)
//======================
var line hi1_ln = na
var line lo1_ln = na
var line hi5_ln = na
var line lo5_ln = na

var int lastHiT1 = na
var int lastLoT1 = na
var int lastHiT5 = na
var int lastLoT5 = na

if showActive1m
    if not na(hiT1) and hiT1 != lastHiT1
        hi1_ln := f_setActiveLine(hi1_ln, hiT1, hi1, colHigh)
        lastHiT1 := hiT1
    if not na(loT1) and loT1 != lastLoT1
        lo1_ln := f_setActiveLine(lo1_ln, loT1, lo1, colLow)
        lastLoT1 := loT1
    if not na(hi1_ln)
        line.set_second_point(hi1_ln, chart.point.new(last_bar_time, na, hi1))
    if not na(lo1_ln)
        line.set_second_point(lo1_ln, chart.point.new(last_bar_time, na, lo1))

if showActive5m
    if not na(hiT5) and hiT5 != lastHiT5
        hi5_ln := f_setActiveLine(hi5_ln, hiT5, hi5, color.new(colHigh, 0))
        lastHiT5 := hiT5
    if not na(loT5) and loT5 != lastLoT5
        lo5_ln := f_setActiveLine(lo5_ln, loT5, lo5, color.new(colLow, 0))
        lastLoT5 := loT5
    if not na(hi5_ln)
        line.set_second_point(hi5_ln, chart.point.new(last_bar_time, na, hi5))
    if not na(lo5_ln)
        line.set_second_point(lo5_ln, chart.point.new(last_bar_time, na, lo5))

//======================
// BOS storage (limits)
//======================
var line[]  bos1_lines = array.new_line()
var label[] bos1_labs  = array.new_label()
var line[]  bos5_lines = array.new_line()
var label[] bos5_labs  = array.new_label()

//======================
// Draw BOS events (CHOCH only)
//======================
if bull1 and not na(bosPT1) and not na(bosBT1)
    f_drawBosLine(bosPT1, bosBT1, bosLvl1, true, bos1_lines, bos1_labs, maxBos1m)
if bear1 and not na(bosPT1) and not na(bosBT1)
    f_drawBosLine(bosPT1, bosBT1, bosLvl1, false, bos1_lines, bos1_labs, maxBos1m)

if bull5 and not na(bosPT5) and not na(bosBT5)
    f_drawBosLine(bosPT5, bosBT5, bosLvl5, true, bos5_lines, bos5_labs, maxBos5m)
if bear5 and not na(bosPT5) and not na(bosBT5)
    f_drawBosLine(bosPT5, bosBT5, bosLvl5, false, bos5_lines, bos5_labs, maxBos5m)
