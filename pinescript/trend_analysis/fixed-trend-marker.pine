//@version=5
indicator("Fixed Trend Marker", overlay=true)

// Input: pivot length
pivotLen = input.int(5, "Pivot Length", minval=1)

// Identify pivot points
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

// Store the last 3 pivot points and their bar indices
var float[] lastHighs = array.new_float(3, na)
var float[] lastLows = array.new_float(3, na)
var int[] lastHighsBarIndex = array.new_int(3, na)
var int[] lastLowsBarIndex = array.new_int(3, na)

// Variables for plotting signals
var int buySignalBar = na
var int sellSignalBar = na

// Update pivot high array
if not na(ph)
    // Shift values
    array.shift(lastHighs)
    array.push(lastHighs, ph)
    
    array.shift(lastHighsBarIndex)
    array.push(lastHighsBarIndex, bar_index - pivotLen)

// Update pivot low array
if not na(pl)
    // Shift values
    array.shift(lastLows)
    array.push(lastLows, pl)
    
    array.shift(lastLowsBarIndex)
    array.push(lastLowsBarIndex, bar_index - pivotLen)

// Check for patterns and set signal bars
if array.size(lastHighs) == 3 and 
   not na(array.get(lastHighs, 0)) and 
   not na(array.get(lastHighs, 1)) and 
   not na(array.get(lastHighs, 2))
    // Check for 3 consecutive pivot highs going UP
    if array.get(lastHighs, 2) > array.get(lastHighs, 1) and 
       array.get(lastHighs, 1) > array.get(lastHighs, 0)
        buySignalBar := array.get(lastHighsBarIndex, 2)

if array.size(lastLows) == 3 and 
   not na(array.get(lastLows, 0)) and 
   not na(array.get(lastLows, 1)) and 
   not na(array.get(lastLows, 2))
    // Check for 3 consecutive pivot lows going DOWN
    if array.get(lastLows, 2) < array.get(lastLows, 1) and 
       array.get(lastLows, 1) < array.get(lastLows, 0)
        sellSignalBar := array.get(lastLowsBarIndex, 2)

// Plot dots for all pivot points
plotshape(not na(ph), title="Pivot High", style=shape.circle, location=location.abovebar, 
          color=color.red, size=size.tiny, offset=-pivotLen)

plotshape(not na(pl), title="Pivot Low", style=shape.circle, location=location.belowbar, 
          color=color.green, size=size.tiny, offset=-pivotLen)

// Plot Buy and Sell signals using calculated bar indices
plotshape(bar_index == buySignalBar, title="Buy Signal", style=shape.triangleup, 
          location=location.abovebar, color=color.green, size=size.normal)

plotshape(bar_index == sellSignalBar, title="Sell Signal", style=shape.triangledown, 
          location=location.belowbar, color=color.red, size=size.normal)

// Show explanation
var table infoTable = table.new(position.top_right, 2, 2, bgcolor=color.new(color.black, 70))
table.cell(infoTable, 0, 0, "Buy Signal:", text_color=color.green, text_size=size.small)
table.cell(infoTable, 1, 0, "After 2 red dots moving UP", text_color=color.white, text_size=size.small)
table.cell(infoTable, 0, 1, "Sell Signal:", text_color=color.red, text_size=size.small)
table.cell(infoTable, 1, 1, "After 2 green dots moving DOWN", text_color=color.white, text_size=size.small)
