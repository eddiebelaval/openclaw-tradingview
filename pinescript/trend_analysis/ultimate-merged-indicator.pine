//@version=6
indicator("Ultimate Merged Indicator", overlay=true, max_lines_count=500, max_labels_count=500)

// =========================================================================
// ========================== 1. INPUTS & GROUPS ===========================
// =========================================================================

// --- PIVOT POINTS INPUTS ---
grp_pivot = "Pivot Points"
grp_p_labels = "Pivot Labels"
grp_p_levels = "Pivot Levels"
pivotTypeInput           = input.string(title="Type", defval="Traditional", options=["Traditional", "Fibonacci", "Woodie", "Classic", "DM", "Camarilla"], group=grp_pivot)
pivotAnchorInput         = input.string(title="Pivots Timeframe", defval="Auto", options=["Auto", "Daily", "Weekly", "Monthly", "Quarterly", "Yearly", "Biyearly", "Triyearly", "Quinquennially", "Decennially"], group=grp_pivot)
maxHistoricalPivotsInput = input.int(title="Number of Pivots Back", defval=15, minval=1, maxval=200, display = display.none, group=grp_pivot)
isDailyBasedInput        = input.bool(title="Use Daily-based Values", defval=true, display = display.none, tooltip="When unchecked, uses intraday data.", group=grp_pivot)
showLabelsInput          = input.bool(title="Show Labels", defval=true, group=grp_p_labels, display = display.none)
showPricesInput          = input.bool(title="Show Prices", defval=true, group=grp_p_labels, display = display.none)
positionLabelsInput      = input.string("Left", "Labels Position", options=["Left", "Right"], group=grp_p_labels, display = display.none)
linewidthInput           = input.int(title="Line Width", defval=1, minval=1, maxval=100, group=grp_p_levels, display = display.none)

DEFAULT_COLOR = #FB8C00
showLevel2and3 = pivotTypeInput != "DM"
showLevel4 = pivotTypeInput != "DM" and pivotTypeInput != "Fibonacci"
showLevel5 = pivotTypeInput == "Traditional" or pivotTypeInput == "Camarilla"

pColorInput  = input.color(DEFAULT_COLOR, "P", inline="P", group=grp_p_levels, display = display.none)
pShowInput   = input.bool(true, "", inline="P", group=grp_p_levels, display = display.none)
s1ColorInput = input.color(DEFAULT_COLOR, "S1", inline="S1/R1" , group=grp_p_levels, display = display.none)
s1ShowInput  = input.bool(true, "", inline="S1/R1", group=grp_p_levels, display = display.none)
r1ColorInput = input.color(DEFAULT_COLOR, "R1", inline="S1/R1", group=grp_p_levels, display = display.none)
r1ShowInput  = input.bool(true, "", inline="S1/R1", group=grp_p_levels, display = display.none)
s2ColorInput = input.color(DEFAULT_COLOR, "S2", inline="S2/R2", group=grp_p_levels, display = display.none)
s2ShowInput  = input.bool(true, "", inline="S2/R2", group=grp_p_levels, display = display.none)
r2ColorInput = input.color(DEFAULT_COLOR, "R2", inline="S2/R2", group=grp_p_levels, display = display.none)
r2ShowInput  = input.bool(true, "", inline="S2/R2", group=grp_p_levels, display = display.none)
s3ColorInput = input.color(DEFAULT_COLOR, "S3", inline="S3/R3", group=grp_p_levels, display = display.none)
s3ShowInput  = input.bool(true, "", inline="S3/R3", group=grp_p_levels, display = display.none)
r3ColorInput = input.color(DEFAULT_COLOR, "R3", inline="S3/R3", group=grp_p_levels, display = display.none)
r3ShowInput  = input.bool(true, "", inline="S3/R3", group=grp_p_levels, display = display.none)
s4ColorInput = input.color(DEFAULT_COLOR, "S4", inline="S4/R4", group=grp_p_levels, display = display.none)
s4ShowInput  = input.bool(true, "", inline="S4/R4", group=grp_p_levels, display = display.none)
r4ColorInput = input.color(DEFAULT_COLOR, "R4", inline="S4/R4", group=grp_p_levels, display = display.none)
r4ShowInput  = input.bool(true, "", inline="S4/R4", group=grp_p_levels, display = display.none)
s5ColorInput = input.color(DEFAULT_COLOR, "S5", inline="S5/R5", group=grp_p_levels, display = display.none)
s5ShowInput  = input.bool(true, "", inline="S5/R5", group=grp_p_levels, display = display.none)
r5ColorInput = input.color(DEFAULT_COLOR, "R5", inline="S5/R5", group=grp_p_levels, display = display.none)
r5ShowInput  = input.bool(true, "", inline="S5/R5", group=grp_p_levels, display = display.none)

// --- MA MATRIX INPUTS ---
grp_ma_glob = "MA Matrix: Global Settings"
grp_ma_disp = "MA Matrix: Plot Visibility"
ma_atr_length   = input.int(14, "ATR Length For Normalization", group=grp_ma_glob)
ma_type_to_plot = input.string("EMA", "MA Type to Plot", options=["None", "EMA", "WMA", "SMA", "VWAP", "TEMA"], group=grp_ma_disp, tooltip="Select which set of 5 Moving Averages to display on the chart to avoid clutter.")

grp1 = "MA Matrix: Level 1 (Fast)"
len1  = input.int(9,  title="Length", group=grp1)
lb1   = input.int(4,  title="Angle Lookback", group=grp1)
buy1  = input.float(6.0,  title="BUY Angle", group=grp1)
sell1 = input.float(-6.0, title="SELL Angle", group=grp1)
col1  = input.color(color.green, title="Line Color", group=grp1)

grp2 = "MA Matrix: Level 2 (Short)"
len2  = input.int(21, title="Length", group=grp2)
lb2   = input.int(5,  title="Angle Lookback", group=grp2)
buy2  = input.float(5.0,  title="BUY Angle", group=grp2)
sell2 = input.float(-5.0, title="SELL Angle", group=grp2)
col2  = input.color(color.yellow, title="Line Color", group=grp2)

grp3 = "MA Matrix: Level 3 (Medium)"
len3  = input.int(50, title="Length", group=grp3)
lb3   = input.int(7,  title="Angle Lookback", group=grp3)
buy3  = input.float(4.0,  title="BUY Angle", group=grp3)
sell3 = input.float(-4.0, title="SELL Angle", group=grp3)
col3  = input.color(color.aqua, title="Line Color", group=grp3)

grp4 = "MA Matrix: Level 4 (Long)"
len4  = input.int(100, title="Length", group=grp4)
lb4   = input.int(9,  title="Angle Lookback", group=grp4)
buy4  = input.float(3.0,  title="BUY Angle", group=grp4)
sell4 = input.float(-3.0, title="SELL Angle", group=grp4)
col4  = input.color(color.orange, title="Line Color", group=grp4)

grp5 = "MA Matrix: Level 5 (Macro)"
len5  = input.int(200, title="Length", group=grp5)
lb5   = input.int(10,  title="Angle Lookback", group=grp5)
buy5  = input.float(2.0,  title="BUY Angle", group=grp5)
sell5 = input.float(-2.0, title="SELL Angle", group=grp5)
col5  = input.color(color.white, title="Line Color", group=grp5)

// --- RANGE FILTER INPUTS ---
grp_rf = "Range Filter 5min"
rf_src  = input.source(defval=close, title="Source", group=grp_rf)
rf_per  = input.int(defval=100, minval=1, title="Sampling Period", group=grp_rf)
rf_mult = input.float(defval=3.0, minval=0.1, title="Range Multiplier", group=grp_rf)

// --- ADX SHADING INPUTS ---
grp_adx = "ADX Background"
TT_ADX_LEN   = "The time period to be used in calculating the ADX which has a smoothing component."
TT_DI_LEN    = "The time period to be used in calculating the DI (Directional Indicator)."
adxlen       = input.int(14, title="ADX Smoothing", tooltip=TT_ADX_LEN, group=grp_adx)
dilen        = input.int(14, title="DI Length", tooltip=TT_DI_LEN, group=grp_adx)
adxThreshold = input.float(20.0, title="ADX Threshold", group=grp_adx)
adx_tf       = input.timeframe("15", title="ADX Timeframe", group=grp_adx) // Custom timeframe selector added here!

// --- SUPERTREND INPUTS ---
grp_st = "Supertrend"
st_Periods     = input.int(10, title="ATR Period", group=grp_st)
st_src         = input.source(hl2, title="Source", group=grp_st)
st_Multiplier  = input.float(3.0, title="ATR Multiplier", step=0.1, group=grp_st)
st_changeATR   = input.bool(true, title="Change ATR Calculation Method ?", group=grp_st)
st_showsignals = input.bool(true, title="Show Buy/Sell Signals ?", group=grp_st)
st_highlight   = input.bool(true, title="Highlighter On/Off ?", group=grp_st)


// =========================================================================
// ============================= 2. FUNCTIONS ==============================
// =========================================================================

// --- MA Matrix Functions ---
f_tema(src, len) =>
    ema1 = ta.ema(src, len)
    ema2 = ta.ema(ema1, len)
    ema3 = ta.ema(ema2, len)
    3 * (ema1 - ema2) + ema3

// --- Range Filter Functions ---
f_smoothrng(x, t, m) =>
    wper = t * 2 - 1
    avrng = ta.ema(math.abs(x - x[1]), t)
    smoothrng = ta.ema(avrng, wper) * m
    smoothrng

f_rngfilt(x, r) =>
    float rngfilt = x
    rngfilt := x > nz(rngfilt[1]) ? (x - r < nz(rngfilt[1]) ? nz(rngfilt[1]) : x - r) : (x + r > nz(rngfilt[1]) ? nz(rngfilt[1]) : x + r)
    rngfilt

// --- ADX Functions ---
f_dirmov(len) =>
    up = ta.change(high)
    down = -ta.change(low)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    truerange = ta.rma(ta.tr, len)
    plus = fixnan(100 * ta.rma(plusDM, len) / truerange)
    minus = fixnan(100 * ta.rma(minusDM, len) / truerange)
    [plus, minus]

f_adx(dilen, adxlen) =>
    [plus, minus] = f_dirmov(dilen)
    sum = plus + minus
    adx_val = 100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), adxlen)
    adx_val

// --- Pivot Points Types & Methods ---
type graphicSettings
    string levelName
    color levelColor
    bool showLevel

type pivotGraphic
    line pivotLine
    label pivotLabel

method delete(pivotGraphic graphic) =>
    graphic.pivotLine.delete()
    graphic.pivotLabel.delete()


// =========================================================================
// ===================== 3. CALCULATIONS & PLOTTING ========================
// =========================================================================

// -------------------------------------------------------------------------
// COMPONENT 1: ADX BACKGROUND
// -------------------------------------------------------------------------
// request.security simulates the timeframe from settings and fills gaps
adx_sig = request.security(syminfo.tickerid, adx_tf, f_adx(dilen, adxlen), gaps=barmerge.gaps_off)
bgcolor(adx_sig >= adxThreshold ? color.new(color.green, 90) : color.new(color.red, 90), title="ADX Zone")


// -------------------------------------------------------------------------
// COMPONENT 2: PIVOT POINTS
// -------------------------------------------------------------------------
var graphicSettingsArray = array.from(
      graphicSettings.new(" P", pColorInput, pShowInput),
      graphicSettings.new("R1", r1ColorInput, r1ShowInput), graphicSettings.new("S1", s1ColorInput, s1ShowInput),
      graphicSettings.new("R2", r2ColorInput, r2ShowInput), graphicSettings.new("S2", s2ColorInput, s2ShowInput),
      graphicSettings.new("R3", r3ColorInput, r3ShowInput), graphicSettings.new("S3", s3ColorInput, s3ShowInput),
      graphicSettings.new("R4", r4ColorInput, r4ShowInput), graphicSettings.new("S4", s4ColorInput, s4ShowInput),
      graphicSettings.new("R5", r5ColorInput, r5ShowInput), graphicSettings.new("S5", s5ColorInput, s5ShowInput))

autoAnchor = switch
    timeframe.isintraday => timeframe.multiplier <= 15 ? "1D" : "1W"
    timeframe.isdaily    => "1M"
    => "12M"

pivotTimeframe = switch pivotAnchorInput
    "Auto"      => autoAnchor
    "Daily"     => "1D"
    "Weekly"    => "1W"
    "Monthly"   => "1M"
    "Quarterly" => "3M"
    => "12M"

pivotYearMultiplier = switch pivotAnchorInput
    "Biyearly"       => 2
    "Triyearly"      => 3
    "Quinquennially" => 5
    "Decennially"    => 10
    => 1

numOfPivotLevels = switch pivotTypeInput
    "Traditional" => 11
    "Camarilla"   => 11
    "Woodie"      => 9
    "Classic"     => 9
    "Fibonacci"   => 7
    "DM"          => 3

var drawnGraphics = matrix.new<pivotGraphic>()

localPivotTimeframeChange = timeframe.change(pivotTimeframe) and year % pivotYearMultiplier == 0
securityPivotTimeframeChange = timeframe.change(timeframe.period) and year % pivotYearMultiplier == 0

pivotTimeframeChangeCounter(condition) => 
    var count = 0
    if condition and bar_index > 0
        count += 1
    count

localPivots = ta.pivot_point_levels(pivotTypeInput, localPivotTimeframeChange)
securityPivotPointsArray = ta.pivot_point_levels(pivotTypeInput, securityPivotTimeframeChange)

securityTimeframe = timeframe.isintraday ? "1D" : timeframe.period
[securityPivots, securityPivotCounter] = request.security(syminfo.tickerid, pivotTimeframe, [securityPivotPointsArray, pivotTimeframeChangeCounter(securityPivotTimeframeChange)], lookahead = barmerge.lookahead_on)
pivotPointsArray = isDailyBasedInput ? securityPivots : localPivots

affixOldPivots(endTime) =>
    if drawnGraphics.rows() > 0
        lastGraphics = drawnGraphics.row(drawnGraphics.rows() - 1)
        for graphic in lastGraphics
            graphic.pivotLine.set_x2(endTime)
            if positionLabelsInput == "Right"
                graphic.pivotLabel.set_x(endTime)

drawNewPivots(startTime) =>
    newGraphics = array.new<pivotGraphic>()
    for [index, coord] in pivotPointsArray
        levelSettings = graphicSettingsArray.get(index)
        if not na(coord) and levelSettings.showLevel
            lineEndTime = startTime + timeframe.in_seconds(pivotTimeframe) * 1000 * pivotYearMultiplier
            pivotLine = line.new(startTime, coord, lineEndTime, coord, xloc = xloc.bar_time, color=levelSettings.levelColor, width=linewidthInput)
            pivotLabel = label.new(x = positionLabelsInput == "Left" ? startTime : lineEndTime,
                               y = coord,
                               text = (showLabelsInput ? levelSettings.levelName + " " : "") + (showPricesInput ? "(" + str.tostring(coord, format.mintick) + ")" : ""),
                               style = positionLabelsInput == "Left" ? label.style_label_right : label.style_label_left,
                               textcolor = levelSettings.levelColor,
                               color = #00000000,
                               xloc=xloc.bar_time)
            newGraphics.push(pivotGraphic.new(pivotLine, pivotLabel))
    drawnGraphics.add_row(array_id = newGraphics)
    if drawnGraphics.rows() > maxHistoricalPivotsInput
        oldGraphics = drawnGraphics.remove_row(0)
        for graphic in oldGraphics
            graphic.delete()

localPivotDrawConditionStatic = not isDailyBasedInput and localPivotTimeframeChange
securityPivotDrawConditionStatic = isDailyBasedInput and securityPivotCounter != securityPivotCounter[1]

var isMultiYearly = array.from("Biyearly", "Triyearly", "Quinquennially", "Decennially").includes(pivotAnchorInput)
localPivotDrawConditionDeveloping = not isDailyBasedInput and time_close == time_close(pivotTimeframe) and not isMultiYearly 

if (securityPivotDrawConditionStatic or localPivotDrawConditionStatic)
    affixOldPivots(time)
    drawNewPivots(time)

var FIRST_BAR_TIME = time
if (barstate.islastconfirmedhistory and drawnGraphics.columns() == 0)
    if not na(securityPivots) and securityPivotCounter > 0
        if isDailyBasedInput
            drawNewPivots(FIRST_BAR_TIME)
        else 
            runtime.error("Not enough intraday data to calculate Pivot Points. Lower the Pivots Timeframe or turn on the 'Use Daily-based Values' option.")
    else
        runtime.error("Not enough data to calculate Pivot Points. Lower the Pivots Timeframe in the indicator settings.")


// -------------------------------------------------------------------------
// COMPONENT 3: MA MATRIX
// -------------------------------------------------------------------------
ema1 = ta.ema(close, len1)
wma1 = ta.wma(close, len1)
sma1 = ta.sma(close, len1)
vwap1 = ta.vwma(close, len1)
tema1 = f_tema(close, len1)

ema2 = ta.ema(close, len2)
wma2 = ta.wma(close, len2)
sma2 = ta.sma(close, len2)
vwap2 = ta.vwma(close, len2)
tema2 = f_tema(close, len2)

ema3 = ta.ema(close, len3)
wma3 = ta.wma(close, len3)
sma3 = ta.sma(close, len3)
vwap3 = ta.vwma(close, len3)
tema3 = f_tema(close, len3)

ema4 = ta.ema(close, len4)
wma4 = ta.wma(close, len4)
sma4 = ta.sma(close, len4)
vwap4 = ta.vwma(close, len4)
tema4 = f_tema(close, len4)

ema5 = ta.ema(close, len5)
wma5 = ta.wma(close, len5)
sma5 = ta.sma(close, len5)
vwap5 = ta.vwma(close, len5)
tema5 = f_tema(close, len5)

// Plot the selected MA type to bypass the 64 plot limit
plot1_val = ma_type_to_plot == "EMA" ? ema1 : ma_type_to_plot == "WMA" ? wma1 : ma_type_to_plot == "SMA" ? sma1 : ma_type_to_plot == "VWAP" ? vwap1 : ma_type_to_plot == "TEMA" ? tema1 : na
plot(plot1_val, color=col1, linewidth=2, title="MA Level 1")

plot2_val = ma_type_to_plot == "EMA" ? ema2 : ma_type_to_plot == "WMA" ? wma2 : ma_type_to_plot == "SMA" ? sma2 : ma_type_to_plot == "VWAP" ? vwap2 : ma_type_to_plot == "TEMA" ? tema2 : na
plot(plot2_val, color=col2, linewidth=2, title="MA Level 2")

plot3_val = ma_type_to_plot == "EMA" ? ema3 : ma_type_to_plot == "WMA" ? wma3 : ma_type_to_plot == "SMA" ? sma3 : ma_type_to_plot == "VWAP" ? vwap3 : ma_type_to_plot == "TEMA" ? tema3 : na
plot(plot3_val, color=col3, linewidth=2, title="MA Level 3")

plot4_val = ma_type_to_plot == "EMA" ? ema4 : ma_type_to_plot == "WMA" ? wma4 : ma_type_to_plot == "SMA" ? sma4 : ma_type_to_plot == "VWAP" ? vwap4 : ma_type_to_plot == "TEMA" ? tema4 : na
plot(plot4_val, color=col4, linewidth=2, title="MA Level 4")

plot5_val = ma_type_to_plot == "EMA" ? ema5 : ma_type_to_plot == "WMA" ? wma5 : ma_type_to_plot == "SMA" ? sma5 : ma_type_to_plot == "VWAP" ? vwap5 : ma_type_to_plot == "TEMA" ? tema5 : na
plot(plot5_val, color=col5, linewidth=2, title="MA Level 5")


ma_atr = ta.atr(ma_atr_length)
calc_angle(ma_val, lookback) =>
    slope = (ma_val - ma_val[lookback]) / lookback
    normalized_slope = slope / math.max(ma_atr, 0.000001)
    math.atan(normalized_slope) * 180 / math.pi

a_ema1 = calc_angle(ema1, lb1)
a_wma1 = calc_angle(wma1, lb1)
a_sma1 = calc_angle(sma1, lb1)
a_vwap1 = calc_angle(vwap1, lb1)
a_tema1 = calc_angle(tema1, lb1)

a_ema2 = calc_angle(ema2, lb2)
a_wma2 = calc_angle(wma2, lb2)
a_sma2 = calc_angle(sma2, lb2)
a_vwap2 = calc_angle(vwap2, lb2)
a_tema2 = calc_angle(tema2, lb2)

a_ema3 = calc_angle(ema3, lb3)
a_wma3 = calc_angle(wma3, lb3)
a_sma3 = calc_angle(sma3, lb3)
a_vwap3 = calc_angle(vwap3, lb3)
a_tema3 = calc_angle(tema3, lb3)

a_ema4 = calc_angle(ema4, lb4)
a_wma4 = calc_angle(wma4, lb4)
a_sma4 = calc_angle(sma4, lb4)
a_vwap4 = calc_angle(vwap4, lb4)
a_tema4 = calc_angle(tema4, lb4)

a_ema5 = calc_angle(ema5, lb5)
a_wma5 = calc_angle(wma5, lb5)
a_sma5 = calc_angle(sma5, lb5)
a_vwap5 = calc_angle(vwap5, lb5)
a_tema5 = calc_angle(tema5, lb5)

w1 = 1.0
w2 = 2.0
w3 = 3.0
w4 = 4.0
w5 = 5.0
total_max_weight = (w1 + w2 + w3 + w4 + w5) * 5 

is_buy(a, lvl) => a >= lvl ? 1.0 : 0.0
is_sell(a, lvl) => a <= lvl ? 1.0 : 0.0

buy_w1 = (is_buy(a_ema1, buy1) + is_buy(a_wma1, buy1) + is_buy(a_sma1, buy1) + is_buy(a_vwap1, buy1) + is_buy(a_tema1, buy1)) * w1
buy_w2 = (is_buy(a_ema2, buy2) + is_buy(a_wma2, buy2) + is_buy(a_sma2, buy2) + is_buy(a_vwap2, buy2) + is_buy(a_tema2, buy2)) * w2
buy_w3 = (is_buy(a_ema3, buy3) + is_buy(a_wma3, buy3) + is_buy(a_sma3, buy3) + is_buy(a_vwap3, buy3) + is_buy(a_tema3, buy3)) * w3
buy_w4 = (is_buy(a_ema4, buy4) + is_buy(a_wma4, buy4) + is_buy(a_sma4, buy4) + is_buy(a_vwap4, buy4) + is_buy(a_tema4, buy4)) * w4
buy_w5 = (is_buy(a_ema5, buy5) + is_buy(a_wma5, buy5) + is_buy(a_sma5, buy5) + is_buy(a_vwap5, buy5) + is_buy(a_tema5, buy5)) * w5
buy_w = buy_w1 + buy_w2 + buy_w3 + buy_w4 + buy_w5

sell_w1 = (is_sell(a_ema1, sell1) + is_sell(a_wma1, sell1) + is_sell(a_sma1, sell1) + is_sell(a_vwap1, sell1) + is_sell(a_tema1, sell1)) * w1
sell_w2 = (is_sell(a_ema2, sell2) + is_sell(a_wma2, sell2) + is_sell(a_sma2, sell2) + is_sell(a_vwap2, sell2) + is_sell(a_tema2, sell2)) * w2
sell_w3 = (is_sell(a_ema3, sell3) + is_sell(a_wma3, sell3) + is_sell(a_sma3, sell3) + is_sell(a_vwap3, sell3) + is_sell(a_tema3, sell3)) * w3
sell_w4 = (is_sell(a_ema4, sell4) + is_sell(a_wma4, sell4) + is_sell(a_sma4, sell4) + is_sell(a_vwap4, sell4) + is_sell(a_tema4, sell4)) * w4
sell_w5 = (is_sell(a_ema5, sell5) + is_sell(a_wma5, sell5) + is_sell(a_sma5, sell5) + is_sell(a_vwap5, sell5) + is_sell(a_tema5, sell5)) * w5
sell_w = sell_w1 + sell_w2 + sell_w3 + sell_w4 + sell_w5

buy_pct = (buy_w / total_max_weight) * 100
sell_pct = (sell_w / total_max_weight) * 100
sideways_pct = 100.0 - buy_pct - sell_pct

is_buy_highest = (buy_pct > sell_pct) and (buy_pct > sideways_pct)
is_sell_highest = (sell_pct > buy_pct) and (sell_pct > sideways_pct)

master_signal = is_buy_highest ? "STRONG BUY" : is_sell_highest ? "STRONG SELL" : "SIDEWAYS"
master_bg_col = is_buy_highest ? color.new(color.green, 10) : is_sell_highest ? color.new(color.red, 10) : color.new(color.yellow, 20)
master_text = "MASTER SIGNAL: " + master_signal + "\n(Buy: " + str.tostring(buy_pct, "#.0") + "% | Sell: " + str.tostring(sell_pct, "#.0") + "% | Sideways: " + str.tostring(sideways_pct, "#.0") + "%)"

getCategory(angle, buyLevel, sellLevel) => angle >= buyLevel ? "BUY" : angle <= sellLevel ? "SELL" : "SIDEWAYS"
getColor(angle, buyLevel, sellLevel) => angle >= buyLevel ? color.new(color.green, 20) : angle <= sellLevel ? color.new(color.red, 20) : color.new(color.yellow, 20)

fill_cell(tb, col, row, angle, buyLvl, sellLvl) =>
    txt = getCategory(angle, buyLvl, sellLvl) + "\n(" + str.tostring(angle, "#.0") + "°)"
    table.cell(tb, col, row, txt, bgcolor=getColor(angle, buyLvl, sellLvl), text_color=color.black)

var table dashboard = table.new(position.top_right, 6, 7, border_width=1, border_color=color.gray)
if barstate.islast
    table.cell(dashboard, 0, 0, "Length", bgcolor=color.black, text_color=color.white)
    table.cell(dashboard, 1, 0, "EMA", bgcolor=color.black, text_color=color.white)
    table.cell(dashboard, 2, 0, "WMA", bgcolor=color.black, text_color=color.white)
    table.cell(dashboard, 3, 0, "SMA", bgcolor=color.black, text_color=color.white)
    table.cell(dashboard, 4, 0, "VWAP", bgcolor=color.black, text_color=color.white)
    table.cell(dashboard, 5, 0, "TEMA", bgcolor=color.black, text_color=color.white)
    
    table.cell(dashboard, 0, 1, str.tostring(len1), bgcolor=col1, text_color=color.black)
    fill_cell(dashboard, 1, 1, a_ema1, buy1, sell1)
    fill_cell(dashboard, 2, 1, a_wma1, buy1, sell1)
    fill_cell(dashboard, 3, 1, a_sma1, buy1, sell1)
    fill_cell(dashboard, 4, 1, a_vwap1, buy1, sell1)
    fill_cell(dashboard, 5, 1, a_tema1, buy1, sell1)

    table.cell(dashboard, 0, 2, str.tostring(len2), bgcolor=col2, text_color=color.black)
    fill_cell(dashboard, 1, 2, a_ema2, buy2, sell2)
    fill_cell(dashboard, 2, 2, a_wma2, buy2, sell2)
    fill_cell(dashboard, 3, 2, a_sma2, buy2, sell2)
    fill_cell(dashboard, 4, 2, a_vwap2, buy2, sell2)
    fill_cell(dashboard, 5, 2, a_tema2, buy2, sell2)

    table.cell(dashboard, 0, 3, str.tostring(len3), bgcolor=col3, text_color=color.black)
    fill_cell(dashboard, 1, 3, a_ema3, buy3, sell3)
    fill_cell(dashboard, 2, 3, a_wma3, buy3, sell3)
    fill_cell(dashboard, 3, 3, a_sma3, buy3, sell3)
    fill_cell(dashboard, 4, 3, a_vwap3, buy3, sell3)
    fill_cell(dashboard, 5, 3, a_tema3, buy3, sell3)

    table.cell(dashboard, 0, 4, str.tostring(len4), bgcolor=col4, text_color=color.black)
    fill_cell(dashboard, 1, 4, a_ema4, buy4, sell4)
    fill_cell(dashboard, 2, 4, a_wma4, buy4, sell4)
    fill_cell(dashboard, 3, 4, a_sma4, buy4, sell4)
    fill_cell(dashboard, 4, 4, a_vwap4, buy4, sell4)
    fill_cell(dashboard, 5, 4, a_tema4, buy4, sell4)

    table.cell(dashboard, 0, 5, str.tostring(len5), bgcolor=col5, text_color=color.black)
    fill_cell(dashboard, 1, 5, a_ema5, buy5, sell5)
    fill_cell(dashboard, 2, 5, a_wma5, buy5, sell5)
    fill_cell(dashboard, 3, 5, a_sma5, buy5, sell5)
    fill_cell(dashboard, 4, 5, a_vwap5, buy5, sell5)
    fill_cell(dashboard, 5, 5, a_tema5, buy5, sell5)

    table.merge_cells(dashboard, 0, 6, 5, 6)
    table.cell(dashboard, 0, 6, master_text, bgcolor=master_bg_col, text_color=color.black, text_size=size.normal)


// -------------------------------------------------------------------------
// COMPONENT 4: RANGE FILTER 
// -------------------------------------------------------------------------
rf_upColor   = color.white
rf_midColor  = #90bff9
rf_downColor = color.blue

rf_smrng = f_smoothrng(rf_src, rf_per, rf_mult)
rf_filt  = f_rngfilt(rf_src, rf_smrng)

var float rf_upward = 0.0
rf_upward := rf_filt > rf_filt[1] ? nz(rf_upward[1]) + 1 : rf_filt < rf_filt[1] ? 0 : nz(rf_upward[1])

var float rf_downward = 0.0
rf_downward := rf_filt < rf_filt[1] ? nz(rf_downward[1]) + 1 : rf_filt > rf_filt[1] ? 0 : nz(rf_downward[1])

rf_hband = rf_filt + rf_smrng
rf_lband = rf_filt - rf_smrng

rf_filtcolor = rf_upward > 0 ? rf_upColor : rf_downward > 0 ? rf_downColor : rf_midColor
rf_barcolor = rf_src > rf_filt and rf_src > rf_src[1] and rf_upward > 0 ? rf_upColor : rf_src > rf_filt and rf_src < rf_src[1] and rf_upward > 0 ? rf_upColor : rf_src < rf_filt and rf_src < rf_src[1] and rf_downward > 0 ? rf_downColor : rf_src < rf_filt and rf_src > rf_src[1] and rf_downward > 0 ? rf_downColor : rf_midColor

rf_filtplot = plot(rf_filt, color=rf_filtcolor, linewidth=2, title="Range Filter")
rf_hbandplot = plot(rf_hband, color=color.new(rf_upColor, 70), title="High Target")
rf_lbandplot = plot(rf_lband, color=color.new(rf_downColor, 70), title="Low Target")

fill(rf_hbandplot, rf_filtplot, color=color.new(rf_upColor, 90), title="High Target Range")
fill(rf_lbandplot, rf_filtplot, color=color.new(rf_downColor, 90), title="Low Target Range")

barcolor(rf_barcolor)

rf_longCond = (rf_src > rf_filt and rf_src > rf_src[1] and rf_upward > 0) or (rf_src > rf_filt and rf_src < rf_src[1] and rf_upward > 0)
rf_shortCond = (rf_src < rf_filt and rf_src < rf_src[1] and rf_downward > 0) or (rf_src < rf_filt and rf_src > rf_src[1] and rf_downward > 0)

var int rf_CondIni = 0
rf_CondIni := rf_longCond ? 1 : rf_shortCond ? -1 : nz(rf_CondIni[1])
rf_longCondition = rf_longCond and nz(rf_CondIni[1]) == -1
rf_shortCondition = rf_shortCond and nz(rf_CondIni[1]) == 1

plotshape(rf_longCondition, title="RF Buy Signal", text="Buy", textcolor=color.white, style=shape.labelup, size=size.small, location=location.belowbar, color=color.new(#aaaaaa, 20))
plotshape(rf_shortCondition, title="RF Sell Signal", text="Sell", textcolor=color.white, style=shape.labeldown, size=size.small, location=location.abovebar, color=color.new(rf_downColor, 20))


// -------------------------------------------------------------------------
// COMPONENT 5: SUPERTREND
// -------------------------------------------------------------------------
st_atr2 = ta.sma(ta.tr, st_Periods)
st_atr  = st_changeATR ? ta.atr(st_Periods) : st_atr2

st_up_calc = st_src - (st_Multiplier * st_atr)
var float st_up = na
st_up1 = nz(st_up[1], st_up_calc)
st_up := close[1] > st_up1 ? math.max(st_up_calc, st_up1) : st_up_calc

st_dn_calc = st_src + (st_Multiplier * st_atr)
var float st_dn = na
st_dn1 = nz(st_dn[1], st_dn_calc)
st_dn := close[1] < st_dn1 ? math.min(st_dn_calc, st_dn1) : st_dn_calc

var int st_trend = 1
st_trend := nz(st_trend[1], 1)
st_trend := st_trend == -1 and close > st_dn1 ? 1 : st_trend == 1 and close < st_up1 ? -1 : st_trend

st_upPlot = plot(st_trend == 1 ? st_up : na, title="Up Trend", style=plot.style_linebr, linewidth=2, color=color.green)
st_buySignal = st_trend == 1 and st_trend[1] == -1
plotshape(st_buySignal ? st_up : na, title="ST UpTrend Begins", location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(color.green, 0))
plotshape(st_buySignal and st_showsignals ? st_up : na, title="ST Buy", text="ST Buy", location=location.absolute, style=shape.labelup, size=size.tiny, color=color.new(color.green, 0), textcolor=color.new(color.white, 0))

st_dnPlot = plot(st_trend == 1 ? na : st_dn, title="Down Trend", style=plot.style_linebr, linewidth=2, color=color.red)
st_sellSignal = st_trend == -1 and st_trend[1] == 1
plotshape(st_sellSignal ? st_dn : na, title="ST DownTrend Begins", location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(color.red, 0))
plotshape(st_sellSignal and st_showsignals ? st_dn : na, title="ST Sell", text="ST Sell", location=location.absolute, style=shape.labeldown, size=size.tiny, color=color.new(color.red, 0), textcolor=color.new(color.white, 0))

st_mPlot = plot(ohlc4, title="", style=plot.style_circles, linewidth=1, display=display.none)
st_longFillColor = st_highlight ? (st_trend == 1 ? color.new(color.green, 90) : na) : na
st_shortFillColor = st_highlight ? (st_trend == -1 ? color.new(color.red, 90) : na) : na
fill(st_mPlot, st_upPlot, title="UpTrend Highlighter", color=st_longFillColor)
fill(st_mPlot, st_dnPlot, title="DownTrend Highlighter", color=st_shortFillColor)


// =========================================================================
// =============================== ALERTS ==================================
// =========================================================================

alertcondition(rf_longCondition, title="RF Buy Alert", message="Buy alert on Range Filter")
alertcondition(rf_shortCondition, title="RF Sell Alert", message="Sell alert on Range Filter")
alertcondition(rf_longCondition or rf_shortCondition, title="RF Buy & Sell Alert", message="Buy and Sell alert on Range Filter")

alertcondition(st_buySignal, title="SuperTrend Buy", message="SuperTrend Buy!")
alertcondition(st_sellSignal, title="SuperTrend Sell", message="SuperTrend Sell!")
st_changeCond = st_trend != st_trend[1]
alertcondition(st_changeCond, title="SuperTrend Direction Change", message="SuperTrend has changed direction!")
