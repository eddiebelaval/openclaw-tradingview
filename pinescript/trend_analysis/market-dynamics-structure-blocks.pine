//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  APEX Market Dynamics — Structure & Blocks  [v2.3]
//  PVSRA Vector Candles · BOS/CHoCH · Order Blocks · Breaker Blocks
//  Fair Value Gaps · Premium/Discount · Pattern Detection · EMAs · PSY Levels
// ═══════════════════════════════════════════════════════════════════════════════
indicator("APEX Market Dynamics — Structure & Blocks v2.3", overlay = true,
  max_bars_back    = 500,
  max_lines_count  = 500,
  max_boxes_count  = 400,
  max_labels_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
//  INPUTS
// ─────────────────────────────────────────────────────────────────────────────

grp_vc      = "● VECTOR CANDLES"
i_vc_on     = input.bool(true,   "Enable",                           group = grp_vc)
i_vc_clim   = input.float(2.0,   "Climax Threshold (x avg vol)",     group = grp_vc, minval = 1.1, maxval = 5.0, step = 0.1,
  tooltip = "Volume AND spread >= this multiple of their 20-bar averages.\nClimax = institutional activity. Most important candle type.")
i_vc_rise   = input.float(1.5,   "Rising Threshold (x avg vol)",     group = grp_vc, minval = 1.0, maxval = 4.0, step = 0.1,
  tooltip = "Volume >= this multiple of its 20-bar average (below Climax).\nAbove-average participation.")
c_vc_cu     = input.color(#00FF00, "Climax Up",                      group = grp_vc)
c_vc_cd     = input.color(#FF0000, "Climax Down",                    group = grp_vc)
c_vc_ru     = input.color(#0000FF, "Rising Up",                      group = grp_vc)
c_vc_rd     = input.color(#FF00FF, "Rising Down",                    group = grp_vc)
c_vc_nu     = input.color(#FFFFFF, "Normal Up",                      group = grp_vc)
c_vc_nd     = input.color(#C0C0C0, "Normal Down",                    group = grp_vc)

grp_ms      = "● MARKET STRUCTURE"
i_ms_on     = input.bool(true,   "Enable",                           group = grp_ms)
i_ms_len    = input.int(10,      "Pivot Lookback",                   group = grp_ms, minval = 2, maxval = 50,
  tooltip = "Bars each side of a pivot must be lower/higher to confirm it.")
i_ms_swings = input.bool(true,   "Show HH/HL/LH/LL Labels",         group = grp_ms)
c_bos_b     = input.color(#00bcd4, "BOS Bullish",                    group = grp_ms)
c_bos_r     = input.color(#ef5350, "BOS Bearish",                    group = grp_ms)
c_choch_b   = input.color(#69f0ae, "CHoCH Bullish",                  group = grp_ms)
c_choch_r   = input.color(#ff9800, "CHoCH Bearish",                  group = grp_ms)

grp_ob      = "● ORDER BLOCKS"
i_ob_on     = input.bool(true,   "Enable",                           group = grp_ob,
  tooltip = "Zones where institutions placed large orders.\nBullish OB = buy zone. Bearish OB = sell zone.")
i_ob_max    = input.int(3,       "Max Displayed",                    group = grp_ob, minval = 1, maxval = 8)
i_ob_mit    = input.bool(false,  "Keep Mitigated Blocks",            group = grp_ob)
c_ob_b      = input.color(color.new(#00bcd4, 82), "Bullish OB Fill", group = grp_ob)
c_ob_r      = input.color(color.new(#ef5350, 82), "Bearish OB Fill", group = grp_ob)

grp_brk     = "● BREAKER BLOCKS"
i_brk_on    = input.bool(true,   "Enable",                           group = grp_brk,
  tooltip = "A mitigated OB that flips role.\nBull OB broken = Bear Breaker (resistance).\nBear OB broken = Bull Breaker (support).\nStronger than regular S/R — institutions still interested.")
i_brk_max   = input.int(3,       "Max Displayed",                    group = grp_brk, minval = 1, maxval = 8)
c_brk_b     = input.color(color.new(#7c4dff, 80), "Bull Breaker",    group = grp_brk)
c_brk_r     = input.color(color.new(#ff6d00, 80), "Bear Breaker",    group = grp_brk)

grp_fvg     = "● FAIR VALUE GAPS"
i_fvg_on    = input.bool(true,   "Enable",                           group = grp_fvg,
  tooltip = "3-candle imbalance — market moved too fast and left a gap.\nPrice often returns to fill it.")
i_fvg_max   = input.int(3,       "Max Displayed",                    group = grp_fvg, minval = 1, maxval = 8)
i_fvg_mit   = input.bool(false,  "Keep Filled FVGs",                 group = grp_fvg)
c_fvg_b     = input.color(color.new(#5c6bc0, 91), "Bullish FVG",    group = grp_fvg)
c_fvg_r     = input.color(color.new(#ec407a, 91), "Bearish FVG",    group = grp_fvg)

grp_pd      = "● PREMIUM / DISCOUNT"
i_pd_on     = input.bool(true,   "Enable",                           group = grp_pd,
  tooltip = "Splits recent swing range into 3 bands.\nPremium = sell zone. Discount = buy zone. Equilibrium = avoid.")
i_pd_len    = input.int(50,      "Swing Lookback",                   group = grp_pd, minval = 10, maxval = 500)
c_pd_prem   = input.color(color.new(#ef5350, 88), "Premium",         group = grp_pd)
c_pd_eq     = input.color(color.new(#9e9e9e, 88), "Equilibrium",     group = grp_pd)
c_pd_disc   = input.color(color.new(#26a69a, 88), "Discount",        group = grp_pd)

grp_pat     = "● PATTERN DETECTION"
i_pat_on    = input.bool(true,   "Enable",                           group = grp_pat,
  tooltip = "Auto-detects: Double Top/Bottom, Head & Shoulders, Inv H&S,\nAscending / Descending / Symmetrical Triangles.\nPatterns fire on confirmed pivot points — no repainting.")
i_pat_sim   = input.float(2.0,   "Similarity Threshold %",           group = grp_pat, minval = 0.5, maxval = 8.0, step = 0.5,
  tooltip = "How similar two price levels must be to qualify as matching peaks/troughs.\n2% is conservative. Raise to catch more patterns, lower for fewer false positives.")
i_pat_max   = input.int(5,       "Max Displayed",                    group = grp_pat, minval = 1, maxval = 10)
c_pat_bull  = input.color(color.new(#00e676, 97), "Bullish Pattern", group = grp_pat)
c_pat_bear  = input.color(color.new(#ff5252, 97), "Bearish Pattern", group = grp_pat)
c_pat_neut  = input.color(color.new(#ffeb3b, 97), "Neutral Pattern", group = grp_pat)

grp_dash    = "● DASHBOARD"
i_dash_on   = input.bool(true,   "Show Dashboard",                   group = grp_dash)
i_dash_pos  = input.string("Top Right", "Position",                  group = grp_dash,
  options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"])

grp_ema     = "● EMAs"
i_ema_on    = input.bool(true,   "Show EMAs",                        group = grp_ema)
i_ema9_on   = input.bool(true,   "EMA 9",                            group = grp_ema)
i_ema18_on  = input.bool(true,   "EMA 18",                           group = grp_ema)
i_ema50_on  = input.bool(true,   "EMA 50",                           group = grp_ema)
i_ema200_on = input.bool(true,   "EMA 200",                          group = grp_ema)
c_ema9      = input.color(#FFFFFF,  "EMA 9  Color",                  group = grp_ema)
c_ema18     = input.color(#FFFF00,  "EMA 18 Color",                  group = grp_ema)
c_ema50     = input.color(#00BFFF,  "EMA 50 Color",                  group = grp_ema)
c_ema200    = input.color(#FF4500,  "EMA 200 Color",                 group = grp_ema)
i_cloud_on  = input.bool(true,   "Show EMA 50 Cloud",                group = grp_ema,
  tooltip = "Cloud built around the EMA 50 using EMA(high,50) and EMA(low,50).\nPrice above cloud = bullish. Below = bearish. Inside = transition zone.")
c_cloud_bull = input.color(color.new(#00BFFF, 80), "Cloud Bull Fill", group = grp_ema)
c_cloud_bear = input.color(color.new(#FF4500, 80), "Cloud Bear Fill", group = grp_ema)

grp_psy     = "● PSY WEEKLY LEVELS"
i_psy_on    = input.bool(true,   "Enable",                           group = grp_psy,
  tooltip = "Draws the nearest round-number zone above and below the weekly open price.\nKey psychological levels used in TR methodology.")
i_psy_type  = input.string("Crypto", "Instrument Type",              group = grp_psy, options = ["Crypto", "Forex"])
i_psy_hist  = input.bool(true,   "Show Previous Week",               group = grp_psy)
i_psy_lbls  = input.bool(true,   "Show Labels",                      group = grp_psy)
c_psy       = input.color(#FFFFFF, "Zone Color",                     group = grp_psy)

// ─────────────────────────────────────────────────────────────────────────────
//  GLOBAL SERIES  — all ta.* and request.security() at global scope
// ─────────────────────────────────────────────────────────────────────────────

vol_avg    = ta.sma(volume, 20)
spread_avg = ta.sma(high - low, 20)
pd_hi      = ta.highest(high, i_pd_len)
pd_lo      = ta.lowest(low,   i_pd_len)
ph_raw     = ta.pivothigh(high, i_ms_len, i_ms_len)
pl_raw     = ta.pivotlow(low,   i_ms_len, i_ms_len)
ema9_ser   = ta.ema(close, 9)
ema18_ser  = ta.ema(close, 18)
ema50_ser  = ta.ema(close, 50)
ema200_ser = ta.ema(close, 200)
ema50_hi   = ta.ema(high,  50)
ema50_lo   = ta.ema(low,   50)
psy_wk_t    = request.security(syminfo.tickerid, "W", time)
psy_wk_open = request.security(syminfo.tickerid, "W", open)

// ─────────────────────────────────────────────────────────────────────────────
//  GLOBAL UDFs  — all definitions at global scope
// ─────────────────────────────────────────────────────────────────────────────

f_vol_str(v) =>
    r = v / vol_avg
    r > 3.0 ? "LOUD" : r > 1.5 ? "HIGH" : r > 0.5 ? "MED" : "LOW"

f_vol_col(v) =>
    r = v / vol_avg
    r > 3.0 ? color.new(#ff6d00, 0) : r > 1.5 ? color.new(#ffeb3b, 0) : r > 0.5 ? color.new(#69f0ae, 0) : color.new(#9e9e9e, 0)

f_trim_ob(boxes, vols, mx) =>
    while array.size(boxes) > mx
        box.delete(array.shift(boxes))
        array.shift(vols)

f_trim_box(boxes, mx) =>
    while array.size(boxes) > mx
        box.delete(array.shift(boxes))

f_trim_pat(pboxes, plabels, mx) =>
    while array.size(pboxes) > mx
        box.delete(array.shift(pboxes))
        label.delete(array.shift(plabels))

f_dash_row(d, r, lbl, val, vcol) =>
    table.cell(d, 0, r, " " + lbl + " ",
      text_color = color.new(#90a4ae, 0), text_size = size.small,
      bgcolor    = color.new(#0d0d1a, 5))
    table.cell(d, 1, r, " " + val + " ",
      text_color = vcol, text_size = size.small,
      bgcolor    = color.new(#0d0d1a, 5))

// Pattern helper — are two price levels within pct% of each other?
f_similar(a, b, pct) =>
    math.abs(a - b) / math.max(math.abs(a), math.abs(b)) * 100.0 <= pct

// ─────────────────────────────────────────────────────────────────────────────
//  PERSISTENT STATE
// ─────────────────────────────────────────────────────────────────────────────

var float swing_h      = na
var int   swing_h_idx  = na
var float swing_l      = na
var int   swing_l_idx  = na
var float prev_ph      = na
var float prev_pl      = na
var int   mkt_trend    = 1

// Order blocks
var array<box>   bull_ob_boxes  = array.new<box>()
var array<float> bull_ob_vols   = array.new<float>()
var array<box>   bear_ob_boxes  = array.new<box>()
var array<float> bear_ob_vols   = array.new<float>()

// Breaker blocks
var array<box>   bull_brk_boxes = array.new<box>()
var array<box>   bear_brk_boxes = array.new<box>()

// Fair value gaps
var array<box>   fvg_bull_boxes = array.new<box>()
var array<box>   fvg_bear_boxes = array.new<box>()

// Premium / discount
var box  pd_prem_box  = na
var box  pd_eq_box    = na
var box  pd_disc_box  = na

// Pattern swing history — stores last 8 confirmed pivots of each type
var array<float> sh_vals = array.new<float>()
var array<int>   sh_idxs = array.new<int>()
var array<float> sl_vals = array.new<float>()
var array<int>   sl_idxs = array.new<int>()

// Pattern drawings
var array<box>   pat_boxes  = array.new<box>()
var array<label> pat_labels = array.new<label>()

// PSY state
var int   psy_wk_start = na
var box   psy_h_box    = na
var box   psy_l_box    = na
var label psy_h_lbl    = na
var label psy_l_lbl    = na
var box   psy_ph_box   = na
var box   psy_pl_box   = na
var label psy_ph_lbl   = na
var label psy_pl_lbl   = na

var table dash = na

// ─────────────────────────────────────────────────────────────────────────────
//  VECTOR CANDLES  (PVSRA / Traders Reality)
// ─────────────────────────────────────────────────────────────────────────────

is_bull_c = close >= open
is_climax = volume >= vol_avg * i_vc_clim and (high - low) >= spread_avg * i_vc_clim
is_rising = volume >= vol_avg * i_vc_rise and not is_climax

vc_col   = is_climax and is_bull_c ? c_vc_cu : is_climax and not is_bull_c ? c_vc_cd : is_rising and is_bull_c ? c_vc_ru : is_rising and not is_bull_c ? c_vc_rd : is_bull_c ? c_vc_nu : c_vc_nd
vc_label = is_climax and is_bull_c ? "Climax Buy (institutions)" : is_climax and not is_bull_c ? "Climax Sell (institutions)" : is_rising and is_bull_c ? "Rising Buy" : is_rising and not is_bull_c ? "Rising Sell" : is_bull_c ? "Normal Up" : "Normal Down"

barcolor(i_vc_on ? vc_col : na)

// ─────────────────────────────────────────────────────────────────────────────
//  MARKET STRUCTURE — Swing Labels + history update for pattern detection
// ─────────────────────────────────────────────────────────────────────────────

if not na(ph_raw)
    swing_h     := ph_raw
    swing_h_idx := bar_index[i_ms_len]
    if i_ms_on and i_ms_swings
        is_hh   = not na(prev_ph) and ph_raw > prev_ph
        is_lh   = not na(prev_ph) and ph_raw < prev_ph
        lbl_txt = is_hh ? "HH" : is_lh ? "LH" : "H"
        lbl_tip = is_hh ? "Higher High - uptrend intact" : is_lh ? "Lower High - trend weakening" : "Swing High"
        label.new(bar_index[i_ms_len], ph_raw, lbl_txt,
          xloc      = xloc.bar_index,
          yloc      = yloc.price,
          style     = label.style_none,
          size      = size.tiny,
          textcolor = is_hh ? color.new(#26a69a, 20) : color.new(#ef5350, 20),
          tooltip   = lbl_tip)
    prev_ph := ph_raw
    // Accumulate swing history for pattern detection
    if i_pat_on
        array.push(sh_vals, ph_raw)
        array.push(sh_idxs, bar_index[i_ms_len])
        while array.size(sh_vals) > 8
            array.shift(sh_vals)
            array.shift(sh_idxs)

if not na(pl_raw)
    swing_l     := pl_raw
    swing_l_idx := bar_index[i_ms_len]
    if i_ms_on and i_ms_swings
        is_hl   = not na(prev_pl) and pl_raw > prev_pl
        is_ll   = not na(prev_pl) and pl_raw < prev_pl
        lbl_txt = is_hl ? "HL" : is_ll ? "LL" : "L"
        lbl_tip = is_hl ? "Higher Low - buyers at higher ground" : is_ll ? "Lower Low - downtrend intact" : "Swing Low"
        label.new(bar_index[i_ms_len], pl_raw, lbl_txt,
          xloc      = xloc.bar_index,
          yloc      = yloc.price,
          style     = label.style_none,
          size      = size.tiny,
          textcolor = is_hl ? color.new(#26a69a, 20) : color.new(#ef5350, 20),
          tooltip   = lbl_tip)
    prev_pl := pl_raw
    // Accumulate swing history for pattern detection
    if i_pat_on
        array.push(sl_vals, pl_raw)
        array.push(sl_idxs, bar_index[i_ms_len])
        while array.size(sl_vals) > 8
            array.shift(sl_vals)
            array.shift(sl_idxs)

// ─────────────────────────────────────────────────────────────────────────────
//  MARKET STRUCTURE — BOS / CHoCH
// ─────────────────────────────────────────────────────────────────────────────

bos_up   = i_ms_on and not na(swing_h) and close[1] < swing_h and close >= swing_h
bos_dn   = i_ms_on and not na(swing_l) and close[1] > swing_l and close <= swing_l
choch_up = bos_up and mkt_trend == -1
choch_dn = bos_dn and mkt_trend ==  1

if bos_up or choch_up
    is_ch   = choch_up
    ln_col  = is_ch ? c_choch_b : c_bos_b
    ln_sty  = is_ch ? line.style_solid : line.style_dashed
    ln_wid  = is_ch ? 2 : 1
    lbl_txt = is_ch ? "CHoCH" : "BOS"
    lbl_tip = is_ch ? "Change of Character UP\nPrev trend was DOWN. Price broke a swing high.\nPossible reversal up - wait for confirmation." : "Break of Structure UP\nUptrend continuing. Broke above swing high."
    if not na(swing_h_idx) and not na(swing_h)
        line.new(swing_h_idx, swing_h, bar_index, swing_h,
          xloc  = xloc.bar_index,
          color = ln_col,
          style = ln_sty,
          width = ln_wid)
        label.new(bar_index, swing_h, lbl_txt + " ▲",
          xloc      = xloc.bar_index,
          yloc      = yloc.price,
          style     = label.style_label_left,
          size      = size.tiny,
          color     = color.new(ln_col, 30),
          textcolor = color.white,
          tooltip   = lbl_tip)
    mkt_trend := 1
    swing_h   := na

if bos_dn or choch_dn
    is_ch   = choch_dn
    ln_col  = is_ch ? c_choch_r : c_bos_r
    ln_sty  = is_ch ? line.style_solid : line.style_dashed
    ln_wid  = is_ch ? 2 : 1
    lbl_txt = is_ch ? "CHoCH" : "BOS"
    lbl_tip = is_ch ? "Change of Character DOWN\nPrev trend was UP. Price broke a swing low.\nPossible reversal down - wait for confirmation." : "Break of Structure DOWN\nDowntrend continuing. Broke below swing low."
    if not na(swing_l_idx) and not na(swing_l)
        line.new(swing_l_idx, swing_l, bar_index, swing_l,
          xloc  = xloc.bar_index,
          color = ln_col,
          style = ln_sty,
          width = ln_wid)
        label.new(bar_index, swing_l, lbl_txt + " ▼",
          xloc      = xloc.bar_index,
          yloc      = yloc.price,
          style     = label.style_label_left,
          size      = size.tiny,
          color     = color.new(ln_col, 30),
          textcolor = color.white,
          tooltip   = lbl_tip)
    mkt_trend := -1
    swing_l   := na

// ─────────────────────────────────────────────────────────────────────────────
//  ORDER BLOCKS  + BREAKER BLOCK CREATION ON MITIGATION
// ─────────────────────────────────────────────────────────────────────────────

if i_ob_on and (bos_up or choch_up)
    ob_idx = 0
    for k = 1 to 30
        if close[k] < open[k]
            ob_idx := k
            break
    if ob_idx > 0
        ob_lo  = low[ob_idx]
        ob_hi  = high[ob_idx]
        ob_v   = volume[ob_idx]
        ob_bar = bar_index[ob_idx]
        ob_box = box.new(ob_bar, ob_hi, bar_index + 5, ob_lo,
          bgcolor      = c_ob_b,
          border_color = color.new(#00bcd4, 50),
          border_width = 1)
        label.new(bar_index + 6, (ob_hi + ob_lo) / 2, "B " + f_vol_str(ob_v),
          xloc      = xloc.bar_index,
          yloc      = yloc.price,
          style     = label.style_label_right,
          size      = size.tiny,
          color     = color.new(color.black, 100),
          textcolor = f_vol_col(ob_v),
          tooltip   = "Bullish Order Block | Vol: " + f_vol_str(ob_v) + "\nInstitutional buy zone. Long entries near bottom edge.")
        array.push(bull_ob_boxes, ob_box)
        array.push(bull_ob_vols,  ob_v)
        f_trim_ob(bull_ob_boxes, bull_ob_vols, i_ob_max)

if i_ob_on and (bos_dn or choch_dn)
    ob_idx = 0
    for k = 1 to 30
        if close[k] > open[k]
            ob_idx := k
            break
    if ob_idx > 0
        ob_lo  = low[ob_idx]
        ob_hi  = high[ob_idx]
        ob_v   = volume[ob_idx]
        ob_bar = bar_index[ob_idx]
        ob_box = box.new(ob_bar, ob_hi, bar_index + 5, ob_lo,
          bgcolor      = c_ob_r,
          border_color = color.new(#ef5350, 50),
          border_width = 1)
        label.new(bar_index + 6, (ob_hi + ob_lo) / 2, "S " + f_vol_str(ob_v),
          xloc      = xloc.bar_index,
          yloc      = yloc.price,
          style     = label.style_label_right,
          size      = size.tiny,
          color     = color.new(color.black, 100),
          textcolor = f_vol_col(ob_v),
          tooltip   = "Bearish Order Block | Vol: " + f_vol_str(ob_v) + "\nInstitutional sell zone. Short entries near top edge.")
        array.push(bear_ob_boxes, ob_box)
        array.push(bear_ob_vols,  ob_v)
        f_trim_ob(bear_ob_boxes, bear_ob_vols, i_ob_max)

// Bull OB mitigation — spawn Bear Breaker on close below OB bottom
if i_ob_on
    bi = 0
    while bi < array.size(bull_ob_boxes)
        b       = array.get(bull_ob_boxes, bi)
        ob_hi_v = box.get_top(b)
        ob_lo_v = box.get_bottom(b)
        ob_lb   = box.get_left(b)
        box.set_right(b, bar_index + 5)
        if close < ob_lo_v
            if i_brk_on
                brk = box.new(ob_lb, ob_hi_v, bar_index + 5, ob_lo_v,
                  bgcolor      = c_brk_r,
                  border_color = color.new(#ff6d00, 30),
                  border_width = 2,
                  text         = " BB↓",
                  text_halign  = text.align_left,
                  text_valign  = text.align_top,
                  text_size    = size.tiny,
                  text_color   = color.new(#ff6d00, 10))
                label.new(ob_lb - 1, (ob_hi_v + ob_lo_v) / 2, "Bear Breaker",
                  xloc      = xloc.bar_index,
                  yloc      = yloc.price,
                  style     = label.style_label_right,
                  size      = size.tiny,
                  color     = color.new(color.black, 100),
                  textcolor = color.new(#ff6d00, 0),
                  tooltip   = "Bear Breaker Block\nPreviously a bullish OB. Price broke through it, flipping it to resistance.\nWatch for reactions when price returns to this zone.")
                array.push(bear_brk_boxes, brk)
                f_trim_box(bear_brk_boxes, i_brk_max)
            if i_ob_mit
                box.set_bgcolor(b, color.new(#00bcd4, 96))
                box.set_border_color(b, color.new(#00bcd4, 80))
                bi += 1
            else
                box.delete(b)
                array.remove(bull_ob_boxes, bi)
                array.remove(bull_ob_vols,  bi)
        else
            bi += 1

// Bear OB mitigation — spawn Bull Breaker on close above OB top
if i_ob_on
    ri = 0
    while ri < array.size(bear_ob_boxes)
        b       = array.get(bear_ob_boxes, ri)
        ob_hi_v = box.get_top(b)
        ob_lo_v = box.get_bottom(b)
        ob_lb   = box.get_left(b)
        box.set_right(b, bar_index + 5)
        if close > ob_hi_v
            if i_brk_on
                brk = box.new(ob_lb, ob_hi_v, bar_index + 5, ob_lo_v,
                  bgcolor      = c_brk_b,
                  border_color = color.new(#7c4dff, 30),
                  border_width = 2,
                  text         = " BB↑",
                  text_halign  = text.align_left,
                  text_valign  = text.align_top,
                  text_size    = size.tiny,
                  text_color   = color.new(#7c4dff, 10))
                label.new(ob_lb - 1, (ob_hi_v + ob_lo_v) / 2, "Bull Breaker",
                  xloc      = xloc.bar_index,
                  yloc      = yloc.price,
                  style     = label.style_label_right,
                  size      = size.tiny,
                  color     = color.new(color.black, 100),
                  textcolor = color.new(#7c4dff, 0),
                  tooltip   = "Bull Breaker Block\nPreviously a bearish OB. Price broke through it, flipping it to support.\nWatch for reactions when price returns to this zone.")
                array.push(bull_brk_boxes, brk)
                f_trim_box(bull_brk_boxes, i_brk_max)
            if i_ob_mit
                box.set_bgcolor(b, color.new(#ef5350, 96))
                box.set_border_color(b, color.new(#ef5350, 80))
                ri += 1
            else
                box.delete(b)
                array.remove(bear_ob_boxes, ri)
                array.remove(bear_ob_vols,  ri)
        else
            ri += 1

// Extend breaker boxes to current bar
if i_brk_on
    bk1 = 0
    while bk1 < array.size(bull_brk_boxes)
        box.set_right(array.get(bull_brk_boxes, bk1), bar_index + 5)
        bk1 += 1
    bk2 = 0
    while bk2 < array.size(bear_brk_boxes)
        box.set_right(array.get(bear_brk_boxes, bk2), bar_index + 5)
        bk2 += 1

// ─────────────────────────────────────────────────────────────────────────────
//  FAIR VALUE GAPS
// ─────────────────────────────────────────────────────────────────────────────

bull_fvg_new = i_fvg_on and low > high[2]
bear_fvg_new = i_fvg_on and high < low[2]

if bull_fvg_new
    b = box.new(bar_index[2], low, bar_index + 5, high[2],
      bgcolor      = c_fvg_b,
      border_color = color.new(#5c6bc0, 50),
      border_width = 1)
    array.push(fvg_bull_boxes, b)
    f_trim_box(fvg_bull_boxes, i_fvg_max)

if bear_fvg_new
    b = box.new(bar_index[2], low[2], bar_index + 5, high,
      bgcolor      = c_fvg_r,
      border_color = color.new(#ec407a, 50),
      border_width = 1)
    array.push(fvg_bear_boxes, b)
    f_trim_box(fvg_bear_boxes, i_fvg_max)

if i_fvg_on
    fi = 0
    while fi < array.size(fvg_bull_boxes)
        b   = array.get(fvg_bull_boxes, fi)
        top = box.get_top(b)
        bot = box.get_bottom(b)
        box.set_right(b, bar_index + 5)
        if low < top and low > bot
            box.set_top(b, math.max(bot, low))
        if close <= bot
            if i_fvg_mit
                box.set_bgcolor(b, color.new(#5c6bc0, 97))
                fi += 1
            else
                box.delete(b)
                array.remove(fvg_bull_boxes, fi)
        else
            fi += 1

if i_fvg_on
    ri = 0
    while ri < array.size(fvg_bear_boxes)
        b   = array.get(fvg_bear_boxes, ri)
        top = box.get_top(b)
        bot = box.get_bottom(b)
        box.set_right(b, bar_index + 5)
        if high > bot and high < top
            box.set_bottom(b, math.min(top, high))
        if close >= top
            if i_fvg_mit
                box.set_bgcolor(b, color.new(#ec407a, 97))
                ri += 1
            else
                box.delete(b)
                array.remove(fvg_bear_boxes, ri)
        else
            ri += 1

// ─────────────────────────────────────────────────────────────────────────────
//  PREMIUM / DISCOUNT ZONES
// ─────────────────────────────────────────────────────────────────────────────

if i_pd_on
    rng  = pd_hi - pd_lo
    eqh  = pd_lo + rng * 0.667
    eql  = pd_lo + rng * 0.333
    lb   = bar_index - i_pd_len
    rb   = bar_index + 10

    if na(pd_prem_box)
        pd_prem_box := box.new(lb, pd_hi, rb, eqh,
          bgcolor      = c_pd_prem,
          border_color = color.new(#ef5350, 40),
          border_width = 1,
          text         = "  PREMIUM - Institutional Sell Zone",
          text_halign  = text.align_left,
          text_valign  = text.align_top,
          text_size    = size.tiny,
          text_color   = color.new(#ef5350, 0))
        pd_eq_box := box.new(lb, eqh, rb, eql,
          bgcolor      = c_pd_eq,
          border_color = color.new(#9e9e9e, 40),
          border_width = 1,
          text         = "  EQUILIBRIUM - Fair Value",
          text_halign  = text.align_left,
          text_valign  = text.align_top,
          text_size    = size.tiny,
          text_color   = color.new(#9e9e9e, 0))
        pd_disc_box := box.new(lb, eql, rb, pd_lo,
          bgcolor      = c_pd_disc,
          border_color = color.new(#26a69a, 40),
          border_width = 1,
          text         = "  DISCOUNT - Institutional Buy Zone",
          text_halign  = text.align_left,
          text_valign  = text.align_top,
          text_size    = size.tiny,
          text_color   = color.new(#26a69a, 0))
    else
        box.set_left(pd_prem_box,   lb)
        box.set_top(pd_prem_box,    pd_hi)
        box.set_right(pd_prem_box,  rb)
        box.set_bottom(pd_prem_box, eqh)
        box.set_left(pd_eq_box,     lb)
        box.set_top(pd_eq_box,      eqh)
        box.set_right(pd_eq_box,    rb)
        box.set_bottom(pd_eq_box,   eql)
        box.set_left(pd_disc_box,   lb)
        box.set_top(pd_disc_box,    eql)
        box.set_right(pd_disc_box,  rb)
        box.set_bottom(pd_disc_box, pd_lo)

// ─────────────────────────────────────────────────────────────────────────────
//  PATTERN DETECTION
//
//  Fires on confirmed pivot bars — no repainting.
//  On new swing HIGH → check: Double Top, H&S, Desc Triangle, Sym Triangle
//  On new swing LOW  → check: Double Bottom, iH&S, Asc Triangle
//
//  Requires f_similar() defined above.
//  All array operations use safe index reads with size guards.
// ─────────────────────────────────────────────────────────────────────────────

if i_pat_on and not na(ph_raw)
    n_sh = array.size(sh_vals)
    n_sl = array.size(sl_vals)
    cur_bar = bar_index[i_ms_len]

    // ── DOUBLE TOP ──────────────────────────────────────────────────────────
    // Two similar swing highs with a swing low between them
    if n_sh >= 2 and n_sl >= 1
        h1     = array.get(sh_vals, n_sh - 2)
        h2     = array.get(sh_vals, n_sh - 1)
        h1_bar = array.get(sh_idxs, n_sh - 2)
        h2_bar = array.get(sh_idxs, n_sh - 1)
        l1     = array.get(sl_vals, n_sl - 1)
        l1_bar = array.get(sl_idxs, n_sl - 1)
        nk_ok  = l1_bar > h1_bar and l1_bar < h2_bar
        if f_similar(h1, h2, i_pat_sim) and nk_ok and h1 > l1 and h2 > l1
            pk   = math.max(h1, h2)
            bx   = box.new(h1_bar, pk * 1.001, cur_bar + 5, l1 * 0.999,
              bgcolor      = c_pat_bear,
              border_color = color.new(#ff5252, 45),
              border_width = 1)
            lb   = label.new(cur_bar + 3, l1 + (pk - l1) * 0.6, "▽ DBL TOP",
              xloc      = xloc.bar_index,
              yloc      = yloc.price,
              style     = label.style_label_left,
              size      = size.tiny,
              color     = color.new(color.black, 100),
              textcolor = color.new(#ff5252, 0),
              tooltip   = "Double Top\nTwo similar highs at: " + str.tostring(h1, format.mintick) + " / " + str.tostring(h2, format.mintick) + "\nNeckline: " + str.tostring(l1, format.mintick) + "\nBearish reversal. Watch for break below neckline.")
            array.push(pat_boxes,  bx)
            array.push(pat_labels, lb)
            f_trim_pat(pat_boxes, pat_labels, i_pat_max)

    // ── HEAD & SHOULDERS ───────────────────────────────────────────────────
    // Left shoulder → head (highest) → right shoulder ≈ left shoulder
    // Two neckline lows bracket the head
    if n_sh >= 3 and n_sl >= 2
        ls     = array.get(sh_vals, n_sh - 3)
        hd     = array.get(sh_vals, n_sh - 2)
        rs     = array.get(sh_vals, n_sh - 1)
        ls_bar = array.get(sh_idxs, n_sh - 3)
        hd_bar = array.get(sh_idxs, n_sh - 2)
        rs_bar = array.get(sh_idxs, n_sh - 1)
        nl1     = array.get(sl_vals, n_sl - 2)
        nl2     = array.get(sl_vals, n_sl - 1)
        nl1_bar = array.get(sl_idxs, n_sl - 2)
        nl2_bar = array.get(sl_idxs, n_sl - 1)
        nk_l_ok = nl1_bar > ls_bar and nl1_bar < hd_bar
        nk_r_ok = nl2_bar > hd_bar and nl2_bar < rs_bar
        if hd > ls and hd > rs and f_similar(ls, rs, i_pat_sim * 1.5) and nk_l_ok and nk_r_ok
            nk    = (nl1 + nl2) / 2.0
            pk    = hd
            bx    = box.new(ls_bar, pk * 1.001, cur_bar + 5, nk * 0.999,
              bgcolor      = c_pat_bear,
              border_color = color.new(#ff5252, 45),
              border_width = 1)
            lb    = label.new(cur_bar + 3, nk + (pk - nk) * 0.5, "▽ H&S",
              xloc      = xloc.bar_index,
              yloc      = yloc.price,
              style     = label.style_label_left,
              size      = size.tiny,
              color     = color.new(color.black, 100),
              textcolor = color.new(#ff5252, 0),
              tooltip   = "Head & Shoulders\nLS: " + str.tostring(ls, format.mintick) + "  Head: " + str.tostring(hd, format.mintick) + "  RS: " + str.tostring(rs, format.mintick) + "\nNeckline ~" + str.tostring(nk, format.mintick) + "\nBearish reversal. Break of neckline = entry signal.")
            array.push(pat_boxes,  bx)
            array.push(pat_labels, lb)
            f_trim_pat(pat_boxes, pat_labels, i_pat_max)

    // ── TRIANGLES (checked on new HIGH) ───────────────────────────────────
    if n_sh >= 3 and n_sl >= 3
        h1 = array.get(sh_vals, n_sh - 3)
        h3 = array.get(sh_vals, n_sh - 1)
        l1 = array.get(sl_vals, n_sl - 3)
        l3 = array.get(sl_vals, n_sl - 1)
        h1_bar = array.get(sh_idxs, n_sh - 3)
        h3_bar = array.get(sh_idxs, n_sh - 1)
        l1_bar = array.get(sl_idxs, n_sl - 3)
        l3_bar = array.get(sl_idxs, n_sl - 1)
        lb_bar = math.min(h1_bar, l1_bar)
        rb_bar = cur_bar + 5
        mid_p  = (h1 + l1 + h3 + l3) / 4.0
        highs_flat    = f_similar(h1, h3, i_pat_sim)
        highs_falling = h1 > h3 and not highs_flat
        lows_rising   = l3 > l1 and not f_similar(l1, l3, i_pat_sim)

        if highs_falling and lows_rising
            // Symmetrical Triangle
            bx = box.new(lb_bar, h1 * 1.001, rb_bar, l1 * 0.999,
              bgcolor      = c_pat_neut,
              border_color = color.new(#ffeb3b, 45),
              border_width = 1)
            lb = label.new(cur_bar + 3, mid_p, "◇ SYM TRI",
              xloc      = xloc.bar_index,
              yloc      = yloc.price,
              style     = label.style_label_left,
              size      = size.tiny,
              color     = color.new(color.black, 100),
              textcolor = color.new(#ffeb3b, 0),
              tooltip   = "Symmetrical Triangle\nFalling highs + rising lows converging.\nNeutral — watch for breakout direction.")
            array.push(pat_boxes,  bx)
            array.push(pat_labels, lb)
            f_trim_pat(pat_boxes, pat_labels, i_pat_max)
        else if highs_falling and f_similar(l1, l3, i_pat_sim)
            // Descending Triangle
            bx = box.new(lb_bar, h1 * 1.001, rb_bar, l1 * 0.999,
              bgcolor      = c_pat_bear,
              border_color = color.new(#ff5252, 45),
              border_width = 1)
            lb = label.new(cur_bar + 3, mid_p, "▽ DESC TRI",
              xloc      = xloc.bar_index,
              yloc      = yloc.price,
              style     = label.style_label_left,
              size      = size.tiny,
              color     = color.new(color.black, 100),
              textcolor = color.new(#ff5252, 0),
              tooltip   = "Descending Triangle\nFalling highs + flat lows.\nBearish continuation/reversal. Break below flat low = entry.")
            array.push(pat_boxes,  bx)
            array.push(pat_labels, lb)
            f_trim_pat(pat_boxes, pat_labels, i_pat_max)

if i_pat_on and not na(pl_raw)
    n_sh = array.size(sh_vals)
    n_sl = array.size(sl_vals)
    cur_bar = bar_index[i_ms_len]

    // ── DOUBLE BOTTOM ───────────────────────────────────────────────────────
    // Two similar swing lows with a swing high between them
    if n_sl >= 2 and n_sh >= 1
        l1     = array.get(sl_vals, n_sl - 2)
        l2     = array.get(sl_vals, n_sl - 1)
        l1_bar = array.get(sl_idxs, n_sl - 2)
        l2_bar = array.get(sl_idxs, n_sl - 1)
        h1     = array.get(sh_vals, n_sh - 1)
        h1_bar = array.get(sh_idxs, n_sh - 1)
        nk_ok  = h1_bar > l1_bar and h1_bar < l2_bar
        if f_similar(l1, l2, i_pat_sim) and nk_ok and l1 < h1 and l2 < h1
            bott = math.min(l1, l2)
            bx   = box.new(l1_bar, h1 * 1.001, cur_bar + 5, bott * 0.999,
              bgcolor      = c_pat_bull,
              border_color = color.new(#00e676, 45),
              border_width = 1)
            lb   = label.new(cur_bar + 3, bott + (h1 - bott) * 0.4, "△ DBL BOT",
              xloc      = xloc.bar_index,
              yloc      = yloc.price,
              style     = label.style_label_left,
              size      = size.tiny,
              color     = color.new(color.black, 100),
              textcolor = color.new(#00e676, 0),
              tooltip   = "Double Bottom\nTwo similar lows at: " + str.tostring(l1, format.mintick) + " / " + str.tostring(l2, format.mintick) + "\nNeckline: " + str.tostring(h1, format.mintick) + "\nBullish reversal. Watch for break above neckline.")
            array.push(pat_boxes,  bx)
            array.push(pat_labels, lb)
            f_trim_pat(pat_boxes, pat_labels, i_pat_max)

    // ── INVERSE HEAD & SHOULDERS ───────────────────────────────────────────
    // Left shoulder → head (lowest) → right shoulder ≈ left shoulder
    if n_sl >= 3 and n_sh >= 2
        ls     = array.get(sl_vals, n_sl - 3)
        hd     = array.get(sl_vals, n_sl - 2)
        rs     = array.get(sl_vals, n_sl - 1)
        ls_bar = array.get(sl_idxs, n_sl - 3)
        hd_bar = array.get(sl_idxs, n_sl - 2)
        rs_bar = array.get(sl_idxs, n_sl - 1)
        nl1     = array.get(sh_vals, n_sh - 2)
        nl2     = array.get(sh_vals, n_sh - 1)
        nl1_bar = array.get(sh_idxs, n_sh - 2)
        nl2_bar = array.get(sh_idxs, n_sh - 1)
        nk_l_ok = nl1_bar > ls_bar and nl1_bar < hd_bar
        nk_r_ok = nl2_bar > hd_bar and nl2_bar < rs_bar
        if hd < ls and hd < rs and f_similar(ls, rs, i_pat_sim * 1.5) and nk_l_ok and nk_r_ok
            nk    = (nl1 + nl2) / 2.0
            bott  = hd
            bx    = box.new(ls_bar, nk * 1.001, cur_bar + 5, bott * 0.999,
              bgcolor      = c_pat_bull,
              border_color = color.new(#00e676, 45),
              border_width = 1)
            lb    = label.new(cur_bar + 3, bott + (nk - bott) * 0.5, "△ iH&S",
              xloc      = xloc.bar_index,
              yloc      = yloc.price,
              style     = label.style_label_left,
              size      = size.tiny,
              color     = color.new(color.black, 100),
              textcolor = color.new(#00e676, 0),
              tooltip   = "Inverse Head & Shoulders\nLS: " + str.tostring(ls, format.mintick) + "  Head: " + str.tostring(hd, format.mintick) + "  RS: " + str.tostring(rs, format.mintick) + "\nNeckline ~" + str.tostring(nk, format.mintick) + "\nBullish reversal. Break of neckline = entry signal.")
            array.push(pat_boxes,  bx)
            array.push(pat_labels, lb)
            f_trim_pat(pat_boxes, pat_labels, i_pat_max)

    // ── ASCENDING TRIANGLE (checked on new LOW) ────────────────────────────
    if n_sh >= 3 and n_sl >= 3
        h1 = array.get(sh_vals, n_sh - 3)
        h3 = array.get(sh_vals, n_sh - 1)
        l1 = array.get(sl_vals, n_sl - 3)
        l3 = array.get(sl_vals, n_sl - 1)
        h1_bar = array.get(sh_idxs, n_sh - 3)
        h3_bar = array.get(sh_idxs, n_sh - 1)
        l1_bar = array.get(sl_idxs, n_sl - 3)
        l3_bar = array.get(sl_idxs, n_sl - 1)
        lb_bar = math.min(h1_bar, l1_bar)
        rb_bar = cur_bar + 5
        mid_p  = (h1 + l1 + h3 + l3) / 4.0
        if f_similar(h1, h3, i_pat_sim) and l3 > l1 and not f_similar(l1, l3, i_pat_sim)
            bx = box.new(lb_bar, h1 * 1.001, rb_bar, l1 * 0.999,
              bgcolor      = c_pat_bull,
              border_color = color.new(#00e676, 45),
              border_width = 1)
            lb = label.new(cur_bar + 3, mid_p, "△ ASC TRI",
              xloc      = xloc.bar_index,
              yloc      = yloc.price,
              style     = label.style_label_left,
              size      = size.tiny,
              color     = color.new(color.black, 100),
              textcolor = color.new(#00e676, 0),
              tooltip   = "Ascending Triangle\nFlat highs + rising lows.\nBullish continuation. Break above flat resistance = entry.")
            array.push(pat_boxes,  bx)
            array.push(pat_labels, lb)
            f_trim_pat(pat_boxes, pat_labels, i_pat_max)

// ─────────────────────────────────────────────────────────────────────────────
//  DASHBOARD
// ─────────────────────────────────────────────────────────────────────────────

if i_dash_on
    tpos = i_dash_pos == "Top Right" ? position.top_right : i_dash_pos == "Top Left" ? position.top_left : i_dash_pos == "Bottom Right" ? position.bottom_right : position.bottom_left

    if na(dash)
        dash := table.new(tpos, 2, 9,
          bgcolor      = color.new(#0d0d1a, 5),
          border_color = color.new(#ffffff, 75),
          border_width = 1,
          frame_color  = color.new(#ffffff, 65),
          frame_width  = 1)

    table.cell(dash, 0, 0, "  APEX  STRUCTURE  ",
      text_color = color.new(#e0e0e0, 0),
      text_size  = size.small,
      bgcolor    = color.new(#1a237e, 0))
    table.merge_cells(dash, 0, 0, 1, 0)

    f_dash_row(dash, 1, "Trend", mkt_trend == 1 ? "UP  (Bullish)" : "DOWN  (Bearish)", mkt_trend == 1 ? #26a69a : #ef5350)

    rng_d  = pd_hi - pd_lo
    eqh_d  = pd_lo + rng_d * 0.667
    eql_d  = pd_lo + rng_d * 0.333
    zone_t = close >= eqh_d ? "PREMIUM  (sell zone)" : close <= eql_d ? "DISCOUNT  (buy zone)" : "EQ  (fair value)"
    zone_c = close >= eqh_d ? #ef5350 : close <= eql_d ? #26a69a : #9e9e9e
    f_dash_row(dash, 2, "Zone", zone_t, zone_c)

    f_dash_row(dash, 3, "Candle", vc_label, vc_col)

    vol_r = math.round(volume / vol_avg * 10) / 10
    f_dash_row(dash, 4, "Volume", str.tostring(vol_r) + "x  " + f_vol_str(volume), f_vol_col(volume))

    ms_txt = choch_up ? "CHoCH UP - Reversal?" : choch_dn ? "CHoCH DN - Reversal?" : bos_up ? "BOS UP - Continuing" : bos_dn ? "BOS DN - Continuing" : "No break"
    ms_col = choch_up ? c_choch_b : choch_dn ? c_choch_r : bos_up ? c_bos_b : bos_dn ? c_bos_r : color.new(#546e7a, 0)
    f_dash_row(dash, 5, "Structure", ms_txt, ms_col)

    n_bull = array.size(bull_ob_boxes)
    n_bear = array.size(bear_ob_boxes)
    n_bfvg = array.size(fvg_bull_boxes)
    n_rfvg = array.size(fvg_bear_boxes)
    zones_txt = "B:" + str.tostring(n_bull) + "OB " + str.tostring(n_bfvg) + "FVG  S:" + str.tostring(n_bear) + "OB " + str.tostring(n_rfvg) + "FVG"
    f_dash_row(dash, 6, "Zones", zones_txt, color.new(#b0bec5, 0))

    n_brk = array.size(bull_brk_boxes) + array.size(bear_brk_boxes)
    n_pat = array.size(pat_boxes)
    extra_txt = "Breakers: " + str.tostring(n_brk) + "  |  Patterns: " + str.tostring(n_pat)
    f_dash_row(dash, 7, "Extras", extra_txt, color.new(#ce93d8, 0))

    bull_bias = mkt_trend == 1  and close <= eql_d
    bear_bias = mkt_trend == -1 and close >= eqh_d
    bias_txt  = bull_bias ? "LONG BIAS - Discount + Bull Trend" : bear_bias ? "SHORT BIAS - Premium + Bear Trend" : "Wait - no clear location"
    bias_col  = bull_bias ? #69f0ae : bear_bias ? #ff5252 : color.new(#78909c, 0)
    f_dash_row(dash, 8, "Bias", bias_txt, bias_col)

// ─────────────────────────────────────────────────────────────────────────────
//  EMAs
// ─────────────────────────────────────────────────────────────────────────────

plot(i_ema_on and i_ema9_on   ? ema9_ser   : na, "EMA 9",   color = c_ema9,   linewidth = 1)
plot(i_ema_on and i_ema18_on  ? ema18_ser  : na, "EMA 18",  color = c_ema18,  linewidth = 1)
cloud_col  = i_ema_on and i_cloud_on ? (close > ema50_hi ? c_cloud_bull : close < ema50_lo ? c_cloud_bear : color.new(#9e9e9e, 85)) : na
p_ema50_hi = plot(i_ema_on and i_cloud_on ? ema50_hi : na, "EMA 50 Hi", color = color.new(c_ema50, 70), linewidth = 1)
p_ema50_lo = plot(i_ema_on and i_cloud_on ? ema50_lo : na, "EMA 50 Lo", color = color.new(c_ema50, 70), linewidth = 1)
fill(p_ema50_hi, p_ema50_lo, color = cloud_col)
p_ema50    = plot(i_ema_on and i_ema50_on  ? ema50_ser  : na, "EMA 50",  color = c_ema50,  linewidth = 1)
p_ema200   = plot(i_ema_on and i_ema200_on ? ema200_ser : na, "EMA 200", color = c_ema200, linewidth = 2)

// ─────────────────────────────────────────────────────────────────────────────
//  PSY WEEKLY LEVELS
// ─────────────────────────────────────────────────────────────────────────────

psy_is_new_week = psy_wk_t != psy_wk_t[1] and not na(psy_wk_t[1])
psy_raw_open    = nz(psy_wk_open, open)
psy_inc = i_psy_type == "Forex" ? (psy_raw_open >= 1.0 ? 0.01 : 0.001) : psy_raw_open >= 10000.0 ? 1000.0 : psy_raw_open >= 1000.0 ? 100.0 : psy_raw_open >= 100.0 ? 10.0 : psy_raw_open >= 10.0 ? 1.0 : 0.1
psy_h_lvl = math.ceil(psy_raw_open  / psy_inc) * psy_inc
psy_l_lvl = math.floor(psy_raw_open / psy_inc) * psy_inc
psy_band  = psy_inc * 0.1

if i_psy_on
    if psy_is_new_week
        if i_psy_hist
            if not na(psy_h_box)
                box.set_bgcolor(psy_h_box,      color.new(c_psy, 90))
                box.set_border_color(psy_h_box,  color.new(c_psy, 75))
                box.set_bgcolor(psy_l_box,      color.new(c_psy, 90))
                box.set_border_color(psy_l_box,  color.new(c_psy, 75))
                if not na(psy_ph_box)
                    box.delete(psy_ph_box)
                if not na(psy_pl_box)
                    box.delete(psy_pl_box)
                if not na(psy_ph_lbl)
                    label.delete(psy_ph_lbl)
                if not na(psy_pl_lbl)
                    label.delete(psy_pl_lbl)
                psy_ph_box := psy_h_box
                psy_pl_box := psy_l_box
                psy_ph_lbl := psy_h_lbl
                psy_pl_lbl := psy_l_lbl
        else
            if not na(psy_h_box)
                box.delete(psy_h_box)
                box.delete(psy_l_box)
            if not na(psy_h_lbl)
                label.delete(psy_h_lbl)
                label.delete(psy_l_lbl)
        psy_wk_start := bar_index
        psy_h_box    := na
        psy_l_box    := na
        psy_h_lbl    := na
        psy_l_lbl    := na

    if not na(psy_wk_t) and na(psy_h_box)
        wb = nz(psy_wk_start, bar_index)
        re = bar_index + 3
        psy_h_box := box.new(wb, psy_h_lvl + psy_band, re, psy_h_lvl - psy_band,
          bgcolor      = color.new(c_psy, 80),
          border_color = color.new(c_psy, 50),
          border_width = 1)
        psy_l_box := box.new(wb, psy_l_lvl + psy_band, re, psy_l_lvl - psy_band,
          bgcolor      = color.new(c_psy, 80),
          border_color = color.new(c_psy, 50),
          border_width = 1)
        if i_psy_lbls
            psy_h_lbl := label.new(re, psy_h_lvl, str.tostring(psy_h_lvl, format.mintick),
              xloc      = xloc.bar_index,
              yloc      = yloc.price,
              style     = label.style_label_left,
              size      = size.tiny,
              color     = color.new(color.black, 100),
              textcolor = color.new(c_psy, 10),
              tooltip   = "PSY High\nNearest round number ABOVE the weekly open.\nPrice is attracted to this level.")
            psy_l_lbl := label.new(re, psy_l_lvl, str.tostring(psy_l_lvl, format.mintick),
              xloc      = xloc.bar_index,
              yloc      = yloc.price,
              style     = label.style_label_left,
              size      = size.tiny,
              color     = color.new(color.black, 100),
              textcolor = color.new(c_psy, 10),
              tooltip   = "PSY Low\nNearest round number BELOW the weekly open.\nPrice is attracted to this level.")

    if not na(psy_h_box)
        re = bar_index + 3
        box.set_right(psy_h_box, re)
        box.set_right(psy_l_box, re)
        if i_psy_lbls and not na(psy_h_lbl)
            label.set_x(psy_h_lbl, re)
            label.set_x(psy_l_lbl, re)

// ─────────────────────────────────────────────────────────────────────────────
//  ALERTS
// ─────────────────────────────────────────────────────────────────────────────

alertcondition(bos_up,                      "BOS Bullish",      "BOS: Bullish Break of Structure")
alertcondition(bos_dn,                      "BOS Bearish",      "BOS: Bearish Break of Structure")
alertcondition(choch_up,                    "CHoCH Bullish",    "CHoCH: Possible reversal UP")
alertcondition(choch_dn,                    "CHoCH Bearish",    "CHoCH: Possible reversal DOWN")
alertcondition(bull_fvg_new,                "Bullish FVG",      "New Bullish Fair Value Gap")
alertcondition(bear_fvg_new,                "Bearish FVG",      "New Bearish Fair Value Gap")
alertcondition(is_climax and is_bull_c,     "Climax Buy",       "Vector: Climax Buy - institutional")
alertcondition(is_climax and not is_bull_c, "Climax Sell",      "Vector: Climax Sell - institutional")
alertcondition(bos_dn and i_brk_on,        "Bear Breaker Born","Breaker: New Bear Breaker Block created")
alertcondition(bos_up and i_brk_on,        "Bull Breaker Born","Breaker: New Bull Breaker Block created")

// ─────────────────────────────────────────────────────────────────────────────
//  LEGEND  — Bottom Left
//  One swatch row per feature. Colour cell = visual identity on chart.
// ─────────────────────────────────────────────────────────────────────────────

var table leg = na
if barstate.islast
    if na(leg)
        leg := table.new(position.bottom_left, 3, 17,
          bgcolor      = color.new(#0a0a14, 5),
          border_color = color.new(#ffffff, 70),
          border_width = 1,
          frame_color  = color.new(#ffffff, 60),
          frame_width  = 1)

    // Header
    table.cell(leg, 0, 0, "  STRUCTURE & BLOCKS LEGEND  ",
      text_color = color.new(#e0e0e0, 0), text_size = size.small,
      bgcolor    = color.new(#1a237e, 0))
    table.merge_cells(leg, 0, 0, 2, 0)

    // Column headers
    table.cell(leg, 0, 1, " Color ",   text_color = color.new(#90a4ae, 0), text_size = size.tiny, bgcolor = color.new(#111122, 0))
    table.cell(leg, 1, 1, " Feature ", text_color = color.new(#90a4ae, 0), text_size = size.tiny, bgcolor = color.new(#111122, 0))
    table.cell(leg, 2, 1, " Meaning ", text_color = color.new(#90a4ae, 0), text_size = size.tiny, bgcolor = color.new(#111122, 0))

    // ── Vector Candles
    table.cell(leg, 0, 2, "  ",  bgcolor = color.new(#00FF00, 20), text_size = size.tiny)
    table.cell(leg, 1, 2, " Climax Buy ",   text_color = color.new(#00FF00, 0),  text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))
    table.cell(leg, 2, 2, " Extreme vol + spread — institutions buying ", text_color = color.new(#b0bec5, 0), text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))

    table.cell(leg, 0, 3, "  ",  bgcolor = color.new(#FF0000, 20), text_size = size.tiny)
    table.cell(leg, 1, 3, " Climax Sell ",  text_color = color.new(#FF0000, 0),  text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))
    table.cell(leg, 2, 3, " Extreme vol + spread — institutions selling ", text_color = color.new(#b0bec5, 0), text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))

    table.cell(leg, 0, 4, "  ",  bgcolor = color.new(#0000FF, 20), text_size = size.tiny)
    table.cell(leg, 1, 4, " Rising Buy ",   text_color = color.new(#4fc3f7, 0),  text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))
    table.cell(leg, 2, 4, " Above-avg vol — buyers in control ", text_color = color.new(#b0bec5, 0), text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))

    table.cell(leg, 0, 5, "  ",  bgcolor = color.new(#FF00FF, 20), text_size = size.tiny)
    table.cell(leg, 1, 5, " Rising Sell ",  text_color = color.new(#FF00FF, 0),  text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))
    table.cell(leg, 2, 5, " Above-avg vol — sellers in control ", text_color = color.new(#b0bec5, 0), text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))

    // ── Order Blocks
    table.cell(leg, 0, 6, "  ",  bgcolor = color.new(#00bcd4, 30), text_size = size.tiny)
    table.cell(leg, 1, 6, " Bull Order Block ",  text_color = color.new(#00bcd4, 0),  text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))
    table.cell(leg, 2, 6, " Cyan — institutional buy zone (cyan border) ", text_color = color.new(#b0bec5, 0), text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))

    table.cell(leg, 0, 7, "  ",  bgcolor = color.new(#ef5350, 30), text_size = size.tiny)
    table.cell(leg, 1, 7, " Bear Order Block ",  text_color = color.new(#ef5350, 0),  text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))
    table.cell(leg, 2, 7, " Red — institutional sell zone (red border) ", text_color = color.new(#b0bec5, 0), text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))

    // ── Breaker Blocks
    table.cell(leg, 0, 8, "  ",  bgcolor = color.new(#7c4dff, 30), text_size = size.tiny)
    table.cell(leg, 1, 8, " Bull Breaker BB↑ ", text_color = color.new(#7c4dff, 0),  text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))
    table.cell(leg, 2, 8, " Purple — bear OB flipped to support (thick border) ", text_color = color.new(#b0bec5, 0), text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))

    table.cell(leg, 0, 9, "  ",  bgcolor = color.new(#ff6d00, 30), text_size = size.tiny)
    table.cell(leg, 1, 9, " Bear Breaker BB↓ ", text_color = color.new(#ff6d00, 0),  text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))
    table.cell(leg, 2, 9, " Orange — bull OB flipped to resistance (thick border) ", text_color = color.new(#b0bec5, 0), text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))

    // ── Fair Value Gaps
    table.cell(leg, 0, 10, "  ", bgcolor = color.new(#5c6bc0, 30), text_size = size.tiny)
    table.cell(leg, 1, 10, " Bull FVG ",  text_color = color.new(#5c6bc0, 0),  text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))
    table.cell(leg, 2, 10, " Indigo — bullish price gap, price often returns to fill ", text_color = color.new(#b0bec5, 0), text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))

    table.cell(leg, 0, 11, "  ", bgcolor = color.new(#ec407a, 30), text_size = size.tiny)
    table.cell(leg, 1, 11, " Bear FVG ",  text_color = color.new(#ec407a, 0),  text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))
    table.cell(leg, 2, 11, " Pink — bearish price gap, price often returns to fill ", text_color = color.new(#b0bec5, 0), text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))

    // ── Patterns
    table.cell(leg, 0, 12, "  ", bgcolor = color.new(#00e676, 60), text_size = size.tiny)
    table.cell(leg, 1, 12, " △ Bull Pattern ",   text_color = color.new(#00e676, 0),  text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))
    table.cell(leg, 2, 12, " Green outline — DBL BOT / iH&S / ASC TRI ", text_color = color.new(#b0bec5, 0), text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))

    table.cell(leg, 0, 13, "  ", bgcolor = color.new(#ff5252, 60), text_size = size.tiny)
    table.cell(leg, 1, 13, " ▽ Bear Pattern ",   text_color = color.new(#ff5252, 0),  text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))
    table.cell(leg, 2, 13, " Red outline — DBL TOP / H&S / DESC TRI ", text_color = color.new(#b0bec5, 0), text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))

    table.cell(leg, 0, 14, "  ", bgcolor = color.new(#ffeb3b, 60), text_size = size.tiny)
    table.cell(leg, 1, 14, " ◇ Neutral Pattern ", text_color = color.new(#ffeb3b, 0), text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))
    table.cell(leg, 2, 14, " Yellow outline — SYM TRI (watch breakout direction) ", text_color = color.new(#b0bec5, 0), text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))

    // ── P/D + Structure labels
    table.cell(leg, 0, 15, "  ", bgcolor = color.new(#ef5350, 25), text_size = size.tiny)
    table.cell(leg, 1, 15, " Premium Zone ",  text_color = color.new(#ef5350, 0),  text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))
    table.cell(leg, 2, 15, " Red bg — price overextended, look to sell ", text_color = color.new(#b0bec5, 0), text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))

    table.cell(leg, 0, 16, "  ", bgcolor = color.new(#26a69a, 25), text_size = size.tiny)
    table.cell(leg, 1, 16, " Discount Zone ", text_color = color.new(#26a69a, 0),  text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))
    table.cell(leg, 2, 16, " Green bg — price undervalued, look to buy ", text_color = color.new(#b0bec5, 0), text_size = size.tiny, bgcolor = color.new(#0a0a14, 5))
