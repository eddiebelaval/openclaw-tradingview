//@version=5
indicator(title="S/R Horizontal M5 + M15", shorttitle="S/R Lines", overlay=true, max_lines_count=500, max_labels_count=200)

// ============================================================
//   INPUTS
// ============================================================
grp1 = "── Temporalidades ──"
tf1      = input.timeframe("5",  "Temporalidad 1 (M5)",  group=grp1)
tf2      = input.timeframe("15", "Temporalidad 2 (M15)", group=grp1)

grp2 = "── Pivots ──"
leftBars  = input.int(10, "Velas izquierda", minval=2, maxval=50, group=grp2)
rightBars = input.int(10, "Velas derecha",   minval=2, maxval=50, group=grp2)
maxLevels = input.int(5,  "Máx niveles por TF", minval=1, maxval=10, group=grp2)
lineLen   = input.int(300, "Largo de línea (velas)", minval=50, maxval=1000, group=grp2)
touchPct  = input.float(0.001, "Tolerancia toque (%)", minval=0.0001, maxval=0.01, step=0.0001, group=grp2)

grp3 = "── Estilo ──"
widthTF1  = input.int(2, "Grosor línea TF1 (M5)",  minval=1, maxval=4, group=grp3)
widthTF2  = input.int(2, "Grosor línea TF2 (M15)", minval=1, maxval=4, group=grp3)
styleStr  = input.string("Sólida", "Estilo de línea", options=["Sólida","Punteada","Discontinua"], group=grp3)

grp4 = "── Colores ──"
colSupTF1 = input.color(#2196F3, "Soporte  M5",    group=grp4)
colResTF1 = input.color(#2196F3, "Resistencia M5", group=grp4)
colSupTF2 = input.color(#FF6B35, "Soporte  M15",   group=grp4)
colResTF2 = input.color(#FF6B35, "Resistencia M15",group=grp4)

grp5 = "── Etiquetas ──"
showLabels = input.bool(true,  "Mostrar etiquetas", group=grp5)
showPrice  = input.bool(true,  "Mostrar precio en etiqueta", group=grp5)
showTouches = input.bool(true, "Mostrar conteo de toques",  group=grp5)

// ============================================================
//   ESTILO DE LÍNEA
// ============================================================
getStyle() =>
    styleStr == "Punteada"    ? line.style_dotted :
     styleStr == "Discontinua" ? line.style_dashed  :
     line.style_solid

// ============================================================
//   ARRAYS PARA ALMACENAR LÍNEAS Y LABELS
// ============================================================
var line[]  linesSupTF1 = array.new_line()
var line[]  linesResTF1 = array.new_line()
var line[]  linesSupTF2 = array.new_line()
var line[]  linesResTF2 = array.new_line()
var label[] labelsAll   = array.new_label()

// ============================================================
//   FUNCIÓN: LIMPIAR ARRAYS
// ============================================================
clearLines(arr) =>
    while array.size(arr) > 0
        line.delete(array.pop(arr))

clearLabels(arr) =>
    while array.size(arr) > 0
        label.delete(array.pop(arr))

// ============================================================
//   OBTENER PIVOTS DE CADA TF
// ============================================================
ph_tf1 = request.security(syminfo.tickerid, tf1,
     ta.pivothigh(high, leftBars, rightBars), lookahead=barmerge.lookahead_off)
pl_tf1 = request.security(syminfo.tickerid, tf1,
     ta.pivotlow(low,   leftBars, rightBars), lookahead=barmerge.lookahead_off)

ph_tf2 = request.security(syminfo.tickerid, tf2,
     ta.pivothigh(high, leftBars, rightBars), lookahead=barmerge.lookahead_off)
pl_tf2 = request.security(syminfo.tickerid, tf2,
     ta.pivotlow(low,   leftBars, rightBars), lookahead=barmerge.lookahead_off)

// ============================================================
//   ALMACENAR HISTORIAL DE PIVOTS + CONTEO DE TOQUES
// ============================================================
var float[] histPH_tf1 = array.new_float()
var float[] histPL_tf1 = array.new_float()
var float[] histPH_tf2 = array.new_float()
var float[] histPL_tf2 = array.new_float()

// Arrays paralelos para conteo de toques
var int[] touchesPH_tf1 = array.new_int()
var int[] touchesPL_tf1 = array.new_int()
var int[] touchesPH_tf2 = array.new_int()
var int[] touchesPL_tf2 = array.new_int()

// ── Añadir pivot nuevo o ignorar duplicado ──
addIfNew(arr, touchArr, val) =>
    isDup = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            existing = array.get(arr, i)
            if math.abs(existing - val) / val < 0.0005
                isDup := true
    if not isDup
        array.unshift(arr, val)
        array.unshift(touchArr, 1)   // primer toque = la vela pivot misma
        if array.size(arr) > 20
            array.pop(arr)
            array.pop(touchArr)

// ── Contar toques en tiempo real ──
// Un "toque" ocurre cuando high o low roza el nivel dentro de la tolerancia
countTouches(arr, touchArr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            lvl = array.get(arr, i)
            // Toque alcista: low roza el nivel por debajo
            // Toque bajista: high roza el nivel por arriba
            nearHigh = math.abs(high - lvl) / lvl < touchPct
            nearLow  = math.abs(low  - lvl) / lvl < touchPct
            if nearHigh or nearLow
                currentCount = array.get(touchArr, i)
                array.set(touchArr, i, currentCount + 1)

if not na(ph_tf1)
    addIfNew(histPH_tf1, touchesPH_tf1, ph_tf1)
if not na(pl_tf1)
    addIfNew(histPL_tf1, touchesPL_tf1, pl_tf1)
if not na(ph_tf2)
    addIfNew(histPH_tf2, touchesPH_tf2, ph_tf2)
if not na(pl_tf2)
    addIfNew(histPL_tf2, touchesPL_tf2, pl_tf2)

// Contar toques en cada barra
countTouches(histPH_tf1, touchesPH_tf1)
countTouches(histPL_tf1, touchesPL_tf1)
countTouches(histPH_tf2, touchesPH_tf2)
countTouches(histPL_tf2, touchesPL_tf2)

// ============================================================
//   FUNCIÓN: GROSOR DINÁMICO SEGÚN TOQUES
// ============================================================
dynamicWidth(baseWidth, touches) =>
    touches >= 5 ? math.min(baseWidth + 2, 4) :
     touches >= 3 ? math.min(baseWidth + 1, 4) :
     baseWidth

// ============================================================
//   FUNCIÓN: SÍMBOLO DE FUERZA
// ============================================================
strengthSymbol(touches) =>
    touches >= 5 ? " 🔥" :
     touches >= 3 ? " ⚡" :
     ""

// ============================================================
//   DIBUJAR EN LA ÚLTIMA BARRA
// ============================================================
if barstate.islast

    clearLines(linesSupTF1)
    clearLines(linesResTF1)
    clearLines(linesSupTF2)
    clearLines(linesResTF2)
    clearLabels(labelsAll)

    lstyle = getStyle()

    // ── Dibujar TF1 Resistencias (M5) ──
    count1R = math.min(array.size(histPH_tf1), maxLevels)
    if count1R > 0
        for i = 0 to count1R - 1
            lvl     = array.get(histPH_tf1, i)
            touches = array.get(touchesPH_tf1, i)
            w       = dynamicWidth(widthTF1, touches)
            ln      = line.new(bar_index - lineLen, lvl, bar_index + 15, lvl,
                 color=colResTF1, width=w, style=lstyle)
            array.push(linesResTF1, ln)
            if showLabels
                priceStr   = showPrice   ? str.tostring(lvl, format.mintick) + " " : ""
                touchStr   = showTouches ? "(" + str.tostring(touches) + "🤝)" : ""
                strength   = strengthSymbol(touches)
                txt        = "R M5 " + priceStr + touchStr + strength
                lb = label.new(bar_index + 16, lvl, txt,
                     style=label.style_label_right,
                     color=color.new(colResTF1, 80),
                     textcolor=colResTF1, size=size.small)
                array.push(labelsAll, lb)

    // ── Dibujar TF1 Soportes (M5) ──
    count1S = math.min(array.size(histPL_tf1), maxLevels)
    if count1S > 0
        for i = 0 to count1S - 1
            lvl     = array.get(histPL_tf1, i)
            touches = array.get(touchesPL_tf1, i)
            w       = dynamicWidth(widthTF1, touches)
            ln      = line.new(bar_index - lineLen, lvl, bar_index + 15, lvl,
                 color=colSupTF1, width=w, style=lstyle)
            array.push(linesSupTF1, ln)
            if showLabels
                priceStr   = showPrice   ? str.tostring(lvl, format.mintick) + " " : ""
                touchStr   = showTouches ? "(" + str.tostring(touches) + "🤝)" : ""
                strength   = strengthSymbol(touches)
                txt        = "S M5 " + priceStr + touchStr + strength
                lb = label.new(bar_index + 16, lvl, txt,
                     style=label.style_label_right,
                     color=color.new(colSupTF1, 80),
                     textcolor=colSupTF1, size=size.small)
                array.push(labelsAll, lb)

    // ── Dibujar TF2 Resistencias (M15) ──
    count2R = math.min(array.size(histPH_tf2), maxLevels)
    if count2R > 0
        for i = 0 to count2R - 1
            lvl     = array.get(histPH_tf2, i)
            touches = array.get(touchesPH_tf2, i)
            w       = dynamicWidth(widthTF2, touches)
            ln      = line.new(bar_index - lineLen, lvl, bar_index + 15, lvl,
                 color=colResTF2, width=w, style=lstyle)
            array.push(linesResTF2, ln)
            if showLabels
                priceStr   = showPrice   ? str.tostring(lvl, format.mintick) + " " : ""
                touchStr   = showTouches ? "(" + str.tostring(touches) + "🤝)" : ""
                strength   = strengthSymbol(touches)
                txt        = "R M15 " + priceStr + touchStr + strength
                lb = label.new(bar_index + 16, lvl, txt,
                     style=label.style_label_right,
                     color=color.new(colResTF2, 80),
                     textcolor=colResTF2, size=size.small)
                array.push(labelsAll, lb)

    // ── Dibujar TF2 Soportes (M15) ──
    count2S = math.min(array.size(histPL_tf2), maxLevels)
    if count2S > 0
        for i = 0 to count2S - 1
            lvl     = array.get(histPL_tf2, i)
            touches = array.get(touchesPL_tf2, i)
            w       = dynamicWidth(widthTF2, touches)
            ln      = line.new(bar_index - lineLen, lvl, bar_index + 15, lvl,
                 color=colSupTF2, width=w, style=lstyle)
            array.push(linesSupTF2, ln)
            if showLabels
                priceStr   = showPrice   ? str.tostring(lvl, format.mintick) + " " : ""
                touchStr   = showTouches ? "(" + str.tostring(touches) + "🤝)" : ""
                strength   = strengthSymbol(touches)
                txt        = "S M15 " + priceStr + touchStr + strength
                lb = label.new(bar_index + 16, lvl, txt,
                     style=label.style_label_right,
                     color=color.new(colSupTF2, 80),
                     textcolor=colSupTF2, size=size.small)
                array.push(labelsAll, lb)

// ============================================================
//   ALERTAS
// ============================================================
proxPct = 0.003

nearRes1 = not na(ph_tf1) ? math.abs(close - ph_tf1) / ph_tf1 < proxPct : false
nearSup1 = not na(pl_tf1) ? math.abs(close - pl_tf1) / pl_tf1 < proxPct : false
nearRes2 = not na(ph_tf2) ? math.abs(close - ph_tf2) / ph_tf2 < proxPct : false
nearSup2 = not na(pl_tf2) ? math.abs(close - pl_tf2) / pl_tf2 < proxPct : false

alertcondition(nearRes1, "Resistencia M5 alcanzada", "Precio en Resistencia M5")
alertcondition(nearSup1, "Soporte M5 alcanzado",     "Precio en Soporte M5")
alertcondition(nearRes2, "Resistencia M15 alcanzada","Precio en Resistencia M15")
alertcondition(nearSup2, "Soporte M15 alcanzado",    "Precio en Soporte M15")

// ============================================================
//   FONDO DE ALERTA
// ============================================================
bgColor =
     nearRes2 ? color.new(#FF6B35, 88) :
     nearSup2 ? color.new(#FF6B35, 88) :
     nearRes1 ? color.new(#2196F3, 88) :
     nearSup1 ? color.new(#2196F3, 88) : na

bgcolor(bgColor, title="Alerta zona S/R")
