//@version=5
indicator(title="Smoothed Heiken Ashi Candles MTF", shorttitle="Smoothed HA MTF", overlay=true)

// === SETTINGS ===
string grp_main = "Main Settings"
string target_tf = input.timeframe("240", "Target Timeframe (z.B. 240 für H4, D für Daily)", group=grp_main)
int len1         = input.int(10, "First EMA Length", group=grp_main)
int len2         = input.int(10, "Second EMA Length", group=grp_main)

// === COLOR SETTINGS (Im 'Eingaben' Tab) ===
string grp_col = "Candle Colors"
// Durch den leeren Text "" beim zweiten Input und das gleiche 'inline' landen beide Farbkästchen direkt nebeneinander!
c_up = input.color(color.rgb(0, 255, 0), "Körper (Up/Down)", inline="body", group=grp_col)
c_dn = input.color(color.rgb(255, 0, 0), "", inline="body", group=grp_col)

w_up = input.color(color.rgb(125, 125, 125), "Docht (Up/Down)", inline="wick", group=grp_col)
w_dn = input.color(color.rgb(125, 125, 125), "", inline="wick", group=grp_col)

b_up = input.color(color.rgb(0, 0, 0), "Rahmen (Up/Down)", inline="bord", group=grp_col)
b_dn = input.color(color.rgb(0, 0, 0), "", inline="bord", group=grp_col)


// === CALCULATION FUNCTION ===
f_calc_smoothed_ha(l1, l2) =>
    // 1. Erste Glättung (EMA)
    o = ta.ema(open, l1)
    c = ta.ema(close, l1)
    h = ta.ema(high, l1)
    l = ta.ema(low, l1)

    // 2. Heikin Ashi Berechnung
    haclose = (o + h + l + c) / 4
    
    var float haopen = na
    haopen := na(haopen[1]) ? (o + c) / 2 : (haopen[1] + haclose[1]) / 2
    
    hahigh = math.max(h, math.max(haopen, haclose))
    halow  = math.min(l, math.min(haopen, haclose))

    // 3. Zweite Glättung (EMA)
    o2     = ta.ema(haopen, l2)
    c2     = ta.ema(haclose, l2)
    h2     = ta.ema(hahigh, l2)
    l2_val = ta.ema(halow, l2) 

    [o2, h2, l2_val, c2] 


// === MULTI-TIMEFRAME ABFRAGE ===
[mtf_o, mtf_h, mtf_l, mtf_c] = request.security(syminfo.tickerid, target_tf, f_calc_smoothed_ha(len1, len2))


// === PLOTTING ===
// Wir weisen nun unsere selbst definierten Farben aus den Eingaben zu (Aufwärtskerze = Open <= Close, Abwärts = Open > Close)
color col  = mtf_o <= mtf_c ? c_up : c_dn
color wcol = mtf_o <= mtf_c ? w_up : w_dn
color bcol = mtf_o <= mtf_c ? b_up : b_dn

// editable=false entfernt die unschönen "Farbe 0"-Boxen komplett aus dem "Stil" Tab!
plotcandle(mtf_o, mtf_h, mtf_l, mtf_c, title="Smoothed HA MTF", color=col, wickcolor=wcol, bordercolor=bcol, editable=false)
