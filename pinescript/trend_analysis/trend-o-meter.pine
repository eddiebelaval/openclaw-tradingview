//@version=6
indicator("Trend-o-Meter", shorttitle="TM", overlay=true, max_labels_count=500, max_lines_count=500)

// ========== SETTINGS ==========
lookbackPeriod = input.int(20, "Number of Fractals", minval=5, maxval=50)

showFractals = input.bool(true, "Show Fractals", group="Visualization")
fractalSize = input.string("Small", "Fractal Size", options=["Tiny", "Small", "Normal", "Large"], group="Visualization")

showLines = input.bool(true, "Show Fractal Lines", group="Visualization")
lineWidth = input.int(2, "Line Width", minval=1, maxval=5, group="Visualization")
brokenLineStyle = input.string("Dotted", "Broken Line Style", options=["Solid", "Dotted", "Dashed"], group="Visualization")

tablePosition = input.string("Bottom Right", "Table Position", 
     options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", 
              "Bottom Left", "Bottom Center", "Bottom Right"], group="Visualization")
tableSize = input.string("Normal", "Text Size", options=["Tiny", "Small", "Normal", "Large"], group="Visualization")

textColor = input.color(color.white, "Text Color", group="Colors")
bgColor = input.color(color.new(color.black, 85), "Background Color", group="Colors")
bullColor = input.color(color.new(#00ff00, 0), "Bullish Color", group="Colors")
bearColor = input.color(color.new(#ff0000, 0), "Bearish Color", group="Colors")
bullFractalColor = input.color(color.new(#00ff00, 0), "Bullish Fractal Color", group="Colors")
bearFractalColor = input.color(color.new(#ff0000, 0), "Bearish Fractal Color", group="Colors")
bullLineColor = input.color(color.new(#00ff00, 70), "Bullish Line Color", group="Colors")
bearLineColor = input.color(color.new(#ff0000, 70), "Bearish Line Color", group="Colors")

// ========== FRACTAL DETECTION ==========
upFractal = high[2] > high[0] and high[2] > high[1] and high[2] > high[3] and high[2] > high[4]
downFractal = low[2] < low[0] and low[2] < low[1] and low[2] < low[3] and low[2] < low[4]

// ========== STORAGE ==========
var array<float> fractalHighLevels = array.new<float>()
var array<int> fractalHighBars = array.new<int>()
var array<bool> fractalHighBroken = array.new<bool>()
var array<int> fractalHighBreakBars = array.new<int>()

var array<float> fractalLowLevels = array.new<float>()
var array<int> fractalLowBars = array.new<int>()
var array<bool> fractalLowBroken = array.new<bool>()
var array<int> fractalLowBreakBars = array.new<int>()

// ========== SAVE FRACTALS ON BAR CLOSE ==========
checkDuplicate(arr, val) =>
    bool result = false
    int sz = array.size(arr)
    if sz > 0
        for i = 0 to sz - 1
            if array.get(arr, i) == val
                result := true
                break
    result

if barstate.isconfirmed
    if upFractal and not checkDuplicate(fractalHighBars, bar_index - 2)
        array.push(fractalHighLevels, high[2])
        array.push(fractalHighBars, bar_index - 2)
        array.push(fractalHighBroken, false)
        array.push(fractalHighBreakBars, 0)

    if downFractal and not checkDuplicate(fractalLowBars, bar_index - 2)
        array.push(fractalLowLevels, low[2])
        array.push(fractalLowBars, bar_index - 2)
        array.push(fractalLowBroken, false)
        array.push(fractalLowBreakBars, 0)

    // ========== LIMIT FRACTALS ==========
    int totalFractals = array.size(fractalHighLevels) + array.size(fractalLowLevels)
    while totalFractals > lookbackPeriod
        if array.size(fractalHighLevels) > array.size(fractalLowLevels)
            array.shift(fractalHighLevels)
            array.shift(fractalHighBars)
            array.shift(fractalHighBroken)
            array.shift(fractalHighBreakBars)
        else
            array.shift(fractalLowLevels)
            array.shift(fractalLowBars)
            array.shift(fractalLowBroken)
            array.shift(fractalLowBreakBars)
        totalFractals -= 1

// ========== BREAKOUT ANALYSIS ON BAR CLOSE ==========
bullishBreaks = 0
bearishBreaks = 0

int sizeHighs = array.size(fractalHighLevels)
if sizeHighs > 0
    for i = 0 to sizeHighs - 1
        float lvl = array.get(fractalHighLevels, i)
        bool broken = array.get(fractalHighBroken, i)
        if close > lvl
            if not broken and barstate.isconfirmed
                array.set(fractalHighBroken, i, true)
                array.set(fractalHighBreakBars, i, bar_index)
            bullishBreaks += 1

int sizeLows = array.size(fractalLowLevels)
if sizeLows > 0
    for i = 0 to sizeLows - 1
        float lvl = array.get(fractalLowLevels, i)
        bool broken = array.get(fractalLowBroken, i)
        if close < lvl
            if not broken and barstate.isconfirmed
                array.set(fractalLowBroken, i, true)
                array.set(fractalLowBreakBars, i, bar_index)
            bearishBreaks += 1

// ========== CONVERT SETTINGS ==========
string fSize = size.normal
if fractalSize == "Tiny"
    fSize := size.tiny
else if fractalSize == "Small"
    fSize := size.small
else if fractalSize == "Large"
    fSize := size.large

string bStyle = line.style_dotted
if brokenLineStyle == "Solid"
    bStyle := line.style_solid
else if brokenLineStyle == "Dashed"
    bStyle := line.style_dashed

// ========== VISUALIZATION ==========
var array<label> highLabels = array.new<label>()
var array<label> lowLabels = array.new<label>()
var array<line> highLines = array.new<line>()
var array<line> lowLines = array.new<line>()

if barstate.islast
    int highLabelsSize = array.size(highLabels)
    if highLabelsSize > 0
        for i = 0 to highLabelsSize - 1
            label.delete(array.get(highLabels, i))
    array.clear(highLabels)
    
    int lowLabelsSize = array.size(lowLabels)
    if lowLabelsSize > 0
        for i = 0 to lowLabelsSize - 1
            label.delete(array.get(lowLabels, i))
    array.clear(lowLabels)
    
    int highLinesSize = array.size(highLines)
    if highLinesSize > 0
        for i = 0 to highLinesSize - 1
            line.delete(array.get(highLines, i))
    array.clear(highLines)
    
    int lowLinesSize = array.size(lowLines)
    if lowLinesSize > 0
        for i = 0 to lowLinesSize - 1
            line.delete(array.get(lowLines, i))
    array.clear(lowLines)
    
    if sizeHighs > 0
        for i = 0 to sizeHighs - 1
            float lvl = array.get(fractalHighLevels, i)
            int barIdx = array.get(fractalHighBars, i)
            bool broken = array.get(fractalHighBroken, i)
            int breakBar = array.get(fractalHighBreakBars, i)
            
            if showFractals
                array.push(highLabels, label.new(barIdx, lvl, "▼", 
                     color=color.new(bearFractalColor, 100), textcolor=bearFractalColor, 
                     style=label.style_label_down, size=fSize))
            
            if showLines
                int endBar = broken ? breakBar : bar_index
                string lineStyle = broken ? bStyle : line.style_solid
                array.push(highLines, line.new(barIdx, lvl, endBar, lvl, 
                     color=bearLineColor, style=lineStyle, width=lineWidth))
    
    if sizeLows > 0
        for i = 0 to sizeLows - 1
            float lvl = array.get(fractalLowLevels, i)
            int barIdx = array.get(fractalLowBars, i)
            bool broken = array.get(fractalLowBroken, i)
            int breakBar = array.get(fractalLowBreakBars, i)
            
            if showFractals
                array.push(lowLabels, label.new(barIdx, lvl, "▲", 
                     color=color.new(bullFractalColor, 100), textcolor=bullFractalColor, 
                     style=label.style_label_up, size=fSize))
            
            if showLines
                int endBar = broken ? breakBar : bar_index
                string lineStyle = broken ? bStyle : line.style_solid
                array.push(lowLines, line.new(barIdx, lvl, endBar, lvl, 
                     color=bullLineColor, style=lineStyle, width=lineWidth))

// ========== POWER CALCULATION ==========
int totalBreaks = bullishBreaks + bearishBreaks
float bullishPower = totalBreaks > 0 ? (bullishBreaks / totalBreaks) * 100 : 50
float bearishPower = totalBreaks > 0 ? (bearishBreaks / totalBreaks) * 100 : 50

float dominantPower = math.max(bullishPower, bearishPower)

string strength = "Neutral"
if dominantPower >= 80
    strength := "Very Strong"
else if dominantPower >= 70
    strength := "Strong"
else if dominantPower >= 60
    strength := "Moderate"
else if dominantPower >= 55
    strength := "Weak"

int strengthTrans = 50
if dominantPower >= 80
    strengthTrans := 0
else if dominantPower >= 70
    strengthTrans := 20
else if dominantPower >= 60
    strengthTrans := 40
else if dominantPower >= 55
    strengthTrans := 60

color strengthColor = color.new(color.gray, 50)
if dominantPower == bullishPower
    strengthColor := color.new(bullColor, strengthTrans)
else if dominantPower == bearishPower
    strengthColor := color.new(bearColor, strengthTrans)

string direction = "NEUTRAL"
color directionColor = color.gray
if bullishPower >= 60 and bullishPower > bearishPower
    direction := "LONG"
    directionColor := bullColor
else if bearishPower >= 60 and bearishPower > bullishPower
    direction := "SHORT"
    directionColor := bearColor

// ========== TABLE ==========
string pos = position.bottom_right
if tablePosition == "Top Left"
    pos := position.top_left
else if tablePosition == "Top Center"
    pos := position.top_center
else if tablePosition == "Top Right"
    pos := position.top_right
else if tablePosition == "Middle Left"
    pos := position.middle_left
else if tablePosition == "Middle Center"
    pos := position.middle_center
else if tablePosition == "Middle Right"
    pos := position.middle_right
else if tablePosition == "Bottom Left"
    pos := position.bottom_left
else if tablePosition == "Bottom Center"
    pos := position.bottom_center

string txtSize = size.normal
if tableSize == "Tiny"
    txtSize := size.tiny
else if tableSize == "Small"
    txtSize := size.small
else if tableSize == "Large"
    txtSize := size.large

var table infoTable = table.new(pos, 2, 3, bgcolor=bgColor, border_width=0, frame_width=0)

if barstate.islast
    int bullInt = math.round(bullishPower)
    int bearInt = math.round(bearishPower)
    string balanceText = str.tostring(bullInt) + "/" + str.tostring(bearInt) + "%"
    color balanceColor = bullInt > bearInt ? bullColor : bearInt > bullInt ? bearColor : color.gray
    
    table.cell(infoTable, 0, 0, "Balance:", text_color=textColor, text_size=txtSize, text_halign=text.align_left, bgcolor=bgColor)
    table.cell(infoTable, 1, 0, balanceText, text_color=balanceColor, text_size=txtSize, text_halign=text.align_right, bgcolor=bgColor)
    
    table.cell(infoTable, 0, 1, "Direction:", text_color=textColor, text_size=txtSize, text_halign=text.align_left, bgcolor=bgColor)
    table.cell(infoTable, 1, 1, direction, text_color=directionColor, text_size=txtSize, text_halign=text.align_right, bgcolor=bgColor)
    
    table.cell(infoTable, 0, 2, "Strength:", text_color=textColor, text_size=txtSize, text_halign=text.align_left, bgcolor=bgColor)
    table.cell(infoTable, 1, 2, strength, text_color=strengthColor, text_size=txtSize, text_halign=text.align_right, bgcolor=bgColor)

// ========== ALERTS ==========
alertcondition(ta.crossover(bullishPower, 60), title="🟢 LONG Signal (Moderate+)", message="🟢 LONG Signal ({{ticker}} {{interval}})")
alertcondition(ta.crossover(bullishPower, 70), title="🟢🟢 LONG Signal (Strong+)", message="🟢🟢 STRONG LONG ({{ticker}} {{interval}})")
alertcondition(ta.crossover(bearishPower, 60), title="🔴 SHORT Signal (Moderate+)", message="🔴 SHORT Signal ({{ticker}} {{interval}})")
alertcondition(ta.crossover(bearishPower, 70), title="🔴🔴 SHORT Signal (Strong+)", message="🔴🔴 STRONG SHORT ({{ticker}} {{interval}})")
alertcondition(ta.cross(bullishPower, bearishPower), title="⚖️ Balance Change", message="⚖️ Power Balance Changed ({{ticker}} {{interval}})")
