// ==========================================
// 8. ICT Quarterly & Macros
// ==========================================
group_qt = 'ICT Quarterly & Macros'
show_qt_lines = input.bool(true, 'Show 90m Vertical Lines', group = group_qt)
show_micro_dividers = input.bool(true, 'Show 23m Micro Dividers', group = group_qt)
hide_qt_htf = input.bool(true, 'Auto-Hide QT if TF >= 15m', group = group_qt)
//qt_min50_col = input.color(color.new(color.red, 20), "Minute 50 Line Color", group=group_qt)

qt_start_h = input.int(0, 'Start Hour (NY)', minval = 0, maxval = 23, group = group_qt)
qt_start_m = input.int(0, 'Start Minute', minval = 0, maxval = 59, group = group_qt)
qt_line_col = input.color(color.new(color.gray, 50), 'Q-Divider Color', group = group_qt)
qt_micro_col = input.color(color.new(color.silver, 50), 'Micro Cycle (23m) Color', group = group_qt)
qt_lbl_pos = input.string('Top', 'Q-Label Position', options = ['Top', 'Bottom'], group = group_qt)

// Micro Open Input (Q2 Only)
show_micro_open = input.bool(true, 'Show Q2 Micro Open (1m)', group = group_qt)
micro_open_col = input.color(color.new(color.white, 50), 'Micro Open Color', group = group_qt)

show_features = not hide_qt_htf or timeframe.isintraday and timeframe.multiplier < 15
is_1m = timeframe.isintraday and timeframe.multiplier == 1

ny_h = hour(time, user_tz), ny_m = minute(time, user_tz)
ny_mins_total = ny_h * 60 + ny_m
ny_start_offset = qt_start_h * 60 + qt_start_m
diff_mins = ny_mins_total - ny_start_offset
if diff_mins < 0
    diff_mins := diff_mins + 1440

var float q90_h = high, var float q90_l = low
cycle_index = math.floor(diff_mins / 90)
is_new_90m = cycle_index != cycle_index[1]

// Store Previous (Logic simplified as user wants Current for all)
if is_new_90m
    q90_h := high, q90_l := low
else
    q90_h := math.max(q90_h, high), q90_l := math.min(q90_l, low)

// -- 23-Minute Micro Dividers (Bounded) --
mins_in_cycle = diff_mins % 90
if show_micro_dividers and is_1m and show_features and is_current_week
    
    // Minute 50 Red Line (Bounded)
    //if ny_m == 50
    //    line.new(bar_index, q90_h, bar_index, q90_l, color=qt_min50_col, style=line.style_solid, width=1)

    // Micro Dividers (Q1-Q4)
    bool is_micro = (mins_in_cycle % 23 == 0 or mins_in_cycle == 0)
    if is_micro
        line.new(bar_index, q90_h, bar_index, q90_l, color = qt_micro_col, style = line.style_dotted)

        // Label Logic
        string _txt = switch
            mins_in_cycle == 0 => "Q1"
            mins_in_cycle == 23 => "Q2"
            mins_in_cycle == 46 => "Q3"
            => "Q4"
        
        float _yloc = qt_lbl_pos == "Top" ? q90_h : q90_l
        string _style = qt_lbl_pos == "Top" ? label.style_label_down : label.style_label_up
        
        label.new(bar_index, _yloc, _txt, color = color.new(color.white, 100), textcolor = qt_micro_col, style = _style, size = size.tiny)

// -- Micro Open --
if show_micro_open and is_1m and show_features and is_current_week
    if mins_in_cycle == 23
        line.new(bar_index, open, bar_index + 22, open, color = micro_open_col)

q_num = (cycle_index % 4) + 1
amdx_str = switch q_num
    1 => 'Accumulation'
    2 => 'Manipulation'
    3 => 'Distribution'
    4 => 'Reversal/Exp'
    => ''

if show_qt_lines and is_new_90m and show_features and is_current_week
    // Q1 Label only (Line is handled in Micro loop)
    float _lbl_val = qt_lbl_pos == "Top" ? q90_h : q90_l
    string _lbl_txt = "Q" + str.tostring(q_num) + "\n" + amdx_str
    
    if not na(_lbl_val)
        label.new(bar_index, _lbl_val, _lbl_txt, color = color.new(color.white, 100), textcolor = qt_line_col, style = label.style_none, size = size.small)


// ==========================================
// 9. INVERSION FVG 
// ==========================================
group_ifvg = 'Inversion FVG'
ifvg_disp_num = input.int(5, maxval = 100, minval = 1, title = "Show Last", group=group_ifvg)
ifvg_wt = false 
ifvg_atr_multi = input.float(0.25, step = 0.25, minval = 0, title = "ATR Multiplier", group=group_ifvg)
ifvg_green = input.color(color.new(#089981, 80), title = "Bull IFVG Color", group=group_ifvg)
ifvg_red = input.color(color.new(#f23645, 80), title = "Bear IFVG Color", group=group_ifvg)
ifvg_gray = input.color(#787b86, title = "Midline Color", group=group_ifvg)
ifvg_invis = color.rgb(0,0,0,100)

// --- GLOBAL ARRAYS FOR CLEANUP (ป้องกันการวาดซ้อน) ---
var array<box> ifvg_draw_boxes = array.new_box()
var array<line> ifvg_draw_lines = array.new_line()
var array<label> ifvg_draw_labels = array.new_label()

// TYPE DEFINITIONS (Correct for v6)
type ifvg_lab 
    int x
    float y
    int dir
type ifvg_data 
    int left
    float top
    int right
    float bot
    float mid
    int dir
    int state
    array<ifvg_lab> labs
    int x_val

// IFVG HELPER FUNCTIONS
ifvg_label_maker(_x,_y,_dir) => 
    label lbl = na
    switch
        _dir == 1 => lbl := label.new(_x,_y,"\n▲", style = label.style_text_outline, color = ifvg_invis, textcolor = color.new(ifvg_green,0), size = size.small, xloc = xloc.bar_time)
        _dir == -1 => lbl := label.new(_x,_y, "▼\n", style = label.style_text_outline, color = ifvg_invis, textcolor = color.new(ifvg_red,0), size = size.small, xloc = xloc.bar_time)
    if not na(lbl)
        array.push(ifvg_draw_labels, lbl)

ifvg_fvg_manage(_ary, _inv_ary) => 
    _buffer = 100
    c_top = math.max(open,close)
    c_bot = math.min(open,close)
    if _ary.size() >= _buffer
        _ary.shift()
    if _ary.size() > 0
        for i = _ary.size()-1 to 0
            value = _ary.get(i)
            _dir = value.dir
            if _dir == 1 and (c_bot < value.bot)
                value.x_val := time
                _inv_ary.push(_ary.remove(i))
            if _dir == -1 and (c_top > value.top)
                value.x_val := time
                _inv_ary.push(_ary.remove(i))

ifvg_inv_manage(_ary) => 
    _buffer = 100
    c_top = math.max(open,close)
    c_bot = math.min(open,close)
    fire = false
    
    if _ary.size() >= _buffer
        _ary.shift()
    if _ary.size() > 0
        for i = _ary.size()-1 to 0
            value = _ary.get(i)
            bx_top = value.top
            bx_bot = value.bot
            _dir = value.dir
            st = value.state

            if (st == 0 and _dir == 1)
                value.state := 1
                value.dir := -1
            if (_dir == -1 and st == 0)
                value.state := 1
                value.dir := 1
            if st >= 1
                value.right := time
            if (_dir == -1 and st == 1 and close < bx_bot and (ifvg_wt?high:close[1]) >= bx_bot and (ifvg_wt?high:close[1]) < bx_top)
                value.labs.push(ifvg_lab.new(time,bx_top,-1))
                fire := true
            if (_dir == 1 and st == 1 and close > bx_top and (ifvg_wt?low:close[1]) <= bx_top and (ifvg_wt?low:close[1]) > bx_bot)
                value.labs.push(ifvg_lab.new(time,bx_bot,1))
                fire := true
            if st >= 1 and ((_dir == -1 and c_top > bx_top) or (_dir == 1 and c_bot < bx_bot))
                _ary.remove(i)
    fire

ifvg_send_it(_ary) => 
    last_index = _ary.size()-1
    for [index,value] in _ary
        bx_top = value.top
        bx_bot = value.bot
        bx_left = value.left
        xval = value.x_val
        mid = value.mid
        col = value.dir == -1 ? ifvg_green : ifvg_red
        o_col = value.dir == -1 ? ifvg_red : ifvg_green
        if index > last_index - ifvg_disp_num
            // Push created objects into arrays
            array.push(ifvg_draw_boxes, box.new(bx_left,bx_top,xval,bx_bot,bgcolor = col, border_color = ifvg_invis, xloc = xloc.bar_time))
            array.push(ifvg_draw_boxes, box.new(xval,bx_top,time,bx_bot, bgcolor = o_col, border_color = ifvg_invis, xloc = xloc.bar_time))
            array.push(ifvg_draw_lines, line.new(bx_left,mid,time,mid, color = ifvg_gray, style = line.style_dashed, xloc = xloc.bar_time))
            
            // Extension boxes/lines
            array.push(ifvg_draw_boxes, box.new(bar_index,bx_top,bar_index+50,bx_bot, bgcolor = o_col, border_color = ifvg_invis))
            array.push(ifvg_draw_lines, line.new(bar_index,mid,bar_index+50,mid, color = ifvg_gray, style = line.style_dashed))
            
            for stuff in value.labs
                ifvg_label_maker(stuff.x,stuff.y,stuff.dir)

// IFVG MAIN LOGIC
var bull_fvg_ary = array.new<ifvg_data>(na)
var bear_fvg_ary = array.new<ifvg_data>(na)
var bull_inv_ary = array.new<ifvg_data>(na)
var bear_inv_ary = array.new<ifvg_data>(na)

ifvg_atr = nz(ta.atr(200)*ifvg_atr_multi, ta.cum(high - low) / (bar_index+1))
fvg_up = (low > high[2]) and (close[1] > high[2])
fvg_down = (high < low[2]) and (close[1] < low[2])

if fvg_up and math.abs(low-high[2]) > ifvg_atr
    array.push(bull_fvg_ary,ifvg_data.new(time[1], low, time, high[2], math.avg(low,high[2]), 1, 0,array.new<ifvg_lab>(na),na))
if fvg_down and math.abs(low[2]-high) > ifvg_atr
    array.push(bear_fvg_ary,ifvg_data.new(time[1], low[2], time, high, math.avg(high,low[2]),-1 ,0,array.new<ifvg_lab>(na),na))

ifvg_fvg_manage(bull_fvg_ary,bull_inv_ary)
ifvg_fvg_manage(bear_fvg_ary,bear_inv_ary)
bear_signal = ifvg_inv_manage(bull_inv_ary)
bull_signal = ifvg_inv_manage(bear_inv_ary)

if barstate.islast
    // CLEANUP OLD DRAWINGS BEFORE DRAWING NEW ONES
    while ifvg_draw_boxes.size() > 0 
        box.delete(ifvg_draw_boxes.pop())
    while ifvg_draw_lines.size() > 0 
        line.delete(ifvg_draw_lines.pop())
    while ifvg_draw_labels.size() > 0
        label.delete(ifvg_draw_labels.pop())

    ifvg_send_it(bull_inv_ary)
    ifvg_send_it(bear_inv_ary)

// ==========================================
// 6. FRACTAL SIDEBAR & HTF GRID
// ==========================================
group_frac = 'Fractal Sidebar & HTF Grid'
show_sidebar = input.bool(true, 'Show Sidebar', group = group_frac)
show_htf_grid_v = input.bool(true, 'Show HTF Vertical Lines', group = group_frac)
show_htf_grid_hl = input.bool(true, 'Show HTF High/Low Lines', group = group_frac)
htf_tf = input.string('480', 'HTF Timeframe', group = group_frac)
sidebar_cnt = input.int(3, 'Count (Sidebar & Grid)', group = group_frac)
sb_width_adj = input.int(2, 'Sidebar Width', group = group_frac)
sb_offset_x = input.int(15, 'Sidebar X-Offset', group = group_frac)

bull_col = input.color(color.new(#089981, 50), 'Bull', group = group_frac)
bear_col = input.color(color.new(#f23645, 50), 'Bear', group = group_frac)
htf_grid_col = input.color(color.new(color.gray, 70), 'Grid Line Color', group = group_frac)

[h_o, h_h, h_l, h_c, h_close_time, h_open_time] = request.security(syminfo.tickerid, htf_tf, [open, high, low, close, time_close, time], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
new_htf = ta.change(time(htf_tf))

var array<float> hist_o = array.new_float(0)
var array<float> hist_h = array.new_float(0)
var array<float> hist_l = array.new_float(0)
var array<float> hist_c = array.new_float(0)
var array<int> hist_t = array.new_int(0)

// --- HTF GRID LOGIC ---
var int last_htf_start_idx = na
var array<line> htf_grid_lines = array.new_line()

if bool(new_htf)
    array.push(hist_o, h_o[1])
    array.push(hist_h, h_h[1])
    array.push(hist_l, h_l[1])
    array.push(hist_c, h_c[1])
    array.push(hist_t, h_open_time[1])
    if array.size(hist_o) > sidebar_cnt - 1
        array.shift(hist_o)
        array.shift(hist_h)
        array.shift(hist_l)
        array.shift(hist_c)
        array.shift(hist_t)

    // HTF Grid
    if is_current_week
        if show_htf_grid_v
            array.push(htf_grid_lines, line.new(bar_index, close, bar_index, close, extend=extend.both, color=htf_grid_col, style=line.style_dotted))
        
        if show_htf_grid_hl and not na(last_htf_start_idx)
            float _prev_h = h_h[1]
            float _prev_l = h_l[1]
            array.push(htf_grid_lines, line.new(last_htf_start_idx, _prev_h, bar_index, _prev_h, color=color.new(htf_grid_col, 50)))
            array.push(htf_grid_lines, line.new(last_htf_start_idx, _prev_l, bar_index, _prev_l, color=color.new(htf_grid_col, 50)))

    // Cleanup
    int max_grid_lines = sidebar_cnt * 3 + 3 
    while array.size(htf_grid_lines) > max_grid_lines
        line.delete(array.shift(htf_grid_lines))

    last_htf_start_idx := bar_index

// Sidebar Drawing
var array<box> sb_boxes = array.new_box()
var array<line> sb_lines = array.new_line()
var array<label> sb_labels = array.new_label()

if show_sidebar and barstate.islast
    while array.size(sb_boxes) > 0
        box.delete(array.pop(sb_boxes))
    while array.size(sb_lines) > 0
        line.delete(array.pop(sb_lines))
    while array.size(sb_labels) > 0
        label.delete(array.pop(sb_labels))

    sb_start_offset = sb_offset_x
    sb_spacing = sb_width_adj + 2

    if array.size(hist_o) > 0
        for i = 0 to array.size(hist_o) - 1
            _o = array.get(hist_o, i), _h = array.get(hist_h, i), _l = array.get(hist_l, i), _c = array.get(hist_c, i), _t = array.get(hist_t, i)
            _col = _c >= _o ? bull_col : bear_col
            _bor_curr = _c >= _o ? color.black : color.black
            _x = bar_index + sb_start_offset + i * sb_spacing
            _body_top = math.max(_o, _c), _body_btm = math.min(_o, _c)
            _center_x = _x + math.floor(sb_width_adj / 2)

            array.push(sb_boxes, box.new(_x, _o, _x + sb_width_adj, _c, border_color = _bor_curr, bgcolor = _col, xloc = xloc.bar_index))
            if _h > _body_top
                array.push(sb_lines, line.new(_center_x, _h, _center_x, _body_top, color = _bor_curr, xloc = xloc.bar_index))
            if _l < _body_btm
                array.push(sb_lines, line.new(_center_x, _l, _center_x, _body_btm, color = _bor_curr, xloc = xloc.bar_index))
            _hr = hour(_t, user_tz), _mn = minute(_t, user_tz)
            array.push(sb_labels, label.new(_center_x, _l, str.format('{0,number,00}:{1,number,00}', _hr, _mn), color = color.new(color.white, 100), textcolor = color.gray, style = label.style_label_up, size = size.tiny))

    current_idx = array.size(hist_o)
    _x_curr = bar_index + sb_start_offset + current_idx * sb_spacing
    _col_curr = h_c >= h_o ? bull_col : bear_col
    _bor_curr = h_c >= h_o ? color.black : color.black
    _curr_body_top = math.max(h_o, h_c), _curr_body_btm = math.min(h_o, h_c)
    _center_curr = _x_curr + math.floor(sb_width_adj / 2)

    array.push(sb_boxes, box.new(_x_curr, h_o, _x_curr + sb_width_adj, h_c, border_color = _bor_curr, bgcolor = _col_curr, xloc = xloc.bar_index))
    if h_h > _curr_body_top
        array.push(sb_lines, line.new(_center_curr, h_h, _center_curr, _curr_body_top, color = _bor_curr, xloc = xloc.bar_index))
    if h_l < _curr_body_btm
        array.push(sb_lines, line.new(_center_curr, h_l, _center_curr, _curr_body_btm, color = _bor_curr, xloc = xloc.bar_index))

    _hr_curr = hour(h_open_time, user_tz), _mn_curr = minute(h_open_time, user_tz)
    array.push(sb_labels, label.new(_center_curr, h_l, str.format('{0,number,00}:{1,number,00}', _hr_curr, _mn_curr), color = color.new(color.white, 100), textcolor = color.gray, style = label.style_label_up, size = size.tiny))

    time_remaining = h_close_time - timenow
    if time_remaining < 0
        time_remaining := 0
    seconds = math.floor(time_remaining / 1000)
    mm = math.floor(seconds / 60), hh = math.floor(mm / 60)
    s_rem = seconds % 60, m_rem = mm % 60
    
    array.push(sb_labels, label.new(_center_curr, h_h, 'TF: ' + htf_tf + '\n' + str.format('{0,number,00}:{1,number,00}:{2,number,00}', hh, m_rem, s_rem), color = color.new(color.white, 100), textcolor = _bor_curr, style = label.style_label_down, size = size.small))

// ==========================================
// 13. SWING STRUCTURE
// ==========================================
group_swing = 'Swing Structure Settings'

// 1. Inputs
swingLength = input.int(5, "Swing Length", minval=2, group=group_swing)
showSwingHL = input.bool(true, "Show Swing High/Low Points", group=group_swing)
showSwingHistory = input.bool(true, "Show Historical Swings (Ignore Clean Mode)", group=group_swing) // NEW TOGGLE
swingHighColor = input.color(color.red, "Swing High Color", group=group_swing)
swingLowColor = input.color(color.green, "Swing Low Color", group=group_swing)

// 2. Logic
bool swingHighDetected = high[swingLength] == ta.highest(high, swingLength * 2 + 1)
bool swingLowDetected = low[swingLength] == ta.lowest(low, swingLength * 2 + 1)

// Store swing levels
var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na
var float prevSwingHigh = na
var float prevSwingLow = na

if swingHighDetected
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := high[swingLength]
    lastSwingHighBar := bar_index - swingLength

if swingLowDetected
    prevSwingLow := lastSwingLow
    lastSwingLow := low[swingLength]
    lastSwingLowBar := bar_index - swingLength

// 3. Visualization
// Condition: Show if Swings are enabled AND (History is allowed OR it's current week)
bool show_swing_final = showSwingHL and (showSwingHistory ? true : is_current_week)

plotshape(show_swing_final and swingHighDetected ? high[swingLength] : na, "Swing High", 
           shape.triangledown, location.abovebar, swingHighColor, offset=-swingLength, size=size.tiny)

plotshape(show_swing_final and swingLowDetected ? low[swingLength] : na, "Swing Low", 
           shape.triangleup, location.belowbar, swingLowColor, offset=-swingLength, size=size.tiny)

// ==========================================
// 12. WATERMARK
// ==========================================
group_wm = 'Watermark'
wm_title = input.string('GodMode Krub', 'Title', group = group_wm)
wm_sub = input.string('WAIT → CONFIRM → EXECUTE → ACCEPT', 'Subtitle', group = group_wm)
wm_sym_show = input.bool(true, 'Show Symbol Info', group = group_wm)

wm_pos_v = input.string('bottom', 'Vertical Pos', options = ['top', 'middle', 'bottom'], group = group_wm)
wm_pos_h = input.string('right', 'Horizontal Pos', options = ['left', 'center', 'right'], group = group_wm)

wm_col_t = input.color(color.new(color.gray, 60), 'Title Color', group = group_wm)
wm_col_s = input.color(color.new(color.gray, 70), 'Sub/Sym Color', group = group_wm)
wm_sz_t = input.string('large', 'Title Size', options = ['tiny', 'small', 'normal', 'large', 'huge'], group = group_wm)
wm_sz_s = input.string('normal', 'Sub/Sym Size', options = ['tiny', 'small', 'normal', 'large', 'huge'], group = group_wm)

wm_sym_txt = syminfo.ticker + ' | ' + timeframe.period + (timeframe.isintraday ? 'M' : '')
wm_date_txt = str.tostring(dayofmonth(time)) + '/' + str.tostring(month(time)) + '/' + str.tostring(year(time))

var table wm_tbl = table.new(get_wm_pos(wm_pos_v, wm_pos_h), 1, 3)
if barstate.islast
    table.cell(wm_tbl, 0, 0, wm_title, text_color = wm_col_t, text_size = wm_sz_t, text_halign = get_wm_align(wm_pos_h))
    table.cell(wm_tbl, 0, 1, wm_sub, text_color = wm_col_s, text_size = wm_sz_s, text_halign = get_wm_align(wm_pos_h))
    if wm_sym_show
        table.cell(wm_tbl, 0, 2, wm_sym_txt + '  ' + wm_date_txt, text_color = wm_col_s, text_size = wm_sz_s, text_halign = get_wm_align(wm_pos_h))

// ==========================================
// 14. ROUND NUMBERS (GOLD SPECIAL)
// ==========================================
group_rn = 'Round Numbers (Gold)'
show_rn = input.bool(true, 'Show Round Numbers', group=group_rn)
rn_step = input.float(5.0, 'Price Increment ($)', tooltip='Distance between lines (e.g., 5, 10, 100)', group=group_rn)
rn_count = input.int(5, 'Line Count (+/-)', minval=1, maxval=20, group=group_rn)
rn_col = input.color(color.new(color.gray, 50), 'Line Color', group=group_rn)
rn_style = input.string('Dashed', 'Line Style', options=['Solid', 'Dotted', 'Dashed'], group=group_rn)

var array<line> rn_lines = array.new_line()

if barstate.islast and show_rn
    // Cleanup old lines
    while rn_lines.size() > 0
        line.delete(rn_lines.pop())
        
    // Calculate Base
    float base_pr = math.round(close / rn_step) * rn_step
    
    // Draw Center
    rn_lines.push(line.new(bar_index, base_pr, bar_index + 1, base_pr, extend=extend.both, color=rn_col, style=get_line_style(rn_style)))
    
    // Draw Upper & Lower
    for i = 1 to rn_count
        float p_up = base_pr + (i * rn_step)
        float p_dn = base_pr - (i * rn_step)
        rn_lines.push(line.new(bar_index, p_up, bar_index + 1, p_up, extend=extend.both, color=rn_col, style=get_line_style(rn_style)))
        rn_lines.push(line.new(bar_index, p_dn, bar_index + 1, p_dn, extend=extend.both, color=rn_col, style=get_line_style(rn_style)))
