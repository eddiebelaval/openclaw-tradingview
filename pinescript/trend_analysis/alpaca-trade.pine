// --- S3 NY ---
s3_t = input.session('0800-1100', 'S3 Time', group = group_sess)
s3_show_box = input.bool(true, 'Show NY Box', group = group_sess)
s3_n = input.string('NY', 'S3 Name', group = group_sess)
s3_c = input.color(color.new(color.orange, 30), 'S3 Color', group = group_sess)
s3_w = input.int(1, 'S3 Width', group = group_sess), s3_st = input.string('Solid', 'S3 Style', options = ['Solid', 'Dotted', 'Dashed'], group = group_sess)

var line s3_lh=na, var line s3_ll=na, var line s3_lm=na, var label s3_lbh=na, var label s3_lbl=na, var box s3_bx=na
var float s3_h=na, var float s3_l=na, var bool s3_hsw=true, var bool s3_lsw=true, var bool s3_act=false
in_s3 = not na(time(timeframe.period, s3_t, user_tz))

if is_sess_visible
    if is_cutoff
        s3_hsw := true, s3_lsw := true, s3_act := false
    if in_s3
        if not in_s3[1]
            s3_h := high, s3_l := low, s3_hsw := false, s3_lsw := false, s3_act := true
