        else
            s1_h := math.max(s1_h, high), s1_l := math.min(s1_l, low)
            line.set_y1(s1_lh, s1_h), line.set_y2(s1_lh, s1_h), line.set_x2(s1_lh, bar_index)
            line.set_y1(s1_ll, s1_l), line.set_y2(s1_ll, s1_l), line.set_x2(s1_ll, bar_index)
            if show_mean and not na(s1_lm)
                _mid = (s1_h + s1_l) / 2
                line.set_y1(s1_lm, _mid), line.set_y2(s1_lm, _mid), line.set_x2(s1_lm, bar_index)
            label.set_xy(s1_lbh, bar_index, s1_h), label.set_xy(s1_lbl, bar_index, s1_l)
            if s1_show_box
                box.set_top(s1_bx, s1_h), box.set_bottom(s1_bx, s1_l), box.set_right(s1_bx, bar_index)
    else if s1_act
        if not s1_hsw
            line.set_x2(s1_lh, bar_index), label.set_x(s1_lbh, bar_index)
            if high > s1_h
                s1_hsw := true
        if not s1_lsw
            line.set_x2(s1_ll, bar_index), label.set_x(s1_lbl, bar_index)
            if low < s1_l
                s1_lsw := true
        if show_mean and not na(s1_lm) and (not s1_hsw or not s1_lsw)
            line.set_x2(s1_lm, bar_index)

// --- S2 London ---
s2_t = input.session('0200-0600', 'S2 Time', group = group_sess)
s2_show_box = input.bool(true, 'Show London Box', group = group_sess)
s2_n = input.string('London', 'S2 Name', group = group_sess)
