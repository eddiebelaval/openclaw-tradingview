    macroOC(_ML_2150, time_isMacro(21, 50, 22, 10), '21:50-22:10', is_fri)
    _ML_2150.memoryCleanM()
if showM_2250 and is_macro_visible
    macroOC(_ML_2250, time_isMacro(22, 50, 23, 10), '22:50-23:10', is_fri)
    _ML_2250.memoryCleanM()
if showM_2350 and is_macro_visible
    macroOC(_ML_2350, time_isMacro(23, 50, 00, 10), '23:50-00:10', is_fri)
    _ML_2350.memoryCleanM()
if showM_0050 and is_macro_visible
    macroOC(_ML_0050, time_isMacro(00, 50, 01, 10), '00:50-01:10', is_fri)
    _ML_0050.memoryCleanM()

// ==========================================
// 6. SESSION RANGES (V3S Original)
// ==========================================
// ... (S1 Asia, S2 London, S3 NY Logic from V3S)
// ...
group_sess = 'Session Ranges'
show_sess = input.bool(true, 'Show Sessions', group = group_sess)
hide_sess_htf = input.bool(true, 'Auto-Hide if TF >= 30m', group = group_sess)

show_mean = input.bool(true, 'Show Mean Threshold (50%)', group = group_sess)
mean_col = input.color(color.new(color.yellow, 30), 'Mean Color', group = group_sess)
mean_st = input.string('Dotted', 'Mean Style', options = ['Solid', 'Dotted', 'Dashed'], group = group_sess)

sess_horz = input.string('Right', 'Session Align H', options = ['Left', 'Right', 'Center'], group = group_sess)
sess_vert = input.string('Top', 'Session Align V', options = ['Top', 'Middle', 'Bottom'], group = group_sess)
sess_cutoff_h = 18
sess_cutoff_m = 00
is_cutoff = hour(time, 'America/New_York') == sess_cutoff_h and minute(time, 'America/New_York') == sess_cutoff_m

tf_mins = timeframe.in_seconds('') / 60
// Apply Filter: is_current_week
is_sess_visible = show_sess and (not hide_sess_htf or tf_mins < 30) and is_current_week

// --- CBDR ---
cbdr_t = input.session('1400-2000', 'CBDR Time', group = group_sess)
cbdr_show_box = input.bool(true, 'Show CBDR Box', group = group_sess)
cbdr_n = 'CBDR'
cbdr_c = input.color(color.new(color.gray, 30), 'CBDR Color', group = group_sess)
cbdr_w = input.int(1, 'CBDR Width', group = group_sess)
cbdr_st = input.string('Dotted', 'CBDR Style', options = ['Solid', 'Dotted', 'Dashed'], group = group_sess)

var line cbdr_lh = na, var line cbdr_ll = na, var line cbdr_lm = na, var label cbdr_lbh = na, var label cbdr_lbl = na, var box cbdr_bx = na
var float cbdr_h = na, var float cbdr_l = na, var bool cbdr_hsw = true, var bool cbdr_lsw = true, var bool cbdr_act = false
in_cbdr = not na(time(timeframe.period, cbdr_t, user_tz))

if is_sess_visible
    if is_cutoff
        cbdr_hsw := true, cbdr_lsw := true, cbdr_act := false
    if in_cbdr
        if not in_cbdr[1]
            cbdr_h := high, cbdr_l := low, cbdr_hsw := false, cbdr_lsw := false, cbdr_act := true
            cbdr_lh := line.new(bar_index, high, bar_index, high, color = cbdr_c, width = cbdr_w, style = get_line_style(cbdr_st))
            cbdr_ll := line.new(bar_index, low, bar_index, low, color = cbdr_c, width = cbdr_w, style = get_line_style(cbdr_st))
            if show_mean
                cbdr_lm := line.new(bar_index, (high+low)/2, bar_index, (high+low)/2, color=mean_col, width=1, style=get_line_style(mean_st))
            cbdr_lbh := label.new(bar_index, high, cbdr_n + ' H', textcolor = cbdr_c, style = get_combined_style(sess_vert, sess_horz), size = size.small, color = color.new(color.white, 100))
            cbdr_lbl := label.new(bar_index, low, cbdr_n + ' L', textcolor = cbdr_c, style = get_combined_style(sess_vert, sess_horz), size = size.small, color = color.new(color.white, 100))
            if cbdr_show_box
                cbdr_bx := box.new(bar_index, high, bar_index, low, bgcolor = color.new(cbdr_c, 90), border_color = na)
        else
            cbdr_h := math.max(cbdr_h, high), cbdr_l := math.min(cbdr_l, low)
            line.set_y1(cbdr_lh, cbdr_h), line.set_y2(cbdr_lh, cbdr_h), line.set_x2(cbdr_lh, bar_index)
            line.set_y1(cbdr_ll, cbdr_l), line.set_y2(cbdr_ll, cbdr_l), line.set_x2(cbdr_ll, bar_index)
            if show_mean and not na(cbdr_lm)
                _mid = (cbdr_h + cbdr_l) / 2
                line.set_y1(cbdr_lm, _mid), line.set_y2(cbdr_lm, _mid), line.set_x2(cbdr_lm, bar_index)
            label.set_xy(cbdr_lbh, bar_index, cbdr_h), label.set_xy(cbdr_lbl, bar_index, cbdr_l)
            if cbdr_show_box
                box.set_top(cbdr_bx, cbdr_h), box.set_bottom(cbdr_bx, cbdr_l), box.set_right(cbdr_bx, bar_index)
    else if cbdr_act
        if not cbdr_hsw
            line.set_x2(cbdr_lh, bar_index), label.set_x(cbdr_lbh, bar_index)
            if high > cbdr_h
                cbdr_hsw := true
        if not cbdr_lsw
            line.set_x2(cbdr_ll, bar_index), label.set_x(cbdr_lbl, bar_index)
            if low < cbdr_l
                cbdr_lsw := true
        if show_mean and not na(cbdr_lm) and (not cbdr_hsw or not cbdr_lsw)
            line.set_x2(cbdr_lm, bar_index)

// --- S1 Asia ---
s1_t = input.session('2000-0000', 'S1 Time', group = group_sess)
s1_show_box = input.bool(true, 'Show Asia Box', group = group_sess)
s1_n = input.string('Asia', 'S1 Name', group = group_sess)
