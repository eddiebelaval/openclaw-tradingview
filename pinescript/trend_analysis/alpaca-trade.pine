// ==========================================
// 2. MACRO FUNCTIONS (Updated)
// ==========================================
// --- NEW GLOBAL ARRAY FOR OPEN LABELS ---
var array<label> OPEN_LBL_M = array.new_label()
// ----------------------------------------

time_isMacro(int H_start, int M_start, int H_end, int M_end) =>
    h = hour(time, 'America/New_York')
    m = minute(time, 'America/New_York')
    h == H_start ? H_start != H_end ? m >= M_start : m >= M_start and m < M_end : h > H_start ? h == H_end ? m < M_end : h < H_end : false

_controlMacroLine(array<line> _lines, array<label> _lbl, bool _time) =>
    if _time and _lines.size() > 1
        // --- NEW: Extend Open Price Line (Index 0) & Move Label ---
        // เช็คว่ามีเส้น Open อยู่หรือไม่ (ถ้ามี Array ต้องมีอย่างน้อย 3 เส้น: Open, Vline1, Hline)
        if _lines.size() >= 3
            if _lines.get(0).get_x2() == time
                _lines.get(0).set_x2(time + oneBarMS)
                // ขยับ Label ถ้ามี
                if OPEN_LBL_M.size() > 0
                    lbl_to_move = OPEN_LBL_M.last()
                    if not na(lbl_to_move)
                        lbl_to_move.set_x(time + oneBarMS)
        // ---------------------------------------------

        _lbl.last().set_x(math.round(math.avg(_lines.get(_lines.size() - 2).get_x1(), time)))
        if high > _lines.last().get_y2() - syminfo.mintick * 10
            _lines.get(_lines.size() - 2).set_y2(high + syminfo.mintick * 10)
            _lines.last().set_y1(high + syminfo.mintick * 10)
            _lines.last().set_y2(high + syminfo.mintick * 10)
            LBL_M.last().set_y(high + syminfo.mintick * 10)
        if _lines.last().get_x2() == time
            _lines.last().set_x2(time + oneBarMS)

_controlMacroBox(array<box> _boxes, bool _time, bool _friday) =>
    dly = _friday ? oneDayMS * 3 : oneDayMS
    if false or _time
        _boxes.last().set_right(time + dly)

method memoryCleanM(array<line> A) =>
    if A.size() > 100
        // ปรับเป็นลบทีละ 4 เส้น (Open, V1, H1, V2)
        for i = 0 to 3 by 1
            A.shift().delete()
        // --- NEW: Cleanup Open Label (Synced) ---
        if OPEN_LBL_M.size() > 0
            lbl_to_delete = OPEN_LBL_M.shift()
            if not na(lbl_to_delete)
                lbl_to_delete.delete()
        // ----------------------------------------

macroOC(array<line> LINES, bool _time, string _kzTime, bool _friday) =>
    dly = _friday ? oneDayMS * 3 : oneDayMS
    _txt = _mTxt ? 'MACRO' + '\n' + _kzTime : 'MACRO'
    _tt = 'MACRO\n' + _kzTime
    
    // Overlay False
    if not _time[1] and _time
        // --- NEW: Create Open Price Line & Label ---
        // ใช้สีจาก Input ใหม่ (_openLineC)
        _openLine = line.new(time, open, time + oneBarMS, open, xloc = xloc.bar_time, color = _openLineC, style = line.style_dashed)
        LINES.insert(0, _openLine) // ใส่ไว้ตัวแรกสุด (Index 0)

        // สร้าง Label ถ้ามีข้อความ
        label _openLbl = na
        if _openLineTxt != ''
            _openLbl := label.new(time, open, _openLineTxt, xloc = xloc.bar_time, color = noColor, style = label.style_label_left, textcolor = _openLineC, size = size.small)
        OPEN_LBL_M.push(_openLbl) // Push เสมอเพื่อรักษาสินโครไนซ์ (ถ้าไม่มีข้อความจะเป็น na)
        // -----------------------------------

        _vline1 = line.new(time, y_btm_Line1, time, y_top_Line1, xloc = xloc.bar_time, color = _macroC)
        LINES.push(_vline1)
        _hline = line.new(time, y_top_Line1, time + oneBarMS, y_top_Line1, xloc = xloc.bar_time, color = _macroC)
        LINES.push(_hline)
        if _extt
            EXT_M.push(line.new(time, high, time, _vline1.get_y2(), xloc = xloc.bar_time, color = _macroC, style = line.style_dotted))

        if _modeM == 'On Chart'
            LBL_M.push(label.new(time, LINES.get(LINES.size() - 2).get_y2(), _showL ? _txt : '', tooltip = _tt, xloc = xloc.bar_time, style = label.style_label_down, color = noColor, textcolor = _macroC, size = size.small))

    if _time[1] and not _time and LINES.size() > 0 and LBL_M.size() > 0
        _vline2 = line.new(time, y_btm_Line1, time, y_top_Line1, xloc = xloc.bar_time, color = _macroC)
        LBL_M.last().set_x(math.round(math.avg(LINES.get(LINES.size() - 2).get_x1(), time)))
        if y_top_Line1 > LINES.get(LINES.size() - 2).get_y2()
            LINES.get(LINES.size() - 2).set_y2(y_top_Line1)
            LINES.last().set_y1(y_top_Line1)
            LINES.last().set_y2(y_top_Line1)
            LBL_M.last().set_y(y_top_Line1)
        else if y_top_Line1 < LINES.get(LINES.size() - 2).get_y2()
            _vline2.set_y2(LINES.get(LINES.size() - 2).get_y2())
        if _extt
            EXT_M.push(line.new(time, high, time, _vline2.get_y2(), xloc = xloc.bar_time, color = _macroC, style = line.style_dotted))

        LINES.push(_vline2)

    if LINES.size() > 0 and LBL_M.size() > 0
        _controlMacroLine(LINES, LBL_M, _time)
        
// ==========================================
// 3. VWAP & MAs & TREND FILTER
// ==========================================
group_vwap = 'VWAP & MAs & Trend'
show_vwap = input.bool(true, 'Show VWAP', group = group_vwap)
vwap_col = input.color(color.orange, 'VWAP Color', group = group_vwap)
vwap_val = ta.vwap(hlc3)
plot(show_vwap ? vwap_val : na, title = 'VWAP', color = vwap_col, linewidth = 2)

// Trend Filter
use_ema_filter = input.bool(true, 'Use EMA 200 Trend Filter', group = group_vwap)
ema_len = input.int(200, 'EMA Length', group = group_vwap)
ema_col = input.color(color.new(color.yellow, 0), 'EMA Trend Color', group = group_vwap)
ema_trend = ta.ema(close, ema_len)
plot(use_ema_filter ? ema_trend : na, 'EMA Trend', color = ema_col, linewidth = 2)

// MAs
ma_type = input.string('EMA', 'MA Type', options = ['EMA', 'SMA', 'TMA'], group = group_vwap)
ma1_len = input.int(20, 'MA 1 Length', group = group_vwap)
ma1_col = input.color(color.green, 'MA 1 Color', group = group_vwap)
ma2_len = input.int(50, 'MA 2 Length', group = group_vwap)
ma2_col = input.color(color.yellow, 'MA 2 Color', group = group_vwap)

get_ma(src, len, type) => 
    float ma_val = na
    if type == 'EMA'
        ma_val := ta.ema(src, len)
    else if type == 'SMA'
        ma_val := ta.sma(src, len)
    else if type == 'TMA'
        // Triangular Moving Average Logic
        len_half = math.ceil((len + 1) / 2)
        ma_val := ta.sma(ta.sma(src, len_half), len_half)
    ma_val
    
plot(get_ma(close, ma1_len, ma_type), title = 'MA 1', color = ma1_col, linewidth = 1)
plot(get_ma(close, ma2_len, ma_type), title = 'MA 2', color = ma2_col, linewidth = 1)

// ==========================================
// 4. DAILY LEVELS & OPENS
// ==========================================
// (Logic for PDH/PDL Drawing follows existing V3S structure...)
// ...
group_lvl = 'Daily Levels'
show_pdl_pdh = input.bool(true, 'Show PDH / PDL', group = group_lvl)
pdh_col = input.color(color.new(color.red, 30), 'PDH Color', group = group_lvl)
pdl_col = input.color(color.new(color.green, 30), 'PDL Color', group = group_lvl)
pd_width = input.int(1, 'Width', group = group_lvl)
pd_style = input.string('Solid', 'Style', options = ['Solid', 'Dotted', 'Dashed'], group = group_lvl)

show_tdo = input.bool(true, 'Show True Day Open (00:00 NY)', group = group_lvl)
tdo_col = input.color(color.white, 'TDO Color', group = group_lvl)
tdo_style = input.string('Dotted', 'TDO Style', options = ['Solid', 'Dotted', 'Dashed'], group = group_lvl)

show_ndo = input.bool(true, 'Show New Day Open', group = group_lvl)
ndo_col = input.color(color.aqua, 'NDO Color', group = group_lvl)
ndo_style = input.string('Dashed', 'NDO Style', options = ['Solid', 'Dotted', 'Dashed'], group = group_lvl)

lbl_offset = input.int(5, 'Label Offset', group = group_lvl)
lbl_horz = input.string('Right', 'Label Align H', options = ['Left', 'Right', 'Center'], group = group_lvl)
lbl_vert = input.string('Top', 'Label Align V', options = ['Top', 'Middle', 'Bottom'], group = group_lvl)
lbl_size = input.string(size.small, 'Label Size', options = [size.tiny, size.small, size.normal], group = group_lvl)

[pdh, pdl, daily_open] = request.security(syminfo.tickerid, 'D', [high[1], low[1], open], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

// --- PDH / PDL ---
var line l_pdh = na
var line l_pdl = na
var label lbl_pdh = na
var label lbl_pdl = na
var bool pdh_swept = true
var bool pdl_swept = true
bool is_chart_new_day = ta.change(time('D')) != 0

if show_pdl_pdh and is_current_week
    if is_chart_new_day
        pdh_swept := false
        pdl_swept := false
        l_pdh := line.new(bar_index, pdh, bar_index, pdh, color = pdh_col, width = pd_width, style = get_line_style(pd_style))
        l_pdl := line.new(bar_index, pdl, bar_index, pdl, color = pdl_col, width = pd_width, style = get_line_style(pd_style))
        lbl_pdh := label.new(bar_index, pdh, 'PDH', textcolor = pdh_col, style = get_combined_style(lbl_vert, lbl_horz), size = lbl_size, color = color.new(color.white, 100))
        lbl_pdl := label.new(bar_index, pdl, 'PDL', textcolor = pdl_col, style = get_combined_style(lbl_vert, lbl_horz), size = lbl_size, color = color.new(color.white, 100))
    
    if not pdh_swept and not na(l_pdh)
        line.set_x2(l_pdh, bar_index)
        label.set_x(lbl_pdh, bar_index + lbl_offset)
        if high > pdh
            pdh_swept := true
            
    if not pdl_swept and not na(l_pdl)
        line.set_x2(l_pdl, bar_index)
        label.set_x(lbl_pdl, bar_index + lbl_offset)
        if low < pdl
            pdl_swept := true

// --- NDO ---
var line l_ndo = na
var label lbl_ndo = na
if show_ndo and is_current_week
    if is_chart_new_day
        l_ndo := line.new(bar_index, daily_open, bar_index, daily_open, color = ndo_col, style = get_line_style(ndo_style))
        lbl_ndo := label.new(bar_index, daily_open, 'NDO', style = get_combined_style(lbl_vert, 'Center'), textcolor = ndo_col, size = size.tiny, color = color.new(color.white, 100))
    
    if not na(l_ndo)
        line.set_x2(l_ndo, bar_index)
        label.set_x(lbl_ndo, bar_index + lbl_offset)

// --- TDO ---
var line l_tdo = na
var label lbl_tdo = na
var float tdo_val = na
bool is_new_ny_day = ta.change(dayofweek(time, 'America/New_York')) != 0

if is_new_ny_day
    tdo_val := open
    if show_tdo and is_current_week
        l_tdo := line.new(bar_index, tdo_val, bar_index, tdo_val, color = tdo_col, style = get_line_style(tdo_style))
        lbl_tdo := label.new(bar_index, tdo_val, 'TDO', style = get_combined_style(lbl_vert, 'Center'), textcolor = tdo_col, size = size.tiny, color = color.new(color.white, 100))

if show_tdo and not na(l_tdo) and is_current_week
    line.set_x2(l_tdo, bar_index)
    label.set_x(lbl_tdo, bar_index + lbl_offset)

