var line s2_lh=na, var line s2_ll=na, var line s2_lm=na, var label s2_lbh=na, var label s2_lbl=na, var box s2_bx=na
var float s2_h=na, var float s2_l=na, var bool s2_hsw=true, var bool s2_lsw=true, var bool s2_act=false
