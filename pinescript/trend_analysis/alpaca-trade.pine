s1_w = input.int(1, 'S1 Width', group = group_sess), s1_st = input.string('Solid', 'S1 Style', options = ['Solid', 'Dotted', 'Dashed'], group = group_sess)

var line s1_lh=na, var line s1_ll=na, var line s1_lm=na, var label s1_lbh=na, var label s1_lbl=na, var box s1_bx=na
var float s1_h=na, var float s1_l=na, var bool s1_hsw=true, var bool s1_lsw=true, var bool s1_act=false
in_s1 = not na(time(timeframe.period, s1_t, user_tz))

if is_sess_visible
    if is_cutoff
        s1_hsw := true, s1_lsw := true, s1_act := false
    if in_s1
        if not in_s1[1]
            s1_h := high, s1_l := low, s1_hsw := false, s1_lsw := false, s1_act := true
            s1_lh := line.new(bar_index, high, bar_index, high, color = s1_c, width = s1_w, style = get_line_style(s1_st))
            s1_ll := line.new(bar_index, low, bar_index, low, color = s1_c, width = s1_w, style = get_line_style(s1_st))
            if show_mean
                s1_lm := line.new(bar_index, (high + low) / 2, bar_index, (high + low) / 2, color = mean_col, width = 1, style = get_line_style(mean_st))
            s1_lbh := label.new(bar_index, high, s1_n + ' H', textcolor = s1_c, style = get_combined_style(sess_vert, sess_horz), size = size.small, color = color.new(color.white, 100))
            s1_lbl := label.new(bar_index, low, s1_n + ' L', textcolor = s1_c, style = get_combined_style(sess_vert, sess_horz), size = size.small, color = color.new(color.white, 100))
            if s1_show_box
