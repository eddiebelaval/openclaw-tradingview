            line.set_y1(s2_lh, s2_h), line.set_y2(s2_lh, s2_h), line.set_x2(s2_lh, bar_index)
            line.set_y1(s2_ll, s2_l), line.set_y2(s2_ll, s2_l), line.set_x2(s2_ll, bar_index)
