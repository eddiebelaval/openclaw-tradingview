            label.set_xy(s2_lbh, bar_index, s2_h), label.set_xy(s2_lbl, bar_index, s2_l)
            if s2_show_box
                box.set_top(s2_bx, s2_h), box.set_bottom(s2_bx, s2_l), box.set_right(s2_bx, bar_index)
    else if s2_act
        if not s2_hsw
            line.set_x2(s2_lh, bar_index), label.set_x(s2_lbh, bar_index)
            if high > s2_h
                s2_hsw := true
        if not s2_lsw
            line.set_x2(s2_ll, bar_index), label.set_x(s2_lbl, bar_index)
