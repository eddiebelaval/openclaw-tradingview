            s3_lbh := label.new(bar_index, high, s3_n + ' H', textcolor = s3_c, style = get_combined_style(sess_vert, sess_horz), size = size.small, color = color.new(color.white, 100))
            s3_lbl := label.new(bar_index, low, s3_n + ' L', textcolor = s3_c, style = get_combined_style(sess_vert, sess_horz), size = size.small, color = color.new(color.white, 100))
            if s3_show_box
                s3_bx := box.new(bar_index, high, bar_index, low, bgcolor = color.new(s3_c, 90), border_color = na)
        else
            s3_h := math.max(s3_h, high), s3_l := math.min(s3_l, low)
            line.set_y1(s3_lh, s3_h), line.set_y2(s3_lh, s3_h), line.set_x2(s3_lh, bar_index)
            line.set_y1(s3_ll, s3_l), line.set_y2(s3_ll, s3_l), line.set_x2(s3_ll, bar_index)
            if show_mean and not na(s3_lm)
                _mid = (s3_h + s3_l) / 2
                line.set_y1(s3_lm, _mid), line.set_y2(s3_lm, _mid), line.set_x2(s3_lm, bar_index)
            label.set_xy(s3_lbh, bar_index, s3_h), label.set_xy(s3_lbl, bar_index, s3_l)
            if s3_show_box
                box.set_top(s3_bx, s3_h), box.set_bottom(s3_bx, s3_l), box.set_right(s3_bx, bar_index)
    else if s3_act
        if not s3_hsw
            line.set_x2(s3_lh, bar_index), label.set_x(s3_lbh, bar_index)
            if high > s3_h
                s3_hsw := true
        if not s3_lsw
            line.set_x2(s3_ll, bar_index), label.set_x(s3_lbl, bar_index)
            if low < s3_l
                s3_lsw := true
        if show_mean and not na(s3_lm) and (not s3_hsw or not s3_lsw)
