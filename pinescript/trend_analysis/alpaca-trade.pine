//@version=6
indicator('V3S-GodMode + ICT Macro Tracker', overlay = true, shorttitle = 'V3S+Macro', max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 5000)

// ==========================================
// 0. HELPER FUNCTIONS & GLOBAL VARIABLES
// ==========================================
get_line_style(style_str) =>
    switch style_str
        'Solid'  => line.style_solid
        'Dotted' => line.style_dotted
        'Dashed' => line.style_dashed
        => line.style_solid

get_combined_style(vert_align, horz_align) =>
    if vert_align == 'Top'
        label.style_label_down
    else if vert_align == 'Bottom'
        label.style_label_up
    else
        switch horz_align
            'Right'  => label.style_label_left
            'Left'   => label.style_label_right
            'Center' => label.style_none
            => label.style_label_left

get_wm_pos(v, h) =>
    v == 'top' ? h == 'left' ? position.top_left : h == 'right' ? position.top_right : position.top_center : v == 'bottom' ? h == 'left' ? position.bottom_left : h == 'right' ? position.bottom_right : position.bottom_center : h == 'left' ? position.middle_left : h == 'right' ? position.middle_right : position.middle_center

get_wm_align(align) =>
    align == 'left' ? text.align_left : align == 'right' ? text.align_right : text.align_center

// Macro Global Arrays
var array<line>  EXT_M = array.new_line()
var array<label> LBL_M = array.new_label()
oneDayMS = 86400000
oneBarMS = time_close - time
noColor  = color.new(#ffffff, 100)

// ==========================================
// 1. GENERAL & TIMEZONE & MACRO INPUTS
// ==========================================
group_gen = 'General Configuration'
user_tz = input.string('America/New_York', 'Calculation Timezone', options = ['America/New_York', 'Asia/Bangkok', 'Europe/London', 'Asia/Tokyo', 'UTC'], group = group_gen)
limit_history = input.bool(true, 'Clean Chart Mode (Last 7 Days Only)', group = group_gen)
is_current_week = not limit_history or (time > timenow - 604800000)


group_macro = 'ICT Macro Tracker Settings'
hide_macro_htf = input.bool(true, 'Auto-Hide Macro if TF >= 5m', group = group_macro)
// Calculate the number of bars, ensuring it is at least 1
int len = math.max(1, int(timeframe.in_seconds('15') / timeframe.in_seconds(timeframe.period)))

// Apply it to the highest function
one = ta.highest(len) + syminfo.mintick * 10

_macroC = input.color(color.new(#000000, 0), title = 'Macro Box/Line Color', group = group_macro)
// --- NEW INPUTS ---
_openLineC = input.color(color.new(color.blue, 0), title = 'Macro Open Line Color', group = group_macro)
_openLineTxt = input.string('', title = 'Macro Open Line Text (Optional)', group = group_macro)
// ------------------
_modeM  = input.string('On Chart', title = 'Macro Mode', options = ['On Chart', 'New Pane'], group = group_macro)
_showL  = input.bool(true, title = 'Macro Label?', group = group_macro)
_mTxt   = input.bool(false, title = 'Show Time?', group = group_macro)
_extt   = input.bool(false, title = 'Macro Projections?', group = group_macro)
_bgm    = input.color(color.new(#4caf50, 70), title = 'New Pane Bg Color', group = group_macro)
y_btm_Line1 = one
y_top_Line1 = one + syminfo.mintick * 5

// Macro Selection Inputs
showM_0150 = input.bool(true, title = '01:50 - 02:10', group = group_macro)
showM_0250 = input.bool(true, title = '02:50 - 03:10', group = group_macro)
showM_0350 = input.bool(true, title = '03:50 - 04:10', group = group_macro)
showM_0450 = input.bool(true, title = '04:50 - 05:10', group = group_macro)
showM_0550 = input.bool(true, title = '05:50 - 06:10', group = group_macro)
showM_0650 = input.bool(true, title = '06:50 - 07:10', group = group_macro)
showM_0750 = input.bool(true, title = '07:50 - 08:10', group = group_macro)
showM_0850 = input.bool(true, title = '08:50 - 09:10', group = group_macro)
showM_0950 = input.bool(true, title = '09:50 - 10:10', group = group_macro)
showM_1050 = input.bool(true, title = '10:50 - 11:10', group = group_macro)
showM_1150 = input.bool(true, title = '11:50 - 12:10', group = group_macro)
showM_1250 = input.bool(true, title = '12:50 - 13:10', group = group_macro)
showM_1350 = input.bool(true, title = '13:50 - 14:10', group = group_macro)
showM_1450 = input.bool(true, title = '14:50 - 15:10', group = group_macro)
showM_1550 = input.bool(true, title = '15:50 - 16:10', group = group_macro)
showM_1650 = input.bool(true, title = '16:50 - 17:10', group = group_macro)
showM_1750 = input.bool(true, title = '17:50 - 18:10', group = group_macro)
showM_1850 = input.bool(true, title = '18:50 - 19:10', group = group_macro)
showM_1950 = input.bool(true, title = '19:50 - 20:10', group = group_macro)
showM_2050 = input.bool(true, title = '20:50 - 21:10', group = group_macro)
showM_2150 = input.bool(true, title = '21:50 - 22:10', group = group_macro)
showM_2250 = input.bool(true, title = '22:50 - 23:10', group = group_macro)
showM_2350 = input.bool(true, title = '23:50 - 00:10', group = group_macro)
