is_fri = dayofweek(time) == dayofweek.friday and syminfo.type != 'crypto'

// 1800 วินาที = 30 นาที
float tf_sec_check = timeframe.in_seconds(timeframe.period)
bool is_macro_visible = not hide_macro_htf or (tf_sec_check < 300)


if showM_0150 and is_macro_visible
    macroOC(_ML_0150, time_isMacro(1, 50, 2, 10), '1:50-2:10', is_fri)
    _ML_0150.memoryCleanM()
