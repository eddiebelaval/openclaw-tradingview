//@version=6
indicator("TTrades Currency Strength & Pair Ranker", overlay=true, shorttitle="TTrades_CS")

// --- Settings ---
lookback = input.int(14, "Lookback Period (Strength Calculation)", minval=1)
tablePosition = input(position.top_right, "Table Position")
textSize = input(size.small, "Text Size")

// --- Data Structure for Pairs ---
type PairData
    string name
    float score
    string signal

// --- Function to Get Price Change ---
getChange(symbol) =>
    request.security(symbol, timeframe.period, ta.roc(close, lookback), lookahead=barmerge.lookahead_off)

// --- Helper Function to Add Pair (Solves the redefinition error) ---
addPair(array<PairData> arr, string name, float baseScore, float quoteScore) =>
    float score = baseScore - quoteScore
    string signal = score > 0 ? "BUY " : "SELL"
    array.push(arr, PairData.new(name, score, signal))

// --- Calculating Pair Components ---
// EUR Pairs
eurgbp = getChange("EURGBP")
eurusd = getChange("EURUSD")
eurnzd = getChange("EURNZD")
euraud = getChange("EURAUD")
eurjpy = getChange("EURJPY")
eurcad = getChange("EURCAD")
eurchf = getChange("EURCHF")

// GBP Pairs
gbpusd = getChange("GBPUSD")
gbpnzd = getChange("GBPNZD")
gbpaud = getChange("GBPAUD")
gbpjpy = getChange("GBPJPY")
gbpcad = getChange("GBPCAD")
gbpchf = getChange("GBPCHF")

// AUD Pairs
audusd = getChange("AUDUSD")
audnzd = getChange("AUDNZD")
audjpy = getChange("AUDJPY")
audcad = getChange("AUDCAD")
audchf = getChange("AUDCHF")

// NZD Pairs
nzdusd = getChange("NZDUSD")
nzdjpy = getChange("NZDJPY")
nzdcad = getChange("NZDCAD")
nzdchf = getChange("NZDCHF")

// CAD Pairs
usdcad = getChange("USDCAD") 
cadjpy = getChange("CADJPY")
cadchf = getChange("CADCHF")

// CHF Pairs
usdchf = getChange("USDCHF") 
chfjpy = getChange("CHFJPY")

// JPY Pairs
usdjpy = getChange("USDJPY") 

// --- Calculating Individual Currency Strength ---

// USD
usd_score = (-eurusd - gbpusd - audusd - nzdusd + usdcad + usdchf + usdjpy) / 7

// EUR
eur_score = (eurusd + eurgbp + euraud + eurnzd + eurjpy + eurcad + eurchf) / 7

// GBP
gbp_score = (gbpusd - eurgbp + gbpaud + gbpnzd + gbpjpy + gbpcad + gbpchf) / 7

// AUD
aud_score = (audusd + audnzd + audjpy + audcad + audchf - euraud - gbpaud) / 7

// NZD
nzd_score = (nzdusd + nzdjpy + nzdcad + nzdchf - eurnzd - gbpnzd - audnzd) / 7

// CAD
cad_score = (cadjpy + cadchf - eurcad - gbpcad - audcad - nzdcad - usdcad) / 7

// CHF
chf_score = (chfjpy - eurchf - gbpchf - audchf - nzdchf - cadchf - usdchf) / 7

// JPY
jpy_score = (-eurjpy - gbpjpy - audjpy - nzdjpy - cadjpy - chfjpy - usdjpy) / 7

// --- Currency Ranking Logic ---
var float[] c_scores = array.new_float(8)
var string[] c_names = array.new_string(8)

if barstate.islast
    // Populate Arrays
    array.set(c_scores, 0, usd_score)
    array.set(c_names, 0, "USD")
    
    array.set(c_scores, 1, eur_score)
    array.set(c_names, 1, "EUR")
    
    array.set(c_scores, 2, gbp_score)
    array.set(c_names, 2, "GBP")
    
    array.set(c_scores, 3, jpy_score)
    array.set(c_names, 3, "JPY")
    
    array.set(c_scores, 4, chf_score)
    array.set(c_names, 4, "CHF")
    
    array.set(c_scores, 5, cad_score)
    array.set(c_names, 5, "CAD")
    
    array.set(c_scores, 6, aud_score)
    array.set(c_names, 6, "AUD")
    
    array.set(c_scores, 7, nzd_score)
    array.set(c_names, 7, "NZD")

    // Sort Currencies (Descending: Strongest first)
    for i = 0 to 6
        for j = i + 1 to 7
            if array.get(c_scores, i) < array.get(c_scores, j)
                // Swap Scores
                float tmpS = array.get(c_scores, i)
                array.set(c_scores, i, array.get(c_scores, j))
                array.set(c_scores, j, tmpS)
                // Swap Names
                string tmpN = array.get(c_names, i)
                array.set(c_names, i, array.get(c_names, j))
                array.set(c_names, j, tmpN)

// --- Pair Score Calculation & Ranking ---
var pairDataArray = array.new<PairData>()

if barstate.islast
    array.clear(pairDataArray)
    
    // --- USD Pairs ---
    addPair(pairDataArray, "EURUSD", eur_score, usd_score)
    addPair(pairDataArray, "GBPUSD", gbp_score, usd_score)
    addPair(pairDataArray, "AUDUSD", aud_score, usd_score)
    addPair(pairDataArray, "NZDUSD", nzd_score, usd_score)
    addPair(pairDataArray, "USDCAD", usd_score, cad_score)
    addPair(pairDataArray, "USDCHF", usd_score, chf_score)
    addPair(pairDataArray, "USDJPY", usd_score, jpy_score)

    // --- EUR Crosses ---
    addPair(pairDataArray, "EURGBP", eur_score, gbp_score)
    addPair(pairDataArray, "EURAUD", eur_score, aud_score)
    addPair(pairDataArray, "EURNZD", eur_score, nzd_score)
    addPair(pairDataArray, "EURCAD", eur_score, cad_score)
    addPair(pairDataArray, "EURCHF", eur_score, chf_score)
    addPair(pairDataArray, "EURJPY", eur_score, jpy_score)

    // --- GBP Crosses ---
    addPair(pairDataArray, "GBPAUD", gbp_score, aud_score)
    addPair(pairDataArray, "GBPNZD", gbp_score, nzd_score)
    addPair(pairDataArray, "GBPCAD", gbp_score, cad_score)
    addPair(pairDataArray, "GBPCHF", gbp_score, chf_score)
    addPair(pairDataArray, "GBPJPY", gbp_score, jpy_score)

    // --- AUD Crosses ---
    addPair(pairDataArray, "AUDNZD", aud_score, nzd_score)
    addPair(pairDataArray, "AUDCAD", aud_score, cad_score)
    addPair(pairDataArray, "AUDCHF", aud_score, chf_score)
    addPair(pairDataArray, "AUDJPY", aud_score, jpy_score)

    // --- NZD Crosses ---
    addPair(pairDataArray, "NZDCAD", nzd_score, cad_score)
    addPair(pairDataArray, "NZDCHF", nzd_score, chf_score)
    addPair(pairDataArray, "NZDJPY", nzd_score, jpy_score)

    // --- CAD Crosses ---
    addPair(pairDataArray, "CADCHF", cad_score, chf_score)
    addPair(pairDataArray, "CADJPY", cad_score, jpy_score)

    // --- CHF Crosses ---
    addPair(pairDataArray, "CHFJPY", chf_score, jpy_score)

    // Sort Pairs by Absolute Score (Biggest Divergence = Best Opportunity)
    for i = 0 to array.size(pairDataArray) - 2
        for j = i + 1 to array.size(pairDataArray) - 1
            if math.abs(array.get(pairDataArray, i).score) < math.abs(array.get(pairDataArray, j).score)
                PairData tmp = array.get(pairDataArray, i)
                array.set(pairDataArray, i, array.get(pairDataArray, j))
                array.set(pairDataArray, j, tmp)

// --- Drawing the Table ---
var table resultTable = table.new(tablePosition, 2, 21, bgcolor=color.new(color.black, 50), border_width=1)

if barstate.islast
    // Header: Currency Strength
    table.cell(resultTable, 0, 0, "Strength Rank", bgcolor=color.gray, text_color=color.white, text_size=textSize)
    table.cell(resultTable, 1, 0, "Score", bgcolor=color.gray, text_color=color.white, text_size=textSize)
    
    // Fill Currency Rankings (Top 8)
    for i = 0 to 7
        string name = array.get(c_names, i)
        float score = array.get(c_scores, i)
        color col = score >= 0 ? color.new(color.green, 20) : color.new(color.red, 20)
        table.cell(resultTable, 0, i + 1, name, bgcolor=col, text_color=color.white, text_size=textSize)
        table.cell(resultTable, 1, i + 1, str.tostring(score, "#.##"), bgcolor=col, text_color=color.white, text_size=textSize)

    // Separator
    table.cell(resultTable, 0, 9, "----------------", bgcolor=color.black, text_color=color.gray, text_size=textSize)
    table.cell(resultTable, 1, 9, "----------------", bgcolor=color.black, text_color=color.gray, text_size=textSize)

    // Header: Pair Rankings
    table.cell(resultTable, 0, 10, "Best Pairs (Ranked)", bgcolor=color.gray, text_color=color.white, text_size=textSize)
    table.cell(resultTable, 1, 10, "Signal / Score", bgcolor=color.gray, text_color=color.white, text_size=textSize)

    // Fill Pair Rankings (Top 10)
    for i = 0 to 9
        PairData d = array.get(pairDataArray, i)
        color rowCol = d.signal == "BUY " ? color.new(color.teal, 20) : color.new(color.maroon, 20)
        
        table.cell(resultTable, 0, i + 11, d.name, bgcolor=rowCol, text_color=color.white, text_size=textSize)
        table.cell(resultTable, 1, i + 11, d.signal + " (" + str.tostring(d.score, "#.##") + ")", bgcolor=rowCol, text_color=color.white, text_size=textSize)
