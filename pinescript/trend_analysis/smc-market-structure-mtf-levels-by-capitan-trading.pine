//@version=6
indicator("SMC Market Structure & MTF Levels by Capitan-Trading", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// =====================================================
// 0) EXECUTION / SAFETY
// =====================================================
grp_exec = "Execution / Safety"
confirmedOnly = input.bool(true, "Confirmed only (no intrabar signals)", group=grp_exec, tooltip="If ON: CHoCH/BOS trigger only on closed candles.")
canSignal = confirmedOnly ? barstate.isconfirmed : true

// =====================================================
// 1) MTF LEVELS (DAILY, WEEKLY, MONTHLY)
// =====================================================
grp_mtf = "MTF Highs/Lows"
show_pd = input.bool(true, "Show Daily (PDH/PDL)", group=grp_mtf)
d_col   = input.color(color.gray, "Color", group=grp_mtf, inline="D")
d_wid   = input.int(1, "Width", group=grp_mtf, inline="D") 
d_sty   = input.string("Dotted", "Style", options=["Solid","Dashed","Dotted"], group=grp_mtf, inline="D") 

show_pw = input.bool(true, "Show Weekly (PWH/PWL)", group=grp_mtf)
w_col   = input.color(color.blue, "Color", group=grp_mtf, inline="W")
w_wid   = input.int(1, "Width", group=grp_mtf, inline="W") 
w_sty   = input.string("Dotted", "Style", options=["Solid","Dashed","Dotted"], group=grp_mtf, inline="W") 

show_pm = input.bool(true, "Show Monthly (PMH/PML)", group=grp_mtf)
m_col   = input.color(color.purple, "Color", group=grp_mtf, inline="M")
m_wid   = input.int(1, "Width", group=grp_mtf, inline="M") 
m_sty   = input.string("Dotted", "Style", options=["Solid","Dashed","Dotted"], group=grp_mtf, inline="M") 

// =====================================================
// 2) SMC (STRUCTURE) & DASHBOARD
// =====================================================
grp_smc   = "Market Structure (SMC)"
leftBars  = input.int(10, "Pivot Left (Structure)",  minval=1, group=grp_smc, inline="piv")   
rightBars = input.int(10, "Pivot Right (Structure)", minval=1, group=grp_smc, inline="piv")  
bullColor = input.color(#00ff08, "Bullish CHoCH/BOS", group=grp_smc) 
bearColor = input.color(#ff0000, "Bearish CHoCH/BOS", group=grp_smc) 

grp_db = "Dashboard Settings"
show_db = input.bool(true, "Show Dashboard", group=grp_db)
db_pos  = input.string("top_right", "Position", options=["top_right","top_left","top_center","middle_right","middle_left","bottom_right","bottom_left"], group=grp_db)
db_size = input.string("small", "Size", options=["tiny","small","normal"], group=grp_db)
dbBullColor = input.color(#00ff08, "Dash: Bull Text", group=grp_db)
dbBearColor = input.color(#ff0000, "Dash: Bear Text", group=grp_db)

// =====================================================
// 3) SESSION BOXES
// =====================================================
grp_sess = "Sessions Boxes (Max 3)"
i_tz        = input.string("UTC+1", "Time Zone", group=grp_sess)
sess_transp = input.int(85, "Transparency", minval=0, maxval=100, group=grp_sess)

s1_active = input.bool(true, "S1 Active", group=grp_sess, inline="s1")
s1_time   = input.session("0000-0601", "Time", group=grp_sess, inline="s1")
s1_color  = input.color(color.new(color.black, 85), "", group=grp_sess, inline="s1")

s2_active = input.bool(true, "S2 Active", group=grp_sess, inline="s2")
s2_time   = input.session("0900-1201", "Time", group=grp_sess, inline="s2")
s2_color  = input.color(color.new(color.blue, 85), "", group=grp_sess, inline="s2")

s3_active = input.bool(true, "S3 Active", group=grp_sess, inline="s3")
s3_time   = input.session("1530-1831", "Time", group=grp_sess, inline="s3")
s3_color  = input.color(color.new(#388e3c, 85), "", group=grp_sess, inline="s3")

// =====================================================
// HELPERS
// =====================================================
get_style(_s) =>
    _s == "Solid" ? line.style_solid : _s == "Dashed" ? line.style_dashed : line.style_dotted

gold = color.rgb(226, 184, 46)  

// Percentage distance calculation
dist_pct(_v) =>
    (not na(_v) and _v != 0.0) ? math.abs(close - _v) / _v * 100 : na

// =====================================================
// MTF (FIXED, PIVOT-INDEPENDENT) + TIME-ANCHORED
// =====================================================
f_prev_hl_time(tf) =>
    request.security(syminfo.tickerid, tf, [high[1], low[1], time[1]], barmerge.gaps_off, barmerge.lookahead_off)

[pdh, pdl, pd_t] = f_prev_hl_time("D")
[pwh, pwl, pw_t] = f_prev_hl_time("W")
[pmh, pml, pm_t] = f_prev_hl_time("M")

// Added _offset parameter to stagger lines horizontally
f_upd_level_line_time(line ln, float _val, int _t_anchor, color _col, int _wid, string _sty, bool _show, int _offset) =>
    line out = ln
    if barstate.islast
        if _show and not na(_val) and not na(_t_anchor)
            int rightT = last_bar_time + _offset * (time - time[1])
            if na(out)
                out := line.new(_t_anchor, _val, rightT, _val, xloc=xloc.bar_time, extend=extend.none, color=_col, width=_wid, style=get_style(_sty))
            else
                line.set_xy1(out, _t_anchor, _val)
                line.set_xy2(out, rightT, _val)
                line.set_extend(out, extend.none)
                line.set_color(out, _col)
                line.set_width(out, _wid)
                line.set_style(out, get_style(_sty))
        else
            if not na(out)
                line.delete(out)
            out := na
    out

// Added _offset parameter to stagger labels horizontally
f_upd_level_label_time(label lb, float _val, string _name, color _col, bool _show, int _offset) =>
    label out = lb
    if barstate.islast
        if _show and not na(_val)
            int rightT = last_bar_time + _offset * (time - time[1])
            if na(out)
                out := label.new(rightT, _val, _name, xloc=xloc.bar_time, style=label.style_label_left,
                     textcolor=_col, color=color.new(color.black, 100), size=size.small)
            else
                label.set_xy(out, rightT, _val)
                label.set_text(out, _name)
                label.set_textcolor(out, _col)
                label.set_color(out, color.new(color.black, 100))
                label.set_style(out, label.style_label_left)
                label.set_size(out, size.small)
        else
            if not na(out)
                label.delete(out)
            out := na
    out

// =====================================================
// MTF OBJECTS (NO DUPES & STAGGERED OVERLAPS)
// =====================================================
var line  ln_pdh = na
var line  ln_pdl = na
var line  ln_pwh = na
var line  ln_pwl = na
var line  ln_pmh = na
var line  ln_pml = na

var label lb_pdh = na
var label lb_pdl = na
var label lb_pwh = na
var label lb_pwl = na
var label lb_pmh = na
var label lb_pml = na

// Daily offsets: Line = 20, Label = 22
ln_pdh := f_upd_level_line_time(ln_pdh, pdh, pd_t, d_col, d_wid, d_sty, show_pd, 20)
lb_pdh := f_upd_level_label_time(lb_pdh, pdh, "PDH", d_col, show_pd, 22)

ln_pdl := f_upd_level_line_time(ln_pdl, pdl, pd_t, d_col, d_wid, d_sty, show_pd, 20)
lb_pdl := f_upd_level_label_time(lb_pdl, pdl, "PDL", d_col, show_pd, 22)

// Weekly offsets: Line = 28, Label = 30 (prevents overlap with Daily)
ln_pwh := f_upd_level_line_time(ln_pwh, pwh, pw_t, w_col, w_wid, w_sty, show_pw, 28)
lb_pwh := f_upd_level_label_time(lb_pwh, pwh, "PWH", w_col, show_pw, 30)

ln_pwl := f_upd_level_line_time(ln_pwl, pwl, pw_t, w_col, w_wid, w_sty, show_pw, 28)
lb_pwl := f_upd_level_label_time(lb_pwl, pwl, "PWL", w_col, show_pw, 30)

// Monthly offsets: Line = 36, Label = 38 (prevents overlap with Weekly/Daily)
ln_pmh := f_upd_level_line_time(ln_pmh, pmh, pm_t, m_col, m_wid, m_sty, show_pm, 36)
lb_pmh := f_upd_level_label_time(lb_pmh, pmh, "PMH", m_col, show_pm, 38)

ln_pml := f_upd_level_line_time(ln_pml, pml, pm_t, m_col, m_wid, m_sty, show_pm, 36)
lb_pml := f_upd_level_label_time(lb_pml, pml, "PML", m_col, show_pm, 38)

// =====================================================
// SESSION BOXES
// =====================================================
f_sess(_act, _t, _c) =>
    var box b = na
    var float h = 0.0
    var float l = 0.0
    t_val = time(timeframe.period, _t, i_tz)
    in_s  = not na(t_val)
    new_s = in_s and na(t_val[1])
    if _act and in_s
        if new_s
            h := high
            l := low
            b := box.new(bar_index, h, bar_index, l, bgcolor=color.new(_c, sess_transp), border_color=color.new(_c, 50))
        else if not na(b)
            h := math.max(high, h)
            l := math.min(low, l)
            box.set_top(b, h)
            box.set_bottom(b, l)
            box.set_right(b, bar_index)
    true

f_sess(s1_active, s1_time, s1_color)
f_sess(s2_active, s2_time, s2_color)
f_sess(s3_active, s3_time, s3_color)

// =====================================================
// SMC (CHoCH / BOS) - BACKGROUND LOGIC
// =====================================================
var float last_hi_piv = na
var float last_lo_piv = na
var int   trend = 0

ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low,  leftBars, rightBars)

if not na(ph)
    last_hi_piv := ph
if not na(pl)
    last_lo_piv := pl

cross_up_raw   = ta.crossover(close, last_hi_piv)
cross_down_raw = ta.crossunder(close, last_lo_piv)

if canSignal
    if cross_up_raw
        label.new(bar_index, high, trend != 1 ? "CHoCH" : "BOS", color=bullColor, textcolor=color.white, style=label.style_label_down, size=size.tiny)
        trend := 1
        last_hi_piv := na

    if cross_down_raw
        label.new(bar_index, low, trend != -1 ? "CHoCH" : "BOS", color=bearColor, textcolor=color.white, style=label.style_label_up, size=size.tiny)
        trend := -1
        last_lo_piv := na

// =====================================================
// LITE DASHBOARD (WITH MTF DISTANCES)
// =====================================================
f_render_row(table _db, int _idx, string _name, float _v1, float _v2, string _sz) =>
    table.cell(_db, 0, _idx, _name, text_color=color.white, bgcolor=color.black, text_size=_sz)
    table.cell(_db, 1, _idx, (na(_v1) or na(_v2)) ? "NA" : str.format("{0,number,#.##}% / {1,number,#.##}%", dist_pct(_v1), dist_pct(_v2)), text_color=color.white, bgcolor=color.black, text_size=_sz)
    true

get_table_pos(pos) =>
    switch pos
        "top_right"    => position.top_right
        "top_left"     => position.top_left
        "top_center"   => position.top_center
        "middle_right" => position.middle_right
        "middle_left"  => position.middle_left
        "bottom_right" => position.bottom_right
        "bottom_left"  => position.bottom_left
        => position.top_right

var table db = table.new(get_table_pos(db_pos), 2, 6, bgcolor=color.new(color.black, 0), border_width=2, border_color=color.white)

if barstate.islast and show_db
    // Row 0: Author Signature
    table.cell(db, 0, 0, "by Capitan-Trading", text_color=gold, bgcolor=color.black, text_size=db_size, text_halign=text.align_center)
    table.merge_cells(db, 0, 0, 1, 0)
    
    // Row 1: Timeframe and Simplified SMC Bias
    table.cell(db, 0, 1, "TIMEFRAME", text_color=color.white, bgcolor=color.black, text_size=db_size)
    tfTxt = timeframe.period + " (" + (trend == 1 ? "BULL" : "BEAR") + ")"
    tfCol = trend == 1 ? dbBullColor : dbBearColor
    table.cell(db, 1, 1, tfTxt, text_color=tfCol, bgcolor=color.black, text_size=db_size)

    // Rows 2-4: Multi-Timeframe Level Distances
    if show_pd
        f_render_row(db, 2, "DIST. PDH/L", pdh, pdl, db_size)
    if show_pw
        f_render_row(db, 3, "DIST. PWH/L", pwh, pwl, db_size)
    if show_pm
        f_render_row(db, 4, "DIST. PMH/L", pmh, pml, db_size)
        // minor refactor
