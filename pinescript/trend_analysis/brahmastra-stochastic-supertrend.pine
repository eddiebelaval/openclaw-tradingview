// ═══════════════════════════════════════════════════════════════════════════════
// STOCHASTIC SUPERTREND GRADIENT — Premium Edition
// Institutional-grade trend system with gradient cloud & momentum analysis
// Non-repainting | Confirmed bar logic | Pine Script v5
// ═══════════════════════════════════════════════════════════════════════════════

//@version=5
indicator(title="Stochastic Supertrend Gradient", shorttitle="SSG ⚡", overlay=true, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// --- Supertrend ---
atrLength   = input.int(10, title="ATR Length", minval=1)
atrMult     = input.float(3.0, title="ATR Multiplier", minval=0.5, step=0.1)

// --- Stochastic ---
kLength     = input.int(14, title="%K Length", minval=1)
dLength     = input.int(3, title="%D Length", minval=1)
kSmoothing  = input.int(3, title="Smoothing", minval=1)
obLevel     = input.int(80, title="Overbought", minval=50, maxval=100)
osLevel     = input.int(20, title="Oversold", minval=0, maxval=50)

// --- Visuals ---
showCloud    = input.bool(true, title="Show Cloud")
showSignals  = input.bool(true, title="Show Signals")
showGradient = input.bool(true, title="Gradient Candles")
showTable    = input.bool(true, title="Show Dashboard")
showTrail    = input.bool(true, title="Show Trend Trail Dots")

// ═══════════════════════════════════════════════════════════════════════════════
// SUPERTREND CALCULATION (Manual, non-repainting)
// ═══════════════════════════════════════════════════════════════════════════════

atr = ta.atr(atrLength)
rawUpperBand = hl2 + atrMult * atr
rawLowerBand = hl2 - atrMult * atr

var float upperBand = na
var float lowerBand = na

upperBand := nz(close[1]) > nz(upperBand[1]) ? math.max(rawUpperBand, nz(upperBand[1])) : rawUpperBand
lowerBand := nz(close[1]) < nz(lowerBand[1]) ? math.min(rawLowerBand, nz(lowerBand[1])) : rawLowerBand

var int trend = 1

if close > nz(upperBand[1])
    trend := 1
else if close < nz(lowerBand[1])
    trend := -1

stValue = trend == 1 ? lowerBand : upperBand

// ═══════════════════════════════════════════════════════════════════════════════
// STOCHASTIC CALCULATION
// ═══════════════════════════════════════════════════════════════════════════════

rawK    = ta.stoch(close, high, low, kLength)
smoothK = ta.sma(rawK, kSmoothing)
smoothD = ta.sma(smoothK, dLength)

bullishStoch = ta.crossover(smoothK, smoothD) and smoothK < 30
bearishStoch = ta.crossunder(smoothK, smoothD) and smoothK > 70

// ═══════════════════════════════════════════════════════════════════════════════
// ENTRY CONDITIONS
// ═══════════════════════════════════════════════════════════════════════════════

buyCondition  = trend == 1 and bullishStoch
sellCondition = trend == -1 and bearishStoch

// Trend flip detection
bullFlip = trend == 1 and trend[1] == -1
bearFlip = trend == -1 and trend[1] == 1

// ═══════════════════════════════════════════════════════════════════════════════
// MOMENTUM STRENGTH (0-100)
// ═══════════════════════════════════════════════════════════════════════════════

stochStrength  = trend == 1 ? math.max(smoothK, 0) : math.max(100 - smoothK, 0)
trendBars      = ta.barssince(bullFlip or bearFlip)
maturity       = math.min(trendBars / 20.0, 1.0) * 100
momentum       = (stochStrength + maturity) / 2

// ═══════════════════════════════════════════════════════════════════════════════
// GRADIENT CANDLE COLORING
// ═══════════════════════════════════════════════════════════════════════════════

bullBright = color.new(#00E676, 0)
bullMedium = color.new(#00C853, 30)
bullWeak   = color.new(#A5D6A7, 55)
bearBright = color.new(#FF5252, 0)
bearMedium = color.new(#E53935, 30)
bearWeak   = color.new(#EF9A9A, 55)

var color gradientColor = na

if trend == 1
    if smoothK > obLevel
        gradientColor := bullBright
    else if smoothK > 50
        gradientColor := bullMedium
    else
        gradientColor := bullWeak
else
    if smoothK < osLevel
        gradientColor := bearBright
    else if smoothK < 50
        gradientColor := bearMedium
    else
        gradientColor := bearWeak

barcolor(showGradient ? gradientColor : na)

// ═══════════════════════════════════════════════════════════════════════════════
// MULTI-LAYER GRADIENT CLOUD (Premium Colors)
// ═══════════════════════════════════════════════════════════════════════════════

// Premium color palette — Teal/Cyan for bull, Magenta/Crimson for bear
bullCore  = #00BCD4   // Teal
bullGlow  = #00E5FF   // Cyan
bearCore  = #E91E63   // Magenta
bearGlow  = #FF1744   // Crimson

// Dynamic transparency — stronger momentum = richer cloud
coreTransp = trend == 1 ? (smoothK > obLevel ? 50 : smoothK > 50 ? 65 : 78) : (smoothK < osLevel ? 50 : smoothK < 50 ? 65 : 78)
glowTransp = coreTransp + 12

coreCol = trend == 1 ? color.new(bullCore, coreTransp) : color.new(bearCore, coreTransp)
glowCol = trend == 1 ? color.new(bullGlow, glowTransp) : color.new(bearGlow, glowTransp)

// Three plot levels for layered gradient fill
p_st     = plot(showCloud ? stValue : na, title="ST", color=color.new(color.white, 100), display=display.none)
p_mid    = plot(showCloud ? (stValue + close) / 2 : na, title="Mid", color=color.new(color.white, 100), display=display.none)
p_close  = plot(showCloud ? close : na, title="CL", color=color.new(color.white, 100), display=display.none)

// Layer 1: Supertrend → Midpoint (deeper, richer)
fill(p_st, p_mid, color=showCloud ? coreCol : na, title="Cloud Core")
// Layer 2: Midpoint → Price (lighter glow)
fill(p_mid, p_close, color=showCloud ? glowCol : na, title="Cloud Glow")

// ═══════════════════════════════════════════════════════════════════════════════
// TREND TRAIL DOTS (Premium visual on Supertrend level)
// ═══════════════════════════════════════════════════════════════════════════════

dotColor = trend == 1 ? color.new(#00BCD4, 10) : color.new(#E91E63, 10)
plot(showTrail ? stValue : na, title="Trend Trail", color=dotColor, linewidth=2, style=plot.style_circles)

// ═══════════════════════════════════════════════════════════════════════════════
// PREMIUM SIGNAL MARKERS WITH LABELS
// ═══════════════════════════════════════════════════════════════════════════════

// Buy signals
plotshape(showSignals and buyCondition ? low : na, title="Buy Arrow", style=shape.triangleup, location=location.belowbar, color=color.new(#00E676, 0), size=size.tiny)

if showSignals and buyCondition
    label.new(bar_index, low, "BUY", style=label.style_label_up, color=color.new(#00E676, 10), textcolor=color.white, size=size.small)

// Sell signals
plotshape(showSignals and sellCondition ? high : na, title="Sell Arrow", style=shape.triangledown, location=location.abovebar, color=color.new(#FF5252, 0), size=size.tiny)

if showSignals and sellCondition
    label.new(bar_index, high, "SELL", style=label.style_label_down, color=color.new(#FF5252, 10), textcolor=color.white, size=size.small)

// Trend flip markers (subtle)
plotshape(showSignals and bullFlip and not buyCondition ? stValue : na, title="Bull Flip", style=shape.diamond, location=location.absolute, color=color.new(#00E676, 40), size=size.tiny)
plotshape(showSignals and bearFlip and not sellCondition ? stValue : na, title="Bear Flip", style=shape.diamond, location=location.absolute, color=color.new(#FF5252, 40), size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// PREMIUM DASHBOARD (Dark Theme)
// ═══════════════════════════════════════════════════════════════════════════════

var table dash = table.new(position.top_right, 2, 7, bgcolor=color.new(#0D1117, 0), border_width=1, border_color=color.new(#21262D, 0), frame_width=2, frame_color=color.new(#30363D, 0))

if showTable and barstate.islast
    // Trend state
    trendText  = trend == 1 ? "▲ BULLISH" : "▼ BEARISH"
    trendCol   = trend == 1 ? color.new(#00E676, 0) : color.new(#FF5252, 0)

    // Stochastic zone
    stochZone = smoothK > obLevel ? "OVERBOUGHT" : smoothK < osLevel ? "OVERSOLD" : "NEUTRAL"
    stochCol  = smoothK > obLevel ? color.new(#FF9800, 0) : smoothK < osLevel ? color.new(#2196F3, 0) : color.new(#78909C, 0)

    // Momentum label
    momLabel = momentum > 70 ? "● STRONG" : momentum > 40 ? "● MODERATE" : "● WEAK"
    momCol   = momentum > 70 ? color.new(#00E676, 0) : momentum > 40 ? color.new(#FFC107, 0) : color.new(#78909C, 0)

    // Bars in trend
    barsText = str.tostring(trendBars) + " bars"

    // Header
    table.cell(dash, 0, 0, "⚡ SSG", text_color=color.white, text_size=size.small, bgcolor=color.new(#161B22, 0))
    table.cell(dash, 1, 0, "PREMIUM", text_color=color.new(#58A6FF, 0), text_size=size.small, bgcolor=color.new(#161B22, 0))

    // Trend
    table.cell(dash, 0, 1, "Trend", text_color=color.new(#8B949E, 0), text_size=size.tiny)
    table.cell(dash, 1, 1, trendText, text_color=trendCol, text_size=size.tiny)

    // Stochastic
    table.cell(dash, 0, 2, "%K / %D", text_color=color.new(#8B949E, 0), text_size=size.tiny)
    table.cell(dash, 1, 2, str.tostring(smoothK, "#.#") + " / " + str.tostring(smoothD, "#.#"), text_color=color.white, text_size=size.tiny)

    // Zone
    table.cell(dash, 0, 3, "Zone", text_color=color.new(#8B949E, 0), text_size=size.tiny)
    table.cell(dash, 1, 3, stochZone, text_color=stochCol, text_size=size.tiny)

    // Momentum
    table.cell(dash, 0, 4, "Momentum", text_color=color.new(#8B949E, 0), text_size=size.tiny)
    table.cell(dash, 1, 4, momLabel, text_color=momCol, text_size=size.tiny)

    // Duration
    table.cell(dash, 0, 5, "Duration", text_color=color.new(#8B949E, 0), text_size=size.tiny)
    table.cell(dash, 1, 5, barsText, text_color=color.new(#C9D1D9, 0), text_size=size.tiny)

    // ADX/ATR
    table.cell(dash, 0, 6, "ATR", text_color=color.new(#8B949E, 0), text_size=size.tiny)
    table.cell(dash, 1, 6, str.tostring(atr, "#.##"), text_color=color.new(#C9D1D9, 0), text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════

alertcondition(buyCondition, title="SSG Buy", message="⚡ SSG: BUY signal confirmed")
alertcondition(sellCondition, title="SSG Sell", message="⚡ SSG: SELL signal confirmed")
alertcondition(bullFlip, title="Bullish Flip", message="⚡ SSG: Supertrend flipped BULLISH")
alertcondition(bearFlip, title="Bearish Flip", message="⚡ SSG: Supertrend flipped BEARISH")
