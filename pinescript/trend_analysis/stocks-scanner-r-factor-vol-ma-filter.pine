//@version=6
indicator("STOCK SCANNER (R-FACTOR) — Vol MA Filter", overlay=true)

// === Inputs
atrPeriod          = input.int(10,  "Supertrend ATR Period")
factor             = input.float(3.0, "Supertrend Factor", step=0.1)
emaPeriod          = input.int(21,  "EMA Period")
vwmaPeriod         = input.int(20,  "VWMA Period")
volMaLen           = input.int(20,  "Volume MA Length")
confirmOnClose     = input.bool(true, "Only alert on bar close")

// === Session filters
startHour          = input.int(9,   "Market Start Hour")
startMinute        = input.int(15,  "Market Start Minute")
allowAfterMin      = input.int(15,  "Block First X Minutes")
cutoffHour         = input.int(14,  "Cutoff Hour")
cutoffMinute       = input.int(45,  "Cutoff Minute")

// === Low-volume hour filter
useTimeVolFilter   = input.bool(true, "Use Intraday Volume Filter")
minVolVsAvg        = input.float(0.80, "Min Volume vs Avg Volume", step=0.05)

// === EMA 21
ema21 = ta.ema(close, emaPeriod)
plot(ema21, "EMA 21", color=color.orange, linewidth=2)

// === VWAP
vwap = ta.vwap
plot(vwap, "VWAP", color=color.blue, linewidth=2)

// === VWMA 20
vwma = ta.vwma(close, vwmaPeriod)
plot(vwma, "VWMA 20", color=color.fuchsia, linewidth=2)

// === Supertrend (manual)
atr   = ta.atr(atrPeriod)
midHL = (high + low) / 2.0
upper = midHL + factor * atr
lower = midHL - factor * atr

var float st    = na
var bool  dirUp = true

if na(st)
    st    := close > upper ? lower : upper
    dirUp := close > upper
else
    if close > st[1]
        st    := math.max(lower, st[1])
        dirUp := true
    else
        st    := math.min(upper, st[1])
        dirUp := false

plot(st, "Supertrend", color=dirUp ? color.green : color.red, linewidth=2)

// === Volume MA + candle color
volMA   = ta.sma(volume, volMaLen)
isRed   = close < open
isGreen = close > open

// === Price alignment
aboveAll = close > ema21 and close > vwap and close > vwma and close > st
belowAll = close < ema21 and close < vwap and close < vwma and close < st

// === Base raw signals
rawBuy  = aboveAll and (volume > volMA)
rawSell = belowAll and (volume > volMA) and isRed

baseBuySignal  = (confirmOnClose ? barstate.isconfirmed : true) and rawBuy
baseSellSignal = (confirmOnClose ? barstate.isconfirmed : true) and rawSell

// =====================================================
// === DAY RESET LOGIC
// =====================================================
newDay = dayofmonth != dayofmonth[1]

var bool signalTakenToday = false
if newDay
    signalTakenToday := false

// =====================================================
// === TIME WINDOW FILTER
// =====================================================
curMins      = hour * 60 + minute
marketOpen   = startHour * 60 + startMinute
firstAllowed = marketOpen + allowAfterMin
cutoffTime   = cutoffHour * 60 + cutoffMinute

isAllowedTime = curMins >= firstAllowed and curMins <= cutoffTime

// =====================================================
// === LOW-VOLUME HOURS FILTER
// Compare current bar volume with average volume
// If current bar volume is too low relative to avg, block signal
// =====================================================
avgBarVol      = ta.sma(volume, volMaLen)
volStrengthOk  = avgBarVol > 0 ? (volume / avgBarVol) >= minVolVsAvg : false
timeVolOk      = useTimeVolFilter ? volStrengthOk : true

// =====================================================
// === FINAL SIGNAL FILTER
// =====================================================
canFireSignal = not signalTakenToday and isAllowedTime and timeVolOk

buySignal  = baseBuySignal and canFireSignal
sellSignal = baseSellSignal and canFireSignal

if buySignal or sellSignal
    signalTakenToday := true

// === Markers
plotshape(buySignal, title="Strong BUY", location=location.belowbar,
     color=color.rgb(0,115,104), style=shape.triangleup,
     text="Strong\nBUY", textcolor=color.black, size=size.small)

plotshape(sellSignal, title="Strong SELL", location=location.abovebar,
     color=color.maroon, style=shape.triangledown,
     text="Strong\nSELL", textcolor=color.rgb(0, 0, 0), size=size.small)

// === Debug plots (optional)
plotchar(signalTakenToday, title="Signal Taken Today", char="1", location=location.top, color=color.gray, size=size.tiny)
plotchar(isAllowedTime, title="Allowed Time", char="T", location=location.top, color=color.green, size=size.tiny)
plotchar(timeVolOk, title="Volume Filter OK", char="V", location=location.top, color=color.blue, size=size.tiny)

// === Alerts
alertcondition(buySignal, title="STRONG_BUY",
     message='{"event":"STRONG_BUY","ticker":"{{ticker}}","price":{{close}},"time":"{{timenow}}","volume":{{volume}},"note":"oneSignalPerDay+timeFilter"}')

alertcondition(sellSignal, title="STRONG_SELL",
     message='{"event":"STRONG_SELL","ticker":"{{ticker}}","price":{{close}},"time":"{{timenow}}","volume":{{volume}},"note":"oneSignalPerDay+timeFilter"}')
