// © OmegaTools

//@version=6
indicator("Intraday Levels [OmegaTools]", overlay = true)

// Inputs ------------------------------------------

inp1 = input.bool(true, 'Weekly', group = 'Settings', inline = '1')
style1 = input.string('Solid', '', ['Solid', 'Dashed', 'Dotted'], group = 'Settings', inline = '1')
col1up = input.color(#2962ff, '', group = 'Settings', inline = '1')
col1dn = input.color(#e91e63, '', group = 'Settings', inline = '1')
width1 = input.int(3, '', group = 'Settings', inline = '1')

inp2 = input.bool(true, 'Daily', group = 'Settings', inline = '2')
style2 = input.string('Solid', '', ['Solid', 'Dashed', 'Dotted'], group = 'Settings', inline = '2')
col2up = input.color(#2962ff, '', group = 'Settings', inline = '2')
col2dn = input.color(#e91e63, '', group = 'Settings', inline = '2')
width2 = input.int(2, '', group = 'Settings', inline = '2')

inp3 = input.bool(true, 'Asian', group = 'Settings', inline = '3')
style3 = input.string('Dashed', '', ['Solid', 'Dashed', 'Dotted'], group = 'Settings', inline = '3')
col3up = input.color(#2962ff, '', group = 'Settings', inline = '3')
col3dn = input.color(#e91e63, '', group = 'Settings', inline = '3')
width3 = input.int(1, '', group = 'Settings', inline = '3')

inp4 = input.bool(false, 'London', group = 'Settings', inline = '4')
style4 = input.string('Dashed', '', ['Solid', 'Dashed', 'Dotted'], group = 'Settings', inline = '4')
col4up = input.color(#2962ff, '', group = 'Settings', inline = '4')
col4dn = input.color(#e91e63, '', group = 'Settings', inline = '4')
width4 = input.int(1, '', group = 'Settings', inline = '4')

inp5 = input.bool(false, 'New York', group = 'Settings', inline = '5')
style5 = input.string('Dashed', '', ['Solid', 'Dashed', 'Dotted'], group = 'Settings', inline = '5')
col5up = input.color(#2962ff, '', group = 'Settings', inline = '5')
col5dn = input.color(#e91e63, '', group = 'Settings', inline = '5')
width5 = input.int(1, '', group = 'Settings', inline = '5')

inp6 = input.bool(true, 'Initial 15M', group = 'Settings', inline = '6')
style6 = input.string('Dotted', '', ['Solid', 'Dashed', 'Dotted'], group = 'Settings', inline = '6')
col6up = input.color(#2962ff, '', group = 'Settings', inline = '6')
col6dn = input.color(#e91e63, '', group = 'Settings', inline = '6')
width6 = input.int(1, '', group = 'Settings', inline = '6')

inp7 = input.bool(false, 'Initial 30M', group = 'Settings', inline = '7')
style7 = input.string('Dotted', '', ['Solid', 'Dashed', 'Dotted'], group = 'Settings', inline = '7')
col7up = input.color(#2962ff, '', group = 'Settings', inline = '7')
col7dn = input.color(#e91e63, '', group = 'Settings', inline = '7')
width7 = input.int(1, '', group = 'Settings', inline = '7')

ext = 11

// Calculations ------------------------------------------

timeincrease = timeframe.in_seconds(timeframe.period) * ext * 1000
timeincrease2 = timeframe.in_seconds(timeframe.period) * (ext + 2) * 1000

asian = time == time(timeframe.period, '0000-0800', 'Europe/Rome')
london = time == time(timeframe.period, '0800-1400', 'Europe/Rome')
newyork = time == time(timeframe.period, '1530-2000', 'Europe/Rome')
initial15 = time == time(timeframe.period, '1530-1545', 'Europe/Rome')
initial30 = time == time(timeframe.period, '1530-1600', 'Europe/Rome')

var float wh = na
var float wl = na
if timeframe.change('1W')
    wh := high
    wl := low
else
    wh := math.max(high, wh)
    wl := math.min(low, wl)
var line ln11 = na
var label lb11 = na
time11 = ta.valuewhen(high == wh, time, 0)
var line ln12 = na
var label lb12 = na
time12 = ta.valuewhen(low == wl, time, 0)

var float dh = na
var float dl = na
if timeframe.change('1D')
    dh := high
    dl := low
else
    dh := math.max(high, dh)
    dl := math.min(low, dl)
var line ln21 = na
time21 = ta.valuewhen(high == dh, time, 0)
var line ln22 = na
time22 = ta.valuewhen(low == dl, time, 0)

var float ah = na
var float al = na
if asian and not asian[1]
    ah := high
    al := low
else if asian
    ah := math.max(high, ah)
    al := math.min(low, al)
var line ln31 = na
time31 = ta.valuewhen(high == ah, time, 0)
var line ln32 = na
time32 = ta.valuewhen(low == al, time, 0)

var float lh = na
var float ll = na
if london and not london[1]
    lh := high
    ll := low
else if london
    lh := math.max(high, lh)
    ll := math.min(low, ll)
var line ln41 = na
time41 = ta.valuewhen(high == lh, time, 0)
var line ln42 = na
time42 = ta.valuewhen(low == ll, time, 0)

var float nh = na
var float nl = na
if newyork and not newyork[1]
    nh := high
    nl := low
else if newyork
    nh := math.max(high, nh)
    nl := math.min(low, nl)
var line ln51 = na
time51 = ta.valuewhen(high == nh, time, 0)
var line ln52 = na
time52 = ta.valuewhen(low == nl, time, 0)

var float i15h = na
var float i15l = na
if initial15 and not initial15[1]
    i15h := high
    i15l := low
else if initial15
    i15h := math.max(high, i15h)
    i15l := math.min(low, i15l)
var line ln61 = na
time61 = ta.valuewhen(high == i15h, time, 0)
var line ln62 = na
time62 = ta.valuewhen(low == i15l, time, 0)

var float i30h = na
var float i30l = na
if initial30 and not initial30[1]
    i30h := high
    i30l := low
else if initial30
    i30h := math.max(high, i30h)
    i30l := math.min(low, i30l)
var line ln71 = na
time71 = ta.valuewhen(high == i30h, time, 0)
var line ln72 = na
time72 = ta.valuewhen(low == i30l, time, 0)

// Plotting Lines ------------------------------------------

getLineStyle(s) => s == 'Dashed' ? line.style_dashed : s == 'Dotted' ? line.style_dotted : line.style_solid

// Weekly
if inp1 and not na(wh) and not na(time11)
    ln11 := line.new(x1 = time11, x2 = time + timeincrease, y1 = wh, y2 = wh, xloc = xloc.bar_time, color = col1dn, style = getLineStyle(style1), width = width1)
else
    ln11 := na
if not na(ln11[1])
    line.delete(ln11[1])

if inp1 and not na(wl) and not na(time12)
    ln12 := line.new(x1 = time12, x2 = time + timeincrease, y1 = wl, y2 = wl, xloc = xloc.bar_time, color = col1up, style = getLineStyle(style1), width = width1)
else
    ln12 := na
if not na(ln12[1])
    line.delete(ln12[1])

// Daily
if inp2 and not na(dh) and not na(time21)
    ln21 := line.new(x1 = time21, x2 = time + timeincrease, y1 = dh, y2 = dh, xloc = xloc.bar_time, color = col2dn, style = getLineStyle(style2), width = width2)
else
    ln21 := na
if not na(ln21[1])
    line.delete(ln21[1])

if inp2 and not na(dl) and not na(time22)
    ln22 := line.new(x1 = time22, x2 = time + timeincrease, y1 = dl, y2 = dl, xloc = xloc.bar_time, color = col2up, style = getLineStyle(style2), width = width2)
else
    ln22 := na
if not na(ln22[1])
    line.delete(ln22[1])

// Asian Session
if inp3 and not na(ah) and not na(time31)
    ln31 := line.new(x1 = time31, x2 = time + timeincrease, y1 = ah, y2 = ah, xloc = xloc.bar_time, color = col3dn, style = getLineStyle(style3), width = width3)
else
    ln31 := na
if not na(ln31[1])
    line.delete(ln31[1])

if inp3 and not na(al) and not na(time32)
    ln32 := line.new(x1 = time32, x2 = time + timeincrease, y1 = al, y2 = al, xloc = xloc.bar_time, color = col3up, style = getLineStyle(style3), width = width3)
else
    ln32 := na
if not na(ln32[1])
    line.delete(ln32[1])

// London Session
if inp4 and not na(lh) and not na(time41)
    ln41 := line.new(x1 = time41, x2 = time + timeincrease, y1 = lh, y2 = lh, xloc = xloc.bar_time, color = col4dn, style = getLineStyle(style4), width = width4)
else
    ln41 := na
if not na(ln41[1])
    line.delete(ln41[1])

if inp4 and not na(ll) and not na(time42)
    ln42 := line.new(x1 = time42, x2 = time + timeincrease, y1 = ll, y2 = ll, xloc = xloc.bar_time, color = col4up, style = getLineStyle(style4), width = width4)
else
    ln42 := na
if not na(ln42[1])
    line.delete(ln42[1])

// New York Session
if inp5 and not na(nh) and not na(time51)
    ln51 := line.new(x1 = time51, x2 = time + timeincrease, y1 = nh, y2 = nh, xloc = xloc.bar_time, color = col5dn, style = getLineStyle(style5), width = width5)
else
    ln51 := na
if not na(ln51[1])
    line.delete(ln51[1])

if inp5 and not na(nl) and not na(time52)
    ln52 := line.new(x1 = time52, x2 = time + timeincrease, y1 = nl, y2 = nl, xloc = xloc.bar_time, color = col5up, style = getLineStyle(style5), width = width5)
else
    ln52 := na
if not na(ln52[1])
    line.delete(ln52[1])

// Initial 15M
if inp6 and not na(i15h) and not na(time61)
    ln61 := line.new(x1 = time61, x2 = time + timeincrease, y1 = i15h, y2 = i15h, xloc = xloc.bar_time, color = col6dn, style = getLineStyle(style6), width = width6)
else
    ln61 := na
if not na(ln61[1])
    line.delete(ln61[1])

if inp6 and not na(i15l) and not na(time62)
    ln62 := line.new(x1 = time62, x2 = time + timeincrease, y1 = i15l, y2 = i15l, xloc = xloc.bar_time, color = col6up, style = getLineStyle(style6), width = width6)
else
    ln62 := na
if not na(ln62[1])
    line.delete(ln62[1])

// Initial 30M
if inp7 and not na(i30h) and not na(time71)
    ln71 := line.new(x1 = time71, x2 = time + timeincrease, y1 = i30h, y2 = i30h, xloc = xloc.bar_time, color = col7dn, style = getLineStyle(style7), width = width7)
else
    ln71 := na
if not na(ln71[1])
    line.delete(ln71[1])

if inp7 and not na(i30l) and not na(time72)
    ln72 := line.new(x1 = time72, x2 = time + timeincrease, y1 = i30l, y2 = i30l, xloc = xloc.bar_time, color = col7up, style = getLineStyle(style7), width = width7)
else
    ln72 := na
if not na(ln72[1])
    line.delete(ln72[1])

// Plotting Labels ------------------------------------------


var label[] mergedLblRefs = array.new_label()
var float[] mergedLblPrices = array.new_float()
var string[] mergedLblTexts = array.new_string()
var color[] mergedLblTextCols = array.new_color()

addMergedLevel(float lvl, string txt, color txtCol) =>
    if not na(lvl)
        int idx = -1

        if array.size(mergedLblPrices) > 0
            for i = 0 to array.size(mergedLblPrices) - 1
                if math.abs(array.get(mergedLblPrices, i) - lvl) <= syminfo.mintick * 4
                    idx := i
                    break

        if idx == -1
            array.push(mergedLblPrices, lvl)
            array.push(mergedLblTexts, txt)
            array.push(mergedLblTextCols, txtCol)
        else
            oldTxt = array.get(mergedLblTexts, idx)
            if not str.contains(oldTxt, txt)
                array.set(mergedLblTexts, idx, oldTxt + " + " + txt)

            oldCol = array.get(mergedLblTextCols, idx)
            // If merged levels have different colors, use neutral text color
            array.set(mergedLblTextCols, idx, oldCol == txtCol ? oldCol : chart.fg_color)

if array.size(mergedLblRefs) > 0
    for i = 0 to array.size(mergedLblRefs) - 1
        label.delete(array.get(mergedLblRefs, i))
array.clear(mergedLblRefs)
array.clear(mergedLblPrices)
array.clear(mergedLblTexts)
array.clear(mergedLblTextCols)

// Weekly
if inp1
    addMergedLevel(wh, "Weekly High", col1dn)
    addMergedLevel(wl, "Weekly Low", col1up)

// Daily
if inp2
    addMergedLevel(dh, "Daily High", col2dn)
    addMergedLevel(dl, "Daily Low", col2up)

// Asian
if inp3
    addMergedLevel(ah, "Asian High", col3dn)
    addMergedLevel(al, "Asian Low", col3up)

// London
if inp4
    addMergedLevel(lh, "London High", col4dn)
    addMergedLevel(ll, "London Low", col4up)

// New York
if inp5
    addMergedLevel(nh, "New York High", col5dn)
    addMergedLevel(nl, "New York Low", col5up)

// Initial 15M
if inp6
    addMergedLevel(i15h, "Initial 15M High", col6dn)
    addMergedLevel(i15l, "Initial 15M Low", col6up)

// Initial 30M
if inp7
    addMergedLevel(i30h, "Initial 30M High", col7dn)
    addMergedLevel(i30l, "Initial 30M Low", col7up)

if array.size(mergedLblPrices) > 0
    for i = 0 to array.size(mergedLblPrices) - 1
        lb = label.new(
             x = time + timeincrease2,
             y = array.get(mergedLblPrices, i),
             text = array.get(mergedLblTexts, i),
             xloc = xloc.bar_time,
             yloc = yloc.price,
             color = color.new(chart.fg_color, 90),
             style = label.style_label_left,
             textcolor = array.get(mergedLblTextCols, i),
             size = size.tiny)
        array.push(mergedLblRefs, lb)

// End of Script
