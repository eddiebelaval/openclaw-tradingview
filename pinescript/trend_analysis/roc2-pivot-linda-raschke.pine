//@version=5
indicator("ROC(2) Pivot (Raschke)", overlay=true, max_bars_back=200)

// ═══════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════

GRP_DISP = "Display"
showLabel = input.bool(true, "Show Price Label", group=GRP_DISP)
showFill  = input.bool(true, "Show Bias Zone", group=GRP_DISP)
lineWidth = input.int(2, "Line Width", minval=1, maxval=4, group=GRP_DISP)
bullColor = input.color(color.new(#26a69a, 0), "Long Color", group=GRP_DISP)
bearColor = input.color(color.new(#ef5350, 0), "Short Color", group=GRP_DISP)
fillTranp = input.int(90, "Fill Transparency", minval=70, maxval=97, group=GRP_DISP)

GRP_CTX = "Context"
showTable   = input.bool(true, "Show Info Table", group=GRP_CTX)
respectLen  = input.int(10, "Respect Lookback (days)", minval=3, maxval=50, group=GRP_CTX, tooltip="How many completed sessions to check. Shows how often the daily open and close stayed on the same side of the pivot.")
tablePos    = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=GRP_CTX)
tableSize   = input.string("Small", "Table Size", options=["Tiny", "Small", "Normal", "Large"], group=GRP_CTX)
darkTheme   = input.bool(true, "Dark Theme", group=GRP_CTX)

// ═══════════════════════════════════════════════════════════════════════
// ROC(2) PIVOT — from daily closes
// ═══════════════════════════════════════════════════════════════════════

// Pivot = (Yesterday's Close - Close 3 days ago) + Close 2 days ago
// The level where the 2-period rate of change flips sign
// Raschke, Street Smarts Ch.8 / Taylor Trading Technique

// --- Pivot: safe with lookahead_on (uses only prior closes) ---
f_pivot() =>
    math.round_to_mintick((close[1] - close[3]) + close[2])

dailyPivot = request.security(syminfo.tickerid, "D", f_pivot(), barmerge.gaps_off, barmerge.lookahead_on)

// --- Context stats: lookahead_off so streak/respect use completed days only ---
f_context() =>
    // All references use close[1]+ to avoid the live (unclosed) bar
    // Last completed day's pivot and confirmed bias
    float _prevPivot = math.round_to_mintick((close[2] - close[4]) + close[3])
    bool _prevIsLong = close[1] > _prevPivot

    // Two completed days ago — for streak comparison
    float _olderPivot = math.round_to_mintick((close[3] - close[5]) + close[4])
    bool _olderIsLong = close[2] > _olderPivot

    // Streak: consecutive completed days with same bias direction
    bool _hasHistory = not na(close[5])
    var int _streak = 0
    _streak := not _hasHistory ? 1 : (_prevIsLong == _olderIsLong ? _streak + 1 : 1)

    // Respect: did the last completed session hold its pivot?
    // If the day's range straddled the pivot, price crossed through it.
    bool _crossed = high[1] > _prevPivot and low[1] < _prevPivot
    float _held = _crossed ? 0.0 : 1.0
    float _respectN = math.sum(_held, respectLen)

    [_prevIsLong, float(_streak), _respectN]

[dailyIsLong, dailyStreak, dailyRespect] = request.security(syminfo.tickerid, "D", f_context(), barmerge.gaps_off, barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════════
// BIAS
// ═══════════════════════════════════════════════════════════════════════

isLong  = not na(dailyPivot) and close > dailyPivot
lineClr = na(dailyPivot) ? color.gray : isLong ? bullColor : bearColor

// ═══════════════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════════════

pivotLine = plot(dailyPivot, "ROC(2) Pivot", lineClr, lineWidth)
priceLine = plot(showFill ? close : na, "Price", na, display=display.none)
fill(pivotLine, priceLine, color=na(dailyPivot) ? na : isLong ? color.new(bullColor, fillTranp) : color.new(bearColor, fillTranp), title="Bias Zone")

// ═══════════════════════════════════════════════════════════════════════
// LABEL
// ═══════════════════════════════════════════════════════════════════════

var label pivotLbl = na
if barstate.islast and showLabel and not na(dailyPivot)
    if not na(pivotLbl)
        label.delete(pivotLbl)
    pivotLbl := label.new(bar_index + 3, dailyPivot, "ROC2 " + str.tostring(dailyPivot), style=label.style_label_left, color=lineClr, textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════════════
// INFO TABLE
// ═══════════════════════════════════════════════════════════════════════

tblPos = switch tablePos
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    => position.bottom_left

tblSize = switch tableSize
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    => size.large

headerBg = darkTheme ? color.new(#16213e, 0) : color.new(#e0e0e0, 0)
cellBg   = darkTheme ? color.new(#1a1a2e, 0) : color.new(#f5f5f5, 0)
txtColor = darkTheme ? color.new(#d4d4d4, 0) : color.new(#1a1a1a, 0)
dimColor = darkTheme ? color.new(#5a5a7a, 0) : color.new(#999999, 0)
borderClr = darkTheme ? color.new(#2a2a4a, 0) : color.new(#cccccc, 0)

var table tbl = table.new(tblPos, 2, 4, border_width=1, border_color=borderClr, frame_width=1, frame_color=borderClr)

if barstate.islast and showTable and not na(dailyPivot)
    table.clear(tbl, 0, 0, 1, 3)

    // Row 0: Bias
    string biasStr = isLong ? "LONG" : "SHORT"
    color biasClr  = isLong ? bullColor : bearColor
    color biasBg   = isLong ? color.new(bullColor, 85) : color.new(bearColor, 85)
    table.cell(tbl, 0, 0, " Bias ",  text_color=dimColor, bgcolor=headerBg, text_size=tblSize)
    table.cell(tbl, 1, 0, " " + biasStr + " ", text_color=biasClr, bgcolor=biasBg, text_size=tblSize)

    // Row 1: Pivot price
    table.cell(tbl, 0, 1, " Pivot ", text_color=dimColor, bgcolor=headerBg, text_size=tblSize)
    table.cell(tbl, 1, 1, " " + str.tostring(dailyPivot) + " ", text_color=txtColor, bgcolor=cellBg, text_size=tblSize)

    // Row 2: Streak (extend completed-day streak with today's live bias)
    int streakInt = isLong == dailyIsLong ? int(nz(dailyStreak, 1)) + 1 : 1
    string streakDir = isLong ? " long" : " short"
    table.cell(tbl, 0, 2, " Streak ", text_color=dimColor, bgcolor=headerBg, text_size=tblSize)
    table.cell(tbl, 1, 2, " " + str.tostring(streakInt) + "d" + streakDir + " ", text_color=streakInt >= 5 ? color.new(#ff9800, 0) : txtColor, bgcolor=cellBg, text_size=tblSize)

    // Row 3: Respect score
    int respectInt = int(nz(dailyRespect, 0))
    float respectPct = respectLen > 0 ? respectInt / respectLen * 100 : 0
    color respectClr = respectPct >= 70 ? bullColor : respectPct <= 40 ? bearColor : dimColor
    table.cell(tbl, 0, 3, " Respect ", text_color=dimColor, bgcolor=headerBg, text_size=tblSize)
    table.cell(tbl, 1, 3, " " + str.tostring(respectInt) + "/" + str.tostring(respectLen) + " ", text_color=respectClr, bgcolor=cellBg, text_size=tblSize)

// ═══════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════

alertcondition(isLong and not isLong[1], "Bias Flipped Long",  "ROC(2) Bias flipped to LONG — price crossed above pivot")
alertcondition(not isLong and isLong[1], "Bias Flipped Short", "ROC(2) Bias flipped to SHORT — price crossed below pivot")
