//@version=5
indicator("Institutional Bounce-MA [Coding Partner]", shorttitle="Inst-Bounce", overlay=true)

// =========================================================================
// 1. INPUT SETTINGS
// =========================================================================
grp_ma = "Moving Average Settings"
maType = input.string("EMA", title="MA Type", options=["EMA", "SMA", "WMA"], group=grp_ma)
maLength = input.int(40, title="MA Length", minval=1, group=grp_ma)

grp_slope = "Whipsaw Filter (Slope & Flatness)"
slopeLookback = input.int(5, title="Slope Lookback (Bars)", minval=1, group=grp_slope)
flatThresh = input.float(0.02, title="Flatness Threshold (%)", step=0.01, minval=0.0, group=grp_slope, tooltip="Used for both Slope Angle and Price Distance. (0.02 is ideal for indices)")

// --- INSTITUTIONAL FILTERS ---
grp_inst = "Institutional Filters (Smart Money)"
useVol = input.bool(true, title="Require Volume Spike? (Footprint)", group=grp_inst)
volMult = input.float(1.2, title="Volume Spike Multiplier", step=0.1, group=grp_inst, tooltip="Requires the bounce candle's volume to be 1.2x higher than the 20-period average.")

useWick = input.bool(true, title="Require Wick Rejection? (Absorption)", group=grp_inst)
wickMult = input.float(1.5, title="Wick-to-Body Ratio", step=0.1, group=grp_inst, tooltip="The rejection wick must be at least 1.5x larger than the candle body to prove institutional buying/selling.")

// =========================================================================
// 2. CORE CALCULATIONS (MA & Slope)
// =========================================================================
// FIX 1: Using a flat ternary operator to prevent ANY copy-paste spacing errors
myMA = maType == "SMA" ? ta.sma(close, maLength) : maType == "WMA" ? ta.wma(close, maLength) : ta.ema(close, maLength)

maSlope = ta.roc(myMA, slopeLookback)
priceDist = (math.abs(close - myMA) / myMA) * 100

isGapUp = open > high[1]
isGapDown = open < low[1]

// =========================================================================
// 3. STATE MACHINE REGIME LOGIC
// =========================================================================
var int regime = 0

bullTrigger = (maSlope > flatThresh and close > myMA) or (isGapUp and close > myMA) or (close > myMA and priceDist > flatThresh)
bearTrigger = (maSlope < -flatThresh and close < myMA) or (isGapDown and close < myMA) or (close < myMA and priceDist > flatThresh)
flatTrigger = math.abs(maSlope) <= flatThresh and priceDist <= flatThresh

if bullTrigger
    regime := 1
else if bearTrigger
    regime := -1
else if flatTrigger
    regime := 0

isBullish = (regime == 1)
isBearish = (regime == -1)
isFlat = (regime == 0)

// =========================================================================
// 4. INSTITUTIONAL SMART MONEY CALCULATIONS
// =========================================================================
// FIX 2: Safely handling volume for Spot Indices (like Nifty 50) using nz()
safeVol = nz(volume)
avgVol = ta.sma(safeVol, 20)
isVolSpike = safeVol > (avgVol * volMult)
passVol = useVol ? isVolSpike : true

// Wick Absorption Calculation
bodySize = math.abs(close - open)
safeBody = bodySize == 0 ? syminfo.mintick : bodySize 

lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)

passBullWick = useWick ? (lowerWick >= (safeBody * wickMult)) : true
passBearWick = useWick ? (upperWick >= (safeBody * wickMult)) : true

// =========================================================================
// 5. TOUCH & REVERSE LOGIC (Institutional Refinement)
// =========================================================================
bullBounce = isBullish and (maSlope > flatThresh) and (close[1] > myMA[1]) and (low <= myMA) and (open > myMA) and (close > myMA) and passVol and passBullWick
bearBounce = isBearish and (maSlope < -flatThresh) and (close[1] < myMA[1]) and (high >= myMA) and (open < myMA) and (close < myMA) and passVol and passBearWick

// =========================================================================
// 6. VISUALIZATION & PLOTTING
// =========================================================================
colorBull = color.new(color.lime, 0)
colorBear = color.new(color.red, 0)
colorFlat = color.new(color.gray, 50)

regimeColor = isBullish ? colorBull : isBearish ? colorBear : colorFlat

plot(myMA, title="Slope-Filtered MA", color=regimeColor, linewidth=4)
barcolor(regimeColor, title="Regime Candles")

plotshape(bullBounce, title="Bullish Inst Setup", style=shape.arrowup, location=location.belowbar, color=colorBull, textcolor=colorBull, size=size.small, text="ADD")
plotshape(bearBounce, title="Bearish Inst Setup", style=shape.arrowdown, location=location.abovebar, color=colorBear, textcolor=colorBear, size=size.small, text="ADD")
