//@version=5
indicator("Market Regime Detector", overlay=true)

// KOMBİNASYON
// Pazartesi günleri hariç işlem yapma şartı
zaman_ok = dayofweek != dayofweek.monday

// ADX 25'ten büyükse trend vardır
[_, _, adx] = ta.dmi(14, 14)
trend_ok = adx > 25

// RSI 50'den büyükse momentum pozitiftir
rsi_ok = ta.rsi(close, 14) > 50

// Volatilite (ATR %) 3'ten küçükse stabilite vardır
volatilite_ok = (ta.atr(14) / close) * 100 < 3

// KARAR: Hepsi OKEY ise YEŞİL yak
uygun = zaman_ok and trend_ok and rsi_ok and volatilite_ok

// Renk tanımlama ve arka planı boyama
bgcolor(uygun ? color.new(color.green, 85) : na)
