//@version=6
indicator("Volume Delta with Fibonacci Projection [UAlgo]", overlay = true, max_bars_back = 1000, max_lines_count = 300, max_boxes_count = 450, max_labels_count = 200)

groupStructure = "Structure"
periodInput = input.int(120, "Period", minval = 20, maxval = 1000, group = groupStructure)
minSwingBars = input.int(8, "Min Swing Bars", minval = 2, maxval = 100, group = groupStructure)
projChoice = input.string("0.618", "Projection Level", options = ["0.236", "0.382", "0.500", "0.618", "0.786"], group = groupStructure)
forwardStepBars = input.int(12, "Projection Spacing (bars)", minval = 4, maxval = 120, group = groupStructure)
showTargets = input.bool(true, "Show Target Boxes", group = groupStructure)

groupProfile = "Profile"
rowsInput = input.int(26, "Max Profile Rows", minval = 10, maxval = 60, group = groupProfile)
profileWidthBars = input.int(18, "Profile Width", minval = 4, maxval = 60, group = groupProfile)
deltaWidthBars = input.int(10, "Delta Width", minval = 3, maxval = 30, group = groupProfile)
showPOC = input.bool(true, "Show Fib POC", group = groupProfile)
rowSizeMode = input.string("Auto", "Row Size Mode", options = ["Auto", "Manual"], group = groupProfile)
manualTicksPerRow = input.int(10, "Manual Ticks Per Row", minval = 1, maxval = 100000, group = groupProfile)
atrLenInput = input.int(14, "Auto ATR Length", minval = 1, maxval = 500, group = groupProfile)
useCustomLtf = input.bool(false, "Use Custom Intrabar TF", group = groupProfile)
customLtf = input.timeframe("1", "Custom Intrabar TF", group = groupProfile)

groupStyle = "Style"
bullColor = input.color(color.rgb(0, 191, 165), "Bull Color", group = groupStyle)
bearColor = input.color(color.rgb(239, 83, 80), "Bear Color", group = groupStyle)
fibColor = input.color(color.rgb(148, 163, 184), "Fib Line Color", group = groupStyle)
textColorMuted = input.color(color.rgb(100, 116, 139), "Secondary Text", group = groupStyle)
labelSizeInput = input.string("small", "Label Size", options = ["tiny", "small", "normal"], group = groupStyle)

labelSize = switch labelSizeInput
    "tiny" => size.tiny
    "normal" => size.normal
    => size.small

projBaseRatio = switch projChoice
    "0.236" => 0.236
    "0.382" => 0.382
    "0.500" => 0.500
    "0.618" => 0.618
    => 0.786

type Swing
    int startIndex
    int endIndex
    float startPrice
    float endPrice
    float lowPrice
    float highPrice
    float swingRange
    bool bullish
    int recentOffset
    int olderOffset

method fibPrice(Swing s, float ratio) =>
    s.bullish ? s.highPrice - s.swingRange * ratio : s.lowPrice + s.swingRange * ratio

method bandRatioAt(Swing s, int slot) =>
    float r = 0.0
    if s.bullish
        switch slot
            0 => r := 1.000
            1 => r := 0.786
            2 => r := 0.618
            3 => r := 0.500
            4 => r := 0.382
            5 => r := 0.236
            6 => r := 0.000
    else
        switch slot
            0 => r := 0.000
            1 => r := 0.236
            2 => r := 0.382
            3 => r := 0.500
            4 => r := 0.618
            5 => r := 0.786
            6 => r := 1.000
    r

method bandPriceAt(Swing s, int slot) =>
    s.fibPrice(s.bandRatioAt(slot))

method resetToZero(array<float> a, int size) =>
    a.clear()
    for i = 0 to size - 1
        a.push(0.0)

method addAt(array<float> a, int idx, float value) =>
    a.set(idx, a.get(idx) + value)

method clearLines(array<line> a) =>
    if a.size() > 0
        for i = 0 to a.size() - 1
            line.delete(a.get(i))
    a.clear()

method clearBoxes(array<box> a) =>
    if a.size() > 0
        for i = 0 to a.size() - 1
            box.delete(a.get(i))
    a.clear()

method clearLabels(array<label> a) =>
    if a.size() > 0
        for i = 0 to a.size() - 1
            label.delete(a.get(i))
    a.clear()

ratioText(float ratio) =>
    str.tostring(ratio, "#.###")

deltaText(float value) =>
    value > 0 ? "Δ +" + str.tostring(value, "#.0") + "%" : value < 0 ? "Δ " + str.tostring(value, "#.0") + "%" : "Δ 0.0%"

autoLowerTf() =>
    if timeframe.isseconds
        "1S"
    else if timeframe.isminutes and timeframe.multiplier == 1
        "1S"
    else if timeframe.isintraday
        "1"
    else if timeframe.isdaily
        "5"
    else
        "60"

autoTicksPerRow(int atrLen) =>
    int t = int(math.round((0.2 * ta.atr(atrLen)) / syminfo.mintick))
    math.max(1, t)

findLowestOffset(int fromOff, int toOff) =>
    int result = fromOff
    float best = 1e20
    if fromOff <= toOff
        for off = fromOff to toOff
            if low[off] < best
                best := low[off]
                result := off
    result

findHighestOffset(int fromOff, int toOff) =>
    int result = fromOff
    float best = -1e20
    if fromOff <= toOff
        for off = fromOff to toOff
            if high[off] > best
                best := high[off]
                result := off
    result

locateRowIndex(float lowPrice, float highPrice, float step, int rows, float price) =>
    float clampedPrice = math.max(lowPrice, math.min(highPrice, price))
    int idx = int(math.floor((clampedPrice - lowPrice) / step))
    math.max(0, math.min(rows - 1, idx))

locateBandIndex(Swing s, float price) =>
    float clampedPrice = math.max(s.lowPrice, math.min(s.highPrice, price))
    int idx = 5
    for b = 0 to 5
        float p1 = s.bandPriceAt(b)
        float p2 = s.bandPriceAt(b + 1)
        float bandLow = math.min(p1, p2)
        float bandHigh = math.max(p1, p2)
        bool inside = b == 5 ? (clampedPrice >= bandLow and clampedPrice <= bandHigh) : (clampedPrice >= bandLow and clampedPrice < bandHigh)
        if inside
            idx := b
            break
    idx

barDirFromOffset(int off) =>
    int prevDir = off < bar_index ? (close[off + 1] > open[off + 1] ? 1 : close[off + 1] < open[off + 1] ? -1 : 1) : 1
    int dir = prevDir
    if close[off] > open[off]
        dir := 1
    else if close[off] < open[off]
        dir := -1
    else
        if off < bar_index
            if close[off] > close[off + 1]
                dir := 1
            else if close[off] < close[off + 1]
                dir := -1
            else
                dir := prevDir
        else
            dir := prevDir
    dir

makeSwing(int lookback, int minBars) =>
    int hiOff = -ta.highestbars(high, lookback)
    int loOff = -ta.lowestbars(low, lookback)
    int minSep = math.min(minBars, math.max(1, lookback - 1))

    if hiOff == loOff
        bool candleBull = close[hiOff] >= open[hiOff]
        if candleBull
            int searchFrom = hiOff + minSep
            loOff := searchFrom <= lookback - 1 ? findLowestOffset(searchFrom, lookback - 1) : lookback - 1
        else
            int searchFrom = loOff + minSep
            hiOff := searchFrom <= lookback - 1 ? findHighestOffset(searchFrom, lookback - 1) : lookback - 1

    bool bullish = loOff > hiOff

    if math.abs(loOff - hiOff) < minSep
        if bullish
            int forcedLoFrom = hiOff + minSep
            loOff := forcedLoFrom <= lookback - 1 ? findLowestOffset(forcedLoFrom, lookback - 1) : lookback - 1
        else
            int forcedHiFrom = loOff + minSep
            hiOff := forcedHiFrom <= lookback - 1 ? findHighestOffset(forcedHiFrom, lookback - 1) : lookback - 1

    bullish := loOff > hiOff

    float hi = high[hiOff]
    float lo = low[loOff]

    int startIndex = bullish ? bar_index - loOff : bar_index - hiOff
    int endIndex = bullish ? bar_index - hiOff : bar_index - loOff

    float startPx = bullish ? lo : hi
    float endPx = bullish ? hi : lo

    int recentOff = math.min(hiOff, loOff)
    int olderOff = math.max(hiOff, loOff)

    Swing.new(startIndex, endIndex, startPx, endPx, lo, hi, math.abs(hi - lo), bullish, recentOff, olderOff)

pushLine(array<line> pool, int x1, float y1, int x2, float y2, color c, st, int w) =>
    line ln = line.new(x1 = x1, y1 = y1, x2 = x2, y2 = y2, xloc = xloc.bar_index, extend = extend.none, color = c, style = st, width = w)
    pool.push(ln)

pushLabel(array<label> pool, int x, float y, string txt, color tc, sz) =>
    label lb = label.new(x = x, y = y, text = txt, xloc = xloc.bar_index, style = label.style_none, textcolor = tc, size = sz)
    pool.push(lb)

pushBox(array<box> pool, int left, float top, int right, float bottom, color bg, color br) =>
    box bx = box.new(left = left, top = top, right = right, bottom = bottom, xloc = xloc.bar_index, bgcolor = bg, border_color = br)
    pool.push(bx)

var array<float> fibRatios = array.from(0.000, 0.236, 0.382, 0.500, 0.618, 0.786, 1.000)
var array<string> fibTexts = array.from("0.000", "0.236", "0.382", "0.500", "0.618", "0.786", "1.000")

var array<float> rowBuy = array.new<float>()
var array<float> rowSell = array.new<float>()
var array<float> bandBuy = array.new<float>()
var array<float> bandSell = array.new<float>()

var array<line> linePool = array.new<line>()
var array<box> boxPool = array.new<box>()
var array<label> labelPool = array.new<label>()

string ltf = useCustomLtf ? customLtf : autoLowerTf()
int autoTicksNow = autoTicksPerRow(atrLenInput)
[oLtf, hLtf, lLtf, cLtf, vLtf] = request.security_lower_tf(syminfo.tickerid, ltf, [open, high, low, close, volume])
Swing swing = makeSwing(periodInput, minSwingBars)

if barstate.islast and bar_index >= periodInput - 1
    linePool.clearLines()
    boxPool.clearBoxes()
    labelPool.clearLabels()

    if swing.swingRange > syminfo.mintick
        int ticksPerRow = rowSizeMode == "Auto" ? autoTicksNow : manualTicksPerRow
        float minRowStep = math.max(syminfo.mintick, ticksPerRow * syminfo.mintick)
        float rowStep = math.max(minRowStep, swing.swingRange / rowsInput)
        int rowsEff = math.max(1, int(math.ceil(swing.swingRange / rowStep)))
        rowStep := swing.swingRange / rowsEff

        rowBuy.resetToZero(rowsEff)
        rowSell.resetToZero(rowsEff)
        bandBuy.resetToZero(6)
        bandSell.resetToZero(6)

        bool hasProfileData = false

        for off = swing.recentOffset to swing.olderOffset
            array<float> oArr = oLtf[off]
            array<float> hArr = hLtf[off]
            array<float> lArr = lLtf[off]
            array<float> cArr = cLtf[off]
            array<float> vArr = vLtf[off]

            int n = array.size(oArr)

            if n > 0
                float prevClose = na
                int prevDir = close[off] >= open[off] ? 1 : -1

                for j = 0 to n - 1
                    float io = array.get(oArr, j)
                    float ih = array.get(hArr, j)
                    float il = array.get(lArr, j)
                    float ic = array.get(cArr, j)
                    float iv = math.max(array.get(vArr, j), 0)

                    int dir = prevDir
                    if ic > io
                        dir := 1
                    else if ic < io
                        dir := -1
                    else
                        if not na(prevClose)
                            if ic > prevClose
                                dir := 1
                            else if ic < prevClose
                                dir := -1
                            else
                                dir := prevDir
                        else
                            dir := prevDir

                    float iRange = ih - il
                    float buyV = dir > 0 ? iv : 0.0
                    float sellV = dir < 0 ? iv : 0.0

                    if buyV + sellV > 0
                        hasProfileData := true

                    if iRange <= 0
                        int rowIdx = locateRowIndex(swing.lowPrice, swing.highPrice, rowStep, rowsEff, ic)
                        int bandIdx = locateBandIndex(swing, ic)
                        rowBuy.addAt(rowIdx, buyV)
                        rowSell.addAt(rowIdx, sellV)
                        bandBuy.addAt(bandIdx, buyV)
                        bandSell.addAt(bandIdx, sellV)
                    else
                        for r = 0 to rowsEff - 1
                            float rowLow = swing.lowPrice + rowStep * r
                            float rowHigh = rowLow + rowStep
                            float overlap = math.min(ih, rowHigh) - math.max(il, rowLow)

                            if overlap > 0
                                float frac = overlap / iRange
                                rowBuy.addAt(r, buyV * frac)
                                rowSell.addAt(r, sellV * frac)

                        for b = 0 to 5
                            float p1 = swing.bandPriceAt(b)
                            float p2 = swing.bandPriceAt(b + 1)
                            float bandLow = math.min(p1, p2)
                            float bandHigh = math.max(p1, p2)
                            float bandOverlap = math.min(ih, bandHigh) - math.max(il, bandLow)

                            if bandOverlap > 0
                                float bFrac = bandOverlap / iRange
                                bandBuy.addAt(b, buyV * bFrac)
                                bandSell.addAt(b, sellV * bFrac)

                    prevClose := ic
                    prevDir := dir
            else
                float bo = open[off]
                float bh = high[off]
                float bl = low[off]
                float bc = close[off]
                float bv = math.max(volume[off], 0)
                int dir = barDirFromOffset(off)
                float buyV = dir > 0 ? bv : 0.0
                float sellV = dir < 0 ? bv : 0.0
                float barRange = bh - bl

                if buyV + sellV > 0
                    hasProfileData := true

                if barRange <= 0
                    int rowIdx = locateRowIndex(swing.lowPrice, swing.highPrice, rowStep, rowsEff, bc)
                    int bandIdx = locateBandIndex(swing, bc)
                    rowBuy.addAt(rowIdx, buyV)
                    rowSell.addAt(rowIdx, sellV)
                    bandBuy.addAt(bandIdx, buyV)
                    bandSell.addAt(bandIdx, sellV)
                else
                    for r = 0 to rowsEff - 1
                        float rowLow = swing.lowPrice + rowStep * r
                        float rowHigh = rowLow + rowStep
                        float overlap = math.min(bh, rowHigh) - math.max(bl, rowLow)

                        if overlap > 0
                            float frac = overlap / barRange
                            rowBuy.addAt(r, buyV * frac)
                            rowSell.addAt(r, sellV * frac)

                    for b = 0 to 5
                        float p1 = swing.bandPriceAt(b)
                        float p2 = swing.bandPriceAt(b + 1)
                        float bandLow = math.min(p1, p2)
                        float bandHigh = math.max(p1, p2)
                        float bandOverlap = math.min(bh, bandHigh) - math.max(bl, bandLow)

                        if bandOverlap > 0
                            float bFrac = bandOverlap / barRange
                            bandBuy.addAt(b, buyV * bFrac)
                            bandSell.addAt(b, sellV * bFrac)

        int profileStartX = bar_index + 4
        int deltaStartX = bar_index + 4 + profileWidthBars + 3
        int fibEndX = bar_index + 4 + profileWidthBars + 3 + deltaWidthBars + 10

        pushLine(linePool, swing.startIndex, swing.startPrice, swing.endIndex, swing.endPrice, swing.bullish ? bullColor : bearColor, line.style_solid, 2)

        for i = 0 to fibRatios.size() - 1
            float ratio = fibRatios.get(i)
            float price = swing.fibPrice(ratio)
            bool keyLevel = math.abs(ratio - projBaseRatio) < 0.0001 or ratio == 0.0 or ratio == 1.0
            color lc = keyLevel ? color.new(fibColor, 10) : color.new(fibColor, 68)
            pushLine(linePool, swing.startIndex, price, fibEndX, price, lc, keyLevel ? line.style_dashed : line.style_dotted, 1)
            pushLabel(labelPool, fibEndX + 1, price, fibTexts.get(i), keyLevel ? fibColor : textColorMuted, labelSize)

        if hasProfileData and showPOC
            float pocVol = 0.0
            float pocPrice = na
            for r = 0 to rowsEff - 1
                float totalRow = rowBuy.get(r) + rowSell.get(r)
                if totalRow > pocVol
                    pocVol := totalRow
                    pocPrice := swing.lowPrice + rowStep * (r + 0.5)

            if not na(pocPrice)
                pushLine(linePool, swing.startIndex, pocPrice, fibEndX, pocPrice, color.new(color.yellow, 55), line.style_dashed, 1)
                pushLabel(labelPool, fibEndX + 1, pocPrice, "POC", color.new(color.yellow, 15), labelSize)

        if hasProfileData
            float maxRowTotal = 0.0
            for r = 0 to rowsEff - 1
                maxRowTotal := math.max(maxRowTotal, rowBuy.get(r) + rowSell.get(r))

            if maxRowTotal > 0
                for r = 0 to rowsEff - 1
                    float rowLow = swing.lowPrice + rowStep * r
                    float rowHigh = rowLow + rowStep
                    float buyVol = rowBuy.get(r)
                    float sellVol = rowSell.get(r)
                    float total = buyVol + sellVol

                    if total > 0
                        int totalWidthBars = math.max(1, int(math.round(profileWidthBars * (total / maxRowTotal))))
                        int sellWidthBars = 0
                        int buyWidthBars = 0

                        if totalWidthBars == 1
                            if sellVol > buyVol
                                sellWidthBars := 1
                                buyWidthBars := 0
                            else
                                sellWidthBars := 0
                                buyWidthBars := 1
                        else
                            sellWidthBars := int(math.round(totalWidthBars * (sellVol / total)))
                            sellWidthBars := math.max(0, math.min(totalWidthBars, sellWidthBars))
                            buyWidthBars := totalWidthBars - sellWidthBars

                            if sellVol > 0 and buyVol > 0
                                if sellWidthBars == 0
                                    sellWidthBars := 1
                                    buyWidthBars := totalWidthBars - 1
                                if buyWidthBars == 0
                                    buyWidthBars := 1
                                    sellWidthBars := totalWidthBars - 1

                        if sellWidthBars > 0
                            pushBox(boxPool, profileStartX, rowHigh, profileStartX + sellWidthBars, rowLow, color.new(bearColor, 72), color.new(bearColor, 100))

                        if buyWidthBars > 0
                            int buyLeftX = profileStartX + sellWidthBars
                            int buyRightX = buyLeftX + buyWidthBars
                            pushBox(boxPool, buyLeftX, rowHigh, buyRightX, rowLow, color.new(bullColor, 72), color.new(bullColor, 100))

            float maxBandAbs = 0.0
            bool anyBandVolume = false
            for b = 0 to 5
                float buyV = bandBuy.get(b)
                float sellV = bandSell.get(b)
                float totalV = buyV + sellV
                if totalV > 0
                    anyBandVolume := true
                maxBandAbs := math.max(maxBandAbs, math.abs(buyV - sellV))

            if anyBandVolume
                for b = 0 to 5
                    float bandLow = math.min(swing.bandPriceAt(b), swing.bandPriceAt(b + 1))
                    float bandHigh = math.max(swing.bandPriceAt(b), swing.bandPriceAt(b + 1))
                    float buyV = bandBuy.get(b)
                    float sellV = bandSell.get(b)
                    float totalV = buyV + sellV
                    float deltaV = buyV - sellV
                    float deltaPct = totalV > 0 ? (deltaV / totalV) * 100.0 : 0.0
                    color dColor = math.abs(deltaV) <= 0.0000001 ? fibColor : deltaV > 0 ? bullColor : bearColor

                    if totalV > 0
                        int dWidthBars = maxBandAbs > 0 and math.abs(deltaV) > 0 ? math.max(1, int(math.round(deltaWidthBars * (math.abs(deltaV) / maxBandAbs)))) : 1
                        pushBox(boxPool, deltaStartX, bandHigh, deltaStartX + dWidthBars, bandLow, color.new(dColor, 76), color.new(dColor, 100))

                    pushLabel(labelPool, deltaStartX + deltaWidthBars + 2, (bandLow + bandHigh) * 0.5, deltaText(deltaPct), color.new(dColor, 0), labelSize)

        int cX = bar_index + 10
        int t1X = bar_index + 10 + forwardStepBars
        int t2X = bar_index + 10 + forwardStepBars * 2
        int t3X = bar_index + 10 + forwardStepBars * 3

        float cPrice = swing.fibPrice(projBaseRatio)
        float target1 = swing.bullish ? cPrice + swing.swingRange * 1.000 : cPrice - swing.swingRange * 1.000
        float target2 = swing.bullish ? cPrice + swing.swingRange * 1.272 : cPrice - swing.swingRange * 1.272
        float target3 = swing.bullish ? cPrice + swing.swingRange * 1.618 : cPrice - swing.swingRange * 1.618
        float zoneHalf = math.max(swing.swingRange * 0.015, syminfo.mintick * 8)

        color projColor = swing.bullish ? bullColor : bearColor

        pushLine(linePool, swing.endIndex, swing.endPrice, cX, cPrice, color.new(projColor, 30), line.style_dashed, 2)
        pushLine(linePool, cX, cPrice, t1X, target1, color.new(projColor, 0), line.style_solid, 2)
        pushLine(linePool, t1X, target1, t2X, target2, color.new(projColor, 18), line.style_solid, 2)
        pushLine(linePool, t2X, target2, t3X, target3, color.new(projColor, 35), line.style_solid, 2)

        pushLabel(labelPool, cX, cPrice, "C " + ratioText(projBaseRatio), color.new(projColor, 0), labelSize)
        pushLabel(labelPool, t1X + 1, target1, "100%", color.new(projColor, 0), labelSize)
        pushLabel(labelPool, t2X + 1, target2, "127.2%", color.new(projColor, 0), labelSize)
        pushLabel(labelPool, t3X + 1, target3, "161.8%", color.new(projColor, 0), labelSize)

        if showTargets
            pushBox(boxPool, t1X - 1, target1 + zoneHalf, t1X + 2, target1 - zoneHalf, color.new(projColor, 87), color.new(projColor, 55))
            pushBox(boxPool, t2X - 1, target2 + zoneHalf, t2X + 2, target2 - zoneHalf, color.new(projColor, 89), color.new(projColor, 60))
            pushBox(boxPool, t3X - 1, target3 + zoneHalf, t3X + 2, target3 - zoneHalf, color.new(projColor, 91), color.new(projColor, 68))
