//@version=5
indicator("WO Liquidities with HTF", overlay=true, max_lines_count=500, max_labels_count=500)

// --- User Inputs ---
length       = input.int(15, "Pivot Lookback", minval=1, group="Liquidity Settings")
showDaily    = input.bool(true, "Show Daily Levels (PDH/PDL)", group="Levels Visibility")
showWeekly   = input.bool(true, "Show Weekly Levels (PWH/PWL)", group="Levels Visibility")
showMonthly  = input.bool(false, "Show Monthly Levels (PMH/PML)", group="Levels Visibility")
showWO       = input.bool(false, "Show Weekly Open (WO)", group="Levels Visibility")
showOD       = input.bool(false, "Show Opening Day (OD)", group="Levels Visibility")
showSweep    = input.bool(true, "Show Sweep Markers (×)", group="Design")

// --- Design Palette ---
colorHigh    = input.color(#BB86FC, "Internal High Liquidity", group="Design")
colorLow     = input.color(#03DAC6, "Internal Low Liquidity", group="Design")
colorBroken  = input.color(color.new(#90a4ae, 65), "Broken Level Color", group="Design")

colorDaily   = input.color(color.orange, "Daily Levels (PDH/PDL)", group="Design")
colorWeekly  = input.color(color.red, "Weekly Levels (PWH/PWL)", group="Design")
colorMonthly = input.color(color.green, "Monthly Levels (PMH/PML)", group="Design")
colorWO      = input.color(color.white, "Weekly Open Color", group="Design")
colorOD      = input.color(#00bcd4, "Opening Day Color", group="Design")

// --- 1. Global Variables ---
var line ph_lvl = na, var float ph_val = na, var bool ph_crossed = false
var line pl_lvl = na, var float pl_val = na, var bool pl_crossed = false
n = bar_index

// --- 2. Internal Liquidity Logic (Pivots) ---
ph = ta.pivothigh(length, length)
if ph
    if not ph_crossed and not na(ph_lvl)
        line.set_x2(ph_lvl, n - length)
    ph_val := high[length]
    ph_crossed := false
    ph_lvl := line.new(n - length, ph_val, n, ph_val, color=colorHigh, width=2)
else
    ph_crossed := high > ph_val ? true : ph_crossed
    if not ph_crossed
        line.set_x2(ph_lvl, n + 6)
    else if ph_crossed and not ph_crossed[1]
        line.set_x2(ph_lvl, n)
        line.set_style(ph_lvl, line.style_dotted), line.set_width(ph_lvl, 1), line.set_color(ph_lvl, colorBroken)
        if showSweep
            label.new(n, ph_val, "×", color=#00000000, textcolor=colorHigh, style=label.style_label_center, size=size.large)

pl = ta.pivotlow(length, length)
if pl
    if not pl_crossed and not na(pl_lvl)
        line.set_x2(pl_lvl, n - length)
    pl_val := low[length]
    pl_crossed := false
    pl_lvl := line.new(n - length, pl_val, n, pl_val, color=colorLow, width=2)
else
    pl_crossed := low < pl_val ? true : pl_crossed
    if not pl_crossed
        line.set_x2(pl_lvl, n + 6)
    else if pl_crossed and not pl_crossed[1]
        line.set_x2(pl_lvl, n)
        line.set_style(pl_lvl, line.style_dotted), line.set_width(pl_lvl, 1), line.set_color(pl_lvl, colorBroken)
        if showSweep
            label.new(n, pl_val, "×", color=#00000000, textcolor=colorLow, style=label.style_label_center, size=size.large)

// --- 3. HTF Logic ---
var float d_h_v = na, var float d_l_v = na, var int d_h_t = na, var int d_l_t = na
var float od_val = na, var int od_time = na
[y_h, y_l, curr_d_open] = request.security(syminfo.tickerid, "D", [high[1], low[1], open], lookahead=barmerge.lookahead_on)

if ta.change(time("D"))
    d_h_v := y_h, d_l_v := y_l, d_h_t := na, d_l_t := na
    od_val := curr_d_open
    od_time := time
    for i = 1 to 500
        if na(d_h_t) and high[i] == d_h_v
            d_h_t := time[i]
        if na(d_l_t) and low[i] == d_l_v
            d_l_t := time[i]
        if not na(d_h_t) and not na(d_l_t)
            break

var float w_h_v = na, var float w_l_v = na, var int w_h_t = na, var int w_l_t = na
var float w_open_val = na, var int w_open_time = na
[pw_h, pw_l, curr_w_open] = request.security(syminfo.tickerid, "W", [high[1], low[1], open], lookahead=barmerge.lookahead_on)

if ta.change(time("W"))
    w_h_v := pw_h, w_l_v := pw_l, w_h_t := na, w_l_t := na
    w_open_val := curr_w_open
    w_open_time := time
    for i = 1 to 2500
        if na(w_h_t) and high[i] == w_h_v
            w_h_t := time[i]
        if na(w_l_t) and low[i] == w_l_v
            w_l_t := time[i]
        if not na(w_h_t) and not na(w_l_t)
            break

var float m_h_v = na, var float m_l_v = na, var int m_h_t = na, var int m_l_t = na
[pm_h, pm_l] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead=barmerge.lookahead_on)
if ta.change(time("M"))
    m_h_v := pm_h, m_l_v := pm_l, m_h_t := na, m_l_t := na
    for i = 1 to 5000
        if na(m_h_t) and high[i] == m_h_v
            m_h_t := time[i]
        if na(m_l_t) and low[i] == m_l_v
            m_l_t := time[i]
        if not na(m_h_t) and not na(m_l_t)
            break

// --- 4. Rendering ---
var line pdh_l = na, var line pdl_l = na, var label pdh_lb = na, var label pdl_lb = na
var line pwh_l = na, var line pwl_l = na, var label pwh_lb = na, var label pwl_lb = na
var line pmh_l = na, var line pml_l = na, var label pmh_lb = na, var label pml_lb = na
var line wo_l  = na, var label wo_lb  = na
var line od_l  = na, var label od_lb  = na

if barstate.islast
    line.delete(pdh_l), line.delete(pdl_l), label.delete(pdh_lb), label.delete(pdl_lb)
    line.delete(pwh_l), line.delete(pwl_l), label.delete(pwh_lb), label.delete(pwl_lb)
    line.delete(pmh_l), line.delete(pml_l), label.delete(pmh_lb), label.delete(pml_lb)
    line.delete(wo_l), label.delete(wo_lb)
    line.delete(od_l), label.delete(od_lb)
    
    fut_t = time + (time - time[1]) * 12

    // Daily (Width 1) - PDH Continuous, PDL Dashed
    if showDaily
        if not na(d_h_t)
            pdh_l := line.new(d_h_t, d_h_v, fut_t, d_h_v, xloc=xloc.bar_time, color=colorDaily, style=line.style_solid, width=1)
            pdh_lb := label.new(fut_t, d_h_v, "PDH: " + str.tostring(d_h_v, format.mintick), xloc=xloc.bar_time, textcolor=colorDaily, color=color.new(colorDaily, 90), style=label.style_label_left, size=size.small)
        if not na(d_l_t)
            pdl_l := line.new(d_l_t, d_l_v, fut_t, d_l_v, xloc=xloc.bar_time, color=colorDaily, style=line.style_dashed, width=1)
            pdl_lb := label.new(fut_t, d_l_v, "PDL: " + str.tostring(d_l_v, format.mintick), xloc=xloc.bar_time, textcolor=colorDaily, color=color.new(colorDaily, 90), style=label.style_label_left, size=size.small)

    // Weekly (Width 2) - PWH Continuous, PWL Dashed
    if showWeekly
        if not na(w_h_t)
            pwh_l := line.new(w_h_t, w_h_v, fut_t, w_h_v, xloc=xloc.bar_time, color=colorWeekly, style=line.style_solid, width=2)
            pwh_lb := label.new(fut_t, w_h_v, "PWH: " + str.tostring(w_h_v, format.mintick), xloc=xloc.bar_time, textcolor=colorWeekly, color=color.new(colorWeekly, 90), style=label.style_label_left, size=size.small)
        if not na(w_l_t)
            pwl_l := line.new(w_l_t, w_l_v, fut_t, w_l_v, xloc=xloc.bar_time, color=colorWeekly, style=line.style_dashed, width=2)
            pwl_lb := label.new(fut_t, w_l_v, "PWL: " + str.tostring(w_l_v, format.mintick), xloc=xloc.bar_time, textcolor=colorWeekly, color=color.new(colorWeekly, 90), style=label.style_label_left, size=size.small)

    // Monthly (Width 3) - PMH Continuous, PML Dashed
    if showMonthly
        if not na(m_h_t)
            pmh_l := line.new(m_h_t, m_h_v, fut_t, m_h_v, xloc=xloc.bar_time, color=colorMonthly, style=line.style_solid, width=3)
            pmh_lb := label.new(fut_t, m_h_v, "PMH: " + str.tostring(m_h_v, format.mintick), xloc=xloc.bar_time, textcolor=colorMonthly, color=color.new(colorMonthly, 90), style=label.style_label_left, size=size.small)
        if not na(m_l_t)
            pml_l := line.new(m_l_t, m_l_v, fut_t, m_l_v, xloc=xloc.bar_time, color=colorMonthly, style=line.style_dashed, width=3)
            pml_lb := label.new(fut_t, m_l_v, "PML: " + str.tostring(m_l_v, format.mintick), xloc=xloc.bar_time, textcolor=colorMonthly, color=color.new(colorMonthly, 90), style=label.style_label_left, size=size.small)

    if showWO and not na(w_open_time)
        wo_l  := line.new(w_open_time, w_open_val, fut_t, w_open_val, xloc=xloc.bar_time, color=colorWO, style=line.style_solid, width=1)
        wo_lb := label.new(fut_t, w_open_val, "WO: " + str.tostring(w_open_val, format.mintick), xloc=xloc.bar_time, textcolor=colorWO, color=color.new(colorWO, 90), style=label.style_label_left, size=size.small)

    if showOD and not na(od_time)
        od_l  := line.new(od_time, od_val, fut_t, od_val, xloc=xloc.bar_time, color=colorOD, style=line.style_solid, width=1)
        od_lb := label.new(fut_t, od_val, "OD: " + str.tostring(od_val, format.mintick), xloc=xloc.bar_time, textcolor=colorOD, color=color.new(colorOD, 90), style=label.style_label_left, size=size.small)
