//@version=5
indicator("Multi-Coin RSI Alert System", overlay=false)

// ============================================
// INPUT SETTINGS
// ============================================

// RSI Period
rsi_period = input.int(14, "RSI Period", minval=1)

// Overbought/Oversold Levels
overbought_default = input.int(70, "Default Overbought Level", minval=50, maxval=100)
oversold_default = input.int(30, "Default Oversold Level", minval=0, maxval=50)

// ============================================
// BTC SETTINGS
// ============================================
btc_toggle = input.bool(true, "Enable BTC Alerts", group="BTC")
btc_symbol = input.symbol("BYBIT:BTCUSDT", "BTC Symbol", group="BTC")
btc_overbought = input.int(70, "BTC Overbought Level", minval=50, maxval=100, group="BTC")
btc_oversold = input.int(30, "BTC Oversold Level", minval=0, maxval=50, group="BTC")

// ============================================
// ETH SETTINGS
// ============================================
eth_toggle = input.bool(true, "Enable ETH Alerts", group="ETH")
eth_symbol = input.symbol("BYBIT:ETHUSDT", "ETH Symbol", group="ETH")
eth_overbought = input.int(70, "ETH Overbought Level", minval=50, maxval=100, group="ETH")
eth_oversold = input.int(30, "ETH Oversold Level", minval=0, maxval=50, group="ETH")

// ============================================
// USDC SETTINGS
// ============================================
usdc_toggle = input.bool(true, "Enable USDC Alerts", group="USDC")
usdc_symbol = input.symbol("BYBIT:USDCUSDT", "USDC Symbol", group="USDC")
usdc_overbought = input.int(70, "USDC Overbought Level", minval=50, maxval=100, group="USDC")
usdc_oversold = input.int(30, "USDC Oversold Level", minval=0, maxval=50, group="USDC")

// ============================================
// SOL SETTINGS
// ============================================
sol_toggle = input.bool(true, "Enable SOL Alerts", group="SOL")
sol_symbol = input.symbol("BYBIT:SOLUSDT", "SOL Symbol", group="SOL")
sol_overbought = input.int(70, "SOL Overbought Level", minval=50, maxval=100, group="SOL")
sol_oversold = input.int(30, "SOL Oversold Level", minval=0, maxval=50, group="SOL")

// ============================================
// XRP SETTINGS
// ============================================
xrp_toggle = input.bool(true, "Enable XRP Alerts", group="XRP")
xrp_symbol = input.symbol("BYBIT:XRPUSDT", "XRP Symbol", group="XRP")
xrp_overbought = input.int(70, "XRP Overbought Level", minval=50, maxval=100, group="XRP")
xrp_oversold = input.int(30, "XRP Oversold Level", minval=0, maxval=50, group="XRP")

// ============================================
// AAVE SETTINGS
// ============================================
aave_toggle = input.bool(true, "Enable AAVE Alerts", group="AAVE")
aave_symbol = input.symbol("BYBIT:AAVEUSDT", "AAVE Symbol", group="AAVE")
aave_overbought = input.int(70, "AAVE Overbought Level", minval=50, maxval=100, group="AAVE")
aave_oversold = input.int(30, "AAVE Oversold Level", minval=0, maxval=50, group="AAVE")

// ============================================
// HYPE SETTINGS
// ============================================
hype_toggle = input.bool(true, "Enable HYPE Alerts", group="HYPE")
hype_symbol = input.symbol("BYBIT:HYPEUSDT", "HYPE Symbol", group="HYPE")
hype_overbought = input.int(70, "HYPE Overbought Level", minval=50, maxval=100, group="HYPE")
hype_oversold = input.int(30, "HYPE Oversold Level", minval=0, maxval=50, group="HYPE")

// ============================================
// MNT SETTINGS
// ============================================
mnt_toggle = input.bool(true, "Enable MNT Alerts", group="MNT")
mnt_symbol = input.symbol("BYBIT:MNTUSDT", "MNT Symbol", group="MNT")
mnt_overbought = input.int(70, "MNT Overbought Level", minval=50, maxval=100, group="MNT")
mnt_oversold = input.int(30, "MNT Oversold Level", minval=0, maxval=50, group="MNT")

// ============================================
// STABLE SETTINGS
// ============================================
stable_toggle = input.bool(true, "Enable STABLE Alerts", group="STABLE")
stable_symbol = input.symbol("BYBIT:STABLEUSDT", "STABLE Symbol", group="STABLE")
stable_overbought = input.int(70, "STABLE Overbought Level", minval=50, maxval=100, group="STABLE")
stable_oversold = input.int(30, "STABLE Oversold Level", minval=0, maxval=50, group="STABLE")

// ============================================
// MON SETTINGS
// ============================================
mon_toggle = input.bool(true, "Enable MON Alerts", group="MON")
mon_symbol = input.symbol("BYBIT:MONUSDT", "MON Symbol", group="MON")
mon_overbought = input.int(70, "MON Overbought Level", minval=50, maxval=100, group="MON")
mon_oversold = input.int(30, "MON Oversold Level", minval=0, maxval=50, group="MON")

// ============================================
// RSI CALCULATION FUNCTION
// ============================================
get_rsi(symbol_name) =>
    request.security(symbol_name, timeframe.period, ta.rsi(close, rsi_period))

// ============================================
// CALCULATE RSI FOR ALL COINS
// ============================================
btc_rsi = get_rsi(btc_symbol)
eth_rsi = get_rsi(eth_symbol)
usdc_rsi = get_rsi(usdc_symbol)
sol_rsi = get_rsi(sol_symbol)
xrp_rsi = get_rsi(xrp_symbol)
aave_rsi = get_rsi(aave_symbol)
hype_rsi = get_rsi(hype_symbol)
mnt_rsi = get_rsi(mnt_symbol)
stable_rsi = get_rsi(stable_symbol)
mon_rsi = get_rsi(mon_symbol)

// ============================================
// ALERT CONDITIONS
// ============================================

// BTC Alerts
if btc_toggle and ta.crossover(btc_rsi, btc_overbought)
    alert("BTC RSI crossed above " + str.tostring(btc_overbought) + " (Overbought) - Current RSI: " + str.tostring(btc_rsi, "#.##"), alert.freq_once_per_bar)

if btc_toggle and ta.crossunder(btc_rsi, btc_oversold)
    alert("BTC RSI crossed below " + str.tostring(btc_oversold) + " (Oversold) - Current RSI: " + str.tostring(btc_rsi, "#.##"), alert.freq_once_per_bar)

// ETH Alerts
if eth_toggle and ta.crossover(eth_rsi, eth_overbought)
    alert("ETH RSI crossed above " + str.tostring(eth_overbought) + " (Overbought) - Current RSI: " + str.tostring(eth_rsi, "#.##"), alert.freq_once_per_bar)

if eth_toggle and ta.crossunder(eth_rsi, eth_oversold)
    alert("ETH RSI crossed below " + str.tostring(eth_oversold) + " (Oversold) - Current RSI: " + str.tostring(eth_rsi, "#.##"), alert.freq_once_per_bar)

// USDC Alerts
if usdc_toggle and ta.crossover(usdc_rsi, usdc_overbought)
    alert("USDC RSI crossed above " + str.tostring(usdc_overbought) + " (Overbought) - Current RSI: " + str.tostring(usdc_rsi, "#.##"), alert.freq_once_per_bar)

if usdc_toggle and ta.crossunder(usdc_rsi, usdc_oversold)
    alert("USDC RSI crossed below " + str.tostring(usdc_oversold) + " (Oversold) - Current RSI: " + str.tostring(usdc_rsi, "#.##"), alert.freq_once_per_bar)

// SOL Alerts
if sol_toggle and ta.crossover(sol_rsi, sol_overbought)
    alert("SOL RSI crossed above " + str.tostring(sol_overbought) + " (Overbought) - Current RSI: " + str.tostring(sol_rsi, "#.##"), alert.freq_once_per_bar)

if sol_toggle and ta.crossunder(sol_rsi, sol_oversold)
    alert("SOL RSI crossed below " + str.tostring(sol_oversold) + " (Oversold) - Current RSI: " + str.tostring(sol_rsi, "#.##"), alert.freq_once_per_bar)

// XRP Alerts
if xrp_toggle and ta.crossover(xrp_rsi, xrp_overbought)
    alert("XRP RSI crossed above " + str.tostring(xrp_overbought) + " (Overbought) - Current RSI: " + str.tostring(xrp_rsi, "#.##"), alert.freq_once_per_bar)

if xrp_toggle and ta.crossunder(xrp_rsi, xrp_oversold)
    alert("XRP RSI crossed below " + str.tostring(xrp_oversold) + " (Oversold) - Current RSI: " + str.tostring(xrp_rsi, "#.##"), alert.freq_once_per_bar)

// AAVE Alerts
if aave_toggle and ta.crossover(aave_rsi, aave_overbought)
    alert("AAVE RSI crossed above " + str.tostring(aave_overbought) + " (Overbought) - Current RSI: " + str.tostring(aave_rsi, "#.##"), alert.freq_once_per_bar)

if aave_toggle and ta.crossunder(aave_rsi, aave_oversold)
    alert("AAVE RSI crossed below " + str.tostring(aave_oversold) + " (Oversold) - Current RSI: " + str.tostring(aave_rsi, "#.##"), alert.freq_once_per_bar)

// HYPE Alerts
if hype_toggle and ta.crossover(hype_rsi, hype_overbought)
    alert("HYPE RSI crossed above " + str.tostring(hype_overbought) + " (Overbought) - Current RSI: " + str.tostring(hype_rsi, "#.##"), alert.freq_once_per_bar)

if hype_toggle and ta.crossunder(hype_rsi, hype_oversold)
    alert("HYPE RSI crossed below " + str.tostring(hype_oversold) + " (Oversold) - Current RSI: " + str.tostring(hype_rsi, "#.##"), alert.freq_once_per_bar)

// MNT Alerts
if mnt_toggle and ta.crossover(mnt_rsi, mnt_overbought)
    alert("MNT RSI crossed above " + str.tostring(mnt_overbought) + " (Overbought) - Current RSI: " + str.tostring(mnt_rsi, "#.##"), alert.freq_once_per_bar)

if mnt_toggle and ta.crossunder(mnt_rsi, mnt_oversold)
    alert("MNT RSI crossed below " + str.tostring(mnt_oversold) + " (Oversold) - Current RSI: " + str.tostring(mnt_rsi, "#.##"), alert.freq_once_per_bar)

// STABLE Alerts
if stable_toggle and ta.crossover(stable_rsi, stable_overbought)
    alert("STABLE RSI crossed above " + str.tostring(stable_overbought) + " (Overbought) - Current RSI: " + str.tostring(stable_rsi, "#.##"), alert.freq_once_per_bar)

if stable_toggle and ta.crossunder(stable_rsi, stable_oversold)
    alert("STABLE RSI crossed below " + str.tostring(stable_oversold) + " (Oversold) - Current RSI: " + str.tostring(stable_rsi, "#.##"), alert.freq_once_per_bar)

// MON Alerts
if mon_toggle and ta.crossover(mon_rsi, mon_overbought)
    alert("MON RSI crossed above " + str.tostring(mon_overbought) + " (Overbought) - Current RSI: " + str.tostring(mon_rsi, "#.##"), alert.freq_once_per_bar)

if mon_toggle and ta.crossunder(mon_rsi, mon_oversold)
    alert("MON RSI crossed below " + str.tostring(mon_oversold) + " (Oversold) - Current RSI: " + str.tostring(mon_rsi, "#.##"), alert.freq_once_per_bar)

// ============================================
// PLOTTING
// ============================================

// Plot RSI lines for all coins
plot(btc_rsi, title="BTC RSI", color=color.rgb(255, 152, 0), linewidth=2)
plot(eth_rsi, title="ETH RSI", color=color.rgb(98, 0, 234), linewidth=2)
plot(usdc_rsi, title="USDC RSI", color=color.rgb(39, 117, 201), linewidth=1)
plot(sol_rsi, title="SOL RSI", color=color.rgb(220, 31, 255), linewidth=2)
plot(xrp_rsi, title="XRP RSI", color=color.rgb(35, 173, 229), linewidth=2)
plot(aave_rsi, title="AAVE RSI", color=color.rgb(184, 61, 186), linewidth=2)
plot(hype_rsi, title="HYPE RSI", color=color.rgb(255, 0, 127), linewidth=2)
plot(mnt_rsi, title="MNT RSI", color=color.rgb(0, 217, 126), linewidth=2)
plot(stable_rsi, title="STABLE RSI", color=color.gray, linewidth=1)
plot(mon_rsi, title="MON RSI", color=color.rgb(255, 215, 0), linewidth=2)

// Plot reference lines
hline(overbought_default, "Overbought", color=color.red, linestyle=hline.style_dashed)
hline(oversold_default, "Oversold", color=color.green, linestyle=hline.style_dashed)
hline(50, "Midline", color=color.gray, linestyle=hline.style_dotted)

// ============================================
// TABLE DISPLAY
// ============================================

var table rsi_table = table.new(position.top_right, 3, 11, bgcolor=color.new(color.black, 85), border_width=1, force_overlay = true)

if barstate.islast
    // Headers
    table.cell(rsi_table, 0, 0, "Coin", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 1, 0, "RSI", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 2, 0, "Status", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    
    // BTC
    table.cell(rsi_table, 0, 1, "BTC", text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 1, 1, str.tostring(btc_rsi, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 2, 1, btc_rsi > btc_overbought ? "🔴 OB" : btc_rsi < btc_oversold ? "🟢 OS" : "⚪ N", 
               text_color=btc_rsi > btc_overbought ? color.red : btc_rsi < btc_oversold ? color.lime : color.white, text_size=size.small)
    
    // ETH
    table.cell(rsi_table, 0, 2, "ETH", text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 1, 2, str.tostring(eth_rsi, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 2, 2, eth_rsi > eth_overbought ? "🔴 OB" : eth_rsi < eth_oversold ? "🟢 OS" : "⚪ N", 
               text_color=eth_rsi > eth_overbought ? color.red : eth_rsi < eth_oversold ? color.lime : color.white, text_size=size.small)
    
    // USDC
    table.cell(rsi_table, 0, 3, "USDC", text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 1, 3, str.tostring(usdc_rsi, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 2, 3, usdc_rsi > usdc_overbought ? "🔴 OB" : usdc_rsi < usdc_oversold ? "🟢 OS" : "⚪ N", 
               text_color=usdc_rsi > usdc_overbought ? color.red : usdc_rsi < usdc_oversold ? color.lime : color.white, text_size=size.small)
    
    // SOL
    table.cell(rsi_table, 0, 4, "SOL", text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 1, 4, str.tostring(sol_rsi, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 2, 4, sol_rsi > sol_overbought ? "🔴 OB" : sol_rsi < sol_oversold ? "🟢 OS" : "⚪ N", 
               text_color=sol_rsi > sol_overbought ? color.red : sol_rsi < sol_oversold ? color.lime : color.white, text_size=size.small)
    
    // XRP
    table.cell(rsi_table, 0, 5, "XRP", text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 1, 5, str.tostring(xrp_rsi, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 2, 5, xrp_rsi > xrp_overbought ? "🔴 OB" : xrp_rsi < xrp_oversold ? "🟢 OS" : "⚪ N", 
               text_color=xrp_rsi > xrp_overbought ? color.red : xrp_rsi < xrp_oversold ? color.lime : color.white, text_size=size.small)
    
    // AAVE
    table.cell(rsi_table, 0, 6, "AAVE", text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 1, 6, str.tostring(aave_rsi, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 2, 6, aave_rsi > aave_overbought ? "🔴 OB" : aave_rsi < aave_oversold ? "🟢 OS" : "⚪ N", 
               text_color=aave_rsi > aave_overbought ? color.red : aave_rsi < aave_oversold ? color.lime : color.white, text_size=size.small)
    
    // HYPE
    table.cell(rsi_table, 0, 7, "HYPE", text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 1, 7, str.tostring(hype_rsi, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 2, 7, hype_rsi > hype_overbought ? "🔴 OB" : hype_rsi < hype_oversold ? "🟢 OS" : "⚪ N", 
               text_color=hype_rsi > hype_overbought ? color.red : hype_rsi < hype_oversold ? color.lime : color.white, text_size=size.small)
    
    // MNT
    table.cell(rsi_table, 0, 8, "MNT", text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 1, 8, str.tostring(mnt_rsi, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 2, 8, mnt_rsi > mnt_overbought ? "🔴 OB" : mnt_rsi < mnt_oversold ? "🟢 OS" : "⚪ N", 
               text_color=mnt_rsi > mnt_overbought ? color.red : mnt_rsi < mnt_oversold ? color.lime : color.white, text_size=size.small)
    
    // STABLE
    table.cell(rsi_table, 0, 9, "STABLE", text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 1, 9, str.tostring(stable_rsi, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 2, 9, stable_rsi > stable_overbought ? "🔴 OB" : stable_rsi < stable_oversold ? "🟢 OS" : "⚪ N", 
               text_color=stable_rsi > stable_overbought ? color.red : stable_rsi < stable_oversold ? color.lime : color.white, text_size=size.small)
    
    // MON
    table.cell(rsi_table, 0, 10, "MON", text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 1, 10, str.tostring(mon_rsi, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(rsi_table, 2, 10, mon_rsi > mon_overbought ? "🔴 OB" : mon_rsi < mon_oversold ? "🟢 OS" : "⚪ N", 
               text_color=mon_rsi > mon_overbought ? color.red : mon_rsi < mon_oversold ? color.lime : color.white, text_size=size.small)
