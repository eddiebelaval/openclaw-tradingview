//@version=5
indicator(" GH-alerts Tops/Bottoms", shorttitle="Tops/Bottoms", overlay=true)

length = input.int(3, title="Length")

ValC = ta.sma(hl2, length)

bull = input.float(-0.51, title="Bullish")
bear = input.float(0.43, title="Bearish")

vol = ta.sma(ta.atr(length), length)

cvi = (close - ValC) / (vol * math.sqrt(length))

plot(bull, color=color.green)
plot(bear, color=color.red)

// Conditions (UNCHANGED LOGIC)
bull1 = cvi <= bull
bear1 = cvi >= bear

bull2 = bull1[1] and not bull1
bear2 = bear1[1] and not bear1

plotchar(bull2, char="*", location=location.belowbar, color=color.lime, size=size.normal)
plotchar(bear2, char="*", location=location.abovebar, color=color.red, size=size.normal)

// Alerts
alertcondition(bull2, title="Bullish Star", message="Bullish * appeared")
alertcondition(bear2, title="Bearish Star", message="Bearish * appeared")
alertcondition(bull2 or bear2, title="Star Appeared", message="A * appeared on the chart")
