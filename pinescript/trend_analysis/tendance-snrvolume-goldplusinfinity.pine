//@version=6
indicator("GoldPlusInfinity_Ultimate_I1", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// 🔹 OPTIMISATION 🔹
max_bars_back(close, 5000)
max_bars_back(volume, 5000)

// ==========================================
// --- PARAMÈTRES GÉNÉRAUX & MA ---
// ==========================================
group_ma = "MOYENNE MOBILE"
show_ma = input.bool(true, "💥 Activer MA 20 💥", group = group_ma)
maLen = 20
ma = ta.sma(close, maLen)
plot(show_ma ? ma : na, color=color.new(#3b82f6, 60), title="MA20 Trend", linewidth=2)

show_ma50 = input.bool(true, "💥 Activer MA 50 💥", group = group_ma)
maLen50 = 50
ma50 = ta.sma(close, maLen50)
plot(show_ma50 ? ma50 : na, color=color.new(#f6643b, 60), title="MA50 Trend", linewidth=2)


// ==========================================
// --- VOLUME PROFILE (FIXE / HISTORIQUE) ---
// ==========================================
group_fvp = "VOLUME PROFILE (HISTORIQUE)"
show_fvp = input.bool(true, "💥 Activer le VP Historique 💥", group = group_fvp)
_daysBack = input.int(7, "Période du Profil (Jours)", minval = 1, group = group_fvp)
_offset = input.int(40, "Décalage à droite (Offset)", minval = 0, group = group_fvp)
_tf_fvp = input.timeframe("5", "Timeframe (UT inférieure)", group = group_fvp)
_levels_fvp = input.int(68, "Niveaux (Lignes)", group = group_fvp)
_va_perc_fvp = input.int(68, "Pourcentage Value Area %", group = group_fvp)

group_nodes = "VP - HVN & LVN Nodes"
_nodeCount = input.int(3, "Nombre de Nodes (Chaque)", minval = 1, maxval = 10, group = group_nodes)
_hvnColor = input.color(color.new(#3b82f6, 80), "HVN (Pics)", inline = "hvn", group = group_nodes)
_lvnColor = input.color(color.new(#ef4444, 80), "LVN (Creux)", inline = "lvn", group = group_nodes)
_showNodeLines = input.bool(true, "Lignes de prix Nodes", group = group_nodes)

group_style_fvp = "VP - Style Général"
_histogramBoxColor = input.color(color.new(#ffffff, 96), "Fond Histogramme", group = group_style_fvp)
_upColor = input.color(color.new(#475569, 75), "Haut (Standard)", inline = "up", group = group_style_fvp)
_upVAColor = input.color(color.new(#3b82f6, 40), "Haut (Value Area)", inline = "up", group = group_style_fvp)
_downColor = input.color(color.new(#64748b, 75), "Bas (Standard)", inline = "down", group = group_style_fvp)
_downVAColor = input.color(color.new(#94a3b8, 40), "Bas (Value Area)", inline = "down", group = group_style_fvp)
_pocColor_fvp = input.color(#f59e0b, "Couleur POC", group = group_style_fvp)
_vahColor_fvp = input.color(#60a5fa, "Couleur VAH/VAL", group = group_style_fvp)

// ==========================================
// --- VOLUME PROFILE (PAR SESSION) ---
// ==========================================
group_vps = "VOLUME PROFILE (SESSIONS)"
show_vps = input.bool(true, "💥 Activer VP par Session 💥", group = group_vps)
_levels_vps = input.int(30, "Précision Session", minval=10, maxval=100, group=group_vps)
_va_perc_vps = input.int(70, "Value Area Session (%)", minval=10, maxval=100, group=group_vps)
_vp_width_vps = input.int(50, "Largeur Max (Bars)", group=group_vps)
_tf_vps = input.timeframe("1", "TF Calcul Volume Session", group=group_vps)

// ==========================================
// --- BIG TRADES (WHALE LOGIC) ---
// ==========================================
group_bt = "Big Trades"
show_bt = input.bool(true, "💥 Activer Big Trades 💥", group=group_bt)
asset_type = input.string("Automatique", "Profil d'Analyse", options=["Automatique", "Personnalisé"], group=group_bt)
trend_filter = input.bool(true, "Filtrer par Tendance (MA20)", group=group_bt)
custom_bt_mult = input.float(2.0, "Sensibilité Sigma", group="Whale Custom")
custom_lookback = input.int(250, "Lookback", group="Whale Custom")

// ==========================================
// --- SESSIONS ICT & KILLZONES ---
// ==========================================
group_kz = "Sessions & Killzones"
sess_tz = input.string("America/New_York", "Time Zone", group=group_kz)
showSessions = input.bool(true, "💥 Afficher Boxes Sessions 💥", group=group_kz)
i_pips = input.bool(true, "Infos Pips/Pts", group=group_kz)
i_kzmid = input.bool(true, "Médiane de Session", group=group_kz)
i_transp_box = input.int(85, "Transparence Box", 0, 100, group=group_kz)

cbdr_sess = input.session('1400-2000', "CBDR", inline='s1', group=group_kz)
asia_sess = input.session('2000-0000', "Asie", inline='s2', group=group_kz)
lon_sess  = input.session('0200-0500', "Londres", inline='s3', group=group_kz)
ny_sess   = input.session('0700-1000', "New York", inline='s4', group=group_kz)
lc_sess   = input.session('1000-1200', "London Close", inline='s5', group=group_kz)

c_cbdr = input.color(color.new(#0064ff, 0), "", inline='s1', group=group_kz)
c_asia = input.color(color.new(#7622ff, 0), "", inline='s2', group=group_kz)
c_lon  = input.color(color.new(#e90000, 0), "", inline='s3', group=group_kz)
c_ny   = input.color(color.new(#00acb8, 0), "", inline='s4', group=group_kz)
c_lc   = input.color(color.new(#434651, 0), "", inline='s5', group=group_kz)

// ==========================================
// --- TYPES DE DONNÉES & CLASSES ---
// ==========================================
type BarData
    float h
    float l
    float v
    bool  isUp

type Slot
    float Low
    float High
    float BullVolume = 0.0
    float BearVolume = 0.0

type NodeInfo
    int idx
    float vol

type HistoriqueDatas
    array<BarData> Datas

type PointOfControl
    float Price
    float Volume = 0.0
    int Index = 0

type ValueArea
    float High = 0.0
    float Low = 0.0

type MetaData
    float Low = 2147483647.0
    float High = -1.0
    float SlotWidth = 0.0
    PointOfControl POC
    ValueArea VA
    int Start = 0
    int End = 0

type VolumeProfileHistorique
    map<int, HistoriqueDatas> DatasMap
    array<Slot> Slots
    MetaData MetaData

// ==========================================
// --- FONCTIONS ET MÉTHODES ---
// ==========================================
in_session(sess) => not na(time(timeframe.period, sess, sess_tz))

pip_calc(x) => 
    res = syminfo.type == "forex" ? x / (syminfo.mintick * 10) : x / syminfo.mintick
    math.round(res, 1)

// --- LOGIQUE BIG TRADES ---
var float final_bt_mult = 3.0
var int final_lookback = 500

if asset_type == "Automatique"
    is_btc = str.contains(syminfo.ticker, "BTC")
    is_gold = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")
    is_index = str.contains(syminfo.ticker, "US30") or str.contains(syminfo.ticker, "NAS100")
    if is_index
        final_bt_mult := 3.5
        final_lookback := 100
    else if is_btc
        final_bt_mult := 3.2
        final_lookback := 80
    else if is_gold
        final_bt_mult := 2.0
        final_lookback := 250
else
    final_bt_mult := custom_bt_mult
    final_lookback := custom_lookback

range_size = high - low
raw_buy_vol = range_size == 0 ? 0 : (close - low) / range_size * volume
raw_sell_vol = range_size == 0 ? 0 : (high - close) / range_size * volume
avg_buy_vol = ta.sma(raw_buy_vol, final_lookback)[1]
std_buy_vol = ta.stdev(raw_buy_vol, final_lookback)[1]
avg_sell_vol = ta.sma(raw_sell_vol, final_lookback)[1]
std_sell_vol = ta.stdev(raw_sell_vol, final_lookback)[1]

thresh_buy = avg_buy_vol + std_buy_vol * final_bt_mult
thresh_sell = avg_sell_vol + std_sell_vol * final_bt_mult
is_bt_buy = raw_buy_vol > thresh_buy and (not trend_filter or close > ma)
is_bt_sell = raw_sell_vol > thresh_sell and (not trend_filter or close < ma)

plotshape(show_bt and is_bt_buy ? math.avg(close, low) : na, "Whale Buy", shape.circle, location.absolute, color.new(color.lime, 20), size=size.small)
plotshape(show_bt and is_bt_sell ? math.avg(close, high) : na, "Whale Sell", shape.circle, location.absolute, color.new(color.red, 20), size=size.small)

// --- LOGIQUE SESSIONS BOXES ---
ictbox(sess_str, bdcol, txt_label) =>
    var float kzlow = na
    var float kzhigh = na
    var int kzstart = na
    var box currentBox = na
    var label currentLabel = na
    var line midLine = na

    inSess = in_session(sess_str)
    newSess = inSess and not inSess[1]

    if newSess
        kzlow := low
        kzhigh := high
        kzstart := time
        currentBox := box.new(kzstart, kzhigh, time, kzlow, border_color=bdcol, bgcolor=color.new(bdcol, i_transp_box), xloc=xloc.bar_time)
        if i_pips
            currentLabel := label.new(kzstart, kzhigh, txt_label, xloc=xloc.bar_time, yloc=yloc.price, textcolor=color.white, style=label.style_label_down, size=size.small, color=bdcol)
        if i_kzmid
            midLine := line.new(kzstart, math.avg(kzhigh, kzlow), time, math.avg(kzhigh, kzlow), xloc=xloc.bar_time, color=bdcol, style=line.style_dashed)

    if inSess and not na(currentBox)
        kzlow := math.min(low, kzlow)
        kzhigh := math.max(high, kzhigh)
        box.set_top(currentBox, kzhigh)
        box.set_bottom(currentBox, kzlow)
        box.set_right(currentBox, time)
        
        if not na(currentLabel)
            diff = kzhigh - kzlow
            pips = pip_calc(diff)
            label.set_xy(currentLabel, math.round(math.avg(kzstart, time)), kzhigh)
            label.set_text(currentLabel, txt_label + "\n" + str.tostring(pips) + (syminfo.type == "forex" ? " pips" : " pts"))
        
        if not na(midLine)
            line.set_xy1(midLine, kzstart, math.avg(kzhigh, kzlow))
            line.set_xy2(midLine, time, math.avg(kzhigh, kzlow))

if showSessions and timeframe.isintraday
    ictbox(cbdr_sess, c_cbdr, "CBDR")
    ictbox(asia_sess, c_asia, "ASIA")
    ictbox(lon_sess, c_lon, "LONDON")
    ictbox(ny_sess, c_ny, "NY")
    ictbox(lc_sess, c_lc, "LC")

// ==========================================
// --- LOGIQUE VOLUME PROFILE SESSIONS ---
// ==========================================
get_ltf_data() => BarData.new(high, low, volume, close >= open)
ltf_array_vps = request.security_lower_tf(syminfo.tickerid, _tf_vps, get_ltf_data())

draw_session_vp(sess_str, col, label_name) =>
    var float sHi = na
    var float sLo = na
    var int sStartBar = na
    var BarData[] sessData = array.new<BarData>()
    
    inSess = in_session(sess_str)
    isNew = inSess and not inSess[1]
    isEnd = not inSess and inSess[1]

    if isNew
        sHi := high
        sLo := low
        sStartBar := bar_index
        array.clear(sessData)

    if inSess
        sHi := math.max(high, sHi)
        sLo := math.min(low, sLo)
        if not na(ltf_array_vps)
            for d in ltf_array_vps
                array.push(sessData, d)

    if (isEnd or (barstate.islast and inSess)) and array.size(sessData) > 0
        float step = (sHi - sLo) / _levels_vps
        array<Slot> slots = array.new<Slot>()
        for i = 0 to _levels_vps - 1
            array.push(slots, Slot.new(sLo + i * step, sLo + (i + 1) * step, 0.0, 0.0))
        
        float totalVol = 0.0
        float maxVol = 0.0
        int pocIdx = 0
        
        for d in sessData
            for i = 0 to _levels_vps - 1
                s = array.get(slots, i)
                intersect = math.max(0, math.min(d.h, s.High) - math.max(d.l, s.Low))
                if intersect > 0
                    share = intersect / (d.h - d.l == 0 ? 1 : d.h - d.l)
                    v = d.v * share
                    s.BullVolume += v
                    totalVol += v
                    if s.BullVolume > maxVol
                        maxVol := s.BullVolume
                        pocIdx := i
        
        float vaTarget = totalVol * (_va_perc_vps / 100.0)
        float vaVol = array.get(slots, pocIdx).BullVolume
        int upIdx = pocIdx
        int downIdx = pocIdx
        for i = 0 to _levels_vps
            if vaVol >= vaTarget or (upIdx >= _levels_vps - 1 and downIdx <= 0)
                break
            vUp = upIdx < _levels_vps - 1 ? array.get(slots, upIdx + 1).BullVolume : 0
            vDown = downIdx > 0 ? array.get(slots, downIdx - 1).BullVolume : 0
            if vUp >= vDown and upIdx < _levels_vps - 1
                upIdx += 1
                vaVol += vUp
            else if downIdx > 0
                downIdx -= 1
                vaVol += vDown

        float vaHigh = array.get(slots, upIdx).High
        float vaLow = array.get(slots, downIdx).Low
        float pocPrice = array.get(slots, pocIdx).Low + step/2

        // Couleur de séparation blanche pour les sessions
        color sepColor_vps = color.new(color.white, 70)

        for i = 0 to _levels_vps - 1
            s = array.get(slots, i)
            if s.BullVolume > 0
                w = int((s.BullVolume / (maxVol == 0 ? 1 : maxVol)) * _vp_width_vps)
                isVA = s.Low >= vaLow and s.High <= vaHigh
                box.new(sStartBar, s.High, sStartBar + w, s.Low, bgcolor=isVA ? color.new(col, 40) : color.new(col, 80), border_width=1, border_color=sepColor_vps)
        
        line.new(sStartBar, pocPrice, bar_index, pocPrice, color=color.new(col, 0), width=2)

if show_vps and timeframe.isintraday
    draw_session_vp(asia_sess, c_asia, "ASIA")
    draw_session_vp(lon_sess, c_lon, "LON")
    draw_session_vp(ny_sess, c_ny, "NY")

// ==========================================
// --- LOGIQUE VOLUME PROFILE HISTORIQUE ---
// ==========================================
method SlotVolumes(BarData data, Slot slot) =>
    share = 0.
    barSize = data.h - data.l
    if barSize > 0
        filled = math.min(data.h, slot.High) - math.max(data.l, slot.Low)
        if filled > 0
            share := filled / barSize
    [data.v * (data.isUp ? 1 : 0) * share, data.v * (data.isUp ? 0 : 1) * share]

method CreateSlots(VolumeProfileHistorique profile) =>
    size = (profile.MetaData.High - profile.MetaData.Low) / _levels_fvp
    for i = 0 to _levels_fvp - 1
        profile.Slots.push(Slot.new(profile.MetaData.Low + (size * i), profile.MetaData.Low + (size * (i + 1)), 0, 0))

method FillSlots(VolumeProfileHistorique profile) =>
    for key in profile.DatasMap.keys()
        value = profile.DatasMap.get(key)
        for data in value.Datas
            for slot in profile.Slots
                [bull, bear] = SlotVolumes(data, slot)
                slot.BullVolume += bull
                slot.BearVolume += bear

method SetValueArea(VolumeProfileHistorique profile, float totalVolume) =>
    up = profile.MetaData.POC.Index
    down = profile.MetaData.POC.Index
    vaVol = profile.MetaData.POC.Volume
    target = totalVolume * (_va_perc_fvp / 100.)
    for i = 0 to _levels_fvp
        if (up >= _levels_fvp - 1 and down <= 0) or vaVol >= target
            break
        uV = up < _levels_fvp - 1 ? (profile.Slots.get(up+1).BullVolume + profile.Slots.get(up+1).BearVolume) : 0
        dV = down > 0 ? (profile.Slots.get(down-1).BullVolume + profile.Slots.get(down-1).BearVolume) : 0
        if uV >= dV and up < _levels_fvp - 1
            vaVol += uV
            up += 1
        else if down > 0
            vaVol += dV
            down -= 1
    profile.MetaData.VA.High := profile.MetaData.Low + (profile.MetaData.SlotWidth * (up + 1))
    profile.MetaData.VA.Low := profile.MetaData.Low + (profile.MetaData.SlotWidth * down)

// Exécution VP Historique
timeThreshold = timenow - (_daysBack * 86400000)
active_fvp = time >= timeThreshold
datas_fvp = request.security_lower_tf(syminfo.tickerid, _tf_fvp, get_ltf_data())
var profile_h = VolumeProfileHistorique.new(map.new<int, HistoriqueDatas>(), array.new<Slot>(), MetaData.new(POC=PointOfControl.new(0, 0), VA=ValueArea.new()))

if active_fvp and show_fvp
    if not na(datas_fvp) and datas_fvp.size() > 0
        profile_h.DatasMap.put(bar_index, HistoriqueDatas.new(datas_fvp))
    if not active_fvp[1]
        profile_h.MetaData.Start := bar_index

if barstate.islast and profile_h.DatasMap.size() > 0 and show_fvp
    for key in profile_h.DatasMap.keys()
        val = profile_h.DatasMap.get(key)
        for d in val.Datas
            profile_h.MetaData.High := math.max(d.h, profile_h.MetaData.High)
            profile_h.MetaData.Low := math.min(d.l, profile_h.MetaData.Low)
    
    profile_h.MetaData.SlotWidth := (profile_h.MetaData.High - profile_h.MetaData.Low) / _levels_fvp
    profile_h.CreateSlots()
    profile_h.FillSlots()
    
    float totalV = 0.
    for [i, s] in profile_h.Slots
        vol = s.BullVolume + s.BearVolume
        totalV += vol
        if vol > profile_h.MetaData.POC.Volume
            profile_h.MetaData.POC.Volume := vol
            profile_h.MetaData.POC.Price := s.Low
            profile_h.MetaData.POC.Index := i
    
    profile_h.MetaData.End := bar_index
    profile_h.SetValueArea(totalV)
    
    rEnd = bar_index + _offset
    // Couleur pour la ligne de séparation (blanc discret mais net)
    _sepColor = color.new(#9a9a9a, 75)
    
    for s in profile_h.Slots
        tV = s.BullVolume + s.BearVolume
        if tV > 0
            vS = tV / (profile_h.MetaData.POC.Volume == 0 ? 1 : profile_h.MetaData.POC.Volume)
            beS = nz((s.BearVolume / tV) * vS)
            bS = nz((s.BullVolume / tV) * vS)
            
            // Calculer la position relative des barres pour un effet d'histogramme détaillé
            rStBear = rEnd - math.round(beS * _offset)
            rStBull = rStBear - math.round(bS * _offset)
            
            isVA = s.Low >= profile_h.MetaData.VA.Low and s.Low < profile_h.MetaData.VA.High
            
            // Dessin des barres détaillées avec bordure blanche fine pour séparation (Histogramme Historique)
            box.new(int(rStBear), s.High, rEnd, s.Low, bgcolor = isVA ? _downVAColor : _downColor, border_width = 1, border_color = _sepColor)
            box.new(int(rStBull), s.High, int(rStBear), s.Low, bgcolor = isVA ? _upVAColor : _upColor, border_width = 1, border_color = _sepColor)
    
    box.new(bar_index, profile_h.MetaData.High, rEnd, profile_h.MetaData.Low, border_width = 0, bgcolor = _histogramBoxColor)
    line.new(profile_h.MetaData.Start, profile_h.MetaData.POC.Price + profile_h.MetaData.SlotWidth/4, rEnd, profile_h.MetaData.POC.Price + profile_h.MetaData.SlotWidth/4, color = _pocColor_fvp, width = 4)

    allN = array.new<NodeInfo>()
    for i = 0 to profile_h.Slots.size() - 1
        allN.push(NodeInfo.new(i, profile_h.Slots.get(i).BullVolume + profile_h.Slots.get(i).BearVolume))
    
    if allN.size() > 1
        for i = 0 to allN.size() - 2
            for j = 0 to allN.size() - i - 2
                if allN.get(j).vol > allN.get(j+1).vol
                    temp = allN.get(j)
                    allN.set(j, allN.get(j+1))
                    allN.set(j+1, temp)
    
    for i = 0 to _nodeCount - 1
        if i < allN.size()
            hNode = allN.get(allN.size() - 1 - i)
            lNode = allN.get(i)
            sH = profile_h.Slots.get(hNode.idx)
            sL = profile_h.Slots.get(lNode.idx)
            box.new(profile_h.MetaData.Start, sH.High, rEnd, sH.Low, bgcolor=_hvnColor, border_width=1, border_color=_sepColor)
            box.new(profile_h.MetaData.Start, sL.High, rEnd, sL.Low, bgcolor=_lvnColor, border_width=1, border_color=_sepColor)
            if _showNodeLines
                line.new(profile_h.MetaData.Start, math.avg(sH.High, sH.Low), rEnd, math.avg(sH.High, sH.Low), color=_hvnColor)
                line.new(profile_h.MetaData.Start, math.avg(sL.High, sL.Low), rEnd, math.avg(sL.High, sL.Low), color=_lvnColor, style=line.style_dotted)

// ALERTES
alertcondition(is_bt_buy, "Whale Buy Detected", "Achat institutionnel !")
alertcondition(is_bt_sell, "Whale Sell Detected", "Vente institutionnelle !")
