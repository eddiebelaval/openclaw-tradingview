//@version=6
indicator("IU Liquidity Sweep indicator", overlay = true, max_boxes_count = 500)


// ______________________ User Inputs __________________________ \\
// ---------------- Swing Detection & Limits ----------- \\
swing_length              = input.int(20, "Swing Length = "                , group = "======= Indicator Settings ========")
max_active_sweep_bull     = input.int(5, "Maximum Bullish Active Sweeps = ", group = "======= Indicator Settings ========")
max_active_sweep_bear     = input.int(5, "Maximum Bearish Active Sweeps = ", group = "======= Indicator Settings ========")

// ---------------- Zone Visualization Colors ----------- \\
bullish_zone_col          = input.color(color.green , "Bullish Zone Color = "    , group = "========= Color Settings ============" )
bearish_zone_col          = input.color(color.green , "Bearish Zone Color = "    , group = "========= Color Settings ============" )
bull_zone_col             = input.color(color.aqua  , "Bull Zone Candle Color = ", group = "========= Color Settings ============")
bear_zone_col             = input.color(color.orange, "Bear Zone Candle Color = ", group = "========= Color Settings ============")


// ______________________ Pivot Detection __________________________ \\
// ---------------- Swing High & Swing Low Calculation ----------- \\
ph                        = ta.pivothigh(swing_length, swing_length)
pl                        = ta.pivotlow(swing_length, swing_length)


// ______________________ Persistent Variables __________________________ \\
// ---------------- Bullish Liquidity Zone Storage ----------- \\
var float bull_low        = na
var float bull_body       = na

// ---------------- Bearish Liquidity Zone Storage ----------- \\
var float bear_high       = na
var float bear_body       = na

// ---------------- Box Object References ----------- \\
var box bull_box          = na
var box bear_box          = na

// ---------------- Active Zone Arrays ----------- \\
var bull_box_array        = array.new<box>()
var bear_box_array        = array.new<box>()


// ______________________ Bearish Liquidity Creation __________________________ \\
// ---------------- Create Supply Zone From Pivot High ----------- \\
if not na(ph)
    bear_high     := high[swing_length]
    bear_body     := close[swing_length] > open[swing_length] ? close[swing_length] : open[swing_length]
    bear_box      := box.new(bar_index[swing_length], bear_high, bar_index, bear_body, color.red, 1
                         , line.style_dotted, extend = extend.none, bgcolor = color.new(color.red, 90))
    bear_box_array.push(bear_box)
    
    // ---------------- Maintain Maximum Active Bear Zones ----------- \\
    if bear_box_array.size() > max_active_sweep_bear
        bear_box_array.remove(0)


// ______________________ Bullish Liquidity Creation __________________________ \\
// ---------------- Create Demand Zone From Pivot Low ----------- \\
if not na(pl)
    bull_low      := low[swing_length]
    bull_body     := close[swing_length] > open[swing_length] ? open[swing_length] : close[swing_length]
    bull_box      := box.new(bar_index[swing_length], bull_body, bar_index, bull_low, color.lime, 1, 
                         line.style_dotted, extend = extend.none, bgcolor = color.new(color.lime, 90))
    bull_box_array.push(bull_box)

    // ---------------- Maintain Maximum Active Bull Zones ----------- \\
    if bull_box_array.size() > max_active_sweep_bull
        bull_box_array.remove(0)


// ______________________ Bullish Zone Interaction Logic __________________________ \\
// ---------------- Zone Status Flags ----------- \\
in_side_bull_zone = false
bull_bounce       = false

// ---------------- Iterate Through Active Bull Zones ----------- \\
i = 0
for boxes in bull_box_array
    // Price Currently Inside Demand Zone
    if close > boxes.get_bottom() and close < boxes.get_top()
        in_side_bull_zone := true
    
    // Liquidity Sweep / Bounce Detection
    if close > boxes.get_bottom() and low < boxes.get_bottom()
        bull_bounce       := true

    // Zone Invalidated After Breakdown
    if close < boxes.get_bottom()
        bull_box_array.remove(i)
    else
        boxes.set_right(bar_index)
        
    i += 1


// ______________________ Bearish Zone Interaction Logic __________________________ \\
// ---------------- Zone Status Flags ----------- \\
in_side_bear_zone    = false
bear_bounce          = false

// ---------------- Iterate Through Active Bear Zones ----------- \\
u = 0
for boxes in bear_box_array
    // Price Currently Inside Supply Zone
    if close > boxes.get_bottom() and close < boxes.get_top()
        in_side_bear_zone := true
    
    // Liquidity Sweep / Rejection Detection
    if close < boxes.get_top() and high > boxes.get_top()
        bear_bounce       := true

    // Zone Invalidated After Breakout
    if close > boxes.get_top()
        bear_box_array.remove(u)
    else
        boxes.set_right(bar_index)
        
    u += 1


// ______________________ Sweep Signal Plotting __________________________ \\
// ---------------- Bullish Liquidity Sweep Signal ----------- \\
plotshape(bull_bounce, "Bullish Sweep", shape.labelup, location = location.belowbar, color = color.new(color.lime, 50)
             , textcolor = color.white, force_overlay = true, text = "B")

// ---------------- Bearish Liquidity Sweep Signal ----------- \\
plotshape(bear_bounce, "Bearish Sweep", shape.labeldown, location = location.abovebar, color = color.new(color.red, 50)
             , textcolor = color.white, force_overlay = true, text = "S")


// ______________________ Candle Coloring __________________________ \\
// ---------------- Highlight Bullish Liquidity Zone ----------- \\
barcolor(in_side_bull_zone ? color.new(bull_zone_col, 0) : na)

// ---------------- Highlight Bearish Liquidity Zone ----------- \\
barcolor(in_side_bear_zone ? color.new(bear_zone_col, 0) : na)


// _____________________ alerts Part __________________________________ \\
alertcondition(in_side_bull_zone, "Inside Zone Bull", "Inside Bullish Zone !!")
alertcondition(bull_bounce      , "Bullish Sweep", "Bullish Sweep !!")
alertcondition(in_side_bear_zone, "Inside Zone Bear", "Inside Bear Zone !!")
alertcondition(bear_bounce      , "Bearish Sweep", "Bearish Sweep !!")
