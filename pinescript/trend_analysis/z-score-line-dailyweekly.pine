//@version=6
indicator('Z-Score line Daily/Weekly', overlay = false)

// Inputs
timeframe = input.timeframe('D', title = 'Timeframe', options = ['D', 'W'])
length = input.int(defval = 21, title = 'Linear Regression Length')
offset = input.int(defval = 30, title = 'Linear Regression Offset')
lineoff = input.bool(defval = true, title = 'Plot Linear Regression Line?')
malength = input.int(defval = 13, title = 'Z-Score MA Length')

// Calculations
reg = ta.linreg(close, length, offset)
residual = close - reg
residualStdev = ta.stdev(close - ta.linreg(close, length, 0), length)
zscore = residualStdev != 0 ? residual / residualStdev : 0.0
zscorema = ta.sma(zscore, malength)

// Colors
matrend = zscorema > zscorema[1] ? color.rgb(57, 255, 20, 50) : color.rgb(255, 8, 0, 50)
zscorecolor = zscore > 0 ? color.green : color.red

// Plotting
hline(0, title = 'Zero Line', color = color.gray)
plot(5.1, title = 'Upper Line', color = color.white)
plot(-4.7, title = 'Lower Line', color = color.white)
plot(zscore, title = 'Z-Score', color = zscorecolor, linewidth = 2)
plot(zscorema, title = 'Z-Score MA', color = matrend, linewidth = 1)

// Alerts
alertcondition(ta.crossover(zscore, 0), title = 'Z-Score Crosses Above Zero', message = 'Z-Score crossed above zero')
alertcondition(ta.crossunder(zscore, 0), title = 'Z-Score Crosses Below Zero', message = 'Z-Score crossed below zero')
alertcondition(ta.crossover(zscore, 5.1), title = 'Z-Score Crosses Above Upper Line', message = 'Z-Score crossed above upper line')
alertcondition(ta.crossunder(zscore, -4.7), title = 'Z-Score Crosses Below Lower Line', message = 'Z-Score crossed below lower line')
