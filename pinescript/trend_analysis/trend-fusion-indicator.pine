//@version=5
indicator("Trend Fusion Indicator", overlay=true)

// === INPUTS ===
emaLen    = input.int(9,  "EMA Length", minval=1)
stAtrLen = input.int(10, "Supertrend ATR Length", minval=1)
stFactor = input.float(4.0, "Supertrend Factor", step=0.1)

// === CALCULATIONS ===
ema = ta.ema(close, emaLen)
[superTrend, stDir] = ta.supertrend(stFactor, stAtrLen)

// === SIGNAL CONDITIONS (ONLY ON CROSSOVER) ===
buySignal  = ta.crossover(ema, superTrend)
sellSignal = ta.crossunder(ema, superTrend)

// === TREND STATE (PERSISTS AFTER SIGNAL) ===
trend = 0
trend := buySignal  ? 1 :
         sellSignal ? -1 :
         nz(trend[1], 0)

// === COLORS ===
bullColor = color.lime
bearColor = color.red
neutral   = color.gray

trendColor = trend == 1 ? bullColor :
             trend == -1 ? bearColor :
             neutral

// === PLOTS ===
emaPlot = plot(ema, color=trendColor, linewidth=2, title="EMA")
stPlot  = plot(superTrend, color=trendColor, linewidth=2, title="Supertrend")

// === FILL BETWEEN EMA & SUPERTREND ===
fill(     emaPlot,     stPlot,     color = trend == 1 ? color.new(bullColor, 85) :             trend == -1 ? color.new(bearColor, 85) :             na,     title="EMA–Supertrend Fill")

// === BACKGROUND COLOR ===
bgcolor(     trend == 1 ? color.new(bullColor, 92) :     trend == -1 ? color.new(bearColor, 92) :     na)

// === SIGNAL MARKERS ===
plotshape(buySignal,
     title="BUY",
     location=location.belowbar,
     style=shape.triangleup,
     color=bullColor,
     size=size.small,
     text="BUY")

plotshape(sellSignal,
     title="SELL",
     location=location.abovebar,
     style=shape.triangledown,
     color=bearColor,
     size=size.small,
     text="SELL")

// === ALERTS ===
alertcondition(buySignal, title="Buy Alert", message="EMA crossed ABOVE Supertrend → BUY")
alertcondition(sellSignal, title="Sell Alert", message="EMA crossed BELOW Supertrend → SELL")
