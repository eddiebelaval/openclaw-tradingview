// This Pine Script(TM) v6 indicator is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// (c) Viprasol

//@version=6
indicator("[Viprasol] Fibonacci Volume Profile Map", overlay=true,
     max_lines_count=500, max_boxes_count=500, max_labels_count=300)

// ──────────────────────────────────────────────────────────────────────────────
// CONSTANTS
// ──────────────────────────────────────────────────────────────────────────────
const color  COLOR_BULL         = #00C853
const color  COLOR_BEAR         = #E91E63
const color  COLOR_BUY_VOL      = #2196F3
const color  COLOR_SELL_VOL     = #E91E63
const color  COLOR_POC          = #FF1744
const color  COLOR_VA           = #FFD740
const color  COLOR_DOMINANT     = #00FFBF
const color  COLOR_FIB_KEY      = color.white
const color  COLOR_FIB_MID      = color.new(color.white, 40)
const color  COLOR_FIB_STD      = color.new(color.gray, 20)
const color  COLOR_RANGE_BOX    = color.new(color.gray, 20)
const color  COLOR_RANGE_BG     = color.new(color.gray, 97)
const color  COLOR_PANEL_BG     = #0D0D0D
const color  COLOR_PANEL_HDR    = #0F3460
const color  COLOR_PANEL_BORDER = color.new(#6489A7, 60)
const float  VALUE_AREA_PCT     = 0.70
const string VP_LABEL           = "VIPRASOL"

// ──────────────────────────────────────────────────────────────────────────────
// INPUTS
// ──────────────────────────────────────────────────────────────────────────────
// --- Range Settings ---
string GRP_RANGE = "Range Settings"
int lookbackPeriodInput = input.int(60, "Lookback Period (candles)", minval=10, maxval=500, group=GRP_RANGE,
     tooltip="Number of bars to analyze for the price range, Fibonacci levels, and volume profile. Larger values show broader structure.")

// --- Volume Profile ---
string GRP_PROFILE = "Volume Profile"
int profileBucketCountInput = input.int(50, "Profile Buckets", minval=5, maxval=60, group=GRP_PROFILE,
     tooltip="Number of price bins to divide the range into for the volume histogram. More buckets = finer resolution.")
int profileBarWidthInput = input.int(10, "Profile Max Width (bars)", minval=2, maxval=30, group=GRP_PROFILE,
     tooltip="Maximum width of the volume profile histogram in bars. Controls how far the boxes extend.")
int profileRightOffsetInput = input.int(20, "Profile Right Offset (bars)", minval=0, maxval=100, group=GRP_PROFILE,
     tooltip="Distance in bars from the current bar to where the volume profile starts drawing.")
bool flipProfileSideInput = input.bool(false, "Flip to Left Side", group=GRP_PROFILE,
     tooltip="When enabled, the volume profile draws to the left instead of right.")
bool showValueAreaInput = input.bool(true, "Show Value Area (70%)", group=GRP_PROFILE,
     tooltip="Display Value Area High and Low lines — the price range containing 70% of the total volume.")

// --- Fibonacci ---
string GRP_FIB = "Fibonacci"
bool showFibLevelsInput = input.bool(true, "Show Fibonacci Levels", group=GRP_FIB,
     tooltip="Display auto-calculated Fibonacci retracement and extension levels across the detected range.")
bool extendFibRightInput = input.bool(true, "Extend Fibs to Right", group=GRP_FIB,
     tooltip="Extend Fibonacci lines beyond the current price range to the right edge of the chart.")
int fibLabelPaddingInput = input.int(3, "Label Extra Padding (bars)", minval=0, maxval=20, group=GRP_FIB,
     tooltip="Additional spacing between the end of the profile and the Fibonacci price labels.")

// --- Visuals ---
string GRP_VIS = "Visuals"
bool showRangeBoxInput = input.bool(true, "Show Range Box", group=GRP_VIS,
     tooltip="Display a dashed bounding box around the detected price range.")
bool showProfileInput = input.bool(true, "Show Volume Profile", group=GRP_VIS,
     tooltip="Display the buy/sell volume histogram on the chart.")
bool showPocLineInput = input.bool(true, "Show POC Line", group=GRP_VIS,
     tooltip="Display the Point of Control line — the price level with the highest volume.")
bool colorCandlesInput = input.bool(true, "Color Candles", group=GRP_VIS,
     tooltip="Override candle colors with custom bull/bear colors.")
color bullCandleColorInput = input.color(#00C853, "Bull Candle Color", group=GRP_VIS,
     tooltip="Color for bullish (close >= open) candles.")
color bearCandleColorInput = input.color(#E91E63, "Bear Candle Color", group=GRP_VIS,
     tooltip="Color for bearish (close < open) candles.")
color buyVolumeColorInput = input.color(COLOR_BUY_VOL, "Buy Volume Color", group=GRP_VIS,
     tooltip="Color for buy-side volume bars in the profile.")
color sellVolumeColorInput = input.color(COLOR_SELL_VOL, "Sell Volume Color", group=GRP_VIS,
     tooltip="Color for sell-side volume bars in the profile.")
color dominantLevelColorInput = input.color(COLOR_DOMINANT, "Dominant Level Color", group=GRP_VIS,
     tooltip="Color for the POC (highest volume) bucket in the profile.")

// --- Dashboard ---
string GRP_DASH = "Dashboard"
bool showDashboardInput = input.bool(true, "Show Dashboard", group=GRP_DASH,
     tooltip="Toggle the information dashboard on/off.")
string dashPositionInput = input.string("Bottom Center", "Dashboard Position",
     options=["Top Left", "Top Center", "Top Right",
              "Middle Left", "Middle Center", "Middle Right",
              "Bottom Left", "Bottom Center", "Bottom Right"], group=GRP_DASH,
     tooltip="Screen position for the dashboard table.")
string dashFontSizeInput = input.string("small", "Dashboard Font Size",
     options=["tiny", "small", "normal", "large", "huge"], group=GRP_DASH,
     tooltip="Font size for all dashboard text.")

// ──────────────────────────────────────────────────────────────────────────────
// FUNCTIONS
// ──────────────────────────────────────────────────────────────────────────────
resolveDashPosition(string pos) =>
    switch pos
        "Top Left"       => position.top_left
        "Top Center"     => position.top_center
        "Top Right"      => position.top_right
        "Middle Left"    => position.middle_left
        "Middle Center"  => position.middle_center
        "Middle Right"   => position.middle_right
        "Bottom Left"    => position.bottom_left
        "Bottom Right"   => position.bottom_right
        => position.bottom_center

getFontSize(string sz) =>
    switch sz
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        "huge"   => size.huge

clearLineArray(line[] arr) =>
    for ln in arr
        line.delete(ln)
    array.clear(arr)

clearLabelArray(label[] arr) =>
    for lb in arr
        label.delete(lb)
    array.clear(arr)

clearBoxArray(box[] arr) =>
    for bx in arr
        box.delete(bx)
    array.clear(arr)

// ──────────────────────────────────────────────────────────────────────────────
// CALCULATIONS — Range & Bucket Sizing
// ──────────────────────────────────────────────────────────────────────────────
float priceRangeHigh = ta.highest(high, lookbackPeriodInput)
float priceRangeLow  = ta.lowest(low, lookbackPeriodInput)
float priceRangeSpan = priceRangeHigh - priceRangeLow
float bucketHeight   = priceRangeSpan / profileBucketCountInput

// ──────────────────────────────────────────────────────────────────────────────
// CALCULATIONS — Fibonacci Level Definitions
// ──────────────────────────────────────────────────────────────────────────────
var float[] FIB_RATIOS = array.from(
     -0.13, 0.0, 0.13,
      0.236, 0.382, 0.5,
      0.618, 0.786, 0.886,
      1.0, 1.13)

// ──────────────────────────────────────────────────────────────────────────────
// CALCULATIONS — Candle Coloring
// ──────────────────────────────────────────────────────────────────────────────
barcolor(colorCandlesInput ? (close >= open ? bullCandleColorInput : bearCandleColorInput) : na)

// ──────────────────────────────────────────────────────────────────────────────
// PERSISTENT DRAWING OBJECTS
// ──────────────────────────────────────────────────────────────────────────────
var line[]  fibLineStore   = array.new_line()
var label[] fibLabelStore  = array.new_label()
var box[]   profileBoxStore = array.new_box()
var box     rangeOutlineBox = na
var line    pocPriceLine    = na
var line    vaHighLine      = na
var line    vaLowLine       = na
var label   vaHighLabel     = na
var label   vaLowLabel      = na
var table   dashPanel       = na

// ──────────────────────────────────────────────────────────────────────────────
// MAIN DRAWING LOGIC (runs on last bar only)
// ──────────────────────────────────────────────────────────────────────────────
if barstate.islast

    int rangeStartBar = bar_index - lookbackPeriodInput + 1
    int profileEdge   = bar_index + profileRightOffsetInput + profileBarWidthInput + 1
    int pocBucketIdx  = 0
    int vaUpperIdx    = 0
    int vaLowerIdx    = 0

    // ── 1. RANGE BOX ────────────────────────────────────────────
    box.delete(rangeOutlineBox)
    if showRangeBoxInput
        rangeOutlineBox := box.new(left=rangeStartBar, top=priceRangeHigh, right=bar_index,
             bottom=priceRangeLow, border_color=COLOR_RANGE_BOX, border_width=1,
             border_style=line.style_dashed, bgcolor=COLOR_RANGE_BG)

    // ── 2. FIBONACCI LINES & LABELS ─────────────────────────────
    clearLineArray(fibLineStore)
    clearLabelArray(fibLabelStore)

    if showFibLevelsInput
        for i = 0 to array.size(FIB_RATIOS) - 1
            float ratio    = array.get(FIB_RATIOS, i)
            float fibPrice = priceRangeHigh - ratio * priceRangeSpan

            bool  isKeyLevel = ratio == 0.0 or ratio == 1.0
            bool  isMidLevel = ratio == 0.5
            color lineColor  = isKeyLevel ? COLOR_FIB_KEY : isMidLevel ? COLOR_FIB_MID : COLOR_FIB_STD
            int   lineWidth  = isKeyLevel ? 2 : 1

            line fibLn = line.new(x1=rangeStartBar, y1=fibPrice, x2=profileEdge, y2=fibPrice,
                 color=lineColor, width=lineWidth,
                 extend=extendFibRightInput ? extend.right : extend.none)
            array.push(fibLineStore, fibLn)

            string fibText = str.tostring(math.round(fibPrice, 2)) + "  (" + str.tostring(ratio) + ")"
            label fibLb = label.new(x=profileEdge + 1 + fibLabelPaddingInput, y=fibPrice, text=fibText,
                 style=label.style_none, textcolor=color.white, size=size.small, xloc=xloc.bar_index)
            array.push(fibLabelStore, fibLb)

    // ── 3. VOLUME PROFILE + VALUE AREA ──────────────────────────
    clearBoxArray(profileBoxStore)
    line.delete(pocPriceLine)
    line.delete(vaHighLine)
    line.delete(vaLowLine)
    label.delete(vaHighLabel)
    label.delete(vaLowLabel)

    if showProfileInput
        float[] buyBuckets  = array.new_float(profileBucketCountInput, 0.0)
        float[] sellBuckets = array.new_float(profileBucketCountInput, 0.0)

        for i = 0 to lookbackPeriodInput - 1
            float barClose  = close[i]
            float barOpen   = open[i]
            float barVol    = volume[i]
            int   bucketIdx = math.max(0, math.min(profileBucketCountInput - 1,
                 int(math.floor((barClose - priceRangeLow) / bucketHeight))))
            if barClose >= barOpen
                array.set(buyBuckets, bucketIdx, array.get(buyBuckets, bucketIdx) + barVol)
            else
                array.set(sellBuckets, bucketIdx, array.get(sellBuckets, bucketIdx) + barVol)

        // Find max volume and POC
        float peakVolume      = 0.0
        float totalProfileVol = 0.0

        for i = 0 to profileBucketCountInput - 1
            float bucketTotal = array.get(buyBuckets, i) + array.get(sellBuckets, i)
            totalProfileVol  += bucketTotal
            if bucketTotal > peakVolume
                peakVolume   := bucketTotal
                pocBucketIdx := i

        // Calculate Value Area (70% of total volume)
        float vaTargetVol = totalProfileVol * VALUE_AREA_PCT
        float vaAccumVol = array.get(buyBuckets, pocBucketIdx) + array.get(sellBuckets, pocBucketIdx)
        vaUpperIdx := pocBucketIdx
        vaLowerIdx := pocBucketIdx

        while vaAccumVol < vaTargetVol and (vaUpperIdx < profileBucketCountInput - 1 or vaLowerIdx > 0)
            float upperVol = vaUpperIdx < profileBucketCountInput - 1 ?
                 array.get(buyBuckets, vaUpperIdx + 1) + array.get(sellBuckets, vaUpperIdx + 1) : 0.0
            float lowerVol = vaLowerIdx > 0 ?
                 array.get(buyBuckets, vaLowerIdx - 1) + array.get(sellBuckets, vaLowerIdx - 1) : 0.0

            if upperVol >= lowerVol and vaUpperIdx < profileBucketCountInput - 1
                vaUpperIdx  += 1
                vaAccumVol  += upperVol
            else if vaLowerIdx > 0
                vaLowerIdx  -= 1
                vaAccumVol  += lowerVol
            else if vaUpperIdx < profileBucketCountInput - 1
                vaUpperIdx  += 1
                vaAccumVol  += upperVol
            else
                break

        float vaHighPrice = priceRangeLow + (vaUpperIdx + 1) * bucketHeight
        float vaLowPrice  = priceRangeLow + vaLowerIdx * bucketHeight

        // Draw profile boxes
        int profileStartX = bar_index + profileRightOffsetInput

        for i = 0 to profileBucketCountInput - 1
            float buyVol    = array.get(buyBuckets, i)
            float sellVol   = array.get(sellBuckets, i)
            int   buyWidth  = peakVolume > 0 ? int(math.round(buyVol / peakVolume * profileBarWidthInput)) : 0
            int   sellWidth = peakVolume > 0 ? int(math.round(sellVol / peakVolume * profileBarWidthInput)) : 0

            float bucketTop = priceRangeLow + (i + 1) * bucketHeight
            float bucketBot = priceRangeLow + i * bucketHeight
            bool  isPoc     = i == pocBucketIdx
            color buyColor  = isPoc ? dominantLevelColorInput : buyVolumeColorInput
            color sellColor = isPoc ? dominantLevelColorInput : sellVolumeColorInput

            if not flipProfileSideInput
                if sellWidth > 0
                    array.push(profileBoxStore, box.new(left=profileStartX, top=bucketTop,
                         right=profileStartX + sellWidth, bottom=bucketBot, border_color=na, bgcolor=sellColor))
                if buyWidth > 0
                    array.push(profileBoxStore, box.new(left=profileStartX + sellWidth, top=bucketTop,
                         right=profileStartX + sellWidth + buyWidth, bottom=bucketBot, border_color=na, bgcolor=buyColor))
            else
                if sellWidth > 0
                    array.push(profileBoxStore, box.new(left=profileStartX - sellWidth, top=bucketTop,
                         right=profileStartX, bottom=bucketBot, border_color=na, bgcolor=sellColor))
                if buyWidth > 0
                    array.push(profileBoxStore, box.new(left=profileStartX - sellWidth - buyWidth, top=bucketTop,
                         right=profileStartX - sellWidth, bottom=bucketBot, border_color=na, bgcolor=buyColor))

        // POC Line
        if showPocLineInput
            float pocPrice = priceRangeLow + (pocBucketIdx + 0.5) * bucketHeight
            pocPriceLine := line.new(x1=rangeStartBar, y1=pocPrice, x2=profileEdge, y2=pocPrice,
                 color=COLOR_POC, width=2, style=line.style_dashed,
                 extend=extendFibRightInput ? extend.right : extend.none)

        // Value Area Lines
        if showValueAreaInput
            vaHighLine  := line.new(x1=rangeStartBar, y1=vaHighPrice, x2=profileEdge, y2=vaHighPrice,
                 color=COLOR_VA, width=1, style=line.style_dotted,
                 extend=extendFibRightInput ? extend.right : extend.none)
            vaLowLine   := line.new(x1=rangeStartBar, y1=vaLowPrice, x2=profileEdge, y2=vaLowPrice,
                 color=COLOR_VA, width=1, style=line.style_dotted,
                 extend=extendFibRightInput ? extend.right : extend.none)
            vaHighLabel := label.new(x=profileEdge + 1, y=vaHighPrice, text="VAH " + str.tostring(math.round(vaHighPrice, 2)),
                 style=label.style_none, textcolor=COLOR_VA, size=size.small)
            vaLowLabel  := label.new(x=profileEdge + 1, y=vaLowPrice, text="VAL " + str.tostring(math.round(vaLowPrice, 2)),
                 style=label.style_none, textcolor=COLOR_VA, size=size.small)

    // ── 4. DASHBOARD ────────────────────────────────────────────
    if showDashboardInput
        float totalBuyVol    = 0.0
        float totalSellVol   = 0.0
        float largestBuyVol  = 0.0
        float largestSellVol = 0.0
        float largestBuyPx   = 0.0
        float largestSellPx  = 0.0

        for i = 0 to lookbackPeriodInput - 1
            float barClose = close[i]
            float barOpen  = open[i]
            float barVol   = volume[i]
            if barClose >= barOpen
                totalBuyVol += barVol
                if barVol > largestBuyVol
                    largestBuyVol := barVol
                    largestBuyPx  := barClose
            else
                totalSellVol += barVol
                if barVol > largestSellVol
                    largestSellVol := barVol
                    largestSellPx  := barClose

        float combinedVol = totalBuyVol + totalSellVol
        float buyPct      = combinedVol > 0 ? totalBuyVol / combinedVol * 100 : 0.0
        float sellPct     = combinedVol > 0 ? totalSellVol / combinedVol * 100 : 0.0

        bool   bearishBias = sellPct > buyPct
        string trendText   = bearishBias ? "Bearish" : "Bullish"
        color  trendColor  = bearishBias ? COLOR_BEAR : COLOR_BULL

        float  fibSupport    = priceRangeHigh - 0.886 * priceRangeSpan
        float  fibResistance = priceRangeHigh - 0.618 * priceRangeSpan
        float  pnlRange      = fibSupport > 0 ? math.abs(fibResistance - fibSupport) / fibSupport * 100 : 0.0

        string directionEst  = close < fibResistance ? "Up" : "Down"
        color  directionClr  = directionEst == "Up" ? COLOR_BULL : COLOR_BEAR

        float  volumeDelta   = totalBuyVol - totalSellVol
        string deltaText     = (volumeDelta >= 0 ? "+" : "") + str.tostring(math.round(volumeDelta / 1000, 1)) + "K"

        table.delete(dashPanel)
        dashPanel := table.new(position=resolveDashPosition(dashPositionInput), columns=6, rows=6,
             bgcolor=COLOR_PANEL_BG, border_color=COLOR_PANEL_BORDER, border_width=1,
             frame_color=color.new(COLOR_PANEL_HDR, 40), frame_width=1)

        fontSz = getFontSize(dashFontSizeInput)

        // Header
        table.cell(dashPanel, 0, 0, VP_LABEL, text_color=color.white, bgcolor=COLOR_PANEL_HDR, text_size=fontSz)
        table.cell(dashPanel, 1, 0, "FIB-VP MAP", text_color=color.white, bgcolor=COLOR_PANEL_HDR, text_size=fontSz, text_halign=text.align_center)
        table.merge_cells(dashPanel, 1, 0, 5, 0)

        // Row 1 Headers
        table.cell(dashPanel, 0, 1, "Candles",      text_color=color.white, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 1, 1, "Buy Rate",     text_color=color.white, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 2, 1, "Sell Rate",    text_color=color.white, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 3, 1, "Vol Delta",    text_color=color.white, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 4, 1, "Largest Buy",  text_color=color.white, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 5, 1, "Largest Sell", text_color=color.white, bgcolor=COLOR_PANEL_BG, text_size=fontSz)

        // Row 1 Data
        table.cell(dashPanel, 0, 2, str.tostring(lookbackPeriodInput),
             text_color=color.white, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 1, 2, str.tostring(math.round(buyPct, 1)) + "%",
             text_color=COLOR_BULL, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 2, 2, str.tostring(math.round(sellPct, 1)) + "%",
             text_color=COLOR_BEAR, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 3, 2, deltaText,
             text_color=volumeDelta >= 0 ? COLOR_BULL : COLOR_BEAR, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 4, 2, str.tostring(math.round(largestBuyPx, 2)),
             text_color=COLOR_BULL, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 5, 2, str.tostring(math.round(largestSellPx, 2)),
             text_color=COLOR_BEAR, bgcolor=COLOR_PANEL_BG, text_size=fontSz)

        // Row 2 Headers
        table.cell(dashPanel, 0, 3, "Trend",      text_color=color.white, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 1, 3, "Support",    text_color=color.white, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 2, 3, "Resistance", text_color=color.white, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 3, 3, "S/R Range",  text_color=color.white, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 4, 3, "Estimate",   text_color=color.white, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 5, 3, "POC Zone",   text_color=color.white, bgcolor=COLOR_PANEL_BG, text_size=fontSz)

        // Row 2 Data
        float pocDisplayPrice = priceRangeLow + (pocBucketIdx + 0.5) * bucketHeight
        string pocZoneText = close > pocDisplayPrice ? "ABOVE" : "BELOW"
        color  pocZoneColor = close > pocDisplayPrice ? COLOR_BULL : COLOR_BEAR

        table.cell(dashPanel, 0, 4, trendText,
             text_color=trendColor, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 1, 4, str.tostring(math.round(fibSupport, 2)),
             text_color=COLOR_BULL, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 2, 4, str.tostring(math.round(fibResistance, 2)),
             text_color=COLOR_BEAR, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 3, 4, str.tostring(math.round(pnlRange, 2)) + "%",
             text_color=color.white, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 4, 4, directionEst,
             text_color=directionClr, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
        table.cell(dashPanel, 5, 4, pocZoneText,
             text_color=pocZoneColor, bgcolor=COLOR_PANEL_BG, text_size=fontSz)

        // Row 3 — Value Area info
        if showValueAreaInput and showProfileInput
            float vaHighDisp = priceRangeLow + (vaUpperIdx + 1) * bucketHeight
            float vaLowDisp  = priceRangeLow + vaLowerIdx * bucketHeight
            string priceInVa = close >= vaLowDisp and close <= vaHighDisp ? "INSIDE VA" : "OUTSIDE VA"
            color  vaLocColor = close >= vaLowDisp and close <= vaHighDisp ? COLOR_VA : COLOR_BEAR

            table.cell(dashPanel, 0, 5, "VA High", text_color=color.white, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
            table.cell(dashPanel, 1, 5, str.tostring(math.round(vaHighDisp, 2)),
                 text_color=COLOR_VA, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
            table.cell(dashPanel, 2, 5, "VA Low", text_color=color.white, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
            table.cell(dashPanel, 3, 5, str.tostring(math.round(vaLowDisp, 2)),
                 text_color=COLOR_VA, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
            table.cell(dashPanel, 4, 5, "Price", text_color=color.white, bgcolor=COLOR_PANEL_BG, text_size=fontSz)
            table.cell(dashPanel, 5, 5, priceInVa,
                 text_color=vaLocColor, bgcolor=COLOR_PANEL_BG, text_size=fontSz)

// ──────────────────────────────────────────────────────────────────────────────
// ALERT SUPPORT — Calculated outside barstate.islast for alertcondition()
// ──────────────────────────────────────────────────────────────────────────────
// Fibonacci key levels for alerts
float fibLevel0   = priceRangeHigh
float fibLevel50  = priceRangeHigh - 0.5 * priceRangeSpan
float fibLevel100 = priceRangeLow
float fib618      = priceRangeHigh - 0.618 * priceRangeSpan
float fib382      = priceRangeHigh - 0.382 * priceRangeSpan

// POC approximation for alerts (computed every bar)
float pocAlertPrice = priceRangeLow + priceRangeSpan * 0.5

// Volume bias
float alertBuyVol  = 0.0
float alertSellVol = 0.0
for i = 0 to math.min(lookbackPeriodInput - 1, bar_index)
    if close[i] >= open[i]
        alertBuyVol += volume[i]
    else
        alertSellVol += volume[i]
float alertTotalVol = alertBuyVol + alertSellVol
float alertBuyPct   = alertTotalVol > 0 ? alertBuyVol / alertTotalVol * 100 : 50.0

bool volumeDominanceFlip = (alertBuyPct > 50 and alertBuyPct[1] <= 50) or (alertBuyPct <= 50 and alertBuyPct[1] > 50)

// ──────────────────────────────────────────────────────────────────────────────
// ALERTS
// ──────────────────────────────────────────────────────────────────────────────
alertcondition(ta.cross(close, fib618),
     title="Price at Fib 0.618",
     message="[Viprasol Fib-VP] Price crossed Fib 0.618 level on {{ticker}} at {{close}} | TF: {{interval}}")

alertcondition(ta.cross(close, fib382),
     title="Price at Fib 0.382",
     message="[Viprasol Fib-VP] Price crossed Fib 0.382 level on {{ticker}} at {{close}} | TF: {{interval}}")

alertcondition(ta.cross(close, fibLevel50),
     title="Price at Fib 0.5 (Midpoint)",
     message="[Viprasol Fib-VP] Price crossed Fib 0.5 midpoint on {{ticker}} at {{close}} | TF: {{interval}}")

alertcondition(volumeDominanceFlip,
     title="Volume Dominance Flip",
     message="[Viprasol Fib-VP] Buy/sell volume dominance flipped on {{ticker}} | TF: {{interval}}")

alertcondition(ta.cross(close, fibLevel0) or ta.cross(close, fibLevel100),
     title="Price at Range Boundary",
     message="[Viprasol Fib-VP] Price at range high/low on {{ticker}} at {{close}} | TF: {{interval}}")
