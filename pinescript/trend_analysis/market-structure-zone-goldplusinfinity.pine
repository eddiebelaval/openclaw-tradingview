//©GoldPlusInfinity

//@version=6
indicator("GoldPlusInfinity_SZ1", overlay=true, max_boxes_count=500, max_lines_count=500)

//Moyenne mobile
group_ma = "MOYENNE MOBILE"
show_ma20 = input.bool(true, " Activer MA 20 ", group = group_ma)
maLen20 = 20
ma20 = ta.sma(close, maLen20)
plot(show_ma20 ? ma20 : na, color=color.new(#3b82f6, 60), title="MA20 Trend", linewidth=2)

show_ma50 = input.bool(true, " Activer MA 50 ", group = group_ma)
maLen50 = 50
ma50 = ta.sma(close, maLen50)
plot(show_ma50 ? ma50 : na, color=color.new(#f6643b, 60), title="MA50 Trend", linewidth=2)

// --- PARAMÈTRES D'AFFICHAGE GÉNÉRAUX ---
group_disp = "Options d'Affichage"
show_majors   = input.bool(true, "Afficher Structures MAJEURES", group=group_disp)
show_micros   = input.bool(true, "Afficher MICRO-Structures", group=group_disp)
show_zones    = input.bool(true, "Afficher Zones Rectangles", group=group_disp)
show_lines    = input.bool(true, "Afficher Lignes de Niveaux", group=group_disp)
line_width    = input.int(1, "Épaisseur des lignes", minval=1, maxval=5, group=group_disp)
label_offset  = input.int(50, "Décalage des Labels (Bougies)", minval=1, group=group_disp)

// --- PARAMÈTRES S/D (RBR/DBD) ---
group_sd = "Offre & Demande (S/D)"
show_sd       = input.bool(true, "Afficher RBR / DBD", group=group_sd)
trend_len_sd  = input.int(2, "Bougies consécutives après Base", minval=1, group=group_sd)
color_sd_zones = input.color(color.rgb(19, 23, 34), "Couleur S/D (Noir Sombre)", group=group_sd)

// --- PARAMÈTRES STRUCTURES MAJEURES ---
group_maj_1 = "Structure Majeure 1"
lookback_maj1      = input.int(6, "Période Pivot M1", minval=1, group=group_maj_1)
trend_len_maj1    = input.int(0, "Confirmation M1", minval=0, group=group_maj_1)
color_high_maj1   = input.color(color.red, "High M1", group=group_maj_1)
color_low_maj1    = input.color(color.green, "Low M1", group=group_maj_1)

group_maj_2 = "Structure Majeure 2"
lookback_maj2      = input.int(12, "Période Pivot M2", minval=1, group=group_maj_2)
trend_len_maj2    = input.int(0, "Confirmation M2", minval=0, group=group_maj_2)
color_high_maj2   = input.color(color.maroon, "High M2", group=group_maj_2)
color_low_maj2    = input.color(color.teal, "Low M2", group=group_maj_2)

// --- PARAMÈTRES MICRO-STRUCTURES ---
group_mic_1 = "Micro-Structure 1"
lookback_mic1      = input.int(2, "Période Pivot Micro 1", minval=1, group=group_mic_1)
trend_len_mic1    = input.int(0, "Confirmation Micro 1", minval=0, group=group_mic_1)
color_high_mic1   = input.color(color.purple, "High Micro 1", group=group_mic_1)
color_low_mic1    = input.color(color.aqua, "Low Micro 1", group=group_mic_1)

group_mic_2 = "Micro-Structure 2"
lookback_mic2      = input.int(4, "Période Pivot Micro 2", minval=1, group=group_mic_2)
trend_len_mic2    = input.int(0, "Confirmation Micro 2", minval=0, group=group_mic_2)
color_high_mic2   = input.color(color.fuchsia, "High Micro 2", group=group_mic_2)
color_low_mic2    = input.color(color.blue, "Low Micro 2", group=group_mic_2)

// --- VARIABLES PERSISTANTES ---
var box[] active_boxes = array.new_box()
var line[] active_lines = array.new_line()
var label[] active_labels = array.new_label()

// --- FONCTIONS UTILITAIRES ---
is_doji(i) => math.abs(open[i] - close[i]) <= (high[i] - low[i]) * 0.1

check_consecutive(start_idx, length, bull) =>
    bool ok = true
    if length > 0
        for i = 0 to length - 1
            if bull
                if close[start_idx - i] < open[start_idx - i]
                    ok := false
                    break
            else
                if close[start_idx - i] > open[start_idx - i]
                    ok := false
                    break
    ok

get_pips(price_diff) =>
    pips = price_diff / syminfo.mintick
    if syminfo.type == "forex"
        pips := pips / 10
    pips

get_zone_bounds(idx, is_high) =>
    float body_size = math.abs(open[idx] - close[idx])
    float safe_body = body_size == 0 ? syminfo.mintick : body_size
    float upper_wick = high[idx] - math.max(open[idx], close[idx])
    float lower_wick = math.min(open[idx], close[idx]) - low[idx]
    
    float z_top = high[idx]
    float z_bottom = low[idx]

    if is_doji(idx)
        z_top := high[idx]
        z_bottom := low[idx]
    else
        if is_high
            if upper_wick > 1.2 * safe_body or close[idx] >= open[idx]
                z_bottom := math.max(open[idx], close[idx])
            else
                z_bottom := open[idx]
        else
            if lower_wick > 1.2 * safe_body or close[idx] <= open[idx]
                z_top := math.min(open[idx], close[idx])
            else
                z_top := close[idx]
    [z_top, z_bottom]

// --- LOGIQUE DE DÉTECTION ET DESSIN ---
process_structure(lookback, trend_len, c_high, c_low, is_major, name) =>
    // Condition de visibilité basée sur les boutons
    can_show = is_major ? show_majors : show_micros
    
    if can_show
        ph = ta.pivothigh(high, lookback, lookback)
        pl = ta.pivotlow(low, lookback, lookback)
        
        if not na(ph) and check_consecutive(lookback - 1, trend_len, false)
            [zt, zb] = get_zone_bounds(lookback, true)
            pips_val = get_pips(zt - zb)
            
            if show_lines
                l = line.new(bar_index[lookback], high[lookback], bar_index, high[lookback], color=color.new(c_high, 30), style=is_major ? line.style_dashed : line.style_dotted, extend=extend.right, width=line_width)
                array.push(active_lines, l)
                
            if show_zones
                b = box.new(bar_index[lookback], zt, bar_index, zb, bgcolor=color.new(c_high, 90), border_color=color.new(c_high, 70), extend=extend.right)
                array.push(active_boxes, b)
                lbl = label.new(bar_index + label_offset, (zt + zb)/2, name + " (" + str.tostring(pips_val, "#.#") + " pips)", color=color.new(color.white, 100), textcolor=c_high, style=label.style_label_left, size=size.small)
                array.push(active_labels, lbl)

        if not na(pl) and check_consecutive(lookback - 1, trend_len, true)
            [zt, zb] = get_zone_bounds(lookback, false)
            pips_val = get_pips(zt - zb)
            
            if show_lines
                l = line.new(bar_index[lookback], low[lookback], bar_index, low[lookback], color=color.new(c_low, 30), style=is_major ? line.style_dashed : line.style_dotted, extend=extend.right, width=line_width)
                array.push(active_lines, l)
                
            if show_zones
                b = box.new(bar_index[lookback], zt, bar_index, zb, bgcolor=color.new(c_low, 90), border_color=color.new(c_low, 70), extend=extend.right)
                array.push(active_boxes, b)
                lbl = label.new(bar_index + label_offset, (zt + zb)/2, name + " (" + str.tostring(pips_val, "#.#") + " pips)", color=color.new(color.white, 100), textcolor=c_low, style=label.style_label_left, size=size.small)
                array.push(active_labels, lbl)

// Exécution des 4 structures avec les nouveaux noms Mz1 et Mz2
process_structure(lookback_maj1, trend_len_maj1, color_high_maj1, color_low_maj1, true, "M1")
process_structure(lookback_maj2, trend_len_maj2, color_high_maj2, color_low_maj2, true, "M2")
process_structure(lookback_mic1, trend_len_mic1, color_high_mic1, color_low_mic1, false, "Mz1")
process_structure(lookback_mic2, trend_len_mic2, color_high_mic2, color_low_mic2, false, "Mz2")

// --- S/D (RBR/DBD) ---
is_rbr = show_sd and close[trend_len_sd + 1] > open[trend_len_sd + 1] and math.abs(open[trend_len_sd]-close[trend_len_sd]) < math.abs(open[trend_len_sd+1]-close[trend_len_sd+1]) * 0.5 and check_consecutive(trend_len_sd - 1, trend_len_sd, true)
is_dbd = show_sd and close[trend_len_sd + 1] < open[trend_len_sd + 1] and math.abs(open[trend_len_sd]-close[trend_len_sd]) < math.abs(open[trend_len_sd+1]-close[trend_len_sd+1]) * 0.5 and check_consecutive(trend_len_sd - 1, trend_len_sd, false)

if is_rbr
    pips_val = get_pips(high[trend_len_sd] - low[trend_len_sd])
    b = box.new(bar_index[trend_len_sd], high[trend_len_sd], bar_index, low[trend_len_sd], bgcolor=color.new(color_sd_zones, 85), border_color=color.new(color_sd_zones, 60), extend=extend.right)
    array.push(active_boxes, b)
    lbl = label.new(bar_index + label_offset, (high[trend_len_sd] + low[trend_len_sd])/2, "B (" + str.tostring(pips_val, "#.#") + " pips)", color=color.new(color.white, 100), textcolor=color_sd_zones, style=label.style_label_left, size=size.small)
    array.push(active_labels, lbl)

if is_dbd
    pips_val = get_pips(high[trend_len_sd] - low[trend_len_sd])
    b = box.new(bar_index[trend_len_sd], high[trend_len_sd], bar_index, low[trend_len_sd], bgcolor=color.new(color_sd_zones, 85), border_color=color.new(color_sd_zones, 60), extend=extend.right)
    array.push(active_boxes, b)
    lbl = label.new(bar_index + label_offset, (high[trend_len_sd] + low[trend_len_sd])/2, "D (" + str.tostring(pips_val, "#.#") + " pips)", color=color.new(color.white, 100), textcolor=color_sd_zones, style=label.style_label_left, size=size.small)
    array.push(active_labels, lbl)

// --- GESTION DES OBJETS (Mise à jour et Mitigation) ---
if array.size(active_boxes) > 0
    for i = array.size(active_boxes) - 1 to 0
        b = array.get(active_boxes, i)
        box.set_right(b, bar_index)
        
        if array.size(active_labels) > i
            lbl = array.get(active_labels, i)
            label.set_x(lbl, bar_index + label_offset)
        
        t = box.get_top(b), bot = box.get_bottom(b)
        if (high >= bot and low <= t) and bar_index > box.get_left(b) + 1
            box.set_extend(b, extend.none)
            array.remove(active_boxes, i)
            if array.size(active_labels) > i
                label.delete(array.get(active_labels, i))
                array.remove(active_labels, i)

if array.size(active_lines) > 0
    for i = array.size(active_lines) - 1 to 0
        l = array.get(active_lines, i)
        line.set_x2(l, bar_index)
        
        val = line.get_y1(l)
        if (high >= val and low <= val) and bar_index > line.get_x1(l) + 1
            line.set_extend(l, extend.none)
            array.remove(active_lines, i)
