londonLabelText                = input.string('London', '', group='London Session', inline='londonLabel')
londonLabelSz                  = input.enum(Sz.normal, '', group='London Session', inline='londonLabel')
londonBg                       = input.color(color.new(#f48fb1, 88), 'Background', group='London Session', inline='color')
londonBorder                   = input.color(color.new(#f48fb1, 88), 'Border', group='London Session', inline='color')
