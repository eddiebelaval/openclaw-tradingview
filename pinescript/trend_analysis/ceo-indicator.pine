//@version=6
indicator("CEO INDICATOR", overlay=true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500, max_polylines_count = 100)

// -----------------------------
// ENUMS / HELPERS (переименованы)
// -----------------------------
enum PosX
    left                    = "Left"
    right                   = "Right"

enum PosY
    bottom                  = "Bottom"
    middle                  = "Middle"
    top                     = "Top"

enum LSize
    small                   = "1"
    normal                  = "2"
    large                   = "3"

enum LStyle
    solid1                   = "Solid - Size 1"
    solid2                   = "Solid - Size 2"
    solid3                   = "Solid - Size 3"
    dotted1                  = "Dotted - Size 1"
    dotted2                  = "Dotted - Size 2"
    dotted3                  = "Dotted - Size 3"
    dashed1                  = "Dashed - Size 1"
    dashed2                  = "Dashed - Size 2"
    dashed3                  = "Dashed - Size 3"

styleFromLStyle(LStyle s) =>
    if s == LStyle.solid1 or s == LStyle.solid2 or s == LStyle.solid3
        line.style_solid
    else if s == LStyle.dashed1 or s == LStyle.dashed2 or s == LStyle.dashed3
        line.style_dashed
    else
        line.style_dotted

sizeFromLStyle(LStyle s) =>
    if s == LStyle.solid1 or s == LStyle.dashed1 or s == LStyle.dotted1
        1
    else if s == LStyle.solid2 or s == LStyle.dashed2 or s == LStyle.dotted2
        2
    else
        3

type LData
    LStyle style
    int width

enum Sz
    tiny                    = "tiny"
    small                   = "small"
    normal                  = "normal"
    large                   = "large"
    huge                    = "huge"

enum SsnStyles
    boxStyle                = "Box"
    streamlined             = "Streamlined"
    fillStyle               = "Fill"
    levelStyle              = "High/Low"

type Ssn
    string id
    bool showLabel
    string labelText
    color labelColor
    Sz labelSz
    color bgColor
    color borderColor
    float sHigh
    float sLow

// common solid bg used for labels
color _solidColor = color.new(color.white, 100)

// -----------------------------
// INPUTS (сохранены, названия чуть изменены)
// -----------------------------
poolsEnabled                   = input.bool(defval = true, title = 'Enabled', group = 'Pools', inline = '1')

poolsExtend                    = input.bool(defval = false, title = 'Extend', group = 'Pools', inline = '10', tooltip = 'Extend lines to current day. Except Asia 0.5')
prevMonthShow                  = input.bool(defval = false, title = 'PMH/PML ', group = 'Pools', inline = 'previosMonthLevelsLine')
prevMonthColor                 = input.color(color.new(color.gray, 25), title = '', group = 'Pools', inline = 'previosMonthLevelsLine')
prevMonthStyle                 = input.enum(defval = LStyle.solid1, title = '', group = 'Pools', inline = 'previosMonthLevelsLine')

prevWeekShow                   = input.bool(defval = false, title = 'PWH/PWL ', group = 'Pools', inline = 'previosWeekLevelsLine')
prevWeekColor                  = input.color(color.new(color.gray, 25), title = "", group = 'Pools', inline = 'previosWeekLevelsLine')
