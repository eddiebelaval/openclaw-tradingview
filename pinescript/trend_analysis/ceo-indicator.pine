fvgBearClr                     = input.color(color.new(color.black, 80), 'Bearish FVG Color', group='Fair Value Gaps')

// Watermark
watermarkOn                    = input.bool(title="Enabled", defval=false, group = "Watermark")
waterTitleOn                   = input.bool(title="Show Title", defval=true, group = "Watermark")
waterInfoOn                    = input.bool(title="Show Info", defval=true, group = "Watermark")
titleVPos                      = input.string("top", "Title Vertical Pos", options = ["top", "middle", "bottom"], group = "Watermark")
titleHPos                      = input.string("center", "Title Horizont. Pos", options = ["left", "center", "right"], group = "Watermark")
infoVPos                       = input.string("bottom", "Info Vertical Pos", options = ["top", "middle", "bottom"], group = "Watermark")
infoHPos                       = input.string("center", "Info Horizont. Pos", options = ["left", "center", "right"], group = "Watermark")
titleTxt                       = input.string("Title", "Text", group = "Watermark-Title")
titleTxtSz                     = input.string("large", "Size", options = ["tiny", "small", "normal", "large", "huge", "auto"], group = "Watermark-Title")
titleAlign                     = input.string("center","Alignment", options = ["center","left", "right"], group = "Watermark-Title")
titleClr                       = input(color.new(color.black, 0), "Color", group = "Watermark-Title")
subTitleTxt                    = input.string("Sub Title", "Text", group = "Watermark-Sub Title")
subTitleSize                   = input.string("large", "Size", options = ["tiny", "small", "normal", "large", "huge", "auto"], group = "Watermark-Sub Title")
subTitleAlign                  = input.string("center","Alignment", options = ["center","left", "right"], group = "Watermark-Sub Title")
subTitleClr                    = input(color.new(color.black, 30), "Color", group = "Watermark-Sub Title")
infoStr                        = syminfo.ticker  + " | " + timeframe.period + (timeframe.isminutes ? "M" : na)
dateStr                        = str.tostring(dayofmonth(time_close)) + "/" + str.tostring(month(time_close)) + "/" + str.tostring(year(time_close))
infoClr                        = input(color.new(color.black, 30), "Color", group = "Watermark-Info")
infoSz                         = input.string("normal", "Size", options = ["tiny", "small", "normal", "large", "huge", "auto"], group = "Watermark-Info")

// -----------------------------
// TIME / DST HELPERS
// -----------------------------
isInSsn(string ssnTime, string ssnTZ = 'UTC') =>
    not na(time(timeframe.period, ssnTime, ssnTZ))

renderSession(Ssn ssn, bool inside, int border = 1, bool midLine = false) =>
    var float _prevHigh = high
    var float _prevLow = low
    var float _sHigh = na
    var float _sLow  = na
    var label _lbl = na
    var line _lowL = na
    var line _highL = na
    var line _midL = na
    var int _anchor = na
    var linefill _fill = na
    var box _box = na

    bool ssnStart = inside and not inside[1]

    if ssnStart
        _sHigh := high
        _sLow := low
        _anchor := time
        if ssnStyle == SsnStyles.boxStyle or ssn.id == lunchSsn.id
            _box := box.new(left = bar_index, top = high, right = bar_index + 1, bottom = low, border_width = border, bgcolor = ssn.bgColor, border_color = ssn.borderColor)
        else if ssnStyle == SsnStyles.levelStyle
            _lowL := line.new(x1 = bar_index, y1 = _sHigh, x2 = bar_index, y2 = _sHigh, color = color.new(ssn.bgColor, 0))
            _highL := line.new(x1 = bar_index, y1 = _sLow, x2 = bar_index, y2 = _sLow, color = color.new(ssn.bgColor, 0))
        if ssn.showLabel
            _lbl := label.new(_anchor, _sHigh, ssn.labelText, xloc = xloc.bar_time, color = _solidColor, textcolor = ssn.labelColor, size = str.tostring(ssn.labelSz))
        if midLine
            _midPos = _sHigh - (_sHigh - _sLow) / 2
            _midL := line.new(x1 = bar_index, y1 = _midPos, x2 = bar_index + 1, y2 = _midPos, color = asiaMidColor, width = sizeFromLStyle(asiaMidStyle), style = styleFromLStyle(asiaMidStyle))
    if inside
        _sHigh := math.max(_sHigh, high)
        _sLow := math.min(_sLow, low)
        if ssnStyle == SsnStyles.boxStyle or ssn.id == lunchSsn.id
            _box.set_top(_sHigh)
            _box.set_bottom(_sLow)
            _box.set_right(bar_index + 1)
        else if ssnStyle == SsnStyles.levelStyle
            _lowL.set_x2(bar_index + 1)
            _lowL.set_y1(_sLow)
            _lowL.set_y2(_sLow)
            _highL.set_x2(bar_index + 1)
            _highL.set_y1(_sHigh)
            _highL.set_y2(_sHigh)
        if ssn.showLabel
            label.set_x(_lbl, int(math.avg(_anchor, time)))
            label.set_y(_lbl, _sHigh)
        // Исправленный код:
        float _midPos = na  // Объявление переменной перед использованием
        if midLine
            _midPos := _sHigh - (_sHigh - _sLow) / 2 
            _midL.set_x2(bar_index + 1)
            _midL.set_y1(_midPos)
            _midL.set_y2(_midPos)
    ssn.sHigh := _sHigh
    ssn.sLow  := _sLow

var bool _winter = false
var bool _nyWinter = false

is_last_sun(m) =>
    _last = timestamp(year, m + 1, 0, 0, 0)
    _dow = dayofweek(_last)
    _off = _dow == dayofweek.sunday ? 0 : _dow
    _last - _off * 24 * 60 * 60 * 1000

is_second_sun(m) =>
    _first = timestamp(year, m, 1, 0, 0)
    _dow = dayofweek(_first)
    _off = _dow == dayofweek.sunday ? 0 : (dayofweek.sunday - _dow + 7) % 7
    _fs = _first + _off * 24 * 60 * 60 * 1000
    _fs + 7 * 24 * 60 * 60 * 1000

is_first_sun(m) =>
    _first = timestamp(year, m, 1, 0, 0)
    _dow = dayofweek(_first)
    _off = _dow == dayofweek.sunday ? 0 : (dayofweek.sunday - _dow + 7) % 7
    _first + _off * 24 * 60 * 60 * 1000

second_sun_mar = is_second_sun(3)
first_sun_nov   = is_first_sun(11)

in_dst_ny = (time >= second_sun_mar) and (time < first_sun_nov)

last_sun_mar = is_last_sun(3)
last_sun_oct = is_last_sun(10)

in_dst = (time >= last_sun_mar) and (time < last_sun_oct)

if not in_dst
    _winter := true
if in_dst
    _winter := false

if in_dst_ny
    _nyWinter := false
if not in_dst_ny
    _nyWinter := true

// -----------------------------
// SESSION TIMES (формируются строки)
// -----------------------------
asiaTimeStr      = asiaCustomOn ? asiaCustom : (ssnOverlap ? (_winter ? '1900-0300' : '1900-0300') : (_winter ? '1900-0300' : '1900-0200')) 
frankTimeStr     = frankCustomOn ? frankCustom : (_winter ? ('0300-0400') : ('0200-0300')) 
londonTimeStr    = londonCustomOn ? londonCustom : (ssnOverlap ? (_winter ? '0400-1200' : '0300-1100') : (_winter ? '0400-0900' : '0300-0800')) 
nyTimeStr        = nyCustomOn ? nyCustom : (_nyWinter ? '0900-1700' : '0800-1600')
lunchTimeStr     = lunchCustomOn ? lunchCustom : (_winter ? '0600-0800' : '0500-0700')

inAsia            = asiaEnabled and isInSsn(asiaTimeStr, asiaCustomOn ? ssnTZ : 'UTC-4')
inFrankfurt       = frankEnabled and isInSsn(frankTimeStr, frankCustomOn ? ssnTZ : 'UTC-4')
inLondon          = londonEnabled and isInSsn(londonTimeStr, londonCustomOn ? ssnTZ : 'UTC-4')
inNY              = nyEnabled and isInSsn(nyTimeStr, nyCustomOn ? ssnTZ : 'UTC-4')
inLunch           = lunchEnabled and isInSsn(lunchTimeStr, lunchCustomOn ? ssnTZ : 'UTC-4')

showSsn = timeframe.isintraday and ssnEnabled
if (not ssnShow4H) and timeframe.in_seconds() >= 14400
    showSsn := false

if showSsn
    if ssnStyle != SsnStyles.streamlined
        renderSession(asiaSsn, inAsia, 1, showAsiaMid and poolsEnabled)
        renderSession(frankSsn, inFrankfurt, 1, false)
 // harmless no-op to keep structure
        renderSession(londonSsn, inLondon, 1, false)
        renderSession(nySsn, inNY, 1, false)
    if ssnStyle != SsnStyles.fillStyle
        renderSession(lunchSsn, inLunch, 1, false)

// streamlined fills (accumulate hi/lo)
var float _st_hi = na
var float _st_lo = na
isStreamlined = showSsn and ssnStyle == SsnStyles.streamlined

if inAsia and isStreamlined
    if high > _st_hi or (inAsia and not inAsia[1])
        _st_hi := high
    if low < _st_lo or (inAsia and not inAsia[1])
        _st_lo := low

fill(plot(isStreamlined and inAsia ? _st_hi : na, color = asiaBg, editable = false, display = display.none), plot(isStreamlined and inAsia ? _st_lo : na, color = asiaBg, editable = false, display = display.none), asiaBg)

if inFrankfurt and isStreamlined
    if high > _st_hi or (inFrankfurt and not inFrankfurt[1])
        _st_hi := high
    if low < _st_lo or (inFrankfurt and not inFrankfurt[1])
        _st_lo := low

fill(plot(isStreamlined and inFrankfurt ? _st_hi : na, color = frankBg, editable = false, display = display.none), plot(isStreamlined and inFrankfurt ? _st_lo : na, color = frankBg, editable = false, display = display.none), frankBg)

if inLondon and isStreamlined
    if high > _st_hi or (inLondon and not inLondon[1])
        _st_hi := high
    if low < _st_lo or (inLondon and not inLondon[1])
        _st_lo := low

fill(plot(isStreamlined and inLondon ? _st_hi : na, color = londonBg, editable = false, display = display.none), plot(isStreamlined and inLondon ? _st_lo : na, color = londonBg, editable = false, display = display.none), londonBg)

if inNY and isStreamlined
    if high > _st_hi or (inNY and not inNY[1])
        _st_hi := high
    if low < _st_lo or (inNY and not inNY[1])
        _st_lo := low

fill(plot(isStreamlined and inNY ? _st_hi : close, color = nyBg, editable = false, display = display.none), plot(isStreamlined and inNY ? _st_lo : close, color = nyBg, editable = false, display = display.none), nyBg)

// background for sessions when style = fill
bgcolor(showSsn and asiaEnabled ? (ssnStyle == SsnStyles.fillStyle ? (inAsia ? asiaSsn.bgColor : na) : na) : na)
bgcolor(showSsn and frankEnabled ? (ssnStyle == SsnStyles.fillStyle ? (inFrankfurt ? frankSsn.bgColor : na) : na) : na)
bgcolor(showSsn and londonEnabled ? (ssnStyle == SsnStyles.fillStyle ? (inLondon ? londonSsn.bgColor : na) : na) : na)
bgcolor(showSsn and nyEnabled ? (ssnStyle == SsnStyles.fillStyle ? (inNY ? nySsn.bgColor : na) : na) : na)
bgcolor(showSsn and lunchEnabled ? (ssnStyle == SsnStyles.fillStyle ? (inLunch ? lunchSsn.bgColor : na) : na) : na)

// -----------------------------
// PREVIOUS TF LINES (рефакторинг имен)
// -----------------------------
method prevTFLevel(string tf, string lblPrefix, color lnClr, LStyle lnStyle, string extendTF, int timeExt) =>
    bool newPeriod = ta.change(time(tf)) != 0
    var line _hLine = na
    var line _lLine = na
    var label _hLbl = na
    var label _lLbl = na
    var float prevHigh = high
    var float prevLow  = low
    var int prevHighIdx = bar_index
    var int prevLowIdx  = bar_index
    var float dHigh = high
    var float dLow  = low
    var int dHighIdx = time('1')
    var int dLowIdx  = time('1')

    if (newPeriod)
        _hLbl.delete()
        _lLbl.delete()
        _hLine.delete()
        _lLine.delete()

        prevHigh := dHigh
        prevHighIdx := dHighIdx
        prevLow := dLow
        prevLowIdx := dLowIdx
        _hLine := line.new(x1 = dHighIdx, y1 = prevHigh, x2 = dHighIdx + timeExt, xloc = xloc.bar_time, y2 = prevHigh, color = lnClr, width = sizeFromLStyle(lnStyle), style = styleFromLStyle(lnStyle))
        _lLine := line.new(x1 = dLowIdx, y1 = prevLow, x2 = dLowIdx + timeExt, xloc = xloc.bar_time, y2 = prevLow, color = lnClr, width = sizeFromLStyle(lnStyle), style = styleFromLStyle(lnStyle))
        _hLbl := label.new(dHighIdx + timeExt, prevHigh, lblPrefix + "H", xloc = xloc.bar_time, color = _solidColor, textcolor = lnClr, style = label.style_none)
        _lLbl := label.new(dLowIdx + timeExt, prevLow, lblPrefix + "L", xloc = xloc.bar_time, color = _solidColor, textcolor = lnClr, style = label.style_none)
        dHigh := high
        dHighIdx := time('1')
        dLow := low
        dLowIdx := time('1')
    else
        if (high > dHigh)
            dHigh := high
            dHighIdx := time('1')
        if (low < dLow)
            dLow := low
            dLowIdx := time('1')
    _hLbl.set_x(time(extendTF))
    _lLbl.set_x(time(extendTF))
    _hLine.set_x2(time(extendTF))
    _lLine.set_x2(time(extendTF))
    
    if poolsExtend
        _hLbl.set_x(time + 14400000 * 2)
        _lLbl.set_x(time + 14400000 * 2)
        _hLine.set_x2(time + 14400000 * 2)
        _lLine.set_x2(time + 14400000 * 2)

// -----------------------------
// OPEN LINES (рефакторинг имен)
// -----------------------------
method renderOpenLine(int hr, string lbl, color lnClr, LStyle lnStyle, string extendTF, int timeExt, bool drawNew) =>
    currentH = hour(time, 'UTC-4') % 24

    var line _openLn = na
    var label _openLbl = na
    if (drawNew and currentH == hr and minute(time, 'UTC-4') == 0)
        _openLn.delete()
        _openLbl.delete()
        _openLn := line.new(x1=time('1'), y1=open, x2=time + timeExt, y2=open, xloc = xloc.bar_time, color=lnClr, width = sizeFromLStyle(lnStyle), style = styleFromLStyle(lnStyle)) 
        _openLbl := label.new(time('1') + timeExt, open, lbl, xloc = xloc.bar_time, color = _solidColor, textcolor = lnClr, size = "normal", style = label.style_none)       
    if poolsExtend
        _openLn.set_x2(time + 14400000 * 2)
        _openLbl.set_x(time + 14400000 * 2)

// -----------------------------
// APPLY PREVIOUS TF LINES & OPENS (поведение сохранено)
// -----------------------------
if poolsEnabled
    if prevDayShow and timeframe.in_seconds() < 86400
        prevTFLevel("D", "PD", prevDayColor, prevDayStyle, 'D', 0)
    if prevWeekShow and timeframe.in_seconds() >= 60 and timeframe.in_seconds() < 604800  
        prevTFLevel("W", "PW", prevWeekColor, prevWeekStyle, 'W', 0)
    if prevMonthShow and timeframe.in_seconds() >= 900 and timeframe.in_seconds() < 2.628e+6  
        prevTFLevel("M", "PM", prevMonthColor, prevMonthStyle, 'M', 0)

    // determine hour for open lines (keeps original logic)
    openHour = (ta.valuewhen(hour(time, "UTC-4") == 17 and minute(time, "UTC-4") == 0, true, 0) ? 17 : 18) + 1
    if showWO and timeframe.in_seconds() < 604800
        renderOpenLine(openHour, 'WO', woColor, woLineStyle, 'W', 14400000 * 6, dayofweek == dayofweek.friday or dayofweek == dayofweek.sunday)
    if showTrueWO
        renderOpenLine(0, 'TWO', trueWOColor, trueWOLineStyle, 'W', 14400000 * 6, dayofweek == dayofweek.monday or dayofweek == dayofweek.sunday)
    if showMO and timeframe.in_seconds() < 2.628e+6    
        renderOpenLine(openHour, 'MO', moColor, moLineStyle, 'M', 14400000 * 12, dayofmonth == 1)    
    if showTrueDO and timeframe.in_seconds() < 86400
        renderOpenLine(1, 'NYM', trueDOColor, trueDOLineStyle, '1', 14400000 * 6, true)
    if showDO and timeframe.in_seconds() < 86400    
        renderOpenLine(openHour, 'DO', doColor, doLineStyle, '1', 14400000 * 8, true)

// -----------------------------
// FRACTALS
// -----------------------------
_fractPeriods = 2
dnFr = if fractBars == "5"
    dn5 = (high[_fractPeriods-2] < high[_fractPeriods]) and (high[_fractPeriods-1] < high[_fractPeriods]) and (high[_fractPeriods+1] < high[_fractPeriods]) and (high[_fractPeriods+2] < high[_fractPeriods])
else
    if fractBars == "3"
        dn3 = (high[_fractPeriods-1] < high[_fractPeriods]) and (high[_fractPeriods+1] < high[_fractPeriods]) 

upFr = if fractBars == "5"
    up5 = (low[_fractPeriods-2] > low[_fractPeriods]) and (low[_fractPeriods-1] > low[_fractPeriods]) and (low[_fractPeriods+1] > low[_fractPeriods]) and (low[_fractPeriods+2] > low[_fractPeriods])
else
    if fractBars == "3"
        up3 = (low[_fractPeriods-1] > low[_fractPeriods]) and (low[_fractPeriods+1] > low[_fractPeriods]) 

plotshape(dnFr, style=shape.triangledown, location=location.abovebar,  offset=-2, color = fractalsOn ? fractUpClr : _solidColor, editable = false, display = display.pane)    
plotshape(upFr, style=shape.triangleup, location=location.belowbar,  offset=-2, color = fractalsOn ? fractDownClr : _solidColor, editable = false, display = display.pane)

// -----------------------------
// FAIR VALUE GAPS (сохранено поведение)
// -----------------------------
if fvgOn
    if low[2] <= open[1] and high[0] >= low[1] and low[2] - high[0] > 0
        box.new(left=bar_index[1], top=low[2], right=bar_index, bottom=high[0], bgcolor=fvgBearClr, border_color = _solidColor)
    if high[2] >= open[1] and low[0] <= high[1] and low[0] - high[2] > 0
        box.new(left=bar_index[1], top=high[2], right=bar_index, bottom=low[0], bgcolor=fvgBullClr, border_color = _solidColor)

// -----------------------------
// WATERMARK (сохранено)
// -----------------------------
if watermarkOn
    if waterTitleOn
        _txtTbl = table.new(titleVPos + "_" + titleHPos, 1, 3)
        table.cell(_txtTbl, 0, 0, titleTxt, 0, 0, titleClr, titleAlign, text_size = titleTxtSz, bgcolor = _solidColor)
        table.cell(_txtTbl, 0, 1, subTitleTxt, 0, 0, subTitleClr, subTitleAlign, text_size = subTitleSize, bgcolor = _solidColor)
    if waterInfoOn
        _infoTbl = table.new(infoVPos + "_" + infoHPos, 5, 5)
        table.cell(_infoTbl, 0, 1, infoStr, 0, 0, infoClr, 'center', text_size = infoSz, bgcolor = _solidColor)
        table.cell(_infoTbl,0, 0, dateStr, 0, 0, infoClr, 'center', text_size = infoSz, bgcolor = _solidColor)
