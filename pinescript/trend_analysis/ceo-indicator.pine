// London
londonEnabled                  = input.bool(true, 'Enabled', group='London Session')
londonCustomOn                 = input.bool(false, 'Custom Time', group='London Session', inline = 'customTime')
londonCustom                   = input.session('0300-1100:1234567', '', group='London Session', inline = 'customTime')
