showTrueDO                     = input.bool(defval = false, title = 'NYM      ', group = 'Pools', inline = 'openLines2')
trueDOColor                    = input.color(color.new(color.gray, 25), title = '', group = 'Pools', inline = 'openLines2')
trueDOLineStyle                = input.enum(defval = LStyle.solid1, title = '', group = 'Pools', inline = 'openLines2')

showWO                         = input.bool(defval = false, title = 'WO       ', group = 'Pools', inline = 'openLines3')
