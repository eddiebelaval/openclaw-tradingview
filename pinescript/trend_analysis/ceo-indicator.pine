// Frankfurt
frankEnabled                   = input.bool(true, 'Enabled', group='Frankfurt Session')
frankCustomOn                  = input.bool(false, 'Custom Time', group='Frankfurt Session', inline = 'customTime')
frankCustom                    = input.session('0200-0300:1234567', '', group='Frankfurt Session', inline = 'customTime')
