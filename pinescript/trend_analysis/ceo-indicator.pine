// Fractals & FVG
fractalsOn                     = input.bool(false, 'Enabled', group='Fractals', inline = 'show')
fractUpClr                     = input.color(color.new(color.black, 50), 'Up Color', group='Fractals')
fractDownClr                   = input.color(color.new(color.black, 50), 'Down Color', group='Fractals')
