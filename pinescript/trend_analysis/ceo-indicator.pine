// Sessions
ssnEnabled                     = input.bool(defval = true, group = 'Sessions', title = 'Enabled')
ssnTZ                          = input.string(defval = 'UTC-4', group = 'Sessions', title = 'Time Zone', tooltip = 'Specifies the time zone used for sessions with "Custom Time" enabled.')
