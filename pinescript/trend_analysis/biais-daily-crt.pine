//@version=5
indicator("Fibonacci Directionnel ICT", overlay=true, max_boxes_count=10, max_labels_count=10)

// --- PARAMÈTRES ---
show_fib = input.bool(true, "Afficher Fibonacci", group="Fibonacci")
fib_opacity = input.int(15, "Opacité arrière-plan (%)", minval=0, maxval=30, group="Fibonacci")

// --- BIAIS DAILY (CANDLE RANGE) ---
pdh = request.security(syminfo.tickerid, "D", high[1])
pdl = request.security(syminfo.tickerid, "D", low[1])
pdc = request.security(syminfo.tickerid, "D", close[1])

daily_range = pdh - pdl
daily_mid = pdl + (daily_range / 2)
bias_daily = pdc > daily_mid ? "HAUSSE" : pdc < daily_mid ? "BAISSE" : "NEUTRE"

// --- ÉLÉMENTS FIBONACCI ---
var box fib_background = na
var box ote_zone = na

var line fib_line_0 = na
var line fib_line_5 = na
var line fib_line_618 = na
var line fib_line_786 = na
var line fib_line_100 = na

var label fib_lbl_0 = na
var label fib_lbl_5 = na
var label fib_lbl_618 = na
var label fib_lbl_786 = na
var label fib_lbl_100 = na

// Réinitialisation quotidienne
if ta.change(time("D")) != 0
    // Nettoyage
    if not na(fib_background)
        box.delete(fib_background)
    if not na(ote_zone)
        box.delete(ote_zone)
    
    if not na(fib_line_0)
        line.delete(fib_line_0)
    if not na(fib_line_5)
        line.delete(fib_line_5)
    if not na(fib_line_618)
        line.delete(fib_line_618)
    if not na(fib_line_786)
        line.delete(fib_line_786)
    if not na(fib_line_100)
        line.delete(fib_line_100)
    
    if not na(fib_lbl_0)
        label.delete(fib_lbl_0)
    if not na(fib_lbl_5)
        label.delete(fib_lbl_5)
    if not na(fib_lbl_618)
        label.delete(fib_lbl_618)
    if not na(fib_lbl_786)
        label.delete(fib_lbl_786)
    if not na(fib_lbl_100)
        label.delete(fib_lbl_100)
    
    if show_fib
        if bias_daily == "HAUSSE"
            // FIBONACCI HAUSSIER : 0.0 = PDH, 1.0 = PDL
            float fib_high = pdh
            float fib_low = pdl
            float fib_range = fib_high - fib_low
            
            fib_background := box.new(
                 left=time,
                 top=fib_high,
                 right=time + 86400000 * 7,
                 bottom=fib_low,
                 bgcolor=color.new(color.gray, 100 - fib_opacity),
                 border_width=0,
                 xloc=xloc.bar_time
             )
            
            // Zone OTE verte (61.8% - 78.6% depuis le haut)
            ote_zone := box.new(
                 left=time,
                 top=fib_high - fib_range * 0.618,
                 right=time + 86400000 * 7,
                 bottom=fib_high - fib_range * 0.786,
                 bgcolor=color.new(color.green, 30),
                 border_color=color.green,
                 border_width=2,
                 xloc=xloc.bar_time
             )
            
            // Lignes et labels
            fib_line_0 := line.new(x1=time, y1=fib_high, x2=time + 86400000 * 7, y2=fib_high, color=color.gray, width=1, style=line.style_dashed, xloc=xloc.bar_time)
            fib_line_5 := line.new(x1=time, y1=fib_high - fib_range * 0.5, x2=time + 86400000 * 7, y2=fib_high - fib_range * 0.5, color=color.gray, width=1, style=line.style_dashed, xloc=xloc.bar_time)
            fib_line_618 := line.new(x1=time, y1=fib_high - fib_range * 0.618, x2=time + 86400000 * 7, y2=fib_high - fib_range * 0.618, color=color.gray, width=1, style=line.style_dashed, xloc=xloc.bar_time)
            fib_line_786 := line.new(x1=time, y1=fib_high - fib_range * 0.786, x2=time + 86400000 * 7, y2=fib_high - fib_range * 0.786, color=color.gray, width=1, style=line.style_dashed, xloc=xloc.bar_time)
            fib_line_100 := line.new(x1=time, y1=fib_low, x2=time + 86400000 * 7, y2=fib_low, color=color.gray, width=1, style=line.style_dashed, xloc=xloc.bar_time)
            
            fib_lbl_0 := label.new(x=time + 86400000 * 7, y=fib_high, text="0.0", style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.normal, xloc=xloc.bar_time)
            fib_lbl_5 := label.new(x=time + 86400000 * 7, y=fib_high - fib_range * 0.5, text="0.5", style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.normal, xloc=xloc.bar_time)
            fib_lbl_618 := label.new(x=time + 86400000 * 7, y=fib_high - fib_range * 0.618, text="0.618", style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.normal, xloc=xloc.bar_time)
            fib_lbl_786 := label.new(x=time + 86400000 * 7, y=fib_high - fib_range * 0.786, text="0.786", style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.normal, xloc=xloc.bar_time)
            fib_lbl_100 := label.new(x=time + 86400000 * 7, y=fib_low, text="1.0", style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.normal, xloc=xloc.bar_time)
        
        else if bias_daily == "BAISSE"
            // FIBONACCI BAISSIER : 0.0 = PDL, 1.0 = PDH (INVERSÉ)
            float fib_high = pdh
            float fib_low = pdl
            float fib_range = fib_high - fib_low
            
            fib_background := box.new(
                 left=time,
                 top=fib_high,
                 right=time + 86400000 * 7,
                 bottom=fib_low,
                 bgcolor=color.new(color.gray, 100 - fib_opacity),
                 border_width=0,
                 xloc=xloc.bar_time
             )
            
            // Zone OTE rouge (61.8% - 78.6% depuis le BAS)
            ote_zone := box.new(
                 left=time,
                 top=fib_low + fib_range * 0.786,
                 right=time + 86400000 * 7,
                 bottom=fib_low + fib_range * 0.618,
                 bgcolor=color.new(color.red, 30),
                 border_color=color.red,
                 border_width=2,
                 xloc=xloc.bar_time
             )
            
            // Lignes et labels INVERSÉS
            fib_line_0 := line.new(x1=time, y1=fib_low, x2=time + 86400000 * 7, y2=fib_low, color=color.gray, width=1, style=line.style_dashed, xloc=xloc.bar_time)
            fib_line_5 := line.new(x1=time, y1=fib_low + fib_range * 0.5, x2=time + 86400000 * 7, y2=fib_low + fib_range * 0.5, color=color.gray, width=1, style=line.style_dashed, xloc=xloc.bar_time)
            fib_line_618 := line.new(x1=time, y1=fib_low + fib_range * 0.618, x2=time + 86400000 * 7, y2=fib_low + fib_range * 0.618, color=color.gray, width=1, style=line.style_dashed, xloc=xloc.bar_time)
            fib_line_786 := line.new(x1=time, y1=fib_low + fib_range * 0.786, x2=time + 86400000 * 7, y2=fib_low + fib_range * 0.786, color=color.gray, width=1, style=line.style_dashed, xloc=xloc.bar_time)
            fib_line_100 := line.new(x1=time, y1=fib_high, x2=time + 86400000 * 7, y2=fib_high, color=color.gray, width=1, style=line.style_dashed, xloc=xloc.bar_time)
            
            fib_lbl_0 := label.new(x=time + 86400000 * 7, y=fib_low, text="0.0", style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.normal, xloc=xloc.bar_time)
            fib_lbl_5 := label.new(x=time + 86400000 * 7, y=fib_low + fib_range * 0.5, text="0.5", style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.normal, xloc=xloc.bar_time)
            fib_lbl_618 := label.new(x=time + 86400000 * 7, y=fib_low + fib_range * 0.618, text="0.618", style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.normal, xloc=xloc.bar_time)
            fib_lbl_786 := label.new(x=time + 86400000 * 7, y=fib_low + fib_range * 0.786, text="0.786", style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.normal, xloc=xloc.bar_time)
            fib_lbl_100 := label.new(x=time + 86400000 * 7, y=fib_high, text="1.0", style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.normal, xloc=xloc.bar_time)

// --- TABLEAU BIAIS ---
var table bias_table = table.new(position.top_right, 1, 2, bgcolor=color.new(color.black, 80), border_width=2)
if barstate.islast
    bias_text = bias_daily == "HAUSSE" ? "🟢 LONG" : bias_daily == "BAISSE" ? "🔴 SHORT" : "⚪ NEUTRE"
    bias_bg = bias_daily == "HAUSSE" ? color.green : bias_daily == "BAISSE" ? color.red : color.gray
    table.cell(bias_table, 0, 0, "BIAIS DAILY", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(bias_table, 0, 1, bias_text, bgcolor=bias_bg, text_color=color.white, text_size=size.huge)

// --- ALERTES ---
alertcondition(bias_daily != bias_daily[1], title="Changement Biais Daily", message="🔄 Biais Daily mis à jour")
