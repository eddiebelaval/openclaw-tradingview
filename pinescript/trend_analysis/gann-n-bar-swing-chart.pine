// This Pine Script™ source is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("Gann N-Bar Swing Chart", overlay=true, max_lines_count=500, max_labels_count=500)

// === Inputs ===
swingN    = input.int(1, "Swing N", minval=1, maxval=20, tooltip="Consecutive opposing bars to confirm reversal\n1 = minor swings\n2 = intermediate\n3 = major trend")
showLine  = input.bool(true, "Show Swing Line")
showLabel = input.bool(true, "Show Turn Labels")
colorBar  = input.bool(true, "Color Bars by Direction")
upCol     = input.color(#26a69a, "Up Color")
dnCol     = input.color(#ef5350, "Down Color")
lineW     = input.int(2, "Swing Line Width", minval=1, maxval=5)

// === State ===
var float pH      = na    // prev non-inside high
var float pL      = na    // prev non-inside low
var int   dir     = 0     // 1=UP, -1=DOWN
var int   revCnt  = 0
var int   extBar  = 0
var float extVal  = 0.0
var int   tBar    = na
var float tVal    = na
var line  actLine = na

if na(pH)
    // First bar — seed prev high/low, nothing to classify yet
    pH := high
    pL := low
else
    // === Classify bar vs prev non-inside bar ===
    bool hh = high > pH
    bool lh = high < pH
    bool hl = low  > pL
    bool ll = low  < pL

    // bc: 1=UP, -1=DOWN, 0=INSIDE, 2=OUTSIDE
    int bc = 0
    if hh and hl
        bc := 1
    else if lh and ll
        bc := -1
    else if lh and hl
        bc := 0      // INSIDE
    else if hh and ll
        bc := 2      // OUTSIDE
    else if hh or (high == pH and hl)
        bc := 1
    else if ll or (high == pH and ll) or lh
        bc := -1
    // else 0 = inside

    bool isInside = bc == 0

    // Outside bars continue current direction
    int eff = bc == 2 ? dir : bc

    if not isInside and eff != 0
        if dir == 0
            // Initialize direction
            dir    := eff
            extBar := bar_index
            extVal := eff == 1 ? high : low
        else
            if eff == dir
                // Continues swing
                revCnt := 0
                if dir == 1 and high > extVal
                    extVal := high
                    extBar := bar_index
                if dir == -1 and low < extVal
                    extVal := low
                    extBar := bar_index
            else
                // Opposes swing
                revCnt += 1
                if revCnt >= swingN
                    // --- Turn confirmed at extBar ---
                    if showLine and not na(tBar)
                        line.new(tBar, tVal, extBar, extVal,
                             color=(dir == 1 ? upCol : dnCol), width=lineW)
                    if showLabel
                        if dir == 1
                            label.new(extBar, extVal, "H",
                                 style=label.style_label_down,
                                 color=dnCol, textcolor=color.white, size=size.tiny)
                        else
                            label.new(extBar, extVal, "L",
                                 style=label.style_label_up,
                                 color=upCol, textcolor=color.white, size=size.tiny)
                    tBar   := extBar
                    tVal   := extVal
                    dir    := -dir
                    revCnt := 0
                    extBar := bar_index
                    extVal := dir == 1 ? high : low

        // Update prev for all non-inside bars
        pH := high
        pL := low

// === Active swing line (dashed) ===
if showLine and not na(tBar)
    if not na(actLine)
        line.delete(actLine)
    actLine := line.new(tBar, tVal, extBar, extVal,
                 color=(dir == 1 ? upCol : dnCol), width=lineW, style=line.style_dashed)

// === Bar coloring ===
barcolor(colorBar ? (dir == 1 ? upCol : dir == -1 ? dnCol : na) : na)
