//@version=5
indicator("ATR Dow Theory (Modular) [Coding Partner]", shorttitle="Dow Modular", overlay=true, max_labels_count=500, max_lines_count=500)

// =========================================================================
// 1. DOW THEORY INPUTS (Dynamic ATR Scale)
// =========================================================================
grp_atr = "Tenet 2: Trend Scale (ATR Multipliers)"
atr_len  = input.int(10, title="ATR Length", group=grp_atr)
min_mult = input.float(1.5, title="Minor () ATR Multiplier", step=0.5, group=grp_atr)
sec_mult = input.float(4.0, title="Secondary {} ATR Multiplier", step=0.5, group=grp_atr)
pri_mult = input.float(10.0, title="Primary [] ATR Multiplier", step=1.0, group=grp_atr)

// =========================================================================
// 2. VISIBILITY TOGGLES & CUSTOM COLORS
// =========================================================================
grp_vis = "Visibility Toggles"
show_pri = input.bool(true, title="Show Primary [] Trend", group=grp_vis)
show_sec = input.bool(true, title="Show Secondary {} Trend", group=grp_vis)
show_min = input.bool(true, title="Show Minor () Trend", group=grp_vis)
show_bar = input.bool(true, title="Color Candles (Based on Primary)", group=grp_vis)

grp_col_pri = "Primary [] Colors"
c_pri_bull = input.color(color.lime, title="Primary Bull", group=grp_col_pri)
c_pri_bear = input.color(color.red, title="Primary Bear", group=grp_col_pri)

grp_col_sec = "Secondary {} Colors"
c_sec_bull = input.color(color.aqua, title="Secondary Bull", group=grp_col_sec)
c_sec_bear = input.color(color.fuchsia, title="Secondary Bear", group=grp_col_sec)

grp_col_min = "Minor () Colors"
c_min_bull = input.color(color.yellow, title="Minor Bull", group=grp_col_min)
c_min_bear = input.color(color.orange, title="Minor Bear", group=grp_col_min)

current_atr = ta.atr(atr_len)

// =========================================================================
// 3. OBJECT-ORIENTED DOW ENGINE (With Visibility Checks)
// =========================================================================
type DowEngine
    float atr_mult
    int dir
    float ext_p
    int ext_b
    float last_ph
    int last_ph_b
    float last_pl
    int last_pl_b
    float defense_line
    int def_line_bar
    int trend
    string p_open
    string p_close
    string prefix // 'P', 'S', or 'M'
    color col_bull
    color col_bear
    int line_width

method process(DowEngine e, float c_price, float c_atr, bool show_vis) =>
    
    // --- TENET 6: TREND BREAK DETECTION ---
    
    // Bearish Break
    if e.trend == 1 and not na(e.defense_line) and c_price < e.defense_line
        e.trend := -1
        
        if show_vis
            string acronym = e.prefix + "BES"
            line.new(math.max(0, bar_index - 5), e.defense_line, bar_index + 10, e.defense_line, color=e.col_bear, width=2, style=line.style_solid)
            label.new(bar_index + 2, e.defense_line, acronym, color=color.new(e.col_bear, 50), textcolor=color.white, style=label.style_label_down, size=size.small)
        
        e.defense_line := float(na) 
        
    // Bullish Break
    else if e.trend == -1 and not na(e.defense_line) and c_price > e.defense_line
        e.trend := 1
        
        if show_vis
            string acronym = e.prefix + "BUS" 
            line.new(math.max(0, bar_index - 5), e.defense_line, bar_index + 10, e.defense_line, color=e.col_bull, width=2, style=line.style_solid)
            label.new(bar_index + 2, e.defense_line, acronym, color=color.new(e.col_bull, 50), textcolor=color.white, style=label.style_label_up, size=size.small)
        
        e.defense_line := float(na)

    // --- STRUCTURAL PRICE SWING DETECTION (ATR Based) ---
    if e.dir == 1 // Hunting a Peak
        if c_price > e.ext_p
            e.ext_p := c_price
            e.ext_b := bar_index
        else if c_price < e.ext_p - (e.atr_mult * c_atr) 
            string lbl = ""
            color lbl_col = e.col_bull
            
            if na(e.last_ph) or e.ext_p > e.last_ph
                lbl := "HH"
                lbl_col := e.col_bull
            else
                lbl := "LH"
                lbl_col := e.col_bear
                e.defense_line := e.ext_p 
                e.def_line_bar := e.ext_b
            
            if show_vis
                label.new(e.ext_b, e.ext_p, e.p_open + lbl + e.p_close, color=color.new(lbl_col, 80), textcolor=lbl_col, style=label.style_label_down, size=size.small)
                if not na(e.last_pl)
                    color line_col = e.trend == 1 ? e.col_bull : e.col_bear
                    line.new(e.last_pl_b, e.last_pl, e.ext_b, e.ext_p, color=color.new(line_col, 50), style=line.style_dotted, width=1)

            e.last_ph := e.ext_p
            e.last_ph_b := e.ext_b
            e.dir := -1
            e.ext_p := c_price
            e.ext_b := bar_index

    else // Hunting a Trough
        if c_price < e.ext_p
            e.ext_p := c_price
            e.ext_b := bar_index
        else if c_price > e.ext_p + (e.atr_mult * c_atr) 
            string lbl = ""
            color lbl_col = e.col_bear
            
            if na(e.last_pl) or e.ext_p > e.last_pl
                lbl := "HL"
                lbl_col := e.col_bull
                e.defense_line := e.ext_p 
                e.def_line_bar := e.ext_b
            else
                lbl := "LL"
                lbl_col := e.col_bear
            
            if show_vis
                label.new(e.ext_b, e.ext_p, e.p_open + lbl + e.p_close, color=color.new(lbl_col, 80), textcolor=lbl_col, style=label.style_label_up, size=size.small)
                if not na(e.last_ph)
                    color line_col = e.trend == 1 ? e.col_bull : e.col_bear
                    line.new(e.last_ph_b, e.last_ph, e.ext_b, e.ext_p, color=color.new(line_col, 50), style=line.style_dotted, width=1)

            e.last_pl := e.ext_p
            e.last_pl_b := e.ext_b
            e.dir := 1
            e.ext_p := c_price
            e.ext_b := bar_index

// =========================================================================
// 4. INITIALIZE ENGINES & EXECUTE
// =========================================================================
var minor_eng = DowEngine.new(min_mult, 1, close, bar_index, float(na), int(na), float(na), int(na), float(na), int(na), 1, "(", ")", "M", c_min_bull, c_min_bear, 1)
var sec_eng   = DowEngine.new(sec_mult, 1, close, bar_index, float(na), int(na), float(na), int(na), float(na), int(na), 1, "{", "}", "S", c_sec_bull, c_sec_bear, 2)
var pri_eng   = DowEngine.new(pri_mult, 1, close, bar_index, float(na), int(na), float(na), int(na), float(na), int(na), 1, "[", "]", "P", c_pri_bull, c_pri_bear, 4)

// Run the engines and pass the visibility booleans
minor_eng.process(close, current_atr, show_min)
sec_eng.process(close, current_atr, show_sec)
pri_eng.process(close, current_atr, show_pri)

// Color Candles based on Primary Trend (If Toggled On)
barcolor(show_bar ? (pri_eng.trend == 1 ? c_pri_bull : c_pri_bear) : na, title="Primary Trend Bar Color")
