color gannBearTarget   = input.color(color.new(#ff1744, 40), "Bear Target Line", group=gGann, inline="gc")
float gannCongTol      = input.float(2.0, "Congestion Tolerance (boxes)", minval=0.5, maxval=10.0, step=0.5, group=gGann,
     tooltip="How close column extremes must be to count as part of the same congestion zone")
bool  gannShowCongBox  = input.bool(true, "Show Congestion Zone Box", group=gGann,
     tooltip="Shades the congestion area — the battlefield where supply and demand are fighting.\nThe breakout from this zone IS the trade.")
color gannCongColor    = input.color(color.new(#ffeb3b, 85), "Congestion Zone Color", group=gGann)

