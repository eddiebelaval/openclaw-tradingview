// ═════════════════════════════════════════════════════════════════════════════
// ██  HELPER FUNCTIONS
// ═════════════════════════════════════════════════════════════════════════════
f_round_to_tick(float x) =>
    float mt = syminfo.mintick
    mt > 0 ? math.round(x / mt) * mt : x

f_absCorr(float x) =>
    na(x) ? -1.0 : math.abs(x)

f_labelSize(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.normal

f_clamp_int(int v, int lo, int hi) =>
    v < lo ? lo : v > hi ? hi : v

f_row_to_y(int rowShown, int rowsTotal, float zBot, float zTop) =>
    float r = math.max(float(rowsTotal), 1.0)
    zTop - (float(rowShown) + 0.5) * (zTop - zBot) / r

f_pnf_step_ext(float boxIn, int rev, bool useHL, int dirIn, float topIn, float botIn, float ancIn, float hiCandle, float loCandle, float clCandle) =>
    float b  = math.max(boxIn, syminfo.mintick)
    float hi = useHL ? hiCandle : clCandle
    float lo = useHL ? loCandle : clCandle
    float c  = clCandle
    int   dir = dirIn
    float top = topIn
    float bot = botIn
    float anc = ancIn
    if na(anc)
        anc := f_round_to_tick(c)
        top := anc
        bot := anc
        dir := 0
    if dir == 0
        if hi >= anc + b
            dir := 1
            bot := anc
            top := anc + math.floor((hi - anc) / b) * b
        else if lo <= anc - b
            dir := -1
            top := anc
            bot := anc - math.floor((anc - lo) / b) * b
    else if dir == 1
        if hi >= top + b
            top += math.floor((hi - top) / b) * b
        if lo <= top - float(rev) * b
            dir := -1
            top := top - b
            bot := top - math.floor((top - lo) / b) * b
    else
        if lo <= bot - b
            bot -= math.floor((bot - lo) / b) * b
        if hi >= bot + float(rev) * b
            dir := 1
            bot := bot + b
            top := bot + math.floor((hi - bot) / b) * b
    float pClose = dir == 1 ? top : dir == -1 ? bot : anc
    [pClose, dir, top, bot, anc]

f_pnf_step(float boxIn, int rev, bool useHL, int dirIn, float topIn, float botIn, float ancIn) =>
    f_pnf_step_ext(boxIn, rev, useHL, dirIn, topIn, botIn, ancIn, high, low, close)

f_time_to_bar(int t) =>
    bool cross = (time >= t) and (time[1] < t)
    ta.valuewhen(cross, bar_index, 0)

f_vwGlyphSize(float vol, float minVol, float maxVol) =>
    float rng = math.max(maxVol - minVol, 1.0)
    float pct = (vol - minVol) / rng
    pct > 0.8 ? size.huge : pct > 0.6 ? size.large : pct > 0.35 ? size.normal : pct > 0.15 ? size.small : size.tiny

f_detect_session(int hhmm, int asiaS, int asiaE, int lonS, int lonE, int rthS, int rthE) =>
    bool inAsia = asiaS > asiaE ? (hhmm >= asiaS or hhmm < asiaE) : (hhmm >= asiaS and hhmm < asiaE)
    bool inLon  = lonS > lonE ? (hhmm >= lonS or hhmm < lonE) : (hhmm >= lonS and hhmm < lonE)
    bool inRth  = rthS > rthE ? (hhmm >= rthS or hhmm < rthE) : (hhmm >= rthS and hhmm < rthE)
    inRth ? 3 : inLon ? 2 : inAsia ? 1 : 0

f_sessName(int sid) =>
    sid == 1 ? "Asia" : sid == 2 ? "London" : sid == 3 ? "RTH" : "Overnight"

f_zoneStr(float oscVal, float ob, float os) =>
    oscVal >= ob ? "OVERBOUGHT" : oscVal <= os ? "OVERSOLD" : "NEUTRAL"

f_pctStr(float v) =>
    str.tostring(v, "#.#") + "%"

f_priceStr(float v) =>
    str.tostring(v, "#.##")

// ═════════════════════════════════════════════════════════════════════════════
// ██  CONSTANTS & CORE CALCULATIONS
// ═════════════════════════════════════════════════════════════════════════════
int WIN_BARS_CAP = 200
int PNF_SCAN_DEPTH = 500
int winBars = math.min(winBarsInput, WIN_BARS_CAP)
bool use2BarSpacing = candleSpacing == "2-Bar (Centered Wick)"
int barMultiplierHA = use2BarSpacing ? 2 : 1
int barMultiplierWin = usePnF ? pnfColSpace : barMultiplierHA

string ha_ticker = ticker.heikinashi(syminfo.tickerid)
[ha_open, ha_high, ha_low, ha_close] =
     request.security(ha_ticker, timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)

// ═════════════════════════════════════════════════════════════════════════════
// ██  PnF AUTO ATR CORRELATION ENGINE
// ═════════════════════════════════════════════════════════════════════════════
float atr1 = ta.atr(pnfAtr1)
float atr2 = ta.atr(pnfAtr2)
float atr3 = ta.atr(pnfAtr3)
float atr4 = ta.atr(pnfAtr4)
float atr5 = ta.atr(pnfAtr5)

float box1 = f_round_to_tick(atr1)
float box2 = f_round_to_tick(atr2)
float box3 = f_round_to_tick(atr3)
float box4 = f_round_to_tick(atr4)
float box5 = f_round_to_tick(atr5)

var int dir1 = 0
var int dir2 = 0
var int dir3 = 0
var int dir4 = 0
var int dir5 = 0
var float top1 = na
var float top2 = na
var float top3 = na
var float top4 = na
var float top5 = na
var float bot1 = na
var float bot2 = na
var float bot3 = na
var float bot4 = na
var float bot5 = na
var float anc1 = na
var float anc2 = na
var float anc3 = na
var float anc4 = na
var float anc5 = na
float p1 = na
float p2 = na
float p3 = na
float p4 = na
float p5 = na

[_p1, _d1, _t1, _b1, _a1] = f_pnf_step(box1, pnfReversal, pnfUseHighLow, dir1, top1, bot1, anc1)
p1 := _p1, dir1 := _d1, top1 := _t1, bot1 := _b1, anc1 := _a1
[_p2, _d2, _t2, _b2, _a2] = f_pnf_step(box2, pnfReversal, pnfUseHighLow, dir2, top2, bot2, anc2)
p2 := _p2, dir2 := _d2, top2 := _t2, bot2 := _b2, anc2 := _a2
[_p3, _d3, _t3, _b3, _a3] = f_pnf_step(box3, pnfReversal, pnfUseHighLow, dir3, top3, bot3, anc3)
p3 := _p3, dir3 := _d3, top3 := _t3, bot3 := _b3, anc3 := _a3
[_p4, _d4, _t4, _b4, _a4] = f_pnf_step(box4, pnfReversal, pnfUseHighLow, dir4, top4, bot4, anc4)
p4 := _p4, dir4 := _d4, top4 := _t4, bot4 := _b4, anc4 := _a4
[_p5, _d5, _t5, _b5, _a5] = f_pnf_step(box5, pnfReversal, pnfUseHighLow, dir5, top5, bot5, anc5)
p5 := _p5, dir5 := _d5, top5 := _t5, bot5 := _b5, anc5 := _a5

float c1 = ta.correlation(close, p1, pnfCorrLookback)
float c2 = ta.correlation(close, p2, pnfCorrLookback)
float c3 = ta.correlation(close, p3, pnfCorrLookback)
float c4 = ta.correlation(close, p4, pnfCorrLookback)
float c5 = ta.correlation(close, p5, pnfCorrLookback)

int bestIdx = 1
float bestAbs = f_absCorr(c1)
if f_absCorr(c2) > bestAbs
    bestIdx := 2, bestAbs := f_absCorr(c2)
if f_absCorr(c3) > bestAbs
    bestIdx := 3, bestAbs := f_absCorr(c3)
if f_absCorr(c4) > bestAbs
    bestIdx := 4, bestAbs := f_absCorr(c4)
if f_absCorr(c5) > bestAbs
    bestIdx := 5, bestAbs := f_absCorr(c5)

float pnf_close = bestIdx == 1 ? p1 : bestIdx == 2 ? p2 : bestIdx == 3 ? p3 : bestIdx == 4 ? p4 : p5
int   pnf_dir   = bestIdx == 1 ? dir1 : bestIdx == 2 ? dir2 : bestIdx == 3 ? dir3 : bestIdx == 4 ? dir4 : dir5
float pnf_top   = bestIdx == 1 ? top1 : bestIdx == 2 ? top2 : bestIdx == 3 ? top3 : bestIdx == 4 ? top4 : top5
float pnf_bot   = bestIdx == 1 ? bot1 : bestIdx == 2 ? bot2 : bestIdx == 3 ? bot3 : bestIdx == 4 ? bot4 : bot5
float pnf_corr  = bestIdx == 1 ? c1 : bestIdx == 2 ? c2 : bestIdx == 3 ? c3 : bestIdx == 4 ? c4 : c5
int pnfAtrChosen = bestIdx == 1 ? pnfAtr1 : bestIdx == 2 ? pnfAtr2 : bestIdx == 3 ? pnfAtr3 : bestIdx == 4 ? pnfAtr4 : pnfAtr5

max_bars_back(pnf_dir,   PNF_SCAN_DEPTH)
max_bars_back(pnf_top,   PNF_SCAN_DEPTH)
max_bars_back(pnf_bot,   PNF_SCAN_DEPTH)
max_bars_back(pnf_close, PNF_SCAN_DEPTH)
max_bars_back(volume,    PNF_SCAN_DEPTH)

var float pnfBoxEst = na
var int   _pnfLastBest = na
float _dStep = usePnF ? f_round_to_tick(math.abs(pnf_close - pnf_close[1])) : na
if usePnF
    if na(_pnfLastBest) or bestIdx != _pnfLastBest
        _pnfLastBest := bestIdx
        pnfBoxEst := na
    if not na(_dStep) and _dStep > 0
        pnfBoxEst := na(pnfBoxEst) ? _dStep : math.min(pnfBoxEst, _dStep)

float _atrFallback = f_round_to_tick(
     bestIdx == 1 ? atr1 : bestIdx == 2 ? atr2 : bestIdx == 3 ? atr3 : bestIdx == 4 ? atr4 : atr5)
float pnfBoxSize = usePnF ? (na(pnfBoxEst) ? _atrFallback : pnfBoxEst) : na
pnfBoxSize := usePnF ? math.max(pnfBoxSize, syminfo.mintick) : na

// ═════════════════════════════════════════════════════════════════════════════
// ██  COLUMN REVERSAL DETECTION + ALERTS
// ═════════════════════════════════════════════════════════════════════════════
int prevPnfDir = nz(pnf_dir[1], 0)
bool pnfReversalToX = raEnabled and usePnF and (prevPnfDir == -1 or prevPnfDir == 0) and pnf_dir == 1
bool pnfReversalToO = raEnabled and usePnF and (prevPnfDir == 1  or prevPnfDir == 0) and pnf_dir == -1
alertcondition(pnfReversalToX, title="PnF Reversal → X (Bullish)", message="PnF column reversed to X (Bullish) on {{ticker}} {{interval}}")
alertcondition(pnfReversalToO, title="PnF Reversal → O (Bearish)", message="PnF column reversed to O (Bearish) on {{ticker}} {{interval}}")

// ═════════════════════════════════════════════════════════════════════════════
// ██  MTF PnF DIRECTION
// ═════════════════════════════════════════════════════════════════════════════
[mtf_h, mtf_l, mtf_c] = request.security(syminfo.tickerid, mtfTimeframe, [high, low, close], lookahead=barmerge.lookahead_off)
float mtf_atr_val = request.security(syminfo.tickerid, mtfTimeframe, ta.atr(mtfAtrPeriod), lookahead=barmerge.lookahead_off)
var int   mtfPDir = 0
var float mtfPTop = na
var float mtfPBot = na
var float mtfPAnc = na
bool mtfNewBar = ta.change(time(mtfTimeframe)) != 0
if mtfEnabled and mtfNewBar and not na(mtf_h) and not na(mtf_atr_val)
    float mtfBox = f_round_to_tick(math.max(mtf_atr_val, syminfo.mintick))
    [_, _md, _mt, _mb, _ma] = f_pnf_step_ext(mtfBox, mtfReversal, true, mtfPDir, mtfPTop, mtfPBot, mtfPAnc, mtf_h, mtf_l, mtf_c)
    mtfPDir := _md, mtfPTop := _mt, mtfPBot := _mb, mtfPAnc := _ma

// ═════════════════════════════════════════════════════════════════════════════
// ██  LTF PnF DIRECTION
// ═════════════════════════════════════════════════════════════════════════════
[ltf_h, ltf_l, ltf_c] = request.security(syminfo.tickerid, ltfTimeframe, [high, low, close], lookahead=barmerge.lookahead_off)
float ltf_atr_val = request.security(syminfo.tickerid, ltfTimeframe, ta.atr(ltfAtrPeriod), lookahead=barmerge.lookahead_off)
var int   ltfPDir = 0
var float ltfPTop = na
var float ltfPBot = na
var float ltfPAnc = na
bool ltfNewBar = ta.change(time(ltfTimeframe)) != 0
if ltfEnabled and ltfNewBar and not na(ltf_h) and not na(ltf_atr_val)
    float ltfBox = f_round_to_tick(math.max(ltf_atr_val, syminfo.mintick))
    [_, _ld, _lt, _lb, _la] = f_pnf_step_ext(ltfBox, ltfReversal, true, ltfPDir, ltfPTop, ltfPBot, ltfPAnc, ltf_h, ltf_l, ltf_c)
    ltfPDir := _ld, ltfPTop := _lt, ltfPBot := _lb, ltfPAnc := _la

// ═════════════════════════════════════════════════════════════════════════════
// ██  OSCILLATOR MAPPING (HA-BASED)
// ═════════════════════════════════════════════════════════════════════════════
float highestHaInRange = ta.highest(ha_high, oscLookback)
float lowestHaInRange  = ta.lowest(ha_low, oscLookback)
float haRange          = highestHaInRange - lowestHaInRange
haRange := haRange == 0 ? 1 : haRange

f_normalizeAndScale(float price, float minv, float pRange) =>
    ((price - minv) / pRange) * (maxLevel - minLevel) + minLevel

float osc_open  = f_normalizeAndScale(ha_open,  lowestHaInRange, haRange)
float osc_high  = f_normalizeAndScale(ha_high,  lowestHaInRange, haRange)
float osc_low   = f_normalizeAndScale(ha_low,   lowestHaInRange, haRange)
float osc_close = f_normalizeAndScale(ha_close, lowestHaInRange, haRange)

// HA EMA Overlay
float oscEma = ta.ema(osc_close, emaPeriod)

float volumeRoc       = ta.roc(volume, vrocLength)
bool  isVrocSpike     = (volumeRoc > vrocThreshold)
bool  isVrocBuySpike  = isVrocSpike and (ha_close > ha_open)
bool  isVrocSellSpike = isVrocSpike and (ha_close < ha_open)

color final_ha_color =
     isVrocBuySpike  ? vrocBuyHighlightColor :
     isVrocSellSpike ? vrocSellHighlightColor :
     (ha_close >= ha_open ? bullCandleColor : bearCandleColor)

float bar_top_y = scalperBarPosition == "Above" ? maxLevel : minLevel + scalperBarThickness
float bar_bot_y = scalperBarPosition == "Above" ? maxLevel - scalperBarThickness : minLevel

bool isHaUp     = ha_close >= ha_open
bool buySignal  = not isHaUp[1] and isHaUp
bool sellSignal = isHaUp[1] and not isHaUp

float pivotHighValue     = ta.pivothigh(ha_close, leftBars, rightBars)
float pivotLowValue      = ta.pivotlow(ha_close, leftBars, rightBars)
bool  pivotHighConfirmed = not na(pivotHighValue)
bool  pivotLowConfirmed  = not na(pivotLowValue)

// ═════════════════════════════════════════════════════════════════════════════
// ██  HA DIVERGENCE DETECTION
// ═════════════════════════════════════════════════════════════════════════════
float ha_hlc3 = (ha_high + ha_low + ha_close) / 3.0
float divOsc = divSource == "RSI" ? ta.rsi(ha_close, divRsiLen) : ta.mfi(ha_hlc3, divRsiLen)

var float divPH1 = na
var float divPH2 = na
var float divOH1 = na
var float divOH2 = na
var int   divPH1Bar = na
var int   divPH2Bar = na
var float divPL1 = na
var float divPL2 = na
var float divOL1 = na
var float divOL2 = na
var int   divPL1Bar = na
var int   divPL2Bar = na
bool bearishDiv = false
bool bullishDiv = false

// Minimum swing filter: pivots must be at least 0.5 ATR apart in price
// and no more than 100 bars apart to be a valid divergence pair
float divMinSwing = ta.atr(50) * 0.5
int   divMaxBars  = 100

if divEnabled
    if pivotHighConfirmed
        // Only accept this pivot if it's meaningfully different from the last
        bool phValid = na(divPH1) or math.abs(pivotHighValue - divPH1) >= divMinSwing
        if phValid
            divPH2 := divPH1, divOH2 := divOH1, divPH2Bar := divPH1Bar
            divPH1 := pivotHighValue, divOH1 := divOsc[rightBars], divPH1Bar := bar_index - rightBars
            if not na(divPH2) and not na(divOH2) and not na(divPH1Bar) and not na(divPH2Bar)
                bool withinRange = (divPH1Bar - divPH2Bar) <= divMaxBars
                bool priceHigher = divPH1 > divPH2 + divMinSwing
                bool oscLower    = divOH1 < divOH2
                bearishDiv := withinRange and priceHigher and oscLower
    if pivotLowConfirmed
        bool plValid = na(divPL1) or math.abs(pivotLowValue - divPL1) >= divMinSwing
        if plValid
            divPL2 := divPL1, divOL2 := divOL1, divPL2Bar := divPL1Bar
            divPL1 := pivotLowValue, divOL1 := divOsc[rightBars], divPL1Bar := bar_index - rightBars
            if not na(divPL2) and not na(divOL2) and not na(divPL1Bar) and not na(divPL2Bar)
                bool withinRange = (divPL1Bar - divPL2Bar) <= divMaxBars
                bool priceLower  = divPL1 < divPL2 - divMinSwing
                bool oscHigher   = divOL1 > divOL2
                bullishDiv := withinRange and priceLower and oscHigher

// ═════════════════════════════════════════════════════════════════════════════
// ██  SESSION DETECTION
// ═════════════════════════════════════════════════════════════════════════════
int barHHMM   = hour(time, sessTimezone) * 100 + minute(time, sessTimezone)
int sessionId = sessEnabled ? f_detect_session(barHHMM, sessAsiaStart, sessAsiaEnd, sessLonStart, sessLonEnd, sessRthStart, sessRthEnd) : 0

// ═════════════════════════════════════════════════════════════════════════════
// ██  WINDOW POSITIONING
// ═════════════════════════════════════════════════════════════════════════════
int winLeft  = 0
int winRight = 0
if lockToLastBar
    winLeft  := bar_index + futureOffset
    winRight := winLeft + (winBars * barMultiplierWin)
else
    int rawAnchorBar = f_time_to_bar(winAnchorTimeIn)
    bool useAutoAnchor = (winAnchorTimeIn > time) or (not na(rawAnchorBar) and bar_index - rawAnchorBar > 200) or na(rawAnchorBar)
    int anchorBar = useAutoAnchor ? (bar_index - 50) : rawAnchorBar
    anchorBar := math.max(anchorBar, winBars * barMultiplierWin)
    winLeft  := anchorBar - int((winBars * barMultiplierWin) / 2)
    winRight := winLeft + (winBars * barMultiplierWin)
    if winLeft < 0
        winRight += -winLeft
        winLeft := 0

int effectiveLookback = math.min(chartLookback, bar_index > 50 ? bar_index : 50)
float chartHigh  = ta.highest(high, effectiveLookback)
float chartLow   = ta.lowest(low, effectiveLookback)
float chartRange = math.max(chartHigh - chartLow, syminfo.mintick * 100)
float atrValue   = ta.atr(50)

float boxHeight = heightMode == "ATR Multiple" ? (atrValue * winHeightATR) : (chartRange * (winHeightPct / 100.0))
boxHeight := math.max(boxHeight, atrValue * 2)
float gapSize = chartRange * (verticalGap / 100.0)

float zoneBot = 0.0
float zoneTop = 0.0
if usePriceAnchor
    zoneBot := winAnchorPriceIn - boxHeight / 2
    zoneTop := winAnchorPriceIn + boxHeight / 2
else
    float centerPrice = switch verticalPosMode
        "At Current Price" => close
        "At Mid Range"     => (chartHigh + chartLow) / 2
        "Below Price"      => chartLow - boxHeight / 2 - (chartRange * 0.02)
        "Above Price"      => chartHigh + boxHeight / 2 + (chartRange * 0.02)
        => close
    centerPrice += gapSize
    zoneBot := centerPrice - boxHeight / 2
    zoneTop := centerPrice + boxHeight / 2

f_osc_to_price(float v) =>
    float denom = math.max(maxLevel - minLevel, 0.000001)
    zoneBot + ((v - minLevel) / denom) * (zoneTop - zoneBot)

// ═════════════════════════════════════════════════════════════════════════════
// ██  HISTORY BUFFERS
// ═════════════════════════════════════════════════════════════════════════════
var array<float> histO    = array.new_float()
var array<float> histH    = array.new_float()
var array<float> histL    = array.new_float()
var array<float> histC    = array.new_float()
var array<color> histCol  = array.new_color()
var array<bool>  histPH   = array.new_bool()
var array<bool>  histPL   = array.new_bool()
var array<bool>  histBUY  = array.new_bool()
var array<bool>  histSELL = array.new_bool()
var array<bool>  histBullDiv = array.new_bool()
var array<bool>  histBearDiv = array.new_bool()
var array<int>   histSessId  = array.new_int()
var array<bool>  histVrocBuy = array.new_bool()
var array<bool>  histVrocSell = array.new_bool()
var array<float> histEMA = array.new_float()

var int _lastStoredBarIndex = na
bool _isNewBar = na(_lastStoredBarIndex) or (bar_index != _lastStoredBarIndex)

if _isNewBar
    _lastStoredBarIndex := bar_index
    array.unshift(histO, osc_open)
    array.unshift(histH, osc_high)
    array.unshift(histL, osc_low)
    array.unshift(histC, osc_close)
    array.unshift(histCol, final_ha_color)
    array.unshift(histPH, false)
    array.unshift(histPL, false)
    array.unshift(histBUY, buySignal)
    array.unshift(histSELL, sellSignal)
    array.unshift(histBullDiv, false)
    array.unshift(histBearDiv, false)
    array.unshift(histSessId, sessionId)
    array.unshift(histVrocBuy, isVrocBuySpike)
    array.unshift(histVrocSell, isVrocSellSpike)
    array.unshift(histEMA, oscEma)

    while array.size(histO) > WIN_BARS_CAP
        array.pop(histO), array.pop(histH), array.pop(histL), array.pop(histC)
        array.pop(histCol), array.pop(histPH), array.pop(histPL)
        array.pop(histBUY), array.pop(histSELL)
        array.pop(histBullDiv), array.pop(histBearDiv), array.pop(histSessId)
        array.pop(histVrocBuy), array.pop(histVrocSell)
        array.pop(histEMA)
else
    if array.size(histO) > 0
        array.set(histO, 0, osc_open), array.set(histH, 0, osc_high)
        array.set(histL, 0, osc_low),  array.set(histC, 0, osc_close)
        array.set(histCol, 0, final_ha_color)
        array.set(histBUY, 0, buySignal), array.set(histSELL, 0, sellSignal)
        array.set(histSessId, 0, sessionId)
        array.set(histVrocBuy, 0, isVrocBuySpike), array.set(histVrocSell, 0, isVrocSellSpike)
        array.set(histEMA, 0, oscEma)

if pivotHighConfirmed and array.size(histPH) > rightBars
    array.set(histPH, rightBars, true)
if pivotLowConfirmed and array.size(histPL) > rightBars
    array.set(histPL, rightBars, true)
if bearishDiv and array.size(histBearDiv) > rightBars
    array.set(histBearDiv, rightBars, true)
if bullishDiv and array.size(histBullDiv) > rightBars
    array.set(histBullDiv, rightBars, true)

// ═════════════════════════════════════════════════════════════════════════════
// ██  DRAW ENGINE — VAR DECLARATIONS
// ═════════════════════════════════════════════════════════════════════════════
var box  bgBox = na
var box  obBox = na
var box  osBox = na
var box  scalperBox = na
var array<box>   candleBodies = array.new_box()
var array<line>  candleWicks  = array.new_line()
var array<box>   markerBoxes  = array.new_box()
var array<line>  lvlLines     = array.new_line()
var array<label> pnfGlyphs   = array.new_label()
var array<box>   patternBoxes = array.new_box()
var array<line>  trendLines   = array.new_line()
var array<box>   sessionBoxes = array.new_box()
var array<line>  divLines     = array.new_line()
var array<label> divLabels    = array.new_label()
var array<label> haPatLabels  = array.new_label()
var array<line>  gannLines    = array.new_line()
var array<label> priceLvlLabels = array.new_label()
var array<label> trapLabels  = array.new_label()
var array<label> boxCountLabels = array.new_label()
var array<label> timeColLabels = array.new_label()
var array<line>  emaLines     = array.new_line()
var box congBox = na
var label pnfInfoLabel = na
var label mtfIcon = na
var label ltfIcon = na
var label revLabel = na

var array<int>   colDirArr = array.new_int()
var array<float> colTopArr = array.new_float()
var array<float> colBotArr = array.new_float()
var array<float> colVolArr = array.new_float()
var array<int>   colBarsArr = array.new_int()

// ═════════════════════════════════════════════════════════════════════════════
// ██  PnF: BUILD COLUMNS FROM HISTORY
// ═════════════════════════════════════════════════════════════════════════════
// FIX #8 (CRITICAL): This function MUST be called on EVERY bar, not just
// barstate.islast. Pine Script requires functions that use the historical
// reference operator [i] (e.g., pnf_dir[i]) to be called on every bar so
// that the runtime can properly allocate and track the history buffer.
//
// When called only on barstate.islast, Pine hasn't been tracking the series
// through the chart's calculation, so the buffer is too small, causing:
//   "historical offset (N) is beyond the historical buffers limit (N-1)"
//
// The column arrays are 'var' so they persist — calling this every bar just
// rebuilds them (cheap operation) and ensures the [i] buffer is maintained.
// ═════════════════════════════════════════════════════════════════════════════
f_pnf_build_columns() =>
    array.clear(colDirArr)
    array.clear(colTopArr)
    array.clear(colBotArr)
    array.clear(colVolArr)
    array.clear(colBarsArr)
    
    bool started = false
    int curDir = 0
    float curT = na
    float curB = na
    float curVol = 0.0
    int curBars = 0
    int scanMax = math.min(PNF_SCAN_DEPTH - 1, bar_index > 0 ? bar_index - 1 : 0)
    
    for i = 0 to scanMax
        int d = pnf_dir[i]
        float t = pnf_top[i]
        float b = pnf_bot[i]
        if d == 0 or na(t) or na(b)
            continue
        if not started
            started := true
            curDir := d, curT := t, curB := b, curVol := nz(volume[i], 0.0), curBars := 1
        else
            if d == curDir
                curT := math.max(curT, t)
                curB := math.min(curB, b)
                curVol += nz(volume[i], 0.0)
                curBars += 1
            else
                array.push(colDirArr, curDir)
                array.push(colTopArr, curT)
                array.push(colBotArr, curB)
                array.push(colVolArr, curVol)
                array.push(colBarsArr, curBars)
                if array.size(colDirArr) >= winBars
                    break
                curDir := d, curT := t, curB := b, curVol := nz(volume[i], 0.0), curBars := 1
    
    if started and array.size(colDirArr) < winBars
        array.push(colDirArr, curDir)
        array.push(colTopArr, curT)
        array.push(colBotArr, curB)
        array.push(colVolArr, curVol)
        array.push(colBarsArr, curBars)

// ═════════════════════════════════════════════════════════════════════════════
// FIX #8: Call f_pnf_build_columns() on EVERY bar at global scope.
// This ensures Pine properly allocates the [i] history buffer for
// pnf_dir, pnf_top, pnf_bot, and volume.
// The function only writes to var arrays, so results persist to barstate.islast.
// ═════════════════════════════════════════════════════════════════════════════
if usePnF and not na(pnfBoxSize)
    f_pnf_build_columns()

// ═════════════════════════════════════════════════════════════════════════════
// ██  MODULAR RENDERING FUNCTIONS
// ═════════════════════════════════════════════════════════════════════════════

// ──────────────────────────────────────────────────────────────────────────────
// FIX #1: CLEANUP — Only handles ARRAY-based drawings (no global var := na)
// Global var singles are deleted + reset at the CALL SITE in the dispatcher.
// This avoids Pine v6 "Cannot modify global variable in function" error.
// ──────────────────────────────────────────────────────────────────────────────
f_cleanup_arrays() =>
    for b in candleBodies
        box.delete(b)
    array.clear(candleBodies)
    for l in candleWicks
        line.delete(l)
    array.clear(candleWicks)
    for b in markerBoxes
        box.delete(b)
    array.clear(markerBoxes)
    for l in lvlLines
        line.delete(l)
    array.clear(lvlLines)
    for lb in pnfGlyphs
        label.delete(lb)
    array.clear(pnfGlyphs)
    for b in patternBoxes
        box.delete(b)
    array.clear(patternBoxes)
    for l in trendLines
        line.delete(l)
    array.clear(trendLines)
    for b in sessionBoxes
        box.delete(b)
    array.clear(sessionBoxes)
    for l in divLines
        line.delete(l)
    array.clear(divLines)
    for lb in divLabels
        label.delete(lb)
    array.clear(divLabels)
    for lb in haPatLabels
        label.delete(lb)
    array.clear(haPatLabels)
    for l in gannLines
        line.delete(l)
    array.clear(gannLines)
    for lb in priceLvlLabels
        label.delete(lb)
    array.clear(priceLvlLabels)
    for lb in trapLabels
        label.delete(lb)
    array.clear(trapLabels)
    for lb in boxCountLabels
        label.delete(lb)
    array.clear(boxCountLabels)
    for lb in timeColLabels
        label.delete(lb)
    array.clear(timeColLabels)
    for l in emaLines
        line.delete(l)
    array.clear(emaLines)

// ──────────────────────────────────────────────────────────────────────────────
// BACKGROUND FUNCTION - Returns box
// ──────────────────────────────────────────────────────────────────────────────
f_draw_background() =>
    box.new(winLeft, zoneTop, winRight, zoneBot,
         bgcolor=color.new(bgColor, bgTransp), border_color=borderColor, border_width=borderWidth)

// ══════════════════════════════════════════════════════════════════════════════
// ██  HA MODE RENDERING FUNCTIONS
// ══════════════════════════════════════════════════════════════════════════════

// ──────────────────────────────────────────────────────────────────────────────
// HA: DRAW ZONES & LEVELS - Returns [obBox, osBox, scalperBox]
// ──────────────────────────────────────────────────────────────────────────────
f_ha_draw_zones() =>
    float yMax = f_osc_to_price(maxLevel)
    float yMin = f_osc_to_price(minLevel)
    float yOB  = f_osc_to_price(obLevel)
    float yOS  = f_osc_to_price(osLevel)
    float y0   = f_osc_to_price(0.0)
    
    box _obBox = na
    box _osBox = na
    if showZoneFills
        _obBox := box.new(winLeft, math.max(yMax, yOB), winRight, math.min(yMax, yOB), bgcolor=color.new(color.red, 88), border_width=0)
        _osBox := box.new(winLeft, math.max(yOS, yMin), winRight, math.min(yOS, yMin), bgcolor=color.new(color.green, 88), border_width=0)
    
    if showLevelLines
        array.push(lvlLines, line.new(winLeft, y0,  winRight, y0,  color=color.new(color.gray, 50), style=line.style_dotted, width=1))
        array.push(lvlLines, line.new(winLeft, yOB, winRight, yOB, color=color.new(color.red, 60),  style=line.style_dotted, width=1))
        array.push(lvlLines, line.new(winLeft, yOS, winRight, yOS, color=color.new(color.lime, 60), style=line.style_dotted, width=1))
    
    float yBarTop = f_osc_to_price(bar_top_y)
    float yBarBot = f_osc_to_price(bar_bot_y)
    box _scalperBox = box.new(winLeft, math.max(yBarTop, yBarBot), winRight, math.min(yBarTop, yBarBot),
         bgcolor=isHaUp ? uptrendBarColor : downtrendBarColor, border_width=0)
    
    [_obBox, _osBox, _scalperBox]

// ──────────────────────────────────────────────────────────────────────────────
// HA: DRAW CANDLES
// ──────────────────────────────────────────────────────────────────────────────
f_ha_draw_candles() =>
    float markerH = boxHeight * markerSizePct
    int histSize = array.size(histO)
    int n = math.min(histSize, winBars)
    
    if n > 0
        for i = 0 to n - 1
            int xLeft  = 0
            int xRight = 0
            int xWick  = 0
            if use2BarSpacing
                xLeft  := winRight - ((i + 1) * 2)
                xRight := xLeft + 2
                xWick  := xLeft + 1
            else
                xLeft  := winRight - (i + 1)
                xRight := xLeft + 1
                xWick  := xLeft
            
            float iO = array.get(histO, i)
            float iH = array.get(histH, i)
            float iL = array.get(histL, i)
            float iC = array.get(histC, i)
            
            float oP = f_osc_to_price(iO)
            float hP = f_osc_to_price(iH)
            float lP = f_osc_to_price(iL)
            float cP = f_osc_to_price(iC)
            color cc = array.get(histCol, i)
            
            float bodyTop = math.max(oP, cP)
            float bodyBot = math.min(oP, cP)
            if bodyTop - bodyBot < boxHeight * 0.005
                float mid = (bodyTop + bodyBot) / 2
                bodyTop := mid + boxHeight * 0.003
                bodyBot := mid - boxHeight * 0.003
            
            // ── HA PATTERN RECOGNITION ──
            string patName = ""
            string patTip  = ""
            int    patDir  = 0  // 1=bull, -1=bear, 0=neutral
            
            if haPatEnabled and i + 2 < n
                float body = math.abs(iC - iO)
                float wick = iH - iL
                float bodyRatio = wick > 0 ? body / wick : 0.0
                bool  isBull = iC >= iO
                float upperWick = isBull ? (iH - iC) : (iH - iO)
                float lowerWick = isBull ? (iO - iL) : (iC - iL)
                
                // Previous candle data
                float pO = array.get(histO, i + 1)
                float pH = array.get(histH, i + 1)
                float pL = array.get(histL, i + 1)
                float pC = array.get(histC, i + 1)
                float pBody = math.abs(pC - pO)
                bool  pBull = pC >= pO
                
                // Two back
                float ppO = array.get(histO, i + 2)
                float ppC = array.get(histC, i + 2)
                bool  ppBull = ppC >= ppO
                
                // ═══ FLAT TOP (Institutional Resistance) ═══
                float flatTol = (maxLevel - minLevel) * 0.02
                if math.abs(iH - pH) < flatTol and i + 2 < n and math.abs(pH - array.get(histH, i+2)) < flatTol
                    patName := "FLAT TOP"
                    patDir  := -1
                    patTip  := "🏛 INSTITUTIONAL RESISTANCE\n━━━━━━━━━━━━━━━━\nMultiple equal highs = sell orders stacked at this level.\nMarket makers defending a price ceiling.\n\n💡 EDGE: Watch for a failed breakout above.\nIf price sweeps this level and reverses,\nit's a liquidity grab — fade the breakout.\nIf it holds, expect a pullback to the window mid."
                
                // ═══ FLAT BOTTOM (Institutional Support) ═══
                if patName == "" and math.abs(iL - pL) < flatTol and i + 2 < n and math.abs(pL - array.get(histL, i+2)) < flatTol
                    patName := "FLAT BOTTOM"
                    patDir  := 1
                    patTip  := "🏛 INSTITUTIONAL SUPPORT\n━━━━━━━━━━━━━━━━\nMultiple equal lows = buy orders stacked at this level.\nBig money accumulating at a defended floor.\n\n💡 EDGE: Watch for a failed breakdown below.\nA sweep of equal lows that reverses = spring pattern.\nInstitutions sweep weak longs, then drive price up.\nIf lows hold, expect a rally to window mid or higher."
                
                // ═══ THREE SOLDIERS ═══
                if patName == "" and isBull and pBull and ppBull and body > pBody * 0.8
                    patName := "3 SOLDIERS"
                    patDir  := 1
                    patTip  := "⚔ THREE WHITE SOLDIERS\n━━━━━━━━━━━━━━━━\nThree consecutive bull HA candles with strong bodies.\nDemand is overwhelming supply — buyers are in control.\n\n💡 EDGE: This is trend continuation, not reversal.\nDon't fade this. If in oversold zone, this is\nthe bottom confirmation you're looking for.\nLook for pullback to the mid-candle low for entry.\nStop below the first soldier's low."
                
                // ═══ THREE CROWS ═══
                if patName == "" and not isBull and not pBull and not ppBull and body > pBody * 0.8
                    patName := "3 CROWS"
                    patDir  := -1
                    patTip  := "🦅 THREE BLACK CROWS\n━━━━━━━━━━━━━━━━\nThree consecutive bear HA candles with strong bodies.\nSupply is overwhelming demand — sellers dominate.\n\n💡 EDGE: If in overbought zone, this confirms\nthe peak. Don't try to catch the falling knife.\nWait for a retest of the first crow's high.\nIf rejected there, that's your short entry.\nTarget: oversold zone or equal lows below."
                
                // ═══ ABSORPTION (Smart Money) ═══
                if patName == "" and bodyRatio < 0.25 and wick > 0
                    float domWick = math.max(upperWick, lowerWick)
                    if domWick > body * 3
                        if lowerWick > upperWick * 2
                            patName := "ABSORPTION ▲"
                            patDir  := 1
                            patTip  := "🧲 BULLISH ABSORPTION\n━━━━━━━━━━━━━━━━\nTiny body + massive lower wick = institutions\nabsorbed all selling pressure at this level.\nSmart money is buying what retail is selling.\n\n💡 EDGE: This is the footprint of accumulation.\nPrice was pushed down but snapped back — someone\nwith deep pockets is defending this level.\nEnter long on next candle open, stop below wick."
                        else if upperWick > lowerWick * 2
                            patName := "ABSORPTION ▼"
                            patDir  := -1
                            patTip  := "🧲 BEARISH ABSORPTION\n━━━━━━━━━━━━━━━━\nTiny body + massive upper wick = institutions\nabsorbed all buying pressure at this level.\nSmart money is selling what retail is buying.\n\n💡 EDGE: This is distribution in real-time.\nPrice was pushed up but rejected — a ceiling\nis being defended. Enter short on next candle,\nstop above the wick. Target the window low."
                
                // ═══ MOMENTUM EXHAUSTION ═══
                if patName == "" and pBody > 0
                    if body < pBody * 0.4 and ((isBull and pBull) or (not isBull and not pBull))
                        patName := isBull ? "EXHAUSTION ▲" : "EXHAUSTION ▼"
                        patDir  := isBull ? -1 : 1  // Reversal signal
                        patTip  := "⚡ MOMENTUM EXHAUSTION\n━━━━━━━━━━━━━━━━\nDrastically shrinking body after strong move =\nthe trend is running out of fuel.\nEarly warning of reversal.\n\n💡 EDGE: Don't chase the trend here.\nSmart money is starting to take profits.\nWait for the color flip (bull→bear or vice versa)\nfor confirmation. First reversal candle after\nexhaustion is a high-probability entry."
                
                // ═══ INSIDE BAR COMPRESSION ═══
                if patName == "" and iH < pH and iL > pL
                    patName := "INSIDE BAR"
                    patDir  := 0
                    patTip  := "📦 INSIDE BAR COMPRESSION\n━━━━━━━━━━━━━━━━\nCurrent range entirely inside previous range.\nEnergy is coiling — volatility contraction\nprecedes expansion. Think of it as a spring.\n\n💡 EDGE: Trade the breakout direction.\nA break above previous high = long.\nA break below previous low = short.\nThe tighter the compression, the more explosive\nthe move. This is where range-bound traders\nget trapped and fuel the breakout."
                
                // ═══ SPINNING TOP (Indecision) ═══
                if patName == "" and bodyRatio < 0.2 and upperWick > body and lowerWick > body
                    patName := "SPINNING TOP"
                    patDir  := 0
                    patTip  := "🎯 SPINNING TOP — INDECISION\n━━━━━━━━━━━━━━━━\nTiny body with equal wicks both sides.\nBuyers and sellers are at equilibrium.\nNeither side has control.\n\n💡 EDGE: At OB/OS extremes, this often precedes\nreversal. In the middle of a trend, it's a pause.\nWait for the NEXT candle to confirm direction.\nDon't trade the spinning top itself — trade\nwhat happens after it resolves."
                
                // ═══ TREND ACCELERATION ═══
                if patName == "" and isBull and pBull and body > pBody * 1.5 and pBody > math.abs(ppC - ppO) * 1.3
                    patName := "ACCELERATING ▲"
                    patDir  := 1
                    patTip  := "🚀 TREND ACCELERATION\n━━━━━━━━━━━━━━━━\nEach candle body is significantly larger than the last.\nMomentum is building — this is FOMO kicking in.\n\n💡 EDGE: Ride this wave but trail your stop tight.\nAccelerating moves end suddenly. The bigger the\nfinal candle, the closer you are to exhaustion.\nGann's Law: price moves fastest at the END of a trend."
                
                if patName == "" and not isBull and not pBull and body > pBody * 1.5 and pBody > math.abs(ppC - ppO) * 1.3
                    patName := "ACCELERATING ▼"
                    patDir  := -1
                    patTip  := "🚀 TREND ACCELERATION (BEAR)\n━━━━━━━━━━━━━━━━\nEach bear candle body larger than the last.\nPanic selling is accelerating — capitulation phase.\n\n💡 EDGE: Don't try to catch the bottom here.\nBut watch for absorption or spinning top AFTER\nacceleration — that's where the reversal begins.\nGann: 'The bigger the panic, the bigger the recovery.'"
            
            // Build candle tooltip
            string zoneN = f_zoneStr(iC, obLevel, osLevel)
            float  oscPct = (iC - minLevel) / math.max(maxLevel - minLevel, 0.001) * 100.0
            string sessN = array.size(histSessId) > i ? f_sessName(array.get(histSessId, i)) : "N/A"
            bool   vBuy  = array.size(histVrocBuy) > i ? array.get(histVrocBuy, i) : false
            bool   vSell = array.size(histVrocSell) > i ? array.get(histVrocSell, i) : false
            string volStr = vBuy ? "🔊 VOL SPIKE (BUY)" : vSell ? "🔊 VOL SPIKE (SELL)" : "Normal"
            
            string tip = "🕯 HA CANDLE [" + str.tostring(i) + "]\n"
            tip += "━━━━━━━━━━━━━━━━\n"
            tip += "O: " + f_pctStr(iO) + " | C: " + f_pctStr(iC) + "\n"
            tip += "H: " + f_pctStr(iH) + " | L: " + f_pctStr(iL) + "\n"
            tip += "━━━━━━━━━━━━━━━━\n"
            tip += "📊 Zone: " + zoneN + " (" + f_pctStr(oscPct) + ")\n"
            tip += "📈 Trend: " + (iC >= iO ? "BULL" : "BEAR") + "\n"
            tip += "🔊 Volume: " + volStr + "\n"
            tip += "⏰ Session: " + sessN + "\n"
            if patName != ""
                tip += "━━━━━━━━━━━━━━━━\n"
                tip += "🔍 PATTERN: " + patName + "\n"
                tip += patTip
            
            // Session shading
            if sessEnabled and array.size(histSessId) > i
                int sid = array.get(histSessId, i)
                color sc = sid == 1 ? sessAsiaColor : sid == 2 ? sessLonColor : sid == 3 ? sessRthColor : na
                if not na(sc)
                    array.push(sessionBoxes, box.new(xLeft, zoneTop, xRight, zoneBot, bgcolor=sc, border_width=0))
            
            // Candle rendering
            array.push(candleWicks, line.new(xWick, lP, xWick, hP, color=cc, width=wickWidth))
            array.push(candleBodies, box.new(xLeft, bodyTop, xRight, bodyBot,
                 bgcolor=cc, border_color=candleBorderCol, border_width=1))
            
            float candleMidY = (bodyTop + bodyBot) / 2.0
            array.push(haPatLabels, label.new(xWick, candleMidY, "",
                 style=label.style_label_center, textcolor=color.new(color.white, 100),
                 color=color.new(chart.bg_color, 100), size=size.tiny, tooltip=tip))
            
            // Pattern marker
            if haPatEnabled and patName != "" and patDir != 0
                color patC = patDir == 1 ? haPatBullColor : haPatBearColor
                string patCh = patDir == 1 ? "▲" : "▼"
                float patY = patDir == 1 ? lP - markerH * 0.5 : hP + markerH * 0.5
                array.push(haPatLabels, label.new(xWick, patY, patCh,
                     style=label.style_label_center, textcolor=patC,
                     color=color.new(chart.bg_color, 100), size=size.tiny, tooltip=patTip))
            
            // Pivot markers — institutional arrows with tooltips
            if showPivotMarkers
                if array.get(histPH, i)
                    float phOscVal = iH
                    string phZone = f_zoneStr(iC, obLevel, osLevel)
                    string phTip = "🔻 PIVOT HIGH CONFIRMED\n"
                    phTip += "━━━━━━━━━━━━━━━━\n"
                    phTip += "Level: " + f_pctStr(phOscVal) + "\n"
                    phTip += "Zone: " + phZone + "\n"
                    phTip += "Lookback: " + str.tostring(leftBars) + "L / " + str.tostring(rightBars) + "R\n"
                    phTip += "━━━━━━━━━━━━━━━━\n"
                    if iC >= obLevel
                        phTip += "⚠ PIVOT HIGH IN OVERBOUGHT — HIGH PROBABILITY\n"
                        phTip += "reversal zone. This is where institutions\n"
                        phTip += "distribute positions to late buyers.\n"
                    else
                        phTip += "📊 Structural resistance level identified.\n"
                        phTip += "Watch for retest of this level as resistance.\n"
                    phTip += "━━━━━━━━━━━━━━━━\n"
                    phTip += "💡 EDGE: Pivot highs are where liquidity pools\n"
                    phTip += "form above. Smart money targets these levels\n"
                    phTip += "for stop hunts. A sweep above + rejection =\n"
                    phTip += "high-probability short entry.\n"
                    phTip += "Multiple equal pivot highs = even stronger\n"
                    phTip += "resistance + larger liquidity pool above."
                    array.push(haPatLabels, label.new(xWick, hP + markerH * 0.8, "◎",
                         style=label.style_label_center, textcolor=highMarkerColor,
                         color=color.new(chart.bg_color, 100), size=size.normal, tooltip=phTip))
                if array.get(histPL, i)
                    float plOscVal = iL
                    string plZone = f_zoneStr(iC, obLevel, osLevel)
                    string plTip = "🔺 PIVOT LOW CONFIRMED\n"
                    plTip += "━━━━━━━━━━━━━━━━\n"
                    plTip += "Level: " + f_pctStr(plOscVal) + "\n"
                    plTip += "Zone: " + plZone + "\n"
                    plTip += "Lookback: " + str.tostring(leftBars) + "L / " + str.tostring(rightBars) + "R\n"
                    plTip += "━━━━━━━━━━━━━━━━\n"
                    if iC <= osLevel
                        plTip += "⚠ PIVOT LOW IN OVERSOLD — HIGH PROBABILITY\n"
                        plTip += "reversal zone. This is where institutions\n"
                        plTip += "accumulate from panicking retail sellers.\n"
                    else
                        plTip += "📊 Structural support level identified.\n"
                        plTip += "Watch for retest of this level as support.\n"
                    plTip += "━━━━━━━━━━━━━━━━\n"
                    plTip += "💡 EDGE: Pivot lows are where liquidity pools\n"
                    plTip += "form below. Institutions target these stops.\n"
                    plTip += "A sweep below + reclaim = spring pattern —\n"
                    plTip += "high-probability long entry.\n"
                    plTip += "Multiple equal pivot lows = larger pool below,\n"
                    plTip += "and a stronger support if it holds."
                    array.push(haPatLabels, label.new(xWick, lP - markerH * 0.8, "◉",
                         style=label.style_label_center, textcolor=lowMarkerColor,
                         color=color.new(chart.bg_color, 100), size=size.normal, tooltip=plTip))
            
            // Buy/Sell markers — diamond signals with institutional tooltips
            if showBuySellMarkers
                if array.get(histBUY, i)
                    string buyZone = f_zoneStr(iC, obLevel, osLevel)
                    bool buyInOS = iC <= osLevel
                    bool buyVrocConfirm = array.size(histVrocBuy) > i ? array.get(histVrocBuy, i) : false
                    string buyTip = "🟢 BUY SIGNAL — HA Color Flip\n"
                    buyTip += "━━━━━━━━━━━━━━━━\n"
                    buyTip += "Trigger: Bearish → Bullish candle flip\n"
                    buyTip += "Zone: " + buyZone + " | Level: " + f_pctStr(iC) + "\n"
                    buyTip += "━━━━━━━━━━━━━━━━\n"
                    if buyInOS
                        buyTip += "✅ HIGH CONVICTION — Signal in OVERSOLD zone.\n"
                        buyTip += "This is the highest-probability long setup.\n"
                        buyTip += "Institutions are accumulating here — join them.\n"
                    else if iC >= obLevel
                        buyTip += "⚠ LOW CONVICTION — Signal in OVERBOUGHT zone.\n"
                        buyTip += "This flip may be a dead cat bounce or\n"
                        buyTip += "a brief pause before further selling.\n"
                        buyTip += "Avoid or use tight stops only.\n"
                    else
                        buyTip += "📊 MODERATE — Signal in neutral zone.\n"
                        buyTip += "Confirm with trend direction and volume.\n"
                    if buyVrocConfirm
                        buyTip += "━━━━━━━━━━━━━━━━\n"
                        buyTip += "🔊 VOLUME SPIKE CONFIRMED — Smart money footprint.\n"
                        buyTip += "High volume on a color flip = institutional entry.\n"
                    buyTip += "━━━━━━━━━━━━━━━━\n"
                    buyTip += "💡 ENTRY: Open of next candle after this signal.\n"
                    buyTip += "STOP: Below this candle's low.\n"
                    buyTip += "TARGET: Overbought zone or next pivot high.\n"
                    buyTip += "Gann: 'Buy when time and price are squared\n"
                    buyTip += "at the bottom.'"
                    array.push(haPatLabels, label.new(xWick, lP - markerH * 1.6, "✦",
                         style=label.style_label_center, textcolor=lowMarkerColor,
                         color=color.new(chart.bg_color, 100), size=size.normal, tooltip=buyTip))
                if array.get(histSELL, i)
                    string sellZone = f_zoneStr(iC, obLevel, osLevel)
                    bool sellInOB = iC >= obLevel
                    bool sellVrocConfirm = array.size(histVrocSell) > i ? array.get(histVrocSell, i) : false
                    string sellTip = "🔴 SELL SIGNAL — HA Color Flip\n"
                    sellTip += "━━━━━━━━━━━━━━━━\n"
                    sellTip += "Trigger: Bullish → Bearish candle flip\n"
                    sellTip += "Zone: " + sellZone + " | Level: " + f_pctStr(iC) + "\n"
                    sellTip += "━━━━━━━━━━━━━━━━\n"
                    if sellInOB
                        sellTip += "✅ HIGH CONVICTION — Signal in OVERBOUGHT zone.\n"
                        sellTip += "This is the highest-probability short setup.\n"
                        sellTip += "Institutions are distributing here — follow them.\n"
                    else if iC <= osLevel
                        sellTip += "⚠ LOW CONVICTION — Signal in OVERSOLD zone.\n"
                        sellTip += "This flip may be a bear trap or\n"
                        sellTip += "capitulation exhaustion. Avoid shorting here.\n"
                    else
                        sellTip += "📊 MODERATE — Signal in neutral zone.\n"
                        sellTip += "Confirm with trend direction and volume.\n"
                    if sellVrocConfirm
                        sellTip += "━━━━━━━━━━━━━━━━\n"
                        sellTip += "🔊 VOLUME SPIKE CONFIRMED — Institutional distribution.\n"
                        sellTip += "High volume sell-side flip = smart money exiting.\n"
                    sellTip += "━━━━━━━━━━━━━━━━\n"
                    sellTip += "💡 ENTRY: Open of next candle after this signal.\n"
                    sellTip += "STOP: Above this candle's high.\n"
                    sellTip += "TARGET: Oversold zone or next pivot low.\n"
                    sellTip += "Gann: 'Sell when time and price are squared\n"
                    sellTip += "at the top.'"
                    array.push(haPatLabels, label.new(xWick, hP + markerH * 1.6, "✦",
                         style=label.style_label_center, textcolor=highMarkerColor,
                         color=color.new(chart.bg_color, 100), size=size.normal, tooltip=sellTip))
            
            // Divergence markers — institutional tooltips
            if divEnabled
                if array.size(histBearDiv) > i and array.get(histBearDiv, i)
                    string bdSrc = divSource
                    string bdZone = f_zoneStr(iC, obLevel, osLevel)
                    string bdTip = "🐻 BEARISH DIVERGENCE (" + bdSrc + ")\n"
                    bdTip += "━━━━━━━━━━━━━━━━\n"
                    bdTip += "Price: Higher High | " + bdSrc + ": Lower High\n"
                    bdTip += "Zone: " + bdZone + "\n"
                    bdTip += "━━━━━━━━━━━━━━━━\n"
                    if iC >= obLevel
                        bdTip += "🔥 MAXIMUM PROBABILITY — Divergence at OB extreme.\n"
                        bdTip += "This is the textbook institutional distribution setup.\n"
                        bdTip += "Price makes a new high but momentum is DYING.\n"
                        bdTip += "Smart money is selling into the retail FOMO.\n"
                    else
                        bdTip += "📊 Divergence detected in neutral zone.\n"
                        bdTip += "Less reliable than at OB extreme — confirm with\n"
                        bdTip += "other signals (HA pattern, volume, PnF column).\n"
                    bdTip += "━━━━━━━━━━━━━━━━\n"
                    bdTip += "💡 TRADE: Wait for the HA color flip (bull→bear)\n"
                    bdTip += "AFTER the divergence signal for entry confirmation.\n"
                    bdTip += "STOP: Above the divergence high.\n"
                    bdTip += "TARGET: Oversold zone or previous pivot low.\n"
                    bdTip += "━━━━━━━━━━━━━━━━\n"
                    bdTip += "⚡ POWER COMBO: Bearish div + HA exhaustion pattern\n"
                    bdTip += "+ PnF column reversal to O = TRIFECTA short signal."
                    if divMarkerStyle == "Line"
                        array.push(divLines, line.new(xWick, hP, xWick, hP + markerH * 1.5, color=divBearColor, width=2))
                        array.push(divLabels, label.new(xWick, hP + markerH * 1.5, "",
                             style=label.style_label_center, textcolor=color.new(color.white, 100),
                             color=color.new(chart.bg_color, 100), size=size.tiny, tooltip=bdTip))
                    else
                        array.push(divLabels, label.new(xWick, hP + markerH * 0.5, "⟱",
                             style=label.style_label_center, textcolor=divBearColor,
                             color=color.new(chart.bg_color, 100), size=size.small, tooltip=bdTip))
                if array.size(histBullDiv) > i and array.get(histBullDiv, i)
                    string buSrc = divSource
                    string buZone = f_zoneStr(iC, obLevel, osLevel)
                    string buTip = "🐂 BULLISH DIVERGENCE (" + buSrc + ")\n"
                    buTip += "━━━━━━━━━━━━━━━━\n"
                    buTip += "Price: Lower Low | " + buSrc + ": Higher Low\n"
                    buTip += "Zone: " + buZone + "\n"
                    buTip += "━━━━━━━━━━━━━━━━\n"
                    if iC <= osLevel
                        buTip += "🔥 MAXIMUM PROBABILITY — Divergence at OS extreme.\n"
                        buTip += "This is the textbook institutional accumulation setup.\n"
                        buTip += "Price makes a new low but momentum is BUILDING.\n"
                        buTip += "Smart money is buying while retail is panicking.\n"
                    else
                        buTip += "📊 Divergence detected in neutral zone.\n"
                        buTip += "Less reliable than at OS extreme — confirm with\n"
                        buTip += "other signals (HA pattern, volume, PnF column).\n"
                    buTip += "━━━━━━━━━━━━━━━━\n"
                    buTip += "💡 TRADE: Wait for the HA color flip (bear→bull)\n"
                    buTip += "AFTER the divergence signal for entry confirmation.\n"
                    buTip += "STOP: Below the divergence low.\n"
                    buTip += "TARGET: Overbought zone or previous pivot high.\n"
                    buTip += "━━━━━━━━━━━━━━━━\n"
                    buTip += "⚡ POWER COMBO: Bullish div + HA absorption pattern\n"
                    buTip += "+ PnF column reversal to X = TRIFECTA long signal."
                    if divMarkerStyle == "Line"
                        array.push(divLines, line.new(xWick, lP, xWick, lP - markerH * 1.5, color=divBullColor, width=2))
                        array.push(divLabels, label.new(xWick, lP - markerH * 1.5, "",
                             style=label.style_label_center, textcolor=color.new(color.white, 100),
                             color=color.new(chart.bg_color, 100), size=size.tiny, tooltip=buTip))
                    else
                        array.push(divLabels, label.new(xWick, lP - markerH * 0.5, "⟰",
                             style=label.style_label_center, textcolor=divBullColor,
                             color=color.new(chart.bg_color, 100), size=size.small, tooltip=buTip))

// ──────────────────────────────────────────────────────────────────────────────
// HA: DRAW EMA OVERLAY
// ──────────────────────────────────────────────────────────────────────────────
f_ha_draw_ema() =>
    int histSize = array.size(histO)
    int n = math.min(histSize, winBars)
    
    if emaEnabled and n >= 2
        for i = 0 to n - 2
            float emaVal0 = array.size(histEMA) > i ? array.get(histEMA, i) : na
            float emaVal1 = array.size(histEMA) > (i + 1) ? array.get(histEMA, i + 1) : na
            if not na(emaVal0) and not na(emaVal1)
                float ey0 = f_osc_to_price(emaVal0)
                float ey1 = f_osc_to_price(emaVal1)
                int ex0 = 0
                int ex1 = 0
                if use2BarSpacing
                    ex0 := winRight - ((i + 1) * 2) + 1
                    ex1 := winRight - (((i + 1) + 1) * 2) + 1
                else
                    ex0 := winRight - (i + 1)
                    ex1 := winRight - ((i + 1) + 1)
                float closeVal = array.get(histC, i)
                color emaC = closeVal >= emaVal0 ? emaBullColor : emaBearColor
                array.push(emaLines, line.new(ex0, ey0, ex1, ey1, color=emaC, width=emaWidth))

// ──────────────────────────────────────────────────────────────────────────────
// HA: MAIN COORDINATOR - Returns [obBox, osBox, scalperBox]
// ──────────────────────────────────────────────────────────────────────────────
f_render_ha_mode() =>
    [_obBox, _osBox, _scalperBox] = f_ha_draw_zones()
    f_ha_draw_candles()
    f_ha_draw_ema()
    [_obBox, _osBox, _scalperBox]

// ══════════════════════════════════════════════════════════════════════════════
// ██  PnF MODE RENDERING FUNCTIONS
// ══════════════════════════════════════════════════════════════════════════════

// ──────────────────────────────────────────────────────────────────────────────
// PnF: CALCULATE GANN HORIZONTAL COUNT
// Returns: [hCount, hCongTop, hCongBot, hBullTarget, hBearTarget, hCountTip]
// ──────────────────────────────────────────────────────────────────────────────
f_pnf_gann_hcount(int colCountDraw, float pnfBoxSz) =>
    int hCount = 0
    float hCongTop = na
    float hCongBot = na
    float hBullTarget = na
    float hBearTarget = na
    string hCountTip = ""
    
    if gannEnabled and colCountDraw >= 3
        float congTol = gannCongTol * pnfBoxSz
        hCongTop := array.get(colTopArr, 0)
        hCongBot := array.get(colBotArr, 0)
        hCount := 1
        for ci = 1 to colCountDraw - 1
            float ct = array.get(colTopArr, ci)
            float cb = array.get(colBotArr, ci)
            if ct >= hCongBot - congTol and cb <= hCongTop + congTol
                hCount += 1
                hCongTop := math.max(hCongTop, ct)
                hCongBot := math.min(hCongBot, cb)
            else
                break
        
        float hMove = float(hCount) * pnfBoxSz * float(pnfReversal)
        hBullTarget := hCongTop + hMove
        hBearTarget := hCongBot - hMove
        
        hCountTip := "📐 GANN HORIZONTAL COUNT\n━━━━━━━━━━━━━━━━\n"
        hCountTip += "Congestion Width: " + str.tostring(hCount) + " columns\n"
        hCountTip += "Congestion Range: " + f_priceStr(hCongBot) + " — " + f_priceStr(hCongTop) + "\n"
        hCountTip += "Projected Move: " + f_priceStr(hMove) + " pts\n"
        hCountTip += "━━━━━━━━━━━━━━━━\n"
        hCountTip += "🎯 BULL TARGET: " + f_priceStr(hBullTarget) + "\n"
        hCountTip += "🎯 BEAR TARGET: " + f_priceStr(hBearTarget) + "\n"
        hCountTip += "━━━━━━━━━━━━━━━━\n"
        hCountTip += "💡 GANN SECRET: The wider the congestion,\n"
        hCountTip += "the more powerful the breakout. Width = energy stored.\n"
        hCountTip += "H-count > 5 = institutional accumulation/distribution.\n"
        hCountTip += "When H-count ≈ V-count, time and price are SQUARED —\n"
        hCountTip += "expect resolution. This is Gann's time-price balance."
    
    [hCount, hCongTop, hCongBot, hBullTarget, hBearTarget, hCountTip]

// ──────────────────────────────────────────────────────────────────────────────
// FIX #5: PnF: DETECT PATTERNS — removed var from function-local arrays
// Returns: arrays of [patFlag, patName, patTip] for each column
// ──────────────────────────────────────────────────────────────────────────────
f_pnf_detect_patterns(int colCountDraw, float pnfBoxSz) =>
    // FIX: Removed 'var' — fresh arrays each call (no stale data risk)
    array<int>    colPatFlag = array.new_int()
    array<string> colPatName = array.new_string()
    array<string> colPatTip  = array.new_string()
    
    for _pi = 0 to colCountDraw - 1
        array.push(colPatFlag, 0)
        array.push(colPatName, "")
        array.push(colPatTip, "")
    
    if patEnabled and colCountDraw >= 3
        float tol = patTolerance * pnfBoxSz
        for ci = 0 to colCountDraw - 1
            int dC = array.get(colDirArr, ci)
            
            // DOUBLE TOP BREAKOUT
            if patDoubleTop and dC == 1 and ci + 2 < colCountDraw and array.get(colDirArr, ci + 2) == 1
                float ct0 = array.get(colTopArr, ci)
                float ct1 = array.get(colTopArr, ci + 2)
                if ct0 > ct1 + tol * 0.5
                    array.set(colPatFlag, ci, 1)
                    array.set(colPatName, ci, "DBL TOP BREAKOUT")
                    array.set(colPatTip, ci, "🔺 DOUBLE TOP BREAKOUT\n━━━━━━━━━━━━━━━━\nX column exceeded the previous X high.\nResistance broken — buyers overpowered sellers.\n\n💡 GANN: This is a momentum buy signal.\nThe breakout column's height gives you the\nVertical Count target. The wider the base\nbefore breakout, the further price travels.\nStops go below the last O column bottom.")
            
            // DOUBLE BOTTOM BREAKDOWN
            if patDoubleBot and dC == -1 and ci + 2 < colCountDraw and array.get(colDirArr, ci + 2) == -1
                float cb0 = array.get(colBotArr, ci)
                float cb1 = array.get(colBotArr, ci + 2)
                if cb0 < cb1 - tol * 0.5
                    array.set(colPatFlag, ci, -1)
                    array.set(colPatName, ci, "DBL BOT BREAKDOWN")
                    array.set(colPatTip, ci, "🔻 DOUBLE BOTTOM BREAKDOWN\n━━━━━━━━━━━━━━━━\nO column broke below previous O low.\nSupport shattered — sellers overwhelmed.\n\n💡 GANN: This is a momentum sell signal.\nProject the Vertical Count downward.\nThe steeper the initial drop, the more\npanic follows. Target the H-count projection.\nStops above the last X column top.")
            
            // TRIPLE TOP BREAKOUT
            if patTripleTop and dC == 1 and ci + 4 < colCountDraw
                if array.get(colDirArr, ci+2) == 1 and array.get(colDirArr, ci+4) == 1
                    float t0 = array.get(colTopArr, ci)
                    float t1 = array.get(colTopArr, ci + 2)
                    float t2 = array.get(colTopArr, ci + 4)
                    if math.abs(t1 - t2) <= tol and t0 > t1 + tol * 0.5
                        array.set(colPatFlag, ci, 1)
                        array.set(colPatName, ci, "TRIPLE TOP BREAKOUT")
                        array.set(colPatTip, ci, "🔺🔺🔺 TRIPLE TOP BREAKOUT\n━━━━━━━━━━━━━━━━\nThree tests of resistance, then breakthrough.\nThe more tests, the more significant the break.\n\n💡 GANN SECRET: Triple top breakout is the\nstrongest PnF buy signal. Three tests means\ninstitutions were accumulating below resistance.\nWhen it finally breaks, all that accumulated\ndemand drives a powerful rally.\nTarget: V-count from breakout column.\nGann angle: 45° from breakout point = trend support.")
            
            // TRIPLE BOTTOM BREAKDOWN
            if patTripleBot and dC == -1 and ci + 4 < colCountDraw
                if array.get(colDirArr, ci+2) == -1 and array.get(colDirArr, ci+4) == -1
                    float b0 = array.get(colBotArr, ci)
                    float b1 = array.get(colBotArr, ci + 2)
                    float b2 = array.get(colBotArr, ci + 4)
                    if math.abs(b1 - b2) <= tol and b0 < b1 - tol * 0.5
                        array.set(colPatFlag, ci, -1)
                        array.set(colPatName, ci, "TRIPLE BOT BREAKDOWN")
                        array.set(colPatTip, ci, "🔻🔻🔻 TRIPLE BOTTOM BREAKDOWN\n━━━━━━━━━━━━━━━━\nThree tests of support, then it gives way.\nDistribution complete — institutions are out.\n\n💡 GANN SECRET: Triple bottom breakdown is the\nstrongest PnF sell signal. Three failed bounces\nmean every dip-buyer is now trapped.\nTheir stops become fuel for the waterfall.\nTarget: V-count projected downward.\nGann: this often leads to time-price panic.")
            
            // ASCENDING TRIPLE BOTTOM
            if patAscTriple and dC == 1 and ci + 5 < colCountDraw
                if array.get(colDirArr, ci+1) == -1 and array.get(colDirArr, ci+3) == -1 and array.get(colDirArr, ci+5) == -1
                    float ob1 = array.get(colBotArr, ci + 5)
                    float ob2 = array.get(colBotArr, ci + 3)
                    float ob3 = array.get(colBotArr, ci + 1)
                    if ob2 > ob1 and ob3 > ob2
                        array.set(colPatFlag, ci, 1)
                        array.set(colPatName, ci, "ASC TRIPLE BOT")
                        array.set(colPatTip, ci, "📈 ASCENDING TRIPLE BOTTOM\n━━━━━━━━━━━━━━━━\nEach pullback makes a HIGHER low.\nBuyers increasingly aggressive — demand rising.\n\n💡 GANN SECRET: This is accumulation in action.\nEach higher low means institutions are raising\ntheir bid. The breakout X column confirms\nthe accumulation phase is complete.\nThis is one of the most reliable PnF patterns.\nRisk/reward is excellent: stop below last O low.")
            
            // DESCENDING TRIPLE TOP
            if patDescTriple and dC == -1 and ci + 5 < colCountDraw
                if array.get(colDirArr, ci+1) == 1 and array.get(colDirArr, ci+3) == 1 and array.get(colDirArr, ci+5) == 1
                    float xt1 = array.get(colTopArr, ci + 5)
                    float xt2 = array.get(colTopArr, ci + 3)
                    float xt3 = array.get(colTopArr, ci + 1)
                    if xt2 < xt1 and xt3 < xt2
                        array.set(colPatFlag, ci, -1)
                        array.set(colPatName, ci, "DESC TRIPLE TOP")
                        array.set(colPatTip, ci, "📉 DESCENDING TRIPLE TOP\n━━━━━━━━━━━━━━━━\nEach rally makes a LOWER high.\nSellers increasingly aggressive — supply rising.\n\n💡 GANN SECRET: Distribution in action.\nInstitutions lowering their ask each time.\nThe breakdown O column confirms distribution.\nTarget: V-count downward + H-count projection.\nStop above the most recent X column top.")
            
            // CATAPULT BULL
            if patCatapult and dC == 1 and ci + 6 < colCountDraw
                if array.get(colDirArr, ci+2) == 1 and array.get(colDirArr, ci+4) == 1 and array.get(colDirArr, ci+6) == 1
                    float ct0 = array.get(colTopArr, ci)
                    float ct1 = array.get(colTopArr, ci + 2)
                    float ct2 = array.get(colTopArr, ci + 4)
                    float ct3 = array.get(colTopArr, ci + 6)
                    if math.abs(ct2 - ct3) <= tol and ct1 > ct2 + tol * 0.5 and ct0 > ct1 + tol * 0.5
                        array.set(colPatFlag, ci, 1)
                        array.set(colPatName, ci, "CATAPULT BULL")
                        array.set(colPatTip, ci, "🚀 BULLISH CATAPULT\n━━━━━━━━━━━━━━━━\nTriple top breakout FOLLOWED by another breakout.\nDouble confirmation of massive bullish momentum.\n\n💡 GANN SECRET: The catapult is Gann's\n'compound breakout' — the rarest and most\npowerful PnF signal. It means the first\nbreakout was tested, held, then launched again.\nThis is institutional conviction at its peak.\nTarget: 2× the V-count. Trail stop aggressively.")
            
            // CATAPULT BEAR
            if patCatapult and dC == -1 and ci + 6 < colCountDraw
                if array.get(colDirArr, ci+2) == -1 and array.get(colDirArr, ci+4) == -1 and array.get(colDirArr, ci+6) == -1
                    float cb0 = array.get(colBotArr, ci)
                    float cb1 = array.get(colBotArr, ci + 2)
                    float cb2 = array.get(colBotArr, ci + 4)
                    float cb3 = array.get(colBotArr, ci + 6)
                    if math.abs(cb2 - cb3) <= tol and cb1 < cb2 - tol * 0.5 and cb0 < cb1 - tol * 0.5
                        array.set(colPatFlag, ci, -1)
                        array.set(colPatName, ci, "CATAPULT BEAR")
                        array.set(colPatTip, ci, "💥 BEARISH CATAPULT\n━━━━━━━━━━━━━━━━\nTriple bottom breakdown FOLLOWED by another break.\nDouble-confirmed bearish conviction.\n\n💡 GANN SECRET: Bearish catapult = panic squared.\nInstitutional selling confirmed twice.\nThis is where margin calls cascade.\nTarget: 2× V-count downward.\nDon't fade this — ever.")
    
    [colPatFlag, colPatName, colPatTip]

// ──────────────────────────────────────────────────────────────────────────────
// FIX #5: PnF: DETECT LIQUIDITY TRAPS — removed var from function-local array
// Returns: array of trap flags for each column
// ──────────────────────────────────────────────────────────────────────────────
f_pnf_detect_traps(int colCountDraw, float pnfBoxSz) =>
    // FIX: Removed 'var' — fresh array each call
    array<int> colTrapFlag = array.new_int()
    for _ti = 0 to colCountDraw - 1
        array.push(colTrapFlag, 0)
    
    if trapEnabled and colCountDraw >= 3
        for ti = 0 to colCountDraw - 3
            int tiDir = array.get(colDirArr, ti)
            int tiPrev = array.get(colDirArr, ti + 1)
            
            // Bull Trap
            if tiDir == -1 and tiPrev == 1
                float xTop = array.get(colTopArr, ti + 1)
                for tj = ti + 2 to colCountDraw - 1
                    if array.get(colDirArr, tj) == 1
                        float priorXTop = array.get(colTopArr, tj)
                        float tol = patTolerance * pnfBoxSz
                        if xTop > priorXTop + tol
                            array.set(colTrapFlag, ti + 1, 1)
                        break
            
            // Bear Trap
            if tiDir == 1 and tiPrev == -1
                float oBot = array.get(colBotArr, ti + 1)
                for tj = ti + 2 to colCountDraw - 1
                    if array.get(colDirArr, tj) == -1
                        float priorOBot = array.get(colBotArr, tj)
                        float tol = patTolerance * pnfBoxSz
                        if oBot < priorOBot - tol
                            array.set(colTrapFlag, ti + 1, -1)
                        break
    
    colTrapFlag

// ──────────────────────────────────────────────────────────────────────────────
// PnF: DRAW INFO LABEL - Returns label
// ──────────────────────────────────────────────────────────────────────────────
f_pnf_draw_info_label(string hCountTip) =>
    label _pnfInfoLabel = na
    if pnfShowInfo
        string corrStr = na(pnf_corr) ? "na" : str.tostring(pnf_corr, "#.###")
        string dirStr  = pnf_dir == 1 ? "X ▲" : pnf_dir == -1 ? "O ▼" : "?"
        string infoTxt = "PnF ATR(" + str.tostring(pnfAtrChosen) + ") rev=" + str.tostring(pnfReversal) + " " + dirStr + " r=" + corrStr
        
        string infoTip = "🖥 PnF WINDOW ANALYSIS\n━━━━━━━━━━━━━━━━\n"
        infoTip += "ATR Period: " + str.tostring(pnfAtrChosen) + "\n"
        infoTip += "Box Size: " + f_priceStr(pnfBoxSize) + "\n"
        infoTip += "Reversal: " + str.tostring(pnfReversal) + " boxes\n"
        infoTip += "Correlation: " + corrStr + "\n"
        infoTip += "Direction: " + dirStr + "\n"
        if gannEnabled
            infoTip += "━━━━━━━━━━━━━━━━\n"
            infoTip += hCountTip
        
        float yInfo = zoneTop + (zoneTop - zoneBot) * 0.03
        _pnfInfoLabel := label.new(winLeft, yInfo, infoTxt, style=label.style_label_left,
             textcolor=color.new(color.white, 0), color=color.new(chart.bg_color, 100),
             size=size.small, tooltip=infoTip)
    _pnfInfoLabel

// ──────────────────────────────────────────────────────────────────────────────
// PnF: DRAW MTF/LTF ICONS - Returns [mtfIcon, ltfIcon]
// ──────────────────────────────────────────────────────────────────────────────
f_pnf_draw_mtf_ltf_icons() =>
    label _mtfIcon = na
    label _ltfIcon = na
    
    // MTF Icon
    if mtfEnabled
        string mtfStr = mtfPDir == 1 ? "▲ HTF" : mtfPDir == -1 ? "▼ HTF" : "— HTF"
        color  mtfC   = mtfPDir == 1 ? mtfBullColor : mtfPDir == -1 ? mtfBearColor : color.gray
        bool   confluence = (mtfPDir == pnf_dir) and pnf_dir != 0
        
        string mtfTip = "📡 MTF PnF SYNC (" + mtfTimeframe + ")\n━━━━━━━━━━━━━━━━\n"
        mtfTip += "HTF Direction: " + (mtfPDir == 1 ? "X (Bullish)" : mtfPDir == -1 ? "O (Bearish)" : "Flat") + "\n"
        mtfTip += "Current TF Direction: " + (pnf_dir == 1 ? "X (Bullish)" : "O (Bearish)") + "\n"
        mtfTip += "━━━━━━━━━━━━━━━━\n"
        mtfTip += confluence ? "✅ CONFLUENCE — Both timeframes agree!\nThis is the highest-probability setup.\nTrade in this direction with confidence.\n" :
             "⚠ DIVERGENCE — Timeframes disagree.\nProceed with caution. The HTF trend\nusually wins. Consider waiting for alignment."
        mtfTip += "\n💡 GANN: 'The trend of the higher time period\nalways dominates the lower.' When both align,\nyou have Gann's 'harmony of time and price.'"
        
        float yMtf = zoneTop - (zoneTop - zoneBot) * 0.06
        _mtfIcon := label.new(winLeft, yMtf, mtfStr, style=label.style_label_left,
             textcolor=mtfC, color=color.new(chart.bg_color, 100), size=size.small, tooltip=mtfTip)
    
    // LTF Icon
    if ltfEnabled
        string ltfStr = ltfPDir == 1 ? "▲ LTF" : ltfPDir == -1 ? "▼ LTF" : "— LTF"
        color  ltfC   = ltfPDir == 1 ? ltfBullColor : ltfPDir == -1 ? ltfBearColor : color.gray
        
        bool tripleConf = mtfEnabled and (mtfPDir == pnf_dir) and (pnf_dir == ltfPDir) and pnf_dir != 0
        bool ltfLeading = (ltfPDir != pnf_dir) and pnf_dir != 0
        bool ltfConfirm = (ltfPDir == pnf_dir) and pnf_dir != 0
        
        string ltfTip = "📡 LTF PnF BIAS (" + ltfTimeframe + ")\n━━━━━━━━━━━━━━━━\n"
        ltfTip += "LTF Direction: " + (ltfPDir == 1 ? "X (Bullish)" : ltfPDir == -1 ? "O (Bearish)" : "Flat") + "\n"
        ltfTip += "Current TF Direction: " + (pnf_dir == 1 ? "X (Bullish)" : "O (Bearish)") + "\n"
        if mtfEnabled
            ltfTip += "HTF Direction: " + (mtfPDir == 1 ? "X (Bullish)" : mtfPDir == -1 ? "O (Bearish)" : "Flat") + "\n"
        ltfTip += "━━━━━━━━━━━━━━━━\n"
        if tripleConf
            ltfTip += "🔥 TRIPLE CONFLUENCE — All 3 TFs agree!\n"
            ltfTip += "HTF + Current + LTF aligned = MAXIMUM conviction.\n"
            ltfTip += "This is where institutions press their edge hardest.\n"
            ltfTip += "Size up. Trail stops. Let it run.\n"
        else if ltfLeading
            ltfTip += "⚡ LTF DIVERGING — Early reversal warning!\n"
            ltfTip += "The LTF has flipped before the current TF.\n"
            ltfTip += "This is often the FIRST sign of a turn.\n"
            ltfTip += "Watch for current TF to confirm within 2-3 bars.\n"
            ltfTip += "If you're in a trade against the LTF, tighten stops.\n"
        else if ltfConfirm
            ltfTip += "✅ LTF CONFIRMS current direction.\n"
            ltfTip += "Momentum is flowing with you on the micro level.\n"
        else
            ltfTip += "⏳ LTF is neutral — waiting for direction.\n"
        ltfTip += "━━━━━━━━━━━━━━━━\n"
        ltfTip += "💡 EDGE: The LTF is your 'microscope.'\n"
        ltfTip += "It shows you what's happening INSIDE the current bar.\n"
        ltfTip += "LTF reversal before current TF = early entry signal.\n"
        ltfTip += "LTF confirmation after current TF = safe entry signal.\n"
        ltfTip += "Gann: 'The minor trend tells the truth first.'"
        
        float yLtf = zoneTop - (zoneTop - zoneBot) * 0.12
        _ltfIcon := label.new(winLeft, yLtf, ltfStr, style=label.style_label_left,
             textcolor=ltfC, color=color.new(chart.bg_color, 100), size=size.small, tooltip=ltfTip)
    
    [_mtfIcon, _ltfIcon]

// ──────────────────────────────────────────────────────────────────────────────
// PnF: DRAW REVERSAL ALERT - Returns label
// ──────────────────────────────────────────────────────────────────────────────
f_pnf_draw_reversal_alert(int colCountDraw) =>
    label _revLabel = na
    if raEnabled and raShowLabel and colCountDraw >= 2
        int d0 = array.get(colDirArr, 0)
        int d1 = array.get(colDirArr, 1)
        if d0 != d1 and d1 != 0
            string revStr = d0 == 1 ? "⟳X" : "⟳O"
            color  revC   = d0 == 1 ? raBullColor : raBearColor
            int    revX   = winRight - int(math.ceil(float(pnfColSpace) / 2.0))
            float  revY   = d0 == 1 ? zoneBot + (zoneTop - zoneBot) * 0.04 : zoneTop - (zoneTop - zoneBot) * 0.04
            
            string revTip = "⟳ COLUMN REVERSAL\n━━━━━━━━━━━━━━━━\n"
            revTip += "Reversed to: " + (d0 == 1 ? "X (Bullish)" : "O (Bearish)") + "\n"
            revTip += "━━━━━━━━━━━━━━━━\n"
            revTip += "💡 A reversal requires " + str.tostring(pnfReversal) + " boxes against the\n"
            revTip += "trend. This means significant counter-pressure.\n"
            revTip += "Gann: 'The first reversal after a strong trend\n"
            revTip += "is usually a correction, not a new trend.\n"
            revTip += "The SECOND reversal in the same direction\n"
            revTip += "confirms the new trend.'"
            
            _revLabel := label.new(revX, revY, revStr, style=label.style_label_center,
                 textcolor=revC, color=color.new(chart.bg_color, 100), size=size.small, tooltip=revTip)
    _revLabel

// ──────────────────────────────────────────────────────────────────────────────
// PnF: DRAW COLUMNS (MAIN RENDERING LOOP)
// ──────────────────────────────────────────────────────────────────────────────
f_pnf_draw_columns_part1(int colCountDraw, float hiAll, float loAll, float gridHi, float step, int rowsTotal, array<int> colPatFlag, array<string> colPatName, array<string> colPatTip, array<int> colTrapFlag) =>
    // Volume range
    float volMin = 0.0
    float volMax = 0.0
    if vwEnabled
        volMin := array.get(colVolArr, 0)
        volMax := volMin
        for vk = 0 to colCountDraw - 1
            volMin := math.min(volMin, array.get(colVolArr, vk))
            volMax := math.max(volMax, array.get(colVolArr, vk))
    
    // Draw each column
    for col = 0 to colCountDraw - 1
        int xMid = winRight - col * pnfColSpace - int(math.ceil(float(pnfColSpace) / 2.0))
        int dCol = array.get(colDirArr, col)
        float tCol = array.get(colTopArr, col)
        float bCol = array.get(colBotArr, col)
        
        int rTop = int(math.round((gridHi - tCol) / step))
        int rBot = int(math.round((gridHi - bCol) / step))
        rTop := f_clamp_int(rTop, 0, rowsTotal - 1)
        rBot := f_clamp_int(rBot, 0, rowsTotal - 1)
        if rTop > rBot
            int tmp = rTop
            rTop := rBot
            rBot := tmp
        
        int boxCount = rBot - rTop + 1
        float colVol = array.size(colVolArr) > col ? array.get(colVolArr, col) : 0.0
        
        // Gann Vertical Count
        float vTarget = na
        string vCountStr = ""
        if gannEnabled
            float vMove = float(boxCount) * pnfBoxSize * float(pnfReversal)
            vTarget := dCol == 1 ? bCol + vMove : tCol - vMove
            vCountStr := "📐 GANN VERTICAL COUNT\n"
            vCountStr += "Boxes: " + str.tostring(boxCount) + " | Move: " + f_priceStr(vMove) + "pts\n"
            vCountStr += "🎯 V-Target: " + f_priceStr(vTarget) + "\n"
            vCountStr += "━━━━━━━━━━━━━━━━\n"
            vCountStr += "💡 V-count = boxes × box_size × reversal.\n"
            vCountStr += "Gann: 'The first impulse tells you the target.'\n"
            vCountStr += "Fib confirmation: 1.618 × V-count = extended target."
        
        // Column Tooltip
        string colTip = (dCol == 1 ? "📊 X COLUMN (BULLISH)" : "📊 O COLUMN (BEARISH)") + "\n"
        colTip += "━━━━━━━━━━━━━━━━\n"
        colTip += "Top: " + f_priceStr(tCol) + " | Bot: " + f_priceStr(bCol) + "\n"
        colTip += "Boxes: " + str.tostring(boxCount) + " | Range: " + f_priceStr(tCol - bCol) + "pts\n"
        
        // Time-in-column microstructure
        int colBars = array.size(colBarsArr) > col ? array.get(colBarsArr, col) : 0
        if tcEnabled and colBars > 0
            colTip += "⏱ Bars: " + str.tostring(colBars) + " | "
            float barsPerBox = boxCount > 0 ? float(colBars) / float(boxCount) : 0.0
            if barsPerBox > 3.0
                colTip += "🐌 ABSORPTION — " + str.tostring(barsPerBox, "#.#") + " bars/box\n"
                colTip += "Smart money quietly " + (dCol == 1 ? "accumulating" : "distributing") + ".\n"
            else if barsPerBox < 1.2 and boxCount >= 3
                colTip += "⚡ MOMENTUM — " + str.tostring(barsPerBox, "#.#") + " bars/box\n"
                colTip += (dCol == 1 ? "FOMO buying" : "Panic selling") + " in progress.\n"
            else
                colTip += str.tostring(barsPerBox, "#.#") + " bars/box (Normal)\n"
        
        if vwEnabled
            float volPctile = volMax > volMin ? (colVol - volMin) / (volMax - volMin) * 100.0 : 50.0
            colTip += "Volume: " + str.tostring(colVol, "#.0") + " (P" + str.tostring(volPctile, "#") + ")\n"
            if volPctile > 80
                colTip += "🔥 HEAVY VOLUME — institutional participation\n"
            else if volPctile < 20
                colTip += "💤 LIGHT VOLUME — low conviction move\n"
        
        if gannEnabled
            colTip += "━━━━━━━━━━━━━━━━\n" + vCountStr
        
        // Pattern info
        string pName = array.size(colPatName) > col ? array.get(colPatName, col) : ""
        string pTip  = array.size(colPatTip) > col ? array.get(colPatTip, col) : ""
        if pName != ""
            colTip += "\n━━━━━━━━━━━━━━━━\n🔍 PATTERN: " + pName + "\n" + pTip
        
        // Trap info
        int trapFlag = array.size(colTrapFlag) > col ? array.get(colTrapFlag, col) : 0
        if trapFlag == 1
            colTip += "\n━━━━━━━━━━━━━━━━\n🪤 BULL TRAP / LIQUIDITY SWEEP\n"
            colTip += "This X broke above prior resistance then\n"
            colTip += "IMMEDIATELY reversed to O. Trapped longs\n"
            colTip += "are now fuel for the move down.\n"
            colTip += "💡 ICT: This is the stop hunt above the high.\n"
            colTip += "Smart money sold INTO the breakout buyers.\n"
            colTip += "Look to SHORT on the O column that follows."
        else if trapFlag == -1
            colTip += "\n━━━━━━━━━━━━━━━━\n🪤 BEAR TRAP / LIQUIDITY SWEEP\n"
            colTip += "This O broke below prior support then\n"
            colTip += "IMMEDIATELY reversed to X. Trapped shorts\n"
            colTip += "are now fuel for the move up.\n"
            colTip += "💡 ICT: This is the stop hunt below the low.\n"
            colTip += "Smart money bought INTO the breakdown sellers.\n"
            colTip += "Look to LONG on the X column that follows."
        
        // Pattern highlight box
        if patEnabled and array.size(colPatFlag) > col
            int pf = array.get(colPatFlag, col)
            if pf != 0
                float pyTop = f_row_to_y(rTop, rowsTotal, zoneBot, zoneTop) + (zoneTop - zoneBot) / float(rowsTotal) * 0.5
                float pyBot = f_row_to_y(rBot, rowsTotal, zoneBot, zoneTop) - (zoneTop - zoneBot) / float(rowsTotal) * 0.5
                int pxL = xMid - int(math.floor(float(pnfColSpace) / 2.0))
                int pxR = xMid + int(math.ceil(float(pnfColSpace) / 2.0))
                color pc = pf == 1 ? patBullColor : patBearColor
                array.push(patternBoxes, box.new(pxL, pyTop, pxR, pyBot, bgcolor=pc, border_color=pc, border_width=1))
        
        // Trap marker
        if trapEnabled and trapFlag != 0
            color trapC = trapFlag == 1 ? trapBullColor : trapBearColor
            float trapMarkerY = trapFlag == 1 ? f_row_to_y(rTop, rowsTotal, zoneBot, zoneTop) + (zoneTop - zoneBot) / float(rowsTotal) * 0.8 : f_row_to_y(rBot, rowsTotal, zoneBot, zoneTop) - (zoneTop - zoneBot) / float(rowsTotal) * 0.8
            trapMarkerY := math.max(math.min(trapMarkerY, zoneTop), zoneBot)
            array.push(trapLabels, label.new(xMid, trapMarkerY, "🪤",
                 style=label.style_label_center, textcolor=trapC,
                 color=color.new(chart.bg_color, 100), size=size.small, tooltip=(trapFlag == 1 ? "🪤 BULL TRAP — Longs trapped above resistance" : "🪤 BEAR TRAP — Shorts trapped below support")))
        
        // Volume weighting
        int vwTransp = 0
        if vwEnabled and vwMode == "Opacity"
            float vRng = math.max(volMax - volMin, 1.0)
            float volPct = (colVol - volMin) / vRng
            vwTransp := int(math.round(float(vwMaxTransp) - volPct * float(vwMaxTransp - vwMinTransp)))
        
        string ch = dCol == 1 ? "X" : "O"
        color  baseC = dCol == 1 ? pnfXColor : pnfOColor
        color  tc = vwEnabled and vwMode == "Opacity" ? color.new(baseC, vwTransp) : baseC
        string useSize = pnfGlyphSizeIn
        if vwEnabled and vwMode == "Size"
            string szResult = switch f_vwGlyphSize(colVol, volMin, volMax)
                size.huge   => "Huge"
                size.large  => "Large"
                size.normal => "Normal"
                size.small  => "Small"
                => "Tiny"
            useSize := szResult
        
        // Draw glyphs
        int midRow = rTop + int((rBot - rTop) / 2)
        for r = rTop to rBot
            float y = f_row_to_y(r, rowsTotal, zoneBot, zoneTop)
            string glyphTip = r == midRow ? colTip : ""
            label lb = label.new(xMid, y, ch, style=label.style_label_center,
                textcolor=tc, color=color.new(chart.bg_color, 100),
                size=f_labelSize(useSize), tooltip=glyphTip)
            array.push(pnfGlyphs, lb)
        
        // Box count label
        if bcEnabled and boxCount > 0
            float rowH = (zoneTop - zoneBot) / float(math.max(rowsTotal, 1))
            float bcY = dCol == 1 ? f_row_to_y(rTop, rowsTotal, zoneBot, zoneTop) + rowH * 0.6 : f_row_to_y(rBot, rowsTotal, zoneBot, zoneTop) - rowH * 0.6
            bcY := math.max(math.min(bcY, zoneTop), zoneBot)
            string bcTip = "📦 BOX COUNT: " + str.tostring(boxCount) + "\n━━━━━━━━━━━━━━━━\n"
            bcTip += "Range: " + f_priceStr(tCol - bCol) + " pts\n"
            bcTip += (boxCount >= 6 ? "🔥 STRONG THRUST — high conviction move.\n" : boxCount >= 4 ? "📊 Moderate move — normal column.\n" : "💤 Shallow column — weak conviction.\n")
            bcTip += "💡 Compare box count to time-in-column:\n"
            bcTip += "Many boxes / few bars = MOMENTUM (panic/FOMO)\n"
            bcTip += "Few boxes / many bars = ABSORPTION (quiet accumulation)"
            array.push(boxCountLabels, label.new(xMid, bcY, str.tostring(boxCount),
                 style=label.style_label_center, textcolor=bcColor,
                 color=color.new(chart.bg_color, 100), size=size.tiny, tooltip=bcTip))
        
        // Time-in-column counter
        if tcEnabled and array.size(colBarsArr) > col
            int cBars = array.get(colBarsArr, col)
            float rowH2 = (zoneTop - zoneBot) / float(math.max(rowsTotal, 1))
            float tcY = dCol == 1 ? f_row_to_y(rBot, rowsTotal, zoneBot, zoneTop) - rowH2 * 0.6 : f_row_to_y(rTop, rowsTotal, zoneBot, zoneTop) + rowH2 * 0.6
            tcY := math.max(math.min(tcY, zoneTop), zoneBot)
            float barsPerBox = boxCount > 0 ? float(cBars) / float(boxCount) : 0.0
            bool isAbsorption = barsPerBox > 3.0 and boxCount <= 3
            bool isMomentum = barsPerBox < 1.5 and boxCount >= 4
            string tcTip = "⏱ TIME-IN-COLUMN: " + str.tostring(cBars) + " bars\n━━━━━━━━━━━━━━━━\n"
            tcTip += "Boxes: " + str.tostring(boxCount) + " | Bars/Box: " + str.tostring(barsPerBox, "#.1") + "\n"
            tcTip += "━━━━━━━━━━━━━━━━\n"
            if isAbsorption
                tcTip += "🧲 ABSORPTION DETECTED\n"
                tcTip += "Many bars, few boxes = smart money is quietly\n"
                tcTip += "accumulating/distributing at this level.\n"
                tcTip += "The next column break will be significant.\n"
                tcTip += "This is the institutional footprint — they need\n"
                tcTip += "TIME to fill large orders without moving price.\n"
            else if isMomentum
                tcTip += "🚀 MOMENTUM / PANIC\n"
                tcTip += "Few bars, many boxes = price moved fast.\n"
                tcTip += "This is FOMO (if X) or PANIC (if O).\n"
                tcTip += "These columns often overshoot — watch for\n"
                tcTip += "exhaustion and reversal at the extreme.\n"
            else
                tcTip += "📊 Normal pace — no special microstructure signal.\n"
            tcTip += "━━━━━━━━━━━━━━━━\n"
            tcTip += "💡 EDGE: Absorption → Breakout is the\nhighest-conviction PnF trade. Identify absorption\ncolumns, then enter on the breakout column\nwith stops behind the absorption zone."
            string tcText = str.tostring(cBars) + "b"
            array.push(timeColLabels, label.new(xMid, tcY, tcText,
                 style=label.style_label_center, textcolor=tcColor,
                 color=color.new(chart.bg_color, 100), size=size.tiny, tooltip=tcTip))

// ──────────────────────────────────────────────────────────────────────────────
// PnF: DRAW GANN LINES
// ──────────────────────────────────────────────────────────────────────────────
f_pnf_draw_gann_lines(int colCountDraw, float hiAll, float loAll, float hBullTarget, float hBearTarget, float gridHi, float step, int rowsTotal) =>
    if gannEnabled and colCountDraw >= 3
        // Horizontal count target lines
        if gannShowHTarget and not na(hBullTarget) and not na(hBearTarget)
            float winRange = zoneTop - zoneBot
            float pricePerY = winRange / math.max(hiAll - loAll, syminfo.mintick)
            
            // Bull target
            if hBullTarget <= hiAll + (hiAll - loAll) * 2
                float yBT = zoneBot + (hBullTarget - loAll) * pricePerY
                yBT := math.min(yBT, zoneTop)
                if yBT >= zoneBot and yBT <= zoneTop
                    array.push(gannLines, line.new(winLeft, yBT, winRight, yBT,
                         color=gannBullTarget, width=1, style=line.style_dashed))
            
            // Bear target
            if hBearTarget >= loAll - (hiAll - loAll) * 2
                float yBR = zoneBot + (hBearTarget - loAll) * pricePerY
                yBR := math.max(yBR, zoneBot)
                if yBR >= zoneBot and yBR <= zoneTop
                    array.push(gannLines, line.new(winLeft, yBR, winRight, yBR,
                         color=gannBearTarget, width=1, style=line.style_dashed))
        
        // Vertical count target for most recent column
        if gannShowVTarget and colCountDraw > 0
            int d0 = array.get(colDirArr, 0)
            int rT0 = int(math.round((gridHi - array.get(colTopArr, 0)) / step))
            int rB0 = int(math.round((gridHi - array.get(colBotArr, 0)) / step))
            int bc0 = math.abs(rB0 - rT0) + 1
            float vM = float(bc0) * pnfBoxSize * float(pnfReversal)
            float vTarg = d0 == 1 ? array.get(colBotArr, 0) + vM : array.get(colTopArr, 0) - vM
            float pricePerY2 = (zoneTop - zoneBot) / math.max(hiAll - loAll, syminfo.mintick)
            float yVT = zoneBot + (vTarg - loAll) * pricePerY2
            if yVT >= zoneBot and yVT <= zoneTop
                color vLineC = d0 == 1 ? gannBullTarget : gannBearTarget
                array.push(gannLines, line.new(winLeft, yVT, winRight, yVT,
                     color=vLineC, width=1, style=line.style_dotted))

// ──────────────────────────────────────────────────────────────────────────────
// PnF: DRAW 45° TREND LINES
// ──────────────────────────────────────────────────────────────────────────────
f_pnf_draw_trend_lines(int colCountDraw, float gridHi, float step, int rowsTotal) =>
    if tlEnabled and colCountDraw >= 3
        int bullAnchorCol = -1
        float bullAnchorBot = na
        int bearAnchorCol = -1
        float bearAnchorTop = na
        for tc = 0 to colCountDraw - 1
            int td = array.get(colDirArr, tc)
            if td == -1
                float tb = array.get(colBotArr, tc)
                if na(bullAnchorBot) or tb < bullAnchorBot
                    bullAnchorBot := tb
                    bullAnchorCol := tc
            if td == 1
                float tt = array.get(colTopArr, tc)
                if na(bearAnchorTop) or tt > bearAnchorTop
                    bearAnchorTop := tt
                    bearAnchorCol := tc
        
        if bullAnchorCol >= 0 and not na(bullAnchorBot)
            int bsr = int(math.round((gridHi - bullAnchorBot) / step))
            bsr := f_clamp_int(bsr, 0, rowsTotal - 1)
            float prevY = na
            int   prevX = na
            for tc = bullAnchorCol to 0
                int cr = bsr - (bullAnchorCol - tc)
                if cr < 0
                    break
                float yy = f_row_to_y(cr, rowsTotal, zoneBot, zoneTop)
                int xx = winRight - tc * pnfColSpace - int(math.ceil(float(pnfColSpace) / 2.0))
                if not na(prevY) and not na(prevX)
                    array.push(trendLines, line.new(prevX, prevY, xx, yy,
                         color=tlBullColor, width=tlWidth, style=line.style_solid))
                prevY := yy
                prevX := xx
        
        if bearAnchorCol >= 0 and not na(bearAnchorTop)
            int bsr2 = int(math.round((gridHi - bearAnchorTop) / step))
            bsr2 := f_clamp_int(bsr2, 0, rowsTotal - 1)
            float prevY2 = na
            int   prevX2 = na
            for tc2 = bearAnchorCol to 0
                int cr2 = bsr2 + (bearAnchorCol - tc2)
                if cr2 >= rowsTotal
                    break
                float yy2 = f_row_to_y(cr2, rowsTotal, zoneBot, zoneTop)
                int xx2 = winRight - tc2 * pnfColSpace - int(math.ceil(float(pnfColSpace) / 2.0))
                if not na(prevY2) and not na(prevX2)
                    array.push(trendLines, line.new(prevX2, prevY2, xx2, yy2,
                         color=tlBearColor, width=tlWidth, style=line.style_solid))
                prevY2 := yy2
                prevX2 := xx2

// ──────────────────────────────────────────────────────────────────────────────
// PnF: DRAW PRICE LEVEL LABELS
// ──────────────────────────────────────────────────────────────────────────────
f_pnf_draw_price_labels(float gridHi, float step, int rowsTotal) =>
    if plEnabled and rowsTotal > 1
        string plSz = plSize == "Tiny" ? size.tiny : size.small
        int plX = winRight + 1
        for pr = 0 to rowsTotal - 1
            if pr % plEveryN == 0
                float priceAtRow = gridHi - float(pr) * step
                float yPL = f_row_to_y(pr, rowsTotal, zoneBot, zoneTop)
                string plText = str.tostring(priceAtRow, syminfo.mintick < 0.01 ? "#.####" : syminfo.mintick < 1 ? "#.##" : "#")
                string plTip = "📏 PRICE LEVEL: " + f_priceStr(priceAtRow) + "\n━━━━━━━━━━━━━━━━\n"
                plTip += "Grid Row: " + str.tostring(pr) + " / " + str.tostring(rowsTotal - 1) + "\n"
                plTip += "Box Size: " + f_priceStr(step) + "\n"
                plTip += "━━━━━━━━━━━━━━━━\n"
                plTip += "💡 Use these levels as precise S/R references.\n"
                plTip += "Each line = one box boundary where PnF columns\n"
                plTip += "can start, end, or reverse. These are the\n"
                plTip += "structural price levels that matter."
                array.push(priceLvlLabels, label.new(plX, yPL, plText,
                     style=label.style_label_left, textcolor=plColor,
                     color=color.new(chart.bg_color, 100), size=plSz, tooltip=plTip))

// ──────────────────────────────────────────────────────────────────────────────
// PnF: MAIN COORDINATOR - Returns [congBox, pnfInfoLabel, mtfIcon, ltfIcon, revLabel]
// ──────────────────────────────────────────────────────────────────────────────
f_render_pnf_mode() =>
    box _congBox = na
    label _pnfInfoLabel = na
    label _mtfIcon = na
    label _ltfIcon = na
    label _revLabel = na
    
    if not na(pnfBoxSize)
        int colCount = array.size(colDirArr)
        
        if colCount > 0
            // Overall range
            float hiAll = array.get(colTopArr, 0)
            float loAll = array.get(colBotArr, 0)
            for k = 0 to colCount - 1
                hiAll := math.max(hiAll, array.get(colTopArr, k))
                loAll := math.min(loAll, array.get(colBotArr, k))
            
            // Grid calculation
            int skip = 1
            float step = pnfBoxSize
            float gridHi = hiAll
            float gridLo = loAll
            int rowsTotal = 1
            
            for j = 0 to 200
                step := pnfBoxSize * float(skip)
                gridHi := math.ceil(hiAll / step) * step
                gridLo := math.floor(loAll / step) * step
                rowsTotal := int(math.round((gridHi - gridLo) / step)) + 1
                if rowsTotal <= pnfMaxRows
                    break
                skip += 1
            
            rowsTotal := math.max(1, rowsTotal)
            
            // FIX #4: Comprehensive label budget calculation
            int priceLabelCount = plEnabled ? int(math.ceil(float(rowsTotal) / float(plEveryN))) : 0
            int infoLabels = (pnfShowInfo ? 1 : 0) + (mtfEnabled ? 1 : 0) + (ltfEnabled ? 1 : 0) + (raEnabled ? 1 : 0)
            int trapReserve = trapEnabled ? 10 : 0
            int reserveLabels = priceLabelCount + infoLabels + trapReserve + 10
            int glyphBudget = 500 - reserveLabels
            int extraPerCol = (bcEnabled ? 1 : 0) + (tcEnabled ? 1 : 0)
            int labelsPerCol = math.max(1, rowsTotal + extraPerCol)
            int maxColsByLabels = math.max(1, int(math.floor(float(glyphBudget) / float(labelsPerCol))))
            int colCountDraw = math.min(colCount, maxColsByLabels)
            
            // Gann horizontal count
            [hCount, hCongTop, hCongBot, hBullTarget, hBearTarget, hCountTip] = f_pnf_gann_hcount(colCountDraw, pnfBoxSize)
            
            // Congestion zone box
            if gannEnabled and gannShowCongBox and not na(hCongTop) and not na(hCongBot) and hCount >= 2
                float priceToY = (zoneTop - zoneBot) / math.max(hiAll - loAll, syminfo.mintick)
                float yCongTop = zoneBot + (hCongTop - loAll) * priceToY
                float yCongBot = zoneBot + (hCongBot - loAll) * priceToY
                yCongTop := math.min(yCongTop, zoneTop)
                yCongBot := math.max(yCongBot, zoneBot)
                int congRight = winRight - 0
                int congLeft  = winRight - (hCount - 1) * pnfColSpace - pnfColSpace
                _congBox := box.new(congLeft, yCongTop, congRight, yCongBot,
                     bgcolor=gannCongColor, border_color=color.new(gannCongColor, 40), border_width=1)
            
            // Pattern detection (FIX #5: no var in function-local arrays)
            [colPatFlag, colPatName, colPatTip] = f_pnf_detect_patterns(colCountDraw, pnfBoxSize)
            
            // Trap detection (FIX #5b: no var on returned array)
            array<int> colTrapFlag = f_pnf_detect_traps(colCountDraw, pnfBoxSize)
            
            // Info labels
            _pnfInfoLabel := f_pnf_draw_info_label(hCountTip)
            // FIX #7: Use temp vars then := to avoid tuple shadowing
            [_mi, _li] = f_pnf_draw_mtf_ltf_icons()
            _mtfIcon := _mi
            _ltfIcon := _li
            _revLabel := f_pnf_draw_reversal_alert(colCountDraw)
            
            // Draw columns
            f_pnf_draw_columns_part1(colCountDraw, hiAll, loAll, gridHi, step, rowsTotal, colPatFlag, colPatName, colPatTip, colTrapFlag)
            
            // Gann lines
            f_pnf_draw_gann_lines(colCountDraw, hiAll, loAll, hBullTarget, hBearTarget, gridHi, step, rowsTotal)
            
            // Trend lines
            f_pnf_draw_trend_lines(colCountDraw, gridHi, step, rowsTotal)
            
            // Price labels
            f_pnf_draw_price_labels(gridHi, step, rowsTotal)
    
    [_congBox, _pnfInfoLabel, _mtfIcon, _ltfIcon, _revLabel]

// ══════════════════════════════════════════════════════════════════════════════
// ██  FIXED MAIN DISPATCHER
// ══════════════════════════════════════════════════════════════════════════════
//
// FIX #1 (CRITICAL): Global var singles are deleted + reset to na HERE at the
//   call site, NOT inside f_cleanup_arrays(). Pine v6 forbids modifying global
//   var variables inside functions.
//
// FIX #2 (CRITICAL): Use temp vars from function returns, then := assign to
//   the global var declarations. This prevents tuple destructuring from creating
//   local shadows that orphan the var references.
//
// FIX #8 (CRITICAL): f_pnf_build_columns() is called on EVERY bar at global
//   scope ABOVE this block. It is NOT called here inside barstate.islast.
//   This ensures Pine properly tracks the [i] history buffer for pnf_dir,
//   pnf_top, pnf_bot, and volume series.
//

if barstate.islast
    // ─── Step 1: Delete all single-object var drawings at GLOBAL scope ───
    // (Cannot do this inside a function in Pine v6)
    box.delete(bgBox)
    bgBox := na
    box.delete(obBox)
    obBox := na
    box.delete(osBox)
    osBox := na
    box.delete(scalperBox)
    scalperBox := na
    box.delete(congBox)
    congBox := na
    label.delete(pnfInfoLabel)
    pnfInfoLabel := na
    label.delete(mtfIcon)
    mtfIcon := na
    label.delete(ltfIcon)
    ltfIcon := na
    label.delete(revLabel)
    revLabel := na
    
    // ─── Step 2: Delete all array-based drawings (safe inside function) ───
    f_cleanup_arrays()
    
    // ─── Step 3: Draw shared elements ───
    bgBox := f_draw_background()
    
    // ─── Step 4: Mode-specific rendering ───
    if not usePnF
        // HA Mode — FIX #2: Use temp vars then := to update persistent var references
        [_ob, _os, _sb] = f_render_ha_mode()
        obBox      := _ob
        osBox      := _os
        scalperBox := _sb
    else
        // PnF Mode — columns already built on every bar above (FIX #8)
        // FIX #2: Use temp vars then := to update persistent var references
        [_cg, _pi, _mi, _li, _rl] = f_render_pnf_mode()
        congBox      := _cg
        pnfInfoLabel := _pi
        mtfIcon      := _mi
        ltfIcon      := _li
        revLabel     := _rl
