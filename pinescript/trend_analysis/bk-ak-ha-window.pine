bool  gannEnabled      = input.bool(true, "Enable Gann Counts", group=gGann,
     tooltip="Horizontal Count: measures congestion width to project breakout targets.\nVertical Count: measures column height to project price objectives.\nBoth are classic Gann/PnF methods for determining price targets.")
bool  gannShowHTarget  = input.bool(true, "Show Horizontal Count Target Lines", group=gGann)
bool  gannShowVTarget  = input.bool(true, "Show Vertical Count Target Lines", group=gGann)
