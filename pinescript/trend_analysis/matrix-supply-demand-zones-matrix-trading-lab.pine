//@version=5
indicator("Matrix Supply Demand Zones — GÖKTUĞ ÖZIŞIK | Matrix Trading Lab", shorttitle="Matrix SDZ | GÖKTUĞ", overlay=true, max_boxes_count=400, max_labels_count=200)

//══════════════════════════════════════════════════════════════════════════════
// INPUTS
//══════════════════════════════════════════════════════════════════════════════
groupCore   = "1. Core Settings"
groupZone   = "2. Zone Engine"
groupVisual = "3. Visual"
groupDash   = "4. Dashboard"
groupAlert  = "5. Alerts"

swingLen       = input.int(20, "Swing Length", minval=3, maxval=100, group=groupCore)
zoneSourceMode = input.string("Full Candle", "Zone Source", options=["Full Candle", "Body Only"], group=groupZone)
maxZones       = input.int(4, "Max Zones Per Side", minval=1, maxval=12, group=groupZone)
extendBars     = input.int(80, "Extend Zone Bars", minval=5, maxval=500, group=groupZone)
minZoneATR     = input.float(0.10, "Minimum Zone Size ATR", step=0.05, minval=0.0, maxval=10.0, group=groupZone)
maxZoneATR     = input.float(2.50, "Maximum Zone Size ATR", step=0.05, minval=0.1, maxval=20.0, group=groupZone)
autoRemove     = input.bool(true, "Auto Remove Invalidated Zones", group=groupZone)

showLabels      = input.bool(true, "Show Zone Labels", group=groupVisual)
showPivotMarks  = input.bool(false, "Show Pivot Marks", group=groupVisual)

showDashboard = input.bool(true, "Show Dashboard", group=groupDash)
dashboardPos  = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=groupDash)

enableCreationAlerts    = input.bool(true, "Enable Zone Creation Alerts", group=groupAlert)
enableInvalidationAlerts = input.bool(true, "Enable Invalidation Alerts", group=groupAlert)

//══════════════════════════════════════════════════════════════════════════════
// COLORS
//══════════════════════════════════════════════════════════════════════════════
demandBg     = color.new(#10b981, 84)
supplyBg     = color.new(#ef4444, 84)
demandBorder = color.new(#10b981, 15)
supplyBorder = color.new(#ef4444, 15)
bullColor    = #10b981
bearColor    = #ef4444
neutralColor = #9ca3af
panelBg      = color.new(color.black, 15)

//══════════════════════════════════════════════════════════════════════════════
// HELPERS
//══════════════════════════════════════════════════════════════════════════════
f_dash_pos(_pos) =>
    _pos == "Top Left" ? position.top_left : _pos == "Bottom Right" ? position.bottom_right : _pos == "Bottom Left" ? position.bottom_left : position.top_right

f_source_top(_idx) =>
    zoneSourceMode == "Body Only" ? math.max(open[_idx], close[_idx]) : high[_idx]

f_source_bottom(_idx) =>
    zoneSourceMode == "Body Only" ? math.min(open[_idx], close[_idx]) : low[_idx]

//══════════════════════════════════════════════════════════════════════════════
// CORE DATA
//══════════════════════════════════════════════════════════════════════════════
atr = ta.atr(14)

pivotHigh = ta.pivothigh(high, swingLen, swingLen)
pivotLow  = ta.pivotlow(low, swingLen, swingLen)

//══════════════════════════════════════════════════════════════════════════════
// STORAGE
//══════════════════════════════════════════════════════════════════════════════
var array<box> demandBoxes = array.new_box()
var array<float> demandTops = array.new_float()
var array<float> demandBottoms = array.new_float()
var array<label> demandLabels = array.new_label()

var array<box> supplyBoxes = array.new_box()
var array<float> supplyTops = array.new_float()
var array<float> supplyBottoms = array.new_float()
var array<label> supplyLabels = array.new_label()

var string lastEvent = "None"

var bool alertNewDemand = false
var bool alertNewSupply = false
var bool alertDemandInvalidated = false
var bool alertSupplyInvalidated = false

alertNewDemand := false
alertNewSupply := false
alertDemandInvalidated := false
alertSupplyInvalidated := false

//══════════════════════════════════════════════════════════════════════════════
// OPTIONAL PIVOT MARKS
//══════════════════════════════════════════════════════════════════════════════
if showPivotMarks and not na(pivotHigh)
    label.new(bar_index - swingLen, pivotHigh, "PH", xloc=xloc.bar_index, style=label.style_label_down, textcolor=bearColor, color=color.new(color.black, 100), size=size.tiny)

if showPivotMarks and not na(pivotLow)
    label.new(bar_index - swingLen, pivotLow, "PL", xloc=xloc.bar_index, style=label.style_label_up, textcolor=bullColor, color=color.new(color.black, 100), size=size.tiny)

//══════════════════════════════════════════════════════════════════════════════
// CREATE DEMAND ZONE
//══════════════════════════════════════════════════════════════════════════════
if not na(pivotLow)
    int src = swingLen
    float topVal = f_source_top(src)
    float botVal = f_source_bottom(src)
    float zoneSize = topVal - botVal
    bool validSize = zoneSize >= atr * minZoneATR and zoneSize <= atr * maxZoneATR

    if validSize
        box newBox = box.new(left=bar_index - src, top=topVal, right=bar_index + extendBars, bottom=botVal, border_color=demandBorder, bgcolor=demandBg)
        label newLabel = na

        if showLabels
            newLabel := label.new(bar_index - src, topVal, "Demand", xloc=xloc.bar_index, style=label.style_label_down, textcolor=bullColor, color=color.new(color.black, 100), size=size.tiny)

        array.unshift(demandBoxes, newBox)
        array.unshift(demandTops, topVal)
        array.unshift(demandBottoms, botVal)
        array.unshift(demandLabels, newLabel)

        if array.size(demandBoxes) > maxZones
            box oldB = array.pop(demandBoxes)
            float _ = array.pop(demandTops)
            float __ = array.pop(demandBottoms)
            label oldL = array.pop(demandLabels)
            box.delete(oldB)
            if not na(oldL)
                label.delete(oldL)

        alertNewDemand := true
        lastEvent := "New Demand Zone"

//══════════════════════════════════════════════════════════════════════════════
// CREATE SUPPLY ZONE
//══════════════════════════════════════════════════════════════════════════════
if not na(pivotHigh)
    int src = swingLen
    float topVal = f_source_top(src)
    float botVal = f_source_bottom(src)
    float zoneSize = topVal - botVal
    bool validSize = zoneSize >= atr * minZoneATR and zoneSize <= atr * maxZoneATR

    if validSize
        box newBox = box.new(left=bar_index - src, top=topVal, right=bar_index + extendBars, bottom=botVal, border_color=supplyBorder, bgcolor=supplyBg)
        label newLabel = na

        if showLabels
            newLabel := label.new(bar_index - src, botVal, "Supply", xloc=xloc.bar_index, style=label.style_label_up, textcolor=bearColor, color=color.new(color.black, 100), size=size.tiny)

        array.unshift(supplyBoxes, newBox)
        array.unshift(supplyTops, topVal)
        array.unshift(supplyBottoms, botVal)
        array.unshift(supplyLabels, newLabel)

        if array.size(supplyBoxes) > maxZones
            box oldB = array.pop(supplyBoxes)
            float _ = array.pop(supplyTops)
            float __ = array.pop(supplyBottoms)
            label oldL = array.pop(supplyLabels)
            box.delete(oldB)
            if not na(oldL)
                label.delete(oldL)

        alertNewSupply := true
        lastEvent := "New Supply Zone"

//══════════════════════════════════════════════════════════════════════════════
// UPDATE DEMAND ZONES
//══════════════════════════════════════════════════════════════════════════════
int demandCount = array.size(demandBoxes)
if demandCount > 0
    for i = demandCount - 1 to 0
        box b = array.get(demandBoxes, i)
        float topVal = array.get(demandTops, i)
        float botVal = array.get(demandBottoms, i)
        label lb = array.get(demandLabels, i)

        box.set_right(b, bar_index + extendBars)

        bool invalidated = close < botVal
        if invalidated
            alertDemandInvalidated := true
            lastEvent := "Demand Zone Invalidated"

            if autoRemove
                box.delete(b)
                if not na(lb)
                    label.delete(lb)
                array.remove(demandBoxes, i)
                array.remove(demandTops, i)
                array.remove(demandBottoms, i)
                array.remove(demandLabels, i)
            else
                box.set_bgcolor(b, color.new(bullColor, 94))
                box.set_border_color(b, color.new(bullColor, 85))
                if not na(lb)
                    label.set_text(lb, "Demand X")

//══════════════════════════════════════════════════════════════════════════════
// UPDATE SUPPLY ZONES
//══════════════════════════════════════════════════════════════════════════════
int supplyCount = array.size(supplyBoxes)
if supplyCount > 0
    for i = supplyCount - 1 to 0
        box b = array.get(supplyBoxes, i)
        float topVal = array.get(supplyTops, i)
        float botVal = array.get(supplyBottoms, i)
        label lb = array.get(supplyLabels, i)

        box.set_right(b, bar_index + extendBars)

        bool invalidated = close > topVal
        if invalidated
            alertSupplyInvalidated := true
            lastEvent := "Supply Zone Invalidated"

            if autoRemove
                box.delete(b)
                if not na(lb)
                    label.delete(lb)
                array.remove(supplyBoxes, i)
                array.remove(supplyTops, i)
                array.remove(supplyBottoms, i)
                array.remove(supplyLabels, i)
            else
                box.set_bgcolor(b, color.new(bearColor, 94))
                box.set_border_color(b, color.new(bearColor, 85))
                if not na(lb)
                    label.set_text(lb, "Supply X")

//══════════════════════════════════════════════════════════════════════════════
// LAST ZONE INFO
//══════════════════════════════════════════════════════════════════════════════
float lastDemandTop = array.size(demandTops) > 0 ? array.get(demandTops, 0) : na
float lastDemandBottom = array.size(demandBottoms) > 0 ? array.get(demandBottoms, 0) : na
float lastSupplyTop = array.size(supplyTops) > 0 ? array.get(supplyTops, 0) : na
float lastSupplyBottom = array.size(supplyBottoms) > 0 ? array.get(supplyBottoms, 0) : na

string zoneContext = not na(lastDemandTop) and close >= lastDemandBottom and close <= lastDemandTop ? "Inside Demand" :
     not na(lastSupplyTop) and close >= lastSupplyBottom and close <= lastSupplyTop ? "Inside Supply" :
     "Outside Zones"

//══════════════════════════════════════════════════════════════════════════════
// DASHBOARD
//══════════════════════════════════════════════════════════════════════════════
var table dash = table.new(position.top_right, 2, 7, border_width=1)

if barstate.islast
    table.set_position(dash, f_dash_pos(dashboardPos))

    if showDashboard
        string demandRange = na(lastDemandTop) ? "N/A" : str.tostring(lastDemandTop, format.mintick) + " / " + str.tostring(lastDemandBottom, format.mintick)
        string supplyRange = na(lastSupplyTop) ? "N/A" : str.tostring(lastSupplyTop, format.mintick) + " / " + str.tostring(lastSupplyBottom, format.mintick)

        table.cell(dash, 0, 0, "Matrix Trading Lab", text_color=color.white, bgcolor=color.new(color.black, 0))
        table.cell(dash, 1, 0, "Supply / Demand", text_color=color.white, bgcolor=color.new(color.black, 0))

        table.cell(dash, 0, 1, "Demand Zones", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 1, str.tostring(array.size(demandBoxes)), text_color=bullColor, bgcolor=panelBg)

        table.cell(dash, 0, 2, "Supply Zones", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 2, str.tostring(array.size(supplyBoxes)), text_color=bearColor, bgcolor=panelBg)

        table.cell(dash, 0, 3, "Last Demand", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 3, demandRange, text_color=bullColor, bgcolor=panelBg)

        table.cell(dash, 0, 4, "Last Supply", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 4, supplyRange, text_color=bearColor, bgcolor=panelBg)

        table.cell(dash, 0, 5, "Context", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 5, zoneContext, text_color=zoneContext == "Inside Demand" ? bullColor : zoneContext == "Inside Supply" ? bearColor : neutralColor, bgcolor=panelBg)

        table.cell(dash, 0, 6, "Last Event", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 6, lastEvent, text_color=color.white, bgcolor=panelBg)
    else
        for r = 0 to 6
            table.cell(dash, 0, r, "", bgcolor=color.new(color.black, 100))
            table.cell(dash, 1, r, "", bgcolor=color.new(color.black, 100))

//══════════════════════════════════════════════════════════════════════════════
// ALERTS
//══════════════════════════════════════════════════════════════════════════════
alertcondition(enableCreationAlerts and alertNewDemand, "New Demand Zone", "Matrix Supply Demand Zones: New demand zone created")
alertcondition(enableCreationAlerts and alertNewSupply, "New Supply Zone", "Matrix Supply Demand Zones: New supply zone created")

alertcondition(enableInvalidationAlerts and alertDemandInvalidated, "Demand Zone Invalidated", "Matrix Supply Demand Zones: Demand zone invalidated")
alertcondition(enableInvalidationAlerts and alertSupplyInvalidated, "Supply Zone Invalidated", "Matrix Supply Demand Zones: Supply zone invalidated")
