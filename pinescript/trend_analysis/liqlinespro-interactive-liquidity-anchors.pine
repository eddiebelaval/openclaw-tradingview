//@version=5
indicator("LiqLinesPRO", overlay=true, max_lines_count=500, max_labels_count=500)

// === RENK PALETİ ===
color modernGreen = #089981
color modernRed   = #f23645
color alertYellow = #ffeb3b 
color alertText   = color.black

// ÖZEL EMA RENKLERİ
color photoEma7  = #ffb22d // Turuncu-Sarı
color photoEma25 = #cc3299 // Fuşya-Pembe
color photoEma99 = #7e57c2 // Mor-Lila

// === AYARLAR ===
grp_ema = "📊 BİNANCE MOBİL EMA"
showEmaSet = input.bool(true, "EMA Setini Göster/Gizle", group=grp_ema)
showEma7   = input.bool(true, "EMA 7", group=grp_ema)
showEma25  = input.bool(true, "EMA 25", group=grp_ema)
showEma99  = input.bool(true, "EMA 99", group=grp_ema)

// EMA Hesaplamaları
ema7  = ta.ema(close, 7)
ema25 = ta.ema(close, 25)
ema99 = ta.ema(close, 99)

// EMA Çizimleri
plot(showEmaSet and showEma7 ? ema7 : na, title="EMA 7", color=photoEma7, linewidth=1)
plot(showEmaSet and showEma25 ? ema25 : na, title="EMA 25", color=photoEma25, linewidth=1)
plot(showEmaSet and showEma99 ? ema99 : na, title="EMA 99", color=photoEma99, linewidth=1)

// --- LİQUİDİTY LİNES AYARLARI ---
grp_man = "🎯 MANUEL ÇAPALAR"
manualDip = input.price(0, "Manuel DIP", confirm=true, group=grp_man)
manualTop = input.price(0, "Manuel TOP", confirm=true, group=grp_man)

grp_label = "🏷️ ETİKET AYARLARI"
labelOffset = input.int(20, "Etiket Boşluk", minval=0, group=grp_label)
lblSizeInput = input.string("Büyük", "Etiket Boyutu", options=["Küçük", "Normal", "Büyük", "Çok Büyük"], group=grp_label)

sizeWatcher = lblSizeInput == "Küçük" ? 1 : lblSizeInput == "Normal" ? 2 : lblSizeInput == "Büyük" ? 3 : 4
get_size(s) =>
    s == "Küçük" ? size.small : s == "Normal" ? size.normal : s == "Büyük" ? size.large : size.huge
selectedSize = get_size(lblSizeInput)

grp_auto = "⚙️ OTOMATİK MOTOR AYARLARI"
lengthInput = input.int(500, "Geriye Dönük Mum Bakışı", minval=10, maxval=5000, group=grp_auto)
showDip     = input.bool(true, "Dip Seviyeleri", group=grp_auto)
showTop     = input.bool(true, "Tepe Seviyeleri", group=grp_auto)

// === SEVİYE SEÇİCİLER ===
grp_sel_dip = "📈 DİP SEVİYELERİ AKTİF ET"
sD1 = input.bool(true, "%1.00", group=grp_sel_dip), sD2 = input.bool(true, "%1.33", group=grp_sel_dip)
sD3 = input.bool(true, "%2.00", group=grp_sel_dip), sD4 = input.bool(true, "%3.33", group=grp_sel_dip)
sD5 = input.bool(true, "%4.00", group=grp_sel_dip), sD6 = input.bool(true, "%5.00", group=grp_sel_dip)
sD10 = input.bool(true, "%10.00", group=grp_sel_dip), sD20 = input.bool(true, "%20.00", group=grp_sel_dip)
sD33 = input.bool(true, "%33.33", group=grp_sel_dip), sD40 = input.bool(true, "%40.00", group=grp_sel_dip)
sD50 = input.bool(true, "%50.00", group=grp_sel_dip), sD125 = input.bool(true, "%125.0", group=grp_sel_dip)
sD238 = input.bool(true, "%238.0", group=grp_sel_dip)

grp_sel_top = "📉 TEPE SEVİYELERİ AKTİF ET"
sT1 = input.bool(true, "%1.00", group=grp_sel_top), sT2 = input.bool(true, "%1.33", group=grp_sel_top)
sT3 = input.bool(true, "%2.00", group=grp_sel_top), sT4 = input.bool(true, "%3.33", group=grp_sel_top)
sT5 = input.bool(true, "%4.00", group=grp_sel_top), sT6 = input.bool(true, "%5.00", group=grp_sel_top)
sT10 = input.bool(true, "%10.00", group=grp_sel_top), sT20 = input.bool(true, "%20.00", group=grp_sel_top)
sT33 = input.bool(true, "%33.33", group=grp_sel_top), sT40 = input.bool(true, "%40.00", group=grp_sel_top)
sT50 = input.bool(true, "%50.00", group=grp_sel_top), sT75 = input.bool(true, "%75.00", group=grp_sel_top)
sT87 = input.bool(true, "%87.50", group=grp_sel_top)

// === DİNAMİK LİSTE OLUŞTURMA ===
var p_dip_vals = array.new_float(0), var p_dip_txt  = array.new_string(0)
var p_top_vals = array.new_float(0), var p_top_txt  = array.new_string(0)

array.clear(p_dip_vals), array.clear(p_dip_txt)
array.clear(p_top_vals), array.clear(p_top_txt)

if sD1 
    array.push(p_dip_vals, 0.01)
    array.push(p_dip_txt, "%1.00")
if sD2 
    array.push(p_dip_vals, 0.0133)
    array.push(p_dip_txt, "%1.33")
if sD3 
    array.push(p_dip_vals, 0.02)
    array.push(p_dip_txt, "%2.00")
if sD4 
    array.push(p_dip_vals, 0.0333)
    array.push(p_dip_txt, "%3.33")
if sD5 
    array.push(p_dip_vals, 0.04)
    array.push(p_dip_txt, "%4.00")
if sD6 
    array.push(p_dip_vals, 0.05)
    array.push(p_dip_txt, "%5.00")
if sD10 
    array.push(p_dip_vals, 0.10)
    array.push(p_dip_txt, "%10.00")
if sD20 
    array.push(p_dip_vals, 0.20)
    array.push(p_dip_txt, "%20.00")
if sD33 
    array.push(p_dip_vals, 0.3333)
    array.push(p_dip_txt, "%33.33")
if sD40 
    array.push(p_dip_vals, 0.40)
    array.push(p_dip_txt, "%40.00")
if sD50 
    array.push(p_dip_vals, 0.50)
    array.push(p_dip_txt, "%50.00")
if sD125
    array.push(p_dip_vals, 1.25)
    array.push(p_dip_txt, "%125.0")
if sD238
    array.push(p_dip_vals, 2.38)
    array.push(p_dip_txt, "%238.0")

if sT1 
    array.push(p_top_vals, 0.01)
    array.push(p_top_txt, "%1.00")
if sT2 
    array.push(p_top_vals, 0.0133)
    array.push(p_top_txt, "%1.33")
if sT3 
    array.push(p_top_vals, 0.02)
    array.push(p_top_txt, "%2.00")
if sT4 
    array.push(p_top_vals, 0.0333)
    array.push(p_top_txt, "%3.33")
if sT5 
    array.push(p_top_vals, 0.04)
    array.push(p_top_txt, "%4.00")
if sT6 
    array.push(p_top_vals, 0.05)
    array.push(p_top_txt, "%5.00")
if sT10 
    array.push(p_top_vals, 0.10)
    array.push(p_top_txt, "%10.00")
if sT20 
    array.push(p_top_vals, 0.20)
    array.push(p_top_txt, "%20.00")
if sT33 
    array.push(p_top_vals, 0.3333)
    array.push(p_top_txt, "%33.33")
if sT40 
    array.push(p_top_vals, 0.40)
    array.push(p_top_txt, "%40.00")
if sT50 
    array.push(p_top_vals, 0.50)
    array.push(p_top_txt, "%50.00")
if sT75 
    array.push(p_top_vals, 0.75)
    array.push(p_top_txt, "%75.00")
if sT87 
    array.push(p_top_vals, 0.875)
    array.push(p_top_txt, "%87.50")

// === HESAPLAR VE DEPOLAMA ===
float activeDip = (manualDip != 0) ? manualDip : ta.lowest(low, lengthInput)
float activeTop = (manualTop != 0) ? manualTop : ta.highest(high, lengthInput)

var line dipRefLine = na, var line topRefLine = na
var line[] dipLines = array.new_line(0), var line[] topLines = array.new_line(0)
var label[] allLabels = array.new_label(0)

clearElements(l_array, lbl_array) =>
    if array.size(l_array) > 0
        for i = 0 to array.size(l_array) - 1
            line.delete(array.get(l_array, i))
        array.clear(l_array)
    if array.size(lbl_array) > 0
        for i = 0 to array.size(lbl_array) - 1
            label.delete(array.get(lbl_array, i))
        array.clear(lbl_array)

// Yönlü Yakınlık
is_near(price, level, direction) =>
    threshold = level * 0.001
    dist = math.abs(price - level)
    if direction > 0 // TOP
        dist <= threshold and price >= level
    else if direction < 0 // DIP
        dist <= threshold and price <= level
    else
        false

// === ÇİZİM DÖNGÜSÜ ===
updateDip = ta.change(activeDip) or ta.change(sizeWatcher) or barstate.islast
updateTop = ta.change(activeTop) or ta.change(sizeWatcher) or barstate.islast

if showDip and updateDip
    line.delete(dipRefLine)
    clearElements(dipLines, allLabels)
    int targetX = bar_index + labelOffset
    color dCol = is_near(close, activeDip, -1) ? alertYellow : modernGreen
    color dTCol = is_near(close, activeDip, -1) ? alertText : color.white
    dipRefLine := line.new(bar_index - 1, activeDip, bar_index, activeDip, extend=extend.both, color=dCol, width=1)
    array.push(allLabels, label.new(targetX, activeDip, "DIP: " + str.tostring(activeDip, format.mintick), color=dCol, textcolor=dTCol, style=label.style_label_left, size=selectedSize))
    if array.size(p_dip_vals) > 0
        for i = 0 to array.size(p_dip_vals) - 1
            float val = activeDip * (1 + array.get(p_dip_vals, i))
            color c = is_near(close, val, -1) ? alertYellow : modernGreen
            color tc = is_near(close, val, -1) ? alertText : color.white
            array.push(dipLines, line.new(bar_index, val, bar_index + 1, val, extend=extend.right, color=color.new(c, 50), style=line.style_dashed, width=1))
            array.push(allLabels, label.new(targetX, val, array.get(p_dip_txt, i) + " - " + str.tostring(val, format.mintick), color=color.new(c, 30), textcolor=tc, style=label.style_label_left, size=selectedSize))

if showTop and updateTop
    line.delete(topRefLine)
    if array.size(topLines) > 0
        for i = 0 to array.size(topLines) - 1
            line.delete(array.get(topLines, i))
        array.clear(topLines)
    int targetX = bar_index + labelOffset
    color tCol = is_near(close, activeTop, 1) ? alertYellow : modernRed
    color tTCol = is_near(close, activeTop, 1) ? alertText : color.white
    topRefLine := line.new(bar_index - 1, activeTop, bar_index, activeTop, extend=extend.both, color=tCol, width=1)
    array.push(allLabels, label.new(targetX, activeTop, "TOP: " + str.tostring(activeTop, format.mintick), color=tCol, textcolor=tTCol, style=label.style_label_left, size=selectedSize))
    if array.size(p_top_vals) > 0
        for i = 0 to array.size(p_top_vals) - 1
            float val = activeTop * (1 - array.get(p_top_vals, i))
            color c = is_near(close, val, 1) ? alertYellow : modernRed
            color tc = is_near(close, val, 1) ? alertText : color.white
            array.push(topLines, line.new(bar_index, val, bar_index + 1, val, extend=extend.right, color=color.new(c, 50), style=line.style_dashed, width=1))
            array.push(allLabels, label.new(targetX, val, array.get(p_top_txt, i) + " - " + str.tostring(val, format.mintick), color=color.new(c, 30), textcolor=tc, style=label.style_label_left, size=selectedSize))

// ==========================================
// === EK: YÜKSELEN VE DÜŞEN TREND MODÜLÜ ===
// ==========================================
grp_trend = "📈 OTOMATİK TREND MODÜLÜ"
showTrendLines = input.bool(true, "Trend Çizgilerini Göster", group=grp_trend)
trendLookback  = input.int(10, "Trend Hassasiyeti (Pivot)", minval=2, group=grp_trend)

var line highTrend = na
var line lowTrend  = na

// Tepe ve Dip Noktalarını Bul (Pivot)
ph_val = ta.pivothigh(high, trendLookback, trendLookback)
pl_val = ta.pivotlow(low, trendLookback, trendLookback)

// Düşen Trend (Son iki Tepeyi birleştir)
var float ph2_v = na, var int ph2_x = na
var float ph1_v = na, var int ph1_x = na

if not na(ph_val)
    ph2_v := ph1_v, ph2_x := ph1_x
    ph1_v := ph_val, ph1_x := bar_index[trendLookback]
    if not na(ph2_v) and showTrendLines
        line.delete(highTrend)
        highTrend := line.new(ph2_x, ph2_v, ph1_x, ph1_v, color=color.blue, width=1, extend=extend.right)

// Yükselen Trend (Son iki Dibi birleştir)
var float pl2_v = na, var int pl2_x = na
var float pl1_v = na, var int pl1_x = na

if not na(pl_val)
    pl2_v := pl1_v, pl2_x := pl1_x
    pl1_v := pl_val, pl1_x := bar_index[trendLookback]
    if not na(pl2_v) and showTrendLines
        line.delete(lowTrend)
        lowTrend := line.new(pl2_x, pl2_v, pl1_x, pl1_v, color=color.blue, width=1, extend=extend.right)
