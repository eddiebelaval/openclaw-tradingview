// =====================================================
// === SHORT LEVEL MARKERS FOR EVERY SIGNAL
// =====================================================
levelBars = input.int(2, "Small Level Line Length", minval=1, maxval=5)

// BUY signal drawings
if buySignal
    entryLine  := close
    slLine     := st
    risk       = entryLine - slLine
    targetLine := risk > 0 ? entryLine + (1.0 * risk) : na

    if not na(slLine)
        line.new(
             x1 = bar_index,
             y1 = slLine,
             x2 = bar_index + levelBars,
             y2 = slLine,
             xloc = xloc.bar_index,
             extend = extend.none,
             color = color.yellow,
             width = 5,
             style = line.style_solid)

        label.new(
             x = bar_index + levelBars + 1,
             y = slLine,
             text = "SL " + str.tostring(slLine, format.mintick),
             xloc = xloc.bar_index,
             style = label.style_label_left,
             color = color.yellow,
             textcolor = color.black,
             size = size.tiny)

    if not na(targetLine)
        line.new(
             x1 = bar_index,
             y1 = targetLine,
             x2 = bar_index + levelBars,
             y2 = targetLine,
             xloc = xloc.bar_index,
             extend = extend.none,
             color = color.orange,
             width = 2,
             style = line.style_solid)

        label.new(
             x = bar_index + levelBars + 1,
             y = targetLine,
             text = "TGT " + str.tostring(targetLine, format.mintick),
             xloc = xloc.bar_index,
             style = label.style_label_left,
             color = color.orange,
             textcolor = color.black,
             size = size.tiny)

// SELL signal drawings
if sellSignal
    entryLine  := close
    slLine     := st
    risk       = slLine - entryLine
    targetLine := risk > 0 ? entryLine - (1.0 * risk) : na

    if not na(slLine)
        line.new(
             x1 = bar_index,
             y1 = slLine,
             x2 = bar_index + levelBars,
             y2 = slLine,
             xloc = xloc.bar_index,
             extend = extend.none,
             color = color.yellow,
             width = 2,
             style = line.style_solid)

        label.new(
             x = bar_index + levelBars + 1,
             y = slLine,
             text = "SL " + str.tostring(slLine, format.mintick),
             xloc = xloc.bar_index,
             style = label.style_label_left,
             color = color.yellow,
             textcolor = color.black,
             size = size.tiny)

    if not na(targetLine)
        line.new(
             x1 = bar_index,
             y1 = targetLine,
             x2 = bar_index + levelBars,
             y2 = targetLine,
             xloc = xloc.bar_index,
             extend = extend.none,
             color = color.orange,
             width = 2,
             style = line.style_solid)

        label.new(
             x = bar_index + levelBars + 1,
             y = targetLine,
             text = "TGT " + str.tostring(targetLine, format.mintick),
             xloc = xloc.bar_index,
             style = label.style_label_left,
             color = color.orange,
             textcolor = color.black,
             size = size.tiny)
// === Plots
plotshape(buySignal, title="Strong BUY", location=location.belowbar,
     color=color.teal, style=shape.triangleup, text="Strong\nBUY",
     textcolor=color.rgb(8, 8, 8), size=size.small)

plotshape(sellSignal, title="Strong SELL", location=location.abovebar,
     color=color.maroon, style=shape.triangledown, text="Strong\nSELL",
     textcolor=color.rgb(11, 6, 156), size=size.small)

// === Alerts
alertcondition(buySignal, title="STRONG_BUY",
     message='{"event":"STRONG_BUY","ticker":"{{ticker}}","price":{{close}},"time":"{{timenow}}","volume_3m":{{volume}},"note":"aboveAll+3mVol+oneSignalPerDay"}')

alertcondition(sellSignal, title="STRONG_SELL",
     message='{"event":"STRONG_SELL","ticker":"{{ticker}}","price":{{close}},"time":"{{timenow}}","volume_3m":{{volume}},"note":"belowAll+3mVol+oneSignalPerDay"}')
