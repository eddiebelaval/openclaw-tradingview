//@version=6
indicator("NIFTY 5-STAR Buy/Sell Indicator | Entry, SL & Targets", overlay=true, max_lines_count=500, max_labels_count=500)

// === Inputs
atrPeriod        = input.int(10,  "Supertrend ATR Period")
factor           = input.float(3.0, "Supertrend Factor")
emaPeriod        = input.int(21,  "EMA Period")
vwmaPeriod       = input.int(20,  "VWMA Period")
volMinBuy        = input.int(125000, "Min 3-Min Volume for BUY",  minval=0, step=1000)
volMinSell       = input.int(125000, "Min 3-Min Volume for SELL", minval=0, step=1000)
confirmOnClose   = input.bool(true, "Only alert on bar close")

// === Time Filter Inputs
startHour        = input.int(9, "Signal Start Hour")
startMinute      = input.int(31, "Signal Start Minute")
endHour          = input.int(15, "Signal End Hour")
endMinute        = input.int(0, "Signal End Minute")

// === EMA 21
ema21 = ta.ema(close, emaPeriod)
plot(ema21, "EMA 21", color=color.orange, linewidth=2)

// === VWAP
vwap = ta.vwap
plot(vwap, "VWAP", color=color.blue, linewidth=2)

// === VWMA 20
vwma = ta.vwma(close, vwmaPeriod)
plot(vwma, "VWMA 20", color=color.fuchsia, linewidth=2)

// === Supertrend
atr   = ta.atr(atrPeriod)
midHL = (high + low) / 2.0
upper = midHL + factor * atr
lower = midHL - factor * atr

var float st    = na
var bool  dirUp = true

if na(st)
    st    := close > upper ? lower : upper
    dirUp := close > upper
else
    if close > st[1]
        st    := math.max(lower, st[1])
        dirUp := true
    else
        st    := math.min(upper, st[1])
        dirUp := false

stColor = dirUp ? color.new(color.green, 0) : color.new(color.red, 0)
plot(st, "Supertrend", color=stColor, linewidth=2)

// =====================================================
// === 3-MIN TIMEFRAME VOLUME CHECKER
// =====================================================
vol3m = request.security(syminfo.tickerid, "3", volume, barmerge.gaps_off, barmerge.lookahead_off)

// === Strong Conditions
aboveAll  = close > ema21 and close > vwap and close > vwma and close > st
belowAll  = close < ema21 and close < vwap and close < vwma and close < st
volOKBuy  = vol3m >= volMinBuy
volOKSell = vol3m >= volMinSell

rawBuy    = aboveAll and volOKBuy
rawSell   = belowAll and volOKSell

baseBuySignal  = confirmOnClose ? (rawBuy and barstate.isconfirmed) : rawBuy
baseSellSignal = confirmOnClose ? (rawSell and barstate.isconfirmed) : rawSell

// =====================================================
// === TIME FILTER: 9:31 AM to 3:00 PM
// =====================================================
curMins   = hour * 60 + minute
startMins = startHour * 60 + startMinute
endMins   = endHour * 60 + endMinute

isAllowedTime = curMins >= startMins and curMins <= endMins

// =====================================================
// === STRICT ONE SIGNAL PER DAY
// =====================================================
newDay = dayofmonth != dayofmonth[1]

var bool signalTakenToday = false
if newDay
    signalTakenToday := false

buySignal  = baseBuySignal and isAllowedTime and not signalTakenToday
sellSignal = baseSellSignal and isAllowedTime and not signalTakenToday

if buySignal or sellSignal
    signalTakenToday := true

// =====================================================
// === SL + TARGET LEVELS (Persistent)
// =====================================================

var float slLine     = na
var float targetLine = na
var float entryLine  = na

// Reset every new day
if newDay
    slLine := na
    targetLine := na
    entryLine := na

// When BUY signal appears
if buySignal
    entryLine := close
    slLine := st
    risk = entryLine - slLine
    targetLine := entryLine + (risk * 1)

// When SELL signal appears
if sellSignal
    entryLine := close
    slLine := st
    risk = slLine - entryLine
    targetLine := entryLine - (risk * 1)

// plot(slLine, title="SL Supertrend Zone", color=color.yellow, linewidth=3, style=plot.style_line)

// plot(targetLine, title="Target 1:2", color=color.orange, linewidth=3, style=plot.style_line)
