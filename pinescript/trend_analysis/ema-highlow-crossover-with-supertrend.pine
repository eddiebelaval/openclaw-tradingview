//@version=5
indicator("EMA High/Low Crossover with Supertrend", overlay=true, max_labels_count=500)

// ============================================================================
// INPUTS
// ============================================================================
emaLength = input.int(50, "EMA Length", minval=1)
atrPeriod = input.int(10, "Supertrend ATR Period", minval=1)
atrMultiplier = input.float(3.0, "Supertrend ATR Multiplier", minval=0.1, step=0.1)
profitMultiplier = input.float(2.0, "Book Profit Multiplier", minval=1.0, step=0.1)
showTable = input.bool(true, "Show Signal Table")

// ============================================================================
// CALCULATE EMA FOR HIGH AND LOW (PERIOD 50)
// ============================================================================
emaHigh = ta.ema(high, emaLength)
emaLow = ta.ema(low, emaLength)

// ============================================================================
// CALCULATE SUPERTREND - Using ta.supertrend built-in
// ============================================================================
[supertrend, direction] = ta.supertrend(atrMultiplier, atrPeriod)

// Master Condition: Supertrend must be in uptrend (direction < 0 means uptrend in built-in function)
isSuperTrendUp = direction < 0

// ============================================================================
// POSITION TRACKING
// ============================================================================
var bool hasActiveBuy = false
var float buyPrice = na

// ============================================================================
// SIGNAL LOGIC
// ============================================================================

// Detect price crossovers
priceCrossAboveHigh = ta.crossover(close, emaHigh)
priceCrossBelowLow = ta.crossunder(close, emaLow)

// Calculate Book Profit ratio
emaDifference = emaHigh - emaLow
priceExtension = close - emaHigh
extensionRatio = emaDifference > 0 ? priceExtension / emaDifference : 0

// Initialize signals
buySignal = false
sellSignal = false
bookProfitSignal = false

// BUY: Price crosses above EMA High AND Supertrend is UP AND no active position
if priceCrossAboveHigh and isSuperTrendUp and not hasActiveBuy
    buySignal := true

// SELL: Price crosses below EMA Low AND has active position
if priceCrossBelowLow and hasActiveBuy
    sellSignal := true

// BOOK PROFIT: Extension >= 2x AND has active position
if hasActiveBuy and extensionRatio >= profitMultiplier
    bookProfitSignal := true

// Update position state
if buySignal
    hasActiveBuy := true
    buyPrice := close

if sellSignal or bookProfitSignal
    hasActiveBuy := false
    buyPrice := na

// ============================================================================
// TRACK LAST SIGNAL INFO
// ============================================================================
var string lastSignalType = "None"
var float lastSignalPrice = na
var float lastSignalEmaHigh = na
var float lastSignalEmaLow = na
var float lastSignalDiff = na
var float lastSignalExt = na
var float lastSignalRatio = na
var float lastSignalPL = na
var float lastSignalPLPct = na

if buySignal
    lastSignalType := "BUY"
    lastSignalPrice := close
    lastSignalEmaHigh := emaHigh
    lastSignalEmaLow := emaLow
    lastSignalDiff := na
    lastSignalExt := na
    lastSignalRatio := na
    lastSignalPL := na
    lastSignalPLPct := na

if sellSignal
    lastSignalType := "SELL"
    lastSignalPrice := close
    lastSignalEmaHigh := emaHigh
    lastSignalEmaLow := emaLow
    lastSignalDiff := na
    lastSignalExt := na
    lastSignalRatio := na
    if not na(buyPrice)
        lastSignalPL := close - buyPrice
        lastSignalPLPct := ((close - buyPrice) / buyPrice) * 100
    else
        lastSignalPL := na
        lastSignalPLPct := na

if bookProfitSignal
    lastSignalType := "BOOK PROFIT"
    lastSignalPrice := close
    lastSignalEmaHigh := emaHigh
    lastSignalEmaLow := emaLow
    lastSignalDiff := emaDifference
    lastSignalExt := priceExtension
    lastSignalRatio := extensionRatio
    if not na(buyPrice)
        lastSignalPL := close - buyPrice
        lastSignalPLPct := ((close - buyPrice) / buyPrice) * 100
    else
        lastSignalPL := na
        lastSignalPLPct := na

// ============================================================================
// PLOT INDICATORS
// ============================================================================
plot(emaHigh, "EMA High", color=color.green, linewidth=2)
plot(emaLow, "EMA Low", color=color.red, linewidth=2)
plot(supertrend, "Supertrend", color=isSuperTrendUp ? color.blue : color.orange, linewidth=2)

// ============================================================================
// PLOT SIGNALS
// ============================================================================
plotshape(buySignal, "BUY", shape.labelup, location.belowbar, color.green, text="BUY", textcolor=color.white, size=size.small)
plotshape(sellSignal, "SELL", shape.labeldown, location.abovebar, color.red, text="SELL", textcolor=color.white, size=size.small)
plotshape(bookProfitSignal, "BOOK PROFIT", shape.labeldown, location.abovebar, color.blue, text="BOOK", textcolor=color.white, size=size.small)

// ============================================================================
// INFORMATION TABLE
// ============================================================================
if showTable
    var tbl = table.new(position.top_right, 2, 13, border_width=1)
    
    table.cell(tbl, 0, 0, "Last Signal Info", bgcolor=color.gray, text_color=color.white)
    table.cell(tbl, 1, 0, "", bgcolor=color.gray, text_color=color.white)
    
    table.cell(tbl, 0, 1, "Position", bgcolor=color.new(color.gray, 80), text_color=color.white)
    posColor = hasActiveBuy ? color.new(color.green, 70) : color.new(color.gray, 70)
    table.cell(tbl, 1, 1, hasActiveBuy ? "LONG" : "FLAT", bgcolor=posColor, text_color=color.white)
    
    table.cell(tbl, 0, 2, "SuperTrend", bgcolor=color.new(color.gray, 80), text_color=color.white)
    stColor = isSuperTrendUp ? color.new(color.blue, 70) : color.new(color.orange, 70)
    table.cell(tbl, 1, 2, isSuperTrendUp ? "UPTREND" : "DOWNTREND", bgcolor=stColor, text_color=color.white)
    
    table.cell(tbl, 0, 3, "Last Signal", bgcolor=color.new(color.gray, 80), text_color=color.white)
    sigColor = lastSignalType == "BUY" ? color.new(color.green, 70) : lastSignalType == "SELL" ? color.new(color.red, 70) : lastSignalType == "BOOK PROFIT" ? color.new(color.blue, 70) : color.new(color.gray, 70)
    table.cell(tbl, 1, 3, lastSignalType, bgcolor=sigColor, text_color=color.white)
    
    table.cell(tbl, 0, 4, "Current Price", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(tbl, 1, 4, str.tostring(close, "#.##"), bgcolor=color.new(color.gray, 90), text_color=color.white)
    
    table.cell(tbl, 0, 5, "Signal Price", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(tbl, 1, 5, na(lastSignalPrice) ? "N/A" : str.tostring(lastSignalPrice, "#.##"), bgcolor=color.new(color.gray, 90), text_color=color.white)
    
    table.cell(tbl, 0, 6, "EMA High", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(tbl, 1, 6, str.tostring(emaHigh, "#.##"), bgcolor=color.new(color.gray, 90), text_color=color.white)
    
    table.cell(tbl, 0, 7, "EMA Low", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(tbl, 1, 7, str.tostring(emaLow, "#.##"), bgcolor=color.new(color.gray, 90), text_color=color.white)
    
    table.cell(tbl, 0, 8, "Current Ratio", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(tbl, 1, 8, hasActiveBuy ? str.tostring(extensionRatio, "#.##") + "x" : "N/A", bgcolor=color.new(color.gray, 90), text_color=color.white)
    
    table.cell(tbl, 0, 9, "EMA Diff", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(tbl, 1, 9, na(lastSignalDiff) ? "N/A" : str.tostring(lastSignalDiff, "#.##"), bgcolor=color.new(color.gray, 90), text_color=color.white)
    
    table.cell(tbl, 0, 10, "Extension", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(tbl, 1, 10, na(lastSignalExt) ? "N/A" : str.tostring(lastSignalExt, "#.##"), bgcolor=color.new(color.gray, 90), text_color=color.white)
    
    table.cell(tbl, 0, 11, "Signal Ratio", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(tbl, 1, 11, na(lastSignalRatio) ? "N/A" : str.tostring(lastSignalRatio, "#.##") + "x", bgcolor=color.new(color.gray, 90), text_color=color.white)
    
    table.cell(tbl, 0, 12, "P/L", bgcolor=color.new(color.gray, 80), text_color=color.white)
    plColor = na(lastSignalPL) ? color.new(color.gray, 90) : lastSignalPL > 0 ? color.new(color.green, 70) : color.new(color.red, 70)
    plText = na(lastSignalPL) ? "N/A" : str.tostring(lastSignalPL, "#.##") + " (" + str.tostring(lastSignalPLPct, "#.##") + "%)"
    table.cell(tbl, 1, 12, plText, bgcolor=plColor, text_color=color.white)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(buySignal, "BUY Signal", "BUY: Price crossed above EMA High with Supertrend uptrend")
alertcondition(sellSignal, "SELL Signal", "SELL: Price crossed below EMA Low")
alertcondition(bookProfitSignal, "Book Profit Signal", "BOOK PROFIT: Price extended 2x EMA range")

// ============================================================================
// BACKGROUND
// ============================================================================
bgcolor(isSuperTrendUp ? color.new(color.green, 95) : color.new(color.red, 95))
