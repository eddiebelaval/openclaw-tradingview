// ============================================================
//  RSI Range Shift Indicator
//  Author  : Claude (Anthropic)
//  Version : Pine Script v5
//  Description:
//    Detects RSI shifting between bullish (50–100) and bearish
//    (0–50) ranges, plots colored RSI zones, highlights
//    overbought/oversold levels, generates buy/sell signals,
//    and fires alerts on every range shift.
// ============================================================

//@version=5
indicator(title="RSI Range Shift", shorttitle="RSI-RS", overlay=false)

// ─── INPUTS ──────────────────────────────────────────────────
grp_rsi = "RSI Settings"
rsiLen      = input.int   (14,    "RSI Length",         minval=1,   group=grp_rsi)
rsiSource   = input.source(close, "RSI Source",                     group=grp_rsi)

grp_zones = "Zone Levels"
obLevel     = input.int   (70,    "Overbought Level",   minval=51, maxval=99, group=grp_zones)
osLevel     = input.int   (30,    "Oversold Level",     minval=1,  maxval=49, group=grp_zones)
midLevel    = input.int   (50,    "Mid / Range Level",  minval=1,  maxval=99, group=grp_zones)

grp_colors = "Colors"
colBull     = input.color (color.new(#00e5a0, 0),  "Bullish RSI",        group=grp_colors)
colBear     = input.color (color.new(#ff4c6a, 0),  "Bearish RSI",        group=grp_colors)
colOB       = input.color (color.new(#ff9800, 70), "Overbought Zone BG", group=grp_colors)
colOS       = input.color (color.new(#2196f3, 70), "Oversold Zone BG",   group=grp_colors)
colBuySig   = input.color (color.new(#00e5a0, 0),  "Buy Signal",         group=grp_colors)
colSellSig  = input.color (color.new(#ff4c6a, 0),  "Sell Signal",        group=grp_colors)

grp_sig = "Signal Settings"
showSignals = input.bool(true,  "Show Buy/Sell Signals", group=grp_sig)
sigOnShift  = input.bool(true,  "Signal Only on Range Shift (50 cross)", group=grp_sig)
sigOnOBOS   = input.bool(false, "Also Signal on OB/OS Cross",            group=grp_sig)

// ─── RSI CALCULATION ─────────────────────────────────────────
rsi = ta.rsi(rsiSource, rsiLen)

// ─── RANGE SHIFT DETECTION ───────────────────────────────────
isBullish      = rsi >= midLevel
isBearish      = rsi <  midLevel

// Crossovers of the midline (range shifts)
bullishShift   = ta.crossover (rsi, midLevel)   // bearish → bullish
bearishShift   = ta.crossunder(rsi, midLevel)   // bullish → bearish

// OB / OS crosses
crossAboveOB   = ta.crossover (rsi, obLevel)
crossBelowOB   = ta.crossunder(rsi, obLevel)
crossAboveOS   = ta.crossover (rsi, osLevel)
crossBelowOS   = ta.crossunder(rsi, osLevel)

// ─── SIGNAL LOGIC ────────────────────────────────────────────
buySignal  = showSignals and
             ((sigOnShift and bullishShift) or
              (sigOnOBOS  and crossAboveOS))

sellSignal = showSignals and
             ((sigOnShift and bearishShift) or
              (sigOnOBOS  and crossBelowOB))

// ─── PLOTS ───────────────────────────────────────────────────

// Background zone fills
obTop    = hline(100,     "Max",         color=color.new(color.gray, 100), linestyle=hline.style_dotted)
obLine   = hline(obLevel, "Overbought",  color=color.new(#ff9800, 50),     linestyle=hline.style_dashed, linewidth=1)
midLine  = hline(midLevel,"Mid",         color=color.new(color.gray, 60),  linestyle=hline.style_solid,  linewidth=1)
osLine   = hline(osLevel, "Oversold",    color=color.new(#2196f3, 50),     linestyle=hline.style_dashed, linewidth=1)
osBot    = hline(0,       "Min",         color=color.new(color.gray, 100), linestyle=hline.style_dotted)

fill(obTop,  obLine, color=colOB, title="Overbought Zone")
fill(osLine, osBot,  color=colOS, title="Oversold Zone")

// RSI line – colored by range
rsiColor = isBullish ? colBull : colBear
plot(rsi, title="RSI", color=rsiColor, linewidth=2)

// Range shift ribbon fill
rsiPlot = plot(rsi,       display=display.none)
midPlot = plot(midLevel,  display=display.none)
fill(rsiPlot, midPlot,
     color = isBullish
             ? color.new(colBull, 82)
             : color.new(colBear, 82),
     title = "Range Fill")

// Buy / Sell signals
plotshape(buySignal,
     title     = "Buy Signal",
     style     = shape.labelup,
     location  = location.bottom,
     color     = colBuySig,
     textcolor = color.white,
     text      = "BUY",
     size      = size.small)

plotshape(sellSignal,
     title     = "Sell Signal",
     style     = shape.labeldown,
     location  = location.top,
     color     = colSellSig,
     textcolor = color.white,
     text      = "SELL",
     size      = size.small)

// ─── ALERTS ──────────────────────────────────────────────────
alertcondition(bullishShift,
     title   = "RSI Bullish Range Shift",
     message = "{{ticker}} – RSI crossed ABOVE 50: Bullish range shift on {{interval}} chart. RSI = {{plot_0}}")

alertcondition(bearishShift,
     title   = "RSI Bearish Range Shift",
     message = "{{ticker}} – RSI crossed BELOW 50: Bearish range shift on {{interval}} chart. RSI = {{plot_0}}")

alertcondition(buySignal,
     title   = "RSI Buy Signal",
     message = "{{ticker}} – RSI Buy Signal triggered on {{interval}} chart. RSI = {{plot_0}}")

alertcondition(sellSignal,
     title   = "RSI Sell Signal",
     message = "{{ticker}} – RSI Sell Signal triggered on {{interval}} chart. RSI = {{plot_0}}")

alertcondition(crossAboveOB,
     title   = "RSI Entered Overbought",
     message = "{{ticker}} – RSI entered Overbought zone (above {{input_2}}) on {{interval}} chart.")

alertcondition(crossBelowOS,
     title   = "RSI Entered Oversold",
     message = "{{ticker}} – RSI entered Oversold zone (below {{input_1}}) on {{interval}} chart.")

// ─── INFO TABLE ──────────────────────────────────────────────
var table infoTable = table.new(position.top_right, 2, 4,
     bgcolor      = color.new(color.black, 70),
     border_width = 1,
     border_color = color.new(color.gray, 60))

if barstate.islast
    rangeLabel = isBullish ? "BULLISH" : "BEARISH"
    rangeColor = isBullish ? colBull   : colBear
    zoneLabel  = rsi >= obLevel ? "Overbought" :
                 rsi <= osLevel ? "Oversold"   : "Neutral"

    table.cell(infoTable, 0, 0, "RSI",       text_color=color.gray,  text_size=size.small)
    table.cell(infoTable, 1, 0, str.tostring(math.round(rsi, 2)),
               text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 1, "Range",     text_color=color.gray,  text_size=size.small)
    table.cell(infoTable, 1, 1, rangeLabel,  text_color=rangeColor,  text_size=size.small)

    table.cell(infoTable, 0, 2, "Zone",      text_color=color.gray,  text_size=size.small)
    table.cell(infoTable, 1, 2, zoneLabel,   text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 3, "Length",    text_color=color.gray,  text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(rsiLen),
               text_color=color.white, text_size=size.small)
