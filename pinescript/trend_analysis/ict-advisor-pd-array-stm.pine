//@version=5
indicator("ICT Advisor - PD Array Dashboard", shorttitle="ICT ADVISOR", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// ICT ADVISOR - PD ARRAY DASHBOARD
// Based on "The Inner Circle Trader" by Michael J. Huddleston
// Thai Translation by #TraderDen
// 
// ⚠️ THIS IS AN ANALYSIS TOOL - NOT A SIGNAL SYSTEM
// ⚠️ คุณต้องตัดสินใจเข้าเทรดด้วยตัวเอง
//
// ═══════════════════════════════════════════════════════════════════════════════
// BASED ON ICT BOOK STRUCTURE:
// ═══════════════════════════════════════════════════════════════════════════════
//
// 📖 DAILY BIAS (หน้า 430-450)
//    - Close > PDH = Bullish | Close < PDL = Bearish
//
// 📖 POWER OF 3 - AMD (หน้า 495-513)
//    - Accumulation (Asian) → Manipulation (London) → Distribution (NY)
//
// 📖 PD ARRAY MATRIX (หน้า 49-111, หน้า 256)
//    Premium Zone: Old Highs → Rejection Block → Order Block → FVG → Breaker → Mitigation
//    Discount Zone: Mitigation → Breaker → FVG → Order Block → Rejection Block → Old Lows
//
// 📖 LIQUIDITY (หน้า 300-363)
//    - External: BSL/SSL (PDH/PDL, PWH/PWL)
//    - Internal: FVG, Order Blocks
//    - "ราคาจะวิ่งไปหา Liquidity เสมอ"
//
// 📖 SESSIONS & KILLZONES (หน้า 382-494)
//    - Asian: Accumulation/Ranging
//    - London KZ: Creates HOD/LOD
//    - NY KZ: Continuation or Reversal
//
// 📖 MODEL 2022 CHECKLIST (หน้า 553-589)
//    ✓ HTF Bias Aligned
//    ✓ In Killzone
//    ✓ Correct Zone (Premium/Discount)
//    ✓ Has POI (OB/FVG)
//    ✓ Liquidity Swept
//
// ══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════
// MASTER TOGGLES - ลูกค้ากดเปิด/ปิดดูทีละตัวได้
// ═══════════════════════════════════════════════════════════════════════════

grpMASTER = "🎛️ MASTER CONTROLS"
showAllPDArray = input.bool(true, "═══ ENABLE PD ARRAY ═══", group=grpMASTER)

// ═══════════════════════════════════════════════════════════════════════════
// 1. OLD HIGHS / OLD LOWS (External Liquidity)
// ═══════════════════════════════════════════════════════════════════════════

grpOLDHL = "1️⃣ OLD HIGHS / OLD LOWS (External Liquidity)"
showOldHL = input.bool(true, "Show Old Highs/Lows", group=grpOLDHL, tooltip="BSL/SSL - Buyside/Sellside Liquidity Pools")
showPDHL = input.bool(true, "├─ PDH/PDL (Previous Day)", group=grpOLDHL)
showPWHL = input.bool(true, "├─ PWH/PWL (Previous Week)", group=grpOLDHL)
showPMHL = input.bool(false, "├─ PMH/PML (Previous Month)", group=grpOLDHL)
showAsianHL = input.bool(true, "└─ Asian Session H/L", group=grpOLDHL)
showEqualHL = input.bool(true, "Show Equal Highs/Lows", group=grpOLDHL, tooltip="Double/Triple tops or bottoms = Liquidity magnet")
equalThreshold = input.float(0.05, "Equal H/L Threshold %", minval=0.01, maxval=0.5, group=grpOLDHL)

bslColor = input.color(color.new(#26A69A, 0), "BSL Color", group=grpOLDHL)
sslColor = input.color(color.new(#EF5350, 0), "SSL Color", group=grpOLDHL)
pdhColor = input.color(color.new(#00BCD4, 30), "PDH/PDL", group=grpOLDHL)
pwhColor = input.color(color.new(#E91E63, 30), "PWH/PWL", group=grpOLDHL)

// ═══════════════════════════════════════════════════════════════════════════
// 2. REJECTION BLOCK
// ═══════════════════════════════════════════════════════════════════════════

grpRB = "2️⃣ REJECTION BLOCK (ไส้เทียนที่ Swing Point)"
showRejectionBlock = input.bool(true, "Show Rejection Block", group=grpRB, tooltip="ไส้เทียนที่สูงสุด/ต่ำสุด - Entry ที่คุ้มค่าที่สุด R:R")
rbLookback = input.int(5, "Swing Lookback", minval=2, maxval=20, group=grpRB)
minWickRatio = input.float(0.5, "Min Wick Ratio", minval=0.3, maxval=0.9, group=grpRB, tooltip="ไส้เทียนต้องยาวกว่า 50% ของแท่ง")
rbBullColor = input.color(color.new(#4CAF50, 70), "Bullish RB", group=grpRB)
rbBearColor = input.color(color.new(#F44336, 70), "Bearish RB", group=grpRB)

// ═══════════════════════════════════════════════════════════════════════════
// 3. ORDER BLOCK
// ═══════════════════════════════════════════════════════════════════════════

grpOB = "3️⃣ ORDER BLOCK (แท่งสุดท้ายก่อน Impulse)"
showOrderBlock = input.bool(true, "Show Order Block", group=grpOB, tooltip="แท่งเทียนสุดท้ายก่อนที่ราคาจะวิ่งแรง")
obLookback = input.int(20, "OB Lookback", minval=5, maxval=100, group=grpOB)
obMitigated = input.bool(true, "Hide Mitigated OB", group=grpOB, tooltip="ซ่อน OB ที่ถูกทดสอบแล้ว")
obBullColor = input.color(color.new(#2196F3, 75), "Bullish OB", group=grpOB)
obBearColor = input.color(color.new(#FF5722, 75), "Bearish OB", group=grpOB)

// ═══════════════════════════════════════════════════════════════════════════
// 4. FAIR VALUE GAP (FVG)
// ═══════════════════════════════════════════════════════════════════════════

grpFVG = "4️⃣ FAIR VALUE GAP (BISI/SIBI)"
showFVG = input.bool(true, "Show FVG", group=grpFVG, tooltip="Imbalance ระหว่างแท่งเทียน 3 แท่ง")
fvgLookback = input.int(50, "FVG Lookback", minval=10, maxval=200, group=grpFVG)
showInverseFVG = input.bool(true, "├─ Show Inverse FVG (iFVG)", group=grpFVG, tooltip="FVG ที่ถูก Flip เป็นฝั่งตรงข้าม")
fvgMitigated = input.bool(true, "Hide Mitigated FVG", group=grpFVG)
minFVGSize = input.float(0.0, "Min FVG Size (0=auto)", minval=0, group=grpFVG)
bisiFVGColor = input.color(color.new(#4CAF50, 80), "BISI (Bullish FVG)", group=grpFVG)
sibiFVGColor = input.color(color.new(#F44336, 80), "SIBI (Bearish FVG)", group=grpFVG)
ifvgBullColor = input.color(color.new(#00BCD4, 80), "iFVG Bullish", group=grpFVG)
ifvgBearColor = input.color(color.new(#FF9800, 80), "iFVG Bearish", group=grpFVG)

// ═══════════════════════════════════════════════════════════════════════════
// 5. LIQUIDITY VOID
// ═══════════════════════════════════════════════════════════════════════════

grpLV = "5️⃣ LIQUIDITY VOID (ช่องว่างราคา)"
showLiquidityVoid = input.bool(true, "Show Liquidity Void", group=grpLV, tooltip="ช่องว่างที่ราคาวิ่งผ่านเร็วมาก - ราคาจะกลับมา Fill")
lvMinSize = input.float(0.2, "Min Void Size %", minval=0.1, maxval=1.0, group=grpLV)
lvColor = input.color(color.new(#9C27B0, 85), "Liquidity Void", group=grpLV)

// ═══════════════════════════════════════════════════════════════════════════
// 6. BREAKER BLOCK
// ═══════════════════════════════════════════════════════════════════════════

grpBRK = "6️⃣ BREAKER BLOCK (OB ที่ถูก Break)"
showBreakerBlock = input.bool(true, "Show Breaker Block", group=grpBRK, tooltip="Order Block ที่ถูก Break แล้ว Flip เป็นฝั่งตรงข้าม")
brkBullColor = input.color(color.new(#00E676, 80), "Bullish Breaker", group=grpBRK)
brkBearColor = input.color(color.new(#FF1744, 80), "Bearish Breaker", group=grpBRK)

// ═══════════════════════════════════════════════════════════════════════════
// 7. MITIGATION BLOCK
// ═══════════════════════════════════════════════════════════════════════════

grpMIT = "7️⃣ MITIGATION BLOCK (Failure Swing)"
showMitigationBlock = input.bool(true, "Show Mitigation Block", group=grpMIT, tooltip="แท่งสุดท้ายก่อน Failure Swing - สร้าง Higher High/Lower Low ไม่ได้")
mitBullColor = input.color(color.new(#8BC34A, 80), "Bullish Mitigation", group=grpMIT)
mitBearColor = input.color(color.new(#E91E63, 80), "Bearish Mitigation", group=grpMIT)

// ═══════════════════════════════════════════════════════════════════════════
// 8. PREMIUM/DISCOUNT + EQUILIBRIUM
// ═══════════════════════════════════════════════════════════════════════════

grpPD = "8️⃣ PREMIUM/DISCOUNT ZONE"
showPDZone = input.bool(true, "Show Premium/Discount Zone", group=grpPD)
pdLookback = input.int(50, "Swing Lookback", minval=10, maxval=200, group=grpPD)
showEquilibrium = input.bool(true, "Show Equilibrium Line", group=grpPD)
equilibriumColor = input.color(color.new(#FFEB3B, 50), "Equilibrium", group=grpPD)
premiumColor = input.color(color.new(#F44336, 90), "Premium Zone", group=grpPD)
discountColor = input.color(color.new(#4CAF50, 90), "Discount Zone", group=grpPD)

// ═══════════════════════════════════════════════════════════════════════════
// 9. MARKET STRUCTURE (BOS/CHoCH/MSS)
// ═══════════════════════════════════════════════════════════════════════════

grpMS = "9️⃣ MARKET STRUCTURE"
showMS = input.bool(true, "Show Market Structure", group=grpMS)
msLookback = input.int(10, "Structure Lookback", minval=3, maxval=50, group=grpMS)
showDisplacement = input.bool(true, "Require Displacement", group=grpMS, tooltip="ต้องมี Strong candle confirm (ตามหนังสือ)")
showCISD = input.bool(true, "Show CISD", group=grpMS, tooltip="Change In State of Delivery")
bosColor = input.color(color.new(#2196F3, 0), "BOS", group=grpMS)
chochColor = input.color(color.new(#FF9800, 0), "CHoCH/MSS", group=grpMS)
cisdColor = input.color(color.new(#E040FB, 0), "CISD", group=grpMS)

// ═══════════════════════════════════════════════════════════════════════════
// 10. TURTLE SOUP PATTERN
// ═══════════════════════════════════════════════════════════════════════════

grpTS = "🔟 TURTLE SOUP (Sweep & Reject)"
showTurtleSoup = input.bool(true, "Show Turtle Soup", group=grpTS, tooltip="Sweep Liquidity แล้วกลับตัว - Classic ICT Setup")
tsLookback = input.int(20, "Lookback for Equal H/L", minval=5, maxval=50, group=grpTS)
tsBullColor = input.color(color.new(#00E5FF, 0), "Bullish Turtle Soup", group=grpTS)
tsBearColor = input.color(color.new(#FF6D00, 0), "Bearish Turtle Soup", group=grpTS)

// ═══════════════════════════════════════════════════════════════════════════
// 11. OTE FIBONACCI
// ═══════════════════════════════════════════════════════════════════════════

grpOTE = "1️⃣1️⃣ OTE FIBONACCI (62%, 70.5%, 79%)"
showOTE = input.bool(true, "Show OTE Levels", group=grpOTE, tooltip="Optimal Trade Entry - ICT Fibonacci")
oteColor = input.color(color.new(#00BCD4, 50), "OTE Zone", group=grpOTE)

// ═══════════════════════════════════════════════════════════════════════════
// 12. SESSIONS & KILLZONES
// ═══════════════════════════════════════════════════════════════════════════

grpSESSION = "1️⃣2️⃣ SESSIONS & KILLZONES"
showSessions = input.bool(true, "Show Session Background", group=grpSESSION)
showAsianRange = input.bool(true, "Show Asian Range Box", group=grpSESSION)
showOpenTrueDay = input.bool(true, "Show Open True Day", group=grpSESSION, tooltip="00:00 NY = Midnight Open")
showSTDv = input.bool(true, "Show STDv Projection", group=grpSESSION)

asianColor = input.color(color.new(#9C27B0, 92), "Asian", group=grpSESSION)
londonKZColor = input.color(color.new(#2196F3, 92), "London KZ", group=grpSESSION)
nyKZColor = input.color(color.new(#FF9800, 92), "NY KZ", group=grpSESSION)
otdColor = input.color(color.new(#FFEB3B, 0), "Open True Day", group=grpSESSION)

// ═══════════════════════════════════════════════════════════════════════════
// 13. DASHBOARD PANEL
// ═══════════════════════════════════════════════════════════════════════════

grpPANEL = "1️⃣3️⃣ ANALYSIS DASHBOARD"
showPanel = input.bool(true, "Show Dashboard Panel", group=grpPANEL)
panelPosition = input.string("Top Right", "Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grpPANEL)
panelSize = input.string("Normal", "Size", options=["Small", "Normal", "Large"], group=grpPANEL)

// ═══════════════════════════════════════════════════════════════════════════
// CALCULATIONS
// ═══════════════════════════════════════════════════════════════════════════

atr = ta.atr(14)

// Get New York hour
getNYHour() =>
    utcHour = hour(time, "UTC")
    nyHour = (utcHour - 5 + 24) % 24
    nyHour

// Check if in session
inSession(startHour, endHour) =>
    nyHour = getNYHour()
    if startHour <= endHour
        nyHour >= startHour and nyHour < endHour
    else
        nyHour >= startHour or nyHour < endHour

// Sessions
inAsianSession = inSession(20, 0)
inLondonKZ = inSession(2, 5)
inNYKZ = inSession(7, 10)
inSilverBullet = inSession(10, 11)

currentSession = inLondonKZ ? "London KZ ⚡" : inNYKZ ? "NY KZ ⚡" : inSilverBullet ? "Silver Bullet" : inAsianSession ? "Asian" : "Off-Session"

// Session background
sessionBgColor = showSessions ? (inLondonKZ ? londonKZColor : inNYKZ ? nyKZColor : inAsianSession ? asianColor : na) : na
bgcolor(sessionBgColor)

// ═══════════════════════════════════════════════════════════════════════════
// 1. OLD HIGHS / OLD LOWS IMPLEMENTATION
// ═══════════════════════════════════════════════════════════════════════════

[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead=barmerge.lookahead_on)

var line pdhLine = na, var line pdlLine = na
var line pwhLine = na, var line pwlLine = na
var line pmhLine = na, var line pmlLine = na
var label pdhLabel = na, var label pdlLabel = na
var label pwhLabel = na, var label pwlLabel = na

if showOldHL and barstate.islast
    // PDH/PDL
    if showPDHL
        line.delete(pdhLine), line.delete(pdlLine)
        label.delete(pdhLabel), label.delete(pdlLabel)
        pdhLine := line.new(bar_index - 50, pdh, bar_index + 20, pdh, color=pdhColor, style=line.style_dashed, width=1)
        pdlLine := line.new(bar_index - 50, pdl, bar_index + 20, pdl, color=pdhColor, style=line.style_dashed, width=1)
        pdhLabel := label.new(bar_index + 22, pdh, "PDH 💧", style=label.style_none, textcolor=bslColor, size=size.small)
        pdlLabel := label.new(bar_index + 22, pdl, "PDL 💧", style=label.style_none, textcolor=sslColor, size=size.small)
    
    // PWH/PWL
    if showPWHL
        line.delete(pwhLine), line.delete(pwlLine)
        label.delete(pwhLabel), label.delete(pwlLabel)
        pwhLine := line.new(bar_index - 100, pwh, bar_index + 20, pwh, color=pwhColor, style=line.style_solid, width=2)
        pwlLine := line.new(bar_index - 100, pwl, bar_index + 20, pwl, color=pwhColor, style=line.style_solid, width=2)
        pwhLabel := label.new(bar_index + 22, pwh, "PWH 💧💧", style=label.style_none, textcolor=bslColor, size=size.small)
        pwlLabel := label.new(bar_index + 22, pwl, "PWL 💧💧", style=label.style_none, textcolor=sslColor, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════
// 2. REJECTION BLOCK IMPLEMENTATION
// ═══════════════════════════════════════════════════════════════════════════

// Detect swing high/low with long wick
pivotHighRB = ta.pivothigh(high, rbLookback, rbLookback)
pivotLowRB = ta.pivotlow(low, rbLookback, rbLookback)

// Check wick ratio
bodySize = math.abs(close - open)
totalSize = high - low
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low

// Bearish Rejection Block (at swing high with long upper wick)
bearishRB = not na(pivotHighRB) and totalSize > 0 and (upperWick / totalSize) >= minWickRatio
// Bullish Rejection Block (at swing low with long lower wick)
bullishRB = not na(pivotLowRB) and totalSize > 0 and (lowerWick / totalSize) >= minWickRatio

// Draw Rejection Blocks
if showRejectionBlock and showAllPDArray
    if bearishRB[rbLookback]
        wickTop = high[rbLookback]
        wickBottom = math.max(close[rbLookback], open[rbLookback])
        box.new(bar_index - rbLookback - 1, wickTop, bar_index + 10, wickBottom, border_color=color.new(rbBearColor, 50), bgcolor=rbBearColor, text="RB", text_color=color.white, text_size=size.tiny)
    
    if bullishRB[rbLookback]
        wickTop = math.min(close[rbLookback], open[rbLookback])
        wickBottom = low[rbLookback]
        box.new(bar_index - rbLookback - 1, wickTop, bar_index + 10, wickBottom, border_color=color.new(rbBullColor, 50), bgcolor=rbBullColor, text="RB", text_color=color.white, text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════
// 3. ORDER BLOCK IMPLEMENTATION
// ═══════════════════════════════════════════════════════════════════════════

// Bullish OB: Last bearish candle before bullish impulse
// Bearish OB: Last bullish candle before bearish impulse

bullishImpulse = close > open and (close - open) > atr * 0.8 and close > high[1]
bearishImpulse = close < open and (open - close) > atr * 0.8 and close < low[1]

// Find last opposite candle before impulse
bullishOB = bullishImpulse and close[1] < open[1]  // Yesterday was bearish
bearishOB = bearishImpulse and close[1] > open[1]  // Yesterday was bullish

var box[] obBoxes = array.new_box()

if showOrderBlock and showAllPDArray
    if bullishOB
        obTop = high[1]
        obBottom = low[1]
        newBox = box.new(bar_index - 1, obTop, bar_index + 30, obBottom, border_color=color.new(obBullColor, 50), bgcolor=obBullColor, text="OB+", text_color=color.white, text_size=size.tiny)
        array.push(obBoxes, newBox)
    
    if bearishOB
        obTop = high[1]
        obBottom = low[1]
        newBox = box.new(bar_index - 1, obTop, bar_index + 30, obBottom, border_color=color.new(obBearColor, 50), bgcolor=obBearColor, text="OB-", text_color=color.white, text_size=size.tiny)
        array.push(obBoxes, newBox)

// Limit boxes
if array.size(obBoxes) > 20
    box.delete(array.shift(obBoxes))

// ═══════════════════════════════════════════════════════════════════════════
// 4. FAIR VALUE GAP IMPLEMENTATION
// ═══════════════════════════════════════════════════════════════════════════

minGap = minFVGSize > 0 ? minFVGSize : atr * 0.1

// Bullish FVG (BISI): Current low > 2 bars ago high
bullishFVG = low > high[2] and (low - high[2]) > minGap
// Bearish FVG (SIBI): Current high < 2 bars ago low
bearishFVG = high < low[2] and (low[2] - high) > minGap

var box[] fvgBoxes = array.new_box()
var int[] fvgTypes = array.new_int()  // 1 = bullish, -1 = bearish

if showFVG and showAllPDArray
    if bullishFVG
        fvgTop = low
        fvgBottom = high[2]
        newBox = box.new(bar_index - 2, fvgTop, bar_index + 50, fvgBottom, border_color=color.new(bisiFVGColor, 50), bgcolor=bisiFVGColor, text="BISI", text_color=color.white, text_size=size.tiny)
        array.push(fvgBoxes, newBox)
        array.push(fvgTypes, 1)
    
    if bearishFVG
        fvgTop = low[2]
        fvgBottom = high
        newBox = box.new(bar_index - 2, fvgTop, bar_index + 50, fvgBottom, border_color=color.new(sibiFVGColor, 50), bgcolor=sibiFVGColor, text="SIBI", text_color=color.white, text_size=size.tiny)
        array.push(fvgBoxes, newBox)
        array.push(fvgTypes, -1)

// Check for mitigated FVG and create Inverse FVG
if showInverseFVG and array.size(fvgBoxes) > 0
    for i = array.size(fvgBoxes) - 1 to 0
        if i < array.size(fvgBoxes)
            currentBox = array.get(fvgBoxes, i)
            fvgType = array.get(fvgTypes, i)
            boxTop = box.get_top(currentBox)
            boxBottom = box.get_bottom(currentBox)
            
            // Check if FVG is mitigated
            mitigated = (fvgType == 1 and low <= boxBottom) or (fvgType == -1 and high >= boxTop)
            
            if mitigated and fvgMitigated
                // Create Inverse FVG
                box.set_bgcolor(currentBox, fvgType == 1 ? ifvgBearColor : ifvgBullColor)
                box.set_border_color(currentBox, fvgType == 1 ? color.new(ifvgBearColor, 30) : color.new(ifvgBullColor, 30))
                box.set_text(currentBox, "iFVG")

// Limit boxes
if array.size(fvgBoxes) > 30
    box.delete(array.shift(fvgBoxes))
    array.shift(fvgTypes)

// ═══════════════════════════════════════════════════════════════════════════
// 5. LIQUIDITY VOID IMPLEMENTATION
// ═══════════════════════════════════════════════════════════════════════════

// Liquidity Void = Gap between candles (price moved too fast)
priceRange = ta.highest(high, 20) - ta.lowest(low, 20)
minVoidSize = priceRange * (lvMinSize / 100)

// Check for gap up (void below)
gapUp = low > high[1] and (low - high[1]) > minVoidSize
// Check for gap down (void above)
gapDown = high < low[1] and (low[1] - high) > minVoidSize

var box[] lvBoxes = array.new_box()

if showLiquidityVoid and showAllPDArray
    if gapUp
        newBox = box.new(bar_index - 1, low, bar_index + 30, high[1], border_color=color.new(lvColor, 50), bgcolor=lvColor, text="VOID", text_color=color.white, text_size=size.tiny)
        array.push(lvBoxes, newBox)
    
    if gapDown
        newBox = box.new(bar_index - 1, low[1], bar_index + 30, high, border_color=color.new(lvColor, 50), bgcolor=lvColor, text="VOID", text_color=color.white, text_size=size.tiny)
        array.push(lvBoxes, newBox)

if array.size(lvBoxes) > 10
    box.delete(array.shift(lvBoxes))

// ═══════════════════════════════════════════════════════════════════════════
// 6. BREAKER BLOCK IMPLEMENTATION
// ═══════════════════════════════════════════════════════════════════════════

// Breaker Block = Order Block that got broken and flipped

var float lastOBHigh = na
var float lastOBLow = na
var int lastOBType = 0  // 1 = bullish OB, -1 = bearish OB
var int lastOBBar = na

// Track Order Blocks
if bullishOB
    lastOBHigh := high[1]
    lastOBLow := low[1]
    lastOBType := 1
    lastOBBar := bar_index - 1

if bearishOB
    lastOBHigh := high[1]
    lastOBLow := low[1]
    lastOBType := -1
    lastOBBar := bar_index - 1

// Check if OB is broken and becomes Breaker
bullishBreaker = lastOBType == -1 and close > lastOBHigh  // Bearish OB broken = Bullish Breaker
bearishBreaker = lastOBType == 1 and close < lastOBLow    // Bullish OB broken = Bearish Breaker

if showBreakerBlock and showAllPDArray
    if bullishBreaker and not na(lastOBBar)
        box.new(lastOBBar, lastOBHigh, bar_index + 20, lastOBLow, border_color=color.new(brkBullColor, 30), bgcolor=brkBullColor, text="BRK+", text_color=color.white, text_size=size.tiny)
        lastOBType := 0
    
    if bearishBreaker and not na(lastOBBar)
        box.new(lastOBBar, lastOBHigh, bar_index + 20, lastOBLow, border_color=color.new(brkBearColor, 30), bgcolor=brkBearColor, text="BRK-", text_color=color.white, text_size=size.tiny)
        lastOBType := 0

// ═══════════════════════════════════════════════════════════════════════════
// 7. MITIGATION BLOCK IMPLEMENTATION
// ═══════════════════════════════════════════════════════════════════════════

// Mitigation Block = Last candle before Failure Swing (couldn't make new HH or LL)

// Detect Failure Swing
var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na

pivotH = ta.pivothigh(high, 5, 5)
pivotL = ta.pivotlow(low, 5, 5)

if not na(pivotH)
    lastSwingHigh := pivotH
    lastSwingHighBar := bar_index - 5

if not na(pivotL)
    lastSwingLow := pivotL
    lastSwingLowBar := bar_index - 5

// Failure to make Higher High
failureSwingHigh = not na(pivotH) and pivotH < lastSwingHigh[10]
// Failure to make Lower Low
failureSwingLow = not na(pivotL) and pivotL > lastSwingLow[10]

if showMitigationBlock and showAllPDArray
    if failureSwingHigh
        // Find last bullish candle before the failed swing
        for i = 5 to 15
            if close[i] > open[i]
                box.new(bar_index - i - 1, high[i], bar_index + 15, low[i], border_color=color.new(mitBearColor, 40), bgcolor=mitBearColor, text="MIT-", text_color=color.white, text_size=size.tiny)
                break
    
    if failureSwingLow
        // Find last bearish candle before the failed swing
        for i = 5 to 15
            if close[i] < open[i]
                box.new(bar_index - i - 1, high[i], bar_index + 15, low[i], border_color=color.new(mitBullColor, 40), bgcolor=mitBullColor, text="MIT+", text_color=color.white, text_size=size.tiny)
                break

// ═══════════════════════════════════════════════════════════════════════════
// 8. PREMIUM/DISCOUNT ZONE
// ═══════════════════════════════════════════════════════════════════════════

swingHigh = ta.highest(high, pdLookback)
swingLow = ta.lowest(low, pdLookback)
equilibrium = (swingHigh + swingLow) / 2

inPremium = close > equilibrium
inDiscount = close < equilibrium

var box premiumBox = na
var box discountBox = na
var line eqLine = na
var label eqLabel = na

if showPDZone and showAllPDArray and barstate.islast
    box.delete(premiumBox)
    box.delete(discountBox)
    line.delete(eqLine)
    label.delete(eqLabel)
    
    premiumBox := box.new(bar_index - pdLookback, swingHigh, bar_index + 20, equilibrium, border_color=na, bgcolor=premiumColor, text="PREMIUM", text_halign=text.align_right, text_color=color.new(color.red, 50), text_size=size.tiny)
    discountBox := box.new(bar_index - pdLookback, equilibrium, bar_index + 20, swingLow, border_color=na, bgcolor=discountColor, text="DISCOUNT", text_halign=text.align_right, text_color=color.new(color.green, 50), text_size=size.tiny)
    
    if showEquilibrium
        eqLine := line.new(bar_index - pdLookback, equilibrium, bar_index + 20, equilibrium, color=equilibriumColor, style=line.style_dashed, width=2)
        eqLabel := label.new(bar_index + 22, equilibrium, "EQ 50%", style=label.style_none, textcolor=equilibriumColor, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════
// 9. MARKET STRUCTURE
// ═══════════════════════════════════════════════════════════════════════════

pivotHighMS = ta.pivothigh(high, msLookback, msLookback)
pivotLowMS = ta.pivotlow(low, msLookback, msLookback)

var float lastMSHigh = na
var float lastMSLow = na
var int trend = 0

if not na(pivotHighMS)
    lastMSHigh := pivotHighMS
if not na(pivotLowMS)
    lastMSLow := pivotLowMS

isDisplacementCandle = math.abs(close - open) > atr * 0.5
displacementOK = not showDisplacement or isDisplacementCandle

var bool bosUp = false
var bool bosDown = false
var bool chochUp = false
var bool chochDown = false

bosUp := false
bosDown := false
chochUp := false
chochDown := false

// BOS - continuation
if trend >= 0 and not na(lastMSHigh) and close > lastMSHigh and close[1] <= lastMSHigh and displacementOK
    bosUp := true
    trend := 1

if trend <= 0 and not na(lastMSLow) and close < lastMSLow and close[1] >= lastMSLow and displacementOK
    bosDown := true
    trend := -1

// CHoCH - reversal
if trend == -1 and not na(lastMSHigh) and close > lastMSHigh and close[1] <= lastMSHigh and displacementOK
    chochUp := true
    trend := 1

if trend == 1 and not na(lastMSLow) and close < lastMSLow and close[1] >= lastMSLow and displacementOK
    chochDown := true
    trend := -1

if showMS and showAllPDArray
    if bosUp
        label.new(bar_index, low, "BOS", style=label.style_label_up, color=color.new(bosColor, 80), textcolor=bosColor, size=size.tiny)
        line.new(bar_index - 5, lastMSHigh, bar_index + 5, lastMSHigh, color=bosColor, style=line.style_dotted)
    
    if bosDown
        label.new(bar_index, high, "BOS", style=label.style_label_down, color=color.new(bosColor, 80), textcolor=bosColor, size=size.tiny)
        line.new(bar_index - 5, lastMSLow, bar_index + 5, lastMSLow, color=bosColor, style=line.style_dotted)
    
    if chochUp
        label.new(bar_index, low, "CHoCH", style=label.style_label_up, color=color.new(chochColor, 70), textcolor=chochColor, size=size.small)
        line.new(bar_index - 5, lastMSHigh, bar_index + 5, lastMSHigh, color=chochColor, width=2)
    
    if chochDown
        label.new(bar_index, high, "CHoCH", style=label.style_label_down, color=color.new(chochColor, 70), textcolor=chochColor, size=size.small)
        line.new(bar_index - 5, lastMSLow, bar_index + 5, lastMSLow, color=chochColor, width=2)

// CISD detection
cisdUp = chochUp and isDisplacementCandle and bullishFVG
cisdDown = chochDown and isDisplacementCandle and bearishFVG

if showCISD and showAllPDArray
    if cisdUp
        label.new(bar_index, low - atr * 0.5, "CISD", style=label.style_label_up, color=color.new(cisdColor, 70), textcolor=cisdColor, size=size.tiny)
    if cisdDown
        label.new(bar_index, high + atr * 0.5, "CISD", style=label.style_label_down, color=color.new(cisdColor, 70), textcolor=cisdColor, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════
// 10. TURTLE SOUP PATTERN
// ═══════════════════════════════════════════════════════════════════════════

// Find recent highs/lows for equal levels
recentHigh = ta.highest(high, tsLookback)
recentLow = ta.lowest(low, tsLookback)

// Sweep and reject pattern
tsSweepHigh = high > recentHigh[1] and close < recentHigh[1]  // Swept high but closed below
tsSweepLow = low < recentLow[1] and close > recentLow[1]      // Swept low but closed above

if showTurtleSoup and showAllPDArray
    if tsSweepHigh
        label.new(bar_index, high, "🐢 TS", style=label.style_label_down, color=color.new(tsBearColor, 70), textcolor=tsBearColor, size=size.small)
    
    if tsSweepLow
        label.new(bar_index, low, "🐢 TS", style=label.style_label_up, color=color.new(tsBullColor, 70), textcolor=tsBullColor, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════
// 11. OTE FIBONACCI
// ═══════════════════════════════════════════════════════════════════════════

// OTE levels: 62%, 70.5%, 79%
oteHigh = equilibrium + (swingHigh - equilibrium) * 0.62
oteLow = equilibrium - (equilibrium - swingLow) * 0.62
oteOptimal = equilibrium + (swingHigh - equilibrium) * 0.705
oteExtreme = equilibrium + (swingHigh - equilibrium) * 0.79

var line oteLine62 = na, var line oteLine705 = na, var line oteLine79 = na
var label oteLabel = na

if showOTE and showAllPDArray and barstate.islast
    line.delete(oteLine62), line.delete(oteLine705), line.delete(oteLine79)
    label.delete(oteLabel)
    
    // Premium OTE zone
    if trend == -1 or inPremium
        oteLine62 := line.new(bar_index - 20, oteHigh, bar_index + 10, oteHigh, color=oteColor, style=line.style_dotted)
        oteLine705 := line.new(bar_index - 20, oteOptimal, bar_index + 10, oteOptimal, color=oteColor, style=line.style_solid)
        oteLine79 := line.new(bar_index - 20, oteExtreme, bar_index + 10, oteExtreme, color=oteColor, style=line.style_dotted)
        oteLabel := label.new(bar_index + 12, oteOptimal, "OTE 70.5%", style=label.style_none, textcolor=oteColor, size=size.tiny)
    else
        // Discount OTE zone
        oteLow62 = equilibrium - (equilibrium - swingLow) * 0.62
        oteLow705 = equilibrium - (equilibrium - swingLow) * 0.705
        oteLow79 = equilibrium - (equilibrium - swingLow) * 0.79
        
        oteLine62 := line.new(bar_index - 20, oteLow62, bar_index + 10, oteLow62, color=oteColor, style=line.style_dotted)
        oteLine705 := line.new(bar_index - 20, oteLow705, bar_index + 10, oteLow705, color=oteColor, style=line.style_solid)
        oteLine79 := line.new(bar_index - 20, oteLow79, bar_index + 10, oteLow79, color=oteColor, style=line.style_dotted)
        oteLabel := label.new(bar_index + 12, oteLow705, "OTE 70.5%", style=label.style_none, textcolor=oteColor, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════
// 12. ASIAN RANGE & OPEN TRUE DAY
// ═══════════════════════════════════════════════════════════════════════════

var float asianHigh = na
var float asianLow = na
var box asianBox = na

if inAsianSession and not inAsianSession[1]
    asianHigh := high
    asianLow := low
    if showAsianRange
        box.delete(asianBox)
        asianBox := box.new(bar_index, high, bar_index, low, border_color=color.new(#9C27B0, 50), bgcolor=color.new(#9C27B0, 92), text="Asian Range", text_color=color.new(#9C27B0, 50), text_size=size.tiny)

if inAsianSession
    asianHigh := math.max(asianHigh, high)
    asianLow := math.min(asianLow, low)
    if showAsianRange and not na(asianBox)
        box.set_top(asianBox, asianHigh)
        box.set_bottom(asianBox, asianLow)
        box.set_right(asianBox, bar_index + 20)

// Open True Day
var float openTrueDay = na
var line otdLine = na
var label otdLabel = na

nyHour = getNYHour()
if nyHour == 0 and nyHour[1] != 0
    openTrueDay := open
    if showOpenTrueDay
        line.delete(otdLine)
        label.delete(otdLabel)
        otdLine := line.new(bar_index, openTrueDay, bar_index + 100, openTrueDay, color=otdColor, style=line.style_solid, width=2)
        otdLabel := label.new(bar_index + 5, openTrueDay, "OTD (00:00 NY)", style=label.style_none, textcolor=otdColor, size=size.small)

if showOpenTrueDay and not na(otdLine)
    line.set_x2(otdLine, bar_index + 50)

// STDv Projection
asianRange = asianHigh - asianLow
var line[] stdvLines = array.new_line()
var label[] stdvLabels = array.new_label()

if showSTDv and not inAsianSession and inAsianSession[1] and asianRange > 0
    // Clear old lines - ต้องเช็ค size ก่อน
    if array.size(stdvLines) > 0
        for i = array.size(stdvLines) - 1 to 0
            line.delete(array.get(stdvLines, i))
        array.clear(stdvLines)
    
    // Clear old labels - ต้องเช็ค size ก่อน
    if array.size(stdvLabels) > 0
        for i = array.size(stdvLabels) - 1 to 0
            label.delete(array.get(stdvLabels, i))
        array.clear(stdvLabels)
    
    for lvl = 1 to 4
        upperLevel = asianHigh + (asianRange * lvl)
        lowerLevel = asianLow - (asianRange * lvl)
        
        upperLine = line.new(bar_index, upperLevel, bar_index + 80, upperLevel, color=color.new(#9C27B0, 60), style=line.style_dotted)
        lowerLine = line.new(bar_index, lowerLevel, bar_index + 80, lowerLevel, color=color.new(#9C27B0, 60), style=line.style_dotted)
        array.push(stdvLines, upperLine)
        array.push(stdvLines, lowerLine)
        
        upperLabel = label.new(bar_index + 3, upperLevel, "+" + str.tostring(lvl) + " STDv", style=label.style_none, textcolor=color.new(#9C27B0, 40), size=size.tiny)
        lowerLabel = label.new(bar_index + 3, lowerLevel, "-" + str.tostring(lvl) + " STDv", style=label.style_none, textcolor=color.new(#9C27B0, 40), size=size.tiny)
        array.push(stdvLabels, upperLabel)
        array.push(stdvLabels, lowerLabel)

// ═══════════════════════════════════════════════════════════════════════════
// BIAS CALCULATION
// ═══════════════════════════════════════════════════════════════════════════

[dailyClose, dailyHigh, dailyLow] = request.security(syminfo.tickerid, "D", [close[1], high[1], low[1]], lookahead=barmerge.lookahead_on)
[prevDailyHigh, prevDailyLow] = request.security(syminfo.tickerid, "D", [high[2], low[2]], lookahead=barmerge.lookahead_on)

dailyBias = dailyClose > prevDailyHigh ? "BULLISH" : dailyClose < prevDailyLow ? "BEARISH" : "NEUTRAL"

[weeklyClose] = request.security(syminfo.tickerid, "W", [close[1]], lookahead=barmerge.lookahead_on)
[prevWeeklyHigh, prevWeeklyLow] = request.security(syminfo.tickerid, "W", [high[2], low[2]], lookahead=barmerge.lookahead_on)

weeklyBias = weeklyClose > prevWeeklyHigh ? "BULLISH" : weeklyClose < prevWeeklyLow ? "BEARISH" : "NEUTRAL"

// Liquidity sweep detection
sweptPDH = high > pdh and close < pdh
sweptPDL = low < pdl and close > pdl
sweptAsianHigh = not na(asianHigh) and high > asianHigh and close < asianHigh
sweptAsianLow = not na(asianLow) and low < asianLow and close > asianLow

liquiditySwept = sweptPDH or sweptPDL or sweptAsianHigh or sweptAsianLow
sweepType = sweptPDH ? "PDH Swept" : sweptPDL ? "PDL Swept" : sweptAsianHigh ? "Asia H Swept" : sweptAsianLow ? "Asia L Swept" : "None"

// ═══════════════════════════════════════════════════════════════════════════
// CONFLUENCE SCORE
// ═══════════════════════════════════════════════════════════════════════════

dow = dayofweek(time)
dayName = dow == 1 ? "Sunday" : dow == 2 ? "Monday" : dow == 3 ? "Tuesday" : dow == 4 ? "Wednesday" : dow == 5 ? "Thursday" : dow == 6 ? "Friday" : "Saturday"
goodDay = dow >= 3 and dow <= 5

c1_htfBias = weeklyBias != "NEUTRAL" ? 1 : 0
c2_dailyBias = dailyBias != "NEUTRAL" ? 1 : 0
c3_killzone = inLondonKZ or inNYKZ ? 1 : 0
c4_goodDay = goodDay ? 1 : 0
c5_pdZone = (inPremium and trend == -1) or (inDiscount and trend == 1) ? 1 : 0
c6_fvgPresent = bullishFVG or bearishFVG ? 1 : 0
c7_structure = bosUp or bosDown or chochUp or chochDown ? 1 : 0
c8_liquiditySweep = liquiditySwept ? 1 : 0
c9_turtleSoup = tsSweepHigh or tsSweepLow ? 1 : 0
c10_obPresent = bullishOB or bearishOB ? 1 : 0

confluenceScore = c1_htfBias + c2_dailyBias + c3_killzone + c4_goodDay + c5_pdZone + c6_fvgPresent + c7_structure + c8_liquiditySweep + c9_turtleSoup + c10_obPresent
maxScore = 10

qualityLevel = confluenceScore >= 7 ? "HIGH ⭐" : confluenceScore >= 5 ? "MEDIUM" : "LOW"
qualityColor = confluenceScore >= 7 ? color.new(#4CAF50, 0) : confluenceScore >= 5 ? color.new(#FF9800, 0) : color.new(#F44336, 0)

// ═══════════════════════════════════════════════════════════════════════════
// ICT ADVISOR LOGIC - ตามหนังสือ ICT by Michael J. Huddleston
// ═══════════════════════════════════════════════════════════════════════════

// ─── HTF BIAS (หน้า 430-450) ───
// "Close above PDH = Bullish, Close below PDL = Bearish"
string htfNarrative = ""
if weeklyBias == "BULLISH" and dailyBias == "BULLISH"
    htfNarrative := "Bullish Aligned"
else if weeklyBias == "BEARISH" and dailyBias == "BEARISH"
    htfNarrative := "Bearish Aligned"
else if weeklyBias != dailyBias and weeklyBias != "NEUTRAL" and dailyBias != "NEUTRAL"
    htfNarrative := "Bias Conflict"
else
    htfNarrative := "No Clear Bias"

// ─── MARKET STATE (Power of 3 - หน้า 495-513) ───
// AMD: Accumulation → Manipulation → Distribution
string marketState = ""
if inAsianSession
    marketState := "Accumulation"
else if inLondonKZ and liquiditySwept
    marketState := "Manipulation"
else if inNYKZ and (bosUp or bosDown)
    marketState := "Distribution"
else if inLondonKZ
    marketState := "Seeking Liquidity"
else if inNYKZ
    marketState := "Continuation"
else
    marketState := "Ranging"

// ─── DRAW ON LIQUIDITY (หน้า 300-363) ───
// "ราคาจะวิ่งไปหา External Liquidity เสมอ"
string drawOnLiquidity = ""
if trend == 1
    drawOnLiquidity := "Targeting BSL (PDH/PWH)"
else if trend == -1
    drawOnLiquidity := "Targeting SSL (PDL/PWL)"
else
    drawOnLiquidity := "Undefined"

// ─── PD ARRAY POI (หน้า 49-111) ───
// Zone of Interest based on PD Array
float poiHigh = na
float poiLow = na
string poiType = ""

if bullishOB and trend == 1 and inDiscount
    poiHigh := high[1]
    poiLow := low[1]
    poiType := "Bullish OB"
else if bearishOB and trend == -1 and inPremium
    poiHigh := high[1]
    poiLow := low[1]
    poiType := "Bearish OB"
else if bullishFVG and trend == 1
    poiHigh := low
    poiLow := high[2]
    poiType := "BISI"
else if bearishFVG and trend == -1
    poiHigh := low[2]
    poiLow := high
    poiType := "SIBI"
else
    poiType := "No POI"

// ─── SETUP QUALITY (Model 2022 - หน้า 553-589) ───
// Checklist ตามหนังสือ
string setupStatus = ""
color setupColor = color.gray

bool htfAligned = (weeklyBias == "BULLISH" and dailyBias == "BULLISH") or (weeklyBias == "BEARISH" and dailyBias == "BEARISH")
bool inKillzone = inLondonKZ or inNYKZ
bool correctZone = (trend == 1 and inDiscount) or (trend == -1 and inPremium)
bool hasPOI = poiType != "No POI"

if htfAligned and inKillzone and correctZone and hasPOI and liquiditySwept
    setupStatus := "A+ Setup"
    setupColor := #4CAF50
else if htfAligned and inKillzone and correctZone and hasPOI
    setupStatus := "Valid Setup"
    setupColor := #4CAF50
else if htfAligned and correctZone and hasPOI
    setupStatus := "Wait for Killzone"
    setupColor := #FF9800
else if htfAligned and inKillzone
    setupStatus := "Wait for POI"
    setupColor := #FF9800
else if not htfAligned
    setupStatus := "No HTF Bias"
    setupColor := #9E9E9E
else
    setupStatus := "Incomplete"
    setupColor := #9E9E9E

// ─── DAY OF WEEK PROFILE (หน้า 553-560) ───
string dayProfile = ""
if dow == 2
    dayProfile := "Monday: Weekly Open"
else if dow == 3
    dayProfile := "Tuesday: Expansion"
else if dow == 4
    dayProfile := "Wednesday: Reversal"
else if dow == 5
    dayProfile := "Thursday: Continuation"
else if dow == 6
    dayProfile := "Friday: TGIF"
else
    dayProfile := "Weekend"

// ─── COLORS FOR DASHBOARD ───
htfColor = str.contains(htfNarrative, "Bullish") ? #4CAF50 : str.contains(htfNarrative, "Bearish") ? #F44336 : #9E9E9E
weeklyBiasColor = weeklyBias == "BULLISH" ? #4CAF50 : weeklyBias == "BEARISH" ? #F44336 : #9E9E9E
dailyBiasColor = dailyBias == "BULLISH" ? #4CAF50 : dailyBias == "BEARISH" ? #F44336 : #9E9E9E
stateColor = marketState == "Distribution" ? #4CAF50 : marketState == "Manipulation" ? #FF9800 : marketState == "Accumulation" ? #9C27B0 : #9E9E9E
sessionColor = inLondonKZ ? #2196F3 : inNYKZ ? #FF9800 : inAsianSession ? #9C27B0 : #9E9E9E
structureText = trend == 1 ? "Bullish" : trend == -1 ? "Bearish" : "Ranging"
structureColor = trend == 1 ? #4CAF50 : trend == -1 ? #F44336 : #9E9E9E
zoneDisplayColor = inPremium ? #F44336 : inDiscount ? #4CAF50 : #FFEB3B
zoneOK = correctZone ? " ✓" : ""
poiColor = poiType != "No POI" ? #00E5FF : #9E9E9E
dolColor = str.contains(drawOnLiquidity, "BSL") ? #4CAF50 : str.contains(drawOnLiquidity, "SSL") ? #F44336 : #9E9E9E
sweepColorPanel = liquiditySwept ? #4CAF50 : #9E9E9E
dayColor = (dow >= 3 and dow <= 5) ? #4CAF50 : #9E9E9E

// ═══════════════════════════════════════════════════════════════════════════
// 13. DASHBOARD PANEL
// ═══════════════════════════════════════════════════════════════════════════

panelPos = panelPosition == "Top Right" ? position.top_right : 
           panelPosition == "Top Left" ? position.top_left : 
           panelPosition == "Bottom Right" ? position.bottom_right : position.bottom_left
textSize = panelSize == "Small" ? size.tiny : panelSize == "Large" ? size.normal : size.small

if barstate.islast and showPanel
    var table dashboard = table.new(panelPos, 2, 24, bgcolor=color.rgb(13, 17, 23, 5), border_width=2, border_color=color.rgb(48, 54, 61), frame_width=2, frame_color=color.rgb(48, 54, 61))
    
    // ═══════════════════════════════════════════════════════════════════════
    // HEADER
    // ═══════════════════════════════════════════════════════════════════════
    table.cell(dashboard, 0, 0, "📖 ICT", text_color=#FFD700, text_size=size.normal, bgcolor=color.rgb(33, 38, 45))
    table.cell(dashboard, 1, 0, "ADVISOR", text_color=#FFD700, text_size=size.normal, bgcolor=color.rgb(33, 38, 45))
    
    // ═══════════════════════════════════════════════════════════════════════
    // SETUP STATUS + SCORE
    // ═══════════════════════════════════════════════════════════════════════
    table.cell(dashboard, 0, 1, "Setup:", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(dashboard, 1, 1, setupStatus, text_color=setupColor, text_size=size.normal, text_halign=text.align_right)
    
    // Confluence Score
    checkCount = (htfAligned ? 1 : 0) + (inKillzone ? 1 : 0) + (correctZone ? 1 : 0) + (hasPOI ? 1 : 0) + (liquiditySwept ? 1 : 0)
    scoreText = str.tostring(checkCount) + "/5"
    scoreColor = checkCount >= 4 ? #4CAF50 : checkCount >= 3 ? #FF9800 : #F44336
    table.cell(dashboard, 0, 2, "Score:", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(dashboard, 1, 2, scoreText, text_color=scoreColor, text_size=size.normal, text_halign=text.align_right)
    
    // ═══════════════════════════════════════════════════════════════════════
    // SEPARATOR
    // ═══════════════════════════════════════════════════════════════════════
    table.cell(dashboard, 0, 3, "", bgcolor=color.rgb(48, 54, 61))
    table.cell(dashboard, 1, 3, "", bgcolor=color.rgb(48, 54, 61))
    
    // ═══════════════════════════════════════════════════════════════════════
    // BIAS SECTION
    // ═══════════════════════════════════════════════════════════════════════
    table.cell(dashboard, 0, 4, "HTF:", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(dashboard, 1, 4, htfNarrative, text_color=htfColor, text_size=size.normal, text_halign=text.align_right)
    
    table.cell(dashboard, 0, 5, "  W:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 5, weeklyBias, text_color=weeklyBiasColor, text_size=size.small, text_halign=text.align_right)
    
    table.cell(dashboard, 0, 6, "  D:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 6, dailyBias, text_color=dailyBiasColor, text_size=size.small, text_halign=text.align_right)
    
    // ═══════════════════════════════════════════════════════════════════════
    // SEPARATOR
    // ═══════════════════════════════════════════════════════════════════════
    table.cell(dashboard, 0, 7, "", bgcolor=color.rgb(48, 54, 61))
    table.cell(dashboard, 1, 7, "", bgcolor=color.rgb(48, 54, 61))
    
    // ═══════════════════════════════════════════════════════════════════════
    // MARKET STATE
    // ═══════════════════════════════════════════════════════════════════════
    table.cell(dashboard, 0, 8, "State:", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(dashboard, 1, 8, marketState, text_color=stateColor, text_size=size.normal, text_halign=text.align_right)
    
    table.cell(dashboard, 0, 9, "Session:", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(dashboard, 1, 9, currentSession, text_color=sessionColor, text_size=size.normal, text_halign=text.align_right)
    
    table.cell(dashboard, 0, 10, "Day:", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(dashboard, 1, 10, dayProfile, text_color=dayColor, text_size=size.small, text_halign=text.align_right)
    
    // ═══════════════════════════════════════════════════════════════════════
    // SEPARATOR
    // ═══════════════════════════════════════════════════════════════════════
    table.cell(dashboard, 0, 11, "", bgcolor=color.rgb(48, 54, 61))
    table.cell(dashboard, 1, 11, "", bgcolor=color.rgb(48, 54, 61))
    
    // ═══════════════════════════════════════════════════════════════════════
    // PD ARRAY
    // ═══════════════════════════════════════════════════════════════════════
    table.cell(dashboard, 0, 12, "Structure:", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(dashboard, 1, 12, structureText, text_color=structureColor, text_size=size.normal, text_halign=text.align_right)
    
    table.cell(dashboard, 0, 13, "Zone:", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    zoneDisplayText = inPremium ? "Premium" : inDiscount ? "Discount" : "Equilibrium"
    table.cell(dashboard, 1, 13, zoneDisplayText + zoneOK, text_color=zoneDisplayColor, text_size=size.normal, text_halign=text.align_right)
    
    table.cell(dashboard, 0, 14, "POI:", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(dashboard, 1, 14, poiType, text_color=poiColor, text_size=size.normal, text_halign=text.align_right)
    
    // POI Price Range
    if not na(poiHigh) and not na(poiLow)
        table.cell(dashboard, 0, 15, "  Range:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
        table.cell(dashboard, 1, 15, str.tostring(poiLow, format.mintick) + " - " + str.tostring(poiHigh, format.mintick), text_color=#00E5FF, text_size=size.small, text_halign=text.align_right)
    else
        table.cell(dashboard, 0, 15, "  Range:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
        table.cell(dashboard, 1, 15, "—", text_color=color.gray, text_size=size.small, text_halign=text.align_right)
    
    // ═══════════════════════════════════════════════════════════════════════
    // SEPARATOR
    // ═══════════════════════════════════════════════════════════════════════
    table.cell(dashboard, 0, 16, "", bgcolor=color.rgb(48, 54, 61))
    table.cell(dashboard, 1, 16, "", bgcolor=color.rgb(48, 54, 61))
    
    // ═══════════════════════════════════════════════════════════════════════
    // LIQUIDITY
    // ═══════════════════════════════════════════════════════════════════════
    table.cell(dashboard, 0, 17, "Draw:", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(dashboard, 1, 17, drawOnLiquidity, text_color=dolColor, text_size=size.small, text_halign=text.align_right)
    
    table.cell(dashboard, 0, 18, "Sweep:", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(dashboard, 1, 18, liquiditySwept ? sweepType : "None", text_color=sweepColorPanel, text_size=size.normal, text_halign=text.align_right)
    
    // ═══════════════════════════════════════════════════════════════════════
    // SEPARATOR
    // ═══════════════════════════════════════════════════════════════════════
    table.cell(dashboard, 0, 19, "", bgcolor=color.rgb(48, 54, 61))
    table.cell(dashboard, 1, 19, "", bgcolor=color.rgb(48, 54, 61))
    
    // ═══════════════════════════════════════════════════════════════════════
    // CHECKLIST (Model 2022)
    // ═══════════════════════════════════════════════════════════════════════
    check1 = htfAligned ? "✓" : "○"
    check2 = inKillzone ? "✓" : "○"
    check3 = correctZone ? "✓" : "○"
    check4 = hasPOI ? "✓" : "○"
    check5 = liquiditySwept ? "✓" : "○"
    
    c1Color = htfAligned ? #4CAF50 : #666666
    c2Color = inKillzone ? #4CAF50 : #666666
    c3Color = correctZone ? #4CAF50 : #666666
    c4Color = hasPOI ? #4CAF50 : #666666
    c5Color = liquiditySwept ? #4CAF50 : #666666
    
    table.cell(dashboard, 0, 20, check1 + " HTF Bias", text_color=c1Color, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 20, check2 + " Killzone", text_color=c2Color, text_size=size.small, text_halign=text.align_right)
    
    table.cell(dashboard, 0, 21, check3 + " Zone", text_color=c3Color, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 21, check4 + " POI", text_color=c4Color, text_size=size.small, text_halign=text.align_right)
    
    table.cell(dashboard, 0, 22, check5 + " Swept", text_color=c5Color, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 22, "", text_color=color.gray, text_size=size.small, text_halign=text.align_right)
    
    // ═══════════════════════════════════════════════════════════════════════
    // FOOTER
    // ═══════════════════════════════════════════════════════════════════════
    table.cell(dashboard, 0, 23, "⚠️ You", text_color=#666666, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 23, "Decide", text_color=#666666, text_size=size.small, text_halign=text.align_right)

// ═══════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════

alertcondition(confluenceScore >= 7, title="High Confluence (7+)", message="ICT Dashboard: High confluence detected!")
alertcondition(chochUp or chochDown, title="CHoCH/MSS", message="ICT Dashboard: Change of Character detected")
alertcondition(liquiditySwept, title="Liquidity Sweep", message="ICT Dashboard: Liquidity sweep detected")
alertcondition(tsSweepHigh or tsSweepLow, title="Turtle Soup", message="ICT Dashboard: Turtle Soup pattern detected")
alertcondition(bullishFVG or bearishFVG, title="FVG Formed", message="ICT Dashboard: Fair Value Gap formed")
alertcondition(inLondonKZ and not inLondonKZ[1], title="London KZ Start", message="ICT Dashboard: London Killzone started")
alertcondition(inNYKZ and not inNYKZ[1], title="NY KZ Start", message="ICT Dashboard: New York Killzone started")
