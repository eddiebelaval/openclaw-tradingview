//@version=6
indicator("GK Smart Trend HUD TP1-TP3", overlay=true)

// Inputs
len=70, mult=1.2
tp1M=input.float(1.0,"TP1 ATR"), tp2M=input.float(1.6,"TP2 ATR"), tp3M=input.float(2.3,"TP3 ATR")
slBuf=input.float(0.30,"SL Buffer ATR (Band SL)")
bannerBars = input.int(5, "TP2 Banner Bars", minval=1, maxval=50)

// Ribbon logic (Len 70 / Band 1.2)
lag=math.max(int(math.floor((len-1)/2)),0)
src=lag>0?close+(close-close[lag]):close
zl=ta.ema(src,len)
atr=ta.atr(14)
up=zl+atr*mult
dn=zl-atr*mult

// ======================
// GK CENTRAL LINE (WHITE)
// ======================
plot(zl, "GK Central Line", color=color.white, linewidth=2)

// ======================
// PLOT LINES (SHOW BANDS)
// ======================
plot(up, "Upper Band", color=color.green, linewidth=1)
plot(dn, "Lower Band", color=color.red, linewidth=1)

// ======================
// DUAL-LANE RIBBON FILL
// Transparency 55
// ======================
pUp = plot(up, display=display.none)
pZ  = plot(zl, display=display.none)
pDn = plot(dn, display=display.none)
fill(pUp, pZ, color=color.new(color.green, 55))
fill(pZ, pDn, color=color.new(color.red, 55))

// Confirmed signals (3-bar confirmation)
bull = close>up and close[1]>up[1] and close[2]>up[2] and zl>zl[1]
bear = close<dn and close[1]<dn[1] and close[2]<dn[2] and zl<zl[1]

// PREPARE logic
preBuy  = close>up and close[1]>up[1] and not bull and zl>zl[1]
preSell = close<dn and close[1]<dn[1] and not bear and zl<zl[1]

// ======================
// SESSION (UTC)
// ======================
h = hour(time, "Etc/UTC")
asia   = h >= 0  and h < 7
london = h >= 7  and h < 13
ny     = h >= 13 and h < 21
sessTxt = asia ? "ASIA" : london ? "LONDON" : ny ? "NEW YORK" : "OFF"

// State
var int tr=0
var int dir=0
var float en=float(na)
var float tp1=float(na)
var float tp2=float(na)
var float tp3=float(na)
var float sl=float(na)
var int h1=0
var int h2=0
var int h3=0
var int hs=0
var int done=0

tr:=bull?1:bear?-1:nz(tr[1],0)
flip=barstate.isconfirmed and tr!=tr[1] and tr!=0
buySig=flip and tr==1
sellSig=flip and tr==-1

dir:=flip?tr:dir
en:=flip?close:en
tp1:=flip?en+(dir==1?1:-1)*atr*tp1M:tp1
tp2:=flip?en+(dir==1?1:-1)*atr*tp2M:tp2
tp3:=flip?en+(dir==1?1:-1)*atr*tp3M:tp3

// SL
slBuy  = dn - atr*slBuf
slSell = up + atr*slBuf
sl := flip ? (dir==1 ? slBuy : slSell) : sl

h1:=flip?0:h1
h2:=flip?0:h2
h3:=flip?0:h3
hs:=flip?0:hs
done:=flip?0:done

// Hit logic
hit1 = not na(tp1) and (dir==1?high>=tp1:low<=tp1)
hit2 = not na(tp2) and (dir==1?high>=tp2:low<=tp2)
hit3 = not na(tp3) and (dir==1?high>=tp3:low<=tp3)
hits = not na(sl)  and (dir==1?low<=sl:high>=sl)

h1 := (h1==1 or hit1)?1:h1
h2 := (h2==1 or hit2)?1:h2
h3 := (h3==1 or hit3)?1:h3
hs := (hs==1 or hits)?1:hs

done := (done==1 or hs==1 or h3==1) ? 1 : 0

// POWER
pRaw = (atr>0) ? (dir==1 ? (close - zl)/atr : (zl - close)/atr) : na
pVal = na(pRaw) ? na : math.max(pRaw, 0)
pTag = na(pVal) ? "-" : (pVal<0.30 ? "WEAK" : (pVal<0.70 ? "MED" : "STRONG"))
pTxt = na(pVal) ? "-" : (pTag+" ("+str.tostring(pVal,"#.##")+")")

// Signal + Status
sigTxt = na(en) ? "WAIT" : (dir==1 ? "BUY" : "SELL")
statusLive = na(en) ? "WAIT" : (hs==1 ? "SL HIT" : (h3==1 ? "TP3 HIT" : (h2==1 ? "TP2 HIT" : (h1==1 ? "TP1 HIT" : "RUNNING"))))
statusPrep = preBuy ? "PREPARE BUY" : preSell ? "PREPARE SELL" : "WAIT"
statusTxt  = done==1 ? "WAIT FOR NEXT SIGNAL" : (na(en) ? statusPrep : statusLive)

// Labels
plotshape(buySig,  text="GK BUY",  style=shape.labelup,   location=location.belowbar, color=color.green, textcolor=color.white, size=size.tiny)
plotshape(sellSig, text="GK SELL", style=shape.labeldown, location=location.abovebar, color=color.red,   textcolor=color.white, size=size.tiny)

// ======================
// HUD (BUY GREEN / SELL RED / WAIT GREY)
// ======================
hudTxt = dir == 1 ? color.green : dir == -1 ? color.red : color.gray

var table hud = table.new(position.top_right, 2, 9, border_width=1)
table.cell(hud,0,0,"GK SIGNAL", text_color=hudTxt), table.cell(hud,1,0,sigTxt, text_color=hudTxt)
table.cell(hud,0,1,"STATUS",    text_color=hudTxt), table.cell(hud,1,1,statusTxt, text_color=hudTxt)
table.cell(hud,0,2,"POWER",     text_color=hudTxt), table.cell(hud,1,2,pTxt, text_color=hudTxt)
table.cell(hud,0,3,"SESSION",   text_color=hudTxt), table.cell(hud,1,3,sessTxt, text_color=hudTxt)
table.cell(hud,0,4,"ENTRY",     text_color=hudTxt), table.cell(hud,1,4,na(en)?"-":str.tostring(en,format.mintick), text_color=hudTxt)
table.cell(hud,0,5,"TP1",       text_color=hudTxt), table.cell(hud,1,5,na(tp1)?"-":(str.tostring(tp1,format.mintick)+" "+(h1==1?"✅":"❌")), text_color=hudTxt)
table.cell(hud,0,6,"TP2",       text_color=hudTxt), table.cell(hud,1,6,na(tp2)?"-":(str.tostring(tp2,format.mintick)+" "+(h2==1?"✅":"❌")), text_color=hudTxt)
table.cell(hud,0,7,"TP3",       text_color=hudTxt), table.cell(hud,1,7,na(tp3)?"-":(str.tostring(tp3,format.mintick)+" "+(h3==1?"✅":"❌")), text_color=hudTxt)
table.cell(hud,0,8,"SL",        text_color=hudTxt), table.cell(hud,1,8,na(sl)?"-":(str.tostring(sl,format.mintick)+" "+(hs==1?"✅":"❌")), text_color=hudTxt)

// TP2 Banner
var table pop = table.new(position.middle_center, 1, 1, border_width=1)
var int popCnt = 0
tp2Event = (nz(h2[1],0)==0 and hit2) and done==0
popCnt := flip ? 0 : (tp2Event ? bannerBars : math.max(popCnt - 1, 0))
showPop = popCnt > 0
popTxt  = showPop ? "SECURE PROFITS NOW" : ""
popBg   = showPop ? color.yellow : na
table.cell(pop, 0, 0, popTxt, text_color=color.black, bgcolor=popBg)

// Alerts
alertcondition(buySig,  "GK BUY",  "GK BUY signal")
alertcondition(sellSig, "GK SELL", "GK SELL signal")
alertcondition(preBuy and na(en),  "PREPARE BUY",  "PREPARE BUY")
alertcondition(preSell and na(en), "PREPARE SELL", "PREPARE SELL")
alertcondition(h1==0 and hit1, "TP1 HIT", "TP1 hit")
alertcondition(h2==0 and hit2, "TP2 HIT", "TP2 hit")
alertcondition(h3==0 and hit3, "TP3 HIT", "TP3 hit")
alertcondition(hs==0 and hits, "SL HIT",  "SL hit")

// ======================
// GK OB/OS + TRAP RISK BOX (BOTTOM RIGHT)
// ======================
rsiLen = input.int(14, "OB/OS RSI Length", minval=2)
obLvl  = input.int(70, "Overbought Level", minval=50, maxval=95)
osLvl  = input.int(30, "Oversold Level",  minval=5,  maxval=50)

// Trap Risk inputs
trapExt = input.float(1.2, "Trap Extension (ATR)", step=0.1)
wickMult = input.float(1.5, "Trap Wick Mult", step=0.1)

// OB/OS
r = ta.rsi(close, rsiLen)
isOB = r >= obLvl
isOS = r <= osLvl
obTxt = isOB ? "OVERBOUGHT" : isOS ? "OVERSOLD" : "NEUTRAL"
obBg  = isOB ? color.new(color.red, 0) : isOS ? color.new(color.green, 0) : color.new(color.gray, 70)
obVal = str.tostring(r, "#.0")

// TRAP RISK (warning only)
body = math.abs(close - open)
uW   = high - math.max(open, close)
lW   = math.min(open, close) - low

rejUp = high > up and close < up and uW > body * wickMult   // bullish trap wick
rejDn = low  < dn and close > dn and lW > body * wickMult   // bearish trap wick

ext = (atr > 0) ? math.abs(close - zl) / atr : 0.0
isExt = ext >= trapExt

kill = (h >= 7 and h < 8) or (h >= 13 and h < 14) // London open hour + NY open hour (UTC)

score = (isExt ? 1 : 0) + ((rejUp or rejDn) ? 1 : 0) + (kill ? 1 : 0)
trapTxt = score >= 2 ? "HIGH" : score == 1 ? "MED" : "LOW"
trapBg  = score >= 2 ? color.new(color.red, 0) : score == 1 ? color.new(color.orange, 0) : color.new(color.green, 0)

// Table (3 rows now)
var table ob = table.new(position.bottom_right, 2, 3, border_width=1)
table.cell(ob, 0, 0, "GK OB/OS", text_color=color.white, bgcolor=color.new(color.black, 0))
table.cell(ob, 1, 0, obTxt,      text_color=color.white, bgcolor=obBg)
table.cell(ob, 0, 1, "RSI",      text_color=color.white, bgcolor=color.new(color.black, 0))
table.cell(ob, 1, 1, obVal,      text_color=color.white, bgcolor=color.new(color.black, 0))
table.cell(ob, 0, 2, "TRAP",     text_color=color.white, bgcolor=color.new(color.black, 0))
table.cell(ob, 1, 2, trapTxt,    text_color=color.white, bgcolor=trapBg)
