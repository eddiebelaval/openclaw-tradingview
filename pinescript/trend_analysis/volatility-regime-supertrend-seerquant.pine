indicator(
 title = "Volatility Regime Supertrend [SeerQuant]",
 shorttitle = "𝐕𝐑𝐒𝐓 [SeerQuant]",
 overlay = true,
 timeframe = "",
 timeframe_gaps = true
 )

// ----------------- ＳＴＡＴＩＣ ＶＡＲＩＡＢＬＥＳ ----------------- //

const string g1 = "Supertrend Core"
const string g2 = "Volatility Regime"
const string g3 = "Style Settings"

// ----------------- ＩＮＰＵＴ ＶＡＲＩＡＢＬＥＳ ----------------- //

// ​🇸​​🇹​​🇷​​🇮​​🇳​​🇬​​🇸​
string colScheme  = input.string(defval = "Default", title = "Colour Choice",
                                  options = ["Default", "Modern",
                                      "Cool", "Monochrome"],                          group = g3)

//​🇮​​🇳​​🇹​​🇸​
int atrLen        = input.int   (defval = 14,    title = "ATR Length",                 group = g1, minval = 1)
float compMult    = input.float (defval = 2.0,   title = "Compression Multiplier",     group = g1, minval = 0.5, step = 0.1,
                                  tooltip = "ATR multiplier during quiet, squeezing markets. Lower = tighter, more aggressive trailing.")
float expMult     = input.float (defval = 3.5,   title = "Expansion Multiplier",       group = g1, minval = 1.0, step = 0.1,
                                  tooltip = "ATR multiplier during volatile, expanding markets. Higher = wider, stays in the trend longer.")
int speed         = input.int   (defval = 2,     title = "Speed",                      group = g1, minval = 1, maxval = 10,
                                  tooltip = "How fast the Supertrend reacts. 1 = very slow and smooth. 10 = fully reactive. Controls band tracking speed.")
int bbLen         = input.int   (defval = 50,    title = "Bandwidth Lookback",         group = g2, minval = 5,
                                  tooltip = "Bollinger Bandwidth calculation period for regime detection.")
int rankLen       = input.int   (defval = 100,   title = "Regime Ranking Period",      group = g2, minval = 20,
                                  tooltip = "How many bars to rank current bandwidth against. Determines what counts as compression vs expansion.")
float compLevel   = input.float (defval = 30.0,  title = "Compression Percentile",     group = g2, minval = 5.0, maxval = 50.0, step = 5.0,
                                  tooltip = "Bandwidth below this percentile = compression regime.")
float expLevel    = input.float (defval = 70.0,  title = "Expansion Percentile",       group = g2, minval = 50.0, maxval = 95.0, step = 5.0,
                                  tooltip = "Bandwidth above this percentile = expansion regime.")

//​🇧​​🇴​​🇴​​🇱​​🇸​
bool colc         = input.bool  (defval = true,   title = "Color Candles?",            group = g3)
bool showSigs     = input.bool  (defval = true,   title = "Show Signal Markers?",      group = g3)
bool showFill     = input.bool  (defval = true,   title = "Show Trend Fill?",          group = g3)
bool showRegime   = input.bool  (defval = false,  title = "Show Regime Background?",   group = g3,
                                  tooltip = "Subtle background tint showing compression (blue) vs expansion (orange) regime.")
bool cust         = input.bool  (defval = false,  title = "Use Custom Colors?",        group = g3)

//​🇨​​🇴​​🇱​​🇴​​🇷​​🇸​
color bullc       = input.color (defval = #00ff00, title = "Bull Colour",             group = g3)
color bearc       = input.color (defval = #ff0000, title = "Bear Colour",             group = g3)

[bulld, beard] = switch colScheme
    "Default"    => [#00ff00, #ff0000]
    "Modern"     => [#23d7e4, #e11179]
    "Cool"       => [#00ffcc, #4e4f75]
    "Monochrome" => [#ffffff, #4e4e4e]

[bull, bear] = switch cust
    false => [bulld, beard]
    true  => [bullc, bearc]

// ----------------- ＣＡＬＣＵＬＡＴＩＯＮＳ ----------------- //

// ── Volatility Regime Detection ──
float bbBasis    = ta.sma(close, bbLen)
float bbDev      = ta.stdev(close, bbLen)
float bandwidth  = bbBasis != 0 ? (bbDev * 2.0) / bbBasis : 0.0

// Rank current bandwidth vs its own history
float bwHigh     = ta.highest(bandwidth, rankLen)
float bwLow      = ta.lowest (bandwidth, rankLen)
float bwRange    = bwHigh - bwLow
float bwRank     = bwRange != 0 ? (bandwidth - bwLow) / bwRange * 100.0 : 50.0

// Regime classification
bool isCompression = bwRank < compLevel
bool isExpansion   = bwRank > expLevel

// ── Regime-Dependent Multiplier ──
float regimeMult = isCompression ? compMult : isExpansion ? expMult : compMult + (expMult - compMult) * ((bwRank - compLevel) / (expLevel - compLevel))

// Smooth to avoid jarring jumps between regimes
float smoothMult = ta.ema(regimeMult, bbLen)

// ── ATR ──
float atr = ta.atr(atrLen)

// ── Core Supertrend ──
float src      = hl2
float upperRaw = src + smoothMult * atr
float lowerRaw = src - smoothMult * atr

// Speed control: alpha determines how quickly bands track the raw value
float speedAlpha = speed / 10.0

var float upperBand = na
var float lowerBand = na

// Standard Supertrend trailing logic, then blend with speed alpha
float upperTrail = na(upperBand[1]) ? upperRaw : (upperRaw < nz(upperBand[1]) or close[1] > nz(upperBand[1])) ? upperRaw : nz(upperBand[1])
float lowerTrail = na(lowerBand[1]) ? lowerRaw : (lowerRaw > nz(lowerBand[1]) or close[1] < nz(lowerBand[1])) ? lowerRaw : nz(lowerBand[1])

// Apply speed: blend between previous band and new trail position
upperBand := na(upperBand[1]) ? upperTrail : nz(upperBand[1]) + speedAlpha * (upperTrail - nz(upperBand[1]))
lowerBand := na(lowerBand[1]) ? lowerTrail : nz(lowerBand[1]) + speedAlpha * (lowerTrail - nz(lowerBand[1]))

// ── Direction ──
var int dir = 1

if close > nz(upperBand[1])
    dir := 1
if close < nz(lowerBand[1])
    dir := -1

// ── Supertrend Line ──
float st = dir == 1 ? lowerBand : upperBand

// ── Signals ──
bool isBull   = dir == 1
bool isBear   = dir == -1
bool longSig  = isBull and not isBull[1]
bool shortSig = isBear and not isBear[1]

// ----------------- ＰＬＯＴＴＩＮＧ ----------------- //

// ── Trend Colors ──
color trendCol  = isBull ? bull : bear
color trendFade = isBull ? color.new(bull, 85) : color.new(bear, 85)

// ── Regime Background ──
color regimeBG = showRegime ? (isCompression ? color.new(#4fc3f7, 94) : isExpansion ? color.new(#ffb74d, 94) : na) : na
bgcolor(regimeBG, title = "Regime Background")

// ── Supertrend Line ──
// Linewidth reflects regime: thinner during compression (nimble), thicker during expansion (committed)
plot(st, color = trendCol, linewidth = 3, title = "Supertrend", style = plot.style_linebr)

// ── Trend Fill ──
pClose = plot(showFill ? close : na, display = display.none, title = "Close")
pST    = plot(showFill ? st    : na, display = display.none, title = "ST Fill Ref")
fill(pClose, pST, color = showFill ? trendFade : na, title = "Trend Fill")

// ── Signal Markers ──
plotshape(showSigs and longSig,  title = "Long",  style = shape.triangleup,   location = location.belowbar, color = bull, size = size.small)
plotshape(showSigs and shortSig, title = "Short", style = shape.triangledown, location = location.abovebar, color = bear, size = size.small)

// ── Candle Coloring ──
color bullBar = isExpansion ? bull : color.new(bull, 30)
color bearBar = isExpansion ? bear : color.new(bear, 30)
color barCol  = isBull ? bullBar : bearBar
barcolor(color = colc ? barCol : na)

// ----------------- ＡＬＥＲＴＳ ----------------- //

alertcondition(longSig,              title = "VRST Long Signal",    message = "VRST Long on: {{exchange}}:{{ticker}} at {{close}}")
alertcondition(shortSig,             title = "VRST Short Signal",   message = "VRST Short on: {{exchange}}:{{ticker}} at {{close}}")
alertcondition(isBull,               title = "VRST Bullish",        message = "VRST Bullish on: {{exchange}}:{{ticker}}")
alertcondition(isBear,               title = "VRST Bearish",        message = "VRST Bearish on: {{exchange}}:{{ticker}}")
alertcondition(longSig or shortSig,  title = "VRST Trend Change",   message = "VRST Trend changed on: {{exchange}}:{{ticker}} at {{close}}")
alertcondition(isCompression,        title = "VRST Compression",    message = "VRST Compression regime on: {{exchange}}:{{ticker}}")
alertcondition(isExpansion,          title = "VRST Expansion",      message = "VRST Expansion regime on: {{exchange}}:{{ticker}}")

