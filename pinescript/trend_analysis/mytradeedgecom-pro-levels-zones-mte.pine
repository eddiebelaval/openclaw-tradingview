//@version=6
indicator("MyTradeEdge.com Pro Levels & Zones [MTE]", overlay=true, max_boxes_count=200, max_lines_count=200, max_labels_count=200)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════
g1 = "══ Supply & Demand Zones ══"
showZones      = input.bool(true, "Show Zones", group=g1)
zoneMinPts     = input.float(20, "Min Zone Size (pts)", minval=1, maxval=500, group=g1, tooltip="NQ: 20-50 pts. ES: 5-15 pts")
zoneMaxBars    = input.int(500, "Max Zone Age (bars)", minval=50, maxval=2000, group=g1)
showSignals    = input.bool(true, "Show Buy/Sell Signals", group=g1)
sigCooldown    = input.int(12, "Signal Cooldown (bars)", minval=1, maxval=50, group=g1, tooltip="12 bars on 5min = ~1hr between signals")
volConfirm     = input.bool(true, "Volume Delta Confirmation", group=g1)

g2 = "══ Session Levels ══"
showLondon     = input.bool(true, "London High/Low", group=g2)
showAsia       = input.bool(false, "Asia High/Low", group=g2)

g3 = "══ Key Levels (straight lines) ══"
showPDH = input.bool(false, "PDH", inline="1", group=g3)
showPDL = input.bool(false, "PDL", inline="1", group=g3)
showPDC = input.bool(false, "PDC", inline="2", group=g3)
showPMH = input.bool(false, "PMH", inline="2", group=g3)
showPML = input.bool(false, "PML", inline="3", group=g3)
showPWH = input.bool(false, "PWH", inline="3", group=g3)
showPWL = input.bool(false, "PWL", inline="4", group=g3)
showOP  = input.bool(false, "Opening Print", inline="4", group=g3)
showONH = input.bool(false, "ONH", inline="5", group=g3)
showONL = input.bool(false, "ONL", inline="5", group=g3)

g4 = "══ VWAP / POC / FVG / ORB ══"
showVWAP = input.bool(false, "VWAP", group=g4)
showPOC  = input.bool(false, "POC", group=g4)
showFVG  = input.bool(false, "Fair Value Gaps", group=g4)
showORB  = input.bool(false, "Opening Range", group=g4)
fvgMinPct = input.float(0.15, "FVG Min %", minval=0.01, maxval=5.0, step=0.01, group=g4)
orbMin    = input.int(15, "ORB Time", options=[15, 30], group=g4)

// ═══════════════════════════════════════════════════════════════════════════
// TIME
// ═══════════════════════════════════════════════════════════════════════════
etH = hour(time, "America/New_York")
etM = minute(time, "America/New_York")
etT = etH * 100 + etM

inRTH = etT >= 930 and etT < 1600
inPM  = etT >= 400 and etT < 930
inON  = etT >= 0 and etT < 400
inAsia = etT >= 1900 or etT < 300
inLdn  = etT >= 300 and etT < 1100

var bool pRTH = false, var bool pPM = false, var bool pON = false
var bool pAsia = false, var bool pLdn = false

startRTH  = inRTH and not pRTH
startPM   = inPM and not pPM
startON   = inON and not pON
startAsia = inAsia and not pAsia
startLdn  = inLdn and not pLdn
endAsia   = not inAsia and pAsia
endLdn    = not inLdn and pLdn

newDay = ta.change(time("D")) != 0

// Volume delta
sp  = math.max(high - low, syminfo.mintick)
vd  = volume * (close - low) / sp - volume * (high - close) / sp
vUp = vd > 0
vDn = vd < 0

// ═══════════════════════════════════════════════════════════════════════════
// SESSION TRACKING
// ═══════════════════════════════════════════════════════════════════════════
var float pmH = na, var float pmL = na
var float _ph = na, var float _pl = na
if startPM
    _ph := high
    _pl := low
else if inPM
    _ph := math.max(nz(_ph, high), high)
    _pl := math.min(nz(_pl, low), low)
if startRTH and not na(_ph)
    pmH := _ph
    pmL := _pl

var float opP = na
if startRTH
    opP := open

var float onH = na, var float onL = na
var float _oh = na, var float _ol = na
if startON
    _oh := high
    _ol := low
else if inON
    _oh := math.max(nz(_oh, high), high)
    _ol := math.min(nz(_ol, low), low)
if startPM and not na(_oh)
    onH := _oh
    onL := _ol

var float asH = na, var float asL = na
var float _ah = na, var float _al = na
if startAsia
    _ah := high
    _al := low
else if inAsia
    _ah := math.max(nz(_ah, high), high)
    _al := math.min(nz(_al, low), low)
if inAsia
    asH := _ah
    asL := _al
if endAsia
    asH := _ah
    asL := _al

var float ldH = na, var float ldL = na
var float _lh = na, var float _ll = na
if startLdn
    _lh := high
    _ll := low
else if inLdn
    _lh := math.max(nz(_lh, high), high)
    _ll := math.min(nz(_ll, low), low)
if inLdn
    ldH := _lh
    ldL := _ll
if endLdn
    ldH := _lh
    ldL := _ll

[pdH, pdL, pdC, pdO] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1], open[1]], barmerge.gaps_off, barmerge.lookahead_on)
[pwH, pwL] = request.security(syminfo.tickerid, "W", [high[1], low[1]], barmerge.gaps_off, barmerge.lookahead_on)

// ═══════════════════════════════════════════════════════════════════════════
// VWAP & POC
// ═══════════════════════════════════════════════════════════════════════════
vwapVal = ta.vwap(ohlc4)
plot(showVWAP ? vwapVal : na, "VWAP", #00bcd4, 2)

var float curPOC = na
var array<float> pVol = array.new_float(100, 0.0)
var float prH = na, var float prL = na
if newDay
    pVol := array.new_float(100, 0.0)
    prH := high
    prL := low
else if inRTH
    prH := math.max(nz(prH, high), high)
    prL := math.min(nz(prL, low), low)
if inRTH and volume > 0 and not na(prH) and not na(prL) and prH > prL
    bSz = (prH - prL) / 100
    if bSz > 0
        ix = math.max(0, math.min(math.floor((hl2 - prL) / bSz), 99))
        array.set(pVol, ix, array.get(pVol, ix) + volume)
        mV = 0.0
        mI = 0
        for i = 0 to 99
            v = array.get(pVol, i)
            if v > mV
                mV := v
                mI := i
        curPOC := prL + (mI + 0.5) * bSz
plot(showPOC ? curPOC : na, "POC", #42a5f5, 1, plot.style_circles)

// ═══════════════════════════════════════════════════════════════════════════
// SESSION LINES (stepline for real-time update during session)
// ═══════════════════════════════════════════════════════════════════════════
plot(showLondon ? ldH : na, "London High", #1e88e5, 2, plot.style_stepline)
plot(showLondon ? ldL : na, "London Low", #1565c0, 2, plot.style_stepline)
plot(showAsia ? asH : na, "Asia High", #ff9800, 1, plot.style_stepline)
plot(showAsia ? asL : na, "Asia Low", #00897b, 1, plot.style_stepline)

// ═══════════════════════════════════════════════════════════════════════════
// KEY LEVELS AS STRAIGHT LINES + ALL LABELS (on last bar only)
// ═══════════════════════════════════════════════════════════════════════════
makeLine(float price, color clr, string name) =>
    if not na(price)
        line.new(bar_index - 500, price, bar_index + 20, price, color=clr, width=1, style=line.style_dashed)
        label.new(bar_index + 20, price, name + " (" + str.tostring(price, format.mintick) + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=clr, size=size.small)

if barstate.islast
    if showPDH
        makeLine(pdH, #ef5350, "PDH")
    if showPDL
        makeLine(pdL, #26a69a, "PDL")
    if showPDC
        makeLine(pdC, #ab47bc, "PDC")
    if showPMH
        makeLine(pmH, #c62828, "PMH")
    if showPML
        makeLine(pmL, #66bb6a, "PML")
    if showOP
        makeLine(opP, color.white, "OP")
    if showPWH
        makeLine(pwH, #ff9800, "PWH")
    if showPWL
        makeLine(pwL, #009688, "PWL")
    if showONH
        makeLine(onH, #bdbdbd, "ONH")
    if showONL
        makeLine(onL, #757575, "ONL")
    // Session labels
    if showLondon and not na(ldH)
        label.new(bar_index + 20, ldH, "London High (" + str.tostring(ldH, format.mintick) + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=#1e88e5, size=size.normal)
    if showLondon and not na(ldL)
        label.new(bar_index + 20, ldL, "London Low (" + str.tostring(ldL, format.mintick) + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=#1565c0, size=size.normal)
    if showAsia and not na(asH)
        label.new(bar_index + 20, asH, "Asia High (" + str.tostring(asH, format.mintick) + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=#ff9800, size=size.normal)
    if showAsia and not na(asL)
        label.new(bar_index + 20, asL, "Asia Low (" + str.tostring(asL, format.mintick) + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=#00897b, size=size.normal)

// ═══════════════════════════════════════════════════════════════════════════
// CONFLUENCE SCORING
// ═══════════════════════════════════════════════════════════════════════════
near(float a, float b) => not na(b) and math.abs(a - b) / math.max(a, 1) * 100 < 0.15

calcScore(bool buy) =>
    float s = 0.0
    string r = ""
    if (buy and vUp) or (not buy and vDn)
        s += 1
        r += "✓Delta "
    if near(close, vwapVal)
        s += 1
        r += "✓VWAP "
    if buy and near(close, pdL)
        s += 1
        r += "✓PDL "
    if not buy and near(close, pdH)
        s += 1
        r += "✓PDH "
    if buy and near(close, pmL)
        s += 1
        r += "✓PML "
    if not buy and near(close, pmH)
        s += 1
        r += "✓PMH "
    if near(close, curPOC)
        s += 1
        r += "✓POC "
    if buy and near(close, ldL)
        s += 1
        r += "✓LDN "
    if not buy and near(close, ldH)
        s += 1
        r += "✓LDN "
    if (buy and close < vwapVal) or (not buy and close > vwapVal)
        s += 1
        r += "✓Trend "
    [s, r]

starsText(float s) => s >= 5 ? "★★★★★" : s >= 4 ? "★★★★☆" : s >= 3 ? "★★★☆☆" : s >= 2 ? "★★☆☆☆" : "★☆☆☆☆"
starsClr(float s) => s >= 4 ? #4caf50 : s >= 3 ? #ff9800 : #ef5350

// ═══════════════════════════════════════════════════════════════════════════
// SUPPLY & DEMAND ZONES (60min pivots, red/green fill)
// ═══════════════════════════════════════════════════════════════════════════
[h60, l60, o60, c60] = request.security(syminfo.tickerid, "60", [high, low, open, close], barmerge.gaps_off, barmerge.lookahead_off)
pvH = ta.pivothigh(h60, 3, 3)
pvL = ta.pivotlow(l60, 3, 3)

var array<box>  supBx = array.new_box(0)
var array<box>  demBx = array.new_box(0)
var array<bool> supUsed = array.new_bool(0)
var array<bool> demUsed = array.new_bool(0)
var int sigBar = 0

// --- Create supply zone: RED ---
if showZones and not na(pvH)
    t = h60[3]
    b = math.max(o60[3], c60[3])
    if t > b and (t - b) >= zoneMinPts
        array.push(supBx, box.new(bar_index - 3, t, bar_index + 5, b, bgcolor=color.new(color.red, 75), border_color=color.red, border_width=1))
        array.push(supUsed, false)

// --- Create demand zone: GREEN ---
if showZones and not na(pvL)
    b = l60[3]
    t = math.min(o60[3], c60[3])
    if t > b and (t - b) >= zoneMinPts
        array.push(demBx, box.new(bar_index - 3, t, bar_index + 5, b, bgcolor=color.new(color.green, 75), border_color=color.green, border_width=1))
        array.push(demUsed, false)

// --- Manage supply ---
if showZones and array.size(supBx) > 0
    for i = array.size(supBx) - 1 to 0
        if i < array.size(supBx)
            bx = array.get(supBx, i)
            tp = box.get_top(bx)
            bt = box.get_bottom(bx)
            age = bar_index - box.get_left(bx)
            if age > zoneMaxBars or close > tp
                box.delete(bx)
                array.remove(supBx, i)
                array.remove(supUsed, i)
            else
                box.set_right(bx, bar_index + 5)
                used = array.get(supUsed, i)
                if high >= bt and high <= tp and not used and showSignals
                    if (bar_index - sigBar) >= sigCooldown and close < open and (not volConfirm or vDn)
                        [sc, rsn] = calcScore(false)
                        label.new(bar_index, high, "Sell " + starsText(sc), tooltip="SELL\n" + rsn + "Score: " + str.tostring(sc, "#") + "/5", style=label.style_label_down, color=starsClr(sc), textcolor=color.white, size=size.small)
                        sigBar := bar_index
                        array.set(supUsed, i, true)

// --- Manage demand ---
if showZones and array.size(demBx) > 0
    for i = array.size(demBx) - 1 to 0
        if i < array.size(demBx)
            bx = array.get(demBx, i)
            tp = box.get_top(bx)
            bt = box.get_bottom(bx)
            age = bar_index - box.get_left(bx)
            if age > zoneMaxBars or close < bt
                box.delete(bx)
                array.remove(demBx, i)
                array.remove(demUsed, i)
            else
                box.set_right(bx, bar_index + 5)
                used = array.get(demUsed, i)
                if low >= bt and low <= tp and not used and showSignals
                    if (bar_index - sigBar) >= sigCooldown and close > open and (not volConfirm or vUp)
                        [sc, rsn] = calcScore(true)
                        label.new(bar_index, low, "Buy " + starsText(sc), tooltip="BUY\n" + rsn + "Score: " + str.tostring(sc, "#") + "/5", style=label.style_label_up, color=starsClr(sc), textcolor=color.white, size=size.small)
                        sigBar := bar_index
                        array.set(demUsed, i, true)

// Max 3 zones per side
if array.size(supBx) > 3
    box.delete(array.shift(supBx))
    array.shift(supUsed)
if array.size(demBx) > 3
    box.delete(array.shift(demBx))
    array.shift(demUsed)

// ═══════════════════════════════════════════════════════════════════════════
// FVG (off by default)
// ═══════════════════════════════════════════════════════════════════════════
var array<box> fvgBx = array.new_box(0)
var array<int> fvgSt = array.new_int(0)

if showFVG
    bg = low - high[2]
    bp = high[2] > 0 ? bg / high[2] * 100 : 0
    eg = low[2] - high
    ep = low[2] > 0 ? eg / low[2] * 100 : 0
    if bg > 0 and bp >= fvgMinPct
        array.push(fvgBx, box.new(bar_index-1, low, bar_index+5, high[2], bgcolor=color.new(#4caf50, 88), border_color=color.new(#4caf50, 70), border_width=1))
        array.push(fvgSt, bar_index)
    if eg > 0 and ep >= fvgMinPct
        array.push(fvgBx, box.new(bar_index-1, low[2], bar_index+5, high, bgcolor=color.new(#ef5350, 88), border_color=color.new(#ef5350, 70), border_width=1))
        array.push(fvgSt, bar_index)

if showFVG and array.size(fvgBx) > 0
    for i = array.size(fvgBx) - 1 to 0
        if i < array.size(fvgBx)
            age = bar_index - array.get(fvgSt, i)
            if age > 40
                box.delete(array.get(fvgBx, i))
                array.remove(fvgBx, i)
                array.remove(fvgSt, i)
            else
                box.set_right(array.get(fvgBx, i), bar_index + 5)

while array.size(fvgBx) > 6
    box.delete(array.shift(fvgBx))
    array.shift(fvgSt)

// ═══════════════════════════════════════════════════════════════════════════
// ORB (off by default)
// ═══════════════════════════════════════════════════════════════════════════
var float orbH = na, var float orbL = na, var bool orbOK = false, var box orbBx = na

if showORB
    if startRTH
        orbH := na
        orbL := na
        orbOK := false
        if not na(orbBx)
            box.delete(orbBx)
            orbBx := na
    if etT >= 930 and etT < (orbMin == 15 ? 945 : 1000)
        orbH := na(orbH) ? high : math.max(orbH, high)
        orbL := na(orbL) ? low : math.min(orbL, low)
    if etT >= (orbMin == 15 ? 945 : 1000) and not orbOK and not na(orbH)
        orbOK := true
        orbBx := box.new(bar_index - (orbMin == 15 ? 3 : 6), orbH, bar_index+5, orbL, bgcolor=color.new(#5c6bc0, 92), border_color=color.new(#5c6bc0, 40), border_width=1)
    if orbOK and not na(orbBx) and inRTH
        box.set_right(orbBx, bar_index + 5)

// ═══════════════════════════════════════════════════════════════════════════
// UPDATE STATE
// ═══════════════════════════════════════════════════════════════════════════
pRTH := inRTH
pPM  := inPM
pON  := inON
pAsia := inAsia
pLdn := inLdn
