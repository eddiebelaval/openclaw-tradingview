// Based on "Trendline Breakout with Volume Confirmation" concept by Dots3Red.
// Significantly enhanced with bullish trendlines, breakout scoring, retest detection,
// smart TP/SL, dashboard, dynamic alerts, and trendline age labels under Viprasol branding.

//@version=6
indicator("[Viprasol] Trendline Volume Breakout", shorttitle = "VP - TVB", overlay = true,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_polylines_count = 100)

// ══════════════════════════════════════════════════════════════════
// ─── CONSTANTS ───
// ══════════════════════════════════════════════════════════════════
var string GRP_DETECT    = "Trendline Detection"
var string GRP_BREAKOUT  = "Breakout Settings"
var string GRP_VOLUME    = "Volume Confirmation"
var string GRP_VISUAL    = "Visual Mode"
var string GRP_RETEST    = "Retest Detection"
var string GRP_TPSL      = "Take Profit / Stop Loss"
var string GRP_DASH      = "Dashboard"
var string GRP_STYLE     = "Style"

var int    DIR_BEAR      = -1
var int    DIR_BULL      = 1

// ══════════════════════════════════════════════════════════════════
// ─── INPUTS ───
// ══════════════════════════════════════════════════════════════════

// Trendline Detection
pivotLenInput       = input.int(3, "Pivot Length",                          group = GRP_DETECT, options = [2, 3, 4, 5, 6], tooltip = "Bars left/right for pivot detection. Higher = fewer but more significant trendlines.")
slopeFactorInput    = input.float(1.05, "Slope Factor",                    group = GRP_DETECT, options = [1.01, 1.02, 1.03, 1.04, 1.05, 1.06, 1.07, 1.08, 1.09, 1.1, 1.2, 1.3, 1.4, 1.5], tooltip = "Minimum ratio between pivot values to qualify as a valid trendline. Higher = steeper slopes only.")
showBearishInput    = input.bool(true, "Show Bearish Trendlines",          group = GRP_DETECT, tooltip = "Detect and display descending trendlines from pivot highs.")
showBullishInput    = input.bool(true, "Show Bullish Trendlines",          group = GRP_DETECT, tooltip = "Detect and display ascending trendlines from pivot lows.")
showAgeLabelInput   = input.bool(true, "Show Trendline Age",               group = GRP_DETECT, tooltip = "Display how many bars old each active trendline is.")

// Breakout Settings
breakoutPctInput    = input.float(3.0, "Breakout %",                       group = GRP_BREAKOUT, options = [0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0, 4.5, 5.0, 6.0, 7.0, 8.0, 9.0, 10.0], tooltip = "Price must exceed the trendline by this percentage to confirm a breakout.")

// Volume Confirmation
volSurgePctInput    = input.float(50.0, "Volume Surge % Threshold",        group = GRP_VOLUME, options = [10.0, 20.0, 30.0, 40.0, 50.0, 60.0, 70.0, 80.0, 90.0, 100.0, 125.0, 150.0], tooltip = "Volume must exceed its 20-bar MA by this % on breakout for confirmation.")
requireVolInput     = input.bool(true, "Require Volume Confirmation",      group = GRP_VOLUME, tooltip = "If enabled, breakouts without sufficient volume are filtered out.")
showVolBarInput     = input.bool(false, "Show Volume % Bar",               group = GRP_VOLUME, tooltip = "Display a volume percentage bar below the breakout candle.")
volMaPeriodInput    = input.int(20, "Volume MA Period",                    group = GRP_VOLUME, minval = 5, maxval = 50, tooltip = "Lookback period for the volume moving average used in surge detection.")

// Visual Mode
channelModeInput    = input.bool(false, "Channel Mode (vs Polygon)",       group = GRP_VISUAL, tooltip = "Channel draws parallel upper/lower bands. Polygon draws from trendline to the lowest low within the range.")
showShadingInput    = input.bool(true, "Show Trendline Shading",           group = GRP_VISUAL, tooltip = "Fill the area under/above the trendline with a shaded region.")

// Retest Detection
showRetestInput     = input.bool(true, "Show Retest Labels",               group = GRP_RETEST, tooltip = "Mark when price retests a recently broken trendline level.")
retestWindowInput   = input.int(10, "Retest Window (Bars)",                group = GRP_RETEST, minval = 3, maxval = 30, tooltip = "Number of bars after breakout to watch for a retest.")
retestToleranceInput = input.float(0.5, "Retest Tolerance %",             group = GRP_RETEST, minval = 0.1, maxval = 2.0, step = 0.1, tooltip = "How close price must come to the trendline extension to count as a retest.")

// TP / SL
showTpSlInput       = input.bool(true, "Show TP/SL Lines",                 group = GRP_TPSL, tooltip = "Draw take-profit and stop-loss levels after a confirmed breakout.")
slAtrMultInput      = input.float(1.5, "SL ATR Multiple",                  group = GRP_TPSL, minval = 0.5, maxval = 4.0, step = 0.1, tooltip = "Stop loss distance as a multiple of ATR.")
tp1RrInput          = input.float(1.5, "TP1 R:R",                          group = GRP_TPSL, minval = 0.5, maxval = 5.0, step = 0.1, tooltip = "Risk-reward ratio for first target.")
tp2RrInput          = input.float(2.5, "TP2 R:R",                          group = GRP_TPSL, minval = 1.0, maxval = 8.0, step = 0.1, tooltip = "Risk-reward ratio for second target.")
tpslBarsInput       = input.int(25, "TP/SL Display Bars",                  group = GRP_TPSL, minval = 5, maxval = 80, tooltip = "How many bars to extend the TP/SL lines.")

// Dashboard
showDashInput       = input.bool(true, "Show Dashboard",                    group = GRP_DASH, tooltip = "Display an info panel with breakout stats and active trendline info.")
dashPosInput        = input.string("Bottom Right", "Position",             group = GRP_DASH, options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right"], tooltip = "Dashboard position on chart.")
dashSizeInput       = input.string("Small", "Size",                        group = GRP_DASH, options = ["Tiny", "Small", "Normal"], tooltip = "Dashboard text size.")

// Style
bullTintInput       = input.color(#089981, "Bullish Color",                 group = GRP_STYLE, tooltip = "Color for bullish trendlines and breakout labels.")
bearTintInput       = input.color(#f23645, "Bearish Color",                 group = GRP_STYLE, tooltip = "Color for bearish trendlines.")
channelTintInput    = input.color(#00bcd4, "Channel Fill",                  group = GRP_STYLE, tooltip = "Shading color for channel/polygon areas.")
breakoutTintInput   = input.color(#c0ff00, "Breakout Label",               group = GRP_STYLE, tooltip = "Color for breakout marker labels.")
bgTintInput         = input.color(#131722, "Chart Background",             group = GRP_STYLE, tooltip = "Override chart background color. Set transparency to 100 to disable.")

// ══════════════════════════════════════════════════════════════════
// ─── UDT: TRENDLINE DATA ───
// ══════════════════════════════════════════════════════════════════

type TrendSegment
    line    trendLine
    int     leftBar
    int     rightBar
    float   leftPrice
    float   rightPrice
    float   extremePrice
    int     extremeBar
    int     extendedBar
    float   extendedPrice
    bool    isActive
    int     direction       // DIR_BULL or DIR_BEAR
    int     breakoutBar     // bar where breakout occurred
    float   breakoutPrice   // price at breakout

// ══════════════════════════════════════════════════════════════════
// ─── HELPER FUNCTIONS ───
// ══════════════════════════════════════════════════════════════════

resolveTablePos(string posStr) =>
    switch posStr
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        =>                position.bottom_right

resolveTextSize(string sizeStr) =>
    switch sizeStr
        "Tiny"   => size.tiny
        "Normal" => size.normal
        =>          size.small

findExtremeLowInSpan(int fromBar, int toBar) =>
    float lowestVal = 1e10
    int   lowestBar = fromBar
    for i = fromBar to toBar
        int offset = bar_index - i
        if offset >= 0 and low[offset] < lowestVal
            lowestVal := low[offset]
            lowestBar := i
    [lowestVal, lowestBar]

findExtremeHighInSpan(int fromBar, int toBar) =>
    float highestVal = 0.0
    int   highestBar = fromBar
    for i = fromBar to toBar
        int offset = bar_index - i
        if offset >= 0 and high[offset] > highestVal
            highestVal := high[offset]
            highestBar := i
    [highestVal, highestBar]

calcMaxDeviation(float slope, int lBar, float lPrice, int rBar) =>
    float maxDev = 0.0
    for x = lBar to rBar
        float projected = lPrice + slope * (x - lBar)
        float gap = projected - low[bar_index - x]
        if gap > maxDev
            maxDev := gap
    maxDev

calcMaxDeviationBull(float slope, int lBar, float lPrice, int rBar) =>
    float maxDev = 0.0
    for x = lBar to rBar
        float projected = lPrice + slope * (x - lBar)
        float gap = high[bar_index - x] - projected
        if gap > maxDev
            maxDev := gap
    maxDev

isDuplicateBearish(array<TrendSegment> segments, float lPrice, float rPrice, int lBar, int rBar) =>
    bool duplicate = false
    if array.size(segments) > 0
        float newSlope = (rPrice - lPrice) / (rBar - lBar)
        for i = 0 to array.size(segments) - 1
            TrendSegment seg = array.get(segments, i)
            if seg.isActive
                bool overlapping = lBar > seg.leftBar and rBar <= seg.extendedBar
                if overlapping
                    duplicate := true
                    break
    duplicate

isDuplicateBullish(array<TrendSegment> segments, float lPrice, float rPrice, int lBar, int rBar) =>
    bool duplicate = false
    if array.size(segments) > 0
        for i = 0 to array.size(segments) - 1
            TrendSegment seg = array.get(segments, i)
            if seg.isActive
                bool overlapping = lBar > seg.leftBar and rBar <= seg.extendedBar
                if overlapping
                    duplicate := true
                    break
    duplicate

renderScoreStars(int score) =>
    switch
        score >= 8 => "★★★"
        score >= 5 => "★★☆"
        score >= 3 => "★☆☆"
        =>            "☆☆☆"

// ══════════════════════════════════════════════════════════════════
// ─── SHADING FUNCTIONS ───
// ══════════════════════════════════════════════════════════════════

shadeBearishArea(TrendSegment seg) =>
    if showShadingInput
        pointLH = chart.point.from_index(seg.leftBar, seg.leftPrice)
        pointRH = chart.point.from_index(seg.extendedBar, seg.extendedPrice)
        points = array.new<chart.point>()

        if channelModeInput
            float slope = (seg.rightPrice - seg.leftPrice) / (seg.rightBar - seg.leftBar)
            float offset = calcMaxDeviation(slope, seg.leftBar, seg.leftPrice, seg.extendedBar)
            pointLL = chart.point.from_index(seg.leftBar, seg.leftPrice - offset)
            pointRL = chart.point.from_index(seg.extendedBar, seg.extendedPrice - offset)

            edgeUp = array.new<chart.point>()
            edgeDown = array.new<chart.point>()
            pointLH_E = chart.point.from_index(seg.leftBar, seg.leftPrice + offset * 0.05)
            pointRH_E = chart.point.from_index(seg.extendedBar, seg.extendedPrice + offset * 0.05)
            pointLL_E = chart.point.from_index(seg.leftBar, seg.leftPrice - offset * 1.05)
            pointRL_E = chart.point.from_index(seg.extendedBar, seg.extendedPrice - offset * 1.05)

            array.push(edgeUp, pointLH)
            array.push(edgeUp, pointLH_E)
            array.push(edgeUp, pointRH_E)
            array.push(edgeUp, pointRH)
            array.push(edgeDown, pointLL)
            array.push(edgeDown, pointRL)
            array.push(edgeDown, pointRL_E)
            array.push(edgeDown, pointLL_E)

            polyline.new(edgeUp, closed = true, fill_color = color.new(bearTintInput, 50), line_color = color.new(color.blue, 99))
            polyline.new(edgeDown, closed = true, fill_color = color.new(bearTintInput, 50), line_color = color.new(color.blue, 99))

            array.push(points, pointLH)
            array.push(points, pointRH)
            array.push(points, pointRL)
            array.push(points, pointLL)
            polyline.new(points, closed = true, fill_color = color.new(channelTintInput, 75), line_color = color.new(color.blue, 99))
        else
            pointLL = chart.point.from_index(seg.leftBar, seg.extremePrice)
            pointRL = chart.point.from_index(seg.extendedBar, seg.extremePrice)
            array.push(points, pointLH)
            array.push(points, pointLL)
            array.push(points, pointRL)
            array.push(points, pointRH)
            polyline.new(points, closed = true, fill_color = color.new(bearTintInput, 80), line_color = color.new(bearTintInput, 40))

shadeBullishArea(TrendSegment seg) =>
    if showShadingInput
        pointLL = chart.point.from_index(seg.leftBar, seg.leftPrice)
        pointRL = chart.point.from_index(seg.extendedBar, seg.extendedPrice)
        points = array.new<chart.point>()

        if channelModeInput
            float slope = (seg.rightPrice - seg.leftPrice) / (seg.rightBar - seg.leftBar)
            float offset = calcMaxDeviationBull(slope, seg.leftBar, seg.leftPrice, seg.extendedBar)
            pointLH = chart.point.from_index(seg.leftBar, seg.leftPrice + offset)
            pointRH = chart.point.from_index(seg.extendedBar, seg.extendedPrice + offset)

            edgeUp = array.new<chart.point>()
            edgeDown = array.new<chart.point>()
            pointLH_E = chart.point.from_index(seg.leftBar, seg.leftPrice + offset * 1.05)
            pointRH_E = chart.point.from_index(seg.extendedBar, seg.extendedPrice + offset * 1.05)
            pointLL_E = chart.point.from_index(seg.leftBar, seg.leftPrice - offset * 0.05)
            pointRL_E = chart.point.from_index(seg.extendedBar, seg.extendedPrice - offset * 0.05)

            array.push(edgeUp, pointLH)
            array.push(edgeUp, pointLH_E)
            array.push(edgeUp, pointRH_E)
            array.push(edgeUp, pointRH)
            array.push(edgeDown, pointLL)
            array.push(edgeDown, pointRL)
            array.push(edgeDown, pointRL_E)
            array.push(edgeDown, pointLL_E)

            polyline.new(edgeUp, closed = true, fill_color = color.new(bullTintInput, 50), line_color = color.new(color.blue, 99))
            polyline.new(edgeDown, closed = true, fill_color = color.new(bullTintInput, 50), line_color = color.new(color.blue, 99))

            array.push(points, pointLL)
            array.push(points, pointRL)
            array.push(points, pointRH)
            array.push(points, pointLH)
            polyline.new(points, closed = true, fill_color = color.new(channelTintInput, 75), line_color = color.new(color.blue, 99))
        else
            pointLH = chart.point.from_index(seg.leftBar, seg.extremePrice)
            pointRH = chart.point.from_index(seg.extendedBar, seg.extremePrice)
            array.push(points, pointLL)
            array.push(points, pointLH)
            array.push(points, pointRH)
            array.push(points, pointRL)
            polyline.new(points, closed = true, fill_color = color.new(bullTintInput, 80), line_color = color.new(bullTintInput, 40))

// ══════════════════════════════════════════════════════════════════
// ─── CORE CALCULATIONS ───
// ══════════════════════════════════════════════════════════════════

float atrValue     = ta.atr(14)
float volMaValue   = ta.sma(volume, volMaPeriodInput)
float volSurgePct  = volMaValue > 0 ? math.abs((volume - volMaValue) * 100.0 / volMaValue) : 0.0
bool  volSurgeOk   = volume > volMaValue * (1.0 + volSurgePctInput / 100.0)

float breakoutMult = 1.0 + breakoutPctInput / 100.0

// Pivot detection
pivotHighVal = ta.pivothigh(high, pivotLenInput, pivotLenInput)
pivotLowVal  = ta.pivotlow(low, pivotLenInput, pivotLenInput)

// ══════════════════════════════════════════════════════════════════
// ─── BEARISH TRENDLINE DETECTION ───
// ══════════════════════════════════════════════════════════════════

var array<TrendSegment> bearSegments = array.new<TrendSegment>()

var int   prevBearPivotBar   = na
var float prevBearPivotPrice = na

if showBearishInput and not na(pivotHighVal)
    int   currentBar   = bar_index - pivotLenInput
    float currentPrice = pivotHighVal

    if na(prevBearPivotBar)
        prevBearPivotBar   := currentBar
        prevBearPivotPrice := currentPrice
    else
        int   lBar   = prevBearPivotBar
        float lPrice = prevBearPivotPrice
        int   rBar   = currentBar
        float rPrice = currentPrice

        if lPrice / rPrice > slopeFactorInput
            if not isDuplicateBearish(bearSegments, lPrice, rPrice, lBar, rBar)
                line ln = line.new(lBar, lPrice, rBar, rPrice, color = na)
                [lowestVal, lowestBar] = findExtremeLowInSpan(lBar, rBar)
                TrendSegment newSeg = TrendSegment.new(ln, lBar, rBar, lPrice, rPrice, lowestVal, lowestBar, rBar, na, true, DIR_BEAR, na, na)
                array.push(bearSegments, newSeg)

        prevBearPivotBar   := currentBar
        prevBearPivotPrice := currentPrice

// ══════════════════════════════════════════════════════════════════
// ─── BULLISH TRENDLINE DETECTION ───
// ══════════════════════════════════════════════════════════════════

var array<TrendSegment> bullSegments = array.new<TrendSegment>()

var int   prevBullPivotBar   = na
var float prevBullPivotPrice = na

if showBullishInput and not na(pivotLowVal)
    int   currentBar   = bar_index - pivotLenInput
    float currentPrice = pivotLowVal

    if na(prevBullPivotBar)
        prevBullPivotBar   := currentBar
        prevBullPivotPrice := currentPrice
    else
        int   lBar   = prevBullPivotBar
        float lPrice = prevBullPivotPrice
        int   rBar   = currentBar
        float rPrice = currentPrice

        // Ascending: right pivot must be higher than left
        if rPrice / lPrice > slopeFactorInput
            if not isDuplicateBullish(bullSegments, lPrice, rPrice, lBar, rBar)
                line ln = line.new(lBar, lPrice, rBar, rPrice, color = na)
                [highestVal, highestBar] = findExtremeHighInSpan(lBar, rBar)
                TrendSegment newSeg = TrendSegment.new(ln, lBar, rBar, lPrice, rPrice, highestVal, highestBar, rBar, na, true, DIR_BULL, na, na)
                array.push(bullSegments, newSeg)

        prevBullPivotBar   := currentBar
        prevBullPivotPrice := currentPrice

// ══════════════════════════════════════════════════════════════════
// ─── BREAKOUT SCORING ───
// ══════════════════════════════════════════════════════════════════

calcBreakoutScore(int trendAge, bool hasVolSurge, float slopeAbs) =>
    int score = 0
    // Trendline age: older = more significant
    score += trendAge > 50 ? 3 : trendAge > 25 ? 2 : trendAge > 10 ? 1 : 0
    // Volume surge present
    score += hasVolSurge ? 3 : 0
    // Slope steepness
    score += slopeAbs > 0.002 ? 2 : slopeAbs > 0.001 ? 1 : 0
    // Displacement: large body candle
    float bodyRatio = (high - low) > 0 ? math.abs(close - open) / (high - low) : 0.0
    score += bodyRatio > 0.65 ? 2 : 0
    math.min(score, 10)

// ══════════════════════════════════════════════════════════════════
// ─── BREAKOUT EVENT TRACKING ───
// ══════════════════════════════════════════════════════════════════

var int   totalBearBreakouts = 0
var int   totalBullBreakouts = 0
var int   lastBreakoutScore  = 0
var int   lastBreakoutDir    = 0
var float lastBreakoutPrice  = na
var int   lastBreakoutBar    = na

bool bearBreakoutFired = false
bool bullBreakoutFired = false

// ─── Volume bar drawing helper ───
drawVolBar(float channelBottom) =>
    if showVolBarInput and volSurgePct > volSurgePctInput
        boxBg      = color.new(#FFB300, 80)
        boxBorder  = #FFD700
        float maxTop    = syminfo.type != "forex" ? low - low * 0.15 : low - low * 0.05
        float volNorm   = math.min(volSurgePct, 50.0) / 100.0
        float boxBottom = syminfo.type != "forex" ? channelBottom - channelBottom / 3.0 : channelBottom - channelBottom / 6.0
        float boxTop    = boxBottom + (maxTop - boxBottom) * volNorm
        box.new(bar_index - 1, boxBottom, bar_index + 1, maxTop, bgcolor = boxBg, border_color = boxBorder, force_overlay = true)
        label.new(bar_index, syminfo.type != "forex" ? boxBottom - boxBottom * 0.07 : boxBottom - boxBottom * 0.015,
             text = str.tostring(math.round(volSurgePct, 1)) + "%", style = label.style_none, textcolor = color.new(color.white, 20), size = size.small, yloc = yloc.price)

// ══════════════════════════════════════════════════════════════════
// ─── BEARISH TRENDLINE EXTENSION + BREAKOUT ───
// ══════════════════════════════════════════════════════════════════

if array.size(bearSegments) > 0
    for i = 0 to array.size(bearSegments) - 1
        TrendSegment seg = array.get(bearSegments, i)

        if seg.isActive
            float slope     = (seg.rightPrice - seg.leftPrice) / (seg.rightBar - seg.leftBar)
            float projected = seg.leftPrice + slope * (bar_index - seg.leftBar)
            bool  breakout  = close > projected * breakoutMult
            bool  volGateOk = requireVolInput ? volSurgeOk : true

            [newLow, newLowBar] = findExtremeLowInSpan(seg.leftBar, bar_index)
            seg.extremePrice := newLow
            seg.extremeBar   := newLowBar

            if (breakout and volGateOk) or barstate.islast
                seg.isActive     := false
                seg.extendedBar  := bar_index
                seg.extendedPrice := projected
                shadeBearishArea(seg)

                if breakout and volGateOk
                    int trendAge    = bar_index - seg.leftBar
                    float slopeAbs  = math.abs(slope) / seg.leftPrice
                    int score       = calcBreakoutScore(trendAge, volSurgeOk, slopeAbs)
                    string stars    = renderScoreStars(score)

                    seg.breakoutBar   := bar_index
                    seg.breakoutPrice := projected

                    totalBearBreakouts += 1
                    lastBreakoutScore  := score
                    lastBreakoutDir    := DIR_BULL
                    lastBreakoutPrice  := close
                    lastBreakoutBar    := bar_index
                    bearBreakoutFired  := true

                    // Breakout label
                    string tip = "Bearish TL Breakout (Bullish)\nScore: " + str.tostring(score) + "/10\n" +
                                 "TL Age: " + str.tostring(trendAge) + " bars\n" +
                                 "Volume Surge: " + str.tostring(math.round(volSurgePct, 1)) + "%"
                    label.new(bar_index, high * 1.002, "BO▲ " + stars, style = label.style_label_down,
                         color = color.new(bullTintInput, 70), textcolor = breakoutTintInput, size = size.small, tooltip = tip)

                    // TP/SL
                    if showTpSlInput
                        float slDist = atrValue * slAtrMultInput
                        float entry  = close
                        float sl     = entry - slDist
                        int endBar   = bar_index + tpslBarsInput
                        line.new(bar_index, sl,                       endBar, sl,                       color = bearTintInput, style = line.style_dashed, width = 1)
                        line.new(bar_index, entry + slDist * tp1RrInput, endBar, entry + slDist * tp1RrInput, color = bullTintInput, style = line.style_dotted, width = 1)
                        line.new(bar_index, entry + slDist * tp2RrInput, endBar, entry + slDist * tp2RrInput, color = bullTintInput, style = line.style_dotted, width = 1)
                        label.new(bar_index, sl, "SL", textcolor = bearTintInput, style = label.style_none, size = size.tiny)
                        label.new(bar_index, entry + slDist * tp1RrInput, "TP1", textcolor = bullTintInput, style = label.style_none, size = size.tiny)
                        label.new(bar_index, entry + slDist * tp2RrInput, "TP2", textcolor = bullTintInput, style = label.style_none, size = size.tiny)

                    drawVolBar(seg.extremePrice)
            else
                line.set_x2(seg.trendLine, bar_index)
                line.set_y2(seg.trendLine, projected)
                seg.extendedBar   := bar_index
                seg.extendedPrice := projected
                if low < seg.extremePrice
                    seg.extremePrice := low

                // Trendline age label
                if showAgeLabelInput and bar_index % 10 == 0
                    int age = bar_index - seg.leftBar
                    label.new(bar_index, projected, str.tostring(age) + "b", textcolor = color.new(bearTintInput, 40), style = label.style_none, size = size.tiny)

            array.set(bearSegments, i, seg)

// ══════════════════════════════════════════════════════════════════
// ─── BULLISH TRENDLINE EXTENSION + BREAKOUT ───
// ══════════════════════════════════════════════════════════════════

if array.size(bullSegments) > 0
    for i = 0 to array.size(bullSegments) - 1
        TrendSegment seg = array.get(bullSegments, i)

        if seg.isActive
            float slope     = (seg.rightPrice - seg.leftPrice) / (seg.rightBar - seg.leftBar)
            float projected = seg.leftPrice + slope * (bar_index - seg.leftBar)
            bool  breakout  = close < projected / breakoutMult
            bool  volGateOk = requireVolInput ? volSurgeOk : true

            [newHigh, newHighBar] = findExtremeHighInSpan(seg.leftBar, bar_index)
            seg.extremePrice := newHigh
            seg.extremeBar   := newHighBar

            if (breakout and volGateOk) or barstate.islast
                seg.isActive      := false
                seg.extendedBar   := bar_index
                seg.extendedPrice := projected
                shadeBullishArea(seg)

                if breakout and volGateOk
                    int trendAge    = bar_index - seg.leftBar
                    float slopeAbs  = math.abs(slope) / seg.leftPrice
                    int score       = calcBreakoutScore(trendAge, volSurgeOk, slopeAbs)
                    string stars    = renderScoreStars(score)

                    seg.breakoutBar   := bar_index
                    seg.breakoutPrice := projected

                    totalBullBreakouts += 1
                    lastBreakoutScore  := score
                    lastBreakoutDir    := DIR_BEAR
                    lastBreakoutPrice  := close
                    lastBreakoutBar    := bar_index
                    bullBreakoutFired  := true

                    string tip = "Bullish TL Breakout (Bearish)\nScore: " + str.tostring(score) + "/10\n" +
                                 "TL Age: " + str.tostring(trendAge) + " bars\n" +
                                 "Volume Surge: " + str.tostring(math.round(volSurgePct, 1)) + "%"
                    label.new(bar_index, low * 0.998, "BO▼ " + stars, style = label.style_label_up,
                         color = color.new(bearTintInput, 70), textcolor = breakoutTintInput, size = size.small, tooltip = tip)

                    if showTpSlInput
                        float slDist = atrValue * slAtrMultInput
                        float entry  = close
                        float sl     = entry + slDist
                        int endBar   = bar_index + tpslBarsInput
                        line.new(bar_index, sl,                       endBar, sl,                       color = bearTintInput, style = line.style_dashed, width = 1)
                        line.new(bar_index, entry - slDist * tp1RrInput, endBar, entry - slDist * tp1RrInput, color = bearTintInput, style = line.style_dotted, width = 1)
                        line.new(bar_index, entry - slDist * tp2RrInput, endBar, entry - slDist * tp2RrInput, color = bearTintInput, style = line.style_dotted, width = 1)
                        label.new(bar_index, sl, "SL", textcolor = bearTintInput, style = label.style_none, size = size.tiny)
                        label.new(bar_index, entry - slDist * tp1RrInput, "TP1", textcolor = bearTintInput, style = label.style_none, size = size.tiny)
                        label.new(bar_index, entry - slDist * tp2RrInput, "TP2", textcolor = bearTintInput, style = label.style_none, size = size.tiny)

                    drawVolBar(seg.extremePrice)
            else
                line.set_x2(seg.trendLine, bar_index)
                line.set_y2(seg.trendLine, projected)
                seg.extendedBar   := bar_index
                seg.extendedPrice := projected
                if high > seg.extremePrice
                    seg.extremePrice := high

                if showAgeLabelInput and bar_index % 10 == 0
                    int age = bar_index - seg.leftBar
                    label.new(bar_index, projected, str.tostring(age) + "b", textcolor = color.new(bullTintInput, 40), style = label.style_none, size = size.tiny)

            array.set(bullSegments, i, seg)

// ══════════════════════════════════════════════════════════════════
// ─── RETEST DETECTION ───
// ══════════════════════════════════════════════════════════════════

if showRetestInput
    // Check broken bearish trendlines for retest
    if array.size(bearSegments) > 0
        for i = 0 to array.size(bearSegments) - 1
            TrendSegment seg = array.get(bearSegments, i)
            if not seg.isActive and not na(seg.breakoutBar) and seg.direction == DIR_BEAR
                int barsSinceBO = bar_index - seg.breakoutBar
                if barsSinceBO > 1 and barsSinceBO <= retestWindowInput
                    float slope      = (seg.rightPrice - seg.leftPrice) / (seg.rightBar - seg.leftBar)
                    float tlLevel    = seg.leftPrice + slope * (bar_index - seg.leftBar)
                    float tolerance  = tlLevel * retestToleranceInput / 100.0
                    bool  touchedTl  = low <= tlLevel + tolerance and low >= tlLevel - tolerance
                    bool  closedAbove = close > tlLevel

                    if touchedTl and closedAbove
                        label.new(bar_index, low, "RT▲", style = label.style_label_up,
                             color = color.new(bullTintInput, 80), textcolor = bullTintInput, size = size.tiny,
                             tooltip = "Retest of broken bearish trendline\nTL Level: " + str.tostring(tlLevel, format.mintick))
                        seg.breakoutBar := na  // prevent duplicate retest labels
                        array.set(bearSegments, i, seg)

    // Check broken bullish trendlines for retest
    if array.size(bullSegments) > 0
        for i = 0 to array.size(bullSegments) - 1
            TrendSegment seg = array.get(bullSegments, i)
            if not seg.isActive and not na(seg.breakoutBar) and seg.direction == DIR_BULL
                int barsSinceBO = bar_index - seg.breakoutBar
                if barsSinceBO > 1 and barsSinceBO <= retestWindowInput
                    float slope      = (seg.rightPrice - seg.leftPrice) / (seg.rightBar - seg.leftBar)
                    float tlLevel    = seg.leftPrice + slope * (bar_index - seg.leftBar)
                    float tolerance  = tlLevel * retestToleranceInput / 100.0
                    bool  touchedTl  = high >= tlLevel - tolerance and high <= tlLevel + tolerance
                    bool  closedBelow = close < tlLevel

                    if touchedTl and closedBelow
                        label.new(bar_index, high, "RT▼", style = label.style_label_down,
                             color = color.new(bearTintInput, 80), textcolor = bearTintInput, size = size.tiny,
                             tooltip = "Retest of broken bullish trendline\nTL Level: " + str.tostring(tlLevel, format.mintick))
                        seg.breakoutBar := na
                        array.set(bullSegments, i, seg)

// ══════════════════════════════════════════════════════════════════
// ─── BAR COLOR & BACKGROUND ───
// ══════════════════════════════════════════════════════════════════

barcolor(color.new(#b2b5be, 0), title = "Default Bar Color")
bgcolor(bgTintInput, title = "Chart Background Override")

// ══════════════════════════════════════════════════════════════════
// ─── DASHBOARD ───
// ══════════════════════════════════════════════════════════════════

var table dashPanel = na

if showDashInput and barstate.islast
    tblPos  = resolveTablePos(dashPosInput)
    tblSize = resolveTextSize(dashSizeInput)

    int activeBear = 0
    int activeBull = 0
    if array.size(bearSegments) > 0
        for i = 0 to array.size(bearSegments) - 1
            if array.get(bearSegments, i).isActive
                activeBear += 1
    if array.size(bullSegments) > 0
        for i = 0 to array.size(bullSegments) - 1
            if array.get(bullSegments, i).isActive
                activeBull += 1

    dashPanel := table.new(tblPos, 2, 9, bgcolor = color.new(#1e222d, 10), border_color = color.new(chart.fg_color, 80), border_width = 1, frame_color = color.new(chart.fg_color, 80), frame_width = 1)

    // Header
    table.cell(dashPanel, 0, 0, "VP - TVB", text_color = color.new(#2196f3, 0), text_size = tblSize, text_halign = text.align_center)
    table.merge_cells(dashPanel, 0, 0, 1, 0)

    // Active trendlines
    table.cell(dashPanel, 0, 1, "Active Bear TL", text_color = chart.fg_color, text_size = tblSize)
    table.cell(dashPanel, 1, 1, str.tostring(activeBear), text_color = bearTintInput, text_size = tblSize)

    table.cell(dashPanel, 0, 2, "Active Bull TL", text_color = chart.fg_color, text_size = tblSize)
    table.cell(dashPanel, 1, 2, str.tostring(activeBull), text_color = bullTintInput, text_size = tblSize)

    // Breakout counts
    table.cell(dashPanel, 0, 3, "Bear TL BOs", text_color = chart.fg_color, text_size = tblSize)
    table.cell(dashPanel, 1, 3, str.tostring(totalBearBreakouts), text_color = bullTintInput, text_size = tblSize)

    table.cell(dashPanel, 0, 4, "Bull TL BOs", text_color = chart.fg_color, text_size = tblSize)
    table.cell(dashPanel, 1, 4, str.tostring(totalBullBreakouts), text_color = bearTintInput, text_size = tblSize)

    // Last breakout info
    string lastDir = lastBreakoutDir == DIR_BULL ? "Bullish" : lastBreakoutDir == DIR_BEAR ? "Bearish" : "—"
    color  lastClr = lastBreakoutDir == DIR_BULL ? bullTintInput : lastBreakoutDir == DIR_BEAR ? bearTintInput : color.new(#787b86, 50)
    table.cell(dashPanel, 0, 5, "Last BO", text_color = chart.fg_color, text_size = tblSize)
    table.cell(dashPanel, 1, 5, lastDir, text_color = lastClr, text_size = tblSize)

    table.cell(dashPanel, 0, 6, "Last Score", text_color = chart.fg_color, text_size = tblSize)
    table.cell(dashPanel, 1, 6, lastBreakoutScore > 0 ? str.tostring(lastBreakoutScore) + "/10 " + renderScoreStars(lastBreakoutScore) : "—", text_color = lastClr, text_size = tblSize)

    // Volume
    table.cell(dashPanel, 0, 7, "Vol Surge", text_color = chart.fg_color, text_size = tblSize)
    table.cell(dashPanel, 1, 7, str.tostring(math.round(volSurgePct, 1)) + "%", text_color = volSurgeOk ? bullTintInput : color.new(#787b86, 50), text_size = tblSize)

    // Branding
    table.cell(dashPanel, 0, 8, "VIPRASOL", text_color = color.new(#2196f3, 30), text_size = size.tiny, text_halign = text.align_center)
    table.merge_cells(dashPanel, 0, 8, 1, 8)

// ══════════════════════════════════════════════════════════════════
// ─── ALERTS — DYNAMIC v6 ───
// ══════════════════════════════════════════════════════════════════

if bearBreakoutFired
    alert("VP-TVB | BULLISH BREAKOUT (Bear TL) | " + syminfo.ticker + " | " + timeframe.period +
         " | Price: " + str.tostring(close) + " | Score: " + str.tostring(lastBreakoutScore) + "/10" +
         " | Vol: " + str.tostring(math.round(volSurgePct, 1)) + "%", alert.freq_once_per_bar_close)

if bullBreakoutFired
    alert("VP-TVB | BEARISH BREAKOUT (Bull TL) | " + syminfo.ticker + " | " + timeframe.period +
         " | Price: " + str.tostring(close) + " | Score: " + str.tostring(lastBreakoutScore) + "/10" +
         " | Vol: " + str.tostring(math.round(volSurgePct, 1)) + "%", alert.freq_once_per_bar_close)

// ─── Legacy alertcondition (static) ───
alertcondition(bearBreakoutFired, "Bullish Breakout (Bear TL)", "VP-TVB: Bullish breakout — descending trendline broken upward with volume.")
alertcondition(bullBreakoutFired, "Bearish Breakout (Bull TL)", "VP-TVB: Bearish breakout — ascending trendline broken downward with volume.")
alertcondition(bearBreakoutFired and lastBreakoutScore >= 7, "High Score Bullish BO", "VP-TVB: High-confidence bullish breakout (7+/10).")
alertcondition(bullBreakoutFired and lastBreakoutScore >= 7, "High Score Bearish BO", "VP-TVB: High-confidence bearish breakout (7+/10).")
alertcondition(bearBreakoutFired or bullBreakoutFired, "Any Breakout", "VP-TVB: Trendline breakout detected.")
alertcondition(volSurgeOk, "Volume Surge", "VP-TVB: Volume surge detected above threshold.")
