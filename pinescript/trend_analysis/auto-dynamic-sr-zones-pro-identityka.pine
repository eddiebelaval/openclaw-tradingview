//@version=5
indicator("Auto Dynamic S/R Zones Pro [identityKa]", overlay=true, max_boxes_count=50, max_labels_count=50)

// ==========================================
// 1. USER INPUTS (GLOBAL ENGLISH)
// ==========================================
grp1 = "⚙️ S/R Zone Settings"
pivot_len = input.int(15, "Pivot Sensitivity", group=grp1, tooltip="Higher values find major macro zones. Lower values find micro scalp zones.")
max_zones = input.int(3, "Max Zones to Display (Per Side)", minval=1, maxval=10, group=grp1, tooltip="Keeps the chart clean by only showing the most recent X support and resistance zones.")

grp2 = "🎨 identityKa Theme & Mitigation"
col_res = input.color(color.new(#ff1744, 80), "Resistance Zone (Red)", group=grp2)
col_res_txt = input.color(#ff1744, "Resistance Text Color", group=grp2)
col_sup = input.color(color.new(#00ffbb, 80), "Support Zone (Green)", group=grp2)
col_sup_txt = input.color(#00ffbb, "Support Text Color", group=grp2)

// ==========================================
// 2. ARRAYS FOR SMART CLEANUP
// ==========================================
var box[] res_boxes = array.new_box()
var label[] res_labels = array.new_label()

var box[] sup_boxes = array.new_box()
var label[] sup_labels = array.new_label()

// Alert triggers
bool res_broken = false
bool sup_broken = false

// ==========================================
// 3. PIVOT & ZONE DETECTION
// ==========================================
ph = ta.pivothigh(high, pivot_len, pivot_len)
pl = ta.pivotlow(low, pivot_len, pivot_len)

// --- RESISTANCE ZONES (Supply) ---
if not na(ph)
    top_val = high[pivot_len]
    btm_val = math.max(open[pivot_len], close[pivot_len])
    start_idx = bar_index[pivot_len]
    
    b = box.new(left=start_idx, top=top_val, right=bar_index + 15, bottom=btm_val, border_color=na, bgcolor=col_res)
    lbl = label.new(x=bar_index + 15, y=top_val, text="RESISTANCE", color=color.new(color.white, 100), textcolor=col_res_txt, style=label.style_label_left, size=size.small)
    
    array.push(res_boxes, b)
    array.push(res_labels, lbl)
    
    if array.size(res_boxes) > max_zones
        box.delete(array.shift(res_boxes))
        label.delete(array.shift(res_labels))

// --- SUPPORT ZONES (Demand) ---
if not na(pl)
    btm_val = low[pivot_len]
    top_val = math.min(open[pivot_len], close[pivot_len])
    start_idx = bar_index[pivot_len]
    
    b = box.new(left=start_idx, top=top_val, right=bar_index + 15, bottom=btm_val, border_color=na, bgcolor=col_sup)
    lbl = label.new(x=bar_index + 15, y=btm_val, text="SUPPORT", color=color.new(color.white, 100), textcolor=col_sup_txt, style=label.style_label_left, size=size.small)
    
    array.push(sup_boxes, b)
    array.push(sup_labels, lbl)
    
    if array.size(sup_boxes) > max_zones
        box.delete(array.shift(sup_boxes))
        label.delete(array.shift(sup_labels))

// ==========================================
// 4. SMART MITIGATION & EXTENSION ENGINE
// ==========================================
// Check Resistances
if array.size(res_boxes) > 0
    for i = array.size(res_boxes) - 1 to 0
        b = array.get(res_boxes, i)
        lbl = array.get(res_labels, i)
        
        // Mitigation Check: Did candle close ABOVE the resistance box?
        if close > box.get_top(b) and bar_index > box.get_left(b)
            box.delete(b)
            label.delete(lbl)
            array.remove(res_boxes, i)
            array.remove(res_labels, i)
            res_broken := true
        else
            box.set_right(b, bar_index + 15)
            label.set_x(lbl, bar_index + 15)

// Check Supports
if array.size(sup_boxes) > 0
    for i = array.size(sup_boxes) - 1 to 0
        b = array.get(sup_boxes, i)
        lbl = array.get(sup_labels, i)
        
        // Mitigation Check: Did candle close BELOW the support box?
        if close < box.get_bottom(b) and bar_index > box.get_left(b)
            box.delete(b)
            label.delete(lbl)
            array.remove(sup_boxes, i)
            array.remove(sup_labels, i)
            sup_broken := true
        else
            box.set_right(b, bar_index + 15)
            label.set_x(lbl, bar_index + 15)

// ==========================================
// 5. GLOBAL ALERTS (BREAKOUTS)
// ==========================================
alertcondition(res_broken, title="🟢 Resistance Broken (Bullish)", message="identityKa: A Resistance Zone was mitigated and broken UPWARDS. Potential bullish continuation!")
alertcondition(sup_broken, title="🔴 Support Broken (Bearish)", message="identityKa: A Support Zone was mitigated and broken DOWNWARDS. Potential bearish continuation!")
