//@version=6
indicator("Reverse ZigZag", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=5000)

// ─── Inputs ───
devPct         = input.float(5.0,   "Deviation %",          minval=0.1, step=0.1)
depth          = input.int(10,      "Depth",                 minval=2,   tooltip="Minimum bars to scan before the first pivot can be detected. Higher = more stable initial direction.")
minLegBars     = input.int(2,       "Min Leg Bars",          minval=1,   tooltip="Minimum number of bars between two pivots. Short legs get merged into longer ones.")
maxBars        = input.int(500,     "Lookback Bars",         minval=50,  maxval=5000)
confirmedOnly  = input.bool(false,  "Confirmed Pivots Only", tooltip="Hide the last unconfirmed leg. Only show zigzag up to the last confirmed pivot.")
showLabels     = input.bool(true,   "Show Price Labels")
lineCol        = input.color(color.new(#2196F3, 0), "Line Color")
lineWidth      = input.int(2,       "Line Width",           minval=1, maxval=5)
bullCol        = input.color(color.new(#089981, 0), "High Pivot Color")
bearCol        = input.color(color.new(#F23645, 0), "Low Pivot Color")

// ─── Only run on the last bar ───
if barstate.islast

    pivotPrice = array.new<float>()
    pivotBar   = array.new<int>()
    pivotType  = array.new<int>()   // 1 = high, -1 = low

    float dev  = devPct / 100.0
    int lookback = math.min(maxBars, bar_index)

    // ═══════════════════════════════════════════════════
    // PASS 1: Find ALL pivots (deviation only)
    // ═══════════════════════════════════════════════════

    // Phase 1: Find the first pivot from the right.
    // Scan at least 'depth' bars before allowing a trigger.
    // This prevents tiny deviation changes from flipping the
    // initial direction and producing completely different results.
    float runHi    = high[0]
    int   runHiOff = 0
    float runLo    = low[0]
    int   runLoOff = 0
    int   dir      = 0
    int   startOff = 1

    for i = 1 to lookback
        if high[i] > runHi
            runHi    := high[i]
            runHiOff := i
        if low[i] < runLo
            runLo    := low[i]
            runLoOff := i

        // Must scan at least 'depth' bars AND meet deviation AND extremes on different bars
        if i >= depth and runHi / runLo - 1.0 >= dev and runHiOff != runLoOff
            // Start Phase 2 AFTER both extremes — never re-scan Phase 1 bars
            int beyondBoth = math.max(runHiOff, runLoOff) + 1
            if runHiOff < runLoOff
                pivotPrice.push(runHi)
                pivotBar.push(bar_index - runHiOff)
                pivotType.push(1)
                dir      := -1
                startOff := beyondBoth
            else
                pivotPrice.push(runLo)
                pivotBar.push(bar_index - runLoOff)
                pivotType.push(-1)
                dir      := 1
                startOff := beyondBoth
            break

    // Phase 2: Walk backwards — pure deviation logic
    if dir != 0
        float extreme    = dir == -1 ? runLo : runHi
        int   extremeOff = dir == -1 ? runLoOff : runHiOff

        for i = startOff to lookback
            float h = high[i]
            float l = low[i]

            if dir == -1
                if l < extreme
                    extreme    := l
                    extremeOff := i
                else if h >= extreme * (1.0 + dev)
                    pivotPrice.push(extreme)
                    pivotBar.push(bar_index - extremeOff)
                    pivotType.push(-1)
                    dir        := 1
                    extreme    := h
                    extremeOff := i

            else if dir == 1
                if h > extreme
                    extreme    := h
                    extremeOff := i
                else if l <= extreme * (1.0 - dev)
                    pivotPrice.push(extreme)
                    pivotBar.push(bar_index - extremeOff)
                    pivotType.push(1)
                    dir        := -1
                    extreme    := l
                    extremeOff := i

        // Push the last unconfirmed extreme
        if not confirmedOnly and pivotPrice.size() > 0
            float lastP = pivotPrice.last()
            if extreme != lastP
                pivotPrice.push(extreme)
                pivotBar.push(bar_index - extremeOff)
                pivotType.push(dir == 1 ? 1 : -1)

    // ═══════════════════════════════════════════════════
    // PASS 2: Remove short legs (minLegBars filter)
    // ═══════════════════════════════════════════════════
    if minLegBars > 1
        bool changed = true
        int  safety  = 0
        int  maxIter = pivotPrice.size()

        while changed and safety < maxIter
            changed := false
            safety  += 1

            int sz = pivotPrice.size()
            if sz < 3
                break

            int   shortIdx  = -1
            int   shortBars = maxBars + 1

            for i = 0 to sz - 2
                int legLen = math.abs(pivotBar.get(i) - pivotBar.get(i + 1))
                if legLen < minLegBars and legLen < shortBars
                    shortBars := legLen
                    shortIdx  := i

            if shortIdx == -1
                break

            int idx = shortIdx

            if idx + 2 < sz
                int   t  = pivotType.get(idx)
                float p0 = pivotPrice.get(idx)
                int   b0 = pivotBar.get(idx)
                float p2 = pivotPrice.get(idx + 2)
                int   b2 = pivotBar.get(idx + 2)

                if t == 1
                    if p2 >= p0
                        pivotPrice.set(idx, p2)
                        pivotBar.set(idx, b2)
                else
                    if p2 <= p0
                        pivotPrice.set(idx, p2)
                        pivotBar.set(idx, b2)

                pivotPrice.remove(idx + 2)
                pivotBar.remove(idx + 2)
                pivotType.remove(idx + 2)
                pivotPrice.remove(idx + 1)
                pivotBar.remove(idx + 1)
                pivotType.remove(idx + 1)
            else
                pivotPrice.remove(sz - 1)
                pivotBar.remove(sz - 1)
                pivotType.remove(sz - 1)

            changed := true

    // ─── Phase 3: Draw lines ───
    int total = pivotPrice.size()

    if total >= 2
        for i = 0 to total - 2
            float p1 = pivotPrice.get(i)
            int   b1 = pivotBar.get(i)
            float p2 = pivotPrice.get(i + 1)
            int   b2 = pivotBar.get(i + 1)
            line.new(b1, p1, b2, p2, color=lineCol, width=lineWidth)

    // ─── Phase 4: Draw labels ───
    if showLabels and total >= 1
        for i = 0 to total - 1
            float p = pivotPrice.get(i)
            int   b = pivotBar.get(i)
            int   t = pivotType.get(i)

            string priceTxt = str.tostring(p, format.mintick)
            string chgTxt = ""
            if i < total - 1
                float prevChron = pivotPrice.get(i + 1)
                float chgPct = (p - prevChron) / prevChron * 100.0
                chgTxt := " (" + (chgPct >= 0 ? "+" : "") + str.tostring(chgPct, "#.##") + "%)"
            string txt = priceTxt + chgTxt

            if t == 1
                label.new(b, p, txt, style=label.style_label_down, color=color.new(bullCol, 80), textcolor=bullCol, size=size.small)
            else
                label.new(b, p, txt, style=label.style_label_up, color=color.new(bearCol, 80), textcolor=bearCol, size=size.small)
