//@version=6
indicator("Fibonacci Imbalance Zones [JOAT]", "FIZ [JOAT]", overlay=true, max_lines_count=500, max_boxes_count=300, max_labels_count=200)

// ══════════════════════════════════════════════════════════════════════════════
// FIBONACCI IMBALANCE ZONES
// Combines Fibonacci retracement with FVG detection for institutional confluence
// Features: Auto-Fibonacci levels, FVG detection, Confluence zones, Entry signals
// ══════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────
// COLOR PALETTE - Quantum Fibonacci Theme
// ─────────────────────────────────────────────────────────────────────────────
// Fibonacci Level Colors
var color FIZ_FIB_236        = #82aaff
var color FIZ_FIB_382        = #89ddff
var color FIZ_FIB_500        = #c792ea
var color FIZ_FIB_618        = #ffcb6b
var color FIZ_FIB_786        = #f07178
var color FIB_EXTENSION      = #c3e88d

// Advanced Fibonacci Colors
var color FIZ_FIB_127        = #b2ebf2
var color FIZ_FIB_414        = #80cbc4
var color FIZ_FIB_707        = #ce93d8
var color FIZ_FIB_886        = #ffab91

// FVG & Imbalance Colors
var color FIZ_FVG_BULL       = #00d4a1
var color FIZ_FVG_BEAR       = #ff4976
var color FIZ_FVG_PREMIUM    = #ffd700
var color FIZ_FVG_DISCOUNT   = #00bcd4

// Confluence & Entry Colors
var color FIZ_CONFLUENCE     = #e040fb
var color FIZ_CONFLUENCE_STRONG = #ff6ec7
var color FIZ_STRUCTURE_BULL = #00e5cc
var color FIZ_STRUCTURE_BEAR = #e06377
var color FIZ_ENTRY_BULL     = #00ffd5
var color FIZ_ENTRY_BEAR     = #ff2d55

// Institutional Colors
var color FIZ_INSTITUTIONAL  = #9c27b0
var color FIZ_SMART_MONEY    = #673ab7
var color FIZ_LIQUIDITY      = #e91e63
var color FIZ_IMBALANCE      = #ff5722

// Visual Effects
var color FIZ_GOLDEN_RATIO   = #ffd700
var color FIZ_HARMONIC       = #4caf50
var color FIZ_NEUTRAL        = #607d8b
var color FIZ_WARNING        = #ff9800
var color FIZ_BACKGROUND     = #1a237e

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────
string grpFib = "Fibonacci Settings"
int fibLookback       = input.int(50, "Swing Lookback", minval=10, maxval=200, group=grpFib)
int pivotStrength     = input.int(5, "Pivot Strength", minval=2, maxval=20, group=grpFib)
bool showFib236       = input.bool(true, "Show 0.236 Level", group=grpFib)
bool showFib382       = input.bool(true, "Show 0.382 Level", group=grpFib)
bool showFib500       = input.bool(true, "Show 0.500 Level", group=grpFib)
bool showFib618       = input.bool(true, "Show 0.618 Level", group=grpFib)
bool showFib786       = input.bool(true, "Show 0.786 Level", group=grpFib)
bool showExtensions   = input.bool(true, "Show Extensions", group=grpFib)

string grpFVG = "FVG Detection"
bool showFVG          = input.bool(true, "Show FVG Zones", group=grpFVG)
int fvgMaxBars        = input.int(50, "FVG Max Age (bars)", minval=10, maxval=200, group=grpFVG)
bool trackMitigation  = input.bool(true, "Track Mitigation", group=grpFVG)
float minFVGSize      = input.float(0.3, "Min FVG Size (ATR)", minval=0.1, maxval=2.0, step=0.1, group=grpFVG)

string grpConfluence = "Confluence Settings"
bool showConfluence   = input.bool(true, "Show Confluence Zones", group=grpConfluence)
float confluenceTol   = input.float(0.3, "Confluence Tolerance (ATR)", minval=0.1, maxval=1.0, step=0.1, group=grpConfluence)
bool showEntrySignals = input.bool(true, "Show Entry Signals", group=grpConfluence)
bool showConfluenceStrength = input.bool(true, "Show Confluence Strength", group=grpConfluence)
int minConfluenceStrength = input.int(2, "Min Confluence Strength", minval=2, maxval=5, group=grpConfluence)

string grpAdvanced = "Advanced Fibonacci"
bool showHarmonicRatios = input.bool(true, "Show Harmonic Ratios", group=grpAdvanced)
bool showInstitutionalLevels = input.bool(true, "Show Institutional Levels", group=grpAdvanced)
bool showSmartMoneyConcepts = input.bool(true, "Show Smart Money Concepts", group=grpAdvanced)
bool showOrderBlocks = input.bool(true, "Show Order Blocks", group=grpAdvanced)
bool showPremiumDiscount = input.bool(true, "Show Premium/Discount", group=grpAdvanced)
float institutionalThreshold = input.float(0.5, "Institutional Threshold (ATR)", minval=0.1, maxval=2.0, step=0.1, group=grpAdvanced)

string grpVisual = "Visual Settings"
bool showStructure    = input.bool(true, "Show Structure Lines", group=grpVisual)
bool showDashboard    = input.bool(true, "Show Dashboard", group=grpVisual)
int maxElements       = input.int(30, "Max Visual Elements", minval=10, maxval=100, group=grpVisual)
bool showGlowEffect   = input.bool(true, "Show Glow Effects", group=grpVisual)
bool showAnimation    = input.bool(true, "Animate Levels", group=grpVisual)
string colorScheme   = input.string("Quantum", "Color Scheme", options=["Quantum", "Classic", "Professional", "Minimal"], group=grpVisual)

// ─────────────────────────────────────────────────────────────────────────────
// TYPE DEFINITIONS
// ─────────────────────────────────────────────────────────────────────────────
type FibLevel
    float price
    float ratio
    color levelColor
    line levelLine
    label levelLabel
    bool isActive
    float strength
    bool isHarmonic

type FVGZone
    float top
    float bottom
    float mid
    int barIdx
    bool isBullish
    bool isMitigated
    box zoneBox
    int mitigationBar
    float volume
    bool isPremium
    bool isDiscount

type ConfluencePoint
    float price
    float fibRatio
    bool hasFVG
    bool isBullish
    int strength
    box confluenceBox
    label confluenceLabel
    array<string> confluenceTypes
    float confidence

type SwingPoint
    float price
    int barIdx
    bool isHigh
    float volume

type OrderBlock
    float top
    float bottom
    int barIdx
    bool isBullish
    box obBox
    bool isSwept
    float strength

type InstitutionalLevel
    float price
    string type
    float volume
    line levelLine
    label levelLabel
    bool isActive

// ─────────────────────────────────────────────────────────────────────────────
// GLOBAL VARIABLES
// ─────────────────────────────────────────────────────────────────────────────
var array<FibLevel> fibLevels = array.new<FibLevel>()
var array<FVGZone> fvgZones = array.new<FVGZone>()
var array<ConfluencePoint> confluencePoints = array.new<ConfluencePoint>()
var array<OrderBlock> orderBlocks = array.new<OrderBlock>()
var array<InstitutionalLevel> institutionalLevels = array.new<InstitutionalLevel>()

var SwingPoint swingHigh = SwingPoint.new(na, na, true, na)
var SwingPoint swingLow = SwingPoint.new(na, na, false, na)
var int trendDirection = 0
var bool fibsDrawn = false

atrVal = ta.atr(14)
volAvg = ta.sma(volume, 20)

// Animation variables
var float animationPhase = 0.0
var int lastAnimationBar = 0

// Harmonic ratios
var array<float> harmonicRatios = array.from(0.382, 0.500, 0.618, 0.786, 0.886, 1.000, 1.272, 1.618)

// ─────────────────────────────────────────────────────────────────────────────
// SWING DETECTION
// ─────────────────────────────────────────────────────────────────────────────
pivotHigh = ta.pivothigh(high, pivotStrength, pivotStrength)
pivotLow = ta.pivotlow(low, pivotStrength, pivotStrength)

highestHigh = ta.highest(high, fibLookback)
lowestLow = ta.lowest(low, fibLookback)

if not na(pivotHigh)
    if pivotHigh >= highestHigh or na(swingHigh.price)
        swingHigh.price := pivotHigh
        swingHigh.barIdx := bar_index - pivotStrength
        swingHigh.volume := volume[pivotStrength]

if not na(pivotLow)
    if pivotLow <= lowestLow or na(swingLow.price)
        swingLow.price := pivotLow
        swingLow.barIdx := bar_index - pivotStrength
        swingLow.volume := volume[pivotStrength]

if not na(swingHigh.price) and not na(swingLow.price)
    trendDirection := swingHigh.barIdx > swingLow.barIdx ? -1 : 1

// ─────────────────────────────────────────────────────────────────────────────
// ORDER BLOCK DETECTION
// ─────────────────────────────────────────────────────────────────────────────
detectOrderBlocks() =>
    if showOrderBlocks
        // Bullish Order Block (last down candle before swing high)
        if not na(pivotHigh) and not na(swingLow.price)
            if pivotHigh >= highestHigh
                obHigh = high[pivotStrength + 1]
                obLow = low[pivotStrength + 1]
                obVolume = volume[pivotStrength + 1]
                
                if obVolume > volAvg * 1.5
                    OrderBlock ob = OrderBlock.new()
                    ob.top := obHigh
                    ob.bottom := obLow
                    ob.barIdx := bar_index - pivotStrength - 1
                    ob.isBullish := true
                    ob.isSwept := false
                    ob.strength := obVolume / volAvg
                    
                    ob.obBox := box.new(ob.barIdx, ob.top, ob.barIdx + 20, ob.bottom,
                                       border_color=color.new(FIZ_LIQUIDITY, 50),
                                       bgcolor=color.new(FIZ_LIQUIDITY, 90),
                                       border_width=1)
                    
                    array.push(orderBlocks, ob)
        
        // Bearish Order Block (last up candle before swing low)
        if not na(pivotLow) and not na(swingHigh.price)
            if pivotLow <= lowestLow
                obHigh = high[pivotStrength + 1]
                obLow = low[pivotStrength + 1]
                obVolume = volume[pivotStrength + 1]
                
                if obVolume > volAvg * 1.5
                    OrderBlock ob = OrderBlock.new()
                    ob.top := obHigh
                    ob.bottom := obLow
                    ob.barIdx := bar_index - pivotStrength - 1
                    ob.isBullish := false
                    ob.isSwept := false
                    ob.strength := obVolume / volAvg
                    
                    ob.obBox := box.new(ob.barIdx, ob.top, ob.barIdx + 20, ob.bottom,
                                       border_color=color.new(FIZ_IMBALANCE, 50),
                                       bgcolor=color.new(FIZ_IMBALANCE, 90),
                                       border_width=1)
                    
                    array.push(orderBlocks, ob)

// Check order block sweeps
for ob in orderBlocks
    if not ob.isSwept
        if ob.isBullish and low < ob.bottom
            ob.isSwept := true
            if not na(ob.obBox)
                box.set_bgcolor(ob.obBox, color.new(FIZ_NEUTRAL, 90))
                box.set_border_style(ob.obBox, line.style_dotted)
        else if not ob.isBullish and high > ob.top
            ob.isSwept := true
            if not na(ob.obBox)
                box.set_bgcolor(ob.obBox, color.new(FIZ_NEUTRAL, 90))
                box.set_border_style(ob.obBox, line.style_dotted)

detectOrderBlocks()

// ─────────────────────────────────────────────────────────────────────────────
// FIBONACCI CALCULATIONS
// ─────────────────────────────────────────────────────────────────────────────
calcFibLevel(float swingH, float swingL, float ratio, int direction) =>
    float level = na
    if direction > 0
        level := swingL + (swingH - swingL) * ratio
    else
        level := swingH - (swingH - swingL) * ratio
    level

cleanupFibLevels() =>
    for fib in fibLevels
        if not na(fib.levelLine)
            line.delete(fib.levelLine)
        if not na(fib.levelLabel)
            label.delete(fib.levelLabel)
    array.clear(fibLevels)

drawFibLevel(float price, float ratio, color col, string labelText, int startBar) =>
    FibLevel fib = FibLevel.new()
    fib.price := price
    fib.ratio := ratio
    fib.levelColor := col
    fib.isActive := true
    fib.strength := 1.0
    fib.isHarmonic := array.includes(harmonicRatios, ratio)
    
    // Apply color scheme (use local variable since function args are immutable)
    color drawCol = col
    if colorScheme == "Professional"
        drawCol := #089981
    else if colorScheme == "Minimal"
        drawCol := color.gray
    
    // Glow effect for harmonic ratios
    if showGlowEffect and fib.isHarmonic
        fib.levelLine := line.new(startBar, price, bar_index + 20, price, 
                                 color=color.new(drawCol, 30), width=2, style=line.style_dashed)
    else
        fib.levelLine := line.new(startBar, price, bar_index + 20, price, 
                                 color=color.new(drawCol, 40), width=1, style=line.style_dashed)
    
    // Animated label
    if showAnimation
        animOffset = math.sin(animationPhase * math.pi / 180) * 5
        fib.levelLabel := label.new(bar_index + 22 + math.round(animOffset), price, labelText, 
                                   color=color.new(drawCol, 80), textcolor=drawCol, 
                                   style=label.style_label_left, size=size.tiny)
    else
        fib.levelLabel := label.new(bar_index + 22, price, labelText, 
                                   color=color.new(drawCol, 80), textcolor=drawCol, 
                                   style=label.style_label_left, size=size.tiny)
    
    array.push(fibLevels, fib)

updateFibonacci() =>
    if not na(swingHigh.price) and not na(swingLow.price)
        cleanupFibLevels()
        
        startBar = math.min(swingHigh.barIdx, swingLow.barIdx)
        
        // Standard Fibonacci levels
        if showFib236
            level = calcFibLevel(swingHigh.price, swingLow.price, 0.236, trendDirection)
            drawFibLevel(level, 0.236, FIZ_FIB_236, "0.236", startBar)
        
        if showFib382
            level = calcFibLevel(swingHigh.price, swingLow.price, 0.382, trendDirection)
            drawFibLevel(level, 0.382, FIZ_FIB_382, "0.382", startBar)
        
        if showFib500
            level = calcFibLevel(swingHigh.price, swingLow.price, 0.500, trendDirection)
            drawFibLevel(level, 0.500, FIZ_FIB_500, "0.500", startBar)
        
        if showFib618
            level = calcFibLevel(swingHigh.price, swingLow.price, 0.618, trendDirection)
            drawFibLevel(level, 0.618, FIZ_FIB_618, "0.618", startBar)
        
        if showFib786
            level = calcFibLevel(swingHigh.price, swingLow.price, 0.786, trendDirection)
            drawFibLevel(level, 0.786, FIZ_FIB_786, "0.786", startBar)
        
        // Harmonic ratios
        if showHarmonicRatios
            level127 = calcFibLevel(swingHigh.price, swingLow.price, 0.127, trendDirection)
            drawFibLevel(level127, 0.127, FIZ_FIB_127, "0.127", startBar)
            
            level414 = calcFibLevel(swingHigh.price, swingLow.price, 0.414, trendDirection)
            drawFibLevel(level414, 0.414, FIZ_FIB_414, "0.414", startBar)
            
            level707 = calcFibLevel(swingHigh.price, swingLow.price, 0.707, trendDirection)
            drawFibLevel(level707, 0.707, FIZ_FIB_707, "0.707", startBar)
            
            level886 = calcFibLevel(swingHigh.price, swingLow.price, 0.886, trendDirection)
            drawFibLevel(level886, 0.886, FIZ_FIB_886, "0.886", startBar)
        
        // Extensions
        if showExtensions
            level1618 = calcFibLevel(swingHigh.price, swingLow.price, 1.618, trendDirection)
            drawFibLevel(level1618, 1.618, FIB_EXTENSION, "1.618", startBar)
            
            level272 = calcFibLevel(swingHigh.price, swingLow.price, 2.272, trendDirection)
            drawFibLevel(level272, 2.272, FIB_EXTENSION, "2.272", startBar)
        
        // Institutional levels
        if showInstitutionalLevels
            instThreshold = atrVal * institutionalThreshold
            
            // Volume-based institutional levels
            if swingHigh.volume > volAvg * 2
                instLevel = swingHigh.price - instThreshold
                drawFibLevel(instLevel, 0.0, FIZ_INSTITUTIONAL, "INST-H", swingHigh.barIdx)
            
            if swingLow.volume > volAvg * 2
                instLevel = swingLow.price + instThreshold
                drawFibLevel(instLevel, 0.0, FIZ_INSTITUTIONAL, "INST-L", swingLow.barIdx)

if barstate.islast
    updateFibonacci()
    
    // Update animation
    if showAnimation
        if bar_index != lastAnimationBar
            animationPhase := (animationPhase + 5) % 360
            lastAnimationBar := bar_index

// ─────────────────────────────────────────────────────────────────────────────
// FVG DETECTION
// ─────────────────────────────────────────────────────────────────────────────
detectFVG() =>
    bool bullFVG = false
    bool bearFVG = false
    float fvgTop = na
    float fvgBottom = na
    
    bullGap = low > high[2]
    bearGap = high < low[2]
    
    bullGapSize = bullGap ? (low - high[2]) : 0
    bearGapSize = bearGap ? (low[2] - high) : 0
    
    minSize = atrVal * minFVGSize
    
    if bullGap and bullGapSize >= minSize
        bullFVG := true
        fvgTop := low
        fvgBottom := high[2]
    
    if bearGap and bearGapSize >= minSize
        bearFVG := true
        fvgTop := low[2]
        fvgBottom := high
    
    [bullFVG, bearFVG, fvgTop, fvgBottom]

cleanupFVG() =>
    if array.size(fvgZones) > 0
        for i = array.size(fvgZones) - 1 to 0
            FVGZone fvg = array.get(fvgZones, i)
            if bar_index - fvg.barIdx > fvgMaxBars
                if not na(fvg.zoneBox)
                    box.delete(fvg.zoneBox)
                array.remove(fvgZones, i)
    
    while array.size(fvgZones) > maxElements
        FVGZone old = array.shift(fvgZones)
        if not na(old.zoneBox)
            box.delete(old.zoneBox)

if showFVG
    [bullFVG, bearFVG, fvgTop, fvgBottom] = detectFVG()
    
    if bullFVG and not na(fvgTop) and not na(fvgBottom)
        FVGZone fvg = FVGZone.new()
        fvg.top := fvgTop
        fvg.bottom := fvgBottom
        fvg.mid := (fvgTop + fvgBottom) / 2
        fvg.barIdx := bar_index - 1
        fvg.isBullish := true
        fvg.isMitigated := false
        fvg.volume := volume[1]
        
        // Premium/Discount analysis
        color fvgColor = FIZ_FVG_BULL
        if showPremiumDiscount
            fairValue = (high[1] + low[1]) / 2
            fvg.isPremium := fvg.mid > fairValue
            fvg.isDiscount := fvg.mid < fairValue
            fvgColor := fvg.isPremium ? FIZ_FVG_PREMIUM : fvg.isDiscount ? FIZ_FVG_DISCOUNT : FIZ_FVG_BULL
        
        // Apply glow effect for large FVGs
        fvgSize = fvg.top - fvg.bottom
        if showGlowEffect and fvgSize > atrVal * minFVGSize * 2
            fvg.zoneBox := box.new(bar_index - 2, fvgTop, bar_index + 20, fvgBottom,
                                  border_color=color.new(fvgColor, 30),
                                  bgcolor=color.new(fvgColor, 80),
                                  border_width=2)
        else
            fvg.zoneBox := box.new(bar_index - 2, fvgTop, bar_index + 20, fvgBottom,
                                  border_color=color.new(fvgColor, 50),
                                  bgcolor=color.new(fvgColor, 85),
                                  border_width=1)
        
        array.push(fvgZones, fvg)
    
    if bearFVG and not na(fvgTop) and not na(fvgBottom)
        FVGZone fvg = FVGZone.new()
        fvg.top := fvgTop
        fvg.bottom := fvgBottom
        fvg.mid := (fvgTop + fvgBottom) / 2
        fvg.barIdx := bar_index - 1
        fvg.isBullish := false
        fvg.isMitigated := false
        fvg.volume := volume[1]
        
        // Premium/Discount analysis
        color fvgColor = FIZ_FVG_BEAR
        if showPremiumDiscount
            fairValue = (high[1] + low[1]) / 2
            fvg.isPremium := fvg.mid > fairValue
            fvg.isDiscount := fvg.mid < fairValue
            fvgColor := fvg.isPremium ? FIZ_FVG_PREMIUM : fvg.isDiscount ? FIZ_FVG_DISCOUNT : FIZ_FVG_BEAR
        
        // Apply glow effect for large FVGs
        fvgSize = fvg.top - fvg.bottom
        if showGlowEffect and fvgSize > atrVal * minFVGSize * 2
            fvg.zoneBox := box.new(bar_index - 2, fvgTop, bar_index + 20, fvgBottom,
                                  border_color=color.new(fvgColor, 30),
                                  bgcolor=color.new(fvgColor, 80),
                                  border_width=2)
        else
            fvg.zoneBox := box.new(bar_index - 2, fvgTop, bar_index + 20, fvgBottom,
                                  border_color=color.new(fvgColor, 50),
                                  bgcolor=color.new(fvgColor, 85),
                                  border_width=1)
        
        array.push(fvgZones, fvg)
    
    cleanupFVG()

// ─────────────────────────────────────────────────────────────────────────────
// FVG MITIGATION TRACKING
// ─────────────────────────────────────────────────────────────────────────────
if trackMitigation and array.size(fvgZones) > 0
    for fvg in fvgZones
        if not fvg.isMitigated
            if fvg.isBullish and low <= fvg.mid
                fvg.isMitigated := true
                fvg.mitigationBar := bar_index
                if not na(fvg.zoneBox)
                    // Color based on premium/discount status
                    if fvg.isPremium
                        box.set_bgcolor(fvg.zoneBox, color.new(FIZ_FVG_PREMIUM, 92))
                    else if fvg.isDiscount
                        box.set_bgcolor(fvg.zoneBox, color.new(FIZ_FVG_DISCOUNT, 92))
                    else
                        box.set_bgcolor(fvg.zoneBox, color.new(FIZ_FVG_BULL, 92))
                    box.set_border_style(fvg.zoneBox, line.style_dotted)
            else if not fvg.isBullish and high >= fvg.mid
                fvg.isMitigated := true
                fvg.mitigationBar := bar_index
                if not na(fvg.zoneBox)
                    // Color based on premium/discount status
                    if fvg.isPremium
                        box.set_bgcolor(fvg.zoneBox, color.new(FIZ_FVG_PREMIUM, 92))
                    else if fvg.isDiscount
                        box.set_bgcolor(fvg.zoneBox, color.new(FIZ_FVG_DISCOUNT, 92))
                    else
                        box.set_bgcolor(fvg.zoneBox, color.new(FIZ_FVG_BEAR, 92))
                    box.set_border_style(fvg.zoneBox, line.style_dotted)

// ─────────────────────────────────────────────────────────────────────────────
// CONFLUENCE DETECTION
// ─────────────────────────────────────────────────────────────────────────────
var bool confluenceSignalBull = false
var bool confluenceSignalBear = false

detectConfluence() =>
    bool bullConf = false
    bool bearConf = false
    float confPrice = na
    float confFibRatio = na
    int confStrength = 0
    array<string> confTypes = array.new<string>()
    
    tolerance = atrVal * confluenceTol
    
    for fib in fibLevels
        if fib.isActive
            for fvg in fvgZones
                if not fvg.isMitigated
                    if math.abs(fib.price - fvg.mid) < tolerance
                        confStrength += 1
                        
                        // Add confluence types
                        if fib.isHarmonic
                            array.push(confTypes, "Harmonic")
                        if fib.ratio == 0.618 or fib.ratio == 0.382
                            array.push(confTypes, "Golden")
                        if fvg.isPremium
                            array.push(confTypes, "Premium")
                        if fvg.isDiscount
                            array.push(confTypes, "Discount")
                        if fvg.volume > volAvg * 2
                            array.push(confTypes, "Volume")
                        
                        if fvg.isBullish and trendDirection > 0
                            bullConf := true
                            confPrice := (fib.price + fvg.mid) / 2
                            confFibRatio := fib.ratio
                        else if not fvg.isBullish and trendDirection < 0
                            bearConf := true
                            confPrice := (fib.price + fvg.mid) / 2
                            confFibRatio := fib.ratio
    
    // Check order block confluence
    if showSmartMoneyConcepts
        for ob in orderBlocks
            if not ob.isSwept
                for fib in fibLevels
                    if fib.isActive
                        if math.abs(ob.bottom - fib.price) < tolerance or math.abs(ob.top - fib.price) < tolerance
                            confStrength += 1
                            array.push(confTypes, "OrderBlock")
    
    [bullConf, bearConf, confPrice, confFibRatio, confStrength, confTypes]

if showConfluence
    [bullConf, bearConf, confPrice, confFibRatio, confStrength, confTypes] = detectConfluence()
    
    // Only signal if minimum strength is met
    confluenceSignalBull := bullConf and confStrength >= minConfluenceStrength
    confluenceSignalBear := bearConf and confStrength >= minConfluenceStrength
    
    // Create confluence point visualization
    if showConfluenceStrength and (bullConf or bearConf)
        ConfluencePoint cp = ConfluencePoint.new()
        cp.price := confPrice
        cp.fibRatio := confFibRatio
        cp.hasFVG := true
        cp.isBullish := bullConf
        cp.strength := confStrength
        cp.confluenceTypes := confTypes
        cp.confidence := math.min(100, confStrength * 20)
        
        // Draw confluence visualization
        confColor = confStrength >= 4 ? FIZ_CONFLUENCE_STRONG : FIZ_CONFLUENCE
        cp.confluenceBox := box.new(bar_index - 10, confPrice + atrVal * 0.2, bar_index, confPrice - atrVal * 0.2,
                                   border_color=color.new(confColor, 40),
                                   bgcolor=color.new(confColor, 85),
                                   border_width=2)
        
        // Add confluence label
        labelText = array.join(confTypes, "+")
        cp.confluenceLabel := label.new(bar_index + 2, confPrice, labelText, 
                                      color=color.new(confColor, 20), textcolor=confColor,
                                      style=label.style_label_left, size=size.tiny)
        
        array.push(confluencePoints, cp)

// ─────────────────────────────────────────────────────────────────────────────
// ENTRY SIGNAL DETECTION
// ─────────────────────────────────────────────────────────────────────────────
var bool entryBull = false
var bool entryBear = false

if showEntrySignals
    bullEntry = false
    bearEntry = false
    
    for fvg in fvgZones
        if not fvg.isMitigated
            inFVG = low <= fvg.top and high >= fvg.bottom
            
            if fvg.isBullish and inFVG and close > open
                for fib in fibLevels
                    if fib.isActive and fib.ratio >= 0.5 and fib.ratio <= 0.786
                        if math.abs(low - fib.price) < atrVal * 0.5
                            bullEntry := true
                            break
            
            if not fvg.isBullish and inFVG and close < open
                for fib in fibLevels
                    if fib.isActive and fib.ratio >= 0.5 and fib.ratio <= 0.786
                        if math.abs(high - fib.price) < atrVal * 0.5
                            bearEntry := true
                            break
    
    entryBull := bullEntry
    entryBear := bearEntry

// ─────────────────────────────────────────────────────────────────────────────
// STRUCTURE VISUALIZATION
// ─────────────────────────────────────────────────────────────────────────────
if showStructure and not na(swingHigh.price) and not na(swingLow.price)
    var line structureLine = na
    if not na(structureLine)
        line.delete(structureLine)
    
    structureCol = trendDirection > 0 ? FIZ_STRUCTURE_BULL : FIZ_STRUCTURE_BEAR
    structureLine := line.new(swingLow.barIdx, swingLow.price, swingHigh.barIdx, swingHigh.price,
                             color=color.new(structureCol, 50), width=2, style=line.style_solid)

// ─────────────────────────────────────────────────────────────────────────────
// PLOTTING - ENTRY SIGNALS
// ─────────────────────────────────────────────────────────────────────────────
plotshape(showEntrySignals and entryBull, "Bull Entry", shape.circle, location.belowbar, 
         FIZ_ENTRY_BULL, size=size.small)
plotshape(showEntrySignals and entryBear, "Bear Entry", shape.circle, location.abovebar, 
         FIZ_ENTRY_BEAR, size=size.small)

plotshape(showConfluence and confluenceSignalBull, "Bull Confluence", shape.diamond, location.belowbar, 
         FIZ_CONFLUENCE, size=size.tiny)
plotshape(showConfluence and confluenceSignalBear, "Bear Confluence", shape.diamond, location.abovebar, 
         FIZ_CONFLUENCE, size=size.tiny)

// ─────────────────────────────────────────────────────────────────────────────
// BACKGROUND COLORING
// ─────────────────────────────────────────────────────────────────────────────
trendBgColor = trendDirection > 0 ? color.new(FIZ_STRUCTURE_BULL, 96) : trendDirection < 0 ? color.new(FIZ_STRUCTURE_BEAR, 96) : na
bgcolor(trendBgColor)

// ─────────────────────────────────────────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────────────────────────────────────────
if showDashboard
    var table dashboard = table.new(position.top_right, 3, 12, 
                                   bgcolor=color.new(FIZ_BACKGROUND, 5), 
                                   border_color=color.new(FIZ_NEUTRAL, 50),
                                   border_width=1)
    
    if barstate.islast
        // Header with gradient
        headerBg = colorScheme == "Quantum" ? color.new(FIZ_GOLDEN_RATIO, 90) : color.new(#1a1a2e, 10)
        table.cell(dashboard, 0, 0, "FIZ [JOAT]", text_color=FIZ_GOLDEN_RATIO, text_size=size.small, bgcolor=headerBg)
        table.cell(dashboard, 1, 0, "Metrics", text_color=FIZ_NEUTRAL, text_size=size.small, bgcolor=headerBg)
        table.cell(dashboard, 2, 0, "Status", text_color=FIZ_NEUTRAL, text_size=size.small, bgcolor=headerBg)
        
        // Trend information
        trendText = trendDirection > 0 ? "BULLISH" : trendDirection < 0 ? "BEARISH" : "NEUTRAL"
        trendCol = trendDirection > 0 ? FIZ_STRUCTURE_BULL : trendDirection < 0 ? FIZ_STRUCTURE_BEAR : FIZ_NEUTRAL
        table.cell(dashboard, 0, 1, "Trend", text_color=FIZ_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 1, trendText, text_color=trendCol, text_size=size.small)
        table.cell(dashboard, 2, 1, trendDirection > 0 ? "▲" : trendDirection < 0 ? "▼" : "→", text_color=trendCol, text_size=size.small)
        
        // Swing points with volume
        table.cell(dashboard, 0, 2, "Swing High", text_color=FIZ_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 2, not na(swingHigh.price) ? str.tostring(swingHigh.price, "#.##") : "-", 
                  text_color=FIZ_STRUCTURE_BEAR, text_size=size.small)
        table.cell(dashboard, 2, 2, not na(swingHigh.volume) ? str.tostring(swingHigh.volume / volAvg, "#.#") + "x" : "-", 
                  text_color=FIZ_WARNING, text_size=size.small)
        
        table.cell(dashboard, 0, 3, "Swing Low", text_color=FIZ_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 3, not na(swingLow.price) ? str.tostring(swingLow.price, "#.##") : "-", 
                  text_color=FIZ_STRUCTURE_BULL, text_size=size.small)
        table.cell(dashboard, 2, 3, not na(swingLow.volume) ? str.tostring(swingLow.volume / volAvg, "#.#") + "x" : "-", 
                  text_color=FIZ_WARNING, text_size=size.small)
        
        // Fibonacci range
        fibRange = not na(swingHigh.price) and not na(swingLow.price) ? str.tostring((swingHigh.price - swingLow.price) / atrVal, "#.#") + " ATR" : "-"
        table.cell(dashboard, 0, 4, "Fib Range", text_color=FIZ_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 4, fibRange, text_color=FIZ_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 2, 4, array.size(fibLevels) > 0 ? str.tostring(array.size(fibLevels)) : "0", 
                  text_color=FIZ_NEUTRAL, text_size=size.small)
        
        // FVG statistics with premium/discount
        activeFVG = 0
        premiumFVG = 0
        discountFVG = 0
        for fvg in fvgZones
            if not fvg.isMitigated
                activeFVG += 1
                if fvg.isPremium
                    premiumFVG += 1
                if fvg.isDiscount
                    discountFVG += 1
        
        table.cell(dashboard, 0, 5, "Active FVG", text_color=FIZ_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 5, str.tostring(activeFVG), text_color=FIZ_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 2, 5, activeFVG > 0 ? "⚠" : "✓", text_color=activeFVG > 0 ? FIZ_WARNING : FIZ_HARMONIC, text_size=size.small)
        
        table.cell(dashboard, 0, 6, "Premium FVG", text_color=FIZ_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 6, str.tostring(premiumFVG), text_color=FIZ_FVG_PREMIUM, text_size=size.small)
        table.cell(dashboard, 2, 6, premiumFVG > 0 ? "▲" : "-", text_color=FIZ_FVG_PREMIUM, text_size=size.small)
        
        table.cell(dashboard, 0, 7, "Discount FVG", text_color=FIZ_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 7, str.tostring(discountFVG), text_color=FIZ_FVG_DISCOUNT, text_size=size.small)
        table.cell(dashboard, 2, 7, discountFVG > 0 ? "▼" : "-", text_color=FIZ_FVG_DISCOUNT, text_size=size.small)
        
        // Order blocks
        activeOB = 0
        for ob in orderBlocks
            if not ob.isSwept
                activeOB += 1
        
        table.cell(dashboard, 0, 8, "Order Blocks", text_color=FIZ_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 8, str.tostring(activeOB), text_color=FIZ_SMART_MONEY, text_size=size.small)
        table.cell(dashboard, 2, 8, activeOB > 0 ? "OB" : "-", text_color=FIZ_SMART_MONEY, text_size=size.small)
        
        // Confluence information
        confText = confluenceSignalBull ? "BULL" : confluenceSignalBear ? "BEAR" : "NONE"
        confCol = confluenceSignalBull ? FIZ_ENTRY_BULL : confluenceSignalBear ? FIZ_ENTRY_BEAR : FIZ_NEUTRAL
        confStrength = array.size(confluencePoints) > 0 ? array.get(confluencePoints, array.size(confluencePoints) - 1).strength : 0
        
        table.cell(dashboard, 0, 9, "Confluence", text_color=FIZ_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 9, confText, text_color=confCol, text_size=size.small)
        table.cell(dashboard, 2, 9, confStrength > 0 ? str.tostring(confStrength) : "-", text_color=confCol, text_size=size.small)
        
        // Volume analysis
        volRatio = volume / volAvg
        volText = str.tostring(volRatio, "#.##") + "x"
        volCol = volRatio > 2.0 ? FIZ_WARNING : volRatio > 1.0 ? FIZ_NEUTRAL : FIZ_WARNING
        
        table.cell(dashboard, 0, 10, "Volume", text_color=FIZ_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 10, volText, text_color=volCol, text_size=size.small)
        table.cell(dashboard, 2, 10, volRatio > 1.5 ? "HIGH" : "NORMAL", text_color=volCol, text_size=size.small)
        
        // Institutional activity
        instCount = array.size(institutionalLevels)
        table.cell(dashboard, 0, 11, "Institutional", text_color=FIZ_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 11, str.tostring(instCount), text_color=FIZ_INSTITUTIONAL, text_size=size.small)
        table.cell(dashboard, 2, 11, instCount > 0 ? "INST" : "-", text_color=FIZ_INSTITUTIONAL, text_size=size.small)

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────
// Entry signals
alertcondition(entryBull, "Bullish Entry Signal", "Bullish entry at Fibonacci-FVG confluence")
alertcondition(entryBear, "Bearish Entry Signal", "Bearish entry at Fibonacci-FVG confluence")

// Confluence alerts
alertcondition(confluenceSignalBull, "Bullish Confluence", "Bullish Fibonacci-FVG confluence detected")
alertcondition(confluenceSignalBear, "Bearish Confluence", "Bearish Fibonacci-FVG confluence detected")

// Swing point alerts
alertcondition(not na(pivotHigh), "New Swing High", "New swing high detected")
alertcondition(not na(pivotLow), "New Swing Low", "New swing low detected")

// FVG alerts
newBullFVG = false
newBearFVG = false
if showFVG
    [bullFVG, bearFVG, _, _] = detectFVG()
    newBullFVG := bullFVG
    newBearFVG := bearFVG

alertcondition(newBullFVG, "New Bullish FVG", "New bullish fair value gap formed")
alertcondition(newBearFVG, "New Bearish FVG", "New bearish fair value gap formed")

// Premium/Discount alerts
premiumAlert = false
discountAlert = false
for fvg in fvgZones
    if not fvg.isMitigated and fvg.barIdx == bar_index - 1
        if fvg.isPremium
            premiumAlert := true
        if fvg.isDiscount
            discountAlert := true

alertcondition(premiumAlert, "Premium FVG", "Premium fair value gap detected")
alertcondition(discountAlert, "Discount FVG", "Discount fair value gap detected")

// Harmonic ratio alerts
harmonicAlert = false
for fib in fibLevels
    if fib.isActive and fib.isHarmonic
        harmonicAlert := true
        break

alertcondition(harmonicAlert, "Harmonic Level", "Price at harmonic Fibonacci level")

// Order block alerts
orderBlockAlert = false
for ob in orderBlocks
    if ob.barIdx == bar_index - 1
        orderBlockAlert := true
        break

alertcondition(orderBlockAlert, "New Order Block", "New order block detected")

// Institutional level alerts
institutionalAlert = false
for inst in institutionalLevels
    if inst.isActive
        institutionalAlert := true
        break

alertcondition(institutionalAlert, "Institutional Level", "Price at institutional level")

// Volume spike alerts
volumeSpike = volume > volAvg * 2.0
alertcondition(volumeSpike, "Volume Spike", "Volume exceeding 2x average at Fibonacci level")

// Trend change alerts
trendChanged = trendDirection != trendDirection[1] and trendDirection[1] != 0
alertcondition(trendChanged, "Trend Change", "Fibonacci trend direction changed")

// Golden ratio alerts
goldenRatioAlert = false
for fib in fibLevels
    if fib.isActive and (fib.ratio == 0.618 or fib.ratio == 0.382)
        if math.abs(close - fib.price) < atrVal * 0.2
            goldenRatioAlert := true
            break

alertcondition(goldenRatioAlert, "Golden Ratio", "Price at golden ratio Fibonacci level")
