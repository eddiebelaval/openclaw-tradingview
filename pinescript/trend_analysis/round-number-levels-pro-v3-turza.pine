//@version=5
indicator("Round Number Levels Pro v3", overlay=true, max_labels_count=101, max_lines_count=500)

// ===== ROUNDING MODE =====
useAutoRounding = input.bool(defval=true, title="Use Auto-Rounding by Symbol", group="━━━━━ ROUNDING MODE ━━━━━", tooltip="When enabled, automatically applies rounding based on symbol presets below. When disabled, uses Default Rounding for all symbols.")
defaultValue = input.float(defval=10, title="Default Rounding Value", group="━━━━━ ROUNDING MODE ━━━━━", tooltip="Used when Auto-Rounding is OFF, or when symbol doesn't match any preset")

// ===== ROUNDING PRESETS =====
preset1Value = input.float(defval=0.001, title="Value", inline="p1", group="━━━━━ AUTO-ROUNDING PRESETS ━━━━━")
preset1Symbols = input.string(defval="EURUSD,GBPUSD,USDCAD,USDCHF", title="→ Symbols", inline="p1", group="━━━━━ AUTO-ROUNDING PRESETS ━━━━━")

preset2Value = input.float(defval=0.001, title="Value", inline="p2", group="━━━━━ AUTO-ROUNDING PRESETS ━━━━━")
preset2Symbols = input.string(defval="AUDUSD,NZDUSD", title="→ Symbols", inline="p2", group="━━━━━ AUTO-ROUNDING PRESETS ━━━━━")

preset3Value = input.float(defval=0.01, title="Value", inline="p3", group="━━━━━ AUTO-ROUNDING PRESETS ━━━━━")
preset3Symbols = input.string(defval="USDJPY,EURJPY,GBPJPY,AUDJPY", title="→ Symbols", inline="p3", group="━━━━━ AUTO-ROUNDING PRESETS ━━━━━")

preset4Value = input.float(defval=50, title="Value", inline="p4", group="━━━━━ AUTO-ROUNDING PRESETS ━━━━━")
preset4Symbols = input.string(defval="SPX,SPY,QQQ,DIA,NQ,ES,NAS100", title="→ Symbols", inline="p4", group="━━━━━ AUTO-ROUNDING PRESETS ━━━━━")

preset5Value = input.float(defval=1000, title="Value", inline="p5", group="━━━━━ AUTO-ROUNDING PRESETS ━━━━━")
preset5Symbols = input.string(defval="BTC,BTCUSD,ETH,ETHUSD", title="→ Symbols", inline="p5", group="━━━━━ AUTO-ROUNDING PRESETS ━━━━━")

preset6Value = input.float(defval=10, title="Value", inline="p6", group="━━━━━ AUTO-ROUNDING PRESETS ━━━━━")
preset6Symbols = input.string(defval="XAUUSD,GOLD", title="→ Symbols", inline="p6", group="━━━━━ AUTO-ROUNDING PRESETS ━━━━━")

preset7Value = input.float(defval=100, title="Value", inline="p7", group="━━━━━ AUTO-ROUNDING PRESETS ━━━━━")
preset7Symbols = input.string(defval="XAGUSD,SILVER", title="→ Symbols", inline="p7", group="━━━━━ AUTO-ROUNDING PRESETS ━━━━━")

preset8Value = input.float(defval=1, title="Value", inline="p8", group="━━━━━ AUTO-ROUNDING PRESETS ━━━━━")
preset8Symbols = input.string(defval="USOIL,CRUDE,WTI,BRENT", title="→ Symbols", inline="p8", group="━━━━━ AUTO-ROUNDING PRESETS ━━━━━")

// ===== GENERAL SETTINGS (INPUTS TAB) =====
lQty = input.int(defval=5, minval=1, maxval=50, title="Number of Main Lines", group="━━━━━ GENERAL SETTINGS ━━━━━")
showMidLines = input.bool(defval=true, title="Show Mid-Level Lines", group="━━━━━ GENERAL SETTINGS ━━━━━")
midQty = input.int(defval=10, minval=1, maxval=50, title="Number of Mid Lines", group="━━━━━ GENERAL SETTINGS ━━━━━")
ext = input.string(defval="Both", options=["To Right", "Both"], title="Extend Lines", group="━━━━━ GENERAL SETTINGS ━━━━━")
offset = input.int(defval=50, minval=0, maxval=490, step=10, title="Label Offset (bars)", group="━━━━━ GENERAL SETTINGS ━━━━━")

// ===== MAIN LINES STYLE =====
mainLineColor = input.color(defval=color.black, title="Color", inline="main1", group="MAIN LINES")
mainLineWidth = input.int(defval=2, minval=1, maxval=4, title="Width", inline="main1", group="MAIN LINES")
mainLineStyle = input.string(defval="Solid", title="Style", options=["Solid", "Dashed", "Dotted"], inline="main2", group="MAIN LINES")
mainLabelSize = input.string(defval="Normal", title="Label Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], inline="main2", group="MAIN LINES")

// ===== MID LINES STYLE =====
midLineColor = input.color(defval=color.gray, title="Color", inline="mid1", group="MID LINES")
midLineWidth = input.int(defval=1, minval=1, maxval=4, title="Width", inline="mid1", group="MID LINES")
midLineStyle = input.string(defval="Dashed", title="Style", options=["Solid", "Dashed", "Dotted"], inline="mid2", group="MID LINES")
midLabelSize = input.string(defval="Small", title="Label Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], inline="mid2", group="MID LINES")

// ===== FUNCTIONS =====

// Check if symbol matches any in the comma-separated list
symbolMatches(symbolList) =>
    if symbolList == ""
        false
    else
        currentSymbol = syminfo.ticker
        symbols = str.split(symbolList, ",")
        matched = false
        for i = 0 to array.size(symbols) - 1
            symbol = str.trim(array.get(symbols, i))
            if symbol != "" and str.contains(currentSymbol, symbol)
                matched := true
                break
        matched

// Get the appropriate rounding value for current symbol
getIncrementValue() =>
    if not useAutoRounding
        defaultValue
    else if symbolMatches(preset1Symbols)
        preset1Value
    else if symbolMatches(preset2Symbols)
        preset2Value
    else if symbolMatches(preset3Symbols)
        preset3Value
    else if symbolMatches(preset4Symbols)
        preset4Value
    else if symbolMatches(preset5Symbols)
        preset5Value
    else if symbolMatches(preset6Symbols)
        preset6Value
    else if symbolMatches(preset7Symbols)
        preset7Value
    else if symbolMatches(preset8Symbols)
        preset8Value
    else
        defaultValue

// Convert line style
getLineStyle(style) =>
    style == "Dashed" ? line.style_dashed : (style == "Dotted" ? line.style_dotted : line.style_solid)

// Convert font size
getFontSize(size) =>
    size == "Tiny" ? size.tiny : (size == "Small" ? size.small : (size == "Normal" ? size.normal : (size == "Large" ? size.large : size.huge)))

// Round to nearest increment
RoundValue(value, increment) =>
    math.round(value / increment) * increment

// ===== MAIN LOGIC =====

incrementVal = getIncrementValue()
midIncrementVal = incrementVal / 2

selectedMainLineStyle = getLineStyle(mainLineStyle)
selectedMidLineStyle = getLineStyle(midLineStyle)
selectedMainLabelSize = getFontSize(mainLabelSize)
selectedMidLabelSize = getFontSize(midLabelSize)

var lines = array.new_line(0)
var labels = array.new_label(0)

baseVal = RoundValue(close, incrementVal)

if (barstate.isconfirmed and baseVal != baseVal[1])
    if array.size(lines) > 0
        for i = 0 to array.size(lines) - 1
            line.delete(array.get(lines, i))
            label.delete(array.get(labels, i))
    
    array.clear(lines)
    array.clear(labels)
    
    // Draw main lines
    for j = 0 to lQty - 1
        levelAbove = baseVal + j * incrementVal
        levelBelow = baseVal - j * incrementVal
        
        newLineAbove = line.new(bar_index, levelAbove, bar_index + 1, levelAbove, extend=(ext == "Both" ? extend.both : extend.right), color=mainLineColor, style=selectedMainLineStyle, width=mainLineWidth)
        newLabelAbove = label.new(bar_index + 1 + offset, levelAbove, text=str.tostring(levelAbove), style=label.style_none, textcolor=mainLineColor, textalign=text.align_right, size=selectedMainLabelSize)
        array.push(lines, newLineAbove)
        array.push(labels, newLabelAbove)
        
        if j > 0
            newLineBelow = line.new(bar_index, levelBelow, bar_index + 1, levelBelow, extend=(ext == "Both" ? extend.both : extend.right), color=mainLineColor, style=selectedMainLineStyle, width=mainLineWidth)
            newLabelBelow = label.new(bar_index + 1 + offset, levelBelow, text=str.tostring(levelBelow), style=label.style_none, textcolor=mainLineColor, textalign=text.align_right, size=selectedMainLabelSize)
            array.push(lines, newLineBelow)
            array.push(labels, newLabelBelow)
    
    // Draw mid lines
    if showMidLines
        for j = 1 to midQty - 1
            levelAboveMid = baseVal + j * midIncrementVal
            levelBelowMid = baseVal - j * midIncrementVal
            
            if (levelAboveMid % incrementVal != 0)
                newLineAboveMid = line.new(bar_index, levelAboveMid, bar_index + 1, levelAboveMid, extend=(ext == "Both" ? extend.both : extend.right), color=midLineColor, style=selectedMidLineStyle, width=midLineWidth)
                newLabelAboveMid = label.new(bar_index + 1 + offset, levelAboveMid, text=str.tostring(levelAboveMid), style=label.style_none, textcolor=midLineColor, textalign=text.align_right, size=selectedMidLabelSize)
                array.push(lines, newLineAboveMid)
                array.push(labels, newLabelAboveMid)
            
            if (levelBelowMid % incrementVal != 0)
                newLineBelowMid = line.new(bar_index, levelBelowMid, bar_index + 1, levelBelowMid, extend=(ext == "Both" ? extend.both : extend.right), color=midLineColor, style=selectedMidLineStyle, width=midLineWidth)
                newLabelBelowMid = label.new(bar_index + 1 + offset, levelBelowMid, text=str.tostring(levelBelowMid), style=label.style_none, textcolor=midLineColor, textalign=text.align_right, size=selectedMidLabelSize)
                array.push(lines, newLineBelowMid)
                array.push(labels, newLabelBelowMid)

else if (barstate.isconfirmed and baseVal == baseVal[1])
    if array.size(labels) > 0
        for i = 0 to array.size(labels) - 1
            label.set_x(array.get(labels, i), bar_index + 1 + offset)
