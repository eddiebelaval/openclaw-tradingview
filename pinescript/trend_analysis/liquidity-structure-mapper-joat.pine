//@version=6
indicator("Liquidity Structure Mapper [JOAT]", shorttitle="LSM [JOAT]", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500, max_bars_back=500)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LIQUIDITY STRUCTURE MAPPER
// Quantitative Trading Systems - Market Structure & Liquidity Zone Detection
// Purpose: Identify swing structure, equal highs/lows, and institutional liquidity pools
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

//───────────────────────────────────────────────────────────────────────────────
// CONFIGURATION
//───────────────────────────────────────────────────────────────────────────────

g_swing = "═══════════ Swing Detection ═══════════"
int     i_swing_left    = input.int(10, "Left Bars", minval=3, maxval=50, group=g_swing)
int     i_swing_right   = input.int(5, "Right Bars", minval=2, maxval=30, group=g_swing)
bool    i_show_swings   = input.bool(true, "Show Swing Points", group=g_swing)
int     i_max_swings    = input.int(20, "Max Swing Levels", minval=5, maxval=50, group=g_swing)

g_eqhl = "═══════════ Equal Highs/Lows ═══════════"
float   i_eq_threshold  = input.float(0.1, "Equal Level Threshold %", minval=0.01, maxval=1.0, step=0.01, group=g_eqhl)
bool    i_show_eqh      = input.bool(true, "Show Equal Highs", group=g_eqhl)
bool    i_show_eql      = input.bool(true, "Show Equal Lows", group=g_eqhl)
int     i_eq_extend     = input.int(50, "Zone Extension Bars", minval=10, maxval=200, group=g_eqhl)

g_zones = "═══════════ Liquidity Zones ═══════════"
bool    i_show_zones    = input.bool(true, "Show Liquidity Zones", group=g_zones)
int     i_zone_lookback = input.int(100, "Zone Lookback", minval=20, maxval=500, group=g_zones)

g_strength = "═══════════ Zone Strength ═══════════"
int     i_min_touches   = input.int(2, "Minimum Zone Touches", minval=1, maxval=5, group=g_strength)
float   i_atr_buffer    = input.float(0.15, "ATR Buffer Multiplier", minval=0.05, maxval=0.5, step=0.05, group=g_strength)
bool    i_show_strength = input.bool(true, "Show Zone Strength Labels", group=g_strength)

g_visual = "═══════════ Visual Settings ═══════════"
color   i_swing_h_col   = input.color(color.new(#ff6b6b, 0), "Swing High Color", group=g_visual)
color   i_swing_h_glow  = input.color(color.new(#ffa8a8, 0), "Swing High Glow", group=g_visual)
color   i_swing_l_col   = input.color(color.new(#51cf66, 0), "Swing Low Color", group=g_visual)
color   i_swing_l_glow  = input.color(color.new(#8ce99a, 0), "Swing Low Glow", group=g_visual)
color   i_eqh_col       = input.color(color.new(#f06595, 0), "Equal High Zone", group=g_visual)
color   i_eqh_core      = input.color(color.new(#e64980, 0), "EQH Core", group=g_visual)
color   i_eql_col       = input.color(color.new(#20c997, 0), "Equal Low Zone", group=g_visual)
color   i_eql_core      = input.color(color.new(#12b886, 0), "EQL Core", group=g_visual)
color   i_liq_col       = input.color(color.new(#845ef7, 0), "Liquidity Pool", group=g_visual)
color   i_swept_col     = input.color(color.new(#495057, 0), "Swept Zone", group=g_visual)
color   i_res_prox_col  = input.color(color.new(#ff9f43, 0), "Resistance Proximity", group=g_visual)
color   i_sup_prox_col  = input.color(color.new(#00d2d3, 0), "Support Proximity", group=g_visual)
color   i_text_col      = input.color(color.new(#ffffff, 0), "Text Color", group=g_visual)
color   i_text_bg       = input.color(color.new(#000000, 85), "Text Background", group=g_visual)
color   i_text_border    = input.color(color.new(#4a5568, 100), "Text Border", group=g_visual)
int     i_zone_transp   = input.int(80, "Zone Transparency", minval=50, maxval=95, group=g_visual)
bool    i_show_glow     = input.bool(true, "Enable Glow Effects", group=g_visual)
bool    i_show_dash     = input.bool(true, "Show Dashboard", group=g_visual)
bool    i_show_labels   = input.bool(true, "Show Structure Labels", group=g_visual)
bool    i_show_prox_labels = input.bool(true, "Show Proximity Labels", group=g_visual)
string  i_label_size    = input.string("Small", "Label Size", ["Tiny", "Small", "Normal", "Large"], group=g_visual)

//───────────────────────────────────────────────────────────────────────────────
// TYPE DEFINITIONS
//───────────────────────────────────────────────────────────────────────────────

type SwingPoint
    float price
    int   bar_idx
    int   direction  // 1 = high, -1 = low
    bool  is_valid
    line  level_line
    label level_label

type LiquidityZone
    float top
    float bottom
    int   start_bar
    int   touch_count
    bool  is_active
    int   zone_type  // 1 = EQH, -1 = EQL, 2 = cluster
    box   zone_box
    box   glow_box
    label strength_label
    label type_label
    float strength_score
    int   age_bars

//───────────────────────────────────────────────────────────────────────────────
// STATE VARIABLES
//───────────────────────────────────────────────────────────────────────────────

var array<SwingPoint> swing_highs = array.new<SwingPoint>()
var array<SwingPoint> swing_lows = array.new<SwingPoint>()
var array<LiquidityZone> liq_zones = array.new<LiquidityZone>()
var label res_prox_label = na
var label sup_prox_label = na

//───────────────────────────────────────────────────────────────────────────────
// UTILITY FUNCTIONS
//───────────────────────────────────────────────────────────────────────────────

f_pct_diff(float p1, float p2) =>
    math.abs(p1 - p2) / math.avg(p1, p2) * 100

f_cleanup_old_drawings(array<SwingPoint> arr, int max_count) =>
    while array.size(arr) > max_count
        SwingPoint old = array.shift(arr)
        if not na(old.level_line)
            line.delete(old.level_line)
        if not na(old.level_label)
            label.delete(old.level_label)

f_cleanup_old_zones(array<LiquidityZone> arr, int max_count) =>
    while array.size(arr) > max_count
        LiquidityZone old = array.shift(arr)
        if not na(old.zone_box)
            box.delete(old.zone_box)
        if not na(old.glow_box)
            box.delete(old.glow_box)
        if not na(old.strength_label)
            label.delete(old.strength_label)
        if not na(old.type_label)
            label.delete(old.type_label)

// Zone strength calculation
f_calc_zone_strength(int touches, int age, float zone_width, float atr_val) =>
    float touch_score = math.min(float(touches) / 5.0 * 40, 40)
    float age_score = math.max(30 - float(age) / 50.0 * 30, 0)
    float width_score = math.min(atr_val / zone_width * 30, 30)
    touch_score + age_score + width_score

// Proximity score - how close is price to zone
f_proximity_score(float price, float zone_top, float zone_bot) =>
    float zone_mid = (zone_top + zone_bot) / 2
    float dist = math.abs(price - zone_mid)
    float zone_height = zone_top - zone_bot
    math.max(100 - (dist / zone_height * 100), 0)

//───────────────────────────────────────────────────────────────────────────────
// SWING DETECTION
//───────────────────────────────────────────────────────────────────────────────

float pivot_high = ta.pivothigh(high, i_swing_left, i_swing_right)
float pivot_low = ta.pivotlow(low, i_swing_left, i_swing_right)

// Process new swing high
if not na(pivot_high) and barstate.isconfirmed
    int pivot_bar = bar_index - i_swing_right
    
    SwingPoint new_sh = SwingPoint.new()
    new_sh.price := pivot_high
    new_sh.bar_idx := pivot_bar
    new_sh.direction := 1
    new_sh.is_valid := true
    
    if i_show_swings
        new_sh.level_line := line.new(pivot_bar, pivot_high, bar_index + 20, pivot_high, 
                                       color=color.new(i_swing_h_col, 60), style=line.style_dotted, width=1)
        
        if i_show_labels
            string sh_text = "Swing High\n" + str.tostring(pivot_high, "#.##")
            new_sh.level_label := label.new(pivot_bar, pivot_high, sh_text, 
                                           style=label.style_label_down, 
                                           color=color.new(i_swing_h_col, 85), textcolor=color.new(#ffffff, 0),
                                           size=i_label_size == "Tiny" ? size.tiny : i_label_size == "Small" ? size.small : i_label_size == "Normal" ? size.normal : size.large)
    
    array.push(swing_highs, new_sh)
    f_cleanup_old_drawings(swing_highs, i_max_swings)

// Process new swing low
if not na(pivot_low) and barstate.isconfirmed
    int pivot_bar = bar_index - i_swing_right
    
    SwingPoint new_sl = SwingPoint.new()
    new_sl.price := pivot_low
    new_sl.bar_idx := pivot_bar
    new_sl.direction := -1
    new_sl.is_valid := true
    
    if i_show_swings
        new_sl.level_line := line.new(pivot_bar, pivot_low, bar_index + 20, pivot_low, 
                                       color=color.new(i_swing_l_col, 60), style=line.style_dotted, width=1)
        
        if i_show_labels
            string sl_text = "Swing Low\n" + str.tostring(pivot_low, "#.##")
            new_sl.level_label := label.new(pivot_bar, pivot_low, sl_text, 
                                           style=label.style_label_up, 
                                           color=color.new(i_swing_l_col, 85), textcolor=color.new(#ffffff, 0),
                                           size=i_label_size == "Tiny" ? size.tiny : i_label_size == "Small" ? size.small : i_label_size == "Normal" ? size.normal : size.large)
    
    array.push(swing_lows, new_sl)
    f_cleanup_old_drawings(swing_lows, i_max_swings)

//───────────────────────────────────────────────────────────────────────────────
// EQUAL HIGHS/LOWS DETECTION
//───────────────────────────────────────────────────────────────────────────────

f_find_equal_levels(array<SwingPoint> swings, float threshold, int zone_type, color zone_col, float atr_val) =>
    int sz = array.size(swings)
    if sz >= 2 and barstate.isconfirmed
        SwingPoint latest = array.get(swings, sz - 1)
        
        for i = 0 to sz - 2
            SwingPoint compare = array.get(swings, i)
            
            if compare.is_valid and latest.is_valid
                float pct = f_pct_diff(latest.price, compare.price)
                
                if pct <= threshold
                    // Found equal level - create liquidity zone
                    float zone_top = math.max(latest.price, compare.price)
                    float zone_bot = math.min(latest.price, compare.price)
                    
                    // Add small buffer to zone
                    zone_top := zone_top + atr_val * 0.1
                    zone_bot := zone_bot - atr_val * 0.1
                    
                    LiquidityZone new_zone = LiquidityZone.new()
                    new_zone.top := zone_top
                    new_zone.bottom := zone_bot
                    new_zone.start_bar := math.min(latest.bar_idx, compare.bar_idx)
                    new_zone.touch_count := 2
                    new_zone.is_active := true
                    new_zone.zone_type := zone_type
                    
                    new_zone.strength_score := f_calc_zone_strength(2, 0, zone_top - zone_bot, atr_val)
                    new_zone.age_bars := 0
                    
                    if i_show_zones
                        // Glow effect box with gradient layers
                        if i_show_glow
                            // Outer glow layer
                            float glow_buffer_outer = atr_val * 0.08
                            box outer_glow = box.new(new_zone.start_bar, zone_top + glow_buffer_outer, bar_index + i_eq_extend, zone_bot - glow_buffer_outer,
                                                    border_color=na, 
                                                    bgcolor=color.new(zone_col, i_zone_transp + 15),
                                                    border_width=0)
                            
                            // Middle glow layer
                            float glow_buffer_mid = atr_val * 0.05
                            new_zone.glow_box := box.new(new_zone.start_bar, zone_top + glow_buffer_mid, bar_index + i_eq_extend, zone_bot - glow_buffer_mid,
                                                          border_color=na, 
                                                          bgcolor=color.new(zone_col, i_zone_transp + 8),
                                                          border_width=0)
                        
                        // Core zone box
                        color core_col = zone_type == 1 ? i_eqh_core : i_eql_core
                        new_zone.zone_box := box.new(new_zone.start_bar, zone_top, bar_index + i_eq_extend, zone_bot,
                                                      border_color=color.new(core_col, 40), 
                                                      bgcolor=color.new(zone_col, i_zone_transp),
                                                      border_width=2, border_style=line.style_solid)
                        
                        // Type label
                        if i_show_labels
                            string type_txt = zone_type == 1 ? "EQH ZONE\nLiquidity Pool" : "EQL ZONE\nLiquidity Pool"
                            new_zone.type_label := label.new(new_zone.start_bar + 5, zone_type == 1 ? zone_top : zone_bot,
                                                            type_txt, style=zone_type == 1 ? label.style_label_down : label.style_label_up,
                                                            color=color.new(zone_col, 85), textcolor=color.new(#ffffff, 0),
                                                            size=i_label_size == "Tiny" ? size.tiny : i_label_size == "Small" ? size.small : i_label_size == "Normal" ? size.normal : size.large)
                        
                        // Strength label
                        if i_show_strength
                            string strength_txt = "Strength: " + str.tostring(new_zone.strength_score, "#") + "%"
                            new_zone.strength_label := label.new(bar_index + i_eq_extend, zone_type == 1 ? zone_top : zone_bot,
                                                                   strength_txt, style=label.style_label_left,
                                                                   color=color.new(zone_col, 70), textcolor=color.new(#ffffff, 20),
                                                                   size=size.tiny)
                    
                    array.push(liq_zones, new_zone)
                    break

// Calculate ATR once for consistency
float atr_val = ta.atr(14)

// Detect equal levels
if i_show_eqh and array.size(swing_highs) >= 2
    f_find_equal_levels(swing_highs, i_eq_threshold, 1, i_eqh_col, atr_val)

if i_show_eql and array.size(swing_lows) >= 2
    f_find_equal_levels(swing_lows, i_eq_threshold, -1, i_eql_col, atr_val)

// Cleanup old zones
f_cleanup_old_zones(liq_zones, i_max_swings)

//───────────────────────────────────────────────────────────────────────────────
// ZONE INTERACTION TRACKING
//───────────────────────────────────────────────────────────────────────────────

// Track price interaction with zones
if array.size(liq_zones) > 0 and barstate.isconfirmed
    for i = array.size(liq_zones) - 1 to 0
        LiquidityZone zone = array.get(liq_zones, i)
        
        if zone.is_active
            // Check if price swept the zone
            bool swept_high = zone.zone_type == 1 and high > zone.top
            bool swept_low = zone.zone_type == -1 and low < zone.bottom
            
            // Update zone age
            zone.age_bars := zone.age_bars + 1
            
            // Check for zone touches (price enters zone but doesn't sweep)
            bool touching_high = zone.zone_type == 1 and high >= zone.bottom and high <= zone.top
            bool touching_low = zone.zone_type == -1 and low <= zone.top and low >= zone.bottom
            
            if (touching_high or touching_low) and not (swept_high or swept_low)
                zone.touch_count := zone.touch_count + 1
                zone.strength_score := f_calc_zone_strength(zone.touch_count, zone.age_bars, zone.top - zone.bottom, atr_val)
                
                // Update strength label
                if not na(zone.strength_label) and i_show_strength
                    label.set_text(zone.strength_label, str.tostring(zone.strength_score, "#") + "%")
                
                // Intensify zone color with more touches
                if not na(zone.zone_box)
                    int new_transp = math.max(i_zone_transp - zone.touch_count * 5, 50)
                    color base_col = zone.zone_type == 1 ? i_eqh_col : i_eql_col
                    box.set_bgcolor(zone.zone_box, color.new(base_col, new_transp))
            
            if swept_high or swept_low
                zone.is_active := false
                if not na(zone.zone_box)
                    box.set_bgcolor(zone.zone_box, color.new(i_swept_col, 92))
                    box.set_border_color(zone.zone_box, color.new(i_swept_col, 70))
                    box.set_border_style(zone.zone_box, line.style_dotted)
                    box.set_right(zone.zone_box, bar_index)
                if not na(zone.glow_box)
                    box.delete(zone.glow_box)
                if not na(zone.strength_label)
                    label.set_text(zone.strength_label, "SWEPT")
                    label.set_textcolor(zone.strength_label, color.new(i_swept_col, 50))
                if not na(zone.type_label) and i_show_labels
                    label.set_text(zone.type_label, zone.zone_type == 1 ? "EQH SWEPT\nLiquidity Taken" : "EQL SWEPT\nLiquidity Taken")
                    label.set_textcolor(zone.type_label, color.new(#ffffff, 0))

//───────────────────────────────────────────────────────────────────────────────
// STRUCTURE ANALYSIS OUTPUTS
//───────────────────────────────────────────────────────────────────────────────

// Calculate structure metrics
float nearest_resistance = na
float nearest_support = na
int active_eqh_count = 0
int active_eql_count = 0

if array.size(swing_highs) > 0
    for i = array.size(swing_highs) - 1 to 0
        SwingPoint sh = array.get(swing_highs, i)
        if sh.price > close and (na(nearest_resistance) or sh.price < nearest_resistance)
            nearest_resistance := sh.price

if array.size(swing_lows) > 0
    for i = array.size(swing_lows) - 1 to 0
        SwingPoint sl = array.get(swing_lows, i)
        if sl.price < close and (na(nearest_support) or sl.price > nearest_support)
            nearest_support := sl.price

// Count active zones
if array.size(liq_zones) > 0
    for i = 0 to array.size(liq_zones) - 1
        LiquidityZone zone = array.get(liq_zones, i)
        if zone.is_active
            if zone.zone_type == 1
                active_eqh_count += 1
            else if zone.zone_type == -1
                active_eql_count += 1

// Distance to nearest levels
float dist_to_resistance = na(nearest_resistance) ? na : (nearest_resistance - close) / close * 100
float dist_to_support = na(nearest_support) ? na : (close - nearest_support) / close * 100

// Structure bias calculation
float structure_bias = 0.0
if not na(dist_to_resistance) and not na(dist_to_support)
    structure_bias := (dist_to_support - dist_to_resistance) / (dist_to_support + dist_to_resistance)

//───────────────────────────────────────────────────────────────────────────────
// VISUALIZATION - LEVEL MARKERS
//───────────────────────────────────────────────────────────────────────────────

// Proximity to zones
float resistance_proximity = na(nearest_resistance) ? 0 : f_proximity_score(close, nearest_resistance, nearest_resistance - ta.atr(14) * 0.5)
float support_proximity = na(nearest_support) ? 0 : f_proximity_score(close, nearest_support + ta.atr(14) * 0.5, nearest_support)

// Dynamic colors based on proximity
color res_color = resistance_proximity > 50 ? color.new(i_swing_h_col, math.round(50 - resistance_proximity * 0.3)) : color.new(i_swing_h_col, 60)
color sup_color = support_proximity > 50 ? color.new(i_swing_l_col, math.round(50 - support_proximity * 0.3)) : color.new(i_swing_l_col, 60)

// Enhanced proximity labels
if i_show_prox_labels and barstate.islast
    // Clean up old proximity labels
    if not na(res_prox_label)
        label.delete(res_prox_label)
    if not na(sup_prox_label)
        label.delete(sup_prox_label)
    
    // Resistance proximity label
    if not na(nearest_resistance) and resistance_proximity > 30
        string res_label = "RESISTANCE\n" + str.tostring(nearest_resistance, "#.##") + "\nProximity: " + str.tostring(resistance_proximity, "#") + "%"
        res_prox_label := label.new(bar_index, nearest_resistance, res_label,
                                   style=label.style_label_down,
                                   color=color.new(i_res_prox_col, 85), textcolor=color.new(#ffffff, 0),
                                   size=i_label_size == "Tiny" ? size.tiny : i_label_size == "Small" ? size.small : i_label_size == "Normal" ? size.normal : size.large)
    
    // Support proximity label
    if not na(nearest_support) and support_proximity > 30
        string sup_label = "SUPPORT\n" + str.tostring(nearest_support, "#.##") + "\nProximity: " + str.tostring(support_proximity, "#") + "%"
        sup_prox_label := label.new(bar_index, nearest_support, sup_label,
                                   style=label.style_label_up,
                                   color=color.new(i_sup_prox_col, 85), textcolor=color.new(#ffffff, 0),
                                   size=i_label_size == "Tiny" ? size.tiny : i_label_size == "Small" ? size.small : i_label_size == "Normal" ? size.normal : size.large)

// Plot nearest levels with enhanced visual
plotshape(nearest_resistance, "Nearest Resistance", shape.circle, location.absolute, 
          color=res_color, size=size.small)
plotshape(nearest_support, "Nearest Support", shape.circle, location.absolute, 
          color=sup_color, size=size.small)

// Additional visual markers for high proximity
plotshape(resistance_proximity > 70, "Res Warning", shape.triangledown, location.absolute,
          color=i_res_prox_col, size=size.tiny, offset=1)
plotshape(support_proximity > 70, "Sup Warning", shape.triangleup, location.absolute,
          color=i_sup_prox_col, size=size.tiny, offset=1)

// Proximity warning background with gradient
bgcolor(resistance_proximity > 70 ? color.new(i_res_prox_col, 95) : support_proximity > 70 ? color.new(i_sup_prox_col, 95) : na)

//───────────────────────────────────────────────────────────────────────────────
// DASHBOARD
//───────────────────────────────────────────────────────────────────────────────

if i_show_dash and barstate.islast
    var table dash = table.new(position.top_right, 2, 7, bgcolor=color.new(#0d1117, 5), border_width=1, border_color=color.new(#30363d, 40))
    
    table.cell(dash, 0, 0, "LIQUIDITY", text_color=color.new(#c9d1d9, 0), text_size=size.small)
    table.cell(dash, 1, 0, "MAPPER", text_color=i_liq_col, text_size=size.small)
    
    table.cell(dash, 0, 1, "EQH ZONES", text_color=color.new(#b2b5be, 0), text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(active_eqh_count), text_color=i_eqh_col, text_size=size.small)
    
    table.cell(dash, 0, 2, "EQL ZONES", text_color=color.new(#b2b5be, 0), text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(active_eql_count), text_color=i_eql_col, text_size=size.small)
    
    table.cell(dash, 0, 3, "RESISTANCE", text_color=color.new(#b2b5be, 0), text_size=size.small)
    string res_txt = na(nearest_resistance) ? "---" : str.tostring(nearest_resistance, "#.##")
    table.cell(dash, 1, 3, res_txt, text_color=i_swing_h_col, text_size=size.small)
    
    table.cell(dash, 0, 4, "SUPPORT", text_color=color.new(#b2b5be, 0), text_size=size.small)
    string sup_txt = na(nearest_support) ? "---" : str.tostring(nearest_support, "#.##")
    table.cell(dash, 1, 4, sup_txt, text_color=i_swing_l_col, text_size=size.small)
    
    table.cell(dash, 0, 5, "RES PROX", text_color=color.new(#b2b5be, 0), text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(resistance_proximity, "#") + "%", text_color=resistance_proximity > 50 ? i_swing_h_col : color.new(#78909c, 0), text_size=size.small)
    
    table.cell(dash, 0, 6, "SUP PROX", text_color=color.new(#b2b5be, 0), text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(support_proximity, "#") + "%", text_color=support_proximity > 50 ? i_swing_l_col : color.new(#78909c, 0), text_size=size.small)

//───────────────────────────────────────────────────────────────────────────────
// EXPORT PLOTS (for strategy integration)
//───────────────────────────────────────────────────────────────────────────────

plot(nearest_resistance, "Resistance Export", display=display.none)
plot(nearest_support, "Support Export", display=display.none)
plot(structure_bias, "Structure Bias Export", display=display.none)
plot(float(active_eqh_count), "Active EQH Count Export", display=display.none)
plot(float(active_eql_count), "Active EQL Count Export", display=display.none)
plot(dist_to_resistance, "Distance to Resistance Export", display=display.none)
plot(dist_to_support, "Distance to Support Export", display=display.none)
plot(resistance_proximity, "Resistance Proximity Export", display=display.none)
plot(support_proximity, "Support Proximity Export", display=display.none)

//───────────────────────────────────────────────────────────────────────────────
// ALERTS
//───────────────────────────────────────────────────────────────────────────────

alertcondition(not na(pivot_high), "New Swing High", "New swing high detected")
alertcondition(not na(pivot_low), "New Swing Low", "New swing low detected")
alertcondition(high > nearest_resistance and not na(nearest_resistance), "Resistance Break", "Price broke above resistance")
alertcondition(low < nearest_support and not na(nearest_support), "Support Break", "Price broke below support")
