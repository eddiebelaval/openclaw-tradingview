//@version=6
indicator("Liquidity Precision Overlay", overlay = true)

// === INPUTS ===
rr = input.float(2.0, "Risk Reward Ratio", step = 0.5)
lookback = input.int(10, "Liquidity Lookback")

// === LIQUIDITY LEVELS ===
equalHigh = ta.highest(high[1], lookback)
equalLow  = ta.lowest(low[1], lookback)

// === LIQUIDITY GRAB CONDITIONS ===
bullishGrab = low < equalLow and close > equalLow
bearishGrab = high > equalHigh and close < equalHigh

// === CONFIRMATION ===
bullConfirm = bullishGrab[1] and close > high[1]
bearConfirm = bearishGrab[1] and close < low[1]

// === LONG SETUP ===
if bullConfirm
    entryPrice = close
    stopPrice  = low[1]
    targetPrice = entryPrice + (entryPrice - stopPrice) * rr

    box.new(bar_index, stopPrice, bar_index + 10, entryPrice,
        border_color = color.red,
        bgcolor = color.new(color.red, 85))

    box.new(bar_index, entryPrice, bar_index + 10, targetPrice,
        border_color = color.green,
        bgcolor = color.new(color.green, 85))

// === SHORT SETUP ===
if bearConfirm
    entryPrice = close
    stopPrice  = high[1]
    targetPrice = entryPrice - (stopPrice - entryPrice) * rr

    box.new(bar_index, entryPrice, bar_index + 10, stopPrice,
        border_color = color.red,
        bgcolor = color.new(color.red, 85))

    box.new(bar_index, targetPrice, bar_index + 10, entryPrice,
        border_color = color.green,
        bgcolor = color.new(color.green, 85))

// === ARROWS ===
plotshape(bullConfirm,
     location = location.belowbar,
     color = color.green,
     style = shape.triangleup,
     size = size.large)

plotshape(bearConfirm,
     location = location.abovebar,
     color = color.red,
     style = shape.triangledown,
     size = size.large)
