//@version=6

indicator("Strong Pinbar Reversals MTF", overlay=true, max_boxes_count=200, max_labels_count=500, max_lines_count=400)

// ─── GROUPS ──────────────────────────────────────────────────────────────────
var string G1 = "Pinbar Detection"
var string G2 = "Zone Display"
var string G3 = "SL / TP"
var string G4 = "Dashboard"
var string G5 = "Colors"

// ─── INPUTS ──────────────────────────────────────────────────────────────────
i_wickPct    = input.float(62.0, "Min Wick % of Range",          minval=40.0, maxval=92.0, step=2.0,  group=G1, tooltip="Minimum ratio of dominant wick to full candle range. 60-65% recommended.")
i_minPins    = input.int(3,      "Min Pins in Cluster",          minval=2,    maxval=8,               group=G1, tooltip="Minimum number of qualifying pinbars in the lookback window to trigger a zone.")
i_window     = input.int(10,     "Cluster Window (bars)",        minval=3,    maxval=50,              group=G1, tooltip="How many bars back to scan for the cluster.")
i_minStr     = input.int(5,      "Min Strength to Display (0-10)", minval=0,  maxval=10,              group=G1, tooltip="Zones below this strength are hidden. Default 6 = only strong clusters shown.")

i_adrZonePer = input.int(10,     "ADR Period (zone height)",     minval=5,    maxval=30,              group=G2)
i_zonePct    = input.float(9.0,  "Zone Height % of ADR",        minval=0.5,  maxval=25.0, step=0.5,  group=G2)
i_extLeft    = input.int(75,    "Extend Left (bars)",           minval=0,    maxval=500,             group=G2)
i_extRight   = input.int(75,    "Extend Right (bars)",          minval=0,    maxval=500,             group=G2)
i_transp     = input.int(82,     "Zone Fill Transparency",       minval=50,   maxval=98,              group=G2)
i_lblSize    = input.string("normal", "Label Size",               options=["tiny","small","normal","large","huge"], group=G2)

i_showSLTP   = input.bool(true,  "Show SL / TP Lines",                                               group=G3)
i_adrSLTPer  = input.int(10,     "ADR Period (SL/TP)",           minval=5,    maxval=30,              group=G3)
i_slPct      = input.float(20.0,  "SL % of ADR",                 minval=0.5,  maxval=35.0, step=0.5,  group=G3)
i_tp1Pct     = input.float(30.0,  "TP1 % of ADR",                minval=0.5,  maxval=30.0, step=0.5,  group=G3)
i_tp2Pct     = input.float(40.0,  "TP2 % of ADR",                minval=0.5,  maxval=40.0, step=0.5,  group=G3)
i_stpSize    = input.string("normal", "SL/TP Label Size",        options=["tiny","small","normal","large","huge"], group=G3)

i_showDash   = input.bool(true,  "Show MTF Dashboard",                                               group=G4)
i_dashSize   = input.string("normal", "Dashboard Text Size",     options=["tiny","small","normal","large","huge"], group=G4)

i_bullLo     = input.color(#26a69a, "Bull Color Low  (6-7)",                                          group=G5)
i_bullMid    = input.color(#00897b, "Bull Color Mid  (7-8)",                                          group=G5)
i_bullHi     = input.color(#004d40, "Bull Color High (9-10)",                                         group=G5)
i_bearLo     = input.color(#b71c1c, "Bear Color Low  (6-7)",                                          group=G5)
i_bearMid    = input.color(#880e4f, "Bear Color Mid  (7-8)",                                          group=G5)
i_bearHi     = input.color(#4a148c, "Bear Color High (9-10)",                                         group=G5)

// ─── CONSTANTS ───────────────────────────────────────────────────────────────
C_SL    = #6D1A1A
C_TP1   = #4DB6AC
C_TP2   = #26A69A
C_LBL   = #90A4AE
C_GOLD  = #FFD700
C_WHITE = #E2E8F0
C_GREY  = #718096
C_TEAL  = #4DB6AC
C_RED   = #EF5350
C_DASH_BG  = color.new(#0d1117,  8)
C_DASH_HDR = color.new(#1a1f2e, 10)
C_DASH_ROW = color.new(#111827, 15)
C_DASH_ALT = color.new(#0d1117, 20)
C_DASH_BDR = color.new(#2d3748, 60)

// ─── HELPERS ─────────────────────────────────────────────────────────────────
f_sz(s) =>
    s == "tiny" ? size.tiny : s == "small" ? size.small : s == "large" ? size.large : s == "huge" ? size.huge : size.normal

f_col(bull, str) =>
    bull ? (str >= 9 ? i_bullHi : str >= 7 ? i_bullMid : i_bullLo) : (str >= 9 ? i_bearHi : str >= 7 ? i_bearMid : i_bearLo)

f_p(v) =>
    dp = syminfo.mintick >= 1.0 ? 0 : syminfo.mintick >= 0.1 ? 1 : syminfo.mintick >= 0.01 ? 2 : syminfo.mintick >= 0.001 ? 3 : syminfo.mintick >= 0.0001 ? 4 : 5
    fmt = dp == 0 ? "#" : dp == 1 ? "#.0" : dp == 2 ? "#.00" : dp == 3 ? "#.000" : dp == 4 ? "#.0000" : "#.00000"
    str.tostring(v, fmt)

// ─── ADR ─────────────────────────────────────────────────────────────────────
dH       = request.security(syminfo.tickerid, "D", high,  lookahead=barmerge.lookahead_off)
dL       = request.security(syminfo.tickerid, "D", low,   lookahead=barmerge.lookahead_off)
adrZone  = ta.sma(dH - dL, i_adrZonePer)
adrSLTP  = ta.sma(dH - dL, i_adrSLTPer)
atr14    = ta.atr(14)

_adrZ    = not na(adrZone) and adrZone > 0 ? adrZone : close * 0.01
_adrS    = not na(adrSLTP) and adrSLTP > 0 ? adrSLTP : close * 0.01
zoneH    = _adrZ * i_zonePct / 100
slDist   = _adrS * i_slPct   / 100
tp1Dist  = _adrS * i_tp1Pct  / 100
tp2Dist  = _adrS * i_tp2Pct  / 100

// ─── CORE DETECTION — LOOKBACK WINDOW SCAN ───────────────────────────────────
//
// On every bar, scan the last i_window bars (including current).
// For each bar in the window, classify it as bull pin, bear pin, or neither.
// Count separately. Direction is determined by which count >= i_minPins.
// If both counts qualify (rare), the higher count wins. Tie = bull wins.
//
// This approach has NO persistent state arrays. No accumulation bugs.
// The classification is re-evaluated fresh on every bar.

float wt = i_wickPct / 100.0

int   bull_n     = 0
int   bear_n     = 0
float bull_wsum  = 0.0
float bear_wsum  = 0.0
float bull_wmin  = 1.0
float bear_wmin  = 1.0
float bull_rsum  = 0.0
float bear_rsum  = 0.0
float bull_low   = high   // will track lowest low of bull pins
float bear_high  = low    // will track highest high of bear pins

int   win = i_window - 1  // offset: 0 = current bar, win = oldest bar

for i = 0 to win
    _h   = high[i]
    _l   = low[i]
    _o   = open[i]
    _c   = close[i]
    _rng = _h - _l
    if _rng <= 0
        continue
    _mid = _l + _rng * 0.5
    _bt  = math.max(_c, _o)
    _bb  = math.min(_c, _o)
    _uw  = _h - _bt
    _lw  = _bb - _l

    // BULLISH PIN: lower wick dominant + meets threshold + close in upper half + closed green or flat
    if _lw > _uw and (_lw / _rng) >= wt and _c >= _mid
        bull_n    += 1
        bull_wsum += _lw / _rng
        bull_wmin := math.min(bull_wmin, _lw / _rng)
        bull_rsum += _rng
        bull_low  := math.min(bull_low, _l)

    // BEARISH PIN: upper wick dominant + meets threshold + close in lower half + closed red or flat
    else if _uw > _lw and (_uw / _rng) >= wt and _c <= _mid
        bear_n    += 1
        bear_wsum += _uw / _rng
        bear_wmin := math.min(bear_wmin, _uw / _rng)
        bear_rsum += _rng
        bear_high := math.max(bear_high, _h)

// ─── STRENGTH FUNCTION ───────────────────────────────────────────────────────
f_str(cnt, avg_w, min_w, avg_r, cur_atr, density, thresh) =>
    s = 0.0
    s += cnt >= 6 ? 3.0 : cnt == 5 ? 2.5 : cnt == 4 ? 2.0 : cnt == 3 ? 1.0 : 0.0
    ae = avg_w - thresh
    s += ae >= 0.20 ? 2.0 : ae >= 0.12 ? 1.5 : ae >= 0.06 ? 1.0 : ae > 0.0 ? 0.5 : 0.0
    me = min_w - thresh
    s += me >= 0.18 ? 2.0 : me >= 0.10 ? 1.5 : me >= 0.04 ? 1.0 : me > 0.0 ? 0.5 : 0.0
    rr = cur_atr > 0 ? avg_r / cur_atr : 0.0
    s += rr >= 1.8 ? 2.0 : rr >= 1.3 ? 1.5 : rr >= 0.9 ? 1.0 : rr >= 0.6 ? 0.5 : 0.0
    s += density >= 0.50 ? 1.0 : density >= 0.33 ? 0.5 : 0.0
    float(math.max(0.0, math.min(10.0, math.round(s * 10) / 10)))

// ─── SCORE BOTH DIRECTIONS ───────────────────────────────────────────────────
float bull_str = 0.0
float bear_str = 0.0

if bull_n >= i_minPins
    bull_str := f_str(bull_n, bull_wsum / bull_n, bull_wmin, bull_rsum / bull_n, atr14, float(bull_n) / float(i_window), wt)

if bear_n >= i_minPins
    bear_str := f_str(bear_n, bear_wsum / bear_n, bear_wmin, bear_rsum / bear_n, atr14, float(bear_n) / float(i_window), wt)

// ─── DETERMINE SIGNAL ────────────────────────────────────────────────────────
// Only one direction fires per bar. Bull wins on tie.
// sig_dir:  1 = bullish reversal zone (at price LOW)
//          -1 = bearish reversal zone (at price HIGH)
//           0 = no signal

int   sig_dir   = 0
float sig_str   = 0.0
float sig_price = na   // anchor: lowest low for bull, highest high for bear

if bull_n >= i_minPins and bull_str >= bear_str
    sig_dir   := 1
    sig_str   := bull_str
    sig_price := bull_low

else if bear_n >= i_minPins
    sig_dir   := -1
    sig_str   := bear_str
    sig_price := bear_high

// ─── SIGNAL PERSISTENCE — fire only on new unique signal ─────────────────────
// We detect a "new" signal when sig_dir changes from 0 to non-zero, or when
// the anchor price changes significantly (new cluster at different level).
// Persistent vars hold the LAST VALID signal for dashboard display.

var int   last_sig_dir   = 0
var float last_sig_price = na
var int   last_sig_bar   = 0
var float last_sig_str   = 0.0
var float last_sig_sl    = na
var float last_sig_tp1   = na
var float last_sig_tp2   = na

bool is_new_signal = false

if sig_dir != 0
    price_changed = na(last_sig_price) or math.abs(sig_price - last_sig_price) > zoneH * 0.5
    dir_changed   = sig_dir != last_sig_dir
    if price_changed or dir_changed
        is_new_signal    := true
        last_sig_dir     := sig_dir
        last_sig_price   := sig_price
        last_sig_bar     := bar_index

// ─── SL / TP ─────────────────────────────────────────────────────────────────
float sig_sl  = sig_dir ==  1 ? sig_price - slDist  : sig_dir == -1 ? sig_price + slDist  : na
float sig_tp1 = sig_dir ==  1 ? sig_price + tp1Dist : sig_dir == -1 ? sig_price - tp1Dist : na
float sig_tp2 = sig_dir ==  1 ? sig_price + tp2Dist : sig_dir == -1 ? sig_price - tp2Dist : na

// Update persistent signal state whenever a new signal fires
if is_new_signal
    last_sig_str  := sig_str
    last_sig_sl   := sig_sl
    last_sig_tp1  := sig_tp1
    last_sig_tp2  := sig_tp2

// ─── ZONE DRAWING ────────────────────────────────────────────────────────────
// Zones are drawn ONLY when a new signal fires AND strength >= minimum.
// BULLISH: zone box from sig_price (lowest low) UP by zoneH
// BEARISH: zone box from sig_price (highest high) DOWN by zoneH

if is_new_signal and sig_str >= i_minStr
    _bull  = sig_dir == 1
    _col   = f_col(_bull, sig_str)
    _lbl   = _bull ? "BULLISH PINBARS" : "BEARISH PINBARS"

    // Zone anchor
    _bot = _bull ? sig_price          : sig_price - zoneH
    _top = _bull ? sig_price + zoneH  : sig_price
    _mid_y = (_bot + _top) / 2

    // Draw shaded zone box
    box.new(bar_index - i_extLeft, _bot, bar_index + i_extRight, _top, bgcolor=color.new(_col, i_transp), border_color=color.new(_col, 70), border_width=1)

    // Strength label inside zone
    label.new(bar_index, _mid_y, _lbl + "\nStrength " + str.tostring(sig_str, "#.0") + "/10", color=color.new(_col, 100), textcolor=_col, style=label.style_label_center, size=f_sz(i_lblSize), textalign=text.align_center)

    // SL / TP lines and labels
    if i_showSLTP and not na(sig_sl)
        line.new(bar_index - i_extLeft, sig_sl,  bar_index + i_extRight, sig_sl,  color=C_SL,  style=line.style_dashed, width=1)
        line.new(bar_index - i_extLeft, sig_tp1, bar_index + i_extRight, sig_tp1, color=C_TP1, style=line.style_dashed, width=1)
        line.new(bar_index - i_extLeft, sig_tp2, bar_index + i_extRight, sig_tp2, color=C_TP2, style=line.style_dashed, width=1)
        label.new(bar_index + i_extRight, sig_sl,  "SL "  + f_p(sig_sl),  color=color.new(C_SL,  100), textcolor=C_LBL, style=label.style_label_left, size=f_sz(i_stpSize))
        label.new(bar_index + i_extRight, sig_tp1, "TP1 " + f_p(sig_tp1), color=color.new(C_TP1, 100), textcolor=C_LBL, style=label.style_label_left, size=f_sz(i_stpSize))
        label.new(bar_index + i_extRight, sig_tp2, "TP2 " + f_p(sig_tp2), color=color.new(C_TP2, 100), textcolor=C_LBL, style=label.style_label_left, size=f_sz(i_stpSize))

// ─── ALERTS ──────────────────────────────────────────────────────────────────
if is_new_signal and sig_dir == 1 and sig_str >= i_minStr
    alert("BULLISH PINBAR CLUSTER | " + syminfo.tickerid + " " + timeframe.period + " | Str: " + str.tostring(sig_str, "#.0") + "/10 | SL: " + f_p(sig_sl) + " | TP1: " + f_p(sig_tp1) + " | TP2: " + f_p(sig_tp2), alert.freq_once_per_bar_close)

if is_new_signal and sig_dir == -1 and sig_str >= i_minStr
    alert("BEARISH PINBAR CLUSTER | " + syminfo.tickerid + " " + timeframe.period + " | Str: " + str.tostring(sig_str, "#.0") + "/10 | SL: " + f_p(sig_sl) + " | TP1: " + f_p(sig_tp1) + " | TP2: " + f_p(sig_tp2), alert.freq_once_per_bar_close)

// ─── MTF DASHBOARD ───────────────────────────────────────────────────────────
// Pass PERSISTENT last-valid-signal vars to each TF so the dashboard always
// shows a value, not just the bar where the signal fired.

[r_m1_dir,  r_m1_str,  r_m1_sl,  r_m1_tp1,  r_m1_tp2]  = request.security(syminfo.tickerid, "1",   [last_sig_dir, last_sig_str, last_sig_sl, last_sig_tp1, last_sig_tp2], lookahead=barmerge.lookahead_off)
[r_m5_dir,  r_m5_str,  r_m5_sl,  r_m5_tp1,  r_m5_tp2]  = request.security(syminfo.tickerid, "5",   [last_sig_dir, last_sig_str, last_sig_sl, last_sig_tp1, last_sig_tp2], lookahead=barmerge.lookahead_off)
[r_m15_dir, r_m15_str, r_m15_sl, r_m15_tp1, r_m15_tp2] = request.security(syminfo.tickerid, "15",  [last_sig_dir, last_sig_str, last_sig_sl, last_sig_tp1, last_sig_tp2], lookahead=barmerge.lookahead_off)
[r_m30_dir, r_m30_str, r_m30_sl, r_m30_tp1, r_m30_tp2] = request.security(syminfo.tickerid, "30",  [last_sig_dir, last_sig_str, last_sig_sl, last_sig_tp1, last_sig_tp2], lookahead=barmerge.lookahead_off)
[r_h1_dir,  r_h1_str,  r_h1_sl,  r_h1_tp1,  r_h1_tp2]  = request.security(syminfo.tickerid, "60",  [last_sig_dir, last_sig_str, last_sig_sl, last_sig_tp1, last_sig_tp2], lookahead=barmerge.lookahead_off)
[r_h4_dir,  r_h4_str,  r_h4_sl,  r_h4_tp1,  r_h4_tp2]  = request.security(syminfo.tickerid, "240", [last_sig_dir, last_sig_str, last_sig_sl, last_sig_tp1, last_sig_tp2], lookahead=barmerge.lookahead_off)
[r_d1_dir,  r_d1_str,  r_d1_sl,  r_d1_tp1,  r_d1_tp2]  = request.security(syminfo.tickerid, "D",   [last_sig_dir, last_sig_str, last_sig_sl, last_sig_tp1, last_sig_tp2], lookahead=barmerge.lookahead_off)

int r_m1_ago  = request.security(syminfo.tickerid, "1",   ta.barssince(is_new_signal), lookahead=barmerge.lookahead_off)
int r_m5_ago  = request.security(syminfo.tickerid, "5",   ta.barssince(is_new_signal), lookahead=barmerge.lookahead_off)
int r_m15_ago = request.security(syminfo.tickerid, "15",  ta.barssince(is_new_signal), lookahead=barmerge.lookahead_off)
int r_m30_ago = request.security(syminfo.tickerid, "30",  ta.barssince(is_new_signal), lookahead=barmerge.lookahead_off)
int r_h1_ago  = request.security(syminfo.tickerid, "60",  ta.barssince(is_new_signal), lookahead=barmerge.lookahead_off)
int r_h4_ago  = request.security(syminfo.tickerid, "240", ta.barssince(is_new_signal), lookahead=barmerge.lookahead_off)
int r_d1_ago  = request.security(syminfo.tickerid, "D",   ta.barssince(is_new_signal), lookahead=barmerge.lookahead_off)

// Dashboard drawing
f_dcol(d)  => d == 1 ? C_TEAL : d == -1 ? C_RED : C_GREY
f_dbg(d)   => d == 1 ? color.new(#004d40, 60) : d == -1 ? color.new(#4a148c, 60) : color.new(#1a1f2e, 80)
f_dtxt(d)  => d == 1 ? "BUY" : d == -1 ? "SELL" : "--"
f_scol(s)  => s >= 8.0 ? C_GOLD : s >= 6.0 ? C_WHITE : C_GREY

f_row(tbl, row, tf, d, sv, sl, tp1, tp2, ago, alt) =>
    bg   = alt ? C_DASH_ALT : C_DASH_ROW
    dsz  = f_sz(i_dashSize)
    stxt = d != 0 ? str.tostring(sv, "#.0") + "/10" : "--"
    sltx = d != 0 and not na(sl)  ? f_p(sl)  : "--"
    t1tx = d != 0 and not na(tp1) ? f_p(tp1) : "--"
    t2tx = d != 0 and not na(tp2) ? f_p(tp2) : "--"
    agtx = d != 0 ? str.tostring(ago) + "b" : "--"
    table.cell(tbl, 0, row, tf,         bgcolor=bg,       text_color=C_WHITE,     text_size=dsz, text_halign=text.align_center)
    table.cell(tbl, 1, row, f_dtxt(d),  bgcolor=f_dbg(d), text_color=f_dcol(d),   text_size=dsz, text_halign=text.align_center)
    table.cell(tbl, 2, row, stxt,       bgcolor=bg,       text_color=f_scol(sv),  text_size=dsz, text_halign=text.align_center)
    table.cell(tbl, 3, row, sltx,       bgcolor=bg,       text_color=#EF9A9A,     text_size=dsz, text_halign=text.align_center)
    table.cell(tbl, 4, row, t1tx,       bgcolor=bg,       text_color=C_TP1,       text_size=dsz, text_halign=text.align_center)
    table.cell(tbl, 5, row, t2tx,       bgcolor=bg,       text_color=C_TP2,       text_size=dsz, text_halign=text.align_center)
    table.cell(tbl, 6, row, agtx,       bgcolor=bg,       text_color=C_GREY,      text_size=dsz, text_halign=text.align_center)

var table dash = na
if i_showDash and barstate.islast
    if not na(dash)
        table.delete(dash)
    dash := table.new(position.top_right, 7, 9, bgcolor=C_DASH_BG, border_color=C_DASH_BDR, border_width=1, frame_color=C_GOLD, frame_width=2)
    hsz = f_sz(i_dashSize)
    table.cell(dash, 0, 0, "STRONG PINBAR REVERSALS MTF", bgcolor=C_DASH_HDR, text_color=C_GOLD,  text_size=hsz, text_halign=text.align_center)
    for c = 1 to 6
        table.cell(dash, c, 0, "", bgcolor=C_DASH_HDR)
    table.cell(dash, 0, 1, "TF",     bgcolor=C_DASH_HDR, text_color=C_GOLD, text_size=hsz, text_halign=text.align_center)
    table.cell(dash, 1, 1, "SIGNAL", bgcolor=C_DASH_HDR, text_color=C_GOLD, text_size=hsz, text_halign=text.align_center)
    table.cell(dash, 2, 1, "STR",    bgcolor=C_DASH_HDR, text_color=C_GOLD, text_size=hsz, text_halign=text.align_center)
    table.cell(dash, 3, 1, "SL",     bgcolor=C_DASH_HDR, text_color=C_GOLD, text_size=hsz, text_halign=text.align_center)
    table.cell(dash, 4, 1, "TP1",    bgcolor=C_DASH_HDR, text_color=C_GOLD, text_size=hsz, text_halign=text.align_center)
    table.cell(dash, 5, 1, "TP2",    bgcolor=C_DASH_HDR, text_color=C_GOLD, text_size=hsz, text_halign=text.align_center)
    table.cell(dash, 6, 1, "AGO",    bgcolor=C_DASH_HDR, text_color=C_GOLD, text_size=hsz, text_halign=text.align_center)
    f_row(dash, 2, "M1",  r_m1_dir,  r_m1_str,  r_m1_sl,  r_m1_tp1,  r_m1_tp2,  r_m1_ago,  false)
    f_row(dash, 3, "M5",  r_m5_dir,  r_m5_str,  r_m5_sl,  r_m5_tp1,  r_m5_tp2,  r_m5_ago,  true)
    f_row(dash, 4, "M15", r_m15_dir, r_m15_str, r_m15_sl, r_m15_tp1, r_m15_tp2, r_m15_ago, false)
    f_row(dash, 5, "M30", r_m30_dir, r_m30_str, r_m30_sl, r_m30_tp1, r_m30_tp2, r_m30_ago, true)
    f_row(dash, 6, "H1",  r_h1_dir,  r_h1_str,  r_h1_sl,  r_h1_tp1,  r_h1_tp2,  r_h1_ago,  false)
    f_row(dash, 7, "H4",  r_h4_dir,  r_h4_str,  r_h4_sl,  r_h4_tp1,  r_h4_tp2,  r_h4_ago,  true)
    f_row(dash, 8, "D1",  r_d1_dir,  r_d1_str,  r_d1_sl,  r_d1_tp1,  r_d1_tp2,  r_d1_ago,  false)
