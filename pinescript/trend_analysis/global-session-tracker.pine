//@version=6
indicator('Global Session Tracker', overlay = true)
show_table = input.bool(true, "Show Session Dashboard", group = "Global Settings")
// --- Input Section ---
tz = input.string('UTC', 'Base Timezone', group = 'Global Settings')

// Session Inputs
show_syd = input.bool(true, '', inline = 'syd', group = 'Sydney Session')
syd_sess = input.session('2200-0700', 'Sydney Time', inline = 'syd', group = 'Sydney Session')
syd_col = input.color(color.new(color.blue, 60), '', inline = 'syd', group = 'Sydney Session')
show_tok = input.bool(true, '', inline = 'tok', group = 'Tokyo Session')
tok_sess = input.session('0000-0900', 'Tokyo Time', inline = 'tok', group = 'Tokyo Session')
tok_col = input.color(color.new(color.red, 60), '', inline = 'tok', group = 'Tokyo Session')
show_lon = input.bool(true, '', inline = 'lon', group = 'London Session')
lon_sess = input.session('0800-1700', 'London Time', inline = 'lon', group = 'London Session')
lon_col = input.color(color.new(color.orange, 60), '', inline = 'lon', group = 'London Session')
show_ny = input.bool(true, '', inline = 'ny', group = 'New York Session')
ny_sess = input.session('1300-2200', 'NY Time', inline = 'ny', group = 'New York Session')
ny_col = input.color(color.new(color.green, 60), '', inline = 'ny', group = 'New York Session')
show_cus = input.bool(true, '', inline = 'cus', group = 'Custom Session')
cus_sess = input.session('1200-1500', 'Custom Time', inline = 'cus', group = 'Custom Session')
cus_col = input.color(color.new(color.purple, 60), '', inline = 'cus', group = 'Custom Session')

// --- Function to Track Session Data & Breakouts ---
fn_session_data(show, sess_spec, timezone) =>
    in_sess = show and not na(time(timeframe.period, sess_spec, timezone))
    is_new = in_sess and not in_sess[1]

    var float sO = na
    var float sH = na
    var float sL = na
    var float sC = na

    var bool high_already_broken = false
    var bool low_already_broken = false

    bool high_break_signal = false
    bool low_break_signal = false

    if is_new
        sO := open
        sH := high
        sL := low
        sC := close
        high_already_broken := false
        low_already_broken := false
        low_already_broken
    else if in_sess
        // VERIFIED: Upside Breakout Logic
        if high > sH and not high_already_broken
            high_break_signal := true
            high_already_broken := true
            high_already_broken

        // VERIFIED: Downside Breakout Logic
        if low < sL and not low_already_broken
            low_break_signal := true
            low_already_broken := true
            low_already_broken

        sO := sO
        sH := sH
        sL := sL
        sC := sC
        sC
    else
        sO := na
        sH := na
        sL := na
        sC := na
        sC

    [sO, sH, sL, sC, in_sess, is_new, high_break_signal, low_break_signal]

// --- Logic Execution ---
[sydO, sydH, sydL, sydC, sydIn, sydStart, sydHB, sydLB] = fn_session_data(show_syd, syd_sess, tz)
[tokO, tokH, tokL, tokC, tokIn, tokStart, tokHB, tokLB] = fn_session_data(show_tok, tok_sess, tz)
[lonO, lonH, lonL, lonC, lonIn, lonStart, lonHB, lonLB] = fn_session_data(show_lon, lon_sess, tz)
[nyO, nyH, nyL, nyC, nyIn, nyStart, nyHB, nyLB] = fn_session_data(show_ny, ny_sess, tz)
[cusO, cusH, cusL, cusC, cusIn, cusStart, cusHB, cusLB] = fn_session_data(show_cus, cus_sess, tz)

// --- Plotting Constant Range ---
plotcandle(sydO, sydH, sydL, sydC, 'Sydney Range', color = syd_col, wickcolor = syd_col)
plotcandle(tokO, tokH, tokL, tokC, 'Tokyo Range', color = tok_col, wickcolor = tok_col)
plotcandle(lonO, lonH, lonL, lonC, 'London Range', color = lon_col, wickcolor = lon_col)
plotcandle(nyO, nyH, nyL, nyC, 'NY Range', color = ny_col, wickcolor = ny_col)
plotcandle(cusO, cusH, cusL, cusC, 'Custom Range', color = cus_col, wickcolor = cus_col)

// --- Session Start Identifiers ---
plotshape(sydStart, 'SYD Start', shape.triangleup, location.belowbar, syd_col, text = 'SYD Open', textcolor = syd_col, size = size.small)
plotshape(tokStart, 'TOK Start', shape.triangleup, location.belowbar, tok_col, text = 'TOK Open', textcolor = tok_col, size = size.small)
plotshape(lonStart, 'LON Start', shape.triangleup, location.belowbar, lon_col, text = 'LON Open', textcolor = lon_col, size = size.small)
plotshape(nyStart, 'NY Start', shape.triangleup, location.belowbar, ny_col, text = 'NY Open', textcolor = ny_col, size = size.small)
plotshape(cusStart, 'CUS Start', shape.triangleup, location.belowbar, cus_col, text = 'Open', textcolor = cus_col, size = size.small)

// --- VERIFIED BREAKOUT CIRCLES ---
any_high_break = sydHB or tokHB or lonHB or nyHB or cusHB
any_low_break = sydLB or tokLB or lonLB or nyLB or cusLB

// Upside Break = Blue Circle BELOW bar
plotshape(any_high_break, 'High Break', shape.circle, location.belowbar, color.new(color.blue, 0), size = size.tiny)
// Downside Break = Red Circle ABOVE bar
plotshape(any_low_break, 'Low Break', shape.circle, location.abovebar, color.new(color.red, 0), size = size.tiny)

// --- Alert Conditions ---
alertcondition(any_high_break, 'Session High Broken', 'Price has broken the session high!')
alertcondition(any_low_break, 'Session Low Broken', 'Price has broken the session low!')

// --- Live Price Labels ---
update_session_lb(show_toggle, active, price, txt, clr, lbl, offset_multiplier) =>
    if barstate.islast
        if show_toggle and active
            float nudge = ta.atr(14) * 0.4 * offset_multiplier
            label.set_xy(lbl, bar_index + 2, price + nudge)
            label.set_text(lbl, txt)
            label.set_color(lbl, clr)
            label.set_style(lbl, label.style_label_left)
            label.delete(lbl[1])
        else
            label.set_style(lbl, label.style_none)
            label.set_text(lbl, '')

lb_syd = label.new(na, na, '', textcolor = color.white)
lb_tok = label.new(na, na, '', textcolor = color.white)
lb_lon = label.new(na, na, '', textcolor = color.white)
lb_ny = label.new(na, na, '', textcolor = color.white)
lb_cus = label.new(na, na, '', textcolor = color.white)

update_session_lb(show_syd, sydIn, sydC, 'Sydney', syd_col, lb_syd, 0)
update_session_lb(show_tok, tokIn, tokC, 'Tokyo', tok_col, lb_tok, 1)
update_session_lb(show_lon, lonIn, lonC, 'London', lon_col, lb_lon, 2)
update_session_lb(show_ny, nyIn, nyC, 'New York', ny_col, lb_ny, 3)
update_session_lb(show_cus, cusIn, cusC, 'Custom', cus_col, lb_cus, 4)



// --- Helper Function (Paste this above the table) ---
f_fill_row(tbl, row, name, o, h, l, c, clr) =>
    table.cell(tbl, 0, row, name, bgcolor=clr, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, row, na(o) ? "-" : str.tostring(o, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(tbl, 2, row, na(h) ? "-" : str.tostring(h, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(tbl, 3, row, na(l) ? "-" : str.tostring(l, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(tbl, 4, row, na(c) ? "-" : str.tostring(c, format.mintick), text_color=color.white, text_size=size.small)

// --- DASHBOARD TABLE ---
var table dash = table.new(position.top_right, 5, 6, bgcolor=color.new(color.black, 70), border_color=color.gray, border_width=1)

if show_table and barstate.islast
    table.cell(dash, 0, 0, "Session", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, "Open",    text_color=color.white, text_size=size.small)
    table.cell(dash, 2, 0, "High",    text_color=color.white, text_size=size.small)
    table.cell(dash, 3, 0, "Low",     text_color=color.white, text_size=size.small)
    table.cell(dash, 4, 0, "Close",   text_color=color.white, text_size=size.small)

    f_fill_row(dash, 1, "Sydney", sydO, sydH, sydL, sydC, syd_col)
    f_fill_row(dash, 2, "Tokyo",  tokO, tokH, tokL, tokC, tok_col)
    f_fill_row(dash, 3, "London", lonO, lonH, lonL, lonC, lon_col)
    f_fill_row(dash, 4, "NY",     nyO,  nyH,  nyL,  nyC,  ny_col)
    f_fill_row(dash, 5, "Custom", cusO, cusH, cusL, cusC, cus_col)
