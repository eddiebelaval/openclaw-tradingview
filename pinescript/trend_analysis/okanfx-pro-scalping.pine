            if kzShowLines
                if kzExtendPivots == "Sonraki Seansa Kadar"
                    if not na(nyLunchPivotH)
                        line.delete(nyLunchPivotH)
                    if not na(nyLunchPivotL)
                        line.delete(nyLunchPivotL)
                    if not na(nyLunchPivotHLbl)
                        label.delete(nyLunchPivotHLbl)
                    if not na(nyLunchPivotLLbl)
