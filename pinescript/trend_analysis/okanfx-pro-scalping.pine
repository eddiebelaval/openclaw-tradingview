premColor        = input.color(color.new(color.red, 93), "Premium Rengi", group=grp_ict)
discColor        = input.color(color.new(color.green, 93), "Discount Rengi", group=grp_ict)
showUnicorn      = input.bool(true, "Unicorn Model", tooltip="Breaker Block + FVG cakismasi (guclu giris)", group=grp_ict)
