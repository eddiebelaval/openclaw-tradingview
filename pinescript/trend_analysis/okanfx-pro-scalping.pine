                box.set_bottom(nyLunchBgBox, nyLunchLow)
                box.set_right(nyLunchBgBox, bar_index)
            if kzShowLabels and not na(nyLunchNameLbl)
                label.set_y(nyLunchNameLbl, nyLunchHigh)
            if kzShowLines
                if not na(nyLunchPivotH)
                    line.set_y1(nyLunchPivotH, nyLunchHigh)
                    line.set_y2(nyLunchPivotH, nyLunchHigh)
                    line.set_x2(nyLunchPivotH, bar_index)
                if not na(nyLunchPivotL)
                    line.set_y1(nyLunchPivotL, nyLunchLow)
                    line.set_y2(nyLunchPivotL, nyLunchLow)
                    line.set_x2(nyLunchPivotL, bar_index)
                if not na(nyLunchPivotHLbl)
                    label.set_y(nyLunchPivotHLbl, nyLunchHigh)
                    label.set_x(nyLunchPivotHLbl, bar_index)
                if not na(nyLunchPivotLLbl)
                    label.set_y(nyLunchPivotLLbl, nyLunchLow)
                    label.set_x(nyLunchPivotLLbl, bar_index)
            if kzShowMean and not na(nyLunchMidLine)
                nyLunchMid = (nyLunchHigh + nz(nyLunchLow)) / 2
                line.set_y1(nyLunchMidLine, nyLunchMid)
                line.set_y2(nyLunchMidLine, nyLunchMid)
                line.set_x2(nyLunchMidLine, bar_index)
    else
        if kzShowLines
            if not nyLunchHMitigated and not na(nyLunchPivotH)
                line.set_x2(nyLunchPivotH, bar_index)
            if not nyLunchHMitigated and not na(nyLunchPivotHLbl)
                label.set_x(nyLunchPivotHLbl, bar_index)
            if not nyLunchLMitigated and not na(nyLunchPivotL)
                line.set_x2(nyLunchPivotL, bar_index)
            if not nyLunchLMitigated and not na(nyLunchPivotLLbl)
                label.set_x(nyLunchPivotLLbl, bar_index)
        if kzShowMean and not na(nyLunchMidLine) and not nyLunchHMitigated and not nyLunchLMitigated
            line.set_x2(nyLunchMidLine, bar_index)
        if kzStopMitigated and kzShowLines
            if not nyLunchHMitigated and not na(nyLunchPivotH) and not na(nyLunchHigh) and close > nyLunchHigh
                nyLunchHMitigated := true
            if not nyLunchLMitigated and not na(nyLunchPivotL) and not na(nyLunchLow) and close < nyLunchLow
                nyLunchLMitigated := true
    prevNYLunch := isNYLunchKZ

