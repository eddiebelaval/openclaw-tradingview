                nyLunchPivotH := line.new(bar_index, high, bar_index, high, color=color.new(nyLunchColor, 0), style=kzPivotLineStyle, width=vizKzLineWidth)
                nyLunchPivotL := line.new(bar_index, low, bar_index, low, color=color.new(nyLunchColor, 0), style=kzPivotLineStyle, width=vizKzLineWidth)
                nyLunchPivotHLbl := label.new(bar_index, high, kzLbl4H, color=color.new(color.white, 100), textcolor=color.new(nyLunchColor, 0), style=label.style_label_left, size=vizKzLblSz)
                nyLunchPivotLLbl := label.new(bar_index, low, kzLbl4L, color=color.new(color.white, 100), textcolor=color.new(nyLunchColor, 0), style=label.style_label_left, size=vizKzLblSz)
            if kzShowMean
                if kzExtendPivots == "Sonraki Seansa Kadar" and not na(nyLunchMidLine)
                    line.delete(nyLunchMidLine)
                nyLunchMidLine := line.new(bar_index, (high + low) / 2, bar_index, (high + low) / 2, color=color.new(nyLunchColor, 30), style=kzMidLineStyle, width=vizKzLineWidth)
        else
