//@version=5
indicator("OKANFX-PRO SCALPING", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ============================================================================
// KULLANICI AYARLARI
// ============================================================================

// --- Genel Ayarlar ---
grp_general = "Genel Ayarlar"
showDashboard     = input.bool(true, "Dashboard Tablosu Goster", group=grp_general)
dashboardPosition = input.string("Sag Ust", "Dashboard Pozisyonu", options=["Sol Ust", "Sag Ust", "Sol Alt", "Sag Alt"], group=grp_general)
dashboardSize     = input.string("tiny", "Dashboard Boyutu", options=["tiny", "small", "normal", "large"], group=grp_general)

// --- Gorsel Ayarlar ---
grp_visual = "Gorsel Ayarlar"
vizLabelSize   = input.string("Normal", "Etiket Boyutu", options=["Cok Kucuk", "Kucuk", "Normal", "Buyuk", "Cok Buyuk"], tooltip="Tum etiketlerin boyutu (CHoCH, BOS, LIQ, EQH, Fib, vb.)", group=grp_visual)
vizBoxTextSize = input.string("Normal", "Kutu Yazi Boyutu", options=["Cok Kucuk", "Kucuk", "Normal", "Buyuk", "Cok Buyuk"], tooltip="Kutu icindeki yazilar (OB, FVG, BB, DZ, SZ, OTE)", group=grp_visual)
vizKzLabelSize = input.string("Normal", "Killzone Etiket Boyutu", options=["Cok Kucuk", "Kucuk", "Normal", "Buyuk", "Cok Buyuk"], tooltip="Killzone isim etiketleri", group=grp_visual)
vizLineWidth   = input.int(2, "Genel Cizgi Kalinligi", minval=1, maxval=5, tooltip="LIQ, EQH/EQL, Divergence, Killzone cizgileri", group=grp_visual)
vizBoxBorder   = input.int(2, "Kutu Kenarlik Kalinligi", minval=1, maxval=5, tooltip="OB, FVG, BB, DZ, SZ kutu kenarliklari", group=grp_visual)
vizKzLineWidth = input.int(2, "Killzone Cizgi Kalinligi", minval=1, maxval=5, tooltip="Killzone top/bottom/mean cizgileri", group=grp_visual)

// --- EMA Ayarlari (elle deger girilebilir) ---
grp_ema = "EMA Ayarlari"
showEMA1  = input.bool(true, "EMA 1 Goster", group=grp_ema)
showEMA2  = input.bool(true, "EMA 2 Goster", group=grp_ema)
showEMA3  = input.bool(true, "EMA 3 Goster", group=grp_ema)
showEMA4  = input.bool(true, "EMA 4 Goster", group=grp_ema)
emaLen1   = input.int(20, "EMA 1 Periyodu", minval=1, maxval=500, group=grp_ema)
emaLen2   = input.int(50, "EMA 2 Periyodu", minval=1, maxval=500, group=grp_ema)
emaLen3   = input.int(100, "EMA 3 Periyodu", minval=1, maxval=500, group=grp_ema)
emaLen4   = input.int(200, "EMA 4 Periyodu", minval=1, maxval=500, group=grp_ema)
emaColor1 = input.color(color.new(color.yellow, 0), "EMA 1 Rengi", group=grp_ema)
emaColor2 = input.color(color.new(color.blue, 0), "EMA 2 Rengi", group=grp_ema)
emaColor3 = input.color(color.new(color.green, 0), "EMA 3 Rengi", group=grp_ema)
emaColor4 = input.color(color.new(color.red, 0), "EMA 4 Rengi", group=grp_ema)
emaWidth1 = input.int(1, "EMA 1 Kalinligi", minval=1, maxval=5, group=grp_ema)
emaWidth2 = input.int(1, "EMA 2 Kalinligi", minval=1, maxval=5, group=grp_ema)
emaWidth3 = input.int(2, "EMA 3 Kalinligi", minval=1, maxval=5, group=grp_ema)
emaWidth4 = input.int(2, "EMA 4 Kalinligi", minval=1, maxval=5, group=grp_ema)

// --- RSI Ayarlari ---
grp_rsi = "RSI Ayarlari"
rsiLength     = input.int(14, "RSI Periyodu", group=grp_rsi)
rsiOverbought = input.int(70, "RSI Asiri Alim", group=grp_rsi)
rsiOversold   = input.int(30, "RSI Asiri Satim", group=grp_rsi)
showRSIDivergence = input.bool(true, "RSI Divergence Goster", group=grp_rsi)
divLookback   = input.int(20, "Divergence Lookback", minval=5, maxval=50, group=grp_rsi)

// --- Order Block Ayarlari ---
grp_ob = "Order Block Ayarlari"
showOB        = input.bool(true, "Order Block Goster", group=grp_ob)
obStrength    = input.int(3, "OB Guc Filtresi (mum sayisi)", minval=1, maxval=10, tooltip="Order Block oncesinde kac mum ayni yonde olmali", group=grp_ob)
obMitigated   = input.bool(true, "Mitigate Olan OB/BB Gizle", group=grp_ob)
obMitPrice    = input.string("Fitil", "Mitigation Fiyati", options=["Fitil", "Kapanis"], tooltip="OB mitigation icin fitil mi kapanis mi kullanilsin", group=grp_ob)
obExtend      = input.bool(true, "OB/BB Kutularini Uzat", tooltip="Kutulari saga dogru uzat", group=grp_ob)
obMaxBoxes    = input.int(5, "Maksimum OB Sayisi", minval=1, maxval=50, group=grp_ob)
obBullColor   = input.color(color.new(color.green, 80), "Bullish OB Rengi", group=grp_ob)
obBearColor   = input.color(color.new(color.red, 80), "Bearish OB Rengi", group=grp_ob)
// --- FVG Ayarlari ---
grp_fvg = "FVG (Fair Value Gap) Ayarlari"
showFVG      = input.bool(true, "FVG Goster", group=grp_fvg)
fvgWidthFilter = input.float(0.0, "FVG Genislik Filtresi", minval=0.0, maxval=10.0, step=0.1, tooltip="ATR carpani olarak minimum FVG genisligi (0=filtre yok)", group=grp_fvg)
fvgMaxBoxes  = input.int(10, "Maksimum FVG Sayisi", minval=1, maxval=50, group=grp_fvg)
fvgBullColor = input.color(color.new(color.teal, 85), "Bullish FVG Rengi", group=grp_fvg)
fvgBearColor = input.color(color.new(color.maroon, 85), "Bearish FVG Rengi", group=grp_fvg)
fvgMitigated = input.bool(true, "Mitigate Olan FVG Gizle", group=grp_fvg)
fvgExtend    = input.bool(true, "FVG Kutularini Uzat", tooltip="FVG kutularini saga dogru uzat", group=grp_fvg)
// --- Likidite Bolgeleri ---
grp_liq = "Likidite Bolgeleri"
showLiquidity    = input.bool(true, "Likidite Bolgelerini Goster", group=grp_liq)
liqLookback      = input.int(50, "Lookback Periyodu", minval=10, maxval=200, group=grp_liq)
liqTouchCount    = input.int(2, "Minimum Temas Sayisi", minval=2, maxval=10, tooltip="Ayni seviyeye kac kez temas edilmis olmali", group=grp_liq)
liqTolerance     = input.float(0.001, "Tolerans (%)", step=0.0005, tooltip="Fiyat eslesme toleransi (yuzde olarak)", group=grp_liq)
liqHighColor     = input.color(color.new(color.red, 60), "Ust Likidite Rengi", group=grp_liq)
liqLowColor      = input.color(color.new(color.green, 60), "Alt Likidite Rengi", group=grp_liq)
liqMaxLines      = input.int(5, "Maksimum Likidite Cizgisi", minval=1, maxval=20, group=grp_liq)

// --- HTF High/Low Cizgileri ---
grp_htf = "Yuksek Zaman Dilimi High/Low"
showDailyHL = input.bool(true, "Onceki Gun High/Low Goster", group=grp_htf)
show4HHL    = input.bool(true, "Onceki 4S Mum High/Low Goster", group=grp_htf)
show1HHL    = input.bool(true, "Onceki 1S Mum High/Low Goster", group=grp_htf)
dailyHColor = input.color(color.new(color.orange, 30), "Gunluk Cizgi Rengi", group=grp_htf)
h4HColor    = input.color(color.new(color.blue, 30), "4S Cizgi Rengi", group=grp_htf)
h1HColor    = input.color(color.new(color.purple, 30), "1S Cizgi Rengi", group=grp_htf)
htfLineWidth = input.int(2, "HTF Cizgi Kalinligi", minval=1, maxval=5, group=grp_htf)
htfLineStyle = input.string("Kesikli", "HTF Cizgi Stili", options=["Solid", "Kesikli", "Noktali"], group=grp_htf)

// --- Market Structure (BOS/CHoCH) Ayarlari ---
grp_ms = "Market Structure (BOS/CHoCH)"
showMS          = input.bool(true, "Market Structure Goster", group=grp_ms)
msLookback      = input.int(20, "Swing Lookback", minval=3, maxval=50, tooltip="Swing High/Low tespiti icin kac mum geriye baksin", group=grp_ms)
msBOSColor      = input.color(color.new(color.blue, 30), "BOS Rengi", group=grp_ms)
msCHoCHColor    = input.color(color.new(color.orange, 30), "CHoCH Rengi", group=grp_ms)
msLineWidth     = input.int(2, "Yapi Cizgi Kalinligi", minval=1, maxval=3, group=grp_ms)

// --- Fibonacci Retracement Ayarlari ---
grp_fib = "Fibonacci Retracement"
showFib         = input.bool(true, "Fibonacci Goster", group=grp_fib)
fibSource       = input.string("Gunluk", "Fibonacci Kaynak TF", options=["Haftalik", "Gunluk", "4 Saat", "1 Saat"], group=grp_fib)
fibReverse      = input.bool(false, "Fibonacci Ters Ciz", tooltip="Fibi ters cevirir (High->Low yerine Low->High)", group=grp_fib)
fibColor        = input.color(color.new(color.yellow, 40), "Fibonacci Rengi", group=grp_fib)
fibLvl1         = input.float(0.236, "Fib Seviye 1", step=0.001, group=grp_fib)
fibLvl2         = input.float(0.382, "Fib Seviye 2", step=0.001, group=grp_fib)
fibLvl3         = input.float(0.500, "Fib Seviye 3", step=0.001, group=grp_fib)
fibLvl4         = input.float(0.618, "Fib Seviye 4", step=0.001, group=grp_fib)
fibLvl5         = input.float(0.786, "Fib Seviye 5", step=0.001, group=grp_fib)
fibLvl6         = input.float(1.618, "Fib Seviye 6 (0=kapali)", step=0.001, tooltip="0 yaparak kapatabilirsiniz", group=grp_fib)
fibLvl7         = input.float(2.618, "Fib Seviye 7 (0=kapali)", step=0.001, tooltip="0 yaparak kapatabilirsiniz", group=grp_fib)
fibLvl8         = input.float(0.0, "Fib Seviye 8 (0=kapali)", step=0.001, tooltip="Ornek: 3.618, 4.236 vb.", group=grp_fib)

// --- Equal Highs/Lows Ayarlari ---
grp_eql = "Equal Highs/Lows"
showEQL         = input.bool(true, "Equal Highs/Lows Goster", group=grp_eql)
eqlLookback     = input.int(30, "Lookback Periyodu", minval=5, maxval=100, group=grp_eql)
eqlTolerance    = input.float(0.001, "Tolerans (%)", step=0.0005, tooltip="Esit seviye toleransi", group=grp_eql)
