// --- Arka Plan Ayarlari ---
grp_bg = "Arka Plan Ayarlari"
showTrendBg      = input.bool(false, "Trend Arka Plan", tooltip="Genel trend yonune gore arka plan rengi", group=grp_bg)

// --- ICT Strateji Ayarlari ---
grp_ict = "ICT Strateji Ayarlari"
showOTE          = input.bool(true, "OTE Bolgesi", tooltip="Optimal Trade Entry bolgesi", group=grp_ict)
oteFibTop        = input.float(0.618, "OTE Ust Fib Degeri", minval=0.0, maxval=1.0, step=0.001, tooltip="OTE bolgesinin ust siniri (varsayilan 0.618)", group=grp_ict)
oteFibBot        = input.float(0.786, "OTE Alt Fib Degeri", minval=0.0, maxval=1.0, step=0.001, tooltip="OTE bolgesinin alt siniri (varsayilan 0.786)", group=grp_ict)
oteColor         = input.color(color.new(color.orange, 75), "OTE Rengi", group=grp_ict)
