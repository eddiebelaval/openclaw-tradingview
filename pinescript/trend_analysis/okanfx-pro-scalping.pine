eqlHighColor    = input.color(color.new(color.red, 40), "Equal Highs Rengi", group=grp_eql)
eqlLowColor     = input.color(color.new(color.green, 40), "Equal Lows Rengi", group=grp_eql)

// --- Demand/Supply Zone Ayarlari ---
grp_dz = "Demand/Supply Zone Ayarlari"
