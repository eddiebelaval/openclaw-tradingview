svwapNYStart     = input.string("13:30", "NY Seans Baslangic", tooltip="Tam NY seansi (KZ degil)", group=grp_svwap)
svwapNYEnd       = input.string("21:00", "NY Seans Bitis", group=grp_svwap)
svwapLondonColor = input.color(color.new(color.teal, 0), "London VWAP Rengi", group=grp_svwap)
svwapNYColor     = input.color(color.new(color.orange, 0), "NY VWAP Rengi", group=grp_svwap)
svwapWidth       = input.int(2, "VWAP Kalinligi", minval=1, maxval=5, group=grp_svwap)

// --- HTF Mum Overlay ---
grp_htfc = "HTF Mum Overlay"
showHTFCandle      = input.bool(false, "HTF Mum Goster", group=grp_htfc)
htfCandleTF        = input.string("4 Saat", "HTF Mum TF", options=["Haftalik", "Gunluk", "4 Saat", "1 Saat"], group=grp_htfc)
htfCandleBullColor = input.color(color.new(color.green, 88), "HTF Bullish Rengi", group=grp_htfc)
htfCandleBearColor = input.color(color.new(color.red, 88), "HTF Bearish Rengi", group=grp_htfc)

// --- Pivot Noktalari ---
grp_pivot = "Pivot Noktalari"
showPivots   = input.bool(false, "Pivot Goster", group=grp_pivot)
pivotType    = input.string("Klasik", "Pivot Tipi", options=["Klasik", "Fibonacci", "Camarilla"], group=grp_pivot)
pivotColor   = input.color(color.new(color.yellow, 30), "Pivot (PP) Rengi", group=grp_pivot)
pivotSColor  = input.color(color.new(color.green, 30), "Destek Rengi (S1-S3)", group=grp_pivot)
pivotRColor  = input.color(color.new(color.red, 30), "Direnc Rengi (R1-R3)", group=grp_pivot)
pivotWidth   = input.int(1, "Pivot Kalinligi", minval=1, maxval=3, group=grp_pivot)

// ============================================================================
// MEVCUT ZAMAN DILIMI HESAPLAMALARI (Global scope)
// ============================================================================


// Boyut donusturucu fonksiyonlar
getLabelSize(s) =>
    s == "Cok Kucuk" ? size.tiny : s == "Kucuk" ? size.small : s == "Buyuk" ? size.large : s == "Cok Buyuk" ? size.huge : size.normal

vizLblSz    = getLabelSize(vizLabelSize)
vizBoxTxtSz = getLabelSize(vizBoxTextSize)
vizKzLblSz  = getLabelSize(vizKzLabelSize)

ema1  = ta.ema(close, emaLen1)
ema2  = ta.ema(close, emaLen2)
ema3  = ta.ema(close, emaLen3)
ema4  = ta.ema(close, emaLen4)

plot(showEMA1 ? ema1 : na, "EMA 1", color=emaColor1, linewidth=emaWidth1)
plot(showEMA2 ? ema2 : na, "EMA 2", color=emaColor2, linewidth=emaWidth2)
plot(showEMA3 ? ema3 : na, "EMA 3", color=emaColor3, linewidth=emaWidth3)
plot(showEMA4 ? ema4 : na, "EMA 4", color=emaColor4, linewidth=emaWidth4)

// HTF cizgi stili donusumu
htfLStyle = htfLineStyle == "Solid" ? line.style_solid : htfLineStyle == "Kesikli" ? line.style_dashed : line.style_dotted

rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

// OB icin global scope'da hesapla
obBodySize = math.abs(close - open)
obAvgBody  = ta.sma(obBodySize, 20)

// RSI Divergence icin global scope'da hesapla
pivotHighPrice = ta.pivothigh(high, divLookback, divLookback)
pivotLowPrice  = ta.pivotlow(low, divLookback, divLookback)
pivotHighRSI   = ta.pivothigh(rsiValue, divLookback, divLookback)
pivotLowRSI    = ta.pivotlow(rsiValue, divLookback, divLookback)

// MTF icin onceden hesaplanan degerler (kullanici ayarlarindan)
_rsi    = ta.rsi(close, rsiLength)
_ema20  = ta.ema(close, emaLen1)
_ema50  = ta.ema(close, emaLen2)
_ema100 = ta.ema(close, emaLen3)
_ema200 = ta.ema(close, emaLen4)
_volSMA = ta.sma(volume, 20)
_atr    = ta.atr(atrLength)

// VWAP
vwapValue = ta.vwap(hlc3)
plot(showVWAP ? vwapValue : na, "VWAP", color=vwapColor, linewidth=2, style=plot.style_line)

// ============================================================================
// MULTI-TIMEFRAME VERI CEKIMI
// ============================================================================

[dailyHigh, dailyLow, dailyClose, dailyOpen, dailyRSI, dailyEma20, dailyEma50] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1], open[1], _rsi[1], _ema20[1], _ema50[1]], lookahead=barmerge.lookahead_on)
[dailyEma100, dailyEma200, dailyVol, dailyVolSMA, dailyATR] = request.security(syminfo.tickerid, "D", [_ema100[1], _ema200[1], volume[1], _volSMA[1], _atr[1]], lookahead=barmerge.lookahead_on)

[h4High, h4Low, h4Close, h4Open, h4RSI, h4Ema20, h4Ema50] = request.security(syminfo.tickerid, "240", [high[1], low[1], close[1], open[1], _rsi[1], _ema20[1], _ema50[1]], lookahead=barmerge.lookahead_on)
[h4Ema100, h4Ema200, h4Vol, h4VolSMA, h4ATR] = request.security(syminfo.tickerid, "240", [_ema100[1], _ema200[1], volume[1], _volSMA[1], _atr[1]], lookahead=barmerge.lookahead_on)

[h1High, h1Low, h1Close, h1Open, h1RSI, h1Ema20, h1Ema50] = request.security(syminfo.tickerid, "60", [high[1], low[1], close[1], open[1], _rsi[1], _ema20[1], _ema50[1]], lookahead=barmerge.lookahead_on)
[h1Ema100, h1Ema200, h1Vol, h1VolSMA, h1ATR] = request.security(syminfo.tickerid, "60", [_ema100[1], _ema200[1], volume[1], _volSMA[1], _atr[1]], lookahead=barmerge.lookahead_on)

[m15High, m15Low, m15Close, m15Open, m15RSI, m15Ema20, m15Ema50] = request.security(syminfo.tickerid, "15", [high[1], low[1], close[1], open[1], _rsi[1], _ema20[1], _ema50[1]], lookahead=barmerge.lookahead_on)
[m15Ema100, m15Ema200, m15Vol, m15VolSMA, m15ATR] = request.security(syminfo.tickerid, "15", [_ema100[1], _ema200[1], volume[1], _volSMA[1], _atr[1]], lookahead=barmerge.lookahead_on)

[m5High, m5Low, m5Close, m5Open, m5RSI, m5Ema20, m5Ema50] = request.security(syminfo.tickerid, "5", [high[1], low[1], close[1], open[1], _rsi[1], _ema20[1], _ema50[1]], lookahead=barmerge.lookahead_on)
[m5Ema100, m5Ema200, m5Vol, m5VolSMA, m5ATR] = request.security(syminfo.tickerid, "5", [_ema100[1], _ema200[1], volume[1], _volSMA[1], _atr[1]], lookahead=barmerge.lookahead_on)

// Canli RSI degerleri (dashboard icin anlik guncelleme)
dailyRSILive = request.security(syminfo.tickerid, "D", _rsi)
h4RSILive    = request.security(syminfo.tickerid, "240", _rsi)
h1RSILive    = request.security(syminfo.tickerid, "60", _rsi)
m15RSILive   = request.security(syminfo.tickerid, "15", _rsi)
m5RSILive    = request.security(syminfo.tickerid, "5", _rsi)

// Haftalik veri (Fibonacci icin)
[weeklyHigh, weeklyLow] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)

// ICT OTE Global Hesaplama (sinyal motoru icin)
fibHighG_raw = fibSource == "Haftalik" ? weeklyHigh : fibSource == "Gunluk" ? dailyHigh : fibSource == "4 Saat" ? h4High : h1High
fibLowG_raw  = fibSource == "Haftalik" ? weeklyLow  : fibSource == "Gunluk" ? dailyLow  : fibSource == "4 Saat" ? h4Low  : h1Low
fibHighG = fibReverse ? fibLowG_raw : fibHighG_raw
fibLowG  = fibReverse ? fibHighG_raw : fibLowG_raw
fibRangeG = nz(fibHighG) - nz(fibLowG)
oteTopG  = nz(fibHighG) - fibRangeG * oteFibTop
oteBotG  = nz(fibHighG) - fibRangeG * oteFibBot
inOTE    = showOTE and fibRangeG > 0 and close >= oteBotG and close <= oteTopG

// ICT Premium/Discount Zone Global Hesaplama
eqLevel  = nz(fibLowG) + fibRangeG * 0.5
inPremium  = showPremDisc and fibRangeG > 0 and close > eqLevel
inDiscount = showPremDisc and fibRangeG > 0 and close < eqLevel

// ICT NWOG/NDOG Hesaplama
[weekOpen, weekClose1, weeklyOpenPrev] = request.security(syminfo.tickerid, "W", [open[0], close[1], open[1]], lookahead=barmerge.lookahead_on)
[dayOpen, dayClose1]   = request.security(syminfo.tickerid, "D", [open[0], close[1]], lookahead=barmerge.lookahead_on)
nwogTop = math.max(nz(weekOpen), nz(weekClose1))
nwogBot = math.min(nz(weekOpen), nz(weekClose1))
nwogExists = nz(weekOpen) != nz(weekClose1) and nz(weekOpen) > 0
ndogTop = math.max(nz(dayOpen), nz(dayClose1))
ndogBot = math.min(nz(dayOpen), nz(dayClose1))
ndogExists = nz(dayOpen) != nz(dayClose1) and nz(dayOpen) > 0

// ============================================================================
// HTF HIGH/LOW SEVIYE CIZGILERI (Onceki Mum)
// ============================================================================

var line dailyHighLine = na
var line dailyLowLine  = na
var label dailyHighLbl = na
var label dailyLowLbl  = na

if showDailyHL and barstate.islast and not na(dailyHigh) and not na(dailyLow)
    if not na(dailyHighLine)
        line.delete(dailyHighLine)
        line.delete(dailyLowLine)
        label.delete(dailyHighLbl)
        label.delete(dailyLowLbl)
    dailyHighLine := line.new(bar_index - 50, dailyHigh, bar_index + 10, dailyHigh, color=dailyHColor, style=htfLStyle, width=htfLineWidth)
    dailyLowLine  := line.new(bar_index - 50, dailyLow, bar_index + 10, dailyLow, color=dailyHColor, style=htfLStyle, width=htfLineWidth)
    dailyHighLbl  := label.new(bar_index + 11, dailyHigh, "D High", color=color.new(color.white, 100), textcolor=dailyHColor, style=label.style_label_left, size=vizLblSz)
    dailyLowLbl   := label.new(bar_index + 11, dailyLow, "D Low", color=color.new(color.white, 100), textcolor=dailyHColor, style=label.style_label_left, size=vizLblSz)

var line h4HighLine = na
var line h4LowLine  = na
var label h4HighLbl = na
var label h4LowLbl  = na

if show4HHL and barstate.islast and not na(h4High) and not na(h4Low)
    if not na(h4HighLine)
        line.delete(h4HighLine)
        line.delete(h4LowLine)
        label.delete(h4HighLbl)
        label.delete(h4LowLbl)
    h4HighLine := line.new(bar_index - 50, h4High, bar_index + 10, h4High, color=h4HColor, style=htfLStyle, width=htfLineWidth)
    h4LowLine  := line.new(bar_index - 50, h4Low, bar_index + 10, h4Low, color=h4HColor, style=htfLStyle, width=htfLineWidth)
    h4HighLbl  := label.new(bar_index + 11, h4High, "4H High", color=color.new(color.white, 100), textcolor=h4HColor, style=label.style_label_left, size=vizLblSz)
    h4LowLbl   := label.new(bar_index + 11, h4Low, "4H Low", color=color.new(color.white, 100), textcolor=h4HColor, style=label.style_label_left, size=vizLblSz)

var line h1HighLine = na
var line h1LowLine  = na
var label h1HighLbl = na
var label h1LowLbl  = na

if show1HHL and barstate.islast and not na(h1High) and not na(h1Low)
    if not na(h1HighLine)
        line.delete(h1HighLine)
        line.delete(h1LowLine)
        label.delete(h1HighLbl)
        label.delete(h1LowLbl)
    h1HighLine := line.new(bar_index - 50, h1High, bar_index + 10, h1High, color=h1HColor, style=htfLStyle, width=htfLineWidth)
    h1LowLine  := line.new(bar_index - 50, h1Low, bar_index + 10, h1Low, color=h1HColor, style=htfLStyle, width=htfLineWidth)
    h1HighLbl  := label.new(bar_index + 11, h1High, "1H High", color=color.new(color.white, 100), textcolor=h1HColor, style=label.style_label_left, size=vizLblSz)
    h1LowLbl   := label.new(bar_index + 11, h1Low, "1H Low", color=color.new(color.white, 100), textcolor=h1HColor, style=label.style_label_left, size=vizLblSz)

// ============================================================================
// ORDER BLOCK TESPITI
// ============================================================================

var box[] bullOBBoxes = array.new_box()
var box[] bearOBBoxes = array.new_box()
var box[] bullBBBoxes = array.new_box()
var box[] bearBBBoxes = array.new_box()

bullishOB = false
bearishOB = false

if showOB and bar_index > 5 and not na(obAvgBody) and obAvgBody > 0
    bearishCount = 0
    for j = 2 to 2 + obStrength - 1
        if j <= bar_index and close[j] < open[j]
            bearishCount := bearishCount + 1
    
    isBullishCandle = close > open
    isStrongBullish = isBullishCandle and obBodySize > obAvgBody * 1.5
    prevDropped     = low[1] <= low[2]
    
    if bearishCount >= math.max(1, math.floor(obStrength * 0.6)) and isStrongBullish and prevDropped
        bullishOB := true
        if array.size(bullOBBoxes) >= obMaxBoxes
            box.delete(array.shift(bullOBBoxes))
        obTop2 = math.max(open[2], close[2])
        obBot2 = math.min(open[2], close[2])
        newBox = box.new(bar_index - 2, obTop2, bar_index + 30, obBot2, bgcolor=obBullColor, border_color=color.new(color.green, 50), border_width=vizBoxBorder, text="OB", text_color=color.new(color.green, 30), text_size=vizBoxTxtSz, text_halign=text.align_center, text_valign=text.align_center)
        array.push(bullOBBoxes, newBox)
    
    bullishCount = 0
    for j = 2 to 2 + obStrength - 1
        if j <= bar_index and close[j] > open[j]
            bullishCount := bullishCount + 1
    
    isBearishCandle = close < open
    isStrongBearish = isBearishCandle and obBodySize > obAvgBody * 1.5
    prevRose        = high[1] >= high[2]
    
    if bullishCount >= math.max(1, math.floor(obStrength * 0.6)) and isStrongBearish and prevRose
        bearishOB := true
        if array.size(bearOBBoxes) >= obMaxBoxes
            box.delete(array.shift(bearOBBoxes))
        obTop2 = math.max(open[2], close[2])
        obBot2 = math.min(open[2], close[2])
        newBox = box.new(bar_index - 2, obTop2, bar_index + 30, obBot2, bgcolor=obBearColor, border_color=color.new(color.red, 50), border_width=vizBoxBorder, text="OB", text_color=color.new(color.red, 30), text_size=vizBoxTxtSz, text_halign=text.align_center, text_valign=text.align_center)
        array.push(bearOBBoxes, newBox)

// OB Mitigation (+ Breaker Block olusturma)
if showOB and obMitigated
    if array.size(bullOBBoxes) > 0
        for i = array.size(bullOBBoxes) - 1 to 0
            if i < array.size(bullOBBoxes)
                b = array.get(bullOBBoxes, i)
                obTopB = box.get_top(b)
                obBotB = box.get_bottom(b)
                if (obMitPrice == "Fitil" ? low : math.min(close, open)) < obBotB
                    if showBreakerBlock
                        if array.size(bearBBBoxes) >= bbMaxBoxes
                            box.delete(array.shift(bearBBBoxes))
                        array.push(bearBBBoxes, box.new(bar_index, obTopB, bar_index + 30, obBotB, bgcolor=bbBearColor, border_color=color.new(color.fuchsia, 40), border_width=vizBoxBorder, border_style=line.style_dashed, text="BB", text_color=color.new(color.fuchsia, 20), text_size=vizBoxTxtSz, text_halign=text.align_center, text_valign=text.align_center))
                    box.delete(b)
                    array.remove(bullOBBoxes, i)
                else
                    if obExtend
                        box.set_right(b, bar_index + 20)
    
    if array.size(bearOBBoxes) > 0
        for i = array.size(bearOBBoxes) - 1 to 0
            if i < array.size(bearOBBoxes)
                b = array.get(bearOBBoxes, i)
                obTopS = box.get_top(b)
                obBotS = box.get_bottom(b)
                if (obMitPrice == "Fitil" ? high : math.max(close, open)) > obTopS
                    if showBreakerBlock
                        if array.size(bullBBBoxes) >= bbMaxBoxes
                            box.delete(array.shift(bullBBBoxes))
                        array.push(bullBBBoxes, box.new(bar_index, obTopS, bar_index + 30, obBotS, bgcolor=bbBullColor, border_color=color.new(color.lime, 40), border_width=vizBoxBorder, border_style=line.style_dashed, text="BB", text_color=color.new(color.lime, 20), text_size=vizBoxTxtSz, text_halign=text.align_center, text_valign=text.align_center))
                    box.delete(b)
                    array.remove(bearOBBoxes, i)
                else
                    if obExtend
                        box.set_right(b, bar_index + 20)

// Breaker Block Mitigation
if showBreakerBlock
    if array.size(bullBBBoxes) > 0
        for i = array.size(bullBBBoxes) - 1 to 0
            if i < array.size(bullBBBoxes)
                b = array.get(bullBBBoxes, i)
                bbBotVal = box.get_bottom(b)
                if low < bbBotVal
                    box.delete(b)
                    array.remove(bullBBBoxes, i)
                else
                    if obExtend
                        box.set_right(b, bar_index + 20)
    if array.size(bearBBBoxes) > 0
        for i = array.size(bearBBBoxes) - 1 to 0
            if i < array.size(bearBBBoxes)
                b = array.get(bearBBBoxes, i)
                bbTopVal = box.get_top(b)
                if high > bbTopVal
                    box.delete(b)
                    array.remove(bearBBBoxes, i)
                else
                    if obExtend
                        box.set_right(b, bar_index + 20)

// ============================================================================
// FVG (FAIR VALUE GAP) TESPITI
// ============================================================================

var box[] bullFVGBoxes = array.new_box()
var box[] bearFVGBoxes = array.new_box()

if showFVG and bar_index > 2
    fvgAtr = ta.atr(14)
    bullFVG = low > high[2] and close[1] > open[1] and (fvgWidthFilter == 0 or (low - high[2]) >= fvgAtr * fvgWidthFilter)
    if bullFVG
        if array.size(bullFVGBoxes) >= fvgMaxBoxes
            box.delete(array.shift(bullFVGBoxes))
        newBox = box.new(bar_index - 2, low, bar_index + 20, high[2], bgcolor=fvgBullColor, border_color=color.new(color.teal, 50), border_width=vizBoxBorder, border_style=line.style_dotted, text="FVG", text_color=color.new(color.teal, 30), text_size=vizBoxTxtSz, text_halign=text.align_center, text_valign=text.align_center)
        array.push(bullFVGBoxes, newBox)
    
    bearFVG = high < low[2] and close[1] < open[1] and (fvgWidthFilter == 0 or (low[2] - high) >= fvgAtr * fvgWidthFilter)
    if bearFVG
        if array.size(bearFVGBoxes) >= fvgMaxBoxes
            box.delete(array.shift(bearFVGBoxes))
        newBox = box.new(bar_index - 2, low[2], bar_index + 20, high, bgcolor=fvgBearColor, border_color=color.new(color.maroon, 50), border_width=vizBoxBorder, border_style=line.style_dotted, text="FVG", text_color=color.new(color.maroon, 30), text_size=vizBoxTxtSz, text_halign=text.align_center, text_valign=text.align_center)
        array.push(bearFVGBoxes, newBox)

// FVG Mitigation
if showFVG and fvgMitigated
    if array.size(bullFVGBoxes) > 0
        for i = array.size(bullFVGBoxes) - 1 to 0
            if i < array.size(bullFVGBoxes)
                b = array.get(bullFVGBoxes, i)
                fvgTop = box.get_top(b)
                fvgBot = box.get_bottom(b)
                mid = (fvgTop + fvgBot) / 2
                if low <= mid
                    box.delete(b)
                    array.remove(bullFVGBoxes, i)
                else
                    if fvgExtend
                        box.set_right(b, bar_index + 20)
    
    if array.size(bearFVGBoxes) > 0
        for i = array.size(bearFVGBoxes) - 1 to 0
            if i < array.size(bearFVGBoxes)
                b = array.get(bearFVGBoxes, i)
                fvgTop = box.get_top(b)
                fvgBot = box.get_bottom(b)
                mid = (fvgTop + fvgBot) / 2
                if high >= mid
                    box.delete(b)
                    array.remove(bearFVGBoxes, i)
                else
                    if fvgExtend
                        box.set_right(b, bar_index + 20)

// ============================================================================
// LIKIDITE BOLGELERI TESPITI (Sweep Mitigation ile)
// ============================================================================

var line[] liqHighLines = array.new_line()
var line[] liqLowLines  = array.new_line()
var label[] liqHighLbls = array.new_label()
var label[] liqLowLbls  = array.new_label()

if showLiquidity and barstate.islast
    // Onceki cizgileri temizle
    if array.size(liqHighLines) > 0
        for i = 0 to array.size(liqHighLines) - 1
            line.delete(array.get(liqHighLines, i))
    if array.size(liqHighLbls) > 0
        for i = 0 to array.size(liqHighLbls) - 1
            label.delete(array.get(liqHighLbls, i))
    if array.size(liqLowLines) > 0
        for i = 0 to array.size(liqLowLines) - 1
            line.delete(array.get(liqLowLines, i))
    if array.size(liqLowLbls) > 0
        for i = 0 to array.size(liqLowLbls) - 1
            label.delete(array.get(liqLowLbls, i))
    array.clear(liqHighLines)
    array.clear(liqHighLbls)
    array.clear(liqLowLines)
    array.clear(liqLowLbls)
    
    // High likidite seviyeleri
    highLevels = array.new_float()
    highCounts = array.new_int()
    highLastBar = array.new_int()  // en son temas eden bar indexi
    
    lookbackBars = math.min(liqLookback - 1, bar_index)
    for i = 0 to lookbackBars
        h = high[i]
        if not na(h) and h > 0
            levelFound = false
            if array.size(highLevels) > 0
                for j = 0 to array.size(highLevels) - 1
                    existingLevel = array.get(highLevels, j)
                    if existingLevel > 0 and math.abs(h - existingLevel) / existingLevel <= liqTolerance
                        array.set(highCounts, j, array.get(highCounts, j) + 1)
                        if i < array.get(highLastBar, j)
                            array.set(highLastBar, j, i)
                        levelFound := true
                        break
            if not levelFound
                array.push(highLevels, h)
                array.push(highCounts, 1)
                array.push(highLastBar, i)
    
    // Low likidite seviyeleri
    lowLevels = array.new_float()
    lowCounts = array.new_int()
    lowLastBar = array.new_int()  // en son temas eden bar indexi
    
    for i = 0 to lookbackBars
        l = low[i]
        if not na(l) and l > 0
            levelFound = false
            if array.size(lowLevels) > 0
                for j = 0 to array.size(lowLevels) - 1
                    existingLevel = array.get(lowLevels, j)
                    if existingLevel > 0 and math.abs(l - existingLevel) / existingLevel <= liqTolerance
                        array.set(lowCounts, j, array.get(lowCounts, j) + 1)
                        if i < array.get(lowLastBar, j)
                            array.set(lowLastBar, j, i)
                        levelFound := true
                        break
            if not levelFound
                array.push(lowLevels, l)
                array.push(lowCounts, 1)
                array.push(lowLastBar, i)
    
    // High likidite cizgileri (sweep kontrolu ile)
    highDrawn = 0
    if array.size(highLevels) > 0
        for i = 0 to array.size(highLevels) - 1
            if highDrawn >= liqMaxLines
                break
            lvl = array.get(highLevels, i)
            cnt = array.get(highCounts, i)
            lastBar = array.get(highLastBar, i)
            if cnt >= liqTouchCount and lvl > close
                // Sweep kontrolu: son temastan sonra fiyat bu seviyeyi gecmis mi?
                swept = false
                if lastBar > 0
                    for k = 0 to lastBar - 1
                        if close[k] > lvl
                            swept := true
                            break
                if not swept
                    newLine = line.new(bar_index - liqLookback, lvl, bar_index + 5, lvl, color=liqHighColor, style=line.style_dotted, width=vizLineWidth)
                    newLbl  = label.new(bar_index + 6, lvl, "LIQ " + str.tostring(cnt) + "x", color=liqHighColor, textcolor=color.white, style=label.style_label_left, size=vizLblSz)
                    array.push(liqHighLines, newLine)
                    array.push(liqHighLbls, newLbl)
                    highDrawn := highDrawn + 1
    
    // Low likidite cizgileri (sweep kontrolu ile)
    lowDrawn = 0
    if array.size(lowLevels) > 0
        for i = 0 to array.size(lowLevels) - 1
            if lowDrawn >= liqMaxLines
                break
            lvl = array.get(lowLevels, i)
            cnt = array.get(lowCounts, i)
            lastBar = array.get(lowLastBar, i)
            if cnt >= liqTouchCount and lvl < close
                // Sweep kontrolu: son temastan sonra fiyat bu seviyeyi gecmis mi?
                swept = false
                if lastBar > 0
                    for k = 0 to lastBar - 1
                        if close[k] < lvl
                            swept := true
                            break
                if not swept
                    newLine = line.new(bar_index - liqLookback, lvl, bar_index + 5, lvl, color=liqLowColor, style=line.style_dotted, width=vizLineWidth)
                    newLbl  = label.new(bar_index + 6, lvl, "LIQ " + str.tostring(cnt) + "x", color=liqLowColor, textcolor=color.white, style=label.style_label_left, size=vizLblSz)
                    array.push(liqLowLines, newLine)
                    array.push(liqLowLbls, newLbl)
                    lowDrawn := lowDrawn + 1

// ============================================================================
// MARKET STRUCTURE (BOS / CHoCH) TESPITI
// ============================================================================

// Swing High/Low tespiti
swingHighFound = ta.pivothigh(high, msLookback, msLookback)
swingLowFound  = ta.pivotlow(low, msLookback, msLookback)

var float lastSwingHigh    = na
var float lastSwingLow     = na
var float prevSwingHigh    = na
var float prevSwingLow     = na
var int   lastSwingHighBar = na
var int   lastSwingLowBar  = na
var int   prevSwingHighBar = na
var int   prevSwingLowBar  = na
var int   msTrend          = 0  // 1 = bullish, -1 = bearish, 0 = undefined

if showMS
    if not na(swingHighFound)
        prevSwingHigh    := lastSwingHigh
        prevSwingHighBar := lastSwingHighBar
        lastSwingHigh    := swingHighFound
        lastSwingHighBar := bar_index - msLookback
    
    if not na(swingLowFound)
        prevSwingLow    := lastSwingLow
        prevSwingLowBar := lastSwingLowBar
        lastSwingLow    := swingLowFound
        lastSwingLowBar := bar_index - msLookback
    
    // Swing High kirilimlari kontrol et
    if not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
        if msTrend == -1
            // CHoCH (Change of Character) - trend donusu: dusus trendindeyken swing high kirilir
            line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh, color=msCHoCHColor, style=line.style_solid, width=msLineWidth)
            label.new(math.round((lastSwingHighBar + bar_index) / 2), lastSwingHigh, "CHoCH ▲", color=color.new(color.white, 100), textcolor=msCHoCHColor, style=label.style_label_down, size=vizLblSz)
            msTrend := 1
        else if msTrend >= 0 and not na(prevSwingHighBar)
            // BOS (Break of Structure) - trend devami: yukselis trendinde swing high kirilir
            line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh, color=msBOSColor, style=line.style_dashed, width=msLineWidth)
            label.new(math.round((lastSwingHighBar + bar_index) / 2), lastSwingHigh, "BOS ▲", color=color.new(color.white, 100), textcolor=msBOSColor, style=label.style_label_down, size=vizLblSz)
            msTrend := 1
    
    // Swing Low kirilimlari kontrol et
    if not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow
        if msTrend == 1
            // CHoCH - trend donusu: yukselis trendindeyken swing low kirilir
            line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow, color=msCHoCHColor, style=line.style_solid, width=msLineWidth)
            label.new(math.round((lastSwingLowBar + bar_index) / 2), lastSwingLow, "CHoCH ▼", color=color.new(color.white, 100), textcolor=msCHoCHColor, style=label.style_label_up, size=vizLblSz)
            msTrend := -1
        else if msTrend <= 0 and not na(prevSwingLowBar)
            // BOS - trend devami: dusus trendinde swing low kirilir
            line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow, color=msBOSColor, style=line.style_dashed, width=msLineWidth)
            label.new(math.round((lastSwingLowBar + bar_index) / 2), lastSwingLow, "BOS ▼", color=color.new(color.white, 100), textcolor=msCHoCHColor, style=label.style_label_up, size=vizLblSz)
            msTrend := -1

// ============================================================================
// FIBONACCI RETRACEMENT (HTF High/Low'dan)
// ============================================================================

var box oteBox = na
var line[] fibLines = array.new_line()
var label[] fibLbls = array.new_label()

if showFib and barstate.islast
    // Onceki cizgileri temizle
    if array.size(fibLines) > 0
        for i = 0 to array.size(fibLines) - 1
            line.delete(array.get(fibLines, i))
    if array.size(fibLbls) > 0
        for i = 0 to array.size(fibLbls) - 1
            label.delete(array.get(fibLbls, i))
    array.clear(fibLines)
    array.clear(fibLbls)
    
    // Kaynak TF'ye gore High/Low sec
    fibHigh_raw = fibSource == "Haftalik" ? weeklyHigh : fibSource == "Gunluk" ? dailyHigh : fibSource == "4 Saat" ? h4High : h1High
    fibLow_raw  = fibSource == "Haftalik" ? weeklyLow  : fibSource == "Gunluk" ? dailyLow  : fibSource == "4 Saat" ? h4Low  : h1Low
    fibHigh = fibReverse ? fibLow_raw : fibHigh_raw
    fibLow  = fibReverse ? fibHigh_raw : fibLow_raw
    
    if not na(fibHigh) and not na(fibLow) and fibHigh != fibLow
        fibRange = fibHigh - fibLow
        
        // High/Low cizgileri (0% ve 100%)
        array.push(fibLines, line.new(bar_index - 50, fibHigh, bar_index + 10, fibHigh, color=fibColor, style=line.style_dotted, width=1))
        array.push(fibLines, line.new(bar_index - 50, fibLow, bar_index + 10, fibLow, color=fibColor, style=line.style_dotted, width=1))
        array.push(fibLbls, label.new(bar_index + 11, fibHigh, "Fib 0%", color=color.new(color.white, 100), textcolor=fibColor, style=label.style_label_left, size=vizLblSz))
        array.push(fibLbls, label.new(bar_index + 11, fibLow, "Fib 100%", color=color.new(color.white, 100), textcolor=fibColor, style=label.style_label_left, size=vizLblSz))
        
        // Kullanici tarafindan ayarlanan fib seviyeleri
        fibLevels = array.new_float()
        if fibLvl1 != 0
            array.push(fibLevels, fibLvl1)
        if fibLvl2 != 0
            array.push(fibLevels, fibLvl2)
        if fibLvl3 != 0
            array.push(fibLevels, fibLvl3)
        if fibLvl4 != 0
            array.push(fibLevels, fibLvl4)
        if fibLvl5 != 0
            array.push(fibLevels, fibLvl5)
        if fibLvl6 != 0
            array.push(fibLevels, fibLvl6)
        if fibLvl7 != 0
            array.push(fibLevels, fibLvl7)
        if fibLvl8 != 0
            array.push(fibLevels, fibLvl8)
        
        if array.size(fibLevels) > 0
            for i = 0 to array.size(fibLevels) - 1
                lvl = array.get(fibLevels, i)
                fibPrice = fibHigh - fibRange * lvl
                fibStyle = lvl == 0.5 ? line.style_solid : line.style_dotted
                fibW = lvl == 0.5 ? 2 : 1
                lvlText = str.tostring(lvl * 100, "#.#") + "%"
                array.push(fibLines, line.new(bar_index - 50, fibPrice, bar_index + 10, fibPrice, color=fibColor, style=fibStyle, width=fibW))
                array.push(fibLbls, label.new(bar_index + 11, fibPrice, lvlText, color=color.new(color.white, 100), textcolor=fibColor, style=label.style_label_left, size=vizLblSz))
        
        // ICT Premium/Discount Zone — %50 Equilibrium cizgisi + zone renklendirmesi
        if showPremDisc
            eqPrice = fibLow + fibRange * 0.5
            array.push(fibLines, line.new(bar_index - 50, eqPrice, bar_index + 10, eqPrice, color=color.new(color.white, 30), style=line.style_solid, width=2))
            array.push(fibLbls, label.new(bar_index + 11, eqPrice, "EQ (50%)", color=color.new(color.white, 100), textcolor=color.white, style=label.style_label_left, size=vizLblSz))

// ICT OTE (Fibonacci'den bagimsiz — kendi toggle'i ile acilip kapatilabilir)
if barstate.islast
    if showOTE and fibRangeG > 0
        oteTopPrice = nz(fibHighG) - fibRangeG * oteFibTop
        oteBotPrice = nz(fibHighG) - fibRangeG * oteFibBot
        if not na(oteBox)
            box.delete(oteBox)
        oteBox := box.new(bar_index - 50, oteTopPrice, bar_index + 10, oteBotPrice, bgcolor=oteColor, border_color=color.new(color.orange, 30), border_width=vizBoxBorder, text="OTE", text_color=color.new(color.orange, 10), text_size=vizBoxTxtSz, text_halign=text.align_center, text_valign=text.align_center)
    else
        if not na(oteBox)
            box.delete(oteBox)
            oteBox := na

// ICT Premium/Discount arka plan (global scope'da)
premDiscBg = showPremDisc and fibRangeG > 0 ? (inPremium ? premColor : inDiscount ? discColor : na) : na
bgcolor(premDiscBg, title="Premium/Discount Zone")

// ============================================================================
// ICT NWOG/NDOG (NEW WEEK/DAY OPENING GAP)
// ============================================================================

var box nwogBox = na
var box ndogBox = na
var label nwogLbl = na
var label ndogLbl = na

if showNWOG and barstate.islast
    if not na(nwogBox)
        box.delete(nwogBox)
        label.delete(nwogLbl)
    if not na(ndogBox)
        box.delete(ndogBox)
        label.delete(ndogLbl)
    
    if nwogExists
        nwogBox := box.new(bar_index - 30, nwogTop, bar_index + 10, nwogBot, bgcolor=nwogColor, border_color=color.new(color.aqua, 30), border_width=vizBoxBorder, border_style=line.style_dashed)
        nwogLbl := label.new(bar_index + 11, (nwogTop + nwogBot) / 2, "NWOG", color=color.new(color.white, 100), textcolor=color.new(color.aqua, 10), style=label.style_label_left, size=vizLblSz)
    
    if ndogExists
        ndogBox := box.new(bar_index - 15, ndogTop, bar_index + 10, ndogBot, bgcolor=color.new(color.aqua, 88), border_color=color.new(color.aqua, 50), border_width=vizBoxBorder, border_style=line.style_dotted)
        ndogLbl := label.new(bar_index + 11, (ndogTop + ndogBot) / 2, "NDOG", color=color.new(color.white, 100), textcolor=color.new(color.aqua, 30), style=label.style_label_left, size=vizLblSz)

// ============================================================================
// EQUAL HIGHS / EQUAL LOWS TESPITI
// ============================================================================

var line[] eqlHighLines = array.new_line()
var line[] eqlLowLines  = array.new_line()
var label[] eqlHighLbls = array.new_label()
var label[] eqlLowLbls  = array.new_label()

if showEQL and barstate.islast
    // Onceki cizgileri temizle
    if array.size(eqlHighLines) > 0
        for i = 0 to array.size(eqlHighLines) - 1
            line.delete(array.get(eqlHighLines, i))
    if array.size(eqlHighLbls) > 0
        for i = 0 to array.size(eqlHighLbls) - 1
            label.delete(array.get(eqlHighLbls, i))
    if array.size(eqlLowLines) > 0
        for i = 0 to array.size(eqlLowLines) - 1
            line.delete(array.get(eqlLowLines, i))
    if array.size(eqlLowLbls) > 0
        for i = 0 to array.size(eqlLowLbls) - 1
            label.delete(array.get(eqlLowLbls, i))
    array.clear(eqlHighLines)
    array.clear(eqlHighLbls)
    array.clear(eqlLowLines)
    array.clear(eqlLowLbls)
    
    eqlLookbackBars = math.min(eqlLookback - 1, bar_index)
    eqlHighDrawn = 0
    eqlLowDrawn  = 0
    
    // Swing high'lari bul ve esit olanlari isle
    for i = 2 to eqlLookbackBars - 1
        if eqlHighDrawn >= eqlMaxLines and eqlLowDrawn >= eqlMaxLines
            break
        
        // Swing High kontrol: high[i] > high[i-1] ve high[i] > high[i+1]
        isSwHigh = high[i] > high[i-1] and high[i] > high[i+1]
        if isSwHigh and eqlHighDrawn < eqlMaxLines
            // Daha onceki swing high'larla karsilastir
            for j = i + 2 to eqlLookbackBars
                isSwHigh2 = high[j] > high[j-1] and high[j] > high[j+1]
                if isSwHigh2
                    hDiff = math.abs(high[i] - high[j])
                    if high[j] > 0 and hDiff / high[j] <= eqlTolerance
                        eqlLevel = (high[i] + high[j]) / 2
                        if eqlLevel > close  // sadece fiyatin ustundeki esit tepeleri goster
                            newLine = line.new(bar_index - j, eqlLevel, bar_index + 5, eqlLevel, color=eqlHighColor, style=line.style_dotted, width=vizLineWidth)
                            newLbl  = label.new(bar_index + 6, eqlLevel, "EQH", color=eqlHighColor, textcolor=color.white, style=label.style_label_left, size=vizLblSz)
                            array.push(eqlHighLines, newLine)
                            array.push(eqlHighLbls, newLbl)
                            eqlHighDrawn := eqlHighDrawn + 1
                        break
        
        // Swing Low kontrol: low[i] < low[i-1] ve low[i] < low[i+1]
        isSwLow = low[i] < low[i-1] and low[i] < low[i+1]
        if isSwLow and eqlLowDrawn < eqlMaxLines
            for j = i + 2 to eqlLookbackBars
                isSwLow2 = low[j] < low[j-1] and low[j] < low[j+1]
                if isSwLow2
                    lDiff = math.abs(low[i] - low[j])
                    if low[j] > 0 and lDiff / low[j] <= eqlTolerance
                        eqlLevel = (low[i] + low[j]) / 2
                        if eqlLevel < close  // sadece fiyatin altindaki esit dipleri goster
                            newLine = line.new(bar_index - j, eqlLevel, bar_index + 5, eqlLevel, color=eqlLowColor, style=line.style_dotted, width=vizLineWidth)
                            newLbl  = label.new(bar_index + 6, eqlLevel, "EQL", color=eqlLowColor, textcolor=color.white, style=label.style_label_left, size=vizLblSz)
                            array.push(eqlLowLines, newLine)
                            array.push(eqlLowLbls, newLbl)
                            eqlLowDrawn := eqlLowDrawn + 1
                        break

// ============================================================================
// DEMAND / SUPPLY ZONE TESPITI
// ============================================================================

var box[] demandBoxes = array.new_box()
var box[] supplyBoxes = array.new_box()

bullishDZ = false
bearishSZ = false

if showDZ and bar_index > 5 and not na(obAvgBody) and obAvgBody > 0
    // Demand Zone: guclu dusus sonrasi guclu yukselis mumu
    // Son 2-3 mum dusmus, sonra guclu bir marubozu yukselis mumu
    prevBearCount = 0
    for j = 1 to 3
        if j <= bar_index and close[j] < open[j]
            prevBearCount := prevBearCount + 1
    
    isBullMarubozu = close > open and math.abs(close - open) > obAvgBody * 1.2
    bullBodyRatio = (high - low) > 0 ? math.abs(close - open) / (high - low) : 0
    
    if prevBearCount >= 2 and isBullMarubozu and bullBodyRatio >= 0.65
        bullishDZ := true
        if array.size(demandBoxes) >= dzMaxBoxes
            box.delete(array.shift(demandBoxes))
        dzTop = math.max(open[1], close[1])
        dzBot = math.min(open[1], close[1])
        newBox = box.new(bar_index - 1, dzTop, bar_index + 30, dzBot, bgcolor=dzDemandColor, border_color=color.new(color.blue, 40), border_width=vizBoxBorder, text="DZ", text_color=color.new(color.blue, 20), text_size=vizBoxTxtSz, text_halign=text.align_center, text_valign=text.align_center)
        array.push(demandBoxes, newBox)
    
    // Supply Zone: guclu yukselis sonrasi guclu dusus mumu
    prevBullCount = 0
    for j = 1 to 3
        if j <= bar_index and close[j] > open[j]
            prevBullCount := prevBullCount + 1
    
    isBearMarubozu = close < open and math.abs(close - open) > obAvgBody * 1.2
    bearBodyRatio = (high - low) > 0 ? math.abs(close - open) / (high - low) : 0
    
    if prevBullCount >= 2 and isBearMarubozu and bearBodyRatio >= 0.65
        bearishSZ := true
        if array.size(supplyBoxes) >= dzMaxBoxes
            box.delete(array.shift(supplyBoxes))
        szTop = math.max(open[1], close[1])
        szBot = math.min(open[1], close[1])
        newBox = box.new(bar_index - 1, szTop, bar_index + 30, szBot, bgcolor=dzSupplyColor, border_color=color.new(color.purple, 40), border_width=vizBoxBorder, text="SZ", text_color=color.new(color.purple, 20), text_size=vizBoxTxtSz, text_halign=text.align_center, text_valign=text.align_center)
        array.push(supplyBoxes, newBox)

// DZ/SZ Mitigation
if showDZ and dzMitigated
    if array.size(demandBoxes) > 0
        for i = array.size(demandBoxes) - 1 to 0
            if i < array.size(demandBoxes)
                b = array.get(demandBoxes, i)
                dzBot = box.get_bottom(b)
                if low < dzBot
                    box.delete(b)
                    array.remove(demandBoxes, i)
                else
                    box.set_right(b, bar_index + 20)
    
    if array.size(supplyBoxes) > 0
        for i = array.size(supplyBoxes) - 1 to 0
            if i < array.size(supplyBoxes)
                b = array.get(supplyBoxes, i)
                szTop = box.get_top(b)
                if high > szTop
                    box.delete(b)
                    array.remove(supplyBoxes, i)
                else
                    box.set_right(b, bar_index + 20)

// ============================================================================
// ENGULFING MUM TESPITI
// ============================================================================

bullishEngulfing = false
bearishEngulfing = false

if showEngulfing and bar_index > 1
    // Bullish Engulfing: onceki mum dusen, simdiki mum onceki mumun govdesini tamamen kapatmis
    prevBearish = close[1] < open[1]
    currBullish = close > open
    bullEngulf  = currBullish and prevBearish and close > open[1] and open < close[1]
    
    if bullEngulf
        bullishEngulfing := true
        label.new(bar_index, low, "▲ Engulf", color=engBullColor, textcolor=color.white, style=label.style_label_up, size=vizLblSz)
    
    // Bearish Engulfing: onceki mum yukselen, simdiki mum onceki mumun govdesini tamamen kapatmis
    prevBullish = close[1] > open[1]
    currBearish = close < open
    bearEngulf  = currBearish and prevBullish and close < open[1] and open > close[1]
    
    if bearEngulf
        bearishEngulfing := true
        label.new(bar_index, high, "▼ Engulf", color=engBearColor, textcolor=color.white, style=label.style_label_down, size=vizLblSz)

// ============================================================================
// ICT DISPLACEMENT (GUCLU MOMENTUM MUM) TESPITI
// ============================================================================

bullishDisplacement = false
bearishDisplacement = false

if showDisplacement and not na(atrValue) and atrValue > 0
    dispBody = math.abs(close - open)
    dispRange = high - low
    bodyRatio = dispRange > 0 ? dispBody / dispRange : 0
    if dispBody > atrValue * dispMultiplier and bodyRatio >= 0.7
        if close > open
            bullishDisplacement := true
        else
            bearishDisplacement := true

plotshape(showDisplacement and bullishDisplacement, "Bull Displacement", shape.diamond, location.belowbar, color.new(color.lime, 20), size=size.tiny)
plotshape(showDisplacement and bearishDisplacement, "Bear Displacement", shape.diamond, location.abovebar, color.new(color.fuchsia, 20), size=size.tiny)

// ============================================================================
// RSI DIVERGENCE TESPITI
// ============================================================================

var float prevPivotHighPrice = na
var float prevPivotHighRSI   = na
var int   prevPivotHighBar   = na
var float prevPivotLowPrice  = na
var float prevPivotLowRSI    = na
var int   prevPivotLowBar    = na

bullishDivergence = false
bearishDivergence = false

if showRSIDivergence
    if not na(pivotHighPrice) and not na(pivotHighRSI)
        if not na(prevPivotHighPrice) and not na(prevPivotHighRSI) and not na(prevPivotHighBar)
            if pivotHighPrice > prevPivotHighPrice and pivotHighRSI < prevPivotHighRSI
                bearishDivergence := true
                line.new(prevPivotHighBar, prevPivotHighPrice, bar_index - divLookback, pivotHighPrice, color=color.red, width=vizLineWidth, style=line.style_solid)
                label.new(bar_index - divLookback, pivotHighPrice, "Bear Div", color=color.new(color.red, 20), textcolor=color.white, style=label.style_label_down, size=vizLblSz)
        prevPivotHighPrice := pivotHighPrice
        prevPivotHighRSI   := pivotHighRSI
        prevPivotHighBar   := bar_index - divLookback
    
    if not na(pivotLowPrice) and not na(pivotLowRSI)
        if not na(prevPivotLowPrice) and not na(prevPivotLowRSI) and not na(prevPivotLowBar)
            if pivotLowPrice < prevPivotLowPrice and pivotLowRSI > prevPivotLowRSI
                bullishDivergence := true
                line.new(prevPivotLowBar, prevPivotLowPrice, bar_index - divLookback, pivotLowPrice, color=color.green, width=vizLineWidth, style=line.style_solid)
                label.new(bar_index - divLookback, pivotLowPrice, "Bull Div", color=color.new(color.green, 20), textcolor=color.white, style=label.style_label_up, size=vizLblSz)
        prevPivotLowPrice := pivotLowPrice
        prevPivotLowRSI   := pivotLowRSI
        prevPivotLowBar   := bar_index - divLookback

// ============================================================================
// ============================================================================
// KILLZONE HIGH/LOW TAKIBI
// ============================================================================

// Timezone donusumu
kzTZ = kzTimezone == "UTC" ? "GMT+0" : kzTimezone
kzHourLocal = hour(time, kzTZ)
utcHour = hour(time, "UTC")
utcMin  = minute(time, kzTZ)

isInSession(startH, startM, endH, endM) =>
    startMin = startH * 60 + startM
    endMin   = endH * 60 + endM
    curMin   = hour(time, kzTZ) * 60 + minute(time, kzTZ)
    startMin <= endMin ? (curMin >= startMin and curMin < endMin) : (curMin >= startMin or curMin < endMin)

// Pivot cizgi stili donusumu
kzPivotLineStyle = kzPivotStyle == "Solid" ? line.style_solid : kzPivotStyle == "Kesikli" ? line.style_dashed : line.style_dotted
kzMidLineStyle = kzMidpointStyle == "Solid" ? line.style_solid : kzMidpointStyle == "Kesikli" ? line.style_dashed : line.style_dotted

// HH:MM string'den saat ve dakika ayikla
parseHour(t) =>
    colonPos = str.pos(t, ":")
    colonPos >= 0 ? math.round(str.tonumber(str.substring(t, 0, colonPos))) : 0

parseMinute(t) =>
    colonPos = str.pos(t, ":")
    colonPos >= 0 ? math.round(str.tonumber(str.substring(t, colonPos + 1))) : 0

// Killzone saat/dakika degerleri
asianStartH   = parseHour(asianStartTime)
asianStartM   = parseMinute(asianStartTime)
asianEndH     = parseHour(asianEndTime)
asianEndM     = parseMinute(asianEndTime)
londonKZStartH = parseHour(londonStartTime)
londonKZStartM = parseMinute(londonStartTime)
londonKZEndH   = parseHour(londonEndTime)
londonKZEndM   = parseMinute(londonEndTime)
nyAMStartH    = parseHour(nyAMStartTime)
nyAMStartM    = parseMinute(nyAMStartTime)
nyAMEndH      = parseHour(nyAMEndTime)
nyAMEndM      = parseMinute(nyAMEndTime)
nyLunchStartH  = parseHour(nyLunchStartTime)
nyLunchStartM  = parseMinute(nyLunchStartTime)
nyLunchEndH    = parseHour(nyLunchEndTime)
nyLunchEndM    = parseMinute(nyLunchEndTime)
nyPMStartH    = parseHour(nyPMStartTime)
nyPMStartM    = parseMinute(nyPMStartTime)
nyPMEndH      = parseHour(nyPMEndTime)
nyPMEndM      = parseMinute(nyPMEndTime)

isAsianKZ  = showAsian    and isInSession(asianStartH, asianStartM, asianEndH, asianEndM)
isLonKZ    = showLondonKZ and isInSession(londonKZStartH, londonKZStartM, londonKZEndH, londonKZEndM)
isNYAMKZ   = showNYAM     and isInSession(nyAMStartH, nyAMStartM, nyAMEndH, nyAMEndM)
isNYLunchKZ = showNYLunch  and isInSession(nyLunchStartH, nyLunchStartM, nyLunchEndH, nyLunchEndM)
isNYPMKZ   = showNYPM     and isInSession(nyPMStartH, nyPMStartM, nyPMEndH, nyPMEndM)
isKillzone = isAsianKZ or isLonKZ or isNYAMKZ or isNYLunchKZ or isNYPMKZ

// Asian
var float asianHigh = na
var float asianLow  = na
var int   asianStartBar = na
var bool  prevAsian = false
var box   asianBgBox = na
var label asianNameLbl = na
var line  asianPivotH = na
var line  asianPivotL = na
var line  asianMidLine = na
var label asianPivotHLbl = na
var label asianPivotLLbl = na
var bool  asianHMitigated = false
var bool  asianLMitigated = false
if showAsian
    if isAsianKZ
        if not prevAsian
            asianHigh := high
            asianLow  := low
            asianStartBar := bar_index
            asianHMitigated := false
            asianLMitigated := false
            if kzShowBg
                if not na(asianBgBox)
                    box.delete(asianBgBox)
                asianBgBox := box.new(bar_index, high, bar_index, low, border_color=color.new(asianColor, 100), bgcolor=asianColor)
            if kzShowLabels
                if not na(asianNameLbl)
                    label.delete(asianNameLbl)
                asianNameLbl := label.new(bar_index, high, "Asia", color=color.new(color.white, 100), textcolor=asianColor, style=label.style_label_down, size=vizKzLblSz)
            if kzShowLines
                if kzExtendPivots == "Sonraki Seansa Kadar"
                    if not na(asianPivotH)
                        line.delete(asianPivotH)
                    if not na(asianPivotL)
                        line.delete(asianPivotL)
                    if not na(asianPivotHLbl)
                        label.delete(asianPivotHLbl)
                    if not na(asianPivotLLbl)
                        label.delete(asianPivotLLbl)
                asianPivotH := line.new(bar_index, high, bar_index, high, color=color.new(asianColor, 0), style=kzPivotLineStyle, width=vizKzLineWidth)
                asianPivotL := line.new(bar_index, low, bar_index, low, color=color.new(asianColor, 0), style=kzPivotLineStyle, width=vizKzLineWidth)
                asianPivotHLbl := label.new(bar_index, high, kzLbl1H, color=color.new(color.white, 100), textcolor=color.new(asianColor, 0), style=label.style_label_left, size=vizKzLblSz)
                asianPivotLLbl := label.new(bar_index, low, kzLbl1L, color=color.new(color.white, 100), textcolor=color.new(asianColor, 0), style=label.style_label_left, size=vizKzLblSz)
            if kzShowMean
                if kzExtendPivots == "Sonraki Seansa Kadar" and not na(asianMidLine)
                    line.delete(asianMidLine)
                asianMidLine := line.new(bar_index, (high + low) / 2, bar_index, (high + low) / 2, color=color.new(asianColor, 30), style=kzMidLineStyle, width=vizKzLineWidth)
        else
            asianHigh := math.max(nz(asianHigh, high), high)
            asianLow  := math.min(nz(asianLow, low), low)
            if kzShowBg and not na(asianBgBox)
                box.set_top(asianBgBox, asianHigh)
                box.set_bottom(asianBgBox, asianLow)
                box.set_right(asianBgBox, bar_index)
            if kzShowLabels and not na(asianNameLbl)
                label.set_y(asianNameLbl, asianHigh)
            if kzShowLines
                if not na(asianPivotH)
                    line.set_y1(asianPivotH, asianHigh)
                    line.set_y2(asianPivotH, asianHigh)
                    line.set_x2(asianPivotH, bar_index)
                if not na(asianPivotL)
                    line.set_y1(asianPivotL, asianLow)
                    line.set_y2(asianPivotL, asianLow)
                    line.set_x2(asianPivotL, bar_index)
                if not na(asianPivotHLbl)
                    label.set_y(asianPivotHLbl, asianHigh)
                    label.set_x(asianPivotHLbl, bar_index)
                if not na(asianPivotLLbl)
                    label.set_y(asianPivotLLbl, asianLow)
                    label.set_x(asianPivotLLbl, bar_index)
            if kzShowMean and not na(asianMidLine)
                asianMid = (asianHigh + nz(asianLow)) / 2
                line.set_y1(asianMidLine, asianMid)
                line.set_y2(asianMidLine, asianMid)
                line.set_x2(asianMidLine, bar_index)
    else
        // Seans bitti — pivot cizgilerini saga uzat (mitigate olmayanlar)
        if kzShowLines
            if not asianHMitigated and not na(asianPivotH)
                line.set_x2(asianPivotH, bar_index)
            if not asianHMitigated and not na(asianPivotHLbl)
                label.set_x(asianPivotHLbl, bar_index)
            if not asianLMitigated and not na(asianPivotL)
                line.set_x2(asianPivotL, bar_index)
            if not asianLMitigated and not na(asianPivotLLbl)
                label.set_x(asianPivotLLbl, bar_index)
        if kzShowMean and not na(asianMidLine) and not asianHMitigated and not asianLMitigated
            line.set_x2(asianMidLine, bar_index)
        // Mitigation kontrolu — cizgiyi silme, sadece uzamayi durdur
        if kzStopMitigated and kzShowLines
            if not asianHMitigated and not na(asianPivotH) and not na(asianHigh) and close > asianHigh
                asianHMitigated := true
            if not asianLMitigated and not na(asianPivotL) and not na(asianLow) and close < asianLow
                asianLMitigated := true
    prevAsian := isAsianKZ

// London
var float londonKZHigh = na
var float londonKZLow  = na
var int   londonStartBar = na
var bool  prevLondonKZ = false
var box   londonBgBox = na
var label londonNameLbl = na
var line  londonPivotH = na
var line  londonPivotL = na
var line  londonMidLine = na
var label londonPivotHLbl = na
var label londonPivotLLbl = na
var bool  londonHMitigated = false
var bool  londonLMitigated = false
if showLondonKZ
    if isLonKZ
        if not prevLondonKZ
            londonKZHigh := high
            londonKZLow  := low
            londonStartBar := bar_index
            londonHMitigated := false
            londonLMitigated := false
            if kzShowBg
                if not na(londonBgBox)
                    box.delete(londonBgBox)
                londonBgBox := box.new(bar_index, high, bar_index, low, border_color=color.new(londonKZColor, 100), bgcolor=londonKZColor)
            if kzShowLabels
                if not na(londonNameLbl)
                    label.delete(londonNameLbl)
                londonNameLbl := label.new(bar_index, high, "London", color=color.new(color.white, 100), textcolor=londonKZColor, style=label.style_label_down, size=vizKzLblSz)
            if kzShowLines
                if kzExtendPivots == "Sonraki Seansa Kadar"
                    if not na(londonPivotH)
                        line.delete(londonPivotH)
                    if not na(londonPivotL)
                        line.delete(londonPivotL)
                    if not na(londonPivotHLbl)
                        label.delete(londonPivotHLbl)
                    if not na(londonPivotLLbl)
                        label.delete(londonPivotLLbl)
                londonPivotH := line.new(bar_index, high, bar_index, high, color=color.new(londonKZColor, 0), style=kzPivotLineStyle, width=vizKzLineWidth)
                londonPivotL := line.new(bar_index, low, bar_index, low, color=color.new(londonKZColor, 0), style=kzPivotLineStyle, width=vizKzLineWidth)
                londonPivotHLbl := label.new(bar_index, high, kzLbl2H, color=color.new(color.white, 100), textcolor=color.new(londonKZColor, 0), style=label.style_label_left, size=vizKzLblSz)
                londonPivotLLbl := label.new(bar_index, low, kzLbl2L, color=color.new(color.white, 100), textcolor=color.new(londonKZColor, 0), style=label.style_label_left, size=vizKzLblSz)
            if kzShowMean
                if kzExtendPivots == "Sonraki Seansa Kadar" and not na(londonMidLine)
                    line.delete(londonMidLine)
                londonMidLine := line.new(bar_index, (high + low) / 2, bar_index, (high + low) / 2, color=color.new(londonKZColor, 30), style=kzMidLineStyle, width=vizKzLineWidth)
        else
            londonKZHigh := math.max(nz(londonKZHigh, high), high)
            londonKZLow  := math.min(nz(londonKZLow, low), low)
            if kzShowBg and not na(londonBgBox)
                box.set_top(londonBgBox, londonKZHigh)
                box.set_bottom(londonBgBox, londonKZLow)
                box.set_right(londonBgBox, bar_index)
            if kzShowLabels and not na(londonNameLbl)
                label.set_y(londonNameLbl, londonKZHigh)
            if kzShowLines
                if not na(londonPivotH)
                    line.set_y1(londonPivotH, londonKZHigh)
                    line.set_y2(londonPivotH, londonKZHigh)
                    line.set_x2(londonPivotH, bar_index)
                if not na(londonPivotL)
                    line.set_y1(londonPivotL, londonKZLow)
                    line.set_y2(londonPivotL, londonKZLow)
                    line.set_x2(londonPivotL, bar_index)
                if not na(londonPivotHLbl)
                    label.set_y(londonPivotHLbl, londonKZHigh)
                    label.set_x(londonPivotHLbl, bar_index)
                if not na(londonPivotLLbl)
                    label.set_y(londonPivotLLbl, londonKZLow)
                    label.set_x(londonPivotLLbl, bar_index)
            if kzShowMean and not na(londonMidLine)
                londonMid = (londonKZHigh + nz(londonKZLow)) / 2
                line.set_y1(londonMidLine, londonMid)
                line.set_y2(londonMidLine, londonMid)
                line.set_x2(londonMidLine, bar_index)
    else
        if kzShowLines
            if not londonHMitigated and not na(londonPivotH)
                line.set_x2(londonPivotH, bar_index)
            if not londonHMitigated and not na(londonPivotHLbl)
                label.set_x(londonPivotHLbl, bar_index)
            if not londonLMitigated and not na(londonPivotL)
                line.set_x2(londonPivotL, bar_index)
            if not londonLMitigated and not na(londonPivotLLbl)
                label.set_x(londonPivotLLbl, bar_index)
        if kzShowMean and not na(londonMidLine) and not londonHMitigated and not londonLMitigated
            line.set_x2(londonMidLine, bar_index)
        if kzStopMitigated and kzShowLines
            if not londonHMitigated and not na(londonPivotH) and not na(londonKZHigh) and close > londonKZHigh
                londonHMitigated := true
            if not londonLMitigated and not na(londonPivotL) and not na(londonKZLow) and close < londonKZLow
                londonLMitigated := true
    prevLondonKZ := isLonKZ

