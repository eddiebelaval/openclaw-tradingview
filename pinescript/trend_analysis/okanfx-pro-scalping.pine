                nyAMPivotH := line.new(bar_index, high, bar_index, high, color=color.new(nyAMColor, 0), style=kzPivotLineStyle, width=vizKzLineWidth)
                nyAMPivotL := line.new(bar_index, low, bar_index, low, color=color.new(nyAMColor, 0), style=kzPivotLineStyle, width=vizKzLineWidth)
                nyAMPivotHLbl := label.new(bar_index, high, kzLbl3H, color=color.new(color.white, 100), textcolor=color.new(nyAMColor, 0), style=label.style_label_left, size=vizKzLblSz)
                nyAMPivotLLbl := label.new(bar_index, low, kzLbl3L, color=color.new(color.white, 100), textcolor=color.new(nyAMColor, 0), style=label.style_label_left, size=vizKzLblSz)
            if kzShowMean
                if kzExtendPivots == "Sonraki Seansa Kadar" and not na(nyAMMidLine)
