showNWOG         = input.bool(true, "NWOG/NDOG Goster", tooltip="Haftalik/Gunluk acilis boslugu", group=grp_ict)
nwogColor        = input.color(color.new(color.aqua, 80), "NWOG/NDOG Rengi", group=grp_ict)
showAMD          = input.bool(true, "Power of 3 (AMD)", tooltip="Accumulation-Manipulation-Distribution seans dongusu", group=grp_ict)

