                if not na(nyPMNameLbl)
                    label.delete(nyPMNameLbl)
                nyPMNameLbl := label.new(bar_index, high, "NY PM", color=color.new(color.white, 100), textcolor=nyPMColor, style=label.style_label_down, size=vizKzLblSz)
            if kzShowLines
                if kzExtendPivots == "Sonraki Seansa Kadar"
                    if not na(nyPMPivotH)
                        line.delete(nyPMPivotH)
                    if not na(nyPMPivotL)
                        line.delete(nyPMPivotL)
                    if not na(nyPMPivotHLbl)
                        label.delete(nyPMPivotHLbl)
                    if not na(nyPMPivotLLbl)
                        label.delete(nyPMPivotLLbl)
                nyPMPivotH := line.new(bar_index, high, bar_index, high, color=color.new(nyPMColor, 0), style=kzPivotLineStyle, width=vizKzLineWidth)
                nyPMPivotL := line.new(bar_index, low, bar_index, low, color=color.new(nyPMColor, 0), style=kzPivotLineStyle, width=vizKzLineWidth)
                nyPMPivotHLbl := label.new(bar_index, high, kzLbl5H, color=color.new(color.white, 100), textcolor=color.new(nyPMColor, 0), style=label.style_label_left, size=vizKzLblSz)
                nyPMPivotLLbl := label.new(bar_index, low, kzLbl5L, color=color.new(color.white, 100), textcolor=color.new(nyPMColor, 0), style=label.style_label_left, size=vizKzLblSz)
            if kzShowMean
                if kzExtendPivots == "Sonraki Seansa Kadar" and not na(nyPMMidLine)
                    line.delete(nyPMMidLine)
                nyPMMidLine := line.new(bar_index, (high + low) / 2, bar_index, (high + low) / 2, color=color.new(nyPMColor, 30), style=kzMidLineStyle, width=vizKzLineWidth)
        else
            nyPMHigh := math.max(nz(nyPMHigh, high), high)
            nyPMLow  := math.min(nz(nyPMLow, low), low)
            if kzShowBg and not na(nyPMBgBox)
                box.set_top(nyPMBgBox, nyPMHigh)
                box.set_bottom(nyPMBgBox, nyPMLow)
                box.set_right(nyPMBgBox, bar_index)
            if kzShowLabels and not na(nyPMNameLbl)
                label.set_y(nyPMNameLbl, nyPMHigh)
            if kzShowLines
                if not na(nyPMPivotH)
                    line.set_y1(nyPMPivotH, nyPMHigh)
                    line.set_y2(nyPMPivotH, nyPMHigh)
                    line.set_x2(nyPMPivotH, bar_index)
                if not na(nyPMPivotL)
                    line.set_y1(nyPMPivotL, nyPMLow)
                    line.set_y2(nyPMPivotL, nyPMLow)
                    line.set_x2(nyPMPivotL, bar_index)
                if not na(nyPMPivotHLbl)
                    label.set_y(nyPMPivotHLbl, nyPMHigh)
                    label.set_x(nyPMPivotHLbl, bar_index)
                if not na(nyPMPivotLLbl)
                    label.set_y(nyPMPivotLLbl, nyPMLow)
                    label.set_x(nyPMPivotLLbl, bar_index)
            if kzShowMean and not na(nyPMMidLine)
                nyPMMid = (nyPMHigh + nz(nyPMLow)) / 2
                line.set_y1(nyPMMidLine, nyPMMid)
                line.set_y2(nyPMMidLine, nyPMMid)
                line.set_x2(nyPMMidLine, bar_index)
    else
        if kzShowLines
            if not nyPMHMitigated and not na(nyPMPivotH)
                line.set_x2(nyPMPivotH, bar_index)
            if not nyPMHMitigated and not na(nyPMPivotHLbl)
                label.set_x(nyPMPivotHLbl, bar_index)
            if not nyPMLMitigated and not na(nyPMPivotL)
                line.set_x2(nyPMPivotL, bar_index)
            if not nyPMLMitigated and not na(nyPMPivotLLbl)
                label.set_x(nyPMPivotLLbl, bar_index)
        if kzShowMean and not na(nyPMMidLine) and not nyPMHMitigated and not nyPMLMitigated
            line.set_x2(nyPMMidLine, bar_index)
        if kzStopMitigated and kzShowLines
            if not nyPMHMitigated and not na(nyPMPivotH) and not na(nyPMHigh) and close > nyPMHigh
                nyPMHMitigated := true
            if not nyPMLMitigated and not na(nyPMPivotL) and not na(nyPMLow) and close < nyPMLow
                nyPMLMitigated := true
    prevNYPM := isNYPMKZ

// SESSION VWAP (London / NY)
// ============================================================================

var float londonCumVol  = 0.0
var float londonCumPV   = 0.0
var float nyCumVol      = 0.0
var float nyCumPV       = 0.0
var float londonVWAPVal = na
var float nyVWAPVal     = na
var bool  prevLondonVWAP = false
var bool  prevNYVWAP     = false

svwapLonStartH = parseHour(svwapLondonStart)
svwapLonStartM = parseMinute(svwapLondonStart)
svwapLonEndH   = parseHour(svwapLondonEnd)
svwapLonEndM   = parseMinute(svwapLondonEnd)
svwapNYStartH  = parseHour(svwapNYStart)
svwapNYStartM  = parseMinute(svwapNYStart)
svwapNYEndH    = parseHour(svwapNYEnd)
svwapNYEndM    = parseMinute(svwapNYEnd)

lonVWAPSession = isInSession(svwapLonStartH, svwapLonStartM, svwapLonEndH, svwapLonEndM)
nyVWAPSession  = isInSession(svwapNYStartH, svwapNYStartM, svwapNYEndH, svwapNYEndM)

if showSessionVWAP
    if lonVWAPSession
        if not prevLondonVWAP
            londonCumVol := volume
            londonCumPV  := hlc3 * volume
        else
            londonCumVol := londonCumVol + volume
            londonCumPV  := londonCumPV + hlc3 * volume
        londonVWAPVal := londonCumVol > 0 ? londonCumPV / londonCumVol : na
    else
        londonVWAPVal := na
    prevLondonVWAP := lonVWAPSession
    
    if nyVWAPSession
        if not prevNYVWAP
            nyCumVol := volume
            nyCumPV  := hlc3 * volume
        else
            nyCumVol := nyCumVol + volume
            nyCumPV  := nyCumPV + hlc3 * volume
        nyVWAPVal := nyCumVol > 0 ? nyCumPV / nyCumVol : na
    else
        nyVWAPVal := na
    prevNYVWAP := nyVWAPSession

plot(showSessionVWAP ? londonVWAPVal : na, "London VWAP", color=svwapLondonColor, linewidth=svwapWidth, style=plot.style_line)
plot(showSessionVWAP ? nyVWAPVal : na, "NY VWAP", color=svwapNYColor, linewidth=svwapWidth, style=plot.style_line)

// ============================================================================
// ============================================================================
// ICT SILVER BULLET
// ============================================================================

// Silver Bullet pencereleri (UTC): 08-09, 15-16, 19-20
isSilverBullet = utcHour == 8 or utcHour == 15 or utcHour == 19

// ICT JUDAS SWING (SAHTE KIRILMA) TESPITI
// ============================================================================

bullishJudas = false
bearishJudas = false

if showJudasSwing and isKillzone and bar_index > judasLookback
    recentHigh = ta.highest(high, judasLookback)
    recentLow  = ta.lowest(low, judasLookback)
    
    if high >= recentHigh and close < open and close < (high + low) / 2
        bearishJudas := true
    
    if low <= recentLow and close > open and close > (high + low) / 2
        bullishJudas := true

plotshape(showJudasSwing and bullishJudas, "Bull Judas", shape.triangleup, location.belowbar, color.new(color.lime, 10), size=size.tiny, text="JS")
plotshape(showJudasSwing and bearishJudas, "Bear Judas", shape.triangledown, location.abovebar, color.new(color.red, 10), size=size.tiny, text="JS")

// ============================================================================
// ICT UNICORN MODEL (BB + FVG CAKISMASI)
// ============================================================================

// Unicorn: en son BB ile herhangi bir FVG ust uste geliyorsa
var bool bullishUnicorn = false
var bool bearishUnicorn = false
bullishUnicorn := false
bearishUnicorn := false

if showUnicorn and array.size(bullBBBoxes) > 0 and array.size(bullFVGBoxes) > 0
    bT = box.get_top(array.get(bullBBBoxes, array.size(bullBBBoxes) - 1))
    bB = box.get_bottom(array.get(bullBBBoxes, array.size(bullBBBoxes) - 1))
    for j = 0 to array.size(bullFVGBoxes) - 1
        fT = box.get_top(array.get(bullFVGBoxes, j))
        fB = box.get_bottom(array.get(bullFVGBoxes, j))
        if bT >= fB and bB <= fT
            bullishUnicorn := true

if showUnicorn and array.size(bearBBBoxes) > 0 and array.size(bearFVGBoxes) > 0
    bT = box.get_top(array.get(bearBBBoxes, array.size(bearBBBoxes) - 1))
    bB = box.get_bottom(array.get(bearBBBoxes, array.size(bearBBBoxes) - 1))
    for j = 0 to array.size(bearFVGBoxes) - 1
        fT = box.get_top(array.get(bearFVGBoxes, j))
        fB = box.get_bottom(array.get(bearFVGBoxes, j))
        if bT >= fB and bB <= fT
            bearishUnicorn := true

// ============================================================================
// ICT POWER OF 3 (AMD - ACCUMULATION, MANIPULATION, DISTRIBUTION)
// ============================================================================

amdPhase = ""
if showAMD and isKillzone
    kzStart = isAsianKZ ? asianStartH : isLonKZ ? londonKZStartH : isNYAMKZ ? nyAMStartH : isNYLunchKZ ? nyLunchStartH : nyPMStartH
    kzHour = kzHourLocal - kzStart
    if kzHour < 0
        kzHour := kzHour + 24
    if kzHour == 0
        amdPhase := "ACCUMULATION"
    else if kzHour == 1
        amdPhase := "MANIPULATION"
    else if kzHour == 2
        amdPhase := "DISTRIBUTION"

var string prevAMD = ""
showAMDLabel = showAMD and amdPhase != "" and amdPhase != prevAMD
if amdPhase != ""
    prevAMD := amdPhase

amdColor = amdPhase == "ACCUMULATION" ? color.new(color.gray, 40) : amdPhase == "MANIPULATION" ? color.new(color.red, 40) : amdPhase == "DISTRIBUTION" ? color.new(color.green, 40) : na
plotshape(showAMDLabel, "AMD Phase", shape.square, location.bottom, amdColor, size=size.tiny, text="", textcolor=color.white)

// ============================================================================
// AUTO TREND LINE DRAWING (Zaman Dilimi + Tolerans destekli)
// ============================================================================

// Trend TF kodu donusumu
trendTFCode = trendLineTF == "1 Dk" ? "1" : trendLineTF == "3 Dk" ? "3" : trendLineTF == "5 Dk" ? "5" : trendLineTF == "15 Dk" ? "15" : trendLineTF == "30 Dk" ? "30" : trendLineTF == "1 Saat" ? "60" : trendLineTF == "2 Saat" ? "120" : trendLineTF == "4 Saat" ? "240" : trendLineTF == "Gunluk" ? "D" : trendLineTF == "Haftalik" ? "W" : ""

// Cizgi stili donusumu
trendUpLS = trendUpStyle == "Kesikli" ? line.style_dashed : trendUpStyle == "Noktali" ? line.style_dotted : line.style_solid
trendDnLS = trendDnStyle == "Kesikli" ? line.style_dashed : trendDnStyle == "Noktali" ? line.style_dotted : line.style_solid

// Tolerans hesabi: 0 = saf fitil, yuksek = govde kapanisina yakin
tolPct = trendLineTolerance / 100.0
trendHighSrc = tolPct > 0 ? high - (high - math.max(open, close)) * tolPct : high
trendLowSrc  = tolPct > 0 ? low  + (math.min(open, close) - low) * tolPct : low

var line trendUpLine = na
var line trendDnLine = na
var label trendUpLbl = na
var label trendDnLbl = na
var float trendSwL1 = na
var float trendSwL2 = na
var int   trendSwL1Bar = na
var int   trendSwL2Bar = na
var float trendSwH1 = na
var float trendSwH2 = na
var int   trendSwH1Bar = na
var int   trendSwH2Bar = na

if showTrendLine
    tLB = trendLineLookback
    pivHi = ta.pivothigh(trendHighSrc, tLB, tLB)
    pivLo = ta.pivotlow(trendLowSrc, tLB, tLB)
    
    if not na(pivLo)
        trendSwL2 := trendSwL1
        trendSwL2Bar := trendSwL1Bar
        trendSwL1 := pivLo
        trendSwL1Bar := bar_index - tLB
    
    if not na(pivHi)
        trendSwH2 := trendSwH1
        trendSwH2Bar := trendSwH1Bar
        trendSwH1 := pivHi
        trendSwH1Bar := bar_index - tLB

if barstate.islast and showTrendLine
    // Uptrend line (Destek — swing lows)
    if not na(trendSwL1) and not na(trendSwL2) and not na(trendSwL1Bar) and not na(trendSwL2Bar)
        line.delete(trendUpLine)
        label.delete(trendUpLbl)
        trendUpLine := line.new(trendSwL2Bar, trendSwL2, trendSwL1Bar, trendSwL1, color=trendLineUpColor, width=trendLineWidth, style=trendUpLS, extend=trendLineExtend ? extend.right : extend.none)
        if showTrendLabel
            trendUpLbl := label.new(trendSwL1Bar, trendSwL1, "Destek", color=color.new(color.white, 100), textcolor=trendLineUpColor, style=label.style_label_up, size=vizLblSz)
    // Downtrend line (Direnc — swing highs)
    if not na(trendSwH1) and not na(trendSwH2) and not na(trendSwH1Bar) and not na(trendSwH2Bar)
        line.delete(trendDnLine)
        label.delete(trendDnLbl)
        trendDnLine := line.new(trendSwH2Bar, trendSwH2, trendSwH1Bar, trendSwH1, color=trendLineDnColor, width=trendLineWidth, style=trendDnLS, extend=trendLineExtend ? extend.right : extend.none)
        if showTrendLabel
            trendDnLbl := label.new(trendSwH1Bar, trendSwH1, "Direnc", color=color.new(color.white, 100), textcolor=trendLineDnColor, style=label.style_label_down, size=vizLblSz)

// ============================================================================
// HTF CANDLE OVERLAY (Box olarak HTF mumu cizimi)
// ============================================================================

var box htfCandleBox  = na
var box htfCandleWick = na
var label htfCandleLbl = na

htfCandleTFCode = htfCandleTF == "Haftalik" ? "W" : htfCandleTF == "Gunluk" ? "D" : htfCandleTF == "4 Saat" ? "240" : "60"
htfCO = request.security(syminfo.tickerid, htfCandleTFCode, open, lookahead=barmerge.lookahead_on)
htfCH = request.security(syminfo.tickerid, htfCandleTFCode, high, lookahead=barmerge.lookahead_on)
htfCL = request.security(syminfo.tickerid, htfCandleTFCode, low, lookahead=barmerge.lookahead_on)
htfCC = request.security(syminfo.tickerid, htfCandleTFCode, close, lookahead=barmerge.lookahead_on)

if barstate.islast and showHTFCandle
    box.delete(htfCandleBox)
    box.delete(htfCandleWick)
    label.delete(htfCandleLbl)
    
    isBullHTF = htfCC >= htfCO
    bodyTop = isBullHTF ? htfCC : htfCO
    bodyBot = isBullHTF ? htfCO : htfCC
    cColor = isBullHTF ? htfCandleBullColor : htfCandleBearColor
    
    htfCandleWick := box.new(bar_index + 15, htfCH, bar_index + 17, htfCL, bgcolor=color.new(cColor, 60), border_color=cColor, border_width=1)
    htfCandleBox  := box.new(bar_index + 13, bodyTop, bar_index + 19, bodyBot, bgcolor=color.new(cColor, 30), border_color=cColor, border_width=2)
    htfCandleLbl  := label.new(bar_index + 16, htfCH, htfCandleTF + "\nO:" + str.tostring(htfCO, format.mintick) + "\nH:" + str.tostring(htfCH, format.mintick) + "\nL:" + str.tostring(htfCL, format.mintick) + "\nC:" + str.tostring(htfCC, format.mintick), color=color.new(color.white, 100), textcolor=cColor, style=label.style_label_down, size=vizLblSz)

// ============================================================================
// PIVOT POINTS (Classic / Camarilla / Fibonacci)
// ============================================================================

// Onceki gun OHLC
prevDayH = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
prevDayL = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
prevDayC = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)

pivotPP = (prevDayH + prevDayL + prevDayC) / 3
pivotR1 = 0.0
pivotR2 = 0.0
pivotR3 = 0.0
pivotS1 = 0.0
pivotS2 = 0.0
pivotS3 = 0.0

if pivotType == "Klasik"
    pivotR1 := 2 * pivotPP - prevDayL
    pivotR2 := pivotPP + (prevDayH - prevDayL)
    pivotR3 := prevDayH + 2 * (pivotPP - prevDayL)
    pivotS1 := 2 * pivotPP - prevDayH
    pivotS2 := pivotPP - (prevDayH - prevDayL)
    pivotS3 := prevDayL - 2 * (prevDayH - pivotPP)
else if pivotType == "Fibonacci"
    pivotR1 := pivotPP + 0.382 * (prevDayH - prevDayL)
    pivotR2 := pivotPP + 0.618 * (prevDayH - prevDayL)
    pivotR3 := pivotPP + 1.000 * (prevDayH - prevDayL)
    pivotS1 := pivotPP - 0.382 * (prevDayH - prevDayL)
    pivotS2 := pivotPP - 0.618 * (prevDayH - prevDayL)
    pivotS3 := pivotPP - 1.000 * (prevDayH - prevDayL)
else if pivotType == "Camarilla"
    pivotR1 := prevDayC + 1.1 * (prevDayH - prevDayL) / 12
    pivotR2 := prevDayC + 1.1 * (prevDayH - prevDayL) / 6
    pivotR3 := prevDayC + 1.1 * (prevDayH - prevDayL) / 4
    pivotS1 := prevDayC - 1.1 * (prevDayH - prevDayL) / 12
    pivotS2 := prevDayC - 1.1 * (prevDayH - prevDayL) / 6
    pivotS3 := prevDayC - 1.1 * (prevDayH - prevDayL) / 4

var line pivPPLine  = na
var line pivR1Line  = na
var line pivR2Line  = na
var line pivR3Line  = na
var line pivS1Line  = na
var line pivS2Line  = na
var line pivS3Line  = na
var label pivPPLbl  = na
var label pivR1Lbl  = na
var label pivR2Lbl  = na
var label pivR3Lbl  = na
var label pivS1Lbl  = na
var label pivS2Lbl  = na
var label pivS3Lbl  = na

if barstate.islast and showPivots
    line.delete(pivPPLine)
    line.delete(pivR1Line)
    line.delete(pivR2Line)
    line.delete(pivR3Line)
    line.delete(pivS1Line)
    line.delete(pivS2Line)
    line.delete(pivS3Line)
    label.delete(pivPPLbl)
    label.delete(pivR1Lbl)
    label.delete(pivR2Lbl)
    label.delete(pivR3Lbl)
    label.delete(pivS1Lbl)
    label.delete(pivS2Lbl)
    label.delete(pivS3Lbl)
    
    pivPPLine := line.new(bar_index - 50, pivotPP, bar_index + 10, pivotPP, color=pivotColor, style=line.style_solid, width=pivotWidth)
    pivR1Line := line.new(bar_index - 50, pivotR1, bar_index + 10, pivotR1, color=pivotRColor, style=line.style_dashed, width=pivotWidth)
    pivR2Line := line.new(bar_index - 50, pivotR2, bar_index + 10, pivotR2, color=pivotRColor, style=line.style_dashed, width=pivotWidth)
    pivR3Line := line.new(bar_index - 50, pivotR3, bar_index + 10, pivotR3, color=pivotRColor, style=line.style_dashed, width=pivotWidth)
    pivS1Line := line.new(bar_index - 50, pivotS1, bar_index + 10, pivotS1, color=pivotSColor, style=line.style_dashed, width=pivotWidth)
    pivS2Line := line.new(bar_index - 50, pivotS2, bar_index + 10, pivotS2, color=pivotSColor, style=line.style_dashed, width=pivotWidth)
    pivS3Line := line.new(bar_index - 50, pivotS3, bar_index + 10, pivotS3, color=pivotSColor, style=line.style_dashed, width=pivotWidth)
    
    pivPPLbl := label.new(bar_index + 11, pivotPP, "PP", color=color.new(color.white, 100), textcolor=pivotColor, style=label.style_label_left, size=vizLblSz)
    pivR1Lbl := label.new(bar_index + 11, pivotR1, "R1", color=color.new(color.white, 100), textcolor=pivotRColor, style=label.style_label_left, size=vizLblSz)
    pivR2Lbl := label.new(bar_index + 11, pivotR2, "R2", color=color.new(color.white, 100), textcolor=pivotRColor, style=label.style_label_left, size=vizLblSz)
    pivR3Lbl := label.new(bar_index + 11, pivotR3, "R3", color=color.new(color.white, 100), textcolor=pivotRColor, style=label.style_label_left, size=vizLblSz)
    pivS1Lbl := label.new(bar_index + 11, pivotS1, "S1", color=color.new(color.white, 100), textcolor=pivotSColor, style=label.style_label_left, size=vizLblSz)
    pivS2Lbl := label.new(bar_index + 11, pivotS2, "S2", color=color.new(color.white, 100), textcolor=pivotSColor, style=label.style_label_left, size=vizLblSz)
    pivS3Lbl := label.new(bar_index + 11, pivotS3, "S3", color=color.new(color.white, 100), textcolor=pivotSColor, style=label.style_label_left, size=vizLblSz)

// ============================================================================
// TREND ANALIZI FONKSIYONLARI
// ============================================================================

getTrend(ema20Val, ema50Val, ema100Val, ema200Val, closeVal, rsiVal) =>
    score = 0
    if not na(closeVal)
        if not na(ema20Val) and closeVal > ema20Val
            score := score + 1
        if not na(ema50Val) and closeVal > ema50Val
            score := score + 1
        if not na(ema100Val) and closeVal > ema100Val
            score := score + 1
        if not na(ema200Val) and closeVal > ema200Val
            score := score + 1
        if not na(ema20Val) and not na(ema50Val) and ema20Val > ema50Val
            score := score + 1
        if nz(rsiVal) > 50
            score := score + 1
    score

currentScore  = getTrend(_ema20, _ema50, _ema100, _ema200, close, rsiValue)
dailyScore    = getTrend(dailyEma20, dailyEma50, dailyEma100, dailyEma200, dailyClose, dailyRSI)
h4Score       = getTrend(h4Ema20, h4Ema50, h4Ema100, h4Ema200, h4Close, h4RSI)
h1Score       = getTrend(h1Ema20, h1Ema50, h1Ema100, h1Ema200, h1Close, h1RSI)
m15Score      = getTrend(m15Ema20, m15Ema50, m15Ema100, m15Ema200, m15Close, m15RSI)
m5Score       = getTrend(m5Ema20, m5Ema50, m5Ema100, m5Ema200, m5Close, m5RSI)

volAboveAvg     = volume > nz(_volSMA)
dailyVolAbove   = nz(dailyVol) > nz(dailyVolSMA)
h4VolAbove      = nz(h4Vol) > nz(h4VolSMA)
h1VolAbove      = nz(h1Vol) > nz(h1VolSMA)
m15VolAbove     = nz(m15Vol) > nz(m15VolSMA)
m5VolAbove      = nz(m5Vol) > nz(m5VolSMA)

// (Sinyal motoru ve islem takibi kaldirildi — indikatör sadece yardimci araç olarak çalisiyor)

// DASHBOARD YARDIMCI FONKSIYONLARI
// ============================================================================

trendColor(score) =>
    score >= 5 ? color.new(color.green, 20) : score >= 4 ? color.new(color.green, 40) : score == 3 ? color.new(color.yellow, 30) : score >= 2 ? color.new(color.red, 40) : color.new(color.red, 20)

trendText(score) =>
    score >= 5 ? "Guclu AL" : score >= 4 ? "AL" : score == 3 ? "Notr" : score >= 2 ? "SAT" : "Guclu SAT"

emaStatusFn(closeVal, emaVal) =>
    nz(closeVal) > nz(emaVal) ? "Ust" : "Alt"

emaColorFn(closeVal, emaVal) =>
    nz(closeVal) > nz(emaVal) ? color.new(color.green, 30) : color.new(color.red, 30)

volColorFn(isAbove) =>
    isAbove ? color.new(color.green, 30) : color.new(color.red, 30)

volTextFn(isAbove) =>
    isAbove ? "Yuksek" : "Dusuk"

// ============================================================================
// DASHBOARD EK METRIKLER
// ============================================================================

// Gunluk Range % — bugunun H/L'si onceki gunun ATR'sine oran
var float todayHigh = na
var float todayLow = na
if ta.change(time("D"))
    todayHigh := high
    todayLow := low
else
    todayHigh := math.max(nz(todayHigh), high)
    todayLow := math.min(nz(todayLow, high), low)
rangeUsedPct = nz(dailyATR) > 0 ? (nz(todayHigh) - nz(todayLow)) / nz(dailyATR) * 100 : 0

// EMA Siralama — mevcut TF'de EMA'lar sirali mi
emaAlignedBull = nz(ema1) > nz(ema2) and nz(ema2) > nz(ema3) and nz(ema3) > nz(ema4)
emaAlignedBear = nz(ema1) < nz(ema2) and nz(ema2) < nz(ema3) and nz(ema3) < nz(ema4)
emaAlignText = emaAlignedBull ? "↑ Sirali" : emaAlignedBear ? "↓ Sirali" : "Karisik"
emaAlignClr = emaAlignedBull ? color.new(color.green, 30) : emaAlignedBear ? color.new(color.red, 30) : color.new(color.yellow, 30)

// Confluence Skoru — kac TF ayni yonde (bullish: score>=4, bearish: score<=2)
bullTFCount = (dailyScore >= 4 ? 1 : 0) + (h4Score >= 4 ? 1 : 0) + (h1Score >= 4 ? 1 : 0) + (m15Score >= 4 ? 1 : 0) + (m5Score >= 4 ? 1 : 0)
bearTFCount = (dailyScore <= 2 ? 1 : 0) + (h4Score <= 2 ? 1 : 0) + (h1Score <= 2 ? 1 : 0) + (m15Score <= 2 ? 1 : 0) + (m5Score <= 2 ? 1 : 0)
confText = bullTFCount >= bearTFCount ? str.tostring(bullTFCount) + "/5 AL" : str.tostring(bearTFCount) + "/5 SAT"
confClr = bullTFCount >= 4 ? color.new(color.green, 20) : bearTFCount >= 4 ? color.new(color.red, 20) : bullTFCount >= 3 ? color.new(color.green, 40) : bearTFCount >= 3 ? color.new(color.red, 40) : color.new(color.yellow, 30)

// ============================================================================
// DASHBOARD TABLOSU
// ============================================================================

var table dashboard = na

if showDashboard and barstate.islast
    tablePos = dashboardPosition == "Sol Ust" ? position.top_left : dashboardPosition == "Sag Ust" ? position.top_right : dashboardPosition == "Sol Alt" ? position.bottom_left : position.bottom_right
    tableSize = dashboardSize == "tiny" ? size.tiny : dashboardSize == "small" ? size.small : dashboardSize == "normal" ? size.normal : size.large
    
    if na(dashboard)
        dashboard := table.new(tablePos, 9, 13, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 50))
    
    // ── BOLUM 1: MULTI-TIMEFRAME TREND ANALIZI ──
    table.cell(dashboard, 0, 0, "Zaman", text_color=color.white, text_size=tableSize, bgcolor=color.new(#1a1a2e, 0))
    table.cell(dashboard, 1, 0, "Trend", text_color=color.white, text_size=tableSize, bgcolor=color.new(#1a1a2e, 0))
    table.cell(dashboard, 2, 0, "RSI", text_color=color.white, text_size=tableSize, bgcolor=color.new(#1a1a2e, 0))
    table.cell(dashboard, 3, 0, "EMA" + str.tostring(emaLen1), text_color=color.white, text_size=tableSize, bgcolor=color.new(#1a1a2e, 0))
    table.cell(dashboard, 4, 0, "EMA" + str.tostring(emaLen2), text_color=color.white, text_size=tableSize, bgcolor=color.new(#1a1a2e, 0))
    table.cell(dashboard, 5, 0, "EMA" + str.tostring(emaLen3), text_color=color.white, text_size=tableSize, bgcolor=color.new(#1a1a2e, 0))
    table.cell(dashboard, 6, 0, "EMA" + str.tostring(emaLen4), text_color=color.white, text_size=tableSize, bgcolor=color.new(#1a1a2e, 0))
    table.cell(dashboard, 7, 0, "Hacim", text_color=color.white, text_size=tableSize, bgcolor=color.new(#1a1a2e, 0))
    table.cell(dashboard, 8, 0, "ATR", text_color=color.white, text_size=tableSize, bgcolor=color.new(#1a1a2e, 0))
    
    // Gunluk satir
    table.cell(dashboard, 0, 1, "Gunluk", text_color=color.white, text_size=tableSize, bgcolor=color.new(color.gray, 50))
    table.cell(dashboard, 1, 1, trendText(dailyScore), text_color=color.white, text_size=tableSize, bgcolor=trendColor(dailyScore))
    table.cell(dashboard, 2, 1, str.tostring(math.round(nz(dailyRSILive), 1)), text_color=color.white, text_size=tableSize, bgcolor=nz(dailyRSILive) > rsiOverbought ? color.new(color.red, 30) : nz(dailyRSILive) < rsiOversold ? color.new(color.green, 30) : color.new(color.gray, 50))
    table.cell(dashboard, 3, 1, emaStatusFn(dailyClose, dailyEma20), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(dailyClose, dailyEma20))
    table.cell(dashboard, 4, 1, emaStatusFn(dailyClose, dailyEma50), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(dailyClose, dailyEma50))
    table.cell(dashboard, 5, 1, emaStatusFn(dailyClose, dailyEma100), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(dailyClose, dailyEma100))
    table.cell(dashboard, 6, 1, emaStatusFn(dailyClose, dailyEma200), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(dailyClose, dailyEma200))
    table.cell(dashboard, 7, 1, volTextFn(dailyVolAbove), text_color=color.white, text_size=tableSize, bgcolor=volColorFn(dailyVolAbove))
    table.cell(dashboard, 8, 1, str.tostring(math.round(nz(dailyATR), 5)), text_color=color.white, text_size=tableSize, bgcolor=color.new(color.gray, 50))
    
    // 4 Saat satir
    table.cell(dashboard, 0, 2, "4 Saat", text_color=color.white, text_size=tableSize, bgcolor=color.new(color.gray, 50))
    table.cell(dashboard, 1, 2, trendText(h4Score), text_color=color.white, text_size=tableSize, bgcolor=trendColor(h4Score))
    table.cell(dashboard, 2, 2, str.tostring(math.round(nz(h4RSILive), 1)), text_color=color.white, text_size=tableSize, bgcolor=nz(h4RSILive) > rsiOverbought ? color.new(color.red, 30) : nz(h4RSILive) < rsiOversold ? color.new(color.green, 30) : color.new(color.gray, 50))
    table.cell(dashboard, 3, 2, emaStatusFn(h4Close, h4Ema20), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(h4Close, h4Ema20))
    table.cell(dashboard, 4, 2, emaStatusFn(h4Close, h4Ema50), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(h4Close, h4Ema50))
    table.cell(dashboard, 5, 2, emaStatusFn(h4Close, h4Ema100), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(h4Close, h4Ema100))
    table.cell(dashboard, 6, 2, emaStatusFn(h4Close, h4Ema200), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(h4Close, h4Ema200))
    table.cell(dashboard, 7, 2, volTextFn(h4VolAbove), text_color=color.white, text_size=tableSize, bgcolor=volColorFn(h4VolAbove))
    table.cell(dashboard, 8, 2, str.tostring(math.round(nz(h4ATR), 5)), text_color=color.white, text_size=tableSize, bgcolor=color.new(color.gray, 50))
    
    // 1 Saat satir
    table.cell(dashboard, 0, 3, "1 Saat", text_color=color.white, text_size=tableSize, bgcolor=color.new(color.gray, 50))
    table.cell(dashboard, 1, 3, trendText(h1Score), text_color=color.white, text_size=tableSize, bgcolor=trendColor(h1Score))
    table.cell(dashboard, 2, 3, str.tostring(math.round(nz(h1RSILive), 1)), text_color=color.white, text_size=tableSize, bgcolor=nz(h1RSILive) > rsiOverbought ? color.new(color.red, 30) : nz(h1RSILive) < rsiOversold ? color.new(color.green, 30) : color.new(color.gray, 50))
    table.cell(dashboard, 3, 3, emaStatusFn(h1Close, h1Ema20), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(h1Close, h1Ema20))
    table.cell(dashboard, 4, 3, emaStatusFn(h1Close, h1Ema50), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(h1Close, h1Ema50))
    table.cell(dashboard, 5, 3, emaStatusFn(h1Close, h1Ema100), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(h1Close, h1Ema100))
    table.cell(dashboard, 6, 3, emaStatusFn(h1Close, h1Ema200), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(h1Close, h1Ema200))
    table.cell(dashboard, 7, 3, volTextFn(h1VolAbove), text_color=color.white, text_size=tableSize, bgcolor=volColorFn(h1VolAbove))
    table.cell(dashboard, 8, 3, str.tostring(math.round(nz(h1ATR), 5)), text_color=color.white, text_size=tableSize, bgcolor=color.new(color.gray, 50))
    
    // 15 Dk satir
    table.cell(dashboard, 0, 4, "15 Dk", text_color=color.white, text_size=tableSize, bgcolor=color.new(color.gray, 50))
    table.cell(dashboard, 1, 4, trendText(m15Score), text_color=color.white, text_size=tableSize, bgcolor=trendColor(m15Score))
    table.cell(dashboard, 2, 4, str.tostring(math.round(nz(m15RSILive), 1)), text_color=color.white, text_size=tableSize, bgcolor=nz(m15RSILive) > rsiOverbought ? color.new(color.red, 30) : nz(m15RSILive) < rsiOversold ? color.new(color.green, 30) : color.new(color.gray, 50))
    table.cell(dashboard, 3, 4, emaStatusFn(m15Close, m15Ema20), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(m15Close, m15Ema20))
    table.cell(dashboard, 4, 4, emaStatusFn(m15Close, m15Ema50), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(m15Close, m15Ema50))
    table.cell(dashboard, 5, 4, emaStatusFn(m15Close, m15Ema100), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(m15Close, m15Ema100))
    table.cell(dashboard, 6, 4, emaStatusFn(m15Close, m15Ema200), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(m15Close, m15Ema200))
    table.cell(dashboard, 7, 4, volTextFn(m15VolAbove), text_color=color.white, text_size=tableSize, bgcolor=volColorFn(m15VolAbove))
    table.cell(dashboard, 8, 4, str.tostring(math.round(nz(m15ATR), 5)), text_color=color.white, text_size=tableSize, bgcolor=color.new(color.gray, 50))
    
    // 5 Dk satir
    table.cell(dashboard, 0, 5, "5 Dk", text_color=color.white, text_size=tableSize, bgcolor=color.new(color.gray, 50))
    table.cell(dashboard, 1, 5, trendText(m5Score), text_color=color.white, text_size=tableSize, bgcolor=trendColor(m5Score))
    table.cell(dashboard, 2, 5, str.tostring(math.round(nz(m5RSILive), 1)), text_color=color.white, text_size=tableSize, bgcolor=nz(m5RSILive) > rsiOverbought ? color.new(color.red, 30) : nz(m5RSILive) < rsiOversold ? color.new(color.green, 30) : color.new(color.gray, 50))
    table.cell(dashboard, 3, 5, emaStatusFn(m5Close, m5Ema20), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(m5Close, m5Ema20))
    table.cell(dashboard, 4, 5, emaStatusFn(m5Close, m5Ema50), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(m5Close, m5Ema50))
    table.cell(dashboard, 5, 5, emaStatusFn(m5Close, m5Ema100), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(m5Close, m5Ema100))
    table.cell(dashboard, 6, 5, emaStatusFn(m5Close, m5Ema200), text_color=color.white, text_size=tableSize, bgcolor=emaColorFn(m5Close, m5Ema200))
    table.cell(dashboard, 7, 5, volTextFn(m5VolAbove), text_color=color.white, text_size=tableSize, bgcolor=volColorFn(m5VolAbove))
    table.cell(dashboard, 8, 5, str.tostring(math.round(nz(m5ATR), 5)), text_color=color.white, text_size=tableSize, bgcolor=color.new(color.gray, 50))
    
    // ── BOLUM 2: FIYAT SEVIYELERI ──
    table.cell(dashboard, 0, 6, "Seviye", text_color=color.white, text_size=tableSize, bgcolor=color.new(#16213e, 0))
    table.cell(dashboard, 1, 6, "Onceki H", text_color=color.white, text_size=tableSize, bgcolor=color.new(#16213e, 0))
    table.cell(dashboard, 2, 6, "Onceki L", text_color=color.white, text_size=tableSize, bgcolor=color.new(#16213e, 0))
    table.cell(dashboard, 3, 6, "VWAP", text_color=color.white, text_size=tableSize, bgcolor=color.new(#16213e, 0))
    table.cell(dashboard, 4, 6, "Bugun H", text_color=color.white, text_size=tableSize, bgcolor=color.new(#16213e, 0))
    table.cell(dashboard, 5, 6, "Bugun L", text_color=color.white, text_size=tableSize, bgcolor=color.new(#16213e, 0))
    table.cell(dashboard, 6, 6, "Range%", text_color=color.white, text_size=tableSize, bgcolor=color.new(#16213e, 0))
    table.cell(dashboard, 7, 6, "EMA Dur.", text_color=color.white, text_size=tableSize, bgcolor=color.new(#16213e, 0))
    table.cell(dashboard, 8, 6, "Konfluens", text_color=color.white, text_size=tableSize, bgcolor=color.new(#16213e, 0))
    
    // Seviye degerleri
    rangePctText = "%" + str.tostring(math.round(rangeUsedPct, 0))
    rangePctClr = rangeUsedPct >= 100 ? color.new(color.red, 20) : rangeUsedPct >= 70 ? color.new(color.orange, 30) : color.new(color.green, 30)
    table.cell(dashboard, 0, 7, "Deger", text_color=color.white, text_size=tableSize, bgcolor=color.new(color.gray, 60))
    table.cell(dashboard, 1, 7, str.tostring(nz(dailyHigh), format.mintick), text_color=color.white, text_size=tableSize, bgcolor=close > nz(dailyHigh) ? color.new(color.green, 30) : color.new(color.gray, 60))
    table.cell(dashboard, 2, 7, str.tostring(nz(dailyLow), format.mintick), text_color=color.white, text_size=tableSize, bgcolor=close < nz(dailyLow) ? color.new(color.red, 30) : color.new(color.gray, 60))
    table.cell(dashboard, 3, 7, str.tostring(nz(vwapValue), format.mintick), text_color=color.white, text_size=tableSize, bgcolor=close > nz(vwapValue) ? color.new(color.green, 30) : color.new(color.red, 30))
    table.cell(dashboard, 4, 7, str.tostring(nz(todayHigh), format.mintick), text_color=color.white, text_size=tableSize, bgcolor=color.new(color.green, 40))
    table.cell(dashboard, 5, 7, str.tostring(nz(todayLow), format.mintick), text_color=color.white, text_size=tableSize, bgcolor=color.new(color.red, 40))
    table.cell(dashboard, 6, 7, rangePctText, text_color=color.white, text_size=tableSize, bgcolor=rangePctClr)
    table.cell(dashboard, 7, 7, emaAlignText, text_color=color.white, text_size=tableSize, bgcolor=emaAlignClr)
    table.cell(dashboard, 8, 7, confText, text_color=color.white, text_size=tableSize, bgcolor=confClr)
    
    // ── BOLUM 3: ICT STRATEJI DURUMU ──
    table.cell(dashboard, 0, 8, "ICT", text_color=color.white, text_size=tableSize, bgcolor=color.new(#2d1b69, 0))
    table.cell(dashboard, 1, 8, "Seans", text_color=color.white, text_size=tableSize, bgcolor=color.new(#2d1b69, 0))
    table.cell(dashboard, 2, 8, "Silver B.", text_color=color.white, text_size=tableSize, bgcolor=color.new(#2d1b69, 0))
    table.cell(dashboard, 3, 8, "OTE", text_color=color.white, text_size=tableSize, bgcolor=color.new(#2d1b69, 0))
    table.cell(dashboard, 4, 8, "Yer.Deg.", text_color=color.white, text_size=tableSize, bgcolor=color.new(#2d1b69, 0))
    table.cell(dashboard, 5, 8, "Breaker", text_color=color.white, text_size=tableSize, bgcolor=color.new(#2d1b69, 0))
    table.cell(dashboard, 6, 8, "Bolge", text_color=color.white, text_size=tableSize, bgcolor=color.new(#2d1b69, 0))
    table.cell(dashboard, 7, 8, "Unicorn", text_color=color.white, text_size=tableSize, bgcolor=color.new(#2d1b69, 0))
    table.cell(dashboard, 8, 8, "Faz", text_color=color.white, text_size=tableSize, bgcolor=color.new(#2d1b69, 0))
    
    // ICT Durum Degerleri
    kzText = isKillzone ? (isAsianKZ ? "Asian" : isLonKZ ? "London" : isNYAMKZ ? "NY AM" : isNYLunchKZ ? "NY Lunch" : "NY PM") : "Kapali"
    kzClr = isKillzone ? color.new(color.green, 30) : color.new(color.gray, 60)
    sbText = isSilverBullet ? "Aktif" : "Kapali"
    sbClr = isSilverBullet ? color.new(color.green, 30) : color.new(color.gray, 60)
    oteText = inOTE ? "Aktif" : "Kapali"
    oteClr = inOTE ? color.new(color.green, 30) : color.new(color.gray, 60)
    dispText = bullishDisplacement ? "Yukari" : bearishDisplacement ? "Asagi" : "Yok"
    dispClr = bullishDisplacement ? color.new(color.green, 30) : bearishDisplacement ? color.new(color.red, 30) : color.new(color.gray, 60)
    bbCount = array.size(bullBBBoxes) + array.size(bearBBBoxes)
    bbText = str.tostring(bbCount) + " adet"
    bbClr = bbCount > 0 ? color.new(color.green, 30) : color.new(color.gray, 60)
    pdText = inPremium ? "Premium" : inDiscount ? "Discount" : "Notr"
    pdClr = inPremium ? color.new(color.red, 30) : inDiscount ? color.new(color.green, 30) : color.new(color.gray, 60)
    uniText = bullishUnicorn ? "Yukari" : bearishUnicorn ? "Asagi" : "Yok"
    uniClr = bullishUnicorn ? color.new(color.green, 30) : bearishUnicorn ? color.new(color.red, 30) : color.new(color.gray, 60)
    amdText2 = amdPhase == "ACCUMULATION" ? "Birikim" : amdPhase == "MANIPULATION" ? "Manipule" : amdPhase == "DISTRIBUTION" ? "Dagitim" : "—"
    amdClr2 = amdPhase == "ACCUMULATION" ? color.new(color.gray, 30) : amdPhase == "MANIPULATION" ? color.new(color.red, 30) : amdPhase == "DISTRIBUTION" ? color.new(color.green, 30) : color.new(color.gray, 60)
    
    table.cell(dashboard, 0, 9, "Durum", text_color=color.white, text_size=tableSize, bgcolor=color.new(color.gray, 60))
    table.cell(dashboard, 1, 9, kzText, text_color=color.white, text_size=tableSize, bgcolor=kzClr)
    table.cell(dashboard, 2, 9, sbText, text_color=color.white, text_size=tableSize, bgcolor=sbClr)
    table.cell(dashboard, 3, 9, oteText, text_color=color.white, text_size=tableSize, bgcolor=oteClr)
    table.cell(dashboard, 4, 9, dispText, text_color=color.white, text_size=tableSize, bgcolor=dispClr)
    table.cell(dashboard, 5, 9, bbText, text_color=color.white, text_size=tableSize, bgcolor=bbClr)
    table.cell(dashboard, 6, 9, pdText, text_color=color.white, text_size=tableSize, bgcolor=pdClr)
    table.cell(dashboard, 7, 9, uniText, text_color=color.white, text_size=tableSize, bgcolor=uniClr)
    table.cell(dashboard, 8, 9, amdText2, text_color=color.white, text_size=tableSize, bgcolor=amdClr2)
    
    // ── BOLUM 4: EK BILGILER ──
    table.cell(dashboard, 0, 10, "Ek Bilgi", text_color=color.white, text_size=tableSize, bgcolor=color.new(#0a3d62, 0))
    table.cell(dashboard, 1, 10, "Judas S.", text_color=color.white, text_size=tableSize, bgcolor=color.new(#0a3d62, 0))
    table.cell(dashboard, 2, 10, "NWOG", text_color=color.white, text_size=tableSize, bgcolor=color.new(#0a3d62, 0))
    table.cell(dashboard, 3, 10, "NDOG", text_color=color.white, text_size=tableSize, bgcolor=color.new(#0a3d62, 0))
    table.cell(dashboard, 4, 10, "", text_color=color.white, text_size=tableSize, bgcolor=color.new(#0a3d62, 0))
    table.cell(dashboard, 5, 10, "", text_color=color.white, text_size=tableSize, bgcolor=color.new(#0a3d62, 0))
    table.cell(dashboard, 6, 10, "", text_color=color.white, text_size=tableSize, bgcolor=color.new(#0a3d62, 0))
    table.cell(dashboard, 7, 10, "", text_color=color.white, text_size=tableSize, bgcolor=color.new(#0a3d62, 0))
    table.cell(dashboard, 8, 10, "", text_color=color.white, text_size=tableSize, bgcolor=color.new(#0a3d62, 0))
    
    // Ek bilgi degerleri
    judasText = bullishJudas ? "Yukari" : bearishJudas ? "Asagi" : "Yok"
    judasClr = bullishJudas ? color.new(color.green, 30) : bearishJudas ? color.new(color.red, 30) : color.new(color.gray, 60)
    nwogText2 = nwogExists ? "Aktif" : "Yok"
    ndogText2 = ndogExists ? "Aktif" : "Yok"
    nwogClr = nwogExists ? color.new(color.aqua, 30) : color.new(color.gray, 60)
    ndogClr = ndogExists ? color.new(color.aqua, 30) : color.new(color.gray, 60)
    
    table.cell(dashboard, 0, 11, "Durum", text_color=color.white, text_size=tableSize, bgcolor=color.new(color.gray, 60))
    table.cell(dashboard, 1, 11, judasText, text_color=color.white, text_size=tableSize, bgcolor=judasClr)
    table.cell(dashboard, 2, 11, nwogText2, text_color=color.white, text_size=tableSize, bgcolor=nwogClr)
    table.cell(dashboard, 3, 11, ndogText2, text_color=color.white, text_size=tableSize, bgcolor=ndogClr)
    table.cell(dashboard, 4, 11, "", text_color=color.white, text_size=tableSize, bgcolor=color.new(color.gray, 60))
    table.cell(dashboard, 5, 11, "", text_color=color.white, text_size=tableSize, bgcolor=color.new(color.gray, 60))
    table.cell(dashboard, 6, 11, "", text_color=color.white, text_size=tableSize, bgcolor=color.new(color.gray, 60))
    table.cell(dashboard, 7, 11, "", text_color=color.white, text_size=tableSize, bgcolor=color.new(color.gray, 60))
    table.cell(dashboard, 8, 11, "", text_color=color.white, text_size=tableSize, bgcolor=color.new(color.gray, 60))

// ============================================================================
// ARKA PLAN RENKLENDIRMESI
// ============================================================================

overallScore = math.round((dailyScore + h4Score + h1Score) / 3)
bgColor = overallScore >= 4 ? color.new(color.green, 95) : overallScore <= 2 ? color.new(color.red, 95) : color.new(color.gray, 98)
bgcolor(showTrendBg ? bgColor : na, title="Trend Arka Plan")

// ICT Killzone ve Silver Bullet arka plan renklendirmesi
// Killzone arka plan artik box ile ciziliyor (seans high/low arasi sinirli)
bgcolor(showSilverBullet and isSilverBullet ? sbColor : na, title="ICT Silver Bullet")

// ============================================================================
// ALERT KOSULLARI
// ============================================================================

alertcondition(bullishOB, title="Bullish OB Tespiti", message="Bullish Order Block tespit edildi!")
alertcondition(bearishOB, title="Bearish OB Tespiti", message="Bearish Order Block tespit edildi!")
