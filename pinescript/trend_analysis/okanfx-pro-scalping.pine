        if kzStopMitigated and kzShowLines
            if not nyAMHMitigated and not na(nyAMPivotH) and not na(nyAMHigh) and close > nyAMHigh
                nyAMHMitigated := true
            if not nyAMLMitigated and not na(nyAMPivotL) and not na(nyAMLow) and close < nyAMLow
                nyAMLMitigated := true
    prevNYAM := isNYAMKZ

// NY Lunch
var float nyLunchHigh = na
var float nyLunchLow  = na
var int   nyLunchStartBar = na
var bool  prevNYLunch = false
var box   nyLunchBgBox = na
var label nyLunchNameLbl = na
var line  nyLunchPivotH = na
var line  nyLunchPivotL = na
var line  nyLunchMidLine = na
var label nyLunchPivotHLbl = na
var label nyLunchPivotLLbl = na
var bool  nyLunchHMitigated = false
var bool  nyLunchLMitigated = false
if showNYLunch
    if isNYLunchKZ
        if not prevNYLunch
            nyLunchHigh := high
            nyLunchLow  := low
            nyLunchStartBar := bar_index
            nyLunchHMitigated := false
            nyLunchLMitigated := false
            if kzShowBg
                if not na(nyLunchBgBox)
                    box.delete(nyLunchBgBox)
                nyLunchBgBox := box.new(bar_index, high, bar_index, low, border_color=color.new(nyLunchColor, 100), bgcolor=nyLunchColor)
            if kzShowLabels
