                nyAMMidLine := line.new(bar_index, (high + low) / 2, bar_index, (high + low) / 2, color=color.new(nyAMColor, 30), style=kzMidLineStyle, width=vizKzLineWidth)
        else
            nyAMHigh := math.max(nz(nyAMHigh, high), high)
            nyAMLow  := math.min(nz(nyAMLow, low), low)
            if kzShowBg and not na(nyAMBgBox)
                box.set_top(nyAMBgBox, nyAMHigh)
                box.set_bottom(nyAMBgBox, nyAMLow)
                box.set_right(nyAMBgBox, bar_index)
            if kzShowLabels and not na(nyAMNameLbl)
                label.set_y(nyAMNameLbl, nyAMHigh)
            if kzShowLines
                if not na(nyAMPivotH)
                    line.set_y1(nyAMPivotH, nyAMHigh)
                    line.set_y2(nyAMPivotH, nyAMHigh)
                    line.set_x2(nyAMPivotH, bar_index)
                if not na(nyAMPivotL)
                    line.set_y1(nyAMPivotL, nyAMLow)
                    line.set_y2(nyAMPivotL, nyAMLow)
                    line.set_x2(nyAMPivotL, bar_index)
                if not na(nyAMPivotHLbl)
                    label.set_y(nyAMPivotHLbl, nyAMHigh)
                    label.set_x(nyAMPivotHLbl, bar_index)
                if not na(nyAMPivotLLbl)
                    label.set_y(nyAMPivotLLbl, nyAMLow)
                    label.set_x(nyAMPivotLLbl, bar_index)
            if kzShowMean and not na(nyAMMidLine)
                nyAMMid = (nyAMHigh + nz(nyAMLow)) / 2
                line.set_y1(nyAMMidLine, nyAMMid)
                line.set_y2(nyAMMidLine, nyAMMid)
                line.set_x2(nyAMMidLine, bar_index)
    else
        if kzShowLines
            if not nyAMHMitigated and not na(nyAMPivotH)
                line.set_x2(nyAMPivotH, bar_index)
            if not nyAMHMitigated and not na(nyAMPivotHLbl)
                label.set_x(nyAMPivotHLbl, bar_index)
            if not nyAMLMitigated and not na(nyAMPivotL)
