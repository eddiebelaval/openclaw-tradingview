//@version=6
indicator("[blackcat] L3 MACD Wave Signal Pro", shorttitle="L3 MACD Wave", overlay=false, max_bars_back=5000)

// ============================================================
// Custom Functions
// ============================================================

// Bars since previous true condition
barsFromPrevTrue(condition) =>
    var int barsSince = 0
    if condition
        barsSince := 0
    else
        barsSince := barsSince + 1
    barsSince

// Backward set - simplified version for Pine Script V6
// Note: True backward setting is not possible in Pine Script
// This function returns the condition with a delay
backwardSet(condition, bars) =>
    condition[bars]

// Bars from highest value in range
barsFromHighest(source, length) =>
    var int barsSince = 0
    var float highestVal = na
    currentHighest = ta.highest(source, length)
    if ta.change(currentHighest) != 0
        barsSince := 0
        highestVal := currentHighest
    else
        barsSince := barsSince + 1
    barsSince

// Bars from lowest value in range
barsFromLowest(source, length) =>
    var int barsSince = 0
    var float lowestVal = na
    currentLowest = ta.lowest(source, length)
    if ta.change(currentLowest) != 0
        barsSince := 0
        lowestVal := currentLowest
    else
        barsSince := barsSince + 1
    barsSince

// Sum bars until condition occurs target times
barsSumUntil(condition, target) =>
    var int count = 0
    var int sum = 0
    if condition
        count := count + 1
        if count >= target
            count := 0
            sum := 0
    else
        sum := sum + 1
    sum

// ============================================================
// Input Parameters
// ============================================================

showTable = input.bool(true, "Show Status Table")
showLabels = input.bool(true, "Show Buy/Sell Labels")
tablePosition = input.string("top_right", "Table Position", options=["top_left", "top_right", "bottom_left", "bottom_right"])
transparency = input.int(70, "Transparency", minval=0, maxval=100)

// ============================================================
// Core Calculations
// ============================================================

// Scale factor (SJ = 1)
scaleFactor = 1.0

// Calculate DIFF: 12 EMA - 26 EMA
diffLine = ta.ema(close, 12) - ta.ema(close, 26)

// Calculate DEA: 9 EMA of DIFF
deaLine = ta.ema(diffLine, 9)

// Calculate MACD: 2 * (DIFF - DEA) * SJ
macdHistogram = 2.0 * (diffLine - deaLine) * scaleFactor

// Calculate MID: (7 * close + low + open + high) / 10
midPrice = (7.0 * close + low + open + high) / 10.0

// Calculate MA0: 40 SMA of MID * SJ
ma0 = ta.sma(midPrice, 40) * scaleFactor

// Calculate MA1-MA40 and their differences
ma1 = ta.sma(midPrice, 1) * scaleFactor
maDiff1 = ma1 - ma0

ma2 = ta.sma(midPrice, 2)
maDiff2 = ma2 - ma0

ma3 = ta.sma(midPrice, 3)
maDiff3 = ma3 - ma0

ma4 = ta.sma(midPrice, 4)
maDiff4 = ma4 - ma0

ma5 = ta.sma(midPrice, 5)
maDiff5 = ma5 - ma0

ma6 = ta.sma(midPrice, 6)
maDiff6 = ma6 - ma0

ma7 = ta.sma(midPrice, 7)
maDiff7 = ma7 - ma0

ma8 = ta.sma(midPrice, 8)
maDiff8 = ma8 - ma0

ma9 = ta.sma(midPrice, 9)
maDiff9 = ma9 - ma0

ma10 = ta.sma(midPrice, 10)
maDiff10 = ma10 - ma0

ma11 = ta.sma(midPrice, 11)
maDiff11 = ma11 - ma0

ma12 = ta.sma(midPrice, 12)
maDiff12 = ma12 - ma0

ma13 = ta.sma(midPrice, 13)
maDiff13 = ma13 - ma0

ma14 = ta.sma(midPrice, 14)
maDiff14 = ma14 - ma0

ma15 = ta.sma(midPrice, 15)
maDiff15 = ma15 - ma0

ma16 = ta.sma(midPrice, 16)
maDiff16 = ma16 - ma0

ma17 = ta.sma(midPrice, 17)
maDiff17 = ma17 - ma0

ma18 = ta.sma(midPrice, 18)
maDiff18 = ma18 - ma0

ma19 = ta.sma(midPrice, 19)
maDiff19 = ma19 - ma0

ma20 = ta.sma(midPrice, 20)
maDiff20 = ma20 - ma0

ma21 = ta.sma(midPrice, 21)
maDiff21 = ma21 - ma0

ma22 = ta.sma(midPrice, 22)
maDiff22 = ma22 - ma0

ma23 = ta.sma(midPrice, 23)
maDiff23 = ma23 - ma0

ma24 = ta.sma(midPrice, 24)
maDiff24 = ma24 - ma0

ma25 = ta.sma(midPrice, 25)
maDiff25 = ma25 - ma0

ma26 = ta.sma(midPrice, 26)
maDiff26 = ma26 - ma0

ma27 = ta.sma(midPrice, 27)
maDiff27 = ma27 - ma0

ma28 = ta.sma(midPrice, 28)
maDiff28 = ma28 - ma0

ma29 = ta.sma(midPrice, 29)
maDiff29 = ma29 - ma0

ma30 = ta.sma(midPrice, 30)
maDiff30 = ma30 - ma0

ma31 = ta.sma(midPrice, 31)
maDiff31 = ma31 - ma0

ma32 = ta.sma(midPrice, 32)
maDiff32 = ma32 - ma0

ma33 = ta.sma(midPrice, 33)
maDiff33 = ma33 - ma0

ma34 = ta.sma(midPrice, 34)
maDiff34 = ma34 - ma0

ma35 = ta.sma(midPrice, 35)
maDiff35 = ma35 - ma0

ma36 = ta.sma(midPrice, 36)
maDiff36 = ma36 - ma0

ma37 = ta.sma(midPrice, 37)
maDiff37 = ma37 - ma0

ma38 = ta.sma(midPrice, 38)
maDiff38 = ma38 - ma0

ma39 = ta.sma(midPrice, 39)
maDiff39 = ma39 - ma0

ma40 = ta.sma(midPrice, 40)
maDiff40 = ma40 - ma0

// Calculate LC: (A6 + A7 + ... + A20) / 15
lineConvergence = (maDiff6 + maDiff7 + maDiff8 + maDiff9 + maDiff10 + maDiff11 + maDiff12 + maDiff13 + maDiff14 + maDiff15 + maDiff16 + maDiff17 + maDiff18 + maDiff19 + maDiff20) / 15.0

// VAR1 and VAR2 for lazy line
var1 = lineConvergence
var2 = lineConvergence[1]

// VAR3: VAR1 > VAR2 and previous LC < LC[2]
var3 = var1 > var2 and lineConvergence[1] < lineConvergence[2]

// VAR4: VAR1 < VAR2 and previous LC > LC[2]
var4 = var1 < var2 and lineConvergence[1] > lineConvergence[2]

// ============================================================
// Fast MACD Calculations
// ============================================================

// Calculate DIFFF: 21 EMA - 34 EMA
diffFast = ta.ema(close, 21) - ta.ema(close, 34)

// Calculate DEAA: 8 EMA of DIFFF
deaFast = ta.ema(diffFast, 8)

// Calculate MACDD: 8 * (DIFFF - DEAA)
macdFast = 8.0 * (diffFast - deaFast)

// Calculate MARDD: 2 SMA of MACDD
macdFastMa = ta.sma(macdFast, 2)

// ============================================================
// Signal Generation - Simplified Crossover Logic
// ============================================================

// Buy signal: DIFF crosses above DEA (Golden Cross)
buySignal = ta.crossover(diffLine, deaLine)

// Sell signal: DIFF crosses below DEA (Death Cross)
sellSignal = ta.crossunder(diffLine, deaLine)

// ============================================================
// Visualization - MACD Histogram
// ============================================================

// MACD rising above zero - Magenta
macdRisingAboveZero = macdHistogram >= 0 and macdHistogram >= macdHistogram[1]
plot(macdRisingAboveZero ? macdHistogram : na, "MACD Rising Above Zero", color=#FF00FF, style=plot.style_columns, linewidth=2)

// MACD falling above zero - Yellow
macdFallingAboveZero = macdHistogram >= 0 and macdHistogram < macdHistogram[1]
plot(macdFallingAboveZero ? macdHistogram : na, "MACD Falling Above Zero", color=color.yellow, style=plot.style_columns, linewidth=2)

// MACD falling below zero - Yellow
macdFallingBelowZero = macdHistogram < 0 and macdHistogram < macdHistogram[1]
plot(macdFallingBelowZero ? macdHistogram : na, "MACD Falling Below Zero", color=color.yellow, style=plot.style_columns, linewidth=2)

// MACD rising below zero - White
macdRisingBelowZero = macdHistogram < 0 and macdHistogram > macdHistogram[1]
plot(macdRisingBelowZero ? macdHistogram : na, "MACD Rising Below Zero", color=color.white, style=plot.style_columns, linewidth=2)

// ============================================================
// Visualization - Lazy Line
// ============================================================

// Lazy line divergence - Blue
lazyLineDivergence = var1 > var2
plot(lazyLineDivergence ? lineConvergence : na, "Lazy Line Divergence", color=color.blue, style=plot.style_columns, linewidth=3)

// Lazy line convergence - Green
lazyLineConvergence = var1 < var2
plot(lazyLineConvergence ? lineConvergence : na, "Lazy Line Convergence", color=color.green, style=plot.style_columns, linewidth=3)

// ============================================================
// Visualization - DIFF and DEA Lines
// ============================================================

// Dynamic DIFF line color based on relationship to DEA
diffColor = diffLine > deaLine ? color.new(#00FF00, 0) : color.new(#FF0000, 0)

// Plot DIFF line with dynamic coloring (green when above DEA, red when below)
plot(diffLine, "DIFF Line (Fast)", color=diffColor, linewidth=2)

// Plot DEA line with distinct yellow color
plot(deaLine, "DEA Line (Slow)", color=color.new(#FFFF00, 0), linewidth=2)

// Zero line
hline(0, "Zero Line", color=color.gray, linestyle=hline.style_dashed)

// ============================================================
// BS Labels with Emoji
// ============================================================

if showLabels
    // Buy label with emoji - appears above the line
    if buySignal
        label.new(bar_index, diffLine, "🟢 BUY", style=label.style_label_up, color=color.new(color.red, transparency), textcolor=color.white, size=size.small)
    
    // Sell label with emoji - appears below the line
    if sellSignal
        label.new(bar_index, diffLine, "🔴 SELL", style=label.style_label_down, color=color.new(color.green, transparency), textcolor=color.white, size=size.small)

// ============================================================
// Status Table
// ============================================================

var table statusTable = na
if showTable and barstate.islast
    if na(statusTable)
        statusTable := table.new(tablePosition, 2, 7, bgcolor=color.new(color.black, 80), border_width=1)
    
    // Table headers
    table.cell(statusTable, 0, 0, "Indicator", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 70))
    table.cell(statusTable, 1, 0, "Value", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 70))
    
    // DIFF value
    table.cell(statusTable, 0, 1, "DIFF", text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 1, str.tostring(diffLine, "#.####"), text_color=color.white, text_size=size.small)
    
    // DEA value
    table.cell(statusTable, 0, 2, "DEA", text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 2, str.tostring(deaLine, "#.####"), text_color=color.white, text_size=size.small)
    
    // MACD value
    table.cell(statusTable, 0, 3, "MACD", text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 3, str.tostring(macdHistogram, "#.####"), text_color=color.white, text_size=size.small)
    
    // Line Convergence value
    table.cell(statusTable, 0, 4, "Line Conv.", text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 4, str.tostring(lineConvergence, "#.####"), text_color=color.white, text_size=size.small)
    
    // Signal status - Updated to use new signal variables
    signalStatus = "NEUTRAL"
    signalColor = color.gray
    if buySignal
        signalStatus := "BUY"
        signalColor := color.red
    else if sellSignal
        signalStatus := "SELL"
        signalColor := color.green
    
    table.cell(statusTable, 0, 5, "Signal", text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 5, signalStatus, text_color=color.white, text_size=size.small, bgcolor=color.new(signalColor, 50))
    
    // Trend direction
    trendDirection = "NEUTRAL"
    trendColor = color.gray
    if macdHistogram > 0 and macdHistogram > macdHistogram[1]
        trendDirection := "BULLISH"
        trendColor := #FF00FF
    else if macdHistogram < 0 and macdHistogram < macdHistogram[1]
        trendDirection := "BEARISH"
        trendColor := color.yellow
    
    table.cell(statusTable, 0, 6, "Trend", text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 6, trendDirection, text_color=color.white, text_size=size.small, bgcolor=color.new(trendColor, 50))

// ============================================================
// Alert Conditions - Updated to use new signal variables
// ============================================================

alertcondition(buySignal, "Buy Signal", "MACD Band Buy Signal")
alertcondition(sellSignal, "Sell Signal", "MACD Band Sell Signal")
