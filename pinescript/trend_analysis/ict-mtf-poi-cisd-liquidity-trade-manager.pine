// ============================================================
// SECTION 7C: LOT SIZE CALCULATOR FUNCTIONS
// ============================================================
f_get_pip_info() =>
    float pipSize = 0.01
    float pipValue = 10.0
    
    if i_instrument == "XAUUSD"
        pipSize := 0.1
        pipValue := 10.0
    else if i_instrument == "XAGUSD"
        pipSize := 0.01
        pipValue := 50.0
    else if i_instrument == "GBPJPY"
        pipSize := 0.01
        pipValue := 6.5
    else if i_instrument == "USDJPY"
        pipSize := 0.01
        pipValue := 6.5
    else if i_instrument == "EURUSD"
        pipSize := 0.0001
        pipValue := 10.0
    else if i_instrument == "GBPUSD"
        pipSize := 0.0001
        pipValue := 10.0
    else if i_instrument == "AUDUSD"
        pipSize := 0.0001
        pipValue := 10.0
    else
        pipSize := i_custom_pip_size
        pipValue := i_custom_pip_value
    
    [pipSize, pipValue]

f_calc_lot_size(float entry, float sl) =>
    [pipSize, pipValue] = f_get_pip_info()
    
    riskAmount = i_account_size * (i_risk_percent / 100)
    slDistance = math.abs(entry - sl)
    slPips = slDistance / pipSize
    
    lotSize = slPips > 0 ? riskAmount / (slPips * pipValue) : 0
    lotSize := math.round(lotSize * 100) / 100
    
    [lotSize, riskAmount, slDistance, slPips]

// Panel position function
f_get_panel_position() =>
    pos = position.top_right
    if i_panel_position == "Top Left"
        pos := position.top_left
    else if i_panel_position == "Top Center"
        pos := position.top_center
    else if i_panel_position == "Top Right"
        pos := position.top_right
    else if i_panel_position == "Bottom Left"
        pos := position.bottom_left
    else if i_panel_position == "Bottom Center"
        pos := position.bottom_center
    else if i_panel_position == "Bottom Right"
        pos := position.bottom_right
    pos

// ============================================================
// SECTION 8: HELPER FUNCTIONS
// ============================================================
add_to_array(arr, value) =>
    array.unshift(arr, value)
    if array.size(arr) > 100
        array.pop(arr)

f_text(string _tf) =>
    _text = str.tonumber(_tf) < 59 ? _tf + "m" : str.tonumber(_tf) > 59 ? "h" + str.tostring(math.floor(str.tonumber(_tf)/60)) : _tf
    _text := _tf == "1D" ? "D" : _tf == "1W" ? "W" : _tf == "1M" ? "M" : _text

tf_ok(_htf) =>
    _ok = res_chart == _htf or (timeframe.in_seconds(_htf) >= timeframe.in_seconds(timeframe.period)) or (str.tonumber(_htf) >= str.tonumber(timeframe.period)) or 
     (_htf == "1D" and str.tonumber(timeframe.period) <= 720) or
     (_htf == "1W" and str.tonumber(timeframe.period) <= 720) or
     (_htf == "1W" and timeframe.isdaily) or
     (_htf == "1M" and str.tonumber(timeframe.period) <= 720) or
     (_htf == "1M" and timeframe.isdaily) or
     (_htf == "1M" and timeframe.isweekly)

f_live(_htf) =>
    var _o0 = open, var _h0 = high, var _l0 = low, var _t0 = time, var _c0 = close
    var _h1 = high, var _l1 = low, var _t1 = time, var _c1 = close, var _o1 = open
    var _h2 = high, var _l2 = low, var _o2 = open, var _c2 = close
    var _h3 = high, var _l3 = low, var _t3 = time, var _t2 = time, var _c3 = close, var _o3 = open
    var _h4 = high, var _l4 = low
    
    if timeframe.change(_htf)
        _t0 := time, _o0 := open, _h0 := high, _l0 := low
    if high >= _h0
        _h0 := high
    if low <= _l0
        _l0 := low

    if timeframe.change(_htf)        
        _o1 := _o0[1], _h1 := _h0[1], _l1 := _l0[1], _t1 := _t0[1], _c1 := close[1] 
        _h2 := _h1[1], _l2 := _l1[1], _o2 := _o1[1], _c2 := _c1[1], _t2 := _t1[1]
        _t3 := _t2[1], _h3 := _h2[1], _l3 := _l2[1], _c3 := _c2[1], _o3 := _o2[1]
        _h4 := _h3[1], _l4 := _l3[1]

    _c0 := close
    [_h4, _l4, _t3, _h3, _l3, _c3, _o3, _h2, _l2, _c2, _o2, _t2, _h1, _l1, _c1, _o1, _t1, _h0, _l0, _c0, _o0, _t0]

// ============================================================
// SECTION 8B: BSL / SSL DETECTION
// ============================================================
f_bssl(_tf, _show, _bsl_clr, _ssl_clr, _style) =>
    var _bsl_boxes  = array.new_box()
    var _ssl_boxes  = array.new_box()
    var _bsl_levels = array.new_float()
    var _ssl_levels = array.new_float()
    var _bsl_swept  = array.new_bool()
    var _ssl_swept  = array.new_bool()

    [h4, l4, t3, h3, l3, c3, o3, h2, l2, c2, o2, t2, h1, l1, c1, o1, t1, h0, l0, c0, o0, t0] = f_live(_tf)

    pivot_high = h2 > h3 and h2 > h1 and h2 > h0
    pivot_low  = l2 < l3 and l2 < l1 and l2 < l0

    if _show
        if pivot_high and timeframe.change(_tf)
            if array.size(_bsl_boxes) >= i_bssl_max
                box.delete(array.pop(_bsl_boxes))
                array.pop(_bsl_levels)
                array.pop(_bsl_swept)
            b = box.new(left=t2, top=h2, right=time, bottom=h2, xloc=xloc.bar_time, border_color=_bsl_clr, bgcolor=color.new(color.white, 100), border_style=_style, text=f_text(_tf) + " BSL", text_color=_bsl_clr, text_halign=text.align_right, text_valign=text.align_bottom, text_size=size.tiny)
            array.unshift(_bsl_boxes, b)
            array.unshift(_bsl_levels, h2)
            array.unshift(_bsl_swept, false)

        if pivot_low and timeframe.change(_tf)
            if array.size(_ssl_boxes) >= i_bssl_max
                box.delete(array.pop(_ssl_boxes))
                array.pop(_ssl_levels)
                array.pop(_ssl_swept)
            b = box.new(left=t2, top=l2, right=time, bottom=l2, xloc=xloc.bar_time, border_color=_ssl_clr, bgcolor=color.new(color.white, 100), border_style=_style, text=f_text(_tf) + " SSL", text_color=_ssl_clr, text_halign=text.align_right, text_valign=text.align_top, text_size=size.tiny)
            array.unshift(_ssl_boxes, b)
            array.unshift(_ssl_levels, l2)
            array.unshift(_ssl_swept, false)

        if array.size(_bsl_boxes) > 0
            for i = array.size(_bsl_boxes) - 1 to 0
                b         = array.get(_bsl_boxes,  i)
                lvl       = array.get(_bsl_levels, i)
                is_swept  = array.get(_bsl_swept,  i)
                swept_now = not is_swept and (i_bssl_sweep == "Wick" ? high >= lvl : close >= lvl)
                if not is_swept
                    box.set_right(b, time)
                if swept_now
                    box.set_border_color(b, color.gray)
                    box.set_text(b, "x " + f_text(_tf) + " BSL")
                    box.set_text_color(b, color.gray)
                    array.set(_bsl_swept, i, true)

        if array.size(_ssl_boxes) > 0
            for i = array.size(_ssl_boxes) - 1 to 0
                b         = array.get(_ssl_boxes,  i)
                lvl       = array.get(_ssl_levels, i)
                is_swept  = array.get(_ssl_swept,  i)
                swept_now = not is_swept and (i_bssl_sweep == "Wick" ? low <= lvl : close <= lvl)
                if not is_swept
                    box.set_right(b, time)
                if swept_now
                    box.set_border_color(b, color.gray)
                    box.set_text(b, "x " + f_text(_tf) + " SSL")
                    box.set_text_color(b, color.gray)
                    array.set(_ssl_swept, i, true)

f_bssl("240", i_show_4h_bssl, i_bsl_4h_clr, i_ssl_4h_clr, line.style_solid)
f_bssl("60",  i_show_1h_bssl, i_bsl_1h_clr, i_ssl_1h_clr, line.style_dashed)

