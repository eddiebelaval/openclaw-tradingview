// ============================================================
// SECTION 10: FVG DETECTION WITH 3-LEVEL ZONES
// ============================================================
type FVGZone
    box     mainBox
    line    midLine
    float   fvgHigh
    float   fvgLow
    float   fvgMid
    bool    highTouched
    bool    midTouched
    bool    lowTouched
    string  tfLabel

f_fvg_multilevel(_tf, _show) =>
    var _con_high = false, var _con_mid = false, var _con_low = false
    var string _touched_level = ""
    var bool _is_bull_fvg = false
    
    var array<FVGZone> _fvgup = array.new<FVGZone>()
    var array<FVGZone> _fvgdw = array.new<FVGZone>()

    _con_high := false, _con_mid := false, _con_low := false
    _touched_level := "", _is_bull_fvg := false
    
    [h4, l4, t3, h3, l3, c3, o3, h2, l2, c2, o2, t2, h1, l1, c1, o1, t1, h0, l0, c0, o0, t0] = f_live(_tf)

    bull_fvg = l1 > h3 and c2 > h3 and c2 > o2
    bear_fvg = l3 > h1 and c2 < l3 and o2 > c2

    text_fvgp = res_chart == _tf ? "+" : f_text(_tf) + " +"
    text_fvgn = res_chart == _tf ? "-" : f_text(_tf) + " -"
    
    if bull_fvg and timeframe.change(_tf) and _show
        fvgTop = l1, fvgBot = h3, fvgMidVal = (fvgTop + fvgBot) / 2
        newBox = box.new(left=t2, bottom=fvgBot, right=t0, top=fvgTop, bgcolor=color.new(i_fvg_color, 80), border_color=color.new(i_fvg_brcolor, 50), text=text_fvgp, text_size=i_txt_size, text_halign=text.align_right, text_color=i_fvg_txtcolor, xloc=xloc.bar_time)
        newMidLine = line.new(t2, fvgMidVal, t0, fvgMidVal, xloc=xloc.bar_time, color=i_fvg_mid_color, style=line.style_dotted, width=1)
        newZone = FVGZone.new(newBox, newMidLine, fvgTop, fvgBot, fvgMidVal, false, false, false, f_text(_tf))
        array.unshift(_fvgup, newZone)
        if array.size(_fvgup) > 50
            oldZone = array.pop(_fvgup)
            box.delete(oldZone.mainBox), line.delete(oldZone.midLine)
        
    if bear_fvg and timeframe.change(_tf) and _show
        fvgTop = l3, fvgBot = h1, fvgMidVal = (fvgTop + fvgBot) / 2
        newBox = box.new(left=t2, bottom=fvgBot, right=t0, top=fvgTop, bgcolor=color.new(i_fvg_color, 80), border_color=color.new(i_fvg_brcolor, 50), text=text_fvgn, text_size=i_txt_size, text_halign=text.align_right, text_color=i_fvg_txtcolor, xloc=xloc.bar_time)
        newMidLine = line.new(t2, fvgMidVal, t0, fvgMidVal, xloc=xloc.bar_time, color=i_fvg_mid_color, style=line.style_dotted, width=1)
        newZone = FVGZone.new(newBox, newMidLine, fvgTop, fvgBot, fvgMidVal, false, false, false, f_text(_tf))
        array.unshift(_fvgdw, newZone)
        if array.size(_fvgdw) > 50
            oldZone = array.pop(_fvgdw)
            box.delete(oldZone.mainBox), line.delete(oldZone.midLine)

    if array.size(_fvgup) > 0 and _show
        for i = array.size(_fvgup) - 1 to 0 by 1
            zone = array.get(_fvgup, i)
            fvgTop = zone.fvgHigh, fvgBot = zone.fvgLow, fvgMid = zone.fvgMid
            box.set_right(zone.mainBox, time), line.set_x2(zone.midLine, time)
            
            if low <= fvgTop + dx and low > fvgMid and not zone.highTouched and tf_ok(_tf)
                zone.highTouched := true, _con_high := true, _touched_level := "FVG Hi " + zone.tfLabel, _is_bull_fvg := true
            
            if low <= fvgMid + dx and low > fvgBot and not zone.midTouched and tf_ok(_tf)
                zone.midTouched := true, _con_mid := true, _touched_level := "FVG 50% " + zone.tfLabel, _is_bull_fvg := true
            
            if low <= fvgBot + dx and not zone.lowTouched and tf_ok(_tf)
                zone.lowTouched := true, _con_low := true, _touched_level := "FVG Lo " + zone.tfLabel, _is_bull_fvg := true
            
            if i_col_mtg and low < fvgTop and low > fvgBot
                box.set_top(zone.mainBox, low)
            
            if low <= fvgBot or (zone.highTouched and zone.midTouched and zone.lowTouched)
                box.delete(zone.mainBox), line.delete(zone.midLine), array.remove(_fvgup, i)

    if array.size(_fvgdw) > 0 and _show
        for i = array.size(_fvgdw) - 1 to 0 by 1
            zone = array.get(_fvgdw, i)
            fvgTop = zone.fvgHigh, fvgBot = zone.fvgLow, fvgMid = zone.fvgMid
            box.set_right(zone.mainBox, time), line.set_x2(zone.midLine, time)
            
            if high >= fvgBot - dx and high < fvgMid and not zone.lowTouched and tf_ok(_tf)
                zone.lowTouched := true, _con_low := true, _touched_level := "FVG Lo " + zone.tfLabel, _is_bull_fvg := false
            
            if high >= fvgMid - dx and high < fvgTop and not zone.midTouched and tf_ok(_tf)
                zone.midTouched := true, _con_mid := true, _touched_level := "FVG 50% " + zone.tfLabel, _is_bull_fvg := false
            
            if high >= fvgTop - dx and not zone.highTouched and tf_ok(_tf)
                zone.highTouched := true, _con_high := true, _touched_level := "FVG Hi " + zone.tfLabel, _is_bull_fvg := false
            
            if i_col_mtg and high > fvgBot and high < fvgTop
                box.set_bottom(zone.mainBox, high)
            
            if high >= fvgTop or (zone.highTouched and zone.midTouched and zone.lowTouched)
                box.delete(zone.mainBox), line.delete(zone.midLine), array.remove(_fvgdw, i)

    _any_touch = _con_high or _con_mid or _con_low
    [_any_touch, _touched_level, _is_bull_fvg]

// ============================================================
// SECTION 11: ORDER BLOCK / MITIGATION DETECTION
// ============================================================
f_OB(_tf, _show) =>
    var _con3 = false, var _con4 = false
    var _OBup = array.new_box(), var _OBdw = array.new_box()
    var _OBup_touched = array.new_bool(), var _OBdw_touched = array.new_bool()
    _con3 := false, _con4 := false
    
    [h4, l4, t3, h3, l3, c3, o3, h2, l2, c2, o2, t2, h1, l1, c1, o1, t1, h0, l0, c0, o0, t0] = f_live(_tf)

    up3 = c3 > o3, dw3 = c3 < o3, eq3 = c3 == o3
    norm_bull_OB = l1 > h3 and c2 > o2 and c2 > h3 and (dw3 or eq3)
    norm_bear_OB = l3 > h1 and o2 > c2 and c2 < l3 and (up3 or eq3)
    bull_OB = norm_bull_OB or (not norm_bull_OB[1] and up3 and l3 < math.min(l4, l2) and l1 > h3 and c2 > o2)
    bear_OB = norm_bear_OB or (not norm_bear_OB[1] and dw3 and h3 > math.max(h4, h2) and l3 > h1 and o2 > c2)

    text_OBp = res_chart == _tf ? "+" : f_text(_tf) + " +"
    text_OBn = res_chart == _tf ? "-" : f_text(_tf) + " -"

    if bull_OB and timeframe.change(_tf) and _show
        bullOB = box.new(left=t3, bottom=math.min(l3, l2), right=t0, top=h3, bgcolor=color.new(i_bull_color, 100), border_color=color.new(i_bull_color, 100), text=text_OBp, text_size=i_txt_size, text_halign=text.align_center, text_color=color.new(color.navy, 100), xloc=xloc.bar_time)
        add_to_array(_OBup, bullOB), add_to_array(_OBup_touched, false)
        
    if bear_OB and timeframe.change(_tf) and _show
        bearOB = box.new(left=t3, bottom=l3, right=t0, top=math.max(h2, h3), bgcolor=color.new(i_bear_color, 100), border_color=color.new(i_bear_color, 100), text=text_OBn, text_size=i_txt_size, text_halign=text.align_center, text_color=color.new(color.navy, 100), xloc=xloc.bar_time)
        add_to_array(_OBdw, bearOB), add_to_array(_OBdw_touched, false)

    if array.size(_OBup) > 0 and _show
        for i = array.size(_OBup) - 1 to 0 by 1
            fbox = array.get(_OBup, i), ftouched = array.get(_OBup_touched, i)
            top = box.get_top(fbox), bot = box.get_bottom(fbox)
            if low < top + dx and low > bot and tf_ok(_tf)
                xlow = low < top ? low : top
                if i_col_mtg
                    box.set_top(fbox, xlow)
                box.set_right(fbox, time), box.set_border_color(fbox, i_bull_color), box.set_border_style(fbox, line.style_dashed)
                box.set_bgcolor(fbox, i_bull_color), box.set_text(fbox, "+ " + f_text(_tf)), box.set_text_color(fbox, i_ob_txtcolor)
                if not ftouched
                    array.set(_OBup_touched, i, true), _con3 := true
            if low <= bot
                box.delete(fbox), array.remove(_OBup, i), array.remove(_OBup_touched, i)

    if array.size(_OBdw) > 0 and _show
        for i = array.size(_OBdw) - 1 to 0 by 1
            hbox = array.get(_OBdw, i), htouched = array.get(_OBdw_touched, i)
            top = box.get_top(hbox), bot = box.get_bottom(hbox)
            if high > bot - dx and high < top and tf_ok(_tf)
                xhigh = high > bot ? high : bot
                if i_col_mtg
                    box.set_bottom(hbox, xhigh)
                box.set_right(hbox, time), box.set_border_color(hbox, i_bear_color), box.set_border_style(hbox, line.style_dashed)
                box.set_bgcolor(hbox, i_bear_color), box.set_text(hbox, "- " + f_text(_tf)), box.set_text_color(hbox, i_ob_txtcolor)
                if not htouched
                    array.set(_OBdw_touched, i, true), _con4 := true
            if high >= top
                box.delete(hbox), array.remove(_OBdw, i), array.remove(_OBdw_touched, i)
    [_con3, _con4]

// ============================================================
// SECTION 12: RUN FVG & OB DETECTION
// ============================================================
[fvg1_touch, fvg1_level, fvg1_bull] = f_fvg_multilevel(i_tf1, i_show_tf1 and i_show_fvg)
[fvg2_touch, fvg2_level, fvg2_bull] = f_fvg_multilevel(i_tf2, i_show_tf2 and i_show_fvg)
[fvg3_touch, fvg3_level, fvg3_bull] = f_fvg_multilevel(i_tf3, i_show_tf3 and i_show_fvg)
[fvg4_touch, fvg4_level, fvg4_bull] = f_fvg_multilevel(i_tf4, i_show_tf4 and i_show_fvg)

[ob1_bull_raw, ob1_bear_raw] = f_OB(i_tf1, i_show_tf1 and i_show_mtg)
[ob2_bull_raw, ob2_bear_raw] = f_OB(i_tf2, i_show_tf2 and i_show_mtg)
[ob3_bull_raw, ob3_bear_raw] = f_OB(i_tf3, i_show_tf3 and i_show_mtg)
[ob4_bull_raw, ob4_bear_raw] = f_OB(i_tf4, i_show_tf4 and i_show_mtg)

ob1_bull = i_show_mtg ? ob1_bull_raw : false, ob1_bear = i_show_mtg ? ob1_bear_raw : false
ob2_bull = i_show_mtg ? ob2_bull_raw : false, ob2_bear = i_show_mtg ? ob2_bear_raw : false
ob3_bull = i_show_mtg ? ob3_bull_raw : false, ob3_bear = i_show_mtg ? ob3_bear_raw : false
ob4_bull = i_show_mtg ? ob4_bull_raw : false, ob4_bear = i_show_mtg ? ob4_bear_raw : false

any_fvg_touch = fvg1_touch or fvg2_touch or fvg3_touch or fvg4_touch
fvg_touched_name = fvg1_touch ? fvg1_level : fvg2_touch ? fvg2_level : fvg3_touch ? fvg3_level : fvg4_touch ? fvg4_level : ""
fvg_is_bull = fvg1_touch ? fvg1_bull : fvg2_touch ? fvg2_bull : fvg3_touch ? fvg3_bull : fvg4_touch ? fvg4_bull : false

ob_bull_name = ob1_bull ? "OB " + f_text(i_tf1) : ob2_bull ? "OB " + f_text(i_tf2) : ob3_bull ? "OB " + f_text(i_tf3) : ob4_bull ? "OB " + f_text(i_tf4) : ""
ob_bear_name = ob1_bear ? "OB " + f_text(i_tf1) : ob2_bear ? "OB " + f_text(i_tf2) : ob3_bear ? "OB " + f_text(i_tf3) : ob4_bear ? "OB " + f_text(i_tf4) : ""

any_ob_bull = ob1_bull or ob2_bull or ob3_bull or ob4_bull
any_ob_bear = ob1_bear or ob2_bear or ob3_bear or ob4_bear

any_bull_touch = (any_fvg_touch and fvg_is_bull) or any_ob_bull
any_bear_touch = (any_fvg_touch and not fvg_is_bull) or any_ob_bear

touched_bull_name = (any_fvg_touch and fvg_is_bull) ? fvg_touched_name : ob_bull_name
touched_bear_name = (any_fvg_touch and not fvg_is_bull) ? fvg_touched_name : ob_bear_name

// ============================================================
// SECTION 13: CISD PERMISSION & DETECTION
// ============================================================
isUp = close > open
isDown = close < open
isDoji = close == open

if i_cisd_enabled
    if any_bull_touch and not canLookForBullCISD
        canLookForBullCISD := true
        lastTouchedPOI_bull := touched_bull_name
        postTouchLow := low
        if i_show_touch
            label.new(bar_index, low, "👆 " + touched_bull_name, style=label.style_label_up, color=color.new(i_cisd_bull, i_label_transp), textcolor=color.white, size=size.tiny)
    
    if any_bear_touch and not canLookForBearCISD
        canLookForBearCISD := true
        lastTouchedPOI_bear := touched_bear_name
        postTouchHigh := high
        if i_show_touch
            label.new(bar_index, high, "👇 " + touched_bear_name, style=label.style_label_down, color=color.new(i_cisd_bear, i_label_transp), textcolor=color.white, size=size.tiny)
    
    if canLookForBullCISD
        if low <= postTouchLow
            postTouchLow := low
            if bullCISD_pending and not na(bullCISD_line)
                line.delete(bullCISD_line)
            bullCISD_pending := false, bullCISD_level := na
            for i = 0 to i_cisd_lookback
                if (isUp[i+1] or isDoji[i+1]) and isDown[i]
                    bullCISD_level := open[i]
                    if i > 0
                        for j = i-1 to 0
                            if isDown[j] and open[j] > bullCISD_level
                                bullCISD_level := open[j]
                    bullCISD_pending := true
                    bullCISD_line := line.new(bar_index - i, bullCISD_level, bar_index + 1, bullCISD_level, color=i_cisd_bull, style=line.style_dotted, width=i_cisd_width)
                    break
    
    if canLookForBearCISD
        if high >= postTouchHigh
            postTouchHigh := high
            if bearCISD_pending and not na(bearCISD_line)
                line.delete(bearCISD_line)
            bearCISD_pending := false, bearCISD_level := na
            for i = 0 to i_cisd_lookback
                if (isDown[i+1] or isDoji[i+1]) and isUp[i]
                    bearCISD_level := open[i]
                    if i > 0
                        for j = i-1 to 0
                            if isUp[j] and open[j] < bearCISD_level
                                bearCISD_level := open[j]
                    bearCISD_pending := true
                    bearCISD_line := line.new(bar_index - i, bearCISD_level, bar_index + 1, bearCISD_level, color=i_cisd_bear, style=line.style_dotted, width=i_cisd_width)
                    break

if bullCISD_pending and not na(bullCISD_line)
    line.set_x2(bullCISD_line, bar_index + 1)
if bearCISD_pending and not na(bearCISD_line)
    line.set_x2(bearCISD_line, bar_index + 1)

// ============================================================
// SECTION 14: TRADE DRAWING FUNCTIONS
// ============================================================
f_clear_trade_drawings() =>
    if not na(entryLine)
        line.delete(entryLine)
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(beLine)
        line.delete(beLine)
    if not na(tp1Line)
        line.delete(tp1Line)
    if not na(tp2Line)
        line.delete(tp2Line)
    if not na(slBox)
        box.delete(slBox)
    if not na(tpBox)
        box.delete(tpBox)

f_draw_trade(float entry, float sl, float tp, float be, float tp1_lvl, float tp2_lvl, bool isLong, int startBar) =>
    endBar = startBar + i_trade_extend_bars
    
    _entryLine = line.new(startBar, entry, endBar, entry, color=i_entry_color, style=line.style_solid, width=i_trade_line_width)
    _slLine = line.new(startBar, sl, endBar, sl, color=i_sl_color, style=line.style_dashed, width=i_trade_line_width)
    _tpLine = line.new(startBar, tp, endBar, tp, color=i_tp_color, style=line.style_dashed, width=i_trade_line_width)
    _beLine = line.new(startBar, be, endBar, be, color=i_be_color, style=line.style_dotted, width=i_trade_line_width)
    
    slBoxTop = isLong ? entry : sl
    slBoxBot = isLong ? sl : entry
    _slBox = box.new(startBar, slBoxTop, endBar, slBoxBot, bgcolor=color.new(i_sl_color, 90), border_color=color.new(i_sl_color, 70))
    
    tpBoxTop = isLong ? tp : entry
    tpBoxBot = isLong ? entry : tp
    _tpBox = box.new(startBar, tpBoxTop, endBar, tpBoxBot, bgcolor=color.new(i_tp_color, 90), border_color=color.new(i_tp_color, 70))
    
    var line _tp1Line = na
    if i_use_partial1 and not na(tp1_lvl)
        _tp1Line := line.new(startBar, tp1_lvl, endBar, tp1_lvl, color=color.new(color.aqua, 30), style=line.style_dotted, width=1)
    
    var line _tp2Line = na
    if i_use_partial2 and not na(tp2_lvl)
        _tp2Line := line.new(startBar, tp2_lvl, endBar, tp2_lvl, color=color.new(color.aqua, 50), style=line.style_dotted, width=1)
    
    [_entryLine, _slLine, _tpLine, _beLine, _tp1Line, _tp2Line, _slBox, _tpBox]

// ============================================================
// SECTION 15: CISD CONFIRMATION & TRADE VISUALIZATION
// ============================================================
if i_cisd_enabled
    // Bullish CISD Confirmation
    if bullCISD_pending and not na(bullCISD_level) and barstate.isconfirmed and inSession
        if close > bullCISD_level
            bullCISD_confirmed := true
            line.set_style(bullCISD_line, line.style_solid)
            
            slBuffer = atrValue * i_sl_buffer_atr
            tradeEntry := close
            tradeSL := postTouchLow - slBuffer
            slDist = tradeEntry - tradeSL
            tradeTP := tradeEntry + (slDist * i_rr_ratio)
            tradeBE := tradeEntry + (slDist * i_be_trigger_rr)
            tradeTP1 := i_use_partial1 ? tradeEntry + (slDist * i_partial1_rr) : na
            tradeTP2 := i_use_partial2 ? tradeEntry + (slDist * i_partial2_rr) : na
            tradeBarIndex := bar_index
            tradeIsLong := true
            tradeActive := true
            beTriggered := false
            tp1Triggered := false
            tp2Triggered := false
            
            [lotSize, riskAmt, slDistance, slPips] = f_calc_lot_size(tradeEntry, tradeSL)
            calcLotSize := lotSize
            calcRiskAmount := riskAmt
            
            if i_show_trade_lines
                f_clear_trade_drawings()
                [el, sl_l, tp_l, be_l, tp1_l, tp2_l, sl_b, tp_b] = f_draw_trade(tradeEntry, tradeSL, tradeTP, tradeBE, tradeTP1, tradeTP2, true, bar_index)
                entryLine := el, slLine := sl_l, tpLine := tp_l, beLine := be_l, tp1Line := tp1_l, tp2Line := tp2_l
                slBox := sl_b, tpBox := tp_b
            
            if i_show_cisd_arrows
                label.new(bar_index, low, "▲ " + lastTouchedPOI_bull, style=label.style_label_up, color=color.new(i_cisd_bull, i_label_transp), textcolor=color.white, size=size.tiny)
            
            if i_alert_cisd
                alert("🟢 LONG " + syminfo.ticker + " | " + lastTouchedPOI_bull + " | Entry: " + str.tostring(tradeEntry) + " | SL: " + str.tostring(tradeSL) + " | TP: " + str.tostring(tradeTP) + " | Lots: " + str.tostring(lotSize), alert.freq_once_per_bar)
            
            bullCISD_pending := false
            canLookForBullCISD := false
            bullCISD_level := na
            bullCISD_line := na
    
    // Bearish CISD Confirmation
    if bearCISD_pending and not na(bearCISD_level) and barstate.isconfirmed and inSession
        if close < bearCISD_level
            bearCISD_confirmed := true
            line.set_style(bearCISD_line, line.style_solid)
            
            slBuffer = atrValue * i_sl_buffer_atr
            tradeEntry := close
            tradeSL := postTouchHigh + slBuffer
            slDist = tradeSL - tradeEntry
            tradeTP := tradeEntry - (slDist * i_rr_ratio)
            tradeBE := tradeEntry - (slDist * i_be_trigger_rr)
            tradeTP1 := i_use_partial1 ? tradeEntry - (slDist * i_partial1_rr) : na
            tradeTP2 := i_use_partial2 ? tradeEntry - (slDist * i_partial2_rr) : na
            tradeBarIndex := bar_index
            tradeIsLong := false
            tradeActive := true
            beTriggered := false
            tp1Triggered := false
            tp2Triggered := false
            
            [lotSize, riskAmt, slDistance, slPips] = f_calc_lot_size(tradeEntry, tradeSL)
            calcLotSize := lotSize
            calcRiskAmount := riskAmt
            
            if i_show_trade_lines
                f_clear_trade_drawings()
                [el, sl_l, tp_l, be_l, tp1_l, tp2_l, sl_b, tp_b] = f_draw_trade(tradeEntry, tradeSL, tradeTP, tradeBE, tradeTP1, tradeTP2, false, bar_index)
                entryLine := el, slLine := sl_l, tpLine := tp_l, beLine := be_l, tp1Line := tp1_l, tp2Line := tp2_l
                slBox := sl_b, tpBox := tp_b
            
            if i_show_cisd_arrows
                label.new(bar_index, high, "▼ " + lastTouchedPOI_bear, style=label.style_label_down, color=color.new(i_cisd_bear, i_label_transp), textcolor=color.white, size=size.tiny)
            
            if i_alert_cisd
                alert("🔴 SHORT " + syminfo.ticker + " | " + lastTouchedPOI_bear + " | Entry: " + str.tostring(tradeEntry) + " | SL: " + str.tostring(tradeSL) + " | TP: " + str.tostring(tradeTP) + " | Lots: " + str.tostring(lotSize), alert.freq_once_per_bar)
            
            bearCISD_pending := false
            canLookForBearCISD := false
            bearCISD_level := na
            bearCISD_line := na

// ============================================================
// SECTION 16: TRADE OUTCOME TRACKING
// ============================================================
if tradeActive and i_show_trade_lines
    if tradeIsLong
        if i_use_partial1 and not tp1Triggered and high >= tradeTP1
            tp1Triggered := true

        if not beTriggered and high >= tradeBE
            beTriggered := true
            if not na(slLine)
                line.set_y1(slLine, tradeEntry), line.set_y2(slLine, tradeEntry), line.set_color(slLine, i_be_color)
            if not na(slBox)
                box.set_bottom(slBox, tradeEntry), box.set_bgcolor(slBox, color.new(i_be_color, 95))
        
        if low <= tradeSL
            tradeActive := false
        else if high >= tradeTP
            tradeActive := false
    else
        if i_use_partial1 and not tp1Triggered and low <= tradeTP1
            tp1Triggered := true

        if not beTriggered and low <= tradeBE
            beTriggered := true
            if not na(slLine)
                line.set_y1(slLine, tradeEntry), line.set_y2(slLine, tradeEntry), line.set_color(slLine, i_be_color)
            if not na(slBox)
                box.set_top(slBox, tradeEntry), box.set_bgcolor(slBox, color.new(i_be_color, 95))
        
        if high >= tradeSL
            tradeActive := false
        else if low <= tradeTP
            tradeActive := false

// ============================================================
// SECTION 17: LOT SIZE CALCULATOR PANEL
// ============================================================
if i_show_lot_calc and tradeActive and barstate.islast
    if not na(tradePanel)
        table.delete(tradePanel)
    
    panelPos = f_get_panel_position()
    tradePanel := table.new(panelPos, 4, 6, bgcolor=color.new(#1a1a2e, 10), border_width=1, border_color=color.new(color.gray, 50))
    
    dirColor = tradeIsLong ? color.green : color.red
    dirText = tradeIsLong ? "LONG" : "SHORT"
    table.cell(tradePanel, 0, 0, dirText, text_color=dirColor, text_size=size.normal, bgcolor=color.new(dirColor, 85))
    table.cell(tradePanel, 1, 0, syminfo.ticker, text_color=color.white, text_size=size.normal, bgcolor=color.new(dirColor, 85))
    table.cell(tradePanel, 2, 0, "R:R " + str.tostring(i_rr_ratio, "#.#"), text_color=color.yellow, text_size=size.normal, bgcolor=color.new(dirColor, 85))
    table.cell(tradePanel, 3, 0, str.tostring(i_risk_percent, "#.#") + "%", text_color=color.orange, text_size=size.normal, bgcolor=color.new(dirColor, 85))
    
    table.cell(tradePanel, 0, 1, "LOT SIZE", text_color=color.gray, text_size=size.small)
    table.cell(tradePanel, 1, 1, str.tostring(calcLotSize, "#.##"), text_color=color.white, text_size=size.large, bgcolor=color.new(color.blue, 70))
    table.cell(tradePanel, 2, 1, "lots", text_color=color.gray, text_size=size.small)
    table.cell(tradePanel, 3, 1, "$" + str.tostring(i_account_size, "#,###"), text_color=color.gray, text_size=size.small)
    
    table.cell(tradePanel, 0, 2, "Entry", text_color=color.gray, text_size=size.tiny)
    table.cell(tradePanel, 1, 2, str.tostring(tradeEntry, format.mintick), text_color=i_entry_color, text_size=size.small)
    table.cell(tradePanel, 2, 2, "SL", text_color=color.gray, text_size=size.tiny)
    table.cell(tradePanel, 3, 2, str.tostring(tradeSL, format.mintick), text_color=i_sl_color, text_size=size.small)
    
    table.cell(tradePanel, 0, 3, "TP", text_color=color.gray, text_size=size.tiny)
    table.cell(tradePanel, 1, 3, str.tostring(tradeTP, format.mintick), text_color=i_tp_color, text_size=size.small)
    table.cell(tradePanel, 2, 3, "BE", text_color=color.gray, text_size=size.tiny)
    table.cell(tradePanel, 3, 3, str.tostring(tradeBE, format.mintick), text_color=i_be_color, text_size=size.small)
    
    table.cell(tradePanel, 0, 4, "Risk $", text_color=color.gray, text_size=size.tiny)
    table.cell(tradePanel, 1, 4, "-$" + str.tostring(calcRiskAmount, "#,###"), text_color=i_sl_color, text_size=size.small)
    table.cell(tradePanel, 2, 4, "Reward", text_color=color.gray, text_size=size.tiny)
    table.cell(tradePanel, 3, 4, "+$" + str.tostring(calcRiskAmount * i_rr_ratio, "#,###"), text_color=i_tp_color, text_size=size.small)
    
    // Partial TP info
    tp1Text = i_use_partial1 ? "TP1: " + str.tostring(i_partial1_pct) + "% @ " + str.tostring(i_partial1_rr) + "R" : ""
    beText = beTriggered ? "BE: ACTIVE" : "BE: @ " + str.tostring(i_be_trigger_rr) + "R"
    table.cell(tradePanel, 0, 5, tp1Text, text_color=color.aqua, text_size=size.tiny)
    table.cell(tradePanel, 1, 5, "", text_color=color.gray, text_size=size.tiny)
    table.cell(tradePanel, 2, 5, beText, text_color=beTriggered ? color.lime : color.orange, text_size=size.tiny)
    table.cell(tradePanel, 3, 5, "", text_color=color.gray, text_size=size.tiny)

if not tradeActive and not na(tradePanel) and barstate.islast
    table.delete(tradePanel)
    tradePanel := na

// ============================================================
// SECTION 18: DEBUG TABLE
// ============================================================
if i_show_debug and barstate.islast
    var table dbg = table.new(position.top_left, 2, 12, bgcolor=color.new(color.black, 80), border_width=1)
    
    table.cell(dbg, 0, 0, "MTF POI + CISD v5", text_color=color.white, text_size=size.small)
    table.cell(dbg, 1, 0, "Full Featured", text_color=color.yellow)
    
    table.cell(dbg, 0, 1, "Can Bull CISD", text_color=color.white, text_size=size.tiny)
    table.cell(dbg, 1, 1, str.tostring(canLookForBullCISD), text_color=canLookForBullCISD ? color.green : color.gray, text_size=size.tiny)
    
    table.cell(dbg, 0, 2, "Can Bear CISD", text_color=color.white, text_size=size.tiny)
    table.cell(dbg, 1, 2, str.tostring(canLookForBearCISD), text_color=canLookForBearCISD ? color.red : color.gray, text_size=size.tiny)
    
    table.cell(dbg, 0, 3, "Bull Pending", text_color=color.white, text_size=size.tiny)
    table.cell(dbg, 1, 3, str.tostring(bullCISD_pending), text_color=bullCISD_pending ? color.orange : color.gray, text_size=size.tiny)
    
    table.cell(dbg, 0, 4, "Bear Pending", text_color=color.white, text_size=size.tiny)
    table.cell(dbg, 1, 4, str.tostring(bearCISD_pending), text_color=bearCISD_pending ? color.orange : color.gray, text_size=size.tiny)
    
    table.cell(dbg, 0, 5, "In Session", text_color=color.white, text_size=size.tiny)
    sessionText = inAsiaSession ? "Asia" : inLondonSession ? "London" : inNYSession ? "NY" : "None"
    table.cell(dbg, 1, 5, i_use_session ? sessionText : "OFF", text_color=inSession ? color.green : color.gray, text_size=size.tiny)
    
    table.cell(dbg, 0, 6, "Trade Active", text_color=color.white, text_size=size.tiny)
    table.cell(dbg, 1, 6, str.tostring(tradeActive), text_color=tradeActive ? color.green : color.gray, text_size=size.tiny)
    
    table.cell(dbg, 0, 7, "BE Triggered", text_color=color.white, text_size=size.tiny)
    table.cell(dbg, 1, 7, str.tostring(beTriggered), text_color=beTriggered ? color.orange : color.gray, text_size=size.tiny)
    
    table.cell(dbg, 0, 8, "TP1 Triggered", text_color=color.white, text_size=size.tiny)
    table.cell(dbg, 1, 8, str.tostring(tp1Triggered), text_color=tp1Triggered ? color.aqua : color.gray, text_size=size.tiny)
    
    table.cell(dbg, 0, 9, "Lot Size", text_color=color.white, text_size=size.tiny)
    table.cell(dbg, 1, 9, not na(calcLotSize) ? str.tostring(calcLotSize, "#.##") : "-", text_color=color.white, text_size=size.tiny)
    
    table.cell(dbg, 0, 10, "Last Bull POI", text_color=color.white, text_size=size.tiny)
    table.cell(dbg, 1, 10, lastTouchedPOI_bull != "" ? lastTouchedPOI_bull : "-", text_color=color.teal, text_size=size.tiny)
    
    table.cell(dbg, 0, 11, "Last Bear POI", text_color=color.white, text_size=size.tiny)
    table.cell(dbg, 1, 11, lastTouchedPOI_bear != "" ? lastTouchedPOI_bear : "-", text_color=color.red, text_size=size.tiny)
