//@version=6
indicator("MSNR Structure Pro - Clean", shorttitle="MSNR_PRO", overlay=true, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════
grp_clean = "── Pulizia Grafico ──"
filter_near    = input.bool(true,        "Abilita filtro distanza",         group=grp_clean)
filter_pct     = input.float(1.5,        "Distanza soglia (%)",             group=grp_clean, step=0.1)
filter_color   = input.color(color.gray, "Colore livelli lontani",          group=grp_clean)
filter_opacity = input.int(80,           "Trasparenza livelli lontani (%)", group=grp_clean, minval=0, maxval=95, step=5)
merge_pct      = input.float(0.05,       "Soglia fusione livelli (%)",      group=grp_clean, step=0.01, tooltip="Livelli entro questa % vengono uniti in una sola label")

grp_tf   = "── Timeframe Attivi ──"
show_W   = input.bool(true, "Weekly (W)",  group=grp_tf)
show_D   = input.bool(true, "Daily  (D)",  group=grp_tf)
show_H4  = input.bool(true, "H4",          group=grp_tf)
show_H1  = input.bool(true, "H1",          group=grp_tf)
show_M30 = input.bool(true, "M30",         group=grp_tf)
show_M15 = input.bool(true, "M15",         group=grp_tf)

grp_piv  = "── Pivot per TF ──"
piv_W    = input.int(5, "Pivot W",   minval=1, maxval=10, group=grp_piv)
piv_D    = input.int(3, "Pivot D",   minval=1, maxval=10, group=grp_piv)
piv_H4   = input.int(2, "Pivot H4",  minval=1, maxval=10, group=grp_piv)
piv_H1   = input.int(2, "Pivot H1",  minval=1, maxval=10, group=grp_piv)
piv_M30  = input.int(2, "Pivot M30", minval=1, maxval=10, group=grp_piv)
piv_M15  = input.int(2, "Pivot M15", minval=1, maxval=10, group=grp_piv)

grp_lev  = "── Livelli ──"
n_levels    = input.int(1,  "Livelli storici (TF superiori)", minval=1, maxval=5,   group=grp_lev)
ext_bars    = input.int(10, "Estensione linee (candele)",     minval=1, maxval=100, group=grp_lev)
offset_bars = input.int(10, "Offset dopo rottura",           minval=0, maxval=100, group=grp_lev)
max_levels  = input.int(8,  "Max livelli TF chart",          minval=2, maxval=50,  group=grp_lev)

grp_col  = "── Colori ──"
col_res  = input.color(color.new(color.red,  20), "Resistance (A)", group=grp_col)
col_sup  = input.color(color.new(color.teal, 20), "Support    (V)", group=grp_col)
col_rbs  = input.color(color.new(color.teal,  0), "RBS",            group=grp_col)
col_sbr  = input.color(color.new(color.red,   0), "SBR",            group=grp_col)

grp_ocl  = "── OCL ──"
show_ocl  = input.bool(true,                        "Mostra OCL",           group=grp_ocl)
ocl_W     = input.bool(true,                        "OCL Weekly (W)",       group=grp_ocl)
ocl_D     = input.bool(true,                        "OCL Daily  (D)",       group=grp_ocl)
ocl_H4    = input.bool(true,                        "OCL H4",               group=grp_ocl)
ocl_H1    = input.bool(true,                        "OCL H1",               group=grp_ocl)
col_ocl   = input.color(color.new(#00BFFF, 20),     "Colore OCL",           group=grp_ocl)
ocl_wid   = input.int(1,                            "Spessore OCL",         group=grp_ocl, minval=1, maxval=4)
ocl_max   = input.int(5,                            "Max OCL per TF",       group=grp_ocl, minval=1, maxval=20)
ocl_ext   = input.int(20,                           "Estensione OCL (candele)", group=grp_ocl, minval=1, maxval=200)
ocl_off   = input.int(10,                           "Offset dopo mitigazione", group=grp_ocl, minval=0, maxval=100)

grp_sty  = "── Stile ──"
line_wid = input.int(1,           "Spessore linea",   minval=1, maxval=4,                                    group=grp_sty)
line_sty = input.string("Solida", "Tipo linea",       options=["Solida","Tratteggiata","Puntini"],            group=grp_sty)
lbl_sz   = input.string(size.tiny,"Dimensione label", options=[size.tiny,size.small,size.normal,size.large],  group=grp_sty)
show_lbl = input.bool(true, "Mostra label",                                                                    group=grp_sty)

grp_dash = "── Dashboard ──"
show_dash = input.bool(true, "Mostra Dashboard", group=grp_dash)
dash_pos  = input.string(position.top_right, "Posizione", group=grp_dash,
             options=[position.top_right, position.top_left, position.bottom_right, position.bottom_left])
dash_size = input.string(size.small, "Testo", group=grp_dash,
             options=[size.tiny, size.small, size.normal, size.large])

// ══════════════════════════════════════════
// COSTANTI
// ══════════════════════════════════════════
ls        = line_sty == "Tratteggiata" ? line.style_dashed : line_sty == "Puntini" ? line.style_dotted : line.style_solid
ms_bar    = timeframe.in_seconds() * 1000
col_faded = color.new(filter_color, filter_opacity)
TRANSP    = color.new(color.black, 100)
LBL       = label.style_label_down

// Nome del TF corrente del grafico
chart_tf_name =
     timeframe.isintraday ?
     (timeframe.multiplier <= 15 ? "M15" :
      timeframe.multiplier <= 30 ? "M30" :
      timeframe.multiplier <= 60 ? "H1"  : "H4") :
     (timeframe.isdaily ? "D" : "W")

// ══════════════════════════════════════════
// FUNZIONI BASE
// ══════════════════════════════════════════
f_is_near(float p) =>
    na(p) ? false : not filter_near ? true : (math.abs(close - p) / p * 100) <= filter_pct

f_col(float p, color c) =>
    f_is_near(p) ? c : col_faded

f_is_duplicate(float p, float[] arr) =>
    bool dup = false
    if array.size(arr) > 0
        for v in arr
            if math.abs(v - p) < syminfo.mintick * 5
                dup := true
                break
    dup

// ══════════════════════════════════════════
// ARRAY GLOBALI ACCUMULATORI (HTF + chart)
// ══════════════════════════════════════════
var float[]  acc_prices  = array.new_float()
var int[]    acc_times   = array.new_int()
var int[]    acc_types   = array.new_int()
var string[] acc_txts    = array.new_string()
var color[]  acc_cols    = array.new_color()
var int[]    acc_ext     = array.new_int()
var int[]    acc_broken  = array.new_int()
var int[]    acc_break_t = array.new_int()

// Aggiunge/fonde un livello negli accumulatori globali
f_acc(float pr, int ts, int ext_ms, string tf_lbl, bool is_res, bool tf_show) =>
    if tf_show and not na(pr) and not na(ts)
        is_rbs   = is_res and close > pr
        is_sbr   = not is_res and close < pr
        cond_txt = is_rbs ? "RBS" : is_sbr ? "SBR" : is_res ? "classic A" : "classic V"
        col_base = is_res ? (is_rbs ? col_rbs : col_res) : (is_sbr ? col_sbr : col_sup)
        col_fin  = f_col(pr, col_base)
        int found = -1
        n = array.size(acc_prices)
        if n > 0
            for i = 0 to n - 1
                ep        = array.get(acc_prices, i)
                et        = array.get(acc_types,  i)
                same_type = (is_res and et == 1) or (not is_res and et == -1)
                if same_type and math.abs(ep - pr) / ep * 100 <= merge_pct
                    found := i
                    break
        if found >= 0
            old_txt = array.get(acc_txts, found)
            array.set(acc_txts, found, old_txt + " " + tf_lbl)
        else
            array.push(acc_prices,  pr)
            array.push(acc_times,   ts)
            array.push(acc_types,   is_res ? 1 : -1)
            array.push(acc_txts,    cond_txt + "  " + tf_lbl)
            array.push(acc_cols,    col_fin)
            array.push(acc_ext,     ext_ms)
            array.push(acc_broken,  (is_rbs or is_sbr) ? 1 : 0)
            array.push(acc_break_t, time)

// ══════════════════════════════════════════
// OCL — funzione HTF
// Restituisce: array di [price, time, is_bull(1/-1), state(0=attivo,1=mitigato), brk_time]
// ══════════════════════════════════════════

// Controlla se un prezzo OCL è in conflitto con i livelli SNR esistenti
// Usa acc_prices che viene popolato a barstate.islast — quindi il check OCL
// avviene dopo che acc è già stato riempito
f_ocl_conflict(float p) =>
    bool conflict = false
    n = array.size(acc_prices)
    if n > 0
        for i = 0 to n - 1
            ep = array.get(acc_prices, i)
            if math.abs(ep - p) / ep * 100 <= merge_pct
                conflict := true
                break
    conflict

// Funzione HTF per calcolare OCL su un TF superiore
// Ritorna arrays: prezzi OCL, timestamps, tipo (1=sup bull, -1=res bear), stato, brk_time
f_ocl_htf(int max_n) =>
    // Due candele consecutive stesso colore
    bull1 = close[1] > open[1]  // candela precedente rialzista
    bull0 = close[0] > open[0]  // candela corrente rialzista
    bear1 = close[1] < open[1]
    bear0 = close[0] < open[0]

    // OCL bull (supporto): zona tra close[1] e open[0], entrambe rialziste
    // OCL bear (resistenza): zona tra close[1] e open[0], entrambe ribassiste
    is_ocl_bull = bull1 and bull0
    is_ocl_bear = bear1 and bear0

    // Prezzo OCL = punto medio tra close[1] e open[0]
    ocl_price_bull = is_ocl_bull ? (close[1] + open[0]) / 2 : na
    ocl_price_bear = is_ocl_bear ? (close[1] + open[0]) / 2 : na

    var float[] o_prices = array.new_float()
    var int[]   o_times  = array.new_int()
    var int[]   o_types  = array.new_int()   // 1=bull sup, -1=bear res
    var int[]   o_states = array.new_int()   // 0=attivo, 1=mitigato
    var int[]   o_brkt   = array.new_int()   // timestamp mitigazione

    // Aggiungi nuovi OCL
    if not na(ocl_price_bull)
        bool dup = false
        if array.size(o_prices) > 0
            for v in o_prices
                if math.abs(v - ocl_price_bull) / ocl_price_bull * 100 <= merge_pct
                    dup := true
                    break
        if not dup
            array.unshift(o_prices, ocl_price_bull)
            array.unshift(o_times,  time[1])
            array.unshift(o_types,  1)
            array.unshift(o_states, 0)
            array.unshift(o_brkt,   0)

    if not na(ocl_price_bear)
        bool dup = false
        if array.size(o_prices) > 0
            for v in o_prices
                if math.abs(v - ocl_price_bear) / ocl_price_bear * 100 <= merge_pct
                    dup := true
                    break
        if not dup
            array.unshift(o_prices, ocl_price_bear)
            array.unshift(o_times,  time[1])
            array.unshift(o_types,  -1)
            array.unshift(o_states, 0)
            array.unshift(o_brkt,   0)

    // Aggiorna stato mitigazione: spike (high/low) O corpo (open/close) tocca il livello
    if array.size(o_prices) > 0
        for i = 0 to array.size(o_prices) - 1
            if array.get(o_states, i) == 0
                p  = array.get(o_prices, i)
                tp = array.get(o_types,  i)
                // bull support: mitigato se low <= p (spike) o open/close <= p (corpo)
                // bear resist:  mitigato se high >= p (spike) o open/close >= p (corpo)
                mitigated = tp == 1 ? (low <= p or math.min(open,close) <= p) :
                                      (high >= p or math.max(open,close) >= p)
                if mitigated
                    array.set(o_states, i, 1)
                    array.set(o_brkt,   i, time)

    // Mantieni solo max_n livelli
    if array.size(o_prices) > max_n
        array.pop(o_prices)
        array.pop(o_times)
        array.pop(o_types)
        array.pop(o_states)
        array.pop(o_brkt)

    [o_prices, o_times, o_types, o_states, o_brkt]

// Request OCL per i 4 TF
[oclW_p, oclW_t, oclW_tp, oclW_s, oclW_b]   = request.security(syminfo.tickerid, "W",   f_ocl_htf(ocl_max), lookahead=barmerge.lookahead_off)
[oclD_p, oclD_t, oclD_tp, oclD_s, oclD_b]   = request.security(syminfo.tickerid, "D",   f_ocl_htf(ocl_max), lookahead=barmerge.lookahead_off)
[oclH4_p,oclH4_t,oclH4_tp,oclH4_s,oclH4_b] = request.security(syminfo.tickerid, "240", f_ocl_htf(ocl_max), lookahead=barmerge.lookahead_off)
[oclH1_p,oclH1_t,oclH1_tp,oclH1_s,oclH1_b] = request.security(syminfo.tickerid, "60",  f_ocl_htf(ocl_max), lookahead=barmerge.lookahead_off)

// ══════════════════════════════════════════
// TF CHART — pivot su corpo candela
// Raccoglie pivot e li aggiunge agli accumulatori a barstate.islast
// ══════════════════════════════════════════
bh = math.max(open, close)
bl = math.min(open, close)

chart_pl = timeframe.isintraday ?
     (timeframe.multiplier <= 15 ? piv_M15 :
      timeframe.multiplier <= 30 ? piv_M30 :
      timeframe.multiplier <= 60 ? piv_H1  : piv_H4) :
     (timeframe.isdaily ? piv_D : piv_W)

ph = ta.pivothigh(bh, chart_pl, chart_pl)
pl = ta.pivotlow (bl, chart_pl, chart_pl)

// Salva pivot chart in array per disegnarli a islast
var float[] ch_prices  = array.new_float()
var int[]   ch_kinds   = array.new_int()    // 1=res, -1=sup
var int[]   ch_x1      = array.new_int()    // bar_index inizio
var int[]   ch_born    = array.new_int()    // bar_index nascita
var int[]   ch_states  = array.new_int()    // 0=attivo, 1=rotto
var int[]   ch_times   = array.new_int()    // time pivot
var int[]   ch_brk_t   = array.new_int()    // time rottura

// Aggiorna stati rottura ogni barra
if array.size(ch_prices) > 0
    for i = array.size(ch_prices) - 1 to 0
        if array.get(ch_states, i) == 0
            p    = array.get(ch_prices, i)
            k    = array.get(ch_kinds,  i)
            born = array.get(ch_born,   i)
            if bar_index > born
                crossed = k == 1 ? close > p : close < p
                if crossed
                    array.set(ch_states, i, 1)
                    array.set(ch_brk_t,  i, time)

// Nuovi pivot
if not na(ph) and not f_is_duplicate(ph, ch_prices)
    array.push(ch_prices, ph)
    array.push(ch_kinds,  1)
    array.push(ch_x1,     bar_index - chart_pl)
    array.push(ch_born,   bar_index)
    array.push(ch_states, 0)
    array.push(ch_times,  time[chart_pl])
    array.push(ch_brk_t,  0)

if not na(pl) and not f_is_duplicate(pl, ch_prices)
    array.push(ch_prices, pl)
    array.push(ch_kinds,  -1)
    array.push(ch_x1,     bar_index - chart_pl)
    array.push(ch_born,   bar_index)
    array.push(ch_states, 0)
    array.push(ch_times,  time[chart_pl])
    array.push(ch_brk_t,  0)

// Mantieni solo max_levels
if array.size(ch_prices) > max_levels
    array.shift(ch_prices)
    array.shift(ch_kinds)
    array.shift(ch_x1)
    array.shift(ch_born)
    array.shift(ch_states)
    array.shift(ch_times)
    array.shift(ch_brk_t)

// ══════════════════════════════════════════
// TF SUPERIORI
// ══════════════════════════════════════════
f_htf(int pl_len) =>
    bh_ = math.max(open, close)
    bl_ = math.min(open, close)
    ph_ = ta.pivothigh(bh_, pl_len, pl_len)
    pl_ = ta.pivotlow (bl_, pl_len, pl_len)
    var float[] h_vals  = array.new_float(5, na)
    var int[]   h_times = array.new_int(5, na)
    var float[] l_vals  = array.new_float(5, na)
    var int[]   l_times = array.new_int(5, na)
    if not na(ph_)
        array.unshift(h_vals,  ph_)
        array.pop(h_vals)
        array.unshift(h_times, time[pl_len])
        array.pop(h_times)
    if not na(pl_)
        array.unshift(l_vals,  pl_)
        array.pop(l_vals)
        array.unshift(l_times, time[pl_len])
        array.pop(l_times)
    ph0 = array.get(h_vals, 0)
    pl0 = array.get(l_vals, 0)
    up  = not na(ph0) and close > ph0 and close[1] <= ph0
    dn  = not na(pl0) and close < pl0 and close[1] >= pl0
    var float  tr = 0.0
    var string cd = "-"
    if up
        tr := 1.0
        cd := "RBS"
    if dn
        tr := -1.0
        cd := "SBR"
    [tr, cd,
     array.get(h_vals,0),  array.get(h_vals,1),  array.get(h_vals,2),  array.get(h_vals,3),  array.get(h_vals,4),
     array.get(h_times,0), array.get(h_times,1), array.get(h_times,2), array.get(h_times,3), array.get(h_times,4),
     array.get(l_vals,0),  array.get(l_vals,1),  array.get(l_vals,2),  array.get(l_vals,3),  array.get(l_vals,4),
     array.get(l_times,0), array.get(l_times,1), array.get(l_times,2), array.get(l_times,3), array.get(l_times,4)]

[trW,  cdW,  Wh0,  Wh1,  Wh2,  Wh3,  Wh4,  Wt0,   Wt1,   Wt2,   Wt3,   Wt4,   Wl0,   Wl1,   Wl2,   Wl3,   Wl4,   Wlt0,  Wlt1,  Wlt2,  Wlt3,  Wlt4]  = request.security(syminfo.tickerid,"W",   f_htf(piv_W),  lookahead=barmerge.lookahead_off)
[trD,  cdD,  Dh0,  Dh1,  Dh2,  Dh3,  Dh4,  Dt0,   Dt1,   Dt2,   Dt3,   Dt4,   Dl0,   Dl1,   Dl2,   Dl3,   Dl4,   Dlt0,  Dlt1,  Dlt2,  Dlt3,  Dlt4]  = request.security(syminfo.tickerid,"D",   f_htf(piv_D),  lookahead=barmerge.lookahead_off)
[tr4,  cd4,  H40,  H41,  H42,  H43,  H44,  H4t0,  H4t1,  H4t2,  H4t3,  H4t4,  H4l0,  H4l1,  H4l2,  H4l3,  H4l4,  H4lt0, H4lt1, H4lt2, H4lt3, H4lt4] = request.security(syminfo.tickerid,"240",f_htf(piv_H4), lookahead=barmerge.lookahead_off)
[tr1,  cd1,  H10,  H11,  H12,  H13,  H14,  H1t0,  H1t1,  H1t2,  H1t3,  H1t4,  H1l0,  H1l1,  H1l2,  H1l3,  H1l4,  H1lt0, H1lt1, H1lt2, H1lt3, H1lt4] = request.security(syminfo.tickerid,"60", f_htf(piv_H1), lookahead=barmerge.lookahead_off)
[tr30, cd30, M300, M301, M302, M303, M304, M30t0, M30t1, M30t2, M30t3, M30t4, M30l0, M30l1, M30l2, M30l3, M30l4, M30lt0,M30lt1,M30lt2,M30lt3,M30lt4] = request.security(syminfo.tickerid,"30", f_htf(piv_M30),lookahead=barmerge.lookahead_off)
[tr15, cd15, M150, M151, M152, M153, M154, M15t0, M15t1, M15t2, M15t3, M15t4, M15l0, M15l1, M15l2, M15l3, M15l4, M15lt0,M15lt1,M15lt2,M15lt3,M15lt4] = request.security(syminfo.tickerid,"15", f_htf(piv_M15),lookahead=barmerge.lookahead_off)

// ══════════════════════════════════════════
// DISEGNO UNIFICATO A barstate.islast
// ══════════════════════════════════════════
if barstate.islast

    // Pulisce accumulatori
    array.clear(acc_prices)
    array.clear(acc_times)
    array.clear(acc_types)
    array.clear(acc_txts)
    array.clear(acc_cols)
    array.clear(acc_ext)
    array.clear(acc_broken)
    array.clear(acc_break_t)

    ext_chart = ext_bars * ms_bar
    ext_W     = ext_bars * (7 * 24 * 60 * 60 * 1000)
    ext_D     = ext_bars * (24 * 60 * 60 * 1000)
    ext_H4    = ext_bars * (4 * 60 * 60 * 1000)
    ext_H1    = ext_bars * (60 * 60 * 1000)
    ext_M30   = ext_bars * (30 * 60 * 1000)
    ext_M15   = ext_bars * (15 * 60 * 1000)

    // 1) Aggiunge tutti i pivot TF chart all'accumulatore
    n_ch = array.size(ch_prices)
    if n_ch > 0
        for i = 0 to n_ch - 1
            p      = array.get(ch_prices, i)
            k      = array.get(ch_kinds,  i)
            ts     = array.get(ch_times,  i)
            st     = array.get(ch_states, i)
            bt     = array.get(ch_brk_t,  i)
            is_res = k == 1
            // Passa il timestamp di rottura reale per disegnare il tratteggio corretto
            if st == 1 and bt > 0
                // Livello rotto: aggiunge con break_time reale
                is_rbs   = is_res
                is_sbr   = not is_res
                cond_txt = is_rbs ? "RBS" : "SBR"
                col_base = is_res ? col_rbs : col_sbr
                col_fin  = f_col(p, col_base)
                array.push(acc_prices,  p)
                array.push(acc_times,   ts)
                array.push(acc_types,   is_res ? 1 : -1)
                array.push(acc_txts,    cond_txt + "  " + chart_tf_name)
                array.push(acc_cols,    col_fin)
                array.push(acc_ext,     ext_chart)
                array.push(acc_broken,  1)
                array.push(acc_break_t, bt)
            else
                f_acc(p, ts, ext_chart, chart_tf_name, is_res, true)

    // 2) Aggiunge livelli TF superiori (dal più alto)
    // TF superiori: escludi il TF corrente del grafico (già gestito dai pivot chart)
    is_W   = timeframe.isweekly
    is_D   = timeframe.isdaily
    is_H4  = timeframe.isintraday and timeframe.multiplier == 240
    is_H1  = timeframe.isintraday and timeframe.multiplier == 60
    is_M30 = timeframe.isintraday and timeframe.multiplier == 30
    is_M15 = timeframe.isintraday and timeframe.multiplier == 15

    f_acc(Wh0,  Wt0,   ext_W,   "W",   true,  show_W   and not is_W)
    f_acc(Wl0,  Wlt0,  ext_W,   "W",   false, show_W   and not is_W)
    if n_levels >= 2
        f_acc(Wh1, Wt1, ext_W, "W", true,  show_W and not is_W)
        f_acc(Wl1, Wlt1, ext_W, "W", false, show_W and not is_W)
    if n_levels >= 3
        f_acc(Wh2, Wt2, ext_W, "W", true,  show_W and not is_W)
        f_acc(Wl2, Wlt2, ext_W, "W", false, show_W and not is_W)

    f_acc(Dh0,  Dt0,   ext_D,   "D",   true,  show_D   and not is_D)
    f_acc(Dl0,  Dlt0,  ext_D,   "D",   false, show_D   and not is_D)
    if n_levels >= 2
        f_acc(Dh1, Dt1, ext_D, "D", true,  show_D and not is_D)
        f_acc(Dl1, Dlt1, ext_D, "D", false, show_D and not is_D)
    if n_levels >= 3
        f_acc(Dh2, Dt2, ext_D, "D", true,  show_D and not is_D)
        f_acc(Dl2, Dlt2, ext_D, "D", false, show_D and not is_D)

    f_acc(H40,  H4t0,  ext_H4,  "H4",  true,  show_H4  and not is_H4)
    f_acc(H4l0, H4lt0, ext_H4,  "H4",  false, show_H4  and not is_H4)
    if n_levels >= 2
        f_acc(H41, H4t1, ext_H4, "H4", true,  show_H4 and not is_H4)
        f_acc(H4l1, H4lt1, ext_H4, "H4", false, show_H4 and not is_H4)

    f_acc(H10,  H1t0,  ext_H1,  "H1",  true,  show_H1  and not is_H1)
    f_acc(H1l0, H1lt0, ext_H1,  "H1",  false, show_H1  and not is_H1)
    if n_levels >= 2
        f_acc(H11, H1t1, ext_H1, "H1", true,  show_H1 and not is_H1)
        f_acc(H1l1, H1lt1, ext_H1, "H1", false, show_H1 and not is_H1)

    f_acc(M300,  M30t0,  ext_M30, "M30", true,  show_M30 and not is_M30)
    f_acc(M30l0, M30lt0, ext_M30, "M30", false, show_M30 and not is_M30)
    if n_levels >= 2
        f_acc(M301, M30t1, ext_M30, "M30", true,  show_M30 and not is_M30)
        f_acc(M30l1, M30lt1, ext_M30, "M30", false, show_M30 and not is_M30)

    f_acc(M150,  M15t0,  ext_M15, "M15", true,  show_M15 and not is_M15)
    f_acc(M15l0, M15lt0, ext_M15, "M15", false, show_M15 and not is_M15)
    if n_levels >= 2
        f_acc(M151, M15t1, ext_M15, "M15", true,  show_M15 and not is_M15)
        f_acc(M15l1, M15lt1, ext_M15, "M15", false, show_M15 and not is_M15)

    // 3) Disegna tutti i livelli fusi
    n = array.size(acc_prices)
    if n > 0
        for i = 0 to n - 1
            pr      = array.get(acc_prices, i)
            ts      = array.get(acc_times,  i)
            ext_ms  = array.get(acc_ext,    i)
            txt     = array.get(acc_txts,   i)
            col     = array.get(acc_cols,   i)
            broken  = array.get(acc_broken, i)
            brk_t   = array.get(acc_break_t, i)
            t_end   = time + ext_ms
            if broken == 1
                // Linea solida dal pivot al punto di rottura
                line.new(ts, pr, brk_t, pr, xloc=xloc.bar_time, color=col, width=line_wid, style=ls)
                // Linea tratteggiata dal punto di rottura in avanti
                line.new(brk_t, pr, t_end, pr, xloc=xloc.bar_time, color=col, width=line_wid, style=line.style_dashed)
            else
                line.new(ts, pr, t_end, pr, xloc=xloc.bar_time, color=col, width=line_wid, style=ls)
            if show_lbl
                label.new(t_end, pr, txt, xloc=xloc.bar_time,
                          color=TRANSP, textcolor=col, style=LBL, size=lbl_sz)

// ══════════════════════════════════════════
// DISEGNO OCL a barstate.islast
// ══════════════════════════════════════════
f_draw_ocl(float[] o_prices, int[] o_times, int[] o_types, int[] o_states, int[] o_brkt, string tf_lbl, bool enabled, int ext_ms, int off_ms) =>
    if show_ocl and enabled and barstate.islast
        n = array.size(o_prices)
        if n > 0
            for i = 0 to n - 1
                p   = array.get(o_prices, i)
                ts  = array.get(o_times,  i)
                st  = array.get(o_states, i)
                bt  = array.get(o_brkt,   i)
                // Controlla conflitto con livelli SNR esistenti
                if not f_ocl_conflict(p) and not na(p) and not na(ts)
                    col_base = f_is_near(p) ? col_ocl : col_faded
                    t_end    = time + ext_ms
                    txt      = "OCL  " + tf_lbl
                    if st == 1 and bt > 0
                        // Mitigato: linea solida fino alla mitigazione + tratteggio con offset
                        line.new(ts,  p, bt,          p, xloc=xloc.bar_time, color=col_base, width=ocl_wid, style=line.style_solid)
                        line.new(bt,  p, bt + off_ms, p, xloc=xloc.bar_time, color=col_base, width=ocl_wid, style=line.style_dashed)
                        if show_lbl
                            label.new(bt + off_ms, p, txt, xloc=xloc.bar_time,
                                      color=TRANSP, textcolor=col_base, style=LBL, size=lbl_sz)
                    else
                        // Attivo: linea solida estesa
                        line.new(ts, p, t_end, p, xloc=xloc.bar_time, color=col_base, width=ocl_wid, style=line.style_solid)
                        if show_lbl
                            label.new(t_end, p, txt, xloc=xloc.bar_time,
                                      color=TRANSP, textcolor=col_base, style=LBL, size=lbl_sz)

if barstate.islast
    ext_ocl_W  = ocl_ext * (7 * 24 * 60 * 60 * 1000)
    ext_ocl_D  = ocl_ext * (24 * 60 * 60 * 1000)
    ext_ocl_H4 = ocl_ext * (4 * 60 * 60 * 1000)
    ext_ocl_H1 = ocl_ext * (60 * 60 * 1000)
    off_ocl_W  = ocl_off * (7 * 24 * 60 * 60 * 1000)
    off_ocl_D  = ocl_off * (24 * 60 * 60 * 1000)
    off_ocl_H4 = ocl_off * (4 * 60 * 60 * 1000)
    off_ocl_H1 = ocl_off * (60 * 60 * 1000)

    f_draw_ocl(oclW_p,  oclW_t,  oclW_tp,  oclW_s,  oclW_b,  "W",  ocl_W,  ext_ocl_W,  off_ocl_W)
    f_draw_ocl(oclD_p,  oclD_t,  oclD_tp,  oclD_s,  oclD_b,  "D",  ocl_D,  ext_ocl_D,  off_ocl_D)
    f_draw_ocl(oclH4_p, oclH4_t, oclH4_tp, oclH4_s, oclH4_b, "H4", ocl_H4, ext_ocl_H4, off_ocl_H4)
    f_draw_ocl(oclH1_p, oclH1_t, oclH1_tp, oclH1_s, oclH1_b, "H1", ocl_H1, ext_ocl_H1, off_ocl_H1)

// ══════════════════════════════════════════
// DASHBOARD — W → D → H4 → H1 → M30 → M15
// ══════════════════════════════════════════
f_dash_row(table tbl, int row, string name, float tr, string cd, float p, string d_size) =>
    bg = tr == 1.0 ? color.new(color.teal,45) : tr == -1.0 ? color.new(color.red,45) : color.new(color.gray,65)
    table.cell(tbl,0,row, name,                                                bgcolor=bg,                        text_color=color.white,  text_size=d_size)
    table.cell(tbl,1,row, not na(p) ? str.tostring(p, format.mintick) : "-",  bgcolor=color.new(color.black,55), text_color=color.silver, text_size=d_size)
    table.cell(tbl,2,row, cd,                                                  bgcolor=bg,                        text_color=color.white,  text_size=d_size)
    table.cell(tbl,3,row, tr == 1.0 ? "▲ BUY" : tr == -1.0 ? "▼ SELL" : "-", bgcolor=bg,                        text_color=color.white,  text_size=d_size)

if show_dash and barstate.islast
    var table tbl = table.new(dash_pos, 4, 7, border_color=color.new(color.gray,50), border_width=1, frame_color=color.new(color.gray,30), frame_width=1)
    hbg = color.new(#0d0d1a, 5)
    table.cell(tbl,0,0,"TF",      bgcolor=hbg, text_color=color.white, text_size=dash_size)
    table.cell(tbl,1,0,"LIVELLO", bgcolor=hbg, text_color=color.white, text_size=dash_size)
    table.cell(tbl,2,0,"COND",    bgcolor=hbg, text_color=color.white, text_size=dash_size)
    table.cell(tbl,3,0,"BIAS",    bgcolor=hbg, text_color=color.white, text_size=dash_size)
    int row = 1
    if show_W
        f_dash_row(tbl, row, "W",   trW,  cdW,  Wh0,  dash_size)
        row += 1
    if show_D
        f_dash_row(tbl, row, "D",   trD,  cdD,  Dh0,  dash_size)
        row += 1
    if show_H4
        f_dash_row(tbl, row, "H4",  tr4,  cd4,  H40,  dash_size)
        row += 1
    if show_H1
        f_dash_row(tbl, row, "H1",  tr1,  cd1,  H10,  dash_size)
        row += 1
    if show_M30
        f_dash_row(tbl, row, "M30", tr30, cd30, M300, dash_size)
        row += 1
    if show_M15
        f_dash_row(tbl, row, "M15", tr15, cd15, M150, dash_size)
        row += 1
