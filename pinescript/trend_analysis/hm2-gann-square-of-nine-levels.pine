//@version=5
// =====================================================================
// GANN SQUARE OF NINE LEVELS
// =====================================================================
// Dynamic support and resistance from Gann's Square of Nine spiral.
//
// HOW TO USE:
//   - Lines ABOVE price = resistance (price may stall or reverse here)
//   - Lines BELOW price = support (price may bounce here)
//   - Thicker/brighter lines = stronger levels
//   - The info table shows your nearest support & resistance with prices
//
// MATH: Level = (√Pivot ± degrees/360)²
// Cardinal levels (90°, 180°, 270°, 360°) are strongest.
// Works on any asset/timeframe.
// =====================================================================

indicator("Gann Square of Nine Levels", overlay=true, max_lines_count=500, max_labels_count=500)

// ========================================
// INPUT PARAMETERS
// ========================================
i_pivotMode   = input.string("Auto", "Pivot Mode", options=["Auto", "Manual"], group="Core", tooltip="Auto uses the midpoint of the lookback range.")
i_manualPivot = input.float(0.0, "Manual Pivot Price", minval=0, group="Core", tooltip="Only used when Pivot Mode is Manual.")
i_period      = input.int(64, "Lookback Period", minval=10, maxval=500, group="Core")
i_stepBack    = input.int(0, "Step Back", minval=0, maxval=100, group="Core")
i_rotations   = input.int(2, "Rotations", minval=1, maxval=4, group="Core", tooltip="Full 360° cycles above and below. 2 is usually enough.")

i_showOrdinal = input.bool(false, "Show Minor Levels (45°)", group="Display", tooltip="Adds secondary levels between the main ones. Off by default for a cleaner chart.")
i_showFill    = input.bool(true, "Show Zone Fills", group="Display", tooltip="Subtle shading between cycle boundaries.")
i_showTable   = input.bool(true, "Show Info Table", group="Display")
i_showLabels  = input.bool(true, "Show Price Labels", group="Display")
i_labelOffset = input.int(5, "Label Offset (bars)", minval=0, maxval=50, group="Display")

color_360     = input.color(color.rgb(33, 150, 243), "Strong Level (360°)", group="Colors")
color_180     = input.color(color.rgb(76, 175, 80), "Medium Level (180°)", group="Colors")
color_90      = input.color(color.rgb(239, 83, 80), "Standard Level (90°)", group="Colors")
color_ordinal = input.color(color.rgb(158, 158, 158, 60), "Minor Level (45°)", group="Colors")

// ========================================
// HELPERS
// ========================================
gannUp(float p, float deg) =>
    math.pow(math.sqrt(p) + deg / 360.0, 2)

gannDn(float p, float deg) =>
    float v = math.sqrt(p) - deg / 360.0
    v > 0 ? math.pow(v, 2) : na

// ========================================
// PIVOT
// ========================================
int lb = i_period + i_stepBack
float pivot = i_pivotMode == "Manual" and i_manualPivot > 0 ? i_manualPivot : (ta.highest(high, lb) + ta.lowest(low, lb)) / 2.0

// ========================================
// DRAW ON LAST BAR
// ========================================
if barstate.islast
    line.all.clear()
    label.all.clear()
    
    // --- Pivot line ---
    line.new(bar_index - 120, pivot, bar_index + 25, pivot,
             color=color_360, width=3, style=line.style_solid)
    if i_showLabels
        label.new(bar_index + i_labelOffset, pivot,
                 "● PIVOT  " + str.tostring(pivot, format.mintick),
                 style=label.style_none, textcolor=color_360,
                 size=size.small, textalign=text.align_left)
    
    // Track nearest support (below price) and resistance (above price)
    float nearResist = 1e10
    string nearResistName = ""
    float nearSupport = 0.0
    string nearSupportName = ""
    
    // Track zone fill boundaries
    float prevUp = pivot
    float prevDn = pivot
    
    for rot = 0 to i_rotations - 1
        color zoneTint = rot % 2 == 0 ? color.new(color_360, 95) : color.new(color_360, 97)
        
        for step = 1 to 8
            float deg = rot * 360.0 + step * 45.0
            int angleMod = step * 45
            bool isCardinal = angleMod == 90 or angleMod == 180 or angleMod == 270 or angleMod == 360
            
            float lvlUp = gannUp(pivot, deg)
            float lvlDn = gannDn(pivot, deg)
            
            if not isCardinal and not i_showOrdinal
                continue
            
            // --- Visual strength ---
            color col = color_ordinal
            int   w   = 1
            string lstyle = line.style_dotted
            string strength = "Minor"
            
            if angleMod == 360
                col := color_360
                w   := 2
                lstyle := line.style_solid
                strength := "Strong"
            else if angleMod == 180
                col := color_180
                w   := 2
                lstyle := line.style_dashed
                strength := "Medium"
            else if angleMod == 90 or angleMod == 270
                col := color_90
                w   := 1
                lstyle := line.style_dashed
                strength := "Standard"
            
            if rot >= 2
                col := color.new(col, 60)
            
            // --- UPPER level (Resistance) ---
            line.new(bar_index - 120, lvlUp, bar_index + 25, lvlUp,
                     color=col, width=w, style=lstyle)
            
            // Track nearest resistance
            if lvlUp > close and lvlUp < nearResist
                nearResist := lvlUp
                nearResistName := str.tostring(deg, "#") + "° " + strength
            
            // Label: angle + Gann name + S/R + price
            if i_showLabels and isCardinal
                string gannName = angleMod == 360 ? "Cycle" : angleMod == 180 ? "Opposition" : "Square"
                string rLabel = "[" + str.tostring(deg, "#") + "°] " + gannName + " R  " + str.tostring(lvlUp, format.mintick)
                label.new(bar_index + i_labelOffset, lvlUp, rLabel,
                         style=label.style_none, textcolor=col,
                         size=size.tiny, textalign=text.align_left)
            
            // --- LOWER level (Support) ---
            if not na(lvlDn) and lvlDn < pivot
                line.new(bar_index - 120, lvlDn, bar_index + 25, lvlDn,
                         color=col, width=w, style=lstyle)
                
                // Track nearest support
                if lvlDn < close and lvlDn > nearSupport
                    nearSupport := lvlDn
                    nearSupportName := str.tostring(deg, "#") + "° " + strength
                
                if i_showLabels and isCardinal
                    string gannName2 = angleMod == 360 ? "Cycle" : angleMod == 180 ? "Opposition" : "Square"
                    string sLabel = "[" + str.tostring(deg, "#") + "°] " + gannName2 + " S  " + str.tostring(lvlDn, format.mintick)
                    label.new(bar_index + i_labelOffset, lvlDn, sLabel,
                             style=label.style_none, textcolor=col,
                             size=size.tiny, textalign=text.align_left)
            
            // --- Zone fills between 360° boundaries ---
            if i_showFill and angleMod == 360
                linefill.new(
                     line.new(bar_index - 120, prevUp, bar_index + 25, prevUp, color=na),
                     line.new(bar_index - 120, lvlUp, bar_index + 25, lvlUp, color=na),
                     color=zoneTint)
                prevUp := lvlUp
                
                if not na(lvlDn) and lvlDn < pivot
                    linefill.new(
                         line.new(bar_index - 120, lvlDn, bar_index + 25, lvlDn, color=na),
                         line.new(bar_index - 120, prevDn, bar_index + 25, prevDn, color=na),
                         color=zoneTint)
                    prevDn := lvlDn
    
    // --- Highlight nearest support & resistance ---
    if nearResist < 1e10
        line.new(bar_index - 120, nearResist, bar_index + 25, nearResist,
                 color=color.new(color.white, 50), width=1, style=line.style_dotted)
    if nearSupport > 0
        line.new(bar_index - 120, nearSupport, bar_index + 25, nearSupport,
                 color=color.new(color.white, 50), width=1, style=line.style_dotted)
    
    // --- Info Table ---
    if i_showTable
        var table infoTable = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 80), border_width=1)
        
        float resistPct = nearResist < 1e10 ? (nearResist - close) / close * 100 : 0.0
        float supportPct = nearSupport > 0 ? (close - nearSupport) / close * 100 : 0.0
        
        float rangePos = (nearResist < 1e10 and nearSupport > 0) ? (close - nearSupport) / (nearResist - nearSupport) * 100 : 50.0
        string posStr = rangePos < 25 ? "Near Support" : rangePos > 75 ? "Near Resistance" : "Mid-Range"
        color  posCol = rangePos < 25 ? color_180 : rangePos > 75 ? color_90 : color.rgb(255, 193, 7)
        
        // Spiral position for expert context
        float sqDiff = math.abs(math.sqrt(close) - math.sqrt(pivot))
        float spiralAngle = sqDiff * 360.0
        int   spiralRot = int(math.floor(spiralAngle / 360.0))
        float angleInRot = spiralAngle - spiralRot * 360.0
        
        table.cell(infoTable, 0, 0, "Pivot", text_color=color.gray, text_size=size.tiny)
        table.cell(infoTable, 1, 0, str.tostring(pivot, format.mintick), text_color=color_360, text_size=size.small)
        
        table.cell(infoTable, 0, 1, "Resistance ↑", text_color=color.gray, text_size=size.tiny)
        if nearResist < 1e10
            table.cell(infoTable, 1, 1, str.tostring(nearResist, format.mintick) + "  (+" + str.tostring(resistPct, "#.##") + "%)  " + nearResistName, text_color=color_90, text_size=size.small)
        else
            table.cell(infoTable, 1, 1, "—", text_color=color.gray, text_size=size.small)
        
        table.cell(infoTable, 0, 2, "Support ↓", text_color=color.gray, text_size=size.tiny)
        if nearSupport > 0
            table.cell(infoTable, 1, 2, str.tostring(nearSupport, format.mintick) + "  (-" + str.tostring(supportPct, "#.##") + "%)  " + nearSupportName, text_color=color_180, text_size=size.small)
        else
            table.cell(infoTable, 1, 2, "—", text_color=color.gray, text_size=size.small)
        
        table.cell(infoTable, 0, 3, "Range Position", text_color=color.gray, text_size=size.tiny)
        table.cell(infoTable, 1, 3, posStr + "  (" + str.tostring(rangePos, "#") + "%)", text_color=posCol, text_size=size.small)
        
        table.cell(infoTable, 0, 4, "Spiral", text_color=color.gray, text_size=size.tiny)
        string dirStr = close > pivot ? "↑" : "↓"
        table.cell(infoTable, 1, 4, dirStr + " " + str.tostring(angleInRot, "#") + "° in Rotation " + str.tostring(spiralRot + 1), text_color=color.white, text_size=size.tiny)

// ========================================
// ALERT LEVELS
// ========================================
float up90   = gannUp(pivot, 90)
float up180  = gannUp(pivot, 180)
float up360  = gannUp(pivot, 360)
float dn90   = gannDn(pivot, 90)
float dn180  = gannDn(pivot, 180)
float dn360  = gannDn(pivot, 360)

plot(pivot, "Pivot", color=color.new(color_360, 100), display=display.none)
plot(up90, "90° Up", color=color.new(color_90, 100), display=display.none)
plot(up180, "180° Up", color=color.new(color_180, 100), display=display.none)
plot(up360, "360° Up", color=color.new(color_360, 100), display=display.none)
plot(nz(dn90), "90° Down", color=color.new(color_90, 100), display=display.none)
plot(nz(dn180), "180° Down", color=color.new(color_180, 100), display=display.none)
plot(nz(dn360), "360° Down", color=color.new(color_360, 100), display=display.none)

// ========================================
// ALERTS
// ========================================
alertcondition(ta.cross(close, up90) or (not na(dn90) and ta.cross(close, dn90)), "Cross Standard Level (90°)", "Price crossed a Gann standard support/resistance level")
alertcondition(ta.cross(close, up180) or (not na(dn180) and ta.cross(close, dn180)), "Cross Medium Level (180°)", "Price crossed a Gann medium-strength level")
alertcondition(ta.cross(close, up360) or (not na(dn360) and ta.cross(close, dn360)), "Cross Strong Level (360°)", "Price crossed a Gann strong support/resistance level — full cycle boundary")
