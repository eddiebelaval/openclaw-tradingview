//@version=6
indicator("Signal Goat HH HL LH LL Extension Lines", overlay=true, max_lines_count=500, max_labels_count=500)

//────────────────────────────────────
// Inputs
//────────────────────────────────────
pivotLen      = input.int(5, "Pivot Length", minval=1)
extendBars    = input.int(50, "Extension Bars", minval=1)
showLabels    = input.bool(true, "Show HH/HL/LH/LL Labels")
showHighLines = input.bool(true, "Show High Structure Lines")
showLowLines  = input.bool(true, "Show Low Structure Lines")

hhColor = input.color(color.lime, "HH Color")
hlColor = input.color(color.green, "HL Color")
lhColor = input.color(color.orange, "LH Color")
llColor = input.color(color.red, "LL Color")

lineWidth = input.int(2, "Line Width", minval=1, maxval=5)

//────────────────────────────────────
// Pivot Detection
//────────────────────────────────────
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

pivotHighBar = bar_index - pivotLen
pivotLowBar  = bar_index - pivotLen

// Store previous confirmed pivots
var float prevHigh = na
var float prevLow  = na

//────────────────────────────────────
// High Structure: HH / LH
//────────────────────────────────────
if not na(ph)
    isHH = na(prevHigh) ? false : ph > prevHigh
    isLH = na(prevHigh) ? false : ph < prevHigh

    if showHighLines
        line.new(
             x1 = pivotHighBar,
             y1 = ph,
             x2 = pivotHighBar + extendBars,
             y2 = ph,
             xloc = xloc.bar_index,
             extend = extend.none,
             color = isHH ? hhColor : lhColor,
             width = lineWidth,
             style = line.style_solid)

    if showLabels and not na(prevHigh)
        label.new(
             x = pivotHighBar,
             y = ph,
             text = isHH ? "HH" : isLH ? "LH" : "EH",
             style = label.style_label_down,
             color = isHH ? hhColor : isLH ? lhColor : color.gray,
             textcolor = color.white,
             size = size.small)

    prevHigh := ph

//────────────────────────────────────
// Low Structure: HL / LL
//────────────────────────────────────
if not na(pl)
    isHL = na(prevLow) ? false : pl > prevLow
    isLL = na(prevLow) ? false : pl < prevLow

    if showLowLines
        line.new(
             x1 = pivotLowBar,
             y1 = pl,
             x2 = pivotLowBar + extendBars,
             y2 = pl,
             xloc = xloc.bar_index,
             extend = extend.none,
             color = isHL ? hlColor : llColor,
             width = lineWidth,
             style = line.style_solid)

    if showLabels and not na(prevLow)
        label.new(
             x = pivotLowBar,
             y = pl,
             text = isHL ? "HL" : isLL ? "LL" : "EL",
             style = label.style_label_up,
             color = isHL ? hlColor : isLL ? llColor : color.gray,
             textcolor = color.white,
             size = size.small)

    prevLow := pl
