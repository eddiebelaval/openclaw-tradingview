// ─────────────────────────────────────────────────────────────────────────────
alertcondition(buySignal,  "Projection Box BUY",  "Volume Profile Projection Box — BUY: price broke up through VAL")
alertcondition(sellSignal, "Projection Box SELL", "Volume Profile Projection Box — SELL: price broke down through VAH")

