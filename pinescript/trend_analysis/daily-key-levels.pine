//@version=6
indicator("Daily Key Levels", overlay=true, precision=2, max_lines_count=500, max_labels_count=500)

// ============================================
// INPUTS
// ============================================

showLevel1 = input.bool(true, "18:00 Market Open", group="Levels")
showLevel2 = input.bool(true, "8:30 News Level",   group="Levels")
showLevel3 = input.bool(true, "9:30 NY Open",      group="Levels")
showLevel4 = input.bool(true, "10:00 Level",       group="Levels")

color1 = input.color(color.new(#FF6B6B, 0), "18:00", group="Style", inline="l18")
width18 = input.int(1, "Width", minval=1, maxval=5, group="Style", inline="l18")
style18Input = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group="Style", inline="l18")
style18 = style18Input == "Solid" ? line.style_solid : style18Input == "Dashed" ? line.style_dashed : line.style_dotted

color2 = input.color(color.new(#4ECDC4, 0), "08:30", group="Style", inline="l830")
width830 = input.int(1, "Width", minval=1, maxval=5, group="Style", inline="l830")
style830Input = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group="Style", inline="l830")
style830 = style830Input == "Solid" ? line.style_solid : style830Input == "Dashed" ? line.style_dashed : line.style_dotted

color3 = input.color(color.new(#FFE66D, 0), "09:30", group="Style", inline="l930")
width930 = input.int(1, "Width", minval=1, maxval=5, group="Style", inline="l930")
style930Input = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group="Style", inline="l930")
style930 = style930Input == "Solid" ? line.style_solid : style930Input == "Dashed" ? line.style_dashed : line.style_dotted

color4 = input.color(color.new(#95E1D3, 0), "10:00", group="Style", inline="l1000")
width1000 = input.int(1, "Width", minval=1, maxval=5, group="Style", inline="l1000")
style1000Input = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group="Style", inline="l1000")
style1000 = style1000Input == "Solid" ? line.style_solid : style1000Input == "Dashed" ? line.style_dashed : line.style_dotted

showLabels = input.bool(true, "Show Labels", group="Labels")

// ============================================
// SESSION STATE (via 1m chart)
// ============================================
// We persist levels inside the 1m context so higher timeframes always see the
// latest value (not just the exact minute). The session day resets at 18:00 NY.

f_sessionState() =>
    var float s18    = na
    var float s830   = na
    var float s930   = na
    var float s1000  = na
    var int   t18    = na
    var int   t830   = na
    var int   t930   = na
    var int   t1000  = na
    var int   lastKey = na

    ny_h = hour(time, "America/New_York")
    ny_m = minute(time, "America/New_York")

    // Shift time by 18h so the "day" rolls over at 18:00 NY.
    shiftMs  = 18 * 60 * 60 * 1000
    keyYear  = year(time - shiftMs, "America/New_York")
    keyMonth = month(time - shiftMs, "America/New_York")
    keyDom   = dayofmonth(time - shiftMs, "America/New_York")
    sessKey  = keyYear * 10000 + keyMonth * 100 + keyDom

    if na(lastKey) or sessKey != lastKey
        s18     := na
        s830    := na
        s930    := na
        s1000   := na
        t18     := na
        t830    := na
        t930    := na
        t1000   := na
        lastKey := sessKey

    // Capture open + time at the exact session minute (latch once per day)
    if ny_h == 18 and ny_m == 0  and na(s18)
        s18 := open
        t18 := time
    if ny_h == 8  and ny_m == 30 and na(s830)
        s830 := open
        t830 := time
    if ny_h == 9  and ny_m == 30 and na(s930)
        s930 := open
        t930 := time
    if ny_h == 10 and ny_m == 0  and na(s1000)
        s1000 := open
        t1000 := time

    [s18, s830, s930, s1000, t18, t830, t930, t1000]

[level18, level830, level930, level1000,
 t18,     t830,     t930,     t1000] = request.security(
     syminfo.tickerid, "1", f_sessionState(), gaps=barmerge.gaps_off)

// ============================================
// LINES + LABELS (redrawn on every bar)
// ============================================

var line  ln18    = na
var line  ln830   = na
var line  ln930   = na
var line  ln1000  = na
var label lbl18   = na
var label lbl830  = na
var label lbl930  = na
var label lbl1000 = na

f_updateLine(ln, lbl, show, lvl, start_t, clr, txt, w, stl) =>
    line  new_ln  = na
    label new_lbl = na
    if show and not na(lvl) and not na(start_t)
        if na(ln)
            new_ln := line.new(start_t, lvl, time, lvl,
                 color=clr, width=w, style=stl, extend=extend.none, xloc=xloc.bar_time)
        else
            line.set_x1(ln, start_t)
            line.set_x2(ln, time)
            line.set_y1(ln, lvl)
            line.set_y2(ln, lvl)
            line.set_width(ln, w)
            line.set_style(ln, stl)
            new_ln := ln
        if showLabels
            label.delete(lbl)
            new_lbl := label.new(time, lvl, txt,
                 color=color.new(clr, 100), textcolor=clr,
                 style=label.style_label_left, size=size.normal, yloc=yloc.price,
                 xloc=xloc.bar_time)
    else
        line.delete(ln)
        label.delete(lbl)
    [new_ln, new_lbl]

[ln18_,   lbl18_]   = f_updateLine(ln18,   lbl18,   showLevel1, level18,   t18,   color1, "18:00", width18,  style18)
[ln830_,  lbl830_]  = f_updateLine(ln830,  lbl830,  showLevel2, level830,  t830,  color2, "8:30", width830, style830)
[ln930_,  lbl930_]  = f_updateLine(ln930,  lbl930,  showLevel3, level930,  t930,  color3, "9:30", width930, style930)
[ln1000_, lbl1000_] = f_updateLine(ln1000, lbl1000, showLevel4, level1000, t1000, color4, "10:00", width1000, style1000)

ln18    := ln18_
lbl18   := lbl18_
ln830   := ln830_
lbl830  := lbl830_
ln930   := ln930_
lbl930  := lbl930_
ln1000  := ln1000_
lbl1000 := lbl1000_
