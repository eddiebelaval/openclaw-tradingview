//@version=6
indicator("Market Structure & Trend Strength PRO [LuxAlgo]", shorttitle="LuxMS_TS_PRO", overlay=true, max_boxes_count=500, max_labels_count=500)

// --- Inputs ---
grp_struct = "Structure & BOS"
pivotLenInput      = input.int(5, "Pivot Lookback", minval=1, group=grp_struct)
showStructureInput = input.bool(true, "Show HH/HL/LH/LL Labels", group=grp_struct)
showBOSInput       = input.bool(true, "Show Break of Structure (BOS)", group=grp_struct)
bosColorInput      = input.color(color.black, "BOS Line Color", group=grp_struct)
snappyEntries      = input.bool(true, "Snappy Entries (Responsive)", group=grp_struct, tooltip="If on, signals fire on the first color change after FVG touch. If off, they wait for a previous candle break.")

grp_fvg = "FVG Settings"
fvgColorBullInput  = input.color(color.new(#089981, 90), "Bullish FVG Color", group=grp_fvg)
fvgColorBearInput  = input.color(color.new(#f23645, 90), "Bearish FVG Color", group=grp_fvg)
fvgMitigationInput = input.bool(true, "Remove Mitigated FVGs", group=grp_fvg)

grp_mtf_fvg = "MTF FVGs (Toggle Visibility)"
showFVG5m  = input.bool(false, "Show 5m FVGs", group=grp_mtf_fvg)
showFVG15m = input.bool(false, "Show 15m FVGs", group=grp_mtf_fvg)
showFVG1h  = input.bool(false, "Show 1h FVGs", group=grp_mtf_fvg)
showFVG4h  = input.bool(false, "Show 4h FVGs", group=grp_mtf_fvg)

grp_tf = "Trend Strength Meter (Dashboard)"
use1m  = input.bool(true, "1m", group=grp_tf, inline="1")
use5m  = input.bool(true, "5m", group=grp_tf, inline="1")
use15m = input.bool(true, "15m", group=grp_tf, inline="1")
use1h  = input.bool(false, "1h", group=grp_tf, inline="2")
use4h  = input.bool(false, "4h", group=grp_tf, inline="2")
use1d  = input.bool(false, "1d", group=grp_tf, inline="2")

grp_dash = "Dashboard Style"
dashPosXInput    = input.string("Right", "Position X", options=["Left", "Right", "Center"], group=grp_dash)
dashPosYInput    = input.string("Top", "Position Y", options=["Top", "Bottom", "Middle"], group=grp_dash)
dashBgColorInput = input.color(color.new(#1e222d, 0), "Table Background", group=grp_dash)
dashTextColor    = input.color(color.white, "Text Color", group=grp_dash)
dashBorderColor  = input.color(color.gray, "Border Color", group=grp_dash)

// --- Constants ---
BULL_COLOR = #089981
BEAR_COLOR = #f23645

// --- Types ---
type FVG
    box   id
    float top
    float bottom
    bool  isBull
    bool  mitigated

type TrendData
    float f
    float m
    float s
    float r
    float a
    float dp
    float dm

// --- Global FVG State ---
var FVG[] fvgArray = array.new<FVG>()

// --- Market Structure ---
var float lastPH = na
var float lastPL = na
var int lastPHBar = 0
var int lastPLBar = 0

ph = ta.pivothigh(high, pivotLenInput, pivotLenInput)
pl = ta.pivotlow(low, pivotLenInput, pivotLenInput)

if not na(ph)
    if showStructureInput
        label.new(bar_index - pivotLenInput, ph, ph > lastPH ? "HH" : "LH", style=label.style_label_down, color=color.new(chart.fg_color, 100), textcolor=chart.fg_color, size=size.small)
    lastPH := ph
    lastPHBar := bar_index - pivotLenInput
if not na(pl)
    if showStructureInput
        label.new(bar_index - pivotLenInput, pl, pl < lastPL ? "LL" : "HL", style=label.style_label_up, color=color.new(chart.fg_color, 100), textcolor=chart.fg_color, size=size.small)
    lastPL := pl
    lastPLBar := bar_index - pivotLenInput

// --- Break of Structure (BOS) ---
var bool waitingForBullRetrace = false
var bool waitingForBearRetrace = false
var bool bullTouchedFVG = false
var bool bearTouchedFVG = false

if close > lastPH and not na(lastPH)
    waitingForBullRetrace := true
    waitingForBearRetrace := false
    bullTouchedFVG := false
    if showBOSInput
        line.new(lastPHBar, lastPH, bar_index, lastPH, color=bosColorInput, style=line.style_dashed)
        label.new(bar_index, lastPH, "BOS", style=label.style_none, textcolor=bosColorInput, size=size.small)
    lastPH := na 
else if close < lastPL and not na(lastPL)
    waitingForBearRetrace := true
    waitingForBullRetrace := false
    bearTouchedFVG := false
    if showBOSInput
        line.new(lastPLBar, lastPL, bar_index, lastPL, color=bosColorInput, style=line.style_dashed)
        label.new(bar_index, lastPL, "BOS", style=label.style_none, textcolor=bosColorInput, size=size.small)
    lastPL := na

// --- FVG Detection ---
isBullFVG = low[0] > high[2]
isBearFVG = high[0] < low[2]

if isBullFVG
    boxId = box.new(bar_index - 2, low[0], bar_index, high[2], border_color=na, bgcolor=fvgColorBullInput)
    array.push(fvgArray, FVG.new(boxId, low[0], high[2], true, false))
if isBearFVG
    boxId = box.new(bar_index - 2, low[2], bar_index, high[0], border_color=na, bgcolor=fvgColorBearInput)
    array.push(fvgArray, FVG.new(boxId, low[2], high[0], false, false))

// --- Entry Logic (Responsive) ---
bool bullEntry = false
bool bearEntry = false

if waitingForBullRetrace
    if not bullTouchedFVG and array.size(fvgArray) > 0
        for i = 0 to array.size(fvgArray) - 1
            fvgObj = array.get(fvgArray, i)
            if fvgObj.isBull and not fvgObj.mitigated and low <= fvgObj.top and high >= fvgObj.bottom
                bullTouchedFVG := true
                break
    conf = snappyEntries ? (close > open) : (close > open and close > high[1])
    if bullTouchedFVG and conf
        bullEntry := true
        waitingForBullRetrace := false
        bullTouchedFVG := false

if waitingForBearRetrace
    if not bearTouchedFVG and array.size(fvgArray) > 0
        for i = 0 to array.size(fvgArray) - 1
            fvgObj = array.get(fvgArray, i)
            if not fvgObj.isBull and not fvgObj.mitigated and high >= fvgObj.bottom and low <= fvgObj.top
                bearTouchedFVG := true
                break
    conf = snappyEntries ? (close < open) : (close < open and close < low[1])
    if bearTouchedFVG and conf
        bearEntry := true
        waitingForBearRetrace := false
        bearTouchedFVG := false

plotshape(bullEntry, "Bullish Entry", shape.triangleup, location.belowbar, color=BULL_COLOR, size=size.small)
plotshape(bearEntry, "Bearish Entry", shape.triangledown, location.abovebar, color=BEAR_COLOR, size=size.small)

// --- Mitigation & Extension ---
if array.size(fvgArray) > 0
    for i = array.size(fvgArray) - 1 to 0
        fvgObj = array.get(fvgArray, i)
        if not fvgObj.mitigated
            box.set_right(fvgObj.id, bar_index)
            if (fvgObj.isBull and low < fvgObj.bottom) or (not fvgObj.isBull and high > fvgObj.top)
                fvgObj.mitigated := true
                if fvgMitigationInput
                    box.delete(fvgObj.id)
                array.remove(fvgArray, i)

// --- MTF FVG Visualization ---
draw_mtf_fvg(string tf, color bullCol, color bearCol) =>
    [mL, mH2, mH, mL2, mT] = request.security(syminfo.tickerid, tf, [low[0], high[2], high[0], low[2], time[2]])
    var box bB = na
    var box bS = na
    if mL > mH2
        box.delete(bB)
        bB := box.new(mT, mL, time, mH2, xloc=xloc.bar_time, border_color=na, bgcolor=bullCol)
    if mH < mL2
        box.delete(bS)
        bS := box.new(mT, mL2, time, mH, xloc=xloc.bar_time, border_color=na, bgcolor=bearCol)

if showFVG5m
    draw_mtf_fvg("5", color.new(BULL_COLOR, 85), color.new(BEAR_COLOR, 85))
if showFVG15m
    draw_mtf_fvg("15", color.new(BULL_COLOR, 85), color.new(BEAR_COLOR, 85))
if showFVG1h
    draw_mtf_fvg("60", color.new(BULL_COLOR, 85), color.new(BEAR_COLOR, 85))
if showFVG4h
    draw_mtf_fvg("240", color.new(BULL_COLOR, 85), color.new(BEAR_COLOR, 85))

// --- Trend Strength Meter ---
get_metrics() =>
    [dp, dm, a] = ta.dmi(14, 14)
    TrendData.new(ta.ema(close, 20), ta.ema(close, 50), ta.ema(close, 200), ta.rsi(close, 14), a, dp, dm)

calc_tf_score(TrendData td) =>
    float s = 0.0
    s += (td.f > td.m and td.m > td.s) or (td.f < td.m and td.m < td.s) ? 30.0 : (td.f > td.m or td.f < td.m ? 15.0 : 0.0)
    s += math.abs(td.r - 50.0) / 50.0 * 25.0
    s += math.min(td.a / 50.0 * 25.0, 25.0)
    s += (td.dp > td.dm and td.f > td.m) or (td.dm > td.dp and td.f < td.m) ? 20.0 : 0.0
    s

float totalScore = 0.0
int activeTfs = 0
f_proc(bool u, string t) => u ? request.security(syminfo.tickerid, t, get_metrics()) : na

d1m = f_proc(use1m, "1"), d5m = f_proc(use5m, "5"), d15m = f_proc(use15m, "15")
d1h = f_proc(use1h, "60"), d4h = f_proc(use4h, "240"), d1d = f_proc(use1d, "1D")

if not na(d1m)
    totalScore += calc_tf_score(d1m)
    activeTfs += 1
if not na(d5m)
    totalScore += calc_tf_score(d5m)
    activeTfs += 1
if not na(d15m)
    totalScore += calc_tf_score(d15m)
    activeTfs += 1
if not na(d1h)
    totalScore += calc_tf_score(d1h)
    activeTfs += 1
if not na(d4h)
    totalScore += calc_tf_score(d4h)
    activeTfs += 1
if not na(d1d)
    totalScore += calc_tf_score(d1d)
    activeTfs += 1

finalScore = activeTfs > 0 ? math.round(totalScore / activeTfs) : 0

// --- Dashboard ---
tablePos = switch
    dashPosYInput == "Top"    and dashPosXInput == "Left"   => position.top_left
    dashPosYInput == "Top"    and dashPosXInput == "Center" => position.top_center
    dashPosYInput == "Top"    and dashPosXInput == "Right"  => position.top_right
    dashPosYInput == "Bottom" and dashPosXInput == "Left"   => position.bottom_left
    dashPosYInput == "Bottom" and dashPosXInput == "Center" => position.bottom_center
    dashPosYInput == "Bottom" and dashPosXInput == "Right"  => position.bottom_right
    dashPosYInput == "Middle" and dashPosXInput == "Left"   => position.middle_left
    dashPosYInput == "Middle" and dashPosXInput == "Center" => position.middle_center
    dashPosYInput == "Middle" and dashPosXInput == "Right"  => position.middle_right
    => position.top_right

var table dashTable = table.new(tablePos, 2, 2, frame_color=dashBorderColor, frame_width=1, border_color=dashBorderColor, border_width=1)
if barstate.islast
    color scoreColor = finalScore > 75 ? BULL_COLOR : finalScore > 40 ? color.orange : BEAR_COLOR
    table.cell(dashTable, 0, 0, "Aggregate Strength", bgcolor=dashBgColorInput, text_color=dashTextColor)
    table.cell(dashTable, 1, 0, str.tostring(finalScore) + "/100", bgcolor=scoreColor, text_color=color.white)
    table.cell(dashTable, 0, 1, "Active TFs", bgcolor=dashBgColorInput, text_color=dashTextColor)
    table.cell(dashTable, 1, 1, str.tostring(activeTfs), bgcolor=dashBgColorInput, text_color=dashTextColor)
