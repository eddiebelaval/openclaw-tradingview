//@version=6
indicator("Future Roll Monitor", overlay = false)

////////////
// INPUTS /{

// Table Position 
tablePos = input.string('Middle Right', 'Table Location  ‏ ‏', ['Top Right', 'Middle Right', 'Bottom Right', 'Top Center', 'Middle Center', 'Bottom Center', 'Top Left', 'Middle Left', 'Bottom Left'], group = 'Table Setting')

// Table Size
tableSiz = input.string('Small', 'Table Size    ‏ ‏', ['Auto', 'Huge', 'Large', 'Normal', 'Small', 'Tiny'], group = 'Table Setting')


use_current_root = input.bool(true, title = "Use Current Product Root?")
exchange    = input.string("", title = "Future Exchange", tooltip = 'Keep empty if there is no ambiguity if roots')

future_root = input.string('VX', title = 'Future Product Root')

future_offset = input.int(0, title = "Futures Offset")

//} 

///////////////
// FUNCTIONS /{

major_roots  = array.from("SI")
major_months = array.from("HKNUZ")

fut_month_codes = array.from('F', 'G', 'H', 'J', 'K', 'M', 'N', 'Q', 'U', 'V', 'X', 'Z')

product_root = use_current_root ? syminfo.root : future_root

major_ind = major_roots.indexof(product_root) 

cur_fut_subs = major_ind >= 0 ? major_months.get(major_ind) : 'FGHJKMNQUVXZ'

date_format(d) =>
    str.format_time(math.round(d), "dd.MM.yyyy")

locNsze(x) =>
    y = str.split(str.lower(x), ' ')
    out = ''
    for i = 0 to array.size(y) - 1 by 1
        out := out + array.get(y, i)
        if i != array.size(y) - 1
            out := out + '_'
            out
    out

// Get only symbol
only_symbol(s) =>
    array.get(str.split(s, ':'), 1)

gen_futures(future_numbers) => 
    cur_year  = year(timenow)
    cur_month = month(timenow)

    exch_string = exchange != '' ?  exchange + ":": ""

    month_code = exch_string + product_root + fut_month_codes.get(cur_month - 1) + str.tostring(cur_year)

    //log.info(month_code)

    code_arr = array.new_string(1, month_code)

    // ES Hack
    if str.upper(product_root) == 'ES' and cur_month % 3 != 0 
        code_arr := array.new_string()

    for i = 0 to future_numbers-2 

        cur_month += 1
        cur_year  := cur_month == 13 ? cur_year + 1 : cur_year
        cur_month := cur_month == 13 ?            1 : cur_month

        // Hack for ES Futures
        if str.upper(product_root) == 'ES' and cur_month % 3 != 0
            continue

        if not str.contains(cur_fut_subs, fut_month_codes.get(cur_month - 1))
            continue

        month_code := exch_string + product_root + fut_month_codes.get(cur_month - 1) + str.tostring(cur_year)

        code_arr.push(month_code)

    code_arr

//}

//////////////////
// CALCULATIONS /{

symbols = gen_futures(10)

prices        = array.new_float(0)
volume_array  = array.new_float(0)
oi_array      = array.new_float(0)
expir_dates   = array.new_int(0)
dte_array     = array.new_float(0)

price_symbols = array.new_string(0)


for s in symbols.slice(future_offset, future_offset + 2) 
    [price, vol, exp_date] = request.security(s, 'D', [close, volume, syminfo.expiration_date], 
    ignore_invalid_symbol = true, lookahead = barmerge.lookahead_on)
    oi = request.security(str.format('{0}_OI', s), 'D', close, ignore_invalid_symbol = true)

    time_to_exp = exp_date - timenow
    days_to_exp = time_to_exp / 1000 / 60 / 60 / 24

    if not na(price)
        prices.push(price) 
        volume_array.push(vol) 
        price_symbols.push(s)
        oi_array.push(oi)
        expir_dates.push(exp_date)
        dte_array.push(days_to_exp)


//}

//////////////
// PLOTTING /{

c_header_bg = #1F3D2B
c_header_tx = #7CFFB2

c_data_bg = #1A1A1A
c_data_tx = #E6E6E6

c_data_bg_sec = #222222

c_dir_cont_bg  = #1F3D2B
c_dir_cont_tx  = #7CFFB2

c_dir_backw_bg =  #3A1F1F
c_dir_backw_tx =  #FF7C7C


var tbl = table.new(locNsze(tablePos), 8, 12, frame_color = #151715, frame_width = 0, border_width = 2, border_color = color.new(color.white, 100))

if barstate.islast and prices.size() >= 2
    table.clear(tbl, 0, 0, 6, 11)

    table.cell(tbl, 0, 0, 'SYMBOL', text_halign = text.align_center, bgcolor = c_header_bg, text_color = c_header_tx, text_size = size.small)
    table.cell(tbl, 1, 0, 'EXPIRY', text_halign = text.align_center, bgcolor = c_header_bg, text_color = c_header_tx, text_size = size.small)
    table.cell(tbl, 2, 0, 'DTE',    text_halign = text.align_center, bgcolor = c_header_bg, text_color = c_header_tx, text_size = size.small)
    table.cell(tbl, 3, 0, 'LAST',   text_halign = text.align_center, bgcolor = c_header_bg, text_color = c_header_tx, text_size = size.small)
    table.cell(tbl, 4, 0, 'VOL',    text_halign = text.align_center, bgcolor = c_header_bg, text_color = c_header_tx, text_size = size.small)
    table.cell(tbl, 5, 0, 'OI',     text_halign = text.align_center, bgcolor = c_header_bg, text_color = c_header_tx, text_size = size.small)
 
    if price_symbols.size() > 0
        for i = 0 to price_symbols.size() - 1 by 1

            table.cell(tbl, 0, i + 1, array.get(price_symbols, i),                   text_halign = text.align_left,   bgcolor = c_data_bg, text_color = c_data_tx, text_size = size.small)
            table.cell(tbl, 1, i + 1, date_format(expir_dates.get(i)),               text_halign = text.align_center, bgcolor = c_data_bg, text_color = c_data_tx, text_size = size.small)
            table.cell(tbl, 2, i + 1, str.tostring(math.round(dte_array.get(i), 2)), text_halign = text.align_center, bgcolor = c_data_bg, text_color = c_data_tx, text_size = size.small)
            table.cell(tbl, 3, i + 1, str.tostring(prices.get(i)),                   text_halign = text.align_center, bgcolor = c_data_bg, text_color = c_data_tx, text_size = size.small)
            table.cell(tbl, 4, i + 1, str.tostring(volume_array.get(i)),             text_halign = text.align_center, bgcolor = c_data_bg, text_color = c_data_tx, text_size = size.small)
            table.cell(tbl, 5, i + 1, str.tostring(oi_array.get(i)),                 text_halign = text.align_center, bgcolor = c_data_bg, text_color = c_data_tx, text_size = size.small)
          
    roll_cost      = prices.get(1) - prices.get(0)
    roll_cost_perc = math.round((prices.get(1) / prices.get(0) - 1) * 100, 2)

    roll_cost_str  = str.tostring(roll_cost) + " (" + str.tostring(roll_cost_perc) + "%)"

    volume_ratio = math.round(volume_array.get(1) / (volume_array.get(0) + volume_array.get(1)) * 100, 2)
    oi_ratio     = math.round(oi_array.get(1)     / (oi_array.get(0) + oi_array.get(1)) * 100, 2)
    
    volume_ratio_tooltip = "% of Volume on the second futures from the first 2 futures. "
    oi_ratio_tooltip     = "% of Open Interest on the second futures from the first 2 futures. "

    curve_dir       = prices.get(1) < prices.get(0) ? 'Bacwardation' : 'Contango'
    curve_dir_cl_bg = prices.get(1) < prices.get(0) ? c_dir_backw_bg : c_dir_cont_bg
    curve_dir_cl_tx = prices.get(1) < prices.get(0) ? c_dir_backw_tx : c_dir_cont_tx

    table.cell(tbl, 2, 3, 'Curve Direction', text_halign = text.align_center, bgcolor = c_header_bg, text_color = c_header_tx, text_size = size.small)
    table.cell(tbl, 3, 3, 'Roll Cost',       text_halign = text.align_center, bgcolor = c_header_bg, text_color = c_header_tx, text_size = size.small)
    table.cell(tbl, 4, 3, 'Volume Ratio',    text_halign = text.align_center, bgcolor = c_header_bg, text_color = c_header_tx, text_size = size.small, tooltip = volume_ratio_tooltip)
    table.cell(tbl, 5, 3, 'OI Ratio',        text_halign = text.align_center, bgcolor = c_header_bg, text_color = c_header_tx, text_size = size.small, tooltip = oi_ratio_tooltip)
    
    table.cell(tbl, 2, 4, curve_dir,                         text_halign = text.align_center, bgcolor = curve_dir_cl_bg, text_color = curve_dir_cl_tx, text_size = size.small)
    table.cell(tbl, 3, 4, roll_cost_str,                     text_halign = text.align_center, bgcolor = c_data_bg_sec, text_color = c_data_tx, text_size = size.small)
    table.cell(tbl, 4, 4, str.tostring(volume_ratio)  + "%", text_halign = text.align_center, bgcolor = c_data_bg_sec, text_color = c_data_tx, text_size = size.small, tooltip = volume_ratio_tooltip)
    table.cell(tbl, 5, 4, str.tostring(oi_ratio) + "%",      text_halign = text.align_center, bgcolor = c_data_bg_sec, text_color = c_data_tx, text_size = size.small, tooltip = oi_ratio_tooltip)
          

//}
