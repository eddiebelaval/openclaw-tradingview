//@version=6
indicator("Trend Road Map", overlay=true, max_labels_count=500)

// PARAMETERS
lenMA = input.int(80, 'MA Length')
maType = input.string("HMA", "Base MA Type", options=["SMA","EMA","WMA","HMA"])
atrLength = input.int(200, 'ATR Length')
mult = input.float(1.8,'Minimum Deviation (ATR)')
smoothType = input.string('EMA', 'MA Smoothing Type', options=['EMA','RMA','WMA','SMA'])
smoothLen = input.int(100, 'Smoothing Length')
trendBandMult = input.float(1.0, 'Road Width (ATR Mult)')
bg_transp = input.int(50, "Road Background Transparency", minval=0, maxval=100)
bullBaseColor = input.color(#746e6e, "Bull Channel Color (Base)")
bearBaseColor = input.color(#282828, "Bear Channel Color (Base)")
edgeColor = input.color(color.yellow, "Edge Lines Color")
edgeWidth = input.int(3, "Edge Lines Width", minval=1, maxval=5)
bullSignalColor = input.color(#36ff47, "Bull Signal Color")
bearSignalColor = input.color(color.rgb(255, 112, 107), "Bear Signal Color")
showHeatmap = input.bool(true,"Display Distance Heatmap")
heatMaxATR = input.float(10.0, "Max ATR Distance for Heatmap")
cells = input.int(50, "Heatmap Cells", minval=5, maxval=50)

// HEATMAP COLORS 
colorLevel1 = input.color(color.rgb(204, 255, 224), "Clear Road")
colorLevel2 = input.color(color.green, "Normal Range")
colorLevel3 = input.color(color.rgb(248, 229, 55), "Warning Zone")
colorLevel4 = input.color(color.rgb(255, 7, 7),"Danger Zone")

// TREND CANDLE COLORS 
showTrendCandles = input.bool(true, "Color Candles by Trend")
bullCandleColor = input.color(color.new(#ffffff, 0), "Bull Candle Color")
bearCandleColor = input.color(color.new(#282828, 0), "Bear Candle Color")

// FUNCTIONS 
maFunc(src, len) =>
    switch maType
        "EMA" => ta.ema(src, len)
        "WMA" => ta.wma(src, len)
        "HMA" => ta.hma(src, len)
        => ta.sma(src, len)

lerp(a, b, t) => a + (b - a) * t

colorLerp(c1, c2, t) =>
    r = math.round(lerp(color.r(c1), color.r(c2), t))
    g = math.round(lerp(color.g(c1), color.g(c2), t))
    b = math.round(lerp(color.b(c1), color.b(c2), t))
    color.rgb(r, g, b)

gradColor(v, maxV) =>
    pct = math.min(math.abs(v)/maxV,1)
    if pct < 0.33
        colorLerp(colorLevel1, colorLevel2, pct/0.33)
    else if pct < 0.66
        colorLerp(colorLevel2, colorLevel3, (pct-0.33)/0.33)
    else
        colorLerp(colorLevel3, colorLevel4, (pct-0.66)/0.34)

// CHANNEL LOGIC
baseMA = maFunc(close, lenMA)
atr = ta.atr(atrLength)
deviation = math.abs(close - baseMA)
valid = deviation > atr * mult
var float filteredMA = na
filteredMA := valid ? maFunc(close, lenMA) : nz(filteredMA[1], baseMA)
smoothedMA = switch smoothType
    "EMA" => ta.ema(filteredMA, smoothLen)
    "RMA" => ta.rma(filteredMA, smoothLen)
    "WMA" => ta.wma(filteredMA, smoothLen)
    => ta.sma(filteredMA, smoothLen)

roadOffset = atr * trendBandMult
roadUp = smoothedMA + roadOffset
roadLow = smoothedMA - roadOffset
var int regime = 0
if close > roadUp
    regime := 1
else if close < roadLow
    regime := -1
else
    regime := nz(regime[1], 0)

// CALCULATE CANDLE COLOR 
var color candleColor = na
candleColor := showTrendCandles ? (close > roadUp ? bullCandleColor : close < roadLow ? bearCandleColor : na) : na

// APPLY CANDLE COLOR 
barcolor(candleColor)

// DRAWING THE CHANNEL
pUp = plot(roadUp, color=edgeColor, linewidth=edgeWidth, title="Upper Edge")
pLow = plot(roadLow, color=edgeColor, linewidth=edgeWidth, title="Lower Edge")
fill(pUp, pLow, color = regime == 1 ? color.new(bullBaseColor, bg_transp) : color.new(bearBaseColor, bg_transp), title="Road Fill")
plot(smoothedMA, color=color.white, linewidth=1, style=plot.style_circles, title="Smoothed MA")

// SIGNALS 
bullSignal = regime == 1 and nz(regime[1],0) != 1
bearSignal = regime == -1 and nz(regime[1],0) != -1
plotshape(bullSignal, title="Bull Entry", style=shape.circle, location=location.belowbar, color=bullSignalColor, size=size.small)
plotshape(bearSignal, title="Bear Entry", style=shape.circle, location=location.abovebar, color=bearSignalColor, size=size.small)

// RE-ENTRY / TRAFFIC LIGHT 
reEntry = close < roadUp and close > roadLow and (close[1] > roadUp or close[1] < roadLow)
if reEntry
    label.new(bar_index, high, "🚦", style=label.style_none, size=size.huge)

// HEATMAP ON THE RIGHT 
barOffset = 3
var line[] heatLines = array.new_line()
var float currentDist = na
var float maxDist = na
var float step = na
var float maxV = na

if showHeatmap
    currentDist := math.abs(close - smoothedMA)
    maxDist := math.max(heatMaxATR * atr, currentDist)
    step := (maxDist * 2) / cells
    maxV := heatMaxATR * atr
    for i = 0 to cells - 1
        yPerc = -maxDist + i * step
        col = gradColor(yPerc, maxV)
        y = smoothedMA + yPerc
        if array.size(heatLines) < cells
            array.push(heatLines, line.new(bar_index + barOffset, y, bar_index + barOffset, y + step, xloc=xloc.bar_index, extend=extend.none, color=col, width=10))
        else
            ln = array.get(heatLines, i)
            line.set_xy1(ln, bar_index + barOffset, y)
            line.set_xy2(ln, bar_index + barOffset, y + step)
            line.set_color(ln, col)

// RIGHT LABEL (Dynamic Text Color) 
var label infoLabel = na
if showHeatmap and barstate.islast
    pct = currentDist / maxV
    zoneColor = gradColor(currentDist, maxV)

    string shortName = ""
    if pct <= 0.2
        shortName := "Clear Road"
    else if pct <= 0.5
        shortName := "Normal Range"
    else if pct <= 0.8
        shortName := "Warning Zone"
    else
        shortName := "Danger Zone"

    string txt = shortName
    int label_x = bar_index + barOffset + 1

    brightness = (color.r(zoneColor) * 0.299 + color.g(zoneColor) * 0.587 + color.b(zoneColor) * 0.114) / 255
    textColor = brightness > 0.6 ? color.black : color.white

    if na(infoLabel)
        infoLabel := label.new(
            x = label_x,
            y = close,
            text = txt,
            xloc = xloc.bar_index,
            yloc = yloc.price,
            color = color.new(zoneColor, 30),
            textcolor = textColor,
            style = label.style_label_left,
            size = size.normal,
            textalign = text.align_left
        )
    else
        label.set_xy(infoLabel, label_x, close)
        label.set_text(infoLabel, txt)
        label.set_color(infoLabel, color.new(zoneColor, 30))
        label.set_textcolor(infoLabel, textColor)

// ALERTS 
alertcondition(bullSignal, title="Bull Entry Alert", message="Bullish signal detected!")
alertcondition(bearSignal, title="Bear Entry Alert", message="Bearish signal detected!")
alertcondition(reEntry, title="Re-Entry Alert", message="Price re-entered the road channel!")
