//@version=5
indicator("Support & Resistance + Fibonacci Retracement", overlay=true, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════
// GROUP DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════
grpGenel  = "General Settings"
grpFib    = "Fibonacci Levels"
grpLabels = "Label & Appearance"

// ═══════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════
lookback  = input.int(21, "Lookback Period", minval=20, group=grpGenel, tooltip="Number of bars used to detect the highest high and lowest low for support and resistance.")
showLines = input.bool(true, "Show Lines", group=grpGenel, tooltip="Toggle the display of support, resistance and Fibonacci lines on the chart.")
tfInput   = input.timeframe("", "Timeframe", group=grpGenel, tooltip="Select the timeframe to calculate support and resistance from. Leave empty to use the current chart timeframe.")

showFib   = input.bool(true, "Show Fibonacci", group=grpFib, tooltip="Toggle Fibonacci retracement levels drawn between the detected support and resistance.")
showLevels= input.bool(true, "Show Level Names", group=grpLabels, tooltip="Show or hide level name labels such as 'Resistance', 'Support' and Fibonacci ratios.")
showPrices= input.bool(true, "Show Prices", group=grpLabels, tooltip="Show or hide the price value next to each level label.")
labelCol  = input.color(#000000, "Text Color", group=grpLabels, tooltip="Text color used for all Fibonacci level labels.")
textSize  = input.string(size.normal, "Text Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=grpLabels, tooltip="Controls the font size for all labels on the chart.")

// Level Settings (Color and On/Off)
f1_on = input.bool(true, "0.236", inline="f1", group=grpFib, tooltip="Enable or disable the 0.236 Fibonacci retracement level.")
f1_cl = input.color(color.new(#9e9e9e, 0), "", inline="f1", group=grpFib)

f2_on = input.bool(true, "0.382", inline="f2", group=grpFib, tooltip="Enable or disable the 0.382 Fibonacci retracement level.")
f2_cl = input.color(color.new(#9e9e9e, 0), "", inline="f2", group=grpFib)

f5_on = input.bool(true, "0.500", inline="f5", group=grpFib, tooltip="Enable or disable the 0.500 midpoint Fibonacci level.")
f5_cl = input.color(color.new(#9e9e9e, 0), "", inline="f5", group=grpFib)

f3_on = input.bool(true, "0.618", inline="f3", group=grpFib, tooltip="Enable or disable the 0.618 golden ratio Fibonacci level, calculated upward from support to resistance.")
f3_cl = input.color(color.new(#9E9E9E, 0), "", inline="f3", group=grpFib)

f4_on = input.bool(true, "0.786", inline="f4", group=grpFib, tooltip="Enable or disable the 0.786 Fibonacci retracement level.")
f4_cl = input.color(color.new(#9E9E9E, 0), "", inline="f4", group=grpFib)

// ═══════════════════════════════════════════════════════════════════════
// CALCULATION & DRAWING
// ═══════════════════════════════════════════════════════════════════════
h = request.security(syminfo.tickerid, tfInput == "" ? timeframe.period : tfInput, ta.highest(high, lookback))
l = request.security(syminfo.tickerid, tfInput == "" ? timeframe.period : tfInput, ta.lowest(low,  lookback))
r = h - l

// Arrays to store drawing IDs
var lines  = array.new_line()
var labels = array.new_label()

if barstate.islast
    // Clear old drawings
    if array.size(lines) > 0
        for i = 0 to array.size(lines) - 1
            line.delete(array.get(lines, i))
        array.clear(lines)
    
    if array.size(labels) > 0
        for i = 0 to array.size(labels) - 1
            label.delete(array.get(labels, i))
        array.clear(labels)

    if showLines
        int lp = bar_index + 2
        
        // 1. Main Support and Resistance
        array.push(lines,  line.new(bar_index - lookback, h, bar_index, h, color=color.new(#ef5350, 30), width=2, extend=extend.right))
        array.push(lines,  line.new(bar_index - lookback, l, bar_index, l, color=color.new(#26a69a, 30), width=2, extend=extend.right))
        
        string resT = (showLevels ? "Resistance " : "") + (showPrices ? "(" + str.tostring(h, format.mintick) + ")" : "")
        string supT = (showLevels ? "Support " : "") + (showPrices ? "(" + str.tostring(l, format.mintick) + ")" : "")
        
        // Support and Resistance labels
        array.push(labels, label.new(lp, h, resT, textcolor=#ef5350, style=label.style_label_lower_left, color=#00000000, size=textSize))
        array.push(labels, label.new(lp, l, supT, textcolor=#26a69a, style=label.style_label_upper_left, color=#00000000, size=textSize))

        // 2. Fibonacci Simplified Loop (From Support to Resistance)
        if showFib
            levels = array.from(0.236, 0.382, 0.500, 0.618, 0.786)
            colors = array.from(f1_cl, f2_cl, f5_cl, f3_cl, f4_cl)
            active = array.from(f1_on, f2_on, f5_on, f3_on, f4_on)

            for i = 0 to array.size(levels) - 1
                if array.get(active, i)
                    // CALCULATION: l + (r * ratio) -> Upward from support
                    float v = l + (r * array.get(levels, i))
                    string t = (showLevels ? str.tostring(array.get(levels, i)) + " " : "") + (showPrices ? "(" + str.tostring(v, format.mintick) + ")" : "")
                    
                    array.push(lines,  line.new(bar_index - lookback, v, bar_index, v, color=array.get(colors, i), style=line.style_dotted, extend=extend.right))
                    array.push(labels, label.new(lp, v, t, textcolor=labelCol, style=label.style_label_left, color=#00000000, size=textSize))

// ═══════════════════════════════════════════════════════════════════════
// ALERT SYSTEM (via alert() Function)
// ═══════════════════════════════════════════════════════════════════════
f_0236 = l + (r * 0.236)
f_0618 = l + (r * 0.618)

cUp   = ta.crossover(close, f_0236)
cDown = ta.crossunder(close, f_0618)

string alert_m = cUp   ? "Price crossed ABOVE the 0.236 level!" : 
                 cDown  ? "Price crossed BELOW the 0.618 level!" : ""

if (cUp or cDown)
    alert(alert_m, alert.freq_once_per_bar)
