//@version=5
// 【訊號版】Nana SUPERTREND 拉回加碼策略 — 適用各種標的；僅顯示買入/加碼/賣訊/停損，不下單
// English: Nana SuperTrend Pullback Add-on Strategy
indicator("Nana SuperTrend Pullback Add-on Strategy", shorttitle="Nana ST Pullback Add", overlay=true, scale=scale.right, max_lines_count=500)

// ========== 參數 ==========
group_st = "Nana SuperTrend（減少假訊號：週期/倍率調大）"
st_atr_len = input.int(14, "ATR 週期", minval=1, group=group_st)
st_factor = input.float(3.5, "倍率 (Factor)", minval=0.1, step=0.1, group=group_st)

group_rsi = "Nana RSI 過濾（避免超買時進場）"
use_rsi = input.bool(true, "啟用 RSI 過濾", group=group_rsi)
rsi_len = input.int(14, "RSI 週期", minval=1, group=group_rsi)
rsi_max_buy = input.int(70, "買進時 RSI 上限（低於此值才買）", minval=50, maxval=90, group=group_rsi)
rsi_max_add = input.int(75, "加倉時 RSI 上限", minval=50, maxval=90, group=group_rsi)

group_add = "Nana 拉回加倉（用 SuperTrend10 判斷拉回，較易觸發加碼）"
st_add_len = input.int(10, "加碼用 SuperTrend ATR 週期（10=較敏感，易有加碼機會）", minval=1, group=group_add)
st_add_factor = input.float(2.5, "加碼用 SuperTrend 倍率（2.5=與內建 SuperTrend 10 一致）", minval=0.1, step=0.1, group=group_add)
pullback_tol = input.float(0.002, "拉回容差 (0.002=0.2%)", minval=0.0, step=0.001, group=group_add)
allow_add = input.bool(true, "允許拉回加倉", group=group_add)

group_stop = "Nana 停損（訊號版為模擬）"
stop_pct = input.float(7, "總部位虧損達 (%) 則停損", minval=1, maxval=50, step=0.5, group=group_stop)
use_stop = input.bool(true, "顯示停損訊號", group=group_stop)

group_bg = "圖表顯示（樣式）"
use_bg_zones = input.bool(true, "顯示買賣區域背景", group=group_bg)
// UpTrend Highlighter（多頭區域，雙色交替）
color_uptrend_0 = input.color(color.new(color.green, 92), "UpTrend Highlighter ─ 顏色0", group=group_bg)
color_uptrend_1 = input.color(color.new(color.green, 88), "UpTrend Highlighter ─ 顏色1", group=group_bg)
// DownTrend Highlighter（空頭區域，雙色交替）
color_downtrend_0 = input.color(color.new(color.red, 92), "DownTrend Highlighter ─ 顏色0", group=group_bg)
color_downtrend_1 = input.color(color.new(color.red, 88), "DownTrend Highlighter ─ 顏色1", group=group_bg)
// 加碼用 SuperTrend 10：顏色與線條樣式
color_st10_line = input.color(color.new(color.blue, 30), "加碼用 SuperTrend 10 顏色", group=group_bg)
style_st10_str = input.string("虛線 (Dashed)", "加碼用 SuperTrend 10 線條樣式", options=["實線 (Solid)", "虛線 (Dashed)", "點線 (Dotted)"], group=group_bg)
style_st10 = style_st10_str == "實線 (Solid)" ? line.style_solid : style_st10_str == "虛線 (Dashed)" ? line.style_dashed : line.style_dotted

// ========== Nana SuperTrend（買賣訊用）==========
[st_line, st_dir] = ta.supertrend(st_factor, st_atr_len)
buy_signal_raw = st_dir == -1 and st_dir[1] == 1
sell_signal = st_dir == 1 and st_dir[1] == -1
in_uptrend = st_dir == -1

// ========== Nana 加碼用 SuperTrend10（拉回判斷用；倍率 2.5 與內建「超級趨勢 10 hl2 2.5」一致）==========
[st_add_line, st_add_dir] = ta.supertrend(st_add_factor, st_add_len)
lower_edge_add = st_add_line
touched_lower = low <= lower_edge_add * (1 + pullback_tol)

// RSI 過濾
rsi_val = ta.rsi(close, rsi_len)
rsi_ok_buy = not use_rsi or rsi_val < rsi_max_buy
rsi_ok_add = not use_rsi or rsi_val < rsi_max_add
buy_signal = buy_signal_raw and rsi_ok_buy

// 訊號版：模擬是否持倉、是否已加倉（無實際下單）
var bool in_long = false
var bool added_second = false
var float sim_entry = na
if buy_signal
    in_long := true
    added_second := false
    sim_entry := close
if sell_signal
    in_long := false
    sim_entry := na

// 拉回加倉條件（持倉中 + 未加過 + 觸及下緣 + RSI）
can_add = in_long and in_uptrend and allow_add and not added_second and touched_lower and not buy_signal and rsi_ok_add
if can_add
    added_second := true
    sim_entry := nz(sim_entry) != 0 ? (nz(sim_entry) + close) / 2 : close

// 模擬停損：持倉且虧損達 N%
loss_pct = sim_entry > 0 ? (sim_entry - close) / sim_entry * 100.0 : 0.0
stop_loss_trigger = use_stop and in_long and loss_pct >= stop_pct
if stop_loss_trigger
    in_long := false
    added_second := false
    sim_entry := na

// ========== 圖表 ==========
// Nana SuperTrend 14：粗體實線（買賣訊用）
plot(st_line, "Nana SuperTrend 14 買賣", color=in_uptrend ? color.new(color.green, 0) : color.new(color.red, 0), linewidth=3)

// Nana SuperTrend 10：粗體虛線（加碼用）。多頭時為「下緣支撐」故在價格下方屬正常，僅在多頭時繪製
var array<line> st10_lines = array.new_line(0)
if allow_add and in_uptrend and bar_index > 0 and not na(st_add_line[1]) and not na(st_add_line)
    new_line = line.new(bar_index[1], st_add_line[1], bar_index, st_add_line, color=color_st10_line, width=3, style=style_st10)
    array.push(st10_lines, new_line)
    if array.size(st10_lines) > 490
        line.delete(array.shift(st10_lines))

// 買訊
plotshape(buy_signal, "買入 33%", shape.triangleup, location.belowbar, color.green, size=size.normal)
if buy_signal
    label.new(bar_index, low * 0.8, "買入 33%", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.normal, yloc=yloc.price)

// 拉回加倉
plotshape(can_add, "加碼 66%", shape.triangleup, location.belowbar, color.lime, size=size.normal)
if can_add
    label.new(bar_index, low * 0.8, "加碼 66%", style=label.style_label_up, color=color.lime, textcolor=color.black, size=size.normal, yloc=yloc.price)

// 賣訊平倉、停損
plotshape(sell_signal, "賣訊平倉", shape.triangledown, location.abovebar, color.red, size=size.normal, text="賣訊平倉")
plotshape(stop_loss_trigger, "停損", shape.triangledown, location.abovebar, color.purple, size=size.normal)
if stop_loss_trigger
    label.new(bar_index, high * 1.2, "停損 " + str.tostring(loss_pct, "#.#") + "%", style=label.style_label_down, color=color.purple, textcolor=color.white, size=size.normal, yloc=yloc.price)

// UpTrend / DownTrend Highlighter（Color 0 與 Color 1 依 K 棒交替，可於「圖表顯示」自訂或關閉）
bgcolor(use_bg_zones ? (in_uptrend ? (bar_index % 2 == 0 ? color_uptrend_0 : color_uptrend_1) : (bar_index % 2 == 0 ? color_downtrend_0 : color_downtrend_1)) : na)
