//@version=6
indicator("AA Smart Structure Engine", overlay=true, max_labels_count=500)

//========================
// INPUTS
//========================
pivotLen = input.int(4, "Pivot Length")
atrLen = input.int(7, "ATR")
impulseFactor = input.float(1.0, "Impulse Strength")

// 👉 NOVO — BOJE
buyColor  = input.color(color.rgb(0, 0, 0), "BUY Label Color")
sellColor = input.color(color.rgb(167, 163, 163), "SELL Label Color")
textColor = input.color(color.white, "Text Color")

//========================
// CORE
//========================
atr = ta.atr(atrLen)

//========================
// STRUCTURE
//========================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

//========================
// STORAGE
//========================
var float lastHigh = na
var float prevHigh = na
var float lastLow  = na
var float prevLow  = na
var int   lastSignal = 0

//========================
// 🔥 RESET WHEN INPUT CHANGES
//========================
pivotChanged = pivotLen != pivotLen[1]

if pivotChanged
    lastHigh := na
    prevHigh := na
    lastLow  := na
    prevLow  := na
    lastSignal := 0

//========================
// UPDATE STRUCTURE
//========================
if not na(ph)
    prevHigh := lastHigh
    lastHigh := ph

if not na(pl)
    prevLow := lastLow
    lastLow := pl

//========================
// IMPULSE
//========================
body = math.abs(close - open)
candleRange = high - low

bullImpulse = close > open and body > candleRange * 0.5 and body > atr * impulseFactor
bearImpulse = close < open and body > candleRange * 0.5 and body > atr * impulseFactor

//========================
// STRUCTURE TYPES
//========================
isHH = not na(prevHigh) and lastHigh > prevHigh
isLH = not na(prevHigh) and lastHigh < prevHigh

isLL = not na(prevLow) and lastLow < prevLow
isHL = not na(prevLow) and lastLow > prevLow

//========================
// ENTRY LOGIC
//========================
sellHH = isHH and close < open and bearImpulse
sellLH = isLH and close < open and bearImpulse

buyLL = isLL and close > open and bullImpulse
buyHL = isHL and close > open and bullImpulse

//========================
// NO DUPLICATE SIGNALS
//========================
buySignal  = (buyLL or buyHL) and lastSignal != 1 and barstate.isconfirmed
sellSignal = (sellHH or sellLH) and lastSignal != -1 and barstate.isconfirmed

if buySignal
    lastSignal := 1

if sellSignal
    lastSignal := -1

//========================
// LABELS
//========================
if buySignal
    label.new(bar_index, low, "BUY",
        style=label.style_label_up,
        color=buyColor,
        textcolor=textColor)

if sellSignal
    label.new(bar_index, high, "SELL",
        style=label.style_label_down,
        color=sellColor,
        textcolor=textColor)
