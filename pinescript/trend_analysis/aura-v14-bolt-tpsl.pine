//@version=5
indicator("Aura V14 Bolt - Sync Edition", shorttitle="Aura_Bolt_Sync", overlay=true, max_labels_count=100, max_lines_count=100)

// --- 1. ΕΙΣΟΔΟΙ (INPUTS) ---
atr_p = input.int(1, "ATR Period") 
atr_m = input.float(5.0, "Multiplier")
alpha_p = input.int(14, "Alpha Period")
alpha_m = input.float(1.0, "Alpha Multiplier")
magic_p = input.int(20, "Magic Period")

// --- 2. ΛΟΓΙΚΗ TREND (ALPHA & MAGIC) ---
[plus, minus, adx] = ta.dmi(14, 14)
at_atr = ta.sma(ta.tr, alpha_p)
alpha_up = low - (at_atr * alpha_m)
alpha_dn = high + (at_atr * alpha_m)
var float alpha_line = 0.0
alpha_line := ta.mfi(close, alpha_p) >= 50 ? (alpha_up < nz(alpha_line[1]) ? nz(alpha_line[1]) : alpha_up) : (alpha_dn > nz(alpha_line[1]) ? nz(alpha_line[1]) : alpha_dn)

magic_cci = ta.cci(close, magic_p)
magic_bull = magic_cci > 0

// UT BOT LOGIC
atr_v = ta.atr(atr_p)
x_atr = atr_v * atr_m
var float n_loss = close 
prev_l = nz(n_loss[1], close)
if close > prev_l and close[1] > prev_l
    n_loss := math.max(prev_l, close - x_atr)
else if close < prev_l and close[1] < prev_l
    n_loss := math.min(prev_l, close + x_atr)
else if close > prev_l
    n_loss := close - x_atr
else
    n_loss := close + x_atr

// --- 3. ΣΥΓΧΡΟΝΙΣΜΕΝΗ ΤΑΣΗ (BACKGROUND & SIGNALS) ---
// Η τάση αλλάζει βάσει του Aura Consensus
vol_ok = volume > ta.sma(volume, 20)
is_bull = magic_bull and close > n_loss and close > alpha_line
is_bear = not magic_bull and close < n_loss and close < alpha_line

var int trend = 0
if is_bull
    trend := 1
else if is_bear
    trend := -1

// Σήματα ακριβώς στην αλλαγή του Trend (Background)
trend_changed_to_bull = trend == 1 and trend[1] != 1
trend_changed_to_bear = trend == -1 and trend[1] != -1

// --- 4. ΣΥΣΤΗΜΑ ΓΡΑΜΜΩΝ BOLT (ΜΕ ΠΕΡΙΟΡΙΣΜΟ ΓΙΑ ERROR 59) ---
draw_line(price, txt, col) =>
    if not na(price)
        line.new(bar_index, price, bar_index + 4, price, color=col, style=line.style_dashed, width=1)
        label.new(bar_index + 4, price, txt + ": " + str.tostring(price, "#.##"), style=label.style_none, textcolor=col, size=size.small)

// Εμφάνιση γραμμών μόνο όταν αλλάζει το background
if trend_changed_to_bull
    risk = ta.atr(14) * 1.5
    draw_line(close, "ENTRY", color.blue)
    draw_line(close - risk, "SL", color.red)
    draw_line(close + risk, "TP1", color.green)
    draw_line(close + (risk * 2), "TP2", color.green)
    draw_line(close + (risk * 3), "TP3", color.green)

if trend_changed_to_bear
    risk = ta.atr(14) * 1.5
    draw_line(close, "ENTRY", color.blue)
    draw_line(close + risk, "SL", color.red)
    draw_line(close - risk, "TP1", color.green)
    draw_line(close - (risk * 2), "TP2", color.green)
    draw_line(close - (risk * 3), "TP3", color.green)

// --- 5. VISUALS ---
bgcolor(trend == 1 ? color.new(color.green, 93) : trend == -1 ? color.new(color.red, 93) : na)

plotshape(trend_changed_to_bull, title="BUY", style=shape.labelup, location=location.belowbar, color=color.new(#00ffbb, 0), text="BUY", textcolor=color.white, size=size.small)
plotshape(trend_changed_to_bear, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(#ff0055, 0), text="SELL", textcolor=color.white, size=size.small)

barcolor(trend == 1 ? color.lime : trend == -1 ? color.red : color.gray)
