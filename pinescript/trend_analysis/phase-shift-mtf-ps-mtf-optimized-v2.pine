//@version=5
indicator("Phase Shift MTF [PS-MTF] Optimized_v2", shorttitle="PS-MTF_v2", overlay=true, max_labels_count=500)

// ==========================================
// SECTION 1: Parameters / 入力設定
// ==========================================
int ma_length       = input.int(20, "MA Length / MA 期間", minval=1)
int lookback        = input.int(10, "Lookback for Direction / 向きの判定幅", minval=1)
bool use_30m_for_5m = input.bool(true, "Use 30m as High-TF for 5m / 5分足の上位を30分にする")

group_alert     = "Alert Settings / アラート設定"
bool alert_break = input.bool(true, "Breakout・Breakdown / 上抜け・下抜け", group=group_alert)
bool alert_conv  = input.bool(true, "Convergence / 収束", group=group_alert)
bool alert_diff  = input.bool(true, "Divergence / 拡散", group=group_alert)

group_disp      = "Display Settings / 表示設定"
bool current_only = input.bool(true, "Show Current TF Only / 現在の時間足のみ表示", group=group_disp)
bool showW   = input.bool(false, "Show Weekly / 週足を表示", group=group_disp)
bool showD   = input.bool(false, "Show Daily / 日足を表示", group=group_disp)
bool show240 = input.bool(false, "Show 4H / 4時間足を表示", group=group_disp)
bool show60  = input.bool(false, "Show 1H / 1時間足を表示", group=group_disp)
bool show15  = input.bool(false, "Show 15m / 15分足を表示", group=group_disp)
bool show5   = input.bool(false, "Show 5m / 5分足を表示", group=group_disp)
bool show1   = input.bool(false, "Show 1m / 1分足を表示", group=group_disp)

// ==========================================
// SECTION 2: State Management / 状態保持変数
// ==========================================
var bool has_conv_W = false, var string last_tW = ""
var bool has_conv_D = false, var string last_tD = ""
var bool has_conv_240 = false, var string last_t240 = ""
var bool has_conv_60 = false, var string last_t60 = ""
var bool has_conv_15 = false, var string last_t15 = ""
var bool has_conv_5 = false, var string last_t5 = ""
var bool has_conv_1 = false, var string last_t1 = ""
var bool has_conv_M = false, var string last_tM = ""

// ==========================================
// SECTION 3: Core Logic Function / ロジック関数
// ==========================================
f_get_status(float cur_ma, float hi_ma, float ma_p1, bool has_conv_in) =>
    bool crossed = ta.crossover(cur_ma, hi_ma) or ta.crossunder(cur_ma, hi_ma)
    bool conv    = (cur_ma < hi_ma ? cur_ma > ma_p1 : cur_ma < ma_p1)
    bool next_has_conv = crossed ? false : (has_conv_in or conv)
    string status_txt = conv ? "収束" : (not next_has_conv ? (cur_ma > hi_ma ? "上抜け" : "下抜け") : "拡散")
    color bg_color = conv ? (cur_ma > hi_ma ? color.blue : color.red) : color.white
    color tx_color = conv ? color.white : (cur_ma > hi_ma ? color.blue : color.red)
    [status_txt, bg_color, tx_color, next_has_conv]

// ==========================================
// SECTION 4: Execution / 実行
// ==========================================
sma_src = ta.sma(close, ma_length)
f_sec(tf) => [request.security(syminfo.tickerid, tf, sma_src), request.security(syminfo.tickerid, tf, sma_src[lookback])]

[maW, maW_p]     = f_sec("W")
[maD, maD_p]     = f_sec("D")
[ma240, ma240_p] = f_sec("240")
[ma60, ma60_p]   = f_sec("60")
[ma15, ma15_p]   = f_sec("15")
[ma5, ma5_p]     = f_sec("5")
[ma1, ma1_p]     = f_sec("1")
[maM, maM_p]     = f_sec("M")

ma3M  = request.security(syminfo.tickerid, "3M", sma_src)
ma12M = request.security(syminfo.tickerid, "12M", sma_src)
ma30  = request.security(syminfo.tickerid, "30", sma_src)

h_5 = use_30m_for_5m ? ma30 : ma15

[tW, bW, cW, nW] = f_get_status(maW, maM, maW_p, has_conv_W), has_conv_W := nW
[tD, bD, cD, nD] = f_get_status(maD, maW, maD_p, has_conv_D), has_conv_D := nD
[t240, b240, c240, n240] = f_get_status(ma240, maD, ma240_p, has_conv_240), has_conv_240 := n240
[t60, b60, c60, n60] = f_get_status(ma60, ma240, ma60_p, has_conv_60), has_conv_60 := n60
[t15, b15, c15, n15] = f_get_status(ma15, ma60, ma15_p, has_conv_15), has_conv_15 := n15
[t5, b5, c5, n5] = f_get_status(ma5, h_5, ma5_p, has_conv_5), has_conv_5 := n5
[t1, b1, c1, n1] = f_get_status(ma1, ma5, ma1_p, has_conv_1), has_conv_1 := n1
[tM, bM, cM, nM] = f_get_status(maM, ma3M, maM_p, has_conv_M), has_conv_M := nM

// ==========================================
// SECTION 5: Visualization / 可視化
// ==========================================
string high_tf = switch timeframe.period
    "1"   => "5"
    "5"   => use_30m_for_5m ? "30" : "15"
    "15"  => "60"
    "60"  => "240"
    "240" => "D"
    "D"   => "W"
    "W"   => "M"
    "M"   => "3M"
    "3M"  => "12M"
    => "12M"

string hh_tf = switch timeframe.period
    "1"   => use_30m_for_5m ? "30" : "15"
    "5"   => "60"
    "15"  => "240"
    "60"  => "D"
    "240" => "W"
    "D"   => "M"
    "W"   => "3M"
    "M"   => "12M"
    => "12M"

plot(sma_src, color=color.blue, title="SMA")
plot(request.security(syminfo.tickerid, high_tf, sma_src, gaps=barmerge.gaps_on), color=color.red, title="Higher TF SMA")
plot(request.security(syminfo.tickerid, hh_tf, sma_src, gaps=barmerge.gaps_on), color=color.green, title="HH-MA (Filter)", display=display.none)

int cols = current_only ? 1 : 2
var table m_tab = table.new(position.top_right, cols, 8, border_width=1, border_color=color.gray)

if barstate.islast
    table.clear(m_tab, 0, 0, cols - 1, 7)
    if current_only
        string ct = timeframe.period
        string txt = ct=="W"?tW:ct=="D"?tD:ct=="240"?t240:ct=="60"?t60:ct=="15"?t15:ct=="5"?t5:ct=="1"?t1:ct=="M"?tM:tM
        color bg = ct=="W"?bW:ct=="D"?bD:ct=="240"?b240:ct=="60"?b60:ct=="15"?b15:ct=="5"?b5:ct=="1"?b1:ct=="M"?bM:bM
        color cl = ct=="W"?cW:ct=="D"?cD:ct=="240"?c240:ct=="60"?c60:ct=="15"?c15:ct=="5"?c5:ct=="1"?c1:ct=="M"?cM:cM
        table.cell(m_tab, 0, 0, txt, bgcolor=bg, text_color=cl, width=8, height=8)
    else
        int r = 0
        if showW
            table.cell(m_tab, 0, r, "W", bgcolor=color.white, text_color=color.gray), table.cell(m_tab, 1, r, tW, bgcolor=bW, text_color=cW), r := r + 1
        if showD
            table.cell(m_tab, 0, r, "D", bgcolor=color.white, text_color=color.gray), table.cell(m_tab, 1, r, tD, bgcolor=bD, text_color=cD), r := r + 1
        if show240
            table.cell(m_tab, 0, r, "4H", bgcolor=color.white, text_color=color.gray), table.cell(m_tab, 1, r, t240, bgcolor=b240, text_color=c240), r := r + 1
        if show60
            table.cell(m_tab, 0, r, "1H", bgcolor=color.white, text_color=color.gray), table.cell(m_tab, 1, r, t60, bgcolor=b60, text_color=c60), r := r + 1
        if show15
            table.cell(m_tab, 0, r, "15m", bgcolor=color.white, text_color=color.gray), table.cell(m_tab, 1, r, t15, bgcolor=b15, text_color=c15), r := r + 1
        if show5
            table.cell(m_tab, 0, r, "5m", bgcolor=color.white, text_color=color.gray), table.cell(m_tab, 1, r, t5, bgcolor=b5, text_color=c5), r := r + 1
        if show1
            table.cell(m_tab, 0, r, "1m", bgcolor=color.white, text_color=color.gray), table.cell(m_tab, 1, r, t1, bgcolor=b1, text_color=c1), r := r + 1

// ==========================================
// SECTION 6: Alert Section / アラート設定
// ==========================================
bool filter_direction = input.bool(true, "Filter by Higher-Higher TF / さらに上位足の方向でフィルタリング", group="Alert Settings")
bool use_price_for_filter = input.bool(false, "Use Price vs HH-MA / フィルタにMAではなく価格を使用", group="Alert Settings")

is_alerted = false
f_ps(h_ma, hh_ma) => (use_price_for_filter ? close : h_ma) > hh_ma ? "⇧" : "⇩"

f_alert_exec(tf_str, current_t, last_t, symbol, p_symbol) =>
    bool triggered = false
    if timeframe.period == tf_str and current_t != last_t
        if not filter_direction or (symbol == p_symbol)
            if (current_t == "上抜け" or current_t == "下抜け") ? alert_break : (current_t == "収束" ? alert_conv : alert_diff)
                triggered := true
    triggered

if f_alert_exec("M", tM, last_tM, (maM>ma3M?"⇧":"⇩"), f_ps(ma3M, ma12M))
    alert("【月足】" + (maM>ma3M?"⇧":"⇩") + tM, alert.freq_once_per_bar_close), is_alerted := true
if f_alert_exec("1", t1, last_t1, (ma1>ma5?"⇧":"⇩"), f_ps(ma5, request.security(syminfo.tickerid, use_30m_for_5m?"30":"15", sma_src)))
    alert("【1m】" + (ma1>ma5?"⇧":"⇩") + t1, alert.freq_once_per_bar_close), is_alerted := true
if f_alert_exec("5", t5, last_t5, (ma5>h_5?"⇧":"⇩"), f_ps(h_5, ma60))
    alert("【5m】" + (ma5>h_5?"⇧":"⇩") + t5, alert.freq_once_per_bar_close), is_alerted := true
if f_alert_exec("15", t15, last_t15, (ma15>ma60?"⇧":"⇩"), f_ps(ma60, ma240))
    alert("【15m】" + (ma15>ma60?"⇧":"⇩") + t15, alert.freq_once_per_bar_close), is_alerted := true
if f_alert_exec("60", t60, last_t60, (ma60>ma240?"⇧":"⇩"), f_ps(ma240, maD))
    alert("【1H】" + (ma60>ma240?"⇧":"⇩") + t60, alert.freq_once_per_bar_close), is_alerted := true
if f_alert_exec("240", t240, last_t240, (ma240>maD?"⇧":"⇩"), f_ps(maD, maW))
    alert("【4H】" + (ma240>maD?"⇧":"⇩") + t240, alert.freq_once_per_bar_close), is_alerted := true
if timeframe.isdaily and f_alert_exec(timeframe.period, tD, last_tD, (maD>maW?"⇧":"⇩"), f_ps(maW, maM))
    alert("【日足】" + (maD>maW?"⇧":"⇩") + tD, alert.freq_once_per_bar_close), is_alerted := true
if timeframe.isweekly and f_alert_exec(timeframe.period, tW, last_tW, (maW>maM?"⇧":"⇩"), f_ps(maM, ma3M))
    alert("【週足】" + (maW>maM?"⇧":"⇩") + tW, alert.freq_once_per_bar_close), is_alerted := true

last_t1 := t1, last_t5 := t5, last_t15 := t15, last_t60 := t60, last_t240 := t240, last_tD := tD, last_tW := tW, last_tM := tM

// ==========================================
// SECTION 7: Label Display Section / ラベル表示設定
// ==========================================
bool show_labels = input.bool(true, "Show Alert Labels on Chart / チャート上にラベルを表示", group="Label Settings")
int max_labels   = input.int(50, "Max Labels to Keep / ラベルの最大保持数", minval=1, maxval=500, group="Label Settings")

if show_labels and is_alerted
    cur_s = timeframe.isweekly?tW:timeframe.isdaily?tD:timeframe.period=="240"?t240:timeframe.period=="60"?t60:timeframe.period=="15"?t15:timeframe.period=="5"?t5:timeframe.period=="1"?t1:tM
    c_tx  = timeframe.isweekly?cW:timeframe.isdaily?cD:timeframe.period=="240"?c240:timeframe.period=="60"?c60:timeframe.period=="15"?c15:timeframe.period=="5"?c5:timeframe.period=="1"?c1:cM
    c_bg  = timeframe.isweekly?bW:timeframe.isdaily?bD:timeframe.period=="240"?b240:timeframe.period=="60"?b60:timeframe.period=="15"?b15:timeframe.period=="5"?b5:timeframe.period=="1"?b1:bM
    
    var label_style = label.style_label_down, var label_yloc = yloc.abovebar
    color l_color = (cur_s == "収束") ? color.gray : c_tx
    bool is_bull = (c_tx == color.blue or c_bg == color.blue)

    if cur_s == "収束"
        label_style := is_bull ? label.style_label_down : label.style_label_up
        label_yloc  := is_bull ? yloc.abovebar : yloc.belowbar
    else
        label_style := is_bull ? label.style_label_up : label.style_label_down
        label_yloc  := is_bull ? yloc.belowbar : yloc.abovebar

    lbl = label.new(bar_index, na, "", color=l_color, style=label_style, yloc=label_yloc, size=size.tiny)
    var label_array = array.new_label()
    array.push(label_array, lbl)
    if array.size(label_array) > max_labels
        label.delete(array.shift(label_array))
