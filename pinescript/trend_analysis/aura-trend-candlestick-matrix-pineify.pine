//@version=6
indicator("Aura Trend & Candlestick Matrix [Pineify]", "Aura PAT Matrix", overlay=true, max_labels_count=500, max_lines_count=500)

//---------------------------------------------------------------------------------------------------------------------
// CONSTANTS & INPUTS
//---------------------------------------------------------------------------------------------------------------------
// Standard bullish / bearish palette used throughout the indicator
GREEN = #089981
RED = #F23645

// --- Trend Cloud Settings ---
// The trend cloud is formed by two EMAs; the crossover and relative position determine trend direction
trendGroup = "Trend Cloud Settings"
fastLen = input.int(20, "Fast EMA Length", minval=1, group=trendGroup)       // Shorter period EMA — reacts faster to price changes
slowLen = input.int(50, "Slow EMA Length", minval=1, group=trendGroup)       // Longer period EMA — smooths out noise, acts as trend anchor
colorBars = input.bool(true, "Color Candles Based on Trend", group=trendGroup) // When enabled, candle color reflects the current trend direction

// --- Candlestick Pattern Settings ---
// Toggle visibility for each pattern family; patterns are only shown when aligned with the trend
patGroup = "Candlestick Patterns"
showHams = input.bool(true, "Show Hammers / Shooting Stars", group=patGroup)
showEng = input.bool(true, "Show Engulfing Patterns", group=patGroup)
showStars = input.bool(true, "Show Morning / Evening Stars", group=patGroup)

// --- Support & Resistance Settings ---
// Pivot-based S/R: a pivot is confirmed when it is the highest high (or lowest low) within `pivotLen` bars on each side
srGroup = "Support & Resistance"
pivotLen = input.int(10, "Pivot Detection Length", minval=3, group=srGroup)

//---------------------------------------------------------------------------------------------------------------------
// TREND CLOUD ENGINE
// The "Aura Cloud" is the filled region between the fast and slow EMAs.
// When fast EMA > slow EMA the cloud is green (bullish); otherwise red (bearish).
// This cloud serves as the primary trend filter — candlestick patterns are only
// signaled when they agree with the cloud's direction.
//---------------------------------------------------------------------------------------------------------------------
fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)

// Trend direction: 1 = bullish (fast above slow), -1 = bearish (fast below slow), 0 = neutral (exact cross)
trend = fastEma > slowEma ? 1 : fastEma < slowEma ? -1 : 0

// Adaptive coloring — all visual elements shift between green and red based on trend state
colorFast = trend == 1 ? GREEN : RED
colorSlow = trend == 1 ? color.new(GREEN, 50) : color.new(RED, 50)   // Semi-transparent for visual depth
fillColor = trend == 1 ? color.new(GREEN, 85) : color.new(RED, 85)   // Highly transparent fill between the two EMAs

p1 = plot(fastEma, "Fast Trend Line", color=colorFast, linewidth=2)
p2 = plot(slowEma, "Slow Trend Line", color=colorSlow, linewidth=2)
fill(p1, p2, color=fillColor, title="Aura Cloud")                    // The filled "cloud" area between both EMAs

// Optionally color candles to match the prevailing trend for quick visual scanning
barcolor(colorBars ? (trend == 1 ? GREEN : RED) : na)

//---------------------------------------------------------------------------------------------------------------------
// SUPPORT & RESISTANCE ENGINE
// Detects pivot highs and pivot lows using a symmetric lookback window (`pivotLen` bars on each side).
// The most recently confirmed pivot high becomes the current resistance level; the most recent
// pivot low becomes the current support level. These levels persist until a new pivot replaces them.
//---------------------------------------------------------------------------------------------------------------------
ph = ta.pivothigh(high, pivotLen, pivotLen)   // Non-na only on the bar where a pivot high is confirmed
pl = ta.pivotlow(low, pivotLen, pivotLen)     // Non-na only on the bar where a pivot low is confirmed

// `var` keeps the last known level across bars; updated only when a new pivot is detected
var float resLevel = na
var float supLevel = na

if not na(ph)
    resLevel := ph   // New resistance level confirmed
if not na(pl)
    supLevel := pl   // New support level confirmed

// Plot as circle markers so traders can see the current S/R reference without cluttering the chart
plot(resLevel, "Dynamic Resistance", color=color.new(RED, 40), style=plot.style_circles, linewidth=2)
plot(supLevel, "Dynamic Support", color=color.new(GREEN, 40), style=plot.style_circles, linewidth=2)

//---------------------------------------------------------------------------------------------------------------------
// CANDLESTICK PATTERN DETECTION
// Identifies three classic candlestick pattern families:
//   1) Hammer / Shooting Star   — single-candle reversal signals based on shadow-to-body ratios
//   2) Bullish / Bearish Engulfing — two-candle patterns where the current body fully engulfs the prior body
//   3) Morning Star / Evening Star — three-candle reversal patterns with a small-bodied middle candle
// All patterns are filtered by the Trend Cloud direction (see "Pattern Alignment" below).
//---------------------------------------------------------------------------------------------------------------------

// ── Current candle anatomy ──
rc = close < open  // True when the current candle closed lower than it opened (bearish / red candle)
gc = close > open  // True when the current candle closed higher than it opened (bullish / green candle)

c_top = math.max(open, close)   // Top of the real body (regardless of candle direction)
c_bot = math.min(open, close)   // Bottom of the real body
hl_width = high - low            // Full candle range (high to low)
bod_width = c_top - c_bot        // Real body height

// ── Previous candle (1 bar back) anatomy ──
prev_rc = close[1] < open[1]
prev_gc = close[1] > open[1]
prev_c_top = math.max(open[1], close[1])
prev_c_bot = math.min(open[1], close[1])
prev_bod_width = prev_c_top - prev_c_bot

// ── Shadow & body ratios (as fractions of the full candle range) ──
hw_per = hl_width > 0 ? ((high - c_top) / hl_width) : 0   // Upper shadow proportion
lw_per = hl_width > 0 ? ((c_bot - low) / hl_width) : 0    // Lower shadow proportion
b_per = hl_width > 0 ? (bod_width / hl_width) : 0          // Body proportion

// Doji filter: body < 10% of the full range — excluded from hammer/shooting star detection to avoid ambiguity
doji = bod_width < (hl_width * 0.1)

// ── 1. Hammer & Shooting Star ──
// Hammer: long lower shadow (≥ 2× body), small body (< 50% of range), minimal upper shadow, bullish close
// Shooting Star: mirror image — long upper shadow, small body, minimal lower shadow, bearish close
hammer = lw_per > (b_per * 2) and b_per < 0.5 and hw_per < 0.15 and not doji and gc
sstar = hw_per > (b_per * 2) and b_per < 0.5 and lw_per < 0.15 and not doji and rc

// ── 2. Engulfing Patterns ──
// Bullish Engulfing: prior candle is bearish, current is bullish, and current body is ≥ 120% of prior body
//                    with current body fully wrapping the prior body (c_bot < prev_c_bot AND c_top > prev_c_top)
// Bearish Engulfing: exact opposite
bull_engulfing = prev_rc and gc and bod_width > (prev_bod_width * 1.2) and c_bot < prev_c_bot and c_top > prev_c_top
bear_engulfing = prev_gc and rc and bod_width > (prev_bod_width * 1.2) and c_top > prev_c_top and c_bot < prev_c_bot

// ── 3. Morning Star & Evening Star (3-candle patterns) ──
// Candle 2 bars ago anatomy
prev2_rc = close[2] < open[2]
prev2_gc = close[2] > open[2]
prev2_c_top = math.max(open[2], close[2])
prev2_c_bot = math.min(open[2], close[2])
prev2_bod_width = prev2_c_top - prev2_c_bot

// Morning Star: bar[2] bearish → bar[1] small body (< 50% of bar[2]) → bar[0] bullish closing above bar[2] midpoint
// Evening Star: bar[2] bullish → bar[1] small body → bar[0] bearish closing below bar[2] midpoint
morning_star = prev2_rc and gc and bod_width < (prev_bod_width * 0.5) and c_top > prev2_c_top and close > (prev2_c_top + prev2_c_bot) / 2
evening_star = prev2_gc and rc and bod_width < (prev_bod_width * 0.5) and c_bot < prev2_c_bot and close < (prev2_c_top + prev2_c_bot) / 2

// ── Pattern Alignment ──
// Only display bullish patterns when the Trend Cloud is bullish (trend == 1),
// and bearish patterns when the cloud is bearish (trend == -1).
// This confluence filter reduces noise by discarding counter-trend signals.
valid_hammer = showHams and hammer and trend == 1
valid_sstar = showHams and sstar and trend == -1

valid_bull_eng = showEng and bull_engulfing and trend == 1
valid_bear_eng = showEng and bear_engulfing and trend == -1

valid_m_star = showStars and morning_star and trend == 1
valid_e_star = showStars and evening_star and trend == -1

//---------------------------------------------------------------------------------------------------------------------
// PLOTTING SIGNALS
// Each pattern family uses a distinct shape so traders can identify the pattern type at a glance:
//   • Engulfing  → triangle (▲ / ▼)
//   • Hammer / Shooting Star → small label with "H" / "S"
//   • Morning / Evening Star  → small label with "MS" / "ES"
// Bullish signals appear below the bar; bearish signals appear above.
//---------------------------------------------------------------------------------------------------------------------
plotshape(valid_bull_eng, title="Bullish Engulfing", style=shape.triangleup, location=location.belowbar, color=GREEN, size=size.small)
plotshape(valid_bear_eng, title="Bearish Engulfing", style=shape.triangledown, location=location.abovebar, color=RED, size=size.small)

plotshape(valid_hammer, title="Hammer", style=shape.labelup, location=location.belowbar, color=GREEN, text="H", textcolor=color.white, size=size.tiny)
plotshape(valid_sstar, title="Shooting Star", style=shape.labeldown, location=location.abovebar, color=RED, text="S", textcolor=color.white, size=size.tiny)

plotshape(valid_m_star, title="Morning Star", style=shape.labelup, location=location.belowbar, color=color.new(GREEN, 20), text="MS", textcolor=color.white, size=size.tiny)
plotshape(valid_e_star, title="Evening Star", style=shape.labeldown, location=location.abovebar, color=color.new(RED, 20), text="ES", textcolor=color.white, size=size.tiny)

//---------------------------------------------------------------------------------------------------------------------
// ALERTS
// Two composite alert conditions — one for any bullish pattern, one for any bearish pattern.
// Traders can attach these to TradingView's alert system for real-time notifications.
//---------------------------------------------------------------------------------------------------------------------
alertcondition(valid_bull_eng or valid_hammer or valid_m_star, title="Bullish Setup", message="Aura Matrix: Bullish Pattern detected aligned with the Trend Cloud!")
alertcondition(valid_bear_eng or valid_sstar or valid_e_star, title="Bearish Setup", message="Aura Matrix: Bearish Pattern detected aligned with the Trend Cloud!")
