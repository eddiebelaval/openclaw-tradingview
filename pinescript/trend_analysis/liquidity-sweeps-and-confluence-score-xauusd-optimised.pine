// LS · Confluence Score  v2.1
// Sweep detection core © LuxAlgo (CC BY-NC-SA 4.0)
// https://creativecommons.org/licenses/by-nc-sa/4.0/
// Confluence Score, Session H/L, Fib + Session Sweep layer — added for personal/educational use

//@version=5
indicator('Liquidity Sweeps · Confluence Score v2', 'LS·Score v2', true,
          max_lines_count  = 500,
          max_boxes_count  = 500,
          max_labels_count = 300)

// ═══════════════════════════════════════════════════════════════════════════
// 1 · SWEEP DETECTION  (оригинален LuxAlgo)
// ═══════════════════════════════════════════════════════════════════════════
term   = input.string('Long Term', 'Detection',
         options = ['Short Term', 'Intermediate Term', 'Long Term'],
         display = display.all - display.status_line)

colBl  = input.color(#089981,   'Bullish Level', inline = 'c1', group = 'Style')
colBlS = input.color(#08998180, 'Sweep',         inline = 'c1', group = 'Style')
colBr  = input.color(#f23645,   'Bearish Level', inline = 'c2', group = 'Style')
colBrS = input.color(#f2364580, 'Sweep',         inline = 'c2', group = 'Style')

// ═══════════════════════════════════════════════════════════════════════════
// 2 · CONFLUENCE SCORE
// ═══════════════════════════════════════════════════════════════════════════
G = 'Confluence Score'

use_htf = input.bool(true, 'HTF EMA Bias  (+2т)',    group = G)
htf_tf  = input.timeframe('60', 'HTF Таймфрейм',     group = G)
ema_f   = input.int(50,  'EMA Fast', minval = 1,     group = G, inline = 'ema')
ema_s   = input.int(200, '/ Slow',   minval = 1,     group = G, inline = 'ema')

use_adx = input.bool(true, 'ADX Strength  (+1/+2т)', group = G)
adx_len = input.int(14, 'ADX Length', minval = 1,    group = G, inline = 'adx')
adx_mid = input.int(20, 'Mid',        minval = 1,    group = G, inline = 'adx')
adx_hi  = input.int(30, '/ High',     minval = 1,    group = G, inline = 'adx')

use_kz  = input.bool(true, 'Kill Zone  (+1т)', group = G)
kz_lon  = '0700-1000:1234567'
kz_ny   = '1300-1600:1234567'

use_rsi = input.bool(true, 'RSI Extreme  (+1т)',     group = G)
rsi_len = input.int(14, 'RSI Length',  minval = 1,  group = G, inline = 'rsi')
rsi_os  = input.int(35, 'Oversold',    minval = 1,  group = G, inline = 'rsi')
rsi_ob  = input.int(65, '/ Overbought', minval = 1, group = G, inline = 'rsi')

// ═══════════════════════════════════════════════════════════════════════════
// 3 · SESSION H/L CONFLUENCE
// ═══════════════════════════════════════════════════════════════════════════
SG = 'Session H/L Confluence'

use_asia_hl = input.bool(true, 'Asia H/L  (+1т)',   group = SG)
use_ldn_hl  = input.bool(true, 'London H/L  (+1т)', group = SG)
sess_tol    = input.float(0.15, 'Match tolerance (× ATR)',
              minval = 0.05, maxval = 1.0, step = 0.05, group = SG,
              tooltip = 'Колко близо трябва да е swept нивото до session H/L за да брои +1т.\n0.15 ATR ≈ 0.3–0.4 пипа при Gold M5.')

asia_st = input.int(0,  'Asia start (UTC)',       minval = 0, maxval = 23, group = SG, inline = 'as')
asia_en = input.int(9,  '/ end',                  minval = 0, maxval = 23, group = SG, inline = 'as')
ldn_kz_st = input.int(8,  'London KZ start (UTC)', minval = 0, maxval = 23, group = SG, inline = 'ld')
ldn_kz_en = input.int(10, '/ end (excl.)',         minval = 0, maxval = 23, group = SG, inline = 'ld')

use_ss_swp  = input.bool(true, 'Session Sweep сигнали  (M5 само)', group = SG,
              tooltip = 'Засича директен sweep (wick + close rejection) на Asia/London H/L.\nРаботи само на M5 и по-нисък TF.')
ss_col_bull = input.color(color.new(#26c6da, 15), 'Session Bull', inline = 'ssc', group = SG)
ss_col_bear = input.color(color.new(#ff7043, 15), '/ Bear',       inline = 'ssc', group = SG)

// ═══════════════════════════════════════════════════════════════════════════
// 4 · FIB CONFLUENCE
// ═══════════════════════════════════════════════════════════════════════════
FG = 'Fib Confluence'

use_fib       = input.bool(true, 'Fib 0.618 / 0.786  (+1т)', group = FG)
fib_tol       = input.float(0.4, 'Tolerance (× ATR)', minval = 0.1, maxval = 2.0, step = 0.1, group = FG, tooltip = 'Максимален ATR margin между swept ниво и Fib ниво')
show_fib_lvls = input.bool(false, 'Покажи Fib нива на чарта', group = FG)
fib_col       = input.color(color.new(#b39ddb, 50), 'Цвят',   group = FG)

// ═══════════════════════════════════════════════════════════════════════════
// 5 · DISPLAY
// ═══════════════════════════════════════════════════════════════════════════
min_show = input.string('C — всички', 'Покажи от Grade',
           options = ['A — само топ (7+т)', 'B — добри (4+т)', 'C — всички'])
show_tbl = input.bool(true, 'Live Score Table')

// ═══════════════════════════════════════════════════════════════════════════
// 6 · USER DEFINED TYPES  (оригинален LuxAlgo)
// ═══════════════════════════════════════════════════════════════════════════
type piv
    float prc
    int   bix
    bool  mit
    bool  wic
    line  lin

type boxBr
    box bx
    int dr

type swing
    float y = na
    int   x = na

type vector
    array<swing> v

// ═══════════════════════════════════════════════════════════════════════════
// 7 · BASE CALCULATIONS
// ═══════════════════════════════════════════════════════════════════════════
n     = bar_index
atr14 = ta.atr(14)

// HTF EMA
htf_ef   = request.security(syminfo.tickerid, htf_tf,
           ta.ema(close, ema_f), lookahead = barmerge.lookahead_off)
htf_es   = request.security(syminfo.tickerid, htf_tf,
           ta.ema(close, ema_s), lookahead = barmerge.lookahead_off)
htf_bull = not na(htf_ef) and not na(htf_es) and htf_ef > htf_es
htf_bear = not na(htf_ef) and not na(htf_es) and htf_ef < htf_es

// ADX
[_, _, adx_v] = ta.dmi(adx_len, adx_len)

// Kill Zone
in_kz_lon = not na(time(timeframe.period, kz_lon, 'UTC'))
in_kz_ny  = not na(time(timeframe.period, kz_ny,  'UTC'))
in_kz     = in_kz_lon or in_kz_ny

// RSI
rsi_v = ta.rsi(close, rsi_len)

// ─── Session H/L Tracking ─────────────────────────────────────────────────
bar_h = hour(time, 'UTC')
bar_m = minute(time, 'UTC')

in_asia_ses = bar_h >= asia_st and bar_h < asia_en

// London KZ: от ldn_kz_st до ldn_kz_en:30 UTC
// напр. 08:00–10:30 → часове 8 и 9 + час 10 само ако мин < 30
in_ldn_kz = (bar_h >= ldn_kz_st and bar_h < ldn_kz_en) or (bar_h == ldn_kz_en and bar_m < 30)

var float asia_h_cur  = na
var float asia_l_cur  = na
var float asia_h_prev = na
var float asia_l_prev = na
var float ldn_h_cur   = na
var float ldn_l_cur   = na
var float ldn_h_prev  = na
var float ldn_l_prev  = na

// Asia tracking
if in_asia_ses and not in_asia_ses[1]
    asia_h_cur := high
    asia_l_cur := low
if in_asia_ses
    asia_h_cur := math.max(nz(asia_h_cur, high), high)
    asia_l_cur := math.min(nz(asia_l_cur, low),  low)
if not in_asia_ses and in_asia_ses[1]
    asia_h_prev := asia_h_cur
    asia_l_prev := asia_l_cur

// London KZ tracking
if in_ldn_kz and not in_ldn_kz[1]
    ldn_h_cur := high
    ldn_l_cur := low
if in_ldn_kz
    ldn_h_cur := math.max(nz(ldn_h_cur, high), high)
    ldn_l_cur := math.min(nz(ldn_l_cur, low),  low)
if not in_ldn_kz and in_ldn_kz[1]
    ldn_h_prev := ldn_h_cur
    ldn_l_prev := ldn_l_cur

// ─── Session H/L Confluence helpers ──────────────────────────────────────
// Проверява дали swept нивото (level) е директно върху session H/L
// с tight tolerance (default 0.15 × ATR)

f_near(float level, float target, float mult) =>
    not na(target) and math.abs(level - target) <= mult * atr14

f_asia_conf(float level) =>
    use_asia_hl and (f_near(level, asia_h_prev, sess_tol) or f_near(level, asia_l_prev, sess_tol))

f_ldn_conf(float level) =>
    use_ldn_hl and (f_near(level, ldn_h_prev, sess_tol) or f_near(level, ldn_l_prev, sess_tol))

// ─── Fib Levels ───────────────────────────────────────────────────────────
var float sw_h      = na
var float sw_l      = na
var float fib_618_hi = na
var float fib_786_hi = na
var float fib_618_lo = na
var float fib_786_lo = na

f_fib_conf(float level) =>
    if not use_fib or na(fib_618_hi)
        false
    else
        f_near(level, fib_618_hi, fib_tol) or f_near(level, fib_786_hi, fib_tol) or f_near(level, fib_618_lo, fib_tol) or f_near(level, fib_786_lo, fib_tol)

// ═══════════════════════════════════════════════════════════════════════════
// 8 · SCORE / GRADE / LABEL HELPERS
// ═══════════════════════════════════════════════════════════════════════════
// Score 0–9:
//   HTF EMA bias  +2
//   ADX strength  +1 / +2
//   Kill Zone     +1
//   RSI extreme   +1
//   Asia H/L      +1
//   London KZ H/L +1
//   Fib .618/.786 +1

f_score(bool is_bull, float level) =>
    s = 0
    if use_htf
        s += is_bull ? (htf_bull ? 2 : 0) : (htf_bear ? 2 : 0)
    if use_adx
        s += adx_v >= adx_hi ? 2 : adx_v >= adx_mid ? 1 : 0
    if use_kz and in_kz
        s += 1
    if use_rsi
        s += is_bull ? (rsi_v <= rsi_os ? 1 : 0) : (rsi_v >= rsi_ob ? 1 : 0)
    if f_asia_conf(level)
        s += 1
    if f_ldn_conf(level)
        s += 1
    if f_fib_conf(level)
        s += 1
    s

f_grade(int s) =>
    s >= 7 ? 'A' : s >= 4 ? 'B' : 'C'

f_col(int s) =>
    s >= 7 ? color.new(#089981, 0) : s >= 4 ? color.new(#f5a623, 0) : color.new(#e84647, 0)

f_show(int s) =>
    min_show == 'A — само топ (7+т)' ? s >= 7 : min_show == 'B — добри (4+т)'    ? s >= 4 : true

f_lbl_txt(bool is_bull, int s, float level, bool is_sess, string sess_tag) =>
    prefix = is_sess ? (is_bull ? '◈ SESSION BULL' : '◈ SESSION BEAR') :
                       (is_bull ? '▲ BULL SWEEP'   : '▼ BEAR SWEEP')
    tag   = sess_tag != '' ? '  ' + sess_tag : ''
    line1 = prefix + tag + '  [' + f_grade(s) + ']  ' + str.tostring(s) + '/9'

    htf_ok    = use_htf and ((is_bull and htf_bull) or (not is_bull and htf_bear))
    adx_hi_ok = use_adx and adx_v >= adx_hi
    adx_md_ok = use_adx and adx_v >= adx_mid and adx_v < adx_hi
    kz_ok     = use_kz  and in_kz
    rsi_ok    = use_rsi and (is_bull ? rsi_v <= rsi_os : rsi_v >= rsi_ob)
    asia_ok   = f_asia_conf(level)
    ldn_ok    = f_ldn_conf(level)
    fib_ok    = f_fib_conf(level)

    d = ''
    if htf_ok
        d := d + 'HTF+ '
    if adx_hi_ok
        d := d + 'ADX++ '
    else if adx_md_ok
        d := d + 'ADX+ '
    if kz_ok
        d := d + (in_kz_lon ? 'LDN ' : 'NY ')
    if rsi_ok
        d := d + 'RSI+ '
    if asia_ok
        d := d + 'ASIA-HL '
    if ldn_ok
        d := d + 'LDN-HL '
    if fib_ok
        d := d + 'FIB '
    if d == ''
        d := 'No confluence'

    line1 + '\n' + d

// ═══════════════════════════════════════════════════════════════════════════
// 9 · LUALGO SWING DETECTION CORE
// ═══════════════════════════════════════════════════════════════════════════
depth = switch term
    'Short Term'        => 1
    'Intermediate Term' => 2
    'Long Term'         => 3

method l(piv get, color c) =>
    line.new(get.bix, get.prc, n, get.prc, color = c, style = line.style_solid)

method br(piv get, color c, int d) =>
    y1 = d == 1 ? high : get.prc
    y2 = d == 1 ? get.prc : low
    boxBr.new(box.new(n-1, y1, n+1, y2, border_color = color(na), bgcolor = c), d)

method detect(array<vector> id, mode, depth) =>
    var swing sl = swing.new(na, na)
    for i = 0 to depth-1
        gv = id.get(i).v
        if gv.size() == 3
            pivot = switch mode
                'bull' => math.max(gv.get(0).y, gv.get(1).y, gv.get(2).y)
                'bear' => math.min(gv.get(0).y, gv.get(1).y, gv.get(2).y)
            if pivot == gv.get(1).y
                if i < depth-1
                    id.get(i+1).v.unshift(gv.get(1))
                    if id.get(i+1).v.size() > 3
                        id.get(i+1).v.pop()
                else
                    sl := swing.new(gv.get(1).y, gv.get(1).x)
                gv.pop()
                gv.pop()
    sl

var fh = array.new<vector>(0)
var fl = array.new<vector>(0)

if barstate.isfirst
    for i = 0 to depth-1
        fh.push(vector.new(array.new<swing>(0)))
        fl.push(vector.new(array.new<swing>(0)))

fh.get(0).v.unshift(swing.new(high, n))
fl.get(0).v.unshift(swing.new(low,  n))

if fh.get(0).v.size() > 3
    fh.get(0).v.pop()
if fl.get(0).v.size() > 3
    fl.get(0).v.pop()

top = fh.detect('bull', depth)
btm = fl.detect('bear', depth)
ph  = top.y
pl  = btm.y

// Обновяваме swing H/L и Fib нива след swing detection
if ph > 0 and ph != ph[1]
    sw_h := ph
if pl > 0 and pl != pl[1]
    sw_l := pl

if not na(sw_h) and not na(sw_l) and sw_h > sw_l
    rng         = sw_h - sw_l
    fib_618_hi := sw_h - 0.618 * rng
    fib_786_hi := sw_h - 0.786 * rng
    fib_618_lo := sw_l + 0.618 * rng
    fib_786_lo := sw_l + 0.786 * rng

// Fib линии на чарта — изтриваме и рисуваме само при нов swing
var line ln_f1 = na
var line ln_f2 = na
var line ln_f3 = na
var line ln_f4 = na

if show_fib_lvls and not na(fib_618_hi)
    if sw_h != sw_h[1] or sw_l != sw_l[1]
        line.delete(ln_f1)
        line.delete(ln_f2)
        line.delete(ln_f3)
        line.delete(ln_f4)
        ln_f1 := line.new(n, fib_618_hi, n, fib_618_hi,
                 extend = extend.left, color = fib_col, style = line.style_dashed)
        ln_f2 := line.new(n, fib_786_hi, n, fib_786_hi,
                 extend = extend.left, color = fib_col, style = line.style_dashed)
        ln_f3 := line.new(n, fib_618_lo, n, fib_618_lo,
                 extend = extend.left, color = fib_col, style = line.style_dashed)
        ln_f4 := line.new(n, fib_786_lo, n, fib_786_lo,
                 extend = extend.left, color = fib_col, style = line.style_dashed)

// ═══════════════════════════════════════════════════════════════════════════
// 10 · STRUCTURAL SWEEP LOOPS
// ═══════════════════════════════════════════════════════════════════════════
var array<piv>   aPivH  = array.new<piv>(1, piv.new())
var array<piv>   aPivL  = array.new<piv>(1, piv.new())
var array<boxBr> aBoxBr = array.new<boxBr>(1, boxBr.new())

if ph > 0 and ph != ph[1]
    aPivH.unshift(piv.new(ph, top.x, false, false))
if pl > 0 and pl != pl[1]
    aPivL.unshift(piv.new(pl, btm.x, false, false))

var bool bull_a = false
var bool bear_a = false
var bool bull_b = false
var bool bear_b = false
bull_a := false
bear_a := false
bull_b := false
bear_b := false

// Флагове — при structural sweep се задават true на същия бар
// Секция 11 ги проверява и пропуска session label ако structural вече е нарисуван
var bool struct_bull_fired = false
var bool struct_bear_fired = false
struct_bull_fired := false
struct_bear_fired := false

// Bearish structural sweeps
for i = aPivH.size()-1 to 0
    get = aPivH.get(i)
    if not get.mit
        if close > get.prc
            get.mit := true
        if not get.wic
            if high > get.prc and close < get.prc
                sc = f_score(false, get.prc)
                bear_a := bear_a or sc >= 7
                bear_b := bear_b or sc >= 4
                if f_show(sc)
                    label.new(n, high,
                              f_lbl_txt(false, sc, get.prc, false, ''),
                              style     = label.style_label_down,
                              color     = f_col(sc),
                              textcolor = color.white,
                              size      = size.small)
                aBoxBr.unshift(get.br(colBrS, 1))
                get.l(colBr)
                get.wic := true
                struct_bear_fired := true
    if n - get.bix > 2000 or get.mit
        aPivH.remove(i).lin.delete()

// Bullish structural sweeps
for i = aPivL.size()-1 to 0
    get = aPivL.get(i)
    if not get.mit
        if close < get.prc
            get.mit := true
        if not get.wic
            if low < get.prc and close > get.prc
                sc = f_score(true, get.prc)
                bull_a := bull_a or sc >= 7
                bull_b := bull_b or sc >= 4
                if f_show(sc)
                    label.new(n, low,
                              f_lbl_txt(true, sc, get.prc, false, ''),
                              style     = label.style_label_up,
                              color     = f_col(sc),
                              textcolor = color.white,
                              size      = size.small)
                aBoxBr.unshift(get.br(colBlS, -1))
                get.l(colBl)
                get.wic := true
                struct_bull_fired := true
    if n - get.bix > 2000 or get.mit
        aPivL.remove(i).lin.delete()

// ═══════════════════════════════════════════════════════════════════════════
// 11 · SESSION SWEEP СИГНАЛИ  (само M5)
// Засича директен sweep на Asia/London H/L:
//   bearish = wick над нивото + close под него
//   bullish = wick под нивото + close над него
// Всяко ниво се засича само веднъж на сесия
// ═══════════════════════════════════════════════════════════════════════════
var bool ss_bull_a  = false
var bool ss_bear_a  = false
ss_bull_a := false
ss_bear_a := false

var bool ss_a_h_done = false
var bool ss_a_l_done = false
var bool ss_l_h_done = false
var bool ss_l_l_done = false

if in_asia_ses and not in_asia_ses[1]
    ss_a_h_done := false
    ss_a_l_done := false
if in_ldn_kz and not in_ldn_kz[1]
    ss_l_h_done := false
    ss_l_l_done := false

is_m5 = timeframe.isintraday and timeframe.multiplier <= 5

if use_ss_swp
    if is_m5
        if not na(asia_h_prev) and not ss_a_h_done
            if high > asia_h_prev and close < asia_h_prev and not struct_bear_fired
                sc = f_score(false, asia_h_prev)
                ss_bear_a := sc >= 7
                label.new(n, high,
                          f_lbl_txt(false, sc, asia_h_prev, true, 'ASIA-H'),
                          style     = label.style_label_down,
                          color     = ss_col_bear,
                          textcolor = color.white,
                          size      = size.small)
                ss_a_h_done := true

        if not na(asia_l_prev) and not ss_a_l_done
            if low < asia_l_prev and close > asia_l_prev and not struct_bull_fired
                sc = f_score(true, asia_l_prev)
                ss_bull_a := sc >= 7
                label.new(n, low,
                          f_lbl_txt(true, sc, asia_l_prev, true, 'ASIA-L'),
                          style     = label.style_label_up,
                          color     = ss_col_bull,
                          textcolor = color.white,
                          size      = size.small)
                ss_a_l_done := true

        if not na(ldn_h_prev) and not ss_l_h_done
            if high > ldn_h_prev and close < ldn_h_prev and not struct_bear_fired
                sc = f_score(false, ldn_h_prev)
                ss_bear_a := ss_bear_a or sc >= 7
                label.new(n, high,
                          f_lbl_txt(false, sc, ldn_h_prev, true, 'LDN-H'),
                          style     = label.style_label_down,
                          color     = ss_col_bear,
                          textcolor = color.white,
                          size      = size.small)
                ss_l_h_done := true

        if not na(ldn_l_prev) and not ss_l_l_done
            if low < ldn_l_prev and close > ldn_l_prev and not struct_bull_fired
                sc = f_score(true, ldn_l_prev)
                ss_bull_a := ss_bull_a or sc >= 7
                label.new(n, low,
                          f_lbl_txt(true, sc, ldn_l_prev, true, 'LDN-L'),
                          style     = label.style_label_up,
                          color     = ss_col_bull,
                          textcolor = color.white,
                          size      = size.small)
                ss_l_l_done := true

    else if barstate.islast
        var label note = na
        label.delete(note)
        note := label.new(n, high, '⚠ Session Sweeps: само M5',
                 style     = label.style_label_left,
                 color     = color.new(color.gray, 75),
                 textcolor = color.gray,
                 size      = size.tiny)

// ═══════════════════════════════════════════════════════════════════════════
// 12 · LIVE SCORE TABLE
// ═══════════════════════════════════════════════════════════════════════════
if show_tbl
    var table T = table.new(position.top_right, 3, 11,
                  bgcolor      = color.new(color.black, 85),
                  border_width = 1,
                  border_color = color.new(color.gray, 65),
                  frame_width  = 1,
                  frame_color  = color.new(color.gray, 50))

    sc_bull = f_score(true,  close)
    sc_bear = f_score(false, close)

    c_ok  = color.new(#089981, 50)
    c_mid = color.new(#f5a623, 50)
    c_no  = color.new(color.gray, 72)
    c_w   = color.white
    c_g   = color.gray
    c_hdr = color.new(color.black, 70)

    table.cell(T, 0, 0, 'Factor',  text_color = c_g,     text_size = size.small, bgcolor = c_hdr)
    table.cell(T, 1, 0, 'BULL  ▲', text_color = #089981, text_size = size.small, bgcolor = c_hdr)
    table.cell(T, 2, 0, 'BEAR  ▼', text_color = #f23645, text_size = size.small, bgcolor = c_hdr)

    // HTF EMA
    hb = use_htf and htf_bull ? 2 : 0
    hr = use_htf and htf_bear ? 2 : 0
    table.cell(T, 0, 1, 'HTF EMA  +2', text_color = c_g, text_size = size.small)
    table.cell(T, 1, 1, '+' + str.tostring(hb),
               bgcolor = hb > 0 ? c_ok : c_no, text_color = c_w, text_size = size.small)
    table.cell(T, 2, 1, '+' + str.tostring(hr),
               bgcolor = hr > 0 ? c_ok : c_no, text_color = c_w, text_size = size.small)

    // ADX
    ap  = use_adx ? (adx_v >= adx_hi ? 2 : adx_v >= adx_mid ? 1 : 0) : 0
    adt = '+' + str.tostring(ap) + '  (' + str.tostring(math.round(adx_v, 1)) + ')'
    adb = ap == 2 ? c_ok : ap == 1 ? c_mid : c_no
    table.cell(T, 0, 2, 'ADX  +1/+2', text_color = c_g, text_size = size.small)
    table.cell(T, 1, 2, adt, bgcolor = adb, text_color = c_w, text_size = size.small)
    table.cell(T, 2, 2, adt, bgcolor = adb, text_color = c_w, text_size = size.small)

    // Kill Zone
    kp = use_kz and in_kz ? 1 : 0
    kn = in_kz_lon ? 'London KZ' : in_kz_ny ? 'NY KZ' : 'Off-hours'
    table.cell(T, 0, 3, 'Kill Zone  +1', text_color = c_g, text_size = size.small)
    table.cell(T, 1, 3, '+' + str.tostring(kp) + '  ' + kn,
               bgcolor = kp > 0 ? c_ok : c_no, text_color = c_w, text_size = size.small)
    table.cell(T, 2, 3, '+' + str.tostring(kp) + '  ' + kn,
               bgcolor = kp > 0 ? c_ok : c_no, text_color = c_w, text_size = size.small)

    // RSI
    rb = use_rsi and rsi_v <= rsi_os ? 1 : 0
    rr = use_rsi and rsi_v >= rsi_ob ? 1 : 0
    rd = str.tostring(math.round(rsi_v, 1))
    table.cell(T, 0, 4, 'RSI  +1', text_color = c_g, text_size = size.small)
    table.cell(T, 1, 4, '+' + str.tostring(rb) + '  (' + rd + ')',
               bgcolor = rb > 0 ? c_ok : c_no, text_color = c_w, text_size = size.small)
    table.cell(T, 2, 4, '+' + str.tostring(rr) + '  (' + rd + ')',
               bgcolor = rr > 0 ? c_ok : c_no, text_color = c_w, text_size = size.small)

    // Asia H/L
    ab = use_asia_hl and
         (f_near(close, asia_h_prev, sess_tol) or f_near(close, asia_l_prev, sess_tol)) ? 1 : 0
    al = not na(asia_h_prev) ?
         str.tostring(math.round(asia_h_prev, 1)) + ' / ' +
         str.tostring(math.round(asia_l_prev, 1)) : 'n/a'
    table.cell(T, 0, 5, 'Asia H/L  +1', text_color = c_g, text_size = size.small)
    table.cell(T, 1, 5, '+' + str.tostring(ab) + '  ' + al,
               bgcolor = ab > 0 ? c_ok : c_no, text_color = c_w, text_size = size.small)
    table.cell(T, 2, 5, '+' + str.tostring(ab) + '  ' + al,
               bgcolor = ab > 0 ? c_ok : c_no, text_color = c_w, text_size = size.small)

    // London KZ H/L
    lb = use_ldn_hl and
         (f_near(close, ldn_h_prev, sess_tol) or f_near(close, ldn_l_prev, sess_tol)) ? 1 : 0
    ll = not na(ldn_h_prev) ?
         str.tostring(math.round(ldn_h_prev, 1)) + ' / ' +
         str.tostring(math.round(ldn_l_prev, 1)) : 'n/a'
    table.cell(T, 0, 6, 'London KZ H/L  +1', text_color = c_g, text_size = size.small)
    table.cell(T, 1, 6, '+' + str.tostring(lb) + '  ' + ll,
               bgcolor = lb > 0 ? c_ok : c_no, text_color = c_w, text_size = size.small)
    table.cell(T, 2, 6, '+' + str.tostring(lb) + '  ' + ll,
               bgcolor = lb > 0 ? c_ok : c_no, text_color = c_w, text_size = size.small)

    // Fib
    fb  = f_fib_conf(close) ? 1 : 0
    fld = not na(fib_618_hi) ?
          str.tostring(math.round(fib_618_hi, 1)) + ' / ' +
          str.tostring(math.round(fib_786_hi, 1)) : 'n/a'
    table.cell(T, 0, 7, 'Fib .618/.786  +1', text_color = c_g, text_size = size.small)
    table.cell(T, 1, 7, '+' + str.tostring(fb) + '  ' + fld,
               bgcolor = fb > 0 ? c_ok : c_no, text_color = c_w, text_size = size.small)
    table.cell(T, 2, 7, '+' + str.tostring(fb) + '  ' + fld,
               bgcolor = fb > 0 ? c_ok : c_no, text_color = c_w, text_size = size.small)

    // Session Sweep статус
    m5t = is_m5 ? '✓ активен' : '✗ само M5'
    table.cell(T, 0, 8, 'Sess. Sweeps', text_color = c_g, text_size = size.small)
    table.cell(T, 1, 8, m5t, bgcolor = is_m5 ? c_ok : c_no, text_color = c_w, text_size = size.small)
    table.cell(T, 2, 8, m5t, bgcolor = is_m5 ? c_ok : c_no, text_color = c_w, text_size = size.small)

    // Score
    table.cell(T, 0, 9, 'SCORE  /9', text_color = c_g, text_size = size.small)
    table.cell(T, 1, 9, str.tostring(sc_bull) + ' / 9',
               bgcolor = f_col(sc_bull), text_color = c_w, text_size = size.normal)
    table.cell(T, 2, 9, str.tostring(sc_bear) + ' / 9',
               bgcolor = f_col(sc_bear), text_color = c_w, text_size = size.normal)

    // Grade
    table.cell(T, 0, 10, 'GRADE', text_color = c_g, text_size = size.small)
    table.cell(T, 1, 10, f_grade(sc_bull),
               bgcolor = f_col(sc_bull), text_color = c_w, text_size = size.large)
    table.cell(T, 2, 10, f_grade(sc_bear),
               bgcolor = f_col(sc_bear), text_color = c_w, text_size = size.large)

// ═══════════════════════════════════════════════════════════════════════════
// 13 · ALERTS
// ═══════════════════════════════════════════════════════════════════════════
alertcondition(bull_a,
               'BULL Sweep — Grade A',
               'BULL Liquidity Sweep | Grade A | Score 7+/9 | Setup ready!')

alertcondition(bear_a,
               'BEAR Sweep — Grade A',
               'BEAR Liquidity Sweep | Grade A | Score 7+/9 | Setup ready!')

alertcondition(bull_b or bull_a,
               'BULL Sweep — Grade B+',
               'BULL Liquidity Sweep | Grade B+ | Score 4+/9')

alertcondition(bear_b or bear_a,
               'BEAR Sweep — Grade B+',
               'BEAR Liquidity Sweep | Grade B+ | Score 4+/9')

alertcondition(ss_bull_a,
               'SESSION BULL Sweep — Grade A',
               'SESSION BULL Sweep (Asia/London H/L) | Grade A | Score 7+/9')

alertcondition(ss_bear_a,
               'SESSION BEAR Sweep — Grade A',
               'SESSION BEAR Sweep (Asia/London H/L) | Grade A | Score 7+/9')
