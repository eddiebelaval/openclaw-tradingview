//TTK-Zones
//@version=5
indicator("TTK_Zones_With confirmation", overlay=true, max_boxes_count=500)

// --- Paramètres ---
// Options d'activation
afficher_debut = input.bool(true, "Afficher Début d'impulsion", group="Options d'affichage")
afficher_fin   = input.bool(true, "Afficher Fin d'impulsion", group="Options d'affichage")
show_bt        = input.bool(true, "Afficher Big Trades (Whales)", group="Big Trades")
asset_type     = input.string("Automatique", "Type d'actif", options=["Automatique", "Manuel"], group="Big Trades")
custom_bt_mult = input.float(1.0, "Multiplicateur Big Trades (si Manuel)", group="Big Trades")
custom_lookback = input.int(300, "Lookback Big Trades (si Manuel)", group="Big Trades")
trend_filter   = input.bool(false, "Filtrer par tendance (MA)", group="Big Trades")
ma_length      = input.int(200, "Longueur MA Tendance", group="Big Trades")

// Couleurs mises à jour : Début en vert pâle, Fin en rouge pâle
couleur_debut = input.color(color.new(#98fb98, 75), "Couleur Début d'impulsion", group="Couleurs")
couleur_fin   = input.color(color.new(#ff8a8a, 75), "Couleur Fin d'impulsion", group="Couleurs")

couleur_bordure = input.color(color.new(#b2b5be, 50), "Couleur Bordure")
couleur_impulsion = input.color(color.yellow, "Couleur Bougies d'Impulsion")

// --- Couleurs fixes pour les mèches individuelles ---
couleur_meche_h = color.new(#2a2e39, 85)
couleur_meche_b = color.new(#434651, 85)

// --- LOGIQUE BIG TRADES ---
var float final_bt_mult = 3.0
var int final_lookback = 500
ma = ta.sma(close, ma_length)

if asset_type == "Automatique"
    is_btc = str.contains(syminfo.ticker, "BTC")
    is_gold = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")
    is_index = str.contains(syminfo.ticker, "US30") or str.contains(syminfo.ticker, "NAS100")
    if is_index
        final_bt_mult := 3.5
        final_lookback := 100
    else if is_btc
        final_bt_mult := 3.2
        final_lookback := 80
    else if is_gold
        final_bt_mult := 2.0
        final_lookback := 250
else
    final_bt_mult := custom_bt_mult
    final_lookback := custom_lookback

range_size = high - low
raw_buy_vol = range_size == 0 ? 0 : (close - low) / range_size * volume
raw_sell_vol = range_size == 0 ? 0 : (high - close) / range_size * volume
avg_buy_vol = ta.sma(raw_buy_vol, final_lookback)[1]
std_buy_vol = ta.stdev(raw_buy_vol, final_lookback)[1]
avg_sell_vol = ta.sma(raw_sell_vol, final_lookback)[1]
std_sell_vol = ta.stdev(raw_sell_vol, final_lookback)[1]

thresh_buy = avg_buy_vol + std_buy_vol * final_bt_mult
thresh_sell = avg_sell_vol + std_sell_vol * final_bt_mult
is_bt_buy = raw_buy_vol > thresh_buy and (not trend_filter or close > ma)
is_bt_sell = raw_sell_vol > thresh_sell and (not trend_filter or close < ma)

plotshape(show_bt and is_bt_buy ? math.avg(close, low) : na, "Whale Buy", shape.circle, location.absolute, color.new(color.lime, 20), size=size.small)
plotshape(show_bt and is_bt_sell ? math.avg(close, high) : na, "Whale Sell", shape.circle, location.absolute, color.new(color.red, 20), size=size.small)

// --- Gestion des Zones (Persistance) ---
var box[] zones_actives = array.new_box()

// --- Calculs des Imbalances (Fair Value Gaps) ---
est_imb_h = low > high[2] and close[1] > open[1]
est_imb_b = high < low[2] and close[1] < open[1]

succession_h = est_imb_h and est_imb_h[1]
succession_b = est_imb_b and est_imb_b[1]

// --- Détection et Création ---

// 1. MÉTHODE INDIVIDUELLE : Zones sur les mèches
if est_imb_h or est_imb_b
    float corps_bas = math.min(open[1], close[1])
    float meche_bas = low[1]
    color coul_actuelle = est_imb_h ? couleur_meche_h : couleur_meche_b
    
    box b = box.new(bar_index - 1, corps_bas, bar_index, meche_bas, 
         bgcolor=coul_actuelle, 
         border_color=couleur_bordure, 
         border_width=1,
         extend=extend.right)
    array.push(zones_actives, b)

// 2. MÉTHODE DÉBUT D'IMPULSION
if afficher_debut
    if (succession_h and not succession_h[1]) or (succession_b and not succession_b[1])
        int offset_debut = 3 
        box b = box.new(bar_index - offset_debut, high[offset_debut], bar_index, low[offset_debut], 
             bgcolor=couleur_debut, 
             border_color=couleur_bordure, 
             border_width=1,
             text="Début d'impulsion",
             text_color=color.new(color.white, 20),
             text_size=size.small,
             text_halign=text.align_right,
             extend=extend.right)
        array.push(zones_actives, b)

// 3. MÉTHODE FIN D'IMPULSION
if afficher_fin
    bool fin_h = not est_imb_h and succession_h[1]
    bool fin_b = not est_imb_b and succession_b[1]
    
    if fin_h or fin_b
        box b = box.new(bar_index, high, bar_index, low, 
             bgcolor=couleur_fin, 
             border_color=couleur_bordure, 
             border_width=1,
             text="Fin d'impulsion",
             text_color=color.new(color.white, 20),
             text_size=size.small,
             text_halign=text.align_right,
             extend=extend.right)
        array.push(zones_actives, b)

// --- Atténuation ---
if array.size(zones_actives) > 0
    for i = array.size(zones_actives) - 1 to 0
        box b = array.get(zones_actives, i)
        float b_top = box.get_top(b)
        float b_bottom = box.get_bottom(b)
        int b_start = box.get_left(b)
        
        if bar_index > b_start + 1
            if high > b_bottom and low < b_top
                box.set_extend(b, extend.none)
                box.set_right(b, bar_index)
                array.remove(zones_actives, i)

// Coloration des bougies d'imbalance en jaune
barcolor(est_imb_h or est_imb_b ? couleur_impulsion : na, offset=-1)
