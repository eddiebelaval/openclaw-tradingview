//@version=6
indicator("4EMAs, SQZMOM, ADX by PinchePato", shorttitle="4EMAs+SQZ+ADX", overlay=false)

// --- Helper Functions ---
fixnan(x) => 
    var float res = na
    res := na(x) ? res : x

// --- 1. EMAs SECTION ---
emaGroup = "EMAs"
ema1Show  = input.bool(true, "Show EMA 1", group=emaGroup, inline="ema1")
ema1Len   = input.int(20, "Length", minval=1, group=emaGroup, inline="ema1")
ema1Width = input.int(1, "Width", minval=1, maxval=10, group=emaGroup, inline="ema1")
ema1Color = input.color(#089981, "", group=emaGroup, inline="ema1")

ema2Show  = input.bool(true, "Show EMA 2", group=emaGroup, inline="ema2")
ema2Len   = input.int(50, "Length", minval=1, group=emaGroup, inline="ema2")
ema2Width = input.int(1, "Width", minval=1, maxval=10, group=emaGroup, inline="ema2")
ema2Color = input.color(#f23645, "", group=emaGroup, inline="ema2")

ema3Show  = input.bool(true, "Show EMA 3", group=emaGroup, inline="ema3")
ema3Len   = input.int(100, "Length", minval=1, group=emaGroup, inline="ema3")
ema3Width = input.int(1, "Width", minval=1, maxval=10, group=emaGroup, inline="ema3")
ema3Color = input.color(#5b9cf6, "", group=emaGroup, inline="ema3")

ema4Show  = input.bool(true, "Show EMA 4", group=emaGroup, inline="ema4")
ema4Len   = input.int(200, "Length", minval=1, group=emaGroup, inline="ema4")
ema4Width = input.int(1, "Width", minval=1, maxval=10, group=emaGroup, inline="ema4")
ema4Color = input.color(#ff9800, "", group=emaGroup, inline="ema4")

ema1Val = ta.ema(close, ema1Len)
ema2Val = ta.ema(close, ema2Len)
ema3Val = ta.ema(close, ema3Len)
ema4Val = ta.ema(close, ema4Len)

plot(ema1Val, "EMA 1", color=ema1Color, linewidth=ema1Width, display=ema1Show ? display.all : display.none, force_overlay=true)
plot(ema2Val, "EMA 2", color=ema2Color, linewidth=ema2Width, display=ema2Show ? display.all : display.none, force_overlay=true)
plot(ema3Val, "EMA 3", color=ema3Color, linewidth=ema3Width, display=ema3Show ? display.all : display.none, force_overlay=true)
plot(ema4Val, "EMA 4", color=ema4Color, linewidth=ema4Width, display=ema4Show ? display.all : display.none, force_overlay=true)

// --- 2. SQUEEZE MOMENTUM SECTION ---
sqzGroup = "Squeeze Momentum"
length = input.int(20, "BB Length", group=sqzGroup)
mult = input.float(2.0, "BB MultFactor", group=sqzGroup)
lengthKC = input.int(20, "KC Length", group=sqzGroup)
multKC = input.float(1.5, "KC MultFactor", group=sqzGroup)
useTrueRange = input.bool(true, "Use TrueRange (KC)", group=sqzGroup)

// Squeeze Scaling & Visuals
sqzHeightPct = input.float(25.0, "Height %", minval=1.0, maxval=100.0, step=1.0, group=sqzGroup, inline="sqz_vis")
sqzPosPct    = input.float(15.0, "Center %", minval=0.0, maxval=100.0, step=1.0, group=sqzGroup, inline="sqz_vis")
sqzFillStyle = input.string("Gradient", "Fill Style", options=["Gradient", "Solid"], group=sqzGroup)
sqzLineWidth = input.int(3, "Column Width", minval=1, maxval=10, group=sqzGroup)

// Squeeze Colors
sqzUpColor   = input.color(#00ff00, "Bullish High", group=sqzGroup, inline="sqz_col")
sqzUpLow     = input.color(#006400, "Bullish Low", group=sqzGroup, inline="sqz_col")
sqzDnColor   = input.color(#ff0000, "Bearish High", group=sqzGroup, inline="sqz_col2")
sqzDnLow     = input.color(#8b0000, "Bearish Low", group=sqzGroup, inline="sqz_col2")

// Calculate SQZ
basis = ta.sma(close, length)
dev = mult * ta.stdev(close, length)
upperBB = basis + dev
lowerBB = basis - dev
ma = ta.sma(close, lengthKC)
range_sqz = useTrueRange ? ta.tr : (high - low)
rangema = ta.sma(range_sqz, lengthKC)
upperKC = ma + rangema * multKC
lowerKC = ma - rangema * multKC

sqzOn  = (lowerBB > lowerKC) and (upperBB < upperKC)
sqzOff = (lowerBB < lowerKC) and (upperBB > upperKC)
noSqz  = (sqzOn == false) and (sqzOff == false)

sqzValRaw = ta.linreg(close - math.avg(math.avg(ta.highest(high, lengthKC), ta.lowest(low, lengthKC)), ta.sma(close, lengthKC)), lengthKC, 0)
sqzMaxAbs = ta.highest(math.abs(sqzValRaw), 100)
sqzValScaled = (sqzValRaw / (sqzMaxAbs == 0 ? 1 : sqzMaxAbs)) * (sqzHeightPct / 2) + sqzPosPct

// Color logic
sqzBColor = sqzValRaw > 0 ? (sqzValRaw > nz(sqzValRaw[1]) ? sqzUpColor : sqzUpLow) : (sqzValRaw < nz(sqzValRaw[1]) ? sqzDnColor : sqzDnLow)
sqzSColor = noSqz ? color.blue : sqzOn ? color.black : color.gray 

sqzPlot = plot(sqzValScaled, "Squeeze Momentum", color=sqzBColor, style=plot.style_columns, linewidth=sqzLineWidth)
zeroLinePlot = plot(sqzPosPct, "Squeeze Baseline", color=sqzSColor, style=plot.style_cross, linewidth=2)

// Gradient vs Solid Fill Logic
isGradient = sqzFillStyle == "Gradient"
sqzTopColor = sqzValScaled > sqzPosPct ? color.new(sqzBColor, 20) : (isGradient ? color.new(color.gray, 100) : color.new(sqzBColor, 50))
sqzBotColor = sqzValScaled > sqzPosPct ? (isGradient ? color.new(color.gray, 100) : color.new(sqzBColor, 50)) : color.new(sqzBColor, 20)

fill(sqzPlot, zeroLinePlot, math.max(sqzPosPct, sqzValScaled), math.min(sqzPosPct, sqzValScaled), sqzTopColor, sqzBotColor)

// --- 3. ADX / DMI SECTION ---
adxGroup = "ADX / DMI"
adxlen = input.int(14, "ADX Smoothing", group=adxGroup)
dilen = input.int(14, "DI Length", group=adxGroup)

// ADX Styling
adxShow  = input.bool(true, "Show ADX", group=adxGroup, inline="adx_style")
adxWidth = input.int(2, "Width", minval=1, group=adxGroup, inline="adx_style")
adxColor = input.color(#f23645, "", group=adxGroup, inline="adx_style")

diUpShow  = input.bool(true, "Show +DI", group=adxGroup, inline="diup_style")
diUpWidth = input.int(1, "Width", minval=1, group=adxGroup, inline="diup_style")
diUpColor = input.color(#5b9cf6, "", group=adxGroup, inline="diup_style")

diDnShow  = input.bool(true, "Show -DI", group=adxGroup, inline="didown_style")
diDnWidth = input.int(1, "Width", minval=1, group=adxGroup, inline="didown_style")
diDnColor = input.color(color.gray, "", group=adxGroup, inline="didown_style")

keyVal      = input.int(23, "Key Level Value", group=adxGroup)
keyStyle    = input.string("Dashed", "Key Style", options=["Solid", "Dashed", "Dotted"], group=adxGroup)
keyWidth    = input.int(1, "Key Width", minval=1, group=adxGroup)
keyColor    = input.color(color.white, "Key Color", group=adxGroup)

dirmov(len) =>
    up = ta.change(high)
    down = -ta.change(low)
    truerange = ta.rma(ta.tr, len)
    plus = fixnan(100 * ta.rma(up > down and up > 0 ? up : 0, len) / truerange)
    minus = fixnan(100 * ta.rma(down > up and down > 0 ? down : 0, len) / truerange)
    [plus, minus]

adxFunc(dilen, adxlen) => 
    [plus, minus] = dirmov(dilen)
    sum = plus + minus
    adxVal = 100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), adxlen)
    [adxVal, plus, minus]

[sig, up, down] = adxFunc(dilen, adxlen)

plot(sig, "ADX", color=adxColor, linewidth=adxWidth, display=adxShow ? display.all : display.none)
plot(up, "+DI", color=diUpColor, linewidth=diUpWidth, display=diUpShow ? display.all : display.none)
plot(down, "-DI", color=diDnColor, linewidth=diDnWidth, display=diDnShow ? display.all : display.none)

plot(keyVal, "Key Level", color=keyColor, linewidth=keyWidth, style=keyStyle == "Solid" ? plot.style_line : keyStyle == "Dashed" ? plot.style_linebr : plot.style_circles)

// --- 4. SIGNALS SECTION ---
sigGroup = "Signals"
showSignals = input.bool(true, "Show Buy/Sell Labels", group=sigGroup)
useAdxFilter = input.bool(true, "Filter Signals by ADX Strength", group=sigGroup)

// Logic: Squeeze just fired (sqzOn was true, now false) 
sqzFired = not sqzOn and sqzOn[1]
trendUp = close > ema1Val and (not ema2Show or close > ema2Val)
trendDn = close < ema1Val and (not ema2Show or close < ema2Val)
strengthOk = not useAdxFilter or sig > keyVal

buySignal = sqzFired and sqzValRaw > 0 and trendUp and strengthOk
sellSignal = sqzFired and sqzValRaw < 0 and trendDn and strengthOk

plotshape(buySignal, "Buy Label", style=shape.labelup, location=location.belowbar, color=sqzUpColor, text="BUY", textcolor=color.black, size=size.small, force_overlay=true)
plotshape(sellSignal, "Sell Label", style=shape.labeldown, location=location.abovebar, color=sqzDnColor, text="SELL", textcolor=color.white, size=size.small, force_overlay=true)
