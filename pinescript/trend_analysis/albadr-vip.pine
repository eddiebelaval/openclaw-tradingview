//@version=5
indicator("AlBadr SK - Advanced Warning Mode", overlay=true, max_labels_count=50, max_lines_count=100)

// ━━━━━━━━━━━ 1. القناة السعرية المتكيفة (ظهور دائم) ━━━━━━━━━━━
ch_len  = input.int(20, "طول القناة")
ch_mult = input.float(2.0, "اتساع القناة")
basis   = ta.sma(close, ch_len)
upper   = basis + (ch_mult * ta.stdev(close, ch_len))
lower   = basis - (ch_mult * ta.stdev(close, ch_len))

// رسم القناة لضمان عدم اختفائها
p1 = plot(upper, color=color.new(color.red, 60), title="القناة العلوية")
p2 = plot(lower, color=color.new(color.green, 60), title="القناة السفلية")
fill(p1, p2, color=color.new(color.blue, 97))

// ━━━━━━━━━━━ 2. متغيرات الرسم ━━━━━━━━━━━
var line entryLine = na, var line tp1Line = na, var line tp2Line = na, var line tp3Line = na, var line slLine = na
var label infoLabel = na

// ━━━━━━━━━━━ 3. التحليل الفني ━━━━━━━━━━━
ema200 = ta.ema(close, 200)
rsi    = ta.rsi(close, 14)
atr    = ta.atr(14)
volMA  = ta.sma(volume, 20)

// حساب نسبة النجاح
successBuy  = (close > ema200 ? 30 : 0) + (rsi > 50 ? 30 : 0) + (close > lower ? 40 : 0)
successSell = (close < ema200 ? 30 : 0) + (rsi < 50 ? 30 : 0) + (close < upper ? 40 : 0)

// ━━━━━━━━━━━ 4. كاشف الزخم العكسي (💀 Skull Warning) ━━━━━━━━━━━
// تحذير بيعي: إذا كان السعر في تشبع شرائي وظهرت سيولة بيعية ضخمة
bearWarning = ta.crossunder(rsi, 70) and volume > volMA * 1.5 and close < open
// تحذير شرائي: إذا كان السعر في تشبع بيعي وظهرت سيولة شرائية ضخمة
bullWarning = ta.crossover(rsi, 30) and volume > volMA * 1.5 and close > open

plotshape(bearWarning, title="Reverse Momentum Skull", text="💀", style=shape.labeldown, location=location.abovebar, color=color.new(color.orange, 0), textcolor=color.white, size=size.small)
plotshape(bullWarning, title="Reverse Momentum Skull", text="💀", style=shape.labelup, location=location.belowbar, color=color.new(color.orange, 0), textcolor=color.white, size=size.small)

// ━━━━━━━━━━━ 5. منطق الإشارات والأسهم ━━━━━━━━━━━
buySignal  = ta.crossover(close, lower) and successBuy >= 60
sellSignal = ta.crossunder(close, upper) and successSell >= 60

plotshape(buySignal, title="Buy Arrow", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(sellSignal, title="Sell Arrow", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

// ━━━━━━━━━━━ 6. رسم الأدوات عند الإشارة (تنظيف ذكي) ━━━━━━━━━━━
if buySignal or sellSignal
    line.delete(entryLine), line.delete(tp1Line), line.delete(tp2Line), line.delete(tp3Line), line.delete(slLine)
    label.delete(infoLabel)

    float entryPrice = close
    float slPrice    = buySignal ? (low - atr * 1.5) : (high + atr * 1.5)
    float diff       = math.abs(entryPrice - slPrice)
    
    float tp1 = buySignal ? entryPrice + (diff * 0.7) : entryPrice - (diff * 0.7)
    float tp2 = buySignal ? entryPrice + (diff * 2.0) : entryPrice - (diff * 2.0)
    float tp3 = buySignal ? entryPrice + (diff * 3.0) : entryPrice - (diff * 3.0)

    // رسم الخطوط وتمديدها لليمين
    entryLine := line.new(bar_index, entryPrice, bar_index + 20, entryPrice, extend=extend.right, color=color.white)
    tp1Line   := line.new(bar_index, tp1, bar_index + 15, tp1, extend=extend.right, color=color.new(color.green, 50), style=line.style_dotted)
    tp2Line   := line.new(bar_index, tp2, bar_index + 15, tp2, extend=extend.right, color=color.green, width=2)
    tp3Line   := line.new(bar_index, tp3, bar_index + 15, tp3, extend=extend.right, color=color.new(color.lime, 40), style=line.style_dashed)
    slLine    := line.new(bar_index, slPrice, bar_index + 15, slPrice, extend=extend.right, color=color.red, width=2)

    infoLabel := label.new(bar_index, buySignal ? low : high, 
         text="🚀 ENTRY: " + str.tostring(entryPrice, "#.###") + 
              "\n✅ SUCCESS: " + str.tostring(buySignal ? successBuy : successSell) + "%" +
              "\n🎯 TP1: " + str.tostring(tp1, "#.###") + 
              "\n🎯 TP2: " + str.tostring(tp2, "#.###") + 
              "\n🎯 TP3: " + str.tostring(tp3, "#.###") + 
              "\n🛑 SL: " + str.tostring(slPrice, "#.###"), 
         color=buySignal ? color.green : color.red, textcolor=color.white, style=buySignal ? label.style_label_up : label.style_label_down)
