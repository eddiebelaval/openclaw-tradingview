//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  Breakout Vault [Confirmed]
//  Compression zone detection with breakout signals, % TP/SL, gauge dashboard
//  © ArisCodes 2026
// ═══════════════════════════════════════════════════════════════════════════════
indicator("Breakout Vault [Confirmed] BTC Compatible", overlay=true,
          max_boxes_count=500, max_lines_count=500,
          max_labels_count=500, max_bars_back=500)

// ─────────────────────────────────────────────────────────────────────────────
// COLOR PALETTE
// ─────────────────────────────────────────────────────────────────────────────
color C_TEAL   = color.new(#00F5D4, 0)
color C_GOLD   = color.new(#FFD700, 0)
color C_BULL   = color.new(#00FF88, 0)
color C_BEAR   = color.new(#FF4466, 0)
color C_GRAY   = color.new(#666677, 0)
color C_PURP   = color.new(#9B59B6, 0)
color C_BG     = color.new(#0a0a14, 10)
color C_MUTED  = color.new(#AAAAAA, 40)
color C_BORDER = color.new(#00F5D4, 60)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────
grp_comp = "Compression Engine"
compLen  = input.int(20,   "Compression Lookback",      minval=5,   maxval=100, group=grp_comp,
           tooltip="Bars used to measure compression. Higher = requires longer squeeze before signal.")
compRatio= input.float(0.6,"Compression ATR Ratio",     minval=0.2, maxval=0.9, step=0.05, group=grp_comp,
           tooltip="Current ATR / Historical ATR. Below this = compressed. Lower = tighter squeeze required.")
minBars  = input.int(5,    "Min Bars in Compression",   minval=2,   maxval=50,  group=grp_comp,
           tooltip="Minimum number of consecutive compressed bars before a vault is drawn.")

grp_tm   = "Trade Management"
tpPct    = input.float(0.5, "TP % from breakout close", minval=0.05, maxval=20.0, step=0.05, group=grp_tm,
     tooltip="Take profit target as a % move from the breakout close.\nFutures (MNQ): 0.1–0.5%\nCrypto (BTC):  1.0–3.0%\nStocks:        0.5–2.0%")
slPct    = input.float(0.25,"SL % from breakout close", minval=0.05, maxval=20.0, step=0.05, group=grp_tm,
     tooltip="Stop loss as a % from the breakout close.\nFutures (MNQ): 0.5–1.0%\nCrypto (BTC):  2.0–5.0%\nStocks:        1.0–3.0%\n\n⚠️ Crypto requires wider stops — BTC easily moves 2–5% per bar.")
maxBars  = input.int(40,    "Max Bars in Trade",        minval=5,   maxval=200,  group=grp_tm)
showTP   = input.bool(true, "Show TP Line",              group=grp_tm)
showSL   = input.bool(true, "Show SL Line",              group=grp_tm)
showMid  = input.bool(true, "Show Vault Midline",        group=grp_tm)

grp_mom  = "Momentum Filter"
rsiLen   = input.int(14,  "RSI Length",     minval=2, group=grp_mom)
rsiObLvl = input.int(75,  "RSI OB Filter (Bull breakouts blocked above)",
     minval=60, maxval=95, group=grp_mom,
     tooltip="Bull breakouts are blocked when RSI is above this level.\nDefault 75 works for futures and stocks.\nCrypto (BTC/ETH): raise to 85–90 — crypto runs RSI 80+ for extended periods and will block most valid breakouts at default setting.")
rsiOsLvl = input.int(25,  "RSI OS Filter (Bear breakouts blocked below)",
     minval=5,  maxval=40, group=grp_mom,
     tooltip="Bear breakouts are blocked when RSI is below this level.\nDefault 25 works for futures and stocks.\nCrypto: lower to 10–15 to allow short signals during deep oversold trends.")
volLen   = input.int(20,  "Volume MA",      minval=2, group=grp_mom)
useVolFil= input.bool(true,"Volume Filter", group=grp_mom,
           tooltip="Require above-average volume on breakout bar for signal to fire.")

grp_vis  = "Visuals"
showGhost = input.bool(true,  "Ghost Candles",  group=grp_vis)
showDash  = input.bool(true,  "Dashboard",      group=grp_vis)

// ─────────────────────────────────────────────────────────────────────────────
// CORE CALCULATIONS
// ─────────────────────────────────────────────────────────────────────────────
float atr14    = ta.atr(14)
float atrSlow  = ta.atr(compLen * 2)   // historical ATR baseline
float rsi14    = ta.rsi(close, rsiLen)
float volMa    = ta.sma(volume, volLen)

// Compression condition — current ATR is compressed vs baseline
bool  isCompressed = atr14 / math.max(atrSlow, syminfo.mintick) < compRatio

// Rolling vault boundaries — track high/low during compression window
float vaultHigh = ta.highest(high, compLen)
float vaultLow  = ta.lowest(low,  compLen)
float vaultMid  = (vaultHigh + vaultLow) / 2

// Breakout conditions — confirmed closed bar outside vault
bool  bullBreak = close > vaultHigh and barstate.isconfirmed
bool  bearBreak = close < vaultLow  and barstate.isconfirmed

// Volume confirmation
bool  volOK = not useVolFil or volume > volMa

// Consecutive compression bar counter
var int compBars = 0
if isCompressed
    compBars := compBars + 1
else
    compBars := 0

bool  vaultReady = compBars >= minBars

max_bars_back(atr14,  500)
max_bars_back(atrSlow,500)
max_bars_back(rsi14,  500)
max_bars_back(volume, 500)
max_bars_back(close,  500)
max_bars_back(high,   500)
max_bars_back(low,    500)

// ─────────────────────────────────────────────────────────────────────────────
// GLOBAL FUNCTIONS — all at global scope (Pine v6 rule)
// ─────────────────────────────────────────────────────────────────────────────

// Compression strength color: gray → purple → teal → gold
f_vaultColor(int bars) =>
    bars < 5 ? C_GRAY : bars < 10 ? C_PURP : bars < 20 ? C_TEAL : C_GOLD

// Squeeze gauge label
f_squeeze(int bars) =>
    bars >= 20 ? "MAX  " : bars >= 10 ? "HIGH " : bars >= 5 ? "MED  " : "LOW  "

// Unicode gauge bar
f_gauge(float pct, int barLen) =>
    int filled = math.round(math.max(math.min(pct, 100.0), 0.0) / 100.0 * barLen)
    int empty  = barLen - filled
    string g   = ""
    for i = 0 to math.max(filled - 1, 0)
        g += "█"
    for i = 0 to math.max(empty - 1, 0)
        g += "░"
    g

// ─────────────────────────────────────────────────────────────────────────────
// UDT — VAULT
// States: ACTIVE (live compression box) → BROKEN (trade fired)
// ─────────────────────────────────────────────────────────────────────────────
type Vault
    float  vHigh          // vault ceiling
    float  vLow           // vault floor
    float  vMid           // vault midpoint
    float  entryPrice     = na
    float  tp             = na
    float  sl             = na
    bool   isBull         = false
    bool   isActive       = true   // compression ongoing
    bool   isBroken       = false  // breakout fired
    bool   isDone         = false  // trade complete
    int    startBar               // bar compression zone started
    int    breakBar       = na    // bar breakout fired
    int    entryBar       = na
    int    activatedBar   = na    // for alert scanning
    int    sqzBars                // compression bar count at formation
    // Visuals
    box    halo
    box    body
    box    core
    line   midLine
    line   tpLine
    line   slLine

// ─────────────────────────────────────────────────────────────────────────────
// METHOD — DRAW VAULT BOX
// ─────────────────────────────────────────────────────────────────────────────
method drawVault(Vault self) =>
    color c  = f_vaultColor(self.sqzBars)
    int   x1 = self.startBar
    int   x2 = bar_index + 10

    self.halo := box.new(x1, self.vHigh, x2, self.vLow,
                         border_color=na, bgcolor=color.new(c, 93))
    self.body := box.new(x1, self.vHigh, x2, self.vLow,
                         border_color=na, bgcolor=color.new(c, 86))
    self.core := box.new(x1, self.vHigh, x2, self.vLow,
                         border_color=color.new(c, 55), bgcolor=color.new(c, 78))

    if showMid
        self.midLine := line.new(x1, self.vMid, x2, self.vMid,
                                 color=color.new(c, 50),
                                 style=line.style_dashed, width=1)

// ─────────────────────────────────────────────────────────────────────────────
// METHOD — DRAW TP/SL (called at breakout bar only)
// ─────────────────────────────────────────────────────────────────────────────
method drawLevels(Vault self) =>
    int x1 = bar_index
    int x2 = bar_index + 40
    if showTP
        self.tpLine := line.new(x1, self.tp, x2, self.tp,
                                color=color.new(self.isBull ? C_TEAL : C_BEAR, 25),
                                style=line.style_dashed, width=2)
    if showSL
        self.slLine := line.new(x1, self.sl, x2, self.sl,
                                color=color.new(C_BEAR, 40),
                                style=line.style_dashed, width=1)

// ─────────────────────────────────────────────────────────────────────────────
// METHOD — FADE (trade over — box dims, stays as history)
// ─────────────────────────────────────────────────────────────────────────────
method fadeVault(Vault self) =>
    box.set_bgcolor(self.halo, color.new(C_GRAY, 97))
    box.set_bgcolor(self.body, color.new(C_GRAY, 95))
    box.set_bgcolor(self.core, color.new(C_GRAY, 93))
    box.set_border_color(self.core, color.new(C_GRAY, 85))
    if not na(self.midLine)
        line.set_color(self.midLine, color.new(C_GRAY, 80))

// ─────────────────────────────────────────────────────────────────────────────
// METHOD — EXTEND active vault to current bar
// ─────────────────────────────────────────────────────────────────────────────
method extendVault(Vault self) =>
    int x2 = bar_index + 5
    box.set_right(self.halo, x2)
    box.set_right(self.body, x2)
    box.set_right(self.core, x2)
    if not na(self.midLine)
        line.set_x2(self.midLine, x2)
    if not na(self.tpLine)
        line.set_x2(self.tpLine, x2)
    if not na(self.slLine)
        line.set_x2(self.slLine, x2)

// ─────────────────────────────────────────────────────────────────────────────
// VAULT STORAGE
// ─────────────────────────────────────────────────────────────────────────────
var Vault[] vaults = array.new<Vault>()
var int     maxVaults = 8

// ONE TRADE AT A TIME — Rule #21
// Global flag: true when any vault has an active live trade (isBroken=true).
// All other active vaults are blocked from firing until current trade exits.
var bool    g_inTrade = false

// ─────────────────────────────────────────────────────────────────────────────
// VAULT CREATION — fires when compression ends and breakout confirmed
// Box draws from compression START bar — honest, drawn at creation time
// ─────────────────────────────────────────────────────────────────────────────
var int  lastVaultBar = 0  // prevent duplicate vaults on same compression

if vaultReady and barstate.isconfirmed
    // Only create new vault if not already tracking one from this compression
    bool noRecentVault = bar_index - lastVaultBar > compLen

    if noRecentVault
        int sqStart = math.max(bar_index - compBars, bar_index - 490)

        Vault v = Vault.new(
            vHigh    = vaultHigh,
            vLow     = vaultLow,
            vMid     = vaultMid,
            startBar = sqStart,
            sqzBars  = compBars)

        v.drawVault()
        array.unshift(vaults, v)
        lastVaultBar := bar_index

        // Purge oldest
        if array.size(vaults) > maxVaults
            Vault old = array.pop(vaults)
            old.fadeVault()

// ─────────────────────────────────────────────────────────────────────────────
// PROCESS VAULTS — state machine (inlined — global scope required for g_inTrade)
// ACTIVE → detect breakout → BROKEN (trade fires at bar_index)
// BROKEN → monitor TP/SL/MaxBars → DONE
// ALL labels fire at bar_index — ZERO DELAY
// NOTE: g_inTrade cannot be modified inside a function in Pine v6.
//       Loop is inlined at global scope so g_inTrade is always writable.
// ─────────────────────────────────────────────────────────────────────────────
int _vsz = array.size(vaults)
if _vsz > 0
    for _i = _vsz - 1 to 0
        Vault v = array.get(vaults, _i)

        if not v.isDone

            // ── STATE: ACTIVE — watching for breakout ─────────────────
            if v.isActive
                bool brokeUp   = close > v.vHigh and barstate.isconfirmed and volOK
                bool brokeDown = close < v.vLow  and barstate.isconfirmed and volOK

                // RSI filter — avoid OB breakouts long, OS breakouts short
                bool rsiOKBull = rsi14 < rsiObLvl
                bool rsiOKBear = rsi14 > rsiOsLvl

                if brokeUp and rsiOKBull and not g_inTrade
                    // BULL BREAKOUT — signal fires NOW at bar_index
                    g_inTrade     := true
                    v.isActive    := false
                    v.isBroken    := true
                    v.isBull      := true
                    v.entryPrice  := close
                    v.entryBar    := bar_index
                    v.breakBar    := bar_index
                    v.tp          := close * (1 + tpPct / 100)
                    v.sl          := close * (1 - slPct / 100)
                    v.activatedBar := bar_index

                    v.drawLevels()

                    // BUY label — bar_index, yloc.belowbar — ZERO DELAY
                    label.new(bar_index, na,
                              "▲ BUY\nTP: " + str.tostring(v.tp, format.mintick) + "\nSL: " + str.tostring(v.sl, format.mintick),
                              yloc      = yloc.belowbar,
                              style     = label.style_label_up,
                              color     = color.new(C_BULL, 15),
                              textcolor = color.white,
                              size      = size.small)

                else if brokeDown and rsiOKBear and not g_inTrade
                    // BEAR BREAKOUT — signal fires NOW at bar_index
                    g_inTrade     := true
                    v.isActive    := false
                    v.isBroken    := true
                    v.isBull      := false
                    v.entryPrice  := close
                    v.entryBar    := bar_index
                    v.breakBar    := bar_index
                    v.tp          := close * (1 - tpPct / 100)
                    v.sl          := close * (1 + slPct / 100)
                    v.activatedBar := bar_index

                    v.drawLevels()

                    // SHORT label — bar_index, yloc.abovebar — ZERO DELAY
                    label.new(bar_index, na,
                              "▼ SHORT\nTP: " + str.tostring(v.tp, format.mintick) + "\nSL: " + str.tostring(v.sl, format.mintick),
                              yloc      = yloc.abovebar,
                              style     = label.style_label_down,
                              color     = color.new(C_BEAR, 15),
                              textcolor = color.white,
                              size      = size.small)

                else
                    // Still compressing — extend box and update boundaries
                    box.set_top(v.core, vaultHigh)
                    box.set_bottom(v.core, vaultLow)
                    box.set_top(v.body, vaultHigh)
                    box.set_bottom(v.body, vaultLow)
                    box.set_top(v.halo, vaultHigh)
                    box.set_bottom(v.halo, vaultLow)
                    v.vHigh := vaultHigh
                    v.vLow  := vaultLow
                    v.vMid  := vaultMid
                    if not na(v.midLine)
                        line.set_y1(v.midLine, vaultMid)
                        line.set_y2(v.midLine, vaultMid)
                    v.extendVault()

            // ── STATE: BROKEN — trade is live ────────────────────────
            else if v.isBroken
                int   barsHeld = bar_index - v.entryBar
                float pnlPct   = v.isBull ? (close - v.entryPrice) / v.entryPrice * 100 : (v.entryPrice - close) / v.entryPrice * 100

                // TP HIT
                bool tpHit = v.isBull ? high >= v.tp : low <= v.tp
                if tpHit and barstate.isconfirmed
                    v.isDone   := true
                    v.isBroken := false
                    g_inTrade  := false
                    v.fadeVault()
                    label.new(bar_index, na,
                              " ✦ TAKE PROFIT  +" + str.tostring(tpPct, "#.##") + "% ",
                              yloc      = v.isBull ? yloc.abovebar : yloc.belowbar,
                              style     = v.isBull ? label.style_label_down : label.style_label_up,
                              color     = color.new(C_TEAL, 10),
                              textcolor = color.white,
                              size      = size.small)

                // SL HIT
                else if (v.isBull ? low <= v.sl : high >= v.sl) and barstate.isconfirmed
                    v.isDone   := true
                    v.isBroken := false
                    g_inTrade  := false
                    v.fadeVault()
                    label.new(bar_index, na,
                              " STOP LOSS  -" + str.tostring(slPct, "#.##") + "% ",
                              yloc      = v.isBull ? yloc.belowbar : yloc.abovebar,
                              style     = v.isBull ? label.style_label_up : label.style_label_down,
                              color     = color.new(C_BEAR, 20),
                              textcolor = color.white,
                              size      = size.small)

                // MAX BARS
                else if barsHeld >= maxBars and barstate.isconfirmed
                    v.isDone   := true
                    v.isBroken := false
                    g_inTrade  := false
                    v.fadeVault()
                    label.new(bar_index, na,
                              " TIME EXIT  " + str.tostring(pnlPct, "#.##") + "% ",
                              yloc      = v.isBull ? yloc.belowbar : yloc.abovebar,
                              style     = v.isBull ? label.style_label_up : label.style_label_down,
                              color     = color.new(C_GRAY, 40),
                              textcolor = color.new(color.white, 30),
                              size      = size.tiny)

                else
                    v.extendVault()

// ─────────────────────────────────────────────────────────────────────────────
// GHOST CANDLES — global scope, condition inline
// ─────────────────────────────────────────────────────────────────────────────
barcolor(showGhost ? color.new(color.gray, 80) : na)

// ─────────────────────────────────────────────────────────────────────────────
// ALERT SCANNING — reads UDT field at global scope after f_process runs
// No global variable modification in functions — UDT stamp pattern
// ─────────────────────────────────────────────────────────────────────────────
bool bullBreakAlert = false
bool bearBreakAlert = false
int  alertSqzBars   = 0

int _asz = array.size(vaults)
if _asz > 0
    for _ai = 0 to _asz - 1
        Vault _av = array.get(vaults, _ai)
        if _av.activatedBar == bar_index
            if _av.isBull
                bullBreakAlert := true
                alertSqzBars   := _av.sqzBars
            else
                bearBreakAlert := true
                alertSqzBars   := _av.sqzBars

alertcondition(bullBreakAlert, "BUY Breakout",        "BUY: Vault breakout confirmed — long entry")
alertcondition(bearBreakAlert, "SHORT Breakout",      "SHORT: Vault breakout confirmed — short entry")
alertcondition(bullBreakAlert and alertSqzBars >= 10, "BUY Breakout Strong Squeeze",   "BUY: High compression vault breakout")
alertcondition(bearBreakAlert and alertSqzBars >= 10, "SHORT Breakout Strong Squeeze", "SHORT: High compression vault breakout")

// ─────────────────────────────────────────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────────────────────────────────────────
if showDash and barstate.islast
    int   vCount    = array.size(vaults)
    float sqzRatio  = atrSlow > 0 ? atr14 / atrSlow * 100 : 100.0
    float sqzGaugePct = math.max(100.0 - sqzRatio / compRatio * 100.0, 0.0)

    // Find newest active/broken vault for trade levels
    float dashTP    = na
    float dashSL    = na
    string tradeDir = "NONE"
    string tradeState = "WATCHING"
    color  tradeCol = C_GRAY
    int    dashBarsLeft = 0

    if vCount > 0
        Vault newest = array.get(vaults, 0)
        if newest.isBroken
            dashTP       := newest.tp
            dashSL       := newest.sl
            tradeDir      = newest.isBull ? "LONG " : "SHORT"
            tradeState    = "ACTIVE ●"
            tradeCol      = newest.isBull ? C_BULL : C_BEAR
            dashBarsLeft  := math.max(maxBars - (bar_index - newest.entryBar), 0)
        else if newest.isActive
            tradeState = "ARMED  ◉"
            tradeCol   = C_GOLD

    // Dot indicators
    string vDots = ""
    for i = 0 to 5
        if i < vCount
            Vault _v = array.get(vaults, i)
            vDots += _v.isBroken ? "✦" : _v.isActive ? "◉" : "○"
        else
            vDots += "○"

    string sqzState  = isCompressed ? "SQUEEZE ▼" : "RANGING  "
    color  sqzCol    = isCompressed ? C_GOLD : C_MUTED
    string sqzG      = f_gauge(sqzGaugePct, 10)
    string rsiG      = f_gauge(rsi14, 10)
    string volG      = f_gauge(math.min(volume / math.max(volMa, 1) * 50, 100), 10)
    string volState  = volume > volMa * 1.5 ? "SURGE ▲▲" : volume > volMa ? "ABOVE  ▲" : volume > volMa * 0.7 ? "NORMAL  " : "LOW    ▼"
    color  volCol    = volume > volMa * 1.5 ? C_TEAL : volume > volMa ? C_GOLD : C_MUTED
    string rsiVal    = str.tostring(math.round(rsi14))
    string rsiStr    = rsi14 > 70 ? "OB  " + rsiVal : rsi14 < 30 ? "OS  " + rsiVal : "    " + rsiVal
    color  rsiCol    = rsi14 > 60 ? C_BEAR : rsi14 < 40 ? C_BULL : C_MUTED
    string sqzLabel  = f_squeeze(compBars)
    string compBarStr= str.tostring(compBars) + " bars"
    string barsStr   = tradeState == "ACTIVE ●" ? str.tostring(dashBarsLeft) + " bars" : "--"
    string tpStr     = na(dashTP) ? "--" : str.tostring(dashTP, format.mintick)
    string slStr     = na(dashSL) ? "--" : str.tostring(dashSL, format.mintick)

    var table dash = table.new(position.top_right, 1, 23,
                               bgcolor=C_BG, border_color=C_BORDER, border_width=1,
                               frame_color=color.new(#00F5D4, 45), frame_width=1)

    table.cell(dash, 0,  0, "  Breakout Vault [Confirmed]  ",        text_color=C_TEAL,  text_size=size.small, text_font_family=font.family_monospace, bgcolor=color.new(#0d1117, 5))
    table.cell(dash, 0,  1, "──────────────────────────────",         text_color=color.new(C_TEAL, 60), text_size=size.tiny, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0,  2, " SQUEEZE " + sqzG + "  " + sqzLabel,   text_color=sqzCol,   text_size=size.small, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0,  3, " STATE   " + sqzState,                  text_color=sqzCol,   text_size=size.small, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0,  4, " COMP    " + compBarStr,                text_color=C_MUTED,  text_size=size.small, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0,  5, "──────────────────────────────",         text_color=color.new(C_TEAL, 60), text_size=size.tiny, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0,  6, " RSI     " + rsiG + "  " + rsiStr,     text_color=rsiCol,   text_size=size.small, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0,  7, " VOL     " + volG  + "  " + volState,  text_color=volCol,   text_size=size.small, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0,  8, " ATR     " + str.tostring(atr14, format.mintick), text_color=C_MUTED, text_size=size.small, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0,  9, "──────────────────────────────",         text_color=color.new(C_TEAL, 60), text_size=size.tiny, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0, 10, " VAULTS  " + vDots,                    text_color=C_TEAL,   text_size=size.small, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0, 11, "──────────────────────────────",         text_color=color.new(C_TEAL, 60), text_size=size.tiny, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0, 12, " TRADE   " + tradeState,               text_color=tradeCol, text_size=size.small, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0, 13, " DIR     " + tradeDir,                 text_color=tradeCol, text_size=size.small, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0, 14, " TP      " + tpStr,                    text_color=C_TEAL,   text_size=size.small, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0, 15, " SL      " + slStr,                    text_color=C_BEAR,   text_size=size.small, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0, 16, " MAX     " + barsStr,                  text_color=C_MUTED,  text_size=size.small, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0, 17, "──────────────────────────────",         text_color=color.new(C_TEAL, 60), text_size=size.tiny, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0, 18, " TP +" + str.tostring(tpPct) + "%  SL -" + str.tostring(slPct) + "%", text_color=C_MUTED, text_size=size.small, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0, 19, "──────────────────────────────",         text_color=color.new(C_TEAL, 60), text_size=size.tiny, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0, 20, " ◉ ARMED  ✦ ACTIVE  ○ DONE",          text_color=color.new(C_MUTED, 30), text_size=size.tiny, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0, 21, " GRAY→PURP→TEAL→GOLD = squeeze",       text_color=color.new(C_MUTED, 30), text_size=size.tiny, text_font_family=font.family_monospace, bgcolor=C_BG)
    table.cell(dash, 0, 22, "──────────────────────────────",         text_color=color.new(C_TEAL, 60), text_size=size.tiny, text_font_family=font.family_monospace, bgcolor=C_BG)

