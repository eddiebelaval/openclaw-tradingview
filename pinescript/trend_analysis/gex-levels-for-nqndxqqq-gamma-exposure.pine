// GEX Levels Dashboard - NQ/NDX/QQQ Gamma Exposure Levels
// Data exported in NQ Futures terms - Select your ticker in settings
// Alert system contribution by @_prodigy_dev
// v6.9: BUILT-IN 5DTE WEEKLY LEVELS - Works out of the box! Custom data in text input takes priority
// v7.0: WEEKLY VAR DATA - Update WEEKLY_DATA string in code, publish via TV Update each week
//@version=6
indicator("GEX Levels Dashboard - NQ/NDX/QQQ Gamma Exposure", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ============== INPUTS ==============
groupTicker = "Ticker Settings"
groupGen = "General Settings"
groupLevels = "Level Visibility"
groupLines = "Price Levels Style"
groupCol = "Colors"
groupAlerts = "Alerts"

// TICKER SELECTION
tickerChoice = input.string("NQ", "Display Ticker", options=["NQ", "NDX", "QQQ"], group=groupTicker, tooltip="Select the instrument to display levels in. Data is exported in NQ terms and converted based on this selection.")

// NQ-NDX Spread captured at export time
var float nqNdxSpread = 40

// v7.0: WEEKLY DATA — to update: change WEEKLY_DATA string below, then publish via TV Update
// ⚠️  ONLY this line changes each week — everything else stays the same
// Last update: 2026-03-08 | Expiry: 5DTE | Next update: ~2026-03-14
string WEEKLY_DATA = "L:24886,ZG,ZERO GAMMA,Zero Gamma~Key pivot where dealer gamma flips~Price magnet,0;24928,MP,MAX PAIN,Max Pain~Strike with maximum option pain~Expiry target,0;24835,EH,EM HIGH,Expected Move HIGH~1-sigma upper boundary~Statistical resistance,0;24506,EL,EM LOW,Expected Move LOW~1-sigma lower boundary~Statistical support,0;24968,VH,VOL HIGH,Vol Band HIGH~Volatility-based resistance~ZG + 25% EM,0;24803,VL,VOL LOW,Vol Band LOW~Volatility-based support~ZG - 25% EM,0;25228,CW,Call Wall,Strike: 25228~From Spot: +2.26%~Tot GEX: 108.47M~C/P Ratio: 36.6~Hold: 63% | Break: 37%,108.5;25128,CW,Call Wall,Strike: 25128~From Spot: +1.86%~Tot GEX: 36.66M~C/P Ratio: 4.5~Hold: 58% | Break: 42%,36.7;24728,PW,Put Wall,Strike: 24728~From Spot: +0.23%~Tot GEX: -39.62M~C/P Ratio: 0.1~Hold: 79% | Break: 21%,39.6;25028,CW,Call Wall,Strike: 25028~From Spot: +1.45%~Tot GEX: 19.37M~C/P Ratio: 3.3~Hold: 68% | Break: 32%,19.4;24978,PW,Put Wall,Strike: 24978~From Spot: +1.25%~Tot GEX: -10.69M~C/P Ratio: 0.5~Hold: 70% | Break: 30%,10.7;24828,PW,Put Wall,Strike: 24828~From Spot: +0.64%~Tot GEX: -8.13M~C/P Ratio: 0.5~Hold: 80% | Break: 20%,8.1;24878,PW,Put Wall,Strike: 24878~From Spot: +0.84%~Tot GEX: -4.98M~C/P Ratio: 0.7~Hold: 83% | Break: 17%,5.0;24778,PW,Put Wall,Strike: 24778~From Spot: +0.44%~Tot GEX: -9.00M~C/P Ratio: 0.4~Hold: 80% | Break: 20%,9.0;25378,CW,Call Wall,Strike: 25378~From Spot: +2.87%~Tot GEX: 18.31M~C/P Ratio: 9.4~Hold: 64% | Break: 36%,18.3;25928,CW,Call Wall,Strike: 25928~From Spot: +5.10%~Tot GEX: 20.46M~Hold: 59% | Break: 41%,20.5;25328,CW,Call Wall,Strike: 25328~From Spot: +2.67%~Tot GEX: 13.46M~C/P Ratio: 5.3~Hold: 64% | Break: 36%,13.5;26028,CW,Call Wall,Strike: 26028~From Spot: +5.50%~Tot GEX: 18.88M~Hold: 59% | Break: 41%,18.9;25078,CW,Call Wall,Strike: 25078~From Spot: +1.65%~Tot GEX: 1.64M~C/P Ratio: 1.2~Hold: 76% | Break: 24%,1.6;25278,CW,Call Wall,Strike: 25278~From Spot: +2.46%~Tot GEX: 12.51M~C/P Ratio: 7.7~Hold: 65% | Break: 35%,12.5;24958,PW,