//@version=6
indicator("Reaction Entry Engine | tradewsamet", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// =====================================================
// ======================= INPUTS =======================
// =====================================================
grpBrand = "Brand & Visual Identity"
vis_keepTrades = input.int(70, "Maximum Historical Trades Kept", minval=10, maxval=150, group=grpBrand)

grpSD   = "Supply & Demand Engine" 
sd_on   = input.bool(true, "Enable Supply & Demand Engine", group=grpSD)
sd_showZones = input.bool(false, "Show S&D Zones", group=grpSD)

sd_symPip    = input.float(0.000001, "Pip Value (XAUUSD ≈ 0.01)", step=0.0001, group=grpSD)
sd_leftBars  = input.int(2, "Pivot Left",  minval=1, group=grpSD)
sd_rightBars = input.int(2, "Pivot Right", minval=1, group=grpSD)

sd_useChart = input.bool(true, "Use Chart Timeframe Zones", group=grpSD)
sd_useHTF   = input.bool(true, "Use Higher Timeframe Zones", group=grpSD)
sd_srcTF    = input.timeframe("60", "Higher Timeframe", group=grpSD)

sd_minTouches  = input.int(4,   "Minimum Touches for Confirmed Zone", minval=1, group=grpSD)
sd_zonePadPP   = input.int(99,  "Zone Thickness (pips)", minval=1, group=grpSD)
sd_mergeDistPP = input.int(150, "Zone Merge Distance (pips)", minval=0, group=grpSD)
sd_brkBufPP    = input.int(60,  "Break Close Buffer (pips)", minval=0, group=grpSD)
sd_maxZones    = input.int(60,  "Maximum Stored Zones", minval=10, maxval=200, group=grpSD)

sd_useWicks  = input.bool(true, "Use Wick Touch", group=grpSD)
sd_useBodies = input.bool(true, "Use Body Touch", group=grpSD)

// zone colors
sd_colDem    = input.color(color.new(color.lime, 75),   "Demand (Chart TF)", group=grpSD)
sd_colSup    = input.color(color.new(color.red,  75),   "Supply (Chart TF)", group=grpSD)
sd_colDemOk  = input.color(color.new(color.lime, 40),   "Demand Confirmed (Chart TF)", group=grpSD)
sd_colSupOk  = input.color(color.new(color.red,  40),   "Supply Confirmed (Chart TF)", group=grpSD)

sd_colDem2   = input.color(color.new(color.teal, 75),   "Demand (HTF)", group=grpSD)
sd_colSup2   = input.color(color.new(color.orange,75),  "Supply (HTF)", group=grpSD)
sd_colDem2Ok = input.color(color.new(color.teal, 40),   "Demand Confirmed (HTF)", group=grpSD)
sd_colSup2Ok = input.color(color.new(color.orange,40),  "Supply Confirmed (HTF)", group=grpSD)

// ---- impulse filter
grpIMP = "Impulse Filter"
sd_useImp      = input.bool(true,  "Enable Impulse Filter", group=grpIMP)
sd_impBars     = input.int(1,      "Impulse Candle Count", minval=1, maxval=3, group=grpIMP)
sd_impAtrLen   = input.int(14,     "ATR Length", minval=1, group=grpIMP)
sd_impRangeMul = input.float(1.0,  "Minimum Range × ATR", minval=0.1, step=0.1, group=grpIMP)
sd_impBodyMul  = input.float(0.6,  "Minimum Body × ATR",  minval=0.1, step=0.1, group=grpIMP)
sd_impClosePos = input.float(0.7,  "Close Near Extreme (0-1)", minval=0.5, maxval=0.95, step=0.05, group=grpIMP)

sd_impUseVol   = input.bool(false, "Require Volume Condition", group=grpIMP)
sd_impVolLen   = input.int(20,     "Volume SMA Length", minval=1, group=grpIMP)
sd_impVolMul   = input.float(1.2,  "Minimum Volume × SMA", minval=0.1, step=0.1, group=grpIMP)

// ---- quality engine
grpQ = "Quality Engine"
sd_qUse          = input.bool(true, "Enable Quality Engine", group=grpQ)
sd_qDepBars      = input.int(3, "Displacement Bars", minval=1, maxval=10, group=grpQ)
sd_qMinDepPP     = input.float(120, "Minimum Displacement (pips)", minval=1, group=grpQ)
sd_qReactBars    = input.int(6, "Reaction Window (bars)", minval=1, maxval=30, group=grpQ)
sd_qMinReactPP   = input.float(80, "Minimum Reaction (pips)", minval=1, group=grpQ)
sd_qMaxPenPct    = input.float(0.55, "Maximum Penetration %", minval=0.05, maxval=0.95, step=0.05, group=grpQ)
sd_qTouchPenalty = input.float(12, "Touch Penalty", minval=0, maxval=50, group=grpQ)

sd_qHideTrash    = input.bool(false, "Hide TRASH Grade Zones", group=grpQ)
sd_qShowGrade    = input.bool(true,  "Show Grade on Zones", group=grpQ)

sd_showZoneLabel = input.bool(false, "Show Zone Labels", group=grpQ)
sd_zoneLblSizeS  = input.string("tiny", "Zone Label Size", options=["tiny","small","normal"], group=grpQ)

// ---- simulator
grpSIM = "Signal Simulator (Entry = First Touch)"
sim_on          = input.bool(true, "Enable Simulator", group=grpSIM)
sim_rr          = input.float(2.0, "Take Profit RR", minval=0.2, step=0.1, group=grpSIM)
sim_slPP        = input.int(500,   "Stop Loss (pips)", minval=1, group=grpSIM)
sim_onlyChartTF = input.bool(false, "Use Chart TF Signals Only", group=grpSIM)
sim_minGrade    = input.string("TRASH", "Minimum Grade (A / B / TRASH)", options=["A","B","TRASH"], group=grpSIM)

sim_showMarks   = input.bool(true, "Show Entry / Exit Labels", group=grpSIM)
sim_showLines   = input.bool(true, "Show Entry / SL / TP Lines", group=grpSIM)
sim_extendBars  = input.int(80, "Projection Length (bars)", minval=10, maxval=500, group=grpSIM)

// TP/SL boxes
grpBOX = "Trade Box Styling"
sim_showBoxes   = input.bool(true, "Show TP / SL Boxes", group=grpBOX)
sim_tpBoxCol    = input.color(color.new(#22c55e, 68), "TP Box Fill", group=grpBOX)
sim_slBoxCol    = input.color(color.new(#ef4444, 68), "SL Box Fill", group=grpBOX)
sim_tpBorderCol = input.color(color.new(#16a34a, 0), "TP Box Border", group=grpBOX)
sim_slBorderCol = input.color(color.new(#dc2626, 0), "SL Box Border", group=grpBOX)
sim_boxBorder   = input.bool(true, "Show Box Border", group=grpBOX)

sim_showStats   = input.bool(true, "Show Performance Panel", group=grpSIM)
sim_statsPosStr = input.string("Top Left", "Performance Panel Position", options=["Top Left","Top Right","Bottom Left","Bottom Right"], group=grpSIM)

// ---- daily
grpDAY = "Daily Performance"
sim_showDaily   = input.bool(true, "Show Daily PnL Panel", group=grpDAY)
sim_dailyDays   = input.int(14, "Number of Days", minval=5, maxval=60, group=grpDAY)
sim_dailyPosStr = input.string("Bottom Right", "Daily Panel Position", options=["Top Left","Top Right","Bottom Left","Bottom Right"], group=grpDAY)


// =====================================================
// ======================= STYLE ========================
// =====================================================
COL_BG_1   = color.new(#0b1220, 0)
COL_BG_2   = color.new(#111827, 0)
COL_BG_3   = color.new(#172033, 0)
COL_TXT    = color.new(#e5e7eb, 0)
COL_MUTED  = color.new(#94a3b8, 0)
COL_POS    = color.new(#22c55e, 0)
COL_NEG    = color.new(#ef4444, 0)
COL_ACCENT = color.new(#38bdf8, 0)
COL_WARN   = color.new(#f59e0b, 0)
COL_FLAT   = color.new(#a1a1aa, 0)

LINE_ENTRY_COL = color.new(#e5e7eb, 0)
LINE_SL_COL    = color.new(#ef4444, 0)
LINE_TP_COL    = color.new(#22c55e, 0)

f_cell(_tbl, _c, _r, _txt, _txtColor, _bgColor) =>
    table.cell(_tbl, _c, _r, _txt, text_color=_txtColor, bgcolor=_bgColor)

f_metric_label_bg() => COL_BG_2
f_metric_value_bg() => COL_BG_1

f_perf_color(_v) =>
    na(_v) ? COL_MUTED : _v > 0 ? COL_POS : _v < 0 ? COL_NEG : COL_FLAT

f_delete_line(_ln) =>
    if not na(_ln)
        line.delete(_ln)

f_delete_box(_bx) =>
    if not na(_bx)
        box.delete(_bx)

f_delete_label(_lb) =>
    if not na(_lb)
        label.delete(_lb)


// =====================================================
// ====================== HELPERS =======================
// =====================================================
sd_priceToPip(d) => d / sd_symPip
sd_pipToPrice(p) => p * sd_symPip

sd_pp_str(v) => str.tostring(v, "#.0")
sd_lbl_size(s) => s == "tiny" ? size.tiny : s == "small" ? size.small : size.normal
sd_clamp(x, lo, hi) => math.max(lo, math.min(hi, x))

sim_min_grade(_s) => _s == "A" ? 2 : _s == "B" ? 1 : 0
sim_pos_from_str(_p) => _p == "Top Left" ? position.top_left : _p == "Top Right" ? position.top_right : _p == "Bottom Left" ? position.bottom_left : position.bottom_right

fmt2(x) => na(x) ? "NA" : str.tostring(x, "#.00")
fmt1(x) => na(x) ? "NA" : str.tostring(x, "#.0")

const string SIM_TZ = "Etc/GMT-3"

pad2(_i) => _i < 10 ? ("0" + str.tostring(_i)) : str.tostring(_i)

dateStrFromTS(_ts) =>
    str.tostring(year(_ts, SIM_TZ)) + "-" + pad2(month(_ts, SIM_TZ)) + "-" + pad2(dayofmonth(_ts, SIM_TZ))

sim_day_start_ts() =>
    timestamp(SIM_TZ, year(time, SIM_TZ), month(time, SIM_TZ), dayofmonth(time, SIM_TZ), 0, 0)


// =====================================================
// ================== IMPULSE FILTER ====================
// =====================================================
sd_impulse_after_pivot(_isSupply) =>
    if not sd_useImp
        true
    else
        atr   = ta.atr(sd_impAtrLen)
        volMA = ta.sma(volume, sd_impVolLen)
        ok = true
        for k = 1 to sd_impBars
            off = sd_rightBars - k
            if off < 0
                ok := false
            else
                atrOff = atr[off]
                volOff = volMA[off]
                rng = high[off] - low[off]
                bod = math.abs(close[off] - open[off])

                dirOk = _isSupply ? (close[off] < open[off]) : (close[off] > open[off])
                pos = rng == 0.0 ? 0.5 : (close[off] - low[off]) / rng
                posOk = _isSupply ? (pos <= (1.0 - sd_impClosePos)) : (pos >= sd_impClosePos)

                rngOk = not na(atrOff) and (rng >= sd_impRangeMul * atrOff)
                bodOk = not na(atrOff) and (bod >= sd_impBodyMul * atrOff)
                volOk = not sd_impUseVol ? true : (not na(volOff) and (volume[off] >= sd_impVolMul * volOff))

                ok := ok and dirOk and posOk and rngOk and bodOk and volOk
        ok

sd_htf_pivot_imp_ok(_isSupply) =>
    float piv = _isSupply ? ta.pivothigh(high, sd_leftBars, sd_rightBars) : ta.pivotlow(low, sd_leftBars, sd_rightBars)
    bool  imp = sd_impulse_after_pivot(_isSupply)
    (not na(piv)) and imp

bool sd_impOkSup_CT = sd_impulse_after_pivot(true)
bool sd_impOkDem_CT = sd_impulse_after_pivot(false)


// =====================================================
// ================= QUALITY ENGINE =====================
// =====================================================
sd_displacement_pp_chart(_isSupply) =>
    float piv = _isSupply ? high[sd_rightBars] : low[sd_rightBars]
    float ext = _isSupply ? 10e10 : -10e10
    for k = 1 to sd_qDepBars
        off = sd_rightBars - k
        if off >= 0
            ext := _isSupply ? math.min(ext, low[off]) : math.max(ext, high[off])
    float dep = _isSupply ? (piv - ext) : (ext - piv)
    sd_priceToPip(dep)

sd_penetration(_typ, _top, _bot) =>
    rng = math.max(_top - _bot, syminfo.mintick)
    _typ == 1 ? sd_clamp((high - _bot) / rng, 0.0, 1.2) : sd_clamp((_top - low) / rng, 0.0, 1.2)

sd_update_best_move(_typ, _entryRef, _bestMove) =>
    cur = _typ == 1 ? (_entryRef - low) : (high - _entryRef)
    math.max(_bestMove, cur)

sd_grade(_s) => _s >= 70 ? 2 : _s >= 45 ? 1 : 0
sd_grade_txt(_g) => _g == 2 ? "A" : _g == 1 ? "B" : "TRASH"


// =====================================================
// =================== ZONE STORAGE =====================
// =====================================================
var array<float> sd_zTop   = array.new_float()
var array<float> sd_zBot   = array.new_float()
var array<int>   sd_zType  = array.new_int()   // +1 supply, -1 demand
var array<int>   sd_zTouch = array.new_int()
var array<int>   sd_zSrc   = array.new_int()   // 1=Chart TF, 2=HTF
var array<int>   sd_zBornT = array.new_int()

var array<box>   sd_zBox   = array.new_box()
var array<label> sd_zLbl   = array.new_label()

var array<float> sd_zScore      = array.new_float()
var array<int>   sd_zGrade      = array.new_int()
var array<int>   sd_zTouchStart = array.new_int()
var array<float> sd_zEntryRef   = array.new_float()
var array<float> sd_zBestMove   = array.new_float()
var array<float> sd_zMaxPen     = array.new_float()
var array<bool>  sd_zEvalDone   = array.new_bool()


// =====================================================
// ================= ZONE DRAW / SYNC ===================
// =====================================================
sd_sync_box(idx) =>
    if idx >= 0 and idx < array.size(sd_zTop)
        box   b = array.get(sd_zBox, idx)
        label l = array.get(sd_zLbl, idx)

        float top  = array.get(sd_zTop, idx)
        float bot  = array.get(sd_zBot, idx)
        int   typ  = array.get(sd_zType, idx)
        int   tch  = array.get(sd_zTouch, idx)
        int   born = array.get(sd_zBornT, idx)
        int   src  = array.get(sd_zSrc, idx)

        bool confirmed = tch >= sd_minTouches
        bool enabledSrc = sd_showZones and (src == 1 ? (sd_on and sd_useChart) : (sd_on and sd_useHTF))

        int gr = sd_qUse ? array.get(sd_zGrade, idx) : 1
        bool isTrash = sd_qUse ? (gr == 0) : false
        if sd_qUse and sd_qHideTrash and isTrash
            enabledSrc := false

        color col = src == 1
             ? (typ == 1 ? (confirmed ? sd_colSupOk  : sd_colSup)  : (confirmed ? sd_colDemOk  : sd_colDem))
             : (typ == 1 ? (confirmed ? sd_colSup2Ok : sd_colSup2) : (confirmed ? sd_colDem2Ok : sd_colDem2))

        float pp = math.abs(sd_priceToPip(top - bot))
        string srcS = src == 1 ? "CT" : "HTF"
        string typS = typ == 1 ? "SUP" : "DEM"

        float sc = sd_qUse ? array.get(sd_zScore, idx) : na
        string gtxt = sd_qUse ? sd_grade_txt(gr) : ""

        string txt = typS + " " + sd_pp_str(pp) + "p | " + srcS + "\nT:" + str.tostring(tch) +
             (sd_qUse and sd_qShowGrade ? ("\nQ:" + str.tostring(sc, "#.0") + " " + gtxt) : "")

        color txtCol = src == 1 ? (typ == 1 ? color.red : color.lime) : (typ == 1 ? color.orange : color.teal)

        if not enabledSrc
            if not na(b)
                box.delete(b)
                array.set(sd_zBox, idx, na)
            if not na(l)
                label.delete(l)
                array.set(sd_zLbl, idx, na)
        else
            if na(b)
                b := box.new(left=born, top=top, right=time, bottom=bot, xloc=xloc.bar_time, bgcolor=col, border_color=col)
                array.set(sd_zBox, idx, b)
            else
                box.set_left(b, born)
                box.set_right(b, time)
                box.set_top(b, top)
                box.set_bottom(b, bot)
                box.set_bgcolor(b, col)
                box.set_border_color(b, col)

            if sd_showZoneLabel
                float yMid = (top + bot) / 2.0
                if na(l)
                    l := label.new(time, yMid, txt, xloc=xloc.bar_time, style=label.style_label_left,
                        textcolor=txtCol, color=color.new(color.black, 100), size=sd_lbl_size(sd_zoneLblSizeS))
                    array.set(sd_zLbl, idx, l)
                else
                    label.set_x(l, time)
                    label.set_y(l, yMid)
                    label.set_text(l, txt)
                    label.set_textcolor(l, txtCol)
                    label.set_size(l, sd_lbl_size(sd_zoneLblSizeS))
            else
                if not na(l)
                    label.delete(l)
                    array.set(sd_zLbl, idx, na)


// =====================================================
// ==================== ZONE OPS ========================
// =====================================================
sd_delete_idx(idx) =>
    if idx >= 0 and idx < array.size(sd_zTop)
        box b = array.get(sd_zBox, idx)
        label l = array.get(sd_zLbl, idx)
        if not na(b)
            box.delete(b)
        if not na(l)
            label.delete(l)

        array.remove(sd_zTop, idx)
        array.remove(sd_zBot, idx)
        array.remove(sd_zType, idx)
        array.remove(sd_zTouch, idx)
        array.remove(sd_zSrc, idx)
        array.remove(sd_zBornT, idx)

        array.remove(sd_zBox, idx)
        array.remove(sd_zLbl, idx)

        array.remove(sd_zScore, idx)
        array.remove(sd_zGrade, idx)
        array.remove(sd_zTouchStart, idx)
        array.remove(sd_zEntryRef, idx)
        array.remove(sd_zBestMove, idx)
        array.remove(sd_zMaxPen, idx)
        array.remove(sd_zEvalDone, idx)

sd_add_zone(_top, _bot, _type, _src) =>
    if array.size(sd_zTop) >= sd_maxZones
        sd_delete_idx(0)

    array.push(sd_zTop, _top)
    array.push(sd_zBot, _bot)
    array.push(sd_zType, _type)
    array.push(sd_zTouch, 0)
    array.push(sd_zSrc, _src)
    array.push(sd_zBornT, time)

    array.push(sd_zBox, na)
    array.push(sd_zLbl, na)

    float depPP = (sd_qUse and _src == 1) ? sd_displacement_pp_chart(_type == 1) : 0.0
    float depScore = sd_qUse ? (sd_clamp(depPP / sd_qMinDepPP, 0.0, 1.0) * 55.0) : 0.0
    float impScore = sd_qUse ? (sd_useImp ? 25.0 : 10.0) : 0.0
    float baseScore = sd_qUse ? 10.0 : 0.0
    float s0 = sd_qUse ? sd_clamp(depScore + impScore + baseScore, 0.0, 100.0) : 0.0

    array.push(sd_zScore, s0)
    array.push(sd_zGrade, sd_qUse ? sd_grade(s0) : 1)
    array.push(sd_zTouchStart, -1)
    array.push(sd_zEntryRef, na)
    array.push(sd_zBestMove, 0.0)
    array.push(sd_zMaxPen, 0.0)
    array.push(sd_zEvalDone, false)

    sd_sync_box(array.size(sd_zTop) - 1)

sd_try_merge_close() =>
    int sizeA = array.size(sd_zTop)
    if sizeA >= 2
        for i = 0 to sizeA - 2
            if i < array.size(sd_zTop) - 1
                int j = i + 1
                if j >= array.size(sd_zTop)
                    break

                float topA = array.get(sd_zTop, i)
                float botA = array.get(sd_zBot, i)
                int typA   = array.get(sd_zType, i)
                int srcA   = array.get(sd_zSrc, i)
                int tchA   = array.get(sd_zTouch, i)
                int bornA  = array.get(sd_zBornT, i)

                float topB = array.get(sd_zTop, j)
                float botB = array.get(sd_zBot, j)
                int typB   = array.get(sd_zType, j)
                int srcB   = array.get(sd_zSrc, j)
                int tchB   = array.get(sd_zTouch, j)
                int bornB  = array.get(sd_zBornT, j)

                if typA == typB and srcA == srcB
                    float gapPP = math.abs(sd_priceToPip(math.max(botA, botB) - math.min(topA, topB)))
                    if gapPP <= sd_mergeDistPP
                        float newTop  = math.max(topA, topB)
                        float newBot  = math.min(botA, botB)
                        int   newTch  = tchA + tchB
                        int   newBorn = math.min(bornA, bornB)

                        box bJ = array.get(sd_zBox, j)
                        label lJ = array.get(sd_zLbl, j)
                        if not na(bJ)
                            box.delete(bJ)
                        if not na(lJ)
                            label.delete(lJ)

                        float scoreA = array.get(sd_zScore, i)
                        float scoreB = array.get(sd_zScore, j)
                        float newScore = sd_clamp(math.max(scoreA, scoreB) - 5.0, 0.0, 100.0)

                        array.set(sd_zTop, i, newTop)
                        array.set(sd_zBot, i, newBot)
                        array.set(sd_zTouch, i, newTch)
                        array.set(sd_zBornT, i, newBorn)

                        array.set(sd_zBox, i, na)
                        array.set(sd_zLbl, i, na)

                        array.set(sd_zScore, i, newScore)
                        array.set(sd_zGrade, i, sd_qUse ? sd_grade(newScore) : 1)

                        sd_delete_idx(j)
                        sd_sync_box(i)
                        break

sd_is_touched(idx) =>
    float top = array.get(sd_zTop, idx)
    float bot = array.get(sd_zBot, idx)

    bool wickTouch = (high >= bot and low <= top)
    float hiBody = math.max(open, close)
    float loBody = math.min(open, close)
    bool bodyTouch = (hiBody >= bot and loBody <= top)

    (sd_useWicks and wickTouch) or (sd_useBodies and bodyTouch)

sd_is_broken(idx) =>
    float top = array.get(sd_zTop, idx)
    float bot = array.get(sd_zBot, idx)
    int typ   = array.get(sd_zType, idx)
    float buf = sd_pipToPrice(sd_brkBufPP)
    typ == 1 ? (close > top + buf) : (close < bot - buf)


// =====================================================
// ================= BUILD ZONES ========================
// =====================================================
bool sd_hasHTF = sd_srcTF != ""

sd_phCT = (sd_on and sd_useChart) ? ta.pivothigh(high, sd_leftBars, sd_rightBars) : na
sd_plCT = (sd_on and sd_useChart) ? ta.pivotlow(low,  sd_leftBars, sd_rightBars)  : na

sd_phHTF = (sd_on and sd_useHTF and sd_hasHTF) ? request.security(syminfo.tickerid, sd_srcTF,
    ta.pivothigh(high, sd_leftBars, sd_rightBars),
    barmerge.gaps_off, barmerge.lookahead_off) : na

sd_plHTF = (sd_on and sd_useHTF and sd_hasHTF) ? request.security(syminfo.tickerid, sd_srcTF,
    ta.pivotlow(low, sd_leftBars, sd_rightBars),
    barmerge.gaps_off, barmerge.lookahead_off) : na

sd_impPH_HTF = (sd_on and sd_useHTF and sd_hasHTF and sd_useImp) ? request.security(syminfo.tickerid, sd_srcTF,
    sd_htf_pivot_imp_ok(true),
    barmerge.gaps_off, barmerge.lookahead_off) : true

sd_impPL_HTF = (sd_on and sd_useHTF and sd_hasHTF and sd_useImp) ? request.security(syminfo.tickerid, sd_srcTF,
    sd_htf_pivot_imp_ok(false),
    barmerge.gaps_off, barmerge.lookahead_off) : true

bool sd_newPH_CT  = sd_on and sd_useChart and not na(sd_phCT)
bool sd_newPL_CT  = sd_on and sd_useChart and not na(sd_plCT)
bool sd_newPH_HTF = sd_on and sd_useHTF and sd_hasHTF and not na(sd_phHTF)
bool sd_newPL_HTF = sd_on and sd_useHTF and sd_hasHTF and not na(sd_plHTF)

float sd_pad = sd_pipToPrice(sd_zonePadPP)

// alert flags
var bool sd_aNewSup   = false
var bool sd_aNewDem   = false
var bool sd_aConfSup  = false
var bool sd_aConfDem  = false
var bool sd_aTouchSup = false
var bool sd_aTouchDem = false
var bool sd_aBrkSup   = false
var bool sd_aBrkDem   = false

sd_aNewSup := false
sd_aNewDem := false
sd_aConfSup := false
sd_aConfDem := false
sd_aTouchSup := false
sd_aTouchDem := false
sd_aBrkSup := false
sd_aBrkDem := false

if sd_newPH_CT
    if (not sd_useImp) or sd_impOkSup_CT
        sd_add_zone(sd_phCT + sd_pad, sd_phCT - sd_pad, +1, 1)
        sd_aNewSup := true

if sd_newPL_CT
    if (not sd_useImp) or sd_impOkDem_CT
        sd_add_zone(sd_plCT + sd_pad, sd_plCT - sd_pad, -1, 1)
        sd_aNewDem := true

if sd_newPH_HTF
    if (not sd_useImp) or sd_impPH_HTF
        sd_add_zone(sd_phHTF + sd_pad, sd_phHTF - sd_pad, +1, 2)
        sd_aNewSup := true

if sd_newPL_HTF
    if (not sd_useImp) or sd_impPL_HTF
        sd_add_zone(sd_plHTF + sd_pad, sd_plHTF - sd_pad, -1, 2)
        sd_aNewDem := true

if sd_on
    sd_try_merge_close()

if sd_on
    for idx = array.size(sd_zTop) - 1 to 0
        if idx >= 0 and idx < array.size(sd_zTop)
            if sd_is_broken(idx)
                int typ = array.get(sd_zType, idx)
                if typ == 1
                    sd_aBrkSup := true
                else
                    sd_aBrkDem := true
                sd_delete_idx(idx)
            else
                if sd_is_touched(idx)
                    int prevT = array.get(sd_zTouch, idx)
                    int newT  = prevT + 1
                    array.set(sd_zTouch, idx, newT)

                    int typ = array.get(sd_zType, idx)
                    if typ == 1
                        sd_aTouchSup := true
                    else
                        sd_aTouchDem := true

                    if prevT < sd_minTouches and newT >= sd_minTouches
                        if typ == 1
                            sd_aConfSup := true
                        else
                            sd_aConfDem := true

                    if sd_qUse
                        float topQ = array.get(sd_zTop, idx)
                        float botQ = array.get(sd_zBot, idx)
                        int   typQ = array.get(sd_zType, idx)

                        int ts = array.get(sd_zTouchStart, idx)
                        if ts == -1
                            array.set(sd_zTouchStart, idx, bar_index)
                            array.set(sd_zEntryRef, idx, (topQ + botQ) / 2.0)
                            array.set(sd_zBestMove, idx, 0.0)
                            array.set(sd_zMaxPen, idx, 0.0)
                            array.set(sd_zEvalDone, idx, false)

                        float pen = sd_penetration(typQ, topQ, botQ)
                        float prevPen = array.get(sd_zMaxPen, idx)
                        array.set(sd_zMaxPen, idx, math.max(prevPen, pen))

                if sd_qUse
                    int ts2 = array.get(sd_zTouchStart, idx)
                    bool done = array.get(sd_zEvalDone, idx)
                    if ts2 != -1 and not done
                        float entryRef = array.get(sd_zEntryRef, idx)
                        float bestMove = array.get(sd_zBestMove, idx)
                        int typQ2 = array.get(sd_zType, idx)

                        if (bar_index - ts2) <= sd_qReactBars
                            bestMove := sd_update_best_move(typQ2, entryRef, bestMove)
                            array.set(sd_zBestMove, idx, bestMove)
                        else
                            float reactPP = sd_priceToPip(bestMove)
                            float reactScore = sd_clamp(reactPP / sd_qMinReactPP, 0.0, 1.0) * 30.0

                            float penMax = array.get(sd_zMaxPen, idx)
                            float penScore = sd_clamp((sd_qMaxPenPct - penMax) / sd_qMaxPenPct, 0.0, 1.0) * 25.0

                            int touchesNow = array.get(sd_zTouch, idx)
                            float touchPenalty = math.max(0.0, (touchesNow - 1) * sd_qTouchPenalty)

                            float sPrev = array.get(sd_zScore, idx)
                            float sNew  = sd_clamp(sPrev + reactScore + penScore - touchPenalty, 0.0, 100.0)

                            array.set(sd_zScore, idx, sNew)
                            array.set(sd_zGrade, idx, sd_grade(sNew))
                            array.set(sd_zEvalDone, idx, true)

                sd_sync_box(idx)


// =====================================================
// ====================== ALERTS ========================
// =====================================================
alertcondition(sd_on and sd_aNewSup,   title="SD - New Supply Zone",       message="SD_NEW_SUPPLY_ZONE")
alertcondition(sd_on and sd_aNewDem,   title="SD - New Demand Zone",       message="SD_NEW_DEMAND_ZONE")
alertcondition(sd_on and sd_aConfSup,  title="SD - Confirmed Supply Zone", message="SD_CONFIRMED_SUPPLY")
alertcondition(sd_on and sd_aConfDem,  title="SD - Confirmed Demand Zone", message="SD_CONFIRMED_DEMAND")
alertcondition(sd_on and sd_aTouchSup, title="SD - Supply Zone Touched",   message="SD_TOUCH_SUPPLY")
alertcondition(sd_on and sd_aTouchDem, title="SD - Demand Zone Touched",   message="SD_TOUCH_DEMAND")
alertcondition(sd_on and sd_aBrkSup,   title="SD - Supply Zone Broken",    message="SD_BREAK_SUPPLY")
alertcondition(sd_on and sd_aBrkDem,   title="SD - Demand Zone Broken",    message="SD_BREAK_DEMAND")


// =====================================================
// =========== SIM: PICK FIRST TOUCH ZONE ==============
// =====================================================
sim_pick_first_touch_zone(_typeWanted) =>
    int bestIdx = -1
    float bestScore = -1.0
    int minG = sim_min_grade(sim_minGrade)

    for k = 0 to array.size(sd_zTop) - 1
        if k >= 0 and k < array.size(sd_zTop)
            int typ = array.get(sd_zType, k)
            if typ != _typeWanted
                continue

            int src = array.get(sd_zSrc, k)
            bool srcOk = src == 1 ? (sd_on and sd_useChart) : (sd_on and sd_useHTF)
            if sim_onlyChartTF and src != 1
                srcOk := false
            if not srcOk
                continue

            int touches = array.get(sd_zTouch, k)
            bool firstTouch = (touches == 1) and sd_is_touched(k)
            if not firstTouch
                continue

            int g = sd_qUse ? array.get(sd_zGrade, k) : 1
            bool gradeOk = (not sd_qUse) or (g >= minG)
            if not gradeOk
                continue

            bool trashOk = not (sd_qUse and sd_qHideTrash and g == 0)
            if not trashOk
                continue

            float sc = sd_qUse ? array.get(sd_zScore, k) : 50.0
            if sc > bestScore
                bestScore := sc
                bestIdx := k

    bestIdx

sim_sl_price(_isLong, _entry) =>
    float d = sd_pipToPrice(sim_slPP)
    _isLong ? (_entry - d) : (_entry + d)

sim_tp_price(_isLong, _entry) =>
    float d = sd_pipToPrice(sim_slPP) * sim_rr
    _isLong ? (_entry + d) : (_entry - d)


// =====================================================
// ================= TRADE VISUAL STORAGE ===============
// =====================================================
var array<line>  histEntryLines = array.new_line()
var array<line>  histSLLines    = array.new_line()
var array<line>  histTPLines    = array.new_line()
var array<box>   histTPBoxes    = array.new_box()
var array<box>   histSLBoxes    = array.new_box()
var array<label> histEntryLabs  = array.new_label()
var array<label> histExitLabs   = array.new_label()

vis_prune_history() =>
    while array.size(histEntryLines) > vis_keepTrades
        f_delete_line(array.shift(histEntryLines))
        f_delete_line(array.shift(histSLLines))
        f_delete_line(array.shift(histTPLines))
        f_delete_box(array.shift(histTPBoxes))
        f_delete_box(array.shift(histSLBoxes))
        f_delete_label(array.shift(histEntryLabs))
        f_delete_label(array.shift(histExitLabs))


// =====================================================
// ====================== STATE =========================
// =====================================================
var int   sim_pos      = 0
var float sim_entryP   = na
var float sim_slP      = na
var float sim_tpP      = na
var int   sim_entryBar = na

var line  sim_lnE = na
var line  sim_lnS = na
var line  sim_lnT = na

var box sim_boxTP = na
var box sim_boxSL = na

var bool sim_exitSent = false

// =================== STATS ===================
var int   sim_trades  = 0
var int   sim_wins    = 0
var int   sim_losses  = 0
var float sim_sumWinR = 0.0
var float sim_sumLosR = 0.0
var float sim_sumR    = 0.0

var float sim_eqR      = 0.0
var float sim_peakR    = 0.0
var float sim_maxDD_R  = 0.0

var int sim_consecTP = 0
var int sim_consecSL = 0
var int sim_maxConsecTP = 0
var int sim_maxConsecSL = 0

var table sim_tbl = na
if sim_showStats and barstate.isfirst
    sim_tbl := table.new(sim_pos_from_str(sim_statsPosStr), 2, 12, border_width=1)

// =================== DAILY STORAGE ===================
var table sim_dailyTbl = na
var array<int>   sim_dayTS   = array.new_int()
var array<float> sim_dayR    = array.new_float()
var array<float> sim_dayPips = array.new_float()

var int   sim_curDayTS = na
var float sim_curDayR  = 0.0
var float sim_curDayP  = 0.0

if sim_showDaily and barstate.isfirst
    sim_dailyTbl := table.new(sim_pos_from_str(sim_dailyPosStr), 3, sim_dailyDays + 1, border_width=1)


// =====================================================
// ====================== MAIN SIM ======================
// =====================================================
bool sim_canWork = sim_on and sd_on and barstate.isconfirmed

if sim_showDaily
    int dts = sim_day_start_ts()

    if na(sim_curDayTS)
        sim_curDayTS := dts

    if dts != sim_curDayTS
        array.push(sim_dayTS, sim_curDayTS)
        array.push(sim_dayR, sim_curDayR)
        array.push(sim_dayPips, sim_curDayP)

        while array.size(sim_dayTS) > sim_dailyDays
            array.shift(sim_dayTS)
            array.shift(sim_dayR)
            array.shift(sim_dayPips)

        sim_curDayTS := dts
        sim_curDayR  := 0.0
        sim_curDayP  := 0.0

int sim_longIdx  = (sim_canWork and sim_pos == 0) ? sim_pick_first_touch_zone(-1) : -1
int sim_shortIdx = (sim_canWork and sim_pos == 0) ? sim_pick_first_touch_zone(+1) : -1

bool sim_longSig  = sim_longIdx  != -1
bool sim_shortSig = sim_shortIdx != -1


// =====================================================
// ==================== SIGNAL ALERTS ===================
// =====================================================
bool buySignal  = sim_canWork and sim_pos == 0 and sim_longSig
bool sellSignal = sim_canWork and sim_pos == 0 and sim_shortSig

alertcondition(buySignal,
     title="BUY Signal (First Touch)",
     message='{"token":"spanchi-secret-123","ticker":"{{ticker}}","action":"BUY","event":"ENTRY","event_time":"{{timenow}}","tf":"{{interval}}","bar_time":"{{time}}"}')

alertcondition(sellSignal,
     title="SELL Signal (First Touch)",
     message='{"token":"spanchi-secret-123","ticker":"{{ticker}}","action":"SELL","event":"ENTRY","event_time":"{{timenow}}","tf":"{{interval}}","bar_time":"{{time}}"}')


// =====================================================
// ===================== ENTRY LOGIC ====================
// =====================================================
bool didEnter = false

if sim_canWork and sim_pos == 0 and sim_longSig
    sim_pos      := +1
    sim_entryP   := close
    sim_slP      := sim_sl_price(true, sim_entryP)
    sim_tpP      := sim_tp_price(true, sim_entryP)
    sim_entryBar := bar_index
    didEnter := true

    label entryLb = na
    if sim_showMarks
        entryLb := label.new(
            bar_index, low,
            "BUY\nFirst Touch\nE: " + str.tostring(sim_entryP) + "\nSL: " + str.tostring(sim_slP) + "\nTP: " + str.tostring(sim_tpP),
            style=label.style_label_up,
            textcolor=color.white,
            color=color.new(#16a34a, 0),
            size=size.tiny
        )

    line le = na
    line ls = na
    line lt = na
    if sim_showLines
        le := line.new(bar_index, sim_entryP, bar_index + sim_extendBars, sim_entryP, color=LINE_ENTRY_COL, style=line.style_dotted, width=1)
        ls := line.new(bar_index, sim_slP,    bar_index + sim_extendBars, sim_slP,    color=LINE_SL_COL,    style=line.style_dashed, width=2)
        lt := line.new(bar_index, sim_tpP,    bar_index + sim_extendBars, sim_tpP,    color=LINE_TP_COL,    style=line.style_dashed, width=2)

    box tpBx = na
    box slBx = na
    if sim_showBoxes
        float tpTop = math.max(sim_entryP, sim_tpP)
        float tpBot = math.min(sim_entryP, sim_tpP)
        float slTop = math.max(sim_entryP, sim_slP)
        float slBot = math.min(sim_entryP, sim_slP)

        color brTP = sim_boxBorder ? sim_tpBorderCol : color.new(sim_tpBorderCol, 100)
        color brSL = sim_boxBorder ? sim_slBorderCol : color.new(sim_slBorderCol, 100)

        tpBx := box.new(left=bar_index, top=tpTop, right=bar_index + sim_extendBars, bottom=tpBot, xloc=xloc.bar_index, bgcolor=sim_tpBoxCol, border_color=brTP)
        slBx := box.new(left=bar_index, top=slTop, right=bar_index + sim_extendBars, bottom=slBot, xloc=xloc.bar_index, bgcolor=sim_slBoxCol, border_color=brSL)

    sim_lnE := le
    sim_lnS := ls
    sim_lnT := lt
    sim_boxTP := tpBx
    sim_boxSL := slBx

    array.push(histEntryLines, le)
    array.push(histSLLines, ls)
    array.push(histTPLines, lt)
    array.push(histTPBoxes, tpBx)
    array.push(histSLBoxes, slBx)
    array.push(histEntryLabs, entryLb)
    array.push(histExitLabs, na)
    vis_prune_history()

if sim_canWork and sim_pos == 0 and sim_shortSig
    sim_pos      := -1
    sim_entryP   := close
    sim_slP      := sim_sl_price(false, sim_entryP)
    sim_tpP      := sim_tp_price(false, sim_entryP)
    sim_entryBar := bar_index
    didEnter := true

    label entryLb = na
    if sim_showMarks
        entryLb := label.new(
            bar_index, high,
            "SELL\nFirst Touch\nE: " + str.tostring(sim_entryP) + "\nSL: " + str.tostring(sim_slP) + "\nTP: " + str.tostring(sim_tpP),
            style=label.style_label_down,
            textcolor=color.white,
            color=color.new(#dc2626, 0),
            size=size.tiny
        )

    line le = na
    line ls = na
    line lt = na
    if sim_showLines
        le := line.new(bar_index, sim_entryP, bar_index + sim_extendBars, sim_entryP, color=LINE_ENTRY_COL, style=line.style_dotted, width=1)
        ls := line.new(bar_index, sim_slP,    bar_index + sim_extendBars, sim_slP,    color=LINE_SL_COL,    style=line.style_dashed, width=2)
        lt := line.new(bar_index, sim_tpP,    bar_index + sim_extendBars, sim_tpP,    color=LINE_TP_COL,    style=line.style_dashed, width=2)

    box tpBx = na
    box slBx = na
    if sim_showBoxes
        float tpTop = math.max(sim_entryP, sim_tpP)
        float tpBot = math.min(sim_entryP, sim_tpP)
        float slTop = math.max(sim_entryP, sim_slP)
        float slBot = math.min(sim_entryP, sim_slP)

        color brTP = sim_boxBorder ? sim_tpBorderCol : color.new(sim_tpBorderCol, 100)
        color brSL = sim_boxBorder ? sim_slBorderCol : color.new(sim_slBorderCol, 100)

        tpBx := box.new(left=bar_index, top=tpTop, right=bar_index + sim_extendBars, bottom=tpBot, xloc=xloc.bar_index, bgcolor=sim_tpBoxCol, border_color=brTP)
        slBx := box.new(left=bar_index, top=slTop, right=bar_index + sim_extendBars, bottom=slBot, xloc=xloc.bar_index, bgcolor=sim_slBoxCol, border_color=brSL)

    sim_lnE := le
    sim_lnS := ls
    sim_lnT := lt
    sim_boxTP := tpBx
    sim_boxSL := slBx

    array.push(histEntryLines, le)
    array.push(histSLLines, ls)
    array.push(histTPLines, lt)
    array.push(histTPBoxes, tpBx)
    array.push(histSLBoxes, slBx)
    array.push(histEntryLabs, entryLb)
    array.push(histExitLabs, na)
    vis_prune_history()

if didEnter
    sim_exitSent := false

if sim_pos != 0
    if sim_showLines
        if not na(sim_lnE)
            line.set_x2(sim_lnE, bar_index + sim_extendBars)
        if not na(sim_lnS)
            line.set_x2(sim_lnS, bar_index + sim_extendBars)
        if not na(sim_lnT)
            line.set_x2(sim_lnT, bar_index + sim_extendBars)
    if sim_showBoxes
        if not na(sim_boxTP)
            box.set_right(sim_boxTP, bar_index + sim_extendBars)
        if not na(sim_boxSL)
            box.set_right(sim_boxSL, bar_index + sim_extendBars)


// =====================================================
// ====================== EXIT LOGIC ====================
// =====================================================
bool sim_canExit_tick = sim_on and sd_on and sim_pos != 0 and not na(sim_entryBar) and (bar_index > sim_entryBar) and (not sim_exitSent)
bool  sim_exitNow   = false
float sim_exitPrice = na
float sim_rMul      = na
string sim_exitTag  = ""

if sim_canExit_tick and sim_pos == +1
    bool hitSL = low <= sim_slP
    bool hitTP = high >= sim_tpP
    if hitSL or hitTP
        sim_exitNow := true
        bool win = hitTP and not hitSL
        sim_exitPrice := win ? sim_tpP : sim_slP
        sim_exitTag   := win ? "TP HIT 🎯" : "SL HIT ⛔"

        float risk = math.abs(sim_entryP - sim_slP)
        sim_rMul := risk > 0 ? (sim_exitPrice - sim_entryP) / risk : 0.0

if sim_canExit_tick and sim_pos == -1
    bool hitSL = high >= sim_slP
    bool hitTP = low  <= sim_tpP
    if hitSL or hitTP
        sim_exitNow := true
        bool win = hitTP and not hitSL
        sim_exitPrice := win ? sim_tpP : sim_slP
        sim_exitTag   := win ? "TP HIT 🎯" : "SL HIT ⛔"

        float risk = math.abs(sim_entryP - sim_slP)
        sim_rMul := risk > 0 ? (sim_entryP - sim_exitPrice) / risk : 0.0

if sim_exitNow and not na(sim_rMul)
    sim_exitSent := true

    string msg = '{"token":"spanchi-secret-123","ticker":"' + syminfo.ticker + '","action":"EXIT","event_time":"' + str.tostring(timenow) + '","tf":"' + timeframe.period + '","bar_time":"' + str.tostring(time) + '"}'
    alert(msg, alert.freq_once_per_bar)

    label exitLb = na
    if sim_showMarks
        exitLb := label.new(
            bar_index, sim_exitPrice, sim_exitTag,
            style=sim_rMul > 0 ? label.style_label_up : label.style_label_down,
            textcolor=color.white,
            color=sim_rMul > 0 ? color.new(#16a34a, 0) : color.new(#dc2626, 0),
            size=size.tiny
        )

    if array.size(histExitLabs) > 0
        array.set(histExitLabs, array.size(histExitLabs) - 1, exitLb)

    // freeze current visuals at exit bar
    if not na(sim_lnE)
        line.set_x2(sim_lnE, bar_index)
    if not na(sim_lnS)
        line.set_x2(sim_lnS, bar_index)
    if not na(sim_lnT)
        line.set_x2(sim_lnT, bar_index)
    if not na(sim_boxTP)
        box.set_right(sim_boxTP, bar_index)
    if not na(sim_boxSL)
        box.set_right(sim_boxSL, bar_index)

    // stats
    sim_trades += 1
    sim_sumR   += sim_rMul

    if sim_rMul > 0
        sim_wins += 1
        sim_sumWinR += sim_rMul
        sim_consecTP += 1
        sim_consecSL := 0
        sim_maxConsecTP := math.max(sim_maxConsecTP, sim_consecTP)
    else
        sim_losses += 1
        sim_sumLosR += math.abs(sim_rMul)
        sim_consecSL += 1
        sim_consecTP := 0
        sim_maxConsecSL := math.max(sim_maxConsecSL, sim_consecSL)

    sim_eqR += sim_rMul
    sim_peakR := math.max(sim_peakR, sim_eqR)
    float dd = sim_peakR - sim_eqR
    sim_maxDD_R := math.max(sim_maxDD_R, dd)

    if sim_showDaily
        sim_curDayR += sim_rMul
        sim_curDayP += sim_rMul * sim_slPP

    // reset active state
    sim_pos := 0
    sim_entryP := na
    sim_slP := na
    sim_tpP := na
    sim_entryBar := na
    sim_lnE := na
    sim_lnS := na
    sim_lnT := na
    sim_boxTP := na
    sim_boxSL := na


// =====================================================
// ================= PERFORMANCE PANEL ==================
// =====================================================
if sim_showStats and not na(sim_tbl)
    float winrate = sim_trades > 0 ? (sim_wins * 100.0 / sim_trades) : na
    float pf      = sim_sumLosR > 0 ? (sim_sumWinR / sim_sumLosR) : na
    float avgR    = sim_trades > 0 ? (sim_sumR / sim_trades) : na
    float netPips = sim_sumR * sim_slPP

    string statusText = sim_pos == 1 ? "BUY LIVE" : sim_pos == -1 ? "SELL LIVE" : "FLAT"
    color statusColor = sim_pos == 1 ? COL_POS : sim_pos == -1 ? COL_NEG : COL_FLAT

    f_cell(sim_tbl, 0, 0, "METRIC", COL_TXT, COL_BG_3)
    f_cell(sim_tbl, 1, 0, "VALUE",  COL_ACCENT, COL_BG_3)

    f_cell(sim_tbl, 0, 1, "Status", COL_MUTED, f_metric_label_bg())
    f_cell(sim_tbl, 1, 1, statusText, statusColor, f_metric_value_bg())

    f_cell(sim_tbl, 0, 2, "Trades", COL_MUTED, f_metric_label_bg())
    f_cell(sim_tbl, 1, 2, str.tostring(sim_trades), COL_TXT, f_metric_value_bg())

    f_cell(sim_tbl, 0, 3, "Wins / Losses", COL_MUTED, f_metric_label_bg())
    f_cell(sim_tbl, 1, 3, str.tostring(sim_wins) + " / " + str.tostring(sim_losses), COL_TXT, f_metric_value_bg())

    f_cell(sim_tbl, 0, 4, "Win Rate", COL_MUTED, f_metric_label_bg())
    f_cell(sim_tbl, 1, 4, fmt1(winrate) + "%", f_perf_color(winrate - 50), f_metric_value_bg())

    f_cell(sim_tbl, 0, 5, "Profit Factor", COL_MUTED, f_metric_label_bg())
    f_cell(sim_tbl, 1, 5, fmt2(pf), f_perf_color(na(pf) ? na : pf - 1), f_metric_value_bg())

    f_cell(sim_tbl, 0, 6, "Net Result (R)", COL_MUTED, f_metric_label_bg())
    f_cell(sim_tbl, 1, 6, fmt2(sim_sumR), f_perf_color(sim_sumR), f_metric_value_bg())

    f_cell(sim_tbl, 0, 7, "Average / Trade (R)", COL_MUTED, f_metric_label_bg())
    f_cell(sim_tbl, 1, 7, fmt2(avgR), f_perf_color(avgR), f_metric_value_bg())

    f_cell(sim_tbl, 0, 8, "Max Drawdown (R)", COL_MUTED, f_metric_label_bg())
    f_cell(sim_tbl, 1, 8, fmt2(sim_maxDD_R), sim_maxDD_R > 0 ? COL_WARN : COL_FLAT, f_metric_value_bg())

    f_cell(sim_tbl, 0, 9, "Net Pips", COL_MUTED, f_metric_label_bg())
    f_cell(sim_tbl, 1, 9, fmt1(netPips), f_perf_color(netPips), f_metric_value_bg())

    f_cell(sim_tbl, 0, 10, "Best TP Streak", COL_MUTED, f_metric_label_bg())
    f_cell(sim_tbl, 1, 10, str.tostring(sim_maxConsecTP), COL_POS, f_metric_value_bg())

    f_cell(sim_tbl, 0, 11, "Best SL Streak", COL_MUTED, f_metric_label_bg())
    f_cell(sim_tbl, 1, 11, str.tostring(sim_maxConsecSL), COL_NEG, f_metric_value_bg())


// =====================================================
// =================== DAILY PNL PANEL ==================
// =====================================================
if sim_showDaily and not na(sim_dailyTbl)
    f_cell(sim_dailyTbl, 0, 0, "DATE (GMT+3)", COL_TXT, COL_BG_3)
    f_cell(sim_dailyTbl, 1, 0, "PnL (R)",      COL_ACCENT, COL_BG_3)
    f_cell(sim_dailyTbl, 2, 0, "PnL (Pips)",   COL_ACCENT, COL_BG_3)

    for row = 1 to sim_dailyDays
        f_cell(sim_dailyTbl, 0, row, "", COL_TXT, COL_BG_1)
        f_cell(sim_dailyTbl, 1, row, "", COL_TXT, COL_BG_1)
        f_cell(sim_dailyTbl, 2, row, "", COL_TXT, COL_BG_1)

    string tStr = na(sim_curDayTS) ? "NA" : dateStrFromTS(sim_curDayTS)
    color bgT = sim_curDayR >= 0 ? color.new(#14532d, 0) : color.new(#7f1d1d, 0)

    f_cell(sim_dailyTbl, 0, 1, tStr + " (Today)", COL_TXT, bgT)
    f_cell(sim_dailyTbl, 1, 1, fmt2(sim_curDayR), f_perf_color(sim_curDayR), bgT)
    f_cell(sim_dailyTbl, 2, 1, fmt1(sim_curDayP), f_perf_color(sim_curDayP), bgT)

    int n = array.size(sim_dayTS)
    if n > 0
        int maxShow = math.min(sim_dailyDays - 1, n)
        for i = 0 to maxShow - 1
            int idx = (n - 1) - i
            int row = i + 2

            int dts2 = array.get(sim_dayTS, idx)
            float dR = array.get(sim_dayR, idx)
            float dP = array.get(sim_dayPips, idx)

            string dStr = dateStrFromTS(dts2)
            color bg = dR >= 0 ? color.new(#052e16, 0) : color.new(#450a0a, 0)

            f_cell(sim_dailyTbl, 0, row, dStr, COL_TXT, bg)
            f_cell(sim_dailyTbl, 1, row, fmt2(dR), f_perf_color(dR), bg)
            f_cell(sim_dailyTbl, 2, row, fmt1(dP), f_perf_color(dP), bg)
