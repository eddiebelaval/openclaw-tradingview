//@version=6

//======================================================
// 
// Description:
// Based on price volatility and moving average system,
// identifies stock strength and market launch signals.
// 
// Signal Levels (strengthScore 0-9):
// Level 1 (>0): Watch Signal - Start monitoring
// Level 2 (>1): Rebound Signal - Rebound starting
// Level 3 (>2): Market Signal - Market activity detected
// Level 4 (>3): Market Signal - Confirmed market activity
// Level 5 (>4): Strength Signal - Stock strengthening
// Level 6 (>5): Main Rally - Main upward wave
// Level 7 (>6): Bull/Monster - Strong bull or monster stock
// Level 8 (>7): Bull/Monster - Very strong momentum
// Level 9 (>8): Bull/Monster - Maximum strength
//======================================================

indicator("[blackcat] L2 Napoleon Mille-feuille", shorttitle="L2 Napoleon", overlay=false, max_labels_count=500, max_bars_back=5000)

//======================================================
// Input Parameters
//======================================================
periodLength = input.int(38, "Period Length", minval=1, group="Settings")
showTable = input.bool(true, "Show Status Table", group="Display")
showBuySellLabels = input.bool(true, "Show Buy/Sell Labels", group="Display")
sellLabelThreshold = input.int(4, "Sell Label Threshold (Cross Above)", minval=1, maxval=8, group="Settings")
buyLabelThreshold = input.int(2, "Buy Label Threshold (Cross Below)", minval=1, maxval=8, group="Settings")

// Color theme inputs
colorWatchColor = input.color(color.yellow, "Watch Signal Color", group="Color Theme")
colorStrengthColor = input.color(color.red, "Strength Signal Color", group="Color Theme")
colorBuyLabel = input.color(color.lime, "Buy Label Color", group="Color Theme")
colorSellLabel = input.color(color.red, "Sell Label Color", group="Color Theme")
colorBgColor = input.color(color.new(color.gray, 85), "Background Color", group="Color Theme")

//======================================================
// Channel Calculations
//======================================================

// 25-period mid-price channels
// Original: ma(low+(high-low)/2, 25) = 25-period SMA of mid-price
midPrice25 = ta.sma((low + high) / 2, 25)

// Upper channel: mid-price × 1.15
upperChannel25 = midPrice25 * 1.15

// Lower channel: mid-price × 0.95
lowerChannel25 = midPrice25 * 0.95

// Mid channel: average of upper and lower
midChannel25 = (upperChannel25 + lowerChannel25) / 2

// 5-period MA bands
maClose5 = ta.sma(close, 5)
maOpen5 = ta.sma(open, 5)
midPrice5 = (maClose5 + maOpen5) / 2

// Upper band: mid-price × 1.06
upperBand5 = midPrice5 * 1.06

// Lower band: mid-price × 0.98
lowerBand5 = midPrice5 * 0.98

// Mid band: average of upper and lower
midBand5 = (upperBand5 + lowerBand5) / 2

//======================================================
// Condition Evaluation (9 conditions)
//======================================================

// Condition 1: Short upper band > Medium lower channel
cond1 = upperBand5 > lowerChannel25

// Condition 2: Short upper band > Medium mid channel
cond2 = upperBand5 > midChannel25

// Condition 3: Short upper band > Medium upper channel
cond3 = upperBand5 > upperChannel25

// Condition 4: Short mid band > Medium lower channel
cond4 = midBand5 > lowerChannel25

// Condition 5: Short mid band > Medium mid channel
cond5 = midBand5 > midChannel25

// Condition 6: Short mid band > Medium upper channel
cond6 = midBand5 > upperChannel25

// Condition 7: Short lower band > Medium lower channel
cond7 = lowerBand5 > lowerChannel25

// Condition 8: Short lower band > Medium mid channel
cond8 = lowerBand5 > midChannel25

// Condition 9: Short lower band > Medium upper channel
cond9 = lowerBand5 > upperChannel25

//======================================================
// Strength Score Calculation (0-9)
//======================================================

// Sum all conditions (each true condition adds 1)
strengthScore = (cond1 ? 1 : 0) + (cond2 ? 1 : 0) + (cond3 ? 1 : 0) + 
 (cond4 ? 1 : 0) + (cond5 ? 1 : 0) + (cond6 ? 1 : 0) + 
 (cond7 ? 1 : 0) + (cond8 ? 1 : 0) + (cond9 ? 1 : 0)

//======================================================
// Buy/Sell Label Signal Generation
//======================================================

// Sell label trigger: strengthScore crosses above threshold (overbought -> SELL)
sellLabelTrigger = ta.crossover(strengthScore, sellLabelThreshold)

// Buy label trigger: strengthScore crosses below threshold (oversold -> BUY)
buyLabelTrigger = ta.crossunder(strengthScore, buyLabelThreshold)

// Previous strength score for trend detection
prevStrengthScore = strengthScore[1]
isTrendingUp = strengthScore > prevStrengthScore
isTrendingDown = strengthScore < prevStrengthScore

//======================================================
// Visualization - Gradient Background Grid (Levels 1-10)
//======================================================

// Color gradient for background levels (green = safe, red = danger)
// Levels 1-2: Red tones (weak zone)
// Levels 3-4: Orange tones (watch zone)
// Levels 5-6: Yellow tones (strength zone)
// Levels 7-9: Green tones (bull zone)

// Background gradient colors with transparency
colorLevel1 = color.new(#ff4444, 85)  // Red - Weak
colorLevel2 = color.new(#ff6644, 85)  // Red-Orange
colorLevel3 = color.new(#ff8844, 85)  // Orange
colorLevel4 = color.new(#ffaa44, 85)  // Orange-Yellow
colorLevel5 = color.new(#ffcc44, 85)  // Yellow
colorLevel6 = color.new(#aadd44, 85)  // Yellow-Green
colorLevel7 = color.new(#66dd44, 85)  // Green
colorLevel8 = color.new(#44dd66, 85)  // Green
colorLevel9 = color.new(#44ddaa, 85)  // Green-Cyan
colorLevel10 = color.new(#44dddd, 85) // Cyan

// Draw gradient histogram bars for levels 1-10
plot(strengthScore >= 1 ? 1 : na, "Level 1", colorLevel1, style=plot.style_columns, linewidth=1)
plot(strengthScore >= 2 ? 2 : na, "Level 2", colorLevel2, style=plot.style_columns, linewidth=1)
plot(strengthScore >= 3 ? 3 : na, "Level 3", colorLevel3, style=plot.style_columns, linewidth=1)
plot(strengthScore >= 4 ? 4 : na, "Level 4", colorLevel4, style=plot.style_columns, linewidth=1)
plot(strengthScore >= 5 ? 5 : na, "Level 5", colorLevel5, style=plot.style_columns, linewidth=1)
plot(strengthScore >= 6 ? 6 : na, "Level 6", colorLevel6, style=plot.style_columns, linewidth=1)
plot(strengthScore >= 7 ? 7 : na, "Level 7", colorLevel7, style=plot.style_columns, linewidth=1)
plot(strengthScore >= 8 ? 8 : na, "Level 8", colorLevel8, style=plot.style_columns, linewidth=1)
plot(strengthScore >= 9 ? 9 : na, "Level 9", colorLevel9, style=plot.style_columns, linewidth=1)
plot(strengthScore >= 10 ? 10 : na, "Level 10", colorLevel10, style=plot.style_columns, linewidth=1)

//======================================================
// Reference Lines (Enhanced visibility)
//======================================================

// Horizontal reference lines with better styling
hline(5, "SELL Level", color=color.new(color.red, 30), linestyle=hline.style_dashed, linewidth=2)
hline(2, "BUY Level", color=color.new(color.lime, 30), linestyle=hline.style_dashed, linewidth=2)
hline(8, "TAKE PROFIT Level", color=color.new(#00ffff, 50), linestyle=hline.style_dotted, linewidth=1)

//======================================================
// Signal Markers (Multi-colored dots and triangles)
//======================================================

// Level 1: Watch Signal (yellow dot)
plotchar(strengthScore > 0 ? 1.5 : na, "Watch", "●", location.absolute, colorWatchColor, size=size.tiny)

// Level 2: Rebound Signal (yellow dot)
plotchar(strengthScore > 1 ? 2.5 : na, "Rebound", "●", location.absolute, colorWatchColor, size=size.tiny)

// Level 3: Market Signal (orange dot)
plotchar(strengthScore > 2 ? 3.5 : na, "Market1", "●", location.absolute, color.orange, size=size.tiny)

// Level 4: Market Signal (orange dot)
plotchar(strengthScore > 3 ? 4.5 : na, "Market2", "●", location.absolute, color.orange, size=size.tiny)

// Level 5: Strength Signal (red triangle)
plotchar(strengthScore > 4 ? 5.5 : na, "Strength", "▲", location.absolute, colorStrengthColor, size=size.tiny)

// Level 6: Main Rally (lime dot)
plotchar(strengthScore > 5 ? 6.5 : na, "Main Rally", "●", location.absolute, color.lime, size=size.tiny)

// Level 7: Bull/Monster (aqua dot)
plotchar(strengthScore > 6 ? 7.5 : na, "Bull1", "●", location.absolute, color.aqua, size=size.tiny)

// Level 8: Bull/Monster (fuchsia dot)
plotchar(strengthScore > 7 ? 8.5 : na, "Bull2", "●", location.absolute, color.fuchsia, size=size.tiny)

// Level 9: Bull/Monster (gold dot)
plotchar(strengthScore > 8 ? 9.5 : na, "Bull3", "●", location.absolute, color.yellow, size=size.tiny)

//======================================================
// Buy/Sell Labels
//======================================================

if showBuySellLabels
    // Sell label (red "S" label) - appears at TOP pointing DOWN to signal
    // Triggered when strength crosses above threshold (overbought condition)
    if sellLabelTrigger
        label.new(bar_index, 6, "S", color=colorSellLabel, textcolor=color.white,
                  style=label.style_label_down, size=size.normal)
    
    // Buy label (green "B" label) - appears at BOTTOM pointing UP to signal
    // Triggered when strength crosses below threshold (oversold condition)
    if buyLabelTrigger
        label.new(bar_index, 0, "B", color=colorBuyLabel, textcolor=color.white,
                  style=label.style_label_up, size=size.normal)

//======================================================
// Strength Score Line Plot
//======================================================

// Plot the strength score as a step line
plot(strengthScore, "Strength Score", color=color.new(color.white, 30), 
     style=plot.style_stepline, linewidth=2, trackprice=false)

//======================================================
// Status Table (Modern Enhanced Design)
//======================================================

if showTable and barstate.islast
    // Create status table with modern dark theme
    var table statusTable = table.new(position.top_right, 3, 14,
                                       bgcolor=color.new(#1a1a2e, 10),
                                       border_width=1, border_color=color.new(#4a4a6a, 50))
    
    // === Header Row with Gradient Effect ===
    headerColor = strengthScore >= 5 ? color.new(#00bf63, 30) : strengthScore >= 3 ? color.new(#ffc107, 30) : color.new(#dc3545, 30)
    table.cell(statusTable, 0, 0, "📊 Napoleon Status", text_color=color.white,
               bgcolor=headerColor, text_size=size.normal)
    table.merge_cells(statusTable, 0, 0, 2, 0)
    
    // === Score Section with Large Display ===
    table.cell(statusTable, 0, 1, "Score", text_color=#888888, text_size=size.small, bgcolor=color.new(#2d2d44, 30))
    scoreColor = strengthScore >= 5 ? #00ff88 : strengthScore >= 3 ? #ffdd00 : #ff4444
    scoreEmoji = strengthScore >= 7 ? "🚀" : strengthScore >= 5 ? "📈" : strengthScore >= 3 ? "👀" : "⬇️"
    table.cell(statusTable, 1, 1, scoreEmoji + " " + str.tostring(strengthScore) + "/9",
               text_color=scoreColor, text_size=size.normal, bgcolor=color.new(#2d2d44, 30))
    table.merge_cells(statusTable, 1, 1, 2, 1)
    
    // === Status Section ===
    table.cell(statusTable, 0, 2, "Status", text_color=#888888, text_size=size.small, bgcolor=color.new(#2d2d44, 30))
    signalStatus = strengthScore >= 7 ? "🔥 SUPER BULL" : strengthScore >= 6 ? "🐂 BULL" : strengthScore >= 5 ? "💪 STRONG" : strengthScore >= 4 ? "⚡ BUY ZONE" : strengthScore >= 2 ? "👀 WATCH" : "⬇️ WEAK"
    signalColor = strengthScore >= 7 ? #ff00ff : strengthScore >= 6 ? #00ffff : strengthScore >= 5 ? #00ff88 : strengthScore >= 4 ? #88ff00 : strengthScore >= 2 ? #ffaa00 : #ff4444
    table.cell(statusTable, 1, 2, signalStatus, text_color=signalColor, text_size=size.normal, bgcolor=color.new(#2d2d44, 30))
    table.merge_cells(statusTable, 1, 2, 2, 2)
    
    // === Trend Section ===
    table.cell(statusTable, 0, 3, "Trend", text_color=#888888, text_size=size.small, bgcolor=color.new(#2d2d44, 30))
    trendStatus = isTrendingUp ? "⬆️ UP" : isTrendingDown ? "⬇️ DOWN" : "➡️ FLAT"
    trendColor = isTrendingUp ? #00ff88 : isTrendingDown ? #ff4444 : #888888
    table.cell(statusTable, 1, 3, trendStatus, text_color=trendColor, text_size=size.small, bgcolor=color.new(#2d2d44, 30))
    table.merge_cells(statusTable, 1, 3, 2, 3)
    
    // === Divider ===
    table.cell(statusTable, 0, 4, "━━━━━━━━━━━━", text_color=#4a4a6a, text_size=size.tiny, bgcolor=color.new(#1a1a2e, 10))
    table.merge_cells(statusTable, 0, 4, 2, 4)
    
    // === Signal Levels Header ===
    table.cell(statusTable, 0, 5, "Lv", text_color=#888888, text_size=size.tiny, bgcolor=color.new(#2d2d44, 30))
    table.cell(statusTable, 1, 5, "Signal", text_color=#888888, text_size=size.tiny, bgcolor=color.new(#2d2d44, 30))
    table.cell(statusTable, 2, 5, "Status", text_color=#888888, text_size=size.tiny, bgcolor=color.new(#2d2d44, 30))
    
    // === Level 1-2: Watch Zone (Red/Orange) ===
    table.cell(statusTable, 0, 6, "1-2", text_color=#666666, text_size=size.tiny, bgcolor=color.new(#2d2d44, 50))
    table.cell(statusTable, 1, 6, "🔴 Watch", text_color=#ff6644, text_size=size.tiny, bgcolor=color.new(#2d2d44, 50))
    table.cell(statusTable, 2, 6, strengthScore > 1 ? "✅" : strengthScore > 0 ? "🔶" : "⭕",
               text_color=strengthScore > 1 ? #00ff88 : strengthScore > 0 ? #ffaa00 : #444444, text_size=size.tiny, bgcolor=color.new(#2d2d44, 50))
    
    // === Level 3-4: Market Zone (Orange/Yellow) ===
    table.cell(statusTable, 0, 7, "3-4", text_color=#666666, text_size=size.tiny, bgcolor=color.new(#2d2d44, 50))
    table.cell(statusTable, 1, 7, "🟠 Market", text_color=#ffaa00, text_size=size.tiny, bgcolor=color.new(#2d2d44, 50))
    table.cell(statusTable, 2, 7, strengthScore > 3 ? "✅" : strengthScore > 2 ? "🔶" : "⭕",
               text_color=strengthScore > 3 ? #00ff88 : strengthScore > 2 ? #ffaa00 : #444444, text_size=size.tiny, bgcolor=color.new(#2d2d44, 50))
    
    // === Level 5: Strength Zone (Yellow/Green) ===
    table.cell(statusTable, 0, 8, "5", text_color=#666666, text_size=size.tiny, bgcolor=color.new(#2d2d44, 50))
    table.cell(statusTable, 1, 8, "🟢 Strength", text_color=#88ff00, text_size=size.tiny, bgcolor=color.new(#2d2d44, 50))
    table.cell(statusTable, 2, 8, strengthScore > 4 ? "✅" : "⭕",
               text_color=strengthScore > 4 ? #00ff88 : #444444, text_size=size.tiny, bgcolor=color.new(#2d2d44, 50))
    
    // === Level 6: Main Rally (Green) ===
    table.cell(statusTable, 0, 9, "6", text_color=#666666, text_size=size.tiny, bgcolor=color.new(#2d2d44, 50))
    table.cell(statusTable, 1, 9, "🟢 Rally", text_color=#00ff88, text_size=size.tiny, bgcolor=color.new(#2d2d44, 50))
    table.cell(statusTable, 2, 9, strengthScore > 5 ? "✅" : "⭕",
               text_color=strengthScore > 5 ? #00ff88 : #444444, text_size=size.tiny, bgcolor=color.new(#2d2d44, 50))
    
    // === Level 7-9: Bull Zone (Cyan/Magenta) ===
    table.cell(statusTable, 0, 10, "7+", text_color=#666666, text_size=size.tiny, bgcolor=color.new(#2d2d44, 50))
    table.cell(statusTable, 1, 10, "🟣 Bull", text_color=#ff00ff, text_size=size.tiny, bgcolor=color.new(#2d2d44, 50))
    table.cell(statusTable, 2, 10, strengthScore > 6 ? "✅" : "⭕",
               text_color=strengthScore > 6 ? #ff00ff : #444444, text_size=size.tiny, bgcolor=color.new(#2d2d44, 50))
    
    // === Action Divider ===
    table.cell(statusTable, 0, 11, "━━━━━━━━━━━━", text_color=#4a4a6a, text_size=size.tiny, bgcolor=color.new(#1a1a2e, 10))
    table.merge_cells(statusTable, 0, 11, 2, 11)
    
    // === Action Recommendation ===
    table.cell(statusTable, 0, 12, "Action", text_color=#888888, text_size=size.small, bgcolor=color.new(#2d2d44, 30))
    actionText = strengthScore >= 7 ? "🎯 TAKE PROFIT!" : strengthScore >= 5 ? "🚀 HOLD/SELL" : strengthScore >= 4 ? "💰 WATCH" : strengthScore >= 2 ? "👀 BUY DIP" : "⏳ WAIT"
    actionColor = strengthScore >= 7 ? #ff00ff : strengthScore >= 5 ? #00ff88 : strengthScore >= 4 ? #88ff00 : strengthScore >= 2 ? #ffaa00 : #888888
    actionBgColor = strengthScore >= 5 ? color.new(#004422, 50) : color.new(#2d2d44, 30)
    table.cell(statusTable, 1, 12, actionText, text_color=actionColor, text_size=size.small, bgcolor=actionBgColor)
    table.merge_cells(statusTable, 1, 12, 2, 12)
    
    // === Last Signal Section ===
    table.cell(statusTable, 0, 13, "Last Sig", text_color=#888888, text_size=size.tiny, bgcolor=color.new(#2d2d44, 30))
    lastSignal = sellLabelTrigger ? "🔴 SELL" : buyLabelTrigger ? "🟢 BUY" : "—"
    lastSignalColor = sellLabelTrigger ? #ff4444 : buyLabelTrigger ? #00ff88 : #666666
    table.cell(statusTable, 1, 13, lastSignal, text_color=lastSignalColor, text_size=size.tiny, bgcolor=color.new(#2d2d44, 30))
    table.merge_cells(statusTable, 1, 13, 2, 13)

//======================================================
// Alert Conditions
//======================================================

// Alert for Sell Label (overbought condition)
alertcondition(sellLabelTrigger, "Sell Signal", "Napoleon: Sell Signal - Strength crossing above {{ticker}}")

// Alert for Buy Label (oversold condition)
alertcondition(buyLabelTrigger, "Buy Signal", "Napoleon: Buy Signal - Strength crossing below {{ticker}}")

// Alert for entering Bull Zone
alertcondition(strengthScore > 6 and strengthScore[1] <= 6, "Bull Zone Entry", 
               "Napoleon: Entering Bull Zone - {{ticker}}")

// Alert for high strength
alertcondition(strengthScore >= 8, "Max Strength", 
               "Napoleon: Maximum Strength (8+) - {{ticker}}")

//======================================================
// End of Script
//======================================================
