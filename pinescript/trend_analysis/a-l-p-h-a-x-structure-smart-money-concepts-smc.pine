// © AlphaX
//@version=6
indicator("AlphaX Structure – Smart Money Concepts BOS CHoCH & Liquidity", shorttitle="AlphaX Structure", overlay=true,
  max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=500)

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ THEME COLORS ══════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

color BULL_PRIMARY   = #c8e624
color BULL_BRIGHT    = #d4f03a
color BULL_DIM       = #9ab81c
color BEAR_PRIMARY   = #ff1744
color BEAR_BRIGHT    = #ff5252
color BEAR_DIM       = #d50032
color NEUTRAL        = #555555
color NEUTRAL_LIGHT  = #888888
color NEUTRAL_DARK   = #333333
color TEXT_LIGHT     = #cccccc
color TEXT_DARK      = #1a1a1a
color BG_DARK        = #1a1a1a

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ USER INPUTS ═══════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

// ── Structure Settings ─────────────────────────────────────────────────────────
swingLen        = input.int(5,     "Swing Detection Length",    minval=2,  maxval=20,  group="Structure")
showBOS         = input.bool(true, "Show Break of Structure",                          group="Structure")
showCHoCH       = input.bool(true, "Show Change of Character",                        group="Structure")
showSwingPoints = input.bool(false,"Show Swing Points",                                group="Structure")
maxStructure    = input.int(15,    "Max Structure Lines",       minval=5,  maxval=50,  group="Structure")

// ── Order Blocks ───────────────────────────────────────────────────────────────
showOB         = input.bool(true, "Show Order Blocks",                                group="Order Blocks")
obMitigated    = input.bool(true, "Remove Mitigated OBs",                             group="Order Blocks")
obMaxBoxes     = input.int(8,     "Max Order Blocks",          minval=1,  maxval=20,  group="Order Blocks")
obBullColor    = input.color(#c8e624, "Bullish OB Color",                             group="Order Blocks")
obBearColor    = input.color(#ff1744, "Bearish OB Color",                             group="Order Blocks")
obTransparency = input.int(88,    "OB Fill Transparency",      minval=70, maxval=97,  group="Order Blocks")

// ── Fair Value Gaps ────────────────────────────────────────────────────────────
showFVG        = input.bool(true, "Show Fair Value Gaps",                             group="Fair Value Gaps")
fvgMitigated   = input.bool(true, "Remove Mitigated FVGs",                            group="Fair Value Gaps")
fvgMaxBoxes    = input.int(10,    "Max FVG Boxes",             minval=1,  maxval=20,  group="Fair Value Gaps")
fvgBullColor   = input.color(#c8e624, "Bullish FVG Color",                            group="Fair Value Gaps")
fvgBearColor   = input.color(#ff1744, "Bearish FVG Color",                            group="Fair Value Gaps")
fvgTransparency = input.int(90,   "FVG Fill Transparency",     minval=70, maxval=97,  group="Fair Value Gaps")
fvgMinSize     = input.float(0.0, "Min FVG Size (ticks)",      minval=0,  maxval=100, step=1, group="Fair Value Gaps")

// ── Liquidity Sweeps ───────────────────────────────────────────────────────────
showLiqSweep     = input.bool(true,  "Show Liquidity Sweeps",                         group="Liquidity")
liqLookback      = input.int(20,     "Liquidity Lookback",      minval=5, maxval=100, group="Liquidity")
liqSweepBullClr  = input.color(#c8e624, "Buy-side Sweep Color",                       group="Liquidity")
liqSweepBearClr  = input.color(#ff1744, "Sell-side Sweep Color",                      group="Liquidity")

// ── Equal Highs / Lows ─────────────────────────────────────────────────────────
showEqHL         = input.bool(true,   "Show Equal Highs / Lows",                      group="Equal H/L")
eqTolerance      = input.float(0.02, "Equal Level Tolerance %", minval=0.005, maxval=0.1, step=0.005, group="Equal H/L")
eqHighColor      = input.color(#ff1744, "Equal Highs Color",                          group="Equal H/L")
eqLowColor       = input.color(#c8e624, "Equal Lows Color",                           group="Equal H/L")

// ── Premium / Discount Zones ───────────────────────────────────────────────────
showPDZones     = input.bool(true,  "Show Premium/Discount",                          group="Premium & Discount")
pdLookback      = input.int(50,     "Range Lookback",           minval=20, maxval=200,group="Premium & Discount")
pdBullColor     = input.color(#c8e624, "Discount Zone Color",                         group="Premium & Discount")
pdBearColor     = input.color(#ff1744, "Premium Zone Color",                          group="Premium & Discount")

// ── Displacement Detection ─────────────────────────────────────────────────────
showDisplacement = input.bool(true,  "Show Displacement Candles",                     group="Displacement")
dispMultiplier   = input.float(2.0,  "ATR Multiplier",          minval=1.0, maxval=5.0, step=0.1, group="Displacement")
dispAtrLen       = input.int(14,     "ATR Period",              minval=5,  maxval=50,  group="Displacement")
dispBullColor    = input.color(#c8e624, "Bull Displacement",                           group="Displacement")
dispBearColor    = input.color(#ff1744, "Bear Displacement",                           group="Displacement")

// ── Candle Strength ────────────────────────────────────────────────────────────
showCandleStr    = input.bool(false, "Show Candle Strength Dots",                     group="Candle Strength")
strAtrLen        = input.int(14,     "Strength ATR Period",     minval=5,  maxval=50,  group="Candle Strength")

// ── Appearance ─────────────────────────────────────────────────────────────────
labelSizeInput  = input.string("Small", "Label Size",
  options=["Tiny","Small","Normal","Large"],                                            group="Appearance")
structLineWidth = input.int(1,  "Structure Line Width",   minval=1, maxval=4,          group="Appearance")
chochLineWidth  = input.int(2,  "CHoCH Line Width",       minval=1, maxval=4,          group="Appearance")

// ── Dashboard ──────────────────────────────────────────────────────────────────
showDash        = input.bool(true,  "Show Dashboard",                                 group="Dashboard")
dashPos         = input.string("Top Right", "Dashboard Position",
  options=["Top Left","Top Right","Bottom Left","Bottom Right"],                        group="Dashboard")
dashSizeInput   = input.string("Small", "Dashboard Text Size",
  options=["Tiny","Small","Normal"],                                                    group="Dashboard")

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ HELPER FUNCTIONS ══════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

getDashPosition(pos) =>
    switch pos
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right

getLabelSize(sz) =>
    switch sz
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large

getDashTextSize(sz) =>
    switch sz
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal

labelSize    = getLabelSize(labelSizeInput)
dashTextSize = getDashTextSize(dashSizeInput)

// Label offset for spacing from structure lines
labelOffset = 2

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ SWING DETECTION ══════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

pivotHigh = ta.pivothigh(high, swingLen, swingLen)
pivotLow  = ta.pivotlow(low,   swingLen, swingLen)

var float lastSwingHigh     = na
var int   lastSwingHighBar  = na
var float lastSwingLow      = na
var int   lastSwingLowBar   = na
var float prevSwingHigh     = na
var int   prevSwingHighBar  = na
var float prevSwingLow      = na
var int   prevSwingLowBar   = na
var float priorSwingHigh    = na
var float priorSwingLow     = na

if not na(pivotHigh)
    priorSwingHigh   := lastSwingHigh
    prevSwingHigh    := lastSwingHigh
    prevSwingHighBar := lastSwingHighBar
    lastSwingHigh    := pivotHigh
    lastSwingHighBar := bar_index - swingLen

if not na(pivotLow)
    priorSwingLow   := lastSwingLow
    prevSwingLow    := lastSwingLow
    prevSwingLowBar := lastSwingLowBar
    lastSwingLow    := pivotLow
    lastSwingLowBar := bar_index - swingLen

isHH = not na(lastSwingHigh) and not na(priorSwingHigh) and
  lastSwingHigh > priorSwingHigh
isLH = not na(lastSwingHigh) and not na(priorSwingHigh) and
  lastSwingHigh < priorSwingHigh
isHL = not na(lastSwingLow) and not na(priorSwingLow) and
  lastSwingLow > priorSwingLow
isLL = not na(lastSwingLow) and not na(priorSwingLow) and
  lastSwingLow < priorSwingLow

if showSwingPoints and not na(pivotHigh)
    swText = isHH ? "HH" : "LH"
    swClr  = isHH ? BULL_PRIMARY : BEAR_PRIMARY
    label.new(bar_index - swingLen, pivotHigh,
      text=swText, yloc=yloc.abovebar,
      color=color.new(swClr, 100), textcolor=swClr,
      size=labelSize, style=label.style_none)

if showSwingPoints and not na(pivotLow)
    swText = isHL ? "HL" : "LL"
    swClr  = isHL ? BULL_PRIMARY : BEAR_PRIMARY
    label.new(bar_index - swingLen, pivotLow,
      text=swText, yloc=yloc.belowbar,
      color=color.new(swClr, 100), textcolor=swClr,
      size=labelSize, style=label.style_none)

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ STRUCTURE TRACKING ═══════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

var int   marketTrend      = 0
var float confirmedHigh    = na
var float confirmedLow     = na
var int   confirmedHighBar = na
var int   confirmedLowBar  = na

var array<line>  structureLines  = array.new<line>()
var array<label> structureLabels = array.new<label>()

trimStructure() =>
    while array.size(structureLines) > maxStructure
        line.delete(array.shift(structureLines))
    while array.size(structureLabels) > maxStructure
        label.delete(array.shift(structureLabels))

bullBOS = not na(lastSwingHigh) and close > lastSwingHigh and
  close[1] <= lastSwingHigh and marketTrend == 1
bearBOS = not na(lastSwingLow) and close < lastSwingLow and
  close[1] >= lastSwingLow and marketTrend == -1

bullCHoCH = not na(lastSwingHigh) and close > lastSwingHigh and
  close[1] <= lastSwingHigh and marketTrend != 1
bearCHoCH = not na(lastSwingLow) and close < lastSwingLow and
  close[1] >= lastSwingLow and marketTrend != -1

// ── ATR for label offset spacing ──────────────────────────────────────────────
atrForSpacing = ta.atr(14)
spacingUp     = atrForSpacing * 0.15
spacingDown   = atrForSpacing * 0.15

if bullBOS and showBOS
    midY = lastSwingHigh
    ln = line.new(bar_index - 8, midY, bar_index, midY,
      color=BULL_PRIMARY, style=line.style_dashed,
      width=structLineWidth)
    lb = label.new(bar_index - 4, midY + spacingUp,
      text="BOS", yloc=yloc.price,
      color=color.new(BULL_PRIMARY, 100),
      textcolor=BULL_PRIMARY,
      size=labelSize, style=label.style_none)
    array.push(structureLines, ln)
    array.push(structureLabels, lb)
    confirmedHigh    := lastSwingHigh
    confirmedHighBar := lastSwingHighBar
    trimStructure()

if bearBOS and showBOS
    midY = lastSwingLow
    ln = line.new(bar_index - 8, midY, bar_index, midY,
      color=BEAR_PRIMARY, style=line.style_dashed,
      width=structLineWidth)
    lb = label.new(bar_index - 4, midY - spacingDown,
      text="BOS", yloc=yloc.price,
      color=color.new(BEAR_PRIMARY, 100),
      textcolor=BEAR_PRIMARY,
      size=labelSize, style=label.style_none)
    array.push(structureLines, ln)
    array.push(structureLabels, lb)
    confirmedLow    := lastSwingLow
    confirmedLowBar := lastSwingLowBar
    trimStructure()

if bullCHoCH and showCHoCH
    midY = lastSwingHigh
    ln = line.new(bar_index - 8, midY, bar_index, midY,
      color=BULL_BRIGHT, style=line.style_dotted,
      width=chochLineWidth)
    lb = label.new(bar_index - 4, midY + spacingUp,
      text="CHoCH", yloc=yloc.price,
      color=color.new(BULL_BRIGHT, 100),
      textcolor=BULL_BRIGHT,
      size=labelSize, style=label.style_none)
    array.push(structureLines, ln)
    array.push(structureLabels, lb)
    marketTrend      := 1
    confirmedHigh    := lastSwingHigh
    confirmedHighBar := lastSwingHighBar
    trimStructure()

if bearCHoCH and showCHoCH
    midY = lastSwingLow
    ln = line.new(bar_index - 8, midY, bar_index, midY,
      color=BEAR_BRIGHT, style=line.style_dotted,
      width=chochLineWidth)
    lb = label.new(bar_index - 4, midY - spacingDown,
      text="CHoCH", yloc=yloc.price,
      color=color.new(BEAR_BRIGHT, 100),
      textcolor=BEAR_BRIGHT,
      size=labelSize, style=label.style_none)
    array.push(structureLines, ln)
    array.push(structureLabels, lb)
    marketTrend      := -1
    confirmedLow     := lastSwingLow
    confirmedLowBar  := lastSwingLowBar
    trimStructure()

if bullBOS or bullCHoCH
    marketTrend := 1
if bearBOS or bearCHoCH
    marketTrend := -1

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ ORDER BLOCKS ══════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

type OrderBlock
    box   bx
    label lb
    float top
    float btm
    int   dir
    bool  active
    int   touches

var array<OrderBlock> obArray = array.new<OrderBlock>()

bearishEngulf = close < open and close[1] > open[1] and
  close < open[1] and open > close[1]
bullishEngulf = close > open and close[1] < open[1] and
  close > open[1] and open < close[1]
strongBearMove = close < low[1] and close < low[2] and
  close < open
strongBullMove = close > high[1] and close > high[2] and
  close > open

obBearish = (bearishEngulf or strongBearMove) and showOB
obBullish = (bullishEngulf or strongBullMove) and showOB

if obBearish and showOB
    obTop = math.max(open[1], close[1], high[1])
    obBtm = math.min(open[1], close[1])
    bx = box.new(bar_index - 1, obTop, bar_index + 20, obBtm,
      border_color=color.new(obBearColor, obTransparency - 20),
      bgcolor=color.new(obBearColor, obTransparency),
      border_width=1, border_style=line.style_solid)
    lb = label.new(bar_index, obTop + spacingUp,
      text="OB", yloc=yloc.price,
      color=color.new(obBearColor, 100),
      textcolor=color.new(obBearColor, 40),
      size=size.tiny, style=label.style_none)
    ob = OrderBlock.new(bx, lb, obTop, obBtm, -1, true, 0)
    array.push(obArray, ob)
    while array.size(obArray) > obMaxBoxes
        old = array.shift(obArray)
        box.delete(old.bx)
        label.delete(old.lb)

if obBullish and showOB
    obTop = math.max(open[1], close[1])
    obBtm = math.min(open[1], close[1], low[1])
    bx = box.new(bar_index - 1, obTop, bar_index + 20, obBtm,
      border_color=color.new(obBullColor, obTransparency - 20),
      bgcolor=color.new(obBullColor, obTransparency),
      border_width=1, border_style=line.style_solid)
    lb = label.new(bar_index, obBtm - spacingDown,
      text="OB", yloc=yloc.price,
      color=color.new(obBullColor, 100),
      textcolor=color.new(obBullColor, 40),
      size=size.tiny, style=label.style_none)
    ob = OrderBlock.new(bx, lb, obTop, obBtm, 1, true, 0)
    array.push(obArray, ob)
    while array.size(obArray) > obMaxBoxes
        old = array.shift(obArray)
        box.delete(old.bx)
        label.delete(old.lb)

if array.size(obArray) > 0
    for i = array.size(obArray) - 1 to 0
        ob = array.get(obArray, i)
        if ob.active
            box.set_right(ob.bx, bar_index + 5)
            touchedNow = false
            if ob.dir == 1 and low <= ob.top and low >= ob.btm
                touchedNow := true
            if ob.dir == -1 and high >= ob.btm and high <= ob.top
                touchedNow := true
            if touchedNow
                prevTouched = false
                if ob.dir == 1 and low[1] <= ob.top and low[1] >= ob.btm
                    prevTouched := true
                if ob.dir == -1 and high[1] >= ob.btm and high[1] <= ob.top
                    prevTouched := true
                if not prevTouched
                    ob.touches += 1
            touchText = ob.touches > 0 ?
              "OB ×" + str.tostring(ob.touches) : "OB"
            label.set_text(ob.lb, touchText)
            mitigated = false
            if ob.dir == 1 and close < ob.btm
                mitigated := true
            if ob.dir == -1 and close > ob.top
                mitigated := true
            if mitigated and obMitigated
                ob.active := false
                box.set_right(ob.bx, bar_index)
                box.set_bgcolor(ob.bx, color.new(NEUTRAL, 95))
                box.set_border_color(ob.bx, color.new(NEUTRAL, 90))
                label.set_textcolor(ob.lb, color.new(NEUTRAL, 70))

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ FAIR VALUE GAPS ═══════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

type FVG
    box   bx
    line  mid
    label lb
    float top
    float btm
    int   dir
    bool  active
    float fillPct

var array<FVG> fvgArray = array.new<FVG>()

fvgMinTicks = fvgMinSize * syminfo.mintick

bullFVG = low > high[2] and close[1] > open[1] and
  (low - high[2]) > fvgMinTicks and showFVG
bearFVG = high < low[2] and close[1] < open[1] and
  (low[2] - high) > fvgMinTicks and showFVG

if bullFVG and showFVG
    fTop = low
    fBtm = high[2]
    fMid = (fTop + fBtm) / 2
    bx = box.new(bar_index - 2, fTop, bar_index + 20, fBtm,
      border_color=color.new(fvgBullColor, fvgTransparency - 15),
      bgcolor=color.new(fvgBullColor, fvgTransparency),
      border_width=1, border_style=line.style_dotted)
    ml = line.new(bar_index - 2, fMid, bar_index + 20, fMid,
      color=color.new(fvgBullColor, fvgTransparency - 30),
      style=line.style_dotted, width=1)
    lb = label.new(bar_index - 1, fTop + spacingUp,
      text="FVG", yloc=yloc.price,
      color=color.new(fvgBullColor, 100),
      textcolor=color.new(fvgBullColor, 50),
      size=size.tiny, style=label.style_none)
    fg = FVG.new(bx, ml, lb, fTop, fBtm, 1, true, 0.0)
    array.push(fvgArray, fg)
    while array.size(fvgArray) > fvgMaxBoxes
        old = array.shift(fvgArray)
        box.delete(old.bx)
        line.delete(old.mid)
        label.delete(old.lb)

if bearFVG and showFVG
    fTop = low[2]
    fBtm = high
    fMid = (fTop + fBtm) / 2
    bx = box.new(bar_index - 2, fTop, bar_index + 20, fBtm,
      border_color=color.new(fvgBearColor, fvgTransparency - 15),
      bgcolor=color.new(fvgBearColor, fvgTransparency),
      border_width=1, border_style=line.style_dotted)
    ml = line.new(bar_index - 2, fMid, bar_index + 20, fMid,
      color=color.new(fvgBearColor, fvgTransparency - 30),
      style=line.style_dotted, width=1)
    lb = label.new(bar_index - 1, fBtm - spacingDown,
      text="FVG", yloc=yloc.price,
      color=color.new(fvgBearColor, 100),
      textcolor=color.new(fvgBearColor, 50),
      size=size.tiny, style=label.style_none)
    fg = FVG.new(bx, ml, lb, fTop, fBtm, -1, true, 0.0)
    array.push(fvgArray, fg)
    while array.size(fvgArray) > fvgMaxBoxes
        old = array.shift(fvgArray)
        box.delete(old.bx)
        line.delete(old.mid)
        label.delete(old.lb)

if array.size(fvgArray) > 0
    for i = array.size(fvgArray) - 1 to 0
        fg = array.get(fvgArray, i)
        if fg.active
            box.set_right(fg.bx, bar_index + 5)
            line.set_x2(fg.mid, bar_index + 5)
            gapSize = math.abs(fg.top - fg.btm)
            if fg.dir == 1 and low < fg.top and gapSize > 0
                filled = fg.top - math.max(low, fg.btm)
                fg.fillPct := math.min(100.0, filled / gapSize * 100)
            if fg.dir == -1 and high > fg.btm and gapSize > 0
                filled = math.min(high, fg.top) - fg.btm
                fg.fillPct := math.min(100.0, filled / gapSize * 100)
            fillText = fg.fillPct > 0 ?
              "FVG " + str.tostring(fg.fillPct, "#") + "%" : "FVG"
            label.set_text(fg.lb, fillText)
            mitigated = false
            if fg.dir == 1 and close < fg.btm
                mitigated := true
            if fg.dir == -1 and close > fg.top
                mitigated := true
            if mitigated and fvgMitigated
                fg.active := false
                box.set_right(fg.bx, bar_index)
                line.set_x2(fg.mid, bar_index)
                box.set_bgcolor(fg.bx, color.new(NEUTRAL, 96))
                box.set_border_color(fg.bx, color.new(NEUTRAL, 93))
                line.set_color(fg.mid, color.new(NEUTRAL, 93))
                label.set_textcolor(fg.lb, color.new(NEUTRAL, 80))
                label.set_text(fg.lb, "FVG ✓")

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ LIQUIDITY SWEEPS ═════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

prevRecentHigh = ta.highest(high[1], liqLookback)
prevRecentLow  = ta.lowest(low[1],   liqLookback)

buySideSweep  = high > prevRecentHigh and close < prevRecentHigh and
  close < open and showLiqSweep
sellSideSweep = low < prevRecentLow and close > prevRecentLow and
  close > open and showLiqSweep

if buySideSweep
    label.new(bar_index, high,
      text="$ sweep", yloc=yloc.abovebar,
      color=color.new(liqSweepBearClr, 100),
      textcolor=liqSweepBearClr,
      size=labelSize, style=label.style_none)

if sellSideSweep
    label.new(bar_index, low,
      text="$ sweep", yloc=yloc.belowbar,
      color=color.new(liqSweepBullClr, 100),
      textcolor=liqSweepBullClr,
      size=labelSize, style=label.style_none)

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ EQUAL HIGHS / LOWS ═══════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

var array<line>  eqLines  = array.new<line>()
var array<label> eqLabels = array.new<label>()
maxEqDrawings = 20

trimEqDrawings() =>
    while array.size(eqLines) > maxEqDrawings
        line.delete(array.shift(eqLines))
    while array.size(eqLabels) > maxEqDrawings
        label.delete(array.shift(eqLabels))

if showEqHL and not na(pivotHigh)
    tolerance = lastSwingHigh * eqTolerance / 100
    if not na(priorSwingHigh) and
      math.abs(lastSwingHigh - priorSwingHigh) <= tolerance and
      not na(prevSwingHighBar) and not na(lastSwingHighBar)
        eqLevel = (lastSwingHigh + priorSwingHigh) / 2
        ln = line.new(prevSwingHighBar, eqLevel,
          bar_index + 10, eqLevel,
          color=color.new(eqHighColor, 30),
          style=line.style_dashed, width=1)
        lb = label.new(bar_index - swingLen, eqLevel + spacingUp,
          text="EQH", yloc=yloc.price,
          color=color.new(eqHighColor, 100),
          textcolor=eqHighColor,
          size=labelSize, style=label.style_none)
        array.push(eqLines, ln)
        array.push(eqLabels, lb)
        trimEqDrawings()

if showEqHL and not na(pivotLow)
    tolerance = lastSwingLow * eqTolerance / 100
    if not na(priorSwingLow) and
      math.abs(lastSwingLow - priorSwingLow) <= tolerance and
      not na(prevSwingLowBar) and not na(lastSwingLowBar)
        eqLevel = (lastSwingLow + priorSwingLow) / 2
        ln = line.new(prevSwingLowBar, eqLevel,
          bar_index + 10, eqLevel,
          color=color.new(eqLowColor, 30),
          style=line.style_dashed, width=1)
        lb = label.new(bar_index - swingLen, eqLevel - spacingDown,
          text="EQL", yloc=yloc.price,
          color=color.new(eqLowColor, 100),
          textcolor=eqLowColor,
          size=labelSize, style=label.style_none)
        array.push(eqLines, ln)
        array.push(eqLabels, lb)
        trimEqDrawings()

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ DISPLACEMENT CANDLES ═════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

dispATR    = ta.atr(dispAtrLen)
candleBody = math.abs(close - open)
candleRange = high - low
bodyRatio  = candleRange > 0 ? candleBody / candleRange : 0

isBullDisp = close > open and candleBody > dispATR * dispMultiplier and
  bodyRatio > 0.6 and showDisplacement
isBearDisp = close < open and candleBody > dispATR * dispMultiplier and
  bodyRatio > 0.6 and showDisplacement

plotshape(isBullDisp,
  title="Bull Displacement",
  style=shape.diamond,
  location=location.belowbar,
  color=dispBullColor,
  size=size.tiny)

plotshape(isBearDisp,
  title="Bear Displacement",
  style=shape.diamond,
  location=location.abovebar,
  color=dispBearColor,
  size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ CANDLE STRENGTH DOTS ═════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

strATR   = ta.atr(strAtrLen)
strRatio = strATR > 0 ? candleBody / strATR : 0

strongBull = strRatio > 1.2 and bodyRatio > 0.55 and
  close > open and showCandleStr
strongBear = strRatio > 1.2 and bodyRatio > 0.55 and
  close < open and showCandleStr

plotshape(strongBull,
  title="Strong Bull Candle",
  style=shape.circle,
  location=location.belowbar,
  color=BULL_DIM,
  size=size.tiny)

plotshape(strongBear,
  title="Strong Bear Candle",
  style=shape.circle,
  location=location.abovebar,
  color=BEAR_DIM,
  size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ PREMIUM / DISCOUNT (LINE-BASED) ═════════════════
// ═══════════════════════════════════════════════════════════════════════════════

rangeHigh = ta.highest(high, pdLookback)
rangeLow  = ta.lowest(low,   pdLookback)
rangeEQ   = (rangeHigh + rangeLow) / 2

var line eqLine       = na
var line premTopLine  = na
var line discBtmLine  = na
var box  premBox      = na
var box  discBox      = na

premiumMid  = rangeEQ + (rangeHigh - rangeEQ) * 0.5
discountMid = rangeEQ - (rangeEQ - rangeLow) * 0.5

if showPDZones and barstate.islast
    // Delete previous drawings
    if not na(eqLine)
        line.delete(eqLine)
    if not na(premTopLine)
        line.delete(premTopLine)
    if not na(discBtmLine)
        line.delete(discBtmLine)
    if not na(premBox)
        box.delete(premBox)
    if not na(discBox)
        box.delete(discBox)

    lookbackBars = math.min(pdLookback, bar_index)
    startBar = bar_index - lookbackBars

    eqLine := line.new(startBar, rangeEQ, bar_index + 5, rangeEQ,
      color=NEUTRAL_LIGHT, style=line.style_dotted, width=1)
    premTopLine := line.new(startBar, rangeHigh, bar_index + 5, rangeHigh,
      color=color.new(pdBearColor, 70), style=line.style_dotted, width=1)
    discBtmLine := line.new(startBar, rangeLow, bar_index + 5, rangeLow,
      color=color.new(pdBullColor, 70), style=line.style_dotted, width=1)
    premBox := box.new(startBar, rangeHigh, bar_index + 5, premiumMid,
      border_color=na,
      bgcolor=color.new(pdBearColor, 94))
    discBox := box.new(startBar, discountMid, bar_index + 5, rangeLow,
      border_color=na,
      bgcolor=color.new(pdBullColor, 94))

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ DASHBOARD TABLE ═══════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

ema50      = ta.ema(close, 50)
ema200     = ta.ema(close, 200)
currentBias = close > ema50 and ema50 > ema200 ? 1 :
  close < ema50 and ema50 < ema200 ? -1 : 0
rsiVal     = ta.rsi(close, 14)
atrVal     = ta.atr(14)
atrPct     = atrVal / close * 100
volSMA     = ta.sma(volume, 20)
volRatio   = volSMA > 0 ? volume / volSMA : 1.0

var table dash = na
if showDash
    dash := table.new(getDashPosition(dashPos), 2, 12,
      bgcolor=color.new(BG_DARK, 5),
      border_width=1,
      border_color=color.new(NEUTRAL, 75),
      frame_width=2,
      frame_color=color.new(NEUTRAL, 40))

if showDash and barstate.islast
    // Row 0 — Title
    table.cell(dash, 0, 0, "A L P H A X   S T R U C T U R E",
      text_color=BULL_PRIMARY, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))
    table.cell(dash, 1, 0, "",
      bgcolor=color.new(BG_DARK, 0))
    table.merge_cells(dash, 0, 0, 1, 0)

    // Row 1 — Market Structure
    trendText  = marketTrend == 1 ? "▲ BULLISH" :
      marketTrend == -1 ? "▼ BEARISH" : "— NEUTRAL"
    trendColor = marketTrend == 1 ? BULL_PRIMARY :
      marketTrend == -1 ? BEAR_PRIMARY : NEUTRAL_LIGHT
    table.cell(dash, 0, 1, "STRUCTURE",
      text_color=TEXT_LIGHT, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))
    table.cell(dash, 1, 1, trendText,
      text_color=trendColor, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))

    // Row 2 — EMA Bias
    biasText  = currentBias == 1 ? "▲ BULLISH" :
      currentBias == -1 ? "▼ BEARISH" : "— NEUTRAL"
    biasColor = currentBias == 1 ? BULL_PRIMARY :
      currentBias == -1 ? BEAR_PRIMARY : NEUTRAL_LIGHT
    table.cell(dash, 0, 2, "EMA BIAS",
      text_color=TEXT_LIGHT, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))
    table.cell(dash, 1, 2, biasText,
      text_color=biasColor, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))

    // Row 3 — Zone
    rangePct = rangeHigh != rangeLow ?
      (close - rangeLow) / (rangeHigh - rangeLow) * 100 : 50.0
    posText = rangePct > 75 ? "PREMIUM" :
      rangePct > 50 ? "UPPER EQ" :
      rangePct > 25 ? "LOWER EQ" : "DISCOUNT"
    posColor = rangePct > 75 ? BEAR_PRIMARY :
      rangePct > 50 ? BEAR_DIM :
      rangePct > 25 ? BULL_DIM : BULL_PRIMARY
    table.cell(dash, 0, 3, "ZONE",
      text_color=TEXT_LIGHT, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))
    table.cell(dash, 1, 3,
      posText + "  " + str.tostring(rangePct, "#") + "%",
      text_color=posColor, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))

    // Row 4 — EQ Level
    table.cell(dash, 0, 4, "EQ LEVEL",
      text_color=TEXT_LIGHT, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))
    table.cell(dash, 1, 4, str.tostring(rangeEQ, format.mintick),
      text_color=NEUTRAL_LIGHT, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))

    // Row 5 — RSI
    rsiColor = rsiVal > 70 ? BEAR_PRIMARY :
      rsiVal < 30 ? BULL_PRIMARY :
      rsiVal > 60 ? BEAR_DIM :
      rsiVal < 40 ? BULL_DIM : NEUTRAL_LIGHT
    table.cell(dash, 0, 5, "RSI (14)",
      text_color=TEXT_LIGHT, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))
    table.cell(dash, 1, 5, str.tostring(rsiVal, "#.#"),
      text_color=rsiColor, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))

    // Row 6 — Volatility
    volLabel = atrPct > 0.5 ? "HIGH" :
      atrPct > 0.2 ? "NORMAL" : "LOW"
    volColor = atrPct > 0.5 ? BEAR_BRIGHT :
      atrPct > 0.2 ? BULL_DIM : NEUTRAL_LIGHT
    table.cell(dash, 0, 6, "VOLATILITY",
      text_color=TEXT_LIGHT, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))
    table.cell(dash, 1, 6,
      volLabel + "  ATR " + str.tostring(atrVal, format.mintick),
      text_color=volColor, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))

    // Row 7 — Volume
    volStrText = volRatio > 2.0 ? "SPIKE" :
      volRatio > 1.3 ? "ABOVE AVG" :
      volRatio > 0.7 ? "NORMAL" : "DRY"
    volStrColor = volRatio > 2.0 ? BULL_BRIGHT :
      volRatio > 1.3 ? BULL_DIM :
      volRatio > 0.7 ? NEUTRAL_LIGHT : NEUTRAL
    table.cell(dash, 0, 7, "VOLUME",
      text_color=TEXT_LIGHT, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))
    table.cell(dash, 1, 7,
      volStrText + "  ×" + str.tostring(volRatio, "#.#"),
      text_color=volStrColor, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))

    // Row 8 — Active OBs
    int activeOBs = 0
    int bullOBs   = 0
    int bearOBs   = 0
    if array.size(obArray) > 0
        for i = 0 to array.size(obArray) - 1
            ob = array.get(obArray, i)
            if ob.active
                activeOBs += 1
                if ob.dir == 1
                    bullOBs += 1
                else
                    bearOBs += 1
    table.cell(dash, 0, 8, "ORDER BLOCKS",
      text_color=TEXT_LIGHT, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))
    table.cell(dash, 1, 8,
      str.tostring(activeOBs) + "  (▲" +
      str.tostring(bullOBs) + " ▼" +
      str.tostring(bearOBs) + ")",
      text_color=activeOBs > 0 ? BULL_BRIGHT : NEUTRAL_LIGHT,
      text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))

    // Row 9 — Active FVGs
    int activeFVGs = 0
    int bullFVGs   = 0
    int bearFVGs   = 0
    if array.size(fvgArray) > 0
        for i = 0 to array.size(fvgArray) - 1
            fg = array.get(fvgArray, i)
            if fg.active
                activeFVGs += 1
                if fg.dir == 1
                    bullFVGs += 1
                else
                    bearFVGs += 1
    table.cell(dash, 0, 9, "FAIR VALUE GAPS",
      text_color=TEXT_LIGHT, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))
    table.cell(dash, 1, 9,
      str.tostring(activeFVGs) + "  (▲" +
      str.tostring(bullFVGs) + " ▼" +
      str.tostring(bearFVGs) + ")",
      text_color=activeFVGs > 0 ? BULL_BRIGHT : NEUTRAL_LIGHT,
      text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))

    // Row 10 — Swing High
    table.cell(dash, 0, 10, "SWING HIGH",
      text_color=TEXT_LIGHT, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))
    table.cell(dash, 1, 10,
      not na(lastSwingHigh) ?
      str.tostring(lastSwingHigh, format.mintick) : "—",
      text_color=BEAR_BRIGHT, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))

    // Row 11 — Swing Low
    table.cell(dash, 0, 11, "SWING LOW",
      text_color=TEXT_LIGHT, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))
    table.cell(dash, 1, 11,
      not na(lastSwingLow) ?
      str.tostring(lastSwingLow, format.mintick) : "—",
      text_color=BULL_BRIGHT, text_size=dashTextSize,
      bgcolor=color.new(BG_DARK, 0))

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ ALERTS ════════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

// Structure Alerts
alertcondition(bullBOS,
  title="Bullish BOS",
  message="[AlphaX] Bullish Break of Structure — {{ticker}} {{interval}} @ {{close}}")
alertcondition(bearBOS,
  title="Bearish BOS",
  message="[AlphaX] Bearish Break of Structure — {{ticker}} {{interval}} @ {{close}}")
alertcondition(bullCHoCH,
  title="Bullish CHoCH",
  message="[AlphaX] Bullish Change of Character — {{ticker}} {{interval}} @ {{close}}")
alertcondition(bearCHoCH,
  title="Bearish CHoCH",
  message="[AlphaX] Bearish Change of Character — {{ticker}} {{interval}} @ {{close}}")

// Liquidity Alerts
alertcondition(buySideSweep,
  title="Buy-side Liquidity Sweep",
  message="[AlphaX] Buy-side liquidity swept — {{ticker}} {{interval}} @ {{close}}")
alertcondition(sellSideSweep,
  title="Sell-side Liquidity Sweep",
  message="[AlphaX] Sell-side liquidity swept — {{ticker}} {{interval}} @ {{close}}")

// FVG Alerts
alertcondition(bullFVG,
  title="Bullish FVG Formed",
  message="[AlphaX] Bullish Fair Value Gap formed — {{ticker}} {{interval}} @ {{close}}")
alertcondition(bearFVG,
  title="Bearish FVG Formed",
  message="[AlphaX] Bearish Fair Value Gap formed — {{ticker}} {{interval}} @ {{close}}")

// Order Block Alerts
alertcondition(obBullish,
  title="Bullish OB Formed",
  message="[AlphaX] Bullish Order Block formed — {{ticker}} {{interval}} @ {{close}}")
alertcondition(obBearish,
  title="Bearish OB Formed",
  message="[AlphaX] Bearish Order Block formed — {{ticker}} {{interval}} @ {{close}}")

// Displacement Alerts
alertcondition(isBullDisp,
  title="Bullish Displacement",
  message="[AlphaX] Bullish displacement candle — {{ticker}} {{interval}} @ {{close}}")
alertcondition(isBearDisp,
  title="Bearish Displacement",
  message="[AlphaX] Bearish displacement candle — {{ticker}} {{interval}} @ {{close}}")

// Combined Alerts
alertcondition(bullBOS or bullCHoCH,
  title="Any Bullish Structure Break",
  message="[AlphaX] Bullish structure break (BOS/CHoCH) — {{ticker}} {{interval}} @ {{close}}")
alertcondition(bearBOS or bearCHoCH,
  title="Any Bearish Structure Break",
  message="[AlphaX] Bearish structure break (BOS/CHoCH) — {{ticker}} {{interval}} @ {{close}}")
alertcondition(buySideSweep or sellSideSweep,
  title="Any Liquidity Sweep",
  message="[AlphaX] Liquidity sweep detected — {{ticker}} {{interval}} @ {{close}}")
alertcondition(bullFVG or bearFVG,
  title="Any FVG Formed",
  message="[AlphaX] Fair Value Gap formed — {{ticker}} {{interval}} @ {{close}}")
alertcondition(obBullish or obBearish,
  title="Any OB Formed",
  message="[AlphaX] Order Block formed — {{ticker}} {{interval}} @ {{close}}")
alertcondition(isBullDisp or isBearDisp,
  title="Any Displacement Candle",
  message="[AlphaX] Displacement candle detected — {{ticker}} {{interval}} @ {{close}}")
