//@version=6
indicator("Expansion Pullback Signal", overlay=true)

// ───── INPUTS ─────
atrLen   = input.int(14,  "ATR Length", minval=1)
atrMult  = input.float(1.3, "Expansion ATR Multiplier", step=0.1)
rsiLen   = input.int(14,  "RSI Length", minval=1)
emaFast  = input.int(20,  "Fast EMA Length", minval=1)
emaSlow  = input.int(50,  "Slow EMA Length", minval=1)
maxBars  = input.int(20,  "Max Bars After Expansion", minval=1)
vwapBand = input.float(0.003, "VWAP Pullback Threshold (%)", step=0.001)

// ───── CALCULATIONS ─────
atrValue = ta.atr(atrLen)
rsiValue = ta.rsi(close, rsiLen)

emaFastValue = ta.ema(close, emaFast)
emaSlowValue = ta.ema(close, emaSlow)
vwapValue    = ta.vwap(close)

// ───── EXPANSION LOGIC ─────
candleRange = high - low
candleBody  = math.abs(close - open)

isExpansion = candleRange > atrValue * atrMult and candleBody > candleRange * 0.6

bullMomentum = rsiValue > 55
bearMomentum = rsiValue < 45

// ───── STATE TRACKING ─────
var int bullExpIndex = na
var int bearExpIndex = na

if isExpansion and bullMomentum
    bullExpIndex := bar_index

if isExpansion and bearMomentum
    bearExpIndex := bar_index

bullActive = not na(bullExpIndex) and (bar_index - bullExpIndex <= maxBars)
bearActive = not na(bearExpIndex) and (bar_index - bearExpIndex <= maxBars)

// ───── PULLBACK CONDITIONS ─────
vwapDistance = math.abs(close - vwapValue) / close

pullbackBull = (close <= emaFastValue and close >= emaSlowValue) or (vwapDistance < vwapBand)
pullbackBear = (close >= emaFastValue and close <= emaSlowValue) or (vwapDistance < vwapBand)

// ───── FINAL SIGNALS ─────
bullSignal = bullActive and bullMomentum and pullbackBull
bearSignal = bearActive and bearMomentum and pullbackBear

// ───── VISUALS ─────
plot(emaFastValue, "Fast EMA", color=color.orange)
plot(emaSlowValue, "Slow EMA", color=color.blue)

plotshape(bullSignal, title="Bullish Pullback Signal", style=shape.triangleup, location=location.belowbar, size=size.small, color=color.lime)
plotshape(bearSignal, title="Bearish Pullback Signal", style=shape.triangledown, location=location.abovebar, size=size.small, color=color.red)

// ───── ALERTS ─────
alertcondition(bullSignal, title="Bullish Expansion Pullback", message="Bullish expansion pullback on {{ticker}} ({{interval}})")
alertcondition(bearSignal, title="Bearish Expansion Pullback", message="Bearish expansion pullback on {{ticker}} ({{interval}})")
