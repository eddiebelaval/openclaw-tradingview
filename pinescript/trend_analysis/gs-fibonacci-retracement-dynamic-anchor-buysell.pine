//@version=6
indicator("GS Fibonacci Retracement Dynamic Anchor [Buy/Sell]", overlay=true, shorttitle="GS Fibonacci Retracement_Anchor_Signals", max_lines_count=100)

// --- Inputs ---
n_lookback = input.int(75, "Scan Range (Bars)", minval=10, tooltip="The window used to find the Major High and Major Low")
show_table = input.bool(true, "Show Info Dashboard")

// --- Find Absolute High/Low Anchors ---
hi_val = ta.highest(high, n_lookback)
lo_val = ta.lowest(low, n_lookback)

// Find exact bar indices for the lines
hi_index = 0
lo_index = 0
for i = 0 to n_lookback - 1
    if high[i] == hi_val
        hi_index := bar_index[i]
    if low[i] == lo_val
        lo_index := bar_index[i]

// --- Fibonacci Calculations ---
range_val = hi_val - lo_val
h1 = hi_val - range_val * 0.210  // Premium Exit
h3 = hi_val - range_val * 0.382  // Premium Pocket
h4 = hi_val - range_val * 0.500  // Equilibrium (Median)
h5 = hi_val - range_val * 0.618  // Discount Pocket (Golden)
h7 = hi_val - range_val * 0.790  // Deep Discount

// --- Line Drawing Logic (Update every bar) ---
f_draw_line(x1, y1, y2, _color, _width, _style) =>
    var line l = line.new(x1, y1, bar_index, y2, color=_color, width=_width, style=_style)
    line.set_xy1(l, x1, y1)
    line.set_xy2(l, bar_index, y2)
    l

// Projecting the Dynamic Grid
line_hi = f_draw_line(hi_index, hi_val, hi_val, color.new(color.green, 20), 2, line.style_solid)
line_lo = f_draw_line(lo_index, lo_val, lo_val, color.new(color.red, 20), 2, line.style_solid)
line_50 = f_draw_line(math.min(hi_index, lo_index), h4, h4, color.new(color.gray, 50), 1, line.style_dashed)

// Golden Pockets
line_618 = f_draw_line(math.min(hi_index, lo_index), h5, h5, color.new(color.teal, 60), 1, line.style_dotted)
line_382 = f_draw_line(math.min(hi_index, lo_index), h3, h3, color.new(color.orange, 60), 1, line.style_dotted)

// --- Careful Signal Logic (No Redraw on Closed Bars) ---
// We track if price has entered the extreme "Pockets" before the Median Cross
var bool bull_ready = false
var bool bear_ready = false

if low < h5 // Price entered "Deep Discount"
    bull_ready := true
if high > h3 // Price entered "Premium Sell Zone"
    bear_ready := true

// Reset if price sets a NEW Anchor (Trend continuation)
if high > hi_val[1] or low < lo_val[1]
    bull_ready := false
    bear_ready := false

// Confirm Signals on 50% Median Reclaim
bullish_signal = ta.crossover(close, h4) and bull_ready
bearish_signal = ta.crossunder(close, h4) and bear_ready

// Reset states after signal to wait for next pocket entry
if bullish_signal
    bull_ready := false
if bearish_signal
    bear_ready := false

// --- Plotting Arrows ---
plotshape(bullish_signal, "GS Buy", shape.triangleup, location.belowbar, color.green, size=size.small, text="GS BUY")
plotshape(bearish_signal, "GS Sell", shape.triangledown, location.abovebar, color.red, size=size.small, text="GS SELL")

// --- Dashboard ---
var table gsTab = table.new(position.top_right, 2, 2, border_width=1)
if show_table and barstate.islast
    table.cell(gsTab, 0, 0, "GS Bias", bgcolor=color.black, text_color=color.white)
    table.cell(gsTab, 1, 0, close > h4 ? "PREMIUM" : "DISCOUNT", bgcolor=close > h4 ? color.red : color.green)
    table.cell(gsTab, 0, 1, "Next Target", bgcolor=color.black, text_color=color.white)
    table.cell(gsTab, 1, 1, close > h4 ? "High/21%" : "Low/79%", bgcolor=color.gray)

// --- Alerts ---
alertcondition(bullish_signal, "GS Buy Signal", "GS Golden Entry: Reclaiming Median - {{ticker}}")
alertcondition(bearish_signal, "GS Sell Signal", "GS Golden Entry: Breaking Median - {{ticker}}")
