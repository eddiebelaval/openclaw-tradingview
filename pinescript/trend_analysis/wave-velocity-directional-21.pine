//@version=5
indicator("Wave Velocity Directional 2.1", overlay=true)

// === INPUT POINTS ===
t1_start = input.time(0, "① Wave 1 START", confirm=true)
t1_end   = input.time(0, "② Wave 1 END", confirm=true)
t2_start = input.time(0, "③ Wave 2 START", confirm=true)
t2_end   = input.time(0, "④ Wave 2 END", confirm=true)

// === ANCHOR DATA ===
h1s = ta.valuewhen(time == t1_start, high, 0)
l1s = ta.valuewhen(time == t1_start, low, 0)
h1e = ta.valuewhen(time == t1_end, high, 0)
l1e = ta.valuewhen(time == t1_end, low, 0)

h2s = ta.valuewhen(time == t2_start, high, 0)
l2s = ta.valuewhen(time == t2_start, low, 0)
h2e = ta.valuewhen(time == t2_end, high, 0)
l2e = ta.valuewhen(time == t2_end, low, 0)

// === BAR COUNT ===
bi1s = ta.valuewhen(time == t1_start, bar_index, 0)
bi1e = ta.valuewhen(time == t1_end, bar_index, 0)
bi2s = ta.valuewhen(time == t2_start, bar_index, 0)
bi2e = ta.valuewhen(time == t2_end, bar_index, 0)

bars1 = not na(bi1s) and not na(bi1e) ? math.abs(bi1e - bi1s) : na
bars2 = not na(bi2s) and not na(bi2e) ? math.abs(bi2e - bi2s) : na

// === DIRECTIONAL RANGE ===
range1 = not na(h1s) and not na(h1e) ? (h1e > h1s ? (h1e - l1s) : (h1s - l1e)) : na
range2 = not na(h2s) and not na(h2e) ? (h2e > h2s ? (h2e - l2s) : (h2s - l2e)) : na

// === VELOCITY ===
velocity1 = not na(range1) and bars1 > 0 ? range1 / bars1 : na
velocity2 = not na(range2) and bars2 > 0 ? range2 / bars2 : na
ratio = not na(velocity1) and not na(velocity2) and velocity2 > 0 ? velocity1 / velocity2 : na

// === STATUS BASED ON RATIO ===
ratioColor = ratio > 1.5 ? color.lime :
             ratio > 1.2 ? color.green :
             ratio > 1 ? color.yellow :
             color.red

statusText = ratio > 1.5 ? "STRONG IMPULSE" :
             ratio > 1.2 ? "HEALTHY" :
             ratio > 1 ? "WEAK" :
             "STRUCTURE WARNING"

statusColor = ratio > 1.2 ? color.lime :
              ratio > 1 ? color.yellow :
              color.red

// =====================
// === CCI (LOCKED TO WAVE 2 END) ===
// =====================
cciLen = input.int(20, "CCI Length")
cciSrc = input.source(hlc3, "CCI Source")
cciLongMax  = input.float(80,  "CCI Long Max (>= blocks long)")
cciShortMin = input.float(-80, "CCI Short Min (<= blocks short)")

cciRaw = ta.cci(cciSrc, cciLen)
// CCI value at the candle where Wave 2 ends:
cciVal = ta.valuewhen(time == t2_end, cciRaw, 0)

longAllowed  = not na(cciVal) ? (cciVal < cciLongMax) : na
shortAllowed = not na(cciVal) ? (cciVal > cciShortMin) : na

cciColor = na(cciVal) ? color.gray :
           (cciVal >= cciLongMax or cciVal <= cciShortMin) ? color.red :
           color.lime

cciStatusText = na(cciVal) ? "SET W2 END" :
     (longAllowed ? "LONG OK" : "LONG NO") + " | " + (shortAllowed ? "SHORT OK" : "SHORT NO")

cciStatusColor = na(cciVal) ? color.gray :
     (longAllowed and shortAllowed) ? color.lime :
     (longAllowed or shortAllowed)  ? color.yellow :
     color.red

// =====================
// === EMA200 (LOCKED TO WAVE 2 END) + STATUS (LONG/SHORT) ===
// =====================
emaLen = input.int(200, "EMA Length (Trend)")
emaRaw = ta.ema(close, emaLen)

// values at W2 end candle
ema200_at_w2end = ta.valuewhen(time == t2_end, emaRaw, 0)
close_at_w2end  = ta.valuewhen(time == t2_end, close, 0)

// slope locked to W2 end
emaUp_at_w2end   = ta.valuewhen(time == t2_end, emaRaw > emaRaw[1], 0)
emaDown_at_w2end = ta.valuewhen(time == t2_end, emaRaw < emaRaw[1], 0)

// rules
emaLongAllowed  = not na(ema200_at_w2end) and not na(close_at_w2end) ? (close_at_w2end > ema200_at_w2end and emaUp_at_w2end) : na
emaShortAllowed = not na(ema200_at_w2end) and not na(close_at_w2end) ? (close_at_w2end < ema200_at_w2end and emaDown_at_w2end) : na

// text like CCI
emaStatusText = na(ema200_at_w2end) ? "SET W2 END" :
     (emaLongAllowed ? "LONG OK" : "LONG NO") + " | " + (emaShortAllowed ? "SHORT OK" : "SHORT NO")

// colors
emaStatusColor = na(ema200_at_w2end) ? color.gray :
     (emaLongAllowed and emaShortAllowed) ? color.lime :
     (emaLongAllowed or emaShortAllowed)  ? color.yellow :
     color.red

emaValColor =
     na(ema200_at_w2end) ? color.gray :
     emaLongAllowed ? color.lime :
     emaShortAllowed ? color.orange :
     color.gray

// === COMPACT TABLE ===
// rows: 0..7
var table t = table.new(position.top_right, 2, 8, border_width=1)

bg = color.rgb(20,20,20)
white = color.white

if barstate.islast
    table.cell(t, 0, 0, "W1 Vel", text_color=white, bgcolor=bg, text_size=size.small)
    table.cell(t, 1, 0, str.tostring(velocity1, format.mintick), text_color=white, bgcolor=bg, text_size=size.small)

    table.cell(t, 0, 1, "W2 Vel", text_color=white, bgcolor=bg, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(velocity2, format.mintick), text_color=white, bgcolor=bg, text_size=size.small)

    table.cell(t, 0, 2, "Ratio", text_color=white, bgcolor=bg, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(ratio, format.mintick), text_color=ratioColor, bgcolor=bg, text_size=size.small)

    table.cell(t, 0, 3, "Status", text_color=white, bgcolor=bg, text_size=size.small)
    table.cell(t, 1, 3, statusText, text_color=statusColor, bgcolor=bg, text_size=size.small)

    table.cell(t, 0, 4, "CCI@W2End", text_color=white, bgcolor=bg, text_size=size.small)
    table.cell(t, 1, 4, na(cciVal) ? "na" : str.tostring(cciVal, format.mintick), text_color=cciColor, bgcolor=bg, text_size=size.small)

    table.cell(t, 0, 5, "CCI Status", text_color=white, bgcolor=bg, text_size=size.small)
    table.cell(t, 1, 5, cciStatusText, text_color=cciStatusColor, bgcolor=bg, text_size=size.small)

    table.cell(t, 0, 6, "EMA@W2End", text_color=white, bgcolor=bg, text_size=size.small)
    table.cell(t, 1, 6, na(ema200_at_w2end) ? "na" : str.tostring(ema200_at_w2end, format.mintick), text_color=emaValColor, bgcolor=bg, text_size=size.small)

    table.cell(t, 0, 7, "EMA Status", text_color=white, bgcolor=bg, text_size=size.small)
    table.cell(t, 1, 7, emaStatusText, text_color=emaStatusColor, bgcolor=bg, text_size=size.small)
