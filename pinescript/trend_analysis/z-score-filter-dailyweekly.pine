//@version=6
indicator('Z-score filter Daily/Weekly', overlay = true)

// Inputs
timeframe = input.timeframe('D', title = 'Timeframe', options = ['D', 'W'])
length = input.int(defval = 21, title = 'Linear Regression Length')
offset = input.int(defval = 30, title = 'Linear Regression Offset')
lineoff = input.bool(defval = true, title = 'Plot Linear Regression Line?')
upper = input.float(defval = 5.1, title = 'Upper Threshold for Z-Score Triangles')
lower = input.float(defval = 4.7, title = 'Lower Threshold for Z-Score Triangles', minval = -10)

// Calculations
reg = ta.linreg(close, length, offset)
zscore = (close - reg) / ta.stdev(close, length)

// Signal logic
minima = ta.crossover(zscore, -lower)
maxima = ta.crossunder(zscore, upper)

// Colors
bullColor = color.new(color.green, 50)
bearColor = color.new(color.red, 50)

// Plotting
plot(lineoff ? reg : na, title = 'Linear Regression', color = color.blue)

plotshape(minima, title = 'Deep Value', style = shape.cross, location = location.belowbar, color = bullColor, text = 'BUY', textcolor = color.white, size = size.tiny)
plotshape(maxima, title = 'Over Value', style = shape.cross, location = location.abovebar, color = bearColor, text = 'SELL', size = size.tiny)

// Alerts
alertcondition(minima, title = 'Deep Value', message = 'Z-score filter: Deep Value Signal Detected')
alertcondition(maxima, title = 'Over Value', message = 'Z-score filter: Over Value Signal Detected')
