//@version=5
strategy(title="CDLTRD Strategy [JustUncleL] v0.1.3", shorttitle="CDLTRD v0.1.3", overlay=true, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1, currency=currency.USD)

// -----------------------------------------------------------------------------
// INPUTS
// -----------------------------------------------------------------------------
grp_size = "Position Sizing"
qty_contracts = input.int(1, title="Total Contracts to Trade", minval=1, group=grp_size)

grp_time = "Time Filters (New)"
use_window   = input.bool(true, title="Use Start/End Time Filter?", group=grp_time)
start_hour   = input.int(9, title="Start Hour (NY Time)", minval=0, maxval=23, group=grp_time)
start_min    = input.int(30, title="Start Minute", minval=0, maxval=59, group=grp_time)
end_hour     = input.int(16, title="End Hour (No New Entries)", minval=0, maxval=23, group=grp_time)
end_min      = input.int(0, title="End Minute", minval=0, maxval=59, group=grp_time)

grp_ma = "Moving Average Settings"
matype   = input.string(defval="HullMA", title="Fast MA Type", options=["SMA", "EMA", "WMA", "VWMA", "SMMA", "DEMA", "TEMA", "HullMA", "ZEMA", "TMA"], group=grp_ma)
malength = input.int(defval=20, title="Moving Average Length", minval=1, group=grp_ma)
src      = input(close, title="Moving Average Source", group=grp_ma)

grp_pat = "Pattern Settings"
ufb  = input.bool(false, title="Use Fractal S/R Cross", group=grp_pat)
udc  = input.bool(true, title="Use Dark Cloud Cover", group=grp_pat)
upl  = input.bool(true, title="Use Piercing Line", group=grp_pat)
ube  = input.bool(true, title="Use Engulfing Candle", group=grp_pat)
ubh  = input.bool(true, title="Use Harami Candle", group=grp_pat)
upb  = input.bool(true, title="Use Defined PinBar", group=grp_pat)
pctP = input.int(66, minval=1, maxval=99, title="PinBar Body %", group=grp_pat)

grp_pa = "Price Action (CM) Settings"
urpb = input.bool(false, title="Use Reversal Pin Bars", group=grp_pa)
usb  = input.bool(false, title="Use Shaved Bars", group=grp_pa)
uob  = input.bool(false, title="Use Outside Bars", group=grp_pa)
uib  = input.bool(false, title="Use Inside Bars", group=grp_pa)
pctRP= input.int(72, minval=1, maxval=99, title="Reversal PinBar %", group=grp_pa)
pctS = input.int(5, minval=1, maxval=99, title="Shaved Bar %", group=grp_pa)
pblb = input.int(6, minval=1, title="Pin Bar Lookback", group=grp_pa)

grp_flt = "Filters"
stnd   = input.bool(true, title="Trade Only With Trend (MA)", group=grp_flt)
umacd  = input.bool(true, title="Filter with MACD", group=grp_flt)
use_adx = input.bool(true, title="Filter Choppy Markets (ADX)", group=grp_flt)
adx_len = input.int(14, title="ADX Length", group=grp_flt)
adx_thresh = input.int(10, title="Min ADX Strength", group=grp_flt)
fastMA = input.int(12, title="MACD Fast", minval=2, group=grp_flt)
slowMA = input.int(26, title="MACD Slow", minval=7, group=grp_flt)
signal = input.int(9, title="MACD Signal", minval=1, group=grp_flt)

grp_strat = "Risk Management"
use_sl = input.bool(true, title="Use Fixed Stop Loss", group=grp_strat)
sl_pct = input.float(0.8, title="Fixed Stop Loss %", step=0.1, group=grp_strat)

use_tp1 = input.bool(false, title="Use Take Profit 1?", group=grp_strat)
tp1_pct = input.float(1.5, title="TP 1: Percent Gain %", step=0.1, group=grp_strat)
tp1_close = input.float(50.0, title="TP 1: % of Position to Close", step=10.0, group=grp_strat)
use_tp2 = input.bool(false, title="Use Take Profit 2 (Final)?", group=grp_strat)
tp2_pct = input.float(3.0, title="TP 2: Percent Gain %", step=0.1, group=grp_strat)

use_be = input.bool(true, title="Move to Breakeven?", group=grp_strat)
be_trig = input.float(0.6, title="BE Activation % (Move SL to Entry)", step=0.1, group=grp_strat)

use_trail = input.bool(true, title="Use Smart Trailing Stop", group=grp_strat)
trail_act = input.float(0.5, title="Trail Activation %", step=0.1, group=grp_strat)
trail_off = input.float(0.5, title="Trail Offset %", step=0.1, group=grp_strat)

grp_risk = "Prop Firm Protection"
max_daily_loss_pct = input.float(1.5, title="Max Daily Loss % (Stop Trading)", step=0.1, group=grp_risk)
use_time_exit = input.bool(true, title="Close All Trades at Time?", group=grp_risk)
exit_hour     = input.int(13, title="Exit Hour (NY Time 0-23)", minval=0, maxval=23, group=grp_risk)
exit_minute   = input.int(0, title="Exit Minute", minval=0, maxval=59, group=grp_risk)

// -----------------------------------------------------------------------------
// CALCULATIONS
// -----------------------------------------------------------------------------
variant(type, src, len) =>
    v1 = ta.sma(src, len)
    v2 = ta.ema(src, len)
    v3 = ta.wma(src, len)
    v4 = ta.vwma(src, len)
    v5 = 0.0
    v5 := na(v5[1]) ? ta.sma(src, len) : (v5[1] * (len - 1) + src) / len
    v6 = 2 * v2 - ta.ema(v2, len)
    v7 = 3 * (v2 - ta.ema(v2, len)) + ta.ema(ta.ema(v2, len), len)
    v8 = ta.wma(2 * ta.wma(src, len / 2) - ta.wma(src, len), math.round(math.sqrt(len)))
    ema1 = ta.ema(src, len)
    ema2 = ta.ema(ema1, len)
    v10 = ema1 + (ema1 - ema2)
    v11 = ta.sma(ta.sma(src, len), len)
    type=="EMA"?v2 : type=="WMA"?v3 : type=="VWMA"?v4 : type=="SMMA"?v5 : type=="DEMA"?v6 : type=="TEMA"?v7 : type=="HullMA"?v8 : type=="ZEMA"?v10 : type=="TMA"?v11 : v1

dmi(len, smooth) =>
    up_ = ta.change(high)
    down_ = -ta.change(low)
    plusDM = na(up_) ? na : (up_ > down_ and up_ > 0 ? up_ : 0)
    minusDM = na(down_) ? na : (down_ > up_ and down_ > 0 ? down_ : 0)
    tr_ = ta.rma(ta.tr, len)
    plus = fixnan(100 * ta.rma(plusDM, len) / tr_)
    minus = fixnan(100 * ta.rma(minusDM, len) / tr_)
    [plus, minus]

adx(dilen, adxlen) =>
    [plus, minus] = dmi(dilen, adxlen)
    sum = plus + minus
    adx_val = 100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), adxlen)
    adx_val

// Indicators
zlema = variant(matype, src, malength)
col   = zlema > zlema[1] ? color.green : color.red
up    = zlema > zlema[1]
down  = zlema < zlema[1]
plot(zlema, color=col, style=plot.style_line, linewidth=2, title="Trend MA")

adxValue = adx(adx_len, adx_len)
is_trending = use_adx ? (adxValue > adx_thresh) : true

topfractal = high[2] > high[1] and high[2] > high and high[2] > high[3] and high[2] > high[4]
botfractal = low[2] < low[1] and low[2] < low and low[2] < low[3] and low[2] < low[4]
var float topfractals = na
var float botfractals = na
if topfractal
    topfractals := high[2]
if botfractal
    botfractals := low[2]

[currMacd, _, _] = ta.macd(close, fastMA, slowMA, signal)
[prevMacd, _, _] = ta.macd(close[1], fastMA, slowMA, signal)
macdColor   = currMacd > 0 ? (currMacd > prevMacd ? color.green : color.red) : (currMacd < prevMacd ? color.red : color.green)

sbarUp = (not umacd or macdColor == color.green) and (not stnd or up) and is_trending
sbarDn = (not umacd or macdColor == color.red)   and (not stnd or down) and is_trending

range_  = high - low
pctCp   = pctP * .01
pctCs   = pctS * .01
pctCRp  = pctRP * .01
pctCRPO = 1 - pctCRp
pBarRUp = urpb and open > high - (range_ * pctCRPO) and close > high - (range_ * pctCRPO) and low <= ta.lowest(pblb)
pBarRDn = urpb and open < high - (range_ * pctCRp) and close < high - (range_ * pctCRp) and high >= ta.highest(pblb)
sBarUp   = usb and (close >= (high - (range_ * pctCs)))
sBarDown = usb and (close <= (low + (range_ * pctCs)))
insideBarUp  = uib and (high < high[1] and low > low[1])
insideBarDn  = uib and (high < high[1] and low > low[1])
outsideBarUp = uob and (high > high[1] and low < low[1])
outsideBarDn = uob and (high > high[1] and low < low[1])
pBarDn = upb and open < high - (range_ * pctCp) and close < high - (range_ * pctCp)
pBarUp = upb and open > low + (range_ * pctCp) and close > low + (range_ * pctCp)
dcc = udc and (close[1]>open[1] and math.abs(close[1]-open[1])/range_[1]>=0.7 and close<open and math.abs(close-open)/range_>=0.7 and open>=close[1] and close>open[1] and close<((open[1]+close[1])/2))
pln = upl and (close[1]<open[1] and math.abs(open[1]-close[1])/range_[1]>=0.7 and close>open and math.abs(close-open)/range_>=0.7 and open<=close[1] and close<open[1] and close>((open[1]+close[1])/2))
beh = ubh and (close[1] > open[1] and open > close and open <= close[1] and low >= open[1] and open - close < close[1] - open[1] and (high < high[1] and low > low[1]))
blh = ubh and (open[1] > close[1] and close > open and close <= open[1] and high <= open[1] and close - open < open[1] - close[1] and (high < high[1] and low > low[1]))
bee = ube and (close[1] > open[1] and close < open and close<=low[1] and open>= close[1])
ble = ube and (close[1] < open[1] and close > open and close >= high[1] and open<=close[1])
blfr = ufb and ta.crossover(close, topfractals)
befr = ufb and ta.crossunder(close, botfractals)

// -----------------------------------------------------------------------------
// TIME LOGIC (New Filter + Hard Stop)
// -----------------------------------------------------------------------------
t_hr = hour(time, "America/New_York")
t_min = minute(time, "America/New_York")
curr_time_val = t_hr * 60 + t_min
start_time_val = start_hour * 60 + start_min
end_time_val   = end_hour * 60 + end_min

// Is it inside the trading window?
is_in_window = use_window ? (curr_time_val >= start_time_val and curr_time_val < end_time_val) : true

// Is it time to Force Close everything?
is_time_to_close = use_time_exit and (t_hr == exit_hour and t_min >= exit_minute) or (t_hr > exit_hour)

var float start_day_equity = na
if (dayofmonth != dayofmonth[1])
    start_day_equity := strategy.equity 
current_daily_pl = strategy.equity - start_day_equity
max_loss_amount = start_day_equity * (max_daily_loss_pct / 100)
is_daily_limit_hit = current_daily_pl < -max_loss_amount

// Master Entry Permission
can_enter = is_in_window and (use_time_exit ? (t_hr < exit_hour) : true) and not is_daily_limit_hit

barAlertDn = (sbarDn and (befr or bee or beh or pBarDn or dcc)) or (sbarDn and (insideBarDn or outsideBarDn or sBarDown)) or pBarRDn
barAlertUp = (sbarUp and (blfr or ble or blh or pBarUp or pln)) or (sbarUp and (insideBarUp or outsideBarUp or sBarUp)) or pBarRUp

plotshape(barAlertDn and can_enter, title="Sell", style=shape.labeldown, location=location.abovebar, color=color.red, text="SELL", textcolor=color.white)
plotshape(barAlertUp and can_enter, title="Buy", style=shape.labelup, location=location.belowbar, color=color.green, text="BUY", textcolor=color.white)

// --- GHOST JSON STRINGS ---
qty_tp1 = math.ceil(qty_contracts * (tp1_close / 100))
buy_entry_msg  = '{"ticker": "' + syminfo.ticker + '", "action": "buy", "quantity": "' + str.tostring(qty_contracts) + '", "price": ' + str.tostring(close) + '}'
sell_entry_msg = '{"ticker": "' + syminfo.ticker + '", "action": "sell", "quantity": "' + str.tostring(qty_contracts) + '", "price": ' + str.tostring(close) + '}'
tp1_long_msg   = '{"ticker": "' + syminfo.ticker + '", "action": "sell", "quantity": "' + str.tostring(qty_tp1) + '"}'
tp1_short_msg  = '{"ticker": "' + syminfo.ticker + '", "action": "buy", "quantity": "' + str.tostring(qty_tp1) + '"}'
exit_msg       = '{"ticker": "' + syminfo.ticker + '", "action": "exit"}'

// ENTRIES
if barAlertUp and can_enter
    strategy.entry("Long", strategy.long, qty=qty_contracts, alert_message=buy_entry_msg)

if barAlertDn and can_enter
    strategy.entry("Short", strategy.short, qty=qty_contracts, alert_message=sell_entry_msg)

// TIME EXIT
if is_time_to_close
    strategy.close_all(comment="Time Exit", alert_message=exit_msg)

// --- EXIT LOGIC ---
long_trail_price = strategy.position_avg_price * (1 + trail_act/100)
short_trail_price = strategy.position_avg_price * (1 - trail_act/100)
float long_stop = na
float short_stop = na

if strategy.position_size > 0
    if high > strategy.position_avg_price * (1 + be_trig/100) and use_be
        long_stop := strategy.position_avg_price
    else
        long_stop := strategy.position_avg_price * (1 - sl_pct/100)
    
    if use_tp1
        strategy.exit("TP1 Long", "Long", qty=qty_tp1, limit=strategy.position_avg_price * (1 + tp1_pct/100), stop=long_stop, alert_message=tp1_long_msg)
    
    strategy.exit("TP2/Trail Long", "Long", limit = use_tp2 ? strategy.position_avg_price * (1 + tp2_pct/100) : na, stop = long_stop, trail_price = use_trail ? long_trail_price : na, trail_offset = use_trail ? strategy.position_avg_price * (trail_off/100) : na, alert_message=exit_msg)

if strategy.position_size < 0
    if low < strategy.position_avg_price * (1 - be_trig/100) and use_be
        short_stop := strategy.position_avg_price
    else
        short_stop := strategy.position_avg_price * (1 + sl_pct/100)

    if use_tp1
        strategy.exit("TP1 Short", "Short", qty=qty_tp1, limit=strategy.position_avg_price * (1 - tp1_pct/100), stop=short_stop, alert_message=tp1_short_msg)
    
    strategy.exit("TP2/Trail Short", "Short", limit = use_tp2 ? strategy.position_avg_price * (1 - tp2_pct/100) : na, stop = short_stop, trail_price = use_trail ? short_trail_price : na, trail_offset = use_trail ? strategy.position_avg_price * (trail_off/100) : na, alert_message=exit_msg)

plotchar(is_daily_limit_hit, "Daily Limit Hit", "X", location.top, color.red, size = size.tiny)
