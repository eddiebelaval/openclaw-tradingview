//@version=6
indicator("Ants Indicator [MVP]", overlay=true, shorttitle="Ants MVP Pro", max_labels_count=500)

// --- User Settings (Inputs) ---
LookbackPeriod = input.int(15, title="Lookback Period (Days)", minval=1)
MomentumDays = input.int(12, title="Minimum Up Days (Momentum)", minval=1)
VolIncreasePct = input.int(20, title="Volume Increase (%)", minval=1)
PriceIncreasePct = input.int(20, title="Price Increase (%)", minval=1)
VolMA_Length = input.int(50, title="Volume MA Length for Comparison", minval=1)

// --- Calculations ---

// 1. Momentum Check: Count green days in the last 15 days
green_days_count = math.sum(close > close[1] ? 1 : 0, LookbackPeriod)
is_momentum = green_days_count >= MomentumDays

// 2. Volume Check: Is the 15-day avg volume X% greater than the 50-day avg volume
vol_sma_short = ta.sma(volume, LookbackPeriod)
vol_sma_long = ta.sma(volume, VolMA_Length)
vol_change_pct = ((vol_sma_short - vol_sma_long) / vol_sma_long) * 100
is_volume = vol_change_pct >= VolIncreasePct

// 3. Price Check: Is the current price X% higher than 15 days ago
price_change_pct = ((close - close[LookbackPeriod]) / close[LookbackPeriod]) * 100
is_price = price_change_pct >= PriceIncreasePct

// --- Extension Stats (for Topping Detection) ---
sma50 = ta.sma(close, 50)
dist_from_sma50_pct = ((close - sma50) / sma50) * 100
atr_val = ta.atr(14)
atr_multiple = (close - sma50) / atr_val

// --- Ant Color Logic ---
var color ant_color = na

// Green: All conditions met (MVP)
is_green_ant = is_momentum and is_volume and is_price
// Yellow: Momentum + Volume (missing Price)
is_yellow_ant = is_momentum and is_volume and not is_price
// Blue: Momentum + Price (missing Volume)
is_blue_ant = is_momentum and is_price and not is_volume
// Gray: Momentum only
is_gray_ant = is_momentum and not is_volume and not is_price

if is_green_ant
    ant_color := color.new(color.lime, 0)
else if is_yellow_ant
    ant_color := color.new(color.yellow, 0)
else if is_blue_ant
    ant_color := color.new(color.blue, 0)
else if is_gray_ant
    ant_color := color.new(color.gray, 0)
else
    ant_color := na

// --- Tooltip Text ---
tooltip_text = "🐜 Ants MVP Stats:\n" +
               "--------------------------\n" +
               "📈 Close Up: " + str.tostring(green_days_count) + "/" + str.tostring(LookbackPeriod) + "\n" +
               "📊 Volume % Change: " + str.tostring(vol_change_pct, "#.1") + "%\n" +
               "💰 Price % Change: " + str.tostring(price_change_pct, "#.1") + "%\n" +
               "\n⚠️ Topping / Extension Signals:\n" +
               "From 50-SMA: " + str.tostring(dist_from_sma50_pct, "#.1") + "%\n" +
               "ATR Multiple: " + str.tostring(atr_multiple, "#.1") + "x"

// --- Plot on Chart ---
// Using "♦" text character instead of built-in shape, to minimize label size
if is_momentum
    label.new(bar_index, high, text="♦", yloc=yloc.abovebar, color=color.new(color.white, 100), textcolor=ant_color, style=label.style_none, size=size.tiny, tooltip=tooltip_text)

// Moving Averages
plot(ta.ema(close, 10), "10 EMA", color=color.new(#00bcd4, 0))
plot(ta.ema(close, 21), "21 EMA", color=color.new(#ff9800, 0))
plot(sma50, "50 SMA", color=color.new(#f44336, 0), linewidth=2)
