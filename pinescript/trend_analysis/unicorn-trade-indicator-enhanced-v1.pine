//@version=5
indicator("Unicorn Trade Indicator - Enhanced V1", overlay=true, max_boxes_count=100)


// Settings
enableUnicornAlerts = input.bool(true, "Enable Unicorn Alerts", group="Alerts")

// Define bullish and bearish candles
isBullish = close > open
isBearish = close < open

// Variables to track the pattern (RED BOX - ORIGINAL)
var int firstBearishBar = na
var int lastBearishBar = na
var float bearishSeriesHigh = na
var float bearishSeriesLow = na
var bool boxDrawn = false

// Variables to track bullish series (GREEN BOX - NEW)
var int firstBullishBar = na
var int lastBullishBar = na
var float bullishSeriesHigh = na
var float bullishSeriesLow = na
var bool greenBoxDrawn = false

// Variables to track if unicorn labels have been placed for current boxes
var bool redBoxUnicornPlaced = false
var bool greenBoxUnicornPlaced = false

// Variables to track the current box creation bar index
var int currentRedBoxCreatedAt = na
var int currentGreenBoxCreatedAt = na

// Function to detect Bearish FVG
isBearishFVG() =>
    // Bearish FVG: gap where candle 2 back has low higher than current candle's high (downward gap)
    low[2] > high

// Function to detect Bullish FVG
isBullishFVG() =>
    // Bullish FVG: gap where candle 2 back has high lower than current candle's low (upward gap)
    high[2] < low

// Detect FVG patterns
currentBearishFVG = isBearishFVG()
currentBullishFVG = isBullishFVG()

// Track bearish candles that form before a swing high (BEARISH BREAKER BLOCK)
if isBearish
    if na(firstBearishBar) or not isBearish[1]
        // Start of a new bearish series
        firstBearishBar := bar_index
        bearishSeriesHigh := high
        bearishSeriesLow := low
        boxDrawn := false
    else
        // Continue bearish series, update high and low
        bearishSeriesHigh := math.max(bearishSeriesHigh, high)
        bearishSeriesLow := math.min(bearishSeriesLow, low)
    lastBearishBar := bar_index

// Track bullish candles that form before a swing low (BULLISH BREAKER BLOCK)
if isBullish
    if na(firstBullishBar) or not isBullish[1]
        // Start of a new bullish series
        firstBullishBar := bar_index
        bullishSeriesHigh := high
        bullishSeriesLow := low
        greenBoxDrawn := false
    else
        // Continue bullish series, update high and low
        bullishSeriesHigh := math.max(bullishSeriesHigh, high)
        bullishSeriesLow := math.min(bullishSeriesLow, low)
    lastBullishBar := bar_index

// Detect swing high formation using wick extremes - triggers bearish breaker block (RED BOX)
// When price makes a new swing high, it breaks above the last bearish series
swingHigh = high > math.max(high[1], high[2]) and high > math.max(high[3], high[4])
bullishAboveBearish = swingHigh and not na(bearishSeriesHigh) and high > bearishSeriesHigh and not boxDrawn

// Detect swing low formation using wick extremes - triggers bullish breaker block (GREEN BOX)  
// When price makes a new swing low, it breaks below the last bullish series
// Special handling: if current candle is bullish and creates swing low, use previous bullish series
swingLow = low < math.min(low[1], low[2]) and low < math.min(low[3], low[4])
bearishBelowBullish = swingLow and not na(bullishSeriesLow) and low < bullishSeriesLow and not greenBoxDrawn and not isBullish
// Also trigger if swing low occurs and we have a bullish series that ended on previous bar
bearishBelowBullishAlt = swingLow and not na(bullishSeriesLow) and low < bullishSeriesLow and not greenBoxDrawn and isBullish and isBullish[1]

// Variables to store the current boxes and previous boxes
var box currentBox = na
var box currentGreenBox = na
var box previousBox1 = na
var box previousBox2 = na
var box previousGreenBox1 = na
var box previousGreenBox2 = na

// Function to create a box around the entire swing low series (RED BOX)
createBoxForBearishCandle() =>
    // Calculate box coordinates for the entire swing low series
    leftBar = firstBearishBar
    rightBar = lastBearishBar + 5
    topPrice = bearishSeriesHigh
    bottomPrice = bearishSeriesLow
    
    // Create the box
    box.new(left=leftBar, top=topPrice, right=rightBar, bottom=bottomPrice, border_color=color.red, bgcolor=color.new(color.red, 85), border_width=2, border_style=line.style_solid, text="BB", text_color=color.black, text_size=size.small)

// Function to create a previous box with darker shade (PBB)
createPreviousBox(leftBar, rightBar, topPrice, bottomPrice) =>
    box.new(left=leftBar, top=topPrice, right=rightBar, bottom=bottomPrice, border_color=color.new(color.red, 30), bgcolor=color.new(color.red, 90), border_width=1, border_style=line.style_dashed, text="PBB", text_color=color.black, text_size=size.small)

// Function to create a previous green box with darker shade (PBB)
createPreviousGreenBox(leftBar, rightBar, topPrice, bottomPrice) =>
    box.new(left=leftBar, top=topPrice, right=rightBar, bottom=bottomPrice, border_color=color.new(color.green, 30), bgcolor=color.new(color.green, 90), border_width=1, border_style=line.style_dashed, text="PBB", text_color=color.black, text_size=size.small)

// Function to create a green box around the entire swing high series (GREEN BOX)
createGreenBoxForBullishSeries() =>
    // Calculate box coordinates for the entire swing high series
    leftBar = firstBullishBar
    rightBar = lastBullishBar + 5
    topPrice = bullishSeriesHigh
    bottomPrice = bullishSeriesLow
    
    // Create the green box
    box.new(left=leftBar, top=topPrice, right=rightBar, bottom=bottomPrice, border_color=color.green, bgcolor=color.new(color.green, 85), border_width=2, border_style=line.style_solid, text="BB", text_color=color.black, text_size=size.small)

// Main logic for RED BOX
if bullishAboveBearish
    // Store current box coordinates before creating new one
    currentLeftBar = firstBearishBar
    currentRightBar = lastBearishBar + 5
    currentTopPrice = bearishSeriesHigh
    currentBottomPrice = bearishSeriesLow
    
    // Delete the oldest previous box (previousBox2) to make room for new one
    if not na(previousBox2)
        box.delete(previousBox2)
    
    // Shift previous boxes: previousBox1 becomes previousBox2
    previousBox2 := previousBox1
    
    // Convert current box to previousBox1 if it exists
    if not na(currentBox)
        // Get the properties of the current box to recreate it as previous
        currentBoxLeft = box.get_left(currentBox)
        currentBoxRight = box.get_right(currentBox)
        currentBoxTop = box.get_top(currentBox)
        currentBoxBottom = box.get_bottom(currentBox)
        
        // Create new previous box with the current box coordinates
        previousBox1 := createPreviousBox(currentBoxLeft, currentBoxRight, currentBoxTop, currentBoxBottom)
        
        // Delete the current box
        box.delete(currentBox)
    
    // Create new current box
    currentBox := createBoxForBearishCandle()
    boxDrawn := true
    
    // Reset unicorn label flag for new red box and track creation time
    redBoxUnicornPlaced := false
    currentRedBoxCreatedAt := bar_index

// Main logic for GREEN BOX
if bearishBelowBullish or bearishBelowBullishAlt
    // Delete the oldest previous green box (previousGreenBox2) to make room for new one
    if not na(previousGreenBox2)
        box.delete(previousGreenBox2)
    
    // Shift previous green boxes: previousGreenBox1 becomes previousGreenBox2
    previousGreenBox2 := previousGreenBox1
    
    // Convert current green box to previousGreenBox1 if it exists
    if not na(currentGreenBox)
        // Get the properties of the current green box to recreate it as previous
        currentGreenBoxLeft = box.get_left(currentGreenBox)
        currentGreenBoxRight = box.get_right(currentGreenBox)
        currentGreenBoxTop = box.get_top(currentGreenBox)
        currentGreenBoxBottom = box.get_bottom(currentGreenBox)
        
        // Create new previous green box with the current green box coordinates
        previousGreenBox1 := createPreviousGreenBox(currentGreenBoxLeft, currentGreenBoxRight, currentGreenBoxTop, currentGreenBoxBottom)
        
        // Delete the current green box
        box.delete(currentGreenBox)
    
    // Special handling for bullish candle creating swing low
    if bearishBelowBullishAlt
        // Adjust the lastBullishBar to exclude the current bullish candle that created the swing low
        lastBullishBar := bar_index - 1
    
    // Create new current green box
    currentGreenBox := createGreenBoxForBullishSeries()
    greenBoxDrawn := true
    
    // Reset unicorn label flag for new green box and track creation time
    greenBoxUnicornPlaced := false
    currentGreenBoxCreatedAt := bar_index

// DISPLACEMENT (YELLOW CANDLE) LOGIC - Moved up to calculate before unicorn conditions
require_fvg = input.bool(true, "Require FVG")
disp_type = input.string("Open to Close", "Displacement Type", options = ['Open to Close', 'High to Low'])
std_len = input.int(100, minval = 1, title = "Displacement Length", tooltip = "How far back the script will look to determine the candle range standard deviation")
std_x = input.int(4, minval = 0, title = "Displacement Strength")
disp_color = input.color(color.yellow, "Bar Color")

candle_range = disp_type == "Open to Close" ? math.abs(open - close) : high - low
std = ta.stdev(candle_range, std_len) * std_x
fvg = close[1] > open[1] ? high[2] < low[0] : low[2] > high[0]

displacement = require_fvg ? candle_range[1] > std[1] and fvg : candle_range > std

// Check if the current candle is a displacement (yellow) candle
isYellowCandle = displacement and not require_fvg
isPreviousYellowCandle = displacement[1] and require_fvg

// UNICORN LABEL LOGIC - Updated to check ANY of the 3 candles in FVG sequence
// Bearish Unicorn: ANY candle in bearish FVG sequence passes through the bottom of the current red box
redBoxUnicornCondition = not na(currentBox) and not redBoxUnicornPlaced and not na(currentRedBoxCreatedAt) and
                         currentBearishFVG and bar_index > currentRedBoxCreatedAt and
                         (
                             // Check candle 1 (current candle, index 0)
                             (low < box.get_bottom(currentBox) and high > box.get_bottom(currentBox)) or
                             // Check candle 2 (middle candle, index 1)
                             (low[1] < box.get_bottom(currentBox) and high[1] > box.get_bottom(currentBox)) or
                             // Check candle 3 (oldest candle, index 2)
                             (low[2] < box.get_bottom(currentBox) and high[2] > box.get_bottom(currentBox))
                         )

// Bullish Unicorn: ANY candle in bullish FVG sequence passes through the top of the current green box  
greenBoxUnicornCondition = not na(currentGreenBox) and not greenBoxUnicornPlaced and not na(currentGreenBoxCreatedAt) and
                          currentBullishFVG and bar_index > currentGreenBoxCreatedAt and
                          (
                              // Check candle 1 (current candle, index 0)
                              (high > box.get_top(currentGreenBox) and low < box.get_top(currentGreenBox)) or
                              // Check candle 2 (middle candle, index 1)
                              (high[1] > box.get_top(currentGreenBox) and low[1] < box.get_top(currentGreenBox)) or
                              // Check candle 3 (oldest candle, index 2)
                              (high[2] > box.get_top(currentGreenBox) and low[2] < box.get_top(currentGreenBox))
                          )

// Place Unicorn label above red box when ANY candle of bearish FVG trades through it (labels persist)
if redBoxUnicornCondition
    label.new(bar_index, box.get_top(currentBox) + (box.get_top(currentBox) - box.get_bottom(currentBox)) * 0.1, 
              "🦄", style=label.style_label_down, color=color.purple, textcolor=color.white, size=size.small)
    redBoxUnicornPlaced := true

// Place Unicorn label below green box when ANY candle of bullish FVG trades through it (labels persist)
if greenBoxUnicornCondition
    label.new(bar_index, box.get_bottom(currentGreenBox) - (box.get_top(currentGreenBox) - box.get_bottom(currentGreenBox)) * 0.1, 
              "🦄", style=label.style_label_up, color=color.purple, textcolor=color.white, size=size.small)
    greenBoxUnicornPlaced := true

// MODIFIED ALERTS - Only trigger when unicorn occurs on a yellow candle
// For bearish unicorn: check if current candle or any of the FVG candles is a yellow candle
bearishUnicornOnYellow = redBoxUnicornCondition and ((require_fvg ? isPreviousYellowCandle : isYellowCandle) or (require_fvg ? displacement[2] : displacement[1]) or (require_fvg ? displacement[3] : displacement[2]))

// For bullish unicorn: check if current candle or any of the FVG candles is a yellow candle
bullishUnicornOnYellow = greenBoxUnicornCondition and ((require_fvg ? isPreviousYellowCandle : isYellowCandle) or (require_fvg ? displacement[2] : displacement[1]) or (require_fvg ? displacement[3] : displacement[2]))

if enableUnicornAlerts and bearishUnicornOnYellow
    alert("🦄 Bearish Unicorn on Yellow Candle", alert.freq_once_per_bar)

if enableUnicornAlerts and bullishUnicornOnYellow
    alert("🦄 Bullish Unicorn on Yellow Candle", alert.freq_once_per_bar)

// Apply yellow bar color for displacement candles
barcolor(displacement ? disp_color : na, offset = require_fvg ? -1 : na)

// Input parameters
show_fibo_levels = input.bool(false, "Show Fibonacci Levels")
show_boxes = input.bool(true, "Show Yellow Boxes")
show_green_boxes = input.bool(true, "Show Green Boxes")
show_range_lines = input.bool(true, "Show Range Lines")
show_green_range_lines = input.bool(true, "Show Green Range Lines")
box_transparency = input.int(80, "Box Transparency", minval=0, maxval=100)

// Toggle controls for FVG and BPR
// show_fvg = input.bool(true, "Show FVG")  // REMOVED - FVG toggle hidden from settings
show_fvg = true  // Set to true by default, no user control
show_bpr = input.bool(true, "Show BPR")

// Range line styling inputs
range_line_color = input.color(color.blue, "Range Line Color")
range_line_width = input.int(2, "Range Line Width", minval=1, maxval=5)
range_line_style = input.string("Solid", "Range Line Style", options=["Solid", "Dashed", "Dotted"])

// Green range line styling inputs
green_range_line_color = input.color(color.green, "Green Range Line Color")
green_range_line_width = input.int(2, "Green Range Line Width", minval=1, maxval=5)
green_range_line_style = input.string("Solid", "Green Range Line Style", options=["Solid", "Dashed", "Dotted"])

// Time range inputs for first range (9:30-10:00)
start_hour = input.int(9, "Start Hour", minval=0, maxval=23)
start_minute = input.int(30, "Start Minute", minval=0, maxval=59)
end_hour = input.int(10, "End Hour", minval=0, maxval=23)
end_minute = input.int(0, "End Minute", minval=0, maxval=59)

// Time range inputs for second range (5:00-9:15)
green_start_hour = input.int(5, "Green Start Hour", minval=0, maxval=23)
green_start_minute = input.int(0, "Green Start Minute", minval=0, maxval=59)
green_end_hour = input.int(9, "Green End Hour", minval=0, maxval=23)
green_end_minute = input.int(15, "Green End Minute", minval=0, maxval=59)

// Variables to store range high and low for first range (yellow)
var float range_high = na
var float range_low = na
var bool range_found = false
var bool prev_in_range = false
var line range_high_line = na
var line range_low_line = na
var int range_start_bar = na
var box[] boxes_array = array.new<box>()
var int current_day = na

// Variables to store range high and low for second range (green)
var float green_range_high = na
var float green_range_low = na
var bool green_range_found = false
var bool prev_green_in_range = false
var line green_range_high_line = na
var line green_range_low_line = na
var int green_range_start_bar = na
var box[] green_boxes_array = array.new<box>()

// Define the time ranges (all in New York EST/EDT)
start_time_str = str.format("{0,number,00}{1,number,00}", start_hour, start_minute)
end_time_str = str.format("{0,number,00}{1,number,00}", end_hour, end_minute)
time_range_str = start_time_str + "-" + end_time_str

green_start_time_str = str.format("{0,number,00}{1,number,00}", green_start_hour, green_start_minute)
green_end_time_str = str.format("{0,number,00}{1,number,00}", green_end_hour, green_end_minute)
green_time_range_str = green_start_time_str + "-" + green_end_time_str

ny_time = time(timeframe.period, time_range_str, "America/New_York")
is_in_range = not na(ny_time)

green_ny_time = time(timeframe.period, green_time_range_str, "America/New_York")
is_in_green_range = not na(green_ny_time)

// New York session close: 16:00 EST (4:00 PM)
ny_close_time = time(timeframe.period, "1600-1600", "America/New_York")
is_ny_close = not na(ny_close_time)

// Check for new trading day - using dayofmonth change for more reliable detection
is_new_day = na(current_day) or dayofmonth != current_day

// Reset variables on new day
if is_new_day
    // Update current day tracker
    current_day := dayofmonth
    
    // Reset yellow range variables
    range_high := na
    range_low := na
    range_found := false
    range_start_bar := na
    
    // Reset green range variables
    green_range_high := na
    green_range_low := na
    green_range_found := false
    green_range_start_bar := na
    
    // Delete previous yellow lines
    if not na(range_high_line)
        line.delete(range_high_line)
        range_high_line := na
    if not na(range_low_line)
        line.delete(range_low_line)
        range_low_line := na
    
    // Delete previous green lines
    if not na(green_range_high_line)
        line.delete(green_range_high_line)
        green_range_high_line := na
    if not na(green_range_low_line)
        line.delete(green_range_low_line)
        green_range_low_line := na
    
    // Delete all previous yellow boxes
    if array.size(boxes_array) > 0
        for i = array.size(boxes_array) - 1 to 0
            if not na(array.get(boxes_array, i))
                box.delete(array.get(boxes_array, i))
        array.clear(boxes_array)
    
    // Delete all previous green boxes
    if array.size(green_boxes_array) > 0
        for i = array.size(green_boxes_array) - 1 to 0
            if not na(array.get(green_boxes_array, i))
                box.delete(array.get(green_boxes_array, i))
        array.clear(green_boxes_array)

// Track yellow range during specified time period (9:30-10:00)
if is_in_range
    // Store the first bar of the range period
    if na(range_start_bar)
        range_start_bar := bar_index
    
    if na(range_high) or na(range_low)
        range_high := high
        range_low := low
    else
        range_high := math.max(range_high, high)
        range_low := math.min(range_low, low)

// Track green range during specified time period (5:00-9:00)
if is_in_green_range
    // Store the first bar of the green range period
    if na(green_range_start_bar)
        green_range_start_bar := bar_index
    
    if na(green_range_high) or na(green_range_low)
        green_range_high := high
        green_range_low := low
    else
        green_range_high := math.max(green_range_high, high)
        green_range_low := math.min(green_range_low, low)

// Mark when yellow range is complete
range_complete = not is_in_range and prev_in_range and not na(range_high) and not na(range_low)

// Mark when green range is complete
green_range_complete = not is_in_green_range and prev_green_in_range and not na(green_range_high) and not na(green_range_low)

// Convert line style string to Pine Script line style
get_line_style() =>
    if range_line_style == "Solid"
        line.style_solid
    else if range_line_style == "Dashed"
        line.style_dashed
    else if range_line_style == "Dotted"
        line.style_dotted
    else
        line.style_solid

// Convert green line style string to Pine Script line style
get_green_line_style() =>
    if green_range_line_style == "Solid"
        line.style_solid
    else if green_range_line_style == "Dashed"
        line.style_dashed
    else if green_range_line_style == "Dotted"
        line.style_dotted
    else
        line.style_solid

// Create horizontal lines when yellow range is complete
if range_complete and show_range_lines
    // Delete previous lines if they exist
    if not na(range_high_line)
        line.delete(range_high_line)
    if not na(range_low_line)
        line.delete(range_low_line)
    
    // Create new horizontal lines extending to the right
    range_high_line := line.new(bar_index, range_high, bar_index + 100, range_high, color=range_line_color, width=range_line_width, style=get_line_style(), extend=extend.right)
    range_low_line := line.new(bar_index, range_low, bar_index + 100, range_low, color=range_line_color, width=range_line_width, style=get_line_style(), extend=extend.right)

// Create horizontal lines when green range is complete
if green_range_complete and show_green_range_lines
    // Delete previous green lines if they exist
    if not na(green_range_high_line)
        line.delete(green_range_high_line)
    if not na(green_range_low_line)
        line.delete(green_range_low_line)
    
    // Create new horizontal lines extending to the right
    green_range_high_line := line.new(bar_index, green_range_high, bar_index + 100, green_range_high, color=green_range_line_color, width=green_range_line_width, style=get_green_line_style(), extend=extend.right)
    green_range_low_line := line.new(bar_index, green_range_low, bar_index + 100, green_range_low, color=green_range_line_color, width=green_range_line_width, style=get_green_line_style(), extend=extend.right)

// Calculate Fibonacci levels only when yellow range is available
fibo_diff = not na(range_high) and not na(range_low) ? range_high - range_low : na

// Extended Fibonacci levels for yellow boxes
fibo_125 = not na(range_high) and not na(fibo_diff) ? range_high + (fibo_diff * 1.25) : na
fibo_150 = not na(range_high) and not na(fibo_diff) ? range_high + (fibo_diff * 1.50) : na
fibo_200 = not na(range_high) and not na(fibo_diff) ? range_high + (fibo_diff * 2.00) : na
fibo_225 = not na(range_high) and not na(fibo_diff) ? range_high + (fibo_diff * 2.25) : na
fibo_neg25 = not na(range_low) and not na(fibo_diff) ? range_low - (fibo_diff * 0.25) : na
fibo_neg50 = not na(range_low) and not na(fibo_diff) ? range_low - (fibo_diff * 0.50) : na
fibo_neg100 = not na(range_low) and not na(fibo_diff) ? range_low - (fibo_diff * 1.00) : na
fibo_neg125 = not na(range_low) and not na(fibo_diff) ? range_low - (fibo_diff * 1.25) : na

// Calculate Fibonacci levels for green range
green_fibo_diff = not na(green_range_high) and not na(green_range_low) ? green_range_high - green_range_low : na

// Extended Fibonacci levels for green boxes
green_fibo_125 = not na(green_range_high) and not na(green_fibo_diff) ? green_range_high + (green_fibo_diff * 1.25) : na
green_fibo_150 = not na(green_range_high) and not na(green_fibo_diff) ? green_range_high + (green_fibo_diff * 1.50) : na
green_fibo_200 = not na(green_range_high) and not na(green_fibo_diff) ? green_range_high + (green_fibo_diff * 2.00) : na
green_fibo_225 = not na(green_range_high) and not na(green_fibo_diff) ? green_range_high + (green_fibo_diff * 2.25) : na
green_fibo_neg25 = not na(green_range_low) and not na(green_fibo_diff) ? green_range_low - (green_fibo_diff * 0.25) : na
green_fibo_neg50 = not na(green_range_low) and not na(green_fibo_diff) ? green_range_low - (green_fibo_diff * 0.50) : na
green_fibo_neg100 = not na(green_range_low) and not na(green_fibo_diff) ? green_range_low - (green_fibo_diff * 1.00) : na
green_fibo_neg125 = not na(green_range_low) and not na(green_fibo_diff) ? green_range_low - (green_fibo_diff * 1.25) : na

// Standard Fibonacci levels for yellow range
fibo_0 = range_low
fibo_236 = not na(range_low) and not na(fibo_diff) ? range_low + (fibo_diff * 0.236) : na
fibo_382 = not na(range_low) and not na(fibo_diff) ? range_low + (fibo_diff * 0.382) : na
fibo_50 = not na(range_low) and not na(fibo_diff) ? range_low + (fibo_diff * 0.50) : na
fibo_618 = not na(range_low) and not na(fibo_diff) ? range_low + (fibo_diff * 0.618) : na
fibo_786 = not na(range_low) and not na(fibo_diff) ? range_low + (fibo_diff * 0.786) : na
fibo_100 = range_high

// Plot standard Fibonacci levels
plot(show_fibo_levels ? fibo_0 : na, "0%", color=color.gray, linewidth=1)
plot(show_fibo_levels ? fibo_236 : na, "23.6%", color=color.gray, linewidth=1)
plot(show_fibo_levels ? fibo_382 : na, "38.2%", color=color.gray, linewidth=1)
plot(show_fibo_levels ? fibo_50 : na, "50%", color=color.gray, linewidth=1)
plot(show_fibo_levels ? fibo_618 : na, "61.8%", color=color.gray, linewidth=1)
plot(show_fibo_levels ? fibo_786 : na, "78.6%", color=color.gray, linewidth=1)
plot(show_fibo_levels ? fibo_100 : na, "100%", color=color.gray, linewidth=1)

// Plot extended Fibonacci levels
plot(show_fibo_levels ? fibo_125 : na, "125%", color=color.red, linewidth=1)
plot(show_fibo_levels ? fibo_150 : na, "150%", color=color.red, linewidth=1)
plot(show_fibo_levels ? fibo_200 : na, "200%", color=color.red, linewidth=1)
plot(show_fibo_levels ? fibo_225 : na, "225%", color=color.red, linewidth=1)
plot(show_fibo_levels ? fibo_neg25 : na, "-25%", color=color.blue, linewidth=1)
plot(show_fibo_levels ? fibo_neg50 : na, "-50%", color=color.blue, linewidth=1)
plot(show_fibo_levels ? fibo_neg100 : na, "-100%", color=color.blue, linewidth=1)
plot(show_fibo_levels ? fibo_neg125 : na, "-125%", color=color.blue, linewidth=1)

// Create yellow boxes when range is complete
if range_complete and show_boxes and not na(range_start_bar)
    // Calculate 10:00 AM bar index (end of range period)
    range_end_bar = bar_index
    
    // Calculate box extension from 10:00 AM to New York close (16:00 EST)
    // Extend boxes to approximately 6 hours from 10:00 AM to 16:00 PM
    box_extension = 360 // approximately 6 hours in 1-minute bars
    
    // Positive boxes (mirroring negative box ranges)
    // Box 1: Between +25% and +50% Fibo levels (mirrors Box 3)
    fibo_25 = not na(range_high) and not na(fibo_diff) ? range_high + (fibo_diff * 0.25) : na
    fibo_pos50 = not na(range_high) and not na(fibo_diff) ? range_high + (fibo_diff * 0.50) : na
    if not na(fibo_25) and not na(fibo_pos50)
        new_box1 = box.new(range_end_bar, fibo_25, range_end_bar + box_extension, fibo_pos50, 
                          bgcolor=color.new(color.yellow, box_transparency), 
                          border_color=color.yellow, 
                          border_width=1)
        array.push(boxes_array, new_box1)
    
    // Box 2: Between +100% and +125% Fibo levels (mirrors Box 4)
    fibo_pos100 = not na(range_high) and not na(fibo_diff) ? range_high + (fibo_diff * 1.00) : na
    if not na(fibo_pos100) and not na(fibo_125)
        new_box2 = box.new(range_end_bar, fibo_pos100, range_end_bar + box_extension, fibo_125, 
                          bgcolor=color.new(color.yellow, box_transparency), 
                          border_color=color.yellow, 
                          border_width=1)
        array.push(boxes_array, new_box2)
    
    // Negative boxes (original)
    // Box 3: Between -25% and -50% Fibo levels
    if not na(fibo_neg25) and not na(fibo_neg50)
        new_box3 = box.new(range_end_bar, fibo_neg25, range_end_bar + box_extension, fibo_neg50, 
                          bgcolor=color.new(color.yellow, box_transparency), 
                          border_color=color.yellow, 
                          border_width=1)
        array.push(boxes_array, new_box3)
    
    // Box 4: Between -100% and -125% Fibo levels
    if not na(fibo_neg100) and not na(fibo_neg125)
        new_box4 = box.new(range_end_bar, fibo_neg100, range_end_bar + box_extension, fibo_neg125, 
                          bgcolor=color.new(color.yellow, box_transparency), 
                          border_color=color.yellow, 
                          border_width=1)
        array.push(boxes_array, new_box4)

// Create green boxes when green range is complete
if green_range_complete and show_green_boxes and not na(green_range_start_bar)
    // Calculate end of green range period (9:15 AM)
    green_range_end_bar = bar_index
    
    // Calculate box extension from 9:15 AM to New York close (16:00 EST)
    // Extend boxes to approximately 6.75 hours from 9:15 AM to 16:00 PM
    green_box_extension = 405 // approximately 6.75 hours in 1-minute bars
    
    // Positive green boxes
    // Green Box 1: Between +25% and +50% Fibo levels
    green_fibo_25 = not na(green_range_high) and not na(green_fibo_diff) ? green_range_high + (green_fibo_diff * 0.25) : na
    green_fibo_pos50 = not na(green_range_high) and not na(green_fibo_diff) ? green_range_high + (green_fibo_diff * 0.50) : na
    if not na(green_fibo_25) and not na(green_fibo_pos50)
        new_green_box1 = box.new(green_range_end_bar, green_fibo_25, green_range_end_bar + green_box_extension, green_fibo_pos50, 
                          bgcolor=color.new(color.green, box_transparency), 
                          border_color=color.green, 
                          border_width=1)
        array.push(green_boxes_array, new_green_box1)
    
    // Green Box 2: Between +100% and +125% Fibo levels
    green_fibo_pos100 = not na(green_range_high) and not na(green_fibo_diff) ? green_range_high + (green_fibo_diff * 1.00) : na
    if not na(green_fibo_pos100) and not na(green_fibo_125)
        new_green_box2 = box.new(green_range_end_bar, green_fibo_pos100, green_range_end_bar + green_box_extension, green_fibo_125, 
                          bgcolor=color.new(color.green, box_transparency), 
                          border_color=color.green, 
                          border_width=1)
        array.push(green_boxes_array, new_green_box2)
    
    // Negative green boxes
    // Green Box 3: Between -25% and -50% Fibo levels
    if not na(green_fibo_neg25) and not na(green_fibo_neg50)
        new_green_box3 = box.new(green_range_end_bar, green_fibo_neg25, green_range_end_bar + green_box_extension, green_fibo_neg50, 
                          bgcolor=color.new(color.green, box_transparency), 
                          border_color=color.green, 
                          border_width=1)
        array.push(green_boxes_array, new_green_box3)
    
    // Green Box 4: Between -100% and -125% Fibo levels
    if not na(green_fibo_neg100) and not na(green_fibo_neg125)
        new_green_box4 = box.new(green_range_end_bar, green_fibo_neg100, green_range_end_bar + green_box_extension, green_fibo_neg125, 
                          bgcolor=color.new(color.green, box_transparency), 
                          border_color=color.green, 
                          border_width=1)
        array.push(green_boxes_array, new_green_box4)

// Update previous states
prev_in_range := is_in_range
prev_green_in_range := is_in_green_range

General_settings        = 'General settings'
tmf               = input.timeframe("","Timeframe", group = General_settings)
fvg_usewidth      = true
fvg_gapwidth      = 0.009
fvg_method        = '%'



mitgationTypeWick = input.string("Wick","Mitigation Type",options = ["Wick","Close"],inline = "mitper", group = General_settings) == "Wick"
mitgPer           = input.int(100,"Mitigation %",minval = 1,maxval = 100,inline = "mitper",step = 10, group = General_settings)

FVG_settings        = 'FVG settings'
fvgStyle          = input.string(line.style_dotted,"FVG Style",options = [line.style_solid,line.style_dotted,line.style_dashed], group = FVG_settings)
fvgLabl           = input.string(size.small,"Lable Size",options = [size.auto,size.tiny,size.normal,size.small,size.large], group = General_settings)

BPR_settings        = 'BPR settings'
bprStyle          = input.string(line.style_solid,"BPR Style",options = [line.style_solid,line.style_dotted,line.style_dashed], group = BPR_settings)
showhist          = false

numFVG            = input.int(10,"FVG Count", group = FVG_settings)
numBRB            = input.int(10,"BPR Count", group = BPR_settings)

Style_settings        = 'Color settings'
styleOption       = input.string("TLAB colors",  title = "Style:     ",  options = ["TLAB colors", "standart colors", "Monochrome black BG", "Monochrome grey BG", "Custom"], inline = 'h5', group = Style_settings)
Custom_S          = input.color (color.rgb(0, 4, 255) , 'Custom color ', group = Style_settings)

colorHigh = styleOption == "TLAB colors"           ? #9c9c9c   :
          styleOption   == "standart colors"       ? color.red :
          styleOption   == "Monochrome grey BG"    ? #000000   :
          styleOption   == "Monochrome black BG"   ? #9c9c9c   :
          styleOption   == "Custom"                ? Custom_S    : na

colorLow = styleOption == "TLAB colors"           ? #9c9c9c :
          styleOption  == "standart colors"       ? #00d451 :
          styleOption  == "Monochrome grey BG"    ? #000000 :
          styleOption  == "Monochrome black BG"   ? #9c9c9c :
          styleOption  == "Custom"                ? Custom_S  :na

imbalance_detection(top, btm, condition,atr) =>
    var is_width = true

    if fvg_usewidth
        dist = top - btm

        is_width := switch fvg_method
            'Points' => dist > fvg_gapwidth
            '%' => dist / btm * 100 > fvg_gapwidth
        is_width

    is_true = condition and is_width
    is_true

type fvgDetails
    int   Type = 0
    float Top = na
    float Btm = na
    int   left = na
    int   left2 = na
    int   right = na
    int   cnt = 0
    color   fvgClr=na

getFVG() =>
    atr = ta.atr(200)
    fvgDetails fd = fvgDetails.new()

    isFvgBull = imbalance_detection(low, high[2], low  > high[2] and close[1] > high[2],atr)
    isFvgBear = imbalance_detection(low[2], high, high < low[2]  and close[1] < low[2] ,atr)

    if  isFvgBull
        fd.Type     := 1
        fd.Top      := low
        fd.Btm      := high[2]
        fd.left     := time
        fd.left2    := time[2]
        fd.right    := time
        fd.fvgClr   := colorLow

    if  isFvgBear
        fd.Type  := -1
        fd.Top   := low[2]
        fd.Btm   := high
        fd.left  := time[2]
        fd.left2 := time
        fd.right := time 
        fd.fvgClr   := colorHigh

    [fd,open, close,high,low,high[1],low[1],close[1]]

[fd,open_, close_,high_,low_,high_p,low_p,close_p] = request.security(syminfo.tickerid,tmf, getFVG())

var arrFVDD = array.new<fvgDetails>(0)
var arrFVDDType = array.new_bool(0)

var arrFVDLineTop = array.new_line(0)
var arrFVDLineBtm = array.new_line(0)

var arrFVDLblTop = array.new_label(0)

if  arrFVDLineTop.size() > numFVG
    arrFVDLineTop.pop().delete()
    arrFVDLineBtm.pop().delete()
    arrFVDLblTop.pop().delete()
    arrFVDDType.pop()

var arrFVD_BPR = array.new<fvgDetails>(0)
var arrFVD_BPRBox = array.new_box(0)

if arrFVD_BPRBox.size() > numBRB
    arrFVD_BPRBox.pop().delete()
    arrFVD_BPR.pop() 

addtimt = 5*(time[1] - time[2]) 
if open_ != open_[1]
    isBPR = false
    if not na(fd) and not na(fd[1]) and show_bpr
        if arrFVDD.size() > 0  and (fd.Type == 1 or fd.Type == -1)
            i = 0
            while i < arrFVDD.size() 
                odlfd = arrFVDD.get(i)
                c1 =  fd.Top <= odlfd.Top and fd.Btm >= odlfd.Btm
                c2 = fd.Top <= odlfd.Top and fd.Top > odlfd.Btm  and fd.Btm < odlfd.Btm 
                c3 = fd.Top > odlfd.Top and fd.Btm >= odlfd.Btm and fd.Btm < odlfd.Top
                c4 = fd.Top >= odlfd.Top and fd.Btm <= odlfd.Btm

                if c1 or c2 or c3 or c4
                    top_ = fd.Top 
                    btm_ = fd.Btm
                    bleft_ = odlfd.left
                    if c2
                        top_ := fd.Top 
                        btm_ := odlfd.Btm
                    else if c3
                        top_ := odlfd.Top 
                        btm_ := fd.Btm
                    else if c4
                        top_ := odlfd.Top 
                        btm_ := odlfd.Btm
    
                    isBPR := true
                    arrFVD_BPR.unshift(fvgDetails.new(fd.Type,top_,btm_,bleft_,time,0))
                    arrFVD_BPRBox.unshift(box.new(bleft_, top_, time, btm_, border_color = fd.fvgClr, bgcolor = na, xloc = xloc.bar_time,border_style = bprStyle,text = "BPR",text_size = fvgLabl,text_halign = text.align_right,text_color = fd.fvgClr))
    
                i += 1

    bullMit = mitgationTypeWick ? low_ : close_
    bearMit = mitgationTypeWick ? high_ : close_

    //fvg testing
    if arrFVDDType.size() > 0 and show_fvg
        i = 0
        while i < arrFVDDType.size()
            fdnTpe = arrFVDDType.get(i)
            //fdn = arrFVDDBox.get(i)
            fdnLblTop = arrFVDLblTop.get(i)
            //fdnLblBtm = arrFVDLblBtm.get(i)

            fdnLinTop = arrFVDLineTop.get(i)
            fdnLinBtm = arrFVDLineBtm.get(i)

            fdnLblTop.set_x(time+addtimt)
            //fdnLblBtm.set_x(time)

            fdnLinTop.set_x2(time+addtimt)
            fdnLinBtm.set_x2(time+addtimt)

            minval = math.min(fdnLinBtm.get_y1(),fdnLinTop.get_y1())
            maxvla = math.max(fdnLinBtm.get_y1(),fdnLinTop.get_y1())
            midPnt = (maxvla - minval)*mitgPer*0.01
            if fdnTpe 
                if bullMit < (maxvla - midPnt)//fdn.get_bottom()
                    arrFVDLblTop.remove(i).delete()
                    arrFVDLineTop.remove(i).delete()
                    arrFVDLineBtm.remove(i).delete()
                    arrFVDDType.remove(i)
                    i -= 1
            else
                if bearMit > (minval + midPnt)//fdn.get_top()
                    arrFVDLblTop.remove(i).delete()
                    arrFVDLineTop.remove(i).delete()
                    arrFVDLineBtm.remove(i).delete()
                    arrFVDDType.remove(i)
                    i -= 1

            i += 1


    //bpr testing
    if arrFVD_BPR.size() > 0 and show_bpr
        i = 0
        while i < arrFVD_BPR.size()
            fdn = arrFVD_BPR.get(i)

            arrFVD_BPRBox.get(i).set_right(time+addtimt)

            minval = math.min(fdn.Top,fdn.Btm)
            maxvla = math.max(fdn.Top,fdn.Btm)
            midPnt = (maxvla - minval)*mitgPer*0.01

            if fdn.Type == 1
                if bullMit < (maxvla - midPnt)
                    bx = arrFVD_BPRBox.remove(i)
                    if showhist
                        bx.set_right(time+addtimt)
                    else
                        bx.delete()
                    arrFVD_BPR.remove(i)
                    i -= 1
            else
                if bearMit > (minval + midPnt)
                    bx = arrFVD_BPRBox.remove(i)
                    if showhist
                        bx.set_right(time+addtimt)
                    else
                        bx.delete()
                    arrFVD_BPR.remove(i)
                    i -= 1

            i += 1

    bullMitp = mitgationTypeWick ? low_p : close_p
    bearMitp = mitgationTypeWick ? high_p : close_p

    if arrFVDD.size() > 0 and show_fvg
        i = 0
        while i < arrFVDD.size()
            fdn = arrFVDD.get(i)
            
            minval = math.min(fdn.Top,fdn.Btm)
            maxvla = math.max(fdn.Top,fdn.Btm)
            midPnt = (maxvla - minval)*mitgPer*0.01

            if fdn.Type == 1 
                if  bullMitp < (maxvla - midPnt)
                    arrFVDD.remove(i)
                    i -= 1
            else
                if  bearMitp > (minval + midPnt)
                    arrFVDD.remove(i)
                    i -= 1
            i += 1

   
    if not na(fd) and not na(fd[1]) and show_fvg
        if fd.Type == 1 or fd.Type == -1 //(fd[1]).left != fd.left   
            arrFVDD.unshift(fd)
            if not isBPR
                arrFVDDType.unshift(fd.Type == 1)
                arrFVDLineTop.unshift(line.new(fd.left, fd.Top,time+addtimt, fd.Top,style = fvgStyle,color = fd.fvgClr,xloc = xloc.bar_time))
                arrFVDLineBtm.unshift(line.new(fd.left2, fd.Btm,time+addtimt, fd.Btm,style = fvgStyle,color = fd.fvgClr,xloc = xloc.bar_time))
                arrFVDLblTop.unshift(label.new(time+addtimt,  (fd.Top+fd.Btm)/2,color = #ff525200,xloc = xloc.bar_time,style = label.style_label_right,size = fvgLabl,text = "FVG",textcolor = fd.fvgClr))


// Input parameters
show_labels = input.bool(true, "Show Labels", group="Display")
line_width = input.int(2, "Line Width", minval=1, maxval=5, group="Display")
extend_lines = input.string("Right", "Extend Lines", options=["None", "Right", "Both"], group="Display")

// Colors
upper_color = color.red
lower_color = color.green

// Variables to store data
var float ny_open = na
var float avg_range = na
var line upper_line = na
var line lower_line = na
var label upper_label = na
var label lower_label = na

// Function to calculate average daily range over 5 days
get_avg_range() =>
    var array<float> ranges = array.new<float>()
    
    // Get current day's high and low
    day_high = request.security(syminfo.tickerid, "1D", high[1])
    day_low = request.security(syminfo.tickerid, "1D", low[1])
    current_range = day_high - day_low
    
    // Add current range to array
    if not na(current_range) and current_range > 0
        array.push(ranges, current_range)
        
        // Keep only last 5 values
        if array.size(ranges) > 5
            array.shift(ranges)
    
    // Calculate average
    avg = 0.0
    if array.size(ranges) > 0
        sum = 0.0
        for i = 0 to array.size(ranges) - 1
            sum += array.get(ranges, i)
        avg := sum / array.size(ranges)
    
    avg

// Function to check if current time is NY midnight (00:00 EST/EDT)
is_ny_midnight() =>
    // Convert to NY time zone
    ny_time = time("1", "America/New_York")
    ny_hour = hour(ny_time, "America/New_York")
    ny_minute = minute(ny_time, "America/New_York")
    
    // Check if it's exactly midnight
    ny_hour == 0 and ny_minute == 0

// Function to check if current time is 16:00 NY time
is_ny_1600() =>
    ny_time = time("1", "America/New_York")
    ny_hour = hour(ny_time, "America/New_York")
    ny_minute = minute(ny_time, "America/New_York")
    
    ny_hour == 16 and ny_minute == 0

// Function to get line extend type
get_extend() =>
    switch extend_lines
        "Right" => extend.right
        "Both" => extend.both
        => extend.none

// Main logic
if is_ny_midnight()
    // Store the opening price at NY midnight
    ny_open := open
    
    // Calculate 5-day average range
    avg_range := get_avg_range()
    
    // Delete existing lines and labels
    if not na(upper_line)
        line.delete(upper_line)
    if not na(lower_line)
        line.delete(lower_line)
    if not na(upper_label)
        label.delete(upper_label)
    if not na(lower_label)
        label.delete(lower_label)
    
    // Calculate line levels (1/3 of average range)
    range_third = avg_range / 3
    upper_level = ny_open + range_third
    lower_level = ny_open - range_third
    
    // Create new lines
    upper_line := line.new(x1=bar_index, y1=upper_level, x2=bar_index + 1, y2=upper_level, color=upper_color, width=line_width, extend=get_extend())
    
    lower_line := line.new(x1=bar_index, y1=lower_level, x2=bar_index + 1, y2=lower_level, color=lower_color, width=line_width, extend=get_extend())
    
    // Create labels if enabled
    if show_labels
        upper_label := label.new(x=bar_index, y=upper_level, text="R: " + str.tostring(upper_level, "#.####"), color=upper_color, textcolor=color.white, style=label.style_label_left, size=size.small)
        
        lower_label := label.new(x=bar_index, y=lower_level, text="S: " + str.tostring(lower_level, "#.####"), color=lower_color, textcolor=color.white, style=label.style_label_left, size=size.small)

// Delete lines at 16:00 NY time
if is_ny_1600()
    if not na(upper_line)
        line.delete(upper_line)
        upper_line := na
    if not na(lower_line)
        line.delete(lower_line)
        lower_line := na
    if not na(upper_label)
        label.delete(upper_label)
        upper_label := na
    if not na(lower_label)
        label.delete(lower_label)
        lower_label := na

// Plot background color during active period (optional)
bgcolor(not na(upper_line) ? color.new(color.blue, 98) : na, title="Active Period Background")

// Input for selecting higher timeframe
htfSelect = input.string("1H", "Higher Timeframe", options=["15", "1H", "4H", "D"])

// Convert selection to timeframe string
htf = htfSelect == "15" ? "15" : htfSelect == "1H" ? "60" : htfSelect == "4H" ? "240" : "D"

// Input for display settings
candleWidth = input.int(10, "Candle Width (bars)", minval=1, maxval=50)
offsetRight = input.int(2, "Offset from Current Price (bars)", minval=0, maxval=20)
showWicks = input.bool(true, "Show Wicks")
showFVG = input.bool(true, "Show Fair Value Gaps")

// Colors
bullishColor = input.color(color.new(color.green, 0), "Bullish Color")
bearishColor = input.color(color.new(color.red, 0), "Bearish Color")
wickColor = input.color(color.new(color.gray, 0), "Wick Color")
bullishFVGColor = input.color(color.new(color.green, 80), "Bullish FVG Color")
bearishFVGColor = input.color(color.new(color.red, 80), "Bearish FVG Color")

// Get HTF data
[htfOpen, htfHigh, htfLow, htfClose, htfTime] = request.security(syminfo.tickerid, htf, [open, high, low, close, time])

// Store HTF candle data in arrays
var float[] storedOpen = array.new_float(0)
var float[] storedHigh = array.new_float(0)
var float[] storedLow = array.new_float(0)
var float[] storedClose = array.new_float(0)
var box[] candleBoxes = array.new_box(0)
var line[] upperWicks = array.new_line(0)
var line[] lowerWicks = array.new_line(0)
var box[] fvgBoxes = array.new_box(0)

// Detect new HTF candle
bool newHTFCandle = ta.change(htfTime) != 0

if newHTFCandle and not na(htfClose)
    // If we have 4 candles, remove the oldest
    if array.size(storedOpen) >= 4
        // Delete old drawing objects before removing from arrays
        if not na(array.get(candleBoxes, 0))
            box.delete(array.get(candleBoxes, 0))
        if not na(array.get(upperWicks, 0))
            line.delete(array.get(upperWicks, 0))
        if not na(array.get(lowerWicks, 0))
            line.delete(array.get(lowerWicks, 0))
        if not na(array.get(fvgBoxes, 0))
            box.delete(array.get(fvgBoxes, 0))
        
        array.shift(storedOpen)
        array.shift(storedHigh)
        array.shift(storedLow)
        array.shift(storedClose)
        array.shift(candleBoxes)
        array.shift(upperWicks)
        array.shift(lowerWicks)
        array.shift(fvgBoxes)
    
    // Add new candle data
    array.push(storedOpen, htfOpen)
    array.push(storedHigh, htfHigh)
    array.push(storedLow, htfLow)
    array.push(storedClose, htfClose)
    array.push(candleBoxes, box(na))
    array.push(upperWicks, line(na))
    array.push(lowerWicks, line(na))
    array.push(fvgBoxes, box(na))

// Update the most recent candle with current HTF values
if not na(htfClose) and array.size(storedClose) > 0
    array.set(storedClose, array.size(storedClose) - 1, htfClose)
    array.set(storedHigh, array.size(storedHigh) - 1, htfHigh)
    array.set(storedLow, array.size(storedLow) - 1, htfLow)

// Get current bar index
currentBar = bar_index

// Draw the 4 most recent HTF candles
if barstate.islast
    arraySize = array.size(storedOpen)
    for i = 0 to math.min(arraySize - 1, 3)
        o = array.get(storedOpen, i)
        h = array.get(storedHigh, i)
        l = array.get(storedLow, i)
        c = array.get(storedClose, i)
        
        if not na(c)
            // Calculate position for each candle (leftmost is oldest, rightmost is newest)
            xOffset = currentBar + offsetRight + i * (candleWidth + 1)
            left = xOffset
            right = xOffset + candleWidth
            
            isBullish = c >= o
            bodyTop = math.max(o, c)
            bodyBottom = math.min(o, c)
            
            // Delete old boxes/lines if they exist
            if not na(array.get(candleBoxes, i))
                box.delete(array.get(candleBoxes, i))
            if showWicks
                if not na(array.get(upperWicks, i))
                    line.delete(array.get(upperWicks, i))
                if not na(array.get(lowerWicks, i))
                    line.delete(array.get(lowerWicks, i))
            
            // Draw candle body
            candleBox = box.new(left, bodyTop, right, bodyBottom, 
                 border_color=isBullish ? bullishColor : bearishColor,
                 bgcolor=isBullish ? bullishColor : bearishColor,
                 border_width=1)
            array.set(candleBoxes, i, candleBox)
            
            // Draw wicks
            if showWicks
                wickX = int((left + right) / 2.0)
                
                // Upper wick
                if h > bodyTop
                    upperWick = line.new(wickX, bodyTop, wickX, h, color=wickColor, width=1)
                    array.set(upperWicks, i, upperWick)
                
                // Lower wick
                if l < bodyBottom
                    lowerWick = line.new(wickX, bodyBottom, wickX, l, color=wickColor, width=1)
                    array.set(lowerWicks, i, lowerWick)
