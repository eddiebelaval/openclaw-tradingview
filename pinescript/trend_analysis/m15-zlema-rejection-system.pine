//@version=6
indicator("M15 ZLEMA Rejection System", overlay = true)

// === INPUTS ===
minWickToBodyRatio     = input.float(3.0,  "Min Wick to Body Ratio", step = 0.1)
minWickToRangePercent  = input.float(0.65, "Min Wick % of Candle Range", step = 0.05)

fastLength = input.int(21,  "Fast ZLEMA Length")
slowLength = input.int(100, "Slow ZLEMA Length")

useSlopeFilter = input.bool(true, "Use ZLEMA Slope Filter")
showLabels     = input.bool(true, "Show BUY/SELL Labels")

// === ZLEMA FUNCTION ===
zlema(src, length) =>
    lag = math.floor((length - 1) / 2)
    adjusted = src + (src - src[lag])
    ta.ema(adjusted, length)

// === CALCULATIONS ===
fastZ = zlema(close, fastLength)
slowZ = zlema(close, slowLength)

plot(fastZ, color=color.orange, title="Fast ZLEMA")
plot(slowZ, color=color.blue,   title="Slow ZLEMA")

// === SLOPE DETECTION ===
fastSlopeUp   = fastZ > fastZ[1]
fastSlopeDown = fastZ < fastZ[1]

// === CANDLE STRUCTURE ===
body        = math.abs(close - open)
candleRange = high - low
upperWick   = high - math.max(open, close)
lowerWick   = math.min(open, close) - low

validCandle = candleRange > 0

// === REJECTION LOGIC ===
bullishRaw =(
    validCandle and
    lowerWick > body * minWickToBodyRatio and
    (lowerWick / candleRange) >= minWickToRangePercent and
    close > open)

bearishRaw =(
    validCandle and
    upperWick > body * minWickToBodyRatio and
    (upperWick / candleRange) >= minWickToRangePercent and
    close < open)

// === TREND CONDITIONS ===
trendBull = close > slowZ and fastZ > slowZ
trendBear = close < slowZ and fastZ < slowZ

slopeBull = not useSlopeFilter or fastSlopeUp
slopeBear = not useSlopeFilter or fastSlopeDown

// === FINAL SIGNALS ===
bullishSignal = bullishRaw and trendBull and slopeBull
bearishSignal = bearishRaw and trendBear and slopeBear

// === PLOTS ===
plotshape(bullishSignal,
     location=location.belowbar,
     color=color.lime,
     style=shape.triangleup,
     size=size.small,
     title="Buy")

plotshape(bearishSignal,
     location=location.abovebar,
     color=color.red,
     style=shape.triangledown,
     size=size.small,
     title="Sell")

// === LABELS ===
if showLabels and bullishSignal
    label.new(bar_index, low, "BUY",
         style=label.style_label_up,
         color=color.lime,
         textcolor=color.white)

if showLabels and bearishSignal
    label.new(bar_index, high, "SELL",
         style=label.style_label_down,
         color=color.red,
         textcolor=color.white)

// === ALERTS ===
alertcondition(bullishSignal,
     title="M15 Buy Alert",
     message="M15 BUY - ZLEMA Rejection Setup")

alertcondition(bearishSignal,
     title="M15 Sell Alert",
     message="M15 SELL - ZLEMA Rejection Setup")
