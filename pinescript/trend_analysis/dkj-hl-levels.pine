//@version=6
indicator("DKJ H/L Levels", overlay=true, max_lines_count=500, max_labels_count=500)

// VISIBILITY
show4H = input.bool(true, "Show 4H Levels",     group="Visibility")
showD  = input.bool(true, "Show Daily Levels",   group="Visibility")
showW  = input.bool(true, "Show Weekly Levels",  group="Visibility")
showM  = input.bool(true, "Show Monthly Levels", group="Visibility")

// COLORS
col4H_H = input.color(color.new(#00BCD4, 40), "4H High",      group="Colors")
col4H_L = input.color(color.new(#00BCD4, 40), "4H Low",       group="Colors")
colD_H  = input.color(color.new(#4CAF50, 40), "Daily High",   group="Colors")
colD_L  = input.color(color.new(#F44336, 40), "Daily Low",    group="Colors")
colW_H  = input.color(color.new(#FF9800, 40), "Weekly High",  group="Colors")
colW_L  = input.color(color.new(#FF9800, 40), "Weekly Low",   group="Colors")
colM_H  = input.color(color.new(#9C27B0, 40), "Monthly High", group="Colors")
colM_L  = input.color(color.new(#9C27B0, 40), "Monthly Low",  group="Colors")

// STYLE
lineWidth       = input.int(1, "Line Width", minval=1, maxval=4, group="Style")
lineStyle_input = input.string("Solid", "Line Style", options=["Solid","Dashed","Dotted"], group="Style")
showLabels      = input.bool(true, "Show Labels", group="Style")

// ALERTS
alert4H = input.bool(true, "Alert on 4H levels",     group="Alerts")
alertD  = input.bool(true, "Alert on Daily levels",   group="Alerts")
alertW  = input.bool(true, "Alert on Weekly levels",  group="Alerts")
alertM  = input.bool(true, "Alert on Monthly levels", group="Alerts")

// LINE STYLE
ls = lineStyle_input == "Dashed" ? line.style_dashed : lineStyle_input == "Dotted" ? line.style_dotted : line.style_solid

// PREVIOUS HIGHS & LOWS
[h4H_high, h4H_low] = request.security(syminfo.tickerid, "240", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[hD_high,  hD_low]  = request.security(syminfo.tickerid, "D",   [high[1], low[1]], lookahead=barmerge.lookahead_on)
[hW_high,  hW_low]  = request.security(syminfo.tickerid, "W",   [high[1], low[1]], lookahead=barmerge.lookahead_on)
[hM_high,  hM_low]  = request.security(syminfo.tickerid, "M",   [high[1], low[1]], lookahead=barmerge.lookahead_on)

// NEW PERIOD FLAGS
is_new_4H = ta.change(time("240")) != 0
is_new_D  = ta.change(time("D"))   != 0
is_new_W  = ta.change(time("W"))   != 0
is_new_M  = ta.change(time("M"))   != 0

// PERSISTENT VARS
var line l4H_H = na, var line l4H_L = na
var line lD_H  = na, var line lD_L  = na
var line lW_H  = na, var line lW_L  = na
var line lM_H  = na, var line lM_L  = na

var label lb4H_H = na, var label lb4H_L = na
var label lbD_H  = na, var label lbD_L  = na
var label lbW_H  = na, var label lbW_L  = na
var label lbM_H  = na, var label lbM_L  = na

// DRAW HELPERS — delete old, return new (no parameter reassignment)
f_line(line ln, int t, float lvl, color col) =>
    if not na(ln)
        line.delete(ln)
    line.new(x1=t, y1=lvl, x2=t+1, y2=lvl, color=col, width=lineWidth, style=ls, extend=extend.right)

f_label(label lb, int t, float lvl, color col, string txt) =>
    if not na(lb)
        label.delete(lb)
    label.new(x=t, y=lvl, text=txt, style=label.style_label_right, color=color.new(col, 85), textcolor=col, size=size.small)

// 4H
if show4H and is_new_4H
    l4H_H  := f_line(l4H_H, bar_index, h4H_high, col4H_H)
    l4H_L  := f_line(l4H_L, bar_index, h4H_low,  col4H_L)
    if showLabels
        lb4H_H := f_label(lb4H_H, bar_index, h4H_high, col4H_H, "P4H Hi " + str.tostring(h4H_high, format.mintick))
        lb4H_L := f_label(lb4H_L, bar_index, h4H_low,  col4H_L, "P4H Lo " + str.tostring(h4H_low,  format.mintick))

// Daily
if showD and is_new_D
    lD_H  := f_line(lD_H, bar_index, hD_high, colD_H)
    lD_L  := f_line(lD_L, bar_index, hD_low,  colD_L)
    if showLabels
        lbD_H := f_label(lbD_H, bar_index, hD_high, colD_H, "PDH " + str.tostring(hD_high, format.mintick))
        lbD_L := f_label(lbD_L, bar_index, hD_low,  colD_L, "PDL " + str.tostring(hD_low,  format.mintick))

// Weekly
if showW and is_new_W
    lW_H  := f_line(lW_H, bar_index, hW_high, colW_H)
    lW_L  := f_line(lW_L, bar_index, hW_low,  colW_L)
    if showLabels
        lbW_H := f_label(lbW_H, bar_index, hW_high, colW_H, "PWH " + str.tostring(hW_high, format.mintick))
        lbW_L := f_label(lbW_L, bar_index, hW_low,  colW_L, "PWL " + str.tostring(hW_low,  format.mintick))

// Monthly
if showM and is_new_M
    lM_H  := f_line(lM_H, bar_index, hM_high, colM_H)
    lM_L  := f_line(lM_L, bar_index, hM_low,  colM_L)
    if showLabels
        lbM_H := f_label(lbM_H, bar_index, hM_high, colM_H, "PMH " + str.tostring(hM_high, format.mintick))
        lbM_L := f_label(lbM_L, bar_index, hM_low,  colM_L, "PML " + str.tostring(hM_low,  format.mintick))

// ALERTS
if alert4H and show4H
    if high >= h4H_high and low[1] < h4H_high
        alert("Crossed ABOVE Prev 4H High: " + str.tostring(h4H_high, format.mintick), alert.freq_once_per_bar)
    if low <= h4H_low and high[1] > h4H_low
        alert("Crossed BELOW Prev 4H Low: " + str.tostring(h4H_low, format.mintick), alert.freq_once_per_bar)

if alertD and showD
    if high >= hD_high and low[1] < hD_high
        alert("Crossed ABOVE Prev Daily High: " + str.tostring(hD_high, format.mintick), alert.freq_once_per_bar)
    if low <= hD_low and high[1] > hD_low
        alert("Crossed BELOW Prev Daily Low: " + str.tostring(hD_low, format.mintick), alert.freq_once_per_bar)

if alertW and showW
    if high >= hW_high and low[1] < hW_high
        alert("Crossed ABOVE Prev Weekly High: " + str.tostring(hW_high, format.mintick), alert.freq_once_per_bar)
    if low <= hW_low and high[1] > hW_low
        alert("Crossed BELOW Prev Weekly Low: " + str.tostring(hW_low, format.mintick), alert.freq_once_per_bar)

if alertM and showM
    if high >= hM_high and low[1] < hM_high
        alert("Crossed ABOVE Prev Monthly High: " + str.tostring(hM_high, format.mintick), alert.freq_once_per_bar)
    if low <= hM_low and high[1] > hM_low
        alert("Crossed BELOW Prev Monthly Low: " + str.tostring(hM_low, format.mintick), alert.freq_once_per_bar)
