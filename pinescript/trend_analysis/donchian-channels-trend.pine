//@version=6
indicator(title="Donchian Channels Trend", shorttitle="DC Trend", overlay=true, timeframe="", timeframe_gaps=true)

// =============================================================================
// 1. Settings
// =============================================================================
length = input.int(50, minval = 1, title="Length")
offset = input.int(0, "Offset")

// =============================================================================
// 2. Calculate Donchian Channels
// =============================================================================
lower = ta.lowest(length)
upper = ta.highest(length)
basis = math.avg(upper, lower)

// =============================================================================
// 3. [Core] Trend Detection Logic
// =============================================================================
// 1 = Uptrend (Lime), -1 = Downtrend (Red)
// Use 'var' to maintain the trend state across bars.
var int trend = 0

// If High equals the Upper Channel (New High) -> Switch to Uptrend
if high == upper
    trend := 1

// If Low equals the Lower Channel (New Low) -> Switch to Downtrend
if low == lower
    trend := -1

// =============================================================================
// 4. Determine Color
// =============================================================================
// If the trend is 1 (Up), use Lime. Otherwise, use Red.
lineColor = trend == 1 ? color.lime : color.red
bgColor   = trend == 1 ? color.new(color.lime, 90) : color.new(color.red, 90)

// =============================================================================
// 5. Visualization
// =============================================================================
plot(basis, "Basis", color = lineColor, offset = offset, linewidth=1)
u = plot(upper, "Upper", color = lineColor, offset = offset)
l = plot(lower, "Lower", color = lineColor, offset = offset)

// Fill Background with the trend color
fill(u, l, color = bgColor, title = "Background")
