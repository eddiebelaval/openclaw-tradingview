// Lumina Trend Channels — An EMA + ATR based dynamic channel system with trend detection.
// The indicator constructs a four-band envelope around an EMA baseline, where band width
// is driven by ATR-measured volatility. Trend direction is determined by the slope of the
// baseline, and the entire channel changes color accordingly. Buy/sell signals are generated
// when price crosses the baseline in the direction of the prevailing trend.

//@version=6
indicator("Lumina Trend Channels [Pineify]", "Lumina Channels [Pineify]", overlay = true, max_lines_count = 500)

// ---------------------------------------------------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------------------------------------------------
// Shared lookback period for both the EMA baseline and ATR volatility measure
length      = input.int(21, "Channel Length", minval = 5, group="Calculation", tooltip="Length of the baseline and ATR.")
// Controls the distance of the outer bands from the baseline (outer = basis ± ATR × multOuter)
multOuter   = input.float(2.0, "Outer Band Multiplier", step=0.1, group="Calculation")
// Controls the distance of the inner bands from the baseline (inner = basis ± ATR × multInner)
multInner   = input.float(1.0, "Inner Band Multiplier", step=0.1, group="Calculation")

// Color palette for bullish (uptrend) and bearish (downtrend) states
bullCss     = input.color(#00E676, "Bullish Color", group="Style")
bearCss     = input.color(#FF5252, "Bearish Color", group="Style")

// ---------------------------------------------------------------------------------------------------------------------
// Calculations
// ---------------------------------------------------------------------------------------------------------------------
// Baseline: EMA provides a smooth, low-lag center line that reacts faster than SMA
basis = ta.ema(close, length)

// Volatility measure: ATR captures the average bar range over `length` bars,
// used to scale band width proportionally to current market volatility
atr = ta.atr(length)

// Four bands constructed symmetrically around the baseline,
// with width proportional to ATR × the respective multiplier
upperOuter = basis + atr * multOuter
upperInner = basis + atr * multInner
lowerInner = basis - atr * multInner
lowerOuter = basis - atr * multOuter

// Trend detection via baseline slope:
//   - rising(basis, 2): true when basis has increased for 2 consecutive bars → bullish
//   - falling(basis, 2): true when basis has decreased for 2 consecutive bars → bearish
//   - Otherwise: retain the previous trend state (persisted via `var`)
var int trend = 1
rising = ta.rising(basis, 2)
falling = ta.falling(basis, 2)
trend := rising ? 1 : falling ? -1 : nz(trend, 1)

// All visual elements adopt the trend-dependent color
trendCss = trend == 1 ? bullCss : bearCss

// ---------------------------------------------------------------------------------------------------------------------
// Plots & Fills
// ---------------------------------------------------------------------------------------------------------------------
// Plot the five channel lines with progressively increasing transparency toward the edges
p_uo    = plot(upperOuter, "Upper Outer", color=color.new(trendCss, 50), style=plot.style_line)
p_ui    = plot(upperInner, "Upper Inner", color=color.new(trendCss, 70), style=plot.style_line)
p_basis = plot(basis, "Baseline", color=trendCss, linewidth=2)
p_li    = plot(lowerInner, "Lower Inner", color=color.new(trendCss, 70), style=plot.style_line)
p_lo    = plot(lowerOuter, "Lower Outer", color=color.new(trendCss, 50), style=plot.style_line)

// Layered fills create a gradient effect: outer zones are more transparent (85)
// than inner zones (70), giving a visual "glow" that fades outward from the baseline
fill(p_uo, p_ui, color=color.new(trendCss, 85), title="Outer Upper Fill")
fill(p_ui, p_basis, color=color.new(trendCss, 70), title="Inner Upper Fill")
fill(p_basis, p_li, color=color.new(trendCss, 70), title="Inner Lower Fill")
fill(p_li, p_lo, color=color.new(trendCss, 85), title="Outer Lower Fill")

// Circle marker on the baseline whenever the trend direction flips,
// providing a clear visual anchor for trend change events
plot(ta.change(trend) != 0 ? basis : na, "Trend Change", color=trendCss, linewidth=4, style=plot.style_circles)

// ---------------------------------------------------------------------------------------------------------------------
// Trading Signals
// ---------------------------------------------------------------------------------------------------------------------
// Buy: price crosses above the EMA baseline AND the channel is in bullish mode,
// confirming the crossover is aligned with the prevailing trend direction
buySignal  = ta.crossover(close, basis) and trend == 1

// Sell: price crosses below the EMA baseline AND the channel is in bearish mode,
// ensuring short entries only occur during confirmed downtrends
sellSignal = ta.crossunder(close, basis) and trend == -1

// Triangle markers placed below/above bars for easy visual identification
plotshape(buySignal, "Buy Signal", shape.triangleup, location.belowbar, color=bullCss, size=size.small)
plotshape(sellSignal, "Sell Signal", shape.triangledown, location.abovebar, color=bearCss, size=size.small)

// ---------------------------------------------------------------------------------------------------------------------
// Alerts
// ---------------------------------------------------------------------------------------------------------------------
// Configurable alert conditions for automated monitoring without watching the chart
alertcondition(buySignal, "Buy Signal", "Lumina Channels: Bullish Entry Detected")
alertcondition(sellSignal, "Sell Signal", "Lumina Channels: Bearish Entry Detected")
alertcondition(ta.change(trend) != 0, "Trend Change", "Lumina Channels: Channel Trend Changed Color")
