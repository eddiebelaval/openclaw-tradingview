//@version=6
indicator("Metals Auction NY Opening Range (Anchored + Extensions)", overlay=true, max_lines_count=500, max_labels_count=500)

// ─────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────
tz          = input.string("America/New_York", "Timezone (ET)", options=["America/New_York"])
showOpen    = input.bool(true,  "Plot 8:20 Open")
showHL      = input.bool(true,  "Plot Range High/Low")
showMid     = input.bool(true,  "Plot Midpoint")
showExt     = input.bool(true,  "Plot Extensions (50/100/150/200%)")
extendRight = input.bool(true,  "Extend lines right")
showLabels  = input.bool(true,  "Show Labels (right edge)")
lineWidth   = input.int(1, "Line Width", minval=1, maxval=4)
labelOffset = input.int(2, "Label Bars to Right", minval=0, maxval=50)

// ─────────────────────────────────────────────────────────────
// Window: 08:20:00 → 09:19:59 ET
// Session end is exclusive, so "0820-0920" covers up to 09:19:59.
// ─────────────────────────────────────────────────────────────
inWindow    = not na(time(timeframe.period, "0820-0920", tz))
startWindow = inWindow and not inWindow[1]
endWindow   = not inWindow and inWindow[1]

// ET-based day change bool
dayKey = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
newDay = ta.change(dayKey) != 0

// ─────────────────────────────────────────────────────────────
// Persistent state
// ─────────────────────────────────────────────────────────────
var float winHigh = na
var float winLow  = na
var float open820 = na
var bool  locked  = false

// Lines
var line lOpen  = na
var line lHigh  = na
var line lLow   = na
var line lMid   = na
var line lUp50  = na
var line lUp100 = na
var line lUp150 = na
var line lUp200 = na
var line lDn50  = na
var line lDn100 = na
var line lDn150 = na
var line lDn200 = na

// Labels
var label lbOpen  = na
var label lbHigh  = na
var label lbLow   = na
var label lbMid   = na
var label lbUp50  = na
var label lbUp100 = na
var label lbUp150 = na
var label lbUp200 = na
var label lbDn50  = na
var label lbDn100 = na
var label lbDn150 = na
var label lbDn200 = na

// Box
var box bWin = na

// ─────────────────────────────────────────────────────────────
// Aesthetics (only label BG opacity changed to match auction box)
// ─────────────────────────────────────────────────────────────
orW  = math.min(4, lineWidth + 2)
opW  = math.min(4, lineWidth + 1)
midW = math.max(1, lineWidth)
extW = math.min(3, math.max(1, lineWidth))

cORH = color.new(#2caa6d, 0)
cORL = color.new(color.red,  0)
cOP  = color.new(color.gray, 15)
cMID = color.new(color.gray, 55)

cUP  = color.new(color.aqua, 20)
cDN  = color.new(color.maroon, 20)

// Match label background opacity to the auction shadow box
lbBG_OR = color.new(#787b86, 70)
lbBG_UP = color.new(color.gray, 70)
lbBG_DN = color.new(color.gray, 70)
lbBG_M  = color.new(color.gray, 70)

// Box border state feedback
boxBorderInside  = color.new(color.gray, 55)
boxBorderOutside = color.new(color.gray, 80)

// Label offsets (unchanged)
xOff_ORH = 0
xOff_OP  = 3
xOff_MID = 0
xOff_ORL = 0
xOff_UP  = 0
xOff_DN  = 0

// ─────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────
f_del_line(_l) =>
    if not na(_l)
        line.delete(_l)

f_del_label(_lb) =>
    if not na(_lb)
        label.delete(_lb)

f_del_box(_b) =>
    if not na(_b)
        box.delete(_b)

f_set_line(_l, _y, _extendMode, _clr, _w) =>
    if not na(_l)
        line.set_y1(_l, _y)
        line.set_y2(_l, _y)
        line.set_x2(_l, bar_index)
        line.set_extend(_l, _extendMode)
        line.set_color(_l, _clr)
        line.set_width(_l, _w)

f_set_label(_lb, _y, _txt, _xExtra, _txtClr, _bgClr) =>
    if not na(_lb)
        label.set_xy(_lb, bar_index + labelOffset + _xExtra, _y)
        label.set_text(_lb, _txt)
        label.set_textcolor(_lb, _txtClr)
        label.set_color(_lb, _bgClr)

// ─────────────────────────────────────────────────────────────
// Reset at new ET day
// ─────────────────────────────────────────────────────────────
if newDay
    winHigh := na
    winLow  := na
    open820 := na
    locked  := false

    // delete lines
    f_del_line(lOpen),  lOpen  := na
    f_del_line(lHigh),  lHigh  := na
    f_del_line(lLow),   lLow   := na
    f_del_line(lMid),   lMid   := na
    f_del_line(lUp50),  lUp50  := na
    f_del_line(lUp100), lUp100 := na
    f_del_line(lUp150), lUp150 := na
    f_del_line(lUp200), lUp200 := na
    f_del_line(lDn50),  lDn50  := na
    f_del_line(lDn100), lDn100 := na
    f_del_line(lDn150), lDn150 := na
    f_del_line(lDn200), lDn200 := na

    // delete labels
    f_del_label(lbOpen),  lbOpen  := na
    f_del_label(lbHigh),  lbHigh  := na
    f_del_label(lbLow),   lbLow   := na
    f_del_label(lbMid),   lbMid   := na
    f_del_label(lbUp50),  lbUp50  := na
    f_del_label(lbUp100), lbUp100 := na
    f_del_label(lbUp150), lbUp150 := na
    f_del_label(lbUp200), lbUp200 := na
    f_del_label(lbDn50),  lbDn50  := na
    f_del_label(lbDn100), lbDn100 := na
    f_del_label(lbDn150), lbDn150 := na
    f_del_label(lbDn200), lbDn200 := na

    // delete box
    f_del_box(bWin), bWin := na

// ─────────────────────────────────────────────────────────────
// Create objects on first bar of window (08:20 ET bar)
// ─────────────────────────────────────────────────────────────
if startWindow
    open820 := open
    winHigh := high
    winLow  := low
    locked  := false

    extendMode = extendRight ? extend.right : extend.none

    // Create all needed lines at current bar (x1/x2 both = bar_index; we will keep updating x2)
    if showOpen
        lOpen := line.new(bar_index, open820, bar_index, open820, width=opW, extend=extendMode, color=cOP)

    if showHL
        lHigh := line.new(bar_index, winHigh, bar_index, winHigh, width=orW, extend=extendMode, color=cORH)
        lLow  := line.new(bar_index, winLow,  bar_index, winLow,  width=orW, extend=extendMode, color=cORL)

    float mid = (winHigh + winLow) * 0.5
    if showMid
        lMid := line.new(bar_index, mid, bar_index, mid, width=midW, extend=extendMode, color=cMID)

    float rng = winHigh - winLow
    if showExt
        lUp50  := line.new(bar_index, winHigh + rng * 0.50, bar_index, winHigh + rng * 0.50, width=extW, extend=extendMode, color=cUP)
        lUp100 := line.new(bar_index, winHigh + rng * 1.00, bar_index, winHigh + rng * 1.00, width=extW, extend=extendMode, color=cUP)
        lUp150 := line.new(bar_index, winHigh + rng * 1.50, bar_index, winHigh + rng * 1.50, width=extW, extend=extendMode, color=cUP)
        lUp200 := line.new(bar_index, winHigh + rng * 2.00, bar_index, winHigh + rng * 2.00, width=extW, extend=extendMode, color=cUP)

        lDn50  := line.new(bar_index, winLow - rng * 0.50, bar_index, winLow - rng * 0.50, width=extW, extend=extendMode, color=cDN)
        lDn100 := line.new(bar_index, winLow - rng * 1.00, bar_index, winLow - rng * 1.00, width=extW, extend=extendMode, color=cDN)
        lDn150 := line.new(bar_index, winLow - rng * 1.50, bar_index, winLow - rng * 1.50, width=extW, extend=extendMode, color=cDN)
        lDn200 := line.new(bar_index, winLow - rng * 2.00, bar_index, winLow - rng * 2.00, width=extW, extend=extendMode, color=cDN)

    // Create labels once (then we update their position/text every bar)
    if showLabels
        if showOpen
            lbOpen := label.new(bar_index, open820, "", style=label.style_label_left, textalign=text.align_left)
        if showHL
            lbHigh := label.new(bar_index, winHigh, "", style=label.style_label_left, textalign=text.align_left)
            lbLow  := label.new(bar_index, winLow,  "", style=label.style_label_left, textalign=text.align_left)
        if showMid
            lbMid := label.new(bar_index, mid, "", style=label.style_label_left, textalign=text.align_left)
        if showExt
            lbUp50  := label.new(bar_index, na, "", style=label.style_label_left, textalign=text.align_left)
            lbUp100 := label.new(bar_index, na, "", style=label.style_label_left, textalign=text.align_left)
            lbUp150 := label.new(bar_index, na, "", style=label.style_label_left, textalign=text.align_left)
            lbUp200 := label.new(bar_index, na, "", style=label.style_label_left, textalign=text.align_left)
            lbDn50  := label.new(bar_index, na, "", style=label.style_label_left, textalign=text.align_left)
            lbDn100 := label.new(bar_index, na, "", style=label.style_label_left, textalign=text.align_left)
            lbDn150 := label.new(bar_index, na, "", style=label.style_label_left, textalign=text.align_left)
            lbDn200 := label.new(bar_index, na, "", style=label.style_label_left, textalign=text.align_left)

    // Create lightly shaded window box spanning the 08:20–09:19:59 candles and the evolving range
    bWin := box.new(left=bar_index, top=winHigh, right=bar_index, bottom=winLow,
         bgcolor=color.new(color.gray, 90), border_color=boxBorderOutside)

// ─────────────────────────────────────────────────────────────
// Update range during the window (unlocked only)
// ─────────────────────────────────────────────────────────────
if inWindow and not locked
    winHigh := na(winHigh) ? high : math.max(winHigh, high)
    winLow  := na(winLow)  ? low  : math.min(winLow,  low)

    // Update box to include all candles in the window and the current range
    if not na(bWin)
        box.set_right(bWin, bar_index)
        box.set_top(bWin, winHigh)
        box.set_bottom(bWin, winLow)

// Lock values once the window ends
if endWindow
    locked := true
    // Freeze box at the last bar in the window (endWindow is first bar AFTER window)
    if not na(bWin)
        box.set_right(bWin, bar_index - 1)

// ─────────────────────────────────────────────────────────────
// Compute levels (works both during-window and after lock)
// ─────────────────────────────────────────────────────────────
float rng = (not na(winHigh) and not na(winLow)) ? (winHigh - winLow) : na
float mid = (not na(winHigh) and not na(winLow)) ? ((winHigh + winLow) * 0.5) : na

float up50  = (not na(rng)) ? (winHigh + rng * 0.50) : na
float up100 = (not na(rng)) ? (winHigh + rng * 1.00) : na
float up150 = (not na(rng)) ? (winHigh + rng * 1.50) : na
float up200 = (not na(rng)) ? (winHigh + rng * 2.00) : na

float dn50  = (not na(rng)) ? (winLow - rng * 0.50)  : na
float dn100 = (not na(rng)) ? (winLow - rng * 1.00)  : na
float dn150 = (not na(rng)) ? (winLow - rng * 1.50)  : na
float dn200 = (not na(rng)) ? (winLow - rng * 2.00)  : na

// ─────────────────────────────────────────────────────────────
// Keep lines & labels anchored to price and to the current bar
// ─────────────────────────────────────────────────────────────
extendMode2 = extendRight ? extend.right : extend.none

if not na(open820) and showOpen
    f_set_line(lOpen, open820, extendMode2, cOP, opW)
if not na(winHigh) and showHL
    f_set_line(lHigh, winHigh, extendMode2, cORH, orW)
if not na(winLow) and showHL
    f_set_line(lLow,  winLow,  extendMode2, cORL, orW)
if not na(mid) and showMid
    f_set_line(lMid,  mid,     extendMode2, cMID, midW)

if showExt and not na(rng)
    f_set_line(lUp50,  up50,  extendMode2, cUP, extW)
    f_set_line(lUp100, up100, extendMode2, cUP, extW)
    f_set_line(lUp150, up150, extendMode2, cUP, extW)
    f_set_line(lUp200, up200, extendMode2, cUP, extW)

    f_set_line(lDn50,  dn50,  extendMode2, cDN, extW)
    f_set_line(lDn100, dn100, extendMode2, cDN, extW)
    f_set_line(lDn150, dn150, extendMode2, cDN, extW)
    f_set_line(lDn200, dn200, extendMode2, cDN, extW)

// Option 6: box border state feedback (inside OR vs outside OR)
if not na(bWin) and not na(winHigh) and not na(winLow)
    insideOR = close <= winHigh and close >= winLow
    box.set_border_color(bWin, insideOR ? boxBorderInside : boxBorderOutside)

// Labels (right edge) — Option 5: horizontal staggering for readability
if showLabels
    if showOpen and not na(open820)
        f_set_label(lbOpen, open820, "08:20 Open  " + str.tostring(open820, format.mintick), xOff_OP, color.white, lbBG_OR)
    if showHL and not na(winHigh)
        f_set_label(lbHigh, winHigh, "OR High     " + str.tostring(winHigh, format.mintick), xOff_ORH, color.white, lbBG_OR)
    if showHL and not na(winLow)
        f_set_label(lbLow,  winLow,  "OR Low      " + str.tostring(winLow, format.mintick),  xOff_ORL, color.white, lbBG_OR)
    if showMid and not na(mid)
        f_set_label(lbMid,  mid,     "Mid         " + str.tostring(mid, format.mintick),     xOff_MID, color.white, lbBG_M)

    if showExt and not na(rng)
        f_set_label(lbUp50,  up50,  "+0.5R       " + str.tostring(up50, format.mintick),  xOff_UP, color.white, lbBG_UP)
        f_set_label(lbUp100, up100, "+1.0R       " + str.tostring(up100, format.mintick), xOff_UP, color.white, lbBG_UP)
        f_set_label(lbUp150, up150, "+1.5R       " + str.tostring(up150, format.mintick), xOff_UP, color.white, lbBG_UP)
        f_set_label(lbUp200, up200, "+2.0R       " + str.tostring(up200, format.mintick), xOff_UP, color.white, lbBG_UP)

        f_set_label(lbDn50,  dn50,  "-0.5R       " + str.tostring(dn50, format.mintick),  xOff_DN, color.white, lbBG_DN)
        f_set_label(lbDn100, dn100, "-1.0R       " + str.tostring(dn100, format.mintick), xOff_DN, color.white, lbBG_DN)
        f_set_label(lbDn150, dn150, "-1.5R       " + str.tostring(dn150, format.mintick), xOff_DN, color.white, lbBG_DN)
        f_set_label(lbDn200, dn200, "-2.0R       " + str.tostring(dn200, format.mintick), xOff_DN, color.white, lbBG_DN)
