// © AlphaX
//@version=6
indicator("AlphaXH Breakout Engine – Support Resistance Trend Signals", shorttitle="AlphaX Edge", overlay=true,
  max_labels_count=500, max_bars_back=500, max_boxes_count=500, max_lines_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// ██████████████████████████ ALPHAX EDGE █████████████████████████████████████
// ██████████ Support/Resistance × Breakout × Trend Confluence ████████████████
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ USER INPUTS ═══════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

srSwingLen       = input.int(7,      "S/R Swing Length",            minval=2,   maxval=20,   group="Support / Resistance")
srMergeATR       = input.float(1.2,  "Merge Zones Within (x ATR)", minval=0.3, maxval=3.0,  step=0.1, group="Support / Resistance")
srMaxZones       = input.int(6,      "Max Active Zones",           minval=2,   maxval=20,   group="Support / Resistance")
srMaxAge         = input.int(250,    "Zone Max Age (bars)",         minval=50,  maxval=1000, group="Support / Resistance")
showSRZones      = input.bool(true,  "Show S/R Zones",                                      group="Support / Resistance")
showSRLines      = input.bool(true,  "Show S/R Level Lines",                                group="Support / Resistance")
srMinTouches     = input.int(2,      "Min Touches to Confirm",     minval=1,   maxval=5,    group="Support / Resistance")

showBreakouts    = input.bool(true,  "Show Breakout Labels",                                 group="Breakout Detection")
boVolConfirm     = input.bool(true,  "Require Volume on Breakout",                           group="Breakout Detection")
boVolMulti       = input.float(1.4,  "Breakout Volume Multiplier", minval=1.0, maxval=3.0,  step=0.1, group="Breakout Detection")
boCooldown       = input.int(10,     "Breakout Cooldown (bars)",   minval=2,   maxval=30,   group="Breakout Detection")
showRetests      = input.bool(true,  "Show Retest Labels",                                   group="Breakout Detection")
retestMaxBars    = input.int(12,     "Retest Window (bars)",        minval=3,   maxval=40,   group="Breakout Detection")

trendSwingLen    = input.int(12,     "Trend Swing Length",          minval=3,   maxval=30,   group="Trend Structure")
showTrendLines   = input.bool(true,  "Show Trend Lines",                                    group="Trend Structure")
showTrendLabels  = input.bool(true,  "Show Trend Shift Labels",                             group="Trend Structure")
trendCooldown    = input.int(18,     "Trend Label Cooldown",       minval=5,   maxval=50,   group="Trend Structure")

rsiLen           = input.int(14,     "RSI Length",                  minval=5,   maxval=30,   group="Momentum")
showDivergence   = input.bool(true,  "Show RSI Divergence",                                 group="Momentum")
adxLen           = input.int(14,     "ADX Length",                  minval=7,   maxval=30,   group="Momentum")
adxThresh        = input.int(22,     "ADX Trend Threshold",        minval=10,  maxval=40,   group="Momentum")

volLen           = input.int(20,     "Volume MA Length",            minval=5,   maxval=50,   group="Volume")
showVolBar       = input.bool(true, "Show Volume Spike Dots",                               group="Volume")

bbLen            = input.int(20,     "Bollinger Band Length",       minval=10,  maxval=50,   group="Squeeze Filter")
bbMult           = input.float(2.0,  "BB Multiplier",              minval=1.0, maxval=3.0,  step=0.5, group="Squeeze Filter")
kcLen            = input.int(20,     "Keltner Channel Length",      minval=10,  maxval=50,   group="Squeeze Filter")
kcMult           = input.float(1.5,  "KC Multiplier",              minval=1.0, maxval=3.0,  step=0.5, group="Squeeze Filter")

showEmaFast      = input.bool(true,  "Show Fast EMA",                                      group="EMA Settings")
showEmaMedium    = input.bool(true,  "Show Medium EMA",                                    group="EMA Settings")
showEmaSlow      = input.bool(true,  "Show Slow EMA",                                      group="EMA Settings")
emaFastLen       = input.int(21,     "Fast EMA Length",             minval=1,   maxval=500, group="EMA Settings")
emaMedLen        = input.int(50,     "Medium EMA Length",           minval=1,   maxval=500, group="EMA Settings")
emaSlowLen       = input.int(200,    "Slow EMA Length",             minval=1,   maxval=500, group="EMA Settings")

minConfluence    = input.int(4,      "Min Confluence Score",        minval=1,   maxval=10,  group="Confluence Engine")

stretchDistATR   = input.float(2.0,  "Stretch: Fast EMA Distance (x ATR)", minval=0.5, maxval=5.0, step=0.5, group="Stretch Filter")
stretchSpreadATR = input.float(4.0,  "Stretch: EMA Spread (x ATR)",        minval=0.5, maxval=8.0, step=0.5, group="Stretch Filter")
showSignals      = input.bool(true,  "Show Entry Signals",                                  group="Confluence Engine")
signalCooldown   = input.int(12,     "Signal Cooldown (bars)",      minval=2,   maxval=50,  group="Confluence Engine")


showDash         = input.bool(true,   "Show Dashboard",                                    group="Display")
dashPos          = input.string("Top Right", "Dashboard Position",
  options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"],                         group="Display")
dashSize         = input.string("Tiny", "Dashboard Text Size",
  options=["Tiny", "Small", "Normal"],                                                      group="Display")
color colDashBg  = input.color(#0a0a0a, "Dashboard Background",                            group="Display")
labelSize        = input.string("Tiny", "Label Size",
  options=["Tiny", "Small", "Normal"],                                                      group="Display")

color BULL_PRIMARY   = input.color(#c8e624, "Bull Primary",       group="Theme")
color BULL_BRIGHT    = input.color(#d4f03a, "Bull Bright",        group="Theme")
color BULL_DIM       = input.color(#9ab81c, "Bull Dim",           group="Theme")
color BEAR_PRIMARY   = input.color(#ff1744, "Bear Primary",       group="Theme")
color BEAR_BRIGHT    = input.color(#ff5252, "Bear Bright",        group="Theme")
color BEAR_DIM       = input.color(#d50032, "Bear Dim",           group="Theme")
color SR_BULL_CLR    = input.color(#c8e624, "Support Zone Color", group="Theme")
color SR_BEAR_CLR    = input.color(#ff1744, "Resistance Zone Color", group="Theme")
color SR_NEUTRAL_CLR = input.color(#888888, "Untested Zone Color",group="Theme")
color NEUTRAL_COLOR  = input.color(#555555, "Neutral",            group="Theme")
color EMA_FAST_CLR   = input.color(#c8e624, "Fast EMA",           group="Theme")
color EMA_MED_CLR    = input.color(#888888, "Medium EMA",         group="Theme")
color EMA_SLOW_CLR   = input.color(#555555, "Slow EMA",           group="Theme")

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ CORE CALCULATIONS ════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

f_lSz(s) =>
    switch s
        "Small"  => size.small
        "Normal" => size.normal
        => size.tiny

lblSz = f_lSz(labelSize)

atrVal    = ta.atr(14)
emaFast   = ta.ema(close, emaFastLen)
emaMedium = ta.ema(close, emaMedLen)
emaSlow   = ta.ema(close, emaSlowLen)

emaTrendBull  = emaFast > emaMedium and emaMedium > emaSlow
emaTrendBear  = emaFast < emaMedium and emaMedium < emaSlow
emaFastAbove  = emaFast > emaMedium
priceAboveEma = close > emaSlow
priceBelowEma = close < emaSlow

plot(showEmaFast   ? emaFast   : na, "Fast EMA",   color=EMA_FAST_CLR, linewidth=1, style=plot.style_cross)
plot(showEmaMedium ? emaMedium : na, "Medium EMA",  color=EMA_MED_CLR,  linewidth=1)
plot(showEmaSlow   ? emaSlow   : na, "Slow EMA",    color=EMA_SLOW_CLR, linewidth=2)

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ ADX TREND STRENGTH ═══════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

[diPlus, diMinus, adxValue] = ta.dmi(adxLen, adxLen)
bool adxTrending   = adxValue > adxThresh
bool adxBullDom    = diPlus > diMinus
bool adxBearDom    = diMinus > diPlus
bool adxStrongBull = adxTrending and adxBullDom
bool adxStrongBear = adxTrending and adxBearDom

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ BOLLINGER SQUEEZE ════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

bbBasis  = ta.sma(close, bbLen)
bbDev    = ta.stdev(close, bbLen) * bbMult
bbUpper  = bbBasis + bbDev
bbLower  = bbBasis - bbDev

kcBasis  = ta.ema(close, kcLen)
kcRange  = ta.atr(kcLen) * kcMult
kcUpper  = kcBasis + kcRange
kcLower  = kcBasis - kcRange

bool sqzOn    = bbLower > kcLower and bbUpper < kcUpper
bool sqzOff   = not sqzOn
bool sqzFired = sqzOn[1] and sqzOff

// Squeeze momentum
sqzMom       = ta.linreg(close - ((ta.highest(high, kcLen) + ta.lowest(low, kcLen)) / 2 + kcBasis) / 2, kcLen, 0)
sqzMomUp     = sqzMom > 0 and sqzMom > sqzMom[1]
sqzMomDown   = sqzMom < 0 and sqzMom < sqzMom[1]

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ VOLUME ENGINE ═════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

volSma      = ta.sma(volume, volLen)
volSpike    = volume > volSma * boVolMulti
volAboveAvg = volume > volSma
relVol      = volSma > 0 ? volume / volSma : 1.0

plotshape(showVolBar and volSpike,
  title="Vol Spike", style=shape.circle, location=location.bottom,
  color=close > open ? color.new(BULL_DIM, 30) : color.new(BEAR_DIM, 30), size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ MOMENTUM ENGINE ══════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

rsiRaw       = ta.rsi(close, rsiLen)
rsiSmoothed  = ta.ema(rsiRaw, 5)
rsiSlopeUp   = rsiSmoothed > rsiSmoothed[1] and rsiSmoothed > rsiSmoothed[2]
rsiSlopeDown = rsiSmoothed < rsiSmoothed[1] and rsiSmoothed < rsiSmoothed[2]
rsiOB        = rsiRaw > 70
rsiOS        = rsiRaw < 30

[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)
macdBull     = macdLine > macdSignal
macdBear     = macdLine < macdSignal
macdMomUp    = macdHist > macdHist[1]
macdMomDown  = macdHist < macdHist[1]

stochK    = ta.stoch(close, high, low, 14)
stochD    = ta.sma(stochK, 3)
stochBull = stochK > stochD and stochK < 80
stochBear = stochK < stochD and stochK > 20

int momBullCount = (rsiSlopeUp and rsiRaw > 40 ? 1 : 0) + (macdBull ? 1 : 0) + (macdMomUp ? 1 : 0) + (stochBull ? 1 : 0)
int momBearCount = (rsiSlopeDown and rsiRaw < 60 ? 1 : 0) + (macdBear ? 1 : 0) + (macdMomDown ? 1 : 0) + (stochBear ? 1 : 0)
bool momBullish = momBullCount >= 2
bool momBearish = momBearCount >= 2

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ RSI DIVERGENCE ════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

pivLB = 5
rsiPH = ta.pivothigh(rsiRaw, pivLB, pivLB)
rsiPL = ta.pivotlow(rsiRaw,  pivLB, pivLB)
prcPH = ta.pivothigh(high,   pivLB, pivLB)
prcPL = ta.pivotlow(low,     pivLB, pivLB)

var float pRL = na, var float pPL = na, var int pRLB = na
var float cRL = na, var float cPL = na, var int cRLB = na
var float pRH = na, var float pPH = na, var int pRHB = na
var float cRH = na, var float cPH = na, var int cRHB = na

if not na(rsiPL)
    pRL := cRL, pPL := cPL, pRLB := cRLB
    cRL := rsiPL, cPL := prcPL, cRLB := bar_index - pivLB
if not na(rsiPH)
    pRH := cRH, pPH := cPH, pRHB := cRHB
    cRH := rsiPH, cPH := prcPH, cRHB := bar_index - pivLB

bool rsiBullDiv = showDivergence and not na(pPL) and not na(cPL) and not na(pRL) and not na(cRL) and
  cPL < pPL and cRL > pRL and bar_index - cRLB <= 3 and cRLB - pRLB >= 5 and cRLB - pRLB <= 50
bool rsiBearDiv = showDivergence and not na(pPH) and not na(cPH) and not na(pRH) and not na(cRH) and
  cPH > pPH and cRH < pRH and bar_index - cRHB <= 3 and cRHB - pRHB >= 5 and cRHB - pRHB <= 50

plotshape(rsiBullDiv, title="RSI Bull Div", style=shape.diamond,
  location=location.belowbar, color=BULL_DIM, size=size.tiny)
plotshape(rsiBearDiv, title="RSI Bear Div", style=shape.diamond,
  location=location.abovebar, color=BEAR_DIM, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ SWING DETECTION ══════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

srPivH = ta.pivothigh(high, srSwingLen, srSwingLen)
srPivL = ta.pivotlow(low,   srSwingLen, srSwingLen)

var array<float> swHighP = array.new_float(0)
var array<int>   swHighB = array.new_int(0)
var array<float> swLowP  = array.new_float(0)
var array<int>   swLowB  = array.new_int(0)

if not na(srPivH)
    array.push(swHighP, srPivH)
    array.push(swHighB, bar_index - srSwingLen)
    if array.size(swHighP) > 20
        array.shift(swHighP), array.shift(swHighB)

if not na(srPivL)
    array.push(swLowP, srPivL)
    array.push(swLowB, bar_index - srSwingLen)
    if array.size(swLowP) > 20
        array.shift(swLowP), array.shift(swLowB)

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ S/R ENGINE ════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

type SRZone
    float   level
    float   upper
    float   lower
    int     firstBar
    int     lastTouchBar
    int     touches
    bool    isSupport
    bool    broken
    bool    retested
    int     breakBar
    box     bx
    line    ln
    bool    active

var array<SRZone> srZones = array.new<SRZone>()

float mergeThresh = atrVal * srMergeATR

findExistingZone(float price) =>
    int found = -1
    if array.size(srZones) > 0
        for i = 0 to array.size(srZones) - 1
            z = array.get(srZones, i)
            if z.active and math.abs(z.level - price) < mergeThresh
                found := i
                break
    found

if not na(srPivH)
    int idx = findExistingZone(srPivH)
    if idx >= 0
        z = array.get(srZones, idx)
        z.level := (z.level * z.touches + srPivH) / (z.touches + 1)
        z.touches += 1
        z.lastTouchBar := bar_index - srSwingLen
        z.upper := z.level + atrVal * 0.25
        z.lower := z.level - atrVal * 0.25
        if not na(z.bx)
            box.set_top(z.bx, z.upper), box.set_bottom(z.bx, z.lower)
        if not na(z.ln)
            line.set_y1(z.ln, z.level), line.set_y2(z.ln, z.level)
    else
        if array.size(srZones) >= srMaxZones
            oldest = array.shift(srZones)
            box.delete(oldest.bx), line.delete(oldest.ln)
        float zL = srPivH
        float zU = zL + atrVal * 0.25
        float zD = zL - atrVal * 0.25
        int   zB = bar_index - srSwingLen
        newZ = SRZone.new(level=zL, upper=zU, lower=zD, firstBar=zB, lastTouchBar=zB,
          touches=1, isSupport=false, broken=false, retested=false, breakBar=0,
          bx=showSRZones ? box.new(zB, zU, bar_index+2, zD,
             border_color=color.new(SR_NEUTRAL_CLR,60), bgcolor=color.new(SR_NEUTRAL_CLR,93),
             border_width=1, extend=extend.right) : na,
          ln=showSRLines ? line.new(zB, zL, bar_index+2, zL,
             color=color.new(SR_NEUTRAL_CLR,50), style=line.style_dotted, width=1, extend=extend.right) : na,
          active=true)
        array.push(srZones, newZ)

if not na(srPivL)
    int idx = findExistingZone(srPivL)
    if idx >= 0
        z = array.get(srZones, idx)
        z.level := (z.level * z.touches + srPivL) / (z.touches + 1)
        z.touches += 1
        z.lastTouchBar := bar_index - srSwingLen
        z.isSupport := true
        z.upper := z.level + atrVal * 0.25
        z.lower := z.level - atrVal * 0.25
        if not na(z.bx)
            box.set_top(z.bx, z.upper), box.set_bottom(z.bx, z.lower)
        if not na(z.ln)
            line.set_y1(z.ln, z.level), line.set_y2(z.ln, z.level)
    else
        if array.size(srZones) >= srMaxZones
            oldest = array.shift(srZones)
            box.delete(oldest.bx), line.delete(oldest.ln)
        float zL = srPivL
        float zU = zL + atrVal * 0.25
        float zD = zL - atrVal * 0.25
        int   zB = bar_index - srSwingLen
        newZ = SRZone.new(level=zL, upper=zU, lower=zD, firstBar=zB, lastTouchBar=zB,
          touches=1, isSupport=true, broken=false, retested=false, breakBar=0,
          bx=showSRZones ? box.new(zB, zU, bar_index+2, zD,
             border_color=color.new(SR_NEUTRAL_CLR,60), bgcolor=color.new(SR_NEUTRAL_CLR,93),
             border_width=1, extend=extend.right) : na,
          ln=showSRLines ? line.new(zB, zL, bar_index+2, zL,
             color=color.new(SR_NEUTRAL_CLR,50), style=line.style_dotted, width=1, extend=extend.right) : na,
          active=true)
        array.push(srZones, newZ)

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ CANDLE METRICS (early calc for breakout filter) ══
// ═══════════════════════════════════════════════════════════════════════════════

float bodySize  = math.abs(close - open)
float candleRng = high - low
float upperWick = high - math.max(close, open)
float lowerWick = math.min(close, open) - low

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ S/R ZONE MANAGEMENT ══════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

var bool priceAtSupport    = false
var bool priceAtResistance = false
var bool breakoutUp        = false
var bool breakoutDown      = false
var bool retestBull        = false
var bool retestBear        = false
var int  lastBreakoutBar   = 0

priceAtSupport    := false
priceAtResistance := false
breakoutUp        := false
breakoutDown      := false
retestBull        := false
retestBear        := false

if array.size(srZones) > 0
    for i = array.size(srZones) - 1 to 0
        z = array.get(srZones, i)
        if not z.active
            continue
        if bar_index - z.firstBar > srMaxAge
            z.active := false
            box.delete(z.bx), line.delete(z.ln)
            array.remove(srZones, i)
            continue

        bool confirmed = z.touches >= srMinTouches
        if not z.broken
            if z.isSupport and confirmed
                if not na(z.bx)
                    box.set_border_color(z.bx, color.new(SR_BULL_CLR, 55))
                    box.set_bgcolor(z.bx, color.new(SR_BULL_CLR, 92))
                if not na(z.ln)
                    line.set_color(z.ln, color.new(SR_BULL_CLR, 45))
            else if not z.isSupport and confirmed
                if not na(z.bx)
                    box.set_border_color(z.bx, color.new(SR_BEAR_CLR, 55))
                    box.set_bgcolor(z.bx, color.new(SR_BEAR_CLR, 92))
                if not na(z.ln)
                    line.set_color(z.ln, color.new(SR_BEAR_CLR, 45))

        if not z.broken and confirmed
            if low <= z.upper and high >= z.lower
                if z.isSupport
                    priceAtSupport := true
                else
                    priceAtResistance := true

        if not z.broken and confirmed and (bar_index - lastBreakoutBar) >= boCooldown
            bool volOK = not boVolConfirm or volSpike or volAboveAvg

            // Anti-fake: require candle body to close convincingly beyond the level
            float breakMargin = atrVal * 0.15

            // Anti-fake: require body strength on breakout candle
            bool breakCandleStrong = bodySize > candleRng * 0.4

            // Resistance breakout (bullish)
            if not z.isSupport and close > z.upper + breakMargin and close[1] <= z.upper and volOK and breakCandleStrong
                // Anti-fake: reject if RSI is extremely overbought (exhaustion break)
                if not rsiOB or adxStrongBull
                    z.broken := true, z.breakBar := bar_index, breakoutUp := true
                    lastBreakoutBar := bar_index, z.isSupport := true
                    if not na(z.bx)
                        box.set_border_color(z.bx, color.new(BULL_DIM, 65))
                        box.set_bgcolor(z.bx, color.new(BULL_DIM, 94))
                    if not na(z.ln)
                        line.set_color(z.ln, color.new(BULL_DIM, 55))
                        line.set_style(z.ln, line.style_dashed)

            // Support breakdown (bearish)
            if z.isSupport and not z.broken and close < z.lower - breakMargin and close[1] >= z.lower and volOK and breakCandleStrong
                if not rsiOS or adxStrongBear
                    z.broken := true, z.breakBar := bar_index, breakoutDown := true
                    lastBreakoutBar := bar_index, z.isSupport := false
                    if not na(z.bx)
                        box.set_border_color(z.bx, color.new(BEAR_DIM, 65))
                        box.set_bgcolor(z.bx, color.new(BEAR_DIM, 94))
                    if not na(z.ln)
                        line.set_color(z.ln, color.new(BEAR_DIM, 55))
                        line.set_style(z.ln, line.style_dashed)

        if z.broken and not z.retested and bar_index - z.breakBar <= retestMaxBars and bar_index - z.breakBar >= 2
            if z.isSupport and low <= z.upper and low >= z.lower and close > z.level and close > open
                z.retested := true, retestBull := true
            if not z.isSupport and high >= z.lower and high <= z.upper and close < z.level and close < open
                z.retested := true, retestBear := true

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ TREND STRUCTURE ══════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

tPivH = ta.pivothigh(high, trendSwingLen, trendSwingLen)
tPivL = ta.pivotlow(low,   trendSwingLen, trendSwingLen)

var float tLastHigh = na, var float tPrevHigh = na
var float tLastLow  = na, var float tPrevLow  = na
var int   tLastHighBar = na, var int tPrevHighBar = na
var int   tLastLowBar  = na, var int tPrevLowBar  = na
var int   trendDir     = 0

if not na(tPivH)
    tPrevHigh := tLastHigh, tPrevHighBar := tLastHighBar
    tLastHigh := tPivH, tLastHighBar := bar_index - trendSwingLen
if not na(tPivL)
    tPrevLow := tLastLow, tPrevLowBar := tLastLowBar
    tLastLow := tPivL, tLastLowBar := bar_index - trendSwingLen

bool higherHigh = not na(tLastHigh) and not na(tPrevHigh) and tLastHigh > tPrevHigh
bool higherLow  = not na(tLastLow) and not na(tPrevLow) and tLastLow > tPrevLow
bool lowerHigh  = not na(tLastHigh) and not na(tPrevHigh) and tLastHigh < tPrevHigh
bool lowerLow   = not na(tLastLow) and not na(tPrevLow) and tLastLow < tPrevLow

bool structBull = higherHigh and higherLow
bool structBear = lowerHigh and lowerLow

var int lastTrendLabelBar = 0

if structBull and trendDir != 1 and (bar_index - lastTrendLabelBar) >= trendCooldown
    trendDir := 1, lastTrendLabelBar := bar_index
    if showTrendLabels
        label.new(bar_index, low, text="UPTREND ▲", yloc=yloc.belowbar,
          color=color.new(BULL_PRIMARY, 15), textcolor=#1a1a1a,
          size=lblSz, style=label.style_label_up)

if structBear and trendDir != -1 and (bar_index - lastTrendLabelBar) >= trendCooldown
    trendDir := -1, lastTrendLabelBar := bar_index
    if showTrendLabels
        label.new(bar_index, high, text="DOWNTREND ▼", yloc=yloc.abovebar,
          color=color.new(BEAR_PRIMARY, 15), textcolor=#ffffff,
          size=lblSz, style=label.style_label_down)
          
// ── Trend Lines ────────────────────────────────────────────────────────────────
var line bullTL = na
var line bearTL = na

if showTrendLines and not na(tPrevLow) and not na(tLastLow) and not na(tPrevLowBar) and not na(tLastLowBar) and trendDir == 1
    if not na(bullTL)
        line.delete(bullTL)
    if tLastLowBar > tPrevLowBar
        bullTL := line.new(tPrevLowBar, tPrevLow, tLastLowBar, tLastLow,
          color=color.new(BULL_DIM, 30), width=2, extend=extend.right)

if showTrendLines and not na(tPrevHigh) and not na(tLastHigh) and not na(tPrevHighBar) and not na(tLastHighBar) and trendDir == -1
    if not na(bearTL)
        line.delete(bearTL)
    if tLastHighBar > tPrevHighBar
        bearTL := line.new(tPrevHighBar, tPrevHigh, tLastHighBar, tLastHigh,
          color=color.new(BEAR_DIM, 30), width=2, extend=extend.right)

// ── Candlestick Patterns ───────────────────────────────────────────────────────
bool bullEngulf  = close > open and close[1] < open[1] and close > open[1] and open < close[1]
bool bearEngulf  = close < open and close[1] > open[1] and close < open[1] and open > close[1]
bool pinBarBull  = lowerWick > bodySize * 2.0 and lowerWick > upperWick * 2.0 and candleRng > atrVal * 0.5
bool pinBarBear  = upperWick > bodySize * 2.0 and upperWick > lowerWick * 2.0 and candleRng > atrVal * 0.5
bool strongBullC = close > open and bodySize > candleRng * 0.6
bool strongBearC = close < open and bodySize > candleRng * 0.6

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ CONFLUENCE SCORING ═══════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

// 10 factors per direction

int bullCF = 0
bullCF += priceAtSupport ? 1 : 0                                              // 1 S/R
bullCF += breakoutUp ? 1 : 0                                                   // 2 Breakout
bullCF += retestBull ? 1 : 0                                                   // 3 Retest
bullCF += trendDir == 1 or structBull ? 1 : 0                                  // 4 Trend
bullCF += momBullish ? 1 : 0                                                   // 5 Momentum
bullCF += (rsiBullDiv or bullEngulf or pinBarBull) ? 1 : 0                     // 6 Pattern
bullCF += (volAboveAvg and close > open) ? 1 : 0                              // 7 Volume
bullCF += emaTrendBull or (priceAboveEma and emaFastAbove) ? 1 : 0             // 8 EMA
bullCF += adxStrongBull ? 1 : 0                                                // 9 ADX
bullCF += (sqzFired and sqzMomUp) or (sqzOff and sqzMomUp) ? 1 : 0            // 10 Squeeze

int bearCF = 0
bearCF += priceAtResistance ? 1 : 0
bearCF += breakoutDown ? 1 : 0
bearCF += retestBear ? 1 : 0
bearCF += trendDir == -1 or structBear ? 1 : 0
bearCF += momBearish ? 1 : 0
bearCF += (rsiBearDiv or bearEngulf or pinBarBear) ? 1 : 0
bearCF += (volAboveAvg and close < open) ? 1 : 0
bearCF += emaTrendBear or (priceBelowEma and not emaFastAbove) ? 1 : 0
bearCF += adxStrongBear ? 1 : 0
bearCF += (sqzFired and sqzMomDown) or (sqzOff and sqzMomDown) ? 1 : 0

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ CONFIDENCE ════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

calcBullConf() =>
    float c = 0.0
    // Structure factors (highest weight — these are what matters)
    c += priceAtSupport ? 14.0 : 0.0
    c += breakoutUp ? 16.0 : 0.0
    c += retestBull ? 20.0 : 0.0
    c += trendDir == 1 ? 10.0 : structBull ? 6.0 : 0.0

    // Momentum confirmation
    c += momBullish ? 8.0 : 0.0
    c += momBullCount >= 3 ? 4.0 : 0.0

    // Pattern / Divergence
    c += rsiBullDiv ? 8.0 : 0.0
    c += bullEngulf ? 6.0 : pinBarBull ? 5.0 : strongBullC ? 2.0 : 0.0

    // Volume
    c += volAboveAvg and close > open ? 4.0 : 0.0
    c += volSpike and close > open ? 4.0 : 0.0

    // Trend alignment
    c += emaTrendBull ? 8.0 : (priceAboveEma and emaFastAbove ? 4.0 : 0.0)

    // ADX strength
    c += adxStrongBull ? 8.0 : (adxBullDom and adxTrending ? 4.0 : 0.0)

    // Squeeze
    c += sqzFired and sqzMomUp ? 10.0 : (sqzOff and sqzMomUp ? 3.0 : 0.0)

    // ── Heavy Penalties ────────────────────────────────────────────────────────
    c -= rsiOB ? 10.0 : 0.0                          // Overbought — exhaustion risk
    c -= not adxTrending ? 8.0 : 0.0                  // No trend — chop zone
    c -= trendDir == -1 ? 12.0 : 0.0                  // Counter-trend — fighting the flow
    c -= (not priceAtSupport and not breakoutUp and not retestBull) ? 8.0 : 0.0  // No structural reason
    float _dist = math.abs(close - emaFast) / atrVal
    float _spread = math.abs(emaFast - emaSlow) / atrVal
    c -= _dist > stretchDistATR * 1.5 ? 6.0 : _dist > stretchDistATR ? 3.0 : 0.0
    c -= _spread > stretchSpreadATR * 1.5 ? 4.0 : _spread > stretchSpreadATR ? 2.0 : 0.0
    c -= (not volAboveAvg) ? 4.0 : 0.0                // No volume — weak conviction
    c -= sqzOn ? 5.0 : 0.0                            // Inside squeeze — wait for fire
    math.max(0.0, math.min(100.0, c))

calcBearConf() =>
    float c = 0.0
    c += priceAtResistance ? 14.0 : 0.0
    c += breakoutDown ? 16.0 : 0.0
    c += retestBear ? 20.0 : 0.0
    c += trendDir == -1 ? 10.0 : structBear ? 6.0 : 0.0

    c += momBearish ? 8.0 : 0.0
    c += momBearCount >= 3 ? 4.0 : 0.0

    c += rsiBearDiv ? 8.0 : 0.0
    c += bearEngulf ? 6.0 : pinBarBear ? 5.0 : strongBearC ? 2.0 : 0.0

    c += volAboveAvg and close < open ? 4.0 : 0.0
    c += volSpike and close < open ? 4.0 : 0.0

    c += emaTrendBear ? 8.0 : (priceBelowEma and not emaFastAbove ? 4.0 : 0.0)

    c += adxStrongBear ? 8.0 : (adxBearDom and adxTrending ? 4.0 : 0.0)

    c += sqzFired and sqzMomDown ? 10.0 : (sqzOff and sqzMomDown ? 3.0 : 0.0)

    c -= rsiOS ? 10.0 : 0.0
    c -= not adxTrending ? 8.0 : 0.0
    c -= trendDir == 1 ? 12.0 : 0.0
    c -= (not priceAtResistance and not breakoutDown and not retestBear) ? 8.0 : 0.0
    c -= math.abs(close - emaFast) / atrVal > 3.0 ? 6.0 : 0.0
    c -= (not volAboveAvg) ? 4.0 : 0.0
    c -= sqzOn ? 5.0 : 0.0
    math.max(0.0, math.min(100.0, c))

float bullConf = calcBullConf()
float bearConf = calcBearConf()

getGrade(float conf) =>
    conf >= 70 ? "A+" : conf >= 55 ? "A" : conf >= 40 ? "B" : conf >= 25 ? "C" : "D"

getGradeColor(float conf, bool isBull) =>
    conf >= 70 ? (isBull ? BULL_BRIGHT : BEAR_BRIGHT) :
      conf >= 55 ? (isBull ? BULL_PRIMARY : BEAR_PRIMARY) :
      conf >= 40 ? (isBull ? BULL_DIM : BEAR_DIM) : NEUTRAL_COLOR

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ SIGNAL GENERATION ════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

var int    lastSigBar   = 0
var int    lastSigDir   = 0
var float  lastSigPrice = na
var string lastSigGrade = ""
var float  lastSigConf  = 0.0
var int    lastSigScore = 0
var string lastSigDet   = ""

bool cdOK = (bar_index - lastSigBar) >= signalCooldown

// ── Anti-Fake Breakout Filter ──────────────────────────────────────────────────
// Reject breakouts at extreme RSI (exhaustion breakouts fail often)
bool fakeBreakoutRisk = (breakoutUp and rsiOB) or (breakoutDown and rsiOS)

// Reject signals when price is far from EMAs (overextended)
float distFromFastEma = math.abs(close - emaFast) / atrVal
float emaSpread    = math.abs(emaFast - emaSlow) / atrVal
bool overextended  = distFromFastEma > 3.5
bool emaStretched  = distFromFastEma > stretchDistATR or emaSpread > stretchSpreadATR

// Reject signals in low ADX chop
bool trendFilter = adxTrending or sqzFired

// Require candle body strength (not doji/indecision)
float bodyRatio = candleRng > 0 ? bodySize / candleRng : 0
bool strongCandle = bodyRatio > 0.35

// ── Must have at least one structural factor (not just momentum noise) ─────────
bool bullHasStructure = priceAtSupport or breakoutUp or retestBull or trendDir == 1
bool bearHasStructure = priceAtResistance or breakoutDown or retestBear or trendDir == -1

bool bullSignal = showSignals and bullCF >= minConfluence and cdOK and close > open and
  trendFilter and strongCandle and not fakeBreakoutRisk and not overextended and bullHasStructure

bool bearSignal = showSignals and bearCF >= minConfluence and cdOK and close < open and
  trendFilter and strongCandle and not fakeBreakoutRisk and not overextended and bearHasStructure

if bullSignal and bearSignal
    if bullCF > bearCF
        bearSignal := false
    else if bearCF > bullCF
        bullSignal := false
    else
        bullSignal := false
        bearSignal := false

// Build detail strings
string bullDet = ""
bullDet += priceAtSupport ? "✓SUP " : ""
bullDet += breakoutUp ? "✓BRK " : ""
bullDet += retestBull ? "✓RET " : ""
bullDet += (trendDir == 1 or structBull) ? "✓TRD " : ""
bullDet += momBullish ? "✓MOM " : ""
bullDet += (rsiBullDiv or bullEngulf or pinBarBull) ? "✓PAT " : ""
bullDet += (volAboveAvg and close > open) ? "✓VOL " : ""
bullDet += (emaTrendBull or (priceAboveEma and emaFastAbove)) ? "✓EMA " : ""
bullDet += adxStrongBull ? "✓ADX " : ""
bullDet += ((sqzFired and sqzMomUp) or (sqzOff and sqzMomUp)) ? "✓SQZ " : ""

string bearDet = ""
bearDet += priceAtResistance ? "✓RES " : ""
bearDet += breakoutDown ? "✓BRK " : ""
bearDet += retestBear ? "✓RET " : ""
bearDet += (trendDir == -1 or structBear) ? "✓TRD " : ""
bearDet += momBearish ? "✓MOM " : ""
bearDet += (rsiBearDiv or bearEngulf or pinBarBear) ? "✓PAT " : ""
bearDet += (volAboveAvg and close < open) ? "✓VOL " : ""
bearDet += (emaTrendBear or (priceBelowEma and not emaFastAbove)) ? "✓EMA " : ""
bearDet += adxStrongBear ? "✓ADX " : ""
bearDet += ((sqzFired and sqzMomDown) or (sqzOff and sqzMomDown)) ? "✓SQZ " : ""

if bullSignal
    lastSigBar   := bar_index
    lastSigDir   := 1
    lastSigPrice := close
    lastSigGrade := getGrade(bullConf)
    lastSigConf  := bullConf
    lastSigScore := bullCF
    lastSigDet   := bullDet

if bearSignal
    lastSigBar   := bar_index
    lastSigDir   := -1
    lastSigPrice := close
    lastSigGrade := getGrade(bearConf)
    lastSigConf  := bearConf
    lastSigScore := bearCF
    lastSigDet   := bearDet


// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ VISUAL OUTPUT ════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

if showBreakouts and breakoutUp
    string boUpTxt = emaStretched ? "BREAKOUT ▲  ⚠ STRETCHED" : "BREAKOUT ▲"
    color  boUpClr = emaStretched ? color.new(BULL_DIM, 15) : color.new(BULL_PRIMARY, 15)
    label.new(bar_index, low, text=boUpTxt, yloc=yloc.belowbar,
      color=boUpClr, textcolor=#1a1a1a,
      size=lblSz, style=label.style_label_up)
if showBreakouts and breakoutDown
    string boDnTxt = emaStretched ? "BREAKOUT ▼  ⚠ STRETCHED" : "BREAKOUT ▼"
    color  boDnClr = emaStretched ? color.new(BEAR_DIM, 15) : color.new(BEAR_PRIMARY, 15)
    label.new(bar_index, high, text=boDnTxt, yloc=yloc.abovebar,
      color=boDnClr, textcolor=#ffffff,
      size=lblSz, style=label.style_label_down)

if showRetests and retestBull
    label.new(bar_index, low, text="RETEST ▲", yloc=yloc.belowbar,
      color=color.new(BULL_DIM, 20), textcolor=BULL_BRIGHT,
      size=lblSz, style=label.style_label_up)
if showRetests and retestBear
    label.new(bar_index, high, text="RETEST ▼", yloc=yloc.abovebar,
      color=color.new(BEAR_DIM, 20), textcolor=BEAR_BRIGHT,
      size=lblSz, style=label.style_label_down)

// ── Clean Triangle Signals ─────────────────────────────────────────────────────
plotshape(bullSignal, title="Long Signal",
  style=shape.triangleup, location=location.belowbar,
  color=getGradeColor(bullConf, true), size=size.small)

plotshape(bearSignal, title="Short Signal",
  style=shape.triangledown, location=location.abovebar,
  color=getGradeColor(bearConf, false), size=size.small)

  

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ DASHBOARD ════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

color colTL = #cccccc
color colNL = #888888
color colDV = #555555

f_dPos(p) =>
    switch p
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        => position.bottom_left

f_dSz(s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        => size.normal

dTxtSz = f_dSz(dashSize)

int supCount = 0
int resCount = 0
if array.size(srZones) > 0
    for i = 0 to array.size(srZones) - 1
        z = array.get(srZones, i)
        if z.active and z.touches >= srMinTouches
            if z.isSupport
                supCount += 1
            else
                resCount += 1

string trendTxt = trendDir == 1 ? "▲ UPTREND" : trendDir == -1 ? "▼ DOWNTREND" : "— RANGING"
color  trendClr = trendDir == 1 ? BULL_PRIMARY : trendDir == -1 ? BEAR_PRIMARY : colNL

string structTxt = structBull ? "▲ HH + HL" : structBear ? "▼ LH + LL" :
  higherHigh ? "▲ HIGHER HIGH" : lowerLow ? "▼ LOWER LOW" : "— FLAT"
color  structClr = structBull ? BULL_PRIMARY : structBear ? BEAR_PRIMARY :
  higherHigh ? BULL_DIM : lowerLow ? BEAR_DIM : colNL

string momTx = momBullCount >= 3 ? "▲▲ STRONG BULL" : momBullish ? "▲ BULLISH" :
  momBearCount >= 3 ? "▼▼ STRONG BEAR" : momBearish ? "▼ BEARISH" : "— FLAT"
color  momCl = momBullCount >= 3 ? BULL_BRIGHT : momBullish ? BULL_PRIMARY :
  momBearCount >= 3 ? BEAR_BRIGHT : momBearish ? BEAR_PRIMARY : colNL

string posTxt = priceAtSupport ? "AT SUPPORT ▲" : priceAtResistance ? "AT RESISTANCE ▼" :
  breakoutUp ? "BREAKOUT ▲" : breakoutDown ? "BREAKOUT ▼" :
  retestBull ? "RETEST ▲" : retestBear ? "RETEST ▼" : "BETWEEN LEVELS"
color  posClr = priceAtSupport ? BULL_PRIMARY : priceAtResistance ? BEAR_PRIMARY :
  breakoutUp ? BULL_BRIGHT : breakoutDown ? BEAR_BRIGHT :
  retestBull ? BULL_DIM : retestBear ? BEAR_DIM : colNL

string adxTxt = adxStrongBull ? "▲ STRONG TREND" : adxStrongBear ? "▼ STRONG TREND" :
  adxTrending ? "TRENDING" : "WEAK / RANGE"
color  adxClr = adxStrongBull ? BULL_PRIMARY : adxStrongBear ? BEAR_PRIMARY :
  adxTrending ? colNL : NEUTRAL_COLOR

string sqzTxt = sqzOn ? "● SQUEEZE ON" : sqzFired ? "◆ SQUEEZE FIRED" :
  sqzMomUp ? "▲ EXPANDING" : sqzMomDown ? "▼ EXPANDING" : "— NORMAL"
color  sqzClr = sqzOn ? NEUTRAL_COLOR : sqzFired ? BULL_BRIGHT :
  sqzMomUp ? BULL_DIM : sqzMomDown ? BEAR_DIM : colNL

string vrdTxt = "✕  NO CLEAR EDGE"
color  vrdClr = colNL
if bullCF >= 6 and momBullish and trendDir == 1 and adxStrongBull and not rsiOB
    vrdTxt := "✓  HIGH CONFIDENCE LONG"
    vrdClr := BULL_BRIGHT
else if bearCF >= 6 and momBearish and trendDir == -1 and adxStrongBear and not rsiOS
    vrdTxt := "✓  HIGH CONFIDENCE SHORT"
    vrdClr := BEAR_BRIGHT
else if bullCF >= minConfluence and momBullish and trendDir >= 0 and adxTrending
    vrdTxt := "△  LEAN LONG — CAUTION"
    vrdClr := BULL_DIM
else if bearCF >= minConfluence and momBearish and trendDir <= 0 and adxTrending
    vrdTxt := "▽  LEAN SHORT — CAUTION"
    vrdClr := BEAR_DIM
else if bullCF >= minConfluence and bearCF >= minConfluence
    vrdTxt := "✕  MIXED — STAND ASIDE"
else if sqzOn
    vrdTxt := "● SQUEEZE — WAIT FOR FIRE"
    vrdClr := NEUTRAL_COLOR
else if not adxTrending
    vrdTxt := "✕  WEAK TREND — STAND ASIDE"
    vrdClr := NEUTRAL_COLOR

// Last signal info for dashboard
string lastSigTxt = "NO SIGNAL"
color  lastSigClr = colNL
string lastSigDetTxt = ""
if lastSigDir == 1
    lastSigTxt := "▲ LONG | " + lastSigGrade + " | " + str.tostring(math.round(lastSigConf)) + "% | " + str.tostring(lastSigScore) + "/10"
    lastSigClr := getGradeColor(lastSigConf, true)
    lastSigDetTxt := lastSigDet
else if lastSigDir == -1
    lastSigTxt := "▼ SHORT | " + lastSigGrade + " | " + str.tostring(math.round(lastSigConf)) + "% | " + str.tostring(lastSigScore) + "/10"
    lastSigClr := getGradeColor(lastSigConf, false)
    lastSigDetTxt := lastSigDet

string lastSigAge = lastSigBar > 0 ? str.tostring(bar_index - lastSigBar) + " bars ago" : ""

var table dash = na
if showDash
    dash := table.new(f_dPos(dashPos), 3, 20,
      bgcolor=color.new(colDashBg, 0), border_width=1,
      border_color=color.new(colDV, 70), frame_width=2,
      frame_color=color.new(colDV, 35))

if showDash and barstate.islast
    string ttSz = dashSize == "Tiny" ? size.small : dashSize == "Small" ? size.normal : size.large

    table.cell(dash, 0, 0, "A L P H A X   E D G E",
      text_color=BULL_PRIMARY, text_size=ttSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 0, "", bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 0, "", bgcolor=color.new(colDashBg, 0))
    table.merge_cells(dash, 0, 0, 2, 0)

    table.cell(dash, 0, 1, "S/R  ×  BREAKOUT  ×  TREND  ×  SQUEEZE",
      text_color=colNL, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 1, "", bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 1, "", bgcolor=color.new(colDashBg, 0))
    table.merge_cells(dash, 0, 1, 2, 1)

    table.cell(dash, 0, 2, "METRIC", text_color=colNL, text_size=dTxtSz, bgcolor=color.new(colDV, 85))
    table.cell(dash, 1, 2, "STATE",  text_color=colNL, text_size=dTxtSz, bgcolor=color.new(colDV, 85))
    table.cell(dash, 2, 2, "DETAIL", text_color=colNL, text_size=dTxtSz, bgcolor=color.new(colDV, 85))

    table.cell(dash, 0, 3, "PRICE POSITION", text_color=colTL, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 3, posTxt, text_color=posClr, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 3, "S:" + str.tostring(supCount) + " R:" + str.tostring(resCount),
      text_color=colNL, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))

    table.cell(dash, 0, 4, "TREND", text_color=colTL, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 4, trendTxt, text_color=trendClr, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 4, structTxt, text_color=structClr, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))

    table.cell(dash, 0, 5, "EMA TREND", text_color=colTL, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 5, emaTrendBull ? "▲ BULL ALIGNED" : emaTrendBear ? "▼ BEAR ALIGNED" : "— MIXED",
      text_color=emaTrendBull ? BULL_PRIMARY : emaTrendBear ? BEAR_PRIMARY : colNL,
      text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 5, priceAboveEma ? "> 200 EMA" : priceBelowEma ? "< 200 EMA" : "AT 200",
      text_color=priceAboveEma ? BULL_DIM : priceBelowEma ? BEAR_DIM : colNL,
      text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))

    table.cell(dash, 0, 6, "ADX", text_color=colTL, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 6, adxTxt, text_color=adxClr, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 6, str.tostring(math.round(adxValue)),
      text_color=adxTrending ? colTL : NEUTRAL_COLOR, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))

    table.cell(dash, 0, 7, "SQUEEZE", text_color=colTL, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 7, sqzTxt, text_color=sqzClr, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 7, "", bgcolor=color.new(colDashBg, 0))

    table.cell(dash, 0, 8, "──────────────────────────────",
      text_color=colDV, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 8, "", bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 8, "", bgcolor=color.new(colDashBg, 0))
    table.merge_cells(dash, 0, 8, 2, 8)

    table.cell(dash, 0, 9, "MOMENTUM", text_color=colTL, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 9, momTx, text_color=momCl, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 9, str.tostring(momBullCount) + "▲  " + str.tostring(momBearCount) + "▼",
      text_color=colNL, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))

    table.cell(dash, 0, 10, "RSI", text_color=colTL, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 10,
      rsiOB ? "OVERBOUGHT" : rsiOS ? "OVERSOLD" : rsiSlopeUp ? "▲ RISING" : rsiSlopeDown ? "▼ FALLING" : "— NEUTRAL",
      text_color=rsiOB ? BEAR_BRIGHT : rsiOS ? BULL_BRIGHT : rsiSlopeUp ? BULL_DIM : rsiSlopeDown ? BEAR_DIM : colNL,
      text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 10, str.tostring(math.round(rsiRaw)),
      text_color=rsiOB ? BEAR_PRIMARY : rsiOS ? BULL_PRIMARY : colNL,
      text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))

    table.cell(dash, 0, 11, "REL VOLUME", text_color=colTL, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 11,
      relVol > boVolMulti * 1.5 ? "SPIKE" : relVol > boVolMulti ? "HIGH" : relVol > 1.0 ? "NORMAL" : "DRY",
      text_color=relVol > boVolMulti ? BULL_BRIGHT : relVol > 1.0 ? colNL : NEUTRAL_COLOR,
      text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 11, str.tostring(math.round(relVol * 100) / 100, "#.##") + "x",
      text_color=relVol > boVolMulti ? BULL_BRIGHT : colNL,
      text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))

    table.cell(dash, 0, 12, "──────────────────────────────",
      text_color=colDV, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 12, "", bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 12, "", bgcolor=color.new(colDashBg, 0))
    table.merge_cells(dash, 0, 12, 2, 12)

    table.cell(dash, 0, 13, "BULL SCORE", text_color=colTL, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 13, str.tostring(bullCF) + " / 10  •  " + str.tostring(math.round(bullConf)) + "%",
      text_color=bullCF >= minConfluence ? BULL_PRIMARY : colNL,
      text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 13, getGrade(bullConf),
      text_color=getGradeColor(bullConf, true), text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))

    table.cell(dash, 0, 14, "BEAR SCORE", text_color=colTL, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 14, str.tostring(bearCF) + " / 10  •  " + str.tostring(math.round(bearConf)) + "%",
      text_color=bearCF >= minConfluence ? BEAR_PRIMARY : colNL,
      text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 14, getGrade(bearConf),
      text_color=getGradeColor(bearConf, false), text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))

    table.cell(dash, 0, 15, "VERDICT", text_color=colTL, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 15, vrdTxt, text_color=vrdClr, text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 15, "", bgcolor=color.new(colDashBg, 0))
    table.merge_cells(dash, 1, 15, 2, 15)

    // ── Last Signal Section (highlighted) ──────────────────────────────────────
    table.cell(dash, 0, 16, "══════════════════════════════",
      text_color=lastSigDir == 1 ? BULL_DIM : lastSigDir == -1 ? BEAR_DIM : colDV,
      text_size=dTxtSz, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 16, "", bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 16, "", bgcolor=color.new(colDashBg, 0))
    table.merge_cells(dash, 0, 16, 2, 16)

    table.cell(dash, 0, 17, "LAST SIGNAL", text_color=colTL, text_size=dTxtSz,
      bgcolor=color.new(lastSigDir == 1 ? BULL_PRIMARY : lastSigDir == -1 ? BEAR_PRIMARY : colDV, 90))
    table.cell(dash, 1, 17, lastSigTxt, text_color=lastSigClr, text_size=dTxtSz,
      bgcolor=color.new(lastSigDir == 1 ? BULL_PRIMARY : lastSigDir == -1 ? BEAR_PRIMARY : colDV, 90))
    table.cell(dash, 2, 17, lastSigAge, text_color=colNL, text_size=dTxtSz,
      bgcolor=color.new(lastSigDir == 1 ? BULL_PRIMARY : lastSigDir == -1 ? BEAR_PRIMARY : colDV, 90))

    table.cell(dash, 0, 18, "FACTORS", text_color=colTL, text_size=dTxtSz,
      bgcolor=color.new(lastSigDir == 1 ? BULL_PRIMARY : lastSigDir == -1 ? BEAR_PRIMARY : colDV, 93))
    table.cell(dash, 1, 18, lastSigDetTxt, text_color=lastSigClr, text_size=dTxtSz,
      bgcolor=color.new(lastSigDir == 1 ? BULL_PRIMARY : lastSigDir == -1 ? BEAR_PRIMARY : colDV, 93))
    table.cell(dash, 2, 18, "", bgcolor=color.new(lastSigDir == 1 ? BULL_PRIMARY : lastSigDir == -1 ? BEAR_PRIMARY : colDV, 93))
    table.merge_cells(dash, 1, 18, 2, 18)

    table.cell(dash, 0, 19, "ENTRY PRICE", text_color=colTL, text_size=dTxtSz,
      bgcolor=color.new(lastSigDir == 1 ? BULL_PRIMARY : lastSigDir == -1 ? BEAR_PRIMARY : colDV, 93))
    table.cell(dash, 1, 19, not na(lastSigPrice) ? str.tostring(lastSigPrice, format.mintick) : "—",
      text_color=lastSigClr, text_size=dTxtSz,
      bgcolor=color.new(lastSigDir == 1 ? BULL_PRIMARY : lastSigDir == -1 ? BEAR_PRIMARY : colDV, 93))
    table.cell(dash, 2, 19, "", bgcolor=color.new(lastSigDir == 1 ? BULL_PRIMARY : lastSigDir == -1 ? BEAR_PRIMARY : colDV, 93))

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ ALERTS ═══════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

alertcondition(bullSignal, title="Edge Long Signal",
  message="AlphaX Edge: LONG confluence on {{ticker}} {{interval}}")
alertcondition(bearSignal, title="Edge Short Signal",
  message="AlphaX Edge: SHORT confluence on {{ticker}} {{interval}}")
alertcondition(breakoutUp, title="Bullish Breakout",
  message="AlphaX Edge: Bullish breakout on {{ticker}} {{interval}}")
alertcondition(breakoutDown, title="Bearish Breakout",
  message="AlphaX Edge: Bearish breakout on {{ticker}} {{interval}}")
alertcondition(retestBull, title="Bullish Retest",
  message="AlphaX Edge: Bullish retest on {{ticker}} {{interval}}")
alertcondition(retestBear, title="Bearish Retest",
  message="AlphaX Edge: Bearish retest on {{ticker}} {{interval}}")
alertcondition(rsiBullDiv, title="RSI Bull Divergence",
  message="AlphaX Edge: RSI bull divergence on {{ticker}} {{interval}}")
alertcondition(rsiBearDiv, title="RSI Bear Divergence",
  message="AlphaX Edge: RSI bear divergence on {{ticker}} {{interval}}")
