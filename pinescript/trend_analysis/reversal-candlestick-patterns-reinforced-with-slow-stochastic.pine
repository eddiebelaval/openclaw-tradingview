//@version=6
indicator("Candlestick Reversal Patterns + Slow Stoch ", overlay=true)

// --- 1. USER INTERFACE & SETTINGS ---
useEmaFilter = input.bool(true, title="Enable EMA Trend Filter")
emaTimeframe = input.timeframe("D", title="EMA Timeframe (e.g., 'D', '60')")
emaLength    = input.int(200, title="EMA Lookback Length")

kLength    = input.int(10, title="%K Lookback Length")
kSmoothing = input.int(6,  title="%K Smoothing (SMA)")
dSmoothing = input.int(3,  title="%D Smoothing (SMA)")

bullZone   = input.float(25, title="Bullish Zone Extreme (<25%)")
bearZone   = input.float(75, title="Bearish Zone Extreme (>75%)")

// --- 2. WARNING TABLE UI ---
var table warningTable = table.new(position.top_right, columns=1, rows=1, bgcolor=color.new(color.red, 80), border_width=1, border_color=color.red)

warnText = "⚠️ WARNING: USE ONLY AT KEY LEVELS ⚠️\n" +
           "Candlestick patterns require structural confirmation."

if barstate.isfirst
    table.cell(warningTable, column=0, row=0, text=warnText, text_color=color.red, text_size=size.normal)

// --- 3. CORE CALCULATIONS ---
baseEma = ta.ema(close, emaLength)
emaValue = request.security(syminfo.tickerid, emaTimeframe, baseEma)
plot(useEmaFilter ? emaValue : na, color=color.blue, linewidth=2, title="MTF Trend EMA")

rawK  = ta.stoch(close, high, low, kLength)
slowK = ta.sma(rawK, kSmoothing)
slowD = ta.sma(slowK, dSmoothing) 

bodySize   = math.abs(close - open)
candleRng  = high - low
isBullish  = close > open
isBearish  = close < open

lowerWick  = isBullish ? open - low : close - low
upperWick  = isBullish ? high - close : high - open

isDojiBody     = bodySize <= (candleRng * 0.1) 
isSmallBody    = bodySize <= (candleRng * 0.3)
isShavenBottom = lowerWick <= (candleRng * 0.05)
isShavenTop    = upperWick <= (candleRng * 0.05)

// --- 4. PATTERN DEFINITIONS ---
isStandardLine = bodySize > (candleRng * 0.7) and lowerWick < (candleRng * 0.15) and upperWick < (candleRng * 0.15)
isSpinningTop  = isSmallBody and lowerWick > bodySize and upperWick > bodySize

bearEngulfing = isBullish[1] and isBearish and open > close[1] and close < open[1] 
bullEngulfing = isBearish[1] and isBullish and open < close[1] and close > open[1] 

prevMidpoint = isBearish[1] ? close[1] + (bodySize[1] / 2) : close[1] - (bodySize[1] / 2)
darkCloud = isBullish[1] and isBearish and open > close[1] and close <= prevMidpoint and close > open[1]
piercing  = isBearish[1] and isBullish and open < close[1] and close >= prevMidpoint and close < open[1]

gravestoneDoji = isDojiBody and lowerWick <= (candleRng * 0.1) and upperWick > (candleRng * 0.6)
dragonflyDoji  = isDojiBody and upperWick <= (candleRng * 0.1) and lowerWick > (candleRng * 0.6)
longLeggedDoji = isDojiBody and lowerWick > (candleRng * 0.4) and upperWick > (candleRng * 0.4)
bullDojiStar = isBearish[1] and isDojiBody and high < low[1]
bearDojiStar = isBullish[1] and isDojiBody and low > high[1]

isUmbrella    = isSmallBody and lowerWick >= (2 * bodySize) and upperWick <= (bodySize * 0.5)
isInvUmbrella = isSmallBody and upperWick >= (2 * bodySize) and lowerWick <= (bodySize * 0.5)

// Safely split logic for stars
morningStar = isBearish[2] and bodySize[2] > (candleRng[2] * 0.5) and 
              isSmallBody[1] and close[1] < close[2] and 
              isBullish and close > (open[2] + close[2]) / 2

eveningStar = isBullish[2] and bodySize[2] > (candleRng[2] * 0.5) and 
              isSmallBody[1] and close[1] > close[2] and 
              isBearish and close < (open[2] + close[2]) / 2

bullBeltHold = isBullish and isShavenBottom and upperWick > 0
bearBeltHold = isBearish and isShavenTop and lowerWick > 0
marubozu     = isShavenTop and isShavenBottom and bodySize > 0

// --- 5. LOGIC FILTERS & TRIGGERS ---
bullEmaCond = not useEmaFilter or (close > emaValue)
bearEmaCond = not useEmaFilter or (close < emaValue)

bullStochCond = slowK < bullZone
bearStochCond = slowK > bearZone

// Safely split pattern logic
bullPattern = bullEngulfing or piercing or dragonflyDoji or bullDojiStar or 
              isUmbrella or isInvUmbrella or morningStar or 
              bullBeltHold or (marubozu and isBullish)

bearPattern = bearEngulfing or darkCloud or gravestoneDoji or bearDojiStar or 
              isUmbrella or isInvUmbrella or eveningStar or 
              bearBeltHold or (marubozu and isBearish)

bullTrigger = bullEmaCond and bullStochCond and bullPattern
bearTrigger = bearEmaCond and bearStochCond and bearPattern

// --- 6. PLOTTING ---
plotshape(bullTrigger, title="Bullish Setup", location=location.belowbar, color=color.new(color.green, 0), style=shape.triangleup, size=size.small, text="BULL")
plotshape(bearTrigger, title="Bearish Setup", location=location.abovebar, color=color.new(color.red, 0), style=shape.triangledown, size=size.small, text="BEAR")
