//@version=6
indicator("HTF Candle hour", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ───────────────────── INPUTS ─────────────────────
string htf1_tf   = input.timeframe("15",  "HTF 1", inline="1")
string htf2_tf   = input.timeframe("60",  "HTF 2", inline="2")
bool   show1     = input.bool(true, "Hiện HTF 1", inline="1")
bool   show2     = input.bool(true, "Hiện HTF 2", inline="2")
int    offset    = input.int(10, "Khoảng cách từ nến hiện tại", minval=1)
int    width     = input.int(2,  "Độ rộng nến (bar)", minval=2)
int    spacing   = input.int(1,  "Khoảng cách giữa nến", minval=1)
int maxBarsHTF1 = input.int(12, "Số nến HTF 1", minval=1)
int maxBarsHTF2 = input.int(6,  "Số nến HTF 2", minval=1)

string htf3_tf   = input.timeframe("240", "HTF 3", inline="3")
bool   show3     = input.bool(true, "Hiện HTF 3", inline="3")
int    maxBarsHTF3 = input.int(4, "Số nến HTF 3", minval=1)

// Giờ NY trong thân HTF1
bool   showHour  = input.bool(true,  "Hiện giờ NY trong thân HTF1")
bool showHourHTF2 = input.bool(true, "Hiện giờ NY trong thân HTF2")
color  hourColor = input.color(color.white, "Màu chữ giờ")
string hourSize  = input.string(size.normal, "Cỡ chữ", options=[size.tiny, size.small, size.normal, size.large])


// Màu nến
color bullColor  = color.white
color bearColor  = color.black
color wickColor  = color.black

// ───────────────────── CẤU TRÚC DỮ LIỆU ─────────────────────
type CandleData
    float  o
    float  c
    float  h
    float  l
    int    openTime
    box    body
    line   upperWick
    line   lowerWick
    label  hourLabel

var array<CandleData> htf1 = array.new<CandleData>()
var array<CandleData> htf2 = array.new<CandleData>()
var array<CandleData> htf3 = array.new<CandleData>()

// ───────────────────── TẠO NẾN MỚI ─────────────────────
createCandle(string tf, array<CandleData> arr, bool isHTF1, int maxBarsLocal) =>
    if ta.change(time(tf, "America/New_York")) != 0
        CandleData c = CandleData.new()
        c.o := open
        c.c := close
        c.h := high
        c.l := low
        c.openTime := time

        left   = bar_index
        right  = bar_index + width
        top    = math.max(c.o, c.c)
        bot    = math.min(c.o, c.c)
        isBull = c.c >= c.o

        c.body      := box.new(left, top, right, bot, bgcolor = isBull ? bullColor : bearColor, border_color = wickColor)
        c.upperWick := line.new(bar_index + width/2, c.h, bar_index + width/2, top,    color = wickColor)
        c.lowerWick := line.new(bar_index + width/2, bot,  bar_index + width/2, c.l, color = wickColor)
        // Chỉ hiện giờ NY cho HTF1
        bool canShowHour = showHour and (isHTF1 or showHourHTF2)
        if canShowHour
            txt  = str.format_time(c.openTime, "HH", "America/New_York")
            midY = (top + bot) / 2
            c.hourLabel := label.new(
                 bar_index + width/2,
                 midY,
                 txt,
                 color = color(na),
                 textcolor = hourColor,
                 size = hourSize,
                 style = label.style_label_center)

        array.unshift(arr, c)

        // Giữ số lượng tối đa
        if array.size(arr) > maxBarsLocal
            CandleData old = array.pop(arr)
            box.delete(old.body)
            line.delete(old.upperWick)
            line.delete(old.lowerWick)
            if not na(old.hourLabel)
                label.delete(old.hourLabel)

// ───────────────────── CẬP NHẬT + DI CHUYỂN ─────────────────────
updateAndMove(array<CandleData> arr, int startX) =>
    if array.size(arr) > 0
        CandleData cur = array.get(arr, 0)
        cur.h := math.max(high, cur.h)
        cur.l := math.min(low,  cur.l)
        cur.c := close
        isBull = cur.c >= cur.o

        box.set_top(cur.body,    math.max(cur.o, cur.c))
        box.set_bottom(cur.body, math.min(cur.o, cur.c))
        box.set_bgcolor(cur.body, isBull ? bullColor : bearColor)
        line.set_y1(cur.upperWick, cur.h)
        line.set_y2(cur.upperWick, math.max(cur.o, cur.c))
        line.set_y1(cur.lowerWick, math.min(cur.o, cur.c))
        line.set_y2(cur.lowerWick, cur.l)

        // Di chuyển toàn bộ cụm nến
        for i = 0 to array.size(arr) - 1
            CandleData cd = array.get(arr, i)
            shift = startX - i * (width + spacing)
            box.set_left(cd.body,      bar_index + shift)
            box.set_right(cd.body,     bar_index + shift + width)
            line.set_x1(cd.upperWick,  bar_index + shift + width/2)
            line.set_x2(cd.upperWick,  bar_index + shift + width/2)
            line.set_x1(cd.lowerWick,  bar_index + shift + width/2)
            line.set_x2(cd.lowerWick,  bar_index + shift + width/2)
            if not na(cd.hourLabel)
                midY = (math.max(cd.o, cd.c) + math.min(cd.o, cd.c)) / 2
                cd.hourLabel.set_xy(bar_index + shift + width/2, midY)

// ───────────────────── MAIN LOOP ─────────────────────
int pos = offset

if show1
    createCandle(htf1_tf, htf1, true,  maxBarsHTF1)
    updateAndMove(htf1, pos + 30 )
    pos += array.size(htf1) * (width + spacing) + 15

if show2
    createCandle(htf2_tf, htf2, false, maxBarsHTF2)
    updateAndMove(htf2, pos)

sess1 = input.float(00.00, "Session 1", minval=0.0, maxval=23.59)

// Function to check if current time matches session time
is_time_match(session) =>
    hour_match = hour == int(session)
    minute_match = minute == int((session - int(session)) * 100)  // Correct fractional minute calculation
    hour_match and minute_match
var sessions = array.new_float(3)
array.set(sessions, 0, sess1)
var colors = array.new_color(3)
array.set(colors, 0, color.rgb(194, 198, 198))

// Extend the lines from the top to the bottom of the chart
for i = 0 to array.size(sessions) - 1
    if is_time_match(array.get(sessions, i))
        line.new(x1=bar_index, y1=1e10,  x2=bar_index, y2=-1e10, width=1, color=array.get(colors, i), style=line.style_arrow_both)

if show3
    createCandle(htf3_tf, htf3, false, maxBarsHTF3)
    updateAndMove(htf3, pos + 15)
    pos += array.size(htf3) * (width + spacing) + 35
