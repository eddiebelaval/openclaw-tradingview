//@version=5
indicator("LiqLines Pro", overlay=true, max_lines_count=500, max_labels_count=500)

// === COLOR PALETTE ===
color modernGreen = #089981
color modernRed   = #f23645
color alertYellow = #ffeb3b 
color alertText   = color.black

// --- LIQUIDITY LINES SETTINGS ---
grp_man = "🎯 MANUAL ANCHORS (CLICK & DRAG)"
manualBottom = input.price(0, "Manual BOTTOM", confirm=true, group=grp_man)
manualTop    = input.price(0, "Manual TOP", confirm=true, group=grp_man)

grp_label = "🏷️ LABEL SETTINGS"
labelOffset  = input.int(20, "Label Offset", minval=0, group=grp_label)
lblSizeInput = input.string("Small", "Label Size", options=["Small", "Normal", "Large", "Huge"], group=grp_label)

sizeWatcher = lblSizeInput == "Small" ? 1 : lblSizeInput == "Normal" ? 2 : lblSizeInput == "Large" ? 3 : 4
get_size(s) =>
    s == "Small" ? size.small : s == "Normal" ? size.normal : s == "Large" ? size.large : size.huge
selectedSize = get_size(lblSizeInput)

grp_auto = "⚙️ AUTO ENGINE SETTINGS"
lengthInput = input.int(500, "Lookback Period", minval=10, maxval=5000, group=grp_auto)
showBottom  = input.bool(true, "Show Bottom Levels", group=grp_auto)
showTop     = input.bool(true, "Show Top Levels", group=grp_auto)

// === LEVEL SELECTORS ===
grp_sel_bottom = "📈 ENABLE BOTTOM LEVELS"
sB1 = input.bool(true, "1.00%", group=grp_sel_bottom)
sB2 = input.bool(true, "1.33%", group=grp_sel_bottom)
sB3 = input.bool(true, "2.00%", group=grp_sel_bottom)
sB4 = input.bool(true, "3.33%", group=grp_sel_bottom)
sB5 = input.bool(true, "4.00%", group=grp_sel_bottom)
sB6 = input.bool(true, "5.00%", group=grp_sel_bottom)
sB10 = input.bool(true, "10.00%", group=grp_sel_bottom)
sB20 = input.bool(false, "20.00%", group=grp_sel_bottom)
sB33 = input.bool(false, "33.33%", group=grp_sel_bottom)
sB40 = input.bool(false, "40.00%", group=grp_sel_bottom)
sB50 = input.bool(false, "50.00%", group=grp_sel_bottom)
sB125 = input.bool(false, "125.0%", group=grp_sel_bottom)
sB238 = input.bool(false, "238.0%", group=grp_sel_bottom)

grp_sel_top = "📉 ENABLE TOP LEVELS"
sT1 = input.bool(true, "1.00%", group=grp_sel_top)
sT2 = input.bool(true, "1.33%", group=grp_sel_top)
sT3 = input.bool(true, "2.00%", group=grp_sel_top)
sT4 = input.bool(true, "3.33%", group=grp_sel_top)
sT5 = input.bool(true, "4.00%", group=grp_sel_top)
sT6 = input.bool(true, "5.00%", group=grp_sel_top)
sT10 = input.bool(true, "10.00%", group=grp_sel_top)
sT20 = input.bool(false, "20.00%", group=grp_sel_top)
sT33 = input.bool(false, "33.33%", group=grp_sel_top)
sT40 = input.bool(false, "40.00%", group=grp_sel_top)
sT50 = input.bool(false, "50.00%", group=grp_sel_top)
sT75 = input.bool(false, "75.00%", group=grp_sel_top)
sT87 = input.bool(false, "87.50%", group=grp_sel_top)

// === DYNAMIC LIST CREATION ===
var p_bottom_vals = array.new_float(0), var p_bottom_txt  = array.new_string(0)
var p_top_vals    = array.new_float(0), var p_top_txt     = array.new_string(0)

array.clear(p_bottom_vals), array.clear(p_bottom_txt)
array.clear(p_top_vals),    array.clear(p_top_txt)

if sB1 
    array.push(p_bottom_vals, 0.01), array.push(p_bottom_txt, "+1.00%")
if sB2 
    array.push(p_bottom_vals, 0.0133), array.push(p_bottom_txt, "+1.33%")
if sB3 
    array.push(p_bottom_vals, 0.02), array.push(p_bottom_txt, "+2.00%")
if sB4 
    array.push(p_bottom_vals, 0.0333), array.push(p_bottom_txt, "+3.33%")
if sB5 
    array.push(p_bottom_vals, 0.04), array.push(p_bottom_txt, "+4.00%")
if sB6 
    array.push(p_bottom_vals, 0.05), array.push(p_bottom_txt, "+5.00%")
if sB10 
    array.push(p_bottom_vals, 0.10), array.push(p_bottom_txt, "+10.00%")
if sB20 
    array.push(p_bottom_vals, 0.20), array.push(p_bottom_txt, "+20.00%")
if sB33 
    array.push(p_bottom_vals, 0.3333), array.push(p_bottom_txt, "+33.33%")
if sB40 
    array.push(p_bottom_vals, 0.40), array.push(p_bottom_txt, "+40.00%")
if sB50 
    array.push(p_bottom_vals, 0.50), array.push(p_bottom_txt, "+50.00%")
if sB125
    array.push(p_bottom_vals, 1.25), array.push(p_bottom_txt, "+125.0%")
if sB238
    array.push(p_bottom_vals, 2.38), array.push(p_bottom_txt, "+238.0%")

if sT1 
    array.push(p_top_vals, 0.01), array.push(p_top_txt, "-1.00%")
if sT2 
    array.push(p_top_vals, 0.0133), array.push(p_top_txt, "-1.33%")
if sT3 
    array.push(p_top_vals, 0.02), array.push(p_top_txt, "-2.00%")
if sT4 
    array.push(p_top_vals, 0.0333), array.push(p_top_txt, "-3.33%")
if sT5 
    array.push(p_top_vals, 0.04), array.push(p_top_txt, "-4.00%")
if sT6 
    array.push(p_top_vals, 0.05), array.push(p_top_txt, "-5.00%")
if sT10 
    array.push(p_top_vals, 0.10), array.push(p_top_txt, "-10.00%")
if sT20 
    array.push(p_top_vals, 0.20), array.push(p_top_txt, "-20.00%")
if sT33 
    array.push(p_top_vals, 0.3333), array.push(p_top_txt, "-33.33%")
if sT40 
    array.push(p_top_vals, 0.40), array.push(p_top_txt, "-40.00%")
if sT50 
    array.push(p_top_vals, 0.50), array.push(p_top_txt, "-50.00%")
if sT75 
    array.push(p_top_vals, 0.75), array.push(p_top_txt, "-75.00%")
if sT87 
    array.push(p_top_vals, 0.875), array.push(p_top_txt, "-87.50%")

// === CALCULATIONS AND STORAGE ===
// Parity Change Detection (Safe Zone)
safeMax = ta.highest(high, 1000) * 3.0
safeMin = ta.lowest(low, 1000) / 3.0

bool isManualBottom = not na(manualBottom) and (manualBottom != 0) and (manualBottom < safeMax) and (manualBottom > safeMin)
bool isManualTop    = not na(manualTop) and (manualTop != 0) and (manualTop < safeMax) and (manualTop > safeMin)

float activeBottom = isManualBottom ? manualBottom : ta.lowest(low, lengthInput)
float activeTop    = isManualTop ? manualTop : ta.highest(high, lengthInput)

var line bottomRefLine = na, var line topRefLine = na
var line[] bottomLines = array.new_line(0), var line[] topLines = array.new_line(0)
var label[] allLabels = array.new_label(0)

clearElements(l_array, lbl_array) =>
    if array.size(l_array) > 0
        for i = 0 to array.size(l_array) - 1
            line.delete(array.get(l_array, i))
        array.clear(l_array)
    if array.size(lbl_array) > 0
        for i = 0 to array.size(lbl_array) - 1
            label.delete(array.get(lbl_array, i))
        array.clear(lbl_array)

// Proximity Alert Function
is_near(price, level, direction) =>
    threshold = level * 0.001
    dist = math.abs(price - level)
    if direction > 0 // TOP
        dist <= threshold and price >= level
    else if direction < 0 // BOTTOM
        dist <= threshold and price <= level
    else
        false

// === DRAWING LOOP ===
updateBottom = ta.change(activeBottom) or ta.change(sizeWatcher) or barstate.islast
updateTop    = ta.change(activeTop) or ta.change(sizeWatcher) or barstate.islast

if showBottom and updateBottom
    line.delete(bottomRefLine)
    clearElements(bottomLines, allLabels)
    int targetX = bar_index + labelOffset
    color dCol = is_near(close, activeBottom, -1) ? alertYellow : modernGreen
    color dTCol = is_near(close, activeBottom, -1) ? alertText : color.white
    bottomRefLine := line.new(bar_index - 1, activeBottom, bar_index, activeBottom, extend=extend.both, color=dCol, width=1)
    array.push(allLabels, label.new(targetX, activeBottom, "BOTTOM: " + str.tostring(activeBottom, format.mintick), color=dCol, textcolor=dTCol, style=label.style_label_left, size=selectedSize))
    if array.size(p_bottom_vals) > 0
        for i = 0 to array.size(p_bottom_vals) - 1
            float val = activeBottom * (1 + array.get(p_bottom_vals, i))
            color c = is_near(close, val, -1) ? alertYellow : modernGreen
            color tc = is_near(close, val, -1) ? alertText : color.white
            array.push(bottomLines, line.new(bar_index, val, bar_index + 1, val, extend=extend.right, color=color.new(c, 50), style=line.style_dashed, width=1))
            array.push(allLabels, label.new(targetX, val, array.get(p_bottom_txt, i) + " - " + str.tostring(val, format.mintick), color=color.new(c, 30), textcolor=tc, style=label.style_label_left, size=selectedSize))

if showTop and updateTop
    line.delete(topRefLine)
    if array.size(topLines) > 0
        for i = 0 to array.size(topLines) - 1
            line.delete(array.get(topLines, i))
        array.clear(topLines)
    int targetX = bar_index + labelOffset
    color tCol = is_near(close, activeTop, 1) ? alertYellow : modernRed
    color tTCol = is_near(close, activeTop, 1) ? alertText : color.white
    topRefLine := line.new(bar_index - 1, activeTop, bar_index, activeTop, extend=extend.both, color=tCol, width=1)
    array.push(allLabels, label.new(targetX, activeTop, "TOP: " + str.tostring(activeTop, format.mintick), color=tCol, textcolor=tTCol, style=label.style_label_left, size=selectedSize))
    if array.size(p_top_vals) > 0
        for i = 0 to array.size(p_top_vals) - 1
            float val = activeTop * (1 - array.get(p_top_vals, i))
            color c = is_near(close, val, 1) ? alertYellow : modernRed
            color tc = is_near(close, val, 1) ? alertText : color.white
            array.push(topLines, line.new(bar_index, val, bar_index + 1, val, extend=extend.right, color=color.new(c, 50), style=line.style_dashed, width=1))
            array.push(allLabels, label.new(targetX, val, array.get(p_top_txt, i) + " - " + str.tostring(val, format.mintick), color=color.new(c, 30), textcolor=tc, style=label.style_label_left, size=selectedSize))
