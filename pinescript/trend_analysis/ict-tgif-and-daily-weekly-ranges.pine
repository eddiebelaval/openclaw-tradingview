//@version=6
// ══════════════════════════════════════════════════════════════════════════════
//
// ICT T.G.I.F. and Daily & Weekly Ranges
// Version: 20/03/2026
//
// ──────────────────────────────────────────────────────────────────────────────
//
// DESCRIPTION:
// This indicator visualises weekly and daily price ranges to assist with
// ICT T.G.I.F. (TGIF — Thank God It's Friday) trade setups. The concept suggests
// that Friday's price action tends to retrace into the established weekly
// range. This makes the weekly high-low boundaries and retracement levels
// useful reference points for end-of-week analysis.
//
// FEATURES:
//   • Full weekly range box (Mon-Fri, excluding Sunday session)
//   • Color-coded daily range boxes (Mon-Fri) with per-day colors
//   • Configurable retracement lines at both ends of the weekly range
//   • Optional daily high/low dot markers with NY session timestamps
//   • Optional daily high/low extension lines across the current week
//   • Configurable line transparency for borders and extension lines
//   • Past boxes span their actual trading dates only
//   • Configurable number of weeks to display
//
// TECHNICAL NOTES:
//   • All price data uses 1-minute bars via request.security_lower_tf()
//     for accurate high/low detection across any chart timeframe
//   • Sunday session bars are excluded from all range calculations
//   • Finalised boxes are created once with fixed dimensions and are
//     never modified, ensuring correct behaviour when the price axis
//     is adjusted. Only the current week/day uses live drawings.
//
// ──────────────────────────────────────────────────────────────────────────────
//
// AUTHOR: Timo Haapsaari (@hqtimppa)
//
// ══════════════════════════════════════════════════════════════════════════════

indicator("ICT T.G.I.F. and Daily & Weekly Ranges", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ══════════════════════════════════════════════════════════════════════════════

string TZ = "America/New_York"

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS - Display Settings
// Master toggles and general behaviour
// ══════════════════════════════════════════════════════════════════════════════

grpDisplay = "Display Settings"

showWeeklyBox   = input.bool(true, "Show Weekly Range",
     group=grpDisplay,
     tooltip="Display a box covering the full weekly high-low range (Monday through Friday).")

showDailyBoxes  = input.bool(true, "Show Daily Range Boxes",
     group=grpDisplay,
     tooltip="Display color-coded boxes for each trading day (Monday through Friday).")

showRetracement = input.bool(true, "Show Retracement Lines",
     group=grpDisplay,
     tooltip="Display percentage retracement lines at both ends of the weekly range. For example, 20%/30% creates lines at the 20%, 30%, 70%, and 80% levels.")

extendBars      = input.int(3, "Extend Beyond Current (bars)",
     minval=0, maxval=50,
     group=grpDisplay,
     tooltip="Bars to extend current week/day boxes beyond the latest bar. Past boxes are not extended.")

weeksToShow     = input.int(1, "Weeks to Show",
     minval=1, maxval=10,
     group=grpDisplay,
     tooltip="Number of recent weeks to keep on the chart. Older weeks and their daily boxes are removed.")

showBorder      = input.bool(true, "Show Weekly Border",
     group=grpDisplay,
     tooltip="Display a border around the weekly range box.")

showDailyBorder = input.bool(true, "Show Daily Border",
     group=grpDisplay,
     tooltip="Display a border around daily range boxes.")

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS - Weekly Range Appearance
// ══════════════════════════════════════════════════════════════════════════════

grpWeekly = "Weekly Range Colors"

weeklyFillColor = input.color(color.new(#9E9E9E, 92), "Fill Color",
     group=grpWeekly,
     tooltip="Background fill color for the weekly range box. Border color is derived from this.")

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS - Retracement Lines
// Percentage levels and styling for retracement markers
// ══════════════════════════════════════════════════════════════════════════════

grpRetrace = "Retracement Lines"

retracePct1       = input.float(20.0, "Level 1 (%)",
     minval=1, maxval=50, step=5,
     group=grpRetrace,
     tooltip="First retracement level from both ends of the weekly range.")

retracePct2       = input.float(30.0, "Level 2 (%)",
     minval=1, maxval=50, step=5,
     group=grpRetrace,
     tooltip="Second retracement level from both ends of the weekly range.")

showRetraceLabels = input.bool(true, "Show Labels",
     group=grpRetrace,
     tooltip="Display percentage text labels next to retracement lines.")

labelSizeStr      = input.string("Small", "Label Size",
     options=["Small", "Medium", "Large"],
     group=grpRetrace,
     tooltip="Text size for retracement percentage labels.")

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS - Daily Range Colors
// Per-day fill colors and daily feature options
// ══════════════════════════════════════════════════════════════════════════════

grpDaily = "Daily Range Colors"

monFillColor = input.color(color.new(#2E7D32, 80), "Monday",
     group=grpDaily, tooltip="Monday fill color.")
tueFillColor = input.color(color.new(#81C784, 85), "Tuesday",
     group=grpDaily, tooltip="Tuesday fill color.")
wedFillColor = input.color(color.new(#FF9800, 85), "Wednesday",
     group=grpDaily, tooltip="Wednesday fill color.")
thuFillColor = input.color(color.new(#EF9A9A, 82), "Thursday",
     group=grpDaily, tooltip="Thursday fill color.")
friFillColor = input.color(color.new(#C62828, 80), "Friday",
     group=grpDaily, tooltip="Friday fill color. Also used as the base color for retracement lines.")

showDailyLevels = input.bool(false, "Extend Daily Highs/Lows",
     group=grpDaily,
     tooltip="Extend current week's daily highs and lows as dashed lines to the current bar.")

lineTransp = input.int(20, "Line Transparency",
     minval=0, maxval=100,
     group=grpDaily,
     tooltip="Transparency for lines and borders. 0 = opaque, 100 = invisible.")

showDailyDots = input.bool(true, "Show Daily High/Low Dots",
     group=grpDaily,
     tooltip="Display dot markers at each day's high and low.")

dotSizeStr = input.string("Medium", "Dot Size",
     options=["Small", "Medium", "Large"],
     group=grpDaily,
     tooltip="Size of daily high/low dot markers.")

showDailyTimes = input.bool(true, "Show High/Low Times",
     group=grpDaily,
     tooltip="Display NY time (HH:MM) of each day's high and low.")

showDayLabels = input.bool(true, "Show Day Labels",
     group=grpDaily,
     tooltip="Display day name (Mon-Fri) in the center of each daily range box.")

// ══════════════════════════════════════════════════════════════════════════════
// SIZE CONVERSIONS
// ══════════════════════════════════════════════════════════════════════════════

labelSize = switch labelSizeStr
    "Small"  => size.small
    "Medium" => size.normal
    "Large"  => size.large

dotSize = switch dotSizeStr
    "Small"  => size.tiny
    "Medium" => size.small
    "Large"  => size.normal

// ══════════════════════════════════════════════════════════════════════════════
// CUSTOM TYPE - Range Record
// Stores all visual elements and metadata for each weekly or daily range.
// Weekly records use the retracement fields; daily records use the dot/time
// fields. Unused fields are set to na.
// ══════════════════════════════════════════════════════════════════════════════

type RangeRecord
    box    rangeBox        // Main range box
    line   lineBot1        // Bottom retracement line 1
    line   lineBot2        // Bottom retracement line 2
    line   lineTop1        // Top retracement line 1
    line   lineTop2        // Top retracement line 2
    box    lblBot1         // Label for bottom line 1
    box    lblBot2         // Label for bottom line 2
    box    lblTop1         // Label for top line 1
    box    lblTop2         // Label for top line 2
    label  highDot         // Dot marker at day high
    label  lowDot          // Dot marker at day low
    label  highTimeLabel   // Time label above day high
    label  lowTimeLabel    // Time label below day low
    int    weekId          // Week identifier (year * 100 + weekofyear)
    int    sessionType     // 0=weekly, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri
    int    leftBarIndex    // Starting bar index
    float  top             // Upper price boundary (fixed at creation)
    float  bottom          // Lower price boundary (fixed at creation)
    int    createdTime     // Creation timestamp

// ══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ══════════════════════════════════════════════════════════════════════════════

// Returns a unique week identifier in the form YYYYWW
getWeekId() =>
    year(time, TZ) * 100 + weekofyear(time, TZ)

// Maps day-of-week constant to user-configured fill color
getDayColor(int dow) =>
    switch dow
        dayofweek.monday    => monFillColor
        dayofweek.tuesday   => tueFillColor
        dayofweek.wednesday => wedFillColor
        dayofweek.thursday  => thuFillColor
        dayofweek.friday    => friFillColor
        => color.new(#9E9E9E, 90)

// Maps session type integer (1-5) to fill color
getSessionColor(int st) =>
    switch st
        1 => monFillColor
        2 => tueFillColor
        3 => wedFillColor
        4 => thuFillColor
        5 => friFillColor
        => color.new(#9E9E9E, 90)

// Maps day-of-week to session type integer
getDaySession(int dow) =>
    switch dow
        dayofweek.monday    => 1
        dayofweek.tuesday   => 2
        dayofweek.wednesday => 3
        dayofweek.thursday  => 4
        dayofweek.friday    => 5
        => 1

// Returns color at line transparency
lineColor(color base) =>
    color.new(base, lineTransp)

// Returns color at full opacity (for dots and time labels)
solidColor(color base) =>
    color.new(base, 0)

// Formats a timestamp as HH:MM in NY timezone
formatTime(int ts) =>
    str.tostring(hour(ts, TZ), "00") + ":" + str.tostring(minute(ts, TZ), "00")

// Returns abbreviated day name for box labels
getDayName(int dow) =>
    switch dow
        dayofweek.monday    => "Mon"
        dayofweek.tuesday   => "Tue"
        dayofweek.wednesday => "Wed"
        dayofweek.thursday  => "Thu"
        dayofweek.friday    => "Fri"
        => ""

// ══════════════════════════════════════════════════════════════════════════════
// STATE VARIABLES
// Persistent variables for tracking current week/day and storing records.
// Weekly records are drawn first (appear behind daily records).
// ══════════════════════════════════════════════════════════════════════════════

var array<RangeRecord> weekRecords = array.new<RangeRecord>()
var array<RangeRecord> dayRecords  = array.new<RangeRecord>()

// Current week tracking
var bool  wk_found     = false
var float wk_high      = na
var float wk_low       = na
var int   wk_left_bar  = na
var int   wk_right_bar = na
var int   wk_id        = na

// Current day tracking
var bool  dy_found     = false
var float dy_high      = na
var float dy_low       = na
var int   dy_left_bar  = na
var int   dy_right_bar = na
var int   dy_high_bar  = na
var int   dy_low_bar   = na
var int   dy_high_time = na
var int   dy_low_time  = na
var int   dy_weekId    = na
var int   dy_dow       = na

// Live drawing arrays (deleted and recreated on barstate.islast)
var array<box>   liveBoxes  = array.new<box>()
var array<line>  liveLines  = array.new<line>()
var array<box>   liveLabels = array.new<box>()
var array<label> liveDots   = array.new<label>()

// ══════════════════════════════════════════════════════════════════════════════
// DISPLAY CONSTANTS
// ══════════════════════════════════════════════════════════════════════════════

int   LBL_OFFSET  = 2                     // Bars between box edge and labels
float DOT_OFFSET  = syminfo.mintick * 20  // Price offset for dot and label spacing

// ══════════════════════════════════════════════════════════════════════════════
// CALCULATED COLORS
// ══════════════════════════════════════════════════════════════════════════════

color weekBorderClr = showBorder ? lineColor(weeklyFillColor) : color.new(weeklyFillColor, 100)
color retraceClr    = lineColor(friFillColor)

// ══════════════════════════════════════════════════════════════════════════════
// FETCH 1-MINUTE DATA
// Intrabar data for accurate high/low detection on higher timeframes.
// These calls also bind the indicator to the chart's price scale.
// ══════════════════════════════════════════════════════════════════════════════

high_arr  = request.security_lower_tf(syminfo.tickerid, "1", high)
low_arr   = request.security_lower_tf(syminfo.tickerid, "1", low)
close_arr = request.security_lower_tf(syminfo.tickerid, "1", close)
open_arr  = request.security_lower_tf(syminfo.tickerid, "1", open)
time_arr  = request.security_lower_tf(syminfo.tickerid, "1", time)

int arr_size = array.size(high_arr)

// ══════════════════════════════════════════════════════════════════════════════
// PER-BAR CALCULATIONS
// ══════════════════════════════════════════════════════════════════════════════

int  dow       = dayofweek(time, TZ)
int  curWkId   = getWeekId()
bool isNewWeek = ta.change(weekofyear(time, TZ)) != 0
bool isNewDay  = ta.change(dayofmonth(time, TZ)) != 0

// ══════════════════════════════════════════════════════════════════════════════
// FINALISE PREVIOUS WEEK ON NEW WEEK
// Creates fixed drawing objects for the completed week. After creation,
// these objects are never modified (no set_top/set_bottom calls).
// ══════════════════════════════════════════════════════════════════════════════

if isNewWeek and wk_found
    int   right_bar = wk_right_bar
    float wkRange   = wk_high - wk_low

    // Duplicate check
    bool exists = false
    for rec in weekRecords
        if rec.weekId == wk_id and rec.sessionType == 0
            exists := true
            break

    if not exists and showWeeklyBox and wkRange > 0
        // Retracement levels at both ends
        float bLvl1 = wk_low  + (retracePct1 / 100.0) * wkRange
        float bLvl2 = wk_low  + (retracePct2 / 100.0) * wkRange
        float tLvl1 = wk_high - (retracePct1 / 100.0) * wkRange
        float tLvl2 = wk_high - (retracePct2 / 100.0) * wkRange

        newBox = box.new(left=wk_left_bar, top=wk_high, right=right_bar, bottom=wk_low,
             xloc=xloc.bar_index, bgcolor=weeklyFillColor, border_color=weekBorderClr)

        nLB1 = line(na),  nLB2 = line(na),  nLT1 = line(na),  nLT2 = line(na)
        nBxB1 = box(na),  nBxB2 = box(na),  nBxT1 = box(na),  nBxT2 = box(na)

        if showRetracement
            nLB1 := line.new(wk_left_bar, bLvl1, right_bar, bLvl1, xloc=xloc.bar_index, color=retraceClr, style=line.style_dashed, width=1)
            nLB2 := line.new(wk_left_bar, bLvl2, right_bar, bLvl2, xloc=xloc.bar_index, color=retraceClr, style=line.style_dashed, width=1)
            nLT1 := line.new(wk_left_bar, tLvl1, right_bar, tLvl1, xloc=xloc.bar_index, color=retraceClr, style=line.style_dashed, width=1)
            nLT2 := line.new(wk_left_bar, tLvl2, right_bar, tLvl2, xloc=xloc.bar_index, color=retraceClr, style=line.style_dashed, width=1)

            if showRetraceLabels
                string pct1Str = str.tostring(retracePct1, "#") + "%"
                string pct2Str = str.tostring(retracePct2, "#") + "%"
                nBxB1 := box.new(right_bar + LBL_OFFSET, bLvl1 + DOT_OFFSET, right_bar + LBL_OFFSET + 20, bLvl1 - DOT_OFFSET,
                     xloc=xloc.bar_index, bgcolor=color.new(color.white, 100), border_color=color.new(color.white, 100),
                     text=pct1Str, text_color=retraceClr, text_halign=text.align_left, text_valign=text.align_center, text_size=labelSize)
                nBxB2 := box.new(right_bar + LBL_OFFSET, bLvl2 + DOT_OFFSET, right_bar + LBL_OFFSET + 20, bLvl2 - DOT_OFFSET,
                     xloc=xloc.bar_index, bgcolor=color.new(color.white, 100), border_color=color.new(color.white, 100),
                     text=pct2Str, text_color=retraceClr, text_halign=text.align_left, text_valign=text.align_center, text_size=labelSize)
                nBxT1 := box.new(right_bar + LBL_OFFSET, tLvl1 + DOT_OFFSET, right_bar + LBL_OFFSET + 20, tLvl1 - DOT_OFFSET,
                     xloc=xloc.bar_index, bgcolor=color.new(color.white, 100), border_color=color.new(color.white, 100),
                     text=pct1Str, text_color=retraceClr, text_halign=text.align_left, text_valign=text.align_center, text_size=labelSize)
                nBxT2 := box.new(right_bar + LBL_OFFSET, tLvl2 + DOT_OFFSET, right_bar + LBL_OFFSET + 20, tLvl2 - DOT_OFFSET,
                     xloc=xloc.bar_index, bgcolor=color.new(color.white, 100), border_color=color.new(color.white, 100),
                     text=pct2Str, text_color=retraceClr, text_halign=text.align_left, text_valign=text.align_center, text_size=labelSize)

        array.push(weekRecords, RangeRecord.new(newBox, nLB1, nLB2, nLT1, nLT2, nBxB1, nBxB2, nBxT1, nBxT2,
             label(na), label(na), label(na), label(na), wk_id, 0, wk_left_bar, wk_high, wk_low, time))

// ══════════════════════════════════════════════════════════════════════════════
// FINALISE PREVIOUS DAY ON NEW DAY
// Creates fixed drawing objects for the completed day.
// ══════════════════════════════════════════════════════════════════════════════

if isNewDay and dy_found and showDailyBoxes
    int right_bar = dy_right_bar

    // Duplicate check
    bool exists = false
    for rec in dayRecords
        if rec.weekId == dy_weekId and rec.sessionType == getDaySession(dy_dow) and rec.leftBarIndex == dy_left_bar
            exists := true
            break

    if not exists
        color  dayClr   = getDayColor(dy_dow)
        color  borderC  = showDailyBorder ? lineColor(dayClr) : color.new(dayClr, 100)
        color  dotClr   = solidColor(dayClr)
        int    hBar     = not na(dy_high_bar) ? dy_high_bar : dy_left_bar
        int    lBar     = not na(dy_low_bar)  ? dy_low_bar  : dy_left_bar

        newDayBox = box.new(dy_left_bar, dy_high, right_bar, dy_low,
             xloc=xloc.bar_index, bgcolor=dayClr, border_color=borderC,
             text=showDayLabels ? getDayName(dy_dow) : "", text_color=dotClr,
             text_halign=text.align_center, text_valign=text.align_center, text_size=size.small)

        nHDot = label(na),  nLDot = label(na),  nHTm = label(na),  nLTm = label(na)

        if showDailyDots
            nHDot := label.new(hBar, dy_high + DOT_OFFSET, xloc=xloc.bar_index,
                 style=label.style_none, color=color.new(color.white, 100), size=dotSize, text="●", textcolor=dotClr)
            nLDot := label.new(lBar, dy_low - DOT_OFFSET, xloc=xloc.bar_index,
                 style=label.style_none, color=color.new(color.white, 100), size=dotSize, text="●", textcolor=dotClr)

        if showDailyTimes
            string hTxt = not na(dy_high_time) ? formatTime(dy_high_time) : ""
            string lTxt = not na(dy_low_time)  ? formatTime(dy_low_time)  : ""
            nHTm := label.new(hBar, dy_high, xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_down, color=color.new(color.white, 100), text=hTxt, textcolor=dotClr, size=size.small)
            nLTm := label.new(lBar, dy_low, xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_up, color=color.new(color.white, 100), text=lTxt, textcolor=dotClr, size=size.small)

        array.push(dayRecords, RangeRecord.new(newDayBox, line(na), line(na), line(na), line(na),
             box(na), box(na), box(na), box(na),
             nHDot, nLDot, nHTm, nLTm, dy_weekId, getDaySession(dy_dow), dy_left_bar, dy_high, dy_low, time))

// ══════════════════════════════════════════════════════════════════════════════
// RESET WEEK STATE
// ══════════════════════════════════════════════════════════════════════════════

if isNewWeek
    wk_found     := false
    wk_high      := na
    wk_low       := na
    wk_left_bar  := na
    wk_right_bar := na
    wk_id        := na

// ══════════════════════════════════════════════════════════════════════════════
// RESET DAY STATE
// ══════════════════════════════════════════════════════════════════════════════

if isNewDay
    dy_found     := false
    dy_high      := na
    dy_low       := na
    dy_left_bar  := na
    dy_right_bar := na
    dy_high_bar  := na
    dy_low_bar   := na
    dy_high_time := na
    dy_low_time  := na
    dy_weekId    := na
    dy_dow       := na

// ══════════════════════════════════════════════════════════════════════════════
// ACCUMULATE 1-MINUTE DATA
// Updates running high/low and tracks bar index and timestamp of each
// day's high and low. Sunday and Saturday bars are excluded.
// ══════════════════════════════════════════════════════════════════════════════

bool isTradingDay = dow != dayofweek.sunday and dow != dayofweek.saturday

if isTradingDay and arr_size > 0
    for i = 0 to arr_size - 1
        float h = array.get(high_arr, i)
        float l = array.get(low_arr, i)

        // Week
        if na(wk_high)
            wk_high      := h
            wk_low       := l
            wk_left_bar  := bar_index
            wk_right_bar := bar_index
            wk_id        := curWkId
            wk_found     := true
        else
            wk_high      := math.max(wk_high, h)
            wk_low       := math.min(wk_low, l)
            wk_right_bar := bar_index
            if not wk_found
                wk_found := true

        // Day
        if na(dy_high)
            dy_high      := h
            dy_low       := l
            dy_left_bar  := bar_index
            dy_right_bar := bar_index
            dy_high_bar  := bar_index
            dy_low_bar   := bar_index
            dy_high_time := array.get(time_arr, i)
            dy_low_time  := array.get(time_arr, i)
            dy_weekId    := curWkId
            dy_dow       := dow
            dy_found     := true
        else
            if h > dy_high
                dy_high      := h
                dy_high_bar  := bar_index
                dy_high_time := array.get(time_arr, i)
            if l < dy_low
                dy_low      := l
                dy_low_bar  := bar_index
                dy_low_time := array.get(time_arr, i)
            dy_right_bar := bar_index
            if not dy_found
                dy_found := true

// ══════════════════════════════════════════════════════════════════════════════
// LIVE DRAWINGS - Current unfinished week and day
// Deleted and recreated on each barstate.islast tick. This is the only
// section that uses delete/recreate; all finalised records above are
// created once and never modified.
// ══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    // Clear previous tick's drawings
    for b in liveBoxes
        box.delete(b)
    array.clear(liveBoxes)
    for ln in liveLines
        line.delete(ln)
    array.clear(liveLines)
    for lb in liveLabels
        box.delete(lb)
    array.clear(liveLabels)
    for dt in liveDots
        label.delete(dt)
    array.clear(liveDots)

    int rightBar = bar_index + extendBars

    // ── Weekly range box and retracement lines ───────────────────────────
    if showWeeklyBox and wk_found and not na(wk_high)
        array.push(liveBoxes, box.new(wk_left_bar, wk_high, rightBar, wk_low,
             xloc=xloc.bar_index, bgcolor=weeklyFillColor, border_color=weekBorderClr))

        if showRetracement
            float wkRange = wk_high - wk_low
            if wkRange > 0
                float bLvl1 = wk_low  + (retracePct1 / 100.0) * wkRange
                float bLvl2 = wk_low  + (retracePct2 / 100.0) * wkRange
                float tLvl1 = wk_high - (retracePct1 / 100.0) * wkRange
                float tLvl2 = wk_high - (retracePct2 / 100.0) * wkRange

                array.push(liveLines, line.new(wk_left_bar, bLvl1, rightBar, bLvl1, xloc=xloc.bar_index, color=retraceClr, style=line.style_dashed, width=1))
                array.push(liveLines, line.new(wk_left_bar, bLvl2, rightBar, bLvl2, xloc=xloc.bar_index, color=retraceClr, style=line.style_dashed, width=1))
                array.push(liveLines, line.new(wk_left_bar, tLvl1, rightBar, tLvl1, xloc=xloc.bar_index, color=retraceClr, style=line.style_dashed, width=1))
                array.push(liveLines, line.new(wk_left_bar, tLvl2, rightBar, tLvl2, xloc=xloc.bar_index, color=retraceClr, style=line.style_dashed, width=1))

                if showRetraceLabels
                    string p1 = str.tostring(retracePct1, "#") + "%"
                    string p2 = str.tostring(retracePct2, "#") + "%"
                    array.push(liveLabels, box.new(rightBar + LBL_OFFSET, bLvl1 + DOT_OFFSET, rightBar + LBL_OFFSET + 20, bLvl1 - DOT_OFFSET,
                         xloc=xloc.bar_index, bgcolor=color.new(color.white, 100), border_color=color.new(color.white, 100),
                         text=p1, text_color=retraceClr, text_halign=text.align_left, text_valign=text.align_center, text_size=labelSize))
                    array.push(liveLabels, box.new(rightBar + LBL_OFFSET, bLvl2 + DOT_OFFSET, rightBar + LBL_OFFSET + 20, bLvl2 - DOT_OFFSET,
                         xloc=xloc.bar_index, bgcolor=color.new(color.white, 100), border_color=color.new(color.white, 100),
                         text=p2, text_color=retraceClr, text_halign=text.align_left, text_valign=text.align_center, text_size=labelSize))
                    array.push(liveLabels, box.new(rightBar + LBL_OFFSET, tLvl1 + DOT_OFFSET, rightBar + LBL_OFFSET + 20, tLvl1 - DOT_OFFSET,
                         xloc=xloc.bar_index, bgcolor=color.new(color.white, 100), border_color=color.new(color.white, 100),
                         text=p1, text_color=retraceClr, text_halign=text.align_left, text_valign=text.align_center, text_size=labelSize))
                    array.push(liveLabels, box.new(rightBar + LBL_OFFSET, tLvl2 + DOT_OFFSET, rightBar + LBL_OFFSET + 20, tLvl2 - DOT_OFFSET,
                         xloc=xloc.bar_index, bgcolor=color.new(color.white, 100), border_color=color.new(color.white, 100),
                         text=p2, text_color=retraceClr, text_halign=text.align_left, text_valign=text.align_center, text_size=labelSize))

    // ── Daily range box ──────────────────────────────────────────────────
    if showDailyBoxes and dy_found and not na(dy_high)
        color dayClr  = getDayColor(dy_dow)
        color borderC = showDailyBorder ? lineColor(dayClr) : color.new(dayClr, 100)
        array.push(liveBoxes, box.new(dy_left_bar, dy_high, rightBar, dy_low,
             xloc=xloc.bar_index, bgcolor=dayClr, border_color=borderC,
             text=showDayLabels ? getDayName(dy_dow) : "", text_color=solidColor(dayClr),
             text_halign=text.align_center, text_valign=text.align_center, text_size=size.small))

    // ── Daily high/low extension lines (current week) ────────────────────
    if showDailyLevels
        if array.size(dayRecords) > 0
            for rec in dayRecords
                if rec.weekId == curWkId
                    color c = lineColor(getSessionColor(rec.sessionType))
                    array.push(liveLines, line.new(rec.leftBarIndex, rec.top, rightBar, rec.top, xloc=xloc.bar_index, color=c, style=line.style_dashed, width=1))
                    array.push(liveLines, line.new(rec.leftBarIndex, rec.bottom, rightBar, rec.bottom, xloc=xloc.bar_index, color=c, style=line.style_dashed, width=1))
        if dy_found and not na(dy_high)
            color c = lineColor(getDayColor(dy_dow))
            array.push(liveLines, line.new(dy_left_bar, dy_high, rightBar, dy_high, xloc=xloc.bar_index, color=c, style=line.style_dashed, width=1))
            array.push(liveLines, line.new(dy_left_bar, dy_low, rightBar, dy_low, xloc=xloc.bar_index, color=c, style=line.style_dashed, width=1))

    // ── Daily dots and time labels ───────────────────────────────────────
    if dy_found and not na(dy_high)
        color  dotClr = solidColor(getDayColor(dy_dow))
        int    hBar   = not na(dy_high_bar) ? dy_high_bar : dy_left_bar
        int    lBar   = not na(dy_low_bar)  ? dy_low_bar  : dy_left_bar

        if showDailyDots
            array.push(liveDots, label.new(hBar, dy_high + DOT_OFFSET, xloc=xloc.bar_index,
                 style=label.style_none, color=color.new(color.white, 100), size=dotSize, text="●", textcolor=dotClr))
            array.push(liveDots, label.new(lBar, dy_low - DOT_OFFSET, xloc=xloc.bar_index,
                 style=label.style_none, color=color.new(color.white, 100), size=dotSize, text="●", textcolor=dotClr))

        if showDailyTimes
            string hTxt = not na(dy_high_time) ? formatTime(dy_high_time) : ""
            string lTxt = not na(dy_low_time)  ? formatTime(dy_low_time)  : ""
            array.push(liveDots, label.new(hBar, dy_high, xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_down, color=color.new(color.white, 100), text=hTxt, textcolor=dotClr, size=size.small))
            array.push(liveDots, label.new(lBar, dy_low, xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_up, color=color.new(color.white, 100), text=lTxt, textcolor=dotClr, size=size.small))

// ══════════════════════════════════════════════════════════════════════════════
// CLEANUP
// Remove week records beyond the display limit along with child day records.
// ══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    // Collect weekIds to keep
    array<int> keepIds = array.new<int>()
    array.push(keepIds, curWkId)
    int archiveKeep = math.max(0, weeksToShow - 1)
    if array.size(weekRecords) > 0
        int keepCount = math.min(array.size(weekRecords), archiveKeep)
        if keepCount > 0
            for i = array.size(weekRecords) - 1 to array.size(weekRecords) - keepCount
                array.push(keepIds, array.get(weekRecords, i).weekId)

    // Remove excess week records
    while array.size(weekRecords) > archiveKeep
        RangeRecord old = array.get(weekRecords, 0)
        box.delete(old.rangeBox)
        line.delete(old.lineBot1)
        line.delete(old.lineBot2)
        line.delete(old.lineTop1)
        line.delete(old.lineTop2)
        box.delete(old.lblBot1)
        box.delete(old.lblBot2)
        box.delete(old.lblTop1)
        box.delete(old.lblTop2)
        label.delete(old.highDot)
        label.delete(old.lowDot)
        label.delete(old.highTimeLabel)
        label.delete(old.lowTimeLabel)
        array.remove(weekRecords, 0)

    // Remove orphaned day records
    if array.size(dayRecords) > 0
        for i = array.size(dayRecords) - 1 to 0
            RangeRecord d = array.get(dayRecords, i)
            bool keep = false
            for id in keepIds
                if d.weekId == id
                    keep := true
                    break
            if not keep
                box.delete(d.rangeBox)
                label.delete(d.highDot)
                label.delete(d.lowDot)
                label.delete(d.highTimeLabel)
                label.delete(d.lowTimeLabel)
                array.remove(dayRecords, i)

// ══════════════════════════════════════════════════════════════════════════════
// END OF SCRIPT
// ══════════════════════════════════════════════════════════════════════════════
