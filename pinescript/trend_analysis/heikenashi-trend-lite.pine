//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
// SOLQUANT HEIKENASHI TREND LITE
// ═══════════════════════════════════════════════════════════════════════════════
// A smoothed Heikin-Ashi trend indicator that displays EMA-smoothed HA candles.
// Helps identify trend direction and strength by filtering out market noise 
// through double smoothing.
// ═══════════════════════════════════════════════════════════════════════════════

indicator(title = "HeikenAshi Trend Lite", shorttitle="HeikenAshi Trend Lite", overlay=true)

len = input.int(10, title="EMA Length")
len2 = input.int(10, title="Smoothing Length")
bullColor = input.color(color.rgb(20, 165, 255), title="Bullish Color")
bearColor = input.color(color.rgb(255, 20, 255), title="Bearish Color")
showCandles = input.bool(false, title="Show Candles")

// Calculate smoothed Heikin-Ashi values
o = ta.ema(open, len)
c = ta.ema(close, len)
h = ta.ema(high, len)
l = ta.ema(low, len)

haclose = (o+h+l+c)/4
var float haopen = na
haopen := na(haopen[1]) ? (o + c)/2 : (haopen[1] + haclose[1]) / 2
hahigh = math.max(h, math.max(haopen, haclose))
halow = math.min(l, math.min(haopen, haclose))

o2 = ta.ema(haopen, len2)
c2 = ta.ema(haclose, len2)
h2 = ta.ema(hahigh, len2)
l2 = ta.ema(halow, len2)

// Plot candles (optional)
col = o2>c2 ? bearColor : bullColor
o2_display = showCandles ? o2 : na
h2_display = showCandles ? h2 : na
l2_display = showCandles ? l2 : na
c2_display = showCandles ? c2 : na
plotcandle(o2_display, h2_display, l2_display, c2_display, title="HA Candles", color=col, wickcolor=col, bordercolor=col)

// Plot candle body lines and fill
bodyTop = math.max(o2, c2)
bodyBottom = math.min(o2, c2)
isBullish = c2 > o2
lineColor = isBullish ? bullColor : bearColor

// Wick lines and fill
wickTopLine = plot(h2, title="Wick Top", color=color.new(lineColor, 50), linewidth=1)
wickBottomLine = plot(l2, title="Wick Bottom", color=color.new(lineColor, 50), linewidth=1)
fill(wickTopLine, wickBottomLine, color=isBullish ? color.new(bullColor, 85) : color.new(bearColor, 85), title="Wick Fill")

// Body lines and fill
topLine = plot(bodyTop, title="Body Top", color=lineColor, linewidth=1)
bottomLine = plot(bodyBottom, title="Body Bottom", color=lineColor, linewidth=1)
fill(topLine, bottomLine, color=isBullish ? color.new(bullColor, 33) : color.new(bearColor, 33), title="Body Fill")
