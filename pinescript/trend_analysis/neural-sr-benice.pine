var secondColorArray = array.new_color(i_secondLineCount)
var secondReactBelowArray = array.new_int(i_secondLineCount)
var secondReactAboveArray = array.new_int(i_secondLineCount)
var secondRetestCountArray = array.new_int(i_secondLineCount)
var secondPendingDirArray = array.new_int(i_secondLineCount)
var secondPendingExpiryArray = array.new_int(i_secondLineCount)
