var secondMergeCountArray = array.new_int(i_secondLineCount)
var secondZoneArray = array.new_box(i_secondLineCount)

// common calcs
var resInMinutes = f_resInMinutes()
atrBase = ta.atr(14)

// first timeframe
firstChartBarsInHtf = int(f_tfResInMinutes(i_firstTimeframe) / resInMinutes)
firstChartBarsOffset = int(i_firstLeft * firstChartBarsInHtf)

firstPH = ta.pivothigh(high, i_firstLeft, i_firstRight)
firstPL = ta.pivotlow(low, i_firstLeft, i_firstRight)

firstHtfPH = request.security(syminfo.tickerid, i_firstTimeframe, firstPH)
firstHtfPL = request.security(syminfo.tickerid, i_firstTimeframe, firstPL)
firstNewPH = na(firstHtfPH[1]) and not na(firstHtfPH)
firstNewPL = na(firstHtfPL[1]) and not na(firstHtfPL)

firstOffsetToPH = f_offsetToP(high, firstHtfPH, math.min(maxBarsBack, math.max(30, firstChartBarsOffset + firstChartBarsInHtf + 1)))
firstOffsetToPL = f_offsetToP(low, firstHtfPL, math.min(maxBarsBack, math.max(30, firstChartBarsOffset + firstChartBarsInHtf + 1)))

if i_showFirst and firstChartBarsOffset <= maxBarsBack
    f_addLines(firstHtfPH, firstHtfPL, firstOffsetToPH, firstOffsetToPL, firstNewPH, firstNewPL, i_firstColor, i_firstLineCount, i_firstLineThickness, i_firstLineStyle, firstPivotArray, firstPivotLabelArray, firstTouchBelowArray, firstTouchAboveArray, firstReactBelowArray, firstReactAboveArray, firstRetestCountArray, firstLastTouchArray, firstPendingDirArray, firstPendingExpiryArray, firstPendingPriceArray, firstBreakDirArray, firstBreakBarArray, firstLastRetestArray, firstMergeCountArray, firstColorArray, firstZoneArray, atrBase)

if i_showFirst
    f_extendArray(firstPivotArray, firstPivotLabelArray, i_firstExtendLines, firstTouchBelowArray, firstTouchAboveArray, firstReactBelowArray, firstReactAboveArray, firstRetestCountArray, firstLastTouchArray, firstPendingDirArray, firstPendingExpiryArray, firstPendingPriceArray, firstBreakDirArray, firstBreakBarArray, firstLastRetestArray, firstMergeCountArray, firstColorArray, firstZoneArray, i_htfWeightFirst, atrBase)

// second timeframe
secondChartBarsInHtf = int(f_tfResInMinutes(i_secondTimeframe) / resInMinutes)
secondChartBarsOffset = int(i_secondLeft * secondChartBarsInHtf)

secondPH = ta.pivothigh(high, i_secondLeft, i_secondRight)
secondPL = ta.pivotlow(low, i_secondLeft, i_secondRight)

secondHtfPH = request.security(syminfo.tickerid, i_secondTimeframe, secondPH)
secondHtfPL = request.security(syminfo.tickerid, i_secondTimeframe, secondPL)
secondNewPH = na(secondHtfPH[1]) and not na(secondHtfPH)
secondNewPL = na(secondHtfPL[1]) and not na(secondHtfPL)

secondOffsetToPH = f_offsetToP(high, secondHtfPH, math.min(maxBarsBack, math.max(30, secondChartBarsOffset + secondChartBarsInHtf + 1)))
secondOffsetToPL = f_offsetToP(low, secondHtfPL, math.min(maxBarsBack, math.max(30, secondChartBarsOffset + secondChartBarsInHtf + 1)))

if i_showSecond and secondChartBarsOffset <= maxBarsBack
    f_addLines(secondHtfPH, secondHtfPL, secondOffsetToPH, secondOffsetToPL, secondNewPH, secondNewPL, i_secondColor, i_secondLineCount, i_secondLineThickness, i_secondLineStyle, secondPivotArray, secondPivotLabelArray, secondTouchBelowArray, secondTouchAboveArray, secondReactBelowArray, secondReactAboveArray, secondRetestCountArray, secondLastTouchArray, secondPendingDirArray, secondPendingExpiryArray, secondPendingPriceArray, secondBreakDirArray, secondBreakBarArray, secondLastRetestArray, secondMergeCountArray, secondColorArray, secondZoneArray, atrBase)

if i_showSecond
    f_extendArray(secondPivotArray, secondPivotLabelArray, i_secondExtendLines, secondTouchBelowArray, secondTouchAboveArray, secondReactBelowArray, secondReactAboveArray, secondRetestCountArray, secondLastTouchArray, secondPendingDirArray, secondPendingExpiryArray, secondPendingPriceArray, secondBreakDirArray, secondBreakBarArray, secondLastRetestArray, secondMergeCountArray, secondColorArray, secondZoneArray, i_htfWeightSecond, atrBase)
