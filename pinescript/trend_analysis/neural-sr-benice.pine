//@version=6
indicator("Neural SR [BeNice]", overlay = true, max_lines_count = 500, max_labels_count = 500)




//Pivot Support & Resistance
string sr1_style = '▰▰▰▰▰▰▰ SUPPORT & RESISTANCE ▰▰▰▰▰▰▰  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
string sr2_style = 'SECOND TF SETTINGS'
string sr_filter_style = 'SR FILTERS'
string sr_strength_style = 'SR STRENGTH'
string sr_break_style = 'BREAK & RETEST'
string sr_zone_style = 'ZONE MODE'
string sr_merge_style = 'CLUSTER MERGE'
string sr_vr_style = 'VOLUME / RANGE FILTER'

//FIRST TF
i_showFirst = input.bool(false, 'FIRST TF', group = sr1_style, inline = '01')
i_firstTimeframe = input.timeframe('', '', group = sr1_style, inline = '01')
i_firstColor = input.color(#545a6b, 'Color', group = sr1_style, inline = '01')


i_firstLeft = input.int(20, 'Left      ', group = sr1_style, inline = '11')
i_firstRight = input.int(20, 'Right', group = sr1_style, inline = '11')

i_firstLineCount = input.int(10, 'Line Count', group = sr1_style, inline = '12')
i_firstLineThickness = input.int(1, 'Width', minval = 1, group = sr1_style, inline = '12')

i_firstLineStyle = input.string(line.style_dashed, 'Line style ', options = [line.style_dotted, line.style_solid, line.style_dashed], group = sr1_style, inline = '13')
i_firstExtendLines = input.bool(true, 'Extend lines', group = sr1_style, inline = '13')


//SECOND TF
i_showSecond = input.bool(false, 'SECOND TF', group = sr2_style, inline = '02')
i_secondTimeframe = input.timeframe('D', '', group = sr2_style, inline = '02')
i_secondColor = input.color(#545a6b, 'Color', group = sr2_style, inline = '02')

i_secondLeft = input.int(15, 'Left        ', group = sr2_style, inline = '21')
i_secondRight = input.int(15, 'Right', group = sr2_style, inline = '21')

i_secondLineCount = input.int(10, 'Line Count  ', group = sr2_style, inline = '22')
i_secondLineThickness = input.int(2, 'Width', minval = 1, group = sr2_style, inline = '22')


i_secondLineStyle = input.string(line.style_dotted, 'Line style   ', options = [line.style_dotted, line.style_solid, line.style_dashed], group = sr2_style, inline = '23')
i_secondExtendLines = input.bool(true, 'Extend lines', group = sr2_style, inline = '23')

maxBarsBack = input(400, title = 'Max Bars Back ', group = sr2_style, inline = '24')

i_srFilterEnable = input.bool(false, 'Filter by Wick Touch', group = sr_filter_style, inline = 'f1')
i_srMinTouchBelow = input.int(1, 'Min Touch From Below', minval = 0, group = sr_filter_style, inline = 'f2')
i_srMinTouchAbove = input.int(1, 'Min Touch From Above', minval = 0, group = sr_filter_style, inline = 'f2')

i_touchMode = input.string("Wick+Body", "Touch Mode", options = ["Wick", "Body", "Wick+Body"], group = sr_filter_style, inline = 'f3')
i_touchDevAtr = input.float(0.0, "Deviation ATR", minval = 0.0, step = 0.1, group = sr_filter_style, inline = 'f4')
i_touchDevTicks = input.int(0, "Deviation Ticks", minval = 0, group = sr_filter_style, inline = 'f4')

i_strengthAuto = input.bool(true, "Auto Strength Filter", group = sr_strength_style, inline = 's1')
i_strengthPct = input.float(0.5, "Min % of Max", minval = 0.0, maxval = 1.0, step = 0.05, group = sr_strength_style, inline = 's1')
i_weightTouch = input.float(1.0, "Weight Touch", minval = 0.0, step = 0.1, group = sr_strength_style, inline = 's2')
i_weightReaction = input.float(1.5, "Weight Reaction", minval = 0.0, step = 0.1, group = sr_strength_style, inline = 's2')
i_weightRetest = input.float(2.0, "Weight Retest", minval = 0.0, step = 0.1, group = sr_strength_style, inline = 's2')
i_strengthWidthMin = input.int(1, "Width Min", minval = 1, maxval = 6, group = sr_strength_style, inline = 's3')
i_strengthWidthMax = input.int(4, "Width Max", minval = 1, maxval = 8, group = sr_strength_style, inline = 's3')
i_strengthAlphaMin = input.int(0, "Alpha Min", minval = 0, maxval = 100, group = sr_strength_style, inline = 's4')
i_strengthAlphaMax = input.int(80, "Alpha Max", minval = 0, maxval = 100, group = sr_strength_style, inline = 's4')
i_htfWeightFirst = input.float(1.0, "TF1 Weight", minval = 0.1, step = 0.1, group = sr_strength_style, inline = 's5')
i_htfWeightSecond = input.float(1.5, "TF2 Weight", minval = 0.1, step = 0.1, group = sr_strength_style, inline = 's5')
i_reactionBars = input.int(10, "Reaction Bars", minval = 1, group = sr_strength_style, inline = 's6')
i_reactionAtr = input.float(0.5, "Reaction ATR", minval = 0.0, step = 0.1, group = sr_strength_style, inline = 's6')

i_breakRetestEnable = input.bool(true, "Enable", group = sr_break_style, inline = 'b1')
i_breakAtrBuffer = input.float(0.0, "Break ATR Buffer", minval = 0.0, step = 0.1, group = sr_break_style, inline = 'b2')
i_retestBars = input.int(30, "Retest Window", minval = 1, group = sr_break_style, inline = 'b2')
i_retestLabelSize = input.string(size.tiny, "Label Size", options = [size.tiny, size.small, size.normal], group = sr_break_style, inline = 'b3')
i_retestColor = input.color(color.new(#00c853, 0), "Label Color", group = sr_break_style, inline = 'b3')

i_zoneEnable = input.bool(false, "Enable", group = sr_zone_style, inline = 'z1')
i_zoneAtr = input.float(0.25, "Zone ATR", minval = 0.0, step = 0.05, group = sr_zone_style, inline = 'z2')
i_zoneTicks = input.int(0, "Zone Ticks", minval = 0, group = sr_zone_style, inline = 'z2')
i_zoneAlpha = input.int(85, "Zone Alpha", minval = 0, maxval = 100, group = sr_zone_style, inline = 'z3')

i_mergeEnable = input.bool(true, "Enable", group = sr_merge_style, inline = 'm1')
i_mergeAtr = input.float(0.2, "Merge ATR", minval = 0.0, step = 0.05, group = sr_merge_style, inline = 'm2')
i_mergeTicks = input.int(0, "Merge Ticks", minval = 0, group = sr_merge_style, inline = 'm2')

i_filterVolEnable = input.bool(false, "Volume Filter", group = sr_vr_style, inline = 'v1')
i_filterVolLen = input.int(50, "Vol SMA", minval = 1, group = sr_vr_style, inline = 'v2')
i_filterVolMult = input.float(1.2, "Vol Mult", minval = 0.1, step = 0.1, group = sr_vr_style, inline = 'v2')
i_filterRangeEnable = input.bool(false, "Range Filter", group = sr_vr_style, inline = 'v3')
i_filterRangeAtrLen = input.int(14, "ATR Len", minval = 1, group = sr_vr_style, inline = 'v4')
i_filterRangeAtrMult = input.float(1.0, "Range ATR", minval = 0.1, step = 0.1, group = sr_vr_style, inline = 'v4')

f_roundToTick(_price) =>
    math.round(_price / syminfo.mintick) * syminfo.mintick

f_tickFormat() =>
    _s = str.tostring(syminfo.mintick)
    _s := str.replace_all(_s, '25', '00')
    _s := str.replace_all(_s, '5', '0')
    _s := str.replace_all(_s, '1', '0')
    _s

f_offsetToP(_src, _pivotPrice, _maxBack) =>
    int _offset = na
    float _delta = 10e10
    if not na(_pivotPrice)
        for _i = 1 to _maxBack by 1
            _thisDelta = math.abs(_src[_i] - _pivotPrice)
            if _thisDelta < _delta
                _delta := _thisDelta
                _offset := _i
                _offset
    _offset

f_resInMinutes() =>
    _resInMinutes = timeframe.multiplier * (timeframe.isseconds ? 1. / 60. : timeframe.isminutes ? 1. : timeframe.isdaily ? 1440. : timeframe.isweekly ? 10080. : timeframe.ismonthly ? 43800. : na)
    _resInMinutes

f_tfResInMinutes(_resolution) =>
    request.security(syminfo.tickerid, _resolution, f_resInMinutes())

f_resNextStep(_res) =>
    _res <= 1 ? '15' : _res <= 5 ? '60' : _res <= 30 ? '240' : _res <= 60 ? '1D' : _res <= 360 ? '3D' : _res <= 1440 ? '1W' : _res <= 10080 ? '1M' : '12M'

f_multipleOfRes(_res, _mult) =>
    _targetResInMin = _res * math.max(_mult, 1)
    _targetResInMin <= 0.083 ? '5S' : _targetResInMin <= 0.251 ? '15S' : _targetResInMin <= 0.501 ? '30S' : _targetResInMin <= 1440 ? str.tostring(math.round(_targetResInMin)) : _targetResInMin <= 43800 ? str.tostring(math.round(math.min(_targetResInMin / 1440, 365))) + 'D' : str.tostring(math.round(math.min(_targetResInMin / 43800, 12))) + 'M'

f_touchTol(_atr) =>
    math.max(i_touchDevTicks * syminfo.mintick, i_touchDevAtr * _atr)

f_zoneTol(_atr) =>
    math.max(i_zoneTicks * syminfo.mintick, i_zoneAtr * _atr)

f_mergeTol(_atr) =>
    math.max(i_mergeTicks * syminfo.mintick, i_mergeAtr * _atr)

f_isTouch(_y, _tol) =>
    wickTouch = high >= _y - _tol and low <= _y + _tol
    bodyHigh = math.max(open, close)
    bodyLow = math.min(open, close)
    bodyTouch = bodyHigh >= _y - _tol and bodyLow <= _y + _tol
    i_touchMode == "Wick" ? wickTouch : i_touchMode == "Body" ? bodyTouch : (wickTouch or bodyTouch)

f_touchDir(_y) =>
    close > _y ? 1 : close < _y ? -1 : 0

f_passFilters(_offset, _atr) =>
    ok = true
    if na(_offset)
        ok := false
    if ok and i_filterVolEnable
        v = volume[_offset]
        vma = ta.sma(volume, i_filterVolLen)[_offset]
        ok := ok and not na(vma) and v >= vma * i_filterVolMult
    if ok and i_filterRangeEnable
        r = ta.tr(true)[_offset]
        atrv = ta.atr(i_filterRangeAtrLen)[_offset]
        ok := ok and not na(atrv) and r >= atrv * i_filterRangeAtrMult
    ok

f_extendArray(_lineArray, _labelArray, _extendLines, _touchBelow, _touchAbove, _reactBelow, _reactAbove, _retestCount, _lastTouch, _pendingDir, _pendingExpiry, _pendingPrice, _breakDir, _breakBar, _lastRetest, _mergeCount, _colorArray, _boxArray, _tfWeight, _atr) =>
    if array.size(_lineArray) > 0
        maxStrength = 0.0
        for _i = 0 to array.size(_lineArray) - 1
            tBelow = array.get(_touchBelow, _i)
            tAbove = array.get(_touchAbove, _i)
            rBelow = array.get(_reactBelow, _i)
            rAbove = array.get(_reactAbove, _i)
            rtest = array.get(_retestCount, _i)
            mcnt = array.get(_mergeCount, _i)
            strength = ((tBelow + tAbove) * i_weightTouch + (rBelow + rAbove) * i_weightReaction + rtest * i_weightRetest + mcnt) * _tfWeight
            if strength > maxStrength
                maxStrength := strength
        for _i = array.size(_lineArray) - 1 to 0 by 1

            lineObj = array.get(_lineArray, _i)
            lblObj = array.get(_labelArray, _i)
            x2 = line.get_x2(lineObj)
            yValue = line.get_y1(lineObj)

            if _extendLines or bar_index - 1 == x2 and not(high > yValue and low < yValue)
                line.set_x2(lineObj, bar_index)
                label.set_x(lblObj, bar_index)
                if i_zoneEnable
                    zoneBox = array.get(_boxArray, _i)
                    if not na(zoneBox)
                        ztol = f_zoneTol(_atr)
                        box.set_right(zoneBox, bar_index)
                        box.set_top(zoneBox, yValue + ztol)
                        box.set_bottom(zoneBox, yValue - ztol)

            tol = f_touchTol(_atr)
            touched = f_isTouch(yValue, tol)
            if touched
                lastTouch = array.get(_lastTouch, _i)
                if lastTouch != bar_index
                    dir = f_touchDir(yValue)
                    if dir < 0
                        array.set(_touchBelow, _i, array.get(_touchBelow, _i) + 1)
                    else if dir > 0
                        array.set(_touchAbove, _i, array.get(_touchAbove, _i) + 1)
                    else
                        array.set(_touchBelow, _i, array.get(_touchBelow, _i) + 1)
                        array.set(_touchAbove, _i, array.get(_touchAbove, _i) + 1)
                    array.set(_lastTouch, _i, bar_index)
                    if i_reactionBars > 0 and dir != 0
                        array.set(_pendingDir, _i, dir)
                        array.set(_pendingPrice, _i, yValue)
                        array.set(_pendingExpiry, _i, bar_index + i_reactionBars)

            pDir = array.get(_pendingDir, _i)
            if pDir != 0
                exp = array.get(_pendingExpiry, _i)
                pPrice = array.get(_pendingPrice, _i)
                if bar_index <= exp
                    if pDir > 0 and (high - pPrice) >= i_reactionAtr * _atr
                        array.set(_reactAbove, _i, array.get(_reactAbove, _i) + 1)
                        array.set(_pendingDir, _i, 0)
                    else if pDir < 0 and (pPrice - low) >= i_reactionAtr * _atr
                        array.set(_reactBelow, _i, array.get(_reactBelow, _i) + 1)
                        array.set(_pendingDir, _i, 0)
                else
                    array.set(_pendingDir, _i, 0)

            if i_breakRetestEnable
                btol = i_breakAtrBuffer * _atr
                bdir = array.get(_breakDir, _i)
                if bdir == 0
                    if close > yValue + btol and open < yValue - btol
                        array.set(_breakDir, _i, 1)
                        array.set(_breakBar, _i, bar_index)
                    else if close < yValue - btol and open > yValue + btol
                        array.set(_breakDir, _i, -1)
                        array.set(_breakBar, _i, bar_index)
                else
                    bbar = array.get(_breakBar, _i)
                    if bar_index <= bbar + i_retestBars
                        if touched
                            lastRt = array.get(_lastRetest, _i)
                            if lastRt != bar_index
                                if bdir == 1 and close >= yValue
                                    label.new(bar_index, yValue, "RT", xloc.bar_index, yloc.price, color.new(i_retestColor, 80), label.style_label_down, i_retestColor, i_retestLabelSize)
                                    array.set(_retestCount, _i, array.get(_retestCount, _i) + 1)
                                    array.set(_lastRetest, _i, bar_index)
                                    array.set(_breakDir, _i, 0)
                                else if bdir == -1 and close <= yValue
                                    label.new(bar_index, yValue, "RT", xloc.bar_index, yloc.price, color.new(i_retestColor, 80), label.style_label_up, i_retestColor, i_retestLabelSize)
                                    array.set(_retestCount, _i, array.get(_retestCount, _i) + 1)
                                    array.set(_lastRetest, _i, bar_index)
                                    array.set(_breakDir, _i, 0)
                    else
                        array.set(_breakDir, _i, 0)

            tBelow = array.get(_touchBelow, _i)
            tAbove = array.get(_touchAbove, _i)
            rBelow = array.get(_reactBelow, _i)
            rAbove = array.get(_reactAbove, _i)
            rtest = array.get(_retestCount, _i)
            mcnt = array.get(_mergeCount, _i)
            strength = ((tBelow + tAbove) * i_weightTouch + (rBelow + rAbove) * i_weightReaction + rtest * i_weightRetest + mcnt) * _tfWeight
            norm = maxStrength > 0 ? strength / maxStrength : 0.0
            width = math.round(i_strengthWidthMin + (i_strengthWidthMax - i_strengthWidthMin) * norm)
            width := math.max(width, 1)
            baseColor = array.get(_colorArray, _i)
            alpha = math.round(i_strengthAlphaMax - (i_strengthAlphaMax - i_strengthAlphaMin) * norm)
            showLine = true
            if i_srFilterEnable
                showLine := (tBelow >= i_srMinTouchBelow and tAbove >= i_srMinTouchAbove)
            if i_strengthAuto
                showLine := showLine and norm >= i_strengthPct
            if showLine
                line.set_color(lineObj, color.new(baseColor, alpha))
                line.set_width(lineObj, width)
                label.set_textcolor(lblObj, color.new(baseColor, alpha))
                if i_zoneEnable
                    zoneBox = array.get(_boxArray, _i)
                    if not na(zoneBox)
                        box.set_bgcolor(zoneBox, color.new(baseColor, i_zoneAlpha))
            else
                hideColor = color.new(baseColor, 100)
                line.set_color(lineObj, hideColor)
                label.set_textcolor(lblObj, hideColor)
                if i_zoneEnable
                    zoneBox = array.get(_boxArray, _i)
                    if not na(zoneBox)
                        box.set_bgcolor(zoneBox, color.new(baseColor, 100))
            float(na)

f_drawLine(_x1, _x2, _yValue, _lineColor, _lineThickness, _lineStyle) =>
    line.new(x1 = _x1, y1 = _yValue, x2 = _x2 + 10, y2 = _yValue, color = _lineColor, style = _lineStyle, width = _lineThickness)

f_drawLabel(_x, _y, _textColor) =>
    label.new(_x, _y, '', xloc.bar_index, yloc.price, #00000000, label.style_none, _textColor)

f_tryMerge(_yValue, _mergeTol, _pivotArray, _labelArray, _mergeCount, _boxArray, _atr) =>
    int idx = na
    float yLevel = na
    if array.size(_pivotArray) > 0
        for i = 0 to array.size(_pivotArray) - 1
            yLevel = line.get_y1(array.get(_pivotArray, i))
            if math.abs(yLevel - _yValue) <= _mergeTol
                idx := i
                break
    if not na(idx)
        cnt = array.get(_mergeCount, idx)
        newY = (yLevel * cnt + _yValue) / (cnt + 1)
        line.set_y1(array.get(_pivotArray, idx), newY)
        line.set_y2(array.get(_pivotArray, idx), newY)
        label.set_y(array.get(_labelArray, idx), newY)
        array.set(_mergeCount, idx, cnt + 1)
        if i_zoneEnable
            zoneBox = array.get(_boxArray, idx)
            if not na(zoneBox)
                ztol = f_zoneTol(_atr)
                box.set_top(zoneBox, newY + ztol)
                box.set_bottom(zoneBox, newY - ztol)
    idx

f_drawPivotLineAndLabel(_x1, _x2, _yValue, _colorLine, _lineCount, _lineThickness, _lineStyle, _pivotArray, _labelArray, _touchBelow, _touchAbove, _reactBelow, _reactAbove, _retestCount, _lastTouch, _pendingDir, _pendingExpiry, _pendingPrice, _breakDir, _breakBar, _lastRetest, _mergeCount, _colorArray, _boxArray, _atr) =>
    line l = f_drawLine(_x1, _x2, _yValue, _colorLine, _lineThickness, _lineStyle)
    label lab = f_drawLabel(_x1, _yValue, _colorLine)
    box b = na
    if i_zoneEnable
        ztol = f_zoneTol(_atr)
        b := box.new(_x1, _yValue + ztol, _x2 + 10, _yValue - ztol, bgcolor = color.new(_colorLine, i_zoneAlpha), border_color = color.new(_colorLine, 100))

    if array.size(_pivotArray) == _lineCount
        line.delete(array.shift(_pivotArray))
        label.delete(array.shift(_labelArray))
        array.shift(_touchBelow)
        array.shift(_touchAbove)
        array.shift(_reactBelow)
        array.shift(_reactAbove)
        array.shift(_retestCount)
        array.shift(_lastTouch)
        array.shift(_pendingDir)
        array.shift(_pendingExpiry)
        array.shift(_pendingPrice)
        array.shift(_breakDir)
        array.shift(_breakBar)
        array.shift(_lastRetest)
        array.shift(_mergeCount)
        array.shift(_colorArray)
        box oldBox = array.shift(_boxArray)
        if not na(oldBox)
            box.delete(oldBox)
    array.push(_pivotArray, l)
    array.push(_labelArray, lab)
    array.push(_touchBelow, 0)
    array.push(_touchAbove, 0)
    array.push(_reactBelow, 0)
    array.push(_reactAbove, 0)
    array.push(_retestCount, 0)
    array.push(_lastTouch, -1)
    array.push(_pendingDir, 0)
    array.push(_pendingExpiry, -1)
    array.push(_pendingPrice, na)
    array.push(_breakDir, 0)
    array.push(_breakBar, -1)
    array.push(_lastRetest, -1)
    array.push(_mergeCount, 1)
    array.push(_colorArray, _colorLine)
    array.push(_boxArray, b)

f_addLines(_htfPH, _htfPL, _offsetToPH, _offsetToPL, _newPH, _newPL, _color, _lineCount, _lineThickness, _lineStyle, _pivotArray, _pivotLabelArray, _touchBelow, _touchAbove, _reactBelow, _reactAbove, _retestCount, _lastTouch, _pendingDir, _pendingExpiry, _pendingPrice, _breakDir, _breakBar, _lastRetest, _mergeCount, _colorArray, _boxArray, _atr) =>
    if _newPH
        if f_passFilters(_offsetToPH, _atr)
            int x1 = bar_index - _offsetToPH
            int x2 = bar_index
            float yValue = _htfPH
            if i_mergeEnable
                mergeTol = f_mergeTol(_atr)
                idx = f_tryMerge(yValue, mergeTol, _pivotArray, _pivotLabelArray, _mergeCount, _boxArray, _atr)
                if na(idx)
                    f_drawPivotLineAndLabel(x1, x2, yValue, _color, _lineCount, _lineThickness, _lineStyle, _pivotArray, _pivotLabelArray, _touchBelow, _touchAbove, _reactBelow, _reactAbove, _retestCount, _lastTouch, _pendingDir, _pendingExpiry, _pendingPrice, _breakDir, _breakBar, _lastRetest, _mergeCount, _colorArray, _boxArray, _atr)
            else
                f_drawPivotLineAndLabel(x1, x2, yValue, _color, _lineCount, _lineThickness, _lineStyle, _pivotArray, _pivotLabelArray, _touchBelow, _touchAbove, _reactBelow, _reactAbove, _retestCount, _lastTouch, _pendingDir, _pendingExpiry, _pendingPrice, _breakDir, _breakBar, _lastRetest, _mergeCount, _colorArray, _boxArray, _atr)

    if _newPL
        if f_passFilters(_offsetToPL, _atr)
            int x1 = bar_index - _offsetToPL
            int x2 = bar_index
            float yValue = _htfPL
            if i_mergeEnable
                mergeTol = f_mergeTol(_atr)
                idx = f_tryMerge(yValue, mergeTol, _pivotArray, _pivotLabelArray, _mergeCount, _boxArray, _atr)
                if na(idx)
                    f_drawPivotLineAndLabel(x1, x2, yValue, _color, _lineCount, _lineThickness, _lineStyle, _pivotArray, _pivotLabelArray, _touchBelow, _touchAbove, _reactBelow, _reactAbove, _retestCount, _lastTouch, _pendingDir, _pendingExpiry, _pendingPrice, _breakDir, _breakBar, _lastRetest, _mergeCount, _colorArray, _boxArray, _atr)
            else
                f_drawPivotLineAndLabel(x1, x2, yValue, _color, _lineCount, _lineThickness, _lineStyle, _pivotArray, _pivotLabelArray, _touchBelow, _touchAbove, _reactBelow, _reactAbove, _retestCount, _lastTouch, _pendingDir, _pendingExpiry, _pendingPrice, _breakDir, _breakBar, _lastRetest, _mergeCount, _colorArray, _boxArray, _atr)

// arrays
var firstPivotArray = array.new_line(i_firstLineCount)
var secondPivotArray = array.new_line(i_secondLineCount)

var firstPivotLabelArray = array.new_label(i_firstLineCount)
var secondPivotLabelArray = array.new_label(i_secondLineCount)
var firstTouchBelowArray = array.new_int(i_firstLineCount)
var firstTouchAboveArray = array.new_int(i_firstLineCount)
var firstLastTouchArray = array.new_int(i_firstLineCount)
var firstColorArray = array.new_color(i_firstLineCount)
var firstReactBelowArray = array.new_int(i_firstLineCount)
var firstReactAboveArray = array.new_int(i_firstLineCount)
var firstRetestCountArray = array.new_int(i_firstLineCount)
var firstPendingDirArray = array.new_int(i_firstLineCount)
var firstPendingExpiryArray = array.new_int(i_firstLineCount)
var firstPendingPriceArray = array.new_float(i_firstLineCount)
var firstBreakDirArray = array.new_int(i_firstLineCount)
var firstBreakBarArray = array.new_int(i_firstLineCount)
var firstLastRetestArray = array.new_int(i_firstLineCount)
var firstMergeCountArray = array.new_int(i_firstLineCount)
var firstZoneArray = array.new_box(i_firstLineCount)
var secondTouchBelowArray = array.new_int(i_secondLineCount)
var secondTouchAboveArray = array.new_int(i_secondLineCount)
