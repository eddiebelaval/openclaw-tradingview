//@version=6
indicator("SMA & Elliott Wave Buy/Sell Signal (V1)", overlay=true)

// --- Inputs ---
smaFastLen = 10, smaMedLen = 20, smaSlowLen = 50
adxLen = 14, adxThreshold = 20
volLen = 20, volMult = 1.3 // 130% of average volume

// --- Trend Strength Filter (ADX) ---
[diplus, diminus, adx] = ta.dmi(adxLen, adxLen)
isTrending = adx > adxThreshold // Silences signals in choppy/flat markets

// --- Moving Averages (Trend Stack) ---
sma10 = ta.sma(close, smaFastLen)
sma20 = ta.sma(close, smaMedLen)
sma50 = ta.sma(close, smaSlowLen)
smaStackBuy  = (sma10 > sma20) and (sma20 > sma50)
smaStackSell = (sma10 < sma20) and (sma20 < sma50)

// --- Momentum (RSI & MACD) ---
rsi = ta.rsi(close, 14)
[macdLine, signalLine, macdHist] = ta.macd(close, 12, 26, 9)

// RSI must be on the correct side of the 50 midline
rsiBuy  = rsi > 52 
rsiSell = rsi < 48

// MACD must be "trending positive/negative" (Histogram growing)
macdTrendBuy  = macdLine > signalLine and macdHist > macdHist[1]
macdTrendSell = macdLine < signalLine and macdHist < macdHist[1]

// --- Volume (High Conviction) ---
volSma = ta.sma(volume, volLen)
highVol = volume > (volSma * volMult)

// --- Elliott Wave Impulse Filter (Wave 3 Detection) ---
ewo = ta.sma(close, 5) - ta.sma(close, 35)
isImpulseBuy  = ewo > 0 and ewo > ewo[1] and high > ta.highest(high[1], 10)
isImpulseSell = ewo < 0 and ewo < ewo[1] and low < ta.lowest(low[1], 10)

// --- Signal Construction ---
// Only fire if ALL conditions align, including Trend Strength (ADX)
strongBuy  = isTrending and smaStackBuy  and macdTrendBuy  and rsiBuy  and highVol and isImpulseBuy
strongSell = isTrending and smaStackSell and macdTrendSell and rsiSell and highVol and isImpulseSell

// --- Visuals ---
plot(sma10, color=color.aqua, title="10 SMA")
plot(sma20, color=color.orange, title="20 SMA")
plot(sma50, color=color.purple, linewidth=2, title="50 SMA")

// Signals: Only plot the "Initial" signal of a trend to prevent clutter
plotshape(strongBuy and not strongBuy[1],  title="Strong Buy",  style=shape.labelup,   location=location.belowbar, color=color.green, text=" ",  textcolor=color.white, size=size.small)
plotshape(strongSell and not strongSell[1], title="Strong Sell", style=shape.labeldown, location=location.abovebar, color=color.red,   text=" ", textcolor=color.white, size=size.small)

// Visual validation of the trending state
bgcolor(isTrending ? color.new(color.gray, 95) : na)
