// © Noah - Renko Transition MA
// Smooth trend line driven by Renko direction changes.
// Averages the last N midpoints where price flipped direction.

//@version=6
indicator("Renko MA", overlay=true)

// ─── INPUTS ─────────────────────────────────────────────────────────────────
int   ma_length = input.int(14,   "Lookback", minval=2, maxval=100)
float atr_mult  = input.float(1.0, "Sensitivity", minval=0.1, step=0.1, tooltip="Lower = more flips = more responsive. Higher = fewer flips = smoother.")

// ─── RENKO ENGINE ───────────────────────────────────────────────────────────
float box_size = math.max(ta.atr(14) * atr_mult, syminfo.mintick)

var float brick_close = na
var float brick_high  = na
var float brick_low   = na
var int   brick_dir   = 0
var bool  initialized = false
var float[] midpoints = array.new_float(0)

if not initialized and not na(close) and not na(box_size)
    brick_close := math.round(close / box_size) * box_size
    brick_high  := high
    brick_low   := low
    initialized := true

if initialized and not na(box_size)
    brick_high := math.max(brick_high, high)
    brick_low  := math.min(brick_low, low)

    float delta       = close - brick_close
    int bricks_formed = math.floor(math.abs(delta) / box_size)

    if bricks_formed >= 1
        int new_dir     = delta > 0 ? 1 : -1
        int old_dir     = brick_dir
        float old_close = brick_close

        brick_close := brick_close + bricks_formed * (delta > 0 ? box_size : -box_size)
        brick_high  := high
        brick_low   := low
        brick_dir   := new_dir

        if old_dir != 0 and new_dir != old_dir
            array.push(midpoints, (old_close + brick_close) / 2.0)
            if array.size(midpoints) > ma_length
                array.shift(midpoints)

// ─── PLOT ───────────────────────────────────────────────────────────────────
float ma = array.size(midpoints) > 0 ? array.avg(midpoints) : na

plot(ma, "Renko MA", color=#00f0ff, linewidth=2, style=plot.style_stepline)
