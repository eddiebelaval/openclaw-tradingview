//@version=6
indicator("Pullback SAR Pro", overlay=true, max_lines_count=500)

// ===== SAR SETTINGS =====
sarStart = input.float(0.01, "SAR Start")
sarStep = input.float(0.01, "SAR Increment")
sarMax = input.float(0.1, "SAR Max Value")
sar = ta.sar(sarStart, sarStep, sarMax)

// ===== TREND =====
bullTrend = close > sar
bearTrend = close < sar

// ===== PULLBACK =====
pullbackBull = bullTrend[1] and close < close[1] and low < low[1]
pullbackBear = bearTrend[1] and close > close[1] and high > high[1]

// ===== REENTRY =====
longSignalRaw = pullbackBull[1] and bullTrend and close > close[1]
shortSignalRaw = pullbackBear[1] and bearTrend and close < close[1]

// ===== VWAP FILTER =====
useVWAP = input.bool(true, "Use VWAP Filter")
vwap = ta.vwap(hlc3)
plot(vwap, "VWAP", color=color.orange)

longVWAP = not useVWAP or close > vwap
shortVWAP = not useVWAP or close < vwap

// ===== VOLUME FILTER =====
useVolume = input.bool(true, "Use Volume Filter")
volLen = input.int(20, "Volume Average Length")
volMult = input.float(1.0, "Volume Multiplier", step=0.1)

volMA = ta.sma(volume, volLen)
volumeOK = not useVolume or volume > volMA * volMult

// ===== SESSION FILTER =====
sessionInput = input.session("0830-1500", "Signal Session (NY time)")
inSession = not na(time(timeframe.period, sessionInput))

sessionStart = inSession and not inSession[1]
sessionEnd = not inSession and inSession[1]

if sessionStart
    line.new(bar_index, low, bar_index, high, extend=extend.both, color=color.new(color.green, 60))
if sessionEnd
    line.new(bar_index, low, bar_index, high, extend=extend.both, color=color.new(color.red, 60))

// ===== SIGNAL LIMITS =====
maxSignalsWindow = input.int(222, "Max Signals Per Session", minval=1)
maxSignalsTrend = input.int(1, "Max Signals After SAR Flip", minval=1)

sarFlip = ta.change(bullTrend) or ta.change(bearTrend)

var int sessionSignals = 0
var int trendSignals = 0

if sessionStart
    sessionSignals := 0
if sarFlip
    trendSignals := 0

// ===== FINAL SIGNALS =====
longSignal =
     longSignalRaw
 and inSession
 and volumeOK
 and sessionSignals < maxSignalsWindow
 and trendSignals < maxSignalsTrend
 and longVWAP

shortSignal =
     shortSignalRaw
 and inSession
 and volumeOK
 and sessionSignals < maxSignalsWindow
 and trendSignals < maxSignalsTrend
 and shortVWAP

if longSignal or shortSignal
    sessionSignals += 1
    trendSignals += 1

// ===== TAKE PROFIT =====
tpPerc = input.float(0.035, "Take Profit %", step=0.001) / 100
tpBars = input.int(15, "TP Length (bars)", minval=1)

if longSignal
    tp = close * (1 + tpPerc)
    line.new(bar_index, tp, bar_index + tpBars, tp, width=2, color=color.green)

if shortSignal
    tp = close * (1 - tpPerc)
    line.new(bar_index, tp, bar_index + tpBars, tp, width=2, color=color.red)

// ===== PLOTS =====
plotshape(longSignal, title="Long", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small)
plotshape(shortSignal, title="Short", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)
plot(sar, "Parabolic SAR", style=plot.style_cross, color=color.gray)

// ===== ALERTS =====
alertcondition(longSignal, title="Long Signal", message="Pullback SAR Pro LONG")
alertcondition(shortSignal, title="Short Signal", message="Pullback SAR Pro SHORT")
