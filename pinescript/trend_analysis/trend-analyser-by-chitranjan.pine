//@version=6
indicator("Ultimate Master Pro - Final Elite", shorttitle="MasterProElite", overlay=true)

// --- Settings Group: Dashboard ---
grp1     = "Dashboard Customization"
boxPos   = input.string("Bottom Right", "Box Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left", "Middle Right"], group=grp1)
textSize = input.string("Normal", "Text Size", options=["Small", "Normal", "Large", "Huge"], group=grp1)

// --- Settings Group: Lines ---
grp2     = "Line Settings (Check to Show)"
showVWAP = input.bool(true, "Show VWAP?", group=grp2)
wVWAP    = input.int(2, "VWAP Width", minval=1, maxval=5, group=grp2)

showE9   = input.bool(true, "Show ENTRY (9 EMA)?", group=grp2)
wE9      = input.int(1, "ENTRY Width", minval=1, maxval=5, group=grp2)

showE21  = input.bool(true, "Show EXIT (21 EMA)?", group=grp2)
wE21     = input.int(2, "EXIT Width", minval=1, maxval=5, group=grp2)

showE200 = input.bool(true, "Show TREND (200 EMA)?", group=grp2)
wE200    = input.int(3, "TREND Width", minval=1, maxval=5, group=grp2)

// Map Position and Size
pos = boxPos == "Top Right" ? position.top_right : boxPos == "Bottom Right" ? position.bottom_right : boxPos == "Top Left" ? position.top_left : boxPos == "Bottom Left" ? position.bottom_left : position.middle_right
txt = textSize == "Small" ? size.small : textSize == "Normal" ? size.normal : textSize == "Large" ? size.large : size.huge

// --- Indicator Calculations ---
e9   = ta.ema(close, 9)
e21  = ta.ema(close, 21)
e200 = ta.ema(close, 200)
vw   = ta.vwap
[_, _, adx] = ta.dmi(14, 14)

// --- Logic ---
isBullish = close > e200 and e9 > e21 and close > vw
isBearish = close < e200 and e9 < e21 and close < vw
isStretched = math.abs(((close - vw) / vw) * 100) > 0.4 

string power = adx > 25 ? "🔥 STRONG" : adx > 20 ? "MODERATE" : "❄️ WEAK/CHOP"
color pCol  = adx > 25 ? color.lime : adx > 20 ? color.yellow : color.red

// --- Visual Plots ---
plot(showVWAP ? vw : na,   "VWAP",     color=color.yellow, linewidth=wVWAP)
plot(showE9   ? e9 : na,   "ENTRY (9)", color=color.aqua,   linewidth=wE9)
plot(showE21  ? e21 : na,  "EXIT (21)",  color=color.orange, linewidth=wE21)
plot(showE200 ? e200 : na, "TREND (200)", color=color.white,  linewidth=wE200, style=plot.style_linebr)

// --- Dashboard (Live Numbers) ---
var table tb = table.new(pos, 2, 10, bgcolor=color.rgb(10, 10, 10, 90), border_width=2, border_color=color.gray)

if barstate.islast
    status = isBullish ? "BUY ACTIVE" : isBearish ? "SELL ACTIVE" : "WAITING"
    sCol   = isBullish ? color.lime : isBearish ? color.red : color.gray
    
    table.cell(tb, 0, 0, status, bgcolor=sCol, text_color=color.white, text_size=txt)
    table.merge_cells(tb, 0, 0, 1, 0)
    
    table.cell(tb, 0, 1, "TREND POWER:", text_color=color.gray, text_size=txt)
    table.cell(tb, 1, 1, power, text_color=pCol, text_size=txt)

    warn = isStretched ? "⚠️ STRETCHED" : "✅ SAFE ENTRY"
    table.cell(tb, 0, 2, warn, bgcolor=isStretched ? color.new(color.red, 70) : color.new(color.lime, 70), text_color=color.white, text_size=txt)
    table.merge_cells(tb, 0, 2, 1, 2)

    table.cell(tb, 0, 3, "LIVE PRICE:", text_color=color.white, text_size=txt)
    table.cell(tb, 1, 3, str.tostring(close, "#.00"), text_color=color.white, text_size=txt)
    
    table.cell(tb, 0, 4, "VWAP:", text_color=color.yellow, text_size=txt)
    table.cell(tb, 1, 4, str.tostring(vw, "#.00"), text_color=color.yellow, text_size=txt)
    
    table.cell(tb, 0, 5, "ENTRY (9 EMA):", text_color=color.aqua, text_size=txt)
    table.cell(tb, 1, 5, str.tostring(e9, "#.00"), text_color=color.aqua, text_size=txt)

    table.cell(tb, 0, 6, "EXIT (21 EMA):", text_color=color.orange, text_size=txt)
    table.cell(tb, 1, 6, str.tostring(e21, "#.00"), text_color=color.orange, text_size=txt)

    table.cell(tb, 0, 7, "TREND (200 EMA):", text_color=color.white, text_size=txt)
    table.cell(tb, 1, 7, str.tostring(e200, "#.00"), text_color=color.white, text_size=txt)
    
    strike = math.round(close / 50) * 50
    table.cell(tb, 0, 8, "SUGGESTED:", text_color=color.yellow, text_size=txt)
    table.cell(tb, 1, 8, str.tostring(strike) + (isBullish ? " CE" : " PE"), text_color=color.yellow, text_size=txt)
