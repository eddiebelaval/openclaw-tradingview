//@version=5
indicator("Silver vs Solar Lag Model", overlay=false)

// === INPUTS ===
len = input.int(50, "Z-Score Length")
smoothLen = input.int(10, "Smoothing Length")

// === SYMBOLS ===
silver = close
tan = request.security("TAN", timeframe.period, close)
enph = request.security("ENPH", timeframe.period, close)
fslr = request.security("FSLR", timeframe.period, close)

// === SOLAR BASKET (EQUAL WEIGHT) ===
solar_raw = (tan + enph + fslr) / 3

// === NORMALIZATION ===
// Convert both to % change from moving average
silver_norm = silver / ta.sma(silver, len)
solar_norm  = solar_raw / ta.sma(solar_raw, len)

// === SPREAD ===
spread = silver_norm - solar_norm

// === SMOOTHED SPREAD ===
spread_smooth = ta.ema(spread, smoothLen)

// === Z-SCORE ===
mean = ta.sma(spread_smooth, len)
std  = ta.stdev(spread_smooth, len)
zscore = (spread_smooth - mean) / std

// === PLOTS ===
plot(zscore, title="Z-Score (Silver vs Solar)", linewidth=2)
hline(2, "Overbought", color=color.red)
hline(-2, "Oversold", color=color.green)
hline(0, "Mean", color=color.gray)
