//@version=6
indicator("Outside Bar & 2-Bar Reversal Alerts + System", overlay=true, max_bars_back=500)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
showBullish = input.bool(true, "Show Bullish Signals")
showBearish = input.bool(true, "Show Bearish Signals")

bullColor = input.color(color.new(color.green, 0), "Bullish Label Color")
bearColor = input.color(color.new(color.red,   0), "Bearish Label Color")

showOutsideBar   = input.bool(true, "Show Outside Bars",    group="Patterns")
show2BarReversal = input.bool(true, "Show 2-Bar Reversals", group="Patterns")

useBullSwingFilter = input.bool(false, "Bullish: Only show if low swept a recent swing low",   group="Swing Filters")
useBearSwingFilter = input.bool(false, "Bearish: Only show if high swept a recent swing high", group="Swing Filters")
swingLookback      = input.int(20, "Swing Lookback (bars)",           minval=3, maxval=200, group="Swing Filters")
swingStrength      = input.int(3,  "Swing Strength (bars each side)", minval=1, maxval=10,  group="Swing Filters")

rMultiple      = input.float(2.0, "Take Profit (R Multiple)", minval=0.1, step=0.1,         group="Trade Levels")
showTradeLines = input.bool(true,  "Show Entry / SL / TP Lines",                             group="Trade Levels")
entryColor     = input.color(color.new(color.blue,  0), "Entry Line Color",                  group="Trade Levels")
slColor        = input.color(color.new(color.red,   0), "SL Line Color",                     group="Trade Levels")
tpColor        = input.color(color.new(color.green, 0), "TP Line Color",                     group="Trade Levels")

useTimeFilter = input.bool(true, "Use Entry Time Window",                                     group="Time Filter")
startHour     = input.int(8,    "Start Hour (EST, 24h)", minval=0, maxval=23,                group="Time Filter")
startMinute   = input.int(0,    "Start Minute",          minval=0, maxval=59,                group="Time Filter")
endHour       = input.int(11,   "End Hour (EST, 24h)",   minval=0, maxval=23,                group="Time Filter")
endMinute     = input.int(0,    "End Minute",            minval=0, maxval=59,                group="Time Filter")

useVwapFilter = input.bool(false, "Use VWAP Filter (Bull closes above, Bear closes below)",  group="VWAP Filter")

// ─────────────────────────────────────────────
// TIME FILTER
// ─────────────────────────────────────────────
barHour          = hour(time,   "America/New_York")
barMinute        = minute(time, "America/New_York")
barTimeMinutes   = barHour   * 60 + barMinute
startTimeMinutes = startHour * 60 + startMinute
endTimeMinutes   = endHour   * 60 + endMinute
inTimeWindow     = not useTimeFilter or (barTimeMinutes >= startTimeMinutes and barTimeMinutes < endTimeMinutes)

// ─────────────────────────────────────────────
// VWAP
// ─────────────────────────────────────────────
vwap = ta.vwap(hlc3)

// ─────────────────────────────────────────────
// CANDLE REFERENCES
// ─────────────────────────────────────────────
c2_high  = high[2]
c2_low   = low[2]
c2_close = close[2]

c1_open  = open[1]
c1_high  = high[1]
c1_low   = low[1]
c1_close = close[1]

c0_high  = high
c0_low   = low
c0_close = close

// ─────────────────────────────────────────────
// OUTSIDE BAR CONDITIONS
// ─────────────────────────────────────────────
bullOutsideBar =
     c1_close < c1_open  and
     c1_close < c2_close and
     c1_low   < c2_low   and
     c0_low   < c1_low   and
     c0_close > c1_open  and
     c0_high  > c1_high

bearOutsideBar =
     c1_close > c1_open  and
     c1_close > c2_close and
     c1_high  > c2_high  and
     c0_high  > c1_high  and
     c0_close < c1_open  and
     c0_low   < c1_low

// ─────────────────────────────────────────────
// 2-BAR REVERSAL CONDITIONS
// ─────────────────────────────────────────────
bull2BarReversal =
     c1_close < c2_low  and
     c0_close > c1_open

bear2BarReversal =
     c1_close > c2_high and
     c0_close < c1_open

// ─────────────────────────────────────────────
// VWAP FILTER
// ─────────────────────────────────────────────
bullVwapOk = not useVwapFilter or c0_close > vwap
bearVwapOk = not useVwapFilter or c0_close < vwap

// ─────────────────────────────────────────────
// COMBINE PATTERNS
// ─────────────────────────────────────────────
bullBaseSignal = inTimeWindow and bullVwapOk and
     ((showOutsideBar   and bullOutsideBar)  or
      (show2BarReversal and bull2BarReversal))

bearBaseSignal = inTimeWindow and bearVwapOk and
     ((showOutsideBar   and bearOutsideBar)  or
      (show2BarReversal and bear2BarReversal))

// ─────────────────────────────────────────────
// SWING DETECTION
// ─────────────────────────────────────────────
recentSwingLow() =>
    swingLow = float(na)
    for i = swingStrength to swingLookback
        isSwingLow = true
        for j = 1 to swingStrength
            if low[i] >= low[i - j] or low[i] >= low[i + j]
                isSwingLow := false
                break
        if isSwingLow
            swingLow := low[i]
            break
    swingLow

recentSwingHigh() =>
    swingHigh = float(na)
    for i = swingStrength to swingLookback
        isSwingHigh = true
        for j = 1 to swingStrength
            if high[i] <= high[i - j] or high[i] <= high[i + j]
                isSwingHigh := false
                break
        if isSwingHigh
            swingHigh := high[i]
            break
    swingHigh

// ─────────────────────────────────────────────
// APPLY SWING FILTER
// ─────────────────────────────────────────────
swingLow  = bullBaseSignal and useBullSwingFilter ? recentSwingLow()  : float(na)
swingHigh = bearBaseSignal and useBearSwingFilter ? recentSwingHigh() : float(na)

bullSwingSwept = na(swingLow)  ? false : c0_low  < swingLow
bearSwingSwept = na(swingHigh) ? false : c0_high > swingHigh

bullSignal = bullBaseSignal and (useBullSwingFilter ? bullSwingSwept : true)
bearSignal = bearBaseSignal and (useBearSwingFilter ? bearSwingSwept : true)

// ─────────────────────────────────────────────
// TRADE LEVELS
// ─────────────────────────────────────────────
var array<line>  entryLines  = array.new<line>()
var array<line>  slLines     = array.new<line>()
var array<line>  tpLines     = array.new<line>()
var array<float> entryLevels = array.new<float>()
var array<float> slLevels    = array.new<float>()
var array<float> tpLevels    = array.new<float>()
var array<bool>  bullTrades  = array.new<bool>()
var array<bool>  tradeActive = array.new<bool>()

var array<float> pendingSL   = array.new<float>()
var array<bool>  pendingBull = array.new<bool>()
var array<int>   pendingBar  = array.new<int>()

if bullSignal and showTradeLines
    array.push(pendingSL,   open)
    array.push(pendingBull, true)
    array.push(pendingBar,  bar_index)

if bearSignal and showTradeLines
    array.push(pendingSL,   open)
    array.push(pendingBull, false)
    array.push(pendingBar,  bar_index)

if array.size(pendingBar) > 0 and showTradeLines
    int i = 0
    while i < array.size(pendingBar)
        if bar_index == array.get(pendingBar, i) + 1
            float sl     = array.get(pendingSL,   i)
            bool  isBull = array.get(pendingBull, i)
            float entry  = open
            float risk   = math.abs(entry - sl)
            float tp     = isBull ? entry + risk * rMultiple : entry - risk * rMultiple

            el  = line.new(bar_index, entry, bar_index + 1, entry,
                 color=entryColor, width=1, style=line.style_solid, extend=extend.right )
            sl_ = line.new(bar_index, sl,    bar_index + 1, sl, color=slColor,    width=1, style=line.style_solid, extend=extend.right)
            tl  = line.new(bar_index, tp,    bar_index + 1, tp,
                 color=tpColor,    width=1, style=line.style_solid, extend=extend.right)

            array.push(entryLines,  el)
            array.push(slLines,     sl_)
            array.push(tpLines,     tl)
            array.push(entryLevels, entry)
            array.push(slLevels,    sl)
            array.push(tpLevels,    tp)
            array.push(bullTrades,  isBull)
            array.push(tradeActive, true)

            array.remove(pendingBar,  i)
            array.remove(pendingSL,   i)
            array.remove(pendingBull, i)
        else
            i += 1

if array.size(tradeActive) > 0 and showTradeLines
    for i = 0 to array.size(tradeActive) - 1
        if array.get(tradeActive, i)
            float entry  = array.get(entryLevels, i)
            float sl     = array.get(slLevels,    i)
            float tp     = array.get(tpLevels,    i)
            bool  isBull = array.get(bullTrades,  i)
            bool  tpHit  = isBull ? high >= tp : low  <= tp
            bool  slHit  = isBull ? low  <= sl : high >= sl

            if tpHit or slHit
                array.set(tradeActive, i, false)
                el  = array.get(entryLines, i)
                sl_ = array.get(slLines,    i)
                tl  = array.get(tpLines,    i)
                line.set_extend(el,  extend.none)
                line.set_extend(sl_, extend.none)
                line.set_extend(tl,  extend.none)
                line.set_x2(el,  bar_index)
                line.set_x2(sl_, bar_index)
                line.set_x2(tl,  bar_index)

// ─────────────────────────────────────────────
// VISUALS — plotshape
// ─────────────────────────────────────────────
plotshape(
     showBullish and bullSignal and showOutsideBar and bullOutsideBar and not bull2BarReversal,
     title="Bullish Outside Bar", location=location.belowbar,
     style=shape.labelup, color=bullColor, textcolor=color.white,
     text="Bull OB", size=size.normal)

plotshape(
     showBullish and bullSignal and show2BarReversal and bull2BarReversal and not bullOutsideBar,
     title="Bullish 2-Bar Reversal", location=location.belowbar,
     style=shape.labelup, color=bullColor, textcolor=color.white,
     text="Bull 2BR", size=size.normal)

plotshape(
     showBullish and bullSignal and showOutsideBar and show2BarReversal and bullOutsideBar and bull2BarReversal,
     title="Bullish OB + 2BR", location=location.belowbar,
     style=shape.labelup, color=bullColor, textcolor=color.white,
     text="Bull OB+2BR", size=size.normal)

plotshape(
     showBearish and bearSignal and showOutsideBar and bearOutsideBar and not bear2BarReversal,
     title="Bearish Outside Bar", location=location.abovebar,
     style=shape.labeldown, color=bearColor, textcolor=color.white,
     text="Bear OB", size=size.normal)

plotshape(
     showBearish and bearSignal and show2BarReversal and bear2BarReversal and not bearOutsideBar,
     title="Bearish 2-Bar Reversal", location=location.abovebar,
     style=shape.labeldown, color=bearColor, textcolor=color.white,
     text="Bear 2BR", size=size.normal)

plotshape(
     showBearish and bearSignal and showOutsideBar and show2BarReversal and bearOutsideBar and bear2BarReversal,
     title="Bearish OB + 2BR", location=location.abovebar,
     style=shape.labeldown, color=bearColor, textcolor=color.white,
     text="Bear OB+2BR", size=size.normal)

bgcolor(showBullish and bullSignal ? color.new(color.green, 85) : na, title="Bullish BG")
bgcolor(showBearish and bearSignal ? color.new(color.red,   85) : na, title="Bearish BG")

// ─────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────
alertcondition(
     showBullish and bullSignal and showOutsideBar and bullOutsideBar,
     title="Bullish Outside Bar",
     message="{{ticker}} {{interval}} — Bullish Outside Bar at {{close}}")

alertcondition(
     showBullish and bullSignal and show2BarReversal and bull2BarReversal,
     title="Bullish 2-Bar Reversal",
     message="{{ticker}} {{interval}} — Bullish 2-Bar Reversal at {{close}}")

alertcondition(
     showBearish and bearSignal and showOutsideBar and bearOutsideBar,
     title="Bearish Outside Bar",
     message="{{ticker}} {{interval}} — Bearish Outside Bar at {{close}}")

alertcondition(
     showBearish and bearSignal and show2BarReversal and bear2BarReversal,
     title="Bearish 2-Bar Reversal",
     message="{{ticker}} {{interval}} — Bearish 2-Bar Reversal at {{close}}")

alertcondition(
     (showBullish and bullSignal) or (showBearish and bearSignal),
     title="Any Signal",
     message="{{ticker}} {{interval}} — Reversal pattern detected at {{close}}")

// ─────────────────────────────────────────────
// STATS TABLE
// ─────────────────────────────────────────────
var int totalWins   = 0
var int totalLosses = 0
var array<bool> counted = array.new<bool>()

if array.size(tradeActive) > array.size(counted)
    int diff = array.size(tradeActive) - array.size(counted)
    for i = 0 to diff - 1
        array.push(counted, false)

if array.size(tradeActive) > 0
    for i = 0 to array.size(tradeActive) - 1
        if not array.get(tradeActive, i) and not array.get(counted, i)
            float tp     = array.get(tpLevels,   i)
            bool  isBull = array.get(bullTrades, i)
            bool  tpHit  = isBull ? high >= tp : low <= tp
            if tpHit
                totalWins   += 1
            else
                totalLosses += 1
            array.set(counted, i, true)

int   totalTrades = totalWins + totalLosses
float winRate     = totalTrades > 0 ? (totalWins / totalTrades) * 100 : 0.0

var table statsTable = table.new(
     position.top_right, 2, 5,
     bgcolor      = color.new(color.black, 20),
     border_color = color.new(color.gray,  40),
     border_width = 1,
     frame_color  = color.new(color.gray,  40),
     frame_width  = 1)

if barstate.islast
    table.cell(statsTable, 0, 0, "STAT",
         text_color=color.white, bgcolor=color.new(color.gray, 60), text_halign=text.align_left)
    table.cell(statsTable, 1, 0, "VALUE",
         text_color=color.white, bgcolor=color.new(color.gray, 60), text_halign=text.align_right)
    table.cell(statsTable, 0, 1, "Total Trades",
         text_color=color.white, text_halign=text.align_left)
    table.cell(statsTable, 1, 1, str.tostring(totalTrades),
         text_color=color.white, text_halign=text.align_right)
    table.cell(statsTable, 0, 2, "Wins",
         text_color=color.white, text_halign=text.align_left)
    table.cell(statsTable, 1, 2, str.tostring(totalWins),
         text_color=color.new(color.green, 0), text_halign=text.align_right)
    table.cell(statsTable, 0, 3, "Losses",
         text_color=color.white, text_halign=text.align_left)
    table.cell(statsTable, 1, 3, str.tostring(totalLosses),
         text_color=color.new(color.red, 0), text_halign=text.align_right)
    table.cell(statsTable, 0, 4, "Win Rate",
         text_color=color.white, text_halign=text.align_left)
    table.cell(statsTable, 1, 4, str.tostring(math.round(winRate, 1)) + "%",
         text_color=winRate >= 50 ? color.new(color.green, 0) : color.new(color.red, 0),
         text_halign=text.align_right)
