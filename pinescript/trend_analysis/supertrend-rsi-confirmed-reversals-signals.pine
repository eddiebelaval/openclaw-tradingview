//@version=6
indicator("Supertrend + RSI Confirmed Reversals [Signals]", overlay=true, max_labels_count=500)

// ──── INPUTS ────
atrLen      = input.int(10, "ATR Length", group="Supertrend")
factor      = input.float(3.0, "Factor", step=0.1, group="Supertrend")
rsiLen      = input.int(14, "RSI Length", group="RSI Filter")
obLevel     = input.int(70, "Overbought", group="RSI Filter")
osLevel     = input.int(30, "Oversold", group="RSI Filter")
rsiLookback = input.int(10, "RSI Lookback Bars", tooltip="How many bars back to check if RSI was in OB/OS zone", group="RSI Filter")
showMatrix  = input.bool(true, "Show Momentum Matrix", group="Momentum Matrix")
matrixDepth = input.int(3, "Matrix Depth", minval=1, maxval=5, tooltip="Number of ribbon layers. Higher = more 3D depth.", group="Momentum Matrix")

// ──── SUPERTREND ────
[stLine, stDir] = ta.supertrend(factor, atrLen)
bullFlip = stDir == -1 and stDir[1] == 1
bearFlip = stDir == 1 and stDir[1] == -1

// ──── RSI CONFIRMATION ────
rsi = ta.rsi(close, rsiLen)
wasOversold   = ta.lowest(rsi, rsiLookback) <= osLevel
wasOverbought = ta.highest(rsi, rsiLookback) >= obLevel

// ──── CONFIRMED SIGNALS ────
buySignal  = bullFlip and wasOversold
sellSignal = bearFlip and wasOverbought

// ──── 3D MOMENTUM MATRIX ────
// 5 EMA layers at different speeds fan out from the Supertrend "zero line"
// Strong momentum = wide ribbon (3D depth). Dying momentum = collapsed flat.
// Each layer gets more transparent = fading into the "background" = depth illusion.
ema1 = ta.ema(close, 3)
ema2 = ta.ema(close, 8)
ema3 = ta.ema(close, 14)
ema4 = ta.ema(close, 21)
ema5 = ta.ema(close, 34)

// Determine color per layer based on side of Supertrend
bullC1 = color.new(#00E676, 55)
bullC2 = color.new(#00E676, 68)
bullC3 = color.new(#00E676, 78)
bullC4 = color.new(#00E676, 85)
bullC5 = color.new(#00E676, 90)

bearC1 = color.new(#FF1744, 55)
bearC2 = color.new(#FF1744, 68)
bearC3 = color.new(#FF1744, 78)
bearC4 = color.new(#FF1744, 85)
bearC5 = color.new(#FF1744, 90)

bull = stDir == -1
show1 = showMatrix and matrixDepth >= 1
show2 = showMatrix and matrixDepth >= 2
show3 = showMatrix and matrixDepth >= 3
show4 = showMatrix and matrixDepth >= 4
show5 = showMatrix and matrixDepth >= 5

// ──── PLOTS ────
// Core: Supertrend (zero line) + fastest EMA (leading edge)
pST  = plot(stLine, "Supertrend", bull ? #00E676 : #FF1744, linewidth=2)
pE1  = plot(show1 ? ema1 : na, "Matrix L1", color.new(#FFFFFF, 85), linewidth=1)
pE2  = plot(show2 ? ema2 : na, "Matrix L2", color.new(#FFFFFF, 90), linewidth=1)
pE3  = plot(show3 ? ema3 : na, "Matrix L3", color.new(#FFFFFF, 93), linewidth=1)
pE4  = plot(show4 ? ema4 : na, "Matrix L4", color.new(#FFFFFF, 95), linewidth=1)
pE5  = plot(show5 ? ema5 : na, "Matrix L5", color.new(#FFFFFF, 97), linewidth=1)

// Fills: Layer 1 (brightest/closest) → Layer 5 (most transparent/deepest)
fill(pST, pE1, show1 and bull ? bullC1 : show1 and not bull ? bearC1 : na, title="Matrix Fill L1")
fill(pE1, pE2, show2 and bull ? bullC2 : show2 and not bull ? bearC2 : na, title="Matrix Fill L2")
fill(pE2, pE3, show3 and bull ? bullC3 : show3 and not bull ? bearC3 : na, title="Matrix Fill L3")
fill(pE3, pE4, show4 and bull ? bullC4 : show4 and not bull ? bearC4 : na, title="Matrix Fill L4")
fill(pE4, pE5, show5 and bull ? bullC5 : show5 and not bull ? bearC5 : na, title="Matrix Fill L5")

// ──── SIGNAL ARROWS ────
plotshape(buySignal, "Buy", shape.triangleup, location.belowbar, color.new(#00E676, 0), size=size.normal)
plotshape(sellSignal, "Sell", shape.triangledown, location.abovebar, color.new(#FF1744, 0), size=size.normal)

// ──── ALERTS ────
alertcondition(buySignal, "✅ Confirmed Buy", "Supertrend bullish flip confirmed by RSI oversold")
alertcondition(sellSignal, "🔻 Confirmed Sell", "Supertrend bearish flip confirmed by RSI overbought")
