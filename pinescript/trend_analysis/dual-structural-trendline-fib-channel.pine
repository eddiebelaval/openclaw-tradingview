//@version=6
///////////////////////////////////////////////////////////////////////////////
// INDICATOR INITIALIZATION
// core indicator definition and structural trend engine setup.
// temel gösterge tanımı ve yapısal trend motorunun kurulumu.
///////////////////////////////////////////////////////////////////////////////

indicator("Dual Structural Trendline Fib Channel", shorttitle = "Dual Structural Trendline Fib Channel [yigdeli] 1.0.0",
        overlay = true, 
        max_lines_count = 500, 
        max_bars_back = 5000)

///////////////////////////////////////////////////////////////////////////////
// STRUCTURAL PIVOT CONFIGURATION
// pivot detection parameters and structural trend construction inputs.
// pivot algılama parametreleri ve yapısal trend oluşturma ayarları.
///////////////////////////////////////////////////////////////////////////////

//──────── INPUTS
alan = input.int(
     3, 
     "Pivot Length", 
     minval = 2, 
     maxval = 50,
     tooltip = "Defines the left and right bar count used to detect structural pivot highs and lows.\nYapısal pivot tepe ve diplerini belirlemek için kullanılan sağ ve sol bar sayısını tanımlar."
)

max_num_of_pivots = input.int(
     5, 
     "Maximum Pivot Count", 
     minval = 2, 
     maxval = 10,
     tooltip = "Specifies how many recent pivots are used to construct structural trendlines.\nTrend çizgilerini oluşturmak için kullanılacak maksimum pivot sayısını belirler."
)

show_lines = input.bool(
     true, 
     "Show Trendlines",
     tooltip = "Displays calculated structural support and resistance trendlines.\nHesaplanan yapısal destek ve direnç trend çizgilerini gösterir."
)

sup_color = input.color(
     #2962ff, 
     "Support Color",
     tooltip = "Sets the color of the structural support channel.\nYapısal destek kanalının rengini belirler."
)

res_color = input.color(
     #f40013, 
     "Resistance Color",
     tooltip = "Sets the color of the structural resistance channel.\nYapısal direnç kanalının rengini belirler."
)

space = input.float(
     0.5, 
     "Channel Width Multiplier", 
     step = 0.1,
     tooltip = "Adjusts channel width dynamically based on volatility.\nKanal genişliğini volatiliteye bağlı olarak dinamik şekilde ayarlar."
)

showPressure = input.bool(
     true, 
     "Show Pressure Fill",
     tooltip = "Enables gradient pressure visualization inside the active channel.\nAktif kanal içindeki gradyan baskı görselleştirmesini etkinleştirir."
)

showFibLabels = input.bool(
     true, 
     "Show Fib Labels",
     tooltip = "Displays price labels for active Fibonacci levels.\nAktif Fibonacci seviyeleri için fiyat etiketlerini gösterir."
)

///////////////////////////////////////////////////////////////////////////////
// VOLATILITY & CHANNEL OFFSET ENGINE
// dynamic offset calculation based on ATR and true range smoothing.
// ATR ve true range ortalamasına dayalı dinamik kanal ofset hesaplaması.
///////////////////////////////////////////////////////////////////////////////

//──────── OFFSET
atr = ta.atr(200)
offset = ta.sma(ta.tr(true), 50) * space

///////////////////////////////////////////////////////////////////////////////
// STRUCTURAL PIVOT DETECTION ENGINE
// pivot high/low detection and structural array management.
// pivot tepe/dip algılama ve yapısal dizi yönetimi.
///////////////////////////////////////////////////////////////////////////////

//──────── PIVOTS
ph = ta.pivothigh(high, alan, alan)
pl = ta.pivotlow(low, alan, alan)

var pivH = array.new_float()
var pivL = array.new_float()
var idxH = array.new_int()
var idxL = array.new_int()

if bool(ph)
    array.push(pivH, ph)
    array.push(idxH, bar_index - alan)
    if array.size(pivH) > max_num_of_pivots
        array.shift(pivH), array.shift(idxH)

if bool(pl)
    array.push(pivL, pl)
    array.push(idxL, bar_index - alan)
    if array.size(pivL) > max_num_of_pivots
        array.shift(pivL), array.shift(idxL)

///////////////////////////////////////////////////////////////////////////////
// ACTIVE DRAWING OBJECT MANAGEMENT
// line, label and fill object lifecycle control.
// çizgi, etiket ve dolgu objelerinin yaşam döngüsü kontrolü.
///////////////////////////////////////////////////////////////////////////////

//──────── ACTIVE OBJECTS
var line up_main = na
var line up_band = na
var line up_mid  = na
var linefill up_fill = na
var label up_label = na

var line dn_main = na
var line dn_band = na
var line dn_mid  = na
var linefill dn_fill = na
var label dn_label = na

var float angle_up = na
var float angle_dn = na

///////////////////////////////////////////////////////////////////////////////
// SLOPE CALCULATION FUNCTION
// utility function to compute structural trend slope.
// yapısal trend eğimini hesaplayan yardımcı fonksiyon.
///////////////////////////////////////////////////////////////////////////////

count_slope(y1, y2, x1, x2) =>
    (y2 - y1) / (x2 - x1)

///////////////////////////////////////////////////////////////////////////////
// RESISTANCE STRUCTURE ENGINE
// upper structural trendline detection, validation and extension logic.
// üst yapısal direnç trend çizgisi tespiti, doğrulama ve uzatma mantığı.
///////////////////////////////////////////////////////////////////////////////

//────────────────────────────
// RESISTANCE CALC
//────────────────────────────
float raw_up = na
int up_x1 = na
int up_x3 = na
float up_y1 = na
float up_yExt = na

if array.size(pivH) == max_num_of_pivots and show_lines

    float bestSlope = na

    for i = 0 to max_num_of_pivots - 2
        for j = i + 1 to max_num_of_pivots - 1

            y1 = array.get(pivH, i)
            y2 = array.get(pivH, j)
            x1 = array.get(idxH, i)
            x2 = array.get(idxH, j)

            k = count_slope(y1, y2, x1, x2)
            base = y1 - k * x1
            ok = true

            for m = i + 1 to j - 1
                if array.get(pivH, m) > k * array.get(idxH, m) + base
                    ok := false
                    break

            posExt = 0
            valExt = y2 + k

            if ok
                for ind = x2 + 1 to bar_index
                    if close[bar_index - ind] > valExt
                        ok := false
                        break
                    posExt := ind + 10
                    valExt += k

            if ok and (na(bestSlope) or k < bestSlope)
                bestSlope := k
                up_x1 := x1
                up_x3 := posExt
                up_y1 := y1
                up_yExt := valExt

    if not na(bestSlope)

        // CLEAN OLD
        if not na(up_main)
            line.delete(up_main), line.delete(up_band), line.delete(up_mid)
        if not na(up_fill)
            linefill.delete(up_fill)
        if not na(up_label)
            label.delete(up_label)

        up_main := line.new(up_x1, up_y1, up_x3, up_yExt, color=res_color, width=2)
        up_band := line.new(up_x1, up_y1 - offset, up_x3, up_yExt - offset, color=res_color)
        up_mid  := line.new(up_x1, (up_y1 + up_y1 - offset)/2,
                            up_x3, (up_yExt + up_yExt - offset)/2,
                            color=res_color, style=line.style_dashed)

        up_fill := linefill.new(up_main, up_band, color.new(res_color,80))

        raw_up := (math.abs(bestSlope) / atr) * ((up_x3 - up_x1) / alan)
        angle_up := math.atan(bestSlope) * 180 / math.pi


///////////////////////////////////////////////////////////////////////////////
// RESISTANCE PRESSURE VISUALIZATION
// gradient pressure simulation within active resistance structure.
// aktif direnç yapısı içinde gradyan baskı simülasyonu.
///////////////////////////////////////////////////////////////////////////////

//──── UP PRESSURE GRADIENT (Invisible Lines)

var line up_pressure_1 = na
var line up_pressure_2 = na
var line up_pressure_3 = na

if showPressure and not na(up_main) 

    priceMain = line.get_price(up_main, bar_index)

    // önce eski katmanları sil
    if not na(up_pressure_1)
        line.delete(up_pressure_1)
    if not na(up_pressure_2)
        line.delete(up_pressure_2)
    if not na(up_pressure_3)
        line.delete(up_pressure_3)

    // görünmez line katmanları
    up_pressure_1 := line.new(bar_index+10, high, bar_index+10, priceMain, color = na)
    up_pressure_2 := line.new(bar_index+10, high - (high-priceMain)*0.33, bar_index+10, priceMain, color = na)
    up_pressure_3 := line.new(bar_index+10, high - (high-priceMain)*0.66, bar_index+10, priceMain, color = na)

    // gradient fill simülasyonu
    linefill.new(up_main, up_pressure_1, color.new(res_color, 90))
    linefill.new(up_main, up_pressure_2, color.new(res_color, 75))
    linefill.new(up_main, up_pressure_3, color.new(res_color, 60))

///////////////////////////////////////////////////////////////////////////////
// SUPPORT STRUCTURE ENGINE
// lower structural trendline detection, validation and extension logic.
// alt yapısal destek trend çizgisi tespiti, doğrulama ve uzatma mantığı.
///////////////////////////////////////////////////////////////////////////////

//────────────────────────────
// SUPPORT CALC
//────────────────────────────
float raw_dn = na
int dn_x1 = na
int dn_x3 = na
float dn_y1 = na
float dn_yExt = na

if array.size(pivL) == max_num_of_pivots and show_lines

    float bestSlope2 = na

    for i = 0 to max_num_of_pivots - 2
        for j = i + 1 to max_num_of_pivots - 1

            y1 = array.get(pivL, i)
            y2 = array.get(pivL, j)
            x1 = array.get(idxL, i)
            x2 = array.get(idxL, j)

            k = count_slope(y1, y2, x1, x2)
            base = y1 - k * x1
            ok = true

            for m = i + 1 to j - 1
                if array.get(pivL, m) < k * array.get(idxL, m) + base
                    ok := false
                    break

            posExt = 0
            valExt = y2 + k

            if ok
                for ind = x2 + 1 to bar_index
                    if close[bar_index - ind] < valExt
                        ok := false
                        break
                    posExt := ind + 10
                    valExt += k

            if ok and (na(bestSlope2) or k > bestSlope2)
                bestSlope2 := k
                dn_x1 := x1
                dn_x3 := posExt
                dn_y1 := y1
                dn_yExt := valExt

    if not na(bestSlope2)

        if not na(dn_main)
            line.delete(dn_main), line.delete(dn_band), line.delete(dn_mid)
        if not na(dn_fill)
            linefill.delete(dn_fill)
        if not na(dn_label)
            label.delete(dn_label)

        dn_main := line.new(dn_x1, dn_y1, dn_x3, dn_yExt, color=sup_color, width=2)
        dn_band := line.new(dn_x1, dn_y1 + offset, dn_x3, dn_yExt + offset, color=sup_color)
        dn_mid  := line.new(dn_x1, (dn_y1 + dn_y1 + offset)/2,
                            dn_x3, (dn_yExt + dn_yExt + offset)/2,
                            color=sup_color, style=line.style_dashed)

        dn_fill := linefill.new(dn_main, dn_band, color.new(sup_color,80))

        raw_dn := (math.abs(bestSlope2) / atr) * ((dn_x3 - dn_x1) / alan)
        angle_dn := math.atan(bestSlope2) * 180 / math.pi

///////////////////////////////////////////////////////////////////////////////
// SUPPORT PRESSURE VISUALIZATION
// gradient pressure simulation within active support structure.
// aktif destek yapısı içinde gradyan baskı simülasyonu.
///////////////////////////////////////////////////////////////////////////////

//──── DN PRESSURE GRADIENT

var line dn_pressure_1 = na
var line dn_pressure_2 = na
var line dn_pressure_3 = na

if showPressure and not na(dn_main)

    priceMain = line.get_price(dn_main, bar_index)

    dn_pressure_1 := line.new(bar_index+10, low, bar_index+10, priceMain, color = na)
    dn_pressure_2 := line.new(bar_index+10, low + (priceMain-low)*0.66, bar_index+10, priceMain, color = na)
    dn_pressure_3 := line.new(bar_index+10, low + (priceMain-low)*0.33, bar_index+10, priceMain, color = na)

    linefill.new(dn_main, dn_pressure_1, color.new(sup_color, 90))
    linefill.new(dn_main, dn_pressure_2, color.new(sup_color, 85))
    linefill.new(dn_main, dn_pressure_3, color.new(sup_color, 80))

///////////////////////////////////////////////////////////////////////////////
// RELATIVE TREND STRENGTH ENGINE
// comparative strength calculation between active structural trends.
// aktif yapısal trendler arasında göreceli güç hesaplama motoru.
///////////////////////////////////////////////////////////////////////////////

//────────────────────────────
// RELATIVE STRENGTH
//────────────────────────────

float up_strength = na
float dn_strength = na

if not na(raw_up) and not na(raw_dn)
    total = raw_up + raw_dn
    up_strength := (raw_up / total) * 100
    dn_strength := (raw_dn / total) * 100
else if not na(raw_up)
    up_strength := 100
else if not na(raw_dn)
    dn_strength := 100

if not na(up_strength)
    up_label := label.new(up_x3, up_yExt,
        "STR: " + str.tostring(up_strength, format.mintick) + " | " + str.tostring(angle_up, "#.##") + "°",
        style=label.style_label_down,
        color=res_color,
        textcolor=color.white)

if not na(dn_strength)
    dn_label := label.new(dn_x3, dn_yExt,
        "STR: " + str.tostring(dn_strength, format.mintick) +
         " | " + str.tostring(angle_dn, "#.##") + "°",
        style=label.style_label_up,
        color=sup_color,
        textcolor=color.white)

///////////////////////////////////////////////////////////////////////////////
// FIBONACCI ENGINE CONFIGURATION
// master switch and customizable fibonacci level parameters.
// ana fib anahtarı ve özelleştirilebilir fibonacci seviye parametreleri.
///////////////////////////////////////////////////////////////////////////////

//──────── FIB MASTER SWITCH
showFib = input.bool(
     true, 
     "Show Active Trend Fib",
     tooltip = "EN: Enables adaptive Fibonacci levels based on the dominant structural trend.\nTR: Baskın yapısal trende göre adaptif Fibonacci seviyelerini etkinleştirir."
)

//──────── FIB LEVEL INPUTS
fib_1_val     = input.float(1.0,   "Fib 1 Level")
fib_1_color   = input.color(#ff9800, "Fib 1 Color")
fib_1_style   = input.string("Dotted", "Fib 1 Style", options=["Solid","Dotted","Dashed"])

fib_618_val   = input.float(0.618, "Fib 2 Level")
fib_618_color = input.color(color.white, "Fib 2 Color")
fib_618_style = input.string("Dotted", "Fib 2 Style", options=["Solid","Dotted","Dashed"])

fib_50_val    = input.float(0.5,   "Fib 3 Level")
fib_50_color  = input.color(color.blue, "Fib 3 Color")
fib_50_style  = input.string("Dotted", "Fib 3 Style", options=["Solid","Dotted","Dashed"])

fib_382_val   = input.float(0.382, "Fib 4 Level")
fib_382_color = input.color(color.aqua, "Fib 4 Color")
fib_382_style = input.string("Dotted", "Fib4Style", options=["Solid","Dotted","Dashed"])

fib_272_val   = input.float(0.272, "Fib 5 Level")
fib_272_color = input.color(color.purple, "Fib 5 Color")
fib_272_style = input.string("Dotted", "Fib 5 Style", options=["Solid","Dotted","Dashed"])

fib_0_val     = input.float(0.0,   "Fib 6 Level")
fib_0_color   = input.color(color.gray, "Fib 6 Color")
fib_0_style   = input.string("Dotted", "Fib 6 Style", options=["Solid","Dotted","Dashed"])

///////////////////////////////////////////////////////////////////////////////
// FIBONACCI RENDERING UTILITIES
// style conversion, storage arrays and dynamic label management.
// stil dönüşümü, depolama dizileri ve dinamik etiket yönetimi.
///////////////////////////////////////////////////////////////////////////////

//──────── STYLE CONVERTER
styleConvert(styleStr) =>
    lineStyle = line.style_dotted
    if styleStr == "Solid"
        lineStyle := line.style_solid
    else if styleStr == "Dashed"
        lineStyle := line.style_dashed
    lineStyle

//──────── FIB STORAGE
var line[]  fibLineArr  = array.new_line(6, na)
var label[] fibLabelArr = array.new_label(6, na)

//──── AUTO CONTRAST
getTextColor(bgColor) =>
    r = color.r(bgColor)
    g = color.g(bgColor)
    b = color.b(bgColor)
    luminance = (0.299*r + 0.587*g + 0.114*b)
    luminance > 150 ? color.black : color.white

///////////////////////////////////////////////////////////////////////////////
// FIBONACCI DRAWING FUNCTION
// global fib level rendering and update logic.
// global fib seviye çizim ve güncelleme mantığı.
///////////////////////////////////////////////////////////////////////////////

//──── DRAW FUNCTION (GLOBAL)
drawFib(int idx, float val, color col, string sty,
        float fibLow, float priceRange,
        int fibX1, int fibX2) =>

    oldLine  = array.get(fibLineArr, idx)
    oldLabel = array.get(fibLabelArr, idx)

    if not na(oldLine)
        line.delete(oldLine)
    if not na(oldLabel)
        label.delete(oldLabel)

    level = fibLow + priceRange * val

    newLine = line.new(fibX1, level, fibX2, level,
        color = col,
        style = styleConvert(sty))

    array.set(fibLineArr, idx, newLine)

    if showFibLabels
        bg  = color.new(col, 0)
        txt = getTextColor(bg)

        newLabel = label.new(bar_index + 6, level,
            str.tostring(val) + " | " + str.tostring(level, format.mintick),
            style = label.style_label_down,
            color = na,
            textcolor = bg,
            size = size.normal)

        array.set(fibLabelArr, idx, newLabel)

///////////////////////////////////////////////////////////////////////////////
// ADAPTIVE FIBONACCI PROJECTION LOGIC
// selects dominant structural trend and projects fib levels accordingly.
// baskın yapısal trende göre fib projeksiyonu seçimi ve uygulaması.
///////////////////////////////////////////////////////////////////////////////

//──────── FIB LOGIC

bool useUp = not na(raw_up) and (na(raw_dn) or raw_up > raw_dn)
bool useDn = not na(raw_dn) and (na(raw_up) or raw_dn > raw_up)

float fibLow  = na
float fibHigh = na
int fibX1     = na
int fibX2     = na

if showFib and not na(up_main) and not na(dn_main)

    if useUp
        fibLow  := dn_y1
        fibHigh := up_y1
        fibX1 := math.min(dn_x1, up_x1)
        fibX2 := math.max(dn_x3, up_x3)

    if useDn
        fibLow  := up_y1
        fibHigh := dn_y1
        fibX1 := math.min(dn_x1, up_x1)
        fibX2 := math.max(dn_x3, up_x3)

    if not na(fibLow) and not na(fibHigh)

        priceRange = fibHigh - fibLow

        drawFib(0, fib_1_val,   fib_1_color,   fib_1_style,   fibLow, priceRange, fibX1, fibX2)
        drawFib(1, fib_618_val, fib_618_color, fib_618_style, fibLow, priceRange, fibX1, fibX2)
        drawFib(2, fib_50_val,  fib_50_color,  fib_50_style,  fibLow, priceRange, fibX1, fibX2)
        drawFib(3, fib_382_val, fib_382_color, fib_382_style, fibLow, priceRange, fibX1, fibX2)
        drawFib(4, fib_272_val, fib_272_color, fib_272_style, fibLow, priceRange, fibX1, fibX2)
        drawFib(5, fib_0_val,   fib_0_color,   fib_0_style,   fibLow, priceRange, fibX1, fibX2)

///////////////////////////////////////////////////////////////////////////////
// SCRIPT FINALIZATION
// end of structural trendline and fibonacci processing pipeline.
// yapısal trend çizgisi ve fibonacci işlem hattının sonu.
///////////////////////////////////////////////////////////////////////////////
