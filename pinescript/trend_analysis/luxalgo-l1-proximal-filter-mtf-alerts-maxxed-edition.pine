//@version=6
indicator("LuxAlgo - L1 Proximal Filter [MTF & Alerts] Maxxed Edition", overlay = true)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
color DEFAULT_BULL = #18d5f3
color DEFAULT_BEAR = #ff004d

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{
srcInput           = input.source(close, "Source")
atrMultInput       = input.float(1.5, "ATR Multiplier", minval = 0, step = 0.1)
muInput            = input.float(0.6, "Adaptation Rate (μ)", minval = 0, maxval = 1, step = 0.1)
htf                = input.timeframe("", "Higher Timeframe Confirmation", tooltip = "e.g. '5', '15', '60'. Leave blank to disable.")
show_htf_plot      = input.bool(true, "Show Higher Timeframe Filter Line")
show_bg_trend      = input.bool(true, "Show Background Trend Color")
bg_transparency    = input.int(95, "Background Transparency (0-100)", minval = 0, maxval = 100)
bull_bg_color      = input.color(DEFAULT_BULL, "Bullish Background Color")
bear_bg_color      = input.color(DEFAULT_BEAR, "Bearish Background Color")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
float threshold = ta.atr(200) * atrMultInput

var float z = na
var float v = 0.0

if bar_index == 0
    z := srcInput
else
    float zPrev = z[1]
    float vPrev = v[1]
    float zPred = zPrev + vPrev
    float zTemp = zPred + muInput * (srcInput - zPred)
    float diff = zTemp - zPrev
    v := math.abs(diff) > threshold ? math.sign(diff) * (math.abs(diff) - threshold) : 0.0
    z := zPrev + v

var int trend = 0
if z > z[1]
    trend := 1
else if z < z[1]
    trend := -1

bool ltf_upChange   = trend == 1 and trend[1] == -1
bool ltf_downChange = trend == -1 and trend[1] == 1

float htf_z     = htf != "" ? request.security(syminfo.tickerid, htf, z,     barmerge.gaps_off, barmerge.lookahead_off) : na
int   htf_trend = htf != "" ? request.security(syminfo.tickerid, htf, trend, barmerge.gaps_off, barmerge.lookahead_off) : na

bool htf_upChange   = htf_trend == 1 and htf_trend[1] == -1
bool htf_downChange = htf_trend == -1 and htf_trend[1] == 1

// Entry: full alignment
bool entry_long  = ltf_upChange and (htf == "" or htf_trend == 1) or (htf != "" and htf_upChange and trend == 1)
bool entry_short = ltf_downChange and (htf == "" or htf_trend == -1) or (htf != "" and htf_downChange and trend == -1)

// Close: LTF flips against HTF (only when HTF enabled)
bool close_long  = htf != "" and ltf_downChange and htf_trend == 1
bool close_short = htf != "" and ltf_upChange and htf_trend == -1

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
color zColor = trend == 1 ? DEFAULT_BULL : DEFAULT_BEAR

plot_src = plot(srcInput, "Source Plot", color = na)
plot_z   = plot(z, "L1 Proximal Filter (Current TF)", color = zColor, linewidth = 1)

color htf_color = htf != "" ? (htf_trend == 1 ? color.new(DEFAULT_BULL, 70) : color.new(DEFAULT_BEAR, 70)) : na
plot(show_htf_plot and htf != "" ? htf_z : na, "Higher Timeframe Filter", color = htf != "" ? htf_color : na, linewidth = 1, style = plot.style_stepline)

// Subtle fill
bool showFill = (trend == 1 and srcInput > z) or (trend == -1 and srcInput < z)
fill(plot_src, plot_z, color = showFill ? color.new(zColor, 85) : na)

// User-defined background trend color
bgcolor(show_bg_trend ? (trend == 1 ? color.new(bull_bg_color, bg_transparency) : color.new(bear_bg_color, bg_transparency)) : na)

// Entries: arrow labels
if entry_long
    label.new(bar_index, low, "↑", style = label.style_label_up, color = DEFAULT_BULL, textcolor = color.white, size = size.small, yloc = yloc.belowbar)

if entry_short
    label.new(bar_index, high, "↓", style = label.style_label_down, color = DEFAULT_BEAR, textcolor = color.white, size = size.small, yloc = yloc.abovebar)

// Closes: circles (no title)
float close_long_val  = close_long  ? z[1] : na
float close_short_val = close_short ? z[1] : na
plot(close_long_val,  "", color = DEFAULT_BEAR, style = plot.style_circles, linewidth = 4, offset = -1)
plot(close_short_val, "", color = DEFAULT_BULL, style = plot.style_circles, linewidth = 4, offset = -1)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts - clean selectable conditions
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(entry_long,  title = "Entry Long",  message = "LuxAlgo L1 Proximal Filter: Entry Long on {{ticker}} ({{interval}}) at {{close}}")
alertcondition(entry_short, title = "Entry Short", message = "LuxAlgo L1 Proximal Filter: Entry Short on {{ticker}} ({{interval}}) at {{close}}")
alertcondition(close_long,  title = "Close Long",  message = "LuxAlgo L1 Proximal Filter: Close Long — LTF bearish divergence vs HTF on {{ticker}} ({{interval}}) at {{close}}")
alertcondition(close_short, title = "Close Short", message = "LuxAlgo L1 Proximal Filter: Close Short — LTF bullish divergence vs HTF on {{ticker}} ({{interval}}) at {{close}}")
