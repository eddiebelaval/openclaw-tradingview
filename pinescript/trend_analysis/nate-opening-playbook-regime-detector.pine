//@version=6
indicator("Nate - Opening Playbook - Regime Detector", overlay=true, max_labels_count=50)

//====================
// Inputs (clean + explicit)
//====================
lookbackBars = input.int(50, "Regime lookback (number of candles to evaluate)", minval=10, group="Regime Settings")

emaFastLen = input.int(20, "Fast EMA length (mean reference)", minval=1, group="Regime Settings")
emaMidLen  = input.int(50, "Middle EMA length (trend confirmation)", minval=1, group="Regime Settings")
emaSlowLen = input.int(100, "Slow EMA length (longer trend filter)", minval=1, group="Regime Settings")

bullAboveFast = input.float(0.80, "Bull Trend: % of closes ABOVE Fast EMA must be at least", step=0.01, group="Bull Trend Definition")
bullAboveMid  = input.float(0.90, "Bull Trend: % of closes ABOVE Middle EMA must be at least", step=0.01, group="Bull Trend Definition")
bullAboveSlow = input.float(1.00, "Bull Trend: % of closes ABOVE Slow EMA must be at least", step=0.01, group="Bull Trend Definition")

bearBelowFast = input.float(0.80, "Bear Trend: % of closes BELOW Fast EMA must be at least", step=0.01, group="Bear Trend Definition")
bearBelowMid  = input.float(0.90, "Bear Trend: % of closes BELOW Middle EMA must be at least", step=0.01, group="Bear Trend Definition")
bearBelowSlow = input.float(1.00, "Bear Trend: % of closes BELOW Slow EMA must be at least", step=0.01, group="Bear Trend Definition")

// Range definition (simplified):
// If it's not Bull Trend and not Bear Trend, it's Range.
// This makes the regime system extremely easy to understand and fully objective.
shadeBg = input.bool(true, "Shade background by regime (subtle)", group="Display")

//====================
// EMAs
//====================
emaFast = ta.ema(close, emaFastLen)
emaMid  = ta.ema(close, emaMidLen)
emaSlow = ta.ema(close, emaSlowLen)

//====================
// Percent calcs (SMA of 1/0 series)
//====================
pAboveFast = ta.sma(close > emaFast ? 1.0 : 0.0, lookbackBars)
pAboveMid  = ta.sma(close > emaMid  ? 1.0 : 0.0, lookbackBars)
pAboveSlow = ta.sma(close > emaSlow ? 1.0 : 0.0, lookbackBars)

pBelowFast = ta.sma(close < emaFast ? 1.0 : 0.0, lookbackBars)
pBelowMid  = ta.sma(close < emaMid  ? 1.0 : 0.0, lookbackBars)
pBelowSlow = ta.sma(close < emaSlow ? 1.0 : 0.0, lookbackBars)

//====================
// Regime logic (3 regimes only)
//====================
bullTrend = (pAboveFast >= bullAboveFast) and (pAboveMid >= bullAboveMid) and (pAboveSlow >= bullAboveSlow)
bearTrend = (pBelowFast >= bearBelowFast) and (pBelowMid >= bearBelowMid) and (pBelowSlow >= bearBelowSlow)

rangeReg = (not bullTrend) and (not bearTrend)

regimeText = bullTrend ? "BULL TREND" : bearTrend ? "BEAR TREND" : "RANGE"

//====================
// Colors (subtle background)
//====================
colBull  = color.lime
colBear  = color.red
colRange = color.yellow

regCol = bullTrend ? colBull : bearTrend ? colBear : colRange
bgCol  = bullTrend ? color.new(colBull, 90) : bearTrend ? color.new(colBear, 90) : color.new(colRange, 92)

bgcolor(shadeBg ? bgCol : na)

//====================
// Apex-style top banner (ONLY 3 items; value directly below label)
//====================
var table banner = table.new(position.top_center, 3, 2, bgcolor=color.black, frame_color=color.white, border_color=color.white, border_width=1, frame_width=1)

if barstate.islast
    table.cell(banner, 0, 0, "REGIME", text_color=color.white)
    table.cell(banner, 1, 0, "LOOKBACK", text_color=color.white)
    table.cell(banner, 2, 0, "EMAs", text_color=color.white)

    table.cell(banner, 0, 1, regimeText, text_color=regCol)
    table.cell(banner, 1, 1, str.tostring(lookbackBars), text_color=color.white)
    table.cell(banner, 2, 1, str.tostring(emaFastLen) + " / " + str.tostring(emaMidLen) + " / " + str.tostring(emaSlowLen), text_color=color.white)
