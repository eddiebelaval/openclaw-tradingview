//@version=5
indicator("Precision SPX", shorttitle="Precision SPX ", overlay=true)

// Input Settings
label_size = input.string("normal", "Label Size", options=["tiny", "small", "normal", "large", "huge"], group="Label Settings")
show_level_label = input.bool(true, "Show Level Labels", group="Label Settings")
show_price_label = input.bool(true, "Show Price Labels", group="Label Settings")
price_label_size = input.string("normal", "Price Label Size", options=["tiny", "small", "normal", "large", "huge"], group="Label Settings")
level_label_offset = input.int(15, "Level Label Offset (Bars)", minval=-500, maxval=500, group="Label Settings")
price_label_offset = input.int(20, "Price Label Offset (Bars)", minval=-500, maxval=500, group="Label Settings")

use_es = input.bool(false, "Use ES Futures Price", group="Price Settings")
use_spy = input.bool(false, "Use SPY Price", group="Price Settings")
manual_spread = input.float(0.0, "Manual ES Spread", minval=0.0, step=0.25, group="Price Settings", tooltip="Spread added to SPX levels for ES conversion when Use ES Futures Price is checked.")
manual_spy_spread = input.float(0.0, "Manual SPY Ratio", minval=0.0, step=0.01, group="Price Settings", tooltip="Manual SPY ratio (SPX/SPY). Used when Use SPY Price is checked.")

use_string_input = input.bool(false, "Use String Input for Levels", group="Input Method")
levels_string = input.string("", "All Levels (String)", group="Input Method")

// Monthly Levels (Manual)
m1_price_input = input.price(0.0, "Monthly Level 1 Price", group="Monthly Levels (Manual)")
m1_label_input = input.string("Monthly", "Monthly Level 1 Label", group="Monthly Levels (Manual)")
m1_color = input.color(color.rgb(128, 0, 128), "Monthly Level 1 Color", group="Monthly Levels (Manual)")
m2_price_input = input.price(0.0, "Monthly Level 2 Price", group="Monthly Levels (Manual)")
m2_label_input = input.string("Monthly", "Monthly Level 2 Label", group="Monthly Levels (Manual)")
m2_color = input.color(color.rgb(128, 0, 128), "Monthly Level 2 Color", group="Monthly Levels (Manual)")

// Weekly Levels (Manual)
w1_price_input = input.price(0.0, "Weekly Level 1 Price", group="Weekly Levels (Manual)")
w1_label_input = input.string("Weekly", "Weekly Level 1 Label", group="Weekly Levels (Manual)")
w1_color = input.color(color.rgb(0, 0, 255), "Weekly Level 1 Color", group="Weekly Levels (Manual)")
w2_price_input = input.price(0.0, "Weekly Level 2 Price", group="Weekly Levels (Manual)")
w2_label_input = input.string("Weekly", "Weekly Level 2 Label", group="Weekly Levels (Manual)")
w2_color = input.color(color.rgb(0, 0, 255), "Weekly Level 2 Color", group="Weekly Levels (Manual)")

// Daily Levels (Manual)
d1_price_input = input.price(0.0, "Daily Level 1 Price", group="Daily Levels (Manual)")
d1_label_input = input.string("Daily", "Daily Level 1 Label", group="Daily Levels (Manual)")
d1_color = input.color(color.rgb(255, 0, 0), "Daily Level 1 Color", group="Daily Levels (Manual)")
d2_price_input = input.price(0.0, "Daily Level 2 Price", group="Daily Levels (Manual)")
d2_label_input = input.string("Daily", "Daily Level 2 Label", group="Daily Levels (Manual)")
d2_color = input.color(color.rgb(255, 0, 0), "Daily Level 2 Color", group="Daily Levels (Manual)")
d3_price_input = input.price(0.0, "Daily Level 3 Price", group="Daily Levels (Manual)")
d3_label_input = input.string("Daily", "Daily Level 3 Label", group="Daily Levels (Manual)")
d3_color = input.color(color.rgb(255, 105, 180), "Daily Level 3 Color", group="Daily Levels (Manual)")
d4_price_input = input.price(0.0, "Daily Level 4 Price", group="Daily Levels (Manual)")
d4_label_input = input.string("Daily", "Daily Level 4 Label", group="Daily Levels (Manual)")
d4_color = input.color(color.rgb(255, 105, 180), "Daily Level 4 Color", group="Daily Levels (Manual)")
d5_price_input = input.price(0.0, "Daily Level 5 Price", group="Daily Levels (Manual)")
d5_label_input = input.string("Daily", "Daily Level 5 Label", group="Daily Levels (Manual)")
d5_color = input.color(color.rgb(255, 0, 0), "Daily Level 5 Color", group="Daily Levels (Manual)")
d6_price_input = input.price(0.0, "Daily Level 6 Price", group="Daily Levels (Manual)")
d6_label_input = input.string("Daily", "Daily Level 6 Label", group="Daily Levels (Manual)")
d6_color = input.color(color.rgb(255, 0, 0), "Daily Level 6 Color", group="Daily Levels (Manual)")

// Daily Range Levels (Manual)
dr1_price_input = input.price(0.0, "Daily Range 1 Price", group="Daily Range Levels (Manual)")
dr1_label_input = input.string("Daily Range", "Daily Range 1 Label", group="Daily Range Levels (Manual)")
dr1_color = input.color(color.rgb(0, 188, 212), "Daily Range 1 Color", group="Daily Range Levels (Manual)")
dr2_price_input = input.price(0.0, "Daily Range 2 Price", group="Daily Range Levels (Manual)")
dr2_label_input = input.string("Daily Range", "Daily Range 2 Label", group="Daily Range Levels (Manual)")
dr2_color = input.color(color.rgb(0, 188, 212), "Daily Range 2 Color", group="Daily Range Levels (Manual)")

// Label Size Mapping
size_val = switch label_size
    "tiny" => "tiny"
    "small" => "small"
    "normal" => "normal"
    "large" => "large"
    "huge" => "huge"
    => "normal"

// Zone Thickness
zone_thickness = use_spy ? 0.1 : 1.0

// String Input Parsing
all_levels = use_string_input ? str.split(levels_string, ",") : array.new_string(0)

// Assign Prices and Labels
d1_price = use_string_input and array.size(all_levels) >= 1 ? str.tonumber(array.get(all_levels, 0)) : d1_price_input
d1_label = use_string_input ? "Daily" : d1_label_input
d1_color_final = d1_color
d2_price = use_string_input and array.size(all_levels) >= 2 ? str.tonumber(array.get(all_levels, 1)) : d2_price_input
d2_label = use_string_input ? "Daily" : d2_label_input
d2_color_final = d2_color
d3_price = use_string_input and array.size(all_levels) >= 3 ? str.tonumber(array.get(all_levels, 2)) : d3_price_input
d3_label = use_string_input ? "Daily" : d3_label_input
d3_color_final = d3_color
d4_price = use_string_input and array.size(all_levels) >= 4 ? str.tonumber(array.get(all_levels, 3)) : d4_price_input
d4_label = use_string_input ? "Daily" : d4_label_input
d4_color_final = d4_color
d5_price = use_string_input and array.size(all_levels) >= 5 ? str.tonumber(array.get(all_levels, 4)) : d5_price_input
d5_label = use_string_input ? "Daily" : d5_label_input
d5_color_final = d5_color
d6_price = use_string_input and array.size(all_levels) >= 6 ? str.tonumber(array.get(all_levels, 5)) : d6_price_input
d6_label = use_string_input ? "Daily" : d6_label_input
d6_color_final = d6_color
dr1_price = use_string_input and array.size(all_levels) >= 7 ? str.tonumber(array.get(all_levels, 6)) : dr1_price_input
dr1_label = use_string_input ? "Daily Range" : dr1_label_input
dr1_color_final = dr1_color
dr2_price = use_string_input and array.size(all_levels) >= 8 ? str.tonumber(array.get(all_levels, 7)) : dr2_price_input
dr2_label = use_string_input ? "Daily Range" : dr2_label_input
dr2_color_final = dr2_color
w1_price = use_string_input and array.size(all_levels) >= 9 ? str.tonumber(array.get(all_levels, 8)) : w1_price_input
w1_label = use_string_input ? "Weekly" : w1_label_input
w1_color_final = w1_color
w2_price = use_string_input and array.size(all_levels) >= 10 ? str.tonumber(array.get(all_levels, 9)) : w2_price_input
w2_label = use_string_input ? "Weekly" : w2_label_input
w2_color_final = w2_color
m1_price = use_string_input and array.size(all_levels) >= 11 ? str.tonumber(array.get(all_levels, 10)) : m1_price_input
m1_label = use_string_input ? "Monthly" : m1_label_input
m1_color_final = m1_color
m2_price = use_string_input and array.size(all_levels) >= 12 ? str.tonumber(array.get(all_levels, 11)) : m2_price_input
m2_label = use_string_input ? "Monthly" : m2_label_input
m2_color_final = m2_color

// Adjust Prices for ES or SPY (Manual Only)
d1_price_final = use_spy ? (manual_spy_spread != 0.0 ? d1_price / manual_spy_spread : d1_price) : use_es ? d1_price + manual_spread : d1_price
d1_label_final = use_spy ? d1_label + " SPY" : use_es ? d1_label + " ES" : d1_label
d2_price_final = use_spy ? (manual_spy_spread != 0.0 ? d2_price / manual_spy_spread : d2_price) : use_es ? d2_price + manual_spread : d2_price
d2_label_final = use_spy ? d2_label + " SPY" : use_es ? d2_label + " ES" : d2_label
d3_price_final = use_spy ? (manual_spy_spread != 0.0 ? d3_price / manual_spy_spread : d3_price) : use_es ? d3_price + manual_spread : d3_price
d3_label_final = use_spy ? d3_label + " SPY" : use_es ? d3_label + " ES" : d3_label
d4_price_final = use_spy ? (manual_spy_spread != 0.0 ? d4_price / manual_spy_spread : d4_price) : use_es ? d4_price + manual_spread : d4_price
d4_label_final = use_spy ? d4_label + " SPY" : use_es ? d4_label + " ES" : d4_label
d5_price_final = use_spy ? (manual_spy_spread != 0.0 ? d5_price / manual_spy_spread : d5_price) : use_es ? d5_price + manual_spread : d5_price
d5_label_final = use_spy ? d5_label + " SPY" : use_es ? d5_label + " ES" : d5_label
d6_price_final = use_spy ? (manual_spy_spread != 0.0 ? d6_price / manual_spy_spread : d6_price) : use_es ? d6_price + manual_spread : d6_price
d6_label_final = use_spy ? d6_label + " SPY" : use_es ? d6_label + " ES" : d6_label
dr1_price_final = use_spy ? (manual_spy_spread != 0.0 ? dr1_price / manual_spy_spread : dr1_price) : use_es ? dr1_price + manual_spread : dr1_price
dr1_label_final = use_spy ? dr1_label + " SPY" : use_es ? dr1_label + " ES" : dr1_label
dr2_price_final = use_spy ? (manual_spy_spread != 0.0 ? dr2_price / manual_spy_spread : dr2_price) : use_es ? dr2_price + manual_spread : dr2_price
dr2_label_final = use_spy ? dr2_label + " SPY" : use_es ? dr2_label + " ES" : dr2_label
w1_price_final = use_spy ? (manual_spy_spread != 0.0 ? w1_price / manual_spy_spread : w1_price) : use_es ? w1_price + manual_spread : w1_price
w1_label_final = use_spy ? w1_label + " SPY" : use_es ? w1_label + " ES" : w1_label
w2_price_final = use_spy ? (manual_spy_spread != 0.0 ? w2_price / manual_spy_spread : w2_price) : use_es ? w2_price + manual_spread : w2_price
w2_label_final = use_spy ? w2_label + " SPY" : use_es ? w2_label + " ES" : w2_label
m1_price_final = use_spy ? (manual_spy_spread != 0.0 ? m1_price / manual_spy_spread : m1_price) : use_es ? m1_price + manual_spread : m1_price
m1_label_final = use_spy ? m1_label + " SPY" : use_es ? m1_label + " ES" : m1_label
m2_price_final = use_spy ? (manual_spy_spread != 0.0 ? m2_price / manual_spy_spread : m2_price) : use_es ? m2_price + manual_spread : m2_price
m2_label_final = use_spy ? m2_label + " SPY" : use_es ? m2_label + " ES" : m2_label

// Variable Declarations
var line m1_line = na
var box m1_box = na
var label m1_label_obj = na
var label m1_price_label = na
var line m2_line = na
var box m2_box = na
var label m2_label_obj = na
var label m2_price_label = na
var line w1_line = na
var box w1_box = na
var label w1_label_obj = na
var label w1_price_label = na
var line w2_line = na
var box w2_box = na
var label w2_label_obj = na
var label w2_price_label = na
var line d1_line = na
var box d1_box = na
var label d1_label_obj = na
var label d1_price_label = na
var line d2_line = na
var box d2_box = na
var label d2_label_obj = na
var label d2_price_label = na
var line d3_line = na
var box d3_box = na
var label d3_label_obj = na
var label d3_price_label = na
var line d4_line = na
var box d4_box = na
var label d4_label_obj = na
var label d4_price_label = na
var line d5_line = na
var box d5_box = na
var label d5_label_obj = na
var label d5_price_label = na
var line d6_line = na
var box d6_box = na
var label d6_label_obj = na
var label d6_price_label = na
var line dr1_line = na
var box dr1_box = na
var label dr1_label_obj = na
var label dr1_price_label = na
var line dr2_line = na
var box dr2_box = na
var label dr2_label_obj = na
var label dr2_price_label = na

// One-and-done flags per level (per day)
var bool r2_hi_fired = false
var bool r1_hi_fired = false
var bool p_hi_fired  = false
var bool p_lo_fired  = false
var bool r1_lo_fired = false
var bool r2_lo_fired = false
var bool dr_hi_fired = false
var bool dr_lo_fired = false
var bool w_hi_fired  = false
var bool w_lo_fired  = false
var bool m_hi_fired  = false
var bool m_lo_fired  = false

// =====================
// DRAWING BLOCKS (warning fixed)
// =====================

if nz(m1_price_final) != 0
    if na(m1_line)
        m1_line := line.new(bar_index[900], m1_price_final, bar_index, m1_price_final, color=m1_color_final, style=line.style_solid, width=1, extend=extend.both)
        m1_box := box.new(left=bar_index[900], top=m1_price_final + zone_thickness, right=bar_index + 100, bottom=m1_price_final - zone_thickness, bgcolor=color.new(m1_color_final, 90), border_color=m1_color_final)
        if show_level_label
            m1_label_obj := label.new(bar_index + level_label_offset, m1_price_final, m1_label_final, color=m1_color_final, style=label.style_label_down, textcolor=color.rgb(255, 255, 255), size=size_val)
        if show_price_label
            m1_price_label := label.new(bar_index + price_label_offset, m1_price_final, str.tostring(m1_price_final, "#.##"), color=color.new(m1_color_final, 20), style=label.style_label_left, textcolor=color.white, size=price_label_size)
    else
        line.set_xy1(m1_line, bar_index[900], m1_price_final)
        line.set_xy2(m1_line, bar_index, m1_price_final)
        line.set_extend(m1_line, extend.both)
        box.set_left(m1_box, bar_index[900])
        box.set_right(m1_box, bar_index + 100)
        box.set_top(m1_box, m1_price_final + zone_thickness)
        box.set_bottom(m1_box, m1_price_final - zone_thickness)
        if show_level_label
            label.set_xy(m1_label_obj, bar_index + level_label_offset, m1_price_final)
            label.set_text(m1_label_obj, m1_label_final)
            label.set_color(m1_label_obj, m1_color_final)
            label.set_size(m1_label_obj, size_val)
        if show_price_label
            label.set_xy(m1_price_label, bar_index + price_label_offset, m1_price_final)
            label.set_text(m1_price_label, str.tostring(m1_price_final, "#.##"))
            label.set_color(m1_price_label, color.new(m1_color_final, 20))
            label.set_size(m1_price_label, price_label_size)

if nz(m2_price_final) != 0
    if na(m2_line)
        m2_line := line.new(bar_index[900], m2_price_final, bar_index, m2_price_final, color=m2_color_final, style=line.style_solid, width=1, extend=extend.both)
        m2_box := box.new(left=bar_index[900], top=m2_price_final + zone_thickness, right=bar_index + 100, bottom=m2_price_final - zone_thickness, bgcolor=color.new(m2_color_final, 90), border_color=m2_color_final)
        if show_level_label
            m2_label_obj := label.new(bar_index + level_label_offset, m2_price_final, m2_label_final, color=m2_color_final, style=label.style_label_down, textcolor=color.rgb(255, 255, 255), size=size_val)
        if show_price_label
            m2_price_label := label.new(bar_index + price_label_offset, m2_price_final, str.tostring(m2_price_final, "#.##"), color=color.new(m2_color_final, 20), style=label.style_label_left, textcolor=color.white, size=price_label_size)
    else
        line.set_xy1(m2_line, bar_index[900], m2_price_final)
        line.set_xy2(m2_line, bar_index, m2_price_final)
        line.set_extend(m2_line, extend.both)
        box.set_left(m2_box, bar_index[900])
        box.set_right(m2_box, bar_index + 100)
        box.set_top(m2_box, m2_price_final + zone_thickness)
        box.set_bottom(m2_box, m2_price_final - zone_thickness)
        if show_level_label
            label.set_xy(m2_label_obj, bar_index + level_label_offset, m2_price_final)
            label.set_text(m2_label_obj, m2_label_final)
            label.set_color(m2_label_obj, m2_color_final)
            label.set_size(m2_label_obj, size_val)
        if show_price_label
            label.set_xy(m2_price_label, bar_index + price_label_offset, m2_price_final)
            label.set_text(m2_price_label, str.tostring(m2_price_final, "#.##"))
            label.set_color(m2_price_label, color.new(m2_color_final, 20))
            label.set_size(m2_price_label, price_label_size)

if nz(w1_price_final) != 0
    if na(w1_line)
        w1_line := line.new(bar_index[900], w1_price_final, bar_index, w1_price_final, color=w1_color_final, style=line.style_solid, width=1, extend=extend.both)
        w1_box := box.new(left=bar_index[900], top=w1_price_final + zone_thickness, right=bar_index + 100, bottom=w1_price_final - zone_thickness, bgcolor=color.new(w1_color_final, 90), border_color=w1_color_final)
        if show_level_label
            w1_label_obj := label.new(bar_index + level_label_offset, w1_price_final, w1_label_final, color=w1_color_final, style=label.style_label_down, textcolor=color.rgb(255, 255, 255), size=size_val)
        if show_price_label
            w1_price_label := label.new(bar_index + price_label_offset, w1_price_final, str.tostring(w1_price_final, "#.##"), color=color.new(w1_color_final, 20), style=label.style_label_left, textcolor=color.white, size=price_label_size)
    else
        line.set_xy1(w1_line, bar_index[900], w1_price_final)
        line.set_xy2(w1_line, bar_index, w1_price_final)
        line.set_extend(w1_line, extend.both)
        box.set_left(w1_box, bar_index[900])
        box.set_right(w1_box, bar_index + 100)
        box.set_top(w1_box, w1_price_final + zone_thickness)
        box.set_bottom(w1_box, w1_price_final - zone_thickness)
        if show_level_label
            label.set_xy(w1_label_obj, bar_index + level_label_offset, w1_price_final)
            label.set_text(w1_label_obj, w1_label_final)
            label.set_color(w1_label_obj, w1_color_final)
            label.set_size(w1_label_obj, size_val)
        if show_price_label
            label.set_xy(w1_price_label, bar_index + price_label_offset, w1_price_final)
            label.set_text(w1_price_label, str.tostring(w1_price_final, "#.##"))
            label.set_color(w1_price_label, color.new(w1_color_final, 20))
            label.set_size(w1_price_label, price_label_size)

if nz(w2_price_final) != 0
    if na(w2_line)
        w2_line := line.new(bar_index[900], w2_price_final, bar_index, w2_price_final, color=w2_color_final, style=line.style_solid, width=1, extend=extend.both)
        w2_box := box.new(left=bar_index[900], top=w2_price_final + zone_thickness, right=bar_index + 100, bottom=w2_price_final - zone_thickness, bgcolor=color.new(w2_color_final, 90), border_color=w2_color_final)
        if show_level_label
            w2_label_obj := label.new(bar_index + level_label_offset, w2_price_final, w2_label_final, color=w2_color_final, style=label.style_label_down, textcolor=color.rgb(255, 255, 255), size=size_val)
        if show_price_label
            w2_price_label := label.new(bar_index + price_label_offset, w2_price_final, str.tostring(w2_price_final, "#.##"), color=color.new(w2_color_final, 20), style=label.style_label_left, textcolor=color.white, size=price_label_size)
    else
        line.set_xy1(w2_line, bar_index[900], w2_price_final)
        line.set_xy2(w2_line, bar_index, w2_price_final)
        line.set_extend(w2_line, extend.both)
        box.set_left(w2_box, bar_index[900])
        box.set_right(w2_box, bar_index + 100)
        box.set_top(w2_box, w2_price_final + zone_thickness)
        box.set_bottom(w2_box, w2_price_final - zone_thickness)
        if show_level_label
            label.set_xy(w2_label_obj, bar_index + level_label_offset, w2_price_final)
            label.set_text(w2_label_obj, w2_label_final)
            label.set_color(w2_label_obj, w2_color_final)
            label.set_size(w2_label_obj, size_val)
        if show_price_label
            label.set_xy(w2_price_label, bar_index + price_label_offset, w2_price_final)
            label.set_text(w2_price_label, str.tostring(w2_price_final, "#.##"))
            label.set_color(w2_price_label, color.new(w2_color_final, 20))
            label.set_size(w2_price_label, price_label_size)

if nz(d1_price_final) != 0
    if na(d1_line)
        d1_line := line.new(bar_index[900], d1_price_final, bar_index, d1_price_final, color=d1_color_final, style=line.style_solid, width=1, extend=extend.both)
        d1_box := box.new(left=bar_index[900], top=d1_price_final + zone_thickness, right=bar_index + 100, bottom=d1_price_final - zone_thickness, bgcolor=color.new(d1_color_final, 90), border_color=d1_color_final)
        if show_level_label
            d1_label_obj := label.new(bar_index + level_label_offset, d1_price_final, d1_label_final, color=d1_color_final, style=label.style_label_down, textcolor=color.rgb(255, 255, 255), size=size_val)
        if show_price_label
            d1_price_label := label.new(bar_index + price_label_offset, d1_price_final, str.tostring(d1_price_final, "#.##"), color=color.new(d1_color_final, 20), style=label.style_label_left, textcolor=color.white, size=price_label_size)
    else
