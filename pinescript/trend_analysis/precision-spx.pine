    dr2_box := na
    dr2_label_obj := na
    dr2_price_label := na

// =====================
// ALERT LOGIC
// =====================

r2_hi_cross = ta.cross(close, d1_price_final)
r1_hi_cross = ta.cross(close, d2_price_final)
p_hi_cross  = ta.cross(close, d3_price_final)
p_lo_cross  = ta.cross(close, d4_price_final)
r1_lo_cross = ta.cross(close, d5_price_final)
r2_lo_cross = ta.cross(close, d6_price_final)
dr_hi_cross = ta.cross(close, dr1_price_final)
dr_lo_cross = ta.cross(close, dr2_price_final)
w_hi_cross  = ta.cross(close, w1_price_final)
w_lo_cross  = ta.cross(close, w2_price_final)
m_hi_cross  = ta.cross(close, m1_price_final)
m_lo_cross  = ta.cross(close, m2_price_final)

// Individual alert conditions (kept so you can set separate alerts in the UI)
alertcondition(r2_hi_cross, title="R2_Hi", message="Hit: R2_Hi {{close}}")
alertcondition(r1_hi_cross, title="R1_Hi", message="Hit: R1_Hi {{close}}")
alertcondition(p_hi_cross,  title="P_Hi",  message="Hit: P_Hi {{close}}")
alertcondition(p_lo_cross,  title="P_Lo",  message="Hit: P_Lo {{close}}")
alertcondition(r1_lo_cross, title="R1_Lo", message="Hit: R1_Lo {{close}}")
alertcondition(r2_lo_cross, title="R2_Lo", message="Hit: R2_Lo {{close}}")
alertcondition(dr_hi_cross, title="DR_Hi", message="Hit: DR_Hi {{close}}")
alertcondition(dr_lo_cross, title="DR_Lo", message="Hit: DR_Lo {{close}}")
alertcondition(w_hi_cross,  title="W_Hi",  message="Hit: W_Hi {{close}}")
alertcondition(w_lo_cross,  title="W_Lo",  message="Hit: W_Lo {{close}}")
alertcondition(m_hi_cross,  title="M_Hi",  message="Hit: M_Hi {{close}}")
alertcondition(m_lo_cross,  title="M_Lo",  message="Hit: M_Lo {{close}}")

// Daily reset
if ta.change(time("D"))
    r2_hi_fired := false
    r1_hi_fired := false
    p_hi_fired  := false
    p_lo_fired  := false
    r1_lo_fired := false
    r2_lo_fired := false
    dr_hi_fired := false
    dr_lo_fired := false
    w_hi_fired  := false
    w_lo_fired  := false
    m_hi_fired  := false
    m_lo_fired  := false

// =====================
// SINGLE ALERT() CALL FOR ALL LEVELS (your requested "all at one")
// =====================
string alert_message = na

if r2_hi_cross and not r2_hi_fired
    alert_message := na(alert_message) ? "Precision Levels: R2_Hi hit" : alert_message + "\nPrecision Levels: R2_Hi hit"
    r2_hi_fired := true

if r1_hi_cross and not r1_hi_fired
    alert_message := na(alert_message) ? "Precision Levels: R1_Hi hit" : alert_message + "\nPrecision Levels: R1_Hi hit"
    r1_hi_fired := true

if p_hi_cross and not p_hi_fired
    alert_message := na(alert_message) ? "Precision Levels: P_Hi hit" : alert_message + "\nPrecision Levels: P_Hi hit"
    p_hi_fired := true

if p_lo_cross and not p_lo_fired
    alert_message := na(alert_message) ? "Precision Levels: P_Lo hit" : alert_message + "\nPrecision Levels: P_Lo hit"
    p_lo_fired := true

if r1_lo_cross and not r1_lo_fired
    alert_message := na(alert_message) ? "Precision Levels: R1_Lo hit" : alert_message + "\nPrecision Levels: R1_Lo hit"
    r1_lo_fired := true

if r2_lo_cross and not r2_lo_fired
    alert_message := na(alert_message) ? "Precision Levels: R2_Lo hit" : alert_message + "\nPrecision Levels: R2_Lo hit"
    r2_lo_fired := true

if dr_hi_cross and not dr_hi_fired
    alert_message := na(alert_message) ? "Precision Levels: DR_Hi hit" : alert_message + "\nPrecision Levels: DR_Hi hit"
    dr_hi_fired := true

if dr_lo_cross and not dr_lo_fired
    alert_message := na(alert_message) ? "Precision Levels: DR_Lo hit" : alert_message + "\nPrecision Levels: DR_Lo hit"
    dr_lo_fired := true

if w_hi_cross and not w_hi_fired
    alert_message := na(alert_message) ? "Precision Levels: W_Hi hit" : alert_message + "\nPrecision Levels: W_Hi hit"
    w_hi_fired := true

if w_lo_cross and not w_lo_fired
    alert_message := na(alert_message) ? "Precision Levels: W_Lo hit" : alert_message + "\nPrecision Levels: W_Lo hit"
    w_lo_fired := true

if m_hi_cross and not m_hi_fired
    alert_message := na(alert_message) ? "Precision Levels: M_Hi hit" : alert_message + "\nPrecision Levels: M_Hi hit"
    m_hi_fired := true

if m_lo_cross and not m_lo_fired
    alert_message := na(alert_message) ? "Precision Levels: M_Lo hit" : alert_message + "\nPrecision Levels: M_Lo hit"
    m_lo_fired := true

if not na(alert_message)
    alert(alert_message, alert.freq_once_per_bar)
