//@version=6
indicator(title="Ichimoku Kinkō Hyō - (一目均衡表)", shorttitle="IKH", overlay=true)

// ─────────────────────────────────────────────────────────────
// Timeframe
grpTF = "=================== Timeframe ==================="

tfOpt = input.string(
     "Chart",
     title="Timeframe selection",
     options=["Chart","1 second","5 seconds","15 seconds","30 seconds","1 minute","3 minutes","5 minutes","15 minutes","30 minutes","45 minutes","1 hour","2 hours","3 hours","4 hours","6 hours","8 hours","12 hours","1 day","3 days","1 week","2 weeks","1 month","3 months"],
     tooltip="Timeframe used to compute Ichimoku values.\nChart = use the current chart timeframe.",
     group=grpTF
)

// Convert options to valid request.security() timeframe strings (no ticks)
tfToUse =
     tfOpt == "Chart"      ? timeframe.period :
     tfOpt == "1 second"   ? "1S"  :
     tfOpt == "5 seconds"  ? "5S"  :
     tfOpt == "15 seconds" ? "15S" :
     tfOpt == "30 seconds" ? "30S" :
     tfOpt == "1 minute"   ? "1"   :
     tfOpt == "3 minutes"  ? "3"   :
     tfOpt == "5 minutes"  ? "5"   :
     tfOpt == "15 minutes" ? "15"  :
     tfOpt == "30 minutes" ? "30"  :
     tfOpt == "45 minutes" ? "45"  :
     tfOpt == "1 hour"     ? "60"  :
     tfOpt == "2 hours"    ? "120" :
     tfOpt == "3 hours"    ? "180" :
     tfOpt == "4 hours"    ? "240" :
     tfOpt == "6 hours"    ? "360" :
     tfOpt == "8 hours"    ? "480" :
     tfOpt == "12 hours"   ? "720" :
     tfOpt == "1 day"      ? "D"   :
     tfOpt == "3 days"     ? "3D"  :
     tfOpt == "1 week"     ? "W"   :
     tfOpt == "2 weeks"    ? "2W"  :
     tfOpt == "1 month"    ? "M"   :
     tfOpt == "3 months"   ? "3M"  :
     timeframe.period

// ─────────────────────────────────────────────────────────────
// Ichimoku parameters
grpIchi = "============== Ichimoku Parameters =============="
conversionPeriods   = input.int(9,  minval=1, title="Tenkan-sen period", tooltip="Tenkan-sen lookback period (length). Midpoint of the highest high and lowest low over the last N bars. Default: 9.",  group=grpIchi)
basePeriods         = input.int(26, minval=1, title="Kijun-sen period",  tooltip="Kijun-sen lookback period (length). Midpoint of the highest high and lowest low over the last N bars. Default: 26.", group=grpIchi)
laggingSpan2Periods = input.int(52, minval=1, title="Senkou Span B period", tooltip="Senkou Span B lookback period (length). Midpoint of the highest high and lowest low over the last N bars. Default: 52.", group=grpIchi)
displacement        = input.int(26, minval=1, title="Displacement", tooltip="Displacement used for Chikou Span (backward) and Kumo (forward). Default: 26.", group=grpIchi)

// ─────────────────────────────────────────────────────────────
// Ichimoku line colors (plots + labels + projections)
grpCol = "================ Ichimoku colors ================"
colTenkan = input.color(#2962FF,     title="Tenkan-sen",     tooltip="Color for Tenkan-sen line and its label. Also applied to its projection line and flat levels when enabled.", group=grpCol)
colKijun  = input.color(#B71C1C,     title="Kijun-sen",      tooltip="Color for Kijun-sen line and its label. Also applied to its projection line and flat levels when enabled.",  group=grpCol)
colChikou = input.color(color.black, title="Chikou Span",    tooltip="Color for Chikou Span line and its label.", group=grpCol)
colSSA    = input.color(#A5D6A7,     title="Senkou Span A",  tooltip="Color for Senkou Span A line and its label. Also applied to its projection line and flat levels when enabled.", group=grpCol)
colSSB    = input.color(#EF9A9A,     title="Senkou Span B",  tooltip="Color for Senkou Span B line and its label. Also applied to its projection line and flat levels when enabled.", group=grpCol)

// ─────────────────────────────────────────────────────────────
// Kumo (Cloud) settings
grpKumo = "============== Kumo (Cloud) settings ============="
showKumo   = input.bool(true, title="Show Kumo", group=grpKumo)
colKumoBull = input.color(color.rgb(67, 160, 71, 90), title="Bullish Kumo color", tooltip="Kumo color when Senkou Span A > Senkou Span B.", group=grpKumo)
colKumoBear = input.color(color.rgb(244, 67, 54, 90), title="Bearish Kumo color", tooltip="Kumo color when Senkou Span A < Senkou Span B.", group=grpKumo)

// ─────────────────────────────────────────────────────────────
// Helpers
toLineStyle(opt) =>
    opt == "Solid" ? line.style_solid : opt == "Dashed" ? line.style_dashed : line.style_dotted

donchian(len) => math.avg(ta.lowest(len), ta.highest(len))

safeLen(len) =>
    math.max(1, len)

prettyTF(tfStr) =>
    string t = str.upper(str.trim(tfStr))
    if t == "D"
        "1d"
    else if t == "W"
        "1w"
    else if t == "M"
        "1mo"
    else
        bool hasS = str.endswith(t, "S")
        bool hasH = str.endswith(t, "H")
        bool hasD = str.endswith(t, "D")
        bool hasW = str.endswith(t, "W")
        bool hasM = str.endswith(t, "M")

        if hasS
            float v = str.tonumber(str.replace_all(t, "S", ""))
            na(v) ? t : (str.tostring(int(v)) + "s")
        else if hasH
            float v = str.tonumber(str.replace_all(t, "H", ""))
            na(v) ? t : (str.tostring(int(v)) + "h")
        else if hasD
            float v = str.tonumber(str.replace_all(t, "D", ""))
            na(v) ? t : (str.tostring(int(v)) + "d")
        else if hasW
            float v = str.tonumber(str.replace_all(t, "W", ""))
            na(v) ? t : (str.tostring(int(v)) + "w")
        else if hasM
            float v = str.tonumber(str.replace_all(t, "M", ""))
            na(v) ? t : (str.tostring(int(v)) + "mo")
        else
            float v = str.tonumber(t)
            if na(v)
                t
            else
                int mins = int(v)
                mins < 60 ? (str.tostring(mins) + "m") : (mins % 60 == 0 ? (str.tostring(mins / 60) + "h") : (str.tostring(mins) + "m"))

// ─────────────────────────────────────────────────────────────
// Displacement scaling: calc TF bars -> chart bars
secCalc  = timeframe.in_seconds(tfToUse)
secChart = timeframe.in_seconds(timeframe.period)
ratio    = (not na(secCalc) and not na(secChart) and secChart > 0) ? (secCalc / secChart) : 1.0
dispBars = int(math.max(0, math.round(displacement * ratio)))

stepToChartBars(step) =>
    int(math.max(1, math.round(step * ratio)))

// ─────────────────────────────────────────────────────────────
// Panel 1 — Ichimoku Labels (main lines + kumo)
grpLbl = "================= Ichimoku Labels ================"

// 1) Master
showLineLabels = input.bool(true,
     title="Show Ichimoku Labels",
     tooltip="Shows labels for Tenkan-sen, Kijun-sen, Senkou Span A, Senkou Span B, Chikou Span and Kumo.",
     group=grpLbl)

// 2) Content (DEFAULTS: Japanese + Short)
lblLang = input.string("Japanese",
     title="Label language",
     options=["Japanese","English"],
     tooltip="Japanese = romanized Ichimoku terms.\nEnglish = common English terminology.\n\nTenkan-sen = Conversion Line\nKijun-sen = Base Line\nSenkou Span A = Leading Span A\nSenkou Span B = Leading Span B\nChikou Span = Lagging Span\nKumo = Cloud",
     group=grpLbl)

lblLen  = input.string("Short",
     title="Label length",
     options=["Full","Short"],
     tooltip="Full = complete names. Short = abbreviations. \n\nJapanese:\nTenkan-sen → Tk\nKijun-sen → Kj\nSenkou Span A → SSA\nSenkou Span B → SSB\nChikou Span → Ck\nKumo → Km\n\nEnglish:\nConversion Line → Conv\nBase Line → Base\nLeading Span A → Lead A\nLeading Span B → Lead B\nLagging Span → Ls\nCloud → Cl",
     group=grpLbl)

showLblTF  = input.bool(false,
     title="Show timeframe on labels",
     tooltip="Adds the calculation timeframe next to each label (formatted like 15m, 4h, 1d).",
     group=grpLbl)

showLblVal = input.bool(false,
     title="Show values on labels",
     tooltip="Appends the current line value to each label (formatted to tick size).",
     group=grpLbl)

// 3) Style (DEFAULT: Label + text)
lblDisplayMode = input.string("Label + text",
     title="Label display",
     options=["Label + text","Text only"],
     tooltip="Label + text: boxed label.\nText only: plain text (no box/arrow).",
     group=grpLbl)

labelTextColor = input.color(color.white,
     title="Label text color",
     tooltip="Used only when Label + text mode is selected. Ignored in Text only mode.",
     group=grpLbl)

lblSizeOpt = input.string("Normal",
     title="Label size",
     options=["Tiny","Small","Normal","Large","Huge"],
     tooltip="Select label text size.",
     group=grpLbl)

// 4) Position
lblProjMode = input.string("Last bar",
     title="Label x-position",
     options=["Last bar","End of projection"],
     tooltip="Last bar: labels stay at the current bar.\nEnd of projection: labels move to the end of their projection segments (when projections are enabled).",
     group=grpLbl)

xOffsetBars = input.int(2,
     title="Label horizontal offset (bars)",
     minval=-500, maxval=500,
     tooltip="Moves all Ichimoku labels horizontally.\nPositive = right, Negative = left.\nDefault: 2",
     group=grpLbl)

textOnly = (lblDisplayMode == "Text only")

lblSize =
     lblSizeOpt == "Tiny"   ? size.tiny   :
     lblSizeOpt == "Small"  ? size.small  :
     lblSizeOpt == "Normal" ? size.normal :
     lblSizeOpt == "Large"  ? size.large  : size.huge

lblStyle() =>
    textOnly ? label.style_none : label.style_label_left

lblBg(col) =>
    textOnly ? color.new(col, 100) : col

// ─────────────────────────────────────────────────────────────
// Labels — Custom Text / Hide
grpTxt = "=========== Labels — Custom Text / Hide ============"
hint = "Leave empty to keep the automatic label (from Ichimoku Labels settings). Type your own text to override. Type OFF or - to hide."

tenkanInput = input.string("",    title="Tenkan-sen label",       tooltip=hint, group=grpTxt)
kijunInput  = input.string("",    title="Kijun-sen label",        tooltip=hint, group=grpTxt)
chikouInput = input.string("",    title="Chikou Span label",      tooltip=hint, group=grpTxt)
ssaInput    = input.string("",    title="Senkou Span A label",    tooltip=hint, group=grpTxt)
ssbInput    = input.string("",    title="Senkou Span B label",    tooltip=hint, group=grpTxt)
kumoInput   = input.string("OFF", title="Kumo label",             tooltip=hint, group=grpTxt) // OFF by default

isHidden(s) =>
    t = str.upper(str.trim(s))
    t == "OFF" or t == "-"

resolveText(s, fallback) =>
    str.length(str.trim(s)) > 0 ? s : fallback

showTenkan = not isHidden(tenkanInput)
showKijun  = not isHidden(kijunInput)
showSSA    = not isHidden(ssaInput)
showSSB    = not isHidden(ssbInput)
showChikou = not isHidden(chikouInput)
showKumoT  = not isHidden(kumoInput)

// Defaults (Japanese/English × Full/Short) — Japanese = romanized only
tenkanDefault = lblLang == "Japanese" ? (lblLen == "Short" ? "Tk"   : "Tenkan-sen")
              :                         (lblLen == "Short" ? "Conv" : "Conversion Line")

kijunDefault  = lblLang == "Japanese" ? (lblLen == "Short" ? "Kj"   : "Kijun-sen")
              :                         (lblLen == "Short" ? "Base" : "Base Line")

ssaDefault    = lblLang == "Japanese" ? (lblLen == "Short" ? "SSA"    : "Senkou Span A")
              :                         (lblLen == "Short" ? "Lead A" : "Leading Span A")

ssbDefault    = lblLang == "Japanese" ? (lblLen == "Short" ? "SSB"    : "Senkou Span B")
              :                         (lblLen == "Short" ? "Lead B" : "Leading Span B")

chikouDefault = lblLang == "Japanese" ? (lblLen == "Short" ? "Ck"   : "Chikou Span")
              :                         (lblLen == "Short" ? "Ls"  : "Lagging Span")

kumoDefault   = lblLang == "Japanese" ? (lblLen == "Short" ? "Km"   : "Kumo")
              :                         (lblLen == "Short" ? "Cl"   : "Cloud")

tenkanTxt = showTenkan ? resolveText(tenkanInput, tenkanDefault) : ""
kijunTxt  = showKijun  ? resolveText(kijunInput,  kijunDefault)  : ""
ssaTxt    = showSSA    ? resolveText(ssaInput,    ssaDefault)    : ""
ssbTxt    = showSSB    ? resolveText(ssbInput,    ssbDefault)    : ""
chikouTxt = showChikou ? resolveText(chikouInput, chikouDefault) : ""
kumoTxt   = showKumoT  ? resolveText(kumoInput,   kumoDefault)   : ""

// Append TF tag
tfShown = prettyTF(tfToUse)
tfTag   = (showLblTF and str.length(tfShown) > 0) ? (" " + tfShown) : ""
tenkanTxt := tenkanTxt + tfTag
kijunTxt  := kijunTxt  + tfTag
ssaTxt    := ssaTxt    + tfTag
ssbTxt    := ssbTxt    + tfTag
chikouTxt := chikouTxt + tfTag
kumoTxt   := kumoTxt   + tfTag

// ─────────────────────────────────────────────────────────────
// Projection — No New Extremes (conditional lines)
grpProj = "========== Projection — No New High / Low ========="

showProjLines = input.bool(true,
     title="Show projection lines",
     tooltip="Draws projection lines assuming the next N candles do not create new highs or lows relative to the current lookback window.\nScenario tool, not a prediction.",
     group=grpProj)

projStyleOpt = input.string("Dotted",
     title="Projection style",
     options=["Solid","Dashed","Dotted"],
     tooltip="Line style used for ALL projection lines.",
     group=grpProj)

projWidth = input.int(2,
     title="Thickness",
     minval=1, maxval=5,
     tooltip="Line thickness used for ALL projection lines.",
     group=grpProj)

projStyle = toLineStyle(projStyleOpt)

// Per-line
projTenkanOn   = input.bool(true,  title="Tenkan projection", tooltip="Enable or disable Tenkan-sen projection line.", group=grpProj)
projTenkanStep = input.int(5,      title="Tenkan steps (max 5)",      minval=1, maxval=5,  tooltip="Number of future Tenkan-sen segments to draw (max 5).", group=grpProj)

projKijunOn    = input.bool(true,  title="Kijun projection",  tooltip="Enable or disable Kijun-sen projection line.", group=grpProj)
projKijunStep  = input.int(13,     title="Kijun steps (max 13)",       minval=1, maxval=13, tooltip="Number of future Kijun-sen segments to draw (max 13).", group=grpProj)

projSSAOn      = input.bool(true,  title="SSA projection",    tooltip="Enable or disable Senkou Span A projection line (derived from projected Tenkan-sen and Kijun-sen).", group=grpProj)
projSSAStep    = input.int(10,      title="SSA steps (max 10)",         minval=1, maxval=10, tooltip="Number of future Senkou Span A segments to draw (max 10).", group=grpProj)

projSSBOn      = input.bool(true,  title="SSB projection",    tooltip="Enable or disable Senkou Span B projection line.", group=grpProj)
projSSBStep    = input.int(20,     title="SSB steps (max 20)",         minval=1, maxval=20, tooltip="Number of future Senkou Span B segments to draw (max 20).", group=grpProj)

// ─────────────────────────────────────────────────────────────
// Calculations + projections inputs (precomputed)
[tenkanTF, kijunTF, ssaTF, ssbTF, closeTF,
 tk1, tk2, tk3, tk4, tk5, tk6, tk7, tk8, tk9, tk10,
 kj1, kj2, kj3, kj4, kj5, kj6, kj7, kj8, kj9, kj10, kj11, kj12, kj13,
 sb1, sb2, sb3, sb4, sb5, sb6, sb7, sb8, sb9, sb10, sb11, sb12, sb13, sb14, sb15, sb16, sb17, sb18, sb19, sb20] = request.security(
        syminfo.tickerid,
        tfToUse,
        [donchian(conversionPeriods),
         donchian(basePeriods),
         math.avg(donchian(conversionPeriods), donchian(basePeriods)),
         donchian(laggingSpan2Periods),
         close,
         // Tenkan projected inputs (1..10)
         donchian(safeLen(conversionPeriods - 1)),  donchian(safeLen(conversionPeriods - 2)),  donchian(safeLen(conversionPeriods - 3)),  donchian(safeLen(conversionPeriods - 4)),  donchian(safeLen(conversionPeriods - 5)),
         donchian(safeLen(conversionPeriods - 6)),  donchian(safeLen(conversionPeriods - 7)),  donchian(safeLen(conversionPeriods - 8)),  donchian(safeLen(conversionPeriods - 9)),  donchian(safeLen(conversionPeriods - 10)),
         // Kijun projected inputs (1..13) (unchanged)
         donchian(safeLen(basePeriods - 1)), donchian(safeLen(basePeriods - 2)), donchian(safeLen(basePeriods - 3)), donchian(safeLen(basePeriods - 4)), donchian(safeLen(basePeriods - 5)),
         donchian(safeLen(basePeriods - 6)), donchian(safeLen(basePeriods - 7)), donchian(safeLen(basePeriods - 8)), donchian(safeLen(basePeriods - 9)), donchian(safeLen(basePeriods - 10)),
         donchian(safeLen(basePeriods - 11)), donchian(safeLen(basePeriods - 12)), donchian(safeLen(basePeriods - 13)),
         // SSB projected inputs (1..15) (unchanged)
         donchian(safeLen(laggingSpan2Periods - 1)), donchian(safeLen(laggingSpan2Periods - 2)), donchian(safeLen(laggingSpan2Periods - 3)), donchian(safeLen(laggingSpan2Periods - 4)), donchian(safeLen(laggingSpan2Periods - 5)),
         donchian(safeLen(laggingSpan2Periods - 6)), donchian(safeLen(laggingSpan2Periods - 7)), donchian(safeLen(laggingSpan2Periods - 8)), donchian(safeLen(laggingSpan2Periods - 9)), donchian(safeLen(laggingSpan2Periods - 10)),
         donchian(safeLen(laggingSpan2Periods - 11)), donchian(safeLen(laggingSpan2Periods - 12)), donchian(safeLen(laggingSpan2Periods - 13)), donchian(safeLen(laggingSpan2Periods - 14)), donchian(safeLen(laggingSpan2Periods - 15)),
         donchian(safeLen(laggingSpan2Periods - 16)), donchian(safeLen(laggingSpan2Periods - 17)), donchian(safeLen(laggingSpan2Periods - 18)), donchian(safeLen(laggingSpan2Periods - 19)), donchian(safeLen(laggingSpan2Periods - 20))],
        barmerge.gaps_off,
        barmerge.lookahead_off
    )

conversionLine = tenkanTF
baseLine       = kijunTF
leadLine1      = ssaTF
leadLine2      = ssbTF

// SSA projection from projected Tenkan/Kijun (1..10)
sa1  = math.avg(tk1,  kj1)
sa2  = math.avg(tk2,  kj2)
sa3  = math.avg(tk3,  kj3)
sa4  = math.avg(tk4,  kj4)
sa5  = math.avg(tk5,  kj5)
sa6  = math.avg(tk6,  kj6)
sa7  = math.avg(tk7,  kj7)
sa8  = math.avg(tk8,  kj8)
sa9  = math.avg(tk9,  kj9)
sa10 = math.avg(tk10, kj10)

// ─────────────────────────────────────────────────────────────
// MAIN PLOTS
plot(conversionLine, title="Tenkan-sen",  color=colTenkan, editable=true)
plot(baseLine,       title="Kijun-sen",   color=colKijun,  editable=true)
plot(closeTF,        title="Chikou Span", color=colChikou, offset=-dispBars, editable=true)

p1 = plot(leadLine1, title="Senkou Span A", color=colSSA, offset=dispBars, editable=true)
p2 = plot(leadLine2, title="Senkou Span B", color=colSSB, offset=dispBars, editable=true)

// Kumo fill color with toggles
bull = leadLine1 > leadLine2
kumoFillColor = showKumo ? (bull ? colKumoBull : colKumoBear) : na
fill(p1, p2, title="Kumo", color=kumoFillColor)

// ─────────────────────────────────────────────────────────────
// Projection lines (segments, last bar only)
delLine(l) =>
    if not na(l)
        line.delete(l)

var line tkL1 = na
var line tkL2 = na
var line tkL3 = na
var line tkL4 = na
var line tkL5 = na

var line kjL1  = na
var line kjL2  = na
var line kjL3  = na
var line kjL4  = na
var line kjL5  = na
var line kjL6  = na
var line kjL7  = na
var line kjL8  = na
var line kjL9  = na
var line kjL10 = na
var line kjL11 = na
var line kjL12 = na
var line kjL13 = na

var line saL1  = na
var line saL2  = na
var line saL3  = na
var line saL4  = na
var line saL5  = na
var line saL6  = na
var line saL7  = na
var line saL8  = na
var line saL9  = na
var line saL10 = na

var line sbL1  = na
var line sbL2  = na
var line sbL3  = na
var line sbL4  = na
var line sbL5  = na
var line sbL6  = na
var line sbL7  = na
var line sbL8  = na
var line sbL9  = na
var line sbL10 = na
var line sbL11 = na
var line sbL12 = na
var line sbL13 = na
var line sbL14 = na
var line sbL15 = na
var line sbL16 = na
var line sbL17 = na
var line sbL18 = na
var line sbL19 = na
var line sbL20 = na

clearProjLines() =>
    delLine(tkL1), delLine(tkL2), delLine(tkL3), delLine(tkL4), delLine(tkL5)
    delLine(kjL1), delLine(kjL2), delLine(kjL3), delLine(kjL4), delLine(kjL5), delLine(kjL6), delLine(kjL7), delLine(kjL8), delLine(kjL9), delLine(kjL10), delLine(kjL11), delLine(kjL12), delLine(kjL13)
    delLine(saL1), delLine(saL2), delLine(saL3), delLine(saL4), delLine(saL5), delLine(saL6), delLine(saL7), delLine(saL8), delLine(saL9), delLine(saL10)
    delLine(sbL1), delLine(sbL2), delLine(sbL3), delLine(sbL4), delLine(sbL5), delLine(sbL6), delLine(sbL7), delLine(sbL8), delLine(sbL9), delLine(sbL10), delLine(sbL11), delLine(sbL12), delLine(sbL13), delLine(sbL14), delLine(sbL15), delLine(sbL16), delLine(sbL17), delLine(sbL18), delLine(sbL19), delLine(sbL20)

var bool prevShowProj = false

if barstate.islast
    if prevShowProj and not showProjLines
        clearProjLines()
        tkL1 := na, tkL2 := na, tkL3 := na, tkL4 := na, tkL5 := na
        kjL1 := na, kjL2 := na, kjL3 := na, kjL4 := na, kjL5 := na, kjL6 := na, kjL7 := na, kjL8 := na, kjL9 := na, kjL10 := na, kjL11 := na, kjL12 := na, kjL13 := na
        saL1 := na, saL2 := na, saL3 := na, saL4 := na, saL5 := na, saL6 := na, saL7 := na, saL8 := na, saL9 := na, saL10 := na
        sbL1 := na, sbL2 := na, sbL3 := na, sbL4 := na, sbL5 := na, sbL6 := na, sbL7 := na, sbL8 := na, sbL9 := na, sbL10 := na, sbL11 := na, sbL12 := na, sbL13 := na, sbL14 := na, sbL15 := na, sbL16 := na, sbL17 := na, sbL18 := na, sbL19 := na, sbL20 := na  

    if showProjLines
        clearProjLines()

        int x0   = bar_index
        int xSA0 = bar_index + dispBars

        int o1  = stepToChartBars(1)
        int o2  = stepToChartBars(2)
        int o3  = stepToChartBars(3)
        int o4  = stepToChartBars(4)
        int o5  = stepToChartBars(5)
        int o6  = stepToChartBars(6)
        int o7  = stepToChartBars(7)
        int o8  = stepToChartBars(8)
        int o9  = stepToChartBars(9)
        int o10 = stepToChartBars(10)
        int o11 = stepToChartBars(11)
        int o12 = stepToChartBars(12)
        int o13 = stepToChartBars(13)
        int o14 = stepToChartBars(14)
        int o15 = stepToChartBars(15)
        int o16 = stepToChartBars(16)
        int o17 = stepToChartBars(17)
        int o18 = stepToChartBars(18)
        int o19 = stepToChartBars(19)
        int o20 = stepToChartBars(20)

        // Tenkan (max 5)
        int tSteps = projTenkanStep
        if projTenkanOn and tSteps >= 1
            tkL1 := line.new(x1=x0,    y1=conversionLine, x2=x0+o1, y2=tk1, xloc=xloc.bar_index, extend=extend.none, color=colTenkan, style=projStyle, width=projWidth)
        if projTenkanOn and tSteps >= 2
            tkL2 := line.new(x1=x0+o1, y1=tk1,           x2=x0+o2, y2=tk2, xloc=xloc.bar_index, extend=extend.none, color=colTenkan, style=projStyle, width=projWidth)
        if projTenkanOn and tSteps >= 3
            tkL3 := line.new(x1=x0+o2, y1=tk2,           x2=x0+o3, y2=tk3, xloc=xloc.bar_index, extend=extend.none, color=colTenkan, style=projStyle, width=projWidth)
        if projTenkanOn and tSteps >= 4
            tkL4 := line.new(x1=x0+o3, y1=tk3, x2=x0+o4, y2=tk4, xloc=xloc.bar_index, extend=extend.none, color=colTenkan, style=projStyle, width=projWidth)
        if projTenkanOn and tSteps >= 5
            tkL5 := line.new(x1=x0+o4, y1=tk4,           x2=x0+o5, y2=tk5, xloc=xloc.bar_index, extend=extend.none, color=colTenkan, style=projStyle, width=projWidth)

        // Kijun (max 13)
        int kSteps = projKijunStep
        if projKijunOn and kSteps >= 1
            kjL1 := line.new(x1=x0,     y1=baseLine, x2=x0+o1,  y2=kj1,  xloc=xloc.bar_index, extend=extend.none, color=colKijun, style=projStyle, width=projWidth)
        if projKijunOn and kSteps >= 2
            kjL2 := line.new(x1=x0+o1,  y1=kj1,     x2=x0+o2,  y2=kj2,  xloc=xloc.bar_index, extend=extend.none, color=colKijun, style=projStyle, width=projWidth)
        if projKijunOn and kSteps >= 3
            kjL3 := line.new(x1=x0+o2,  y1=kj2,     x2=x0+o3,  y2=kj3,  xloc=xloc.bar_index, extend=extend.none, color=colKijun, style=projStyle, width=projWidth)
        if projKijunOn and kSteps >= 4
            kjL4 := line.new(x1=x0+o3,  y1=kj3,     x2=x0+o4,  y2=kj4,  xloc=xloc.bar_index, extend=extend.none, color=colKijun, style=projStyle, width=projWidth)
        if projKijunOn and kSteps >= 5
            kjL5 := line.new(x1=x0+o4,  y1=kj4,     x2=x0+o5,  y2=kj5,  xloc=xloc.bar_index, extend=extend.none, color=colKijun, style=projStyle, width=projWidth)
        if projKijunOn and kSteps >= 6
            kjL6 := line.new(x1=x0+o5,  y1=kj5,     x2=x0+o6,  y2=kj6,  xloc=xloc.bar_index, extend=extend.none, color=colKijun, style=projStyle, width=projWidth)
        if projKijunOn and kSteps >= 7
            kjL7 := line.new(x1=x0+o6,  y1=kj6,     x2=x0+o7,  y2=kj7,  xloc=xloc.bar_index, extend=extend.none, color=colKijun, style=projStyle, width=projWidth)
        if projKijunOn and kSteps >= 8
            kjL8 := line.new(x1=x0+o7,  y1=kj7,     x2=x0+o8,  y2=kj8,  xloc=xloc.bar_index, extend=extend.none, color=colKijun, style=projStyle, width=projWidth)
        if projKijunOn and kSteps >= 9
            kjL9 := line.new(x1=x0+o8,  y1=kj8,     x2=x0+o9,  y2=kj9,  xloc=xloc.bar_index, extend=extend.none, color=colKijun, style=projStyle, width=projWidth)
        if projKijunOn and kSteps >= 10
            kjL10 := line.new(x1=x0+o9,  y1=kj9,    x2=x0+o10, y2=kj10, xloc=xloc.bar_index, extend=extend.none, color=colKijun, style=projStyle, width=projWidth)
        if projKijunOn and kSteps >= 11
            kjL11 := line.new(x1=x0+o10, y1=kj10,   x2=x0+o11, y2=kj11, xloc=xloc.bar_index, extend=extend.none, color=colKijun, style=projStyle, width=projWidth)
        if projKijunOn and kSteps >= 12
            kjL12 := line.new(x1=x0+o11, y1=kj11,   x2=x0+o12, y2=kj12, xloc=xloc.bar_index, extend=extend.none, color=colKijun, style=projStyle, width=projWidth)
        if projKijunOn and kSteps >= 13
            kjL13 := line.new(x1=x0+o12, y1=kj12,   x2=x0+o13, y2=kj13, xloc=xloc.bar_index, extend=extend.none, color=colKijun, style=projStyle, width=projWidth)

        // SSA (max 10) 
        int aSteps = projSSAStep
        if projSSAOn and aSteps >= 1
            saL1 := line.new(x1=xSA0,    y1=leadLine1, x2=xSA0+o1, y2=sa1,  xloc=xloc.bar_index, extend=extend.none, color=colSSA, style=projStyle, width=projWidth)
        if projSSAOn and aSteps >= 2
            saL2 := line.new(x1=xSA0+o1, y1=sa1,      x2=xSA0+o2, y2=sa2,  xloc=xloc.bar_index, extend=extend.none, color=colSSA, style=projStyle, width=projWidth)
        if projSSAOn and aSteps >= 3
            saL3 := line.new(x1=xSA0+o2, y1=sa2,      x2=xSA0+o3, y2=sa3,  xloc=xloc.bar_index, extend=extend.none, color=colSSA, style=projStyle, width=projWidth)
        if projSSAOn and aSteps >= 4
            saL4 := line.new(x1=xSA0+o3, y1=sa3,      x2=xSA0+o4, y2=sa4,  xloc=xloc.bar_index, extend=extend.none, color=colSSA, style=projStyle, width=projWidth)
        if projSSAOn and aSteps >= 5
            saL5 := line.new(x1=xSA0+o4, y1=sa4,      x2=xSA0+o5, y2=sa5,  xloc=xloc.bar_index, extend=extend.none, color=colSSA, style=projStyle, width=projWidth)
        if projSSAOn and aSteps >= 6
            saL6 := line.new(x1=xSA0+o5, y1=sa5,      x2=xSA0+o6, y2=sa6,  xloc=xloc.bar_index, extend=extend.none, color=colSSA, style=projStyle, width=projWidth)
        if projSSAOn and aSteps >= 7
            saL7 := line.new(x1=xSA0+o6, y1=sa6,      x2=xSA0+o7, y2=sa7,  xloc=xloc.bar_index, extend=extend.none, color=colSSA, style=projStyle, width=projWidth)
        if projSSAOn and aSteps >= 8
            saL8 := line.new(x1=xSA0+o7, y1=sa7,      x2=xSA0+o8, y2=sa8,  xloc=xloc.bar_index, extend=extend.none, color=colSSA, style=projStyle, width=projWidth)
        if projSSAOn and aSteps >= 9
            saL9 := line.new(x1=xSA0+o8, y1=sa8,      x2=xSA0+o9, y2=sa9,  xloc=xloc.bar_index, extend=extend.none, color=colSSA, style=projStyle, width=projWidth)
        if projSSAOn and aSteps >= 10
            saL10 := line.new(x1=xSA0+o9, y1=sa9,     x2=xSA0+o10, y2=sa10, xloc=xloc.bar_index, extend=extend.none, color=colSSA, style=projStyle, width=projWidth)

        // SSB (max 15)
        int bSteps = projSSBStep
        if projSSBOn and bSteps >= 1
            sbL1 := line.new(x1=xSA0,    y1=leadLine2, x2=xSA0+o1,  y2=sb1,  xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 2
            sbL2 := line.new(x1=xSA0+o1, y1=sb1,      x2=xSA0+o2,  y2=sb2,  xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 3
            sbL3 := line.new(x1=xSA0+o2, y1=sb2,      x2=xSA0+o3,  y2=sb3,  xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 4
            sbL4 := line.new(x1=xSA0+o3, y1=sb3,      x2=xSA0+o4,  y2=sb4,  xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 5
            sbL5 := line.new(x1=xSA0+o4, y1=sb4,      x2=xSA0+o5,  y2=sb5,  xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 6
            sbL6 := line.new(x1=xSA0+o5, y1=sb5,      x2=xSA0+o6,  y2=sb6,  xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 7
            sbL7 := line.new(x1=xSA0+o6, y1=sb6,      x2=xSA0+o7,  y2=sb7,  xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 8
            sbL8 := line.new(x1=xSA0+o7, y1=sb7,      x2=xSA0+o8,  y2=sb8,  xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 9
            sbL9 := line.new(x1=xSA0+o8, y1=sb8,      x2=xSA0+o9,  y2=sb9,  xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 10
            sbL10 := line.new(x1=xSA0+o9,  y1=sb9,    x2=xSA0+o10, y2=sb10, xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 11
            sbL11 := line.new(x1=xSA0+o10, y1=sb10,   x2=xSA0+o11, y2=sb11, xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 12
            sbL12 := line.new(x1=xSA0+o11, y1=sb11,   x2=xSA0+o12, y2=sb12, xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 13
            sbL13 := line.new(x1=xSA0+o12, y1=sb12,   x2=xSA0+o13, y2=sb13, xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 14
            sbL14 := line.new(x1=xSA0+o13, y1=sb13,   x2=xSA0+o14, y2=sb14, xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 15
            sbL15 := line.new(x1=xSA0+o14, y1=sb14,   x2=xSA0+o15, y2=sb15, xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 16
            sbL16 := line.new(x1=xSA0+o15, y1=sb15,   x2=xSA0+o16, y2=sb16, xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 17
            sbL17 := line.new(x1=xSA0+o16, y1=sb16,   x2=xSA0+o17, y2=sb17, xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 18
            sbL18 := line.new(x1=xSA0+o17, y1=sb17,   x2=xSA0+o18, y2=sb18, xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 19
            sbL19 := line.new(x1=xSA0+o18, y1=sb18,   x2=xSA0+o19, y2=sb19, xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)
        if projSSBOn and bSteps >= 20
            sbL20 := line.new(x1=xSA0+o19, y1=sb19,   x2=xSA0+o20, y2=sb20, xloc=xloc.bar_index, extend=extend.none, color=colSSB, style=projStyle, width=projWidth)

    prevShowProj := showProjLines

// ─────────────────────────────────────────────────────────────
// Flat Levels — Past Equilibrium Rays (EXACT ONLY)
grpFlat = "========== Flat Levels — Past Equilibrium =========="

showFlatLevels = input.bool(true,
     title="Show flat levels (past S/R rays)",
     tooltip="Draws horizontal rays from past flat Ichimoku segments (“equilibrium shelves”).\nThese levels can act as future support/resistance.",
     group=grpFlat)

flatTenkanOn = input.bool(false, title="Show Tenkan-sen flats", tooltip="Detect and extend past flat Tenkan-sen levels.", group=grpFlat)
flatKijunOn  = input.bool(true,  title="Show Kijun-sen flats",  tooltip="Detect and extend past flat Kijun-sen levels.", group=grpFlat)
flatSSAOn    = input.bool(false, title="Show Senkou Span A flats",    tooltip="Detect and extend past flat Senkou Span A levels.", group=grpFlat)
flatSSBOn    = input.bool(true,  title="Show Senkou Span B flats",    tooltip="Detect and extend past flat Senkou Span B levels.", group=grpFlat)

minFlatLen   = input.int(3, title="Min flat length (bars)", minval=2, maxval=100, tooltip="Minimum number of consecutive bars with the same value to qualify as a 'flat level'.", group=grpFlat)

flatLookback  = input.int(250, title="Lookback window (bars)", minval=50, maxval=1000, tooltip="Only consider flat levels that ended within the last N bars.", group=grpFlat)

flatMaxLevels = input.int(5, title="Max levels to display", minval=1, maxval=80, tooltip="Maximum number of flat levels to draw.\nLevels are chosen by closeness to current price.", group=grpFlat)

flatStyleOpt = input.string("Dotted", title="Ray style", options=["Solid","Dashed","Dotted"], tooltip="Line style for flat level rays.", group=grpFlat)
flatWidth    = input.int(2, title="Ray thickness", minval=1, maxval=5, tooltip="Line thickness for flat level rays.", group=grpFlat)

flatColorMode = input.string("By line color", title="Color mode", options=["By line color","Support/Resistance"], tooltip="By line color: Tenkan-sen, Kijun-sen, Senkou Span A, Senkou Span B use their main colors.\nSupport/Resistance: levels below price are green, above price are red.", group=grpFlat)

flatSupColor = input.color(color.rgb(0, 150, 136), title="Support color (S/R mode)", group=grpFlat)
flatResColor = input.color(color.new(color.red,  0), title="Resistance color (S/R mode)", group=grpFlat)

flatLineStyle = toLineStyle(flatStyleOpt)

// ─────────────────────────────────────────────────────────────
// Panel 2 — Flat Levels Labels
grpFlatLbl = "=============== Flat Levels Labels ================"

// 1) Master
showFlatLabels = input.bool(true,
     title="Show flat level labels",
     tooltip="Adds a label on the far-right side of each displayed flat ray.",
     group=grpFlatLbl)

// 2) Content (DEFAULTS: Japanese + Short)
flatLblLang = input.string("Japanese",
     title="Label language",
     options=["Japanese","English"],
     tooltip="Japanese = romanized Ichimoku terms.\nEnglish = common English terminology.\n\nTenkan-sen = Conversion Line\nKijun-sen = Base Line\nSenkou Span A = Leading Span A\nSenkou Span B = Leading Span B\nChikou Span = Lagging Span\nKumo = Cloud",
     group=grpFlatLbl)

flatLblLen = input.string("Short",
     title="Label length",
     options=["Full","Short"],
     tooltip="Full = complete names. Short = abbreviations. \n\nJapanese:\nTenkan-sen → Tk\nKijun-sen → Kj\nSenkou Span A → SSA\nSenkou Span B → SSB\nChikou Span → Ck\nKumo → Km\n\nEnglish:\nConversion Line → Conv\nBase Line → Base\nLeading Span A → Lead A\nLeading Span B → Lead B\nLagging Span → Ls\nCloud → Cl",
     group=grpFlatLbl)

flatShowTF   = input.bool(false,
     title="Show timeframe on flat labels",
     tooltip="Adds the calculation timeframe (e.g., 15m, 4h) to each flat label.",
     group=grpFlatLbl)

flatShowVal  = input.bool(false,
     title="Show values on flat labels",
     tooltip="Appends the price level value to each flat label.",
     group=grpFlatLbl)

// 3) Style (DEFAULT: Label + text)
flatLblDisplayMode = input.string("Label + text",
     title="Label display",
     options=["Label + text","Text only"],
     tooltip="Label + text: boxed label.\nText only: plain text (no box/arrow).",
     group=grpFlatLbl)

flatLblTextColor   = input.color(color.white,
     title="Label text color",
     tooltip="Only used in Label + text mode. In Text only mode, text follows the ray color.",
     group=grpFlatLbl)

flatLblSizeOpt     = input.string("Normal",
     title="Label size",
     options=["Tiny","Small","Normal","Large","Huge"],
     tooltip="Select label text size.",
     group=grpFlatLbl)

// 4) Position (DEFAULT offset 50, and ALL aligned on same far-right x)
flatRightOffsetBars = input.int(50,
     title="Far-right offset (bars)",
     minval=1, maxval=500,
     tooltip="How far to the right (in bars) flat labels should be placed.\nAll flat labels share the same far-right x-position.",
     group=grpFlatLbl)

flatTextOnly = (flatLblDisplayMode == "Text only")

flatLblSize =
     flatLblSizeOpt == "Tiny"   ? size.tiny   :
     flatLblSizeOpt == "Small"  ? size.small  :
     flatLblSizeOpt == "Normal" ? size.normal :
     flatLblSizeOpt == "Large"  ? size.large  : size.huge

flatLblStyle() =>
    flatTextOnly ? label.style_none : label.style_label_left

flatLblBg(col) =>
    flatTextOnly ? color.new(col, 100) : col

// ─────────────────────────────────────────────────────────────
// Flat storage
var float[] flatPrices   = array.new_float()
var int[]   flatEnds     = array.new_int()
var int[]   flatStrength = array.new_int()
var int[]   flatSrc      = array.new_int()  // 1=TK,2=KJ,3=SSA,4=SSB

maxStored = 250

srcColor(src) =>
    src == 1 ? colTenkan : src == 2 ? colKijun : src == 3 ? colSSA : colSSB

addFlatLevel(price, endIdx, strength, src) =>
    bool merged = false
    int n = array.size(flatPrices)

    if n > 0
        for i = 0 to n - 1
            float p = array.get(flatPrices, i)
            if p == price
                int sOld = array.get(flatStrength, i)
                int eOld = array.get(flatEnds, i)
                if strength > sOld or endIdx > eOld
                    array.set(flatPrices, i, price)
                    array.set(flatEnds, i, endIdx)
                    array.set(flatStrength, i, strength)
                    array.set(flatSrc, i, src)
                merged := true
                break

    if not merged
        array.push(flatPrices, price)
        array.push(flatEnds, endIdx)
        array.push(flatStrength, strength)
        array.push(flatSrc, src)

    if array.size(flatPrices) > maxStored
        array.shift(flatPrices)
        array.shift(flatEnds)
        array.shift(flatStrength)
        array.shift(flatSrc)

trackFlats(val, enabled, src, prevCount) =>
    int count = prevCount
    bool isFlatNow = enabled and not na(val) and not na(val[1]) and (val == val[1])

    if isFlatNow
        count += 1
    else
        if enabled and count >= minFlatLen
            int endIdx = bar_index - 1
            float level = val[1]
            if endIdx >= 0
                addFlatLevel(level, endIdx, count, src)
        count := 0

    count

var int tkFlatCount  = 0
var int kjFlatCount  = 0
var int saFlatCount  = 0
var int sbFlatCount  = 0

tkFlatCount := trackFlats(conversionLine, flatTenkanOn, 1, tkFlatCount)
kjFlatCount := trackFlats(baseLine,       flatKijunOn,  2, kjFlatCount)
saFlatCount := trackFlats(leadLine1,      flatSSAOn,    3, saFlatCount)
sbFlatCount := trackFlats(leadLine2,      flatSSBOn,    4, sbFlatCount)

var line[]  flatLines = array.new_line()
var label[] flatLbls  = array.new_label()

clearFlatLinesAndLabels() =>
    int m = array.size(flatLines)
    if m > 0
        for i = 0 to m - 1
            line l = array.get(flatLines, i)
            if not na(l)
                line.delete(l)
    array.clear(flatLines)

    int k = array.size(flatLbls)
    if k > 0
        for i = 0 to k - 1
            label lb = array.get(flatLbls, i)
            if not na(lb)
                label.delete(lb)
    array.clear(flatLbls)

pickColor(levelPrice, src) =>
    flatColorMode == "Support/Resistance" ? (levelPrice <= close ? flatSupColor : flatResColor) : srcColor(src)

// Flat label base names (Japanese = romanized; NO Japanese characters)
// Suffix always uses full word "flat"
flatTenkanBase = flatLblLang == "Japanese" ? (flatLblLen == "Short" ? "Tk"      : "Tenkan-sen")
               :                             (flatLblLen == "Short" ? "Conv"    : "Conversion Line")

flatKijunBase  = flatLblLang == "Japanese" ? (flatLblLen == "Short" ? "Kj"      : "Kijun-sen")
               :                             (flatLblLen == "Short" ? "Base"    : "Base Line")

flatSSABase    = flatLblLang == "Japanese" ? (flatLblLen == "Short" ? "SSA"     : "Senkou Span A")
               :                             (flatLblLen == "Short" ? "Lead A"  : "Leading Span A")

flatSSBBase    = flatLblLang == "Japanese" ? (flatLblLen == "Short" ? "SSB"     : "Senkou Span B")
               :                             (flatLblLen == "Short" ? "Lead B"  : "Leading Span B")

flatSuffix = " flat"

flatBaseName(src) =>
    src == 1 ? flatTenkanBase :src == 2 ? flatKijunBase  :src == 3 ? flatSSABase    : flatSSBBase

makeFlatText(src, lvl) =>
    string t = flatBaseName(src) + flatSuffix
    string tfT = (flatShowTF and str.length(tfShown) > 0) ? (" " + tfShown) : ""
    string vT  = flatShowVal ? (" " + str.tostring(lvl, format.mintick)) : ""
    t + tfT + vT

if barstate.islast
    clearFlatLinesAndLabels()

    if showFlatLevels
        int n = array.size(flatPrices)
        if n > 0
            bool[] used = array.new_bool(n, false)

            int picked = 0
            while picked < flatMaxLevels
                float bestDist = na
                int bestIdx = na

                for i = 0 to n - 1
                    if not array.get(used, i)
                        int endIdx = array.get(flatEnds, i)
                        if bar_index - endIdx <= flatLookback
                            float p = array.get(flatPrices, i)
                            float d = math.abs(close - p)
                            if na(bestDist) or d < bestDist
                                bestDist := d
                                bestIdx := i

                if na(bestIdx)
                    break

                array.set(used, bestIdx, true)
                picked += 1

                float lvl  = array.get(flatPrices, bestIdx)
                int endIdx = array.get(flatEnds, bestIdx)
                int src    = array.get(flatSrc, bestIdx)
                color lnCol = pickColor(lvl, src)
                int shift = (src == 3 or src == 4) ? dispBars : 0
                int x1 = (endIdx) + shift
                int x2 = (bar_index) + shift

                // Safety (can happen very early in history)
                x1 := math.max(0, x1)
                x2 := math.max(x1 + 1, x2)

                line ln = line.new(
                    x1=x1, y1=lvl,
                    x2=x2, y2=lvl,
                    xloc=xloc.bar_index,
                    extend=extend.right,
                    color=lnCol,
                    style=flatLineStyle,
                    width=flatWidth
                )
                array.push(flatLines, ln)

                if showFlatLabels
                    int xLabel = bar_index + flatRightOffsetBars
                    float yLabel = lvl + (syminfo.mintick * 10)
                    string txt = makeFlatText(src, lvl)

                    label lb = label.new(
                        x=xLabel, y=yLabel,
                        text=txt,
                        xloc=xloc.bar_index, yloc=yloc.price,
                        style=flatLblStyle(),
                        color=flatLblBg(lnCol),
                        textcolor=(flatTextOnly ? lnCol : flatLblTextColor),
                        size=flatLblSize
                    )
                    array.push(flatLbls, lb)

// ─────────────────────────────────────────────────────────────
// Helpers for “End of projection” label mode
pickTk(step) => step <= 1 ? tk1 : step == 2 ? tk2 : step == 3 ? tk3 : step == 4 ? tk4 : step == 5 ? tk5 : step == 6 ? tk6 : step == 7 ? tk7 : step == 8 ? tk8 : step == 9 ? tk9 : tk10
pickKj(step) => step <= 1 ? kj1 : step == 2 ? kj2 : step == 3 ? kj3 : step == 4 ? kj4 : step == 5 ? kj5 : step == 6 ? kj6 : step == 7 ? kj7 : step == 8 ? kj8 : step == 9 ? kj9 : step == 10 ? kj10 : step == 11 ? kj11 : step == 12 ? kj12 : kj13
pickSa(step) => step <= 1 ? sa1 : step == 2 ? sa2 : step == 3 ? sa3 : step == 4 ? sa4 : step == 5 ? sa5 : step == 6 ? sa6 : step == 7 ? sa7 : step == 8 ? sa8 : step == 9 ? sa9 : sa10
pickSb(step) => step <= 1 ? sb1 : step == 2 ? sb2 : step == 3 ? sb3 : step == 4 ? sb4 : step == 5 ? sb5 : step == 6 ? sb6 : step == 7 ? sb7 : step == 8 ? sb8 : step == 9 ? sb9 : step == 10 ? sb10 : step == 11 ? sb11 : step == 12 ? sb12 : step == 13 ? sb13 : step == 14 ? sb14  : step == 15 ? sb15 : step == 16 ? sb16 : step == 17 ? sb17 : step == 18 ? sb18 : step == 19 ? sb19 : sb20

// ─────────────────────────────────────────────────────────────
// Line labels (Kumo label controlled ONLY via Custom Text: kumoInput="OFF")
var label tkLbl = na
var label kjLbl = na
var label ckLbl = na
var label saLbl = na
var label sbLbl = na
var label kmLbl = na

deleteIfExists(l) =>
    if not na(l)
        label.delete(l)

var bool prevShowLbl = false

kumoMainCol(bullish) =>
    bullish ? color.rgb(67, 160, 71) : color.rgb(244, 67, 54)

appendVal(txt, val) =>
    showLblVal and not na(val) ? (txt + " " + str.tostring(val, format.mintick)) : txt

if barstate.islast
    if prevShowLbl and not showLineLabels
        deleteIfExists(tkLbl), tkLbl := na
        deleteIfExists(kjLbl), kjLbl := na
        deleteIfExists(ckLbl), ckLbl := na
        deleteIfExists(saLbl), saLbl := na
        deleteIfExists(sbLbl), sbLbl := na
        deleteIfExists(kmLbl), kmLbl := na

    if showLineLabels
        deleteIfExists(tkLbl), tkLbl := na
        deleteIfExists(kjLbl), kjLbl := na
        deleteIfExists(ckLbl), ckLbl := na
        deleteIfExists(saLbl), saLbl := na
        deleteIfExists(sbLbl), sbLbl := na
        deleteIfExists(kmLbl), kmLbl := na

        int xNow  = bar_index + xOffsetBars
        int xFwd  = (bar_index + dispBars) + xOffsetBars
        int xBack = (bar_index - dispBars) + xOffsetBars

        float yTenkan = conversionLine
        float yKijun  = baseLine
        float ySSA    = leadLine1
        float ySSB    = leadLine2
        float yChikou = closeTF

        int xTenkan = xNow
        int xKijun  = xNow
        int xSSA    = xFwd
        int xSSB    = xFwd

        bool useProjX = (lblProjMode == "End of projection") and showProjLines

        if useProjX and projTenkanOn
            int tSteps = math.min(projTenkanStep, 5)
            xTenkan := bar_index + stepToChartBars(tSteps) + xOffsetBars
            yTenkan := pickTk(tSteps)

        if useProjX and projKijunOn
            int kSteps = math.min(projKijunStep, 13)
            xKijun := bar_index + stepToChartBars(kSteps) + xOffsetBars
            yKijun := pickKj(kSteps)

        if useProjX and projSSAOn
            int aSteps = math.min(projSSAStep, 10)
            xSSA := (bar_index + dispBars) + stepToChartBars(aSteps) + xOffsetBars
            ySSA := pickSa(aSteps)

        if useProjX and projSSBOn
            int bSteps = math.min(projSSBStep, 20)
            xSSB := (bar_index + dispBars) + stepToChartBars(bSteps) + xOffsetBars
            ySSB := pickSb(bSteps)

        string tTxt = appendVal(tenkanTxt, yTenkan)
        string kTxt = appendVal(kijunTxt,  yKijun)
        string aTxt = appendVal(ssaTxt,    ySSA)
        string bTxt = appendVal(ssbTxt,    ySSB)
        string cTxt = appendVal(chikouTxt, yChikou)
        string mTxt = kumoTxt

        if showTenkan and str.length(str.trim(tTxt)) > 0 and not na(yTenkan)
            tkLbl := label.new(x=xTenkan, y=yTenkan, text=tTxt, xloc=xloc.bar_index, yloc=yloc.price, style=lblStyle(), color=lblBg(colTenkan), textcolor=(textOnly ? colTenkan : labelTextColor), size=lblSize)
        if showKijun and str.length(str.trim(kTxt)) > 0 and not na(yKijun)
            kjLbl := label.new(x=xKijun,  y=yKijun,  text=kTxt, xloc=xloc.bar_index, yloc=yloc.price, style=lblStyle(), color=lblBg(colKijun), textcolor=(textOnly ? colKijun : labelTextColor), size=lblSize)
        if showSSA and str.length(str.trim(aTxt)) > 0 and not na(ySSA)
            saLbl := label.new(x=xSSA,    y=ySSA,    text=aTxt, xloc=xloc.bar_index, yloc=yloc.price, style=lblStyle(), color=lblBg(colSSA), textcolor=(textOnly ? colSSA : labelTextColor), size=lblSize)
        if showSSB and str.length(str.trim(bTxt)) > 0 and not na(ySSB)
            sbLbl := label.new(x=xSSB,    y=ySSB,    text=bTxt, xloc=xloc.bar_index, yloc=yloc.price, style=lblStyle(), color=lblBg(colSSB), textcolor=(textOnly ? colSSB : labelTextColor), size=lblSize)

        if showChikou and xBack >= 0 and str.length(str.trim(cTxt)) > 0 and not na(yChikou)
            ckLbl := label.new(x=xBack, y=yChikou, text=cTxt, xloc=xloc.bar_index, yloc=yloc.price, style=lblStyle(), color=lblBg(colChikou), textcolor=(textOnly ? colChikou : labelTextColor), size=lblSize)

        // Kumo label (INSIDE the actual cloud) — OFF by default via kumoInput="OFF"
        int kumoBackBars = 60
        int bSafe = math.min(kumoBackBars, bar_index)

        if showKumoT and str.length(str.trim(mTxt)) > 0 and not na(leadLine1) and not na(leadLine2)
            int xKumo = (bar_index + dispBars - bSafe) + xOffsetBars
            float aAt = leadLine1[bSafe]
            float bAt = leadLine2[bSafe]
            if not na(aAt) and not na(bAt)
                float yKumo = math.avg(aAt, bAt)
                color kmCol = kumoMainCol(aAt > bAt)
                kmLbl := label.new(
                    x=xKumo, y=yKumo,
                    text=mTxt,
                    xloc=xloc.bar_index, yloc=yloc.price,
                    style=lblStyle(),
                    color=lblBg(kmCol),
                    textcolor=(textOnly ? kmCol : labelTextColor),
                    size=lblSize
                )

    prevShowLbl := showLineLabels
