//@version=6
indicator("Tori Trend2.2 by PJPF - Confluence Optimized", overlay=true, max_lines_count=500)

// --- Memory Management ---
max_bars_back(low, 5000)
max_bars_back(high, 5000)
max_bars_back(time, 5000)

// --- Inputs ---
lookbackInput  = input.int(5000, "Historical Lookback (Max 5000)", minval=100, maxval=5000)
bullColor      = input.color(color.lime, "Support Lines")
bearColor      = input.color(color.red, "Resistance Lines")
lineWidth      = input.int(2, "Line Width", minval=1)
tolerancePips  = input.int(3, "Breach Tolerance (Pips)", minval=0)
showMarkers    = input.bool(true, "Show Hand-off Markers")
showTable      = input.bool(true, "Show Status Box")

// --- Confluence Inputs ---
useConfluence  = input.bool(true, "Enable Orange Confluence Mode", group="Confluence Settings")
confPips       = input.float(2.0, "Touch Proximity (Pips)", minval=0.1, step=0.1, group="Confluence Settings")
confMinHits    = input.int(3, "Min Touches for Orange", minval=2, group="Confluence Settings")
orangeColor    = input.color(color.orange, "Confluence Color", group="Confluence Settings")

// --- SMA Inputs ---
showSMA        = input.bool(true, "Show SMA Lines", group="Moving Averages")
sma1Length     = input.int(20, "SMA 1 Length", minval=1, group="Moving Averages")
sma1Color      = input.color(color.blue, "SMA 1 Color", group="Moving Averages")
sma2Length     = input.int(200, "SMA 2 Length", minval=1, group="Moving Averages")
sma2Color      = input.color(color.orange, "SMA 2 Color", group="Moving Averages")

// --- Calculations ---
sma1 = ta.sma(close, sma1Length)
sma2 = ta.sma(close, sma2Length)
plot(showSMA ? sma1 : na, "SMA 1", color=sma1Color, linewidth=1)
plot(showSMA ? sma2 : na, "SMA 2", color=sma2Color, linewidth=2)

float breachBuffer = tolerancePips * syminfo.mintick * 10
float confBuffer   = confPips * syminfo.mintick * 10
int actualLookback = math.min(last_bar_index - 10, lookbackInput - 10)

var line[] supportLines = array.new_line()
var line[] resistLines  = array.new_line()

if barstate.islast
    // Cleanup existing lines
    if array.size(supportLines) > 0
        for i = 0 to array.size(supportLines) - 1
            line.delete(array.get(supportLines, i))
        array.clear(supportLines)
    if array.size(resistLines) > 0
        for i = 0 to array.size(resistLines) - 1
            line.delete(array.get(resistLines, i))
        array.clear(resistLines)

    // 1. Identify Reversal Points
    int[] bullPivots = array.new_int()
    int[] bearPivots = array.new_int()
    
    int s1_Off = 0, r1_Off = 0
    float minVal = low[0], maxVal = high[0]

    for i = 1 to actualLookback
        if low[i] <= minVal
            minVal := low[i], s1_Off := i
        if high[i] >= maxVal
            maxVal := high[i], r1_Off := i
        if low[i] < low[i+1] and low[i] < low[i-1]
            array.push(bullPivots, i)
        if high[i] > high[i+1] and high[i] > high[i-1]
            array.push(bearPivots, i)

    // 2. Bullish Chaining with Confluence Logic
    if s1_Off != 0
        int cur_S1_Idx = bar_index - s1_Off
        float cur_S1_Price = minVal
        for i = array.size(bullPivots) - 1 to 0
            int s2_Off = array.get(bullPivots, i)
            if s2_Off < s1_Off and s2_Off < (bar_index - cur_S1_Idx)
                int s2_Idx = bar_index - s2_Off
                float s2_Price = low[s2_Off]
                if s2_Price > cur_S1_Price
                    float slope = (s2_Price - cur_S1_Price) / (s2_Idx - cur_S1_Idx)
                    bool broken = false
                    int touchCount = 0
                    
                    for k = 0 to actualLookback
                        float linePrice = cur_S1_Price + (slope * ((bar_index - k) - cur_S1_Idx))
                        // Check for breach
                        if (bar_index - k) > cur_S1_Idx and low[k] < linePrice - breachBuffer
                            broken := true
                            break
                        // Count touches for confluence (within proximity)
                        if math.abs(low[k] - linePrice) <= confBuffer or math.abs(high[k] - linePrice) <= confBuffer
                            touchCount += 1
                    
                    if not broken
                        color finalColor = (useConfluence and touchCount >= confMinHits) ? orangeColor : bullColor
                        ln = line.new(time[bar_index - cur_S1_Idx], cur_S1_Price, time[s2_Off], s2_Price, xloc=xloc.bar_time, extend=extend.right, color=finalColor, width=lineWidth)
                        array.push(supportLines, ln)
                        if showMarkers
                            label.new(bar_index - s2_Off, low[s2_Off], "S", color=finalColor, style=label.style_triangleup, size=size.tiny, yloc=yloc.belowbar)
                        cur_S1_Idx := s2_Idx
                        cur_S1_Price := s2_Price

    // 3. Bearish Chaining with Confluence Logic
    if r1_Off != 0
        int cur_R1_Idx = bar_index - r1_Off
        float cur_R1_Price = maxVal
        for i = array.size(bearPivots) - 1 to 0
            int r2_Off = array.get(bearPivots, i)
            if r2_Off < r1_Off and r2_Off < (bar_index - cur_R1_Idx)
                int r2_Idx = bar_index - r2_Off
                float r2_Price = high[r2_Off]
                if r2_Price < cur_R1_Price
                    float slope = (r2_Price - cur_R1_Price) / (r2_Idx - cur_R1_Idx)
                    bool broken = false
                    int touchCount = 0

                    for k = 0 to actualLookback
                        float linePrice = cur_R1_Price + (slope * ((bar_index - k) - cur_R1_Idx))
                        if (bar_index - k) > cur_R1_Idx and high[k] > linePrice + breachBuffer
                            broken := true
                            break
                        if math.abs(high[k] - linePrice) <= confBuffer or math.abs(low[k] - linePrice) <= confBuffer
                            touchCount += 1

                    if not broken
                        color finalColor = (useConfluence and touchCount >= confMinHits) ? orangeColor : bearColor
                        ln = line.new(time[bar_index - cur_R1_Idx], cur_R1_Price, time[r2_Off], r2_Price, xloc=xloc.bar_time, extend=extend.right, color=finalColor, width=lineWidth)
                        array.push(resistLines, ln)
                        if showMarkers
                            label.new(bar_index - r2_Off, high[r2_Off], "R", color=finalColor, style=label.style_triangledown, size=size.tiny, yloc=yloc.abovebar)
                        cur_R1_Idx := r2_Idx
                        cur_R1_Price := r2_Price

    // 4. Status Table Update
    if showTable
        var table dBox = table.new(position.top_right, 2, 3, bgcolor=color.new(color.black, 15), frame_color=color.gray, frame_width=2)
        table.cell(dBox, 0, 0, "SCAN DEPTH:", text_color=color.white)
        table.cell(dBox, 1, 0, str.tostring(actualLookback), text_color=color.aqua)
        table.cell(dBox, 0, 1, "TOTAL LINES:", text_color=color.gray)
        table.cell(dBox, 1, 1, str.tostring(array.size(supportLines) + array.size(resistLines)), text_color=color.yellow)
