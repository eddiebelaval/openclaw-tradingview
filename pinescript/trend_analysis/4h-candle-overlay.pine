//@version=5
//Created by XYXC (Bird) using Comet
indicator("4H Candle Overlay", overlay = true, max_boxes_count = 500, max_lines_count = 500)

fin_color     = input.color(color.black, "Finished candle color")
fin_width     = input.int(2, "Finished candle width", minval = 1)
fin_style_opt = input.string("solid", "Finished candle style", options = ["solid","dotted","dashed"])
dev_color     = input.color(color.black, "Developing candle color")
dev_width     = input.int(2, "Developing candle width", minval = 1)
dev_style_opt = input.string("solid", "Developing candle style", options = ["solid","dotted","dashed"])
 
f_style(s) => s == "dotted" ? line.style_dotted : s == "dashed" ? line.style_dashed : line.style_solid
fin_style = f_style(fin_style_opt)
dev_style = f_style(dev_style_opt)

bar_time = time
bar_hour = hour(bar_time, "UTC+1")

blk_index = switch
    bar_hour < 4 => 0
    bar_hour < 8 => 1
    bar_hour < 12 => 2
    bar_hour < 16 => 3
    bar_hour < 20 => 4
    bar_hour < 23 => 5
    => na
  
day_id      = dayofmonth(bar_time, "UTC+1")
comp_id     = na(blk_index) ? na : day_id * 10 + blk_index
new_block   = ta.change(comp_id) != 0 and not na(comp_id)

var float blkO = na
var float blkH = na
var float blkL = na
var float blkC = na
var int   blk_start = na

draw_finished(_left, _right, _O, _H, _L, _C) =>
    mid = math.round((_left + _right) * 0.5)
    body_top = math.max(_O, _C)
    body_bot = math.min(_O, _C)
    box.new(_left, body_top, _right, body_bot, border_color = fin_color, border_width = fin_width, bgcolor = color.new(fin_color, 100))
    if _H > body_top
        line.new(mid, _H, mid, body_top, color = fin_color, width = fin_width, style = fin_style)
    if body_bot > _L
        line.new(mid, body_bot, mid, _L, color = fin_color, width = fin_width, style = fin_style)

var box  dev_box   = na
var line dev_uwick = na
var line dev_lwick = na

if barstate.isfirst
    dev_box   := box.new(bar_index, close, bar_index, close, border_color = dev_color, border_width = dev_width, bgcolor = color.new(dev_color, 100))
    dev_uwick := line.new(bar_index, close, bar_index, close, color = dev_color, width = dev_width, style = dev_style)
    dev_lwick := line.new(bar_index, close, bar_index, close, color = dev_color, width = dev_width, style = dev_style)

if new_block
    if not na(blkO) and not na(blk_start)
        draw_finished(blk_start, bar_index - 1, blkO, blkH, blkL, blkC)
    blkO := open
    blkH := high
    blkL := low
    blkC := close
    blk_start := bar_index

if not na(comp_id)
    if na(blkO)
        blkO := open
        blkH := high
        blkL := low
        blkC := close
        blk_start := bar_index
    else
        blkH := math.max(blkH, high)
        blkL := math.min(blkL, low)
        blkC := close
    
    left_dev = blk_start
    tf_sec = timeframe.in_seconds()
    bars_4hr = math.max(1, math.round(14400 / tf_sec))
    max_future = 499
    right_dev = left_dev + math.min(bars_4hr - 1, max_future)
    mid_dev = math.round((left_dev + right_dev) * 0.5)
    body_top_d = math.max(blkO, blkC)
    body_bot_d = math.min(blkO, blkC)
    
    box.set_left(dev_box, left_dev)
    box.set_right(dev_box, right_dev)
    box.set_top(dev_box, body_top_d)
    box.set_bottom(dev_box, body_bot_d)
    box.set_border_color(dev_box, dev_color)
    box.set_border_width(dev_box, dev_width)
    box.set_bgcolor(dev_box, color.new(dev_color, 100))
    
    if blkH > body_top_d
        line.set_xy1(dev_uwick, mid_dev, blkH)
        line.set_xy2(dev_uwick, mid_dev, body_top_d)
        line.set_color(dev_uwick, dev_color)
        line.set_width(dev_uwick, dev_width)
        line.set_style(dev_uwick, dev_style)
    else
        line.set_x1(dev_uwick, na)
        line.set_y1(dev_uwick, na)
        line.set_x2(dev_uwick, na)
        line.set_y2(dev_uwick, na)
    
    if body_bot_d > blkL
        line.set_xy1(dev_lwick, mid_dev, body_bot_d)
        line.set_xy2(dev_lwick, mid_dev, blkL)
        line.set_color(dev_lwick, dev_color)
        line.set_width(dev_lwick, dev_width)
        line.set_style(dev_lwick, dev_style)
    else
        line.set_x1(dev_lwick, na)
        line.set_y1(dev_lwick, na)
        line.set_x2(dev_lwick, na)
        line.set_y2(dev_lwick, na)

if na(comp_id)
    blkO := na
    blkH := na
    blkL := na
    blkC := na
    blk_start := na
