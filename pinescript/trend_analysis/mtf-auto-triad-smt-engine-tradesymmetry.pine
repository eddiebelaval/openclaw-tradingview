//@version=6
indicator("MTF-Auto-Triad SMT Engine [TradeSymmetry]", shorttitle="SMT Triad", overlay=true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

//              ╔═══════════════════════════╗              //
//              ║    USER DEFINED INPUTS    ║              //
//              ╚═══════════════════════════╝              //

var string symbol_settings         = "════════ TPV Symbol Options ════════"
var string triad_group             = "════════ SMT Triad Auto-Select ════════"
var string smt_settings            = "════════ SMT Divergence Settings ════════"
var string mtf_settings            = "════════ SMT Multi-Timeframes ════════"
var string grp_b1                  = "════════ HTF Box 1 ════════"
var string grp_b2                  = "════════ HTF Box 2 ════════"
var string grp_b3                  = "════════ HTF Box 3 ════════"
var string velocity_settings       = "════════ Velocity Settings ════════"
var string color_settings          = "════════ TPV Color Options ════════"
var string table_settings          = "════════ TPV Info Table ════════"

// --- TPV Symbol Input ---
symbol_input = input.symbol("", "Base Symbol (For TPV & SMT Base)", 
     group = symbol_settings, 
     tooltip = "Leave blank to use the current chart's symbol. Select a ticker to view its candles colored by TPV in this panel.")

// --- Auto-Triad System ---
triad_mode = input.string("Auto-Detect", "Triad Mode", options=["Auto-Detect", "Indices", "Forex", "Metals", "Oil", "Manual"], group=triad_group, tooltip="Automatically selects correlated comparison symbols based on the current chart asset.\n\nTriad Systems Used:\n• Indices: NQ1!, ES1!, YM1!\n• Forex: EURUSD, GBPUSD, DXY\n• Metals: XAGUSD, XAUEUR, XAUGBP, GC1!\n• Oil: CL1!, RB1!, HO1!")

man_use1 = input.bool(true, 'Manual Sym 1', inline='m_sym1', group=triad_group)
man_sym1 = input.symbol('OANDA:XAGUSD', '', inline='m_sym1', group=triad_group)

man_use2 = input.bool(true, 'Manual Sym 2', inline='m_sym2', group=triad_group)
man_sym2 = input.symbol('COMEX_MINI:MGC1!', '', inline='m_sym2', group=triad_group)

man_use3 = input.bool(true, 'Manual Sym 3', inline='m_sym3', group=triad_group)
man_sym3 = input.symbol('OANDA:XAUEUR', '', inline='m_sym3', group=triad_group)

man_use4 = input.bool(true, 'Manual Sym 4', inline='m_sym4', group=triad_group)
man_sym4 = input.symbol('OANDA:XAUGBP', '', inline='m_sym4', group=triad_group)

// --- SMT Inputs ---
smt_length = input.int(3, 'Pivot Lookback', minval = 2, group = smt_settings)

smt_bullDivCss = input.color(#ff1100, 'Swing High Divergence Color', group = smt_settings)
smt_bearDivCss = input.color(#2157f3, 'Swing Low Divergence Color', group = smt_settings)

div_line_style_in = input.string('Solid', 'Divergence Line Style', options=['Solid', 'Dashed', 'Dotted'], group=smt_settings)
div_line_width    = input.int(2, 'Divergence Line Width', minval=1, maxval=5, group=smt_settings)
div_label_size_in = input.string('Normal', 'Divergence Label Size', options=['Tiny', 'Small', 'Normal', 'Large'], group=smt_settings)
smt_showPrice     = input.bool(false, 'Show Price in SMT Labels', group=smt_settings)
smt_shortLabels   = input.bool(false, 'Use Short Labels (e.g. XU)', group=smt_settings)

smt_showDash = input.bool(true, 'Show SMT Dashboard', group = smt_settings)
smt_dashLoc  = input.string('Bottom Right', 'SMT Table Location', options = ['Top Right', 'Bottom Right', 'Bottom Left'], group = smt_settings)
smt_textSize = input.string('Small', 'SMT Text Size', options = ['Tiny', 'Small', 'Normal'], group = smt_settings)

// --- SMT MTF Inputs ---
show_ltf_on_htf = input.bool(true, "Show LTF SMT on HTF Charts", group=mtf_settings, tooltip="If enabled, lower timeframe SMT divergences will project onto your higher timeframe chart.")

tf1_on = input.bool(true, "Show TF 1", inline="tf1", group=mtf_settings)
tf1    = input.timeframe("", "Timeframe", inline="tf1", group=mtf_settings, tooltip="Leave blank for Chart Timeframe")

tf2_on = input.bool(true, "Show TF 2", inline="tf2", group=mtf_settings)
tf2    = input.timeframe("3", "Timeframe", inline="tf2", group=mtf_settings)

tf3_on = input.bool(true, "Show TF 3", inline="tf3", group=mtf_settings)
tf3    = input.timeframe("5", "Timeframe", inline="tf3", group=mtf_settings)

tf4_on = input.bool(false, "Show TF 4", inline="tf4", group=mtf_settings)
tf4    = input.timeframe("15", "Timeframe", inline="tf4", group=mtf_settings)

tf5_on = input.bool(false, "Show TF 5", inline="tf5", group=mtf_settings)
tf5    = input.timeframe("60", "Timeframe", inline="tf5", group=mtf_settings)

// ========================================================================= //
// ========================= HTF BOX 1 SETTINGS ============================ //
htfCndl1  = input.bool(true, 'Enable HTF Box 1', inline='T1', group=grp_b1)
htfUser1  = input.string('4 Hours', 'TF', options=['3 Mins', '5 Mins', '10 Mins', '15 Mins', '30 Mins', '45 Mins', '1 Hour', '2 Hours', '3 Hours', '4 Hours', '1 Day', '1 Week', '1 Month', '3 Months', '6 Months', '1 Year'], inline='T1', group=grp_b1)
b1_bullC  = input.color(#26a69a, 'Bull', inline='C1', group=grp_b1)
b1_bearC  = input.color(#ef5350, 'Bear', inline='C1', group=grp_b1)
b1_trans  = input.int(90, 'Transp', inline='C1', minval=0, maxval=100, group=grp_b1)
b1_width  = input.int(1, 'Line Width', inline='C1', minval=1, maxval=4, group=grp_b1)
b1_showPrice = input.bool(false, 'Show Price in Labels', group=grp_b1)

b1_sO     = input.bool(false, 'Open Level ', inline='L1_O', group=grp_b1)
b1_cO_in  = input.color(color.rgb(243, 227, 13), '', inline='L1_O', group=grp_b1)
b1_cO     = b1_cO_in == color.white ? chart.fg_color : b1_cO_in
b1_wO     = input.int(2, '', minval=1, maxval=4, inline='L1_O', group=grp_b1)
b1_stInO  = input.string('Solid', '', options=['Solid', 'Dashed', 'Dotted'], inline='L1_O', group=grp_b1)
b1_szO    = input.string('Small', '', options=['Tiny', 'Small', 'Normal', 'Large'], inline='L1_O', group=grp_b1)

b1_sH     = input.bool(false, 'High Level ', inline='L1_H', group=grp_b1)
b1_cH     = input.color(color.new(#089981, 0), '', inline='L1_H', group=grp_b1)
b1_wH     = input.int(2, '', minval=1, maxval=4, inline='L1_H', group=grp_b1)
b1_stInH  = input.string('Dashed', '', options=['Solid', 'Dashed', 'Dotted'], inline='L1_H', group=grp_b1)
b1_szH    = input.string('Small', '', options=['Tiny', 'Small', 'Normal', 'Large'], inline='L1_H', group=grp_b1)

b1_sL     = input.bool(false, 'Low Level  ', inline='L1_L', group=grp_b1)
b1_cL     = input.color(color.new(#f23645, 0), '', inline='L1_L', group=grp_b1)
b1_wL     = input.int(2, '', minval=1, maxval=4, inline='L1_L', group=grp_b1)
b1_stInL  = input.string('Dashed', '', options=['Solid', 'Dashed', 'Dotted'], inline='L1_L', group=grp_b1)
b1_szL    = input.string('Small', '', options=['Tiny', 'Small', 'Normal', 'Large'], inline='L1_L', group=grp_b1)

b1_sC     = input.bool(false, 'Close Level', inline='L1_C', group=grp_b1)
b1_cC     = input.color(color.new(#2962ff, 0), '', inline='L1_C', group=grp_b1)
b1_wC     = input.int(2, '', minval=1, maxval=4, inline='L1_C', group=grp_b1)
b1_stInC  = input.string('Dashed', '', options=['Solid', 'Dashed', 'Dotted'], inline='L1_C', group=grp_b1)
b1_szC    = input.string('Small', '', options=['Tiny', 'Small', 'Normal', 'Large'], inline='L1_C', group=grp_b1)

// ========================================================================= //
// ========================= HTF BOX 2 SETTINGS ============================ //
htfCndl2  = input.bool(false, 'Enable HTF Box 2', inline='T2', group=grp_b2)
htfUser2  = input.string('1 Hour', 'TF', options=['3 Mins', '5 Mins', '10 Mins', '15 Mins', '30 Mins', '45 Mins', '1 Hour', '2 Hours', '3 Hours', '4 Hours', '1 Day', '1 Week', '1 Month', '3 Months', '6 Months', '1 Year'], inline='T2', group=grp_b2)
b2_bullC  = input.color(#26a69a, 'Bull', inline='C2', group=grp_b2)
b2_bearC  = input.color(#ef5350, 'Bear', inline='C2', group=grp_b2)
b2_trans  = input.int(85, 'Transp', inline='C2', minval=0, maxval=100, group=grp_b2)
b2_width  = input.int(1, 'Line Width', inline='C2', minval=1, maxval=4, group=grp_b2)
b2_showPrice = input.bool(false, 'Show Price in Labels', group=grp_b2)

b2_sO     = input.bool(false, 'Open Level ', inline='L2_O', group=grp_b2)
b2_cO_in  = input.color(color.white, '', inline='L2_O', group=grp_b2)
b2_cO     = b2_cO_in == color.white ? chart.fg_color : b2_cO_in
b2_wO     = input.int(2, '', minval=1, maxval=4, inline='L2_O', group=grp_b2)
b2_stInO  = input.string('Solid', '', options=['Solid', 'Dashed', 'Dotted'], inline='L2_O', group=grp_b2)
b2_szO    = input.string('Small', '', options=['Tiny', 'Small', 'Normal', 'Large'], inline='L2_O', group=grp_b2)

b2_sH     = input.bool(false, 'High Level ', inline='L2_H', group=grp_b2)
b2_cH     = input.color(color.new(#089981, 0), '', inline='L2_H', group=grp_b2)
b2_wH     = input.int(2, '', minval=1, maxval=4, inline='L2_H', group=grp_b2)
b2_stInH  = input.string('Dashed', '', options=['Solid', 'Dashed', 'Dotted'], inline='L2_H', group=grp_b2)
b2_szH    = input.string('Small', '', options=['Tiny', 'Small', 'Normal', 'Large'], inline='L2_H', group=grp_b2)

b2_sL     = input.bool(false, 'Low Level  ', inline='L2_L', group=grp_b2)
b2_cL     = input.color(color.new(#f23645, 0), '', inline='L2_L', group=grp_b2)
b2_wL     = input.int(2, '', minval=1, maxval=4, inline='L2_L', group=grp_b2)
b2_stInL  = input.string('Dashed', '', options=['Solid', 'Dashed', 'Dotted'], inline='L2_L', group=grp_b2)
b2_szL    = input.string('Small', '', options=['Tiny', 'Small', 'Normal', 'Large'], inline='L2_L', group=grp_b2)

b2_sC     = input.bool(false, 'Close Level', inline='L2_C', group=grp_b2)
b2_cC     = input.color(color.new(#2962ff, 0), '', inline='L2_C', group=grp_b2)
b2_wC     = input.int(2, '', minval=1, maxval=4, inline='L2_C', group=grp_b2)
b2_stInC  = input.string('Dashed', '', options=['Solid', 'Dashed', 'Dotted'], inline='L2_C', group=grp_b2)
b2_szC    = input.string('Small', '', options=['Tiny', 'Small', 'Normal', 'Large'], inline='L2_C', group=grp_b2)

// ========================================================================= //
// ========================= HTF BOX 3 SETTINGS ============================ //
htfCndl3  = input.bool(false, 'Enable HTF Box 3', inline='T3', group=grp_b3)
htfUser3  = input.string('1 Month', 'TF', options=['3 Mins', '5 Mins', '10 Mins', '15 Mins', '30 Mins', '45 Mins', '1 Hour', '2 Hours', '3 Hours', '4 Hours', '1 Day', '1 Week', '1 Month', '3 Months', '6 Months', '1 Year'], inline='T3', group=grp_b3)
b3_bullC  = input.color(#26a69a, 'Bull', inline='C3', group=grp_b3)
b3_bearC  = input.color(#ef5350, 'Bear', inline='C3', group=grp_b3)
b3_trans  = input.int(85, 'Transp', inline='C3', minval=0, maxval=100, group=grp_b3)
b3_width  = input.int(1, 'Line Width', inline='C3', minval=1, maxval=4, group=grp_b3)
b3_showPrice = input.bool(false, 'Show Price in Labels', group=grp_b3)

b3_sO     = input.bool(false, 'Open Level ', inline='L3_O', group=grp_b3)
b3_cO_in  = input.color(color.white, '', inline='L3_O', group=grp_b3)
b3_cO     = b3_cO_in == color.white ? chart.fg_color : b3_cO_in
b3_wO     = input.int(2, '', minval=1, maxval=4, inline='L3_O', group=grp_b3)
b3_stInO  = input.string('Solid', '', options=['Solid', 'Dashed', 'Dotted'], inline='L3_O', group=grp_b3)
b3_szO    = input.string('Small', '', options=['Tiny', 'Small', 'Normal', 'Large'], inline='L3_O', group=grp_b3)

b3_sH     = input.bool(false, 'High Level ', inline='L3_H', group=grp_b3)
b3_cH     = input.color(color.new(#089981, 0), '', inline='L3_H', group=grp_b3)
b3_wH     = input.int(2, '', minval=1, maxval=4, inline='L3_H', group=grp_b3)
b3_stInH  = input.string('Dashed', '', options=['Solid', 'Dashed', 'Dotted'], inline='L3_H', group=grp_b3)
b3_szH    = input.string('Small', '', options=['Tiny', 'Small', 'Normal', 'Large'], inline='L3_H', group=grp_b3)

b3_sL     = input.bool(false, 'Low Level  ', inline='L3_L', group=grp_b3)
b3_cL     = input.color(color.new(#f23645, 0), '', inline='L3_L', group=grp_b3)
b3_wL     = input.int(2, '', minval=1, maxval=4, inline='L3_L', group=grp_b3)
b3_stInL  = input.string('Dashed', '', options=['Solid', 'Dashed', 'Dotted'], inline='L3_L', group=grp_b3)
b3_szL    = input.string('Small', '', options=['Tiny', 'Small', 'Normal', 'Large'], inline='L3_L', group=grp_b3)

b3_sC     = input.bool(false, 'Close Level', inline='L3_C', group=grp_b3)
b3_cC     = input.color(color.new(#2962ff, 0), '', inline='L3_C', group=grp_b3)
b3_wC     = input.int(2, '', minval=1, maxval=4, inline='L3_C', group=grp_b3)
b3_stInC  = input.string('Dashed', '', options=['Solid', 'Dashed', 'Dotted'], inline='L3_C', group=grp_b3)
b3_szC    = input.string('Small', '', options=['Tiny', 'Small', 'Normal', 'Large'], inline='L3_C', group=grp_b3)

// --- TPV Velocity Configuration ---
lookback = input.int(20, "Lookback Period", group = velocity_settings)
smooth = input.int(5, "Velocity Smoothing", group = velocity_settings)
threshold = input.float(1.0, "Velocity Threshold (For Alerts)", step = 0.1, group = velocity_settings)
use_confirmed_bars = input.bool(false, "Use Confirmed Bars Only", group = velocity_settings)

input_preset = input.string("Default", "Preconfigured Input Preset", options = ["Default", "Scalping", "Swing Trading"], group = velocity_settings)

if input_preset == "Scalping"
    lookback := 15
    smooth := 3
    threshold := 0.8
else if input_preset == "Swing Trading"
    lookback := 35
    smooth := 12
    threshold := 1.8

// --- TPV Color & Tables Options ---
color_preset = input.string("Custom", "Color Preset", options = ["Classic", "Aqua", "Cosmic", "Custom"], group = color_settings)
bullish_color = input.color(#00ffaa, "Bullish Color", group = color_settings)
bearish_color = input.color(#ff0000, "Bearish Color", group = color_settings)

show_info_table = input.bool(true, "Show TPV Info Table", group = table_settings)
table_preset = input.string("Auto Theme", "Table Color Preset", options = ["Auto Theme", "Dark", "Light", "Blue", "Custom"], group = table_settings)
info_table_position = input.string("Top Right", "Table Position", options = ["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group = table_settings)

table_background_color  = input.color(color.new(#1a1a1a, 0), "Custom Table Bg", group = table_settings)
header_background_color = input.color(color.new(#2d2d2d, 0), "Custom Header Bg", group = table_settings)
header_text_color       = input.color(color.white, "Custom Header Text", group = table_settings)
normal_text_color       = input.color(color.white, "Custom Normal Text", group = table_settings)
border_color            = input.color(color.new(#333333, 0), "Custom Border", group = table_settings)
table_text_size         = input.string("Normal", "Table Text Size", options = ["Tiny", "Small", "Normal", "Large"], group = table_settings)

//              ╔════════════════════════╗              //
//              ║   TPV CORE CALCULATIONS║              //
//              ╚════════════════════════╝              //

[final_bullish_color, final_bearish_color] = switch color_preset
    "Classic" => [#00ff00, #ff0000]
    "Aqua"    => [#00bfff, #ff8c00]
    "Cosmic"  => [#ff1493, #9932cc]
    "Custom"  => [bullish_color, bearish_color]

// Theme adaptive switches for TPV Info Table
[final_table_bg, final_header_bg, final_header_text, final_normal_text, final_border, use_preset_colors] = switch table_preset
    "Auto Theme" => [color.new(chart.bg_color, 10), color.new(chart.fg_color, 90), chart.fg_color, chart.fg_color, color.new(chart.fg_color, 80), false]
    "Dark"   => [color.new(#1a1a1a, 0), color.new(#2d2d2d, 0), color.white, color.white, color.new(#333333, 0), false]
    "Light"  => [color.new(#ffffff, 0), color.new(#f0f0f0, 0), color.black, color.black, color.new(#cccccc, 0), true]
    "Blue"   => [color.new(#1e3a5f, 0), color.new(#2e4a6f, 0), color.white, color.white, color.new(#4a6a8f, 0), false]
    "Custom" => [table_background_color, header_background_color, header_text_color, normal_text_color, border_color, false]

light_bullish_color = #006600
light_bearish_color = #cc0000

text_size = switch table_text_size
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large

get_line_style(str) =>
    switch str
        'Dashed' => line.style_dashed
        'Dotted' => line.style_dotted
        => line.style_solid

get_label_size(str) =>
    switch str
        'Tiny'   => size.tiny
        'Small'  => size.small
        'Normal' => size.normal
        'Large'  => size.large
        => size.small

div_line_style = get_line_style(div_line_style_in)
div_label_size = get_label_size(div_label_size_in)

calc_tpv_data(_lb, _smooth) =>
    priceChange = close - close[1]
    typicalMove = ta.atr(_lb)
    normalizedVelocity = typicalMove > 0 ? priceChange / typicalMove : 0
    accel = normalizedVelocity - nz(normalizedVelocity[1])
    sVelocity = ta.ema(normalizedVelocity, _smooth)
    [open, high, low, close, sVelocity, accel]

use_symbol = symbol_input == "" ? syminfo.tickerid : symbol_input
[sym_o, sym_h, sym_l, sym_c, sym_sig, sym_accel] = request.security(use_symbol, timeframe.period, calc_tpv_data(lookback, smooth))
show_data = use_confirmed_bars ? barstate.isconfirmed : true

// Plot Candlesticks
candleColor = sym_sig > 0 ? final_bullish_color : final_bearish_color
plotcandle(show_data ? sym_o : na, show_data ? sym_h : na, show_data ? sym_l : na, show_data ? sym_c : na, title="TPV Candles", color=candleColor, wickcolor=candleColor, bordercolor=candleColor)


//              ╔══════════════════════════════╗              //
//              ║   AUTO TRIAD CORRELATIONS    ║              //
//              ╚══════════════════════════════╝              //

string root = syminfo.root
string tckr = syminfo.ticker

bool is_ind = triad_mode == "Indices" or (triad_mode == "Auto-Detect" and (str.contains(root, "ES") or str.contains(root, "NQ") or str.contains(root, "YM") or str.contains(tckr, "SPX") or str.contains(tckr, "NDX")))
bool is_fx = triad_mode == "Forex" or (triad_mode == "Auto-Detect" and (str.contains(root, "EURUSD") or str.contains(root, "GBPUSD") or str.contains(root, "DXY")))
bool is_gold = triad_mode == "Metals" or (triad_mode == "Auto-Detect" and (str.contains(root, "XAU") or str.contains(root, "GC") or str.contains(root, "MGC") or str.contains(root, "XAG")))
bool is_oil = triad_mode == "Oil" or (triad_mode == "Auto-Detect" and (str.contains(root, "CL") or str.contains(root, "RB") or str.contains(root, "HO")))

string sym1 = man_sym1
string sym2 = man_sym2
string sym3 = man_sym3
string sym4 = man_sym4
bool use1 = man_use1
bool use2 = man_use2
bool use3 = man_use3
bool use4 = man_use4

if is_ind
    sym1 := "CME_MINI:NQ1!", sym2 := "CME_MINI:ES1!", sym3 := "CBOT_MINI:YM1!", sym4 := ""
    use1 := not str.contains(root, "NQ"), use2 := not str.contains(root, "ES"), use3 := not str.contains(root, "YM"), use4 := false
else if is_fx
    sym1 := "FX:EURUSD", sym2 := "FX:GBPUSD", sym3 := "TVC:DXY", sym4 := ""
    use1 := not str.contains(root, "EURUSD"), use2 := not str.contains(root, "GBPUSD"), use3 := not str.contains(root, "DXY"), use4 := false
else if is_gold
    sym1 := "OANDA:XAGUSD", sym2 := "OANDA:XAUEUR", sym3 := "OANDA:XAUGBP", sym4 := "COMEX_MINI:MGC1!"
    use1 := not str.contains(root, "XAG"), use2 := not str.contains(tckr, "XAUEUR"), use3 := not str.contains(tckr, "XAUGBP"), use4 := not str.contains(root, "MGC")
else if is_oil
    sym1 := "NYMEX:CL1!", sym2 := "NYMEX:RB1!", sym3 := "NYMEX:HO1!", sym4 := ""
    use1 := not str.contains(root, "CL"), use2 := not str.contains(root, "RB"), use3 := not str.contains(root, "HO"), use4 := false

f_short_name(s) =>
    parts = str.split(s, ":")
    array.size(parts) > 0 ? array.get(parts, array.size(parts) - 1) : s

f_shorten_symbol(sym, use_short) =>
    if not use_short
        sym
    else
        string res = sym
        if str.contains(sym, "XAUUSD")
            res := "XU"
        else if str.contains(sym, "XAGUSD")
            res := "XG"
        else if str.contains(sym, "XAUEUR")
            res := "XE"
        else if str.contains(sym, "XAUGBP")
            res := "XB"
        else if str.contains(sym, "EURUSD")
            res := "EU"
        else if str.contains(sym, "GBPUSD")
            res := "GU"
        else if str.contains(sym, "DXY")
            res := "DXY"
        else if str.contains(sym, "NQ")
            res := "NQ"
        else if str.contains(sym, "ES")
            res := "ES"
        else if str.contains(sym, "YM")
            res := "YM"
        else if str.contains(sym, "MGC")
            res := "MGC"
        else if str.contains(sym, "GC")
            res := "GC"
        else if str.contains(sym, "CL")
            res := "CL"
        else if str.contains(sym, "RB")
            res := "RB"
        else if str.contains(sym, "HO")
            res := "HO"
        else if str.length(sym) == 6
            res := str.substring(sym, 0, 1) + str.substring(sym, 3, 4)
        else if str.length(sym) > 3
            res := str.replace_all(str.replace_all(sym, "1!", ""), "2!", "")
        res

ticker1 = f_shorten_symbol(f_short_name(sym1), smt_shortLabels)
ticker2 = f_shorten_symbol(f_short_name(sym2), smt_shortLabels)
ticker3 = f_shorten_symbol(f_short_name(sym3), smt_shortLabels)
ticker4 = f_shorten_symbol(f_short_name(sym4), smt_shortLabels)

//              ╔══════════════════════════════╗              //
//              ║    SMT MTF DIVERGENCES       ║              //
//              ╚══════════════════════════════╝              //

// --- SMT Formatter helper ---
f_format_tf(t) =>
    string res = t == "" ? timeframe.period : t
    float tf_num = str.tonumber(res)
    if not na(tf_num)
        if tf_num >= 60 and tf_num % 60 == 0
            str.tostring(int(tf_num / 60)) + "h"
        else
            str.tostring(int(tf_num)) + "m"
    else
        res

// MTF Filter Helper 
is_valid_tf(tf) =>
    if tf == ""
        true
    else
        tf_secs = timeframe.in_seconds(tf)
        chart_secs = timeframe.in_seconds(timeframe.period)
        tf_secs >= chart_secs or show_ltf_on_htf

// Extract Pivot Data inside Security Context Native to HTF
get_pivot_data(sym, tf, len) =>
    ph = ta.pivothigh(high, len, len)
    pl = ta.pivotlow(low, len, len)
    t_ph = ta.valuewhen(not na(ph), time[len], 0)
    t_pl = ta.valuewhen(not na(pl), time[len], 0)
    request.security(sym, tf, [fixnan(ph), fixnan(pl), t_ph, t_pl], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// Intelligent Divergence Checker Mapping HTF Time to LTF Chart
detect_mtf_divergence(b_val, b_time, s_val, s_time, is_ph, css, l_style, l_width) =>
    var float prev_b_val = na
    var float prev_s_val = na
    var int prev_b_time = na
    bool is_div = false

    if b_val != b_val[1] and s_val != s_val[1]
        if not na(prev_b_val) and not na(prev_s_val)
            if (b_val - prev_b_val) * (s_val - prev_s_val) < 0
                line.new(prev_b_time, prev_b_val, b_time, b_val, xloc=xloc.bar_time, color=css, style=l_style, width=l_width)
                is_div := true
                
        prev_b_val := b_val
        prev_s_val := s_val
        prev_b_time := b_time
    else if (is_ph and b_val > nz(b_val[1])) or (not is_ph and b_val < nz(b_val[1]))
        prev_s_val := na
        prev_b_val := b_val
        prev_b_time := b_time
    is_div

get_tf_data_unrolled(tf_on, tf, sym_b, sym_1, sym_2, sym_3, sym_4, len) =>
    float b_ph = na, float b_pl = na, int b_tph = na, int b_tpl = na
    float s1_ph = na, float s1_pl = na, int s1_tph = na, int s1_tpl = na
    float s2_ph = na, float s2_pl = na, int s2_tph = na, int s2_tpl = na
    float s3_ph = na, float s3_pl = na, int s3_tph = na, int s3_tpl = na
    float s4_ph = na, float s4_pl = na, int s4_tph = na, int s4_tpl = na
    
    if tf_on
        [tb_ph, tb_pl, tb_tph, tb_tpl] = get_pivot_data(sym_b, tf, len)
        [ts1_ph, ts1_pl, ts1_tph, ts1_tpl] = get_pivot_data(sym_1, tf, len)
        [ts2_ph, ts2_pl, ts2_tph, ts2_tpl] = get_pivot_data(sym_2, tf, len)
        [ts3_ph, ts3_pl, ts3_tph, ts3_tpl] = get_pivot_data(sym_3, tf, len)
        [ts4_ph, ts4_pl, ts4_tph, ts4_tpl] = get_pivot_data(sym_4, tf, len)
        
        b_ph := tb_ph, b_pl := tb_pl, b_tph := tb_tph, b_tpl := tb_tpl
        s1_ph := ts1_ph, s1_pl := ts1_pl, s1_tph := ts1_tph, s1_tpl := ts1_tpl
        s2_ph := ts2_ph, s2_pl := ts2_pl, s2_tph := ts2_tph, s2_tpl := ts2_tpl
        s3_ph := ts3_ph, s3_pl := ts3_pl, s3_tph := ts3_tph, s3_tpl := ts3_tpl
        s4_ph := ts4_ph, s4_pl := ts4_pl, s4_tph := ts4_tph, s4_tpl := ts4_tpl
        
    [b_ph, b_pl, b_tph, b_tpl, s1_ph, s1_pl, s1_tph, s1_tpl, s2_ph, s2_pl, s2_tph, s2_tpl, s3_ph, s3_pl, s3_tph, s3_tpl, s4_ph, s4_pl, s4_tph, s4_tpl]

process_smt_for_tf(tf_on, tf, sym_b, sym_1, sym_2, sym_3, sym_4, len, t1, t2, t3, t4, u1, u2, u3, u4, l_style, l_width, l_size) =>
    [b_ph, b_pl, b_tph, b_tpl, s1_ph, s1_pl, s1_tph, s1_tpl, s2_ph, s2_pl, s2_tph, s2_tpl, s3_ph, s3_pl, s3_tph, s3_tpl, s4_ph, s4_pl, s4_tph, s4_tpl] = get_tf_data_unrolled(tf_on, tf, sym_b, sym_1, sym_2, sym_3, sym_4, len)
    
    int ph_n = 0, int pl_n = 0
    int ph_smt1 = 0, int pl_smt1 = 0
    int ph_smt2 = 0, int pl_smt2 = 0
    int ph_smt3 = 0, int pl_smt3 = 0
    int ph_smt4 = 0, int pl_smt4 = 0

    // Tracking the previous pivots for midpoint label placement
    var float prev_b_ph = na
    var int prev_b_tph = na
    var float prev_b_pl = na
    var int prev_b_tpl = na
    
    if tf_on
        if b_ph != b_ph[1]
            ph_n := 1
            prev_b_ph := b_ph[1]
            prev_b_tph := b_tph[1]
        if b_pl != b_pl[1]
            pl_n := 1
            prev_b_pl := b_pl[1]
            prev_b_tpl := b_tpl[1]

        bool div_s1_ph = false, bool div_s2_ph = false, bool div_s3_ph = false, bool div_s4_ph = false
        bool div_s1_pl = false, bool div_s2_pl = false, bool div_s3_pl = false, bool div_s4_pl = false

        if u1
            div_s1_ph := detect_mtf_divergence(b_ph, b_tph, s1_ph, s1_tph, true, smt_bullDivCss, l_style, l_width)
            div_s1_pl := detect_mtf_divergence(b_pl, b_tpl, s1_pl, s1_tpl, false, smt_bearDivCss, l_style, l_width)
            if div_s1_ph
                ph_smt1 := 1
            if div_s1_pl
                pl_smt1 := 1

        if u2
            div_s2_ph := detect_mtf_divergence(b_ph, b_tph, s2_ph, s2_tph, true, smt_bullDivCss, l_style, l_width)
            div_s2_pl := detect_mtf_divergence(b_pl, b_tpl, s2_pl, s2_tpl, false, smt_bearDivCss, l_style, l_width)
            if div_s2_ph
                ph_smt2 := 1
            if div_s2_pl
                pl_smt2 := 1

        if u3
            div_s3_ph := detect_mtf_divergence(b_ph, b_tph, s3_ph, s3_tph, true, smt_bullDivCss, l_style, l_width)
            div_s3_pl := detect_mtf_divergence(b_pl, b_tpl, s3_pl, s3_tpl, false, smt_bearDivCss, l_style, l_width)
            if div_s3_ph
                ph_smt3 := 1
            if div_s3_pl
                pl_smt3 := 1

        if u4
            div_s4_ph := detect_mtf_divergence(b_ph, b_tph, s4_ph, s4_tph, true, smt_bullDivCss, l_style, l_width)
            div_s4_pl := detect_mtf_divergence(b_pl, b_tpl, s4_pl, s4_tpl, false, smt_bearDivCss, l_style, l_width)
            if div_s4_ph
                ph_smt4 := 1
            if div_s4_pl
                pl_smt4 := 1
                
        // Utilize the new formatting logic here
        tf_display = f_format_tf(tf)
        
        // Midpoint Label Generation for Swing Highs
        if div_s1_ph or div_s2_ph or div_s3_ph or div_s4_ph
            string[] ph_divs = array.new<string>()
            if div_s1_ph
                array.push(ph_divs, t1)
            if div_s2_ph
                array.push(ph_divs, t2)
            if div_s3_ph
                array.push(ph_divs, t3)
            if div_s4_ph
                array.push(ph_divs, t4)
            
            txt_ph = array.join(ph_divs, "\n") + "\n" + tf_display + (smt_showPrice ? "\n" + str.tostring(b_ph, format.mintick) : "")
            
            int mid_tph = na(prev_b_tph) ? b_tph : int(math.round(math.avg(b_tph, prev_b_tph)))
            float mid_ph = na(prev_b_ph) ? b_ph : math.avg(b_ph, prev_b_ph)
            
            label.new(mid_tph, mid_ph, txt_ph, xloc=xloc.bar_time, color=smt_bullDivCss, style=label.style_label_down, textcolor=color.white, size=l_size)

        // Midpoint Label Generation for Swing Lows
        if div_s1_pl or div_s2_pl or div_s3_pl or div_s4_pl
            string[] pl_divs = array.new<string>()
            if div_s1_pl
                array.push(pl_divs, t1)
            if div_s2_pl
                array.push(pl_divs, t2)
            if div_s3_pl
                array.push(pl_divs, t3)
            if div_s4_pl
                array.push(pl_divs, t4)
            
            txt_pl = array.join(pl_divs, "\n") + "\n" + tf_display + (smt_showPrice ? "\n" + str.tostring(b_pl, format.mintick) : "")
            
            int mid_tpl = na(prev_b_tpl) ? b_tpl : int(math.round(math.avg(b_tpl, prev_b_tpl)))
            float mid_pl = na(prev_b_pl) ? b_pl : math.avg(b_pl, prev_b_pl)
            
            label.new(mid_tpl, mid_pl, txt_pl, xloc=xloc.bar_time, color=smt_bearDivCss, style=label.style_label_up, textcolor=color.white, size=l_size)
            
    [ph_n, pl_n, ph_smt1, pl_smt1, ph_smt2, pl_smt2, ph_smt3, pl_smt3, ph_smt4, pl_smt4]

// Global Aggregators
var int tot_ph_n = 0, var int tot_pl_n = 0
var int tot_ph_smt1 = 0, var int tot_pl_smt1 = 0
var int tot_ph_smt2 = 0, var int tot_pl_smt2 = 0
var int tot_ph_smt3 = 0, var int tot_pl_smt3 = 0
var int tot_ph_smt4 = 0, var int tot_pl_smt4 = 0

// Run Independent Layers evaluating TF validity
run_tf1 = tf1_on and is_valid_tf(tf1)
run_tf2 = tf2_on and is_valid_tf(tf2)
run_tf3 = tf3_on and is_valid_tf(tf3)
run_tf4 = tf4_on and is_valid_tf(tf4)
run_tf5 = tf5_on and is_valid_tf(tf5)

[n_ph1, n_pl1, ph1_1, pl1_1, ph2_1, pl2_1, ph3_1, pl3_1, ph4_1, pl4_1] = process_smt_for_tf(run_tf1, tf1, use_symbol, sym1, sym2, sym3, sym4, smt_length, ticker1, ticker2, ticker3, ticker4, use1, use2, use3, use4, div_line_style, div_line_width, div_label_size)
[n_ph2, n_pl2, ph1_2, pl1_2, ph2_2, pl2_2, ph3_2, pl3_2, ph4_2, pl4_2] = process_smt_for_tf(run_tf2, tf2, use_symbol, sym1, sym2, sym3, sym4, smt_length, ticker1, ticker2, ticker3, ticker4, use1, use2, use3, use4, div_line_style, div_line_width, div_label_size)
[n_ph3, n_pl3, ph1_3, pl1_3, ph2_3, pl2_3, ph3_3, pl3_3, ph4_3, pl4_3] = process_smt_for_tf(run_tf3, tf3, use_symbol, sym1, sym2, sym3, sym4, smt_length, ticker1, ticker2, ticker3, ticker4, use1, use2, use3, use4, div_line_style, div_line_width, div_label_size)
[n_ph4, n_pl4, ph1_4, pl1_4, ph2_4, pl2_4, ph3_4, pl3_4, ph4_4, pl4_4] = process_smt_for_tf(run_tf4, tf4, use_symbol, sym1, sym2, sym3, sym4, smt_length, ticker1, ticker2, ticker3, ticker4, use1, use2, use3, use4, div_line_style, div_line_width, div_label_size)
[n_ph5, n_pl5, ph1_5, pl1_5, ph2_5, pl2_5, ph3_5, pl3_5, ph4_5, pl4_5] = process_smt_for_tf(run_tf5, tf5, use_symbol, sym1, sym2, sym3, sym4, smt_length, ticker1, ticker2, ticker3, ticker4, use1, use2, use3, use4, div_line_style, div_line_width, div_label_size)

tot_ph_n += n_ph1 + n_ph2 + n_ph3 + n_ph4 + n_ph5
tot_pl_n += n_pl1 + n_pl2 + n_pl3 + n_pl4 + n_pl5

tot_ph_smt1 += ph1_1 + ph1_2 + ph1_3 + ph1_4 + ph1_5
tot_pl_smt1 += pl1_1 + pl1_2 + pl1_3 + pl1_4 + pl1_5

tot_ph_smt2 += ph2_1 + ph2_2 + ph2_3 + ph2_4 + ph2_5
tot_pl_smt2 += pl2_1 + pl2_2 + pl2_3 + pl2_4 + pl2_5

tot_ph_smt3 += ph3_1 + ph3_2 + ph3_3 + ph3_4 + ph3_5
tot_pl_smt3 += pl3_1 + pl3_2 + pl3_3 + pl3_4 + pl3_5

tot_ph_smt4 += ph4_1 + ph4_2 + ph4_3 + ph4_4 + ph4_5
tot_pl_smt4 += pl4_1 + pl4_2 + pl4_3 + pl4_4 + pl4_5

//              ╔══════════════════════════════╗              //
//              ║          TABLES              ║              //
//              ╚══════════════════════════════╝              //

// --- TPV Info Table ---
tablePos = switch info_table_position
    "Top Left"      => position.top_left
    "Top Center"    => position.top_center
    "Top Right"     => position.top_right
    "Middle Left"   => position.middle_left
    "Middle Center" => position.middle_center
    "Middle Right"  => position.middle_right
    "Bottom Left"   => position.bottom_left
    "Bottom Center" => position.bottom_center
    "Bottom Right"  => position.bottom_right
    => position.top_right

var table infoTable = show_info_table ? table.new(tablePos, 4, 3, bgcolor=final_table_bg, border_width=1, frame_color=final_border, frame_width=1) : na

if show_data and show_info_table
    table.clear(infoTable, 0, 0, 3, 2)
    table.cell(infoTable, 0, 0, "Metric", bgcolor=final_header_bg, text_color=final_header_text, text_size=text_size)
    table.cell(infoTable, 1, 0, "Value", bgcolor=final_header_bg, text_color=final_header_text, text_size=text_size)
    table.cell(infoTable, 2, 0, "Trend", bgcolor=final_header_bg, text_color=final_header_text, text_size=text_size)
    table.cell(infoTable, 3, 0, "Change", bgcolor=final_header_bg, text_color=final_header_text, text_size=text_size)
    
    signalChange = sym_sig - nz(sym_sig[1])
    accelerationChange = sym_accel - nz(sym_accel[1])
    
    table.cell(infoTable, 0, 1, "Velocity", bgcolor=final_table_bg, text_color=final_normal_text, text_size=text_size)
    table.cell(infoTable, 1, 1, str.tostring(sym_sig, "#.##"), bgcolor=final_table_bg, text_color=use_preset_colors ? (sym_sig > 0 ? light_bullish_color : light_bearish_color) : (table_preset == "Auto Theme" ? final_normal_text : (sym_sig > 0 ? final_bullish_color : final_bearish_color)), text_size=text_size)
    table.cell(infoTable, 2, 1, sym_sig > 0 ? "↑" : "↓", bgcolor=final_table_bg, text_color=use_preset_colors ? (sym_sig > 0 ? light_bullish_color : light_bearish_color) : (table_preset == "Auto Theme" ? final_normal_text : (sym_sig > 0 ? final_bullish_color : final_bearish_color)), text_size=text_size)
    table.cell(infoTable, 3, 1, (signalChange >= 0 ? "+" : "") + str.tostring(signalChange, "#.##"), bgcolor=final_table_bg, text_color=use_preset_colors ? (signalChange >= 0 ? light_bullish_color : light_bearish_color) : (table_preset == "Auto Theme" ? final_normal_text : (signalChange >= 0 ? final_bullish_color : final_bearish_color)), text_size=text_size)
    
    table.cell(infoTable, 0, 2, "Acceleration", bgcolor=final_table_bg, text_color=final_normal_text, text_size=text_size)
    table.cell(infoTable, 1, 2, str.tostring(sym_accel, "#.##"), bgcolor=final_table_bg, text_color=use_preset_colors ? (sym_accel > 0 ? light_bullish_color : light_bearish_color) : (table_preset == "Auto Theme" ? final_normal_text : (sym_accel > 0 ? final_bullish_color : final_bearish_color)), text_size=text_size)
    table.cell(infoTable, 2, 2, sym_accel > 0 ? "↑" : "↓", bgcolor=final_table_bg, text_color=use_preset_colors ? (sym_accel > 0 ? light_bullish_color : light_bearish_color) : (table_preset == "Auto Theme" ? final_normal_text : (sym_accel > 0 ? final_bullish_color : final_bearish_color)), text_size=text_size)
    table.cell(infoTable, 3, 2, (accelerationChange >= 0 ? "+" : "") + str.tostring(accelerationChange, "#.##"), bgcolor=final_table_bg, text_color=use_preset_colors ? (accelerationChange >= 0 ? light_bullish_color : light_bearish_color) : (table_preset == "Auto Theme" ? final_normal_text : (accelerationChange >= 0 ? final_bullish_color : final_bearish_color)), text_size=text_size)


// --- Dynamic SMT Aggregate Dashboard ---
var smt_table_position = smt_dashLoc == 'Bottom Left' ? position.bottom_left : smt_dashLoc == 'Top Right' ? position.top_right : position.bottom_right
var smt_table_size = smt_textSize == 'Tiny' ? size.tiny : smt_textSize == 'Small' ? size.small : size.normal

if barstate.islast and smt_showDash
    string[] a_tickers = array.new<string>()
    int[] a_ph = array.new<int>()
    int[] a_pl = array.new<int>()
    
    if use1
        array.push(a_tickers, ticker1)
        array.push(a_ph, tot_ph_smt1)
        array.push(a_pl, tot_pl_smt1)
    if use2
        array.push(a_tickers, ticker2)
        array.push(a_ph, tot_ph_smt2)
        array.push(a_pl, tot_pl_smt2)
    if use3
        array.push(a_tickers, ticker3)
        array.push(a_ph, tot_ph_smt3)
        array.push(a_pl, tot_pl_smt3)
    if use4
        array.push(a_tickers, ticker4)
        array.push(a_ph, tot_ph_smt4)
        array.push(a_pl, tot_pl_smt4)
        
    int num_active = array.size(a_tickers)
    if num_active > 0
        var tb = table.new(smt_table_position, 3, num_active + 1, bgcolor = color.new(chart.bg_color, 5), border_color = color.new(chart.fg_color, 80), border_width = 1, frame_color = color.new(chart.fg_color, 80), frame_width = 1)
        table.cell(tb, 1, 0, 'Swing High', text_color = chart.fg_color, text_size = smt_table_size)
        table.cell(tb, 2, 0, 'Swing Low', text_color = chart.fg_color, text_size = smt_table_size)
        
        for i = 0 to num_active - 1
            table.cell(tb, 0, i + 1, array.get(a_tickers, i), text_color = chart.fg_color, text_size = smt_table_size)
            
            ph_val = array.get(a_ph, i)
            pl_val = array.get(a_pl, i)
            
            pct_ph = tot_ph_n > 0 ? (ph_val / tot_ph_n) : 0
            pct_pl = tot_pl_n > 0 ? (pl_val / tot_pl_n) : 0
            
            table.cell(tb, 1, i + 1, str.format('{0} ({1, number, percent})', ph_val, pct_ph), text_color = smt_bullDivCss, text_size = smt_table_size)
            table.cell(tb, 2, i + 1, str.format('{0} ({1, number, percent})', pl_val, pct_pl), text_color = smt_bearDivCss, text_size = smt_table_size)

//              ╔══════════════════════════════╗              //
//              ║            ALERTS            ║              //
//              ╚══════════════════════════════╝              //

confirmed_signal = use_confirmed_bars ? sym_sig[1] : sym_sig
confirmed_signal_prev = use_confirmed_bars ? sym_sig[2] : sym_sig[1]

alertcondition(confirmed_signal > 0 and confirmed_signal_prev <= 0, "TPV Long", "Time-Price Velocity turned positive")
alertcondition(confirmed_signal <= 0 and confirmed_signal_prev > 0, "TPV Short", "Time-Price Velocity turned negative")
alertcondition(confirmed_signal > threshold and confirmed_signal_prev <= threshold, "TPV High Bullish", "Time-Price Velocity crossed above upper threshold")
alertcondition(confirmed_signal < -threshold and confirmed_signal_prev >= -threshold, "TPV High Bearish", "Time-Price Velocity crossed below lower threshold")

//              ╔══════════════════════════════╗              //
//              ║     HTF BOXES FUNCTIONS      ║              //
//              ╚══════════════════════════════╝              //

f_getShortTF(str) =>
    switch str
        '3 Mins' => '3m'
        '5 Mins' => '5m'
        '10 Mins' => '10m'
        '15 Mins' => '15m'
        '30 Mins' => '30m'
        '45 Mins' => '45m'
        '1 Hour' => '1h'
        '2 Hours' => '2h'
        '3 Hours' => '3h'
        '4 Hours' => '4h'
        '1 Day' => 'D'
        '1 Week' => 'W'
        '1 Month' => 'M'
        '3 Months' => '3M'
        '6 Months' => '6M'
        '1 Year' => 'Y'
        => str

f_fmt(shortTf, lvl, val, showPrice) =>
    shortTf + "-" + lvl + (showPrice ? "\n" + str.tostring(val, format.mintick) : "")

checkIf(_chartTF, _candlestickTF) =>
    var stat = false
    candlestickTF = _candlestickTF == 'D' ? 1440 : _candlestickTF == 'W' ? 10080 :  _candlestickTF == 'M' ? 302400 :  _candlestickTF == '3M' ? 3 * 302400 :  _candlestickTF == '6M' ? 6 * 302400 :  _candlestickTF == '12M' ? 12 * 302400 : str.tonumber(_candlestickTF)

    if timeframe.isintraday
        stat := candlestickTF >= str.tonumber(_chartTF)
    else
        chartTF = str.contains(_chartTF, 'D') ? _chartTF == 'D' ? 1440 : str.tonumber(str.replace(_chartTF, 'D', '', 0)) * 1440 : str.contains(_chartTF, 'W') ? _chartTF == 'W' ? 10080 : str.tonumber(str.replace(_chartTF, 'W', '', 0)) * 10080 : _chartTF == 'M' ? 302400 : str.tonumber(str.replace(_chartTF, 'M', '', 0)) * 302400
    stat

f_htf_ohlc(_htf) =>
    bool is_new = nz(ta.change(time(_htf))) != 0
    var htf_o  = 0., var htf_h  = 0., var htf_l  = 0.,     htf_c  = close
    var htf_ox = 0., var htf_hx = 0., var htf_lx = 0., var htf_cx = 0.
    var int htf_t = time, var int htf_tx = time

    if is_new
        htf_ox := htf_o, htf_o := open
        htf_hx := htf_h, htf_h := high
        htf_lx := htf_l, htf_l := low
        htf_cx := htf_c[1]
        htf_tx := htf_t, htf_t := time
        true 
    else
        htf_h := math.max(high, htf_h)
        htf_l := math.min(low , htf_l)
        true 

    [htf_ox, htf_hx, htf_lx, htf_cx, htf_o, htf_h, htf_l, htf_c, htf_tx, htf_t]

f_getTF(_htf) =>
    htf = _htf == '3 Mins' ? '3' : _htf == '5 Mins' ? '5' : _htf == '10 Mins' ? '10' : _htf == '15 Mins' ? '15' : _htf == '30 Mins' ? '30' : _htf == '45 Mins' ? '45' : _htf == '1 Hour' ? '60' : _htf == '2 Hours' ? '120' : _htf == '3 Hours' ? '180' : _htf == '4 Hours' ? '240' : _htf == '1 Day' ? 'D' : _htf == '1 Week' ? 'W' : _htf == '1 Month' ? 'M' : _htf == '3 Months' ? '3M' : _htf == '6 Months' ? '6M' : _htf == '1 Year' ? '12M' : na
    htf

f_processCandles(_show, _htf, _shortTf, _showPrice, _bullC, _bearC, _trans, _width, _sO, _cO, _wO, _stO, _szO, _sH, _cH, _wH, _stH, _szH, _sL, _cL, _wL, _stL, _szL, _sC, _cC, _wC, _stC, _szC) =>
    bool is_new = nz(ta.change(time(_htf))) != 0
    if _show
        [O1, H1, L1, C1, O0, H0, L0, C0, T1, T0] = f_htf_ohlc(_htf)

        color0  = O0 < C0 ? color.new(_bullC, _trans)   : color.new(_bearC, _trans)
        color01 = O0 < C0 ? color.new(_bullC, _trans/2) : color.new(_bearC, _trans/2)
        color1  = O1 < C1 ? color.new(_bullC, _trans)   : color.new(_bearC, _trans)
        color11 = O1 < C1 ? color.new(_bullC, _trans/2) : color.new(_bearC, _trans/2)

        var box hl  = na
        var box oc  = na
        var line l_o = na, var line l_h = na, var line l_l = na
        var label lb_o = na, var label lb_h = na, var label lb_l = na
        var int x11 = na
        var int x1  = na
        
        lbl_clr = color.new(chart.bg_color, 100)
        
        time_str1 = str.format("{0,date,HH:mm}", T1, syminfo.timezone)
        time_str0 = str.format("{0,date,HH:mm}", T0, syminfo.timezone)

        if _htf != timeframe.period
            if is_new
                x11 := x1
                x1  := bar_index

                // RENDER HISTORICAL CLOSED BOX
                if L1 != 0
                    box.new(x11, H1, x1 - 1, L1, color11, _width, line.style_dotted, extend.none, xloc.bar_index, color1)
                    box.new(x11, O1, x1 - 1, C1, color11, _width, line.style_solid , extend.none, xloc.bar_index, color1)
                    if _sO
                        line.new(x11, O1, x1 - 1, O1, xloc=xloc.bar_index, color=_cO, style=_stO, width=_wO)
                        lbl_txt_hist = str.upper(_shortTf + "-OPEN") + " | " + time_str1 + (_showPrice ? "\n" + str.tostring(O1, format.mintick) : "")
                        label.new(x1 - 1, O1, lbl_txt_hist, xloc=xloc.bar_index, color=lbl_clr, textcolor=_cO, style=label.style_label_left, size=_szO)
                    if _sH
                        line.new(x11, H1, x1 - 1, H1, xloc=xloc.bar_index, color=_cH, style=_stH, width=_wH)
                        label.new(x1 - 1, H1, f_fmt(_shortTf, "H", H1, _showPrice), xloc=xloc.bar_index, color=lbl_clr, textcolor=_cH, style=label.style_label_left, size=_szH)
                    if _sL
                        line.new(x11, L1, x1 - 1, L1, xloc=xloc.bar_index, color=_cL, style=_stL, width=_wL)
                        label.new(x1 - 1, L1, f_fmt(_shortTf, "L", L1, _showPrice), xloc=xloc.bar_index, color=lbl_clr, textcolor=_cL, style=label.style_label_left, size=_szL)
                    
                    // Generate the historical close line only when the bar officially closes
                    if _sC
                        line.new(x11, C1, x1 - 1, C1, xloc=xloc.bar_index, color=_cC, style=_stC, width=_wC)
                        label.new(x1 - 1, C1, f_fmt(_shortTf, "C", C1, _showPrice), xloc=xloc.bar_index, color=lbl_clr, textcolor=_cC, style=label.style_label_left, size=_szC)

                // RENDER ACTIVE DEVELOPING BOX
                proj_x = bar_index
                box.delete(hl), hl := box.new(x1, H0, proj_x, L0, color01, _width, line.style_dotted, extend.none, xloc.bar_index, color0)
                box.delete(oc), oc := box.new(x1, O0, proj_x, C0, color01, _width, line.style_solid , extend.none, xloc.bar_index, color0)
                
                if _sO
                    line.delete(l_o), l_o := line.new(x1, O0, proj_x, O0, xloc=xloc.bar_index, color=_cO, style=_stO, width=_wO)
                    lbl_txt_dev = str.upper(_shortTf + "-OPEN") + " | " + time_str0 + (_showPrice ? "\n" + str.tostring(O0, format.mintick) : "")
                    label.delete(lb_o), lb_o := label.new(proj_x, O0, lbl_txt_dev, xloc=xloc.bar_index, color=lbl_clr, textcolor=_cO, style=label.style_label_left, size=_szO)
                if _sH
                    line.delete(l_h), l_h := line.new(x1, H0, proj_x, H0, xloc=xloc.bar_index, color=_cH, style=_stH, width=_wH)
                    label.delete(lb_h), lb_h := label.new(proj_x, H0, f_fmt(_shortTf, "H", H0, _showPrice), xloc=xloc.bar_index, color=lbl_clr, textcolor=_cH, style=label.style_label_left, size=_szH)
                if _sL
                    line.delete(l_l), l_l := line.new(x1, L0, proj_x, L0, xloc=xloc.bar_index, color=_cL, style=_stL, width=_wL)
                    label.delete(lb_l), lb_l := label.new(proj_x, L0, f_fmt(_shortTf, "L", L0, _showPrice), xloc=xloc.bar_index, color=lbl_clr, textcolor=_cL, style=label.style_label_left, size=_szL)
                true 
            else
                box.set_top(hl, H0)
                box.set_bottom(hl, L0)
                box.set_right(hl, bar_index)
                box.set_bgcolor(hl, color0)
                box.set_border_color(hl, color01)

                box.set_top(oc, math.max(O0, C0))
                box.set_bottom(oc, math.min(O0, C0))
                box.set_right(oc, bar_index)
                box.set_bgcolor(oc, color0)
                box.set_border_color(oc, color01)
                
                if _sO
                    line.set_y1(l_o, O0)
                    line.set_y2(l_o, O0)
                    line.set_x2(l_o, bar_index)
                    label.set_xy(lb_o, bar_index, O0)
                    lbl_txt_upd = str.upper(_shortTf + "-OPEN") + " | " + time_str0 + (_showPrice ? "\n" + str.tostring(O0, format.mintick) : "")
                    label.set_text(lb_o, lbl_txt_upd)
                if _sH
                    line.set_y1(l_h, H0)
                    line.set_y2(l_h, H0)
                    line.set_x2(l_h, bar_index)
                    label.set_xy(lb_h, bar_index, H0)
                    label.set_text(lb_h, f_fmt(_shortTf, "H", H0, _showPrice))
                if _sL
                    line.set_y1(l_l, L0)
                    line.set_y2(l_l, L0)
                    line.set_x2(l_l, bar_index)
                    label.set_xy(lb_l, bar_index, L0)
                    label.set_text(lb_l, f_fmt(_shortTf, "L", L0, _showPrice))
                true 

//              ╔══════════════════════════════╗              //
//              ║          MAIN LOGIC          ║              //
//              ╚══════════════════════════════╝              //

htfBox1 = f_getTF(htfUser1)
htfBox2 = f_getTF(htfUser2)
htfBox3 = f_getTF(htfUser3)

shortTf1 = f_getShortTF(htfUser1)
shortTf2 = f_getShortTF(htfUser2)
shortTf3 = f_getShortTF(htfUser3)

supportedBox1 = checkIf(timeframe.period, htfBox1)
supportedBox2 = checkIf(timeframe.period, htfBox2)
supportedBox3 = checkIf(timeframe.period, htfBox3)

if chart.is_standard
    if supportedBox1
        f_processCandles(htfCndl1, htfBox1, shortTf1, b1_showPrice, b1_bullC, b1_bearC, b1_trans, b1_width, b1_sO, b1_cO, b1_wO, get_line_style(b1_stInO), get_label_size(b1_szO), b1_sH, b1_cH, b1_wH, get_line_style(b1_stInH), get_label_size(b1_szH), b1_sL, b1_cL, b1_wL, get_line_style(b1_stInL), get_label_size(b1_szL), b1_sC, b1_cC, b1_wC, get_line_style(b1_stInC), get_label_size(b1_szC))
    if supportedBox2
        f_processCandles(htfCndl2, htfBox2, shortTf2, b2_showPrice, b2_bullC, b2_bearC, b2_trans, b2_width, b2_sO, b2_cO, b2_wO, get_line_style(b2_stInO), get_label_size(b2_szO), b2_sH, b2_cH, b2_wH, get_line_style(b2_stInH), get_label_size(b2_szH), b2_sL, b2_cL, b2_wL, get_line_style(b2_stInL), get_label_size(b2_szL), b2_sC, b2_cC, b2_wC, get_line_style(b2_stInC), get_label_size(b2_szC))
    if supportedBox3
        f_processCandles(htfCndl3, htfBox3, shortTf3, b3_showPrice, b3_bullC, b3_bearC, b3_trans, b3_width, b3_sO, b3_cO, b3_wO, get_line_style(b3_stInO), get_label_size(b3_szO), b3_sH, b3_cH, b3_wH, get_line_style(b3_stInH), get_label_size(b3_szH), b3_sL, b3_cL, b3_wL, get_line_style(b3_stInL), get_label_size(b3_szL), b3_sC, b3_cC, b3_wC, get_line_style(b3_stInC), get_label_size(b3_szC))
