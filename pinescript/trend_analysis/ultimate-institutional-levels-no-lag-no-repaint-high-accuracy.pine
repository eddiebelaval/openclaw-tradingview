//@version=5
indicator("SPY Levels – Hard Render Table", overlay=true)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SETTINGS
decimals = input.int(2, "Decimals")

f_fmt(x) =>
    str.tostring(math.round(x * math.pow(10, decimals)) / math.pow(10, decimals))

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DAILY DATA
pdH = request.security(syminfo.tickerid, "D", high[1])
pdL = request.security(syminfo.tickerid, "D", low[1])
pdC = request.security(syminfo.tickerid, "D", close[1])
todayOpen = request.security(syminfo.tickerid, "D", open)

pwH = request.security(syminfo.tickerid, "W", high[1])
pwL = request.security(syminfo.tickerid, "W", low[1])

ema20  = request.security(syminfo.tickerid, "D", ta.ema(close, 20))
sma50  = request.security(syminfo.tickerid, "D", ta.sma(close, 50))
sma200 = request.security(syminfo.tickerid, "D", ta.sma(close, 200))

pivot = (pdH + pdL + pdC) / 3
r1 = 2 * pivot - pdL
s1 = 2 * pivot - pdH

vwapValue = ta.vwap(hlc3)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TABLE STYLE (LIGHT & READABLE)

headerColor = color.rgb(210, 210, 210)
colShade    = color.rgb(235, 235, 235)
rowLight    = color.rgb(250, 250, 250)
rowDark     = color.rgb(240, 240, 240)

rowBg(r) =>
    (r % 2 == 0) ? rowLight : rowDark

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🔥 HORIZONTAL LINES (UNCHANGED)

var line l_pdH = na
var line l_pdL = na
var line l_open = na
var line l_pivot = na
var line l_r1 = na
var line l_s1 = na
var line l_pwH = na
var line l_pwL = na
var line l_ema20 = na
var line l_sma50 = na
var line l_sma200 = na
var line l_vwap = na

// ➕ LABEL VARIABLES
var label lab_pdH = na
var label lab_pdL = na
var label lab_open = na
var label lab_pivot = na
var label lab_r1 = na
var label lab_s1 = na
var label lab_pwH = na
var label lab_pwL = na
var label lab_ema20 = na
var label lab_sma50 = na
var label lab_sma200 = na
var label lab_vwap = na

if barstate.islast

    l_pdH     := line.new(bar_index-1, pdH, bar_index, pdH, extend=extend.right, color=color.red, width=2)
    l_pdL     := line.new(bar_index-1, pdL, bar_index, pdL, extend=extend.right, color=color.green, width=2)
    l_open    := line.new(bar_index-1, todayOpen, bar_index, todayOpen, extend=extend.right, color=color.yellow, width=2)

    l_pivot   := line.new(bar_index-1, pivot, bar_index, pivot, extend=extend.right, color=color.orange, width=2)
    l_r1      := line.new(bar_index-1, r1, bar_index, r1, extend=extend.right, color=color.orange, width=1)
    l_s1      := line.new(bar_index-1, s1, bar_index, s1, extend=extend.right, color=color.orange, width=1)

    l_pwH     := line.new(bar_index-1, pwH, bar_index, pwH, extend=extend.right, color=color.fuchsia, width=2)
    l_pwL     := line.new(bar_index-1, pwL, bar_index, pwL, extend=extend.right, color=color.purple, width=2)

    l_ema20   := line.new(bar_index-1, ema20, bar_index, ema20, extend=extend.right, color=color.blue, width=2)
    l_sma50   := line.new(bar_index-1, sma50, bar_index, sma50, extend=extend.right, color=color.blue, width=3)
    l_sma200  := line.new(bar_index-1, sma200, bar_index, sma200, extend=extend.right, color=color.navy, width=3)

    l_vwap    := line.new(bar_index-1, vwapValue, bar_index, vwapValue, extend=extend.right, color=color.teal, width=2)

    label.delete(lab_pdH)
    label.delete(lab_pdL)
    label.delete(lab_open)
    label.delete(lab_pivot)
    label.delete(lab_r1)
    label.delete(lab_s1)
    label.delete(lab_pwH)
    label.delete(lab_pwL)
    label.delete(lab_ema20)
    label.delete(lab_sma50)
    label.delete(lab_sma200)
    label.delete(lab_vwap)

    lab_pdH     := label.new(bar_index, pdH, "PDH " + f_fmt(pdH), style=label.style_label_right, color=color.red, textcolor=color.white)
    lab_pdL     := label.new(bar_index, pdL, "PDL " + f_fmt(pdL), style=label.style_label_right, color=color.green, textcolor=color.white)
    lab_open    := label.new(bar_index, todayOpen, "OPEN " + f_fmt(todayOpen), style=label.style_label_right, color=color.yellow, textcolor=color.black)

    lab_pivot   := label.new(bar_index, pivot, "PIVOT " + f_fmt(pivot), style=label.style_label_right, color=color.orange, textcolor=color.white)
    lab_r1      := label.new(bar_index, r1, "R1 " + f_fmt(r1), style=label.style_label_right, color=color.orange, textcolor=color.white)
    lab_s1      := label.new(bar_index, s1, "S1 " + f_fmt(s1), style=label.style_label_right, color=color.orange, textcolor=color.white)

    lab_pwH     := label.new(bar_index, pwH, "PWH " + f_fmt(pwH), style=label.style_label_right, color=color.fuchsia, textcolor=color.white)
    lab_pwL     := label.new(bar_index, pwL, "PWL " + f_fmt(pwL), style=label.style_label_right, color=color.purple, textcolor=color.white)

    lab_ema20   := label.new(bar_index, ema20, "EMA20 " + f_fmt(ema20), style=label.style_label_right, color=color.blue, textcolor=color.white)
    lab_sma50   := label.new(bar_index, sma50, "SMA50 " + f_fmt(sma50), style=label.style_label_right, color=color.blue, textcolor=color.white)
    lab_sma200  := label.new(bar_index, sma200, "SMA200 " + f_fmt(sma200), style=label.style_label_right, color=color.navy, textcolor=color.white)

    lab_vwap    := label.new(bar_index, vwapValue, "VWAP " + f_fmt(vwapValue), style=label.style_label_right, color=color.teal, textcolor=color.white)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CREATE TABLE
var table t = table.new(position.top_right, 3, 14, border_width=2)

if barstate.islast

    table.cell(t, 0, 0, "LEVEL", bgcolor=headerColor, text_color=color.black)
    table.cell(t, 1, 0, "PRICE", bgcolor=headerColor, text_color=color.black)
    table.cell(t, 2, 0, "DIST",  bgcolor=headerColor, text_color=color.black)

    table.cell(t, 0, 1, "NOW", bgcolor=rowBg(1))
    table.cell(t, 1, 1, f_fmt(close), bgcolor=colShade)
    table.cell(t, 2, 1, "", bgcolor=rowBg(1))

    d = close - todayOpen
    table.cell(t, 0, 2, "Today Open", bgcolor=rowBg(2))
    table.cell(t, 1, 2, f_fmt(todayOpen), bgcolor=colShade)
    table.cell(t, 2, 2, (d > 0 ? "▲ " : "▼ ") + f_fmt(math.abs(d)), bgcolor=rowBg(2))

    d := close - pdH
    table.cell(t, 0, 3, "PD High", bgcolor=rowBg(3))
    table.cell(t, 1, 3, f_fmt(pdH), bgcolor=colShade)
    table.cell(t, 2, 3, (d > 0 ? "▲ " : "▼ ") + f_fmt(math.abs(d)), bgcolor=rowBg(3))

    d := close - pdL
    table.cell(t, 0, 4, "PD Low", bgcolor=rowBg(4))
    table.cell(t, 1, 4, f_fmt(pdL), bgcolor=colShade)
    table.cell(t, 2, 4, (d > 0 ? "▲ " : "▼ ") + f_fmt(math.abs(d)), bgcolor=rowBg(4))

    d := close - pivot
    table.cell(t, 0, 5, "Pivot", bgcolor=rowBg(5))
    table.cell(t, 1, 5, f_fmt(pivot), bgcolor=colShade)
    table.cell(t, 2, 5, (d > 0 ? "▲ " : "▼ ") + f_fmt(math.abs(d)), bgcolor=rowBg(5))

    d := close - r1
    table.cell(t, 0, 6, "R1", bgcolor=rowBg(6))
    table.cell(t, 1, 6, f_fmt(r1), bgcolor=colShade)
    table.cell(t, 2, 6, (d > 0 ? "▲ " : "▼ ") + f_fmt(math.abs(d)), bgcolor=rowBg(6))

    d := close - s1
    table.cell(t, 0, 7, "S1", bgcolor=rowBg(7))
    table.cell(t, 1, 7, f_fmt(s1), bgcolor=colShade)
    table.cell(t, 2, 7, (d > 0 ? "▲ " : "▼ ") + f_fmt(math.abs(d)), bgcolor=rowBg(7))

    d := close - pwH
    table.cell(t, 0, 8, "PW High", bgcolor=rowBg(8))
    table.cell(t, 1, 8, f_fmt(pwH), bgcolor=colShade)
    table.cell(t, 2, 8, (d > 0 ? "▲ " : "▼ ") + f_fmt(math.abs(d)), bgcolor=rowBg(8))

    d := close - pwL
    table.cell(t, 0, 9, "PW Low", bgcolor=rowBg(9))
    table.cell(t, 1, 9, f_fmt(pwL), bgcolor=colShade)
    table.cell(t, 2, 9, (d > 0 ? "▲ " : "▼ ") + f_fmt(math.abs(d)), bgcolor=rowBg(9))

    d := close - ema20
    table.cell(t, 0, 10, "EMA20 (D)", bgcolor=rowBg(10))
    table.cell(t, 1, 10, f_fmt(ema20), bgcolor=colShade)
    table.cell(t, 2, 10, (d > 0 ? "▲ " : "▼ ") + f_fmt(math.abs(d)), bgcolor=rowBg(10))

    d := close - sma50
    table.cell(t, 0, 11, "SMA50 (D)", bgcolor=rowBg(11))
    table.cell(t, 1, 11, f_fmt(sma50), bgcolor=colShade)
    table.cell(t, 2, 11, (d > 0 ? "▲ " : "▼ ") + f_fmt(math.abs(d)), bgcolor=rowBg(11))

    d := close - sma200
    table.cell(t, 0, 12, "SMA200 (D)", bgcolor=rowBg(12))
    table.cell(t, 1, 12, f_fmt(sma200), bgcolor=colShade)
    table.cell(t, 2, 12, (d > 0 ? "▲ " : "▼ ") + f_fmt(math.abs(d)), bgcolor=rowBg(12))

    d := close - vwapValue
    table.cell(t, 0, 13, "VWAP", bgcolor=rowBg(13))
    table.cell(t, 1, 13, f_fmt(vwapValue), bgcolor=colShade)
    table.cell(t, 2, 13, (d > 0 ? "▲ " : "▼ ") + f_fmt(math.abs(d)), bgcolor=rowBg(13))
