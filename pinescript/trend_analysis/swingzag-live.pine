//@version=6
indicator("SwingZag Live", overlay=true)

// --- Inputs ---
group_colors = "Visual Settings"
sl_color     = input.color(color.red, "Swing Low Color", group=group_colors)
sh_color     = input.color(color.green, "Swing High Color", group=group_colors)
line_color   = input.color(color.white, "ZigZag Line Color", group=group_colors)
line_width   = input.int(1, "Line Width", minval=1, group=group_colors)

///swings////
var float current_ext_low = na
var int ext_low_bar_index = na
var float current_ext_high = na
var int ext_high_bar_index = na

//zigzag///
var float last_confirmed_price = na
var int last_confirmed_index = na

var bool looking_for_sl = true

///alertcondition///
bool alert_sl = false
bool alert_sh = false

//SWING LOW LOGIC///
if low < current_ext_low or na(current_ext_low)
    current_ext_low := low          
    ext_low_bar_index := bar_index  

if looking_for_sl and not na(current_ext_low) and close > high[1]
    label.new(ext_low_bar_index, current_ext_low, "SL", style=label.style_none, textcolor=sl_color, yloc=yloc.belowbar, size=size.normal)
    
    if not na(last_confirmed_price)
        line.new(last_confirmed_index, last_confirmed_price, ext_low_bar_index, current_ext_low, color=line_color, width=line_width)
    
    alert_sl := true
    
    last_confirmed_price := current_ext_low
    last_confirmed_index := ext_low_bar_index
    looking_for_sl := false
    current_ext_low := na         
    current_ext_high := high      
    ext_high_bar_index := bar_index

//SWING HIGH LOGIC///
if high > current_ext_high or na(current_ext_high)
    current_ext_high := high          
    ext_high_bar_index := bar_index  

if not looking_for_sl and not na(current_ext_high) and close < low[1]
    label.new(ext_high_bar_index, current_ext_high, "SH", style=label.style_none, textcolor=sh_color, yloc=yloc.abovebar, size=size.normal)
    
    if not na(last_confirmed_price)
        line.new(last_confirmed_index, last_confirmed_price, ext_high_bar_index, current_ext_high, color=line_color, width=line_width)

    alert_sh := true

    last_confirmed_price := current_ext_high
    last_confirmed_index := ext_high_bar_index
    looking_for_sl := true
    current_ext_high := na         
    current_ext_low := low         
    ext_low_bar_index := bar_index

///Alert Conditions///
alertcondition(alert_sl, title="New Swing Low (SL)", message="Swing Low confirmed")
alertcondition(alert_sh, title="New Swing High (SH)", message="Swing High confirmed")
