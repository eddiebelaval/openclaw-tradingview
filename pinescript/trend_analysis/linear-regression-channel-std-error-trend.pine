//@version=5
indicator("Linear Regression Channel (Std Error) & Trend", shorttitle="LinReg Channel", overlay=true)

// --- Settings ---
length = input.int(100, title="Length", minval=1)
mult = input.float(2.0, title="Multiplier (Standard Error)", step=0.1)
src = input.source(close, title="Source")

// --- Calculations ---
linreg_y = ta.linreg(src, length, 0)
deviation = ta.stdev(src, length)

upper = linreg_y + (deviation * mult)
lower = linreg_y - (deviation * mult)

// หาความชัน (Slope)
slope = linreg_y - linreg_y[1]
isBullish = slope > 0
isBearish = slope < 0

// กำหนดสี
lineColor = isBullish ? color.green : color.red
// ปรับสีพื้นหลังให้อ่อนลงอีกนิด (85 -> 92) เพื่อไม่ให้แย่งสายตากับป้าย UP/DN
fillColor = isBullish ? color.new(color.green, 92) : color.new(color.red, 92)

// --- Logic สำหรับเปลี่ยนข้อความ (Trend Logic) ---
trendUp = isBullish and isBearish[1]
trendDown = isBearish and isBullish[1]

// --- Plotting ---
plot(linreg_y, title="Basis (LinReg)", color=lineColor, linewidth=2)
u = plot(upper, title="Upper Band", color=color.new(color.red, 50))
l = plot(lower, title="Lower Band", color=color.new(color.green, 50))
fill(u, l, title="Background", color=fillColor)

// --- Visual Signals (ปรับให้เล็กลง) ---
// เปลี่ยนเป็น shape.triangleup/down และย่อข้อความเหลือ UP/DN
plotshape(trendUp, title="Bullish Trend", location=location.belowbar, color=color.green, style=shape.triangleup, text="UP", textcolor=color.green, size=size.tiny)
plotshape(trendDown, title="Bearish Trend", location=location.abovebar, color=color.red, style=shape.triangledown, text="DN", textcolor=color.red, size=size.tiny)

// --- Alerts ---
alertcondition(ta.crossover(src, lower), title="Price Cross Lower", message="Price crossed ABOVE Lower Band")
alertcondition(ta.crossunder(src, upper), title="Price Cross Upper", message="Price crossed BELOW Upper Band")

alertcondition(trendUp, title="Trend Change: UP", message="Trend turned UP (Slope Positive)")
alertcondition(trendDown, title="Trend Change: DOWN", message="Trend turned DOWN (Slope Negative)")
