// This script does NOT use future data.
// All higher timeframe values use lookahead_off.
// Designed for educational purposes.
//@version=5
indicator("Clever Market Structure Toolkit", "CMS [CLEVER]", overlay=true, max_lines_count=300, max_boxes_count=300, max_labels_count=300)

// --- Settings ---
grp_st = "Market Structure (Swing & Internal)"
swing_len = input.int(7, "Swing Lookback", minval=1, group=grp_st)
internal_len = input.int(3, "Internal Lookback", minval=1, group=grp_st)
show_bos = input.bool(true, "Show Swing Structure", group=grp_st)
show_int_bos = input.bool(true, "Show Internal Structure", group=grp_st)
bos_col_bull = input.color(color.new(#00ffbb, 0), "BOS/iBOS Bullish", group=grp_st)
bos_col_bear = input.color(color.new(#ff0055, 0), "BOS/iBOS Bearish", group=grp_st)
show_str_lbls = input.bool(true, "Show Structural Labels (SH, HH, etc.)", group=grp_st)
st_sh_sl_col = input.color(color.new(#ffeb3b, 0), "Strong High/Low Color", group=grp_st)
st_wh_wl_col = input.color(color.new(#ff5252, 0), "Weak High/Low Color", group=grp_st)
st_sm_col = input.color(color.new(#ffffff, 0), "Standard High/Low Color", group=grp_st)
show_strong_only_lbls = input.bool(false, "Show Strong Points Only (SH/SL)", group=grp_st)
high_style_n = input.string("None", "High Points Style", options=["None", "Label Down", "Circle", "Square", "Diamond", "Triangle Down"], group=grp_st)
low_style_n = input.string("None", "Low Points Style", options=["None", "Label Up", "Circle", "Square", "Diamond", "Triangle Up"], group=grp_st)
show_idm = input.bool(true, "Show Inducement (IDM)", group=grp_st)
idm_col = input.color(color.new(#e91e63, 0), "Inducement Color", group=grp_st)

// Mapping styles (fixed triangular names)
get_sty(s) =>
    switch s
        "Label Down"    => label.style_label_down
        "Label Up"      => label.style_label_up
        "Circle"        => label.style_circle
        "Square"        => label.style_square
        "Diamond"       => label.style_diamond
        "Triangle Down" => label.style_triangledown
        "Triangle Up"   => label.style_triangleup
        => label.style_none

h_sty = get_sty(high_style_n)
l_sty = get_sty(low_style_n)

grp_pda = "PD Arrays (OB & FVG)"
show_ob = input.bool(true, "Show Order Blocks", group=grp_pda)
show_strong_only = input.bool(true, "Show Only Strong OBs (Swing)", group=grp_pda)
ob_mitigation = input.bool(true, "Hide Mitigated OBs", group=grp_pda)
ob_col_bull = input.color(color.new(#2196f3, 80), "Bullish OB", group=grp_pda)
ob_col_bear = input.color(color.new(#ff9800, 80), "Bearish OB", group=grp_pda)
show_fvg = input.bool(true, "Show FVG", group=grp_pda)
fvg_col_bull = input.color(color.new(#4caf50, 85), "Bullish FVG", group=grp_pda)
fvg_col_bear = input.color(color.new(#f44336, 85), "Bearish FVG", group=grp_pda)
fvg_txt_col_bull = input.color(color.new(color.white, 20), "Bullish FVG Text", group=grp_pda)
fvg_txt_col_bear = input.color(color.new(color.white, 20), "Bearish FVG Text", group=grp_pda)
pda_extend = input.int(10, "Extension Bars", minval=1, group=grp_pda)

grp_liq = "Liquidity & Zones"
show_eq = input.bool(true, "Show EQH/EQL", group=grp_liq)
eqh_col = input.color(color.new(#ffffff, 50), "EQH Color", group=grp_liq)
eql_col = input.color(color.new(#ffffff, 50), "EQL Color", group=grp_liq)
eqh_style_n = input.string("Label Down", "EQH Style", options=["None", "Label Down", "Label Up", "Circle", "Square", "Diamond", "Triangle Down", "Triangle Up"], group=grp_liq)
eql_style_n = input.string("Label Up", "EQL Style", options=["None", "Label Down", "Label Up", "Circle", "Square", "Diamond", "Triangle Down", "Triangle Up"], group=grp_liq)
show_pd_zones = input.bool(true, "Show Premium/Discount", group=grp_liq)
premium_col = input.color(color.new(#f44336, 90), "Premium Color", group=grp_liq)
discount_col = input.color(color.new(#4caf50, 90), "Discount Color", group=grp_liq)
eq_col = input.color(color.new(color.gray, 50), "Equilibrium Color", group=grp_liq)
zone_thickness = input.int(10, "Zone Thickness %", minval=1, maxval=25, group=grp_liq)
zone_extension = input.int(40, "Zone Extension (Bars)", minval=1, maxval=200, group=grp_liq)
show_pd_bars = input.bool(true, "Color Bars by PD Zone", group=grp_liq)

grp_periodic = "Periodic Highs/Lows"
show_daily = input.bool(true, "Show Daily High/Low", group=grp_periodic)
daily_col = input.color(color.new(color.orange, 50), "Daily H/L Color", group=grp_periodic)
show_weekly = input.bool(true, "Show Weekly High/Low", group=grp_periodic)
weekly_col = input.color(color.new(color.blue, 50), "Weekly H/L Color", group=grp_periodic)

grp_foot = "Institutional Footprints"
show_sweeps = input.bool(true, "Show Liquidity Sweeps", group=grp_foot)
sweeps_col = input.color(color.new(#ffeb3b, 0), "Sweeps Color", group=grp_foot)
show_funding = input.bool(true, "Show Institutional Funding (?)", group=grp_foot)
funding_col = input.color(color.new(#00e676, 0), "Funding Color", group=grp_foot)
v_mult = input.float(1.5, "Volume Multiplier", minval=1.1, step=0.1, group=grp_foot)
r_mult = input.float(1.5, "Range Multiplier (ATR)", minval=1.1, step=0.1, group=grp_foot)

type OB
    box b
    float t
    float b_p
    bool m

type FVG_T
    box b
    float t
    float b_p
    bool m

// --- Pivot Detection ---
ph_s = ta.pivothigh(high, swing_len, swing_len)
pl_s = ta.pivotlow(low, swing_len, swing_len)
ph_i = ta.pivothigh(high, internal_len, internal_len)
pl_i = ta.pivotlow(low, internal_len, internal_len)

// State Variables
var float last_swing_h = na, var float last_swing_l = na
var int last_swing_h_idx = na, var int last_swing_l_idx = na
var int trend = 0 

var float last_int_h = na, var float last_int_l = na
var int last_int_h_idx = na, var int last_int_l_idx = na
var int int_trend = 0
var float range_h = na, var float range_l = na
var int range_h_idx = na, var int range_l_idx = na

// IDM Tracking
var float idm_level = na
var int idm_idx = na
var line idm_line = line(na)
var label idm_lbl = label(na)
var bool idm_taken = false

// Structural Labels
var s_h_lb = label(na), var s_l_lb = label(na)
var float p_ph = na, var float p_pl = na

// OB & FVG Lists
var ob_bulls = array.new<OB>(), var ob_bears = array.new<OB>()
var fvg_bulls = array.new<FVG_T>(), var fvg_bears = array.new<FVG_T>()

// --- Swing Structural Logic ---
// --- Swing Structural Logic ---
if not na(ph_s)
    is_hh = ph_s > p_ph
    txt = is_hh ? "HH" : "LH"
    if show_str_lbls and not show_strong_only_lbls
        label.delete(s_h_lb)
        c = h_sty == label.style_none ? color.new(color.white, 100) : st_sm_col
        tc = h_sty == label.style_none ? st_sm_col : color.white
        s_h_lb := label.new(bar_index[swing_len], ph_s, txt, yloc=yloc.abovebar, color=c, textcolor=tc, style=h_sty, size=size.small)
    p_ph := ph_s, last_swing_h := ph_s, last_swing_h_idx := bar_index[swing_len]

if not na(pl_s)
    is_hl = pl_s > p_pl
    txt = is_hl ? "HL" : "LL"
    if show_str_lbls and not show_strong_only_lbls
        label.delete(s_l_lb)
        c = l_sty == label.style_none ? color.new(color.white, 100) : st_sm_col
        tc = l_sty == label.style_none ? st_sm_col : color.white
        s_l_lb := label.new(bar_index[swing_len], pl_s, txt, yloc=yloc.belowbar, color=c, textcolor=tc, style=l_sty, size=size.small)
    p_pl := pl_s, last_swing_l := pl_s, last_swing_l_idx := bar_index[swing_len]

// --- Internal Pivot Logic ---
if not na(ph_i)
    last_int_h := ph_i, last_int_h_idx := bar_index[internal_len]
if not na(pl_i)
    last_int_l := pl_i, last_int_l_idx := bar_index[internal_len]

// --- IDM Detection Logic ---
if show_idm
    cur_trend = trend != 0 ? trend : int_trend
    
    // Find latest pivots with historical fallback
    latest_pl = ta.valuewhen(not na(pl_i), pl_i, 0)
    latest_pl_idx = ta.valuewhen(not na(pl_i), bar_index[internal_len], 0)
    latest_ph = ta.valuewhen(not na(ph_i), ph_i, 0)
    latest_ph_idx = ta.valuewhen(not na(ph_i), bar_index[internal_len], 0)
    
    // Determine target based on trend or fallback to most recent
    new_idm_level = cur_trend == 1 or (cur_trend == 0 and latest_pl_idx > latest_ph_idx) ? latest_pl : latest_ph
    new_idm_idx = cur_trend == 1 or (cur_trend == 0 and latest_pl_idx > latest_ph_idx) ? latest_pl_idx : latest_ph_idx
    
    // Safety check for indices
    if not na(new_idm_idx) and new_idm_idx < 0
        new_idm_idx := 0

    // Update state if new IDM found
    if not na(new_idm_level) and (na(idm_level) or new_idm_level != idm_level or new_idm_idx != idm_idx)
        idm_level := new_idm_level
        idm_idx := new_idm_idx
        idm_taken := false
        line.delete(idm_line)
        label.delete(idm_lbl)

    // Drawing and Sweeping
    if not na(idm_level) and not na(idm_idx)
        is_taken = cur_trend == 1 ? low < idm_level : (cur_trend == -1 ? high > idm_level : false)
        
        if is_taken and not idm_taken
            idm_taken := true
            line.set_x2(idm_line, bar_index)
            line.set_color(idm_line, color.new(idm_col, 50))
            line.set_style(idm_line, line.style_dashed)
            label.set_x(idm_lbl, bar_index)
            label.set_text(idm_lbl, "IDM Swept")
        else if not idm_taken
            line.delete(idm_line)
            label.delete(idm_lbl)
            idm_line := line.new(idm_idx, idm_level, bar_index + zone_extension, idm_level, color=idm_col, style=line.style_solid, width=2)
            idm_lbl := label.new(idm_idx, idm_level, "IDM", yloc=cur_trend == 1 ? yloc.belowbar : yloc.abovebar, color=color.new(color.white, 100), textcolor=idm_col, style=label.style_none, size=size.small)

// --- BOS / CHoCH Logic ---

// Internal Bullish
if show_int_bos and not na(last_int_h) and close > last_int_h and ta.crossover(close, last_int_h)
    is_ic = int_trend == -1
    mx = math.round(math.avg(last_int_h_idx, bar_index))
    line.new(last_int_h_idx, last_int_h, bar_index, last_int_h, color=color.new(bos_col_bull, 50), style=line.style_dotted)
    label.new(mx, last_int_h, is_ic ? "iCHoCH" : "iBOS", color=color.new(color.white, 100), textcolor=color.new(bos_col_bull, 30), style=label.style_none, size=size.tiny)
    
    // Only draw Internal OB if Strong-Only filter is OFF
    if show_ob and not show_strong_only
        for i = 1 to 10
            if close[i] < open[i]
                bx = box.new(bar_index[i], high[i], bar_index + 10, low[i], bgcolor=ob_col_bull, border_color=na, text="iOB+", text_size=size.normal, text_color=color.white)
                array.push(ob_bulls, OB.new(bx, high[i], low[i], false))
                break
    int_trend := 1, last_int_h := na

// Internal Bearish
if show_int_bos and not na(last_int_l) and close < last_int_l and ta.crossunder(close, last_int_l)
    is_ic = int_trend == 1
    mx = math.round(math.avg(last_int_l_idx, bar_index))
    line.new(last_int_l_idx, last_int_l, bar_index, last_int_l, color=color.new(bos_col_bear, 50), style=line.style_dotted)
    label.new(mx, last_int_l, is_ic ? "iCHoCH" : "iBOS", color=color.new(color.white, 100), textcolor=color.new(bos_col_bear, 30), style=label.style_none, size=size.tiny)
    
    // Only draw Internal OB if Strong-Only filter is OFF
    if show_ob and not show_strong_only
        for i = 1 to 10
            if close[i] > open[i]
                bx = box.new(bar_index[i], high[i], bar_index + 10, low[i], bgcolor=ob_col_bear, border_color=na, text="iOB-", text_size=size.normal, text_color=color.white)
                array.push(ob_bears, OB.new(bx, high[i], low[i], false))
                break
    int_trend := -1, last_int_l := na

// Swing Bullish Check (ALWAYS Strong)
if not na(last_swing_h) and close > last_swing_h and ta.crossover(close, last_swing_h)
    is_c = trend == -1
    label_txt = is_c ? "CHoCH" : "BOS"
    if show_bos
        mx = math.round(math.avg(last_swing_h_idx, bar_index))
        line.new(last_swing_h_idx, last_swing_h, bar_index, last_swing_h, color=bos_col_bull, style=line.style_dashed)
        label.new(mx, last_swing_h, label_txt, color=color.new(color.white, 100), textcolor=bos_col_bull, style=label.style_none, size=size.small)
    if show_ob
        for i = 1 to 15
            if close[i] < open[i]
                bx = box.new(bar_index[i], high[i], bar_index + 10, low[i], bgcolor=ob_col_bull, border_color=na, text="OB+", text_size=size.normal, text_color=color.white)
                array.push(ob_bulls, OB.new(bx, high[i], low[i], false))
                break
    if show_str_lbls
        label.set_text(s_l_lb, "SL")
        label.set_color(s_l_lb, l_sty == label.style_none ? color.new(color.white, 100) : st_sh_sl_col)
        label.set_textcolor(s_l_lb, l_sty == label.style_none ? st_sh_sl_col : color.white)
        
        if not show_strong_only_lbls
            label.set_text(s_h_lb, "WH")
            label.set_color(s_h_lb, h_sty == label.style_none ? color.new(color.white, 100) : st_wh_wl_col)
            label.set_textcolor(s_h_lb, h_sty == label.style_none ? st_wh_wl_col : color.white)
        else
            label.delete(s_h_lb)
    trend := 1, last_swing_h := na
    range_l := last_swing_l, range_l_idx := last_swing_l_idx
    range_h := high, range_h_idx := bar_index

// Swing Bearish Check (ALWAYS Strong)
if not na(last_swing_l) and close < last_swing_l and ta.crossunder(close, last_swing_l)
    is_c = trend == 1
    label_txt = is_c ? "CHoCH" : "BOS"
    if show_bos
        mx = math.round(math.avg(last_swing_l_idx, bar_index))
        line.new(last_swing_l_idx, last_swing_l, bar_index, last_swing_l, color=bos_col_bear, style=line.style_dashed)
        label.new(mx, last_swing_l, label_txt, color=color.new(color.white, 100), textcolor=bos_col_bear, style=label.style_none, size=size.small)
    if show_ob
        for i = 1 to 15
            if close[i] > open[i]
                bx = box.new(bar_index[i], high[i], bar_index + 10, low[i], bgcolor=ob_col_bear, border_color=na, text="OB-", text_size=size.normal, text_color=color.white)
                array.push(ob_bears, OB.new(bx, high[i], low[i], false))
                break
    if show_str_lbls
        label.set_text(s_h_lb, "SH")
        label.set_color(s_h_lb, h_sty == label.style_none ? color.new(color.white, 100) : st_sh_sl_col)
        label.set_textcolor(s_h_lb, h_sty == label.style_none ? st_sh_sl_col : color.white)
        
        if not show_strong_only_lbls
            label.set_text(s_l_lb, "WL")
            label.set_color(s_l_lb, l_sty == label.style_none ? color.new(color.white, 100) : st_wh_wl_col)
            label.set_textcolor(s_l_lb, l_sty == label.style_none ? st_wh_wl_col : color.white)
        else
            label.delete(s_l_lb)
    trend := -1, last_swing_l := na
    range_h := last_swing_h, range_h_idx := last_swing_h_idx
    range_l := low, range_l_idx := bar_index

// --- Live Range Expansion ---
if trend == 1 and high > range_h
    range_h := high
    range_h_idx := bar_index
if trend == -1 and low < range_l
    range_l := low
    range_l_idx := bar_index

// --- Mitigation Logic ---
if show_ob
    if array.size(ob_bulls) > 0
        for i = array.size(ob_bulls) - 1 to 0
            o = array.get(ob_bulls, i)
            if not o.m
                if low < o.b_p
                    if ob_mitigation
                        box.delete(o.b)
                    o.m := true
                else
                    box.set_right(o.b, bar_index + pda_extend)
    if array.size(ob_bears) > 0
        for i = array.size(ob_bears) - 1 to 0
            o = array.get(ob_bears, i)
            if not o.m
                if high > o.t
                    if ob_mitigation
                        box.delete(o.b)
                    o.m := true
                else
                    box.set_right(o.b, bar_index + pda_extend)

// FVG Implementation & Mitigation
if show_fvg
    if low > high[2] and close[1] > high[2]
        bx = box.new(bar_index[2], low, bar_index + 2, high[2], bgcolor=fvg_col_bull, border_color=na, text="FVG", text_size=size.tiny, text_color=fvg_txt_col_bull)
        array.push(fvg_bulls, FVG_T.new(bx, low, high[2], false))
    if high < low[2] and close[1] < low[2]
        bx = box.new(bar_index[2], low[2], bar_index + 2, high, bgcolor=fvg_col_bear, border_color=na, text="FVG", text_size=size.tiny, text_color=fvg_txt_col_bear)
        array.push(fvg_bears, FVG_T.new(bx, low[2], high, false))

    if array.size(fvg_bulls) > 0
        for i = array.size(fvg_bulls) - 1 to 0
            f = array.get(fvg_bulls, i)
            if not f.m and low < f.b_p
                box.delete(f.b), f.m := true
    if array.size(fvg_bears) > 0
        for i = array.size(fvg_bears) - 1 to 0
            f = array.get(fvg_bears, i)
            if not f.m and high > f.t
                box.delete(f.b), f.m := true

// --- Premium & Discount Zones ---
var p_b = box(na), var d_b = box(na), var e_l = line(na)
var p_h_b = box(na), var d_l_b = box(na), var e_m_b = box(na)
var p_lbl = label(na), var d_lbl = label(na), var e_lbl = label(na)

if show_pd_zones and not na(range_h) and not na(range_l)
    box.delete(p_b), box.delete(d_b), line.delete(e_l)
    box.delete(p_h_b), box.delete(d_l_b), box.delete(e_m_b)
    label.delete(p_lbl), label.delete(d_lbl), label.delete(e_lbl)
    
    m = math.avg(range_h, range_l)
    r_size = range_h - range_l
    thick = r_size * (zone_thickness / 100)
    lx = math.min(range_h_idx, range_l_idx), rx = bar_index + zone_extension
    
    // Transparent versions for overall bg fills (derived from user transparency)
    p_trans = color.t(premium_col), d_trans = color.t(discount_col)
    p_bg_faint = color.new(premium_col, math.min(100, p_trans + 40))
    d_bg_faint = color.new(discount_col, math.min(100, d_trans + 40))
    
    // Solid version for highlight boxes (Exactly as chosen by user)
    p_bg_solid = premium_col
    d_bg_solid = discount_col
    e_bg_solid = eq_col
    
    // Borders (Solid versions of chosen color)
    p_brd = color.new(premium_col, 0)
    d_brd = color.new(discount_col, 0)
    e_brd = color.new(eq_col, 0)

    // 1. Overall Backgrounds (faint)
    p_b := box.new(lx, range_h, rx, m, bgcolor=p_bg_faint, border_color=na)
    d_b := box.new(lx, m, rx, range_l, bgcolor=d_bg_faint, border_color=na)
    
    // 2. Highlight Zones (Premium Top, Discount Bottom, Equilibrium Mid)
    p_h_b := box.new(lx, range_h, rx, range_h - thick, bgcolor=p_bg_solid, border_color=p_brd, border_width=1)
    d_l_b := box.new(lx, range_l + thick, rx, range_l, bgcolor=d_bg_solid, border_color=d_brd, border_width=1)
    e_m_b := box.new(lx, m + (thick/2), rx, m - (thick/2), bgcolor=e_bg_solid, border_color=e_brd, border_width=1)
    
    // 3. Equilibrium Line
    e_l := line.new(lx, m, rx, m, color=eq_col, style=line.style_dashed, width=1)
    
    // 4. Labels
    p_lbl := label.new(rx, range_h - (thick/2), "Premium\n" + str.tostring(range_h, format.mintick), color=p_brd, textcolor=color.white, style=label.style_label_left, size=size.small)
    d_lbl := label.new(rx, range_l + (thick/2), "Discount\n" + str.tostring(range_l, format.mintick), color=d_brd, textcolor=color.white, style=label.style_label_left, size=size.small)
    e_lbl := label.new(rx, m, "Equilibrium\n" + str.tostring(m, format.mintick), color=e_brd, textcolor=color.white, style=label.style_label_left, size=size.small)

// --- Bar Coloring ---
pd_m = math.avg(range_h, range_l)
pd_b_col = show_pd_bars and not na(range_h) and not na(range_l) ? (close > pd_m ? premium_col : close < pd_m ? discount_col : eq_col) : na
barcolor(pd_b_col)

// --- Equal Highs/Lows ---
if show_eq
    eqh_sty = get_sty(eqh_style_n)
    eql_sty = get_sty(eql_style_n)
    if not na(ph_s) and not na(last_swing_h) and math.abs(ph_s - last_swing_h) < (close * 0.001)
        c = eqh_sty == label.style_none ? color.new(color.white, 100) : eqh_col
        tc = eqh_sty == label.style_none ? eqh_col : color.white
        label.new(bar_index[swing_len], ph_s, "EQH", yloc=yloc.abovebar, color=c, textcolor=tc, style=eqh_sty, size=size.tiny)
    if not na(pl_s) and not na(last_swing_l) and math.abs(pl_s - last_swing_l) < (close * 0.001)
        c = eql_sty == label.style_none ? color.new(color.white, 100) : eql_col
        tc = eql_sty == label.style_none ? eql_col : color.white
        label.new(bar_index[swing_len], pl_s, "EQL", yloc=yloc.belowbar, color=c, textcolor=tc, style=eql_sty, size=size.tiny)

// --- Institutional Footprints (Sweeps & Funding) ---
if show_sweeps
    atr_val = ta.atr(20)
    offset = atr_val * 1.5
    // Bullish Sweep: Price wicks above previous High but closes below it
    if not na(last_swing_h) and high > last_swing_h and close < last_swing_h
        label.new(bar_index, high + offset, "LQ Swept", color=color.new(color.white, 100), textcolor=sweeps_col, style=label.style_none, size=size.small)
    
    // Bearish Sweep: Price wicks below previous Low but closes above it
    if not na(last_swing_l) and low < last_swing_l and close > last_swing_l
        label.new(bar_index, low - offset, "LQ Swept", color=color.new(color.white, 100), textcolor=sweeps_col, style=label.style_none, size=size.small)

if show_funding
    // Detect High Volume + High Range candles
    v_avg = ta.sma(volume, 20)
    a_avg = ta.atr(20)
    is_impulse = volume > v_avg * v_mult and math.abs(close - open) > a_avg * r_mult
    if is_impulse
        label.new(bar_index, high, "?", yloc=close > open ? yloc.belowbar : yloc.abovebar, color=color.new(color.white, 100), textcolor=funding_col, style=label.style_none, size=size.large)

// --- Periodic Levels (Daily/Weekly) ---
f_draw_periodic(h, l, c, t1, t2, s) =>
    var ln_h = line(na), var ln_l = line(na), var lb_h = label(na), var lb_l = label(na)
    if s and not na(h)
        line.delete(ln_h), line.delete(ln_l), label.delete(lb_h), label.delete(lb_l)
        ln_h := line.new(bar_index-50, h, bar_index+10, h, color=c, style=line.style_dashed)
        ln_l := line.new(bar_index-50, l, bar_index+10, l, color=c, style=line.style_dashed)
        lb_h := label.new(bar_index+10, h, t1, color=color.new(color.white, 100), textcolor=c, style=label.style_label_left, size=size.tiny)
        lb_l := label.new(bar_index+10, l, t2, color=color.new(color.white, 100), textcolor=c, style=label.style_label_left, size=size.tiny)

[dh, dl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_off)
f_draw_periodic(dh, dl, daily_col, "PDH", "PDL", show_daily)

[wh, wl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_off)
f_draw_periodic(wh, wl, weekly_col, "PWH", "PWL", show_weekly)
