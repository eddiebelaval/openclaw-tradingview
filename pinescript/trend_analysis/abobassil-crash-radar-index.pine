//@version=6
indicator("(AboBassil) Crash Radar index", overlay=false, precision=2)

//==================================================
// Inputs
//==================================================
grpData   = "Data"
grpSmooth = "Smoothing"
grpLevels = "Levels"
grpLogic  = "Signal Logic"
grpVis    = "Visual"

modelTF   = input.timeframe("D", "Model Timeframe", group=grpData)

symVIX    = input.symbol("CBOE:VIX", "VIX Symbol", group=grpData)
symVIX3M  = input.symbol("CBOE:VIX3M", "VIX3M Symbol", group=grpData)
symHY     = input.symbol("FRED:BAMLH0A0HYM2", "HY OAS Symbol", group=grpData)
symBreadA = input.symbol("AMEX:RSP", "Breadth Proxy A", group=grpData)
symBreadB = input.symbol("AMEX:SPY", "Breadth Proxy B", group=grpData)

riskLen   = input.int(4, "Risk Line Length", minval=1, group=grpSmooth)
trigLen   = input.int(10, "Trigger Line Length", minval=2, group=grpSmooth)
accelLen  = input.int(2, "Acceleration Lookback", minval=1, group=grpSmooth)

floorLvl  = input.float(10.0, "Floor", group=grpLevels)
watchLvl  = input.float(25.0, "Watch", group=grpLevels)
warnLvl   = input.float(40.0, "Warn", group=grpLevels)
riskLvl   = input.float(58.0, "Risk", group=grpLevels)
crashLvl  = input.float(74.0, "Crash", group=grpLevels)

resetLvl      = input.float(22.0, "Reset Level", group=grpLogic)
resetBars     = input.int(10, "Reset Bars", minval=1, group=grpLogic)
cooldownBars  = input.int(16, "Cooldown Bars", minval=1, group=grpLogic)

showZones   = input.bool(true, "Show Vertical Zones", group=grpVis)
showMarks   = input.bool(true, "Show Marks", group=grpVis)
showSignals = input.bool(true, "Show Signal Dots", group=grpVis)
showFill    = input.bool(false, "Fill Between Lines", group=grpVis)

//==================================================
// Helpers
//==================================================
clamp(x, minVal, maxVal) =>
    math.max(minVal, math.min(x, maxVal))

norm(x, low, high) =>
    clamp((x - low) / (high - low) * 100.0, 0.0, 100.0)

//==================================================
// External data
//==================================================
vix   = request.security(symVIX, modelTF, close, barmerge.gaps_off, barmerge.lookahead_off)
vix3m = request.security(symVIX3M, modelTF, close, barmerge.gaps_off, barmerge.lookahead_off)
hy    = request.security(symHY, modelTF, close, barmerge.gaps_off, barmerge.lookahead_off)

rsp   = request.security(symBreadA, modelTF, close, barmerge.gaps_off, barmerge.lookahead_off)
spy   = request.security(symBreadB, modelTF, close, barmerge.gaps_off, barmerge.lookahead_off)

cTF      = request.security(syminfo.tickerid, modelTF, close, barmerge.gaps_off, barmerge.lookahead_off)
ema50TF  = request.security(syminfo.tickerid, modelTF, ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
ema200TF = request.security(syminfo.tickerid, modelTF, ta.ema(close, 200), barmerge.gaps_off, barmerge.lookahead_off)
hh63TF   = request.security(syminfo.tickerid, modelTF, ta.highest(close, 63), barmerge.gaps_off, barmerge.lookahead_off)
rsiTF    = request.security(syminfo.tickerid, modelTF, ta.rsi(close, 14), barmerge.gaps_off, barmerge.lookahead_off)
atrPctTF = request.security(syminfo.tickerid, modelTF, ta.atr(14) / close * 100.0, barmerge.gaps_off, barmerge.lookahead_off)

//==================================================
// Components
//==================================================
// 1) Volatility structure
termSpreadRaw = vix - vix3m
termSpread    = ta.ema(termSpreadRaw, 2)
termScore     = norm(termSpread, -2.0, 4.0)

// 2) Credit stress + credit acceleration
hyScore = norm(hy, 3.2, 6.2)

hyAccel = ta.ema(hy - hy[5], 2)
hyAccelScore = norm(hyAccel, -0.10, 0.60)

creditScore = hyScore * 0.72 + hyAccelScore * 0.28

// 3) Breadth
float breadthRatio = na
if spy != 0
    breadthRatio := rsp / spy

breadthEMA = ta.ema(breadthRatio, 20)
breadthROC = breadthRatio - breadthRatio[10]

breadthScore1 = clamp(50.0 + (breadthEMA - breadthRatio) * 2400.0, 0.0, 100.0)
breadthScore2 = clamp(50.0 - breadthROC * 4200.0, 0.0, 100.0)
breadthScore  = breadthScore1 * 0.62 + breadthScore2 * 0.38

// 4) Trend damage
drawdownPct = hh63TF > 0 ? (hh63TF - cTF) / hh63TF * 100.0 : 0.0
ddScore     = norm(drawdownPct, 2.0, 12.0)

below50Pct  = ema50TF > 0 ? (ema50TF - cTF) / ema50TF * 100.0 : 0.0
below200Pct = ema200TF > 0 ? (ema200TF - cTF) / ema200TF * 100.0 : 0.0

below50Score  = norm(below50Pct, 0.5, 4.5)
below200Score = norm(below200Pct, 0.0, 8.0)

trendScore = ddScore * 0.50 + below50Score * 0.35 + below200Score * 0.15

// 5) Price stress
rsiWeakness = clamp((52.0 - rsiTF) / 18.0 * 100.0, 0.0, 100.0)
atrScore    = norm(atrPctTF, 1.0, 3.0)

priceStress = rsiWeakness * 0.60 + atrScore * 0.40

//==================================================
// Final model
//==================================================
riskRaw =
      termScore    * 0.23 +
      creditScore  * 0.24 +
      breadthScore * 0.26 +
      trendScore   * 0.17 +
      priceStress  * 0.10

riskLine    = ta.ema(riskRaw, riskLen)
triggerLine = ta.ema(riskRaw, trigLen)

accelRaw  = riskLine - riskLine[accelLen]
spreadRaw = riskLine - triggerLine

accelUp   = accelRaw > 0 and accelRaw > accelRaw[1]
spreadUp  = spreadRaw > 0 and spreadRaw > spreadRaw[1]

//==================================================
// Regime score
//==================================================
accelBoost  = clamp(50.0 + accelRaw * 12.0, 0.0, 100.0)
regimeScore = clamp(riskLine * 0.86 + accelBoost * 0.14, 0.0, 100.0)

int state = 0
if regimeScore < watchLvl
    state := 0
else if regimeScore < warnLvl
    state := 1
else if regimeScore < riskLvl
    state := 2
else if regimeScore < crashLvl
    state := 3
else
    state := 4

//==================================================
// Zones
//==================================================
color zoneBg = na
if regimeScore < floorLvl
    zoneBg := color.new(color.gray, 94)
else if regimeScore < watchLvl
    zoneBg := color.new(color.teal, 94)
else if regimeScore < warnLvl
    zoneBg := color.new(color.lime, 94)
else if regimeScore < riskLvl
    zoneBg := color.new(color.yellow, 93)
else if regimeScore < crashLvl
    zoneBg := color.new(color.orange, 91)
else
    zoneBg := color.new(color.red, 89)

bgcolor(showZones ? zoneBg : na)

//==================================================
// Conditions
//==================================================
termBad        = termSpread > 0
breadthBad     = breadthRatio < breadthEMA and breadthROC < 0
trendWeak      = cTF < ema50TF
trendBad       = cTF < ema50TF and cTF < ema200TF
rsiBad         = rsiTF < 49.5
priceBad       = atrPctTF > atrPctTF[1]
creditAccelBad = hyAccel > 0

//==================================================
// Arming / reset / cooldown
//==================================================
var bool waveActive = false
var int  cooldown   = 100000
cooldown += 1

resetCondition = riskLine < resetLvl and triggerLine < resetLvl and not termBad and not breadthBad and not creditAccelBad
resetReady     = ta.barssince(not resetCondition) > resetBars

if waveActive and resetReady
    waveActive := false

//==================================================
// Signal candidates
//==================================================
enteredWarn  = state >= 2 and state[1] < 2
enteredRisk  = state >= 3 and state[1] < 3
enteredCrash = state >= 4 and state[1] < 4

// Stage 1: Early Warning (yellow)
earlyCond1 = not waveActive
earlyCond2 = cooldown >= cooldownBars
earlyCond3 = enteredWarn or (state >= 2 and state[1] < state)
earlyCond4 = accelUp
earlyCond5 = spreadUp
earlyCond6 = termBad or breadthBad or creditAccelBad
earlyCond7 = trendWeak
earlyCond8 = rsiBad

earlyCandidate = earlyCond1 and earlyCond2 and earlyCond3 and earlyCond4 and earlyCond5 and earlyCond6 and earlyCond7 and earlyCond8

// Stage 2: Risk Build (orange)
buildCond1 = not waveActive
buildCond2 = cooldown >= cooldownBars
buildCond3 = state >= 3
buildCond4 = accelUp and spreadUp
buildCond5 = trendWeak
buildCond6 = breadthBad or termBad or creditAccelBad
buildCond7 = riskLine > warnLvl

buildCandidate = buildCond1 and buildCond2 and buildCond3 and buildCond4 and buildCond5 and buildCond6 and buildCond7

// Stage 3: Main Risk (red)
mainPart1 = enteredRisk or enteredCrash
mainPart2 = accelUp and spreadUp and trendBad and (termBad or breadthBad or creditAccelBad)
mainPart3 = state >= 3 and trendBad and rsiTF < 45.0 and priceBad and accelUp and spreadUp and creditAccelBad

mainCond1 = not waveActive
mainCond2 = cooldown >= cooldownBars
mainCond3 = (mainPart1 and mainPart2) or mainPart3

mainCandidate = mainCond1 and mainCond2 and mainCond3

bool earlyRisk = false
bool buildRisk = false
bool mainRisk  = false

if mainCandidate
    mainRisk := true
    waveActive := true
    cooldown := 0
else if buildCandidate
    buildRisk := true
    waveActive := true
    cooldown := 0
else if earlyCandidate
    earlyRisk := true
    waveActive := true
    cooldown := 0

//==================================================
// Colors
//==================================================
color riskColor = color.rgb(0, 180, 120)
if state >= 4
    riskColor := color.red
else if state >= 3
    riskColor := color.orange
else if state >= 2
    riskColor := color.yellow
else if state >= 1
    riskColor := color.lime
else
    riskColor := color.rgb(0, 180, 120)

color triggerColor = color.rgb(0, 150, 255)

//==================================================
// Levels
//==================================================
hline(0, "0", color=color.new(color.gray, 92))
hline(100, "100", color=color.new(color.gray, 92))
hline(floorLvl, "Floor", color=color.new(color.gray, 30), linestyle=hline.style_solid)
hline(watchLvl, "Watch", color=color.new(color.green, 30), linestyle=hline.style_solid)
hline(warnLvl, "Warn", color=color.new(color.yellow, 30), linestyle=hline.style_solid)
hline(riskLvl, "Risk", color=color.new(color.orange, 28), linestyle=hline.style_solid)
hline(crashLvl, "Crash", color=color.new(color.red, 22), linestyle=hline.style_solid)

//==================================================
// Plots
//==================================================
pRisk = plot(riskLine, "Risk Line", color=riskColor, linewidth=3, style=plot.style_line)
pTrig = plot(triggerLine, "Trigger Line", color=triggerColor, linewidth=3, style=plot.style_line)

color fillColor = na
if showFill
    if riskLine > triggerLine
        fillColor := color.new(color.red, 95)
    else
        fillColor := color.new(color.green, 97)

fill(pRisk, pTrig, color=fillColor)

//==================================================
// Marks
//==================================================
plotshape(showMarks and showSignals and earlyRisk ? riskLine : na, title="Early Warning", style=shape.circle, location=location.absolute, color=color.yellow, size=size.small)
plotshape(showMarks and showSignals and buildRisk ? riskLine : na, title="Risk Build", style=shape.circle, location=location.absolute, color=color.orange, size=size.small)
plotshape(showMarks and showSignals and mainRisk ? riskLine : na, title="Main Risk", style=shape.circle, location=location.absolute, color=color.red, size=size.small)

//==================================================
// Alerts
//==================================================
alertcondition(earlyRisk, "Early Warning", "Early warning risk detected.")
alertcondition(buildRisk, "Risk Build", "Risk build-up detected.")
alertcondition(mainRisk, "Main Risk", "Main correction / crash risk detected.")
