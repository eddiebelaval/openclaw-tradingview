indicator("Ultimate Liquidation Heatmap v2.0 [R2D2]", overlay = true, max_boxes_count = 500, max_lines_count = 500)

// =========================================================================
// Inputs
// =========================================================================
grp_mode = "Operating Mode"
mode = input.string("Combo", title="Select Mode", options=["Structural", "Leveraged Math", "Combo"], group=grp_mode)

grp_vis = "Visual Settings"
col_high = input.color(color.yellow, "High Intensity Color", group=grp_vis)
col_low = input.color(#4a148c, "Low Intensity Color", group=grp_vis) 
atr_mult = input.float(0.5, "Structural Zone Thickness (ATR)", group=grp_vis)

grp_math = "Leverage Settings (Math Mode)"
lev1 = input.float(50, title="Leverage Tier 1 (x)", group=grp_math)
lev2 = input.float(100, title="Leverage Tier 2 (x)", group=grp_math)
vol_len = input.int(50, title="Volume Lookback", group=grp_math)
vol_spike = input.float(1.5, title="Volume Spike Threshold", group=grp_math)

// =========================================================================
// Global Data & Helpers
// =========================================================================
// Track baseline volume and maximum volume for color gradients
vol_ma = ta.sma(volume, vol_len)
vol_max = ta.highest(volume, vol_len)

// Function to calculate gradient color based on volume intensity
get_intensity_color(v, v_base, v_peak) =>
    color.from_gradient(v, v_base, v_peak, col_low, col_high)

// =========================================================================
// Engine 1: Structural (Original Implementation)
// =========================================================================
var box[] struct_zones = array.new_box()

if (mode == "Structural" or mode == "Combo")
    // Detect swing points using a 3-bar lookback
    int pivot_len = 3
    float swing_h = ta.pivothigh(high, pivot_len, pivot_len)
    float swing_l = ta.pivotlow(low, pivot_len, pivot_len)
    
    // Zone thickness based on volatility
    float atr = ta.atr(14) * atr_mult
    
    // Create Top Zones (Resistance/Short Stops)
    if not na(swing_h)
        float past_vol = volume[pivot_len]
        color box_col = get_intensity_color(past_vol, vol_ma[pivot_len], vol_max[pivot_len])
        box new_box = box.new(left=bar_index[pivot_len], top=swing_h + atr, right=bar_index, bottom=swing_h, bgcolor=color.new(box_col, 80), border_color=na)
        array.push(struct_zones, new_box)
        
    // Create Bottom Zones (Support/Long Stops)
    if not na(swing_l)
        float past_vol = volume[pivot_len]
        color box_col = get_intensity_color(past_vol, vol_ma[pivot_len], vol_max[pivot_len])
        box new_box = box.new(left=bar_index[pivot_len], top=swing_l, right=bar_index, bottom=swing_l - atr, bgcolor=color.new(box_col, 80), border_color=na)
        array.push(struct_zones, new_box)
        
    // Manage and clear zones when price hits them
    if array.size(struct_zones) > 0
        for i = array.size(struct_zones) - 1 to 0
            box b = array.get(struct_zones, i)
            box.set_right(b, bar_index) // Extend forward
            
            float top = box.get_top(b)
            float bot = box.get_bottom(b)
            
            // Liquidation Event: Price enters the box
            if high >= bot and low <= top 
                box.set_right(b, bar_index)
                array.remove(struct_zones, i)

// =========================================================================
// Engine 2: Leveraged Math (Original Implementation)
// =========================================================================
var line[] math_lines = array.new_line()
var float[] math_prices = array.new_float()

if (mode == "Leveraged Math" or mode == "Combo")
    bool is_spike = (volume / vol_ma) >= vol_spike
    
    if is_spike and volume > 0
        color line_col = get_intensity_color(volume, vol_ma, vol_max)
        
        // Calculate strict margin call levels
        float s1 = high * (1 + (1 / lev1))
        float s2 = high * (1 + (1 / lev2))
        float l1 = low * (1 - (1 / lev1))
        float l2 = low * (1 - (1 / lev2))
        
        float[] new_levels = array.from(s1, s2, l1, l2)
        for lvl in new_levels
            array.push(math_prices, lvl)
            line ln = line.new(x1=bar_index, y1=lvl, x2=bar_index, y2=lvl, color=color.new(line_col, 0), width=2)
            array.push(math_lines, ln)
            
    // Manage and clear lines when price hits them
    if array.size(math_lines) > 0
        for i = array.size(math_lines) - 1 to 0
            line ln = array.get(math_lines, i)
            float price_lvl = array.get(math_prices, i)
            line.set_x2(ln, bar_index) // Extend forward
            
            // Liquidation Event: Price crosses the line
            if high >= price_lvl and low <= price_lvl
                array.remove(math_lines, i)
                array.remove(math_prices, i)
                
    // Protect TradingView memory limits
    if array.size(math_lines) > 400
        line.delete(array.shift(math_lines))
        array.shift(math_prices)

    //May the trades be with you.
