//@version=6
indicator("Volume Dispersion Field [JOAT]", "VDF [JOAT]", overlay=false, max_lines_count=500, max_boxes_count=300)

// ══════════════════════════════════════════════════════════════════════════════
// VOLUME DISPERSION FIELD
// Advanced volume analysis with profile visualization and liquidity detection
// Features: Volume profile, Dispersion analysis, High volume nodes, Delta tracking
// ══════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────
// COLOR PALETTE - Quantum Volume Theme
// ─────────────────────────────────────────────────────────────────────────────
// Volume Gradient Colors
var color VDF_EXTREME_HIGH   = #00ffd5
var color VDF_HIGH           = #00d4a1
var color VDF_ABOVE_AVG      = #00b389
var color VDF_AVERAGE        = #5d6d7e
var color VDF_BELOW_AVG      = #8b6f8e
var color VDF_LOW            = #b35f8e
var color VDF_EXTREME_LOW    = #d94f7e

// Delta Colors
var color VDF_BULL_DELTA     = #00e5cc
var color VDF_BEAR_DELTA     = #e06377
var color VDF_NEUTRAL        = #4a5568

// Profile Colors
var color VDF_POC            = #ffcb6b
var color VDF_VAH            = #c792ea
var color VDF_VAL            = #82aaff

// Climax Colors
var color VDF_CLIMAX_BULL    = #00ffd5
var color VDF_CLIMAX_BEAR    = #ff2d55

// Institutional Colors
var color VDF_INSTITUTIONAL  = #9c27b0
var color VDF_SMART_MONEY    = #673ab7
var color VDF_ABSORPTION     = #e91e63
var color VDF_DISTRIBUTION   = #ff5722

// Advanced Volume Colors
var color VDF_PULSE          = #ffeb3b
var color VDF_ANOMALY        = #ff6ec7
var color VDF_ACCUMULATION   = #4caf50
var color VDF_MARKUP          = #2196f3
var color VDF_MARKDOWN        = #f44336

// Visual Effects
var color VDF_GLOW           = #00ffff
var color VDF_BACKGROUND     = #1a237e
var color VDF_WARNING        = #ff9800
var color VDF_HIGHLIGHT      = #ffc107

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────
string grpVolume = "Volume Analysis"
int volMaLength       = input.int(20, "Volume MA Length", minval=5, maxval=100, group=grpVolume)
float volHighMult     = input.float(2.0, "High Volume Multiplier", minval=1.2, maxval=5.0, step=0.1, group=grpVolume)
float volLowMult      = input.float(0.5, "Low Volume Multiplier", minval=0.1, maxval=0.9, step=0.1, group=grpVolume)
bool showVolBars      = input.bool(true, "Show Volume Bars", group=grpVolume)

string grpDelta = "Delta Analysis"
bool showDelta        = input.bool(true, "Show Delta", group=grpDelta)
int deltaSmoothing    = input.int(3, "Delta Smoothing", minval=1, maxval=10, group=grpDelta)
bool showCumDelta     = input.bool(true, "Show Cumulative Delta", group=grpDelta)
int cumDeltaLength    = input.int(20, "Cumulative Delta Length", minval=5, maxval=100, group=grpDelta)

string grpDispersion = "Dispersion Settings"
bool showDispersion   = input.bool(true, "Show Dispersion Field", group=grpDispersion)
int dispersionLength  = input.int(50, "Dispersion Lookback", minval=20, maxval=200, group=grpDispersion)
int dispersionBins    = input.int(10, "Dispersion Bins", minval=5, maxval=20, group=grpDispersion)

string grpClimax = "Climax Detection"
bool showClimax       = input.bool(true, "Show Volume Climax", group=grpClimax)
float climaxThreshold = input.float(2.5, "Climax Threshold", minval=1.5, maxval=5.0, step=0.1, group=grpClimax)
int climaxLookback    = input.int(50, "Climax Lookback", minval=20, maxval=200, group=grpClimax)

string grpAdvanced = "Advanced Volume Analysis"
bool showSmartMoney    = input.bool(true, "Show Smart Money Concepts", group=grpAdvanced)
bool showInstitutional = input.bool(true, "Show Institutional Activity", group=grpAdvanced)
bool showVolumeAnomaly = input.bool(true, "Show Volume Anomalies", group=grpAdvanced)
float anomalyThreshold = input.float(3.0, "Anomaly Threshold (STD DEV)", minval=2.0, maxval=5.0, step=0.1, group=grpAdvanced)
bool showVolumePulse  = input.bool(true, "Show Volume Pulse", group=grpAdvanced)
float pulseThreshold  = input.float(1.5, "Pulse Threshold", minval=1.2, maxval=3.0, step=0.1, group=grpAdvanced)

string grpVisual = "Visual Settings"
bool showProfile      = input.bool(true, "Show Volume Profile", group=grpVisual)
bool showDashboard    = input.bool(true, "Show Dashboard", group=grpVisual)
int profileWidth      = input.int(50, "Profile Width", minval=20, maxval=100, group=grpVisual)
bool showGlowEffect   = input.bool(true, "Show Glow Effects", group=grpVisual)
bool showHeatmap      = input.bool(true, "Show Volume Heatmap", group=grpVisual)
string colorScheme    = input.string("Quantum", "Color Scheme", options=["Quantum", "Classic", "Professional", "Neon"], group=grpVisual)

// ─────────────────────────────────────────────────────────────────────────────
// TYPE DEFINITIONS
// ─────────────────────────────────────────────────────────────────────────────
type VolumeState
    float current
    float average
    float ratio
    int category
    bool isClimax
    bool isAnomaly
    bool isPulse
    float zScore
    string phase  // "Accumulation", "Markup", "Distribution", "Markdown"

type DeltaState
    float raw
    float smoothed
    float cumulative
    bool isBullish
    float divergence
    bool isDiverging

type DispersionBin
    float priceLevel
    float volumeSum
    int barCount
    bool isPOC
    float buyVolume
    float sellVolume

type ProfileData
    float poc
    float vah
    float val
    float totalVolume
    array<DispersionBin> bins
    float valueAreaPercent
    int profileType  // 0=Normal, 1=Imbalanced, 2=Ranged

type SmartMoneyState
    bool isAccumulating
    bool isDistributing
    float absorptionRatio
    float institutionalDelta
    bool hasAnomaly
    float anomalyScore

type VolumePulse
    float amplitude
    float frequency
    float phase
    bool isActive
    color pulseColor

// ─────────────────────────────────────────────────────────────────────────────
// GLOBAL VARIABLES
// ─────────────────────────────────────────────────────────────────────────────
var VolumeState volState = VolumeState.new(0.0, 0.0, 0.0, 0, false, false, false, 0.0, "Neutral")
var DeltaState deltaState = DeltaState.new(0.0, 0.0, 0.0, true, 0.0, false)
var ProfileData profile = ProfileData.new(na, na, na, 0.0, array.new<DispersionBin>(), 0.0, 0)
var SmartMoneyState smartMoney = SmartMoneyState.new(false, false, 0.0, 0.0, false, 0.0)
var VolumePulse volPulse = VolumePulse.new(0.0, 0.0, 0.0, false, VDF_PULSE)

// Animation variables
var float animationPhase = 0.0
var int lastAnimationBar = 0

// Pre-compute ta.* calls at global scope for consistency
float _dispHighest = ta.highest(high, dispersionLength)
float _dispLowest = ta.lowest(low, dispersionLength)
float _smHighest50 = ta.highest(high, 50)
float _smLowest50 = ta.lowest(low, 50)
float _smSma50 = ta.sma(close, 50)
float _atrVal = ta.atr(14)

// ─────────────────────────────────────────────────────────────────────────────
// VOLUME CALCULATIONS
// ─────────────────────────────────────────────────────────────────────────────
volMA = ta.sma(volume, volMaLength)
volStdDev = ta.stdev(volume, volMaLength)
volRatio = volume / volMA

volState.current := volume
volState.average := volMA
volState.ratio := volRatio

// Calculate Z-score for anomaly detection
volState.zScore := (volume - volMA) / (volStdDev + 0.0001)
volState.isAnomaly := showVolumeAnomaly and math.abs(volState.zScore) > anomalyThreshold

// Volume pulse detection
if showVolumePulse
    volPulse.amplitude := volume / volMA
    volPulse.isActive := volPulse.amplitude > pulseThreshold
    volPulse.phase := (time / 1000) % 360
    volPulse.frequency := volPulse.amplitude > 0 ? 1 / volPulse.amplitude : 1
    volPulse.pulseColor := volPulse.isActive ? VDF_PULSE : VDF_NEUTRAL

volState.isPulse := volPulse.isActive

categorizeVolume() =>
    int cat = 0
    
    if volRatio >= volHighMult * 1.5
        cat := 3
    else if volRatio >= volHighMult
        cat := 2
    else if volRatio >= 1.0
        cat := 1
    else if volRatio >= volLowMult
        cat := 0
    else if volRatio >= volLowMult * 0.5
        cat := -1
    else
        cat := -2
    
    cat

// Pre-compute ta.* calls for phase detection at global scope
float _phaseChange = ta.change(close, 20)
bool _volRising = ta.rising(volMA, 10)
bool _volFalling = ta.falling(volMA, 10)

// Determine market phase based on volume and price
determineVolumePhase(float pc, int vt) =>
    string phase = "Neutral"
    
    if pc > 0 and vt > 0
        phase := "Markup"
    else if pc > 0 and vt < 0
        phase := "Distribution"
    else if pc < 0 and vt > 0
        phase := "Accumulation"
    else if pc < 0 and vt < 0
        phase := "Markdown"
    
    phase

int _volTrend = _volRising ? 1 : _volFalling ? -1 : 0

volState.category := categorizeVolume()
volState.phase := determineVolumePhase(_phaseChange, _volTrend)

// ─────────────────────────────────────────────────────────────────────────────
// DELTA CALCULATIONS
// ─────────────────────────────────────────────────────────────────────────────
calcDelta() =>
    float buyVol = 0.0
    float sellVol = 0.0
    
    if close > open
        buyVol := volume * (close - low) / (high - low + 0.0001)
        sellVol := volume - buyVol
    else if close < open
        sellVol := volume * (high - close) / (high - low + 0.0001)
        buyVol := volume - sellVol
    else
        buyVol := volume * 0.5
        sellVol := volume * 0.5
    
    [buyVol, sellVol, buyVol - sellVol]

[buyVolume, sellVolume, rawDelta] = calcDelta()

float deltaSmoothed = ta.ema(rawDelta, deltaSmoothing)
float cumDelta = math.sum(rawDelta, cumDeltaLength)

deltaState.raw := rawDelta
deltaState.smoothed := deltaSmoothed
deltaState.cumulative := cumDelta
deltaState.isBullish := deltaSmoothed > 0

// Calculate delta divergence
float priceChange = ta.change(close, 10)
float deltaChange = ta.change(deltaSmoothed, 10)
deltaState.divergence := priceChange * deltaChange < 0 ? math.abs(deltaChange) : 0
deltaState.isDiverging := deltaState.divergence > 0

// ─────────────────────────────────────────────────────────────────────────────
// VOLUME CLIMAX DETECTION
// ─────────────────────────────────────────────────────────────────────────────
float highestVol = ta.highest(volume, climaxLookback)
float volPercentile = volume / highestVol * 100

bool buyClimax = showClimax and volRatio >= climaxThreshold and close > open
bool sellClimax = showClimax and volRatio >= climaxThreshold and close < open

volState.isClimax := buyClimax or sellClimax

// ─────────────────────────────────────────────────────────────────────────────
// DISPERSION FIELD CALCULATION
// ─────────────────────────────────────────────────────────────────────────────
calcDispersion() =>
    float dispersionValue = 0.0
    
    if showDispersion
        priceHigh = _dispHighest
        priceLow = _dispLowest
        priceRange = priceHigh - priceLow
        
        if priceRange > 0
            volSum = math.sum(volume, dispersionLength)
            avgVolPerBar = volSum / dispersionLength
            
            currentPos = (close - priceLow) / priceRange
            
            volAboveAvg = 0.0
            volBelowAvg = 0.0
            
            for i = 0 to dispersionLength - 1
                barPos = (close[i] - priceLow) / priceRange
                if barPos > 0.5
                    volAboveAvg += volume[i]
                else
                    volBelowAvg += volume[i]
            
            dispersionValue := (volAboveAvg - volBelowAvg) / (volAboveAvg + volBelowAvg + 0.0001) * 100
    
    dispersionValue

float dispersion = calcDispersion()

// ─────────────────────────────────────────────────────────────────────────────
// SMART MONEY CONCEPTS
// ─────────────────────────────────────────────────────────────────────────────
analyzeSmartMoney() =>
    if showSmartMoney
        // Accumulation/Distribution detection
        priceRange = _smHighest50 - _smLowest50
        volumeInUpperRange = 0.0
        volumeInLowerRange = 0.0
        
        for i = 0 to 49
            pricePos = (close[i] - _smLowest50) / priceRange
            if pricePos > 0.7
                volumeInUpperRange += volume[i]
            else if pricePos < 0.3
                volumeInLowerRange += volume[i]
        
        totalRangeVolume = volumeInUpperRange + volumeInLowerRange
        
        if totalRangeVolume > 0
            smartMoney.absorptionRatio := math.abs(volumeInUpperRange - volumeInLowerRange) / totalRangeVolume
            smartMoney.isAccumulating := volumeInLowerRange > volumeInUpperRange * 1.2 and close < _smSma50
            smartMoney.isDistributing := volumeInUpperRange > volumeInLowerRange * 1.2 and close > _smSma50
        
        // Institutional delta (large volume moves)
        largeVolumeThreshold = volMA * 2.0
        institutionalBuyVol = 0.0
        institutionalSellVol = 0.0
        
        for i = 0 to 19
            if volume[i] > largeVolumeThreshold
                if close[i] > open[i]
                    institutionalBuyVol += volume[i]
                else
                    institutionalSellVol += volume[i]
        
        smartMoney.institutionalDelta := institutionalBuyVol - institutionalSellVol
        
        // Anomaly detection
        if showVolumeAnomaly
            smartMoney.hasAnomaly := volState.isAnomaly
            smartMoney.anomalyScore := math.abs(volState.zScore)

analyzeSmartMoney()

// ─────────────────────────────────────────────────────────────────────────────
// VOLUME PROFILE CALCULATION
// ─────────────────────────────────────────────────────────────────────────────
calcVolumeProfile() =>
    float pocPrice = na
    float vahPrice = na
    float valPrice = na
    float maxVol = 0.0
    float totalVol = 0.0
    
    if showProfile
        priceHigh = _dispHighest
        priceLow = _dispLowest
        binSize = (priceHigh - priceLow) / dispersionBins
        
        binVolumes = array.new<float>(dispersionBins, 0.0)
        
        for i = 0 to dispersionLength - 1
            binIdx = math.min(dispersionBins - 1, math.floor((close[i] - priceLow) / binSize))
            if binIdx >= 0 and binIdx < dispersionBins
                currentVol = array.get(binVolumes, int(binIdx))
                array.set(binVolumes, int(binIdx), currentVol + volume[i])
                totalVol += volume[i]
        
        maxVolIdx = 0
        for i = 0 to dispersionBins - 1
            binVol = array.get(binVolumes, i)
            if binVol > maxVol
                maxVol := binVol
                maxVolIdx := i
        
        pocPrice := priceLow + (maxVolIdx + 0.5) * binSize
        
        valueAreaVol = totalVol * 0.7
        cumVol = array.get(binVolumes, maxVolIdx)
        upperIdx = maxVolIdx
        lowerIdx = maxVolIdx
        
        while cumVol < valueAreaVol and (upperIdx < dispersionBins - 1 or lowerIdx > 0)
            upperVol = upperIdx < dispersionBins - 1 ? array.get(binVolumes, upperIdx + 1) : 0.0
            lowerVol = lowerIdx > 0 ? array.get(binVolumes, lowerIdx - 1) : 0.0
            
            if upperVol >= lowerVol and upperIdx < dispersionBins - 1
                upperIdx += 1
                cumVol += upperVol
            else if lowerIdx > 0
                lowerIdx -= 1
                cumVol += lowerVol
            else
                break
        
        vahPrice := priceLow + (upperIdx + 1) * binSize
        valPrice := priceLow + lowerIdx * binSize
    
    [pocPrice, vahPrice, valPrice, totalVol]

[poc, vah, val, totalVol] = calcVolumeProfile()
profile.poc := poc
profile.vah := vah
profile.val := val
profile.totalVolume := totalVol

// Determine profile type
if not na(poc) and not na(vah) and not na(val)
    valueAreaWidth = vah - val
    totalWidth = _dispHighest - _dispLowest
    profile.valueAreaPercent := valueAreaWidth / totalWidth * 100
    
    if profile.valueAreaPercent < 20
        profile.profileType := 1  // Imbalanced
    else if profile.valueAreaPercent > 60
        profile.profileType := 2  // Ranged
    else
        profile.profileType := 0  // Normal

// ─────────────────────────────────────────────────────────────────────────────
// VOLUME COLOR CALCULATION
// ─────────────────────────────────────────────────────────────────────────────
getVolumeColor() =>
    color col = VDF_AVERAGE
    
    // Apply color scheme
    if colorScheme == "Professional"
        col := #089981
    else if colorScheme == "Classic"
        col := #4CAF50
    else if colorScheme == "Neon"
        col := volState.isPulse ? VDF_GLOW : VDF_AVERAGE
    
    // Priority coloring: Anomaly > Climax > Pulse > Normal
    if volState.isAnomaly
        col := VDF_ANOMALY
        if showGlowEffect
            // Add glow effect for anomalies
            col := color.new(col, 20)
    else if volState.isClimax
        col := close > open ? VDF_CLIMAX_BULL : VDF_CLIMAX_BEAR
    else if volState.isPulse
        col := volPulse.pulseColor
        if showGlowEffect
            // Animated pulse effect
            pulseAlpha = 50 + math.sin(animationPhase * math.pi / 180) * 30
            col := color.new(col, 100 - pulseAlpha)
    else
        switch volState.category
            3 => col := VDF_EXTREME_HIGH
            2 => col := VDF_HIGH
            1 => col := VDF_ABOVE_AVG
            0 => col := VDF_AVERAGE
            -1 => col := VDF_BELOW_AVG
            -2 => col := VDF_EXTREME_LOW
    
    col

color volColor = getVolumeColor()

// ─────────────────────────────────────────────────────────────────────────────
// DELTA COLOR CALCULATION
// ─────────────────────────────────────────────────────────────────────────────
getDeltaColor() =>
    color col = VDF_NEUTRAL
    
    intensity = math.min(100, math.abs(deltaState.smoothed) / volMA * 200)
    
    // Apply color scheme
    color bullCol = VDF_BULL_DELTA
    color bearCol = VDF_BEAR_DELTA
    if colorScheme == "Professional"
        bullCol := #089981
        bearCol := #F23645
    else if colorScheme == "Classic"
        bullCol := #4CAF50
        bearCol := #F44336
    else if colorScheme == "Neon"
        bullCol := #00ffff
        bearCol := #ff00ff
    
    if deltaState.isBullish
        col := color.from_gradient(intensity, 0, 100, color.new(bullCol, 70), bullCol)
        
        // Highlight divergence
        if deltaState.isDiverging
            col := color.new(VDF_HIGHLIGHT, 30)
    else
        col := color.from_gradient(intensity, 0, 100, color.new(bearCol, 70), bearCol)
        
        // Highlight divergence
        if deltaState.isDiverging
            col := color.new(VDF_WARNING, 30)
    
    col

color deltaColor = getDeltaColor()

// ─────────────────────────────────────────────────────────────────────────────
// PLOTTING - VOLUME BARS
// ─────────────────────────────────────────────────────────────────────────────
plot(showVolBars ? volume : na, "Volume", color=volColor, style=plot.style_columns, histbase=0)
plot(volMA, "Volume MA", color=color.new(VDF_AVERAGE, 30), linewidth=2)

// Enhanced bands with gradient fill
upperBand = plot(volMA * volHighMult, "High Vol Band", color=color.new(VDF_HIGH, 70), linewidth=1, style=plot.style_line)
lowerBand = plot(volMA * volLowMult, "Low Vol Band", color=color.new(VDF_LOW, 70), linewidth=1, style=plot.style_line)

fill(upperBand, lowerBand, color=color.new(VDF_NEUTRAL, 90))

// Anomaly visualization
plotshape(volState.isAnomaly, "Volume Anomaly", shape.diamond, location.top, VDF_ANOMALY, size=size.small)

// Volume pulse visualization
float pulseHeight = showVolumePulse and volState.isPulse ? volMA * pulseThreshold : na
plot(pulseHeight, "Pulse Level", color=volPulse.pulseColor, linewidth=2, style=plot.style_circles)

// ─────────────────────────────────────────────────────────────────────────────
// PLOTTING - DELTA
// ─────────────────────────────────────────────────────────────────────────────
plot(showDelta ? deltaSmoothed : na, "Delta", color=deltaColor, style=plot.style_histogram, linewidth=2, histbase=0)

// Enhanced cumulative delta with gradient
float cumDeltaPlot = showCumDelta ? cumDelta / ta.highest(math.abs(cumDelta), cumDeltaLength) * volMA * 0.5 : na
color cumDeltaColor = cumDelta > 0 ? VDF_BULL_DELTA : VDF_BEAR_DELTA
plot(cumDeltaPlot, "Cumulative Delta", color=cumDeltaColor, linewidth=2)

// Delta divergence marker - color-coded to delta direction
plotshape(deltaState.isDiverging and deltaState.isBullish, "Delta Div Bull", shape.cross, location.top, VDF_BULL_DELTA, size=size.tiny)
plotshape(deltaState.isDiverging and not deltaState.isBullish, "Delta Div Bear", shape.cross, location.top, VDF_BEAR_DELTA, size=size.tiny)

// Smart money visualization
float absorptionLine = showSmartMoney ? smartMoney.absorptionRatio * volMA : na
plot(absorptionLine, "Absorption", color=VDF_ABSORPTION, linewidth=1, style=plot.style_line)

plotshape(showSmartMoney and smartMoney.isAccumulating, "Accumulation", shape.arrowup, location.bottom, VDF_ACCUMULATION, size=size.tiny)
plotshape(showSmartMoney and smartMoney.isDistributing and not smartMoney.isAccumulating, "Distribution", shape.arrowdown, location.top, VDF_DISTRIBUTION, size=size.tiny)

// ─────────────────────────────────────────────────────────────────────────────
// PLOTTING - DISPERSION
// ─────────────────────────────────────────────────────────────────────────────
float dispersionNorm = showDispersion ? dispersion / 100 * volMA * 0.3 : na
color dispersionColor = dispersion > 0 ? color.new(VDF_BULL_DELTA, 60) : color.new(VDF_BEAR_DELTA, 60)
plot(dispersionNorm, "Dispersion", color=dispersionColor, style=plot.style_area, histbase=0)

// Heatmap visualization
heatmapValue = (volRatio - 0.5) * 2  // Normalize to -1 to 1
heatmapColor = showHeatmap ? color.new(color.from_gradient(heatmapValue, -1, 1, VDF_EXTREME_LOW, VDF_EXTREME_HIGH), 95) : na
bgcolor(heatmapColor)

// ─────────────────────────────────────────────────────────────────────────────
// PLOTTING - CLIMAX MARKERS
// ─────────────────────────────────────────────────────────────────────────────
plotshape(buyClimax, "Buy Climax", shape.triangleup, location.bottom, VDF_CLIMAX_BULL, size=size.small)
plotshape(sellClimax, "Sell Climax", shape.triangledown, location.top, VDF_CLIMAX_BEAR, size=size.small)

// Update animation
if barstate.islast
    if bar_index != lastAnimationBar
        animationPhase := (animationPhase + 5) % 360
        lastAnimationBar := bar_index

// ─────────────────────────────────────────────────────────────────────────────
// PLOTTING - BACKGROUND
// ─────────────────────────────────────────────────────────────────────────────
color bgColor = volState.category >= 2 ? color.new(VDF_HIGH, 95) : volState.category <= -1 ? color.new(VDF_LOW, 95) : na
bgcolor(bgColor)

// ─────────────────────────────────────────────────────────────────────────────
// HORIZONTAL LINES
// ─────────────────────────────────────────────────────────────────────────────
hline(0, "Zero Line", color=color.new(#4a5568, 50), linestyle=hline.style_dotted)

// ─────────────────────────────────────────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────────────────────────────────────────
if showDashboard
    var table dashboard = table.new(position.top_right, 3, 14, 
                                   bgcolor=color.new(VDF_BACKGROUND, 5), 
                                   border_color=color.new(VDF_NEUTRAL, 50),
                                   border_width=1)
    
    if barstate.islast
        // Header with gradient
        headerBg = colorScheme == "Quantum" ? color.new(VDF_GLOW, 90) : color.new(#1a1a2e, 10)
        table.cell(dashboard, 0, 0, "VDF [JOAT]", text_color=VDF_GLOW, text_size=size.small, bgcolor=headerBg)
        table.cell(dashboard, 1, 0, "Metrics", text_color=VDF_NEUTRAL, text_size=size.small, bgcolor=headerBg)
        table.cell(dashboard, 2, 0, "Status", text_color=VDF_NEUTRAL, text_size=size.small, bgcolor=headerBg)
        
        // Volume information
        volCatText = switch volState.category
            3 => "EXTREME HIGH"
            2 => "HIGH"
            1 => "ABOVE AVG"
            0 => "AVERAGE"
            -1 => "BELOW AVG"
            -2 => "EXTREME LOW"
            => "UNKNOWN"
        
        volCatCol = switch volState.category
            3 => VDF_EXTREME_HIGH
            2 => VDF_HIGH
            1 => VDF_ABOVE_AVG
            0 => VDF_AVERAGE
            -1 => VDF_BELOW_AVG
            -2 => VDF_EXTREME_LOW
            => VDF_NEUTRAL
        
        table.cell(dashboard, 0, 1, "Volume", text_color=VDF_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 1, str.tostring(volume, "#.##"), text_color=volColor, text_size=size.small)
        table.cell(dashboard, 2, 1, str.tostring(volRatio, "#.##") + "x", text_color=volCatCol, text_size=size.small)
        
        table.cell(dashboard, 0, 2, "Category", text_color=VDF_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 2, volCatText, text_color=volCatCol, text_size=size.small)
        table.cell(dashboard, 2, 2, volState.isClimax ? "CLIMAX" : volRatio > 1.0 ? "ACTIVE" : "QUIET", text_color=volState.isClimax ? VDF_WARNING : volRatio > 1.0 ? VDF_ABOVE_AVG : VDF_BELOW_AVG, text_size=size.small)
        
        // Anomaly detection
        table.cell(dashboard, 0, 3, "Anomaly", text_color=VDF_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 3, volState.isAnomaly ? "DETECTED" : "NONE", text_color=volState.isAnomaly ? VDF_ANOMALY : VDF_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 2, 3, volState.isAnomaly ? str.tostring(volState.zScore, "#.##") + "z" : "NORMAL", text_color=volState.isAnomaly ? VDF_ANOMALY : VDF_AVERAGE, text_size=size.small)
        
        // Volume phase
        table.cell(dashboard, 0, 4, "Phase", text_color=VDF_NEUTRAL, text_size=size.small)
        phaseCol = volState.phase == "Markup" ? VDF_MARKUP : volState.phase == "Distribution" ? VDF_DISTRIBUTION : volState.phase == "Accumulation" ? VDF_ACCUMULATION : volState.phase == "Markdown" ? VDF_MARKDOWN : VDF_NEUTRAL
        table.cell(dashboard, 1, 4, volState.phase, text_color=phaseCol, text_size=size.small)
        table.cell(dashboard, 2, 4, volState.isPulse ? "PULSE" : volState.phase != "Neutral" ? "TRENDING" : "FLAT", text_color=volState.isPulse ? VDF_PULSE : volState.phase != "Neutral" ? VDF_ABOVE_AVG : VDF_NEUTRAL, text_size=size.small)
        
        // Delta information
        deltaText = deltaState.isBullish ? "BULLISH" : "BEARISH"
        deltaCol = deltaState.isBullish ? VDF_BULL_DELTA : VDF_BEAR_DELTA
        
        table.cell(dashboard, 0, 5, "Delta", text_color=VDF_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 5, deltaText, text_color=deltaCol, text_size=size.small)
        table.cell(dashboard, 2, 5, deltaState.isDiverging ? "DIVERG" : deltaState.isBullish ? "BUY SIDE" : "SELL SIDE", text_color=deltaState.isDiverging ? VDF_WARNING : deltaCol, text_size=size.small)
        
        table.cell(dashboard, 0, 6, "Delta Flow", text_color=VDF_NEUTRAL, text_size=size.small)
        cumDeltaCol = cumDelta > 0 ? VDF_BULL_DELTA : VDF_BEAR_DELTA
        table.cell(dashboard, 1, 6, str.tostring(cumDelta, "#.##"), text_color=cumDeltaCol, text_size=size.small)
        table.cell(dashboard, 2, 6, cumDelta > 0 ? "INFLOW" : "OUTFLOW", text_color=cumDeltaCol, text_size=size.small)
        
        // Dispersion
        dispText = dispersion > 20 ? "BULL HEAVY" : dispersion < -20 ? "BEAR HEAVY" : "BALANCED"
        dispCol = dispersion > 20 ? VDF_BULL_DELTA : dispersion < -20 ? VDF_BEAR_DELTA : VDF_NEUTRAL
        
        table.cell(dashboard, 0, 7, "Dispersion", text_color=VDF_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 7, dispText, text_color=dispCol, text_size=size.small)
        table.cell(dashboard, 2, 7, str.tostring(dispersion, "#.#") + "%", text_color=dispCol, text_size=size.small)
        
        // Smart Money
        table.cell(dashboard, 0, 8, "Smart Money", text_color=VDF_NEUTRAL, text_size=size.small)
        smText = smartMoney.isAccumulating ? "ACCUM" : smartMoney.isDistributing ? "DIST" : "NEUTRAL"
        smCol = smartMoney.isAccumulating ? VDF_ACCUMULATION : smartMoney.isDistributing ? VDF_DISTRIBUTION : VDF_NEUTRAL
        table.cell(dashboard, 1, 8, smText, text_color=smCol, text_size=size.small)
        table.cell(dashboard, 2, 8, smartMoney.absorptionRatio > 0.5 ? "STRONG" : smartMoney.absorptionRatio > 0.2 ? "MODERATE" : "WEAK", text_color=smartMoney.absorptionRatio > 0.5 ? VDF_ABSORPTION : smartMoney.absorptionRatio > 0.2 ? VDF_AVERAGE : VDF_NEUTRAL, text_size=size.small)
        
        // Institutional
        table.cell(dashboard, 0, 9, "Institutional", text_color=VDF_NEUTRAL, text_size=size.small)
        instText = smartMoney.institutionalDelta > 0 ? "BULL" : smartMoney.institutionalDelta < 0 ? "BEAR" : "NEUTRAL"
        instCol = smartMoney.institutionalDelta > 0 ? VDF_INSTITUTIONAL : smartMoney.institutionalDelta < 0 ? VDF_SMART_MONEY : VDF_NEUTRAL
        table.cell(dashboard, 1, 9, instText, text_color=instCol, text_size=size.small)
        table.cell(dashboard, 2, 9, math.abs(smartMoney.institutionalDelta) > volMA * 3 ? "HEAVY" : math.abs(smartMoney.institutionalDelta) > volMA ? "ACTIVE" : "LIGHT", text_color=instCol, text_size=size.small)
        
        // Profile information
        table.cell(dashboard, 0, 10, "POC", text_color=VDF_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 10, not na(poc) ? str.tostring(poc, "#.##") : "N/A", text_color=VDF_POC, text_size=size.small)
        table.cell(dashboard, 2, 10, not na(profile.valueAreaPercent) ? str.tostring(profile.valueAreaPercent, "#.#") + "%" : "N/A", text_color=not na(poc) ? VDF_POC : VDF_NEUTRAL, text_size=size.small)
        
        table.cell(dashboard, 0, 11, "VAH", text_color=VDF_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 11, not na(vah) ? str.tostring(vah, "#.##") : "N/A", text_color=VDF_VAH, text_size=size.small)
        table.cell(dashboard, 2, 11, profile.profileType == 1 ? "IMBAL" : profile.profileType == 2 ? "RANGE" : "NORMAL", text_color=profile.profileType == 1 ? VDF_WARNING : profile.profileType == 2 ? VDF_VAL : VDF_AVERAGE, text_size=size.small)
        
        table.cell(dashboard, 0, 12, "VAL", text_color=VDF_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 12, not na(val) ? str.tostring(val, "#.##") : "N/A", text_color=VDF_VAL, text_size=size.small)
        table.cell(dashboard, 2, 12, not na(val) and not na(vah) ? str.tostring(vah - val, "#.##") : "N/A", text_color=VDF_NEUTRAL, text_size=size.small)
        
        // Color scheme indicator
        table.cell(dashboard, 0, 13, "Scheme", text_color=VDF_NEUTRAL, text_size=size.small)
        table.cell(dashboard, 1, 13, colorScheme, text_color=VDF_GLOW, text_size=size.small)
        table.cell(dashboard, 2, 13, syminfo.ticker, text_color=VDF_HIGHLIGHT, text_size=size.small)

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────
// Volume alerts
alertcondition(volState.category >= 2, "High Volume", "High volume detected")
alertcondition(volState.category <= -1, "Low Volume", "Low volume detected")
alertcondition(buyClimax, "Buy Climax", "Bullish volume climax detected")
alertcondition(sellClimax, "Sell Climax", "Bearish volume climax detected")

// Anomaly alerts
alertcondition(volState.isAnomaly, "Volume Anomaly", "Volume anomaly detected")
alertcondition(volState.isPulse, "Volume Pulse", "Volume pulse detected")

// Delta alerts
alertcondition(ta.crossover(deltaSmoothed, 0), "Delta Bullish Cross", "Delta crossed bullish")
alertcondition(ta.crossunder(deltaSmoothed, 0), "Delta Bearish Cross", "Delta crossed bearish")
alertcondition(ta.crossover(cumDelta, 0), "Cum Delta Bullish", "Cumulative delta turned bullish")
alertcondition(ta.crossunder(cumDelta, 0), "Cum Delta Bearish", "Cumulative delta turned bearish")
alertcondition(deltaState.isDiverging, "Delta Divergence", "Delta divergence detected")

// Smart Money alerts
alertcondition(smartMoney.isAccumulating, "Accumulation Phase", "Smart money accumulation detected")
alertcondition(smartMoney.isDistributing, "Distribution Phase", "Smart money distribution detected")
alertcondition(smartMoney.absorptionRatio > 0.7, "High Absorption", "High volume absorption detected")
alertcondition(smartMoney.institutionalDelta > volMA * 5, "Institutional Buying", "Strong institutional buying detected")
alertcondition(smartMoney.institutionalDelta < -volMA * 5, "Institutional Selling", "Strong institutional selling detected")

// Phase alerts
alertcondition(volState.phase == "Markup", "Markup Phase", "Market entered markup phase")
alertcondition(volState.phase == "Distribution", "Distribution Phase", "Market entered distribution phase")
alertcondition(volState.phase == "Accumulation", "Accumulation Phase", "Market entered accumulation phase")
alertcondition(volState.phase == "Markdown", "Markdown Phase", "Market entered markdown phase")

// Dispersion alerts
alertcondition(dispersion > 40, "Strong Bull Dispersion", "Volume heavily dispersed to upside")
alertcondition(dispersion < -40, "Strong Bear Dispersion", "Volume heavily dispersed to downside")

// Profile alerts
alertcondition(not na(poc) and close > poc and close < poc + _atrVal * 0.5, "Near POC Above", "Price near POC from above")
alertcondition(not na(poc) and close < poc and close > poc - _atrVal * 0.5, "Near POC Below", "Price near POC from below")
alertcondition(profile.profileType == 1, "Imbalanced Profile", "Imbalanced volume profile detected")
alertcondition(profile.profileType == 2, "Ranged Profile", "Ranged volume profile detected")
