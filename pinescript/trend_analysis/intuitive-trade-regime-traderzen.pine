//@version=6
indicator("Intuitive Trade Regime [TraderZen]", shorttitle="ITR [TZ]", overlay=true, max_lines_count=500, max_polylines_count=100)
//──────────────────────────────────────────────────────────────────────────────
// Theme Presets
//──────────────────────────────────────────────────────────────────────────────
themePreset = input.string("Dual Band", "Theme Preset", options=["Dual Band", "Classic", "Price Slabs", "Neon Glass", "Custom"], group="🎭 Theme", tooltip="Dual Band: Slim lines with 3D depth. Classic: Clean channel, no 3D. Price Slabs: Bold 3D blocks. Neon Glass: Glowing transparent 3D. Custom: Full manual control.")
//──────────────────────────────────────────────────────────────────────────────
// Logic Inputs
//──────────────────────────────────────────────────────────────────────────────
groupLogic = "Logic"
atrLen        = input.int(50,   "ATR Length", minval=1, group=groupLogic)
basisLen      = input.int(21,   "Local Basis Length", minval=2, group=groupLogic)
flipATR       = input.float(0.35, "Flip Threshold Beyond Band (ATR)", step=0.05, minval=0.0, group=groupLogic)
contATR       = input.float(0.15, "Continuation Threshold Beyond Band (ATR)", step=0.05, minval=0.0, group=groupLogic)
confirmBars   = input.int(2, "Confirmation Bars", minval=1, group=groupLogic)
cooldownBars  = input.int(1, "Cooldown Bars", minval=0, group=groupLogic)
maxSegBars    = input.int(35, "Max Segment Age", minval=5, group=groupLogic)
detachATR     = input.float(1.25, "Detach Threshold vs Basis (ATR)", step=0.05, minval=0.1, group=groupLogic)
detachBars    = input.int(3, "Detach Bars", minval=1, group=groupLogic)
basisBlend      = input.float(0.50, "Re-anchor Blend To Local Basis", step=0.05, minval=0.0, maxval=1.0, group=groupLogic)
stepATR         = input.float(0.50, "Step Size On Event (ATR)", step=0.05, minval=0.0, group=groupLogic)
adverseSlopeATR = input.float(0.015, "Adverse Slope Per Bar (ATR)", step=0.001, minval=0.0, group=groupLogic)
widthATR      = input.float(1.05, "Base Half-Width (ATR)", step=0.05, minval=0.1, group=groupLogic)
widthStdMult  = input.float(1.00, "Local Spread Multiplier", step=0.05, minval=0.0, group=groupLogic)
widthCapATR   = input.float(2.20, "Max Half-Width (ATR)", step=0.05, minval=0.2, group=groupLogic)
midView       = input.string("Lead", "Mid Line View", options=["Lead", "Follow"], group=groupLogic, tooltip="Lead: mid line sits on the opposite side of price (support/resistance), decaying away like the original Zeiierman. Follow: mid line tracks toward price, blending with local basis.")
//──────────────────────────────────────────────────────────────────────────────
// Style Inputs
//──────────────────────────────────────────────────────────────────────────────
groupStyle = "Style"
groupGrad  = "Gradient"
showFill        = input.bool(true,  "Show Fill", group=groupStyle)
showBands       = input.bool(true,  "Show Band Edges", group=groupStyle)
showRetests     = input.bool(true,  "Show Retests", group=groupStyle)
showRegimeMarks = input.bool(true,  "Show Regime Change Markers", group=groupStyle)
showStepMarks   = input.bool(true,  "Show Continuation Step Marks", group=groupStyle)
showRefresh     = input.bool(false, "Show Refresh Marks", group=groupStyle)
showCaps        = input.bool(true,  "Show Segment Cap Lines", group=groupStyle)
connectSegments = input.bool(true,  "Connect Segment Endpoints", group=groupStyle)
midGlowWidth    = input.int(2, "Mid Glow Width", minval=1, maxval=10, group=groupStyle)
midMainWidth    = input.int(1, "Mid Main Width", minval=1, maxval=5, group=groupStyle)
bandWidth       = input.int(1, "Band Edge Width", minval=1, maxval=3, group=groupStyle)
glowTransp      = input.int(72, "Glow Transparency", minval=0, maxval=100, group=groupStyle)
bandTransp      = input.int(84, "Band Edge Transparency", minval=0, maxval=100, group=groupStyle)
colorUp         = input.color(color.lime, "Up Line Color", group=groupStyle)
colorDown       = input.color(color.red,  "Down Line Color", group=groupStyle)
colorNeutral    = input.color(color.gray, "Neutral Line Color", group=groupStyle)
gradInnerRatio   = input.float(0.45, "Gradient Inner Ratio", minval=0.10, maxval=0.90, step=0.01, group=groupGrad)
upGradUpper      = input.color(color.lime,  "Bull Upper", group=groupGrad, inline="bullg")
upGradLower      = input.color(#00796B,    "Lower", group=groupGrad, inline="bullg")
downGradUpper    = input.color(#B71C1C,    "Bear Upper", group=groupGrad, inline="bearg")
downGradLower    = input.color(color.red,  "Lower", group=groupGrad, inline="bearg")
neutralGradColor = input.color(color.gray, "Neutral Gradient Color", group=groupGrad)
upOuterTransp      = input.int(90, "Up Outer Transparency", minval=0, maxval=100, group=groupGrad)
upInnerTransp      = input.int(97, "Up Inner Transparency", minval=0, maxval=100, group=groupGrad)
downOuterTransp    = input.int(90, "Down Outer Transparency", minval=0, maxval=100, group=groupGrad)
downInnerTransp    = input.int(97, "Down Inner Transparency", minval=0, maxval=100, group=groupGrad)
neutralOuterTransp = input.int(92, "Neutral Outer Transparency", minval=0, maxval=100, group=groupGrad)
neutralInnerTransp = input.int(98, "Neutral Inner Transparency", minval=0, maxval=100, group=groupGrad)
//──────────────────────────────────────────────────────────────────────────────
// 3D Effect Inputs
//──────────────────────────────────────────────────────────────────────────────
group3D = "3D Effects"
show3D         = input.bool(true,   "Enable 3D Effects", group=group3D)
depthMult      = input.float(0.15,  "Depth Multiplier", step=0.05, minval=0.05, maxval=0.50, group=group3D, tooltip="ATR-scaled vertical depth offset for the 3D illusion.")
widthBars      = input.int(3,       "Depth Width (bars)", minval=1, maxval=8, group=group3D, tooltip="Horizontal bar shift for depth faces.")
maxRender3D    = input.int(5,       "Max 3D Segments", minval=2, maxval=8, group=group3D)
narrowThresh   = input.float(1.20,  "Narrow Threshold", step=0.05, minval=0.5, maxval=2.0, group=group3D, tooltip="When channel half-width < this × ATR, trigger waterfall/cliff effects. Base half-width is ~1.05 ATR, so values above 1.05 catch tighter channels.")
bullPersp      = input.string("Fwd Down", "Bull Perspective", options=["Fwd Up", "Fwd Down", "Back Up", "Back Down"], group=group3D, tooltip="3D depth direction for bull segments. Fwd/Back = horizontal. Up/Down = vertical.")
bearPersp      = input.string("Back Up",  "Bear Perspective", options=["Fwd Up", "Fwd Down", "Back Up", "Back Down"], group=group3D, tooltip="3D depth direction for bear segments. Fwd/Back = horizontal. Up/Down = vertical.")
faceTransp     = input.int(55,      "Depth Face Transparency", minval=0, maxval=100, group=group3D, tooltip="Transparency of the top/bottom 3D depth face.")
sideTransp     = input.int(45,      "Side Wall Transparency", minval=0, maxval=100, group=group3D, tooltip="Transparency of the 3D side wall (end cap).")
showWaterfall  = input.bool(true,   "Waterfall Effect (narrow bear)", group=group3D)
showCliff      = input.bool(true,   "Rocky Cliff Effect (narrow bull)", group=group3D)
//──────────────────────────────────────────────────────────────────────────────
// Momentum Engine Inputs
//──────────────────────────────────────────────────────────────────────────────
groupMom = "Momentum Engine"
useMomEngine   = input.bool(true,   "Enable Momentum Engine", group=groupMom, tooltip="VWMA delta drives 3D opacity and glow intensity. Strong momentum = vivid blocks. Weak = ghostly.")
showConfDot    = input.bool(true,   "Show Confluence Dot", group=groupMom, tooltip="Small color-coded dot near last bar showing momentum-regime alignment.")
//──────────────────────────────────────────────────────────────────────────────
// Theme Resolution — override visual settings when not "Custom"
//──────────────────────────────────────────────────────────────────────────────
bool isCustom  = themePreset == "Custom"
bool isDualB   = themePreset == "Dual Band"
bool isSlabs   = themePreset == "Price Slabs"
bool isNeon    = themePreset == "Neon Glass"
bool isClassic = themePreset == "Classic"
// Style overrides — Dual Band uses slim lines
_midGlowWidth  = isCustom ? midGlowWidth  : isDualB ? 2 : 5
_midMainWidth  = isCustom ? midMainWidth  : isDualB ? 1 : 2
// Gradient — all themes use user-defined colors, only ratios/transparency change
_gradInnerRatio = isCustom ? gradInnerRatio : isSlabs ? 0.60 : isNeon ? 0.50 : 0.45
_upGradUpper    = upGradUpper
_upGradLower    = upGradLower
_downGradUpper  = downGradUpper
_downGradLower  = downGradLower
_upOuterTransp      = isCustom ? upOuterTransp      : isDualB ? 80 : 90
_upInnerTransp      = isCustom ? upInnerTransp      : 97
_downOuterTransp    = isCustom ? downOuterTransp    : isDualB ? 80 : 90
_downInnerTransp    = isCustom ? downInnerTransp    : 97
_neutralOuterTransp = isCustom ? neutralOuterTransp : 92
_neutralInnerTransp = isCustom ? neutralInnerTransp : 98
// 3D
_show3D         = isCustom ? show3D        : isClassic ? false : true
_depthMult      = isCustom ? depthMult     : isNeon ? 0.10 : 0.15
_widthBars      = isCustom ? widthBars     : isDualB ? 2 : isNeon ? 2 : 3
_maxRender3D    = isCustom ? maxRender3D   : isDualB ? 8 : isNeon ? 6 : 8
_faceTransp     = isCustom ? faceTransp    : isDualB ? 85 : isSlabs ? 85 : isNeon ? 75 : 55
_sideTransp     = isCustom ? sideTransp    : isDualB ? 85 : isSlabs ? 85 : isNeon ? 70 : 45
_narrowThresh   = isCustom ? narrowThresh  : 1.20
_bullPersp      = isCustom ? bullPersp     : "Fwd Down"
_bearPersp      = isCustom ? bearPersp     : "Back Up"
_showWaterfall  = isCustom ? showWaterfall : isClassic ? false : true
_showCliff      = isCustom ? showCliff     : isClassic ? false : true
// Cap line style per theme
_capStyle       = isDualB ? line.style_solid : isSlabs ? line.style_dotted : isNeon ? line.style_dashed : line.style_solid
//──────────────────────────────────────────────────────────────────────────────
// Local context measures
//──────────────────────────────────────────────────────────────────────────────
atrRaw    = ta.atr(atrLen)
atr       = na(atrRaw) ? ta.tr(true) : atrRaw
basisRaw  = ta.ema(hl2, basisLen)
basis     = na(basisRaw) ? hl2 : basisRaw
spreadRaw = ta.stdev(hl2, basisLen)
spread    = na(spreadRaw) ? 0.0 : spreadRaw
basisSlope = basis - nz(basis[1], basis)
widthSeedRaw = atr * widthATR + spread * widthStdMult
widthSeedCap = atr * widthCapATR
widthSeed    = math.min(widthSeedRaw, widthSeedCap)
//──────────────────────────────────────────────────────────────────────────────
// Momentum Engine — VWMA Delta (your original S/T/R insight)
// Fast VWMA vs Slow VWMA delta = momentum direction + acceleration
// No security calls. Works on any timeframe. Normalized by ATR.
//──────────────────────────────────────────────────────────────────────────────
bool  hasVol     = not na(volume) and volume > 0
float fastVWMA   = hasVol ? ta.vwma(close, 10) : ta.ema(close, 10)
float slowVWMA   = hasVol ? ta.vwma(close, 30) : ta.ema(close, 30)
float momDelta   = fastVWMA - slowVWMA
float momSmooth  = ta.rma(momDelta, 20)
float momNorm    = atr > 0 ? momDelta / atr : 0.0
float momAccel   = momDelta - momSmooth
//──────────────────────────────────────────────────────────────────────────────
// Persistent segment state
//──────────────────────────────────────────────────────────────────────────────
var float segMid0  = na
var float segSlope = 0.0
var float segWidth = na
var int   segBar0  = na
var int   segDir   = 0
var int   segLock  = 0
var int upFlipStreak = 0
var int dnFlipStreak = 0
var int upContStreak = 0
var int dnContStreak = 0
var int detachStreak = 0
//──────────────────────────────────────────────────────────────────────────────
// 3D Segment History Ring Buffer (fixed size 8)
//──────────────────────────────────────────────────────────────────────────────
int MAX_3D = 8
var int[]   hBar0   = array.new_int(MAX_3D, 0)
var int[]   hBar1   = array.new_int(MAX_3D, 0)
var float[] hUp0    = array.new_float(MAX_3D, 0.0)
var float[] hLo0    = array.new_float(MAX_3D, 0.0)
var float[] hUp1    = array.new_float(MAX_3D, 0.0)
var float[] hLo1    = array.new_float(MAX_3D, 0.0)
var int[]   hDir    = array.new_int(MAX_3D, 0)
var float[] hWid    = array.new_float(MAX_3D, 0.0)
var float[] hATR    = array.new_float(MAX_3D, 0.0)
var float[] hMid0   = array.new_float(MAX_3D, 0.0)
var float[] hMid1   = array.new_float(MAX_3D, 0.0)
var float[] hConf   = array.new_float(MAX_3D, 0.5)
var float   lastConf = 0.5
var int     hIdx    = 0
var int     hCount  = 0
if na(segMid0)
    initDir   = basisSlope > 0 ? 1 : basisSlope < 0 ? -1 : 0
    segMid0   := basis
    segSlope  := 0.0
    segWidth  := widthSeed
    segBar0   := bar_index
    segDir    := initDir
    segLock   := 0
//──────────────────────────────────────────────────────────────────────────────
// Current segment projection before any event
//──────────────────────────────────────────────────────────────────────────────
agePre   = bar_index - segBar0
midPre   = segMid0 + segSlope * agePre
widthPre = math.max(nz(segWidth, widthSeed), atr * 0.25)
upperPre = midPre + widthPre
lowerPre = midPre - widthPre
//──────────────────────────────────────────────────────────────────────────────
// Structural event logic
// eventType:
//  1  = bullish regime flip
// -1  = bearish regime flip
//  2  = bullish continuation step
// -2  = bearish continuation step
//  3  = local refresh / re-anchor only
//──────────────────────────────────────────────────────────────────────────────
upFlipQual = segDir != 1 and close > upperPre + atr * flipATR
dnFlipQual = segDir != -1 and close < lowerPre - atr * flipATR
upContQual = segDir == 1 and close > upperPre + atr * contATR
dnContQual = segDir == -1 and close < lowerPre - atr * contATR
upFlipStreak := upFlipQual ? upFlipStreak + 1 : 0
dnFlipStreak := dnFlipQual ? dnFlipStreak + 1 : 0
upContStreak := upContQual ? upContStreak + 1 : 0
dnContStreak := dnContQual ? dnContStreak + 1 : 0
detachedNow   = math.abs(basis - midPre) > atr * detachATR
detachStreak := detachedNow ? detachStreak + 1 : 0
flipUp   = segLock <= 0 and upFlipStreak >= confirmBars
flipDn   = segLock <= 0 and dnFlipStreak >= confirmBars
contUp   = segLock <= 0 and upContStreak >= confirmBars
contDn   = segLock <= 0 and dnContStreak >= confirmBars
stale    = agePre >= maxSegBars
refresh  = segLock <= 0 and not (flipUp or flipDn or contUp or contDn) and (stale or detachStreak >= detachBars)
eventType =
     flipUp  ? 1  :
     flipDn  ? -1 :
     contUp  ? 2  :
     contDn  ? -2 :
     refresh ? 3  : 0
didEvent = eventType != 0
prevDir  = segDir
//──────────────────────────────────────────────────────────────────────────────
// Re-anchor locally on event
//──────────────────────────────────────────────────────────────────────────────
if didEvent
    // Capture ending segment into 3D history BEFORE re-anchor overwrites state
    if _show3D
        array.set(hBar0, hIdx, segBar0)
        array.set(hBar1, hIdx, bar_index)
        array.set(hUp0,  hIdx, segMid0 + nz(segWidth, widthSeed))
        array.set(hLo0,  hIdx, segMid0 - nz(segWidth, widthSeed))
        array.set(hUp1,  hIdx, upperPre)
        array.set(hLo1,  hIdx, lowerPre)
        array.set(hDir,  hIdx, segDir)
        array.set(hWid,  hIdx, nz(segWidth, widthSeed))
        array.set(hATR,  hIdx, atr)
        array.set(hMid0, hIdx, segMid0)
        array.set(hMid1, hIdx, midPre)
        array.set(hConf, hIdx, lastConf)
        hIdx   := (hIdx + 1) % MAX_3D
        hCount := math.min(hCount + 1, MAX_3D)
    newDir =
         eventType == 1  ? 1  :
         eventType == -1 ? -1 :
         eventType == 2  ? 1  :
         eventType == -2 ? -1 :
         segDir != 0 ? segDir :
         basisSlope >= 0 ? 1 : -1
    isLead   = midView == "Lead"
    anchorBase = isLead ? close : midPre + basisBlend * (basis - midPre)
    stepSize = eventType == 3 ? 0.0 : atr * stepATR
    newMid0  = isLead ? anchorBase - newDir * stepSize : anchorBase + newDir * stepSize
    slopeMag = atr * adverseSlopeATR
    newSlope = -newDir * slopeMag
    newWidth = widthSeed
    segMid0  := newMid0
    segSlope := newSlope
    segWidth := newWidth
    segBar0  := bar_index
    segDir   := newDir
    segLock  := cooldownBars
    upFlipStreak := 0
    dnFlipStreak := 0
    upContStreak := 0
    dnContStreak := 0
    detachStreak := 0
else
    segLock := math.max(segLock - 1, 0)
//──────────────────────────────────────────────────────────────────────────────
// Final projection
//──────────────────────────────────────────────────────────────────────────────
age   = bar_index - segBar0
mid   = segMid0 + segSlope * age
width = math.max(nz(segWidth, widthSeed), atr * 0.25)
upper = mid + width
lower = mid - width
upperInner = mid + (upper - mid) * _gradInnerRatio
lowerInner = mid - (mid - lower) * _gradInnerRatio
//──────────────────────────────────────────────────────────────────────────────
// Confluence Score — momentum alignment with regime (0.0 to 1.0)
// 1.0 = strong momentum confirming regime direction
// 0.5 = neutral / no momentum signal
// 0.0 = momentum opposing regime
//──────────────────────────────────────────────────────────────────────────────
float confluence = 0.5
if useMomEngine
    float momAlign = segDir == 1 ? momNorm : segDir == -1 ? -momNorm : 0.0
    float accelAlign = segDir == 1 ? (momAccel > 0 ? 1.0 : 0.3) : segDir == -1 ? (momAccel < 0 ? 1.0 : 0.3) : 0.5
    float rawConf = math.max(0.0, math.min(1.0, momAlign * 0.35 + 0.5))
    confluence := rawConf * 0.65 + accelAlign * 0.35
lastConf := confluence
// Dynamic glow: brighter when momentum confirms regime
int dynGlowTransp = useMomEngine ? math.max(20, int(glowTransp - confluence * 40)) : glowTransp
lineColor =
     segDir == 1 ? colorUp :
     segDir == -1 ? colorDown :
     colorNeutral
gradUpperColor =
     segDir == 1 ? _upGradUpper :
     segDir == -1 ? _downGradUpper :
     neutralGradColor
gradLowerColor =
     segDir == 1 ? _upGradLower :
     segDir == -1 ? _downGradLower :
     neutralGradColor
outerTransp =
     segDir == 1 ? _upOuterTransp :
     segDir == -1 ? _downOuterTransp :
     _neutralOuterTransp
innerTransp =
     segDir == 1 ? _upInnerTransp :
     segDir == -1 ? _downInnerTransp :
     _neutralInnerTransp
outerGradUpper = color.new(gradUpperColor, outerTransp)
innerGradUpper = color.new(gradUpperColor, innerTransp)
outerGradLower = color.new(gradLowerColor, outerTransp)
innerGradLower = color.new(gradLowerColor, innerTransp)
fadeColor      = color.new(gradUpperColor, 100)
//──────────────────────────────────────────────────────────────────────────────
// Marker semantics
//──────────────────────────────────────────────────────────────────────────────
bullRegimeFlip = didEvent and eventType == 1 and prevDir != 1
bearRegimeFlip = didEvent and eventType == -1 and prevDir != -1
bullStep = didEvent and eventType == 2
bearStep = didEvent and eventType == -2
refreshEvt = didEvent and eventType == 3
//──────────────────────────────────────────────────────────────────────────────
// Retests
//──────────────────────────────────────────────────────────────────────────────
crossLower = ta.crossunder(low, lower)
crossUpper = ta.crossover(high, upper)
retestLong  = segDir == 1 and crossLower
retestShort = segDir == -1 and crossUpper
//──────────────────────────────────────────────────────────────────────────────
// Single active renderer
//──────────────────────────────────────────────────────────────────────────────
midPlot        = connectSegments ? mid        : (didEvent ? na : mid)
upperPlot      = connectSegments ? upper      : (didEvent ? na : upper)
lowerPlot      = connectSegments ? lower      : (didEvent ? na : lower)
upperInnerPlot = connectSegments ? upperInner : (didEvent ? na : upperInner)
lowerInnerPlot = connectSegments ? lowerInner : (didEvent ? na : lowerInner)
pMidGlow = plot(midPlot, "Mid Glow", color=color.new(lineColor, dynGlowTransp), linewidth=midGlowWidth, style=plot.style_linebr)
pMid     = plot(midPlot, "Mid Line", color=lineColor, linewidth=midMainWidth, style=plot.style_linebr)
bandCol   = color.new(lineColor, bandTransp)
bandColHi = showBands ? bandCol : color.new(lineColor, 100)
pUpper      = plot(upperPlot, "Upper Band", color=bandColHi, linewidth=bandWidth, style=plot.style_linebr)
pUpperInner = plot(upperInnerPlot, "Upper Inner", color=color.new(lineColor, 100), linewidth=1, style=plot.style_linebr)
pLowerInner = plot(lowerInnerPlot, "Lower Inner", color=color.new(lineColor, 100), linewidth=1, style=plot.style_linebr)
pLower      = plot(lowerPlot, "Lower Band", color=bandColHi, linewidth=bandWidth, style=plot.style_linebr)
//──────────────────────────────────────────────────────────────────────────────
// Dual-layer gradient fills
//──────────────────────────────────────────────────────────────────────────────
fill(pUpper,      pUpperInner, showFill ? upperPlot      : na, showFill ? upperInnerPlot : na, outerGradUpper, innerGradUpper)
fill(pUpperInner, pMid,        showFill ? upperInnerPlot : na, showFill ? midPlot        : na, innerGradUpper, fadeColor)
fill(pLowerInner, pLower,      showFill ? lowerInnerPlot : na, showFill ? lowerPlot      : na, innerGradLower, outerGradLower)
fill(pMid,        pLowerInner, showFill ? midPlot        : na, showFill ? lowerInnerPlot : na, fadeColor,      innerGradLower)
//──────────────────────────────────────────────────────────────────────────────
// Segment cap lines
//──────────────────────────────────────────────────────────────────────────────
var line[] segCaps = array.new_line()
maxCaps = 300
if didEvent and showCaps
    capCol = color.new(gradUpperColor, math.min(outerTransp + 4, 96))
    cap = line.new(
         x1=bar_index, y1=lower,
         x2=bar_index, y2=upper,
         xloc=xloc.bar_index, extend=extend.none,
         color=capCol, width=1, style=_capStyle)
    array.push(segCaps, cap)
    if array.size(segCaps) > maxCaps
        oldCap = array.shift(segCaps)
        line.delete(oldCap)
//──────────────────────────────────────────────────────────────────────────────
// 3D Effect Rendering (delete-and-redraw on last bar)
//──────────────────────────────────────────────────────────────────────────────
var polyline[] poly3D = array.new<polyline>()
if barstate.islast and _show3D
    // Clean previous polylines
    if array.size(poly3D) > 0
        for i = 0 to array.size(poly3D) - 1
            polyline.delete(array.get(poly3D, i))
    array.clear(poly3D)
    // Render historical segments (oldest first for correct layering)
    int renderCount = math.min(hCount, _maxRender3D)
    if renderCount > 0
        for i = renderCount - 1 to 0
            int ri      = (hIdx - 1 - i + MAX_3D) % MAX_3D
            int sBar    = array.get(hBar0, ri)
            int eBar    = array.get(hBar1, ri)
            float sUp   = array.get(hUp0, ri)
            float sLo   = array.get(hLo0, ri)
            float eUp   = array.get(hUp1, ri)
            float eLo   = array.get(hLo1, ri)
            int   sDir  = array.get(hDir, ri)
            float sWid  = array.get(hWid, ri)
            float sATR  = array.get(hATR, ri)
            float sConf = useMomEngine ? array.get(hConf, ri) : 0.75
            if sBar > last_bar_index - 500 and eBar > sBar + 1
                // Per-segment perspective from bull/bear dropdowns
                string persp = sDir >= 1 ? _bullPersp : _bearPersp
                bool segBack = persp == "Back Up" or persp == "Back Down"
                bool invertY = persp == "Fwd Down" or persp == "Back Down"
                int  segDxS  = segBack ? -1 : 1
                float dY = sATR * _depthMult * (invertY ? -1.0 : 1.0)
                int   dX = _widthBars * segDxS
                int   sideX  = segBack ? sBar : eBar
                float sideUp = segBack ? sUp  : eUp
                float sideLo = segBack ? sLo  : eLo
                // Face color: modulated by confluence (strong momentum = vivid, weak = ghostly)
                int confFaceT = int(_faceTransp + (1.0 - sConf) * 25)
                int confSideT = int(_sideTransp + (1.0 - sConf) * 20)
                color faceCol = sDir >= 1 ? color.new(_upGradUpper, math.min(confFaceT, 98)) : sDir == -1 ? color.new(_downGradUpper, math.min(confFaceT, 98)) : color.new(neutralGradColor, math.min(confFaceT, 98))
                color sideCol = sDir >= 1 ? color.new(_upGradUpper, math.min(confSideT, 98)) : sDir == -1 ? color.new(_downGradLower, math.min(confSideT, 98)) : color.new(neutralGradColor, math.min(confSideT, 98))
                color lineC   = sDir == 1 ? _upGradUpper : sDir == -1 ? _downGradUpper : neutralGradColor
                bool  isNarrow = sWid < sATR * _narrowThresh
                //── SIDE FACE (slightly oversized to prevent gaps) ──
                float pad = sATR * 0.02
                array<chart.point> sidePts = array.new<chart.point>()
                sidePts.push(chart.point.from_index(sideX,      sideLo - pad))
                sidePts.push(chart.point.from_index(sideX,      sideUp + pad))
                sidePts.push(chart.point.from_index(sideX + dX, sideUp + pad + dY))
                sidePts.push(chart.point.from_index(sideX + dX, sideLo - pad + dY))
                sidePts.push(chart.point.from_index(sideX,      sideLo - pad))
                array.push(poly3D, polyline.new(points=sidePts, line_color=color.new(lineC, 88), fill_color=sideCol))
                //── DEPTH FACE ──
                array<chart.point> facePts = array.new<chart.point>()
                if isNarrow and _showWaterfall and sDir == -1
                    int steps   = 4
                    int segBars = eBar - sBar
                    float sDrop = dY * 0.4
                    for s = 0 to steps
                        float frac = steps > 0 ? s / steps : 0.0
                        facePts.push(chart.point.from_index(sBar + int(segBars * frac), sUp + (eUp - sUp) * frac))
                    for s = steps to 0
                        float frac = steps > 0 ? s / steps : 0.0
                        facePts.push(chart.point.from_index(sBar + int(segBars * frac) + dX, sUp + (eUp - sUp) * frac + dY - sDrop * (steps - s)))
                    facePts.push(chart.point.from_index(sBar, sUp))
                else if isNarrow and _showCliff and sDir == 1
                    int jags    = 5
                    int segBars = eBar - sBar
                    for s = 0 to jags
                        float frac = jags > 0 ? s / jags : 0.0
                        facePts.push(chart.point.from_index(sBar + int(segBars * frac), sUp + (eUp - sUp) * frac))
                    for s = jags to 0
                        float frac = jags > 0 ? s / jags : 0.0
                        float jagOff = (s % 2 == 0) ? dY * 0.35 : -dY * 0.15
                        facePts.push(chart.point.from_index(sBar + int(segBars * frac) + dX, sUp + (eUp - sUp) * frac + dY + jagOff))
                    facePts.push(chart.point.from_index(sBar, sUp))
                else
                    facePts.push(chart.point.from_index(sBar,      sUp))
                    facePts.push(chart.point.from_index(eBar,      eUp))
                    facePts.push(chart.point.from_index(eBar + dX, eUp + dY))
                    facePts.push(chart.point.from_index(sBar + dX, sUp + dY))
                    facePts.push(chart.point.from_index(sBar,      sUp))
                array.push(poly3D, polyline.new(points=facePts, line_color=color.new(lineC, 88), fill_color=faceCol))
    // Render CURRENT live segment
    if segBar0 > last_bar_index - 500 and bar_index > segBar0 + 1
        float curUp0 = segMid0 + nz(segWidth, widthSeed)
        float curLo0 = segMid0 - nz(segWidth, widthSeed)
        string curPersp = segDir >= 1 ? _bullPersp : _bearPersp
        bool  curBack = curPersp == "Back Up" or curPersp == "Back Down"
        bool  curInvY = curPersp == "Fwd Down" or curPersp == "Back Down"
        float curDY  = atr * _depthMult * (curInvY ? -1.0 : 1.0)
        int   curDX  = _widthBars * (curBack ? -1 : 1)
        int   curSX  = curBack ? segBar0 : bar_index
        float curSUp = curBack ? curUp0  : upper
        float curSLo = curBack ? curLo0  : lower
        float curConf = useMomEngine ? confluence : 0.75
        int curConfFT = int(_faceTransp + (1.0 - curConf) * 25)
        int curConfST = int(_sideTransp + (1.0 - curConf) * 20)
        color curFace = segDir >= 1 ? color.new(_upGradUpper, math.min(curConfFT, 98)) : segDir == -1 ? color.new(_downGradUpper, math.min(curConfFT, 98)) : color.new(neutralGradColor, math.min(curConfFT, 98))
        color curSideC = segDir >= 1 ? color.new(_upGradUpper, math.min(curConfST, 98)) : segDir == -1 ? color.new(_downGradLower, math.min(curConfST, 98)) : color.new(neutralGradColor, math.min(curConfST, 98))
        color curLineC = segDir == 1 ? _upGradUpper : segDir == -1 ? _downGradUpper : neutralGradColor
        bool  curNarrow = nz(segWidth, widthSeed) < atr * _narrowThresh
        // Side face (slightly oversized to prevent gaps)
        float curPad = atr * 0.02
        array<chart.point> cSide = array.new<chart.point>()
        cSide.push(chart.point.from_index(curSX,         curSLo - curPad))
        cSide.push(chart.point.from_index(curSX,         curSUp + curPad))
        cSide.push(chart.point.from_index(curSX + curDX, curSUp + curPad + curDY))
        cSide.push(chart.point.from_index(curSX + curDX, curSLo - curPad + curDY))
        cSide.push(chart.point.from_index(curSX,         curSLo - curPad))
        array.push(poly3D, polyline.new(points=cSide, line_color=color.new(curLineC, 88), fill_color=curSideC))
        // Depth face
        array<chart.point> cFace = array.new<chart.point>()
        if curNarrow and _showWaterfall and segDir == -1
            int cSteps   = 4
            int cSegBars = bar_index - segBar0
            float cDrop  = curDY * 0.4
            for s = 0 to cSteps
                float frac = cSteps > 0 ? s / cSteps : 0.0
                cFace.push(chart.point.from_index(segBar0 + int(cSegBars * frac), curUp0 + (upper - curUp0) * frac))
            for s = cSteps to 0
                float frac = cSteps > 0 ? s / cSteps : 0.0
                cFace.push(chart.point.from_index(segBar0 + int(cSegBars * frac) + curDX, curUp0 + (upper - curUp0) * frac + curDY - cDrop * (cSteps - s)))
            cFace.push(chart.point.from_index(segBar0, curUp0))
        else if curNarrow and _showCliff and segDir == 1
            int cJags    = 5
            int cSegBars = bar_index - segBar0
            for s = 0 to cJags
                float frac = cJags > 0 ? s / cJags : 0.0
                cFace.push(chart.point.from_index(segBar0 + int(cSegBars * frac), curUp0 + (upper - curUp0) * frac))
            for s = cJags to 0
                float frac = cJags > 0 ? s / cJags : 0.0
                float jagOff = (s % 2 == 0) ? curDY * 0.35 : -curDY * 0.15
                cFace.push(chart.point.from_index(segBar0 + int(cSegBars * frac) + curDX, curUp0 + (upper - curUp0) * frac + curDY + jagOff))
            cFace.push(chart.point.from_index(segBar0, curUp0))
        else
            cFace.push(chart.point.from_index(segBar0,           curUp0))
            cFace.push(chart.point.from_index(bar_index,         upper))
            cFace.push(chart.point.from_index(bar_index + curDX, upper + curDY))
            cFace.push(chart.point.from_index(segBar0 + curDX,   curUp0 + curDY))
            cFace.push(chart.point.from_index(segBar0,           curUp0))
        array.push(poly3D, polyline.new(points=cFace, line_color=color.new(curLineC, 88), fill_color=curFace))
//──────────────────────────────────────────────────────────────────────────────
// Confluence Dot — momentum-regime alignment badge
//──────────────────────────────────────────────────────────────────────────────
color confDotCol = confluence >= 0.75 ? color.new(lineColor, 10) : confluence >= 0.5 ? color.new(lineColor, 50) : color.new(color.gray, 40)
plotshape(useMomEngine and showConfDot ? mid : na, title="Confluence",
     style=shape.diamond, location=location.absolute, color=confDotCol, size=size.tiny)
//──────────────────────────────────────────────────────────────────────────────
// Regime change markers: ONLY true flips
//──────────────────────────────────────────────────────────────────────────────
plotshape(showRegimeMarks and bullRegimeFlip, title="Bull Regime Flip",
     style=shape.triangleup, location=location.belowbar, color=colorUp, size=size.small)
plotshape(showRegimeMarks and bearRegimeFlip, title="Bear Regime Flip",
     style=shape.triangledown, location=location.abovebar, color=colorDown, size=size.small)
plotshape(showRegimeMarks and bullRegimeFlip ? mid : na, title="Bull Regime Glow",
     style=shape.circle, location=location.absolute, color=color.new(colorUp, 55), size=size.small)
plotshape(showRegimeMarks and bearRegimeFlip ? mid : na, title="Bear Regime Glow",
     style=shape.circle, location=location.absolute, color=color.new(colorDown, 55), size=size.small)
//──────────────────────────────────────────────────────────────────────────────
// Continuation step markers — on candles with glow
//──────────────────────────────────────────────────────────────────────────────
plotshape(showStepMarks and bullStep ? high : na, title="Bull Step",
     style=shape.circle, location=location.absolute, color=colorUp, size=size.tiny)
plotshape(showStepMarks and bullStep ? high : na, title="Bull Step Glow",
     style=shape.circle, location=location.absolute, color=color.new(colorUp, 50), size=size.small)
plotshape(showStepMarks and bearStep ? low : na, title="Bear Step",
     style=shape.circle, location=location.absolute, color=colorDown, size=size.tiny)
plotshape(showStepMarks and bearStep ? low : na, title="Bear Step Glow",
     style=shape.circle, location=location.absolute, color=color.new(colorDown, 50), size=size.small)
//──────────────────────────────────────────────────────────────────────────────
// Quiet retest markers
//──────────────────────────────────────────────────────────────────────────────
plotshape(showRetests and retestLong, title="Lower Retest",
     style=shape.triangleup, location=location.belowbar, color=color.new(colorUp, 8), size=size.tiny)
plotshape(showRetests and retestShort, title="Upper Retest",
     style=shape.triangledown, location=location.abovebar, color=color.new(colorDown, 8), size=size.tiny)
//──────────────────────────────────────────────────────────────────────────────
// Optional refresh marks
//──────────────────────────────────────────────────────────────────────────────
plotshape(showRefresh and refreshEvt ? mid : na, title="Refresh Event",
     style=shape.square, location=location.absolute, color=color.new(colorNeutral, 35), size=size.tiny)
