//@version=6
indicator("Liquidity + HVP + Swing Projection + Low-Vol Range Breakouts", "Liq+HVP+Swing+LVRB",
     overlay = true,
     max_lines_count = 500,
     max_boxes_count = 500,
     max_labels_count = 500,
     max_polylines_count = 100,
     max_bars_back = 3000)

//==================================================================================================
// MODULE A — Buyside & Sellside Liquidity (Touch & Reject Alerts)
//==================================================================================================
grpLiq = "Liquidity Detection (Zones)"
liqLen = input.int(7, title="Detection Length", minval=3, maxval=13, inline="LIQ", group=grpLiq)
liqMar = 10 / input.float(6.9, "Pivot Margin", minval=4, maxval=9, step=0.1, inline="LIQ", group=grpLiq)

liqBuy = input.bool(true, "Buyside Zones", inline="B", group=grpLiq)
marBuy = input.float(2.3, "Zone Margin", minval=1.5, maxval=10, step=.1, inline="B", group=grpLiq)
cLIQ_B = input.color(color.new(#4caf50, 0), "Color", inline="B", group=grpLiq)

liqSel = input.bool(true, "Sellside Zones", inline="S", group=grpLiq)
marSel = input.float(2.3, "Zone Margin", minval=1.5, maxval=10, step=.1, inline="S", group=grpLiq)
cLIQ_S = input.color(color.new(#f23645, 0), "Color", inline="S", group=grpLiq)

lqVoid = input.bool(false, "Liquidity Voids", inline="V", group=grpLiq)
cLQV_B = input.color(color.new(#4caf50, 0), "Bull", inline="V", group=grpLiq)
cLQV_S = input.color(color.new(#f23645, 0), "Bear", inline="V", group=grpLiq)
lqText = input.bool(false, "Void Label", inline="V", group=grpLiq)

mode   = input.string("Present", title="Mode", options=["Present", "Historical"], group=grpLiq)
visLiq = input.int(3, "Visible Levels", minval=1, maxval=50, group=grpLiq)

// Alerts — Liquidity
grpLiqA  = "Alerts — Liquidity"
al_detect = input.bool(true,  "Alert: Liquidity detected/updated", group=grpLiqA)
al_breach = input.bool(true,  "Alert: Liquidity breached", group=grpLiqA)
al_enter  = input.bool(true,  "Alert: Enter liquidity zone (start/in-zone)", group=grpLiqA)
al_touch  = input.bool(true,  "Alert: Touch zone", group=grpLiqA)
al_reject = input.bool(true,  "Alert: Touch + Reject (close out)", group=grpLiqA)

// Filters for sharper reject
grpFilt = "Touch+Reject Filters"
useCloseConfirm = input.bool(true, "Confirm on bar close", group=grpFilt)
minBodyAtr = input.float(0.15, "Min body size (ATR) for reject", step=0.01, minval=0, group=grpFilt)
requireDirCandle = input.bool(true, "Require direction candle (bear for Buyside reject / bull for Sellside reject)", group=grpFilt)

// Signals — Liquidity
grpLiqS      = "Signals — Liquidity"
showLiqSigs  = input.bool(true, "Show liquidity signals", group=grpLiqS)

// --- Liquidity core calcs
maxSize = 50
atrLiq     = ta.atr(10)
atr200Liq  = ta.atr(200)
per     = mode == "Present" ? last_bar_index - bar_index <= 500 : true

type ZZ
    int[] d
    int[] x
    float[] y

type liq
    box   bx
    box   bxz
    box   bxt
    bool  brZ
    bool  brL
    line  ln
    line  lne

var ZZ aZZ = ZZ.new(
     array.new_int(maxSize, 0),
     array.new_int(maxSize, 0),
     array.new_float(maxSize, na)
)

var liq[] b_liq_B = array.new<liq>(1, liq.new(box(na), box(na), box(na), false, false, line(na), line(na)))
var liq[] b_liq_S = array.new<liq>(1, liq.new(box(na), box(na), box(na), false, false, line(na), line(na)))

var box[] b_liq_V = array.new_box()

var int   dir = na
var int   x1  = na
var float y1  = na
var int   x2  = na
var float y2  = na

// Event flags (Liquidity)
var bool ev_buy_detect = false
var bool ev_sel_detect = false
var bool ev_buy_breach = false
var bool ev_sel_breach = false
var bool ev_buy_enter  = false
var bool ev_sel_enter  = false

// Touch & Reject
var bool ev_buy_touch  = false
var bool ev_sel_touch  = false
var bool ev_buy_reject = false
var bool ev_sel_reject = false

ev_buy_detect := false

ev_sel_detect := false

ev_buy_breach := false

ev_sel_breach := false

ev_buy_enter  := false

ev_sel_enter  := false

ev_buy_touch  := false

ev_sel_touch  := false

ev_buy_reject := false

ev_sel_reject := false

method in_out(ZZ a, int _d, int _x, float _y) =>
    a.d.unshift(_d)
    a.x.unshift(_x)
    a.y.unshift(_y)
    a.d.pop()
    a.x.pop()
    a.y.pop()

x2 := bar_index - 1
phL = ta.pivothigh(liqLen, 1)
plL = ta.pivotlow(liqLen, 1)

// --- Buyside detect
if not na(phL)
    dir := aZZ.d.get(0)
    x1  := aZZ.x.get(0)
    y1  := aZZ.y.get(0)
    y2  := nz(high[1])

    if dir < 1
        aZZ.in_out(1, x2, y2)
    else
        if dir == 1 and phL > y1
            aZZ.x.set(0, x2)
            aZZ.y.set(0, y2)

    if per
        int count = 0
        float st_P = 0.0
        int st_B = 0
        float minP = 0.0
        float maxP = 10e6

        for i = 0 to maxSize - 1
            if aZZ.d.get(i) == 1
                if aZZ.y.get(i) > phL + (atrLiq / liqMar)
                    break
                else
                    if aZZ.y.get(i) > phL - (atrLiq / liqMar) and aZZ.y.get(i) < phL + (atrLiq / liqMar)
                        count += 1
                        st_B := aZZ.x.get(i)
                        st_P := aZZ.y.get(i)
                        if aZZ.y.get(i) > minP
                            minP := aZZ.y.get(i)
                        if aZZ.y.get(i) < maxP
                            maxP := aZZ.y.get(i)

        if count > 2
            getB = b_liq_B.get(0)

            if st_B == getB.bx.get_left()
                getB.bx.set_top(math.avg(minP, maxP) + (atrLiq / liqMar))
                getB.bx.set_rightbottom(bar_index + 10, math.avg(minP, maxP) - (atrLiq / liqMar))
                ev_buy_detect := true
            else
                b_liq_B.unshift(
                    liq.new(
                        box.new(st_B, math.avg(minP, maxP) + (atrLiq / liqMar), bar_index + 10, math.avg(minP, maxP) - (atrLiq / liqMar), bgcolor=color(na), border_color=color(na)),
                        box.new(na, na, na, na, bgcolor=color(na), border_color=color(na)),
                        box.new(st_B, st_P, bar_index + 10, st_P,
                            text="Buyside liquidity", text_size=size.tiny,
                            text_halign=text.align_left, text_valign=text.align_bottom,
                            text_color=color.new(cLIQ_B, 25), bgcolor=color(na), border_color=color(na)),
                        false, false,
                        line.new(st_B, st_P, bar_index - 1, st_P, color=color.new(cLIQ_B, 0)),
                        line.new(bar_index - 1, st_P, na, st_P, color=color.new(cLIQ_B, 0), style=line.style_dotted)
                    )
                )
                ev_buy_detect := true

            if b_liq_B.size() > visLiq
                lastB = b_liq_B.pop()
                lastB.bx.delete()
                lastB.bxz.delete()
                lastB.bxt.delete()
                lastB.ln.delete()
                lastB.lne.delete()

// --- Sellside detect
if not na(plL)
    dir := aZZ.d.get(0)
    x1  := aZZ.x.get(0)
    y1  := aZZ.y.get(0)
    y2  := nz(low[1])

    if dir > -1
        aZZ.in_out(-1, x2, y2)
    else
        if dir == -1 and plL < y1
            aZZ.x.set(0, x2)
            aZZ.y.set(0, y2)

    if per
        int count = 0
        float st_P = 0.0
        int st_B = 0
        float minP = 0.0
        float maxP = 10e6

        for i = 0 to maxSize - 1
            if aZZ.d.get(i) == -1
                if aZZ.y.get(i) < plL - (atrLiq / liqMar)
                    break
                else
                    if aZZ.y.get(i) > plL - (atrLiq / liqMar) and aZZ.y.get(i) < plL + (atrLiq / liqMar)
                        count += 1
                        st_B := aZZ.x.get(i)
                        st_P := aZZ.y.get(i)
                        if aZZ.y.get(i) > minP
                            minP := aZZ.y.get(i)
                        if aZZ.y.get(i) < maxP
                            maxP := aZZ.y.get(i)

        if count > 2
            getS = b_liq_S.get(0)

            if st_B == getS.bx.get_left()
                getS.bx.set_top(math.avg(minP, maxP) + (atrLiq / liqMar))
                getS.bx.set_rightbottom(bar_index + 10, math.avg(minP, maxP) - (atrLiq / liqMar))
                ev_sel_detect := true
            else
                b_liq_S.unshift(
                    liq.new(
                        box.new(st_B, math.avg(minP, maxP) + (atrLiq / liqMar), bar_index + 10, math.avg(minP, maxP) - (atrLiq / liqMar), bgcolor=color(na), border_color=color(na)),
                        box.new(na, na, na, na, bgcolor=color(na), border_color=color(na)),
                        box.new(st_B, st_P, bar_index + 10, st_P,
                            text="Sellside liquidity", text_size=size.tiny,
                            text_halign=text.align_left, text_valign=text.align_top,
                            text_color=color.new(cLIQ_S, 25), bgcolor=color(na), border_color=color(na)),
                        false, false,
                        line.new(st_B, st_P, bar_index - 1, st_P, color=color.new(cLIQ_S, 0)),
                        line.new(bar_index - 1, st_P, na, st_P, color=color.new(cLIQ_S, 0), style=line.style_dotted)
                    )
                )
                ev_sel_detect := true

            if b_liq_S.size() > visLiq
                lastS = b_liq_S.pop()
                lastS.bx.delete()
                lastS.bxz.delete()
                lastS.bxt.delete()
                lastS.ln.delete()
                lastS.lne.delete()

// Helper
bodyOk() => math.abs(close - open) >= atrLiq * minBodyAtr
bearCandle() => close < open
bullCandle() => close > open

// --- Manage Buyside breach/zone + Touch/Reject
for i = 0 to b_liq_B.size() - 1
    lx = b_liq_B.get(i)

    lvl = lx.ln.get_y1()
    zLow = lvl - marBuy * atrLiq
    zHigh = lvl + marBuy * atrLiq

    touch = high >= zLow and low <= zHigh

    if not lx.brL
        lx.lne.set_x2(bar_index)

        if high > lx.bx.get_top()
            lx.brL := true
            lx.brZ := true
            ev_buy_breach := true
            ev_buy_enter  := true
            ev_buy_touch  := true

            lx.bxz.set_lefttop(bar_index - 1, math.min(lvl + marBuy * atrLiq, high))
            lx.bxz.set_rightbottom(bar_index + 1, lvl)
            lx.bxz.set_bgcolor(color.new(cLIQ_B, liqBuy ? 73 : 100))

    else if lx.brZ
        inBuyZone = low > lvl - marBuy * atrLiq and high < lvl + marBuy * atrLiq

        if touch
            ev_buy_touch := true

        if inBuyZone
            ev_buy_enter := true
            lx.bxz.set_right(bar_index + 1)
            lx.bxz.set_top(math.max(high, lx.bxz.get_top()))
            if liqBuy
                lx.lne.set_x2(bar_index + 1)
        else
            lx.brZ := false

        reject = touch and close < zLow
        reject := reject and bodyOk()
        reject := requireDirCandle ? (reject and bearCandle()) : reject
        if reject
            ev_buy_reject := true

// --- Manage Sellside breach/zone + Touch/Reject
for i = 0 to b_liq_S.size() - 1
    lx = b_liq_S.get(i)

    lvl = lx.ln.get_y1()
    zLow = lvl - marSel * atrLiq
    zHigh = lvl + marSel * atrLiq

    touch = high >= zLow and low <= zHigh

    if not lx.brL
        lx.lne.set_x2(bar_index)

        if low < lx.bx.get_bottom()
            lx.brL := true
            lx.brZ := true
            ev_sel_breach := true
            ev_sel_enter  := true
            ev_sel_touch  := true

            lx.bxz.set_lefttop(bar_index - 1, lvl)
            lx.bxz.set_rightbottom(bar_index + 1, math.max(lvl - marSel * atrLiq, low))
            lx.bxz.set_bgcolor(color.new(cLIQ_S, liqSel ? 73 : 100))

    else if lx.brZ
        inSelZone = low > lvl - marSel * atrLiq and high < lvl + marSel * atrLiq

        if touch
            ev_sel_touch := true

        if inSelZone
            ev_sel_enter := true
            lx.bxz.set_rightbottom(bar_index + 1, math.min(low, lx.bxz.get_bottom()))
            if liqSel
                lx.lne.set_x2(bar_index + 1)
        else
            lx.brZ := false

        reject = touch and close > zHigh
        reject := reject and bodyOk()
        reject := requireDirCandle ? (reject and bullCandle()) : reject
        if reject
            ev_sel_reject := true

// --- Liquidity Voids
if lqVoid and per
    bullV = low - high[2] > atr200Liq and low > high[2] and close[1] > high[2]
    bearV = low[2] - high > atr200Liq and high < low[2] and close[1] < low[2]

    if bullV
        int l = 13
        st = math.abs(low - high[2]) / l
        for j = 0 to l - 1
            if lqText and j == 0
                array.push(b_liq_V, box.new(bar_index - 2, high[2] + j * st, bar_index, high[2] + (j + 1) * st,
                     text="Liquidity Void", text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_bottom,
                     text_color=na, border_color=na, bgcolor=color.new(cLQV_B, 90)))
            else
                array.push(b_liq_V, box.new(bar_index - 2, high[2] + j * st, bar_index, high[2] + (j + 1) * st, border_color=na, bgcolor=color.new(cLQV_B, 90)))

    if bearV
        int l = 13
        st = math.abs(low[2] - high) / l
        for j = 0 to l - 1
            if lqText and j == l - 1
                array.push(b_liq_V, box.new(bar_index - 2, high + j * st, bar_index, high + (j + 1) * st,
                     text="Liquidity Void", text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_top,
                     text_color=na, border_color=na, bgcolor=color.new(cLQV_S, 90)))
            else
                array.push(b_liq_V, box.new(bar_index - 2, high + j * st, bar_index, high + (j + 1) * st, border_color=na, bgcolor=color.new(cLQV_S, 90)))

if array.size(b_liq_V) > 0
    qt = array.size(b_liq_V)
    for bn = qt - 1 to 0
        if bn < array.size(b_liq_V)
            cb = array.get(b_liq_V, bn)
            ba = math.avg(cb.get_bottom(), cb.get_top())
            if math.sign(close[1] - ba) != math.sign(close - ba) or math.sign(close[1] - ba) != math.sign(low - ba) or math.sign(close[1] - ba) != math.sign(high - ba)
                array.remove(b_liq_V, bn)
            else
                cb.set_right(bar_index + 1)

// Alerts (Touch alerts are ALERT ONLY — no plots)
alertcondition(al_touch and ev_buy_touch,  title="Liq: Buyside Touch",  message="Buyside liquidity zone touched on {{ticker}} ({{interval}}).")
alertcondition(al_touch and ev_sel_touch,  title="Liq: Sellside Touch", message="Sellside liquidity zone touched on {{ticker}} ({{interval}}).")
alertcondition(al_reject and ev_buy_reject, title="Liq: Buyside Touch + Reject", message="Buyside liquidity touch and reject (bearish close) on {{ticker}} ({{interval}}).")
alertcondition(al_reject and ev_sel_reject, title="Liq: Sellside Touch + Reject", message="Sellside liquidity touch and reject (bullish close) on {{ticker}} ({{interval}}).")

// Liquidity signals (NO touch plots; keep reject as RJ)
plotshape(showLiqSigs and ev_buy_detect, title="Liq Sig: Buy Detected", style=shape.circle, location=location.abovebar, size=size.tiny, text="B+")
plotshape(showLiqSigs and ev_sel_detect, title="Liq Sig: Sell Detected", style=shape.circle, location=location.belowbar, size=size.tiny, text="S+")
plotshape(showLiqSigs and ev_buy_breach, title="Liq Sig: Buy Breach", style=shape.triangleup, location=location.abovebar, size=size.tiny, text="BB")
plotshape(showLiqSigs and ev_sel_breach, title="Liq Sig: Sell Breach", style=shape.triangledown, location=location.belowbar, size=size.tiny, text="SB")
plotshape(showLiqSigs and ev_buy_enter,  title="Liq Sig: Enter Buy Zone", style=shape.labelup, location=location.abovebar, size=size.tiny, text="IN B")
plotshape(showLiqSigs and ev_sel_enter,  title="Liq Sig: Enter Sell Zone", style=shape.labeldown, location=location.belowbar, size=size.tiny, text="IN S")
plotshape(showLiqSigs and ev_buy_reject, title="Liq Sig: Buy Reject", style=shape.xcross, location=location.abovebar, size=size.tiny, text="RJ")
plotshape(showLiqSigs and ev_sel_reject, title="Liq Sig: Sell Reject", style=shape.xcross, location=location.belowbar, size=size.tiny, text="RJ")

//==================================================================================================
// MODULE B — High Volume Points (HVP) (NO circle "box" plots; only labels + optional levels)
//==================================================================================================
grpHvp = "High Volume Points (HVP)"
hvp_on     = input.bool(true, "Enable HVP", group=grpHvp)
step       = input.float(1, "Diameter Scale", step=0.1, group=grpHvp)
filter_vol = input.float(2, "Filter Points by Volume", step=0.1, group=grpHvp, minval=0, maxval=6)

leftBars  = input.int(15, "Left Bars", group=grpHvp)
rightBars = input.int(15, "Right Bars", group=grpHvp)

grpHvpV  = "HVP Visual"
show_lvl = input.bool(true, "Show Levels", group=grpHvpV)
upper_col = input.color(#fda05e, "Upper Color", group=grpHvpV)
lower_col = input.color(#2fd68e, "Lower Color", group=grpHvpV)

grpHvpA = "Alerts — HVP"
al_hvp_high = input.bool(false, "Alert: High-volume Pivot High", group=grpHvpA)
al_hvp_low  = input.bool(false, "Alert: High-volume Pivot Low", group=grpHvpA)

var levels = array.new<line>()
var bool ev_hvp_high = false
var bool ev_hvp_low  = false

ev_hvp_high := false

ev_hvp_low  := false

f_check_cross(array<line> arrayOfLines) =>
    // Returns true if at least one level was crossed on this bar.
    bool anyCross = false
    int qty = array.size(arrayOfLines)
    if qty > 0
        for idx = qty - 1 to 0
            if idx < array.size(arrayOfLines)
                line ln = array.get(arrayOfLines, idx)
                float lvl_ = line.get_price(ln, bar_index)
                bool crossed = math.sign(close[1] - lvl_) != math.sign(close - lvl_)
                if crossed
                    anyCross := true
                    line.set_style(ln, line.style_dotted)
                    // Remove from tracking array, but keep it on chart.
                    line removed = array.remove(arrayOfLines, idx)
                    // Removed line from tracking array; no further action needed.
                    na
                else
                    line.set_x2(ln, bar_index)
    anyCross

f_draw_level(float price, int n, int w, color col) =>
    // keep width safe >= 1
    ww = math.max(1, w)
    line.new(x1=n, y1=price, x2=n, y2=price, style=line.style_solid, width=ww, color=col)

ph = hvp_on ? ta.pivothigh(leftBars, rightBars) : na
pl = hvp_on ? ta.pivotlow(leftBars, rightBars)  : na

volume_ = hvp_on ? math.sum(volume, leftBars * 2) : na
reference_vol = hvp_on ? ta.percentile_nearest_rank(volume_, 1000, 95) : na
norm_vol = (hvp_on and not na(reference_vol) and reference_vol != 0) ? (volume_ / reference_vol * 5) : na

if hvp_on and last_bar_index - bar_index < 300
    // Pivot High
    if not na(ph) and not na(norm_vol) and norm_vol > filter_vol and barstate.isconfirmed
        int n = bar_index - rightBars
        float src = high[rightBars]
        int w = int(math.round(norm_vol * step))
        if show_lvl
            array.push(levels, f_draw_level(src, n, math.round(w / 2), upper_col))
        label.new(n, src, "", xloc=xloc.bar_index, style=label.style_circle, textcolor=chart.fg_color, color=color.new(upper_col, 30), size=size.tiny)
        label.new(n, src, str.tostring(volume_, format.volume), xloc=xloc.bar_index, style=label.style_label_down, textcolor=chart.fg_color, color=color(na))
        ev_hvp_high := true

    // Pivot Low
    if not na(pl) and not na(norm_vol) and norm_vol > filter_vol and barstate.isconfirmed
        int n = bar_index - rightBars
        float src = low[rightBars]
        int w = int(math.round(norm_vol * step))
        if show_lvl
            array.push(levels, f_draw_level(src, n, math.round(w / 2), lower_col))
        label.new(n, src, "", xloc=xloc.bar_index, style=label.style_circle, textcolor=chart.fg_color, color=color.new(lower_col, 30), size=size.tiny)
        label.new(n, src, str.tostring(volume_, format.volume), xloc=xloc.bar_index, style=label.style_label_up, textcolor=chart.fg_color, color=color(na))
        ev_hvp_low := true

if hvp_on
    f_check_cross(levels)

// cleanup ONLY HVP lines
if hvp_on and not show_lvl
    for i = array.size(levels) - 1 to 0
        if i < array.size(levels)
            ln = array.get(levels, i)
            if not na(ln)
                line.delete(ln)
            array.remove(levels, i)

alertcondition(al_hvp_high and ev_hvp_high, title="HVP: High-volume Pivot High", message="High-volume PIVOT HIGH detected on {{ticker}} ({{interval}}).")
alertcondition(al_hvp_low and ev_hvp_low,   title="HVP: High-volume Pivot Low",  message="High-volume PIVOT LOW detected on {{ticker}} ({{interval}}).")

//==================================================================================================
// MODULE C — Swing Projection (Projected Target + Swing Zones + Dashboard)
//==================================================================================================

lenSwing = input.int(30, "Swing Detection Length", minval=10, group="Swing Projection")
offsetSwing = input.int(10, "Future Projection Offset", group="Swing Projection")
dataqty = input.int(5, "Historical Swing Samples", minval=3, maxval=20, group="Swing Projection")
calcType = input.string("Average", "Swing Projection Method", options=["Average", "Median", "Mode"], group="Swing Projection")

postion_d = input.string("Bottom Right", title="Dashboard Position", options=["Middle Right","Top Center","Top Right","Middle Left","Middle Center","Bottom Left","Bottom Center","Bottom Right"], group="Swing Projection")
sizeData = input.string("Normal", title="Dashboard Text Size", options=["Tiny","Small","Normal","Large","Huge"], group="Swing Projection")
extendR = input.bool(false, "Extend Swing Zones Forward", group="Swing Projection")
colorBullSw = input.color(color.rgb(21, 221, 124), "Bull Color", group="Swing Projection")
colorBearSw = input.color(color.rgb(235, 117, 20), "Bear Color", group="Swing Projection")

DataSize = switch sizeData
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large
    "Huge"   => size.huge

DashPos = switch postion_d
    "Middle Right"  => position.middle_right
    "Middle Left"   => position.middle_left
    "Middle Center" => position.middle_center
    "Top Right"     => position.top_right
    "Top Center"    => position.top_center
    "Bottom Right"  => position.bottom_right
    "Bottom Left"   => position.bottom_left
    "Bottom Center" => position.bottom_center

// Stats arrays
var swingPC = array.new<float>()

// Swing boxes
var box swingUpper = box(na)
var box swingLower = box(na)

// Swing point struct

type swingD
    float val
    int   indx

var hSwing = swingD.new(na, na)
var lSwing = swingD.new(na, na)

var line  futureSwing = line(na)
var label futureSwinglbl = label(na)

// Direction flag: true = down move, false = up move
var bool direc = false

H = ta.highest(lenSwing)
L = ta.lowest(lenSwing)

if high == H
    direc := true
if low == L
    direc := false

// Store completed swing high
if high[1] == H[1] and high < H
    hSwing.indx := bar_index[1]
    hSwing.val  := high[1]

// Store completed swing low
if low[1] == L[1] and low > L
    lSwing.indx := bar_index[1]
    lSwing.val  := low[1]

atrSwing = ta.atr(200) * 0.5

// volume arrays (re-built on last bar)
var buyVol = array.new<float>()
var sellVol = array.new<float>()

f_sum(array<float> a) =>
    int n = array.size(a)
    if n == 0
        0.0
    else
        float s = 0.0
        for i = 0 to n - 1
            s += array.get(a, i)
        s

if barstate.islast
    array.clear(buyVol)
    array.clear(sellVol)

    if not na(hSwing.indx) and not na(lSwing.indx)
        lowerIndex = math.min(hSwing.indx, lSwing.indx)
        for i = 0 to bar_index - lowerIndex
            if close[i] > open[i]
                array.push(buyVol, volume[i])
            else
                array.push(sellVol, volume[i])

// On direction change, finalize the swing
if direc != direc[1] and not na(hSwing.indx) and not na(lSwing.indx)
    mColor = direc ? colorBearSw : colorBullSw

    // swing leg line
    line.new(hSwing.indx, hSwing.val, lSwing.indx, lSwing.val, color=mColor, width=2)

    // zones
    box.delete(swingUpper)
    box.delete(swingLower)

    swingUpper := box.new(hSwing.indx, hSwing.val, bar_index + offsetSwing, hSwing.val + atrSwing,
         border_color=colorBearSw, border_width=1, bgcolor=color.new(colorBearSw, 80),
         text_halign=text.align_right, text_color=color.new(chart.fg_color, 10), text_size=DataSize)

    swingLower := box.new(lSwing.indx, lSwing.val, bar_index + offsetSwing, lSwing.val - atrSwing,
         border_color=colorBullSw, border_width=1, bgcolor=color.new(colorBullSw, 80),
         text_halign=text.align_right, text_color=color.new(chart.fg_color, 10), text_size=DataSize)

    // swing % move
    pc = not direc ? (hSwing.val - lSwing.val) / lSwing.val * 100 : (lSwing.val - hSwing.val) / hSwing.val * 100
    array.push(swingPC, pc)

    if array.size(swingPC) > dataqty
        array.shift(swingPC)

// extend zones each bar
if not na(swingUpper)
    box.set_right(swingUpper, bar_index + offsetSwing)
    box.set_text(
        swingUpper,
        str.tostring(hSwing.val) + "🔺\n" +
        "-" + str.tostring(f_sum(sellVol), format.volume) + "🔻"
    )


if not na(swingLower)
    box.set_right(swingLower, bar_index + offsetSwing)
    box.set_text(
        swingLower,
        str.tostring(lSwing.val) + "🔻\n" +
        "+" + str.tostring(f_sum(buyVol), format.volume) + "🔺"
    )


if extendR
    if not na(swingLower)
        box.set_extend(swingLower, extend.right)
    if not na(swingUpper)
        box.set_extend(swingUpper, extend.right)

// Dashboard + projection (only last bar)
var table dash = table.new(DashPos, 2, 25, border_width=1)

if barstate.islast
    // clear visible part
    for r = 0 to 24
        table.cell(dash, 0, r, "")
        table.cell(dash, 1, r, "")

    line.delete(futureSwing)
    label.delete(futureSwinglbl)

    avgSwing = array.new<float>()

    if array.size(swingPC) > 0
        for i = 0 to array.size(swingPC) - 1
            col = color.from_gradient(i, 0, array.size(swingPC) - 1, colorBearSw, colorBullSw)
            table.cell(dash, 0, i, "Swing " + str.tostring(i + 1), text_color=col, text_size=DataSize)
            table.cell(dash, 1, i, str.tostring(array.get(swingPC, i), format.percent), text_color=col, text_size=DataSize)
            array.push(avgSwing, math.abs(array.get(swingPC, i)))

        swingVal = switch calcType
            "Average" => array.avg(avgSwing)
            "Median"  => array.median(avgSwing)
            => array.mode(avgSwing)

        idx0 = array.size(swingPC)
        table.cell(dash, 0, idx0, "Swing AVG", text_color=chart.fg_color, text_size=DataSize)
        table.cell(dash, 1, idx0, (not direc ? "-" : "+") + str.tostring(swingVal, format.percent), text_color=chart.fg_color, text_size=DataSize)

        table.cell(dash, 0, idx0 + 1, "Delta Volume", text_color=chart.fg_color, text_size=DataSize)
        table.cell(dash, 1, idx0 + 1, str.tostring(f_sum(buyVol) - f_sum(sellVol), format.volume), text_color=chart.fg_color, text_size=DataSize)

        table.cell(dash, 0, idx0 + 2, "Total Volume", text_color=chart.fg_color, text_size=DataSize)
        table.cell(dash, 1, idx0 + 2, str.tostring(f_sum(buyVol) + f_sum(sellVol), format.volume), text_color=chart.fg_color, text_size=DataSize)

        // projection target
        if not na(hSwing.val) and not na(lSwing.val)
            if not direc
                pChange = hSwing.val - (hSwing.val * (swingVal / 100))
                futureSwinglbl := label.new(bar_index + offsetSwing, pChange, "-" + str.tostring(swingVal, format.percent),
                     style=label.style_label_left, color=color.new(chart.fg_color, 80), textcolor=chart.fg_color, size=DataSize)
                futureSwing := line.new(hSwing.indx, hSwing.val, bar_index + offsetSwing, pChange, color=chart.fg_color, style=line.style_dashed)
            else
                pChange = lSwing.val + (lSwing.val * (swingVal / 100))
                futureSwinglbl := label.new(bar_index + offsetSwing, pChange, "+" + str.tostring(swingVal, format.percent),
                     style=label.style_label_left, color=color.new(chart.fg_color, 80), textcolor=chart.fg_color, size=DataSize)
                futureSwing := line.new(lSwing.indx, lSwing.val, bar_index + offsetSwing, pChange, color=chart.fg_color, style=line.style_dashed)

//==================================================================================================
// MODULE D — Low Volatility Range Breakout (LVRB)
//==================================================================================================

groupLV = "Low Volatility Range"
lenVol      = input.int(20,   "Volatility Window (SMA)", minval=5, group=groupLV)
trMult      = input.float(1.00, "TR <= avgTR ×", minval=0.10, step=0.05, group=groupLV)
bodyMult    = input.float(1.10, "Body <= avgBody ×", minval=0.10, step=0.05, group=groupLV)
useBody     = input.bool(true,  "Use body filter", group=groupLV)

minBars     = input.int(6, "Min bars in 1 box", minval=2, group=groupLV)
minGoodFrac = input.float(0.65, "Min low-vol fraction in box", minval=0.0, maxval=1.0, step=0.05, group=groupLV)

gapMax      = input.int(5, "Allowed consecutive non-low-vol bars", minval=0, maxval=50, group=groupLV)
heightMult  = input.float(1.5, "Max box height = baseATR ×", minval=0.1, step=0.25, group=groupLV)

groupBO = "Breakout"
breakMode          = input.string("Wick", "Breakout Mode", options=["Wick", "Close"], group=groupBO)
breakoutBodyMult   = input.float(1.0, "Breakout body multiplier (1.0 = OFF)", minval=1.0, step=0.1, group=groupBO)
requireCandleColor = input.bool(false, "Require candle direction (green=LONG, red=SHORT)", group=groupBO)

groupVis = "LVRB Visuals"
showBoxes       = input.bool(true, "Show boxes", group=groupVis)
showSignals     = input.bool(true, "Show breakout signals", group=groupVis)
showLevels      = input.bool(false, "Show range levels (plots)", group=groupVis)
keepInvalidated = input.bool(true, "Keep invalidated boxes (neutral)", group=groupVis)
boxTransparency = input.int(85, "Box transparency (0-100)", minval=0, maxval=100, group=groupVis)
borderWidth     = input.int(1, "Box border width", minval=1, maxval=5, group=groupVis)

colorBullLV    = input.color(color.lime, "Bull color", group=groupVis)
colorBearLV    = input.color(color.red,  "Bear color", group=groupVis)
colorNeutralLV = input.color(color.gray, "Neutral color", group=groupVis)

trNow    = ta.tr(true)
avgTR    = ta.sma(trNow, lenVol)
bodyNow  = math.abs(close - open)
avgBody  = ta.sma(bodyNow, lenVol)

lvTR   = not na(avgTR) and (trNow <= avgTR * trMult)
lvBody = (not useBody) or (not na(avgBody) and (bodyNow <= avgBody * bodyMult))
isLowVol = lvTR and lvBody

minGoodBars = int(math.ceil(minBars * minGoodFrac))

var bool  inSeq      = false
var bool  qualified  = false
var int   startIdx   = na
var int   totalBars  = 0
var int   goodBars   = 0
var int   failStreak = 0

var float rngHi      = na
var float rngLo      = na
var float baseATR    = na
var float baseBody0  = na

var box   rngBox     = na

bullBreakLive   = false
bearBreakLive   = false
bullBreakCommit = false
bearBreakCommit = false

if not inSeq
    if isLowVol and not na(avgTR)
        inSeq      := true
        qualified  := false
        startIdx   := bar_index
        totalBars  := 1
        goodBars   := 1
        failStreak := 0
        rngHi      := high
        rngLo      := low
        baseATR    := avgTR
        baseBody0  := avgBody
        rngBox     := na
else
    if qualified and not na(rngHi) and not na(rngLo)
        upWickPierce = (high > rngHi)
        dnWickPierce = (low  < rngLo)

        upCloseOut = (close > rngHi)
        dnCloseOut = (close < rngLo)

        upCond = breakMode == "Wick" ? (upWickPierce and upCloseOut) : upCloseOut
        dnCond = breakMode == "Wick" ? (dnWickPierce and dnCloseOut) : dnCloseOut

        bigOk = breakoutBodyMult <= 1.0 ? true : (not na(baseBody0) and bodyNow >= baseBody0 * breakoutBodyMult)
        dirOkUp = requireCandleColor ? (close > open) : true
        dirOkDn = requireCandleColor ? (close < open) : true

        bullBreakLive := upCond and bigOk and dirOkUp
        bearBreakLive := dnCond and bigOk and dirOkDn

        bullBreakCommit := barstate.isconfirmed and bullBreakLive
        bearBreakCommit := barstate.isconfirmed and bearBreakLive

        if bullBreakCommit or bearBreakCommit
            if showBoxes and not na(rngBox)
                box.set_right(rngBox, bar_index)
                c = bullBreakCommit ? colorBullLV : colorBearLV
                box.set_border_color(rngBox, c)
                box.set_bgcolor(rngBox, color.new(c, boxTransparency))
                box.set_border_width(rngBox, borderWidth)

            // reset
            inSeq      := false
            qualified  := false
            startIdx   := na
            totalBars  := 0
            goodBars   := 0
            failStreak := 0
            rngHi      := na
            rngLo      := na
            baseATR    := na
            baseBody0  := na
            rngBox     := na

    if inSeq
        if na(baseATR) or na(avgTR)
            if showBoxes and not na(rngBox)
                if keepInvalidated
                    box.set_right(rngBox, bar_index)
                    box.set_border_color(rngBox, colorNeutralLV)
                    box.set_bgcolor(rngBox, color.new(colorNeutralLV, boxTransparency))
                    box.set_border_width(rngBox, borderWidth)
                else
                    box.delete(rngBox)

            // reset
            inSeq      := false
            qualified  := false
            startIdx   := na
            totalBars  := 0
            goodBars   := 0
            failStreak := 0
            rngHi      := na
            rngLo      := na
            baseATR    := na
            baseBody0  := na
            rngBox     := na
        else
            outNow = qualified and (close > rngHi or close < rngLo) and not barstate.isconfirmed

            if not outNow
                wickOutButReentered = qualified and ((high > rngHi) or (low < rngLo)) and (close <= rngHi) and (close >= rngLo)

                nextHi = wickOutButReentered ? rngHi : math.max(rngHi, high)
                nextLo = wickOutButReentered ? rngLo : math.min(rngLo, low)

                nextTotal = totalBars + 1
                nextGood  = goodBars + (isLowVol ? 1 : 0)
                nextFail  = isLowVol ? 0 : (failStreak + 1)

                nextFrac = float(nextGood) / float(nextTotal)
                nextQual = (nextTotal >= minBars) and (nextGood >= minGoodBars) and (nextFrac >= minGoodFrac)

                violates = ((nextHi - nextLo) > baseATR * heightMult) or (nextFail > gapMax)

                if violates
                    if showBoxes and not na(rngBox)
                        box.set_right(rngBox, bar_index - 1)
                        if qualified
                            if keepInvalidated
                                box.set_border_color(rngBox, colorNeutralLV)
                                box.set_bgcolor(rngBox, color.new(colorNeutralLV, boxTransparency))
                                box.set_border_width(rngBox, borderWidth)
                            else
                                box.delete(rngBox)
                        else
                            if not keepInvalidated
                                box.delete(rngBox)
                            else
                                box.set_border_color(rngBox, colorNeutralLV)
                                box.set_bgcolor(rngBox, color.new(colorNeutralLV, boxTransparency))
                                box.set_border_width(rngBox, borderWidth)

                    // reset
                    inSeq      := false
                    qualified  := false
                    startIdx   := na
                    totalBars  := 0
                    goodBars   := 0
                    failStreak := 0
                    rngHi      := na
                    rngLo      := na
                    baseATR    := na
                    baseBody0  := na
                    rngBox     := na

                    if isLowVol and not na(avgTR)
                        inSeq      := true
                        qualified  := false
                        startIdx   := bar_index
                        totalBars  := 1
                        goodBars   := 1
                        failStreak := 0
                        rngHi      := high
                        rngLo      := low
                        baseATR    := avgTR
                        baseBody0  := avgBody
                        rngBox     := na
                else
                    rngHi      := nextHi
                    rngLo      := nextLo
                    totalBars  := nextTotal
                    goodBars   := nextGood
                    failStreak := nextFail

                    if nextQual and not qualified
                        qualified := true
                        if showBoxes
                            rngBox := box.new(left=startIdx, top=rngHi, right=bar_index, bottom=rngLo, xloc=xloc.bar_index,
                                bgcolor=color.new(colorNeutralLV, boxTransparency), border_color=colorNeutralLV, border_width=borderWidth)

                    if showBoxes and qualified and not na(rngBox)
                        box.set_right(rngBox, bar_index)
                        box.set_top(rngBox, rngHi)
                        box.set_bottom(rngBox, rngLo)
                        box.set_border_width(rngBox, borderWidth)
                        box.set_border_color(rngBox, colorNeutralLV)
                        box.set_bgcolor(rngBox, color.new(colorNeutralLV, boxTransparency))

plotshape(showSignals and bullBreakLive, title="Bull Breakout", style=shape.triangleup, location=location.belowbar,
     size=size.tiny, color=colorBullLV, text="LONG", textcolor=colorBullLV)

plotshape(showSignals and bearBreakLive, title="Bear Breakout", style=shape.triangledown, location=location.abovebar,
     size=size.tiny, color=colorBearLV, text="SHORT", textcolor=colorBearLV)

plot(showLevels and qualified ? rngHi : na, title="Range High", color=color.new(colorBullLV, 60), linewidth=1)
plot(showLevels and qualified ? rngLo : na, title="Range Low",  color=color.new(colorBearLV, 60), linewidth=1)

alertcondition(bullBreakCommit, title="LVRB LONG",  message="LVRB: Bullish breakout (confirmed on close) on {{ticker}} ({{interval}}).")
alertcondition(bearBreakCommit, title="LVRB SHORT", message="LVRB: Bearish breakout (confirmed on close) on {{ticker}} ({{interval}}).")
