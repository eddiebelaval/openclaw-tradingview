//@version=6
indicator("FxShare - CC Reversal", overlay=true)

// ===== INPUTS =====
minCount = input.int(4, "Min consecutive candles", minval=2)
minBody  = input.float(20, "Min candle body (points)", step=0.1)
emaLen   = input.int(2, "EMA length")

// ===== BASIC CALCS =====
ema = ta.ema(close, emaLen)

body     = math.abs(close - open)
valid    = body >= minBody
isBull   = close > open
isBear   = close < open

// ===== COUNTERS =====
var int bullCount = 0
var int bearCount = 0

bullCount := valid and isBull ? bullCount + 1 : 0
bearCount := valid and isBear ? bearCount + 1 : 0

// ===== REVERSAL CONDITIONS =====
sellCond = bullCount[1] >= minCount and isBear and close<ema

buyCond = bearCount[1] >= minCount and isBull and close>ema

// ===== PLOTS =====
plot(ema, "EMA", color=color.gray)

plotshape(
    buyCond,
    title="BUY",
    style=shape.labelup,
    location=location.belowbar,
    text="BUY",
    size=size.small,
    color=color.new(color.green, 0),
    textcolor=color.white
)

plotshape(
    sellCond,
    title="SELL",
    style=shape.labeldown,
    location=location.abovebar,
    text="SELL",
    size=size.small,
    color=color.new(color.red, 0),
    textcolor=color.white
)
