//@version=6
indicator("52-Week High/Low + MAs + ATR Stop", overlay=true)

lookbackPeriod = 252

// --- 52-Week High/Low
highestHigh = ta.highest(high, lookbackPeriod)
highBar = ta.highestbars(high, lookbackPeriod)
percentFromHigh = ((highestHigh - close) / highestHigh) * 100

lowestLow = ta.lowest(low, lookbackPeriod)
lowBar = ta.lowestbars(low, lookbackPeriod)
percentFromLow = ((close - lowestLow) / lowestLow) * 100

if barstate.islast
    label.new(bar_index + highBar, highestHigh,
      text="52-Week High: " + str.tostring(highestHigh, format.mintick) + "\n" + str.tostring(percentFromHigh, "#.##") + "% from current price",
      style=label.style_label_down, color=color.new(color.green, 10), textcolor=color.white, size=size.normal)
    label.new(bar_index + lowBar, lowestLow,
      text="52-Week Low: " + str.tostring(lowestLow, format.mintick) + "\n" + str.tostring(percentFromLow, "#.##") + "% from current price",
      style=label.style_label_up, color=color.new(color.red, 10), textcolor=color.white, size=size.normal)

// --- EMAs + 200 SMA
ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)
sma200 = ta.sma(close, 200)

plot(ema21, color=color.yellow, linewidth=1, title="EMA 21")
plot(ema50, color=color.gray, linewidth=2, title="EMA 50")
plot(sma200, color=color.rgb(103, 58, 183), linewidth=4, title="SMA 200")

// --- ATR Stop
atrLen = input.int(14, minval=1, title="ATR Periode")
atrValue = ta.atr(atrLen)
offsetLine = close - atrValue * 1.5
plot(offsetLine, color=color.new(color.white, 50), style=plot.style_circles, linewidth=1)
