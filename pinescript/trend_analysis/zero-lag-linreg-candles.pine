//@version=5
indicator(title="LinReg Heikin-Ashi Signals", shorttitle="LR HA Sig", format=format.price, precision=4, overlay=false)

// ———————————————————— Inputs
signal_length = input.int(title="Signal Smoothing", minval=1, maxval=200, defval=11)
sma_signal    = input.bool(title="Simple MA (Signal Line)", defval=true)
linreg_length = input.int(title="Linear Regression Length", minval=1, maxval=200, defval=11)

// ———————————————————— Linear Regression Calculations
// We calculate the LinReg values for the basic OHLC
bopen  =  ta.rma(ta.rma(ta.rma(open, signal_length),signal_length),signal_length)
bhigh  = ta.rma(ta.rma(ta.rma(high, signal_length),signal_length),signal_length)
blow   =  ta.rma(ta.rma(ta.rma(low, signal_length),signal_length),signal_length)
bclose =  ta.rma(ta.rma(ta.rma(close, signal_length),signal_length),signal_length)

// ———————————————————— Heikin-Ashi Logic
// HA Close = (Open + High + Low + Close) / 4
haclose = (bopen + bhigh + blow + bclose) / 4

// HA Open = (Previous HA Open + Previous HA Close) / 2
var float haopen = na
haopen := na(haopen[1]) ? (bopen + bclose) / 2 : (haopen[1] + haclose[1]) / 2

// HA High/Low
hahigh = math.max(bhigh, math.max(haopen, haclose))
halow  = math.min(blow,  math.min(haopen, haclose))

// ———————————————————— Signal & Plotting
r = haopen < haclose
signal = ta.rma(ta.rma(ta.rma(haclose, signal_length),signal_length),signal_length)

// Plot the HA Candles
plotcandle(haopen, hahigh, halow, haclose, title="LinReg HA Candles", 
     color= r ? color.new(color.green, 0) : color.new(color.red, 0), 
     wickcolor= r ? color.green : color.red, 
     bordercolor= r ? color.green : color.red)
