//@version=5
strategy(" tikole s.p EMA Crossover & Inside Doji ", overlay=true)

// --- 1. EMA Definitions ---
ema200 = ta.ema(close, 200)
ema50  = ta.ema(close, 50)
ema20  = ta.ema(close, 20)

plot(ema200, color=color.new(#c20489, 0), title="EMA 200", linewidth=2)
plot(ema50,  color=color.blue, title="EMA 50", linewidth=2)
plot(ema20,  color=color.orange, title="EMA 20", linewidth=2)

// --- 2. Signal Conditions ---
// EMA Signals
emaBuySignal  = ta.crossover(ema20, ema50)
emaSellSignal = ta.crossunder(ema20, ema50)

// Inside Doji Logic
isDoji        = math.abs(open - close) <= (high - low) * 0.1
isInside      = high <= high[1] and low >= low[1]

// Bullish: Prev bar bearish + Inside Doji + Breakout of prev high
dojiBuySignal = (close[1] < open[1]) and isInside and isDoji and (close > high[1])

// Bearish: Prev bar bullish + Inside Doji + Breakdown of prev low
dojiSellSignal = (close[1] > open[1]) and isInside and isDoji and (close < low[1])

// --- 3. Inputs & Variables ---
tp1_mult = input.float(0.5, "TP1 Multiplier (Range x N)", minval=0.1, step=0.1)
tp2_mult = input.float(1.0, "TP2 Multiplier", minval=0.1, step=0.1)
tp3_mult = input.float(1.5, "TP3 Multiplier", minval=0.1, step=0.1)
tp4_mult = input.float(2.0, "TP4 Multiplier", minval=0.1, step=0.1)
stop_pct = input.float(3.0, "Stop Loss %", minval=0.1, step=0.1) / 100

var float tp1 = na
var float tp2 = na
var float tp3 = na
var float tp4 = na
var float sl  = na

// --- 4. Entry Logic ---
longCondition  = emaBuySignal or dojiBuySignal
shortCondition = emaSellSignal or dojiSellSignal

if (longCondition)
    float candleRange = high - low
    tp1 := close + (candleRange * tp1_mult)
    tp2 := close + (candleRange * tp2_mult)
    tp3 := close + (candleRange * tp3_mult)
    tp4 := close + (candleRange * tp4_mult)
    sl  := close * (1 - stop_pct)
    strategy.entry("Long", strategy.long)

if (shortCondition)
    float candleRange = high - low
    tp1 := close - (candleRange * tp1_mult)
    tp2 := close - (candleRange * tp2_mult)
    tp3 := close - (candleRange * tp3_mult)
    tp4 := close - (candleRange * tp4_mult)
    sl  := close * (1 + stop_pct)
    strategy.entry("Short", strategy.short)

// --- 5. Exit Logic ---
// Note: strategy.exit needs to be outside the 'if' entry block to monitor prices
if (strategy.position_size > 0)
    strategy.exit("T1", "Long", qty_percent=25, limit=tp1, stop=sl)
    strategy.exit("T2", "Long", qty_percent=33, limit=tp2, stop=sl)
    strategy.exit("T3", "Long", qty_percent=50, limit=tp3, stop=sl)
    strategy.exit("T4", "Long", limit=tp4, stop=sl)

if (strategy.position_size < 0)
    strategy.exit("T1", "Short", qty_percent=25, limit=tp1, stop=sl)
    strategy.exit("T2", "Short", qty_percent=33, limit=tp2, stop=sl)
    strategy.exit("T3", "Short", qty_percent=50, limit=tp3, stop=sl)
    strategy.exit("T4", "Short", limit=tp4, stop=sl)

// --- 6. Visual Signals ---
plotshape(emaBuySignal,  "EMA Buy",   shape.labelup,   location.belowbar, color.lime,  text="EMA BUY",  textcolor=color.black, size=size.small)
plotshape(dojiBuySignal, "Doji Buy",  shape.triangleup, location.belowbar, color.green, text="DOJI BUY", textcolor=color.white, size=size.small)
plotshape(emaSellSignal, "EMA Sell",  shape.labeldown, location.abovebar, color.red,   text="EMA SELL", textcolor=color.white, size=size.small)
plotshape(dojiSellSignal,"Doji Sell", shape.triangledown, location.abovebar, color.maroon, text="DOJI SELL", textcolor=color.white, size=size.small)
