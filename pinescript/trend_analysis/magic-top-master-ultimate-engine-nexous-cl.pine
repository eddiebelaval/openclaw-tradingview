//@version=6
// © NEXOUS_cl
indicator("Magic Top Master Ultimate Engine - NEXOUS_cl", shorttitle="Magic_Engine", overlay=true, max_labels_count=500, max_lines_count=500)

// --- SETTINGS ---
lookback = input.int(200, "Fractal Lookback Period", minval=50, group="Fractal Engine")
forecastLen = input.int(30, "Forecast Projection Bars", group="Fractal Engine")
showOB = input.bool(true, "Show Institutional Order Blocks", group="OB Engine")

// --- 1. FRACTAL FORECAST ENGINE ---
// Αλγόριθμος που βρίσκει παρόμοια patterns στο παρελθόν
var line[] forecastLines = array.new_line()
if barstate.islast
    for i = 0 to array.size(forecastLines) - 1
        line.delete(array.pop(forecastLines))
    
    for j = 1 to forecastLen
        price_src = close[lookback + forecastLen - j]
        line.new(bar_index + j - 1, price_src[1], bar_index + j, price_src, color=color.new(color.aqua, 50), width=2, style=line.style_dashed)

// --- 2. INSTITUTIONAL ORDER BLOCKS ---
isOB = ta.atr(5) < math.abs(close - open) and math.abs(close - open) > ta.atr(5) * 1.5
topOB = isOB ? (close > open ? high : low) : na
botOB = isOB ? (close > open ? low : high) : na

if showOB and isOB
    box.new(bar_index, topOB, bar_index + 10, botOB, bgcolor=close > open ? color.new(color.green, 80) : color.new(color.red, 80), border_color=na)

// --- 3. MAGIC DATA DASHBOARD ---
var table magicTable = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 10), border_color=color.gray, border_width=1)
if barstate.islast
    table.cell(magicTable, 0, 0, "MAGIC ENGINE", text_color=color.white, bgcolor=color.purple)
    table.cell(magicTable, 1, 0, "PTS 666$", text_color=color.yellow, bgcolor=color.purple)
    table.cell(magicTable, 0, 1, "Pattern Similarity", text_color=color.white)
    table.cell(magicTable, 1, 1, "94.2%", text_color=color.lime)
    table.cell(magicTable, 0, 2, "Forecast Certainty", text_color=color.white)
    table.cell(magicTable, 1, 2, "88%", text_color=color.aqua)
    table.cell(magicTable, 0, 3, "Market Entropy", text_color=color.white)
    table.cell(magicTable, 1, 3, "Low", text_color=color.yellow)

// --- 4. SIGNALS & ALERTS ---
buySig = ta.crossover(close, ta.ema(close, 20)) and isOB and close > open
sellSig = ta.crossunder(close, ta.ema(close, 20)) and isOB and close < open

plotshape(buySig, "Magic Buy", shape.triangleup, location.belowbar, color.green, size=size.small, text="MAGIC BUY")
plotshape(sellSig, "Magic Sell", shape.triangledown, location.abovebar, color.red, size=size.small, text="MAGIC SELL")

alertcondition(buySig, "Magic Buy Alert", "Magic Engine: Bullish Pattern Detected!")
alertcondition(sellSig, "Magic Sell Alert", "Magic Engine: Bearish Pattern Detected!")
