//@version=5
indicator("Aura V14", shorttitle="Aura", overlay=true)

// --- 1. ΕΙΣΟΔΟΙ (INPUTS) ---
// UT Bot & Alpha Settings
atr_p = input.int(1, "ATR Period") 
atr_m = input.float(5.0, "Multiplier")
alpha_p = input.int(14, "Alpha Period")
alpha_m = input.float(1.0, "Alpha Multiplier")

// Magic Trend (CCI) Settings
magic_p = input.int(20, "Magic Period")
magic_m = input.float(1.0, "Magic Multiplier")

// --- 2. ALPHA TREND LOGIC (Calculated) ---
[plus, minus, adx] = ta.dmi(14, 14)
at_atr = ta.sma(ta.tr, alpha_p)
alpha_up = low - (at_atr * alpha_m)
alpha_dn = high + (at_atr * alpha_m)

var float alpha_line = 0.0
alpha_line := ta.mfi(close, alpha_p) >= 50 ? (alpha_up < nz(alpha_line[1]) ? nz(alpha_line[1]) : alpha_up) : (alpha_dn > nz(alpha_line[1]) ? nz(alpha_line[1]) : alpha_dn)
at_bull = close > alpha_line

// --- 3. MAGIC TREND LOGIC (Calculated) ---
magic_cci = ta.cci(close, magic_p)
magic_bull = magic_cci > 0

// --- 4. CONSENSUS ENGINE ---
f_rsi = ta.rsi(close, 14)
f_mfi = ta.mfi(close, 14)
bull_sc = (f_rsi > 50 ? 1 : 0) + (f_mfi > 50 ? 1 : 0) + (adx > 30 ? 1 : 0) + (close > ta.ema(close, 50) ? 1 : 0)

// UT Bot Logic
atr = ta.atr(atr_p)
x_atr = atr * atr_m
var float n_loss = close 
prev_l = nz(n_loss[1], close)
if close > prev_l and close[1] > prev_l
    n_loss := math.max(prev_l, close - x_atr)
else if close < prev_l and close[1] < prev_l
    n_loss := math.min(prev_l, close + x_atr)
else if close > prev_l
    n_loss := close - x_atr
else
    n_loss := close + x_atr

// --- 5. THE AURA SIGNAL ---
vol_ok = volume > ta.sma(volume, 20)
is_bull = bull_sc >= 3 and at_bull and magic_bull and close > n_loss and vol_ok
is_bear = bull_sc <= 1 and not at_bull and not magic_bull and close < n_loss and vol_ok

var int trend = 0
if is_bull
    trend := 1
else if is_bear
    trend := -1

buy_sig  = trend == 1 and trend[1] != 1
sell_sig = trend == -1 and trend[1] != -1

// --- 6. VISUALS (MINIMALIST) ---

// Soft Aura Background (93% Transparency)
bgcolor(trend == 1 ? color.new(color.green, 93) : trend == -1 ? color.new(color.red, 93) : na)

// Precise Entry Signals
plotshape(buy_sig,  title="BUY",  style=shape.labelup,   location=location.belowbar, color=color.new(#00ffbb, 0), text="BUY",  textcolor=color.white, size=size.small)
plotshape(sell_sig, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(#ff0055, 0), text="SELL", textcolor=color.white, size=size.small)

// Bar Coloring
barcolor(trend == 1 ? color.lime : trend == -1 ? color.red : color.gray)
