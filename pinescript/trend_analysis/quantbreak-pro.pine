// ============================================================
//  QuantBreak Pro — Original Breakout Detection Indicator
//  Author: Your Name
//  Version: Pine Script v6
//  Description:
//    A fresh breakout detection system combining:
//    - Adaptive Donchian Channel Breakout
//    - Volume Surge Confirmation
//    - ATR-based momentum filter
//    - Dynamic Support/Resistance zones
//    - Buy/Sell signals with alerts
// ============================================================

//@version=6
indicator("QuantBreak Pro", overlay=true, max_labels_count=500, max_lines_count=500)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
grp1 = "🔷 Breakout Settings"
dcLen       = input.int(20,    "Donchian Length",        minval=5,  maxval=200, group=grp1)
atrLen      = input.int(14,    "ATR Length",             minval=5,  maxval=50,  group=grp1)
atrMult     = input.float(1.5, "ATR Momentum Filter",   minval=0.5, maxval=5.0, step=0.1, group=grp1)

grp2 = "📊 Volume Filter"
useVol      = input.bool(true,  "Enable Volume Filter",  group=grp2)
volLen      = input.int(20,    "Volume MA Length",       minval=5,  maxval=100, group=grp2)
volMult     = input.float(1.3, "Volume Surge Multiplier", minval=1.0, maxval=5.0, step=0.1, group=grp2)

grp3 = "🎨 Visual Settings"
showZones   = input.bool(true,  "Show S/R Zones",        group=grp3)
showLabels  = input.bool(true,  "Show Signal Labels",    group=grp3)
bullCol     = input.color(color.new(#00e676, 0),  "Bull Color", group=grp3)
bearCol     = input.color(color.new(#ff1744, 0),  "Bear Color", group=grp3)

grp4 = "🔔 Alerts"
alertOn     = input.bool(true, "Enable Alerts", group=grp4)

// ─────────────────────────────────────────────
// CORE CALCULATIONS
// ─────────────────────────────────────────────

// Donchian Channel
dcHigh  = ta.highest(high, dcLen)
dcLow   = ta.lowest(low,  dcLen)
dcMid   = math.avg(dcHigh, dcLow)

// ATR
atr     = ta.atr(atrLen)

// Volume filter
volMA   = ta.sma(volume, volLen)
volSurge = volume >= volMA * volMult

// Candle body size vs ATR (momentum filter)
bodySize    = math.abs(close - open)
strongCandle = bodySize >= atr * atrMult

// ─────────────────────────────────────────────
// BREAKOUT CONDITIONS
// ─────────────────────────────────────────────

// Bullish Breakout: close breaks ABOVE prior Donchian high
bullBreak = close > dcHigh[1] and strongCandle and (useVol ? volSurge : true)

// Bearish Breakout: close breaks BELOW prior Donchian low
bearBreak = close < dcLow[1]  and strongCandle and (useVol ? volSurge : true)

// ─────────────────────────────────────────────
// SIGNAL TRACKING (avoid repeated signals)
// ─────────────────────────────────────────────
var int  lastSignal = 0  // 1=bull, -1=bear

buySignal  = bullBreak and lastSignal != 1
sellSignal = bearBreak and lastSignal != -1

if buySignal
    lastSignal := 1
if sellSignal
    lastSignal := -1

// ─────────────────────────────────────────────
// PLOTS — Donchian Channel
// ─────────────────────────────────────────────
upperPlot = plot(dcHigh, "DC Upper", color=color.new(bullCol, 70), linewidth=1)
lowerPlot = plot(dcLow,  "DC Lower", color=color.new(bearCol, 70), linewidth=1)
midPlot   = plot(dcMid,  "DC Mid",   color=color.new(color.gray, 60), linewidth=1, style=plot.style_circles)
fill(upperPlot, lowerPlot, color=color.new(color.blue, 92), title="DC Fill")

// ─────────────────────────────────────────────
// SUPPORT / RESISTANCE ZONES
// ─────────────────────────────────────────────
var line srLine = na
var box  srBox  = na

if showZones and buySignal
    srBox := box.new(bar_index - 3, dcHigh, bar_index + 10,
         dcHigh - atr * 0.4,
         border_color=color.new(bullCol, 60),
         bgcolor=color.new(bullCol, 88))

if showZones and sellSignal
    srBox := box.new(bar_index - 3, dcLow + atr * 0.4, bar_index + 10,
         dcLow,
         border_color=color.new(bearCol, 60),
         bgcolor=color.new(bearCol, 88))

// ─────────────────────────────────────────────
// BUY / SELL LABELS
// ─────────────────────────────────────────────
if showLabels and buySignal
    label.new(bar_index, low - atr * 0.5,
         "▲ BUY\n" + str.tostring(close, "#.####"),
         style=label.style_label_up,
         color=bullCol,
         textcolor=color.white,
         size=size.normal)

if showLabels and sellSignal
    label.new(bar_index, high + atr * 0.5,
         "▼ SELL\n" + str.tostring(close, "#.####"),
         style=label.style_label_down,
         color=bearCol,
         textcolor=color.white,
         size=size.normal)

// ─────────────────────────────────────────────
// CANDLE COLORING
// ─────────────────────────────────────────────
barcolor(buySignal  ? bullCol :
         sellSignal ? bearCol : na, title="Signal Bar Color")

// ─────────────────────────────────────────────
// BACKGROUND HIGHLIGHT on signal bars
// ─────────────────────────────────────────────
bgcolor(buySignal  ? color.new(bullCol, 85) :
        sellSignal ? color.new(bearCol, 85) : na, title="Signal BG")

// ─────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────
if alertOn
    if buySignal
        alert("QuantBreak Pro — BUY Signal on " + syminfo.ticker + " @ " + str.tostring(close), alert.freq_once_per_bar)
    if sellSignal
        alert("QuantBreak Pro — SELL Signal on " + syminfo.ticker + " @ " + str.tostring(close), alert.freq_once_per_bar)

// ─────────────────────────────────────────────
// PLOTSHAPES (for Strategy Tester compat.)
// ─────────────────────────────────────────────
plotshape(buySignal,  title="Buy Signal",  location=location.belowbar,
     style=shape.triangleup,   size=size.small, color=bullCol)
plotshape(sellSignal, title="Sell Signal", location=location.abovebar,
     style=shape.triangledown, size=size.small, color=bearCol)
