//Made by @yohei ogura with <3
//Modified for MTF (Multi-Timeframe) Supertrend
//Enhanced with Advanced Features & ATH Finder
//v2: Overheating Line改修 - 前日確定ATR基準 + タッチシグナル + ステータステーブル
//v3: 週足Supertrend追加

//@version=5
indicator('MTF ATR(1H,4H,1D,1W) with ATH and Heat line', shorttitle='MTF ATR(1H,4H,1D,1W) with ATH and Heat line', overlay=true, max_lines_count=500, max_labels_count=500)

// ============================================================================
// Master Highlighter Control
// ============================================================================
masterHighlighter = input.bool(title='Master Highlighter (All Timeframes)', defval=true, group='Master Control')
masterSignals = input.bool(title='Master Signals (All Timeframes)', defval=true, group='Master Control')
masterUpTrend = input.bool(title='Master Up Trend Lines & Circles (All Timeframes)', defval=true, group='Master Control')
masterDownTrend = input.bool(title='Master Down Trend Lines & Circles (All Timeframes)', defval=true, group='Master Control')

// ============================================================================
// Timeframe Control
// ============================================================================
hideOnDailyOrAbove = input.bool(title='Hide Indicators on Daily+ (except 1D/1W ATR)', defval=true, group='Timeframe Control')

isDailyOrAbove = timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly
showOnChart = not (hideOnDailyOrAbove and isDailyOrAbove)
show1DOnChart = true
show1WOnChart = true

// ============================================================================
// ATH Finder Settings
// ============================================================================
showATH = input.bool(title='Show ATH Line', defval=true, group='ATH Finder')
showATHLabel = input.bool(title='Show ATH Label', defval=true, group='ATH Finder')
athLineColor = input.color(title='ATH Line Color', defval=color.new(color.lime, 0), group='ATH Finder')
athLineWidth = input.int(title='ATH Line Width', defval=2, minval=1, maxval=5, group='ATH Finder')

// ============================================================================
// EMA Settings
// ============================================================================
showEMAs = input.bool(title='Show EMAs (20/50/200)', defval=false, group='EMA Settings')
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)

plot(showEMAs and showOnChart ? ema20 : na, title='EMA 20', color=color.new(#e91e63, 0), linewidth=2)
plot(showEMAs and showOnChart ? ema50 : na, title='EMA 50', color=color.new(#66bb6a, 0), linewidth=2)
plot(showEMAs and showOnChart ? ema200 : na, title='EMA 200', color=color.new(#7e57c2, 0), linewidth=2)

// ============================================================================
// Overheating Line Settings (改修版)
// ============================================================================
showOverheatingLine = input.bool(title='Show Overheating Line', defval=true, group='Overheating Line v2')
overheatingMultiplier = input.float(title='Overheating Multiplier', defval=1.3, step=0.1, group='Overheating Line v2')
showOverheatingSignal = input.bool(title='Show Touch Signal', defval=false, group='Overheating Line v2')
hideSignalOnDaily = input.bool(title='Hide Signals on Daily+ (日足以上で非表示)', defval=true, group='Overheating Line v2')
hideLineOnDaily = input.bool(title='Hide Line on Daily+ (日足以上でライン非表示)', defval=true, group='Overheating Line v2')
showOverheatingTable = input.bool(title='Show Status Table', defval=true, group='Overheating Line v2')
showOldOverheatingLine = input.bool(title='Show Old Dynamic Line (比較用)', defval=false, group='Overheating Line v2')

// シグナル表示条件
showOHSignals = showOverheatingSignal and not (hideSignalOnDaily and isDailyOrAbove)
showOHLine = not (hideLineOnDaily and isDailyOrAbove)

// ============================================================================
// ATH Finder Logic
// ============================================================================
var float ath = na
var int ath_bar = na
var line ath_line = na
var label ath_label = na

if high > ath or na(ath)
    ath := high
    ath_bar := bar_index

if showATH and barstate.islast
    if not na(ath_line)
        line.delete(ath_line)
    if not na(ath_label)
        label.delete(ath_label)
    
    line_start_bar = math.max(ath_bar, bar_index - 499)
    line_end_bar = bar_index == ath_bar ? bar_index + 1 : bar_index
    ath_line := line.new(line_start_bar, ath, line_end_bar, ath, width=athLineWidth, color=athLineColor, extend=extend.right, style=line.style_solid)
    
    if showATHLabel
        is_current_ath = high == ath and bar_index == ath_bar
        label_x = is_current_ath ? bar_index : bar_index + 5
        label_y = ath + (ath * 0.01)
        label_style = is_current_ath ? label.style_label_lower_left : label.style_label_left
        label_color = is_current_ath ? color.new(color.lime, 0) : color.new(color.red, 0)
        ath_label := label.new(label_x, label_y, text='ATH: ' + str.tostring(ath, '#.##'), style=label_style, color=label_color, textcolor=color.white, size=size.small)

// ============================================================================
// Supertrend 2 (Current Timeframe)
// ============================================================================
Periods2 = input.int(title='ATR Period', defval=10, group='Supertrend (Current TF)')
src2 = input.source(hl2, title='Source', group='Supertrend (Current TF)')
Multiplier2 = input.float(title='ATR Multiplier', step=0.1, defval=1.0, group='Supertrend (Current TF)')
changeATR2 = input.bool(title='Change ATR Calculation Method ?', defval=true, group='Supertrend (Current TF)')
showsignals2 = input.bool(title='Show Buy/Sell Signals ?', defval=false, group='Supertrend (Current TF)')
highlighting2 = input.bool(title='Highlighter On/Off ?', defval=true, group='Supertrend (Current TF)')

atr22 = ta.sma(ta.tr, Periods2)
atr2_2 = changeATR2 ? ta.atr(Periods2) : atr22
up2 = src2 - Multiplier2 * atr2_2
up12 = nz(up2[1], up2)
up2 := close[1] > up12 ? math.max(up2, up12) : up2
dn2 = src2 + Multiplier2 * atr2_2
dn12 = nz(dn2[1], dn2)
dn2 := close[1] < dn12 ? math.min(dn2, dn12) : dn2
trend2 = 1
trend2 := nz(trend2[1], trend2)
trend2 := trend2 == -1 and close > dn12 ? 1 : trend2 == 1 and close < up12 ? -1 : trend2

plot(masterUpTrend and showOnChart and trend2 == 1 ? up2 : na, title='Up Trend', style=plot.style_linebr, linewidth=2, color=color.new(color.green, 0))
plot(masterDownTrend and showOnChart and trend2 == -1 ? dn2 : na, title='Down Trend', style=plot.style_linebr, linewidth=2, color=color.new(color.red, 0))

buySignal2 = trend2 == 1 and trend2[1] == -1
sellSignal2 = trend2 == -1 and trend2[1] == 1

plotshape(masterSignals and showOnChart and buySignal2 and showsignals2 ? up2 : na, title='Buy', text='BUY', location=location.absolute, style=shape.labelup, size=size.normal, color=color.new(color.green, 0), textcolor=color.new(color.white, 0))
plotshape(masterSignals and showOnChart and sellSignal2 and showsignals2 ? dn2 : na, title='Sell', text='SELL', location=location.absolute, style=shape.labeldown, size=size.normal, color=color.new(color.red, 0), textcolor=color.new(color.white, 0))

upPlot2 = plot(masterHighlighter and showOnChart and highlighting2 and trend2 == 1 ? up2 : na, title='Up Trend Fill', style=plot.style_linebr, linewidth=1, color=color.new(color.green, 0), display=display.none)
dnPlot2 = plot(masterHighlighter and showOnChart and highlighting2 and trend2 == -1 ? dn2 : na, title='Down Trend Fill', style=plot.style_linebr, linewidth=1, color=color.new(color.red, 0), display=display.none)
pricePlot2 = plot(masterHighlighter and showOnChart and highlighting2 ? close : na, title='Price Fill', style=plot.style_linebr, linewidth=1, display=display.none)
fill(pricePlot2, upPlot2, color=color.new(color.green, 90), title='Up Trend Highlighter')
fill(pricePlot2, dnPlot2, color=color.new(color.red, 90), title='Down Trend Highlighter')

// ============================================================================
// MTF Supertrend - 1 Hour
// ============================================================================
show1H = input.bool(title='Show 1H Supertrend', defval=true, group='MTF 1 Hour Supertrend')
Periods1H = input.int(title='ATR Period', defval=10, group='MTF 1 Hour Supertrend')
Multiplier1H = input.float(title='ATR Multiplier', step=0.1, defval=1.0, group='MTF 1 Hour Supertrend')
changeATR1H = input.bool(title='Change ATR Calculation Method ?', defval=true, group='MTF 1 Hour Supertrend')
showLabel1H = input.bool(title='Show Label', defval=true, group='MTF 1 Hour Supertrend')
showSignals1H = input.bool(title='Show Warning/Break Signals ?', defval=true, group='MTF 1 Hour Supertrend')
highlighting1H = input.bool(title='Highlighter On/Off ?', defval=true, group='MTF 1 Hour Supertrend')

[atr1H, hl2_1H, close1H] = request.security(syminfo.tickerid, "60", [changeATR1H ? ta.atr(Periods1H) : ta.sma(ta.tr, Periods1H), hl2, close], lookahead=barmerge.lookahead_off)

var float up1H = na
var float dn1H = na
var int trend1H = 1

up1H_calc = hl2_1H - Multiplier1H * atr1H
up1H := na(up1H[1]) ? up1H_calc : (close1H[1] > up1H[1] ? math.max(up1H_calc, up1H[1]) : up1H_calc)

dn1H_calc = hl2_1H + Multiplier1H * atr1H
dn1H := na(dn1H[1]) ? dn1H_calc : (close1H[1] < dn1H[1] ? math.min(dn1H_calc, dn1H[1]) : dn1H_calc)

trend1H := na(trend1H[1]) ? 1 : (trend1H[1] == -1 and close1H > dn1H[1] ? 1 : (trend1H[1] == 1 and close1H < up1H[1] ? -1 : trend1H[1]))

plot(masterUpTrend and showOnChart and show1H and trend1H == 1 ? up1H : na, title='1H Up Trend', style=plot.style_linebr, linewidth=3, color=color.new(#1848cc, 0))
plot(masterDownTrend and showOnChart and show1H and trend1H == -1 ? dn1H : na, title='1H Down Trend', style=plot.style_linebr, linewidth=2, color=color.new(#210ba2, 0))

trend1H_changed = trend1H != trend1H[1]
plotshape(masterUpTrend and showOnChart and show1H and trend1H_changed and trend1H == 1 ? up1H : na, title='1H UpTrend Begins', location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(#1848cc, 0))
plotshape(masterDownTrend and showOnChart and show1H and trend1H_changed and trend1H == -1 ? dn1H : na, title='1H DownTrend Begins', location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(#210ba2, 0))

var int warning1H_time = 0
var int break1H_time = 0
var int trend1H_change_time = 0

if trend1H_changed == true
    trend1H_change_time := time

timeSinceTrendChange1H = (time - trend1H_change_time) / 60000

warning1H = trend1H == 1 and close < up1H and (time - warning1H_time >= 14400000) and (timeSinceTrendChange1H <= 10 or trend1H == 1)
break1H = trend1H == -1 and close > dn1H and (time - break1H_time >= 3600000) and (timeSinceTrendChange1H <= 10 or trend1H == -1)

if warning1H == true
    warning1H_time := time

if break1H == true
    break1H_time := time

plotshape(masterSignals and showOnChart and showSignals1H and warning1H ? up1H : na, title='1H Warning', text='1hr⚠️', location=location.absolute, style=shape.labeldown, size=size.small, color=color.new(#1848cc, 0), textcolor=color.new(color.white, 0))
plotshape(masterSignals and showOnChart and showSignals1H and break1H ? dn1H : na, title='1H Break', text='1hr⚡', location=location.absolute, style=shape.labelup, size=size.small, color=color.new(#210ba2, 0), textcolor=color.new(color.white, 0))

if show1H and showOnChart and showLabel1H and bar_index % 20 == 0
    if trend1H == 1
        label.new(bar_index, up1H, text='[1H ATR]', style=label.style_none, textcolor=color.new(#1848cc, 0), size=size.tiny, yloc=yloc.price)
    else
        label.new(bar_index, dn1H, text='[1H ATR]', style=label.style_none, textcolor=color.new(#210ba2, 0), size=size.tiny, yloc=yloc.price)

upPlot1H = plot(masterHighlighter and showOnChart and show1H and highlighting1H and trend1H == 1 ? up1H : na, title='1H Up Trend Fill', style=plot.style_linebr, linewidth=1, color=color.new(#1848cc, 0), display=display.none)
dnPlot1H = plot(masterHighlighter and showOnChart and show1H and highlighting1H and trend1H == -1 ? dn1H : na, title='1H Down Trend Fill', style=plot.style_linebr, linewidth=1, color=color.new(#210ba2, 0), display=display.none)
pricePlot1H = plot(masterHighlighter and showOnChart and show1H and highlighting1H ? close : na, title='Price Fill 1H', style=plot.style_linebr, linewidth=1, display=display.none)
fill(pricePlot1H, upPlot1H, color=color.new(#1848cc, 90), title='1H Up Trend Highlighter')
fill(pricePlot1H, dnPlot1H, color=color.new(#210ba2, 90), title='1H Down Trend Highlighter')

// ============================================================================
// MTF Supertrend - 4 Hour
// ============================================================================
show4H = input.bool(title='Show 4H Supertrend', defval=true, group='MTF 4 Hour Supertrend')
Periods4H = input.int(title='ATR Period', defval=10, group='MTF 4 Hour Supertrend')
Multiplier4H = input.float(title='ATR Multiplier', step=0.1, defval=1.0, group='MTF 4 Hour Supertrend')
changeATR4H = input.bool(title='Change ATR Calculation Method ?', defval=true, group='MTF 4 Hour Supertrend')
showLabel4H = input.bool(title='Show Label', defval=true, group='MTF 4 Hour Supertrend')
showSignals4H = input.bool(title='Show Warning/Break Signals ?', defval=true, group='MTF 4 Hour Supertrend')
highlighting4H = input.bool(title='Highlighter On/Off ?', defval=true, group='MTF 4 Hour Supertrend')

[atr4H, hl2_4H, close4H] = request.security(syminfo.tickerid, "240", [changeATR4H ? ta.atr(Periods4H) : ta.sma(ta.tr, Periods4H), hl2, close], lookahead=barmerge.lookahead_off)

var float up4H = na
var float dn4H = na
var int trend4H = 1

up4H_calc = hl2_4H - Multiplier4H * atr4H
up4H := na(up4H[1]) ? up4H_calc : (close4H[1] > up4H[1] ? math.max(up4H_calc, up4H[1]) : up4H_calc)

dn4H_calc = hl2_4H + Multiplier4H * atr4H
dn4H := na(dn4H[1]) ? dn4H_calc : (close4H[1] < dn4H[1] ? math.min(dn4H_calc, dn4H[1]) : dn4H_calc)

trend4H := na(trend4H[1]) ? 1 : (trend4H[1] == -1 and close4H > dn4H[1] ? 1 : (trend4H[1] == 1 and close4H < up4H[1] ? -1 : trend4H[1]))

plot(masterUpTrend and showOnChart and show4H and trend4H == 1 ? up4H : na, title='4H Up Trend', style=plot.style_linebr, linewidth=3, color=color.new(#7b1fa2, 0))
plot(masterDownTrend and showOnChart and show4H and trend4H == -1 ? dn4H : na, title='4H Down Trend', style=plot.style_linebr, linewidth=2, color=color.new(#4e0f60, 0))

trend4H_changed = trend4H != trend4H[1]
plotshape(masterUpTrend and showOnChart and show4H and trend4H_changed and trend4H == 1 ? up4H : na, title='4H UpTrend Begins', location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(#7b1fa2, 0))
plotshape(masterDownTrend and showOnChart and show4H and trend4H_changed and trend4H == -1 ? dn4H : na, title='4H DownTrend Begins', location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(#4e0f60, 0))

var int warning4H_time = 0
var int break4H_time = 0
var int warning4H_count = 0
var int break4H_count = 0
var int trend4H_change_time = 0

if ta.change(time('D'))
    warning4H_count := 0
    break4H_count := 0

if trend4H_changed == true
    trend4H_change_time := time

timeSinceTrendChange4H = (time - trend4H_change_time) / 60000

warning4H = trend4H == 1 and close < up4H and (time - warning4H_time >= 14400000) and warning4H_count < 2 and (timeSinceTrendChange4H <= 10 or trend4H == 1)
break4H = trend4H == -1 and close > dn4H and (time - break4H_time >= 3600000) and break4H_count < 2 and (timeSinceTrendChange4H <= 10 or trend4H == -1)

if warning4H == true
    warning4H_time := time
    warning4H_count := warning4H_count + 1

if break4H == true
    break4H_time := time
    break4H_count := break4H_count + 1

plotshape(masterSignals and showOnChart and showSignals4H and warning4H ? up4H : na, title='4H Warning', text='4hr⚠️', location=location.absolute, style=shape.labeldown, size=size.normal, color=color.new(#7b1fa2, 0), textcolor=color.new(color.white, 0))
plotshape(masterSignals and showOnChart and showSignals4H and break4H ? dn4H : na, title='4H Break', text='4hr⚡', location=location.absolute, style=shape.labelup, size=size.normal, color=color.new(#4e0f60, 0), textcolor=color.new(color.white, 0))

if show4H and showOnChart and showLabel4H and bar_index % 30 == 0
    if trend4H == 1
        label.new(bar_index, up4H, text='[4H ATR]', style=label.style_none, textcolor=color.new(#7b1fa2, 0), size=size.tiny, yloc=yloc.price)
    else
        label.new(bar_index, dn4H, text='[4H ATR]', style=label.style_none, textcolor=color.new(#4e0f60, 0), size=size.tiny, yloc=yloc.price)

upPlot4H = plot(masterHighlighter and showOnChart and show4H and highlighting4H and trend4H == 1 ? up4H : na, title='4H Up Trend Fill', style=plot.style_linebr, linewidth=1, color=color.new(#7b1fa2, 0), display=display.none)
dnPlot4H = plot(masterHighlighter and showOnChart and show4H and highlighting4H and trend4H == -1 ? dn4H : na, title='4H Down Trend Fill', style=plot.style_linebr, linewidth=1, color=color.new(#4e0f60, 0), display=display.none)
pricePlot4H = plot(masterHighlighter and showOnChart and show4H and highlighting4H ? close : na, title='Price Fill 4H', style=plot.style_linebr, linewidth=1, display=display.none)
fill(pricePlot4H, upPlot4H, color=color.new(#7b1fa2, 90), title='4H Up Trend Highlighter')
fill(pricePlot4H, dnPlot4H, color=color.new(#4e0f60, 90), title='4H Down Trend Highlighter')

// ============================================================================
// MTF Supertrend - 1 Day (前日確定データ for ATR Line)
// ============================================================================
show1D = input.bool(title='Show 1D Supertrend', defval=true, group='MTF 1 Day Supertrend')
Periods1D = input.int(title='ATR Period', defval=10, group='MTF 1 Day Supertrend')
Multiplier1D = input.float(title='ATR Multiplier', step=0.1, defval=1.0, group='MTF 1 Day Supertrend')
changeATR1D = input.bool(title='Change ATR Calculation Method ?', defval=true, group='MTF 1 Day Supertrend')
showLabel1D = input.bool(title='Show Label', defval=true, group='MTF 1 Day Supertrend')
showSignals1D = input.bool(title='Show Warning/Break Signals ?', defval=true, group='MTF 1 Day Supertrend')
highlighting1D = input.bool(title='Highlighter On/Off ?', defval=true, group='MTF 1 Day Supertrend')

// 前日確定データ for ATR Line
[atr1D_prev, hl2_1D_prev, close1D_prev] = request.security(syminfo.tickerid, "D", [changeATR1D ? ta.atr(Periods1D) : ta.sma(ta.tr, Periods1D), hl2, close], lookahead=barmerge.lookahead_off)

// 当日リアルタイムデータ for Overheating Line
[atr1D_current, hl2_1D_current, close1D_current] = request.security(syminfo.tickerid, "D", [changeATR1D ? ta.atr(Periods1D) : ta.sma(ta.tr, Periods1D), hl2, close], lookahead=barmerge.lookahead_on)

var float up1D = na
var float dn1D = na
var int trend1D = 1

up1D_calc = hl2_1D_prev - Multiplier1D * atr1D_prev
up1D := na(up1D[1]) ? up1D_calc : (close1D_prev[1] > up1D[1] ? math.max(up1D_calc, up1D[1]) : up1D_calc)

dn1D_calc = hl2_1D_prev + Multiplier1D * atr1D_prev
dn1D := na(dn1D[1]) ? dn1D_calc : (close1D_prev[1] < dn1D[1] ? math.min(dn1D_calc, dn1D[1]) : dn1D_calc)

trend1D := na(trend1D[1]) ? 1 : (trend1D[1] == -1 and close1D_prev > dn1D[1] ? 1 : (trend1D[1] == 1 and close1D_prev < up1D[1] ? -1 : trend1D[1]))

plot(masterUpTrend and show1DOnChart and show1D and trend1D == 1 ? up1D : na, title='1D Up Trend', style=plot.style_linebr, linewidth=3, color=color.new(#4caf50, 0))
plot(masterDownTrend and show1DOnChart and show1D and trend1D == -1 ? dn1D : na, title='1D Down Trend', style=plot.style_linebr, linewidth=2, color=color.new(#8c101a, 0))

// ============================================================================
// 改修版 Overheating Line
// ============================================================================
var float up1D_current = na
var float dn1D_current = na
var int trend1D_current = 1

up1D_current_calc = hl2_1D_current - Multiplier1D * atr1D_current
up1D_current := na(up1D_current[1]) ? up1D_current_calc : (close1D_current[1] > up1D_current[1] ? math.max(up1D_current_calc, up1D_current[1]) : up1D_current_calc)

dn1D_current_calc = hl2_1D_current + Multiplier1D * atr1D_current
dn1D_current := na(dn1D_current[1]) ? dn1D_current_calc : (close1D_current[1] < dn1D_current[1] ? math.min(dn1D_current_calc, dn1D_current[1]) : dn1D_current_calc)

trend1D_current := na(trend1D_current[1]) ? 1 : (trend1D_current[1] == -1 and close1D_current > dn1D_current[1] ? 1 : (trend1D_current[1] == 1 and close1D_current < up1D_current[1] ? -1 : trend1D_current[1]))

// ★★★ 改修版過熱ライン ★★★
overheatingLine_v2 = up1D_current + (atr1D_prev * overheatingMultiplier)

// 旧版（比較用）
overheatingLine_old = up1D_current + (atr1D_current * overheatingMultiplier)

plot(showOverheatingLine and showOHLine and show1DOnChart and show1D and trend1D_current == 1 ? overheatingLine_v2 : na, title='過熱ライン v2 (Fixed ATR)', style=plot.style_linebr, linewidth=3, color=color.new(#ff9800, 0))
plot(showOldOverheatingLine and showOHLine and show1DOnChart and show1D and trend1D_current == 1 ? overheatingLine_old : na, title='過熱ライン OLD (Dynamic)', style=plot.style_linebr, linewidth=1, color=color.new(#ff9800, 60))

if showOverheatingLine and showOHLine and show1D and show1DOnChart and showLabel1D and bar_index % 40 == 0 and trend1D_current == 1
    label.new(bar_index, overheatingLine_v2, text='[過熱]', style=label.style_none, textcolor=color.new(#ff9800, 0), size=size.tiny, yloc=yloc.price)

// ============================================================================
// 過熱ライン タッチシグナル & ステータス管理
// ============================================================================
var bool oh_touched_today = false
var int oh_touch_bar = 0
var float oh_touch_price = na
var float oh_high_after_touch = na
var float oh_low_after_touch = na
var bool oh_below_line = false

if ta.change(time('D'))
    oh_touched_today := false
    oh_touch_bar := 0
    oh_touch_price := na
    oh_high_after_touch := na
    oh_low_after_touch := na
    oh_below_line := false

oh_touch_now = high >= overheatingLine_v2 and trend1D_current == 1 and not oh_touched_today

if oh_touch_now
    oh_touched_today := true
    oh_touch_bar := bar_index
    oh_touch_price := high
    oh_high_after_touch := high
    oh_low_after_touch := low

if oh_touched_today and bar_index > oh_touch_bar
    oh_high_after_touch := math.max(nz(oh_high_after_touch, high), high)
    oh_low_after_touch := math.min(nz(oh_low_after_touch, low), low)
    if close < overheatingLine_v2
        oh_below_line := true

plotshape(showOHSignals and oh_touch_now ? high : na, title='過熱タッチ', text='🔥', location=location.absolute, style=shape.labeldown, size=size.small, color=color.new(#ff9800, 0), textcolor=color.new(color.white, 0))

var bool oh_break_signaled = false
if ta.change(time('D'))
    oh_break_signaled := false

oh_break_now = oh_touched_today and not oh_break_signaled and close < overheatingLine_v2 and bar_index > oh_touch_bar
if oh_break_now
    oh_break_signaled := true

plotshape(showOHSignals and oh_break_now ? close : na, title='過熱割れ', text='❄️', location=location.absolute, style=shape.labelup, size=size.small, color=color.new(#2196f3, 0), textcolor=color.new(color.white, 0))

// ============================================================================
// 過熱ステータステーブル
// ============================================================================
if showOverheatingTable and showOHLine and barstate.islast and trend1D_current == 1
    var table ohTable = table.new(position.top_right, 2, 10, bgcolor=color.new(#1e1e1e, 10), border_width=1, border_color=color.new(#555555, 0))
    
    currentDeviation = close - up1D_current
    deviationRatio = atr1D_prev > 0 ? currentDeviation / atr1D_prev : 0
    
    distToOH = overheatingLine_v2 - close
    distToOH_pct = close > 0 ? (distToOH / close) * 100 : 0
    
    minutesSinceTouch = oh_touched_today ? (bar_index - oh_touch_bar) * (timeframe.isseconds ? timeframe.multiplier / 60 : timeframe.isminutes ? timeframe.multiplier : timeframe.multiplier * 60) : 0
    
    dropFromTouch = oh_touched_today and not na(oh_touch_price) ? oh_touch_price - low : 0
    dropFromTouch_pct = oh_touched_today and not na(oh_touch_price) and oh_touch_price > 0 ? (dropFromTouch / oh_touch_price) * 100 : 0
    
    table.cell(ohTable, 0, 0, '過熱ステータス', text_color=color.new(#ff9800, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(ohTable, 1, 0, '', text_size=size.small)
    
    deviationColor = deviationRatio >= overheatingMultiplier ? color.red : deviationRatio >= overheatingMultiplier * 0.8 ? color.orange : color.green
    table.cell(ohTable, 0, 1, 'ST乖離倍率', text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
    table.cell(ohTable, 1, 1, str.tostring(deviationRatio, '#.##') + 'x', text_color=deviationColor, text_size=size.tiny, text_halign=text.align_right)
    
    distColor = distToOH <= 0 ? color.red : color.white
    distText = distToOH <= 0 ? '突破中' : str.tostring(distToOH, '#') + ' (' + str.tostring(distToOH_pct, '#.##') + '%)'
    table.cell(ohTable, 0, 2, '過熱ラインまで', text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
    table.cell(ohTable, 1, 2, distText, text_color=distColor, text_size=size.tiny, text_halign=text.align_right)
    
    table.cell(ohTable, 0, 3, '過熱ライン', text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
    table.cell(ohTable, 1, 3, str.tostring(overheatingLine_v2, '#'), text_color=color.new(#ff9800, 0), text_size=size.tiny, text_halign=text.align_right)
    
    table.cell(ohTable, 0, 4, '基準ATR(前日)', text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
    table.cell(ohTable, 1, 4, str.tostring(atr1D_prev, '#'), text_color=color.white, text_size=size.tiny, text_halign=text.align_right)
    
    table.cell(ohTable, 0, 5, '当日ST', text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
    table.cell(ohTable, 1, 5, str.tostring(up1D_current, '#'), text_color=color.new(#4caf50, 0), text_size=size.tiny, text_halign=text.align_right)
    
    touchStatus = oh_touched_today ? '✅ タッチ済' : '⏳ 未タッチ'
    touchColor = oh_touched_today ? color.new(#ff9800, 0) : color.gray
    table.cell(ohTable, 0, 6, '本日タッチ', text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
    table.cell(ohTable, 1, 6, touchStatus, text_color=touchColor, text_size=size.tiny, text_halign=text.align_right)
    
    if oh_touched_today
        table.cell(ohTable, 0, 7, 'タッチ後経過', text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
        table.cell(ohTable, 1, 7, str.tostring(minutesSinceTouch, '#') + '分', text_color=color.white, text_size=size.tiny, text_halign=text.align_right)
        
        dropColor = dropFromTouch_pct >= 2.0 ? color.red : dropFromTouch_pct >= 1.0 ? color.orange : color.white
        table.cell(ohTable, 0, 8, 'タッチ後最大下落', text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
        table.cell(ohTable, 1, 8, str.tostring(dropFromTouch, '#') + ' (-' + str.tostring(dropFromTouch_pct, '#.##') + '%)', text_color=dropColor, text_size=size.tiny, text_halign=text.align_right)
        
        breakStatus = oh_below_line ? '⬇️ 割れ済' : '⬆️ 過熱ライン上'
        breakColor = oh_below_line ? color.new(#2196f3, 0) : color.new(#ff9800, 0)
        table.cell(ohTable, 0, 9, 'ライン割れ', text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
        table.cell(ohTable, 1, 9, breakStatus, text_color=breakColor, text_size=size.tiny, text_halign=text.align_right)

// ============================================================================
// 1D Trend Change Markers and Signals
// ============================================================================
trend1D_changed = trend1D != trend1D[1]
plotshape(masterUpTrend and show1DOnChart and show1D and trend1D_changed and trend1D == 1 ? up1D : na, title='1D UpTrend Begins', location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(#4caf50, 0))
plotshape(masterDownTrend and show1DOnChart and show1D and trend1D_changed and trend1D == -1 ? dn1D : na, title='1D DownTrend Begins', location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(#8c101a, 0))

var int warning1D_time = 0
var int break1D_time = 0
var int warning1D_count = 0
var int break1D_count = 0
var int trend1D_change_time = 0

if ta.change(time('D'))
    warning1D_count := 0
    break1D_count := 0

if trend1D_changed == true
    trend1D_change_time := time

timeSinceTrendChange1D = (time - trend1D_change_time) / 60000

warning1D = trend1D == 1 and close < up1D and (time - warning1D_time >= 14400000) and warning1D_count < 2 and (timeSinceTrendChange1D <= 10 or trend1D == 1)
break1D = trend1D == -1 and close > dn1D and (time - break1D_time >= 3600000) and break1D_count < 2 and (timeSinceTrendChange1D <= 10 or trend1D == -1)

if warning1D == true
    warning1D_time := time
    warning1D_count := warning1D_count + 1

if break1D == true
    break1D_time := time
    break1D_count := break1D_count + 1

plotshape(masterSignals and show1DOnChart and showSignals1D and warning1D ? up1D : na, title='1D Warning', text='1d⚠️', location=location.absolute, style=shape.labeldown, size=size.normal, color=color.new(#4caf50, 0), textcolor=color.new(color.white, 0))
plotshape(masterSignals and show1DOnChart and showSignals1D and break1D ? dn1D : na, title='1D Break', text='1d⚡', location=location.absolute, style=shape.labelup, size=size.normal, color=color.new(#8c101a, 0), textcolor=color.new(color.white, 0))

if show1D and show1DOnChart and showLabel1D and bar_index % 40 == 0
    if trend1D == 1
        label.new(bar_index, up1D, text='[1D ATR]', style=label.style_none, textcolor=color.new(#4caf50, 0), size=size.tiny, yloc=yloc.price)
    else
        label.new(bar_index, dn1D, text='[1D ATR]', style=label.style_none, textcolor=color.new(#8c101a, 0), size=size.tiny, yloc=yloc.price)

upPlot1D = plot(masterHighlighter and show1DOnChart and show1D and highlighting1D and trend1D == 1 ? up1D : na, title='1D Up Trend Fill', style=plot.style_linebr, linewidth=1, color=color.new(#4caf50, 0), display=display.none)
dnPlot1D = plot(masterHighlighter and show1DOnChart and show1D and highlighting1D and trend1D == -1 ? dn1D : na, title='1D Down Trend Fill', style=plot.style_linebr, linewidth=1, color=color.new(#8c101a, 0), display=display.none)
pricePlot1D = plot(masterHighlighter and show1DOnChart and show1D and highlighting1D ? close : na, title='Price Fill 1D', style=plot.style_linebr, linewidth=1, display=display.none)
fill(pricePlot1D, upPlot1D, color=color.new(#4caf50, 90), title='1D Up Trend Highlighter')
fill(pricePlot1D, dnPlot1D, color=color.new(#8c101a, 90), title='1D Down Trend Highlighter')

// ============================================================================
// MTF Supertrend - 1 Week (前週確定データ基準)
// ============================================================================
show1W = input.bool(title='Show 1W Supertrend', defval=true, group='MTF 1 Week Supertrend')
Periods1W = input.int(title='ATR Period', defval=10, group='MTF 1 Week Supertrend')
Multiplier1W = input.float(title='ATR Multiplier', step=0.1, defval=1.0, group='MTF 1 Week Supertrend')
changeATR1W = input.bool(title='Change ATR Calculation Method ?', defval=true, group='MTF 1 Week Supertrend')
showLabel1W = input.bool(title='Show Label', defval=true, group='MTF 1 Week Supertrend')
showSignals1W = input.bool(title='Show Warning/Break Signals ?', defval=true, group='MTF 1 Week Supertrend')
highlighting1W = input.bool(title='Highlighter On/Off ?', defval=true, group='MTF 1 Week Supertrend')

// 前週確定データ (lookahead_off = 前週の確定値が週中ずっと使われる)
[atr1W_prev, hl2_1W_prev, close1W_prev] = request.security(syminfo.tickerid, "W", [changeATR1W ? ta.atr(Periods1W) : ta.sma(ta.tr, Periods1W), hl2, close], lookahead=barmerge.lookahead_off)

var float up1W = na
var float dn1W = na
var int trend1W = 1

up1W_calc = hl2_1W_prev - Multiplier1W * atr1W_prev
up1W := na(up1W[1]) ? up1W_calc : (close1W_prev[1] > up1W[1] ? math.max(up1W_calc, up1W[1]) : up1W_calc)

dn1W_calc = hl2_1W_prev + Multiplier1W * atr1W_prev
dn1W := na(dn1W[1]) ? dn1W_calc : (close1W_prev[1] < dn1W[1] ? math.min(dn1W_calc, dn1W[1]) : dn1W_calc)

trend1W := na(trend1W[1]) ? 1 : (trend1W[1] == -1 and close1W_prev > dn1W[1] ? 1 : (trend1W[1] == 1 and close1W_prev < up1W[1] ? -1 : trend1W[1]))

// --- Plot 1W Supertrend ---
// Up Trend: ピンク (#f06292)
// Down Trend: ダークピンク (#c2185b)
plot(masterUpTrend and show1WOnChart and show1W and trend1W == 1 ? up1W : na, title='1W Up Trend', style=plot.style_linebr, linewidth=3, color=color.new(#f06292, 0))
plot(masterDownTrend and show1WOnChart and show1W and trend1W == -1 ? dn1W : na, title='1W Down Trend', style=plot.style_linebr, linewidth=2, color=color.new(#c2185b, 0))

// --- Trend Change Circles ---
trend1W_changed = trend1W != trend1W[1]
plotshape(masterUpTrend and show1WOnChart and show1W and trend1W_changed and trend1W == 1 ? up1W : na, title='1W UpTrend Begins', location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(#f06292, 0))
plotshape(masterDownTrend and show1WOnChart and show1W and trend1W_changed and trend1W == -1 ? dn1W : na, title='1W DownTrend Begins', location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(#c2185b, 0))

// --- Warning/Break Signals ---
var int warning1W_time = 0
var int break1W_time = 0
var int warning1W_count = 0
var int break1W_count = 0
var int trend1W_change_time = 0

if ta.change(time('W'))
    warning1W_count := 0
    break1W_count := 0

if trend1W_changed == true
    trend1W_change_time := time

timeSinceTrendChange1W = (time - trend1W_change_time) / 60000

warning1W = trend1W == 1 and close < up1W and (time - warning1W_time >= 345600000) and warning1W_count < 2 and (timeSinceTrendChange1W <= 10 or trend1W == 1)
break1W = trend1W == -1 and close > dn1W and (time - break1W_time >= 345600000) and break1W_count < 2 and (timeSinceTrendChange1W <= 10 or trend1W == -1)

if warning1W == true
    warning1W_time := time
    warning1W_count := warning1W_count + 1

if break1W == true
    break1W_time := time
    break1W_count := break1W_count + 1

plotshape(masterSignals and show1WOnChart and showSignals1W and warning1W ? up1W : na, title='1W Warning', text='1w⚠️', location=location.absolute, style=shape.labeldown, size=size.normal, color=color.new(#f06292, 0), textcolor=color.new(color.white, 0))
plotshape(masterSignals and show1WOnChart and showSignals1W and break1W ? dn1W : na, title='1W Break', text='1w⚡', location=location.absolute, style=shape.labelup, size=size.normal, color=color.new(#c2185b, 0), textcolor=color.new(color.white, 0))

// --- Label ---
if show1W and show1WOnChart and showLabel1W and bar_index % 50 == 0
    if trend1W == 1
        label.new(bar_index, up1W, text='[1W ATR]', style=label.style_none, textcolor=color.new(#f06292, 0), size=size.tiny, yloc=yloc.price)
    else
        label.new(bar_index, dn1W, text='[1W ATR]', style=label.style_none, textcolor=color.new(#c2185b, 0), size=size.tiny, yloc=yloc.price)

// --- Highlighter ---
upPlot1W = plot(masterHighlighter and show1WOnChart and show1W and highlighting1W and trend1W == 1 ? up1W : na, title='1W Up Trend Fill', style=plot.style_linebr, linewidth=1, color=color.new(#f06292, 0), display=display.none)
dnPlot1W = plot(masterHighlighter and show1WOnChart and show1W and highlighting1W and trend1W == -1 ? dn1W : na, title='1W Down Trend Fill', style=plot.style_linebr, linewidth=1, color=color.new(#c2185b, 0), display=display.none)
pricePlot1W = plot(masterHighlighter and show1WOnChart and show1W and highlighting1W ? close : na, title='Price Fill 1W', style=plot.style_linebr, linewidth=1, display=display.none)
fill(pricePlot1W, upPlot1W, color=color.new(#f06292, 90), title='1W Up Trend Highlighter')
fill(pricePlot1W, dnPlot1W, color=color.new(#c2185b, 90), title='1W Down Trend Highlighter')

// ============================================================================
// Alerts
// ============================================================================
alertcondition(buySignal2, 'Buy Alert', 'Buy Signal!')
alertcondition(sellSignal2, 'Sell Alert', 'Sell Signal!')
alertcondition(warning1H, '1H Warning Alert', '1H ATR Break Down!')
alertcondition(break1H, '1H Break Alert', '1H ATR Break Up!')
alertcondition(warning4H, '4H Warning Alert', '4H ATR Break Down!')
alertcondition(break4H, '4H Break Alert', '4H ATR Break Up!')
alertcondition(warning1D, '1D Warning Alert', '1D ATR Break Down!')
alertcondition(break1D, '1D Break Alert', '1D ATR Break Up!')
alertcondition(oh_touch_now, '過熱タッチ Alert', '過熱ラインにタッチ!')
alertcondition(oh_break_now, '過熱割れ Alert', '過熱ライン割れ!')
alertcondition(trend1W_changed and trend1W == 1, '1W UpTrend Alert', '1W ATR Trend turned UP!')
alertcondition(trend1W_changed and trend1W == -1, '1W DownTrend Alert', '1W ATR Trend turned DOWN!')
alertcondition(warning1W, '1W Warning Alert', '1W ATR Break Down!')
alertcondition(break1W, '1W Break Alert', '1W ATR Break Up!')
