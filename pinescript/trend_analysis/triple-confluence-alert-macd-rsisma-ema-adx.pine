//@version=5
indicator("Triple Confluence Alert (MACD + RSI/SMA + EMA + ADX)", overlay=true, max_bars_back=500)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────

// MACD
macd_fast     = input.int(12, "MACD Fast Length",   group="MACD")
macd_slow     = input.int(26, "MACD Slow Length",   group="MACD")
macd_signal   = input.int(9,  "MACD Signal Length", group="MACD")

// RSI + SMA smoothing
rsi_length    = input.int(14, "RSI Length",   group="RSI")
rsi_sma_len   = input.int(14, "RSI SMA Length", group="RSI")

// EMA Mode
ema_mode      = input.string("Triple", "EMA Mode", options=["Dual", "Triple"], group="EMA",
     tooltip="Dual: fast/slow crossover. Triple: all three EMAs must be stacked in order (fast > mid > slow for bull, fast < mid < slow for bear) — no crossover needed, pure alignment.")
ema_fast_len  = input.int(9,   "EMA Fast Length",   group="EMA")
ema_mid_len   = input.int(21,  "EMA Mid Length",    group="EMA",
     tooltip="Only used in Triple EMA mode.")
ema_slow_len  = input.int(50,  "EMA Slow Length",   group="EMA")

// ADX Filter
adx_length    = input.int(14,   "ADX Length",          group="ADX Filter")
adx_threshold = input.float(20, "ADX Threshold",       group="ADX Filter", minval=1, maxval=100, step=1)
adx_enabled   = input.bool(true, "Enable ADX Filter",  group="ADX Filter")

// Confluence window
lookback      = input.int(5, "Confluence Window (bars)", minval=1, maxval=20, group="Alert Settings",
     tooltip="For MACD and RSI, how many bars back to look for a recent crossover. EMA alignment is checked on the current bar only.")

// ─────────────────────────────────────────────
// CALCULATIONS
// ─────────────────────────────────────────────

// MACD
[macdLine, signalLine, _] = ta.macd(close, macd_fast, macd_slow, macd_signal)
macd_bull_cross = ta.crossover(macdLine, signalLine)
macd_bear_cross = ta.crossunder(macdLine, signalLine)

// RSI + its SMA
rsiVal         = ta.rsi(close, rsi_length)
rsiSMA         = ta.sma(rsiVal, rsi_sma_len)
rsi_bull_cross = ta.crossover(rsiVal, rsiSMA)
rsi_bear_cross = ta.crossunder(rsiVal, rsiSMA)

// EMA
ema_fast = ta.ema(close, ema_fast_len)
ema_mid  = ta.ema(close, ema_mid_len)
ema_slow = ta.ema(close, ema_slow_len)

// Dual mode: classic crossover
ema_dual_bull = ta.crossover(ema_fast, ema_slow)
ema_dual_bear = ta.crossunder(ema_fast, ema_slow)

// Triple mode: pure stack alignment on current bar
ema_triple_bull = ema_fast > ema_mid and ema_mid > ema_slow   // bullish stack
ema_triple_bear = ema_fast < ema_mid and ema_mid < ema_slow   // bearish stack

// ADX
[_, _, adxVal] = ta.dmi(adx_length, adx_length)
adx_pass = not adx_enabled or (adxVal > adx_threshold)

// Plot EMAs
plot(ema_fast, color=color.new(color.orange, 0), linewidth=1, title="EMA Fast")
plot(ema_mid,  color=color.new(color.yellow, 0), linewidth=1, title="EMA Mid  (Triple mode)")
plot(ema_slow, color=color.new(color.blue,   0), linewidth=1, title="EMA Slow")

// ─────────────────────────────────────────────
// CONFLUENCE DETECTION
// ─────────────────────────────────────────────

f_recent(cond, n) =>
    found = false
    for i = 0 to n
        if cond[i]
            found := true
    found

macd_bull_recent = f_recent(macd_bull_cross, lookback)
macd_bear_recent = f_recent(macd_bear_cross, lookback)
rsi_bull_recent  = f_recent(rsi_bull_cross,  lookback)
rsi_bear_recent  = f_recent(rsi_bear_cross,  lookback)

// EMA condition depends on mode
// Dual uses recent crossover; Triple uses live stack alignment
ema_bull_ok = ema_mode == "Dual" ? f_recent(ema_dual_bull, lookback) : ema_triple_bull
ema_bear_ok = ema_mode == "Dual" ? f_recent(ema_dual_bear, lookback) : ema_triple_bear

bull_confluence = macd_bull_recent and rsi_bull_recent and ema_bull_ok and adx_pass
bear_confluence = macd_bear_recent and rsi_bear_recent and ema_bear_ok and adx_pass

// Edge detection — fire once per confluence event
bull_trigger = bull_confluence and not bull_confluence[1]
bear_trigger = bear_confluence and not bear_confluence[1]

// ─────────────────────────────────────────────
// VISUALS
// ─────────────────────────────────────────────

plotshape(bull_trigger, title="Bullish Confluence",
     location=location.belowbar, style=shape.triangleup,
     color=color.new(color.lime, 0), size=size.normal, text="▲ 3x Bull")

plotshape(bear_trigger, title="Bearish Confluence",
     location=location.abovebar, style=shape.triangledown,
     color=color.new(color.red, 0), size=size.normal, text="▼ 3x Bear")

bgcolor(bull_confluence ? color.new(color.lime, 88) : na, title="Bull Confluence Zone")
bgcolor(bear_confluence ? color.new(color.red,  88) : na, title="Bear Confluence Zone")

// ─────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────

alertcondition(bull_trigger, title="🟢 Bullish Triple Confluence",
     message="BULLISH confluence on {{ticker}} ({{interval}}): MACD + RSI/SMA + EMA all bullish, ADX filter passed.")

alertcondition(bear_trigger, title="🔴 Bearish Triple Confluence",
     message="BEARISH confluence on {{ticker}} ({{interval}}): MACD + RSI/SMA + EMA all bearish, ADX filter passed.")

// ─────────────────────────────────────────────
// DEBUG TABLE
// ─────────────────────────────────────────────

show_debug = input.bool(true, "Show Signal Status Table", group="Debug")

if show_debug
    var table t = table.new(position.top_right, 2, 5,
         border_width=1, border_color=color.gray,
         bgcolor=color.new(color.black, 60))
    table.cell(t, 0, 0, "Signal",        text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, "Status",        text_color=color.white, text_size=size.small)
    table.cell(t, 0, 1, "MACD Cross",    text_color=color.white, text_size=size.small)
    table.cell(t, 0, 2, "RSI/SMA Cross", text_color=color.white, text_size=size.small)
    ema_label = ema_mode == "Triple" ? "EMA Stack" : "EMA Cross"
    table.cell(t, 0, 3, ema_label,       text_color=color.white, text_size=size.small)
    table.cell(t, 0, 4, "ADX Filter",    text_color=color.white, text_size=size.small)

    macd_ok = macd_bull_recent or macd_bear_recent
    rsi_ok  = rsi_bull_recent  or rsi_bear_recent
    ema_ok  = ema_bull_ok      or ema_bear_ok

    table.cell(t, 1, 1, macd_ok ? "✅" : "❌", text_color=macd_ok ? color.lime : color.red, text_size=size.small)
    table.cell(t, 1, 2, rsi_ok  ? "✅" : "❌", text_color=rsi_ok  ? color.lime : color.red, text_size=size.small)
    table.cell(t, 1, 3, ema_ok  ? "✅" : "❌", text_color=ema_ok  ? color.lime : color.red, text_size=size.small)
    adx_label = adx_enabled ? (adx_pass ? "✅ " + str.tostring(math.round(adxVal, 1)) : "❌ " + str.tostring(math.round(adxVal, 1))) : "OFF"
    adx_color = adx_enabled ? (adx_pass ? color.lime : color.red) : color.gray
    table.cell(t, 1, 4, adx_label, text_color=adx_color, text_size=size.small)
