//@version=6
indicator("AlphaX Market Pulse – MTF Market Structure & Confluence Dashboard", shorttitle="AlphaX Pulse", overlay=true,
  max_labels_count=500, max_lines_count=500, max_bars_back=500)

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ INPUTS ═══════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

// ── Timeframe Selection ────────────────────────────────────────────────────────
tf1 = input.timeframe("1",   "Timeframe 1", group="Timeframes")
tf2 = input.timeframe("5",   "Timeframe 2", group="Timeframes")
tf3 = input.timeframe("15",  "Timeframe 3", group="Timeframes")
tf4 = input.timeframe("60",  "Timeframe 4", group="Timeframes")
tf5 = input.timeframe("240", "Timeframe 5", group="Timeframes")

// ── Trend Engine ───────────────────────────────────────────────────────────────
emaFastLen  = input.int(8,   "Fast EMA",   minval=3,  maxval=30,  group="Trend Engine")
emaMedLen   = input.int(21,  "Medium EMA", minval=10, maxval=50,  group="Trend Engine")
emaSlowLen  = input.int(55,  "Slow EMA",   minval=30, maxval=100, group="Trend Engine")
emaAncLen   = input.int(200, "Anchor EMA", minval=100,maxval=500, group="Trend Engine")

// ── Momentum Engine ────────────────────────────────────────────────────────────
rsiLen      = input.int(14,  "RSI Period",         minval=5,  maxval=21, group="Momentum Engine")
rsiOB       = input.float(60,"RSI Bull Threshold", minval=50, maxval=75, step=1, group="Momentum Engine")
rsiOS       = input.float(40,"RSI Bear Threshold", minval=25, maxval=50, step=1, group="Momentum Engine")
stochLen    = input.int(14,  "Stoch Period",       minval=5,  maxval=21, group="Momentum Engine")
stochSmooth = input.int(3,   "Stoch Smooth",       minval=1,  maxval=5,  group="Momentum Engine")

// ── Volatility Engine ──────────────────────────────────────────────────────────
atrLen  = input.int(14,   "ATR Period", minval=5,  maxval=30,  group="Volatility")
bbLen   = input.int(20,   "BB Period",  minval=10, maxval=50,  group="Volatility")
bbMult  = input.float(2.0,"BB StdDev", minval=1.0,maxval=3.0, step=0.1, group="Volatility")

// ── Volume Engine ──────────────────────────────────────────────────────────────
volSMALen = input.int(20, "Volume SMA Period", minval=5, maxval=50, group="Volume")

// ── Chart Overlay ─────────────────────────────────────────────────────────────
showBiasCloud = input.bool(true, "Show Bias Cloud on Chart", group="Chart Overlay")
showEMAs      = input.bool(true, "Show EMAs on Chart",       group="Chart Overlay")

// ── Dashboard ──────────────────────────────────────────────────────────────────
showDash = input.bool(true, "Show Dashboard",                  group="Dashboard")
dashPos  = input.string("Top Right", "Position",
  options=["Top Left","Top Right","Bottom Left","Bottom Right"], group="Dashboard")
dashSize = input.string("Small", "Text Size",
  options=["Tiny","Small","Normal"],                             group="Dashboard")

// ── Colors ─────────────────────────────────────────────────────────────────────
colBullPrimary  = input.color(#c8e624, "Bull Primary",         group="Colors")
colBullBright   = input.color(#d4f03a, "Bull Bright",          group="Colors")
colBullDim      = input.color(#9ab81c, "Bull Dim",             group="Colors")
colBearPrimary  = input.color(#ff1744, "Bear Primary",         group="Colors")
colBearBright   = input.color(#ff5252, "Bear Bright",          group="Colors")
colBearDim      = input.color(#d50032, "Bear Dim",             group="Colors")
colNeutral      = input.color(#555555, "Neutral",              group="Colors")
colNeutralLight = input.color(#888888, "Neutral Light",        group="Colors")
colTextLight    = input.color(#cccccc, "Text Light",           group="Colors")
colDashBg       = input.color(#1a1a1a, "Dashboard Background", group="Colors")

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ HELPERS ══════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

f_size(s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal

f_pos(p) =>
    switch p
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right

dashTextSize = f_size(dashSize)

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ CORE ANALYSIS FUNCTION ═══════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

f_analyze(htfClose, htfHigh, htfLow, htfVol) =>

    // — Trend —
    ef = ta.ema(htfClose, emaFastLen)
    em = ta.ema(htfClose, emaMedLen)
    es = ta.ema(htfClose, emaSlowLen)
    ea = ta.ema(htfClose, emaAncLen)

    bullRibbon  = ef > em and em > es
    bearRibbon  = ef < em and em < es
    aboveAnc    = htfClose > ea
    belowAnc    = htfClose < ea
    slopeUp     = ef > ef[1] and em > em[1]
    slopeDown   = ef < ef[1] and em < em[1]
    priceAboveF = htfClose > ef
    priceBelowF = htfClose < ef

    int trendScore = 0
    trendScore += bullRibbon  ? 2 : bearRibbon  ? -2 : 0
    trendScore += aboveAnc    ? 1 : belowAnc    ? -1 : 0
    trendScore += slopeUp     ? 1 : slopeDown   ? -1 : 0
    trendScore += priceAboveF ? 1 : priceBelowF ? -1 : 0

    // — Momentum —
    rsi    = ta.rsi(htfClose, rsiLen)
    stK    = ta.stoch(htfClose, htfHigh, htfLow, stochLen)
    stD    = ta.sma(stK, stochSmooth)
    stCrUp = ta.crossover(stK, stD)
    stCrDn = ta.crossunder(stK, stD)
    macdL  = ta.ema(htfClose, 12) - ta.ema(htfClose, 26)
    macdS  = ta.ema(macdL, 9)

    int momScore = 0
    momScore += rsi > rsiOB   ? 2 : rsi < rsiOS   ? -2 : 0
    momScore += stK > 55      ? 1 : stK < 45      ? -1 : 0
    momScore += stCrUp        ? 1 : stCrDn        ? -1 : 0
    momScore += macdL > macdS ? 1 : macdL < macdS ? -1 : 0

    // — Volatility —
    bbBasis = ta.sma(htfClose, bbLen)
    bbDev   = bbMult * ta.stdev(htfClose, bbLen)
    bbWidth = (bbDev * 2) / bbBasis * 100
    bbWSMA  = ta.sma(bbWidth, 20)

    int volState = 1
    if bbWidth > bbWSMA * 1.5
        volState := 3
    else if bbWidth > bbWSMA * 1.1
        volState := 2
    else if bbWidth < bbWSMA * 0.7
        volState := 0

    // — Volume —
    vSMA   = ta.sma(htfVol, volSMALen)
    vRatio = vSMA > 0 ? htfVol / vSMA : 1.0

    int vState = 1
    if vRatio > 2.5
        vState := 3
    else if vRatio > 1.5
        vState := 2
    else if vRatio <= 0.7
        vState := 0

    // — Composite Bias —
    float bias = 0.0

    if trendScore >= 4
        bias += 45.0
    else if trendScore == 3
        bias += 35.0
    else if trendScore == 2
        bias += 24.0
    else if trendScore == 1
        bias += 12.0
    else if trendScore == -1
        bias -= 12.0
    else if trendScore == -2
        bias -= 24.0
    else if trendScore == -3
        bias -= 35.0
    else if trendScore <= -4
        bias -= 45.0

    if momScore >= 3
        bias += 30.0
    else if momScore == 2
        bias += 22.0
    else if momScore == 1
        bias += 12.0
    else if momScore == -1
        bias -= 12.0
    else if momScore == -2
        bias -= 22.0
    else if momScore <= -3
        bias -= 30.0

    if vState == 3
        bias += 15.0
    else if vState == 2
        bias += 10.0
    else if vState == 1
        bias += 4.0

    if volState == 3
        bias += 10.0
    else if volState == 2
        bias += 5.0
    else if volState == 0
        bias -= 8.0

    float biasScore = math.min(100.0, math.abs(bias))
    int   biasDir   = bias > 12 ? 1 : bias < -12 ? -1 : 0

    [trendScore, momScore, volState, vState, biasScore, biasDir, rsi, stK, vRatio]

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ MULTI-TIMEFRAME DATA ═════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

[c1,h1,l1,o1,v1] = request.security(syminfo.tickerid, tf1,
  [close,high,low,open,volume], lookahead=barmerge.lookahead_off)
[c2,h2,l2,o2,v2] = request.security(syminfo.tickerid, tf2,
  [close,high,low,open,volume], lookahead=barmerge.lookahead_off)
[c3,h3,l3,o3,v3] = request.security(syminfo.tickerid, tf3,
  [close,high,low,open,volume], lookahead=barmerge.lookahead_off)
[c4,h4,l4,o4,v4] = request.security(syminfo.tickerid, tf4,
  [close,high,low,open,volume], lookahead=barmerge.lookahead_off)
[c5,h5,l5,o5,v5] = request.security(syminfo.tickerid, tf5,
  [close,high,low,open,volume], lookahead=barmerge.lookahead_off)

[tr1,mo1,vl1,vs1,bs1,bd1,rs1,sk1,vr1] = f_analyze(c1,h1,l1,v1)
[tr2,mo2,vl2,vs2,bs2,bd2,rs2,sk2,vr2] = f_analyze(c2,h2,l2,v2)
[tr3,mo3,vl3,vs3,bs3,bd3,rs3,sk3,vr3] = f_analyze(c3,h3,l3,v3)
[tr4,mo4,vl4,vs4,bs4,bd4,rs4,sk4,vr4] = f_analyze(c4,h4,l4,v4)
[tr5,mo5,vl5,vs5,bs5,bd5,rs5,sk5,vr5] = f_analyze(c5,h5,l5,v5)

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ ALIGNMENT & PULSE SCORE ═════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

bullCount = (bd1==1?1:0)+(bd2==1?1:0)+(bd3==1?1:0)+(bd4==1?1:0)+(bd5==1?1:0)
bearCount = (bd1==-1?1:0)+(bd2==-1?1:0)+(bd3==-1?1:0)+(bd4==-1?1:0)+(bd5==-1?1:0)
neutCount = 5 - bullCount - bearCount

fullBullAlign   = bullCount == 5
fullBearAlign   = bearCount == 5
strongBullAlign = bullCount >= 4
strongBearAlign = bearCount >= 4
mixedMarket     = neutCount >= 3 or (bullCount >= 2 and bearCount >= 2)

f_weight(dir, score, w) =>
    dir == 1 ? score * w / 100.0 : dir == -1 ? -(score * w / 100.0) : 0.0

rawPulse = f_weight(bd5,bs5,30) + f_weight(bd4,bs4,25) +
  f_weight(bd3,bs3,20) + f_weight(bd2,bs2,15) + f_weight(bd1,bs1,10)

pulseDir       = rawPulse > 10 ? 1 : rawPulse < -10 ? -1 : 0
pulseBullScore = rawPulse > 0 ? math.min(100.0, rawPulse) : 0.0
pulseBearScore = rawPulse < 0 ? math.min(100.0, math.abs(rawPulse)) : 0.0

string alignText = "CONFLICTED"
if fullBullAlign
    alignText := "FULL BULL ▲▲▲▲▲"
else if fullBearAlign
    alignText := "FULL BEAR ▼▼▼▼▼"
else if strongBullAlign
    alignText := "STRONG BULL ▲▲▲▲"
else if strongBearAlign
    alignText := "STRONG BEAR ▼▼▼▼"
else if bullCount == 3
    alignText := "BULL LEAN ▲▲▲"
else if bearCount == 3
    alignText := "BEAR LEAN ▼▼▼"
else if mixedMarket
    alignText := "MIXED — WAIT"

color alignColor = colNeutralLight
if fullBullAlign or strongBullAlign
    alignColor := colBullBright
else if bullCount == 3
    alignColor := colBullPrimary
else if fullBearAlign or strongBearAlign
    alignColor := colBearBright
else if bearCount == 3
    alignColor := colBearPrimary

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ CURRENT TF LOCALS ════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

emaFast  = ta.ema(close, emaFastLen)
emaMed   = ta.ema(close, emaMedLen)
emaSlow  = ta.ema(close, emaSlowLen)
emaAnc   = ta.ema(close, emaAncLen)
localRSI = ta.rsi(close, rsiLen)
localATR = ta.atr(atrLen)
localVol = ta.sma(volume, volSMALen)
localVRat = localVol > 0 ? volume / localVol : 1.0

bbBasisL    = ta.sma(close, bbLen)
bbDevL      = bbMult * ta.stdev(close, bbLen)
bbWidthL    = (bbDevL * 2) / bbBasisL * 100
bbWSMAL     = ta.sma(bbWidthL, 20)
bbExpanding = bbWidthL > bbWSMAL * 1.1

stochKL = ta.stoch(close, high, low, stochLen)
stochDL = ta.sma(stochKL, stochSmooth)

macdLineL = ta.ema(close, 12) - ta.ema(close, 26)
macdSigL  = ta.ema(macdLineL, 9)
macdHistL = macdLineL - macdSigL
macdBull  = macdLineL > macdSigL
macdMomUp = macdHistL > macdHistL[1]

higherHigh = high > high[1] and high[1] > high[2]
lowerLow   = low  < low[1]  and low[1]  < low[2]
higherLow  = low  > low[1]
lowerHigh  = high < high[1]

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ CHART OVERLAY ════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

ribbonBullLocal = emaFast > emaSlow
cloudColor = ribbonBullLocal ?
  color.new(colBullDim, 88) : color.new(colBearDim, 88)

pF = plot(showBiasCloud ? emaFast : na, display=display.none)
pS = plot(showBiasCloud ? emaSlow : na, display=display.none)
fill(pF, pS, color=showBiasCloud ? cloudColor : na, title="Bias Cloud")

plot(showEMAs ? emaFast : na, "Fast EMA",
  color=color.new(ribbonBullLocal ? colBullPrimary : colBearPrimary, 40),
  linewidth=1)
plot(showEMAs ? emaMed : na, "Med EMA",
  color=color.new(colNeutralLight, 50), linewidth=1)
plot(showEMAs ? emaSlow : na, "Slow EMA",
  color=color.new(colNeutral, 30), linewidth=2)
plot(showEMAs ? emaAnc : na, "Anchor EMA",
  color=color.new(colNeutral, 50), linewidth=3)

// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════ DASHBOARD ════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════

f_trendTxt(ts) =>
    string result = "— FLAT"
    if ts >= 4
        result := "▲▲ STRONG"
    else if ts >= 2
        result := "▲ BULL"
    else if ts == 1
        result := "▲ LEAN"
    else if ts == -1
        result := "▼ LEAN"
    else if ts <= -2 and ts > -4
        result := "▼ BEAR"
    else if ts <= -4
        result := "▼▼ STRONG"
    result

f_trendClr(ts, bul, ber) =>
    color result = #888888
    if ts >= 4
        result := bul
    else if ts >= 2
        result := bul
    else if ts == 1
        result := color.new(bul, 40)
    else if ts <= -4
        result := ber
    else if ts <= -2
        result := ber
    else if ts == -1
        result := color.new(ber, 40)
    result

f_momTxt(ms) =>
    string result = "— FLAT"
    if ms >= 3
        result := "▲▲ STRONG"
    else if ms == 2
        result := "▲ RISING"
    else if ms == 1
        result := "▲ LEAN"
    else if ms == -1
        result := "▼ LEAN"
    else if ms == -2
        result := "▼ FALLING"
    else if ms <= -3
        result := "▼▼ STRONG"
    result

f_momClr(ms, bul, ber) =>
    color result = #888888
    if ms >= 2
        result := bul
    else if ms == 1
        result := color.new(bul, 40)
    else if ms <= -2
        result := ber
    else if ms == -1
        result := color.new(ber, 40)
    result

f_volTxt(vs) =>
    string result = "DRY"
    if vs == 3
        result := "SPIKE"
    else if vs == 2
        result := "HIGH"
    else if vs == 1
        result := "NORMAL"
    result

f_volClr(vs, bul, neu) =>
    color result = #555555
    if vs == 3
        result := bul
    else if vs == 2
        result := color.new(bul, 30)
    else if vs == 1
        result := neu
    result

f_vtTxt(vl) =>
    string result = "COMPRESSED"
    if vl == 3
        result := "EXPANDING"
    else if vl == 2
        result := "ELEVATED"
    else if vl == 1
        result := "NORMAL"
    result

f_vtClr(vl, bul, ber, neu) =>
    color result = neu
    if vl == 3
        result := bul
    else if vl == 2
        result := color.new(bul, 40)
    else if vl == 0
        result := ber
    result

f_biasTxt(dir, sc) =>
    string pct = str.tostring(math.round(sc), "#")
    string result = "— " + pct
    if dir == 1
        result := "▲ " + pct
    else if dir == -1
        result := "▼ " + pct
    result

f_biasC(dir, bul, ber, neu) =>
    color result = neu
    if dir == 1
        result := bul
    else if dir == -1
        result := ber
    result

f_rowTxt(ts, ms) =>
    string tt = "—"
    if ts >= 4
        tt := "▲▲"
    else if ts >= 2
        tt := "▲"
    else if ts == 1
        tt := "△"
    else if ts <= -4
        tt := "▼▼"
    else if ts <= -2
        tt := "▼"
    else if ts == -1
        tt := "▽"
    string mt = "—"
    if ms >= 2
        mt := "▲▲"
    else if ms == 1
        mt := "▲"
    else if ms <= -2
        mt := "▼▼"
    else if ms == -1
        mt := "▼"
    tt + "  •  " + mt

int curBBState = 1
if bbWidthL > bbWSMAL * 1.5
    curBBState := 3
else if bbWidthL > bbWSMAL * 1.1
    curBBState := 2
else if bbWidthL < bbWSMAL * 0.7
    curBBState := 0

string structTxt = "RANGING"
color  structClr = colNeutralLight
if higherHigh and higherLow
    structTxt := "▲ HIGHER H/L"
    structClr := colBullPrimary
else if lowerLow and lowerHigh
    structTxt := "▼ LOWER H/L"
    structClr := colBearPrimary
else if higherHigh
    structTxt := "▲ HIGHER HIGH"
    structClr := color.new(colBullPrimary, 30)
else if lowerLow
    structTxt := "▼ LOWER LOW"
    structClr := color.new(colBearPrimary, 30)

string macdTxt = "— FLAT"
color  macdClr = colNeutralLight
if macdBull and macdMomUp
    macdTxt := "▲ BULL + MOM"
    macdClr := colBullBright
else if macdBull
    macdTxt := "▲ BULLISH"
    macdClr := colBullPrimary
else if not macdBull and not macdMomUp
    macdTxt := "▼ BEAR + MOM"
    macdClr := colBearBright
else if not macdBull
    macdTxt := "▼ BEARISH"
    macdClr := colBearPrimary

var table dash = na
if showDash
    dash := table.new(f_pos(dashPos), 3, 25,
      bgcolor=color.new(colDashBg, 0),
      border_width=1,
      border_color=color.new(colNeutral, 70),
      frame_width=2,
      frame_color=color.new(colNeutral, 35))

if showDash and barstate.islast

    // ── Title ──────────────────────────────────────────────────────────────────
    table.cell(dash, 0, 0, "A L P H A X   P U L S E",
      text_color=colBullPrimary, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 0, "", bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 0, "", bgcolor=color.new(colDashBg, 0))
    table.merge_cells(dash, 0, 0, 2, 0)

    // ── Column Headers ─────────────────────────────────────────────────────────
    table.cell(dash, 0, 1, "TIMEFRAME",
      text_color=colNeutralLight, text_size=dashTextSize,
      bgcolor=color.new(colNeutral, 85))
    table.cell(dash, 1, 1, "TREND  •  MOM",
      text_color=colNeutralLight, text_size=dashTextSize,
      bgcolor=color.new(colNeutral, 85))
    table.cell(dash, 2, 1, "BIAS",
      text_color=colNeutralLight, text_size=dashTextSize,
      bgcolor=color.new(colNeutral, 85))

    // ── TF Rows ────────────────────────────────────────────────────────────────
    table.cell(dash, 0, 2, tf1,
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 2, f_rowTxt(tr1, mo1),
      text_color=f_trendClr(tr1, colBullPrimary, colBearPrimary),
      text_size=dashTextSize, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 2, f_biasTxt(bd1, bs1),
      text_color=f_biasC(bd1, colBullPrimary, colBearPrimary, colNeutralLight),
      text_size=dashTextSize, bgcolor=color.new(colDashBg, 0))

    table.cell(dash, 0, 3, tf2,
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 3, f_rowTxt(tr2, mo2),
      text_color=f_trendClr(tr2, colBullPrimary, colBearPrimary),
      text_size=dashTextSize, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 3, f_biasTxt(bd2, bs2),
      text_color=f_biasC(bd2, colBullPrimary, colBearPrimary, colNeutralLight),
      text_size=dashTextSize, bgcolor=color.new(colDashBg, 0))

    table.cell(dash, 0, 4, tf3,
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 4, f_rowTxt(tr3, mo3),
      text_color=f_trendClr(tr3, colBullPrimary, colBearPrimary),
      text_size=dashTextSize, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 4, f_biasTxt(bd3, bs3),
      text_color=f_biasC(bd3, colBullPrimary, colBearPrimary, colNeutralLight),
      text_size=dashTextSize, bgcolor=color.new(colDashBg, 0))

    table.cell(dash, 0, 5, tf4,
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 5, f_rowTxt(tr4, mo4),
      text_color=f_trendClr(tr4, colBullPrimary, colBearPrimary),
      text_size=dashTextSize, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 5, f_biasTxt(bd4, bs4),
      text_color=f_biasC(bd4, colBullPrimary, colBearPrimary, colNeutralLight),
      text_size=dashTextSize, bgcolor=color.new(colDashBg, 0))

    table.cell(dash, 0, 6, tf5,
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 6, f_rowTxt(tr5, mo5),
      text_color=f_trendClr(tr5, colBullPrimary, colBearPrimary),
      text_size=dashTextSize, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 6, f_biasTxt(bd5, bs5),
      text_color=f_biasC(bd5, colBullPrimary, colBearPrimary, colNeutralLight),
      text_size=dashTextSize, bgcolor=color.new(colDashBg, 0))

    // ── Divider ────────────────────────────────────────────────────────────────
    table.cell(dash, 0, 7, "───────────────────────",
      text_color=colNeutral, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 7, "", bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 7, "", bgcolor=color.new(colDashBg, 0))
    table.merge_cells(dash, 0, 7, 2, 7)

    // ── Alignment ─────────────────────────────────────────────────────────────
    table.cell(dash, 0, 8, "ALIGNMENT",
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 8, alignText,
      text_color=alignColor, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 8,
      str.tostring(bullCount) + "▲  " +
      str.tostring(bearCount) + "▼  " +
      str.tostring(neutCount) + "—",
      text_color=colNeutralLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))

    // ── Pulse Score ────────────────────────────────────────────────────────────
    color pulseScoreClr = colNeutralLight
    if pulseDir == 1
        pulseScoreClr := pulseBullScore >= 85 ? colBullBright : colBullPrimary
    else if pulseDir == -1
        pulseScoreClr := pulseBearScore >= 85 ? colBearBright : colBearPrimary

    string pulseScoreTxt = "— NEUTRAL"
    if pulseDir == 1
        pulseScoreTxt := "▲ BULL  " + str.tostring(math.round(pulseBullScore), "#") + " / 100"
    else if pulseDir == -1
        pulseScoreTxt := "▼ BEAR  " + str.tostring(math.round(pulseBearScore), "#") + " / 100"

    table.cell(dash, 0, 9, "PULSE SCORE",
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 9, pulseScoreTxt,
      text_color=pulseScoreClr, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 9, "", bgcolor=color.new(colDashBg, 0))
    table.merge_cells(dash, 1, 9, 2, 9)

    // ── Verdict ───────────────────────────────────────────────────────────────
    string verdictTxt = "✕  NO CLEAR EDGE"
    if fullBullAlign or (strongBullAlign and pulseBullScore >= 70)
        verdictTxt := "✓  HIGH CONFIDENCE LONG"
    else if fullBearAlign or (strongBearAlign and pulseBearScore >= 70)
        verdictTxt := "✓  HIGH CONFIDENCE SHORT"
    else if bullCount == 3 and pulseBullScore >= 60
        verdictTxt := "△  LEAN LONG — CAUTION"
    else if bearCount == 3 and pulseBearScore >= 60
        verdictTxt := "▽  LEAN SHORT — CAUTION"
    else if mixedMarket
        verdictTxt := "✕  MIXED — STAND ASIDE"

    color verdictClr = colNeutralLight
    if str.contains(verdictTxt, "HIGH CONFIDENCE LONG")
        verdictClr := colBullBright
    else if str.contains(verdictTxt, "HIGH CONFIDENCE SHORT")
        verdictClr := colBearBright
    else if str.contains(verdictTxt, "LEAN LONG")
        verdictClr := colBullDim
    else if str.contains(verdictTxt, "LEAN SHORT")
        verdictClr := colBearDim

    table.cell(dash, 0, 10, "VERDICT",
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 10, verdictTxt,
      text_color=verdictClr, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 10, "", bgcolor=color.new(colDashBg, 0))
    table.merge_cells(dash, 1, 10, 2, 10)

    // ── Divider ────────────────────────────────────────────────────────────────
    table.cell(dash, 0, 11, "───────────────────────",
      text_color=colNeutral, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 11, "", bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 11, "", bgcolor=color.new(colDashBg, 0))
    table.merge_cells(dash, 0, 11, 2, 11)

    // ── RSI ───────────────────────────────────────────────────────────────────
    color rsiClr = colNeutralLight
    if localRSI > 70
        rsiClr := colBearBright
    else if localRSI > rsiOB
        rsiClr := colBearPrimary
    else if localRSI < 30
        rsiClr := colBullBright
    else if localRSI < rsiOS
        rsiClr := colBullPrimary

    string rsiStateTxt = "NEUTRAL"
    if localRSI > 70
        rsiStateTxt := "OVERBOUGHT"
    else if localRSI < 30
        rsiStateTxt := "OVERSOLD"
    else if localRSI > rsiOB
        rsiStateTxt := "ELEVATED"
    else if localRSI < rsiOS
        rsiStateTxt := "DEPRESSED"

    table.cell(dash, 0, 12, "RSI (" + str.tostring(rsiLen) + ")",
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 12, str.tostring(localRSI, "#.#"),
      text_color=rsiClr, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 12, rsiStateTxt,
      text_color=rsiClr, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))

    // ── Stoch ─────────────────────────────────────────────────────────────────
    color stKClr = colNeutralLight
    if stochKL > 80
        stKClr := colBearPrimary
    else if stochKL < 20
        stKClr := colBullPrimary

    string stKTxt = "MID RANGE"
    if stochKL > 80
        stKTxt := "OB ZONE"
    else if stochKL < 20
        stKTxt := "OS ZONE"

    table.cell(dash, 0, 13, "STOCH K",
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 13, str.tostring(stochKL, "#.#"),
      text_color=stKClr, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 13, stKTxt,
      text_color=stKClr, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))

    // ── MACD ──────────────────────────────────────────────────────────────────
    table.cell(dash, 0, 14, "MACD",
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 14, macdTxt,
      text_color=macdClr, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 14, str.tostring(macdHistL, format.mintick),
      text_color=macdHistL >= 0 ? colBullDim : colBearDim,
      text_size=dashTextSize, bgcolor=color.new(colDashBg, 0))

    // ── Structure ─────────────────────────────────────────────────────────────
    table.cell(dash, 0, 15, "STRUCTURE",
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 15, structTxt,
      text_color=structClr, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 15, "", bgcolor=color.new(colDashBg, 0))

    // ── Volatility ────────────────────────────────────────────────────────────
    table.cell(dash, 0, 16, "VOLATILITY",
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 16, f_vtTxt(curBBState),
      text_color=f_vtClr(curBBState, colBullPrimary, colBearPrimary, colNeutralLight),
      text_size=dashTextSize, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 16, str.tostring(bbWidthL, "#.##") + "%",
      text_color=colNeutralLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))

    // ── BB Width ──────────────────────────────────────────────────────────────
    color bbExpClr = colNeutralLight
    if bbExpanding
        bbExpClr := colBullPrimary

    table.cell(dash, 0, 17, "BB WIDTH",
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 17, bbExpanding ? "▲ EXPANDING" : "▼ CONTRACTING",
      text_color=bbExpClr, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 17, "", bgcolor=color.new(colDashBg, 0))

    // ── Volume ────────────────────────────────────────────────────────────────
    int vStateLocal = 0
    if localVRat > 2.5
        vStateLocal := 3
    else if localVRat > 1.5
        vStateLocal := 2
    else if localVRat > 0.7
        vStateLocal := 1

    table.cell(dash, 0, 18, "VOLUME",
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 18, f_volTxt(vStateLocal),
      text_color=f_volClr(vStateLocal, colBullPrimary, colNeutralLight),
      text_size=dashTextSize, bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 18, "×" + str.tostring(localVRat, "#.##"),
      text_color=colNeutralLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))

    // ── ATR ───────────────────────────────────────────────────────────────────
    table.cell(dash, 0, 19, "ATR",
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 19, str.tostring(localATR, format.mintick),
      text_color=colNeutralLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 19, str.tostring(localATR / close * 100, "#.##") + "%",
      text_color=colNeutralLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))

    // ── Divider ────────────────────────────────────────────────────────────────
    table.cell(dash, 0, 20, "───────────────────────",
      text_color=colNeutral, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 20, "", bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 20, "", bgcolor=color.new(colDashBg, 0))
    table.merge_cells(dash, 0, 20, 2, 20)

    // ── EMA Stack ─────────────────────────────────────────────────────────────
    string emaStackTxt = "— MIXED"
    color  emaStackClr = colNeutralLight
    if emaFast > emaMed and emaMed > emaSlow and emaSlow > emaAnc
        emaStackTxt := "▲ FULL BULL STACK"
        emaStackClr := colBullBright
    else if emaFast > emaMed and emaMed > emaSlow
        emaStackTxt := "▲ BULL STACK"
        emaStackClr := colBullPrimary
    else if emaFast < emaMed and emaMed < emaSlow and emaSlow < emaAnc
        emaStackTxt := "▼ FULL BEAR STACK"
        emaStackClr := colBearBright
    else if emaFast < emaMed and emaMed < emaSlow
        emaStackTxt := "▼ BEAR STACK"
        emaStackClr := colBearPrimary

    table.cell(dash, 0, 21, "EMA STACK",
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 21, emaStackTxt,
      text_color=emaStackClr, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 21, "", bgcolor=color.new(colDashBg, 0))

    // ── Bull Score ────────────────────────────────────────────────────────────
    color bsClr = colNeutral
    if pulseBullScore >= 85
        bsClr := colBullBright
    else if pulseBullScore >= 70
        bsClr := colBullPrimary
    else if pulseBullScore >= 50
        bsClr := colBullDim

    table.cell(dash, 0, 22, "BULL SCORE",
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 22,
      str.tostring(math.round(pulseBullScore), "#") + " / 100",
      text_color=bsClr, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 22, "", bgcolor=color.new(colDashBg, 0))

    // ── Bear Score ────────────────────────────────────────────────────────────
    color ssClr = colNeutral
    if pulseBearScore >= 85
        ssClr := colBearBright
    else if pulseBearScore >= 70
        ssClr := colBearPrimary
    else if pulseBearScore >= 50
        ssClr := colBearDim

    table.cell(dash, 0, 23, "BEAR SCORE",
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 23,
      str.tostring(math.round(pulseBearScore), "#") + " / 100",
      text_color=ssClr, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 23, "", bgcolor=color.new(colDashBg, 0))

    // ── Price vs EMA 200 ──────────────────────────────────────────────────────
    anchorDist = (close - emaAnc) / emaAnc * 100
    color ancClr = anchorDist > 0 ? colBullPrimary : colBearPrimary

    table.cell(dash, 0, 24, "VS EMA 200",
      text_color=colTextLight, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 1, 24,
      (anchorDist > 0 ? "▲ +" : "▼ ") + str.tostring(anchorDist, "#.##") + "%",
      text_color=ancClr, text_size=dashTextSize,
      bgcolor=color.new(colDashBg, 0))
    table.cell(dash, 2, 24, "", bgcolor=color.new(colDashBg, 0))
