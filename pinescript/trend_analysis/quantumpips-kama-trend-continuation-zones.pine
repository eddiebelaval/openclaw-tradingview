//@version=6
indicator("QuantumPips KAMA Trend Continuation Zones", shorttitle="QP KAMA ZONES", overlay=true,
     max_bars_back=3000, max_labels_count=200)

//────────────────────────────────────────────
// Inputs
//────────────────────────────────────────────
grpK = "KAMA Engine"
src        = input.source(hl2, "Source", group=grpK)
kamaSlowLn = input.int(93, "KAMA Slow ER Length", minval=10, group=grpK)
kamaFastLn = input.int(50, "KAMA Fast ER Length", minval=5, group=grpK)

// KAMA smoothing controls (standard KAMA uses fast=2, slow=30)
fastSC_Per = input.int(2,  "KAMA Fast SC Period", minval=1, group=grpK)
slowSC_Per = input.int(30, "KAMA Slow SC Period", minval=2, group=grpK)

grpVol = "Volatility Bands"
stdevLen   = input.int(93, "StDev Length", minval=10, group=grpVol)
bandMult   = input.float(2.0, "Band Multiplier", step=0.1, group=grpVol)
thinFactor = input.float(6.0, "Inner Band Thin Factor", step=0.5, minval=1.0, group=grpVol)

grpReg = "Regime Filter"
atrLen      = input.int(14, "ATR Length", minval=1, group=grpReg)
widthMaLen  = input.int(50, "Band Width Baseline SMA", minval=5, group=grpReg)
trendWidthK = input.float(1.10, "Trend Mode if Width > Baseline x", step=0.05, group=grpReg)

grpVis = "Visuals"
showValueZone = input.bool(true, "Show Value Zone (Fast↔Slow)", group=grpVis)
showBands     = input.bool(true, "Show Volatility Bands", group=grpVis)
shadeRegime   = input.bool(true, "Shade Regime (Trend/Chop)", group=grpVis)
showPanel     = input.bool(true, "Show Panel", group=grpVis)

colBull = input.color(color.new(color.lime, 0), "Bull Color", group=grpVis)
colBear = input.color(color.new(color.red,  0), "Bear Color", group=grpVis)
colNeu  = input.color(color.new(color.gray, 0), "Neutral Color", group=grpVis)

colValue   = input.color(color.new(color.aqua, 88), "Value Zone Fill", group=grpVis)
colTrendBG = input.color(color.new(color.lime, 92), "Trend Mode BG", group=grpVis)
colChopBG  = input.color(color.new(color.gray, 92), "Chop Mode BG", group=grpVis)

//────────────────────────────────────────────
// Manual rolling sum (replaces ta.sum)
//────────────────────────────────────────────
f_sum_abs_change(_src, _len) =>
    float s = 0.0
    for i = 0 to _len - 1
        s += math.abs(_src[i] - nz(_src[i + 1]))
    s

//────────────────────────────────────────────
// Custom KAMA (no ta.kama, no ta.sum)
// ER = |src - src[len]| / sum(|src - src[1]|, len)
// SC = (ER*(fastSC - slowSC) + slowSC)^2
// KAMA = KAMA[1] + SC*(src - KAMA[1])
//────────────────────────────────────────────
f_kama(_src, _erLen, _fastPer, _slowPer) =>
    float fastSC = 2.0 / (_fastPer + 1.0)
    float slowSC = 2.0 / (_slowPer + 1.0)

    float change = math.abs(_src - nz(_src[_erLen]))
    float volatility = f_sum_abs_change(_src, _erLen)

    float er = volatility == 0.0 ? 0.0 : change / volatility
    float sc = math.pow(er * (fastSC - slowSC) + slowSC, 2)

    var float kama = na
    kama := na(kama[1]) ? _src : (kama[1] + sc * (_src - kama[1]))
    kama

//────────────────────────────────────────────
// KAMA Trend Lines
//────────────────────────────────────────────
kamaSlow = f_kama(src, kamaSlowLn, fastSC_Per, slowSC_Per)
kamaFast = f_kama(src, kamaFastLn, fastSC_Per, slowSC_Per)

// Trend direction by slow KAMA slope
slopeUp   = kamaSlow > kamaSlow[1]
slopeDown = kamaSlow < kamaSlow[1]

biasBull = slopeUp and close >= kamaSlow
biasBear = slopeDown and close <= kamaSlow
biasTxt  = biasBull ? "Bullish" : biasBear ? "Bearish" : "Neutral"
biasCol  = biasBull ? colBull : biasBear ? colBear : colNeu

plot(kamaSlow, "KAMA Slow", color=biasCol, linewidth=3)
plot(kamaFast, "KAMA Fast", color=color.new(color.white, 65), linewidth=1)

//────────────────────────────────────────────
// Volatility Bands (stdev around slow KAMA)
//────────────────────────────────────────────
atr = ta.atr(atrLen)

dev = bandMult * ta.stdev(src, stdevLen)
upper = kamaSlow + dev
lower = kamaSlow - dev

devInner = (bandMult / thinFactor) * ta.stdev(src, stdevLen)
upper2 = upper + devInner
upper1 = upper - devInner
lower1 = lower + devInner
lower2 = lower - devInner

u  = plot(showBands ? upper  : na, "Upper", color=color.new(color.gray, 45))
l  = plot(showBands ? lower  : na, "Lower", color=color.new(color.gray, 45))

u2 = plot(showBands ? upper2 : na, "Upper Outer", color=color.new(colBear, 70))
u1 = plot(showBands ? upper1 : na, "Upper Inner", color=color.new(colBear, 88))
l1 = plot(showBands ? lower1 : na, "Lower Inner", color=color.new(colBull, 88))
l2 = plot(showBands ? lower2 : na, "Lower Outer", color=color.new(colBull, 70))

fill(u2, u, color.new(colBear, 80))
fill(u1, u, color.new(colBear, 90))
fill(l1, l, color.new(colBull, 90))
fill(l2, l, color.new(colBull, 80))

//────────────────────────────────────────────
// Value Zone (pullback area)
//────────────────────────────────────────────
vzTop = math.max(kamaFast, kamaSlow)
vzBot = math.min(kamaFast, kamaSlow)

pVt = plot(showValueZone ? vzTop : na, "Value Top", color=color.new(color.aqua, 100))
pVb = plot(showValueZone ? vzBot : na, "Value Bot", color=color.new(color.aqua, 100))
fill(pVt, pVb, colValue)

//────────────────────────────────────────────
// Regime: Trend Mode vs Chop Mode
//────────────────────────────────────────────
width = (upper - lower) / math.max(atr, syminfo.mintick)  // normalized by ATR
widthBase = ta.sma(width, widthMaLen)

trendMode = width > widthBase * trendWidthK
regimeTxt = trendMode ? "Trend Mode" : "Chop Mode"

bgcolor(shadeRegime ? (trendMode ? colTrendBG : colChopBG) : na)

// Strength score: slope magnitude vs ATR
strengthRaw = math.abs(kamaSlow - kamaSlow[1]) / math.max(atr, syminfo.mintick)
strengthScore = math.min(100.0, strengthRaw * 2000.0)  // scaled

//────────────────────────────────────────────
// Panel (Top Right) — HEADER REMOVED
//────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 4, border_width=1)

if showPanel and barstate.islast
    table.cell(t, 0, 0, "Bias", text_color=color.white, bgcolor=color.new(color.gray, 75))
    table.cell(t, 1, 0, biasTxt, text_color=color.white, bgcolor=biasCol)

    table.cell(t, 0, 1, "Regime", text_color=color.white, bgcolor=color.new(color.gray, 75))
    table.cell(t, 1, 1, regimeTxt, text_color=color.white, bgcolor=color.new(color.black, 0))

    table.cell(t, 0, 2, "Strength", text_color=color.white, bgcolor=color.new(color.gray, 75))
    table.cell(t, 1, 2, str.tostring(strengthScore, "#.0"), text_color=color.white, bgcolor=color.new(color.black, 0))

    table.cell(t, 0, 3, "Vol Width", text_color=color.white, bgcolor=color.new(color.gray, 75))
    table.cell(t, 1, 3, str.tostring(width, "#.00") + "x ATR", text_color=color.white, bgcolor=color.new(color.black, 0))
