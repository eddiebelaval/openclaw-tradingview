//@version=6
indicator("Daily MGI - OnlyFLow", overlay=true, max_lines_count=500, max_labels_count=500)

// ─── SESSION INPUTS ─────────────────────────────────────────────────────────

i_rthSession  = input.session("0930-1600", "RTH Session", group="Session Times")
i_timezone    = input.string("America/New_York", "Timezone", group="Session Times",
     options=["America/New_York","America/Chicago","America/Los_Angeles","America/Denver","UTC"])
i_pdSource    = input.string("Full Day", "Prior Day Source", options=["Full Day", "RTH Only"], group="Session Times",
     tooltip="Full Day = entire 24hr daily candle. RTH Only = regular trading hours only.")

// ─── RTH OPEN ───────────────────────────────────────────────────────────────

i_showOpen     = input.bool(true, "Show RTH Open", inline="open1", group="RTH Open")
i_lblOpen      = input.bool(true, "Label", inline="open1", group="RTH Open")
i_openColor    = input.color(color.new(color.aqua, 0), "", inline="open1", group="RTH Open")

// ─── PRIOR DAY ──────────────────────────────────────────────────────────────

i_showPDH      = input.bool(true, "Show PDH", inline="pdh", group="Prior Day")
i_lblPDH       = input.bool(true, "Label", inline="pdh", group="Prior Day")
i_pdHighColor  = input.color(color.new(color.red, 0), "", inline="pdh", group="Prior Day")

i_showPDL      = input.bool(true, "Show PDL", inline="pdl", group="Prior Day")
i_lblPDL       = input.bool(true, "Label", inline="pdl", group="Prior Day")
i_pdLowColor   = input.color(color.new(color.red, 0), "", inline="pdl", group="Prior Day")

i_showPDM      = input.bool(false, "Show PDM", inline="pdm", group="Prior Day")
i_lblPDM       = input.bool(true, "Label", inline="pdm", group="Prior Day")
i_pdMidColor   = input.color(color.new(color.maroon, 0), "", inline="pdm", group="Prior Day")

i_showPDC      = input.bool(true, "Show PDC", inline="pdc", group="Prior Day")
i_lblPDC       = input.bool(true, "Label", inline="pdc", group="Prior Day")
i_pdCloseColor = input.color(color.new(color.fuchsia, 0), "", inline="pdc", group="Prior Day")

// ─── OVERNIGHT ──────────────────────────────────────────────────────────────

i_showONH      = input.bool(true, "Show ONH", inline="onh", group="Overnight")
i_lblONH       = input.bool(true, "Label", inline="onh", group="Overnight")
i_onHighColor  = input.color(color.new(color.blue, 0), "", inline="onh", group="Overnight")

i_showONL      = input.bool(true, "Show ONL", inline="onl", group="Overnight")
i_lblONL       = input.bool(true, "Label", inline="onl", group="Overnight")
i_onLowColor   = input.color(color.new(color.blue, 0), "", inline="onl", group="Overnight")

// ─── VALUE AREA ─────────────────────────────────────────────────────────────

i_showVA       = input.bool(false, "Show Value Area", group="Value Area")
i_vaPct        = input.float(70, "Value Area %", minval=10, maxval=100, step=5, group="Value Area",
     tooltip="Percentage of the range used for the value area. 70% is standard.")
i_lblVAH       = input.bool(true, "VAH Label", inline="vah", group="Value Area")
i_vahColor     = input.color(color.new(color.gray, 30), "", inline="vah", group="Value Area")
i_lblVAL       = input.bool(true, "VAL Label", inline="val", group="Value Area")
i_valColor     = input.color(color.new(color.gray, 30), "", inline="val", group="Value Area")
i_lblPOC       = input.bool(true, "POC Label", inline="poc", group="Value Area")
i_pocColor     = input.color(color.new(color.red, 0), "", inline="poc", group="Value Area")

// ─── OPENING RANGE ──────────────────────────────────────────────────────────

i_showOR       = input.bool(true, "Show Opening Range", group="Opening Range")
i_orMinutes    = input.int(5, "OR Duration (minutes)", minval=1, maxval=60, group="Opening Range")
i_lblORH       = input.bool(true, "ORH Label", inline="orh", group="Opening Range")
i_orHighColor  = input.color(color.new(color.gray, 30), "", inline="orh", group="Opening Range")
i_lblORL       = input.bool(true, "ORL Label", inline="orl", group="Opening Range")
i_orLowColor   = input.color(color.new(color.gray, 30), "", inline="orl", group="Opening Range")
i_lblORM       = input.bool(true, "ORM Label", inline="orm", group="Opening Range")
i_orMidColor   = input.color(color.new(color.gray, 30), "", inline="orm", group="Opening Range")
i_showORext    = input.bool(false, "Show OR Extensions", group="Opening Range")

// ─── INITIAL BALANCE ────────────────────────────────────────────────────────

i_showIB       = input.bool(false, "Show Initial Balance", group="Initial Balance")
i_ibMinutes    = input.int(60, "IB Duration (minutes)", minval=1, maxval=120, group="Initial Balance")
i_lblIBH       = input.bool(true, "IBH Label", inline="ibh", group="Initial Balance")
i_ibHighColor  = input.color(color.new(color.olive, 0), "", inline="ibh", group="Initial Balance")
i_lblIBL       = input.bool(true, "IBL Label", inline="ibl", group="Initial Balance")
i_ibLowColor   = input.color(color.new(color.olive, 0), "", inline="ibl", group="Initial Balance")
i_lblIBM       = input.bool(true, "IBM Label", inline="ibm", group="Initial Balance")
i_ibMidColor   = input.color(color.new(color.olive, 0), "", inline="ibm", group="Initial Balance")
i_showIBext    = input.bool(false, "Show IB Extensions", group="Initial Balance")

// ─── VWAP & MID ─────────────────────────────────────────────────────────────

i_showVWAP     = input.bool(true, "Show RTH VWAP", inline="vwap", group="VWAP & Mid")
i_lblVWAP      = input.bool(true, "Label", inline="vwap", group="VWAP & Mid")
i_vwapColor    = input.color(color.new(color.aqua, 0), "", inline="vwap", group="VWAP & Mid")
i_vwapWidth    = input.int(2, "VWAP Width", minval=1, maxval=5, group="VWAP & Mid")

i_showMid      = input.bool(false, "Show RTH Mid", inline="mid", group="VWAP & Mid")
i_lblMid       = input.bool(true, "Label", inline="mid", group="VWAP & Mid")
i_midColor     = input.color(color.new(color.red, 0), "", inline="mid", group="VWAP & Mid")

// ─── EXTENSIONS ─────────────────────────────────────────────────────────────

i_ext1         = input.float(0.5, "Extension 1 (50%)", group="Extensions")
i_ext2         = input.float(1.0, "Extension 2 (100%)", group="Extensions")
i_ext3         = input.float(1.5, "Extension 3 (150%)", group="Extensions")
i_ext4         = input.float(2.0, "Extension 4 (200%)", group="Extensions")
i_extColor     = input.color(color.new(color.gray, 50), "Extension Color", group="Extensions")

// ─── DISPLAY ────────────────────────────────────────────────────────────────

i_labelSize    = input.string("small", "Label Size", options=["tiny","small","normal","large"], group="Display")
i_labelOffset  = input.int(5, "Label Offset (bars)", minval=1, maxval=20, group="Display")

// ─── DERIVED ────────────────────────────────────────────────────────────────

bool useFullDay = i_pdSource == "Full Day"
float vaHalf = (i_vaPct / 100.0) / 2.0

// ─── HELPERS ────────────────────────────────────────────────────────────────

getLabelSize() =>
    switch i_labelSize
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large

priceStr(float val) =>
    str.tostring(val, format.mintick)

// ─── SESSION DETECTION ──────────────────────────────────────────────────────

isRTH    = not na(time(timeframe.period, i_rthSession, i_timezone))
wasRTH   = not na(time(timeframe.period, i_rthSession, i_timezone)[1])
rthOpen  = isRTH and not wasRTH
rthClose = not isRTH and wasRTH

// ─── NEW CALENDAR DAY DETECTION ─────────────────────────────────────────────
// Detects when a new trading day starts (works on any chart type)

newDay = ta.change(time("D")) != 0

// ═══════════════════════════════════════════════════════════════════════════
// FULL DAY TRACKING — manual, works on any chart type/symbol
// A "full day" = calendar day boundary (midnight or session rollover)
// newDay fires on the first bar of each new trading day.
// ═══════════════════════════════════════════════════════════════════════════

var float fdHigh = na, var float fdLow = na, var float fdClose = na
var int fdHighBar = na, var int fdLowBar = na, var int fdCloseBar = na

var float prevFDHigh = na, var float prevFDLow = na
var float prevFDClose = na, var float prevFDMid = na
var int prevFDHighBar = na, var int prevFDLowBar = na, var int prevFDCloseBar = na

if newDay
    // Snapshot completed day before reset
    if not na(fdHigh)
        prevFDHigh     := fdHigh
        prevFDLow      := fdLow
        prevFDClose    := fdClose
        prevFDMid      := (fdHigh + fdLow) / 2
        prevFDHighBar  := fdHighBar
        prevFDLowBar   := fdLowBar
        prevFDCloseBar := fdCloseBar
    // Reset for new day
    fdHigh     := high
    fdLow      := low
    fdClose    := close
    fdHighBar  := bar_index
    fdLowBar   := bar_index
    fdCloseBar := bar_index
else
    if high > nz(fdHigh, high)
        fdHigh    := high
        fdHighBar := bar_index
    if low < nz(fdLow, low)
        fdLow     := low
        fdLowBar  := bar_index
    fdClose    := close
    fdCloseBar := bar_index

// request.security backup for first day on chart
float rsDayHigh  = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
float rsDayLow   = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)
float rsDayClose = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)

float fullDayHigh  = not na(prevFDHigh)  ? prevFDHigh  : rsDayHigh
float fullDayLow   = not na(prevFDLow)   ? prevFDLow   : rsDayLow
float fullDayClose = not na(prevFDClose) ? prevFDClose : rsDayClose
float fullDayMid   = not na(fullDayHigh) and not na(fullDayLow) ? (fullDayHigh + fullDayLow) / 2 : na

// ═══════════════════════════════════════════════════════════════════════════
// RTH ONLY — tracked via session detection
// Snapshots at RTH close so values are available immediately during overnight
// ═══════════════════════════════════════════════════════════════════════════

var float rtHigh = na, var float rtLow = na, var float rtClose = na
var int rtHighBar = na, var int rtLowBar = na, var int rtCloseBar = na

var float prevRTHigh = na, var float prevRTLow = na
var float prevRTClose = na, var float prevRTMid = na
var int prevRTHighBar = na, var int prevRTLowBar = na, var int prevRTCloseBar = na

if rthOpen
    // Reset for new RTH session
    rtHigh     := high
    rtLow      := low
    rtClose    := close
    rtHighBar  := bar_index
    rtLowBar   := bar_index
    rtCloseBar := bar_index
else if isRTH
    if high > nz(rtHigh, high)
        rtHigh    := high
        rtHighBar := bar_index
    if low < nz(rtLow, low)
        rtLow     := low
        rtLowBar  := bar_index
    rtClose    := close
    rtCloseBar := bar_index

if rthClose
    // Snapshot completed RTH — immediately available for overnight
    prevRTHigh     := rtHigh
    prevRTLow      := rtLow
    prevRTClose    := rtClose
    prevRTMid      := not na(rtHigh) and not na(rtLow) ? (rtHigh + rtLow) / 2 : na
    prevRTHighBar  := rtHighBar
    prevRTLowBar   := rtLowBar
    prevRTCloseBar := rtCloseBar

// ─── SELECT ACTIVE PD VALUES ────────────────────────────────────────────────

float pdHigh  = useFullDay ? fullDayHigh  : prevRTHigh
float pdLow   = useFullDay ? fullDayLow   : prevRTLow
float pdClose = useFullDay ? fullDayClose : prevRTClose
float pdMid   = useFullDay ? fullDayMid   : prevRTMid

// Origin bars — where each PD level was actually printed
int pdHighOrigin  = useFullDay ? prevFDHighBar  : prevRTHighBar
int pdLowOrigin   = useFullDay ? prevFDLowBar   : prevRTLowBar
int pdCloseOrigin = useFullDay ? prevFDCloseBar : prevRTCloseBar

// ─── DAY START BAR (where PD lines begin if no origin bar) ──────────────────

var int dayStartBar = na

if newDay
    dayStartBar := bar_index
if not useFullDay and rthClose
    dayStartBar := bar_index

// ─── RTH OHLC (current session) ────────────────────────────────────────────

var float rthHigh = na, var float rthLow = na
var float todayRTHOpen = na
var int barRTHOpen = na

if rthOpen
    rthHigh      := high
    rthLow       := low
    todayRTHOpen := open
    barRTHOpen   := bar_index

if isRTH and not rthOpen
    rthHigh := math.max(nz(rthHigh, high), high)
    rthLow  := math.min(nz(rthLow, low), low)

// ─── OVERNIGHT HIGH / LOW ───────────────────────────────────────────────────
// Overnight = from new day start (ETH open) to RTH open

var float onHigh = na, var float onLow = na
var int barONstart = na

if newDay
    onHigh     := high
    onLow      := low
    barONstart := bar_index

if not isRTH and not newDay
    if high > nz(onHigh)
        onHigh := high
    if low < nz(onLow)
        onLow  := low

// Also capture the gap between RTH close and new day
if not isRTH
    if newDay
        onHigh := high
        onLow  := low
    else
        onHigh := math.max(nz(onHigh, high), high)
        onLow  := math.min(nz(onLow, low), low)

// ─── VALUE AREA ─────────────────────────────────────────────────────────────

float vaRange = nz(pdHigh - pdLow)
float prevVAH = not na(pdMid) ? pdMid + vaRange * vaHalf : na
float prevVAL = not na(pdMid) ? pdMid - vaRange * vaHalf : na
float prevPOC = pdMid

// ─── OPENING RANGE ──────────────────────────────────────────────────────────

var float orHigh = na, var float orLow = na, var float orMid = na
var bool  orComplete = false
var int   orStartTime = na, var int orCompleteBar = na

if rthOpen
    orHigh := high, orLow := low, orComplete := false
    orStartTime := time, orCompleteBar := na

if isRTH and not orComplete
    orHigh := math.max(nz(orHigh, high), high)
    orLow  := math.min(nz(orLow, low), low)
    orMid  := (orHigh + orLow) / 2
    if (time - orStartTime) >= i_orMinutes * 60 * 1000
        orComplete := true, orCompleteBar := bar_index

// ─── INITIAL BALANCE ────────────────────────────────────────────────────────

var float ibHigh = na, var float ibLow = na, var float ibMid = na
var bool  ibComplete = false
var int   ibStartTime = na, var int ibCompleteBar = na

if rthOpen
    ibHigh := high, ibLow := low, ibComplete := false
    ibStartTime := time, ibCompleteBar := na

if isRTH and not ibComplete
    ibHigh := math.max(nz(ibHigh, high), high)
    ibLow  := math.min(nz(ibLow, low), low)
    ibMid  := (ibHigh + ibLow) / 2
    if (time - ibStartTime) >= i_ibMinutes * 60 * 1000
        ibComplete := true, ibCompleteBar := bar_index

// ─── RTH VWAP ───────────────────────────────────────────────────────────────

var float cumVol = na, var float cumVolPrice = na, var float rthVWAP = na

if rthOpen
    cumVol := volume, cumVolPrice := hlc3 * volume, rthVWAP := hlc3

if isRTH and not rthOpen
    cumVol      := nz(cumVol) + volume
    cumVolPrice := nz(cumVolPrice) + hlc3 * volume
    rthVWAP     := cumVol > 0 ? cumVolPrice / cumVol : hlc3

plot(i_showVWAP and isRTH ? rthVWAP : na, "RTH VWAP", i_vwapColor, i_vwapWidth, plot.style_linebr)

// ─── RTH MID ────────────────────────────────────────────────────────────────

float rthMidVal = isRTH ? (rthHigh + rthLow) / 2 : na
plot(i_showMid and isRTH ? rthMidVal : na, "RTH Mid", i_midColor, 2, plot.style_linebr)

// ═══════════════════════════════════════════════════════════════════════════
// DRAW LINES + LABELS
// ═══════════════════════════════════════════════════════════════════════════

var line lnOpen = na, var label lbOpen = na
var line lnPDH  = na, var label lbPDH  = na
var line lnPDL  = na, var label lbPDL  = na
var line lnPDM  = na, var label lbPDM  = na
var line lnPDC  = na, var label lbPDC  = na
var line lnONH  = na, var label lbONH  = na
var line lnONL  = na, var label lbONL  = na
var line lnVAH  = na, var label lbVAH  = na
var line lnVAL  = na, var label lbVAL  = na
var line lnPOC  = na, var label lbPOC  = na
var line lnORH  = na, var label lbORH  = na
var line lnORL  = na, var label lbORL  = na
var line lnORM  = na, var label lbORM  = na
var line lnIBH  = na, var label lbIBH  = na
var line lnIBL  = na, var label lbIBL  = na
var line lnIBM  = na, var label lbIBM  = na
var label lbVWAP = na, var label lbMid = na
var line[]  extLines  = array.new_line()
var label[] extLabels = array.new_label()

drawLevel(line ln, label lb, int x1, int x2, float level, color col, int w, string lineStyle, string txt, bool show, bool showLabel) =>
    _ln = ln
    _lb = lb
    int _x1 = math.max(x1, x2 - 499)
    if show and not na(level) and not na(x1)
        if na(_ln)
            _ln := line.new(_x1, level, x2, level, color=col, width=w, style=lineStyle)
        else
            line.set_xy1(_ln, _x1, level)
            line.set_xy2(_ln, x2, level)
            line.set_color(_ln, col)
            line.set_style(_ln, lineStyle)
            line.set_width(_ln, w)
        if showLabel
            string labelTxt = txt + "  " + priceStr(level)
            if na(_lb)
                _lb := label.new(x2 + i_labelOffset, level, labelTxt, style=label.style_none, textcolor=col, size=getLabelSize())
            else
                label.set_xy(_lb, x2 + i_labelOffset, level)
                label.set_text(_lb, labelTxt)
                label.set_textcolor(_lb, col)
        else
            if not na(_lb)
                label.delete(_lb)
                _lb := na
    else
        if not na(_ln)
            line.delete(_ln)
            _ln := na
        if not na(_lb)
            label.delete(_lb)
            _lb := na
    [_ln, _lb]

string SOLID  = line.style_solid
string DASHED = line.style_dashed
string DOTTED = line.style_dotted

if barstate.islast
    int x2  = bar_index
    int xFB = bar_index - 100
    int xDay = nz(dayStartBar, xFB)
    int xRTH = nz(barRTHOpen, xFB)
    int xON  = nz(barONstart, xDay)

    // RTH Open — from RTH open bar
    [_a1, _a2] = drawLevel(lnOpen, lbOpen, xRTH, x2, todayRTHOpen, i_openColor, 1, SOLID, "OPEN", i_showOpen, i_lblOpen)
    lnOpen := _a1, lbOpen := _a2

    // PDH — from where yesterday's high was printed
    [_b1, _b2] = drawLevel(lnPDH, lbPDH, nz(pdHighOrigin, xDay), x2, pdHigh, i_pdHighColor, 1, SOLID, "PDH", i_showPDH, i_lblPDH)
    lnPDH := _b1, lbPDH := _b2

    // PDL — from where yesterday's low was printed
    [_c1, _c2] = drawLevel(lnPDL, lbPDL, nz(pdLowOrigin, xDay), x2, pdLow, i_pdLowColor, 1, SOLID, "PDL", i_showPDL, i_lblPDL)
    lnPDL := _c1, lbPDL := _c2

    // PDM — from day start (calculated, not a specific bar)
    [_d1, _d2] = drawLevel(lnPDM, lbPDM, xDay, x2, pdMid, i_pdMidColor, 1, SOLID, "PDM", i_showPDM, i_lblPDM)
    lnPDM := _d1, lbPDM := _d2

    // PDC — from where yesterday's close was printed
    [_e1, _e2] = drawLevel(lnPDC, lbPDC, nz(pdCloseOrigin, xDay), x2, pdClose, i_pdCloseColor, 1, DASHED, "PDC", i_showPDC, i_lblPDC)
    lnPDC := _e1, lbPDC := _e2

    // Overnight — starts from day start (ETH open)
    [_f1, _f2] = drawLevel(lnONH, lbONH, xON, x2, onHigh, i_onHighColor, 1, SOLID, "ONH", i_showONH, i_lblONH)
    lnONH := _f1, lbONH := _f2

    [_g1, _g2] = drawLevel(lnONL, lbONL, xON, x2, onLow, i_onLowColor, 1, SOLID, "ONL", i_showONL, i_lblONL)
    lnONL := _g1, lbONL := _g2

    // Value Area
    [_h1, _h2] = drawLevel(lnVAH, lbVAH, xDay, x2, prevVAH, i_vahColor, 1, SOLID, "VAH", i_showVA, i_lblVAH)
    lnVAH := _h1, lbVAH := _h2

    [_i1, _i2] = drawLevel(lnVAL, lbVAL, xDay, x2, prevVAL, i_valColor, 1, SOLID, "VAL", i_showVA, i_lblVAL)
    lnVAL := _i1, lbVAL := _i2

    [_j1, _j2] = drawLevel(lnPOC, lbPOC, xDay, x2, prevPOC, i_pocColor, 1, DASHED, "POC", i_showVA, i_lblPOC)
    lnPOC := _j1, lbPOC := _j2

    // Opening Range
    bool showOR = i_showOR and orComplete
    int orX1 = nz(orCompleteBar, xRTH)
    [_k1, _k2] = drawLevel(lnORH, lbORH, orX1, x2, orHigh, i_orHighColor, 1, DASHED, "ORH", showOR, i_lblORH)
    lnORH := _k1, lbORH := _k2
    [_l1, _l2] = drawLevel(lnORL, lbORL, orX1, x2, orLow, i_orLowColor, 1, DASHED, "ORL", showOR, i_lblORL)
    lnORL := _l1, lbORL := _l2
    [_m1, _m2] = drawLevel(lnORM, lbORM, orX1, x2, orMid, i_orMidColor, 1, DOTTED, "ORM", showOR, i_lblORM)
    lnORM := _m1, lbORM := _m2

    // Initial Balance
    bool showIB = i_showIB and ibComplete
    int ibX1 = nz(ibCompleteBar, xRTH)
    [_n1, _n2] = drawLevel(lnIBH, lbIBH, ibX1, x2, ibHigh, i_ibHighColor, 1, DASHED, "IBH", showIB, i_lblIBH)
    lnIBH := _n1, lbIBH := _n2
    [_o1, _o2] = drawLevel(lnIBL, lbIBL, ibX1, x2, ibLow, i_ibLowColor, 1, DASHED, "IBL", showIB, i_lblIBL)
    lnIBL := _o1, lbIBL := _o2
    [_p1, _p2] = drawLevel(lnIBM, lbIBM, ibX1, x2, ibMid, i_ibMidColor, 1, DOTTED, "IBM", showIB, i_lblIBM)
    lnIBM := _p1, lbIBM := _p2

    // VWAP label
    if i_showVWAP and not na(rthVWAP) and i_lblVWAP
        if na(lbVWAP)
            lbVWAP := label.new(x2 + i_labelOffset, rthVWAP, "VWAP  " + priceStr(rthVWAP), style=label.style_none, textcolor=i_vwapColor, size=getLabelSize())
        else
            label.set_xy(lbVWAP, x2 + i_labelOffset, rthVWAP)
            label.set_text(lbVWAP, "VWAP  " + priceStr(rthVWAP))
    else
        if not na(lbVWAP)
            label.delete(lbVWAP)
            lbVWAP := na

    // Mid label
    if i_showMid and not na(rthMidVal) and i_lblMid
        if na(lbMid)
            lbMid := label.new(x2 + i_labelOffset, rthMidVal, "MID  " + priceStr(rthMidVal), style=label.style_none, textcolor=i_midColor, size=getLabelSize())
        else
            label.set_xy(lbMid, x2 + i_labelOffset, rthMidVal)
            label.set_text(lbMid, "MID  " + priceStr(rthMidVal))
    else
        if not na(lbMid)
            label.delete(lbMid)
            lbMid := na

    // ═══ EXTENSIONS ═══
    for ln in extLines
        line.delete(ln)
    array.clear(extLines)
    for lb in extLabels
        label.delete(lb)
    array.clear(extLabels)

    float[] mults = array.from(i_ext1, i_ext2, i_ext3, i_ext4)

    if i_showORext and orComplete and not na(orCompleteBar)
        float orRange = orHigh - orLow
        for i = 0 to 3
            float m = array.get(mults, i)
            float lvlUp   = orHigh + orRange * m
            float lvlDown = orLow  - orRange * m
            array.push(extLines, line.new(math.max(orX1, x2 - 499), lvlUp, x2, lvlUp, color=i_extColor, style=line.style_dotted, width=1))
            array.push(extLabels, label.new(x2 + i_labelOffset, lvlUp, "OR +" + str.tostring(m * 100, "#") + "%  " + priceStr(lvlUp), style=label.style_none, textcolor=i_extColor, size=size.tiny))
            array.push(extLines, line.new(math.max(orX1, x2 - 499), lvlDown, x2, lvlDown, color=i_extColor, style=line.style_dotted, width=1))
            array.push(extLabels, label.new(x2 + i_labelOffset, lvlDown, "OR -" + str.tostring(m * 100, "#") + "%  " + priceStr(lvlDown), style=label.style_none, textcolor=i_extColor, size=size.tiny))

    if i_showIBext and ibComplete and not na(ibCompleteBar)
        float ibRange = ibHigh - ibLow
        for i = 0 to 3
            float m = array.get(mults, i)
            float lvlUp   = ibHigh + ibRange * m
            float lvlDown = ibLow  - ibRange * m
            array.push(extLines, line.new(math.max(ibX1, x2 - 499), lvlUp, x2, lvlUp, color=i_extColor, style=line.style_dotted, width=1))
            array.push(extLabels, label.new(x2 + i_labelOffset, lvlUp, "IB +" + str.tostring(m * 100, "#") + "%  " + priceStr(lvlUp), style=label.style_none, textcolor=i_extColor, size=size.tiny))
            array.push(extLines, line.new(math.max(ibX1, x2 - 499), lvlDown, x2, lvlDown, color=i_extColor, style=line.style_dotted, width=1))
            array.push(extLabels, label.new(x2 + i_labelOffset, lvlDown, "IB -" + str.tostring(m * 100, "#") + "%  " + priceStr(lvlDown), style=label.style_none, textcolor=i_extColor, size=size.tiny))
