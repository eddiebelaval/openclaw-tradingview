//@version=5
indicator(title='Nifty Market Pressure Dashboard Pro', overlay=false)

// INDEX
niftySymbol = input.symbol("NSE:NIFTY","Index")

// SYMBOLS + WEIGHTS

s1 = input.symbol("NSE:RELIANCE","RELIANCE INDUSTRIES LTD")
w1 = input.float(9.98,"Weight RELIANCE %")

s2 = input.symbol("NSE:HDFCBANK","HDFC BANK LTD")
w2 = input.float(6.87,"Weight HDFCBANK %")

s3 = input.symbol("NSE:BHARTIARTL","BHARTI AIRTEL LTD")
w3 = input.float(5.88,"Weight BHARTIARTL %")

s4 = input.symbol("NSE:SBIN","STATE BANK OF INDIA")
w4 = input.float(5.18,"Weight SBIN %")

s5 = input.symbol("NSE:ICICIBANK","ICICI BANK LTD")
w5 = input.float(4.87,"Weight ICICIBANK %")

s6 = input.symbol("NSE:TCS","TATA CONSULTANCY SERVICES LTD")
w6 = input.float(4.57,"Weight TCS %")

s7 = input.symbol("NSE:BAJFINANCE","BAJAJ FINANCE LTD")
w7 = input.float(2.85,"Weight BAJFINANCE %")

s8 = input.symbol("NSE:HINDUNILVR","HINDUSTAN UNILEVER LTD")
w8 = input.float(2.68,"Weight HINDUNILVR %")

s9 = input.symbol("NSE:INFY","INFOSYS LTD")
w9 = input.float(2.64,"Weight INFY %")

s10 = input.symbol("NSE:LT","LARSEN & TOUBRO LTD")
w10 = input.float(2.57,"Weight LT %")

s11 = input.symbol("NSE:SUNPHARMA","SUN PHARMACEUTICAL INDUSTRIES LTD")
w11 = input.float(2.27,"Weight SUNPHARMA %")

s12 = input.symbol("NSE:MARUTI","MARUTI SUZUKI INDIA LTD")
w12 = input.float(2.16,"Weight MARUTI %")

s13 = input.symbol("NSE:M_M","MAHINDRA & MAHINDRA LTD")
w13 = input.float(2.05,"Weight M&M %")

s14 = input.symbol("NSE:ITC","ITC LTD")
w14 = input.float(2.02,"Weight ITC %")

// CURRENT PRICE

p1=request.security(s1,"",close)
p2=request.security(s2,"",close)
p3=request.security(s3,"",close)
p4=request.security(s4,"",close)
p5=request.security(s5,"",close)
p6=request.security(s6,"",close)
p7=request.security(s7,"",close)
p8=request.security(s8,"",close)
p9=request.security(s9,"",close)
p10=request.security(s10,"",close)
p11=request.security(s11,"",close)
p12=request.security(s12,"",close)
p13=request.security(s13,"",close)
p14=request.security(s14,"",close)

// PREVIOUS CLOSE

pc1=request.security(s1,"D",close[1])
pc2=request.security(s2,"D",close[1])
pc3=request.security(s3,"D",close[1])
pc4=request.security(s4,"D",close[1])
pc5=request.security(s5,"D",close[1])
pc6=request.security(s6,"D",close[1])
pc7=request.security(s7,"D",close[1])
pc8=request.security(s8,"D",close[1])
pc9=request.security(s9,"D",close[1])
pc10=request.security(s10,"D",close[1])
pc11=request.security(s11,"D",close[1])
pc12=request.security(s12,"D",close[1])
pc13=request.security(s13,"D",close[1])
pc14=request.security(s14,"D",close[1])

// CHANGE %

c1=(p1-pc1)/pc1*100
c2=(p2-pc2)/pc2*100
c3=(p3-pc3)/pc3*100
c4=(p4-pc4)/pc4*100
c5=(p5-pc5)/pc5*100
c6=(p6-pc6)/pc6*100
c7=(p7-pc7)/pc7*100
c8=(p8-pc8)/pc8*100
c9=(p9-pc9)/pc9*100
c10=(p10-pc10)/pc10*100
c11=(p11-pc11)/pc11*100
c12=(p12-pc12)/pc12*100
c13=(p13-pc13)/pc13*100
c14=(p14-pc14)/pc14*100

// NIFTY PRICE

nifty=request.security(niftySymbol,"",close)

// CONTRIBUTION

con1=c1*w1/10000*nifty
con2=c2*w2/10000*nifty
con3=c3*w3/10000*nifty
con4=c4*w4/10000*nifty
con5=c5*w5/10000*nifty
con6=c6*w6/10000*nifty
con7=c7*w7/10000*nifty
con8=c8*w8/10000*nifty
con9=c9*w9/10000*nifty
con10=c10*w10/10000*nifty
con11=c11*w11/10000*nifty
con12=c12*w12/10000*nifty
con13=c13*w13/10000*nifty
con14=c14*w14/10000*nifty

// TABLE

var table t = table.new(position.bottom_right,4,20,bgcolor=color.white)

// HEADER

if barstate.islast
    table.cell(t,0,0,"Stock",bgcolor=color.orange)
    table.cell(t,1,0,"Contribution",bgcolor=color.orange)
    table.cell(t,2,0,"Type",bgcolor=color.orange)
    table.cell(t,3,0,"Change %",bgcolor=color.orange)

// FUNCTION

f_row(r,name,val,ch)=>

    col = ch >= 0 ? color.green : color.red

    table.cell(t,0,r,name)

    table.cell(
     t,1,r,
     str.tostring(val,"#.00"),
     text_color = col)

    table.cell(
     t,2,r,
     val>0?"Puller":"Dragger",
     text_color = col)

    table.cell(
     t,3,r,
     str.tostring(ch,"#.00")+"%",
     text_color = col)

// STOCK ROWS

f_row(1,"RELIANCE",con1,c1)
f_row(2,"HDFCBANK",con2,c2)
f_row(3,"BHARTIARTL",con3,c3)
f_row(4,"SBIN",con4,c4)
f_row(5,"ICICIBANK",con5,c5)
f_row(6,"TCS",con6,c6)
f_row(7,"BAJFINANCE",con7,c7)
f_row(8,"HINDUNILVR",con8,c8)
f_row(9,"INFY",con9,c9)
f_row(10,"LT",con10,c10)
f_row(11,"SUNPHARMA",con11,c11)
f_row(12,"MARUTI",con12,c12)
f_row(13,"M&M",con13,c13)
f_row(14,"ITC",con14,c14)

// =====================
// ANALYSIS SUMMARY
// =====================

puller =
 math.max(con1,0)+math.max(con2,0)+math.max(con3,0)+math.max(con4,0)+
 math.max(con5,0)+math.max(con6,0)+math.max(con7,0)+math.max(con8,0)+
 math.max(con9,0)+math.max(con10,0)+math.max(con11,0)+math.max(con12,0)+
 math.max(con13,0)+math.max(con14,0)

dragger =
 math.abs(math.min(con1,0))+math.abs(math.min(con2,0))+math.abs(math.min(con3,0))+math.abs(math.min(con4,0))+
 math.abs(math.min(con5,0))+math.abs(math.min(con6,0))+math.abs(math.min(con7,0))+math.abs(math.min(con8,0))+
 math.abs(math.min(con9,0))+math.abs(math.min(con10,0))+math.abs(math.min(con11,0))+math.abs(math.min(con12,0))+
 math.abs(math.min(con13,0))+math.abs(math.min(con14,0))

net = puller - dragger
total = puller + dragger
strength = total!=0 ? math.abs(net)/total*100 : 0

trend =
 net > 0 ? "BULLISH INDEX PRESSURE" :
 net < 0 ? "BEARISH INDEX PRESSURE" :
 "NEUTRAL MARKET"

// SUMMARY TABLE

table.cell(t,0,16,"Analysis",bgcolor=color.yellow)
table.cell(t,1,16,"Pullers "+str.tostring(puller,"#.00"))
table.cell(t,2,16,"Draggers "+str.tostring(dragger,"#.00"))
table.cell(t,3,16,"Strength "+str.tostring(strength,"#.0")+"%")

table.cell(t,0,17,"Market Bias")
table.cell(t,1,17,trend,text_color = net>0?color.green:net<0?color.red:color.gray)

Watermark = table.new(position.bottom_left, 1, 1, border_width=5)
table.cell(Watermark, 0, 0, text="Ⓒ www.appsportal.in", text_color=color.rgb(255,255,255,75), text_size=size.large)
