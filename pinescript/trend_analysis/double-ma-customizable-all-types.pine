//@version=5
//© Obside.com
indicator("Double MA Customizable - All Types", overlay = true, timeframe = "", timeframe_gaps = true)

// ───────── Inputs ─────────
src      = input.source(close, "Source")

maType1  = input.string("SMA", "MA 1 Type", options = ["SMA", "EMA", "WMA", "RMA", "HMA"])
length1  = input.int(50, "MA 1 Length", minval = 1)
color1   = input.color(color.new(color.blue, 0), "MA 1 Color")

maType2  = input.string("EMA", "MA 2 Type", options = ["SMA", "EMA", "WMA", "RMA", "HMA"])
length2  = input.int(200, "MA 2 Length", minval = 1)
color2   = input.color(color.new(color.red, 0), "MA 2 Color")

showRibbon = input.bool(true, "Show Ribbon Between MA 1 & MA 2")

// ───────── MA Function ─────────
f_ma(_type, _src, _len) =>
    switch _type
        "SMA" => ta.sma(_src, _len)
        "EMA" => ta.ema(_src, _len)
        "WMA" => ta.wma(_src, _len)
        "RMA" => ta.rma(_src, _len)
        "HMA" => ta.hma(_src, _len)

// ───────── Calculations ─────────
ma1 = f_ma(maType1, src, length1)
ma2 = f_ma(maType2, src, length2)

// ───────── Plot ─────────
p1 = plot(ma1, title = "MA 1", color = color1, linewidth = 2)
p2 = plot(ma2, title = "MA 2", color = color2, linewidth = 2)

// ───────── Ribbon Fill ─────────
ribbonColor = ma1 > ma2 ? color.new(color.green, 80) : color.new(color.red, 80)
fill(p1, p2, color = showRibbon ? ribbonColor : na)
