//@version=5
indicator("Ultra Smooth Averaged Heikin Ashi + MTF Table 1-10", overlay = true, max_bars_back = 5000)

//————————————————————————————————————————————————————————————
// Inputs
//————————————————————————————————————————————————————————————
len      = input.int(50, "Primary Smoothing Length", minval = 1)
len2     = input.int(60, "Secondary Smoothing Length", minval = 1)
// Replaced CMA with LWMA
method   = input.string("EMA", "Primary Smoothing", options = ["None", "SMA", "EMA", "RMA", "WMA", "TEMA", "LWMA"])
method2  = input.string("EMA", "Secondary Smoothing", options = ["None", "SMA", "EMA", "RMA", "WMA", "TEMA", "LWMA"])

boostLen = input.int(50, "Boost Lookback", minval = 1)

showRaw  = input.bool(false, "Show Raw Heikin Ashi (unsmoothed)")
bullCol  = input.color(color.new(color.green, 0), "Bull Candle Color")
bearCol  = input.color(color.new(color.red,   0), "Bear Candle Color")

showTable = input.bool(true, "Show MTF Table", group="MTF Table")
tablePos  = input.string("top_right", "Position", options=["top_right", "bottom_right", "top_left", "bottom_left"], group="MTF Table")

//————————————————————————————————————————————————————————————
// Global Smoothing Functions
//————————————————————————————————————————————————————————————
f_tema(src, _len) =>
    ema1 = ta.ema(src, _len)
    ema2 = ta.ema(ema1, _len)
    ema3 = ta.ema(ema2, _len)
    (3 * ema1) - (3 * ema2) + ema3

// Manual Linear Weighted Moving Average (LWMA) logic
f_lwma(src, _len) =>
    sum = 0.0
    weightSum = 0.0
    for i = 0 to _len - 1
        weight = _len - i
        sum += src[i] * weight
        weightSum += weight
    sum / weightSum

// Updated smoothing function with LWMA replacing CMA
f_smooth(src, _method, _len) =>
    _method == "SMA"   ? ta.sma(src, _len)  : 
     _method == "EMA"   ? ta.ema(src, _len)  : 
     _method == "RMA"   ? ta.rma(src, _len)  : 
     _method == "WMA"   ? ta.wma(src, _len)  : 
     _method == "TEMA"  ? f_tema(src, _len) : 
     _method == "LWMA"  ? f_lwma(src, _len) : src

//————————————————————————————————————————————————————————————
// MTF Calculation Function
//————————————————————————————————————————————————————————————
f_get_direction() =>
    haClose = (open + high + low + close) / 4.0
    var float haOpen = na
    haOpen := na(haOpen[1]) ? (open + close) / 2.0 : (haOpen[1] + haClose[1]) / 2.0
    
    haOpenSm  = f_smooth(haOpen,  method, len)
    haCloseSm = f_smooth(haClose, method, len)
    haOpen2   = f_smooth(haOpenSm,  method2, len2)
    haClose2  = f_smooth(haCloseSm, method2, len2)

    dynamicWeight = 1.0

    haOpenUltra  = haOpen2  * dynamicWeight + haOpenSm  * (1 - dynamicWeight)
    haCloseUltra = haClose2 * dynamicWeight + haCloseSm * (1 - dynamicWeight)
    
    haCloseUltra >= haOpenUltra ? 1 : 0 

//————————————————————————————————————————————————————————————
// MTF Requests
//————————————————————————————————————————————————————————————
dir1  = request.security(syminfo.tickerid, "1",  f_get_direction())
dir2  = request.security(syminfo.tickerid, "2",  f_get_direction())
dir3  = request.security(syminfo.tickerid, "3",  f_get_direction())
dir4  = request.security(syminfo.tickerid, "4",  f_get_direction())
dir5  = request.security(syminfo.tickerid, "5",  f_get_direction())
dir6  = request.security(syminfo.tickerid, "6",  f_get_direction())
dir7  = request.security(syminfo.tickerid, "7",  f_get_direction())
dir8  = request.security(syminfo.tickerid, "8",  f_get_direction())
dir9  = request.security(syminfo.tickerid, "9",  f_get_direction())
dir10 = request.security(syminfo.tickerid, "10", f_get_direction())

// Main Chart Logic
isBullish = f_get_direction()
col = isBullish == 1 ? bullCol : bearCol

haCloseMain = (open + high + low + close) / 4.0
var float haOpenMain = na
haOpenMain := na(haOpenMain[1]) ? (open + close) / 2.0 : (haOpenMain[1] + haCloseMain[1]) / 2.0

hOSm = f_smooth(haOpenMain, method, len)
hCSm = f_smooth(haCloseMain, method, len)
hO2  = f_smooth(hOSm, method2, len2)
hC2  = f_smooth(hCSm, method2, len2)

dW = 1.0
hOUltra = hO2 * dW + hOSm * (1 - dW)
hCUltra = hC2 * dW + hCSm * (1 - dW)

//————————————————————————————————————————————————————————————
// Visuals & Table
//————————————————————————————————————————————————————————————
plotcandle(showRaw ? haOpenMain : na, high, low, showRaw ? haCloseMain : na, "Raw HA", color.new(color.gray, 65))
plotcandle(hOUltra, math.max(hOUltra, hCUltra), math.min(hOUltra, hCUltra), hCUltra, "Ultra Smooth HA", col, wickcolor=col, bordercolor=col)

var table_id = table.new(tablePos == "top_right" ? position.top_right : tablePos == "bottom_right" ? position.bottom_right : tablePos == "top_left" ? position.top_left : position.bottom_left, 11, 2, border_width = 1)

if showTable and barstate.islast
    table.cell(table_id, 0, 0, "TF", bgcolor = color.gray, text_color = color.white)
    for i = 1 to 10
        table.cell(table_id, i, 0, str.tostring(i) + "m", bgcolor = color.gray, text_color = color.white)
    
    table.cell(table_id, 0, 1, "DIR", bgcolor = color.gray, text_color = color.white)
    
    // Fill directions
    table.cell(table_id, 1, 1, dir1 == 1 ? "▲" : "▼", bgcolor = dir1 == 1 ? color.green : color.red, text_color = color.white)
    table.cell(table_id, 2, 1, dir2 == 1 ? "▲" : "▼", bgcolor = dir2 == 1 ? color.green : color.red, text_color = color.white)
    table.cell(table_id, 3, 1, dir3 == 1 ? "▲" : "▼", bgcolor = dir3 == 1 ? color.green : color.red, text_color = color.white)
    table.cell(table_id, 4, 1, dir4 == 1 ? "▲" : "▼", bgcolor = dir4 == 1 ? color.green : color.red, text_color = color.white)
    table.cell(table_id, 5, 1, dir5 == 1 ? "▲" : "▼", bgcolor = dir5 == 1 ? color.green : color.red, text_color = color.white)
    table.cell(table_id, 6, 1, dir6 == 1 ? "▲" : "▼", bgcolor = dir6 == 1 ? color.green : color.red, text_color = color.white)
    table.cell(table_id, 7, 1, dir7 == 1 ? "▲" : "▼", bgcolor = dir7 == 1 ? color.green : color.red, text_color = color.white)
    table.cell(table_id, 8, 1, dir8 == 1 ? "▲" : "▼", bgcolor = dir8 == 1 ? color.green : color.red, text_color = color.white)
    table.cell(table_id, 9, 1, dir9 == 1 ? "▲" : "▼", bgcolor = dir9 == 1 ? color.green : color.red, text_color = color.white)
    table.cell(table_id, 10, 1, dir10 == 1 ? "▲" : "▼", bgcolor = dir10 == 1 ? color.green : color.red, text_color = color.white)
