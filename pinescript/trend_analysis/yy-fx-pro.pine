//@version=5
indicator("YY GOD MODE FINAL", overlay=true)

// 1. AYARLAR
float rr = 2.0
float a = ta.atr(14)

// 2. ANALİZ (LİKİDİTE VE YAPI)
hi = ta.highest(high, 20)[1]
lo = ta.lowest(low, 20)[1]
sw_b = low < lo and close > lo
sw_s = high > hi and close < hi
m_u = ta.crossover(close, ta.highest(high, 5)[1])
m_d = ta.crossunder(close, ta.lowest(low, 5)[1])

// 3. SİNYAL MANTIĞI
var int lb = 0
var float sl = 0.0
var float tp = 0.0

buy = (sw_b or m_u) and close > open and bar_index > lb + 5
sell = (sw_s or m_d) and close < open and bar_index > lb + 5

if buy
    lb := bar_index
    sl := low - (a * 0.2)
    tp := close + ((close - sl) * rr)

if sell
    lb := bar_index
    sl := high + (a * 0.2)
    tp := close - ((sl - close) * rr)

// 4. ÇİZİMLER (EN KISA KOMUTLARLA)
plotshape(buy, "B", shape.labelup, location.belowbar, color.green, 0, "BUY", color.white)
plotshape(sell, "S", shape.labeldown, location.abovebar, color.red, 0, "SELL", color.white)

var line l1 = na
var line l2 = na
if buy or sell
    line.delete(l1)
    line.delete(l2)
    l1 := line.new(bar_index, sl, bar_index + 10, sl, color=color.red)
    l2 := line.new(bar_index, tp, bar_index + 10, tp, color=color.green)
