//@version=6
indicator("EBP + Fib", overlay = true)

// =========================
// USER INPUTS
// =========================
fibLength = input.int(5, "Fib Extension Length (bars)", minval = 1)

lineWidth      = input.int(2, "Line Width", minval = 1, maxval = 5)
lineStyleInput = input.string("Dotted", "Line Style", options = ["Solid", "Dashed", "Dotted"])
opacity        = input.int(0, "Opacity (0-100)", minval = 0, maxval = 100)

bullColor = input.color(color.green, "Bullish Sweep Candle Color")
bearColor = input.color(color.red,   "Bearish Sweep Candle Color")

// Label text size input
textSizeInput = input.string("Normal", "Fib Label Text Size", 
     options = ["Tiny", "Small", "Normal", "Large", "Huge"])

// Label horizontal placement input
labelPosInput = input.string("Right", "Fib Label Position", 
     options = ["Left", "Middle", "Right"])

// Space between line + label (in ticks, vertical)
labelOffset = input.float(7, "Label Offset (ticks)", step = 0.1)

// Individual Fib Level Colors
c_m50  = input.color(color.blue,     "-0.5 Color")
c_m25  = input.color(color.blue,  "-0.25 Color")
c_0    = input.color(color.black,   "0 Color")
c_25   = input.color(color.blue,  "0.25 Color")
c_50   = input.color(color.black,   "0.5 Color")
c_65   = input.color(color.blue,    "0.65 Color")
c_75   = input.color(color.blue,    "0.75 Color")
c_100  = input.color(color.black,  "1 Color")

// =========================
// STYLE CONVERSIONS
// =========================
lineStyle = switch lineStyleInput
    "Solid"  => line.style_solid
    "Dashed" => line.style_dashed
    => line.style_dotted

labelSize = switch textSizeInput
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large
    => size.huge

labelStylePos = switch labelPosInput
    "Left"   => label.style_label_left
    "Middle" => label.style_label_center
    => label.style_label_right

// =========================
// TIMEFRAME FORMATTER
// =========================
f_formatTf(tf) =>
    string result = tf
    float tfNum   = str.tonumber(tf)
    if not na(tfNum)
        int mins = int(math.round(tfNum))
        if mins < 60
            result := str.tostring(mins) + "m"
        else if mins % 60 == 0
            int hours = mins / 60
            result := str.tostring(hours) + "h"
        else
            result := str.tostring(mins) + "m"
    else
        string up = str.upper(tf)
        if up == "D" or up == "1D"
            result := "1D"
        else if up == "W" or up == "1W"
            result := "1W"
        else if up == "M" or up == "1M"
            result := "1M"
    result

// =========================
// EBP LOGIC
// =========================
bullishSweep = low < low[1] and close > open[1] and close > close[1]
bearishSweep = high > high[1] and close < open[1] and close < close[1]

// =========================
// STORE MOST RECENT EBP
// =========================
var float anchorHigh = na
var float anchorLow  = na
var int   anchorBar  = na
var bool  anchorBull = false

if bullishSweep
    anchorHigh := high
    anchorLow  := low
    anchorBar  := bar_index
    anchorBull := true

if bearishSweep
    anchorHigh := high
    anchorLow  := low
    anchorBar  := bar_index
    anchorBull := false

// =========================
// DELETE OLD FIB OBJECTS
// =========================
var line[]  fibLines  = array.new_line()
var label[] fibLabels = array.new_label()

if bullishSweep or bearishSweep
    if array.size(fibLines) > 0
        for i = 0 to array.size(fibLines) - 1
            line.delete(array.get(fibLines, i))

    if array.size(fibLabels) > 0
        for i = 0 to array.size(fibLabels) - 1
            label.delete(array.get(fibLabels, i))

    array.clear(fibLines)
    array.clear(fibLabels)

// =========================
// FIB LEVELS (1.0 at anchor extreme, 0 at opposite,
// negatives extend beyond 0)
// =========================
levels = array.from(1.0, 0.75, 0.65, 0.5, 0.25, 0.0, -0.25, -0.5)
colors = array.from(c_100, c_75, c_65, c_50, c_25, c_0, c_m25, c_m50)

// =========================
// DRAW INVERTED FIB
// =========================
if not na(anchorBar)
    float priceRange = anchorHigh - anchorLow

    if priceRange != 0
        int xLeft  = anchorBar
        int xRight = anchorBar + fibLength
        int xMid   = anchorBar + int(math.round(fibLength / 2.0))

        for i = 0 to array.size(levels) - 1
            float lvl       = array.get(levels, i)
            color baseColor = array.get(colors, i)
            color col       = color.new(baseColor, opacity)

            float price = na

            if anchorBull
                // Bullish: 1.0 at LOW, 0.0 at HIGH, negatives ABOVE high
                price := anchorHigh - priceRange * lvl
            else
                // Bearish: 1.0 at HIGH, 0.0 at LOW, negatives BELOW low
                price := anchorLow + priceRange * lvl

            int labelX = xRight
            if labelPosInput == "Left"
                labelX := xLeft
            else if labelPosInput == "Middle"
                labelX := xMid

            float priceLabel = price + labelOffset * syminfo.mintick

            line newLine = line.new(
                x1 = anchorBar,
                y1 = price,
                x2 = anchorBar + fibLength,
                y2 = price,
                width = lineWidth,
                style = lineStyle,
                color = col
            )

            label newLabel = label.new(
                x = labelX,
                y = priceLabel,
                text = str.tostring(lvl),
                style = labelStylePos,
                textcolor = baseColor,
                color = color.new(color.black, 100),
                size = labelSize
            )

            array.push(fibLines, newLine)
            array.push(fibLabels, newLabel)

// =========================
// CANDLE COLORING
// =========================
barcolor(
     bullishSweep ? bullColor :
     bearishSweep ? bearColor :
     na
)

// =========================
// ALERTS
// =========================
string tfStr   = f_formatTf(timeframe.period)
string bullMsg = "Bullish " + syminfo.ticker + " " + tfStr + " EBP"
string bearMsg = "Bearish " + syminfo.ticker + " " + tfStr + " EBP"

// alertcondition must use const strings
alertcondition(bullishSweep, title = "Bullish Sweep", message = "Bullish EBP Triggered")
alertcondition(bearishSweep, title = "Bearish Sweep", message = "Bearish EBP Triggered")

// Dynamic alert text
if bullishSweep
    alert(bullMsg, alert.freq_once_per_bar_close)

if bearishSweep
    alert(bearMsg, alert.freq_once_per_bar_close)
