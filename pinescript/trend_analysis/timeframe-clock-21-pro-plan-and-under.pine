c11 = request.security(syminfo.tickerid, "1M",  close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

// Slots 12-15 reuse existing data — no extra calls
o12 = o9
c12 = c9
o13 = o10
c13 = c10
o14 = o11
c14 = c11
o15 = o10
c15 = c10

// High and low use close as fallback — saves 22 calls
h1  = c1
l1  = c1
h2  = c2
l2  = c2
h3  = c3
l3  = c3
h4  = c4
l4  = c4
h5  = c5
l5  = c5
h6  = c6
l6  = c6
h7  = c7
l7  = c7
h8  = c8
l8  = c8
h9  = c9
l9  = c9
h10 = c10
l10 = c10
h11 = c11
l11 = c11
