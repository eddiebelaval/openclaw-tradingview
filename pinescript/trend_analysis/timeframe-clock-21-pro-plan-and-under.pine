// ════════════════════════════════════════
show_label  = input.bool(true,  "Show TF Label Row",      group="── Row Toggles ──")
show_dir    = input.bool(true,  "Show Direction Row",     group="── Row Toggles ──")
show_open   = input.bool(true,  "Show Open Price Row",    group="── Row Toggles ──")
show_high   = input.bool(false, "Show High Price Row",    group="── Row Toggles ──")
