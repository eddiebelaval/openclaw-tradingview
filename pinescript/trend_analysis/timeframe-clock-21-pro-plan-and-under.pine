// ════════════════════════════════════════
// REQUIRED PLOT
// ════════════════════════════════════════
plot(close, "Price", color=color.new(color.white,100), display=display.none)

// ════════════════════════════════════════
// BUILD TABLE
// ════════════════════════════════════════
if barstate.islast or barstate.isrealtime

    mins_arr = array.new_int()
    bg_arr   = array.new_color()
    txt_arr  = array.new_color()
    o_arr    = array.new_float()
    h_arr    = array.new_float()
    l_arr    = array.new_float()
    c_arr    = array.new_float()

    if s1_on
        array.push(mins_arr, s1_min)
        array.push(bg_arr, s1_bg)
        array.push(txt_arr, s1_txt)
        array.push(o_arr, o1)
        array.push(h_arr, h1)
        array.push(l_arr, l1)
        array.push(c_arr, c1)
    if s2_on
        array.push(mins_arr, s2_min)
        array.push(bg_arr, s2_bg)
        array.push(txt_arr, s2_txt)
        array.push(o_arr, o2)
        array.push(h_arr, h2)
        array.push(l_arr, l2)
        array.push(c_arr, c2)
    if s3_on
        array.push(mins_arr, s3_min)
        array.push(bg_arr, s3_bg)
        array.push(txt_arr, s3_txt)
        array.push(o_arr, o3)
        array.push(h_arr, h3)
        array.push(l_arr, l3)
        array.push(c_arr, c3)
    if s4_on
        array.push(mins_arr, s4_min)
        array.push(bg_arr, s4_bg)
        array.push(txt_arr, s4_txt)
        array.push(o_arr, o4)
        array.push(h_arr, h4)
        array.push(l_arr, l4)
        array.push(c_arr, c4)
    if s5_on
        array.push(mins_arr, s5_min)
        array.push(bg_arr, s5_bg)
        array.push(txt_arr, s5_txt)
        array.push(o_arr, o5)
        array.push(h_arr, h5)
        array.push(l_arr, l5)
        array.push(c_arr, c5)
    if s6_on
        array.push(mins_arr, s6_min)
        array.push(bg_arr, s6_bg)
        array.push(txt_arr, s6_txt)
        array.push(o_arr, o6)
        array.push(h_arr, h6)
        array.push(l_arr, l6)
        array.push(c_arr, c6)
    if s7_on
        array.push(mins_arr, s7_min)
        array.push(bg_arr, s7_bg)
        array.push(txt_arr, s7_txt)
        array.push(o_arr, o7)
        array.push(h_arr, h7)
        array.push(l_arr, l7)
        array.push(c_arr, c7)
    if s8_on
        array.push(mins_arr, s8_min)
        array.push(bg_arr, s8_bg)
        array.push(txt_arr, s8_txt)
        array.push(o_arr, o8)
        array.push(h_arr, h8)
        array.push(l_arr, l8)
        array.push(c_arr, c8)
    if s9_on
        array.push(mins_arr, s9_min)
        array.push(bg_arr, s9_bg)
        array.push(txt_arr, s9_txt)
        array.push(o_arr, o9)
        array.push(h_arr, h9)
        array.push(l_arr, l9)
        array.push(c_arr, c9)
    if s10_on
        array.push(mins_arr, s10_min)
        array.push(bg_arr, s10_bg)
        array.push(txt_arr, s10_txt)
        array.push(o_arr, o10)
        array.push(h_arr, h10)
        array.push(l_arr, l10)
        array.push(c_arr, c10)
    if s11_on
        array.push(mins_arr, s11_min)
        array.push(bg_arr, s11_bg)
        array.push(txt_arr, s11_txt)
        array.push(o_arr, o11)
        array.push(h_arr, h11)
        array.push(l_arr, l11)
        array.push(c_arr, c11)
    if s12_on
        array.push(mins_arr, s12_min)
        array.push(bg_arr, s12_bg)
        array.push(txt_arr, s12_txt)
        array.push(o_arr, o12)
        array.push(h_arr, h12)
        array.push(l_arr, l12)
        array.push(c_arr, c12)
    if s13_on
        array.push(mins_arr, s13_min)
        array.push(bg_arr, s13_bg)
        array.push(txt_arr, s13_txt)
        array.push(o_arr, o13)
        array.push(h_arr, h13)
        array.push(l_arr, l13)
        array.push(c_arr, c13)
    if s14_on
        array.push(mins_arr, s14_min)
        array.push(bg_arr, s14_bg)
        array.push(txt_arr, s14_txt)
        array.push(o_arr, o14)
        array.push(h_arr, h14)
        array.push(l_arr, l14)
        array.push(c_arr, c14)
    if s15_on
        array.push(mins_arr, s15_min)
        array.push(bg_arr, s15_bg)
        array.push(txt_arr, s15_txt)
        array.push(o_arr, o15)
        array.push(h_arr, h15)
        array.push(l_arr, l15)
        array.push(c_arr, c15)

    n_cols = array.size(mins_arr)

    if n_cols > 0
        n_rows = 1
        if show_label
            n_rows := n_rows + 1
        if show_dir
            n_rows := n_rows + 1
        if show_open
            n_rows := n_rows + 1
        if show_high
            n_rows := n_rows + 1
        if show_low
            n_rows := n_rows + 1
        if show_close
            n_rows := n_rows + 1
        if show_pct
            n_rows := n_rows + 1
        if show_bar
            n_rows := n_rows + 1

        t = table.new(get_pos(table_pos), n_cols, n_rows,
             bgcolor=col_tbl_bg,
             border_color=col_border,
             border_width=1,
             frame_color=col_border,
             frame_width=1)

        for col = 0 to n_cols - 1
            tf       = array.get(mins_arr, col)
            slot_bg  = array.get(bg_arr,   col)
            slot_txt = array.get(txt_arr,  col)
            o_val    = array.get(o_arr,    col)
            h_val    = array.get(h_arr,    col)
            l_val    = array.get(l_arr,    col)
            c_val    = array.get(c_arr,    col)

            remain   = get_remain(tf)
            pct_done = get_pct(tf)
            pct_left = math.round(100 - pct_done, 1)
            tcol     = get_tcol(tf)
            syncing  = is_sync(tf)
            lbl      = fmt_lbl(tf)
            cdown    = fmt_time(remain)
            prog     = fmt_prog(pct_done)
            pct_s    = str.tostring(pct_left) + "%"

            is_bull  = c_val >= o_val
            is_bear  = c_val < o_val
            dir_s    = is_bull ? "▲" : is_bear ? "▼" : "—"
            dir_c    = is_bull ? col_bull  : is_bear ? col_bear  : col_doji
            dir_bg   = is_bull ? color.new(color.green, 85) : is_bear ? color.new(color.red, 85) : color.new(color.gray, 85)

            cell_bg  = syncing ? color.new(col_sync, 50) : slot_bg
            time_col = syncing ? col_sync : tcol

            // close vs open color
            close_col = c_val > o_val ? col_bull : c_val < o_val ? col_bear : col_doji

            row = 0

            if show_label
                table.cell(t, col, row, lbl,
                     text_color=col_hdr_txt, bgcolor=col_hdr_bg,
                     text_size=txt_sz, text_halign=text.align_center)
                row := row + 1

            // Countdown always shown
            table.cell(t, col, row, cdown,
                 text_color=time_col, bgcolor=cell_bg,
                 text_size=txt_sz, text_halign=text.align_center)
            row := row + 1

            if show_dir
                table.cell(t, col, row, dir_s,
                     text_color=dir_c, bgcolor=dir_bg,
                     text_size=txt_sz, text_halign=text.align_center)
                row := row + 1

            if show_open and not is_compact
                table.cell(t, col, row, "O " + fmt_price(o_val),
                     text_color=col_open_r, bgcolor=cell_bg,
                     text_size=ohlc_sz, text_halign=text.align_center)
                row := row + 1

            if show_high and is_full
                table.cell(t, col, row, "H " + fmt_price(h_val),
                     text_color=col_high_r, bgcolor=cell_bg,
                     text_size=ohlc_sz, text_halign=text.align_center)
                row := row + 1

            if show_low and is_full
                table.cell(t, col, row, "L " + fmt_price(l_val),
                     text_color=col_low_r, bgcolor=cell_bg,
                     text_size=ohlc_sz, text_halign=text.align_center)
                row := row + 1

            if show_close and not is_compact
                table.cell(t, col, row, "C " + fmt_price(c_val),
                     text_color=close_col, bgcolor=cell_bg,
                     text_size=ohlc_sz, text_halign=text.align_center)
                row := row + 1

            if show_pct and not is_compact
                table.cell(t, col, row, pct_s,
                     text_color=time_col, bgcolor=cell_bg,
                     text_size=txt_sz, text_halign=text.align_center)
                row := row + 1

            if show_bar and is_full
                table.cell(t, col, row, prog,
                     text_color=time_col, bgcolor=cell_bg,
                     text_size=size.tiny, text_halign=text.align_center)
