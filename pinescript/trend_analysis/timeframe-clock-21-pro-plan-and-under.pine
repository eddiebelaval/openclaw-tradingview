col_high_r  = input.color(color.red,                 "High Row Font",       group="── Global Colors ──")
col_low_r   = input.color(color.green,               "Low Row Font",        group="── Global Colors ──")
col_close_r = input.color(color.white,               "Close Row Font",      group="── Global Colors ──")

