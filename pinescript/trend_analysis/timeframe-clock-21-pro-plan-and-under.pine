c8  = request.security(syminfo.tickerid, "720", close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
o9  = request.security(syminfo.tickerid, "1D",  open,  lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
c9  = request.security(syminfo.tickerid, "1D",  close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
