//@version=6
indicator(title="Timeframe Clock", shorttitle="TF Clock", overlay=true)

// ════════════════════════════════════════
// TIMEFRAME COUNTDOWN CLOCK
// With OHLC per timeframe
// Full style control
// 15 slots individually configurable
// ════════════════════════════════════════

// ════════════════════════════════════════
// TABLE SETTINGS
// ════════════════════════════════════════
table_pos = input.string("Bottom Center", "Table Position",
     options=["Top Left","Top Center","Top Right",
              "Middle Left","Middle Center","Middle Right",
              "Bottom Left","Bottom Center","Bottom Right"],
     group="── Table ──")

tbl_size  = input.string("Tiny", "Font Size",
     options=["Tiny","Small","Normal","Large"],
     group="── Table ──")

ohlc_size = input.string("Tiny", "OHLC Row Font Size",
     options=["Tiny","Small","Normal","Large"],
     group="── Table ──")

tbl_mode  = input.string("Compact", "Table Mode",
     options=["Compact","Normal","Full"],
     group="── Table ──")

