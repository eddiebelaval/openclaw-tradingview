s15_txt = input.color(color.white,                "Font Color", group="── Slot 15 ──")

// ════════════════════════════════════════
// HELPERS
// ════════════════════════════════════════
get_pos(p) =>
    switch p
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.bottom_center

get_sz(s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

txt_sz     = get_sz(tbl_size)
ohlc_sz    = get_sz(ohlc_size)
is_compact = tbl_mode == "Compact"
is_full    = tbl_mode == "Full"

fmt_lbl(m) =>
    m >= 10080 ? str.tostring(m / 10080) + "W" : m >= 1440 ? str.tostring(m / 1440) + "D" : m >= 60 ? str.tostring(m / 60) + "H" : str.tostring(m) + "M"

get_remain(tf_m) =>
    tf_ms      = tf_m * 60 * 1000
    elapsed_ms = timenow % tf_ms
    remain_ms  = tf_ms - elapsed_ms
    math.floor(remain_ms / 1000)

get_pct(tf_m) =>
    tf_ms      = tf_m * 60 * 1000
    elapsed_ms = timenow % tf_ms
    math.round(elapsed_ms / tf_ms * 100, 1)

fmt_time(secs) =>
    h  = math.floor(secs / 3600)
    m  = math.floor((secs % 3600) / 60)
    s  = secs % 60
    ss = s < 10 ? "0" + str.tostring(s) : str.tostring(s)
    mm = m < 10 ? "0" + str.tostring(m) : str.tostring(m)
    h > 0 ? str.tostring(h) + ":" + mm + ":" + ss : str.tostring(m) + ":" + ss

fmt_prog(pct) =>
    filled = math.round(pct / 10)
    e      = 10 - filled
    b      = ""
    for i = 0 to filled - 1
        b := b + "█"
    for i = 0 to e - 1
        b := b + "░"
    b

get_tcol(tf_m) =>
    pct_left = 100 - get_pct(tf_m)
    pct_left <= 20 ? col_hot : pct_left <= 50 ? col_warm : col_cool

is_sync(tf_m) =>
    get_remain(tf_m) <= 60

fmt_price(p) =>
    str.tostring(p, "#.##")

// ════════════════════════════════════════
// OHLC PER TIMEFRAME
// Pull live data from each TF
// ════════════════════════════════════════
// ════════════════════════════════════════
// OHLC PER TIMEFRAME
// Only close and open needed for direction
// Reduces calls significantly
// ════════════════════════════════════════
o1  = request.security(syminfo.tickerid, "15",  open,  lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
c1  = request.security(syminfo.tickerid, "15",  close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
