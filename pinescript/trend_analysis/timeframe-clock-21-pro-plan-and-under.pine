show_close  = input.bool(true,  "Show Close Price Row",   group="── Row Toggles ──")
show_pct    = input.bool(true,  "Show Percent Row",       group="── Row Toggles ──")
show_bar    = input.bool(true,  "Show Progress Bar Row",  group="── Row Toggles ──")

