//@version=5
indicator(" TIKOLE S.P.RSI Divergence + RSI EMA + PSAR + MTF Panel", overlay=false, max_bars_back=500)

//// ================= INPUTs =================
inputgroup = "********** INPUTs **********"
shdiv    = input.bool(true, "Show Divergences", group=inputgroup)
shpoints = input.bool(true, "Show Points", group=inputgroup)

//// ALERTs
alertgroup = "********** ALERTs **********"
i_detectLongs  = input(true, "Detect Longs", group=alertgroup)
i_detectShorts = input(true, "Detect Shorts", group=alertgroup)

//// RSI
rsigroup = "********** RSI **********"
rsiLen = input.int(14, "RSI Length", group=rsigroup)
emaLen = input.int(21, "RSI EMA Length", group=rsigroup)
src    = input(close, "Source", group=rsigroup)

//// ================= RSI =================
up   = ta.rma(math.max(ta.change(src), 0), rsiLen)
down = ta.rma(-math.min(ta.change(src), 0), rsiLen)
rsi  = down == 0 ? 100 : up == 0 ? 0 : 100 - 100 / (1 + up / down)

rsiEma = ta.ema(rsi, emaLen)
rsiMa  = ta.sma(rsi, 14)

//// ================= PSAR =================
sar = ta.sar(0.02, 0.02, 0.2)

//// ================= PLOTS =================
plot(rsi, "RSI",
     color = close > sar ? color.green : color.red,
     linewidth=2)

plot(rsiEma, "RSI EMA", color=color.orange, linewidth=2)
plot(rsiMa,  "RSI SMA", color=color.yellow, linewidth=2)

fill(plot(rsi), plot(rsiMa),
     color = rsi > rsiMa ? color.new(color.green,70) : color.new(color.red,70))

//// ================= LEVELS =================
hline(70)
hline(50)
hline(30)

//// ================= DIVERGENCE =================
length = input.int(21, "Pivot Length")

ph = ta.pivothigh(rsi, length, length)
pl = ta.pivotlow(rsi, length, length)

valH  = ta.valuewhen(ph, rsi[length], 0)
valpH = ta.valuewhen(ph, rsi[length], 1)
valL  = ta.valuewhen(pl, rsi[length], 0)
valpL = ta.valuewhen(pl, rsi[length], 1)

bearDiv = ph and valH < valpH
bullDiv = pl and valL > valpL

if bearDiv and shdiv and i_detectShorts
    label.new(bar_index[length], rsi[length], "Bear Div",
      style=label.style_label_down, color=color.red, textcolor=color.white)

if bullDiv and shdiv and i_detectLongs
    label.new(bar_index[length], rsi[length], "Bull Div",
      style=label.style_label_up, color=color.green, textcolor=color.white)

//// ================= ALERTS =================
alertcondition(bullDiv, "Bullish Divergence")
alertcondition(bearDiv, "Bearish Divergence")

//// ================= MTF RSI PANEL =================
ob = 70
os = 30

f_color(r) =>
    if r >= ob
        #f30404
    else if r <= os
        color.rgb(8, 241, 35)
    else
        color.rgb(240, 241, 248)

rsi1 = request.security(syminfo.tickerid, "1",  ta.rsi(close, rsiLen))
rsi3 = request.security(syminfo.tickerid, "3",  ta.rsi(close, rsiLen))
rsi5 = request.security(syminfo.tickerid, "5",  ta.rsi(close, rsiLen))
rsi15= request.security(syminfo.tickerid, "15", ta.rsi(close, rsiLen))

var table t = table.new(position.bottom_right, 2, 5)

if barstate.islast
    table.cell(t, 0, 0, "TIME.F")
    table.cell(t, 1, 0, "RSI")

    table.cell(t, 0, 1, "1m")
    table.cell(t, 1, 1, str.tostring(rsi1,"0.0"), bgcolor=f_color(rsi1))

    table.cell(t, 0, 2, "3m")
    table.cell(t, 1, 2, str.tostring(rsi3,"0.0"), bgcolor=f_color(rsi3))

    table.cell(t, 0, 3, "5m")
    table.cell(t, 1, 3, str.tostring(rsi5,"0.0"), bgcolor=f_color(rsi5))

    table.cell(t, 0, 4, "15m")
    table.cell(t, 1, 4, str.tostring(rsi15,"0.0"), bgcolor=f_color(rsi15))//// ================= ADX & DI+ SECTION =================
adx_grp    = "********** ADX & DI+ **********"
adxLen     = input.int(14, "ADX Smoothing", group=adx_grp)
diLen      = input.int(14, "DI Length", group=adx_grp)
adx_threshold = input.int(25, "ADX Threshold Line", group=adx_grp)

// ADX aur DI ki calculation
[plusDI, minusDI, adxValue] = ta.dmi(diLen, adxLen)

// Plots
plot(adxValue, "ADX (25)", color=color.new(#ffffff, 0), linewidth=2, title="ADX Line")
plot(plusDI, "DI+", color=color.new(#00ff00, 0), linewidth=1, style=plot.style_linebr, title="DI+ Line")

// 25 Level ki fixed line (Trend Strength Filter)
hline(adx_threshold, "ADX 25 Level", color=color.gray, linestyle=hline.style_dashed)

// ADX 25 ke upar ho toh background highlight (Optional)
// bgcolor(adxValue > adx_threshold ? color.new(color.yellow, 90) : na)
