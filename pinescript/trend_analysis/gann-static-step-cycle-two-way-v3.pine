//@version=6
indicator('Gann Static Step-Cycle (Two-Way) v.3', overlay = true, max_bars_back = 1000)

// --- Inputs ---
ath_price = input.float(25476.40, 'Initial Anchor Price')
show_labels = input.bool(true, 'Show Price Labels?')

// --- Internal Variables for Global Anchor ---
var float current_anchor = ath_price

// --- Gann Math Function ---
get_price(r, step) =>
    math.pow(r + step, 2)

// --- Shift Logic (The Core) ---
root_now = math.sqrt(current_anchor)
full_cycle_up = get_price(root_now, 2.0) // +360°
full_cycle_down = get_price(root_now, -2.0) // -360°

// Shift Up: Agar price +360 degree ke upar close ho
if close > full_cycle_up
    current_anchor := full_cycle_up
    current_anchor

// Shift Down: Agar price -360 degree ke niche close ho
if close < full_cycle_down
    current_anchor := full_cycle_down
    current_anchor

// --- Calculate Active Levels ---
active_root = math.sqrt(current_anchor)

// Upside Levels (Target if bouncing)
up_90 = get_price(active_root, 0.5)
up_180 = get_price(active_root, 1.0)

// Downside Levels (Support if falling)
dn_90 = get_price(active_root, -0.5)
dn_180 = get_price(active_root, -1.0)
dn_270 = get_price(active_root, -1.5) // 1.5 Vibration (Trend Exhaustion)
dn_360 = get_price(active_root, -2.0) // Next Shift Level

// --- Plotting ---
// Main Anchor
plot(current_anchor, 'Current Anchor', color = color.new(color.yellow, 0), linewidth = 2, style = plot.style_linebr)

// Downside Grid
plot(dn_90, '90° Down', color = color.new(color.aqua, 40), style = plot.style_linebr)
plot(dn_180, '180° Down', color = color.new(color.orange, 40), style = plot.style_linebr)
plot(dn_360, '360° Down (Shift)', color = color.new(color.red, 20), linewidth = 2, style = plot.style_linebr)

// Upside Grid (Added for Two-way)
plot(up_90, '90° Up', color = color.new(color.lime, 40), style = plot.style_linebr)
plot(full_cycle_up, '360° Up (Shift)', color = color.new(color.green, 20), linewidth = 2, style = plot.style_linebr)

// --- Labels ---
if barstate.islast and show_labels
    label.new(bar_index + 10, current_anchor, 'ANCHOR: ' + str.tostring(current_anchor, '#.#'), style = label.style_none, textcolor = color.yellow)
    label.new(bar_index + 10, dn_180, '180° DN: ' + str.tostring(dn_180, '#.#'), style = label.style_none, textcolor = color.orange)
    label.new(bar_index + 10, dn_360, 'SHIFT DN: ' + str.tostring(dn_360, '#.#'), style = label.style_none, textcolor = color.red)
    label.new(bar_index + 10, full_cycle_up, 'SHIFT UP: ' + str.tostring(full_cycle_up, '#.#'), style = label.style_none, textcolor = color.green)
