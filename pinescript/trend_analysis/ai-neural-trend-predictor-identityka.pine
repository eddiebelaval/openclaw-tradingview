//@version=5
indicator("AI Neural Trend Predictor [identityKa]", shorttitle="AI Trend [identityKa]", overlay=true, max_labels_count=500)

// ==========================================
// 1. AI ENGINE INPUTS
// ==========================================
grp_ai = "🧠 AI Adaptive Engine"
ai_speed = input.int(14, "AI Reaction Speed", minval=1, group=grp_ai, tooltip="Düşük değerler fiyatı daha sıkı takip eder (Sıfır Gecikme).")
atr_len = input.int(14, "Volatility Length", group=grp_ai)
atr_mult = input.float(2.0, "Noise Filter Multiplier", step=0.1, group=grp_ai, tooltip="Ufak kırılımları filtrelemek için kalkan büyüklüğü. (2.0 ve üstü sahte sinyalleri ezer).")

grp_theme = "🎨 UI & Theme"
col_bull = input.color(#00e676, "AI Bullish Trend", group=grp_theme)
col_bear = input.color(#ff1744, "AI Bearish Trend", group=grp_theme)
col_neut = input.color(#ff9800, "Dangerous/Chop Zone", group=grp_theme)

grp_ui = "📊 Dashboard"
show_dash = input.bool(true, "Show AI Dashboard", group=grp_ui)

// ==========================================
// 2. ZERO-LAG SMOOTHING & VOLATILITY SHIELD
// ==========================================
// Gecikmeyi sıfıra indiren Hull altyapısı
smooth_src = ta.hma(close, ai_speed)
atr_val = ta.atr(atr_len) * atr_mult

// ==========================================
// 3. ADAPTIVE TRAILING LOGIC (Filtreleme)
// ==========================================
var float ai_line = 0.0
var int trend_dir = 1

if trend_dir == 1
    ai_line := math.max(nz(ai_line[1]), smooth_src - atr_val) // Çizgi sadece yukarı çıkar, ufak düşüşleri umursamaz
    if close < ai_line // Kalkan gerçekten kırılırsa trend döner
        trend_dir := -1
        ai_line := smooth_src + atr_val
else
    ai_line := math.min(nz(ai_line[1]), smooth_src + atr_val) // Çizgi sadece aşağı iner
    if close > ai_line
        trend_dir := 1
        ai_line := smooth_src - atr_val

// ==========================================
// 4. VISUALIZATION & SIGNALS
// ==========================================
color line_col = trend_dir == 1 ? col_bull : col_bear
plot(ai_line, color=line_col, linewidth=3, title="AI Neural Line")

buy_signal = trend_dir == 1 and trend_dir[1] == -1
sell_signal = trend_dir == -1 and trend_dir[1] == 1

// Dev Sinyal Etiketleri - MUMLARDAN KOPARILIP DOĞRUDAN ÇİZGİYE SABİTLENDİ (Absolute Location)
plotshape(buy_signal ? ai_line : na, title="AI BUY", text="BUY", style=shape.labelup, location=location.absolute, color=col_bull, textcolor=color.black, size=size.small)
plotshape(sell_signal ? ai_line : na, title="AI SELL", text="SELL", style=shape.labeldown, location=location.absolute, color=col_bear, textcolor=color.white, size=size.small)

// ==========================================
// 5. ALPHA AI DASHBOARD (STRICTLY TOP RIGHT)
// ==========================================
// Chop/Yatay piyasa algılama
volatility_ratio = ta.atr(14) / ta.sma(ta.tr, 50)
bool is_choppy = volatility_ratio < 0.8

if show_dash
    var table hud = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.new(color.gray, 80))
    if barstate.islast
        table.cell(hud, 0, 0, "AI NEURAL TREND", text_color=color.white, text_size=size.small, bgcolor=color.black)
        table.cell(hud, 1, 0, "[identityKa]", text_color=color.gray, text_size=size.small, bgcolor=color.black)
        
        table.cell(hud, 0, 1, "Market State", text_color=color.white, text_size=size.small, text_halign=text.align_left)
        string state_txt = is_choppy ? "CHOPPY / RANGING" : "TRENDING"
        color state_col = is_choppy ? col_neut : (trend_dir == 1 ? col_bull : col_bear)
        table.cell(hud, 1, 1, state_txt, text_color=color.black, text_size=size.small, bgcolor=state_col)
        
        table.cell(hud, 0, 2, "Live Trend", text_color=color.white, text_size=size.small, text_halign=text.align_left)
        table.cell(hud, 1, 2, trend_dir == 1 ? "BULLISH" : "BEARISH", text_color=trend_dir == 1 ? col_bull : col_bear, text_size=size.small)
        
        table.cell(hud, 0, 3, "Noise Filter (ATR)", text_color=color.white, text_size=size.small, text_halign=text.align_left)
        table.cell(hud, 1, 3, str.tostring(atr_mult) + "x", text_color=color.white, text_size=size.small)
        
        // AI Suggestion Formatı
        string ai_rec = ""
        color ai_rec_col = color.gray
        color ai_rec_txt = color.black
        
        if is_choppy
            ai_rec := "Dangerous"
            ai_rec_col := col_neut
        else if trend_dir == 1
            ai_rec := "LONG"
            ai_rec_col := col_bull
        else if trend_dir == -1
            ai_rec := "SHORT"
            ai_rec_col := col_bear
            ai_rec_txt := color.white
            
        table.cell(hud, 0, 4, "AI Suggestion", text_color=color.white, text_size=size.small, text_halign=text.align_left)
        table.cell(hud, 1, 4, ai_rec, text_color=ai_rec_txt, text_size=size.small, bgcolor=ai_rec_col, text_font_family=font.family_monospace)

// ==========================================
// 6. ALERTS
// ==========================================
alertcondition(buy_signal, "🟢 AI Buy Signal", "identityKa: AI Neural Trend engine generated a BUY signal.")
alertcondition(sell_signal, "🔴 AI Sell Signal", "identityKa: AI Neural Trend engine generated a SELL signal.")
