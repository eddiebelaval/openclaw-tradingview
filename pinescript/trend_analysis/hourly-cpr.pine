//@version=6
indicator("Hourly CPR", overlay = true)

// Get previous completed 60m candle values
[hourHigh, hourLow, hourClose, hourTime] = request.security(syminfo.tickerid, "60",
        [high[1], low[1], close[1], time],
        lookahead = barmerge.lookahead_on)

// Calculate Pivot
pivot = (hourHigh + hourLow + hourClose) / 3

// Raw BC & TC
bc_raw = (hourHigh + hourLow) / 2
tc_raw = 2 * pivot - bc_raw

// Ensure proper ordering
bc = math.min(bc_raw, tc_raw)
tc = math.max(bc_raw, tc_raw)

// Detect new hour
newHour = ta.change(time("60")) != 0

// Store line references
var line pivotLine = na
var line bcLine    = na
var line tcLine    = na

if newHour
    // Delete previous hour lines
    //line.delete(pivotLine)
   // line.delete(bcLine)
   // line.delete(tcLine)

    // Define hour start & end time
    hourStart = hourTime
    hourEnd   = hourStart + 60 * 60 * 1000  // 60 minutes in ms

    // Draw horizontal lines extended to end of hour
    pivotLine := line.new(hourStart, pivot, hourEnd, pivot,
        xloc = xloc.bar_time, color = color.white, width = 2)

    bcLine := line.new(hourStart, bc, hourEnd, bc,
        xloc = xloc.bar_time, color = color.green, width = 2)

    tcLine := line.new(hourStart, tc, hourEnd, tc,
        xloc = xloc.bar_time, color = color.orange, width = 2)
