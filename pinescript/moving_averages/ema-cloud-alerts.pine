//@version=6
indicator("EMA Cloud + Alerts (Preset Modes, No-Repaint)", overlay=true, max_labels_count=500)

//────────────────────────────────────────────
//                PRESET MODES
//────────────────────────────────────────────

// Preset & Timeframe Modes
group_preset = "Preset & Timeframe Modes"

mode = input.string(
     "Daily - Standard (8/21)",
     title = "Preset Mode",
     group = group_preset,
     options = ["Weekly - Standard (8/21)", "Weekly - Noise Filter (10/22)", "Daily - Standard (8/21)", "Daily - Smooth Trend (10/20)", "Daily - MACD Style (12/26)", "Intraday - Momentum (5/13)", "Intraday - Smooth Momentum (9/27)"]
)

// Map EMA lengths based on preset
len1 = mode == "Weekly - Standard (8/21)"           ? 8  :
       mode == "Weekly - Noise Filter (10/22)"      ? 10 :
       mode == "Daily - Standard (8/21)"            ? 8  :
       mode == "Daily - Smooth Trend (10/20)"       ? 10 :
       mode == "Daily - MACD Style (12/26)"         ? 12 :
       mode == "Intraday - Momentum (5/13)"         ? 5  :
       mode == "Intraday - Smooth Momentum (9/27)"  ? 9  : 8

len2 = mode == "Weekly - Standard (8/21)"           ? 21 :
       mode == "Weekly - Noise Filter (10/22)"      ? 22 :
       mode == "Daily - Standard (8/21)"            ? 21 :
       mode == "Daily - Smooth Trend (10/20)"       ? 20 :
       mode == "Daily - MACD Style (12/26)"         ? 26 :
       mode == "Intraday - Momentum (5/13)"         ? 13 :
       mode == "Intraday - Smooth Momentum (9/27)"  ? 27 : 21

// Label size based on mode
label_size = mode == "Intraday - Momentum (5/13)"          ? size.tiny  :
             mode == "Intraday - Smooth Momentum (9/27)"   ? size.tiny  :
             mode == "Daily - Standard (8/21)"             ? size.small :
             mode == "Daily - Smooth Trend (10/20)"        ? size.small :
             mode == "Daily - MACD Style (12/26)"          ? size.small :
             mode == "Weekly - Standard (8/21)"            ? size.normal :
             mode == "Weekly - Noise Filter (10/22)"       ? size.normal :
             size.small


//────────────────────────────────────────────
//                INPUTS
//────────────────────────────────────────────

// Timeframe
group_tf = "Timeframe Settings"
res = input.timeframe("", "Lock to Timeframe (leave empty for current)", group=group_tf)
wait_for_close = input.bool(false, "Wait for Close (No Repaint)", group=group_tf,
     tooltip="ON: Uses confirmed (closed-bar) cross logic for fully non-repainting signals.\nOFF: Uses real-time cross logic (more responsive, can flicker intrabar).")

// EMA Colors
group_ema = "EMA Visuals"
ema1_color = input.color(color.rgb(4, 193, 29), "Fast EMA Color", group=group_ema)
ema2_color = input.color(color.rgb(210, 28, 4), "Slow EMA Color", group=group_ema)

// Cloud + Alerts
group_cloud = "Cloud & Alerts"
bull_fill_color = input.color(color.new(#1fbe24, 70), "Bull Cloud Color", group=group_cloud)
bear_fill_color = input.color(color.new(color.red, 70), "Bear Cloud Color", group=group_cloud)
show_trend_alerts = input.bool(true, "Trend Change Alerts & Labels", group=group_cloud)

// Distance Table
group_table = "Distance Table (Top-Right)"
show_distance = input.bool(true, "Show Distance Table", group=group_table)
table_bg_transp = input.int(80, "Background Transparency", minval=0, maxval=100, group=group_table)

//────────────────────────────────────────────
//                CORE LOGIC
//────────────────────────────────────────────

// Base EMAs
ema1 = ta.ema(close, len1)
ema2 = ta.ema(close, len2)

// Lookahead mode for HTF
lookahead_mode = wait_for_close ? barmerge.lookahead_off : barmerge.lookahead_on

// HTF EMAs (or current TF if res == "")
ema1_htf = res == "" ? ema1 : request.security(syminfo.tickerid, res, ema1, gaps=barmerge.gaps_off, lookahead=lookahead_mode)
ema2_htf = res == "" ? ema2 : request.security(syminfo.tickerid, res, ema2, gaps=barmerge.gaps_off, lookahead=lookahead_mode)

// Optional smoothing for visual stability
ema1_s = ta.ema(ema1_htf, 2)
ema2_s = ta.ema(ema2_htf, 2)

//────────────────────────────────────────────
//      TRUE NON‑REPAINT CROSSOVER LOGIC
//────────────────────────────────────────────

// Real-time cross (intrabar)
bull_rt = ta.crossover(ema1_s, ema2_s)
bear_rt = ta.crossunder(ema1_s, ema2_s)

// Close-only cross (confirmed, previous bar)
bull_close = ta.crossover(ema1_s[1], ema2_s[1])
bear_close = ta.crossunder(ema1_s[1], ema2_s[1])

// Final chosen mode
bullish_cross = wait_for_close ? bull_close : bull_rt
bearish_cross = wait_for_close ? bear_close : bear_rt

//────────────────────────────────────────────
//           TREND STATE (PERSISTENT)
//────────────────────────────────────────────

var int trend = 1
if bullish_cross
    trend := 1
if bearish_cross
    trend := -1

fill_color = trend == 1 ? bull_fill_color : bear_fill_color

//────────────────────────────────────────────
//                PLOTS
//────────────────────────────────────────────

p1 = plot(ema1_s, "Fast EMA", ema1_color, 3)
p2 = plot(ema2_s, "Slow EMA", ema2_color, 3)
fill(p1, p2, fill_color, "Cloud Fill")

//────────────────────────────────────────────
//                LABELS
//────────────────────────────────────────────

if show_trend_alerts and barstate.isconfirmed
    if bullish_cross
        label.new(
            bar_index, ema1_s,
            "LONG",
            color=color.green,
            textcolor=color.white,
            style=label.style_label_up,
            size=label_size,
            yloc=yloc.price
        )
    if bearish_cross
        label.new(
            bar_index, ema1_s,
            "SHORT",
            color=color.red,
            textcolor=color.white,
            style=label.style_label_down,
            size=label_size,
            yloc=yloc.price
        )

//────────────────────────────────────────────
//                ALERTS
//────────────────────────────────────────────

alertcondition(show_trend_alerts and bullish_cross, "EMA Cloud Long Breakout", "EMA Cloud: LONG at {{close}}")
alertcondition(show_trend_alerts and bearish_cross, "EMA Cloud Short Breakout", "EMA Cloud: SHORT at {{close}}")

//────────────────────────────────────────────
//                DISTANCE TABLE
//────────────────────────────────────────────

if show_distance and barstate.islast
    dist1 = close - ema1_s
    dist2 = close - ema2_s
    pct1 = 100 * dist1 / ema1_s
    pct2 = 100 * dist2 / ema2_s

    var table distTable = table.new(position.top_right, 1, 3,
        bgcolor=color.new(color.black, table_bg_transp),
        border_width=0,
        frame_width=3,
        frame_color=color.green
    )

    table.cell(distTable, 0, 0, "Distance to EMAs", text_color=color.white, text_halign=text.align_center)
    table.cell(
        distTable, 0, 1,
        str.format("{0} EMA: {1} ({2}%)", len1, str.tostring(dist1, format.mintick), str.tostring(pct1, "#.##")),
        text_color = dist1 >= 0 ? color.green : color.red
    )
    table.cell(
        distTable, 0, 2,
        str.format("{0} EMA: {1} ({2}%)", len2, str.tostring(dist2, format.mintick), str.tostring(pct2, "#.##")),
        text_color = dist2 >= 0 ? color.green : color.red
    )
