//@version=6
indicator(title="Xpert Confluence Suite", shorttitle="XCS", overlay=true, timeframe="", timeframe_gaps=true)

// ═════════════════════════════════════════════════════════════════════
// MASTER TOGGLES
// ═════════════════════════════════════════════════════════════════════
showDonchian = input.bool(true, "Show Donchian Channels", group="General")
showEMAStack = input.bool(true, "Show EMA Stack", group="General")

// ═════════════════════════════════════════════════════════════════════
// DONCHIAN CHANNELS
// ═════════════════════════════════════════════════════════════════════
dcGroup1 = "Donchian Channel 1"
dcEnable1 = input.bool(true, title="Enable Channel 1", group=dcGroup1)
dcLength1 = input.int(20, minval=1, title="Length 1", group=dcGroup1)
dcOffset1 = input.int(0, title="Offset 1", group=dcGroup1)
dcShowBasis1 = input.bool(true, title="Show Basis 1", group=dcGroup1)
dcLineColor1 = input.color(#2962FF, title="Upper/Lower Color 1", group=dcGroup1)
dcBasisColor1 = input.color(#FF6D00, title="Basis Color 1", group=dcGroup1)
dcFillColor1 = input.color(color.rgb(33, 150, 243, 85), title="Fill Color 1", group=dcGroup1)

dcGroup2 = "Donchian Channel 2"
dcEnable2 = input.bool(true, title="Enable Channel 2", group=dcGroup2)
dcLength2 = input.int(50, minval=1, title="Length 2", group=dcGroup2)
dcOffset2 = input.int(0, title="Offset 2", group=dcGroup2)
dcShowBasis2 = input.bool(true, title="Show Basis 2", group=dcGroup2)
dcLineColor2 = input.color(color.green, title="Upper/Lower Color 2", group=dcGroup2)
dcBasisColor2 = input.color(color.yellow, title="Basis Color 2", group=dcGroup2)
dcFillColor2 = input.color(color.new(color.green, 85), title="Fill Color 2", group=dcGroup2)

dcGroup3 = "Donchian Channel 3"
dcEnable3 = input.bool(true, title="Enable Channel 3", group=dcGroup3)
dcLength3 = input.int(100, minval=1, title="Length 3", group=dcGroup3)
dcOffset3 = input.int(0, title="Offset 3", group=dcGroup3)
dcShowBasis3 = input.bool(true, title="Show Basis 3", group=dcGroup3)
dcLineColor3 = input.color(color.red, title="Upper/Lower Color 3", group=dcGroup3)
dcBasisColor3 = input.color(color.white, title="Basis Color 3", group=dcGroup3)
dcFillColor3 = input.color(color.new(color.red, 90), title="Fill Color 3", group=dcGroup3)

// Donchian calculations
dcLower1 = ta.lowest(dcLength1)
dcUpper1 = ta.highest(dcLength1)
dcBasis1 = math.avg(dcUpper1, dcLower1)

dcLower2 = ta.lowest(dcLength2)
dcUpper2 = ta.highest(dcLength2)
dcBasis2 = math.avg(dcUpper2, dcLower2)

dcLower3 = ta.lowest(dcLength3)
dcUpper3 = ta.highest(dcLength3)
dcBasis3 = math.avg(dcUpper3, dcLower3)

// Donchian plots
dcB1 = plot(showDonchian and dcEnable1 and dcShowBasis1 ? dcBasis1 : na, title="DC Basis 1", color=dcBasisColor1, offset=dcOffset1)
dcU1 = plot(showDonchian and dcEnable1 ? dcUpper1 : na, title="DC Upper 1", color=dcLineColor1, offset=dcOffset1)
dcL1 = plot(showDonchian and dcEnable1 ? dcLower1 : na, title="DC Lower 1", color=dcLineColor1, offset=dcOffset1)
fill(dcU1, dcL1, color=showDonchian and dcEnable1 ? dcFillColor1 : na, title="DC Fill 1")

dcB2 = plot(showDonchian and dcEnable2 and dcShowBasis2 ? dcBasis2 : na, title="DC Basis 2", color=dcBasisColor2, offset=dcOffset2)
dcU2 = plot(showDonchian and dcEnable2 ? dcUpper2 : na, title="DC Upper 2", color=dcLineColor2, offset=dcOffset2)
dcL2 = plot(showDonchian and dcEnable2 ? dcLower2 : na, title="DC Lower 2", color=dcLineColor2, offset=dcOffset2)
fill(dcU2, dcL2, color=showDonchian and dcEnable2 ? dcFillColor2 : na, title="DC Fill 2")

dcB3 = plot(showDonchian and dcEnable3 and dcShowBasis3 ? dcBasis3 : na, title="DC Basis 3", color=dcBasisColor3, offset=dcOffset3)
dcU3 = plot(showDonchian and dcEnable3 ? dcUpper3 : na, title="DC Upper 3", color=dcLineColor3, offset=dcOffset3)
dcL3 = plot(showDonchian and dcEnable3 ? dcLower3 : na, title="DC Lower 3", color=dcLineColor3, offset=dcOffset3)
fill(dcU3, dcL3, color=showDonchian and dcEnable3 ? dcFillColor3 : na, title="DC Fill 3")

// ═════════════════════════════════════════════════════════════════════
// 6 EMA STACK
// ═════════════════════════════════════════════════════════════════════
emaSource = input.source(close, title="Source", group="EMA General")
emaOffset = input.int(title="Offset", defval=0, minval=-500, maxval=500, group="EMA General")

emaGroup1 = "EMA 1"
showEma1 = input.bool(true, "Show EMA 1", group=emaGroup1)
len1 = input.int(9, minval=1, title="Length 1", group=emaGroup1)
emaColor1 = input.color(color.blue, "Color 1", group=emaGroup1)

emaGroup2 = "EMA 2"
showEma2 = input.bool(true, "Show EMA 2", group=emaGroup2)
len2 = input.int(21, minval=1, title="Length 2", group=emaGroup2)
emaColor2 = input.color(color.orange, "Color 2", group=emaGroup2)

emaGroup3 = "EMA 3"
showEma3 = input.bool(true, "Show EMA 3", group=emaGroup3)
len3 = input.int(34, minval=1, title="Length 3", group=emaGroup3)
emaColor3 = input.color(color.green, "Color 3", group=emaGroup3)

emaGroup4 = "EMA 4"
showEma4 = input.bool(true, "Show EMA 4", group=emaGroup4)
len4 = input.int(89, minval=1, title="Length 4", group=emaGroup4)
emaColor4 = input.color(color.red, "Color 4", group=emaGroup4)

emaGroup5 = "EMA 5"
showEma5 = input.bool(true, "Show EMA 5", group=emaGroup5)
len5 = input.int(200, minval=1, title="Length 5", group=emaGroup5)
emaColor5 = input.color(color.purple, "Color 5", group=emaGroup5)

emaGroup6 = "EMA 6"
showEma6 = input.bool(true, "Show EMA 6", group=emaGroup6)
len6 = input.int(500, minval=1, title="Length 6", group=emaGroup6)
emaColor6 = input.color(color.gray, "Color 6", group=emaGroup6)

// EMA calculations
ema1 = ta.ema(emaSource, len1)
ema2 = ta.ema(emaSource, len2)
ema3 = ta.ema(emaSource, len3)
ema4 = ta.ema(emaSource, len4)
ema5 = ta.ema(emaSource, len5)
ema6 = ta.ema(emaSource, len6)

// Dashed-look settings
dashLen = input.int(3, "Dash Length", minval=1, maxval=20, group="Dash Settings")
gapLen  = input.int(3, "Gap Length", minval=1, maxval=20, group="Dash Settings")
dashCycle = dashLen + gapLen
isDashOn = (bar_index % dashCycle) < dashLen

// EMA plots
plot(showEMAStack and showEma1 ? ema1 : na, title="EMA 9", color=emaColor1, offset=emaOffset, linewidth=2)
plot(showEMAStack and showEma2 ? ema2 : na, title="EMA 21", color=emaColor2, offset=emaOffset, linewidth=2)

plot(showEMAStack and showEma3 and isDashOn ? ema3 : na, title="EMA 34", color=emaColor3, offset=emaOffset, linewidth=2, style=plot.style_linebr)
plot(showEMAStack and showEma4 and isDashOn ? ema4 : na, title="EMA 89", color=emaColor4, offset=emaOffset, linewidth=2, style=plot.style_linebr)
plot(showEMAStack and showEma5 and isDashOn ? ema5 : na, title="EMA 200", color=emaColor5, offset=emaOffset, linewidth=2, style=plot.style_linebr)
plot(showEMAStack and showEma6 and isDashOn ? ema6 : na, title="EMA 500", color=emaColor6, offset=emaOffset, linewidth=2, style=plot.style_linebr)
