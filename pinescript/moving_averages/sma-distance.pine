//@version=6
indicator("SMA Distance %", overlay=false)

// Input for the SMA length
smaLength = input.int(100, title="Daily SMA Length", minval=1)

// Retrieve the SMA calculated exclusively on the Daily ("1D") timeframe
dailySMA = request.security(syminfo.tickerid, "1D", ta.sma(close, smaLength))

// Calculate the percentage distance for the current chart's close
percentageDistance = ((close - dailySMA) / dailySMA) * 100

// Isolate positive and negative distances
posDist = percentageDistance > 0 ? percentageDistance : na
negDist = percentageDistance < 0 ? percentageDistance : na

// Calculate the cumulative historical average for the upper bound (positive distances)
cumPosDist = ta.cum(nz(posDist))
cumPosCount = ta.cum(percentageDistance > 0 ? 1 : 0)
historicalUpper = cumPosCount > 0 ? cumPosDist / cumPosCount : na

// Calculate the cumulative historical average for the lower bound (negative distances)
cumNegDist = ta.cum(nz(negDist))
cumNegCount = ta.cum(percentageDistance < 0 ? 1 : 0)
historicalLower = cumNegCount > 0 ? cumNegDist / cumNegCount : na

// Determine the line colour based on position relative to the SMA
distanceColour = percentageDistance >= 0 ? color.green : color.red

// Plot the historical average bounds as thick, semi-transparent lines
plot(historicalUpper, title="Historical Avg Upper Bound", color=color.new(color.red, 50), linewidth=2)
plot(historicalLower, title="Historical Avg Lower Bound", color=color.new(color.green, 50), linewidth=2)

// Plot the main distance line and the zero line
plot(percentageDistance, title="Distance (%)", color=distanceColour, linewidth=2)
hline(0, title="Zero Line", color=color.gray, linestyle=hline.style_dashed)
