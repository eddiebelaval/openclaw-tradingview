//@version=5
indicator("KCP Supertrend + EMA 9/20 + VWAP [Dr.K.C.Prakash]", overlay=true, precision=2)

//==============================
// INPUTS
//==============================
Periods      = input.int(10,  "ATR Period")
src          = input.source(hl2, "Source")
Multiplier   = input.float(3.0, "ATR Multiplier", step=0.1)
changeATR    = input.bool(true, "Change ATR Calculation Method ?")
showsignals  = input.bool(true, "Show Buy/Sell Signals ?")

//==============================
// EMA + VWAP (VISIBLE)
//==============================
ema9  = ta.ema(close, 9)
ema20 = ta.ema(close, 20)
vwapLine = ta.vwap(hlc3)

plot(ema9,  "EMA 9",  color=color.green, linewidth=2)
plot(ema20, "EMA 20", color=color.red,   linewidth=2)
plot(vwapLine, "VWAP", color=color.black, linewidth=2)

//==============================
// ATR + SUPERTREND CORE
//==============================
atr2 = ta.sma(ta.tr, Periods)
atr  = changeATR ? ta.atr(Periods) : atr2

up  = src - Multiplier * atr
up1 = nz(up[1], up)
up  := close[1] > up1 ? math.max(up, up1) : up

dn  = src + Multiplier * atr
dn1 = nz(dn[1], dn)
dn  := close[1] < dn1 ? math.min(dn, dn1) : dn

trend = 1
trend := nz(trend[1], trend)
trend := trend == -1 and close > dn1 ? 1 :
         trend == 1 and close < up1  ? -1 : trend

//==============================
// SIGNALS
//==============================
buySignal  = trend == 1 and trend[1] == -1
sellSignal = trend == -1 and trend[1] == 1

plotshape(buySignal and showsignals ? up : na, "BUY",
     style=shape.labelup, location=location.absolute,
     color=color.green, textcolor=color.white, text="BUY")

plotshape(sellSignal and showsignals ? dn : na, "SELL",
     style=shape.labeldown, location=location.absolute,
     color=color.red, textcolor=color.white, text="SELL")

//==============================
// ALERTS
//==============================
alertcondition(buySignal,  "BUY – KCP Supertrend",  "BUY: KCP Supertrend")
alertcondition(sellSignal, "SELL – KCP Supertrend", "SELL: KCP Supertrend")
alertcondition(trend != trend[1], "Trend Change", "KCP Supertrend trend changed")
