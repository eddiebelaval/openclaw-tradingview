//@version=6
indicator('Moving Average+ S/R Channel', overlay = true, max_bars_back = 500, max_boxes_count = 100)

// ==========================================================
// 1. BEÁLLÍTÁSOK 
// ==========================================================
prd = input.int(10, 'Pivot Period', minval = 4, maxval = 30, group = 'Settings 🔨')
ChannelW = input.int(3, 'Max Channel Width %', minval = 1, maxval = 8, group = 'Settings 🔨')
minstrength = input.int(1, 'Min Strength', minval = 1, group = 'Settings 🔨')
maxnumsr = input.int(6, 'Max S/R Channels', minval = 1, maxval = 10, group = 'Settings 🔨') - 1
loopback = input.int(290, 'Loopback Period', minval = 100, maxval = 400, group = 'Settings 🔨')
res_col = input.color(color.new(color.red, 75), 'Resistance Color')
sup_col = input.color(color.new(color.lime, 75), 'Support Color')
showpp = input.bool(false, 'Show Pivot Points (H/L)', group = 'Extras ⏶⏷')

// ==========================================================
// 2. MOZGÓÁTLAGOK ÉS VWAP 
// ==========================================================
ema9 = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
sma50 = ta.sma(close, 50)
ema200 = ta.ema(close, 200)

plot(ema9, "EMA 9", color.rgb(194, 11, 11), 2)
plot(ema21, "EMA 21", color.rgb(255, 128, 0), 2)
plot(sma50, "SMA 50", color.rgb(24, 196, 239), 2)
plot(ema200, "EMA 200", color.rgb(13, 0, 255), 3)
plot(ta.vwap, "VWAP", color.rgb(255, 230, 0), 2)

// ==========================================================
// 3. S/R SZÁMÍTÁS ÉS DINAMIKUS IRÁNYÍTÁS (EMA 9 ALAPJÁN)
// ==========================================================
src1 = high
src2 = low
ph = ta.pivothigh(src1, prd, prd)
pl = ta.pivotlow(src2, prd, prd)

// Pivot betűk
plotshape(not na(ph) and showpp, text = 'H', style = shape.labeldown, color = na, textcolor = color.red, location = location.abovebar, offset = -prd)
plotshape(not na(pl) and showpp, text = 'L', style = shape.labelup, color = na, textcolor = color.lime, location = location.belowbar, offset = -prd)

prdhighest = ta.highest(300)
prdlowest = ta.lowest(300)
cwidth = (prdhighest - prdlowest) * ChannelW / 100

var pivotvals = array.new_float(0)
if not na(ph) or not na(pl)
    array.unshift(pivotvals, not na(ph) ? ph : pl)
    if array.size(pivotvals) > 100
        array.pop(pivotvals)

get_sr_vals(ind) =>
    float lo = array.get(pivotvals, ind)
    float hi = lo
    int numpp = 0
    for y = 0 to array.size(pivotvals) - 1 by 1
        float cpp = array.get(pivotvals, y)
        if math.abs(cpp - lo) <= cwidth or math.abs(cpp - hi) <= cwidth
            lo := math.min(lo, cpp)
            hi := math.max(hi, cpp)
            numpp := numpp + 20
    [hi, lo, numpp]

var srchannels = array.new_box(0)
if not na(ph) or not na(pl) or barstate.islast
    for b in srchannels
        box.delete(b)
    array.clear(srchannels)
    
    count_up = 0
    count_down = 0
    
    for x = 0 to array.size(pivotvals) - 1 by 1
        [hi, lo, strength] = get_sr_vals(x)
        if strength >= minstrength * 20
            bool show_this = false
            if close > ema9 
                if hi > close 
                    if count_up < 4
                        show_this := true
                        count_up := count_up + 1
                else if lo < close 
                    if count_down < 1
                        show_this := true
                        count_down := count_down + 1
            else 
                if lo < close 
                    if count_down < 4
                        show_this := true
                        count_down := count_down + 1
                else if hi > close 
                    if count_up < 1
                        show_this := true
                        count_up := count_up + 1
            
            if show_this
                srcol = close > hi ? sup_col : (close < lo ? res_col : color.new(color.gray, 80))
                array.push(srchannels, box.new(bar_index, hi, bar_index + 1, lo, border_color = srcol, extend = extend.both, bgcolor = srcol))

// ==========================================================
// 4. VOLUMEN ALAPÚ GYERTYASZÍNEZÉS 
// ==========================================================
avg_vol = ta.sma(volume, 20)
is_high_vol = volume > avg_vol * 1.5 

// Neon Zöld (#00FF00) és Neon Piros (#FF0000)
// Csak akkor színezi át a gyertyát, ha a forgalom az átlag 150%-a felett van
barcolor(is_high_vol ? (close > open ? #00FF00 : #FF0000) : na)
