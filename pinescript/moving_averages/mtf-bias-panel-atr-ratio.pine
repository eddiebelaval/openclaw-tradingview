//@version=6
indicator("MTF Bias Panel + ATR Ratio", overlay=true, max_labels_count=500)

//====================================================
// Inputs
//====================================================
panelPos = input.string("Top Right", "Panel position",
     options=["Top Right","Top Left","Bottom Right","Bottom Left"])

// Size
grpSize = "Panel Size"
txtSizeOpt = input.string("Small", "Text size", options=["Tiny","Small","Normal","Large","Huge"], group=grpSize)
cellPad    = input.int(1, "Cell padding (spaces)", minval=0, maxval=5, group=grpSize)

// Stable HTF
stableHTF = input.bool(true, "MTF stable (confirmed bar only)")

// Middle
grpMid   = "Middle (Base MA)"
midLen   = input.int(20, "Middle Length", minval=1, group=grpMid)
midSrc   = input.source(close, "Middle Source", group=grpMid)

// 200
grp200   = "200 SMA"
ma200Len = input.int(200, "200 SMA Length", minval=1, group=grp200)
ma200Src = input.source(close, "200 SMA Source", group=grp200)

// Slope
grpSlo       = "Slope"
useSlope     = input.bool(true, "Show slope", group=grpSlo)
slopeFlatThr = input.float(0.0, "Slope flat threshold (0 = mintick)", step=0.0001, group=grpSlo)

// RSI
grpRsi = "RSI"
rsiLen = input.int(14, "RSI Length", minval=1, group=grpRsi)
rsiBullLevel = input.float(51.0, "RSI Bull >= ", step=0.1, group=grpRsi)
rsiBearLevel = input.float(50.0, "RSI Bear < ",  step=0.1, group=grpRsi)

// Colors
grpCol = "Colors"
headerBg   = input.color(color.black, "Header BG", group=grpCol)
headerTc   = input.color(color.white, "Header Text", group=grpCol)

tfBg       = input.color(color.black, "TF default BG", group=grpCol)
tfTc       = input.color(color.white, "TF text", group=grpCol)

bgUp       = input.color(color.new(color.lime, 80), "Arrow BG: UP", group=grpCol)
bgDown     = input.color(color.new(color.red, 80),  "Arrow BG: DOWN", group=grpCol)
bgFlat     = input.color(color.new(color.gray, 85), "Arrow BG: FLAT", group=grpCol)

rsiBullBg  = input.color(color.new(color.lime, 70), "RSI BG: BULL", group=grpCol)
rsiBearBg  = input.color(color.new(color.red, 70),  "RSI BG: BEAR", group=grpCol)
rsiNeutBg  = input.color(color.new(color.gray, 85), "RSI BG: NEUTRAL", group=grpCol)
rsiTc      = input.color(color.white, "RSI Text", group=grpCol)

tfAllUpBg   = input.color(color.new(color.lime, 55), "TF BG when ALL UP", group=grpCol)
tfAllDownBg = input.color(color.new(color.red, 55),  "TF BG when ALL DOWN", group=grpCol)

secBg = input.color(color.new(color.gray, 60), "Section header BG", group=grpCol)
secTc = input.color(color.white, "Section header Text", group=grpCol)

// Reserve area color (right blank area)
grpRes = "Reserve Area (right) / ATR"
reserveBg      = input.color(color.new(color.gray, 75), "Reserve background", group=grpRes)
reserveTextCol = input.color(color.white, "Reserve text", group=grpRes)

// Chart lines default OFF
grpLine = "Chart Lines (default OFF)"
showMiddleOnChart = input.bool(false, "Show Middle on chart", group=grpLine)
show200OnChart    = input.bool(false, "Show 200SMA on chart", group=grpLine)
showExtraOnChart  = input.bool(false, "Show EX SMAs on chart", group=grpLine)
extraWidth        = input.int(2, "EX SMA Line Width", minval=1, maxval=5, group=grpLine)

// EX
grpEx = "EX (A-E)"
showExtraInPanel  = input.bool(true, "Show EX in panel", group=grpEx)
show_A_M15_SMA10  = input.bool(true, "A: 15m_10",  group=grpEx)
show_B_M5_SMA75   = input.bool(true, "B: 5m_75",   group=grpEx)
show_C_M60_SMA10  = input.bool(true, "C: 60m_10",  group=grpEx)
show_D_M15_SMA75  = input.bool(true, "D: 15m_75",  group=grpEx)
show_E_M240_SMA10 = input.bool(true, "E: 240m_10", group=grpEx)

// ATR mini
grpATR = "ATR Ratio (Mini)"
enableAtrMini = input.bool(true, "Show ATR Ratio in reserve area", group=grpATR)
tfHTF = input.timeframe("15", "HTF", group=grpATR)
tfLTF = input.timeframe("1",  "LTF", group=grpATR)

atrLen  = input.int(14, "ATR Length", minval=1, group=grpATR)
avgMode = input.string("Yesterday (prev day avg)", "Average Mode",
     options=["Yesterday (prev day avg)", "Today (day avg)", "Rolling (N bars)"], group=grpATR)
rollN   = input.int(240, "Rolling N bars", minval=5, group=grpATR)
minBarsToday = input.int(10, "Min bars for Today avg", minval=1, group=grpATR)

watchTh = input.float(1.20, "WATCH threshold", step=0.01, group=grpATR)
tradeTh = input.float(1.40, "TRADE threshold", step=0.01, group=grpATR)
coolTh  = input.float(1.05, "COOL threshold",  step=0.01, group=grpATR)

atrTradeBg = input.color(color.new(color.red, 0),    "ATR BG: TRADE", group=grpATR)
atrWatchBg = input.color(color.new(color.orange, 0), "ATR BG: WATCH", group=grpATR)
atrMidBg   = input.color(color.new(color.yellow, 0), "ATR BG: MID",   group=grpATR)
atrCoolBg  = input.color(color.new(color.gray, 20),  "ATR BG: COOL",  group=grpATR)
atrTc      = input.color(color.white, "ATR Text", group=grpATR)

//====================================================
// Helpers
//====================================================
f_pos(_s) =>
    _s == "Top Left" ? position.top_left :
     _s == "Bottom Right" ? position.bottom_right :
     _s == "Bottom Left" ? position.bottom_left :
     position.top_right

f_textSize(opt) =>
    opt == "Tiny" ? size.tiny :
     opt == "Small" ? size.small :
     opt == "Normal" ? size.normal :
     opt == "Large" ? size.large :
     size.huge

ts = f_textSize(txtSizeOpt)

f_pad(s) =>
    p = str.repeat(" ", cellPad)
    p + s + p

f_thr(flatThr) =>
    flatThr == 0.0 ? syminfo.mintick : flatThr

f_slopeSign(now, prev, flatThr) =>
    thr = f_thr(flatThr)
    d = now - prev
    d > thr ? 1 : d < -thr ? -1 : 0

f_arrowPos(cp) => cp > 0 ? "▲" : "▼"
f_arrowSlope(s) => s > 0 ? "↗" : s < 0 ? "↘" : "－"
f_bgBySign(v) => v > 0 ? bgUp : v < 0 ? bgDown : bgFlat
f_rsiBg(r) => r >= rsiBullLevel ? rsiBullBg : r < rsiBearLevel ? rsiBearBg : rsiNeutBg

//====================================================
// Fixed TF rows (minutes only)
//====================================================
tf1 = "5"
tf2 = "15"
tf3 = "30"
tf4 = "60"
tf5 = "240"

//====================================================
// Packs (1 security per TF)
//====================================================
f_pack_main(tfStr) =>
    request.security(
        syminfo.tickerid, tfStr,
        [
            close,
            // mid_now, mid_prev
            stableHTF ? (barstate.isconfirmed ? ta.sma(midSrc, midLen)    : ta.sma(midSrc, midLen)[1]) : ta.sma(midSrc, midLen),
            stableHTF ? (barstate.isconfirmed ? ta.sma(midSrc, midLen)[1] : ta.sma(midSrc, midLen)[2]) : ta.sma(midSrc, midLen)[1],
            // 200_now, 200_prev
            stableHTF ? (barstate.isconfirmed ? ta.sma(ma200Src, ma200Len)    : ta.sma(ma200Src, ma200Len)[1]) : ta.sma(ma200Src, ma200Len),
            stableHTF ? (barstate.isconfirmed ? ta.sma(ma200Src, ma200Len)[1] : ta.sma(ma200Src, ma200Len)[2]) : ta.sma(ma200Src, ma200Len)[1],
            // RSI fixed (prev bar)
            ta.rsi(close, rsiLen)[1]
        ],
        barmerge.gaps_off, barmerge.lookahead_off
    )

f_pack_ex15() =>
    request.security(
        syminfo.tickerid, "15",
        [
            close,
            stableHTF ? (barstate.isconfirmed ? ta.sma(close, 10)    : ta.sma(close, 10)[1]) : ta.sma(close, 10),
            stableHTF ? (barstate.isconfirmed ? ta.sma(close, 10)[1] : ta.sma(close, 10)[2]) : ta.sma(close, 10)[1],
            stableHTF ? (barstate.isconfirmed ? ta.sma(close, 75)    : ta.sma(close, 75)[1]) : ta.sma(close, 75),
            stableHTF ? (barstate.isconfirmed ? ta.sma(close, 75)[1] : ta.sma(close, 75)[2]) : ta.sma(close, 75)[1]
        ],
        barmerge.gaps_off, barmerge.lookahead_off
    )

f_pack_ex5() =>
    request.security(
        syminfo.tickerid, "5",
        [
            close,
            stableHTF ? (barstate.isconfirmed ? ta.sma(close, 75)    : ta.sma(close, 75)[1]) : ta.sma(close, 75),
            stableHTF ? (barstate.isconfirmed ? ta.sma(close, 75)[1] : ta.sma(close, 75)[2]) : ta.sma(close, 75)[1]
        ],
        barmerge.gaps_off, barmerge.lookahead_off
    )

f_pack_ex60() =>
    request.security(
        syminfo.tickerid, "60",
        [
            close,
            stableHTF ? (barstate.isconfirmed ? ta.sma(close, 10)    : ta.sma(close, 10)[1]) : ta.sma(close, 10),
            stableHTF ? (barstate.isconfirmed ? ta.sma(close, 10)[1] : ta.sma(close, 10)[2]) : ta.sma(close, 10)[1]
        ],
        barmerge.gaps_off, barmerge.lookahead_off
    )

f_pack_ex240() =>
    request.security(
        syminfo.tickerid, "240",
        [
            close,
            stableHTF ? (barstate.isconfirmed ? ta.sma(close, 10)    : ta.sma(close, 10)[1]) : ta.sma(close, 10),
            stableHTF ? (barstate.isconfirmed ? ta.sma(close, 10)[1] : ta.sma(close, 10)[2]) : ta.sma(close, 10)[1]
        ],
        barmerge.gaps_off, barmerge.lookahead_off
    )

//====================================================
// Build signals from packs
//====================================================
f_build_main(tfStr) =>
    [c, mid, midp, ma200, ma200p, rFix] = f_pack_main(tfStr)
    midPos = c >= mid ? 1 : -1
    maPos  = c >= ma200 ? 1 : -1
    midSlo = useSlope ? f_slopeSign(mid, midp, slopeFlatThr) : 0
    maSlo  = useSlope ? f_slopeSign(ma200, ma200p, slopeFlatThr) : 0
    allUp   = (midPos == 1 and midSlo == 1 and maPos == 1 and maSlo == 1)
    allDown = (midPos == -1 and midSlo == -1 and maPos == -1 and maSlo == -1)
    [midPos, midSlo, maPos, maSlo, rFix, allUp, allDown]

f_build_ex(c, sma, smap) =>
    cp = c >= sma ? 1 : -1
    sl = useSlope ? f_slopeSign(sma, smap, slopeFlatThr) : 0
    allUp   = (cp == 1 and sl == 1)
    allDown = (cp == -1 and sl == -1)
    [cp, sl, allUp, allDown]

// EX values (4 calls total)
[cl15, m15_10, m15_10p, m15_75, m15_75p] = f_pack_ex15()
[cl5,  m5_75,  m5_75p]                   = f_pack_ex5()
[cl60, h1_10,  h1_10p]                   = f_pack_ex60()
[cl240,h4_10,  h4_10p]                   = f_pack_ex240()

//====================================================
// ATR Ratio (2 calls total: HTF, LTF)
//====================================================
f_todayAvgATR(_atrLen, _minBars) =>
    atrLocal = ta.atr(_atrLen)
    newDay = ta.change(time("D")) != 0
    var float s = 0.0
    var int n = 0
    if barstate.isfirst or newDay
        s := 0.0
        n := 0
    s += atrLocal
    n += 1
    n >= _minBars ? (s / n) : na

f_prevDayAvgATR(_atrLen) =>
    atrLocal = ta.atr(_atrLen)
    newDay = ta.change(time("D")) != 0
    var float s = 0.0
    var int n = 0
    var float prevAvg = na
    if newDay
        prevAvg := (n > 0 ? (s / n) : na)
        s := 0.0
        n := 0
    s += atrLocal
    n += 1
    prevAvg

f_pack_ratio(tfStr) =>
    request.security(
        syminfo.tickerid, tfStr,
        [
            ta.atr(atrLen),
            avgMode == "Today (day avg)" ? f_todayAvgATR(atrLen, minBarsToday) :
             avgMode == "Yesterday (prev day avg)" ? f_prevDayAvgATR(atrLen) :
             ta.sma(ta.atr(atrLen), rollN)
        ],
        barmerge.gaps_off, barmerge.lookahead_off
    )

f_state(r) =>
    s = "NA"
    if na(r)
        s := "NA"
    else if r >= tradeTh
        s := "TRADE"
    else if r >= watchTh
        s := "WATCH"
    else if r < coolTh
        s := "COOL"
    else
        s := "MID"
    s

f_atrBg(st) =>
    st == "TRADE" ? atrTradeBg :
     st == "WATCH" ? atrWatchBg :
     st == "MID" ? atrMidBg :
     st == "COOL" ? atrCoolBg :
     reserveBg

[atrHTF, avgHTF] = f_pack_ratio(tfHTF)
[atrLTF, avgLTF] = f_pack_ratio(tfLTF)

ratioHTF = (not na(avgHTF) and avgHTF > 0) ? (atrHTF / avgHTF) : na
ratioLTF = (not na(avgLTF) and avgLTF > 0) ? (atrLTF / avgLTF) : na

stateHTF = f_state(ratioHTF)
stateLTF = f_state(ratioLTF)

//====================================================
// Chart plots (default OFF)
//====================================================
mid_chart   = ta.sma(midSrc, midLen)
ma200_chart = ta.sma(ma200Src, ma200Len)
plot(showMiddleOnChart ? mid_chart : na, "Middle", linewidth=2)
plot(show200OnChart    ? ma200_chart : na, "200SMA", linewidth=2)

plot(showExtraOnChart and show_A_M15_SMA10  ? m15_10 : na, "EX A 15m_10",  linewidth=extraWidth)
plot(showExtraOnChart and show_B_M5_SMA75   ? m5_75  : na, "EX B 5m_75",   linewidth=extraWidth)
plot(showExtraOnChart and show_C_M60_SMA10  ? h1_10  : na, "EX C 60m_10",  linewidth=extraWidth)
plot(showExtraOnChart and show_D_M15_SMA75  ? m15_75 : na, "EX D 15m_75",  linewidth=extraWidth)
plot(showExtraOnChart and show_E_M240_SMA10 ? h4_10  : na, "EX E 240m_10", linewidth=extraWidth)

//====================================================
// Table
//====================================================
var int COLS = 6
var int ROWS = 16
var table t = table.new(f_pos(panelPos), COLS, ROWS, frame_width=1)

f_cell(c, r, txt, bg, tc) =>
    table.cell(t, c, r, f_pad(txt), bgcolor=bg, text_color=tc, text_size=ts)

f_header() =>
    f_cell(0, 0, "TF",  headerBg, headerTc)
    f_cell(1, 0, "Mid", headerBg, headerTc)
    f_cell(2, 0, "Slo", headerBg, headerTc)
    f_cell(3, 0, "200", headerBg, headerTc)
    f_cell(4, 0, "Slo", headerBg, headerTc)
    f_cell(5, 0, "RSI", headerBg, headerTc)

f_main_row(row, tfStr) =>
    [midPos, midSlo, maPos, maSlo, rFix, allUp, allDown] = f_build_main(tfStr)
    tfCellBg = allUp ? tfAllUpBg : allDown ? tfAllDownBg : tfBg
    f_cell(0, row, tfStr, tfCellBg, tfTc)
    f_cell(1, row, f_arrowPos(midPos), f_bgBySign(midPos), tfTc)
    f_cell(2, row, useSlope ? f_arrowSlope(midSlo) : "－", f_bgBySign(midSlo), tfTc)
    f_cell(3, row, f_arrowPos(maPos),  f_bgBySign(maPos),  tfTc)
    f_cell(4, row, useSlope ? f_arrowSlope(maSlo) : "－", f_bgBySign(maSlo), tfTc)
    f_cell(5, row, str.tostring(rFix, "#.1"), f_rsiBg(rFix), rsiTc)

f_section(row, title) =>
    for c = 0 to COLS - 1
        f_cell(c, row, c == 0 ? title : "", secBg, secTc)

f_ex_row(row, label, enabled, c, sma, smap) =>
    if enabled
        [cp, sl, allUp, allDown] = f_build_ex(c, sma, smap)
        tfCellBg = allUp ? tfAllUpBg : allDown ? tfAllDownBg : tfBg
        f_cell(0, row, label, tfCellBg, tfTc)
        f_cell(1, row, f_arrowPos(cp), f_bgBySign(cp), tfTc)
        f_cell(2, row, useSlope ? f_arrowSlope(sl) : "－", f_bgBySign(sl), tfTc)
    else
        f_cell(0, row, "", tfBg, tfTc)
        f_cell(1, row, "", tfBg, tfTc)
        f_cell(2, row, "", tfBg, tfTc)

f_res_blank(row) =>
    f_cell(3, row, "", reserveBg, reserveTextCol)
    f_cell(4, row, "", reserveBg, reserveTextCol)
    f_cell(5, row, "", reserveBg, reserveTextCol)

f_atr_row(row, lab, val, bg) =>
    f_cell(3, row, lab, reserveBg, reserveTextCol)
    f_cell(4, row, val, bg, atrTc)
    f_cell(5, row, "",  bg, atrTc)

//====================================================
// Draw
//====================================================
if barstate.islast
    f_header()

    f_main_row(1, tf1)
    f_main_row(2, tf2)
    f_main_row(3, tf3)
    f_main_row(4, tf4)
    f_main_row(5, tf5)

    exStart = 6
    if showExtraInPanel
        f_section(exStart, "EX")

        // reserve header
        if enableAtrMini
            f_cell(3, exStart, "ATR", reserveBg, reserveTextCol)
            f_cell(4, exStart, "", reserveBg, reserveTextCol)
            f_cell(5, exStart, "", reserveBg, reserveTextCol)
        else
            f_res_blank(exStart)

        // A-E (left)
        f_ex_row(exStart + 1, "A", show_A_M15_SMA10,  cl15,  m15_10,  m15_10p)
        f_ex_row(exStart + 2, "B", show_B_M5_SMA75,   cl5,   m5_75,   m5_75p)
        f_ex_row(exStart + 3, "C", show_C_M60_SMA10,  cl60,  h1_10,   h1_10p)
        f_ex_row(exStart + 4, "D", show_D_M15_SMA75,  cl15,  m15_75,  m15_75p)
        f_ex_row(exStart + 5, "E", show_E_M240_SMA10, cl240, h4_10,   h4_10p)

        // ATR mini (right) fits 5 rows
        if enableAtrMini
            f_atr_row(exStart + 1, "AVG", avgMode == "Yesterday (prev day avg)" ? "YDAY" : avgMode == "Today (day avg)" ? "TODAY" : "ROLL", reserveBg)
            f_atr_row(exStart + 2, "HTF", stateHTF, f_atrBg(stateHTF))
            f_atr_row(exStart + 3, "LTF", stateLTF, f_atrBg(stateLTF))
            f_atr_row(exStart + 4, "H R", na(ratioHTF) ? "NA" : str.tostring(ratioHTF, "#.##"), f_atrBg(stateHTF))
            f_atr_row(exStart + 5, "L R", na(ratioLTF) ? "NA" : str.tostring(ratioLTF, "#.##"), f_atrBg(stateLTF))
        else
            f_res_blank(exStart + 1)
            f_res_blank(exStart + 2)
            f_res_blank(exStart + 3)
            f_res_blank(exStart + 4)
            f_res_blank(exStart + 5)
    else
        for r = exStart to exStart + 6
            for c = 0 to COLS - 1
                f_cell(c, r, "", tfBg, tfTc)
