//@version=5
indicator("Asset Executive ORB (4AM Breakout)", overlay=true, precision=2)

// --- Inputs ---
emaFastLen = input.int(50, "Fast EMA", group="Trend")
emaSlowLen = input.int(200, "Slow EMA", group="Trend")
showEMAs   = input.bool(true, "Show EMAs", group="Trend")

// --- 4 AM Level Logic ---
// We target the 04:00 - 05:00 candle on the 1H timeframe
// Using request.security to ensure accuracy regardless of your chart timeframe
[h4, l4] = request.security(syminfo.tickerid, "60", [high, low], lookahead=barmerge.lookahead_on)

var float high4am = na
var float low4am  = na

// Update levels only when the 4AM hour starts
if (hour == 4 and minute == 0)
    high4am := high
    low4am  := low

// Plotting the levels
plot(high4am, "4AM High", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)
plot(low4am, "4AM Low", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)

// --- EMA Calculations ---
ema50  = ta.ema(close, emaFastLen)
ema200 = ta.ema(close, emaSlowLen)

plot(showEMAs ? ema50 : na, "50 EMA", color=color.blue, linewidth=1)
plot(showEMAs ? ema200 : na, "200 EMA", color=color.white, linewidth=2)

// --- Volume Bias Logic ---
volAvg = ta.sma(volume, 20)
isBuyingVol  = close > open and volume > volAvg
isSellingVol = close < open and volume > volAvg

// Color Candles based on Volume Bias
barcolor(isBuyingVol ? color.green : isSellingVol ? color.red : color.gray)

// --- Signal Logic (The 10 AM Sweet Spot) ---
// We track if a signal has already fired today
var bool signalFired = false
if ta.change(time("D"))
    signalFired := false

// Strategy: Above/Below both EMAs + Break of 4AM Level
// Window: 09:45 to 11:00 (Focusing on the 10am break/retest)
is_trade_window = (hour == 9 and minute >= 45) or (hour == 10)

buySignal  = not signalFired and is_trade_window and close > high4am and close > ema50 and close > ema200 and isBuyingVol
sellSignal = not signalFired and is_trade_window and close < low4am  and close < ema50 and close < ema200 and isSellingVol

if (buySignal or sellSignal)
    signalFired := true

// Plot Labels
plotshape(buySignal,  title="BUY",  text="BUY",  style=shape.labelup,   location=location.belowbar, color=color.green, textcolor=color.white, size=size.small)
plotshape(sellSignal, title="SELL", text="SELL", style=shape.labeldown, location=location.abovebar, color=color.red,   textcolor=color.white, size=size.small)

// Alerts
alertcondition(buySignal,  title="4AM Level Buy Breakout",  message="Bullish Breakout above 4AM Level and EMAs")
alertcondition(sellSignal, title="4AM Level Sell Breakout", message="Bearish Breakout below 4AM Level and EMAs")
