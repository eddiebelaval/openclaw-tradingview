//@version=5
indicator("LIFER_5ma", shorttitle="LIFER_5ma", overlay=true, max_lines_count=500, max_labels_count=500)

// ── Simple Moving Averages (standard, no extra smoothing) ──
ma21  = ta.sma(close, 21)
ma50  = ta.sma(close, 50)
ma80  = ta.sma(close, 80)
ma100 = ta.sma(close, 100)
ma200 = ta.sma(close, 200)

// ── Plot each MA with your exact colors ──
plot(ma21,  color=color.white,  linewidth=2, title="21 MA")
plot(ma50,  color=color.red,    linewidth=2, title="50 MA")
plot(ma80,  color=color.purple, linewidth=2, title="80 MA")
plot(ma100, color=color.blue,   linewidth=2, title="100 MA")
plot(ma200, color=color.yellow, linewidth=2, title="200 MA")

// Optional: Background fill between 21 & 200 for quick visual (comment out if you don't want it)
fill(plot(ma21), plot(ma200), color=color.new(color.gray, 90), title="21-200 Fill")
