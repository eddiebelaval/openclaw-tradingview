//@version=5
indicator(title="MTM SMA- Momentum Indicator with SMA", shorttitle="MTM", format=format.price, precision=2, timeframe="")

// MTM - Momentum

// Description
// The Momentum indicator is a speed of movement indicator that is designed to identify the speed (or strength) of price movement. This indicator compares the current close price to the close price N bars ago and also displays a moving average of this difference.


N = input.int(21, title="N Value", minval=1)
fast = input.int(6, title="SMA Fast", minval=1)
slow = input.int(55, title="SMA Slow", minval=1)

mtm = close - close[N]
mtmma1 = ta.sma(mtm, fast)
mtmma2 = ta.sma(mtm, slow)
mtmhist = mtmma1 - mtmma2

macolor = color.rgb(0,0,0)

if mtmma1 < mtmma2
    macolor := color.rgb(255,0,0)

if mtmma1 > mtmma2
    macolor := color.rgb(0,128,0)

plotmtma1 = plot(mtmma1, title="MTM Fast", color=#2962FF)
//plotmtmma = plot(mtmma, title="MTMMA", color=#FF6D00)
plotmtmma2 = plot(mtmma2, title="MTM Slow", color=macolor, linewidth=2)
plotmtmhist = plot(mtmhist, style=plot.style_histogram, color=(mtmhist > 0 ? color.green : color.red), title="MTM 柱狀圖")
