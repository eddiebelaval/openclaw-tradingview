//@version=5
indicator("Trend filter [Jamallo]", overlay=true)

// =============================================================================
// INPUTS
// =============================================================================

grp_sig     = "Signal: Vervoort Stop"
vPeriod     = input.int(100, "Vervoort ATR Period", minval=1, group=grp_sig)
vMultiplier = input.float(0.5, "Vervoort Multiplier", minval=0.1, step=0.1, group=grp_sig)

grp_kal     = "Baseline: Kalman Filter"
kalmanAlpha = input.float(0.01, "Alpha", minval=0.001, maxval=1, step=0.001, group=grp_kal)
kalmanBeta  = input.float(0.1, "Beta", minval=0.01, maxval=1, step=0.01, group=grp_kal)
kalmanPeriod= input.int(100, "Period", minval=1, group=grp_kal)

grp_band    = "Bands: Original J-Trend"
show_inner  = input.bool(true, "Show Inner Bands", group=grp_band)
show_outer  = input.bool(true, "Show Outer Bands", group=grp_band)
dev_inner   = input.float(1.2, "Inner Deviation", step=0.1, group=grp_band)
dev_outer   = input.float(2.0, "Outer Deviation", step=0.1, group=grp_band)

grp_vis     = "Visuals"
col_up      = input.color(color.teal, "Bullish Color", group=grp_vis)
col_dn      = input.color(color.maroon, "Bearish Color", group=grp_vis)

// =============================================================================
// SIGNAL LINE: VERVOORT STOP
// =============================================================================

xClose = (open + high + low + close) / 4.0
v_atr  = ta.atr(vPeriod)
loss   = vMultiplier * v_atr

var float v_stop = 0.0
var bool trend_is_up = true

if bar_index == 0
    v_stop := close - loss
    trend_is_up := true
else
    float prev_v_stop = nz(v_stop[1], close - loss)
    trend_is_up := close > prev_v_stop

    if trend_is_up
        v_stop := math.max(prev_v_stop, xClose - loss)
    else
        v_stop := math.min(prev_v_stop, xClose + loss)

    if trend_is_up and close < v_stop
        trend_is_up := false
        v_stop := xClose + loss
    else if not trend_is_up and close > v_stop
        trend_is_up := true
        v_stop := xClose - loss

signal_line = v_stop

// =============================================================================
// BASELINE: KALMAN FILTER
// =============================================================================

var float v1 = close
var float v2 = 1.0

if bar_index <= 1
    v1 := close
else
    v3 = kalmanAlpha * kalmanPeriod
    v4 = v2 / (v2 + v3)
    v1 := v1 + v4 * (close - v1)
    v2 := (1 - v4) * v2 + kalmanBeta / kalmanPeriod

baseline = v1

// =============================================================================
// BANDS
// =============================================================================

vola_wma = ta.wma(high - low, 200)

upper_inner = baseline + vola_wma * dev_inner
lower_inner = baseline - vola_wma * dev_inner
upper_outer = baseline + vola_wma * dev_outer
lower_outer = baseline - vola_wma * dev_outer

// =============================================================================
// VISUALIZATION
// =============================================================================

bool is_bull   = signal_line >= baseline
color trend_col = is_bull ? col_up : col_dn

p_base = plot(baseline, "Kalman Baseline", color=trend_col, linewidth=2)
p_sig  = plot(signal_line, "Vervoort Signal", color=trend_col, linewidth=1)

fill(p_base, p_sig, color=color.new(trend_col, 85), title="Trend Cloud")

p_ui = plot(show_inner ? upper_inner : na, "Upper Inner", color=color.new(trend_col, 50))
p_li = plot(show_inner ? lower_inner : na, "Lower Inner", color=color.new(trend_col, 50))
p_uo = plot(show_outer ? upper_outer : na, "Upper Outer", color=color.new(color.blue, 60))
p_lo = plot(show_outer ? lower_outer : na, "Lower Outer", color=color.new(color.blue, 60))

fill(p_ui, p_uo, color=color.new(color.teal, 90),   title="Upper Band Fill")
fill(p_li, p_lo, color=color.new(color.maroon, 90), title="Lower Band Fill")

plotshape(ta.crossover(signal_line, baseline),  "Buy",  shape.triangleup,   location.belowbar, col_up, size=size.small)
plotshape(ta.crossunder(signal_line, baseline), "Sell", shape.triangledown, location.abovebar, col_dn, size=size.small)

alertcondition(ta.crossover(signal_line, baseline),  "Buy Signal",  "Vervoort crossed above Kalman Filter")
alertcondition(ta.crossunder(signal_line, baseline), "Sell Signal", "Vervoort crossed below Kalman Filter")
