//@version=6
indicator("Trendbasierte SMA-Farbfüllung (30m / Daily / Weekly)", overlay=true)


// =========================
// 30m-Block: SMA 65 + Signalfarben (exakt wie Original)
// =========================
is30m = (timeframe.period == "30" or timeframe.period == "30m")

// 65 SMA und Referenzwerte direkt auf der aktuellen Serie
sma65     = ta.sma(close, 65)
prevClose = close[1]
prevSma65 = sma65[1]
prevHigh  = high[1]
prevLow   = low[1]

// Richtung & Signale (wie im Original)
isSmaRising  = sma65 > sma65[1]
isSmaFalling = sma65 < sma65[1]
isGreen  = prevClose > sma65 and close > prevHigh and isSmaRising
isRed    = prevClose < sma65 and close < prevLow  and isSmaFalling
isYellow = (close < sma65 and prevClose > prevSma65) or (close > sma65 and prevClose < prevSma65)

// Füllfarbe: wie im Original (kein else → Farbe bleibt bestehen)
var color fillColor = na
if isGreen
    fillColor := color.new(color.green, 70)
else if isRed
    fillColor := color.new(color.red, 70)
else if isYellow
    fillColor := color.new(color.yellow, 70)
// kein else: Farbe bleibt erhalten

// Plots nur im 30m-Chart
pSma65 = plot(is30m ? sma65 : na, title="SMA 65 (30m)", color=color.blue, linewidth=2)
pClose = plot(is30m ? close  : na, title="Close", color=color.black, style=plot.style_line)

// Farbfüllung (außerhalb von lokalem Scope)
fill(pSma65, pClose, color = is30m ? fillColor : na)



// =========================
// Daily-SMAs: 18 und 8
// =========================
groupMTF = "MTF SMAs"

// SMA 18 Daily
showSMA18D = input.bool(true, "SMA 18 (Daily) anzeigen", group=groupMTF)
col18      = input.color(color.new(color.teal, 0), "Farbe SMA 18 (Daily)", group=groupMTF)
sma18D     = request.security(syminfo.tickerid, "D", ta.sma(close, 18))
plot(showSMA18D and timeframe.isdaily ? sma18D : na, title="SMA 18 (Daily)", color=col18, linewidth=2)

// SMA 8 Daily (neu)
showSMA8D = input.bool(true, "SMA 8 (Daily) anzeigen", group=groupMTF)
col8      = input.color(color.new(color.orange, 0), "Farbe SMA 8 (Daily)", group=groupMTF)
sma8D     = request.security(syminfo.tickerid, "D", ta.sma(close, 8))
plot(showSMA8D and timeframe.isdaily ? sma8D : na, title="SMA 8 (Daily)", color=col8, linewidth=2)



// =========================
// Weekly-SMA: 10
// =========================
showSMA10W = input.bool(true, "SMA 10 (Weekly) anzeigen", group=groupMTF)
col10      = input.color(color.new(color.purple, 0), "Farbe SMA 10 (Weekly)", group=groupMTF)
sma10W     = request.security(syminfo.tickerid, "W", ta.sma(close, 10))
plot(showSMA10W and timeframe.isweekly ? sma10W : na, title="SMA 10 (Weekly)", color=col10, linewidth=2)
