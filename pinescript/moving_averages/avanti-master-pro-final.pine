//@version=6
indicator("Avanti Master PRO FINAL", overlay=true)

//================ INPUT =================

instrument = input.string("NIFTY", options = ["NIFTY","OPTION","CRUDE","NATURAL GAS","STOCK"])

nifty_target = input.float(15,"Nifty Target")
nifty_sl = input.float(7.5,"Nifty SL")

crude_target = input.float(10,"Crude Target")
crude_sl = input.float(2.5,"Crude SL")

ng_target = input.float(2,"NG Target")
ng_sl = input.float(0.5,"NG SL")

stock_target = input.float(5,"Stock Target")
stock_sl = input.float(2,"Stock SL")

opt_target = input.float(20,"Option Target")
opt_sl = input.float(10,"Option SL")

rsiLen = input.int(14,"RSI Length")

//================ EMA =================

ema9 = ta.ema(close,9)
ema30 = ta.ema(close,30)
ema200 = ta.ema(close,200)

plot(ema9,color=color.blue)
plot(ema30,color=color.yellow)
plot(ema200,color=color.green,linewidth=2)

//================ RSI =================

rsiVal = ta.rsi(close,rsiLen)
rsi_round = math.round(rsiVal)

rsiColor =
 rsiVal > 55 ? color.green :
 rsiVal < 45 ? color.red :
 color.gray

//================ ADX =================

[plusDI, minusDI, adx] = ta.dmi(14,14)

adx_round = math.round(adx)

adxColor =
 adx > 25 ? color.blue :
 adx > 20 ? color.orange :
 color.gray

//================ BUILDUP =================

price_up = close > close[1]
price_down = close < close[1]

vol_up = volume > volume[1]
vol_down = volume < volume[1]

string buildup="Neutral"
color buildup_col=color.gray

if price_up and vol_up
    buildup := "Long Buildup"
    buildup_col := color.green
else if price_down and vol_up
    buildup := "Short Buildup"
    buildup_col := color.red
else if price_up and vol_down
    buildup := "Short Covering"
    buildup_col := color.blue
else if price_down and vol_down
    buildup := "Long Unwinding"
    buildup_col := color.orange

//================ SMART MONEY =================

smartLong = price_up and volume > volume[1]*1.5
smartShort = price_down and volume > volume[1]*1.5

//================ BREAKOUT SCORE =================

scoreBull = 0
scoreBull += ema9>ema30 ? 20 : 0
scoreBull += close>ema200 ? 15 : 0
scoreBull += rsiVal>55 ? 15 : 0
scoreBull += smartLong ? 25 : 0
scoreBull += buildup=="Long Buildup" ? 15 : 0
scoreBull += close>high[1] ? 10 : 0

scoreBear = 0
scoreBear += ema9<ema30 ? 20 : 0
scoreBear += close<ema200 ? 15 : 0
scoreBear += rsiVal<45 ? 15 : 0
scoreBear += smartShort ? 25 : 0
scoreBear += buildup=="Short Buildup" ? 15 : 0
scoreBear += close<low[1] ? 10 : 0

breakoutPerc = scoreBull
breakdownPerc = scoreBear

//================ SIGNAL =================

var int lastSignal = 0

buySignal =
 close>ema30 and
 close>high[1] and
 rsiVal>55 and
 breakoutPerc>breakdownPerc and
 lastSignal<=0

sellSignal =
 close<ema30 and
 close<low[1] and
 rsiVal<45 and
 breakdownPerc>breakoutPerc and
 lastSignal>=0

if buySignal
    lastSignal := 1

if sellSignal
    lastSignal := -1

//================ TARGET / SL =================

float target = na
float sl = na

if instrument == "NIFTY"
    target := nifty_target
    sl := nifty_sl

if instrument == "CRUDE"
    target := crude_target
    sl := crude_sl

if instrument == "NATURAL GAS"
    target := ng_target
    sl := ng_sl

if instrument == "STOCK"
    target := stock_target
    sl := stock_sl

if instrument == "OPTION"
    target := opt_target
    sl := opt_sl

//================ RR RATIO =================

tp1RR = 1.0
tp2RR = 1.5
tp3RR = 2.0

if instrument == "OPTION"
    tp1RR := 1
    tp2RR := 2
    tp3RR := 2.5

//================ LEVEL OBJECTS =================

var line lEntry = na
var line lSL = na
var line lTP1 = na
var line lTP2 = na
var line lTP3 = na

var label labEntry = na
var label labSL = na
var label labTP1 = na
var label labTP2 = na
var label labTP3 = na

lineBars = 20

if buySignal or sellSignal

    line.delete(lEntry)
    line.delete(lSL)
    line.delete(lTP1)
    line.delete(lTP2)
    line.delete(lTP3)

    label.delete(labEntry)
    label.delete(labSL)
    label.delete(labTP1)
    label.delete(labTP2)
    label.delete(labTP3)

    entry = close

    tp1 = entry + target * tp1RR
    tp2 = entry + target * tp2RR
    tp3 = entry + target * tp3RR
    slv = entry - sl

    if sellSignal
        tp1 := entry - target * tp1RR
        tp2 := entry - target * tp2RR
        tp3 := entry - target * tp3RR
        slv := entry + sl

    lEntry := line.new(bar_index,entry,bar_index+lineBars,entry,color=color.gray)
    lSL := line.new(bar_index,slv,bar_index+lineBars,slv,color=color.red,width=2)

    lTP1 := line.new(bar_index,tp1,bar_index+lineBars,tp1,color=color.green)
    lTP2 := line.new(bar_index,tp2,bar_index+lineBars,tp2,color=color.green)
    lTP3 := line.new(bar_index,tp3,bar_index+lineBars,tp3,color=color.green)

    labEntry := label.new(bar_index+lineBars,entry,"Entry "+str.tostring(entry),style=label.style_label_left,color=color.gray,textcolor=color.white)

    labSL := label.new(bar_index+lineBars,slv,"SL "+str.tostring(slv),style=label.style_label_left,color=color.red,textcolor=color.white)

    labTP1 := label.new(bar_index+lineBars,tp1,"TP1 "+str.tostring(tp1),style=label.style_label_left,color=color.green,textcolor=color.white)

    labTP2 := label.new(bar_index+lineBars,tp2,"TP2 "+str.tostring(tp2),style=label.style_label_left,color=color.green,textcolor=color.white)

    labTP3 := label.new(bar_index+lineBars,tp3,"TP3 "+str.tostring(tp3),style=label.style_label_left,color=color.green,textcolor=color.white)

//================ DASHBOARD =================

var table dash = table.new(position.top_right,2,14,border_width=1)

trendText =
 ema9 > ema30 ? "UP TREND" :
 ema9 < ema30 ? "DOWN TREND" :
 "SIDEWAYS"

trendColor =
 ema9 > ema30 ? color.green :
 ema9 < ema30 ? color.red :
 color.gray

trendStrength =
 adx > 35 ? "Strong Trend" :
 adx > 25 ? "Moderate Trend" :
 "Weak Trend"

tradeZone =
 ema9>ema30 ? "BUY ZONE" :
 ema9<ema30 ? "SELL ZONE" :
 "WAIT"

tradeColor =
 tradeZone == "BUY ZONE" ? color.green :
 tradeZone == "SELL ZONE" ? color.red :
 color.gray

smcText =
 smartLong ? "Smart Money Buying" :
 smartShort ? "Smart Money Selling" :
 "No Smart Money"

writerAction =
 buildup == "Long Buildup" ? "Call Writers Active" :
 buildup == "Short Buildup" ? "Put Writers Active" :
 "Neutral"

if barstate.islast

    table.cell(dash,0,0,"Timeframe",text_color=color.white)
    table.cell(dash,1,0,"Trend Status",text_color=color.white)

    table.cell(dash,0,1,"5 Min",text_color=color.white)
    table.cell(dash,1,1,trendText,bgcolor=trendColor,text_color=color.white)

    table.cell(dash,0,2,"15 Min",text_color=color.white)
    table.cell(dash,1,2,trendText,bgcolor=trendColor,text_color=color.white)

    table.cell(dash,0,3,"1 Hour",text_color=color.white)
    table.cell(dash,1,3,trendText,bgcolor=trendColor,text_color=color.white)

    table.cell(dash,0,4,"4 Hour",text_color=color.white)
    table.cell(dash,1,4,trendText,bgcolor=trendColor,text_color=color.white)

    table.cell(dash,0,5,"Buildup",text_color=color.white)
    table.cell(dash,1,5,buildup,bgcolor=buildup_col,text_color=color.white)

    table.cell(dash,0,6,"SMC",text_color=color.white)
    table.cell(dash,1,6,smcText,bgcolor=color.gray,text_color=color.white)

    table.cell(dash,0,7,"Writer Action",text_color=color.white)
    table.cell(dash,1,7,writerAction,bgcolor=color.blue,text_color=color.white)

    table.cell(dash,0,8,"RSI",text_color=color.white)
    table.cell(dash,1,8,str.tostring(rsi_round),bgcolor=rsiColor,text_color=color.white)

    table.cell(dash,0,9,"Breakout %",text_color=color.white)
    table.cell(dash,1,9,str.tostring(breakoutPerc)+" %",bgcolor=color.green,text_color=color.white)

    table.cell(dash,0,10,"Breakdown %",text_color=color.white)
    table.cell(dash,1,10,str.tostring(breakdownPerc)+" %",bgcolor=color.red,text_color=color.white)

    table.cell(dash,0,11,"ADX",text_color=color.white)
    table.cell(dash,1,11,str.tostring(adx_round),bgcolor=adxColor,text_color=color.white)

    table.cell(dash,0,12,"Trend Strength",text_color=color.white)
    table.cell(dash,1,12,trendStrength,bgcolor=color.orange,text_color=color.white)

    table.cell(dash,0,13,"Trade Zone",text_color=color.white)
    table.cell(dash,1,13,tradeZone,bgcolor=tradeColor,text_color=color.white)
