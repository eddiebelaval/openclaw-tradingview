//@version=6
indicator("Peterus - EMA + BB + RSI Signal System (v2.0)", shorttitle="Peterus - EMA + BB + RSI Signal System", overlay=true)

// v2.0 [improved alerts]
// - alerts can work on chart timeframe OR optional custom timeframe
// - repeated alerts limited by spacing logic
// - default spacing = 2 => alert on bar 1, 4, 7, 10...
// - improved RSI labels

//========================
// Inputs
//========================
src = input.source(close, "Source")

ema_type = input.string("ema", "EMAs Group MA Type", options=["sma","ema","wma","swma","vwma","hma","alma","rma","linreg"])
ema1_len = input.int(12,  "EMA1 length",  minval=0)
ema2_len = input.int(26,  "EMA2 length",  minval=0)
ema3_len = input.int(50,  "EMA3 length",  minval=0)
ema4_len = input.int(100, "EMA4 length",  minval=0)
ema5_len = input.int(200, "EMA5 length",  minval=0)

sma_type = input.string("sma", "SMAs Group MA Type", options=["sma","ema","wma","swma","vwma","hma","alma","rma","linreg"])
sma1_len = input.int(0,   "SMA1 length",  minval=0)
sma2_len = input.int(20,  "SMA2 length",  minval=0)
sma3_len = input.int(50,  "SMA3 length",  minval=0)
sma4_len = input.int(100, "SMA4 length",  minval=0)
sma5_len = input.int(200, "SMA5 length",  minval=0)

sma_bb_len = input.int(20, "BB length", minval=1)
bbStdDev   = input.float(2.0, "BB standard deviation", minval=0.1)

showEMAs = input.bool(true, "Show All EMAs")
showSMAs = input.bool(true, "Show All SMAs")
showBB   = input.bool(true, "Show All BB")

alma_offset   = input.float(0.85, "ALMA Offset (for alma only)", minval=0)
alma_sigma    = input.float(6.0,  "ALMA Sigma Smoothing (for alma only)", minval=0)
linreg_offset = input.int(0,      "Linreg Offset (for linreg only)", minval=0)

// RSI candle coloring
showRSIColors = input.bool(true, "Color candles by RSI")
rsiLen        = input.int(14, "RSI Length", minval=1)
rsiUpLevel    = input.float(70, "RSI UpLevel")
rsiDownLevel  = input.float(30, "RSI DownLevel")

// RSI value labels
showRSIValue = input.bool(true, "Show RSI value on candle (>upper / <lower)")
showOnlyFirstExtremeLabel = input.bool(false, "Show RSI label only on first extreme candle")

// Alert settings
useCustomTF   = input.bool(false, "Use custom timeframe for alerts?")
customAlertTF = input.timeframe("15", "Custom Alert TF")
useWickTouch  = input.bool(true, "BB touch by wick (else by close)")
alertSpacing  = input.int(2, "Bars to skip between repeated alerts", minval=0)
// alertSpacing = 2 => alert on streak 1, 4, 7, 10...
// alertSpacing = 3 => alert on streak 1, 5, 9, 13...

//========================
// Colors
//========================
color_transp = 20

ema1_color = color.new(color.aqua,   color_transp)
ema2_color = color.new(color.purple, color_transp)
ema3_color = color.new(color.rgb(204, 0, 0), color_transp)
ema4_color = color.new(color.rgb(255, 217, 102), color_transp)
ema5_color = color.new(color.rgb(17, 85, 204), color_transp)

sma1_color = color.new(color.aqua,  color_transp)
sma2_color = color.new(color.green, color_transp)
sma3_color = color.new(color.rgb(204, 0, 0), color_transp)
sma4_color = color.new(color.rgb(255, 217, 102), color_transp)
sma5_color = color.new(color.rgb(17, 85, 204), color_transp)

bb_border_color = color.new(color.rgb(61,133,198), 45)
bb_median_color = color.new(color.rgb(152,152,152), color_transp)
bb_bgcolor      = color.rgb(109,158,235)

//========================
// Functions
//========================
hma_func(_src, _length) =>
    _len = math.max(2, _length)
    half = math.max(1, int(math.floor(_len / 2.0)))
    sqrtLen = math.max(1, int(math.round(math.sqrt(_len))))
    ta.wma((2 * ta.wma(_src, half)) - ta.wma(_src, _len), sqrtLen)

ma(_src, _type, _length) =>
    _len = math.max(1, _length)
    switch _type
        "sma"    => ta.sma(_src, _len)
        "ema"    => ta.ema(_src, _len)
        "wma"    => ta.wma(_src, _len)
        "vwma"   => ta.vwma(_src, _len)
        "swma"   => ta.swma(_src)
        "hma"    => hma_func(_src, _len)
        "alma"   => ta.alma(_src, _len, alma_offset, alma_sigma)
        "rma"    => ta.rma(_src, _len)
        "linreg" => ta.linreg(_src, _len, linreg_offset)
        => na

//========================
// EMAs
//========================
ema1 = ema1_len > 0 ? ma(src, ema_type, ema1_len) : na
ema2 = ema2_len > 0 ? ma(src, ema_type, ema2_len) : na
ema3 = ema3_len > 0 ? ma(src, ema_type, ema3_len) : na
ema4 = ema4_len > 0 ? ma(src, ema_type, ema4_len) : na
ema5 = ema5_len > 0 ? ma(src, ema_type, ema5_len) : na

plot(showEMAs ? ema1 : na, color=ema1_color, linewidth=1, title="EMA1")
plot(showEMAs ? ema2 : na, color=ema2_color, linewidth=1, title="EMA2")
plot(showEMAs ? ema3 : na, color=ema3_color, linewidth=2, title="EMA3")
plot(showEMAs ? ema4 : na, color=ema4_color, linewidth=2, title="EMA4")
plot(showEMAs ? ema5 : na, color=ema5_color, linewidth=2, title="EMA5")

//========================
// SMAs
//========================
sma1 = sma1_len > 0 ? ma(src, sma_type, sma1_len) : na
sma2 = sma2_len > 0 ? ma(src, sma_type, sma2_len) : na
sma3 = sma3_len > 0 ? ma(src, sma_type, sma3_len) : na
sma4 = sma4_len > 0 ? ma(src, sma_type, sma4_len) : na
sma5 = sma5_len > 0 ? ma(src, sma_type, sma5_len) : na

plot(showSMAs ? sma1 : na, color=sma1_color, linewidth=1, title="SMA1", style=plot.style_circles)
plot(showSMAs ? sma2 : na, color=sma2_color, linewidth=1, title="SMA2", style=plot.style_circles)
plot(showSMAs ? sma3 : na, color=sma3_color, linewidth=2, title="SMA3", style=plot.style_circles)
plot(showSMAs ? sma4 : na, color=sma4_color, linewidth=2, title="SMA4", style=plot.style_circles)
plot(showSMAs ? sma5 : na, color=sma5_color, linewidth=2, title="SMA5", style=plot.style_circles)

//========================
// Bollinger Bands
//========================
bb_mid = ta.sma(src, sma_bb_len)
plot(showBB ? bb_mid : na, color=bb_median_color, linewidth=1, title="Middle BB")

bb_dev = ta.stdev(src, sma_bb_len) * bbStdDev
bb_up  = bb_mid + bb_dev
bb_dn  = bb_mid - bb_dev

p_up = plot(showBB ? bb_up : na, color=bb_border_color, linewidth=1, title="Upper BB")
p_dn = plot(showBB ? bb_dn : na, color=bb_border_color, linewidth=1, title="Lower BB")
fill(p_up, p_dn, color=color.new(bb_bgcolor, 90), title="BB Background")

//========================
// RSI candle coloring
//========================
rsi = ta.rsi(close, rsiLen)
isUp   = rsi > rsiUpLevel
isDown = rsi < rsiDownLevel
barcolor(showRSIColors ? (isUp ? color.green : isDown ? color.red : na) : na)

//========================
// RSI value label on candles (only extremes)
//========================
rsiExtreme = (rsi > rsiUpLevel) or (rsi < rsiDownLevel)
showThisLabel = showOnlyFirstExtremeLabel ? (rsiExtreme and not rsiExtreme[1]) : rsiExtreme

labelY = rsi > rsiUpLevel ? high : low
labelStyle = rsi > rsiUpLevel ? label.style_label_down : label.style_label_up
labelBg = rsi > rsiUpLevel ? color.red : color.green

if showRSIValue and showThisLabel
    label.new(
         x=bar_index,
         y=labelY,
         text=str.tostring(rsi, "#.0"),
         xloc=xloc.bar_index,
         yloc=yloc.price,
         style=labelStyle,
         color=labelBg,
         textcolor=color.white,
         size=size.small
     )

//========================
// ALERTS v2.0
// - chart timeframe by default
// - optional custom timeframe
//========================

// Values for alerts on current chart TF
chartHigh      = high
chartLow       = low
chartClose     = close
chartRSI       = rsi
chartBBup      = bb_up
chartBBdn      = bb_dn
chartConfirmed = barstate.isconfirmed

// Values for alerts on optional custom TF
tfHigh = useCustomTF ? request.security(syminfo.tickerid, customAlertTF, high) : chartHigh
tfLow  = useCustomTF ? request.security(syminfo.tickerid, customAlertTF, low) : chartLow
tfClose = useCustomTF ? request.security(syminfo.tickerid, customAlertTF, close) : chartClose
tfRSI   = useCustomTF ? request.security(syminfo.tickerid, customAlertTF, ta.rsi(close, rsiLen)) : chartRSI
tfBBup  = useCustomTF ? request.security(syminfo.tickerid, customAlertTF, ta.sma(src, sma_bb_len) + ta.stdev(src, sma_bb_len) * bbStdDev) : chartBBup
tfBBdn  = useCustomTF ? request.security(syminfo.tickerid, customAlertTF, ta.sma(src, sma_bb_len) - ta.stdev(src, sma_bb_len) * bbStdDev) : chartBBdn
tfConfirmed = useCustomTF ? request.security(syminfo.tickerid, customAlertTF, barstate.isconfirmed) : chartConfirmed

// Base touch logic
touchUpper = useWickTouch ? (tfHigh >= tfBBup) : (tfClose >= tfBBup)
touchLower = useWickTouch ? (tfLow  <= tfBBdn) : (tfClose <= tfBBdn)

// RSI logic
rsiHigh = tfRSI > rsiUpLevel
rsiLow  = tfRSI < rsiDownLevel

// Base signal
baseShortSignal = tfConfirmed and touchUpper and rsiHigh
baseLongSignal  = tfConfirmed and touchLower and rsiLow

// Consecutive streak counting
var int longStreak  = 0
var int shortStreak = 0

longStreak  := baseLongSignal  ? nz(longStreak[1])  + 1 : 0
shortStreak := baseShortSignal ? nz(shortStreak[1]) + 1 : 0

// Fire on 1st bar, then after skipping N bars
// alertSpacing = 2 => alerts on streak 1,4,7,10...
longSignalTF  = baseLongSignal  and ((longStreak  - 1) % (alertSpacing + 1) == 0)
shortSignalTF = baseShortSignal and ((shortStreak - 1) % (alertSpacing + 1) == 0)

comboSignalTF = longSignalTF or shortSignalTF

alertcondition(longSignalTF,  title="potencial LONG - Lower BB touch + RSI low",  message="Signal: potencial LONG - LOWER BB touched and RSI is below threshold on {{ticker}} {{interval}}")
alertcondition(shortSignalTF, title="potencial SHORT - Upper BB touch + RSI high", message="Signal: potencial SHORT - UPPER BB touched and RSI is above threshold on {{ticker}} {{interval}}")
alertcondition(comboSignalTF, title="Combo BB touch + RSI extreme (potencial LONG/SHORT)", message="Signal: BB outer touch + RSI extreme on {{ticker}} {{interval}}")
