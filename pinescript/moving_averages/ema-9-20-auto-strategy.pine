//@version=5
strategy("EMA 9 & 20 WunderTrading Auto Strategy", overlay=true, pyramiding=0)

// Inputs
fastEMA = input.int(9, title="Fast EMA (9)")
slowEMA = input.int(20, title="Slow EMA (20)")

// EMA Calculation
emaFast = ta.ema(close, fastEMA)
emaSlow = ta.ema(close, slowEMA)

// Plot EMAs
plot(emaFast, color=color.green, title="EMA 9")
plot(emaSlow, color=color.red, title="EMA 20")

// Conditions
longCondition = ta.crossover(emaFast, emaSlow)
shortCondition = ta.crossunder(emaFast, emaSlow)

// ===== LONG ENTRY =====
if (longCondition)
    strategy.close("Short", comment="EXIT SHORT")
    strategy.entry("Long", strategy.long, comment="ENTER LONG")

// ===== SHORT ENTRY =====
if (shortCondition)
    strategy.close("Long", comment="EXIT LONG")
    strategy.entry("Short", strategy.short, comment="ENTER SHORT")

// Plot Buy/Sell labels
plotshape(longCondition, title="Buy", location=location.belowbar, color=color.green, style=shape.labelup, text="BUY")
plotshape(shortCondition, title="Sell", location=location.abovebar, color=color.red, style=shape.labeldown, text="SELL")
