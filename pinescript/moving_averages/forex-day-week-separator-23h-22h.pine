//@version=5
indicator("Forex Day & Week Separator (23h-22h)", overlay=true, max_lines_count=500)

//────────── PARAMÈTRES ──────────
showDaySep   = input.bool(true, "Afficher séparation JOUR (23h → 22h)")
showWeekSep  = input.bool(true, "Afficher séparation SEMAINE (Dim 23h)")
lineWidth    = input.int(1, "Épaisseur des lignes", minval=1, maxval=3)

//────────── COULEURS ──────────
dayColor  = color.new(color.gray, 70)
weekColor = color.new(color.orange, 60)

//────────── HEURE UTC ──────────
curHour = hour(time, "UTC")
curDOW  = dayofweek(time, "UTC")

//────────── DÉBUT / FIN JOUR FOREX ──────────
// Début jour : 23h
newForexDay = curHour == 23 and curHour[1] != 23

// Fin jour : 22h
endForexDay = curHour == 22 and curHour[1] != 22

//────────── DÉBUT / FIN SEMAINE FOREX ──────────
// Début semaine : Dimanche 23h
newForexWeek = curDOW == dayofweek.sunday and curHour == 23 and not (curDOW[1] == dayofweek.sunday and curHour[1] == 23)

// Fin semaine : Vendredi 22h
endForexWeek = curDOW == dayofweek.friday and curHour == 22 and curHour[1] != 22

//────────── LIGNES JOUR ──────────
if showDaySep and newForexDay
    line.new(bar_index, high, bar_index, low, color=dayColor, width=lineWidth, style=line.style_dotted)

if showDaySep and endForexDay
    line.new(bar_index, high, bar_index, low, color=dayColor, width=lineWidth, style=line.style_dotted)

//────────── LIGNES SEMAINE ──────────
if showWeekSep and newForexWeek
    line.new(bar_index, high, bar_index, low, color=weekColor, width=lineWidth, style=line.style_dashed)

if showWeekSep and endForexWeek
    line.new(bar_index, high, bar_index, low, color=weekColor, width=lineWidth, style=line.style_dashed)

// Ligne dummy (obligatoire TradingView)
plot(na)
