//@version=6
indicator('Fiery River V.2.0 with Volatility', shorttitle = 'FR V2', overlay = true, timeframe = '')

// ---------- Входные параметры ----------
timeframe2 = input.timeframe('D', title = 'Второй таймфрейм')
maType = input.string(title = 'Тип скользящей средней', defval = 'EMA', options = ['EMA', 'SMA', 'WMA', 'RMA', 'HMA'])
period = input.int(title = 'Период скользящей средней', defval = 89, minval = 1, group = 'Выбор основы')

// Фибоначчи (первый таймфрейм)
fib1 = input.float(title = 'Серая', defval = .618, group = 'Данный таймфрейм')
fib2 = input.float(title = 'Красная', defval = .5, group = 'Данный таймфрейм')
fib3 = input.float(title = 'Оранжевая', defval = .382, group = 'Данный таймфрейм')
fib4 = input.float(title = 'Зелёная 1', defval = .27, group = 'Данный таймфрейм')
fib5 = input.float(title = 'Зелёная 2', defval = .18, group = 'Данный таймфрейм')
fib01 = input.float(title = 'Красная шорт', defval = 1.618, group = 'Данный таймфрейм')
fib02 = input.float(title = 'Оранжевая шорт', defval = 1.72, group = 'Данный таймфрейм')
fib03 = input.float(title = 'Зелёная шорт', defval = 1.89, group = 'Данный таймфрейм')

// Фибоначчи (второй таймфрейм)
fib6 = input.float(title = 'Серая', defval = .618, group = 'Второй таймфрейм')
fib7 = input.float(title = 'Красная', defval = .5, group = 'Второй таймфрейм')
fib8 = input.float(title = 'Оранжевая', defval = .382, group = 'Второй таймфрейм')
fib9 = input.float(title = 'Зелёная 1', defval = .27, group = 'Второй таймфрейм')
fib10 = input.float(title = 'Зелёная 2', defval = .18, group = 'Второй таймфрейм')
fib04 = input.float(title = 'Красная шорт', defval = 1.618, group = 'Второй таймфрейм')
fib05 = input.float(title = 'Оранжевая шорт', defval = 1.72, group = 'Второй таймфрейм')
fib06 = input.float(title = 'Зелёная шорт', defval = 1.89, group = 'Второй таймфрейм')

// ---------- Волатильность ----------
atrPeriod = input.int(title = 'Период ATR', defval = 13, minval = 1, group = 'Волатильность')
atr = ta.atr(atrPeriod)
atr2 = request.security(syminfo.tickerid, timeframe2, ta.atr(atrPeriod))

// ---------- Функция получения MA ----------
getMA(src, period) =>
    if maType == 'EMA'
        ta.ema(src, period)
    else if maType == 'SMA' 
        ta.sma(src, period)
    else if maType == 'WMA'
        ta.wma(src, period)
    else if maType == 'RMA'
        ta.rma(src, period)
    else if maType == 'HMA'
        ta.hma(src, period)

// ---------- MA ----------
ma = getMA(close, period)
ma2 = request.security(syminfo.tickerid, timeframe2, getMA(close, period))

// ---------- ОСНОВНАЯ ЛИНИЯ ----------
plot(ma, color=color.new(#5a5753, 50), title="Основная")

// ---------- Линии (основные) ----------
f1 = plot(ma * fib1 - atr, color = color.new(#434651, 0), linewidth = 1, title = 'Серая')
f2 = plot(ma * fib2 - atr, color = color.new(#F23645, 0), linewidth = 1, title = 'Красная')
f3 = plot(ma * fib3 - atr, color = color.new(#FF9800, 0), linewidth = 1, title = 'Оранжевая')
f4 = plot(ma * fib4 - atr, color = color.new(#4CAF50, 0), linewidth = 1, title = 'Зелёная 1')
f5 = plot(ma * fib5 - atr, color = color.new(#4CAF50, 0), linewidth = 1, title = 'Зелёная 2')
f01 = plot(ma * fib01 + atr * 2, color = color.new(#F23645, 0), linewidth = 1, title = 'Красная шорт')
f02 = plot(ma * fib02 + atr * 2, color = color.new(#FF9800, 0), linewidth = 1, title = 'Оранжевая шорт')
f03 = plot(ma * fib03 + atr * 2, color = color.new(#4CAF50, 0), linewidth = 1, title = 'Зелёная шорт')

// ---------- Линии (второй таймфрейм) ----------
f6 = plot(ma2 * fib6 - atr, color = color.new(#434651, 50), linewidth = 1, title = 'Серая второй')
f7 = plot(ma2 * fib7 - atr, color = color.new(#F23645, 50), linewidth = 1, title = 'Красная второй')
f8 = plot(ma2 * fib8 - atr, color = color.new(#FF9800, 50), linewidth = 1, title = 'Оранжевая второй')
f9 = plot(ma2 * fib9 - atr, color = color.new(#4CAF50, 50), linewidth = 1, title = 'Зелёная 1 второй')
f10 = plot(ma2 * fib10 - atr, color = color.new(#4CAF50, 50), linewidth = 1, title = 'Зелёная 2 второй')
f04 = plot(ma2 * fib04 + atr * 2, color = color.new(#F23645, 50), linewidth = 1, title = 'Красная шорт второй')
f05 = plot(ma2 * fib05 + atr * 2, color = color.new(#FF9800, 50), linewidth = 1, title = 'Оранжевая шорт второй')
f06 = plot(ma2 * fib06 + atr * 2, color = color.new(#4CAF50, 50), linewidth = 1, title = 'Зелёная шорт второй')

// ---------- Условия тревоги (пример) ----------
alertcondition(close == ma * fib1, title = 'Серая линия', message = 'Цена касается Серой линии')
alertcondition(close == ma * fib2, title = 'Красная линия', message = 'Цена касается Красной линии')
alertcondition(close == ma * fib3, title = 'Оранжевая линия', message = 'Цена касается Оранжевой линии')
alertcondition(close == ma * fib4, title = 'Зелёная 1 линия', message = 'Цена касается Зелёной 1 линии')
alertcondition(close == ma * fib5, title = 'Зелёная 2 линия', message = 'Цена касается Зелёной 2 линии')
alertcondition(close == ma * fib01, title = 'Красная шорт линия', message = 'Цена касается Красной шорт линии')
alertcondition(close == ma * fib02, title = 'Оранжевая шорт линия', message = 'Цена касается Оранжевой шорт линии')
alertcondition(close == ma * fib03, title = 'Зелёная шорт линия', message = 'Цена касается Зелёной шорт линии')
