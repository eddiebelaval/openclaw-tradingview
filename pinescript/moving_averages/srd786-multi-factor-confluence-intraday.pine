//@version=6
indicator("SRD786-Multi-Factor Confluence Intraday", overlay=true, format=format.price, precision=2)

// ============================================
// INPUTS
// ============================================

// Moving Averages
emaFastLength = input.int(9, "Fast EMA Length", group="Moving Averages", inline="ma1")
emaSlowLength = input.int(21, "Slow EMA Length", group="Moving Averages", inline="ma1")
smaLongLength = input.int(50, "Long SMA Length", group="Moving Averages", inline="ma2")

// Momentum
rsiLength = input.int(14, "RSI Length", group="Momentum", inline="mom1")
rsiOversoldLevel = input.int(30, "RSI Oversold", group="Momentum", inline="mom1")
rsiOverboughtLevel = input.int(70, "RSI Overbought", group="Momentum", inline="mom1")

macdFastLength = input.int(12, "MACD Fast", group="Momentum", inline="mom2")
macdSlowLength = input.int(26, "MACD Slow", group="Momentum", inline="mom2")
macdSignalLength = input.int(9, "MACD Signal", group="Momentum", inline="mom2")

stochLength = input.int(14, "Stochastic Length", group="Momentum", inline="mom3")
stochLevel = input.int(20, "Stochastic Level", group="Momentum", inline="mom3")

// Volatility
atrLength = input.int(14, "ATR Length", group="Volatility", inline="vol1")
bbLength = input.int(20, "BB Length", group="Volatility", inline="vol2")
bbStdDev = input.float(2.0, "BB Std Dev", group="Volatility", inline="vol2")

// Volume
volSMALength = input.int(20, "Volume SMA Length", group="Volume", inline="vol3")
volThreshold = input.float(1.5, "Volume Threshold", group="Volume", inline="vol3")

// Multi-Timeframe
htfLabel = input.timeframe("60", "Higher Timeframe", group="Multi-Timeframe")

// Risk Management
atrStopMult = input.float(1.5, "ATR Stop Multiplier", group="Risk Management", inline="risk1")
atrTargetMult = input.float(3.0, "ATR Target Multiplier", group="Risk Management", inline="risk1")

// Display Options
showSignals = input.bool(true, "Show Signals", group="Display")
showMA = input.bool(true, "Show Moving Averages", group="Display")
showBB = input.bool(true, "Show Bollinger Bands", group="Display")
showConfluence = input.bool(true, "Show Confluence Score", group="Display")

// ============================================
// HIGHER TIMEFRAME DATA
// ============================================

htfEma = request.security(syminfo.tickerid, htfLabel, ta.ema(close, emaSlowLength), lookahead=barmerge.lookahead_on)
htfClose = request.security(syminfo.tickerid, htfLabel, close[1], lookahead=barmerge.lookahead_on)
htfTrend = htfClose > htfEma ? 1 : -1

// ============================================
// VOLUME ANALYSIS
// ============================================

volSMA = ta.sma(volume, volSMALength)
volConfirm = volume > volSMA * volThreshold

// Manual OBV Calculation - On-Balance Volume
// FIXED: Extracted ta.change(close) to a separate variable to avoid duplicate function calls
priceChange = ta.change(close)
obvChange = priceChange > 0 ? volume : priceChange < 0 ? -volume : 0
obv = math.sum(obvChange, 1)
obvSMA = ta.sma(obv, 14)
obvConfirm = obv > obvSMA

// ============================================
// MOVING AVERAGES
// ============================================

emaFast = ta.ema(close, emaFastLength)
emaSlow = ta.ema(close, emaSlowLength)
smaLong = ta.sma(close, smaLongLength)

emaCrossUp = ta.crossover(emaFast, emaSlow)
emaCrossDown = ta.crossunder(emaFast, emaSlow)

emaTrendUp = close > smaLong and emaFast > emaSlow

// ============================================
// MOMENTUM INDICATORS
// ============================================

// RSI
rsi = ta.rsi(close, rsiLength)
rsiOversold = rsi < rsiOversoldLevel
rsiOverbought = rsi > rsiOverboughtLevel
rsiBullish = rsi > 50 and not rsiOverbought
rsiBearish = rsi < 50 and not rsiOversold

// MACD
[macdLine, signalLine, histLine] = ta.macd(close, macdFastLength, macdSlowLength, macdSignalLength)
macdCrossUp = ta.crossover(macdLine, signalLine)
macdCrossDown = ta.crossunder(macdLine, signalLine)
macdBullish = macdLine > signalLine and histLine > 0
macdBearish = macdLine < signalLine and histLine < 0

// Stochastic
stochK = ta.stoch(close, high, low, stochLength)
stochD = ta.sma(stochK, 3)
stochOversold = stochK < stochLevel and stochD < stochLevel
stochOverbought = stochK > (100 - stochLevel) and stochD > (100 - stochLevel)
stochBullish = stochK > stochD
stochBearish = stochK < stochD

// ============================================
// VOLATILITY
// ============================================

atrValue = ta.atr(atrLength)

// Bollinger Bands
[bbUpper, bbMiddle, bbLower] = ta.bb(close, bbLength, bbStdDev)
bbWidth = (bbUpper - bbLower) / bbMiddle * 100

priceInBBUpper = close > bbUpper
priceInBBLower = close < bbLower

// ============================================
// PRICE ACTION
// ============================================

// Pivot Points
pivotHigh = ta.pivothigh(2, 2)
pivotLow = ta.pivotlow(2, 2)

// Support/Resistance
resistance = ta.highest(high, 20)
support = ta.lowest(low, 20)

// ============================================
// CONFLUENCE SCORING
// ============================================

// Volume score
volScore = (volConfirm ? 10 : 0) + (obvConfirm ? 5 : 0)

// Trend score
trendScore = (emaTrendUp ? 15 : 0) + (htfTrend > 0 ? 10 : 0)

// Momentum score
rsiScore = rsiBullish ? 10 : (rsiBearish ? 10 : 0)
macdScore = macdBullish ? 10 : (macdBearish ? 10 : 0)
stochScore = stochBullish and not stochOverbought ? 5 : (stochBearish and not stochOversold ? 5 : 0)
momScore = rsiScore + macdScore + stochScore

// Price action score
paScore = (not priceInBBUpper and not priceInBBLower ? 10 : 0) + (not na(pivotLow) ? 5 : 0)

// Total confluence score (0-100)
confluenceScore = volScore + trendScore + momScore + paScore

// ============================================
// TRADING SIGNALS
// ============================================

// Long Signal - Multiple factor confluence
longSignal = 
     emaCrossUp and 
     volConfirm and 
     (rsi > 50 or rsiOversold) and 
     macdBullish and 
     (not stochOverbought) and 
     (close > smaLong) and 
     (confluenceScore >= 65)

// Short Signal - Multiple factor confluence
shortSignal = 
     emaCrossDown and 
     volConfirm and 
     (rsi < 50 or rsiOverbought) and 
     macdBearish and 
     (not stochOversold) and 
     (close < smaLong) and 
     (confluenceScore >= 65)

// ============================================
// ENTRY, STOP LOSS, TARGET
// ============================================

var float entryPrice = na
var float stopLoss = na
var float targetPrice = na
var float riskReward = na
var int activeDirection = 0  // 1 = long, -1 = short

// Update on new signal
if (longSignal and (activeDirection != 1))
    entryPrice := close
    stopLoss := close - atrValue * atrStopMult
    targetPrice := close + (atrValue * atrStopMult) * atrTargetMult
    riskReward := atrTargetMult
    activeDirection := 1
    
else if (shortSignal and (activeDirection != -1))
    entryPrice := close
    stopLoss := close + atrValue * atrStopMult
    targetPrice := close - (atrValue * atrStopMult) * atrTargetMult
    riskReward := atrTargetMult
    activeDirection := -1
    
else
    // Keep existing values until new signal
    activeDirection := activeDirection

// ============================================
// PLOTTING
// ============================================

// Moving Averages
plot(showMA ? emaFast : na, "Fast EMA", color=color.orange, linewidth=1)
plot(showMA ? emaSlow : na, "Slow EMA", color=color.blue, linewidth=2)
plot(showMA ? smaLong : na, "Long SMA", color=color.purple, linewidth=2)

// Bollinger Bands - FIXED: Changed linestyle to style, plot.style_dotted to plot.style_circles
plot(showBB ? bbUpper : na, "BB Upper", color=color.gray, style=plot.style_circles)
plot(showBB ? bbMiddle : na, "BB Middle", color=color.gray)
plot(showBB ? bbLower : na, "BB Lower", color=color.gray, style=plot.style_circles)

// Higher Timeframe Trend Line
plot(showMA ? htfTrend > 0 ? htfEma : na : na, "HTF EMA Bull", color=color.yellow, linewidth=2)
plot(showMA ? htfTrend < 0 ? htfEma : na : na, "HTF EMA Bear", color=color.maroon, linewidth=2)

// Signals
plotshape(showSignals and longSignal, title="Long Signal", location=location.belowbar, 
     color=color.lime, style=shape.triangleup, size=size.large, text="LONG")
plotshape(showSignals and shortSignal, title="Short Signal", location=location.abovebar, 
     color=color.red, style=shape.triangledown, size=size.large, text="SHORT")

// Confluence Score Histogram
plot(showConfluence ? confluenceScore : na, "Confluence", color=color.new(color.teal, 30), 
     linewidth=3, style=plot.style_histogram, display=display.pane)

// ============================================
// INFORMATION TABLE
// ============================================

var table infoTable = table.new(position.bottom_right, 4, 12, 
     bgcolor=color.new(color.black, 80), border_color=color.gray, border_width=1)

if (barstate.islast)
    // Header
    table.cell(infoTable, 0, 0, "INDICATOR", bgcolor=color.gray, text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 1, 0, "VALUE", bgcolor=color.gray, text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 2, 0, "STATUS", bgcolor=color.gray, text_color=color.white, text_size=size.tiny)
    
    // Confluence Score
    table.cell(infoTable, 0, 1, "Confluence", text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 1, 1, str.tostring(confluenceScore, "#"), 
         bgcolor=confluenceScore >= 65 ? color.green : (confluenceScore >= 50 ? color.orange : color.red), 
         text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 2, 1, confluenceScore >= 65 ? "STRONG" : (confluenceScore >= 50 ? "MODERATE" : "WEAK"), 
         bgcolor=confluenceScore >= 65 ? color.green : (confluenceScore >= 50 ? color.orange : color.red), 
         text_color=color.white, text_size=size.tiny)
    
    // Entry Price
    table.cell(infoTable, 0, 2, "Entry", text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 1, 2, str.tostring(entryPrice, format.mintick), 
         bgcolor=color.blue, text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 2, 2, activeDirection == 1 ? "LONG" : (activeDirection == -1 ? "SHORT" : "---"), 
         bgcolor=activeDirection == 1 ? color.green : (activeDirection == -1 ? color.red : color.gray), 
         text_color=color.white, text_size=size.tiny)
    
    // Stop Loss
    table.cell(infoTable, 0, 3, "Stop Loss", text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 1, 3, str.tostring(stopLoss, format.mintick), 
         bgcolor=color.red, text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 2, 3, activeDirection != 0 ? "1:" + str.tostring(atrStopMult, "#.#") + "R" : "---", 
         bgcolor=color.red, text_color=color.white, text_size=size.tiny)
    
    // Target Price
    table.cell(infoTable, 0, 4, "Target (1:2)", text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 1, 4, str.tostring(targetPrice, format.mintick), 
         bgcolor=color.green, text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 2, 4, activeDirection != 0 ? "1:" + str.tostring(riskReward, "#.#") + "R" : "---", 
         bgcolor=color.green, text_color=color.white, text_size=size.tiny)
    
    // RSI
    table.cell(infoTable, 0, 5, "RSI", text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 1, 5, str.tostring(rsi, "#.##"), 
         bgcolor=rsi > 50 ? color.green : color.red, text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 2, 5, rsiOverbought ? "OVERBOUGHT" : (rsiOversold ? "OVERSOLD" : "NEUTRAL"), 
         bgcolor=rsiOverbought ? color.red : (rsiOversold ? color.green : color.gray), 
         text_color=color.white, text_size=size.tiny)
    
    // MACD
    table.cell(infoTable, 0, 6, "MACD", text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 1, 6, macdBullish ? "BULLISH" : "BEARISH", 
         bgcolor=macdBullish ? color.green : color.red, text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 2, 6, str.tostring(histLine, "#.####"), 
         bgcolor=color.gray, text_color=color.white, text_size=size.tiny)
    
    // Stochastic
    table.cell(infoTable, 0, 7, "Stochastic", text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 1, 7, str.tostring(stochK, "#.##"), 
         bgcolor=stochBullish ? color.green : color.red, text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 2, 7, stochOverbought ? "OVERBOUGHT" : (stochOversold ? "OVERSOLD" : "NEUTRAL"), 
         bgcolor=stochOverbought ? color.red : (stochOversold ? color.green : color.gray), 
         text_color=color.white, text_size=size.tiny)
    
    // HTF Trend
    table.cell(infoTable, 0, 8, "HTF Trend", text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 1, 8, htfTrend > 0 ? "UPTREND" : "DOWNTREND", 
         bgcolor=htfTrend > 0 ? color.green : color.red, text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 2, 8, htfLabel, bgcolor=color.gray, text_color=color.white, text_size=size.tiny)
    
    // Volume
    table.cell(infoTable, 0, 9, "Volume", text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 1, 9, str.tostring(volume / 1000000, "#.##") + "M", 
         bgcolor=color.gray, text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 2, 9, volConfirm ? "CONFIRMED" : "LOW", 
         bgcolor=volConfirm ? color.green : color.red, text_color=color.white, text_size=size.tiny)
    
    // ATR
    table.cell(infoTable, 0, 10, "ATR", text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 1, 10, str.tostring(atrValue, format.mintick), 
         bgcolor=color.gray, text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 2, 10, "Stop:" + str.tostring(atrStopMult, "#.#") + " Target:" + str.tostring(atrTargetMult, "#.#"), 
         bgcolor=color.gray, text_color=color.white, text_size=size.tiny)

// ============================================
// ALERTS
// ============================================

alertcondition(longSignal, title="Long Signal Alert", message="Long Entry - Confluence: {{plot(confluence_score)}}")
alertcondition(shortSignal, title="Short Signal Alert", message="Short Entry - Confluence: {{plot(confluence_score)}}")
