//@version=6
indicator("Universal Day Trader Bundle", overlay=true)

// --- 1. USER INPUTS (Toggles) ---
showEMA1  = input.bool(false, "Show EMA 1", group="Display Settings")
showEMA9  = input.bool(true,  "Show EMA 9", group="Display Settings")
showEMA20 = input.bool(true,  "Show EMA 20", group="Display Settings")
showVWAP  = input.bool(true,  "Show VWAP", group="Display Settings")
showOpen  = input.bool(true,  "Show Opening Price", group="Display Settings")
showVol   = input.bool(true,  "Show Volume", group="Display Settings")

// --- 2. INDICATOR LOGIC ---
ema1Val  = ta.ema(close, 1)
ema9Val  = ta.ema(close, 9)
ema20Val = ta.ema(close, 20)
vwapVal  = ta.vwap(close)

// Opening Price Logic (Fixed Boolean Error)
var float openPrice = na
isNewDay = ta.change(time("D")) != 0
if isNewDay or barstate.isfirst
    openPrice := open

// --- 3. PLOTTING ---
plot(showEMA1  ? ema1Val  : na, color=color.gray,   title="EMA 1")
plot(showEMA9  ? ema9Val  : na, color=color.yellow, title="EMA 9",  linewidth=1)
plot(showEMA20 ? ema20Val : na, color=color.blue,   title="EMA 20", linewidth=1)
plot(showVWAP  ? vwapVal  : na, color=color.orange, title="VWAP",   linewidth=2)
plot(showOpen  ? openPrice : na, color=color.white,  title="Opening Price", style=plot.style_linebr, linewidth=2)

// Volume (Histogram at bottom)
volColor = close > open ? color.new(color.green, 80) : color.new(color.red, 80)
plot(showVol ? volume : na, title="Volume", color=volColor, style=plot.style_columns, histbase=0, display=display.data_window)

// --- 4. ALERTS (EMA 9 Cross EMA 20) ---
longCondition  = ta.crossover(ema9Val, ema20Val)
shortCondition = ta.crossunder(ema9Val, ema20Val)

// Visual triggers on chart
plotshape(longCondition,  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small, title="Bullish Cross Label")
plotshape(shortCondition, style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small, title="Bearish Cross Label")

// Alert Notifications
alertcondition(longCondition,  title="EMA Bullish Cross",  message="EMA 9 crossed ABOVE EMA 20 on {{interval}} timeframe!")
alertcondition(shortCondition, title="EMA Bearish Cross", message="EMA 9 crossed BELOW EMA 20 on {{interval}} timeframe!")
