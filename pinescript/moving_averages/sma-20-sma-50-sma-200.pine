//@version=5
indicator("SMA 20, SMA 50 & SMA 200", overlay=true)

// Input pentru grosimea liniilor
lineWidth = input.int(1, title="Line Width", minval=1, maxval=5)

// Input pentru culoarea textului
textColor = input.color(color.white, title="Text Color")

// Calculul mediilor mobile
sma20 = ta.sma(close, 20)
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)

// Afișarea liniilor SMA cu grosime personalizabilă
plot(sma20, color=color.blue, linewidth=lineWidth, title="SMA 20")
plot(sma50, color=color.red, linewidth=lineWidth, title="SMA 50")
plot(sma200, color=color.green, linewidth=lineWidth, title="SMA 200")

// Afișarea textului în dreapta graficului
var label sma20Label = label.new(x=na, y=na, text="", style=label.style_none)
var label sma50Label = label.new(x=na, y=na, text="", style=label.style_none)
var label sma200Label = label.new(x=na, y=na, text="", style=label.style_none)

// Actualizare poziție și text etichete
label.set_xy(sma20Label, bar_index + 1, sma20)
label.set_text(sma20Label, "SMA 20")
label.set_color(sma20Label, color.blue)
label.set_textcolor(sma20Label, textColor)

label.set_xy(sma50Label, bar_index + 1, sma50)
label.set_text(sma50Label, "SMA 50")
label.set_color(sma50Label, color.red)
label.set_textcolor(sma50Label, textColor)

label.set_xy(sma200Label, bar_index + 1, sma200)
label.set_text(sma200Label, "SMA 200")
label.set_color(sma200Label, color.green)
label.set_textcolor(sma200Label, textColor)
