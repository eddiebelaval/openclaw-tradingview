//@version=5
indicator("EMA Rainbow (3 Bands, 9 EMAs, Anchors + Opacity)", overlay=true)

//----------------------------
// Inputs
//----------------------------
b1_start = input.int(20,  "Band 1 Start")
b1_end   = input.int(60,  "Band 1 End")

b2_start = input.int(60,  "Band 2 Start")
b2_end   = input.int(120, "Band 2 End")

b3_start = input.int(120, "Band 3 Start")
b3_end   = input.int(300, "Band 3 End")

//----------------------------
// Step sizes (floats)
//----------------------------
b1_step = (b1_end - b1_start) / 8.0
b2_step = (b2_end - b2_start) / 8.0
b3_step = (b3_end - b3_start) / 8.0

//----------------------------
// Band 1 EMAs (cast lengths to int)
//----------------------------
b1_1 = ta.ema(close, int(b1_start + b1_step * 0))
b1_2 = ta.ema(close, int(b1_start + b1_step * 1))
b1_3 = ta.ema(close, int(b1_start + b1_step * 2))
b1_4 = ta.ema(close, int(b1_start + b1_step * 3))
b1_5 = ta.ema(close, int(b1_start + b1_step * 4))
b1_6 = ta.ema(close, int(b1_start + b1_step * 5))
b1_7 = ta.ema(close, int(b1_start + b1_step * 6))
b1_8 = ta.ema(close, int(b1_start + b1_step * 7))
b1_9 = ta.ema(close, int(b1_start + b1_step * 8))   // anchor

//----------------------------
// Band 2 EMAs
//----------------------------
b2_1 = ta.ema(close, int(b2_start + b2_step * 0))
b2_2 = ta.ema(close, int(b2_start + b2_step * 1))
b2_3 = ta.ema(close, int(b2_start + b2_step * 2))
b2_4 = ta.ema(close, int(b2_start + b2_step * 3))
b2_5 = ta.ema(close, int(b2_start + b2_step * 4))
b2_6 = ta.ema(close, int(b2_start + b2_step * 5))
b2_7 = ta.ema(close, int(b2_start + b2_step * 6))
b2_8 = ta.ema(close, int(b2_start + b2_step * 7))
b2_9 = ta.ema(close, int(b2_start + b2_step * 8))   // anchor

//----------------------------
// Band 3 EMAs
//----------------------------
b3_1 = ta.ema(close, int(b3_start + b3_step * 0))
b3_2 = ta.ema(close, int(b3_start + b3_step * 1))
b3_3 = ta.ema(close, int(b3_start + b3_step * 2))
b3_4 = ta.ema(close, int(b3_start + b3_step * 3))
b3_5 = ta.ema(close, int(b3_start + b3_step * 4))
b3_6 = ta.ema(close, int(b3_start + b3_step * 5))
b3_7 = ta.ema(close, int(b3_start + b3_step * 6))
b3_8 = ta.ema(close, int(b3_start + b3_step * 7))
b3_9 = ta.ema(close, int(b3_start + b3_step * 8))   // anchor

//----------------------------
// Plot Band 1 (reds)
// inner ~30% opacity (transp=70), anchor solid
//----------------------------
plot(b1_1, title="B1-1", color=color.new(#FF9999, 70), linewidth=1)
plot(b1_2, title="B1-2", color=color.new(#FF8888, 70), linewidth=1)
plot(b1_3, title="B1-3", color=color.new(#FF7777, 70), linewidth=1)
plot(b1_4, title="B1-4", color=color.new(#FF6666, 70), linewidth=1)
plot(b1_5, title="B1-5", color=color.new(#FF5555, 70), linewidth=1)
plot(b1_6, title="B1-6", color=color.new(#FF4444, 70), linewidth=1)
plot(b1_7, title="B1-7", color=color.new(#FF3333, 70), linewidth=1)
plot(b1_8, title="B1-8", color=color.new(#FF2222, 70), linewidth=1)
plot(b1_9, title="B1-Anchor", color=color.new(#CC0000, 0), linewidth=3)

//----------------------------
// Plot Band 2 (greens)
//----------------------------
plot(b2_1, title="B2-1", color=color.new(#99FF99, 70), linewidth=1)
plot(b2_2, title="B2-2", color=color.new(#88FF88, 70), linewidth=1)
plot(b2_3, title="B2-3", color=color.new(#77FF77, 70), linewidth=1)
plot(b2_4, title="B2-4", color=color.new(#66FF66, 70), linewidth=1)
plot(b2_5, title="B2-5", color=color.new(#55FF55, 70), linewidth=1)
plot(b2_6, title="B2-6", color=color.new(#44FF44, 70), linewidth=1)
plot(b2_7, title="B2-7", color=color.new(#33FF33, 70), linewidth=1)
plot(b2_8, title="B2-8", color=color.new(#22FF22, 70), linewidth=1)
plot(b2_9, title="B2-Anchor", color=color.new(#009900, 0), linewidth=3)

//----------------------------
// Plot Band 3 (blues)
//----------------------------
plot(b3_1, title="B3-1", color=color.new(#9999FF, 70), linewidth=1)
plot(b3_2, title="B3-2", color=color.new(#8888FF, 70), linewidth=1)
plot(b3_3, title="B3-3", color=color.new(#7777FF, 70), linewidth=1)
plot(b3_4, title="B3-4", color=color.new(#6666FF, 70), linewidth=1)
plot(b3_5, title="B3-5", color=color.new(#5555FF, 70), linewidth=1)
plot(b3_6, title="B3-6", color=color.new(#4444FF, 70), linewidth=1)
plot(b3_7, title="B3-7", color=color.new(#3333FF, 70), linewidth=1)
plot(b3_8, title="B3-8", color=color.new(#2222FF, 70), linewidth=1)
plot(b3_9, title="B3-Anchor", color=color.new(#0000CC, 0), linewidth=3)
