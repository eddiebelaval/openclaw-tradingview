//@version=5
indicator("Stratégie EMA Multi-TF + Filtre Rouge", overlay=true)

// --- PARAMÈTRES ---
ema6_len  = 6
ema9_len  = 9
ema12_len = 12

// --- FONCTION POUR RÉCUPÉRER L'ÉTAT + FILTRE CROISEMENT ---
get_ema_data(tf) =>
    e6  = request.security(syminfo.tickerid, tf, ta.ema(close, ema6_len))
    e9  = request.security(syminfo.tickerid, tf, ta.ema(close, ema9_len))
    e12 = request.security(syminfo.tickerid, tf, ta.ema(close, ema12_len))
    c   = request.security(syminfo.tickerid, tf, close)
    h   = request.security(syminfo.tickerid, tf, high)
    l   = request.security(syminfo.tickerid, tf, low)
    
    // Condition de non-croisement : la bougie entière doit être d'un côté de l'EMA Rouge
    // Pour un achat : le plus bas de la bougie doit être au-dessus de l'EMA 12
    no_touch_bull = l > e12
    // Pour une vente : le plus haut de la bougie doit être en dessous de l'EMA 12
    no_touch_bear = h < e12
    
    bull = (e6 > e9) and (e9 > e12) and no_touch_bull
    bear = (e6 < e9) and (e9 < e12) and no_touch_bear
    [bull, bear]

// --- RÉCUPÉRATION SUR LES 3 TIMEFRAMES ---
[bull5, bear5]   = get_ema_data("5")
[bull15, bear15] = get_ema_data("15")
[bull60, bear60] = get_ema_data("60")

// --- CONDITIONS FINALES ---
longCondition  = bull5 and bull15 and bull60
shortCondition = bear5 and bear15 and bear60

// --- AFFICHAGE ---
plot(ta.ema(close, ema6_len),  "EMA 6 Jaune", color=color.yellow, linewidth=2)
plot(ta.ema(close, ema9_len),  "EMA 9 Verte", color=color.green,  linewidth=2)
plot(ta.ema(close, ema12_len), "EMA 12 Rouge", color=color.red,    linewidth=2)

plotshape(longCondition and not longCondition[1],  "ACHAT",  shape.triangleup,   location.belowbar, color.lime, size=size.small, text="ACHAT CLAIR")
plotshape(shortCondition and not shortCondition[1], "VENTE", shape.triangledown, location.abovebar, color.red,  size=size.small, text="VENTE CLAIRE")

bgcolor(longCondition ? color.new(color.lime, 90) : shortCondition ? color.new(color.red, 90) : na)

// --- ALERTES ---
if (longCondition and not longCondition[1])
    alert("🚀 ACHAT CONFIRMÉ (Pas de contact Rouge) sur " + syminfo.ticker, alert.freq_once_per_bar_close)

if (shortCondition and not shortCondition[1])
    alert("📉 VENTE CONFIRMÉE (Pas de contact Rouge) sur " + syminfo.ticker, alert.freq_once_per_bar_close)
