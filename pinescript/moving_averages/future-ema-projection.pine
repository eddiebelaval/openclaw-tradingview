//@version=6
indicator("Future EMA Projection", overlay=true, max_lines_count=500)

// --- 1. User Inputs ---
grp1 = "EMA Settings"
int len1 = input.int(10, "EMA 1 Length", group=grp1)
int len2 = input.int(20, "EMA 2 Length", group=grp1)
int len3 = input.int(50, "EMA 3 Length", group=grp1)

grp2 = "Future Projection Settings"
int projBars = input.int(60, "Bars to Project", group=grp2)

// Removed 'inline' so these stack vertically with fully readable, descriptive text
string priceMode = input.string("Last Close", "Price Assumption", options=["Last Close", "Custom Price"], group=grp2)
float customPrice = input.float(8.12, "Custom Price (If Selected)", group=grp2)

// --- 2. Calculate Current Historical EMAs ---
float ema1 = ta.ema(close, len1)
float ema2 = ta.ema(close, len2)
float ema3 = ta.ema(close, len3)

// Plot the historical EMAs on the chart (solid lines)
plot(ema1, color=color.blue, title="Historical EMA 1", linewidth=2)
plot(ema2, color=color.teal, title="Historical EMA 2", linewidth=2)
plot(ema3, color=color.purple, title="Historical EMA 3", linewidth=2)

// --- 3. Future Projection Logic (Only runs on the very last bar) ---
if barstate.islast
    // Determine the hypothetical future price based on user selection
    float targetPrice = priceMode == "Last Close" ? close : customPrice
    
    // Set starting points for the projection
    float current_ema1 = ema1
    float current_ema2 = ema2
    float current_ema3 = ema3
    
    // EMA Smoothing Constants (Alpha) - Forced float division for v6 safety
    float alpha1 = 2.0 / (len1 + 1)
    float alpha2 = 2.0 / (len2 + 1)
    float alpha3 = 2.0 / (len3 + 1)

    // Loop to draw into the future
    for i = 1 to projBars
        // Calculate the next step using the EMA formula
        float next_ema1 = (targetPrice - current_ema1) * alpha1 + current_ema1
        float next_ema2 = (targetPrice - current_ema2) * alpha2 + current_ema2
        float next_ema3 = (targetPrice - current_ema3) * alpha3 + current_ema3
        
        // Draw dotted lines for the future path
        line.new(bar_index + i - 1, current_ema1, bar_index + i, next_ema1, color=color.blue, style=line.style_dotted)
        line.new(bar_index + i - 1, current_ema2, bar_index + i, next_ema2, color=color.teal, style=line.style_dotted)
        line.new(bar_index + i - 1, current_ema3, bar_index + i, next_ema3, color=color.purple, style=line.style_dotted)
        
        // Update variables for the next loop iteration
        current_ema1 := next_ema1
        current_ema2 := next_ema2
        current_ema3 := next_ema3
        
        // --- 4. Add Labels at the end of the projection ---
        if i == projBars
            label.new(bar_index + i, current_ema1, str.tostring(current_ema1, "#.##"), color=color.new(color.blue, 80), style=label.style_label_left, textcolor=color.blue, size=size.small)
            label.new(bar_index + i, current_ema2, str.tostring(current_ema2, "#.##"), color=color.new(color.teal, 80), style=label.style_label_left, textcolor=color.teal, size=size.small)
            label.new(bar_index + i, current_ema3, str.tostring(current_ema3, "#.##"), color=color.new(color.purple, 80), style=label.style_label_left, textcolor=color.purple, size=size.small)
