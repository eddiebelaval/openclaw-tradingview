//@version=5
indicator("MTF Bias Dashboard (TOTAL STRENGTH)", overlay=true)

// === SETTINGS ===
emaLength = input.int(200, "EMA Length")

// === FUNCTION TO GET TREND ===
getTrend(tf) =>
    price = request.security(syminfo.tickerid, tf, close)
    ema = request.security(syminfo.tickerid, tf, ta.ema(close, emaLength))

    diff = price - ema
    strength = math.min(math.abs(diff) / ema * 1000, 100)

    bias = diff > 0 ? 1 : -1
    [bias, strength]

// === GET DATA ===
[b15, s15] = getTrend("15")
[b30, s30] = getTrend("30")
[b1h, s1h] = getTrend("60")
[b4h, s4h] = getTrend("240")

// === CALCULATE TOTAL STRENGTH ===
totalStrength = (b15 * s15) + (b30 * s30) + (b1h * s1h) + (b4h * s4h)

// Normalize (optional cleaner scale)
normalizedStrength = totalStrength / 4

// === CONVERT BACK TO TEXT ===
getBiasText(b) =>
    b == 1 ? "BULLISH" : "BEARISH"

// === TABLE ===
var table t = table.new(position.top_right, 3, 6, border_width=2)

// HEADER
if barstate.isfirst
    table.cell(t, 0, 0, "TF", text_color=color.white, bgcolor=color.black, text_size=size.large)
    table.cell(t, 1, 0, "BIAS", text_color=color.white, bgcolor=color.black, text_size=size.large)
    table.cell(t, 2, 0, "STR", text_color=color.white, bgcolor=color.black, text_size=size.large)

// COLOR FUNCTION
getColor(b) =>
    b == 1 ? color.green : color.red

// UPDATE ROW FUNCTION
updateRow(row, tf, b, s) =>
    table.cell(t, 0, row, tf, text_size=size.large)
    table.cell(t, 1, row, getBiasText(b), bgcolor=getColor(b), text_color=color.white, text_size=size.large)
    table.cell(t, 2, row, str.tostring(s, "#.##"), text_size=size.large)

// ROWS
updateRow(1, "15M", b15, s15)
updateRow(2, "30M", b30, s30)
updateRow(3, "1H", b1h, s1h)
updateRow(4, "4H", b4h, s4h)

// === TOTAL ROW ===
totalColor = normalizedStrength > 0 ? color.green : color.red
totalText = normalizedStrength > 0 ? "NET BULLISH" : "NET BEARISH"

table.cell(t, 0, 5, "TOTAL", text_size=size.large)
table.cell(t, 1, 5, totalText, bgcolor=totalColor, text_color=color.white, text_size=size.large)
table.cell(t, 2, 5, str.tostring(normalizedStrength, "#.##"), text_size=size.large)
