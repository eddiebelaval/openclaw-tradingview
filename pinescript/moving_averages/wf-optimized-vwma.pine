var LEN_DB = "105|110|142|110|125|85|125|110|122|110|137|120|110|145|135|115|160|107|145|115|110|112|75|195|115|135|125|120|115|117|115|100|95|105|110|140|140|95|145|135|130|120|65|155|107|130|120|135|110|110|125|135|120|115|105|122|125|105|135|180|105|120|125|127|120|152|105|125|120|110|120|145|170|140|125|155|145|105|90|110|120|100|110|152|155|120|140|130|85|105|140|120|130|120|120|140|62|125|140|120|135|120|130|105|105|125|115|122|105|110|130|135|120|185|125|62|115|130|160|120|110|125|130|112|110|127|97|130|130|135|85|140|160|67|125|140|125|140|147|110|125|125|125|137|145|135|125|50|155|130|117|120|145|125|135|120|107|127|140|105|120|120|120|110|110|130|115|120|115|140|135|170|137|115|130|115|87|125|110|127|110|115|137|125|150|95|130|75|120|100|170|135|130|70|140|100|110|80|95|115|140|65|125|125|125|140|140|150|110|145|105|110|137|95|125|120|175|125|137|67|80|120|130|110|95|115|115|115|135|107|95|125|135|125|100|120|127|150|115|125|135|115|130|115|100|100|125|105|187|125|120|145|140|130|125|90|130|155|95|130|135|130|130|140|140|135|115|107|107|95|122|125|145|140|157|117|140|130|100|110|115|120|120|122|110|110|140|120|140|115|140|100|60|125|130|125|135|135|120|127|115|105|100|125|190|142|115|115|100|122|105|135|110|135|85|120|107|125|125|115|90|125|100|145|95|120|115|100|175|130|135|105|150|125|140|125|175|110|132|120|140|110|120|117|125|115|100|115|145|122|120|125|130|115|115|120|175|115|140|110|135|110|125|130|115|120|75|120|120|130|102|140|107|125|90|120|117|130|120|85|125|115|142|100|120|135|145|130|100|140|110|110|105|150|125|110|130|115|107|135|140|110|112|125|150|115|115|140|95|110|95|135|115|105|95|92|145|130|115|115|75|100|120|120|165|65|115|157|75|122|145|105|165|110|140|125|130|130|92|140|115|110|115|120|130|90|115|135|135|110|105|145|155|160|125|155|115|115|135|135|100|145|107|115|135|120|105|120|90|65|115|115|92|120|90|120|90|145|107|105|120|125|165|125|115|162|140|145|135|115|80|135|160|150|110|122|135|137|95|110|120|100|120|130|135|110|155|110|167|125|145|110|160|115|140|125|130|130|125|125|125|137|130|120|115|135|107|130|90|155|145|105|122|115|125|97|190"

// Parse into arrays (runs once on first bar)
var string[] dbTickers = str.split(TICKER_DB, "|")
var string[] dbLens    = str.split(LEN_DB, "|")

// ========== PARAMETER LOOKUP ==========
cleanTicker = str.replace_all(str.replace_all(str.replace_all(syminfo.ticker, ".P", ""), ".F", ""), "PERP", "")
var int tickerIdx = -1
if barstate.isfirst
    tickerIdx := array.indexof(dbTickers, cleanTicker)

assetFound = tickerIdx >= 0
optLen     = assetFound ? int(str.tonumber(array.get(dbLens, tickerIdx))) : default_len

// ===== Compute VWMA =====
float vwma_val = ta.vwma(src, optLen)

// ===== Plot =====
plot(vwma_val, title="WF-VWMA", color=assetFound ? #2962FF : color.gray, offset=offset, linewidth=2)

// ===== Info Label =====
if showInfo and barstate.islast
    var label infoLabel = na
    label.delete(infoLabel)
    statusStr = assetFound ? "✅ OPTIMIZED" : "⚠️ No optimization found"
    labelText = "📊 WF-VWMA\n"
      + statusStr + "\n"
      + "─────────────────\n"
      + "Length: " + str.tostring(optLen) + "\n"
      + "Asset: " + cleanTicker + "\n"
      + "Method: WF Median"
    infoLabel := label.new(bar_index, vwma_val, labelText,
         style=label.style_label_left,
         color=assetFound ? color.new(#2962FF, 20) : color.new(color.orange, 20),
         textcolor=color.white, size=size.normal)

// ===== Info Table =====
if barstate.islast
    var table t = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 85), border_width=1)
    table.cell(t, 0, 0, "WF-VWMA", text_color=color.lime, bgcolor=color.new(color.green, 70))
    table.cell(t, 1, 0, cleanTicker, text_color=color.lime, bgcolor=color.new(color.green, 70))
    table.cell(t, 0, 1, "Length", text_color=color.white)
    table.cell(t, 1, 1, str.tostring(optLen), text_color=assetFound ? color.lime : color.orange)
    table.cell(t, 0, 2, "Status", text_color=color.white)
    table.cell(t, 1, 2, assetFound ? "Optimized ✓" : "Default ⚠", text_color=assetFound ? color.lime : color.orange)
    table.cell(t, 0, 3, "Method", text_color=color.gray)
    table.cell(t, 1, 3, "WF Median", text_color=color.gray)
