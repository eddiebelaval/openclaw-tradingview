//@version=6
indicator('MarketStructureLab — Trend Context MA', overlay=true, format=format.price, precision=2, timeframe='', timeframe_gaps=false)

// ==========================================
// Inputs
// ==========================================
brandUp = input.color(color.rgb(64, 217, 143), 'Trend Up Color', inline = 'brand', group = 'Style')
brandDn = input.color(color.rgb(246, 113, 113), 'Trend Down Color', inline = 'brand', group = 'Style')
source = input(close, title='Price Source')
maLen = input.int(100, 'MA Length', minval=1)
maType = input.string(title='MA Method', defval='EMA', options=['SMA', 'EMA', 'WMA'])
t3Factor = input.float(0.7, 'T3 Volume Factor', step=0.1)
atrLen = input(title='ATR Length', defval=10)
atrMult = input.float(title='ATR Multiplier', step=0.1, defval=0.5)
useAltAtr = input(title='Use RMA ATR', defval=true)
showSignals = input(title='Show Entry Labels', defval=false)
enableHighlight = input(title='Trend Highlight Fill', defval=true)

// ==========================================
// MA helpers
// ==========================================
f_var(_src, _len) =>
    alpha = 2 / (_len + 1)
    upMove = _src > _src[1] ? _src - _src[1] : 0
    dnMove = _src < _src[1] ? _src[1] - _src : 0
    sumUp = math.sum(upMove, 9)
    sumDn = math.sum(dnMove, 9)
    cmo = nz((sumUp - sumDn) / (sumUp + sumDn))
    var float out = na
    out := nz(alpha * math.abs(cmo) * _src) + (1 - alpha * math.abs(cmo)) * nz(out[1])
    out

f_wwma(_src, _len) =>
    alpha = 1 / _len
    var float out = na
    out := alpha * _src + (1 - alpha) * nz(out[1])
    out

f_zlema(_src, _len) =>
    lag = int(_len / 2 == math.round(_len / 2) ? _len / 2 : (_len - 1) / 2)
    z = _src + _src - _src[lag]
    ta.ema(z, _len)

f_tsf(_src, _len) =>
    l0 = ta.linreg(_src, _len, 0)
    l1 = ta.linreg(_src, _len, 1)
    l0 + (l0 - l1)

f_t3(_src, _len, _v) =>
    e1 = ta.ema(_src, _len)
    e2 = ta.ema(e1, _len)
    e3 = ta.ema(e2, _len)
    e4 = ta.ema(e3, _len)
    e5 = ta.ema(e4, _len)
    e6 = ta.ema(e5, _len)
    c1 = -_v * _v * _v
    c2 = 3 * _v * _v + 3 * _v * _v * _v
    c3 = -6 * _v * _v - 3 * _v - 3 * _v * _v * _v
    c4 = 1 + 3 * _v + _v * _v * _v + 3 * _v * _v
    c1 * e6 + c2 * e5 + c3 * e4 + c4 * e3

f_ma(_src, _len, _type) =>
    dema = 2 * ta.ema(_src, _len) - ta.ema(ta.ema(_src, _len), _len)
    hma = ta.wma(2 * ta.wma(_src, _len / 2) - ta.wma(_src, _len), math.round(math.sqrt(_len)))
    switch _type
        'SMA'  => ta.sma(_src, _len)
        'EMA'  => ta.ema(_src, _len)
        'WMA'  => ta.wma(_src, _len)
        'DEMA' => dema
        'TMA'  => ta.sma(ta.sma(_src, math.ceil(_len / 2)), math.floor(_len / 2) + 1)
        'VAR'  => f_var(_src, _len)
        'WWMA' => f_wwma(_src, _len)
        'ZLEMA'=> f_zlema(_src, _len)
        'TSF'  => f_tsf(_src, _len)
        'HULL' => hma
        'TILL' => f_t3(_src, _len, t3Factor)
        => ta.ema(_src, _len)

baseMA = f_ma(source, maLen, maType)

// ==========================================
// ATR logic
// ==========================================
atrSma = ta.sma(ta.tr, atrLen)
atrVal = useAltAtr ? ta.atr(atrLen) : atrSma

upperBand = baseMA - atrMult * atrVal
prevUpper = nz(upperBand[1], upperBand)
upperBand := close[1] > prevUpper ? math.max(upperBand, prevUpper) : upperBand

lowerBand = baseMA + atrMult * atrVal
prevLower = nz(lowerBand[1], lowerBand)
lowerBand := close[1] < prevLower ? math.min(lowerBand, prevLower) : lowerBand

var int trendDir = 1
trendDir := nz(trendDir[1], trendDir)
trendDir := trendDir == -1 and close > prevLower ? 1 : trendDir == 1 and close < prevUpper ? -1 : trendDir

// ==========================================
// Plots & signals
// ==========================================
upPlot = plot(trendDir == 1 ? upperBand : na, title='Up Trend', color=color.new(brandUp, 100), linewidth=1, style=plot.style_linebr)
dnPlot = plot(trendDir == 1 ? na : lowerBand, title='Down Trend', style=plot.style_linebr, linewidth=1, color=color.new(brandDn, 100))

buySignal = trendDir == 1 and trendDir[1] == -1
sellSignal = trendDir == -1 and trendDir[1] == 1

plotshape(buySignal ? upperBand : na, title='UpTrend Begins', location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(brandUp, 100))
plotshape(buySignal and showSignals ? upperBand : na, title='Buy', text='Buy', location=location.absolute, style=shape.labelup, size=size.tiny, color=color.new(brandUp, 0), textcolor=color.new(color.white, 0))
plotshape(sellSignal ? lowerBand : na, title='DownTrend Begins', location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(brandDn, 100))
plotshape(sellSignal and showSignals ? lowerBand : na, title='Sell', text='Sell', location=location.absolute, style=shape.labeldown, size=size.tiny, color=color.new(brandDn, 0), textcolor=color.new(color.white, 0))

bgPlot = plot(ohlc4, title='', style=plot.style_circles, linewidth=1)
fillUp = color.new(brandUp, 60)
fillDn = color.new(brandDn, 60)
longFill = enableHighlight ? (trendDir == 1 ? fillUp : color.white) : color.new(color.white, 100)
shortFill = enableHighlight ? (trendDir == -1 ? fillDn : color.white) : color.new(color.white, 100)
fill(bgPlot, upPlot, title='UpTrend Highligter', color=longFill)
fill(bgPlot, dnPlot, title='DownTrend Highligter', color=shortFill)

// ==========================================
// Alerts
// ==========================================
alertcondition(buySignal, title='SuperTrend Buy', message='SuperTrend Buy!')
alertcondition(sellSignal, title='SuperTrend Sell', message='SuperTrend Sell!')
alertcondition(trendDir != trendDir[1], title='SuperTrend Direction Change', message='SuperTrend has changed direction!')
