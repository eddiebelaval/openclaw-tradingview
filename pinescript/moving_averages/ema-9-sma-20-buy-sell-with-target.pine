//@version=5
indicator("EMA Cross BB + Fib SL & 2 TP Shapes Medium Triangles", overlay=true)

// === INPUTS ===
emaLength = input.int(9, "EMA Length")
bbLength = input.int(20, "BB Length")
bbMult = input.float(2.0, "BB Multiplier")

slFib = input.float(-0.272, "SL Fib") // SL distance from candle
tp1Multiplier = 2.0                    // TP1 = 2× SL
tp2Multiplier = 3.0                    // TP2 = 3× SL

lineLength = 4                          // horizontal line length in bars

// === INDICATORS ===
emaValue = ta.ema(close, emaLength)
smaValue = ta.sma(close, bbLength)
dev = ta.stdev(close, bbLength)

upperBand = smaValue + bbMult * dev
lowerBand = smaValue - bbMult * dev

// === SIGNALS ===
buySignal = ta.crossover(emaValue, smaValue)
sellSignal = ta.crossunder(emaValue, smaValue)

// === PLOTS EMA & BB ===
plot(emaValue, color=color.blue, linewidth=2, title="EMA")
plot(smaValue, color=color.orange, linewidth=2, title="BB SMA 20")
plot(upperBand, color=color.red, title="Upper BB")
plot(lowerBand, color=color.red, title="Lower BB")

// === ENTRY ARROWS ===
plotshape(buySignal, location=location.belowbar, color=color.green, style=shape.labelup, text="BUY")
plotshape(sellSignal, location=location.abovebar, color=color.red, style=shape.labeldown, text="SELL")

// === CALCULATE SL / TP1 / TP2 SERIES ===
slSeries  = buySignal ? (low + (high - low) * slFib)  : sellSignal ? (high - (high - low) * slFib)  : na
tp1Series = buySignal ? (close + (close - slSeries) * tp1Multiplier) : sellSignal ? (close - (slSeries - close) * tp1Multiplier) : na
tp2Series = buySignal ? (close + (close - slSeries) * tp2Multiplier) : sellSignal ? (close - (slSeries - close) * tp2Multiplier) : na

// === PLOT MEDIUM TRIANGLES WITH LABELS ===
plotshape(series=slSeries, location=location.absolute, style=shape.triangledown, color=color.red, size=size.normal, title="SL", text="SL")
plotshape(series=tp1Series, location=location.absolute, style=shape.triangleup, color=color.green, size=size.normal, title="TP1", text="TP1")
plotshape(series=tp2Series, location=location.absolute, style=shape.triangleup, color=color.lime, size=size.normal, title="TP2", text="TP2")

// === DRAW SHORT HORIZONTAL LINES (4 candles) ===
if not na(slSeries)
    line.new(bar_index, slSeries, bar_index + lineLength, slSeries, color=color.red, width=2)
if not na(tp1Series)
    line.new(bar_index, tp1Series, bar_index + lineLength, tp1Series, color=color.green, width=2)
if not na(tp2Series)
    line.new(bar_index, tp2Series, bar_index + lineLength, tp2Series, color=color.lime, width=2)
