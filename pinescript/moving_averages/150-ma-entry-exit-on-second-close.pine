//@version=6
indicator("150 MA - Entry & Exit on Second Close", overlay=true, max_labels_count=500)

// Input parameters
len50 = input.int(50, "SMA 50 Period", minval=1)
len150 = input.int(150, "SMA 150 Period", minval=1)
len200 = input.int(200, "SMA 200 Period", minval=1)

showWeeklyMAs = input.bool(false, "Show Weekly MAs (50W & 200W)")
show5015Crosses = input.bool(true, "Show 50/150 Crossover Dots")

color50 = input.color(color.new(#9C27B0, 60), "SMA 50 Color")
color150 = input.color(color.new(#00BCD4, 60), "SMA 150 Color")
color200 = input.color(color.new(#546E7A, 60), "SMA 200 Color")
color50W = input.color(color.new(#FFB74D, 85), "50 Week MA Color")
color200W = input.color(color.new(#81C784, 85), "200 Week MA Color")

width50 = input.int(1, "SMA 50 Width", minval=1, maxval=5)
width150 = input.int(2, "SMA 150 Width", minval=1, maxval=5)
width200 = input.int(1, "SMA 200 Width", minval=1, maxval=5)

arrowColor = input.color(color.white, "Arrow Color")

showStatusBox = input.bool(true, "Show Status Box")
showOnlyLastSignal = input.bool(false, "Show Only Last Signal")

// Calculate moving averages
sma50 = ta.sma(close, len50)
sma150 = ta.sma(close, len150)
sma200 = ta.sma(close, len200)

// Calculate weekly moving averages with lookahead for smooth lines
sma50W = request.security(syminfo.tickerid, "W", ta.sma(close, 50), lookahead=barmerge.lookahead_on)
sma200W = request.security(syminfo.tickerid, "W", ta.sma(close, 200), lookahead=barmerge.lookahead_on)

// Track confirmation state
var bool bearishConfirmed = false
var bool bullishConfirmed = false
var bool inPosition = false
var int lastSignalBar = na
var label lastLabel = na

closedAboveMA = close > sma150
closedBelowMA = close < sma150

// Exit signal: Two consecutive closes below 150, second lower than first
bearishSignal = not bearishConfirmed and closedBelowMA and close[1] < sma150[1] and close < close[1]

if bearishSignal
    bearishConfirmed := true
    bullishConfirmed := false
    inPosition := false
    lastSignalBar := bar_index

// Entry signal: Two consecutive closes above 150, second higher than first
bullishSignal = not bullishConfirmed and closedAboveMA and close[1] > sma150[1] and close > close[1]

if bullishSignal
    bullishConfirmed := true
    bearishConfirmed := false
    inPosition := true
    lastSignalBar := bar_index

// Plot daily moving averages (visible by default)
plot(sma50, "SMA 50", color=color50, linewidth=width50, display=display.all)
plot(sma150, "SMA 150", color=color150, linewidth=width150, display=display.all)
plot(sma200, "SMA 200", color=color200, linewidth=width200, display=display.all)

// Plot weekly MAs with minimum thickness and dashed style (off by default, smooth when enabled)
plot(showWeeklyMAs ? sma50W : na, "50 Week MA", color=color50W, linewidth=1, style=plot.style_circles, display=display.all)
plot(showWeeklyMAs ? sma200W : na, "200 Week MA", color=color200W, linewidth=1, style=plot.style_circles, display=display.all)

// Detect 50/150 crossovers
bullishCross = ta.crossover(sma50, sma150)
bearishCross = ta.crossunder(sma50, sma150)

// Plot crossover dots on the MA lines (now toggleable and visible by default)
plot(show5015Crosses and bullishCross ? sma150 : na, "50/150 Bull Cross", color=color.new(color.green, 0), style=plot.style_circles, linewidth=4, display=display.all)
plot(show5015Crosses and bearishCross ? sma150 : na, "50/150 Bear Cross", color=color.new(color.red, 0), style=plot.style_circles, linewidth=4, display=display.all)

// Plot signals with arrows and text labels
if bullishSignal
    if showOnlyLastSignal
        // Delete previous label
        if not na(lastLabel)
            label.delete(lastLabel)
        // Create new label and store reference
        labelText = str.tostring(close, "#.#") + "\nENTRY\n↑"
        lastLabel := label.new(bar_index, high, labelText, style=label.style_none, textcolor=arrowColor, size=size.small, yloc=yloc.abovebar, textalign=text.align_center)
    else
        // Show all signals
        labelText = bar_index == lastSignalBar ? str.tostring(close, "#.#") + "\nENTRY\n↑" : "ENTRY\n↑"
        label.new(bar_index, high, labelText, style=label.style_none, textcolor=arrowColor, size=size.small, yloc=yloc.abovebar, textalign=text.align_center)

if bearishSignal
    if showOnlyLastSignal
        // Delete previous label
        if not na(lastLabel)
            label.delete(lastLabel)
        // Create new label and store reference
        labelText = "↓\nEXIT\n" + str.tostring(close, "#.#")
        lastLabel := label.new(bar_index, low, labelText, style=label.style_none, textcolor=arrowColor, size=size.small, yloc=yloc.belowbar, textalign=text.align_center)
    else
        // Show all signals
        labelText = bar_index == lastSignalBar ? "↓\nEXIT\n" + str.tostring(close, "#.#") : "↓\nEXIT"
        label.new(bar_index, low, labelText, style=label.style_none, textcolor=arrowColor, size=size.small, yloc=yloc.belowbar, textalign=text.align_center)

// Status box
if showStatusBox and barstate.islast
    var table statusTable = table.new(position.top_right, 1, 1)
    table.cell(statusTable, 0, 0, 
             inPosition ? "IN POSITION ✓" : "OUT OF POSITION", 
             text_color=color.white, 
             bgcolor=inPosition ? color.new(color.green, 30) : color.new(color.red, 30),
             text_size=size.normal)
