//@version=6
indicator("EMA Trend & Efficiency Validator", overlay=true)

// --- Inputs ---
emaLength = input.int(50, "Test EMA Length", minval=1)
lookback = input.int(100, "Validation Lookback (Bars)")

// --- Logic ---
emaValue = ta.ema(close, emaLength)

// Step 1: Global calculations
isCrossed = ta.cross(close, emaValue)
isAbove = close > emaValue
// Calculate average distance (Absolute % from EMA)
priceDistance = math.abs(close - emaValue) / emaValue * 100
avgDistance = ta.sma(priceDistance, lookback)

// Step 2: Metrics Calculation
int crosses = 0
int barsAbove = 0

for i = 0 to lookback - 1
    if isCrossed[i]
        crosses := crosses + 1
    if isAbove[i]
        barsAbove := barsAbove + 1

// --- Normalization Logic ---

// 1. Trend Consistency (0-100)
float trendConsistency = (math.max(barsAbove, lookback - barsAbove) / lookback) * 100

// 2. Proximity Score (We want price to be relatively close to the EMA)
// If price is too far (Lag), the EMA is less "useful" for timing.
// We penalize distances above a standard threshold (e.g. 3%)
float lagPenalty = math.min(avgDistance * 5, 50) 

// 3. Final Efficiency Score
// Consistency is good, but we subtract points for Chop and Lag
float efficiencyScore = trendConsistency - (crosses * 2) - lagPenalty

// Trend Color Logic
trendColor = isAbove ? color.new(color.green, 0) : color.new(color.red, 0)
plot(emaValue, "EMA", color=trendColor, linewidth=2)

// --- Dashboard ---
var table testTable = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 70), border_width=1)
if barstate.islast
    table.cell(testTable, 0, 0, "EMA Length", text_color=color.white)
    table.cell(testTable, 1, 0, str.tostring(emaLength), text_color=color.yellow)
    
    table.cell(testTable, 0, 1, "Chop Score", text_color=color.white)
    table.cell(testTable, 1, 1, str.tostring(crosses), text_color=crosses > 15 ? color.red : color.green)
    
    table.cell(testTable, 0, 2, "Avg Dist (Lag)", text_color=color.white)
    table.cell(testTable, 1, 2, str.format("{0,number,#.##}%", avgDistance), text_color=color.blue)

    table.cell(testTable, 0, 3, "Efficiency Score", text_color=color.white)
    table.cell(testTable, 1, 3, str.format("{0,number,#.##}", efficiencyScore), text_color=efficiencyScore > 60 ? color.green : color.orange)

// Highlight Peak Efficiency
bgcolor(efficiencyScore > 70 ? color.new(color.green, 90) : na)
