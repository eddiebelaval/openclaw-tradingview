//@version=5
indicator("Apex Capital 35/12 MA Trend Filter", shorttitle="Apex 35-12", overlay=true, max_labels_count=500)

// === Paramètres personnalisables ===
shortPeriod   = input.int(35,    title="Période courte (jours)", minval=1)
longPeriod    = input.int(252,   title="Période longue ≈12 mois (jours de bourse)", minval=1)
maType        = input.string("EMA", "Type de moyenne mobile", options=["EMA", "SMA", "WMA", "VWMA", "RMA"])
source        = input.source(close, "Source de données")

showBackground = input.bool(true,  "Colorer l'arrière-plan selon la tendance")
showLabels     = input.bool(true,  "Afficher les labels de crossover")
showCloud      = input.bool(false, "Afficher le nuage entre les moyennes")

// === Sélection du type de moyenne mobile ===
getMA(src, len, type) =>
    switch type
        "EMA"  => ta.ema(src, len)
        "SMA"  => ta.sma(src, len)
        "WMA"  => ta.wma(src, len)
        "VWMA" => ta.vwma(src, len)
        "RMA"  => ta.rma(src, len)

// === Calcul des moyennes ===
maShort = getMA(source, shortPeriod, maType)
maLong  = getMA(source, longPeriod,  maType)

// === Affichage des lignes (global scope) ===
plot(maShort, color=color.new(#2962FF, 0), linewidth=2, title="MA 35 jours")
plot(maLong,  color=color.new(#FF6D00, 0), linewidth=3, title="MA ≈12 mois")

// === Nuage optionnel (fill doit être global aussi) ===
p1 = plot(maShort, display=display.none)   // plot invisible pour fill
p2 = plot(maLong,  display=display.none)   // idem
fill(p1, p2, color = showCloud ? (maShort > maLong ? color.new(color.green, 85) : color.new(color.red, 85)) : na, title="Zone de tendance")

// === Détection des croisements ===
bullishCross = ta.crossover(maShort, maLong)
bearishCross = ta.crossunder(maShort, maLong)

// === Signaux plotshape (condition dans series= pour activer/désactiver) ===
plotshape(series = bullishCross, location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small, title="Signal haussier")
plotshape(series = bearishCross, location=location.abovebar,  color=color.red,   style=shape.triangledown, size=size.small, title="Signal baissier")

// === Labels (condition dans if, mais label.new est autorisé dans if en v5) ===
if bullishCross and showLabels
    label.new(bar_index, low, "HAUSSIER 35/12", yloc=yloc.belowbar, color=color.green, style=label.style_label_up, textcolor=color.white)

if bearishCross and showLabels
    label.new(bar_index, high, "BAISSIER 35/12", yloc=yloc.abovebar, color=color.red, style=label.style_label_down, textcolor=color.white)

// === Coloration de l'arrière-plan (bgcolor global avec ternaire) ===
bgcolor(showBackground and maShort > maLong  ? color.new(color.green, 92) : na, title="Fond haussier")
bgcolor(showBackground and maShort < maLong  ? color.new(color.red,   92) : na, title="Fond baissier")

// === Conditions d'alerte ===
alertcondition(bullishCross, title="Apex 35/12 - Croisement haussier", message="La MA 35 jours a croisé au-dessus de la MA 12 mois → Tendance haussière confirmée.")
alertcondition(bearishCross, title="Apex 35/12 - Croisement baissier", message="La MA 35 jours a croisé en-dessous de la MA 12 mois → Tendance baissière confirmée.")
