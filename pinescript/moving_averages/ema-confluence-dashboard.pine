// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// © Wadi - EMA Confluence Dashboard

//@version=6
indicator("EMA Confluence Dashboard", overlay=true, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════════════════════

// --- EMA Settings ---
grpEMA         = "══ EMA Settings ══"
ema50Len       = input.int(50,  "Fast EMA Length",  minval=1, group=grpEMA)
ema200Len      = input.int(200, "Slow EMA Length",  minval=1, group=grpEMA)
ema50Color     = input.color(color.new(#00bcd4, 0), "Fast EMA Color", group=grpEMA)
ema200Color    = input.color(color.new(#ff9800, 0), "Slow EMA Color", group=grpEMA)
fillEMAs       = input.bool(true, "Fill Between EMAs", group=grpEMA)

// --- RSI Settings ---
grpRSI         = "══ RSI Settings ══"
rsiLen         = input.int(14,  "RSI Length",       minval=1,  group=grpRSI)
rsiOB          = input.int(70,  "RSI Overbought",   minval=50, maxval=95, group=grpRSI)
rsiOS          = input.int(30,  "RSI Oversold",      minval=5,  maxval=50, group=grpRSI)

// --- MACD Settings ---
grpMACD        = "══ MACD Settings ══"
macdFast       = input.int(12,  "MACD Fast Length",  minval=1, group=grpMACD)
macdSlow       = input.int(26,  "MACD Slow Length",  minval=1, group=grpMACD)
macdSignal     = input.int(9,   "MACD Signal Length", minval=1, group=grpMACD)

// --- Stochastic RSI Settings ---
grpStoch       = "══ Stochastic RSI Settings ══"
stochLen       = input.int(14,  "Stoch RSI Length",  minval=1, group=grpStoch)
stochK         = input.int(3,   "Stoch %K Smooth",   minval=1, group=grpStoch)
stochD         = input.int(3,   "Stoch %D Smooth",   minval=1, group=grpStoch)
stochOB        = input.int(80,  "Stoch Overbought",  minval=50, maxval=95, group=grpStoch)
stochOS        = input.int(20,  "Stoch Oversold",    minval=5,  maxval=50, group=grpStoch)

// --- Dashboard Settings ---
grpDash        = "══ Dashboard Settings ══"
dashPos        = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grpDash)
dashSize       = input.string("Normal", "Dashboard Size", options=["Small", "Normal", "Large"], group=grpDash)
showDashboard  = input.bool(true, "Show Dashboard", group=grpDash)
showSignals    = input.bool(true, "Show Buy/Sell Signals", group=grpDash)
minConfluence  = input.int(3, "Min Confluence for Signal (1-4)", minval=1, maxval=4, group=grpDash)

// ══════════════════════════════════════════════════════════════════════════════
// CALCULATIONS
// ══════════════════════════════════════════════════════════════════════════════

// --- EMAs ---
ema50  = ta.ema(close, ema50Len)
ema200 = ta.ema(close, ema200Len)

// --- EMA Trend ---
emaBullish = ema50 > ema200
emaBearish = ema50 < ema200
goldenCross = ta.crossover(ema50, ema200)
deathCross  = ta.crossunder(ema50, ema200)
priceAboveEMAs = close > ema50 and close > ema200
priceBelowEMAs = close < ema50 and close < ema200

// --- RSI ---
rsiVal = ta.rsi(close, rsiLen)
rsiBullish = rsiVal > 50 and rsiVal < rsiOB
rsiBearish = rsiVal < 50 and rsiVal > rsiOS
rsiOverbought = rsiVal >= rsiOB
rsiOversold   = rsiVal <= rsiOS

// --- MACD ---
[macdLine, signalLine, histLine] = ta.macd(close, macdFast, macdSlow, macdSignal)
macdBullish = macdLine > signalLine and histLine > 0
macdBearish = macdLine < signalLine and histLine < 0
macdCrossBull = ta.crossover(macdLine, signalLine)
macdCrossBear = ta.crossunder(macdLine, signalLine)

// --- Stochastic RSI ---
rsi1   = ta.rsi(close, stochLen)
stochK_val = ta.sma(ta.stoch(rsi1, rsi1, rsi1, stochLen), stochK)
stochD_val = ta.sma(stochK_val, stochD)
stochBullish = stochK_val > stochD_val and stochK_val < stochOB
stochBearish = stochK_val < stochD_val and stochK_val > stochOS
stochOverbought = stochK_val >= stochOB
stochOversold   = stochK_val <= stochOS

// ══════════════════════════════════════════════════════════════════════════════
// CONFLUENCE SCORING
// ══════════════════════════════════════════════════════════════════════════════

// Bullish confluence (0 to 4)
bullScore = 0
bullScore += (emaBullish and priceAboveEMAs) ? 1 : 0
bullScore += rsiBullish ? 1 : 0
bullScore += macdBullish ? 1 : 0
bullScore += stochBullish ? 1 : 0

// Bearish confluence (0 to 4)
bearScore = 0
bearScore += (emaBearish and priceBelowEMAs) ? 1 : 0
bearScore += rsiBearish ? 1 : 0
bearScore += macdBearish ? 1 : 0
bearScore += stochBearish ? 1 : 0

// Signal triggers
bullSignal = bullScore >= minConfluence and bullScore[1] < minConfluence
bearSignal = bearScore >= minConfluence and bearScore[1] < minConfluence

// ══════════════════════════════════════════════════════════════════════════════
// PLOTS - EMAs
// ══════════════════════════════════════════════════════════════════════════════

p50  = plot(ema50,  "EMA 50",  color=ema50Color,  linewidth=2)
p200 = plot(ema200, "EMA 200", color=ema200Color, linewidth=2)

fillColor = fillEMAs ? (emaBullish ? color.new(#00bcd4, 85) : color.new(#ff9800, 85)) : na
fill(p50, p200, color=fillColor, title="EMA Fill")

// --- Golden/Death Cross Markers ---
plotshape(goldenCross, title="Golden Cross", style=shape.diamond, location=location.belowbar, color=color.new(#00e676, 0), size=size.small, text="GC")
plotshape(deathCross,  title="Death Cross",  style=shape.diamond, location=location.abovebar, color=color.new(#ff1744, 0), size=size.small, text="DC")

// --- Confluence Signals ---
plotshape(showSignals and bullSignal ? low : na, title="Bull Confluence", style=shape.triangleup,   location=location.belowbar, color=color.new(#00e676, 0), size=size.normal, text="BULL")
plotshape(showSignals and bearSignal ? high : na, title="Bear Confluence", style=shape.triangledown, location=location.abovebar, color=color.new(#ff1744, 0), size=size.normal, text="BEAR")

// ══════════════════════════════════════════════════════════════════════════════
// DASHBOARD TABLE
// ══════════════════════════════════════════════════════════════════════════════

if showDashboard and barstate.islast
    // Position
    tblPos = switch dashPos
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left

    // Size
    tblSize = switch dashSize
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large

    // Create table: 3 columns x 8 rows
    var tbl = table.new(tblPos, 3, 9, bgcolor=color.new(#1a1a2e, 5), border_width=1, border_color=color.new(#333355, 0), frame_width=2, frame_color=color.new(#4a4a6a, 0))

    // === Header ===
    table.cell(tbl, 0, 0, "CONFLUENCE DASHBOARD", text_color=color.new(#e0e0ff, 0), text_size=tblSize, bgcolor=color.new(#16213e, 0), text_halign=text.align_center)
    table.merge_cells(tbl, 0, 0, 2, 0)

    // === Column Headers ===
    table.cell(tbl, 0, 1, "INDICATOR",  text_color=color.new(#8888aa, 0), text_size=tblSize, bgcolor=color.new(#0f3460, 0), text_halign=text.align_center)
    table.cell(tbl, 1, 1, "VALUE",      text_color=color.new(#8888aa, 0), text_size=tblSize, bgcolor=color.new(#0f3460, 0), text_halign=text.align_center)
    table.cell(tbl, 2, 1, "SIGNAL",     text_color=color.new(#8888aa, 0), text_size=tblSize, bgcolor=color.new(#0f3460, 0), text_halign=text.align_center)

    // === Row 1: EMA Trend ===
    emaTxt   = emaBullish ? "BULLISH" : "BEARISH"
    emaClr   = emaBullish ? color.new(#00e676, 0) : color.new(#ff1744, 0)
    emaVal   = "50: " + str.tostring(ema50, format.mintick) + "\n200: " + str.tostring(ema200, format.mintick)
    table.cell(tbl, 0, 2, "EMA TREND",  text_color=color.white, text_size=tblSize, text_halign=text.align_center)
    table.cell(tbl, 1, 2, emaVal,        text_color=color.new(#ccccee, 0), text_size=tblSize, text_halign=text.align_center)
    table.cell(tbl, 2, 2, emaTxt,        text_color=emaClr, text_size=tblSize, text_halign=text.align_center)

    // === Row 2: Price vs EMAs ===
    pricePosTxt = priceAboveEMAs ? "ABOVE BOTH" : priceBelowEMAs ? "BELOW BOTH" : "BETWEEN"
    pricePosClr = priceAboveEMAs ? color.new(#00e676, 0) : priceBelowEMAs ? color.new(#ff1744, 0) : color.new(#ffd740, 0)
    table.cell(tbl, 0, 3, "PRICE POS",  text_color=color.white, text_size=tblSize, text_halign=text.align_center)
    table.cell(tbl, 1, 3, str.tostring(close, format.mintick), text_color=color.new(#ccccee, 0), text_size=tblSize, text_halign=text.align_center)
    table.cell(tbl, 2, 3, pricePosTxt,   text_color=pricePosClr, text_size=tblSize, text_halign=text.align_center)

    // === Row 3: RSI ===
    rsiTxt   = rsiOverbought ? "OVERBOUGHT" : rsiOversold ? "OVERSOLD" : rsiBullish ? "BULLISH" : rsiBearish ? "BEARISH" : "NEUTRAL"
    rsiClr   = rsiOverbought ? color.new(#ff1744, 0) : rsiOversold ? color.new(#00e676, 0) : rsiBullish ? color.new(#00e676, 0) : rsiBearish ? color.new(#ff1744, 0) : color.new(#8888aa, 0)
    table.cell(tbl, 0, 4, "RSI (" + str.tostring(rsiLen) + ")", text_color=color.white, text_size=tblSize, text_halign=text.align_center)
    table.cell(tbl, 1, 4, str.tostring(rsiVal, "#.##"),          text_color=color.new(#ccccee, 0), text_size=tblSize, text_halign=text.align_center)
    table.cell(tbl, 2, 4, rsiTxt,                                 text_color=rsiClr, text_size=tblSize, text_halign=text.align_center)

    // === Row 4: MACD ===
    macdTxt   = macdBullish ? "BULLISH" : macdBearish ? "BEARISH" : "NEUTRAL"
    macdClr   = macdBullish ? color.new(#00e676, 0) : macdBearish ? color.new(#ff1744, 0) : color.new(#8888aa, 0)
    macdDisp  = "M: " + str.tostring(macdLine, "#.####") + "\nS: " + str.tostring(signalLine, "#.####")
    table.cell(tbl, 0, 5, "MACD",       text_color=color.white, text_size=tblSize, text_halign=text.align_center)
    table.cell(tbl, 1, 5, macdDisp,      text_color=color.new(#ccccee, 0), text_size=tblSize, text_halign=text.align_center)
    table.cell(tbl, 2, 5, macdTxt,        text_color=macdClr, text_size=tblSize, text_halign=text.align_center)

    // === Row 5: Stochastic RSI ===
    stochTxt  = stochOverbought ? "OVERBOUGHT" : stochOversold ? "OVERSOLD" : stochBullish ? "BULLISH" : stochBearish ? "BEARISH" : "NEUTRAL"
    stochClr  = stochOverbought ? color.new(#ff1744, 0) : stochOversold ? color.new(#00e676, 0) : stochBullish ? color.new(#00e676, 0) : stochBearish ? color.new(#ff1744, 0) : color.new(#8888aa, 0)
    stochDisp = "%K: " + str.tostring(stochK_val, "#.##") + "\n%D: " + str.tostring(stochD_val, "#.##")
    table.cell(tbl, 0, 6, "STOCH RSI",  text_color=color.white, text_size=tblSize, text_halign=text.align_center)
    table.cell(tbl, 1, 6, stochDisp,     text_color=color.new(#ccccee, 0), text_size=tblSize, text_halign=text.align_center)
    table.cell(tbl, 2, 6, stochTxt,       text_color=stochClr, text_size=tblSize, text_halign=text.align_center)

    // === Row 6: Confluence Score ===
    confTxt   = bullScore >= minConfluence ? "🟢 BULL " + str.tostring(bullScore) + "/4" : bearScore >= minConfluence ? "🔴 BEAR " + str.tostring(bearScore) + "/4" : "⚪ WAIT"
    confClr   = bullScore >= minConfluence ? color.new(#00e676, 0) : bearScore >= minConfluence ? color.new(#ff1744, 0) : color.new(#8888aa, 0)
    confBg    = bullScore >= minConfluence ? color.new(#00e676, 90) : bearScore >= minConfluence ? color.new(#ff1744, 90) : color.new(#1a1a2e, 5)
    table.cell(tbl, 0, 7, "CONFLUENCE", text_color=color.white, text_size=tblSize, bgcolor=confBg, text_halign=text.align_center)
    table.merge_cells(tbl, 0, 7, 0, 7)
    table.cell(tbl, 1, 7, confTxt,       text_color=confClr, text_size=tblSize, bgcolor=confBg, text_halign=text.align_center)
    table.merge_cells(tbl, 1, 7, 2, 7)

    // === Row 7: Bias Summary ===
    biasTxt = bullScore > bearScore ? "OVERALL: BULLISH BIAS" : bearScore > bullScore ? "OVERALL: BEARISH BIAS" : "OVERALL: NEUTRAL"
    biasClr = bullScore > bearScore ? color.new(#00e676, 0) : bearScore > bullScore ? color.new(#ff1744, 0) : color.new(#ffd740, 0)
    biasBg  = bullScore > bearScore ? color.new(#00e676, 92) : bearScore > bullScore ? color.new(#ff1744, 92) : color.new(#ffd740, 92)
    table.cell(tbl, 0, 8, biasTxt, text_color=biasClr, text_size=tblSize, bgcolor=biasBg, text_halign=text.align_center)
    table.merge_cells(tbl, 0, 8, 2, 8)

// ══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════════════════════════════════════════

alertcondition(bullSignal, title="Bullish Confluence", message="🟢 BULLISH CONFLUENCE detected on {{ticker}} {{interval}}")
alertcondition(bearSignal, title="Bearish Confluence", message="🔴 BEARISH CONFLUENCE detected on {{ticker}} {{interval}}")
alertcondition(goldenCross, title="Golden Cross", message="⭐ GOLDEN CROSS — EMA 50 crossed above EMA 200 on {{ticker}} {{interval}}")
alertcondition(deathCross,  title="Death Cross",  message="💀 DEATH CROSS — EMA 50 crossed below EMA 200 on {{ticker}} {{interval}}")
