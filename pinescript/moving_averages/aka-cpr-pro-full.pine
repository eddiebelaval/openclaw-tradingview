//@version=6
indicator("Aka CPR PRO – Full Framework", overlay=true, max_lines_count=500)

//====================== INPUT GROUPS ======================
grpCPR   = "CPR Levels"
grpRS    = "R / S Levels"
grpPrev  = "Previous High / Low"
grpMA    = "Moving Averages"
grpVWAP  = "VWAP"

//====================== CPR TOGGLES ======================
showDaily   = input.bool(true,  "Daily CPR",   group=grpCPR)
showWeekly  = input.bool(false, "Weekly CPR",  group=grpCPR)
showMonthly = input.bool(false, "Monthly CPR", group=grpCPR)

//====================== R / S TOGGLES ======================
// Daily
showDR1 = input.bool(true,  "Daily R1 / S1", group=grpRS)
showDR2 = input.bool(true,  "Daily R2 / S2", group=grpRS)
showDR3 = input.bool(true,  "Daily R3 / S3", group=grpRS)

// Weekly
showWR1 = input.bool(false, "Weekly R1 / S1", group=grpRS)
showWR2 = input.bool(false, "Weekly R2 / S2", group=grpRS)
showWR3 = input.bool(false, "Weekly R3 / S3", group=grpRS)

// Monthly
showMR1 = input.bool(false, "Monthly R1 / S1", group=grpRS)
showMR2 = input.bool(false, "Monthly R2 / S2", group=grpRS)
showMR3 = input.bool(false, "Monthly R3 / S3", group=grpRS)

//====================== PREVIOUS HIGH / LOW ======================
showPrevDay   = input.bool(true,  "Prev Day High / Low",   group=grpPrev)
showPrevWeek  = input.bool(false, "Prev Week High / Low",  group=grpPrev)
showPrevMonth = input.bool(false, "Prev Month High / Low", group=grpPrev)

//====================== MOVING AVERAGES ======================
showMA1 = input.bool(true,  "MA 1", group=grpMA)
ma1Type = input.string("EMA", options=["EMA","SMA"], group=grpMA)
ma1Len  = input.int(20, group=grpMA)

showMA2 = input.bool(true,  "MA 2", group=grpMA)
ma2Type = input.string("EMA", options=["EMA","SMA"], group=grpMA)
ma2Len  = input.int(50, group=grpMA)

showMA3 = input.bool(false, "MA 3", group=grpMA)
ma3Type = input.string("EMA", options=["EMA","SMA"], group=grpMA)
ma3Len  = input.int(200, group=grpMA)

//====================== VWAP ======================
showVWAP = input.bool(false, "Plot VWAP", group=grpVWAP)

//====================== FUNCTIONS ======================
f_pivot(h,l,c) => (h+l+c)/3
f_bc(h,l)      => (h+l)/2
f_tc(p,bc)     => 2*p-bc
f_ma(src,len,type) => type=="EMA" ? ta.ema(src,len) : ta.sma(src,len)

//====================== DATA (PREVIOUS PERIOD) ======================
dH = request.security(syminfo.tickerid,"D",high[1])
dL = request.security(syminfo.tickerid,"D",low[1])
dC = request.security(syminfo.tickerid,"D",close[1])

wH = request.security(syminfo.tickerid,"W",high[1])
wL = request.security(syminfo.tickerid,"W",low[1])
wC = request.security(syminfo.tickerid,"W",close[1])

mH = request.security(syminfo.tickerid,"M",high[1])
mL = request.security(syminfo.tickerid,"M",low[1])
mC = request.security(syminfo.tickerid,"M",close[1])

//====================== CPR ======================
dP=f_pivot(dH,dL,dC), dBC=f_bc(dH,dL), dTC=f_tc(dP,dBC)
wP=f_pivot(wH,wL,wC), wBC=f_bc(wH,wL), wTC=f_tc(wP,wBC)
mP=f_pivot(mH,mL,mC), mBC=f_bc(mH,mL), mTC=f_tc(mP,mBC)

//====================== R / S ======================
dRange=dH-dL, wRange=wH-wL, mRange=mH-mL

dR1=2*dP-dL, dS1=2*dP-dH
dR2=dP+dRange, dS2=dP-dRange
dR3=dH+2*(dP-dL), dS3=dL-2*(dH-dP)

wR1=2*wP-wL, wS1=2*wP-wH
wR2=wP+wRange, wS2=wP-wRange
wR3=wH+2*(wP-wL), wS3=wL-2*(wH-wP)

mR1=2*mP-mL, mS1=2*mP-mH
mR2=mP+mRange, mS2=mP-mRange
mR3=mH+2*(mP-mL), mS3=mL-2*(mH-mP)

//====================== PLOTS ======================
// ---- CPR
plot(showDaily   ? dTC : na, "Daily TC",   color=color.blue,   style=plot.style_circles)
plot(showDaily   ? dP  : na, "Daily Pivot",color=color.purple,style=plot.style_circles)
plot(showDaily   ? dBC : na, "Daily BC",   color=color.blue,  style=plot.style_circles)

plot(showWeekly  ? wTC : na, "Weekly TC",  color=color.orange, linewidth=2)
plot(showWeekly  ? wP  : na, "Weekly Pivot",color=color.orange)
plot(showWeekly  ? wBC : na, "Weekly BC",  color=color.orange)

plot(showMonthly ? mTC : na, "Monthly TC", color=color.red, linewidth=2)
plot(showMonthly ? mP  : na, "Monthly Pivot",color=color.red)
plot(showMonthly ? mBC : na, "Monthly BC", color=color.red)

// ---- R / S Daily
plot(showDR1 ? dR1 : na, "D R1", color=color.green)
plot(showDR1 ? dS1 : na, "D S1", color=color.red)
plot(showDR2 ? dR2 : na, "D R2", color=color.green)
plot(showDR2 ? dS2 : na, "D S2", color=color.red)
plot(showDR3 ? dR3 : na, "D R3", color=color.green)
plot(showDR3 ? dS3 : na, "D S3", color=color.red)

// ---- R / S Weekly
plot(showWR1 ? wR1 : na, "W R1", color=color.new(color.green,20))
plot(showWR1 ? wS1 : na, "W S1", color=color.new(color.red,20))
plot(showWR2 ? wR2 : na, "W R2", color=color.new(color.green,20))
plot(showWR2 ? wS2 : na, "W S2", color=color.new(color.red,20))
plot(showWR3 ? wR3 : na, "W R3", color=color.new(color.green,20))
plot(showWR3 ? wS3 : na, "W S3", color=color.new(color.red,20))

// ---- R / S Monthly
plot(showMR1 ? mR1 : na, "M R1", color=color.new(color.green,40))
plot(showMR1 ? mS1 : na, "M S1", color=color.new(color.red,40))
plot(showMR2 ? mR2 : na, "M R2", color=color.new(color.green,40))
plot(showMR2 ? mS2 : na, "M S2", color=color.new(color.red,40))
plot(showMR3 ? mR3 : na, "M R3", color=color.new(color.green,40))
plot(showMR3 ? mS3 : na, "M S3", color=color.new(color.red,40))

// ---- Previous High / Low
plot(showPrevDay   ? dH : na, "Prev Day High",   color=color.lime, linewidth=2)
plot(showPrevDay   ? dL : na, "Prev Day Low",    color=color.red,  linewidth=2)
plot(showPrevWeek  ? wH : na, "Prev Week High",  color=color.new(color.lime,20))
plot(showPrevWeek  ? wL : na, "Prev Week Low",   color=color.new(color.red,20))
plot(showPrevMonth ? mH : na, "Prev Month High", color=color.new(color.lime,40))
plot(showPrevMonth ? mL : na, "Prev Month Low",  color=color.new(color.red,40))

// ---- Moving Averages
plot(showMA1 ? f_ma(close,ma1Len,ma1Type) : na, "MA1", color=color.yellow)
plot(showMA2 ? f_ma(close,ma2Len,ma2Type) : na, "MA2", color=color.aqua)
plot(showMA3 ? f_ma(close,ma3Len,ma3Type) : na, "MA3", color=color.white)

// ---- VWAP
plot(showVWAP ? ta.vwap(close) : na, "VWAP", color=color.fuchsia, linewidth=2)
