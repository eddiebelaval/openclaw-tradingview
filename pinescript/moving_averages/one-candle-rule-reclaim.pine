//@version=5
indicator(" One Candle Rule & Reclaim", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=200)

// ══════════════════════════════════════════════════════════════
// STRATEGY RULES (Tony Trades + Scarface Trades consolidated)
// ══════════════════════════════════════════════════════════════
// SETUP A — Opening Range (OR):
//   1. Box first 5-min candle, 2. Strong breakout close, 3. First opposite-color = one candle
//   4. Retest the level, 5. Close above/below = ENTRY
// SETUP B — Previous Day High/Low (PDH/PDL):
//   Same one-candle logic triggered at PDH or PDL instead of OR
// FILTERS: retest, volume, body size, breakout quality, OR size, session window
// RISK: SL at pullback extreme, TP1 at 50% (scale 70%), TP2 full target (trail 30%)

// ══════════════════════════════════════════════════════════════
// PREMIUM COLOR PALETTE (Institutional / Professional Styling)
// ══════════════════════════════════════════════════════════════
// Semantic action colors (Rich, readable, not neon)
C_BULL          = #22C55E  // Deep emerald green
C_BULL_BRIGHT   = #4ADE80  // Bright mint for text/accents
C_BULL_GLOW     = color.new(#22C55E, 80)
C_BULL_ZONE     = color.new(#22C55E, 92) // Ultra sheer背景

C_BEAR          = #EF4444  // Deep crimson red
C_BEAR_BRIGHT   = #F87171  // Bright coral for text/accents
C_BEAR_GLOW     = color.new(#EF4444, 80)
C_BEAR_ZONE     = color.new(#EF4444, 92)

// Opening Range (Sophisticated gold/slate)
C_OR_BORDER     = color.new(#F59E0B, 40) // Amber
C_OR_FILL       = color.new(#F59E0B, 92) // Sheer amber
C_OR_LINE       = color.new(#F59E0B, 60)
C_OR_TEXT       = color.new(#F59E0B, 15)
C_OR_GLOW       = color.new(#F59E0B, 85)

// Daily Context Levels (Muted slates & teals to reduce noise)
C_PDH           = color.new(#94A3B8, 40) // Slate Gray
C_PDH_GLOW      = color.new(#94A3B8, 85)
C_PDL           = color.new(#94A3B8, 40) 
C_PDL_GLOW      = color.new(#94A3B8, 85)

C_LON_H         = color.new(#38BDF8, 50) // Sky Blue
C_LON_H_GLOW    = color.new(#38BDF8, 85)
C_LON_L         = color.new(#38BDF8, 50)
C_LON_L_GLOW    = color.new(#38BDF8, 85)

// 4H Structure (Muted indigo/purple)
C_4H_H          = color.new(#818CF8, 40) // Indigo
C_4H_H_GLOW     = color.new(#818CF8, 85)
C_4H_L          = color.new(#818CF8, 40)
C_4H_L_GLOW     = color.new(#818CF8, 85)

// System Elements
C_LEVEL_ACTIVE  = color.new(#F8FAFC, 15) // Crisp white for active levels
C_LEVEL_GLOW    = color.new(#F8FAFC, 80)
C_LEVEL_INVAL   = color.new(#64748B, 40) // Slate for invalidated
C_LEVEL_STALE   = color.new(#334155, 60) // Dark slate for stale

C_SESSION_BG    = color.new(#0F172A, 95) // Very dark slate/navy

// PDH/PDL setup accent colors (Distinct but professional)
C_PDH_BULL      = #8B5CF6 // Violet
C_PDH_BULL_BR   = #A78BFA
C_PDH_BEAR      = #D946EF // Fuchsia
C_PDH_BEAR_BR   = #E879F9

// ══════════════════════════════════════════════════════════════
// SETTINGS
// ══════════════════════════════════════════════════════════════
grpLevels    = "📊 Daily Levels"
showLevels   = input.bool(true, "Show PDH/PDL", group=grpLevels)
showPDLabels = input.bool(true, "Show PDH/PDL Labels", group=grpLevels)
showLondon   = input.bool(true, "Show London High/Low", group=grpLevels)
showLonLbl   = input.bool(true, "Show London Labels", group=grpLevels)
lonSession   = input.session("0200-0500", "London Session (CST)", group=grpLevels, tooltip="2:00-5:00 AM Central = London open hours\nTracks the high and low of this window")
show4H       = input.bool(true, "Show Prev 4H High/Low", group=grpLevels)
show4HLbl    = input.bool(true, "Show Prev 4H Labels", group=grpLevels)

grpOR        = "📐 Opening Range"
showOR       = input.bool(true, "Show Opening Range", group=grpOR)
orMinutes    = input.int(5, "OR Duration (min)", minval=1, maxval=60, group=grpOR)

grpSignal    = "⚡ Signals"
cooldownBars  = input.int(10, "Min Bars Between Signals", minval=1, maxval=100, group=grpSignal)
maxSignals    = input.int(3, "Max Signals Per Day", minval=1, maxval=20, group=grpSignal)
showBear      = input.bool(true, "Show Bearish Reclaims", group=grpSignal)
enablePDHPDL  = input.bool(true, "Enable PDH/PDL Setups", group=grpSignal, tooltip="Scarface Trades 'Daily Candle Scalper':\nSame one-candle logic at Previous Day High/Low levels")

grpFilter    = "🔬 Quality Filters"
useVolFilter     = input.bool(true, "Volume Confirmation", group=grpFilter)
volMaLen         = input.int(20, "Volume MA Length", minval=5, maxval=100, group=grpFilter)
useBodyFilter    = input.bool(true, "Min Candle Body Size", group=grpFilter)
minBodyPct       = input.float(20.0, "Min Body (% of ATR)", minval=5.0, maxval=100.0, step=5.0, group=grpFilter)
useCloseFilter   = input.bool(true, "Strong Reclaim Close", group=grpFilter)
closeStrength    = input.float(55.0, "Close Strength (%)", minval=50.0, maxval=90.0, step=5.0, group=grpFilter)
useRetestFilter  = input.bool(true, "Require Retest", group=grpFilter, tooltip="Price must touch/cross the OCR level before reclaim fires")
useBOQuality     = input.bool(true, "Breakout Quality Check", group=grpFilter, tooltip="Breakout candle must have strong body (>60% of range)\nand close above OR High (not just a wick)")
minBOBodyPct     = input.float(60.0, "Min Breakout Body (%)", minval=30.0, maxval=90.0, step=5.0, group=grpFilter)
useORSizeFilter  = input.bool(true, "Overextended OR Filter", group=grpFilter, tooltip="Skip setups when OR range > 2x ATR — move may be exhausted")
orSizeMulti      = input.float(2.0, "Max OR Size (x ATR)", minval=1.0, maxval=5.0, step=0.5, group=grpFilter)
useTimeFilter    = input.bool(true, "Trading Hours Filter", group=grpFilter)
sessionStart     = input.session("0830-1000", "Session (CST)", group=grpFilter, tooltip="8:30-10:00 AM Central = first 90 min")

grpVisual    = "🎨 Visuals"
showLevel      = input.bool(true, "OCR Level Lines", group=grpVisual)
showLevelLbl   = input.bool(true, "Level Labels", group=grpVisual)
showDipZone    = input.bool(true, "Pullback Zone", group=grpVisual)
showBreakout   = input.bool(true, "Mark Breakout", group=grpVisual)
showSessionBg  = input.bool(true, "Session Background", group=grpVisual)
highlightCandles = input.bool(true, "Highlight Key Candles", group=grpVisual)
showDashboard  = input.bool(true, "Status Dashboard", group=grpVisual)

grpMA        = "📈 Moving Averages"
showEmas     = input.bool(true, "Show EMAs (9, 50, 200)", group=grpMA)
showVwap     = input.bool(true, "Show Session VWAP", group=grpMA)

// ══════════════════════════════════════════════════════════════
// MOVING AVERAGES & VWAP
// ══════════════════════════════════════════════════════════════
ema9   = ta.ema(close, 9)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)

// Standard Session-anchored VWAP
var float vwapSum = 0.0, var float volSum = 0.0
if ta.change(time("D")) != 0
    vwapSum := 0.0
    volSum  := 0.0
vwapSum += hlc3 * volume
volSum  += volume
dayVwap = volSum > 0 ? vwapSum / volSum : na

plot(showEmas ? ema9   : na, title="9 EMA",   color=color.new(#FFFFFF, 0), linewidth=1)
plot(showEmas ? ema50  : na, title="50 EMA",  color=color.new(#2196F3, 0), linewidth=1)
plot(showEmas ? ema200 : na, title="200 EMA", color=color.new(#F44336, 0), linewidth=1)
plot(showVwap ? dayVwap : na, title="VWAP",   color=color.new(#FFD700, 0), linewidth=1)

// ══════════════════════════════════════════════════════════════
// CORE CALCULATIONS (Optimized Tuple Security Calls)
// ══════════════════════════════════════════════════════════════
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[p4hH, p4hL, p4hO, p4hC] = request.security(syminfo.tickerid, "240", [high[1], low[1], open[1], close[1]], lookahead=barmerge.lookahead_on)
volMa    = ta.sma(volume, volMaLen)
atrValue = ta.atr(14)

is_new_day = ta.change(time("D")) != 0
inSession  = useTimeFilter ? not na(time(timeframe.period, sessionStart, "America/Chicago")) : true

// Detect the FIRST bar of the session (8:30 AM CST) — this is the real "day start" for our strategy
var bool wasInSession = false
isSessionOpen = inSession and not wasInSession  // transition from outside → inside session
wasInSession := inSession

bgcolor(showSessionBg and inSession and useTimeFilter ? C_SESSION_BG : na, title="Session Window")

// ══════════════════════════════════════════════════════════════
// 4H CANDLE BOX (Novo Legacy — Quarter Zone Strategy)
// ══════════════════════════════════════════════════════════════
// Snapshot at session open: previous 4H OHLC → fixed all day
var float fix4hH = na, var float fix4hL = na
var float fix4hO = na, var float fix4hC = na
var bool  fix4hBull = false

// Quarter zone levels
var float z0 = na, var float z25 = na, var float z50 = na, var float z75 = na, var float z100 = na

// Drawing objects
var box   fourHBox     = na
var box   fourHOptZone = na  // 25-50% optimum entry zone
var box   fourHDanger  = na  // 75-100% danger zone
var line  fourH25  = na, var line fourH50  = na, var line fourH75  = na
var line  fourHHid1 = na, var line fourHHid2 = na  // hidden levels (open + close)
var label fourHL0 = na, var label fourHL25 = na, var label fourHL50 = na
var label fourHL75 = na, var label fourHL100 = na, var label fourHLHid = na

C_4H_BULL_BG = color.new(#4CAF50, 92)
C_4H_BEAR_BG = color.new(#F44336, 92)
C_4H_OPT     = color.new(#66BB6A, 88)  // optimum zone
C_4H_DANGER  = color.new(#F44336, 88)  // danger zone
C_4H_ZONE    = color.new(#78909C, 50)  // zone borders
C_4H_MID     = color.new(#FFFFFF, 40)  // 50% midline
C_4H_HIDDEN  = color.new(#FFEB3B, 40)  // hidden levels (O/C)

if isSessionOpen and show4H
    fix4hH := p4hH, fix4hL := p4hL, fix4hO := p4hO, fix4hC := p4hC
    fix4hBull := fix4hC > fix4hO
    float rng = fix4hH - fix4hL

    // Quarter levels: 0% = top of move, 100% = bottom of move
    z0   := fix4hBull ? fix4hH : fix4hL
    z25  := fix4hBull ? fix4hH - rng * 0.25 : fix4hL + rng * 0.25
    z50  := fix4hBull ? fix4hH - rng * 0.50 : fix4hL + rng * 0.50
    z75  := fix4hBull ? fix4hH - rng * 0.75 : fix4hL + rng * 0.75
    z100 := fix4hBull ? fix4hL : fix4hH

    // Clean up old drawings
    box.delete(fourHBox), box.delete(fourHOptZone), box.delete(fourHDanger)
    line.delete(fourH25), line.delete(fourH50), line.delete(fourH75)
    line.delete(fourHHid1), line.delete(fourHHid2)
    label.delete(fourHL0), label.delete(fourHL25), label.delete(fourHL50)
    label.delete(fourHL75), label.delete(fourHL100), label.delete(fourHLHid)

    // Main 4H box
    fourHBox := box.new(bar_index, fix4hH, bar_index + 15, fix4hL, border_color=C_4H_ZONE, bgcolor=fix4hBull ? C_4H_BULL_BG : C_4H_BEAR_BG, border_width=1)

    // Optimum entry zone (25-50%)
    float optTop = math.max(z25, z50), float optBot = math.min(z25, z50)
    fourHOptZone := box.new(bar_index, optTop, bar_index + 15, optBot, border_color=color.new(#66BB6A, 70), bgcolor=C_4H_OPT, border_width=1, border_style=line.style_dotted)

    // Danger zone (75-100%)
    float danTop = math.max(z75, z100), float danBot = math.min(z75, z100)
    fourHDanger := box.new(bar_index, danTop, bar_index + 15, danBot, border_color=color.new(#F44336, 70), bgcolor=C_4H_DANGER, border_width=1, border_style=line.style_dotted)

    // Quarter lines
    fourH25 := line.new(bar_index, z25, bar_index + 15, z25, color=C_4H_ZONE, style=line.style_dotted, width=1)
    fourH50 := line.new(bar_index, z50, bar_index + 15, z50, color=C_4H_MID, style=line.style_dashed, width=2)
    fourH75 := line.new(bar_index, z75, bar_index + 15, z75, color=C_4H_ZONE, style=line.style_dotted, width=1)

    // Hidden levels — Open & Close
    fourHHid1 := line.new(bar_index, fix4hO, bar_index + 15, fix4hO, color=C_4H_HIDDEN, style=line.style_dashed, width=1)
    fourHHid2 := line.new(bar_index, fix4hC, bar_index + 15, fix4hC, color=C_4H_HIDDEN, style=line.style_dashed, width=1)

    // Zone labels
    if show4HLbl
        string biasStr = fix4hBull ? "🟢 BULL" : "🔴 BEAR"
        fourHL0   := label.new(bar_index - 1, z0, " 0% " + biasStr + " ", color=color.new(fix4hBull ? #4CAF50 : #F44336, 80), textcolor=color.new(#FFFFFF, 10), style=label.style_label_right, size=size.normal, tooltip="0% — PREMATURE ZONE\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nThis is the tip of the previous 4H candle.\n\nDO NOT enter here. Price at this level has\nnot pulled back yet. Entering here is\n'chasing' — you're buying the top or\nselling the bottom with no discount.\n\nWait for price to retrace into the 25-50%\nzone before looking for entries.\n\nBias: " + (fix4hBull ? "BULLISH — prev 4H closed green\nso we expect upward continuation." : "BEARISH — prev 4H closed red\nso we expect downward continuation."))
        fourHL25  := label.new(bar_index - 1, z25, " 25% Optimum ", color=color.new(#66BB6A, 80), textcolor=color.new(#66BB6A, 5), style=label.style_label_right, size=size.normal, tooltip="25% — OPTIMUM ENTRY ZONE START\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nThis is where the ideal pullback zone begins.\n\nWhen price pulls back to this level, start\nlooking for entries on the lower timeframe\n(1min, 2min, or 5min chart).\n\nWait for a rejection candle or a candle\nclosure back in the direction of the 4H bias\nbefore entering.\n\nThe 25%-50% zone is the 'sweet spot' —\nyou're getting a discount on the move while\nthe trend is still intact.\n\nPrice: " + str.tostring(z25, "#.##"))
        fourHL50  := label.new(bar_index - 1, z50, " 50% EQ " + str.tostring(z50, "#.##") + " ", color=color.new(#FFFFFF, 80), textcolor=color.new(#FFFFFF, 10), style=label.style_label_right, size=size.normal, tooltip="50% — EQUILIBRIUM (Fair Value)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nThis is the midpoint of the previous 4H candle.\nAlso known as 'fair value' or 'equilibrium'.\n\nThis is the DEEPEST you want your pullback\nto go for a high-probability continuation.\n\nIf price holds above this level (for bulls)\nor below it (for bears), the move is healthy.\n\nA CLOSE beyond 50% starts to weaken the\nbias — not an automatic invalidation, but\na yellow flag. Be cautious.\n\nMany traders use this as their stop-loss\nplacement level for tighter risk.\n\nPrice: " + str.tostring(z50, "#.##"))
        fourHL75  := label.new(bar_index - 1, z75, " 75% Danger ", color=color.new(#F44336, 80), textcolor=color.new(#F44336, 5), style=label.style_label_right, size=size.normal, tooltip="75% — DANGER ZONE\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPrice has retraced too deep into the\nprevious 4H candle range.\n\n⚠️ A WICK into this zone is acceptable —\nit shows liquidity was grabbed.\n\n❌ A CLOSE in this zone is a warning sign.\nIt means the bias from the 4H candle is\nweakening significantly.\n\nIf price closes here, consider:\n• Avoiding new entries\n• Tightening stops on existing positions\n• Waiting for a new 4H candle to form\n\nThis zone exists because when 75%+ of a\nmove is retraced, most of the momentum\nhas been absorbed by the counter-move.\n\nPrice: " + str.tostring(z75, "#.##"))
        fourHL100 := label.new(bar_index - 1, z100, " 100% Invalid ", color=color.new(#F44336, 80), textcolor=color.new(#FF5252, 5), style=label.style_label_right, size=size.normal, tooltip="100% — FULL INVALIDATION\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nThe entire previous 4H move has been erased.\n\n🚫 If price CLOSES beyond this level,\nthe 4H bias is completely invalid.\n\nDO NOT take continuation trades. The market\nhas fully rejected the previous move.\n\nWhat to do:\n• Close any open positions based on this bias\n• Wait for the next 4H candle to close\n• Reassess the new bias direction\n\nA close beyond 100% often signals a\nreversal — the opposite side has taken\ncomplete control.\n\nPrice: " + str.tostring(z100, "#.##"))
        fourHLHid := label.new(bar_index + 16, fix4hC, " Hidden " + str.tostring(fix4hC, "#.##") + " ", color=color.new(#FFEB3B, 80), textcolor=color.new(#FFEB3B, 5), style=label.style_label_left, size=size.normal, tooltip="HIDDEN LEVEL — Previous 4H Close\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPrice: " + str.tostring(fix4hC, "#.##") + "\n\nThe OPEN and CLOSE of the previous 4H candle\nare 'hidden levels' that most traders miss.\n\nWhy they matter:\n• These are the exact prices where buyers\n  and sellers committed to their positions.\n• Price frequently retests these levels before\n  continuing in the bias direction.\n• They act as invisible support/resistance.\n\nHow to use:\n• Watch for bounces or rejections at these\n  yellow dashed lines.\n• They provide excellent entry points when\n  combined with the 25-50% zone.\n• If price breaks AND closes through the\n  hidden level cleanly, it adds confluence\n  to the bias direction.")

// Extend box + lines to current bar
if not na(fourHBox)
    box.set_right(fourHBox, bar_index + 3)
    box.set_right(fourHOptZone, bar_index + 3)
    box.set_right(fourHDanger, bar_index + 3)
if not na(fourH25)
    line.set_x2(fourH25, bar_index + 3), line.set_x2(fourH50, bar_index + 3), line.set_x2(fourH75, bar_index + 3)
if not na(fourHHid1)
    line.set_x2(fourHHid1, bar_index + 15), line.set_x2(fourHHid2, bar_index + 15)
if show4HLbl and not na(fourHLHid)
    label.set_x(fourHLHid, bar_index + 16)

// ══════════════════════════════════════════════════════════════
// PDH / PDL LINES (Dynamic — react when touched)
// ══════════════════════════════════════════════════════════════
var line pdhLine = na, var line pdlLine = na
var line pdhGlw  = na, var line pdlGlw  = na
var label pdhLbl = na, var label pdlLbl = na
var bool pdhTouched = false, var bool pdlTouched = false
var bool pdhSwept   = false, var bool pdlSwept   = false

if is_new_day and showLevels
    line.delete(pdhLine), line.delete(pdlLine), line.delete(pdhGlw), line.delete(pdlGlw)
    label.delete(pdhLbl), label.delete(pdlLbl)
    pdhTouched := false, pdlTouched := false
    pdhSwept := false, pdlSwept := false
    pdhGlw  := line.new(bar_index, pdh, bar_index, pdh, color=C_PDH_GLOW, style=line.style_solid, width=4)
    pdlGlw  := line.new(bar_index, pdl, bar_index, pdl, color=C_PDL_GLOW, style=line.style_solid, width=4)
    pdhLine := line.new(bar_index, pdh, bar_index, pdh, color=C_PDH, style=line.style_dotted, width=1)
    pdlLine := line.new(bar_index, pdl, bar_index, pdl, color=C_PDL, style=line.style_dotted, width=1)
    if showPDLabels
        pdhLbl := label.new(bar_index, pdh, " ▸ PDH " + str.tostring(pdh, "#.##") + " ", color=color.new(#81C784, 82), textcolor=color.new(#81C784, 5), style=label.style_label_left, size=size.normal, tooltip="PREVIOUS DAY HIGH (PDH)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPrice: " + str.tostring(pdh, "#.##") + "\n\nThis is yesterday's highest price. It acts as\na major resistance / liquidity level.\n\nWhy it matters:\n• Market makers and institutions place sell\n  orders above PDH to trap breakout buyers.\n• A CLEAN break and CLOSE above PDH with\n  strong volume = bullish continuation.\n• A rejection at PDH = potential reversal.\n\nHow we use it:\n• If price breaks above PDH → look for the\n  ONE CANDLE RULE setup (PDH Bull).\n• PDH is also a key take-profit target for\n  longs from the OR setup.")
        pdlLbl := label.new(bar_index, pdl, " ▸ PDL " + str.tostring(pdl, "#.##") + " ", color=color.new(#E57373, 82), textcolor=color.new(#E57373, 5), style=label.style_label_left, size=size.normal, tooltip="PREVIOUS DAY LOW (PDL)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPrice: " + str.tostring(pdl, "#.##") + "\n\nThis is yesterday's lowest price. It acts as\na major support / liquidity level.\n\nWhy it matters:\n• Market makers and institutions place buy\n  orders below PDL to trap breakdown sellers.\n• A CLEAN break and CLOSE below PDL with\n  strong volume = bearish continuation.\n• A rejection at PDL = potential reversal.\n\nHow we use it:\n• If price breaks below PDL → look for the\n  ONE CANDLE RULE setup (PDL Bear).\n• PDL is also a key take-profit target for\n  shorts from the OR setup.")

// PDH touch detection
if not pdhTouched and high >= pdh and not na(pdhLine)
    pdhTouched := true
    if close > pdh
        pdhSwept := true
if pdhTouched and not na(pdhLine)
    line.set_style(pdhLine, line.style_solid), line.set_width(pdhLine, 3)
    line.set_color(pdhLine, pdhSwept ? color.new(#FFFFFF, 0) : color.new(#81C784, 0))
    line.set_color(pdhGlw, color.new(#81C784, 20)), line.set_width(pdhGlw, 10)
    if showPDLabels and not na(pdhLbl)
        string pdhStat = pdhSwept ? " ⚡ PDH SWEPT " : " ✦ PDH TESTED "
        label.set_text(pdhLbl, pdhStat + str.tostring(pdh, "#.##") + " ")
        label.set_color(pdhLbl, pdhSwept ? color.new(#81C784, 40) : color.new(#81C784, 55))
        label.set_textcolor(pdhLbl, color.new(#FFFFFF, 0))
        label.set_size(pdhLbl, pdhSwept ? size.large : size.normal)
if not pdhSwept and pdhTouched and close > pdh
    pdhSwept := true

// PDL touch detection
if not pdlTouched and low <= pdl and not na(pdlLine)
    pdlTouched := true
    if close < pdl
        pdlSwept := true
if pdlTouched and not na(pdlLine)
    line.set_style(pdlLine, line.style_solid), line.set_width(pdlLine, 3)
    line.set_color(pdlLine, pdlSwept ? color.new(#FFFFFF, 0) : color.new(#E57373, 0))
    line.set_color(pdlGlw, color.new(#E57373, 20)), line.set_width(pdlGlw, 10)
    if showPDLabels and not na(pdlLbl)
        string pdlStat = pdlSwept ? " ⚡ PDL SWEPT " : " ✦ PDL TESTED "
        label.set_text(pdlLbl, pdlStat + str.tostring(pdl, "#.##") + " ")
        label.set_color(pdlLbl, pdlSwept ? color.new(#E57373, 40) : color.new(#E57373, 55))
        label.set_textcolor(pdlLbl, color.new(#FFFFFF, 0))
        label.set_size(pdlLbl, pdlSwept ? size.large : size.normal)
if not pdlSwept and pdlTouched and close < pdl
    pdlSwept := true

if not na(pdhLine)
    line.set_x2(pdhLine, bar_index + 15), line.set_x2(pdhGlw, bar_index + 15)
if not na(pdlLine)
    line.set_x2(pdlLine, bar_index + 15), line.set_x2(pdlGlw, bar_index + 15)
if showPDLabels and not na(pdhLbl)
    label.set_x(pdhLbl, bar_index + 15), label.set_y(pdhLbl, pdh)
if showPDLabels and not na(pdlLbl)
    label.set_x(pdlLbl, bar_index + 15), label.set_y(pdlLbl, pdl)

// ══════════════════════════════════════════════════════════════
// LONDON HIGH / LOW (Dynamic — react when touched)
// ══════════════════════════════════════════════════════════════
inLondon = not na(time(timeframe.period, lonSession, "America/Chicago"))
var bool wasInLondon = false
lonStart = inLondon and not wasInLondon
lonEnd   = not inLondon and wasInLondon
wasInLondon := inLondon

var float lonHigh = na, var float lonLow = na
var line lonHLine = na, var line lonLLine = na
var line lonHGlw  = na, var line lonLGlw  = na
var label lonHLbl = na, var label lonLLbl = na
var bool lonDone = false
var bool lonHTouched = false, var bool lonLTouched = false
var bool lonHSwept   = false, var bool lonLSwept   = false

if lonStart
    lonHigh := high, lonLow := low, lonDone := false
    lonHTouched := false, lonLTouched := false
    lonHSwept := false, lonLSwept := false
    if showLondon
        line.delete(lonHLine), line.delete(lonLLine), line.delete(lonHGlw), line.delete(lonLGlw)
        label.delete(lonHLbl), label.delete(lonLLbl)
        lonHLine := na, lonLLine := na, lonHGlw := na, lonLGlw := na
        lonHLbl := na, lonLLbl := na

if inLondon and not lonStart and not lonDone
    lonHigh := math.max(lonHigh, high)
    lonLow  := math.min(lonLow, low)

if lonEnd and showLondon and not lonDone
    lonDone := true
    lonHGlw  := line.new(bar_index, lonHigh, bar_index, lonHigh, color=C_LON_H_GLOW, style=line.style_solid, width=4)
    lonLGlw  := line.new(bar_index, lonLow,  bar_index, lonLow,  color=C_LON_L_GLOW, style=line.style_solid, width=4)
    lonHLine := line.new(bar_index, lonHigh, bar_index, lonHigh, color=C_LON_H, style=line.style_dashed, width=1)
    lonLLine := line.new(bar_index, lonLow,  bar_index, lonLow,  color=C_LON_L, style=line.style_dashed, width=1)
    if showLonLbl
        lonHLbl := label.new(bar_index, lonHigh, " ▸ LON H " + str.tostring(lonHigh, "#.##") + " ", color=color.new(#42A5F5, 82), textcolor=color.new(#42A5F5, 5), style=label.style_label_left, size=size.normal, tooltip="LONDON SESSION HIGH\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPrice: " + str.tostring(lonHigh, "#.##") + "\nSession Range: " + str.tostring(lonHigh - lonLow, "#.##") + "\n\nThis is the highest price reached during\nthe London trading session (2-5 AM CST).\n\nWhy it matters:\n• London is the largest forex trading center.\n• The London high often acts as resistance\n  during the New York session.\n• Smart money uses the London range to set\n  the day's liquidity pools.\n\nWatch for:\n• Price sweeping London High during NY session\n  then reversing = liquidity grab.\n• A clean break above = bullish momentum.")
        lonLLbl := label.new(bar_index, lonLow,  " ▸ LON L " + str.tostring(lonLow, "#.##") + " ",  color=color.new(#FFA726, 82), textcolor=color.new(#FFA726, 5), style=label.style_label_left, size=size.normal, tooltip="LONDON SESSION LOW\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPrice: " + str.tostring(lonLow, "#.##") + "\nSession Range: " + str.tostring(lonHigh - lonLow, "#.##") + "\n\nThis is the lowest price reached during\nthe London trading session (2-5 AM CST).\n\nWhy it matters:\n• The London low often acts as support\n  during the New York session.\n• If NY session sweeps London Low then\n  reverses = classic liquidity grab pattern.\n\nWatch for:\n• Price sweeping London Low during NY session\n  then bouncing = bullish reversal signal.\n• A clean break below = bearish momentum.")

// London H touch detection
if lonDone and not lonHTouched and high >= lonHigh and not na(lonHLine)
    lonHTouched := true
    if close > lonHigh
        lonHSwept := true
if lonHTouched and not na(lonHLine)
    line.set_style(lonHLine, line.style_solid), line.set_width(lonHLine, 3)
    line.set_color(lonHLine, lonHSwept ? color.new(#FFFFFF, 0) : color.new(#42A5F5, 0))
    line.set_color(lonHGlw, color.new(#42A5F5, 20)), line.set_width(lonHGlw, 10)
    if showLonLbl and not na(lonHLbl)
        string lonHStat = lonHSwept ? " ⚡ LON H SWEPT " : " ✦ LON H TESTED "
        label.set_text(lonHLbl, lonHStat + str.tostring(lonHigh, "#.##") + " ")
        label.set_color(lonHLbl, lonHSwept ? color.new(#42A5F5, 40) : color.new(#42A5F5, 55))
        label.set_textcolor(lonHLbl, color.new(#FFFFFF, 0))
        label.set_size(lonHLbl, lonHSwept ? size.large : size.normal)
if not lonHSwept and lonHTouched and close > lonHigh
    lonHSwept := true

// London L touch detection
if lonDone and not lonLTouched and low <= lonLow and not na(lonLLine)
    lonLTouched := true
    if close < lonLow
        lonLSwept := true
if lonLTouched and not na(lonLLine)
    line.set_style(lonLLine, line.style_solid), line.set_width(lonLLine, 3)
    line.set_color(lonLLine, lonLSwept ? color.new(#FFFFFF, 0) : color.new(#FFA726, 0))
    line.set_color(lonLGlw, color.new(#FFA726, 20)), line.set_width(lonLGlw, 10)
    if showLonLbl and not na(lonLLbl)
        string lonLStat = lonLSwept ? " ⚡ LON L SWEPT " : " ✦ LON L TESTED "
        label.set_text(lonLLbl, lonLStat + str.tostring(lonLow, "#.##") + " ")
        label.set_color(lonLLbl, lonLSwept ? color.new(#FFA726, 40) : color.new(#FFA726, 55))
        label.set_textcolor(lonLLbl, color.new(#FFFFFF, 0))
        label.set_size(lonLLbl, lonLSwept ? size.large : size.normal)
if not lonLSwept and lonLTouched and close < lonLow
    lonLSwept := true

if not na(lonHLine)
    line.set_x2(lonHLine, bar_index + 15), line.set_x2(lonHGlw, bar_index + 15)
if not na(lonLLine)
    line.set_x2(lonLLine, bar_index + 15), line.set_x2(lonLGlw, bar_index + 15)
if showLonLbl and not na(lonHLbl)
    label.set_x(lonHLbl, bar_index + 15), label.set_y(lonHLbl, lonHigh)
if showLonLbl and not na(lonLLbl)
    label.set_x(lonLLbl, bar_index + 15), label.set_y(lonLLbl, lonLow)

// ══════════════════════════════════════════════════════════════
// OPENING RANGE (Dynamic — turns green on bull break, red on bear break)
// ══════════════════════════════════════════════════════════════
var float orHigh = na, var float orLow = na
var bool orComplete = false, var int dayStartTime = 0
var box orBox = na, var box orGlwBox = na
var label orHLbl = na, var label orLLbl = na
var line orHLine = na, var line orLLine = na
var line orHGlw  = na, var line orLGlw  = na
var bool orOverextended = false
var int orBreakDir = 0  // 0=neutral, 1=bull, -1=bear

if isSessionOpen
    orHigh := high, orLow := low
    orComplete := false, dayStartTime := time, orOverextended := false
    orBreakDir := 0
    if showOR
        box.delete(orBox), box.delete(orGlwBox)
        label.delete(orHLbl), label.delete(orLLbl)
        line.delete(orHLine), line.delete(orLLine), line.delete(orHGlw), line.delete(orLGlw)
        orHLine := na, orLLine := na, orHGlw := na, orLGlw := na
        orGlwBox := box.new(bar_index, high, bar_index, low, border_color=color.new(#F59E0B, 100), bgcolor=color.new(#F59E0B, 95), border_width=0, border_style=line.style_solid)
        orBox := box.new(bar_index, high, bar_index, low, border_color=C_OR_BORDER, bgcolor=C_OR_FILL, border_width=1, border_style=line.style_solid)

orElapsed = (time - dayStartTime) / 60000
if not orComplete and not isSessionOpen
    if orElapsed < orMinutes
        orHigh := math.max(orHigh, high)
        orLow  := math.min(orLow, low)
        if showOR and not na(orBox)
            box.set_right(orBox, bar_index), box.set_top(orBox, orHigh), box.set_bottom(orBox, orLow)
            box.set_right(orGlwBox, bar_index), box.set_top(orGlwBox, orHigh), box.set_bottom(orGlwBox, orLow)
    else
        orComplete := true
        // CHECK #2: Overextended OR filter
        orOverextended := useORSizeFilter and atrValue > 0 and (orHigh - orLow) > (atrValue * orSizeMulti)
        if showOR and not na(orBox)
            box.set_right(orBox, bar_index), box.set_top(orBox, orHigh), box.set_bottom(orBox, orLow)
            box.set_right(orGlwBox, bar_index), box.set_top(orGlwBox, orHigh), box.set_bottom(orGlwBox, orLow)
            
            // Only build these heavy strings ONCE when the OR completes to save memory
            if orElapsed >= orMinutes-1 // Build on the final bar
                string orRangeStr = str.tostring(orHigh - orLow, "#.##")
                string orSizeNote = orOverextended ? "\n⚠️ OVEREXTENDED — skipping OR signals" : ""
                string orHTip = "OPENING RANGE HIGH\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPrice: " + str.tostring(orHigh, "#.##") + "\nOR Low: " + str.tostring(orLow, "#.##") + "\nRange: " + orRangeStr + " | Window: " + str.tostring(orMinutes) + " min" + orSizeNote + "\n\nThe Opening Range is the high and low of\nthe FIRST " + str.tostring(orMinutes) + " minutes after market open.\n\nWhy it matters:\n• This is where institutions establish their\n  initial positions for the day.\n• A CLOSE above OR High = bullish breakout.\n  This starts the One Candle Rule setup.\n• ~70% of the time, the day's direction is\n  set by the first breakout of the OR.\n\nBreakout rules:\n• Must CLOSE above (not just wick)\n• Body should be >60% of candle range\n• Volume should be above the 20 MA"
                string orLTip = "OPENING RANGE LOW\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPrice: " + str.tostring(orLow, "#.##") + "\nOR High: " + str.tostring(orHigh, "#.##") + "\nRange: " + orRangeStr + " | Window: " + str.tostring(orMinutes) + " min" + orSizeNote + "\n\nThis is the low of the Opening Range.\n\nA CLOSE below OR Low = bearish breakdown.\nThis starts the bearish One Candle Rule setup.\n\nIf price breaks below and the breakdown candle\nhas a strong body, look for the first green\n(up-close) candle → that's your One Candle.\nEntry is when price reclaims below that level."
                
                orHLbl := label.new(bar_index + 3, orHigh, " ▸ OR High " + str.tostring(orHigh, "#.##") + " ", color=color.new(#F59E0B, 85), textcolor=C_OR_TEXT, style=label.style_label_left, size=size.normal, tooltip=orHTip)
                orLLbl := label.new(bar_index + 3, orLow,  " ▸ OR Low " + str.tostring(orLow, "#.##") + " ",  color=color.new(#F59E0B, 85), textcolor=C_OR_TEXT, style=label.style_label_left, size=size.normal, tooltip=orLTip)
            else
                // Temporary labels while building
                orHLbl := label.new(bar_index + 3, orHigh, " ▸ OR High " + str.tostring(orHigh, "#.##") + " ", color=color.new(#F59E0B, 85), textcolor=C_OR_TEXT, style=label.style_label_left, size=size.normal)
                orLLbl := label.new(bar_index + 3, orLow,  " ▸ OR Low " + str.tostring(orLow, "#.##") + " ",  color=color.new(#F59E0B, 85), textcolor=C_OR_TEXT, style=label.style_label_left, size=size.normal)
            orHGlw := line.new(bar_index, orHigh, bar_index, orHigh, color=color.new(C_OR_GLOW, 100), style=line.style_solid, width=1)
            orLGlw := line.new(bar_index, orLow,  bar_index, orLow,  color=color.new(C_OR_GLOW, 100), style=line.style_solid, width=1)
            orHLine := line.new(bar_index, orHigh, bar_index, orHigh, color=C_OR_LINE, style=line.style_dashed, width=1)
            orLLine := line.new(bar_index, orLow,  bar_index, orLow,  color=C_OR_LINE, style=line.style_dashed, width=1)

// Dynamic OR color on breakout
if orComplete and orBreakDir == 0 and close > orHigh
    orBreakDir := 1
if orComplete and orBreakDir == 0 and close < orLow
    orBreakDir := -1

if orBreakDir != 0 and showOR and not na(orBox)
    color orClrFill   = orBreakDir == 1 ? color.new(#4CAF50, 88) : color.new(#F44336, 88)
    color orClrBorder = orBreakDir == 1 ? color.new(#4CAF50, 30) : color.new(#F44336, 30)
    color orClrLine   = orBreakDir == 1 ? color.new(#4CAF50, 0) : color.new(#F44336, 0)
    box.set_bgcolor(orBox, orClrFill), box.set_border_color(orBox, orClrBorder)
    box.set_bgcolor(orGlwBox, color.new(orClrLine, 95)), box.set_border_color(orGlwBox, color.new(orClrLine, 100))
    if orBreakDir == 1 and not na(orHLine)
        line.set_color(orHLine, orClrLine), line.set_style(orHLine, line.style_solid), line.set_width(orHLine, 3)
        line.set_color(orHGlw, color.new(orClrLine, 20)), line.set_width(orHGlw, 10)
    if orBreakDir == -1 and not na(orLLine)
        line.set_color(orLLine, orClrLine), line.set_style(orLLine, line.style_solid), line.set_width(orLLine, 3)
        line.set_color(orLGlw, color.new(orClrLine, 20)), line.set_width(orLGlw, 10)
    if not na(orHLbl)
        string orHTxt = orBreakDir == 1 ? " SETUP A - OR HIGH " + str.tostring(orHigh, "#.##") + " " : " ▸ OR HIGH " + str.tostring(orHigh, "#.##") + " "
        label.set_text(orHLbl, orHTxt)
        label.set_color(orHLbl, color.new(orBreakDir == 1 ? #4CAF50 : #F59E0B, orBreakDir == 1 ? 40 : 85))
        label.set_textcolor(orHLbl, color.new(orBreakDir == 1 ? #FFFFFF : C_OR_TEXT, 0))
        if orBreakDir == 1
            label.set_size(orHLbl, size.large)
    if not na(orLLbl)
        string orLTxt = orBreakDir == -1 ? " SETUP B - OR LOW " + str.tostring(orLow, "#.##") + " " : " ▸ OR LOW " + str.tostring(orLow, "#.##") + " "
        label.set_text(orLLbl, orLTxt)
        label.set_color(orLLbl, color.new(orBreakDir == -1 ? #F44336 : #F59E0B, orBreakDir == -1 ? 40 : 85))
        label.set_textcolor(orLLbl, color.new(orBreakDir == -1 ? #FFFFFF : C_OR_TEXT, 0))
        if orBreakDir == -1
            label.set_size(orLLbl, size.large)

if not na(orHLine)
    line.set_x2(orHLine, bar_index + 15), line.set_x2(orHGlw, bar_index + 15)
if not na(orLLine)
    line.set_x2(orLLine, bar_index + 15), line.set_x2(orLGlw, bar_index + 15)

// ══════════════════════════════════════════════════════════════
// HELPERS
// ══════════════════════════════════════════════════════════════
candleBody   = math.abs(close - open)
candleRange  = high - low
upperClose   = candleRange > 0 ? (close - low) / candleRange * 100 : 50.0
bodyRatio    = candleRange > 0 ? candleBody / candleRange * 100 : 0.0

volPass       = not useVolFilter or (volume > volMa)
closeBullPass = not useCloseFilter or (upperClose >= closeStrength)
closeBearPass = not useCloseFilter or (upperClose <= (100.0 - closeStrength))

bodyPass(bodySize) =>
    not useBodyFilter or (atrValue > 0 and (bodySize / atrValue * 100) >= minBodyPct)

// CHECK #1: Breakout quality — body must be large % of total range
boQualityPass = not useBOQuality or (bodyRatio >= minBOBodyPct)

isDownClose = close < open
isUpClose   = close > open

// Candle highlight tracking
var bool hlBullOC = false, var bool hlBullRC = false
var bool hlBearOC = false, var bool hlBearRC = false
var bool hlPDBullOC = false, var bool hlPDBullRC = false
var bool hlPDBearOC = false, var bool hlPDBearRC = false
hlBullOC := false, hlBullRC := false, hlBearOC := false, hlBearRC := false
hlPDBullOC := false, hlPDBullRC := false, hlPDBearOC := false, hlPDBearRC := false



// ══════════════════════════════════════════════════════════════
// SETUP A — OR BREAKOUT: BULLISH
// ══════════════════════════════════════════════════════════════
var int   aBS = 0          // state: 0 wait BO, 1 find red, 2 wait reclaim, 3 fired
var float aOCR = na, var float aPeak = na, var float aDip = na
var int   aCD = 0, var int aSigN = 0
var bool  aRet = false
var line  aLn = na, var line aGl = na, var label aLb = na, var box aZn = na
var int   aBS0 = 0

if isSessionOpen
    if not na(aLn) and aBS != 3
        line.set_color(aLn, C_LEVEL_STALE), line.set_x2(aLn, bar_index)
        if not na(aGl)
            line.set_color(aGl, color.new(#546E7A, 85)), line.set_x2(aGl, bar_index)
    aBS := 0, aOCR := na, aPeak := na, aDip := na, aRet := false
    aCD := 0, aSigN := 0

if aCD > 0
    aCD -= 1

// State 0: breakout
if aBS == 0 and orComplete and not orOverextended and close > orHigh and boQualityPass and inSession
    aBS := 1, aPeak := high
    if showBreakout
        label.new(bar_index, low, "⬆ BO", color=color.new(C_BULL, 80), textcolor=C_BULL_BRIGHT, style=label.style_label_up, size=size.normal, tooltip="🟢 OR BULLISH BREAKOUT\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nClose: " + str.tostring(close, "#.##") + " > OR High: " + str.tostring(orHigh, "#.##") + "\nBody %: " + str.tostring(bodyRatio, "#.0") + "%\n\nPrice has CLOSED above the Opening Range High.\nThis confirms a bullish breakout.\n\nWhat happens next:\n1. Watch for the FIRST RED (down-close) candle\n   — this is the 'One Candle'\n2. Mark the HIGH of that red candle = OCR level\n3. Wait for price to touch/retest the OCR\n4. When price CLOSES above the OCR = ENTRY\n\nThe breakout candle body is " + str.tostring(bodyRatio, "#.0") + "% of its\nrange (we need at least 60% for quality).")

// CHECK #3: Failed breakout invalidation — close back inside OR
if aBS == 1 and close < orHigh and close > orLow
    aBS := 0, aPeak := na  // reset — failed breakout

if aBS == 1 and not isDownClose
    aPeak := math.max(aPeak, high)

// State 1 → 2: first red candle
if aBS == 1 and isDownClose and bodyPass(candleBody) and inSession
    aBS := 2, aOCR := high, aDip := low, aBS0 := bar_index, aRet := low <= high
    hlBullOC := true
    if showLevel
        aGl := line.new(bar_index, aOCR, bar_index+1, aOCR, color=color.new(#0F172A, 40), style=line.style_solid, width=4)
        aLn := line.new(bar_index, aOCR, bar_index+1, aOCR, color=C_LEVEL_ACTIVE, style=line.style_solid, width=1)
        if showLevelLbl
            aLb := label.new(bar_index-1, aOCR, " OCR " + str.tostring(aOCR, "#.##") + " ", color=color.new(#0F172A, 60), textcolor=C_LEVEL_ACTIVE, style=label.style_label_right, size=size.normal, tooltip="🔵 ONE CANDLE RULE — Bull OCR Level\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nReclaim Level: " + str.tostring(aOCR, "#.##") + "\n\nThis is the HIGH of the first red candle\nafter the bullish breakout. It's called the\n'Order Confirmation Range' (OCR).\n\nThis level is KEY because:\n• The red candle represents sellers stepping in\n• If price can CLOSE back above this level,\n  it means buyers have overcome the sellers\n• That reclaim = your entry signal\n\nBefore entering, price must first TOUCH or\ndip below the OCR (retest), then close above.\n\nEntry: Close above " + str.tostring(aOCR, "#.##") + "\nStop: Below the pullback low\nTP1: 1:1 R:R (scale 70%)\nTP2: Pre-pullback high (trail 30%)")

// State 2: wait reclaim
if aBS == 2 and not na(aLn)
    line.set_x2(aLn, bar_index+3)
    if not na(aGl)
        line.set_x2(aGl, bar_index+3)
if aBS == 2 and low < aDip
    aDip := low
if aBS == 2 and low <= aOCR
    aRet := true
    if not na(aLn)
        line.set_color(aLn, C_LEVEL_INVAL)
if aBS == 2 and showDipZone and not na(aOCR) and aDip < aOCR
    box.delete(aZn)
    aZn := box.new(aBS0, aOCR, bar_index, aDip, border_color=color.new(C_BULL, 90), bgcolor=C_BULL_ZONE, border_width=0)

aBullOK = not useRetestFilter or aRet
aBullReclaim = aBS == 2 and aCD == 0 and aSigN < maxSignals and close > aOCR and aBullOK and inSession and volPass and closeBullPass

if aBullReclaim
    aBS := 3, aCD := cooldownBars, aSigN += 1, hlBullRC := true
    if not na(aLn)
        line.set_color(aLn, C_BULL), line.set_x2(aLn, bar_index), line.set_width(aLn, 3)
    if not na(aGl)
        line.set_color(aGl, C_BULL_GLOW), line.set_x2(aGl, bar_index)
    if not na(aZn)
        box.set_right(aZn, bar_index), box.set_border_color(aZn, C_BULL_GLOW), box.set_border_width(aZn, 1)
if aBS == 3 and aCD == 0 and aSigN < maxSignals
    if isDownClose and close > orHigh and bodyPass(candleBody) and inSession
        aBS := 2, aOCR := high, aDip := low, aBS0 := bar_index, aRet := false, hlBullOC := true
        if showLevel
            aGl := line.new(bar_index, aOCR, bar_index+1, aOCR, color=C_LEVEL_GLOW, style=line.style_solid, width=6)
            aLn := line.new(bar_index, aOCR, bar_index+1, aOCR, color=C_LEVEL_ACTIVE, style=line.style_dashed, width=2)

// ══════════════════════════════════════════════════════════════
// SETUP A — OR BREAKOUT: BEARISH
// ══════════════════════════════════════════════════════════════
var int   bBS = 0
var float bOCR = na, var float bPeak = na, var float bDip = na
var int   bCD = 0, var int bSigN = 0
var bool  bRet = false
var line  bLn = na, var line bGl = na, var label bLb = na, var box bZn = na
var int   bBS0 = 0

if isSessionOpen
    if not na(bLn) and bBS != 3
        line.set_color(bLn, C_LEVEL_STALE), line.set_x2(bLn, bar_index)
        if not na(bGl)
            line.set_color(bGl, color.new(#546E7A, 85)), line.set_x2(bGl, bar_index)
    bBS := 0, bOCR := na, bPeak := na, bDip := na, bRet := false
    bCD := 0, bSigN := 0

if bCD > 0
    bCD -= 1

if showBear and bBS == 0 and orComplete and not orOverextended and close < orLow and boQualityPass and inSession
    bBS := 1, bPeak := low
    if showBreakout
        label.new(bar_index, high, "⬇ BO", color=color.new(C_BEAR, 80), textcolor=C_BEAR_BRIGHT, style=label.style_label_down, size=size.normal, tooltip="🔴 OR BEARISH BREAKDOWN\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nClose: " + str.tostring(close, "#.##") + " < OR Low: " + str.tostring(orLow, "#.##") + "\nBody %: " + str.tostring(bodyRatio, "#.0") + "%\n\nPrice has CLOSED below the Opening Range Low.\nThis confirms a bearish breakdown.\n\nWhat happens next:\n1. Watch for the FIRST GREEN (up-close) candle\n   — this is the 'One Candle'\n2. Mark the LOW of that green candle = OCR level\n3. Wait for price to touch/retest the OCR\n4. When price CLOSES below the OCR = ENTRY\n\nThe breakdown candle body is " + str.tostring(bodyRatio, "#.0") + "% of its\nrange (we need at least 60% for quality).")

// Failed breakout invalidation
if bBS == 1 and close > orLow and close < orHigh
    bBS := 0, bPeak := na

if bBS == 1 and not isUpClose
    bPeak := math.min(bPeak, low)

if bBS == 1 and isUpClose and bodyPass(candleBody) and inSession
    bBS := 2, bOCR := low, bDip := high, bBS0 := bar_index, bRet := high >= low
    hlBearOC := true
    if showLevel
        bGl := line.new(bar_index, bOCR, bar_index+1, bOCR, color=color.new(#0F172A, 40), style=line.style_solid, width=4)
        bLn := line.new(bar_index, bOCR, bar_index+1, bOCR, color=C_LEVEL_ACTIVE, style=line.style_solid, width=1)
        if showLevelLbl
            bLb := label.new(bar_index-1, bOCR, " OCR " + str.tostring(bOCR, "#.##") + " ", color=color.new(#0F172A, 60), textcolor=C_LEVEL_ACTIVE, style=label.style_label_right, size=size.normal, tooltip="🔴 ONE CANDLE RULE — Bear OCR Level\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nReclaim Level: " + str.tostring(bOCR, "#.##") + "\n\nThis is the LOW of the first green candle\nafter the bearish breakdown. It's the OCR.\n\nThis level is KEY because:\n• The green candle represents buyers stepping in\n• If price can CLOSE back below this level,\n  it means sellers have overcome the buyers\n• That reclaim = your SHORT entry signal\n\nBefore entering, price should TOUCH or\npush above the OCR (retest), then close below.\n\nEntry: Close below " + str.tostring(bOCR, "#.##") + "\nStop: Above the pullback high\nTP1: 1:1 R:R (scale 70%)\nTP2: Pre-pullback low (trail 30%)")

if bBS == 2 and not na(bLn)
    line.set_x2(bLn, bar_index+3)
    if not na(bGl)
        line.set_x2(bGl, bar_index+3)
if bBS == 2 and high > bDip
    bDip := high
if bBS == 2 and high >= bOCR
    bRet := true
    if not na(bLn)
        line.set_color(bLn, C_LEVEL_INVAL)
if bBS == 2 and showDipZone and not na(bOCR) and bDip > bOCR
    box.delete(bZn)
    bZn := box.new(bBS0, bDip, bar_index, bOCR, border_color=color.new(C_BEAR, 90), bgcolor=C_BEAR_ZONE, border_width=0)

bBearOK = not useRetestFilter or bRet
bBearReclaim = showBear and bBS == 2 and bCD == 0 and bSigN < maxSignals and close < bOCR and bBearOK and inSession and volPass and closeBearPass

if bBearReclaim
    bBS := 3, bCD := cooldownBars, bSigN += 1, hlBearRC := true
    if not na(bLn)
        line.set_color(bLn, C_BEAR), line.set_x2(bLn, bar_index), line.set_width(bLn, 3)
    if not na(bGl)
        line.set_color(bGl, C_BEAR_GLOW), line.set_x2(bGl, bar_index)
    if not na(bZn)
        box.set_right(bZn, bar_index), box.set_border_color(bZn, C_BEAR_GLOW), box.set_border_width(bZn, 1)
if bBS == 3 and bCD == 0 and bSigN < maxSignals
    if isUpClose and close < orLow and bodyPass(candleBody) and inSession
        bBS := 2, bOCR := low, bDip := high, bBS0 := bar_index, bRet := false, hlBearOC := true
        if showLevel
            bGl := line.new(bar_index, bOCR, bar_index+1, bOCR, color=C_LEVEL_GLOW, style=line.style_solid, width=6)
            bLn := line.new(bar_index, bOCR, bar_index+1, bOCR, color=C_LEVEL_ACTIVE, style=line.style_dashed, width=2)

// ══════════════════════════════════════════════════════════════
// SETUP B — PDH/PDL: BULLISH (close above PDH → first red → reclaim)
// ══════════════════════════════════════════════════════════════
var int   pBS = 0
var float pOCR = na, var float pPeak = na, var float pDip = na
var int   pCD = 0, var int pSigN = 0
var bool  pRet = false
var line  pLn = na, var line pGl = na, var label pLb = na, var box pZn = na
var int   pBS0 = 0

if isSessionOpen
    if not na(pLn) and pBS != 3
        line.set_color(pLn, C_LEVEL_STALE), line.set_x2(pLn, bar_index)
    pBS := 0, pOCR := na, pPeak := na, pDip := na, pRet := false
    pCD := 0, pSigN := 0

if pCD > 0
    pCD -= 1

if enablePDHPDL and pBS == 0 and close > pdh and boQualityPass and inSession
    pBS := 1, pPeak := high
    if showBreakout
        label.new(bar_index, low, "⬆ PDH", color=color.new(C_PDH_BULL, 80), textcolor=color.new(C_PDH_BULL_BR, 0), style=label.style_label_up, size=size.normal, tooltip="🟣 PDH Bullish Breakout\n─────────────────\nClose: " + str.tostring(close, "#.##") + " > PDH: " + str.tostring(pdh, "#.##") + "\n\nNow watching for pullback candle...")

if pBS == 1 and not isDownClose
    pPeak := math.max(pPeak, high)

if pBS == 1 and isDownClose and bodyPass(candleBody) and inSession
    pBS := 2, pOCR := high, pDip := low, pBS0 := bar_index, pRet := low <= pOCR  // does one-candle itself retest?
    hlPDBullOC := true
    if showLevel
        pGl := line.new(bar_index, pOCR, bar_index+1, pOCR, color=color.new(#0F172A, 40), style=line.style_solid, width=4)
        pLn := line.new(bar_index, pOCR, bar_index+1, pOCR, color=C_LEVEL_ACTIVE, style=line.style_solid, width=1)
        if showLevelLbl
            pLb := label.new(bar_index-1, pOCR, " OCR " + str.tostring(pOCR, "#.##") + " ", color=color.new(#0F172A, 60), textcolor=C_LEVEL_ACTIVE, style=label.style_label_right, size=size.normal, tooltip="🟣 PDH One Candle — Bull\n─────────────────\nReclaim Level: " + str.tostring(pOCR, "#.##") + "\n\nEntry: Close above this level")

if pBS == 2 and not na(pLn)
    line.set_x2(pLn, bar_index+3)
    if not na(pGl)
        line.set_x2(pGl, bar_index+3)
if pBS == 2 and low < pDip
    pDip := low
if pBS == 2 and low <= pOCR
    pRet := true
    if not na(pLn)
        line.set_color(pLn, C_LEVEL_INVAL)
if pBS == 2 and showDipZone and pDip < pOCR
    box.delete(pZn)
    pZn := box.new(pBS0, pOCR, bar_index, pDip, border_color=color.new(C_PDH_BULL, 90), bgcolor=color.new(C_PDH_BULL, 90), border_width=0)

pRetOK = not useRetestFilter or pRet
pBullReclaim = enablePDHPDL and pBS == 2 and pCD == 0 and pSigN < maxSignals and close > pOCR and pRetOK and inSession and volPass and closeBullPass

if pBullReclaim
    pBS := 3, pCD := cooldownBars, pSigN += 1, hlPDBullRC := true
    if not na(pLn)
        line.set_color(pLn, color.new(C_PDH_BULL, 10)), line.set_x2(pLn, bar_index), line.set_width(pLn, 3)
    if not na(pZn)
        box.set_right(pZn, bar_index)
// ══════════════════════════════════════════════════════════════
// SETUP B — PDH/PDL: BEARISH (close below PDL → first green → reclaim)
// ══════════════════════════════════════════════════════════════
var int   qBS = 0
var float qOCR = na, var float qPeak = na, var float qDip = na
var int   qCD = 0, var int qSigN = 0
var bool  qRet = false
var line  qLn = na, var line qGl = na, var label qLb = na, var box qZn = na
var int   qBS0 = 0

if isSessionOpen
    if not na(qLn) and qBS != 3
        line.set_color(qLn, C_LEVEL_STALE), line.set_x2(qLn, bar_index)
    qBS := 0, qOCR := na, qPeak := na, qDip := na, qRet := false
    qCD := 0, qSigN := 0

if qCD > 0
    qCD -= 1

if enablePDHPDL and showBear and qBS == 0 and close < pdl and boQualityPass and inSession
    qBS := 1, qPeak := low
    if showBreakout
        label.new(bar_index, high, "⬇ PDL", color=color.new(C_PDH_BEAR, 80), textcolor=color.new(C_PDH_BEAR_BR, 0), style=label.style_label_down, size=size.normal, tooltip="🔴 PDL Bearish Breakdown\n─────────────────\nClose: " + str.tostring(close, "#.##") + " < PDL: " + str.tostring(pdl, "#.##") + "\n\nNow watching for pullback candle...")

if qBS == 1 and not isUpClose
    qPeak := math.min(qPeak, low)

if qBS == 1 and isUpClose and bodyPass(candleBody) and inSession
    qBS := 2, qOCR := low, qDip := high, qBS0 := bar_index, qRet := high >= qOCR  // does one-candle itself retest?
    hlPDBearOC := true
    if showLevel
        qGl := line.new(bar_index, qOCR, bar_index+1, qOCR, color=color.new(#0F172A, 40), style=line.style_solid, width=4)
        qLn := line.new(bar_index, qOCR, bar_index+1, qOCR, color=C_LEVEL_ACTIVE, style=line.style_solid, width=1)
        if showLevelLbl
            qLb := label.new(bar_index-1, qOCR, " OCR " + str.tostring(qOCR, "#.##") + " ", color=color.new(#0F172A, 60), textcolor=C_LEVEL_ACTIVE, style=label.style_label_right, size=size.normal, tooltip="🔴 PDL One Candle — Bear\n─────────────────\nReclaim Level: " + str.tostring(qOCR, "#.##") + "\n\nEntry: Close below this level")

if qBS == 2 and not na(qLn)
    line.set_x2(qLn, bar_index+3)
    if not na(qGl)
        line.set_x2(qGl, bar_index+3)
if qBS == 2 and high > qDip
    qDip := high
if qBS == 2 and high >= qOCR
    qRet := true
    if not na(qLn)
        line.set_color(qLn, C_LEVEL_INVAL)
if qBS == 2 and showDipZone and qDip > qOCR
    box.delete(qZn)
    qZn := box.new(qBS0, qDip, bar_index, qOCR, border_color=color.new(C_PDH_BEAR, 90), bgcolor=color.new(C_PDH_BEAR, 90), border_width=0)

qRetOK = not useRetestFilter or qRet
qBearReclaim = enablePDHPDL and showBear and qBS == 2 and qCD == 0 and qSigN < maxSignals and close < qOCR and qRetOK and inSession and volPass and closeBearPass

if qBearReclaim
    qBS := 3, qCD := cooldownBars, qSigN += 1, hlPDBearRC := true
    if not na(qLn)
        line.set_color(qLn, color.new(C_PDH_BEAR, 10)), line.set_x2(qLn, bar_index), line.set_width(qLn, 3)
    if not na(qZn)
        box.set_right(qZn, bar_index)
// ══════════════════════════════════════════════════════════════
// CANDLE HIGHLIGHTING & ENGULFING
// ══════════════════════════════════════════════════════════════
isOC  = hlBullOC or hlBearOC or hlPDBullOC or hlPDBearOC
isRC  = hlBullRC or hlBearRC or hlPDBullRC or hlPDBearRC
bullC = hlBullOC or hlBullRC or hlPDBullOC or hlPDBullRC

// Engulfing Detection
prevBear = close[1] < open[1]
prevBull = close[1] > open[1]
isBullEngulfing = prevBear and close > open and close > open[1] and open < close[1]
isBearEngulfing = prevBull and close < open and close < open[1] and open > close[1]

// Abnormal Volume Detection (1.5x average)
isHighVol = volume > (volMa * 1.5)
highVolBull = isHighVol and close > open
highVolBear = isHighVol and close < open

// Highlight Priority: Signal Reclaim > Signal OCR > Engulfing > High Volume > Normal
hlClr = highlightCandles and isRC and bullC ? C_BULL : highlightCandles and isRC and not bullC ? C_BEAR : highlightCandles and isOC and bullC ? color.new(C_BULL, 60) : highlightCandles and isOC and not bullC ? color.new(C_BEAR, 60) : isBullEngulfing ? color.new(#0000FF, 0) : isBearEngulfing ? color.new(#FFEB3B, 0) : highVolBull ? color.new(#14532D, 0) : highVolBear ? color.new(#7F1D1D, 0) : na

barcolor(hlClr, title="Candle Highlight")

// ══════════════════════════════════════════════════════════════
// SIGNAL VISUALS
// ══════════════════════════════════════════════════════════════
// OR signals
plotshape(aBullReclaim, title="OR Long", location=location.belowbar, color=C_BULL_BRIGHT, style=shape.circle, size=size.small)
plotshape(bBearReclaim, title="OR Short", location=location.abovebar, color=C_BEAR_BRIGHT, style=shape.circle, size=size.small)
// PDH/PDL signals
plotshape(pBullReclaim, title="PDH Long", location=location.belowbar, color=C_PDH_BULL, style=shape.circle, size=size.small)
plotshape(qBearReclaim, title="PDL Short", location=location.abovebar, color=C_PDH_BEAR, style=shape.circle, size=size.small)

if aBullReclaim
    string aBullRR = str.tostring(aPeak > aOCR and aOCR > aDip ? (aPeak - aOCR) / (aOCR - aDip) : 0, "#.#")
    label.new(bar_index, low, " ◆ LONG  " + str.tostring(aOCR, "#.##") + " ", color=color.new(C_BULL, 70), textcolor=C_BULL_BRIGHT, style=label.style_label_up, size=size.normal, tooltip="🟢 OR RECLAIM — LONG ENTRY\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nEntry: " + str.tostring(aOCR, "#.##") + "\nStop: " + str.tostring(aDip, "#.##") + "\nTarget: " + str.tostring(aPeak, "#.##") + "\nR:R = " + aBullRR + ":1\n\nPrice has reclaimed ABOVE the OCR level!\nThis confirms buyers have taken control.\n\nTrade Management:\n1. Enter at the close of this candle\n2. Stop-loss at " + str.tostring(aDip, "#.##") + " (pullback low)\n3. At TP1: close 70%, move stop to breakeven\n4. At TP2: trail the remaining 30%\n\nRisk per contract: " + str.tostring(aOCR - aDip, "#.##") + " points")
if bBearReclaim
    string bBearRR = str.tostring(bOCR > bPeak and bDip > bOCR ? (bOCR - bPeak) / (bDip - bOCR) : 0, "#.#")
    label.new(bar_index, high, " ◆ SHORT  " + str.tostring(bOCR, "#.##") + " ", color=color.new(C_BEAR, 70), textcolor=C_BEAR_BRIGHT, style=label.style_label_down, size=size.normal, tooltip="🔴 OR RECLAIM — SHORT ENTRY\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nEntry: " + str.tostring(bOCR, "#.##") + "\nStop: " + str.tostring(bDip, "#.##") + "\nTarget: " + str.tostring(bPeak, "#.##") + "\nR:R = " + bBearRR + ":1\n\nPrice has reclaimed BELOW the OCR level!\nThis confirms sellers have taken control.\n\nTrade Management:\n1. Enter at the close of this candle\n2. Stop-loss at " + str.tostring(bDip, "#.##") + " (pullback high)\n3. At TP1: close 70%, move stop to breakeven\n4. At TP2: trail the remaining 30%\n\nRisk per contract: " + str.tostring(bDip - bOCR, "#.##") + " points")
if pBullReclaim
    string pBullRR = str.tostring(pPeak > pOCR and pOCR > pDip ? (pPeak - pOCR) / (pOCR - pDip) : 0, "#.#")
    label.new(bar_index, low, " ◆ PDH LONG  " + str.tostring(pOCR, "#.##") + " ", color=color.new(C_PDH_BULL, 70), textcolor=color.new(C_PDH_BULL_BR, 0), style=label.style_label_up, size=size.normal, tooltip="🟣 PDH RECLAIM — LONG ENTRY\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nEntry: " + str.tostring(pOCR, "#.##") + "\nStop: " + str.tostring(pDip, "#.##") + "\nTarget: " + str.tostring(pPeak, "#.##") + "\nR:R = " + pBullRR + ":1\n\nPrice broke above Previous Day High, pulled\nback, and has now reclaimed the level.\nSame One Candle Rule logic at a daily level.\n\nThis is a higher-timeframe setup that adds\nconfluence if it aligns with the OR breakout.")
if qBearReclaim
    string qBearRR = str.tostring(qOCR > qPeak and qDip > qOCR ? (qOCR - qPeak) / (qDip - qOCR) : 0, "#.#")
    label.new(bar_index, high, " ◆ PDL SHORT  " + str.tostring(qOCR, "#.##") + " ", color=color.new(C_PDH_BEAR, 70), textcolor=color.new(C_PDH_BEAR_BR, 0), style=label.style_label_down, size=size.normal, tooltip="🔴 PDL RECLAIM — SHORT ENTRY\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nEntry: " + str.tostring(qOCR, "#.##") + "\nStop: " + str.tostring(qDip, "#.##") + "\nTarget: " + str.tostring(qPeak, "#.##") + "\nR:R = " + qBearRR + ":1\n\nPrice broke below Previous Day Low, pulled\nback, and has now reclaimed the level.\nSame One Candle Rule logic at a daily level.\n\nThis is a higher-timeframe setup that adds\nconfluence if it aligns with the OR breakdown.")

// ══════════════════════════════════════════════════════════════
// STATUS DASHBOARD
// ══════════════════════════════════════════════════════════════
if showDashboard and barstate.islast
    int rows = enablePDHPDL ? 8 : 6
    var table d = table.new(position.top_right, 2, rows, bgcolor=color.new(#0D1117, 10), border_color=color.new(#30363D, 20), border_width=1, frame_color=color.new(#30363D, 20), frame_width=1)

    table.cell(d, 0, 0, "OCR Dashboard", text_color=color.new(#8B949E, 0), text_size=size.normal, bgcolor=color.new(#161B22, 10), tooltip="One Candle Rule — all setups")
    table.cell(d, 1, 0, "", bgcolor=color.new(#161B22, 10))

    orStat = not orComplete ? "⏳ Building" : orOverextended ? "⚠️ Overextended" : "✅ Ready"
    orClr  = orOverextended ? C_LEVEL_INVAL : C_OR_TEXT
    table.cell(d, 0, 1, "OR", text_color=color.new(#8B949E, 10), text_size=size.normal, tooltip="OR: H " + str.tostring(orHigh, "#.##") + " L " + str.tostring(orLow, "#.##") + " | " + str.tostring(orHigh - orLow, "#.##") + " range")
    table.cell(d, 1, 1, orStat, text_color=orClr, text_size=size.normal)

    aTxt = aBS == 0 ? "—" : aBS == 1 ? "🔍 Pullback" : aBS == 2 ? (aRet ? "⏳ Reclaim" : "⏳ Retest") : "✅ (" + str.tostring(aSigN) + ")"
    table.cell(d, 0, 2, "OR Bull", text_color=color.new(#8B949E, 10), text_size=size.normal)
    table.cell(d, 1, 2, aTxt, text_color=aBS == 3 ? C_BULL : aBS == 2 ? C_LEVEL_INVAL : color.new(#8B949E, 10), text_size=size.normal)

    bTxt = bBS == 0 ? "—" : bBS == 1 ? "🔍 Pullback" : bBS == 2 ? (bRet ? "⏳ Reclaim" : "⏳ Retest") : "✅ (" + str.tostring(bSigN) + ")"
    table.cell(d, 0, 3, "OR Bear", text_color=color.new(#8B949E, 10), text_size=size.normal)
    table.cell(d, 1, 3, bTxt, text_color=bBS == 3 ? C_BEAR : bBS == 2 ? C_LEVEL_INVAL : color.new(#8B949E, 10), text_size=size.normal)

    sesTxt = inSession and useTimeFilter ? "🟢 Active" : useTimeFilter ? "⚫ Closed" : "🔵 On"
    table.cell(d, 0, 4, "Session", text_color=color.new(#8B949E, 10), text_size=size.normal)
    table.cell(d, 1, 4, sesTxt, text_color=inSession ? color.new(#66BB6A, 10) : color.new(#78909C, 20), text_size=size.normal)

    retTxt = useRetestFilter ? "🟢 On" : "⚪ Off"
    table.cell(d, 0, 5, "Retest", text_color=color.new(#8B949E, 10), text_size=size.normal)
    table.cell(d, 1, 5, retTxt, text_color=useRetestFilter ? color.new(#66BB6A, 10) : color.new(#78909C, 20), text_size=size.normal)

    if enablePDHPDL
        pTxt = pBS == 0 ? "—" : pBS == 1 ? "🔍 Pullback" : pBS == 2 ? (pRet ? "⏳ Reclaim" : "⏳ Retest") : "✅ (" + str.tostring(pSigN) + ")"
        table.cell(d, 0, 6, "PDH Bull", text_color=color.new(#8B949E, 10), text_size=size.normal)
        table.cell(d, 1, 6, pTxt, text_color=pBS == 3 ? color.new(C_PDH_BULL, 10) : pBS == 2 ? C_LEVEL_INVAL : color.new(#8B949E, 10), text_size=size.normal)

        qTxt = qBS == 0 ? "—" : qBS == 1 ? "🔍 Pullback" : qBS == 2 ? (qRet ? "⏳ Reclaim" : "⏳ Retest") : "✅ (" + str.tostring(qSigN) + ")"
        table.cell(d, 0, 7, "PDL Bear", text_color=color.new(#8B949E, 10), text_size=size.normal)
        table.cell(d, 1, 7, qTxt, text_color=qBS == 3 ? color.new(C_PDH_BEAR, 10) : qBS == 2 ? C_LEVEL_INVAL : color.new(#8B949E, 10), text_size=size.normal)

// ══════════════════════════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════════════════════════
alertcondition(aBullReclaim, title="OR Bull Reclaim", message="🟢 OR One Candle Reclaim — LONG!")
alertcondition(bBearReclaim, title="OR Bear Reclaim", message="🔴 OR One Candle Reclaim — SHORT!")
alertcondition(pBullReclaim, title="PDH Bull Reclaim", message="🟣 PDH One Candle Reclaim — LONG!")
alertcondition(qBearReclaim, title="PDL Bear Reclaim", message="🔴 PDL One Candle Reclaim — SHORT!")
