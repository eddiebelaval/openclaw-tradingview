//@version=6
indicator('EMA clouds. JB style', overlay = true)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
show_table  = input(true, title = 'Show Table')
show_clouds = input(true, title = 'Show Clouds')
day_trading = input(false, title = 'Day Trading')
level_num = input.int(3, title = 'Num of Levels', minval = 1, display = display.none)

neighbor_sweeps = input(true, title = 'Show Bull Sweeps')
bull_levels = input(true, title = 'Show Bull Levels')
ns_bear = input(true, title = 'Show Bear Sweeps')
bear_levels = input(true, title = 'Show Bear Levels')

// Candle signal highlights — single toggle enables all pattern layers:
//   Yellow = bullish engulfing sweep
//   Purple = sweep + engulfing (highest conviction, always wins)
signal_candles = input(true, title = 'Highlight Signal Candles')
just_engulfing = signal_candles

// Integer inputs for fast and slow time frames
fast_time = input.int(defval = 5, title = 'Fast Cloud || Minute TF', display = display.none)
slow_time = input.int(defval = 10, title = 'Slow Cloud || Minute TF', display = display.none)

// [U1] EMA lengths — previously hardcoded, now user-configurable
fast_ema1 = input.int(5, title = 'Fast EMA 1', group = 'EMA Lengths', display = display.none)
fast_ema2 = input.int(12, title = 'Fast EMA 2', group = 'EMA Lengths', display = display.none)
med_ema1 = input.int(34, title = 'Medium EMA 1', group = 'EMA Lengths', display = display.none)
med_ema2 = input.int(50, title = 'Medium EMA 2', group = 'EMA Lengths', display = display.none)
slow_ema1 = input.int(72, title = 'Slow EMA 1', group = 'EMA Lengths', display = display.none)
slow_ema2 = input.int(89, title = 'Slow EMA 2', group = 'EMA Lengths', display = display.none)

// ─────────────────────────────────────────────
// SWEEP TRIGGERS
// ─────────────────────────────────────────────
atr14 = ta.atr(14)

// ATR depth filter — minimum 0.1x ATR sweep depth, filters out micro-sweeps
// Bear trigger requires low < high[1] — matching the structural logic of the bull trigger
bull_trigger = low < low[1] and low[1] - low >= 0.1 * atr14 and high > low[1] and close > low[1]
bear_trigger = high > high[1] and high - high[1] >= 0.1 * atr14 and low < high[1] and close < high[1]

bull_engulf_trigger = close[1] > open[1] and close > open ? close > close[1] and open < open[1] : close > open ? close > open[1] and open < close[1] : false

bull_engulf_color = #f1ff33 // yellow  — engulfing only
bull_sweep_engulf_color = color.rgb(210, 130, 255) // purple  — sweep AND engulfing (highest conviction)

// ─────────────────────────────────────────────
// TIME FRAMES
// ─────────────────────────────────────────────
fast_tf = day_trading ? str.tostring(fast_time) : 'D'
slow_tf = day_trading ? str.tostring(slow_time) : 'W'

// ─────────────────────────────────────────────
// SOURCE
// ─────────────────────────────────────────────
src = close

// ─────────────────────────────────────────────
// HTF EMAs — Daily (fast_tf)
// ─────────────────────────────────────────────
htf_daily_ema1 = request.security(syminfo.tickerid, fast_tf, ta.ema(src, fast_ema1))
htf_daily_ema2 = request.security(syminfo.tickerid, fast_tf, ta.ema(src, fast_ema2))
htf_daily_ema3 = request.security(syminfo.tickerid, fast_tf, ta.ema(src, med_ema1))
htf_daily_ema4 = request.security(syminfo.tickerid, fast_tf, ta.ema(src, med_ema2))
htf_daily_ema5 = request.security(syminfo.tickerid, fast_tf, ta.ema(src, slow_ema1))
htf_daily_ema6 = request.security(syminfo.tickerid, fast_tf, ta.ema(src, slow_ema2))

// ─────────────────────────────────────────────
// HTF EMAs — Weekly (slow_tf)
// ─────────────────────────────────────────────
htf_weekly_ema1 = request.security(syminfo.tickerid, slow_tf, ta.ema(src, fast_ema1))
htf_weekly_ema2 = request.security(syminfo.tickerid, slow_tf, ta.ema(src, fast_ema2))
htf_weekly_ema3 = request.security(syminfo.tickerid, slow_tf, ta.ema(src, med_ema1))
htf_weekly_ema4 = request.security(syminfo.tickerid, slow_tf, ta.ema(src, med_ema2))
htf_weekly_ema5 = request.security(syminfo.tickerid, slow_tf, ta.ema(src, slow_ema1))
htf_weekly_ema6 = request.security(syminfo.tickerid, slow_tf, ta.ema(src, slow_ema2))

// ─────────────────────────────────────────────
// CLOUD COLORS
// ─────────────────────────────────────────────
cloud_colour_daily_fast = htf_daily_ema1 >= htf_daily_ema2 ? color.new(color.green, 0) : color.new(color.red, 0)
cloud_colour_daily_med = na(htf_daily_ema3) ? color.new(color.gray, 0) : htf_daily_ema3 >= htf_daily_ema4 ? color.new(color.green, 0) : color.new(color.red, 0)
cloud_colour_daily_slow = na(htf_daily_ema5) ? color.new(color.gray, 0) : htf_daily_ema5 >= htf_daily_ema6 ? color.new(color.green, 0) : color.new(color.red, 0)

cloud_colour_weekly_fast = htf_weekly_ema1 >= htf_weekly_ema2 ? color.new(color.green, 0) : color.new(color.red, 0)
cloud_colour_weekly_med = na(htf_weekly_ema3) ? color.new(color.gray, 0) : htf_weekly_ema3 >= htf_weekly_ema4 ? color.new(color.green, 0) : color.new(color.red, 0)
cloud_colour_weekly_slow = na(htf_weekly_ema5) ? color.new(color.gray, 0) : htf_weekly_ema5 >= htf_weekly_ema6 ? color.new(color.green, 0) : color.new(color.red, 0)

// ─────────────────────────────────────────────
// TREND STATE
// ─────────────────────────────────────────────
daily_all_bullish = htf_daily_ema1 >= htf_daily_ema2 and htf_daily_ema3 >= htf_daily_ema4 and htf_daily_ema5 >= htf_daily_ema6
weekly_all_bullish = htf_weekly_ema1 >= htf_weekly_ema2 and htf_weekly_ema3 >= htf_weekly_ema4 and htf_weekly_ema5 >= htf_weekly_ema6
weekly_all_bearish = htf_weekly_ema1 < htf_weekly_ema2 and htf_weekly_ema3 < htf_weekly_ema4 and htf_weekly_ema5 < htf_weekly_ema6

// [S1] Trend gate — automatically references the next-higher TF's fast cloud:
//   Intraday  → daily fast cloud  (EMA5 vs EMA12 on daily)
//   Daily     → weekly fast cloud (EMA5 vs EMA12 on weekly)
//   Weekly+   → no filter         (already at the top reference TF)
trend_ref_bull = timeframe.isweekly or timeframe.ismonthly ? true : timeframe.isdaily ? htf_weekly_ema1 >= htf_weekly_ema2 : htf_daily_ema1 >= htf_daily_ema2
trend_ref_bear = timeframe.isweekly or timeframe.ismonthly ? true : timeframe.isdaily ? htf_weekly_ema1 < htf_weekly_ema2 : htf_daily_ema1 < htf_daily_ema2

bull_trend_ok = trend_ref_bull
bear_trend_ok = trend_ref_bear

weekly_rsi = math.round(request.security(syminfo.tickerid, slow_tf, ta.rsi(close, 14)))
daily_rsi = math.round(request.security(syminfo.tickerid, fast_tf, ta.rsi(close, 14)))

// ─────────────────────────────────────────────
// HV RANK — IV proxy, computed on daily bars
//   HV20 = 20-day historical vol, annualized
//   Rank  = percentile vs trailing 252-day window (≈ 1 year)
//   ↑ / ↓  = HV10 vs HV20 — vol expanding or contracting
// ─────────────────────────────────────────────
f_hv() =>
    log_ret = math.log(close / close[1])
    hv20 = ta.stdev(log_ret, 20) * math.sqrt(252) * 100
    hv10 = ta.stdev(log_ret, 10) * math.sqrt(252) * 100
    lo = ta.lowest(hv20, 252)
    hi = ta.highest(hv20, 252)
    rank = hi != lo ? (hv20 - lo) / (hi - lo) * 100 : 50.0
    [math.round(rank), hv10 > hv20]

[hv_rank, hv_expanding] = request.security(syminfo.tickerid, 'D', f_hv())

// ─────────────────────────────────────────────
// BAR COLORS & SWEEP SHAPES
// ─────────────────────────────────────────────
barcolor(just_engulfing and bull_engulf_trigger ? bull_engulf_color : na, title = 'Bullish Engulfing') // yellow — engulfing sweep
barcolor(just_engulfing and bull_engulf_trigger and bull_trigger ? bull_sweep_engulf_color : na, title = 'Sweep + Engulfing') // purple — always wins, highest conviction

plotshape(series = neighbor_sweeps and bull_trigger and bull_trend_ok ? low : na, style = shape.triangleup, color = color.rgb(68, 141, 0), location = location.absolute, title = 'Bull Sweep')
plotshape(series = ns_bear and bear_trigger and bear_trend_ok ? high : na, style = shape.triangledown, color = color.red, location = location.absolute, title = 'Bear Sweep')


// ─────────────────────────────────────────────
// TABLE STATE VARIABLES
// ─────────────────────────────────────────────
var string blend_csp = ''
var string blend_stock = ''
var string gameplan_text = ''
var string gameplan_text1 = ''
var string gameplan_text2 = ''
var string gameplan_text3 = ''
var string gameplan_text4 = ''
var string rsi_text = ''
bool position_guidance = false

var pnlTable = table.new(position = position.top_right, columns = 3, rows = 8, border_color = color.white, border_width = 1)

fast_tf_text = day_trading ? '5 Min' : 'Daily'
slow_tf_text = day_trading ? '10 Min' : 'Weekly'

// [U2] Only fetch ADD when in day trading mode — avoids wasted request on swing/crypto charts
ADD = day_trading ? request.security('ADD', '1', close) : na

yesterdayHigh = request.security(syminfo.tickerid, 'D', high[1])
yesterdayLow = request.security(syminfo.tickerid, 'D', low[1])
isInsideRange = close <= yesterdayHigh and close >= yesterdayLow
rangeStatus = isInsideRange ? 'IN' : 'OUT'

// ─────────────────────────────────────────────
// RSI CELL COLORS — four tiers, matches HV Rank palette
//   < 30  daily  / < 35  weekly → purple (oversold — ideal CSP entry)
//   30–55 daily  / 35–60 weekly → green  (neutral — OK)
//   55–70 daily  / 60–75 weekly → orange (elevated — verify)
//   > 70  daily  / > 75  weekly → red    (overbought — avoid)
// ─────────────────────────────────────────────
rsi_purple = color.rgb(210, 130, 255)

daily_rsi_col = daily_rsi < 30 ? rsi_purple : daily_rsi < 55 ? color.green : daily_rsi < 70 ? color.orange : color.red
weekly_rsi_col = weekly_rsi < 35 ? rsi_purple : weekly_rsi < 60 ? color.green : weekly_rsi < 75 ? color.orange : color.red

// ─────────────────────────────────────────────
// HV RANK CELL COLORS
//   < 30  → WAIT   (red)    — compressed, premium too cheap to sell
//   30–55 → OK     (green)  — average, be selective
//   55–75 → GREAT  (purple) — sweet spot, ideal CSP environment
//   > 75  → VERIFY (orange) — extreme, check why before entering
// ─────────────────────────────────────────────
hv_circle_col = hv_rank < 30 ? color.red : hv_rank < 55 ? color.green : hv_rank < 75 ? rsi_purple : color.orange
hv_label = hv_rank < 30 ? 'WAIT' : hv_rank < 55 ? 'OK' : hv_rank < 75 ? 'GREAT' : 'VERIFY'
hv_dir_arrow = hv_expanding ? '↑' : '↓'

// ─────────────────────────────────────────────
// TABLE RENDERING
// ─────────────────────────────────────────────
_lbl_col = font.family_monospace
_lbl_sz  = size.small

if show_table
    table.cell(pnlTable, 1, 0, text = fast_tf_text, text_color = color.white, bgcolor = color.black, text_size = _lbl_sz, text_font_family = _lbl_col)
    table.cell(pnlTable, 2, 0, text = slow_tf_text, text_color = color.white, bgcolor = color.black, text_size = _lbl_sz, text_font_family = _lbl_col)
    table.cell(pnlTable, 0, 1, text = 'Fast',    text_color = color.white, bgcolor = color.black, text_size = _lbl_sz, text_font_family = _lbl_col)
    table.cell(pnlTable, 0, 2, text = 'Medium',  text_color = color.white, bgcolor = color.black, text_size = _lbl_sz, text_font_family = _lbl_col)
    table.cell(pnlTable, 0, 3, text = 'Slow',    text_color = color.white, bgcolor = color.black, text_size = _lbl_sz, text_font_family = _lbl_col)
    table.cell(pnlTable, 0, 4, text = 'RSI',     text_color = color.white, bgcolor = color.black, text_size = _lbl_sz, text_font_family = _lbl_col)
    table.cell(pnlTable, 1, 1, text = '', bgcolor = cloud_colour_daily_fast,  text_size = _lbl_sz)
    table.cell(pnlTable, 1, 2, text = '', bgcolor = cloud_colour_daily_med,   text_size = _lbl_sz)
    table.cell(pnlTable, 1, 3, text = '', bgcolor = cloud_colour_daily_slow,  text_size = _lbl_sz)
    table.cell(pnlTable, 1, 4, text = str.tostring(daily_rsi),  text_color = daily_rsi_col,  bgcolor = color.black, text_size = _lbl_sz, text_font_family = _lbl_col)
    table.cell(pnlTable, 2, 1, text = '', bgcolor = cloud_colour_weekly_fast, text_size = _lbl_sz)
    table.cell(pnlTable, 2, 2, text = '', bgcolor = cloud_colour_weekly_med,  text_size = _lbl_sz)
    table.cell(pnlTable, 2, 3, text = '', bgcolor = cloud_colour_weekly_slow, text_size = _lbl_sz)
    table.cell(pnlTable, 2, 4, text = str.tostring(weekly_rsi), text_color = weekly_rsi_col, bgcolor = color.black, text_size = _lbl_sz, text_font_family = _lbl_col)
    table.cell(pnlTable, 0, 5, text = 'HV Rank', text_color = color.white, bgcolor = color.black, text_size = _lbl_sz, text_font_family = _lbl_col)
    table.merge_cells(pnlTable, 1, 5, 2, 5)
    table.cell(pnlTable, 1, 5, text = str.tostring(hv_rank) + ' ' + hv_dir_arrow + ' ● ' + hv_label, text_color = hv_circle_col, bgcolor = color.black, text_halign = text.align_center, text_size = _lbl_sz, text_font_family = _lbl_col)

if day_trading and show_table
    table.cell(pnlTable, 0, 6, text = 'ADD',    text_color = color.white,  bgcolor = color.black, text_size = _lbl_sz, text_font_family = _lbl_col)
    table.cell(pnlTable, 1, 6, text = str.tostring(ADD),         text_color = color.yellow, bgcolor = color.black, text_size = _lbl_sz, text_font_family = _lbl_col)
    table.cell(pnlTable, 0, 7, text = 'In/Out', text_color = color.white,  bgcolor = color.black, text_size = _lbl_sz, text_font_family = _lbl_col)
    table.cell(pnlTable, 1, 7, text = str.tostring(rangeStatus), text_color = color.yellow, bgcolor = color.black, text_size = _lbl_sz, text_font_family = _lbl_col)

// ─────────────────────────────────────────────
// CURRENT TIMEFRAME EMAs
// ─────────────────────────────────────────────
emaOffset = 0

f_ema(malen) =>
    ta.ema(src, malen)

emaFast1 = f_ema(fast_ema1)
emaFast2 = f_ema(fast_ema2)
emaMid1 = f_ema(med_ema1)
emaMid2 = f_ema(med_ema2)
emaSlow1 = f_ema(slow_ema1)
emaSlow2 = f_ema(slow_ema2)

emaShort_fast = emaFast1
emaLong_fast = emaFast2
emaShort_mid = emaMid1
emaLong_mid = emaMid2
emaShort_slow = emaSlow1
emaLong_slow = emaSlow2

cloud_transp = 85
transparencyLevel = 90

fastCloudColor = emaShort_fast >= emaLong_fast ? color.new(color.rgb(103, 253, 103), cloud_transp) : color.new(color.rgb(255, 86, 81), cloud_transp)
midCloudColor = emaShort_mid >= emaLong_mid ? color.new(color.rgb(68, 255, 114), cloud_transp) : color.new(#ff3f3f, cloud_transp)
slowCloudColor = emaShort_slow >= emaLong_slow ? color.new(#20c02d, cloud_transp) : color.new(#ff1d1d, cloud_transp)

emaShortColor_fast = emaShort_fast >= emaShort_fast[1] ? color.new(color.teal, transparencyLevel) : color.new(color.red, transparencyLevel)
emaShortColor_mid = emaShort_mid >= emaShort_mid[1] ? color.new(color.teal, transparencyLevel) : color.new(color.red, transparencyLevel)
emaShortColor_slow = emaShort_slow >= emaShort_slow[1] ? color.new(color.teal, transparencyLevel) : color.new(color.red, transparencyLevel)

emaLongColor_fast = emaLong_fast >= emaLong_fast[1] ? color.new(color.green, transparencyLevel) : color.new(color.orange, transparencyLevel)
emaLongColor_mid = emaLong_mid >= emaLong_mid[1] ? color.new(color.green, transparencyLevel) : color.new(color.orange, transparencyLevel)
emaLongColor_slow = emaLong_slow >= emaLong_slow[1] ? color.new(color.green, transparencyLevel) : color.new(color.orange, transparencyLevel)

_ema_display = display.none

shortEmaLine_fast = plot(show_clouds ? emaShort_fast : na, color = emaShortColor_fast, linewidth = 1, offset = emaOffset, title = 'Fast EMA Short', display = _ema_display)
shortEmaLine_mid = plot(show_clouds ? emaShort_mid : na, color = emaShortColor_mid, linewidth = 1, offset = emaOffset, title = 'Medium EMA Short', display = _ema_display)
shortEmaLine_slow = plot(show_clouds ? emaShort_slow : na, color = emaShortColor_slow, linewidth = 1, offset = emaOffset, title = 'Slow EMA Short', display = _ema_display)

longEmaLine_fast = plot(show_clouds ? emaLong_fast : na, color = emaLongColor_fast, linewidth = 1, offset = emaOffset, title = 'Fast EMA Long', display = _ema_display)
longEmaLine_mid = plot(show_clouds ? emaLong_mid : na, color = emaLongColor_mid, linewidth = 1, offset = emaOffset, title = 'Medium EMA Long', display = _ema_display)
longEmaLine_slow = plot(show_clouds ? emaLong_slow : na, color = emaLongColor_slow, linewidth = 1, offset = emaOffset, title = 'Slow EMA Long', display = _ema_display)

fill(shortEmaLine_fast, longEmaLine_fast, color = color.new(fastCloudColor, show_clouds ? cloud_transp : 100), title = 'Fast EMA Cloud')
fill(shortEmaLine_mid, longEmaLine_mid, color = color.new(midCloudColor, show_clouds ? cloud_transp : 100), title = 'Medium EMA Cloud')
fill(shortEmaLine_slow, longEmaLine_slow, color = color.new(slowCloudColor, show_clouds ? cloud_transp : 100), title = 'Slow EMA Cloud')

// ─────────────────────────────────────────────
// LEVEL BOX CONTROL
// ─────────────────────────────────────────────
// [B2] Fixed duplicate condition — second branch now correctly detects a clean break
//      above the zone (both high and low above midpoint), which the original never caught.
//      Also removed the meaningless `if na or` that preceded the extend logic.
_control_Box(_boxes, _high, _low) =>
    if array.size(_boxes) > 0
        for i = array.size(_boxes) - 1 to 0 by 1
            _box = array.get(_boxes, i)
            _boxLow = box.get_bottom(_box)
            _boxHigh = box.get_top(_box)
            _boxRight = box.get_right(_box)
            mid_ = (_boxLow + _boxHigh) / 2
            // Extend right edge while level has not been invalidated
            if bar_index == _boxRight and not(_high > mid_ and _low < mid_ or _high > _boxHigh and _low > mid_)
                box.set_right(_box, bar_index + 1)
            // Delete on: (1) candle straddles midpoint  OR  (2) candle closes fully above zone
            if _high > mid_ and _low < mid_ or _high > _boxHigh and _low > mid_
                box.delete(_box)

bull = bull_levels and bull_trigger
bear = bear_levels and bear_trigger

var array<box> _bearBoxesFVG = array.new_box()
var array<box> _bullBoxesFVG = array.new_box()

level_transparency = 50
fvgBullCol = color.new(color.green, level_transparency)
fvgBearCol = color.new(color.red, level_transparency)
fvgLabelCol = color.gray
fvgLabelSize = size.tiny
fvgBoxBorder = line.style_solid

// [B1] Bull box: top = prior low (the swept level), bottom = sweep low (the actual wick)
//      This creates a real zone instead of a zero-height invisible line.
if bull
    if array.size(_bullBoxesFVG) > level_num
        box.delete(array.shift(_bullBoxesFVG))
    _bullboxFVG = box.new(left = bar_index, top = low[1], right = bar_index + 1, bottom = low, bgcolor = fvgBullCol, border_color = fvgBullCol, border_style = fvgBoxBorder, border_width = 1, text = '', text_halign = text.align_right, text_valign = text.align_bottom, text_size = fvgLabelSize, text_color = fvgLabelCol)
    array.push(_bullBoxesFVG, _bullboxFVG)

// [B1] Bear box: top = sweep high (the actual wick), bottom = prior high (the swept level)
if bear
    if array.size(_bearBoxesFVG) > level_num
        box.delete(array.shift(_bearBoxesFVG))
    _bearboxFVG = box.new(left = bar_index, top = high, right = bar_index + 1, bottom = high[1], bgcolor = fvgBearCol, border_color = fvgBearCol, border_style = fvgBoxBorder, border_width = 1, text = '', text_halign = text.align_right, text_valign = text.align_bottom, text_size = fvgLabelSize, text_color = fvgLabelCol)
    array.push(_bearBoxesFVG, _bearboxFVG)

if bear_levels
    _control_Box(_bearBoxesFVG, high, low)
if bull_levels
    _control_Box(_bullBoxesFVG, high, low)
