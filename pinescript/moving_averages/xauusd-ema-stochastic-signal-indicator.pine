//@version=6
indicator("XAUUSD EMA + Stochastic Signal Indicator", overlay=true, max_lines_count=500, max_labels_count=500)

//==================================================
// INPUTS
//==================================================
emaFastLen      = input.int(50,  "EMA Fast Length", minval=1)
emaSlowLen      = input.int(200, "EMA Slow Length", minval=1)

stochLen        = input.int(14, "Stochastic Length", minval=1)
smoothK         = input.int(3,  "Stochastic %K Smoothing", minval=1)
smoothD         = input.int(3,  "Stochastic %D Smoothing", minval=1)

swingLeft       = input.int(3, "Swing Pivot Left Bars", minval=1)
swingRight      = input.int(3, "Swing Pivot Right Bars", minval=1)
stopBufferTicks = input.int(20, "Stop Buffer (ticks)", minval=1)

rrMultiple      = input.float(1.5, "Risk:Reward Multiple", minval=0.1, step=0.1)

showBackground  = input.bool(true, "Show Trend Background")
showSLTP        = input.bool(true, "Show Stop and Target Lines")
showLabels      = input.bool(true, "Show Signal Labels")

//==================================================
// CORE CALCULATIONS
//==================================================
ema50  = ta.ema(close, emaFastLen)
ema200 = ta.ema(close, emaSlowLen)

rawStoch = ta.stoch(close, high, low, stochLen)
k = ta.sma(rawStoch, smoothK)
d = ta.sma(k, smoothD)

//==================================================
// TREND LOGIC
//==================================================
bullTrend = close > ema50 and close > ema200
bearTrend = close < ema50 and close < ema200
neutral   = not bullTrend and not bearTrend

//==================================================
// STOCHASTIC TRIGGERS
//==================================================
buyTrigger  = ta.crossover(k, 20)
sellTrigger = ta.crossunder(k, 80)

buySignal   = bullTrend and buyTrigger
sellSignal  = bearTrend and sellTrigger

//==================================================
// SWING LOGIC
//==================================================
pivotLow  = ta.pivotlow(low, swingLeft, swingRight)
pivotHigh = ta.pivothigh(high, swingLeft, swingRight)

var float lastSwingLow  = na
var float lastSwingHigh = na

if not na(pivotLow)
    lastSwingLow := pivotLow

if not na(pivotHigh)
    lastSwingHigh := pivotHigh

buffer = stopBufferTicks * syminfo.mintick

longSL  = na(lastSwingLow)  ? na : lastSwingLow - buffer
shortSL = na(lastSwingHigh) ? na : lastSwingHigh + buffer

longRisk  = na(longSL)  ? na : close - longSL
shortRisk = na(shortSL) ? na : shortSL - close

validBuy  = buySignal and not na(longSL) and longRisk > 0
validSell = sellSignal and not na(shortSL) and shortRisk > 0

longTP  = validBuy  ? close + (longRisk * rrMultiple)   : na
shortTP = validSell ? close - (shortRisk * rrMultiple)  : na

//==================================================
// PLOTS
//==================================================
plot(ema50,  "EMA 50",  color=color.orange, linewidth=2)
plot(ema200, "EMA 200", color=color.blue, linewidth=2)

bgcolor(
     showBackground
     ? bullTrend ? color.new(color.green, 90)
     : bearTrend ? color.new(color.red, 90)
     : color.new(color.gray, 93)
     : na
)

//==================================================
// SIGNAL MARKERS
//==================================================
plotshape(validBuy,  title="Buy Signal",  style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.small, text="BUY")
plotshape(validSell, title="Sell Signal", style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.small, text="SELL")

//==================================================
// SIGNAL LABELS
//==================================================
if showLabels and validBuy
    label.new(
         bar_index, low,
         "BUY\nEntry: " + str.tostring(close, format.mintick) +
         "\nSL: " + str.tostring(longSL, format.mintick) +
         "\nTP: " + str.tostring(longTP, format.mintick),
         style=label.style_label_up,
         color=color.new(color.lime, 0),
         textcolor=color.black
     )

if showLabels and validSell
    label.new(
         bar_index, high,
         "SELL\nEntry: " + str.tostring(close, format.mintick) +
         "\nSL: " + str.tostring(shortSL, format.mintick) +
         "\nTP: " + str.tostring(shortTP, format.mintick),
         style=label.style_label_down,
         color=color.new(color.red, 0),
         textcolor=color.white
     )

//==================================================
// STOP / TARGET LINES
//==================================================
var line activeSL = na
var line activeTP = na

if showSLTP and validBuy
    if not na(activeSL)
        line.delete(activeSL)
    if not na(activeTP)
        line.delete(activeTP)

    activeSL := line.new(bar_index, longSL, bar_index + 20, longSL, extend=extend.none, color=color.red, width=2)
    activeTP := line.new(bar_index, longTP, bar_index + 20, longTP, extend=extend.none, color=color.green, width=2)

if showSLTP and validSell
    if not na(activeSL)
        line.delete(activeSL)
    if not na(activeTP)
        line.delete(activeTP)

    activeSL := line.new(bar_index, shortSL, bar_index + 20, shortSL, extend=extend.none, color=color.red, width=2)
    activeTP := line.new(bar_index, shortTP, bar_index + 20, shortTP, extend=extend.none, color=color.green, width=2)

//==================================================
// OPTIONAL SWING VISUALS
//==================================================
plot(lastSwingLow,  "Last Swing Low",  color=color.new(color.green, 75), style=plot.style_circles)
plot(lastSwingHigh, "Last Swing High", color=color.new(color.red, 75),   style=plot.style_circles)

//==================================================
// ALERTS
//==================================================
alertcondition(validBuy,  title="Buy Setup",  message="BUY setup on {{ticker}} {{interval}}")
alertcondition(validSell, title="Sell Setup", message="SELL setup on {{ticker}} {{interval}}")
