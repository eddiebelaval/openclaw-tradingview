//@version=6
indicator('Support Band of Trend', overlay = true)

// ══════════════════════════════════════════════════════════════════
// ── Settings ──────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

showBands       = input.bool(true, 'Show Support Band🟢🔴',          tooltip = 'The inner core band (SMA 20 / EMA 21). Green = bull support zone, Red = bear resistance zone.', group = 'Display')
showTKBand      = input.bool(true, 'Show Tenkan/Kijun Band🟢🔴',     tooltip = 'Filled zone between Tenkan-Sen and Kijun-Sen. Acts as the outer dynamic boundary. Green = bull, Red = bear.', group = 'Display')
showTenkan      = input.bool(true, 'Show Tenkan-Sen Line🟢',       tooltip = 'Fast Ichimoku line (dynamic 9-30 period). Reacts quickly to price. Color flips teal/purple based on its position relative to Kijun.', group = 'Display')
showKijun       = input.bool(true, 'Show Kijun-Sen Line🔴',        tooltip = 'Slow Ichimoku line (dynamic 20-60 period). Acts as the baseline. Color matches Tenkan — both flip together on crossover.', group = 'Display')
showPricePivots = input.bool(false, 'Show Price Pivot S/R Lines 🛡️', tooltip = 'Draws the last 3 pivot highs (red dashed) and pivot lows (green dashed) as horizontal S/R levels.', group = 'Display')
showTrendMa     = input.bool(true, 'Show 200 SMA',               tooltip = 'The 200-period Simple Moving Average. Used internally for trend bias and displayed as a blue reference line.', group = 'Display')

// ══════════════════════════════════════════════════════════════════
// ── Hardcoded Calculation Constants ───────────────────────────────
// ══════════════════════════════════════════════════════════════════

int    leftBars     = 5
int    rightBars    = 5
int    trendMaLen   = 200
int    adxLen       = 14
int    adxSmooth    = 14
int    adxThresh    = 20
int    tkminlen     = 9
int    tkmaxlen     = 30
float  tkdynperc    = 96.85 / 100.0
int    kjminlen     = 20
int    kjmaxlen     = 60
float  kjdynperc    = 96.85 / 100.0
int    kjdivider    = 1
int    chfiltper    = 25
int    chminlen     = 26
int    chmaxlen     = 50
float  chdynperc    = 96.85 / 100.0
int    rvolumelen   = 14
int    volpeak      = 50
int    emalen1      = 8
int    emalen2      = 21
int    volfastlen   = 34
int    volslowlen   = 55
int    volzonelen   = 21
int    atrfastlen   = 14
int    atrslowlen   = 46

// ══════════════════════════════════════════════════════════════════
// ── Source ────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

f_openha() =>
    haopen  = float(na)
    haopen := na(haopen[1]) ? (open + close) / 2 : (nz(haopen[1]) + nz(close[1])) / 2
    haopen

haopen    = f_openha()
haclose   = ohlc4
haboolean = f_openha()

altsrcres = ta.swma(close > open ? high : low)

// ══════════════════════════════════════════════════════════════════
// ── Volume Oscillator (OBV default) ───────────────────────────────
// ══════════════════════════════════════════════════════════════════

tksignal = ta.cum(math.sign(ta.change(haclose)) * volume)
kjsignal = tksignal
chsignal = tksignal

tkbrvolup = tksignal > tksignal[volpeak]
kjbrvolup = kjsignal > kjsignal[volpeak]
chbrvolup = chsignal > chsignal[volpeak]

// ══════════════════════════════════════════════════════════════════
// ── Volatility ────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

atrvolmeter = ta.atr(atrfastlen) > ta.atr(atrslowlen)

// ══════════════════════════════════════════════════════════════════
// ── Chikou Filter ─────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

f_chikou(float src, simple int len, float _high, float _low) =>
    isup   = src > ta.highest(_high, len)[len]
    isdown = src < ta.lowest(_low,   len)[len]
    isup ? 1 : isdown ? -1 : 0

chikoufiltersig = f_chikou(altsrcres, chfiltper, high, low)

// ══════════════════════════════════════════════════════════════════
// ── Boolean Array Helper ──────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

f_boolean(bool[] chka, bool[] reference_a) =>
    var result_bool = bool(na)
    for i = 0 to array.size(chka) - 1
        if array.get(chka, i) == true
            result_bool := array.get(reference_a, i)
            break
    for i = 0 to array.size(chka) - 1
        result_bool := array.get(chka, i) ? array.get(reference_a, i) and result_bool : result_bool
    result_bool

// ══════════════════════════════════════════════════════════════════
// ── Dynamic Length ────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

bool[] tkarray    = array.from(true, true, true)
bool[] kjarray    = array.from(true, true, true)

bool[] tkvolarray = array.from(tkbrvolup, atrvolmeter, chikoufiltersig == 1)
bool[] kjvolarray = array.from(kjbrvolup, atrvolmeter, chikoufiltersig == 1)

booltkup = f_boolean(tkarray, tkvolarray)
boolkjup = f_boolean(kjarray, kjvolarray)

f_dyn(bool para, float adapt_pct, simple int minLen, simple int maxLen) =>
    var float i_len = math.avg(minLen, maxLen)
    i_len          := para ? math.max(minLen, i_len * adapt_pct) : math.min(maxLen, i_len * (2.0 - adapt_pct))
    int(i_len)

dyntk = f_dyn(booltkup, tkdynperc, tkminlen, tkmaxlen)
dynkj = f_dyn(boolkjup, kjdynperc, kjminlen, kjmaxlen)

// ══════════════════════════════════════════════════════════════════
// ── Ichimoku Line Calculation ─────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

f_kjv2(int len) =>
    kijun          = math.avg(ta.lowest(len), ta.highest(len))
    conversionLine = math.avg(ta.lowest(len / kjdivider), ta.highest(len / kjdivider))
    (kijun + conversionLine) / 2.0

tenkansen = f_kjv2(dyntk)
kijunsen  = f_kjv2(dynkj)

// ══════════════════════════════════════════════════════════════════
// ── Trend Logic ───────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

trendMa = ta.sma(close, trendMaLen)

[diPlus, diMinus, adx] = ta.dmi(adxLen, adxSmooth)

isDomBull = diPlus > diMinus or (diPlus == diMinus and close > trendMa)

// ══════════════════════════════════════════════════════════════════
// ── Colors ────────────────────────────────────────════════════════
// ══════════════════════════════════════════════════════════════════

bandColor  = isDomBull ? color.rgb(76, 175, 79, 29)  : color.rgb(255, 82, 82, 28)
smaColor   = isDomBull ? color.green                 : color.red
tkKjColor  = tenkansen > kijunsen ? color.new(#00ff91, 0) : color.new(#ff0000, 0)
tkFillCol  = isDomBull ? color.rgb(76, 175, 79, 85)  : color.rgb(255, 82, 82, 85)

// ══════════════════════════════════════════════════════════════════
// ── Support Band Plot ─────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

a  = ta.sma(close, 20)
b  = ta.ema(close, 21)

p1 = plot(a, color = showBands ? smaColor : na, title = 'SMA 20')
p2 = plot(b, color = showBands ? smaColor : na, title = 'EMA 21')
fill(p1, p2, color = showBands ? bandColor : na, title = 'Support Band Fill')

// ══════════════════════════════════════════════════════════════════
// ── 200 SMA ───────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

plot(trendMa, color = showTrendMa ? color.new(#2195f3, 100) : na, linewidth = 1, title = '200 SMA')

// ══════════════════════════════════════════════════════════════════
// ── Tenkan / Kijun Plot ───────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

pTK = plot(tenkansen, title = 'Tenkan-Sen', color = showTenkan ? tkKjColor : na, linewidth = 1)
pKJ = plot(kijunsen,  title = 'Kijun-Sen',  color = showKijun  ? tkKjColor : na, linewidth = 1)
fill(pTK, pKJ, color = showTKBand ? tkFillCol : na, title = 'TK Band Fill')

// ══════════════════════════════════════════════════════════════════
// ── Price Pivot S/R ───────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

ph = ta.pivothigh(close, leftBars, rightBars)
pl = ta.pivotlow(close,  leftBars, rightBars)

var array<float> resistance_levels = array.new_float(0)
var array<float> support_levels    = array.new_float(0)
var array<int>   resistance_bars   = array.new_int(0)
var array<int>   support_bars      = array.new_int(0)

if not na(ph)
    array.unshift(resistance_levels, ph)
    array.unshift(resistance_bars,   bar_index - rightBars)
    if array.size(resistance_levels) > 3
        array.pop(resistance_levels)
        array.pop(resistance_bars)

if not na(pl)
    array.unshift(support_levels, pl)
    array.unshift(support_bars,   bar_index - rightBars)
    if array.size(support_levels) > 3
        array.pop(support_levels)
        array.pop(support_bars)

var array<int> resistance_touches = array.new_int(3, 0)
var array<int> support_touches    = array.new_int(3, 0)

if array.size(resistance_levels) > 0
    for i = 0 to math.min(array.size(resistance_levels) - 1, 2)
        if i < array.size(resistance_levels)
            float lvl = array.get(resistance_levels, i)
            if math.abs(close - lvl) <= ta.atr(14) * 0.4 and close[1] < lvl
                array.set(resistance_touches, i, array.get(resistance_touches, i) + 1)

if array.size(support_levels) > 0
    for i = 0 to math.min(array.size(support_levels) - 1, 2)
        if i < array.size(support_levels)
            float lvl = array.get(support_levels, i)
            if math.abs(close - lvl) <= ta.atr(14) * 0.4 and close[1] > lvl
                array.set(support_touches, i, array.get(support_touches, i) + 1)

var array<line> res_lines = array.new_line(3)
var array<line> sup_lines = array.new_line(3)

if showPricePivots and barstate.islastconfirmedhistory
    for i = 0 to 2
        if i < array.size(res_lines)
            line.delete(array.get(res_lines, i))
        if i < array.size(sup_lines)
            line.delete(array.get(sup_lines, i))

    if array.size(resistance_levels) > 0
        for i = 0 to math.min(array.size(resistance_levels) - 1, 2)
            if i < array.size(resistance_levels) and i < array.size(resistance_bars)
                float lvl    = array.get(resistance_levels, i)
                int   origin = array.get(resistance_bars,   i)
                line  ln     = line.new(origin, lvl, bar_index + 15, lvl, color = color.new(color.red, 0),   width = 1, style = line.style_dashed, extend = extend.right)
                array.set(res_lines, i, ln)

    if array.size(support_levels) > 0
        for i = 0 to math.min(array.size(support_levels) - 1, 2)
            if i < array.size(support_levels) and i < array.size(support_bars)
                float lvl    = array.get(support_levels, i)
                int   origin = array.get(support_bars,   i)
                line  ln     = line.new(origin, lvl, bar_index + 15, lvl, color = color.new(color.green, 0), width = 1, style = line.style_dashed, extend = extend.right)
                array.set(sup_lines, i, ln)
