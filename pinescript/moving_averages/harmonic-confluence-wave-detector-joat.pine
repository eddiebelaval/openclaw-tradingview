//@version=6
indicator("Harmonic Confluence Wave Detector", shorttitle="HCW [JOAT]", format=format.price)

// ═══════════════════════════════════════════════════════════════════════════════
// HARMONIC CONFLUENCE WAVE DETECTOR [JOAT]
// Professional Multi-Oscillator Fusion System
// Integrates Koncorde Flow, WaveTrend Momentum, Enhanced MACD, MFI Pressure & Weighted Signals
// ═══════════════════════════════════════════════════════════════════════════════

// ────────────────────────────────────────────────────────────────────────────────
// INPUTS
// ────────────────────────────────────────────────────────────────────────────────

// Display Options
displayGroup = "Display Options"
showKoncorde = input.bool(true, "Show Koncorde", group=displayGroup)
showWaveTrend = input.bool(true, "Show WaveTrend", group=displayGroup)
showMACD = input.bool(true, "Show MACD", group=displayGroup)
showMFI = input.bool(true, "Show MFI", group=displayGroup)
showSignals = input.bool(true, "Show Buy/Sell Signals", group=displayGroup)

// Koncorde Settings
koncordeGroup = "Koncorde Settings"
koncordeOffset = input.int(-50, "Koncorde Offset", group=koncordeGroup)
mfiLength = input.int(14, "MFI Length", minval=1, group=koncordeGroup)

// WaveTrend Settings
wtGroup = "WaveTrend Settings"
wtChannelLen = input.int(9, "WT Channel Length", minval=1, group=wtGroup)
wtAverageLen = input.int(12, "WT Average Length", minval=1, group=wtGroup)
wtMALen = input.int(3, "WT MA Length", minval=1, group=wtGroup)

// MACD Settings
macdGroup = "MACD Settings"
macdOffset = input.int(300, "MACD Offset", group=macdGroup)
macdMultiplier = input.int(17, "MACD Multiplier", minval=1, group=macdGroup)
fastLength = input.int(12, "Fast Length", minval=1, group=macdGroup)
slowLength = input.int(26, "Slow Length", minval=1, group=macdGroup)
signalLength = input.int(9, "Signal Length", minval=1, group=macdGroup)

// Signal Settings
signalGroup = "Signal Settings"
rsiLength = input.int(14, "RSI Length", minval=1, group=signalGroup)
sm2Weight = input.float(0.6, "Smoothed Weight", minval=0, maxval=1, step=0.05, group=signalGroup)
mfiWeight = input.float(0.15, "MFI Weight", minval=0, maxval=1, step=0.05, group=signalGroup)
rsiWeight = input.float(0.35, "RSI Weight", minval=0, maxval=1, step=0.05, group=signalGroup)

// Advanced Features
advGroup = "Advanced Features"
showDivergence = input.bool(true, "Show Divergences", group=advGroup)
showMomentumZones = input.bool(true, "Show Momentum Zones", group=advGroup)
showConfluenceScore = input.bool(true, "Show Confluence Score", group=advGroup)
enableGradients = input.bool(true, "Enable Color Gradients", group=advGroup)

// ────────────────────────────────────────────────────────────────────────────────
// COLOR DEFINITIONS
// ────────────────────────────────────────────────────────────────────────────────

// Koncorde Colors
koncordeGreen = color.rgb(102, 255, 102)
koncordeBrown = color.rgb(255, 204, 153)
koncordeBlue = color.rgb(0, 255, 255)
koncordeMean = color.rgb(255, 50, 50)

// WaveTrend Colors with enhanced gradients
wtColor1 = color.rgb(100, 200, 255)
wtColor2 = color.rgb(30, 100, 200)
wtCrossUp = color.rgb(0, 255, 100)
wtCrossDown = color.rgb(255, 50, 100)

// MACD Colors with enhanced gradients
macdGrowAbove = color.rgb(0, 230, 118)
macdGrowBelow = color.rgb(255, 180, 200)
macdFallAbove = color.rgb(100, 255, 218)
macdFallBelow = color.rgb(255, 82, 82)
macdLine = color.rgb(33, 150, 243)
macdSignal = color.rgb(255, 152, 0)

// MFI Colors with enhanced gradients
mfiGreen = color.rgb(0, 255, 150)
mfiRed = color.rgb(255, 60, 100)

// Signal Colors with enhanced visibility
buySignalColor = color.rgb(0, 255, 100)
sellSignalColor = color.rgb(255, 50, 100)

// ────────────────────────────────────────────────────────────────────────────────
// KONCORDE CALCULATIONS
// ────────────────────────────────────────────────────────────────────────────────

calcMFI(length) =>
    100.0 - 100.0 / (1.0 + math.sum(volume * (ta.change(hlc3) <= 0 ? 0 : hlc3), length) / 
                          math.sum(volume * (ta.change(hlc3) >= 0 ? 0 : hlc3), length))

tprice = ohlc4
m = 15

pvim = ta.ema(ta.pvi, m)
pvimax = ta.highest(pvim, 90)
pvimin = ta.lowest(pvim, 90)
oscp = (ta.pvi - pvim) * 100 / (pvimax - pvimin)

nvim = ta.ema(ta.nvi, m)
nvimax = ta.highest(nvim, 90)
nvimin = ta.lowest(nvim, 90)
blue = (ta.nvi - nvim) * 100 / (nvimax - nvimin)

xmf = calcMFI(mfiLength)
mult = 2.0
basis = ta.sma(tprice, 25)
dev = mult * ta.stdev(tprice, 25)
upper = basis + dev
lower = basis - dev
OB1 = (upper + lower) / 2.0
OB2 = upper - lower
BollOsc = (tprice - OB1) / OB2 * 100

xrsi = ta.rsi(tprice, 14)

calcStoch(src, length, smoothFastD) =>
    ta.sma(100 * (src - ta.lowest(low, length)) / (ta.highest(high, length) - ta.lowest(low, length)), smoothFastD)

stoc = calcStoch(tprice, 21, 3)
brown = (xrsi + xmf + BollOsc + stoc / 3) / 2
green = brown + oscp
mean = ta.ema(brown, m)

// ────────────────────────────────────────────────────────────────────────────────
// WAVETREND CALCULATIONS
// ────────────────────────────────────────────────────────────────────────────────

ap = hlc3
esa = ta.ema(ap, wtChannelLen)
d = ta.ema(math.abs(ap - esa), wtChannelLen)
ci = (ap - esa) / (0.015 * d)
wt1 = ta.ema(ci, wtAverageLen)
wt2 = ta.sma(wt1, wtMALen)

wtCross = ta.cross(wt1, wt2)
wtCrossUp_signal = ta.crossover(wt1, wt2)
wtCrossDown_signal = ta.crossunder(wt1, wt2)

// ────────────────────────────────────────────────────────────────────────────────
// MACD CALCULATIONS
// ────────────────────────────────────────────────────────────────────────────────

src = close
fastMA = ta.ema(src, fastLength)
slowMA = ta.ema(src, slowLength)
macd = (fastMA - slowMA) / slowMA * 1000 * macdMultiplier
signal = ta.ema(macd, signalLength)
hist = macd - signal

histColor = hist >= 0 ? (hist[1] < hist ? macdGrowAbove : macdFallAbove) : (hist[1] < hist ? macdGrowBelow : macdFallBelow)

// ────────────────────────────────────────────────────────────────────────────────
// MFI CALCULATIONS
// ────────────────────────────────────────────────────────────────────────────────

mfiSource = hlc3
mfiPeriod = 50
mfiSmooth = 9
value = high - low
mfiUpper = math.sum(volume * (ta.change(mfiSource) <= 0 ? 0 : value), mfiPeriod)
mfiLower = math.sum(volume * (ta.change(mfiSource) >= 0 ? 0 : value), mfiPeriod)
mfi = mfiLower == 0 ? 0 : (100 - (100 / (1 + mfiUpper / mfiLower))) - 50
mfi := ta.sma(mfi, mfiSmooth)

mfiColor = mfi >= 0 ? mfiGreen : mfiRed

// ────────────────────────────────────────────────────────────────────────────────
// DIVERGENCE DETECTION
// ────────────────────────────────────────────────────────────────────────────────

// WaveTrend Divergences
var float lastWTPivotHigh = na
var float lastWTPivotHighPrice = na
var float lastWTPivotLow = na
var float lastWTPivotLowPrice = na

wtPivotHigh = ta.pivothigh(wt1, 5, 5)
wtPivotLow = ta.pivotlow(wt1, 5, 5)

wtBullDiv = false
wtBearDiv = false

if not na(wtPivotHigh) and showDivergence
    if not na(lastWTPivotHigh)
        wtBearDiv := high[5] > lastWTPivotHighPrice and wt1[5] < lastWTPivotHigh
    lastWTPivotHigh := wt1[5]
    lastWTPivotHighPrice := high[5]

if not na(wtPivotLow) and showDivergence
    if not na(lastWTPivotLow)
        wtBullDiv := low[5] < lastWTPivotLowPrice and wt1[5] > lastWTPivotLow
    lastWTPivotLow := wt1[5]
    lastWTPivotLowPrice := low[5]

// ────────────────────────────────────────────────────────────────────────────────
// BUY/SELL SIGNAL LOGIC
// ────────────────────────────────────────────────────────────────────────────────

rsi = ta.rsi(close, rsiLength)

// Extreme momentum zones
wtExtremeOversold = wt1 < -80
wtExtremOverbought = wt1 > 80
mfiExtreme = math.abs(mfi) > 40

// Confluence zones (all indicators aligned)
bullishZone = wt1 < -40 and mfi < -10 and rsi < 40 and macd < 0
bearishZone = wt1 > 40 and mfi > 10 and rsi > 60 and macd > 0

// Volume confirmation for better accuracy
volMA = ta.sma(volume, 20)
highVolume = volume > volMA * 1.2

// Enhanced Buy/Sell Signals with stricter confluence and volume
buySignal = wtCrossUp_signal and wt2 <= -25 and mfi <= -5 and rsi < 50 and highVolume
sellSignal = wtCrossDown_signal and wt2 >= 25 and mfi >= 5 and rsi > 50 and highVolume

// Weighted signal calculation
smval = wt2 < -60 ? (-53 - wt2) * sm2Weight : wt2 < -53 ? (-60 - wt2) * sm2Weight : 0
wsum = smval + (-8 - mfi) * mfiWeight + (30 - rsi) * rsiWeight

// Strong signals require positive weighted sum AND momentum alignment AND histogram confirmation
strongBuySignal = buySignal and wsum >= 0 and macd < macd[1] and hist > hist[1]
strongSellSignal = sellSignal and wsum < 0 and macd > macd[1] and hist < hist[1]

// MEGA signals - additional confluence with extreme conditions
megaBuySignal = strongBuySignal and wt1 < -60 and rsi < 35 and mfi < -15
megaSellSignal = strongSellSignal and wt1 > 60 and rsi > 65 and mfi > 15

// Enhanced signals with divergence and zone confirmation
ultraBuySignal = (strongBuySignal or megaBuySignal) and wtBullDiv and bullishZone
ultraSellSignal = (strongSellSignal or megaSellSignal) and wtBearDiv and bearishZone

// Confluence Score (0-100)
confluenceScore = 0.0
confluenceScore := confluenceScore + (wt1 < 0 ? math.abs(wt1) / 100 * 25 : 0)
confluenceScore := confluenceScore + (mfi < 0 ? math.abs(mfi) / 50 * 25 : 0)
confluenceScore := confluenceScore + (rsi < 50 ? (50 - rsi) / 50 * 25 : 0)
confluenceScore := confluenceScore + (macd < 0 ? 25 : 0)
confluenceScore := math.min(100, confluenceScore)

// ────────────────────────────────────────────────────────────────────────────────
// PLOTTING
// ────────────────────────────────────────────────────────────────────────────────

// Koncorde with gradient fills
koncGreenPlot = plot(showKoncorde ? green + koncordeOffset : na, "Koncorde Green", koncordeGreen, 2, plot.style_area, histbase=koncordeOffset)
koncBrownPlot = plot(showKoncorde ? brown + koncordeOffset : na, "Koncorde Brown", koncordeBrown, 2, plot.style_area, histbase=koncordeOffset)
koncBluePlot = plot(showKoncorde ? blue + koncordeOffset : na, "Koncorde Blue", koncordeBlue, 2, plot.style_area, histbase=koncordeOffset)
plot(showKoncorde ? mean + koncordeOffset : na, "Koncorde Mean", koncordeMean, 3)

// WaveTrend with enhanced gradient coloring
wtColor1Dynamic = enableGradients ? color.from_gradient(wt1, -100, 100, color.rgb(255, 50, 150), color.rgb(0, 255, 150)) : wtColor1
wtColor2Dynamic = enableGradients ? color.from_gradient(wt2, -100, 100, color.rgb(200, 50, 150), color.rgb(50, 200, 150)) : wtColor2
plot(showWaveTrend ? wt1 : na, "WT1", wtColor1Dynamic, 3)
plot(showWaveTrend ? wt2 : na, "WT2", wtColor2Dynamic, 2)

// Enhanced crossover signals
plotshape(showWaveTrend and wtCrossUp_signal ? wt2 : na, "WT Cross Up", shape.circle, location.absolute, wtCrossUp, size=size.small)
plotshape(showWaveTrend and wtCrossDown_signal ? wt2 : na, "WT Cross Down", shape.circle, location.absolute, wtCrossDown, size=size.small)

// Divergence markers with contrasting orange/yellow colors to stand out
plotshape(showDivergence and wtBullDiv ? wt1 : na, "WT Bull Div", shape.labelup, location.absolute, color.rgb(255, 200, 0), size=size.small, text="D", textcolor=color.black)
plotshape(showDivergence and wtBearDiv ? wt1 : na, "WT Bear Div", shape.labeldown, location.absolute, color.rgb(255, 150, 0), size=size.small, text="D", textcolor=color.black)

// WaveTrend Levels
hline(80, "WT Extreme OB", color.new(color.red, 60), hline.style_solid)
hline(60, "WT OB", color.new(color.orange, 70), hline.style_dotted)
hline(-60, "WT OS", color.new(color.lime, 70), hline.style_dotted)
hline(-80, "WT Extreme OS", color.new(color.green, 60), hline.style_solid)
hline(0, "WT Zero", color.new(color.gray, 50), hline.style_dotted)

// Momentum Zones
bgcolor(showMomentumZones and bullishZone ? color.new(buySignalColor, 95) : na, title="Bullish Zone")
bgcolor(showMomentumZones and bearishZone ? color.new(sellSignalColor, 95) : na, title="Bearish Zone")
bgcolor(showMomentumZones and wtExtremeOversold ? color.new(color.green, 92) : na, title="Extreme Oversold")
bgcolor(showMomentumZones and wtExtremOverbought ? color.new(color.red, 92) : na, title="Extreme Overbought")

// MACD with enhanced histogram and gradient - BIGGER BARS
histColorDynamic = enableGradients ? color.from_gradient(hist, -100, 100, color.rgb(255, 82, 82), color.rgb(0, 230, 118)) : histColor
plot(showMACD ? hist + macdOffset : na, "MACD Histogram", histColorDynamic, 8, plot.style_columns, histbase=macdOffset)
macdLineColor = enableGradients ? color.from_gradient(macd, -500, 500, color.rgb(255, 100, 150), color.rgb(50, 200, 255)) : macdLine
plot(showMACD ? macd + macdOffset : na, "MACD", macdLineColor, 3)
plot(showMACD ? signal + macdOffset : na, "MACD Signal", macdSignal, 2)

// MACD Zero Line
hline(macdOffset, "MACD Zero", color.new(color.gray, 60), hline.style_solid)

// MFI with gradient
mfiColorDynamic = enableGradients ? color.from_gradient(mfi, -50, 50, mfiRed, mfiGreen) : mfiColor
mfiPlot = plot(showMFI ? mfi : na, "MFI", mfiColorDynamic, 3)
zeroLine = plot(0, "Zero", color.new(color.gray, 100))
fill(mfiPlot, zeroLine, mfi >= 0 ? color.new(mfiGreen, 85) : color.new(mfiRed, 85))

// Enhanced Buy/Sell Signals with better precision and more signal types
plotshape(showSignals and ultraBuySignal ? -95 : na, "ULTRA Buy", shape.labelup, location.absolute, color.new(buySignalColor, 0), text="ULTRA\nBUY", textcolor=color.white, size=size.normal)
plotshape(showSignals and megaBuySignal and not ultraBuySignal ? -92 : na, "MEGA Buy", shape.labelup, location.absolute, color.new(color.aqua, 0), text="MEGA\nBUY", textcolor=color.black, size=size.small)
plotshape(showSignals and strongBuySignal and not ultraBuySignal and not megaBuySignal ? -90 : na, "Strong Buy", shape.labelup, location.absolute, color.new(buySignalColor, 20), text="BUY", textcolor=color.white, size=size.small)
plotshape(showSignals and ultraSellSignal ? 95 : na, "ULTRA Sell", shape.labeldown, location.absolute, color.new(sellSignalColor, 0), text="ULTRA\nSELL", textcolor=color.white, size=size.normal)
plotshape(showSignals and megaSellSignal and not ultraSellSignal ? 92 : na, "MEGA Sell", shape.labeldown, location.absolute, color.new(color.fuchsia, 0), text="MEGA\nSELL", textcolor=color.white, size=size.small)
plotshape(showSignals and strongSellSignal and not ultraSellSignal and not megaSellSignal ? 90 : na, "Strong Sell", shape.labeldown, location.absolute, color.new(sellSignalColor, 20), text="SELL", textcolor=color.white, size=size.small)

// ────────────────────────────────────────────────────────────────────────────────
// INFORMATION TABLE
// ────────────────────────────────────────────────────────────────────────────────

var table infoTable = table.new(position.bottom_right, 3, 7, 
                                 bgcolor=color.new(color.black, 85), 
                                 frame_color=color.new(color.gray, 50), 
                                 frame_width=1, 
                                 border_width=1, 
                                 border_color=color.new(color.gray, 50))

if barstate.islast
    // Header
    table.cell(infoTable, 0, 0, "HCW [JOAT]", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, "Value", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 0, "Status", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.small)
    
    // WT1
    table.cell(infoTable, 0, 1, "WT1", text_color=wtColor1, text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(wt1, "#.##"), text_color=color.white, text_size=size.small)
    wtStatus = wt1 > 60 ? "OB" : wt1 < -60 ? "OS" : "NEU"
    wtStatusColor = wt1 > 60 ? color.new(sellSignalColor, 30) : wt1 < -60 ? color.new(buySignalColor, 30) : color.new(color.gray, 70)
    table.cell(infoTable, 2, 1, wtStatus, bgcolor=wtStatusColor, text_color=color.white, text_size=size.small)
    
    // MFI
    table.cell(infoTable, 0, 2, "MFI", text_color=mfiColor, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(mfi, "#.##"), text_color=color.white, text_size=size.small)
    mfiStatus = mfi > 20 ? "BULL" : mfi < -20 ? "BEAR" : "NEU"
    mfiStatusColor = mfi > 20 ? color.new(mfiGreen, 30) : mfi < -20 ? color.new(mfiRed, 30) : color.new(color.gray, 70)
    table.cell(infoTable, 2, 2, mfiStatus, bgcolor=mfiStatusColor, text_color=color.white, text_size=size.small)
    
    // RSI
    table.cell(infoTable, 0, 3, "RSI", text_color=color.yellow, text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(rsi, "#.##"), text_color=color.white, text_size=size.small)
    rsiStatus = rsi > 70 ? "OB" : rsi < 30 ? "OS" : "NEU"
    rsiStatusColor = rsi > 70 ? color.new(sellSignalColor, 30) : rsi < 30 ? color.new(buySignalColor, 30) : color.new(color.gray, 70)
    table.cell(infoTable, 2, 3, rsiStatus, bgcolor=rsiStatusColor, text_color=color.white, text_size=size.small)
    
    // MACD
    table.cell(infoTable, 0, 4, "MACD", text_color=macdLine, text_size=size.small)
    table.cell(infoTable, 1, 4, str.tostring(macd, "#.#"), text_color=color.white, text_size=size.small)
    macdStatus = macd > signal ? "BULL" : "BEAR"
    macdStatusColor = macd > signal ? color.new(macdGrowAbove, 30) : color.new(macdFallBelow, 30)
    table.cell(infoTable, 2, 4, macdStatus, bgcolor=macdStatusColor, text_color=color.white, text_size=size.small)
    
    // Confluence Score
    if showConfluenceScore
        table.cell(infoTable, 0, 5, "Confluence", text_color=color.white, text_size=size.small)
        table.cell(infoTable, 1, 5, str.tostring(confluenceScore, "#") + "%", text_color=color.white, text_size=size.small)
        confColor = color.from_gradient(confluenceScore, 0, 100, color.new(sellSignalColor, 30), color.new(buySignalColor, 30))
        table.cell(infoTable, 2, 5, "", bgcolor=confColor, text_color=color.white, text_size=size.small)
    
    // Signal
    signalText = ultraBuySignal ? "ULTRA BUY" : megaBuySignal ? "MEGA BUY" : strongBuySignal ? "STRONG BUY" : buySignal ? "BUY" : ultraSellSignal ? "ULTRA SELL" : megaSellSignal ? "MEGA SELL" : strongSellSignal ? "STRONG SELL" : sellSignal ? "SELL" : "NEUTRAL"
    signalColor = ultraBuySignal ? color.new(buySignalColor, 0) : 
                  megaBuySignal ? color.new(color.aqua, 0) :
                  strongBuySignal or buySignal ? color.new(buySignalColor, 20) : 
                  ultraSellSignal ? color.new(sellSignalColor, 0) :
                  megaSellSignal ? color.new(color.fuchsia, 0) :
                  strongSellSignal or sellSignal ? color.new(sellSignalColor, 20) : color.new(color.gray, 70)
    
    table.cell(infoTable, 0, 6, "Signal", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 6, signalText, bgcolor=signalColor, text_color=color.white, text_size=size.small)
    table.merge_cells(infoTable, 1, 6, 2, 6)

// ────────────────────────────────────────────────────────────────────────────────
// ALERTS
// ────────────────────────────────────────────────────────────────────────────────

// Enhanced Signal Alerts
alertcondition(ultraBuySignal, "ULTRA Buy Signal", "ULTRA Buy Signal - Maximum Confluence Detected!")
alertcondition(megaBuySignal, "MEGA Buy Signal", "MEGA Buy Signal - Extreme Conditions!")
alertcondition(strongBuySignal, "Strong Buy Signal", "Strong Buy Signal Detected")
alertcondition(buySignal, "Buy Signal", "Buy Signal Detected")
alertcondition(ultraSellSignal, "ULTRA Sell Signal", "ULTRA Sell Signal - Maximum Confluence Detected!")
alertcondition(megaSellSignal, "MEGA Sell Signal", "MEGA Sell Signal - Extreme Conditions!")
alertcondition(strongSellSignal, "Strong Sell Signal", "Strong Sell Signal Detected")
alertcondition(sellSignal, "Sell Signal", "Sell Signal Detected")

// Crossover Alerts
alertcondition(wtCrossUp_signal, "WaveTrend Cross Up", "WaveTrend crossed up")
alertcondition(wtCrossDown_signal, "WaveTrend Cross Down", "WaveTrend crossed down")

// Divergence Alerts
alertcondition(wtBullDiv, "WaveTrend Bullish Divergence", "Bullish divergence detected on WaveTrend")
alertcondition(wtBearDiv, "WaveTrend Bearish Divergence", "Bearish divergence detected on WaveTrend")

// Extreme Condition Alerts
alertcondition(wtExtremeOversold, "Extreme Oversold", "WaveTrend in extreme oversold territory")
alertcondition(wtExtremOverbought, "Extreme Overbought", "WaveTrend in extreme overbought territory")

// Zone Alerts
alertcondition(bullishZone and not bullishZone[1], "Entered Bullish Zone", "All indicators aligned in bullish zone")
alertcondition(bearishZone and not bearishZone[1], "Entered Bearish Zone", "All indicators aligned in bearish zone")

// MACD Alerts
alertcondition(ta.crossover(macd, signal), "MACD Bullish Cross", "MACD crossed above signal line")
alertcondition(ta.crossunder(macd, signal), "MACD Bearish Cross", "MACD crossed below signal line")

// Confluence Score Alerts
alertcondition(confluenceScore > 80 and confluenceScore[1] <= 80, "High Confluence Score", "Confluence score above 80%")
alertcondition(confluenceScore < 20 and confluenceScore[1] >= 20, "Low Confluence Score", "Confluence score below 20%")
