//@version=6
indicator('Kaufman + Çoklu SMA with Table', shorttitle = 'KAMA+SMA Table', overlay = true)

// Kaufman Adaptive Moving Average (KAMA) fonksiyonu
kama(src, length) =>
    direction = math.abs(src - src[length])
    volatility = math.sum(math.abs(src - src[1]), length)
    efficiency_ratio = volatility != 0 ? direction / volatility : 0
    fast = 2.0 / (2 + 1)
    slow = 2.0 / (30 + 1)
    smoothing_constant = math.pow(efficiency_ratio * (fast - slow) + slow, 2)
    kama = 0.0
    kama := nz(kama[1]) + smoothing_constant * (src - nz(kama[1]))
    kama

// Moving Average'ler
sma5 = ta.sma(close, 5)
sma8 = ta.sma(close, 8)
sma13 = ta.sma(close, 13)
sma34 = ta.sma(close, 34)
sma55 = ta.sma(close, 55)
sma100 = ta.sma(close, 100)
sma144 = ta.sma(close, 144)
sma200 = ta.sma(close, 200)
sma233 = ta.sma(close, 233)
sma377 = ta.sma(close, 377)
kama21 = kama(close, 21)

// Fiyat - SMA5 kesme koşulları
price_cross_below_sma5 = ta.crossunder(close, sma5)

// YUKARI KESME koşulları
sma5_cross_above_sma13 = ta.crossover(sma5, sma13)

// AŞAĞI KESME koşulları
sma5_cross_below_sma8 = ta.crossunder(sma5, sma8)
sma5_cross_below_sma13 = ta.crossunder(sma5, sma13)

// Çizdirme
plot(kama21, color = #edeff701, linewidth = 1, title = 'KAMA 21')
plot(sma5, color = color.rgb(87, 181, 101), linewidth = 2, title = 'SMA 5')
plot(sma8, color = color.rgb(249, 249, 249, 100), linewidth = 1, title = 'SMA 8')
plot(sma13, color = color.rgb(242, 208, 54), linewidth = 2, title = 'SMA 13')
plot(sma34, color = color.rgb(196, 203, 248, 65), linewidth = 1, title = 'SMA 34')
plot(sma55, color = color.rgb(210, 57, 57), linewidth = 2, title = 'SMA 55')
plot(sma100, color = color.rgb(248, 251, 254, 99), linewidth = 1, title = 'SMA 100')
plot(sma144, color = color.rgb(248, 249, 242, 100), linewidth = 1, title = 'SMA 144')
plot(sma200, color = #f9f0fa00, linewidth = 1, title = 'SMA 200')
plot(sma233, color = color.rgb(245, 238, 246, 100), linewidth = 1, title = 'SMA 233')
plot(sma377, color = color.black, linewidth = 3, title = 'SMA 377')

// FİYAT - 
// TABLO - KÜÇÜKTEN BÜYÜĞE SIRALI
if barstate.islast
    var table moving_avg_table = table.new(position.top_right, 2, 11, bgcolor = color.new(color.white, 0), border_width = 0, frame_color = color.white)

    // Değerler - Küçükten büyüğe sıralı
    table.cell(moving_avg_table, 0, 0, 'SMA(5)', text_color = color.rgb(0, 4, 16), text_size = size.small)
    table.cell(moving_avg_table, 1, 0, str.tostring(sma5, '#.##'), text_color = sma5 > close ? color.red : color.green, text_size = size.small)

    table.cell(moving_avg_table, 0, 1, 'SMA(8)', text_color = color.rgb(0, 1, 3), text_size = size.small)
    table.cell(moving_avg_table, 1, 1, str.tostring(sma8, '#.##'), text_color = sma8 > close ? color.red : color.green, text_size = size.small)

    table.cell(moving_avg_table, 0, 2, 'SMA(13)', text_color = color.rgb(0, 2, 9), text_size = size.small)
    table.cell(moving_avg_table, 1, 2, str.tostring(sma13, '#.##'), text_color = sma13 > close ? color.red : color.green, text_size = size.small)

    table.cell(moving_avg_table, 0, 3, 'KAMA(21)', text_color = color.rgb(19, 19, 213), text_size = size.small)
    table.cell(moving_avg_table, 1, 3, str.tostring(kama21, '#.##'), text_color = kama21 > close ? color.red : color.green, text_size = size.small)

    table.cell(moving_avg_table, 0, 4, 'SMA(34)', text_color = #0a9c0d, text_size = size.small)
    table.cell(moving_avg_table, 1, 4, str.tostring(sma34, '#.##'), text_color = sma34 > close ? color.red : color.green, text_size = size.small)

    table.cell(moving_avg_table, 0, 5, 'SMA(55)', text_color = #a30c0c, text_size = size.small)
    table.cell(moving_avg_table, 1, 5, str.tostring(sma55, '#.##'), text_color = sma55 > close ? color.red : color.green, text_size = size.small)

    table.cell(moving_avg_table, 0, 6, 'SMA(100)', text_color = #000105, text_size = size.small)
    table.cell(moving_avg_table, 1, 6, str.tostring(sma100, '#.##'), text_color = sma100 > close ? color.red : color.green, text_size = size.small)

    table.cell(moving_avg_table, 0, 7, 'SMA(144)', text_color = color.rgb(146, 155, 13), text_size = size.small)
    table.cell(moving_avg_table, 1, 7, str.tostring(sma144, '#.##'), text_color = sma144 > close ? color.red : color.green, text_size = size.small)

    table.cell(moving_avg_table, 0, 8, 'SMA(200)', text_color = color.rgb(0, 0, 0), text_size = size.small)
    table.cell(moving_avg_table, 1, 8, str.tostring(sma200, '#.##'), text_color = sma200 > close ? color.red : color.green, text_size = size.small)

    table.cell(moving_avg_table, 0, 9, 'SMA(233)', text_color = #a30c78, text_size = size.small)
    table.cell(moving_avg_table, 1, 9, str.tostring(sma233, '#.##'), text_color = sma233 > close ? color.red : color.green, text_size = size.small)

    table.cell(moving_avg_table, 0, 10, 'SMA(377)', text_color = #000000, text_size = size.small)
    table.cell(moving_avg_table, 1, 10, str.tostring(sma377, '#.##'), text_color = sma377 > close ? color.red : color.green, text_size = size.small)




length1 = input.int(20, minval = 1, title = 'CCI')
ma_length = input.int(5, minval = 1, title = 'EMA')
src1 = input(close, title = 'Source')

ma1 = ta.sma(src1, length1)
cci1 = (src1 - ma1) / (0.015 * ta.dev(src1, length1))
cci_ema = ta.ema(cci1, ma_length)




// Horizontal lines
band0 = hline(200, color = color.red)
band1 = hline(100, color = color.blue)
band2 = hline(0, title = 'zero')
band3 = hline(-100, color = color.blue)
band4 = hline(-200, color = color.red)


// Crossover signals
cci_cross_above = ta.crossover(cci1, cci_ema)
cci_cross_below = ta.crossunder(cci1, cci_ema)
