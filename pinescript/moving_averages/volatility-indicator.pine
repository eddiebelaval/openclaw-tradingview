//@version=6
indicator("Nifty VIX EMA25 VWAP Adaptive Pro", overlay=true, precision=2)

// ==========================================
// 1. Inputs
// ==========================================
grp_vix       = "VIX Settings"
vix_symbol    = input.symbol("NSE:INDIAVIX", "VIX Symbol", group=grp_vix)
vix_len       = input.int(21, "VIX SMA Lookback", minval=5, group=grp_vix)
buffer_pct    = input.float(0.8, "VIX Buffer %", step=0.1, group=grp_vix) / 100

grp_price     = "Price Settings"
ema_len       = input.int(25, "EMA Length", minval=1, group=grp_price)
atr_len       = input.int(14, "ATR Lookback", minval=1, group=grp_price)
atr_base_mult = input.float(1.5, "Base ATR Multiplier", step=0.1, group=grp_price)

// ==========================================
// 2. Data Fetching & Calculations
// ==========================================
// VIX Data (fetching current timeframe for better alignment)
vix     = request.security(vix_symbol, timeframe.period, close)
vix_sma = ta.sma(vix, vix_len)

// Technical Indicators
ema_val  = ta.ema(close, ema_len)
vwap_val = ta.vwap(close)
atr      = ta.atr(atr_len)

// Adaptive Logic: VIX factor adjusts the ATR band
// When VIX is high (high fear), bands widen; when VIX is low, bands tighten.
vix_factor        = math.max(vix / vix_sma, 0.5)
adaptive_atr_mult = atr_base_mult * vix_factor
upper_band        = ema_val + (atr * adaptive_atr_mult)
lower_band        = ema_val - (atr * adaptive_atr_mult)

// ==========================================
// 3. Market State Logic
// ==========================================
vix_cooling = vix < vix_sma * (1 - buffer_pct)
vix_spiking = vix > vix_sma * (1 + buffer_pct)

// Signal Logic: Price above/below EMA & VWAP + VIX Alignment
bool long_condition  = close > upper_band and close > vwap_val and not vix_spiking
bool short_condition = close < lower_band and close < vwap_val and vix > vix_sma

var int trend_state = 0 // 1: Bullish, -1: Bearish, 0: Sideways

if long_condition
    trend_state := 1
else if short_condition
    trend_state := -1
else if (trend_state == 1 and close < ema_val) or (trend_state == -1 and close > ema_val)
    trend_state := 0

// ==========================================
// 4. Visuals (Plots & Shapes)
// ==========================================
// Background Colors
bg_color = trend_state == 1 ? color.new(color.green, 90) : 
           trend_state == -1 ? color.new(color.red, 90) : 
           color.new(color.gray, 95)
bgcolor(bg_color)

// Indicator Lines
plot(ema_val, "EMA 25", color.orange, 2)
plot(vwap_val, "VWAP", color.blue, 1, style=plot.style_linebr)
p1 = plot(upper_band, "Upper Band", color.new(color.gray, 80))
p2 = plot(lower_band, "Lower Band", color.new(color.gray, 80))
fill(p1, p2, color=color.new(color.gray, 95), title="Neutral Zone")

// Signal Arrows
plotshape(trend_state == 1 and trend_state[1] != 1, "Long Entry", shape.triangleup, location.belowbar, color.green, size=size.small, text="BUY")
plotshape(trend_state == -1 and trend_state[1] != -1, "Short Entry", shape.triangledown, location.abovebar, color.red, size=size.small, text="SELL")

// ==========================================
// 5. Dashboard Table
// ==========================================
var table dash = table.new(position.top_right, 2, 2, bgcolor=color.black, border_width=1, border_color=color.gray)

if barstate.islast
    string market_txt = trend_state == 1 ? "BULLISH" : trend_state == -1 ? "BEARISH" : "SIDEWAYS"
    color market_col  = trend_state == 1 ? color.green : trend_state == -1 ? color.red : color.yellow
    
    string vix_txt    = vix > vix_sma ? "SPIKING (Caution)" : "COOLING (Normal)"
    color vix_col     = vix > vix_sma ? color.red : color.green

    table.cell(dash, 0, 0, "Market Phase", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, market_txt, text_color=market_col, text_size=size.small)
    table.cell(dash, 0, 1, "VIX Status", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, vix_txt, text_color=vix_col, text_size=size.small)
