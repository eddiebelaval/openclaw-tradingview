//@version=6
indicator("All-in-One EMA x20 MTF", shorttitle="E-Master", overlay=true, max_bars_back=5000)

emaFromTf(int length, string srcTf) =>
    l    = math.max(length, 1)
    base = ta.ema(close, l)  
    srcTf == "" ?base :request.security(syminfo.tickerid, srcTf,base,gaps      = barmerge.gaps_off,lookahead = barmerge.lookahead_off)

showOnTfs(
    bool show_1m, bool show_5m, bool show_15m, bool show_30m,
    bool show_1h, bool show_4h, bool show_d,  bool show_w) =>
    is_1m  = timeframe.isminutes and timeframe.multiplier == 1
    is_5m  = timeframe.isminutes and timeframe.multiplier == 5
    is_15m = timeframe.isminutes and timeframe.multiplier == 15
    is_30m = timeframe.isminutes and timeframe.multiplier == 30
    is_1h  = timeframe.isminutes and timeframe.multiplier == 60
    is_4h  = timeframe.isminutes and timeframe.multiplier == 240
    is_d   = timeframe.isdaily  and timeframe.multiplier == 1
    is_w   = timeframe.isweekly and timeframe.multiplier == 1

    (show_1m and is_1m)  or(show_5m and is_5m)  or(show_15m and is_15m) or(show_30m and is_30m) or(show_1h and is_1h)  or(show_4h and is_4h)  or(show_d  and is_d)   or(show_w  and is_w)

// ==================== EMA 1 ====================
ema1_enable = input.bool(true , "Enable",    group="━━━━━━━━━━ EMA 1 ━━━━━━━━━━", inline="row1")
ema1_period = input.int (20   , "Period",    minval=1, group="━━━━━━━━━━ EMA 1 ━━━━━━━━━━", inline="row1")
ema1_tf     = input.timeframe("", "Source TF",        group="━━━━━━━━━━ EMA 1 ━━━━━━━━━━", inline="row1")

ema1_show_1m  = input.bool(false, "1m",  group="━━━━━━━━━━ EMA 1 ━━━━━━━━━━", inline="v1")
ema1_show_5m  = input.bool(true , "5m",  group="━━━━━━━━━━ EMA 1 ━━━━━━━━━━", inline="v1")
ema1_show_15m = input.bool(true , "15m", group="━━━━━━━━━━ EMA 1 ━━━━━━━━━━", inline="v1")
ema1_show_30m = input.bool(true , "30m", group="━━━━━━━━━━ EMA 1 ━━━━━━━━━━", inline="v1")
ema1_show_1h  = input.bool(true , "1H",  group="━━━━━━━━━━ EMA 1 ━━━━━━━━━━", inline="v2")
ema1_show_4h  = input.bool(true , "4H",  group="━━━━━━━━━━ EMA 1 ━━━━━━━━━━", inline="v2")
ema1_show_d   = input.bool(true , "D",   group="━━━━━━━━━━ EMA 1 ━━━━━━━━━━", inline="v2")
ema1_show_w   = input.bool(true , "W",   group="━━━━━━━━━━ EMA 1 ━━━━━━━━━━", inline="v2")

