// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/

//@version=6
indicator("Webby's Simple Fib. Trend V2", "WSFTV2", overlay=false)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
src         = input.source(close, "Source",            display=display.none)
comp_ticker = input.symbol("SPY", "Comparison Ticker", display=display.all)

// ─── PRIMARY TICKER EMAs ──────────────────────────────────────────────────────
ma1  = ta.ema(src, 3)
ma2  = ta.ema(src, 5)
ma3  = ta.ema(src, 8)
ma4  = ta.ema(src, 13)
ma5  = ta.ema(src, 21)
ma6  = ta.ema(src, 34)
ma7  = ta.ema(src, 55)
ma8  = ta.ema(src, 89)
ma9  = ta.ema(src, 144)
ma10 = ta.ema(src, 233)

// ─── COMPARISON TICKER EMAs ───────────────────────────────────────────────────
comp_src = request.security(comp_ticker, timeframe.period, close)

c1  = ta.ema(comp_src, 3)
c2  = ta.ema(comp_src, 5)
c3  = ta.ema(comp_src, 8)
c4  = ta.ema(comp_src, 13)
c5  = ta.ema(comp_src, 21)
c6  = ta.ema(comp_src, 34)
c7  = ta.ema(comp_src, 55)
c8  = ta.ema(comp_src, 89)
c9  = ta.ema(comp_src, 144)
c10 = ta.ema(comp_src, 233)

// ─── SCORE: PRIMARY ───────────────────────────────────────────────────────────
score = (
    (ma1 > ma2  ? 1 : 0) + (ma1 > ma3  ? 1 : 0) + (ma1 > ma4  ? 1 : 0) +
    (ma1 > ma5  ? 1 : 0) + (ma1 > ma6  ? 1 : 0) + (ma1 > ma7  ? 1 : 0) +
    (ma1 > ma8  ? 1 : 0) + (ma1 > ma9  ? 1 : 0) + (ma1 > ma10 ? 1 : 0) +
    (ma2 > ma3  ? 1 : 0) + (ma2 > ma4  ? 1 : 0) + (ma2 > ma5  ? 1 : 0) +
    (ma2 > ma6  ? 1 : 0) + (ma2 > ma7  ? 1 : 0) + (ma2 > ma8  ? 1 : 0) +
    (ma2 > ma9  ? 1 : 0) + (ma2 > ma10 ? 1 : 0) +
    (ma3 > ma4  ? 1 : 0) + (ma3 > ma5  ? 1 : 0) + (ma3 > ma6  ? 1 : 0) +
    (ma3 > ma7  ? 1 : 0) + (ma3 > ma8  ? 1 : 0) + (ma3 > ma9  ? 1 : 0) +
    (ma3 > ma10 ? 1 : 0) +
    (ma4 > ma5  ? 1 : 0) + (ma4 > ma6  ? 1 : 0) + (ma4 > ma7  ? 1 : 0) +
    (ma4 > ma8  ? 1 : 0) + (ma4 > ma9  ? 1 : 0) + (ma4 > ma10 ? 1 : 0) +
    (ma5 > ma6  ? 1 : 0) + (ma5 > ma7  ? 1 : 0) + (ma5 > ma8  ? 1 : 0) +
    (ma5 > ma9  ? 1 : 0) + (ma5 > ma10 ? 1 : 0) +
    (ma6 > ma7  ? 1 : 0) + (ma6 > ma8  ? 1 : 0) + (ma6 > ma9  ? 1 : 0) +
    (ma6 > ma10 ? 1 : 0) +
    (ma7 > ma8  ? 1 : 0) + (ma7 > ma9  ? 1 : 0) + (ma7 > ma10 ? 1 : 0) +
    (ma8 > ma9  ? 1 : 0) + (ma8 > ma10 ? 1 : 0) +
    (ma9 > ma10 ? 1 : 0)
    )

comp_score = (
    (c1 > c2   ? 1 : 0) + (c1 > c3   ? 1 : 0) + (c1 > c4   ? 1 : 0) +
    (c1 > c5   ? 1 : 0) + (c1 > c6   ? 1 : 0) + (c1 > c7   ? 1 : 0) +
    (c1 > c8   ? 1 : 0) + (c1 > c9   ? 1 : 0) + (c1 > c10  ? 1 : 0) +
    (c2 > c3   ? 1 : 0) + (c2 > c4   ? 1 : 0) + (c2 > c5   ? 1 : 0) +
    (c2 > c6   ? 1 : 0) + (c2 > c7   ? 1 : 0) + (c2 > c8   ? 1 : 0) +
    (c2 > c9   ? 1 : 0) + (c2 > c10  ? 1 : 0) +
    (c3 > c4   ? 1 : 0) + (c3 > c5   ? 1 : 0) + (c3 > c6   ? 1 : 0) +
    (c3 > c7   ? 1 : 0) + (c3 > c8   ? 1 : 0) + (c3 > c9   ? 1 : 0) +
    (c3 > c10  ? 1 : 0) +
    (c4 > c5   ? 1 : 0) + (c4 > c6   ? 1 : 0) + (c4 > c7   ? 1 : 0) +
    (c4 > c8   ? 1 : 0) + (c4 > c9   ? 1 : 0) + (c4 > c10  ? 1 : 0) +
    (c5 > c6   ? 1 : 0) + (c5 > c7   ? 1 : 0) + (c5 > c8   ? 1 : 0) +
    (c5 > c9   ? 1 : 0) + (c5 > c10  ? 1 : 0) +
    (c6 > c7   ? 1 : 0) + (c6 > c8   ? 1 : 0) + (c6 > c9   ? 1 : 0) +
    (c6 > c10  ? 1 : 0) +
    (c7 > c8   ? 1 : 0) + (c7 > c9   ? 1 : 0) + (c7 > c10  ? 1 : 0) +
    (c8 > c9   ? 1 : 0) + (c8 > c10  ? 1 : 0) +
    (c9 > c10  ? 1 : 0)
    )

// ─── REFERENCE LINES ─────────────────────────────────────────────────────────
hline(40, "Strong",   color=color.green,  linestyle=hline.style_solid)
hline(35, "Neutral",  color=color.yellow, linestyle=hline.style_solid)
hline(30, "Weak",     color=color.red,    linestyle=hline.style_solid)

// ─── PLOTS ────────────────────────────────────────────────────────────────────
p1 = plot(score,      "Ticker Score",              color=#1A87E5,        linewidth=2)
p2 = plot(comp_score, "Base Score",                color=color.orange,   linewidth=2)

// ─── FILL: green when ticker leads, red when ticker lags ──────────────────────
fill(p1, p2,
     color = score > comp_score
         ? color.new(color.green, 80)
         : color.new(color.red,   80))
