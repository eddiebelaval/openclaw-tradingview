//@version=6
indicator("Nifty Heavyweight Momentum Line", overlay=false, precision=2)

// --- 1. Functions ---
get_stock_rsi(ticker) =>
    request.security(ticker, timeframe.period, ta.rsi(close, 14))

// --- 2. Data Fetching (Weights from your image) ---
rsiHDFC     = get_stock_rsi("NSE:HDFCBANK")
rsiICICI    = get_stock_rsi("NSE:ICICIBANK")
rsiRELIANCE = get_stock_rsi("NSE:RELIANCE")
rsiINFY     = get_stock_rsi("NSE:INFY")
rsiAIRTEL   = get_stock_rsi("NSE:BHARTIARTL")
rsiLT       = get_stock_rsi("NSE:LT")
rsiSBI      = get_stock_rsi("NSE:SBIN")
rsiAXIS     = get_stock_rsi("NSE:AXISBANK")
rsiTCS      = get_stock_rsi("NSE:TCS")
rsiITC      = get_stock_rsi("NSE:ITC")

// --- 3. Weighted Momentum Score Calculation ---
// Sum of weights: 12.30 + 8.38 + 8.16 + 4.98 + 4.75 + 4.00 + 3.87 + 3.40 + 2.76 + 2.69 = 55.29%
weightedRSI = (rsiHDFC * 12.30 + rsiICICI * 8.38 + rsiRELIANCE * 8.16 + rsiINFY * 4.98 + 
               rsiAIRTEL * 4.75 + rsiLT * 4.00 + rsiSBI * 3.87 + rsiAXIS * 3.40 + 
               rsiTCS * 2.76 + rsiITC * 2.69) / 55.29

// --- 4. Visuals ---
plot(weightedRSI, title="Weighted Momentum Score", color=weightedRSI > 50 ? color.green : color.red, linewidth=2)

// Levels
hline(60, "Bullish Zone", color=color.green, linestyle=hline.style_dashed)
hline(40, "Bearish Zone", color=color.red, linestyle=hline.style_dashed)
hline(50, "Neutral", color=color.gray)

// Background Color Signals
bgcolor(weightedRSI > 60 ? color.new(color.green, 85) : weightedRSI < 40 ? color.new(color.red, 85) : na)

// Label for current score
var label scoreLabel = na
label.delete(scoreLabel)
scoreLabel := label.new(bar_index, weightedRSI, "Momentum Score: " + str.tostring(math.round(weightedRSI, 2)), 
     color=weightedRSI > 50 ? color.green : color.red, textcolor=color.white, style=label.style_label_left)
