//@version=5
indicator("Fixed 30m ORB Horizontal", overlay=true)

// --- Inputs ---
orb_time = input.session("0915-0945", "ORB Time Session")
line_color_high = input.color(color.green, "High Line Color")
line_color_low = input.color(color.red, "Low Line Color")

// --- Variables to store values ---
var float orb_h = na
var float orb_l = na
var line hi_line = na
var line lo_line = na

// Check session
in_session = time(timeframe.period, orb_time)
session_ended = not in_session and in_session[1]

// Logic to capture High/Low
if in_session
    if not in_session[1] // First candle of session
        orb_h := high
        orb_l := low
    else
        orb_h := math.max(high, orb_h)
        orb_l := math.min(low, orb_l)

// Jab 9:45 par session khatam ho, tab line draw karo
if session_ended
    // Purani lines delete karo agar naya day hai toh
    line.delete(hi_line)
    line.delete(lo_line)
    
    // Nayi horizontal lines draw karo jo aage tak jayein (extend.right)
    hi_line := line.new(bar_index[1], orb_h, bar_index, orb_h, xloc=xloc.bar_index, extend=extend.right, color=line_color_high, width=2)
    lo_line := line.new(bar_index[1], orb_l, bar_index, orb_l, xloc=xloc.bar_index, extend=extend.right, color=line_color_low, width=2)

// Labels (Optional: Levels dikhane ke liye)
var label hi_lab = na
var label lo_lab = na
if session_ended
    label.delete(hi_lab)
    label.delete(lo_lab)
    hi_lab := label.new(bar_index, orb_h, "30m ORB High", color=color.new(color.green, 100), style=label.style_label_left, textcolor=line_color_high)
    lo_lab := label.new(bar_index, orb_l, "30m ORB Low", color=color.new(color.red, 100), style=label.style_label_left, textcolor=line_color_low)
