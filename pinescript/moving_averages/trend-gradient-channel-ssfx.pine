//@version=6
indicator("Trend Gradient Channel [SSFX]", overlay=true)

// Inputs
emaLen = input.int(34, minval=1, title="EMA Length")
baseColor = input.color(color.aqua, "Gradient Base Color")

// EMA channel
emaHigh = ta.ema(high, emaLen)
emaLow  = ta.ema(low, emaLen)

// Main boundary plots
pHigh = plot(emaHigh, title="EMA High", color=color.new(color.aqua,100), linewidth=2)
pLow  = plot(emaLow,  title="EMA Low",  color=color.new(color.aqua,100), linewidth=2)

// Gradient layers inside channel
lvl1 = emaLow + (emaHigh - emaLow) * 0.20
lvl2 = emaLow + (emaHigh - emaLow) * 0.40
lvl3 = emaLow + (emaHigh - emaLow) * 0.60
lvl4 = emaLow + (emaHigh - emaLow) * 0.80

p1 = plot(lvl1, title="Level 1", color=color.new(baseColor, 100), linewidth=1)
p2 = plot(lvl2, title="Level 2", color=color.new(baseColor, 100), linewidth=1)
p3 = plot(lvl3, title="Level 3", color=color.new(baseColor, 100), linewidth=1)
p4 = plot(lvl4, title="Level 4", color=color.new(baseColor, 100), linewidth=1)

// Pseudo-gradient fill
fill(pLow, p1, color=color.new(baseColor, 88), title="Fill 1")
fill(p1, p2,  color=color.new(baseColor, 80), title="Fill 2")
fill(p2, p3,  color=color.new(baseColor, 72), title="Fill 3")
fill(p3, p4,  color=color.new(baseColor, 80), title="Fill 4")
fill(p4, pHigh, color=color.new(baseColor, 88), title="Fill 5")
