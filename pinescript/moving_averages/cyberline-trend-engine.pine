// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("Cyberline Trend Engine", overlay = true, max_boxes_count = 500, max_labels_count = 500)

// --- Neon Cyberpunk Palette ---
color NEON_GREEN  = #00ff9f
color NEON_BLUE   = #00b8ff
color NEON_PURPLE = #9400c7
color NEON_PINK   = #ff34af
color DEEP_INDIGO = #0014ad
color TEXT_COLOR  = chart.fg_color

// --- Inputs ---
group_ribbon = "Ribbon Settings"
emaFastLen  = input.int(10, "Fast EMA Boundary", minval = 1, group = group_ribbon)
emaSlowLen  = input.int(50, "Slow EMA Boundary", minval = 2, group = group_ribbon)
ribbonStyle = input.string("Solid", "Ribbon Line Style", options = ["Solid", "Dashed", "Dotted"], group = group_ribbon)

group_signals = "Signal Filters"
volMultiplier = input.float(1.1, "Volume Multiplier", minval = 0.1, step = 0.1, group = group_signals)
volLookback   = input.int(20, "Volume Lookback", minval = 1, group = group_signals)
atrSens       = input.float(1.0, "Strength Sensitivity", minval = 0.1, step = 0.1, group = group_signals)

group_visual = "Visual Settings"
showVwap     = input.bool(true, "Show Cyberline VWAP", group = group_visual)
vwapCol      = input.color(NEON_BLUE, "VWAP Color", group = group_visual)
vwapWidth    = input.int(2, "VWAP Thickness", minval = 1, maxval = 5, group = group_visual)
colorCandles = input.bool(true, "Color Candles to Trend", group = group_visual)
bullCol      = input.color(NEON_GREEN, "Bullish Color", group = group_visual)
bearCol      = input.color(NEON_PINK, "Bearish Color", group = group_visual)

group_ui = "UI Settings"
showTable   = input.bool(true, "Show Dashboard", group = group_ui)
tablePos    = input.string("Bottom Right", "Dashboard Position", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = group_ui)

group_extra = "Extra Dashboard Symbols"
sym1 = input.symbol("NASDAQ:QQQ", "Extra Symbol 1", group = group_extra)
sym2 = input.symbol("CME_MINI:NQ1!", "Extra Symbol 2", group = group_extra)
sym3 = input.symbol("CME_MINI:ES1!", "Extra Symbol 3", group = group_extra)

// --- Style Mappings ---
currentLineStyle = ribbonStyle == "Dashed" ? plot.linestyle_dashed : ribbonStyle == "Dotted" ? plot.linestyle_dotted : plot.linestyle_solid

// --- Logic Function ---
get_trend_data(fLen, sLen, aSens) =>
    float step = (sLen - fLen) / 7.0
    float e1 = ta.ema(close, math.round(fLen + step * 0))
    float e8 = ta.ema(close, math.round(fLen + step * 7))
    float upper = math.max(e1, e8)
    float lower = math.min(e1, e8)
    bool bull = e1 > e8
    bool bear = e1 <= e8
    float atr = ta.atr(14)
    float strength = math.abs(close - e8) / (nz(atr) * aSens > 0 ? atr * aSens : 1)
    [bull, bear, upper, lower, close, strength]

// --- Core Calculations ---
[bullish, bearish, upper_main, lower_main, current_close, strength_main] = get_trend_data(emaFastLen, emaSlowLen, atrSens)

// Volume check
float avgVol = ta.sma(volume, volLookback)
bool volConfirmed = volume > (nz(avgVol) * volMultiplier)

// VWAP
float vwapVal = ta.vwap(close)
plot(showVwap ? vwapVal : na, "Cyberline VWAP Core", color = color.new(vwapCol, 20), linewidth = vwapWidth, style = plot.style_linebr)

// --- Ribbon Plotting (8 EMAs) ---
float stepPlot = (emaSlowLen - emaFastLen) / 7.0
ep1 = ta.ema(close, math.round(emaFastLen + stepPlot * 0))
ep8 = ta.ema(close, math.round(emaFastLen + stepPlot * 7))

color currentStateColor = bullish ? bullCol : bearCol
barcolor(colorCandles ? currentStateColor : na)

p1 = plot(ep1, color = color.new(currentStateColor, 40), linewidth = 2, title = "EMA 1", linestyle = currentLineStyle)
plot(ta.ema(close, math.round(emaFastLen + stepPlot * 1)), color = color.new(currentStateColor, 60), linewidth = 1, linestyle = currentLineStyle)
plot(ta.ema(close, math.round(emaFastLen + stepPlot * 2)), color = color.new(currentStateColor, 60), linewidth = 1, linestyle = currentLineStyle)
plot(ta.ema(close, math.round(emaFastLen + stepPlot * 3)), color = color.new(currentStateColor, 60), linewidth = 1, linestyle = currentLineStyle)
plot(ta.ema(close, math.round(emaFastLen + stepPlot * 4)), color = color.new(currentStateColor, 60), linewidth = 1, linestyle = currentLineStyle)
plot(ta.ema(close, math.round(emaFastLen + stepPlot * 5)), color = color.new(currentStateColor, 60), linewidth = 1, linestyle = currentLineStyle)
plot(ta.ema(close, math.round(emaFastLen + stepPlot * 6)), color = color.new(currentStateColor, 60), linewidth = 1, linestyle = currentLineStyle)
p8 = plot(ep8, color = color.new(currentStateColor, 40), linewidth = 2, title = "EMA 8", linestyle = currentLineStyle)

fill(p1, p8, color = color.new(currentStateColor, 85), title = "Ribbon Glow")

// --- Signal Logic & Suppression ---
bool buyCond  = close > upper_main and bullish and volConfirmed
bool sellCond = close < lower_main and bearish and volConfirmed
bool bullRevCond = close > upper_main and bearish
bool bearRevCond = close < lower_main and bullish

var int lastSignalState = 0 

bool buySignal  = buyCond and lastSignalState != 1
bool sellSignal = sellCond and lastSignalState != 2
bool bullRev    = bullRevCond and lastSignalState != 3
bool bearRev    = bearRevCond and lastSignalState != 4

if buySignal
    lastSignalState := 1
if sellSignal
    lastSignalState := 2
if bullRev
    lastSignalState := 3
if bearRev
    lastSignalState := 4

// --- Visual Labels ---
f_label(int _idx, string _txt, color _bg, color _txtCol, bool _up) =>
    label.new(_idx, na, _txt, 
              color = color.new(_bg, 10), 
              textcolor = _txtCol, 
              style = _up ? label.style_label_up : label.style_label_down, 
              size = size.tiny, 
              yloc = _up ? yloc.belowbar : yloc.abovebar)

if buySignal
    f_label(bar_index, "BUY", bullCol, color.black, true)
if sellSignal
    f_label(bar_index, "SELL", bearCol, color.black, false)
if bullRev
    f_label(bar_index, "REVERSAL", bullCol, color.black, true)
if bearRev
    f_label(bar_index, "REVERSAL", bearCol, color.black, false)

// --- Dashboard ---
f_draw_cell(table _t, int _r, string _sym, bool _bull, bool _bear, color _bCol, color _rCol, float _close, float _u, float _l, float _str) =>
    bool isBuy  = _close > _u and _bull
    bool isSell = _close < _l and _bear
    bool isBullRev = _close > _u and _bear
    bool isBearRev = _close < _l and _bull
    string sigText = isBuy ? "BUY" : isSell ? "SELL" : isBullRev or isBearRev ? "REVERSAL" : "HOLD"
    color sigCol   = isBuy or isBullRev ? _bCol : isSell or isBearRev ? _rCol : color.new(color.gray, 50)
    table.cell(_t, 0, _r, _sym, text_color = TEXT_COLOR)
    table.cell(_t, 1, _r, sigText, bgcolor = sigCol, text_color = color.black)
    table.cell(_t, 2, _r, _bull ? "Bullish" : "Bearish", text_color = TEXT_COLOR)
    table.cell(_t, 3, _r, str.format("{0,number,#}%", math.min(_str * 25, 100)), text_color = TEXT_COLOR)

var table dashTable = na
if showTable and barstate.islast
    string pos = tablePos == "Top Right" ? position.top_right : tablePos == "Bottom Right" ? position.bottom_right : tablePos == "Top Left" ? position.top_left : position.bottom_left
    dashTable := table.new(pos, 4, 5, border_width = 1, border_color = color.new(NEON_PURPLE, 50), frame_color = color.new(NEON_PURPLE, 50))
    color headBg = color.new(DEEP_INDIGO, 30)
    table.cell(dashTable, 0, 0, "Symbol", text_color = color.white, bgcolor = headBg)
    table.cell(dashTable, 1, 0, "Signal", text_color = color.white, bgcolor = headBg)
    table.cell(dashTable, 2, 0, "Trend", text_color = color.white, bgcolor = headBg)
    table.cell(dashTable, 3, 0, "Strength", text_color = color.white, bgcolor = headBg)
    f_draw_cell(dashTable, 1, syminfo.ticker, bullish, bearish, bullCol, bearCol, close, upper_main, lower_main, strength_main)
    [b1, r1, u1, l1, c1, s1] = request.security(sym1, timeframe.period, get_trend_data(emaFastLen, emaSlowLen, atrSens))
    [b2, r2, u2, l2, c2, s2] = request.security(sym2, timeframe.period, get_trend_data(emaFastLen, emaSlowLen, atrSens))
    [b3, r3, u3, l3, c3, s3] = request.security(sym3, timeframe.period, get_trend_data(emaFastLen, emaSlowLen, atrSens))
    f_draw_cell(dashTable, 2, sym1, b1, r1, bullCol, bearCol, c1, u1, l1, s1)
    f_draw_cell(dashTable, 3, sym2, b2, r2, bullCol, bearCol, c2, u2, l2, s2)
    f_draw_cell(dashTable, 4, sym3, b3, r3, bullCol, bearCol, c3, u3, l3, s3)
