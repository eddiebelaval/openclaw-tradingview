//@version=6
indicator("Volume-Based Moving Average", overlay=true)

// === Inputs ===
targetVolume = input.float(250000, "Target Volume")
sourceOpt    = input.string(
     "High & Low",
     "Source",
     options = ["Close", "HL2", "HLC3", "OHLC4", "High & Low"]
)
slopeConfirmBars = input.int(3, "Slope Confirmation Bars", minval=1)

// === Helper function ===
f_volumeMA(_src) =>
    float volSum   = 0.0
    float priceSum = 0.0
    int   barsUsed = 0
    int   totalBars = bar_index + 1  // total bars available

    while volSum < targetVolume and barsUsed < totalBars
        volSum   += volume[barsUsed]
        priceSum += _src[barsUsed]
        barsUsed += 1

    barsUsed > 0 ? priceSum / barsUsed : na

// === VMA calculations (raw chart data only) ===
float vmaSingle =
     sourceOpt == "Close"  ? f_volumeMA(close)  :
     sourceOpt == "HL2"    ? f_volumeMA(hl2)    :
     sourceOpt == "HLC3"   ? f_volumeMA(hlc3)   :
     sourceOpt == "OHLC4"  ? f_volumeMA(ohlc4)  :
     na

float vmaHigh = sourceOpt == "High & Low" ? f_volumeMA(high) : na
float vmaLow  = sourceOpt == "High & Low" ? f_volumeMA(low)  : na

// === Slope confirmation logic (STATEFUL) ===
f_slopeColor(_vma) =>
    var int upCount   = 0
    var int downCount = 0
    var color curColor = color.gray

    if not na(_vma) and not na(_vma[1])
        if _vma > _vma[1]
            upCount   += 1
            downCount := 0
        else if _vma < _vma[1]
            downCount += 1
            upCount   := 0

        if upCount >= slopeConfirmBars
            curColor := color.green
        else if downCount >= slopeConfirmBars
            curColor := color.red

    curColor

// === Colors ===
color vmaSingleColor = f_slopeColor(vmaSingle)
color vmaHighColor   = f_slopeColor(vmaHigh)
color vmaLowColor    = f_slopeColor(vmaLow)

// === Plots (always visible) ===
plot(vmaSingle, "Volume MA",      linewidth=2, color=vmaSingleColor)
plot(vmaHigh,   "Volume MA High", linewidth=2, color=vmaHighColor)
plot(vmaLow,    "Volume MA Low",  linewidth=2, color=vmaLowColor)
