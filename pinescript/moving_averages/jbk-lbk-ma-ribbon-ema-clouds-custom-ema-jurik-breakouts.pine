//@version=6
indicator("JBK LBK - ALL-IN MA Ribbon + EMA Clouds + Custom EMA + Jurik Breakouts", overlay=true, max_labels_count=500, max_lines_count=500)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🔧 FONCTION MA MULTI-TYPES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ma(src, len, type) =>
    switch type
        "SMA"  => ta.sma(src, len)
        "EMA"  => ta.ema(src, len)
        "RMA"  => ta.rma(src, len)
        "WMA"  => ta.wma(src, len)
        "VWMA" => ta.vwma(src, len)
        => na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 📌 MA RIBBON — Defaults from your screenshots
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
group_ribbon = "MA Ribbon"

// MA 1 — EMA / HIGH / 96
show_ma1  = input.bool(true, "MA 1", inline="ma1", group=group_ribbon)
ma1_type  = input.string("EMA", "", options=["SMA","EMA","RMA","WMA","VWMA"], inline="ma1", group=group_ribbon)
ma1_src   = input.source(high, "", inline="ma1", group=group_ribbon)
ma1_len   = input.int(96, "", minval=1, inline="ma1", group=group_ribbon)
ma1_col   = input.color(color.white, "", inline="ma1", group=group_ribbon)
plot(show_ma1 ? ma(ma1_src, ma1_len, ma1_type) : na, color=ma1_col, title="MA 1")

// MA 2 — EMA / HL2 / 96
show_ma2  = input.bool(true, "MA 2", inline="ma2", group=group_ribbon)
ma2_type  = input.string("EMA", "", options=["SMA","EMA","RMA","WMA","VWMA"], inline="ma2", group=group_ribbon)
ma2_src   = input.source(hl2, "", inline="ma2", group=group_ribbon)
ma2_len   = input.int(96, "", minval=1, inline="ma2", group=group_ribbon)
ma2_col   = input.color(color.new(color.white, 20), "", inline="ma2", group=group_ribbon)
plot(show_ma2 ? ma(ma2_src, ma2_len, ma2_type) : na, color=ma2_col, title="MA 2")

// MA 3 — EMA / LOW / 96
show_ma3  = input.bool(true, "MA 3", inline="ma3", group=group_ribbon)
ma3_type  = input.string("EMA", "", options=["SMA","EMA","RMA","WMA","VWMA"], inline="ma3", group=group_ribbon)
ma3_src   = input.source(low, "", inline="ma3", group=group_ribbon)
ma3_len   = input.int(96, "", minval=1, inline="ma3", group=group_ribbon)
ma3_col   = input.color(color.new(color.white, 40), "", inline="ma3", group=group_ribbon)
plot(show_ma3 ? ma(ma3_src, ma3_len, ma3_type) : na, color=ma3_col, title="MA 3")

// MA 4 — OFF by default
show_ma4  = input.bool(false, "MA 4", inline="ma4", group=group_ribbon)
ma4_type  = input.string("EMA", "", options=["SMA","EMA","RMA","WMA","VWMA"], inline="ma4", group=group_ribbon)
ma4_src   = input.source(close, "", inline="ma4", group=group_ribbon)
ma4_len   = input.int(200, "", minval=1, inline="ma4", group=group_ribbon)
ma4_col   = input.color(color.new(color.white, 60), "", inline="ma4", group=group_ribbon)
plot(show_ma4 ? ma(ma4_src, ma4_len, ma4_type) : na, color=ma4_col, title="MA 4")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ☁️ EMA CLOUDS — Defaults from your screenshots
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
group_cloud = "EMA Clouds"

// Cloud 1 — ON / 8–14
c1_on   = input.bool(true, "Cloud 1", group=group_cloud)
c1_s    = input.int(8, "Short EMA", group=group_cloud)
c1_l    = input.int(14, "Long EMA", group=group_cloud)
c1_bull = input.color(color.new(color.green, 70), "Bull Color", group=group_cloud)
c1_bear = input.color(color.new(color.red, 75), "Bear Color", group=group_cloud)

ema1s = ta.ema(close, c1_s)
ema1l = ta.ema(close, c1_l)
p1s = plot(c1_on ? ema1s : na, display=display.none)
p1l = plot(c1_on ? ema1l : na, display=display.none)
fill(p1s, p1l, color = ema1s >= ema1l ? c1_bull : c1_bear)

// Cloud 2 — OFF
c2_on   = input.bool(false, "Cloud 2", group=group_cloud)
c2_s    = input.int(20, "Short EMA", group=group_cloud)
c2_l    = input.int(50, "Long EMA", group=group_cloud)
c2_bull = input.color(color.new(#00bcd4, 70), "Bull Color", group=group_cloud)
c2_bear = input.color(color.new(#f85193, 75), "Bear Color", group=group_cloud)

ema2s = ta.ema(close, c2_s)
ema2l = ta.ema(close, c2_l)
p2s = plot(c2_on ? ema2s : na, display=display.none)
p2l = plot(c2_on ? ema2l : na, display=display.none)
fill(p2s, p2l, color = ema2s >= ema2l ? c2_bull : c2_bear)

// Cloud 3 — OFF
c3_on   = input.bool(false, "Cloud 3", group=group_cloud)
c3_s    = input.int(34, "Short EMA", group=group_cloud)
c3_l    = input.int(200, "Long EMA", group=group_cloud)
c3_bull = input.color(color.new(#66bb6a, 70), "Bull Color", group=group_cloud)
c3_bear = input.color(color.new(#ff9800, 75), "Bear Color", group=group_cloud)

ema3s = ta.ema(close, c3_s)
ema3l = ta.ema(close, c3_l)
p3s = plot(c3_on ? ema3s : na, display=display.none)
p3l = plot(c3_on ? ema3l : na, display=display.none)
fill(p3s, p3l, color = ema3s >= ema3l ? c3_bull : c3_bear)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ➕ CUSTOM EMA — All OFF by default
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
group_custom = "Custom EMA"

emaA_on  = input.bool(false, "EMA A", group=group_custom)
emaA_len = input.int(9, "Length", group=group_custom)
emaA_col = input.color(color.yellow, "Color", group=group_custom)
plot(emaA_on ? ta.ema(close, emaA_len) : na, color=emaA_col, title="EMA A")

emaB_on  = input.bool(false, "EMA B", group=group_custom)
emaB_len = input.int(21, "Length", group=group_custom)
emaB_col = input.color(color.aqua, "Color", group=group_custom)
plot(emaB_on ? ta.ema(close, emaB_len) : na, color=emaB_col, title="EMA B")

emaC_on  = input.bool(false, "EMA C", group=group_custom)
emaC_len = input.int(55, "Length", group=group_custom)
emaC_col = input.color(color.fuchsia, "Color", group=group_custom)
plot(emaC_on ? ta.ema(close, emaC_len) : na, color=emaC_col, title="EMA C")

emaD_on  = input.bool(false, "EMA D", group=group_custom)
emaD_len = input.int(200, "Length", group=group_custom)
emaD_col = input.color(color.orange, "Color", group=group_custom)
plot(emaD_on ? ta.ema(close, emaD_len) : na, color=emaD_col, title="EMA D")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🔥 JURIK TREND BREAKOUTS — Defaults from your screenshots
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
group_jurik = "Jurik Trend Breakouts"

jurik_on  = input.bool(true, "Enable Jurik Module", group=group_jurik)
j_len     = input.int(9, "JMA Length", group=group_jurik)
j_phase   = input.float(0.15, "JMA Phase", step=0.01, group=group_jurik)
pivotLen  = input.int(4, "Pivot Length", group=group_jurik)
colorUp   = input.color(color.rgb(26, 255, 64), "Up Color", group=group_jurik)
colorDn   = input.color(color.rgb(35, 156, 255), "Down Color", group=group_jurik)
showGlow  = input.bool(true, "Glow Effect", group=group_jurik)

// Jurik MA function
jma(src, length, phase) =>
    beta = 0.45 * (length - 1) / (0.45 * (length - 1) + 2)
    alpha = math.pow(beta, phase)
    var float j = src
    j := (1 - alpha) * src + alpha * nz(j[1])
    j

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 📌 PLOTS JURIK (GLOBAL)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
jSmooth = jurik_on ? jma(close, j_len, j_phase) : na
trend   = jurik_on and jSmooth >= jSmooth[3]
trendColor = trend ? colorUp : colorDn

plot(jurik_on ? jSmooth : na, "JurikMA", color=trendColor, linewidth=3)
plot(jurik_on and showGlow ? jSmooth : na, "JurikMA Glow", color=color.new(trendColor, 60), linewidth=8)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 📌 LOGIQUE JURIK (LOCAL)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if jurik_on
    ph  = ta.pivothigh(pivotLen, pivotLen)
    pl  = ta.pivotlow(pivotLen, pivotLen)
    atr = ta.atr(200)

    var float H  = na
    var float L  = na
    var int   Hi = 0
    var int   Li = 0

    var line  up_l1   = na
    var line  up_l2   = na
    var label up_lbl1 = na
    var label up_lbl2 = na

    var line  dn_l1   = na
    var line  dn_l2   = na
    var label dn_lbl1 = na
    var label dn_lbl2 = na

    // Trend UP
    if trend
        if not na(ph)
            if na(H) or math.abs(ph - H) < atr
                if na(up_l1)
                    up_l1   := line.new(bar_index - pivotLen, high[pivotLen], bar_index, high[pivotLen], color=colorUp)
                    up_l2   := line.new(Hi, H, bar_index - pivotLen, high[pivotLen], color=colorUp)
                    up_lbl1 := label.new(Hi, H, "✓", textcolor=colorUp)
                    up_lbl2 := label.new(bar_index - pivotLen, ph, "✓", textcolor=colorUp)
            H  := ph
            Hi := bar_index - pivotLen

        if not na(up_l1)
            up_l1.set_x2(bar_index)
            up_l1.set_style(line.style_dashed)
        if not na(up_l2)
            up_l2.set_style(line.style_dashed)

        if not na(up_l1) and close > up_l1.get_y2() and barstate.isconfirmed
            label.new(bar_index, low, "↑", textcolor=colorUp, size=size.large)
            up_l1   := na
            up_l2   := na
            up_lbl1 := na
            up_lbl2 := na

    // Trend DOWN
    if not trend
        if not na(pl)
            if na(L) or math.abs(pl - L) < atr
                if na(dn_l1)
                    dn_l1   := line.new(bar_index - pivotLen, low[pivotLen], bar_index, low[pivotLen], color=colorDn)
                    dn_l2   := line.new(Li, L, bar_index - pivotLen, low[pivotLen], color=colorDn)
                    dn_lbl1 := label.new(Li, L, "✓", textcolor=colorDn)
                    dn_lbl2 := label.new(bar_index - pivotLen, pl, "✓", textcolor=colorDn)
            L  := pl
            Li := bar_index - pivotLen

        if not na(dn_l1)
            dn_l1.set_x2(bar_index)
            dn_l1.set_style(line.style_dashed)
        if not na(dn_l2)
            dn_l2.set_style(line.style_dashed)

        if not na(dn_l1) and close < dn_l1.get_y2() and barstate.isconfirmed
            label.new(bar_index, high, "↓", textcolor=colorDn, size=size.large)
            dn_l1   := na
            dn_l2   := na
            dn_lbl1 := na
            dn_lbl2 := na
