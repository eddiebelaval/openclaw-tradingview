//@version=6
indicator("Globus Capitas EMA 9–14 Ribbon", overlay=true)

// ───── Inputs ─────
emaFastLen = input.int(9, title="Fast EMA Length")
emaSlowLen = input.int(14, title="Slow EMA Length")

// ───── EMA Calculations ─────
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

// ───── Plot EMAs ─────
plotFast = plot(emaFast, title="EMA 9", color=color.lime, linewidth=2)
plotSlow = plot(emaSlow, title="EMA 14", color=color.red, linewidth=2)

// ───── Ribbon Color Logic ─────
ribbonColor = emaFast > emaSlow ? color.new(color.green, 80) :
              emaFast < emaSlow ? color.new(color.red, 80) :
              color.new(color.gray, 90)

// ───── Fill Between EMAs ─────
fill(plotFast, plotSlow, color=ribbonColor, title="EMA Ribbon")
