//@version=6
indicator("10EMA Strategy Indicator", overlay=true)

// Calculate 10 EMA
ema10 = ta.ema(close, 10)

// === BEARISH BAR ABOVE 10EMA IN BULLISH TREND ===
// Define bullish trend (price above 10 EMA)
bullishTrend = close > ema10

// Define bearish bar (close < open)
bearishBar = close < open

// Define bar above 10 EMA (low above the EMA)
barAboveEMA = low > ema10

// Identify the setup: bearish bar above 10EMA in bullish trend
bearishSetup = bullishTrend and bearishBar and barAboveEMA

// === BULLISH BAR BELOW 10EMA IN BEARISH TREND ===
// Define bearish trend (price below 10 EMA)
bearishTrend = close < ema10

// Define bullish bar (close > open)
bullishBar = close > open

// Define bar below 10 EMA (high below the EMA)
barBelowEMA = high < ema10

// Identify the setup: bullish bar below 10EMA in bearish trend
bullishSetup = bearishTrend and bullishBar and barBelowEMA

// Plot the 10 EMA
plot(ema10, color=color.yellow, linewidth=2, title="10 EMA")

// Highlight the setup bars
// bgcolor(bearishSetup ? color.new(color.green, 80) : na, title="Bearish Setup Background")
// bgcolor(bullishSetup ? color.new(color.red, 80) : na, title="Bullish Setup Background")

// Plot arrows when conditions are met
plotshape(bearishSetup, style=shape.triangledown, location=location.abovebar, 
          color=color.green, size=size.small, title="Bearish Bar Signal")

plotshape(bullishSetup, style=shape.triangleup, location=location.belowbar, 
          color=color.red, size=size.small, title="Bullish Bar Signal")

// Alert conditions
alertcondition(bearishSetup, title="Bearish Bar Above 10EMA", 
               message="Bearish bar detected above 10EMA in bullish trend")

alertcondition(bullishSetup, title="Bullish Bar Below 10EMA", 
               message="Bullish bar detected below 10EMA in bearish trend")

alertcondition(bearishSetup or bullishSetup, title="Any Setup Signal", 
               message="Trading setup detected")
