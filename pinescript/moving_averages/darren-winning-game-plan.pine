//@version=6
indicator("USDJPY RSI(14) → XAUUSD Entry Model", overlay=false)

// === FIXED RSI LENGTH ===
rsiLength = 14

// === USDJPY RSI (14 close) ===
usdClose = request.security("FX:USDJPY", timeframe.period, close)
usdRsi   = ta.rsi(usdClose, rsiLength)

// === XAU RSI (current chart symbol) ===
xauRsi = ta.rsi(close, rsiLength)

// === SESSION FILTER (UTC) ===
// London trading from 10:00–13:00 UTC
londonSession  = not na(time(timeframe.period, "1000-1300", "UTC"))

// New York session 13:00–22:00 UTC
newYorkSession = not na(time(timeframe.period, "1300-2200", "UTC"))

allowedSession = londonSession or newYorkSession

// === BACKGROUND SHADING ===
bgcolor(londonSession ? color.new(color.blue, 85) : na)
bgcolor(newYorkSession ? color.new(color.orange, 85) : na)

// === USDJPY RSI CROSS 50 ===
usdCrossAbove50 = ta.crossover(usdRsi, 50)
usdCrossBelow50 = ta.crossunder(usdRsi, 50)

// === ENTRY LOGIC ===
buySignal  = allowedSession and usdCrossAbove50 and xauRsi < 50
sellSignal = allowedSession and usdCrossBelow50 and xauRsi > 50

// === SIGNAL MARKERS ===
plotshape(buySignal,  title="BUY",  location=location.bottom, color=color.green, style=shape.triangleup, size=size.small)
plotshape(sellSignal, title="SELL", location=location.top,    color=color.red,   style=shape.triangledown, size=size.small)

// === RSI PLOTS ===
plot(usdRsi, title="USDJPY RSI (14)", color=color.purple)
plot(xauRsi, title="XAUUSD RSI (14)", color=color.yellow)

// === RSI LEVELS ===
upperBand = hline(70, "Upper Band (70)", color=color.red)
midLine   = hline(50, "Midline (50)", color=color.gray)
lowerBand = hline(30, "Lower Band (30)", color=color.green)

// Optional light fill between 70 & 30
fill(upperBand, lowerBand, color=color.new(color.gray, 90))

// === SINGLE ALERT ===
alertcondition(buySignal or sellSignal,
     title="XAUUSD Entry Signal",
     message="USDJPY RSI crossed 50 → XAUUSD Trade Signal")
