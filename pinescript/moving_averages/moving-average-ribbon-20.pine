//Based on Violent's Moving Average Ribbon

//@version=6
indicator("Moving Average Ribbon 2.0", shorttitle="MAR2.0", overlay=true)
import TradingView/ta/12
import TheTradingSpiderMan/MovingAverages/1

// --- Inputs ---
src         = input.source(close, "Source")
maType      = input.string("SMA", "Type", options=["ADAPTIVELAGUERRE", "AHRENSMA", "ALMA", "APEXMA", "BUTTERWORTH2", "BUTTERWORTH3", "CORAL", "DEMA", "EDSMA", "EHMA", "EMA", "EPMA", "EVWMA", "FAMAVAL", "FISHERMA", "FRAMA", "GDEMA", "GMA", "GWMA", "HARMONICMA", "HMA", "HWMA", "ILRS", "INSTANTTREND", "JMA", "KAMA", "LAGUERRE", "LEOMA", "LSMA", "MAMA", "MCGINLEY", "MEDIANMA", "MODULARFILTER", "NMA", "PPOMA", "QRMA", "REMA", "RMA", "RMT", "RUNNINGMA", "RVMA", "SINWMA", "SMA", "SUPERSMOOTHER", "SWMA", "SWWMA", "T3", "TEMA", "TMA", "TRIMMEDMA", "TRIXSMOOTH", "TWMA", "VAMA", "VIDYA", "VMA", "VWMA", "WILDERSMOOTH", "WMA", "ZLEMA"])
theme       = input.string("Theme 2", "Theme", options=["Theme 1", "Theme 2", "Theme 3"])
length      = input.int(1, "Length", minval=1)
start       = input.int(2, "Start", minval=1)
maNumber    = input.int(32, "No. of MAs", minval=1, maxval=32)
colourFrom  = input.bool(false, "Color option")

// --- Color Definitions ---
// Transparency is now handled inside color.new()
color_green  = color.new(color.green, 25)
color_red    = color.new(color.red, 25)
color_teal   = color.new(color.teal, 25)
color_purple = color.new(color.purple, 25)
color_silver = color.new(color.silver, 50)
color_dark   = color.new(#353535, 25)

// Theme logic using switch for better performance
c1 = switch theme
    "Theme 1" => color_green
    "Theme 2" => color_teal
    "Theme 3" => color_silver
    => na

c2 = switch theme
    "Theme 1" => color_red
    "Theme 2" => color_purple
    "Theme 3" => color_dark
    => na

// --- Calculation Function ---
getMa(idx) =>
    len = (length * start) + (length * idx) 
    switch maType
        //---Basic---
        "SMA"       => ta.sma(src, len)
        "EMA"       => ta.ema(src, len)
        "WMA"       => ta.wma(src, len)
        "VWMA"      => ta.vwma(src, len)
        "RMA"       => ta.rma(src, len)

        "SWMA"      => ta.wma(ta.wma(src, len), len)
        //---Hull Family---
        "HMA"       => ta.hma(src, len)
        "EHMA"      => MovingAverages.ehma(src, len)
        //---Smoothed---
        "DEMA"      => MovingAverages.dema(src, len)
        "TEMA"      => ta.tema(src, len)
        "TMA"       => ta.sma(ta.sma(src, math.ceil(len/2)), math.floor(len/2) + 1)
        "T3"        => MovingAverages.t3(src, len)
        "TWMA"      => MovingAverages.twma(src, len)
        "SWWMA"     => MovingAverages.swwma(src, len)
        "TRIXSMOOTH"=> MovingAverages.trixSmooth(src, len)
        //---Zero or Log Lag---
        "ZLEMA"     => MovingAverages.zlema(src, len)
        "LSMA"      => ta.linreg(src, len, 0)
        "EPMA"      => MovingAverages.epma(src, len)
        "ILRS"      => MovingAverages.ilrs(src, len)
        //---Adaptive---
        "KAMA"      => MovingAverages.kama(src, len)
        "FRAMA"     => MovingAverages.frama(src, len)
        "VIDYA"     => MovingAverages.vidya(src, len)
        "VMA"       => MovingAverages.vma(src, len)
        "VAMA"      => MovingAverages.vama(src, len)
        "RVMA"      => MovingAverages.rvma(src, len)
        "APEXMA"    => MovingAverages.apexMA(src, len)
        //---Ehler's Filters---
        "SUPERSMOOTHER" => MovingAverages.superSmoother(src, len)
        "BUTTERWORTH2"  => MovingAverages.butterworth2(src, len)
        "BUTTERWORTH3"  => MovingAverages.butterworth3(src, len)
        "INSTANTTREND"  => MovingAverages.instantTrend(src)
        "EDSMA"         => MovingAverages.edsma(src, len)
        //---Laguerre Family---
        "LAGUERRE" => MovingAverages.laguerreFilter(src, 0.8)
        "ADAPTIVELAGUERRE" => MovingAverages.adaptiveLaguerre(src, len)
        //---Special Weighted---
        "ALMA"      => ta.alma(src, len, 0, sigma=6.0)
        "SINWMA"    => MovingAverages.sinwma(src, len)
        "GWMA"      => MovingAverages.gwma(src, len)
        "NMA"       => MovingAverages.nma(src, len)
        //---Jurik, McGinley, Coral---
        "JMA"       => MovingAverages.jma(src, len)
        "MCGINLEY"  => MovingAverages.mcginley(src, len)
        "CORAL"     => MovingAverages.coral(src, len)
        //---Mean Types---
        "MEDIANMA"    => ta.median(src, len)
        "GMA"       => MovingAverages.gma(src, len)
        "HARMONICMA" => MovingAverages.harmonicMA(src, len)
        "TRIMMEDMA" => MovingAverages.trimmedMA(src, len)
        //---Other Specialized---
        "HWMA"     => MovingAverages.hwma(src, len)
        "GDEMA"     => MovingAverages.gdema(src, len)
        "REMA"      => MovingAverages.rema(src, len)
        "MODULARFILTER" => MovingAverages.modularFilter(src, len)
        "RMT"       => MovingAverages.rmt(src, len)
        "QRMA"      => MovingAverages.qrma(src, len)
        "WILDERSMOOTH" => MovingAverages.wilderSmooth(src, len)
        "LEOMA"     => MovingAverages.leoMA(src, len)
        "AHRENSMA"  => MovingAverages.ahrensMA(src, len)
        "RUNNINGMA" => MovingAverages.runningMA(src, len)
        "PPOMA"     => MovingAverages.ppoMA(src, len)
        "MAMA"      => MovingAverages.mama(src)
        "FAMAVAL"   => MovingAverages.fama(src)
        "FISHERMA"  => MovingAverages.fisherMA(src, len)
        => na

// --- Data Retrieval ---
m1  = maNumber >= 1  ? getMa(0)  : na
m2  = maNumber >= 2  ? getMa(1)  : na
m3  = maNumber >= 3  ? getMa(2)  : na
m4  = maNumber >= 4  ? getMa(3)  : na
m5  = maNumber >= 5  ? getMa(4)  : na
m6  = maNumber >= 6  ? getMa(5)  : na
m7  = maNumber >= 7  ? getMa(6)  : na
m8  = maNumber >= 8  ? getMa(7)  : na
m9  = maNumber >= 9  ? getMa(8)  : na
m10 = maNumber >= 10 ? getMa(9)  : na
m11 = maNumber >= 11 ? getMa(10) : na
m12 = maNumber >= 12 ? getMa(11) : na
m13 = maNumber >= 13 ? getMa(12) : na
m14 = maNumber >= 14 ? getMa(13) : na
m15 = maNumber >= 15 ? getMa(14) : na
m16 = maNumber >= 16 ? getMa(15) : na
m17 = maNumber >= 17 ? getMa(16) : na
m18 = maNumber >= 18 ? getMa(17) : na
m19 = maNumber >= 19 ? getMa(18) : na
m20 = maNumber >= 20 ? getMa(19) : na
m21 = maNumber >= 21 ? getMa(20) : na
m22 = maNumber >= 22 ? getMa(21) : na
m23 = maNumber >= 23 ? getMa(22) : na
m24 = maNumber >= 24 ? getMa(23) : na
m25 = maNumber >= 25 ? getMa(24) : na
m26 = maNumber >= 26 ? getMa(25) : na
m27 = maNumber >= 27 ? getMa(26) : na
m28 = maNumber >= 28 ? getMa(27) : na
m29 = maNumber >= 29 ? getMa(28) : na
m30 = maNumber >= 30 ? getMa(29) : na
m31 = maNumber >= 31 ? getMa(30) : na
m32 = maNumber >= 32 ? getMa(31) : na

// --- Plotting Logic ---
// Helper for dynamic coloring
getColor(curr, prev) => 
    (not colourFrom and curr <= src) or (colourFrom and curr <= prev) ? c1 : c2

plot(m32, color=getColor(m32, m31), title="MA 32")
plot(m31, color=getColor(m31, m30), title="MA 31")
plot(m30, color=getColor(m30, m29), title="MA 30")
plot(m29, color=getColor(m29, m28), title="MA 29")
plot(m28, color=getColor(m28, m27), title="MA 28")
plot(m27, color=getColor(m27, m26), title="MA 27")
plot(m26, color=getColor(m26, m25), title="MA 26")
plot(m25, color=getColor(m25, m24), title="MA 25")
plot(m24, color=getColor(m24, m23), title="MA 24")
plot(m23, color=getColor(m23, m22), title="MA 23")
plot(m22, color=getColor(m22, m21), title="MA 22")
plot(m21, color=getColor(m21, m20), title="MA 21")
plot(m20, color=getColor(m20, m19), title="MA 20")
plot(m19, color=getColor(m19, m18), title="MA 19")
plot(m18, color=getColor(m18, m17), title="MA 18")
plot(m17, color=getColor(m17, m16), title="MA 17")
plot(m16, color=getColor(m16, m15), title="MA 16")
plot(m15, color=getColor(m15, m14), title="MA 15")
plot(m14, color=getColor(m14, m13), title="MA 14")
plot(m13, color=getColor(m13, m12), title="MA 13")
plot(m12, color=getColor(m12, m11), title="MA 12")
plot(m11, color=getColor(m11, m10), title="MA 11")
plot(m10, color=getColor(m10, m9),  title="MA 10")
plot(m9,  color=getColor(m9,  m8),  title="MA 9")
plot(m8,  color=getColor(m8,  m7),  title="MA 8")
plot(m7,  color=getColor(m7,  m6),  title="MA 7")
plot(m6,  color=getColor(m6,  m5),  title="MA 6")
plot(m5,  color=getColor(m5,  m4),  title="MA 5")
plot(m4,  color=getColor(m4,  m3),  title="MA 4")
plot(m3,  color=getColor(m3,  m2),  title="MA 3")
plot(m2,  color=getColor(m2,  m1),  title="MA 2")
plot(m1,  color=getColor(m1,  src), title="MA 1")
