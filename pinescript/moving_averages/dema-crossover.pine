// ============================================================================
// DEMA Crossover Indicator — MNQ Intraday
// ============================================================================
// Version:     1.0
// Pine Script: v5
// Author:      Custom build for MNQ day trading
// Description: Double Exponential Moving Average (DEMA) crossover system.
//              Generates long/short signal hints on confirmed bar closes.
//              Optimized for 1m, 3m, and 5m charts on MNQ/NQ futures.
//
// DEMA Formula: DEMA(n) = 2 × EMA(close, n) − EMA(EMA(close, n), n)
//
// Webhook example for Tradovate automation:
//   Long:  {"action":"buy","symbol":"MNQM2026","qty":1,"orderType":"Market"}
//   Short: {"action":"sell","symbol":"MNQM2026","qty":1,"orderType":"Market"}
//   Paste the JSON into TradingView's alert message field.
// ============================================================================

//@version=5
indicator(
     title     = "DEMA Crossover",
     shorttitle = "DEMA Cross",
     overlay   = true,
     max_bars_back = 500)


// ────────────────────────────────────────────────────────────────────────────
// INPUTS
// ────────────────────────────────────────────────────────────────────────────

// — DEMA Parameters —
fastLength = input.int(
     defval  = 8,
     title   = "Fast DEMA Length",
     minval  = 2,
     tooltip = "Period for the fast DEMA. Lower = more responsive, more noise.")

slowLength = input.int(
     defval  = 21,
     title   = "Slow DEMA Length",
     minval  = 2,
     tooltip = "Period for the slow DEMA. Higher = smoother, more lag.")

src = input.source(
     defval  = close,
     title   = "Price Source",
     tooltip = "Price source for DEMA calculation. Default is close. Try hl2 or hlc3 for smoother response.")

// — Signal Behavior —
confirmOnClose = input.bool(
     defval  = true,
     title   = "Confirm Signal on Bar Close",
     tooltip = "Only fire signals on confirmed (closed) bars. Disabling introduces repainting — signals may appear and disappear on live bars.")

minBarIndex = input.int(
     defval  = 50,
     title   = "Min Bar Index for Signals",
     minval  = 0,
     tooltip = "Suppress signals before this bar index to avoid false triggers during DEMA warmup period on chart load.")

// — Visual Settings —
showSignals = input.bool(
     defval  = true,
     title   = "Show Signal Markers",
     tooltip = "Display triangle markers on crossover/crossunder bars.")

showFill = input.bool(
     defval  = true,
     title   = "Show DEMA Fill",
     tooltip = "Shade the area between fast and slow DEMA to visualize trend.")

bullColor = input.color(
     defval  = #26a69a,
     title   = "Bullish Color",
     tooltip = "Color for bullish trend state (fast DEMA above slow).")

bearColor = input.color(
     defval  = #ef5350,
     title   = "Bearish Color",
     tooltip = "Color for bearish trend state (fast DEMA below slow).")

// — Alert Messages —
alertMsgLong = input.string(
     defval  = "DEMA Cross Long — MNQ",
     title   = "Alert Message (Long)",
     tooltip = "Alert message for bullish crossover. Replace with JSON for webhook automation.")

alertMsgShort = input.string(
     defval  = "DEMA Cross Short — MNQ",
     title   = "Alert Message (Short)",
     tooltip = "Alert message for bearish crossunder. Replace with JSON for webhook automation.")


// ────────────────────────────────────────────────────────────────────────────
// DEMA CALCULATION
// ────────────────────────────────────────────────────────────────────────────

// Reusable DEMA function
// DEMA reduces lag by applying EMA twice and compensating:
//   DEMA = 2 * EMA(src, len) - EMA(EMA(src, len), len)
//
// Note: Effective warmup is ~2x the length parameter because the outer EMA
// needs the inner EMA to stabilize first. For DEMA(21), expect ~42 bars
// before values are fully stable.
dema(float source, int length) =>
    ema1 = ta.ema(source, length)
    ema2 = ta.ema(ema1, length)
    2 * ema1 - ema2

// Compute both DEMA lines
float demaFast = dema(src, fastLength)
float demaSlow = dema(src, slowLength)


// ────────────────────────────────────────────────────────────────────────────
// TREND STATE
// ────────────────────────────────────────────────────────────────────────────

bool isBullish = demaFast > demaSlow


// ────────────────────────────────────────────────────────────────────────────
// SIGNAL DETECTION
// ────────────────────────────────────────────────────────────────────────────

// Raw crossover/crossunder detection
bool rawLong  = ta.crossover(demaFast, demaSlow)
bool rawShort = ta.crossunder(demaFast, demaSlow)

// Apply bar-close confirmation to prevent repainting on live bars.
// When confirmOnClose is true, signals only fire after the bar has closed
// and the DEMA values are locked in. This adds ~1 bar of latency but
// eliminates phantom signals that appear and vanish intra-bar.
//
// The minBarIndex guard prevents spurious signals during the DEMA warmup
// period when the chart first loads.
bool longSignal  = rawLong  and (not confirmOnClose or barstate.isconfirmed) and bar_index >= minBarIndex
bool shortSignal = rawShort and (not confirmOnClose or barstate.isconfirmed) and bar_index >= minBarIndex


// ────────────────────────────────────────────────────────────────────────────
// PLOTTING — DEMA LINES
// ────────────────────────────────────────────────────────────────────────────

// Dynamic coloring: both lines match the current trend regime so the
// overall bias is visible at a glance.
color trendColor = isBullish ? bullColor : bearColor

// Fast DEMA — thicker, primary visual
plot(
     series    = demaFast,
     title     = "DEMA Fast",
     color     = trendColor,
     linewidth = 2)

// Slow DEMA — thinner, secondary reference
plot(
     series    = demaSlow,
     title     = "DEMA Slow",
     color     = trendColor,
     linewidth = 1)


// ────────────────────────────────────────────────────────────────────────────
// PLOTTING — FILL BETWEEN DEMAs
// ────────────────────────────────────────────────────────────────────────────

// Shaded ribbon between the two DEMA lines for quick trend identification.
// High transparency (~88%) keeps it visible without obscuring candles.
fastPlot = plot(demaFast, display = display.none)
slowPlot = plot(demaSlow, display = display.none)

fill(
     plot1 = fastPlot,
     plot2 = slowPlot,
     color = showFill ? color.new(trendColor, 88) : na,
     title = "DEMA Trend Fill")


// ────────────────────────────────────────────────────────────────────────────
// PLOTTING — SIGNAL MARKERS
// ────────────────────────────────────────────────────────────────────────────

// Bullish crossover — green up-triangle below the bar
plotshape(
     series    = showSignals and longSignal ? demaFast : na,
     title     = "Long Signal",
     style     = shape.triangleup,
     location  = location.belowbar,
     color     = bullColor,
     size      = size.small,
     text      = "Long",
     textcolor = bullColor)

// Bearish crossunder — red down-triangle above the bar
plotshape(
     series    = showSignals and shortSignal ? demaFast : na,
     title     = "Short Signal",
     style     = shape.triangledown,
     location  = location.abovebar,
     color     = bearColor,
     size      = size.small,
     text      = "Short",
     textcolor = bearColor)


// ────────────────────────────────────────────────────────────────────────────
// ALERTS
// ────────────────────────────────────────────────────────────────────────────

// Each alertcondition() creates a selectable alert in TradingView's alert
// dialog. Set the alert to "Once Per Bar Close" for confirmed signals.
//
// For Tradovate webhook automation:
//   1. Create a TradingView alert using one of these conditions
//   2. Set the webhook URL to your Quantvue/Tradovate endpoint
//   3. Replace the alert message with your JSON payload, e.g.:
//      {"action":"buy","symbol":"MNQM2026","qty":1,"orderType":"Market"}

alertcondition(
     condition = longSignal,
     title     = "DEMA Bullish Cross",
     message   = "DEMA Cross Long — MNQ")

alertcondition(
     condition = shortSignal,
     title     = "DEMA Bearish Cross",
     message   = "DEMA Cross Short — MNQ")


// ────────────────────────────────────────────────────────────────────────────
// END OF SCRIPT
// ────────────────────────────────────────────────────────────────────────────
