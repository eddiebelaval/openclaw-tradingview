//@version=5
// 表示名を "Pocket entry S" に設定
indicator("Pocket entry S", shorttitle="Pocket entry S", overlay=true)

// --- パラメーター設定 (L版の黄金比を継承) ---
upper_ma_len   = input.int(80, title="赤線 (上位MA相当) 期間") 
main_ma_len    = input.int(20, title="青線 (1h 20MA) 期間")
lower_ma_len   = input.int(4,  title="白線 (15m 20MA相当) 期間")
// デフォルト設定：0.13%
near_threshold = input.float(0.13, title="青線からの距離閾値 (%)", step=0.01)
// デフォルト設定：0.05%
ma_gap_threshold = input.float(0.05, title="赤青の乖離制限 (%)", step=0.01)

// --- 4時間足の高値切り下げ判定 (売り用) ---
tf_4h_high_current = request.security(syminfo.tickerid, "240", ta.highest(high, 2))
tf_4h_high_prev    = request.security(syminfo.tickerid, "240", high[2])
is_4h_high_down = tf_4h_high_current <= (tf_4h_high_prev * 1.001) // わずかな誤差を許容

// --- 移動平均線の計算 ---
ma_red   = ta.sma(close, upper_ma_len)
ma_blue  = ta.sma(close, main_ma_len)
ma_white = ta.sma(close, lower_ma_len)

// --- 条件判定ロジック (すべて反転) ---

// 1. 移動平均線の位置と距離の判定
ma_gap = math.abs(ma_red - ma_blue) / ma_red * 100
is_perfect_order_s = ma_red > ma_blue  // 売り：赤が上
is_near_cross_s    = ma_red <= ma_blue and ma_gap <= ma_gap_threshold // 逆転収束時

// 2. 赤線の向き (下向きならOK)
is_red_not_up = ma_red <= (ma_red[1] * 1.0001) 
is_trend_down = (is_perfect_order_s or is_near_cross_s) and is_red_not_up and is_4h_high_down

// 3. 距離判定 (青線に近いか、または上から下にぶち抜いたか)
dist_close = math.abs(close - ma_blue) / ma_blue * 100
dist_high  = math.abs(high - ma_blue) / ma_blue * 100
is_break_through_s = open > ma_blue and close < ma_blue
is_near_blue_s = dist_close <= near_threshold or dist_high <= (near_threshold * 0.7) or is_break_through_s

// 4. 実体・更新判定
body_high = math.max(open, close)
body_low  = math.min(open, close)
body_size = body_high - body_low
// 実体の30%以上が青線より下にあること
body_below_blue = math.min(body_high, ma_blue) - body_low
is_min_body_below = (body_below_blue / body_size) >= (is_break_through_s ? 0.1 : 0.3)
is_price_conquer_mas_s = close < ma_white and close < ma_blue

// 【新条件の反転】前実体の安値を下回る (陽線なら始値、陰線なら終値)
prev_body_low = math.min(open[1], close[1])
is_break_prev_body_s = close <= prev_body_low

// --- サイン判定 ---
raw_condition_s = is_trend_down and is_near_blue_s and is_min_body_below and is_price_conquer_mas_s and is_break_prev_body_s and close < open
short_condition = raw_condition_s and not raw_condition_s[1]

// 色の決定：パーフェクトオーダーなら赤、収束ならピンク
sig_color_s = is_perfect_order_s ? color.red : color.rgb(255, 0, 255)

// --- サインの表示 (下向き矢印 ▼) ---
plotchar(short_condition, char="▼", location=location.abovebar, color=sig_color_s, size=size.tiny, title="Pocket entry S")
