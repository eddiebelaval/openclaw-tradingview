// ═══════════════════════════════════════════════════════════════
// VWAP + Standard Deviation Bands
// Anchored VWAP с бандами ±1σ, ±2σ, ±3σ
// ═══════════════════════════════════════════════════════════════
//@version=5
indicator("VWAP Bands", shorttitle="VWAP", overlay=true, max_labels_count=5)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// НАСТРОЙКИ
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
grp1 = "🔧 VWAP"
anchorPeriod = input.string("Session", "Anchor Period", 
     options=["Session", "Week", "Month", "Quarter", "Year"],
     group=grp1)
srcInput     = input.source(hlc3, "Источник", group=grp1)
offsetInput  = input.int(0, "Offset", minval=-500, maxval=500, group=grp1)
grp2 = "📐 Deviation Bands"
showBand1    = input.bool(true, "Показать ±1σ",   group=grp2)
showBand2    = input.bool(true, "Показать ±2σ",   group=grp2)
showBand3    = input.bool(true, "Показать ±3σ",   group=grp2)
mult1        = input.float(1.0, "Множитель Band 1", minval=0.5, maxval=3.0, step=0.1, group=grp2)
mult2        = input.float(2.0, "Множитель Band 2", minval=0.5, maxval=5.0, step=0.1, group=grp2)
mult3        = input.float(3.0, "Множитель Band 3", minval=0.5, maxval=7.0, step=0.1, group=grp2)
grp3 = "🎨 Стиль"
vwapColor    = input.color(#FF6D00, "VWAP линия",       group=grp3)
band1Color   = input.color(#42A5F5, "Band 1 (±1σ)",     group=grp3)
band2Color   = input.color(#AB47BC, "Band 2 (±2σ)",     group=grp3)
band3Color   = input.color(#EF5350, "Band 3 (±3σ)",     group=grp3)
fillBands    = input.bool(true,     "Заливка бандов",    group=grp3)
vwapWidth    = input.int(2,         "Толщина VWAP",      minval=1, maxval=5, group=grp3)
grp4 = "📊 Extras"
showPrevClose = input.bool(false, "Предыдущий VWAP Close", group=grp4)
showLabels    = input.bool(true,  "Метки на бандах",       group=grp4)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ANCHOR DETECTION
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
isNewPeriod = switch anchorPeriod
    "Session"   => ta.change(time("D")) != 0
    "Week"      => ta.change(time("W")) != 0
    "Month"     => ta.change(time("M")) != 0
    "Quarter"   => ta.change(time("3M")) != 0
    "Year"      => ta.change(time("12M")) != 0
    => ta.change(time("D")) != 0
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VWAP CALCULATION
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var float sumPV     = 0.0    // Σ(price × volume)
var float sumVol    = 0.0    // Σ(volume)
var float sumPV2    = 0.0    // Σ(price² × volume) — для StdDev
var float prevVwap  = na     // Предыдущий VWAP close
if isNewPeriod
    prevVwap := sumVol > 0 ? sumPV / sumVol : na
    sumPV    := 0.0
    sumVol   := 0.0
    sumPV2   := 0.0
sumPV  += srcInput * volume
sumVol += volume
sumPV2 += srcInput * srcInput * volume
vwapValue = sumVol > 0 ? sumPV / sumVol : na
// Standard Deviation: sqrt(E[X²] - E[X]²)
variance = sumVol > 0 ? (sumPV2 / sumVol) - (vwapValue * vwapValue) : 0.0
stdev    = math.sqrt(math.max(variance, 0))
// Bands
upper1 = vwapValue + stdev * mult1
lower1 = vwapValue - stdev * mult1
upper2 = vwapValue + stdev * mult2
lower2 = vwapValue - stdev * mult2
upper3 = vwapValue + stdev * mult3
lower3 = vwapValue - stdev * mult3
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PLOTS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VWAP line
vwapPlot = plot(vwapValue, "VWAP", color=vwapColor, linewidth=vwapWidth, offset=offsetInput)
// Band 1 (±1σ)
u1Plot = plot(showBand1 ? upper1 : na, "Upper 1σ", color=color.new(band1Color, 30), linewidth=1, offset=offsetInput)
l1Plot = plot(showBand1 ? lower1 : na, "Lower 1σ", color=color.new(band1Color, 30), linewidth=1, offset=offsetInput)
// Band 2 (±2σ)
u2Plot = plot(showBand2 ? upper2 : na, "Upper 2σ", color=color.new(band2Color, 30), linewidth=1, offset=offsetInput)
l2Plot = plot(showBand2 ? lower2 : na, "Lower 2σ", color=color.new(band2Color, 30), linewidth=1, offset=offsetInput)
// Band 3 (±3σ)
u3Plot = plot(showBand3 ? upper3 : na, "Upper 3σ", color=color.new(band3Color, 30), linewidth=1, offset=offsetInput)
l3Plot = plot(showBand3 ? lower3 : na, "Lower 3σ", color=color.new(band3Color, 30), linewidth=1, offset=offsetInput)
// Previous VWAP Close
plot(showPrevClose and not na(prevVwap) ? prevVwap : na, "Prev VWAP", 
     color=color.new(vwapColor, 60), linewidth=1, style=plot.style_circles, offset=offsetInput)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FILLS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
fill(u1Plot, l1Plot, color=fillBands ? color.new(band1Color, 92) : na, title="Fill ±1σ")
fill(u2Plot, u1Plot, color=fillBands ? color.new(band2Color, 95) : na, title="Fill +1σ to +2σ")
fill(l1Plot, l2Plot, color=fillBands ? color.new(band2Color, 95) : na, title="Fill -1σ to -2σ")
fill(u3Plot, u2Plot, color=fillBands ? color.new(band3Color, 96) : na, title="Fill +2σ to +3σ")
fill(l2Plot, l3Plot, color=fillBands ? color.new(band3Color, 96) : na, title="Fill -2σ to -3σ")
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LABELS (на последнем баре)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if barstate.islast and showLabels
    label.new(bar_index + 3, vwapValue, "VWAP", 
         xloc.bar_index, yloc.price, color=color.new(vwapColor, 50), 
         textcolor=vwapColor, style=label.style_label_left, size=size.small)
    if showBand1
        label.new(bar_index + 3, upper1, "+1σ", 
             xloc.bar_index, yloc.price, color=color.new(band1Color, 80), 
             textcolor=band1Color, style=label.style_label_left, size=size.tiny)
        label.new(bar_index + 3, lower1, "-1σ", 
             xloc.bar_index, yloc.price, color=color.new(band1Color, 80), 
             textcolor=band1Color, style=label.style_label_left, size=size.tiny)
    if showBand2
        label.new(bar_index + 3, upper2, "+2σ", 
             xloc.bar_index, yloc.price, color=color.new(band2Color, 80), 
             textcolor=band2Color, style=label.style_label_left, size=size.tiny)
        label.new(bar_index + 3, lower2, "-2σ", 
             xloc.bar_index, yloc.price, color=color.new(band2Color, 80), 
             textcolor=band2Color, style=label.style_label_left, size=size.tiny)
