//@version=5
indicator("Matrix Trend Engine — GÖKTUĞ ÖZIŞIK | Matrix Trading Lab", shorttitle="Matrix Trend | GÖKTUĞ", overlay=true, max_labels_count=300, max_lines_count=200)

//══════════════════════════════════════════════════════════════════════════════
// INPUTS
//══════════════════════════════════════════════════════════════════════════════
groupTrend = "1. Trend Engine"
groupPull  = "2. Pullback Zone"
groupDash  = "3. Dashboard"
groupAlert = "4. Alerts"

fastLen   = input.int(20, "Fast EMA Length", minval=1, group=groupTrend)
slowLen   = input.int(50, "Slow EMA Length", minval=2, group=groupTrend)
trendLen  = input.int(200, "Trend Filter EMA", minval=10, group=groupTrend)

showTrendFill    = input.bool(true, "Show Trend Fill", group=groupTrend)
showPullbackZone = input.bool(true, "Show Pullback Zone", group=groupPull)
pullbackMode     = input.string("Fast/Slow EMA Zone", "Pullback Zone Type", options=["Fast/Slow EMA Zone", "Fast EMA Only"], group=groupPull)

showDashboard = input.bool(true, "Show Dashboard", group=groupDash)
dashboardPos  = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=groupDash)

enableTrendAlerts    = input.bool(true, "Enable Trend Shift Alerts", group=groupAlert)
enablePullbackAlerts = input.bool(true, "Enable Pullback Entry Alerts", group=groupAlert)

//══════════════════════════════════════════════════════════════════════════════
// COLORS
//══════════════════════════════════════════════════════════════════════════════
bullColor    = #10b981
bearColor    = #ef4444
neutralColor = #9ca3af
panelBg      = color.new(color.black, 15)

bullFill    = color.new(bullColor, 86)
bearFill    = color.new(bearColor, 86)
neutralFill = color.new(neutralColor, 92)

//══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
//══════════════════════════════════════════════════════════════════════════════
BULL = 1
BEAR = -1
NEUTRAL = 0

//══════════════════════════════════════════════════════════════════════════════
// HELPERS
//══════════════════════════════════════════════════════════════════════════════
f_dash_pos(_pos) =>
    _pos == "Top Left" ? position.top_left : _pos == "Bottom Right" ? position.bottom_right : _pos == "Bottom Left" ? position.bottom_left : position.top_right

f_bias_text(_bias) =>
    _bias == BULL ? "Bullish" : _bias == BEAR ? "Bearish" : "Neutral"

f_bias_color(_bias) =>
    _bias == BULL ? bullColor : _bias == BEAR ? bearColor : neutralColor

//══════════════════════════════════════════════════════════════════════════════
// CORE CALCULATIONS
//══════════════════════════════════════════════════════════════════════════════
fastEMA  = ta.ema(close, fastLen)
slowEMA  = ta.ema(close, slowLen)
trendEMA = ta.ema(close, trendLen)

bullTrend = fastEMA > slowEMA and close > trendEMA
bearTrend = fastEMA < slowEMA and close < trendEMA

trendBias = bullTrend ? BULL : bearTrend ? BEAR : NEUTRAL

emaSpread = math.abs(fastEMA - slowEMA)
spreadPct = slowEMA != 0.0 ? (emaSpread / slowEMA) * 100.0 : 0.0

trendStrength =
     spreadPct >= 1.0 ? "Strong" :
     spreadPct >= 0.4 ? "Moderate" :
     spreadPct > 0.0 ? "Weak" : "Flat"

trendStrengthColor =
     spreadPct >= 1.0 ? (bullTrend ? bullColor : bearTrend ? bearColor : neutralColor) :
     spreadPct >= 0.4 ? color.white :
     neutralColor

//══════════════════════════════════════════════════════════════════════════════
// SIGNALS
//══════════════════════════════════════════════════════════════════════════════
bullShift = bullTrend and not bullTrend[1]
bearShift = bearTrend and not bearTrend[1]

bullPullback = bullTrend and low <= fastEMA and close >= fastEMA
bearPullback = bearTrend and high >= fastEMA and close <= fastEMA

//══════════════════════════════════════════════════════════════════════════════
// TREND VISUALS
//══════════════════════════════════════════════════════════════════════════════
pFast = plot(fastEMA, "Fast EMA", color=bullTrend ? bullColor : bearTrend ? bearColor : neutralColor, linewidth=2)
pSlow = plot(slowEMA, "Slow EMA", color=color.new(color.white, 40), linewidth=2)
plot(trendEMA, "Trend Filter EMA", color=color.new(#3b82f6, 0), linewidth=2)

trendFillColor = showTrendFill ? (bullTrend ? bullFill : bearTrend ? bearFill : neutralFill) : color.new(color.white, 100)
fill(pFast, pSlow, color=trendFillColor, title="Trend Fill")

//══════════════════════════════════════════════════════════════════════════════
// PULLBACK ZONE VISUALS
//══════════════════════════════════════════════════════════════════════════════
pullTop = showPullbackZone ? (pullbackMode == "Fast/Slow EMA Zone" ? math.max(fastEMA, slowEMA) : fastEMA) : na
pullBot = showPullbackZone ? (pullbackMode == "Fast/Slow EMA Zone" ? math.min(fastEMA, slowEMA) : fastEMA) : na

pPullTop = plot(pullTop, "Pullback Top", color=color.new(color.yellow, 100), display=display.none)
pPullBot = plot(pullBot, "Pullback Bottom", color=color.new(color.yellow, 100), display=display.none)

pullFillColor = showPullbackZone ? (bullTrend ? color.new(bullColor, 90) : bearTrend ? color.new(bearColor, 90) : color.new(neutralColor, 95)) : color.new(color.white, 100)
fill(pPullTop, pPullBot, color=pullFillColor, title="Pullback Zone")

plotshape(bullShift, title="Bull Trend Shift", style=shape.labelup, location=location.belowbar, color=color.new(color.black, 100), text="Trend Up", textcolor=bullColor, size=size.tiny)
plotshape(bearShift, title="Bear Trend Shift", style=shape.labeldown, location=location.abovebar, color=color.new(color.black, 100), text="Trend Down", textcolor=bearColor, size=size.tiny)

plotshape(bullPullback, title="Bull Pullback", style=shape.circle, location=location.belowbar, color=color.new(bullColor, 0), size=size.tiny)
plotshape(bearPullback, title="Bear Pullback", style=shape.circle, location=location.abovebar, color=color.new(bearColor, 0), size=size.tiny)

//══════════════════════════════════════════════════════════════════════════════
// DASHBOARD
//══════════════════════════════════════════════════════════════════════════════
var table dash = table.new(position.top_right, 2, 7, border_width=1)

if barstate.islast
    table.set_position(dash, f_dash_pos(dashboardPos))

    if showDashboard
        string trendText = f_bias_text(trendBias)
        color trendCol = f_bias_color(trendBias)
        string pullbackText = bullPullback ? "Bullish Touch" : bearPullback ? "Bearish Touch" : "None"
        color pullbackCol = bullPullback ? bullColor : bearPullback ? bearColor : neutralColor

        table.cell(dash, 0, 0, "Matrix Trading Lab", text_color=color.white, bgcolor=color.new(color.black, 0))
        table.cell(dash, 1, 0, "Trend Engine", text_color=color.white, bgcolor=color.new(color.black, 0))

        table.cell(dash, 0, 1, "Trend Bias", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 1, trendText, text_color=trendCol, bgcolor=panelBg)

        table.cell(dash, 0, 2, "Trend Strength", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 2, trendStrength, text_color=trendStrengthColor, bgcolor=panelBg)

        table.cell(dash, 0, 3, "Fast EMA", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 3, str.tostring(fastEMA, format.mintick), text_color=color.white, bgcolor=panelBg)

        table.cell(dash, 0, 4, "Slow EMA", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 4, str.tostring(slowEMA, format.mintick), text_color=color.white, bgcolor=panelBg)

        table.cell(dash, 0, 5, "Trend Filter", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 5, str.tostring(trendEMA, format.mintick), text_color=color.white, bgcolor=panelBg)

        table.cell(dash, 0, 6, "Pullback", text_color=color.white, bgcolor=panelBg)
        table.cell(dash, 1, 6, pullbackText, text_color=pullbackCol, bgcolor=panelBg)
    else
        for r = 0 to 6
            table.cell(dash, 0, r, "", bgcolor=color.new(color.black, 100))
            table.cell(dash, 1, r, "", bgcolor=color.new(color.black, 100))

//══════════════════════════════════════════════════════════════════════════════
// ALERTS
//══════════════════════════════════════════════════════════════════════════════
alertcondition(enableTrendAlerts and bullShift, "Bullish Trend Shift", "Matrix Trend Engine: Bullish trend shift detected")
alertcondition(enableTrendAlerts and bearShift, "Bearish Trend Shift", "Matrix Trend Engine: Bearish trend shift detected")

alertcondition(enablePullbackAlerts and bullPullback, "Bullish Pullback", "Matrix Trend Engine: Bullish pullback into trend zone")
alertcondition(enablePullbackAlerts and bearPullback, "Bearish Pullback", "Matrix Trend Engine: Bearish pullback into trend zone")
