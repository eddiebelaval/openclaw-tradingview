//@version=5
indicator("STEP 2B - SESSION BIAS + EMA", overlay=true)

// ===== TIMEZONE =====
userTZ = input.string("Europe/Amsterdam", "Your Timezone")
flipLevel = input.float(78.6, "Bias Flip Level")

// ===== SESSION TIMES =====
biasHour1 = input.int(3, "Bias 1 Hour")
biasMin1  = input.int(0, "Bias 1 Min")

biasHour2 = input.int(9, "Bias 2 Hour")
biasMin2  = input.int(30, "Bias 2 Min")

biasHour3 = input.int(14, "Bias 3 Hour")
biasMin3  = input.int(0, "Bias 3 Min")

biasHour4 = input.int(18, "Bias 4 Hour")
biasMin4  = input.int(0, "Bias 4 Min")

// ===== TRUE 30M DATA =====
mOpen  = request.security(syminfo.tickerid,"30",open)
mHigh  = request.security(syminfo.tickerid,"30",high)
mLow   = request.security(syminfo.tickerid,"30",low)
mClose = request.security(syminfo.tickerid,"30",close)
mTime  = request.security(syminfo.tickerid,"30",time)

// ===== RANGE =====
rng = mHigh - mLow
rng := rng == 0 ? 0.0001 : rng

bull = mClose > mOpen
bear = mClose < mOpen

csp = bull ? ((mClose - mLow)/rng)*100 :
             ((mHigh - mClose)/rng)*100

is30Close = ta.change(mTime) != 0

// ===== SESSION MATCH =====
h = hour(mTime,userTZ)
m = minute(mTime,userTZ)

t1 = h == biasHour1 and m == biasMin1
t2 = h == biasHour2 and m == biasMin2
t3 = h == biasHour3 and m == biasMin3
t4 = h == biasHour4 and m == biasMin4

sessionTime = t1 or t2 or t3 or t4
biasCheck = is30Close and sessionTime

// ===== BIAS RULES =====
buyBias =
     (bull and csp >= 50 and csp <= flipLevel) or
     (bear and (csp < 50 or csp > flipLevel))

sellBias =
     (bear and csp >= 50 and csp <= flipLevel) or
     (bull and (csp < 50 or csp > flipLevel))

biasDir = buyBias ? 1 : -1

// ===== LIVE SESSION BIAS =====
var int liveBias = na

if biasCheck
    liveBias := biasDir
    label.new(
     bar_index,
     liveBias == 1 ? low-(high-low)*0.25 : high+(high-low)*0.25,
     str.tostring(csp,"#.##")+"%",
     style=liveBias==1?label.style_label_up:label.style_label_down,
     color=liveBias==1?color.green:color.red,
     textcolor=color.white,
     size=size.small)

// ===== EMA / SMA =====
ema = ta.ema(close,7)
sma = ta.sma(ema,7)

plot(ema,color=color.blue)
plot(sma,color=color.orange)

// ===== CROSS AFTER BIAS =====
var bool crossedAfterBias = false

if biasCheck
    crossedAfterBias := false

if liveBias == 1 and ta.crossover(ema,sma)
    crossedAfterBias := true

if liveBias == -1 and ta.crossunder(ema,sma)
    crossedAfterBias := true

// ===== FULL SESSION BLOCKS =====

// ASIA
asiaStart  = timestamp(userTZ, year, month, dayofmonth, biasHour1, biasMin1)
asiaEnd    = timestamp(userTZ, year, month, dayofmonth, biasHour2, biasMin2)

// LONDON
lonStart   = timestamp(userTZ, year, month, dayofmonth, biasHour2, biasMin2)
lonEnd     = timestamp(userTZ, year, month, dayofmonth, biasHour3, biasMin3)

// NEW YORK
nyStart    = timestamp(userTZ, year, month, dayofmonth, biasHour3, biasMin3)
nyEnd      = timestamp(userTZ, year, month, dayofmonth, biasHour4, biasMin4)

// NY CLOSE (loopt door tot middernacht)
nycStart   = timestamp(userTZ, year, month, dayofmonth, biasHour4, biasMin4)
nycEnd     = timestamp(userTZ, year, month, dayofmonth+1, 0, 0)

// SESSION CONDITIONS
inAsia  = time >= asiaStart and time < asiaEnd
inLon   = time >= lonStart  and time < lonEnd
inNY    = time >= nyStart   and time < nyEnd
inNYC   = time >= nycStart  and time < nycEnd

// DRAW BLOCKS
bgcolor(inAsia ? color.new(color.blue,85) : na)
bgcolor(inLon  ? color.new(color.green,85) : na)
bgcolor(inNY   ? color.new(color.orange,85) : na)
bgcolor(inNYC  ? color.new(color.red,85) : na)
