//@version=5
indicator("EMA Cross BB 20 SMA Strategy", overlay=true)

// Define parameters
emaLength = input.int(9, title="EMA Length")
bbLength = 20
bbMult = input.float(2.0, title="Bollinger Bands Multiplier")

// Calculate EMA and 20-period SMA (middle of Bollinger Bands)
emaValue = ta.ema(close, emaLength)
smaValue = ta.sma(close, bbLength)

// Calculate Bollinger Bands (upper and lower)
upperBand = smaValue + bbMult * ta.stdev(close, bbLength)
lowerBand = smaValue - bbMult * ta.stdev(close, bbLength)

// Plot the EMA and the SMA (middle of Bollinger Bands) on the chart
plot(emaValue, color=color.blue, title="EMA", linewidth=2)
plot(smaValue, color=color.orange, title="BB SMA 20", linewidth=2)

// Plot the upper and lower Bollinger Bands
plot(upperBand, color=color.red, title="Upper Bollinger Band", linewidth=1, style=plot.style_line)
plot(lowerBand, color=color.red, title="Lower Bollinger Band", linewidth=1, style=plot.style_line)

// Generate Buy/Sell signals based on EMA crossovers with the SMA
buySignal = ta.crossover(emaValue, smaValue)  // EMA crosses above SMA (Buy Signal)
sellSignal = ta.crossunder(emaValue, smaValue)  // EMA crosses below SMA (Sell Signal)

// Plot shapes (arrows) for Buy/Sell signals
plotshape(buySignal, location=location.belowbar, color=color.green, style=shape.labelup, text="BUY", title="Buy Signal")
plotshape(sellSignal, location=location.abovebar, color=color.red, style=shape.labeldown, text="SELL", title="Sell Signal")

// Add labels for Buy/Sell signals
if (buySignal)
    label.new(bar_index, low, "BUY", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.small)
if (sellSignal)
    label.new(bar_index, high, "SELL", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)
