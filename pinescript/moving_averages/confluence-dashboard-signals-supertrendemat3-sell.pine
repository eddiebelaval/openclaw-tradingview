//@version=5
indicator("Confluence Dashboard + Signals (Supertrend+EMA+T3 Sell)", overlay=true, max_labels_count=500)

// ===== INPUTS =====
showRSI = input.bool(true, "Show RSI", group="Components")
showMACD = input.bool(true, "Show MACD", group="Components")
showSupertrend = input.bool(true, "Show Supertrend", group="Components")
showT3 = input.bool(true, "Show Tilson T3", group="Components")
showEMAs = input.bool(true, "Show EMA Ribbon", group="Components")
showSignal = input.bool(true, "Show Buy/Sell Signal", group="Components")

// ===== RSI =====
rsiLength = input.int(14, "RSI Length")
rsi = ta.rsi(close, rsiLength)
rsiBull = rsi > 50

// ===== MACD =====
fastMA = input.int(12, "MACD Fast")
slowMA = input.int(26, "MACD Slow")
signalLength = input.int(9, "MACD Signal")
[macdLine, macdSignal, macdHist] = ta.macd(close, fastMA, slowMA, signalLength)
macdBull = macdLine > 0

// ===== Supertrend (your corrected version) =====
Periods = input.int(10, title="Supertrend ATR Period")
srcST = input(hl2, title="Supertrend Source")
Multiplier = input.float(3.0, "Supertrend Multiplier", step=0.1)

atrST = ta.atr(Periods)
upST = srcST - Multiplier * atrST
dnST = srcST + Multiplier * atrST

var float supertrend = na
var int direction = 1
up1 = nz(upST[1], upST)
dn1 = nz(dnST[1], dnST)

if bar_index == 0
    supertrend := close
    direction := 1
else
    direction := direction == -1 and close > dn1 ? 1 : direction == 1 and close < up1 ? -1 : direction
    supertrend := direction == 1 ? math.max(upST, nz(supertrend[1], upST)) : math.min(dnST, nz(supertrend[1], dnST))

superBull = direction == 1
superBear = direction == -1

// ===== Tilson T3 (manual) =====
t3Length = input.int(4, "T3 Length")
vFactor = input.float(0.7, "T3 Volume Factor")
f_t3(_src, _len, _vFactor) =>
    e1 = ta.ema(_src, _len)
    e2 = ta.ema(e1, _len)
    e3 = ta.ema(e2, _len)
    e4 = ta.ema(e3, _len)
    e5 = ta.ema(e4, _len)
    e6 = ta.ema(e5, _len)
    c1 = -_vFactor*_vFactor*_vFactor
    c2 = 3*_vFactor*_vFactor + 3*_vFactor*_vFactor*_vFactor
    c3 = -6*_vFactor*_vFactor - 3*_vFactor - 3*_vFactor*_vFactor*_vFactor
    c4 = 1 + 3*_vFactor + _vFactor*_vFactor*_vFactor + 3*_vFactor*_vFactor
    c1*e6 + c2*e5 + c3*e4 + c4*e3

t3 = f_t3(close, t3Length, vFactor)
t3SlopeUp = t3 > t3[1]

// ===== EMA Ribbon =====
ema1 = ta.ema(close, 5)
ema2 = ta.ema(close, 8)
ema3 = ta.ema(close, 13)
emaBull = ema1 > ema2 and ema2 > ema3
emaBear = ema1 < ema2 and ema2 < ema3

// ===== CONDITIONS =====
// Buy: All aligned
allBull = rsiBull and macdBull and superBull and t3SlopeUp and emaBull
// Sell: Supertrend bearish + T3 down + EMA ribbon bearish
allBear = superBear and t3SlopeUp == false and emaBear

// ===== DASHBOARD PANEL =====
var label dash = label.new(x=bar_index, y=high, text="", style=label.style_label_left, color=color.new(color.black, 0), textcolor=color.white, size=size.small)
dashboardText = ""
if showRSI
    dashboardText += "RSI: " + str.tostring(rsi, "#.0") + (rsiBull ? " ↑" : " ↓") + "\n"
if showMACD
    dashboardText += "MACD: " + str.tostring(macdLine, "#.00") + (macdBull ? " ↑" : " ↓") + "\n"
if showSupertrend
    dashboardText += "Supertrend: " + (superBull ? "Bullish ↑" : "Bearish ↓") + "\n"
if showT3
    dashboardText += "T3 Slope: " + (t3SlopeUp ? "Up ↑" : "Down ↓") + "\n"
if showEMAs
    dashboardText += "EMA Ribbon: " + (emaBull ? "Bull ↑" : emaBear ? "Bear ↓" : "Neutral") + "\n"
if showSignal
    dashboardText += "Signal: " + (allBull ? "BUY ✅" : allBear ? "SELL ❌" : "Neutral") + "\n"

label.set_xy(dash, bar_index, high)
label.set_text(dash, dashboardText)
label.set_style(dash, label.style_label_left)
label.set_color(dash, color.new(color.black, 0))
label.set_textcolor(dash, color.white)

// ===== PLOT ARROWS =====
plotshape(allBull, title="Buy Arrow", location=location.belowbar, color=color.lime, style=shape.triangleup, size=size.small)
plotshape(allBear, title="Sell Arrow", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)

// ===== ALERTS =====
alertcondition(allBull, title="Buy Signal", message="All indicators aligned → BUY")
alertcondition(allBear, title="Sell Signal", message="Supertrend bearish + T3 down + EMA ribbon bearish → SELL")
