//@version=6
indicator("Standalone MA Crossover Matrix & Ticker", overlay=true)

// =========================================================================
// ========================== 1. INPUTS & LENGTHS ==========================
// =========================================================================
grp_len = "MA Lengths"
len1  = input.int(9,   title="Level 1 (Fast)",   group=grp_len)
len2  = input.int(21,  title="Level 2 (Short)",  group=grp_len)
len3  = input.int(50,  title="Level 3 (Medium)", group=grp_len)
len4  = input.int(100, title="Level 4 (Long)",   group=grp_len)
len5  = input.int(200, title="Level 5 (Macro)",  group=grp_len)

grp_tbl = "Table Settings"
matrix_pos_inp  = input.string("Middle Right", "Matrix Position", options=["Top Right", "Middle Right", "Bottom Right", "Top Left", "Middle Left", "Bottom Left", "Top Center", "Middle Center", "Bottom Center"], group=grp_tbl)
matrix_size_inp = input.string("Normal", "Matrix Text Size", options=["Auto", "Tiny", "Small", "Normal", "Large", "Huge"], group=grp_tbl)

ticker_pos_inp  = input.string("Bottom Right", "Ticker Position", options=["Top Right", "Middle Right", "Bottom Right", "Top Left", "Middle Left", "Bottom Left", "Top Center", "Middle Center", "Bottom Center"], group=grp_tbl)
ticker_size_inp = input.string("Normal", "Ticker Text Size", options=["Auto", "Tiny", "Small", "Normal", "Large", "Huge"], group=grp_tbl)

// =========================================================================
// ========================== 2. FUNCTIONS =================================
// =========================================================================
f_tema(src, len) =>
    ema1 = ta.ema(src, len)
    ema2 = ta.ema(ema1, len)
    ema3 = ta.ema(ema2, len)
    3 * (ema1 - ema2) + ema3

get_pos(pos_str) =>
    switch pos_str
        "Top Right" => position.top_right
        "Middle Right" => position.middle_right
        "Bottom Right" => position.bottom_right
        "Top Left" => position.top_left
        "Middle Left" => position.middle_left
        "Bottom Left" => position.bottom_left
        "Top Center" => position.top_center
        "Middle Center" => position.middle_center
        "Bottom Center" => position.bottom_center
        => position.middle_right

get_size(size_str) =>
    switch size_str
        "Auto" => size.auto
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.normal

matrix_pos  = get_pos(matrix_pos_inp)
matrix_size = get_size(matrix_size_inp)
ticker_pos  = get_pos(ticker_pos_inp)
ticker_size = get_size(ticker_size_inp)

// =========================================================================
// ========================== 3. CALCULATIONS ==============================
// =========================================================================
src = close

// EMA
ema1 = ta.ema(src, len1)
ema2 = ta.ema(src, len2)
ema3 = ta.ema(src, len3)
ema4 = ta.ema(src, len4)
ema5 = ta.ema(src, len5)

// WMA
wma1 = ta.wma(src, len1)
wma2 = ta.wma(src, len2)
wma3 = ta.wma(src, len3)
wma4 = ta.wma(src, len4)
wma5 = ta.wma(src, len5)

// SMA
sma1 = ta.sma(src, len1)
sma2 = ta.sma(src, len2)
sma3 = ta.sma(src, len3)
sma4 = ta.sma(src, len4)
sma5 = ta.sma(src, len5)

// VWAP (VWMA)
vwap1 = ta.vwma(src, len1)
vwap2 = ta.vwma(src, len2)
vwap3 = ta.vwma(src, len3)
vwap4 = ta.vwma(src, len4)
vwap5 = ta.vwma(src, len5)

// TEMA
tema1 = f_tema(src, len1)
tema2 = f_tema(src, len2)
tema3 = f_tema(src, len3)
tema4 = f_tema(src, len4)
tema5 = f_tema(src, len5)


// =========================================================================
// ===================== 4. RECENT CROSSOVER TICKER ========================
// =========================================================================
var string[] ticker_pairs   = array.new_string(3, "---")
var string[] ticker_signals = array.new_string(3, "---")
var color[]  ticker_colors  = array.new_color(3, color.gray)

add_ticker_event(string pair_name, string sig_text, color bg_col) =>
    array.unshift(ticker_pairs, pair_name)
    array.pop(ticker_pairs)
    array.unshift(ticker_signals, sig_text)
    array.pop(ticker_signals)
    array.unshift(ticker_colors, bg_col)
    array.pop(ticker_colors)

check_cross(float fast, float slow, string name) =>
    if ta.crossover(fast, slow)
        add_ticker_event(name, "🟩 Golden Cross", color.new(color.green, 40))
    if ta.crossunder(fast, slow)
        add_ticker_event(name, "🟥 Death Cross", color.new(color.red, 40))

// Track all 20 pairs
check_cross(ema1, ema2, str.tostring(len1) + " / " + str.tostring(len2) + " EMA")
check_cross(ema2, ema3, str.tostring(len2) + " / " + str.tostring(len3) + " EMA")
check_cross(ema3, ema4, str.tostring(len3) + " / " + str.tostring(len4) + " EMA")
check_cross(ema4, ema5, str.tostring(len4) + " / " + str.tostring(len5) + " EMA")

check_cross(wma1, wma2, str.tostring(len1) + " / " + str.tostring(len2) + " WMA")
check_cross(wma2, wma3, str.tostring(len2) + " / " + str.tostring(len3) + " WMA")
check_cross(wma3, wma4, str.tostring(len3) + " / " + str.tostring(len4) + " WMA")
check_cross(wma4, wma5, str.tostring(len4) + " / " + str.tostring(len5) + " WMA")

check_cross(sma1, sma2, str.tostring(len1) + " / " + str.tostring(len2) + " SMA")
check_cross(sma2, sma3, str.tostring(len2) + " / " + str.tostring(len3) + " SMA")
check_cross(sma3, sma4, str.tostring(len3) + " / " + str.tostring(len4) + " SMA")
check_cross(sma4, sma5, str.tostring(len4) + " / " + str.tostring(len5) + " SMA")

check_cross(vwap1, vwap2, str.tostring(len1) + " / " + str.tostring(len2) + " VWAP")
check_cross(vwap2, vwap3, str.tostring(len2) + " / " + str.tostring(len3) + " VWAP")
check_cross(vwap3, vwap4, str.tostring(len3) + " / " + str.tostring(len4) + " VWAP")
check_cross(vwap4, vwap5, str.tostring(len4) + " / " + str.tostring(len5) + " VWAP")

check_cross(tema1, tema2, str.tostring(len1) + " / " + str.tostring(len2) + " TEMA")
check_cross(tema2, tema3, str.tostring(len2) + " / " + str.tostring(len3) + " TEMA")
check_cross(tema3, tema4, str.tostring(len3) + " / " + str.tostring(len4) + " TEMA")
check_cross(tema4, tema5, str.tostring(len4) + " / " + str.tostring(len5) + " TEMA")


// =========================================================================
// ========================= 5. TABLE DRAWING ==============================
// =========================================================================

// Table 1: Confluence Matrix
var table cross_matrix = table.new(matrix_pos, 5, 6, border_width=1, border_color=color.gray)

get_cross_col(float fast, float slow) =>
    fast > slow ? color.new(color.green, 40) : color.new(color.red, 40)
    
get_cross_txt(float fast, float slow) =>
    fast > slow ? "Bull" : "Bear"

fill_cross_cell(table tb, int col, int row, float fast, float slow) =>
    table.cell(tb, col, row, get_cross_txt(fast, slow), bgcolor=get_cross_col(fast, slow), text_color=color.black, text_size=matrix_size)

if barstate.islast
    // Matrix Headers
    table.cell(cross_matrix, 0, 0, "Type", bgcolor=color.black, text_color=color.white, text_size=matrix_size)
    table.cell(cross_matrix, 1, 0, str.tostring(len1)+"/"+str.tostring(len2), bgcolor=color.black, text_color=color.white, text_size=matrix_size)
    table.cell(cross_matrix, 2, 0, str.tostring(len2)+"/"+str.tostring(len3), bgcolor=color.black, text_color=color.white, text_size=matrix_size)
    table.cell(cross_matrix, 3, 0, str.tostring(len3)+"/"+str.tostring(len4), bgcolor=color.black, text_color=color.white, text_size=matrix_size)
    table.cell(cross_matrix, 4, 0, str.tostring(len4)+"/"+str.tostring(len5), bgcolor=color.black, text_color=color.white, text_size=matrix_size)
        
    // EMA Row
    table.cell(cross_matrix, 0, 1, "EMA", bgcolor=color.gray, text_color=color.white, text_size=matrix_size)
    fill_cross_cell(cross_matrix, 1, 1, ema1, ema2)
    fill_cross_cell(cross_matrix, 2, 1, ema2, ema3)
    fill_cross_cell(cross_matrix, 3, 1, ema3, ema4)
    fill_cross_cell(cross_matrix, 4, 1, ema4, ema5)
        
    // WMA Row
    table.cell(cross_matrix, 0, 2, "WMA", bgcolor=color.gray, text_color=color.white, text_size=matrix_size)
    fill_cross_cell(cross_matrix, 1, 2, wma1, wma2)
    fill_cross_cell(cross_matrix, 2, 2, wma2, wma3)
    fill_cross_cell(cross_matrix, 3, 2, wma3, wma4)
    fill_cross_cell(cross_matrix, 4, 2, wma4, wma5)
        
    // SMA Row
    table.cell(cross_matrix, 0, 3, "SMA", bgcolor=color.gray, text_color=color.white, text_size=matrix_size)
    fill_cross_cell(cross_matrix, 1, 3, sma1, sma2)
    fill_cross_cell(cross_matrix, 2, 3, sma2, sma3)
    fill_cross_cell(cross_matrix, 3, 3, sma3, sma4)
    fill_cross_cell(cross_matrix, 4, 3, sma4, sma5)

    // VWAP Row
    table.cell(cross_matrix, 0, 4, "VWAP", bgcolor=color.gray, text_color=color.white, text_size=matrix_size)
    fill_cross_cell(cross_matrix, 1, 4, vwap1, vwap2)
    fill_cross_cell(cross_matrix, 2, 4, vwap2, vwap3)
    fill_cross_cell(cross_matrix, 3, 4, vwap3, vwap4)
    fill_cross_cell(cross_matrix, 4, 4, vwap4, vwap5)

    // TEMA Row
    table.cell(cross_matrix, 0, 5, "TEMA", bgcolor=color.gray, text_color=color.white, text_size=matrix_size)
    fill_cross_cell(cross_matrix, 1, 5, tema1, tema2)
    fill_cross_cell(cross_matrix, 2, 5, tema2, tema3)
    fill_cross_cell(cross_matrix, 3, 5, tema3, tema4)
    fill_cross_cell(cross_matrix, 4, 5, tema4, tema5)


// Table 2: Recent Signals Ticker
var table ticker_table = table.new(ticker_pos, 2, 4, border_width=1, border_color=color.gray)

if barstate.islast
    // Ticker Headers
    table.cell(ticker_table, 0, 0, "Latest Signals", bgcolor=color.black, text_color=color.white, text_size=ticker_size)
    table.cell(ticker_table, 1, 0, "Type", bgcolor=color.black, text_color=color.white, text_size=ticker_size)
        
    // Ticker Rows
    for i = 0 to 2
        table.cell(ticker_table, 0, i + 1, array.get(ticker_pairs, i), bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=ticker_size)
        table.cell(ticker_table, 1, i + 1, array.get(ticker_signals, i), bgcolor=array.get(ticker_colors, i), text_color=color.black, text_size=ticker_size)

// =========================================================================
// ========================= 6. CHART VISUALS (DOTS) =======================
// =========================================================================

// EMA 9/21
plotshape(ta.crossover(ema1, ema2) ? ema1 : na, title="EMA 9/21 Bull", style=shape.circle, location=location.absolute, color=color.new(color.green, 0), size=size.tiny)
plotshape(ta.crossunder(ema1, ema2) ? ema1 : na, title="EMA 9/21 Bear", style=shape.circle, location=location.absolute, color=color.new(color.red, 0), size=size.tiny)

// EMA 21/50
plotshape(ta.crossover(ema2, ema3) ? ema2 : na, title="EMA 21/50 Bull", style=shape.circle, location=location.absolute, color=color.new(color.green, 0), size=size.tiny)
plotshape(ta.crossunder(ema2, ema3) ? ema2 : na, title="EMA 21/50 Bear", style=shape.circle, location=location.absolute, color=color.new(color.red, 0), size=size.tiny)

// EMA 50/100
plotshape(ta.crossover(ema3, ema4) ? ema3 : na, title="EMA 50/100 Bull", style=shape.circle, location=location.absolute, color=color.new(color.green, 0), size=size.tiny)
plotshape(ta.crossunder(ema3, ema4) ? ema3 : na, title="EMA 50/100 Bear", style=shape.circle, location=location.absolute, color=color.new(color.red, 0), size=size.tiny)

// EMA 100/200
plotshape(ta.crossover(ema4, ema5) ? ema4 : na, title="EMA 100/200 Bull", style=shape.circle, location=location.absolute, color=color.new(color.green, 0), size=size.tiny)
plotshape(ta.crossunder(ema4, ema5) ? ema4 : na, title="EMA 100/200 Bear", style=shape.circle, location=location.absolute, color=color.new(color.red, 0), size=size.tiny)
