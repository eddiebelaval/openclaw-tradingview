//@version=6
indicator("EMA with Horizontal Lines on Scale", shorttitle="EMA Scale Lines", 
         overlay=true, explicit_plot_zorder=true)

// === Входные параметры ===
showEma6 = input.bool(true, "EMA 6")
showEma12 = input.bool(true, "EMA 12")
showEma33 = input.bool(true, "EMA 33")
showEma66 = input.bool(true, "EMA 66")
showEma111 = input.bool(true, "EMA 111")
showEma222 = input.bool(true, "EMA 222")
showEma333 = input.bool(true, "EMA 333")
showEma666 = input.bool(true, "EMA 666")
showEma1332 = input.bool(true, "EMA 1332")
showEma1665 = input.bool(true, "EMA 1665")

// === Настройки отображения ===
lineStyle = input.string("Solid", "Тип линий EMA", options=["Solid", "Dotted", "Dashed", "Arrow Left", "Arrow Right"])
lineWidth = input.int(1, "Толщина линий", minval=1, maxval=4)

// === Настройки текста ===
textColor = input.color(color.white, "Цвет текста")
textSize = input.string("Small", "Размер текста", options=["Tiny", "Small", "Normal", "Large"])
bgTransparency = input.int(70, "Прозрачность фона %", minval=0, maxval=90)
showLabels = input.bool(true, "Показывать подписи на линиях")
showTable = input.bool(true, "Показывать таблицу значений")

// === Преобразование стиля линии ===
getLineStyle() =>
    if lineStyle == "Solid"
        line.style_solid
    else if lineStyle == "Dotted"
        line.style_dotted
    else if lineStyle == "Dashed"
        line.style_dashed
    else if lineStyle == "Arrow Left"
        line.style_arrow_left
    else if lineStyle == "Arrow Right"
        line.style_arrow_right
    else
        line.style_solid

// === Получение размера шрифта ===
getTextSize() =>
    if textSize == "Tiny"
        size.tiny
    else if textSize == "Small"
        size.small
    else if textSize == "Normal"
        size.normal
    else
        size.large

// === Расчет EMA ===
ema6 = ta.ema(close, 6)
ema12 = ta.ema(close, 12)
ema33 = ta.ema(close, 33)
ema66 = ta.ema(close, 66)
ema111 = ta.ema(close, 111)
ema222 = ta.ema(close, 222)
ema333 = ta.ema(close, 333)
ema666 = ta.ema(close, 666)
ema1332 = ta.ema(close, 1332)
ema1665 = ta.ema(close, 1665)

// === Форматирование цены ===
formatPrice(price) =>
    str.tostring(price, format.mintick)

// === Функция для создания двух блоков на линии (близко друг к другу) ===
createTwoLabelsOnLine(x, linePrice, emaName, price, bgColor) =>
    sz = getTextSize()
    // Маленькое смещение между блоками
    offset = 
      sz == size.tiny ? 12 :
      sz == size.small ? 15 :
      sz == size.normal ? 18 : 22
    
    // Первый блок - название EMA
    label.new(x, linePrice, 
              text=emaName, 
              color=color.new(bgColor, bgTransparency), 
              textcolor=textColor, 
              size=sz, 
              style=label.style_label_center, 
              xloc=xloc.bar_index, 
              yloc=yloc.price,
              textalign=text.align_center)
    
    // Второй блок - цена (с небольшим смещением вправо)
    label.new(x + offset, linePrice, 
              text=formatPrice(price), 
              color=color.new(bgColor, bgTransparency), 
              textcolor=textColor, 
              size=sz, 
              style=label.style_label_center, 
              xloc=xloc.bar_index, 
              yloc=yloc.price,
              textalign=text.align_center)

// === Отрисовка линий EMA поверх свечей ===
plot(showEma6 ? ema6 : na, "EMA 6", color.new(color.blue, 0), linewidth=lineWidth, display=display.pane)
plot(showEma12 ? ema12 : na, "EMA 12", color.new(color.yellow, 0), linewidth=lineWidth, display=display.pane)
plot(showEma33 ? ema33 : na, "EMA 33", color.new(color.green, 0), linewidth=lineWidth, display=display.pane)
plot(showEma66 ? ema66 : na, "EMA 66", color.new(color.lime, 0), linewidth=lineWidth, display=display.pane)
plot(showEma111 ? ema111 : na, "EMA 111", color.new(color.orange, 0), linewidth=lineWidth+1, display=display.pane)
plot(showEma222 ? ema222 : na, "EMA 222", color.new(color.red, 0), linewidth=lineWidth+1, display=display.pane)
plot(showEma333 ? ema333 : na, "EMA 333", color.new(color.maroon, 0), linewidth=lineWidth+1, display=display.pane)
plot(showEma666 ? ema666 : na, "EMA 666", color.new(color.purple, 0), linewidth=lineWidth+2, display=display.pane)
plot(showEma1332 ? ema1332 : na, "EMA 1332", color.new(color.fuchsia, 0), linewidth=lineWidth+2, display=display.pane)
plot(showEma1665 ? ema1665 : na, "EMA 1665", color.new(color.navy, 0), linewidth=lineWidth+3, display=display.pane)

// === Горизонтальные линии с подписями ===
if barstate.islast
    style = getLineStyle()
    
    // EMA 6
    if showEma6
        line.new(bar_index, ema6, bar_index + 100, ema6, 
                 xloc=xloc.bar_index, extend=extend.right, 
                 color=color.new(color.blue, 0), style=style, width=lineWidth)
        if showLabels
            createTwoLabelsOnLine(bar_index + 85, ema6, "EMA6", ema6, color.blue)
    
    // EMA 12
    if showEma12
        line.new(bar_index, ema12, bar_index + 100, ema12, 
                 xloc=xloc.bar_index, extend=extend.right, 
                 color=color.new(color.yellow, 0), style=style, width=lineWidth)
        if showLabels
            createTwoLabelsOnLine(bar_index + 85, ema12, "EMA12", ema12, color.yellow)
    
    // EMA 33
    if showEma33
        line.new(bar_index, ema33, bar_index + 100, ema33, 
                 xloc=xloc.bar_index, extend=extend.right, 
                 color=color.new(color.green, 0), style=style, width=lineWidth)
        if showLabels
            createTwoLabelsOnLine(bar_index + 85, ema33, "EMA33", ema33, color.green)
    
    // EMA 66
    if showEma66
        line.new(bar_index, ema66, bar_index + 100, ema66, 
                 xloc=xloc.bar_index, extend=extend.right, 
                 color=color.new(color.lime, 0), style=style, width=lineWidth)
        if showLabels
            createTwoLabelsOnLine(bar_index + 85, ema66, "EMA66", ema66, color.lime)
    
    // EMA 111
    if showEma111
        line.new(bar_index, ema111, bar_index + 100, ema111, 
                 xloc=xloc.bar_index, extend=extend.right, 
                 color=color.new(color.orange, 0), style=style, width=lineWidth+1)
        if showLabels
            createTwoLabelsOnLine(bar_index + 85, ema111, "EMA111", ema111, color.orange)
    
    // EMA 222
    if showEma222
        line.new(bar_index, ema222, bar_index + 100, ema222, 
                 xloc=xloc.bar_index, extend=extend.right, 
                 color=color.new(color.red, 0), style=style, width=lineWidth+1)
        if showLabels
            createTwoLabelsOnLine(bar_index + 85, ema222, "EMA222", ema222, color.red)
    
    // EMA 333
    if showEma333
        line.new(bar_index, ema333, bar_index + 100, ema333, 
                 xloc=xloc.bar_index, extend=extend.right, 
                 color=color.new(color.maroon, 0), style=style, width=lineWidth+1)
        if showLabels
            createTwoLabelsOnLine(bar_index + 85, ema333, "EMA333", ema333, color.maroon)
    
    // EMA 666
    if showEma666
        line.new(bar_index, ema666, bar_index + 100, ema666, 
                 xloc=xloc.bar_index, extend=extend.right, 
                 color=color.new(color.purple, 0), style=style, width=lineWidth+2)
        if showLabels
            createTwoLabelsOnLine(bar_index + 85, ema666, "EMA666", ema666, color.purple)
    
    // EMA 1332
    if showEma1332
        line.new(bar_index, ema1332, bar_index + 100, ema1332, 
                 xloc=xloc.bar_index, extend=extend.right, 
                 color=color.new(color.fuchsia, 0), style=style, width=lineWidth+2)
        if showLabels
            createTwoLabelsOnLine(bar_index + 85, ema1332, "EMA1332", ema1332, color.fuchsia)
    
    // EMA 1665
    if showEma1665
        line.new(bar_index, ema1665, bar_index + 100, ema1665, 
                 xloc=xloc.bar_index, extend=extend.right, 
                 color=color.new(color.navy, 0), style=style, width=lineWidth+3)
        if showLabels
            createTwoLabelsOnLine(bar_index + 85, ema1665, "EMA1665", ema1665, color.navy)

// === Таблица со значениями EMA ===
if showTable and barstate.islast
    var table emaTable = table.new(position.top_right, 2, 12, 
                                   bgcolor=color.new(color.black, 80),
                                   border_color=color.white, border_width=1)
    
    table.cell(emaTable, 0, 0, "EMA", text_color=color.white, bgcolor=color.new(color.blue, 50))
    table.cell(emaTable, 1, 0, "Value", text_color=color.white, bgcolor=color.new(color.blue, 50))
    
    row = 1
    if showEma6
        table.cell(emaTable, 0, row, "EMA 6", text_color=color.blue)
        table.cell(emaTable, 1, row, formatPrice(ema6), text_color=color.blue)
        row := row + 1
    if showEma12
        table.cell(emaTable, 0, row, "EMA 12", text_color=color.yellow)
        table.cell(emaTable, 1, row, formatPrice(ema12), text_color=color.yellow)
        row := row + 1
    if showEma33
        table.cell(emaTable, 0, row, "EMA 33", text_color=color.green)
        table.cell(emaTable, 1, row, formatPrice(ema33), text_color=color.green)
        row := row + 1
    if showEma66
        table.cell(emaTable, 0, row, "EMA 66", text_color=color.lime)
        table.cell(emaTable, 1, row, formatPrice(ema66), text_color=color.lime)
        row := row + 1
    if showEma111
        table.cell(emaTable, 0, row, "EMA 111", text_color=color.orange)
        table.cell(emaTable, 1, row, formatPrice(ema111), text_color=color.orange)
        row := row + 1
    if showEma222
        table.cell(emaTable, 0, row, "EMA 222", text_color=color.red)
        table.cell(emaTable, 1, row, formatPrice(ema222), text_color=color.red)
        row := row + 1
    if showEma333
        table.cell(emaTable, 0, row, "EMA 333", text_color=color.maroon)
        table.cell(emaTable, 1, row, formatPrice(ema333), text_color=color.maroon)
        row := row + 1
    if showEma666
        table.cell(emaTable, 0, row, "EMA 666", text_color=color.purple)
        table.cell(emaTable, 1, row, formatPrice(ema666), text_color=color.purple)
        row := row + 1
    if showEma1332
        table.cell(emaTable, 0, row, "EMA 1332", text_color=color.fuchsia)
        table.cell(emaTable, 1, row, formatPrice(ema1332), text_color=color.fuchsia)
        row := row + 1
    if showEma1665
        table.cell(emaTable, 0, row, "EMA 1665", text_color=color.navy)
        table.cell(emaTable, 1, row, formatPrice(ema1665), text_color=color.navy)
