//@version=5
indicator("Estrategia Triple EMA - Soporte Dinámico", overlay=true)

// Configuración de las EMAs
len1 = input.int(20, minval=1, title="EMA Rápida (Momentum)")
len2 = input.int(50, minval=1, title="EMA Media (Zona de Valor)")
len3 = input.int(200, minval=1, title="EMA Lenta (Tendencia)")

src = close

ema1 = ta.ema(src, len1)
ema2 = ta.ema(src, len2)
ema3 = ta.ema(src, len3)

// Colores para diferenciar
plot(ema1, color=color.new(color.yellow, 0), title="EMA 20", linewidth=1)
plot(ema2, color=color.new(color.orange, 0), title="EMA 50", linewidth=2)
plot(ema3, color=color.new(color.blue, 0), title="EMA 200", linewidth=3)

// Señal visual de toque (Solo ayuda visual)
toque_ema50 = low <= ema2 and high >= ema2
plotshape(toque_ema50, style=shape.circle, location=location.belowbar, color=color.white, size=size.tiny, title="Toque EMA 50")
