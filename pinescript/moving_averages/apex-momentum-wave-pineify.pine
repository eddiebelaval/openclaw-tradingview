//@version=6
// Apex Momentum Wave (AMW) — A momentum oscillator that applies RSI to an HMA-smoothed price,
// paired with an EMA signal line, to generate cleaner momentum readings and crossover-based
// buy/sell signals filtered by the oscillator's position relative to the 50 midline.
indicator("Apex Momentum Wave [Pineify]", shorttitle="AMW[Pineify]", overlay=false)

// ============================================================================
// INPUT SETTINGS
// ============================================================================

// --- Main Oscillator Parameters ---
grp_main = "Main Oscillator Settings"
// RSI lookback period — controls the sensitivity of the momentum oscillator.
// Shorter values react faster to price changes; longer values produce smoother readings.
length   = input.int(14, title="Momentum Length", group=grp_main)
// Hull Moving Average period applied to the close price before feeding it into RSI.
// HMA reduces lag compared to SMA/EMA, effectively pre-filtering market noise
// so the RSI output is less jittery.
smooth   = input.int(7, title="Price Smoothing (HMA)", tooltip="Higher values reduce noise but add slight lag.", group=grp_main)
// EMA period for the signal line that trails the oscillator.
// Crossovers between the oscillator and this signal line generate trade entries.
sigLen   = input.int(9, title="Signal Line Length", group=grp_main)

// --- Overbought / Oversold Thresholds ---
grp_zones = "Overbought / Oversold Zones"
// RSI-based oscillator ranges 0–100; these levels define the extreme zones.
obLevel   = input.int(80, title="Overbought Level", group=grp_zones)
osLevel   = input.int(20, title="Oversold Level", group=grp_zones)

// --- Visual Customization ---
grp_style = "Colors & Aesthetics"
bullCol   = input.color(#089981, title="Bullish Color", group=grp_style)
bearCol   = input.color(#f23645, title="Bearish Color", group=grp_style)
sigCol    = input.color(#ffb74d, title="Signal Line Color", group=grp_style)

// ============================================================================
// CALCULATIONS
// ============================================================================

// Step 1: Apply Hull Moving Average to the close price.
// HMA uses weighted moving averages and a square-root period internally,
// producing a smooth curve with minimal lag — acting as a zero-lag-like filter.
smooth_price = ta.hma(close, smooth)

// Step 2: Compute RSI on the HMA-smoothed price instead of raw close.
// This two-stage approach (smooth first, then measure momentum) yields a
// momentum oscillator that retains responsiveness while filtering out
// short-term noise spikes that cause false RSI signals on raw price.
oscillator = ta.rsi(smooth_price, length)

// Step 3: Derive a signal line by applying an EMA to the oscillator.
// The signal line acts as a moving reference; crossovers between the
// oscillator and signal line indicate momentum shifts.
signal = ta.ema(oscillator, sigLen)

// ============================================================================
// PLOTTING & VISUALS
// ============================================================================

// Dynamic coloring: bullish when the oscillator leads above the signal, bearish otherwise.
osc_color = oscillator > signal ? bullCol : bearCol

// Main oscillator and signal line plots
p_osc = plot(oscillator, title="Apex Wave", color=osc_color, linewidth=2)
p_sig = plot(signal, title="Signal Line", color=sigCol, linewidth=1)

// Cloud fill between oscillator and signal — visually highlights the momentum spread.
// Bullish (green) when oscillator > signal; bearish (red) when below.
fill(p_osc, p_sig, color = oscillator > signal ? color.new(bullCol, 75) : color.new(bearCol, 75), title="Wave Fill")

// Horizontal reference levels: overbought (80), midline (50), oversold (20)
p_ob  = plot(obLevel, title="Overbought", color=color.new(bearCol, 50), style=plot.style_line)
p_mid = plot(50, title="Midline", color=color.new(color.gray, 70), style=plot.style_line)
p_os  = plot(osLevel, title="Oversold", color=color.new(bullCol, 50), style=plot.style_line)

// Hidden boundary plots at 0 and 100 used solely as fill anchors
// to shade the extreme zones with a subtle background tint.
p_top = plot(100, display=display.none)
p_bot = plot(0, display=display.none)
fill(p_ob, p_top, color=color.new(bearCol, 90), title="OB Zone Background")
fill(p_os, p_bot, color=color.new(bullCol, 90), title="OS Zone Background")

// When the oscillator breaches into the overbought or oversold zone,
// an additional fill highlights the breach area with stronger coloring,
// drawing immediate attention to extreme momentum conditions.
fill(p_osc, p_ob, color = oscillator > obLevel ? color.new(bearCol, 60) : na, title="Overbought Breach")
fill(p_osc, p_os, color = oscillator < osLevel ? color.new(bullCol, 60) : na, title="Oversold Breach")

// ============================================================================
// TRADING SIGNALS (BUY / SELL)
// ============================================================================

// BUY condition: oscillator crosses above the signal line AND is below the 50 midline.
// The midline filter ensures we only buy when momentum is turning up from a
// relatively weak/oversold state, avoiding late entries in already-strong moves.
buyCond = ta.crossover(oscillator, signal) and oscillator < 50

// SELL condition: oscillator crosses below the signal line AND is above the 50 midline.
// Mirror logic — only sell when momentum is turning down from a relatively
// strong/overbought state, filtering out noise in already-weak markets.
sellCond = ta.crossunder(oscillator, signal) and oscillator > 50

// Visual markers: up-triangles at the bottom for buys, down-triangles at the top for sells
plotshape(buyCond, title="Buy Signal", style=shape.triangleup, location=location.bottom, color=bullCol, size=size.small)
plotshape(sellCond, title="Sell Signal", style=shape.triangledown, location=location.top, color=bearCol, size=size.small)

// ============================================================================
// ALERTS
// ============================================================================
// Configurable alert conditions so traders can receive notifications
// without keeping the chart open.
alertcondition(buyCond, title="AMW Buy Signal", message="Apex Momentum Wave: BUY Signal Detected!")
alertcondition(sellCond, title="AMW Sell Signal", message="Apex Momentum Wave: SELL Signal Detected!")
