//@version=6
indicator("Multi-Timeframe Strength Scanner [JOAT]", shorttitle="MTS [JOAT]", format=format.price)

// ═══════════════════════════════════════════════════════════════════════════════
// MULTI-TIMEFRAME STRENGTH SCANNER
// Advanced ADX/DMI scanner across 6 timeframes with trend analysis
// ═══════════════════════════════════════════════════════════════════════════════

// ────────────────────────────────────────────────────────────────────────────────
// INPUTS
// ────────────────────────────────────────────────────────────────────────────────

// ADX Settings
adxGroup = "ADX Settings"
adxLength = input.int(14, "ADX Length", minval=1, group=adxGroup)
adxSmoothing = input.int(14, "ADX Smoothing", minval=1, group=adxGroup)
adxThreshold = input.int(20, "ADX Threshold", minval=10, maxval=50, group=adxGroup)

// Trend Settings
trendGroup = "Trend Settings"
trendLength = input.int(20, "Trend Length", minval=5, group=trendGroup)
showTrendDuration = input.bool(true, "Show Trend Duration", group=trendGroup)

// Display Settings
displayGroup = "Display Settings"
showTable = input.bool(true, "Show MTF Table", group=displayGroup)
tablePosition = input.string("middle_right", "Table Position", 
                             options=["top_right", "top_left", "middle_right", "middle_left", "bottom_right", "bottom_left"], 
                             group=displayGroup)

// ────────────────────────────────────────────────────────────────────────────────
// COLOR DEFINITIONS
// ────────────────────────────────────────────────────────────────────────────────

strongBullColor = color.rgb(12, 238, 19)
weakBullColor = color.rgb(132, 252, 136)
strongBearColor = color.rgb(255, 1, 1)
weakBearColor = color.rgb(250, 144, 144)
neutralColor = color.rgb(141, 141, 139)
vwapBullColor = color.rgb(12, 238, 19)
vwapBearColor = color.rgb(255, 1, 1)

// ────────────────────────────────────────────────────────────────────────────────
// RIVERFLOW TREND SYSTEM WITH ENHANCED ANALYTICS
// ────────────────────────────────────────────────────────────────────────────────

riverflow() =>
    lower = ta.lowest(trendLength)
    upper = ta.highest(trendLength)
    basis = math.avg(upper, lower)
    
    int trend = 0
    trend := close > upper[1] ? 1 : close < lower[1] ? -1 : nz(trend[1])
    
    trendColor = trend == 1 ? strongBullColor : trend == -1 ? strongBearColor : neutralColor
    
    // Calculate bars since trend change
    var int donTimeCounter = 0
    if ta.change(trend) != 0
        donTimeCounter := 0
    else
        donTimeCounter += 1
    donTime = donTimeCounter
    
    [plus, minus, adx] = ta.dmi(adxLength, adxSmoothing)
    
    // Calculate bars since DI cross
    var int adxTimeCounter = 0
    if ta.cross(plus, minus)
        adxTimeCounter := 0
    else
        adxTimeCounter += 1
    adxTime = adxTimeCounter
    
    adxCol = adx > adxThreshold and plus > minus ? strongBullColor : adx > adxThreshold and plus < minus ? strongBearColor : neutralColor
    
    adxSignal = plus > minus and plus > adxThreshold ? strongBullColor : plus > minus and plus < adxThreshold ? weakBullColor : plus < minus and minus > adxThreshold ? strongBearColor : plus < minus and minus < adxThreshold ? weakBearColor : neutralColor
    
    vwapColor = close > ta.ema(close, 200) ? vwapBullColor : vwapBearColor
    
    // Enhanced Trend Strength Score (0-100)
    trendStrength = (adx / 100) * 100
    trendMomentum = plus > minus ? (plus - minus) : (minus - plus)
    
    // Simplified Divergence Detection
    rsiDivBull = false
    rsiDivBear = false
    
    [vwapColor, trendColor, donTime, adx, adxSignal, adxTime, adxCol, trendStrength, trendMomentum, rsiDivBull, rsiDivBear]

// ────────────────────────────────────────────────────────────────────────────────
// CURRENT TIMEFRAME ADX
// ────────────────────────────────────────────────────────────────────────────────

[plus, minus, adx] = ta.dmi(adxLength, adxSmoothing)

// Plot ADX
adxPlot = plot(adx, "ADX", color.new(color.gray, 30), 2, plot.style_area)
thresholdPlot = plot(adxThreshold, "Threshold", plus > minus ? strongBullColor : strongBearColor, 3)

plusPlot = plot(plus, "+DI", strongBullColor, 2)
minusPlot = plot(minus, "-DI", strongBearColor, 2)

zeroPlot = plot(0, "Zero", color.new(color.white, 100))

// Warning zone
warningHigh = plot(adxThreshold + 5, "Warning High", adx > adxThreshold ? na : color.new(color.yellow, 0), 1)
warningLow = plot(adxThreshold - 5, "Warning Low", adx > adxThreshold ? na : color.new(color.yellow, 0), 1)
fill(warningHigh, warningLow, adx > adxThreshold ? na : color.new(color.yellow, 85))

// Fill between threshold and +DI
fill(thresholdPlot, plusPlot, plus > minus ? color.new(strongBullColor, 80) : color.new(strongBearColor, 80))

// ────────────────────────────────────────────────────────────────────────────────
// MULTI-TIMEFRAME DATA COLLECTION WITH ENHANCED METRICS
// ────────────────────────────────────────────────────────────────────────────────

[vwapColor1, trendColor1, donTime1, adx1, adxSignal1, adxTime1, adxCol1, strength1, momentum1, divBull1, divBear1] = request.security(syminfo.tickerid, '5', riverflow())
[vwapColor2, trendColor2, donTime2, adx2, adxSignal2, adxTime2, adxCol2, strength2, momentum2, divBull2, divBear2] = request.security(syminfo.tickerid, '15', riverflow())
[vwapColor3, trendColor3, donTime3, adx3, adxSignal3, adxTime3, adxCol3, strength3, momentum3, divBull3, divBear3] = request.security(syminfo.tickerid, '30', riverflow())
[vwapColor4, trendColor4, donTime4, adx4, adxSignal4, adxTime4, adxCol4, strength4, momentum4, divBull4, divBear4] = request.security(syminfo.tickerid, '60', riverflow())
[vwapColor5, trendColor5, donTime5, adx5, adxSignal5, adxTime5, adxCol5, strength5, momentum5, divBull5, divBear5] = request.security(syminfo.tickerid, '240', riverflow())
[vwapColor6, trendColor6, donTime6, adx6, adxSignal6, adxTime6, adxCol6, strength6, momentum6, divBull6, divBear6] = request.security(syminfo.tickerid, '1D', riverflow())

// ────────────────────────────────────────────────────────────────────────────────
// MTF TABLE
// ────────────────────────────────────────────────────────────────────────────────

var string tblPos = switch tablePosition
    "top_right" => position.top_right
    "top_left" => position.top_left
    "middle_right" => position.middle_right
    "middle_left" => position.middle_left
    "bottom_right" => position.bottom_right
    "bottom_left" => position.bottom_left
    => position.middle_right

var table mtfTable = table.new(tblPos, 5, 8, 
                                bgcolor=color.new(color.black, 90), 
                                frame_color=color.new(color.gray, 60), 
                                frame_width=2, 
                                border_width=1, 
                                border_color=color.new(color.gray, 70))

if showTable and barstate.islast
    // Header Row
    table.cell(mtfTable, 0, 0, "TF", bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=size.normal)
    table.cell(mtfTable, 1, 0, "VWAP", bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=size.normal)
    table.cell(mtfTable, 2, 0, "Trend", bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=size.normal)
    table.cell(mtfTable, 3, 0, "ADX", bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=size.normal)
    table.cell(mtfTable, 4, 0, "Cross", bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=size.normal)
    
    // 5M Row
    table.cell(mtfTable, 0, 1, "5M", bgcolor=vwapColor1, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 1, "●", bgcolor=vwapColor1, text_color=color.white, text_size=size.normal)
    table.cell(mtfTable, 2, 1, str.tostring(donTime1), bgcolor=trendColor1, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 1, str.tostring(adx1, '#.#'), bgcolor=adxCol1, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 4, 1, str.tostring(adxTime1), bgcolor=adxSignal1, text_color=color.white, text_size=size.small)
    
    // 15M Row
    table.cell(mtfTable, 0, 2, "15M", bgcolor=vwapColor2, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 2, "●", bgcolor=vwapColor2, text_color=color.white, text_size=size.normal)
    table.cell(mtfTable, 2, 2, str.tostring(donTime2), bgcolor=trendColor2, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 2, str.tostring(adx2, '#.#'), bgcolor=adxCol2, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 4, 2, str.tostring(adxTime2), bgcolor=adxSignal2, text_color=color.white, text_size=size.small)
    
    // 30M Row
    table.cell(mtfTable, 0, 3, "30M", bgcolor=vwapColor3, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 3, "●", bgcolor=vwapColor3, text_color=color.white, text_size=size.normal)
    table.cell(mtfTable, 2, 3, str.tostring(donTime3), bgcolor=trendColor3, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 3, str.tostring(adx3, '#.#'), bgcolor=adxCol3, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 4, 3, str.tostring(adxTime3), bgcolor=adxSignal3, text_color=color.white, text_size=size.small)
    
    // 1H Row
    table.cell(mtfTable, 0, 4, "1H", bgcolor=vwapColor4, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 4, "●", bgcolor=vwapColor4, text_color=color.white, text_size=size.normal)
    table.cell(mtfTable, 2, 4, str.tostring(donTime4), bgcolor=trendColor4, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 4, str.tostring(adx4, '#.#'), bgcolor=adxCol4, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 4, 4, str.tostring(adxTime4), bgcolor=adxSignal4, text_color=color.white, text_size=size.small)
    
    // 4H Row
    table.cell(mtfTable, 0, 5, "4H", bgcolor=vwapColor5, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 5, "●", bgcolor=vwapColor5, text_color=color.white, text_size=size.normal)
    table.cell(mtfTable, 2, 5, str.tostring(donTime5), bgcolor=trendColor5, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 5, str.tostring(adx5, '#.#'), bgcolor=adxCol5, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 4, 5, str.tostring(adxTime5), bgcolor=adxSignal5, text_color=color.white, text_size=size.small)
    
    // Daily Row
    table.cell(mtfTable, 0, 6, "1D", bgcolor=vwapColor6, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 6, "●", bgcolor=vwapColor6, text_color=color.white, text_size=size.normal)
    table.cell(mtfTable, 2, 6, str.tostring(donTime6), bgcolor=trendColor6, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 6, str.tostring(adx6, '#.#'), bgcolor=adxCol6, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 4, 6, str.tostring(adxTime6), bgcolor=adxSignal6, text_color=color.white, text_size=size.small)
    
    // Alignment Score
    bullishCount = (vwapColor1 == vwapBullColor ? 1 : 0) + (vwapColor2 == vwapBullColor ? 1 : 0) + 
                   (vwapColor3 == vwapBullColor ? 1 : 0) + (vwapColor4 == vwapBullColor ? 1 : 0) + 
                   (vwapColor5 == vwapBullColor ? 1 : 0) + (vwapColor6 == vwapBullColor ? 1 : 0)
    
    alignmentText = bullishCount >= 5 ? "STRONG BULL" : bullishCount >= 4 ? "BULL" : bullishCount <= 1 ? "STRONG BEAR" : bullishCount <= 2 ? "BEAR" : "NEUTRAL"
    
    alignmentColor = bullishCount >= 5 ? color.new(strongBullColor, 30) : bullishCount >= 4 ? color.new(weakBullColor, 30) : bullishCount <= 1 ? color.new(strongBearColor, 30) : bullishCount <= 2 ? color.new(weakBearColor, 30) : color.new(neutralColor, 30)
    
    table.cell(mtfTable, 0, 7, "Alignment", bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 7, alignmentText, bgcolor=alignmentColor, text_color=color.white, text_size=size.small)
    table.merge_cells(mtfTable, 1, 7, 4, 7)

// ────────────────────────────────────────────────────────────────────────────────
// TREND STRENGTH VISUALIZATION
// ────────────────────────────────────────────────────────────────────────────────

// Calculate overall trend strength score
overallStrength = (strength1 + strength2 + strength3 + strength4 + strength5 + strength6) / 6
overallMomentum = (momentum1 + momentum2 + momentum3 + momentum4 + momentum5 + momentum6) / 6

// Gradient coloring based on strength
strengthColor = overallStrength >= 75 ? color.from_gradient(overallStrength, 75, 100, weakBullColor, strongBullColor) : overallStrength >= 50 ? color.from_gradient(overallStrength, 50, 75, neutralColor, weakBullColor) : overallStrength >= 25 ? color.from_gradient(overallStrength, 25, 50, weakBearColor, neutralColor) : color.from_gradient(overallStrength, 0, 25, strongBearColor, weakBearColor)

// Plot strength as histogram
plot(overallStrength, "Overall Strength", strengthColor, 2, plot.style_histogram)
hline(50, "Neutral", color.new(neutralColor, 50), hline.style_dotted)
hline(75, "Strong", color.new(strongBullColor, 70), hline.style_dashed)
hline(25, "Weak", color.new(strongBearColor, 70), hline.style_dashed)

// Divergence signals across timeframes
anyBullDiv = divBull1 or divBull2 or divBull3 or divBull4 or divBull5 or divBull6
anyBearDiv = divBear1 or divBear2 or divBear3 or divBear4 or divBear5 or divBear6

plotshape(anyBullDiv ? 10 : na, "MTF Bull Divergence", shape.triangleup, location.absolute, 
         color.new(strongBullColor, 0), size=size.small, text="DIV")
plotshape(anyBearDiv ? 90 : na, "MTF Bear Divergence", shape.triangledown, location.absolute, 
         color.new(strongBearColor, 0), size=size.small, text="DIV")

// ────────────────────────────────────────────────────────────────────────────────
// ALERTS
// ────────────────────────────────────────────────────────────────────────────────

alertcondition(adx > adxThreshold and plus > minus, "Strong Bullish Trend", "ADX above threshold with bullish momentum")
alertcondition(adx > adxThreshold and minus > plus, "Strong Bearish Trend", "ADX above threshold with bearish momentum")
alertcondition(ta.crossover(plus, minus), "+DI Crossed Above -DI", "Bullish momentum shift")
alertcondition(ta.crossunder(plus, minus), "+DI Crossed Below -DI", "Bearish momentum shift")
alertcondition(anyBullDiv, "MTF Bullish Divergence", "Bullish divergence detected across timeframes")
alertcondition(anyBearDiv, "MTF Bearish Divergence", "Bearish divergence detected across timeframes")
alertcondition(overallStrength > 75 and overallStrength[1] <= 75, "Strong Trend Confirmed", "Overall strength crossed above 75")
alertcondition(overallStrength < 25 and overallStrength[1] >= 25, "Weak Trend Confirmed", "Overall strength crossed below 25")
