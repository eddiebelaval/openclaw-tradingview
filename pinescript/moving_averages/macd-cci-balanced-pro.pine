//@version=6
indicator("MACD + CCI Balanced Pro", overlay=false)

//================ MACD SETTINGS =================//

sourceInput  = input.source(close, "MACD Source")
fastLenInput = input.int(12, "MACD Fast Length")
slowLenInput = input.int(26, "MACD Slow Length")
sigLenInput  = input.int(9, "MACD Signal Length")
normLength   = input.int(200, "MACD Normalization Length")

oscType = input.string("EMA","MACD Oscillator MA",["EMA","SMA"])
sigType = input.string("EMA","MACD Signal MA",["EMA","SMA"])

//================ MA FUNCTION =================//

ma(source, length, type) =>
    type == "EMA" ? ta.ema(source, length) : ta.sma(source, length)

//================ MACD CALCULATION =================//

maFast = ma(sourceInput, fastLenInput, oscType)
maSlow = ma(sourceInput, slowLenInput, oscType)

macd_raw   = maFast - maSlow
signal_raw = ma(macd_raw, sigLenInput, sigType)

macdMax = ta.highest(math.abs(macd_raw), normLength)

macd   = macd_raw   / macdMax * 300
signal = signal_raw / macdMax * 300
hist   = macd - signal

hColor = hist >= 0 ? (hist > hist[1] ? #26a69a : #b2dfdb) : (hist > hist[1] ? #ffcdd2 : #ff5252)

plot(hist, "MACD Histogram", hColor, style=plot.style_columns)
plot(macd, "MACD Line", color=color.blue, linewidth=2)
plot(signal, "Signal Line", color=color.orange, linewidth=2)

//================ CCI =================//

length = input.int(20, "CCI Length")
src = input(hlc3, "CCI Source")

maCCI = ta.sma(src, length)
cci = (src - maCCI) / (0.015 * ta.dev(src, length))

cciColor = cci > 100 ? color.lime : cci < -100 ? color.red : color.orange

plot(cci, "CCI", color=cciColor, linewidth=2)

//================ LEVELS =================//

hline(300, "300", color=color.red)
hline(200, "200", color=color.red)
hline(100, "100", color=color.gray)

hline(0, "0", color=color.white)

hline(-100, "-100", color=color.gray)
hline(-200, "-200", color=color.green)
hline(-300, "-300", color=color.green)
