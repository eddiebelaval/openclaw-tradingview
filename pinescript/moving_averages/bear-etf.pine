//@version=5
indicator("BEAR ETF", overlay=true)

// Define the Moving Averages (Simple Moving Averages)
ma10 = ta.sma(close, 10)
ma20 = ta.sma(close, 20)
ma50 = ta.sma(close, 50)
ma200 = ta.sma(close, 200)

// Plot the Moving Averages
plot(ma10, color=color.blue, title="10 MA")
plot(ma20, color=color.green, title="20 MA")
plot(ma50, color=color.orange, title="50 MA")
plot(ma200, color=color.red, title="200 MA")

// Check slopes are negative (current MA < previous MA)
slope10_neg = ma10 < ma10[1]
slope20_neg = ma20 < ma20[1]
slope50_neg = ma50 < ma50[1]

// Removed slope check for 200 MA

// Check price below 10, 20, 50 MAs
price_below_key = close < ma10 and close < ma20 and close < ma50

// Check the stacking conditions for 10 and 20 below 50
ma10_below_50 = ma10 < ma50


// Overall bearish condition
bearish_condition = price_below_key and ma10_below_50 and slope10_neg and slope20_neg and slope50_neg

// Detect the entry into the bearish condition (first bar where it's true)
bearish_signal = bearish_condition and not bearish_condition[1]

// Plot a shape only on the signal bar for alerts
plotshape(series=bearish_signal, title="Bearish Entry Signal", location=location.belowbar, color=color.red, style=shape.labeldown, text="BEAR", textcolor=color.white)
