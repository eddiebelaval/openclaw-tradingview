//@version=6
indicator("V38 Clean ORB Manual (2/day, no spam)", overlay=true, max_labels_count=50)

// ===== Inputs =====
tz          = input.string("America/New_York", "Timezone")
showEMAs    = input.bool(true,  "Show EMAs")
showORB     = input.bool(true,  "Show ORB")
showPivots  = input.bool(false, "Show Pivots")
showSignals = input.bool(true,  "Show Signals (max 2/day)")

// ===== Time (NY) =====
nyH   = hour(time, tz)
nyM   = minute(time, tz)
mod   = nyH * 60 + nyM

ENTRY_START = 9 * 60 + 30
ENTRY_END   = 13 * 60

inWindow     = mod >= ENTRY_START and mod <= ENTRY_END
minsFromOpen = mod - ENTRY_START

// New day (NY calendar day)
nyDate = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
newDay = nyDate != nyDate[1]

// ===== Daily trade counter =====
var int tradesToday = 0
if newDay
    tradesToday := 0

canSignal = tradesToday < 2

// ===== EMAs =====
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)

longTrend  = ema20 > ema50
shortTrend = ema20 < ema50

plot(showEMAs ? ema20 : na, "EMA 20", linewidth=2)
plot(showEMAs ? ema50 : na, "EMA 50", linewidth=2)

// ===== ORB 5/10/15 (from 09:30 NY) =====
var float orb5H  = na
var float orb5L  = na
var float orb10H = na
var float orb10L = na
var float orb15H = na
var float orb15L = na

if newDay
    orb5H  := na
    orb5L  := na
    orb10H := na
    orb10L := na
    orb15H := na
    orb15L := na

inORB5  = minsFromOpen >= 0 and minsFromOpen <= 4
inORB10 = minsFromOpen >= 0 and minsFromOpen <= 9
inORB15 = minsFromOpen >= 0 and minsFromOpen <= 14

if inORB5
    orb5H := na(orb5H) ? high : math.max(orb5H, high)
    orb5L := na(orb5L) ? low  : math.min(orb5L, low)

if inORB10
    orb10H := na(orb10H) ? high : math.max(orb10H, high)
    orb10L := na(orb10L) ? low  : math.min(orb10L, low)

if inORB15
    orb15H := na(orb15H) ? high : math.max(orb15H, high)
    orb15L := na(orb15L) ? low  : math.min(orb15L, low)

plot(showORB ? orb5H  : na, "ORB5 High",  style=plot.style_linebr, linewidth=1)
plot(showORB ? orb5L  : na, "ORB5 Low",   style=plot.style_linebr, linewidth=1)
plot(showORB ? orb10H : na, "ORB10 High", style=plot.style_linebr, linewidth=1)
plot(showORB ? orb10L : na, "ORB10 Low",  style=plot.style_linebr, linewidth=1)
plot(showORB ? orb15H : na, "ORB15 High", style=plot.style_linebr, linewidth=2)
plot(showORB ? orb15L : na, "ORB15 Low",  style=plot.style_linebr, linewidth=2)

// ===== Swing Pivots (optional) =====
pH = ta.pivothigh(high, 2, 2)
pL = ta.pivotlow(low, 2, 2)

plotshape(showPivots and not na(pH), title="Swing High", style=shape.triangledown, location=location.abovebar, size=size.tiny, offset=-2, text="SH")
plotshape(showPivots and not na(pL), title="Swing Low",  style=shape.triangleup,   location=location.belowbar, size=size.tiny, offset=-2, text="SL")

// ===== Breakouts (raw) =====
longBreak =
     (not na(orb5H)  and close > orb5H)  or
     (not na(orb10H) and close > orb10H) or
     (not na(orb15H) and close > orb15H)

shortBreak =
     (not na(orb5L)  and close < orb5L)  or
     (not na(orb10L) and close < orb10L) or
     (not na(orb15L) and close < orb15L)

// ===== "First bar only" anti-spam =====
// Only trigger when breakout becomes true this bar (was false last bar).
longBreakEvent  = longBreak  and not longBreak[1]
shortBreakEvent = shortBreak and not shortBreak[1]

// ===== Final signals (max 2/day) =====
longSignal  = showSignals and inWindow and canSignal and longTrend  and longBreakEvent
shortSignal = showSignals and inWindow and canSignal and shortTrend and shortBreakEvent

// If both happen (rare), ignore.
finalLong  = longSignal and not shortSignal
finalShort = shortSignal and not longSignal

if finalLong or finalShort
    tradesToday += 1

// Clean markers (NOT boxes)
plotshape(finalLong,  title="LONG",  style=shape.triangleup,   location=location.belowbar, size=size.small, text="L")
plotshape(finalShort, title="SHORT", style=shape.triangledown, location=location.abovebar, size=size.small, text="S")

// Optional alerts
alertcondition(finalLong,  "V38 LONG",  "V38 LONG: first ORB break + EMA alignment (max 2/day)")
alertcondition(finalShort, "V38 SHORT", "V38 SHORT: first ORB break + EMA alignment (max 2/day)")
