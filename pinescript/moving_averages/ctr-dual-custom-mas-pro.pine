//@version=6
indicator("CTR Dual Custom MAs Pro", overlay=true, max_labels_count=500, max_lines_count=20)

// =====================================================
// GLOBAL BIAS
// =====================================================
globalBias = input.string("Neutral", "CTR Global Bias", options=["Bearish","Neutral","Bullish"])

// =====================================================
// MA SETTINGS
// =====================================================
fastLen  = input.int(21, "Fast MA Length", minval=1)
slowLen  = input.int(50, "Slow MA Length", minval=1)

fastType = input.string("EMA", "Fast MA Type", options=["EMA","SMA","WMA","VWMA","RMA"])
slowType = input.string("EMA", "Slow MA Type", options=["EMA","SMA","WMA","VWMA","RMA"])

fastTF   = input.timeframe("", "Fast MA Timeframe (blank = chart)")
slowTF   = input.timeframe("", "Slow MA Timeframe (blank = chart)")

// =====================================================
// MA FUNCTION
// =====================================================
f_ma(_type, _src, _len) =>
    float _out = na
    if _type == "EMA"
        _out := ta.ema(_src, _len)
    if _type == "SMA"
        _out := ta.sma(_src, _len)
    if _type == "WMA"
        _out := ta.wma(_src, _len)
    if _type == "VWMA"
        _out := ta.vwma(_src, _len)
    if _type == "RMA"
        _out := ta.rma(_src, _len)
    _out

// =====================================================
// TIMEFRAME RESOLUTION
// =====================================================
fastTF_use = fastTF == "" ? timeframe.period : fastTF
slowTF_use = slowTF == "" ? timeframe.period : slowTF

// =====================================================
// MULTI-TIMEFRAME MAs
// =====================================================
fastMA = request.security(syminfo.tickerid, fastTF_use,
    f_ma(fastType, close, fastLen),
    barmerge.gaps_off, barmerge.lookahead_off)

slowMA = request.security(syminfo.tickerid, slowTF_use,
    f_ma(slowType, close, slowLen),
    barmerge.gaps_off, barmerge.lookahead_off)

// =====================================================
// MA COLORS & FILL
// =====================================================
fastMAColor = input.color(color.green, "Fast MA Color")
slowMAColor = input.color(color.red, "Slow MA Color")

pFast = plot(fastMA, color=fastMAColor, linewidth=2)
pSlow = plot(slowMA, color=slowMAColor, linewidth=2)

showFill = input.bool(true, "Show MA Fill")
bullFillColor = input.color(color.new(color.green,80), "Bullish Fill Color")
bearFillColor = input.color(color.new(color.red,80), "Bearish Fill Color")

fill(pFast, pSlow, color = showFill ? (fastMA > slowMA ? bullFillColor : bearFillColor) : na)

// =====================================================
// REGIME BAR COLORING
// =====================================================
showRegimeBars = input.bool(false, "Color Bars Above / Below Both MAs")
regimeBullColor = input.color(color.new(color.green, 0), "Regime Bullish Bar Color")
regimeBearColor = input.color(color.new(color.red, 0), "Regime Bearish Bar Color")

aboveBoth = close > fastMA and close > slowMA
belowBoth = close < fastMA and close < slowMA

// =====================================================
// CONTINUATION FILTER
// =====================================================
enableContFilter = input.bool(true, "Enable Continuation Filter")
contN = input.int(2, "Continuation Confirmation Candles (N)", minval=0, maxval=20)

// =====================================================
// PULLBACK TYPE TOGGLES
// =====================================================
useWickTouch       = input.bool(true, "Pullback: Wick Touch FAST MA")
useBodyStraddle    = input.bool(true, "Pullback: Body Straddles FAST MA")
useBodyCloseBeyond = input.bool(true, "Pullback: Body Closes Beyond FAST MA")

// =====================================================
// DIRECTIONAL PB COLORS
// =====================================================
bullFirstPBColor = input.color(color.yellow, "Bullish FIRST PB Color")
bullMultiPBColor = input.color(color.orange, "Bullish MULTIPLE PB Color")
bearFirstPBColor = input.color(color.yellow, "Bearish FIRST PB Color")
bearMultiPBColor = input.color(color.orange, "Bearish MULTIPLE PB Color")

// =====================================================
// PB LABEL CONTROLS
// =====================================================
showPBLabels = input.bool(true, "Show PB Labels")
pbOffsetATR  = input.float(0.5, "PB Label Distance (ATR Multiplier)", minval=0)

atrVal = ta.atr(14)

// =====================================================
// GLOBAL BIAS PERMISSION
// =====================================================
allowBull = globalBias != "Bearish"
allowBear = globalBias != "Bullish"

// =====================================================
// STATE
// =====================================================
var bool bullActive = false
var bool bearActive = false
var int bullPB = 0
var int bearPB = 0
var int bullSepCount = 0
var int bearSepCount = 0

// =====================================================
// MA CROSSES RESET
// =====================================================
if ta.crossover(fastMA, slowMA)
    bullActive := true
    bearActive := false
    bullPB := 0
    bullSepCount := 0

if ta.crossunder(fastMA, slowMA)
    bearActive := true
    bullActive := false
    bearPB := 0
    bearSepCount := 0

// =====================================================
// CONTINUATION COUNT (CLOSE-ONLY)
// =====================================================
if bullActive
    bullSepCount := close > fastMA ? bullSepCount + 1 : 0

if bearActive
    bearSepCount := close < fastMA ? bearSepCount + 1 : 0

// =====================================================
// PULLBACK CONDITIONS
// =====================================================
bullPullbackCond = bullActive and allowBull and (
    (useWickTouch and low <= fastMA) or
    (useBodyStraddle and open > fastMA and close < fastMA) or
    (useBodyCloseBeyond and open < fastMA and close < fastMA)
)

bearPullbackCond = bearActive and allowBear and (
    (useWickTouch and high >= fastMA) or
    (useBodyStraddle and open < fastMA and close > fastMA) or
    (useBodyCloseBeyond and open > fastMA and close > fastMA)
)

// =====================================================
// PB PERMISSION (PRIOR BAR)
// =====================================================
bullPBAllowed = bullPB == 0 or not enableContFilter or bullSepCount[1] >= contN
bearPBAllowed = bearPB == 0 or not enableContFilter or bearSepCount[1] >= contN

// =====================================================
// BAR COLOR PRIORITY
// =====================================================
color barCol = na

if bullPullbackCond and bullPBAllowed
    bullPB += 1
    bullSepCount := 0
    barCol := bullPB == 1 ? bullFirstPBColor : bullMultiPBColor

if bearPullbackCond and bearPBAllowed
    bearPB += 1
    bearSepCount := 0
    barCol := bearPB == 1 ? bearFirstPBColor : bearMultiPBColor

if na(barCol) and showRegimeBars
    if aboveBoth
        barCol := regimeBullColor
    if belowBoth
        barCol := regimeBearColor

barcolor(barCol)

// =====================================================
// PB LABELS
// =====================================================
if showPBLabels and bullPullbackCond and bullPBAllowed
    label.new(bar_index, low - atrVal * pbOffsetATR, "PB" + str.tostring(bullPB),
        style=label.style_label_up, color=barCol, textcolor=color.black)

if showPBLabels and bearPullbackCond and bearPBAllowed
    label.new(bar_index, high + atrVal * pbOffsetATR, "PB" + str.tostring(bearPB),
        style=label.style_label_down, color=barCol, textcolor=color.black)

// =====================================================
// ALERTS
// =====================================================
alertcondition(bullPullbackCond and bullPBAllowed and bullPB == 1,
    "FIRST Bullish Pullback", "CTR FIRST Bullish Pullback")

alertcondition(bullPullbackCond and bullPBAllowed and bullPB > 1,
    "CONTINUATION Bullish Pullback", "CTR CONTINUATION Bullish Pullback")

alertcondition(bearPullbackCond and bearPBAllowed and bearPB == 1,
    "FIRST Bearish Pullback", "CTR FIRST Bearish Pullback")

alertcondition(bearPullbackCond and bearPBAllowed and bearPB > 1,
    "CONTINUATION Bearish Pullback", "CTR CONTINUATION Bearish Pullback")

// =====================================================
// MA PROJECTION LINES (PHASE 6)
// =====================================================
showProjection = input.bool(false, "Show MA Projections")
projBars       = input.int(5, "Projection Bars Forward", minval=1, maxval=20)
projLookback   = input.int(5, "Projection Slope Lookback", minval=1)

fastProjColor  = input.color(color.green, "Fast MA Projection Color")
slowProjColor  = input.color(color.red, "Slow MA Projection Color")

var line fastProjLine = na
var line slowProjLine = na

if showProjection
    float fastSlope = (fastMA - fastMA[projLookback]) / projLookback
    float slowSlope = (slowMA - slowMA[projLookback]) / projLookback

    if not na(fastProjLine)
        line.delete(fastProjLine)
    if not na(slowProjLine)
        line.delete(slowProjLine)

    fastProjLine := line.new(
        bar_index, fastMA,
        bar_index + projBars, fastMA + fastSlope * projBars,
        color=fastProjColor, width=2, style=line.style_dotted)

    slowProjLine := line.new(
        bar_index, slowMA,
        bar_index + projBars, slowMA + slowSlope * projBars,
        color=slowProjColor, width=2, style=line.style_dotted)
else
    if not na(fastProjLine)
        line.delete(fastProjLine)
        fastProjLine := na
    if not na(slowProjLine)
        line.delete(slowProjLine)
        slowProjLine := na
