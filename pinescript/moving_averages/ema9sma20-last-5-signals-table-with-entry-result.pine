//@version=6
indicator("EMA(9)/SMA(20) Last 5 Signals Table with Entry & Result", overlay=true, max_labels_count=500)

// === INPUTS ===
emaLength = input.int(9, "EMA Length")
smaLength = input.int(20, "SMA Length")
slFib = input.float(-0.272, "SL Fibonacci")
tp1Multiplier = 2.0
tp2Multiplier = 3.0
maxSignals = 5  // store last 5 trades

// === MOVING AVERAGES ===
emaValue = ta.ema(close, emaLength)
smaValue = ta.sma(close, smaLength)

// === SIGNALS ===
buySignal = ta.crossover(emaValue, smaValue)
sellSignal = ta.crossunder(emaValue, smaValue)

// === TRADE STORAGE ===
var string[] tradeTypeArr = array.new_string()
var float[] entryArr = array.new_float()      
var float[] slArr = array.new_float()
var float[] tp1Arr = array.new_float()
var float[] tp2Arr = array.new_float()
var string[] resultArr = array.new_string()   
var int[] tradeBarArr = array.new_int()       

// === STORE TRADE SIGNALS ===
if buySignal or sellSignal
    tradeType = buySignal ? "BUY" : "SELL"
    entryPrice = close
    sl = buySignal ? low + (high-low)*slFib : high - (high-low)*slFib
    tp1 = buySignal ? close + (close - sl)*tp1Multiplier : close - (sl - close)*tp1Multiplier
    tp2 = buySignal ? close + (close - sl)*tp2Multiplier : close - (sl - close)*tp2Multiplier

    // Keep only last maxSignals trades
    if array.size(tradeTypeArr) >= maxSignals
        array.shift(tradeTypeArr)
        array.shift(entryArr)
        array.shift(slArr)
        array.shift(tp1Arr)
        array.shift(tp2Arr)
        array.shift(resultArr)
        array.shift(tradeBarArr)

    array.push(tradeTypeArr, tradeType)
    array.push(entryArr, entryPrice)
    array.push(slArr, sl)
    array.push(tp1Arr, tp1)
    array.push(tp2Arr, tp2)
    array.push(resultArr, "OPEN")
    array.push(tradeBarArr, bar_index)

// === PLOT BUY/SELL TRIANGLES ON CHART ===
plotshape(buySignal ? close : na, location=location.belowbar, color=color.green, style=shape.triangleup, size=size.large)
plotshape(sellSignal ? close : na, location=location.abovebar, color=color.red, style=shape.triangledown, size=size.large)

// === PLOT EMA & SMA ===
plot(emaValue, color=color.blue, linewidth=2)
plot(smaValue, color=color.orange, linewidth=2)

// === UPDATE RESULT REAL-TIME ===
if array.size(tradeTypeArr) > 0
    for i = 0 to array.size(tradeTypeArr)-1
        tradeType = array.get(tradeTypeArr, i)
        entryPrice = array.get(entryArr, i)
        sl = array.get(slArr, i)
        tp1 = array.get(tp1Arr, i)
        tp2 = array.get(tp2Arr, i)
        result = array.get(resultArr, i)
        
        if result == "OPEN"
            if tradeType == "BUY"
                if low <= sl
                    array.set(resultArr, i, "HIT SL")
                else if high >= tp2
                    array.set(resultArr, i, "HIT TP2")
                else if high >= tp1
                    array.set(resultArr, i, "HIT TP1")
            else // SELL
                if high >= sl
                    array.set(resultArr, i, "HIT SL")
                else if low <= tp2
                    array.set(resultArr, i, "HIT TP2")
                else if low <= tp1
                    array.set(resultArr, i, "HIT TP1")

// === DYNAMIC 5-TRADE TABLE (Top-Center) ===
var table tradeTable = table.new(position.top_center, 6, maxSignals, frame_color=color.gray, frame_width=1, border_width=1)

// Clear table
table.clear(tradeTable, start_column=0, start_row=0)

// Initialize empty rows
for r = 0 to maxSignals-1
    for c = 0 to 5
        table.cell(tradeTable, c, r, "", text_color=color.white, bgcolor=color.black)

// Fill table only if there are trades
if array.size(tradeTypeArr) > 0
    for i = 0 to array.size(tradeTypeArr)-1
        tradeType = array.get(tradeTypeArr, i)
        entryPrice = array.get(entryArr, i)
        sl = array.get(slArr, i)
        tp1 = array.get(tp1Arr, i)
        tp2 = array.get(tp2Arr, i)
        result = array.get(resultArr, i)
        resultColor = result == "OPEN" ? color.yellow : result == "HIT SL" ? color.red : color.green

        table.cell(tradeTable, 0, i, tradeType, text_color=tradeType=="BUY"?color.green:color.red, bgcolor=color.black)
        table.cell(tradeTable, 1, i, "Entry: " + str.tostring(entryPrice, format.mintick), text_color=color.white, bgcolor=color.black)
        table.cell(tradeTable, 2, i, "SL: " + str.tostring(sl, format.mintick), text_color=color.red, bgcolor=color.black)
        table.cell(tradeTable, 3, i, "TP1: " + str.tostring(tp1, format.mintick), text_color=color.green, bgcolor=color.black)
        table.cell(tradeTable, 4, i, "TP2: " + str.tostring(tp2, format.mintick), text_color=color.lime, bgcolor=color.black)
        table.cell(tradeTable, 5, i, result, text_color=resultColor, bgcolor=color.black)
