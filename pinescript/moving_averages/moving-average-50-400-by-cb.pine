//@version=5
indicator("Moving Average 50-400 by CB", shorttitle="MA 50-400 CB", overlay=true)

// Lengtes
Length1 = input.int(50,  title="MA 50 lengte",  minval=1)
Length2 = input.int(100, title="MA 100 lengte", minval=1)
Length3 = input.int(200, title="MA 200 lengte", minval=1)
Length4 = input.int(300, title="MA 300 lengte", minval=1)
Length5 = input.int(400, title="MA 400 lengte", minval=1)

// Basisprijs
xPrice = close

// MAs (v5 gebruikt de ta.-namespace)
ma50  = ta.sma(xPrice, Length1)
ma100 = ta.sma(xPrice, Length2)
ma200 = ta.sma(xPrice, Length3)
ma300 = ta.sma(xPrice, Length4)
ma400 = ta.sma(xPrice, Length5)

// Plot met eigen kleuren
plot(ma50,  linewidth=3, color=color.lime,   title="MA 50")
plot(ma100, linewidth=3, color=color.yellow, title="MA 100")
plot(ma200, linewidth=3, color=color.orange, title="MA 200")
plot(ma300, linewidth=3, color=color.red,    title="MA 300")
plot(ma400, linewidth=3, color=color.blue,   title="MA 400")
