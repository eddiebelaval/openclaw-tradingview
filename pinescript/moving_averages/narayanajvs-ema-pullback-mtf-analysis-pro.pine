// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("NarayanaJVS EMA Pullback & MTF Analysis Pro", overlay = true, max_labels_count = 500)

// --- Constants ---
color BULL_COLOR = #089981
color BEAR_COLOR = #f23645
color NEUTRAL_COLOR = #787b86

// --- Inputs ---
group_ema = "EMA Settings"
shortPeriod = input.int(7, "Short EMA Period", minval = 1, group = group_ema)
longPeriod  = input.int(20, "Long EMA Period", minval = 1, group = group_ema)

group_strong = "Strong Candle Settings"
bodyThreshold = input.float(70.0, "Min Body % of Candle Range", minval = 10, maxval = 100, group = group_strong)
highlightStrong = input.bool(true, "Highlight Strong 20 EMA Crosses", group = group_strong)

group_vwap = "VWAP Settings"
showVwap    = input.bool(true, "Show VWAP on Chart", group = group_vwap)
vwapColor   = input.color(color.new(#ff9800, 0), "VWAP Color", group = group_vwap)

group_dash = "Dashboard Settings"
showDash       = input.bool(true, "Show MTF Dashboard", group = group_dash)
dashEmaPeriod  = input.int(50, "Price vs EMA Period", minval = 1, group = group_dash)
stFactor       = input.float(3.0, "SuperTrend Factor", minval = 0.1, step = 0.1, group = group_dash)
stPeriod       = input.int(10, "SuperTrend ATR Period", minval = 1, group = group_dash)
rsiPeriod      = input.int(14, "RSI Period", minval = 1, group = group_dash)
dashPos        = input.string("Top Right", "Dashboard Position", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = group_dash)
tf1            = input.timeframe("5", "Timeframe 1", group = group_dash)
tf2            = input.timeframe("15", "Timeframe 2", group = group_dash)
tf3            = input.timeframe("30", "Timeframe 3", group = group_dash)
tf4            = input.timeframe("60", "Timeframe 4", group = group_dash)
tf5            = input.timeframe("240", "Timeframe 5", group = group_dash)
tf6            = input.timeframe("D", "Timeframe 6", group = group_dash)
tf7            = input.timeframe("W", "Timeframe 7", group = group_dash)
tf8            = input.timeframe("M", "Timeframe 8", group = group_dash)

// --- Calculations ---
shortEma = ta.ema(close, shortPeriod)
longEma  = ta.ema(close, longPeriod)
vwapVal  = ta.vwap

// Global Cross Variables
crossUnderLong = ta.crossunder(close, longEma)
crossOverShort = ta.crossover(close, shortEma)
crossOverLong  = ta.crossover(close, longEma)
crossUnderShort = ta.crossunder(close, shortEma)

// Trend logic
bullTrend = shortEma > longEma
bearTrend = shortEma < longEma

// Pullback Signal Logic Tracking
var bool waitingForBuyBounce = false
var bool waitingForSellBounce = false

if not bullTrend
    waitingForBuyBounce := false
if not bearTrend
    waitingForSellBounce := false

if bullTrend and crossUnderLong
    waitingForBuyBounce := true

buySignal = bullTrend and waitingForBuyBounce and crossOverShort
if buySignal
    waitingForBuyBounce := false

if bearTrend and crossOverLong
    waitingForSellBounce := true

sellSignal = bearTrend and waitingForSellBounce and crossUnderShort
if sellSignal
    waitingForSellBounce := false

// --- Strong Candle Crossing 20 EMA ---
candleRange = high - low
bodySize    = math.abs(close - open)
isStrong    = candleRange > 0 and (bodySize / candleRange) * 100 >= bodyThreshold

strongBullCross = isStrong and close > open and crossOverLong
strongBearCross = isStrong and close < open and crossUnderLong

// --- Multi-Timeframe Dashboard ---
type MtfData
    float shortEma
    float longEma
    float dashEma
    float tfClose
    float stDirection
    float rsiVal
    float vwapVal

get_mtf_data(string tf) =>
    [st_val, st_dir] = ta.supertrend(stFactor, stPeriod)
    data = request.security(syminfo.tickerid, tf, MtfData.new(ta.ema(close, shortPeriod), ta.ema(close, longPeriod), ta.ema(close, dashEmaPeriod), close, st_dir, ta.rsi(close, rsiPeriod), ta.vwap), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
    emaTrend = data.shortEma > data.longEma ? 1 : (data.shortEma < data.longEma ? -1 : 0)
    pVsEma   = data.tfClose > data.dashEma ? 1 : (data.tfClose < data.dashEma ? -1 : 0)
    stTrend  = data.stDirection < 0 ? 1 : -1
    rsiTrend = data.rsiVal > 50 ? 1 : -1
    pVsVwap  = data.tfClose > data.vwapVal ? 1 : -1
    [emaTrend, pVsEma, stTrend, rsiTrend, pVsVwap]

// Initializing variables for MTF results
var int et1 = 0, var int pe1 = 0, var int st1 = 0, var int rt1 = 0, var int pv1 = 0
var int et2 = 0, var int pe2 = 0, var int st2 = 0, var int rt2 = 0, var int pv2 = 0
var int et3 = 0, var int pe3 = 0, var int st3 = 0, var int rt3 = 0, var int pv3 = 0
var int et4 = 0, var int pe4 = 0, var int st4 = 0, var int rt4 = 0, var int pv4 = 0
var int et5 = 0, var int pe5 = 0, var int st5 = 0, var int rt5 = 0, var int pv5 = 0
var int et6 = 0, var int pe6 = 0, var int st6 = 0, var int rt6 = 0, var int pv6 = 0
var int et7 = 0, var int pe7 = 0, var int st7 = 0, var int rt7 = 0, var int pv7 = 0
var int et8 = 0, var int pe8 = 0, var int st8 = 0, var int rt8 = 0, var int pv8 = 0

if showDash
    [e1, p1, s1, r1, v1] = get_mtf_data(tf1), et1 := e1, pe1 := p1, st1 := s1, rt1 := r1, pv1 := v1
    [e2, p2, s2, r2, v2] = get_mtf_data(tf2), et2 := e2, pe2 := p2, st2 := s2, rt2 := r2, pv2 := v2
    [e3, p3, s3, r3, v3] = get_mtf_data(tf3), et3 := e3, pe3 := p3, st3 := s3, rt3 := r3, pv3 := v3
    [e4, p4, s4, r4, v4] = get_mtf_data(tf4), et4 := e4, pe4 := p4, st4 := s4, rt4 := r4, pv4 := v4
    [e5, p5, s5, r5, v5] = get_mtf_data(tf5), et5 := e5, pe5 := p5, st5 := s5, rt5 := r5, pv5 := v5
    [e6, p6, s6, r6, v6] = get_mtf_data(tf6), et6 := e6, pe6 := p6, st6 := s6, rt6 := r6, pv6 := v6
    [e7, p7, s7, r7, v7] = get_mtf_data(tf7), et7 := e7, pe7 := p7, st7 := s7, rt7 := r7, pv7 := v7
    [e8, p8, s8, r8, v8] = get_mtf_data(tf8), et8 := e8, pe8 := p8, st8 := s8, rt8 := r8, pv8 := v8

// --- Visuals ---
plot(shortEma, "Short EMA", color = color.new(#5b9cf6, 0), linewidth = 2)
plot(longEma, "Long EMA", color = color.new(#787b86, 0), linewidth = 2)
plot(showVwap ? vwapVal : na, "VWAP", color = vwapColor, linewidth = 1, style = plot.style_linebr)

// Pullback Signals
plotshape(buySignal, "Buy Signal", shape.triangleup, location.belowbar, BULL_COLOR, size = size.small, text = "BUY", textcolor = BULL_COLOR)
plotshape(sellSignal, "Sell Signal", shape.triangledown, location.abovebar, BEAR_COLOR, size = size.small, text = "SELL", textcolor = BEAR_COLOR)

// Highlighting Strong Crosses
bgcolor(highlightStrong and strongBullCross ? color.new(BULL_COLOR, 80) : na, title = "Strong Bull Cross Background")
bgcolor(highlightStrong and strongBearCross ? color.new(BEAR_COLOR, 80) : na, title = "Strong Bear Cross Background")
plotshape(strongBullCross, "Strong Bull Cross", shape.circle, location.abovebar, BULL_COLOR, size = size.tiny)
plotshape(strongBearCross, "Strong Bear Cross", shape.circle, location.belowbar, BEAR_COLOR, size = size.tiny)

// Table Dashboard
var table dashTable = na
if showDash and barstate.islast
    tablePos = dashPos == "Top Right" ? position.top_right : 
               dashPos == "Bottom Right" ? position.bottom_right : 
               dashPos == "Top Left" ? position.top_left : position.bottom_left
               
    dashTable := table.new(tablePos, 9, 6, border_width = 1, frame_color = chart.fg_color, frame_width = 1)
    
    // Arrays for loop
    tfs      = array.from(tf1, tf2, tf3, tf4, tf5, tf6, tf7, tf8)
    eTrends  = array.from(et1, et2, et3, et4, et5, et6, et7, et8)
    pEmas    = array.from(pe1, pe2, pe3, pe4, pe5, pe6, pe7, pe8)
    sTrends  = array.from(st1, st2, st3, st4, st5, st6, st7, st8)
    rTrends  = array.from(rt1, rt2, rt3, rt4, rt5, rt6, rt7, rt8)
    pVsVwaps = array.from(pv1, pv2, pv3, pv4, pv5, pv6, pv7, pv8)
    
    // Headers
    table.cell(dashTable, 0, 0, "TF", bgcolor = color.new(NEUTRAL_COLOR, 50), text_color = chart.fg_color)
    table.cell(dashTable, 0, 1, "EMA 7/20", bgcolor = color.new(NEUTRAL_COLOR, 50), text_color = chart.fg_color)
    table.cell(dashTable, 0, 2, "Price/EMA", bgcolor = color.new(NEUTRAL_COLOR, 50), text_color = chart.fg_color)
    table.cell(dashTable, 0, 3, "Price/VWAP", bgcolor = color.new(NEUTRAL_COLOR, 50), text_color = chart.fg_color)
    table.cell(dashTable, 0, 4, "SuperTrend", bgcolor = color.new(NEUTRAL_COLOR, 50), text_color = chart.fg_color)
    table.cell(dashTable, 0, 5, "RSI (50)", bgcolor = color.new(NEUTRAL_COLOR, 50), text_color = chart.fg_color)
    
    for i = 0 to 7
        table.cell(dashTable, i + 1, 0, array.get(tfs, i), bgcolor = color.new(NEUTRAL_COLOR, 80), text_color = chart.fg_color)
        
        // EMA Trend
        e      = array.get(eTrends, i)
        table.cell(dashTable, i + 1, 1, e == 1 ? "BULL" : "BEAR", bgcolor = color.new(e == 1 ? BULL_COLOR : BEAR_COLOR, 30), text_color = chart.fg_color)
        
        // Price vs EMA
        p      = array.get(pEmas, i)
        table.cell(dashTable, i + 1, 2, p == 1 ? "ABOVE" : "BELOW", bgcolor = color.new(p == 1 ? BULL_COLOR : BEAR_COLOR, 30), text_color = chart.fg_color)
        
        // Price vs VWAP
        v      = array.get(pVsVwaps, i)
        table.cell(dashTable, i + 1, 3, v == 1 ? "ABOVE" : "BELOW", bgcolor = color.new(v == 1 ? BULL_COLOR : BEAR_COLOR, 30), text_color = chart.fg_color)
        
        // SuperTrend
        s      = array.get(sTrends, i)
        table.cell(dashTable, i + 1, 4, s == 1 ? "BULL" : "BEAR", bgcolor = color.new(s == 1 ? BULL_COLOR : BEAR_COLOR, 30), text_color = chart.fg_color)
        
        // RSI
        r      = array.get(rTrends, i)
        table.cell(dashTable, i + 1, 5, r == 1 ? "BULL" : "BEAR", bgcolor = color.new(r == 1 ? BULL_COLOR : BEAR_COLOR, 30), text_color = chart.fg_color)

// Alerts
alertcondition(buySignal or sellSignal, "EMA Pullback Signal", "EMA Pullback Signal on {{ticker}}")
alertcondition(strongBullCross or strongBearCross, "Strong 20 EMA Cross", "Strong Candle Cross 20 EMA on {{ticker}}")
