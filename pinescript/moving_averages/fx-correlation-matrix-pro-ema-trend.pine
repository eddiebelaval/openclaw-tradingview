//@version=6
indicator('FX Correlation Matrix PRO + EMA Trend', overlay = true)

// === INPUTS ===
useChartSymbol = input.bool(true, 'Use Chart Symbol As Base?')
baseSymbol = input.symbol('OANDA:EURUSD', 'Custom Base Symbol')

tf = input.timeframe('60', 'Correlation Timeframe')
length = input.int(50, 'Correlation Length', minval = 10)

emaFastLen = input.int(7, 'EMA Fast Length')
emaSlowLen = input.int(21, 'EMA Slow Length')

sym1 = input.symbol('OANDA:GBPUSD', 'Compare Pair 1')
sym2 = input.symbol('OANDA:USDCHF', 'Compare Pair 2')
sym3 = input.symbol('OANDA:USDJPY', 'Compare Pair 3')
sym4 = input.symbol('OANDA:AUDUSD', 'Compare Pair 4')

// === BASE SYMBOL ===
base = useChartSymbol ? syminfo.tickerid : baseSymbol

// === EMA CALCULATION ===
baseClose = request.security(base, timeframe.period, close)
emaFast = ta.ema(baseClose, emaFastLen)
emaSlow = ta.ema(baseClose, emaSlowLen)

plot(emaFast, color = color.orange, title = 'EMA 9')
plot(emaSlow, color = color.blue, title = 'EMA 21')

// === TREND STATE ===
trendState = emaFast > emaSlow ? 'BULLISH' : emaFast < emaSlow ? 'BEARISH' : 'NEUTRAL'
trendColor = emaFast > emaSlow ? color.green : emaFast < emaSlow ? color.red : color.gray

// === TREND LABEL ===
var label trendLabel = na

if barstate.islast
    if not na(trendLabel)
        label.delete(trendLabel)
    trendLabel := label.new(bar_index, high, 'Trend: ' + trendState, style = label.style_label_down, color = trendColor, textcolor = color.white)
    trendLabel

// === CORRELATION FUNCTION ===
f_corr(sym) =>
    p1 = request.security(base, tf, close)
    p2 = request.security(sym, tf, close)
    r1 = math.log(p1 / p1[1])
    r2 = math.log(p2 / p2[1])
    ta.correlation(r1, r2, length)

// === CORRELATIONS ===
c1 = f_corr(sym1)
c2 = f_corr(sym2)
c3 = f_corr(sym3)
c4 = f_corr(sym4)

// === TABLE ===
var table t = table.new(position.top_right, 2, 5, border_width = 1)

if barstate.islast
    table.cell(t, 0, 0, 'Base')
    table.cell(t, 1, 0, base)

    table.cell(t, 0, 1, sym1)
    table.cell(t, 1, 1, str.tostring(c1, '#.##'), bgcolor = color.from_gradient(c1, -1, 1, color.red, color.green))

    table.cell(t, 0, 2, sym2)
    table.cell(t, 1, 2, str.tostring(c2, '#.##'), bgcolor = color.from_gradient(c2, -1, 1, color.red, color.green))

    table.cell(t, 0, 3, sym3)
    table.cell(t, 1, 3, str.tostring(c3, '#.##'), bgcolor = color.from_gradient(c3, -1, 1, color.red, color.green))

    table.cell(t, 0, 4, sym4)
    table.cell(t, 1, 4, str.tostring(c4, '#.##'), bgcolor = color.from_gradient(c4, -1, 1, color.red, color.green))
