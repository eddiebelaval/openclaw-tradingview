//@version=5   
indicator("Vegas251130", overlay=true)
//Vegas2025-11-30 添EMA200动态变色

// 输入参数 
ema12_length = input.int(12, title="EMA12长度")
ema200_length = input.int(200, title="EMA200长度")
ema144_length = input.int(144, title="EMA144长度")
ema169_length = input.int(169, title="EMA169长度")
ema576_length = input.int(576, title="EMA576长度")
ema676_length = input.int(676, title="EMA676长度")
lookback_period = input.int(15, title="观察周期")

// 计算均线
ema12 = ta.ema(close, ema12_length)
ema200 = ta.ema(close, ema200_length)
ema144 = ta.ema(close, ema144_length)
ema169 = ta.ema(close, ema169_length)
ema576 = ta.ema(close, ema576_length)
ema676 = ta.ema(close, ema676_length)

// EMA200动态变色:价格在上方显示绿色,下方显示红色
ema200_color = close > ema200 ? color.green : color.red
plot(ema200, color=ema200_color, linewidth=2, title="EMA200")

// 画出其他均线
plot(ema12, color=color.yellow, title="EMA12")
plot(ema144, color=color.green, title="EMA144")
plot(ema169, color=color.red, title="EMA169")
plot(ema576, color=color.blue, title="EMA576")
plot(ema676, color=color.red, title="EMA676")

// 标记碰到通道的K线索引和是否已发送信号(做多)
var int touch_index_long = na
var bool signal_sent_long = false

// 新增参数:左侧信号开关
enable_left_signal = input.bool(false, title="开启左侧买入信号")

// 检测EMA12是否与EMA144或EMA169交叉(用于过滤信号)
// 检查当前K线和前一根K线,判断是否正在交叉
ema12_cross_144 = (ema12[1] <= ema144[1] and ema12 >= ema144) or (ema12[1] >= ema144[1] and ema12 <= ema144)
ema12_cross_169 = (ema12[1] <= ema169[1] and ema12 >= ema169) or (ema12[1] >= ema169[1] and ema12 <= ema169)
is_ema12_crossing = ema12_cross_144 or ema12_cross_169

// 左侧信号逻辑
var int last_signal_bar = na

if enable_left_signal
    ema_condition = ema12 > ema144 and ema144 > ema169 and ema12 > ema169
    price_touch_ema144 = low <= ema144
    price_touch_ema169 = low <= ema169

    if ema_condition and price_touch_ema144 and (na(last_signal_bar) or (bar_index - last_signal_bar > 10))
        label.new(bar_index - 1, low, "左侧144", style=label.style_label_left, color=color.new(color.green, 70), textcolor=color.white, size=size.small)
        telegram_chat_id = "-4553423358"
        message = '{"chat_id":"' + telegram_chat_id + '", "text":"只考虑124小时慎重左侧触碰144信号触发！\\n标的: ' + syminfo.ticker + '\\n周期: ' + timeframe.period + '\\n价格: ' + str.tostring(close) + '"}'
        alert(message, alert.freq_once_per_bar)
        last_signal_bar := bar_index

    if ema_condition and price_touch_ema169 and (na(last_signal_bar) or (bar_index - last_signal_bar > 10))
        label.new(bar_index - 1, low, "左侧169", style=label.style_label_left, color=color.new(color.red, 70), textcolor=color.white, size=size.small)
        telegram_chat_id = "-4553423358"
        message = '{"chat_id":"' + telegram_chat_id + '", "text":"慎重左侧触碰169信号触发！\\n标的: ' + syminfo.ticker + '\\n周期: ' + timeframe.period + '\\n价格: ' + str.tostring(close) + '"}'
        alert(message, alert.freq_once_per_bar)
        last_signal_bar := bar_index

// 右侧做多信号
if (na(touch_index_long) and (low <= ema144 or low <= ema169) and (ema144 > ema169)) and (ema144 > ema676)
    touch_index_long := bar_index

if (not na(touch_index_long) and (bar_index - touch_index_long <= lookback_period))
    // 做多条件: EMA12必须同时在EMA144和EMA169上方,且不在交叉过程中
    if (close > ema12 and not signal_sent_long and not is_ema12_crossing)
        // 修正: 使用 and 而不是 or,确保EMA12完全突破通道
        if (ema12 >= ema144 and ema12 >= ema169)
            label.new(bar_index, low, text="做144多", style=label.style_label_up, color=color.rgb(57, 170, 81, 50), textcolor=color.new(color.white, 50), size=size.small)
            telegram_chat_id = "-4553423358"
            message = "144做多信号触发！\\n标的: " + syminfo.ticker + "\\n周期: " + timeframe.period + "\\n价格: " + str.tostring(close)
            alert('{"chat_id":"' + telegram_chat_id + '", "text":"' + message + '"}', alert.freq_once_per_bar_close)
            signal_sent_long := true
        else
            signal_sent_long := true

if (bar_index - touch_index_long > lookback_period)
    touch_index_long := na
    signal_sent_long := false

if (not na(touch_index_long))
    line.new(x1=int(touch_index_long), y1=low, x2=bar_index, y2=low, color=color.green, width=1, style=line.style_dotted)

// 右侧做空信号
var int touch_index_short = na
var bool signal_sent_short = false

if (na(touch_index_short) and (high >= ema144 or high >= ema169) and (ema144 < ema169)) and (ema144 < ema576)
    touch_index_short := bar_index

if (not na(touch_index_short) and (bar_index - touch_index_short <= lookback_period))
    // 做空条件: EMA12必须同时在EMA144和EMA169下方,且不在交叉过程中
    if (close < ema12 and not signal_sent_short and not is_ema12_crossing)
        // 修正: 使用 and 而不是单一条件,确保EMA12完全跌破通道
        if (ema12 <= ema144 and ema12 <= ema169)
            label.new(bar_index, high, text="做空169", style=label.style_label_down, color=color.rgb(243, 33, 163, 50), textcolor=color.new(color.white, 50), size=size.small)
            telegram_chat_id = "-4553423358"
            message = "169做空信号触发！\\n标的: " + syminfo.ticker + "\\n周期: " + timeframe.period + "\\n价格: " + str.tostring(close)
            alert('{"chat_id":"' + telegram_chat_id + '", "text":"' + message + '"}', alert.freq_once_per_bar_close)
            signal_sent_short := true
        else
            signal_sent_short := true

if (bar_index - touch_index_short > lookback_period)
    touch_index_short := na
    signal_sent_short := false

if (not na(touch_index_short))
    line.new(x1=int(touch_index_short), y1=high, x2=bar_index, y2=high, color=color.red, width=1, style=line.style_dotted)

// 金叉和死叉信号显示
crossOver169_676 = ta.crossover(ema200, ema576)
crossUnder169_676 = ta.crossunder(ema200, ema576)

plotshape(series=crossOver169_676, location=location.belowbar, color=color.green, style=shape.labelup, text="金叉", size=size.small)
plotshape(series=crossUnder169_676, location=location.abovebar, color=color.red, style=shape.labeldown, text="死叉", size=size.small)

if (crossOver169_676)
    telegram_chat_id = "-4553423358"
    message = '{"chat_id":"' + telegram_chat_id + '", "text":"4小时金叉！\\n标的: ' + syminfo.ticker + '\\n周期: ' + timeframe.period + '\\n价格: ' + str.tostring(close) + '"}'
    alert(message, alert.freq_once_per_bar)

if (crossUnder169_676)
    telegram_chat_id = "-4553423358"
    message = '{"chat_id":"' + telegram_chat_id + '", "text":"4小时死叉！\\n标的: ' + syminfo.ticker + '\\n周期: ' + timeframe.period + '\\n价格: ' + str.tostring(close) + '"}'
    alert(message, alert.freq_once_per_bar)
