//@version=6
indicator("Precision Intraday Edge v5.3", shorttitle="PI Edge v5.3", overlay=true, max_boxes_count=5, max_lines_count=5, max_labels_count=50)

// Inputs
pos_str = input.string("top_right", "Dashboard Pos", options=["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"])
show_zones = input.bool(true, "Show Order Blocks ✓")
vol_mult = input.float(1.2, "Volume Mult", minval=1.0)
len_fast = input.int(8, "Fast EMA")
len_slow = input.int(21, "Slow EMA")
swing_len = input.int(3, "Swing Length")

// Position resolver
pos = pos_str == "top_left" ? position.top_left : 
      pos_str == "top_center" ? position.top_center : 
      pos_str == "top_right" ? position.top_right :
      pos_str == "middle_left" ? position.middle_left :
      pos_str == "middle_center" ? position.middle_center :
      pos_str == "middle_right" ? position.middle_right :
      pos_str == "bottom_left" ? position.bottom_left :
      pos_str == "bottom_center" ? position.bottom_center :
      position.bottom_right

// Session filter (India market 9:15-15:30)
in_session = (hour >= 9 and minute >= 15) or (hour > 9 and hour < 15) or (hour == 15 and minute <= 30)

// EMAs
ema_fast = ta.ema(close, len_fast)
ema_slow = ta.ema(close, len_slow)
trend_up = ema_fast > ema_slow
plot(ema_fast, "Fast EMA", color=color.blue, linewidth=2)
plot(ema_slow, "Slow EMA", color=color.orange, linewidth=2)

// Volume filter
vol_spike = volume > ta.sma(volume, 20) * vol_mult

// **GENUINE ORDER BLOCKS** - Real institutional rejection zones
var box latest_zone = na
var float zone_level = na
var bool is_bull_zone = false

// Delete previous
if not na(latest_zone)
    box.delete(latest_zone)
    latest_zone := na
    zone_level := na

// **REAL ORDER BLOCK DETECTION** - Last candle before strong move
ph = ta.pivothigh(high, swing_len, swing_len)
pl = ta.pivotlow(low, swing_len, swing_len)

// **AUTHENTIC BULLISH OB** - Base = body low of last bearish candle before bullish impulse
if show_zones and not na(pl) and in_session
    // Find the strong move up after pivot low
    impulse_up = close[swing_len] > open[swing_len] and (close[swing_len] - low[swing_len]) > (high[swing_len] - low[swing_len]) * 0.7
    if impulse_up
        zone_level := math.min(open[swing_len], close[swing_len])  // Real body low
        latest_zone := box.new(bar_index[swing_len]-2, zone_level - (high[swing_len]-low[swing_len])*0.1, 
                              bar_index[swing_len]+5, zone_level + (high[swing_len]-low[swing_len])*0.1,
                              bgcolor=color.new(color.green, 75), border_color=color.green, border_width=2)
        is_bull_zone := true

// **AUTHENTIC BEARISH OB** - Top = body high of last bullish candle before bearish impulse  
if show_zones and not na(ph) and in_session
    // Find the strong move down after pivot high
    impulse_down = close[swing_len] < open[swing_len] and (high[swing_len] - close[swing_len]) > (high[swing_len] - low[swing_len]) * 0.7
    if impulse_down
        zone_level := math.max(open[swing_len], close[swing_len])  // Real body high
        latest_zone := box.new(bar_index[swing_len]-2, zone_level - (high[swing_len]-low[swing_len])*0.15, 
                              bar_index[swing_len]+5, zone_level + (high[swing_len]-low[swing_len])*0.15,
                              bgcolor=color.new(color.red, 75), border_color=color.red, border_width=2)
        is_bull_zone := false

// Zone proximity check (smaller genuine zones)
in_zone = not na(zone_level) and math.abs(close - zone_level)/close < 0.006  // Tighter 0.6%

// Perfect signals (unchanged)
bull_signal = in_zone and is_bull_zone and trend_up and close > open and vol_spike and in_session and barstate.isconfirmed
bear_signal = in_zone and not is_bull_zone and not trend_up and close < open and vol_spike and in_session and barstate.isconfirmed

plotshape(bull_signal, "🚀 BUY", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(bear_signal, "💥 SELL", shape.triangledown, location.abovebar, color.red, size=size.small)

// Perfect dashboard (unchanged)
var table dashboard = na
if barstate.islast and in_session
    if na(dashboard)
        dashboard := table.new(pos, 2, 9, bgcolor=color.new(color.black, 10), 
                              border_width=3, border_color=color.white, frame_color=color.white, frame_width=2)
    
    table.cell(dashboard, 0, 0, "🚀 PI EDGE v5.3", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.navy, 20))
    table.cell(dashboard, 1, 0, "INTRADAY LIVE", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.navy, 20))
    
    table.cell(dashboard, 0, 1, "Trend", text_color=color.yellow, text_size=size.normal, bgcolor=color.new(color.gray, 80))
    table.cell(dashboard, 1, 1, trend_up ? "🟢 BULLISH" : "🔴 BEARISH", text_color=trend_up ? color.lime : color.red, text_size=size.normal, bgcolor=color.new(color.gray, 80))
    
    table.cell(dashboard, 0, 2, "Volume", text_color=color.yellow, text_size=size.normal, bgcolor=color.new(color.gray, 80))
    table.cell(dashboard, 1, 2, vol_spike ? "🔥 HIGH" : "Normal", text_color=vol_spike ? color.orange : color.silver, text_size=size.normal, bgcolor=color.new(color.gray, 80))
    
    table.cell(dashboard, 0, 3, "Genuine OB", text_color=color.yellow, text_size=size.normal, bgcolor=color.new(color.gray, 80))
    table.cell(dashboard, 1, 3, not na(latest_zone) ? (is_bull_zone ? "🟢 BULL OB" : "🔴 BEAR OB") : "NONE", 
               text_color=na(latest_zone) ? color.gray : is_bull_zone ? color.lime : color.red, text_size=size.normal, bgcolor=color.new(color.gray, 80))
    
    table.cell(dashboard, 0, 4, "In OB Now", text_color=color.yellow, text_size=size.normal, bgcolor=color.new(color.gray, 80))
    table.cell(dashboard, 1, 4, in_zone ? "✅ YES" : "❌ No", text_color=in_zone ? color.lime : color.gray, text_size=size.normal, bgcolor=color.new(color.gray, 80))
    
    table.cell(dashboard, 0, 5, "Fast EMA", text_color=color.yellow, text_size=size.normal, bgcolor=color.new(color.gray, 80))
    table.cell(dashboard, 1, 5, close > ema_fast ? "🟢 Above" : "🔴 Below", text_color=close > ema_fast ? color.lime : color.red, text_size=size.normal, bgcolor=color.new(color.gray, 80))
    
    table.cell(dashboard, 0, 6, "Session", text_color=color.yellow, text_size=size.normal, bgcolor=color.new(color.gray, 80))
    table.cell(dashboard, 1, 6, in_session ? "✅ 9:15-15:30" : "⏸️ CLOSED", text_color=in_session ? color.lime : color.gray, text_size=size.normal, bgcolor=color.new(color.gray, 80))
    
    sig_text = bull_signal ? "🚀🚀🚀 BUY NOW 🚀🚀🚀" : bear_signal ? "💥💥💥 SELL NOW 💥💥💥" : "⏳ WAIT"
    sig_bg = bull_signal ? color.new(color.lime, 10) : bear_signal ? color.new(color.red, 10) : color.new(color.gray, 60)
    table.merge_cells(dashboard, 0, 8, 1, 8)
    table.cell(dashboard, 0, 8, sig_text, text_color=color.black, text_size=size.large, bgcolor=sig_bg)

// Alerts
alertcondition(bull_signal, "PI v5.3 BUY", "🚀 GENUINE OB BUY {{ticker}}!")
alertcondition(bear_signal, "PI v5.3 SELL", "💥 GENUINE OB SELL {{ticker}}!")
