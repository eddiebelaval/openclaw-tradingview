//────────────────────────────────────────────
// TPC Trend Alignment Meter
// Author: The Perfect Combo
// Description: Multi-signal trend meter combining
// MACD momentum, RSI strength, and EMA trend alignment.
//
// Designed for quick visual market bias detection.
//────────────────────────────────────────────
//@version=5
indicator("TPC Trend Alignment Meter", shorttitle="TPC TM", overlay=false, max_labels_count=500)

// ────────────────────────────────────────────────
//  Inputs
// ────────────────────────────────────────────────
show_meter_1 = input.bool(true, "Trend Meter 1")
show_meter_2 = input.bool(true, "Trend Meter 2")
show_meter_3 = input.bool(true, "Trend Meter 3")

show_bar_1   = input.bool(true,  "Trend Meter 4")
show_bar_2   = input.bool(true,  "Trend Meter 5")

// Visual tuning
meter_level   = input.float(140, "Meters vertical level", minval=50, step=5)
bar1_level    = input.float(110, "Fast MA bar level",     minval=50, step=5)
bar2_level    = input.float( 95, "Slow MA bar level",     minval=50, step=5)

green_transp  = input.int(15, "Green transp.", minval=0, maxval=80)
red_transp    = input.int(25, "Red transp.",   minval=0, maxval=80)

// ────────────────────────────────────────────────
//  Calculations
// ────────────────────────────────────────────────

// MACD 6-12-9
[macdLine, signalLine, _] = ta.macd(close, 6, 12, 9)
macd_bull = macdLine > signalLine

// RSI
rsi13 = ta.rsi(close, 13)
rsi5  = ta.rsi(close, 5)

rsi13_bull = rsi13 > 50
rsi5_bull  = rsi5  > 50

// EMA crossovers / direction
ema1  = ta.ema(close, 1)
ema7  = ta.ema(close, 7)
ema10 = ta.ema(close, 10)
ema14 = ta.ema(close, 14)

fastMA_bull = ema1 > ema7
slowMA_bull = ema10 > ema14

// ────────────────────────────────────────────────
//  Colors – dynamic transparency for nicer look
// ────────────────────────────────────────────────
var color GREEN_LIGHT = color.new(#00ffaa, green_transp)
var color GREEN_DARK  = color.new(#00cc88, green_transp-5)
var color RED_LIGHT   = color.new(#ff4444, red_transp)
var color RED_DARK    = color.new(#cc0000, red_transp-5)

col_meter1 = show_meter_1 ? (macd_bull  ? GREEN_LIGHT : RED_LIGHT)  : na
col_meter2 = show_meter_2 ? (rsi13_bull ? GREEN_LIGHT : RED_LIGHT)  : na
col_meter3 = show_meter_3 ? (rsi5_bull  ? GREEN_LIGHT : RED_LIGHT)  : na

col_bar1   = show_bar_1   ? (fastMA_bull ? GREEN_DARK : RED_DARK)   : na
col_bar2   = show_bar_2   ? (slowMA_bull ? GREEN_DARK : RED_DARK)   : na

// ────────────────────────────────────────────────
//  Plots
// ────────────────────────────────────────────────

// Trend Meters (circles / dots)
plot(meter_level,     "Trend Meter 1",   color=col_meter1,  linewidth=2, style=plot.style_circles)
plot(meter_level - 8, "Trend Meter 2",   color=col_meter2,  linewidth=2, style=plot.style_circles)
plot(meter_level -16, "Trend Meter 3",   color=col_meter3,  linewidth=2, style=plot.style_circles)

// Trend Bars (thicker horizontal lines)
plot(bar1_level, "Trend Meter 4", col_bar1, linewidth=3, style=plot.style_line)
plot(bar2_level, "Trend Meter 5", col_bar2, linewidth=3, style=plot.style_line)

// ────────────────────────────────────────────────
//  Background when ALL 5 agree
// ────────────────────────────────────────────────
all_green = macd_bull and rsi13_bull and rsi5_bull and fastMA_bull and slowMA_bull
all_red   = not macd_bull and not rsi13_bull and not rsi5_bull and not fastMA_bull and not slowMA_bull

bgcolor(all_green ? color.new(#00ffaa, 80) : na, title="All 5 green bg")
bgcolor(all_red   ? color.new(#ff4444, 80) : na,  title="All 5 red bg")

// ────────────────────────────────────────────────
//  Alerts (updated to all 5)
// ────────────────────────────────────────────────
if ta.change(all_green) and all_green
    alert("TPC Trend Meter → ALL 5 meters GREEN", alert.freq_once_per_bar)

if ta.change(all_red) and all_red
    alert("TPC Trend Meter → ALL 5 meters RED", alert.freq_once_per_bar)
