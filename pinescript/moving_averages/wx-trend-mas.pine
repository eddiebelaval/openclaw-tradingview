// © WesPX
//
// Based on: "CM_Ultimate_MA_MTF_V2" by ChrisMoody (open-source)
// Original source: https://www.tradingview.com/script/8KVcQiJM-CM-Ultimate-MA-MTF-V2/
//
// Fork/Modifications by WesPX on 2026-02-26:
// - Updated to Pine Script v6
// - Added preset dropdown (Monthly trend, Daily stable, Daily high-vol)
// - Refactored MA/TEMA helpers and direction-color logic for consistency
// - Added fast/slow widths + right-edge labels naming each MA
// - Added "Confirmed HTF only" option for truly non-repainting MTF output
// - Replaced custom HMA math with built-in ta.hma()
// - Added global MA2 visibility toggle (works for presets + custom)

//@version=6
indicator("Wx Trend MAs", shorttitle="Wx Trend MAs", overlay=true)

//────────────────────────────────────
// PRESETS
//────────────────────────────────────
groupPreset = "Presets"
preset = input.string(
     defval="Daily – Stable (34/55 EMA)",
     title="Preset",
     options=[
         "Monthly Trend (55/200 SMA)",
         "Daily – Stable (34/55 EMA)",
         "Daily – High-Vol (8/21 EMA)",
         "Custom"
     ],
     group=groupPreset
)

//────────────────────────────────────
// GLOBAL VISIBILITY
//────────────────────────────────────
groupVis = "Visuals"
showMA2Global  = input.bool(true, "Show MA2", group=groupVis)
showCrossDots  = input.bool(false, "Show Cross Markers (MA1 vs MA2)", group=groupVis)
showNames      = input.bool(true, "Show MA name labels (right edge)", group=groupVis)
labelOffsetBars = input.int(2, "Label Offset Bars", minval=0, maxval=50, group=groupVis)

cc            = input.bool(true,  "Color MA1 by direction?", group=groupVis)
cc2           = input.bool(true,  "Color MA2 by direction?", group=groupVis)
smoothe       = input.int(2, "Direction Smoothing (1=no smoothing)", minval=1, maxval=10, group=groupVis)
lineWidthFast = input.int(3, "MA1 Line Width (fast)", minval=1, maxval=6, group=groupVis)
lineWidthSlow = input.int(2, "MA2 Line Width (slow)", minval=1, maxval=6, group=groupVis)

//────────────────────────────────────
// CUSTOM SETTINGS (only used if preset = Custom)
//────────────────────────────────────
groupCustom = "Custom Settings (used only if Preset = Custom)"
useCurrentRes = input.bool(true, "Use Current Chart Resolution?", group=groupCustom)
resCustom     = input.timeframe("D", "Custom Timeframe (if not current)", group=groupCustom)

lenCustom  = input.int(20, "MA1 Length", minval=1, group=groupCustom)
typeCustom = input.string("EMA", "MA1 Type", options=["SMA","EMA","WMA","HMA","VWMA","RMA","TEMA"], group=groupCustom)

len2Custom  = input.int(50, "MA2 Length", minval=1, group=groupCustom)
type2Custom = input.string("SMA", "MA2 Type", options=["SMA","EMA","WMA","HMA","VWMA","RMA","TEMA"], group=groupCustom)

//────────────────────────────────────
// MTF MODE
//────────────────────────────────────
groupMTF = "MTF Behavior"
confirmedOnly = input.bool(
     false,
     "Confirmed HTF only (no intrabar updates)",
     tooltip="OFF = Live HTF value updates while the higher timeframe candle is forming.\nON = Step-like values from the last closed HTF candle only (truly non-repainting).",
     group=groupMTF
)

//────────────────────────────────────
// RESOLVE PRESET → timeframe + types + lengths
//────────────────────────────────────
string tf = switch preset
    "Monthly Trend (55/200 SMA)"  => "1M"
    "Daily – Stable (34/55 EMA)"  => "D"
    "Daily – High-Vol (8/21 EMA)" => "D"
    => (useCurrentRes ? timeframe.period : resCustom)

int len1 = switch preset
    "Monthly Trend (55/200 SMA)"  => 55
    "Daily – Stable (34/55 EMA)"  => 34
    "Daily – High-Vol (8/21 EMA)" => 8
    => lenCustom

int len2 = switch preset
    "Monthly Trend (55/200 SMA)"  => 200
    "Daily – Stable (34/55 EMA)"  => 55
    "Daily – High-Vol (8/21 EMA)" => 21
    => len2Custom

string type1 = switch preset
    "Monthly Trend (55/200 SMA)"  => "SMA"
    "Daily – Stable (34/55 EMA)"  => "EMA"
    "Daily – High-Vol (8/21 EMA)" => "EMA"
    => typeCustom

string type2 = switch preset
    "Monthly Trend (55/200 SMA)"  => "SMA"
    "Daily – Stable (34/55 EMA)"  => "EMA"
    "Daily – High-Vol (8/21 EMA)" => "EMA"
    => type2Custom

// Final MA2 visibility (global toggle)
bool useMA2 = showMA2Global

string ma1Name = type1 + " " + str.tostring(len1)
string ma2Name = type2 + " " + str.tostring(len2)

//────────────────────────────────────
// MA HELPERS
//────────────────────────────────────
src = close

f_tema(_src, _len) =>
    l = math.max(1, _len)
    e1 = ta.ema(_src, l)
    e2 = ta.ema(e1, l)
    e3 = ta.ema(e2, l)
    3 * (e1 - e2) + e3

f_ma(_src, _len, _type) =>
    l = math.max(1, _len)
    switch _type
        "SMA"  => ta.sma(_src, l)
        "EMA"  => ta.ema(_src, l)
        "WMA"  => ta.wma(_src, l)
        "HMA"  => ta.hma(_src, l)
        "VWMA" => ta.vwma(_src, l)
        "RMA"  => ta.rma(_src, l)
        => f_tema(_src, l)

//────────────────────────────────────
// CALCULATE MTF SERIES
//────────────────────────────────────
ma1_local = f_ma(src, len1, type1)
ma2_local = f_ma(src, len2, type2)

ma1 = confirmedOnly
     ? request.security(syminfo.tickerid, tf, ma1_local[1], lookahead=barmerge.lookahead_on)
     : request.security(syminfo.tickerid, tf, ma1_local,   lookahead=barmerge.lookahead_off)

ma2 = confirmedOnly
     ? request.security(syminfo.tickerid, tf, ma2_local[1], lookahead=barmerge.lookahead_on)
     : request.security(syminfo.tickerid, tf, ma2_local,   lookahead=barmerge.lookahead_off)

//────────────────────────────────────
// DIRECTION COLORS
//────────────────────────────────────
ma1_up   = ma1 >= ma1[smoothe]
ma1_down = ma1 <  ma1[smoothe]
col1 = cc ? (ma1_up ? color.lime : ma1_down ? color.red : color.aqua) : color.aqua

ma2_up   = ma2 >= ma2[smoothe]
ma2_down = ma2 <  ma2[smoothe]
col2 = cc2 ? (ma2_up ? color.lime : ma2_down ? color.red : color.aqua) : color.aqua

//────────────────────────────────────
// CROSS (computed every bar)
//────────────────────────────────────
crossRaw = ta.cross(ma1, ma2)
crossNow = useMA2 and crossRaw

//────────────────────────────────────
// PLOTS
//────────────────────────────────────
plot(ma1, title="MA1", linewidth=lineWidthFast, color=col1)
plot(useMA2 ? ma2 : na, title="MA2", linewidth=lineWidthSlow, color=col2)

plot(
     (useMA2 and showCrossDots and crossNow) ? ma2 : na,
     title="Cross",
     style=plot.style_cross,
     linewidth=3,
     color=color.yellow
)
