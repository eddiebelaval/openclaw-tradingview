//@version=6
indicator(
  title="Gold Golden Zone with Entry Lines",
  shorttitle="GldGZEntry",
  overlay=true
)

// === INPUTS ===
htf_input        = input.timeframe("60", "Higher Timeframe")
ema_length       = input.int(50, "EMA Length")
fib_swing_length = input.int(20, "Swing Lookback")
show_ema         = input.bool(true, "Show EMA")
show_fib_zone    = input.bool(true, "Show Golden Zone")
show_htf_bg      = input.bool(true, "Show HTF Background")
show_entry_lines = input.bool(true, "Show Entry/TP/SL Lines")
use_confirmation = input.bool(false, "Use Confirmation Triggers")
structure_lookback = input.int(5, "Structure Lookback")
atr_length       = input.int(14, "ATR Length")
risk_reward      = input.float(2.0, "Risk:Reward Ratio")
stop_buffer_atr  = input.float(1.5, "Stop Loss ATR Multiplier")
show_table       = input.bool(true, "Show Info Table")

// --- Session Filter (Major Sessions) ---
use_session_filter = input.bool(false, "Enable Session Filter")
trade_asia   = input.bool(true, "Trade Asia (00:00-09:00 GMT)")
trade_london = input.bool(true, "Trade London (08:00-17:00 GMT)")
trade_us     = input.bool(true, "Trade US (13:00-22:00 GMT)")

// Determine current GMT hour
hour_gmt = hour(time, "GMT")
// Check if within any selected session
in_asia   = trade_asia   and not na(hour_gmt) and hour_gmt >= 0 and hour_gmt < 9
in_london = trade_london and not na(hour_gmt) and hour_gmt >= 8 and hour_gmt < 17
in_us     = trade_us     and not na(hour_gmt) and hour_gmt >= 13 and hour_gmt < 22
session_active = not use_session_filter or (in_asia or in_london or in_us)

// === HIGHER TIMEFRAME TREND ===
htf_close = request.security(syminfo.tickerid, htf_input, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
htf_ema   = request.security(syminfo.tickerid, htf_input, ta.ema(close, ema_length), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

htf_bullish = htf_close > htf_ema
htf_bearish = htf_close < htf_ema

// === SWING DETECTION ===
swing_high = ta.pivothigh(high, fib_swing_length, fib_swing_length)
swing_low  = ta.pivotlow(low, fib_swing_length, fib_swing_length)

var float last_swing_high     = na
var float last_swing_low      = na
var int   last_swing_high_bar = na
var int   last_swing_low_bar  = na

if not na(swing_high)
    last_swing_high     := swing_high
    last_swing_high_bar := bar_index
if not na(swing_low)
    last_swing_low      := swing_low
    last_swing_low_bar  := bar_index

valid_uptrend   = not na(last_swing_low) and not na(last_swing_high) and last_swing_low_bar < last_swing_high_bar
valid_downtrend = not na(last_swing_low) and not na(last_swing_high) and last_swing_high_bar < last_swing_low_bar

// === GLOBAL FIB LEVELS ===
var float fib_50  = na
var float fib_618 = na

// === DRAWING OBJECTS (Golden Zone) ===
var line fib_line_0   = na
var line fib_line_236 = na
var line fib_line_382 = na
var line fib_line_50  = na
var line fib_line_618 = na
var line fib_line_786 = na
var line fib_line_100 = na
var box  golden_zone  = na

// === UPDATE FIBONACCI LEVELS ===
if valid_uptrend
    start_price = last_swing_low
    end_price   = last_swing_high
    start_x     = last_swing_low_bar
    end_x       = last_swing_high_bar

    fib_50  := end_price - (end_price - start_price) * 0.50
    fib_618 := end_price - (end_price - start_price) * 0.618

    if show_fib_zone
        // delete old
        if not na(fib_line_0)
            line.delete(fib_line_0)
            fib_line_0 := na
        if not na(fib_line_236)
            line.delete(fib_line_236)
            fib_line_236 := na
        if not na(fib_line_382)
            line.delete(fib_line_382)
            fib_line_382 := na
        if not na(fib_line_50)
            line.delete(fib_line_50)
            fib_line_50 := na
        if not na(fib_line_618)
            line.delete(fib_line_618)
            fib_line_618 := na
        if not na(fib_line_786)
            line.delete(fib_line_786)
            fib_line_786 := na
        if not na(fib_line_100)
            line.delete(fib_line_100)
            fib_line_100 := na
        if not na(golden_zone)
            box.delete(golden_zone)
            golden_zone := na

        // draw new
        fib_0   = start_price
        fib_100 = end_price
        fib_236 = end_price - (end_price - start_price) * 0.236
        fib_382 = end_price - (end_price - start_price) * 0.382
        fib_786 = end_price - (end_price - start_price) * 0.786

        fib_line_0   := line.new(x1=start_x, y1=fib_0,   x2=end_x, y2=fib_0,   color=color.gray, width=1, style=line.style_dotted)
        fib_line_236 := line.new(x1=start_x, y1=fib_236, x2=end_x, y2=fib_236, color=color.gray, width=1, style=line.style_dotted)
        fib_line_382 := line.new(x1=start_x, y1=fib_382, x2=end_x, y2=fib_382, color=color.gray, width=1, style=line.style_dotted)
        fib_line_50  := line.new(x1=start_x, y1=fib_50,  x2=end_x, y2=fib_50,  color=color.yellow, width=2, style=line.style_solid)
        fib_line_618 := line.new(x1=start_x, y1=fib_618, x2=end_x, y2=fib_618, color=color.yellow, width=2, style=line.style_solid)
        fib_line_786 := line.new(x1=start_x, y1=fib_786, x2=end_x, y2=fib_786, color=color.gray, width=1, style=line.style_dotted)
        fib_line_100 := line.new(x1=start_x, y1=fib_100, x2=end_x, y2=fib_100, color=color.gray, width=1, style=line.style_dotted)

        golden_zone := box.new(left=start_x, top=math.max(fib_50, fib_618), right=end_x, bottom=math.min(fib_50, fib_618), bgcolor=color.new(color.yellow, 90), border_color=na)

if valid_downtrend
    start_price = last_swing_high
    end_price   = last_swing_low
    start_x     = last_swing_high_bar
    end_x       = last_swing_low_bar

    fib_50  := end_price + (start_price - end_price) * 0.50
    fib_618 := end_price + (start_price - end_price) * 0.618

    if show_fib_zone
        // delete old
        if not na(fib_line_0)
            line.delete(fib_line_0)
            fib_line_0 := na
        if not na(fib_line_236)
            line.delete(fib_line_236)
            fib_line_236 := na
        if not na(fib_line_382)
            line.delete(fib_line_382)
            fib_line_382 := na
        if not na(fib_line_50)
            line.delete(fib_line_50)
            fib_line_50 := na
        if not na(fib_line_618)
            line.delete(fib_line_618)
            fib_line_618 := na
        if not na(fib_line_786)
            line.delete(fib_line_786)
            fib_line_786 := na
        if not na(fib_line_100)
            line.delete(fib_line_100)
            fib_line_100 := na
        if not na(golden_zone)
            box.delete(golden_zone)
            golden_zone := na

        // draw new
        fib_0   = start_price
        fib_100 = end_price
        fib_236 = end_price + (start_price - end_price) * 0.236
        fib_382 = end_price + (start_price - end_price) * 0.382
        fib_786 = end_price + (start_price - end_price) * 0.786

        fib_line_0   := line.new(x1=start_x, y1=fib_0,   x2=end_x, y2=fib_0,   color=color.gray, width=1, style=line.style_dotted)
        fib_line_236 := line.new(x1=start_x, y1=fib_236, x2=end_x, y2=fib_236, color=color.gray, width=1, style=line.style_dotted)
        fib_line_382 := line.new(x1=start_x, y1=fib_382, x2=end_x, y2=fib_382, color=color.gray, width=1, style=line.style_dotted)
        fib_line_50  := line.new(x1=start_x, y1=fib_50,  x2=end_x, y2=fib_50,  color=color.yellow, width=2, style=line.style_solid)
        fib_line_618 := line.new(x1=start_x, y1=fib_618, x2=end_x, y2=fib_618, color=color.yellow, width=2, style=line.style_solid)
        fib_line_786 := line.new(x1=start_x, y1=fib_786, x2=end_x, y2=fib_786, color=color.gray, width=1, style=line.style_dotted)
        fib_line_100 := line.new(x1=start_x, y1=fib_100, x2=end_x, y2=fib_100, color=color.gray, width=1, style=line.style_dotted)

        golden_zone := box.new(left=start_x, top=math.max(fib_50, fib_618), right=end_x, bottom=math.min(fib_50, fib_618), bgcolor=color.new(color.yellow, 90), border_color=na)

// === POSITION IN GOLDEN ZONE ===
in_golden_zone_uptrend   = valid_uptrend   and low <= fib_50 and high >= fib_618
in_golden_zone_downtrend = valid_downtrend and high >= fib_50 and low <= fib_618

// === CONFIRMATION TRIGGERS ===
minor_swing_high = ta.pivothigh(high, structure_lookback, structure_lookback)
minor_swing_low  = ta.pivotlow(low, structure_lookback, structure_lookback)

var float last_minor_high = na
var float last_minor_low  = na

if not na(minor_swing_high)
    last_minor_high := minor_swing_high
if not na(minor_swing_low)
    last_minor_low  := minor_swing_low

bullish_structure_break = not na(last_minor_low) and close > last_minor_low
bearish_structure_break = not na(last_minor_high) and close < last_minor_high

candle_body   = math.abs(close - open)
candle_range  = high - low
body_ratio    = candle_range > 0 ? candle_body / candle_range : 0
momentum_candle = body_ratio > 0.7

bullish_confirmation = (bullish_structure_break or momentum_candle)
bearish_confirmation = (bearish_structure_break or momentum_candle)

// === FINAL SIGNALS (with session filter and bar confirmation) ===
raw_long  = htf_bullish and in_golden_zone_uptrend
raw_short = htf_bearish and in_golden_zone_downtrend

base_long  = use_confirmation ? (raw_long and bullish_confirmation) : raw_long
base_short = use_confirmation ? (raw_short and bearish_confirmation) : raw_short

// Only generate signals on the confirmed close of the bar (prevents intra‑real‑time repainting)
long_signal  = base_long  and session_active and barstate.isconfirmed
short_signal = base_short and session_active and barstate.isconfirmed

// === ATR FOR STOP/TARGET ===
atr = ta.atr(atr_length)

// === ACTIVE SIGNAL TRACKING ===
var float active_entry   = na
var float active_stop    = na
var float active_target  = na
var string active_dir    = na  // "long" or "short"

// === ENTRY/TP/SL LINES (with price labels) ===
var line entry_line   = na
var line stop_line    = na
var line target_line  = na
var label entry_label = na
var label stop_label  = na
var label target_label = na

// === CHECK IF ACTIVE SIGNAL HIT SL OR TP ===
if not na(active_entry)
    // Long signal check
    if active_dir == "long"
        if low <= active_stop or high >= active_target
            // Delete signal objects
            if not na(entry_line)
                line.delete(entry_line)
                entry_line := na
            if not na(stop_line)
                line.delete(stop_line)
                stop_line := na
            if not na(target_line)
                line.delete(target_line)
                target_line := na
            if not na(entry_label)
                label.delete(entry_label)
                entry_label := na
            if not na(stop_label)
                label.delete(stop_label)
                stop_label := na
            if not na(target_label)
                label.delete(target_label)
                target_label := na
            // Clear active variables
            active_entry := na
            active_stop := na
            active_target := na
            active_dir := na
    // Short signal check
    else if active_dir == "short"
        if high >= active_stop or low <= active_target
            // Delete signal objects
            if not na(entry_line)
                line.delete(entry_line)
                entry_line := na
            if not na(stop_line)
                line.delete(stop_line)
                stop_line := na
            if not na(target_line)
                line.delete(target_line)
                target_line := na
            if not na(entry_label)
                label.delete(entry_label)
                entry_label := na
            if not na(stop_label)
                label.delete(stop_label)
                stop_label := na
            if not na(target_label)
                label.delete(target_label)
                target_label := na
            // Clear active variables
            active_entry := na
            active_stop := na
            active_target := na
            active_dir := na

// === DRAW NEW SIGNAL IF CONDITIONS MET ===
if show_entry_lines and (long_signal or short_signal)
    // Delete previous objects (overwrite with new signal)
    if not na(entry_line)
        line.delete(entry_line)
        entry_line := na
    if not na(stop_line)
        line.delete(stop_line)
        stop_line := na
    if not na(target_line)
        line.delete(target_line)
        target_line := na
    if not na(entry_label)
        label.delete(entry_label)
        entry_label := na
    if not na(stop_label)
        label.delete(stop_label)
        stop_label := na
    if not na(target_label)
        label.delete(target_label)
        target_label := na

    // Declare local variables
    float entry_price   = na
    float stop_price    = na
    float target_price  = na
    color line_color    = na
    color text_color    = na

    if long_signal
        entry_price  := close
        stop_price   := entry_price - (atr * stop_buffer_atr)
        target_price := entry_price + ((entry_price - stop_price) * risk_reward)
        line_color   := color.green
        text_color   := color.white
        active_dir   := "long"
    else if short_signal
        entry_price  := close
        stop_price   := entry_price + (atr * stop_buffer_atr)
        target_price := entry_price - ((stop_price - entry_price) * risk_reward)
        line_color   := color.red
        text_color   := color.white
        active_dir   := "short"

    // Store active signal levels
    active_entry  := entry_price
    active_stop   := stop_price
    active_target := target_price

    // Draw horizontal lines
    entry_line := line.new(x1=bar_index, y1=entry_price, x2=bar_index+10, y2=entry_price, 
                           color=line_color, width=2, style=line.style_solid, extend=extend.right)
    stop_line  := line.new(x1=bar_index, y1=stop_price,  x2=bar_index+10, y2=stop_price, 
                           color=color.orange, width=2, style=line.style_dashed, extend=extend.right)
    target_line := line.new(x1=bar_index, y1=target_price, x2=bar_index+10, y2=target_price, 
                            color=color.blue, width=2, style=line.style_dashed, extend=extend.right)

    // Add labels
    entry_label := label.new(x=bar_index, y=entry_price, 
                             text="Entry: " + str.tostring(entry_price, "#.##"), 
                             color=line_color, textcolor=text_color, style=label.style_label_left, size=size.small)
    stop_label  := label.new(x=bar_index, y=stop_price, 
                             text="SL: " + str.tostring(stop_price, "#.##"), 
                             color=color.orange, textcolor=color.black, style=label.style_label_left, size=size.small)
    target_label := label.new(x=bar_index, y=target_price, 
                              text="TP: " + str.tostring(target_price, "#.##"), 
                              color=color.blue, textcolor=color.white, style=label.style_label_left, size=size.small)

// === GLOBAL PLOTS ===
ema_plot = ta.ema(close, ema_length)
plot(show_ema ? ema_plot : na, "EMA", color.blue, 2)

bgcolor(show_htf_bg ? (htf_bullish ? color.new(color.green, 95) : htf_bearish ? color.new(color.red, 95) : na) : na, title="HTF Background")

// === INFO TABLE (with session status) ===
if show_table and barstate.islast
    var table info = table.new(position.top_right, 2, 4, bgcolor=color.white, border_width=1)
    table.cell(info, 0, 0, "HTF", text_color=color.black, bgcolor=color.gray)
    table.cell(info, 1, 0, htf_bullish ? "BU" : htf_bearish ? "BE" : "--", 
               text_color=color.black, bgcolor=htf_bullish ? color.green : htf_bearish ? color.red : color.yellow)
    table.cell(info, 0, 1, "Zone", text_color=color.black, bgcolor=color.gray)
    in_zone = (low <= fib_50 and high >= fib_618) or (high >= fib_50 and low <= fib_618)
    table.cell(info, 1, 1, in_zone ? "YES" : "NO", 
               text_color=color.black, bgcolor=in_zone ? color.green : color.red)
    table.cell(info, 0, 2, "Session", text_color=color.black, bgcolor=color.gray)
    table.cell(info, 1, 2, session_active ? "ACTIVE" : "OFF", 
               text_color=color.black, bgcolor=session_active ? color.green : color.red)
    table.cell(info, 0, 3, "Signal", text_color=color.black, bgcolor=color.gray)
    table.cell(info, 1, 3, long_signal ? "LONG" : short_signal ? "SHORT" : "--", 
               text_color=color.black, bgcolor=long_signal ? color.green : short_signal ? color.red : color.yellow)
