//@version=6
indicator("MACD Renko Locked Signals", overlay=true)

// ===== INPUTS =====
fastLength   = input.int(12, "Fast Length")
slowLength   = input.int(26, "Slow Length")
signalLength = input.int(9, "Signal Length")

// ===== MACD =====
fastMA = ta.ema(close, fastLength)
slowMA = ta.ema(close, slowLength)

macd   = fastMA - slowMA
signal = ta.sma(macd, signalLength)

// ===== CROSS CONDITIONS =====
bullCross = ta.crossover(macd, signal)
bearCross = ta.crossunder(macd, signal)

// ===== STATE MEMORY =====
var int state = 0
var bool buySignal  = false
var bool sellSignal = false

// Reset each bar before evaluation
buySignal  := false
sellSignal := false

if barstate.isconfirmed
    if bullCross and state != 1
        buySignal  := true
        state      := 1
    if bearCross and state != -1
        sellSignal := true
        state      := -1

// ===== PLOT SIGNALS =====
plotshape(buySignal,
     title="Buy Signal",
     style=shape.labelup,
     location=location.belowbar,
     color=color.lime,
     text="BUY",
     textcolor=color.black,
     size=size.large)

plotshape(sellSignal,
     title="Sell Signal",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     text="SELL",
     textcolor=color.white,
     size=size.large)

// ===== OPTIONAL: BACKGROUND COLOR FOR CURRENT STATE =====
bgcolor(state == 1 ? color.new(color.lime, 90) : state == -1 ? color.new(color.red, 90) : na)

// ===== ALERTS =====
alertcondition(buySignal,  title="BUY ALERT",  message="MACD BUY — {{ticker}} @ {{close}}")
alertcondition(sellSignal, title="SELL ALERT",  message="MACD SELL — {{ticker}} @ {{close}}")
