//@version=5
indicator("ATR Trend Direction Lines", overlay=true)

// Input parameters
atrLength     = input.int(10, "ATR Length", minval=1)
atrMultiplier = input.float(3.0, "ATR Multiplier", minval=0.1, step=0.1)
srcLong       = input.source(low, "Long Source",  tooltip="Price source used to calculate and track the trail stop for uptrends")
srcShort      = input.source(high, "Short Source", tooltip="Price source used to calculate and track the trail stop for downtrends")

// ATR MA Type Setting
atrMaType     = input.string("RMA", "ATR MA Type", options=["RMA", "EMA", "SMA", "WMA", "VWMA"], group="ATR Settings", tooltip="Moving average type used to smooth the True Range. RMA = Wilder's (default ATR)")

// ATR Label Display Settings
showATRLabel  = input.bool(true, "Show ATR Value", group="ATR Label")
labelPosition = input.string("Above", "Label Position", options=["Above", "Below"], group="ATR Label")
labelOffset   = input.int(30, "Label Distance (ticks)", minval=1, maxval=100, group="ATR Label")
labelSize     = input.string("Normal", "Label Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group="ATR Label")

// Calculate True Range
trueRange = ta.tr(true)

// Apply selected MA type to True Range
atr = switch atrMaType
    "RMA"  => ta.rma(trueRange, atrLength)
    "EMA"  => ta.ema(trueRange, atrLength)
    "SMA"  => ta.sma(trueRange, atrLength)
    "WMA"  => ta.wma(trueRange, atrLength)
    "VWMA" => ta.vwma(trueRange, atrLength)
    =>        ta.sma(trueRange, atrLength)

// Initialize variables
var float trailStop = na
var int trend = 1
var label atrLabel = na

// Calculate trail stops using separate sources
upStop   = srcLong  - (atrMultiplier * atr)
downStop = srcShort + (atrMultiplier * atr)

// Determine trend and trail stop level
if na(trailStop)
    trailStop := upStop
    trend := 1
else
    if trend == 1
        if srcLong < trailStop
            // Trend flips to down — project new downStop from the previous trail level
            trend     := -1
            trailStop := trailStop[1] + (atrMultiplier * atr)
        else
            trailStop := math.max(upStop, trailStop[1])
    else
        if srcShort > trailStop
            // Trend flips to up — project new upStop from the previous trail level
            trend     := 1
            trailStop := trailStop[1] - (atrMultiplier * atr)
        else
            trailStop := math.min(downStop, trailStop[1])

// Detect changes
levelChanged = trailStop != trailStop[1]
trendChanged = trend != trend[1]

// Plot uptrend and downtrend as separate lines so they never connect
plot(trend == 1  ? trailStop : na, "ATR Trail Up",   color=color.green, linewidth=2, style=plot.style_linebr)
plot(trend == -1 ? trailStop : na, "ATR Trail Down", color=color.red,   linewidth=2, style=plot.style_linebr)

// Plot white dots on the line at each level change
plot(levelChanged ? trailStop : na, "Level Change Dot", color=color.white, style=plot.style_circles, linewidth=1)

// ATR Label Display (prevents duplication)
if showATRLabel and barstate.islast
    if not na(atrLabel)
        label.delete(atrLabel)
    
    lblSize = labelSize == "Tiny" ? size.tiny :
              labelSize == "Small" ? size.small :
              labelSize == "Normal" ? size.normal :
              labelSize == "Large" ? size.large :
              size.huge
    
    labelPrice = labelPosition == "Above" ?
                 high + (syminfo.mintick * labelOffset) :
                 low  - (syminfo.mintick * labelOffset)
    
    pipSize    = syminfo.mintick * 10
    atrInPips  = math.round((atr * atrMultiplier) / pipSize)
    atrText    = "ATR: " + str.tostring(atrInPips, "#") + " pips"
    
    atrLabel := label.new(bar_index, labelPrice, atrText,
                 style     = labelPosition == "Above" ? label.style_label_down : label.style_label_up,
                 color     = trend == 1 ? color.new(color.green, 20) : color.new(color.red, 20),
                 textcolor = color.white,
                 size      = lblSize)

// Alert conditions
alertcondition(trendChanged and trend == 1,  "Trend Change to Up",   "Price crossed above ATR trail - Uptrend")
alertcondition(trendChanged and trend == -1, "Trend Change to Down", "Price crossed below ATR trail - Downtrend")
