// © QuantScript
// هذا المؤشر أداة تحليلية فنية فقط. التداول ينطوي على مخاطر عالية، والربح والخسارة مسؤوليتك الشخصية الكاملة.
//@version=5
indicator("EMA Sniper Pro [QuantScript]", overlay=true, max_boxes_count=50)

// --- إعدادات المظهر الذكي (Visual Mode) ---
visual_mode = input.string("Dark Mode", "الوضع البصري", options=["Dark Mode", "Light Mode"])
is_dark     = visual_mode == "Dark Mode"

// مصفوفة الألوان الذكية (تباين عالي للوضع الداكن)
c_demand = is_dark ? color.new(#00D2FF, 80) : color.new(#4682B4, 85) 
c_supply = is_dark ? color.new(#FF3131, 80) : color.new(#8B0000, 85) 
c_text   = is_dark ? color.white         : color.black
c_ema_up = is_dark ? color.new(#00D2FF, 40) : color.new(#4682B4, 60)
c_ema_dn = is_dark ? color.new(#FF3131, 40) : color.new(#8B0000, 60)

// --- المدخلات الفنية ---
basisLen     = input.int(21, "المتوسط السريع")
slowLen      = input.int(50, "المتوسط البطيء")
swing_length = input.int(50, "قوة منطقة العرض والطلب")
max_zones    = input.int(5, "أحدث المناطق الظاهرة")
atr_mult     = input.float(2.0, "معامل أهداف ATR")
num_targets  = input.int(3, "عدد الأهداف")
label_offset = input.int(25, "إزاحة الملصقات لليمين")

// --- الحسابات ---
emaFast = ta.ema(close, basisLen)
emaSlow = ta.ema(close, slowLen)
atr = ta.atr(14)

// رسم الترند (EMA)
p1 = plot(emaFast, color=emaFast > emaSlow ? c_ema_up : c_ema_dn, linewidth=2, title="Fast EMA")
p2 = plot(emaSlow, color=color.new(color.gray, 70), linewidth=1, title="Slow EMA")
fill(p1, p2, color=color.new(color.gray, 92))

// --- مناطق العرض والطلب (قوة 50) ---
ph = ta.pivothigh(high, swing_length, swing_length)
pl = ta.pivotlow(low, swing_length, swing_length)

var box[] supply_boxes = array.new_box()
var box[] demand_boxes = array.new_box()

if not na(ph)
    nb = box.new(bar_index[swing_length], ph, bar_index, ph - (atr * 1.5), border_color=color.new(c_supply, 50), bgcolor=c_supply, extend=extend.right)
    array.push(supply_boxes, nb)
    if array.size(supply_boxes) > max_zones
        box.delete(array.shift(supply_boxes))

if not na(pl)
    nb = box.new(bar_index[swing_length], pl + (atr * 1.5), bar_index, pl, border_color=color.new(c_demand, 50), bgcolor=c_demand, extend=extend.right)
    array.push(demand_boxes, nb)
    if array.size(demand_boxes) > max_zones
        box.delete(array.shift(demand_boxes))

// --- نظام الأهداف والوقف (ثابت ومستقر) ---
var float stop_p = na
var float[] target_ps = array.new_float()
var label sl_label = na
var label[] target_labels = array.new_label()
var line sl_line = na
var line[] target_lines = array.new_line()

buy_sig = ta.crossover(emaFast, emaSlow)
sell_sig = ta.crossunder(emaFast, emaSlow)

if buy_sig or sell_sig
    // مسح البيانات القديمة عند كل إشارة جديدة
    label.delete(sl_label)
    line.delete(sl_line)
    for lb in target_labels
        label.delete(lb)
    for ln in target_lines
        line.delete(ln)
    array.clear(target_labels)
    array.clear(target_lines)
    array.clear(target_ps)

    float entry_p = close
    stop_p := buy_sig ? entry_p - (atr * atr_mult) : entry_p + (atr * atr_mult)
    
    // رسم خط الوقف الثابت
    sl_line := line.new(bar_index, stop_p, bar_index + 5, stop_p, color=c_supply, width=2, extend=extend.right)

    // حساب ورسم خطوط الأهداف الثلاثة
    for i = 1 to num_targets
        float t_p = buy_sig ? entry_p + (atr * atr_mult * i) : entry_p - (atr * atr_mult * i)
        array.push(target_ps, t_p)
        ln = line.new(bar_index, t_p, bar_index + 5, t_p, color=c_demand, width=1, style=line.style_dashed, extend=extend.right)
        array.push(target_lines, ln)

    // تنبيه مدمج
    alert("إشارة جديدة: " + (buy_sig ? "شراء" : "بيع") + " - الأهداف والوقف محددة على الشاشة", alert.freq_once_per_bar)

// --- تحديث موقع الملصقات المتحركة (Floating Labels) لضمان ظهورها جميعاً ---
if not na(stop_p)
    label.delete(sl_label)
    for lb in target_labels
        label.delete(lb)
    array.clear(target_labels)

    int label_x = math.round(bar_index + label_offset)
    
    // إظهار الوقف
    sl_label := label.new(label_x, stop_p, "SL: " + str.tostring(math.round_to_mintick(stop_p)), style=label.style_label_left, color=c_supply, textcolor=c_text, size=size.small)
    
    // إظهار جميع الأهداف الثلاثة دائماً
    for i = 0 to array.size(target_ps) - 1
        float t_p = array.get(target_ps, i)
        lb = label.new(label_x, t_p, "T" + str.tostring(i+1) + ": " + str.tostring(math.round_to_mintick(t_p)), style=label.style_label_left, color=c_demand, textcolor=c_text, size=size.small)
        array.push(target_labels, lb)

plotshape(buy_sig, style=shape.triangleup, location=location.belowbar, color=c_demand, size=size.small)
plotshape(sell_sig, style=shape.triangledown, location=location.abovebar, color=c_supply, size=size.small)
