indicator("Momentum Confluence System", shorttitle="MCS", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// 1. GLOBAL SETTINGS
// ══════════════════════════════════════════════════════════════════════════════
grp_general = "GENERAL SETTINGS"

i_waitForClose = input.bool(true, "Wait for Bar Close (Non-Repainting)", 
     tooltip="When enabled, signals only trigger after the bar closes, eliminating repainting. Recommended for live trading. Disable only for backtesting purposes.", 
     group=grp_general)

i_showDashboard = input.bool(true, "Show Dashboard Panel", 
     tooltip="Displays a comprehensive information panel showing macro bias, trend states, signal info, and current position status.", 
     group=grp_general)

i_showHistoricalZones = input.bool(true, "Show Historical TP/SL Zones", 
     tooltip="Draws persistent boxes on the chart showing take profit and stop loss zones for historical signals. Useful for reviewing past setups.", 
     group=grp_general)

i_maxHistoricalSignals = input.int(10, "Max Historical Signals Shown", minval=1, maxval=50, 
     tooltip="Limits the number of historical signal zones displayed to prevent chart clutter.", 
     group=grp_general)

// ══════════════════════════════════════════════════════════════════════════════
// 2. VISUAL CUSTOMIZATION
// ══════════════════════════════════════════════════════════════════════════════
grp_colors = "VISUAL SETTINGS"

c_f_bull = input.color(#00ff15, "Fast Ribbon Bullish", 
     tooltip="Color of the fast EMA ribbon when in bullish state (fast EMA above slow EMA).", 
     group=grp_colors)
c_f_bear = input.color(#b10606, "Fast Ribbon Bearish", 
     tooltip="Color of the fast EMA ribbon when in bearish state (fast EMA below slow EMA).", 
     group=grp_colors)

c_s_bull = input.color(#03bf31, "Slow Ribbon Bullish", 
     tooltip="Color of the slow EMA ribbon when in bullish state.", 
     group=grp_colors)
c_s_bear = input.color(#800101, "Slow Ribbon Bearish", 
     tooltip="Color of the slow EMA ribbon when in bearish state.", 
     group=grp_colors)

fill_opac = input.int(0, "Ribbon Transparency (0=Solid)", minval=0, maxval=100, 
     tooltip="Adjusts the transparency of the EMA ribbons. 0 = fully opaque, 100 = fully transparent.", 
     group=grp_colors)

i_showBackground = input.bool(false, "Show Trend Background Color", 
     tooltip="When enabled, displays a background color overlay indicating macro trend direction (white for bullish, black for bearish). Disabled by default for a cleaner chart.", 
     group=grp_colors)

c_bg_bull = input.color(color.white, "Background Bullish", 
     tooltip="Chart background color when macro trend is bullish (price above higher timeframe EMA).", 
     group=grp_colors)
c_bg_bear = input.color(#000000, "Background Bearish", 
     tooltip="Chart background color when macro trend is bearish (price below higher timeframe EMA).", 
     group=grp_colors)
bg_opac = input.int(78, "Background Transparency", minval=0, maxval=100, 
     tooltip="Transparency level of the trend background coloring.", 
     group=grp_colors)

c_sig_long = input.color(#1fff00, "Long Signal Marker", 
     tooltip="Color of the circle marker displayed when a long entry signal triggers.", 
     group=grp_colors)
c_sig_short = input.color(#b10606, "Short Signal Marker", 
     tooltip="Color of the circle marker displayed when a short entry signal triggers.", 
     group=grp_colors)
c_entry_line = input.color(color.gray, "Entry Line Color", 
     tooltip="Color of the dashed entry price reference line.", 
     group=grp_colors)
c_tp_line = input.color(#1fff00, "Take Profit Line/Label", 
     tooltip="Color used for take profit lines, zones, and labels.", 
     group=grp_colors)
c_sl_line = input.color(#b10606, "Stop Loss Line/Label", 
     tooltip="Color used for stop loss lines, zones, and labels.", 
     group=grp_colors)

// ══════════════════════════════════════════════════════════════════════════════
// 3. MACRO BIAS CONFIGURATION
// ══════════════════════════════════════════════════════════════════════════════
g_macro = "MACRO BIAS"

tf_macro = input.timeframe("240", "Macro Timeframe", 
     tooltip="Higher timeframe used to determine overall market direction. The indicator only generates long signals when price is above this timeframe's EMA, and short signals when below. Common settings: 240 (4H) for day trading, D (Daily) for swing trading.", 
     group=g_macro)

ma_len = input.int(8, "Macro EMA Length", minval=1, maxval=200, 
     tooltip="Period length for the macro timeframe EMA. Lower values (5-10) are more responsive, higher values (20-50) provide smoother trend identification.", 
     group=g_macro)

// ══════════════════════════════════════════════════════════════════════════════
// 4. SLOW TREND AND FAST MOMENTUM (EMA RIBBONS)
// ══════════════════════════════════════════════════════════════════════════════
g_micro = "SLOW TREND AND FAST MOMENTUM"

ema_f1_len = input.int(8, "Fast Ribbon - Fast EMA", minval=1, maxval=100, 
     tooltip="The faster EMA of the inner (fast) ribbon. Crossovers of this EMA over the slow EMA generate entry signals.", 
     group=g_micro)
ema_s1_len = input.int(16, "Fast Ribbon - Slow EMA", minval=1, maxval=100, 
     tooltip="The slower EMA of the inner (fast) ribbon. Acts as the signal line for the fast EMA crossovers.", 
     group=g_micro)

ema_f2_len = input.int(16, "Slow Ribbon - Fast EMA", minval=1, maxval=200, 
     tooltip="The faster EMA of the outer (slow) ribbon. This ribbon must be bullish/bearish to confirm signal direction.", 
     group=g_micro)
ema_s2_len = input.int(30, "Slow Ribbon - Slow EMA", minval=1, maxval=200, 
     tooltip="The slower EMA of the outer (slow) ribbon. Provides trend context for the micro signals.", 
     group=g_micro)

// ══════════════════════════════════════════════════════════════════════════════
// 5. CONFLUENCE FILTERS
// ══════════════════════════════════════════════════════════════════════════════
g_filters = "CONFLUENCE FILTERS"

// Volume Filter
i_useVolFilter = input.bool(false, "Enable Volume Confirmation", 
     tooltip="When enabled, signals only trigger when current volume exceeds the volume moving average. Filters out low-conviction moves. Disabled by default for cleaner signals—enable for additional confluence.", 
     group=g_filters)
i_volMaLen = input.int(20, "Volume MA Length", minval=1, maxval=100, 
     tooltip="Period for the volume moving average. Signals require volume > this MA value when filter is enabled.", 
     group=g_filters)
i_volMult = input.float(1.0, "Volume Threshold Multiplier", minval=0.5, maxval=3.0, step=0.1, 
     tooltip="Multiplier applied to volume MA. Value of 1.2 means volume must be 20% above average.", 
     group=g_filters)

// ADX Trend Strength Filter
i_useAdxFilter = input.bool(false, "Enable ADX Trend Filter", 
     tooltip="When enabled, signals only trigger when ADX is above the threshold, indicating a trending market. Filters out choppy, ranging conditions. Disabled by default—enable for additional trend strength confirmation.", 
     group=g_filters)
i_adxLen = input.int(14, "ADX Length", minval=1, maxval=50, 
     tooltip="Period for ADX calculation. Standard is 14.", 
     group=g_filters)
i_adxThresh = input.int(20, "ADX Threshold", minval=10, maxval=50, 
     tooltip="Minimum ADX value required for signals. Values above 20-25 indicate trending conditions. Below 20 typically indicates ranging/choppy market.", 
     group=g_filters)

// RSI Divergence Filter
i_useRsiDiv = input.bool(false, "Enable RSI Divergence Confirmation", 
     tooltip="When enabled, adds RSI divergence as an additional confluence factor. Bullish divergence strengthens long signals, bearish divergence strengthens shorts.", 
     group=g_filters)
i_rsiLen = input.int(14, "RSI Length", minval=1, maxval=50, 
     tooltip="Period for RSI calculation used in divergence detection.", 
     group=g_filters)
i_rsiDivLookback = input.int(10, "RSI Divergence Lookback", minval=3, maxval=30, 
     tooltip="Number of bars to look back when detecting price/RSI divergence patterns.", 
     group=g_filters)

// Signal Cooldown
i_useCooldown = input.bool(true, "Enable Signal Cooldown", 
     tooltip="Prevents consecutive signals within a specified number of bars. Reduces overtrading and allows positions to develop.", 
     group=g_filters)
i_cooldownBars = input.int(5, "Cooldown Period (Bars)", minval=1, maxval=50, 
     tooltip="Minimum number of bars that must pass after a signal before a new signal of the same direction can trigger.", 
     group=g_filters)

// Session Filter
i_useSession = input.bool(false, "Enable Session Filter", 
     tooltip="Restricts signals to specific trading hours. Useful for focusing on high-liquidity sessions or avoiding overnight gaps.", 
     group=g_filters)
i_sessionStart = input.session("0930-1600", "Trading Session (Exchange Time)", 
     tooltip="Time window during which signals are allowed. Format: HHMM-HHMM. Uses exchange timezone.", 
     group=g_filters)

// ══════════════════════════════════════════════════════════════════════════════
// 6. RISK MANAGEMENT
// ══════════════════════════════════════════════════════════════════════════════
g_risk = "RISK MANAGEMENT"

use_atr = input.bool(true, "Use ATR for TP/SL Calculation", 
     tooltip="When enabled, Take Profit and Stop Loss levels are calculated using Average True Range, adapting to current volatility conditions.", 
     group=g_risk)
atr_len = input.int(14, "ATR Length", minval=1, maxval=50, 
     tooltip="Period for ATR calculation. Standard is 14. Lower values react faster to volatility changes.", 
     group=g_risk)
sl_mult = input.float(1.5, "Stop Loss ATR Multiplier", minval=0.5, maxval=5.0, step=0.1, 
     tooltip="Multiplier applied to ATR for stop loss distance. Higher values = wider stops, fewer stopouts but larger losses when hit.", 
     group=g_risk)

// Multi-TP System
i_useMultiTp = input.bool(true, "Enable Multi-Target System", 
     tooltip="When enabled, displays three take profit levels (TP1, TP2, TP3) for scaling out of positions.", 
     group=g_risk)
tp1_mult = input.float(1.5, "TP1 ATR Multiplier", minval=0.5, maxval=5.0, step=0.1, 
     tooltip="First take profit target. Suggested: Close 50% of position here.", 
     group=g_risk)
tp2_mult = input.float(2.5, "TP2 ATR Multiplier", minval=1.0, maxval=8.0, step=0.1, 
     tooltip="Second take profit target. Suggested: Close 30% of position here and move stop to breakeven.", 
     group=g_risk)
tp3_mult = input.float(4.0, "TP3 ATR Multiplier", minval=1.5, maxval=12.0, step=0.1, 
     tooltip="Third take profit target (runner). Suggested: Let remaining 20% run to this level or use trailing stop.", 
     group=g_risk)

// Trailing Stop
i_useTrailing = input.bool(false, "Enable Trailing Stop Display", 
     tooltip="Displays a trailing stop level that follows price by the specified ATR distance. For visualization only - execute manually.", 
     group=g_risk)
i_trailMult = input.float(2.0, "Trailing Stop ATR Multiplier", minval=0.5, maxval=5.0, step=0.1, 
     tooltip="ATR multiplier for trailing stop distance. Tighter values capture more profit but risk early exits.", 
     group=g_risk)

// ══════════════════════════════════════════════════════════════════════════════
// 7. CORE CALCULATIONS
// ══════════════════════════════════════════════════════════════════════════════

// --- ADX Calculation Function ---
calcAdx(len) =>
    up = ta.change(high)
    down = -ta.change(low)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    trur = ta.rma(ta.tr, len)
    plus = fixnan(100 * ta.rma(plusDM, len) / trur)
    minus = fixnan(100 * ta.rma(minusDM, len) / trur)
    sum = plus + minus
    adx = 100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), len)
    adx

// --- RSI Divergence Detection ---
detectDivergence(src, rsiVal, lookback, isBullish) =>
    divergenceFound = false
    if isBullish
        // Bullish divergence: Price makes lower low, RSI makes higher low
        priceLow = ta.lowest(src, lookback)
        prevPriceLow = ta.lowest(src[lookback], lookback)
        rsiLow = ta.lowest(rsiVal, lookback)
        prevRsiLow = ta.lowest(rsiVal[lookback], lookback)
        divergenceFound := src <= priceLow and priceLow < prevPriceLow and rsiLow > prevRsiLow
    else
        // Bearish divergence: Price makes higher high, RSI makes lower high
        priceHigh = ta.highest(src, lookback)
        prevPriceHigh = ta.highest(src[lookback], lookback)
        rsiHigh = ta.highest(rsiVal, lookback)
        prevRsiHigh = ta.highest(rsiVal[lookback], lookback)
        divergenceFound := src >= priceHigh and priceHigh > prevPriceHigh and rsiHigh < prevRsiHigh
    divergenceFound

// --- Macro Trend (Higher Timeframe) ---
macro_ma = request.security(syminfo.tickerid, tf_macro, ta.ema(close, ma_len), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
macro_bull = close > macro_ma

// --- Micro EMAs (Current Timeframe) ---
ema1_f = ta.ema(close, ema_f1_len)
ema1_s = ta.ema(close, ema_s1_len)
ema2_f = ta.ema(close, ema_f2_len)
ema2_s = ta.ema(close, ema_s2_len)

f1_bull = ema1_f > ema1_s
f2_bull = ema2_f > ema2_s

// --- ATR Calculation ---
atr_v = ta.atr(atr_len)

// --- Volume Filter ---
volMa = ta.sma(volume, i_volMaLen)
volCondition = not i_useVolFilter or (volume > volMa * i_volMult)

// --- ADX Filter ---
adxValue = calcAdx(i_adxLen)
adxCondition = not i_useAdxFilter or (adxValue > i_adxThresh)

// --- RSI Divergence ---
rsiValue = ta.rsi(close, i_rsiLen)
bullDivergence = i_useRsiDiv ? detectDivergence(close, rsiValue, i_rsiDivLookback, true) : true
bearDivergence = i_useRsiDiv ? detectDivergence(close, rsiValue, i_rsiDivLookback, false) : true

// --- Session Filter ---
inSession = not i_useSession or not na(time(timeframe.period, i_sessionStart))

// --- Signal Cooldown Tracking ---
var int barsSinceLong = 100
var int barsSinceShort = 100
barsSinceLong := barsSinceLong + 1
barsSinceShort := barsSinceShort + 1

cooldownLongOk = not i_useCooldown or (barsSinceLong > i_cooldownBars)
cooldownShortOk = not i_useCooldown or (barsSinceShort > i_cooldownBars)

// --- Core Signal Logic ---
raw_long_sig = macro_bull and f2_bull and ta.crossover(ema1_f, ema1_s)
raw_short_sig = (not macro_bull) and (not f2_bull) and ta.crossunder(ema1_f, ema1_s)

// --- Apply All Filters ---
long_sig = raw_long_sig and volCondition and adxCondition and (not i_useRsiDiv or bullDivergence) and inSession and cooldownLongOk
short_sig = raw_short_sig and volCondition and adxCondition and (not i_useRsiDiv or bearDivergence) and inSession and cooldownShortOk

// --- Confirmation Logic (Non-Repainting) ---
confirmed = i_waitForClose ? barstate.isconfirmed : true
c_long = long_sig and confirmed
c_short = short_sig and confirmed

// --- Update Cooldown Counters ---
if c_long
    barsSinceLong := 0
if c_short
    barsSinceShort := 0

// ══════════════════════════════════════════════════════════════════════════════
// 8. POSITION TRACKING & TP/SL CALCULATION
// ══════════════════════════════════════════════════════════════════════════════

var float entry_p = na
var float tp1_p = na
var float tp2_p = na
var float tp3_p = na
var float sl_p = na
var float rr1_ratio = na
var float rr2_ratio = na
var float rr3_ratio = na
var int signal_dir = 0  // 1 = long, -1 = short, 0 = neutral
var int signal_bar = na
var float trailStop = na

// Calculate levels on new signals
if c_long and not na(atr_v) and atr_v > 0
    entry_p := close
    sl_p := close - (atr_v * sl_mult)
    tp1_p := close + (atr_v * tp1_mult)
    tp2_p := close + (atr_v * tp2_mult)
    tp3_p := close + (atr_v * tp3_mult)
    rr1_ratio := math.abs(tp1_p - entry_p) / math.abs(entry_p - sl_p)
    rr2_ratio := math.abs(tp2_p - entry_p) / math.abs(entry_p - sl_p)
    rr3_ratio := math.abs(tp3_p - entry_p) / math.abs(entry_p - sl_p)
    signal_dir := 1
    signal_bar := bar_index
    trailStop := close - (atr_v * i_trailMult)

if c_short and not na(atr_v) and atr_v > 0
    entry_p := close
    sl_p := close + (atr_v * sl_mult)
    tp1_p := close - (atr_v * tp1_mult)
    tp2_p := close - (atr_v * tp2_mult)
    tp3_p := close - (atr_v * tp3_mult)
    rr1_ratio := math.abs(entry_p - tp1_p) / math.abs(sl_p - entry_p)
    rr2_ratio := math.abs(entry_p - tp2_p) / math.abs(sl_p - entry_p)
    rr3_ratio := math.abs(entry_p - tp3_p) / math.abs(sl_p - entry_p)
    signal_dir := -1
    signal_bar := bar_index
    trailStop := close + (atr_v * i_trailMult)

// Update trailing stop
if i_useTrailing and not na(entry_p) and not na(atr_v)
    if signal_dir == 1
        newTrail = close - (atr_v * i_trailMult)
        trailStop := math.max(nz(trailStop, newTrail), newTrail)
    else if signal_dir == -1
        newTrail = close + (atr_v * i_trailMult)
        trailStop := math.min(nz(trailStop, newTrail), newTrail)

// ══════════════════════════════════════════════════════════════════════════════
// 9. VISUAL RENDERING
// ══════════════════════════════════════════════════════════════════════════════

// --- Background Trend Coloring ---
bgcolor(i_showBackground ? (macro_bull ? color.new(c_bg_bull, bg_opac) : color.new(c_bg_bear, bg_opac)) : na)

// --- EMA Ribbon Fills ---
p2_f = plot(ema2_f, color=na, display=display.none)
p2_s = plot(ema2_s, color=na, display=display.none)
fill(p2_f, p2_s, color=color.new(f2_bull ? c_s_bull : c_s_bear, fill_opac), title="Slow Ribbon Fill")

p1_f = plot(ema1_f, color=na, display=display.none)
p1_s = plot(ema1_s, color=na, display=display.none)
fill(p1_f, p1_s, color=color.new(f1_bull ? c_f_bull : c_f_bear, fill_opac), title="Fast Ribbon Fill")

// --- Signal Markers ---
plotshape(c_long, "Long Entry Signal", shape.circle, location.bottom, color=c_sig_long, size=size.tiny)
plotshape(c_short, "Short Entry Signal", shape.circle, location.top, color=c_sig_short, size=size.tiny)

// --- Historical Signal Zones (Boxes) ---
var box[] longBoxesTp = array.new_box()
var box[] longBoxesSl = array.new_box()
var box[] shortBoxesTp = array.new_box()
var box[] shortBoxesSl = array.new_box()

if i_showHistoricalZones and c_long and not na(atr_v)
    // Clean up old boxes if exceeding limit
    if array.size(longBoxesTp) >= i_maxHistoricalSignals
        box.delete(array.shift(longBoxesTp))
        box.delete(array.shift(longBoxesSl))
    
    tpBox = box.new(bar_index, tp1_p, bar_index + 20, entry_p, 
         bgcolor=color.new(c_tp_line, 85), border_color=c_tp_line, border_width=1)
    slBox = box.new(bar_index, entry_p, bar_index + 20, sl_p, 
         bgcolor=color.new(c_sl_line, 85), border_color=c_sl_line, border_width=1)
    array.push(longBoxesTp, tpBox)
    array.push(longBoxesSl, slBox)

if i_showHistoricalZones and c_short and not na(atr_v)
    if array.size(shortBoxesTp) >= i_maxHistoricalSignals
        box.delete(array.shift(shortBoxesTp))
        box.delete(array.shift(shortBoxesSl))
    
    tpBox = box.new(bar_index, entry_p, bar_index + 20, tp1_p, 
         bgcolor=color.new(c_tp_line, 85), border_color=c_tp_line, border_width=1)
    slBox = box.new(bar_index, sl_p, bar_index + 20, entry_p, 
         bgcolor=color.new(c_sl_line, 85), border_color=c_sl_line, border_width=1)
    array.push(shortBoxesTp, tpBox)
    array.push(shortBoxesSl, slBox)

// --- Dynamic TP/SL Lines (Current Signal) ---
var line l_ent = na
var line l_tp1 = na
var line l_tp2 = na
var line l_tp3 = na
var line l_sl = na
var line l_trail = na
var label lb_tp1 = na
var label lb_tp2 = na
var label lb_tp3 = na
var label lb_sl = na
var label lb_trail = na

if barstate.islast and not na(entry_p) and not na(signal_bar)
    // Delete previous lines/labels
    line.delete(l_ent)
    line.delete(l_tp1)
    line.delete(l_tp2)
    line.delete(l_tp3)
    line.delete(l_sl)
    line.delete(l_trail)
    label.delete(lb_tp1)
    label.delete(lb_tp2)
    label.delete(lb_tp3)
    label.delete(lb_sl)
    label.delete(lb_trail)
    
    ext = bar_index + 15
    
    // Entry line
    l_ent := line.new(signal_bar, entry_p, ext, entry_p, color=c_entry_line, style=line.style_dashed, width=1)
    
    // Stop Loss
    l_sl := line.new(signal_bar, sl_p, ext, sl_p, color=c_sl_line, width=2)
    lb_sl := label.new(ext, sl_p, "SL", textcolor=c_sl_line, style=label.style_label_left, color=color.new(color.black, 100), size=size.small)
    
    // Take Profit levels
    if i_useMultiTp
        l_tp1 := line.new(signal_bar, tp1_p, ext, tp1_p, color=c_tp_line, width=1)
        l_tp2 := line.new(signal_bar, tp2_p, ext, tp2_p, color=c_tp_line, width=2)
        l_tp3 := line.new(signal_bar, tp3_p, ext, tp3_p, color=c_tp_line, width=3)
        lb_tp1 := label.new(ext, tp1_p, "TP1 (RR:" + str.tostring(rr1_ratio, "#.##") + ")", textcolor=c_tp_line, style=label.style_label_left, color=color.new(color.black, 100), size=size.small)
        lb_tp2 := label.new(ext, tp2_p, "TP2 (RR:" + str.tostring(rr2_ratio, "#.##") + ")", textcolor=c_tp_line, style=label.style_label_left, color=color.new(color.black, 100), size=size.small)
        lb_tp3 := label.new(ext, tp3_p, "TP3 (RR:" + str.tostring(rr3_ratio, "#.##") + ")", textcolor=c_tp_line, style=label.style_label_left, color=color.new(color.black, 100), size=size.small)
    else
        l_tp1 := line.new(signal_bar, tp1_p, ext, tp1_p, color=c_tp_line, width=2)
        lb_tp1 := label.new(ext, tp1_p, "TP (RR:" + str.tostring(rr1_ratio, "#.##") + ")", textcolor=c_tp_line, style=label.style_label_left, color=color.new(color.black, 100), size=size.small)
    
    // Trailing Stop
    if i_useTrailing and not na(trailStop)
        l_trail := line.new(signal_bar, trailStop, ext, trailStop, color=color.orange, style=line.style_dotted, width=2)
        lb_trail := label.new(ext, trailStop, "TRAIL", textcolor=color.orange, style=label.style_label_left, color=color.new(color.black, 100), size=size.small)

// ══════════════════════════════════════════════════════════════════════════════
// 10. DASHBOARD PANEL
// ══════════════════════════════════════════════════════════════════════════════

var table dashboard = table.new(position.top_right, 2, 7, color.black, border_width=2, border_color=color.gray, frame_width=3, frame_color=color.white)

if i_showDashboard and barstate.islast
    // Header
    table.cell(dashboard, 0, 0, "MOMENTUM", text_color=color.white, bgcolor=color.black, text_size=size.normal, text_halign=text.align_center)
    table.cell(dashboard, 1, 0, "CONFLUENCE", text_color=#00d9ff, bgcolor=color.black, text_size=size.normal, text_halign=text.align_center)
    
    // Macro Bias
    table.cell(dashboard, 0, 1, "MACRO BIAS", text_color=color.white, bgcolor=color.black, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 1, macro_bull ? "BULLISH" : "BEARISH", 
         bgcolor=macro_bull ? color.new(c_bg_bull, 20) : color.new(c_bg_bear, 20), 
         text_color=macro_bull ? color.black : color.white, text_size=size.small, text_halign=text.align_center)
    
    // Slow Trend
    table.cell(dashboard, 0, 2, "SLOW TREND", text_color=color.white, bgcolor=color.black, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 2, f2_bull ? "BULLISH" : "BEARISH", 
         bgcolor=f2_bull ? color.new(c_s_bull, 30) : color.new(c_s_bear, 30), 
         text_color=color.white, text_size=size.small, text_halign=text.align_center)
    
    // Fast Momentum
    table.cell(dashboard, 0, 3, "FAST MOMENTUM", text_color=color.white, bgcolor=color.black, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 3, f1_bull ? "BULLISH" : "BEARISH", 
         bgcolor=f1_bull ? color.new(c_f_bull, 30) : color.new(c_f_bear, 30), 
         text_color=color.white, text_size=size.small, text_halign=text.align_center)
    
    // ADX Value
    table.cell(dashboard, 0, 4, "ADX STRENGTH", text_color=color.white, bgcolor=color.black, text_size=size.small, text_halign=text.align_left)
    adxStatus = adxValue > 40 ? "STRONG" : adxValue > i_adxThresh ? "TRENDING" : "WEAK"
    adxCol = adxValue > 40 ? color.new(#00ff88, 30) : adxValue > i_adxThresh ? color.new(#ffaa00, 30) : color.new(#ff4444, 30)
    table.cell(dashboard, 1, 4, str.tostring(adxValue, "#.#") + " " + adxStatus, bgcolor=adxCol, text_color=color.white, text_size=size.small, text_halign=text.align_center)
    
    // Volume Status
    volStatus = volume > volMa * 1.5 ? "HIGH" : volume > volMa ? "NORMAL" : "LOW"
    volCol = volume > volMa * 1.5 ? color.new(#00ff88, 30) : volume > volMa ? color.new(#ffaa00, 30) : color.new(#ff4444, 30)
    table.cell(dashboard, 0, 5, "VOLUME", text_color=color.white, bgcolor=color.black, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 5, volStatus, bgcolor=volCol, text_color=color.white, text_size=size.small, text_halign=text.align_center)
    
    // Signal Status
    table.cell(dashboard, 0, 6, "LAST SIGNAL", text_color=color.white, bgcolor=color.black, text_size=size.small, text_halign=text.align_left)
    sigText = signal_dir == 1 ? "LONG" : signal_dir == -1 ? "SHORT" : "NONE"
    sigCol = signal_dir == 1 ? color.new(c_sig_long, 30) : signal_dir == -1 ? color.new(c_sig_short, 30) : color.new(color.gray, 50)
    table.cell(dashboard, 1, 6, sigText, bgcolor=sigCol, text_color=color.white, text_size=size.small, text_halign=text.align_center)

// ══════════════════════════════════════════════════════════════════════════════
// 11. ALERTS
// ══════════════════════════════════════════════════════════════════════════════

alertcondition(c_long, title="Long Entry Signal", 
     message="MCS Long Signal: {{ticker}} on {{interval}}. Entry: {{close}}. Macro: Bullish, Slow Trend: Bullish, Fast Crossover confirmed.")

alertcondition(c_short, title="Short Entry Signal", 
     message="MCS Short Signal: {{ticker}} on {{interval}}. Entry: {{close}}. Macro: Bearish, Slow Trend: Bearish, Fast Crossover confirmed.")

alertcondition(c_long or c_short, title="Any Entry Signal", 
     message="MCS Signal: {{ticker}} on {{interval}} at {{close}}. Check chart for direction and levels.")

alertcondition(ta.crossover(ema1_f, ema1_s), title="Fast EMA Bullish Cross (Unfiltered)", 
     message="Fast EMA crossed above Slow EMA on {{ticker}} {{interval}}. Check confluence filters.")

alertcondition(ta.crossunder(ema1_f, ema1_s), title="Fast EMA Bearish Cross (Unfiltered)", 
     message="Fast EMA crossed below Slow EMA on {{ticker}} {{interval}}. Check confluence filters.")

alertcondition(ta.cross(close, macro_ma), title="Macro Trend Change", 
     message="{{ticker}}: Price crossed the Macro EMA on {{interval}}. Potential trend shift.")

alertcondition(adxValue > i_adxThresh and adxValue[1] <= i_adxThresh, title="ADX Entered Trending Zone", 
     message="{{ticker}} ADX crossed above threshold. Market entering trending phase.")

alertcondition(adxValue < i_adxThresh and adxValue[1] >= i_adxThresh, title="ADX Exited Trending Zone", 
     message="{{ticker}} ADX dropped below threshold. Market may be ranging.")

// ══════════════════════════════════════════════════════════════════════════════
// END OF SCRIPT
// ══════════════════════════════════════════════════════════════════════════════
