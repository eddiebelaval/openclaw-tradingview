//@version=5
//@version=5
strategy("MA20 vs MA60 Long+Short (1% riesgo, stop en MA60)",
     overlay=true, pyramiding=0,
     initial_capital=10000,
     commission_type=strategy.commission.percent, commission_value=0.0)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
maType     = input.string("SMA", "Tipo de media", options=["SMA", "EMA"])
fastLen    = input.int(20, "MA rápida", minval=1)
slowLen    = input.int(60, "MA lenta",  minval=1)

riskPct    = input.float(1.0, "Riesgo % por operación", step=0.1, minval=0.1)

bufferMode = input.string("Ticks", "Buffer del stop respecto a MA60", options=["Ticks", "Porcentaje"])
bufferTicks= input.int(10, "Buffer (ticks) si modo=Tiks", minval=0)
bufferPct  = input.float(0.05, "Buffer (%) si modo=Porcentaje", step=0.01, minval=0.0)

useCloseOnCross = input.bool(true, "Cerrar por cruce contrario (además del stop)")

// ─────────────────────────────────────────────────────────────────────────────
// Helpers
ma(src, len) =>
    maType == "EMA" ? ta.ema(src, len) : ta.sma(src, len)

getBuffer(value) =>
    bufferMode == "Ticks" ? (bufferTicks * syminfo.mintick) : (value * bufferPct / 100.0)

// ─────────────────────────────────────────────────────────────────────────────
// MAs
fastMA = ma(close, fastLen)
slowMA = ma(close, slowLen)

plot(fastMA, "MA 20", linewidth=2)
plot(slowMA, "MA 60", linewidth=2)

// Señales (cruces)
longSignal  = ta.crossover(fastMA, slowMA)
shortSignal = ta.crossunder(fastMA, slowMA)

// ─────────────────────────────────────────────────────────────────────────────
// Stops basados en MA60 (con buffer)
buf = getBuffer(slowMA)

longStopCandidate  = slowMA - buf
shortStopCandidate = slowMA + buf

var float longStop  = na
var float shortStop = na

// Valor monetario a arriesgar
riskCash = strategy.equity * (riskPct / 100.0)
pv = math.max(syminfo.pointvalue, 1.0)  // seguridad

// ─────────────────────────────────────────────────────────────────────────────
// Entradas con sizing por riesgo (distancia al stop)
canLong  = strategy.position_size <= 0
canShort = strategy.position_size >= 0

// Entry LONG
if longSignal and canLong
    // Si veníamos short, lo cerramos
    if strategy.position_size < 0
        strategy.close("S")
        shortStop := na

    // Stop inicial debajo de MA60
    stop0 = longStopCandidate
    dist  = close - stop0

    // Validación: stop debe estar por debajo del precio
    if dist > syminfo.mintick
        qty = riskCash / (dist * pv)
        // Guardamos stop y entramos
        longStop := stop0
        strategy.entry("L", strategy.long, qty=qty)

// Entry SHORT
if shortSignal and canShort
    // Si veníamos long, lo cerramos
    if strategy.position_size > 0
        strategy.close("L")
        longStop := na

    // Stop inicial encima de MA60
    stop0 = shortStopCandidate
    dist  = stop0 - close

    // Validación: stop debe estar por encima del precio
    if dist > syminfo.mintick
        qty = riskCash / (dist * pv)
        shortStop := stop0
        strategy.entry("S", strategy.short, qty=qty)

// ─────────────────────────────────────────────────────────────────────────────
// Trailing stop con MA60: solo se aprieta (no se aleja)
if strategy.position_size > 0
    // Solo sube (aprieta) el stop long
    longStop := na(longStop) ? longStopCandidate : math.max(longStop, longStopCandidate)
    strategy.exit("L-STOP", "L", stop=longStop)

if strategy.position_size < 0
    // Solo baja (aprieta) el stop short
    shortStop := na(shortStop) ? shortStopCandidate : math.min(shortStop, shortStopCandidate)
    strategy.exit("S-STOP", "S", stop=shortStop)

// Cierre adicional por cruce contrario (opcional)
if useCloseOnCross and strategy.position_size > 0 and shortSignal
    strategy.close("L")
    longStop := na

if useCloseOnCross and strategy.position_size < 0 and longSignal
    strategy.close("S")
    shortStop := na

// ─────────────────────────────────────────────────────────────────────────────
// Visualización de stops
plot(strategy.position_size > 0 ? longStop : na,  "Stop Long (MA60-buf)", style=plot.style_linebr, linewidth=2)
plot(strategy.position_size < 0 ? shortStop : na, "Stop Short (MA60+buf)", style=plot.style_linebr, linewidth=2)
