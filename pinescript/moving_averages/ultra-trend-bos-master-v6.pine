//@version=6
indicator("Ultra Trend & BoS Master v6 (Filled)", overlay=true)

// --- INPUTS ---
// SuperTrend 1 (Core)
st1_period = input.int(14, "ST 1 Period", minval=1, group="SuperTrend 1")
st1_mult = input.float(3.0, "ST 1 Multiplier", step=0.1, group="SuperTrend 1")

// SuperTrend 2 (Fast)
st2_period = input.int(12, "ST 2 Period", minval=1, group="SuperTrend 2")
st2_mult = input.float(2.0, "ST 2 Multiplier", step=0.1, group="SuperTrend 2")

// EMA Ribbon
ema_fast_len = input.int(20, "EMA Ribbon Fast", minval=1, group="Filters")
ema_slow_len = input.int(50, "EMA Ribbon Slow", minval=1, group="Filters")

// BoS Logic - Default: OFF (false)
bos_period = input.int(5, "BoS Lookback (Bars)", minval=2, group="Filters")
use_bos = input.bool(false, "Require BoS Confirmation", group="Filters")

// --- CALCULATIONS ---
// SuperTrend 1 & 2
[st1_val, st1_dir] = ta.supertrend(st1_mult, st1_period)
[st2_val, st2_dir] = ta.supertrend(st2_mult, st2_period)

// EMA Ribbon
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
ribbon_bullish = ema_fast > ema_slow

// BoS (Break of Structure)
high_target = ta.highest(high[1], bos_period)
low_target = ta.lowest(low[1], bos_period)
bos_long_ok = close > high_target
bos_short_ok = close < low_target

// --- SIGNAL LOGIC ---
long_entry = ta.crossunder(st1_dir, 0) and st2_dir < 0 and ribbon_bullish and (not use_bos or bos_long_ok)
short_entry = ta.crossover(st1_dir, 0) and st2_dir > 0 and not ribbon_bullish and (not use_bos or bos_short_ok)

// --- VISUALS ---
// Plot SuperTrends (Dolgu için ID'ler eklendi)
p_st1_bull = plot(st1_dir < 0 ? st1_val : na, "ST 1 Bull", color=color.new(color.green, 20), linewidth=2, style=plot.style_linebr)
p_st1_bear = plot(st1_dir > 0 ? st1_val : na, "ST 1 Bear", color=color.new(color.red, 20), linewidth=2, style=plot.style_linebr)

p_st2_bull = plot(st2_dir < 0 ? st2_val : na, "ST 2 Bull", color=color.new(color.lime, 40), linewidth=1, style=plot.style_linebr)
p_st2_bear = plot(st2_dir > 0 ? st2_val : na, "ST 2 Bear", color=color.new(color.orange, 40), linewidth=1, style=plot.style_linebr)

// **YENİ: SuperTrend Band Fill**
// İki çizgi arası trend yönüne göre renklenir (Şeffaflık: 85)
fill(p_st1_bull, p_st2_bull, color=color.new(color.green, 85), title="ST Band Bull Fill")
fill(p_st1_bear, p_st2_bear, color=color.new(color.red, 85), title="ST Band Bear Fill")

// Fill Ribbon (EMA) - Korundu
p1 = plot(ema_fast, color=color.new(color.white, 80))
p2 = plot(ema_slow, color=color.new(color.white, 80))
fill(p1, p2, color=ribbon_bullish ? color.new(color.green, 90) : color.new(color.red, 90))

// Arrow Shapes (Ok İşaretleri) - Korundu
plotshape(long_entry, title="Buy Arrow", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.normal)
plotshape(short_entry, title="Sell Arrow", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.normal)

// --- MODERN DASHBOARD --- - Korundu
var table main_table = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 40), border_color=color.new(color.gray, 70), border_width=1)

if barstate.islast
    table.cell(main_table, 0, 0, "DASHBOARD", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 20))
    table.cell(main_table, 1, 0, "STATUS", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 20))
    
    table.cell(main_table, 0, 1, "SuperTrend 1", text_color=color.white, text_halign=text.align_left)
    table.cell(main_table, 1, 1, st1_dir < 0 ? "BULL" : "BEAR", bgcolor=st1_dir < 0 ? color.green : color.red)
    
    table.cell(main_table, 0, 2, "SuperTrend 2", text_color=color.white, text_halign=text.align_left)
    table.cell(main_table, 1, 2, st2_dir < 0 ? "BULL" : "BEAR", bgcolor=st2_dir < 0 ? color.green : color.red)
    
    table.cell(main_table, 0, 3, "Ribbon", text_color=color.white, text_halign=text.align_left)
    table.cell(main_table, 1, 3, ribbon_bullish ? "UPTREND" : "DOWNTREND", bgcolor=ribbon_bullish ? color.green : color.red)
    
    bool is_all_aligned = (st1_dir < 0 and st2_dir < 0 and ribbon_bullish) or (st1_dir > 0 and st2_dir > 0 and not ribbon_bullish)
    table.cell(main_table, 0, 4, "Alignment", text_color=color.white, text_halign=text.align_left)
    table.cell(main_table, 1, 4, is_all_aligned ? "READY" : "WAITING", bgcolor=is_all_aligned ? color.blue : color.gray)
