//@version=5
indicator(title="J - 200sma Band Tracker", overlay=true, max_labels_count=500)

// Inputs
src = close
length = 200
mult = input.float(2.5, minval=0.001, maxval=50, title="StdDev")
bb_mult = 0.2
inner_band_mult = input.float(0.1, minval=0.001, maxval=1.0, title="Inner Band Mult")

// Main Bollinger Bands
[basis, upper, lower] = ta.bb(src, length, mult)

// Plot main 200 SMA and bands
plot(basis, "200SMA", color=color.new(#8B3A3A, 0), linewidth=2)
p1 = plot(upper, "Upper", color=color.new(#B8860B, 0), style=plot.style_cross)
p2 = plot(lower, "Lower", color=color.new(#4682B4, 0), style=plot.style_cross)

// Bar colors for extreme moves
barcolor(close > upper or close < lower ? color.new(#6A5ACD, 0) : na)

// Multi-deviation bands
[_, u1, l1] = ta.bb(src, length, 1)
[_, u2, l2] = ta.bb(src, length, 2)
[_, u3, l3] = ta.bb(src, length, 3)

// Hidden plots for fills
pu3 = plot(u3, display=display.none)
pu2 = plot(u2, display=display.none)
pu1 = plot(u1, display=display.none)
pl1 = plot(l1, display=display.none)
pl2 = plot(l2, display=display.none)
pl3 = plot(l3, display=display.none)

// Muted fills — soft dusty tones, high transparency
fill(pu1, pu2, color=color.new(#5F9EA0, 82), title="Zone 1 - Upper Mild")
fill(pu2, pu3, color=color.new(#3B7A57, 82), title="Zone 2 - Upper Strong")
fill(pl2, pl3, color=color.new(#8B3A3A, 82), title="Zone 3 - Lower Strong")
fill(pl1, pl2, color=color.new(#A0522D, 82), title="Zone 4 - Lower Mild")

// Narrow Bollinger Band
[_, upper_narrow, lower_narrow] = ta.bb(src, length, bb_mult)
[_, upper_inner, lower_inner] = ta.bb(src, length, inner_band_mult)

// Narrow band fill — very subtle
mid_narrow = ta.sma(src, length)
band_color = close > mid_narrow ? color.new(#556B2F, 88) : color.new(#8B3A3A, 88)

plot_upper = plot(upper_narrow, display=display.none)
plot_lower = plot(lower_narrow, display=display.none)
fill(plot_upper, plot_lower, color=band_color, title="200SMA Band Background")

// Inner band fill — slightly more visible than narrow
mid_inner = ta.sma(src, length)
inner_band_color = close > mid_inner ? color.new(#2F6B6B, 78) : color.new(#6B3A6B, 78)

plot_upper_inner = plot(upper_inner, display=display.none)
plot_lower_inner = plot(lower_inner, display=display.none)
fill(plot_upper_inner, plot_lower_inner, color=inner_band_color, title="Inner Band")
