//@version=6
indicator("AT TP/SL", shorttitle="NC_Nazli Alpha", overlay=true, format=format.price, precision=2)

// Inputs
coeff = input.float(1.0, "Multiplier", step=0.1)
ap = input.int(14, "Common Period", minval=1)
src = input.source(close, "Source")
showSignals = input.bool(true, "Show Signals?")
noVolumeData = input.bool(false, "Change calculation (no volume data)?")

slAtrMult  = input.float(1.0, "SL ATR Multiplier", step=0.1)
tp1AtrMult = input.float(1.0, "TP1 ATR Multiplier", step=0.1)
tp2AtrMult = input.float(2.0, "TP2 ATR Multiplier", step=0.1)
tp3AtrMult = input.float(3.0, "TP3 ATR Multiplier", step=0.1)
extendBars = input.int(20, "TP/SL Line Length", minval=5)

// Calculations
atr = ta.sma(ta.tr, ap)
upT = low - atr * coeff
downT = high + atr * coeff

float alphaTrend = na
alphaTrend := (noVolumeData ? ta.rsi(src, ap) >= 50 : ta.mfi(hlc3, ap) >= 50) ? (upT < nz(alphaTrend[1]) ? nz(alphaTrend[1]) : upT) : (downT > nz(alphaTrend[1]) ? nz(alphaTrend[1]) : downT)

// Colors and plots
trendColor = alphaTrend > alphaTrend[2] ? #00E60F : alphaTrend < alphaTrend[2] ? #80000B : alphaTrend[1] > alphaTrend[3] ? #00E60F : #80000B
p1 = plot(alphaTrend, color=color.new(#0022FC, 0), linewidth=3, title="AlphaTrend")
p2 = plot(alphaTrend[2], color=color.new(#FC0400, 0), linewidth=3, title="AlphaTrend Shifted")
fill(p1, p2, color=trendColor)

// Signals
buySignal = ta.crossover(alphaTrend, alphaTrend[2])
sellSignal = ta.crossunder(alphaTrend, alphaTrend[2])

k1 = ta.barssince(buySignal)
k2 = ta.barssince(sellSignal)
o1 = ta.barssince(buySignal[1])
o2 = ta.barssince(sellSignal[1])

finalBuy = buySignal and o1 > k2
finalSell = sellSignal and o2 > k1

plotshape(finalBuy and showSignals ? alphaTrend[2] * 0.9999 : na, title="BUY", text="BUY", location=location.absolute, style=shape.labelup, size=size.tiny, color=color.new(#0022FC, 0), textcolor=color.white)
plotshape(finalSell and showSignals ? alphaTrend[2] * 1.0001 : na, title="SELL", text="SELL", location=location.absolute, style=shape.labeldown, size=size.tiny, color=color.new(color.maroon, 0), textcolor=color.white)

// Last trade values
var float entryPrice = na
var float slPrice = na
var float tp1Price = na
var float tp2Price = na
var float tp3Price = na
var string lastSide = ""

// Line objects
var line entryLine = na
var line slLine = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na

// Label objects
var label entryLabel = na
var label slLabel = na
var label tp1Label = na
var label tp2Label = na
var label tp3Label = na

// Helper: clear old drawings
clearDrawings() =>
    if not na(entryLine)
        line.delete(entryLine)
    if not na(slLine)
        line.delete(slLine)
    if not na(tp1Line)
        line.delete(tp1Line)
    if not na(tp2Line)
        line.delete(tp2Line)
    if not na(tp3Line)
        line.delete(tp3Line)
    if not na(entryLabel)
        label.delete(entryLabel)
    if not na(slLabel)
        label.delete(slLabel)
    if not na(tp1Label)
        label.delete(tp1Label)
    if not na(tp2Label)
        label.delete(tp2Label)
    if not na(tp3Label)
        label.delete(tp3Label)

// Helper: build alert JSON
buildAlertMessage(_action, _entry, _sl, _tp1, _tp2, _tp3) =>
    msg = "{"
    msg += '"title":"Islem Onerisi",'
    msg += '"action":"' + _action + '",'
    msg += '"symbol":"' + syminfo.ticker + '",'
    msg += '"price":"' + str.tostring(_entry, format.mintick) + '",'
    msg += '"sl":"' + str.tostring(_sl, format.mintick) + '",'
    msg += '"tp1":"' + str.tostring(_tp1, format.mintick) + '",'
    msg += '"tp2":"' + str.tostring(_tp2, format.mintick) + '",'
    msg += '"tp3":"' + str.tostring(_tp3, format.mintick) + '",'
    msg += '"time":"5M",'
    msg += '"test":"yes"'
    msg += "}"
    msg

// BUY setup
if finalBuy and barstate.isconfirmed
    entryPrice := close
    slPrice := entryPrice - atr * slAtrMult
    tp1Price := entryPrice + atr * tp1AtrMult
    tp2Price := entryPrice + atr * tp2AtrMult
    tp3Price := entryPrice + atr * tp3AtrMult
    lastSide := "BUY"

    clearDrawings()

    entryLine := line.new(bar_index, entryPrice, bar_index + extendBars, entryPrice, extend=extend.none, width=2, color=color.blue)
    slLine := line.new(bar_index, slPrice, bar_index + extendBars, slPrice, extend=extend.none, width=2, color=color.red)
    tp1Line := line.new(bar_index, tp1Price, bar_index + extendBars, tp1Price, extend=extend.none, width=2, color=color.green)
    tp2Line := line.new(bar_index, tp2Price, bar_index + extendBars, tp2Price, extend=extend.none, width=2, color=color.green)
    tp3Line := line.new(bar_index, tp3Price, bar_index + extendBars, tp3Price, extend=extend.none, width=2, color=color.green)

    entryLabel := label.new(bar_index + extendBars, entryPrice, "ENTRY " + str.tostring(entryPrice, format.mintick), style=label.style_label_left, textcolor=color.white, color=color.blue)
    slLabel := label.new(bar_index + extendBars, slPrice, "SL " + str.tostring(slPrice, format.mintick), style=label.style_label_left, textcolor=color.white, color=color.red)
    tp1Label := label.new(bar_index + extendBars, tp1Price, "TP1 " + str.tostring(tp1Price, format.mintick), style=label.style_label_left, textcolor=color.white, color=color.green)
    tp2Label := label.new(bar_index + extendBars, tp2Price, "TP2 " + str.tostring(tp2Price, format.mintick), style=label.style_label_left, textcolor=color.white, color=color.green)
    tp3Label := label.new(bar_index + extendBars, tp3Price, "TP3 " + str.tostring(tp3Price, format.mintick), style=label.style_label_left, textcolor=color.white, color=color.green)

    alert(buildAlertMessage("BUY", entryPrice, slPrice, tp1Price, tp2Price, tp3Price), alert.freq_once_per_bar_close)

// SELL setup
if finalSell and barstate.isconfirmed
    entryPrice := close
    slPrice := entryPrice + atr * slAtrMult
    tp1Price := entryPrice - atr * tp1AtrMult
    tp2Price := entryPrice - atr * tp2AtrMult
    tp3Price := entryPrice - atr * tp3AtrMult
    lastSide := "SELL"

    clearDrawings()

    entryLine := line.new(bar_index, entryPrice, bar_index + extendBars, entryPrice, extend=extend.none, width=2, color=color.blue)
    slLine := line.new(bar_index, slPrice, bar_index + extendBars, slPrice, extend=extend.none, width=2, color=color.red)
    tp1Line := line.new(bar_index, tp1Price, bar_index + extendBars, tp1Price, extend=extend.none, width=2, color=color.green)
    tp2Line := line.new(bar_index, tp2Price, bar_index + extendBars, tp2Price, extend=extend.none, width=2, color=color.green)
    tp3Line := line.new(bar_index, tp3Price, bar_index + extendBars, tp3Price, extend=extend.none, width=2, color=color.green)

    entryLabel := label.new(bar_index + extendBars, entryPrice, "ENTRY " + str.tostring(entryPrice, format.mintick), style=label.style_label_left, textcolor=color.white, color=color.blue)
    slLabel := label.new(bar_index + extendBars, slPrice, "SL " + str.tostring(slPrice, format.mintick), style=label.style_label_left, textcolor=color.white, color=color.red)
    tp1Label := label.new(bar_index + extendBars, tp1Price, "TP1 " + str.tostring(tp1Price, format.mintick), style=label.style_label_left, textcolor=color.white, color=color.green)
    tp2Label := label.new(bar_index + extendBars, tp2Price, "TP2 " + str.tostring(tp2Price, format.mintick), style=label.style_label_left, textcolor=color.white, color=color.green)
    tp3Label := label.new(bar_index + extendBars, tp3Price, "TP3 " + str.tostring(tp3Price, format.mintick), style=label.style_label_left, textcolor=color.white, color=color.green)

    alert(buildAlertMessage("SELL", entryPrice, slPrice, tp1Price, tp2Price, tp3Price), alert.freq_once_per_bar_close)

// Optional static alerts
alertcondition(finalBuy, title="AT BUY", message="AlphaTrend BUY")
alertcondition(finalSell, title="AT SELL", message="AlphaTrend SELL")
