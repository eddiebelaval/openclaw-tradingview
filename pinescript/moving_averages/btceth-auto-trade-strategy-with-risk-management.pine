//@version=6
strategy("EMA RSI PineConnector Bot", overlay=true)

// ===== PINECONNECTOR SETTINGS =====
LicenseID = "8839876542677"
symbol = syminfo.ticker
riskvalue = "0.01"

// ===== INDICATORS =====
fastEMA = ta.ema(close, 50)
slowEMA = ta.ema(close, 200)
rsi = ta.rsi(close, 14)

// ===== SIGNAL CONDITIONS =====
buySignal = ta.crossover(fastEMA, slowEMA) and rsi > 50
sellSignal = ta.crossunder(fastEMA, slowEMA) and rsi < 50

// ===== PLOT =====
plot(fastEMA, color=color.green, title="EMA 50")
plot(slowEMA, color=color.red, title="EMA 200")

// ===== STOP LOSS & TAKE PROFIT =====
sl = input.int(300, "Stop Loss")
tp = input.int(600, "Take Profit")

// ===== ALERT FORMAT =====
buyMessage = LicenseID + ",buy," + symbol + ",risk=" + riskvalue + ",sl=" + str.tostring(sl) + ",tp=" + str.tostring(tp)
sellMessage = LicenseID + ",sell," + symbol + ",risk=" + riskvalue + ",sl=" + str.tostring(sl) + ",tp=" + str.tostring(tp)

// ===== TRADE EXECUTION =====
if buySignal
    strategy.entry("BUY", strategy.long)
    alert(buyMessage, alert.freq_once_per_bar_close)

if sellSignal
    strategy.entry("SELL", strategy.short)
    alert(sellMessage, alert.freq_once_per_bar_close)
