//@version=5
// 表示名を "Pocket entry L" に統一
indicator("Pocket entry L", shorttitle="Pocket entry L", overlay=true)

// --- パラメーター設定 ---
upper_ma_len   = input.int(80, title="赤線 (上位MA相当) 期間") 
main_ma_len    = input.int(20, title="青線 (1h 20MA) 期間")
lower_ma_len   = input.int(4,  title="白線 (15m 20MA相当) 期間")
// デフォルト設定：0.13%
near_threshold = input.float(0.13, title="青線からの距離閾値 (%)", step=0.01)
// デフォルト設定：0.05%
ma_gap_threshold = input.float(0.05, title="赤青の乖離制限 (%)", step=0.01)

// --- 4時間足の安値切り上げ判定 ---
tf_4h_low_current = request.security(syminfo.tickerid, "240", ta.lowest(low, 2))
tf_4h_low_prev    = request.security(syminfo.tickerid, "240", low[2])
is_4h_low_up = tf_4h_low_current >= (tf_4h_low_prev * 0.999)

// --- 移動平均線の計算 ---
ma_red   = ta.sma(close, upper_ma_len)
ma_blue  = ta.sma(close, main_ma_len)
ma_white = ta.sma(close, lower_ma_len)

// --- 条件判定ロジック ---

// 1. 移動平均線の位置と距離の判定
ma_gap = math.abs(ma_red - ma_blue) / ma_red * 100
is_perfect_order = ma_red < ma_blue  
is_near_cross    = ma_red >= ma_blue and ma_gap <= ma_gap_threshold 

// 2. 赤線の向き
is_red_not_down = ma_red >= (ma_red[1] * 0.9999) 
is_trend_up = (is_perfect_order or is_near_cross) and is_red_not_down and is_4h_low_up

// 3. 距離判定（青線ぶち抜き、または近くにいる）
dist_close = math.abs(close - ma_blue) / ma_blue * 100
dist_low   = math.abs(low - ma_blue) / ma_blue * 100
is_break_through = open < ma_blue and close > ma_blue
is_near_blue = dist_close <= near_threshold or dist_low <= (near_threshold * 0.7) or is_break_through

// 4. 実体・更新判定
body_high = math.max(open, close)
body_low  = math.min(open, close)
body_size = body_high - body_low
body_above_blue = body_high - math.max(body_low, ma_blue)
is_min_body_above = (body_above_blue / body_size) >= (is_break_through ? 0.1 : 0.3)
is_price_conquer_mas = close > ma_white and close > ma_blue

// 前実体の高値を超える (同値以上で判定をわずかに緩和)
prev_body_high = math.max(open[1], close[1])
is_break_prev_body = close >= prev_body_high

// --- サイン判定 ---
raw_condition = is_trend_up and is_near_blue and is_min_body_above and is_price_conquer_mas and is_break_prev_body
long_condition = raw_condition and not raw_condition[1]

// 色の決定
sig_color = is_perfect_order ? color.yellow : color.purple

// --- サインの表示 ---
plotchar(long_condition, char="▲", location=location.belowbar, color=sig_color, size=size.tiny, title="Pocket entry L")
