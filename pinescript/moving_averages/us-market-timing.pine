//@version=5
strategy("US Market Timing", overlay = true, default_qty_type = strategy.percent_of_equity, default_qty_value=100, currency = currency.USD, initial_capital=100000)

// 
// This is a long only strategy.  
// This is a position trading strategy targeting multi-month time period trades.
//
// Original intention was just for QQQ position trading, but found good results on all US indexes
// Individual stocks, sector ETFs, crypto, commodities results hit or miss from initial analysis, 
// but not researched or the intention.  
//
//
// SPX and QQQ are the root indexes used to trigger buy and sells.  Since QQQ's inception date is 1999, results only go back to 1999.  
// The IXIC (nasdaq composite) could be used in QQQ's place to look at other time periods prior to 1999.  But 1999-2026 results are better with
// QQQ versus IXIC so that is what this strategy uses.
//
// Below are some ticker hypothetical worth noting.  Keep in mind, tradingview gives way better result analysis and taxes and fees not taken into account.  
//
// QQQ - 2759%, max drawdown 28.79%, B&H 978%, 1999-March 2026 (Includes dot com nasdaq crash and 2008 financial crisis)
// QLD - 19,944.79%, max drawdown 20.82%, B&H 5970.90%, 20006-March 2026 (Doesn't include dot com nasdaq crash, would be bigger drawdown)
// MDY - 1229.83%, max drawdown 14.32%, B&H 799.20%, 1999-March 2026
// SPY - 822.70%, max drawdown 13.98%, B&H 402.73%, 1999-March 2026
// SSO - 4826.12%, max drawdown 22.23%, B&H 1060.57%, 2006-March 2026
// IWM - 1164.54%, max drawdown 16.30%, B&H 440.99%, 2000-March 2026
// ITA - 1594.74%, max drawdown 15.95%, B&H 898.52%, 2006-March 2026   (only sector ETF I have seen that could be worth considering with this strategy)
// 
// For those that love rollercoaster investing, too much drawdown for me
//
// TQQQ - 36,633.12%, max drawdown 35.71%, B&H 17096.39%, 2010-March 2026 (Doesn't include dot com nasdaq crash or 2008 financial crisis, drawdowns would be worse)
// UPRO - 14,500.15%, max drawdown 31.92%, B&H 7153.32%, June 2009-March 2026(Doesn't include dot com crash or 2008 financial crisis)
//


// System uses SPX (S&P 500) as root for signals.
spxClose = request.security("SPX", 'D', close)
spxLow = request.security("SPX", 'D', low)
spxShortMA = ta.sma(spxClose, 7)
spxLongMA = ta.sma(spxClose, 107)
spx21ema = ta.ema(spxClose, 21)

// For QLD trading, better results using root QQQ price action.  Note, the QQQ signals are still rooted from SPX price action.
qqqClose = request.security("QQQ", 'D', close)
qqqLow = request.security("QQQ", 'D', low)
qqq14ema = ta.ema(qqqClose, 14)
qqq21ema = ta.ema(qqqClose, 21)
qqq50sma = ta.sma(qqqClose, 50)

// Current ticker moving averages for plotting on chart
shortMA = ta.sma(close, 7)
longMA = ta.sma(close, 107)
_14ema = ta.ema(close, 14)
_21ema = ta.ema(close, 21)
_50sma = ta.sma(close, 50)
_200sma = ta.sma(close, 200)

// Static Initial Stop Loss Calculation, 3.5% from initial buy point, no trail
// Note: Using QQQ for stop signal, even if trading QLD
var float qqqPriceAtEntry = na
longLossPerc = input.float(title="Long Stop Loss (%)", minval=0.0, step=0.1, defval=3.5) / 100

// Update the entry price tracker when a trade opens
if (strategy.position_size > 0 and strategy.position_size[1] <= 0)
    qqqPriceAtEntry := qqqClose

// Calculate the stop level based on QQQ's price at entry
longStopPrice = nz(qqqPriceAtEntry) * (1 - longLossPerc)

// ADX Calculation function
getADX() =>
    [p, m, a] = ta.dmi(13, 13)
    a // Return only the ADX value

// ENTRY LOGIC
//
// SPX Low > 21EMA for 4 consecutive days 
//              AND 
// QQQ Low > 14EMA and QQQ Low > 21EMA 
//              AND
// QQQ Close > last 3 closes.
//              AND
// The SPX ADX is above 15, indicating a threshhold of upward directional movement
//
spxLowAbove21Ema4daysInARow = (spxLow > spx21ema and spxLow[1] > spx21ema[1] and spxLow[2] > spx21ema[2] and spxLow[3] > spx21ema[3])
qqqLowAboveKeyEmas = qqqLow > qqq14ema and qqqLow > qqq21ema 
qqqNotShowingWeakness = (not (qqqClose < qqqClose[1] and qqqClose < qqqClose[2] and qqqClose < qqqClose[3] ))
spxAdxValue = request.security("SPX", "D", getADX())
isTrending = spxAdxValue > 16

longCondition = spxLowAbove21Ema4daysInARow and qqqLowAboveKeyEmas and qqqNotShowingWeakness and isTrending


// EXIT LOGIC

// 1. Trend-Based Exit (Loose Stop)
// Instead of requiring a crossunder ON the same bar as the price check, 
// we check if the Short MA is below the Long MA AND price is confirming the weakness.
spxBearishCross = spxShortMA < spxLongMA[1]
spxPriceWeak    = spxClose < spxShortMA
qqqPriceWeak    = qqqClose < qqq21ema

// This will now fire if SPX is in a bearish state AND QQQ confirms it, 
// rather than needing the "cross" to happen today.
trendEstablishedLooseStop = spxBearishCross and spxPriceWeak and qqqPriceWeak

// 2. Initial Safety Exit (Tight Stop)
// Removed the 'and qqqLow < qqq50sma' requirement if you want the 3.5% stop to be absolute.
// Or, if you keep it, it now acts as a "Double Confirmation" stop.
stopLevelHit    = qqqLow < longStopPrice
belowFiftySMA   = qqqLow < qqq50sma

// Logic: Exit if the 3.5% stop is hit, provided we are also below the 50 SMA.
// If you want the 3.5% stop to work regardless of the 50 SMA, 
// change 'and' to 'or' below.
initialBuyTightStop = (not na(qqqPriceAtEntry)) and stopLevelHit and belowFiftySMA

// Combine
exitCondition = trendEstablishedLooseStop or initialBuyTightStop
  

// Date Range Filter, QQQ is used as a root and it's inception was 1999, so that's as far back as we go
startDate = input.int(title="Start Date",
     defval=10, minval=1, maxval=24)
startMonth = input.int(title="Start Month",
     defval=3, minval=1, maxval=12)
startYear = input.int(title="Start Year",
     defval=1999, minval=1999, maxval=2500)
inDateRange = (time >= timestamp(syminfo.timezone, startYear, startMonth, startDate, 0, 0))

// Strategy Execution
if longCondition and inDateRange
    strategy.entry("Buy", strategy.long)

if exitCondition and inDateRange
    strategy.close("Buy")

// Reset tracker when position is closed
if (strategy.position_size == 0)
    qqqPriceAtEntry := na

// Plotting & Background
r = color.r(chart.bg_color)
g = color.g(chart.bg_color)
b = color.b(chart.bg_color)
bool darkMode = r < 80 and g < 80 and b < 80
color color21ema = color.green
color colorShortMA = color.new(color.purple, 30)
color colorLongMA = color.new(color.blue, 35)
color buyBackground = color.new(#90EE90, 50)

plot(_14ema, color=color.new(color.black,0), title="21 EMA")
plot(_21ema, color=color21ema, title="21 EMA")
plot(_50sma, color=color.new(color.red, 0), title="50 SMA")
plot(_200sma, color=color.new(color.gray, 0), title="200 SMA")
plot(shortMA, color=colorShortMA, title="7 SMA")
plot(longMA, color=colorLongMA, title="107 SMA")

mycolor = strategy.position_size > 0 ? buyBackground : na
bgcolor(mycolor)
