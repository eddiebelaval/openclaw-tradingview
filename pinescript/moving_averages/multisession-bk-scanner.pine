tiempoMinimoImb   = input.int(1, "Timeframe mínimo (min)", minval = 1, group = grupoImbalances)
mostrarTextoImb   = input.bool(true, "Mostrar texto de clasificación", group = grupoImbalances, inline = "txt")
colorTextoImb     = input.color(color.black, "Color del texto", group = grupoImbalances, inline = "txt")
