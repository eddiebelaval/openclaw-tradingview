textColorBear = input.color(color.new(color.red, 0), "Color texto Bajista", group = grupoCHOCH, inline = "txt")
textPosition  = input.string("Izquierda", "Posición del texto", options=["Izquierda", "Centro", "Derecha"], group = grupoCHOCH, inline = "txt")
//════════════════════════════════════════════════════════════════════════════════════════════════════
// TIPOS PERSONALIZADOS
//════════════════════════════════════════════════════════════════════════════════════════════════════
type LineaSesion
    line  ln
    float nivel
    int   inicio
    int   fin
    bool  activa
    bool  esMaximo
    int   idSesion
    color cl
    bool  esExtendida

// Tipos para CHOCH
type MSS
    line  ln
    box   bx
    float price
    int   index
    int   time

type pivotPoint
    float h
    int   hi
    bool  hx
    float l
    int   li
    bool  lx
//════════════════════════════════════════════════════════════════════════════════════════════════════
// VARIABLES GLOBALES
//════════════════════════════════════════════════════════════════════════════════════════════════════
var array<LineaSesion> lineasActivas    = array.new<LineaSesion>()
var array<LineaSesion> lineasExtendidas = array.new<LineaSesion>()


//════════════════════════════════════════════════════════════════════════════════════════════════════
// FUNCIONES PARA CLASIFICACIÓN DE IMBALANCES
//════════════════════════════════════════════════════════════════════════════════════════════════════
f_clasificarFVG(esAlcista) =>
    cuerpo = math.abs(close - open)
    rango = high - low
    rangoSafe = rango == 0 ? 1 : rango
    
    inicioCuerpo = math.min(open, close)
    finCuerpo = math.max(open, close)
    centroCuerpo = (inicioCuerpo + finCuerpo) / 2
    posicionRelativa = (centroCuerpo - low) / rangoSafe
    
    string tipo = "NO_CLASIFICADO"
    
    if esAlcista
        if posicionRelativa < 0.3
            tipo := "RECHAZO"
        else if posicionRelativa > 0.7
            tipo := "RUPTURA"
        else
            tipo := "CONSOLIDACION"
    else
        if posicionRelativa > 0.7
            tipo := "RECHAZO"
        else if posicionRelativa < 0.4
            tipo := "RUPTURA"
        else
            tipo := "CONSOLIDACION"
    tipo

f_textoPorTipo(tipo, esAlcista) =>
    direccion = esAlcista ? "ALCISTA" : "BAJISTA"
    
    if tipo == "RECHAZO"
        "DEBIL"
    else if tipo == "RUPTURA"
        "REBOTE FUERTE " + direccion
    else if tipo == "CONSOLIDACION"
        "REBOTE SUAVE " + direccion
    else
        ""
//════════════════════════════════════════════════════════════════════════════════════════════════════
// FUNCIONES AUXILIARES PARA CHOCH
//════════════════════════════════════════════════════════════════════════════════════════════════====

// Convertir tamaño de texto
getTextSizeCHOCH(size) =>
    switch size
        'Tiny'   => size.tiny
        'Small'  => size.small
        'Normal' => size.normal
        'Large'  => size.large
        'Huge'   => size.huge
        => size.normal

// Convertir estilo de línea
getLineStyleCHOCH(style) =>
    switch style
        'Sólida'   => line.style_solid
        'Punteada' => line.style_dotted
        'Rayada'   => line.style_dashed
        => line.style_solid

// Convertir posición de texto (horizontal)
getTextAlignCHOCH(position) =>
    switch position
        'Izquierda' => text.align_left
        'Centro'    => text.align_center
        'Derecha'   => text.align_right
        => text.align_left

// Tipos y variables para CHOCH
var array<MSS> bullishCHOCH = array.new<MSS>(0)
var array<MSS> bearishCHOCH = array.new<MSS>(0)
var pivotPoint pp = pivotPoint.new()
var int shiftCHOCH = 0

// Calcular límite de tiempo
getTimeLimitCHOCH(value, unit) =>
    multiplier = switch unit
        'Minutos' => 60 * 1000
        'Horas'   => 60 * 60 * 1000
        'Días'    => 24 * 60 * 60 * 1000
        => 60 * 60 * 1000
    timenow - (value * multiplier)

// Limpiar arrays de CHOCH
clearArrayCHOCH(arr) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            mss = array.get(arr, i)
            if not na(mss.ln)
                line.delete(mss.ln)
            if not na(mss.bx)
                box.delete(mss.bx)
            array.remove(arr, i)

// Eliminar CHOCH antiguos
removeOldCHOCH(arr, limit) =>
    if useLastHours and array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            mss = array.get(arr, i)
            if mss.time < limit
                if not na(mss.ln)
                    line.delete(mss.ln)
                if not na(mss.bx)
                    box.delete(mss.bx)
                array.remove(arr, i)

//════════════════════════════════════════════════════════════════════════════════════════════════════
// FUNCIONES AUXILIARES PARA SESIONES
//════════════════════════════════════════════════════════════════════════════════════════════════════
f_crearEtiqueta(_barra, _precio, _texto, _color, _estilo) =>
    label.new(_barra, _precio, _texto,
         color = color.new(#ffffff, 60),
         textcolor = _color,
         size = size.tiny,
         style = _estilo)

f_sesionActiva(_horario) =>
    not na(time(timeframe.period, _horario, tz))

f_actualizarSesion(_id, _activa, _nombre, _color, _fondo) =>
    var float maxSes = na
    var float minSes = na
    var bool sesionPrevia = false
    var line lineaMax = na
    var line lineaMin = na
    var box fondoBox = na
    var label etiquetaSesion = na
    var int inicioSesion = na
    
    if _activa and not sesionPrevia
        maxSes := high
        minSes := low
        sesionPrevia := true
        inicioSesion := bar_index
        
        if _fondo
            fondoBox := box.new(bar_index, maxSes, bar_index, minSes,
                               bgcolor = color.new(_color, transparenciaFondo),
                               border_color = na)
        
        lineaMax := line.new(bar_index, maxSes, bar_index, maxSes, 
                            color = _color, width = 2, style = line.style_solid)
        lineaMin := line.new(bar_index, minSes, bar_index, minSes,
                            color = _color, width = 2, style = line.style_solid)
        
        etiquetaSesion := f_crearEtiqueta(bar_index, maxSes * 1.001, str.upper(_nombre), _color, label.style_label_center)
        
        array.push(lineasActivas, LineaSesion.new(lineaMax, maxSes, bar_index, bar_index, true, true, _id, _color, false))
        array.push(lineasActivas, LineaSesion.new(lineaMin, minSes, bar_index, bar_index, true, false, _id, _color, false))
    
    if _activa and sesionPrevia
        maxSes := math.max(high, maxSes)
        minSes := math.min(low, minSes)
        
        if _fondo and not na(fondoBox)
            box.set_top(fondoBox, maxSes)
            box.set_rightbottom(fondoBox, bar_index, minSes)
        
        for i = array.size(lineasActivas) - 1 to 0
            linea = array.get(lineasActivas, i)
            if linea.idSesion == _id and linea.activa and not linea.esExtendida
                if linea.esMaximo
                    linea.ln.set_y1(maxSes)
                    linea.ln.set_xy2(bar_index, maxSes)
                    linea.nivel := maxSes
                else
                    linea.ln.set_y1(minSes)
                    linea.ln.set_xy2(bar_index, minSes)
                    linea.nivel := minSes
                linea.fin := bar_index
        
        if not na(etiquetaSesion) and not na(inicioSesion)
            centroSesion = int(math.avg(inicioSesion, bar_index))
            label.set_x(etiquetaSesion, centroSesion)
            label.set_y(etiquetaSesion, maxSes * 1.001)
    
    if not _activa and sesionPrevia
        sesionPrevia := false
        
        if not na(etiquetaSesion) and not na(inicioSesion)
            centroFinal = int(math.avg(inicioSesion, bar_index))
            label.set_x(etiquetaSesion, centroFinal)
            label.set_y(etiquetaSesion, maxSes * 1.001)
        
        if extenderLineas
            for i = array.size(lineasActivas) - 1 to 0
                linea = array.get(lineasActivas, i)
                if linea.idSesion == _id and linea.activa and not linea.esExtendida
                    styleLinea = formatoExtension == "punteada" ? line.style_dashed : line.style_solid
                    nuevaLinea = line.new(linea.inicio, linea.nivel, bar_index, linea.nivel,
                                        color = linea.cl, width = 1, style = styleLinea, extend = extend.right)
                    
                    array.push(lineasExtendidas, LineaSesion.new(nuevaLinea, linea.nivel, 
                                                                 linea.inicio, bar_index, true, 
                                                                 linea.esMaximo, _id, linea.cl, true))
                    
                    linea.activa := false


//════════════════════════════════════════════════════════════════════════════════════════════════════
// EJECUCIÓN DE SESIONES (controlado por mostrarSesiones)
//════════════════════════════════════════════════════════════════════════════════════════════════════
if mostrarSesiones
    activaNY  = f_sesionActiva(horarioNY)
    activaLDN = f_sesionActiva(horarioLDN)
    activaTKO = f_sesionActiva(horarioTKO)
    activaSYD = f_sesionActiva(horarioSYD)
    
    if showNY
        f_actualizarSesion(1, activaNY, "NEW YORK", colorNY, fondoNY)
    if showLDN
        f_actualizarSesion(2, activaLDN, "LONDON", colorLDN, fondoLDN)
    if showTKO
        f_actualizarSesion(3, activaTKO, "TOKYO", colorTKO, fondoTKO)
    if showSYD
        f_actualizarSesion(4, activaSYD, "SIDNEY", colorSYD, fondoSYD)
    
    for i = 0 to array.size(lineasActivas) - 1
        linea = array.get(lineasActivas, i)
        if linea.activa and not linea.esExtendida
            linea.ln.set_x2(bar_index)
            linea.fin := bar_index
    
    if mitigarAlCruzar
        tamanoArray = array.size(lineasExtendidas)
        if tamanoArray > 0
            for i = tamanoArray - 1 to 0
                linea = array.get(lineasExtendidas, i)
                
                bool eliminar = false
                if requerirCierre
                    if linea.esMaximo
                        eliminar := close > linea.nivel
                    else
                        eliminar := close < linea.nivel
                else
                    if linea.esMaximo
                        eliminar := high >= linea.nivel
                    else
                        eliminar := low <= linea.nivel
                
                if eliminar
                    linea.ln.delete()
                    array.remove(lineasExtendidas, i)


//════════════════════════════════════════════════════════════════════════════════════════════════════
// EMAS - CÁLCULOS Y PLOTS (controlado por mostrarEMAs)
// //════════════════════════════════════════════════════════════════════════════════════════════════════

ema1 = ta.ema(close, 32)
ema2 = ta.ema(close, 50)
ema3 = ta.ema(close, emaLen3)
ema4 = ta.ema(close, 200)
ema5 = ta.ema(close, emaLen5)
ema6 = ta.ema(close, emaLen6)

// Plots FUERA del if (usando operador ternario)
pEma1 = plot(mostrarEMAs and showEma1 ? ema1 : na, color = colorEma1, linewidth = 2, title = "EMA 1")
pEma2 = plot(mostrarEMAs and showEma2 ? ema2 : na, color = colorEma2, linewidth = 2, title = "EMA 2")
pEma3 = plot(mostrarEMAs and showEma3 ? ema3 : na, color = colorEma3, linewidth = 2, title = "EMA 3")
pEma4 = plot(mostrarEMAs and showEma4 ? ema4 : na, color = colorEma4, linewidth = 2, title = "EMA 4")
pEma5 = plot(mostrarEMAs and showEma5 ? ema5 : na, color = colorEma5, linewidth = 2, title = "EMA 5")
pEma6 = plot(mostrarEMAs and showEma6 ? ema6 : na, color = colorEma6, linewidth = 2, title = "EMA 6")

// Fill también FUERA del if
fill(pEma1, pEma2, color = mostrarEMAs ? zoneColor : na)


//════════════════════════════════════════════════════════════════════════════════════════════════════
// PREV DAY HIGH/LOW (controlado por mostrarPrevDay)
//════════════════════════════════════════════════════════════════════════════════════════════════════
if mostrarPrevDay
    prevHigh = request.security(syminfo.tickerid, "D", high[1])
    prevLow  = request.security(syminfo.tickerid, "D", low[1])
    
    isNewDayPrev_flag = ta.change(time("D")) != 0
    
    estiloMax = estiloMaxDiario == "Punteada" ? line.style_dashed : line.style_solid
    estiloMin = estiloMinDiario == "Punteada" ? line.style_dashed : line.style_solid
    
    var line  prevDayHighLine = na
    var line  prevDayLowLine  = na
    var label prevDayHighLbl  = na
    var label prevDayLowLbl   = na
    
    if isNewDayPrev_flag
        line.delete(prevDayHighLine)
        line.delete(prevDayLowLine)
        label.delete(prevDayHighLbl)
        label.delete(prevDayLowLbl)
    
        prevDayHighLine := line.new(bar_index, prevHigh, bar_index, prevHigh,
            extend = extend.none, color = colorMaxDiario, width = anchoLineaDiario, style = estiloMax)
        prevDayLowLine  := line.new(bar_index, prevLow,  bar_index, prevLow,
            extend = extend.none, color = colorMinDiario, width = anchoLineaDiario, style = estiloMin)
    
    if not na(prevDayHighLine)
        line.set_x2(prevDayHighLine, bar_index)
        line.set_y1(prevDayHighLine, prevHigh)
        line.set_y2(prevDayHighLine, prevHigh)
        
        label.delete(prevDayHighLbl)
        prevDayHighLbl := label.new(
             bar_index,
             prevHigh * (1 + offsetHighPrev / 100.0),
             "MAX anterior D",
             style = label.style_label_center,
             size  = sizePrevLbl,
             color = color.new(color.yellow, 100),
             textcolor = color.new(color.blue, 0),
             yloc = yloc.price)
    
    if not na(prevDayLowLine)
        line.set_x2(prevDayLowLine, bar_index)
        line.set_y1(prevDayLowLine, prevLow)
        line.set_y2(prevDayLowLine, prevLow)
        
        label.delete(prevDayLowLbl)
        prevDayLowLbl := label.new(
             bar_index,
             prevLow * (1 - offsetLowPrev / 100.0),
             "MIN anterior D",
             style = label.style_label_center,
             size  = sizePrevLbl,
             color = color.new(color.yellow, 100),
             textcolor = color.new(color.blue, 0),
             yloc = yloc.price)


//════════════════════════════════════════════════════════════════════════════════════════════════════
// OSCILADORES - CÁLCULOS
//════════════════════════════════════════════════════════════════════════════════════════════════════
kLen = 9
kSma = 6
dSma = 2

k_5 = request.security(syminfo.tickerid, "5", ta.sma(ta.stoch(close, high, low, kLen), kSma))
d_5 = request.security(syminfo.tickerid, "5", ta.sma(k_5, dSma))

k = k_5
d = d_5

isOversold   = k < 20
isOverbought = k > 80

rsi_base_15   = request.security(syminfo.tickerid, "15", ta.rsi(srcRSI, lengthRSI))
k_rsi_raw_15  = request.security(syminfo.tickerid, "15", ta.stoch(rsi_base_15, rsi_base_15, rsi_base_15, lengthStochRSI))
k_rsi_15      = request.security(syminfo.tickerid, "15", ta.sma(k_rsi_raw_15, smoothK_rsi))
d_rsi_15      = request.security(syminfo.tickerid, "15", ta.sma(k_rsi_15, smoothD_rsi))

isStochRsiOB = k_rsi_15 > 80
isStochRsiOS = k_rsi_15 < 20

//════════════════════════════════════════════════════════════════════════════════════════════════════
// CHOCH - CÁLCULOS (controlado por mostrarCHOCH)
//════════════════════════════════════════════════════════════════════════════════════════════════====

// Detectar pivotes
pp_h = ta.pivothigh(pivotLength, pivotLength)
pp_l = ta.pivotlow(pivotLength, pivotLength)

// Actualizar pivote alto
if not na(pp_h)
    pp.h  := pp_h
    pp.hx := false
    pp.hi := bar_index - pivotLength

// Actualizar pivote bajo
if not na(pp_l)
    pp.l  := pp_l
    pp.lx := false
    pp.li := bar_index - pivotLength

// Calcular límite de tiempo
timeLimitCHOCH = useLastHours ? getTimeLimitCHOCH(lastValue, timeUnit) : 0

// Limpiar arrays si se desactiva
if not mostrarCHOCH
    clearArrayCHOCH(bullishCHOCH)
    clearArrayCHOCH(bearishCHOCH)
    shiftCHOCH := 0

// Detectar CHOCH
if mostrarCHOCH
    // Eliminar antiguos
    removeOldCHOCH(bullishCHOCH, timeLimitCHOCH)
    removeOldCHOCH(bearishCHOCH, timeLimitCHOCH)

    // CHOCH ALCISTA
    if close[1] > pp.h and not pp.hx
        pp.hx := true

        if shiftCHOCH == -1 or shiftCHOCH == 0
            shouldAdd = switch showOption
                'First' => array.size(bullishCHOCH) < 1
                'Last'  => true
                'All'   => true

            if shouldAdd
                newMSS = MSS.new()
                newMSS.price := pp.h
                newMSS.index := pp.hi
                newMSS.time  := time_close

                // Línea CHOCH alcista
                newMSS.ln := line.new(
                    x1=pp.hi, y1=pp.h,
                    x2=bar_index - 1, y2=pp.h,
                    color=bullColor,
                    width=lineWidth,
                    style=getLineStyleCHOCH(lineStyle)
                )

                // Texto CHOCH pegado al pivot alto (origen de la línea)
                if showText
                    label.new(
                        pp.hi,                           // barra del pivot
                        pp.h + syminfo.mintick * 10,     // un poco por encima del pivot
                        "CHOCH",
                        style     = label.style_label_down,
                        textcolor = textColorBull,
                        color     = color.new(color.white, 100),
                        size      = getTextSizeCHOCH(textSize)
                    )

                newMSS.bx := na
                array.unshift(bullishCHOCH, newMSS)

            if showOption == 'Last' and array.size(bullishCHOCH) > 1
                mss = array.pop(bullishCHOCH)
                if not na(mss.ln)
                    line.delete(mss.ln)
                if not na(mss.bx)
                    box.delete(mss.bx)

        shiftCHOCH := 1

    // CHOCH BAJISTA
    if close[1] < pp.l and not pp.lx
        pp.lx := true

        if shiftCHOCH == 1 or shiftCHOCH == 0
            shouldAdd = switch showOption
                'First' => array.size(bearishCHOCH) < 1
                'Last'  => true
                'All'   => true

            if shouldAdd
                newMSS = MSS.new()
                newMSS.price := pp.l
                newMSS.index := pp.li
                newMSS.time  := time_close

                // Línea CHOCH bajista
                newMSS.ln := line.new(
                    x1=pp.li, y1=pp.l,
                    x2=bar_index - 1, y2=pp.l,
                    color=bearColor,
                    width=lineWidth,
                    style=getLineStyleCHOCH(lineStyle)
                )

                // Texto CHOCH pegado al pivot bajo (origen de la línea)
                if showText
                    label.new(
                        pp.li,                           // barra del pivot
                        pp.l - syminfo.mintick * 10,     // un poco por debajo del pivot
                        "CHOCH",
                        style     = label.style_label_up,
                        textcolor = textColorBear,
                        color     = color.new(color.white, 100),
                        size      = getTextSizeCHOCH(textSize)
                    )

                newMSS.bx := na
                array.unshift(bearishCHOCH, newMSS)

            if showOption == 'Last' and array.size(bearishCHOCH) > 1
                mss = array.pop(bearishCHOCH)
                if not na(mss.ln)
                    line.delete(mss.ln)
                if not na(mss.bx)
                    box.delete(mss.bx)

        shiftCHOCH := -1


//════════════════════════════════════════════════════════════════════════════════════════════════════
// TABLA DE ESTOCÁSTICOS (controlado por mostrarTablaStoch)
//════════════════════════════════════════════════════════════════════════════════════════════════════

// Función para analizar estocástico (FUERA del if)
f_analizarEstocastico(_tf, _fila) =>
    k_tf = request.security(syminfo.tickerid, _tf, ta.sma(ta.stoch(close, high, low, 9), 6))
    d_tf = request.security(syminfo.tickerid, _tf, ta.sma(k_tf, 2))
    
    esOS = k_tf < 25
    esOB = k_tf > 75
    zonaText = esOS ? "SOBREVENTA" : esOB ? "SOBRECOMPRA" : "NEUTRAL"
    zonaColor = esOS ? color.new(color.orange, 0) : esOB ? color.new(color.purple, 0) : color.new(color.green, 0)
    
    pendiente = k_tf - k_tf[2]
    direccion = pendiente > 0 ? "SUBIDA" : pendiente < 0 ? "BAJADA" : "PLANO"
    
    cruceAlcista = ta.crossover(k_tf, d_tf)
    cruceBajista = ta.crossunder(k_tf, d_tf)
    
    string senalText = ""
    color senalColor = color.new(color.green, 0)
    
    if cruceAlcista and esOS
        senalText := "COMPRA FUERTE"
        senalColor := color.new(#0dcd23, 0)
    else if cruceAlcista
        senalText := "CRUCE ALCISTA"
        senalColor := color.new(#0dcd23, 0)
    else if cruceBajista and esOB
        senalText := "VENTA FUERTE"
        senalColor := color.new(#fda800, 0)
    else if cruceBajista
        senalText := "CRUCE BAJISTA"
        senalColor := color.new(#fda800, 0)
    else
        senalText := direccion
        senalColor := color.new(color.green, 0)
    
    table.cell(tblStoch, 0, _fila, _tf, text_size = size.tiny)
    table.cell(tblStoch, 1, _fila, str.tostring(k_tf, "#.0") + "/" + str.tostring(d_tf, "#.0"), text_size = size.tiny)
    table.cell(tblStoch, 2, _fila, zonaText, text_size = size.tiny)
    table.cell(tblStoch, 3, _fila, senalText, text_size = size.tiny, bgcolor = senalColor)
    table.cell_set_bgcolor(tblStoch, 1, _fila, zonaColor)
    table.cell_set_bgcolor(tblStoch, 2, _fila, zonaColor)

// Ejecutar condicionalmente
if mostrarTablaStoch
    if barstate.isfirst
        table.cell(tblStoch, 0, 0, "Estocástico", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
        table.cell(tblStoch, 1, 0, "Valor", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
        table.cell(tblStoch, 2, 0, "Zona", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
        table.cell(tblStoch, 3, 0, "Señal", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    
    f_analizarEstocastico("1", 1)
    f_analizarEstocastico("3", 2)
    f_analizarEstocastico("5", 3)
    f_analizarEstocastico("15", 4)
//════════════════════════════════════════════════════════════════════════════════════════════════════
// TABLA DE PENDIENTES DE EMAS (controlado por mostrarTablaEMAs)
//════════════════════════════════════════════════════════════════════════════════════════════════════

// Primero la función (FUERA del if)
f_state_and_color(_slope) =>
    _isUp   = _slope > slopeThresh
    _isDown = _slope < -slopeThresh
    _state  = _isUp ? "ALCISTA" : _isDown ? "BAJISTA" : "NEUTRA"
    _bg     = _isUp ? color.new(color.purple, 0) : _isDown ? color.new(color.orange, 0) : color.new(color.red, 0)
    [_state, _bg]

// Luego el if con el resto
if mostrarTablaEMAs
    ema1Slope_full = ema1 - ema1[emaSlopeLen]
    ema2Slope_full = ema2 - ema2[emaSlopeLen]
    ema3Slope_full = ema3 - ema3[emaSlopeLen]
    ema4Slope_full = ema4 - ema4[emaSlopeLen]
    ema5Slope_full = ema5 - ema5[emaSlopeLen]
    ema6Slope_full = ema6 - ema6[emaSlopeLen]
    
    [stateEma1, bgEma1] = f_state_and_color(ema1Slope_full)
    [stateEma2, bgEma2] = f_state_and_color(ema2Slope_full)
    [stateEma3, bgEma3] = f_state_and_color(ema3Slope_full)
    [stateEma4, bgEma4] = f_state_and_color(ema4Slope_full)
    [stateEma5, bgEma5] = f_state_and_color(ema5Slope_full)
    [stateEma6, bgEma6] = f_state_and_color(ema6Slope_full)
    
    var tblSlope = table.new(position.bottom_left, 2, 7, border_width = 1)
    
    if barstate.isfirst
        table.cell(tblSlope, 0, 0, "EMA", text_color = color.black, bgcolor = color.new(color.gray, 80), text_size = size.tiny)
        table.cell(tblSlope, 1, 0, "Pendiente", text_color = color.black, bgcolor = color.new(color.gray, 80), text_size = size.tiny)
    
    table.cell(tblSlope, 0, 1, "EMA " + str.tostring(emaLen6) + " (R)", text_color = color.black, text_size = size.tiny)
    table.cell(tblSlope, 1, 1, stateEma6, text_color = color.black, text_size = size.tiny, bgcolor = bgEma6)
    
    table.cell(tblSlope, 0, 2, "EMA " + str.tostring(emaLen1), text_color = color.black, text_size = size.tiny)
    table.cell(tblSlope, 1, 2, stateEma1, text_color = color.black, text_size = size.tiny, bgcolor = bgEma1)
    
    table.cell(tblSlope, 0, 3, "EMA " + str.tostring(emaLen2), text_color = color.black, text_size = size.tiny)
    table.cell(tblSlope, 1, 3, stateEma2, text_color = color.black, text_size = size.tiny, bgcolor = bgEma2)
    
    table.cell(tblSlope, 0, 4, "EMA " + str.tostring(emaLen3), text_color = color.black, text_size = size.tiny)
    table.cell(tblSlope, 1, 4, stateEma3, text_color = color.black, text_size = size.tiny, bgcolor = bgEma3)
    
    table.cell(tblSlope, 0, 5, "EMA " + str.tostring(emaLen4), text_color = color.black, text_size = size.tiny)
    table.cell(tblSlope, 1, 5, stateEma4, text_color = color.black, text_size = size.tiny, bgcolor = bgEma4)
    
    table.cell(tblSlope, 0, 6, "EMA " + str.tostring(emaLen5), text_color = color.black, text_size = size.tiny)
    table.cell(tblSlope, 1, 6, stateEma5, text_color = color.black, text_size = size.tiny, bgcolor = bgEma5)

//════════════════════════════════════════════════════════════════════════════════════════════════════
// IMBALANCES (controlado por mostrarImbalances)
//════════════════════════════════════════════════════════════════════════════════════════════════════
if mostrarImbalances and (not timeframe.isintraday or timeframe.multiplier >= tiempoMinimoImb)
    cuerpo2Sup = math.max(close[1], open[1])
    cuerpo2Inf = math.min(close[1], open[1])
    
    var array<box> imbalancesActivos = array.new<box>()
    var array<float> tops = array.new<float>()
    var array<float> bottoms = array.new<float>()
    var array<bool> tipos = array.new<bool>()
    
    // CASO ALCISTA
    if close[1] > open[1]
        mecha3TocaCuerpo = low > cuerpo2Inf and low < cuerpo2Sup
        mecha1TocaCuerpo = high[2] > cuerpo2Inf and high[2] < cuerpo2Sup
        mecha3NoMasLejos = low >= high[2]
        
        if mecha3TocaCuerpo and mecha1TocaCuerpo and mecha3NoMasLejos
            tipoFVG = f_clasificarFVG(true)
            textoTipo = mostrarTextoImb ? f_textoPorTipo(tipoFVG, true) : ""
            
            nuevoBox = box.new(
                 bar_index[2], high[2],
                 bar_index, low,
                 bgcolor=colorImbAlcista,
                 border_color=colorImbAlcista,
                 text=mayusculasImb ? str.upper(textoTipo) : textoTipo,
                 text_size=tamanoTextoImb == "tiny" ? size.tiny : tamanoTextoImb == "small" ? size.small : tamanoTextoImb == "normal" ? size.normal : tamanoTextoImb == "large" ? size.large : size.huge,
                 text_color=colorTextoImb,
                 text_halign=text.align_right,
                 text_valign=text.align_center
            )
            array.push(imbalancesActivos, nuevoBox)
            array.push(tops, high[2])
            array.push(bottoms, low)
            array.push(tipos, true)
    
    // CASO BAJISTA
    if close[1] < open[1]
        mecha3TocaCuerpo = high > cuerpo2Inf and high < cuerpo2Sup
        mecha1TocaCuerpo = low[2] > cuerpo2Inf and low[2] < cuerpo2Sup
        mecha3NoMasLejos = high <= low[2]
        
        if mecha3TocaCuerpo and mecha1TocaCuerpo and mecha3NoMasLejos
            tipoFVG = f_clasificarFVG(false)
            textoTipo = mostrarTextoImb ? f_textoPorTipo(tipoFVG, false) : ""
            
            nuevoBox = box.new(
                 bar_index[2], high,
                 bar_index, low[2],
                 bgcolor=colorImbBajista,
                 border_color=colorImbBajista,
                 text=mayusculasImb ? str.upper(textoTipo) : textoTipo,
                 text_size=tamanoTextoImb == "tiny" ? size.tiny : tamanoTextoImb == "small" ? size.small : tamanoTextoImb == "normal" ? size.normal : tamanoTextoImb == "large" ? size.large : size.huge,
                 text_color=colorTextoImb,
                 text_halign=text.align_right,
                 text_valign=text.align_center
            )
            array.push(imbalancesActivos, nuevoBox)
            array.push(tops, high)
            array.push(bottoms, low[2])
            array.push(tipos, false)
    
    numImbalances = array.size(imbalancesActivos)
    if numImbalances > 0
        for i = numImbalances - 1 to 0
            caja = array.get(imbalancesActivos, i)
            topNivel = array.get(tops, i)
            bottomNivel = array.get(bottoms, i)
            esAlcista = array.get(tipos, i)
            
            caja.set_right(bar_index)
            
            bool cruce = false
            if esAlcista
                cruce := low <= topNivel
            else
                cruce := high >= bottomNivel
            
            if cruce
                caja.delete()
                array.remove(imbalancesActivos, i)
                array.remove(tops, i)
                array.remove(bottoms, i)
                array.remove(tipos, i)
//════════════════════════════════════════════════════════════════════════════════════════════════════
// VELAS ENVOLVENTES controladas por configuracion
//════════════════════════════════════════════════════════════════════════════════════════════════════

// Rangos de precios para comparación (cuerpos completos incluyendo sombras)
float maximoActual = math.max(close, open)
float minimoActual = math.min(close, open)
float maximoAnterior = math.max(close[1], open[1])
float minimoAnterior = math.min(close[1], open[1])

// Detección de velas envolventes
if mostrarEnvolventes
    // ENVOLVENTE ALCISTA (vela verde que envuelve completamente a la roja anterior)
    // Condiciones:
    // 1. Vela actual es alcista (close > open)
    // 2. Vela anterior es bajista (close[1] < open[1])
    // 3. El mínimo actual es MENOR que el mínimo anterior
    // 4. El máximo actual es MAYOR que el máximo anterior
    envolventeAlcista := close > open and close[1] < open[1] and 
                         minimoActual < minimoAnterior and 
                         maximoActual > maximoAnterior
    
    // ENVOLVENTE BAJISTA (vela roja que envuelve completamente a la verde anterior)
    // Condiciones:
    // 1. Vela actual es bajista (close < open)
    // 2. Vela anterior es alcista (close[1] > open[1])
    // 3. El mínimo actual es MENOR que el mínimo anterior
    // 4. El máximo actual es MAYOR que el máximo anterior
    envolventeBajista := close < open and close[1] > open[1] and 
                         minimoActual < minimoAnterior and 
                         maximoActual > maximoAnterior
else
    envolventeAlcista := false
    envolventeBajista := false

// Aplicar color a las velas (código original, funciona correctamente)
barcolor(mostrarEnvolventes and envolventeAlcista ? colorEnvolventeAlcista : na)
barcolor(mostrarEnvolventes and envolventeBajista ? colorEnvolventeBajista : na)
