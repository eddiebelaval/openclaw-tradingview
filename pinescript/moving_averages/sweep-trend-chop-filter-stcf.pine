//@version=6
indicator("Sweep Trend Chop Filter", "STCF", overlay=true)

//=========================
// Inputs
//=========================
tolerence = input.float(0.7, title="Noise Filter", minval=0.0, maxval=1.0, step=0.1)
len       = input.int(12,  title="Swing Period", minval=1)

green     = input.color(defval=color.rgb(0, 255, 187), title="Bullish Color")
red       = input.color(defval=color.rgb(255, 17, 0),  title="Bearish Color")
chopColor = input.color(defval=color.yellow,           title="Chop Candle Color")

useEMA    = input.bool(true, title="Use EMA (off = SMA)")
len9      = input.int(9,  title="MA 1 (Fast)", minval=1)
len18     = input.int(18, title="MA 2",        minval=1)
len27     = input.int(27, title="MA 3",        minval=1)
len50     = input.int(50, title="MA 4 (Slow)", minval=1)
plot_ma   = input.bool(true, title="Plot MAs")

//=========================
// Helper MA function
//=========================
f_ma(src, length) =>
    useEMA ? ta.ema(src, length) : ta.sma(src, length)

//=========================
// Compute MAs
//=========================
ma9  = f_ma(close, len9)
ma18 = f_ma(close, len18)
ma27 = f_ma(close, len27)
ma50 = f_ma(close, len50)

// Loosened stack logic (allow minor overlaps)
stack_long  = ma9 > ma18 and ma18 >= ma27 and ma27 >= ma50
stack_short = ma9 < ma18 and ma18 <= ma27 and ma27 <= ma50
chop        = not stack_long and not stack_short

//=========================
// CISD mini state machine (confirmed bars only)
//=========================
var bool  bear_active   = false
var bool  bull_active   = false
var float bear_level    = na
var float bull_level    = na
var float bear_highest  = na
var float bull_lowest   = na
var float bear_top      = na
var float bull_bottom   = na

cisd = 0

if barstate.isconfirmed
    // Potential bearish CISD start: red -> green flip
    if close[1] < open[1] and close > open and not bear_active
        bear_active  := true
        bear_level   := open
        bear_highest := close
        bear_top     := na

    // Potential bullish CISD start: green -> red flip
    if close[1] > open[1] and close < open and not bull_active
        bull_active  := true
        bull_level   := open
        bull_lowest  := close
        bull_bottom  := na

    // Bear tracking forward
    if bear_active
        bear_highest := math.max(bear_highest, close)
        if na(bear_top) and close < open
            bear_top := open
        if close < bear_level and not na(bear_top)
            denom = bear_top - bear_level
            if denom != 0 and (bear_highest - bear_level) / denom > tolerence
                cisd := 1
            bear_active := false

    // Bull tracking forward
    if bull_active
        bull_lowest := math.min(bull_lowest, close)
        if na(bull_bottom) and close > open
            bull_bottom := open
        if close > bull_level and not na(bull_bottom)
            denom = bull_level - bull_bottom
            if denom != 0 and (bull_level - bull_lowest) / denom > tolerence
                cisd := 2
            bull_active := false

//=========================
// Trend & Bar/Wick/Border Coloring
//=========================
trend = cisd == 2 ? 1 : cisd == 1 ? -1 : 0

// Priority: MA stack first, then CISD trend, then chop
barColor = stack_long ? green :
           stack_short ? red :
           trend > 0 ? green :
           trend < 0 ? red :
           chop ? chopColor : na

// Color built-in candle bodies
barcolor(barColor)

// Overlay transparent-body candles to color wicks + borders
plotcandle(open, high, low, close, title="STCF Wick/Border", color=na, wickcolor=barColor, bordercolor=barColor)

//=========================
// Plot Moving Averages
//=========================
plot(plot_ma ? ma9  : na, title="MA 9",  color=color.teal,    linewidth=2)
plot(plot_ma ? ma18 : na, title="MA 18", color=color.orange,  linewidth=2)
plot(plot_ma ? ma27 : na, title="MA 27", color=color.fuchsia, linewidth=2)
plot(plot_ma ? ma50 : na, title="MA 50", color=color.navy,    linewidth=2)
