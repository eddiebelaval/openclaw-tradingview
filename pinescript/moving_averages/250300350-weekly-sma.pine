//@version=5
indicator("200/250/300/350 Week SMA", shorttitle="200-350W SMA", overlay=true, max_lines_count=500)

// ──────────────────────────────────────────────
// Inputs – lengths and colors (customize here or via settings panel)
len200 = input.int(200, "SMA Length 200W", minval=1)
len250 = input.int(250, "SMA Length 250W", minval=1)
len300 = input.int(300, "SMA Length 300W", minval=1)
len350 = input.int(350, "SMA Length 350W", minval=1)

col200 = input.color(color.new(color.yellow,  5),  "200W SMA Color")   // gold/yellow for classic 200W
col250 = input.color(color.new(color.blue,   10), "250W SMA Color")
col300 = input.color(color.new(color.purple, 10), "300W SMA Color")
col350 = input.color(color.new(color.orange, 10), "350W SMA Color")

// Optional toggles if you want to hide/show individual lines
show200 = input.bool(true, "Show 200W")
show250 = input.bool(true, "Show 250W")
show300 = input.bool(true, "Show 300W")
show350 = input.bool(true, "Show 350W")

// ──────────────────────────────────────────────
// Fetch weekly close price series
weeklyClose = request.security(syminfo.tickerid, "W", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// Calculate the SMAs using the weekly data
sma200 = ta.sma(weeklyClose, len200)
sma250 = ta.sma(weeklyClose, len250)
sma300 = ta.sma(weeklyClose, len300)
sma350 = ta.sma(weeklyClose, len350)

// ──────────────────────────────────────────────
// Plot the lines (thicker for better visibility on lower timeframes)
plot(show200 ? sma200 : na, "200-week SMA", color=col200, linewidth=3)
plot(show250 ? sma250 : na, "250-week SMA", color=col250, linewidth=3)
plot(show300 ? sma300 : na, "300-week SMA", color=col300, linewidth=3)
plot(show350 ? sma350 : na, "350-week SMA", color=col350, linewidth=3)
