//@version=6
indicator("Daily / Weekly Bullish-Bearish Status Table", overlay=true)

//====================
// Inputs
//====================
fastBullLen  = input.int(5,  "Bullish Fast EMA", minval=1)
slowBullLen  = input.int(12, "Bullish Slow EMA", minval=1)
bearFastLen  = input.int(34, "Bearish EMA 1", minval=1)
bearSlowLen  = input.int(50, "Bearish EMA 2", minval=1)

showTable    = input.bool(true, "Show Status Table")
showEMAs     = input.bool(true, "Plot Daily EMAs on Chart")
showSignals  = input.bool(true, "Show Cross Labels")
tablePos     = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"])

//====================
// Table position helper
//====================
pos = switch tablePos
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    => position.bottom_left

//====================
// Daily values
//====================
dClose = request.security(syminfo.tickerid, "D", close)
dEma5  = request.security(syminfo.tickerid, "D", ta.ema(close, fastBullLen))
dEma12 = request.security(syminfo.tickerid, "D", ta.ema(close, slowBullLen))
dEma34 = request.security(syminfo.tickerid, "D", ta.ema(close, bearFastLen))
dEma50 = request.security(syminfo.tickerid, "D", ta.ema(close, bearSlowLen))

//====================
// Weekly values
//====================
wClose = request.security(syminfo.tickerid, "W", close)
wEma5  = request.security(syminfo.tickerid, "W", ta.ema(close, fastBullLen))
wEma12 = request.security(syminfo.tickerid, "W", ta.ema(close, slowBullLen))
wEma34 = request.security(syminfo.tickerid, "W", ta.ema(close, bearFastLen))
wEma50 = request.security(syminfo.tickerid, "W", ta.ema(close, bearSlowLen))

//====================
// Conditions
//====================
bullishDaily = dEma5 > dEma12
bearishDaily = dClose < dEma34 and dClose < dEma50

bullishWeekly = wEma5 > wEma12
bearishWeekly = wClose < wEma34 and wClose < wEma50

bullishCross = ta.crossover(dEma5, dEma12)
bearishCross = ta.crossunder(dEma5, dEma12)

//====================
// Plot EMAs
//====================
plot(showEMAs ? dEma5  : na, title="Daily 5 EMA", linewidth=2, color=color.green)
plot(showEMAs ? dEma12 : na, title="Daily 12 EMA", linewidth=2, color=color.blue)
plot(showEMAs ? dEma34 : na, title="Daily 34 EMA", linewidth=2, color=color.orange)
plot(showEMAs ? dEma50 : na, title="Daily 50 EMA", linewidth=2, color=color.red)

//====================
// Labels on cross
//====================
plotshape(
     showSignals and bullishCross,
     title="Bullish Cross",
     style=shape.labelup,
     location=location.belowbar,
     text="Bullish Daily",
     color=color.green,
     textcolor=color.white,
     size=size.small
)

plotshape(
     showSignals and bearishCross,
     title="Bearish Cross",
     style=shape.labeldown,
     location=location.abovebar,
     text="Bearish Daily",
     color=color.red,
     textcolor=color.white,
     size=size.small
)

//====================
// Background highlight (optional)
//====================
bgcolor(bullishDaily ? color.new(color.green, 90) : bearishDaily ? color.new(color.red, 90) : na)

//====================
// Status table
//====================
var table statusTbl = table.new(pos, 2, 3, frame_color=color.gray, frame_width=1)

if barstate.islast and showTable
    table.cell(statusTbl, 0, 0, "Metric", text_color=color.white, bgcolor=color.black)
    table.cell(statusTbl, 1, 0, "Status", text_color=color.white, bgcolor=color.black)

    // Trend row = Daily
    trendText = bullishDaily ? "BULLISH DAILY" : bearishDaily ? "BEARISH DAILY" : "NEUTRAL DAILY"
    trendBg   = bullishDaily ? color.green : bearishDaily ? color.red : color.gray
    table.cell(statusTbl, 0, 1, "Trend", text_color=color.white, bgcolor=color.black)
    table.cell(statusTbl, 1, 1, trendText, text_color=color.white, bgcolor=trendBg)

    // Signal row = Weekly
    weeklyText = bullishWeekly ? "BULLISH WEEKLY" : bearishWeekly ? "BEARISH WEEKLY" : "NEUTRAL WEEKLY"
    weeklyBg   = bullishWeekly ? color.green : bearishWeekly ? color.red : color.gray
    table.cell(statusTbl, 0, 2, "Weekly", text_color=color.white, bgcolor=color.black)
    table.cell(statusTbl, 1, 2, weeklyText, text_color=color.white, bgcolor=weeklyBg)

//====================
// Alerts
//====================
alertcondition(bullishCross, title="Bullish Daily Cross", message="Daily 5 EMA crossed above Daily 12 EMA")
alertcondition(bearishDaily, title="Bearish Daily Condition", message="Daily close is below Daily 34 EMA and Daily 50 EMA")
alertcondition(bullishDaily, title="Bullish Daily Active", message="Daily 5 EMA is above Daily 12 EMA")
alertcondition(bullishWeekly, title="Bullish Weekly Active", message="Weekly 5 EMA is above Weekly 12 EMA")
alertcondition(bearishWeekly, title="Bearish Weekly Condition", message="Weekly close is below Weekly 34 EMA and Weekly 50 EMA")
