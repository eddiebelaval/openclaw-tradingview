//@version=5
indicator(title="Multi-Timeframe Direction Panel", shorttitle="MTF Direction", overlay=true)

// ─────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────
emaLen      = input.int(50, title="EMA Length for Direction", tooltip="EMA used to determine trend direction on each timeframe")
// arrows removed
tablePos    = input.string("top_right", title="Table Position", options=["top_right", "top_left", "bottom_right", "bottom_left", "middle_right", "middle_left"])

// ─────────────────────────────────────────
// DIRECTION FUNCTION
// Returns 1 = Bullish, -1 = Bearish, 0 = Neutral
// Logic: close vs EMA + EMA slope
// ─────────────────────────────────────────
getDirection(tf) =>
    emaVal   = request.security(syminfo.tickerid, tf, ta.ema(close, emaLen), lookahead=barmerge.lookahead_off)
    emaPrev  = request.security(syminfo.tickerid, tf, ta.ema(close[1], emaLen), lookahead=barmerge.lookahead_off)
    closeVal = request.security(syminfo.tickerid, tf, close, lookahead=barmerge.lookahead_off)
    emaRising = emaVal > emaPrev
    dir = closeVal > emaVal and emaRising ? 1 : closeVal < emaVal and not emaRising ? -1 : 0
    [dir, emaVal]

// ─────────────────────────────────────────
// GET DIRECTION FOR EACH TIMEFRAME
// ─────────────────────────────────────────
[dir_m5,  _] = getDirection("5")
[dir_m15, _] = getDirection("15")
[dir_h1,  _] = getDirection("60")
[dir_h4,  _] = getDirection("240")
[dir_1d,  _] = getDirection("D")
[dir_1w,  _] = getDirection("W")

// ─────────────────────────────────────────
// HELPER: direction label + color
// ─────────────────────────────────────────
dirLabel(d) =>
    d == 1 ? "▲  BULL" : d == -1 ? "▼  BEAR" : "◆  NEUT"

dirColor(d) =>
    d == 1 ? color.new(color.green, 0) : d == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)

dirBG(d) =>
    d == 1 ? color.new(color.green, 75) : d == -1 ? color.new(color.red, 75) : color.new(color.gray, 80)

// ─────────────────────────────────────────
// TABLE POSITION MAPPING
// ─────────────────────────────────────────
tPos = tablePos == "top_right"    ? position.top_right    :
       tablePos == "top_left"     ? position.top_left     :
       tablePos == "bottom_right" ? position.bottom_right :
       tablePos == "bottom_left"  ? position.bottom_left  :
       tablePos == "middle_right" ? position.middle_right :
       position.middle_left

// ─────────────────────────────────────────
// TABLE
// ─────────────────────────────────────────
var table mtfTable = table.new(tPos, 2, 8, border_width=1, border_color=color.new(color.gray, 40), frame_color=color.new(color.gray, 20), frame_width=2)

if barstate.islast

    // Header row
    table.cell(mtfTable, 0, 0, "TIMEFRAME", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 1, 0, "DIRECTION", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.normal, text_halign=text.align_center)

    // M5
    table.cell(mtfTable, 0, 1, "M5",  text_color=color.white, bgcolor=color.new(color.navy, 40), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 1, 1, dirLabel(dir_m5),  text_color=dirColor(dir_m5),  bgcolor=dirBG(dir_m5),  text_size=size.normal, text_halign=text.align_center)

    // M15
    table.cell(mtfTable, 0, 2, "M15", text_color=color.white, bgcolor=color.new(color.navy, 40), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 1, 2, dirLabel(dir_m15), text_color=dirColor(dir_m15), bgcolor=dirBG(dir_m15), text_size=size.normal, text_halign=text.align_center)

    // H1
    table.cell(mtfTable, 0, 3, "H1",  text_color=color.white, bgcolor=color.new(color.navy, 40), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 1, 3, dirLabel(dir_h1),  text_color=dirColor(dir_h1),  bgcolor=dirBG(dir_h1),  text_size=size.normal, text_halign=text.align_center)

    // H4
    table.cell(mtfTable, 0, 4, "H4",  text_color=color.white, bgcolor=color.new(color.navy, 40), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 1, 4, dirLabel(dir_h4),  text_color=dirColor(dir_h4),  bgcolor=dirBG(dir_h4),  text_size=size.normal, text_halign=text.align_center)

    // 1D
    table.cell(mtfTable, 0, 5, "1D",  text_color=color.white, bgcolor=color.new(color.navy, 40), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 1, 5, dirLabel(dir_1d),  text_color=dirColor(dir_1d),  bgcolor=dirBG(dir_1d),  text_size=size.normal, text_halign=text.align_center)

    // 1W
    table.cell(mtfTable, 0, 6, "1W",  text_color=color.white, bgcolor=color.new(color.navy, 40), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 1, 6, dirLabel(dir_1w),  text_color=dirColor(dir_1w),  bgcolor=dirBG(dir_1w),  text_size=size.normal, text_halign=text.align_center)

    // Overall bias row: count bulls vs bears
    bullCount = (dir_m5 == 1 ? 1 : 0) + (dir_m15 == 1 ? 1 : 0) + (dir_h1 == 1 ? 1 : 0) + (dir_h4 == 1 ? 1 : 0) + (dir_1d == 1 ? 1 : 0) + (dir_1w == 1 ? 1 : 0)
    bearCount = (dir_m5 ==-1 ? 1 : 0) + (dir_m15 ==-1 ? 1 : 0) + (dir_h1 ==-1 ? 1 : 0) + (dir_h4 ==-1 ? 1 : 0) + (dir_1d ==-1 ? 1 : 0) + (dir_1w ==-1 ? 1 : 0)

    overallDir   = bullCount > bearCount ? 1 : bearCount > bullCount ? -1 : 0
    overallLabel = bullCount > bearCount ? "▲ BULLISH (" + str.tostring(bullCount) + "/6)" : bearCount > bullCount ? "▼ BEARISH (" + str.tostring(bearCount) + "/6)" : "◆ MIXED"
    overallBG    = bullCount > bearCount ? color.new(color.green, 55) : bearCount > bullCount ? color.new(color.red, 55) : color.new(color.gray, 60)
    overallTC    = bullCount > bearCount ? color.white : bearCount > bullCount ? color.white : color.white

    table.cell(mtfTable, 0, 7, "BIAS",         text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small,  text_halign=text.align_center)
    table.cell(mtfTable, 1, 7, overallLabel,   text_color=overallTC,   bgcolor=overallBG,                  text_size=size.small,  text_halign=text.align_center)
