//@version=6
indicator("均线丛穿透-震荡终结版 V12", overlay = true, max_boxes_count = 500)

// --- 1. 基础均线计算 ---
sma13  = ta.sma(close, 13)
sma26  = ta.sma(close, 26)
sma100 = ta.sma(close, 100)
sma200 = ta.sma(close, 200)

// --- 2. [关键] ADX 趋势强度过滤 (过滤震荡区) ---
[plusDI, minusDI, adxValue] = ta.dmi(14, 14)
isTrending = adxValue > 25 and adxValue > adxValue[1] // ADX需大于25且正在增强

// --- 3. [关键] 结构化突破 (必须突破震荡箱体) ---
// 只有价格突破了过去 20 根 K 线的最高/最低点，才认为脱离了震荡区
highest20 = ta.highest(high[1], 20)
lowest20  = ta.lowest(low[1], 20)
isStructureBreakUp = close > highest20
isStructureBreakDn = close < lowest20

// --- 4. 均线密集度与斜率 ---
maxCore = math.max(sma13, sma26, sma100)
minCore = math.min(sma13, sma26, sma100)
isDense = (maxCore - minCore) / close < 0.01 // 更加严格的密集度要求 (1%)

// 斜率过滤：SMA100 必须不是平的
slope100 = (sma100 - sma100[5]) / sma100[5] * 100
isSlopeValid = math.abs(slope100) > 0.01 

// --- 5. 穿透动作与量能 ---
// 穿透判定：阳线身体跨越密集区
isLongPierce  = open < maxCore and close > maxCore and close > open
isShortPierce = open > minCore and close < minCore and close < open

// 量能确认：突破时的量必须明显大于平均量
volSma20 = ta.sma(volume, 20)
isVolConfirm = volume > volSma20 * 1.2 

// --- 6. 最终信号组合 (多重严苛滤网) ---
// 1.均线密集 + 2.穿透动作 + 3.ADX强趋势 + 4.突破20日高低点 + 5.放量确认 + 6.趋势斜率
longSignal  = isDense and isLongPierce and isTrending and isStructureBreakUp and isVolConfirm and isSlopeValid and close > sma200
shortSignal = isDense and isShortPierce and isTrending and isStructureBreakDn and isVolConfirm and isSlopeValid and close < sma200

// --- 7. 视觉呈现 ---

// 绘图：均线系统
plot(sma100, color=color.new(color.orange, 0), linewidth=2, title="100核心线")
plot(sma200, color=color.new(color.white, 20), linewidth=3, title="200大趋势轴")

// 信号样式
if longSignal
    box.new(left = bar_index, top = high, right = bar_index, bottom = low, 
             border_color = color.lime, border_width = 8, bgcolor = color.new(color.lime, 60))
    label.new(bar_index, low, "💎 趋势爆发(买)", yloc = yloc.belowbar, 
             color = color.lime, style = label.style_label_up, textcolor = color.black)

if shortSignal
    box.new(left = bar_index, top = high, right = bar_index, bottom = low, 
             border_color = color.red, border_width = 8, bgcolor = color.new(color.red, 60))
    label.new(bar_index, high, "🔥 趋势崩溃(卖)", yloc = yloc.abovebar, 
             color = color.red, style = label.style_label_down, textcolor = color.white)

// 震荡区提示：ADX 低于 25 时，背景变灰，代表这是“垃圾时间”，不交易
bgcolor(not isTrending ? color.new(color.gray, 92) : na)

// 量价背离提示 (量能不足的穿透)
isDivergence = (isLongPierce or isShortPierce) and not isVolConfirm
plotshape(isDivergence, style=shape.xcross, location=location.top, color=color.yellow, size=size.tiny, title="疑似无量假突破")
