//@version=6
indicator("Pro Visual EMA Cross Signal System", overlay=true, max_lines_count=500)

// ======================
// INPUTS
// ======================

emaFastLen = input.int(5, "Fast EMA Length")
smaSlowLen = input.int(20, "Slow SMA Length")
trendLen = input.int(200, "Trend EMA")

confirmBars = input.int(7, "Confirmation Window")

// RSI
rsiLen = input.int(14, "RSI Length")
rsiOB = input.int(70, "RSI Overbought")
rsiOS = input.int(30, "RSI Oversold")

// Volume
volMultiplier = input.float(1.5, "Volume Spike Multiplier")

// ======================
// VISUAL OPTIONS
// ======================

showBuySellLabels = input.bool(true, "Show Buy/Sell Labels")
showStrongDiamonds = input.bool(true, "Show Strong Diamonds")
showSuperDiamonds = input.bool(true, "Show Super Diamonds")

showVerticalLines = input.bool(true, "Show Vertical Signal Lines")
showBackground = input.bool(false, "Highlight Signal Candle")

// Diamond sizes
strongSize = input.string("large", "Strong Diamond Size", options=["small","normal","large","huge"])
superSize = input.string("huge", "Super Diamond Size", options=["small","normal","large","huge"])

// ======================
// COLORS
// ======================

buyColor = input.color(color.green, "Buy Color")
sellColor = input.color(color.red, "Sell Color")

strongBuyColor = input.color(color.lime, "Strong Buy Color")
strongSellColor = input.color(color.maroon, "Strong Sell Color")

superBuyColor = input.color(color.teal, "Super Buy Color")
superSellColor = input.color(color.purple, "Super Sell Color")

// ======================
// MOVING AVERAGES
// ======================

emaFast = ta.ema(close, emaFastLen)
smaSlow = ta.sma(close, smaSlowLen)
emaTrend = ta.ema(close, trendLen)

plot(emaFast, color=color.blue, linewidth=2)
plot(smaSlow, color=color.orange, linewidth=2)
plot(emaTrend, color=color.white)

// ======================
// TREND FILTER
// ======================

bullTrend = close > emaTrend
bearTrend = close < emaTrend

// ======================
// EMA CROSS
// ======================

bullCross = ta.crossover(emaFast, smaSlow)
bearCross = ta.crossunder(emaFast, smaSlow)

// ======================
// RSI
// ======================

rsi = ta.rsi(close, rsiLen)

rsiOversold = rsi <= rsiOS
rsiOverbought = rsi >= rsiOB

// ======================
// MACD
// ======================

[macdLine, signalLine, _] = ta.macd(close,12,26,9)

macdBull = ta.crossover(macdLine,signalLine)
macdBear = ta.crossunder(macdLine,signalLine)

// ======================
// VOLUME
// ======================

volAvg = ta.sma(volume,20)
volSpike = volume > volAvg * volMultiplier

// ======================
// CONFIRM WINDOW
// ======================

barsSinceBull = ta.barssince(bullCross)
barsSinceBear = ta.barssince(bearCross)

withinBullWindow = barsSinceBull > 0 and barsSinceBull <= confirmBars
withinBearWindow = barsSinceBear > 0 and barsSinceBear <= confirmBars

// ======================
// STRONG SIGNALS
// ======================

strongBuy = bullTrend and withinBullWindow and (rsiOversold or macdBull)
strongSell = bearTrend and withinBearWindow and (rsiOverbought or macdBear)

// ======================
// SUPER SIGNALS
// ======================

superBuy = bullTrend and withinBullWindow and rsiOversold and macdBull and volSpike
superSell = bearTrend and withinBearWindow and rsiOverbought and macdBear and volSpike

// ======================
// BUY SELL LABELS
// ======================

plotshape(showBuySellLabels and bullCross,
location=location.belowbar,
style=shape.labelup,
color=buyColor,
text="BUY",
textcolor=color.white)

plotshape(showBuySellLabels and bearCross,
location=location.abovebar,
style=shape.labeldown,
color=sellColor,
text="SELL",
textcolor=color.white)

// ======================
// STRONG DIAMONDS
// ======================

plotshape(showStrongDiamonds and strongBuy,
location=location.belowbar,
style=shape.diamond,
size=size.large,
color=strongBuyColor)

plotshape(showStrongDiamonds and strongSell,
location=location.abovebar,
style=shape.diamond,
size=size.large,
color=strongSellColor)

// ======================
// SUPER DIAMONDS
// ======================

plotshape(showSuperDiamonds and superBuy,
location=location.belowbar,
style=shape.diamond,
size=size.huge,
color=superBuyColor)

plotshape(showSuperDiamonds and superSell,
location=location.abovebar,
style=shape.diamond,
size=size.huge,
color=superSellColor)

// ======================
// BACKGROUND HIGHLIGHT
// ======================

bgcolor(showBackground and bullCross ? color.new(buyColor,85) : na)
bgcolor(showBackground and bearCross ? color.new(sellColor,85) : na)

// ======================
// VERTICAL SIGNAL LINES
// ======================

if showVerticalLines and bullCross
    line.new(bar_index,low,bar_index,high,extend=extend.both,color=buyColor,width=2)

if showVerticalLines and bearCross
    line.new(bar_index,low,bar_index,high,extend=extend.both,color=sellColor,width=2)
