/////////////////////////////////////////////////////////////// ©️ BackQuant ///////////////////////////////////////////////////////////////
import TradingView/ta/4 as ta
//@version=5
indicator( title="DEMA ATR + 200 DEMA One-Time Signal (15m)",
 shorttitle="DEMA ATR 200 ONE",
 overlay=true)

// ───────── INPUTS ─────────
simple bool showAtr       = input.bool(true, "Show DEMA ATR")
simple bool haCandles     = input.bool(false, "Use Heikin Ashi")
simple int  periodDema    = input.int(7, "DEMA Period", group="DEMA ATR")
simple int  periodAtr     = input.int(14, "ATR Period", group="DEMA ATR")
simple float factorAtr   = input.float(1.7, "ATR Factor", step=0.01, group="DEMA ATR")
simple bool paintCandles = input.bool(false, "Paint Candles")
simple bool show200Dema  = input.bool(true, "Show 200 DEMA")

// ───────── SOURCE ─────────
heikinashi_close = request.security( ticker.heikinashi(syminfo.tickerid),
 timeframe.period,
 close)
series float source = haCandles ? heikinashi_close : close

// ───────── DEMA ATR FUNCTION ─────────
DemaAtrWithBands(_p, _s, _atrP, _f)=>
    ema1 = ta.ema(_s, _p)
    ema2 = ta.ema(ema1, _p)
    dema = 2 * ema1 - ema2
    atr  = ta.atr(_atrP) * _f
    var float out = na
    out := nz(out[1], dema)
    if dema - atr > out
        out := dema - atr
    if dema + atr < out
        out := dema + atr
    out

// ───────── CALCULATIONS ─────────
DemaAtr = DemaAtrWithBands(periodDema, source, periodAtr, factorAtr)
dema200 = ta.dema(close, 200)

// ───────── ONE-TIME SIGNAL LOGIC ─────────
buySignal  = ta.crossover(close, dema200)
sellSignal = ta.crossunder(close, dema200)

// ───────── PLOTS ─────────
plot(showAtr ? DemaAtr : na, "DEMA ATR", color.white, 2)
plot(show200Dema ? dema200 : na, "200 DEMA", color.orange, 2)

plotshape(buySignal,  title="BUY",  style=shape.labelup,   location=location.belowbar,
          color=color.green, text="BUY", textcolor=color.white, size=size.small)

plotshape(sellSignal, title="SELL", style=shape.labeldown, location=location.abovebar,
          color=color.red, text="SELL", textcolor=color.white, size=size.small)

// ───────── ALERTS ─────────
alertcondition(buySignal,  "BUY – 200 DEMA Cross Up",
 "BUY | Candle crossed ABOVE 200 DEMA | {{ticker}} | {{interval}}")

alertcondition(sellSignal, "SELL – 200 DEMA Cross Down",
 "SELL | Candle crossed BELOW 200 DEMA | {{ticker}} | {{interval}}")
///////////////////////////////////////////////////////////////
