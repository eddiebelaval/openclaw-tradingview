// ===================================================================
// Dual Timeframe Slope Confluence
// Author: [TheScalpingAnt]
// License: Mozilla Public License 2.0
// Description: Open-source dual-EMA slope histogram with confluence signals.
// ===================================================================

//@version=6
indicator("Dual Timeframe Slope Confluence", overlay=false, max_labels_count=10)

// ═══════════════════════════════════════════════════════════════════
// TOOLTIP CONSTANTS
// ═══════════════════════════════════════════════════════════════════
var string TT_EMA_LEN     = "The period of EMA 1. Default 200 is the institutional standard for primary market structure, widely monitored by professional traders and algorithms. This EMA is sourced entirely from the EMA 1 Higher Timeframe and projected onto your chart as a slope percentage histogram. Adjust lower (100-150) for more responsive momentum detection or higher (250-300) for ultra-smooth structural analysis."
var string TT_SLOPE_BARS  = "Number of HTF bars used to measure the slope: ((EMA_now - EMA[n]) / close) * 100. Higher values smooth out short-term fluctuations and capture the dominant slope direction. Lower values make the slope more reactive to recent price action. Range 5 to 20 recommended."
var string TT_HTF         = "Higher timeframe for EMA 1. The slope is computed entirely on this timeframe before being projected onto your chart. If your chart is 15m, set this to 4H or Daily to capture the dominant structural slope."
var string TT_WAIT        = "When enabled, both EMAs use confirmed historical data only (previous HTF bar). This guarantees 100% non-repainting signals. When disabled, uses current HTF bar data which may update during bar formation."
var string TT_FLAT        = "Minimum absolute slope percentage to classify as trending. Below this absolute value the bar is colored flat/sideways. Default 0.05%. Raise to 0.10-0.20 for stricter sideways filter on volatile instruments."
var string TT_EMA2_LEN    = "The period of EMA 2. Defaults to 200 bars on the Daily timeframe. This is the macro structural EMA. Its slope state (bull, bear, flat) is used as a filter for buy and sell signals."
var string TT_HTF2        = "Higher timeframe for EMA 2. Default Daily (1D). This is the macro structural reference. EMA 2 slope direction must agree with EMA 1 slope direction for a confluence signal."
var string TT_SHOW_EMA2   = "Show or hide the EMA 2 slope histogram columns. When hidden, EMA 2 alert conditions and signal filtering remain active."
var string TT_SHOW_LABEL  = "Show slope percentage labels at the right edge on the last bar. The label shows current slope value, EMA number, and state (BULL, BEAR, or SIDE)."
var string TT_GRADIENT    = "When enabled, histogram column color intensity scales with slope strength. Weak slopes appear faded, strong slopes at full intensity. Calculated using a 200-bar rolling maximum."
var string TT_SHOW_ZERO   = "Show a horizontal reference line at zero. Separates positive slope territory (bullish) from negative slope territory (bearish)."
var string TT_LW1         = "Line width of EMA 1 histogram columns. Range 1 to 5."
var string TT_LW2         = "Line width of EMA 2 histogram columns. Range 1 to 5."
var string TT_MBULL       = "Color of EMA 1 histogram columns when EMA 1 slope is bullish."
var string TT_MBEAR       = "Color of EMA 1 histogram columns when EMA 1 slope is bearish."
var string TT_MABULL      = "Color of EMA 2 histogram columns when EMA 2 slope is bullish."
var string TT_MABEAR      = "Color of EMA 2 histogram columns when EMA 2 slope is bearish."
var string TT_FLAT_COL    = "Color for both EMA 1 and EMA 2 histogram columns when slope is below the flat threshold. Signals sideways/ranging price action."
var string TT_SHOW_BG     = "Show a background tint driven by EMA 2 macro slope state. Bullish uses Background Bull Color, Bearish uses Background Bear Color."
var string TT_BG_BULL     = "Color of background tint when EMA 2 macro slope is bullish."
var string TT_BG_BEAR     = "Color of background tint when EMA 2 macro slope is bearish."
var string TT_BG_TRANSP   = "Transparency of background tint. 0 = fully opaque, 99 = invisible. Default 86."
var string TT_SHOW_TABLE  = "Display an on-chart status matrix showing real-time state of Micro (EMA 1), Macro (EMA 2), and overall Confluence signal."
var string TT_TABLE_POS   = "Position of the status matrix on your chart."
var string TT_ABULL       = "Alert fires on any bullish confluence completion. This includes both MICRO BUY (micro transitions while macro already bullish) and MACRO BUY (macro transitions while micro already bullish) signals."
var string TT_ABEAR       = "Alert fires on any bearish confluence completion. This includes both MICRO SELL (micro transitions while macro already bearish) and MACRO SELL (macro transitions while micro already bearish) signals."
var string TT_AE1BULL     = "Alert fires when EMA 1 slope alone turns bullish, regardless of EMA 2 state."
var string TT_AE1BEAR     = "Alert fires when EMA 1 slope alone turns bearish."
var string TT_AE2BULL     = "Alert fires when EMA 2 slope turns bullish. Macro structural momentum shifted up."
var string TT_AE2BEAR     = "Alert fires when EMA 2 slope turns bearish. Macro structural momentum shifted down."
var string TT_AE1FLAT     = "Alert fires when EMA 1 slope transitions to flat/sideways from trending. Micro momentum exhaustion."
var string TT_AE2FLAT     = "Alert fires when EMA 2 slope transitions to flat/sideways from trending. Macro momentum exhaustion."

// ═══════════════════════════════════════════════════════════════════
// INPUTS: EMA 1 (MICRO)
// ═══════════════════════════════════════════════════════════════════
G1 = "EMA 1 Settings (Micro)"
emaLen     = input.int(200,   "EMA 1 Length",          minval=1,     maxval=500,  tooltip=TT_EMA_LEN,    group=G1)
slopeBars  = input.int(10,    "Slope Lookback Bars",   minval=1,     maxval=100,  tooltip=TT_SLOPE_BARS, group=G1)
htf        = input.timeframe("240", "EMA 1 Timeframe",                            tooltip=TT_HTF,        group=G1)
waitClose  = input.bool(true, "Wait for Bar Close (Non-Repainting)",              tooltip=TT_WAIT,       group=G1)
flatThresh = input.float(0.05,"Flat Threshold (%)",    minval=0.001, step=0.005,  tooltip=TT_FLAT,       group=G1)

// ═══════════════════════════════════════════════════════════════════
// INPUTS: EMA 2 (MACRO)
// ═══════════════════════════════════════════════════════════════════
G2 = "EMA 2 Settings (Macro)"
ema2Len    = input.int(200,   "EMA 2 Length",          minval=1,     maxval=500,  tooltip=TT_EMA2_LEN,   group=G2)
htf2       = input.timeframe("1D", "EMA 2 Timeframe",                             tooltip=TT_HTF2,       group=G2)
showEMA2   = input.bool(true, "Show EMA 2 Histogram",                             tooltip=TT_SHOW_EMA2,  group=G2)

// ═══════════════════════════════════════════════════════════════════
// INPUTS: DISPLAY
// ═══════════════════════════════════════════════════════════════════
G3 = "Display"
showLabel     = input.bool(false,             "Show Slope Labels",              tooltip=TT_SHOW_LABEL, group=G3)
useGradient   = input.bool(true,              "Use Gradient Colors",            tooltip=TT_GRADIENT,   group=G3)
showZero      = input.bool(false,             "Show Zero Line",                 tooltip=TT_SHOW_ZERO,  group=G3)
lineWidth     = input.int(4,                  "EMA 1 Column Width", minval=1, maxval=5, tooltip=TT_LW1, group=G3)
lineWidth2    = input.int(2,                  "EMA 2 Column Width", minval=1, maxval=5, tooltip=TT_LW2, group=G3)
microBullCol  = input.color(#1fff00,          "EMA 1 Bullish Color",            tooltip=TT_MBULL,      group=G3)
microBearCol  = input.color(#cb0000,          "EMA 1 Bearish Color",            tooltip=TT_MBEAR,      group=G3)
macroBullCol  = input.color(color.white,      "EMA 2 Bullish Color",            tooltip=TT_MABULL,     group=G3)
macroBearCol  = input.color(#000000,          "EMA 2 Bearish Color",            tooltip=TT_MABEAR,     group=G3)
flatColor     = input.color(#f0ff00,          "Flat / Sideways Color",          tooltip=TT_FLAT_COL,   group=G3)
showBG        = input.bool(false,             "Show Background Tint",           tooltip=TT_SHOW_BG,    group=G3)
bgBullCol     = input.color(color.white,      "Background Bull Color",          tooltip=TT_BG_BULL,    group=G3)
bgBearCol     = input.color(#000000,          "Background Bear Color",          tooltip=TT_BG_BEAR,    group=G3)
bgTransp      = input.int(86, "Background Tint Transparency", minval=0, maxval=99, tooltip=TT_BG_TRANSP, group=G3)

// ═══════════════════════════════════════════════════════════════════
// INPUTS: STATUS MATRIX
// ═══════════════════════════════════════════════════════════════════
G5 = "Status Matrix"
showTable     = input.bool(true,              "Show Status Matrix",             tooltip=TT_SHOW_TABLE, group=G5)
tablePosition = input.string("Top Right", "Matrix Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], tooltip=TT_TABLE_POS, group=G5)

// ═══════════════════════════════════════════════════════════════════
// INPUTS: SIGNAL MAGNITUDE FILTER
// ═══════════════════════════════════════════════════════════════════
G6 = "Signal Magnitude Filter"

var string TT_MAG_ENABLE = "When enabled, buy and sell signals only fire when slope magnitude meets the minimum threshold. This filters out weak momentum transitions that occur near the flat zone boundary, producing fewer but potentially higher-conviction signals. Disabled by default."

var string TT_MAG_THRESH = "Minimum absolute slope percentage required for a signal to fire. Default 0.35% means the slope must be decisively trending, not just barely above the flat threshold. Higher values (0.5-1.0%) create very selective signals. Lower values (0.15-0.25%) allow more signals while still filtering the weakest."

var string TT_MAG_TARGET = "Choose which EMA slope(s) must meet the magnitude threshold. 'EMA 1 Only' filters on micro momentum strength. 'EMA 2 Only' filters on macro momentum strength. 'Both EMAs' requires strong momentum on both layers — most selective, fewest signals. 'Either EMA' requires at least one strong layer — least selective filter."

useMagnitudeFilter = input.bool(false, "Enable Magnitude Filter", tooltip=TT_MAG_ENABLE, group=G6)
magnitudeThreshold = input.float(0.35, "Minimum Magnitude (%)", minval=0.05, maxval=2.0, step=0.05, tooltip=TT_MAG_THRESH, group=G6)
magnitudeTarget    = input.string("Both EMAs", "Filter Target", options=["EMA 1 Only", "EMA 2 Only", "Both EMAs", "Either EMA"], tooltip=TT_MAG_TARGET, group=G6)

// ═══════════════════════════════════════════════════════════════════
// INPUTS: ALERTS
// ═══════════════════════════════════════════════════════════════════
G4 = "Alerts"
alertBullAlign = input.bool(true,  "Alert: Bullish Confluence",        tooltip=TT_ABULL,   group=G4)
alertBearAlign = input.bool(true,  "Alert: Bearish Confluence",        tooltip=TT_ABEAR,   group=G4)
alertE1Bull    = input.bool(false, "Alert: EMA 1 Turns Bullish",       tooltip=TT_AE1BULL, group=G4)
alertE1Bear    = input.bool(false, "Alert: EMA 1 Turns Bearish",       tooltip=TT_AE1BEAR, group=G4)
alertE2Bull    = input.bool(false, "Alert: EMA 2 Turns Bullish",       tooltip=TT_AE2BULL, group=G4)
alertE2Bear    = input.bool(false, "Alert: EMA 2 Turns Bearish",       tooltip=TT_AE2BEAR, group=G4)
alertE1Flat    = input.bool(false, "Alert: EMA 1 Turns Flat",          tooltip=TT_AE1FLAT, group=G4)
alertE2Flat    = input.bool(false, "Alert: EMA 2 Turns Flat",          tooltip=TT_AE2FLAT, group=G4)

// ═══════════════════════════════════════════════════════════════════
// NON-REPAINTING SECURITY FUNCTION
// ═══════════════════════════════════════════════════════════════════
// Uses [1] offset to guarantee we only read CLOSED HTF bars
// Combined with lookahead_off for proper historical behavior
f_security_nr(_sym, _tf, _src) =>
    request.security(_sym, _tf, _src[1], lookahead=barmerge.lookahead_off)

f_security_live(_sym, _tf, _src) =>
    request.security(_sym, _tf, _src, lookahead=barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════
// HTF EMA 1 (MICRO) CALCULATIONS
// ═══════════════════════════════════════════════════════════════════
ema1_calc = ta.ema(close, emaLen)
slope1_calc = ((ema1_calc - ema1_calc[slopeBars]) / math.max(close, 1e-10)) * 100.0

htfEMA_nr   = f_security_nr(syminfo.tickerid, htf, ema1_calc)
htfSlope_nr = f_security_nr(syminfo.tickerid, htf, slope1_calc)

htfEMA_live   = f_security_live(syminfo.tickerid, htf, ema1_calc)
htfSlope_live = f_security_live(syminfo.tickerid, htf, slope1_calc)

htfEMA      = waitClose ? htfEMA_nr   : htfEMA_live
htfSlopePct = waitClose ? htfSlope_nr : htfSlope_live

// ═══════════════════════════════════════════════════════════════════
// HTF EMA 2 (MACRO) CALCULATIONS
// ═══════════════════════════════════════════════════════════════════
ema2_calc = ta.ema(close, ema2Len)
slope2_calc = ((ema2_calc - ema2_calc[slopeBars]) / math.max(close, 1e-10)) * 100.0

htf2EMA_nr   = f_security_nr(syminfo.tickerid, htf2, ema2_calc)
htf2Slope_nr = f_security_nr(syminfo.tickerid, htf2, slope2_calc)

htf2EMA_live   = f_security_live(syminfo.tickerid, htf2, ema2_calc)
htf2Slope_live = f_security_live(syminfo.tickerid, htf2, slope2_calc)

htf2EMA      = waitClose ? htf2EMA_nr   : htf2EMA_live
htf2SlopePct = waitClose ? htf2Slope_nr : htf2Slope_live

// ═══════════════════════════════════════════════════════════════════
// TREND STATE CLASSIFICATION
// ═══════════════════════════════════════════════════════════════════
// EMA 1 (Micro) State
isFlat  = math.abs(htfSlopePct)  < flatThresh
isBull  = not isFlat  and htfSlopePct  > 0
isBear  = not isFlat  and htfSlopePct  < 0

// EMA 2 (Macro) State
isFlat2 = math.abs(htf2SlopePct) < flatThresh
isBull2 = not isFlat2 and htf2SlopePct > 0
isBear2 = not isFlat2 and htf2SlopePct < 0

// ═══════════════════════════════════════════════════════════════════
// STATE TRANSITIONS (One-Shot Detection)
// ═══════════════════════════════════════════════════════════════════
prevIsFlat = math.abs(htfSlopePct[1]) < flatThresh
prevIsBull = not prevIsFlat and htfSlopePct[1] > 0
prevIsBear = not prevIsFlat and htfSlopePct[1] < 0

prevIsFlat2 = math.abs(htf2SlopePct[1]) < flatThresh
prevIsBull2 = not prevIsFlat2 and htf2SlopePct[1] > 0
prevIsBear2 = not prevIsFlat2 and htf2SlopePct[1] < 0

transE1ToBull = isBull  and not prevIsBull
transE1ToBear = isBear  and not prevIsBear
transE1ToFlat = isFlat  and not prevIsFlat
transE2ToBull = isBull2 and not prevIsBull2
transE2ToBear = isBear2 and not prevIsBear2
transE2ToFlat = isFlat2 and not prevIsFlat2

// ═══════════════════════════════════════════════════════════════════
// MAGNITUDE FILTER LOGIC
// ═══════════════════════════════════════════════════════════════════
// Calculate whether each EMA meets the magnitude threshold
ema1MeetsMagnitude = math.abs(htfSlopePct) >= magnitudeThreshold
ema2MeetsMagnitude = math.abs(htf2SlopePct) >= magnitudeThreshold

// Determine if magnitude filter passes based on selected target
magnitudeFilterPasses = switch magnitudeTarget
    "EMA 1 Only" => ema1MeetsMagnitude
    "EMA 2 Only" => ema2MeetsMagnitude
    "Both EMAs"  => ema1MeetsMagnitude and ema2MeetsMagnitude
    "Either EMA" => ema1MeetsMagnitude or ema2MeetsMagnitude
    => true

// Final magnitude gate: either filter is disabled, or filter passes
magnitudeGate = not useMagnitudeFilter or magnitudeFilterPasses

// ═══════════════════════════════════════════════════════════════════
// CONFLUENCE SIGNALS
// ═══════════════════════════════════════════════════════════════════
// Micro Buy: EMA 1 (micro) transitions to bullish while EMA 2 (macro) is already bullish
// Macro Buy: EMA 2 (macro) transitions to bullish while EMA 1 (micro) is already bullish
// Micro Sell: EMA 1 (micro) transitions to bearish while EMA 2 (macro) is already bearish
// Macro Sell: EMA 2 (macro) transitions to bearish while EMA 1 (micro) is already bearish
// This ensures signals fire regardless of WHICH layer completes the alignment

microBuySignal  = transE1ToBull and isBull2 and magnitudeGate
macroBuySignal  = transE2ToBull and isBull  and magnitudeGate
microSellSignal = transE1ToBear and isBear2 and magnitudeGate
macroSellSignal = transE2ToBear and isBear  and magnitudeGate

// Combined signals for status table and general alerts
buySignal  = microBuySignal  or macroBuySignal
sellSignal = microSellSignal or macroSellSignal

// ═══════════════════════════════════════════════════════════════════
// GRADIENT & COLOR LOGIC
// ═══════════════════════════════════════════════════════════════════
maxSlope1 = ta.highest(math.abs(htfSlopePct),  200)
maxSlope2 = ta.highest(math.abs(htf2SlopePct), 200)

gradMicroBull = color.from_gradient(math.abs(htfSlopePct),  0, maxSlope1, color.new(microBullCol, 80), microBullCol)
gradMicroBear = color.from_gradient(math.abs(htfSlopePct),  0, maxSlope1, color.new(microBearCol, 80), microBearCol)
gradMacroBull = color.from_gradient(math.abs(htf2SlopePct), 0, maxSlope2, color.new(macroBullCol, 80), macroBullCol)
gradMacroBear = color.from_gradient(math.abs(htf2SlopePct), 0, maxSlope2, color.new(macroBearCol, 80), macroBearCol)

c_microBull = useGradient ? gradMicroBull : microBullCol
c_microBear = useGradient ? gradMicroBear : microBearCol
c_macroBull = useGradient ? gradMacroBull : macroBullCol
c_macroBear = useGradient ? gradMacroBear : macroBearCol

emaColor  = isFlat  ? flatColor : isBull  ? c_microBull : c_microBear
ema2Color = isFlat2 ? flatColor : isBull2 ? c_macroBull : c_macroBear

// ═══════════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════════
plot(showEMA2 ? htf2SlopePct : na, title="EMA 2 Slope (Macro)", style=plot.style_columns, color=ema2Color, linewidth=lineWidth2)
plot(htfSlopePct,                  title="EMA 1 Slope (Micro)", style=plot.style_columns, color=emaColor,  linewidth=lineWidth)
hline(showZero ? 0 : na, "Zero Line", color=color.rgb(100,100,100), linestyle=hline.style_solid, linewidth=1)

// Signal Markers - Four distinct signals showing which layer completed the alignment
// Micro signals use the standard bull/bear colors (bright green #1fff00, red #cb0000)
// Macro signals use distinct colors (darker green #03bf31, darker red #a51212) for visual differentiation
plotshape(microBuySignal,  title="Micro Buy Signal",  style=shape.circle, location=location.bottom, color=microBullCol, size=size.tiny, text="MICRO BUY",  textcolor=microBullCol)
plotshape(macroBuySignal,  title="Macro Buy Signal",  style=shape.circle, location=location.bottom, color=#03bf31,      size=size.tiny, text="MACRO BUY",  textcolor=#03bf31)
plotshape(microSellSignal, title="Micro Sell Signal", style=shape.circle, location=location.top,    color=microBearCol, size=size.tiny, text="MICRO SELL", textcolor=microBearCol)
plotshape(macroSellSignal, title="Macro Sell Signal", style=shape.circle, location=location.top,    color=#a51212,      size=size.tiny, text="MACRO SELL", textcolor=#a51212)

// ═══════════════════════════════════════════════════════════════════
// BACKGROUND TINT
// ═══════════════════════════════════════════════════════════════════
bgcolor(showBG ? (isBull2 ? color.new(bgBullCol, bgTransp) : isBear2 ? color.new(bgBearCol, bgTransp) : na) : na, title="Macro Trend Background")

// ═══════════════════════════════════════════════════════════════════
// STATUS MATRIX TABLE
// ═══════════════════════════════════════════════════════════════════
// Table size: 3 columns (Layer, Status, Magnitude), 5 rows if magnitude filter enabled
int tableRows = useMagnitudeFilter ? 5 : 4
var table statusMatrix = table.new(
     tablePosition == "Top Right" ? position.top_right : 
     tablePosition == "Top Left" ? position.top_left : 
     tablePosition == "Bottom Right" ? position.bottom_right : position.bottom_left, 
     3, tableRows, border_width=1)

if showTable and barstate.islast
    // Header
    table.cell(statusMatrix, 0, 0, "Layer", bgcolor=color.rgb(30, 30, 30), text_color=color.white, text_size=size.small)
    table.cell(statusMatrix, 1, 0, "Status", bgcolor=color.rgb(30, 30, 30), text_color=color.white, text_size=size.small)
    table.cell(statusMatrix, 2, 0, "Slope %", bgcolor=color.rgb(30, 30, 30), text_color=color.white, text_size=size.small)
    
    // Micro (EMA 1) Row
    string microStatus = isBull ? "BULLISH" : isBear ? "BEARISH" : "SIDEWAYS"
    color microStatusCol = isBull ? color.new(#1fff00, 20) : isBear ? color.new(#cb0000, 20) : color.new(#f0ff00, 20)
    table.cell(statusMatrix, 0, 1, "Micro (" + htf + ")", bgcolor=color.rgb(50, 50, 50), text_color=color.white, text_size=size.small)
    table.cell(statusMatrix, 1, 1, microStatus, bgcolor=microStatusCol, text_color=color.white, text_size=size.small)
    table.cell(statusMatrix, 2, 1, str.tostring(htfSlopePct, "#.###") + "%", bgcolor=color.rgb(50, 50, 50), text_color=color.white, text_size=size.small)
    
    // Macro (EMA 2) Row
    string macroStatus = isBull2 ? "BULLISH" : isBear2 ? "BEARISH" : "SIDEWAYS"
    color macroStatusCol = isBull2 ? color.new(#1fff00, 20) : isBear2 ? color.new(#cb0000, 20) : color.new(#f0ff00, 20)
    table.cell(statusMatrix, 0, 2, "Macro (" + htf2 + ")", bgcolor=color.rgb(50, 50, 50), text_color=color.white, text_size=size.small)
    table.cell(statusMatrix, 1, 2, macroStatus, bgcolor=macroStatusCol, text_color=color.white, text_size=size.small)
    table.cell(statusMatrix, 2, 2, str.tostring(htf2SlopePct, "#.###") + "%", bgcolor=color.rgb(50, 50, 50), text_color=color.white, text_size=size.small)
    
    // Confluence Signal Row
    string confStatus = isBull and isBull2 ? "BUY" : isBear and isBear2 ? "SELL" : "WAIT"
    color confStatusCol = isBull and isBull2 ? color.new(#1fff00, 10) : isBear and isBear2 ? color.new(#cb0000, 10) : color.new(color.gray, 30)
    table.cell(statusMatrix, 0, 3, "Confluence", bgcolor=color.rgb(30, 30, 30), text_color=color.white, text_size=size.small)
    table.cell(statusMatrix, 1, 3, confStatus, bgcolor=confStatusCol, text_color=color.white, text_size=size.small)
    table.cell(statusMatrix, 2, 3, "", bgcolor=color.rgb(30, 30, 30), text_color=color.white, text_size=size.small)
    
    // Magnitude Filter Row (only shown when filter is enabled)
    if useMagnitudeFilter
        string magStatus = magnitudeFilterPasses ? "PASS" : "BLOCKED"
        color magStatusCol = magnitudeFilterPasses ? color.new(#1fff00, 20) : color.new(#cb0000, 20)
        string magInfo = str.tostring(magnitudeThreshold, "#.##") + "% min"
        table.cell(statusMatrix, 0, 4, "Magnitude", bgcolor=color.rgb(40, 40, 40), text_color=color.white, text_size=size.small)
        table.cell(statusMatrix, 1, 4, magStatus, bgcolor=magStatusCol, text_color=color.white, text_size=size.small)
        table.cell(statusMatrix, 2, 4, magInfo, bgcolor=color.rgb(40, 40, 40), text_color=color.white, text_size=size.small)

// ═══════════════════════════════════════════════════════════════════
// SLOPE LABELS
// ═══════════════════════════════════════════════════════════════════
var label slopeLabel  = na
var label slopeLabel2 = na
if barstate.islast and showLabel
    label.delete(slopeLabel)
    labelState  = isBull  ? "BULL" : isBear  ? "BEAR" : "SIDE"
    labelTxt    = str.tostring(htfSlopePct,  "#.###") + "% | EMA1 " + labelState
    slopeLabel := label.new(
         bar_index + 1, htfSlopePct, labelTxt,
         style=label.style_label_left, textcolor=color.white,
         color=isFlat ? color.gray : isBull ? microBullCol : microBearCol,
         size=size.small)
    if showEMA2
        label.delete(slopeLabel2)
        labelState2  = isBull2 ? "BULL" : isBear2 ? "BEAR" : "SIDE"
        labelTxt2    = str.tostring(htf2SlopePct, "#.###") + "% | EMA2 " + labelState2
        slopeLabel2 := label.new(
             bar_index + 1, htf2SlopePct, labelTxt2,
             style=label.style_label_left, textcolor=color.white,
             color=isFlat2 ? color.gray : isBull2 ? macroBullCol : macroBearCol,
             size=size.small)

// ═══════════════════════════════════════════════════════════════════
// ALERT CONDITIONS
// ═══════════════════════════════════════════════════════════════════
// Specific alerts for each signal type
alertcondition(alertBullAlign and microBuySignal,
    title   = "Micro Buy Signal",
    message = "Dual Timeframe Slope Confluence: {{ticker}} [{{interval}}] - MICRO BUY. Micro slope turned BULLISH completing alignment with already BULLISH Macro.")

alertcondition(alertBullAlign and macroBuySignal,
    title   = "Macro Buy Signal",
    message = "Dual Timeframe Slope Confluence: {{ticker}} [{{interval}}] - MACRO BUY. Macro slope turned BULLISH completing alignment with already BULLISH Micro.")

alertcondition(alertBearAlign and microSellSignal,
    title   = "Micro Sell Signal",
    message = "Dual Timeframe Slope Confluence: {{ticker}} [{{interval}}] - MICRO SELL. Micro slope turned BEARISH completing alignment with already BEARISH Macro.")

alertcondition(alertBearAlign and macroSellSignal,
    title   = "Macro Sell Signal",
    message = "Dual Timeframe Slope Confluence: {{ticker}} [{{interval}}] - MACRO SELL. Macro slope turned BEARISH completing alignment with already BEARISH Micro.")

// Combined confluence alerts (any buy or any sell)
alertcondition(alertBullAlign and buySignal,
    title   = "Any Buy Signal",
    message = "Dual Timeframe Slope Confluence: {{ticker}} [{{interval}}] - BUY signal triggered. Bullish dual alignment achieved.")

alertcondition(alertBearAlign and sellSignal,
    title   = "Any Sell Signal",
    message = "Dual Timeframe Slope Confluence: {{ticker}} [{{interval}}] - SELL signal triggered. Bearish dual alignment achieved.")

alertcondition(alertE1Bull and transE1ToBull,
    title   = "EMA 1 Turned Bullish",
    message = "Dual Timeframe Slope Confluence: {{ticker}} [{{interval}}] - Micro slope turned BULLISH.")

alertcondition(alertE1Bear and transE1ToBear,
    title   = "EMA 1 Turned Bearish",
    message = "Dual Timeframe Slope Confluence: {{ticker}} [{{interval}}] - Micro slope turned BEARISH.")

alertcondition(alertE1Flat and transE1ToFlat,
    title   = "EMA 1 Turned Flat",
    message = "Dual Timeframe Slope Confluence: {{ticker}} [{{interval}}] - Micro slope turned FLAT. Momentum exhaustion.")

alertcondition(alertE2Bull and transE2ToBull,
    title   = "EMA 2 Turned Bullish",
    message = "Dual Timeframe Slope Confluence: {{ticker}} [{{interval}}] - Macro slope turned BULLISH. Structural shift up.")

alertcondition(alertE2Bear and transE2ToBear,
    title   = "EMA 2 Turned Bearish",
    message = "Dual Timeframe Slope Confluence: {{ticker}} [{{interval}}] - Macro slope turned BEARISH. Structural shift down.")

alertcondition(alertE2Flat and transE2ToFlat,
    title   = "EMA 2 Turned Flat",
    message = "Dual Timeframe Slope Confluence: {{ticker}} [{{interval}}] - Macro slope turned FLAT. Structural momentum exhaustion.")
