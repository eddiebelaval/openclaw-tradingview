//@version=6
strategy("9 EMA Intraday - Hybrid Trend & Flip", overlay=true, initial_capital=100000)

// --- 1. Fetch Multi-Timeframe 9 EMAs ---
f_ema(_tf) => request.security(syminfo.tickerid, _tf, ta.ema(close, 9), lookahead=barmerge.lookahead_on)

ema_d   = f_ema("D")    
ema_h   = f_ema("60")   
ema_15m = f_ema("15")   

// --- 2. Counter-Trend Logic (15m Override) ---
// We check if 2 consecutive 15m candles closed on the opposite side of the 15m EMA
// This allows us to "capture short moves against the trend"
count_15m_bull = request.security(syminfo.tickerid, "15", ta.barssince(close < ema_15m) >= 2)
count_15m_bear = request.security(syminfo.tickerid, "15", ta.barssince(close > ema_15m) >= 2)

// --- 3. Entry Logic ---
// 3-minute candle must close in the same direction to trigger
three_min_confirm_bull = close > close[1] and close > ema_15m
three_min_confirm_bear = close < close[1] and close < ema_15m

// OPTION A: Full Trend Alignment (D + H + 15m)
full_trend_long  = close > ema_d and close > ema_h and close > ema_15m
full_trend_short = close < ema_d and close < ema_h and close < ema_15m

// OPTION B: 15m Reversal Override (Capture short moves even if D/H are pending)
reversal_long  = count_15m_bull and three_min_confirm_bull
reversal_short = count_15m_bear and three_min_confirm_bear

long_condition  = (full_trend_long or reversal_long)
short_condition = (full_trend_short or reversal_short)

// --- 4. Fibonacci 0.618 Exit (2-Candle Lookback) ---
// Using 2 candles for the Fib range to give the "aggressive" exit some breathing room
hi = ta.highest(high, 2)
lo = ta.lowest(low, 2)
fib_range = hi - lo

fib_exit_long  = lo + (fib_range * 0.382) // 61.8% retracement from high
fib_exit_short = hi - (fib_range * 0.382) // 61.8% retracement from low

// --- 5. Execution ---
if (long_condition and strategy.position_size <= 0)
    strategy.entry("Long", strategy.long, comment=reversal_long ? "15m Flip" : "Trend Align")

if (short_condition and strategy.position_size >= 0)
    strategy.entry("Short", strategy.short, comment=reversal_short ? "15m Flip" : "Trend Align")

// --- 6. Exit Triggers ---
if (strategy.position_size > 0 and close < fib_exit_long)
    strategy.close("Long", comment="Fib Exit")

if (strategy.position_size < 0 and close > fib_exit_short)
    strategy.close("Short", comment="Fib Exit")

// --- 7. Visuals ---
plot(ema_15m, color=color.blue, title="15m 9 EMA")
plot(ema_h, color=color.new(color.orange, 50), title="Hourly 9 EMA")

plotshape(long_condition and strategy.position_size == 0, "Buy", shape.labelup, location.belowbar, color.green, text="BUY")
plotshape(short_condition and strategy.position_size == 0, "Sell", shape.labeldown, location.abovebar, color.red, text="SELL")
