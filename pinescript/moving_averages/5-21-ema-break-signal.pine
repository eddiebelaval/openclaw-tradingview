//@version=5
indicator("5 & 21 EMA Break Signal", overlay=true)

// EMA Calculations
ema5 = ta.ema(close, 5)
ema21 = ta.ema(close, 21)

// Plot EMAs
plot(ema5, color=color.blue, title="EMA 5")
plot(ema21, color=color.orange, title="EMA 21")

// =====================
// BUY CONDITIONS
// =====================

// Previous candle bullish (green)
prevBullish = close[1] > open[1]

// Previous candle completely below both EMAs
prevBelowEMA = high[1] < ema5[1] and high[1] < ema21[1]

// Current candle closes above both EMAs
currentAboveEMA = close > ema5 and close > ema21

buySignal = prevBullish and prevBelowEMA and currentAboveEMA

// =====================
// SELL CONDITIONS
// =====================

// Previous candle bearish (red)
prevBearish = close[1] < open[1]

// Previous candle completely above both EMAs
prevAboveEMA = low[1] > ema5[1] and low[1] > ema21[1]

// Current candle closes below both EMAs
currentBelowEMA = close < ema5 and close < ema21

sellSignal = prevBearish and prevAboveEMA and currentBelowEMA

// =====================
// Plot Signals
// =====================

plotshape(buySignal, 
     title="Buy Signal", 
     location=location.belowbar, 
     color=color.green, 
     style=shape.labelup, 
     text="BUY")

plotshape(sellSignal, 
     title="Sell Signal", 
     location=location.abovebar, 
     color=color.red, 
     style=shape.labeldown, 
     text="SELL")
