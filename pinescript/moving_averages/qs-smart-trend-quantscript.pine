// © QuantScript

//@version=5
indicator("QS Smart Trend [QuantScript]", shorttitle="QS Trend", overlay=true)

// --- 1. ألوان هوية QuantScript ---
color qs_green = color.new(#00FF7F, 0)   // الأخضر السيبراني للإيجابية
color qs_blue  = color.new(#002147, 0)   // الأزرق الداكن للأساسيات
color qs_muted = color.new(color.gray, 70) // لون باهت لفترات الانتظار أو السلبية

// --- 2. إعدادات متوسطات ALMA ---
grp_alma = "إعدادات الاتجاه (ALMA)"
length_fast = input.int(20, title="طول المتوسط السريع", group=grp_alma)
length_slow = input.int(50, title="طول المتوسط البطيء", group=grp_alma)
offset_val  = input.float(0.85, title="الإزاحة (Offset)", step=0.05, group=grp_alma)
sigma_val   = input.float(6.0, title="سيجما (Sigma)", step=1.0, group=grp_alma)

// --- 3. الحسابات ---
alma_fast = ta.alma(close, length_fast, offset_val, sigma_val)
alma_slow = ta.alma(close, length_slow, offset_val, sigma_val)

// تحديد حالة الاتجاه (التركيز على السبوت)
bullish_trend = alma_fast > alma_slow
bearish_trend = alma_fast < alma_slow

// --- 4. الرسم والتلوين (Visuals) ---
// رسم المتوسطات
plot(alma_fast, title="ALMA السريع", color=bullish_trend ? qs_green : qs_muted, linewidth=2)
plot(alma_slow, title="ALMA البطيء", color=bullish_trend ? qs_blue : qs_muted, linewidth=2)

// تلوين المسافة بين المتوسطين
p_fast = plot(alma_fast, display=display.none)
p_slow = plot(alma_slow, display=display.none)
fill(p_fast, p_slow, color=bullish_trend ? color.new(qs_green, 85) : color.new(qs_muted, 90), title="تلوين الاتجاه")

// تلوين الشموع للإيجابية فقط (لجذب انتباه متداول السبوت)
barcolor(bullish_trend ? qs_green : na, title="تلوين شموع الإيجابية")

// --- 5. لوحة معلومات QuantScript (Dashboard) ---
var table qs_dash = table.new(position.top_right, 2, 2, bgcolor=qs_blue, border_width=1, border_color=color.new(color.white, 80))

if barstate.islast
    // ترويسة اللوحة
    table.cell(qs_dash, 0, 0, "QuantScript", text_color=qs_green, text_size=size.normal, text_halign=text.align_center)
    table.merge_cells(qs_dash, 0, 0, 1, 0)
    
    // حالة الاتجاه
    table.cell(qs_dash, 0, 1, "Status:", text_color=color.white, text_size=size.small)
    table.cell(qs_dash, 1, 1, bullish_trend ? "BULLISH (SPOT)" : "WAITING...", text_color=bullish_trend ? qs_green : color.gray, text_size=size.small)
