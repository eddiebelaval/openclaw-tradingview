//@version=6
indicator("Stage Analysis + Bollinger Bands", shorttitle="Stage+BB", overlay=true)

// ============================================================================
// CONCEPT: 30-Week SMA = 150-Day SMA = 7-Month SMA
// All represent approximately 6-7 months of trading
// Now includes Bollinger Bands for volatility analysis
// ============================================================================

// ============================================================================
// INPUTS
// ============================================================================
base_weeks = input.int(30, "Base Period (Weeks)", minval=5, maxval=100,
             tooltip="Base period in weeks - auto-converts for other timeframes", group="Stage Analysis")
show_stage_colors = input.bool(true, "Show Stage Colors on Candles", group="Stage Analysis")
show_stage_labels = input.bool(true, "Show Stage Change Labels", group="Stage Analysis")
show_ma_label = input.bool(true, "Show MA Label on Chart", group="Stage Analysis")

// EMA Inputs
show_ema12 = input.bool(false, "Show EMA 12", group="EMAs")
show_ema20 = input.bool(false, "Show EMA 20", group="EMAs")
show_ema50 = input.bool(false, "Show EMA 50", group="EMAs")
show_ema200 = input.bool(false, "Show EMA 200", group="EMAs")

// Bollinger Bands Inputs
show_bb = input.bool(true, "Show Bollinger Bands", group="Bollinger Bands")
bb_length = input.int(20, "BB Length", minval=1, group="Bollinger Bands")
bb_mult = input.float(2.0, "BB Std Dev Multiplier", minval=0.1, step=0.1, group="Bollinger Bands")
show_bb_squeeze = input.bool(true, "Highlight BB Squeeze", group="Bollinger Bands", 
              tooltip="Highlights when bands are narrowing (low volatility)")
show_bb_breakouts = input.bool(true, "Mark BB Breakouts", group="Bollinger Bands",
                 tooltip="Shows signals when price breaks outside bands")

// Ichimoku Cloud Inputs
show_ichimoku = input.bool(true, "Show Ichimoku Cloud", group="Ichimoku")
tenkan_period = input.int(9, "Conversion Line (Tenkan-sen)", minval=1, group="Ichimoku")
kijun_period = input.int(26, "Base Line (Kijun-sen)", minval=1, group="Ichimoku")
senkou_span_b_period = input.int(52, "Leading Span B (Senkou Span B)", minval=1, group="Ichimoku")
displacement = input.int(26, "Cloud Displacement", minval=1, group="Ichimoku",
               tooltip="Projects cloud forward")
show_chikou = input.bool(false, "Show Lagging Span (Chikou)", group="Ichimoku")

// ============================================================================
// AUTO-ADJUST SMA LENGTH BASED ON TIMEFRAME
// ============================================================================
// Detect current timeframe
is_monthly = timeframe.ismonthly
is_weekly = timeframe.isweekly
is_daily = timeframe.isdaily
is_intraday = not is_daily and not is_weekly and not is_monthly

// Calculate adjusted SMA length
int ma_length = 150  // Default to daily
string tf_label = "Day"

if is_weekly
    // Weekly chart: use base_weeks directly (30 weeks)
    ma_length := base_weeks
    tf_label := "Week"
else if is_daily
    // Daily chart: 30 weeks = 150 trading days (5 days per week)
    ma_length := base_weeks * 5
    tf_label := "Day"
else if is_monthly
    // Monthly chart: 30 weeks ≈ 7 months (4.33 weeks per month)
    ma_length := math.round(base_weeks / 4.33)
    tf_label := "Month"
else if is_intraday
    // Intraday charts: calculate based on minutes
    // 1 trading day = 390 minutes (6.5 hours)
    // 1 week = 5 days = 1950 minutes
    current_tf_mins = timeframe.in_seconds() / 60
    minutes_per_week = 1950
    total_minutes = base_weeks * minutes_per_week
    ma_length := math.round(total_minutes / current_tf_mins)
    
    // Determine label based on timeframe
    if current_tf_mins >= 60
        tf_label := "Hour"
    else
        tf_label := "Min"

// ============================================================================
// MOVING AVERAGE
// ============================================================================
ma30 = ta.sma(close, ma_length)

// Calculate MA slope (is it rising or falling?)
ma_rising = ma30 > ma30[1]
ma_slope_rate = (ma30 - ma30[5]) / ma30[5] * 100  // 5-period slope percentage

// ============================================================================
// BOLLINGER BANDS
// ============================================================================
bb_basis = ta.sma(close, bb_length)
bb_dev = ta.stdev(close, bb_length)
bb_upper = bb_basis + (bb_mult * bb_dev)
bb_lower = bb_basis - (bb_mult * bb_dev)

// Bollinger Band Width (volatility measure)
bb_width = (bb_upper - bb_lower) / bb_basis * 100

// BB Squeeze Detection (bands narrowing = low volatility)
bb_width_sma = ta.sma(bb_width, 20)
bb_squeeze = bb_width < bb_width_sma * 0.7  // Width is 30% below average

// BB Breakouts
bb_breakout_up = close > bb_upper and close[1] <= bb_upper[1]
bb_breakout_down = close < bb_lower and close[1] >= bb_lower[1]

// Price position in BB channel (0% = lower band, 100% = upper band)
bb_pct = (close - bb_lower) / (bb_upper - bb_lower) * 100

// ============================================================================
// ICHIMOKU CLOUD
// ============================================================================
// Conversion Line (Tenkan-sen) - (9-period high + 9-period low) / 2
tenkan = (ta.highest(high, tenkan_period) + ta.lowest(low, tenkan_period)) / 2

// Base Line (Kijun-sen) - (26-period high + 26-period low) / 2
kijun = (ta.highest(high, kijun_period) + ta.lowest(low, kijun_period)) / 2

// Leading Span A (Senkou Span A) - (Conversion + Base) / 2, projected forward
senkou_span_a = (tenkan + kijun) / 2

// Leading Span B (Senkou Span B) - (52-period high + 52-period low) / 2, projected forward
senkou_span_b = (ta.highest(high, senkou_span_b_period) + ta.lowest(low, senkou_span_b_period)) / 2

// Lagging Span (Chikou Span) - Close projected backwards
chikou = close

// Cloud color determination (bullish = green, bearish = red)
cloud_bullish = senkou_span_a > senkou_span_b
cloud_color = cloud_bullish ? color.new(color.green, 80) : color.new(color.red, 80)

// Price vs Cloud
price_above_cloud = close > math.max(senkou_span_a[displacement], senkou_span_b[displacement])
price_below_cloud = close < math.min(senkou_span_a[displacement], senkou_span_b[displacement])
price_in_cloud = not price_above_cloud and not price_below_cloud

// Ichimoku signals
tk_cross_bullish = ta.crossover(tenkan, kijun)  // Tenkan crosses above Kijun (bullish)
tk_cross_bearish = ta.crossunder(tenkan, kijun)  // Tenkan crosses below Kijun (bearish)

// ============================================================================
// STAGE ANALYSIS (Weinstein Stages)
// ============================================================================
// Price position relative to MA
price_above_ma = close > ma30
price_pct_from_ma = ((close - ma30) / ma30) * 100

// Stage determination
var int current_stage = 0

// Stage 2: Price above rising MA (Advancing phase - GREEN)
stage2 = price_above_ma and ma_rising and close > close[4]

// Stage 4: Price below falling MA (Declining phase - RED)
stage4 = not price_above_ma and not ma_rising and close < close[4]

// Stage 1: Basing after decline
stage1 = not price_above_ma and ma_rising

// Stage 3: Topping after advance
stage3 = price_above_ma and not ma_rising

// Assign stage
if stage2
    current_stage := 2
else if stage4
    current_stage := 4
else if stage1
    current_stage := 1
else if stage3
    current_stage := 3

// ============================================================================
// STAGE CHANGE DETECTION
// ============================================================================
stage2_start = stage2 and not stage2[1]  // Entering Stage 2 (bullish)
stage4_start = stage4 and not stage4[1]  // Entering Stage 4 (bearish)
stage1_start = stage1 and not stage1[1]  // Entering Stage 1 (basing)
stage3_start = stage3 and not stage3[1]  // Entering Stage 3 (topping)

// ============================================================================
// BREACH DETECTION
// ============================================================================
breach_above = close > ma30 and close[1] <= ma30[1]  // Price breaches above SMA
breach_below = close < ma30 and close[1] >= ma30[1]  // Price breaches below SMA

// ============================================================================
// COLORING - ONLY change on breaches
// ============================================================================
candle_color = breach_above ? color.new(color.lime, 0) :
               breach_below ? color.new(color.yellow, 0) :
               na

// Apply colors if enabled
barcolor(show_stage_colors ? candle_color : na, title="Breach Colors")

// ============================================================================
// PLOTTING - BOLLINGER BANDS
// ============================================================================
bb_upper_plot = plot(show_bb ? bb_upper : na, "BB Upper", color=color.new(color.blue, 50), linewidth=1)
bb_lower_plot = plot(show_bb ? bb_lower : na, "BB Lower", color=color.new(color.blue, 50), linewidth=1)
bb_basis_plot = plot(show_bb ? bb_basis : na, "BB Basis", color=color.new(color.gray, 70), linewidth=1, style=plot.style_circles)

// Fill between bands
fill(bb_upper_plot, bb_lower_plot, color=color.new(color.blue, 95), title="BB Fill")

// Highlight squeeze with different color
bgcolor(show_bb and show_bb_squeeze and bb_squeeze ? color.new(color.yellow, 95) : na, title="BB Squeeze")

// ============================================================================
// PLOTTING - MOVING AVERAGES
// ============================================================================
// Plot the auto-adjusted SMA
ma_color = ma_rising ? color.new(color.white, 20) : color.new(color.gray, 40)
plot(ma30, "Auto SMA", color=ma_color, linewidth=3)

// EMAs
ema12 = ta.ema(close, 12)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)

plot(show_ema12 ? ema12 : na, "EMA 12", color=color.purple, linewidth=2)
plot(show_ema20 ? ema20 : na, "EMA 20", color=color.orange, linewidth=2)
plot(show_ema50 ? ema50 : na, "EMA 50", color=color.blue, linewidth=2)
plot(show_ema200 ? ema200 : na, "EMA 200", color=color.red, linewidth=2)

// ============================================================================
// PLOTTING - ICHIMOKU CLOUD
// ============================================================================
// Plot Conversion Line (Tenkan-sen) - Red/Fast
plot(show_ichimoku ? tenkan : na, "Conversion Line", 
     color=color.new(color.red, 0), linewidth=1)

// Plot Base Line (Kijun-sen) - Blue/Slow
plot(show_ichimoku ? kijun : na, "Base Line", 
     color=color.new(color.blue, 0), linewidth=1)

// Plot Leading Span A (displaced forward)
senkou_a_plot = plot(show_ichimoku ? senkou_span_a : na, "Leading Span A", 
                     color=color.new(color.green, 0), 
                     offset=displacement,
                     display=display.none)

// Plot Leading Span B (displaced forward)
senkou_b_plot = plot(show_ichimoku ? senkou_span_b : na, "Leading Span B", 
                     color=color.new(color.red, 0),
                     offset=displacement,
                     display=display.none)

// Fill cloud between Span A and Span B
fill(senkou_a_plot, senkou_b_plot, 
     color=show_ichimoku ? cloud_color : na,
     title="Ichimoku Cloud")

// Plot Lagging Span (Chikou) - displaced backward (optional)
plot(show_ichimoku and show_chikou ? chikou : na, "Lagging Span", 
     color=color.new(color.purple, 0),
     offset=-displacement,
     linewidth=1)

// ============================================================================
// BB BREAKOUT SIGNALS
// ============================================================================
plotshape(show_bb and show_bb_breakouts and bb_breakout_up, "BB Breakout Up", 
          shape.circle, location.abovebar,
          color=color.new(color.aqua, 0), size=size.tiny)

plotshape(show_bb and show_bb_breakouts and bb_breakout_down, "BB Breakout Down", 
          shape.circle, location.belowbar,
          color=color.new(color.fuchsia, 0), size=size.tiny)

// Ichimoku TK Cross signals
plotshape(show_ichimoku and tk_cross_bullish, "TK Cross Bull", 
          shape.xcross, location.belowbar,
          color=color.new(color.lime, 0), size=size.tiny)

plotshape(show_ichimoku and tk_cross_bearish, "TK Cross Bear", 
          shape.xcross, location.abovebar,
          color=color.new(color.red, 0), size=size.tiny)

// ============================================================================
// STAGE LABELS
// ============================================================================
if show_stage_labels
    // Stage 2 Entry (Bullish breakout)
    if stage2_start
        label.new(bar_index, low, "Stage 2\nAdvancing", 
                  style=label.style_label_up, 
                  color=color.new(color.green, 20),
                  textcolor=color.white,
                  size=size.normal)
    
    // Stage 4 Entry (Bearish breakdown)
    if stage4_start
        label.new(bar_index, high, "Stage 4\nDeclining", 
                  style=label.style_label_down, 
                  color=color.new(color.red, 20),
                  textcolor=color.white,
                  size=size.normal)
    
    // Stage 1 Entry (Basing)
    if stage1_start
        label.new(bar_index, low, "Stage 1\nBasing", 
                  style=label.style_label_up, 
                  color=color.new(color.blue, 40),
                  textcolor=color.white,
                  size=size.small)
    
    // Stage 3 Entry (Topping)
    if stage3_start
        label.new(bar_index, high, "Stage 3\nTopping", 
                  style=label.style_label_down, 
                  color=color.new(color.orange, 30),
                  textcolor=color.white,
                  size=size.small)
    
    // BB Squeeze Labels (Low volatility - breakout imminent)
    if show_bb and bb_squeeze and not bb_squeeze[1]
        label.new(bar_index, high, "BB\nSQUEEZE", 
                  style=label.style_label_down,
                  color=color.new(color.yellow, 30),
                  textcolor=color.black,
                  size=size.small,
                  yloc=yloc.abovebar)

// ============================================================================
// MA LABEL ON CHART
// ============================================================================
if show_ma_label and barstate.islast
    // Create dynamic label showing actual period and timeframe
    label_text = str.tostring(ma_length) + "-" + tf_label + "\nSMA"
    label.new(bar_index + 5, ma30, label_text, 
              style=label.style_label_left,
              color=color.new(color.white, 80),
              textcolor=color.white,
              size=size.normal)

// ============================================================================
// SIGNALS & SHAPES
// ============================================================================
plotshape(stage2_start, "Stage 2 Entry", shape.triangleup, location.belowbar,
          color=color.new(color.lime, 0), size=size.small)

plotshape(stage4_start, "Stage 4 Entry", shape.triangledown, location.abovebar,
          color=color.new(color.red, 0), size=size.small)

// ============================================================================
// BACKGROUND HIGHLIGHTING
// ============================================================================
bg_color = stage2 ? color.new(color.green, 97) :
           stage4 ? color.new(color.red, 97) :
           stage1 ? color.new(color.blue, 98) :
           stage3 ? color.new(color.orange, 97) : na

bgcolor(bg_color, title="Stage Background")

// ============================================================================
// DASHBOARD
// ============================================================================
var table dashboard = table.new(position.bottom_right, 2, 12, 
                                bgcolor=color.new(color.black, 85), border_width=1)

if barstate.islast
    // Timeframe info
    table.cell(dashboard, 0, 0, "Timeframe", text_color=color.white, 
               bgcolor=color.new(color.blue, 60))
    tf_display = str.tostring(ma_length) + " " + tf_label + " SMA"
    table.cell(dashboard, 1, 0, tf_display, text_color=color.yellow, 
               bgcolor=color.new(color.blue, 60))
    
    // Current Stage
    stage_name = current_stage == 2 ? "STAGE 2 - Advancing" :
                 current_stage == 4 ? "STAGE 4 - Declining" :
                 current_stage == 1 ? "STAGE 1 - Basing" :
                 current_stage == 3 ? "STAGE 3 - Topping" : "Unknown"
    
    stage_color = current_stage == 2 ? color.lime :
                  current_stage == 4 ? color.red :
                  current_stage == 1 ? color.blue :
                  current_stage == 3 ? color.orange : color.gray
    
    table.cell(dashboard, 0, 1, "Current Stage", text_color=color.white)
    table.cell(dashboard, 1, 1, stage_name, text_color=stage_color)
    
    // Price vs MA
    table.cell(dashboard, 0, 2, "Price vs MA", text_color=color.white)
    pct_text = str.tostring(math.round(price_pct_from_ma, 2)) + "%"
    table.cell(dashboard, 1, 2, pct_text, 
               text_color=price_above_ma ? color.lime : color.red)
    
    // MA Trend
    table.cell(dashboard, 0, 3, "MA Trend", text_color=color.white)
    table.cell(dashboard, 1, 3, ma_rising ? "Rising ↗" : "Falling ↘", 
               text_color=ma_rising ? color.lime : color.red)
    
    // MA Slope
    table.cell(dashboard, 0, 4, "MA Slope %", text_color=color.white)
    slope_text = str.tostring(math.round(ma_slope_rate, 2)) + "%"
    table.cell(dashboard, 1, 4, slope_text, text_color=color.white)
    
    // BB Position
    table.cell(dashboard, 0, 5, "BB Position", text_color=color.white)
    bb_pos_text = str.tostring(math.round(bb_pct, 0)) + "%"
    bb_pos_color = bb_pct > 80 ? color.red : bb_pct < 20 ? color.lime : color.yellow
    table.cell(dashboard, 1, 5, bb_pos_text, text_color=bb_pos_color)
    
    // BB Width (Volatility)
    table.cell(dashboard, 0, 6, "BB Width %", text_color=color.white)
    width_text = str.tostring(math.round(bb_width, 2)) + "%"
    table.cell(dashboard, 1, 6, width_text, text_color=color.white)
    
    // BB Squeeze Status
    table.cell(dashboard, 0, 7, "BB Squeeze", text_color=color.white)
    table.cell(dashboard, 1, 7, bb_squeeze ? "YES ⚠" : "NO", 
               text_color=bb_squeeze ? color.yellow : color.gray)
    
    // Ichimoku Cloud Position
    table.cell(dashboard, 0, 8, "vs Ichimoku", text_color=color.white)
    ichi_pos = price_above_cloud ? "Above ↑" : price_below_cloud ? "Below ↓" : "In Cloud"
    ichi_color = price_above_cloud ? color.lime : price_below_cloud ? color.red : color.yellow
    table.cell(dashboard, 1, 8, ichi_pos, text_color=ichi_color)
    
    // Ichimoku Cloud Color
    table.cell(dashboard, 0, 9, "Cloud Color", text_color=color.white)
    table.cell(dashboard, 1, 9, cloud_bullish ? "Green ↗" : "Red ↘",
               text_color=cloud_bullish ? color.lime : color.red)
    
    // TK Cross
    table.cell(dashboard, 0, 10, "TK Cross", text_color=color.white)
    tk_status = tenkan > kijun ? "Bull ↗" : "Bear ↘"
    tk_color = tenkan > kijun ? color.lime : color.red
    table.cell(dashboard, 1, 10, tk_status, text_color=tk_color)
    
    // Action
    table.cell(dashboard, 0, 11, "Action", text_color=color.white, 
               bgcolor=color.new(color.purple, 60))
    action = current_stage == 2 ? "BUY/HOLD" :
             current_stage == 4 ? "SELL/AVOID" :
             current_stage == 1 ? "WATCH" :
             current_stage == 3 ? "CAUTION" : "WAIT"
    table.cell(dashboard, 1, 11, action, text_color=stage_color, 
               bgcolor=color.new(color.purple, 60))

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(stage2_start, "Stage 2 - Advancing", 
               "{{ticker}}: Entering Stage 2 - Bullish!")

alertcondition(stage4_start, "Stage 4 - Declining", 
               "{{ticker}}: Entering Stage 4 - Bearish!")

alertcondition(stage3_start, "Stage 3 - Topping", 
               "{{ticker}}: Entering Stage 3 - Warning!")

alertcondition(stage1_start, "Stage 1 - Basing", 
               "{{ticker}}: Entering Stage 1 - Watch for setup")

alertcondition(breach_above, "Breached Above MA", 
               "{{ticker}}: Price breached above the SMA at {{close}}")

alertcondition(breach_below, "Breached Below MA", 
               "{{ticker}}: Price breached below the SMA at {{close}}")

alertcondition(bb_breakout_up, "BB Breakout Above",
               "{{ticker}}: Price broke above upper Bollinger Band at {{close}}")

alertcondition(bb_breakout_down, "BB Breakout Below",
               "{{ticker}}: Price broke below lower Bollinger Band at {{close}}")

alertcondition(bb_squeeze and not bb_squeeze[1], "BB Squeeze Started",
               "{{ticker}}: Bollinger Bands squeezing - low volatility, breakout likely!")

alertcondition(tk_cross_bullish, "Ichimoku TK Cross Bullish",
               "{{ticker}}: Tenkan crossed above Kijun - Bullish signal!")

alertcondition(tk_cross_bearish, "Ichimoku TK Cross Bearish",
               "{{ticker}}: Tenkan crossed below Kijun - Bearish signal!")

alertcondition(price_above_cloud and price_in_cloud[1], "Price Above Cloud",
               "{{ticker}}: Price broke above Ichimoku Cloud - Bullish!")

alertcondition(price_below_cloud and price_in_cloud[1], "Price Below Cloud",
               "{{ticker}}: Price broke below Ichimoku Cloud - Bearish!")

// ============================================================================
// INTERPRETATION GUIDE
// ============================================================================
// BB SQUEEZE:
// - Yellow background = Bands narrowing (volatility compression)
// - Typically precedes strong directional move
// - Watch for breakout above/below bands + Stage 2/4 signal
//
// BB BREAKOUTS:
// - Above upper band = Strong momentum (could be overextended)
// - Below lower band = Weakness (could be oversold)
// - Best combined with Stage Analysis for confirmation
//
// BB POSITION:
// - 0-20% = Near lower band (oversold territory)
// - 40-60% = Middle of channel (neutral)
// - 80-100% = Near upper band (overbought territory)
//
// ICHIMOKU CLOUD:
// - Price above cloud = Bullish trend
// - Price below cloud = Bearish trend
// - Price in cloud = Neutral/consolidation
// - Green cloud (Span A > Span B) = Bullish
// - Red cloud (Span A < Span B) = Bearish
//
// TENKAN-KIJUN CROSS (TK Cross):
// - Tenkan (red) crosses above Kijun (blue) = Bullish signal
// - Tenkan crosses below Kijun = Bearish signal
// - Best when price is above cloud
//
// COMBINED STRATEGY:
// 1. Wait for BB Squeeze (yellow background)
// 2. Confirm Stage 2 (bullish) or Stage 4 (bearish)
// 3. Check Ichimoku: Price above cloud = bullish bias
// 4. Enter on TK Cross + BB breakout in trend direction
// 5. Use opposite BB + cloud edge as targets
//
// TRIPLE CONFIRMATION (Strongest Signals):
// BULLISH: Stage 2 + Price above cloud + TK cross bull + BB breakout up
// BEARISH: Stage 4 + Price below cloud + TK cross bear + BB breakout down
