//@version=6
indicator("FRAN CRASH PLAY RULES", overlay=true)

// Input settings for customizable text
line1 = input.string("• DYNAMIC 3 TO 5 LEG RUN", "Line 1")
line2 = input.string("• NEAR VERTICAL ACCELERATION", "Line 2")
line3 = input.string("• FINAL BAR OF THE RUN UP MUST BE THE BIGGEST", "Line 3")
line4 = input.string("• 3 FINGER SPREAD / DUAL SPACE", "Line 4")
line5 = input.string("• ATLEAST 2 OF 5 CRITERIA NEEDS TO HIT", "Line 5")

// Input settings for text appearance
textColor = input.color(color.white, "Text Color")
textSize = input.string("normal", "Text Size", options=["tiny", "small", "normal", "large", "huge"])

// Input settings for background
bgColor = input.color(color.new(color.black, 20), "Background Color")
frameColor = input.color(color.new(color.gray, 50), "Frame Color")
showFrame = input.bool(true, "Show Frame")

// ── EMA Settings ──────────────────────────────────────────
ema20Length  = input.int(20,  "EMA 1 Length",  minval=1, group="EMA Settings")
ema20Source  = input.source(close, "EMA 1 Source",       group="EMA Settings")
ema20Color   = input.color(color.new(#00e5ff, 0), "EMA 1 Color", group="EMA Settings")
ema20Width   = input.int(2,   "EMA 1 Line Width", minval=1, maxval=4, group="EMA Settings")
showEma20    = input.bool(true, "Show EMA 1",              group="EMA Settings")

ema200Length = input.int(200, "EMA 2 Length",  minval=1, group="EMA Settings")
ema200Source = input.source(close, "EMA 2 Source",         group="EMA Settings")
ema200Color  = input.color(color.new(#ff9800, 0), "EMA 2 Color", group="EMA Settings")
ema200Width  = input.int(2,   "EMA 2 Line Width", minval=1, maxval=4, group="EMA Settings")
showEma200   = input.bool(true, "Show EMA 2",              group="EMA Settings")
// ──────────────────────────────────────────────────────────

// Calculate EMAs
ema20  = ta.ema(ema20Source,  ema20Length)
ema200 = ta.ema(ema200Source, ema200Length)

// Plot EMAs
plot(showEma20  ? ema20  : na, title="EMA 1", color=ema20Color,  linewidth=ema20Width)
plot(showEma200 ? ema200 : na, title="EMA 2", color=ema200Color, linewidth=ema200Width)

// Create the info panel in top right corner
var table infoTable = table.new(position.top_right, 1, 5, 
     bgcolor=bgColor,
     frame_color=frameColor,
     frame_width=showFrame ? 1 : 0,
     border_width=showFrame ? 1 : 0,
     border_color=frameColor)

// Update table content on each bar
if barstate.islast
    table.cell(infoTable, 0, 0, line1, text_color=textColor, text_size=textSize, bgcolor=color.new(color.black, 100))
    table.cell(infoTable, 0, 1, line2, text_color=textColor, text_size=textSize, bgcolor=color.new(color.black, 100))
    table.cell(infoTable, 0, 2, line3, text_color=textColor, text_size=textSize, bgcolor=color.new(color.black, 100))
    table.cell(infoTable, 0, 3, line4, text_color=textColor, text_size=textSize, bgcolor=color.new(color.black, 100))
    table.cell(infoTable, 0, 4, line5, text_color=textColor, text_size=textSize, bgcolor=color.new(color.black, 100))
