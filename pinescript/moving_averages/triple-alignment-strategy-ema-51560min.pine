//@version=5
indicator("Stratégie Triple Alignement EMA (5/15/60min)", overlay=true)

// --- PARAMÈTRES DES EMA ---
ema6_len  = 6
ema9_len  = 9
ema12_len = 12

// --- FONCTION POUR RÉCUPÉRER L'ÉTAT SUR UNE UNITÉ DE TEMPS ---
get_ema_state(tf) =>
    e6 = request.security(syminfo.tickerid, tf, ta.ema(close, ema6_len))
    e9 = request.security(syminfo.tickerid, tf, ta.ema(close, ema9_len))
    e12 = request.security(syminfo.tickerid, tf, ta.ema(close, ema12_len))
    
    // Signal Achat (Bullish) : Jaune > Verte > Rouge
    bull = (e6 > e9) and (e9 > e12)
    // Signal Vente (Bearish) : Jaune < Verte < Rouge
    bear = (e6 < e9) and (e9 < e12)
    [bull, bear]

// --- RÉCUPÉRATION SUR LES 3 TIMEFRAMES ---
[bull5, bear5]   = get_ema_state("5")
[bull15, bear15] = get_ema_state("15")
[bull60, bear60] = get_ema_state("60")

// --- CONDITIONS FINALES (Alignement parfait) ---
longCondition  = bull5 and bull15 and bull60
shortCondition = bear5 and bear15 and bear60

// --- AFFICHAGE SUR LE GRAPHIQUE ---
ema6  = ta.ema(close, ema6_len)
ema9  = ta.ema(close, ema9_len)
ema12 = ta.ema(close, ema12_len)

plot(ema6,  "EMA 6 Jaune", color=color.yellow, linewidth=2)
plot(ema9,  "EMA 9 Verte", color=color.green,  linewidth=2)
plot(ema12, "EMA 12 Rouge", color=color.red,    linewidth=2)

// Signaux visuels
plotshape(longCondition and not longCondition[1],  "Signal ACHAT",  shape.triangleup,   location.belowbar, color.lime, size=size.small, text="ACHAT MULTI")
plotshape(shortCondition and not shortCondition[1], "Signal VENTE", shape.triangledown, location.abovebar, color.red,  size=size.small, text="VENTE MULTI")

// Coloration de l'arrière-plan pour plus de clarté
bgcolor(longCondition ? color.new(color.lime, 90) : shortCondition ? color.new(color.red, 90) : na)

// --- ALERTES POUR LE TÉLÉPHONE ---
if (longCondition and not longCondition[1])
    alert("🚀 SIGNAL ACHAT : Alignement EMA 5/15/60min confirmé sur " + syminfo.ticker, alert.freq_once_per_bar_close)

if (shortCondition and not shortCondition[1])
    alert("📉 SIGNAL VENTE : Alignement EMA 5/15/60min confirmé sur " + syminfo.ticker, alert.freq_once_per_bar_close)
