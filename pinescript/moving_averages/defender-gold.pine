//@version=5
indicator("DEFENDER GOLD", overlay=true)

// ===== INPUTS =====
ema200Length = input.int(200, "EMA 200 Length")
ema400Length = input.int(400, "EMA 400 Length")

// ===== SESSIONS IN UTC =====
asiaSession      = "2000-0100"
preLondonSession = "0100-0300"
londonSession    = "0300-0800"
newYorkSession   = "0800-1300"

// ===== EMAs =====
ema200 = ta.ema(close, ema200Length)
ema400 = ta.ema(close, ema400Length)

plot(ema200, color=color.red, linewidth=1, title="200 EMA")
plot(ema400, color=color.black, linewidth=1, title="400 EMA")

// ===== SESSION BOX FUNCTION =====
f_drawSession(sessionTime, boxColor) =>
    var box sessBox = na
    var float sessHigh = na
    var float sessLow = na
    
    inSession = not na(time(timeframe.period, sessionTime))
    
    if inSession and not inSession[1]
        sessHigh := high
        sessLow := low
        sessBox := box.new(bar_index, high, bar_index, low,
             border_color=color.new(boxColor, 90),
             bgcolor=color.new(boxColor, 95))
        
    if inSession
        sessHigh := math.max(sessHigh, high)
        sessLow := math.min(sessLow, low)
        box.set_top(sessBox, sessHigh)
        box.set_bottom(sessBox, sessLow)
        box.set_right(sessBox, bar_index)

// ===== DRAW SESSIONS =====
f_drawSession(asiaSession, color.blue)
f_drawSession(preLondonSession, color.purple)
f_drawSession(londonSession, color.green)
f_drawSession(newYorkSession, color.red)
