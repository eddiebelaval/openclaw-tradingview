//@version=6
indicator("Ultimate Regime", "Ult. Regime | MisinkoMaster", false)
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//Import Libraries
import TradingView/ta/12
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//Get User Defined Inputs
src = input.source(close, "Source",
     group = "Ultimate Regime")
mrlen = input.int(35, "High-Low Difference", step = 1, minval = 2,
     tooltip = "Changes the HLD lookback period for the HLD",
     group = "Ultimate Regime")
atrlen = input.int(32, "ATR Lookback", step = 1, minval = 2,
     tooltip = "Changes the ATR lookback period for the ATR",
     group = "Ultimate Regime")
sdlen = input.int(34, "Standard Deviation Lookback", step = 1, minval = 2,
     tooltip = "Changes the Standard Deviation lookback period for the Standard Deviation",
     group = "Ultimate Regime")
adxlen = input.int(37, "ADX Lookback", step = 1, minval = 2,
     tooltip = "Changes the adX lookback period for the ADX",
     group = "Ultimate Regime")

smooth = input.int(50, "Smoothing Period", step = 1, minval = 2,
     tooltip = "Changes the smoothing period for the Regime",
     group = "Ultimate Regime")
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//Calculations
tr = ta.tr(true)
mr = high-low
amr = ta.ema(mr, mrlen)
atr = ta.ema(tr, atrlen)
sd = ta.stdev(src, sdlen)
[diu, did, adx] = ta.dmi(adxlen, adxlen)

samr = ta.ema(amr, smooth)
satr = ta.ema(atr, smooth)
ssd = ta.ema(sd, smooth)
sadx = ta.ema(adx, smooth)

atrs = atr > satr ? 1 : atr < satr ? -1 : 0
samrs = amr > samr ? 1 : amr < samr ? -1 : 0
sds = sd > ssd ? 1 : sd < ssd ? -1 : 0
adxs = adx > sadx ? 1 : adx < sadx ? -1 : 0

ur = math.avg(atrs, samrs, sds, adxs)
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//Regime Logic
var regime = 0

L = ur > 0
S = ur < 0

if L
    regime := 1
if S
    regime := -1
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//Plotting
var col = color.rgb(58, 58, 58)
var colT = color.rgb(58, 58, 58, 60)


if regime == 1
    col := color.rgb(10, 23, 199)
    colT := color.rgb(10, 23, 199, 60)
if regime == -1
    col := color.rgb(189, 7, 16)
    colT := color.rgb(189, 7, 16, 60)

rp = plot(ur, "Regime Value", col, 3, plot.style_histogram, histbase = 0)
plotshape(regime == 1 and regime[1] != 1 ? low : na, style = shape.labelup, location = location.belowbar, size = size.normal, color = color.rgb(65, 75, 216), display = display.pane, force_overlay = true, text = "Trending", textcolor = color.rgb(10, 23, 199))
plotshape(regime == -1 and regime[1] != -1 ? high : na, style = shape.labeldown, location = location.abovebar, size = size.normal, color = color.rgb(226, 51, 60), display = display.pane, force_overlay = true, text = "Mean Reverting", textcolor = color.rgb(145, 9, 15))
plotcandle(open, high, low, close, bordercolor = col, color = col, wickcolor = col, display = display.pane, force_overlay = true)

plot(0, "Neutral Treshhold", color.rgb(58, 58, 58, 10), 2)
plot(1, "Max Treshhold", color.rgb(10, 23, 199), 2)
plot(-1, "Min Treshhold", color.rgb(189, 7, 16), 2)
