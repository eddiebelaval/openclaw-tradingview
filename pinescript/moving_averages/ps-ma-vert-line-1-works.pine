//@version=5
indicator("PS MA VERT Cross WORKS Vertical Lines (RTH Only) (MA1 vs MA2 & MA3)", overlay=true, max_lines_count=500)

// ─────────────────────────────────────────────────────────────────────────────
// MA helper
maCalc(_src, _len, _type) => _type == "EMA" ? ta.ema(_src, _len) : _type == "SMA" ? ta.sma(_src, _len) : _type == "RMA" ? ta.rma(_src, _len) : _type == "WMA" ? ta.wma(_src, _len) : _type == "VWMA" ? ta.vwma(_src, _len) : _type == "HMA" ? ta.hma(_src, _len) : ta.ema(_src, _len)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS: Moving Averages
grp1 = "Moving Average 1"
ma1Type  = input.string("EMA", "MA1 Type", options=["EMA","SMA","RMA","WMA","VWMA","HMA"], group=grp1)
ma1Len   = input.int(9, "MA1 Length", minval=1, group=grp1)
ma1Src   = input.source(close, "MA1 Source", group=grp1)
ma1Show  = input.bool(true, "Show MA1", group=grp1)
ma1Col   = input.color(color.aqua, "MA1 Color", group=grp1)
ma1Wid   = input.int(2, "MA1 Width", minval=1, maxval=5, group=grp1)
ma1Style = input.string("Line", "MA1 Plot Style", options=["Line","LineBreak","StepLine","Circles","Cross"], group=grp1)

grp2 = "Moving Average 2"
ma2Type  = input.string("EMA", "MA2 Type", options=["EMA","SMA","RMA","WMA","VWMA","HMA"], group=grp2)
ma2Len   = input.int(21, "MA2 Length", minval=1, group=grp2)
ma2Src   = input.source(close, "MA2 Source", group=grp2)
ma2Show  = input.bool(true, "Show MA2", group=grp2)
ma2Col   = input.color(color.orange, "MA2 Color", group=grp2)
ma2Wid   = input.int(2, "MA2 Width", minval=1, maxval=5, group=grp2)
ma2Style = input.string("Line", "MA2 Plot Style", options=["Line","LineBreak","StepLine","Circles","Cross"], group=grp2)

grp3 = "Moving Average 3"
ma3Type  = input.string("SMA", "MA3 Type", options=["EMA","SMA","RMA","WMA","VWMA","HMA"], group=grp3)
ma3Len   = input.int(50, "MA3 Length", minval=1, group=grp3)
ma3Src   = input.source(close, "MA3 Source", group=grp3)
ma3Show  = input.bool(true, "Show MA3", group=grp3)
ma3Col   = input.color(color.fuchsia, "MA3 Color", group=grp3)
ma3Wid   = input.int(2, "MA3 Width", minval=1, maxval=5, group=grp3)
ma3Style = input.string("Line", "MA3 Plot Style", options=["Line","LineBreak","StepLine","Circles","Cross"], group=grp3)

// Convert user plot style -> plot.style_*
plotStyleFrom(_s) => _s == "Line" ? plot.style_line : _s == "LineBreak" ? plot.style_linebr : _s == "StepLine" ? plot.style_stepline : _s == "Circles" ? plot.style_circles : plot.style_cross

// ─────────────────────────────────────────────────────────────────────────────
// Compute MAs
ma1 = maCalc(ma1Src, ma1Len, ma1Type)
ma2 = maCalc(ma2Src, ma2Len, ma2Type)
ma3 = maCalc(ma3Src, ma3Len, ma3Type)

// Plot MAs
plot(ma1Show ? ma1 : na, "MA1", color=ma1Col, linewidth=ma1Wid, style=plotStyleFrom(ma1Style))
plot(ma2Show ? ma2 : na, "MA2", color=ma2Col, linewidth=ma2Wid, style=plotStyleFrom(ma2Style))
plot(ma3Show ? ma3 : na, "MA3", color=ma3Col, linewidth=ma3Wid, style=plotStyleFrom(ma3Style))

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS: Regular Trading Hours (RTH) filter
grpRTH = "Time Filter (Regular Trading Hours Only)"
useRTH = input.bool(true, "Only draw lines during RTH", group=grpRTH)
rthSes = input.session("0930-1600", "RTH Session (exchange time)", group=grpRTH)
inRTH  = not na(time(timeframe.period, rthSes))
allowDraw = not useRTH or inRTH

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS: Vertical lines + management
grpLines = "Vertical Lines (Crosses)"
limitLines     = input.bool(true, "Limit number of vertical lines", group=grpLines)
maxVLines      = input.int(200, "Max vertical lines kept", minval=10, maxval=500, group=grpLines)

lineStylePick(_s) => _s == "Solid" ? line.style_solid : _s == "Dashed" ? line.style_dashed : line.style_dotted

// Cross: MA1 vs MA2 (independent toggles for up/down)
grp12 = "Cross Lines: MA1 vs MA2"
show12      = input.bool(true, "Enable MA1↔MA2", group=grp12)
show12Up    = input.bool(true, "Draw Up Cross (MA1 above MA2)", group=grp12)
show12Dn    = input.bool(true, "Draw Down Cross (MA1 below MA2)", group=grp12)
col12Up     = input.color(color.lime, "Up Color", group=grp12)
col12Dn     = input.color(color.red, "Down Color", group=grp12)
wid12       = input.int(2, "Line Width", minval=1, maxval=5, group=grp12)
sty12       = input.string("Solid", "Line Style", options=["Solid","Dashed","Dotted"], group=grp12)

// Cross: MA1 vs MA3 (independent toggles for up/down)
grp13 = "Cross Lines: MA1 vs MA3"
show13      = input.bool(true, "Enable MA1↔MA3", group=grp13)
show13Up    = input.bool(true, "Draw Up Cross (MA1 above MA3)", group=grp13)
show13Dn    = input.bool(true, "Draw Down Cross (MA1 below MA3)", group=grp13)
col13Up     = input.color(color.teal, "Up Color", group=grp13)
col13Dn     = input.color(color.maroon, "Down Color", group=grp13)
wid13       = input.int(2, "Line Width", minval=1, maxval=5, group=grp13)
sty13       = input.string("Dashed", "Line Style", options=["Solid","Dashed","Dotted"], group=grp13)

// Arrays to manage line count
var line[] vlines = array.new_line()

addVLine(_col, _wid, _sty) =>
    _ln = line.new(bar_index, low, bar_index, high, xloc=xloc.bar_index, extend=extend.both, color=_col, width=_wid, style=_sty)
    array.push(vlines, _ln)
    if limitLines and array.size(vlines) > maxVLines
        line.delete(array.shift(vlines))

// ─────────────────────────────────────────────────────────────────────────────
// Cross logic (gated by RTH filter)
cross12Up = allowDraw and show12 and show12Up and ta.crossover(ma1, ma2)
cross12Dn = allowDraw and show12 and show12Dn and ta.crossunder(ma1, ma2)
cross13Up = allowDraw and show13 and show13Up and ta.crossover(ma1, ma3)
cross13Dn = allowDraw and show13 and show13Dn and ta.crossunder(ma1, ma3)

// Draw vertical lines
if cross12Up
    addVLine(col12Up, wid12, lineStylePick(sty12))
if cross12Dn
    addVLine(col12Dn, wid12, lineStylePick(sty12))
if cross13Up
    addVLine(col13Up, wid13, lineStylePick(sty13))
if cross13Dn
    addVLine(col13Dn, wid13, lineStylePick(sty13))

// ─────────────────────────────────────────────────────────────────────────────
// Alerts (optional)
alertcondition(cross12Up, "MA1 Crossed Above MA2 (RTH)", "MA1 crossed above MA2 during RTH")
alertcondition(cross12Dn, "MA1 Crossed Below MA2 (RTH)", "MA1 crossed below MA2 during RTH")
alertcondition(cross13Up, "MA1 Crossed Above MA3 (RTH)", "MA1 crossed above MA3 during RTH")
alertcondition(cross13Dn, "MA1 Crossed Below MA3 (RTH)", "MA1 crossed below MA3 during RTH")
