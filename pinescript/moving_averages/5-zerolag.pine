//@version=6
// Mangetrader
indicator(title = '5 ZeroLag', shorttitle = '5 ZeroLag', overlay = true)

// User-defined timeframes
tf_1 = input.timeframe(title = 'Line 1', defval = '1')
tf_2 = input.timeframe(title = 'Line 2', defval = '3')
tf_3 = input.timeframe(title = 'Line 3', defval = '5')
tf_4 = input.timeframe(title = 'Line 4', defval = '15')
tf_5 = input.timeframe(title = 'Line 5', defval = '60')

// Inputs
length = input.int(title = 'Length', defval = 32)
offset = input.int(title = 'Offset', defval = 0)
src = input.source(close, title = 'Source')

// Viiva 1
show_1 = input.bool(true,         title = 'Line 1 extended',  group = 'Viiva 1')
c1     = input.color(color.blue,  title = 'Color',       group = 'Viiva 1')
w1     = input.int(2,             title = 'Extended width',    group = 'Viiva 1', minval = 1, maxval = 4)

// Viiva 2
show_2 = input.bool(true,         title = 'Line 2 extended',  group = 'Viiva 2')
c2     = input.color(color.green, title = 'Color',       group = 'Viiva 2')
w2     = input.int(2,             title = 'Extended width',    group = 'Viiva 2', minval = 1, maxval = 4)

// Viiva 3
show_3 = input.bool(true,         title = 'Line 3 extended',  group = 'Viiva 3')
c3     = input.color(color.red,   title = 'Color',       group = 'Viiva 3')
w3     = input.int(2,             title = 'Extended width',    group = 'Viiva 3', minval = 1, maxval = 4)

// Viiva 4
show_4 = input.bool(true,           title = 'Line 4 extended', group = 'Viiva 4')
c4     = input.color(color.orange,  title = 'Color',      group = 'Viiva 4')
w4     = input.int(2,               title = 'Extended width',   group = 'Viiva 4', minval = 1, maxval = 4)

// Viiva 5
show_5 = input.bool(true,           title = 'Line 5 extended', group = 'Viiva 5')
c5     = input.color(color.purple,  title = 'Color',      group = 'Viiva 5')
w5     = input.int(2,               title = 'Extended width',   group = 'Viiva 5', minval = 1, maxval = 4)

// Function to calculate ZLSMA
zlsma_func(src, length, offset) =>
    lsma = ta.linreg(src, length, offset)
    lsma2 = ta.linreg(lsma, length, offset)
    eq = lsma - lsma2
    lsma + eq

// gaps_on: arvo vain kun HTF päivittyy -> katkoviivojen lähtöpiste
zlsma_1 = request.security(syminfo.tickerid, tf_1, zlsma_func(src, length, offset), barmerge.gaps_on)
zlsma_2 = request.security(syminfo.tickerid, tf_2, zlsma_func(src, length, offset), barmerge.gaps_on)
zlsma_3 = request.security(syminfo.tickerid, tf_3, zlsma_func(src, length, offset), barmerge.gaps_on)
zlsma_4 = request.security(syminfo.tickerid, tf_4, zlsma_func(src, length, offset), barmerge.gaps_on)
zlsma_5 = request.security(syminfo.tickerid, tf_5, zlsma_func(src, length, offset), barmerge.gaps_on)

// gaps_off: jatkuva arvo -> plot()-viivoihin, taulukkoon ja katkoviivan loppupisteeseen
Xzlsma_1 = request.security(syminfo.tickerid, tf_1, zlsma_func(src, length, offset), barmerge.gaps_off)
Xzlsma_2 = request.security(syminfo.tickerid, tf_2, zlsma_func(src, length, offset), barmerge.gaps_off)
Xzlsma_3 = request.security(syminfo.tickerid, tf_3, zlsma_func(src, length, offset), barmerge.gaps_off)
Xzlsma_4 = request.security(syminfo.tickerid, tf_4, zlsma_func(src, length, offset), barmerge.gaps_off)
Xzlsma_5 = request.security(syminfo.tickerid, tf_5, zlsma_func(src, length, offset), barmerge.gaps_off)

// Determine UP or DOWN for each ZLSMA
status_1 = close > Xzlsma_1 ? 'UP' : 'DOWN'
status_2 = close > Xzlsma_2 ? 'UP' : 'DOWN'
status_3 = close > Xzlsma_3 ? 'UP' : 'DOWN'
status_4 = close > Xzlsma_4 ? 'UP' : 'DOWN'
status_5 = close > Xzlsma_5 ? 'UP' : 'DOWN'

// Set colors for statuses
status_color_1 = close > Xzlsma_1 ? color.green : color.red
status_color_2 = close > Xzlsma_2 ? color.green : color.red
status_color_3 = close > Xzlsma_3 ? color.green : color.red
status_color_4 = close > Xzlsma_4 ? color.green : color.red
status_color_5 = close > Xzlsma_5 ? color.green : color.red

// Plot ZLSMA lines
plot(show_1 ? zlsma_1 : na, color = c1, linewidth = w1, title = 'Line 1')
plot(show_2 ? zlsma_2 : na, color = c2, linewidth = w2, title = 'Line 2')
plot(show_3 ? zlsma_3 : na, color = c3, linewidth = w3, title = 'Line 3')
plot(show_4 ? zlsma_4 : na, color = c4, linewidth = w4, title = 'Line 4')
plot(show_5 ? zlsma_5 : na, color = c5, linewidth = w5, title = 'Line 5')

// ---------- Katkoviiva: lähtee HTF-päivityspisteestä, seuraa ZLSMA:a nykyhetkeen ----------
var int   htf_x1 = na
var float htf_y1 = na
var int   htf_x2 = na
var float htf_y2 = na
var int   htf_x3 = na
var float htf_y3 = na
var int   htf_x4 = na
var float htf_y4 = na
var int   htf_x5 = na
var float htf_y5 = na

var line dash1 = na
var line dash2 = na
var line dash3 = na
var line dash4 = na
var line dash5 = na

// Tallenna viimeisin HTF-päivityspiste
if not na(zlsma_1)
    htf_x1 := bar_index
    htf_y1 := zlsma_1

if not na(zlsma_2)
    htf_x2 := bar_index
    htf_y2 := zlsma_2

if not na(zlsma_3)
    htf_x3 := bar_index
    htf_y3 := zlsma_3

if not na(zlsma_4)
    htf_x4 := bar_index
    htf_y4 := zlsma_4

if not na(zlsma_5)
    htf_x5 := bar_index
    htf_y5 := zlsma_5

// Piirrä katkoviiva HTF-päivityspisteestä nykyiseen ZLSMA-arvoon
if show_1 and not na(htf_x1) and not na(Xzlsma_1)
    line.delete(dash1)
    dash1 := line.new(htf_x1, htf_y1, bar_index, Xzlsma_1, xloc=xloc.bar_index, extend=extend.none, color=c1, style=line.style_dashed, width=w1)
else if not show_1
    line.delete(dash1)

if show_2 and not na(htf_x2) and not na(Xzlsma_2)
    line.delete(dash2)
    dash2 := line.new(htf_x2, htf_y2, bar_index, Xzlsma_2, xloc=xloc.bar_index, extend=extend.none, color=c2, style=line.style_dashed, width=w2)
else if not show_2
    line.delete(dash2)

if show_3 and not na(htf_x3) and not na(Xzlsma_3)
    line.delete(dash3)
    dash3 := line.new(htf_x3, htf_y3, bar_index, Xzlsma_3, xloc=xloc.bar_index, extend=extend.none, color=c3, style=line.style_dashed, width=w3)
else if not show_3
    line.delete(dash3)

if show_4 and not na(htf_x4) and not na(Xzlsma_4)
    line.delete(dash4)
    dash4 := line.new(htf_x4, htf_y4, bar_index, Xzlsma_4, xloc=xloc.bar_index, extend=extend.none, color=c4, style=line.style_dashed, width=w4)
else if not show_4
    line.delete(dash4)

if show_5 and not na(htf_x5) and not na(Xzlsma_5)
    line.delete(dash5)
    dash5 := line.new(htf_x5, htf_y5, bar_index, Xzlsma_5, xloc=xloc.bar_index, extend=extend.none, color=c5, style=line.style_dashed, width=w5)
else if not show_5
    line.delete(dash5)

// ---------- Taulukko ----------
var testTable = table.new(position = position.top_right, columns = 2, rows = 7)
if barstate.islast
    table.cell(table_id = testTable, column = 0, row = 0, text = '')
    table.cell(table_id = testTable, column = 1, row = 0, text = '')
    table.cell(table_id = testTable, column = 0, row = 1, text = 'ZeroLag', text_color = color.blue)
    table.cell(table_id = testTable, column = 1, row = 1, text = 'Direction', text_color = color.blue)
    table.cell(table_id = testTable, column = 0, row = 2, text = tf_1 + ' min', text_color = c1)
    table.cell(table_id = testTable, column = 1, row = 2, text = status_1, bgcolor = status_color_1)
    table.cell(table_id = testTable, column = 0, row = 3, text = tf_2 + ' min', text_color = c2)
    table.cell(table_id = testTable, column = 1, row = 3, text = status_2, bgcolor = status_color_2)
    table.cell(table_id = testTable, column = 0, row = 4, text = tf_3 + ' min', text_color = c3)
    table.cell(table_id = testTable, column = 1, row = 4, text = status_3, bgcolor = status_color_3)
    table.cell(table_id = testTable, column = 0, row = 5, text = tf_4 + ' min', text_color = c4)
    table.cell(table_id = testTable, column = 1, row = 5, text = status_4, bgcolor = status_color_4)
    table.cell(table_id = testTable, column = 0, row = 6, text = tf_5 + ' min', text_color = c5)
    table.cell(table_id = testTable, column = 1, row = 6, text = status_5, bgcolor = status_color_5)
