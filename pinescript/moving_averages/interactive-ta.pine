//@version=6
indicator('Interactive TA', overlay=false)

// ============================= INPUTS ==================================
Length      = input.int  (50,           'MA Length',      minval=1)
col_ma      = input.color(color.blue,   'MA Color'        )
col_select  = input.color(color.orange, 'Selector Color'  )

// Price input drives the on-chart slider; hidden in settings via empty label and separate group
Input_Sel   = input.price(250,          '', group='Auto-Generated By PineScript')

// ======================== MA NAMES =====================================
// Customize available MA types by editing this array
var ma_names = array.from('SMA', 'EMA', 'VWMA', 'HMA', 'DEMA')

// ====================== SELECTOR CALCULATION ===========================
// 5 MAs × 100-unit zones = 500 range, clamped to 0-499
Selector     = int(math.max(0, math.min(499, Input_Sel)))

var string MA_Type = 'SMA'
var int Zone       = 0

// Determine active zone and MA type once on first bar
if barstate.isfirst 
    Zone     := int(math.min(math.floor(Selector / 100), 4))
    MA_Type  := array.get(ma_names, Zone)

// ====================== MA CALCULATIONS ================================
SMA_val      = ta.sma   (close, Length)
EMA_val      = ta.ema   (close, Length)
VWMA_val     = ta.vwma  (close, Length)
HMA_val      = ta.hma   (close, Length)
DEMA_val     = 2 * ta.ema(close, Length) - ta.ema(ta.ema(close, Length), Length)

MA = switch MA_Type
    'SMA'  => SMA_val
    'EMA'  => EMA_val
    'VWMA' => VWMA_val
    'HMA'  => HMA_val
    'DEMA' => DEMA_val
    => SMA_val

// ========================= CHART OVERLAY ===============================
// force_overlay draws these on the price chart from a non-overlay indicator
plot(MA, "MA", color=col_ma, linewidth=5, force_overlay=true)

var table InfoTable = table.new(position.top_right, 1, 1, force_overlay=true)
if barstate.isfirst
    table.cell(InfoTable, 0, 0, text=MA_Type+' ('+ str.tostring(Length) + ')' , text_color=col_select, text_size=size.large)

// ========================= SELECTOR PANE ===============================
plot    (Selector, "Selector",  color=col_select, linewidth=5, show_last=50)
plotchar(Selector, "Pointer",   color=col_select, char='►',
         location=location.absolute, size=size.small, show_last=1, offset=1)

upper_bound     = (Zone + 1) * 100
lower_bound     = Zone * 100

if barstate.islast
    for b in box.all
        box.delete(b)
    for l in line.all
        line.delete(l)

    int x = bar_index + 20  // Label offset from chart data (adjustable)

    for [i, name] in ma_names
        color col_t = Zone == i ? col_select : color.gray
        box.new(x, i * 100, x, (i + 1) * 100, xloc=xloc.bar_index, border_width=0,
             border_color=color(na), bgcolor=color(na), text=name,
             text_color=col_t, text_size=size.normal, text_halign=text.align_left, text_valign=text.align_center)
    
    // Active zone bracket lines (line length adjustable)
    line.new(x, upper_bound, x + 100, upper_bound, color=col_select, width=1)
    line.new(x, lower_bound, x + 100, lower_bound, color=col_select, width=1)
