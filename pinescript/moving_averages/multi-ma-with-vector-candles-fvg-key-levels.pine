get_timeframe_minutes() =>
    if timeframe.isseconds
        1
    else if timeframe.isminutes
        timeframe.multiplier
    else if timeframe.isdaily
        timeframe.multiplier * 1440
    else if timeframe.isweekly
        timeframe.multiplier * 10080
    else if timeframe.ismonthly
        timeframe.multiplier * 43200
    else
        timeframe.multiplier

should_show_granular_market_opens() => get_timeframe_minutes() <= 15
should_show_standard_market_opens() => get_timeframe_minutes() <= 60
should_show_session_details() => get_timeframe_minutes() <= 240
should_show_vertical_lines() => get_timeframe_minutes() <= 240
should_show_intraday_details() => get_timeframe_minutes() < 1440

