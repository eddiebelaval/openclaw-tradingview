//@version=6
indicator(title="Ultimate Trade Engine", shorttitle="AJ's Trade Engine", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ==========================================
// TEIL 1: FTB VEKTORKERZEN
// ==========================================
var grp_c = "1. FTB Vektorkerzen"
useCol = input.bool(true, "Farben an", group=grp_c)
b200 = input.color(color.lime, "200% Bull", group=grp_c)
b150 = input.color(color.blue, "150% Bull", group=grp_c)
bNorm = input.color(color.white, "Norm Bull", group=grp_c)
s200 = input.color(color.red, "200% Bear", group=grp_c)
s150 = input.color(color.fuchsia, "150% Bear", group=grp_c)
sNorm = input.color(color.gray, "Norm Bear", group=grp_c)

avgV = ta.sma(volume[1], 10)
hlW  = volume * (high - low)
hi10 = ta.highest(hlW[1], 10)
va   = volume >= avgV * 2 or hlW >= hi10 ? 200 : volume >= avgV * 1.5 ? 150 : 0
isB  = close > open
c_final = isB ? (va == 200 ? b200 : va == 150 ? b150 : bNorm) : (va == 200 ? s200 : va == 150 ? s150 : sNorm)
barcolor(useCol ? c_final : na)

// ==========================================
// TEIL 2: FTB MAs (ALLE EMA, ABSTAND +3)
// ==========================================
var grp_m = "2. FTB MAs"
get_ma(src, len, type) =>
    float res = 0.0
    if type == "SMA"
        res := ta.sma(src, len)
    else if type == "EMA"
        res := ta.ema(src, len)
    else if type == "TEMA"
        e1 = ta.ema(src, len), e2 = ta.ema(e1, len), e3 = ta.ema(e2, len)
        res := 3 * e1 - 3 * e2 + e3
    res

s1=input.bool(true,"MA 1",inline="1",group=grp_m), t1=input.string("EMA","",["EMA","SMA","TEMA"],inline="1",group=grp_m), l1=input.int(21,"L",inline="1",group=grp_m), c1=input.color(color.blue,"",inline="1",group=grp_m), tx1=input.string("21 Ema","Txt",inline="1",group=grp_m)
s2=input.bool(true,"MA 2",inline="2",group=grp_m), t2=input.string("EMA","",["EMA","SMA","TEMA"],inline="2",group=grp_m), l2=input.int(50,"L",inline="2",group=grp_m), c2=input.color(color.orange,"",inline="2",group=grp_m), tx2=input.string("50 Ema","Txt",inline="2",group=grp_m)
s3=input.bool(true,"MA 3",inline="3",group=grp_m), t3=input.string("EMA","",["EMA","SMA","TEMA"],inline="3",group=grp_m), l3=input.int(200,"L",inline="3",group=grp_m), c3=input.color(color.purple,"",inline="3",group=grp_m), tx3=input.string("200 Ema","Txt",inline="3",group=grp_m)
s4=input.bool(true,"MA 4",inline="4",group=grp_m), t4=input.string("EMA","",["EMA","SMA","TEMA"],inline="4",group=grp_m), l4=input.int(800,"L",inline="4",group=grp_m), c4=input.color(color.gray,"",inline="4",group=grp_m), tx4=input.string("800 Ema","Txt",inline="4",group=grp_m)

v1=get_ma(close,l1,t1), v2=get_ma(close,l2,t2), v3=get_ma(close,l3,t3), v4=get_ma(close,l4,t4)

plot(s1?v1:na, color=c1, linewidth=2, title="MA 1", force_overlay=true)
plot(s2?v2:na, color=c2, linewidth=2, title="MA 2", force_overlay=true)
plot(s3?v3:na, color=c3, linewidth=2, title="MA 3", force_overlay=true)
plot(s4?v4:na, color=c4, linewidth=2, title="MA 4", force_overlay=true)

var label lb1 = na, var label lb2 = na, var label lb3 = na, var label lb4 = na
if barstate.islast
    label.delete(lb1), label.delete(lb2), label.delete(lb3), label.delete(lb4)
    if s1 and not na(v1)
        lb1 := label.new(bar_index + 3, v1, tx1, style=label.style_none, textcolor=c1, textalign=text.align_left, force_overlay=true)
    if s2 and not na(v2)
        lb2 := label.new(bar_index + 3, v2, tx2, style=label.style_none, textcolor=c2, textalign=text.align_left, force_overlay=true)
    if s3 and not na(v3)
        lb3 := label.new(bar_index + 3, v3, tx3, style=label.style_none, textcolor=c3, textalign=text.align_left, force_overlay=true)
    if s4 and not na(v4)
        lb4 := label.new(bar_index + 3, v4, tx4, style=label.style_none, textcolor=c4, textalign=text.align_left, force_overlay=true)


