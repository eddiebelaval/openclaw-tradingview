// Odegos State Variables
var float asiaHigh=na, var float asiaLow=na, var int asiaHighTime=na, var int asiaLowTime=na, var bool asiaHighBroken=false, var bool asiaLowBroken=false, var int asiaHighBreakTime=na, var int asiaLowBreakTime=na
var float londonHigh=na, var float londonLow=na, var int londonHighTime=na, var int londonLowTime=na, var bool londonHighBroken=false, var bool londonLowBroken=false, var int londonHighBreakTime=na, var int londonLowBreakTime=na
var float newYorkHigh=na, var float newYorkLow=na, var int newYorkHighTime=na, var int newYorkLowTime=na, var bool newYorkHighBroken=false, var bool newYorkLowBroken=false, var int newYorkHighBreakTime=na, var int newYorkLowBreakTime=na
var float weeklyHigh=na, var float weeklyLow=na, var int weeklyHighTime=na, var int weeklyLowTime=na, var bool weeklyHighBroken=false, var bool weeklyLowBroken=false, var int weeklyHighBreakTime=na, var int weeklyLowBreakTime=na
var float monthlyHigh=na, var float monthlyLow=na, var int monthlyHighTime=na, var int monthlyLowTime=na, var bool monthlyHighBroken=false, var bool monthlyLowBroken=false, var int monthlyHighBreakTime=na, var int monthlyLowBreakTime=na
var float prevDayHigh=na, var float prevDayLow=na, var float prevDayClose=na, var int prevDayHighTime=na, var int prevDayLowTime=na, var bool prevDayHighBroken=false, var bool prevDayLowBroken=false, var int prevDayHighBreakTime=na, var int prevDayLowBreakTime=na, var int prevDayMarketOpenTime=na
var float currentDayHigh=na, var float currentDayLow=na, var int currentDayHighTime=na, var int currentDayLowTime=na
var float marketLevel0000Price=na, var int marketLevel0000Time=na

if newAsiaSession
    asiaHigh:=na, asiaLow:=na, asiaHighBroken:=false, asiaLowBroken:=false
if newLondonSession
    londonHigh:=na, londonLow:=na, londonHighBroken:=false, londonLowBroken:=false
if newNewYorkSession
    newYorkHigh:=na, newYorkLow:=na, newYorkHighBroken:=false, newYorkLowBroken:=false
if newWeek
    weeklyHigh:=na, weeklyLow:=na, weeklyHighBroken:=false, weeklyLowBroken:=false
if newMonth
    monthlyHigh:=na, monthlyLow:=na, monthlyHighBroken:=false, monthlyLowBroken:=false
if newDay
    if not na(currentDayHigh)
        prevDayHigh:=currentDayHigh, prevDayLow:=currentDayLow, prevDayHighBroken:=false, prevDayLowBroken:=false
    currentDayHigh:=high, currentDayLow:=low, currentDayHighTime:=time, currentDayLowTime:=time
if newMarketLevel0000
    marketLevel0000Price := open, marketLevel0000Time := time

if inAsia
    if na(asiaHigh) or high>asiaHigh
        asiaHigh:=high, asiaHighTime:=time
    if na(asiaLow) or low<asiaLow
        asiaLow:=low, asiaLowTime:=time
if inLondon
    if na(londonHigh) or high>londonHigh
        londonHigh:=high, londonHighTime:=time
    if na(londonLow) or low<londonLow
        londonLow:=low, londonLowTime:=time
if inNewYork
    if na(newYorkHigh) or high>newYorkHigh
        newYorkHigh:=high, newYorkHighTime:=time
    if na(newYorkLow) or low<newYorkLow
        newYorkLow:=low, newYorkLowTime:=time
if na(weeklyHigh) or high>weeklyHigh
    weeklyHigh:=high, weeklyHighTime:=time
if na(weeklyLow) or low<weeklyLow
    weeklyLow:=low, weeklyLowTime:=time
if na(monthlyHigh) or high>monthlyHigh
    monthlyHigh:=high, monthlyHighTime:=time
if na(monthlyLow) or low<monthlyLow
    monthlyLow:=low, monthlyLowTime:=time
if na(currentDayHigh) or high>currentDayHigh
    currentDayHigh:=high, currentDayHighTime:=time
if na(currentDayLow) or low<currentDayLow
    currentDayLow:=low, currentDayLowTime:=time

// Breaks
if not extendAllLines
    if not inAsia and not na(asiaHigh) and not asiaHighBroken and high > asiaHigh
        asiaHighBroken := true, asiaHighBreakTime := time
    if not inAsia and not na(asiaLow) and not asiaLowBroken and low < asiaLow
        asiaLowBroken := true, asiaLowBreakTime := time
    if not inLondon and not na(londonHigh) and not londonHighBroken and high > londonHigh
        londonHighBroken := true, londonHighBreakTime := time
    if not inLondon and not na(londonLow) and not londonLowBroken and low < londonLow
        londonLowBroken := true, londonLowBreakTime := time
    if not inNewYork and not na(newYorkHigh) and not newYorkHighBroken and high > newYorkHigh
        newYorkHighBroken := true, newYorkHighBreakTime := time
    if not inNewYork and not na(newYorkLow) and not newYorkLowBroken and low < newYorkLow
        newYorkLowBroken := true, newYorkLowBreakTime := time
    if not na(weeklyHigh) and not weeklyHighBroken and high > weeklyHigh
        weeklyHighBroken:=true, weeklyHighBreakTime:=time
    if not na(weeklyLow) and not weeklyLowBroken and low < weeklyLow
        weeklyLowBroken:=true, weeklyLowBreakTime:=time
    if not na(monthlyHigh) and not monthlyHighBroken and high > monthlyHigh
        monthlyHighBroken:=true, monthlyHighBreakTime:=time
    if not na(monthlyLow) and not monthlyLowBroken and low < monthlyLow
        monthlyLowBroken:=true, monthlyLowBreakTime:=time
    if not na(prevDayHigh) and not prevDayHighBroken and high > prevDayHigh
        prevDayHighBroken:=true, prevDayHighBreakTime:=time
    if not na(prevDayLow) and not prevDayLowBroken and low < prevDayLow
        prevDayLowBroken:=true, prevDayLowBreakTime:=time

// Drawing Odegos
var array<line> allLines = array.new<line>()
var array<label> allLabels = array.new<label>()

if barstate.isrealtime or barstate.islast or newAsiaSession or newLondonSession or newNewYorkSession or newDay
    while array.size(allLines) > 0
        line.delete(array.pop(allLines))
    while array.size(allLabels) > 0
        label.delete(array.pop(allLabels))

    var array<LevelData> allLevels = array.new<LevelData>()
    array.clear(allLevels)

    if asiaHighShow and not na(asiaHigh)
        array.push(allLevels, LevelData.new(asiaHigh, asiaHighTime, get_line_end_time(asiaHighTime, asiaHighBroken, asiaHighBreakTime, extendAllLines), asiaHighColor, asiaHighStyle, asiaHighWidth, asiaHighText, asiaHighBroken, false, extendAllLines, false, true))
    if asiaLowShow and not na(asiaLow)
        array.push(allLevels, LevelData.new(asiaLow, asiaLowTime, get_line_end_time(asiaLowTime, asiaLowBroken, asiaLowBreakTime, extendAllLines), asiaLowColor, asiaLowStyle, asiaLowWidth, asiaLowText, asiaLowBroken, false, extendAllLines, false, false))
    if londonHighShow and not na(londonHigh)
        array.push(allLevels, LevelData.new(londonHigh, londonHighTime, get_line_end_time(londonHighTime, londonHighBroken, londonHighBreakTime, extendAllLines), londonHighColor, londonHighStyle, londonHighWidth, londonHighText, londonHighBroken, false, extendAllLines, false, true))
    if londonLowShow and not na(londonLow)
        array.push(allLevels, LevelData.new(londonLow, londonLowTime, get_line_end_time(londonLowTime, londonLowBroken, londonLowBreakTime, extendAllLines), londonLowColor, londonLowStyle, londonLowWidth, londonLowText, londonLowBroken, false, extendAllLines, false, false))
    if newYorkHighShow and not na(newYorkHigh)
        array.push(allLevels, LevelData.new(newYorkHigh, newYorkHighTime, get_line_end_time(newYorkHighTime, newYorkHighBroken, newYorkHighBreakTime, extendAllLines), newYorkHighColor, newYorkHighStyle, newYorkHighWidth, newYorkHighText, newYorkHighBroken, false, extendAllLines, false, true))
    if newYorkLowShow and not na(newYorkLow)
        array.push(allLevels, LevelData.new(newYorkLow, newYorkLowTime, get_line_end_time(newYorkLowTime, newYorkLowBroken, newYorkLowBreakTime, extendAllLines), newYorkLowColor, newYorkLowStyle, newYorkLowWidth, newYorkLowText, newYorkLowBroken, false, extendAllLines, false, false))
    
    // Previous Day
    if prevDayHighShow and not na(prevDayHigh)
        array.push(allLevels, LevelData.new(prevDayHigh, prevDayHighTime, get_line_end_time(prevDayHighTime, prevDayHighBroken, prevDayHighBreakTime, extendAllLines), prevDayHighColor, prevDayHighStyle, prevDayHighWidth, prevDayHighText, prevDayHighBroken, false, extendAllLines, false, true))
    if prevDayLowShow and not na(prevDayLow)
        array.push(allLevels, LevelData.new(prevDayLow, prevDayLowTime, get_line_end_time(prevDayLowTime, prevDayLowBroken, prevDayLowBreakTime, extendAllLines), prevDayLowColor, prevDayLowStyle, prevDayLowWidth, prevDayLowText, prevDayLowBroken, false, extendAllLines, false, false))
    
    // 50% Mid Level Logic (Use int(na) to avoid error)
    if rangeLevelsShowDaily50 and not na(prevDayHigh) and not na(prevDayLow)
        daily50 = (prevDayHigh + prevDayLow) / 2
        array.push(allLevels, LevelData.new(daily50, prevDayHighTime, get_line_end_time(prevDayHighTime, false, int(na), extendAllLines), color.gray, "dotted", "thin", "Daily 50%", false, false, extendAllLines, false, false))

    // Weekly
    if weeklyHighShow and not na(weeklyHigh)
        array.push(allLevels, LevelData.new(weeklyHigh, weeklyHighTime, get_line_end_time(weeklyHighTime, weeklyHighBroken, weeklyHighBreakTime, extendAllLines), weeklyHighColor, weeklyHighStyle, weeklyHighWidth, weeklyHighText, weeklyHighBroken, false, extendAllLines, false, true))
    if weeklyLowShow and not na(weeklyLow)
        array.push(allLevels, LevelData.new(weeklyLow, weeklyLowTime, get_line_end_time(weeklyLowTime, weeklyLowBroken, weeklyLowBreakTime, extendAllLines), weeklyLowColor, weeklyLowStyle, weeklyLowWidth, weeklyLowText, weeklyLowBroken, false, extendAllLines, false, false))
    if rangeLevelsShowWeekly50 and not na(weeklyHigh) and not na(weeklyLow)
        week50 = (weeklyHigh + weeklyLow) / 2
        array.push(allLevels, LevelData.new(week50, weeklyHighTime, get_line_end_time(weeklyHighTime, false, int(na), extendAllLines), color.gray, "dotted", "thin", "Weekly 50%", false, false, extendAllLines, false, false))

    // Monthly
    if monthlyHighShow and not na(monthlyHigh)
        array.push(allLevels, LevelData.new(monthlyHigh, monthlyHighTime, get_line_end_time(monthlyHighTime, monthlyHighBroken, monthlyHighBreakTime, extendAllLines), monthlyHighColor, monthlyHighStyle, monthlyHighWidth, monthlyHighText, monthlyHighBroken, false, extendAllLines, false, true))
    if monthlyLowShow and not na(monthlyLow)
        array.push(allLevels, LevelData.new(monthlyLow, monthlyLowTime, get_line_end_time(monthlyLowTime, monthlyLowBroken, monthlyLowBreakTime, extendAllLines), monthlyLowColor, monthlyLowStyle, monthlyLowWidth, monthlyLowText, monthlyLowBroken, false, extendAllLines, false, false))
    if rangeLevelsShowMonthly50 and not na(monthlyHigh) and not na(monthlyLow)
        month50 = (monthlyHigh + monthlyLow) / 2
        array.push(allLevels, LevelData.new(month50, monthlyHighTime, get_line_end_time(monthlyHighTime, false, int(na), extendAllLines), color.gray, "dotted", "thin", "Monthly 50%", false, false, extendAllLines, false, false))

    // ATH
    if allTimeHighShow and not na(allTimeHigh)
        array.push(allLevels, LevelData.new(allTimeHigh, allTimeHighTime, time, allTimeHighColor, allTimeHighStyle, allTimeHighWidth, allTimeHighText, false, false, extendAllLines, false, true))

    // Market Opens
    if marketLevelsShow0000 and not na(marketLevel0000Price)
        array.push(allLevels, LevelData.new(marketLevel0000Price, marketLevel0000Time, time, marketLevelsColor, marketLevelsStyle, marketLevelsWidth, "00:00 Open", false, false, extendAllLines, true, false))
    if marketLevelsShowDailyOpen and not na(prevDayCloseValue)
        array.push(allLevels, LevelData.new(open, time("D"), time, marketLevelsColor, marketLevelsStyle, marketLevelsWidth, "Daily Open", false, false, extendAllLines, true, false))
    if marketLevelsShowWeeklyOpen and not na(open)
        array.push(allLevels, LevelData.new(open, time("W"), time, marketLevelsColor, marketLevelsStyle, marketLevelsWidth, "Weekly Open", false, false, extendAllLines, true, false))
    if marketLevelsShowMonthlyOpen and not na(open)
        array.push(allLevels, LevelData.new(open, time("M"), time, marketLevelsColor, marketLevelsStyle, marketLevelsWidth, "Monthly Open", false, false, extendAllLines, true, false))

    combinedLevels = combine_levels_at_same_price(allLevels)
    if array.size(combinedLevels) > 0
        for i = 0 to array.size(combinedLevels) - 1
            level = array.get(combinedLevels, i)
            levelLine = create_market_level_line(level.startTime, level.endTime, level.price, level.levelColor, level.levelStyle, level.levelWidth, level.shouldExtend)
            array.push(allLines, levelLine)
            levelLabel = create_combined_label(level.price, level.labelText, level.levelColor, level.startTime, level.endTime, level.isBroken, level.isSessionOpen, level.isMarketLevel, level.isHighLevel)
            if not na(levelLabel)
                array.push(allLabels, levelLabel)

finalDOWColor = useGlobalTextColor ? color.new(globalColor, 50) : color.new(color.gray, 50)
showDOWLabels = showDaysOfWeek and (not autoSimplifyOnHTF or should_show_intraday_details())
plotshape(showDOWLabels ? hour(time, timezoneToUse) == 9 and minute(time, timezoneToUse) == 0 and dayofweek == dayofweek.monday : false, text='Monday', style=shape.circle, color=na, textcolor=finalDOWColor, location=location.bottom, size=size.tiny, force_overlay=true)
plotshape(showDOWLabels ? hour(time, timezoneToUse) == 9 and minute(time, timezoneToUse) == 0 and dayofweek == dayofweek.tuesday : false, text='Tuesday', style=shape.circle, color=na, textcolor=finalDOWColor, location=location.bottom, size=size.tiny, force_overlay=true)
plotshape(showDOWLabels ? hour(time, timezoneToUse) == 9 and minute(time, timezoneToUse) == 0 and dayofweek == dayofweek.wednesday : false, text='Wednesday', style=shape.circle, color=na, textcolor=finalDOWColor, location=location.bottom, size=size.tiny, force_overlay=true)
plotshape(showDOWLabels ? hour(time, timezoneToUse) == 9 and minute(time, timezoneToUse) == 0 and dayofweek == dayofweek.thursday : false, text='Thursday', style=shape.circle, color=na, textcolor=finalDOWColor, location=location.bottom, size=size.tiny, force_overlay=true)
plotshape(showDOWLabels ? hour(time, timezoneToUse) == 9 and minute(time, timezoneToUse) == 0 and dayofweek == dayofweek.friday : false, text='Friday', style=shape.circle, color=na, textcolor=finalDOWColor, location=location.bottom, size=size.tiny, force_overlay=true)

// FIX: VERTIKALE LINIEN SICHTBARER GEMACHT (50 TRANSPARENZ)
if showVerticalDayLines and newDay
    line.new(time, close, time, close + 1, xloc=xloc.bar_time, extend=extend.both, color=color.new(color.gray, 50), style=line.style_dashed, width=1, force_overlay=true)


// ==========================================
// TEIL 3: FAIR VALUE GAPS (FVG)
// ==========================================
var grp_fvg = "7. Fair Value Gaps"
show_fvg      = input.bool(true, "Show FVGs", group=grp_fvg)
fvg_bull_col  = input.color(color.new(color.green, 70), "Bullish FVG", group=grp_fvg)
fvg_bear_col  = input.color(color.new(color.red, 70), "Bearish FVG", group=grp_fvg)
remove_filled = input.bool(true, "Remove filled FVGs", group=grp_fvg)
fvg_extend    = input.int(1, "Extend Boxes (Bars)", group=grp_fvg, minval=0)

type FVG
    box id
    float top
    float bottom
    bool is_bull

var array<FVG> fvg_array = array.new<FVG>()

bull_fvg_cond = low > high[2] and close[1] > high[2] 
bear_fvg_cond = high < low[2] and close[1] < low[2]

if show_fvg
    if bull_fvg_cond
        new_box = box.new(bar_index[2], high[2], bar_index + fvg_extend, low, bgcolor=fvg_bull_col, border_color=na, force_overlay=true)
        array.push(fvg_array, FVG.new(new_box, low, high[2], true))
    if bear_fvg_cond
        new_box = box.new(bar_index[2], low[2], bar_index + fvg_extend, high, bgcolor=fvg_bear_col, border_color=na, force_overlay=true)
        array.push(fvg_array, FVG.new(new_box, high, low[2], false))

if remove_filled and array.size(fvg_array) > 0
    for i = array.size(fvg_array) - 1 to 0
        fvg_item = array.get(fvg_array, i)
        bool filled = false
        if fvg_item.is_bull
            if low < fvg_item.bottom
                filled := true
        else
            if high > fvg_item.top
                filled := true
        if filled
            box.delete(fvg_item.id)
            array.remove(fvg_array, i)

// ==========================================
// TEIL 4: GOLD ORDER BLOCKS (ProjectSyndicate)
// ==========================================
var grp_ob = "8. Gold Order Blocks"
ps_swing_length = input.int(7, "Swing Length", minval=3, maxval=20, group=grp_ob)
ps_lookback = input.int(20, "OB Lookback", minval=5, maxval=50, group=grp_ob)
displacement_mult = input.float(1.3, "Displacement Mult", minval=0.5, step=0.1, group=grp_ob)
max_obs = input.int(5, "Max Active OBs", minval=1, maxval=10, group=grp_ob)
show_bullish = input.bool(true, "Show Bullish", inline="bull", group=grp_ob)
bull_color = input.color(color.new(color.green, 85), "", inline="bull", group=grp_ob)
bull_border = input.color(color.new(color.green, 30), "Border", inline="bull", group=grp_ob)
show_bearish = input.bool(true, "Show Bearish", inline="bear", group=grp_ob)
bear_color = input.color(color.new(color.red, 85), "", inline="bear", group=grp_ob)
bear_border = input.color(color.new(color.red, 30), "Border", inline="bear", group=grp_ob)
show_labels = input.bool(true, "Show Labels", group=grp_ob)
ob_show_info = input.bool(false, "Show Age Info", group=grp_ob)
info_text_size = input.string("Normal", "Info Text Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=grp_ob)

type OB
    box b
    label l
    label info_label
    float top
    float bot
    int bar_idx
    bool bullish
    string session
    int creation_time

var array<OB> bull_obs = array.new<OB>()
var array<OB> bear_obs = array.new<OB>()

get_ob_session_name(bar_time) =>
    hour_utc = hour(bar_time, "GMT")
    minute_utc = minute(bar_time, "GMT")
    time_in_minutes = hour_utc * 60 + minute_utc
    session_name = "Other"
    if time_in_minutes >= 480 and time_in_minutes < 1020
        session_name := "London"
    else if time_in_minutes >= 780 and time_in_minutes < 1320
        session_name := "NY"
    else if time_in_minutes >= 0 and time_in_minutes < 540
        session_name := "Asian"
    session_name

get_text_size_ob() =>
    switch info_text_size
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.normal

is_mitigated_ob(ob) =>
    result = false
    if barstate.isconfirmed
        result := ob.bullish ? close < ob.bot : close > ob.top
    result

clean_obs(obs_array) =>
    if array.size(obs_array) > 0
        for i = array.size(obs_array) - 1 to 0
            ob = array.get(obs_array, i)
            if is_mitigated_ob(ob)
                box.delete(ob.b)
                if not na(ob.l)
                    label.delete(ob.l)
                if not na(ob.info_label)
                    label.delete(ob.info_label)
                array.remove(obs_array, i)

limit_size(obs_array, max_size) =>
    while array.size(obs_array) > max_size
        old = array.shift(obs_array)
        box.delete(old.b)
        if not na(old.l)
            label.delete(old.l)
        if not na(old.info_label)
            label.delete(old.info_label)

update_boxes(obs_array) =>
    if array.size(obs_array) > 0
        for i = 0 to array.size(obs_array) - 1
            ob = array.get(obs_array, i)
            box.set_right(ob.b, bar_index + 20)
            if ob_show_info and not na(ob.info_label)
                age = bar_index - ob.creation_time
                info_text = ob.session + " Session\nAge: " + str.tostring(age) + " bars"
                label.set_text(ob.info_label, info_text)
                mid_price = (ob.top + ob.bot) / 2
                label.set_xy(ob.info_label, bar_index + 10, mid_price)

// Execution for OBs
swing_high = ta.pivothigh(high, ps_swing_length, ps_swing_length)
swing_low = ta.pivotlow(low, ps_swing_length, ps_swing_length)

if barstate.isconfirmed
    // Bullish OB
    if not na(swing_low) and show_bullish
        bool found = false
        float ob_top = na
        float ob_bot = na
        int ob_bar = na
        int ob_time_offset = na
        
        for i = ps_swing_length + 1 to ps_swing_length + ps_lookback
            if not found
                hist_close = close[i]
                hist_open = open[i]
                hist_high = high[i]
                hist_low = low[i]
                if hist_close < hist_open
                    disp = swing_low - hist_low
                    rng = hist_high - hist_low
                    if disp > (rng * displacement_mult) and rng > 0
                        ob_top := hist_high
                        ob_bot := hist_low
                        ob_bar := bar_index - i
                        ob_time_offset := i
                        found := true

        if found and not na(ob_top)
            ob_session = get_ob_session_name(time[ob_time_offset])
            b = box.new(ob_bar, ob_top, bar_index + 20, ob_bot, border_color=bull_border, bgcolor=bull_color, border_width=2, extend=extend.right, force_overlay=true)
            
            label l = na
            if show_labels
                l := label.new(ob_bar, ob_bot, "Bull OB", color=color.new(color.green, 20), textcolor=color.white, style=label.style_label_up, size=size.small, force_overlay=true)
            
            label info_l = na
            if ob_show_info
                age = bar_index - ob_bar
                info_text = ob_session + " Session\nAge: " + str.tostring(age) + " bars"
                info_l := label.new(bar_index + 10, (ob_top + ob_bot) / 2, info_text, color=color.new(color.green, 100), textcolor=color.new(color.green, 0), style=label.style_label_center, size=get_text_size_ob(), force_overlay=true)
            
            new_ob = OB.new(b, l, info_l, ob_top, ob_bot, ob_bar, true, ob_session, ob_bar)
            array.push(bull_obs, new_ob)

    // Bearish OB
    if not na(swing_high) and show_bearish
        bool found = false
        float ob_top = na
        float ob_bot = na
        int ob_bar = na
        int ob_time_offset = na
        
        for i = ps_swing_length + 1 to ps_swing_length + ps_lookback
            if not found
                hist_close = close[i]
                hist_open = open[i]
                hist_high = high[i]
                hist_low = low[i]
                if hist_close > hist_open
                    disp = hist_high - swing_high
                    rng = hist_high - hist_low
                    if disp > (rng * displacement_mult) and rng > 0
                        ob_top := hist_high
                        ob_bot := hist_low
                        ob_bar := bar_index - i
                        ob_time_offset := i
                        found := true

        if found and not na(ob_top)
            ob_session = get_ob_session_name(time[ob_time_offset])
            b = box.new(ob_bar, ob_top, bar_index + 20, ob_bot, border_color=bear_border, bgcolor=bear_color, border_width=2, extend=extend.right, force_overlay=true)
            
            label l = na
            if show_labels
                l := label.new(ob_bar, ob_top, "Bear OB", color=color.new(color.red, 20), textcolor=color.white, style=label.style_label_down, size=size.small, force_overlay=true)
            
            label info_l = na
            if ob_show_info
                age = bar_index - ob_bar
                info_text = ob_session + " Session\nAge: " + str.tostring(age) + " bars"
                info_l := label.new(bar_index + 10, (ob_top + ob_bot) / 2, info_text, color=color.new(color.red, 100), textcolor=color.new(color.red, 0), style=label.style_label_center, size=get_text_size_ob(), force_overlay=true)
                
            new_ob = OB.new(b, l, info_l, ob_top, ob_bot, ob_bar, false, ob_session, ob_bar)
            array.push(bear_obs, new_ob)

clean_obs(bull_obs)
clean_obs(bear_obs)
limit_size(bull_obs, max_obs)
limit_size(bear_obs, max_obs)
update_boxes(bull_obs)
update_boxes(bear_obs)
