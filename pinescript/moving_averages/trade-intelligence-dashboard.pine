//@version=6
indicator("Universal Debug Panel v1", overlay=true)

//========================================================
// INPUTS
//========================================================

// Instrument
instrumentPreset = input.string("NQ", "Instrument Preset", options=["NQ","MNQ","ES","MES","SPY","QQQ","Stock"], group="Instrument")
pointValue       = instrumentPreset == "NQ"  ? 20.0 :
                   instrumentPreset == "MNQ" ?  2.0 :
                   instrumentPreset == "ES"  ? 50.0 :
                   instrumentPreset == "MES" ?  5.0 : 1.0

// Section Toggles
showVwap    = input.bool(true, "Show VWAP",             group="Section Toggles")
showTrend   = input.bool(true, "Show Trend",            group="Section Toggles")
showAtr     = input.bool(true, "Show ATR & Volatility", group="Section Toggles")
showCvd     = input.bool(true, "Show CVD",              group="Section Toggles")
showEma     = input.bool(true, "Show EMA/SMA",          group="Section Toggles")
showVol     = input.bool(true, "Show Volume",           group="Section Toggles")
showStruct  = input.bool(true, "Show Market Structure", group="Section Toggles")
showRsi     = input.bool(true, "Show RSI",              group="Section Toggles")
showPa      = input.bool(true, "Show Price Action",     group="Section Toggles")

// ATR
atrLen    = input.int(14,   "ATR Length",               minval=1,    group="ATR & Volatility")
minAtrPct = input.float(0.15, "Min ATR % (Vol Floor)", step=0.01,   group="ATR & Volatility")

// CVD
cvdSensitivity  = input.float(1.0, "CVD Sensitivity",        step=0.1, group="CVD")
cvdAtrMult      = input.float(0.5, "CVD ATR Threshold Mult", step=0.1, group="CVD")
cvdSessionReset = input.bool(true,  "Reset CVD Each Session",          group="CVD")

// EMA / SMA
maMode    = input.string("EMA", "MA Mode", options=["EMA","SMA"], group="EMA/SMA")
maFastLen = input.int(9,  "Fast MA Length", minval=1,              group="EMA/SMA")
maSlowLen = input.int(21, "Slow MA Length", minval=1,              group="EMA/SMA")

// Volume
volAvgLen   = input.int(20,   "Volume Average Length",          minval=1,  group="Volume")
volHighMult = input.float(1.5, "High Volume Threshold (x Avg)", step=0.1, group="Volume")
volLowMult  = input.float(0.5, "Low Volume Threshold (x Avg)",  step=0.1, group="Volume")

// RSI
rsiLen        = input.int(14,    "RSI Length",           minval=1, group="RSI")
rsiOverbought = input.float(70,  "RSI Overbought Level",           group="RSI")
rsiOversold   = input.float(30,  "RSI Oversold Level",             group="RSI")

// Trend
trendStrengthMult = input.float(1.0, "Trend Strength ATR Mult", step=0.1, group="Trend")

// Market Structure
structSwingLen = input.int(5, "Swing Detection Length", minval=2, group="Market Structure")

// Box Appearance
boxPos       = input.string("Bottom Left", "Box Position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group="Box Appearance")
boxSize      = input.string("Medium", "Box Text Size", options=["Small","Medium","Large"],                                group="Box Appearance")
boxBg        = input.color(color.new(color.black, 0), "Box Background",            group="Box Appearance")
boxTextColor = input.color(color.white,               "Box Text Color",            group="Box Appearance")
boxBorder    = input.int(1, "Box Border Thickness", minval=0, maxval=5,            group="Box Appearance")
sectionBg    = input.color(color.new(color.blue, 70), "Section Header Background", group="Box Appearance")

// Colors
posColor  = input.color(color.green,  "Positive Color", group="Colors")
negColor  = input.color(color.red,    "Negative Color", group="Colors")
neutColor = input.color(color.white,  "Neutral Color",  group="Colors")
warnColor = input.color(color.yellow, "Warning Color",  group="Colors")

textSize = boxSize == "Small" ? size.tiny : boxSize == "Medium" ? size.small : size.normal

//========================================================
// VWAP
//========================================================
vwap        = ta.vwap(hlc3)
vwapAbove   = close > vwap
vwapDist    = close - vwap
vwapDistPct = (vwapDist / vwap) * 100

//========================================================
// SESSION CALCS
//========================================================
newSession   = ta.change(time("D")) != 0
sessionOpen  = ta.valuewhen(newSession, open, 0)
var float sessionHigh = high
var float sessionLow  = low
if newSession
    sessionHigh := high
    sessionLow  := low
else
    sessionHigh := math.max(sessionHigh, high)
    sessionLow  := math.min(sessionLow,  low)
sessionMid = (sessionHigh + sessionLow) / 2.0

//========================================================
// DAILY CHANGE
//========================================================
dailyChange    = close - sessionOpen
dailyChangePct = sessionOpen != 0 ? (dailyChange / sessionOpen) * 100.0 : 0.0

//========================================================
// ATR & VOLATILITY
//========================================================
atr    = ta.atr(atrLen)
atrPct = (atr / close) * 100
volOk  = atrPct > minAtrPct
prevAtr     = atr[1]
atrDir      = atr > atr[1] ? "Rising" : atr < atr[1] ? "Falling" : "Flat"
atrDirColor = atr > atr[1] ? posColor : atr < atr[1] ? negColor : neutColor
atrChangePct = atr[1] > 0 ? ((atr - atr[1]) / atr[1]) * 100.0 : 0.0

//========================================================
// TREND
//========================================================
trendUp          = close > vwap
trendDown        = close < vwap
trendStrength    = math.abs(close - vwap)
trendStrong      = trendStrength > atr * trendStrengthMult
trendDir         = trendUp ? "Up" : trendDown ? "Down" : "Flat"
trendDirColor    = trendUp ? posColor : trendDown ? negColor : neutColor
trendStrMultiple = atr > 0 ? trendStrength / atr : 0.0

//========================================================
// CVD
//========================================================
var float CVD = 0.0
delta = close > open ? 1 : close < open ? -1 : 0
CVD := cvdSessionReset and newSession ? volume * delta * cvdSensitivity : CVD + volume * delta * cvdSensitivity

cvdThresh    = atr * cvdAtrMult
cvdBullish   = CVD > cvdThresh
cvdBearish   = CVD < -cvdThresh
cvdDirStr    = cvdBullish ? "Bullish" : cvdBearish ? "Bearish" : "Neutral"
cvdDirColor  = cvdBullish ? posColor  : cvdBearish ? negColor  : neutColor
cvdChange    = CVD - CVD[1]
cvdBullCross = ta.crossover(CVD,  cvdThresh)
cvdBearCross = ta.crossunder(CVD, -cvdThresh)

//========================================================
// EMA / SMA
//========================================================
maFast         = maMode == "EMA" ? ta.ema(close, maFastLen) : ta.sma(close, maFastLen)
maSlow         = maMode == "EMA" ? ta.ema(close, maSlowLen) : ta.sma(close, maSlowLen)
maFastDir      = maFast > maFast[1] ? "Rising" : maFast < maFast[1] ? "Falling" : "Flat"
maSlowDir      = maSlow > maSlow[1] ? "Rising" : maSlow < maSlow[1] ? "Falling" : "Flat"
maBullCross    = ta.crossover(maFast, maSlow)
maBearCross    = ta.crossunder(maFast, maSlow)
maCrossStr     = maBullCross ? "Bullish Cross" : maBearCross ? "Bearish Cross" : "None"
maCrossColor   = maBullCross ? posColor : maBearCross ? negColor : neutColor
priceAboveFast = close > maFast
priceAboveSlow = close > maSlow
maFastDirColor = maFast > maFast[1] ? posColor : maFast < maFast[1] ? negColor : neutColor
maSlowDirColor = maSlow > maSlow[1] ? posColor : maSlow < maSlow[1] ? negColor : neutColor

//========================================================
// VOLUME
//========================================================
volAvg           = ta.sma(volume, volAvgLen)
volRatio         = volAvg > 0 ? volume / volAvg : 1.0
volHigh          = volRatio >= volHighMult
volLow           = volRatio <= volLowMult
volStr           = volHigh ? "High" : volLow ? "Low" : "Normal"
volStrColor      = volHigh ? posColor : volLow ? negColor : neutColor
buyingBar        = close > open
sellingBar       = close < open
barPressure      = buyingBar ? "Buying" : sellingBar ? "Selling" : "Neutral"
barPressureColor = buyingBar ? posColor : sellingBar ? negColor : neutColor

//========================================================
// MARKET STRUCTURE
//========================================================
swingHigh = ta.pivothigh(high, structSwingLen, structSwingLen)
swingLow  = ta.pivotlow(low,  structSwingLen, structSwingLen)

var float lastSwingHigh  = na
var float prevSwingHigh  = na
var float lastSwingLow   = na
var float prevSwingLow   = na
var int   barsSinceSwing = 0
var string lastSwingType = "—"

if not na(swingHigh)
    prevSwingHigh  := lastSwingHigh
    lastSwingHigh  := swingHigh
    barsSinceSwing := 0
    if not na(prevSwingHigh)
        lastSwingType := lastSwingHigh > prevSwingHigh ? "HH" : "LH"

if not na(swingLow)
    prevSwingLow   := lastSwingLow
    lastSwingLow   := swingLow
    barsSinceSwing := 0
    if not na(prevSwingLow)
        lastSwingType := lastSwingLow > prevSwingLow ? "HL" : "LL"

barsSinceSwing   := barsSinceSwing + 1
structBullish    = lastSwingType == "HH" or lastSwingType == "HL"
structBearish    = lastSwingType == "LH" or lastSwingType == "LL"
structBias       = structBullish ? "Bullish" : structBearish ? "Bearish" : "Neutral"
structBiasColor  = structBullish ? posColor : structBearish ? negColor : neutColor
swingTypeColor   = structBullish ? posColor : structBearish ? negColor : neutColor
swingRangePts    = not na(lastSwingHigh) and not na(lastSwingLow) ? lastSwingHigh - lastSwingLow : 0.0

//========================================================
// RSI
//========================================================
rsiVal        = ta.rsi(close, rsiLen)
rsiOB         = rsiVal >= rsiOverbought
rsiOS         = rsiVal <= rsiOversold
rsiCondStr    = rsiOB ? "Overbought" : rsiOS ? "Oversold" : "Neutral"
rsiCondColor  = rsiOB ? negColor : rsiOS ? posColor : neutColor
rsiRising     = rsiVal > rsiVal[1]
rsiTrendStr   = rsiRising ? "Rising" : rsiVal < rsiVal[1] ? "Falling" : "Flat"
rsiTrendColor = rsiRising ? posColor : rsiVal < rsiVal[1] ? negColor : neutColor
rsiValColor   = rsiVal > 50 ? posColor : rsiVal < 50 ? negColor : warnColor
rsiChange     = rsiVal - rsiVal[1]
rsiDist50     = rsiVal - 50.0
rsiDistOBOS   = rsiOB ? rsiVal - rsiOverbought : rsiOS ? rsiOversold - rsiVal : 0.0

//========================================================
// PRICE ACTION
//========================================================
barRange      = high - low
barRangeDollar = barRange * pointValue
barVsAtr      = atr > 0 ? barRange / atr : 0.0
barBody       = math.abs(close - open)
barBodyPct    = barRange > 0 ? (barBody / barRange) * 100.0 : 0.0
upperWick     = high - math.max(open, close)
lowerWick     = math.min(open, close) - low
wickRatioStr  = upperWick > lowerWick ? "Upper Dom" : lowerWick > upperWick ? "Lower Dom" : "Equal"
wickRatioColor = lowerWick > upperWick ? posColor : upperWick > lowerWick ? negColor : neutColor

barClosePos =
     close >= low + barRange * 0.66 ? "Upper" :
     close >= low + barRange * 0.33 ? "Mid"   : "Lower"
barClosePosColor = barClosePos == "Upper" ? posColor : barClosePos == "Lower" ? negColor : warnColor

barBullBear =
     close > open  ? "Bullish" :
     close < open  ? "Bearish" : "Doji"
barBullBearColor = barBullBear == "Bullish" ? posColor : barBullBear == "Bearish" ? negColor : warnColor

var int consecCount = 0
var bool lastWasBull = false
if close > open
    consecCount  := lastWasBull ? consecCount + 1 : 1
    lastWasBull  := true
else if close < open
    consecCount  := lastWasBull ? -1 : consecCount - 1
    lastWasBull  := false
else
    consecCount  := 0

consecStr   = consecCount > 0 ? str.tostring(consecCount) + " Bull" : consecCount < 0 ? str.tostring(math.abs(consecCount)) + " Bear" : "Doji"
consecColor = consecCount > 0 ? posColor : consecCount < 0 ? negColor : neutColor

//========================================================
// POSITION ENUM HELPER
//========================================================
posEnumFromString(s) =>
    s == "Top Right"     ? position.top_right    :
     s == "Top Left"     ? position.top_left     :
     s == "Bottom Right" ? position.bottom_right :
     position.bottom_left

posEnum = posEnumFromString(boxPos)

//========================================================
// DYNAMIC COLUMN COUNT
// Instrument column always shown (col 0)
// Each section adds 1 column when toggled on
//========================================================
totalCols = 1 +
     (showVwap   ? 1 : 0) +
     (showTrend  ? 1 : 0) +
     (showAtr    ? 1 : 0) +
     (showCvd    ? 1 : 0) +
     (showEma    ? 1 : 0) +
     (showVol    ? 1 : 0) +
     (showStruct ? 1 : 0) +
     (showRsi    ? 1 : 0) +
     (showPa     ? 1 : 0)

//========================================================
// DEBUG PANEL — horizontal, 9 rows (1 header + 8 metrics)
// Columns built dynamically left to right
//========================================================
var table debugBox = na

if barstate.islast
    if not na(debugBox)
        table.delete(debugBox)

    debugBox := table.new(posEnum, totalCols, 9, boxBg, color.gray, boxBorder, color.gray, boxBorder)

    int c = 0

    // ── COL 0 : INSTRUMENT (always visible) ──────────────────────
    table.cell(debugBox, c, 0, "Instrument",    text_color=boxTextColor, bgcolor=sectionBg,  text_size=textSize)
    table.cell(debugBox, c, 1, instrumentPreset, text_color=neutColor,   bgcolor=boxBg,       text_size=textSize)
    table.cell(debugBox, c, 2, "Point Value",   text_color=boxTextColor, bgcolor=boxBg,       text_size=textSize)
    table.cell(debugBox, c, 3, str.tostring(pointValue, "#.##"), text_color=neutColor, bgcolor=boxBg, text_size=textSize)
    table.cell(debugBox, c, 4, "Price",         text_color=boxTextColor, bgcolor=boxBg,       text_size=textSize)
    table.cell(debugBox, c, 5, str.tostring(close, "#.##"), text_color=neutColor, bgcolor=boxBg, text_size=textSize)
    table.cell(debugBox, c, 6, "Daily Chg",     text_color=boxTextColor, bgcolor=boxBg,       text_size=textSize)
    table.cell(debugBox, c, 7, str.tostring(dailyChange, "#.##"), text_color=dailyChange > 0 ? posColor : dailyChange < 0 ? negColor : neutColor, bgcolor=boxBg, text_size=textSize)
    table.cell(debugBox, c, 8, str.tostring(dailyChangePct, "#.##") + "%", text_color=dailyChangePct > 0 ? posColor : dailyChangePct < 0 ? negColor : neutColor, bgcolor=boxBg, text_size=textSize)
    c := c + 1

    // ── VWAP SECTION ─────────────────────────────────────────────
    if showVwap
        table.cell(debugBox, c, 0, "── VWAP ──",    text_color=boxTextColor, bgcolor=sectionBg, text_size=textSize)
        table.cell(debugBox, c, 1, vwapAbove ? "Above" : "Below", text_color=vwapAbove ? posColor : negColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 2, "Dist pts",       text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 3, str.tostring(vwapDist, "#.##"), text_color=vwapDist > 0 ? posColor : negColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 4, "Dist %",         text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 5, str.tostring(vwapDistPct, "#.##") + "%", text_color=vwapDistPct > 0 ? posColor : negColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 6, "VWAP Value",     text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 7, str.tostring(vwap, "#.##"), text_color=neutColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 8, "$" + str.tostring(math.abs(vwapDist) * pointValue, "#.##"), text_color=vwapDist > 0 ? posColor : negColor, bgcolor=boxBg, text_size=textSize)
        c := c + 1

    // ── TREND SECTION ─────────────────────────────────────────────
    if showTrend
        table.cell(debugBox, c, 0, "── Trend ──",   text_color=boxTextColor, bgcolor=sectionBg, text_size=textSize)
        table.cell(debugBox, c, 1, trendDir,          text_color=trendDirColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 2, "Strong",          text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 3, str.tostring(trendStrong), text_color=trendStrong ? posColor : negColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 4, "Strength pts",   text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 5, str.tostring(trendStrength, "#.##"), text_color=trendStrong ? posColor : neutColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 6, "Strength ATR x", text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 7, str.tostring(trendStrMultiple, "#.##") + "x", text_color=trendStrong ? posColor : neutColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 8, trendUp ? "Up" : trendDown ? "Down" : "Flat", text_color=trendDirColor, bgcolor=boxBg, text_size=textSize)
        c := c + 1

    // ── ATR SECTION ───────────────────────────────────────────────
    if showAtr
        table.cell(debugBox, c, 0, "── ATR ──",      text_color=boxTextColor, bgcolor=sectionBg, text_size=textSize)
        table.cell(debugBox, c, 1, str.tostring(atr, "#.##"), text_color=neutColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 2, "ATR %",           text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 3, str.tostring(atrPct, "#.##") + "%", text_color=atrPct > minAtrPct ? posColor : negColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 4, "Volatility",      text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 5, volOk ? "OK" : "Low", text_color=volOk ? posColor : negColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 6, "ATR $",           text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 7, "$" + str.tostring(atr * pointValue, "#.##"), text_color=neutColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 8, atrDir + " " + str.tostring(atrChangePct, "#.##") + "%", text_color=atrDirColor, bgcolor=boxBg, text_size=textSize)
        c := c + 1

    // ── CVD SECTION ───────────────────────────────────────────────
    if showCvd
        table.cell(debugBox, c, 0, "── CVD ──",      text_color=boxTextColor, bgcolor=sectionBg, text_size=textSize)
        table.cell(debugBox, c, 1, str.tostring(CVD, "#.##"), text_color=CVD > 0 ? posColor : CVD < 0 ? negColor : neutColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 2, "Threshold",       text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 3, str.tostring(cvdThresh, "#.##"), text_color=neutColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 4, "Direction",       text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 5, cvdDirStr,          text_color=cvdDirColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 6, "vs Threshold",    text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 7, CVD > cvdThresh ? "Above" : CVD < -cvdThresh ? "Below" : "Inside", text_color=CVD > cvdThresh ? posColor : CVD < -cvdThresh ? negColor : warnColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 8, "Reset: " + (cvdSessionReset ? "On" : "Off"), text_color=cvdSessionReset ? posColor : negColor, bgcolor=boxBg, text_size=textSize)
        c := c + 1

    // ── EMA/SMA SECTION ───────────────────────────────────────────
    if showEma
        table.cell(debugBox, c, 0, "── " + maMode + " ──", text_color=boxTextColor, bgcolor=sectionBg, text_size=textSize)
        table.cell(debugBox, c, 1, "Fast " + str.tostring(maFastLen) + ": " + str.tostring(maFast, "#.##"), text_color=maFastDirColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 2, "Fast Dir",         text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 3, maFastDir,           text_color=maFastDirColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 4, "Slow " + str.tostring(maSlowLen) + ": " + str.tostring(maSlow, "#.##"), text_color=maSlowDirColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 5, maSlowDir,           text_color=maSlowDirColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 6, "Cross",             text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 7, maCrossStr,           text_color=maCrossColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 8, "vs F: " + (priceAboveFast ? "↑" : "↓") + " vs S: " + (priceAboveSlow ? "↑" : "↓"), text_color=priceAboveFast and priceAboveSlow ? posColor : not priceAboveFast and not priceAboveSlow ? negColor : warnColor, bgcolor=boxBg, text_size=textSize)
        c := c + 1

    // ── VOLUME SECTION ────────────────────────────────────────────
    if showVol
        table.cell(debugBox, c, 0, "── Volume ──",   text_color=boxTextColor, bgcolor=sectionBg, text_size=textSize)
        table.cell(debugBox, c, 1, str.tostring(volume), text_color=neutColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 2, "vs Avg",          text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 3, volStr,             text_color=volStrColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 4, "Ratio",            text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 5, str.tostring(volRatio, "#.##") + "x", text_color=volRatio > 1 ? posColor : negColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 6, "Pressure",         text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 7, barPressure,         text_color=barPressureColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 8, "Avg: " + str.tostring(volAvg, "#"), text_color=neutColor, bgcolor=boxBg, text_size=textSize)
        c := c + 1

    // ── MARKET STRUCTURE SECTION ──────────────────────────────────
    if showStruct
        table.cell(debugBox, c, 0, "── Structure ──", text_color=boxTextColor, bgcolor=sectionBg, text_size=textSize)
        table.cell(debugBox, c, 1, lastSwingType,       text_color=swingTypeColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 2, "Bias",              text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 3, structBias,           text_color=structBiasColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 4, "Bars Since",        text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 5, str.tostring(barsSinceSwing), text_color=neutColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 6, "Swing H/L",         text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 7, str.tostring(lastSwingHigh, "#.##") + " / " + str.tostring(lastSwingLow, "#.##"), text_color=neutColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 8, "Range: " + str.tostring(swingRangePts, "#.##"), text_color=neutColor, bgcolor=boxBg, text_size=textSize)
        c := c + 1

    // ── RSI SECTION ───────────────────────────────────────────────
    if showRsi
        table.cell(debugBox, c, 0, "── RSI ──",       text_color=boxTextColor, bgcolor=sectionBg, text_size=textSize)
        table.cell(debugBox, c, 1, str.tostring(rsiVal, "#.##"), text_color=rsiValColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 2, "Condition",        text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 3, rsiCondStr,          text_color=rsiCondColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 4, "Trend",             text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 5, rsiTrendStr,          text_color=rsiTrendColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 6, "OB/OS",             text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 7, str.tostring(rsiOverbought) + " / " + str.tostring(rsiOversold), text_color=neutColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 8, "Dist 50: " + str.tostring(rsiDist50, "#.##"), text_color=rsiDist50 > 0 ? posColor : negColor, bgcolor=boxBg, text_size=textSize)
        c := c + 1

    // ── PRICE ACTION SECTION ──────────────────────────────────────
    if showPa
        table.cell(debugBox, c, 0, "── Price Action ──", text_color=boxTextColor, bgcolor=sectionBg, text_size=textSize)
        table.cell(debugBox, c, 1, barBullBear,            text_color=barBullBearColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 2, "Bar Range",            text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 3, str.tostring(barRange, "#.##") + " ($" + str.tostring(barRangeDollar, "#.##") + ")", text_color=neutColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 4, "Bar vs ATR",           text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 5, str.tostring(barVsAtr, "#.##") + "x", text_color=barVsAtr > 1 ? posColor : negColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 6, "Close Pos",            text_color=boxTextColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 7, barClosePos,             text_color=barClosePosColor, bgcolor=boxBg, text_size=textSize)
        table.cell(debugBox, c, 8, consecStr,               text_color=consecColor, bgcolor=boxBg, text_size=textSize)
        c := c + 1

//========================================================
// PLOTS
//========================================================
plot(showEma  ? maFast : na, title="Fast MA", color=color.new(color.aqua,   0), linewidth=1)
plot(showEma  ? maSlow : na, title="Slow MA", color=color.new(color.purple, 0), linewidth=1)
plot(showVwap ? vwap   : na, title="VWAP",    color=color.new(color.orange, 0), linewidth=2)
