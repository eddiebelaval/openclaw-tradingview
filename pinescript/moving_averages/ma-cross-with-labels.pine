//@version=6
indicator(title="MA Cross with Labels", overlay=true)

// 1. Inputs
shortlen = input.int(9, "Short MA Length", minval=1)
longlen = input.int(21, "Long MA Length", minval=1)

// 2. Calculations
short = ta.sma(close, shortlen)
long = ta.sma(close, longlen)

// 3. Logic
bullishCross = ta.crossover(short, long)
bearishCross = ta.crossunder(short, long)

// 4. Plotting Lines
plot(short, color = color.orange, title="Short MA")
plot(long, color = color.green, title="Long MA")

// 5. Drawing the "Little Squares" with Text
if bullishCross
    label.new(bar_index, low, text="BULL", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.small)

if bearishCross
    label.new(bar_index, high, text="BEAR", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)
