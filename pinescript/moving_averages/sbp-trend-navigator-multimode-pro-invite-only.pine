//@version=6
indicator("SBP Multimode Trading System — FREE", overlay=true, max_labels_count=300)

//==================================================
// SBP MULTIMODE TRADING SYSTEM — FREE
// • Adaptive UW MA
// • Dynamic Trend Filter
// • Fully Adaptive Ribbon
// • Swing Buy / Sell Labels
// • AI Confidence Meter (Teaser)
//==================================================


//==============================
// INPUTS
//==============================

groupCore = "Core Settings"

atrLen  = input.int(14, "ATR Length", group=groupCore)
atrMult = input.float(2.0, "ATR Multiplier", group=groupCore)
dtfLen  = input.int(25, "Trend Filter Length", group=groupCore)
uwBase  = input.int(21, "UW MA Base Length", group=groupCore)

showRibbon  = input.bool(true, "Show Adaptive Ribbon", group="Display")
showUWMA    = input.bool(true, "Show UW MA", group="Display")
showDTF     = input.bool(true, "Show Trend Filter", group="Display")
showSignals = input.bool(true, "Show Swing Buy / Sell Labels", group="Display")

//==============================
// ATR ENGINE
//==============================

atr = ta.atr(atrLen)
atrAvg = ta.sma(atr, 30)


//==================================================
// 🔹 STRUCTURE TREND ENGINE (NON-REPAINT)
//==================================================

upperBasic = hl2 + atr * atrMult
lowerBasic = hl2 - atr * atrMult

var float upper = na
var float lower = na
var int trend = 1

upper := close[1] < nz(upper[1], upperBasic)
     ? math.min(upperBasic, nz(upper[1], upperBasic))
     : upperBasic

lower := close[1] > nz(lower[1], lowerBasic)
     ? math.max(lowerBasic, nz(lower[1], lowerBasic))
     : lowerBasic

if close > upper
    trend := 1
else if close < lower
    trend := -1
else
    trend := nz(trend[1], 1)

newTrend = barstate.isconfirmed and trend != trend[1]


//==================================================
// 🔹 DYNAMIC TREND FILTER (BLUE)
//==================================================

dtf = ta.ema(ta.ema(close, dtfLen), 2)


//==================================================
// 🔹 ADAPTIVE UW MA (HULL STYLE)
//==================================================

atrFast = ta.atr(5)
atrSlow = ta.atr(21)

ratio = atrSlow > 0 ? atrFast / atrSlow : 1.0
ratio := math.min(math.max(ratio, 0.8), 1.3)

dynLen = math.max(math.round(uwBase * ratio), 5)

uw1 = ta.wma(close, dynLen)
uw2 = ta.wma(close, math.max(math.round(dynLen / 2), 1))
uwMA = ta.wma(2 * uw2 - uw1, math.max(math.round(math.sqrt(dynLen)), 1))

uwUp = uwMA > uwMA[1]

//==================================================
// 🔥 FULLY ADAPTIVE RIBBON (SAFE & CLEAN)
//==================================================

fastBase = ta.ema(close, 10)
slowBase = ta.ema(close, 21)

fastVol  = ta.ema(close, 8)
slowVol  = ta.ema(close, 18)

// Always compute EMA first, then select
volHigh = atr > atrAvg

fast = volHigh ? fastVol : fastBase
slow = volHigh ? slowVol : slowBase

ribbonWidth = math.abs(fast - slow)
ribbonAvg   = ta.sma(ribbonWidth, 20)

sideways = ribbonWidth < ribbonAvg * 0.6

pf = plot(showRibbon ? fast : na, display=display.none)
ps = plot(showRibbon ? slow : na, display=display.none)

ribbonColor =
     sideways ? color.new(color.gray, 80) :
     fast > slow ? color.new(color.lime, 75)
                 : color.new(color.red, 75)

fill(pf, ps, showRibbon ? ribbonColor : na)

//==================================================
// 🔹 SWING SIGNAL LOGIC (FREE CORE)
//==================================================

swingBuy =
     newTrend and
     trend == 1 and
     close > dtf and
     uwUp and
     not sideways

swingSell =
     newTrend and
     trend == -1 and
     close < dtf and
     not uwUp and
     not sideways


//==================================================
// 🔹 CLEAR SWING LABELS
//==================================================

if showSignals and swingBuy
    label.new(
        bar_index,
        low,
        "SWING BUY",
        style=label.style_label_up,
        color=color.lime,
        textcolor=color.black,
        size=size.normal
    )

if showSignals and swingSell
    label.new(
        bar_index,
        high,
        "SWING SELL",
        style=label.style_label_down,
        color=color.red,
        textcolor=color.white,
        size=size.normal
    )


//==================================================
// 🔥 AI CONFIDENCE METER (TEASER)
//==================================================

trendScore  = trend == 1 ? 1 : -1
dtfScore    = close > dtf ? 1 : -1
uwScore     = uwUp ? 1 : -1
ribbonScore = fast > slow ? 1 : -1

rawStrength = trendScore + dtfScore + uwScore + ribbonScore
confidenceRaw = (rawStrength + 4) / 8 * 100
confidence = ta.ema(confidenceRaw, 5)
confidence := math.min(math.max(confidence, 0), 100)

confColor =
     confidence < 40 ? color.red :
     confidence < 70 ? color.orange :
                       color.lime


//==================================================
// 🔹 PLOTS
//==================================================

plot(showUWMA ? uwMA : na,
     color = uwUp ? color.lime : color.red,
     linewidth=2,
     title="UW MA")

plot(showDTF ? dtf : na,
     color=color.blue,
     linewidth=2,
     title="Trend Filter")


//==================================================
// 🔹 ALERTS
//==================================================

alertcondition(swingBuy,  "SBP Swing Buy",  "SBP FREE Swing Buy")
alertcondition(swingSell, "SBP Swing Sell", "SBP FREE Swing Sell")

//==================================================
// 🏛 PREMIUM WHITE DASHBOARD (VISIBLE)
//==================================================

var table dash = table.new(position.top_right, 2, 10, border_width=1)

bg = color.white
txt = color.black

if barstate.islast

    // ===== HEADER =====
    table.cell(dash, 0, 0, "SBP FREE",
        text_color=txt,
        bgcolor=bg,
        text_size=size.small)

    table.cell(dash, 1, 0, "LIVE STATUS",
        text_color=txt,
        bgcolor=bg,
        text_size=size.small)

    // ===== LIVE STATUS =====
    table.cell(dash, 0, 1, "Trend", bgcolor=bg, text_color=txt, text_size=size.small)
    table.cell(dash, 1, 1,
        trend == 1 ? "Bullish" : "Bearish",
        text_color=trend == 1 ? color.green : color.red,
        bgcolor=bg,
        text_size=size.small)

    table.cell(dash, 0, 2, "Ribbon", bgcolor=bg, text_color=txt, text_size=size.small)
    table.cell(dash, 1, 2,
        sideways ? "Compressed" :
        fast > slow ? "Expansion" : "Contraction",
        text_color=sideways ? color.gray :
                   fast > slow ? color.green : color.red,
        bgcolor=bg,
        text_size=size.small)

    table.cell(dash, 0, 3, "UW MA", bgcolor=bg, text_color=txt, text_size=size.small)
    table.cell(dash, 1, 3,
        uwUp ? "Rising" : "Falling",
        text_color=uwUp ? color.green : color.red,
        bgcolor=bg,
        text_size=size.small)

    table.cell(dash, 0, 4, "AI Confidence", bgcolor=bg, text_color=txt, text_size=size.small)
    table.cell(dash, 1, 4,
        str.tostring(math.round(confidence)) + "%",
        text_color=confColor,
        bgcolor=bg,
        text_size=size.small)
//==================================================
// 🏛 WHITE PRO CONVERSION DASHBOARD
//==================================================

var table dashMain = table.new(position.top_right, 2, 12, border_width=1)

if barstate.islast

    // Colors (defined ONCE)
    bgColor  = color.white
    textColor = color.black

    // ===== HEADER =====
    table.cell(dashMain, 0, 0, "SBP FREE VERSION",
        text_color=textColor, bgcolor=bgColor, text_size=size.small)

    table.cell(dashMain, 1, 0, "STATUS / FEATURES",
        text_color=textColor, bgcolor=bgColor, text_size=size.small)

    // ===== FREE STATUS =====
    table.cell(dashMain, 0, 1, "Trend", bgcolor=bgColor, text_color=textColor, text_size=size.small)
    table.cell(dashMain, 1, 1,
        trend == 1 ? "Bullish" : "Bearish",
        text_color=trend == 1 ? color.green : color.red,
        bgcolor=bgColor, text_size=size.small)

    table.cell(dashMain, 0, 2, "Basic Ribbon", bgcolor=bgColor, text_color=textColor, text_size=size.small)
    table.cell(dashMain, 1, 2, "Active",
        text_color=color.green, bgcolor=bgColor, text_size=size.small)

    table.cell(dashMain, 0, 3, "UW MA", bgcolor=bgColor, text_color=textColor, text_size=size.small)
    table.cell(dashMain, 1, 3,
        uwUp ? "Rising" : "Falling",
        text_color=uwUp ? color.green : color.red,
        bgcolor=bgColor, text_size=size.small)

    table.cell(dashMain, 0, 4, "Swing Signals", bgcolor=bgColor, text_color=textColor, text_size=size.small)
    table.cell(dashMain, 1, 4, "Enabled",
        text_color=color.green, bgcolor=bgColor, text_size=size.small)

    table.cell(dashMain, 0, 5, "AI Confidence", bgcolor=bgColor, text_color=textColor, text_size=size.small)
    table.cell(dashMain, 1, 5,
        str.tostring(math.round(confidence)) + "%",
        text_color=confColor,
        bgcolor=bgColor, text_size=size.small)

    // ===== PRO FEATURES LOCKED =====
    table.cell(dashMain, 0, 6, "Fully Adaptive Ribbon", bgcolor=bgColor, text_color=textColor, text_size=size.small)
    table.cell(dashMain, 1, 6, "🔒 PRO",
        text_color=color.gray, bgcolor=bgColor, text_size=size.small)

    table.cell(dashMain, 0, 7, "Intraday Signals", bgcolor=bgColor, text_color=textColor, text_size=size.small)
    table.cell(dashMain, 1, 7, "🔒 PRO",
        text_color=color.gray, bgcolor=bgColor, text_size=size.small)

    table.cell(dashMain, 0, 8, "Scalper Signals", bgcolor=bgColor, text_color=textColor, text_size=size.small)
    table.cell(dashMain, 1, 8, "🔒 PRO",
        text_color=color.gray, bgcolor=bgColor, text_size=size.small)

    table.cell(dashMain, 0, 9, "AI Consensus Engine", bgcolor=bgColor, text_color=textColor, text_size=size.small)
    table.cell(dashMain, 1, 9, "🔒 PRO",
        text_color=color.gray, bgcolor=bgColor, text_size=size.small)

    table.cell(dashMain, 0,10, "Smart Exit Engine", bgcolor=bgColor, text_color=textColor, text_size=size.small)
    table.cell(dashMain, 1,10, "🔒 PRO",
        text_color=color.gray, bgcolor=bgColor, text_size=size.small)

    // ===== PRICE CTA =====
    table.cell(dashMain, 0,11, "Upgrade to Invite Only",
        bgcolor=bgColor, text_color=textColor, text_size=size.small)

    table.cell(dashMain, 1,11, "₹499 / Month",
        text_color=color.blue,
        bgcolor=bgColor,
        text_size=size.small)
