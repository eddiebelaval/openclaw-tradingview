//@version=6
indicator(title="Cross PB", shorttitle="CrossPB", overlay=true, max_lines_count=500)

group_ma = "Moving Averages"
fast_length = input.int(9, "Fast MA Length", group=group_ma)
fast_src = input.string("close", "Fast Source", options=["close", "open", "high", "low", "hl2", "hlc3", "ohlc4"], group=group_ma)
fast_type = input.string("EMA", "Fast MA Type", options=["SMA", "EMA", "WMA", "HMA", "VWMA", "RMA", "ALMA", "TMA", "TSMA", "KAMA", "AMA"], group=group_ma)
slow_length = input.int(18, "Slow MA Length", group=group_ma)
slow_src = input.string("close", "Slow Source", options=["close", "open", "high", "low", "hl2", "hlc3", "ohlc4"], group=group_ma)
slow_type = input.string("EMA", "Slow MA Type", options=["SMA", "EMA", "WMA", "HMA", "VWMA", "RMA", "ALMA", "TMA", "TSMA", "KAMA", "AMA"], group=group_ma)
filter_length = input.int(99, "Filter MA Length", group=group_ma)
filter_src = input.string("close", "Filter Source", options=["close", "open", "high", "low", "hl2", "hlc3", "ohlc4"], group=group_ma)
filter_type = input.string("WMA", "Filter MA Type", options=["SMA", "EMA", "WMA", "HMA", "VWMA", "RMA", "ALMA", "TMA", "TSMA", "KAMA", "AMA"], group=group_ma)

group_alerts = "Alerts & Notifications"
enable_buy_alerts_1 = input.bool(true, "Enable BUY Alert 1", group=group_alerts)
enable_buy_alerts_2 = input.bool(true, "Enable BUY Alert 2", group=group_alerts)
enable_sell_alerts_1 = input.bool(true, "Enable SELL Alert 1", group=group_alerts)
enable_sell_alerts_2 = input.bool(true, "Enable SELL Alert 2", group=group_alerts)

getSrc(srcStr) =>
    switch srcStr
        "open" => open
        "high" => high
        "low" => low
        "hl2" => math.avg(high, low)
        "hlc3" => math.avg(high, low, close)
        "ohlc4" => math.avg(open, high, low, close)
        => close

alma(series, length, offset, sigma) =>
    sum = 0.0
    weight_sum = 0.0
    alma_offset = offset * (length - 1)
    for i = 0 to length - 1
        weight = math.exp(-(math.pow(i - alma_offset, 2)) / (2 * math.pow(sigma, 2)))
        sum += series[i] * weight
        weight_sum += weight
    sum / weight_sum

tma(src, length) =>
    int half_length = math.floor((length + 1) / 2)
    ta.sma(ta.sma(src, half_length), half_length)

tsma(src, length) =>
    ta.linreg(src, length, 0)

kama(src, length, fastSC, slowSC) =>
    float change = math.abs(src - src[length])
    float volatility = 0.0
    for i = 0 to length - 1
        volatility += math.abs(src[i] - src[i + 1])
    float er = volatility != 0 ? change / volatility : 0
    float fast = 2.0 / (fastSC + 1)
    float slow = 2.0 / (slowSC + 1)
    float alpha = math.pow(er * (fast - slow) + slow, 2)
    var float kamaValue = na
    kamaValue := na(kamaValue[1]) ? src : kamaValue[1] + alpha * (src - kamaValue[1])
    kamaValue

ama(src, length) =>
    float noise = ta.sma(math.abs(src - src[1]), length)
    float signal = math.abs(src - src[length])
    float efficiency = noise > 0 ? math.min(signal / noise, 1) : 0
    float alpha = math.pow(efficiency * 0.5, 2)
    var float amaValue = na
    amaValue := na(amaValue[1]) ? src : amaValue[1] + alpha * (src - amaValue[1])
    amaValue

calcMa(src, len, maType) =>
    float result = na
    if maType == "SMA"
        result := ta.sma(src, len)
    else if maType == "EMA"
        result := ta.ema(src, len)
    else if maType == "WMA"
        result := ta.wma(src, len)
    else if maType == "HMA"
        sqrt_len = math.round(math.sqrt(len))
        result := ta.wma(2 * ta.wma(src, math.floor(len / 2)) - ta.wma(src, len), sqrt_len)
    else if maType == "VWMA"
        result := ta.vwma(src, len)
    else if maType == "RMA"
        result := ta.rma(src, len)
    else if maType == "ALMA"
        result := alma(src, len, 0.85, 6)
    else if maType == "TMA"
        result := tma(src, len)
    else if maType == "TSMA"
        result := tsma(src, len)
    else if maType == "KAMA"
        result := kama(src, len, 2, 30)
    else if maType == "AMA"
        result := ama(src, len)
    result

fast_ma = calcMa(getSrc(fast_src), fast_length, fast_type)
slow_ma = calcMa(getSrc(slow_src), slow_length, slow_type)
filter_ma = calcMa(getSrc(filter_src), filter_length, filter_type)

plot(fast_ma, "Fast MA", color=color.orange, linewidth=2)
plot(slow_ma, "Slow MA", color=color.blue, linewidth=2)
plot(filter_ma, "Filter MA", color=color.gray, linewidth=1)

crossover_condition = ta.crossover(fast_ma, slow_ma)
crossunder_condition = ta.crossunder(fast_ma, slow_ma)

// Détection des types de bougies
bullish_candle = close > open
bearish_candle = close < open

// Signaux d'alerte 1
if enable_buy_alerts_1 and crossover_condition and bearish_candle and close < fast_ma
    alert("BUY Signal 1: Bullish Crossover + Bearish Candle closed below Fast MA", alert.freq_once_per_bar_close)

if enable_sell_alerts_1 and crossunder_condition and bullish_candle and close > fast_ma
    alert("SELL Signal 1: Bearish Crossover + Bullish Candle closed above Fast MA", alert.freq_once_per_bar_close)

// Signaux d'alerte 2
if enable_buy_alerts_2 and crossover_condition and bearish_candle and close < slow_ma
    alert("BUY Signal 2: Bullish Crossover + Bearish Candle closed below Slow MA", alert.freq_once_per_bar_close)

if enable_sell_alerts_2 and crossunder_condition and bullish_candle and close > slow_ma
    alert("SELL Signal 2: Bearish Crossover + Bullish Candle closed above Slow MA", alert.freq_once_per_bar_close)
