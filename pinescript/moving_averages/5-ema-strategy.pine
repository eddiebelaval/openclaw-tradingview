//@version=6
indicator("5 EMA Strategy", overlay=true, max_labels_count=500)

// =========================
// Inputs
// =========================
groupEMA = "EMA"
emaLen   = input.int(5, "EMA Length", minval=1, group=groupEMA)
showEMA  = input.bool(true, "Show 5 EMA", group=groupEMA)

groupMarks = "Marker"
yOffsetATR = input.float(0.25, "Label offset (ATR multiplier)", minval=0.0, step=0.05, group=groupMarks)
waitText   = input.string("WAITING FOR CONFIRMATION", "Waiting Text", group=groupMarks)
revText    = input.string("Possible reversal", "Reversal Text", group=groupMarks)

groupRules = "Rules"
resetOnTouchEMA = input.bool(true, "Reset lock when price touches EMA (low <= EMA)", group=groupRules)

// =========================
// Calculations
// =========================
ema5   = ta.ema(close, emaLen)
atrVal = ta.atr(14)

isRed   = close < open
isGreen = close > open

candleAboveEMA = low > ema5
isAlertCandle  = isRed and candleAboveEMA

// =========================
// State tracking
// =========================
var bool  pending      = false          // waiting for the very next candle to confirm outcomes
var bool  signalActive = false          // prevents new signals while current is active
var int   alertBar     = na
var float alertHigh    = na
var float alertLow     = na
var float alertClose   = na
var label alertLabel   = na

// =========================
// Label helpers
// =========================
createAlertLabel(_barIndex, _price) =>
    label.new(
        x=_barIndex,
        y=_price,
        xloc=xloc.bar_index,
        yloc=yloc.price,
        text=waitText,
        style=label.style_label_down,
        textcolor=color.white,
        color=color.red,
        size=size.small
    )

deleteLabel(_lbl) =>
    if not na(_lbl)
        label.delete(_lbl)

// =========================
// Main logic (confirmed bars only)
// =========================
if barstate.isconfirmed

    // Optional reset: once price touches or goes below EMA, allow new signals again
    if resetOnTouchEMA and signalActive and (low <= ema5)
        signalActive := false

    // Confirmation candle logic (only the very next candle after the alert candle)
    if pending and bar_index == alertBar + 1
        // Priority: Outcome 2 -> Outcome 1 -> Outcome 3
        outcome2_remove   = isGreen and (close > alertHigh)
        outcome1_reversal = close < alertClose
        outcome3_wait     = (close >= alertLow) and (close <= alertHigh)

        if outcome2_remove
            // Remove everything and unlock signals
            deleteLabel(alertLabel)
            alertLabel := na
            signalActive := false

        else if outcome1_reversal
            // Update text, keep signal active (blocks new signals)
            if not na(alertLabel)
                label.set_text(alertLabel, revText)
            signalActive := true

        else if outcome3_wait
            // Keep waiting, keep signal active (blocks new signals)
            signalActive := true

        else
            // If none match, still keep it active by default (safe behavior)
            signalActive := true

        // Clear only the "pending confirmation" state
        pending      := false
        alertBar     := na
        alertHigh    := na
        alertLow     := na
        alertClose   := na

    // Detect a new alert candle ONLY if no signal is currently active
    if not signalActive and isAlertCandle
        y = high + atrVal * yOffsetATR
        alertLabel := createAlertLabel(bar_index, y)

        pending      := true
        signalActive := true
        alertBar     := bar_index
        alertHigh    := high
        alertLow     := low
        alertClose   := close

// =========================
// Plots
// =========================
plot(showEMA ? ema5 : na, title="5 EMA", color=color.orange, linewidth=2)
