//@version=6
indicator(title="Low Volatility EMA extension", shorttitle="Low Volatility EMA extension", overlay=true, timeframe="", timeframe_gaps=true)

// ==================== BASIC EMA ====================
len = input.int(8, minval=1, title="Length")
src = input(close, title="Source")
offset = input.int(title="Offset", defval=0, minval=-500, maxval=500, display = display.none)
out = ta.ema(src, len)
plot(out, title="EMA", color=color.yellow, offset=offset, linewidth=2)

// ==================== EXTENSION INDICATORS ====================
EXT_GRP = "Extension Levels"
ema34Length = input.int(34, "34 EMA Length", group = EXT_GRP)
showExtensions = input.bool(true, "Show Extension Levels", group = EXT_GRP)
ext10Pct = input.float(10, "Extension Level 1 (%)", minval = 0, step = 5, group = EXT_GRP)
ext25Pct = input.float(15, "Extension Level 2 (%)", minval = 0, step = 5, group = EXT_GRP)
ext35Pct = input.float(20, "Extension Level 3 (%)", minval = 0, step = 5, group = EXT_GRP)

// Calculate 34 EMA
ema34 = ta.ema(src, ema34Length)

// Calculate extension levels (both above and below)
ema34_ext10_upper = ema34 * (1 + ext10Pct / 100)
ema34_ext10_lower = ema34 * (1 - ext10Pct / 100)
ema34_ext25_upper = ema34 * (1 + ext25Pct / 100)
ema34_ext25_lower = ema34 * (1 - ext25Pct / 100)
ema34_ext35_upper = ema34 * (1 + ext35Pct / 100)
ema34_ext35_lower = ema34 * (1 - ext35Pct / 100)

// Plot 34 EMA
plot(showExtensions ? ema34 : na, title="34 EMA", color=color.white, linewidth=2)

// Plot extension levels with solid lines
p10u = plot(showExtensions ? ema34_ext10_upper : na, title="10% Above", color=color.new(#4caf50, 70), linewidth=1)
p10l = plot(showExtensions ? ema34_ext10_lower : na, title="10% Below", color=color.new(#4caf50, 70), linewidth=1)
p25u = plot(showExtensions ? ema34_ext25_upper : na, title="25% Above", color=color.new(#ff9800, 85), linewidth=1)
p25l = plot(showExtensions ? ema34_ext25_lower : na, title="25% Below", color=color.new(#ff9800, 85), linewidth=1)
p35u = plot(showExtensions ? ema34_ext35_upper : na, title="35% Above", color=color.new(#f23645, 80), linewidth=1)
p35l = plot(showExtensions ? ema34_ext35_lower : na, title="35% Below", color=color.new(#f23645, 80), linewidth=1)

// Fill areas between extension lines
// Upper bands
fill(p10u, p25u, color=color.new(#f57c00, 95), title="10-25% Upper Fill")
fill(p25u, p35u, color=color.new(#f23645, 95), title="25-35% Upper Fill")

// Lower bands
fill(p10l, p25l, color=color.new(#f57c00, 95), title="10-25% Lower Fill")
fill(p25l, p35l, color=color.new(#f23645, 95), title="25-35% Lower Fill")

// ==================== EMA 8/34 CROSSOVER SIGNALS ====================
CROSS_GRP = "Crossover Signals"
showCrossovers = input.bool(true, "Show Crossover Signals", group = CROSS_GRP)
ema8Length = input.int(8, "8 EMA Length", group = CROSS_GRP)

// Calculate 8 EMA
ema8 = ta.ema(src, ema8Length)

// Detect crossovers
crossUp = ta.crossover(ema8, ema34)
crossDown = ta.crossunder(ema8, ema34)

// Check for bullish: cross up happened 1-3 bars ago AND we have 2 consecutive higher closes
// Added check to prevent duplicate signals
var bool recentBullish = false
bullishCondition = (crossUp[1] or crossUp[2] or crossUp[3]) and 
     close > close[1] and close[1] > close[2] and not recentBullish

// Check for bearish: cross down happened 1-3 bars ago AND we have 2 consecutive lower closes
// Added check to prevent duplicate signals
var bool recentBearish = false
bearishCondition = (crossDown[1] or crossDown[2] or crossDown[3]) and 
     close < close[1] and close[1] < close[2] and not recentBearish

// Update state variables
if bullishCondition
    recentBullish := true
if bearishCondition
    recentBearish := true

// Reset flags when opposite crossover occurs
if crossDown
    recentBullish := false
if crossUp
    recentBearish := false

// Plot arrows with text labels - YELLOW color for both directions
plotchar(showCrossovers and bullishCondition, title="Bullish Signal", 
     char="↑ Entry", location=location.belowbar, color=color.yellow, size=size.tiny)

plotchar(showCrossovers and bearishCondition, title="Bearish Signal", 
     char="↓ Exit", location=location.abovebar, color=color.yellow, size=size.tiny)
