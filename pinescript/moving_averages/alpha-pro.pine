// ════════════════════════════════════════════════════════════════════
// VARIABLES GLOBALES PARA ta.change() — evaluadas en CADA barra
// (Pine Script requiere que ta.change() se ejecute siempre;
//  no puede vivir dentro de una función llamada condicionalmente)
// ════════════════════════════════════════════════════════════════════


_chg_dayofweek = ta.change(dayofweek)
_chg_time_1D   = ta.change(time("1D"))

was_intraday_low(float src) =>
    varip float _day_low   = na
    varip bool  _was_low   = false

    // Reset al inicio de cada sesión diaria
    bool new_day = _chg_dayofweek != 0 or _chg_time_1D != 0

    if new_day
        _day_low := src
        _was_low := true
    else
        // Solo actualiza si src es menor — mínimo acumulado del día hasta t
        if src < _day_low
            _day_low := src
            _was_low := true
        else
            _was_low := false

    _was_low
bool low_was_intraday_low   = was_intraday_low(low)

was_intraday_high(float src) =>
    varip float _day_high  = na
    varip bool  _was_high  = false

    bool new_day = _chg_dayofweek != 0 or _chg_time_1D != 0

    if new_day
        _day_high := src
        _was_high := true
    else
        if src > _day_high
            _day_high := src
            _was_high := true
        else
            _was_high := false

    _was_high

bool high_was_intraday_high  = was_intraday_high(high)

// ── falsos ──────────────────────────────────────────────────────────

false_envolvente_buy   = Envolvente_buy and max4[2] 
                         and close < low[3] 
                         and not (low_was_intraday_low or low_was_intraday_low[1])
false_envolvente_sell  = Envolvente_sell and max4[2] 
                         and close > high[3]
                         and not (high_was_intraday_high or high_was_intraday_high[1])

no_valid_buy           = Envolvente_buy and Gap_S[1] 
                         and high > low[3]
                         and not (low_was_intraday_low or low_was_intraday_low[1])
                         and close < low[3]
no_valid_sell          = Envolvente_sell 
                         and Gap_B[1] and low < high[3]
                         and not (high_was_intraday_high or high_was_intraday_high[1])
                         and close  >  high[3]


