mecha_inferior_bear    = (low_var_bear * stdev_high_low) < body_var
no_mecha_igual_a_W_bear= high[2] < open and 
                         high[2] < close[1]
                         and high[3] < open 
                         and high[3] < close[1]

Envolvente_sell        = (bear and bull[1] and bull[2] 
                         and Propiedades_base_envolventes 
                         and close < low[1] 
                         and no_mecha_igual_a_W_bear 
