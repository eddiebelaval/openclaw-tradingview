//@version=6
// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  PRO MODEL — Boxes D+ / D− / J  (standalone)                                 ║
// ║  Activo    : Cualquiera con sesión NY                                        ║
// ║  Timeframe : Cualquiera intraday                                             ║
// ║  Versión   : v6  |  Overlay: true                                            ║
// ║  D+ / D−   : daily_open ± σ(mid_oc→high / mid_oc→low, 63 barras 1D)          ║
// ║  J-Buy/Sell: AM8 ± σ_daily/√8   (desv. 8-hour scaling)                       ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
indicator("Alpha-Pro", overlay = true, max_bars_back = 500)

// Velas neutras — cubren el 100% del chart para que el hover
// sea uniforme en todas las barras, eliminando el efecto diferencial
// sobre las señales Fast_1


// ── Señal Fast_1 encima — ahora hover es uniforme en todo el chart
// ══════════════════════════════════════════════════════════════════════════════
// TIEMPO
// ══════════════════════════════════════════════════════════════════════════════
t          = hour(time) * 100 + minute(time)
in_window  = (t >= 700) and (t <= 1650)
in_window3 = (t >= 800) and (t <= 1200)
is_new_day = ta.change(time("D")) != 0
minuto     = minute(time_close)

// Ventanas
ventana_15 = (minuto <= 20) or (minuto >= 45)
ventana_20 = (minuto <= 20) or (minuto >= 40)
ventana_star= (minuto <= 29) or (minuto >= 40)
ventana_ENVOLVENTES = (minuto <= 15) or (minuto >= 42)

Ventana_special = not na(time(timeframe.period, "0929-0936", "America/New_York"))
ny_open_special= ventana_15 or Ventana_special

// Rangos
noche =    (t  >= 2200) or  (t < 600)
noche_2 =  (t >= 745) and (t < 930)
dia =      (t >= 930) and (t < 1800)
ny = (t >= 930)


// Condición final
TDI = ventana_15 or Ventana_special
TDI_ENV = ventana_ENVOLVENTES or  Ventana_special
Tdi_star_model=ventana_star




// ══════════════════════════════════════════════════════════════════════════════
// APERTURAS DE SESIÓN
// ══════════════════════════════════════════════════════════════════════════════
var float daily_open      = na
var float electronic_open = na
var float AM8             = na
var float lastDay         = na

if is_new_day
    daily_open := open

currentDay = dayofweek(time)
if na(lastDay) or currentDay != lastDay
    electronic_open := na
    AM8             := na
    lastDay         := currentDay

if t == 100 and na(electronic_open)
    electronic_open := open
if t == 700 and na(AM8)
    AM8 := open

// ══════════════════════════════════════════════════════════════════════════════
// PARAMETROS ESTADISTICOS
// ══════════════════════════════════════════════════════════════════════════════
bull = close > open
bear = close < open
body_var     = math.abs((close / open) - 1) * 100

tiempo= 126
trimestre=126

stdev_high     = request.security(syminfo.tickerid, "1D", 
                 ta.stdev((high != 0 ? ((close[1] + open) / 2 - high) / high * 100 : 0), 
                 tiempo), lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)

stdev_low      = request.security(syminfo.tickerid, "1D", 
                 ta.stdev((low != 0 ? ((close[1] + open) / 2 - low) / low * 100 : 0), 
                 tiempo), lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)

stdev_daily    = request.security(syminfo.tickerid, "1D", 
                 ta.stdev((((close[1] + open) / 2) != 0 ? 
                 (((close[1] + open) / 2) - ((close[2] + open[1]) / 2)) / ((close[2] + open[1]) / 2) * 100 : 0), 
                 trimestre), lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)

std_8          = stdev_daily / math.sqrt(8)
K              = stdev_daily/10
stdev_high_low = stdev_high + stdev_low

multiplicacion_stdev_low_high= stdev_low*stdev_high


min_0_01       = body_var[1]> K/10
sdt_dhl_2      = stdev_high_low/2
promedio_stdev_high_low = stdev_high_low/2

float stdev_min = math.min(stdev_low, stdev_high)
float stdev_max = math.max(stdev_low, stdev_high)

compensacion   = math.pow(stdev_daily,2)/stdev_min 
x_periodos_MA  = (stdev_daily/stdev_min) / (stdev_max/10)*compensacion
RSI_periods    = x_periodos_MA - math.pow(compensacion,2)

// ══════════════════════════════════════════════════════════════════════════════
// mediamovil acelerada
// ══════════════════════════════════════════════════════════════════════════════
cap_len   = input.int(120, "Cap longitud máxima HMA",     minval=10, maxval=300,
             tooltip="Límite superior de lengthC_azul para controlar costo O(n) del loop")

// ── max_bars_back explícito ──────────────────────────────────────
max_bars_back(close, 500)
max_bars_back(open,  500)
max_bars_back(high,  500)
max_bars_back(low,   500)


float c_raw = math.pow(stdev_daily,2)/stdev_min //xauusnq - stdev_min



x= (stdev_daily/stdev_min) / (stdev_max/10)*c_raw
float x_raw = x

// Último x válido — propagación pura, sin constante de arranque
var float x_last = na
if not na(x_raw)
    x_last := x_raw
float x_safe = x_last   // na hasta que llegue el primer valor real






var float c_last = na
if not na(c_raw)
    c_last := math.max(0.1, c_raw)   // 0.1 es piso físico, no arbitrario
float c = c_last

// ── conversión a int ────────────────────────────────────────────
int lengthC_azul = na(x_safe) ? na : math.max(2, math.min(cap_len, math.round(x_safe)))
int sqrt_len     = na(lengthC_azul) ? na : math.max(2, math.round(math.sqrt(float(lengthC_azul))))

// ════════════════════════════════════════════════════════════════════
// BLOQUE 4 — WMA MANUAL CON LONGITUD DINÁMICA
// WMA(src,n) = Σ_{i=0}^{n-1} (n-i)·src[i]  /  Σ_{i=0}^{n-1}(n-i)
// ════════════════════════════════════════════════════════════════════
wma_dyn(float src, int len) =>
    int   n      = math.max(2, len)
    float sum_w  = 0.0
    float sum_wx = 0.0
    for i = 0 to n - 1
        float w  = float(n - i)
        sum_w   += w
        sum_wx  += w * nz(src[i])
    sum_wx / sum_w

// ════════════════════════════════════════════════════════════════════
// BLOQUE 5 — HMA MANUAL CON LONGITUD DINÁMICA
// HMA(src,n) = WMA( 2·WMA(src,⌊n/2⌋) − WMA(src,n), ⌊√n⌋ )
// ════════════════════════════════════════════════════════════════════
hma_dyn(float src, int len) =>
    int   n      = math.max(2, len)
    int   half_n = math.max(1, math.round(float(n) / 2.0))
    int   sqrtn  = math.max(2, math.round(math.sqrt(float(n))))
    float w1     = wma_dyn(src, half_n)
    float w2     = wma_dyn(src, n)
    float raw    = 2.0 * w1 - w2
    wma_dyn(raw, sqrtn)

// ════════════════════════════════════════════════════════════════════
// BLOQUE 6 — EMA DINÁMICA RECURSIVA
// α_t = 2 / (sqrt_len_t + 1)   — α varía barra a barra
// ════════════════════════════════════════════════════════════════════
var float _ema_final = na
float alpha_t = na(sqrt_len) ? na : 2.0 / (float(sqrt_len) + 1.0)

// ════════════════════════════════════════════════════════════════════
// BLOQUE 7 — PIPELINE HMA ACELERADA
// pseudoCMA_t = HMA_t + c_t · (HMA_t − HMA_{t-1})
//              ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//              c_t = (stdev_daily×2) − σ_min  [flotante, no constante]
// ════════════════════════════════════════════════════════════════════
float hma_C_azul     = na(lengthC_azul) ? na : hma_dyn(hlc3, lengthC_azul)
float slope_azul     = hma_C_azul - hma_C_azul[1]
float pseudoCMA_azul = na(c) ? na : hma_C_azul + c * slope_azul

_ema_final := na(_ema_final)    ? pseudoCMA_azul         : na(alpha_t)       ? _ema_final           : na(pseudoCMA_azul)? _ema_final           : alpha_t * pseudoCMA_azul + (1.0 - alpha_t) * _ema_final

float final_azul = _ema_final
float MA_HULL    = _ema_final

// ════════════════════════════════════════════════════════════════════
// BLOQUE 8 — VISUALIZACIÓN
// ════════════════════════════════════════════════════════════════════
color col_hull = MA_HULL > MA_HULL[1] ? color.new(#121212, 0)
                                      : color.new(#151515, 0)

plot(MA_HULL,    "HMA σ-Adaptativa", color=col_hull,                      linewidth=2)


// ════════════════════════════════════════════════════════════════════
// BLOQUE 9 — TABLA DE ESTADO
// ════════════════════════════════════════════════════════════════════
var table tbl = table.new(
     position.top_right, 2, 8,
     bgcolor      = color.new(color.black, 65),
     border_width = 1,
     border_color = color.new(color.white, 60))

if barstate.islast
    table.cell(tbl, 0, 0, "Parámetro",
               text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue,40))
    table.cell(tbl, 1, 0, "Valor",
               text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue,40))

    table.cell(tbl, 0, 1, "x  (float)",         text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 1, str.tostring(nz(x_safe), "#.0000"),
               text_color=color.yellow, text_size=size.small)

    table.cell(tbl, 0, 2, "lengthC_azul",        text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(nz(lengthC_azul)),
               text_color=color.aqua,   text_size=size.small)

    table.cell(tbl, 0, 3, "√length  (EMA)",      text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(nz(sqrt_len)),
               text_color=color.aqua,   text_size=size.small)

    table.cell(tbl, 0, 4, "c  (phase comp)",     text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 4, str.tostring(nz(c), "#.0000"),
               text_color=color.orange, text_size=size.small)

    table.cell(tbl, 0, 5, "stdev_daily",         text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 5, str.tostring(stdev_daily, "#.0000"),
               text_color=color.fuchsia,text_size=size.small)

    table.cell(tbl, 0, 6, "σ_high",              text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 6, str.tostring(stdev_high, "#.0000"),
               text_color=color.lime,   text_size=size.small)

    table.cell(tbl, 0, 7, "σ_low",               text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 7, str.tostring(stdev_low, "#.0000"),
               text_color=color.lime,   text_size=size.small)

// ══ TABLA DE CALIBRACIÓN ═════════════════════════════════════════
// ┌──────────────────┬────────────────────────────────────────────┐
// │ Parámetro        │ Derivación                                  │
// ├──────────────────┼────────────────────────────────────────────┤
// │ lengthC_azul     │ (σ_low·σ_high − σ_min/10) × 100  [series] │
// │ c  (phase comp)  │ stdev_daily×2 − σ_min            [series] │
// │ sqrt_len         │ ⌊√lengthC_azul⌋                  [series] │
// │ alpha_t  (EMA)   │ 2 / (sqrt_len + 1)               [series] │
// │ cap_len          │ 120  [tope O(n) del loop WMA]    [input]  │
// └──────────────────┴────────────────────────────────────────────┘


















// ════════════════════════════════════════════════════════════════════
// @description : RSI GARCH(1,1)–HAR–Student-t σ-Adaptativo
// @math_basis  :
//   σ_min_t  = min(σ_low_t, σ_high_t)
//   σ_max_t  = max(σ_low_t, σ_high_t)
//   comp_t   = σ_d² / σ_min_t
//   x_t      = (σ_d/σ_min) / (σ_max/10) × comp_t
//   n_t      = x_t − comp_t²                         → rsi_n (series int)
//   ε_t      = ΔS_t
//   σ²_t     = ω + α·ε²_{t-1} + β·σ²_{t-1}          GARCH(1,1) ω=2e-6 α=0.10 β=0.85
//   z_t      = (ε_t/σ_t)·√((ν-2)/ν)                 t-Student ν=5, burn-in 100 barras
//   RMA_t(n) = (1/n)·z_t + (1-1/n)·RMA_{t-1}        Wilder α_t=1/n_t dinámico
//   seed_sym = (μ̂_up + μ̂_dn)/2  →  RMA_up₀=RMA_dn₀  →  RSI₀=50 exacto
//   up_HAR   = Σ φ_h·RMA(max(z,0), n_h)              h∈{D,W=5n,M=22n} φ=[0.40,0.35,0.25]
//   dn_HAR   = Σ φ_h·RMA(max(-z,0), n_h)
//   RSI_t    = 100 − 100/(1 + up_HAR/dn_HAR)
// ════════════════════════════════════════════════════════════════════


// ── INPUTS ────────────────────────────────────────────────────────
int   cap_rsi   = input.int(200, "Cap períodos base RSI",       minval=2,  maxval=500)
float rsiSrc    = input.source(hlc3, "Fuente RSI")

max_bars_back(close, 500)
max_bars_back(open,  500)
max_bars_back(high,  500)
max_bars_back(low,   500)



// ════════════════════════════════════════════════════════════════════
// BLOQUE 2 — DERIVACIÓN n_t  (RSI_periods → rsi_n)
//
// σ_min_t  = min(σ_low_t, σ_high_t)
// σ_max_t  = max(σ_low_t, σ_high_t)
// comp_t   = σ_d_t² / σ_min_t                          razón cuadrática normalizada
// x_t      = (σ_d_t/σ_min_t) / (σ_max_t/10) × comp_t  = 10·σ_d·comp / (σ_min·σ_max)
// n_raw_t  = x_t − comp_t²
// rsi_n_t  = clamp( round(n_raw_t), 2, cap_rsi )       series int
//
// Propagación: var en scope raíz — `:=` válido en cualquier rama (fix syntax v6)
// ════════════════════════════════════════════════════════════════════

// comp_t = σ_d² / σ_min  — protegido contra σ_min=0
float comp = stdev_min > 0.0 ? math.pow(stdev_daily, 2) / stdev_min : na

// x_t — protegido contra na y denominadores nulos
float x_per = na
x_per := (not na(comp) and stdev_min > 0.0 and stdev_max > 0.0)
         ? (stdev_daily / stdev_min) / (stdev_max / 10.0) * comp
         : na

// n_raw_t = x_t − comp_t²
float n_raw = na
n_raw := (not na(x_per) and not na(comp))
         ? x_per - math.pow(comp, 2)
         : na

// Propagación último valor válido — sin fallback constante
var float n_last = na
if not na(n_raw) and n_raw > 0.0
    n_last := n_raw

// rsi_n_t ∈ ℤ⁺,  clamp [2, cap_rsi]


int rsi_n = na
rsi_n := na(n_last) ? na : math.max(2, math.min(cap_rsi, math.round(n_last)))
//salida matematica final


// ════════════════════════════════════════════════════════════════════
// BLOQUE 3 — GARCH(1,1) CON BURN-IN EXPLÍCITO
//
// ε_t    = S_t − S_{t-1}                               innovación de precio
// σ²_t   = ω + α·ε²_{t-1} + β·σ²_{t-1}               GARCH(1,1)
//          ω=2×10⁻⁶,  α=0.10,  β=0.85,  α+β=0.95<1   covarianza estacionaria
// σ²_∞   = ω/(1−α−β) = 4×10⁻⁵                         varianza incondicional
//
// Normalización de seguridad si α+β ≥ 1:
//   α* = α·(0.9995/(α+β)),  β* = β·(0.9995/(α+β))
//
// Burn-in: N_BURNIN=100 barras
//   τ = ln(0.5)/ln(0.95) ≈ 13.5 barras (vida media GARCH)
//   100 barras ≈ 7.4·τ  →  convergencia >99%
//   z_t := na durante burn-in  →  acumuladores HAR no contaminados
// ════════════════════════════════════════════════════════════════════

int N_BURNIN = 100   // burn-in = 7× vida media GARCH — derivado analíticamente

var int bar_idx = 0
bar_idx += 1

// ε_t = ΔS_t
float eps = ta.change(rsiSrc)

// Normalización α*+β* < 1
float a_raw  = 0.10
float b_raw  = 0.85
float ab_sum = a_raw + b_raw
float a_s    = ab_sum >= 1.0 ? a_raw * (0.9995 / ab_sum) : a_raw
float b_s    = ab_sum >= 1.0 ? b_raw * (0.9995 / ab_sum) : b_raw

// σ²_∞ = ω / max(1−α*−β*, 1e-6)
float v_unc = 0.000002 / math.max(1.0 - a_s - b_s, 1e-6)

// σ²_t = max( ω + α*·ε²_{t-1} + β*·σ²_{t-1},  1×10⁻¹² )
var float sig2 = na
sig2 := math.max(   0.000002 + a_s * math.pow(nz(eps[1], 0.0), 2) + b_s * nz(sig2[1], v_unc), 1e-12)

// ════════════════════════════════════════════════════════════════════
// BLOQUE 4 — INNOVACIÓN ESTANDARIZADA t-STUDENT ν=5
//
// z_t = (ε_t / σ_t) · √((ν-2)/ν)
//       √(3/5) ≈ 0.7746  →  Var(z_t)=1 bajo t(ν=5)
//
// z_t := na durante bar_idx ≤ N_BURNIN
//   up_z_t = max( z_t, 0)   innovaciones alcistas
//   dn_z_t = max(−z_t, 0)   innovaciones bajistas
// ════════════════════════════════════════════════════════════════════

// √((ν-2)/ν) = √(3/5) ≈ 0.7746
float scale_t = math.sqrt(3.0 / 5.0)

// z_t — na durante burn-in GARCH
float z_t = na
z_t := (bar_idx > N_BURNIN and math.sqrt(sig2) > 0.0)
       ? (eps / math.sqrt(sig2)) * scale_t
       : na

float up_z = na(z_t) ? na : math.max( z_t, 0.0)
float dn_z = na(z_t) ? na : math.max(-z_t, 0.0)

// ════════════════════════════════════════════════════════════════════
// BLOQUE 4b — SEMILLA SIMÉTRICA  (corrección de sesgo de inicialización)
//
// Problema: seed asimétrica up_z₀ ≠ dn_z₀ contamina RMA mensual
//   τ_contaminación ≈ n_M·ln2 = rsi_n·22·0.693 ≈ rsi_n·15 barras
//   Con rsi_n=50  →  ~750 barras de RSI degenerativo
//
// Solución: acumular μ̂_up y μ̂_dn mientras rsi_n es na y z_t es válido
//   seed_sym = (μ̂_up + μ̂_dn) / 2
//   →  RMA_up₀ = RMA_dn₀ = seed_sym
//   →  up_HAR₀ = dn_HAR₀
//   →  RSI₀ = 100 − 100/(1+1) = 50 exactamente
//
// Valor teórico si n_acc=0:
//   E[max(z,0)] bajo t(ν=5)·√(3/5) = scale_t·f_{t(5)}(0)·√(5π)·Γ(2.5)/Γ(3)/2
//                                   ≈ 0.7746 × 0.3796 / 2 ≈ 0.1469
// ════════════════════════════════════════════════════════════════════

// SEED_TH: E[max(z,0)] teórico bajo t(ν=5) escalada — piso si n_acc=0
float SEED_TH = scale_t * 0.3796 / 2.0   // ≈ 0.1469

var float acc_up = 0.0
var float acc_dn = 0.0
var int   n_acc  = 0

// Acumular media muestral durante warm-up natural (rsi_n aún na, z_t ya convergido)
if na(rsi_n) and not na(up_z)
    acc_up += up_z
    acc_dn += dn_z
    n_acc  += 1

// μ̂_up, μ̂_dn — media muestral o teórica
float mu_up  = n_acc > 0 ? acc_up / n_acc : SEED_TH
float mu_dn  = n_acc > 0 ? acc_dn / n_acc : SEED_TH

// seed_sym: simetría forzada → RSI₀ = 50
float seed_s = (mu_up + mu_dn) / 2.0

// ════════════════════════════════════════════════════════════════════
// BLOQUE 5 — RMA DINÁMICA RECURSIVA × 6 ESTADOS HAR
//
// RMA_t(n_t) = (1/n_t)·z_t + (1 − 1/n_t)·RMA_{t-1}
//            = α_t·z_t + (1−α_t)·RMA_{t-1}    α_t = 1/n_t
//
// α_t varía barra a barra → operador causal no-LTI
// (única implementación causal con período flotante)
//
// Horizontes HAR:
//   n_D = rsi_n          α_D = 1/n_D
//   n_W = rsi_n × 5      α_W = 1/n_W
//   n_M = rsi_n × 22     α_M = 1/n_M
//
// Inicialización: t=t_seed → RMA_up_h = RMA_dn_h = seed_sym ∀h
//                 →  RSI₀ = 50  (estado neutral garantizado)
// rma_cnt: contador post-seed para guard de convergencia (bloque 6)
// ════════════════════════════════════════════════════════════════════

var float rma_up_d = na
var float rma_dn_d = na
var float rma_up_w = na
var float rma_dn_w = na
var float rma_up_m = na
var float rma_dn_m = na
var bool  seeded   = false
var int   rma_cnt  = 0

if not na(rsi_n) and not na(up_z)
    if not seeded
        // Inicialización simétrica — una sola vez
        rma_up_d := seed_s
        rma_dn_d := seed_s
        rma_up_w := seed_s
        rma_dn_w := seed_s
        rma_up_m := seed_s
        rma_dn_m := seed_s
        seeded   := true
    else
        rma_cnt += 1

        // α_D = 1/n_D,  n_D = rsi_n
        float ad = 1.0 / float(rsi_n)
        rma_up_d := ad * up_z + (1.0 - ad) * rma_up_d
        rma_dn_d := ad * dn_z + (1.0 - ad) * rma_dn_d

        // α_W = 1/n_W,  n_W = rsi_n × 5
        int   nw = math.max(2, rsi_n * 5)
        float aw = 1.0 / float(nw)
        rma_up_w := aw * up_z + (1.0 - aw) * rma_up_w
        rma_dn_w := aw * dn_z + (1.0 - aw) * rma_dn_w

        // α_M = 1/n_M,  n_M = rsi_n × 22
        int   nm = math.max(2, rsi_n * 22)
        float am = 1.0 / float(nm)
        rma_up_m := am * up_z + (1.0 - am) * rma_up_m
        rma_dn_m := am * dn_z + (1.0 - am) * rma_dn_m

// ════════════════════════════════════════════════════════════════════
// BLOQUE 6 — AGREGACIÓN HAR + RSI FINAL
//
// φ = [φ_D=0.40, φ_W=0.35, φ_M=0.25],  Σφ = 1.00  (pesos HAR normalizados)
//
// up_HAR_t = φ_D·RMA_up_D + φ_W·RMA_up_W + φ_M·RMA_up_M
// dn_HAR_t = φ_D·RMA_dn_D + φ_W·RMA_dn_W + φ_M·RMA_dn_M
//
// RSI_t = 100 − 100 / (1 + up_HAR_t / dn_HAR_t)
//
// Casos degenerados:
//   dn_HAR_t = 0  →  RSI_t = 100
//   up_HAR_t = 0  →  RSI_t = 0
//
// Guard de convergencia:
//   rma_cnt ≥ rsi_n  (≥ 1 vida media filtro diario τ_D = n_D·ln2)
//   RSI := na durante warm-up — nunca emite valor degenerativo
//
// nz() eliminado — na se propaga limpiamente, nunca fuerza 0 asimétrico
// ════════════════════════════════════════════════════════════════════

// φ_D=0.40, φ_W=0.35, φ_M=0.25  — Σφ = 1.00
float phi_d = 0.40
float phi_w = 0.35
float phi_m = 0.25

// Guard: seeded + convergencia mínima + todos los acumuladores válidos
bool valid = seeded
          and not na(rsi_n)
          and rma_cnt >= math.max(5, rsi_n)
          and not na(rma_up_d) and not na(rma_dn_d)
          and not na(rma_up_w) and not na(rma_dn_w)
          and not na(rma_up_m) and not na(rma_dn_m)

// up_HAR_t = φ_D·RMA_up_D + φ_W·RMA_up_W + φ_M·RMA_up_M
float up_har = valid ? phi_d*rma_up_d + phi_w*rma_up_w + phi_m*rma_up_m : na

// dn_HAR_t = φ_D·RMA_dn_D + φ_W·RMA_dn_W + φ_M·RMA_dn_M
float dn_har = valid ? phi_d*rma_dn_d + phi_w*rma_dn_w + phi_m*rma_dn_m : na

// RSI_t = 100 − 100/(1 + up_HAR_t/dn_HAR_t)
float rsi = na
rsi := na(up_har) or na(dn_har) ? na
     : dn_har == 0.0             ? 100.0
     : up_har == 0.0             ?   0.0
     : 100.0 - (100.0 / (1.0 + up_har / dn_har))

// ════════════════════════════════════════════════════════════════════
// BLOQUE 7 — SEÑALES Y DIVERGENCIAS  (post-RSI — sin efecto en cálculo)
//
// buy_rsi  : RSI_t < 50   momentum negativo dominante
// sell_rsi : RSI_t > 50   momentum positivo dominante
//
// Divergencia alcista regular:
//   PL en barra lookbackRight atrás
//   RSI[lookbackRight] > RSI en PL anterior
//   low[lookbackRight] < low en PL anterior
//   lookbackLeft ≤ barssince(PL anterior) ≤ rangeUpper
//
// Divergencia bajista regular:
//   PH en barra lookbackRight atrás
//   RSI[lookbackRight] < RSI en PH anterior
//   high[lookbackRight] > high en PH anterior
//   lookbackLeft ≤ barssince(PH anterior) ≤ rangeUpper
// ════════════════════════════════════════════════════════════════════

// ── INCORRECTO — evalúa a φ/2 ≈ 0.809 ───────────────────────────
// margen_aureo = math.abs((1 - math.phi) - 1) / 2

// ── CORRECTO — evalúa a (2−φ)/2 ≈ 0.191 ─────────────────────────
// Derivación: (1 − 1/φ)/2 = (2 − φ)/2  [prop. φ: 1/φ = φ − 1]
float margen_aureo = (2.0 - math.phi) / 2.0   // ≈ 0.19098 → umbral ≈ 51.91

bool buy_rsi  = not na(rsi) and rsi <= 50.0 + margen_aureo * 10.0  // ≤ 51.91
bool sell_rsi = not na(rsi) and rsi >= 50.0 - margen_aureo * 10.0  // ≥ 48.09

bool buy_rsi_liquidity  = not na(rsi) and rsi <= 50.0   
bool sell_rsi_liquidity = not na(rsi) and rsi >= 50.0 
// ════════════════════════════════════════════════════════════════════














