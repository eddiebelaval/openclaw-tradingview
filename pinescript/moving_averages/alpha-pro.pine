             //    and not no_var_solo_opens



Pimbars_v2 = v2_entry_buy or v2_entry_sell

plotcandle(Pimbars_v2 ? open  : na,
           Pimbars_v2 ? high  : na,
           Pimbars_v2 ? low   : na,
           Pimbars_v2 ? close : na,
           "Pimbars_v2",
           color       = color.new(#00d5ff, 0),
           bordercolor = color.new(#0c7dff, 0),
           wickcolor   = color.new(#0087ef, 0),
           force_overlay = true)
//barcolor(Pimbars_v2? color.new(#0186bf, 0): na)


medium_body_var = body_var / stdev_min
pim= body_var * (math.pow(stdev_daily,math.sqrt(RSI_periods)))
 

Pimbar_buy_real  = max4[1] and  pinbar_buy 
                   and  (gap_tamano_bear[0]) > pim 
                   and Gap_S
                   and low_var_bull >  medium_body_var

pimbar_sell_real = max4[1] and pinbar_sell 
                   and (gap_tamano_bull[0]) > pim 
                   and Gap_B
                   and high_var_bear >  medium_body_var

Pimbars_reales = Pimbar_buy_real or pimbar_sell_real

plotcandle(Pimbars_reales ? open  : na,
           Pimbars_reales ? high  : na,
           Pimbars_reales ? low   : na,
           Pimbars_reales ? close : na,
           "Pimbars reales",
           color       = color.new(#07e2ff, 0),
           bordercolor = color.new(#1174ff, 0),
           wickcolor   = color.new(#0783ff, 0),
           force_overlay = true)
//barcolor(Pimbars_reales? color.new(#07c1ff, 0): na)





twin_buy_pimbar   = (pinbar_buy 
                   and close > high[1] 
                   and not paint[2] 
                   and min_0_01
                   and Parameters_base_pimbars
                   and not no_var)

twin_sell_pimbar  = (pinbar_sell 
                   and close <  low[1]  
                   and not paint[2] 
                   and not no_var 
                   and min_0_01
                   and Parameters_base_pimbars)

twins_pimbars = twin_buy_pimbar or twin_sell_pimbar

plotcandle(twins_pimbars ? open  : na,
           twins_pimbars ? high  : na,
           twins_pimbars ? low   : na,
           twins_pimbars ? close : na,
           "Twins pimbars",
           color       = color.new(#00f2ff, 0),
           bordercolor = color.new(#007bff, 0),
           wickcolor   = color.new(#0095ff, 0),
           force_overlay = true)
barcolor(twins_pimbars? color.new(#00f2ff, 0): na)





////////////////////////////// FAST CANDLE BLUE
envelop= body_var > body_var[1]

body_4= body_var*4
body_var_4 = body_var * (op+hi+lo+cl)
oc_igual= open==close



fast_b     = (envolvente[2]) 
             and bull[2] and bear[1] and bull 
             and body_var_4[1] < body_var
             and buy_rsi[2] and Propiedades_base_envolventes
             and open > MA_HULL
             and close > high[1] 
             and close > high[2] 
             and close > high[3] 
             and not oc_igual[1] 
             and not max4[3] 
             and Parameters_base_fast
             and  TDI_ENV 

fast_s     = (envolvente[2]) 
             and bear[2] and bull[1] and bear
             and body_var_4[1] < body_var
             and sell_rsi[2] and Propiedades_base_envolventes
             and open <  MA_HULL
             and close < low[1] 
             and close < low[2] 
             and close < low[3] 
             and not oc_igual[1] 
             and not max4[3] 
             and Parameters_base_fast 
             and TDI_ENV

Fast_1 = fast_b or fast_s

// ── barcolor: cuerpo nativo hover-stable ─────────────────────────
//barcolor(fast_b ? color.new(#3808f6, 0) : na)
//barcolor(fast_s ? color.new(#4a0dff, 0) : na)

// ── plotcandle: borde + mecha diferenciados, force_overlay=true ──
// Al venir de pane externo + force_overlay, el hover del chart
// principal no intercepta este objeto → color estable
plotcandle(Fast_1 ? open  : na,
           Fast_1 ? high  : na,
           Fast_1 ? low   : na,
           Fast_1 ? close : na,
           "Fast Model 1",
           color       = fast_b ? color.new(#4600c8, 0)
                                : color.new(#860dff, 0),
           bordercolor = color.new(#993aff, 0),
           wickcolor   = fast_b ? color.new(#e347ff, 0)
                                : color.new(#c83bff, 0),
           force_overlay = true)   // ← CLAVE: inyección al chart principal

/////////////FAST CANDLE BLUE 2
envelop2= body_var[2] > body_var[3]



fast_b2    = (envolvente[2]) 
             and buy_rsi[2] and Propiedades_base_envolventes
             and close > high[1]  
             and not max4[3] 
             and bull and bear[1] and bull[2] and bear[3] 
             and low[4]  >  close[3]
             and not oc_igual[1]
             and Parameters_base_fast 
             and  TDI_ENV

fast_s2    = envolvente[2] 
             and sell_rsi[2] and Propiedades_base_envolventes
             and close <  low[1]  
             and not max4[3] 
             and bear and bull[1] and bear[2] and bull[3] 
             and high[4] <  close[3]
             and not oc_igual[1]
             and Parameters_base_fast 
             and TDI_ENV

Fast_2 = fast_b2 or fast_s2

plotcandle(Fast_2 ? open  : na,
           Fast_2 ? high  : na,
           Fast_2 ? low   : na,
           Fast_2 ? close : na,
           "Fast Model 2",
           color       = color.new(#ff00d0, 0),
           bordercolor = color.new(#c50070, 0),
           wickcolor   = color.new(#ff38d0, 0),
           force_overlay = true)
//barcolor(Fast_2?  color.new(#ff00ea, 0): na)

//////gap falso e invalido para ifvg


Gap_B_false      = bull[1] and max4[1] 
                   and (body_var[1] > promedio_stdev_high_low)
                   and var_gap_[0]

Gap_S_false      = bear[1] and max4[1] 
                   and (body_var[1] > promedio_stdev_high_low)
                   and var_gap_[0]

color_gap_false= color.rgb(151, 0, 93, 24)
barcolor(
     Gap_B_false or Gap_S_false ? color_gap_false : na,
     offset = -1)





//si agregar este dia lunes 9 de febrero

body_var_openny    = body_var*math.pi
mini_liquidity_buy = (bear[1] and bull 
                    and envolvente 
                    and (body_var_openny < low_var_bull) 
                    and open[1] < close
                    and close == high
                    and low < MA_HULL
                    and TDI_ENV)

mini_liquidity_sell =(bull[1] and bear 
                     and envolvente
                     and body_var_openny <  high_var_bear
                     and open[1] > close
                     and close == low
                     and high > MA_HULL 
                     and TDI_ENV)

minis = mini_liquidity_buy or mini_liquidity_sell

plotcandle(minis ? open  : na,
           minis ? high  : na,
           minis ? low   : na,
           minis ? close : na,
           "Minis",
           color       = color.new(#0088ff, 0),
           bordercolor = color.new(#005fc5, 0),
           wickcolor   = color.new(#3877ff, 0),
           force_overlay = true)

//am30_b= paint and low[0] <  low [1] and low[0] <  low[2] and low <  low[3] and low <  low[4]       and body_var >  body_var[1] and bull and bear [1] and bear [2] and low_var >  body_var and ny_open_special
//am30_s= paint and high > high[1] and high > high[2] and high > high[3] and high > high[4]      and body_var >  body_var[1] and bear and bull[1] and bull[2] and high_var >  body_var and ny_open_special





//envolvente seca

notseca_buy = bear[2] and bear[1] and bull and high[1] > close 
notseca_sell = bull[2] and bull[1] and bear and low[1] < close 



seca_buy = (bull and bear[1]) 
         and low == open
         and Propiedades_base_envolventes_secas
         and low[1] < MA_HULL   // and open < MA_HULL
         and not notseca_buy
         and not no_mecha_closes[1]  
         
//.         ORIGINALMENTE ESTE NO TENE CONDICION DE RSI

seca_sell= bear and bull[1]
         and high == open
         and Propiedades_base_envolventes_secas
         and high[1] > MA_HULL  //and open > MA_HULL
         and not notseca_sell
         and not no_mecha_closes[1]  
         
//.         ORIGINALMENTE ESTE NO TENE CONDICION DE RSI

Secas= seca_buy or seca_sell

plotcandle(Secas ? open  : na,
           Secas? high  : na,
           Secas ? low   : na,
           Secas ? close : na,
           "Seca",
           color       = color.new(#ce2dff, 0),
           bordercolor = color.new(#ad41ff, 0),
           wickcolor   = color.new(#d555ff, 0),
           force_overlay = true)
barcolor(Secas?  color.new(#5d00ff, 0): na)











// ── Candle sintética hover-stable en bar t-1 ─────────────────────
// Detectamos la condición en t, dibujamos en bar_index-1 (= barra t-1)
// equivalencia exacta con barcolor(cond, offset=-1)
//
// max_boxes_count y max_lines_count declarados en indicator()
// indicator(..., max_boxes_count=500, max_lines_count=500)

barcolor(Gap_B or Gap_S ? color.rgb(10, 10, 10) : na, offset=-1)



barcolor(GAP_BUY ? color.rgb(0, 34, 93) : na, offset=-1)
barcolor(GAP_SELL ? color.rgb(59, 0, 111) : na, offset=-1)
















































































































// ══════════════════════════════════════════════════════════════════════════════
// ══════════════════════════════════════════════════════════════════════════════
// ══════════════════════════════════════════════════════════════════════════════
//
//                SDTS DINAMICAS PARA CADA ACTIVO
//
// ══════════════════════════════════════════════════════════════════════════════
// ══════════════════════════════════════════════════════════════════════════════
// ══════════════════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════════════════
// NIVELES DE PRECIO DE CADA BOX
// ══════════════════════════════════════════════════════════════════════════════
// D+  — zona alcista desde daily_open escalada por σ vs high
// ══════════════════════════════════════════════════════════════════════════════
// NIVELES DE PRECIO DE CADA BOX
// ══════════════════════════════════════════════════════════════════════════════
d_plus_up = daily_open * (1 + (stdev_high - K/2) / 100)
d_plus_lo = daily_open * (1 + (stdev_high + K/2) / 100)

d_min_up  = daily_open * (1 - (stdev_low + K/2) / 100)
d_min_lo  = daily_open * (1 - (stdev_low - K/2) / 100)

AM8_b_up = AM8 * (1 + (std_8 - K/2) / 100)
AM8_b_lo = AM8 * (1 + (std_8+ K/2 )/ 100)
AM8_s_up = AM8 * (1 - (std_8+ K/2)/ 100)
AM8_s_lo = AM8 * (1 - (std_8 - K/2) / 100)

// ══════════════════════════════════════════════════════════════════════════════
// AREAS DE DESVIACION
// ══════════════════════════════════════════════════════════════════════════════
show_zones = input.bool(true,  "Mostrar Zonas D+ / D− / J",         group = "Zonas")
col_brd    = input.color(color.rgb(160, 160, 160), "Borde D+ / D−", group = "Zonas")
col_brd_j  = input.color(color.rgb(100,  40, 255), "Borde J",       group = "Zonas")

_col_zone   = color.new(#eeeeee, 89)
_col_zone_j = color.new(#5500ff, 69)
_col_lbl    = color.rgb( 90,  90,  90)
_col_lbl_j  = color.rgb( 90,  20, 220)
_lbl_off    = 2

_txt_dp = str.tostring(stdev_high,      "#.###")
_txt_dm = str.tostring(stdev_low,       "#.###")
_txt_j  = str.tostring(std_8, "#.###")

// Proyección fija de 5 barras adelante del bar actual, independiente del TF
_fwd = 5

// ══════════════════════════════════════════════════════════════════════════════
// RASTREO BORDE IZQUIERDO DE VENTANA
// ══════════════════════════════════════════════════════════════════════════════
var int  win_left   = na
var int  win3_left  = na
var bool _prev_win  = false
var bool _prev_win3 = false

if is_new_day
    win_left   := na
    win3_left  := na
    _prev_win  := false
    _prev_win3 := false

if in_window and not _prev_win
    win_left := bar_index
if in_window3 and not _prev_win3
    win3_left := bar_index

_prev_win  := in_window
_prev_win3 := in_window3

// ══════════════════════════════════════════════════════════════════════════════
// OBJETOS PERSISTENTES
// ══════════════════════════════════════════════════════════════════════════════
var box   bx_dp = na
var box   bx_dm = na
var box   bx_jb = na
var box   bx_js = na
var label lb_dp = na
var label lb_dm = na
var label lb_jb = na
var label lb_js = na

// ══════════════════════════════════════════════════════════════════════════════
// LIMPIEZA DIARIA
// ══════════════════════════════════════════════════════════════════════════════
if is_new_day
    if not na(bx_dp)
        box.delete(bx_dp)
        bx_dp := na
    if not na(bx_dm)
        box.delete(bx_dm)
        bx_dm := na
    if not na(bx_jb)
        box.delete(bx_jb)
        bx_jb := na
    if not na(bx_js)
        box.delete(bx_js)
        bx_js := na
    if not na(lb_dp)
        label.delete(lb_dp)
        lb_dp := na
    if not na(lb_dm)
        label.delete(lb_dm)
        lb_dm := na
    if not na(lb_jb)
        label.delete(lb_jb)
        lb_jb := na
    if not na(lb_js)
        label.delete(lb_js)
        lb_js := na

// ══════════════════════════════════════════════════════════════════════════════
// RENDER BOXES
// ══════════════════════════════════════════════════════════════════════════════

// ── D+  (zona alcista) ────────────────────────────────────────────────────────
if in_window and not na(win_left)
    if show_zones
        _dp_t = math.max(d_plus_up, d_plus_lo)
        _dp_b = math.min(d_plus_up, d_plus_lo)
        _dp_m = (_dp_t + _dp_b) / 2
        _dp_x = bar_index + _fwd + _lbl_off
        if na(bx_dp)
            bx_dp := box.new(win_left, _dp_t, bar_index + _fwd, _dp_b, border_color=col_brd, border_width=1, bgcolor=_col_zone)
            lb_dp := label.new(_dp_x, _dp_m, _txt_dp, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.white, 100), textcolor=_col_lbl, size=size.small)
        else
            box.set_right(bx_dp,  bar_index + _fwd)
            box.set_top(bx_dp,    _dp_t)
            box.set_bottom(bx_dp, _dp_b)
            label.set_x(lb_dp,    _dp_x)
            label.set_y(lb_dp,    _dp_m)
    else
        if not na(bx_dp)
            box.delete(bx_dp)
            bx_dp := na
        if not na(lb_dp)
            label.delete(lb_dp)
            lb_dp := na

// ── D−  (zona bajista) ────────────────────────────────────────────────────────
if in_window and not na(win_left)
    if show_zones
        _dm_t = math.max(d_min_up, d_min_lo)
        _dm_b = math.min(d_min_up, d_min_lo)
        _dm_m = (_dm_t + _dm_b) / 2
        _dm_x = bar_index + _fwd + _lbl_off
        if na(bx_dm)
            bx_dm := box.new(win_left, _dm_t, bar_index + _fwd, _dm_b, border_color=col_brd, border_width=1, bgcolor=_col_zone)
            lb_dm := label.new(_dm_x, _dm_m, _txt_dm, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.white, 100), textcolor=_col_lbl, size=size.small)
        else
            box.set_right(bx_dm,  bar_index + _fwd)
            box.set_top(bx_dm,    _dm_t)
            box.set_bottom(bx_dm, _dm_b)
            label.set_x(lb_dm,    _dm_x)
            label.set_y(lb_dm,    _dm_m)
    else
        if not na(bx_dm)
            box.delete(bx_dm)
            bx_dm := na
        if not na(lb_dm)
            label.delete(lb_dm)
            lb_dm := na

// ── J-Buy ─────────────────────────────────────────────────────────────────────
if in_window3 and not na(win3_left) and not na(AM8_b_up) and not na(AM8_b_lo)
    if show_zones
        _jb_t = math.max(AM8_b_up, AM8_b_lo)
        _jb_b = math.min(AM8_b_up, AM8_b_lo)
        _jb_m = (_jb_t + _jb_b) / 2
        _jb_x = bar_index + _fwd + _lbl_off
        if na(bx_jb)
            bx_jb := box.new(win3_left, _jb_t, bar_index + _fwd, _jb_b, border_color=col_brd_j, border_width=1, bgcolor=_col_zone_j)
            lb_jb := label.new(_jb_x, _jb_m, _txt_j, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.white, 100), textcolor=_col_lbl_j, size=size.small)
        else
            box.set_right(bx_jb,  bar_index + _fwd)
            box.set_top(bx_jb,    _jb_t)
            box.set_bottom(bx_jb, _jb_b)
            label.set_x(lb_jb,    _jb_x)
            label.set_y(lb_jb,    _jb_m)
    else
        if not na(bx_jb)
            box.delete(bx_jb)
            bx_jb := na
        if not na(lb_jb)
            label.delete(lb_jb)
            lb_jb := na

// ── J-Sell ────────────────────────────────────────────────────────────────────
if in_window3 and not na(win3_left) and not na(AM8_s_up) and not na(AM8_s_lo)
    if show_zones
        _js_t = math.max(AM8_s_up, AM8_s_lo)
        _js_b = math.min(AM8_s_up, AM8_s_lo)
        _js_m = (_js_t + _js_b) / 2
        _js_x = bar_index + _fwd + _lbl_off
        if na(bx_js)
            bx_js := box.new(win3_left, _js_t, bar_index + _fwd, _js_b, border_color=col_brd_j, border_width=1, bgcolor=_col_zone_j)
            lb_js := label.new(_js_x, _js_m, _txt_j, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.white, 100), textcolor=_col_lbl_j, size=size.small)
        else
            box.set_right(bx_js,  bar_index + _fwd)
            box.set_top(bx_js,    _js_t)
            box.set_bottom(bx_js, _js_b)
            label.set_x(lb_js,    _js_x)
            label.set_y(lb_js,    _js_m)
    else
        if not na(bx_js)
            box.delete(bx_js)
            bx_js := na
        if not na(lb_js)
            label.delete(lb_js)
            lb_js := na
