                               and envolvente
                              
            
Propiedades_base_envolventes_secas =  envolvente and TDI_ENV and not max4[1]//and minvar//si puede tener desfase negatico y no son condiciones de rsi

mecha_superior_bull    = (high_var_bull * stdev_high_low) < body_var
no_mecha_igual_a_W_bull= low[2] > open and 
