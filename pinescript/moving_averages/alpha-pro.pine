///===================================================================================
///===================================================================================
///                  VELAS 
///===================================================================================
/////////////////////////////////////////////////////////////////77.          vela
envolvente_50_hma= (open + close) / 2
//bull
high_var_bull = math.abs((high / close) - 1) * 100
low_var_bull  = math.abs((open / low) - 1) * 100
tdl_bull      = (low < low[1] 
                and low < low[2]
                and low < low[3])
k_buy         = high_var_bull * stdev_min
//bear
high_var_bear = math.abs((high / open) - 1) * 100
low_var_bear  = math.abs((close/ low) - 1) * 100
tdl_bear      = (high > high[1]
                and high > high[2]
                and high > high[3])
k_sell        = low_var_bear * stdev_min
                
body_var_05=body_var* (stdev_min)
minvar=(body_var[1] <  body_var[2]) or (body_var[2] <  body_var[3]) or  (body_var[3] <  body_var[4])


/////////////////////////////////////////////////////////////////77.          vela

///===================================================================================
///===================================================================================
////               PARAMETROS DE INEFICIENCIAS
body = math.abs(close - open)
maxBody5 = ta.highest(body, 4)
maxBody4 = ta.highest(body, 4) //ohlc = 4
minBody= ta.lowest(body,4)
paint = body == maxBody5
max4= body == maxBody4
min_paint= body== minBody or body[1]== minBody[1] or  body[2]== minBody[2]  
//gaps
body_var_gaps= body_var[1]
gap_tamano_bull = (math.abs((low / high[2]) - 1) * 100) * 6
gap_dist_buy=(math.abs((low/high[2])-1)*100)
gap_tamano_bear= (math.abs((high / low[2]) - 1) * 100) * 6
gap_dist_sell= (math.abs((high/low[2])-1)*100)

var_gap_= (gap_tamano_bull > body_var_gaps) and (gap_tamano_bear >  body_var_gaps)
// Gaps — filtros de exclusión específicos
no_paint_Gap_S = bear [2] and bear[3] and (low[3] < low[2])
no_paint_Gap_B =bull[2] and  bull[3] and (high[3] > high[2])



no_take_liquidity_gap_bull = bull[1] and bull[2] and bull[3] and bull[4]
                             and low[1]  < high[4]
                             and low[1]  < low[2]
no_take_liquidity_gap_bear = bear[1] and bear[2] and bear[3] and bear[4]
                             and high[1] > low[4]
                             and high[1] > high[2]

no_desfase_negativo_gaps   = (bear and bull[1] and open  > close[1]) or (bull and bear[1] and open  < close[1])
//no_aceleracion             = body_var[3] < body_var[2] 
                             and body_var[2] < body_var[1] 
                  //           and (body_var[3]*(stdev_daily+stdev_max)  < body_var[1])


SUMA_STDEV_D_MAS_MAX= stdev_daily+stdev_max




// ── GAP BULL: bull[1] + bear actual ───────────────────────────────────────────
// Caso 1 — bypass total: open == high → sin restricción, siempre válido
// Caso 2 — bull[1] tiene mecha alta dominante: low_var[1]*stdev < high_var[1] → válido
// Caso 3 — bull[1] falla, pero bear actual compensa con high_var > low_var → válido
gap_bull_si_quiero = bull[1] and bear and (
      open == high
      or (low_var_bull[1] * stdev_high_low < high_var_bull[1])
      or (high_var_bear > low_var_bear)
    )

gap_bear_si_quiero = bear[1] and bull and (
      open == low
      or (high_var_bear[1] * stdev_high_low < low_var_bear[1])
      or (low_var_bull > high_var_bull)
    )

// Caso 1 — vela [1] tiene mecha dominante: stdev la valida → válido
// Caso 2 — vela [1] falla, pero vela actual compensa con mecha propia → válido

quiero_2_gap_bull = bull and bull[1] and (
      (low_var_bull[1]  * stdev_high_low < high_var_bull[1])  // caso 1: bull[1] válido por mecha
      or (high_var_bull * SUMA_STDEV_D_MAS_MAX > low_var_bull)                       // caso 2: bull actual compensa
    )

quiero_2_gap_bear = bear and bear[1] and (
      (high_var_bear[1] * stdev_high_low < low_var_bear[1])   // caso 1: bear[1] válido por mecha
      or (low_var_bear * SUMA_STDEV_D_MAS_MAX > high_var_bear)                       // caso 2: bear actual compensa
    )



si_q_bull= gap_bull_si_quiero  or quiero_2_gap_bull 
si_q_bear = gap_bear_si_quiero or quiero_2_gap_bear 


Gap_B = (bull[1] and max4[1] 
        and (high[2] < low) 
        and var_gap_[0] 
        and (body_var[1] < promedio_stdev_high_low) 
        and not no_paint_Gap_B
     //   and not no_take_liquidity_gap_bull
        and not no_desfase_negativo_gaps[1] 
        and  si_q_bull)
     //   and not desaceleration )

Gap_S = (bear[1] and max4[1] 
        and (low[2]  > high) 
        and var_gap_[0] 
        and (body_var[1] < promedio_stdev_high_low) 
        and not no_paint_Gap_S
    //    and not no_take_liquidity_gap_bear
        and not no_desfase_negativo_gaps[1]
        and  si_q_bear)
      //  and not desaceleration) 






// ════════════════════════════════════════════════════════════════════
// GAP_BUY  : Cualquier gap (B o S) formando POR DEBAJO de MA_HULL
//   Gap_S → high < MA_HULL : vela bajista, su techo está bajo el MA
//   Gap_B → low  < MA_HULL : vela alcista, su piso aún está bajo el MA
//
GAP_BUY  = ((Gap_S and high < MA_HULL) or (Gap_B and low  < MA_HULL))
         and not (low[1] < MA_HULL[1] and high[1] > MA_HULL[1])

GAP_SELL = ((Gap_S and high > MA_HULL) or (Gap_B and low  > MA_HULL))
         and not (low[1] < MA_HULL[1] and high[1] > MA_HULL[1])





///===================================================================================
//       Parametros base
///===================================================================================
no_mecha_oc            = close == low or 
                         close == high or  
                         open == low or 
                         open == high

no_mecha_closes        = close == low or 
                         close == high 

no_mecha_opens         = open == low or 
                         open == high 

no_var                 = no_mecha_oc[1] or 
                         no_mecha_oc[2] or 
                         no_mecha_oc[3]

no_var_solo_closes     = no_mecha_closes[1] or
                         no_mecha_closes[2] or 
                         no_mecha_closes[3]

no_var_solo_opens      = no_mecha_opens[1] or
                         no_mecha_opens[2] or 
                         no_mecha_opens[3]
                         
min_var                = body_var[1] > K/(stdev_daily*21)
envolvente             = (body_var > body_var[1] and open[1] < close) or 
                         (body_var > body_var[1] and open[1] > close)
body_var_doble_sigma_daily = body_var * (stdev_daily*2)

Parameters_base        = TDI 
                         and not no_var_solo_opens
                         and min_var

Parameters_base_pimbars= TDI
                         and min_var
Parameters_base_fast   = TDI_ENV

no_desfase_negativo = (bull and open  >= close[1]) or (bear and open <= close[1])                          
