// This source code is subject to the terms of the Mozilla Public License 2.0
// © Custom MTF MA/EMA 200 Ribbon Indicator v5

//@version=5
indicator("MTF MA/EMA 200 Ribbon", overlay=true, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════
//  SECTION 1 — RIBBON SETS  (top of settings)
//  Each set: enable checkbox + timeframe dropdown
// ═══════════════════════════════════════════════

var string TF_OPTS = "2m,5m,10m,12m,15m,30m,45m,90m,150m,1h,2h,3h,4h,5h,6h,8h,10h,12h,1D,2D,3D,4D,5D,1W"

// helper: convert friendly label back to Pine TF string
label_to_tf(lbl) =>
    string r = "240"
    if      lbl == "2m"  
        r := "2"
    else if lbl == "5m"  
        r := "5"
    else if lbl == "10m" 
        r := "10"
    else if lbl == "12m" 
        r := "12"
    else if lbl == "15m" 
        r := "15"
    else if lbl == "30m" 
        r := "30"
    else if lbl == "45m" 
        r := "45"
    else if lbl == "90m" 
        r := "90"
    else if lbl == "150m"
        r := "150"
    else if lbl == "1h"  
        r := "60"
    else if lbl == "2h"  
        r := "120"
    else if lbl == "3h"  
        r := "180"
    else if lbl == "4h"  
        r := "240"
    else if lbl == "5h"  
        r := "300"
    else if lbl == "6h"  
        r := "360"
    else if lbl == "8h"  
        r := "480"
    else if lbl == "10h" 
        r := "600"
    else if lbl == "12h" 
        r := "720"
    else if lbl == "1D"  
        r := "D"
    else if lbl == "2D"  
        r := "2D"
    else if lbl == "3D"  
        r := "3D"
    else if lbl == "4D"  
        r := "4D"
    else if lbl == "5D"  
        r := "5D"
    else if lbl == "1W"  
        r := "W"
    r

// ── SET 1 ──
var string G_S1 = "▶  Ribbon Sets"
set1_on  = input.bool  (true,  "Set 1",  inline="set1", group=G_S1)
set1_tf  = input.string("4h",  "",
     options=["2m","5m","10m","12m","15m","30m","45m","90m","150m",
              "1h","2h","3h","4h","5h","6h","8h","10h","12h",
              "1D","2D","3D","4D","5D","1W"],
     inline="set1", group=G_S1)

// ── SET 2 ──
set2_on  = input.bool  (true,  "Set 2",  inline="set2", group=G_S1)
set2_tf  = input.string("1h",  "",
     options=["2m","5m","10m","12m","15m","30m","45m","90m","150m",
              "1h","2h","3h","4h","5h","6h","8h","10h","12h",
              "1D","2D","3D","4D","5D","1W"],
     inline="set2", group=G_S1)

// ── SET 3 ──
set3_on  = input.bool  (false, "Set 3",  inline="set3", group=G_S1)
set3_tf  = input.string("2h",  "",
     options=["2m","5m","10m","12m","15m","30m","45m","90m","150m",
              "1h","2h","3h","4h","5h","6h","8h","10h","12h",
              "1D","2D","3D","4D","5D","1W"],
     inline="set3", group=G_S1)

// ── SET 4 ──
set4_on  = input.bool  (false, "Set 4",  inline="set4", group=G_S1)
set4_tf  = input.string("1D",  "",
     options=["2m","5m","10m","12m","15m","30m","45m","90m","150m",
              "1h","2h","3h","4h","5h","6h","8h","10h","12h",
              "1D","2D","3D","4D","5D","1W"],
     inline="set4", group=G_S1)

// resolve Pine-compatible TF strings
tf1 = label_to_tf(set1_tf)
tf2 = label_to_tf(set2_tf)
tf3 = label_to_tf(set3_tf)
tf4 = label_to_tf(set4_tf)

// ═══════════════════════════════════════════════
//  SECTION 2 — STYLE SETTINGS  (Set 1–4 colors)
// ═══════════════════════════════════════════════

var string G1 = "■  Set 1 — Style"
col1_ma    = input.color(color.new(#26A69A, 0),  "MA Line",   group=G1)
col1_ema   = input.color(color.new(#00E676, 0),  "EMA Line",  inline="c1", group=G1)
show_fill1 = input.bool (false,                  "Cloud",     inline="f1", group=G1)
col1_fill  = input.color(color.new(#26A69A, 72), "",          inline="f1", group=G1)
lw1        = input.int  (2, "Line Width", minval=1, maxval=4, group=G1)

var string G2 = "■  Set 2 — Style"
col2_ma    = input.color(color.new(#2196F3, 0),  "MA Line",   group=G2)
col2_ema   = input.color(color.new(#1565C0, 0),  "EMA Line",  inline="c2", group=G2)
show_fill2 = input.bool (false,                  "Cloud",     inline="f2", group=G2)
col2_fill  = input.color(color.new(#2196F3, 72), "",          inline="f2", group=G2)
lw2        = input.int  (2, "Line Width", minval=1, maxval=4, group=G2)

var string G3 = "■  Set 3 — Style"
col3_ma    = input.color(color.new(#FF9800, 0),  "MA Line",   group=G3)
col3_ema   = input.color(color.new(#E65100, 0),  "EMA Line",  inline="c3", group=G3)
show_fill3 = input.bool (false,                  "Cloud",     inline="f3", group=G3)
col3_fill  = input.color(color.new(#FF9800, 72), "",          inline="f3", group=G3)
lw3        = input.int  (2, "Line Width", minval=1, maxval=4, group=G3)

var string G4 = "■  Set 4 — Style"
col4_ma    = input.color(color.new(#363A45, 0),  "MA Line",   group=G4)
col4_ema   = input.color(color.new(#787B86, 0),  "EMA Line",  inline="c4", group=G4)
show_fill4 = input.bool (false,                  "Cloud",     inline="f4", group=G4)
col4_fill  = input.color(color.new(#363A45, 72), "",          inline="f4", group=G4)
lw4        = input.int  (2, "Line Width", minval=1, maxval=4, group=G4)

// ═══════════════════════════════════════════════
//  SECTION 3 — GLOBAL SETTINGS  (bottom)
// ═══════════════════════════════════════════════

var string G_GLOBAL = "⚙  Global Settings"
show_ma    = input.bool  (true,        "Show MA 200",   group=G_GLOBAL)
show_ema   = input.bool  (true,        "Show EMA 200",  group=G_GLOBAL)
show_table = input.bool  (true,        "Show Info Table", group=G_GLOBAL)
tbl_sz_raw = input.string("Small",     "Table Size",
     options=["Tiny","Small","Normal","Large","Huge"], group=G_GLOBAL)
tbl_pos_raw = input.string("Top Right","Table Position",
     options=["Top Right","Top Left","Bottom Right","Bottom Left","Top Center","Bottom Center"],
     group=G_GLOBAL)

tbl_size = tbl_sz_raw == "Tiny"   ? size.tiny   :
           tbl_sz_raw == "Normal" ? size.normal  :
           tbl_sz_raw == "Large"  ? size.large   :
           tbl_sz_raw == "Huge"   ? size.huge    : size.small

tbl_pos  = tbl_pos_raw == "Top Left"      ? position.top_left      :
           tbl_pos_raw == "Bottom Right"  ? position.bottom_right  :
           tbl_pos_raw == "Bottom Left"   ? position.bottom_left   :
           tbl_pos_raw == "Top Center"    ? position.top_center    :
           tbl_pos_raw == "Bottom Center" ? position.bottom_center : position.top_right

// ═══════════════════════════════════════════════
//  FETCH MTF DATA
// ═══════════════════════════════════════════════
ma1_raw  = request.security(syminfo.tickerid, tf1, ta.sma(close, 200), lookahead=barmerge.lookahead_off)
ema1_raw = request.security(syminfo.tickerid, tf1, ta.ema(close, 200), lookahead=barmerge.lookahead_off)
ma2_raw  = request.security(syminfo.tickerid, tf2, ta.sma(close, 200), lookahead=barmerge.lookahead_off)
ema2_raw = request.security(syminfo.tickerid, tf2, ta.ema(close, 200), lookahead=barmerge.lookahead_off)
ma3_raw  = request.security(syminfo.tickerid, tf3, ta.sma(close, 200), lookahead=barmerge.lookahead_off)
ema3_raw = request.security(syminfo.tickerid, tf3, ta.ema(close, 200), lookahead=barmerge.lookahead_off)
ma4_raw  = request.security(syminfo.tickerid, tf4, ta.sma(close, 200), lookahead=barmerge.lookahead_off)
ema4_raw = request.security(syminfo.tickerid, tf4, ta.ema(close, 200), lookahead=barmerge.lookahead_off)

// ═══════════════════════════════════════════════
//  PLOTS — na-gate when set is off (overrides Style tab eye icons)
// ═══════════════════════════════════════════════
ma1  = set1_on and show_ma  ? ma1_raw  : na
ema1 = set1_on and show_ema ? ema1_raw : na
ma2  = set2_on and show_ma  ? ma2_raw  : na
ema2 = set2_on and show_ema ? ema2_raw : na
ma3  = set3_on and show_ma  ? ma3_raw  : na
ema3 = set3_on and show_ema ? ema3_raw : na
ma4  = set4_on and show_ma  ? ma4_raw  : na
ema4 = set4_on and show_ema ? ema4_raw : na

p1_ma  = plot(ma1,  "MA200 [1]",  col1_ma,  lw1)
p1_ema = plot(ema1, "EMA200 [1]", col1_ema, lw1)
fill(p1_ma, p1_ema, color=set1_on and show_fill1 ? col1_fill : na, title="Cloud 1")

p2_ma  = plot(ma2,  "MA200 [2]",  col2_ma,  lw2)
p2_ema = plot(ema2, "EMA200 [2]", col2_ema, lw2)
fill(p2_ma, p2_ema, color=set2_on and show_fill2 ? col2_fill : na, title="Cloud 2")

p3_ma  = plot(ma3,  "MA200 [3]",  col3_ma,  lw3)
p3_ema = plot(ema3, "EMA200 [3]", col3_ema, lw3)
fill(p3_ma, p3_ema, color=set3_on and show_fill3 ? col3_fill : na, title="Cloud 3")

p4_ma  = plot(ma4,  "MA200 [4]",  col4_ma,  lw4)
p4_ema = plot(ema4, "EMA200 [4]", col4_ema, lw4)
fill(p4_ma, p4_ema, color=set4_on and show_fill4 ? col4_fill : na, title="Cloud 4")

// ═══════════════════════════════════════════════
//  INFO TABLE
// ═══════════════════════════════════════════════
price_vs(ma, ema) =>
    string out = "  —  "
    if not na(ma) and not na(ema)
        if close > ma and close > ema
            out := "▲ Above"
        else if close < ma and close < ema
            out := "▼ Below"
        else
            out := "~ Mixed"
    out

pv_col(ma, ema) =>
    color out = color.gray
    if not na(ma) and not na(ema)
        if close > ma and close > ema
            out := color.new(#00E676, 0)
        else if close < ma and close < ema
            out := color.new(#FF5252, 0)
        else
            out := color.new(#FFD740, 0)
    out

// count active sets for table rows
active_sets() =>
    int n = 0
    if set1_on
        n := n + 1
    if set2_on
        n := n + 1
    if set3_on
        n := n + 1
    if set4_on
        n := n + 1
    n

hdr_bg = color.new(#1a1a2e, 10)
row_bg = color.new(#0d0d1a, 30)

if show_table and barstate.islast
    n    = active_sets()
    rows = 1 + n
    tbl  = table.new(tbl_pos, 5, rows,
         bgcolor=color.new(#0d0d1a,20), border_color=color.new(color.white,70),
         border_width=1, frame_color=color.new(color.white,50), frame_width=1)

    // Header
    table.cell(tbl,0,0,"#",         text_color=color.new(color.white,20),text_size=tbl_size,bgcolor=hdr_bg,text_halign=text.align_center)
    table.cell(tbl,1,0,"Timeframe", text_color=color.new(color.white,20),text_size=tbl_size,bgcolor=hdr_bg,text_halign=text.align_center)
    table.cell(tbl,2,0,"MA 200",    text_color=color.new(color.white,20),text_size=tbl_size,bgcolor=hdr_bg,text_halign=text.align_right)
    table.cell(tbl,3,0,"EMA 200",   text_color=color.new(color.white,20),text_size=tbl_size,bgcolor=hdr_bg,text_halign=text.align_right)
    table.cell(tbl,4,0,"Price",     text_color=color.new(color.white,20),text_size=tbl_size,bgcolor=hdr_bg,text_halign=text.align_center)

    // Rows — only for active sets, stacked without gaps
    row = 1
    if set1_on
        table.cell(tbl,0,row,"1",      text_color=col1_ma,    text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_center)
        table.cell(tbl,1,row,set1_tf,  text_color=color.white,text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_center)
        table.cell(tbl,2,row,show_ma  ? str.tostring(math.round(ma1_raw, 2))  : "off", text_color=col1_ma, text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_right)
        table.cell(tbl,3,row,show_ema ? str.tostring(math.round(ema1_raw, 2)) : "off", text_color=col1_ema,text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_right)
        table.cell(tbl,4,row,price_vs(ma1_raw,ema1_raw),text_color=pv_col(ma1_raw,ema1_raw),text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_center)
        row := row + 1
    if set2_on
        table.cell(tbl,0,row,"2",      text_color=col2_ma,    text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_center)
        table.cell(tbl,1,row,set2_tf,  text_color=color.white,text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_center)
        table.cell(tbl,2,row,show_ma  ? str.tostring(math.round(ma2_raw, 2))  : "off", text_color=col2_ma, text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_right)
        table.cell(tbl,3,row,show_ema ? str.tostring(math.round(ema2_raw, 2)) : "off", text_color=col2_ema,text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_right)
        table.cell(tbl,4,row,price_vs(ma2_raw,ema2_raw),text_color=pv_col(ma2_raw,ema2_raw),text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_center)
        row := row + 1
    if set3_on
        table.cell(tbl,0,row,"3",      text_color=col3_ma,    text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_center)
        table.cell(tbl,1,row,set3_tf,  text_color=color.white,text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_center)
        table.cell(tbl,2,row,show_ma  ? str.tostring(math.round(ma3_raw, 2))  : "off", text_color=col3_ma, text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_right)
        table.cell(tbl,3,row,show_ema ? str.tostring(math.round(ema3_raw, 2)) : "off", text_color=col3_ema,text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_right)
        table.cell(tbl,4,row,price_vs(ma3_raw,ema3_raw),text_color=pv_col(ma3_raw,ema3_raw),text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_center)
        row := row + 1
    if set4_on
        table.cell(tbl,0,row,"4",      text_color=col4_ma,    text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_center)
        table.cell(tbl,1,row,set4_tf,  text_color=color.white,text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_center)
        table.cell(tbl,2,row,show_ma  ? str.tostring(math.round(ma4_raw, 2))  : "off", text_color=col4_ma, text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_right)
        table.cell(tbl,3,row,show_ema ? str.tostring(math.round(ema4_raw, 2)) : "off", text_color=col4_ema,text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_right)
        table.cell(tbl,4,row,price_vs(ma4_raw,ema4_raw),text_color=pv_col(ma4_raw,ema4_raw),text_size=tbl_size,bgcolor=row_bg,text_halign=text.align_center)
