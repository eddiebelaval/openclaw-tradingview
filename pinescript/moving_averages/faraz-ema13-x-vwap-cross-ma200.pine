//@version=5
indicator(title="Faraz-EMA13 x VWAP Cross + MA200", shorttitle="Faraz-EMA13xVWAP", overlay=true)

// ─────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────
emaLen      = input.int(13,  title="EMA Length",       minval=1)
maLen       = input.int(200, title="MA200 Length",     minval=1)
maType      = input.string("SMA", title="MA200 Type",  options=["SMA", "EMA"])
showLabels  = input.bool(true, title="Show Cross Labels")
showMA200   = input.bool(true, title="Show MA200")

// ─────────────────────────────────────────
// CALCULATIONS
// ─────────────────────────────────────────

// EMA 13
ema13 = ta.ema(close, emaLen)

// VWAP (session-based, native TradingView)
vwapVal = ta.vwap(hlc3)

// MA 200
ma200 = maType == "SMA" ? ta.sma(close, maLen) : ta.ema(close, maLen)

// ─────────────────────────────────────────
// CROSSOVER / CROSSUNDER DETECTION
// ─────────────────────────────────────────
bullCross = ta.crossover(ema13, vwapVal)   // EMA crosses ABOVE VWAP → Bullish
bearCross = ta.crossunder(ema13, vwapVal)  // EMA crosses BELOW VWAP → Bearish

// ─────────────────────────────────────────
// MA200 BIAS FILTER (optional context)
// ─────────────────────────────────────────
aboveMA200 = close > ma200   // Bullish bias
belowMA200 = close < ma200   // Bearish bias

// ─────────────────────────────────────────
// PLOTS
// ─────────────────────────────────────────
plot(ema13,   title="EMA 13",  color=color.orange,       linewidth=2)
plot(vwapVal, title="VWAP",    color=color.new(#00BFFF, 0), linewidth=2)

plot(showMA200 ? ma200 : na, 
     title="MA 200", 
     color=color.new(color.purple, 0), 
     linewidth=1, 
     style=plot.style_line)

// ─────────────────────────────────────────
// CROSS SIGNALS (Arrows on chart)
// ─────────────────────────────────────────
plotshape(bullCross and showLabels,
     title="Bull Cross",
     location=location.belowbar,
     style=shape.labelup,
     color=color.new(color.green, 0),
     textcolor=color.white,
     text="LONG",
     size=size.small)

plotshape(bearCross and showLabels,
     title="Bear Cross",
     location=location.abovebar,
     style=shape.labeldown,
     color=color.new(color.red, 0),
     textcolor=color.white,
     text="SHORT",
     size=size.small)

// ─────────────────────────────────────────
// BACKGROUND HIGHLIGHT ON CROSS BARS
// ─────────────────────────────────────────
bgcolor(bullCross ? color.new(color.green, 85) : na, title="Bull Cross BG")
bgcolor(bearCross ? color.new(color.red,   85) : na, title="Bear Cross BG")

// ─────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────
alertcondition(bullCross,
     title="🟢 LONG — EMA13 crossed ABOVE VWAP",
     message="[{{ticker}}] 5m — EMA13 crossed ABOVE VWAP. Price: {{close}}. Possible LONG setup.")

alertcondition(bearCross,
     title="🔴 SHORT — EMA13 crossed BELOW VWAP",
     message="[{{ticker}}] 5m — EMA13 crossed BELOW VWAP. Price: {{close}}. Possible SHORT setup.")

alertcondition(bullCross and aboveMA200,
     title="✅ LONG + Above MA200 (High Confidence)",
     message="[{{ticker}}] 5m — EMA13 x VWAP LONG cross. Price ABOVE MA200. Strong LONG bias.")

alertcondition(bearCross and belowMA200,
     title="✅ SHORT + Below MA200 (High Confidence)",
     message="[{{ticker}}] 5m — EMA13 x VWAP SHORT cross. Price BELOW MA200. Strong SHORT bias.")
