//@version=6
indicator("Security Liquidity", shorttitle='Liquidity', overlay=true)

// --- Inputs ---
avgPeriod = input.int(20, title='Average Period', minval=1, maxval=5000, group='Liquidity Inputs')
srcInput  = input.source(hlc3, title='Source', group='Liquidity Inputs', tooltip='Leave it default')

// Visual Inputs
labelSize = input.string(size.normal, title='Label Size', options=[size.tiny, size.small, size.normal, size.large, size.huge], group='Visuals')
notation  = input.string("Millions", title="Notation", options=["Millions", "Crores"], group='Visuals')
showTrend = input.bool(true, title="Color based on 5-day Trend?", group='Visuals', tooltip="Green if current liquidity is higher than 5 days ago")

// Alert Inputs
alertVal  = input.float(500, title="Alert Threshold", group="Alerts", tooltip="Trigger alert if liquidity exceeds this value")

//-----------------------------------
// Calculation Logic
//-----------------------------------
tf = timeframe.period
s  = syminfo.tickerid

// 1. Get Base Data
vwapVal = ta.vwap(srcInput)
volData = request.security(s, tf, volume)

// 2. Dynamic Lookback (IPO Fix)
int available_bars = math.min(avgPeriod, bar_index + 1)

// If the start of the window is the IPO day (0 volume), shift window by 1
if available_bars > 0 and (volData[available_bars - 1] == 0 or na(volData[available_bars - 1]))
    available_bars := available_bars - 1

// 3. Calculate Averages
// Safe division: if available_bars is 0, return 0.0
vwap_sma = available_bars > 0 ? ta.sma(vwapVal, available_bars) : 0.0
vol_sma  = available_bars > 0 ? ta.sma(volData, available_bars) : 0.0

// 4. Calculate Raw Liquidity (Price * Volume)
rawLiquidity = vwap_sma * vol_sma

// 5. Convert to User Notation
float displayValue = 0.0
string unitText = ""

if notation == "Millions"
    displayValue := rawLiquidity / 1000000
    unitText := "M"
else 
    displayValue := rawLiquidity / 10000000
    unitText := "Cr"

//-----------------------------------
// Plotting & Alerts
//-----------------------------------

// Trend Logic: Is the current 20-day Avg Liquidity higher than it was 5 bars ago?
isTrendUp = displayValue > displayValue[5]
labelColor = showTrend ? (isTrendUp ? color.new(color.green, 20) : color.new(color.orange, 20)) : color.green

// Plot Label
var label vwapLabel = na
gap = 0.03

if barstate.islast
    labelText = str.tostring(displayValue, '0.00') + " " + unitText
    if na(vwapLabel)
        vwapLabel := label.new(bar_index, high * (1 + gap), text=labelText, color=labelColor, style=label.style_label_down, textcolor=color.white, size=labelSize)
    else
        label.set_xy(vwapLabel, bar_index, high * (1 + gap))
        label.set_text(vwapLabel, labelText)
        label.set_color(vwapLabel, labelColor)

// Create the Alert Condition
// This enables the "Condition" dropdown in the Create Alert menu
alertcondition(displayValue > alertVal, title="High Liquidity Alert", message="Liquidity has crossed your threshold!")
