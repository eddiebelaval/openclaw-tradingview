//@version=5
indicator("EMA Cross BB + Fib Visual SL/TP", overlay=true)

// === INPUTS ===
emaLength = input.int(9, "EMA Length")
bbLength = input.int(20, "BB Length")
bbMult = input.float(2.0, "BB Multiplier")

tpFib = input.float(1.618, "Take Profit Fib")
slFib = input.float(-0.272, "Stop Loss Fib")

// === INDICATORS ===
emaValue = ta.ema(close, emaLength)
smaValue = ta.sma(close, bbLength)
dev = ta.stdev(close, bbLength)

upperBand = smaValue + bbMult * dev
lowerBand = smaValue - bbMult * dev

// === SIGNALS ===
buySignal = ta.crossover(emaValue, smaValue)
sellSignal = ta.crossunder(emaValue, smaValue)

// === PLOTS EMA & BB ===
plot(emaValue, color=color.blue, linewidth=2, title="EMA")
plot(smaValue, color=color.orange, linewidth=2, title="BB SMA 20")
plot(upperBand, color=color.red, title="Upper BB")
plot(lowerBand, color=color.red, title="Lower BB")

// === VISUAL BUY/SELL ARROWS ===
plotshape(buySignal, location=location.belowbar, color=color.green, style=shape.labelup, text="BUY", title="Buy Signal")
plotshape(sellSignal, location=location.abovebar, color=color.red, style=shape.labeldown, text="SELL", title="Sell Signal")

// === CALCULATE SL/TP USING FIB FROM SIGNAL CANDLE ===
if (buySignal)
    candleLow = low
    candleHigh = high
    candleRange = candleHigh - candleLow

    sl = candleLow + candleRange * slFib
    tp = candleLow + candleRange * tpFib

    // Draw lines
    line.new(bar_index, sl, bar_index + 5, sl, extend=extend.right, color=color.red, width=2)
    line.new(bar_index, tp, bar_index + 5, tp, extend=extend.right, color=color.green, width=2)
    label.new(bar_index, sl, "SL\n" + str.tostring(sl, format.mintick), color=color.red, textcolor=color.white, style=label.style_label_left, size=size.small)
    label.new(bar_index, tp, "TP\n" + str.tostring(tp, format.mintick), color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)

if (sellSignal)
    candleLow = low
    candleHigh = high
    candleRange = candleHigh - candleLow

    sl = candleHigh - candleRange * slFib
    tp = candleHigh - candleRange * tpFib

    line.new(bar_index, sl, bar_index + 5, sl, extend=extend.right, color=color.red, width=2)
    line.new(bar_index, tp, bar_index + 5, tp, extend=extend.right, color=color.green, width=2)
    label.new(bar_index, sl, "SL\n" + str.tostring(sl, format.mintick), color=color.red, textcolor=color.white, style=label.style_label_left, size=size.small)
    label.new(bar_index, tp, "TP\n" + str.tostring(tp, format.mintick), color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)
