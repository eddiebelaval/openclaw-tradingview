//@version=5
indicator("EMA 9/50 ATR - Full Terminal", overlay=true, max_labels_count=500)

// --- 1. Inputs ---
sessionInput = input.session("0940-1600", "🕒 Trading Window")
shares       = input.int(50, "Position Size (Shares)")
rrRatio      = input.float(1.5, "⚖️ Risk/Reward Ratio")
atrMult      = input.float(1.0, "📏 ATR SL Multiplier") 
atrLen       = input.int(14, "ATR Period")

macdFast     = input.int(12, "🚀 MACD Fast")
macdSlow     = input.int(26, "🐌 MACD Slow")
macdSignal   = input.int(9,  "📊 MACD Signal")

ema9Len      = input.int(9,  "⚡ Fast EMA")
ema50Len     = input.int(50, "📈 Slow EMA")
rsiLength    = input.int(14, "📉 RSI Length")

// --- 2. Indicators ---
ema9   = ta.ema(close, ema9Len)
ema50  = ta.ema(close, ema50Len)
rsiVal = ta.rsi(close, rsiLength)
atrVal = ta.atr(atrLen)
[macdLine, signalLine, _] = ta.macd(close, macdFast, macdSlow, macdSignal)

// --- 3. Signal Logic ---
isInSession = not na(time(timeframe.period, sessionInput))
buySignal   = isInSession and ta.crossover(ema9, ema50) and rsiVal > 50 and macdLine > signalLine
sellSignal  = isInSession and ta.crossunder(ema9, ema50) and rsiVal < 50 and macdLine < signalLine

// --- 4. Persistent Arrays & Labels ---
var typeArr = array.new_string(0)
var entArr  = array.new_string(0)
var slArr   = array.new_string(0)
var tpArr   = array.new_string(0)
var resArr  = array.new_string(0)
var pnlArr  = array.new_string(0)
var colArr  = array.new_color(0)

var float totalPnL = 0.0
var int wins = 0
var int totalTrades = 0
var float curTP = na
var float curSL = na
var float curEntry = na
var int curDir = 0 

// Persistent label variables
var label lblTP = na
var label lblSL = na

// --- 5. Tracking Logic ---
if curDir != 0
    bool hitTP = (curDir == 1 and high >= curTP) or (curDir == -1 and low <= curTP)
    bool hitSL = (curDir == 1 and low <= curSL) or (curDir == -1 and high >= curSL)

    if hitTP or hitSL
        float p = hitTP ? (math.abs(curTP - curEntry) * shares) : -(math.abs(curEntry - curSL) * shares)
        totalPnL := totalPnL + p
        totalTrades := totalTrades + 1
        if hitTP
            wins := wins + 1
            
        int lastIdx = array.size(resArr) - 1
        if lastIdx >= 0
            array.set(resArr, lastIdx, hitTP ? "WIN ✅" : "LOSS ❌")
            array.set(pnlArr, lastIdx, (p >= 0 ? "+$" : "-$") + str.tostring(math.abs(p), "#.##"))
            array.set(colArr, lastIdx, hitTP ? #00c853 : #ff5252)
        
        // Clean up labels when trade ends
        label.delete(lblTP)
        label.delete(lblSL)
        curDir := 0

if (buySignal or sellSignal) and curDir == 0
    curDir   := buySignal ? 1 : -1
    curEntry := close
    float slDist = atrVal * atrMult
    curSL    := buySignal ? close - slDist : close + slDist
    curTP    := buySignal ? close + (slDist * rrRatio) : close - (slDist * rrRatio)
    
    // Create Visual Labels on Chart
    label.delete(lblTP)
    label.delete(lblSL)
    lblTP := label.new(bar_index, curTP, "TARGET: " + str.tostring(curTP, format.mintick), color=#00c853, textcolor=color.white, style=label.style_label_left, size=size.small)
    lblSL := label.new(bar_index, curSL, "STOP: " + str.tostring(curSL, format.mintick), color=#ff5252, textcolor=color.white, style=label.style_label_left, size=size.small)

    array.push(typeArr, curDir == 1 ? "LONG" : "SHORT")
    array.push(entArr,  str.tostring(curEntry, "#.##"))
    array.push(slArr,   str.tostring(curSL, "#.##"))
    array.push(tpArr,   str.tostring(curTP, "#.##"))
    array.push(resArr,  "ACTIVE 🔵")
    array.push(pnlArr,  "...")
    array.push(colArr,  #2962ff)
    
    if array.size(typeArr) > 6
        array.shift(typeArr)
        array.shift(entArr)
        array.shift(slArr)
        array.shift(tpArr)
        array.shift(resArr)
        array.shift(pnlArr)
        array.shift(colArr)

// --- 6. Table UI (Upper Center & Large) ---
var table dashboard = table.new(position.top_center, 6, 12, border_width=1, frame_color=#434651, border_color=#434651)

if barstate.islast
    table.merge_cells(dashboard, 0, 0, 5, 0)
    table.cell(dashboard, 0, 0, "🚀 STRATEGY TERMINAL", bgcolor=#131722, text_color=#d1d4dc, text_size=size.large)

    string[] h = array.from("TYPE", "ENTRY", "STOP", "TARGET", "STATUS", "P/L")
    for i = 0 to 5
        table.cell(dashboard, i, 1, array.get(h, i), bgcolor=#1e222d, text_color=#b2b5be, text_size=size.normal)
    
    int rowCount = array.size(typeArr)
    if rowCount > 0
        for i = 0 to rowCount - 1
            table.cell(dashboard, 0, i + 2, array.get(typeArr, i), text_color=color.white, text_size=size.normal)
            table.cell(dashboard, 1, i + 2, array.get(entArr, i), text_color=#d1d4dc, text_size=size.normal)
            table.cell(dashboard, 2, i + 2, array.get(slArr, i), text_color=#ff8a80, text_size=size.normal)
            table.cell(dashboard, 3, i + 2, array.get(tpArr, i), text_color=#b9f6ca, text_size=size.normal)
            table.cell(dashboard, 4, i + 2, array.get(resArr, i), bgcolor=array.get(colArr, i), text_color=color.white, text_size=size.normal)
            table.cell(dashboard, 5, i + 2, array.get(pnlArr, i), text_color=color.white, text_size=size.normal)
    
    float winRate = totalTrades > 0 ? (wins / totalTrades) * 100 : 0
    table.merge_cells(dashboard, 0, 10, 2, 10)
    table.merge_cells(dashboard, 3, 10, 5, 10)
    table.cell(dashboard, 0, 10, "WIN RATE: " + str.tostring(winRate, "0.0") + "%", bgcolor=#1e222d, text_color=#2962ff, text_size=size.normal)
    table.cell(dashboard, 3, 10, "SESSION P/L: " + (totalPnL >= 0 ? "+$" : "-$") + str.tostring(math.abs(totalPnL), "#.##"), bgcolor=#1e222d, text_color=(totalPnL >= 0 ? #00c853 : #ff5252), text_size=size.normal)

// --- 7. Plotting ---
plot(ema50, color=color.new(#787b86, 50), linewidth=2, title="EMA 50")
plot(ema9,  color=color.new(#2962ff, 0),  linewidth=2, title="EMA 9")
plotshape(buySignal, "Buy", shape.triangleup, location.belowbar, #00c853, size=size.small)
plotshape(sellSignal, "Sell", shape.triangledown, location.abovebar, #ff5252, size=size.small)
