//@version=5
indicator("MTF-MA-4", overlay=true)

// --- 核心函數定義 ---
getMA(type, source, length) =>
    type == "EMA" ? ta.ema(source, length) : ta.sma(source, length)

// --- 快速配置單條均線的函數 ---
f_get_mtf_ma(active, res, maType, len, src, gaps) =>
    float ma_val = active ? request.security(syminfo.tickerid, res, getMA(maType, src, len), gaps = gaps ? barmerge.gaps_on : barmerge.gaps_off) : na
    ma_val

// ==========================================
// 參數設置：MA 1
// ==========================================
group1 = "均線 1 設置"
show1   = input.bool(true, "MA 1", group=group1)
res1    = input.timeframe("D", "timeframe", group=group1)
type1   = input.string("EMA", "type", options=["EMA", "SMA"], group=group1)
len1    = input.int(20, "length", group=group1)
col1    = input.color(color.aqua, "color", group=group1)

// ==========================================
// 參數設置：MA 2
// ==========================================
group2 = "均線 2 設置"
show2   = input.bool(true, "MA 2", group=group2)
res2    = input.timeframe("D", "timeframe", group=group2)
type2   = input.string("EMA", "type", options=["EMA", "SMA"], group=group2)
len2    = input.int(50, "length", group=group2)
col2    = input.color(color.orange, "color", group=group2)

// ==========================================
// 參數設置：MA 3
// ==========================================
group3 = "均線 3 設置"
show3   = input.bool(true, "MA 3", group=group3)
res3    = input.timeframe("D", "timeframe", group=group3)
type3   = input.string("SMA", "type", options=["EMA", "SMA"], group=group3)
len3    = input.int(100, "length", group=group3)
col3    = input.color(color.yellow, "color", group=group3)

// ==========================================
// 參數設置：MA 4
// ==========================================
group4 = "均線 4 設置"
show4   = input.bool(true, "MA 4", group=group4)
res4    = input.timeframe("D", "timeframe區", group=group4)
type4   = input.string("SMA", "type", options=["EMA", "SMA"], group=group4)
len4    = input.int(200, "length", group=group4)
col4    = input.color(color.fuchsia, "color", group=group4)

// 全局設置
gaps = input.bool(false, "only show when close (Gaps On)", tooltip="Enabling this feature can prevent stepped lines and make historical data more accurate.")

// --- 計算數據 ---
val1 = f_get_mtf_ma(show1, res1, type1, len1, close, gaps)
val2 = f_get_mtf_ma(show2, res2, type2, len2, close, gaps)
val3 = f_get_mtf_ma(show3, res3, type3, len3, close, gaps)
val4 = f_get_mtf_ma(show4, res4, type4, len4, close, gaps)

// --- 繪圖 ---
plot(val1, "MA 1", color=col1, linewidth=2, style=plot.style_linebr)
plot(val2, "MA 2", color=col2, linewidth=2, style=plot.style_linebr)
plot(val3, "MA 3", color=col3, linewidth=2, style=plot.style_linebr)
plot(val4, "MA 4", color=col4, linewidth=2, style=plot.style_linebr)
