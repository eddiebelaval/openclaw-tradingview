//@version=5
indicator("Time + SMA89/200 Filter", overlay=true)

// ==============================
// 1) TIME FILTER (UTC+8)
// ==============================

// Blocked sessions
blockMorning = not na(time(timeframe.period, "0400-0700", "Asia/Singapore"))
blockEvening = not na(time(timeframe.period, "1600-2045", "Asia/Singapore"))

timeBlocked = blockMorning or blockEvening
timeAllowed = not timeBlocked

// ==============================
// 2) SMA89 / SMA200 FILTER
// ==============================

// Moving averages
sma89  = ta.sma(close, 89)
sma200 = ta.sma(close, 200)

// Settings
distThreshold  = input.float(3.0, "Max distance between SMA89 and SMA200", step=0.1)
slopeBars      = input.int(5, "Bars to measure slope", minval=1)
slopeThreshold = input.float(1.0, "Max flat slope threshold", step=0.1)

// Conditions
maCloseTogether = math.abs(sma89 - sma200) < distThreshold

sma89Flat  = math.abs(sma89 - sma89[slopeBars]) < slopeThreshold
sma200Flat = math.abs(sma200 - sma200[slopeBars]) < slopeThreshold

maBlocked = maCloseTogether and sma89Flat and sma200Flat
maAllowed = not maBlocked

// ==============================
// FINAL FILTER
// ==============================

allowed = timeAllowed and maAllowed
blocked = not allowed

// ==============================
// PLOTS
// ==============================

plot(sma89, color=color.orange, title="SMA 89")
plot(sma200, color=color.blue, title="SMA 200")

bgcolor(timeBlocked ? color.new(color.red, 85) : na, title="Blocked Time")
bgcolor(maBlocked and not timeBlocked ? color.new(color.orange, 85) : na, title="Blocked MA Zone")

// ==============================
// ALERTS
// ==============================

alertcondition(allowed, title="Allowed Zone", message="Trading allowed: outside blocked time and SMA89/200 not compressed-flat")
alertcondition(blocked, title="Blocked Zone", message="Trading blocked: time filter or SMA89/200 compression-flat")
