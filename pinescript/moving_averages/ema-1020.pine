//@version=5
indicator("EMA 10/20", overlay=true)
fast = ta.ema(close, 10)
slow = ta.ema(close, 20)
plot(fast, color = color.blue,title = "EMA 10")
plot(slow, color = color.red, title = "EMA 20")
amplitude = (close - open)/open * 100
plot(amplitude, color = color.orange,display=display.status_line,title = "漲跌幅",format=format.percent)
