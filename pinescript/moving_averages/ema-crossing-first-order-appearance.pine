//@version=6
indicator("EMA 20/30/50 First Order Appearance", overlay=true)

// Moving averages (EMA)
ema20 = ta.ema(close, 20)
ema30 = ta.ema(close, 30)
ema50 = ta.ema(close, 50)

// Order conditions
bullOrder = ema20 > ema30 and ema30 > ema50
bearOrder = ema20 < ema30 and ema30 < ema50

// Detect first appearance of order
buySignal  = bullOrder and not bullOrder[1]
sellSignal = bearOrder and not bearOrder[1]

// Plot averages
plot(ema20, color=color.blue,   title="EMA 20")
plot(ema30, color=color.orange, title="EMA 30")
plot(ema50, color=color.red,    title="EMA 50")

// Signals
plotshape(
    buySignal,
    title="CALL",
    style=shape.labelup,
    location=location.belowbar,
    color=color.white,
    text="CALL"
)

plotshape(
    sellSignal,
    title="PUT",
    style=shape.labeldown,
    location=location.abovebar,
    color=color.orange,
    text="PUT"
)
