//@version=5
indicator("Tunnel SMA 9 + 2 Variables", overlay=true)

// 1. La ligne centrale (SMA 9)
sma9 = ta.sma(close, 9)

// 2. Les 2 variables (Lignes Haut et Bas)
// Ici, on utilise le High et le Low pour créer les parois du tunnel
var_haute = high
var_basse = low

// 3. Couleurs pour les 3 lignes
plot(sma9, color=color.blue, title="SMA 9 (Référence)", linewidth=2)
plot(var_haute, color=color.green, title="Variable Haute (High)", linewidth=1, style=plot.style_stepline)
plot(var_basse, color=color.red, title="Variable Basse (Low)", linewidth=1, style=plot.style_stepline)

// 4. Logique de croisement
// ACHAT : Quand la ligne Basse passe au-dessus de la SMA 9
achat = ta.crossover(var_basse, sma9)

// VENTE : Quand la ligne Haute passe en-dessous de la SMA 9
vente = ta.crossunder(var_haute, sma9)

// 5. Signaux visuels
plotshape(achat, "Achat", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(vente, "Vente", shape.triangledown, location.abovebar, color.red, size=size.small)

// Remplissage du "Range" (optionnel, pour la clarté)
fill(plot(var_haute), plot(var_basse), color=color.new(color.gray, 90), title="Zone de Range")
