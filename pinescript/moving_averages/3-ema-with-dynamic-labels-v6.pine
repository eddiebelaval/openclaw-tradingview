//@version=6
indicator(title='3 EMA with Dynamic Labels [v6]', shorttitle='3EMA+Txt', overlay=true)

// --- Inputs ---
src = input.source(close, title='Source')
offset = input.int(0, title='Offset', tooltip='Shift the EMA plots left or right')

// Defined lengths as per your request
len1 = input.int(13, minval=1, title='EMA 1 Length', group='EMA Settings')
len2 = input.int(48, minval=1, title='EMA 2 Length', group='EMA Settings')
len3 = input.int(200, minval=1, title='EMA 3 Length', group='EMA Settings')

showLabels = input.bool(true, title='Show EMA Labels', group='Display')

// --- Calculations ---
ema1 = ta.ema(src, len1)
ema2 = ta.ema(src, len2)
ema3 = ta.ema(src, len3)

// --- Updated Colors ---
col1 = color.yellow
col2 = color.purple
col3 = color.red

// --- Plots ---
plot(ema1, title='EMA 13', linewidth=2, color=col1, offset=offset)
plot(ema2, title='EMA 48', linewidth=2, color=col2, offset=offset)
plot(ema3, title='EMA 200', linewidth=3, color=col3, offset=offset)

// --- v6 Label Logic ---
renderEMA_Label(yPos, labelText, labelColor) =>
    var label lbl = na
    if showLabels
        label.delete(lbl)
        lbl := label.new(
             x = bar_index + 2, 
             y = yPos, 
             text = labelText, 
             color = color.new(labelColor, 100), // Transparent background
             textcolor = labelColor, 
             style = label.style_label_left, 
             size = size.normal
             )

// Only execute drawing on the last bar
if barstate.islast
    renderEMA_Label(ema1, "EMA " + str.tostring(len1), col1)
    renderEMA_Label(ema2, "EMA " + str.tostring(len2), col2)
    renderEMA_Label(ema3, "EMA " + str.tostring(len3), col3)
