//@version=6
indicator("Variable MA Ribbon [zenba]", shorttitle="variribbon", overlay=true, max_lines_count=500, behind_chart = false)

// ── General Settings ────────────────────────────────────────
group_general = "General Settings"
show_labels   = input.bool(true,  "Show MA Labels on Last Bar", group=group_general)
transparency  = input.int(0,      "Line Transparency (0-100)",  minval=0, maxval=100, group=group_general)

// ── MA 1 ────────────────────────────────────────────────────
group1 = "MA 1"
ma1_show   = input.bool(true,   "Enable MA 1",                     group=group1)
ma1_type   = input.string("SMA", "Type", options=["SMA","EMA","VWMA"], group=group1)
ma1_len    = input.int(9,       "Length", minval=1,                group=group1)
ma1_color  = input.color(#00e6c2,"Color",                          group=group1)
ma1_width  = input.int(2,       "Width", minval=1, maxval=5,       group=group1)

// ── MA 2 ────────────────────────────────────────────────────
group2 = "MA 2"
ma2_show   = input.bool(true,   "Enable MA 2",                     group=group2)
ma2_type   = input.string("SMA", "Type", options=["SMA","EMA","VWMA"], group=group2)
ma2_len    = input.int(36,      "Length", minval=1,                group=group2)
ma2_color  = input.color(#ff9100,"Color",                          group=group2)
ma2_width  = input.int(2,       "Width", minval=1, maxval=5,       group=group2)

// ── MA 3 ────────────────────────────────────────────────────
group3 = "MA 3"
ma3_show   = input.bool(true,   "Enable MA 3",                     group=group3)
ma3_type   = input.string("SMA", "Type", options=["SMA","EMA","VWMA"], group=group3)
ma3_len    = input.int(63,      "Length", minval=1,                group=group3)
ma3_color  = input.color(#c2185b,"Color",                          group=group3)
ma3_width  = input.int(2,       "Width", minval=1, maxval=5,       group=group3)

// ── MA 4 ────────────────────────────────────────────────────
group4 = "MA 4"
ma4_show   = input.bool(true,   "Enable MA 4",                     group=group4)
ma4_type   = input.string("SMA", "Type", options=["SMA","EMA","VWMA"], group=group4)
ma4_len    = input.int(108,     "Length", minval=1,                group=group4)
ma4_color  = input.color(#7c4dff,"Color",                          group=group4)
ma4_width  = input.int(2,       "Width", minval=1, maxval=5,       group=group4)

// ── MA 5 ────────────────────────────────────────────────────
group5 = "MA 5"
ma5_show   = input.bool(true,   "Enable MA 5",                     group=group5)
ma5_type   = input.string("SMA", "Type", options=["SMA","EMA","VWMA"], group=group5)
ma5_len    = input.int(200,     "Length", minval=1,                group=group5)
ma5_color  = input.color(#ffd700,"Color",                          group=group5)
ma5_width  = input.int(2,       "Width", minval=1, maxval=5,       group=group5)

// ── Calculate selected MA ───────────────────────────────────
f_calcMA(src, len, typ) =>
    switch typ
        "EMA"  => ta.ema(src, len)
        "VWMA" => ta.vwma(src, len)
        => ta.sma(src, len)          // default = SMA

ma1 = ma1_show ? f_calcMA(close, ma1_len, ma1_type) : na
ma2 = ma2_show ? f_calcMA(close, ma2_len, ma2_type) : na
ma3 = ma3_show ? f_calcMA(close, ma3_len, ma3_type) : na
ma4 = ma4_show ? f_calcMA(close, ma4_len, ma4_type) : na
ma5 = ma5_show ? f_calcMA(close, ma5_len, ma5_type) : na

// ── Plotting ────────────────────────────────────────────────
trans = 100 - transparency

plot(ma1, "MA1",  color=ma1_show ? color.new(ma1_color, trans) : na, linewidth=ma1_width, style=plot.style_line,display=display.all-display.status_line)
plot(ma2, "MA2",  color=ma2_show ? color.new(ma2_color, trans) : na, linewidth=ma2_width, style=plot.style_line,display=display.all-display.status_line)
plot(ma3, "MA3",  color=ma3_show ? color.new(ma3_color, trans) : na, linewidth=ma3_width, style=plot.style_line,display=display.all-display.status_line)
plot(ma4, "MA4",  color=ma4_show ? color.new(ma4_color, trans) : na, linewidth=ma4_width, style=plot.style_line,display=display.all-display.status_line)
plot(ma5, "MA5",  color=ma5_show ? color.new(ma5_color, trans) : na, linewidth=ma5_width, style=plot.style_line,display=display.all-display.status_line)

// ── Optional last-bar labels ────────────────────────────────
if show_labels and barstate.islastconfirmedhistory
    if ma1_show
        label.new(bar_index, ma1, str.tostring(ma1_len)+" "+ma1_type, yloc=yloc.price, style=label.style_label_left, color=ma1_color, textcolor=color.black, size=size.small)
    if ma2_show
        label.new(bar_index, ma2, str.tostring(ma2_len)+" "+ma2_type, yloc=yloc.price, style=label.style_label_left, color=ma2_color, textcolor=color.black, size=size.small)
    if ma3_show
        label.new(bar_index, ma3, str.tostring(ma3_len)+" "+ma3_type, yloc=yloc.price, style=label.style_label_left, color=ma3_color, textcolor=color.black, size=size.small)
    if ma4_show
        label.new(bar_index, ma4, str.tostring(ma4_len)+" "+ma4_type, yloc=yloc.price, style=label.style_label_left, color=ma4_color, textcolor=color.black, size=size.small)
    if ma5_show
        label.new(bar_index, ma5, str.tostring(ma5_len)+" "+ma5_type, yloc=yloc.price, style=label.style_label_left, color=ma5_color, textcolor=color.black, size=size.small)
