//@version=6
indicator("Spira Alligator", shorttitle = "Spira Alligator", overlay = true)

// ═══════════════════════════════════════════════════════════════════════════════
// MA FUNKSJONER
// ═══════════════════════════════════════════════════════════════════════════════

wma_custom(src, length) =>
    sum = 0.0
    norm = 0.0
    for i = 0 to length - 1
        weight = length - i
        sum += src[i] * weight
        norm += weight
    sum / norm

ema_f(src, length)  => ta.ema(src, length)
smma_f(src, length) => ta.rma(src, length)

zlema_f(src, length) =>
    lag = math.round((length - 1) / 2)
    ta.ema(src + (src - src[lag]), length)

hma_f(src, length)  => wma_custom(2 * wma_custom(src, length/2) - wma_custom(src, length), math.round(math.sqrt(length)))
tma_f(src, length)  => ta.sma(ta.sma(src, length), length)

hybridMA_f(src, length) =>
    basic_sma = ta.sma(src, length)
    var float hybrid_ma = na
    hybrid_ma := na(hybrid_ma[1]) ? basic_sma : (hybrid_ma[1] * (length - 1) + basic_sma) / length
    hybrid_ma

smoothedMA_f(src, length) =>
    var float s = na
    s := na(s[1]) ? ta.sma(src, length) : (s[1] * (length - 1) + src) / length
    s

zeroLagEMA_f(src, length) =>
    e1 = ema_f(src, length)
    e1 + (e1 - ema_f(e1, length))

superEMA_f(src, length) =>
    e1 = ema_f(src, length)
    e2 = ema_f(e1, length)
    3 * (e1 - e2) + ema_f(e2, length)

atrSeries = ta.atr(14)

trendMA2_f(src, length) =>
    e = ema_f(src, length)
    s = ta.sma(src, length)
    trend = atrSeries / ta.sma(atrSeries, length)
    e * trend + s * (1 - trend)

dema_f(src, length) =>
    e1 = ema_f(src, length)
    2 * e1 - ema_f(e1, length)

tema_f(src, length) =>
    e1 = ema_f(src, length)
    e2 = ema_f(e1, length)
    3 * (e1 - e2) + ema_f(e2, length)

thma_f(src, length) =>
    w1 = wma_custom(src, length/3)
    wma_custom(w1 * 3 - wma_custom(src, length/2) - wma_custom(src, length), length)

calculateMA(ma_type, src, length) =>
    float result = switch ma_type
        "SMA"        => ta.sma(src, length)
        "EMA"        => ema_f(src, length)
        "SMMA (RMA)" => smma_f(src, length)
        "WMA"        => ta.wma(src, length)
        "VWMA"       => ta.vwma(src, length)
        "HullMA"     => hma_f(src, length)
        "TMA"        => tma_f(src, length)
        "HybridMA"   => hybridMA_f(src, length)
        "ZeroLagEMA" => zeroLagEMA_f(src, length)
        "SuperEMA"   => superEMA_f(src, length)
        "TrendMA"    => trendMA2_f(src, length)
        "HMA"        => hma_f(src, length)
        "THMA"       => thma_f(src, length)
        "EHMA"       => ema_f(2 * ema_f(src, length/2) - ema_f(src, length), math.round(math.sqrt(length)))
        "DEMA"       => dema_f(src, length)
        "TEMA"       => tema_f(src, length)
        "TDEMA"      =>
            d1 = dema_f(src, length)
            3 * (d1 - dema_f(d1, length)) + dema_f(dema_f(d1, length), length)
        "TTEMA"      =>
            t1 = tema_f(src, length)
            3 * (t1 - tema_f(t1, length)) + tema_f(tema_f(t1, length), length)
        "ZLEMA"      => zlema_f(src, length)
        "ZLDEMA"     =>
            z1 = zlema_f(src, length)
            2 * z1 - zlema_f(z1, length)
        "ZLTEMA"     =>
            z1 = zlema_f(src, length)
            z2 = zlema_f(z1, length)
            3 * (z1 - z2) + zlema_f(z2, length)
        "DZLEMA"     =>
            z1 = zlema_f(src, length)
            2 * z1 - zlema_f(z1, length)
        "TZLEMA"     =>
            z1 = zlema_f(src, length)
            z2 = zlema_f(z1, length)
            3 * (z1 - z2) + zlema_f(z2, length)
        "LLEMA"      => ema_f(0.25 * src + 0.5 * src[1] + 0.25 * src[2], length)
        "NMA"        =>
            lambda = length / 26
            alpha  = lambda * (length - 1) / (length - lambda)
            e1 = ema_f(src, length)
            (1 + alpha) * e1 - alpha * ema_f(e1, 26)
        "SmoothedMA" => smoothedMA_f(src, length)
        => na
    result

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

grp_ali = "🐊 Williams Alligator"
show_ali     = input.bool(true, "Vis Alligator", group = grp_ali)
ali_type     = input.string("SMMA (RMA)", "MA Type", group = grp_ali,
     options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA", "HullMA", "TMA", "HybridMA",
                "ZeroLagEMA", "SuperEMA", "TrendMA", "HMA", "THMA", "EHMA", "DEMA", "TEMA",
                "TDEMA", "TTEMA", "ZLEMA", "ZLDEMA", "ZLTEMA", "DZLEMA", "TZLEMA",
                "LLEMA", "NMA", "SmoothedMA"])
ali_src      = input.source(hl2, "Kilde (standard: HL2)", group = grp_ali)

lips_length  = input.int(5,  "Lips — Lengde",  group = grp_ali, minval = 1)
lips_offset  = input.int(3,  "Lips — Offset (kun visuelt)", group = grp_ali, minval = 0)
lips_color   = input.color(color.new(#00e676, 0), "Lips — Farge", group = grp_ali)

teeth_length = input.int(8,  "Teeth — Lengde", group = grp_ali, minval = 1)
teeth_offset = input.int(5,  "Teeth — Offset (kun visuelt)", group = grp_ali, minval = 0)
teeth_color  = input.color(color.new(#f44336, 0), "Teeth — Farge", group = grp_ali)

jaw_length   = input.int(13, "Jaw — Lengde",   group = grp_ali, minval = 1)
jaw_offset   = input.int(8,  "Jaw — Offset (kun visuelt)", group = grp_ali, minval = 0)
jaw_color    = input.color(color.new(#2196f3, 0), "Jaw — Farge", group = grp_ali)

grp_trend = "🟡 Trendlinje — EMA 144"
show_trend   = input.bool(true, "Vis trendlinje", group = grp_trend)
trend_type   = input.string("EMA", "MA Type", group = grp_trend,
     options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA", "HullMA", "TMA", "HybridMA",
                "ZeroLagEMA", "SuperEMA", "TrendMA", "HMA", "THMA", "EHMA", "DEMA", "TEMA",
                "TDEMA", "TTEMA", "ZLEMA", "ZLDEMA", "ZLTEMA", "DZLEMA", "TZLEMA",
                "LLEMA", "NMA", "SmoothedMA"])
trend_length = input.int(144, "Lengde (Fibonacci)", group = grp_trend, minval = 1)
trend_color  = input.color(color.yellow, "Farge", group = grp_trend)

grp_sig = "🔔 Signalinnstillinger"
show_signals = input.bool(true, "Vis BUY/SELL signaler",    group = grp_sig)
show_bg      = input.bool(true, "Bakgrunnsfarge ved signal", group = grp_sig)

// ═══════════════════════════════════════════════════════════════════════════════
// BEREGNING — råverdier (offset brukes KUN i plot)
// ═══════════════════════════════════════════════════════════════════════════════

lips_raw  = calculateMA(ali_type, ali_src, lips_length)
teeth_raw = calculateMA(ali_type, ali_src, teeth_length)
jaw_raw   = calculateMA(ali_type, ali_src, jaw_length)
trend_ma  = calculateMA(trend_type, close, trend_length)

// ═══════════════════════════════════════════════════════════════════════════════
// SIGNAL-LOGIKK — ren og enkel, ingen offset-justering
//
// SELL: 1) lips krysser OPP over teeth mens close < trend_ma  (pullback sett)
//        2) lips krysser NED under teeth mens close < trend_ma (signal)
//
// BUY:  1) lips krysser NED under teeth mens close > trend_ma  (pullback sett)
//        2) lips krysser OPP over teeth mens close > trend_ma  (signal)
// ═══════════════════════════════════════════════════════════════════════════════

lips_cross_up   = (lips_raw >  teeth_raw) and (lips_raw[1] <= teeth_raw[1])
lips_cross_down = (lips_raw <  teeth_raw) and (lips_raw[1] >= teeth_raw[1])



var bool bear_pullback_seen = false
var bool bull_pullback_seen = false

// ── BEAR pullback registrert ──────────────────────────────────────────────────
if lips_cross_up and close < trend_ma
    bear_pullback_seen := true

// ── Reset bear hvis pris bryter over trend ────────────────────────────────────
if close > trend_ma
    bear_pullback_seen := false

// ── BULL pullback registrert ──────────────────────────────────────────────────
if lips_cross_down
    bull_pullback_seen := true

// ── Reset bull hvis pris bryter under trend ───────────────────────────────────
if close < trend_ma
    bull_pullback_seen := false

// ── Signaler ──────────────────────────────────────────────────────────────────
// SELL: pullback var sett + lips krysser ned + pris ER under trend akkurat nå
sell_signal = bear_pullback_seen and lips_cross_down and close < trend_ma

// BUY: pullback var sett + lips krysser opp + pris ER over trend akkurat nå
buy_signal  = bull_pullback_seen and lips_cross_up   and close > trend_ma

// Reset etter signal
if sell_signal
    bear_pullback_seen := false

if buy_signal
    bull_pullback_seen := false

// ═══════════════════════════════════════════════════════════════════════════════
// PLOT — offset kun visuelt, påvirker IKKE logikk
// ═══════════════════════════════════════════════════════════════════════════════

plot(show_trend ? trend_ma  : na, "Trendlinje EMA 144", color = trend_color,  linewidth = 3)
plot(show_ali   ? lips_raw  : na, "Lips (Grønn)",       color = lips_color,   linewidth = 1, offset = lips_offset)
plot(show_ali   ? teeth_raw : na, "Teeth (Rød)",        color = teeth_color,  linewidth = 1, offset = teeth_offset)
plot(show_ali   ? jaw_raw   : na, "Jaw (Blå)",          color = jaw_color,    linewidth = 1, offset = jaw_offset)

// ═══════════════════════════════════════════════════════════════════════════════
// SIGNALER
// ═══════════════════════════════════════════════════════════════════════════════

plotshape(show_signals and buy_signal,
     title = "BUY", style = shape.labelup, location = location.belowbar,
     color = color.new(color.lime, 0), textcolor = color.black,
     text = "alligator", size = size.tiny)

plotshape(show_signals and sell_signal,
     title = "SELL", style = shape.labeldown, location = location.abovebar,
     color = color.new(color.red, 0), textcolor = color.white,
     text = "alligator", size = size.tiny)

bgcolor(show_bg and buy_signal  ? color.new(color.lime, 88) : na, title = "BUY bakgrunn")
bgcolor(show_bg and sell_signal ? color.new(color.red,  88) : na, title = "SELL bakgrunn")

// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════

alertcondition(buy_signal,  title = "BUY Signal",  message = "🟢 SPKOA BUY  — Lips krysset over Teeth, pris over EMA 144")
alertcondition(sell_signal, title = "SELL Signal", message = "🔴 SPKOA SELL — Lips krysset under Teeth, pris under EMA 144")

// ═══════════════════════════════════════════════════════════════════════════════
// EXPORT FOR SPIRA
// ═══════════════════════════════════════════════════════════════════════════════

plot(lips_raw,  "SPKOA Lips",     display = display.data_window)
plot(teeth_raw, "SPKOA Teeth",    display = display.data_window)
plot(jaw_raw,   "SPKOA Jaw",      display = display.data_window)
plot(trend_ma,  "SPKOA Trend MA", display = display.data_window)
