//@version=5
indicator("Confluence Buy/Sell [Sub-30min]", overlay=true, max_lines_count=500, max_labels_count=500)

// ─────────────────────────────────────────────────────────────
//  SETTINGS
// ─────────────────────────────────────────────────────────────

g1 = "EMA Trend Filter"
emaFastLen  = input.int(8,   "Fast EMA",   minval=1, group=g1)
emaMidLen   = input.int(21,  "Mid EMA",    minval=1, group=g1)
emaSlowLen  = input.int(50,  "Slow EMA",   minval=1, group=g1)
showEMAs    = input.bool(true, "Show EMAs", group=g1)

g2 = "RSI"
rsiLen      = input.int(14,  "RSI Length",       minval=1,  group=g2)
rsiOB       = input.int(65,  "Overbought Level", minval=50, group=g2)
rsiOS       = input.int(35,  "Oversold Level",   maxval=50, group=g2)

g3 = "Volume"
volLen      = input.int(20,    "Volume MA Length",  minval=1,   group=g3)
volMult     = input.float(1.1, "Volume Multiplier", minval=1.0, step=0.1, group=g3)

g4 = "ATR Stop / Target"
atrLen      = input.int(14,    "ATR Length",           minval=1,   group=g4)
atrStopMult = input.float(1.5, "Stop Loss (x ATR)",    minval=0.5, step=0.1, group=g4)
atrTpMult   = input.float(2.5, "Take Profit (x ATR)",  minval=0.5, step=0.1, group=g4)
showLevels  = input.bool(true,  "Show Stop/Target Lines", group=g4)

g5 = "Higher Timeframe Bias"
htfEnabled  = input.bool(true,  "Enable HTF Filter", group=g5)
htfTF       = input.timeframe("30", "HTF Timeframe", group=g5)

g6 = "Display"
tablePosInput = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Top Center", "Bottom Right", "Bottom Left", "Bottom Center"], group=g6)
showBar     = input.bool(true, "Color Signal Bars", group=g6)


// ─────────────────────────────────────────────────────────────
//  CALCULATIONS
// ─────────────────────────────────────────────────────────────

emaFast = ta.ema(close, emaFastLen)
emaMid  = ta.ema(close, emaMidLen)
emaSlow = ta.ema(close, emaSlowLen)

trendBull = emaFast > emaMid and emaMid > emaSlow
trendBear = emaFast < emaMid and emaMid < emaSlow

rsi         = ta.rsi(close, rsiLen)
rsiBullZone = rsi > rsiOS and rsi < rsiOB and rsi > rsi[1]
rsiBearZone = rsi < rsiOB and rsi > rsiOS and rsi < rsi[1]

volMA      = ta.sma(volume, volLen)
volConfirm = volume > volMA * volMult

atr = ta.atr(atrLen)

[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
macdBullCross = ta.crossover(macdLine, signalLine)
macdBearCross = ta.crossunder(macdLine, signalLine)
macdBull      = macdLine > signalLine
macdBear      = macdLine < signalLine

htfEmaFast = request.security(syminfo.tickerid, htfTF, ta.ema(close, emaFastLen), lookahead=barmerge.lookahead_off)
htfEmaSlow = request.security(syminfo.tickerid, htfTF, ta.ema(close, emaSlowLen), lookahead=barmerge.lookahead_off)
htfBull    = htfEmaFast > htfEmaSlow
htfBear    = htfEmaFast < htfEmaSlow

htfBullGate = htfEnabled ? htfBull : true
htfBearGate = htfEnabled ? htfBear : true


// ─────────────────────────────────────────────────────────────
//  SCORE-BASED CONFLUENCE
//  Fires on MACD cross when 3 out of 4 conditions agree
// ─────────────────────────────────────────────────────────────

bullScore = (trendBull ? 1 : 0) + (rsiBullZone ? 1 : 0) + (macdBull ? 1 : 0) + (htfBullGate ? 1 : 0)
bearScore = (trendBear ? 1 : 0) + (rsiBearZone ? 1 : 0) + (macdBear ? 1 : 0) + (htfBearGate ? 1 : 0)

buySignal  = macdBullCross and bullScore >= 3
sellSignal = macdBearCross and bearScore >= 3

var int lastSignal = 0
buySignal  := buySignal  and lastSignal != 1
sellSignal := sellSignal and lastSignal != -1
if buySignal
    lastSignal := 1
if sellSignal
    lastSignal := -1


// ─────────────────────────────────────────────────────────────
//  STOP LOSS & TAKE PROFIT
// ─────────────────────────────────────────────────────────────

var float buyStop  = na
var float buyTP    = na
var float sellStop = na
var float sellTP   = na

if buySignal
    buyStop  := close - atr * atrStopMult
    buyTP    := close + atr * atrTpMult

if sellSignal
    sellStop := close + atr * atrStopMult
    sellTP   := close - atr * atrTpMult


// ─────────────────────────────────────────────────────────────
//  PLOTS
// ─────────────────────────────────────────────────────────────

plot(showEMAs ? emaFast : na, "EMA Fast (8)",  color=color.new(#00bcd4, 0),  linewidth=1)
plot(showEMAs ? emaMid  : na, "EMA Mid (21)",  color=color.new(#ff9800, 0),  linewidth=1)
plot(showEMAs ? emaSlow : na, "EMA Slow (50)", color=color.new(#9c27b0, 20), linewidth=2)

plotshape(buySignal,  title="BUY",  style=shape.triangleup,
         location=location.belowbar, color=color.new(#26a69a, 0),
         size=size.normal, text="BUY", textcolor=color.white)

plotshape(sellSignal, title="SELL", style=shape.triangledown,
         location=location.abovebar, color=color.new(#ef5350, 0),
         size=size.normal, text="SELL", textcolor=color.white)

plot(showLevels and buySignal  ? buyStop  : na, "Buy Stop",    color=color.new(#ef5350, 0), style=plot.style_linebr, linewidth=1)
plot(showLevels and buySignal  ? buyTP    : na, "Buy Target",  color=color.new(#26a69a, 0), style=plot.style_linebr, linewidth=1)
plot(showLevels and sellSignal ? sellStop : na, "Sell Stop",   color=color.new(#ef5350, 0), style=plot.style_linebr, linewidth=1)
plot(showLevels and sellSignal ? sellTP   : na, "Sell Target", color=color.new(#26a69a, 0), style=plot.style_linebr, linewidth=1)

barcolor(showBar and trendBull ? color.new(#26a69a, 75) :
         showBar and trendBear ? color.new(#ef5350, 75) : na)


// ─────────────────────────────────────────────────────────────
//  INFO TABLE
// ─────────────────────────────────────────────────────────────

tablePos = tablePosInput == "Top Right"    ? position.top_right    :
           tablePosInput == "Top Left"     ? position.top_left     :
           tablePosInput == "Top Center"   ? position.top_center   :
           tablePosInput == "Bottom Right" ? position.bottom_right :
           tablePosInput == "Bottom Left"  ? position.bottom_left  :
                                             position.bottom_center

var table infoBox = table.new(tablePos, 2, 6,
     bgcolor=color.new(#1a1a2e, 10), border_color=color.new(#ffffff, 80), border_width=1, frame_color=color.new(#ffffff, 80), frame_width=1)

if barstate.islast
    trendTxt = trendBull ? "BULLISH" : trendBear ? "BEARISH" : "NEUTRAL"
    trendCol = trendBull ? color.new(#26a69a, 0) : trendBear ? color.new(#ef5350, 0) : color.gray
    htfTxt   = htfEnabled ? (htfBull ? "BULLISH" : "BEARISH") : "OFF"
    htfCol   = htfEnabled ? (htfBull ? color.new(#26a69a, 0) : color.new(#ef5350, 0)) : color.gray
    volTxt   = volConfirm ? "ABOVE AVG" : "BELOW AVG"
    volCol   = volConfirm ? color.new(#26a69a, 0) : color.new(#ef5350, 0)
    scoreTxt = trendBull ? "Bull: " + str.tostring(bullScore) + "/4" : "Bear: " + str.tostring(bearScore) + "/4"

    table.cell(infoBox, 0, 0, "CONFLUENCE", text_color=color.white, text_size=size.small, text_halign=text.align_center, bgcolor=color.new(#0d47a1, 20), width=12, height=6)
    table.cell(infoBox, 1, 0, "SUB-30MIN",  text_color=color.new(#90caf9, 0), text_size=size.small, text_halign=text.align_center, bgcolor=color.new(#0d47a1, 20), width=12, height=6)
    table.cell(infoBox, 0, 1, "Trend",      text_color=color.new(#b0bec5, 0), text_size=size.small, width=12, height=6)
    table.cell(infoBox, 1, 1, trendTxt,     text_color=trendCol, text_size=size.small, width=12, height=6)
    table.cell(infoBox, 0, 2, "HTF Bias",   text_color=color.new(#b0bec5, 0), text_size=size.small, width=12, height=6)
    table.cell(infoBox, 1, 2, htfTxt,       text_color=htfCol, text_size=size.small, width=12, height=6)
    table.cell(infoBox, 0, 3, "RSI",        text_color=color.new(#b0bec5, 0), text_size=size.small, width=12, height=6)
    table.cell(infoBox, 1, 3, str.tostring(math.round(rsi, 1)), text_color=color.white, text_size=size.small, width=12, height=6)
    table.cell(infoBox, 0, 4, "Volume",     text_color=color.new(#b0bec5, 0), text_size=size.small, width=12, height=6)
    table.cell(infoBox, 1, 4, volTxt,       text_color=volCol, text_size=size.small, width=12, height=6)
    table.cell(infoBox, 0, 5, "Score",      text_color=color.new(#b0bec5, 0), text_size=size.small, width=12, height=6)
    table.cell(infoBox, 1, 5, scoreTxt,     text_color=color.white, text_size=size.small, width=12, height=6)


// ─────────────────────────────────────────────────────────────
//  ALERTS
// ─────────────────────────────────────────────────────────────

alertcondition(buySignal,  title="BUY Signal",
     message="BUY -- {{ticker}} | {{interval}} | Price: {{close}}")

alertcondition(sellSignal, title="SELL Signal",
     message="SELL -- {{ticker}} | {{interval}} | Price: {{close}}")

alertcondition(buySignal or sellSignal, title="Any Signal",
     message="SIGNAL -- {{ticker}} | {{interval}} | Price: {{close}}")
