indicator("BTC & Gold 20m Triple-Stack v3 (SMC/ICT) | NEXOUS_cl", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ============================================================================
// INPUTS
// ============================================================================
groupCore    = "Core Confluence (20m)"
atrLenST     = input.int(10,  "Supertrend ATR Length", minval=1, group=groupCore)
atrMultST    = input.float(3, "Supertrend Multiplier", minval=0.1, step=0.1, group=groupCore)
rsiLen       = input.int(14,  "RSI Length", minval=1, group=groupCore)
useStrictRSI = input.bool(true, "Strict RSI (midline cross)", group=groupCore)
showSignals  = input.bool(true, "Show Confluence Signals", group=groupCore)
compactLbl   = input.bool(false, "Compact Labels", group=groupCore)

groupVWAP    = "VWAP"
vwapSrc      = input.source(hlc3, "VWAP Source", group=groupVWAP)
showVWAP     = input.bool(true, "Show VWAP", group=groupVWAP)

groupSess    = "Sessions (Institutional)"
showSessBg   = input.bool(true, "Shade Sessions", group=groupSess)
lonSession   = input.session("0800-1100", "London Kill Zone", group=groupSess)
nySession    = input.session("0830-1100", "NY AM Kill Zone", group=groupSess)
openLineW    = input.int(2, "Open Line Width", minval=1, maxval=5, group=groupSess)

groupKZProj  = "Kill Zone Projection (ATR Sloped Channel)"
showKZProj   = input.bool(true, "Project Sloped KZ Channel at Session End", group=groupKZProj)
projBars     = input.int(36, "Projection Bars (20m bars)", minval=5, maxval=300, group=groupKZProj)
atrLenSlope  = input.int(14, "ATR Length (Slope)", minval=1, group=groupKZProj)
slopeMult    = input.float(0.25, "Slope Multiplier (ATR per bar)", minval=0.0, step=0.05, group=groupKZProj)

groupSMC     = "SMC / ICT Tools"
showSweeps   = input.bool(true, "Liquidity Sweeps", group=groupSMC)
sweepLookback= input.int(20, "Sweep Lookback Bars", minval=5, maxval=200, group=groupSMC)
sweepWickPct = input.float(0.35, "Min Wick Ratio (0-1)", minval=0.05, maxval=0.95, step=0.05, group=groupSMC)

showFVG      = input.bool(true, "Fair Value Gaps (FVG)", group=groupSMC)
fvgExtend    = input.int(60, "FVG Extend Bars", minval=5, maxval=500, group=groupSMC)
fvgMinATR    = input.float(0.15, "Min FVG Size (ATR fraction)", minval=0.0, step=0.05, group=groupSMC)

biasMode     = input.string("Market Structure", "Institutional Bias Filter", options=["Off", "Market Structure", "Session VWAP"], group=groupSMC)
pivotLen     = input.int(3, "Structure Pivot Length", minval=1, maxval=10, group=groupSMC)

groupUX      = "Premium UX"
showTable    = input.bool(true, "Show Status Table", group=groupUX)

// ============================================================================
// CORE: Supertrend + VWAP + RSI
// ============================================================================
[stLine, stDir] = ta.supertrend(atrMultST, atrLenST) // 1 bull, -1 bear
isBullTrend = stDir == 1
isBearTrend = stDir == -1

vwapLine = ta.vwap(vwapSrc)
aboveVW  = close > vwapLine
belowVW  = close < vwapLine

rsi = ta.rsi(close, rsiLen)
rsiBull = useStrictRSI ? ta.crossover(rsi, 50) : rsi > 50
rsiBear = useStrictRSI ? ta.crossunder(rsi, 50) : rsi < 50

// Overlay plots
plot(stLine, "Supertrend", linewidth=2, color=isBullTrend ? color.new(color.lime, 0) : color.new(color.red, 0))
plot(showVWAP ? vwapLine : na, "VWAP", linewidth=2, color=color.new(color.aqua, 0))

// RSI pane (clean minimal)
plot(rsi, "RSI", display=display.pane, linewidth=2, color=color.new(color.gray, 0))
plot(50,  "RSI 50", display=display.pane, linewidth=1, color=color.new(color.blue, 70))

// ============================================================================
// SESSIONS: London + New York (timezone strings)
// ============================================================================
inLondon = not na(time(timeframe.period, lonSession, "Europe/London"))
inNY     = not na(time(timeframe.period, nySession, "America/New_York"))

// Global-scope shading (no local-scope bgcolor)
bgcolor(showSessBg and inLondon ? color.new(color.yellow, 92) : na)
bgcolor(showSessBg and inNY ? color.new(color.orange, 92) : na)

// Session start/end detection
newLon = inLondon and not inLondon[1]
endLon = not inLondon and inLondon[1]
newNY  = inNY and not inNY[1]
endNY  = not inNY and inNY[1]

// London Open / NY Open horizontal lines (open of first bar in session)
var line lonOpenLine = na
var line nyOpenLine  = na

if newLon
    if not na(lonOpenLine)
        line.delete(lonOpenLine)
    lonOpenLine := line.new(bar_index, open, bar_index + 1, open, extend=extend.right, color=color.new(color.yellow, 0), width=openLineW)

if newNY
    if not na(nyOpenLine)
        line.delete(nyOpenLine)
    nyOpenLine := line.new(bar_index, open, bar_index + 1, open, extend=extend.right, color=color.new(color.orange, 0), width=openLineW)

// Track session high/low
var float lonHi = na
var float lonLo = na
var float nyHi  = na
var float nyLo  = na

if newLon
    lonHi := high
    lonLo := low
if inLondon
    lonHi := math.max(lonHi, high)
    lonLo := math.min(lonLo, low)

if newNY
    nyHi := high
    nyLo := low
if inNY
    nyHi := math.max(nyHi, high)
    nyLo := math.min(nyLo, low)

// ============================================================================
// KILL ZONE PROJECTION (ATR sloped channel at session end)
// ============================================================================
atrSlope = ta.atr(atrLenSlope)
slope    = atrSlope * slopeMult

var line lonTop = na
var line lonBot = na
var linefill lonFill = na

var line nyTop = na
var line nyBot = na
var linefill nyFill = na

f_delLine(_l) =>
    if not na(_l)
        line.delete(_l)

f_delFill(_f) =>
    if not na(_f)
        linefill.delete(_f)

if showKZProj and endLon and not na(lonHi) and not na(lonLo)
    f_delFill(lonFill)
    f_delLine(lonTop)
    f_delLine(lonBot)

    int x1 = bar_index
    int x2 = bar_index + projBars
    float yTop1 = lonHi
    float yBot1 = lonLo
    float yTop2 = yTop1 + slope * projBars
    float yBot2 = yBot1 - slope * projBars

    lonTop := line.new(x1, yTop1, x2, yTop2, extend=extend.none, color=color.new(color.yellow, 0), width=3)
    lonBot := line.new(x1, yBot1, x2, yBot2, extend=extend.none, color=color.new(color.yellow, 0), width=3)
    lonFill := linefill.new(lonTop, lonBot, color=color.new(color.yellow, 88))

if showKZProj and endNY and not na(nyHi) and not na(nyLo)
    f_delFill(nyFill)
    f_delLine(nyTop)
    f_delLine(nyBot)

    int x1n = bar_index
    int x2n = bar_index + projBars
    float yTop1n = nyHi
    float yBot1n = nyLo
    float yTop2n = yTop1n + slope * projBars
    float yBot2n = yBot1n - slope * projBars

    nyTop := line.new(x1n, yTop1n, x2n, yTop2n, extend=extend.none, color=color.new(color.yellow, 0), width=3)
    nyBot := line.new(x1n, yBot1n, x2n, yBot2n, extend=extend.none, color=color.new(color.yellow, 0), width=3)
    nyFill := linefill.new(nyTop, nyBot, color=color.new(color.yellow, 88))

// ============================================================================
// INSTITUTIONAL BIAS FILTER
// Options:
// - Off: no bias filter
// - Market Structure: bias from last pivot break (BOS style)
// - Session VWAP: bias bullish if above VWAP and in session, bearish if below VWAP and in session
// ============================================================================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastPH = na
var float lastPL = na

if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

// Simple BOS-style bias:
var int structBias = 0 // 1 bullish, -1 bearish, 0 neutral
bullBreak = not na(lastPH) and close > lastPH
bearBreak = not na(lastPL) and close < lastPL
if bullBreak
    structBias := 1
if bearBreak
    structBias := -1

sessBias = (inLondon or inNY) ? (aboveVW ? 1 : belowVW ? -1 : 0) : 0

bias =
     biasMode == "Off" ? 0 :
     biasMode == "Market Structure" ? structBias :
     biasMode == "Session VWAP" ? sessBias : 0

biasBull = bias == 1
biasBear = bias == -1
biasNeutral = bias == 0

// ============================================================================
// LIQUIDITY SWEEP DETECTION (basic but robust)
// Sweep High: breaks prior high and closes back below that high with strong upper wick
// Sweep Low: breaks prior low and closes back above that low with strong lower wick
// ============================================================================
prevHigh = ta.highest(high[1], sweepLookback)
prevLow  = ta.lowest(low[1], sweepLookback)

rng = math.max(high - low, syminfo.mintick)
upperWick = (high - math.max(open, close)) / rng
lowerWick = (math.min(open, close) - low) / rng

sweepHigh = showSweeps and high > prevHigh and close < prevHigh and upperWick >= sweepWickPct
sweepLow  = showSweeps and low < prevLow and close > prevLow and lowerWick >= sweepWickPct

plotshape(sweepHigh, title="Liquidity Sweep High", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny, text="SWP")
plotshape(sweepLow,  title="Liquidity Sweep Low",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 0), size=size.tiny, text="SWP")

// ============================================================================
// FAIR VALUE GAP (FVG) DETECTION + BOXES
// Bullish FVG: low (bar 0) > high (bar 2)
// Bearish FVG: high (bar 0) < low (bar 2)
// Use ATR fraction filter to avoid micro-gaps.
// ============================================================================
atrF = ta.atr(14)
minGap = atrF * fvgMinATR

bullFVG = showFVG and (low > high[2]) and (low - high[2] >= minGap)
bearFVG = showFVG and (high < low[2]) and (low[2] - high >= minGap)

var box[] fvgBoxes = array.new_box()

f_addBox(_left, _top, _right, _bot, _col) =>
    b = box.new(_left, _top, _right, _bot, bgcolor=_col, border_color=color.new(_col, 0))
    array.push(fvgBoxes, b)
    // Keep array size sane
    if array.size(fvgBoxes) > 60
        bx = array.shift(fvgBoxes)
        box.delete(bx)

if bullFVG
    // Gap between high[2] (lower) and low (upper) -> draw zone
    f_addBox(bar_index - 2, low, bar_index - 2 + fvgExtend, high[2], color.new(color.lime, 88))

if bearFVG
    // Gap between high (lower) and low[2] (upper)
    f_addBox(bar_index - 2, low[2], bar_index - 2 + fvgExtend, high, color.new(color.red, 88))

// ============================================================================
// CONFLUENCE SIGNALS (with Bias Filter)
// ============================================================================
baseLong  = isBullTrend and aboveVW and rsiBull
baseShort = isBearTrend and belowVW and rsiBear

// Apply bias filter (if bias != 0, require alignment)
longOK  = baseLong  and (biasMode == "Off" or biasBull)
shortOK = baseShort and (biasMode == "Off" or biasBear)

if showSignals and longOK
    label.new(bar_index, low, compactLbl ? "L" : "LONG\nST↑ VWAP↑ RSI↑\nBIAS✓", style=label.style_label_up, textcolor=color.white, color=color.new(color.lime, 0))

if showSignals and shortOK
    label.new(bar_index, high, compactLbl ? "S" : "SHORT\nST↓ VWAP↓ RSI↓\nBIAS✓", style=label.style_label_down, textcolor=color.white, color=color.new(color.red, 0))

// ============================================================================
// SMART ALERTS
// ============================================================================
alertcondition(longOK,  title="NEXOUS_cl v3 LONG (Confluence + Bias)",  message="LONG: Supertrend bullish + above VWAP + RSI confirm + Bias aligned (20m).")
alertcondition(shortOK, title="NEXOUS_cl v3 SHORT (Confluence + Bias)", message="SHORT: Supertrend bearish + below VWAP + RSI confirm + Bias aligned (20m).")

alertcondition(newLon, title="London KZ START", message="London Kill Zone started.")
alertcondition(endLon, title="London KZ END",   message="London Kill Zone ended. Projection channel updated.")
alertcondition(newNY,  title="NY KZ START",     message="New York Kill Zone started.")
alertcondition(endNY,  title="NY KZ END",       message="New York Kill Zone ended. Projection channel updated.")

alertcondition(sweepHigh, title="Liquidity Sweep HIGH", message="Liquidity sweep HIGH detected (run above highs then rejection).")
alertcondition(sweepLow,  title="Liquidity Sweep LOW",  message="Liquidity sweep LOW detected (run below lows then rejection).")

alertcondition(bullFVG, title="Bullish FVG", message="Bullish Fair Value Gap detected.")
alertcondition(bearFVG, title="Bearish FVG", message="Bearish Fair Value Gap detected.")

// ============================================================================
// PREMIUM STATUS TABLE
// ============================================================================
var table t = table.new(position.top_right, 2, 7, border_width=1)

if showTable
    table.cell(t, 0, 0, "NEXOUS_cl v3", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(t, 1, 0, "20m", text_color=color.white, bgcolor=color.new(color.black, 0))

    table.cell(t, 0, 1, "Bias", text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(t, 1, 1, biasBull ? "BULL" : biasBear ? "BEAR" : "NEUTRAL",
      text_color=color.white,
      bgcolor=biasBull ? color.new(color.lime, 25) : biasBear ? color.new(color.red, 25) : color.new(color.gray, 70))

    table.cell(t, 0, 2, "Trend", text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(t, 1, 2, isBullTrend ? "BULL" : "BEAR", text_color=color.white,
      bgcolor=isBullTrend ? color.new(color.lime, 25) : color.new(color.red, 25))

    table.cell(t, 0, 3, "VWAP", text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(t, 1, 3, aboveVW ? "ABOVE" : "BELOW", text_color=color.white,
      bgcolor=aboveVW ? color.new(color.aqua, 25) : color.new(color.gray, 70))

    table.cell(t, 0, 4, "RSI", text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(t, 1, 4, str.tostring(math.round(rsi)), text_color=color.white, bgcolor=color.new(color.gray, 70))

    table.cell(t, 0, 5, "Session", text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(t, 1, 5, inLondon ? "LONDON" : inNY ? "NEW YORK" : "OFF",
      text_color=color.white,
      bgcolor=inLondon ? color.new(color.yellow, 30) : inNY ? color.new(color.orange, 30) : color.new(color.gray, 70))

    table.cell(t, 0, 6, "SMC", text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(t, 1, 6, (sweepHigh or sweepLow) ? "SWEEP" : (bullFVG or bearFVG) ? "FVG" : "—",
      text_color=color.white,
      bgcolor=(sweepHigh or sweepLow) ? color.new(color.fuchsia, 35) : (bullFVG or bearFVG) ? color.new(color.blue, 35) : color.new(color.gray, 70))
