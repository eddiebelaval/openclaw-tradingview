//@version=5
indicator("Clean EMA Cross + Continuation (Tabs Only)", overlay=true, max_labels_count=500)

//====================
// Inputs
//====================
grpEma = "EMAs"
emaFastLen = input.int(9,  "Fast EMA", minval=1, group=grpEma)
emaSlowLen = input.int(21, "Slow EMA", minval=1, group=grpEma)

grpSignals = "Signals"
showCrossSignals = input.bool(true, "Show EMA Cross BUY/SELL", group=grpSignals)
showContinuation = input.bool(true, "Show Continuation Entries", group=grpSignals)

grpCont = "Continuation Settings"
pullbackMode = input.string("Touch EMA9", "Pullback Rule",
     options=["Touch EMA9", "Touch EMA Zone (9-21)"], group=grpCont)
minBarsAfterCross = input.int(3, "Min bars after cross before continuation", minval=0, group=grpCont)
cooldownBars = input.int(6, "Cooldown bars between continuation signals", minval=0, group=grpCont)

grpStyle = "Style"
buyColor  = input.color(color.lime, "Buy Color", group=grpStyle)
sellColor = input.color(color.red,  "Sell Color", group=grpStyle)
tabSize   = input.string("normal", "Tab Size", options=["tiny","small","normal","large"], group=grpStyle)

grpClean = "Clutter Control"
keepLastLabels = input.int(30, "Keep last N labels (older removed)", minval=5, maxval=300, group=grpClean)

//====================
// Core
//====================
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

trendUp = emaFast > emaSlow
trendDn = emaFast < emaSlow

crossUp = ta.crossover(emaFast, emaSlow)
crossDn = ta.crossunder(emaFast, emaSlow)

// EMA zone
zoneLow  = math.min(emaFast, emaSlow)
zoneHigh = math.max(emaFast, emaSlow)

// Pullback touch rules
touchBuy =
     pullbackMode == "Touch EMA9" ? (low <= emaFast) :
     (low <= zoneHigh and high >= zoneLow)

touchSell =
     pullbackMode == "Touch EMA9" ? (high >= emaFast) :
     (high >= zoneLow and low <= zoneHigh)

// Confirmation back with trend (simple and clean)
confirmBuy  = touchBuy  and close > emaFast
confirmSell = touchSell and close < emaFast

// Track last cross bar index so continuation doesn’t fire immediately
var int lastCrossBar = na
if crossUp or crossDn
    lastCrossBar := bar_index

barsSinceCross = na(lastCrossBar) ? 10000 : (bar_index - lastCrossBar)

// Cooldown so it doesn’t spam continuation
var int lastContBuyBar  = na
var int lastContSellBar = na

canContBuy  = na(lastContBuyBar)  ? true : (bar_index - lastContBuyBar  > cooldownBars)
canContSell = na(lastContSellBar) ? true : (bar_index - lastContSellBar > cooldownBars)

// Continuation signals (only in-trend, after a cross, and with cooldown)
contBuy  = showContinuation and trendUp and barsSinceCross >= minBarsAfterCross and canContBuy  and confirmBuy
contSell = showContinuation and trendDn and barsSinceCross >= minBarsAfterCross and canContSell and confirmSell

if contBuy
    lastContBuyBar := bar_index
if contSell
    lastContSellBar := bar_index

//====================
// Label size + label limiter
//====================
labSize =
     tabSize == "tiny"   ? size.tiny  :
     tabSize == "small"  ? size.small :
     tabSize == "large"  ? size.large :
                           size.normal

var label[] labs = array.new_label()

f_addLabel(_x, _y, _txt, _style, _bg) =>
    lb = label.new(_x, _y, _txt, style=_style, color=_bg, textcolor=color.white, size=labSize)
    array.push(labs, lb)
    if array.size(labs) > keepLastLabels
        old = array.shift(labs)
        label.delete(old)

//====================
// Plot Signals (Tabs Only)
//====================
if showCrossSignals and crossUp
    f_addLabel(bar_index, low, " BUY (X) ", label.style_label_up, buyColor)

if showCrossSignals and crossDn
    f_addLabel(bar_index, high, " SELL (X) ", label.style_label_down, sellColor)

if contBuy
    f_addLabel(bar_index, low, " BUY (C) ", label.style_label_up, buyColor)

if contSell
    f_addLabel(bar_index, high, " SELL (C) ", label.style_label_down, sellColor)

//====================
// Alerts
//====================
alertcondition(showCrossSignals and crossUp, "BUY Cross", "BUY: EMA Fast crossed ABOVE EMA Slow on {{ticker}} {{interval}}")
alertcondition(showCrossSignals and crossDn, "SELL Cross", "SELL: EMA Fast crossed BELOW EMA Slow on {{ticker}} {{interval}}")
alertcondition(contBuy, "BUY Continuation", "BUY Continuation: pullback confirmed in uptrend on {{ticker}} {{interval}}")
alertcondition(contSell, "SELL Continuation", "SELL Continuation: pullback confirmed in downtrend on {{ticker}} {{interval}}")
