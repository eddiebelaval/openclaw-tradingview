//@version=6
indicator(title="6 EMA Setup", shorttitle="6 EMA", overlay=true, timeframe="", timeframe_gaps=true)

// Source
src = input.source(close, title="Source")
offset = input.int(title="Offset", defval=0, minval=-500, maxval=500)

// ─────────────────────────────
// EMA Inputs
// ─────────────────────────────
group1 = "EMA 1"
showEma1 = input.bool(true, "Show EMA 1", group=group1)
len1 = input.int(9, minval=1, title="Length 1", group=group1)
color1 = input.color(color.blue, "Color 1", group=group1)

group2 = "EMA 2"
showEma2 = input.bool(true, "Show EMA 2", group=group2)
len2 = input.int(21, minval=1, title="Length 2", group=group2)
color2 = input.color(color.orange, "Color 2", group=group2)

group3 = "EMA 3"
showEma3 = input.bool(true, "Show EMA 3", group=group3)
len3 = input.int(34, minval=1, title="Length 3", group=group3)
color3 = input.color(color.green, "Color 3", group=group3)

group4 = "EMA 4"
showEma4 = input.bool(true, "Show EMA 4", group=group4)
len4 = input.int(89, minval=1, title="Length 4", group=group4)
color4 = input.color(color.red, "Color 4", group=group4)

group5 = "EMA 5"
showEma5 = input.bool(true, "Show EMA 5", group=group5)
len5 = input.int(200, minval=1, title="Length 5", group=group5)
color5 = input.color(color.purple, "Color 5", group=group5)

group6 = "EMA 6"
showEma6 = input.bool(true, "Show EMA 6", group=group6)
len6 = input.int(500, minval=1, title="Length 6", group=group6)
color6 = input.color(color.gray, "Color 6", group=group6)

// ─────────────────────────────
// EMA Calculations
// ─────────────────────────────
ema1 = ta.ema(src, len1)
ema2 = ta.ema(src, len2)
ema3 = ta.ema(src, len3)
ema4 = ta.ema(src, len4)
ema5 = ta.ema(src, len5)
ema6 = ta.ema(src, len6)

// ─────────────────────────────
// Dashed effect helper
// Pine plot() has no true dashed line,
// so this simulates dashed lines.
// ─────────────────────────────
dashLen = input.int(3, "Dash Length", minval=1, maxval=20, group="Dash Settings")
gapLen  = input.int(3, "Gap Length", minval=1, maxval=20, group="Dash Settings")
dashCycle = dashLen + gapLen
isDashOn = (bar_index % dashCycle) < dashLen

// ─────────────────────────────
// Plots
// 9 and 21 = solid
// Others = dashed-look
// ─────────────────────────────
plot(showEma1 ? ema1 : na, title="EMA 9", color=color1, offset=offset, linewidth=2)
plot(showEma2 ? ema2 : na, title="EMA 21", color=color2, offset=offset, linewidth=2)

plot(showEma3 and isDashOn ? ema3 : na, title="EMA 34", color=color3, offset=offset, linewidth=2, style=plot.style_linebr)
plot(showEma4 and isDashOn ? ema4 : na, title="EMA 89", color=color4, offset=offset, linewidth=2, style=plot.style_linebr)
plot(showEma5 and isDashOn ? ema5 : na, title="EMA 200", color=color5, offset=offset, linewidth=2, style=plot.style_linebr)
plot(showEma6 and isDashOn ? ema6 : na, title="EMA 500", color=color6, offset=offset, linewidth=2, style=plot.style_linebr)
