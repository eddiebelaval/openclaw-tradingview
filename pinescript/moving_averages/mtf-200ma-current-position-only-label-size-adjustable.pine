//@version=6
indicator("MTF 200MA - Current Position Only (Label Size Adjustable)", overlay=true, max_lines_count=500, max_labels_count=500)

//=========================
// Inputs
//=========================
grpMain = "Main"
useStableHTF = input.bool(true, "Use confirmed HTF value (stable)", group=grpMain)
lineLenBars  = input.int(4, "Line length (bars)", minval=1, maxval=50, group=grpMain)
lineWidth    = input.int(3, "Line width", minval=1, maxval=5, group=grpMain)

grpLabel = "Labels"
showLabels   = input.bool(true, "Show TF labels", group=grpLabel)
labelOffset  = input.int(1, "Label offset (bars to right)", minval=0, maxval=20, group=grpLabel)
labelSizeIn  = input.string("Small", "Label Size", options=["Tiny","Small","Normal","Large","Huge"], group=grpLabel)
labelTransp  = input.int(0, "Label BG Transparency (0-100)", minval=0, maxval=100, group=grpLabel)

grpCol = "Colors"
bullCol = input.color(color.aqua, "Bull color (price >= MA)", group=grpCol)
bearCol = input.color(color.red,  "Bear color (price <  MA)", group=grpCol)

//=========================
// Alerts
//=========================
grpAl = "Alerts"
enableAlerts = input.bool(true, "Enable alerts", group=grpAl)

al5   = input.bool(true,  "Alert: M5 cross",  group=grpAl)
al15  = input.bool(true,  "Alert: M15 cross", group=grpAl)
al30  = input.bool(true,  "Alert: M30 cross", group=grpAl)
al60  = input.bool(true,  "Alert: H1 cross",  group=grpAl)
al240 = input.bool(true,  "Alert: H4 cross",  group=grpAl)
alD   = input.bool(true,  "Alert: D1 cross",  group=grpAl)

alAny = input.bool(false, "Alert: ANY TF cross (single condition)", group=grpAl)

// label size mapping
labelSize =
     labelSizeIn == "Tiny"   ? size.tiny  :
     labelSizeIn == "Small"  ? size.small :
     labelSizeIn == "Normal" ? size.normal :
     labelSizeIn == "Large"  ? size.large :
     size.huge

//=========================
// MA getter
//=========================
f_ma200(tf) =>
    expr = useStableHTF ? ta.sma(close, 200)[1] : ta.sma(close, 200)
    request.security(syminfo.tickerid, tf, expr, barmerge.gaps_off, barmerge.lookahead_off)

//=========================
// MTF 200MA values
//=========================
ma5   = f_ma200("5")
ma15  = f_ma200("15")
ma30  = f_ma200("30")
ma60  = f_ma200("60")
ma240 = f_ma200("240")
maD   = f_ma200("1440")

//=========================
// Alert logic (cross only, no spam)
//=========================
cUp(_ma) => not na(_ma) and ta.crossover(close, _ma)
cDn(_ma) => not na(_ma) and ta.crossunder(close, _ma)

up5   = enableAlerts and al5   and cUp(ma5)
dn5   = enableAlerts and al5   and cDn(ma5)

up15  = enableAlerts and al15  and cUp(ma15)
dn15  = enableAlerts and al15  and cDn(ma15)

up30  = enableAlerts and al30  and cUp(ma30)
dn30  = enableAlerts and al30  and cDn(ma30)

up60  = enableAlerts and al60  and cUp(ma60)
dn60  = enableAlerts and al60  and cDn(ma60)

up240 = enableAlerts and al240 and cUp(ma240)
dn240 = enableAlerts and al240 and cDn(ma240)

upD   = enableAlerts and alD   and cUp(maD)
dnD   = enableAlerts and alD   and cDn(maD)

// Individual alertconditions (set alerts in TradingView)
alertcondition(up5,   title="M5: Cross ABOVE 200MA",  message="M5: Price crossed ABOVE 200MA")
alertcondition(dn5,   title="M5: Cross BELOW 200MA",  message="M5: Price crossed BELOW 200MA")

alertcondition(up15,  title="M15: Cross ABOVE 200MA", message="M15: Price crossed ABOVE 200MA")
alertcondition(dn15,  title="M15: Cross BELOW 200MA", message="M15: Price crossed BELOW 200MA")

alertcondition(up30,  title="M30: Cross ABOVE 200MA", message="M30: Price crossed ABOVE 200MA")
alertcondition(dn30,  title="M30: Cross BELOW 200MA", message="M30: Price crossed BELOW 200MA")

alertcondition(up60,  title="H1: Cross ABOVE 200MA",  message="H1: Price crossed ABOVE 200MA")
alertcondition(dn60,  title="H1: Cross BELOW 200MA",  message="H1: Price crossed BELOW 200MA")

alertcondition(up240, title="H4: Cross ABOVE 200MA",  message="H4: Price crossed ABOVE 200MA")
alertcondition(dn240, title="H4: Cross BELOW 200MA",  message="H4: Price crossed BELOW 200MA")

alertcondition(upD,   title="D1: Cross ABOVE 200MA",  message="D1: Price crossed ABOVE 200MA")
alertcondition(dnD,   title="D1: Cross BELOW 200MA",  message="D1: Price crossed BELOW 200MA")

// Optional: ANY TF (single alert you can choose)
anyUp = enableAlerts and alAny and (cUp(ma5) or cUp(ma15) or cUp(ma30) or cUp(ma60) or cUp(ma240) or cUp(maD))
anyDn = enableAlerts and alAny and (cDn(ma5) or cDn(ma15) or cDn(ma30) or cDn(ma60) or cDn(ma240) or cDn(maD))
alertcondition(anyUp, title="ANY TF: Cross ABOVE 200MA", message="ANY TF: Price crossed ABOVE a 200MA (one of M5/M15/M30/H1/H4/D1)")
alertcondition(anyDn, title="ANY TF: Cross BELOW 200MA", message="ANY TF: Price crossed BELOW a 200MA (one of M5/M15/M30/H1/H4/D1)")

//=========================
// Persistent objects
//=========================
var line  ln5   = na
var line  ln15  = na
var line  ln30  = na
var line  ln60  = na
var line  ln240 = na
var line  lnD   = na

var label lb5   = na
var label lb15  = na
var label lb30  = na
var label lb60  = na
var label lb240 = na
var label lbD   = na

//=========================
// Draw only at last bar
//=========================
if barstate.islast
    int x2 = bar_index
    int x1 = bar_index - (lineLenBars - 1)
    int lx = bar_index + labelOffset

    // ---------- 5m ----------
    if not na(ln5)
        line.delete(ln5)
    if not na(lb5)
        label.delete(lb5)

    col5 = na(ma5) ? color.gray : (close >= ma5 ? bullCol : bearCol)
    if not na(ma5)
        ln5 := line.new(x1, ma5, x2, ma5, xloc=xloc.bar_index, extend=extend.none, color=col5, width=lineWidth)
        if showLabels
            lb5 := label.new(lx, ma5, "M5 200", xloc=xloc.bar_index, style=label.style_label_left,
                color=color.new(col5, labelTransp), textcolor=color.white, size=labelSize)

    // ---------- 15m ----------
    if not na(ln15)
        line.delete(ln15)
    if not na(lb15)
        label.delete(lb15)

    col15 = na(ma15) ? color.gray : (close >= ma15 ? bullCol : bearCol)
    if not na(ma15)
        ln15 := line.new(x1, ma15, x2, ma15, xloc=xloc.bar_index, extend=extend.none, color=col15, width=lineWidth)
        if showLabels
            lb15 := label.new(lx, ma15, "M15 200", xloc=xloc.bar_index, style=label.style_label_left,
                color=color.new(col15, labelTransp), textcolor=color.white, size=labelSize)

    // ---------- 30m ----------
    if not na(ln30)
        line.delete(ln30)
    if not na(lb30)
        label.delete(lb30)

    col30 = na(ma30) ? color.gray : (close >= ma30 ? bullCol : bearCol)
    if not na(ma30)
        ln30 := line.new(x1, ma30, x2, ma30, xloc=xloc.bar_index, extend=extend.none, color=col30, width=lineWidth)
        if showLabels
            lb30 := label.new(lx, ma30, "M30 200", xloc=xloc.bar_index, style=label.style_label_left,
                color=color.new(col30, labelTransp), textcolor=color.white, size=labelSize)

    // ---------- 60m ----------
    if not na(ln60)
        line.delete(ln60)
    if not na(lb60)
        label.delete(lb60)

    col60 = na(ma60) ? color.gray : (close >= ma60 ? bullCol : bearCol)
    if not na(ma60)
        ln60 := line.new(x1, ma60, x2, ma60, xloc=xloc.bar_index, extend=extend.none, color=col60, width=lineWidth)
        if showLabels
            lb60 := label.new(lx, ma60, "H1 200", xloc=xloc.bar_index, style=label.style_label_left,
                color=color.new(col60, labelTransp), textcolor=color.white, size=labelSize)

    // ---------- 240m ----------
    if not na(ln240)
        line.delete(ln240)
    if not na(lb240)
        label.delete(lb240)

    col240 = na(ma240) ? color.gray : (close >= ma240 ? bullCol : bearCol)
    if not na(ma240)
        ln240 := line.new(x1, ma240, x2, ma240, xloc=xloc.bar_index, extend=extend.none, color=col240, width=lineWidth)
        if showLabels
            lb240 := label.new(lx, ma240, "H4 200", xloc=xloc.bar_index, style=label.style_label_left,
                color=color.new(col240, labelTransp), textcolor=color.white, size=labelSize)

    // ---------- D1 ----------
    if not na(lnD)
        line.delete(lnD)
    if not na(lbD)
        label.delete(lbD)

    colD = na(maD) ? color.gray : (close >= maD ? bullCol : bearCol)
    if not na(maD)
        lnD := line.new(x1, maD, x2, maD, xloc=xloc.bar_index, extend=extend.none, color=colD, width=lineWidth)
        if showLabels
            lbD := label.new(lx, maD, "D1 200", xloc=xloc.bar_index, style=label.style_label_left,
                color=color.new(colD, labelTransp), textcolor=color.white, size=labelSize)
