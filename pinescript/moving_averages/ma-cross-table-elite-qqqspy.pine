//@version=6
indicator("MA CROSS-TABLE - ELITE + QQQ/SPY)", overlay = false, max_bars_back = 500)

// ────────────────────────────────────────────────────────────────
// INPUTS
// ────────────────────────────────────────────────────────────────
bar1_len   = input.int(10,   "Bar MA 1 Length")
bar2_len   = input.int(20,   "Bar MA 2 Length")
day1_len   = input.int(10,   "Day MA 1 Length")
day2_len   = input.int(20,   "Day MA 2 Length")
day3_len   = input.int(50,   "Day MA 3 Length")
day4_len   = input.int(100,  "Day MA 4 Length")
day5_len   = input.int(200,  "Day MA 5 Length")
maType     = input.string("SMA", "MA Type", options = ["SMA", "EMA"])
vol_ma_len = input.int(50,   "Volume MA Length")

stretch_extreme  = input.float(10, "Extreme Stretch %", minval = 1,   maxval = 50)
stretch_moderate = input.float(5,  "Moderate Stretch %", minval = 0.5, maxval = 25)
vol_high_ratio   = input.float(1.5, "Volume High Ratio", minval = 1.1, maxval = 5)
vol_low_ratio    = input.float(0.7, "Volume Low Ratio", minval = 0.1, maxval = 0.9)
near_zero_thresh = input.float(0.3, "Near Zero % Threshold", minval = 0.1, maxval = 2)
rsi_len          = input.int(14,   "RSI Length (for Current)", minval = 2, maxval = 100)

// Index symbols
qqq_sym = input.symbol("NASDAQ:QQQ", "QQQ Symbol", group = "Index RSI Comparison")
spy_sym = input.symbol("AMEX:SPY",   "SPY Symbol",  group = "Index RSI Comparison")

// Table position & size
table_position_input = input.string("Top Right", "Table Position", 
     options = ["Top Left", "Top Center", "Top Right", 
                "Middle Left", "Middle Center", "Middle Right", 
                "Bottom Left", "Bottom Center", "Bottom Right"])

use_custom_size  = input.bool(true,  "Use Custom Text Size")
custom_text_size = input.int(17,     "Custom Size (points) — try 15–22", minval = 8, maxval = 36, step = 1)
preset_size_input = input.string("Normal", "Preset Size (if custom off)", 
     options = ["Tiny", "Small", "Normal", "Large", "Huge"])

// ────────────────────────────────────────────────────────────────
// LABELS
// ────────────────────────────────────────────────────────────────
bar1_label = "BAR MA " + str.tostring(bar1_len)
bar2_label = "BAR MA " + str.tostring(bar2_len)
day1_label = "DAY MA " + str.tostring(day1_len)
day2_label = "DAY MA " + str.tostring(day2_len)
day3_label = "DAY MA " + str.tostring(day3_len)
day4_label = "DAY MA " + str.tostring(day4_len)
day5_label = "DAY MA " + str.tostring(day5_len)

// ────────────────────────────────────────────────────────────────
// HELPERS
// ────────────────────────────────────────────────────────────────
get_position(pos_str) =>
    switch pos_str
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right"  => position.bottom_right
        => position.top_right

get_text_size() =>
    int sz = 14
    if use_custom_size
        sz := custom_text_size
    else
        sz := switch preset_size_input
            "Tiny"   => 10
            "Small"  => 12
            "Normal" => 14
            "Large"  => 18
            "Huge"   => 24
            => 14
    sz

safe_div(num, den) => den == 0 ? 0.0 : num / den
safe_pct(num, den) => den == 0 ? 0.0 : (num - den) / den * 100

f_get_ma(tf, len) =>
    request.security(syminfo.tickerid, tf, 
        maType == "SMA" ? ta.sma(close, len) : ta.ema(close, len), 
        lookahead = barmerge.lookahead_off)

f_get_rsi(tf, len) =>
    request.security(syminfo.tickerid, tf, ta.rsi(close, len), lookahead = barmerge.lookahead_off)

f_get_rsi_index(sym, tf, len) =>
    request.security(sym, tf, ta.rsi(close, len), lookahead = barmerge.lookahead_off)

// ────────────────────────────────────────────────────────────────
// DATA — Symbol
// ────────────────────────────────────────────────────────────────
price  = close
vol    = volume
vol_ma = ta.sma(vol, vol_ma_len)

ma1b = maType == "SMA" ? ta.sma(price, bar1_len) : ta.ema(price, bar1_len)
ma2b = maType == "SMA" ? ta.sma(price, bar2_len) : ta.ema(price, bar2_len)

ma1d = f_get_ma("D", day1_len)
ma2d = f_get_ma("D", day2_len)
ma3d = f_get_ma("D", day3_len)
ma4d = f_get_ma("D", day4_len)
ma5d = f_get_ma("D", day5_len)

rsi_current = ta.rsi(price, rsi_len)
rsi1b       = ta.rsi(price, bar1_len)
rsi2b       = ta.rsi(price, bar2_len)
rsi1d       = f_get_rsi("D", day1_len)
rsi2d       = f_get_rsi("D", day2_len)
rsi3d       = f_get_rsi("D", day3_len)
rsi4d       = f_get_rsi("D", day4_len)
rsi5d       = f_get_rsi("D", day5_len)

// ────────────────────────────────────────────────────────────────
// QQQ & SPY RSIs — per-period matching the symbol's rows
// ────────────────────────────────────────────────────────────────
qqq_rsi_current = f_get_rsi_index(qqq_sym, timeframe.period, rsi_len)
qqq_rsi1b       = f_get_rsi_index(qqq_sym, timeframe.period, bar1_len)
qqq_rsi2b       = f_get_rsi_index(qqq_sym, timeframe.period, bar2_len)
qqq_rsi1d       = f_get_rsi_index(qqq_sym, "D", day1_len)
qqq_rsi2d       = f_get_rsi_index(qqq_sym, "D", day2_len)
qqq_rsi3d       = f_get_rsi_index(qqq_sym, "D", day3_len)
qqq_rsi4d       = f_get_rsi_index(qqq_sym, "D", day4_len)
qqq_rsi5d       = f_get_rsi_index(qqq_sym, "D", day5_len)

spy_rsi_current = f_get_rsi_index(spy_sym, timeframe.period, rsi_len)
spy_rsi1b       = f_get_rsi_index(spy_sym, timeframe.period, bar1_len)
spy_rsi2b       = f_get_rsi_index(spy_sym, timeframe.period, bar2_len)
spy_rsi1d       = f_get_rsi_index(spy_sym, "D", day1_len)
spy_rsi2d       = f_get_rsi_index(spy_sym, "D", day2_len)
spy_rsi3d       = f_get_rsi_index(spy_sym, "D", day3_len)
spy_rsi4d       = f_get_rsi_index(spy_sym, "D", day4_len)
spy_rsi5d       = f_get_rsi_index(spy_sym, "D", day5_len)

// ────────────────────────────────────────────────────────────────
// Chained RSI Deltas (symbol only)
// ────────────────────────────────────────────────────────────────
float rsi_delta_cur   = rsi_current - rsi1b
float rsi_delta_bar1  = rsi1b       - rsi2b
float rsi_delta_bar2  = rsi2b       - rsi1d
float rsi_delta_day1  = rsi1d       - rsi2d
float rsi_delta_day2  = rsi2d       - rsi3d
float rsi_delta_day3  = rsi3d       - rsi4d
float rsi_delta_day4  = rsi4d       - rsi5d
float rsi_delta_day5  = na

// ────────────────────────────────────────────────────────────────
// ATR Calculations
// ────────────────────────────────────────────────────────────────
float atr_current     = ta.atr(14)
float atr_current_pct = (atr_current / close) * 100

float atr_daily_raw   = request.security(syminfo.tickerid, "D", ta.atr(14), lookahead = barmerge.lookahead_off)
float atr_daily_close = request.security(syminfo.tickerid, "D", close, lookahead = barmerge.lookahead_off)
float atr_daily_pct   = na(atr_daily_close) ? na : (atr_daily_raw / atr_daily_close) * 100

// ────────────────────────────────────────────────────────────────
// PRICE RELATION
// ────────────────────────────────────────────────────────────────
price_rel_2 = price > ma1b * 1.005 ? "↑" : price < ma1b * 0.995 ? "↓" : "="
price_rel_3 = price > ma2b * 1.005 ? "↑" : price < ma2b * 0.995 ? "↓" : "="
price_rel_4 = price > ma1d * 1.005 ? "↑" : price < ma1d * 0.995 ? "↓" : "="
price_rel_5 = price > ma2d * 1.005 ? "↑" : price < ma2d * 0.995 ? "↓" : "="
price_rel_6 = price > ma3d * 1.005 ? "↑" : price < ma3d * 0.995 ? "↓" : "="
price_rel_7 = price > ma4d * 1.005 ? "↑" : price < ma4d * 0.995 ? "↓" : "="
price_rel_8 = price > ma5d * 1.005 ? "↑" : price < ma5d * 0.995 ? "↓" : "="

// ────────────────────────────────────────────────────────────────
// VOLUME AT LAST CROSS
// ────────────────────────────────────────────────────────────────
var float cross_vol_2 = float(na)
var float cross_vol_3 = float(na)
var float cross_vol_4 = float(na)
var float cross_vol_5 = float(na)
var float cross_vol_6 = float(na)
var float cross_vol_7 = float(na)
var float cross_vol_8 = float(na)

if ta.cross(price, ma1b)
    cross_vol_2 := vol

if ta.cross(price, ma2b)
    cross_vol_3 := vol

if ta.cross(price, ma1d)
    cross_vol_4 := vol

if ta.cross(price, ma2d)
    cross_vol_5 := vol

if ta.cross(price, ma3d)
    cross_vol_6 := vol

if ta.cross(price, ma4d)
    cross_vol_7 := vol

if ta.cross(price, ma5d)
    cross_vol_8 := vol

getVolStatus(cv) => na(cv) ? "-" : safe_div(cv, vol_ma) > vol_high_ratio ? "H" : safe_div(cv, vol_ma) > vol_low_ratio ? "N" : "L"

getVolColor(st) => st == "H" ? color.green : st == "N" ? color.white : color.gray

vol_status_1 = getVolStatus(vol)
vol_status_2 = getVolStatus(cross_vol_2)
vol_status_3 = getVolStatus(cross_vol_3)
vol_status_4 = getVolStatus(cross_vol_4)
vol_status_5 = getVolStatus(cross_vol_5)
vol_status_6 = getVolStatus(cross_vol_6)
vol_status_7 = getVolStatus(cross_vol_7)
vol_status_8 = getVolStatus(cross_vol_8)

// ────────────────────────────────────────────────────────────────
// BARS SINCE LAST CROSS + DIRECTION
// ────────────────────────────────────────────────────────────────
bars_since_2 = ta.barssince(ta.cross(price, ma1b))
bars_since_3 = ta.barssince(ta.cross(price, ma2b))
bars_since_4 = ta.barssince(ta.cross(price, ma1d))
bars_since_5 = ta.barssince(ta.cross(price, ma2d))
bars_since_6 = ta.barssince(ta.cross(price, ma3d))
bars_since_7 = ta.barssince(ta.cross(price, ma4d))
bars_since_8 = ta.barssince(ta.cross(price, ma5d))

// Direction at last cross (true = up/cross above, false = down/cross below)
dir_2 = ta.valuewhen(ta.cross(price, ma1b), price > ma1b, 0)
dir_3 = ta.valuewhen(ta.cross(price, ma2b), price > ma2b, 0)
dir_4 = ta.valuewhen(ta.cross(price, ma1d), price > ma1d, 0)
dir_5 = ta.valuewhen(ta.cross(price, ma2d), price > ma2d, 0)
dir_6 = ta.valuewhen(ta.cross(price, ma3d), price > ma3d, 0)
dir_7 = ta.valuewhen(ta.cross(price, ma4d), price > ma4d, 0)
dir_8 = ta.valuewhen(ta.cross(price, ma5d), price > ma5d, 0)

// ────────────────────────────────────────────────────────────────
// MOMENTUM
// ────────────────────────────────────────────────────────────────
get_stable_momentum(series, lookback) =>
    current = series
    past    = series[lookback]
    na(past) ? "=" : current > past * 1.001 ? "↑" : current < past * 0.999 ? "↓" : "="

mom_1 = get_stable_momentum(price, 3)
mom_2 = get_stable_momentum(ma1b, 3)
mom_3 = get_stable_momentum(ma2b, 3)
mom_4 = get_stable_momentum(ma1d, 3)
mom_5 = get_stable_momentum(ma2d, 3)
mom_6 = get_stable_momentum(ma3d, 3)
mom_7 = get_stable_momentum(ma4d, 3)
mom_8 = get_stable_momentum(ma5d, 3)

// ────────────────────────────────────────────────────────────────
// STRETCH & COLORS
// ────────────────────────────────────────────────────────────────
getStretch(p, ma) => math.round(safe_div(p - ma, ma) * 100 * 10) / 10

stretch_1 = 0.0
stretch_2 = getStretch(price, ma1b)
stretch_3 = getStretch(price, ma2b)
stretch_4 = getStretch(price, ma1d)
stretch_5 = getStretch(price, ma2d)
stretch_6 = getStretch(price, ma3d)
stretch_7 = getStretch(price, ma4d)
stretch_8 = getStretch(price, ma5d)

stretch_str_1 = "-"
stretch_str_2 = str.tostring(stretch_2, "#.0")
stretch_str_3 = str.tostring(stretch_3, "#.0")
stretch_str_4 = str.tostring(stretch_4, "#.0")
stretch_str_5 = str.tostring(stretch_5, "#.0")
stretch_str_6 = str.tostring(stretch_6, "#.0")
stretch_str_7 = str.tostring(stretch_7, "#.0")
stretch_str_8 = str.tostring(stretch_8, "#.0")

getStretchColor(v) => math.abs(v) > stretch_extreme ? color.red : math.abs(v) > stretch_moderate ? color.orange : color.white

getVsPriceColor(pct) => math.abs(pct) <= near_zero_thresh ? color.new(#888888, 80) : pct >= 0 ? color.new(#00ff00, 80) : color.new(#ff0000, 80)

getRsiColor(rsi_val) => na(rsi_val) ? color.gray : rsi_val >= 70 ? color.red : rsi_val <= 30 ? color.green : color.white

// ────────────────────────────────────────────────────────────────
// FORMATTERS
// ────────────────────────────────────────────────────────────────
formatMA(p)  => na(p) ? "-" : str.tostring(p, "#.00")
formatPct(v) => str.tostring(v, "#.0")
formatRsi(v) => na(v) ? "-" : str.tostring(v, "#.0")

pct_str(pct) =>
    (
        na(pct) ? "-" :
        math.abs(pct) < 0.5 ? "-0.0" :
        (pct > 0 ? "↑ " : "↓ ") + formatPct(math.abs(pct))
    )

// ────────────────────────────────────────────────────────────────
// RSI CONSENSUS (symbol only)
// ────────────────────────────────────────────────────────────────
short_avg   = (rsi_current + rsi1b + rsi2b) / 3.0
medium_avg  = (rsi1d + rsi2d + rsi3d) / 3.0
long_avg    = (rsi4d + rsi5d) / 2.0
consensus_rsi = short_avg * 0.45 + medium_avg * 0.35 + long_avg * 0.20

// ────────────────────────────────────────────────────────────────
// INTRADAY BIAS SCORE
// ────────────────────────────────────────────────────────────────
float bias_score = 50.0
bias_score += (rsi_current > 55 ? 18 : rsi_current < 45 ? -18 : 0)
bias_score += (rsi_delta_cur > 1.0 ? 12 : rsi_delta_cur < -1.0 ? -12 : 0)
bias_score += (rsi_delta_bar1 > 0.8 ? 8 : rsi_delta_bar1 < -0.8 ? -8 : 0)
bias_score += (price > ma1b and price > ma2b ? 22 : price < ma1b and price < ma2b ? -22 : 0)
bias_score += (rsi_current > qqq_rsi_current + 3 and rsi_current > spy_rsi_current + 3 ? 15 : 0)
bias_score += (rsi_current < qqq_rsi_current - 3 and rsi_current < spy_rsi_current - 3 ? -15 : 0)
bias_score := math.min(100, math.max(0, math.round(bias_score)))

string bias_text = bias_score >= 75 ? "Strong Long" :
                   bias_score >= 60 ? "Bull Bias" :
                   bias_score <= 25 ? "Strong Short" :
                   bias_score <= 40 ? "Bear Bias" :
                   "Neutral"

color bias_col = bias_score >= 75 ? color.new(color.green, 0) :
                 bias_score >= 60 ? color.new(color.lime, 0) :
                 bias_score <= 25 ? color.new(color.red, 0) :
                 bias_score <= 40 ? color.new(color.maroon, 0) :
                 color.new(color.yellow, 0)

// ────────────────────────────────────────────────────────────────
// ROW FUNCTION
// ────────────────────────────────────────────────────────────────
f_row(table tbl, int y, string label, string p_rel, string vol_st, string mom, float stretch_val, string stretch_txt, float ma_val, float pct_vs_price, bool is_current, float rsi_val, float delta_val, float qqq_rsi_val, float spy_rsi_val) =>
    color row_bg = color.new(#1e1e1e, 0)
    int   tsize  = get_text_size()

    table.cell(tbl, 0, y, label, text_color = is_current ? color.orange : color.white, bgcolor = row_bg, text_size = tsize)

    table.cell(tbl, 1, y, is_current ? "-" : p_rel, 
        text_color = is_current ? color.gray : (p_rel == "↑" ? color.green : p_rel == "↓" ? color.red : color.white), 
        bgcolor = row_bg, text_size = tsize)

    table.cell(tbl, 2, y, vol_st, 
        text_color = getVolColor(vol_st), 
        bgcolor = row_bg, 
        text_size = tsize,
        tooltip = vol_st == "H" ? "High volume at last cross (> " + str.tostring(vol_high_ratio, "#.1") + "× avg)" :
                  vol_st == "N" ? "Normal volume at last cross" : "Low volume at last cross")

    color mom_col = mom == "↑" ? color.green : mom == "↓" ? color.red : color.white
    table.cell(tbl, 3, y, mom, 
        text_color = mom_col, 
        bgcolor = row_bg, 
        text_size = tsize,
        tooltip = mom == "↑" ? "Rising momentum (last 3 bars)" : mom == "↓" ? "Falling momentum (last 3 bars)" : "Stable / flat")

    table.cell(tbl, 4, y, stretch_txt, 
        text_color = getStretchColor(stretch_val), 
        bgcolor = row_bg, 
        text_size = tsize,
        tooltip = stretch_val > 0 ? "Price stretched ABOVE this MA" : stretch_val < 0 ? "Price stretched BELOW this MA" : "Price near this MA")

    string display_value = is_current ? formatMA(price) : formatMA(ma_val)
    table.cell(tbl, 5, y, display_value, 
        text_color = is_current ? color.yellow : color.white, 
        bgcolor = row_bg, 
        text_size = tsize)

    table.cell(tbl, 6, y, pct_str(pct_vs_price), 
        text_color = color.white, 
        bgcolor = getVsPriceColor(-pct_vs_price), 
        text_size = tsize)

    table.cell(tbl, 7, y, formatRsi(rsi_val), 
        text_color = getRsiColor(rsi_val), 
        bgcolor = row_bg, 
        text_size = tsize,
        tooltip = rsi_val >= 70 ? "Overbought (≥70)" : rsi_val <= 30 ? "Oversold (≤30)" : "Neutral / ranging (30–70)")

    string delta_str = na(delta_val) ? "-" : str.tostring(delta_val, "+#.0")
    color delta_col = (
        na(delta_val) ? color.gray :
        delta_val >  2.0 ? color.green :
        delta_val >  0.5 ? color.new(color.green, 40) :
        delta_val < -2.0 ? color.red :
        delta_val < -0.5 ? color.new(color.red, 40) : color.gray
    )
    table.cell(tbl, 8, y, delta_str, 
        text_color = delta_col, 
        bgcolor = row_bg, 
        text_size = tsize,
        tooltip = "Chained RSI delta to next slower level")

    table.cell(tbl, 9, y, formatRsi(qqq_rsi_val), 
        text_color = getRsiColor(qqq_rsi_val), 
        bgcolor = row_bg, 
        text_size = tsize,
        tooltip = "QQQ RSI using same length as this row's RSI")

    table.cell(tbl,10, y, formatRsi(spy_rsi_val), 
        text_color = getRsiColor(spy_rsi_val), 
        bgcolor = row_bg, 
        text_size = tsize,
        tooltip = "SPY RSI using same length as this row's RSI")

        // Bars Since Last Cross + Direction
    int bars_val = na
    bool dir_val = false   // temporary default — will be overwritten only when valid
    bool has_direction = false

    if not is_current
        bars_val := switch y
            2 => bars_since_2
            3 => bars_since_3
            4 => bars_since_4
            5 => bars_since_5
            6 => bars_since_6
            7 => bars_since_7
            8 => bars_since_8
            => na

        // Direction only if we have a real cross
        if not na(bars_val)
            dir_val := switch y
                2 => dir_2
                3 => dir_3
                4 => dir_4
                5 => dir_5
                6 => dir_6
                7 => dir_7
                8 => dir_8
                => false   // fallback — won't be used because of prior check
            has_direction := true

    // Build display string
    string bars_str = na(bars_val) ? "-" : 
                      (has_direction ? (dir_val ? "↑ " : "↓ ") : "") + 
                      (na(bars_val) ? "" : str.tostring(bars_val))

    // Color logic
    color bars_col = color.gray
    if not is_current and not na(bars_val) and has_direction
        if bars_val <= 8
            bars_col := dir_val ? color.new(color.lime, 0) : color.new(color.red, 30)
        else if bars_val <= 15
            bars_col := dir_val ? color.new(color.yellow, 20) : color.new(color.orange, 30)
        else
            bars_col := color.new(color.gray, 20)

    table.cell(tbl, 11, y, bars_str, 
        text_color = bars_col, 
        bgcolor = row_bg, 
        text_size = tsize,
        tooltip = na(bars_val) ? "No cross yet in history" : 
                  (dir_val ? "Price crossed ABOVE this MA" : "Price crossed BELOW this MA") + 
                  "\n" + str.tostring(bars_val) + " bars ago\nLower = fresher for intraday")

/// ────────────────────────────────────────────────────────────────
// MAIN TABLE
// ────────────────────────────────────────────────────────────────
var table tbl = na

if barstate.islast
    table_pos = get_position(table_position_input)
    int tsize = get_text_size()

    if not na(tbl)
        table.delete(tbl)

    tbl := table.new(
         position     = table_pos,
         columns      = 12,
         rows         = 12,
         bgcolor      = color.new(#1e1e1e, 0),
         border_width = 1,
         border_color = color.new(#444444, 60),
         frame_color  = color.new(#333333, 70),
         frame_width  = 1)

    color hbg = color.new(#2962ff, 75)

    // Header
    table.cell(tbl, 0, 0, "MA",        text_color=color.white, bgcolor=hbg, text_size=tsize)
    table.cell(tbl, 1, 0, "vs Price",  text_color=color.white, bgcolor=hbg, text_size=tsize)
    table.cell(tbl, 2, 0, "VOL @ X",   text_color=color.white, bgcolor=hbg, text_size=tsize)
    table.cell(tbl, 3, 0, "MOM",       text_color=color.white, bgcolor=hbg, text_size=tsize)
    table.cell(tbl, 4, 0, "Stretch %", text_color=color.white, bgcolor=hbg, text_size=tsize)
    table.cell(tbl, 5, 0, "MA Value",  text_color=color.white, bgcolor=hbg, text_size=tsize)
    table.cell(tbl, 6, 0, "% vs Now",  text_color=color.white, bgcolor=hbg, text_size=tsize)
    table.cell(tbl, 7, 0, "RSI",       text_color=color.white, bgcolor=hbg, text_size=tsize)
    table.cell(tbl, 8, 0, "RSI Δ",     text_color=color.white, bgcolor=hbg, text_size=tsize)
    table.cell(tbl, 9, 0, "QQQ RSI",   text_color=color.white, bgcolor=hbg, text_size=tsize)
    table.cell(tbl,10, 0, "SPY RSI",   text_color=color.white, bgcolor=hbg, text_size=tsize)
    table.cell(tbl,11, 0, "Bars Since", text_color=color.white, bgcolor=hbg, text_size=tsize, tooltip="Bars since last price cross + direction (↑ = above MA, ↓ = below)")

    // Data rows
    pct_vs_2 = safe_pct(ma1b, price)
    pct_vs_3 = safe_pct(ma2b, price)
    pct_vs_4 = safe_pct(ma1d, price)
    pct_vs_5 = safe_pct(ma2d, price)
    pct_vs_6 = safe_pct(ma3d, price)
    pct_vs_7 = safe_pct(ma4d, price)
    pct_vs_8 = safe_pct(ma5d, price)

    f_row(tbl, 1, "CURRENT",  "-", vol_status_1, mom_1, stretch_1, stretch_str_1, 0.0, 0.0, true, rsi_current, rsi_delta_cur,   qqq_rsi_current, spy_rsi_current)
    f_row(tbl, 2, bar1_label, price_rel_2, vol_status_2, mom_2, stretch_2, stretch_str_2, ma1b, pct_vs_2, false, rsi1b, rsi_delta_bar1, qqq_rsi1b, spy_rsi1b)
    f_row(tbl, 3, bar2_label, price_rel_3, vol_status_3, mom_3, stretch_3, stretch_str_3, ma2b, pct_vs_3, false, rsi2b, rsi_delta_bar2, qqq_rsi2b, spy_rsi2b)
    f_row(tbl, 4, day1_label, price_rel_4, vol_status_4, mom_4, stretch_4, stretch_str_4, ma1d, pct_vs_4, false, rsi1d, rsi_delta_day1, qqq_rsi1d, spy_rsi1d)
    f_row(tbl, 5, day2_label, price_rel_5, vol_status_5, mom_5, stretch_5, stretch_str_5, ma2d, pct_vs_5, false, rsi2d, rsi_delta_day2, qqq_rsi2d, spy_rsi2d)
    f_row(tbl, 6, day3_label, price_rel_6, vol_status_6, mom_6, stretch_6, stretch_str_6, ma3d, pct_vs_6, false, rsi3d, rsi_delta_day3, qqq_rsi3d, spy_rsi3d)
    f_row(tbl, 7, day4_label, price_rel_7, vol_status_7, mom_7, stretch_7, stretch_str_7, ma4d, pct_vs_7, false, rsi4d, rsi_delta_day4, qqq_rsi4d, spy_rsi4d)
    f_row(tbl, 8, day5_label, price_rel_8, vol_status_8, mom_8, stretch_8, stretch_str_8, ma5d, pct_vs_8, false, rsi5d, rsi_delta_day5, qqq_rsi5d, spy_rsi5d)

    // Footer
    color footer_bg = color.new(#444444, 60)
    color atr_footer_bg = color.new(#2e4a7e, 70)

    table.cell(tbl, 0, 9, "RSI Consensus: " + str.tostring(consensus_rsi, "#.0"), 
        text_color = getRsiColor(consensus_rsi), 
        bgcolor = footer_bg, 
        text_size = tsize,
        tooltip = "Weighted RSI target\n45% short-term • 35% medium • 20% long-term")

    table.cell(tbl, 0, 10, "Current ATR (" + timeframe.period + "): " + str.tostring(atr_current_pct, "#.2") + "% | $" + str.tostring(atr_current, "#.##"), 
        text_color = color.yellow, 
        bgcolor = atr_footer_bg, 
        text_size = tsize,
        tooltip = "ATR on current chart timeframe\nUse for intraday SL/targets (e.g. 1.5× for stop)")

            // Footer row 11 - NON-MERGED version for reliable left/right split
    table.cell(tbl, 0, 11, "Daily ATR (14): " + str.tostring(atr_daily_pct, "#.2") + "% | $" + str.tostring(atr_daily_raw, "#.##") + "          ", 
        text_color = color.yellow, 
        bgcolor = atr_footer_bg, 
        text_size = tsize,
        tooltip = "Daily expected range\nUseful for swing hold context / sizing")

    table.cell(tbl, 6, 11, "Intraday Bias: " + bias_text + " (" + str.tostring(bias_score) + ")", 
        text_color = bias_col, 
        bgcolor = atr_footer_bg, 
        text_size = tsize,
        tooltip = "Intraday bias (0-100) for 1-3 hour holds only\nHeavy weight on current RSI, short deltas, fast MAs & QQQ/SPY relative strength")
