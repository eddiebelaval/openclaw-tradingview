//@version=5
indicator("Sigma Distance From Moving Average")

MALength = input.int(50, "MA Length")
price = close

ma = ta.sma(price, MALength)
percentDiff = (price - ma) / ma * 100

// Running statistics using cumulative sums (handles full available history)
var float cumSum = 0.0
var float cumSumSq = 0.0
var int count = 0

if not na(percentDiff)
    cumSum += percentDiff
    cumSumSq += percentDiff * percentDiff
    count += 1

runningMean = cumSum / count
runningVariance = (cumSumSq / count) - (runningMean * runningMean)
runningStdDev = math.sqrt(runningVariance)

// Z-score: how many standard deviations from the historical mean
zScore = count > 1 ? (percentDiff - runningMean) / runningStdDev : na

plot(zScore, "Sigma Distance", color.new(color.blue, 0), linewidth=2)

// Reference bands
hline( 0, "Mean",  color.gray,   linestyle=hline.style_solid)
hline( 1, "+1σ",   color.green,  linestyle=hline.style_dotted)
hline(-1, "-1σ",   color.green,  linestyle=hline.style_dotted)
hline( 2, "+2σ",   color.orange, linestyle=hline.style_dotted)
hline(-2, "-2σ",   color.orange, linestyle=hline.style_dotted)
hline( 3, "+3σ",   color.red,    linestyle=hline.style_dotted)
hline(-3, "-3σ",   color.red,    linestyle=hline.style_dotted)
