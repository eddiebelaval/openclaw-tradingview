//@version=5
indicator(title='Trend Sniper v2.5 [Jamallo]', overlay=true, max_bars_back=500)

//==============================
// INPUTS
//==============================
group_bw        = "Butterworth Stop"
bw_period       = input.int(20, "Butterworth Period", minval=5, group=group_bw)
park_len        = input.int(50, "Parkinson Period", group=group_bw)
stop_mult       = input.float(1.2, "Stop Multiplier", step=0.1, group=group_bw)

group_color     = "CMO Trend Coloring"
cmo_len         = input.int(14, "CMO Length", group=group_color)
cmo_thresh      = input.float(10.0, "CMO Threshold", step=1.0, group=group_color)

group_kama      = "KAMA Midpoint"
kama_er_len     = input.int(10, "Efficiency Period", group=group_kama)
kama_fast       = input.int(2, "Fast SC", group=group_kama)
kama_slow       = input.int(30, "Slow SC", group=group_kama)

group_st        = "SuperTrend Triggers"
st_mult_slow    = input.float(9.0, "Slow ST Mult", group=group_st)
st_mult_fast    = input.float(6.0, "Fast ST Mult", group=group_st)
st_atr_len      = input.int(14, "ST ATR Period", group=group_st)

group_vis       = "Display"
show_bg         = input.bool(true, "Color Background", group=group_vis)
bull_col        = input.color(color.teal, "Bull", inline="c", group=group_vis)
bear_col        = input.color(color.maroon, "Bear", inline="c", group=group_vis)

//==============================
// 2-POLE BUTTERWORTH (Super Smoother)
//==============================
f_super_smoother(src, period) =>
    pi = math.pi
    a1 = math.exp(-math.sqrt(2) * pi / period)
    b1 = 2 * a1 * math.cos(math.sqrt(2) * pi / period)
    c2 = b1
    c3 = -a1 * a1
    c1 = 1 - c2 - c3
    var float ss = na
    ss := na(ss[2]) ? src : c1 * (src + nz(src[1])) / 2.0 + c2 * nz(ss[1]) + c3 * nz(ss[2])
    ss

bw_trend = f_super_smoother(close, bw_period)

//==============================
// PARKINSON VOLATILITY
//==============================
f_parkinson(length) =>
    sum_sq = 0.0
    for i = 0 to length - 1
        log_hl = math.log(high[i] / low[i])
        sum_sq += log_hl * log_hl
    math.sqrt(sum_sq / (4.0 * length * math.log(2))) * close

park_vol = f_parkinson(park_len)
stop_dist = park_vol * stop_mult

//==============================
// BUTTERWORTH STOP STATE MACHINE
//==============================
var float bw_stop = 0.0
var bool trend_up = true

if bar_index == 0
    bw_stop := close - stop_dist
    trend_up := true
else
    prev_stop = nz(bw_stop[1], close - stop_dist)
    trend_up := close > prev_stop
    
    if trend_up
        bw_stop := math.max(prev_stop, bw_trend - stop_dist)
    else
        bw_stop := math.min(prev_stop, bw_trend + stop_dist)
    
    if trend_up and close < bw_stop
        trend_up := false
        bw_stop := bw_trend + stop_dist
    else if not trend_up and close > bw_stop
        trend_up := true
        bw_stop := bw_trend - stop_dist

//==============================
// SUPERTREND TRIGGERS
//==============================
st_atr = ta.atr(st_atr_len)
st_hl2 = hl2

var float st_slow = 0.0
var float st_fast = 0.0
var int st_dir_slow = 1
var int st_dir_fast = 1

// Slow SuperTrend
st_up_slow = st_hl2 - st_mult_slow * st_atr
st_dn_slow = st_hl2 + st_mult_slow * st_atr

st_up_slow := nz(st_up_slow[1]) > 0 and close[1] > nz(st_slow[1]) ? math.max(st_up_slow, nz(st_up_slow[1])) : st_up_slow
st_dn_slow := nz(st_dn_slow[1]) > 0 and close[1] < nz(st_slow[1]) ? math.min(st_dn_slow, nz(st_dn_slow[1])) : st_dn_slow

st_dir_slow := close > nz(st_dn_slow[1]) ? 1 : close < nz(st_up_slow[1]) ? -1 : nz(st_dir_slow[1])
st_slow := st_dir_slow == 1 ? st_up_slow : st_dn_slow

// Fast SuperTrend
st_up_fast = st_hl2 - st_mult_fast * st_atr
st_dn_fast = st_hl2 + st_mult_fast * st_atr

st_up_fast := nz(st_up_fast[1]) > 0 and close[1] > nz(st_fast[1]) ? math.max(st_up_fast, nz(st_up_fast[1])) : st_up_fast
st_dn_fast := nz(st_dn_fast[1]) > 0 and close[1] < nz(st_fast[1]) ? math.min(st_dn_fast, nz(st_dn_fast[1])) : st_dn_fast

st_dir_fast := close > nz(st_dn_fast[1]) ? 1 : close < nz(st_up_fast[1]) ? -1 : nz(st_dir_fast[1])
st_fast := st_dir_fast == 1 ? st_up_fast : st_dn_fast

//==============================
// CHANDE MOMENTUM OSCILLATOR + DEADBAND
//==============================
f_cmo(src, len) =>
    mom = ta.change(src)
    up_sum = math.sum(math.max(mom, 0), len)
    dn_sum = math.sum(math.abs(math.min(mom, 0)), len)
    100 * (up_sum - dn_sum) / (up_sum + dn_sum + 0.0001)

cmo_val = f_cmo(bw_stop, cmo_len)

var int color_state = 1
if cmo_val > cmo_thresh
    color_state := 1
else if cmo_val < -cmo_thresh
    color_state := -1

line_color = color_state == 1 ? bull_col : bear_col

//==============================
// KAMA MIDPOINT
//==============================
f_kama(src, er_len, fast_len, slow_len) =>
    change_val = math.abs(src - src[er_len])
    volatility = math.sum(math.abs(src - src[1]), er_len)
    er = volatility != 0 ? change_val / volatility : 0
    
    fast_sc = 2.0 / (fast_len + 1.0)
    slow_sc = 2.0 / (slow_len + 1.0)
    sc = math.pow(er * (fast_sc - slow_sc) + slow_sc, 2)
    
    var float kama_val = na
    kama_val := na(kama_val) ? src : kama_val[1] + sc * (src - kama_val[1])
    kama_val

mid_raw = st_slow > bw_stop ? st_slow - (st_slow - bw_stop) / 2.0 : st_slow + (bw_stop - st_slow) / 2.0
kama_mid = f_kama(mid_raw, kama_er_len, kama_fast, kama_slow)

//==============================
// PLOTTING
//==============================
plot(st_slow, color=color.new(color.blue, 50), linewidth=1, title="Slow ST")
p_main = plot(bw_stop, color=line_color, linewidth=1, title="BW Stop")

fast_shortened = st_fast > bw_stop ? st_fast - (st_fast - bw_stop) / 2.0 : st_fast + (bw_stop - st_fast) / 2.0
plot(fast_shortened, color=color.new(color.orange, 50), linewidth=1, style=plot.style_circles, title="Fast Trigger")

p_mid = plot(kama_mid, color=color.new(color.gray, 50), linewidth=1, title="KAMA Mid")

fill(p_mid, p_main, color=show_bg ? (close > st_slow and bw_stop < fast_shortened ? color.new(color.teal, 70) : na) : na)
fill(p_mid, p_main, color=show_bg ? (close > st_slow and bw_stop >= fast_shortened ? color.new(#004d4d, 70) : na) : na)
fill(p_mid, p_main, color=show_bg ? (close <= st_slow and bw_stop > fast_shortened ? color.new(color.maroon, 70) : na) : na)
fill(p_mid, p_main, color=show_bg ? (close <= st_slow and bw_stop <= fast_shortened ? color.new(#4d0000, 70) : na) : na)

//==============================
// SIGNALS
//==============================
jlong = ta.crossover(bw_stop, st_slow)
jshort = ta.crossunder(bw_stop, st_slow)

plotshape(jlong, title='Long', text='BUY', textcolor=color.white, style=shape.labelup, size=size.small, location=location.belowbar, color=color.green)
plotshape(jshort, title='Short', text='SELL', textcolor=color.white, style=shape.labeldown, size=size.small, location=location.abovebar, color=color.red)

alertcondition(jlong, title='Long Signal', message='BW-KAMA: LONG')
alertcondition(jshort, title='Short Signal', message='BW-KAMA: SHORT')
