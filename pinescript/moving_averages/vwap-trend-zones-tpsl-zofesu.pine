//@version=6
indicator("VWAP Trend Zones + TPSL [Zofesu]", shorttitle="[Zofesu] Trend Zones", overlay=true)

// ============================= A. INPUTS & CONFIGURATION =============================

group_trend = "MTF Trend Filter"
trend_mode = input.string("EMA Cross", "Trend Mode", options=["EMA Cross", "HMA Direction"], group=group_trend)
long_tf = input.timeframe("30", "Higher Timeframe", group=group_trend)
ema_fast_len = input.int(9, "Fast EMA / HMA Length", group=group_trend)
ema_slow_len = input.int(50, "Slow EMA Length (only for EMA mode)", group=group_trend)
h1_display = input.bool(true, "Show MTF Filter", group=group_trend)

group_vwap_1 = "VWAP 1 (Visualization - D/W/M/Q)"
vwap_1_anchor_choice = input.string("Q", "VWAP 1 Anchor", options=["D", "W", "M", "Q"], group=group_vwap_1)
vwap_1_display = input.bool(true, "Show VWAP 1", group=group_vwap_1)

group_vwap_2 = "VWAP 2 (Visualization - D/W/M/Q)"
vwap_2_anchor_choice = input.string("M", "VWAP 2 Anchor", options=["D", "W", "M", "Q"], group=group_vwap_2) 
vwap_2_display = input.bool(true, "Show VWAP 2", group=group_vwap_2)

group_visual = "Visuals & Colors"
vwap_col_1 = input.color(color.new(#ffd700, 0), "VWAP 1 Color", group=group_visual)
vwap_col_2 = input.color(color.new(#ffffff, 0), "VWAP 2 Color", group=group_visual)

group_risk = "Position & Risk (Swing)"
sl_swing_lookback = input.int(300, "SL Swing Lookback (Bars)", group=group_risk)
tp_swing_lookback = input.int(300, "TP Swing Lookback (Bars)", group=group_risk)
sl_offset_ticks = input.int(0, "SL Offset (Ticks)", group=group_risk, tooltip="Adds a small buffer to the SL level to avoid being hunted by liquidity wicks.")
tp_display = input.bool(true, "Show Dynamic Levels", group=group_risk)


// ============================= B. MTF TREND LOGIC (EMA vs HMA) =============================

[mtf_fast, mtf_slow, mtf_hma, mtf_hma_prev] = request.security(syminfo.tickerid, long_tf, [ta.ema(close, ema_fast_len), ta.ema(close, ema_slow_len), ta.hma(close, ema_fast_len), ta.hma(close, ema_fast_len)[1]])

bool h1_trend_bull = trend_mode == "EMA Cross" ? mtf_fast > mtf_slow : mtf_hma > mtf_hma_prev
bool h1_trend_bear = trend_mode == "EMA Cross" ? mtf_fast < mtf_slow : mtf_hma < mtf_hma_prev


// ============================= C. VWAP LOGIC =============================

is_quarterly_change(timeframe_choice) =>
    timeframe_choice == "Q" and (timeframe.change("M") and (month(time) == 1 or month(time) == 4 or month(time) == 7 or month(time) == 10))

vwap_1_reset_condition = vwap_1_anchor_choice == "D" ? timeframe.change("D") : vwap_1_anchor_choice == "W" ? timeframe.change("W") : vwap_1_anchor_choice == "M" ? timeframe.change("M") : is_quarterly_change(vwap_1_anchor_choice)
vwap_1_val = ta.vwap(hlc3, vwap_1_reset_condition)

vwap_2_reset_condition = vwap_2_anchor_choice == "D" ? timeframe.change("D") : vwap_2_anchor_choice == "W" ? timeframe.change("W") : vwap_2_anchor_choice == "M" ? timeframe.change("M") : is_quarterly_change(vwap_2_anchor_choice)
vwap_2_val = ta.vwap(hlc3, vwap_2_reset_condition)


// ============================= F. RISK MANAGEMENT LOGIC =============================

tick_offset = syminfo.mintick * sl_offset_ticks

// Dynamic levels calculated per bar
tp_long_level = ta.highest(high, tp_swing_lookback)
sl_long_level = ta.lowest(low, sl_swing_lookback) - tick_offset

tp_short_level = ta.lowest(low, tp_swing_lookback)
sl_short_level = ta.highest(high, sl_swing_lookback) + tick_offset

// Switch levels based on current trend bias
float display_sl = h1_trend_bull ? sl_long_level : sl_short_level
float display_tp = h1_trend_bull ? tp_long_level : tp_short_level

    
// ============================= G. VISUALIZATION =============================

// VWAP Plots
plot(vwap_1_display ? vwap_1_val : na, title="VWAP 1", color=vwap_col_1, linewidth=2)
plot(vwap_2_display ? vwap_2_val : na, title="VWAP 2", color=vwap_col_2, linewidth=3) 

// MTF Trend Lines
plot(h1_display and trend_mode == "EMA Cross" ? mtf_fast : h1_display and trend_mode == "HMA Direction" ? mtf_hma : na, title="Primary MTF Line", color=h1_trend_bull ? color.new(#00ff2a, 0) : color.new(#ff0000, 0), linewidth=2, style=plot.style_linebr)
plot(h1_display and trend_mode == "EMA Cross" ? mtf_slow : na, title="Secondary MTF Line (EMA Slow)", color=h1_trend_bull ? color.new(#10bb00, 50) : color.new(#ce0000, 50), linewidth=2, style=plot.style_linebr)

// SL / TP Dynamic Mapping
plot(tp_display ? display_sl : na, title="Dynamic Stop Loss", color=color.new(#9600fa, 0), style=plot.style_linebr, linewidth=2)
plot(tp_display ? display_tp : na, title="Dynamic Take Profit", color=color.new(#34d0ff, 0), style=plot.style_linebr, linewidth=2)

// Trend Background Tinting
barcolor(h1_trend_bull ? color.new(#00ff2a, 50) : color.new(#ff0000, 50))
