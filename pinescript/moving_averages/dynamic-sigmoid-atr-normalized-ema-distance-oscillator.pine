//@version=5
indicator("Dynamic Sigmoid ATR-Normalized EMA Distance Oscillator", shorttitle="EMA Dist DYN", overlay=false)

// ===================================
// PARAMETERS
// ===================================
emaLength = input.int(200, "EMA Length", minval=1)
atrLength = input.int(14, "ATR Length", minval=1)
sigmoidMultiplier = input.float(1.0, "Sigmoid Multiplier", minval=0.1, maxval=10.0, step=0.1)

// Dynamic center controls
useDynamicCenter = input.bool(true, "Use Dynamic Center")
centerLength = input.int(100, "Center Length", minval=10)
bandLength = input.int(100, "Band Length", minval=20)
bandStdevMult = input.float(1.2, "Band Stdev Multiplier", minval=0.2, maxval=4.0, step=0.1)

// Visualization controls
showColorGradient = input.bool(true, "Show Color Gradient")
showTable = input.bool(true, "Show Info Table")

// Green and red tonal palette
greenStrong = color.new(#00e676, 0)
greenSoft = color.new(#66ffa6, 0)
greenDark = color.new(#00b248, 0)
redStrong = color.new(#ff1744, 0)
redSoft = color.new(#ff7b8b, 0)
redDark = color.new(#d5002f, 0)
neutralSoft = color.new(#8b95a1, 35)
// Same family, different transparency for histogram
greenHistDark = color.new(#00b248, 55)
greenHistStrong = color.new(#00e676, 55)
redHistSoft = color.new(#ff7b8b, 55)
redHistStrong = color.new(#ff1744, 55)

// ===================================
// CALCULATIONS
// ===================================
emaValue = ta.ema(close, emaLength)
priceDistance = close - emaValue
atr = ta.atr(atrLength)
safeAtr = math.max(atr, syminfo.mintick)
normalizedDistance = priceDistance / safeAtr

// Sigmoid 0-100
sigmoidRaw = 1 / (1 + math.exp(-normalizedDistance * sigmoidMultiplier))
sigmoidValue = sigmoidRaw * 100

// Dynamic center and bands
dynamicCenter = ta.ema(sigmoidValue, centerLength)
centerLine = useDynamicCenter ? dynamicCenter : 50.0

bandStdev = ta.stdev(sigmoidValue, bandLength)
dynamicUpperRaw = centerLine + bandStdev * bandStdevMult
dynamicLowerRaw = centerLine - bandStdev * bandStdevMult
upperBand = math.min(dynamicUpperRaw, 100.0)
lowerBand = math.max(dynamicLowerRaw, 0.0)

// ===================================
// SIGNALS
// ===================================
momentum = ta.change(sigmoidValue)

isBullish = sigmoidValue > centerLine and momentum > 0
isBearish = sigmoidValue < centerLine and momentum < 0

overbought = sigmoidValue > upperBand
oversold = sigmoidValue < lowerBand

bullishCross = ta.crossover(sigmoidValue, centerLine)
bearishCross = ta.crossunder(sigmoidValue, centerLine)

// ===================================
// VISUALIZATION
// ===================================
oscillatorColor = showColorGradient ?
     color.from_gradient(sigmoidValue, 0, 100, redDark, greenStrong) :
     sigmoidValue > centerLine ? greenStrong : redStrong

// Dashed-style effect for dynamic lines
dashOn = bar_index % 2 == 0

plot(sigmoidValue, "Oscillator", color=oscillatorColor, linewidth=3)
plot(dashOn ? centerLine : na, "Dynamic Center", color=color.new(#9ec5ff, 45), linewidth=1)
plot(upperBand, "Dynamic Upper", color=color.new(redSoft, 84), linewidth=2, style=plot.style_circles)
plot(lowerBand, "Dynamic Lower", color=color.new(greenSoft, 84), linewidth=2, style=plot.style_circles)

// Histogram around center line
histBase = sigmoidValue - centerLine
histColor = histBase >= 0 ?
     color.from_gradient(histBase, 0, 20, greenHistDark, greenHistStrong) :
     color.from_gradient(math.abs(histBase), 0, 20, redHistSoft, redHistStrong)
plot(histBase, "Histogram", color=histColor, style=plot.style_histogram, histbase=0.0)

// Zone backgrounds with tonal changes
bgcolor(overbought ? color.new(redDark, 90) : na, title="Overbought Zone")
bgcolor(oversold ? color.new(greenDark, 90) : na, title="Oversold Zone")

// ===================================
// ALERTS
// ===================================
alertcondition(bullishCross, "Bullish Cross", "EMA Dist DYN: Bullish cross above dynamic center.")
alertcondition(bearishCross, "Bearish Cross", "EMA Dist DYN: Bearish cross below dynamic center.")
alertcondition(ta.crossover(sigmoidValue, upperBand), "Overbought", "EMA Dist DYN: Entered dynamic overbought zone.")
alertcondition(ta.crossunder(sigmoidValue, lowerBand), "Oversold", "EMA Dist DYN: Entered dynamic oversold zone.")

// ===================================
// INFO TABLE
// ===================================
var table infoTable = table.new(position.top_right, 2, 8,
     bgcolor=color.new(#0b1020, 8),
     frame_color=color.new(#5f87ff, 20),
     frame_width=2,
     border_width=1)

if barstate.islast and showTable
    // Header
    table.cell(infoTable, 0, 0, "Metric",
               bgcolor=color.new(#111a33, 10),
               text_color=color.new(#a7c7ff, 0),
               text_size=size.tiny,
               text_font_family=font.family_monospace)
    table.cell(infoTable, 1, 0, "Value",
               bgcolor=color.new(#111a33, 10),
               text_color=color.new(#a7c7ff, 0),
               text_size=size.tiny,
               text_font_family=font.family_monospace)

    // Oscillator
    table.cell(infoTable, 0, 1, "Oscillator",
               bgcolor=color.new(#16213d, 20),
               text_color=color.new(#d7e3ff, 0),
               text_size=size.tiny)
    table.cell(infoTable, 1, 1, str.tostring(sigmoidValue, "#.##"),
               bgcolor=color.new(#16213d, 20),
               text_color=oscillatorColor,
               text_size=size.tiny,
               text_font_family=font.family_monospace)

    // Center
    centerTextColor = sigmoidValue >= centerLine ? greenSoft : redSoft
    table.cell(infoTable, 0, 2, "Center",
               bgcolor=color.new(#16213d, 20),
               text_color=color.new(#d7e3ff, 0),
               text_size=size.tiny)
    table.cell(infoTable, 1, 2, str.tostring(centerLine, "#.##"),
               bgcolor=color.new(#16213d, 20),
               text_color=centerTextColor,
               text_size=size.tiny,
               text_font_family=font.family_monospace)

    // Bands
    table.cell(infoTable, 0, 3, "Upper Band",
               bgcolor=color.new(#1a203f, 25),
               text_color=color.new(#ffd0d8, 0),
               text_size=size.tiny)
    table.cell(infoTable, 1, 3, str.tostring(upperBand, "#.##"),
               bgcolor=color.new(#1a203f, 25),
               text_color=redSoft,
               text_size=size.tiny,
               text_font_family=font.family_monospace)

    table.cell(infoTable, 0, 4, "Lower Band",
               bgcolor=color.new(#1a203f, 25),
               text_color=color.new(#cbffe2, 0),
               text_size=size.tiny)
    table.cell(infoTable, 1, 4, str.tostring(lowerBand, "#.##"),
               bgcolor=color.new(#1a203f, 25),
               text_color=greenSoft,
               text_size=size.tiny,
               text_font_family=font.family_monospace)

    // Normalized
    normColor = normalizedDistance >= 0 ? greenStrong : redStrong
    table.cell(infoTable, 0, 5, "Normalized",
               bgcolor=color.new(#16213d, 20),
               text_color=color.new(#d7e3ff, 0),
               text_size=size.tiny)
    table.cell(infoTable, 1, 5, str.tostring(normalizedDistance, "#.##"),
               bgcolor=color.new(#16213d, 20),
               text_color=normColor,
               text_size=size.tiny,
               text_font_family=font.family_monospace)

    // ATR
    table.cell(infoTable, 0, 6, "ATR",
               bgcolor=color.new(#121a2f, 20),
               text_color=color.new(#f8e3a1, 0),
               text_size=size.tiny)
    atrText = atr >= 1 ? str.tostring(atr, "#.##") : str.tostring(atr, "#.########")
    table.cell(infoTable, 1, 6, atrText,
               bgcolor=color.new(#121a2f, 20),
               text_color=color.new(#ffd166, 0),
               text_size=size.tiny,
               text_font_family=font.family_monospace)

    // Status
    statusText = overbought ? "DYN OVERBOUGHT" : oversold ? "DYN OVERSOLD" : isBullish ? "BULLISH" : "BEARISH"
    statusColor = overbought ? redStrong : oversold ? greenStrong : isBullish ? greenSoft : redSoft
    statusBg = overbought ? color.new(redStrong, 85) : oversold ? color.new(greenStrong, 85) : isBullish ? color.new(greenDark, 85) : color.new(redDark, 85)

    table.cell(infoTable, 0, 7, "Status",
               bgcolor=color.new(#111a33, 10),
               text_color=color.new(#d7e3ff, 0),
               text_size=size.tiny)
    table.cell(infoTable, 1, 7, statusText,
               bgcolor=statusBg,
               text_color=statusColor,
               text_size=size.tiny,
               text_font_family=font.family_monospace)
