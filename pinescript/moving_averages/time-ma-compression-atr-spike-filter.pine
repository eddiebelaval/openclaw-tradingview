//@version=5
indicator("Time + MA Compression + ATR Spike Filter", overlay=true)

// =====================================
// SETTINGS
// =====================================

// blank = current chart timeframe
tfFilter = input.timeframe("", "Filter Timeframe (blank = current)")

// Time filter
useTimeFilter = input.bool(true, "Use Time Filter")

// SMA89 / SMA200 compression settings
useHTFCompression = input.bool(true, "Use SMA89/200 Compression Filter")
distThresholdHTF  = input.float(3.0, "Max distance between SMA89 and SMA200", step=0.1)
slopeBarsHTF      = input.int(5, "HTF slope bars", minval=1)
slopeThresholdHTF = input.float(1.0, "Max flat slope threshold", step=0.1)

// Short-term MA compression settings
useMACompression = input.bool(true, "Use SMA5/50 Compression Filter")
distThresholdMA  = input.float(1.5, "Min distance between SMA5 and SMA50", step=0.1)

// ATR spike filter
useATRSpikeFilter = input.bool(true, "Use ATR Spike Filter")
atrLen            = input.int(14, "ATR Length")
spikeMult         = input.float(1.5, "Previous candle max ATR multiple", step=0.1)

// =====================================
// TIME FILTER (UTC+8 / Singapore)
// =====================================

block1 = not na(time(timeframe.period, "0400-0700", "Asia/Singapore"))
block2 = not na(time(timeframe.period, "0830-0915", "Asia/Singapore"))
block3 = not na(time(timeframe.period, "1600-2045", "Asia/Singapore"))

timeBlocked = useTimeFilter ? (block1 or block2 or block3) : false
timeAllowed = not timeBlocked

// =====================================
// FILTER TIMEFRAME
// =====================================

tf = tfFilter == "" ? timeframe.period : tfFilter

// =====================================
// SMA89 / SMA200 COMPRESSION + FLAT FILTER
// =====================================

sma89_tf       = request.security(syminfo.tickerid, tf, ta.sma(close, 89))
sma200_tf      = request.security(syminfo.tickerid, tf, ta.sma(close, 200))
sma89_prev_tf  = request.security(syminfo.tickerid, tf, ta.sma(close, 89)[slopeBarsHTF])
sma200_prev_tf = request.security(syminfo.tickerid, tf, ta.sma(close, 200)[slopeBarsHTF])

maCloseTogetherHTF = math.abs(sma89_tf - sma200_tf) < distThresholdHTF
sma89FlatHTF       = math.abs(sma89_tf - sma89_prev_tf) < slopeThresholdHTF
sma200FlatHTF      = math.abs(sma200_tf - sma200_prev_tf) < slopeThresholdHTF

htfBlocked = useHTFCompression ? (maCloseTogetherHTF and sma89FlatHTF and sma200FlatHTF) : false
htfAllowed = not htfBlocked

// =====================================
// SMA5 / SMA50 COMPRESSION FILTER
// =====================================

sma5_tf  = request.security(syminfo.tickerid, tf, ta.sma(close, 5))
sma50_tf = request.security(syminfo.tickerid, tf, ta.sma(close, 50))

maDistance = math.abs(sma5_tf - sma50_tf)

// Allowed only if distance is wide enough
maCompressionBlocked = useMACompression ? (maDistance < distThresholdMA) : false
maCompressionAllowed = not maCompressionBlocked

// =====================================
// ATR SPIKE FILTER
// Block if previous candle range is too large
// =====================================

atr_tf = request.security(syminfo.tickerid, tf, ta.atr(atrLen))

prevHigh_tf = request.security(syminfo.tickerid, tf, high[1])
prevLow_tf  = request.security(syminfo.tickerid, tf, low[1])

prevRange_tf = prevHigh_tf - prevLow_tf

atrSpikeBlocked = useATRSpikeFilter ? (prevRange_tf > atr_tf * spikeMult) : false
atrSpikeAllowed = not atrSpikeBlocked

// =====================================
// FINAL FILTERS
// =====================================

buyAllowed  = timeAllowed and htfAllowed and maCompressionAllowed and atrSpikeAllowed
sellAllowed = timeAllowed and htfAllowed and maCompressionAllowed and atrSpikeAllowed

buyBlocked  = not buyAllowed
sellBlocked = not sellAllowed

// =====================================
// PLOTS
// =====================================

plot(sma89_tf, color=color.orange, title="SMA 89")
plot(sma200_tf, color=color.blue, title="SMA 200")
plot(sma50_tf, color=color.yellow, title="SMA 50")
plot(sma5_tf, color=color.aqua, title="SMA 5")

bgcolor(timeBlocked ? color.new(color.red, 85) : na, title="Blocked Time")
bgcolor(htfBlocked and not timeBlocked ? color.new(color.orange, 85) : na, title="Blocked HTF Compression")
bgcolor(maCompressionBlocked and not timeBlocked and not htfBlocked ? color.new(color.purple, 85) : na, title="Blocked MA Compression")
bgcolor(atrSpikeBlocked and not timeBlocked and not htfBlocked and not maCompressionBlocked ? color.new(color.blue, 85) : na, title="Blocked ATR Spike")

// =====================================
// ALERTS
// =====================================

alertcondition(buyAllowed, title="Buy Allowed Zone", message="Buy allowed")
alertcondition(sellAllowed, title="Sell Allowed Zone", message="Sell allowed")
alertcondition(buyBlocked, title="Buy Blocked Zone", message="Buy blocked")
alertcondition(sellBlocked, title="Sell Blocked Zone", message="Sell blocked")
