//@version=5
indicator("EMA 50/100/200", overlay=true)

ema200 = ta.ema(close, 200)
ema100 = ta.ema(close, 100)
ema50 = ta.ema(close, 50)

plot(ema200, color=color.gray, linewidth=1, title="EMA 200")
plot(ema100, color=color.gray, linewidth=1, title="EMA 100")
plot(ema50, color=color.gray, linewidth=1, title="EMA 50")

// Circle marks at crossover points
plot(ta.cross(ema50, ema100) ? ema50 : na, style=plot.style_circles, linewidth=4, color=color.blue, title="Cross 50/100")
plot(ta.cross(ema50, ema200) ? ema50 : na, style=plot.style_circles, linewidth=4, color=color.red, title="Cross 50/200")
plot(ta.cross(ema100, ema200) ? ema100 : na, style=plot.style_circles, linewidth=4, color=color.orange, title="Cross 100/200")
