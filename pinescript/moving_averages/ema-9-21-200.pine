//@version=5
indicator("Project Manager's EMAs (9, 21, 200)", overlay=true)

// --- INPUT SETTINGS (Editable in Settings Menu) ---
len1 = input.int(9, minval=1, title="EMA 1 Length")
len2 = input.int(21, minval=1, title="EMA 2 Length")
len3 = input.int(200, minval=1, title="EMA 3 Length")

// --- CALCULATIONS ---
ema1 = ta.ema(close, len1)
ema2 = ta.ema(close, len2)
ema3 = ta.ema(close, len3)

// --- PLOTTING ---
// EMA 9 (Blue)
plot(ema1, color=color.blue, title="EMA 9", linewidth=2)

// EMA 21 (Orange)
plot(ema2, color=color.orange, title="EMA 21", linewidth=2)

// EMA 200 (White)
plot(ema3, color=color.white, title="EMA 200", linewidth=3)
