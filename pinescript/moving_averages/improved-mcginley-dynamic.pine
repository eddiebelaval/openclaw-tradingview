//@version=6
indicator('Improved McGinley Dynamic', overlay = true)
length = input.int(10, 'MD Periods', minval = 1)
src = close
md = 0.0


md := nz(md[1]) == 0 ? ta.sma(src, length) : nz(md[1]) + (src - nz(md[1])) / (length * math.pow(math.max(math.min(src / nz(md[1]), 2.0), 0.5), 4))


// Plots
plot(md, 'McGinley', color = color.blue, linewidth = 2)


// ── Show the current value as a label ────────
var label valLabel = label.new(x = bar_index, y = na, text = '', style = label.style_label_left, color = color.new(color.blue, 90), textcolor = color.white, size = size.normal)

// Update the label every bar
label.set_xy(valLabel, bar_index, md)
label.set_text(valLabel, str.tostring(md, '#.##'))
