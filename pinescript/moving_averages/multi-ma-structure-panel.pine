//@version=6
indicator("Multi MA Structure Panel", overlay=true)

//====================================================
// Inputs
//====================================================
groupMA = "MA (Current TF)"
ma_type = input.string("EMA", "MA Type", options=["EMA", "SMA"], group=groupMA)
src     = close
flat_th = input.float(0.0, "Flat Threshold", step=0.0001, group=groupMA)

// MA Lengths（タイムフレームではない）
use1 = input.bool(true,  "Use L1", group=groupMA)
len1 = input.int(20,     "L1 Length", minval=1, group=groupMA)

use2 = input.bool(true,  "Use L2", group=groupMA)
len2 = input.int(50,     "L2 Length", minval=1, group=groupMA)

use3 = input.bool(true,  "Use L3", group=groupMA)
len3 = input.int(75,     "L3 Length", minval=1, group=groupMA)

use4 = input.bool(true,  "Use L4", group=groupMA)
len4 = input.int(100,    "L4 Length", minval=1, group=groupMA)

use5 = input.bool(true,  "Use L5", group=groupMA)
len5 = input.int(200,    "L5 Length", minval=1, group=groupMA)

use6 = input.bool(false, "Use L6", group=groupMA)
len6 = input.int(300,    "L6 Length", minval=1, group=groupMA)

// 表示
show_ma_lines = input.bool(true, "Show MA Lines on Chart", group=groupMA)

// ★追加：MAライン色（デフォルトを分ける）
groupCol = "MA Line Colors"
col1 = input.color(color.new(color.yellow, 0), "L1 color", group=groupCol)
col2 = input.color(color.new(color.orange, 0), "L2 color", group=groupCol)
col3 = input.color(color.new(color.aqua,   0), "L3 color", group=groupCol)
col4 = input.color(color.new(color.blue,   0), "L4 color", group=groupCol)
col5 = input.color(color.new(color.fuchsia,0), "L5 color", group=groupCol)
col6 = input.color(color.new(color.gray,   0), "L6 color", group=groupCol)

//====================================================
// HTF Filter
//====================================================
groupHTF = "HTF Filter"
use_htf_filter = input.bool(true, "Use HTF 200MA filter", group=groupHTF)
htf_tf         = input.timeframe("15", "HTF Timeframe", group=groupHTF)
htf_ma_type    = input.string("EMA", "HTF 200MA Type", options=["EMA","SMA"], group=groupHTF)
htf_len        = input.int(200, "HTF MA Length", minval=1, group=groupHTF)
htf_mode       = input.string("Price vs HTF MA", "Filter Mode", options=["Price vs HTF MA","HTF MA Slope"], group=groupHTF)
show_htf_ma    = input.bool(true, "Show HTF MA on chart", group=groupHTF)

// ★追加：HTF MA色
htf_col = input.color(color.new(color.white, 0), "HTF MA color", group=groupHTF)

//====================================================
// Functions
//====================================================
f_ma(_src, _len) =>
    ma_type == "EMA" ? ta.ema(_src, _len) : ta.sma(_src, _len)

f_ma_type(_src, _len, _type) =>
    _type == "EMA" ? ta.ema(_src, _len) : ta.sma(_src, _len)

f_state(_ma) =>
    s = _ma - _ma[1]
    st = 0
    if s > flat_th
        st := 1
    else if s < -flat_th
        st := -1
    else
        st := 0
    st

//====================================================
// Current TF MAs
//====================================================
ma1 = f_ma(src, len1)
ma2 = f_ma(src, len2)
ma3 = f_ma(src, len3)
ma4 = f_ma(src, len4)
ma5 = f_ma(src, len5)
ma6 = f_ma(src, len6)

st1 = use1 ? f_state(ma1) : na
st2 = use2 ? f_state(ma2) : na
st3 = use3 ? f_state(ma3) : na
st4 = use4 ? f_state(ma4) : na
st5 = use5 ? f_state(ma5) : na
st6 = use6 ? f_state(ma6) : na

//====================================================
// Plot MA lines (colors per length)
//====================================================
plot(show_ma_lines and use1 ? ma1 : na, title="MA L1", linewidth=2, color=col1)
plot(show_ma_lines and use2 ? ma2 : na, title="MA L2", linewidth=2, color=col2)
plot(show_ma_lines and use3 ? ma3 : na, title="MA L3", linewidth=2, color=col3)
plot(show_ma_lines and use4 ? ma4 : na, title="MA L4", linewidth=2, color=col4)
plot(show_ma_lines and use5 ? ma5 : na, title="MA L5", linewidth=2, color=col5)
plot(show_ma_lines and use6 ? ma6 : na, title="MA L6", linewidth=2, color=col6)

//====================================================
// HTF MA via security (no lookahead)  ※1行固定
//====================================================
htf_ma = request.security(syminfo.tickerid, htf_tf, f_ma_type(close, htf_len, htf_ma_type), barmerge.gaps_off, barmerge.lookahead_off)
htf_ma_slope = htf_ma - htf_ma[1]

htfLongOK  = true
htfShortOK = true
if use_htf_filter
    if htf_mode == "Price vs HTF MA"
        htfLongOK  := close > htf_ma
        htfShortOK := close < htf_ma
    else
        htfLongOK  := htf_ma_slope > 0
        htfShortOK := htf_ma_slope < 0

plot(show_htf_ma and use_htf_filter ? htf_ma : na, title="HTF MA", linewidth=2, color=htf_col)

//====================================================
// Panel (top-right)
//====================================================
var table t = table.new(position.top_right, 3, 9, border_width=1)

f_row(_row, _enabled, _len, _state) =>
    if _enabled
        dirTxt = _state == 1 ? "▲" : _state == -1 ? "▼" : "→"
        dirCol = _state == 1 ? color.new(color.lime, 0) : _state == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)

        table.cell(t, 0, _row, ma_type,            text_color=color.white)
        table.cell(t, 1, _row, str.tostring(_len), text_color=color.white)
        table.cell(t, 2, _row, dirTxt,             text_color=color.white)

        table.cell_set_bgcolor(t, 0, _row, color.new(color.black, 70))
        table.cell_set_bgcolor(t, 1, _row, color.new(color.black, 70))
        table.cell_set_bgcolor(t, 2, _row, dirCol)
    else
        table.cell(t, 0, _row, "", text_color=color.white)
        table.cell(t, 1, _row, "", text_color=color.white)
        table.cell(t, 2, _row, "", text_color=color.white)
        table.cell_set_bgcolor(t, 0, _row, color.new(color.black, 85))
        table.cell_set_bgcolor(t, 1, _row, color.new(color.black, 85))
        table.cell_set_bgcolor(t, 2, _row, color.new(color.black, 85))

if barstate.islast
    table.cell(t, 0, 0, "MA",     text_color=color.white)
    table.cell(t, 1, 0, "Length", text_color=color.white)
    table.cell(t, 2, 0, "Slope",  text_color=color.white)
    table.cell_set_bgcolor(t, 0, 0, color.new(color.black, 0))
    table.cell_set_bgcolor(t, 1, 0, color.new(color.black, 0))
    table.cell_set_bgcolor(t, 2, 0, color.new(color.black, 0))

    f_row(1, use1, len1, st1)
    f_row(2, use2, len2, st2)
    f_row(3, use3, len3, st3)
    f_row(4, use4, len4, st4)
    f_row(5, use5, len5, st5)
    f_row(6, use6, len6, st6)

    table.cell(t, 0, 7, "HTF", text_color=color.white)
    table.cell(t, 1, 7, use_htf_filter ? (htf_tf + " " + htf_ma_type + str.tostring(htf_len)) : "OFF", text_color=color.white)
    table.cell(t, 2, 7, use_htf_filter ? (htf_mode == "Price vs HTF MA" ? (close > htf_ma ? "↑" : close < htf_ma ? "↓" : "→") : (htf_ma_slope > 0 ? "▲" : htf_ma_slope < 0 ? "▼" : "→")) : "-", text_color=color.white)
    table.cell_set_bgcolor(t, 0, 7, color.new(color.black, 40))
    table.cell_set_bgcolor(t, 1, 7, color.new(color.black, 40))
    table.cell_set_bgcolor(t, 2, 7, color.new(color.black, 40))
