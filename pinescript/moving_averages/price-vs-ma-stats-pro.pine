//@version=5
indicator("Price vs MA Stats Pro", overlay=true)

// --- User Inputs ---
grpMA = "Moving Average Settings"
maType = input.string("EMA", title="MA Type", options=["SMA", "EMA"], group=grpMA)
maLength = input.int(50, title="MA Period (Length)", group=grpMA)
maTF = input.timeframe("", title="MA Timeframe", group=grpMA)

grpDate = "Date Filters"
useAllData = input.bool(false, title="Calculate from Beginning of Data (Ignore 'From')", group=grpDate)
fromDate = input.time(timestamp("2020-01-01 00:00"), title="From Date", group=grpDate)
toDate = input.time(timestamp("2026-12-31 23:59"), title="To Date", group=grpDate)

// --- Function for MA Type ---
getMA(type, src, len) =>
    type == "SMA" ? ta.sma(src, len) : ta.ema(src, len)

// --- Calculations ---
maValueBase = getMA(maType, close, maLength)
maValue = request.security(syminfo.tickerid, maTF, maValueBase)

// Date logic: Either use all data up to the To Date, or strict From/To range
inDateRange = useAllData ? (time <= toDate) : (time >= fromDate and time <= toDate)

// Variables to track stats
var int totalBars = 0
var int barsAbove = 0
var int barsBelow = 0
var int crossUpCount = 0
var int crossDownCount = 0

// Check conditions
isAbove = close > maValue
isBelow = close < maValue
crossUp = ta.crossover(close, maValue)
crossDown = ta.crossunder(close, maValue)

// Count data only within the date range
if inDateRange and not na(maValue)
    totalBars += 1
    if isAbove
        barsAbove += 1
    if isBelow
        barsBelow += 1
    if crossUp
        crossUpCount += 1
    if crossDown
        crossDownCount += 1

// --- Final Math ---
float pctAbove = totalBars > 0 ? (barsAbove / totalBars) * 100 : 0
// A positive trend ends when it crosses down, and vice versa. 
float avgPosTrend = crossDownCount > 0 ? (barsAbove / crossDownCount) : barsAbove
float avgNegTrend = crossUpCount > 0 ? (barsBelow / crossUpCount) : barsBelow

// --- Display Table ---
var tbl = table.new(position.top_right, 2, 5, border_width=1, border_color=color.black)
if barstate.islast
    table.cell(tbl, 0, 0, "Metric", text_color=color.white, bgcolor=color.navy)
    table.cell(tbl, 1, 0, "Value", text_color=color.white, bgcolor=color.navy)
    
    table.cell(tbl, 0, 1, "% Time Price > MA", text_color=color.black, bgcolor=color.white)
    table.cell(tbl, 1, 1, str.tostring(pctAbove, "#.##") + "%", text_color=color.black, bgcolor=color.white)
    
    table.cell(tbl, 0, 2, "Total Crosses", text_color=color.black, bgcolor=color.white)
    table.cell(tbl, 1, 2, str.tostring(crossUpCount + crossDownCount), text_color=color.black, bgcolor=color.white)
    
    table.cell(tbl, 0, 3, "Avg + Trend (Bars)", text_color=color.black, bgcolor=color.white)
    table.cell(tbl, 1, 3, str.tostring(avgPosTrend, "#.##"), text_color=color.black, bgcolor=color.white)

    table.cell(tbl, 0, 4, "Avg - Trend (Bars)", text_color=color.black, bgcolor=color.white)
    table.cell(tbl, 1, 4, str.tostring(avgNegTrend, "#.##"), text_color=color.black, bgcolor=color.white)

// --- Visuals ---
plot(maValue, color=color.orange, linewidth=2, title="Moving Average")
// Plot arrows above/below the price bars
plotshape(crossUp and inDateRange ? low : na, title="Cross Up Arrow", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(crossDown and inDateRange ? high : na, title="Cross Down Arrow", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
// Highlight background only if using a specific date range (keeps chart clean if using 'All Data')
bgcolor(inDateRange and not useAllData ? color.new(color.blue, 95) : na, title="Date Filter Highlight")
