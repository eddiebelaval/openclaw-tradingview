//@version=5
indicator("EMA Trend System with ORB, VWAP & Bias Score - by TenAMTrader", overlay=true, max_labels_count=500, max_boxes_count=50)

//====================================================
// INPUTS
//====================================================
groupEMA  = "EMA Settings"
showEMA3  = input.bool(false, "Show 3 EMA", group=groupEMA)
fastLen   = input.int(3, "Fast EMA", group=groupEMA)
midLen    = input.int(8, "Mid EMA", group=groupEMA)
slowLen   = input.int(21, "Slow EMA", group=groupEMA)
ema200Len = input.int(200, "EMA 200", group=groupEMA)

groupSMA = "Daily SMA"
showSMA20 = input.bool(true, "Show 20 Day SMA", group=groupSMA)
showSMA50 = input.bool(true, "Show 50 Day SMA", group=groupSMA)

groupORB = "Opening Range"
useORB                = input.bool(false, "Use ORB Filter", group=groupORB)
showORB               = input.bool(true, "Show ORB Levels", group=groupORB)
showORBBox            = input.bool(false, "Show ORB Box", group=groupORB)
showORBLabels         = input.bool(false, "Show ORB Labels", group=groupORB)
orbMinutes            = input.int(15, "Opening Range Minutes", group=groupORB)
showMarkersOutsideORB = input.bool(true, "Only Show Markers Outside ORB", group=groupORB)

groupRe = "Re-Entry"
enableReEntry      = input.bool(true, "Enable Re-Entry Dots", group=groupRe)
requireTouchMidEMA = input.bool(true, "Require Touch 8 EMA", group=groupRe)
requireHoldSlowEMA = input.bool(true, "Require Hold 21 EMA", group=groupRe)

groupDisp = "Display"
backgroundMode = input.string("Fast Bias", "Background Mode", options=["Fast Bias", "Strict Trend", "Off"], group=groupDisp)
showTrendBox   = input.bool(true, "Trend Box", group=groupDisp)
showSignals    = input.bool(false, "Show Buy / Sell / RE Markers", group=groupDisp)
showCrossFlip  = input.bool(false, "Show 3/21 Cross Signals", group=groupDisp)
showEMACloud   = input.bool(true, "Show 8/21 EMA Cloud", group=groupDisp)

groupCloud = "Cloud Colors"
bullCloudColor = input.color(color.new(color.green, 60), "Bull Cloud", group=groupCloud)
bearCloudColor = input.color(color.new(color.red, 60), "Bear Cloud", group=groupCloud)

//====================================================
// CORE
//====================================================
emaFast = ta.ema(close, fastLen)
emaMid  = ta.ema(close, midLen)
emaSlow = ta.ema(close, slowLen)
ema200  = ta.ema(close, ema200Len)
vwapVal = ta.vwap(hlc3)

sma20 = request.security(syminfo.tickerid, "D", ta.sma(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
sma50 = request.security(syminfo.tickerid, "D", ta.sma(close, 50), barmerge.gaps_off, barmerge.lookahead_off)

//====================================================
// OPENING RANGE
//====================================================
var float orbHigh = na
var float orbLow  = na
var box orbBox = na

var label orbHighLabel = na
var label orbMidLabel  = na
var label orbLowLabel  = na

sessionStart = timestamp("America/New_York", year, month, dayofmonth, 9, 30)
orbEnd       = sessionStart + orbMinutes * 60 * 1000

inORB    = time >= sessionStart and time < orbEnd
afterORB = time >= orbEnd

newDay = dayofmonth != dayofmonth[1] or month != month[1] or year != year[1]

if newDay
    orbHigh := na
    orbLow  := na
    if not na(orbBox)
        box.delete(orbBox)
        orbBox := na
    if not na(orbHighLabel)
        label.delete(orbHighLabel)
        orbHighLabel := na
    if not na(orbMidLabel)
        label.delete(orbMidLabel)
        orbMidLabel := na
    if not na(orbLowLabel)
        label.delete(orbLowLabel)
        orbLowLabel := na

if inORB
    orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
    orbLow  := na(orbLow) ? low : math.min(orbLow, low)

    if showORBBox
        if na(orbBox)
            orbBox := box.new(left=bar_index, top=orbHigh, right=bar_index, bottom=orbLow, bgcolor=color.new(color.blue, 88), border_color=color.new(color.blue, 50))
        else
            box.set_right(orbBox, bar_index)
            box.set_top(orbBox, orbHigh)
            box.set_bottom(orbBox, orbLow)

if afterORB and showORBBox and not na(orbBox)
    box.set_right(orbBox, bar_index)

orbMid = not na(orbHigh) and not na(orbLow) ? (orbHigh + orbLow) / 2.0 : na

if showORB and showORBLabels and not showORBBox and not na(orbHigh) and not na(orbLow)
    if na(orbHighLabel)
        orbHighLabel := label.new(bar_index + 1, orbHigh, "ORBH", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=color.green, size=size.tiny)
    else
        label.set_xy(orbHighLabel, bar_index + 1, orbHigh)
        label.set_text(orbHighLabel, "ORBH")
        label.set_textcolor(orbHighLabel, color.green)

    if na(orbMidLabel)
        orbMidLabel := label.new(bar_index + 1, orbMid, "ORBM", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=color.yellow, size=size.tiny)
    else
        label.set_xy(orbMidLabel, bar_index + 1, orbMid)
        label.set_text(orbMidLabel, "ORBM")
        label.set_textcolor(orbMidLabel, color.yellow)

    if na(orbLowLabel)
        orbLowLabel := label.new(bar_index + 1, orbLow, "ORBL", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=color.red, size=size.tiny)
    else
        label.set_xy(orbLowLabel, bar_index + 1, orbLow)
        label.set_text(orbLowLabel, "ORBL")
        label.set_textcolor(orbLowLabel, color.red)
else
    if not na(orbHighLabel)
        label.delete(orbHighLabel)
        orbHighLabel := na
    if not na(orbMidLabel)
        label.delete(orbMidLabel)
        orbMidLabel := na
    if not na(orbLowLabel)
        label.delete(orbLowLabel)
        orbLowLabel := na

//====================================================
// TREND STRUCTURE
//====================================================
bullStack = emaFast > emaMid and emaMid > emaSlow
bearStack = emaFast < emaMid and emaMid < emaSlow

bullSlope = emaFast > emaFast[1] and emaMid > emaMid[1]
bearSlope = emaFast < emaFast[1] and emaMid < emaMid[1]

spreadPct = math.abs(emaFast - emaSlow) / close * 100.0
spreadOK  = spreadPct > 0.05

//====================================================
// PRIMARY SIGNALS
//====================================================
bullReclaim = close[1] < emaFast[1] and close > emaFast
bearReclaim = close[1] > emaFast[1] and close < emaFast

orbBullOk = not useORB or (afterORB and not na(orbHigh) and close > orbHigh)
orbBearOk = not useORB or (afterORB and not na(orbLow) and close < orbLow)

longSignalRaw  = bullReclaim and bullStack and spreadOK and orbBullOk
shortSignalRaw = bearReclaim and bearStack and spreadOK and orbBearOk

var int phaseState = 0
longSignal  = longSignalRaw and phaseState != 1
shortSignal = shortSignalRaw and phaseState != -1

if longSignal
    phaseState := 1
else if shortSignal
    phaseState := -1
else if not bullStack and not bearStack
    phaseState := 0

//====================================================
// RE-ENTRY
//====================================================
var bool longReEntryAvailable  = false
var bool shortReEntryAvailable = false

if longSignal
    longReEntryAvailable  := true
    shortReEntryAvailable := false

if shortSignal
    shortReEntryAvailable := true
    longReEntryAvailable  := false

if phaseState == 0
    longReEntryAvailable  := false
    shortReEntryAvailable := false

longTouchMid  = low <= emaMid
shortTouchMid = high >= emaMid

longHoldSlow  = not requireHoldSlowEMA or low > emaSlow
shortHoldSlow = not requireHoldSlowEMA or high < emaSlow

longReEntry =
     enableReEntry and
     longReEntryAvailable and
     phaseState == 1 and
     (not requireTouchMidEMA or longTouchMid) and
     longHoldSlow and
     bullStack

shortReEntry =
     enableReEntry and
     shortReEntryAvailable and
     phaseState == -1 and
     (not requireTouchMidEMA or shortTouchMid) and
     shortHoldSlow and
     bearStack

if longReEntry
    longReEntryAvailable := false

if shortReEntry
    shortReEntryAvailable := false

//====================================================
// TREND / BIAS
//====================================================
strongBull = bullStack and bullSlope
strongBear = bearStack and bearSlope

trendDir =
     strongBull ? 1 :
     strongBear ? -1 :
     bullStack ? 1 :
     bearStack ? -1 :
     0

trendText =
     trendDir == 1 ? "BULLISH" :
     trendDir == -1 ? "BEARISH" :
     "NEUTRAL"

strengthText =
     (strongBull or strongBear) ? "STRONG" :
     trendDir != 0 ? "WEAK" :
     "NONE"

biasBull  = emaFast >= emaSlow
biasText  = biasBull ? "BULLISH" : "BEARISH"
biasColor = biasBull ? color.lime : color.red

above200    = close >= ema200
ema200Text  = above200 ? "ABOVE" : "BELOW"
ema200Color = above200 ? color.green : color.red

//====================================================
// WEIGHTED BIAS ENGINE (1-10)
//====================================================
orbBiasPoints = afterORB and not na(orbHigh) and not na(orbLow) ? (close > orbHigh ? 8.0 : close < orbLow ? -8.0 : 0.0) : 0.0

biasRaw =
     (close > ema200 ? 18.0 : -18.0) +
     (close > vwapVal ? 18.0 : -18.0) +
     (close > sma50 ? 13.0 : -13.0) +
     (close > sma20 ? 11.0 : -11.0) +
     (emaMid > emaSlow ? 14.0 : -14.0) +
     (close > emaSlow ? 8.0 : -8.0) +
     (close > emaMid ? 6.0 : -6.0) +
     orbBiasPoints +
     (close >= open ? 4.0 : -4.0)

biasScore = 1.0 + ((biasRaw + 100.0) / 200.0) * 9.0
biasScoreClamped = math.max(1.0, math.min(10.0, biasScore))
biasScoreText = str.tostring(biasScoreClamped, "#.#") + "/10"

biasScoreColor =
     biasScoreClamped >= 9.0 ? color.lime :
     biasScoreClamped >= 7.0 ? color.green :
     biasScoreClamped >= 5.0 ? color.gray :
     biasScoreClamped >= 3.0 ? color.new(color.red, 20) :
     color.red

//====================================================
// BACKGROUND
//====================================================
bgFast   = biasBull ? color.new(color.green, 90) : color.new(color.red, 90)
bgStrict = trendDir == 1 ? color.new(color.green, 90) : trendDir == -1 ? color.new(color.red, 90) : na

bgColor = backgroundMode == "Fast Bias" ? bgFast : backgroundMode == "Strict Trend" ? bgStrict : na
bgcolor(bgColor)

//====================================================
// EMA CLOUD
//====================================================
cloudTopPlot = plot(showEMACloud ? emaMid : na, title="Cloud Top Hidden", display=display.none, editable=false)
cloudBotPlot = plot(showEMACloud ? emaSlow : na, title="Cloud Bottom Hidden", display=display.none, editable=false)
fill(cloudTopPlot, cloudBotPlot, color = emaMid > emaSlow ? bullCloudColor : bearCloudColor, title="Cloud Color", editable=true)

//====================================================
// EMA CROSS
//====================================================
bullFlip = ta.crossover(emaFast, emaSlow)
bearFlip = ta.crossunder(emaFast, emaSlow)

plotshape(showCrossFlip and bullFlip, title="3/21 Bull Flip", style=shape.cross, location=location.belowbar, color=color.green, size=size.small)
plotshape(showCrossFlip and bearFlip, title="3/21 Bear Flip", style=shape.cross, location=location.abovebar, color=color.red, size=size.small)

//====================================================
// PLOTS
//====================================================
plot(showEMA3 ? emaFast : na, "EMA 3", color=color.rgb(220, 220, 220), linewidth=1)
plot(emaMid,  "EMA 8", color=color.blue, linewidth=1)
plot(emaSlow, "EMA 21 Bias", color=biasColor, linewidth=1)
plot(ema200,  "EMA 200", color=color.rgb(10, 176, 226), linewidth=1)
plot(vwapVal, "VWAP", color=color.rgb(84, 3, 143), linewidth=1)

plot(showORB and not showORBBox ? orbHigh : na, "ORB High", color=color.green, linewidth=1, style=plot.style_linebr)
plot(showORB and not showORBBox ? orbMid  : na, "ORB Mid",  color=color.yellow, linewidth=1, style=plot.style_linebr)
plot(showORB and not showORBBox ? orbLow  : na, "ORB Low",  color=color.red, linewidth=1, style=plot.style_linebr)

//====================================================
// DAILY SMAs
//====================================================
plot(showSMA20 ? sma20 : na, "20 Day SMA", color=color.teal, linewidth=1, style=plot.style_circles)
plot(showSMA50 ? sma50 : na, "50 Day SMA", color=color.orange, linewidth=1, style=plot.style_circles)

//====================================================
// SIGNAL MARKERS
//====================================================
markerOk = not showMarkersOutsideORB or afterORB

plotshape(showSignals and markerOk and longSignal, title="Buy Signal", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="BUY")
plotshape(showSignals and markerOk and shortSignal, title="Sell Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL")

plotshape(showSignals and markerOk and longReEntry, title="Long RE", style=shape.circle, location=location.belowbar, color=color.aqua, size=size.tiny, text="RE")
plotshape(showSignals and markerOk and shortReEntry, title="Short RE", style=shape.circle, location=location.abovebar, color=color.orange, size=size.tiny, text="RE")

//====================================================
// TREND BOX
//====================================================
var table trendBox = table.new(position.top_right, 2, 5, border_width=1)

if barstate.islast
    if showTrendBox
        trendColor = trendDir == 1 ? color.green : trendDir == -1 ? color.red : color.gray

        table.cell(trendBox, 0, 0, "TREND", bgcolor=color.black, text_color=color.white)
        table.cell(trendBox, 1, 0, trendText, bgcolor=trendColor, text_color=color.white)

        table.cell(trendBox, 0, 1, "STRENGTH", bgcolor=color.black, text_color=color.white)
        table.cell(trendBox, 1, 1, strengthText, bgcolor=trendColor, text_color=color.white)

        table.cell(trendBox, 0, 2, "21 BIAS", bgcolor=color.black, text_color=color.white)
        table.cell(trendBox, 1, 2, biasText, bgcolor=biasColor, text_color=color.white)

        table.cell(trendBox, 0, 3, "200 EMA", bgcolor=color.black, text_color=color.white)
        table.cell(trendBox, 1, 3, ema200Text, bgcolor=ema200Color, text_color=color.white)

        table.cell(trendBox, 0, 4, "BIAS SCORE", bgcolor=color.black, text_color=color.white)
        table.cell(trendBox, 1, 4, biasScoreText, bgcolor=biasScoreColor, text_color=color.white)
    else
        table.clear(trendBox, 0, 0, 1, 4)

//====================================================
// ALERTS
//====================================================
alertcondition(longSignal, "Long Signal", "NQ EMA Long")
alertcondition(shortSignal, "Short Signal", "NQ EMA Short")
alertcondition(longReEntry, "Long Re-Entry", "NQ EMA Long RE")
alertcondition(shortReEntry, "Short Re-Entry", "NQ EMA Short RE")
alertcondition(bullFlip, "3/21 Bull Flip", "NQ EMA 3 crossed above 21")
alertcondition(bearFlip, "3/21 Bear Flip", "NQ EMA 3 crossed below 21")
