//@version=6
//copyright 2026 fhc87518
indicator("MAGIC NYSE TICK", shorttitle="MAGIC TICK", overlay=true, timeframe="1D")

highLimit = 800.0
lowLimit  = 800.0

// TICK.NY data
tickHigh  = request.security("TICK.NY", "1D", high)
tickLow   = request.security("TICK.NY", "1D", low)
tickClose = request.security("TICK.NY", "1D", close)

// Clamp to ±800
highClamped = math.min(tickHigh, highLimit)
lowClamped  = math.max(tickLow, -lowLimit)

// Base SMA bands
smaHigh = ta.ema(highClamped, 5)
smaLow  = ta.ema(lowClamped, 5)

// 30% displacement
tickRange = tickHigh - tickLow
displace = tickRange * 0.30
upperBand = tickHigh + displace
lowerBand = tickLow - displace

// Main bands
plot(upperBand, "Upper (+30%)", color.blue, linewidth=3)
plot(lowerBand, "Lower (-30%)", color.red, linewidth=3)
fill(plot(upperBand), plot(lowerBand), color.new(color.yellow, 90))

// Yellow dotted reference lines
hline(800,  "800", color.yellow, linestyle=hline.style_dotted, linewidth=1)
hline(-800, "-800", color.yellow, linestyle=hline.style_dotted, linewidth=1)
hline(1000, "1000", color.yellow, linestyle=hline.style_dotted, linewidth=1)
hline(-1000, "-1000", color.yellow, linestyle=hline.style_dotted, linewidth=1)
hline(1200, "1200", color.yellow, linestyle=hline.style_dotted, linewidth=1)
hline(-1200, "-1200", color.yellow, linestyle=hline.style_dotted, linewidth=1)
