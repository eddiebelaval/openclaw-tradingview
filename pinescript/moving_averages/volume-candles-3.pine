//@version=6
indicator("Institutional Body Candles - Clean Arrows", overlay=true)

// 1. Inputs
lookback = input.int(20, "Lookback Period", minval=1)
volMult = input.float(1.5, "Volume Multiplier", minval=1.0)
bodyMult = input.float(2.0, "Body Size Multiplier", minval=1.0)

// 2. Calculations
avgBody = ta.sma(math.abs(close - open), lookback)
avgVol = ta.sma(volume, lookback)

// Condition: Badi Body + Bada Volume
isBigBull = (close > open) and (math.abs(close - open) > avgBody * bodyMult) and (volume > avgVol * volMult)
isBigBear = (close < open) and (math.abs(close - open) > avgBody * bodyMult) and (volume > avgVol * volMult)

// 3. Visuals
// Candle Color change
barcolor(isBigBull ? color.rgb(0, 255, 170) : isBigBear ? color.rgb(255, 0, 80) : na)

// --- Triangle Arrows ONLY ---
// style=shape.triangleup (Up Arrow) aur shape.triangledown (Down Arrow)
plotshape(isBigBull, title="Buy Arrow", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.small)
plotshape(isBigBear, title="Sell Arrow", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small)

// Background highlight (optional - aap ise hata bhi sakte hain)
bgcolor(isBigBull ? color.new(color.green, 90) : isBigBear ? color.new(color.red, 90) : na)
