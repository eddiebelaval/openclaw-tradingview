//@version=5
strategy("Gelişmiş Trend ve Momentum Al-Sat Robotu", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1)

// --- Girdiler (Ayarlar) ---
atrPeriod = input.int(10, "SuperTrend ATR Dönemi", minval=1)
src = input(close, "Kaynak")
multiplier = input.float(3.0, "SuperTrend Çarpanı", step=0.1)
ema200Length = input.int(200, "Uzun Vadeli Trend (EMA 200)")
ema34Length = input.int(34, "Orta Vadeli Trend (EMA 34)")
ema55Length = input.int(55, "Destek Trendi (EMA 55)")
rsiLength = input.int(14, "RSI Uzunluğu")
rsiOverbought = input.int(70, "RSI Aşırı Satış Eşiği")
rsiOversold = input.int(30, "RSI Aşırı Alım Eşiği")

// --- Bot Entegrasyon Mesaj Ayarları ---
group_bot = "Bot Mesaj Ayarları (JSON)"
buyMsgInput = input.string('{"action": "buy", "amount": "100%"}', "AL Mesajı", group=group_bot)
sellHalfMsgInput = input.string('{"action": "sell", "amount": "50%"}', "%50 SAT Mesajı", group=group_bot)
sellAllMsgInput = input.string('{"action": "sell", "amount": "100%"}', "HEPSİNİ SAT Mesajı", group=group_bot)

// --- Hesaplamalar ---
// 1. SuperTrend Hesaplaması
[supertrend, direction] = ta.supertrend(multiplier, atrPeriod)

// 2. EMA Hesaplamaları
ema200 = ta.ema(close, ema200Length)
ema34 = ta.ema(close, ema34Length)
ema55 = ta.ema(close, ema55Length)

// 3. RSI Hesaplaması
rsiValue = ta.rsi(close, rsiLength)

// --- Al-Sat Koşulları ---

// ANA AL Koşulu:
buyCondition = ta.crossover(close, ema34) and close > ema200 and rsiValue > rsiOversold

// KADEMELİ SAT Koşulları:
// 1. %50 SAT: Fiyat EMA 34'ün altına sarkınca
sellHalfCondition = ta.crossunder(close, ema34)

// 2. HEPSİNİ SAT: Fiyat EMA 55'in altına sarkınca veya SuperTrend Sat verince
sellAllCondition = ta.crossunder(close, ema55) or (ta.change(direction) > 0 and close < ema200)

// --- Strateji Emir Yönetimi (Robot Mantığı) ---

// Alım Emri
if (buyCondition)
    strategy.entry("AL", strategy.long, alert_message=buyMsgInput)

// Kademeli Satış (%50)
if (strategy.position_size > 0 and sellHalfCondition)
    strategy.close("AL", qty_percent=50, comment="%50 Kar Al", alert_message=sellHalfMsgInput)

// Tam Kapatma
if (strategy.position_size > 0 and sellAllCondition)
    strategy.close("AL", comment="Hepsini Sat", alert_message=sellAllMsgInput)

// --- Görselleştirme ---
plot(ema200, "EMA 200", color=color.new(color.gray, 50), linewidth=1)
plot(ema34, "EMA 34", color=color.new(color.blue, 0), linewidth=2)
plot(ema55, "EMA 55", color=color.new(color.orange, 0), linewidth=2)

plot(direction < 0 ? supertrend : na, "Yükseliş Trendi", color=color.green, linewidth=2, style=plot.style_linebr)
plot(direction > 0 ? supertrend : na, "Düşüş Trendi", color=color.red, linewidth=2, style=plot.style_linebr)

plotshape(buyCondition, title="AL Sinyali", text="AL", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.small)
plotshape(sellHalfCondition, title="%50 SAT Sinyali", text="%50 SAT", style=shape.labeldown, location=location.abovebar, color=color.orange, textcolor=color.white, size=size.small)
plotshape(sellAllCondition, title="HEPSİNİ SAT Sinyali", text="HEPSİNİ SAT", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.small)

bgcolor(strategy.position_size > 0 ? color.new(color.green, 90) : na)
