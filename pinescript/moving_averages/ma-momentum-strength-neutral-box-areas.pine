//@version=5
indicator("MA Momentum Strength — Neutral Box Areas", overlay=true)

// ───── Inputs
maType = input.string("SMA", "MA Type", options=["SMA", "EMA"])
src = input.source(close, "Source")

bullBaseColor = input.color(color.green, "Bullish Color")
bearBaseColor = input.color(color.red, "Bearish Color")
neutralBaseColor = input.color(color.rgb(255, 105, 180), "Neutral / Box Color")

boxRange = input.float(20, "Box Strength Range (%)", minval=1, step=1)

// ───── MA Function
ma(_src, _len) =>
    maType == "EMA" ? ta.ema(_src, _len) : ta.sma(_src, _len)

// ───── Moving Averages
ma9 = ma(src, 9)
ma50 = ma(src, 50)
ma200 = ma(src, 200)

// ───── Scoring
score9 = close > ma9 ? 1 : close < ma9 ? -1 : 0
score50 = close > ma50 ? 1 : close < ma50 ? -1 : 0
score200 = close > ma200 ? 1 : close < ma200 ? -1 : 0

avgScore = (score9 + score50 + score200) / 3.0
strengthPercent = avgScore * 100.0

// ───── Painted Color Logic
intensity = int(math.min(math.abs(strengthPercent), 100))

bullColor = color.new(bullBaseColor, 100 - intensity)
bearColor = color.new(bearBaseColor, 100 - intensity)
neutralColor = color.new(neutralBaseColor, 50)

finalColor = avgScore > 0 ? bullColor : avgScore < 0 ? bearColor : neutralColor

// ───── BRUSHED PRICE LINE (SAFE & STABLE)

// Brush layer (wide + transparent → paint feel)
plot(close, title="Brush Layer", color=color.new(finalColor, 80), linewidth=8)

// Sharp core line (defines price clearly)
plot(close, title="Core Line", color=finalColor, linewidth=2)

// ───── BOX ZONE LOGIC

// Symmetric zone: [-boxRange, +boxRange]
inBoxZone = strengthPercent >= -boxRange and strengthPercent <= boxRange

var float zoneHigh = na
var float zoneLow = na
var int zoneStart = na

// Enter zone
if inBoxZone and not inBoxZone[1]
    zoneHigh := high
    zoneLow := low
    zoneStart := bar_index

// Update zone
if inBoxZone
    zoneHigh := math.max(zoneHigh, high)
    zoneLow := math.min(zoneLow, low)

// Exit zone → DRAW BOX (SINGLE LINE — SAFE)
if not inBoxZone and inBoxZone[1]
    box.new(zoneStart, zoneHigh, bar_index - 1, zoneLow, bgcolor=color.new(neutralBaseColor, 85), border_color=color.new(neutralBaseColor, 40))
    zoneHigh := na
    zoneLow := na
    zoneStart := na
