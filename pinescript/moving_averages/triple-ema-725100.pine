//@version=5
indicator("Triple EMA (7/25/100) - Bias Highlight", overlay=true)

// Inputs
lenFast = input.int(7,   "Fast EMA Length (7)", minval=1)
lenMid  = input.int(25,  "Mid EMA Length (25)", minval=1)
lenMain = input.int(100, "Main EMA Length (100)", minval=1)

src = input.source(close, "Source")

emaFast = ta.ema(src, lenFast)
emaMid  = ta.ema(src, lenMid)
emaMain = ta.ema(src, lenMain)

plot(emaFast, title="EMA 7",   color=color.new(color.yellow, 0), linewidth=1)
plot(emaMid,  title="EMA 25",  color=color.new(color.orange, 0), linewidth=1)
plot(emaMain, title="EMA 100 (Main Bias)", color=color.new(color.blue, 0), linewidth=3)
