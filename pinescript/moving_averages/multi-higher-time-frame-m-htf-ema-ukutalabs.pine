//@version=6
indicator("Multi-Higher Time Frame (M-HTF) EMA [UkutaLabs]", overlay=true, max_lines_count = 500, max_boxes_count=1000)
import UkutaLabs/Higher_Time_Frame/3 as htf
import UkutaLabs/UkutaLabs_General_library/8 as ulgl

//------------------------
//USER VARIABLES
//------------------------
int Period = input.int(defval=21, title="Period", group="Configuration")
string InputSource = input.string(defval="Close", title="Input Source", options=["Open","Close","High","Low"], group="Configuration")

bool Display5 = input.bool(defval=false, title="Display (On/Off)", group="5 Minute (Higher Timeframe)")
color EMAColor5 = input.color(defval=color.purple, title="Color", inline="EMA5", group="5 Minute (Higher Timeframe)")
string LineStyleEMA5 = input.string(defval="Solid", title="Line Style", inline="EMA5", options=["Dotted", "Dashed", "Solid"], group="5 Minute (Higher Timeframe)")
int LineWidthEMA5 = input(defval=1,title="Line Width", inline="EMA5", group="5 Minute (Higher Timeframe)")

bool Display15 = input.bool(defval=false, title="Display (15 Minute)", group="15 Minute (Higher Timeframe)")
color EMAColor15 = input.color(defval=color.purple, title="Color", inline="EMA15", group="15 Minute (Higher Timeframe)")
string LineStyleEMA15 = input.string(defval="Solid", title="Line Style", inline="EMA15", options=["Dotted", "Dashed", "Solid"], group="15 Minute (Higher Timeframe)")
int LineWidthEMA15 = input(defval=1,title="Line Width", inline="EMA15", group="15 Minute (Higher Timeframe)")

bool Display30 = input.bool(defval=false, title="Display (30 Minute)", group="30 Minute (Higher Timeframe)")
color EMAColor30 = input.color(defval=color.purple, title="Color", inline="EMA30", group="30 Minute (Higher Timeframe)")
string LineStyleEMA30 = input.string(defval="Solid", title="Line Style", inline="EMA30", options=["Dotted", "Dashed", "Solid"], group="30 Minute (Higher Timeframe)")
int LineWidthEMA30 = input(defval=1,title="Line Width", inline="EMA30", group="30 Minute (Higher Timeframe)")

bool Display60 = input.bool(defval=false, title="Display (60 Minute)", group="60 Minute (Higher Timeframe)")
color EMAColor60 = input.color(defval=color.purple, title="Color", inline="EMA60", group="60 Minute (Higher Timeframe)")
string LineStyleEMA60 = input.string(defval="Solid", title="Line Style", inline="EMA60", options=["Dotted", "Dashed", "Solid"], group="60 Minute (Higher Timeframe)")
int LineWidthEMA60 = input(defval=1,title="Line Width", inline="EMA60", group="60 Minute (Higher Timeframe)")

bool Display120 = input.bool(defval=false, title="Display (120 Minute)", group="120 Minute (Higher Timeframe)")
color EMAColor120 = input.color(defval=color.purple, title="Color", inline="EMA120", group="120 Minute (Higher Timeframe)")
string LineStyleEMA120 = input.string(defval="Solid", title="Line Style", inline="EMA120", options=["Dotted", "Dashed", "Solid"], group="120 Minute (Higher Timeframe)")
int LineWidthEMA120 = input(defval=1,title="Line Width", inline="EMA120", group="120 Minute (Higher Timeframe)")

bool Display240 = input.bool(defval=false, title="Display (240 Minute)", group="240 Minute (Higher Timeframe)")
color EMAColor240 = input.color(defval=color.purple, title="Color", inline="EMA240", group="240 Minute (Higher Timeframe)")
string LineStyleEMA240 = input.string(defval="Solid", title="Line Style", inline="EMA240", options=["Dotted", "Dashed", "Solid"], group="240 Minute (Higher Timeframe)")
int LineWidthEMA240 = input(defval=1,title="Line Width", inline="EMA240", group="240 Minute (Higher Timeframe)")

bool DisplayDaily = input.bool(defval=false, title="Display (Daily)", group="Daily (Higher Timeframe)")
color EMAColorDaily = input.color(defval=color.purple, title="Color", inline="EMArDaily", group="Daily (Higher Timeframe)")
string LineStyleEMADaily = input.string(defval="Solid", title="Line Style", inline="EMArDaily", options=["Dotted", "Dashed", "Solid"], group="Daily (Higher Timeframe)")
int LineWidthEMADaily = input(defval=1,title="Line Width", inline="EMArDaily", group="Daily (Higher Timeframe)")

//------------------------
//VARIABLES
//------------------------
var int tfp = timeframe.isintraday and not timeframe.isseconds ? int(str.tonumber(timeframe.period)) : 0
var int b = 0
var int b5 = 0
var int b15 = 0
var int b30 = 0
var int b60 = 0
var int b120 = 0
var int b240 = 0
var int b1380 = 0
var int s5 = 0
var int s15 = 0
var int s30 = 0
var int s60 = 0
var int s120 = 0
var int s240 = 0
var int s1380 = 0

var oCollection5 = array.new<htf.Candle> (0)
var oCollection15 = array.new<htf.Candle> (0)
var oCollection30 = array.new<htf.Candle> (0)
var oCollection60 = array.new<htf.Candle> (0)
var oCollection120 = array.new<htf.Candle> (0)
var oCollection240 = array.new<htf.Candle> (0)
var oCollectionDaily = array.new<htf.Candle> (0)

var oLines5 = array.new<line> (0)
var oLines15 = array.new<line> (0)
var oLines30 = array.new<line> (0)
var oLines60 = array.new<line> (0)
var oLines120 = array.new<line> (0)
var oLines240 = array.new<line> (0)
var oLinesDaily = array.new<line> (0)

//------------------------
//METHODS
//------------------------

TrackHTF(int BarsPerHigher, int BarCount, array<htf.Candle> oCollection, array<line> oLines, color EMAColor, int LineWidth, string LineStyle) =>
    var htf.Candle newCandle = na
    var htf.Candle oCurrentCandle = na
    var htf.Candle oPreviousCandle = na
    oCurrentCandle := oCollection.size() > 0 ? oCollection.get(oCollection.size()-1) : na
    oPreviousCandle := oCollection.size() > 1 ? oCollection.get(oCollection.size()-2) : na

    if na(oCurrentCandle)
        oCurrentCandle := htf.Candle.new()
        oCurrentCandle.UID := 1
        oCurrentCandle.OpenPrice := open[0]
        oCurrentCandle.HighPrice := high[0]
        oCurrentCandle.LowPrice := low[0]

        oCollection.push(oCurrentCandle)
      
    if BarCount%BarsPerHigher==0
        oCurrentCandle.ClosePrice := close[1] 
        oCurrentCandle.CloseIndex := bar_index[1]
        if not na(oPreviousCandle)
            oCurrentCandle.MAClose := htf.CalculateEMA(oCurrentCandle, Period, oCurrentCandle.ClosePrice, oPreviousCandle.MAClose)
            oCurrentCandle.MAOpen := htf.CalculateEMA(oCurrentCandle, Period, oCurrentCandle.OpenPrice, oPreviousCandle.MAOpen)
            oCurrentCandle.MAHigh := htf.CalculateEMA(oCurrentCandle, Period, oCurrentCandle.HighPrice, oPreviousCandle.MAHigh)
            oCurrentCandle.MALow := htf.CalculateEMA(oCurrentCandle, Period, oCurrentCandle.LowPrice, oPreviousCandle.MALow)

        if oLines.size() == 500
            oLines.get(0).delete()
            oLines.shift()

        if oLines.size() > 1
            oLines.get(oLines.size()-1).delete()
            oLines.shift()

        if InputSource == "Close" and oCurrentCandle.MAClose > 0
            oLines.push(line.new(x1 = oPreviousCandle.CloseIndex, y1 = oPreviousCandle.MAClose, x2 = oCurrentCandle.CloseIndex, y2 = oCurrentCandle.MAClose, color = EMAColor, style = ulgl.GetLineStyle(LineStyle), width=LineWidth))
        if InputSource == "Open" and oCurrentCandle.MAOpen > 0
            oLines.push(line.new(x1 = oPreviousCandle.CloseIndex, y1 = oPreviousCandle.MAOpen, x2 = oCurrentCandle.CloseIndex, y2 = oCurrentCandle.MAOpen, color = EMAColor, style = ulgl.GetLineStyle(LineStyle), width=LineWidth))
        if InputSource == "High" and oCurrentCandle.MAHigh > 0
            oLines.push(line.new(x1 = oPreviousCandle.CloseIndex, y1 = oPreviousCandle.MAHigh, x2 = oCurrentCandle.CloseIndex, y2 = oCurrentCandle.MAHigh, color = EMAColor, style = ulgl.GetLineStyle(LineStyle), width=LineWidth))
        if InputSource == "Low" and oCurrentCandle.MALow > 0
            oLines.push(line.new(x1 = oPreviousCandle.CloseIndex, y1 = oPreviousCandle.MALow, x2 = oCurrentCandle.CloseIndex, y2 = oCurrentCandle.MALow, color = EMAColor, style = ulgl.GetLineStyle(LineStyle), width=LineWidth))

        newCandle := htf.Candle.new(    
            UID = oCollection.size() > 0 ? oCurrentCandle.UID + 1 : 1,
            OpenPrice = open[0],
            OpenIndex = bar_index[0],
            HighPrice = high[0],
            HighIndex = bar_index[0],
            LowPrice = low[0],
            LowIndex = bar_index[0]
        )

        oCollection.push(newCandle)

        oLines.push(line.new(x1 = bar_index, y1 = 0, x2 = bar_index, y2 = 0, color = EMAColor, style = ulgl.GetLineStyle(LineStyle), width=LineWidth))

    if BarCount%BarsPerHigher!=0 and not na(oCurrentCandle)
        oCurrentCandle.HighIndex := high[1] > oCurrentCandle.HighPrice ? bar_index[1] : oCurrentCandle.HighIndex
        oCurrentCandle.HighPrice := high[1] > oCurrentCandle.HighPrice ? high[1] : oCurrentCandle.HighPrice
        oCurrentCandle.LowIndex := low[1] < oCurrentCandle.LowPrice ? bar_index[1] : oCurrentCandle.LowIndex
        oCurrentCandle.LowPrice := low[1] < oCurrentCandle.LowPrice ? low[1] : oCurrentCandle.LowPrice
        if not na(oPreviousCandle)
            oCurrentCandle.MAClose := htf.CalculateEMA(oCurrentCandle, Period, close[1], oPreviousCandle.MAClose)
            oCurrentCandle.MAOpen := htf.CalculateEMA(oCurrentCandle, Period, open[1], oPreviousCandle.MAOpen)
            oCurrentCandle.MAHigh := htf.CalculateEMA(oCurrentCandle, Period, high[1], oPreviousCandle.MAHigh)
            oCurrentCandle.MALow := htf.CalculateEMA(oCurrentCandle, Period, low[1], oPreviousCandle.MALow)
 
        if oLines.size() == 500
            oLines.get(0).delete()
            oLines.shift()

        if(oLines.size() > 2)
            line oLine = oLines.get(oLines.size()-1)

            oLine.set_x1(oPreviousCandle.CloseIndex)
            oLine.set_x2(bar_index)

            if InputSource == "Close" and oCurrentCandle.MAClose > 0
                oLine.set_y1(oPreviousCandle.MAClose)
                oLine.set_y2(oCurrentCandle.MAClose)
            if InputSource == "Open" and oCurrentCandle.MAOpen > 0
                oLine.set_y1(oPreviousCandle.MAOpen)
                oLine.set_y2(oCurrentCandle.MAOpen)
            if InputSource == "High" and oCurrentCandle.MAHigh > 0
                oLine.set_y1(oPreviousCandle.MAHigh)
                oLine.set_y2(oCurrentCandle.MAHigh)
            if InputSource == "Low" and oCurrentCandle.MALow > 0
                oLine.set_y1(oPreviousCandle.MALow)
                oLine.set_y2(oCurrentCandle.MALow)


//------------------------
//FUNCTION
//------------------------

if session.isfirstbar
    b := 0
    b5 := 0
    b15 := 0
    b30 := 0
    b60 := 0
    b120 := 0
    b240 := 0
    b1380 := 0
    s5 := 0
    s15 := 0
    s30 := 0
    s60 := 0
    s120 := 0
    s240 := 0
    s1380 := 0    


if Display5 
    b5 := session.isfirstbar ? 0 : b5+(time - time[1]) / 60000
    s5 := b5 > 5 ? b5-5 : 0
    b5 := b5 > 5 ? 5 : b5
    TrackHTF(5/tfp, b5, oCollection5, oLines5, EMAColor5, LineWidthEMA5, LineStyleEMA5)
    if b5%5 == 0
        b5 := 0
if Display15 
    b15 := session.isfirstbar ? 0 : b15+(time - time[1]) / 60000
    s15 := b15 > 15 ? b15-15 : 0
    b15 := b15 > 15 ? 15 : b15
    TrackHTF(15/tfp, b15, oCollection15, oLines15, EMAColor15, LineWidthEMA15, LineStyleEMA15)
    if b15%15 == 0
        b15 := s15
if Display30 
    b30 := session.isfirstbar ? 0 : b30+(time - time[1]) / 60000
    s30 := b30 > 30 ? b30-30 : 0
    b30 := b30 > 30 ? 30 : b30
    TrackHTF(30/tfp, b30, oCollection30, oLines30, EMAColor30, LineWidthEMA30, LineStyleEMA30)
    if b30%30 == 0
        b30 := s30
if Display60 
    b60 := session.isfirstbar ? 0 : b60+(time - time[1]) / 60000
    s60 := b60 > 60 ? b60-60 : 0
    b60 := b60 > 60 ? 60 : b60
    TrackHTF(60/tfp, b60, oCollection60, oLines60, EMAColor60, LineWidthEMA60, LineStyleEMA60)
    if b60%60 == 0
        b60 := s60
if Display120 
    b120 := session.isfirstbar ? 0 : b120+(time - time[1]) / 60000
    s120 := b120 > 120 ? b120-120 : 0
    b120 := b120 > 120 ? 120 : b120
    TrackHTF(120/tfp, b120, oCollection120, oLines120, EMAColor120, LineWidthEMA120, LineStyleEMA120)
    if b120%120 == 0
        b120 := s120
if Display240 
    b240 := session.isfirstbar ? 0 : b240+(time - time[1]) / 60000
    s240 := b240 > 240 ? b240-240 : 0
    b240 := b240 > 240 ? 240 : b240
    TrackHTF(240/tfp, b240, oCollection240, oLines240, EMAColor240, LineWidthEMA240, LineStyleEMA240)
    if b240%240 == 0
        b240 := s240
if DisplayDaily
    b1380 := session.isfirstbar ? 0 : b1380+(time - time[1]) / 60000
    s1380 := b1380 > 1380 ? b1380-1380 : 0
    b1380 := b1380 > 1380 ? 1380 : b1380
    TrackHTF(1380/tfp, b1380, oCollectionDaily, oLinesDaily, EMAColorDaily, LineWidthEMADaily, LineStyleEMADaily)
    if b1380%1380 == 0
        b1380 := s1380
