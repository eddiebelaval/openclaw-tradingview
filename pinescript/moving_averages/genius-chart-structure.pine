//@version=6
indicator("Genius Chart – PO / SPO (BG Hold + Separate Transp)", overlay=true)

//====================================================
// Inputs
//====================================================
showMAs  = input.bool(true, "Show MAs")
maWidth  = input.int(2, "MA Line Width", minval=1, maxval=5)

// --- Background ---
grpBg = "Background"
showBg    = input.bool(true, "Highlight PO / SPO", group=grpBg)

// ★透明度を分離
poTransp  = input.int(92, "PO transparency (0-100)",  minval=0, maxval=100, group=grpBg)
spoTransp = input.int(85, "SPO transparency (0-100)", minval=0, maxval=100, group=grpBg)

// ★背景色は「透明度なし」で入力（透明度は上の入力で管理）
poUpBgCol  = input.color(color.green,  "PO BG (Up)",   group=grpBg)
poDnBgCol  = input.color(color.red,    "PO BG (Down)", group=grpBg)
spoUpBgCol = input.color(color.teal,   "SPO BG (Up)",  group=grpBg)
spoDnBgCol = input.color(color.maroon, "SPO BG (Down)",group=grpBg)

//====================================================
// Stable MTF helpers
//====================================================
f_sec(tf, expr) =>
    request.security(syminfo.tickerid, tf, expr, barmerge.gaps_off, barmerge.lookahead_off)

// リアルタイム中は「1本前の確定値」を使って安定化（リペイント回避）
f_confirmed(x) =>
    barstate.isrealtime ? x[1] : x

f_sma_stable(tf, len) =>
    f_confirmed(f_sec(tf, ta.sma(close, len)))

//====================================================
// Fixed SMAs
//====================================================
ma_5m_10   = f_sma_stable("5",   10)
ma_15m_10  = f_sma_stable("15",  10)
ma_5m_75   = f_sma_stable("5",   75)
ma_1h_10   = f_sma_stable("60",  10)
ma_4h_10   = f_sma_stable("240", 10)

//====================================================
// Slope Direction HOLD（varで保持して更新）
//====================================================
sl_5m_10_raw   = ma_5m_10  - ma_5m_10[1]
sl_15m_10_raw  = ma_15m_10 - ma_15m_10[1]
sl_5m_75_raw   = ma_5m_75  - ma_5m_75[1]
sl_1h_10_raw   = ma_1h_10  - ma_1h_10[1]
sl_4h_10_raw   = ma_4h_10  - ma_4h_10[1]

// 方向を保持する変数（±1 or 0）
var int sl_5m_10_dir  = 0
var int sl_15m_10_dir = 0
var int sl_5m_75_dir  = 0
var int sl_1h_10_dir  = 0
var int sl_4h_10_dir  = 0

// 毎バー更新：rawが0なら前回方向を維持
sl_5m_10_dir  := sl_5m_10_raw  > 0 ? 1 : sl_5m_10_raw  < 0 ? -1 : sl_5m_10_dir[1]
sl_15m_10_dir := sl_15m_10_raw > 0 ? 1 : sl_15m_10_raw < 0 ? -1 : sl_15m_10_dir[1]
sl_5m_75_dir  := sl_5m_75_raw  > 0 ? 1 : sl_5m_75_raw  < 0 ? -1 : sl_5m_75_dir[1]
sl_1h_10_dir  := sl_1h_10_raw  > 0 ? 1 : sl_1h_10_raw  < 0 ? -1 : sl_1h_10_dir[1]
sl_4h_10_dir  := sl_4h_10_raw  > 0 ? 1 : sl_4h_10_raw  < 0 ? -1 : sl_4h_10_dir[1]

//====================================================
// PO condition (all directions same)
//====================================================
poUp =
     sl_5m_10_dir  == 1 and
     sl_15m_10_dir == 1 and
     sl_5m_75_dir  == 1 and
     sl_1h_10_dir  == 1 and
     sl_4h_10_dir  == 1

poDown =
     sl_5m_10_dir  == -1 and
     sl_15m_10_dir == -1 and
     sl_5m_75_dir  == -1 and
     sl_1h_10_dir  == -1 and
     sl_4h_10_dir  == -1

//====================================================
// SPO condition (PO + perfect order)
// Up: 5m10 > 15m10 > 5m75 > 1h10 > 4h10
// Down: opposite
//====================================================
ordUp =
     ma_5m_10  > ma_15m_10 and
     ma_15m_10 > ma_5m_75  and
     ma_5m_75  > ma_1h_10  and
     ma_1h_10  > ma_4h_10

ordDown =
     ma_5m_10  < ma_15m_10 and
     ma_15m_10 < ma_5m_75  and
     ma_5m_75  < ma_1h_10  and
     ma_1h_10  < ma_4h_10

spoUp   = poUp   and ordUp
spoDown = poDown and ordDown

//====================================================
// Background (state-based, 지속)
// Priority: SPO > PO
// 透明度：SPOはspoTransp、POはpoTransp
//====================================================
bgcolor(
    showBg ?
        spoUp   ? color.new(spoUpBgCol,  spoTransp) :
        spoDown ? color.new(spoDnBgCol,  spoTransp) :
        poUp    ? color.new(poUpBgCol,   poTransp)  :
        poDown  ? color.new(poDnBgCol,   poTransp)  :
        na
    : na
)

//====================================================
// MA plots
//====================================================
plot(showMAs ? ma_5m_10  : na, "5m 10SMA",  color=color.yellow, linewidth=maWidth)
plot(showMAs ? ma_15m_10 : na, "15m 10SMA", color=color.orange, linewidth=maWidth)
plot(showMAs ? ma_5m_75  : na, "5m 75SMA",  color=color.aqua,   linewidth=maWidth)
plot(showMAs ? ma_1h_10  : na, "1h 10SMA",  color=color.blue,   linewidth=maWidth)
plot(showMAs ? ma_4h_10  : na, "4h 10SMA",  color=color.purple, linewidth=maWidth)
