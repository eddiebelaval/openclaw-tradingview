//@version=6
indicator("zenba lab", shorttitle="zenba_lab", overlay=true)

// ── SETTINGS ────────────────────────────────────────────────────────────────
maType       = input.string("SMA",  "MA Type", options=["SMA", "EMA", "VWMA"], group="Reference MA")
maLen        = input.int(9,         "MA Length", minval=1, group="Reference MA")

useBands     = input.bool(false,   "Show directional StdDev band", group="Bands")
bandMult     = input.float(1.5,     "StdDev Multiplier", minval=0.1, step=0.1, group="Bands")
bandLen      = input.int(20,        "StdDev Lookback Length", minval=5, group="Bands")

rideMin      = input.int(7,         "Min streak bars to consider 'riding'", minval=3, group="Ride Logic")
lookback     = input.int(25,        "Cross count lookback", minval=10, group="Chop Logic")
crossThresh  = input.float(0.16,    "Crosses per bar threshold (chop)", minval=0.05, maxval=0.5, step=0.01, group="Chop Logic")

// ── Basic Zenba Wave toggle ─────────────────────────────────────────────────
showZenWave  = input.bool(false,    "Show Basic Zenba Wave (MA9 + MA108 + ribbon)", group="Zenba Wave Style")
zenRibbonTransp = input.int(82,     "Zenba Ribbon Transparency", minval=0, maxval=100, group="Zenba Wave Style")

// ── VISUAL TOGGLES ──────────────────────────────────────────────────────────
showBg       = input.bool(true,     "Show chop/ride background", group="Visuals")
showChars    = input.bool(true,     "Show ride/chop chars", group="Visuals")
charRide     = input.string("↑",    "Ride start char", group="Visuals")
charChop     = input.string("×",    "Chop start char", group="Visuals")

// ── REFERENCE MA (the main one users can change) ────────────────────────────
ma = switch maType
    "SMA"  => ta.sma(close, maLen)
    "EMA"  => ta.ema(close, maLen)
    "VWMA" => ta.vwma(close, maLen)
    => na

overMA = close > ma

// ── ZENBA WAVE MAs (fixed 9 & 108 SMA – classic style) ──────────────────────
ma9   = ta.sma(close, 9)
ma108 = ta.sma(close, 108)

bullWave = ma9 > ma108
bearWave = ma9 < ma108

zenRibbonColor = bullWave ? #00e6c2 : #ff00ff

// ── DIRECTIONAL STDDEV BAND ─────────────────────────────────────────────────
float dev = na
if useBands
    dev := ta.stdev(close, bandLen)

float activeBand = na
if useBands
    activeBand := overMA ? ma + bandMult * dev : ma - bandMult * dev

// ── STREAKS ─────────────────────────────────────────────────────────────────
var int upStreak = 0
upStreak := overMA ? nz(upStreak[1]) + 1 : 0

var int dnStreak = 0
dnStreak := not overMA ? nz(dnStreak[1]) + 1 : 0

currStreak = math.max(upStreak, dnStreak)

// ── CROSS COUNT ─────────────────────────────────────────────────────────────
crossed = ta.crossover(close, ma) or ta.crossunder(close, ma)
crossCt = math.sum(crossed ? 1.0 : 0.0, lookback)

// ── STATES ──────────────────────────────────────────────────────────────────
chopZone = crossCt > lookback * crossThresh or currStreak < rideMin
riding   = currStreak >= rideMin and not chopZone

// ── CHANGE DETECTION ────────────────────────────────────────────────────────
ridingFloat = riding  ? 1.0 : 0.0
chopFloat   = chopZone ? 1.0 : 0.0

rideStart   = ta.rising(ridingFloat, 1)
chopStart   = ta.rising(chopFloat, 1)

// ── VISUALS ─────────────────────────────────────────────────────────────────

// Zenba Wave ribbon (only when enabled)
p_ma9   = plot(showZenWave ? ma9   : na, "MA9",   color=color.new(#00e6c2, 0), linewidth=2)
p_ma108 = plot(showZenWave ? ma108 : na, "MA108", color=color.new(#ff00ff, 0), linewidth=2)

fill(p_ma9, p_ma108,
     top_color    = bullWave ? color.new(#00e6c2, 50) : color.new(#ff00ff, 50),
     bottom_color = bullWave ? color.new(#00e6c2, 90) : color.new(#ff00ff, 90),
     top_value    = ma9,
     bottom_value = ma108,
     title        = "Zenba Wave Ribbon Fade")

// Chop / Ride background
bgcolor(showBg and chopZone ? color.new(color.orange, 88)  : na, title="Chop Zone")
bgcolor(showBg and riding   ? color.new(color.teal,   92)   : na, title="Ride Zone")

// Ride / Chop markers
plotchar(showChars and rideStart, "Ride Start", charRide, location=location.belowbar, color=color.teal,   size=size.tiny)
plotchar(showChars and chopStart, "Chop Start", charChop, location=location.abovebar, color=color.orange, size=size.tiny)

// ── PLOTS ───────────────────────────────────────────────────────────────────
p_ma    = plot(ma,        "Reference MA",        color=color.new(color.yellow, 0), linewidth=2)
p_band  = plot(activeBand, "Directional Band",   color=color.new(color.yellow, 60), linewidth=1)

// Directional fill (between reference MA and band)
fill(p_ma, p_band, color=color.new(color.yellow, 92), title="Directional fill")

// ── ALERTS ──────────────────────────────────────────────────────────────────
alertcondition(rideStart,  title="Ride Started",  message="Ride detected on {{maLen}} {{maType}} - potential clean entry")
alertcondition(chopStart,  title="Chop Started",  message="Chop detected on {{maLen}} {{maType}} - avoid entries")
