//@version=5
indicator("MTF MSB/ChoCH - All Black Sidebar", overlay=true, max_labels_count=500)

// ==========================================
// --- INPUTS ---
// ==========================================
grp_ma = "Visual & Filter MA"
useMA      = input.bool(true, "Use MA Filter?", tooltip="Trend only flips if Price is on the correct side of the MA.")
showMA     = input.bool(true, "Show MA on Chart?")
maType     = input.string("EMA", "MA Type", options=["EMA", "SMA"])
maLength   = input.int(50, "MA Length", minval=1)
maColor    = input.color(color.new(#fbff00, 0), "MA Color")

grp_rsi = "RSI Settings (Current TF)"
rsiLength  = input.int(14, "RSI Length", minval=1)

grp_msb = "Structure Settings"
lookback  = input.int(3, "Swing Lookback", minval=1)

grp_tf = "Timeframe Selection"
tf1 = input.timeframe("240", "TF 1 (4H - 30%)", group=grp_tf)
tf2 = input.timeframe("120", "TF 2 (2H - 30%)", group=grp_tf)
tf3 = input.timeframe("60",  "TF 3 (1H - 20%)", group=grp_tf)
tf4 = input.timeframe("15",  "TF 4 (15M - 20%)", group=grp_tf)

grp_ui = "Visual Settings"
posInput    = input.string("Top Right", "Table Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group=grp_ui)
textSize    = input.string("Small", "Table Text Size", options=["Tiny", "Small", "Normal"], group=grp_ui)
bgHighlight = input.bool(true, "Highlight Background on 100% Sync?", group=grp_ui)

// ==========================================
// --- CALCULATIONS ---
// ==========================================
localMA = maType == "SMA" ? ta.sma(close, maLength) : ta.ema(close, maLength)
plot(showMA ? localMA : na, "Visual Filter MA", color=maColor, linewidth=2, force_overlay=true)

currentRSI = ta.rsi(close, rsiLength)

f_getTrend(lb, uMA, mType, mLen) =>
    var float lastHigh = high
    var float lastLow  = low
    var int trend = 0 
    hi = ta.highest(high, lb)
    lo = ta.lowest(low, lb)
    maVal = mType == "SMA" ? ta.sma(close, mLen) : ta.ema(close, mLen)
    if close > lastHigh and (not uMA or close > maVal)
        trend := 1
    else if close < lastLow and (not uMA or close < maVal)
        trend := -1
    if trend == 1
        lastHigh := hi
        lastLow  := lo
    else if trend == -1
        lastLow  := lo
        lastHigh := hi
    trend

f_size(s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : size.normal

// --- MTF DATA ---
s1 = request.security(syminfo.tickerid, tf1, f_getTrend(lookback, useMA, maType, maLength), barmerge.gaps_off, barmerge.lookahead_off)
s2 = request.security(syminfo.tickerid, tf2, f_getTrend(lookback, useMA, maType, maLength), barmerge.gaps_off, barmerge.lookahead_off)
s3 = request.security(syminfo.tickerid, tf3, f_getTrend(lookback, useMA, maType, maLength), barmerge.gaps_off, barmerge.lookahead_off)
s4 = request.security(syminfo.tickerid, tf4, f_getTrend(lookback, useMA, maType, maLength), barmerge.gaps_off, barmerge.lookahead_off)

bullSync = (s1 == 1 ? 30 : 0) + (s2 == 1 ? 30 : 0) + (s3 == 1 ? 20 : 0) + (s4 == 1 ? 20 : 0)
bearSync = (s1 == -1 ? 30 : 0) + (s2 == -1 ? 30 : 0) + (s3 == -1 ? 20 : 0) + (s4 == -1 ? 20 : 0)
weightedSyncPerc = math.max(bullSync, bearSync)
direction = bullSync >= bearSync ? "BULL" : "BEAR"

// ==========================================
// --- TABLE RENDERING ---
// ==========================================
bgcolor(bgHighlight and bullSync == 100 ? color.new(color.lime, 90) : bgHighlight and bearSync == 100 ? color.new(color.red, 90) : na)

tablePos = posInput == "Top Left" ? position.top_left : posInput == "Top Right" ? position.top_right : posInput == "Bottom Left" ? position.bottom_left : position.bottom_right

var table mtfTable = na
if barstate.islast
    table.delete(mtfTable)
    mtfTable := table.new(tablePos, 2, 7, frame_color=color.gray, frame_width=1, border_width=1, border_color=color.gray)
    
    // Rows Styling: All black backgrounds for the TF labels
    tfs   = array.from("4H (30%)", "2H (30%)", "1H (20%)", "15M (20%)")
    vals  = array.from(s1, s2, s3, s4)
    
    // Headers
    table.cell(mtfTable, 0, 0, "TF", bgcolor=color.black, text_color=color.white, text_size=f_size(textSize))
    table.cell(mtfTable, 1, 0, "Structure + MA", bgcolor=color.black, text_color=color.white, text_size=f_size(textSize))
    
    for i = 0 to 3
        v = array.get(vals, i)
        txt = v == 1 ? "BULLISH" : v == -1 ? "BEARISH" : "CHOP"
        bg  = v == 1 ? color.new(color.lime, 30) : v == -1 ? color.new(color.red, 30) : color.new(color.gray, 30)
        
        // TF Column (Left)
        table.cell(mtfTable, 0, i + 1, array.get(tfs, i), bgcolor=color.black, text_color=color.white, text_size=f_size(textSize))
        // Status Column (Right)
        table.cell(mtfTable, 1, i + 1, txt, bgcolor=bg, text_color=color.white, text_size=f_size(textSize))

    // RSI Row
    rsiBg = currentRSI > 50 ? color.new(color.lime, 30) : color.new(color.red, 30)
    table.cell(mtfTable, 0, 5, "RSI (" + timeframe.period + ")", bgcolor=color.black, text_color=color.white, text_size=f_size(textSize))
    table.cell(mtfTable, 1, 5, str.tostring(currentRSI, "#.##"), bgcolor=rsiBg, text_color=color.white, text_size=f_size(textSize))

    // Summary Footer
    finalFooterCol = weightedSyncPerc == 0 ? color.gray : direction == "BULL" ? #006400 : #FF0000 
    table.cell(mtfTable, 0, 6, "Weighted Sync", bgcolor=color.black, text_color=color.white, text_size=f_size(textSize))
    table.cell(mtfTable, 1, 6, str.tostring(weightedSyncPerc) + "% " + direction, bgcolor=finalFooterCol, text_color=color.white, text_size=f_size(textSize))
