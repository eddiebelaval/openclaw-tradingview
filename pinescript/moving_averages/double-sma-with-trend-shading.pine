//@version=5
indicator("Double SMA with Trend Shading", overlay=true, max_lines_count=500, max_labels_count=500)

// Inputs
fastLen     = input.int(20,  "Fast SMA Length", minval=1)
slowLen     = input.int(200, "Slow SMA Length", minval=1)
fastColor   = input.color(color.teal, "Fast SMA Color")
slowColor   = input.color(color.orange, "Slow SMA Color")
bullShade   = input.color(color.new(color.green, 85), "Bullish Shade")
bearShade   = input.color(color.new(color.red, 85), "Bearish Shade")

// SMA Calculations
fastSMA = ta.sma(close, fastLen)
slowSMA = ta.sma(close, slowLen)

// Plot VWMA
plotFast = plot(fastSMA, "Fast SMA", color=fastColor, display=display.all)
plotSlow = plot(slowSMA, "Slow SMA", color=slowColor, display=display.all)

// Determine shading condition
bull = fastSMA > slowSMA
bear = fastSMA < slowSMA

// Fill between SMA lines
fill(plotFast, plotSlow, color=bull ? bullShade : bear ? bearShade : na)

// Plot values in status line & price scale toggle
dispValues = input.bool(true, "Show Values on Status/Price Line")
plot(fastSMA, "Fast SMA Value", color=na, display= dispValues ? display.status_line + display.price_scale : display.none)
plot(slowSMA, "Slow SMA Value", color=na, display= dispValues ? display.status_line + display.price_scale : display.none)
