//@version=5
indicator("VW-MACD + GARCH Filter [Pointalgo]", "VW-MACD GARCH", overlay=false, format=format.price, precision=2)

// INPUTS

i_fast = input.int(12, "Fast VW-EMA", group="Volume-Weighted MACD")
i_slow = input.int(26, "Slow VW-EMA", group="Volume-Weighted MACD")
i_sig  = input.int(9,  "Signal Smoothing", group="Volume-Weighted MACD")


color col_macd   = #00E5FF // Neon Cyan
color col_sig    = #D500F9 // Deep Magenta
color col_hist_up_grow = #00E676 // Electric Lime
color col_hist_up_fade = color.new(#00E676, 60)
color col_hist_dn_grow = #FF1744 // Hot Neon Red
color col_hist_dn_fade = color.new(#FF1744, 60)


float vw_fast = ta.vwma(close, i_fast)
float vw_slow = ta.vwma(close, i_slow)

float vw_macd = vw_fast - vw_slow
float vw_signal = ta.ema(vw_macd, i_sig)

float vw_hist = vw_macd - vw_signal

float ret = math.log(close / nz(close[1], close))
float ret_sq = math.pow(ret, 2)
var float variance = 0.0

if bar_index < 50
    variance := ta.variance(ret, 20)
else
    float omega = (1.0 - 0.1 - 0.85) * ta.variance(ret, 100)
    variance := omega + (0.1 * ret_sq) + (0.85 * variance)

float garch_vol = math.sqrt(variance) * 100
bool vol_rising = garch_vol > ta.sma(garch_vol, 20)

color hist_color = vw_hist > 0 ? (vw_hist > nz(vw_hist[1]) ? col_hist_up_grow : col_hist_up_fade) : (vw_hist < nz(vw_hist[1]) ? col_hist_dn_grow : col_hist_dn_fade)

color cloud_col = vw_macd > vw_signal ? color.new(col_macd, 80) : color.new(col_sig, 80)

bool long_cond = ta.crossover(vw_macd, vw_signal) and vol_rising
bool short_cond = ta.crossunder(vw_macd, vw_signal) and vol_rising

hline(0, "Zero Line", color=color.new(color.gray, 50), linestyle=hline.style_dotted)

plot(vw_hist, "VW-MACD Histogram", color=hist_color, style=plot.style_columns)

p_macd = plot(vw_macd, "VW-MACD Line", color=col_macd, linewidth=2)
p_sig = plot(vw_signal, "Signal Line", color=col_sig, linewidth=2)

fill(p_macd, p_sig, color=cloud_col, title="Momentum Cloud")

plotshape(long_cond, "Long Signal", shape.circle, location.bottom, color=col_hist_up_grow, size=size.tiny)
plotshape(short_cond, "Short Signal", shape.circle, location.top, color=col_hist_dn_grow, size=size.tiny)

var table dashboard = table.new(position.bottom_right, 2, 2, border_width=1, border_color=color.new(color.gray, 80))

if barstate.islast
    table.cell(dashboard, 0, 0, "Pointalgo VW-MACD", text_color=color.white, bgcolor=color.black, text_size=size.small)
    table.cell(dashboard, 0, 1, "GARCH Volatility", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    
    if vol_rising
        table.cell(dashboard, 1, 1, "EXPANDING (Signals Armed)", text_color=color.black, bgcolor=col_macd, text_size=size.small)
    else
        table.cell(dashboard, 1, 1, "CONTRACTING (Filter Blocked)", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.small)
