//@version=6
indicator("Dynamic EMA + Smoothed HA + MTF Table + VWAP V11", shorttitle="Dyn_EMA_V11", overlay=true, max_bars_back=1000)

// ───── INPUTS ─────
lenHA1_input  = input.int(10, "1st HA Smoothing (10)",  minval=1, group="Smoothed Heikin-Ashi")
lenHA2_input  = input.int(10, "2nd HA Smoothing (10)",  minval=1, group="Smoothed Heikin-Ashi")
showHASignals = input.bool(true, "Show HA Buy/Sell Labels", group="Smoothed Heikin-Ashi")

ema50Length   = input.int(50,   "EMA 50 Length")
ema100Length  = input.int(100,  "EMA 100 Length")
ema200Length  = input.int(200,  "EMA 200 Length")
bbMult         = input.float(2.2, "StdDev Band Multiplier", step=0.1)
adxLen         = input.int(10,   "ADX Length (10)")
adxThresh      = input.float(15, "ADX Threshold (15)")
rsiLen         = input.int(14,   "RSI Length (MTF)")

vwapColor     = input.color(color.yellow, "VWAP Color", group="VWAP")

showTable     = input.bool(true, "Show MTF Trend Table")
tablePos      = input.string("Top Right", "MTF Table Position",
     options=["Top Left","Top Center","Top Right","Middle Left","Middle Center","Middle Right","Bottom Left","Bottom Center","Bottom Right"])
colorBars      = input.bool(true, "Color Bars by EMA Trend")

showHAValuesPanel = input.bool(true, "Show Movable HA Smoothing Values Panel", group="Smoothed Heikin-Ashi")
tablePosHA        = input.string("Bottom Right", "HA Panel Position",
     options=["Top Left","Top Center","Top Right","Middle Left","Middle Center","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Smoothed Heikin-Ashi")

// ───── AUTOMATIC HA LENGTHS ─────
var int correctHA1 = na
var int correctHA2 = na

if na(correctHA1)
    correctHA1 := timeframe.period == "5" or timeframe.period == "15" ? 6 :
                  timeframe.period == "30" or timeframe.period == "60" or timeframe.period == "120" or
                  timeframe.period == "240" or timeframe.period == "D" ? 12 :
                  timeframe.period == "W" ? 14 : 10

    correctHA2 := timeframe.period == "5" or timeframe.period == "15" ? 18 :
                  timeframe.period == "30" or timeframe.period == "60" or timeframe.period == "120" or
                  timeframe.period == "240" or timeframe.period == "D" ? 30 :
                  timeframe.period == "W" ? 42 : 35

lenHA1 = lenHA1_input == 10 ? correctHA1 : lenHA1_input
lenHA2 = lenHA2_input == 10 ? correctHA2 : lenHA2_input

// ───── DYNAMIC EMA LENGTHS ─────
fastLen = timeframe.period == "5" or timeframe.period == "15" ? 3 : timeframe.period == "W" ? 14 : 9
slowLen = timeframe.period == "5" or timeframe.period == "15" ? 8 : timeframe.period == "W" ? 26 : 20

// ───── CALCULATIONS ─────
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
ema50   = ta.ema(close, ema50Length)
ema100  = ta.ema(close, ema100Length)
ema200  = ta.ema(close, ema200Length)

dev    = bbMult * ta.stdev(close, slowLen)
upper  = emaSlow + dev
lower  = emaSlow - dev

[pdi, mdi, adx] = ta.dmi(adxLen, adxLen)

emaBuy  = ta.crossover(emaFast, emaSlow) and adx > adxThresh
emaSell = ta.crossunder(emaFast, emaSlow) and adx > adxThresh

// ───── VWAP (Fixed for Ratios) ─────
vwapDaily = request.security(syminfo.tickerid, timeframe.period, ta.vwap(hlc3))

// ───── DOUBLE-SMOOTHED HEIKIN-ASHI ─────
ema_custom(src, length) =>
    alpha = 2.0 / (length + 1.0)
    var float sum = na
    sum := na(sum[1]) ? ta.sma(src, length) : alpha * src + (1.0 - alpha) * sum[1]

o1 = ema_custom(open,  lenHA1)
h1 = ema_custom(high,  lenHA1)
l1 = ema_custom(low,   lenHA1)
c1 = ema_custom(close, lenHA1)

var float haOpen = na
haClose = (o1 + h1 + l1 + c1) / 4
haOpen := na(haOpen[1]) ? (o1 + c1) / 2 : (haOpen[1] + haClose[1]) / 2
haHigh = math.max(h1, math.max(haOpen, haClose))
haLow  = math.min(l1, math.min(haOpen, haClose))

o2 = ema_custom(haOpen, lenHA2)
h2 = ema_custom(haHigh, lenHA2)
l2 = ema_custom(haLow,  lenHA2)
c2 = ema_custom(haClose, lenHA2)

haBull = c2 >= o2
haBuy  = showHASignals and haBull and not haBull[1]
haSell = showHASignals and not haBull and haBull[1]

// ───── PLOTS ─────
pFast  = plot(emaFast, "Fast EMA", color.blue, 2)
pSlow  = plot(emaSlow, "Slow EMA", color.orange, 2)
fill(pFast, pSlow, color = emaFast > emaSlow ? color.new(color.blue, 20) : color.new(color.orange, 20))

pUpper = plot(upper, "Upper Band", color.blue)
pLower = plot(lower, "Lower Band", color.blue)
fill(pUpper, pLower, color.new(color.blue, 90))

plot(ema50,  "EMA 50",  color.purple, 2)
plot(ema100, "EMA 100", color.red,    2)
plot(ema200, "EMA 200", color.green,  2)

plot(vwapDaily, "Daily VWAP", color=vwapColor, linewidth=2)

plotcandle(o2, h2, l2, c2,
     color       = haBull ? color.lime : color.red,
     wickcolor   = haBull ? color.lime : color.red,
     bordercolor = color.black)

// ───── SIGNALS ─────
plotshape(haBuy,  title="HA Buy",  location=location.belowbar, color=color.lime,  style=shape.labelup,   size=size.tiny, text="BUY",  textcolor=color.black)
plotshape(haSell, title="HA Sell", location=location.abovebar, color=color.red,   style=shape.labeldown, size=size.tiny, text="SELL", textcolor=color.white)

plotshape(emaBuy,  title="EMA Buy",  location=location.belowbar, color=color.new(color.green,0), style=shape.labelup,   text="BUY",  size=size.small, textcolor=color.white)
plotshape(emaSell, title="EMA Sell", location=location.abovebar, color=color.new(color.red,0),   style=shape.labeldown, text="SELL", size=size.small, textcolor=color.white)

barcolor(colorBars ? (emaFast > emaSlow ? color.green : color.red) : na)

// EMA label
var label lbl = na
if barstate.islast
    label.delete(lbl)
    lbl := label.new(bar_index, high,
         "EMA " + str.tostring(fastLen) + "/" + str.tostring(slowLen),
         style=label.style_label_left, color=color.new(color.silver, 50), textcolor=color.black, yloc=yloc.abovebar)

// ───── MTF RSI-50 & PERCENT CHANGE TABLE ─────
rsiValue(res) =>
    request.security(syminfo.tickerid, res, (ta.rsi(close, rsiLen) - 50), lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)

pcntValue(res) =>
    request.security(syminfo.tickerid, res, (close - close[1]) / close[1] * 100, lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)

trend1m   = rsiValue("1")
trend5m   = rsiValue("5")
trend15m  = rsiValue("15")
trend1h   = rsiValue("60")
trend2h   = rsiValue("120")
trend4h   = rsiValue("240")
trendD    = rsiValue("D")
trendW    = rsiValue("W")

pcnt1m    = pcntValue("1")
pcnt5m    = pcntValue("5")
pcnt15m   = pcntValue("15")
pcnt1h    = pcntValue("60")
pcnt2h    = pcntValue("120")
pcnt4h    = pcntValue("240")
pcntD     = pcntValue("D")
pcntW     = pcntValue("W")

var table t = na
if showTable and barstate.islast
    if not na(t)
        table.delete(t)

    pos = switch tablePos
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right"  => position.bottom_right

    t := table.new(pos, 4, 10, bgcolor=color.black, border_width=1)

    table.cell(t, 0, 0, "Timeframe", bgcolor=color.silver, text_color=color.black)
    table.cell(t, 1, 0, "Trend",     bgcolor=color.silver, text_color=color.black)
    table.cell(t, 2, 0, "Value",     bgcolor=color.silver, text_color=color.black)
    table.cell(t, 3, 0, "Chg %",     bgcolor=color.silver, text_color=color.black)

    tfs   = array.from("1m","5m","15m","1h","2h","4h","D","W")
    vals  = array.from(trend1m, trend5m, trend15m, trend1h, trend2h, trend4h, trendD, trendW)
    pcnts = array.from(pcnt1m, pcnt5m, pcnt15m, pcnt1h, pcnt2h, pcnt4h, pcntD, pcntW)

    total = 0.0
    for i = 0 to 7
        val = array.get(vals, i)
        pct = array.get(pcnts, i)
        total += val
        table.cell(t, 0, i+1, array.get(tfs, i), bgcolor=#D9D9D9, text_color=color.black)
        table.cell(t, 1, i+1, val > 0 ? "Bullish" : "Bearish",
             bgcolor = val > 0 ? #00ff00 : #ff0000, text_color=color.white)
        table.cell(t, 2, i+1, str.tostring(val, "0.0"), bgcolor=#D9D9D9, text_color=color.black)
        table.cell(t, 3, i+1, str.tostring(pct, "0.00") + "%", bgcolor=#D9D9D9, text_color = pct >= 0 ? color.teal : color.maroon)

    avg = total / 8
    table.cell(t, 0, 9, "Combined", bgcolor=color.silver, text_color=color.black)
    table.cell(t, 1, 9, avg > 0 ? "Bullish" : "Bearish",
         bgcolor = avg > 0 ? #00ff00 : #ff0000, text_color=color.white)
    table.cell(t, 2, 9, str.tostring(avg, "0.0"), bgcolor=color.silver, text_color=color.black)
    table.cell(t, 3, 9, "", bgcolor=color.silver)

// ───── MOVABLE HA SMOOTHING VALUES PANEL ─────
var table haPanel = na

if showHAValuesPanel and barstate.islast
    if not na(haPanel)
        table.delete(haPanel)

    haPos = switch tablePosHA
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right"  => position.bottom_right
        
    haPanel := table.new(haPos, 2, 2, bgcolor=color.new(color.black, 20), border_width=1)
    table.cell(haPanel, 0, 0, "HA Smooth 1", text_color=color.white)
    table.cell(haPanel, 1, 0, str.tostring(lenHA1), text_color=color.white)
    table.cell(haPanel, 0, 1, "HA Smooth 2", text_color=color.white)
    table.cell(haPanel, 1, 1, str.tostring(lenHA2), text_color=color.white)
