//@version=6
indicator("Short Trade Assistant V2",
     overlay          = true,
     max_lines_count  = 100,
     max_boxes_count  = 50,
     max_labels_count = 50)

// ─────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────

ema_fast      = input.int(9,      title = "EMA Fast",           group = "EMA")
ema_slow      = input.int(21,     title = "EMA Slow",           group = "EMA")
htf1          = input.timeframe("240", title = "4H Timeframe",  group = "Timeframes")
htf2          = input.timeframe("60",  title = "1H Timeframe",  group = "Timeframes")
swing_len     = input.int(5,      title = "Swing Lookback",     group = "Zones")
zone_extend   = input.bool(true,  title = "Extend Zones",       group = "Zones")
show_4h_zones = input.bool(true,  title = "Show 4H Zones",      group = "Zones")
show_1h_zones = input.bool(true,  title = "Show 1H Zones",      group = "Zones")
show_ltf_zones= input.bool(true,  title = "Show LTF Zones",     group = "Zones")
atr_len       = input.int(14,     title = "ATR Length",         group = "Levels")
sl_atr        = input.float(1.5,  title = "Stop ATR Mult",      group = "Levels")
e2_atr        = input.float(0.5,  title = "E2 ATR Offset",      group = "Levels")
e3_atr        = input.float(1.0,  title = "E3 ATR Offset",      group = "Levels")
tp1_r         = input.float(1.0,  title = "TP1 RR",             group = "Levels")
tp2_r         = input.float(2.0,  title = "TP2 RR",             group = "Levels")
tp3_r         = input.float(3.0,  title = "TP3 RR",             group = "Levels")
show_ema      = input.bool(true,  title = "Show EMAs",          group = "Display")
show_signal   = input.bool(true,  title = "Show Signals",       group = "Display")
show_table    = input.bool(true,  title = "Show Dashboard",     group = "Display")
show_levels   = input.bool(true,  title = "Show Trade Levels",  group = "Display")
show_fibs     = input.bool(true,  title = "Show Fibonacci",     group = "Display")

// ─────────────────────────────────────────
// CORE CALCULATIONS
// ─────────────────────────────────────────

ema9_ltf  = ta.ema(close, ema_fast)
ema21_ltf = ta.ema(close, ema_slow)
atr       = ta.atr(atr_len)

// ─────────────────────────────────────────
// MULTI TIMEFRAME DATA
// ─────────────────────────────────────────

ema9_4h  = request.security(syminfo.tickerid, htf1,
                ta.ema(close, ema_fast),
                lookahead = barmerge.lookahead_off)
ema21_4h = request.security(syminfo.tickerid, htf1,
                ta.ema(close, ema_slow),
                lookahead = barmerge.lookahead_off)
close_4h = request.security(syminfo.tickerid, htf1,
                close,
                lookahead = barmerge.lookahead_off)

ema9_1h  = request.security(syminfo.tickerid, htf2,
                ta.ema(close, ema_fast),
                lookahead = barmerge.lookahead_off)
ema21_1h = request.security(syminfo.tickerid, htf2,
                ta.ema(close, ema_slow),
                lookahead = barmerge.lookahead_off)
close_1h = request.security(syminfo.tickerid, htf2,
                close,
                lookahead = barmerge.lookahead_off)

high_4h  = request.security(syminfo.tickerid, htf1,
                ta.pivothigh(high, swing_len, swing_len),
                lookahead = barmerge.lookahead_off)
low_4h   = request.security(syminfo.tickerid, htf1,
                ta.pivotlow(low, swing_len, swing_len),
                lookahead = barmerge.lookahead_off)
high_1h  = request.security(syminfo.tickerid, htf2,
                ta.pivothigh(high, swing_len, swing_len),
                lookahead = barmerge.lookahead_off)
low_1h   = request.security(syminfo.tickerid, htf2,
                ta.pivotlow(low, swing_len, swing_len),
                lookahead = barmerge.lookahead_off)

// ─────────────────────────────────────────
// TREND CONDITIONS
// ─────────────────────────────────────────

bear_4h   = ema9_4h  < ema21_4h  and close_4h < ema21_4h
bear_1h   = ema9_1h  < ema21_1h  and close_1h < ema21_1h
bear_ltf  = ema9_ltf < ema21_ltf and close     < ema21_ltf
htf_bear  = bear_4h  and bear_1h
full_bear = htf_bear and bear_ltf

slope_4h  = ema21_4h < ema21_4h[3]
slope_1h  = ema21_1h < ema21_1h[3]

// ─────────────────────────────────────────
// SWING POINTS
// ─────────────────────────────────────────

ph_ltf = ta.pivothigh(high, swing_len, swing_len)
pl_ltf = ta.pivotlow(low,   swing_len, swing_len)

var float ph1_ltf = na
var float ph2_ltf = na
var float pl1_ltf = na
var float pl2_ltf = na

if not na(ph_ltf)
    ph2_ltf := ph1_ltf
    ph1_ltf := ph_ltf

if not na(pl_ltf)
    pl2_ltf := pl1_ltf
    pl1_ltf := pl_ltf

var float ph1_4h = na
var float ph2_4h = na
var float pl1_4h = na
var float pl2_4h = na

if not na(high_4h)
    ph2_4h := ph1_4h
    ph1_4h := high_4h

if not na(low_4h)
    pl2_4h := pl1_4h
    pl1_4h := low_4h

var float ph1_1h = na
var float ph2_1h = na
var float pl1_1h = na
var float pl2_1h = na

if not na(high_1h)
    ph2_1h := ph1_1h
    ph1_1h := high_1h

if not na(low_1h)
    pl2_1h := pl1_1h
    pl1_1h := low_1h

// ─────────────────────────────────────────
// STRUCTURE
// ─────────────────────────────────────────

lh_4h  = not na(ph1_4h)  and not na(ph2_4h)  and ph1_4h  < ph2_4h
ll_4h  = not na(pl1_4h)  and not na(pl2_4h)  and pl1_4h  < pl2_4h
lh_ltf = not na(ph1_ltf) and not na(ph2_ltf) and ph1_ltf < ph2_ltf
ll_ltf = not na(pl1_ltf) and not na(pl2_ltf) and pl1_ltf < pl2_ltf

bear_str_4h  = lh_4h  and ll_4h
bear_str_ltf = lh_ltf and ll_ltf

// ─────────────────────────────────────────
// ENTRY SIGNAL
// ─────────────────────────────────────────

ltf_bearish  = close  < open
ltf_reject   = high  >= ema9_ltf and close < ema9_ltf
entry_signal = htf_bear and bear_ltf and ltf_bearish and ltf_reject

// ─────────────────────────────────────────
// TRADE LEVELS - DYNAMIC
// Always calculated from CURRENT bar
// Only shown when conditions align
// This fixes the far entry problem
// ─────────────────────────────────────────

e1_now  = close
e2_now  = close  - (atr * e2_atr)
e3_now  = close  - (atr * e3_atr)
sl_now  = high   + (atr * sl_atr)
rk_now  = sl_now - e1_now
tp1_now = e1_now - (rk_now * tp1_r)
tp2_now = e1_now - (rk_now * tp2_r)
tp3_now = e1_now - (rk_now * tp3_r)

// ─────────────────────────────────────────
// ZONE DRAWING FUNCTION
// ext_type controls extend direction
// ─────────────────────────────────────────

ext_type = zone_extend ? extend.right : extend.none

// ─────────────────────────────────────────
// 4H ZONES
// ─────────────────────────────────────────

var line r4h_l1 = na
var line r4h_l2 = na
var line s4h_l1 = na
var line s4h_l2 = na
var box  r4h_b  = na
var box  s4h_b  = na

if show_4h_zones and not na(high_4h)
    if not na(r4h_l1)
        line.delete(r4h_l1)
    r4h_l1 := line.new(
         x1     = bar_index,
         y1     = ph1_4h,
         x2     = bar_index + 1,
         y2     = ph1_4h,
         color  = color.new(color.red, 60),
         width  = 1,
         style  = line.style_dotted,
         extend = ext_type)

    if not na(ph2_4h)
        if not na(r4h_l2)
            line.delete(r4h_l2)
        r4h_l2 := line.new(
             x1     = bar_index,
             y1     = ph2_4h,
             x2     = bar_index + 1,
             y2     = ph2_4h,
             color  = color.new(color.red, 70),
             width  = 1,
             style  = line.style_dotted,
             extend = ext_type)
        if not na(r4h_b)
            box.delete(r4h_b)
        r4h_b := box.new(
             left         = bar_index - 2,
             top          = math.max(ph1_4h, ph2_4h),
             right        = bar_index,
             bottom       = math.min(ph1_4h, ph2_4h),
             border_color = color.new(color.red, 60),
             bgcolor      = color.new(color.red, 88),
             border_width = 1,
             extend       = ext_type)

if show_4h_zones and not na(low_4h)
    if not na(s4h_l1)
        line.delete(s4h_l1)
    s4h_l1 := line.new(
         x1     = bar_index,
         y1     = pl1_4h,
         x2     = bar_index + 1,
         y2     = pl1_4h,
         color  = color.new(color.green, 60),
         width  = 1,
         style  = line.style_dotted,
         extend = ext_type)

    if not na(pl2_4h)
        if not na(s4h_l2)
            line.delete(s4h_l2)
        s4h_l2 := line.new(
             x1     = bar_index,
             y1     = pl2_4h,
             x2     = bar_index + 1,
             y2     = pl2_4h,
             color  = color.new(color.green, 70),
             width  = 1,
             style  = line.style_dotted,
             extend = ext_type)
        if not na(s4h_b)
            box.delete(s4h_b)
        s4h_b := box.new(
             left         = bar_index - 2,
             top          = math.max(pl1_4h, pl2_4h),
             right        = bar_index,
             bottom       = math.min(pl1_4h, pl2_4h),
             border_color = color.new(color.green, 60),
             bgcolor      = color.new(color.green, 88),
             border_width = 1,
             extend       = ext_type)

// ─────────────────────────────────────────
// 1H ZONES
// ─────────────────────────────────────────

var line r1h_l1 = na
var line r1h_l2 = na
var line s1h_l1 = na
var line s1h_l2 = na
var box  r1h_b  = na
var box  s1h_b  = na

if show_1h_zones and not na(high_1h)
    if not na(r1h_l1)
        line.delete(r1h_l1)
    r1h_l1 := line.new(
         x1     = bar_index,
         y1     = ph1_1h,
         x2     = bar_index + 1,
         y2     = ph1_1h,
         color  = color.new(color.red, 30),
         width  = 2,
         style  = line.style_dashed,
         extend = ext_type)

    if not na(ph2_1h)
        if not na(r1h_l2)
            line.delete(r1h_l2)
        r1h_l2 := line.new(
             x1     = bar_index,
             y1     = ph2_1h,
             x2     = bar_index + 1,
             y2     = ph2_1h,
             color  = color.new(color.red, 50),
             width  = 1,
             style  = line.style_dashed,
             extend = ext_type)
        if not na(r1h_b)
            box.delete(r1h_b)
        r1h_b := box.new(
             left         = bar_index - 2,
             top          = math.max(ph1_1h, ph2_1h),
             right        = bar_index,
             bottom       = math.min(ph1_1h, ph2_1h),
             border_color = color.new(color.red, 30),
             bgcolor      = color.new(color.red, 82),
             border_width = 1,
             extend       = ext_type)

if show_1h_zones and not na(low_1h)
    if not na(s1h_l1)
        line.delete(s1h_l1)
    s1h_l1 := line.new(
         x1     = bar_index,
         y1     = pl1_1h,
         x2     = bar_index + 1,
         y2     = pl1_1h,
         color  = color.new(color.green, 30),
         width  = 2,
         style  = line.style_dashed,
         extend = ext_type)

    if not na(pl2_1h)
        if not na(s1h_l2)
            line.delete(s1h_l2)
        s1h_l2 := line.new(
             x1     = bar_index,
             y1     = pl2_1h,
             x2     = bar_index + 1,
             y2     = pl2_1h,
             color  = color.new(color.green, 50),
             width  = 1,
             style  = line.style_dashed,
             extend = ext_type)
        if not na(s1h_b)
            box.delete(s1h_b)
        s1h_b := box.new(
             left         = bar_index - 2,
             top          = math.max(pl1_1h, pl2_1h),
             right        = bar_index,
             bottom       = math.min(pl1_1h, pl2_1h),
             border_color = color.new(color.green, 30),
             bgcolor      = color.new(color.green, 82),
             border_width = 1,
             extend       = ext_type)

// ─────────────────────────────────────────
// LTF ZONES
// ─────────────────────────────────────────

var line rltf_l1 = na
var line rltf_l2 = na
var line sltf_l1 = na
var line sltf_l2 = na
var box  rltf_b  = na
var box  sltf_b  = na

if show_ltf_zones and not na(ph_ltf)
    if not na(rltf_l1)
        line.delete(rltf_l1)
    rltf_l1 := line.new(
         x1     = bar_index - swing_len,
         y1     = ph1_ltf,
         x2     = bar_index,
         y2     = ph1_ltf,
         color  = color.new(color.red, 0),
         width  = 2,
         style  = line.style_solid,
         extend = ext_type)

    if not na(ph2_ltf)
        if not na(rltf_l2)
            line.delete(rltf_l2)
        rltf_l2 := line.new(
             x1     = bar_index - swing_len,
             y1     = ph2_ltf,
             x2     = bar_index,
             y2     = ph2_ltf,
             color  = color.new(color.red, 20),
             width  = 1,
             style  = line.style_solid,
             extend = ext_type)
        if not na(rltf_b)
            box.delete(rltf_b)
        rltf_b := box.new(
             left         = bar_index - swing_len,
             top          = math.max(ph1_ltf, ph2_ltf),
             right        = bar_index,
             bottom       = math.min(ph1_ltf, ph2_ltf),
             border_color = color.new(color.red, 10),
             bgcolor      = color.new(color.red, 75),
             border_width = 2,
             extend       = ext_type)

if show_ltf_zones and not na(pl_ltf)
    if not na(sltf_l1)
        line.delete(sltf_l1)
    sltf_l1 := line.new(
         x1     = bar_index - swing_len,
         y1     = pl1_ltf,
         x2     = bar_index,
         y2     = pl1_ltf,
         color  = color.new(color.green, 0),
         width  = 2,
         style  = line.style_solid,
         extend = ext_type)

    if not na(pl2_ltf)
        if not na(sltf_l2)
            line.delete(sltf_l2)
        sltf_l2 := line.new(
             x1     = bar_index - swing_len,
             y1     = pl2_ltf,
             x2     = bar_index,
             y2     = pl2_ltf,
             color  = color.new(color.green, 20),
             width  = 1,
             style  = line.style_solid,
             extend = ext_type)
        if not na(sltf_b)
            box.delete(sltf_b)
        sltf_b := box.new(
             left         = bar_index - swing_len,
             top          = math.max(pl1_ltf, pl2_ltf),
             right        = bar_index,
             bottom       = math.min(pl1_ltf, pl2_ltf),
             border_color = color.new(color.green, 10),
             bgcolor      = color.new(color.green, 75),
             border_width = 2,
             extend       = ext_type)

// ─────────────────────────────────────────
// FIBONACCI - ALWAYS ON LAST SWING
// ─────────────────────────────────────────

var line fib_0   = na
var line fib_236 = na
var line fib_382 = na
var line fib_500 = na
var line fib_618 = na
var line fib_100 = na
var label lbl_0   = na
var label lbl_236 = na
var label lbl_382 = na
var label lbl_500 = na
var label lbl_618 = na
var label lbl_100 = na

if show_fibs and not na(ph1_ltf) and not na(pl1_ltf)
    fib_rng = ph1_ltf - pl1_ltf
    f0      = ph1_ltf
    f236    = ph1_ltf - fib_rng * 0.236
    f382    = ph1_ltf - fib_rng * 0.382
    f500    = ph1_ltf - fib_rng * 0.500
    f618    = ph1_ltf - fib_rng * 0.618
    f100    = pl1_ltf

    line.delete(fib_0)
    line.delete(fib_236)
    line.delete(fib_382)
    line.delete(fib_500)
    line.delete(fib_618)
    line.delete(fib_100)
    label.delete(lbl_0)
    label.delete(lbl_236)
    label.delete(lbl_382)
    label.delete(lbl_500)
    label.delete(lbl_618)
    label.delete(lbl_100)

    fib_0   := line.new(bar_index, f0,   bar_index + 15, f0,
         color = color.new(color.white, 50),  style = line.style_dotted)
    fib_236 := line.new(bar_index, f236, bar_index + 15, f236,
         color = color.new(color.yellow, 40), style = line.style_dotted)
    fib_382 := line.new(bar_index, f382, bar_index + 15, f382,
         color = color.new(color.orange, 10), style = line.style_dotted, width = 2)
    fib_500 := line.new(bar_index, f500, bar_index + 15, f500,
         color = color.new(color.orange, 10), style = line.style_dotted, width = 2)
    fib_618 := line.new(bar_index, f618, bar_index + 15, f618,
         color = color.new(color.orange, 10), style = line.style_dotted, width = 2)
    fib_100 := line.new(bar_index, f100, bar_index + 15, f100,
         color = color.new(color.white, 50),  style = line.style_dotted)

    lbl_0   := label.new(bar_index + 16, f0,
         "0.000",    color = color.new(color.black, 100),
         textcolor  = color.white,  size = size.small)
    lbl_236 := label.new(bar_index + 16, f236,
         "0.236",    color = color.new(color.black, 100),
         textcolor  = color.yellow, size = size.small)
    lbl_382 := label.new(bar_index + 16, f382,
         "0.382 E1", color = color.new(color.black, 100),
         textcolor  = color.orange, size = size.small)
    lbl_500 := label.new(bar_index + 16, f500,
         "0.500 E2", color = color.new(color.black, 100),
         textcolor  = color.orange, size = size.small)
    lbl_618 := label.new(bar_index + 16, f618,
         "0.618 E3", color = color.new(color.black, 100),
         textcolor  = color.orange, size = size.small)
    lbl_100 := label.new(bar_index + 16, f100,
         "1.000",    color = color.new(color.black, 100),
         textcolor  = color.white,  size = size.small)

// ─────────────────────────────────────────
// TRADE LEVELS DISPLAY
// KEY FIX - levels now use current bar price
// They show live near current candle always
// ─────────────────────────────────────────

var line lv_sl  = na
var line lv_e1  = na
var line lv_e2  = na
var line lv_e3  = na
var line lv_tp1 = na
var line lv_tp2 = na
var line lv_tp3 = na
var label lb_sl  = na
var label lb_e1  = na
var label lb_e2  = na
var label lb_e3  = na
var label lb_tp1 = na
var label lb_tp2 = na
var label lb_tp3 = na

// Show levels whenever HTF is bearish
// Not just on signal - so you always see
// what levels would look like right now
if show_levels and htf_bear and barstate.islast
    line.delete(lv_sl)
    line.delete(lv_e1)
    line.delete(lv_e2)
    line.delete(lv_e3)
    line.delete(lv_tp1)
    line.delete(lv_tp2)
    line.delete(lv_tp3)
    label.delete(lb_sl)
    label.delete(lb_e1)
    label.delete(lb_e2)
    label.delete(lb_e3)
    label.delete(lb_tp1)
    label.delete(lb_tp2)
    label.delete(lb_tp3)

    lv_sl  := line.new(bar_index, sl_now,  bar_index + 20, sl_now,
         color = color.red,    width = 2,
         style = line.style_solid,  extend = extend.right)
    lv_e1  := line.new(bar_index, e1_now,  bar_index + 20, e1_now,
         color = color.orange, width = 1,
         style = line.style_dashed, extend = extend.right)
    lv_e2  := line.new(bar_index, e2_now,  bar_index + 20, e2_now,
         color = color.orange, width = 1,
         style = line.style_dashed, extend = extend.right)
    lv_e3  := line.new(bar_index, e3_now,  bar_index + 20, e3_now,
         color = color.orange, width = 2,
         style = line.style_dashed, extend = extend.right)
    lv_tp1 := line.new(bar_index, tp1_now, bar_index + 20, tp1_now,
         color = color.yellow, width = 1,
         style = line.style_dashed, extend = extend.right)
    lv_tp2 := line.new(bar_index, tp2_now, bar_index + 20, tp2_now,
         color = color.aqua,   width = 1,
         style = line.style_dashed, extend = extend.right)
    lv_tp3 := line.new(bar_index, tp3_now, bar_index + 20, tp3_now,
         color = color.purple, width = 1,
         style = line.style_dashed, extend = extend.right)

    lb_sl  := label.new(bar_index + 1, sl_now,
         "INVALIDATION " + str.tostring(math.round(sl_now,  4)),
         color = color.new(color.red,    20),
         textcolor = color.white, size = size.small,
         style = label.style_label_left)
    lb_e1  := label.new(bar_index + 1, e1_now,
         "E1 25% " + str.tostring(math.round(e1_now,  4)),
         color = color.new(color.orange, 20),
         textcolor = color.white, size = size.small,
         style = label.style_label_left)
    lb_e2  := label.new(bar_index + 1, e2_now,
         "E2 25% " + str.tostring(math.round(e2_now,  4)),
         color = color.new(color.orange, 20),
         textcolor = color.white, size = size.small,
         style = label.style_label_left)
    lb_e3  := label.new(bar_index + 1, e3_now,
         "E3 50% " + str.tostring(math.round(e3_now,  4)),
         color = color.new(color.orange, 20),
         textcolor = color.white, size = size.small,
         style = label.style_label_left)
    lb_tp1 := label.new(bar_index + 1, tp1_now,
         "TP1 " + str.tostring(math.round(tp1_now, 4)),
         color = color.new(color.yellow, 20),
         textcolor = color.black, size = size.small,
         style = label.style_label_left)
    lb_tp2 := label.new(bar_index + 1, tp2_now,
         "TP2 " + str.tostring(math.round(tp2_now, 4)),
         color = color.new(color.aqua,   20),
         textcolor = color.black, size = size.small,
         style = label.style_label_left)
    lb_tp3 := label.new(bar_index + 1, tp3_now,
         "TP3 " + str.tostring(math.round(tp3_now, 4)),
         color = color.new(color.purple, 20),
         textcolor = color.white, size = size.small,
         style = label.style_label_left)

// ─────────────────────────────────────────
// EMA PLOTS
// ─────────────────────────────────────────

plot(show_ema ? ema9_ltf  : na,
     color     = color.new(color.orange, 0),
     linewidth = 1,
     title     = "EMA 9")

plot(show_ema ? ema21_ltf : na,
     color     = color.new(color.blue, 0),
     linewidth = 2,
     title     = "EMA 21")

// ─────────────────────────────────────────
// SIGNAL ARROWS
// ─────────────────────────────────────────

plotshape(show_signal and entry_signal,
     title    = "Short Signal",
     location = location.abovebar,
     color    = color.new(color.red, 0),
     style    = shape.triangledown,
     size     = size.normal)

bgcolor(full_bear ? color.new(color.red,    92) :
        htf_bear  ? color.new(color.orange, 92) : na,
        title = "Trend Background")

// ─────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────

var table dash = table.new(
     position.top_right, 3, 13,
     border_width = 1,
     bgcolor      = color.new(color.black, 70))

if show_table and barstate.islast

    table.cell(dash, 0, 0, "SHORT TRADE ASSISTANT",
         text_color  = color.white,
         bgcolor     = color.new(color.navy, 20),
         text_halign = text.align_center)
    table.merge_cells(dash, 0, 0, 2, 0)

    table.cell(dash, 0, 1, "FILTER",
         text_color = color.white,
         bgcolor    = color.new(color.navy, 40))
    table.cell(dash, 1, 1, "4H",
         text_color = color.white,
         bgcolor    = color.new(color.navy, 40))
    table.cell(dash, 2, 1, "1H",
         text_color = color.white,
         bgcolor    = color.new(color.navy, 40))

    table.cell(dash, 0, 2, "EMA Bear",   text_color = color.white)
    table.cell(dash, 1, 2, bear_4h  ? "YES" : "NO",
         text_color = bear_4h  ? color.green : color.red)
    table.cell(dash, 2, 2, bear_1h  ? "YES" : "NO",
         text_color = bear_1h  ? color.green : color.red)

    table.cell(dash, 0, 3, "EMA Slope",  text_color = color.white)
    table.cell(dash, 1, 3, slope_4h ? "DOWN" : "FLAT",
         text_color = slope_4h ? color.green : color.red)
    table.cell(dash, 2, 3, slope_1h ? "DOWN" : "FLAT",
         text_color = slope_1h ? color.green : color.red)

    table.cell(dash, 0, 4, "LH and LL",  text_color = color.white)
    table.cell(dash, 1, 4, bear_str_4h  ? "YES" : "NO",
         text_color = bear_str_4h  ? color.green : color.red)
    table.cell(dash, 2, 4, bear_str_ltf ? "YES" : "NO",
         text_color = bear_str_ltf ? color.green : color.red)

    table.cell(dash, 0, 5, "─────────",
         text_color = color.gray)
    table.cell(dash, 1, 5, "─────",
         text_color = color.gray)
    table.cell(dash, 2, 5, "─────",
         text_color = color.gray)

    table.cell(dash, 0, 6, "LTF STATUS",
         text_color = color.white,
         bgcolor    = color.new(color.navy, 40))
    table.cell(dash, 1, 6, "VALUE",
         text_color = color.white,
         bgcolor    = color.new(color.navy, 40))
    table.merge_cells(dash, 1, 6, 2, 6)

    table.cell(dash, 0, 7, "LTF Bear",   text_color = color.white)
    table.cell(dash, 1, 7, bear_ltf  ? "YES" : "NO",
         text_color = bear_ltf  ? color.green : color.red)
    table.merge_cells(dash, 1, 7, 2, 7)

    table.cell(dash, 0, 8, "HTF Ready",  text_color = color.white)
    table.cell(dash, 1, 8, htf_bear  ? "YES" : "NO",
         text_color = htf_bear  ? color.green : color.red)
    table.merge_cells(dash, 1, 8, 2, 8)

    table.cell(dash, 0, 9, "Full Align", text_color = color.white)
    table.cell(dash, 1, 9, full_bear ? "YES" : "NO",
         text_color = full_bear ? color.green : color.red)
    table.merge_cells(dash, 1, 9, 2, 9)

    table.cell(dash, 0, 10, "Signal",    text_color = color.white)
    table.cell(dash, 1, 10, entry_signal ? "WATCH NOW" : "WAIT",
         text_color = entry_signal ? color.yellow : color.gray)
    table.merge_cells(dash, 1, 10, 2, 10)

    table.cell(dash, 0, 11, "ATR",       text_color = color.white)
    table.cell(dash, 1, 11, str.tostring(math.round(atr, 4)),
         text_color = color.white)
    table.merge_cells(dash, 1, 11, 2, 11)

    bias_text  = full_bear  ? "STRONG SHORT" :
                 htf_bear   ? "SHORT BIAS"   :
                 bear_4h    ? "WATCH SHORT"  : "NO SETUP"
    bias_color = full_bear  ? color.red    :
                 htf_bear   ? color.orange :
                 bear_4h    ? color.yellow : color.gray

    table.cell(dash, 0, 12, "BIAS",
         text_color = color.white,
         bgcolor    = color.new(color.navy, 40))
    table.cell(dash, 1, 12, bias_text,
         text_color = bias_color,
         bgcolor    = color.new(color.navy, 60))
    table.merge_cells(dash, 1, 12, 2, 12)
