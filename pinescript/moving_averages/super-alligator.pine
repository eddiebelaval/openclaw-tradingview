//@version=5
indicator(title="Super Alligator", shorttitle="Super Alligator 🐊", overlay=true)

// ─── SMMA Function ───────────────────────────────────────────────────────────
smma(src, length) =>
    smma = 0.0
    smma := na(smma[1]) ? ta.sma(src, length) : (smma[1] * (length - 1) + src) / length
    smma

// ─── Alligator Inputs ────────────────────────────────────────────────────────
jawLength   = input.int(13, minval=1, title="Jaw Length",    group="Alligator",
  tooltip="The smoothing period for the Jaw (blue line). Bill Williams' default is 13. The Jaw is the slowest line — the alligator's lower jaw.")
teethLength = input.int(8,  minval=1, title="Teeth Length",  group="Alligator",
  tooltip="The smoothing period for the Teeth (pink line). Default is 8. The middle line — moves faster than the jaw but slower than the lips.")
lipsLength  = input.int(5,  minval=1, title="Lips Length",   group="Alligator",
  tooltip="The smoothing period for the Lips (green line). Default is 5. The fastest line — the first to react to price movement.")
jawOffset   = input.int(8,            title="Jaw Offset",    group="Alligator",
  tooltip="How many bars forward the Jaw is projected. Default is 8. This is part of Bill Williams' original design — the lines are plotted into the future to show the alligator's anticipated path.")
teethOffset = input.int(5,            title="Teeth Offset",  group="Alligator",
  tooltip="How many bars forward the Teeth are projected. Default is 5.")
lipsOffset  = input.int(3,            title="Lips Offset",   group="Alligator",
  tooltip="How many bars forward the Lips are projected. Default is 3. The signal logic accounts for all offsets so what you see on screen matches when signals fire.")

// ─── Signal Inputs ───────────────────────────────────────────────────────────
gapPct     = input.float(0.1, minval=0.0, step=0.01, title="Min Gap: Close vs Green Line (%)", group="Signal",
  tooltip="How far the closing price must be from the Lips (green line) before a signal fires. This is your sensitivity control — higher values require stronger momentum confirmation.\n\nAt NQ (~25,000):\n0.05% = ~12 pts\n0.10% = ~25 pts\n0.20% = ~50 pts\n0.30% = ~75 pts\n\nStart at 0.10% and adjust based on how many signals you want to see.")
markerDist = input.float(1.5, minval=0.1, step=0.1,  title="Signal Marker Distance (ATR mult)", group="Signal",
  tooltip="Controls how far the signal triangle sits from the candle, measured as a multiple of ATR(14). Increase if markers feel too close to the wicks. Default 1.5 works well on most timeframes.")

// ─── Filter Inputs ───────────────────────────────────────────────────────────
smaLength   = input.int(200,  minval=1, title="SMA Length",     group="Filters",
  tooltip="The length of the Simple Moving Average used as a trend filter. Default 200.\n\nOn 2-min charts: 200 bars = ~400 minutes (~1 session). Reasonable.\nOn 5-min charts: 200 bars = ~1000 minutes (~2.5 days). Gets slow — consider 50–100 or turning the filter off.")
useVwap     = input.bool(true,          title="Use VWAP Filter", group="Filters",
  tooltip="When ON, buy signals require close > VWAP and sell signals require close < VWAP.\n\nRecommended for all intraday trading. VWAP resets daily and acts as the market's intraday fair value — being on the right side of it significantly improves signal quality.\n\nTurn OFF on daily/weekly charts where VWAP is not meaningful.")
useSma      = input.bool(false,         title="Use SMA Filter",  group="Filters",
  tooltip="When ON, buy signals require close > SMA and sell signals require close < SMA.\n\nOFF by default. On 2/5-min NQ charts the SMA(200) sits hundreds of points below price most of the time, which blocks nearly every sell signal during intraday downtrends.\n\nMost useful on higher timeframes (1H, 4H, Daily) as a macro trend filter.")
showSma     = input.bool(true,          title="Show SMA",        group="Filters",
  tooltip="Toggle the SMA line visibility on the chart. The SMA is still calculated and used for filtering even when hidden.")
showVwap    = input.bool(true,          title="Show VWAP",       group="Filters",
  tooltip="Toggle the VWAP line visibility on the chart. VWAP is still calculated and used for filtering even when hidden.")
showSignals = input.bool(true,          title="Show Signals",    group="Filters",
  tooltip="Toggle buy/sell signal markers and their dotted lines on or off.")

// ─── Calculations ────────────────────────────────────────────────────────────
jaw   = smma(hl2, jawLength)
teeth = smma(hl2, teethLength)
lips  = smma(hl2, lipsLength)

sma200 = ta.sma(close, smaLength)
vwap   = ta.vwap
atr    = ta.atr(14)

// ─── Displayed values (offset-adjusted) ──────────────────────────────────────
lipsD  = lips[lipsOffset]
jawD   = jaw[jawOffset]
teethD = teeth[teethOffset]

// ─── Gap between close and green line ────────────────────────────────────────
gapOkBull = (close - lipsD) / close * 100 >= gapPct
gapOkBear = (lipsD - close) / close * 100 >= gapPct

// ─── VWAP / SMA filters ──────────────────────────────────────────────────────
vwapOkBull = not useVwap or close > vwap
vwapOkBear = not useVwap or close < vwap
smaOkBull  = not useSma  or close > sma200
smaOkBear  = not useSma  or close < sma200

// ─── Mouth direction ─────────────────────────────────────────────────────────
bullFan = lipsD > jawD
bearFan = jawD  > lipsD

// ─── All conditions met ───────────────────────────────────────────────────────
buyReady  = bullFan and gapOkBull and vwapOkBull and smaOkBull
sellReady = bearFan and gapOkBear and vwapOkBear and smaOkBear

// ─── Fire once on first bar all conditions align ──────────────────────────────
buySignal  = buyReady  and not buyReady[1]
sellSignal = sellReady and not sellReady[1]

// ─── Marker positions ─────────────────────────────────────────────────────────
buyMarkerY  = buySignal  ? low  - atr * markerDist : na
sellMarkerY = sellSignal ? high + atr * markerDist : na

// ─── Dotted lines from candle to marker ──────────────────────────────────────
if buySignal and showSignals
    line.new(bar_index, low,  bar_index, low  - atr * markerDist, style=line.style_dotted, color=color.new(color.green, 30), width=1)
if sellSignal and showSignals
    line.new(bar_index, high, bar_index, high + atr * markerDist, style=line.style_dotted, color=color.new(color.red,   30), width=1)

// ─── Plots ───────────────────────────────────────────────────────────────────
plot(jaw,   "Jaw",   offset=jawOffset,   color=#2962FF, linewidth=2)
plot(teeth, "Teeth", offset=teethOffset, color=#E91E63, linewidth=2)
plot(lips,  "Lips",  offset=lipsOffset,  color=#66BB6A, linewidth=2)

plot(sma200, "SMA",  color=showSma  ? color.new(color.orange, 0) : na, linewidth=1)
plot(vwap,   "VWAP", color=showVwap ? color.new(color.purple, 0) : na, linewidth=1)

// ─── Signal markers ──────────────────────────────────────────────────────────
plotshape(showSignals ? buyMarkerY  : na, title="Buy",  style=shape.triangleup,   location=location.absolute, color=color.new(color.green, 0), size=size.tiny)
plotshape(showSignals ? sellMarkerY : na, title="Sell", style=shape.triangledown, location=location.absolute, color=color.new(color.red,   0), size=size.tiny)

// ─── Alerts ──────────────────────────────────────────────────────────────────
alertcondition(buySignal,  title="Super Alligator — BUY",  message="🐊 Super Alligator BUY — Mouth open, gap confirmed, filters passed")
alertcondition(sellSignal, title="Super Alligator — SELL", message="🐊 Super Alligator SELL — Mouth open, gap confirmed, filters passed")
