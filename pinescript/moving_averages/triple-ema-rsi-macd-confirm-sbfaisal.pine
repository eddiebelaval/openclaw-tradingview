//@version=5
indicator("Triple EMA + RSI & MACD Confirm SBFaisal", overlay=true)

// — EMA CALCULATIONS —
ema9  = ta.ema(close, 9)
ema15 = ta.ema(close, 15)
ema21 = ta.ema(close, 21)

// — Plot EMAs —
plot(ema9, color=color.blue, title="EMA 9")
plot(ema15, color=color.orange, title="EMA 15")
plot(ema21, color=color.red, title="EMA 21")

// — RSI —
rsiLen = input.int(14, "RSI Length")
rsiVal = ta.rsi(close, rsiLen)
plot(rsiVal, title="RSI", color=color.purple, display=display.none)

// — MACD —
[macdLine, signalLine, hist] = ta.macd(close, 12, 26, 9)
// (MACD confirmation requires MACD line to be above signal for BUY and below for SELL)


// — Detect Crossover Events —
crossUpEvent   = ta.crossover(ema9, ema21)
crossDownEvent = ta.crossunder(ema9, ema21)

// — State Tracking —
var bool waitForBuyConfirm  = false
var bool waitForSellConfirm = false
var bool inLong  = false
var bool inShort = false

if crossUpEvent
    waitForBuyConfirm  := true
    waitForSellConfirm := false

if crossDownEvent
    waitForSellConfirm := true
    waitForBuyConfirm  := false

// — Generate Signals Only After ALL Confirmations —
// Conditions:
// BUY: waiting + close above EMA9 + RSI > 50 + MACD bullish + not already inLong
buySignal = waitForBuyConfirm and close > ema9 and rsiVal > 50 and macdLine > signalLine and not inLong

// SELL: waiting + close below EMA9 + RSI < 50 + MACD bearish + not already inShort
sellSignal = waitForSellConfirm and close < ema9 and rsiVal < 50 and macdLine < signalLine and not inShort

if buySignal
    waitForBuyConfirm := false
    inLong  := true
    inShort := false

if sellSignal
    waitForSellConfirm := false
    inShort := true
    inLong  := false

// — Plot Signals —
plotshape(buySignal, title="BUY", style=shape.labelup, location=location.belowbar, color=color.rgb(0, 255, 0), text="BUY")
plotshape(sellSignal, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.rgb(255, 0, 0), text="SELL")

// — Alerts —
alertcondition(buySignal, "Buy Alert", "Composite BUY Signal Confirmed")
alertcondition(sellSignal, "Sell Alert", "Composite SELL Signal Confirmed")
