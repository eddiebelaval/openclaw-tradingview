////@GoldPlusInfinity
//@version=5
indicator("GoldPlusInfinity - HH/LL + Zone", overlay=true, max_labels_count=500, max_boxes_count=500)

//Moyenne mobile
group_ma = "MOYENNE MOBILE"
show_ma20 = input.bool(true, " Activer MA 20 ", group = group_ma)
maLen20 = 20
ma20 = ta.sma(close, maLen20)
plot(show_ma20 ? ma20 : na, color=color.new(#3b82f6, 60), title="MA20 Trend", linewidth=2)

show_ma50 = input.bool(true, " Activer MA 50 ", group = group_ma)
maLen50 = 50
ma50 = ta.sma(close, maLen50)
plot(show_ma50 ? ma50 : na, color=color.new(#f6643b, 60), title="MA50 Trend", linewidth=2)

// --- Paramètres ---
lbLeft      = input.int(1, "Bougies à gauche", minval=1,group="Paramètres")
lbRight     = input.int(5, "Bougies à droite", minval=1,group="Paramètres")
showLabels  = input.bool(true, "Afficher les étiquettes (HH/LL)",group="Paramètres")
drawRects   = input.bool(true, "Tracer un rectangle sur la bougie",group="Paramètres")
extendRects = input.bool(true, "Zones dynamiques",group="Paramètres")
keepBroken  = input.bool(true, "Conserver les zones touchées",group="Paramètres")
maxZones    = input.int(50, "Nombre max de zones à afficher", minval=1,group="Paramètres")

// --- Paramètres de Sensibilité ---
touchThreshold = input.int(1, "Bougies pour confirmer contact", minval=1,group="Paramètres")

// --- Paramètres de Couleurs ---
colorHigh = input.color(color.new(#aaa3a3, 80), "Couleur Swing High (Résistance)", group="Style des Zones")
borderHigh = input.color(color.rgb(101, 95, 95), "Bordure Swing High", group="Style des Zones")
colorLow = input.color(color.new(#42b7ce, 80), "Couleur Swing Low (Support)", group="Style des Zones")
borderLow = input.color(color.rgb(117, 134, 117), "Bordure Swing Low", group="Style des Zones")

// --- Tableaux pour gérer les zones actives ---
var box[] activeHighBoxes = array.new_box()
var box[] activeLowBoxes = array.new_box()
var int[] highTouchCount = array.new_int()
var int[] lowTouchCount  = array.new_int()

// --- Logique de détection ---
swh = ta.pivothigh(high, lbLeft, lbRight)
swl = ta.pivotlow(low, lbLeft, lbRight)

// --- Fonction pour déterminer les bornes du rectangle selon le type de bougie ---
get_box_bounds(isHigh, idx) =>
    float _top = high[idx]
    float _bottom = low[idx]
    float _open = open[idx]
    float _close = close[idx]
    float bodySize = math.abs(_open - _close)
    float candleRange = _top - _bottom
    float avgRange = ta.sma(high - low, 20)[idx] // Moyenne pour détecter les "grandes" bougies
    
    bool isDoji = bodySize <= (candleRange * 0.1)
    bool isPinBar = (isHigh ? (_top - math.max(_open, _close)) : (math.min(_open, _close) - _bottom)) > (bodySize * 2)
    bool isLarge = candleRange > (avgRange * 1.5)
    bool isGreen = _close > _open

    if isDoji or isPinBar
        _top := high[idx]
        _bottom := low[idx]
    else if isLarge
        // Grande bougie : on ne trace que les mèches
        if isHigh
            _top := high[idx]
            _bottom := math.max(_open, _close)
        else
            _top := math.min(_open, _close)
            _bottom := low[idx]
    else
        // Bougie normale
        if isHigh
            _top := high[idx]
            _bottom := isGreen ? _open : _close
        else
            _top := isGreen ? _close : _open
            _bottom := low[idx]
    [_top, _bottom]

// --- Gestion des nouveaux Swings ---
if not na(swh)
    int swh_index = bar_index[lbRight]
    if showLabels
        label.new(swh_index, high[lbRight], "HH", style=label.style_none, textcolor=borderHigh, yloc=yloc.abovebar)
    
    if drawRects
        [boxTop, boxBottom] = get_box_bounds(true, lbRight)
        box newBox = box.new(swh_index - 1, boxTop, extendRects ? bar_index : swh_index + 1, boxBottom, 
             border_color=borderHigh, bgcolor=colorHigh)
        if extendRects
            array.push(activeHighBoxes, newBox)
            array.push(highTouchCount, 0)
            if array.size(activeHighBoxes) > maxZones
                box oldBox = array.shift(activeHighBoxes)
                array.shift(highTouchCount)
                if not keepBroken
                    box.delete(oldBox)

if not na(swl)
    int swl_index = bar_index[lbRight]
    if showLabels
        label.new(swl_index, low[lbRight], "LL", style=label.style_none, textcolor=borderLow, yloc=yloc.belowbar)
    
    if drawRects
        [boxTop, boxBottom] = get_box_bounds(false, lbRight)
        box newBox = box.new(swl_index - 1, boxTop, extendRects ? bar_index : swl_index + 1, boxBottom, 
             border_color=borderLow, bgcolor=colorLow)
        if extendRects
            array.push(activeLowBoxes, newBox)
            array.push(lowTouchCount, 0)
            if array.size(activeLowBoxes) > maxZones
                box oldBox = array.shift(activeLowBoxes)
                array.shift(lowTouchCount)
                if not keepBroken
                    box.delete(oldBox)

// --- Mise à jour et arrêt des zones au contact ---
if extendRects
    // Vérification des zones Swing High (Résistances)
    if array.size(activeHighBoxes) > 0
        for i = array.size(activeHighBoxes) - 1 to 0
            box b = array.get(activeHighBoxes, i)
            float boxBottom = box.get_bottom(b)
            int count = array.get(highTouchCount, i)
            
            if high >= boxBottom
                count += 1
                array.set(highTouchCount, i, count)
                if count >= touchThreshold
                    box.set_right(b, bar_index)
                    array.remove(activeHighBoxes, i)
                    array.remove(highTouchCount, i)
                    if not keepBroken
                        box.delete(b)
                else
                    box.set_right(b, bar_index + 1)
            else
                box.set_right(b, bar_index + 1)

    // Vérification des zones Swing Low (Supports)
    if array.size(activeLowBoxes) > 0
        for i = array.size(activeLowBoxes) - 1 to 0
            box b = array.get(activeLowBoxes, i)
            float boxTop = box.get_top(b)
            int count = array.get(lowTouchCount, i)
            
            if low <= boxTop
                count += 1
                array.set(lowTouchCount, i, count)
                if count >= touchThreshold
                    box.set_right(b, bar_index)
                    array.remove(activeLowBoxes, i)
                    array.remove(lowTouchCount, i)
                    if not keepBroken
                        box.delete(b)
                else
                    box.set_right(b, bar_index + 1)
            else
                box.set_right(b, bar_index + 1)

// --- Alertes ---
alertcondition(swh, title="Swing High détecté", message="Un nouveau Swing High a été confirmé")
alertcondition(swl, title="Swing Low détecté", message="Un nouveau Swing Low a été confirmé")
