//@version=5
indicator("Magic Sword: Precision Trend + Volume Filter Fixed", overlay=true)

// --- INPUTS ---
tablePos   = input.string("Bottom Right", "Dashboard Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"])
magicLen   = input.int(20, "Magic Trend Length")
magicMult  = input.float(1.0, "Magic Trend Multiplier")
hmaLen     = input.int(50, "HMA Trend Filter")
chopLen    = input.int(14, "Consolidation Filter (CHOP)")
chopLimit  = input.int(50, "Chop Threshold")
volMult    = input.float(1.5, "Volume Breakout Multiplier", step=0.1)

// --- CALCULATIONS ---
cciValue = ta.cci(hlc3, magicLen)
magicTrendUp = cciValue >= 0
magicTrendDn = cciValue < 0

hma = ta.hma(close, hmaLen)
hmaUp = hma > hma[1]

ci = 100 * math.log10(math.sum(ta.tr, chopLen) / (ta.highest(high, chopLen) - ta.lowest(low, chopLen))) / math.log10(chopLen)
isTrending = ci < chopLimit
isConsolidating = ci >= chopLimit

volAvg = ta.sma(volume, 20)
isHighVolume = volume > (volAvg * volMult)

// --- SIGNAL LOGIC ---
longSignal  = magicTrendUp and not magicTrendUp[1] and hmaUp and isTrending and isHighVolume
shortSignal = magicTrendDn and not magicTrendDn[1] and not hmaUp and isTrending and isHighVolume

// --- DASHBOARD POSITION LOGIC ---
var pos = tablePos == "Top Right" ? position.top_right : tablePos == "Bottom Right" ? position.bottom_right : tablePos == "Top Left" ? position.top_left : position.bottom_left

// --- VISUALS ---
plot(hma, title="HMA Trend Line", color=hmaUp ? color.new(#00ffbb, 0) : color.new(#ff0055, 0), linewidth=3)

//
