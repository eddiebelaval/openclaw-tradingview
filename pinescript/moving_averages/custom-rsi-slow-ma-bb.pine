//@version=5
indicator("Custom RSI + Slow MA + BB", overlay=false)

// === INPUTS === //
rsiLength = input.int(14, "RSI Length")
maLength = input.int(50, "Slow MA Length")
maType   = input.string("EMA", "MA Type", options=["EMA", "SMA"])

bbEnable = input.bool(true, "Enable Bollinger Bands")
bbLength = input.int(20, "BB Length")
bbMult   = input.float(2.0, "BB Std Dev")

// === RSI === //
rsi = ta.rsi(close, rsiLength)

// === MA (EMA or SMA) === //
ma = maType == "EMA" ? ta.ema(rsi, maLength) : ta.sma(rsi, maLength)

// === Bollinger Bands on RSI === //
basis = ta.sma(rsi, bbLength)
dev = bbMult * ta.stdev(rsi, bbLength)
upper = basis + dev
lower = basis - dev

// === PLOTS === //
plot(rsi, title="RSI", linewidth=2)
plot(ma, title="Slow MA", linewidth=2, color=color.orange)

// Center line
hline(50, "Center Line", color=color.gray)

// Overbought / Oversold
hline(70, "Overbought", color=color.red)
hline(30, "Oversold", color=color.green)

// Bollinger Bands (optional)
plot(bbEnable ? upper : na, "BB Upper", color=color.blue)
plot(bbEnable ? lower : na, "BB Lower", color=color.blue)
plot(bbEnable ? basis : na, "BB Basis", color=color.blue)

// === SIGNALS === //
bullCross = ta.crossover(rsi, ma)
bearCross = ta.crossunder(rsi, ma)

plotshape(bullCross, title="Bullish Cross", location=location.bottom, color=color.green, style=shape.triangleup, size=size.small)
plotshape(bearCross, title="Bearish Cross", location=location.top, color=color.red, style=shape.triangledown, size=size.small)
