//@version=6
indicator("🎯 FIMATHE ELITE PRO [CLEAN & VIVID] v3.3", overlay=true, shorttitle="FIMATHE_VIVID", max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════
// 1. CONFIGURAÇÕES
// ═══════════════════════════════════════════════════════════════════════
grp_setup = "🗺️ Setup Fimathe"
ignorar_inicio = input.int(1, "Ignorar X Primeiros Candles", minval=0, group=grp_setup)
modo_map       = input.string("Horario", "Modo de Mapeamento", options=["Candles", "Horario"], group=grp_setup)
qtde_bars      = input.int(15, "Tamanho (Qtd Candles)", minval=1, group=grp_setup)
sessao_horario = input.session("0900-1000","Horário de Mapeamento", group=grp_setup)
lookback_trend = input.int(60, "Períodos Tendência (Seta)", minval=10, group=grp_setup)
limite_pontos  = input.float(500, "Limite de Fatiamento (Pts)", minval=100, group=grp_setup)

grp_vis = "🎨 Visual Fimathe"
c_cr           = input.color(color.new(#1565C0, 80), "Cor Canal Referência", group=grp_vis)
c_zn           = input.color(color.new(#78909C, 80), "Cor Zona Neutra", group=grp_vis)
qtde_niveis    = input.int(3, "Qtd Níveis Expansão", minval=1, maxval=20, group=grp_vis)
w_linhas       = input.int(1, "Espessura Linhas Expansão", minval=1, maxval=5, group=grp_vis)
mostrar_sinais = input.bool(true, "Mostrar Tags de Gain?", group=grp_vis)

// --- INPUTS DE VISUALIZAÇÃO ---
grp_trade_vis  = "🎯 Visual Alvo e Stop"
tam_rotulos    = input.string(size.small, "Tamanho das Legendas", options=[size.tiny, size.small, size.normal, size.large], group=grp_trade_vis) // Padrão Small para não poluir
w_linhas_trade = input.int(2, "Espessura Linha Stop/Alvo", minval=1, maxval=5, group=grp_trade_vis)
c_linha_stop   = input.color(color.new(#FF1744, 0), "Cor Linha Stop (Vívida)", group=grp_trade_vis)
c_linha_alvo   = input.color(color.new(#2979FF, 0), "Cor Linha Alvo (Vívida)", group=grp_trade_vis)

grp_ind = "📈 Médias ALMA (Cruzamento)"
c_vwap_input   = input.color(color.orange, "Cor da VWAP", group=grp_ind)
w_vwap_input   = input.int(3, "Espessura da VWAP", minval=1, maxval=5, group=grp_ind)
len_alma       = input.int(9, "ALMA Rápida (Gatilho)", group=grp_ind) 
len_alma_slow  = input.int(40, "ALMA Lenta (Tendência)", group=grp_ind)
sigma_alma     = input.float(6, "Sigma ALMA", group=grp_ind)
offset_alma    = input.float(0.85, "Offset ALMA", group=grp_ind)

grp_painel     = "🖥️ Painel Titanium"
mostrar_guia   = input.bool(true, "Ativar Painel?", group=grp_painel)
pos_guia       = input.string(position.top_right, "Posição", options=[position.top_right, position.bottom_right, position.top_left, position.bottom_left], group=grp_painel)
tam_txt_input  = input.string("Small", "Tamanho do Texto", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=grp_painel)

minConfluence  = input.int(2, "Confluência Mínima", minval=0, maxval=4, group=grp_painel)
minVolume      = input.float(1.1, "Vol. Mínimo (Filtro)", step=0.1, group=grp_painel)
limite_afastamento_pts = input.float(1000, "Alerta Distância VWAP", step=50, group=grp_painel)

// Cores Base VÍVIDAS (Neon)
c_compra = #00E676  // Verde Neon
c_venda  = #FF1744  // Vermelho Neon
c_neutro = #9E9E9E
c_fundo_painel = color.white
c_border_painel = #BDBDBD
c_texto  = #212529

// ═══════════════════════════════════════════════════════════════════════
// 2. INDICADORES VISUAIS
// ═══════════════════════════════════════════════════════════════════════
vwapVal = ta.vwap(close)
plot(vwapVal, "VWAP", color=c_vwap_input, linewidth=w_vwap_input, style=plot.style_line)

almaFast = ta.alma(close, len_alma, offset_alma, sigma_alma)
almaSlow = ta.alma(close, len_alma_slow, offset_alma, sigma_alma)

// Lógica de Cruzamento ALMA
bool cross_up = ta.crossover(almaFast, almaSlow)
bool cross_dn = ta.crossunder(almaFast, almaSlow)
bool trend_bull = almaFast > almaSlow
bool trend_bear = almaFast < almaSlow

// Cores Dinâmicas
color c_alma_fast = trend_bull ? c_compra : c_venda
color c_cloud = trend_bull ? color.new(c_compra, 85) : color.new(c_venda, 85)

p1 = plot(almaFast, "ALMA Rápida (9)", color=c_alma_fast, linewidth=2)
p2 = plot(almaSlow, "ALMA Lenta (40)", color=color.new(color.gray, 50), linewidth=2)
fill(p1, p2, title="Nuvem Cruzamento", color=c_cloud)

// Sinais de Cruzamento no Gráfico (Discretos)
plotshape(cross_up, "Compra ALMA", shape.circle, location.belowbar, color=c_compra, size=size.tiny)
plotshape(cross_dn, "Venda ALMA", shape.circle, location.abovebar, color=c_venda, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════
// 3. CÁLCULOS ESTATÍSTICOS
// ═══════════════════════════════════════════════════════════════════════
novo_dia = ta.change(time("D")) != 0

volMA      = ta.sma(volume, 20)
highVol    = volume > volMA * minVolume
dist_vwap_pts = close - vwapVal
risco_reversao = math.abs(dist_vwap_pts) >= limite_afastamento_pts

lrNow      = ta.linreg(close, lookback_trend, 0)
lrPrev     = ta.linreg(close, lookback_trend, 1)

// Variação Diária (Real-Time)
float fechamento_ant = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
float variacao_pct = ((close - fechamento_ant) / fechamento_ant) * 100

// Matrix MTF
f_trend(_tf) =>
    float _c = request.security(syminfo.tickerid, _tf, close)
    float _e = request.security(syminfo.tickerid, _tf, ta.ema(close, 20))
    _c > _e

bool t5_up = f_trend("5"), bool t15_up = f_trend("15"), bool t60_up = f_trend("60")
int mtf_score = 0
if t5_up 
    mtf_score += 1
else 
    mtf_score -= 1
if t15_up 
    mtf_score += 1
else 
    mtf_score -= 1
if t60_up 
    mtf_score += 1
else 
    mtf_score -= 1

string align_txt = mtf_score == 3 ? "TEND. MACRO (ALTA)" : mtf_score == -3 ? "TEND. MACRO (BAIXA)" : "MISTA / LATERAL"
color align_col = mtf_score == 3 ? c_compra : mtf_score == -3 ? c_venda : c_neutro
float rvol = volume / volMA

bScore = (highVol ? 1:0) + (close > vwapVal ? 1:0) + (close > open ? 1:0) + (lrNow > lrPrev ? 1:0)
sScore = (highVol ? 1:0) + (close < vwapVal ? 1:0) + (close < open ? 1:0) + (lrNow < lrPrev ? 1:0)

// ═══════════════════════════════════════════════════════════════════════
// 4. LÓGICA CORE FIMATHE
// ═══════════════════════════════════════════════════════════════════════
var float rTopo = na, var float rFundo = na, var float amp = na
var bool  setupOk = false, var bool isMapeando = false
var int   bIni = na, var int bFim = na
var int   estado = 0, var int nivel = 1
var float crTop = na, var float crBot = na, var float znTop = na, var float znBot = na
var float pStop = na, var float pAlvo = na
var string tendDir = na

var box vCR = na, var box vZN = na
var line vTend = na, var label lTend = na
var line[] vGrd = array.new_line()
var label lbl_ampCR = na, var label lbl_ampZN = na

var float ePrice = na, var string lType = "---"

// Função Limpeza
limpar() =>
    if not na(vCR)
        box.delete(vCR)
    if not na(vZN)
        box.delete(vZN)
    if not na(vTend)
        line.delete(vTend)
    if not na(lTend)
        label.delete(lTend)
    if not na(lbl_ampCR)
        label.delete(lbl_ampCR)
    if not na(lbl_ampZN)
        label.delete(lbl_ampZN)
    while array.size(vGrd) > 0
        line.delete(array.pop(vGrd))

// Função Plotar TAG Melhorada (VÍVIDA E ABREVIADA)
plotar_tag(texto, cor, is_up, show_label) =>
    if mostrar_sinais and show_label
        label.new(bar_index, is_up ? low : high, texto, color=cor, textcolor=color.white, style=is_up ? label.style_label_up : label.style_label_down, size=tam_rotulos)

destacar_niveis(_stop, _alvo, is_compra) =>
    line.new(bar_index, _stop, bar_index + 15, _stop, color=color.new(is_compra ? c_venda : c_compra, 20), width=w_linhas_trade, style=line.style_dotted) // Menos transparente
    line.new(bar_index, _alvo, bar_index + 15, _alvo, color=color.new(color.blue, 20), width=w_linhas_trade, style=line.style_dotted)
    // Removed text labels from lines to clean chart further (user requested cleanup)

// ═══════════════════════════════════════════════════════════════════════
// 5. MAPEAMENTO
// ═══════════════════════════════════════════════════════════════════════
var int cDia = 0, var int cMap = 0

if novo_dia
    limpar()
    setupOk := false, isMapeando := false, cDia := 0, cMap := 0
    estado := 0, nivel := 1, rTopo := na, rFundo := na, ePrice := na, lType := "---"

cDia += 1
bool in_sess = not na(time(timeframe.period, sessao_horario, "America/Sao_Paulo"))
bool can_map = modo_map == "Horario" ? in_sess : cDia > ignorar_inicio

if can_map and not setupOk
    if modo_map == "Candles"
        if not isMapeando
            isMapeando := true, cMap := 1, bIni := bar_index, rTopo := high, rFundo := low
        else if cMap < qtde_bars
            rTopo := math.max(rTopo, high), rFundo := math.min(rFundo, low), cMap += 1
        if cMap == qtde_bars
            setupOk := true, isMapeando := false
    else if modo_map == "Horario"
        if not isMapeando
            isMapeando := true, bIni := bar_index, rTopo := high, rFundo := low
        else
            rTopo := math.max(rTopo, high), rFundo := math.min(rFundo, low)

if modo_map == "Horario" and isMapeando and not in_sess
    setupOk := true, isMapeando := false

// ═══════════════════════════════════════════════════════════════════════
// 6. DESENHO DOS CANAIS
// ═══════════════════════════════════════════════════════════════════════
var bool fatiado = false 

if setupOk and not setupOk[1]
    bFim := bar_index
    float rng = rTopo - rFundo
    fatiado := rng > limite_pontos
    amp := fatiado ? rng / 2.0 : rng
    tendDir := lrNow > lrPrev ? "ALTA" : "BAIXA"
    float mid = (rTopo + rFundo) / 2.0
    
    if tendDir == "ALTA"
        crTop := rTopo, crBot := fatiado ? mid : rFundo
        znTop := fatiado ? mid : rFundo, znBot := fatiado ? rFundo : rFundo - amp
    else
        crTop := fatiado ? mid : rTopo, crBot := rFundo
        znTop := fatiado ? rTopo : rTopo + amp, znBot := fatiado ? mid : rTopo
        
    vCR := box.new(bIni, crTop, bar_index + 150, crBot, bgcolor=c_cr, border_color=color.gray)
    vZN := box.new(bIni, znTop, bar_index + 150, znBot, bgcolor=c_zn, border_color=color.gray)
    
    string str_amp = " (" + str.tostring(math.round(amp)) + "p)"
    lbl_ampCR := label.new(bar_index + 2, crTop - (amp/2), "CR" + str_amp, color=color.new(chart.bg_color, 20), textcolor=c_texto, style=label.style_label_left, size=tam_rotulos)
    lbl_ampZN := label.new(bar_index + 2, znTop - (amp/2), "ZN" + str_amp, color=color.new(chart.bg_color, 20), textcolor=c_texto, style=label.style_label_left, size=tam_rotulos)
    
    int half_lookback = math.max(1, math.round(lookback_trend / 2))
    vTend := line.new(bIni - lookback_trend, lrPrev, bIni, lrNow, color=tendDir=="ALTA"?c_compra:c_venda, width=2, style=line.style_arrow_right)
    
    float y_pos_lbl = tendDir == "ALTA" ? math.min(lrPrev, rFundo) : math.max(lrPrev, rTopo)
    string lbl_style = tendDir == "ALTA" ? label.style_label_up : label.style_label_down
    lTend := label.new(bIni - half_lookback, y_pos_lbl, text="Tendência de\n" + tendDir, color=color.new(color.white, 100), textcolor=tendDir=="ALTA"?c_compra:c_venda, style=lbl_style, size=tam_rotulos)

    float base_up = math.max(crTop, znTop)
    float base_dn = math.min(crBot, znBot)
    
    for i = 1 to qtde_niveis
        array.push(vGrd, line.new(bIni, base_up + (amp * i), bFim, base_up + (amp * i), color=color.new(c_compra, 40), width=w_linhas, style=line.style_solid, extend=extend.right))
        array.push(vGrd, line.new(bIni, base_dn - (amp * i), bFim, base_dn - (amp * i), color=color.new(c_venda, 40), width=w_linhas, style=line.style_solid, extend=extend.right))

if setupOk
    if not na(vCR)
        box.set_right(vCR, bar_index + 150)
    if not na(vZN)
        box.set_right(vZN, bar_index + 150)
    if not na(lbl_ampCR)
        label.set_x(lbl_ampCR, bar_index + 2)
    if not na(lbl_ampZN)
        label.set_x(lbl_ampZN, bar_index + 2)

// ═══════════════════════════════════════════════════════════════════════
// 7. EXECUÇÃO DE TRADES (LÓGICA BLINDADA E LIMPA)
// ═══════════════════════════════════════════════════════════════════════

if setupOk
    // ESTADO 0: AGUARDANDO
    if estado == 0
        if tendDir == "ALTA"
            // Gatilho de Compra Normal
            if close > crTop and bScore >= minConfluence and barstate.isconfirmed
                estado := 1, nivel := 1, ePrice := close, lType := "COMPRA"
                pStop := znBot, pAlvo := crTop + amp
                plotar_tag("▲ COMPRA", c_compra, true, true)
            // Gatilho de Reversão (Venda)
            else if close < znBot and sScore >= minConfluence and barstate.isconfirmed
                estado := -1, nivel := 1, ePrice := close, lType := "VENDA (REV)"
                pStop := crBot, pAlvo := znBot - amp
                plotar_tag("▼ REV (VENDA)", c_venda, false, true)
        else // BAIXA
            // Gatilho de Venda Normal
            if close < crBot and sScore >= minConfluence and barstate.isconfirmed
                estado := -1, nivel := 1, ePrice := close, lType := "VENDA"
                pStop := znTop, pAlvo := crBot - amp
                plotar_tag("▼ VENDA", c_venda, false, true)
            // Gatilho de Reversão (Compra)
            else if close > znTop and bScore >= minConfluence and barstate.isconfirmed
                estado := 1, nivel := 1, ePrice := close, lType := "COMPRA (REV)"
                pStop := crTop, pAlvo := znTop + amp
                plotar_tag("▲ REV (COMPRA)", c_compra, true, true)

    // ESTADO 1: COMPRADO
    else if estado == 1 
        // Verifica STOP
        if close < pStop and barstate.isconfirmed
            estado := 0
            pStop := na, pAlvo := na, nivel := 1 
            plotar_tag("STOP", c_venda, false, true) // Stop sempre mostra
            
        // Verifica GAIN
        else if close >= pAlvo and not na(pAlvo) and barstate.isconfirmed
            // FILTRO VISUAL: Só plota se o candle for VERDE (confirmando força)
            bool visual_valido = close > open
            plotar_tag("G" + str.tostring(nivel), c_compra, true, visual_valido)
            
            nivel += 1
            pStop := pStop + amp // Sobe Stop
            pAlvo := pAlvo + amp // Novo Alvo
            destacar_niveis(pStop, pAlvo, true)

    // ESTADO -1: VENDIDO
    else if estado == -1 
        // Verifica STOP
        if close > pStop and barstate.isconfirmed
            estado := 0
            pStop := na, pAlvo := na, nivel := 1
            plotar_tag("STOP", c_compra, true, true) // Stop sempre mostra
            
        // Verifica GAIN
        else if close <= pAlvo and not na(pAlvo) and barstate.isconfirmed
            // FILTRO VISUAL: Só plota se o candle for VERMELHO (confirmando força)
            bool visual_valido = close < open
            plotar_tag("G" + str.tostring(nivel), c_venda, false, visual_valido)
            
            nivel += 1
            pStop := pStop - amp // Desce Stop
            pAlvo := pAlvo - amp // Novo Alvo
            destacar_niveis(pStop, pAlvo, false)

// PLOTAGEM DO STOP E ALVO
plot(estado != 0 ? pStop : na, "Stop Móvel", color=c_linha_stop, linewidth=w_linhas_trade, style=plot.style_stepline)
plot(estado != 0 ? pAlvo : na, "Alvo Móvel", color=c_linha_alvo, linewidth=w_linhas_trade, style=plot.style_stepline)

// ═══════════════════════════════════════════════════════════════════════
// 8. PAINEL TITANIUM (PAINEL HD)
// ═══════════════════════════════════════════════════════════════════════
string real_size = switch tam_txt_input
    "Tiny" => size.tiny
    "Small" => size.small
    "Normal" => size.normal
    "Large" => size.large
    "Huge" => size.huge
    => size.small

var table pnl = table.new(pos_guia, 2, 18, bgcolor=c_fundo_painel, border_width=1, border_color=c_border_painel, frame_color=c_border_painel, frame_width=1)

if barstate.islast and mostrar_guia
    bool dados_recentes = (timenow - time < 120000) 
    bool mercado_ativo = session.ismarket and dados_recentes
    string mkt_status = mercado_ativo ? "🟢 ABERTO" : "🔴 FECHADO"
    color c_mkt = mercado_ativo ? c_compra : c_venda

    string txt_rvol = "NORMAL"
    color c_rvol = color.gray
    if rvol < 0.7
        txt_rvol := "BAIXO"
        c_rvol := c_venda
    else if rvol > 1.2
        txt_rvol := "ALTO"
        c_rvol := color.purple
    else
        txt_rvol := "NORMAL"
        c_rvol := c_compra
    
    // Cor da Variação
    color c_var = variacao_pct > 0 ? c_compra : variacao_pct < 0 ? c_venda : c_neutro

    table.cell(pnl, 0, 0, "Ativo: " + syminfo.ticker, text_halign=text.align_left, text_color=color.black, text_size=real_size, bgcolor=color.new(color.blue, 90))
    table.cell(pnl, 1, 0, "FIMATHE_VIVID", text_halign=text.align_right, text_color=color.blue, text_size=real_size)

    table.cell(pnl, 0, 1, "Var. Dia (%)", text_halign=text.align_left, text_color=color.black, text_size=real_size)
    table.cell(pnl, 1, 1, str.tostring(variacao_pct, "#.##") + "%", text_halign=text.align_right, text_color=c_var, text_size=real_size)

    table.cell(pnl, 0, 2, "Mercado", text_halign=text.align_left, text_color=color.black, text_size=real_size)
    table.cell(pnl, 1, 2, mkt_status, text_halign=text.align_right, text_color=c_mkt, text_size=real_size)

    string st_txt = setupOk ? (estado != 0 ? "EM OPERAÇÃO" : "AGUARDANDO") : "MAPEANDO..."
    color st_col = setupOk ? (estado != 0 ? color.blue : c_compra) : color.orange
    string info_amp = str.tostring(amp, format.mintick) + (fatiado ? " (Fatiado 1/2)" : "")
    
    table.cell(pnl, 0, 3, "Status Setup", text_halign=text.align_left, text_color=color.black, text_size=real_size)
    table.cell(pnl, 1, 3, st_txt, text_halign=text.align_right, text_color=st_col, text_size=real_size)
    
    table.cell(pnl, 0, 4, "Amplitude (AMP)", text_halign=text.align_left, text_color=color.black, text_size=real_size)
    table.cell(pnl, 1, 4, info_amp, text_halign=text.align_right, text_color=c_neutro, text_size=real_size)

    table.cell(pnl, 0, 5, "─ Radar MTF", text_halign=text.align_left, text_color=c_neutro, text_size=size.tiny)
    table.merge_cells(pnl, 0, 5, 1, 5)
    
    table.cell(pnl, 0, 6, "Tendência 5m", text_halign=text.align_left, text_color=color.black, text_size=real_size)
    table.cell(pnl, 1, 6, t5_up ? "⬆ ALTA" : "⬇ BAIXA", text_halign=text.align_right, text_color=t5_up ? c_compra : c_venda, text_size=real_size)
    
    table.cell(pnl, 0, 7, "Tendência 15m", text_halign=text.align_left, text_color=color.black, text_size=real_size)
    table.cell(pnl, 1, 7, t15_up ? "⬆ ALTA" : "⬇ BAIXA", text_halign=text.align_right, text_color=t15_up ? c_compra : c_venda, text_size=real_size)
    
    table.cell(pnl, 0, 8, "Tendência 60m", text_halign=text.align_left, text_color=color.black, text_size=real_size)
    table.cell(pnl, 1, 8, t60_up ? "⬆ ALTA" : "⬇ BAIXA", text_halign=text.align_right, text_color=t60_up ? c_compra : c_venda, text_size=real_size)
    
    table.cell(pnl, 0, 9, "Consenso Macro", text_halign=text.align_left, text_color=color.black, text_size=real_size)
    table.cell(pnl, 1, 9, align_txt, text_halign=text.align_right, text_color=align_col, text_size=size.tiny)

    table.cell(pnl, 0, 10, "─ Fluxo & Volume", text_halign=text.align_left, text_color=c_neutro, text_size=size.tiny)
    table.merge_cells(pnl, 0, 10, 1, 10)

    table.cell(pnl, 0, 11, "Vol. Relativo", text_halign=text.align_left, text_color=color.black, text_size=real_size)
    table.cell(pnl, 1, 11, txt_rvol + " (" + str.tostring(rvol, "#.#") + "x)", text_halign=text.align_right, text_color=c_rvol, text_size=real_size)

    string vwap_txt = str.tostring(dist_vwap_pts, format.mintick)
    color col_vwap = risco_reversao ? c_venda : c_compra
    table.cell(pnl, 0, 12, "Distância VWAP", text_halign=text.align_left, text_color=color.black, text_size=real_size)
    table.cell(pnl, 1, 12, vwap_txt, text_halign=text.align_right, text_color=col_vwap, text_size=real_size)

    table.cell(pnl, 0, 13, "─ Trade Atual", text_halign=text.align_left, text_color=c_neutro, text_size=size.tiny)
    table.merge_cells(pnl, 0, 13, 1, 13)

    if estado == 0
        table.cell(pnl, 0, 14, "Próx. Compra", text_halign=text.align_left, text_color=color.black, text_size=size.tiny)
        table.cell(pnl, 1, 14, str.tostring(tendDir=="ALTA"?crTop:znTop, format.mintick), text_halign=text.align_right, text_color=c_compra, text_size=size.tiny)
        table.cell(pnl, 0, 15, "Próx. Venda", text_halign=text.align_left, text_color=color.black, text_size=size.tiny)
        table.cell(pnl, 1, 15, str.tostring(tendDir=="ALTA"?znBot:crBot, format.mintick), text_halign=text.align_right, text_color=c_venda, text_size=size.tiny)
    else
        float lucro_atual = estado == 1 ? (close - ePrice) : (ePrice - close)
        color c_luc = lucro_atual >= 0 ? c_compra : c_venda
        table.cell(pnl, 0, 14, lType + " ➔ Nível " + str.tostring(nivel), text_halign=text.align_center, text_color=color.white, text_size=real_size, bgcolor=estado==1?c_compra:c_venda)
        table.merge_cells(pnl, 0, 14, 1, 14)
        table.cell(pnl, 0, 15, "Lucro Aberto:", text_halign=text.align_left, text_color=color.black, text_size=real_size)
        table.cell(pnl, 1, 15, str.tostring(lucro_atual, format.mintick), text_halign=text.align_right, text_color=c_luc, text_size=real_size)

    string dec_final = "NEUTRO"
    color col_final = c_neutro
    if risco_reversao
        dec_final := "CUIDADO: ESTICADO"
        col_final := color.orange
    else if estado == 1
        dec_final := mtf_score >= 1 ? "MANTER COMPRA (Forte)" : "ATENÇÃO: Mista"
        col_final := mtf_score >= 1 ? c_compra : color.orange
    else if estado == -1
        dec_final := mtf_score <= -1 ? "MANTER VENDA (Forte)" : "ATENÇÃO: Mista"
        col_final := mtf_score <= -1 ? c_venda : color.orange
    else
        if tendDir == "ALTA" and mtf_score == 3
            dec_final := "PREPARAR COMPRA"
            col_final := c_compra
        else if tendDir == "BAIXA" and mtf_score == -3
            dec_final := "PREPARAR VENDA"
            col_final := c_venda
        else
            dec_final := "SEM CONFLUENCIAS"
    
    string size_final = switch tam_txt_input
        "Tiny" => size.small
        "Small" => size.normal
        "Normal" => size.large
        "Large" => size.huge
        "Huge" => size.huge
        => size.normal

    table.cell(pnl, 0, 16, "Análise Sistema", text_halign=text.align_left, text_color=color.black, text_size=size.tiny)
    table.merge_cells(pnl, 0, 16, 1, 16)
    table.cell(pnl, 0, 17, dec_final, text_halign=text.align_center, text_color=color.white, text_size=size_final, bgcolor=col_final)
    table.merge_cells(pnl, 0, 17, 1, 17)
