//@version=6
indicator('EMA & MACD Strategy with SL/TP', overlay = true, shorttitle = 'EMA_MACD_SLTP')

// --- パラメーター入力 ---
emaShortLen = input.int(15, 'EMAチャネル期間', minval = 1)
emaLongLen = input.int(200, '長期EMA(環境認識)期間', minval = 1)
macdFast = input.int(12, 'MACD 短期(Fast)', minval = 1)
macdSlow = input.int(26, 'MACD 長期(Slow)', minval = 1)
macdSignal = input.int(9, 'MACD シグナル', minval = 1)
lookbackPeriod = input.int(3, '条件成立の有効期限 (本数)', minval = 0)
rewardRatio = input.float(1.5, 'リスクリワード比 (利確/損切)', step = 0.1)

// --- 計算ロジック ---
emaHigh = ta.ema(high, emaShortLen)
emaLow = ta.ema(low, emaShortLen)
ema200 = ta.ema(close, emaLongLen)
[_, _, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)

// クロス判定
priceCrossUnderLow = ta.crossunder(close, emaLow)
priceCrossOverHigh = ta.crossover(close, emaHigh)
histCrossUnderZero = ta.crossunder(macdHist, 0)
histCrossOverZero = ta.crossover(macdHist, 0)

// 最後に条件を満たしてからの経過本数
barsSincePriceLow = ta.barssince(priceCrossUnderLow)
barsSincePriceHigh = ta.barssince(priceCrossOverHigh)
barsSinceHistLow = ta.barssince(histCrossUnderZero)
barsSinceHistHigh = ta.barssince(histCrossOverZero)

// サイン判定
isAbove200 = emaLow > ema200
isBelow200 = emaHigh < ema200

longCondition = isAbove200 and macdHist > 0 and barsSincePriceHigh <= lookbackPeriod and barsSinceHistHigh <= lookbackPeriod and (priceCrossOverHigh or histCrossOverZero)
shortCondition = isBelow200 and macdHist < 0 and barsSincePriceLow <= lookbackPeriod and barsSinceHistLow <= lookbackPeriod and (priceCrossUnderLow or histCrossUnderZero)

// --- SL/TP 計算 ---
var float slLine = na
var float tpLine = na

if longCondition
    slLine := emaLow
    tpLine := close + (close - slLine) * rewardRatio
    tpLine
else if shortCondition
    slLine := emaHigh
    tpLine := close - (slLine - close) * rewardRatio
    tpLine
else if low < slLine and close[1] > slLine or high > slLine and close[1] < slLine
    slLine := na
    tpLine := na
    tpLine

// --- 描画 ---
p_high = plot(emaHigh, color = color.new(color.blue, 50), title = 'EMA High')
p_low = plot(emaLow, color = color.new(color.blue, 50), title = 'EMA Low')
fill(p_high, p_low, color = color.new(color.blue, 90), title = 'Channel Fill')
plot(ema200, color = color.red, linewidth = 2, title = 'EMA 200')

plot(slLine, 'Stop Loss', color = color.new(color.red, 0), style = plot.style_linebr, linewidth = 2)
plot(tpLine, 'Take Profit', color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 2)

plotshape(longCondition, style = shape.triangleup, location = location.belowbar, color = color.green, size = size.small, text = 'BUY')
plotshape(shortCondition, style = shape.triangledown, location = location.abovebar, color = color.red, size = size.small, text = 'SELL')

// --- ★アラート条件の定義を追加 ---
alertcondition(longCondition, title = 'Buy Alert', message = 'EMAチャネル: 買いサイン (SL: {{plot_4}}, TP: {{plot_5}})')
alertcondition(shortCondition, title = 'Sell Alert', message = 'EMAチャネル: 売りサイン (SL: {{plot_4}}, TP: {{plot_5}})')
