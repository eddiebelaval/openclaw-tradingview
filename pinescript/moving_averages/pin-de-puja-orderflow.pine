//@version=6
indicator("Pin de Puja US30 V6 - Conexión Única", overlay=true)

// 1. Cálculo de EMAs (9 y 21) - INVISIBLES
ema9 = ta.ema(close, 9)
ema21 = ta.ema(close, 21)

// 2. Filtros de Volumen e Intención
vol_avg = ta.sma(volume, 20)
es_vol_fuerte = volume > vol_avg
es_vol_masivo = volume > (vol_avg * 2)

// 3. Lógica de Cruce (Interna)
cruce_alza = ta.crossover(ema9, ema21)
cruce_baja = ta.crossunder(ema9, ema21)

// 4. Definición de Señales
sig_buy = cruce_alza and es_vol_fuerte and close > open
sig_sell = cruce_baja and es_vol_fuerte and close < open

// 5. Dibujo de "Pin" (Línea + Círculo)
// Usamos el estilo 'arrowup' y 'arrowdown' que ya incluyen una línea de conexión natural
// o configuramos un estilo de círculo con desplazamiento.

// --- COMPRAS (Abajo de la vela) ---
// El círculo normal
plotshape(sig_buy and not es_vol_masivo, title="Compra", style=shape.circle, location=location.belowbar, color=color.new(color.green, 0), size=size.small)
// El círculo masivo (más grande)
plotshape(sig_buy and es_vol_masivo, title="Compra Masiva", style=shape.circle, location=location.belowbar, color=color.new(color.green, 0), size=size.normal)

// --- VENTAS (Arriba de la vela) ---
// El círculo normal
plotshape(sig_sell and not es_vol_masivo, title="Venta", style=shape.circle, location=location.abovebar, color=color.new(color.red, 0), size=size.small)
// El círculo masivo (más grande)
plotshape(sig_sell and es_vol_masivo, title="Venta Masiva", style=shape.circle, location=location.abovebar, color=color.new(color.red, 0), size=size.normal)

// --- LÓGICA DE LA LÍNEA CONECTORA (SOLO EN LA VELA) ---
// Usamos plotchar con un carácter de línea vertical para simular el conector
plotchar(sig_buy, char='|', location=location.belowbar, color=color.new(color.gray, 50), size=size.tiny, offset=0)
plotchar(sig_sell, char='|', location=location.abovebar, color=color.new(color.gray, 50), size=size.tiny, offset=0)

// 6. Alertas
if (sig_buy)
    alert("Cruce Alcista + Volumen en US30", alert.freq_once_per_bar_close)
if (sig_sell)
    alert("Cruce Bajista + Volumen en US30", alert.freq_once_per_bar_close)
