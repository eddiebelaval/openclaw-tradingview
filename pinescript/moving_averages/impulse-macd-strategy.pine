//@version=6
strategy("Impulse MACD Strategy", shorttitle="IMACD_Strat", overlay=false)

lengthMA = input.int(34, "MA Length")
lengthSignal = input.int(9, "Signal Length")
extension_threshold = input.float(5.0, "Extension Threshold")
breakeven_bars = input.int(1, "Break Even Bars")
ema_exit_length = input.int(1, "EMA Length for Exit")
use_supertrend = input.bool(false, "Use SuperTrend Filter")
st_factor = input.float(2.0, "SuperTrend Factor")
st_length = input.int(14, "SuperTrend Length")

calc_smma(src, len) =>
    smma = 0.0
    smma := na(smma[1]) ? ta.sma(src, len) : (smma[1] * (len - 1) + src) / len
    smma

calc_zlema(src, length) =>
    ema1 = ta.ema(src, length)
    ema2 = ta.ema(ema1, length)
    d = ema1 - ema2
    ema1 + d

src = hlc3
hi = calc_smma(high, lengthMA)
lo = calc_smma(low, lengthMA)
mi = calc_zlema(src, lengthMA)

md = (mi > hi) ? (mi - hi) : (mi < lo) ? (mi - lo) : 0
sb = ta.sma(md, lengthSignal)
sh = md - sb
mdc = src > mi ? src > hi ? color.lime : color.green : src < lo ? color.red : color.orange

plot(0, color=color.gray, linewidth=1, title="MidLine")
plot(md, color=mdc, linewidth=2, title="ImpulseMACD", style=plot.style_line)
plot(sh, color=color.aqua, linewidth=2, title="ImpulseHisto", style=plot.style_columns)
plot(sb, color=color.white, linewidth=2, title="ImpulseMACDSignal")
plot(extension_threshold, "Upper Threshold", color=color.green, style=plot.style_linebr)
plot(-extension_threshold, "Lower Threshold", color=color.red, style=plot.style_linebr)

// Choose based on input
macd_line = md
signal_line = sb

// Color phases
color_bull = mdc == color.lime or mdc == color.green
color_bear = mdc == color.orange or mdc == color.red

change_to_bull = color_bull and not color_bull[1]
change_to_bear = color_bear and not color_bear[1]

// SuperTrend
[st, st_dir] = ta.supertrend(st_factor, st_length)

// Phases and extensions
var bool initialized = false
var bool is_color_bull = false
var float bull_max = na
var float bear_min = na
var int entry_bar_index = na

// Initialization
if not initialized and not na(macd_line) and not na(signal_line)
    is_color_bull := color_bull
    initialized := true
    if is_color_bull
        bull_max := macd_line
    else
        bear_min := macd_line

// Update extensions
if initialized and not na(macd_line)
    if is_color_bull
        bull_max := math.max(bull_max, macd_line)
    else
        bear_min := math.min(bear_min, macd_line)

// Entries and resets
long_filter = not use_supertrend or st_dir == -1
short_filter = not use_supertrend or st_dir == 1

if change_to_bull and long_filter
    if initialized and not na(bear_min) and bear_min < -extension_threshold
        label.new(bar_index, 0, "Long Entry", style=label.style_label_up, color=color.green)
        strategy.entry("Long", strategy.long)
        entry_bar_index := bar_index
        bear_min := na
    is_color_bull := true
    bull_max := macd_line

if change_to_bear and short_filter
    if initialized and not na(bull_max) and bull_max > extension_threshold
        label.new(bar_index, 0, "Short Entry", style=label.style_label_down, color=color.red)
        strategy.entry("Short", strategy.short)
        entry_bar_index := bar_index
        bull_max := na
    is_color_bull := false
    bear_min := macd_line

// EMA for exits
ema_exit = ta.ema(close, ema_exit_length)

// Exits on EMA cross
if strategy.position_size > 0
    if close < ema_exit
        strategy.close("Long", comment="Exit Long on EMA Cross")

if strategy.position_size < 0
    if close > ema_exit
        strategy.close("Short", comment="Exit Short on EMA Cross")

// Break even stops after breakeven_bars
if strategy.position_size > 0 and bar_index - entry_bar_index >= breakeven_bars
    strategy.exit("Long BE Exit", "Long", stop=strategy.position_avg_price)

if strategy.position_size < 0 and bar_index - entry_bar_index >= breakeven_bars
    strategy.exit("Short BE Exit", "Short", stop=strategy.position_avg_price)

// Win/Loss Table
var table stats_table = table.new(position.top_right, columns=2, rows=8, bgcolor=color.black, border_width=1, border_color=color.white)

if barstate.islast
    wins = strategy.wintrades
    losses = strategy.losstrades
    total_trades = strategy.closedtrades
    win_rate = total_trades > 0 ? (wins / total_trades) * 100 : 0
    avg_win = wins > 0 ? strategy.grossprofit / wins : 0
    avg_loss = losses > 0 ? strategy.grossloss / losses : 0
    avg_profit = total_trades > 0 ? strategy.netprofit / total_trades : 0

    table.cell(stats_table, 0, 0, "Total Trades", text_color=color.white)
    table.cell(stats_table, 1, 0, str.tostring(total_trades), text_color=color.white)
    
    table.cell(stats_table, 0, 1, "Wins", text_color=color.white)
    table.cell(stats_table, 1, 1, str.tostring(wins), text_color=color.white)
    
    table.cell(stats_table, 0, 2, "Losses", text_color=color.white)
    table.cell(stats_table, 1, 2, str.tostring(losses), text_color=color.white)
    
    table.cell(stats_table, 0, 3, "Win Rate (%)", text_color=color.white)
    table.cell(stats_table, 1, 3, str.tostring(math.round(win_rate, 2)), text_color=color.white)
    
    table.cell(stats_table, 0, 4, "Avg Win", text_color=color.white)
    table.cell(stats_table, 1, 4, str.tostring(math.round(avg_win, 2)), text_color=color.white)
    
    table.cell(stats_table, 0, 5, "Avg Loss", text_color=color.white)
    table.cell(stats_table, 1, 5, str.tostring(math.round(avg_loss, 2)), text_color=color.white)
    
    table.cell(stats_table, 0, 6, "Avg Profit", text_color=color.white)
    table.cell(stats_table, 1, 6, str.tostring(math.round(avg_profit, 2)), text_color=color.white)
    
    table.cell(stats_table, 0, 7, "Net Profit", text_color=color.white)
    table.cell(stats_table, 1, 7, str.tostring(math.round(strategy.netprofit, 2)), text_color=color.white)
