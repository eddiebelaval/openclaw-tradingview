//@version=6
// @Metrify
indicator("Crowd Trap Engine (Exhaustion/Reversal) [Metrify]", shorttitle="Metrify CTE", overlay=true)

// Utility functions
clamp(float v, float lo, float hi) =>
    math.max(lo, math.min(hi, v))

rank_pct(float src, int len) =>
    float r = ta.percentrank(src, len)
    na(r) ? 50.0 : clamp(r, 0.0, 100.0)

// Input parameters
grp_core = "Core",grpcrowd = "Crowd Trigger",grp_vis = "Marker Control"
brkwin_in = input.int(20, "Breakout Window", minval=10, maxval=120, group=grp_core, tooltip="How many bars back the indicator looks to find recent highs and lows.")
atrlen_in = input.int(14, "ATR Length", minval=5, maxval=50, group=grp_core)
pfact = input.float(1.0, "Period Factor", minval=0.1, maxval=5.0, step=0.1, group=grp_core)

consts = input.float(65.0, "Consensus Confirmation", minval=40, maxval=95, step=0.5, group=grpcrowd, tooltip="Acts as a secondary filter measuring how strongly different momentum and trend factors agree.")

showcloud = input.bool(true, "Cloud", group=grp_vis,inline="v")
showbias = input.bool(true, "Bias Line", group=grp_vis,inline="v")
showmark = input.bool(true, "Crowd Mark", group=grp_vis,inline="v")

// Preset configurations
normwin = math.max(60, int(math.round(180 * pfact)))
brkwin = math.max(8, int(math.round(brkwin_in * pfact)))
atrlen = math.max(5, int(math.round(atrlen_in * (0.85 + pfact * 0.15))))

// Coredata 
isconf = barstate.isconfirmed
atrval = ta.atr(atrlen)
atrsafe = math.max(atrval, syminfo.mintick)
rng = math.max(high - low, syminfo.mintick)
bodyeff = math.abs(close - open) / rng

fastlen = math.max(8, int(math.round(18 * pfact)))
slowlen = math.max(21, int(math.round(55 * pfact)))
emafast = ta.ema(close, fastlen)
emaslow = ta.ema(close, slowlen)
svwap = ta.vwap(hlc3)
eq = na(svwap) ? emaslow : (emaslow + svwap) * 0.5

volbaselen = math.max(12, int(math.round(30 * pfact)))
volbase = ta.sma(volume, volbaselen)
volshock = volume / math.max(volbase, 1.0)
vsrank = rank_pct(volshock, normwin)
cerank = rank_pct(bodyeff, normwin)

// Crowd detection
prevh = ta.highest(high, brkwin)[1]
prevl = ta.lowest(low, brkwin)[1]

updist = math.max(close - prevh, 0.0) / atrsafe
dndist = math.max(prevl - close, 0.0) / atrsafe
uprank = rank_pct(updist, normwin)
dnrank = rank_pct(dndist, normwin)

stretch = (close - eq) / atrsafe
str_l = rank_pct(stretch, normwin)
str_s = rank_pct(-stretch, normwin)

rsilen = math.max(8, int(math.round(14 * pfact)))
rsival = ta.rsi(close, rsilen)
[macd_l, macd_s, _] = ta.macd(close, 12, 26, 9)
stoch = ta.stoch(close, high, low, 14)
bblen = math.max(12, int(math.round(20 * pfact)))
bb_basis = ta.sma(close, bblen)
bb_dev = ta.stdev(close, bblen)
upband = bb_basis + (bb_dev * 2.0)
dnband = bb_basis - (bb_dev * 2.0)

lvotes = (close > emafast ? 1.0 : 0.0) +
     (emafast > emaslow ? 1.0 : 0.0) +
     (rsival > 68.0 ? 1.0 : 0.0) +
     (close > prevh ? 1.0 : 0.0) +
     (macd_l > macd_s and macd_l > 0.0 ? 1.0 : 0.0) +
     (close > upband ? 1.0 : 0.0) +
     (volshock > 1.45 ? 1.0 : 0.0) +
     (stoch > 80.0 ? 1.0 : 0.0)

svotes = (close < emafast ? 1.0 : 0.0) +
     (emafast < emaslow ? 1.0 : 0.0) +
     (rsival < 32.0 ? 1.0 : 0.0) +
     (close < prevl ? 1.0 : 0.0) +
     (macd_l < macd_s and macd_l < 0.0 ? 1.0 : 0.0) +
     (close < dnband ? 1.0 : 0.0) +
     (volshock > 1.45 ? 1.0 : 0.0) +
     (stoch < 20.0 ? 1.0 : 0.0)

trig_l = clamp((lvotes / 8.0) * 100.0, 0.0, 100.0)
trig_s = clamp((svotes / 8.0) * 100.0, 0.0, 100.0)

cons_l = clamp(0.75 * trig_l + 0.25 * uprank, 0.0, 100.0)
cons_s = clamp(0.75 * trig_s + 0.25 * dnrank, 0.0, 100.0)

fomo_l = clamp(0.28 * uprank + 0.22 * vsrank + 0.22 * str_l + 0.18 * trig_l + 0.10 * cerank, 0.0, 100.0)
fomo_s = clamp(0.28 * dnrank + 0.22 * vsrank + 0.22 * str_s + 0.18 * trig_s + 0.10 * cerank, 0.0, 100.0)

acc_l = rank_pct(math.max(ta.change(close), 0.0) / atrsafe, normwin)
acc_s = rank_pct(math.max(-ta.change(close), 0.0) / atrsafe, normwin)

ce_l = clamp(0.30 * str_l + 0.25 * trig_l + 0.20 * acc_l + 0.15 * uprank + 0.10 * cons_l, 0.0, 100.0)
ce_s = clamp(0.30 * str_s + 0.25 * trig_s + 0.20 * acc_s + 0.15 * dnrank + 0.10 * cons_s, 0.0, 100.0)

cl_state = ce_l >= 75.0 and fomo_l >= 55.0 and cons_l >= consts
cs_state = ce_s >= 75.0 and fomo_s >= 55.0 and cons_s >= consts

// Cooldown logic (Hardcoded: 8 bars)
var int last_l_bar = na,var int last_s_bar = na
cd_l = na(last_l_bar) or (bar_index - last_l_bar >= 8)
cd_s = na(last_s_bar) or (bar_index - last_s_bar >= 8)

cl_trig = isconf and cl_state and not cl_state[1] and cd_l
cs_trig = isconf and cs_state and not cs_state[1] and cd_s

if cl_trig
    last_l_bar := bar_index
if cs_trig
    last_s_bar := bar_index

// Visual
c_trap_l = color.rgb(0, 184, 148),c_trap_s = color.rgb(214, 48, 49),c_neut = color.rgb(100, 105, 120)

var int last_vbar = na
canplot = na(last_vbar) or (bar_index - last_vbar >= 8)

show_l_mark = canplot and cl_trig
show_s_mark = canplot and not show_l_mark and cs_trig

if show_l_mark or show_s_mark
    last_vbar := bar_index

plotshape(showmark?show_l_mark:false, title="Crowded Up", style=shape.diamond, location=location.abovebar, color=color.new(c_trap_l, 0), size=size.tiny)
plotshape(showmark?show_s_mark:false, title="Crowded Down", style=shape.diamond, location=location.belowbar, color=color.new(c_trap_s, 0), size=size.tiny)

float raw_up = eq + ((math.pow(ce_l / 100.0, 1.5)) * atrsafe * 1.0 * 6.0)
float raw_dn = eq - ((math.pow(ce_s / 100.0, 1.5)) * atrsafe * 1.0 * 6.0)

float sm_up = ta.wma(raw_up, 5)
float sm_dn = ta.wma(raw_dn, 5)
float sm_eq = ta.wma(eq, 5)

// Dynamic coloring based on crowd dominance
float cdom = ta.wma(ce_l - ce_s, 5)
color bias_col = cdom > 15 ? c_trap_l : cdom < -15 ? c_trap_s : c_neut
color cloud_col = cdom > 20 ? color.new(c_trap_l, 85) : cdom < -20 ? color.new(c_trap_s, 85) : color.new(c_neut, 92)

plot(showbias ? sm_eq : na, title="Bias Line Glow Outer", color=color.new(bias_col, 85), linewidth=6)
plot(showbias ? sm_eq : na, title="Bias Line Glow Inner", color=color.new(bias_col, 70), linewidth=4)
p_eq = plot(showbias ? sm_eq : na, title="Crowd Bias Line Core", color=bias_col, linewidth=2)

p_up = plot(showcloud ? sm_up : na, title="Trap Cloud Upper", display=display.none, editable=false)
p_dn = plot(showcloud ? sm_dn : na, title="Trap Cloud Lower", display=display.none, editable=false)
fill(p_up, p_dn, color=showcloud ? cloud_col : na, title="Trap Cloud Area")

// Alerts
alertcondition(cl_trig, "Crowd Up Overload", "Crowd Trap Engine: Crowded upside entries detected.")
alertcondition(cs_trig, "Crowd Down Overload", "Crowd Trap Engine: Crowded downside entries detected.")
