//@version=6

// ══════════════════════════════════════════════════════════════════════════════
// ─── Version ────────────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════
// v1.0 - New indicator
// v1.1 - Updated screenshot for a cleaner screenshot without other indicators 

indicator("Asymmetric Traffic Light", 
     shorttitle = "ATL", 
     overlay = false,
     format = format.price,
     precision = 0)

// ══════════════════════════════════════════════════════════════════════════════
// ─── CONSTANTS ────────────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════

// Regime values for plotting
int REGIME_RED    = 0
int REGIME_ORANGE = 1
int REGIME_YELLOW = 2
int REGIME_GREEN  = 3

// Transition quarantine period
int ORANGE_DURATION = 4

// ══════════════════════════════════════════════════════════════════════════════
// ─── INPUTS ───────────────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════

// ─── Moving Average Settings ───
group_ma = "Moving Average Settings"

int i_smaLongLen = input.int(200, "Long SMA Length", 
     minval = 50, maxval = 500, step = 10,
     group = group_ma,
     tooltip = "Primary trend filter. Default 200 for institutional trend reference.")

int i_smaShortLen = input.int(50, "Short SMA Length", 
     minval = 10, maxval = 100, step = 5,
     group = group_ma,
     tooltip = "Secondary trend filter. Default 50 for intermediate trend.")

int i_slopePeriod = input.int(20, "Slope Lookback", 
     minval = 5, maxval = 50, step = 5,
     group = group_ma,
     tooltip = "Period to measure SMA200 slope direction.")

int i_shortMomentum = input.int(5, "Short MA Momentum Lookback", 
     minval = 1, maxval = 20,
     group = group_ma,
     tooltip = "Bars to compare for SMA50 upward momentum in Green condition.")

// ─── Transition Settings ───
group_trans = "Transition Settings"

int i_orangeBars = input.int(4, "Orange Quarantine Bars", 
     minval = 1, maxval = 10,
     group = group_trans,
     tooltip = "Mandatory waiting period after exiting Red before allowing Green. Prevents whipsaws.")

// ─── Visual Settings ───
group_visual = "Visual Settings"

color i_colorGreen  = input.color(color.new(#00AA00, 0), "Green (Bullish)", group = group_visual)
color i_colorYellow = input.color(color.new(#CCCC00, 0), "Yellow (Neutral)", group = group_visual)
color i_colorOrange = input.color(color.new(#FF8C00, 0), "Orange (Transition)", group = group_visual)
color i_colorRed    = input.color(color.new(#AA0000, 0), "Red (Bearish)", group = group_visual)

bool i_showBgColor = input.bool(true, "Show Background Color", group = group_visual)
bool i_showLabels  = input.bool(true, "Show Regime Labels", group = group_visual)

// ─── Alert Settings ───
group_alerts = "Alert Settings"

bool i_alertGreen  = input.bool(true, "Alert on Green Entry", group = group_alerts)
bool i_alertRed    = input.bool(true, "Alert on Red Entry", group = group_alerts)
bool i_alertOrange = input.bool(true, "Alert on Orange Transition", group = group_alerts)

// ══════════════════════════════════════════════════════════════════════════════
// ─── CALCULATIONS ─────────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════

// ─── Moving Averages ───
float smaLong  = ta.sma(close, i_smaLongLen)
float smaShort = ta.sma(close, i_smaShortLen)

// ─── Slope of Long SMA ───
float slopeSmaLong = smaLong - smaLong[i_slopePeriod]

// ─── Base Conditions ───
bool isRed    = close < smaLong and close < smaShort
bool isGreen  = close > smaLong and slopeSmaLong > 0 and smaShort > smaShort[i_shortMomentum]
bool isYellow = not isGreen and not isRed

// ─── Transition Detection: Red → Non-Red ───
bool redToNonRed = not isRed and isRed[1]

// ─── Orange Counter (Quarantine Period) ───
var int orangeCount = 0

if isRed
    orangeCount := 0
else if redToNonRed
    orangeCount := 1
else if orangeCount > 0 and orangeCount < i_orangeBars
    orangeCount := orangeCount + 1
else
    orangeCount := 0

// ─── Orange Condition ───
bool isOrange = orangeCount > 0 and orangeCount <= i_orangeBars

// ─── Final Regime (Orange has priority over Green) ───
int regime = isOrange ? REGIME_ORANGE : 
             isGreen  ? REGIME_GREEN  : 
             isRed    ? REGIME_RED    : 
             REGIME_YELLOW

// ─── Regime Color ───
color regimeColor = switch regime
    REGIME_GREEN  => i_colorGreen
    REGIME_ORANGE => i_colorOrange
    REGIME_RED    => i_colorRed
    => i_colorYellow

// ─── Regime Text ───
string regimeText = switch regime
    REGIME_GREEN  => "GREEN"
    REGIME_ORANGE => "ORANGE"
    REGIME_RED    => "RED"
    => "YELLOW"

// ══════════════════════════════════════════════════════════════════════════════
// ─── PLOTTING ─────────────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════

// ─── Main Regime Plot ───
plot(regime, "Regime", color = regimeColor, style = plot.style_columns, linewidth = 4)

// ─── Reference Lines ───
hline(REGIME_RED,    "Red Level",    color = color.new(i_colorRed, 70),    linestyle = hline.style_dotted)
hline(REGIME_ORANGE, "Orange Level", color = color.new(i_colorOrange, 70), linestyle = hline.style_dotted)
hline(REGIME_YELLOW, "Yellow Level", color = color.new(i_colorYellow, 70), linestyle = hline.style_dotted)
hline(REGIME_GREEN,  "Green Level",  color = color.new(i_colorGreen, 70),  linestyle = hline.style_dotted)

// ─── Background Color ───
bgcolor(i_showBgColor ? color.new(regimeColor, 85) : na, title = "Regime Background")

// ─── Regime Change Labels ───
bool regimeChanged = regime != regime[1]

if i_showLabels and regimeChanged
    label.new(bar_index, regime, regimeText,
         style = label.style_label_down,
         color = regimeColor,
         textcolor = color.white,
         size = size.small)

// ─── Info Table ───
var table infoTable = table.new(position.top_right, 2, 5, 
     bgcolor = color.new(color.black, 80), 
     border_width = 1,
     border_color = color.gray)

if barstate.islast
    table.cell(infoTable, 0, 0, "Regime", text_color = color.white, text_size = size.small)
    table.cell(infoTable, 1, 0, regimeText, text_color = regimeColor, text_size = size.normal)
    
    table.cell(infoTable, 0, 1, "SMA" + str.tostring(i_smaLongLen), text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 1, str.tostring(smaLong, format.mintick), text_color = color.white, text_size = size.tiny)
    
    table.cell(infoTable, 0, 2, "SMA" + str.tostring(i_smaShortLen), text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 2, str.tostring(smaShort, format.mintick), text_color = color.white, text_size = size.tiny)
    
    table.cell(infoTable, 0, 3, "Slope", text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 3, str.tostring(slopeSmaLong, "#.##"), 
         text_color = slopeSmaLong > 0 ? i_colorGreen : i_colorRed, text_size = size.tiny)
    
    if isOrange
        table.cell(infoTable, 0, 4, "Quarantine", text_color = i_colorOrange, text_size = size.tiny)
        table.cell(infoTable, 1, 4, str.tostring(orangeCount) + "/" + str.tostring(i_orangeBars), 
             text_color = i_colorOrange, text_size = size.tiny)

// ══════════════════════════════════════════════════════════════════════════════
// ─── ALERTS ───────────────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════

// ─── Regime Transition Alerts ───
bool enteredGreen  = regime == REGIME_GREEN  and regime[1] != REGIME_GREEN
bool enteredRed    = regime == REGIME_RED    and regime[1] != REGIME_RED
bool enteredOrange = regime == REGIME_ORANGE and regime[1] != REGIME_ORANGE
bool enteredYellow = regime == REGIME_YELLOW and regime[1] != REGIME_YELLOW

alertcondition(i_alertGreen and enteredGreen, 
     title = "Green Regime", 
     message = "ATL: GREEN regime - Bullish conditions confirmed. Price > SMA200, trend rising.")

alertcondition(i_alertRed and enteredRed, 
     title = "Red Regime", 
     message = "ATL: RED regime - Bearish conditions. Price below both SMAs. Risk off.")

alertcondition(i_alertOrange and enteredOrange, 
     title = "Orange Transition", 
     message = "ATL: ORANGE transition - Exited Red but in quarantine. Wait for confirmation.")

alertcondition(enteredYellow, 
     title = "Yellow Regime", 
     message = "ATL: YELLOW regime - Neutral/mixed conditions. Reduced exposure recommended.")

// ─── Any Regime Change ───
alertcondition(regimeChanged, 
     title = "Any Regime Change", 
     message = "ATL: Regime changed to {{plot_0}}")

    // ══════════════════════════════════════════════════════════════════════════════
// ─── PLOT EXPORTS FOR EXTERNAL USE ────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════

// Numeric regime for external strategies/indicators
plot(regime, "Regime Value", display = display.data_window + display.status_line)

// Boolean outputs for conditional logic
plot(isRed    ? 1 : 0, "Is Red",    display = display.data_window)
plot(isOrange ? 1 : 0, "Is Orange", display = display.data_window)
plot(isYellow ? 1 : 0, "Is Yellow", display = display.data_window)
plot(isGreen  ? 1 : 0, "Is Green",  display = display.data_window)
