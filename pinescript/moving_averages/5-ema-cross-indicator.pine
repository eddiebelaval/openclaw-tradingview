// plotshape(
//      showSignals and wickedLong  and prevCandleAwayLong  and not longSignal  ? ema5 : na,
//      title    = "Away Candle Long",
//      style    = shape.circle,
//      location = location.absolute,
//      color    = color.new(color.aqua, 30),
//      size     = size.tiny
