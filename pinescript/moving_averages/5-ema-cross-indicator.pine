//          text      = "TP  " + str.tostring(shortTP, "#.##"),
//          style     = label.style_label_right,
//          color     = color.new(color.green, 60),
//          textcolor = color.white,
//          size      = size.small
//      )

// ── INFO TABLE ───────────────────────────────────────────────

var table t = table.new(
     position     = position.top_right,
     columns      = 2,
     rows         = 7,
     bgcolor      = color.new(color.black, 75),
     border_width = 1,
     border_color = color.new(color.gray, 60)
 )

if barstate.islast
    hBg   = color.new(color.blue,  70)
    cBg   = color.new(color.black, 80)
    white = color.white
    gray  = color.new(color.gray,  20)

    table.cell(t, 0, 0, "5 EMA STRATEGY",   text_color=white, bgcolor=hBg, text_size=size.small)
    table.cell(t, 1, 0, "Live",              text_color=white, bgcolor=hBg, text_size=size.small)

    table.cell(t, 0, 1, "SL Mode",          text_color=gray,  bgcolor=cBg, text_size=size.small)
    table.cell(t, 1, 1, slMode,              text_color=white, bgcolor=cBg, text_size=size.small)

    table.cell(t, 0, 2, "R:R",              text_color=gray,  bgcolor=cBg, text_size=size.small)
    table.cell(t, 1, 2, "1:" + str.tostring(rrRatio, "#.#"),
         text_color=color.new(color.green, 0), bgcolor=cBg, text_size=size.small)

    table.cell(t, 0, 3, "5 EMA Rule",       text_color=gray,  bgcolor=cBg, text_size=size.small)
    table.cell(t, 1, 3, "No Touch → Cross",
         text_color=color.new(color.aqua, 0), bgcolor=cBg, text_size=size.small)

    table.cell(t, 0, 4, "200 EMA",          text_color=gray,  bgcolor=cBg, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(ema200, "#.##"),
         text_color=color.new(color.blue, 0), bgcolor=cBg, text_size=size.small)

    table.cell(t, 0, 5, "50 EMA",           text_color=gray,  bgcolor=cBg, text_size=size.small)
    table.cell(t, 1, 5, str.tostring(ema50, "#.##"),
         text_color=color.new(color.orange, 0), bgcolor=cBg, text_size=size.small)

    table.cell(t, 0, 6, "5 EMA",            text_color=gray,  bgcolor=cBg, text_size=size.small)
    table.cell(t, 1, 6, str.tostring(ema5, "#.##"),
         text_color=color.new(color.white, 0), bgcolor=cBg, text_size=size.small)

// ── ALERTS ───────────────────────────────────────────────────

alertcondition(longSignal,
     title   = "Long Entry Signal",
     message = "5 EMA LONG — No-touch candle confirmed, 5 EMA crossed UP. Enter Long.")

alertcondition(shortSignal,
     title   = "Short Entry Signal",
     message = "5 EMA SHORT — No-touch candle confirmed, 5 EMA crossed DOWN. Enter Short.")

alertcondition(wickTouchLong,
     title   = "Long Wick Touch Alert",
     message = "ALERT: Wick touched 50 EMA — Wait for candle away from 5 EMA, then cross UP.")

alertcondition(wickTouchShort,
     title   = "Short Wick Touch Alert",
     message = "ALERT: Wick touched 50 EMA — Wait for candle away from 5 EMA, then cross DOWN.")
