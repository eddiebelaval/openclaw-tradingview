// plotshape(
//      showSignals and wickedShort and prevCandleAwayShort and not shortSignal ? ema5 : na,
//      title    = "Away Candle Short",
//      style    = shape.circle,
//      location = location.absolute,
//      color    = color.new(color.fuchsia, 30),
//      size     = size.tiny
//  )

// Entry labels
plotshape(
     showSignals and longSignal  ? low  - (high - low) * 0.5 : na,
     title     = "Long Signal",
     style     = shape.labelup,
     location  = location.absolute,
     color     = color.new(color.green, 0),
     textcolor = color.white,
     size      = size.tiny,
     text      = "L"
 )

plotshape(
     showSignals and shortSignal ? high + (high - low) * 0.5 : na,
     title     = "Short Signal",
     style     = shape.labeldown,
     location  = location.absolute,
     color     = color.new(color.red, 0),
     textcolor = color.white,
     size      = size.tiny,
     text      = "S"
 )

