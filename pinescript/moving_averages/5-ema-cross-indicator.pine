//@version=6
// ============================================================
// 5 EMA Cross Strategy — Indicator
// Description: 200/50/5 EMA zone signals.
//
// 5 EMA Entry Rule (updated):
//   Previous candle must NOT touch the 5 EMA at all
//   (neither body nor wick). Then the NEXT candle crosses
//   the 5 EMA → that is the entry signal.
//
// Full condition chain:
//   1. Price inside 200–50 EMA zone
//   2. Wick of any candle touches 50 EMA (alert W marker)
//   3. After wick touch: a candle stays completely away from
//      5 EMA (no touch at all)
//   4. The very next candle crosses 5 EMA → ENTRY
// ============================================================

indicator(
     title     = "5 EMA Cross Strategy",
     overlay   = true,
     max_bars_back = 500
 )

// ── INPUTS ──────────────────────────────────────────────────

ema200Len = input.int(200, title="200 EMA", group="EMA Settings", inline="emas")
ema50Len  = input.int(50,  title="50 EMA",  group="EMA Settings", inline="emas")
ema5Len   = input.int(5,   title="5 EMA",   group="EMA Settings", inline="emas")

slMode = input.string(
     defval  = "Candle Open",
     title   = "Stop Loss Mode",
     options = ["Candle Open", "Swing High/Low"],
     group   = "Stop Loss",
     tooltip = "Candle Open: SL at entry candle open.\nSwing High/Low: SL at previous swing low (long) or swing high (short)."
 )

swingLookback = input.int(
     defval  = 10,
     title   = "Swing Lookback Bars",
     group   = "Stop Loss",
     minval  = 3,
     maxval  = 50,
     tooltip = "Bars before entry candle used to find swing high/low."
 )

rrRatio = input.float(
     defval  = 5.0,
     title   = "R:R Ratio",
     group   = "Risk / Reward",
     minval  = 1.0,
     step    = 0.5,
     tooltip = "TP = entry +/- (SL distance x this ratio)."
 )

showEMAs    = input.bool(true,  title="Show EMA Lines",     group="Display")
showZone    = input.bool(true,  title="Shade EMA Zone",     group="Display")
showSignals = input.bool(true,  title="Show Entry Labels",  group="Display")
showLevels  = input.bool(true,  title="Show SL / TP Lines", group="Display")

// ── CALCULATIONS ────────────────────────────────────────────

ema200 = ta.ema(close, ema200Len)
ema50  = ta.ema(close, ema50Len)
ema5   = ta.ema(close, ema5Len)

// ── STEP 1: 50 EMA Wick Touch (alert trigger) ──
wickTouchLong  = low  <= ema50 and close > ema50 and close > ema200
wickTouchShort = high >= ema50 and close < ema50 and close < ema200

var bool wickedLong  = false
var bool wickedShort = false

if wickTouchLong
    wickedLong  := true
    wickedShort := false

if wickTouchShort
    wickedShort := true
    wickedLong  := false

// ── STEP 2: Previous candle must NOT touch 5 EMA at all ──
// Long  setup: previous candle entirely BELOW 5 EMA (high[1] < ema5[1])
// Short setup: previous candle entirely ABOVE 5 EMA (low[1]  > ema5[1])
prevCandleAwayLong  = high[1] < ema5[1]
prevCandleAwayShort = low[1]  > ema5[1]

// ── STEP 3: Current candle crosses the 5 EMA ──
crosses5Up   = ta.crossover(close,  ema5)
crosses5Down = ta.crossunder(close, ema5)

// ── FINAL SIGNALS ──
longSignal  = wickedLong  and prevCandleAwayLong  and crosses5Up   and close > ema200
shortSignal = wickedShort and prevCandleAwayShort and crosses5Down and close < ema200

if longSignal
    wickedLong  := false
if shortSignal
    wickedShort := false

// ── SL / TP LEVELS ──────────────────────────────────────────

prevSwingLow  = ta.lowest(low[1],  swingLookback)
prevSwingHigh = ta.highest(high[1], swingLookback)
tickSize      = syminfo.mintick

calcSL(isLong) =>
    slMode == "Candle Open"
         ? open
         : isLong ? prevSwingLow - tickSize : prevSwingHigh + tickSize

longSL  = longSignal  ? calcSL(true)  : na
longTP  = longSignal  ? close + math.abs(close - calcSL(true))  * rrRatio : na
shortSL = shortSignal ? calcSL(false) : na
shortTP = shortSignal ? close - math.abs(close - calcSL(false)) * rrRatio : na

var float activeSL = na
var float activeTP = na
var bool  inLong   = false
var bool  inShort  = false

if longSignal
    activeSL := longSL
    activeTP := longTP
    inLong   := true
    inShort  := false

if shortSignal
    activeSL := shortSL
    activeTP := shortTP
    inShort  := true
    inLong   := false

// ── PLOTS ────────────────────────────────────────────────────

plot(showEMAs ? ema200 : na, title="200 EMA", color=color.new(color.blue,   0), linewidth=2)
plot(showEMAs ? ema50  : na, title="50 EMA",  color=color.new(color.orange, 0), linewidth=2)
plot(showEMAs ? ema5   : na, title="5 EMA",   color=color.new(color.white,  0), linewidth=1)

p200 = plot(showZone ? ema200 : na, display=display.none, title="Z-200")
p50  = plot(showZone ? ema50  : na, display=display.none, title="Z-50")
fill(p200, p50,
     color = close > ema200
             ? color.new(color.teal, 88)
             : color.new(color.red,  88),
     title = "EMA Zone"
 )

