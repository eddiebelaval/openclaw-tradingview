//@version=6
indicator("Trend Bias + Strength + RSI + FIXED Daily Pivots (Variable EMAs)", overlay = true)

// ────────────────────────────────────────
// Inputs
// ────────────────────────────────────────
emaFastLen = input.int(20,  title = "Fast EMA Length", minval = 1)
emaSlowLen = input.int(100, title = "Slow EMA Length", minval = 1)
volEmaLen  = input.int(20,  title = "Volume EMA Length", minval = 1)
rsiLen     = input.int(14,  title = "RSI Length", minval = 1)
rsiOB      = input.int(70,  title = "RSI Overbought Level")
rsiOS      = input.int(30,  title = "RSI Oversold Level")

// ────────────────────────────────────────
// EMA Calculations
// ────────────────────────────────────────
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

// Trend Conditions
isUptrend   = close > emaFast and emaFast > emaSlow
isDowntrend = close < emaFast and emaFast < emaSlow
isRanging   = not isUptrend and not isDowntrend

// ────────────────────────────────────────
// Volume Strength
// ────────────────────────────────────────
volEma = ta.ema(volume, volEmaLen)
volRatio = volume / volEma

volumeLow  = volRatio < 0.8
volumeMed  = volRatio >= 0.8 and volRatio <= 1.2
volumeHigh = volRatio > 1.2

buyersHigh = isUptrend   and volumeHigh
sellersHigh = isDowntrend and volumeHigh
buyersMed  = isUptrend   and volumeMed
sellersMed  = isDowntrend and volumeMed
buyersLow  = isUptrend   and volumeLow
sellersLow  = isDowntrend and volumeLow

// ────────────────────────────────────────
// RSI + Status
// ────────────────────────────────────────
rsi = ta.rsi(close, rsiLen)

string rsiStatus = ""
color rsiColor = color.gray

if rsi > rsiOB
    rsiStatus := "RSI Overbought"
    rsiColor := color.red
else if rsi < rsiOS
    rsiStatus := "RSI Oversold"
    rsiColor := color.green
else
    rsiStatus := "RSI Neutral"
    rsiColor := color.gray

// ────────────────────────────────────────
// FIXED DAILY Pivot Levels (always previous daily candle)
// ────────────────────────────────────────
float ph = request.security(syminfo.tickerid, "D", high[1],   lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_off)
float pl = request.security(syminfo.tickerid, "D", low[1],    lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_off)
float pc = request.security(syminfo.tickerid, "D", close[1],  lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_off)

dailyPP   = (ph + pl + pc) / 3
dailyR1   = dailyPP * 2 - pl
dailyS1   = dailyPP * 2 - ph
dailyR2   = dailyPP + (ph - pl)
dailyS2   = dailyPP - (ph - pl)

// ────────────────────────────────────────
// Visuals
// ────────────────────────────────────────

// Background color for trend
bgcolor(isUptrend   ? color.new(color.green, 90) : na)
bgcolor(isDowntrend ? color.new(color.red,   90) : na)
bgcolor(isRanging   ? color.new(color.gray,  90) : na)

// EMA lines
plot(emaFast, "Fast EMA",  color = color.blue, linewidth = 2)
plot(emaSlow, "Slow EMA", color = color.orange, linewidth = 2)

// FIXED Daily Pivot Levels (only latest day visible)
pCol = color.new(color.purple, 50)
plot(barstate.islast ? dailyPP : na,  "Daily PP",  color = pCol, linewidth = 2, style = plot.style_linebr)
plot(barstate.islast ? dailyR1 : na,  "Daily R1",  color = pCol, linewidth = 2)
plot(barstate.islast ? dailyS1 : na,  "Daily S1",  color = pCol, linewidth = 2)
plot(barstate.islast ? dailyR2 : na,  "Daily R2",  color = pCol, linewidth = 2, style = plot.style_linebr)
plot(barstate.islast ? dailyS2 : na,  "Daily S2",  color = pCol, linewidth = 2, style = plot.style_linebr)

// Pivot Labels - ZERO offset, directly at price level for perfect alignment
var label ppLabel = na
var label r1Label = na
var label s1Label = na
var label r2Label = na
var label s2Label = na

label.delete(ppLabel[1])
label.delete(r1Label[1])
label.delete(s1Label[1])
label.delete(r2Label[1])
label.delete(s2Label[1])

if barstate.islast
    ppLabel := label.new(
        bar_index, 
        dailyPP,                           // ← ZERO offset - exact price level
        "PP: " + str.tostring(math.round(dailyPP, 2)),
        xloc = xloc.bar_index,
        yloc = yloc.price,
        color = color.purple,
        textcolor = color.white,
        style = label.style_label_left,    // left-aligned to avoid covering the line
        size = size.small
    )
    r1Label := label.new(bar_index, dailyR1, "R1: " + str.tostring(math.round(dailyR1, 2)), xloc = xloc.bar_index, yloc = yloc.price, color = color.purple, textcolor = color.white, style = label.style_label_left, size = size.small)
    s1Label := label.new(bar_index, dailyS1, "S1: " + str.tostring(math.round(dailyS1, 2)), xloc = xloc.bar_index, yloc = yloc.price, color = color.purple, textcolor = color.white, style = label.style_label_left, size = size.small)
    r2Label := label.new(bar_index, dailyR2, "R2: " + str.tostring(math.round(dailyR2, 2)), xloc = xloc.bar_index, yloc = yloc.price, color = color.purple, textcolor = color.white, style = label.style_label_left, size = size.small)
    s2Label := label.new(bar_index, dailyS2, "S2: " + str.tostring(math.round(dailyS2, 2)), xloc = xloc.bar_index, yloc = yloc.price, color = color.purple, textcolor = color.white, style = label.style_label_left, size = size.small)

// Main Label - bottom-right, solid color background + white text
var label mainLabel = na
label.delete(mainLabel[1])

string mainText = ""
color labelBgColor = color.white

if isUptrend
    mainText := "UPTREND"
    labelBgColor := color.green
else if isDowntrend
    mainText := "DOWNTREND"
    labelBgColor := color.red
else
    mainText := "RANGING / NO TREND"
    labelBgColor := color.gray

string strengthText = ""
if buyersHigh
    strengthText := "\nBuyers High (Vol ↑)"
else if sellersHigh
    strengthText := "\nSellers High (Vol ↑)"
else if buyersMed
    strengthText := "\nBuyers Med (Vol ~)"
else if sellersMed
    strengthText := "\nSellers Med (Vol ~)"
else if buyersLow
    strengthText := "\nBuyers Low (Vol ↓)"
else if sellersLow
    strengthText := "\nSellers Low (Vol ↓)"

mainText += strengthText + "\n" + rsiStatus

if barstate.islast
    mainLabel := label.new(
        bar_index + 5,               // right side
        low - ta.tr * 6.0,           // bottom area
        mainText,
        xloc = xloc.bar_index,
        yloc = yloc.price,
        color = labelBgColor,        // solid green/red/gray
        textcolor = color.white,     // white text
        style = label.style_label_upper_right,
        size = size.normal,
        textalign = text.align_right
    )

// Subtle RSI extreme tint
bgcolor(rsi > rsiOB ? color.new(color.red, 95) : na)
bgcolor(rsi < rsiOS ? color.new(color.green, 95) : na)
