//@version=5
indicator("Swift Algo PRO – BOS + Reteste", overlay=true)

// ==========================
// INPUTS
// ==========================
emaFastLen = input.int(9, "EMA Rápida")
emaSlowLen = input.int(21, "EMA Lenta")
trendLen = input.int(50, "EMA Tendência")

rsiLen = input.int(14, "RSI")

rr = input.float(2.0, "Risco x Retorno")

pivotLen = input.int(3, "Força do Swing")
maxRetestBars = input.int(6, "Máx candles p/ Reteste")

boxLength = input.int(25, "Tamanho das caixas")

// ==========================
// INDICADORES
// ==========================
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
emaTrend = ta.ema(close, trendLen)

rsiVal = ta.rsi(close, rsiLen)

// ==========================
// PLOTS
// ==========================
plot(emaFast, color=color.orange)
plot(emaSlow, color=color.blue)
plot(emaTrend, color=color.purple, linewidth=2)

// ==========================
// SWINGS
// ==========================
swingHigh = ta.pivothigh(high, pivotLen, pivotLen)
swingLow = ta.pivotlow(low, pivotLen, pivotLen)

var float lastHigh = na
var float lastLow = na

if not na(swingHigh)
    lastHigh := swingHigh

if not na(swingLow)
    lastLow := swingLow

// ==========================
// BOS
// ==========================
bosBull = not na(lastHigh) and close > lastHigh
bosBear = not na(lastLow) and close < lastLow

// ==========================
// CONTROLE
// ==========================
var bool waitBullRetest = false
var bool waitBearRetest = false

var bool tradedBull = false
var bool tradedBear = false

var int bullBars = 0
var int bearBars = 0

if bosBull
    waitBullRetest := true
    tradedBull := false
    bullBars := 0

if bosBear
    waitBearRetest := true
    tradedBear := false
    bearBars := 0

if waitBullRetest
    bullBars += 1

if waitBearRetest
    bearBars += 1

if bullBars > maxRetestBars
    waitBullRetest := false

if bearBars > maxRetestBars
    waitBearRetest := false

// ==========================
// ENTRADAS
// ==========================
bullEntry =
     waitBullRetest and
     not tradedBull and
     low <= emaFast and
     close > emaFast and
     rsiVal > 50 and
     close > emaTrend

bearEntry =
     waitBearRetest and
     not tradedBear and
     high >= emaFast and
     close < emaFast and
     rsiVal < 50 and
     close < emaTrend

if bullEntry
    tradedBull := true
    waitBullRetest := false

if bearEntry
    tradedBear := true
    waitBearRetest := false

// ==========================
// STOP / TP
// ==========================
buyStop = low
sellStop = high

buyTP = close + (close - buyStop) * rr
sellTP = close - (sellStop - close) * rr

// ==========================
// SINAIS
// ==========================
plotshape(
     bullEntry,
     style=shape.labelup,
     text="BUY",
     location=location.belowbar,
     color=color.green,
     textcolor=color.white)

plotshape(
     bearEntry,
     style=shape.labeldown,
     text="SELL",
     location=location.abovebar,
     color=color.red,
     textcolor=color.white)

// ==========================
// TRADE BOXES
// ==========================
var box riskBox = na
var box rewardBox = na

if bullEntry

    riskBox :=
         box.new(
         bar_index,
         close,
         bar_index + boxLength,
         buyStop,
         bgcolor=color.new(color.red,85),
         border_color=color.red)

    rewardBox :=
         box.new(
         bar_index,
         buyTP,
         bar_index + boxLength,
         close,
         bgcolor=color.new(color.green,85),
         border_color=color.green)

if bearEntry

    riskBox :=
         box.new(
         bar_index,
         sellStop,
         bar_index + boxLength,
         close,
         bgcolor=color.new(color.red,85),
         border_color=color.red)

    rewardBox :=
         box.new(
         bar_index,
         close,
         bar_index + boxLength,
         sellTP,
         bgcolor=color.new(color.green,85),
         border_color=color.green)

// ==========================
// ALERTAS
// ==========================
alertcondition(
     bullEntry,
     title="BUY",
     message="Swift Algo BUY")

alertcondition(
     bearEntry,
     title="SELL",
     message="Swift Algo SELL")
