//@version=6
indicator("1H Trigger Candle", shorttitle="1h Trigger", overlay=true)

// Inputs
htf           = input.timeframe("60", "Higher Timeframe")
ema_len       = input.int(20, "EMA Period", minval=1)
macd_fast     = input.int(12, "MACD Fast")
macd_slow     = input.int(26, "MACD Slow")
macd_sig      = input.int(9, "MACD Signal")
show_arrows   = input.bool(true, "Show arrows")
bull_color    = input.color(color.green, "Long arrow color")
bear_color    = input.color(color.red, "Short arrow color")

// ────────────────────────────────────────
// Fetch 1H data with gaps=on → values only on HTF close bars
// ────────────────────────────────────────
[h_o, h_h, h_l, h_c, h_v] = request.security(syminfo.tickerid, htf, [open, high, low, close, volume], gaps=barmerge.gaps_on)

h_v_prev = request.security(syminfo.tickerid, htf, volume[1], gaps=barmerge.gaps_on)

// ────────────────────────────────────────
// 1H Indicators (also only non-na on HTF close)
// ────────────────────────────────────────
ema_htf = request.security(syminfo.tickerid, htf, ta.ema(close, ema_len), gaps=barmerge.gaps_on)

[macdLine, signalLine, _] = request.security(syminfo.tickerid, htf, ta.macd(close, macd_fast, macd_slow, macd_sig), gaps=barmerge.gaps_on)

// ────────────────────────────────────────
// Candle structure — only calculated when HTF data exists (non-na)
// ────────────────────────────────────────
isBull      = h_c > h_o
isBear      = h_c < h_o
body        = math.abs(h_c - h_o)
upperWick   = h_h - math.max(h_o, h_c)
lowerWick   = math.min(h_o, h_c) - h_l

// Conditions — evaluated only on HTF close bars
volUp = h_v > h_v_prev

bull_ok = isBull and volUp and h_c > ema_htf and signalLine > 0 and body > upperWick
bear_ok = isBear and volUp and h_c < ema_htf and signalLine < 0 and body > lowerWick

// Trigger = true exactly on the bars where HTF candle closed and met conditions
long_trigger  = not na(h_c) and bull_ok
short_trigger = not na(h_c) and bear_ok

// Faint line to satisfy "must have plot" rule
plot(ema_htf, "1H EMA (faint)", color.new(color.blue, 90), 1)

// Arrows — appear directly on the trigger 1H candle's position
plotshape(show_arrows and long_trigger,
     title    = "Long Trigger",
     style    = shape.arrowup,
     location = location.belowbar,
     color    = bull_color,
     size     = size.small)

plotshape(show_arrows and short_trigger,
     title    = "Short Trigger",
     style    = shape.arrowdown,
     location = location.abovebar,
     color    = bear_color,
     size     = size.small)

// Alerts (fire when the HTF candle closes with conditions met)
alertcondition(long_trigger,  title="1H Long Trigger",  message="1H Long Trigger: Vol ↑ | Above EMA | MACD Sig >0 | Body > Upper Wick")
alertcondition(short_trigger, title="1H Short Trigger", message="1H Short Trigger: Vol ↑ | Below EMA | MACD Sig <0 | Body > Lower Wick")
