//@version=5
indicator("24k Scalp Trigger: EMA Engulfing", overlay=true)

// Inputs
emaLength = input.int(21, "EMA Length")
ema9Length = input.int(9, "Fast EMA Length")

// Indicators
ema21 = ta.ema(close, emaLength)
ema9 = ta.ema(close, ema9Length)
plot(ema21, color=color.blue, title="EMA 21", linewidth=2)
plot(ema9, color=color.yellow, title="EMA 9", linewidth=1)

// Engulfing Logic
isBullishEngulfing = close > open[1] and open < close[1] and close > open
isBearishEngulfing = close < open[1] and open > close[1] and close < open

// EMA Touch Logic (Checks if high/low of candle is near the EMA)
nearEMA = (low <= ema21 and high >= ema21)

// Entry Signals
longSignal = isBullishEngulfing and nearEMA and close > ema21
shortSignal = isBearishEngulfing and nearEMA and close < ema21

// Plotting Arrows
plotshape(longSignal, title="Buy Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="BUY")
plotshape(shortSignal, title="Sell Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL")

// Alerts
alertcondition(longSignal, title="Buy Scalp Alert", message="Bullish Engulfing at EMA 21!")
alertcondition(shortSignal, title="Sell Scalp Alert", message="Bearish Engulfing at EMA 21!")
