// --- SR Styling ---
grpStyle = "SR Levels: Visuals"
styleMode = input.string("Zones", "Mode", ["Lines", "Zones"], group = grpStyle)
zoneSize = input.float(1.0, "Zone Width", minval = 0.1, maxval = 10, step = 0.1, group = grpStyle)
zoneSizeATR = zoneSize * 0.075
supportColor = input.color(color.new(#089981, 80), "Sup Color", group = grpStyle, inline="c1")
resistanceColor = input.color(color.new(#f23645, 80), "Res Color", group = grpStyle, inline="c1")
textColor = input.color(color.new(#ffffff, 30), "Text Color", group = grpStyle)
inverseBrokenLineColor = input.bool(true, "Inverse on Break", group = grpStyle)
srLineWidth = input.int(2, "Line Width", minval=1, group=grpStyle)
srLineStyleInput = input.string("Solid", "Line Style", ["Solid", "Dotted", "Dashed"], group=grpStyle)
srTextSizeInput = input.string("Normal", "Text Size", ["Tiny", "Small", "Normal", "Large"], group=grpStyle)

srLineStyle = srLineStyleInput == "Dotted" ? line.style_dotted : srLineStyleInput == "Dashed" ? line.style_dashed : line.style_solid
srTextSize = srTextSizeInput == "Tiny" ? size.tiny : srTextSizeInput == "Small" ? size.small : srTextSizeInput == "Large" ? size.large : size.normal

// ════════════════════════════════════════════════════════════════════════════════════════════════════════
// 2. THE CUSTOM MA STACK
// ════════════════════════════════════════════════════════════════════════════════════════════════════════

// JMA Function
f_jma(_src, _len, _phase, _power) =>
    float phaseRatio = _phase < -100 ? 0.5 : _phase > 100 ? 2.5 : _phase / 100 + 1.5
    float beta = 0.45 * (_len - 1) / (0.45 * (_len - 1) + 2)
    float alpha = math.pow(beta, _power)
    var float e0 = 0.0, var float e1 = 0.0, var float e2 = 0.0, var float jma = 0.0
    e0 := (1 - alpha) * _src + alpha * nz(e0[1])
    e1 := (_src - e0) * (1 - beta) + beta * nz(e1[1])
    e2 := (e0 + phaseRatio * e1 - nz(jma[1])) * math.pow(1 - alpha, 2) + math.pow(alpha, 2) * nz(e2[1])
    jma := e2 + nz(jma[1])
    jma

// --- Current Timeframe ---
grpCur = "Stack: Current Timeframe"
show_c_ema = input.bool(true, "EMA", inline="c1", group=grpCur)
len_c_ema  = input.int(21, "Len", inline="c1", group=grpCur)
col_c_ema  = input.color(color.yellow, "", inline="c1", group=grpCur)
wid_c_ema  = input.int(1, "Width", minval=1, inline="c1", group=grpCur)

show_c_jma = input.bool(true, "JMA", inline="c2", group=grpCur)
len_c_jma  = input.int(7, "Len", inline="c2", group=grpCur)
col_c_jma  = input.color(color.lime, "", inline="c2", group=grpCur)
wid_c_jma  = input.int(1, "Width", minval=1, inline="c2", group=grpCur)
ph_c_jma   = input.int(100, "Phase", inline="c2b", group=grpCur)
pow_c_jma  = input.float(2.0, "Power", inline="c2b", group=grpCur)

show_c_sma = input.bool(false, "SMA", inline="c3", group=grpCur)
len_c_sma  = input.int(200, "Len", inline="c3", group=grpCur)
col_c_sma  = input.color(color.blue, "", inline="c3", group=grpCur)
wid_c_sma  = input.int(2, "Width", minval=1, inline="c3", group=grpCur)

// --- Higher Timeframe ---
grpHTF = "Stack: Higher Timeframe (HTF)"
htf_tf     = input.timeframe("5", "Timeframe", group=grpHTF)

show_h_ema = input.bool(true, "EMA 1", inline="h1", group=grpHTF)
len_h_ema  = input.int(21, "Len", inline="h1", group=grpHTF)
col_h_ema  = input.color(color.orange, "", inline="h1", group=grpHTF)
wid_h_ema  = input.int(2, "Width", minval=1, inline="h1", group=grpHTF)

show_h_ema2 = input.bool(true, "EMA 2", inline="h1b", group=grpHTF)
len_h_ema2  = input.int(50, "Len", inline="h1b", group=grpHTF)
col_h_ema2  = input.color(color.purple, "", inline="h1b", group=grpHTF)
wid_h_ema2  = input.int(2, "Width", minval=1, inline="h1b", group=grpHTF)

show_h_jma = input.bool(true, "JMA", inline="h2", group=grpHTF)
len_h_jma  = input.int(7, "Len", inline="h2", group=grpHTF)
col_h_jma  = input.color(color.green, "", inline="h2", group=grpHTF)
wid_h_jma  = input.int(2, "Width", minval=1, inline="h2", group=grpHTF)
ph_h_jma   = input.int(100, "Phase", inline="h2b", group=grpHTF)
pow_h_jma  = input.float(2.0, "Power", inline="h2b", group=grpHTF)

show_h_sma = input.bool(true, "SMA", inline="h3", group=grpHTF)
