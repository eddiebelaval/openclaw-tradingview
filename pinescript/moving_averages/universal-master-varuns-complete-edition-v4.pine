// 1. ADVANCED SR LEVELS
// ════════════════════════════════════════════════════════════════════════════════════════════════════════
const bool DEBUG = false
const bool fixSRs = true
const int maxSRInfoListSize = 10
const int maxBarInfoListSize = 5000 
const int maxDistanceToLastBar = 500
const int minSRSize = 5
const float tooCloseATR = 1.0 / 12.0 
const int labelOffsetBars = 20

// --- SR Settings ---
grpSR = "SR Levels: Configuration"
srPivotLength = input.int(10, "Pivot Length", minval = 3, maxval = 50, group = grpSR)
srStrength = input.int(1, "Strength", [1, 2, 3], group = grpSR)
srInvalidation = input.string("Close", "Invalidation", ["Wick", "Close"], group = grpSR)
expandZones = input.string("Only Valid", "Expand", options = ["All", "Only Valid", "None"], group = grpSR)
showInvalidated = input.bool(false, "Show Invalidated", group = grpSR)

// --- NEW FILTER INPUT ---
useRangeFilter = input.bool(false, "Hide SR Inside Chop (Pre/Yest)", group=grpSR, tooltip="Hides SR levels that are stuck inside Yesterday's Range or Today's Premarket Range.")
// ------------------------

// --- SR Timeframes ---
grpTF = "SR Levels: Timeframes"
timeframe1Enabled = input.bool(false, "TF 1", group = grpTF, inline="tf1")
timeframe1 = input.timeframe("5", "", group = grpTF, inline="tf1")
timeframe2Enabled = input.bool(true, "TF 2", group = grpTF, inline="tf2")
timeframe2 = input.timeframe("15", "", group = grpTF, inline="tf2")
timeframe3Enabled = input.bool(true, "TF 3", group = grpTF, inline="tf3")
timeframe3 = input.timeframe("60", "", group = grpTF, inline="tf3")
timeframe4Enabled = input.bool(true, "TF 4", group = grpTF, inline="tf4")
