wid_vwap   = input.int(1, "Width", inline="v", group=grpExtra)

// CALCULATION
v_c_ema = ta.ema(close, len_c_ema)
v_c_jma = f_jma(close, len_c_jma, ph_c_jma, pow_c_jma)
v_c_sma = ta.sma(close, len_c_sma)

v_h_ema  = request.security(syminfo.tickerid, htf_tf, ta.ema(close, len_h_ema))
v_h_ema2 = request.security(syminfo.tickerid, htf_tf, ta.ema(close, len_h_ema2))
v_h_jma  = request.security(syminfo.tickerid, htf_tf, f_jma(close, len_h_jma, ph_h_jma, pow_h_jma))
v_h_sma  = request.security(syminfo.tickerid, htf_tf, ta.sma(close, len_h_sma))

plot(show_c_ema ? v_c_ema : na, "Current EMA", col_c_ema, wid_c_ema)
plot(show_c_jma ? v_c_jma : na, "Current JMA", col_c_jma, wid_c_jma)
plot(show_c_sma ? v_c_sma : na, "Current SMA", col_c_sma, wid_c_sma)

plot(show_h_ema ? v_h_ema : na, "HTF EMA 1", col_h_ema, wid_h_ema)
plot(show_h_ema2 ? v_h_ema2 : na, "HTF EMA 2", col_h_ema2, wid_h_ema2)
plot(show_h_jma ? v_h_jma : na, "HTF JMA", col_h_jma, wid_h_jma, plot.style_circles)
plot(show_h_sma ? v_h_sma : na, "HTF SMA", col_h_sma, wid_h_sma, plot.style_circles)

plot(show_vwap ? ta.vwap(close) : na, "VWAP", col_vwap, wid_vwap)

