// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=5

indicator("PhunkiClouds", "PhunkiClouds", overlay=true)

// --- Inputs ---
matype      = input.string("EMA", "MA Type", options=["EMA", "SMA"])
src         = input.source(hl2, "Source")
showLine    = input.bool(false, "Display EMA Lines")
leading     = input.int(0, "Leading Period (Offset)", minval=0)

// Cloud Visibility Toggles
ema1_on = input.bool(true, "Show Cloud 1 (13/14)")
ema2_on = input.bool(true, "Show Cloud 2 (9/21)")
ema3_on = input.bool(true, "Show Cloud 3 (50/63)")
ema4_on = input.bool(true, "Show Cloud 4 (180/200)")

// 200 SMA Toggle
show200Sma = input.bool(true, "Show 200 SMA (White Dotted)", group="Extra Indicators")

// --- Length Inputs ---
len1s = input.int(13, "C1 Short", group="Lengths"),   len1l = input.int(14, "C1 Long", group="Lengths")
len2s = input.int(9, "C2 Short", group="Lengths"),    len2l = input.int(21, "C2 Long", group="Lengths")
len3s = input.int(50, "C3 Short", group="Lengths"),   len3l = input.int(63, "C3 Long", group="Lengths")
len4s = input.int(180, "C4 Short", group="Lengths"),  len4l = input.int(200, "C4 Long", group="Lengths")

// --- MA Function ---
f_ma(len) =>
    matype == "EMA" ? ta.ema(src, len) : ta.sma(src, len)

// --- Calculations ---
m1s = f_ma(len1s), m1l = f_ma(len1l)
m2s = f_ma(len2s), m2l = f_ma(len2l)
m3s = f_ma(len3s), m3l = f_ma(len3l)
m4s = f_ma(len4s), m4l = f_ma(len4l)


// --- Color Logic ---
c1 = m1s >= m1l ? #036103 : #880e4f
c2 = m2s >= m2l ? #4caf50 : #f44336
c3 = m3s >= m3l ? #2196f3 : #ffb74d
c4 = m4s >= m4l ? #009688 : #f06292



// --- 200 SMA Calculation ---
sma200 = ta.sma(close, 200)

// --- 200 SMA Plot ---
// Using explicit 'display' logic to ensure the compiler recognizes the function
plot(show200Sma ? sma200 : na, "200 SMA", color=color.white, style=plot.style_linebr, linewidth=3, offset=leading)

// Short Plots
p1s = plot(ema1_on ? m1s : na, color=showLine ? (m1s >= m1s[1] ? color.olive : color.maroon) : color.new(color.white, 100), offset=leading)
p2s = plot(ema2_on ? m2s : na, color=showLine ? (m2s >= m2s[1] ? color.olive : color.maroon) : color.new(color.white, 100), offset=leading)
p3s = plot(ema3_on ? m3s : na, color=showLine ? (m3s >= m3s[1] ? color.olive : color.maroon) : color.new(color.white, 100), offset=leading)
p4s = plot(ema4_on ? m4s : na, color=showLine ? (m4s >= m4s[1] ? color.olive : color.maroon) : color.new(color.white, 100), offset=leading)

// Long Plots
p1l = plot(ema1_on ? m1l : na, color=showLine ? (m1l >= m1l[1] ? color.green : color.red) : color.new(color.white, 100), offset=leading, linewidth=2)
p2l = plot(ema2_on ? m2l : na, color=showLine ? (m2l >= m2l[1] ? color.green : color.red) : color.new(color.white, 100), offset=leading, linewidth=2)
p3l = plot(ema3_on ? m3l : na, color=showLine ? (m3l >= m3l[1] ? color.green : color.red) : color.new(color.white, 100), offset=leading, linewidth=2)
p4l = plot(ema4_on ? m4l : na, color=showLine ? (m4l >= m4l[1] ? color.green : color.red) : color.new(color.white, 100), offset=leading, linewidth=2)

// --- Cloud Fills ---
fill(p1s, p1l, color.new(c1, 45), "Cloud 1")
fill(p2s, p2l, color.new(c2, 65), "Cloud 2")
fill(p3s, p3l, color.new(c3, 70), "Cloud 3")
fill(p4s, p4l, color.new(c4, 65), "Cloud 4")
