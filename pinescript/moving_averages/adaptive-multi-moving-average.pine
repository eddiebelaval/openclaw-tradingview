//@version=6
indicator("Adaptive Multi Moving Average",
     shorttitle = "Adaptive MA",
     overlay    = true)

// ═══════════════════════════════════════════════════════════════════
//  ADAPTIVE MULTI MOVING AVERAGE
//  Blends SMA, EMA, WMA, RMA, HMA, ALMA, VWMA
//  into one smooth, adaptive moving average.
//
//  Modes:
//   Equal Blend  -  All 7 MAs averaged equally
//   Adaptive     -  MA closest to price gets higher weight (auto)
//   Custom Blend -  You decide the weight of each MA
// ═══════════════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────────────
// CORE SETTINGS
// ───────────────────────────────────────────────────────────────────
srcType  = input.string("Close", "Source",
     options = ["Close","Open","High","Low","HL2","HLC3","OHLC4","HLC3W"],
     group   = "Core Settings",
     tooltip = "HL2=(H+L)/2  HLC3=(H+L+C)/3  OHLC4=(O+H+L+C)/4  HLC3W=(H+L+C+C)/4")

src = srcType == "Close" ? close : srcType == "Open" ? open : srcType == "High" ? high : srcType == "Low" ? low : srcType == "HL2" ? hl2 : srcType == "HLC3" ? hlc3 : srcType == "OHLC4" ? ohlc4 : (high + low + close + close) / 4.0

length  = input.int(50,  "Length",               group="Core Settings", minval=1)
maCol   = input.color(color.new(#FF9800, 0), "MA Color", group="Core Settings")
maWidth = input.int(3,   "Line Width",            group="Core Settings", minval=1, maxval=4)
showBG  = input.bool(false, "Show Background Color", group="Core Settings",
     tooltip = "Persistent green/red background while price is above/below the blended moving average.")

// ───────────────────────────────────────────────────────────────────
// BLEND MODE
// ───────────────────────────────────────────────────────────────────
blendMode = input.string("Equal Blend", "Blend Mode",
     options = ["Adaptive", "Equal Blend", "Custom Blend"],
     group   = "Blend Mode",
     tooltip = "Equal Blend: all 7 MAs averaged equally. Adaptive: MA closest to price gets highest weight automatically. Custom Blend: set your own weight for each MA below.")

// ───────────────────────────────────────────────────────────────────
// CUSTOM WEIGHTS  (0-100 per MA; auto-normalised so total = 100%)
// ───────────────────────────────────────────────────────────────────
w_sma  = input.int(14, "SMA  Weight",  minval=0, maxval=100,
     group="Custom Weights  (active in Custom Blend mode only)",
     tooltip="Simple Moving Average - classic baseline, equal weight to all bars.")
w_ema  = input.int(14, "EMA  Weight",  minval=0, maxval=100,
     group="Custom Weights  (active in Custom Blend mode only)",
     tooltip="Exponential MA - more weight to recent bars, reacts faster.")
w_wma  = input.int(14, "WMA  Weight",  minval=0, maxval=100,
     group="Custom Weights  (active in Custom Blend mode only)",
     tooltip="Weighted MA - linearly increasing weight towards recent bars.")
w_rma  = input.int(14, "RMA  Weight",  minval=0, maxval=100,
     group="Custom Weights  (active in Custom Blend mode only)",
     tooltip="Wilder's Smoothed MA - very smooth, slow to react (used in RSI).")
w_hma  = input.int(15, "HMA  Weight",  minval=0, maxval=100,
     group="Custom Weights  (active in Custom Blend mode only)",
     tooltip="Hull MA - near-zero lag, fast response, slightly noisier.")
w_alma = input.int(15, "ALMA Weight",  minval=0, maxval=100,
     group="Custom Weights  (active in Custom Blend mode only)",
     tooltip="Arnaud Legoux MA - Gaussian-weighted, minimal lag and noise.")
w_vwma = input.int(14, "VWMA Weight",  minval=0, maxval=100,
     group="Custom Weights  (active in Custom Blend mode only)",
     tooltip="Volume Weighted MA - heavier weight on high-volume bars. Requires volume data.")

// ═══════════════════════════════════════════════════════════════════
//  CALCULATE ALL 7 MOVING AVERAGES
// ═══════════════════════════════════════════════════════════════════
float v_sma  = ta.sma(src,  length)
float v_ema  = ta.ema(src,  length)
float v_wma  = ta.wma(src,  length)
float v_rma  = ta.rma(src,  length)
float v_hma  = ta.hma(src,  length)
float v_alma = ta.alma(src, length, 0.85, 6)
float v_vwma = ta.vwma(src, length)

// ═══════════════════════════════════════════════════════════════════
//  MODE 1 - EQUAL BLEND
//  Simple arithmetic mean of all 7 MAs
// ═══════════════════════════════════════════════════════════════════
float equalBlend = (v_sma + v_ema + v_wma + v_rma + v_hma + v_alma + v_vwma) / 7.0

// ═══════════════════════════════════════════════════════════════════
//  MODE 2 - ADAPTIVE BLEND
//  Each MA's weight = inverse of its distance from price.
//  MA closest to price gets highest weight automatically.
//  Floor of 0.0001 prevents divide-by-zero on exact match.
// ═══════════════════════════════════════════════════════════════════
float d_sma  = math.max(math.abs(src - v_sma),  0.0001)
float d_ema  = math.max(math.abs(src - v_ema),  0.0001)
float d_wma  = math.max(math.abs(src - v_wma),  0.0001)
float d_rma  = math.max(math.abs(src - v_rma),  0.0001)
float d_hma  = math.max(math.abs(src - v_hma),  0.0001)
float d_alma = math.max(math.abs(src - v_alma), 0.0001)
float d_vwma = math.max(math.abs(src - v_vwma), 0.0001)

float aw_sma  = 1.0 / d_sma
float aw_ema  = 1.0 / d_ema
float aw_wma  = 1.0 / d_wma
float aw_rma  = 1.0 / d_rma
float aw_hma  = 1.0 / d_hma
float aw_alma = 1.0 / d_alma
float aw_vwma = 1.0 / d_vwma
float aTotal  = aw_sma + aw_ema + aw_wma + aw_rma + aw_hma + aw_alma + aw_vwma

float adaptiveBlend = (v_sma*aw_sma + v_ema*aw_ema + v_wma*aw_wma + v_rma*aw_rma + v_hma*aw_hma + v_alma*aw_alma + v_vwma*aw_vwma) / aTotal

// ═══════════════════════════════════════════════════════════════════
//  MODE 3 - CUSTOM BLEND
//  User-defined weights, auto-normalised to always sum to 100%.
//  If all weights are 0, falls back to equal blend automatically.
// ═══════════════════════════════════════════════════════════════════
float cTotal = w_sma + w_ema + w_wma + w_rma + w_hma + w_alma + w_vwma
float cDenom  = cTotal > 0 ? float(cTotal) : 1.0

float customBlend = (v_sma*w_sma + v_ema*w_ema + v_wma*w_wma + v_rma*w_rma + v_hma*w_hma + v_alma*w_alma + v_vwma*w_vwma) / cDenom

// ═══════════════════════════════════════════════════════════════════
//  FINAL BLENDED MA
// ═══════════════════════════════════════════════════════════════════
float blendedMA = blendMode == "Equal Blend" ? equalBlend : blendMode == "Adaptive" ? adaptiveBlend : customBlend

// ═══════════════════════════════════════════════════════════════════
//  DIRECTION COLOUR
//  Green when price is above MA (bullish), red when below (bearish)
// ═══════════════════════════════════════════════════════════════════
color lineCol = blendedMA < src ? color.new(color.lime, 40) : blendedMA > src ? color.new(color.red, 40) : maCol

// ═══════════════════════════════════════════════════════════════════
//  PLOTS
// ═══════════════════════════════════════════════════════════════════

// Individual MA ghost lines (hidden by default, enable in Style tab)
plot(v_sma,  title="SMA",  color=color.new(color.gray,   80), linewidth=1, display=display.none)
plot(v_ema,  title="EMA",  color=color.new(color.blue,   80), linewidth=1, display=display.none)
plot(v_wma,  title="WMA",  color=color.new(color.teal,   80), linewidth=1, display=display.none)
plot(v_rma,  title="RMA",  color=color.new(color.olive,  80), linewidth=1, display=display.none)
plot(v_hma,  title="HMA",  color=color.new(color.purple, 80), linewidth=1, display=display.none)
plot(v_alma, title="ALMA", color=color.new(color.yellow, 80), linewidth=1, display=display.none)
plot(v_vwma, title="VWMA", color=color.new(color.aqua,   80), linewidth=1, display=display.none)

// Main blended MA line
plot(blendedMA,
     title     = "Adaptive Multi Moving Average",
     color     = lineCol,
     linewidth = maWidth)

// ═══════════════════════════════════════════════════════════════════
//  BACKGROUND  (persistent zone coloring)
// ═══════════════════════════════════════════════════════════════════
bool isBull = src > blendedMA
bool isBear = src < blendedMA
bgcolor(showBG and isBull ? color.new(color.lime, 90) : na, title="Bullish Background")
bgcolor(showBG and isBear ? color.new(color.red,  90) : na, title="Bearish Background")

// ═══════════════════════════════════════════════════════════════════
//  ALERTS
// ═══════════════════════════════════════════════════════════════════
bool crossUp   = ta.crossover(src,  blendedMA)
bool crossDown = ta.crossunder(src, blendedMA)
alertcondition(crossUp,   "Bullish Cross", "Price crossed above the blended moving average")
alertcondition(crossDown, "Bearish Cross", "Price crossed below the blended moving average")
