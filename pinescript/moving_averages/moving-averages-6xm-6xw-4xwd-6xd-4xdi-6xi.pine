//@version=6
indicator('Moving Averages (6xM, 6xW, 4x(W/D), 6xD, 4x(D/I) & 6xI)', shorttitle='Moving Averages', overlay=true)

//***************************************************************************************
// Global Inputs & Helper Functions
//***************************************************************************************
iWidth = input.int(title='Line Width', defval=1, minval=1, maxval=4)

f_getMA(type, src, len) =>
    type == 'SMA' ? ta.sma(src, len) : type == 'EMA' ? ta.ema(src, len) : type == 'RMA' ? ta.rma(src, len) : type == 'VWMA' ? ta.vwma(src, len) : ta.wma(src, len)

//---------------------------------------------------
// 1. Intraday Moving Averages
//---------------------------------------------------
iIntraMA1Visible = input.bool(true, title='Intra MA 1', inline='I1', group='Intraday Moving Averages')
iIntraMA1Length  = input.int(10, title='', minval=1, inline='I1', group='Intraday Moving Averages')
iIntraMA1Type    = input.string('EMA', title='', options=['SMA', 'EMA', 'RMA', 'VWMA', 'WMA'], inline='I1', group='Intraday Moving Averages')
iIntraMA1Source  = input.source(close, title='', inline='I1', group='Intraday Moving Averages')
iIntraMA1Color   = input.color(color.white, title='', inline='I1', group='Intraday Moving Averages')

iIntraMA2Visible = input.bool(true, title='Intra MA 2', inline='I2', group='Intraday Moving Averages')
iIntraMA2Length  = input.int(20, title='', minval=1, inline='I2', group='Intraday Moving Averages')
iIntraMA2Type    = input.string('EMA', title='', options=['SMA', 'EMA', 'RMA', 'VWMA', 'WMA'], inline='I2', group='Intraday Moving Averages')
iIntraMA2Source  = input.source(close, title='', inline='I2', group='Intraday Moving Averages')
iIntraMA2Color   = input.color(color.aqua, title='', inline='I2', group='Intraday Moving Averages')

