iWeeklyMA1Length  = input.int(10, title='', minval=1, inline='W1', group='Weekly Moving Averages')
iWeeklyMA1Type    = input.string('EMA', title='', options=['SMA', 'EMA', 'RMA', 'VWMA', 'WMA'], inline='W1', group='Weekly Moving Averages')
iWeeklyMA1Source  = input.source(close, title='', inline='W1', group='Weekly Moving Averages')
iWeeklyMA1Color   = input.color(color.green, title='', inline='W1', group='Weekly Moving Averages')

iWeeklyMA2Visible = input.bool(true, title='Weekly MA 2', inline='W2', group='Weekly Moving Averages')
iWeeklyMA2Length  = input.int(20, title='', minval=1, inline='W2', group='Weekly Moving Averages')
iWeeklyMA2Type    = input.string('EMA', title='', options=['SMA', 'EMA', 'RMA', 'VWMA', 'WMA'], inline='W2', group='Weekly Moving Averages')
iWeeklyMA2Source  = input.source(close, title='', inline='W2', group='Weekly Moving Averages')
iWeeklyMA2Color   = input.color(color.yellow, title='', inline='W2', group='Weekly Moving Averages')

iWeeklyMA3Visible = input.bool(true, title='Weekly MA 3', inline='W3', group='Weekly Moving Averages')
iWeeklyMA3Length  = input.int(30, title='', minval=1, inline='W3', group='Weekly Moving Averages')
iWeeklyMA3Type    = input.string('EMA', title='', options=['SMA', 'EMA', 'RMA', 'VWMA', 'WMA'], inline='W3', group='Weekly Moving Averages')
