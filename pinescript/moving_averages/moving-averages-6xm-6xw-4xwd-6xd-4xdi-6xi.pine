iWeeklyMA3Color   = input.color(color.orange, title='', inline='W3', group='Weekly Moving Averages')

iWeeklyMA4Visible = input.bool(true, title='Weekly MA 4', inline='W4', group='Weekly Moving Averages')
iWeeklyMA4Length  = input.int(40, title='', minval=1, inline='W4', group='Weekly Moving Averages')
