//---------------------------------------------------
// 6. Monthly Moving Averages
//---------------------------------------------------
iMonthlyMA1Visible = input.bool(true, title='Monthly MA1', inline='M1', group='Monthly Moving Averages')
iMonthlyMA1Length  = input.int(10, title='', minval=1, inline='M1', group='Monthly Moving Averages')
iMonthlyMA1Type    = input.string('EMA', title='', options=['SMA', 'EMA', 'RMA', 'VWMA', 'WMA'], inline='M1', group='Monthly Moving Averages')
iMonthlyMA1Source  = input.source(close, title='', inline='M1', group='Monthly Moving Averages')
iMonthlyMA1Color   = input.color(color.red, title='', inline='M1', group='Monthly Moving Averages')

iMonthlyMA2Visible = input.bool(true, title='Monthly MA2', inline='M2', group='Monthly Moving Averages')
iMonthlyMA2Length  = input.int(20, title='', minval=1, inline='M2', group='Monthly Moving Averages')
iMonthlyMA2Type    = input.string('EMA', title='', options=['SMA', 'EMA', 'RMA', 'VWMA', 'WMA'], inline='M2', group='Monthly Moving Averages')
iMonthlyMA2Source  = input.source(close, title='', inline='M2', group='Monthly Moving Averages')
iMonthlyMA2Color   = input.color(color.orange, title='', inline='M2', group='Monthly Moving Averages')

iMonthlyMA3Visible = input.bool(true, title='Monthly MA3', inline='M3', group='Monthly Moving Averages')
iMonthlyMA3Length  = input.int(50, title='', minval=1, inline='M3', group='Monthly Moving Averages')
iMonthlyMA3Type    = input.string('EMA', title='', options=['SMA', 'EMA', 'RMA', 'VWMA', 'WMA'], inline='M3', group='Monthly Moving Averages')
iMonthlyMA3Source  = input.source(close, title='', inline='M3', group='Monthly Moving Averages')
iMonthlyMA3Color   = input.color(color.yellow, title='', inline='M3', group='Monthly Moving Averages')

iMonthlyMA4Visible = input.bool(true, title='Monthly MA4', inline='M4', group='Monthly Moving Averages')
iMonthlyMA4Length  = input.int(100, title='', minval=1, inline='M4', group='Monthly Moving Averages')
iMonthlyMA4Type    = input.string('EMA', title='', options=['SMA', 'EMA', 'RMA', 'VWMA', 'WMA'], inline='M4', group='Monthly Moving Averages')
iMonthlyMA4Source  = input.source(close, title='', inline='M4', group='Monthly Moving Averages')
iMonthlyMA4Color   = input.color(color.green, title='', inline='M4', group='Monthly Moving Averages')

iMonthlyMA5Visible = input.bool(false, title='Monthly MA5', inline='M5', group='Monthly Moving Averages')
iMonthlyMA5Length  = input.int(150, title='', minval=1, inline='M5', group='Monthly Moving Averages')
iMonthlyMA5Type    = input.string('EMA', title='', options=['SMA', 'EMA', 'RMA', 'VWMA', 'WMA'], inline='M5', group='Monthly Moving Averages')
iMonthlyMA5Source  = input.source(close, title='', inline='M5', group='Monthly Moving Averages')
iMonthlyMA5Color   = input.color(color.aqua, title='', inline='M5', group='Monthly Moving Averages')

iMonthlyMA6Visible = input.bool(false, title='Monthly MA6', inline='M6', group='Monthly Moving Averages')
iMonthlyMA6Length  = input.int(200, title='', minval=1, inline='M6', group='Monthly Moving Averages')
iMonthlyMA6Type    = input.string('EMA', title='', options=['SMA', 'EMA', 'RMA', 'VWMA', 'WMA'], inline='M6', group='Monthly Moving Averages')
iMonthlyMA6Source  = input.source(close, title='', inline='M6', group='Monthly Moving Averages')
iMonthlyMA6Color   = input.color(color.white, title='', inline='M6', group='Monthly Moving Averages')

//***************************************************************************************
// Logic & Plotting
//***************************************************************************************

// Intraday Logic
intraMA1 = timeframe.isintraday ? f_getMA(iIntraMA1Type, iIntraMA1Source, iIntraMA1Length) : na
intraMA2 = timeframe.isintraday ? f_getMA(iIntraMA2Type, iIntraMA2Source, iIntraMA2Length) : na
intraMA3 = timeframe.isintraday ? f_getMA(iIntraMA3Type, iIntraMA3Source, iIntraMA3Length) : na
intraMA4 = timeframe.isintraday ? f_getMA(iIntraMA4Type, iIntraMA4Source, iIntraMA4Length) : na
intraMA5 = timeframe.isintraday ? f_getMA(iIntraMA5Type, iIntraMA5Source, iIntraMA5Length) : na
intraMA6 = timeframe.isintraday ? f_getMA(iIntraMA6Type, iIntraMA6Source, iIntraMA6Length) : na

plot(iIntraMA1Visible ? intraMA1 : na, title='Intra MA 1', color=iIntraMA1Color, linewidth=iWidth)
plot(iIntraMA2Visible ? intraMA2 : na, title='Intra MA 2', color=iIntraMA2Color, linewidth=iWidth)
plot(iIntraMA3Visible ? intraMA3 : na, title='Intra MA 3', color=iIntraMA3Color, linewidth=iWidth)
plot(iIntraMA4Visible ? intraMA4 : na, title='Intra MA 4', color=iIntraMA4Color, linewidth=iWidth)
plot(iIntraMA5Visible ? intraMA5 : na, title='Intra MA 5', color=iIntraMA5Color, linewidth=iWidth)
plot(iIntraMA6Visible ? intraMA6 : na, title='Intra MA 6', color=iIntraMA6Color, linewidth=iWidth)

// Daily on Intraday MTF Logic
di_sec1 = request.security(syminfo.tickerid, 'D', f_getMA(iDI1Type, iDI1Source, iDI1Length), lookahead = barmerge.lookahead_on)
plot(iDI1Visible and timeframe.isintraday ? di_sec1 : na, color=iDI1Color, title='D on Intra MA 1', linewidth=iWidth)
di_sec2 = request.security(syminfo.tickerid, 'D', f_getMA(iDI2Type, iDI2Source, iDI2Length), lookahead = barmerge.lookahead_on)
plot(iDI2Visible and timeframe.isintraday ? di_sec2 : na, color=iDI2Color, title='D on Intra MA 2', linewidth=iWidth)
di_sec3 = request.security(syminfo.tickerid, 'D', f_getMA(iDI3Type, iDI3Source, iDI3Length), lookahead = barmerge.lookahead_on)
plot(iDI3Visible and timeframe.isintraday ? di_sec3 : na, color=iDI3Color, title='D on Intra MA 3', linewidth=iWidth)
di_sec4 = request.security(syminfo.tickerid, 'D', f_getMA(iDI4Type, iDI4Source, iDI4Length), lookahead = barmerge.lookahead_on)
plot(iDI4Visible and timeframe.isintraday ? di_sec4 : na, color=iDI4Color, title='D on Intra MA 4', linewidth=iWidth)

// Daily Logic
dailyMA1 = timeframe.isdaily ? f_getMA(iDailyMA1Type, iDailyMA1Source, iDailyMA1Length) : na
dailyMA2 = timeframe.isdaily ? f_getMA(iDailyMA2Type, iDailyMA2Source, iDailyMA2Length) : na
dailyMA3 = timeframe.isdaily ? f_getMA(iDailyMA3Type, iDailyMA3Source, iDailyMA3Length) : na
dailyMA4 = timeframe.isdaily ? f_getMA(iDailyMA4Type, iDailyMA4Source, iDailyMA4Length) : na
dailyMA5 = timeframe.isdaily ? f_getMA(iDailyMA5Type, iDailyMA5Source, iDailyMA5Length) : na
dailyMA6 = timeframe.isdaily ? f_getMA(iDailyMA6Type, iDailyMA6Source, iDailyMA6Length) : na

plot(iDailyMA1Visible ? dailyMA1 : na, title='Daily MA 1', color=iDailyMA1Color, linewidth=iWidth)
plot(iDailyMA2Visible ? dailyMA2 : na, title='Daily MA 2', color=iDailyMA2Color, linewidth=iWidth)
plot(iDailyMA3Visible ? dailyMA3 : na, title='Daily MA 3', color=iDailyMA3Color, linewidth=iWidth)
plot(iDailyMA4Visible ? dailyMA4 : na, title='Daily MA 4', color=iDailyMA4Color, linewidth=iWidth)
plot(iDailyMA5Visible ? dailyMA5 : na, title='Daily MA 5', color=iDailyMA5Color, linewidth=iWidth)
plot(iDailyMA6Visible ? dailyMA6 : na, title='Daily MA 6', color=iDailyMA6Color, linewidth=iWidth)

// Weekly on Daily MTF Logic
wd_sec1 = request.security(syminfo.tickerid, 'W', f_getMA(iWD1Type, iWD1Source, iWD1Length), lookahead = barmerge.lookahead_on)
plot(iWD1Visible and timeframe.isdaily ? wd_sec1 : na, color=iWD1Color, title='W on D MA 1', linewidth=iWidth)
wd_sec2 = request.security(syminfo.tickerid, 'W', f_getMA(iWD2Type, iWD2Source, iWD2Length), lookahead = barmerge.lookahead_on)
plot(iWD2Visible and timeframe.isdaily ? wd_sec2 : na, color=iWD2Color, title='W on D MA 2', linewidth=iWidth)
wd_sec3 = request.security(syminfo.tickerid, 'W', f_getMA(iWD3Type, iWD3Source, iWD3Length), lookahead = barmerge.lookahead_on)
plot(iWD3Visible and timeframe.isdaily ? wd_sec3 : na, color=iWD3Color, title='W on D MA 3', linewidth=iWidth)
wd_sec4 = request.security(syminfo.tickerid, 'W', f_getMA(iWD4Type, iWD4Source, iWD4Length), lookahead = barmerge.lookahead_on)
plot(iWD4Visible and timeframe.isdaily ? wd_sec4 : na, color=iWD4Color, title='W on D MA 4', linewidth=iWidth)

// Weekly Logic
weeklyMA1 = timeframe.isweekly ? f_getMA(iWeeklyMA1Type, iWeeklyMA1Source, iWeeklyMA1Length) : na
weeklyMA2 = timeframe.isweekly ? f_getMA(iWeeklyMA2Type, iWeeklyMA2Source, iWeeklyMA2Length) : na
weeklyMA3 = timeframe.isweekly ? f_getMA(iWeeklyMA3Type, iWeeklyMA3Source, iWeeklyMA3Length) : na
weeklyMA4 = timeframe.isweekly ? f_getMA(iWeeklyMA4Type, iWeeklyMA4Source, iWeeklyMA4Length) : na
weeklyMA5 = timeframe.isweekly ? f_getMA(iWeeklyMA5Type, iWeeklyMA5Source, iWeeklyMA5Length) : na
weeklyMA6 = timeframe.isweekly ? f_getMA(iWeeklyMA6Type, iWeeklyMA6Source, iWeeklyMA6Length) : na

plot(iWeeklyMA1Visible ? weeklyMA1 : na, title='Weekly MA 1', color=iWeeklyMA1Color, linewidth=iWidth)
plot(iWeeklyMA2Visible ? weeklyMA2 : na, title='Weekly MA 2', color=iWeeklyMA2Color, linewidth=iWidth)
plot(iWeeklyMA3Visible ? weeklyMA3 : na, title='Weekly MA 3', color=iWeeklyMA3Color, linewidth=iWidth)
plot(iWeeklyMA4Visible ? weeklyMA4 : na, title='Weekly MA 4', color=iWeeklyMA4Color, linewidth=iWidth)
plot(iWeeklyMA5Visible ? weeklyMA5 : na, title='Weekly MA 5', color=iWeeklyMA5Color, linewidth=iWidth)
plot(iWeeklyMA6Visible ? weeklyMA6 : na, title='Weekly MA 6', color=iWeeklyMA6Color, linewidth=iWidth)

// Monthly Logic
monthlyMA1 = timeframe.ismonthly ? f_getMA(iMonthlyMA1Type, iMonthlyMA1Source, iMonthlyMA1Length) : na
monthlyMA2 = timeframe.ismonthly ? f_getMA(iMonthlyMA2Type, iMonthlyMA2Source, iMonthlyMA2Length) : na
monthlyMA3 = timeframe.ismonthly ? f_getMA(iMonthlyMA3Type, iMonthlyMA3Source, iMonthlyMA3Length) : na
monthlyMA4 = timeframe.ismonthly ? f_getMA(iMonthlyMA4Type, iMonthlyMA4Source, iMonthlyMA4Length) : na
monthlyMA5 = timeframe.ismonthly ? f_getMA(iMonthlyMA5Type, iMonthlyMA5Source, iMonthlyMA5Length) : na
monthlyMA6 = timeframe.ismonthly ? f_getMA(iMonthlyMA6Type, iMonthlyMA6Source, iMonthlyMA6Length) : na

plot(iMonthlyMA1Visible ? monthlyMA1 : na, title='Monthly MA1', color=iMonthlyMA1Color, linewidth=iWidth)
plot(iMonthlyMA2Visible ? monthlyMA2 : na, title='Monthly MA2', color=iMonthlyMA2Color, linewidth=iWidth)
plot(iMonthlyMA3Visible ? monthlyMA3 : na, title='Monthly MA3', color=iMonthlyMA3Color, linewidth=iWidth)
plot(iMonthlyMA4Visible ? monthlyMA4 : na, title='Monthly MA4', color=iMonthlyMA4Color, linewidth=iWidth)
plot(iMonthlyMA5Visible ? monthlyMA5 : na, title='Monthly MA5', color=iMonthlyMA5Color, linewidth=iWidth)
plot(iMonthlyMA6Visible ? monthlyMA6 : na, title='Monthly MA6', color=iMonthlyMA6Color, linewidth=iWidth)
