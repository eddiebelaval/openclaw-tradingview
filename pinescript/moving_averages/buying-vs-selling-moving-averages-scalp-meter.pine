//@version=6
indicator("Volume Delta MA", overlay=false)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
maType      = input.string("EMA", "MA Type", options=["EMA", "SMA", "WMA", "VWMA", "HMA"])
buyLength   = input.int(14, "Buying Volume MA Length",  minval=1)
sellLength  = input.int(14, "Selling Volume MA Length", minval=1)
showDelta   = input.bool(true, "Show Volume Histogram")

// ─────────────────────────────────────────────
// VOLUME DELTA CALCULATION
// Proportional split using candle range (Goichi method)
// Estimates buying/selling pressure within each candle
// ─────────────────────────────────────────────
candleRange = high - low

// Avoid division by zero on doji candles
buyRatio  = candleRange > 0 ? (close - low)  / candleRange : 0.5
sellRatio = candleRange > 0 ? (high - close) / candleRange : 0.5

buyVol  = volume * buyRatio
sellVol = volume * sellRatio
delta   = buyVol - sellVol

// ─────────────────────────────────────────────
// MA FUNCTION
// ─────────────────────────────────────────────
calcMA(src, len, type) =>
    switch type
        "EMA"  => ta.ema(src,  len)
        "SMA"  => ta.sma(src,  len)
        "WMA"  => ta.wma(src,  len)
        "VWMA" => ta.vwma(src, len)
        "HMA"  => ta.hma(src,  len)
        => ta.ema(src, len)

// ─────────────────────────────────────────────
// CALCULATE MAs
// ─────────────────────────────────────────────
buyMA  = calcMA(buyVol,  buyLength,  maType)
sellMA = calcMA(sellVol, sellLength, maType)

// ─────────────────────────────────────────────
// PLOTS
// ─────────────────────────────────────────────

// Total volume histogram (optional)
volColor = close >= open ? color.new(color.teal, 50) : color.new(color.red, 50)
plot(showDelta ? volume : na, "Volume Histogram", color=volColor, style=plot.style_columns)

// Buying and selling volume MAs
plot(buyMA,  "Buying Vol MA",  color=color.new(color.teal, 0), linewidth=2)
plot(sellMA, "Selling Vol MA", color=color.new(color.red,  0), linewidth=2)

// Zero line
hline(0, "Zero", color=color.new(color.gray, 50), linestyle=hline.style_dashed)

// ─────────────────────────────────────────────
// FILL between MAs to visualize dominance
// ─────────────────────────────────────────────
buyPlot  = plot(buyMA,  display=display.none)
sellPlot = plot(sellMA, display=display.none)
fill(buyPlot, sellPlot, color=buyMA > sellMA ? color.new(color.teal, 85) : color.new(color.red, 85), title="Dominance Fill")
