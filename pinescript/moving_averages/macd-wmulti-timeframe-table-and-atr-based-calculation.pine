//@version=6
indicator(title = 'MACD w/multi-timeframe table and ATR-based calculation', shorttitle = 'MACD MTF Table & ATR', overlay = false)
import TradingView/ta/11

adjustBrightness(baseColor, float brightnessPct) =>
    r = color.r(baseColor)
    g = color.g(baseColor)
    b = color.b(baseColor)

    // Clamp brightnessPct to -100 to 100
    clampedPct = math.max(math.min(brightnessPct, 100), -100)

    // Calculate brightness multiplier
    factor = 1.0 + clampedPct / 100.0

    // Apply factor and clamp to 0-255
    newR = math.min(255, math.max(0, r * factor))
    newG = math.min(255, math.max(0, g * factor))
    newB = math.min(255, math.max(0, b * factor))

    // Return new color with original alpha
    color.rgb(int(newR), int(newG), int(newB), 0)


fast_len = input.int(title = 'MACD Fast Length', defval = 6, minval = 1, tooltip = 'Fast EMA period for MACD calculation', group = 'Indicator Settings')
slow_len = input.int(title = 'MACD Slow Length', defval = 20, minval = 1, tooltip = 'Slow EMA period for MACD calculation', group = 'Indicator Settings')
source = input.source(title = 'Source', defval = close, tooltip = 'Price source for MACD calculation (close, open, high, low, etc.)', group = 'Indicator Settings')
signal_len = input.int(title = 'Signal Line Smoothing Length', defval = 10, minval = 1, tooltip = 'EMA period for the signal line', group = 'Indicator Settings')
atr_len = input.int(title = 'ATR Length', defval = 20, minval = 1, tooltip = 'Used to gauge volatility to standardize MACD. Keep at the same value as the MACD Slow Length parameter for best results', group = 'Indicator Settings')

col_grow_above = input(#00ffcc81, 'Above Grow', tooltip = 'Color when histogram above zero and rising', group = 'Histogram', inline = 'Above')
col_fall_above = input(#02D1A781, 'Above Fall', tooltip = 'Color when histogram above zero and falling', group = 'Histogram', inline = 'Above')
col_fall_below = input(#E7BC3B81, 'Below Fall', tooltip = 'Color when histogram below zero and falling', group = 'Histogram', inline = 'Below')
col_grow_below = input(#e7bc3b43, 'Below Grow', tooltip = 'Color when histogram below zero and rising', group = 'Histogram', inline = 'Below')
bearishDivColor = input(#ff4223, "Bearish Divergence Color", tooltip = 'Color for bearish divergence lines', group = "Divergences")
bullishDivColor = input(#8ef10d, "Bullish Divergence Color", tooltip = 'Color for bullish divergence lines', group = "Divergences")

macd_color = input(#000000, 'MACD', tooltip = 'Color for the MACD line', group = 'Plots', inline = 'MACD')
macd_signal_color = adjustBrightness(macd_color,-25)
showDivergences = input.bool(title = 'Show Divergences', defval = true, tooltip = 'Master toggle to show or hide all divergence plots', group = 'Divergences')
divPivotLen = input.int(title = 'Pivot Lookback', defval = 5, minval = 1, tooltip = 'Bars to look back for pivot detection', group = 'Divergences')
divRangeLower = input.int(title = 'Minimum Bars Between Pivots', defval = 5, minval = 1, tooltip = 'Minimum bars required between two pivots', group = 'Divergences')
divRangeUpper = input.int(title = 'Maximum Bars Between Pivots', defval = 60, minval = 2, tooltip = 'Maximum bars allowed between two pivots', group = 'Divergences')
dontTouchZero = input.bool(title = 'Dont Touch Zero Line?', defval = true, tooltip = 'Only detect divergences when MACD stays entirely above or below zero between pivots', group = 'Divergences')
plotBullishDivs = input.bool(title = 'Plot Bullish Divergences', defval = true, tooltip = 'Show bullish divergence signals', group = 'Divergences')
plotBearishDivs = input.bool(title = 'Plot Bearish Divergences', defval = true, tooltip = 'Show bearish divergence signals', group = 'Divergences')
includeAtrInCalculation = input.bool(title = 'Include ATR in MACD calculation', defval = false, tooltip = 'Normalize MACD by ATR for volatility-adjusted readings', group = 'Indicator Settings')

// === MTF TABLE SETTINGS ===
showMtfTable = input.bool(title = 'Show MTF Table', defval = true, tooltip = 'Display multi-timeframe MACD table on chart', group = 'MTF Table')
tablePosition = input.string(title = 'Table Position', defval = 'Top Right', options = ['Top Left', 'Top Right', 'Bottom Left', 'Bottom Right'], tooltip = 'Position of the MTF table on the chart', group = 'MTF Table')
tableSize = input.string(title = 'Table Size', defval = 'Small', options = ['Tiny', 'Small', 'Normal', 'Large'], tooltip = 'Text size for table cells', group = 'MTF Table')
tableTextColor = input.color(title = 'Table Text Color', defval = color.black, tooltip = 'Text color for table cells', group = 'MTF Table')


atr_smooth = ta.rma(ta.atr(atr_len), atr_len)

macdWithAtr = (ta.ema(source, fast_len) - ta.ema(source, slow_len)) / atr_smooth * 100
macdWithoutAtr = (ta.ema(source, fast_len) - ta.ema(source, slow_len)) * 100
macd = includeAtrInCalculation ? macdWithAtr : macdWithoutAtr

signal = ta.ema(macd, signal_len)
hist = macd - signal


plot(hist, title = "Histogram", style = plot.style_columns, color = (hist >= 0 ? (hist[1] < hist ? col_grow_above : col_fall_above) : (hist[1] < hist ? col_grow_below : col_fall_below)))
macd_plot = plot(title = 'MACD Line', series = macd, color = macd_color, linewidth = 2, linestyle = plot.linestyle_solid)
plot(title = 'Signal Line', series = signal, color = macd_signal_color, linestyle = plot.linestyle_dotted)
hline(0, "Zero Line", color = color.new(#787B86, 50))


alertcondition(ta.crossover(macd,signal), title = "MACD Crossover", message = "MACD has crossed over")
alertcondition(ta.crossunder(macd,signal), title = "MACD Crossunder", message = "MACD has crossed under")

plotshape(ta.crossover(macd,signal) , title = "MACD Crossover", location = location.bottom , color = color.new(col_grow_above,0),  textcolor = col_grow_above,style = shape.triangleup)
plotshape(ta.crossunder(macd,signal) , title = "MACD Crossunder", location = location.top , color = color.new(col_fall_below,0), textcolor = col_fall_below,style = shape.triangledown)


if ta.crossover(macd,signal)
    alert(message = "MACD Crossover Alert",freq = alert.freq_once_per_bar_close)

if ta.crossunder(macd,signal)
    alert(message = "MACD Crossunder Alert",freq = alert.freq_once_per_bar_close)


bearColor = bearishDivColor
bullColor = bullishDivColor
noneColor = color.new(color.white, 100)

plFound = na(ta.pivotlow(macd, divPivotLen, divPivotLen)) ? false : true
phFound = na(ta.pivothigh(macd, divPivotLen, divPivotLen)) ? false : true
_inRange(cond) =>
    bars = ta.barssince(cond == true)
    divRangeLower <= bars and bars <= divRangeUpper

plPivotInRange = _inRange(plFound[1])
phPivotInRange = _inRange(phFound[1])

//------------------------------------------------------------------------------
// Regular Bullish
// Osc: Higher Low

oscHL = macd[divPivotLen] > ta.valuewhen(plFound, macd[divPivotLen], 1) and plPivotInRange and  macd[divPivotLen] < 0

// Price: Lower Low

priceLL = low[divPivotLen] < ta.valuewhen(plFound, low[divPivotLen], 1)
priceHHZero =  ta.highest(macd, divPivotLen+divPivotLen+5) 
//plot(priceHHZero,title="priceHHZero",color=color.green)
blowzero = dontTouchZero ? priceHHZero < 0 : true
bullCond = showDivergences and plotBullishDivs and priceLL and oscHL and plFound and blowzero

plot(
     showDivergences and plFound ? macd[divPivotLen] : na,
     offset=-divPivotLen,
     title="Regular Bullish",
     linewidth=2,
     color=(bullCond ? bullColor : noneColor))



//------------------------------------------------------------------------------
// Regular Bearish
// Osc: Lower High

oscLH = macd[divPivotLen] < ta.valuewhen(phFound, macd[divPivotLen], 1) and phPivotInRange  and macd[divPivotLen] > 0

priceLLZero =  ta.lowest(macd, divPivotLen+divPivotLen+5) 
//plot(priceLLZero,title="priceLLZero", color=color.red)
bearzero = dontTouchZero ? priceLLZero > 0 : true


// Price: Higher High

priceHH = high[divPivotLen] > ta.valuewhen(phFound, high[divPivotLen], 1)

bearCond = showDivergences and plotBearishDivs and priceHH and oscLH and phFound and bearzero

plot(
     showDivergences and phFound ? macd[divPivotLen] : na,
     offset=-divPivotLen,
     title="Regular Bearish",
     linewidth=2,
     color=(bearCond ? bearColor : noneColor)
     )
 

alertcondition(bullCond, title="Bull", message="Regular Bull Div {{ticker}} XXmin")
alertcondition(bearCond, title="Bear", message="Regular Bear Div {{ticker}} XXmin")

// === MTF TABLE ===
// Helper function to get position enum
getPosition(pos) =>
    pos == 'Top Left' ? position.top_left : pos == 'Top Right' ? position.top_right : pos == 'Bottom Left' ? position.bottom_left : position.bottom_right

// Helper function to get size enum
getSize(sz) =>
    sz == 'Tiny' ? size.tiny : sz == 'Small' ? size.small : sz == 'Normal' ? size.normal : size.large

// Helper to check if requested timeframe matches chart timeframe
isSameTimeframe(tf) =>
    tf == timeframe.period

// Calculate MACD and histogram for a specific timeframe with consistent parameters
calcMacdHist(tf) =>
    if isSameTimeframe(tf)
        [macd, hist]
    else
        [tfMacd, tfHist] = request.security(syminfo.tickerid, tf, [macd, hist], gaps = barmerge.gaps_off)
        [tfMacd, tfHist]

// Calculate previous MACD and histogram for a specific timeframe with consistent parameters
calcMacdHistPrev(tf) =>
    if isSameTimeframe(tf)
        [macd[1], hist[1]]
    else
        [tfMacdPrev, tfHistPrev] = request.security(syminfo.tickerid, tf, [macd[1], hist[1]], gaps = barmerge.gaps_off)
        [tfMacdPrev, tfHistPrev]

// Get MACD and histogram values for each timeframe
[macd1h, hist1h] = calcMacdHist("60")
[macd4h, hist4h] = calcMacdHist("240")
[macd1d, hist1d] = calcMacdHist("D")
[macd1w, hist1w] = calcMacdHist("W")
[macd1m, hist1m] = calcMacdHist("M")

// Helper to format number (2 decimals for values < 1)
formatValue(val) =>
    math.abs(val) < 1 ? str.tostring(val, "#.##") : str.tostring(val, "#.#")

// Helper to get histogram color
getHistColor(histVal, histPrev) =>
    histVal >= 0 ? (histPrev < histVal ? col_grow_above : col_fall_above) : (histPrev < histVal ? col_grow_below : col_fall_below)

// Helper to get slope indicator
getSlopeIndicator(currVal, prevVal) =>
    currVal > prevVal ? "▲" : currVal < prevVal ? "▼" : "—"

// Get previous MACD and histogram values for each timeframe
[macd1hPrev, hist1hPrev] = calcMacdHistPrev("60")
[macd4hPrev, hist4hPrev] = calcMacdHistPrev("240")
[macd1dPrev, hist1dPrev] = calcMacdHistPrev("D")
[macd1wPrev, hist1wPrev] = calcMacdHistPrev("W")
[macd1mPrev, hist1mPrev] = calcMacdHistPrev("M")

// Create table
if showMtfTable
    var tbl = table.new(getPosition(tablePosition), 5, 2, bgcolor = color.new(color.black, 100), frame_color = color.gray, frame_width = 1, border_color = color.gray, border_width = 1)
    
    // Header row with slope indicators (based on MACD slope)
    table.cell(tbl, 0, 0, getSlopeIndicator(macd1h, macd1hPrev) + " 1H", text_color = tableTextColor, text_size = getSize(tableSize), text_font_family = font.family_monospace)
    table.cell(tbl, 1, 0, getSlopeIndicator(macd4h, macd4hPrev) + " 4H", text_color = tableTextColor, text_size = getSize(tableSize), text_font_family = font.family_monospace)
    table.cell(tbl, 2, 0, getSlopeIndicator(macd1d, macd1dPrev) + " 1D", text_color = tableTextColor, text_size = getSize(tableSize), text_font_family = font.family_monospace)
    table.cell(tbl, 3, 0, getSlopeIndicator(macd1w, macd1wPrev) + " 1W", text_color = tableTextColor, text_size = getSize(tableSize), text_font_family = font.family_monospace)
    table.cell(tbl, 4, 0, getSlopeIndicator(macd1m, macd1mPrev) + " 1M", text_color = tableTextColor, text_size = getSize(tableSize), text_font_family = font.family_monospace)
    
    // Data row with MACD values and histogram-based colors
    table.cell(tbl, 0, 1, formatValue(macd1h), bgcolor = getHistColor(hist1h, hist1hPrev), text_color = tableTextColor, text_size = getSize(tableSize), text_font_family = font.family_monospace)
    table.cell(tbl, 1, 1, formatValue(macd4h), bgcolor = getHistColor(hist4h, hist4hPrev), text_color = tableTextColor, text_size = getSize(tableSize), text_font_family = font.family_monospace)
    table.cell(tbl, 2, 1, formatValue(macd1d), bgcolor = getHistColor(hist1d, hist1dPrev), text_color = tableTextColor, text_size = getSize(tableSize), text_font_family = font.family_monospace)
    table.cell(tbl, 3, 1, formatValue(macd1w), bgcolor = getHistColor(hist1w, hist1wPrev), text_color = tableTextColor, text_size = getSize(tableSize), text_font_family = font.family_monospace)
    table.cell(tbl, 4, 1, formatValue(macd1m), bgcolor = getHistColor(hist1m, hist1mPrev), text_color = tableTextColor, text_size = getSize(tableSize), text_font_family = font.family_monospace)
