//@version=5
indicator("J - Trend Sniper v2", overlay=true)

// Parameters
fastLen = input.int(6, "Fast Length")
ATRPeriod = input.int(16, "Period")
ATRMultip = input.float(9, "Multiplier")
ATRMultip_fast = input.float(5.1, "Fast Multiplier")
candleStickBackground = input.bool(true, "Color Background")

// ATR Calculations
getATR() =>
    ta.atr(ATRPeriod)

getDefATR(series float src_close, series float atr_value) =>
    var float result = 0.0
    nl = ATRMultip * atr_value
    result := src_close > result[1] and src_close[1] > result[1] ? math.max(result[1], src_close - nl) : src_close < result[1] and src_close[1] < result[1] ? math.min(result[1], src_close + nl) : src_close > result[1] ? src_close - nl : src_close + nl
    result

getDefATRFast(series float src_close, series float atr_value) =>
    var float result = 0.0
    nl_fast = ATRMultip_fast * atr_value
    result := src_close > result[1] and src_close[1] > result[1] ? math.max(result[1], src_close - nl_fast) : src_close < result[1] and src_close[1] < result[1] ? math.min(result[1], src_close + nl_fast) : src_close > result[1] ? src_close - nl_fast : src_close + nl_fast
    result

aTR = getATR()
defATR = getDefATR(close, aTR)
defATR_fast = getDefATRFast(close, aTR)

p1 = plot(defATR, color=color.new(color.aqua, 50), linewidth=1, title="ATR Trailing Stop")

// Signal Calculations
getSignals(series float src_close, series float src_open, series float src_high, series float src_low) =>
    cc = ta.sma(src_close, fastLen)
    oo = ta.sma(src_open, fastLen)
    hh = ta.sma(src_high, fastLen)
    ll = ta.sma(src_low, fastLen)
    lv = math.abs(cc-oo)/(hh - ll)
    var a = 0.0
    plusOne = nz(a[1], src_close)
    a := lv*src_close+(1-lv) * plusOne
    a

a = getSignals(close, open, high, low)

p2 = plot(a, title="Price Line")

p1_defATR_fast_shorten = defATR_fast > a ? defATR_fast - (defATR_fast-a) / 2 : defATR_fast + (a-defATR_fast) / 2
p11_defATR_fast_shorten = plot(p1_defATR_fast_shorten, color=color.new(color.purple, 30), title="Fast Line")

// Background coloring
bgTransp = candleStickBackground ? 50 : 100
isBullishTeal = high > 0 and close > defATR and a < p1_defATR_fast_shorten
tealColor = color.new(isBullishTeal ? color.teal : color.new(#004d4d, 0), bgTransp)
isBullishMaroon = high > 0 and close > defATR
isMaroonCase = a > p1_defATR_fast_shorten
baseMaroonColor = isBullishMaroon ? color.new(#004d4d, 0) : (isMaroonCase ? color.maroon : color.new(#4d0000, 0))
maroonColor = color.new(baseMaroonColor, bgTransp)
isBullish = high > 0 and close > defATR
bullishCheck = a < p1_defATR_fast_shorten
bearishCheck = a > p1_defATR_fast_shorten
fillColor = isBullish ? (bullishCheck ? tealColor : color.new(#004d4d, bgTransp)) : (bearishCheck ? maroonColor : color.new(#4d0000, bgTransp))
fill(p11_defATR_fast_shorten, p2, color=fillColor)

// Signal generation
jlong = ta.crossover(a, defATR)
jshort = ta.crossunder(a, defATR)

// Signal plotting
plotshape(jlong, title="Long", text="", textcolor=color.white, style=shape.labelup, size=size.tiny, location=location.belowbar, color=color.green)
plotshape(jshort, title="Short", text="", textcolor=color.white, style=shape.labeldown, size=size.tiny, location=location.abovebar, color=color.red)

// Alerts
alertcondition(jlong, title='Long', message='Long')
alertcondition(jshort, title='Short', message='Short')
