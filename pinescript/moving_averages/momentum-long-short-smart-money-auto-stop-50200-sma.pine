//@version=5
indicator("Smart Money + Auto-Stop [50/200 SMA]", overlay=true)

// --- USER INPUTS ---
price_min = input.float(8.0, "Min Price")
price_max = input.float(50.0, "Max Price")
rel_vol_threshold = input.float(2.0, "Rel Vol Multiplier")
rsi_len = input.int(14, "RSI Length")
buffer = input.float(1.5, "Stop Loss % Buffer Below SMA") / 100

// --- TREND & VOLUME CALCULATIONS ---
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
avg_vol = ta.sma(volume, 20)
rel_vol = (avg_vol > 0) ? (volume / avg_vol) : 0

// --- VOLUME PRICE TREND (VPT) ---
var float vpt = 0.0
vpt := vpt + (volume * (close - close[1]) / close[1])
vpt_ma = ta.sma(vpt, 20)

// --- RELATIVE STRENGTH ---
current_rsi = ta.rsi(close, rsi_len)
spy_close = request.security("SPY", timeframe.period, close)
spy_rsi = ta.rsi(spy_close, rsi_len)

// --- SIGNAL LOGIC ---
is_in_range = close >= price_min and close <= price_max
high_vol = rel_vol >= rel_vol_threshold
vpt_confirm = vpt > vpt_ma

long_signal = is_in_range and high_vol and (current_rsi > spy_rsi) and (close > sma50 and close > sma200) and vpt_confirm
short_signal = is_in_range and high_vol and (current_rsi < spy_rsi) and (close < sma50 and close < sma200) and not vpt_confirm

// --- DYNAMIC STOP LOSS CALCULATION ---
long_sl = sma50 * (1 - buffer)
short_sl = sma50 * (1 + buffer)

// --- VISUALS ---
plot(sma50, color=color.blue, title="50 SMA (Trend & Stop)")
plot(sma200, color=color.white, linewidth=2, title="200 SMA")

plotshape(long_signal, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="LONG")
plotshape(short_signal, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SHORT")

// Plot Stop Loss Labels when a signal occurs
plotshape(long_signal ? long_sl : na, title="Long SL Price", style=shape.labelup, location=location.absolute, color=color.red, textcolor=color.white, size=size.tiny, text="SL")
plotshape(short_signal ? short_sl : na, title="Short SL Price", style=shape.labeldown, location=location.absolute, color=color.red, textcolor=color.white, size=size.tiny, text="SL")

// --- ALERTS ---
alertcondition(long_signal, "Long Alert", "Ticker: {{ticker}} | Price: {{close}} | Stop: Check Red Label")
alertcondition(short_signal, "Short Alert", "Ticker: {{ticker}} | Price: {{close}} | Stop: Check Red Label")
