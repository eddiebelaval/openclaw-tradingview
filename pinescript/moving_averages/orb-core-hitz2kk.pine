//@version=6
indicator("ORB Core v2 - Hitz2kk", overlay=true, max_lines_count=300, max_labels_count=300, max_boxes_count=50)

//====================================================
// INPUTS
//====================================================
groupSess = "Session Times"
onSession     = input.session("1800-0929", "Overnight Session", group=groupSess)
asiaSession   = input.session("0000-0100", "Asia Session Box", group=groupSess)
londonSession = input.session("0300-0400", "London Session Box", group=groupSess)
nyAmSession   = input.session("0930-1000", "NY AM Session Box", group=groupSess)
nyPmSession   = input.session("1300-1400", "NY PM Session Box", group=groupSess)

groupOrb = "ORB Selection"
orbSource = input.string("NY AM", "Use ORB From", options=["Asia", "London", "NY AM", "NY PM"], group=groupOrb)

groupShow = "Show / Hide"
showPD          = input.bool(true, "Show PDH / PDL", group=groupShow)
showON          = input.bool(true, "Show ONH / ONL", group=groupShow)
showORB         = input.bool(true, "Show ORBH / ORBL", group=groupShow)
showBiasBox     = input.bool(true, "Show Bias Box", group=groupShow)
showLevelsBox   = input.bool(true, "Show Levels Box", group=groupShow)
showSessionBox  = input.bool(true, "Show Session Boxes", group=groupShow)
showGuideMid    = input.bool(true, "Show ORB Midline", group=groupShow)

groupStyle = "Style"
extendBars       = input.int(260, "Extend Lines Right", minval=50, maxval=800, group=groupStyle)
rightLabelBars   = input.int(22, "Right Label Offset", minval=2, maxval=100, group=groupStyle)
showPrices       = input.bool(true, "Show Prices In Labels", group=groupStyle)
mainWidth        = input.int(2, "PD / ON Line Width", minval=1, maxval=4, group=groupStyle)
orbWidth         = input.int(2, "ORB Line Width", minval=1, maxval=4, group=groupStyle)
labelSizeInput   = input.string("small", "Label Size", options=["tiny", "small", "normal"], group=groupStyle)

groupCols = "Colours"
colPDH      = input.color(color.new(#58D26A, 0), "PDH", group=groupCols)
colPDL      = input.color(color.new(#FF5B7F, 0), "PDL", group=groupCols)
colONH      = input.color(color.new(#45C46B, 0), "ONH", group=groupCols)
colONL      = input.color(color.new(#E75480, 0), "ONL", group=groupCols)
colORBH     = input.color(color.new(#2D6BFF, 0), "ORBH", group=groupCols)
colORBL     = input.color(color.new(#F5A623, 0), "ORBL", group=groupCols)
colMid      = input.color(color.new(color.white, 0), "ORB Midline", group=groupCols)

colAsiaBox   = input.color(color.new(#D98BA1, 82), "Asia Box", group=groupCols)
colLondonBox = input.color(color.new(#65B5E8, 82), "London Box", group=groupCols)
colNyAmBox   = input.color(color.new(#EFD28A, 80), "NY AM Box", group=groupCols)
colNyPmBox   = input.color(color.new(#90A8FF, 82), "NY PM Box", group=groupCols)

boxTextCol = input.color(color.black, "Top Grid Text", group=groupCols)

//====================================================
// LABEL SIZE
//====================================================
label_size = labelSizeInput == "tiny" ? size.tiny : labelSizeInput == "normal" ? size.normal : size.small

//====================================================
// PREVIOUS DAY LEVELS
//====================================================
pdh = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1],  barmerge.gaps_off, barmerge.lookahead_off)

//====================================================
// SESSION STATE
//====================================================
inON     = not na(time(timeframe.period, onSession))
inAsia   = not na(time(timeframe.period, asiaSession))
inLondon = not na(time(timeframe.period, londonSession))
inNYAM   = not na(time(timeframe.period, nyAmSession))
inNYPM   = not na(time(timeframe.period, nyPmSession))

newON     = inON and not inON[1]
newAsia   = inAsia and not inAsia[1]
newLondon = inLondon and not inLondon[1]
newNYAM   = inNYAM and not inNYAM[1]
newNYPM   = inNYPM and not inNYPM[1]

//====================================================
// OVERNIGHT HIGH / LOW
//====================================================
var float onh = na
var float onl = na

if newON
    onh := high
    onl := low
else if inON
    onh := na(onh) ? high : math.max(onh, high)
    onl := na(onl) ? low : math.min(onl, low)

//====================================================
// SESSION BOX TRACKING
//====================================================
var float asiaHighBox = na
var float asiaLowBox = na
var float londonHighBox = na
var float londonLowBox = na
var float nyAmHighBox = na
var float nyAmLowBox = na
var float nyPmHighBox = na
var float nyPmLowBox = na

if newAsia
    asiaHighBox := high
    asiaLowBox := low
else if inAsia
    asiaHighBox := na(asiaHighBox) ? high : math.max(asiaHighBox, high)
    asiaLowBox := na(asiaLowBox) ? low : math.min(asiaLowBox, low)

if newLondon
    londonHighBox := high
    londonLowBox := low
else if inLondon
    londonHighBox := na(londonHighBox) ? high : math.max(londonHighBox, high)
    londonLowBox := na(londonLowBox) ? low : math.min(londonLowBox, low)

if newNYAM
    nyAmHighBox := high
    nyAmLowBox := low
else if inNYAM
    nyAmHighBox := na(nyAmHighBox) ? high : math.max(nyAmHighBox, high)
    nyAmLowBox := na(nyAmLowBox) ? low : math.min(nyAmLowBox, low)

if newNYPM
    nyPmHighBox := high
    nyPmLowBox := low
else if inNYPM
    nyPmHighBox := na(nyPmHighBox) ? high : math.max(nyPmHighBox, high)
    nyPmLowBox := na(nyPmLowBox) ? low : math.min(nyPmLowBox, low)

//====================================================
// ORB VALUES
//====================================================
float asiaH = asiaHighBox
float asiaL = asiaLowBox
float londonH = londonHighBox
float londonL = londonLowBox
float nyAmH = nyAmHighBox
float nyAmL = nyAmLowBox
float nyPmH = nyPmHighBox
float nyPmL = nyPmLowBox

//====================================================
// ACTIVE ORB SELECTION
//====================================================
float orbh = na
float orbl = na
string orbName = ""

if orbSource == "Asia"
    orbh := asiaH
    orbl := asiaL
    orbName := "ASIA"
else if orbSource == "London"
    orbh := londonH
    orbl := londonL
    orbName := "LONDON"
else if orbSource == "NY AM"
    orbh := nyAmH
    orbl := nyAmL
    orbName := "NY AM"
else
    orbh := nyPmH
    orbl := nyPmL
    orbName := "NY PM"

//====================================================
// BIAS
//====================================================
float orbMid = na
orbMid := na(orbh) or na(orbl) ? na : (orbh + orbl) / 2.0

string biasText = "NEUTRAL"
if not na(orbMid)
    if close > orbMid
        biasText := "BULLISH -> TARGET HIGHS"
    else if close < orbMid
        biasText := "BEARISH -> TARGET LOWS"

//====================================================
// HELPERS
//====================================================
f_txt(_name, _price, _showPrices) =>
    _showPrices ? (_name + " " + str.tostring(_price, format.mintick)) : _name

f_setLine(_existing, _price, _col, _width, _style, _extendBars) =>
    line result = _existing
    if not na(_price)
        if na(result)
            result := line.new(bar_index, _price, bar_index + _extendBars, _price, xloc=xloc.bar_index, extend=extend.none, color=_col, width=_width, style=_style)
        else
            line.set_xy1(result, bar_index, _price)
            line.set_xy2(result, bar_index + _extendBars, _price)
            line.set_color(result, _col)
            line.set_width(result, _width)
            line.set_style(result, _style)
    result

f_setLabel(_existing, _price, _text, _col, _txtCol, _xOff, _size) =>
    label result = _existing
    if not na(_price)
        if na(result)
            result := label.new(bar_index + _xOff, _price, _text, xloc=xloc.bar_index, style=label.style_label_left, color=_col, textcolor=_txtCol, size=_size)
        else
            label.set_x(result, bar_index + _xOff)
            label.set_y(result, _price)
            label.set_text(result, _text)
            label.set_color(result, _col)
            label.set_textcolor(result, _txtCol)
            label.set_size(result, _size)
    result

f_updateBox(_existing, _newSession, _inSession, _top, _bottom, _bgcolor) =>
    box result = _existing
    if _newSession and not na(_top) and not na(_bottom)
        result := box.new(left=bar_index, top=_top, right=bar_index, bottom=_bottom, xloc=xloc.bar_index, bgcolor=_bgcolor, border_color=color.new(_bgcolor, 100))
    else if _inSession and not na(result) and not na(_top) and not na(_bottom)
        box.set_right(result, bar_index)
        box.set_top(result, _top)
        box.set_bottom(result, _bottom)
    result

//====================================================
// STORAGE
//====================================================
var line lPDH   = na
var line lPDL   = na
var line lONH   = na
var line lONL   = na
var line lORBH  = na
var line lORBL  = na
var line lMid   = na

var label labPDH  = na
var label labPDL  = na
var label labONH  = na
var label labONL  = na
var label labORBH = na
var label labORBL = na

var box asiaBox   = na
var box londonBox = na
var box nyAmBox   = na
var box nyPmBox   = na

//====================================================
// DRAW SESSION BOXES
//====================================================
if showSessionBox
    asiaBox   := f_updateBox(asiaBox, newAsia, inAsia, asiaHighBox, asiaLowBox, colAsiaBox)
    londonBox := f_updateBox(londonBox, newLondon, inLondon, londonHighBox, londonLowBox, colLondonBox)
    nyAmBox   := f_updateBox(nyAmBox, newNYAM, inNYAM, nyAmHighBox, nyAmLowBox, colNyAmBox)
    nyPmBox   := f_updateBox(nyPmBox, newNYPM, inNYPM, nyPmHighBox, nyPmLowBox, colNyPmBox)

//====================================================
// DRAW LINES + LABELS
//====================================================
if showPD
    lPDH := f_setLine(lPDH, pdh, colPDH, mainWidth, line.style_solid, extendBars)
    lPDL := f_setLine(lPDL, pdl, colPDL, mainWidth, line.style_solid, extendBars)
    labPDH := f_setLabel(labPDH, pdh, f_txt("PDH", pdh, showPrices), colPDH, color.white, rightLabelBars, label_size)
    labPDL := f_setLabel(labPDL, pdl, f_txt("PDL", pdl, showPrices), colPDL, color.white, rightLabelBars, label_size)

if showON
    lONH := f_setLine(lONH, onh, colONH, mainWidth, line.style_solid, extendBars)
    lONL := f_setLine(lONL, onl, colONL, mainWidth, line.style_solid, extendBars)
    labONH := f_setLabel(labONH, onh, f_txt("ONH", onh, showPrices), colONH, color.white, rightLabelBars, label_size)
    labONL := f_setLabel(labONL, onl, f_txt("ONL", onl, showPrices), colONL, color.white, rightLabelBars, label_size)

if showORB
    lORBH := f_setLine(lORBH, orbh, colORBH, orbWidth, line.style_dashed, extendBars)
    lORBL := f_setLine(lORBL, orbl, colORBL, orbWidth, line.style_dashed, extendBars)
    labORBH := f_setLabel(labORBH, orbh, f_txt("ORBH", orbh, showPrices), colORBH, color.white, rightLabelBars, label_size)
    labORBL := f_setLabel(labORBL, orbl, f_txt("ORBL", orbl, showPrices), colORBL, color.white, rightLabelBars, label_size)

if showGuideMid
    lMid := f_setLine(lMid, orbMid, colMid, 1, line.style_solid, extendBars)

//====================================================
// TOP GRID + HALLMARK
//====================================================
var table topGrid = table.new(position.top_center, 2, 2)
var table sigTbl  = table.new(position.bottom_right, 1, 1)

if barstate.islast
    if showBiasBox
        table.cell(topGrid, 0, 0, "BIAS", text_color=boxTextCol, text_size=size.tiny, bgcolor=color.white)
        table.cell(topGrid, 1, 0, biasText, text_color=boxTextCol, text_size=size.tiny, bgcolor=color.white)
    else
        table.cell(topGrid, 0, 0, "", text_color=boxTextCol, text_size=size.tiny, bgcolor=color.new(color.white, 100))
        table.cell(topGrid, 1, 0, "", text_color=boxTextCol, text_size=size.tiny, bgcolor=color.new(color.white, 100))

    if showLevelsBox
        table.cell(topGrid, 0, 1, "LEVELS", text_color=boxTextCol, text_size=size.tiny, bgcolor=color.white)
        table.cell(topGrid, 1, 1, "PDH/PDL  ONH/ONL  " + orbName + " ORB", text_color=boxTextCol, text_size=size.tiny, bgcolor=color.white)
    else
        table.cell(topGrid, 0, 1, "", text_color=boxTextCol, text_size=size.tiny, bgcolor=color.new(color.white, 100))
        table.cell(topGrid, 1, 1, "", text_color=boxTextCol, text_size=size.tiny, bgcolor=color.new(color.white, 100))

    table.cell(sigTbl, 0, 0, "@hitz2kk", text_color=color.gray, text_size=size.small, bgcolor=color.new(color.black, 100))
