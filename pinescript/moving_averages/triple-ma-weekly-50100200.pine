//@version=5
indicator("Triple MA Weekly (50/100/200)", overlay=true)

// --- Paramètres fixes ---
tf = "W"   // Timeframe forcé en Weekly

// --- Calcul des MA Weekly ---
ma50  = request.security(syminfo.tickerid, tf, ta.sma(close, 50))
ma100 = request.security(syminfo.tickerid, tf, ta.sma(close, 100))
ma200 = request.security(syminfo.tickerid, tf, ta.sma(close, 200))

// --- Affichage ---
plot(ma50,  color=color.orange,   linewidth=2, title="Weekly MA 50")
plot(ma100, color=color.purple, linewidth=2, title="Weekly MA 100")
plot(ma200, color=color.blue,    linewidth=2, title="Weekly MA 200")
