//@version=6
indicator("9/20 Mid-Day: MA 50 Filtered", overlay=true)

// --- 1. Inputs ---
emaLen      = input.int(9, "9 EMA")
smaLen      = input.int(20, "20 SMA")
filterLen   = input.int(50, "Trend Filter (50 MA)")
rrRatio     = input.float(1.5, "Risk:Reward (1.5R)")
tickBuffer  = input.float(0.5, "SL Buffer")

// --- 2. Time & Day Reset ---
sessMid = "1130-1500"
bool isMidDay = not na(time(timeframe.period, sessMid, "America/New_York"))
isNewDay = ta.change(time("D", "America/New_York")) != 0

// --- 3. Indicators ---
float emaVal    = ta.ema(close, emaLen)
float smaVal    = ta.sma(close, smaLen)
float filterMA  = ta.sma(close, filterLen)

plot(emaVal, color=color.blue, title="9 EMA")
plot(smaVal, color=color.orange, title="20 SMA")
plot(filterMA, color=color.new(color.white, 50), linewidth=2, title="50 MA Filter")

// --- 4. Arrays for Trade History ---
var sideArr   = array.new_string(0)
var entryArr  = array.new_float(0)
var slArr     = array.new_float(0)
var tpArr     = array.new_float(0)
var statusArr = array.new_string(0)

if isNewDay
    array.clear(sideArr), array.clear(entryArr), array.clear(slArr), array.clear(tpArr), array.clear(statusArr)

// --- 5. Signal Logic (Filtered by MA 50) ---
bool longCross  = ta.crossover(emaVal, smaVal)
bool shortCross = ta.crossunder(emaVal, smaVal)

// Filter: Price must be on the correct side of 50 MA
bool buySignal  = isMidDay and longCross and close > filterMA
bool sellSignal = isMidDay and shortCross and close < filterMA

if buySignal or sellSignal
    float ent = close
    float sl  = buySignal ? (low[1] - tickBuffer) : (high[1] + tickBuffer)
    float risk = math.abs(ent - sl)
    float tp   = buySignal ? (ent + (risk * rrRatio)) : (ent - (risk * rrRatio))
    
    array.push(sideArr, buySignal ? "BUY" : "SELL")
    array.push(entryArr, ent)
    array.push(slArr, sl)
    array.push(tpArr, tp)
    array.push(statusArr, "ACTIVE")

    if array.size(sideArr) > 5
        array.shift(sideArr), array.shift(entryArr), array.shift(slArr), array.shift(tpArr), array.shift(statusArr)
    
    label.new(bar_index, buySignal ? low : high, text=buySignal ? "BUY" : "SELL", color=buySignal ? color.green : color.red, textcolor=color.white, style=buySignal ? label.style_label_up : label.style_label_down, yloc=buySignal ? yloc.belowbar : yloc.abovebar)
    line.new(bar_index, sl, bar_index + 12, sl, color=color.new(color.red, 40), width=2, style=line.style_dashed)
    line.new(bar_index, tp, bar_index + 12, tp, color=color.new(color.green, 40), width=2, style=line.style_solid)

// --- 6. Status Monitoring ---
if array.size(sideArr) > 0
    for i = 0 to array.size(sideArr) - 1
        if array.get(statusArr, i) == "ACTIVE"
            string curSide = array.get(sideArr, i)
            float curTP    = array.get(tpArr, i)
            float curSL    = array.get(slArr, i)
            
            if (curSide == "BUY" and high >= curTP) or (curSide == "SELL" and low <= curTP)
                array.set(statusArr, i, "WIN ✅")
            else if (curSide == "BUY" and low <= curSL) or (curSide == "SELL" and high >= curSL)
                array.set(statusArr, i, "LOSS ❌")

// --- 7. History Table ---
var table historyTable = table.new(position.top_right, 5, 7, bgcolor=color.new(color.black, 40), border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(historyTable, 0, 0, "SIDE", text_color=color.white, bgcolor=color.gray)
    table.cell(historyTable, 1, 0, "ENTRY", text_color=color.white, bgcolor=color.gray)
    table.cell(historyTable, 2, 0, "SL", text_color=color.white, bgcolor=color.gray)
    table.cell(historyTable, 3, 0, "TP (1.5R)", text_color=color.white, bgcolor=color.gray)
    table.cell(historyTable, 4, 0, "RESULT", text_color=color.white, bgcolor=color.gray)

    if array.size(sideArr) > 0
        for i = 0 to array.size(sideArr) - 1
            int row = i + 1
            string side = array.get(sideArr, i)
            string stat = array.get(statusArr, i)
            table.cell(historyTable, 0, row, side, text_color = side == "BUY" ? color.green : color.red)
            table.cell(historyTable, 1, row, str.tostring(array.get(entryArr, i), "#.##"), text_color=color.white)
            table.cell(historyTable, 2, row, str.tostring(array.get(slArr, i), "#.##"), text_color=color.new(color.red, 30))
            table.cell(historyTable, 3, row, str.tostring(array.get(tpArr, i), "#.##"), text_color=color.new(color.green, 30))
            table.cell(historyTable, 4, row, stat, text_color = stat == "WIN ✅" ? color.green : stat == "LOSS ❌" ? color.red : color.white)

bgcolor(isMidDay ? color.new(color.gray, 96) : na)
