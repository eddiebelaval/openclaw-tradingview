//@version=5
indicator("Classic Daily SMAs", overlay=true)

// === USER SETTINGS ===
lineWidth = input.int(1, "Line Width", minval=1)  // skinny lines

// === DAILY SMAs ===
sma10  = request.security(syminfo.tickerid, "D", ta.sma(close, 10), lookahead=barmerge.lookahead_on)
sma20  = request.security(syminfo.tickerid, "D", ta.sma(close, 20), lookahead=barmerge.lookahead_on)
sma50  = request.security(syminfo.tickerid, "D", ta.sma(close, 50), lookahead=barmerge.lookahead_on)
sma100 = request.security(syminfo.tickerid, "D", ta.sma(close, 100), lookahead=barmerge.lookahead_on)
sma200 = request.security(syminfo.tickerid, "D", ta.sma(close, 200), lookahead=barmerge.lookahead_on)

// === PLOT DAILY SMAs ===
plot(sma10,  color=color.yellow,  linewidth=lineWidth, title="SMA 10")
plot(sma20,  color=color.orange,  linewidth=lineWidth, title="SMA 20")
plot(sma50,  color=color.blue,    linewidth=lineWidth, title="SMA 50")
plot(sma100, color=color.purple,  linewidth=lineWidth, title="SMA 100")
plot(sma200, color=color.red,     linewidth=lineWidth, title="SMA 200")
