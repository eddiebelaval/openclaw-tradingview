// © ripster47 / Modified Integration
//@version=5
indicator("EMA Cloud + ORB + Dash", overlay=true, max_lines_count=500, max_labels_count=500)

// ==========================================
// 1) EMA CLOUD SETTINGS & LOGIC
// ==========================================
group_ema = "EMA Cloud Settings"
matype = input.string(title="MA Type", defval="EMA", options=["EMA", "SMA"], group=group_ema)
src = input.source(title="Source", defval=hl2, group=group_ema)

ma_len_short = input.int(title="Short MA Length", defval=9, group=group_ema)
ma_len_long = input.int(title="Long MA Length", defval=15, group=group_ema)

// Border/Line Toggles
showLines = input.bool(true, "Show EMA Lines (Borders)", group=group_ema)

// Cloud Visuals
bull_color = input.color(title="Bullish Cloud Color", defval=#81c784, group=group_ema)
bear_color = input.color(title="Bearish Cloud Color", defval=#f77c80, group=group_ema)
transp = input.int(title="Cloud Transparency", defval=45, minval=0, maxval=100, group=group_ema)

group_dash = "Dashboard Settings"
showDash = input.bool(true, "Show Realtime Dashboard", group=group_dash)
flashSeconds = input.int(60, "Flash Duration (sec)", minval=5, group=group_dash)

f_ma(malen) =>
    matype == "EMA" ? ta.ema(src, malen) : ta.sma(src, malen)

short_ma = f_ma(ma_len_short)
long_ma = f_ma(ma_len_long)

// Real-time Cloud State & Spread
isBullish = short_ma >= long_ma
spread = math.abs(short_ma - long_ma)
cloud_colour = isBullish ? bull_color : bear_color

// --- Plotting EMA Lines (Borders) ---
// display.price_scale is subtracted so the values do not appear on the right-hand axis
p1 = plot(showLines ? short_ma : na, color=isBullish ? bull_color : bear_color, title="LTF EMA Line", linewidth=1, display=display.all - display.price_scale)
p2 = plot(showLines ? long_ma : na, color=isBullish ? bull_color : bear_color, title="HTF EMA Line", linewidth=1, display=display.all - display.price_scale)

// --- EMA Cloud Fill ---
fill(p1, p2, color=color.new(cloud_colour, transp), title="EMA Cloud")

// --- Price Axis Labels (Controlled separately) ---
// These are currently set to 100% transparency. 
// If you don't want any EMA values on the axis at all, you can simply remove or comment out these two lines.
plot(showLines ? short_ma : na, title="LTF Price Label", color=color.new(color.rgb(0, 145, 255), 100), linewidth=1, style=plot.style_linebr)
plot(showLines ? long_ma : na,  title="HTF Price Label", color=color.new(color.rgb(255, 0, 0), 100),   linewidth=1, style=plot.style_linebr)

// Tracking flips for the "Flash" effect
var int lastFlipTime = na
if ta.change(isBullish)
    lastFlipTime := time

// ==========================================
// 2) ADVANCE ORB LOGIC (NY OPEN)
// ==========================================
group_orb = "ORB Settings"
showORB = input.bool(true, "Show Advance ORB (NY Open)", group=group_orb)
orbTimezone = "America/New_York"
txtSizeInput = input.string("Small", "Label Text Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=group_orb)
lineWidthInput = input.int(1, "ORB Line Width", minval=1, maxval=5, group=group_orb)

selectedSize = txtSizeInput == "Tiny" ? size.tiny : txtSizeInput == "Small" ? size.small : txtSizeInput == "Normal" ? size.normal : txtSizeInput == "Large" ? size.large : size.huge

is_new_day = ta.change(time("D", orbTimezone))

in_5m_range  = time(timeframe.period, "0930-0935", orbTimezone)
in_15m_range = time(timeframe.period, "0930-0945", orbTimezone)
in_30m_range = time(timeframe.period, "0930-1000", orbTimezone)

var float orb5h = na, var float orb5l = na
var float orb15h = na, var float orb15l = na
var float orb30h = na, var float orb30l = na
var int bar5h = na, var int bar5l = na
var int bar15h = na, var int bar15l = na
var int bar30h = na, var int bar30l = na

var line l5h = na, var line l5l = na
var line l15h = na, var line l15l = na
var line l30h = na, var line l30l = na
var label lb5h = na, var label lb5l = na
var label lb15h = na, var label lb15l = na
var label lb30h = na, var label lb30l = na

if is_new_day
    orb5h := na, orb5l := na, orb15h := na, orb15l := na, orb30h := na, orb30l := na
    line.delete(l5h), line.delete(l5l), line.delete(l15h), line.delete(l15l), line.delete(l30h), line.delete(l30l)
    label.delete(lb5h), label.delete(lb5l), label.delete(lb15h), label.delete(lb15l), label.delete(lb30h), label.delete(lb30l)
    l5h := na, l5l := na, l15h := na, l15l := na, l30h := na, l30l := na

if not na(in_5m_range)
    if na(orb5h) or high > orb5h
        orb5h := high, bar5h := time
    if na(orb5l) or low < orb5l
        orb5l := low, bar5l := time

if not na(in_15m_range)
    if na(orb15h) or high > orb15h
        orb15h := high, bar15h := time
    if na(orb15l) or low < orb15l
        orb15l := low, bar15l := time

if not na(in_30m_range)
    if na(orb30h) or high > orb30h
        orb30h := high, bar30h := time
    if na(orb30l) or low < orb30l
        orb30l := low, bar30l := time

t_4pm = timestamp(orbTimezone, year(time), month(time), dayofmonth(time), 16, 0, 0)
range5Closed  = time >= timestamp(orbTimezone, year(time), month(time), dayofmonth(time), 09, 35, 0)
range15Closed = time >= timestamp(orbTimezone, year(time), month(time), dayofmonth(time), 09, 45, 0)
range30Closed = time >= timestamp(orbTimezone, year(time), month(time), dayofmonth(time), 10, 00, 0)

if showORB
    if range5Closed and not na(orb5h)
        if na(l5h)
            l5h := line.new(bar5h, orb5h, t_4pm, orb5h, xloc=xloc.bar_time, color=color.blue, width=lineWidthInput)
            lb5h := label.new(t_4pm, orb5h, "5 M ORB H", xloc=xloc.bar_time, textcolor=color.blue, style=label.style_label_left, color=color.new(color.black, 100), size=selectedSize)
            l5l := line.new(bar5l, orb5l, t_4pm, orb5l, xloc=xloc.bar_time, color=color.blue, width=lineWidthInput)
            lb5l := label.new(t_4pm, orb5l, "5 M ORB L", xloc=xloc.bar_time, textcolor=color.blue, style=label.style_label_left, color=color.new(color.black, 100), size=selectedSize)
    
    if range15Closed and not na(orb15h)
        if orb15h > orb5h
            if na(l15h)
                l15h := line.new(bar15h, orb15h, t_4pm, orb15h, xloc=xloc.bar_time, color=color.red, width=lineWidthInput)
                lb15h := label.new(t_4pm, orb15h, "15 M ORB H", xloc=xloc.bar_time, textcolor=color.red, style=label.style_label_left, color=color.new(color.black, 100), size=selectedSize)
        else if orb15h == orb5h
            label.set_text(lb5h, "5/15 M ORB H")

        if orb15l < orb5l
            if na(l15l)
                l15l := line.new(bar15l, orb15l, t_4pm, orb15l, xloc=xloc.bar_time, color=color.red, width=lineWidthInput)
                lb15l := label.new(t_4pm, orb15l, "15 M ORB L", xloc=xloc.bar_time, textcolor=color.red, style=label.style_label_left, color=color.new(color.black, 100), size=selectedSize)
        else if orb15l == orb5l
            label.set_text(lb5l, "5/15 M ORB L")

    if range30Closed and not na(orb30h)
        if orb30h > orb15h and orb30h > orb5h
            if na(l30h)
                l30h := line.new(bar30h, orb30h, t_4pm, orb30h, xloc=xloc.bar_time, color=#7B1FA2, width=lineWidthInput)
                lb30h := label.new(t_4pm, orb30h, "30 M ORB H", xloc=xloc.bar_time, textcolor=#7B1FA2, style=label.style_label_left, color=color.new(color.black, 100), size=selectedSize)
        else if orb30h == orb15h and not na(lb15h)
            label.set_text(lb15h, "15/30 M ORB H")
        else if orb30h == orb5h
            label.set_text(lb5h, str.contains(label.get_text(lb5h), "15") ? "5/15/30 M ORB H" : "5/30 M ORB H")
            if str.contains(label.get_text(lb5h), "15")
                line.set_color(l5h, color.orange), label.set_textcolor(lb5h, color.orange)

        if orb30l < orb15l and orb30l < orb5l
            if na(l30l)
                l30l := line.new(bar30l, orb30l, t_4pm, orb30l, xloc=xloc.bar_time, color=#7B1FA2, width=lineWidthInput)
                lb30l := label.new(t_4pm, orb30l, "30 M ORB L", xloc=xloc.bar_time, textcolor=#7B1FA2, style=label.style_label_left, color=color.new(color.black, 100), size=selectedSize)
        else if orb30l == orb15l and not na(lb15l)
            label.set_text(lb15l, "15/30 M ORB L")
        else if orb30l == orb5l
            label.set_text(lb5l, str.contains(label.get_text(lb5l), "15") ? "5/15/30 M ORB L" : "5/30 M ORB L")
            if str.contains(label.get_text(lb5l), "15")
                line.set_color(l5l, color.orange), label.set_textcolor(lb5l, color.orange)

// ==========================================
// 3) REALTIME DASHBOARD (ARROWS & SPREAD)
// ==========================================
timeET(t) => na(t) ? "-" : str.format_time(t, "HH:mm 'ET'", "America/New_York")
isFlash(t) => not na(t) and (timenow - t) < flashSeconds * 1000

var table dash = table.new(position.top_right, 6, 1, border_width=1, border_color=color.gray)

if barstate.islast and showDash
    table.clear(dash, 0, 0, 5, 0)
    
    neon_bull = color.rgb(0, 255, 133)
    neon_bear = color.rgb(255, 49, 49)
    
    status_icon = isFlash(lastFlipTime) ? "CROSS!" : isBullish ? "▲" : "▼"
    status_color = isFlash(lastFlipTime) ? color.black : isBullish ? neon_bull : neon_bear
    status_bg = isFlash(lastFlipTime) ? color.white : color.black
    
    table.cell(dash, 0, 0, "CLOUD", text_color=color.rgb(245, 248, 19), bgcolor=color.black, text_size=size.small)
    table.cell(dash, 1, 0, status_icon, text_color=status_color, bgcolor=status_bg, text_size=size.normal)
    table.cell(dash, 2, 0, timeET(lastFlipTime), text_color=color.white, bgcolor=color.black, text_size=size.small)
    table.cell(dash, 3, 0, "LTF: " + str.tostring(short_ma, format.mintick), text_color=color.white, bgcolor=color.black, text_size=size.small)
    table.cell(dash, 4, 0, "HTF: " + str.tostring(long_ma, format.mintick), text_color=color.white, bgcolor=color.black, text_size=size.small)
    table.cell(dash, 5, 0, "SPD: " + str.tostring(spread, format.mintick), text_color=color.rgb(245, 248, 19), bgcolor=color.black, text_size=size.small)
