//@version=6
indicator("Adaptive EMA (Log Return Switch)", overlay=true)

src = input.source(close, "Source")
lrLookback = input.int(1, "LR Lookback (bars)")
emaLR_len = input.int(5, "EMA Length for LR")

t1 = input.float(0.3, "Threshold 1")
t2 = input.float(0.6, "Threshold 2")
t3 = input.float(0.9, "Threshold 3")
t4 = input.float(1.3, "Threshold 4")

len10 = input.int(10, "EMA Small")
len20 = input.int(20, "EMA Medium 1")
len40 = input.int(40, "EMA Medium 2")
len60 = input.int(60, "EMA Large 1")
len80 = input.int(80, "EMA Large 2")

emaLR = ta.ema(src, emaLR_len)

ema10 = ta.ema(src, len10)
ema20 = ta.ema(src, len20)
ema40 = ta.ema(src, len40)
ema60 = ta.ema(src, len60)
ema80 = ta.ema(src, len80)

lr = math.log(emaLR / emaLR[lrLookback]) * 10000

ema_selected =
     lr >=  t4 ? ema80 :
     lr >=  t3 ? ema60 :
     lr >=  t2 ? ema40 :
     lr >=  t1 ? ema20 :
     lr >   0  ? ema10 :
     lr >  -t1 ? ema10 :
     lr >  -t2 ? ema20 :
     lr >  -t3 ? ema40 :
     lr >  -t4 ? ema60 :
                 ema80

plot(ema_selected, "Adaptive EMA", color=color.rgb(195, 0, 255), linewidth=1)
