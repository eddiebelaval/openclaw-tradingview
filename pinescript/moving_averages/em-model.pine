//@version=5
indicator("LE Levels", overlay=true, max_lines_count=500, max_labels_count=500)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS - KEY LEVELS
// ─────────────────────────────────────────────────────────────────────────────
grp_levels   = "Key Levels"
extendBars   = input.int(100,  "Extend Levels (bars)", minval=0, group=grp_levels)
extendPDLeft = input.bool(true, "Extend PDH/L Left",   group=grp_levels)
extendPMLeft = input.bool(true, "Extend PMH/L Left",   group=grp_levels)
showName     = input.bool(true, "Show Name",            group=grp_levels)
showPrice    = input.bool(true, "Show Price",           group=grp_levels)

pdhColor = input.color(#00e676, "PDH Color", group=grp_levels)
pdlColor = input.color(#ff5252, "PDL Color", group=grp_levels)
pmhColor = input.color(#69f0ae, "PMH Color", group=grp_levels)
pmlColor = input.color(#ff5252, "PML Color", group=grp_levels)

pdhStyle = input.string("solid",  "PDH Style", options=["solid","dashed","dotted"], group=grp_levels)
pdlStyle = input.string("solid",  "PDL Style", options=["solid","dashed","dotted"], group=grp_levels)
pmhStyle = input.string("dashed", "PMH Style", options=["solid","dashed","dotted"], group=grp_levels)
pmlStyle = input.string("dashed", "PML Style", options=["solid","dashed","dotted"], group=grp_levels)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS - SIGNALS
// ─────────────────────────────────────────────────────────────────────────────
grp_sig   = "Signals"
setupType = input.string("Both", "Setup Type", options=["Inside","Outside","Both"], group=grp_sig)
entryType = input.string("Both", "Entry Type", options=["(L)evels","(E)MAs","Both"], group=grp_sig)
showLong  = input.bool(true, "Long Signals",  group=grp_sig)
showShort = input.bool(true, "Short Signals", group=grp_sig)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS - EMA WAVES
// ─────────────────────────────────────────────────────────────────────────────
grp_ema8   = "8 EMA Wave"
show8Wave  = input.bool(true, "Show 8 EMA Wave", group=grp_ema8)
col8Bull   = input.color(color.new(#00e676, 30), "Bullish",      group=grp_ema8)
col8BullD  = input.color(color.new(#1b5e20, 40), "Bullish Dark", group=grp_ema8)
col8Bear   = input.color(color.new(#ff1744, 30), "Bearish",      group=grp_ema8)
col8BearD  = input.color(color.new(#b71c1c, 40), "Bearish Dark", group=grp_ema8)
col8Neut   = input.color(color.new(#9e9e9e, 40), "Neutral",      group=grp_ema8)

grp_ema20  = "20 EMA Wave"
show20Wave = input.bool(false, "Show 20 EMA Wave", group=grp_ema20)
col20Bull  = input.color(color.new(#00e676, 50), "Bullish",      group=grp_ema20)
col20BullD = input.color(color.new(#1b5e20, 55), "Bullish Dark", group=grp_ema20)
col20Bear  = input.color(color.new(#ff1744, 50), "Bearish",      group=grp_ema20)
col20BearD = input.color(color.new(#b71c1c, 55), "Bearish Dark", group=grp_ema20)
col20Neut  = input.color(color.new(#9e9e9e, 55), "Neutral",      group=grp_ema20)

grp_ema200  = "200 EMA Wave"
show200Wave = input.bool(false, "Show 200 EMA Wave", group=grp_ema200)
col200Up    = input.color(color.new(#26a69a, 50), "Bull", group=grp_ema200)
col200Down  = input.color(color.new(#ef5350, 50), "Bear", group=grp_ema200)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS - CANDLE COLORS
// ─────────────────────────────────────────────────────────────────────────────
grp_candles    = "Candle Colors"
bullCandleBody = input.color(#e0e0e0, "Bull Body", group=grp_candles)
bearCandleBody = input.color(#2196f3, "Bear Body", group=grp_candles)
bullWickColor  = input.color(#e0e0e0, "Bull Wick", group=grp_candles)
bearWickColor  = input.color(#2196f3, "Bear Wick", group=grp_candles)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS - STOP LOSS
// ─────────────────────────────────────────────────────────────────────────────
grp_sl         = "Stop Loss"
useTrailSL     = input.bool(false, "Use Trailing Stop-Loss", group=grp_sl)
candleClosePct = input.float(0.5,  "Candle Close % for SL",  minval=0.0, step=0.1, group=grp_sl)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS - MISC
// ─────────────────────────────────────────────────────────────────────────────
grp_misc   = "Miscellaneous"
hidePrevPD = input.bool(true, "Hide Previous Day H/L",        group=grp_misc)
hidePrevPM = input.bool(true, "Hide Previous Pre-Market H/L", group=grp_misc)

// ─────────────────────────────────────────────────────────────────────────────
// CANDLE COLORING
// ─────────────────────────────────────────────────────────────────────────────
isBullCandle = close >= open
plotcandle(open, high, low, close,
     color      = isBullCandle ? bullCandleBody : bearCandleBody,
     wickcolor  = isBullCandle ? bullWickColor  : bearWickColor,
     bordercolor= isBullCandle ? bullCandleBody : bearCandleBody)

// ─────────────────────────────────────────────────────────────────────────────
// HELPERS
// ─────────────────────────────────────────────────────────────────────────────
f_lineStyle(s) =>
    s == "dashed" ? line.style_dashed : s == "dotted" ? line.style_dotted : line.style_solid

f_label(lname, price) =>
    lbl = ""
    if showName
        lbl := lname + ": "
    if showPrice
        lbl := lbl + "$" + str.tostring(math.round(price, 2))
    lbl

// ─────────────────────────────────────────────────────────────────────────────
// SESSION DETECTION
// ─────────────────────────────────────────────────────────────────────────────
isRegular     = not na(time("1", "0930-1600", "America/New_York"))
isPremarket   = not na(time("1", "0400-0929", "America/New_York"))
isConfirmed   = barstate.isconfirmed
newRegularDay = isRegular   and not isRegular[1]
newPMDay      = isPremarket and not isPremarket[1]

// ─────────────────────────────────────────────────────────────────────────────
// PDH / PDL
// ─────────────────────────────────────────────────────────────────────────────
var float pdh         = na
var float pdl         = na
var float sessionHigh = na
var float sessionLow  = na

if isRegular
    sessionHigh := na(sessionHigh) ? high : math.max(sessionHigh, high)
    sessionLow  := na(sessionLow)  ? low  : math.min(sessionLow,  low)

if newRegularDay
    pdh         := sessionHigh[1]
    pdl         := sessionLow[1]
    sessionHigh := high
    sessionLow  := low

// ─────────────────────────────────────────────────────────────────────────────
// PMH / PML
// ─────────────────────────────────────────────────────────────────────────────
var float pmh           = na
var float pml           = na
var float pmSessionHigh = na
var float pmSessionLow  = na

if isPremarket
    pmSessionHigh := na(pmSessionHigh) ? high : math.max(pmSessionHigh, high)
    pmSessionLow  := na(pmSessionLow)  ? low  : math.min(pmSessionLow,  low)

if newPMDay
    pmSessionHigh := high
    pmSessionLow  := low

if newRegularDay
    pmh := pmSessionHigh
    pml := pmSessionLow

// ─────────────────────────────────────────────────────────────────────────────
// DRAW LEVELS
// ─────────────────────────────────────────────────────────────────────────────
var line linePDH = na
var line linePDL = na
var line linePMH = na
var line linePML = na
var label lblPDH = na
var label lblPDL = na
var label lblPMH = na
var label lblPML = na

if newRegularDay and not na(pdh)
    line.delete(linePDH), line.delete(linePDL)
    line.delete(linePMH), line.delete(linePML)
    label.delete(lblPDH), label.delete(lblPDL)
    label.delete(lblPMH), label.delete(lblPML)

    startPD = extendPDLeft ? bar_index - 300 : bar_index
    startPM = extendPMLeft ? bar_index - 300 : bar_index

    if not na(pdh)
        linePDH := line.new(startPD, pdh, bar_index + extendBars, pdh, color=pdhColor, style=f_lineStyle(pdhStyle), width=1)
        lblPDH  := label.new(bar_index + extendBars, pdh, f_label("PDH", pdh), color=color.new(color.black,100), textcolor=pdhColor, style=label.style_label_left, size=size.small)
    if not na(pdl)
        linePDL := line.new(startPD, pdl, bar_index + extendBars, pdl, color=pdlColor, style=f_lineStyle(pdlStyle), width=1)
        lblPDL  := label.new(bar_index + extendBars, pdl, f_label("PDL", pdl), color=color.new(color.black,100), textcolor=pdlColor, style=label.style_label_left, size=size.small)
    if not na(pmh)
        linePMH := line.new(startPM, pmh, bar_index + extendBars, pmh, color=pmhColor, style=f_lineStyle(pmhStyle), width=1)
        lblPMH  := label.new(bar_index + extendBars, pmh, f_label("PMH", pmh), color=color.new(color.black,100), textcolor=pmhColor, style=label.style_label_left, size=size.small)
    if not na(pml)
        linePML := line.new(startPM, pml, bar_index + extendBars, pml, color=pmlColor, style=f_lineStyle(pmlStyle), width=1)
        lblPML  := label.new(bar_index + extendBars, pml, f_label("PML", pml), color=color.new(color.black,100), textcolor=pmlColor, style=label.style_label_left, size=size.small)

if not na(linePDH)
    line.set_x2(linePDH, bar_index + extendBars), label.set_x(lblPDH, bar_index + extendBars)
if not na(linePDL)
    line.set_x2(linePDL, bar_index + extendBars), label.set_x(lblPDL, bar_index + extendBars)
if not na(linePMH)
    line.set_x2(linePMH, bar_index + extendBars), label.set_x(lblPMH, bar_index + extendBars)
if not na(linePML)
    line.set_x2(linePML, bar_index + extendBars), label.set_x(lblPML, bar_index + extendBars)

// ─────────────────────────────────────────────────────────────────────────────
// EMAs
// ─────────────────────────────────────────────────────────────────────────────
ema8   = ta.ema(close, 8)
ema9   = ta.ema(close, 9)
ema10  = ta.ema(close, 10)
ema19  = ta.ema(close, 19)
ema20  = ta.ema(close, 20)
ema21  = ta.ema(close, 21)
ema190 = ta.ema(close, 190)
ema199 = ta.ema(close, 199)
ema200 = ta.ema(close, 200)

// ─────────────────────────────────────────────────────────────────────────────
// PRICE POSITION
// ─────────────────────────────────────────────────────────────────────────────
abovePDHandPMH   = not na(pdh) and not na(pmh) and close > pdh and close > pmh
betweenPDHandPMH = not na(pdh) and not na(pmh) and close > pmh and close < pdh
belowPDLandPML   = not na(pdl) and not na(pml) and close < pdl and close < pml
betweenPDLandPML = not na(pdl) and not na(pml) and close < pml and close > pdl

// ─────────────────────────────────────────────────────────────────────────────
// 8 EMA WAVE
// ─────────────────────────────────────────────────────────────────────────────
ema8WaveColor =
     abovePDHandPMH   ? col8Bull  :
     betweenPDHandPMH ? col8BullD :
     belowPDLandPML   ? col8Bear  :
     betweenPDLandPML ? col8BearD : col8Neut

isBearish8 = belowPDLandPML or betweenPDLandPML

purpleGlow = color.new(#9c27b0, 20)
redGlow    = color.new(#ff1744, 20)

ema8Top    = math.max(ema8, ema9, ema10)
ema8Mid    = ema9
ema8Bottom = math.min(ema8, ema9, ema10)

p8_bot = plot(show8Wave ? ema8Bottom : na, color=na, editable=false)
p8_mid = plot(show8Wave ? ema8Mid    : na, color=na, editable=false)
p8_top = plot(show8Wave ? ema8Top    : na, color=na, editable=false)

fill(p8_bot, p8_mid, color=ema8WaveColor,                     title="8 EMA Body")
fill(p8_mid, p8_top, color=isBearish8 ? redGlow : purpleGlow, title="8 EMA Top Glow")

// ─────────────────────────────────────────────────────────────────────────────
// 20 EMA WAVE
// ─────────────────────────────────────────────────────────────────────────────
ema20WaveColor =
     abovePDHandPMH   ? col20Bull  :
     betweenPDHandPMH ? col20BullD :
     belowPDLandPML   ? col20Bear  :
     betweenPDLandPML ? col20BearD : col20Neut

blueGlow    = color.new(#1565c0, 30)
ema20Top    = math.max(ema19, ema20, ema21)
ema20Mid    = ema20
ema20Bottom = math.min(ema19, ema20, ema21)

p20_bot = plot(show20Wave ? ema20Bottom : na, color=na, editable=false)
p20_mid = plot(show20Wave ? ema20Mid    : na, color=na, editable=false)
p20_top = plot(show20Wave ? ema20Top    : na, color=na, editable=false)

fill(p20_bot, p20_mid, color=ema20WaveColor, title="20 EMA Body")
fill(p20_mid, p20_top, color=blueGlow,       title="20 EMA Blue Top")

// ─────────────────────────────────────────────────────────────────────────────
// 200 EMA WAVE
// ─────────────────────────────────────────────────────────────────────────────
ema200Color  = close > ema200 ? col200Up : col200Down
ema200Top    = math.max(ema190, ema199, ema200)
ema200Bottom = math.min(ema190, ema199, ema200)

p200_bot = plot(show200Wave ? ema200Bottom : na, color=na, editable=false)
p200_top = plot(show200Wave ? ema200Top    : na, color=na, editable=false)
fill(p200_bot, p200_top, color=ema200Color, title="200 EMA Wave")

// ─────────────────────────────────────────────────────────────────────────────
// SETUP DETECTION
// ─────────────────────────────────────────────────────────────────────────────
validLevels    = not na(pdh) and not na(pdl) and not na(pmh) and not na(pml)
inSession      = isRegular

bullishOutside = validLevels and inSession and close > pdh and close > pmh
bearishOutside = validLevels and inSession and close < pdl and close < pml
bullishInside  = validLevels and inSession and close > pmh and close < pdh and close > pdl
bearishInside  = validLevels and inSession and close < pml and close > pdl and close < pdh

isBullishSetup =
     setupType == "Outside" ? bullishOutside :
     setupType == "Inside"  ? bullishInside  :
     bullishOutside or bullishInside

isBearishSetup =
     setupType == "Outside" ? bearishOutside :
     setupType == "Inside"  ? bearishInside  :
     bearishOutside or bearishInside

// ─────────────────────────────────────────────────────────────────────────────
// SIGNAL LOGIC
// ─────────────────────────────────────────────────────────────────────────────
buffer = close * 0.001
ema8NearLevel(lvl) => math.abs(ema8 - lvl) < (buffer * 5) or math.abs(close - lvl) < (buffer * 5)

bullishLevelRetest = isConfirmed and (
     (bullishOutside and (math.abs(low - pdh) < buffer * 5 or math.abs(low - pmh) < buffer * 5) and (ema8NearLevel(pdh) or ema8NearLevel(pmh))) or
     (bullishInside  and  math.abs(low - pmh) < buffer * 5 and ema8NearLevel(pmh)))

bearishLevelRetest = isConfirmed and (
     (bearishOutside and (math.abs(high - pdl) < buffer * 5 or math.abs(high - pml) < buffer * 5) and (ema8NearLevel(pdl) or ema8NearLevel(pml))) or
     (bearishInside  and  math.abs(high - pml) < buffer * 5 and ema8NearLevel(pml)))

touchedEMA_bull = isConfirmed and isBullishSetup and low  <= ema8Top    and low  >= ema8Bottom
touchedEMA_bear = isConfirmed and isBearishSetup and high >= ema8Bottom and high <= ema8Top

var float emaEntryHigh = na
var float emaEntryLow  = na
var bool  emaTB        = false
var bool  emaTBr       = false

if touchedEMA_bull and not emaTB
    emaTB        := true
    emaEntryHigh := high
if touchedEMA_bear and not emaTBr
    emaTBr       := true
    emaEntryLow  := low

bullishEMAConfirm = isConfirmed and emaTB  and close > emaEntryHigh
bearishEMAConfirm = isConfirmed and emaTBr and close < emaEntryLow

if not isBullishSetup
    emaTB        := false
    emaEntryHigh := na
if not isBearishSetup
    emaTBr       := false
    emaEntryLow  := na

longL  = entryType != "(E)MAs"   and bullishLevelRetest
longE  = entryType != "(L)evels" and bullishEMAConfirm
shortL = entryType != "(E)MAs"   and bearishLevelRetest
shortE = entryType != "(L)evels" and bearishEMAConfirm

// ─────────────────────────────────────────────────────────────────────────────
// MAX 3 SIGNALS
// ─────────────────────────────────────────────────────────────────────────────
var int  longCount   = 0
var int  shortCount  = 0
var bool prevBullish = false
var bool prevBearish = false

if isBullishSetup and not prevBullish
    longCount  := 0
if isBearishSetup and not prevBearish
    shortCount := 0

prevBullish := isBullishSetup
prevBearish := isBearishSetup

rawLong  = showLong  and (longL  or longE)
rawShort = showShort and (shortL or shortE)

longSig  = rawLong  and longCount  < 3
shortSig = rawShort and shortCount < 3

if longSig
    longCount  := longCount  + 1
if shortSig
    shortCount := shortCount + 1

eMarkBull = isConfirmed and touchedEMA_bull and not touchedEMA_bull[1] and isBullishSetup and entryType != "(L)evels" and longCount < 3
eMarkBear = isConfirmed and touchedEMA_bear and not touchedEMA_bear[1] and isBearishSetup and entryType != "(L)evels" and shortCount < 3

// ─────────────────────────────────────────────────────────────────────────────
// PLOT SIGNALS — styled to match Image 1 (pentagon badge, glow effect)
// ─────────────────────────────────────────────────────────────────────────────

// Long (L) — large green pentagon below bar, black text
plotshape(longSig and longL,
     title="Long (L)", location=location.belowbar,
     style=shape.labelup, color=color.new(#00e676, 0),
     textcolor=color.new(#000000, 0), text="L", size=size.normal)

// Long (E) — large green pentagon below bar, black text
plotshape(longSig and longE,
     title="Long (E)", location=location.belowbar,
     style=shape.labelup, color=color.new(#00e676, 0),
     textcolor=color.new(#000000, 0), text="E", size=size.normal)

// Short (L) — large red pentagon above bar, black text
plotshape(shortSig and shortL,
     title="Short (L)", location=location.abovebar,
     style=shape.labeldown, color=color.new(#ff1744, 0),
     textcolor=color.new(#000000, 0), text="L", size=size.normal)

// Short (E) — large red pentagon above bar, black text
plotshape(shortSig and shortE,
     title="Short (E)", location=location.abovebar,
     style=shape.labeldown, color=color.new(#ff1744, 0),
     textcolor=color.new(#000000, 0), text="E", size=size.normal)

// Bull EMA Touch marker — dark fill with bright green border via label
plotshape(eMarkBull,
     title="Bull EMA Touch", location=location.belowbar,
     style=shape.labelup, color=color.new(#00e676, 0),
     textcolor=color.new(#000000, 0), text="E", size=size.small)

// Bear EMA Touch marker
plotshape(eMarkBear,
     title="Bear EMA Touch", location=location.abovebar,
     style=shape.labeldown, color=color.new(#ff1744, 0),
     textcolor=color.new(#000000, 0), text="E", size=size.small)

// ─────────────────────────────────────────────────────────────────────────────
// TRAILING STOP-LOSS
// ─────────────────────────────────────────────────────────────────────────────
var float trailLong  = na
var float trailShort = na

if useTrailSL
    if longSig
        trailLong := low * (1 - candleClosePct / 100)
    if longCount > 0 and not na(trailLong)
        trailLong := math.max(trailLong, low * (1 - candleClosePct / 100))
    if shortSig
        trailShort := high * (1 + candleClosePct / 100)
    if shortCount > 0 and not na(trailShort)
        trailShort := math.min(trailShort, high * (1 + candleClosePct / 100))
    if longCount == 0
        trailLong  := na
    if shortCount == 0
        trailShort := na

plot(useTrailSL and longCount  > 0 ? trailLong  : na, "Long SL",  color=color.new(#00e676, 20), style=plot.style_linebr, linewidth=1)
plot(useTrailSL and shortCount > 0 ? trailShort : na, "Short SL", color=color.new(#ff5252, 20), style=plot.style_linebr, linewidth=1)

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(longL,  "Long (L)evels Signal",  "LE Levels: Long (L)evels triggered")
alertcondition(longE,  "Long (E)MA Signal",     "LE Levels: Long (E)MA triggered")
alertcondition(shortL, "Short (L)evels Signal", "LE Levels: Short (L)evels triggered")
alertcondition(shortE, "Short (E)MA Signal",    "LE Levels: Short (E)MA triggered")
