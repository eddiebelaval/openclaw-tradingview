//@version=6
strategy("Holy Grail - Linda Raschke (v6)", 
     overlay          = true,
     margin_long      = 100,
     margin_short     = 100,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value= 100,
     pyramiding       = 0)

// ────────────────────────────────────────
// Inputs (unchanged)
// ────────────────────────────────────────
int    adxLen       = input.int(14,  "ADX Length")
int    adxThresh    = input.int(30,  "ADX Threshold (> for trend)")
int    exitAdxWeak  = input.int(25,  "ADX Exit when falls below")
int    emaLen       = input.int(20,  "EMA Length")
bool   useEma       = input.bool(true, "Use EMA instead of SMA")
float  trailMult    = input.float(2.5, "Trailing ATR Multiplier", step=0.1)
int    atrLen       = input.int(14, "ATR Length for trailing")

ma = useEma ? ta.ema(close, emaLen) : ta.sma(close, emaLen)

// ────────────────────────────────────────
// Indicators (unchanged)
// ────────────────────────────────────────
[diplus, diminus, adx] = ta.dmi(adxLen, adxLen)

bool adxRising  = adx > adx[1]
bool strongUp   = adx > adxThresh and adxRising and close > ma
bool strongDown = adx > adxThresh and adxRising and close < ma

bool pullLong   = low <= ma and strongUp
bool pullShort  = high >= ma and strongDown

float buyTrigger  = high
float sellTrigger = low

// ────────────────────────────────────────
// Entries (unchanged)
// ────────────────────────────────────────
if pullLong[1]
    strategy.entry("Long", strategy.long, limit = buyTrigger[1], comment = "HG Long")

if pullShort[1]
    strategy.entry("Short", strategy.short, limit = sellTrigger[1], comment = "HG Short")

// ────────────────────────────────────────
// Stops & Exits — FIXED HERE
// ────────────────────────────────────────
// Initial fixed stop (use comment_loss for SL-specific label in trade list)
strategy.exit("SL Long",  from_entry = "Long",  stop = low[1],  comment_loss = "SL hit")
strategy.exit("SL Short", from_entry = "Short", stop = high[1], comment_loss = "SL hit")

// Trailing stop (ATR-based)
float atrVal = ta.atr(atrLen)
strategy.exit("Trail Long",  "Long",  trail_points = atrVal * trailMult * syminfo.mintick, trail_offset = 0, comment_trailing = "Trail hit")
strategy.exit("Trail Short", "Short", trail_points = atrVal * trailMult * syminfo.mintick, trail_offset = 0, comment_trailing = "Trail hit")

// Trend weaken exit (uses general comment)
if strategy.position_size > 0 and adx < exitAdxWeak
    strategy.close("Long", comment = "ADX weak exit")

if strategy.position_size < 0 and adx < exitAdxWeak
    strategy.close("Short", comment = "ADX weak exit")

// ────────────────────────────────────────
// Plots & Visuals (unchanged)
// ────────────────────────────────────────
plot(ma, "20 MA", color = color.orange, linewidth = 2)

plotshape(pullLong,  title = "Long Setup",  style = shape.labelup,   location = location.belowbar, color = color.green,  text = "HG L", textcolor = color.white, size = size.small)
plotshape(pullShort, title = "Short Setup", style = shape.labeldown, location = location.abovebar, color = color.red,    text = "HG S", textcolor = color.white, size = size.small)

bgcolor(strongUp   ? color.new(color.green, 92) : na, title = "Strong Up")
bgcolor(strongDown ? color.new(color.red,   92) : na, title = "Strong Dn")
