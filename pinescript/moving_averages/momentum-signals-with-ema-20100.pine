//@version=5
indicator("Momentum Signals with EMA 20/100", overlay=true)

// === Momentum Settings ===
atrLen   = input.int(14, "ATR Length")
atrMult  = input.float(0.9, "Body vs ATR Multiplier")
rocLen   = input.int(3, "Momentum Length")
breakLen = input.int(3, "Breakout Lookback")
volMult  = input.float(1.1, "Volume Multiplier")

// === ATR & Momentum ===
atr = ta.atr(atrLen)
roc = ta.roc(close, rocLen)

// === Candle Body Size ===
body = math.abs(close - open)

// === Breakout Detection ===
highBreak = close > ta.highest(high, breakLen)[1]
lowBreak  = close < ta.lowest(low, breakLen)[1]

// === Volume Filter ===
volFilter = volume > ta.sma(volume, 20) * volMult

// === Momentum Impulse Condition ===
momentumImpulse = body > atr * atrMult and volFilter

// === EMA High / Low Channels ===
ema20High = ta.ema(high, 20)
ema20Low  = ta.ema(low, 20)

ema100High = ta.ema(high, 100)
ema100Low  = ta.ema(low, 100)

// === Trend Filters ===
longFilter  = close > ema100Low
shortFilter = close < ema100High

// === Final Signals ===
longSignal  = momentumImpulse and roc > 0 and highBreak and longFilter
shortSignal = momentumImpulse and roc < 0 and lowBreak and shortFilter

// === Plot EMAs ===
plot(ema20High, color=color.orange, title="EMA 20 High")
plot(ema20Low,  color=color.orange, title="EMA 20 Low")

plot(ema100High, color=color.red, title="EMA 100 High")
plot(ema100Low,  color=color.red, title="EMA 100 Low")

// === Plot Signals ===
plotshape(longSignal, title="Long Signal", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small)

plotshape(shortSignal, title="Short Signal", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)

// === Alerts ===
signal = longSignal or shortSignal
alertcondition(signal, title="Momentum Signal", message="Momentum Signal with EMA 20/100 detected")
