//@version=5
indicator("MTF Trend Dashboard V2", overlay=true)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
smaLen      = input.int(15, "SMA Length", minval=1)
tablePos    = input.string("Top Center", "Dashboard Position", options=["Top Center", "Top Right", "Top Left"])
textSize    = input.string("Large", "Text Size", options=["Small", "Normal", "Large", "Huge"])
topPadding  = input.int(2, "Top Padding (Increase to lower table)", minval=0, maxval=10)

// ─── TIMEFRAME SMA & PRICE DATA ───────────────────────────────────────────────
sma_1H  = request.security(syminfo.tickerid, "60",   ta.sma(close, smaLen), lookahead=barmerge.lookahead_on)
sma_4H  = request.security(syminfo.tickerid, "240",  ta.sma(close, smaLen), lookahead=barmerge.lookahead_on)
sma_1D  = request.security(syminfo.tickerid, "1D",   ta.sma(close, smaLen), lookahead=barmerge.lookahead_on)
sma_1W  = request.security(syminfo.tickerid, "1W",   ta.sma(close, smaLen), lookahead=barmerge.lookahead_on)

close_1H = request.security(syminfo.tickerid, "60",  close, lookahead=barmerge.lookahead_on)
close_4H = request.security(syminfo.tickerid, "240", close, lookahead=barmerge.lookahead_on)
close_1D = request.security(syminfo.tickerid, "1D",  close, lookahead=barmerge.lookahead_on)
close_1W = request.security(syminfo.tickerid, "1W",  close, lookahead=barmerge.lookahead_on)

// ─── SIGNAL LOGIC ─────────────────────────────────────────────────────────────
up_1H  = close_1H > sma_1H
up_4H  = close_4H > sma_4H
up_1D  = close_1D > sma_1D
up_1W  = close_1W > sma_1W

// ─── TABLE POSITION & SIZE LOGIC ──────────────────────────────────────────────
var pos = position.top_center
if tablePos == "Top Right"
    pos := position.top_right
else if tablePos == "Top Left"
    pos := position.top_left

tSize = size.normal
if textSize == "Small"
    tSize := size.small
else if textSize == "Large"
    tSize := size.large
else if textSize == "Huge"
    tSize := size.huge

// ─── BUILD DASHBOARD TABLE ────────────────────────────────────────────────────
// We add extra rows to account for the "Top Padding"
var table dash = table.new(pos, 5, 2 + topPadding, 
     border_width=1, 
     border_color=color.new(color.gray, 50),
     frame_color=color.new(color.gray, 50),
     frame_width=1)

if barstate.islast
    // Clear table to prevent ghosting
    table.clear(dash, 0, 0, 4, 1 + topPadding)

    // ── Padding Rows (Invisible) ──
    if topPadding > 0
        for i = 0 to topPadding - 1
            table.cell(dash, 0, i, "", bgcolor=color.new(color.black, 100))

    // ── Header Row (Shifted down by topPadding) ──
    int hRow = topPadding
    table.cell(dash, 0, hRow, "Timeframe", text_color=color.white, text_size=tSize, bgcolor=color.new(color.black, 20))
    table.cell(dash, 1, hRow, "1 HR",      text_color=color.white, text_size=tSize, bgcolor=color.new(color.black, 20))
    table.cell(dash, 2, hRow, "4 HR",      text_color=color.white, text_size=tSize, bgcolor=color.new(color.black, 20))
    table.cell(dash, 3, hRow, "1 D",       text_color=color.white, text_size=tSize, bgcolor=color.new(color.black, 20))
    table.cell(dash, 4, hRow, "1 W",       text_color=color.white, text_size=tSize, bgcolor=color.new(color.black, 20))

    // ── Signal Row (Shifted down by topPadding + 1) ──
    int sRow = topPadding + 1
    table.cell(dash, 0, sRow, "SMA " + str.tostring(smaLen), text_color=color.white, text_size=tSize, bgcolor=color.new(color.black, 20))

    // 1 HR
    table.cell(dash, 1, sRow, up_1H ? "▲ UP" : "▼ DOWN", text_color=up_1H ? color.lime : color.red, text_size=tSize, bgcolor=up_1H ? color.new(color.green, 75) : color.new(color.red, 75))
    // 4 HR
    table.cell(dash, 2, sRow, up_4H ? "▲ UP" : "▼ DOWN", text_color=up_4H ? color.lime : color.red, text_size=tSize, bgcolor=up_4H ? color.new(color.green, 75) : color.new(color.red, 75))
    // 1 D
    table.cell(dash, 3, sRow, up_1D ? "▲ UP" : "▼ DOWN", text_color=up_1D ? color.lime : color.red, text_size=tSize, bgcolor=up_1D ? color.new(color.green, 75) : color.new(color.red, 75))
    // 1 W
    table.cell(dash, 4, sRow, up_1W ? "▲ UP" : "▼ DOWN", text_color=up_1W ? color.lime : color.red, text_size=tSize, bgcolor=up_1W ? color.new(color.green, 75) : color.new(color.red, 75))
