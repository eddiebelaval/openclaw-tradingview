//@version=5
indicator("Intraday System: ORB + MAs + VWAPs", overlay=true, max_labels_count=500, max_lines_count=500)

// ========================================================================= //
// 1. USER INPUTS (VISIBILITY TOGGLES)
// ========================================================================= //
grp_toggles = "=== VISIBILITY TOGGLES ==="
showMAs   = input.bool(true, title="Show EMAs (9 & 21)", group=grp_toggles)
showHMA   = input.bool(true, title="Show HMA (55)", group=grp_toggles)
showVWAPs = input.bool(true, title="Show All VWAPs", group=grp_toggles)
showDash  = input.bool(true, title="Show Distance Dashboard", group=grp_toggles)

grp_ma = "Moving Averages"
emaFastLen = input.int(9, title="Fast EMA Length", group=grp_ma)
emaSlowLen = input.int(21, title="Slow EMA Length", group=grp_ma)
hmaLen     = input.int(55, title="HMA Length", group=grp_ma)

grp_vwap = "VWAP Settings"
rvwapLen   = input.int(75, title="Rolling VWAP 1 Length (5m)", group=grp_vwap)
rvwap2Len  = input.int(14, title="Rolling VWAP 2 Length (5m)", group=grp_vwap)

grp_or = "Opening Range & Targets"
orSession  = input.session("0915-0930", title="OR Session", group=grp_or)
showFibs   = input.bool(true, title="Show Fib Targets/Reversals?", group=grp_or)
show15mRev = input.bool(true, title="Show 15m Reversal Candles?", group=grp_or)
revProx    = input.float(0.1, title="Reversal Warning Threshold (%)", step=0.05, group=grp_or) / 100.0

grp_pd = "Previous Day Levels"
showPDL    = input.bool(true, title="Show PDH/PDL/PDC?", group=grp_pd)

// ========================================================================= //
// 2. MAs, VWAPs & DAILY LEVEL CALCULATIONS
// ========================================================================= //
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
hma     = ta.hma(close, hmaLen)

dailyVwap = ta.vwap(close)
rvwap  = math.sum(hlc3 * volume, rvwapLen) / math.sum(volume, rvwapLen)
rvwap2 = math.sum(hlc3 * volume, rvwap2Len) / math.sum(volume, rvwap2Len)

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
pdc = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)

// ========================================================================= //
// 3. SESSION & OR CALCULATIONS
// ========================================================================= //
var float m5High = na, var float m5Low  = na
var float orHigh = na, var float orLow  = na
var float p_orHigh = na, var float p_orLow  = na

var int currentSessionStart = na, var int prevSessionStart = na, var int prevSessionEnd = na

var line m5hLine = na, var line m5lLine = na
var line orhLine = na, var line orlLine = na
var line l_upT1 = na, var line l_upT2 = na, var line l_upT3 = na, var line l_upRev = na
var line l_dnT1 = na, var line l_dnT2 = na, var line l_dnT3 = na, var line l_dnRev = na

var bool hit_up1 = false, var bool hit_up2 = false, var bool hit_up3 = false, var bool hit_upR = false
var bool hit_dn1 = false, var bool hit_dn2 = false, var bool hit_dn3 = false, var bool hit_dnR = false

inSession = not na(time(timeframe.period, orSession, "Asia/Kolkata"))
isNewSession = inSession and not inSession[1]

if isNewSession
    p_orHigh := orHigh, p_orLow  := orLow
    prevSessionEnd := bar_index - 1
    prevSessionStart := currentSessionStart
    currentSessionStart := bar_index
    
    hit_up1 := false, hit_up2 := false, hit_up3 := false, hit_upR := false
    hit_dn1 := false, hit_dn2 := false, hit_dn3 := false, hit_dnR := false

    if not na(orhLine)
        line.set_extend(orhLine, extend.none), line.set_x2(orhLine, bar_index)
        line.set_extend(orlLine, extend.none), line.set_x2(orlLine, bar_index)
        line.set_extend(m5hLine, extend.none), line.set_x2(m5hLine, bar_index)
        line.set_extend(m5lLine, extend.none), line.set_x2(m5lLine, bar_index)
        line.set_extend(l_upT1, extend.none), line.set_x2(l_upT1, bar_index)
        line.set_extend(l_upT2, extend.none), line.set_x2(l_upT2, bar_index)
        line.set_extend(l_upT3, extend.none), line.set_x2(l_upT3, bar_index)
        line.set_extend(l_upRev, extend.none), line.set_x2(l_upRev, bar_index)
        line.set_extend(l_dnT1, extend.none), line.set_x2(l_dnT1, bar_index)
        line.set_extend(l_dnT2, extend.none), line.set_x2(l_dnT2, bar_index)
        line.set_extend(l_dnT3, extend.none), line.set_x2(l_dnT3, bar_index)
        line.set_extend(l_dnRev, extend.none), line.set_x2(l_dnRev, bar_index)
        
    if not na(prevSessionStart)
        int midBar = math.round((prevSessionStart + prevSessionEnd) / 2)
        int offset = bar_index - midBar 
        
        if showVWAPs
            label.new(midBar, dailyVwap[offset], "VWAP", color=color.black, textcolor=color.white, style=label.style_label_down, size=size.small)
            label.new(midBar, rvwap[offset], "RVWAP " + str.tostring(rvwapLen), color=color.gray, textcolor=color.white, style=label.style_label_down, size=size.small)
            label.new(midBar, rvwap2[offset], "RVWAP " + str.tostring(rvwap2Len), color=color.teal, textcolor=color.white, style=label.style_label_down, size=size.small)

        if showPDL
            label.new(midBar, pdh[offset], "PDH", color=color.gray, textcolor=color.white, style=label.style_label_down, size=size.small)
            label.new(midBar, pdl[offset], "PDL", color=color.gray, textcolor=color.white, style=label.style_label_down, size=size.small)
            label.new(midBar, pdc[offset], "PDC", color=color.gray, textcolor=color.white, style=label.style_label_down, size=size.small)

        if showFibs and not na(p_orHigh) and not na(p_orLow)
            float p_orRange = p_orHigh - p_orLow
            float p_upT1  = p_orLow + (p_orRange * 1.272), float p_upT2  = p_orLow + (p_orRange * 1.618), float p_upT3  = p_orLow + (p_orRange * 2.000), float p_upRev = p_orLow + (p_orRange * 2.618)
            float p_dnT1  = p_orHigh - (p_orRange * 1.272), float p_dnT2  = p_orHigh - (p_orRange * 1.618), float p_dnT3  = p_orHigh - (p_orRange * 2.000), float p_dnRev = p_orHigh - (p_orRange * 2.618)
            
            line.new(prevSessionStart, p_upT1, prevSessionEnd, p_upT1, color=color.new(color.green, 20), style=line.style_dotted)
            line.new(prevSessionStart, p_upT2, prevSessionEnd, p_upT2, color=color.new(color.green, 20), style=line.style_dotted)
            line.new(prevSessionStart, p_upT3, prevSessionEnd, p_upT3, color=color.new(color.green, 20), style=line.style_dotted)
            line.new(prevSessionStart, p_upRev, prevSessionEnd, p_upRev, color=color.new(color.red, 0), style=line.style_solid, width=2)
            
            line.new(prevSessionStart, p_dnT1, prevSessionEnd, p_dnT1, color=color.new(color.red, 20), style=line.style_dotted)
            line.new(prevSessionStart, p_dnT2, prevSessionEnd, p_dnT2, color=color.new(color.red, 20), style=line.style_dotted)
            line.new(prevSessionStart, p_dnT3, prevSessionEnd, p_dnT3, color=color.new(color.red, 20), style=line.style_dotted)
            line.new(prevSessionStart, p_dnRev, prevSessionEnd, p_dnRev, color=color.new(color.green, 0), style=line.style_solid, width=2)
            
            label.new(midBar, p_upT1, "T1", color=color.green, textcolor=color.white, style=label.style_label_down, size=size.small)
            label.new(midBar, p_upT2, "T2", color=color.green, textcolor=color.white, style=label.style_label_down, size=size.small)
            label.new(midBar, p_upT3, "T3", color=color.green, textcolor=color.white, style=label.style_label_down, size=size.small)
            label.new(midBar, p_upRev, "REV (⬇)", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)
            
            label.new(midBar, p_dnT1, "T1", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)
            label.new(midBar, p_dnT2, "T2", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)
            label.new(midBar, p_dnT3, "T3", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)
            label.new(midBar, p_dnRev, "REV (⬆)", color=color.green, textcolor=color.white, style=label.style_label_down, size=size.small)

    m5High := high, m5Low  := low
    orHigh := high, orLow  := low
    
    m5hLine := line.new(bar_index, m5High, bar_index, m5High, color=color.new(color.blue, 0), style=line.style_solid, width=1, extend=extend.right)
    m5lLine := line.new(bar_index, m5Low, bar_index, m5Low, color=color.new(color.orange, 0), style=line.style_solid, width=1, extend=extend.right)
    orhLine := line.new(bar_index, orHigh, bar_index, orHigh, color=color.new(color.green, 0), style=line.style_solid, width=2, extend=extend.right)
    orlLine := line.new(bar_index, orLow, bar_index, orLow, color=color.new(color.red, 0), style=line.style_solid, width=2, extend=extend.right)
    
    l_upT1 := line.new(bar_index, high, bar_index, high, color=color.new(color.green, 20), style=line.style_dotted, width=1, extend=extend.right)
    l_upT2 := line.new(bar_index, high, bar_index, high, color=color.new(color.green, 20), style=line.style_dotted, width=1, extend=extend.right)
    l_upT3 := line.new(bar_index, high, bar_index, high, color=color.new(color.green, 20), style=line.style_dotted, width=1, extend=extend.right)
    l_upRev := line.new(bar_index, high, bar_index, high, color=color.new(color.red, 0), style=line.style_dotted, width=2, extend=extend.right)
    
    l_dnT1 := line.new(bar_index, low, bar_index, low, color=color.new(color.red, 20), style=line.style_dotted, width=1, extend=extend.right)
    l_dnT2 := line.new(bar_index, low, bar_index, low, color=color.new(color.red, 20), style=line.style_dotted, width=1, extend=extend.right)
    l_dnT3 := line.new(bar_index, low, bar_index, low, color=color.new(color.red, 20), style=line.style_dotted, width=1, extend=extend.right)
    l_dnRev := line.new(bar_index, low, bar_index, low, color=color.new(color.green, 0), style=line.style_dotted, width=2, extend=extend.right)

else if inSession
    orHigh := math.max(orHigh, high), orLow  := math.min(orLow, low)
    line.set_y1(orhLine, orHigh), line.set_y2(orhLine, orHigh)
    line.set_y1(orlLine, orLow), line.set_y2(orlLine, orLow)
    
    tempRange = orHigh - orLow
    if showFibs
        line.set_y1(l_upT1, orLow + (tempRange * 1.272)), line.set_y2(l_upT1, orLow + (tempRange * 1.272))
        line.set_y1(l_upT2, orLow + (tempRange * 1.618)), line.set_y2(l_upT2, orLow + (tempRange * 1.618))
        line.set_y1(l_upT3, orLow + (tempRange * 2.000)), line.set_y2(l_upT3, orLow + (tempRange * 2.000))
        line.set_y1(l_upRev, orLow + (tempRange * 2.618)), line.set_y2(l_upRev, orLow + (tempRange * 2.618))
        
        line.set_y1(l_dnT1, orHigh - (tempRange * 1.272)), line.set_y2(l_dnT1, orHigh - (tempRange * 1.272))
        line.set_y1(l_dnT2, orHigh - (tempRange * 1.618)), line.set_y2(l_dnT2, orHigh - (tempRange * 1.618))
        line.set_y1(l_dnT3, orHigh - (tempRange * 2.000)), line.set_y2(l_dnT3, orHigh - (tempRange * 2.000))
        line.set_y1(l_dnRev, orHigh - (tempRange * 2.618)), line.set_y2(l_dnRev, orHigh - (tempRange * 2.618))

// ========================================================================= //
// 4. CHECKMARKS & ALERTS
// ========================================================================= //
orRange = orHigh - orLow
upT1 = orLow + (orRange * 1.272), upT2 = orLow + (orRange * 1.618), upT3 = orLow + (orRange * 2.000), upRev = orLow + (orRange * 2.618)
dnT1 = orHigh - (orRange * 1.272), dnT2 = orHigh - (orRange * 1.618), dnT3 = orHigh - (orRange * 2.000), dnRev = orHigh - (orRange * 2.618)

if not inSession and showFibs and orRange > 0
    if not hit_up1 and high >= upT1
        hit_up1 := true, label.new(bar_index, upT1, "✓", color=color.new(color.white, 100), textcolor=color.green, style=label.style_none)
    if not hit_up2 and high >= upT2
        hit_up2 := true, label.new(bar_index, upT2, "✓", color=color.new(color.white, 100), textcolor=color.green, style=label.style_none)
    if not hit_up3 and high >= upT3
        hit_up3 := true, label.new(bar_index, upT3, "✓", color=color.new(color.white, 100), textcolor=color.green, style=label.style_none)
    if not hit_upR and high >= upRev
        hit_upR := true, label.new(bar_index, upRev, "✓", color=color.new(color.white, 100), textcolor=color.red, style=label.style_none)

    if not hit_dn1 and low <= dnT1
        hit_dn1 := true, label.new(bar_index, dnT1, "✓", color=color.new(color.white, 100), textcolor=color.red, style=label.style_none)
    if not hit_dn2 and low <= dnT2
        hit_dn2 := true, label.new(bar_index, dnT2, "✓", color=color.new(color.white, 100), textcolor=color.red, style=label.style_none)
    if not hit_dn3 and low <= dnT3
        hit_dn3 := true, label.new(bar_index, dnT3, "✓", color=color.new(color.white, 100), textcolor=color.red, style=label.style_none)
    if not hit_dnR and low <= dnRev
        hit_dnR := true, label.new(bar_index, dnRev, "✓", color=color.new(color.white, 100), textcolor=color.green, style=label.style_none)

nearUpRev = not inSession and upRev > 0 and (high >= upRev * (1 - revProx)) and (high <= upRev * (1 + revProx))
nearDnRev = not inSession and dnRev > 0 and (low <= dnRev * (1 + revProx))  and (low >= dnRev * (1 - revProx))
bgcolor(nearUpRev ? color.new(color.red, 90) : nearDnRev ? color.new(color.green, 90) : na)

// ========================================================================= //
// 5. PLOTTING MAs & VWAPs
// ========================================================================= //
plot(showMAs ? emaFast : na, title="Fast EMA", color=color.new(color.blue, 0), linewidth=1)
plot(showMAs ? emaSlow : na, title="Slow EMA", color=color.new(color.orange, 0), linewidth=2)
plot(showHMA ? hma : na, title="55 HMA", color=color.new(color.purple, 0), linewidth=2)

plot(showVWAPs ? dailyVwap : na, title="Daily VWAP", color=color.new(color.black, 0), linewidth=2)
plot(showVWAPs ? rvwap : na, title="Rolling VWAP 75", color=color.new(color.gray, 0), linewidth=2)
plot(showVWAPs ? rvwap2 : na, title="Rolling VWAP 14", color=color.new(color.teal, 0), linewidth=2)

plot(showPDL ? pdh : na, title="PDH", color=color.new(color.gray, 30), style=plot.style_linebr, linewidth=1)
plot(showPDL ? pdl : na, title="PDL", color=color.new(color.gray, 30), style=plot.style_linebr, linewidth=1)
plot(showPDL ? pdc : na, title="PDC", color=color.new(color.gray, 50), style=plot.style_linebr, linewidth=1)

// ========================================================================= //
// 6. CURRENT LABELS
// ========================================================================= //
var label l_orh = label.new(na, na, "", color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)
var label l_orl = label.new(na, na, "", color=color.red, textcolor=color.white, style=label.style_label_left, size=size.small)
var label l_5mh = label.new(na, na, "", color=color.blue, textcolor=color.white, style=label.style_label_left, size=size.small)
var label l_5ml = label.new(na, na, "", color=color.orange, textcolor=color.white, style=label.style_label_left, size=size.small)

var label l_t1_up = label.new(na, na, "", color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)
var label l_t2_up = label.new(na, na, "", color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)
var label l_t3_up = label.new(na, na, "", color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)
var label l_r_up  = label.new(na, na, "", color=color.red, textcolor=color.white, style=label.style_label_left, size=size.small) 

var label l_t1_dn = label.new(na, na, "", color=color.red, textcolor=color.white, style=label.style_label_left, size=size.small)
var label l_t2_dn = label.new(na, na, "", color=color.red, textcolor=color.white, style=label.style_label_left, size=size.small)
var label l_t3_dn = label.new(na, na, "", color=color.red, textcolor=color.white, style=label.style_label_left, size=size.small)
var label l_r_dn  = label.new(na, na, "", color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small) 

var label l_pdh = label.new(na, na, "", color=color.gray, textcolor=color.white, style=label.style_label_left, size=size.small)
var label l_pdl = label.new(na, na, "", color=color.gray, textcolor=color.white, style=label.style_label_left, size=size.small)
var label l_pdc = label.new(na, na, "", color=color.gray, textcolor=color.white, style=label.style_label_left, size=size.small)

var label lbl_emaF = label.new(na, na, "", color=color.blue, textcolor=color.white, style=label.style_label_left, size=size.small)
var label lbl_emaS = label.new(na, na, "", color=color.orange, textcolor=color.white, style=label.style_label_left, size=size.small)
var label lbl_hma  = label.new(na, na, "", color=color.purple, textcolor=color.white, style=label.style_label_left, size=size.small)
var label lbl_vwap = label.new(na, na, "", color=color.black, textcolor=color.white, style=label.style_label_left, size=size.small)
var label lbl_rvwap = label.new(na, na, "", color=color.gray, textcolor=color.white, style=label.style_label_left, size=size.small)
var label lbl_rvwap2 = label.new(na, na, "", color=color.teal, textcolor=color.white, style=label.style_label_left, size=size.small)

if barstate.islast
    int lbl_x = bar_index + 4
    
    if m5High == orHigh
        label.set_xy(l_orh, lbl_x, orHigh), label.set_text(l_orh, "ORH: " + str.tostring(orHigh, format.mintick))
        label.set_xy(l_5mh, na, na) 
    else
        label.set_xy(l_orh, lbl_x, orHigh), label.set_text(l_orh, "15m ORH: " + str.tostring(orHigh, format.mintick))
        label.set_xy(l_5mh, lbl_x, m5High), label.set_text(l_5mh, "5m ORH: " + str.tostring(m5High, format.mintick))

    if m5Low == orLow
        label.set_xy(l_orl, lbl_x, orLow), label.set_text(l_orl, "ORL: " + str.tostring(orLow, format.mintick))
        label.set_xy(l_5ml, na, na) 
    else
        label.set_xy(l_orl, lbl_x, orLow), label.set_text(l_orl, "15m ORL: " + str.tostring(orLow, format.mintick))
        label.set_xy(l_5ml, lbl_x, m5Low), label.set_text(l_5ml, "5m ORL: " + str.tostring(m5Low, format.mintick))

    if showPDL
        label.set_xy(l_pdh, lbl_x, pdh), label.set_text(l_pdh, "PDH: " + str.tostring(pdh, format.mintick))
        label.set_xy(l_pdl, lbl_x, pdl), label.set_text(l_pdl, "PDL: " + str.tostring(pdl, format.mintick))
        label.set_xy(l_pdc, lbl_x, pdc), label.set_text(l_pdc, "PDC: " + str.tostring(pdc, format.mintick))

    if showFibs and not inSession
        label.set_xy(l_t1_up, lbl_x, upT1), label.set_text(l_t1_up, "T1: " + str.tostring(upT1, format.mintick))
        label.set_xy(l_t2_up, lbl_x, upT2), label.set_text(l_t2_up, "T2: " + str.tostring(upT2, format.mintick))
        label.set_xy(l_t3_up, lbl_x, upT3), label.set_text(l_t3_up, "T3: " + str.tostring(upT3, format.mintick))
        label.set_xy(l_r_up, lbl_x, upRev), label.set_text(l_r_up, "REV (⬇): " + str.tostring(upRev, format.mintick))
        
        label.set_xy(l_t1_dn, lbl_x, dnT1), label.set_text(l_t1_dn, "T1: " + str.tostring(dnT1, format.mintick))
        label.set_xy(l_t2_dn, lbl_x, dnT2), label.set_text(l_t2_dn, "T2: " + str.tostring(dnT2, format.mintick))
        label.set_xy(l_t3_dn, lbl_x, dnT3), label.set_text(l_t3_dn, "T3: " + str.tostring(dnT3, format.mintick))
        label.set_xy(l_r_dn, lbl_x, dnRev), label.set_text(l_r_dn, "REV (⬆): " + str.tostring(dnRev, format.mintick))

    if bar_index > 25
        label.set_xy(lbl_emaF, showMAs ? bar_index - 9 : na, showMAs ? emaFast[9] : na), label.set_text(lbl_emaF, "EMA " + str.tostring(emaFastLen))
        label.set_xy(lbl_emaS, showMAs ? bar_index - 12 : na, showMAs ? emaSlow[12] : na), label.set_text(lbl_emaS, "EMA " + str.tostring(emaSlowLen))
        label.set_xy(lbl_hma, showHMA ? bar_index - 15 : na, showHMA ? hma[15] : na), label.set_text(lbl_hma, "HMA " + str.tostring(hmaLen))
        label.set_xy(lbl_vwap, showVWAPs ? bar_index - 18 : na, showVWAPs ? dailyVwap[18] : na), label.set_text(lbl_vwap, "VWAP")
        label.set_xy(lbl_rvwap, showVWAPs ? bar_index - 21 : na, showVWAPs ? rvwap[21] : na), label.set_text(lbl_rvwap, "RVWAP " + str.tostring(rvwapLen))
        label.set_xy(lbl_rvwap2, showVWAPs ? bar_index - 24 : na, showVWAPs ? rvwap2[24] : na), label.set_text(lbl_rvwap2, "RVWAP " + str.tostring(rvwap2Len))

    line.set_x2(orhLine, bar_index + 1), line.set_x2(orlLine, bar_index + 1)
    if showFibs
        line.set_x2(l_upT1, bar_index + 1), line.set_x2(l_upT2, bar_index + 1), line.set_x2(l_upT3, bar_index + 1), line.set_x2(l_upRev, bar_index + 1)
        line.set_x2(l_dnT1, bar_index + 1), line.set_x2(l_dnT2, bar_index + 1), line.set_x2(l_dnT3, bar_index + 1), line.set_x2(l_dnRev, bar_index + 1)

// ========================================================================= //
// 7. DISTANCE DASHBOARD
// ========================================================================= //
var table dash = table.new(position.bottom_right, 2, 5, bgcolor=color.new(color.white, 5), border_width=1, border_color=color.new(color.gray, 80))

if barstate.islast and showDash
    float minResDist = 999999
    float minSupDist = 999999
    string resName = "None"
    string supName = "None"
    
    if orRange > 0
        float[] levels = array.from(upRev, upT3, upT2, upT1, orHigh, orLow, dnT1, dnT2, dnT3, dnRev)
        string[] names = array.from("Up REV", "Up T3", "Up T2", "Up T1", "ORH", "ORL", "Dn T1", "Dn T2", "Dn T3", "Dn REV")
        
        for i = 0 to array.size(levels) - 1
            float lvl = array.get(levels, i)
            string n = array.get(names, i)
            
            if lvl > close and (lvl - close) < minResDist
                minResDist := lvl - close
                resName := n
            else if lvl <= close and (close - lvl) < minSupDist
                minSupDist := close - lvl
                supName := n

    table.cell(dash, 0, 0, "Distance To:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 0, "Points", text_color=color.gray, text_size=size.small, text_halign=text.align_right)
    
    table.cell(dash, 0, 1, "Resistance (" + resName + ")", text_color=color.red, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 1, str.tostring(minResDist == 999999 ? 0 : minResDist, format.mintick), text_color=color.red, text_size=size.small, text_halign=text.align_right)
    
    table.cell(dash, 0, 2, "Support (" + supName + ")", text_color=color.green, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 2, str.tostring(minSupDist == 999999 ? 0 : minSupDist, format.mintick), text_color=color.green, text_size=size.small, text_halign=text.align_right)
    
    table.cell(dash, 0, 3, "Daily VWAP", text_color=color.black, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 3, str.tostring(math.abs(close - dailyVwap), format.mintick), text_color=color.black, text_size=size.small, text_halign=text.align_right)
    
    table.cell(dash, 0, 4, "RVWAP " + str.tostring(rvwapLen), text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 4, str.tostring(math.abs(close - rvwap), format.mintick), text_color=color.gray, text_size=size.small, text_halign=text.align_right)

// ========================================================================= //
// 8. MULTI-TIMEFRAME (15m) REVERSAL PATTERN ENGINE (ALTERNATING FILTER)
// ========================================================================= //
detectReversals() =>
    b = math.abs(close - open)
    rng = high - low
    
    ham = (math.min(open, close) - low) >= (2 * b) and (high - math.max(open, close)) <= b and b > 0
    star = (high - math.max(open, close)) >= (2 * b) and (math.min(open, close) - low) <= b and b > 0
    bullE = close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and close > close[1]
    bearE = close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and close < close[1]
    
    [ham, star, bullE, bearE]

[isHam15, isStar15, isBullEng15, isBearEng15] = request.security(syminfo.tickerid, "15", detectReversals())

new15m = ta.change(time("15")) != 0

// State Tracker (1 = Buy Signal, -1 = Sell Signal, 0 = None)
var int last15mSignal = 0

bool plotHam = false
bool plotStar = false
bool plotBullE = false
bool plotBearE = false

if show15mRev and new15m
    bool isBuySignal = isHam15[1] or isBullEng15[1]
    bool isSellSignal = isStar15[1] or isBearEng15[1]
    
    // Process Buy Signals (Only if last signal wasn't a buy)
    if isBuySignal and last15mSignal != 1
        last15mSignal := 1
        if isHam15[1]
            plotHam := true
        else
            plotBullE := true
            
    // Process Sell Signals (Only if last signal wasn't a sell)
    else if isSellSignal and last15mSignal != -1
        last15mSignal := -1
        if isStar15[1]
            plotStar := true
        else
            plotBearE := true

plotshape(plotHam, title="15m Hammer", text="15m Ham", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, offset=-1, textcolor=color.green)
plotshape(plotStar, title="15m Shooting Star", text="15m Star", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, offset=-1, textcolor=color.red)
plotshape(plotBullE, title="15m Bull Engulf", text="15m B.Eng", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, offset=-1, textcolor=color.green)
plotshape(plotBearE, title="15m Bear Engulf", text="15m Br.Eng", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, offset=-1, textcolor=color.red)
