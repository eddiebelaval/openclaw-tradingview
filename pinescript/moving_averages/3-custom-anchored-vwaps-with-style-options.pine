//@version=6
indicator("3 Custom Anchored VWAPs with Style Options", overlay = true)

// --- User Defined Type for VWAP Results ---
type vwap_info
    float price
    float deviation
    bool  isAnchor
    int   anchorTime

// --- Helper Function for VWAP & Dev Calculation ---
f_anchored_vwap(_src, _anchorTime) =>
    var float sumSrcVol   = 0.0
    var float sumVol      = 0.0
    var float sumSrcSqVol = 0.0
    
    isAfterAnchor = time >= _anchorTime
    isAnchorBar   = isAfterAnchor and not isAfterAnchor[1]
    
    if isAnchorBar
        sumSrcVol   := _src * volume
        sumVol      := volume
        sumSrcSqVol := math.pow(_src, 2) * volume
    else if isAfterAnchor
        sumSrcVol   += _src * volume
        sumVol      += volume
        sumSrcSqVol += math.pow(_src, 2) * volume
        
    vwapValue = sumVol > 0 ? sumSrcVol / sumVol : na
    variance  = sumVol > 0 ? (sumSrcSqVol / sumVol) - math.pow(vwapValue, 2) : 0
    devValue  = math.sqrt(math.max(0, variance))
    
    vwap_info.new(vwapValue, devValue, isAnchorBar, time)

// --- Style Options ---
STYLE_LINE     = "Line"
STYLE_STEPLINE = "Step Line"
STYLE_CIRCLES  = "Circles (Dotted)"
STYLE_CROSS    = "Cross"
STYLE_AREA     = "Area"

// --- Inputs: VWAP 1 ---
group1      = "VWAP 1 Settings"
useVWAP1    = input.bool(true, "Enable VWAP 1", group = group1)
startTime1  = input.time(timestamp("2024-01-01 09:30"), "Start Date & Time", group = group1)
color1      = input.color(color.blue, "Color", group = group1)
width1      = input.int(2, "Width", minval = 1, group = group1)
style1      = input.string(STYLE_LINE, "Line Shape", options = [STYLE_LINE, STYLE_STEPLINE, STYLE_CIRCLES, STYLE_CROSS, STYLE_AREA], group = group1)
showBands1  = input.bool(true, "Show Bands", group = group1)
mult1       = input.float(1.0, "Band Multiplier", minval = 0.1, step = 0.1, group = group1)

// --- Inputs: VWAP 2 ---
group2      = "VWAP 2 Settings"
useVWAP2    = input.bool(true, "Enable VWAP 2", group = group2)
startTime2  = input.time(timestamp("2024-02-01 09:30"), "Start Date & Time", group = group2)
color2      = input.color(color.orange, "Color", group = group2)
width2      = input.int(2, "Width", minval = 1, group = group2)
style2      = input.string(STYLE_LINE, "Line Shape", options = [STYLE_LINE, STYLE_STEPLINE, STYLE_CIRCLES, STYLE_CROSS, STYLE_AREA], group = group2)
showBands2  = input.bool(true, "Show Bands", group = group2)
mult2       = input.float(1.0, "Band Multiplier", minval = 0.1, step = 0.1, group = group2)

// --- Inputs: VWAP 3 ---
group3      = "VWAP 3 Settings"
useVWAP3    = input.bool(true, "Enable VWAP 3", group = group3)
startTime3  = input.time(timestamp("2024-03-01 09:30"), "Start Date & Time", group = group3)
color3      = input.color(color.purple, "Color", group = group3)
width3      = input.int(2, "Width", minval = 1, group = group3)
style3      = input.string(STYLE_LINE, "Line Shape", options = [STYLE_LINE, STYLE_STEPLINE, STYLE_CIRCLES, STYLE_CROSS, STYLE_AREA], group = group3)
showBands3  = input.bool(true, "Show Bands", group = group3)
mult3       = input.float(1.0, "Band Multiplier", minval = 0.1, step = 0.1, group = group3)

// --- Calculations ---
v1 = useVWAP1 ? f_anchored_vwap(hlc3, startTime1) : vwap_info.new(na, na, false, 0)
v2 = useVWAP2 ? f_anchored_vwap(hlc3, startTime2) : vwap_info.new(na, na, false, 0)
v3 = useVWAP3 ? f_anchored_vwap(hlc3, startTime3) : vwap_info.new(na, na, false, 0)

// --- Visuals: Dated Anchor Labels ---
f_createAnchorLabel(_isAnchor, _time, _color) =>
    if _isAnchor
        dateString = str.format("{0,date,yyyy-MM-dd}", _time)
        label.new(bar_index, high, dateString, yloc = yloc.abovebar, color = _color, textcolor = color.white, style = label.style_label_down, size = size.small)

if useVWAP1
    f_createAnchorLabel(v1.isAnchor, v1.anchorTime, color1)
if useVWAP2
    f_createAnchorLabel(v2.isAnchor, v2.anchorTime, color2)
if useVWAP3
    f_createAnchorLabel(v3.isAnchor, v3.anchorTime, color3)

// --- Visuals: Plots ---
// Helper to filter series based on style
f_v(val, currentStyle, targetStyle) => currentStyle == targetStyle ? val : na

// VWAP 1 Plots
plot(f_v(v1.price, style1, STYLE_LINE),     "VWAP 1 Line",     color = color1, linewidth = width1, style = plot.style_linebr)
plot(f_v(v1.price, style1, STYLE_STEPLINE), "VWAP 1 Step",     color = color1, linewidth = width1, style = plot.style_stepline)
plot(f_v(v1.price, style1, STYLE_CIRCLES),  "VWAP 1 Circles",  color = color1, linewidth = width1, style = plot.style_circles)
plot(f_v(v1.price, style1, STYLE_CROSS),    "VWAP 1 Cross",    color = color1, linewidth = width1, style = plot.style_cross)
plot(f_v(v1.price, style1, STYLE_AREA),     "VWAP 1 Area",     color = color.new(color1, 80), linewidth = width1, style = plot.style_area)

p1_up = plot(showBands1 and useVWAP1 ? v1.price + v1.deviation * mult1 : na, "VWAP 1 Upper", color = color.new(color1, 50), style = plot.style_linebr)
p1_dn = plot(showBands1 and useVWAP1 ? v1.price - v1.deviation * mult1 : na, "VWAP 1 Lower", color = color.new(color1, 50), style = plot.style_linebr)
fill(p1_up, p1_dn, showBands1 and useVWAP1 ? color.new(color1, 90) : na, title = "VWAP 1 Band Fill")

// VWAP 2 Plots
plot(f_v(v2.price, style2, STYLE_LINE),     "VWAP 2 Line",     color = color2, linewidth = width2, style = plot.style_linebr)
plot(f_v(v2.price, style2, STYLE_STEPLINE), "VWAP 2 Step",     color = color2, linewidth = width2, style = plot.style_stepline)
plot(f_v(v2.price, style2, STYLE_CIRCLES),  "VWAP 2 Circles",  color = color2, linewidth = width2, style = plot.style_circles)
plot(f_v(v2.price, style2, STYLE_CROSS),    "VWAP 2 Cross",    color = color2, linewidth = width2, style = plot.style_cross)
plot(f_v(v2.price, style2, STYLE_AREA),     "VWAP 2 Area",     color = color.new(color2, 80), linewidth = width2, style = plot.style_area)

p2_up = plot(showBands2 and useVWAP2 ? v2.price + v2.deviation * mult2 : na, "VWAP 2 Upper", color = color.new(color2, 50), style = plot.style_linebr)
p2_dn = plot(showBands2 and useVWAP2 ? v2.price - v2.deviation * mult2 : na, "VWAP 2 Lower", color = color.new(color2, 50), style = plot.style_linebr)
fill(p2_up, p2_dn, showBands2 and useVWAP2 ? color.new(color2, 90) : na, title = "VWAP 2 Band Fill")

// VWAP 3 Plots
plot(f_v(v3.price, style3, STYLE_LINE),     "VWAP 3 Line",     color = color3, linewidth = width3, style = plot.style_linebr)
plot(f_v(v3.price, style3, STYLE_STEPLINE), "VWAP 3 Step",     color = color3, linewidth = width3, style = plot.style_stepline)
plot(f_v(v3.price, style3, STYLE_CIRCLES),  "VWAP 3 Circles",  color = color3, linewidth = width3, style = plot.style_circles)
plot(f_v(v3.price, style3, STYLE_CROSS),    "VWAP 3 Cross",    color = color3, linewidth = width3, style = plot.style_cross)
plot(f_v(v3.price, style3, STYLE_AREA),     "VWAP 3 Area",     color = color.new(color3, 80), linewidth = width3, style = plot.style_area)

p3_up = plot(showBands3 and useVWAP3 ? v3.price + v3.deviation * mult3 : na, "VWAP 3 Upper", color = color.new(color3, 50), style = plot.style_linebr)
p3_dn = plot(showBands3 and useVWAP3 ? v3.price - v3.deviation * mult3 : na, "VWAP 3 Lower", color = color.new(color3, 50), style = plot.style_linebr)
fill(p3_up, p3_dn, showBands3 and useVWAP3 ? color.new(color3, 90) : na, title = "VWAP 3 Band Fill")
