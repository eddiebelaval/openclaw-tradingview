//@version=5
indicator("Fractal Retracement [Jamallo]", overlay=true)

// =============================================================================
// INPUTS
// =============================================================================
// FRAMA Filter
framaLength = input.int(50, "FRAMA Length", minval=10, maxval=200, group="FRAMA Filter")
framaFC = input.int(1, "FRAMA Fast Constant", minval=1, maxval=100, group="FRAMA Filter")
framaSC = input.int(200, "FRAMA Slow Constant", minval=100, maxval=300, group="FRAMA Filter")
rangeMultiplier = input.float(1.5, "Range Multiplier", minval=0.5, maxval=5.0, step=0.1, group="FRAMA Filter")
movsrc = input.int(1, "Movement Source (0=Wicks, 1=Close)", minval=0, maxval=1, group="FRAMA Filter")

// Adaptive Bands
band1Multiplier = input.float(0.5, "Band 1 Multiplier (Tight)", minval=0.1, maxval=3.0, step=0.1, group="Adaptive Bands")
band2Multiplier = input.float(1.0, "Band 2 Multiplier (Medium)", minval=0.1, maxval=3.0, step=0.1, group="Adaptive Bands")
bandSmoothing = input.int(3, "Band Smoothing Length", minval=1, maxval=20, group="Adaptive Bands")

// Display Options
showBaseFRAMA = input.bool(false, "Show Base FRAMA", group="Display")
showBands = input.bool(true, "Show Adaptive Bands", group="Display")

// =============================================================================
// FRAMA CALCULATION
// =============================================================================
frama(src, len, fc, sc) =>
    var float filt = na
    
    if na(filt)
        filt := src
    
    n1 = len / 2
    n2 = len / 2
    
    hh1 = ta.highest(high, math.floor(n1))
    ll1 = ta.lowest(low, math.floor(n1))
    
    hh2 = ta.highest(high[math.floor(n1)], math.floor(n2))
    ll2 = ta.lowest(low[math.floor(n1)], math.floor(n2))
    
    hh3 = ta.highest(high, len)
    ll3 = ta.lowest(low, len)
    
    n1_range = hh1 - ll1
    n2_range = hh2 - ll2
    n3_range = hh3 - ll3
    
    D = n3_range > 0 ? (math.log(n1_range + n2_range) - math.log(n3_range)) / math.log(2) : 1.0
    D := na(D) ? 1.0 : D
    D := D < 1 ? 1.0 : D > 2 ? 2.0 : D
    
    alpha = math.exp(-4.6 * (D - 1))
    
    oldAlpha = alpha
    oldN = (2 - oldAlpha) / oldAlpha
    newN = ((sc - fc) * (oldN - 1) / (sc - 1)) + fc
    alpha := 2 / (newN + 1)
    
    filt := alpha * src + (1 - alpha) * nz(filt[1], src)
    filt

// =============================================================================
// FRAMA FILTER WITH CONTINUOUS RANGE LOGIC
// =============================================================================
hh = movsrc == 1 ? close : high
ll = movsrc == 1 ? close : low

framaFilter = frama(close, framaLength, framaFC, framaSC)

atrPeriod = math.floor(framaLength / 2)
atr = ta.atr(atrPeriod)
adaptiveRange = atr * rangeMultiplier

var float k = na

if na(k)
    k := framaFilter

k := hh > nz(k[1]) ? 
     (framaFilter - adaptiveRange < nz(k[1]) ? nz(k[1]) : framaFilter - adaptiveRange) : 
     (framaFilter + adaptiveRange > nz(k[1]) ? nz(k[1]) : framaFilter + adaptiveRange)

// =============================================================================
// DIRECTION AND TREND DETECTION
// =============================================================================
var bool upward = true
var bool downward = false

if k > k[1]
    upward := true
    downward := false
else if k < k[1]
    upward := false
    downward := true

// =============================================================================
// ADAPTIVE BANDS AROUND FRAMA FILTER
// =============================================================================
band1_upper_raw = k + (adaptiveRange * band1Multiplier)
band1_lower_raw = k - (adaptiveRange * band1Multiplier)
band2_upper_raw = k + (adaptiveRange * band2Multiplier)
band2_lower_raw = k - (adaptiveRange * band2Multiplier)

band1_upper = ta.ema(band1_upper_raw, bandSmoothing)
band1_lower = ta.ema(band1_lower_raw, bandSmoothing)
band2_upper = ta.ema(band2_upper_raw, bandSmoothing)
band2_lower = ta.ema(band2_lower_raw, bandSmoothing)

// =============================================================================
// COLORS & STYLING
// =============================================================================
filterColor = upward ? color.new(#05ff9b, 0) : color.new(#ff0583, 0)

band1Color = upward ? color.new(#00b36b, 80) : color.new(#b8005d, 80)
band2Color = upward ? color.new(#00b36b, 70) : color.new(#b8005d, 70)

// =============================================================================
// PLOTTING
// =============================================================================
kPlot = plot(k, "FRAMA Filter", color=filterColor, linewidth=1)
framaBasePlot = plot(showBaseFRAMA ? framaFilter : na, "Base FRAMA", color=color.new(color.gray, 70), linewidth=1)

b1u = plot(showBands ? band1_upper : na, "Band 1 Upper", color=band1Color, linewidth=1)
b1l = plot(showBands ? band1_lower : na, "Band 1 Lower", color=band1Color, linewidth=1)

b2u = plot(showBands ? band2_upper : na, "Band 2 Upper", color=band2Color, linewidth=1)
b2l = plot(showBands ? band2_lower : na, "Band 2 Lower", color=band2Color, linewidth=1)

// Gradient fills for Band 1
fill(b1u, kPlot, color=color.new(#00b36b, 92), title="Upper Band 1 Fill")
fill(kPlot, b1l, color=color.new(#b8005d, 92), title="Lower Band 1 Fill")

// Gradient fills for Band 2
fill(b2u, b1u, band1_upper, band2_upper, color.new(#00b36b, 95), color.new(#00b36b, 85), title="Upper Band 2 Gradient")
fill(b1l, b2l, band2_lower, band1_lower, color.new(#b8005d, 85), color.new(#b8005d, 95), title="Lower Band 2 Gradient")
