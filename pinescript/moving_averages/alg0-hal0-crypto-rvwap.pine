//@version=6
indicator("A۞H Crypto RVWAP", overlay=true)

// --- Inputs ---
rvwap_len   = input.int(20, "RVWAP Lookback Window", minval=1)
slope_len   = input.int(5, "Slope Lookback Period", minval=1)
bull_color  = input.color(color.new(color.lime, 0), "Bullish Color")
bear_color  = input.color(color.new(color.red, 0), "Bearish Color")

// --- Calculations ---
typical_price = hlc3
pv_sum = math.sum(typical_price * volume, rvwap_len)
vol_sum = math.sum(volume, rvwap_len)
rvwap = pv_sum / vol_sum

// --- Normalized Slope Logic (%) ---
get_slope(lookback) =>
    val = rvwap[lookback]
    prev_val = rvwap[lookback + slope_len]
    ((val - prev_val) / prev_val) * 100

s0 = get_slope(0) 
s1 = get_slope(1) 
s2 = get_slope(2) 
s3 = get_slope(3) 

// Trend Color Logic
is_bullish = rvwap > rvwap[1]
dynamic_color = is_bullish ? bull_color : bear_color

// --- Plotting ---
plot(rvwap, "RVWAP Line", color=dynamic_color, linewidth=2)

// --- Dashboard Table (Corrected Variable Types) ---
var table dash = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 10), border_width=1, border_color=color.gray)

if barstate.islast
    // Header uses 'large' for emphasis, body uses 'normal'
    string header_size = size.large
    string body_size   = size.normal 

    // Header Row
    table.cell(dash, 0, 0, "Slope-" + str.tostring(slope_len), text_color=color.white, text_size=header_size)
    table.cell(dash, 1, 0, "Value %", text_color=color.white, text_size=header_size)
    
    // Data Rows
    table.cell(dash, 0, 1, "Current", text_color=color.white, text_size=body_size)
    table.cell(dash, 1, 1, str.tostring(s0, "#.###") + "%", text_color=s0 >= 0 ? color.lime : color.red, text_size=body_size)
    
    table.cell(dash, 0, 2, "Prev 1", text_color=color.white, text_size=body_size)
    table.cell(dash, 1, 2, str.tostring(s1, "#.###") + "%", text_color=s1 >= 0 ? color.lime : color.red, text_size=body_size)
    
    table.cell(dash, 0, 3, "Prev 2", text_color=color.white, text_size=body_size)
    table.cell(dash, 1, 3, str.tostring(s2, "#.###") + "%", text_color=s2 >= 0 ? color.lime : color.red, text_size=body_size)
    
    table.cell(dash, 0, 4, "Prev 3", text_color=color.white, text_size=body_size)
    table.cell(dash, 1, 4, str.tostring(s3, "#.###") + "%", text_color=s3 >= 0 ? color.lime : color.red, text_size=body_size)

// --- Crossing Labels (Last 2 Only) ---
var label[] cross_labels = array.new_label(0)
price_close_above = ta.crossover(close, rvwap)
price_close_below = ta.crossunder(close, rvwap)

if price_close_above or price_close_below
    lbl_text  = price_close_above ? "UP" : "DOWN"
    lbl_color = price_close_above ? color.lime : color.red
    new_lbl = label.new(bar_index, rvwap, text=lbl_text, color=lbl_color, style=price_close_above ? label.style_label_up : label.style_label_down, yloc=price_close_above ? yloc.belowbar : yloc.abovebar, size=size.small)
    array.push(cross_labels, new_lbl)
    if array.size(cross_labels) > 2
        label.delete(array.shift(cross_labels))

// --- Alerts ---
alertcondition(price_close_above, title="Close Above RVWAP", message="Price CLOSED above RVWAP on {{ticker}}")
alertcondition(price_close_below, title="Close Below RVWAP", message="Price CLOSED below RVWAP on {{ticker}}")
