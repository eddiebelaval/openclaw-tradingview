//@version=5
indicator("EMA 21 & EMA 50 Crossover + Close Line", overlay=true)

// === INPUTS ===
fastLen = input.int(21, title="EMA 21 Length")
slowLen = input.int(50, title="EMA 50 Length")

// === EMA ===
ema21 = ta.ema(close, fastLen)
ema50 = ta.ema(close, slowLen)

// === PLOT EMA ===
plot(ema21, title="EMA 21", color=color.green, linewidth=2)
plot(ema50, title="EMA 50", color=color.red, linewidth=2)

// === SIGNALS (CANDLE CLOSE CONFIRM) ===
buySignal  = ta.crossover(ema21, ema50)
sellSignal = ta.crossunder(ema21, ema50)

// === SIGNAL MARKERS ===
plotshape(buySignal, style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.large, text="BUY")
plotshape(sellSignal, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.large, text="SELL")

// === CLOSE PRICE LINE ===
if buySignal
    line.new(bar_index, close, bar_index + 50, close, color=color.lime, width=2)

if sellSignal
    line.new(bar_index, close, bar_index + 50, close, color=color.red, width=2)

// === ALERTS ===
alertcondition(buySignal, title="BUY Alert", message="BUY: EMA 21 crossed ABOVE EMA 50 | Entry = Candle Close")
alertcondition(sellSignal, title="SELL Alert", message="SELL: EMA 21 crossed BELOW EMA 50 | Entry = Candle Close")
