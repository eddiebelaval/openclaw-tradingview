//@version=5
indicator("EMA 24/52", overlay=true)
fast = ta.ema(close, 24)
slow = ta.ema(close, 52)
plot(fast, color = color.blue,title = "EMA 24")
plot(slow, color = color.red, title = "EMA 52")
amplitude = (close - open)/open * 100
plot(amplitude, color = color.orange,display=display.status_line,title = "漲跌幅",format=format.percent)
