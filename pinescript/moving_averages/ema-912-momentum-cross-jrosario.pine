//@version=5
indicator("EMA 9/12 Momentum Cross [JRosario]", overlay=true, shorttitle="EMA 9/12 JR")

// Cálculos
ema9 = ta.ema(close, 9)
ema12 = ta.ema(close, 12)

// Señales
cruceAlcista = ta.crossover(ema9, ema12)
cruceBajista = ta.crossunder(ema9, ema12)

// Visualización de líneas
plot(ema9, color=color.olive, title="EMA 9 (Olivo)", linewidth=2)
plot(ema12, color=color.navy, title="EMA 12 (Navy Blue)", linewidth=2)

// Visualización de señales (Bolitas)
plotshape(series=cruceAlcista, title="Cruce Alcista", style=shape.circle, location=location.belowbar, color=color.green, size=size.small)
plotshape(series=cruceBajista, title="Cruce Bajista", style=shape.circle, location=location.abovebar, color=color.red, size=size.small)
