//@version=6
indicator("Gold Ribbon V1.00", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 📊 INPUT GROUPS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

G_RIBBON  = "📊 Ribbon MAs"
G_FILL    = "🎨 Ribbon Fill"
G_SIG     = "🎯 Signals"
G_LABEL   = "🏷️ Trend Labels"
G_SQUEEZE = "💥 Squeeze Detection"

// MA Settings
ma1_len   = input.int(5,   "MA 1 Length", group = G_RIBBON, display = display.none)
ma1_type  = input.string("EMA", "MA 1 Type", options = ["SMA", "EMA", "WMA", "HMA"], group = G_RIBBON, display = display.none)
ma1_col   = input.color(color.new(#00bcd4, 0), "MA 1 Color", group = G_RIBBON, display = display.none)
ma1_width = input.int(1,   "MA 1 Width", minval = 1, maxval = 3, group = G_RIBBON, display = display.none)
ma1_show  = input.bool(true, "Show MA 1", group = G_RIBBON, display = display.none)

ma2_len   = input.int(8,   "MA 2 Length", group = G_RIBBON, display = display.none)
ma2_type  = input.string("EMA", "MA 2 Type", options = ["SMA", "EMA", "WMA", "HMA"], group = G_RIBBON, display = display.none)
ma2_col   = input.color(color.new(#2196f3, 0), "MA 2 Color", group = G_RIBBON, display = display.none)
ma2_width = input.int(1,   "MA 2 Width", minval = 1, maxval = 3, group = G_RIBBON, display = display.none)
ma2_show  = input.bool(true, "Show MA 2", group = G_RIBBON, display = display.none)

ma3_len   = input.int(13,  "MA 3 Length", group = G_RIBBON, display = display.none)
ma3_type  = input.string("EMA", "MA 3 Type", options = ["SMA", "EMA", "WMA", "HMA"], group = G_RIBBON, display = display.none)
ma3_col   = input.color(color.new(#3f51b5, 0), "MA 3 Color", group = G_RIBBON, display = display.none)
ma3_width = input.int(1,   "MA 3 Width", minval = 1, maxval = 3, group = G_RIBBON, display = display.none)
ma3_show  = input.bool(true, "Show MA 3", group = G_RIBBON, display = display.none)

ma4_len   = input.int(21,  "MA 4 Length", group = G_RIBBON, display = display.none)
ma4_type  = input.string("EMA", "MA 4 Type", options = ["SMA", "EMA", "WMA", "HMA"], group = G_RIBBON, display = display.none)
ma4_col   = input.color(color.new(#673ab7, 0), "MA 4 Color", group = G_RIBBON, display = display.none)
ma4_width = input.int(1,   "MA 4 Width", minval = 1, maxval = 3, group = G_RIBBON, display = display.none)
ma4_show  = input.bool(true, "Show MA 4", group = G_RIBBON, display = display.none)

ma5_len   = input.int(34,  "MA 5 Length", group = G_RIBBON, display = display.none)
ma5_type  = input.string("EMA", "MA 5 Type", options = ["SMA", "EMA", "WMA", "HMA"], group = G_RIBBON, display = display.none)
ma5_col   = input.color(color.new(#9c27b0, 0), "MA 5 Color", group = G_RIBBON, display = display.none)
ma5_width = input.int(1,   "MA 5 Width", minval = 1, maxval = 3, group = G_RIBBON, display = display.none)
ma5_show  = input.bool(true, "Show MA 5", group = G_RIBBON, display = display.none)

ma6_len   = input.int(55,  "MA 6 Length", group = G_RIBBON, display = display.none)
ma6_type  = input.string("EMA", "MA 6 Type", options = ["SMA", "EMA", "WMA", "HMA"], group = G_RIBBON, display = display.none)
ma6_col   = input.color(color.new(#e91e63, 0), "MA 6 Color", group = G_RIBBON, display = display.none)
ma6_width = input.int(1,   "MA 6 Width", minval = 1, maxval = 3, group = G_RIBBON, display = display.none)
ma6_show  = input.bool(true, "Show MA 6", group = G_RIBBON, display = display.none)

ma7_len   = input.int(89,  "MA 7 Length", group = G_RIBBON, display = display.none)
ma7_type  = input.string("EMA", "MA 7 Type", options = ["SMA", "EMA", "WMA", "HMA"], group = G_RIBBON, display = display.none)
ma7_col   = input.color(color.new(#f44336, 0), "MA 7 Color", group = G_RIBBON, display = display.none)
ma7_width = input.int(1,   "MA 7 Width", minval = 1, maxval = 3, group = G_RIBBON, display = display.none)
ma7_show  = input.bool(true, "Show MA 7", group = G_RIBBON, display = display.none)

ma8_len   = input.int(144, "MA 8 Length", group = G_RIBBON, display = display.none)
ma8_type  = input.string("EMA", "MA 8 Type", options = ["SMA", "EMA", "WMA", "HMA"], group = G_RIBBON, display = display.none)
ma8_col   = input.color(color.new(#b71c1c, 0), "MA 8 Color", group = G_RIBBON, display = display.none)
ma8_width = input.int(1,   "MA 8 Width", minval = 1, maxval = 3, group = G_RIBBON, display = display.none)
ma8_show  = input.bool(true, "Show MA 8", group = G_RIBBON, display = display.none)

// Fill Settings
use_dyn_line  = input.bool(true, "Use Dynamic Trend Colors for Lines", group = G_FILL, display = display.none)
bull_fill_col = input.color(color.new(#00ffbb, 85), "Bullish Fill", group = G_FILL, display = display.none)
bear_fill_col = input.color(color.new(#ff5252, 85), "Bearish Fill", group = G_FILL, display = display.none)
neut_fill_col = input.color(color.new(#90a4ae, 90), "Neutral Fill", group = G_FILL, display = display.none)

// Signal Settings
show_sig    = input.bool(true, "Show Signals", group = G_SIG, display = display.none)
show_tp_sl  = input.bool(true, "Show TP/SL Lines", group = G_SIG, display = display.none)
tp_sl_size_str = input.string("Tiny", "TP/SL Label Size", options = ["Auto", "Tiny", "Small", "Normal", "Large", "Huge"], group = G_SIG, display = display.none)

tp_sl_size = switch tp_sl_size_str
    "Auto"   => size.auto
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large
    "Huge"   => size.huge


// Trend Label Settings
show_labels      = input.bool(true, "Show Labels", group = G_LABEL, display = display.none)
label_n          = input.int(30, "Label Every N Bars", group = G_LABEL, display = display.none)
bull_lbl_bg      = input.color(color.new(color.teal, 20),  "Bullish BG",  group = G_LABEL, display = display.none)
bull_lbl_tx      = input.color(color.new(color.white, 0),  "Bullish Text", group = G_LABEL, display = display.none)
bear_lbl_bg      = input.color(color.new(color.maroon, 20),"Bearish BG",  group = G_LABEL, display = display.none)
bear_lbl_tx      = input.color(color.new(color.white, 0),  "Bearish Text", group = G_LABEL, display = display.none)
squz_lbl_bg      = input.color(color.new(color.orange, 20),"Squeeze BG",  group = G_LABEL, display = display.none)
squz_lbl_tx      = input.color(color.new(color.white, 0),  "Squeeze Text", group = G_LABEL, display = display.none)
chop_lbl_bg      = input.color(color.new(color.gray, 20),  "Choppy BG",   group = G_LABEL, display = display.none)
chop_lbl_tx      = input.color(color.new(color.white, 0),  "Choppy Text",  group = G_LABEL, display = display.none)

// Squeeze Settings
show_squz_marks  = input.bool(true, "Show Squeeze Markers", group = G_SQUEEZE, display = display.none)
squz_sens        = input.float(0.4, "Squeeze Sensitivity", minval = 0.1, maxval = 0.9, step = 0.05, group = G_SQUEEZE, display = display.none)
squz_mark_col    = input.color(color.new(color.orange, 0), "Squeeze Marker Color", group = G_SQUEEZE, display = display.none)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🛠️ FUNCTIONS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

getMA(src, len, type) =>
    switch type
        "SMA" => ta.sma(src, len)
        "EMA" => ta.ema(src, len)
        "WMA" => ta.wma(src, len)
        "HMA" => ta.wma(2 * ta.wma(src, len/2) - ta.wma(src, len), math.round(math.sqrt(len)))
        => ta.ema(src, len)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 📈 CALCULATIONS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

m1 = getMA(close, ma1_len, ma1_type)
m2 = getMA(close, ma2_len, ma2_type)
m3 = getMA(close, ma3_len, ma3_type)
m4 = getMA(close, ma4_len, ma4_type)
m5 = getMA(close, ma5_len, ma5_type)
m6 = getMA(close, ma6_len, ma6_type)
m7 = getMA(close, ma7_len, ma7_type)
m8 = getMA(close, ma8_len, ma8_type)

// Perfect Order Calculation
perfect_bull = m1 > m2 and m2 > m3 and m3 > m4 and m4 > m5 and m5 > m6 and m6 > m7 and m7 > m8
perfect_bear = m1 < m2 and m2 < m3 and m3 < m4 and m4 < m5 and m5 < m6 and m6 < m7 and m7 < m8

// Ribbon Compression (Squeeze)
ribbon_width     = (m1 - m8) / m8 * 100
abs_ribbon_width = math.abs(ribbon_width)
width_avg        = ta.sma(abs_ribbon_width, 50)
is_compressed    = abs_ribbon_width < width_avg * squz_sens
is_expanding     = ta.crossover(abs_ribbon_width, width_avg * squz_sens)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🎨 PLOTTING & FILL
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

dyn_c(base_col) =>
    use_dyn_line ? (perfect_bull ? color.new(#00ffbb, 0) : perfect_bear ? color.new(#ff5252, 0) : base_col) : base_col

p1 = plot(m1, "MA 1", dyn_c(ma1_col), ma1_width, display = ma1_show ? display.all : display.none)
p2 = plot(m2, "MA 2", dyn_c(ma2_col), ma2_width, display = ma2_show ? display.all : display.none)
p3 = plot(m3, "MA 3", dyn_c(ma3_col), ma3_width, display = ma3_show ? display.all : display.none)
p4 = plot(m4, "MA 4", dyn_c(ma4_col), ma4_width, display = ma4_show ? display.all : display.none)
p5 = plot(m5, "MA 5", dyn_c(ma5_col), ma5_width, display = ma5_show ? display.all : display.none)
p6 = plot(m6, "MA 6", dyn_c(ma6_col), ma6_width, display = ma6_show ? display.all : display.none)
p7 = plot(m7, "MA 7", dyn_c(ma7_col), ma7_width, display = ma7_show ? display.all : display.none)
p8 = plot(m8, "MA 8", dyn_c(ma8_col), ma8_width, display = ma8_show ? display.all : display.none)

// Dynamic Fill Logic
fill_color = perfect_bull ? bull_fill_col : perfect_bear ? bear_fill_col : neut_fill_col
fill(p1, p2, fill_color, "Fill 1-2")
fill(p2, p3, fill_color, "Fill 2-3")
fill(p3, p4, fill_color, "Fill 3-4")
fill(p4, p5, fill_color, "Fill 4-5")
fill(p5, p6, fill_color, "Fill 5-6")
fill(p6, p7, fill_color, "Fill 6-7")
fill(p7, p8, fill_color, "Fill 7-8")

// Squeeze Marker

// Adjusting squeeze marker to sit on the basis (using middle of ribbon)
ribbon_mid = (m1 + m8) / 2
plotshape(show_squz_marks and is_compressed ? ribbon_mid : na, "Squeeze Context", shape.diamond, location.absolute, squz_mark_col, size = size.tiny)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🎯 SIGNALS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

slowest_rising  = m8 > m8[3]
slowest_falling = m8 < m8[3]

buy_cond  = perfect_bull and close > m1 and slowest_rising
sell_cond = perfect_bear and close < m1 and slowest_falling

// Expansion Tracking for High Probability Signals
var bool expanded_recently = false
if is_expanding
    expanded_recently := true
if perfect_bull or perfect_bear
    // Stay true while in order
    expanded_recently := expanded_recently
else
    expanded_recently := false

high_prob_buy  = buy_cond  and expanded_recently[1]
high_prob_sell = sell_cond and expanded_recently[1]

// Signal Deduplication
var int signal_state = 0 // 1: Buy, -1: Sell
buy_signal  = buy_cond  and signal_state != 1
sell_signal = sell_cond and signal_state != -1

if buy_signal
    signal_state := 1
if sell_signal
    signal_state := -1

// Plot Signals
plotshape(show_sig and buy_signal and not high_prob_buy, "Buy Triangle", shape.triangleup, location.belowbar, color.new(color.green, 0), size = size.small)
plotshape(show_sig and sell_signal and not high_prob_sell, "Sell Triangle", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.small)

// High Probability Labels
if show_sig and buy_signal and high_prob_buy
    label.new(bar_index, low, "🚀 BUY", color = color.new(color.green, 20), textcolor = color.white, style = label.style_label_up, size = size.normal)
if show_sig and sell_signal and high_prob_sell
    label.new(bar_index, high, "🚀 SELL", color = color.new(color.red, 20), textcolor = color.white, style = label.style_label_down, size = size.normal)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🏷️ TREND LABELS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var label trend_lbl = na
if show_labels
    label.delete(trend_lbl) // Dynamically remove the old label
    if barstate.islast // Only plot on the real-time last edge
        lbl_text = is_compressed ? "◆ SQUEEZE" : perfect_bull ? "▲ BULLISH" : perfect_bear ? "▼ BEARISH" : "～ CHOPPY"
        lbl_bg   = is_compressed ? squz_lbl_bg : perfect_bull ? bull_lbl_bg : perfect_bear ? bear_lbl_bg : chop_lbl_bg
        lbl_tx   = is_compressed ? squz_lbl_tx : perfect_bull ? bull_lbl_tx : perfect_bear ? bear_lbl_tx : chop_lbl_tx
        trend_lbl := label.new(bar_index + 3, ribbon_mid, lbl_text, color = lbl_bg, textcolor = lbl_tx, style = label.style_label_left, size = size.small)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 📉 TP / SL DRAWING (CONTINUOUS AUTO TRACKING)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var int current_trend = 0
if perfect_bull
    current_trend := 1
else if perfect_bear
    current_trend := -1

var line l_tp1 = na
var line l_tp2 = na
var line l_sl  = na
var label lb_tp1 = na
var label lb_tp2 = na
var label lb_sl  = na

if show_tp_sl and current_trend != 0 and barstate.islast
    float entry_p = close
    float span    = math.abs(close - m8)
    float tp1     = current_trend == 1 ? entry_p + span * 0.5 : entry_p - span * 0.5
    float tp2     = current_trend == 1 ? entry_p + span * 1.0 : entry_p - span * 1.0
    float sl      = current_trend == 1 ? m8 * 0.998 : m8 * 1.002
    
    if na(l_tp1)
        l_tp1 := line.new(bar_index, tp1, bar_index + 15, tp1, color = color.new(color.lime, 40), style = line.style_dashed)
        l_tp2 := line.new(bar_index, tp2, bar_index + 15, tp2, color = color.new(color.green, 20), style = line.style_dashed)
        l_sl  := line.new(bar_index, sl,  bar_index + 15, sl,  color = color.new(color.red, 40), style = line.style_dashed)
        
        lb_tp1 := label.new(bar_index + 15, tp1, "TP1 " + str.tostring(tp1, "#.##"), textcolor = color.lime, style = label.style_label_left, size = tp_sl_size, color = color.new(color.white, 100))
        lb_tp2 := label.new(bar_index + 15, tp2, "TP2 " + str.tostring(tp2, "#.##"), textcolor = color.green, style = label.style_label_left, size = tp_sl_size, color = color.new(color.white, 100))
        lb_sl  := label.new(bar_index + 15, sl,  "SL " + str.tostring(sl, "#.##"), textcolor = color.red, style = label.style_label_left, size = tp_sl_size, color = color.new(color.white, 100))
    else
        line.set_xy1(l_tp1, bar_index, tp1)
        line.set_xy2(l_tp1, bar_index + 15, tp1)
        line.set_xy1(l_tp2, bar_index, tp2)
        line.set_xy2(l_tp2, bar_index + 15, tp2)
        line.set_xy1(l_sl,  bar_index, sl)
        line.set_xy2(l_sl,  bar_index + 15, sl)
        
        label.set_xy(lb_tp1, bar_index + 15, tp1)
        label.set_xy(lb_tp2, bar_index + 15, tp2)
        label.set_xy(lb_sl,  bar_index + 15, sl)
        
        label.set_text(lb_tp1, "TP1 " + str.tostring(tp1, "#.##"))
        label.set_text(lb_tp2, "TP2 " + str.tostring(tp2, "#.##"))
        label.set_text(lb_sl,  "SL " + str.tostring(sl, "#.##"))
else if not show_tp_sl and not na(l_tp1)
    line.delete(l_tp1)
    line.delete(l_tp2)
    line.delete(l_sl)
    label.delete(lb_tp1)
    label.delete(lb_tp2)
    label.delete(lb_sl)
    l_tp1 := na
    l_tp2 := na
    l_sl  := na
    lb_tp1 := na
    lb_tp2 := na
    lb_sl  := na

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🚀 ALERTS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if buy_signal
    alert("🟢 BUY Signal | Gold Ribbon V1.00", alert.freq_once_per_bar)
if sell_signal
    alert("🔴 SELL Signal | Gold Ribbon V1.00", alert.freq_once_per_bar)
if is_compressed and not is_compressed[1]
    alert("⚠️ RIBBON SQUEEZE | Gold Ribbon V1.00 — Breakout incoming", alert.freq_once_per_bar)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ⚠️ TIMEFRAME WARNING
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var table tf_warn = table.new(position.top_left, 1, 1)
if barstate.islast
    is_invalid_tf = timeframe.isintraday and timeframe.multiplier > 60 // Example logic: Warn if > 1H for scalping context
    if is_invalid_tf
        table.cell(tf_warn, 0, 0, "⚠️ Warning: Optimized for 15M/1H", text_color = color.white, bgcolor = color.new(color.red, 20), text_size = size.small)
