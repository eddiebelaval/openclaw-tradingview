//@version=5
indicator("Customizable SMA Channel", overlay = true)

//────────────────────────────────────────────
// PRESET
//────────────────────────────────────────────

preset = input.string("D1", "Preset", options = ["D1", "H4", "H1"])

// valori predefiniti dei preset
var int preset_len_D1 = 20
var int preset_off_D1 = -10

var int preset_len_H4 = 40
var int preset_off_H4 = -20

var int preset_len_H1 = 140
var int preset_off_H1 = -70

//────────────────────────────────────────────
// PARAMETRI MODIFICABILI DALL'UTENTE
//────────────────────────────────────────────

// periodi
lenMid_input    = input.int(20,  "Central SMA Period (modifiable)")
lenOffset_input = input.int(20,  "Upper/Lower SMA Period (modifiable)")

// offset manuali per ciascuna linea
offsetMid_input  = input.int(-10, "Central SMA Offset (modifiable)")
offsetUp_input   = input.int(-10, "Upper SMA Offset (modifiable)")
offsetDown_input = input.int(-10, "Lower SMA Offset (modifiable)")

// distanza punti/% (default 90)
usePercent = input.bool(false, "Use % distance?")
distValue  = input.float(90.0, "Distance (points or %)", minval = 0.0)

//────────────────────────────────────────────
// APPLICAZIONE PRESET
//────────────────────────────────────────────

var int lenMid_final    = lenMid_input
var int lenOffset_final = lenOffset_input

var int offsetMid_final  = offsetMid_input
var int offsetUp_final   = offsetUp_input
var int offsetDown_final = offsetDown_input

if preset == "D1"
    lenMid_final    := preset_len_D1
    lenOffset_final := preset_len_D1
    offsetMid_final  := preset_off_D1
    offsetUp_final   := preset_off_D1
    offsetDown_final := preset_off_D1

if preset == "H4"
    lenMid_final    := preset_len_H4
    lenOffset_final := preset_len_H4
    offsetMid_final  := preset_off_H4
    offsetUp_final   := preset_off_H4
    offsetDown_final := preset_off_H4

if preset == "H1"
    lenMid_final    := preset_len_H1
    lenOffset_final := preset_len_H1
    offsetMid_final  := preset_off_H1
    offsetUp_final   := preset_off_H1
    offsetDown_final := preset_off_H1

//────────────────────────────────────────────
// CALCOLO MEDIE
//────────────────────────────────────────────

src = close

smaMid  = ta.sma(src, lenMid_final)
smaBase = ta.sma(src, lenOffset_final)

dist    = usePercent ? smaBase * distValue / 100 : distValue

smaUp   = smaMid + dist
smaDown = smaMid - dist

//────────────────────────────────────────────
// COLORI
//────────────────────────────────────────────

colMid  = input.color(color.white, "Central SMA Color")
colUp   = input.color(color.white, "Upper SMA Color")
colDown = input.color(color.white, "Lower SMA Color")

//────────────────────────────────────────────
// PLOT
//────────────────────────────────────────────

plot(smaMid,  title="Central SMA",  color=colMid,  linewidth=2, offset=offsetMid_final)
plot(smaUp,   title="Upper SMA",    color=colUp,   linewidth=2, offset=offsetUp_final)
plot(smaDown, title="Lower SMA",    color=colDown, linewidth=2, offset=offsetDown_final)
