//@version=6
indicator("NBIS/CRWV Swing | EMA20+MA50+ST", overlay=true, max_lines_count=500, max_labels_count=500)

// ─── Inputs ───────────────────────────────────────────────────
slPct   = input.float(5.0,  "Stop Loss %",     minval=0.5, step=0.5)
tp1Pct  = input.float(8.0,  "Take Profit 1 %", minval=1.0, step=0.5)
tp2Pct  = input.float(15.0, "Take Profit 2 %", minval=1.0, step=1.0)
stMult  = input.float(3.0,  "Supertrend Mult", minval=1.0, step=0.5)
stAtr   = input.int(10,     "Supertrend ATR",  minval=5)
lineLen = input.int(20,     "Line length (bars)", minval=3)

// ─── Indicators ───────────────────────────────────────────────
ema20 = ta.ema(close, 20)
ma50  = ta.sma(close, 50)
[stLine, stDir] = ta.supertrend(stMult, stAtr)

// ─── Signals ──────────────────────────────────────────────────
longEntry  = ta.crossover(ema20,  ma50) and stDir < 0
shortEntry = ta.crossunder(ema20, ma50) and stDir > 0

// ─── Draw levels: 4 lines + 1 combined label box ──────────────
if longEntry
    e   = close
    sl  = e * (1 - slPct  / 100)
    tp1 = e * (1 + tp1Pct / 100)
    tp2 = e * (1 + tp2Pct / 100)
    x1  = bar_index
    x2  = bar_index + lineLen

    // Individual horizontal lines
    line.new(x1, e,   x2, e,   color=color.white,            width=1, style=line.style_dotted, xloc=xloc.bar_index)
    line.new(x1, sl,  x2, sl,  color=color.new(#FF3333, 0),  width=2, style=line.style_solid,  xloc=xloc.bar_index)
    line.new(x1, tp1, x2, tp1, color=color.new(#00C853, 0),  width=2, style=line.style_solid,  xloc=xloc.bar_index)
    line.new(x1, tp2, x2, tp2, color=color.new(#00897B, 0),  width=2, style=line.style_dashed, xloc=xloc.bar_index)

    // One combined info box placed above TP2
    txt = "BUY SIGNAL\n" +
      "Entry:      " + str.tostring(math.round(e,   2)) + "\n" +
      "Stop Loss:  " + str.tostring(math.round(sl,  2)) + "  (-" + str.tostring(slPct)  + "%)\n" +
      "Take Prof 1: " + str.tostring(math.round(tp1, 2)) + "  (+" + str.tostring(tp1Pct) + "%)\n" +
      "Take Prof 2: " + str.tostring(math.round(tp2, 2)) + "  (+" + str.tostring(tp2Pct) + "%)"
    label.new(x1, tp2 * 1.01, txt,
      color=#00C853, textcolor=color.white,
      style=label.style_label_lower_right, size=size.normal,
      xloc=xloc.bar_index)

if shortEntry
    e   = close
    sl  = e * (1 + slPct  / 100)
    tp1 = e * (1 - tp1Pct / 100)
    tp2 = e * (1 - tp2Pct / 100)
    x1  = bar_index
    x2  = bar_index + lineLen

    // Individual horizontal lines
    line.new(x1, e,   x2, e,   color=color.white,            width=1, style=line.style_dotted, xloc=xloc.bar_index)
    line.new(x1, sl,  x2, sl,  color=color.new(#FF3333, 0),  width=2, style=line.style_solid,  xloc=xloc.bar_index)
    line.new(x1, tp1, x2, tp1, color=color.new(#D50000, 0),  width=2, style=line.style_solid,  xloc=xloc.bar_index)
    line.new(x1, tp2, x2, tp2, color=color.new(#B71C1C, 0),  width=2, style=line.style_dashed, xloc=xloc.bar_index)

    // One combined info box placed below TP2
    txt = "SELL SIGNAL\n" +
      "Entry:      " + str.tostring(math.round(e,   2)) + "\n" +
      "Stop Loss:  " + str.tostring(math.round(sl,  2)) + "  (+" + str.tostring(slPct)  + "%)\n" +
      "Take Prof 1: " + str.tostring(math.round(tp1, 2)) + "  (-" + str.tostring(tp1Pct) + "%)\n" +
      "Take Prof 2: " + str.tostring(math.round(tp2, 2)) + "  (-" + str.tostring(tp2Pct) + "%)"
    label.new(x1, tp2 * 0.99, txt,
      color=#D50000, textcolor=color.white,
      style=label.style_label_upper_right, size=size.normal,
      xloc=xloc.bar_index)

// ─── MA / Supertrend plots ────────────────────────────────────
plot(ema20,  "EMA 20",     #FF6D00, 2)
plot(ma50,   "MA 50",      #2962FF, 2)
plot(stLine, "SuperTrend", stDir < 0 ? #00C853 : #D50000, 2)

// ─── Signal arrows ────────────────────────────────────────────
plotshape(longEntry,  "LONG",  shape.triangleup,  location.belowbar, #00C853, size=size.normal, text="BUY")
plotshape(shortEntry, "SHORT", shape.triangledown, location.abovebar, #D50000, size=size.normal, text="SELL")

// ─── Alerts ───────────────────────────────────────────────────
alertcondition(longEntry,  "LONG ENTRY",  "BUY {{ticker}} @ {{close}}")
alertcondition(shortEntry, "SHORT ENTRY", "SELL {{ticker}} @ {{close}}")
