//@version=5
//──────────────────────────────────────────────────────────────────────────────
// ADX + MA 
// Developer: Bassem (BcK)
// Description:
//   Plots the ADX line and a user-selectable moving average of ADX (SMA/EMA/RMA/WMA)
//   to help visualize trend strength and how it’s changing over time.
//
// Notes:
//   - ADX measures trend strength (not direction).
//   - Use as a filter with your own directional logic (+DI/−DI, price action, etc.).
//   - No trading signals are generated by this script.
//
// © BcK
//──────────────────────────────────────────────────────────────────────────────

indicator("ADX + MA (BcK)", shorttitle="ADX+MA", overlay=false)

// ADX inputs
diLen     = input.int(14, "DI Length", minval=1)
adxSmooth = input.int(14, "ADX Smoothing", minval=1)

// MA inputs
maLen  = input.int(100, "MA Length", minval=1)
maType = input.string("SMA", "MA Type", options=["SMA", "EMA", "RMA (Wilder)", "WMA"])

// Helper
maFunc(src, len, type) =>
    switch type
        "SMA"          => ta.sma(src, len)
        "EMA"          => ta.ema(src, len)
        "RMA (Wilder)" => ta.rma(src, len)
        "WMA"          => ta.wma(src, len)

// ADX (+DI, -DI also returned)
[plusDI, minusDI, adx] = ta.dmi(diLen, adxSmooth)

// MA of ADX
adxMA = maFunc(adx, maLen, maType)

// Plots (ADX red, MA blue)
plot(adx,   title="ADX",    color=color.red,  linewidth=2)
plot(adxMA, title="ADX MA", color=color.blue, linewidth=2)

// DI plots
plot(plusDI,  title="+DI", color=color.lime)
plot(minusDI, title="-DI", color=color.fuchsia)
