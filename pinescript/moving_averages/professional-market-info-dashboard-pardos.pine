//@version=6
// Professional Market Info Dashboard - Clean & Stable Version
// This version is optimized for performance and compatibility across all asset classes.
// It tracks volatility, volume dynamics, trend alignment, and global market correlations.
indicator("Professional Market Info Dashboard", overlay = true, max_labels_count = 500)

//---------------------------------------------------------
// Inputs
//---------------------------------------------------------
atrLen      = input.int(14,    "ATR Length", group="Volatility")
atrPctTh    = input.float(4.0, "ATR % Threshold", step = 0.1, group="Volatility")

volLenShort = input.int(5,     "Volume MA Short", group="Volume")
volLenLong  = input.int(50,    "Volume MA Long", group="Volume")
volLenExtra = input.int(150,   "Volume MA Extra", group="Volume")

maLenShort  = input.int(10,    "Price MA Short", group="Moving Averages")
maLenLong   = input.int(50,    "Price MA Long", group="Moving Averages")

// Year To Date
showYTD     = input.bool(true, "Show YTD % Change", group="Performance")

// External Symbols
usdIlsSymbol = input.symbol("FX_IDC:USDILS", "USDILS Symbol", group="External Markets")
showUsdIls   = input.bool(true, "Show USDILS Price", group="External Markets")

spFutSymbol = input.symbol("CME_MINI:ES1!", "S&P Futures Symbol", group="External Markets")
showSpFut   = input.bool(true, "Show S&P Fut", group="External Markets")

vixSymbol   = input.symbol("CBOE:VIX", "VIX Symbol", group="External Markets")
showVix     = input.bool(true, "Show VIX", group="External Markets")

// Display Toggles
showTicker  = input.bool(true,  "Show Ticker", group="Visibility")
showATR     = input.bool(true,  "Show ATR %", group="Visibility")
showVol5    = input.bool(true,  "Show Volume MA Short", group="Visibility")
showVol50   = input.bool(true,  "Show Volume MA Long", group="Visibility")
showVol150  = input.bool(true,  "Show Volume MA Extra", group="Visibility")
showMA10    = input.bool(true,  "Show MA Short State", group="Visibility")
showMA50    = input.bool(true,  "Show MA Long State", group="Visibility")

// Styling
headerBgColor   = input.color(color.new(color.gray, 80), "Header Background")
headerTextColor = input.color(color.white, "Header Text Color")
valueTextSize   = input.string("large", "Value Text Size", options = ["tiny", "small", "normal", "large"])

f_size(string s) =>
    switch s
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        => size.large

//---------------------------------------------------------
// Calculations
//---------------------------------------------------------
// ATR calculation
atrValue    = ta.atr(atrLen)
atrPct      = (atrValue / close) * 100.0

// Volume Moving Averages
volMAshort  = ta.sma(volume, volLenShort)
volMAlong   = ta.sma(volume, volLenLong)
volMAextra  = ta.sma(volume, volLenExtra)

// Price Moving Averages
maShort      = ta.sma(close, maLenShort)
maLong       = ta.sma(close, maLenLong)
isAboveShort = close > maShort
isAboveLong  = close > maLong

// MA 5 Cross Detection for Visual Signals
ma5 = ta.sma(close, 5)
bullCrossMA5 = ta.crossover(close, ma5)
bearCrossMA5 = ta.crossunder(close, ma5)

// YTD Performance
var float yearOpen = na
if ta.change(year(time)) != 0 or na(yearOpen)
    yearOpen := open
ytdChangePct = yearOpen != 0 ? (close - yearOpen) / yearOpen * 100.0 : na

// External Data Requests
usdIlsClose = request.security(usdIlsSymbol, timeframe.period, close)
[spOpen, spClose]   = request.security(spFutSymbol, timeframe.period, [open, close], ignore_invalid_symbol = true)
[vixOpen, vixClose] = request.security(vixSymbol, timeframe.period, [open, close], ignore_invalid_symbol = true)

spFutChangePct = spOpen != 0 ? (spClose - spOpen) / spOpen * 100.0 : na
vixChangePct   = vixOpen != 0 ? (vixClose - vixOpen) / vixOpen * 100.0 : na

//---------------------------------------------------------
// Visual Signals on Chart
//---------------------------------------------------------
plotshape(bearCrossMA5, title = "MA5 Bear Cross", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.small)
plotshape(bullCrossMA5, title = "MA5 Bull Cross", style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.small)

//---------------------------------------------------------
// Dashboard Construction (Table)
//---------------------------------------------------------
var infoTable = table.new(position.top_right, 2, 15, border_width = 1, border_color = color.new(color.gray, 50))

f_setRow(tbl, int row, string title, string value, color valColor) =>
    table.cell(tbl, 0, row, title, text_color = headerTextColor, bgcolor = headerBgColor, text_size = size.normal)
    table.cell(tbl, 1, row, value, text_color = valColor, text_size = f_size(valueTextSize), bgcolor = color.new(color.black, 40))

if barstate.islast
    table.clear(infoTable, 0, 0, 1, 14)
    int row = 0

    if showTicker
        f_setRow(infoTable, row, "Ticker", syminfo.ticker, color.white)
        row += 1

    if showATR
        atrColor = atrPct > atrPctTh ? color.red : color.lime
        f_setRow(infoTable, row, "ATR %", str.tostring(atrPct, "#.##") + "%", atrColor)
        row += 1

    if showVol5
        volShortColor = volMAshort > volMAlong ? color.lime : color.red
        f_setRow(infoTable, row, "Vol " + str.tostring(volLenShort), str.tostring(volMAshort, format.volume), volShortColor)
        row += 1

    if showVol50
        f_setRow(infoTable, row, "Vol " + str.tostring(volLenLong), str.tostring(volMAlong, format.volume), color.white)
        row += 1

    if showVol150
        f_setRow(infoTable, row, "Vol " + str.tostring(volLenExtra), str.tostring(volMAextra, format.volume), color.white)
        row += 1

    if showMA10
        f_setRow(infoTable, row, "MA " + str.tostring(maLenShort), isAboveShort ? "Above" : "Below", isAboveShort ? color.lime : color.red)
        row += 1

    if showMA50
        f_setRow(infoTable, row, "MA " + str.tostring(maLenLong), isAboveLong ? "Above" : "Below", isAboveLong ? color.lime : color.red)
        row += 1

    if showYTD and not na(ytdChangePct)
        f_setRow(infoTable, row, "YTD %", str.tostring(ytdChangePct, "#.##") + "%", ytdChangePct < 0 ? color.red : color.lime)
        row += 1

    if showUsdIls and not na(usdIlsClose)
        f_setRow(infoTable, row, "USDILS", str.tostring(usdIlsClose, "#.###"), color.white)
        row += 1
    
    if showSpFut and not na(spFutChangePct)
        f_setRow(infoTable, row, "S&P Fut %", str.tostring(spFutChangePct, "#.##") + "%", spFutChangePct < 0 ? color.red : color.lime)
        row += 1

    if showVix and not na(vixChangePct)
        f_setRow(infoTable, row, "VIX %", str.tostring(vixChangePct, "#.##") + "%", vixChangePct < 0 ? color.red : color.lime)
        row += 1
