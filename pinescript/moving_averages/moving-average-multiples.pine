//@version=6
indicator("Moving Average Multiples", shorttitle = "MA Multi", overlay = true, timeframe = "", timeframe_gaps = true)

ma(source, length, MAtype) =>
    switch MAtype
        "SMA"        => ta.sma(source,  length) 
        "EMA"        => ta.ema(source,  length) 
        "SMMA (RMA)" => ta.rma(source,  length) 
        "WMA"        => ta.wma(source,  length) 
        "VWMA"       => ta.vwma(source, length) 
        => na

gradientFill   = input(true, "Gradient Fill", inline = "Gradient Fill", display = display.none)

show_ma1   = input(true,         "MA #1", inline = "MA #1", display = display.none)
ma1_type   = input.string("EMA", "",      inline = "MA #1", active = show_ma1, options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"])
ma1_source = input(close,        "",      inline = "MA #1", active = show_ma1, display = display.none)
ma1_length = input.int(10,       "",      inline = "MA #1", active = show_ma1, minval  = 1)
ma1_color  = input(#1bd2c8,    "",      inline = "MA #1", active = show_ma1, display = display.none)

show_ma2   = input(true,         "MA #2", inline = "MA #2", display = display.none)
ma2_type   = input.string("EMA", "",      inline = "MA #2", active = show_ma2, options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"])
ma2_source = input(close,        "",      inline = "MA #2", active = show_ma2, display = display.none)
ma2_length = input.int(20,       "",      inline = "MA #2", active = show_ma2, minval  = 1)
ma2_color  = input(color.rgb(41, 195, 36),    "",      inline = "MA #2", active = show_ma2, display = display.none)

show_ma3   = input(true,         "MA #3", inline = "MA #3", display = display.none)
ma3_type   = input.string("EMA", "",      inline = "MA #3", active = show_ma3, options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"])
ma3_source = input(close,        "",      inline = "MA #3", active = show_ma3, display = display.none)
ma3_length = input.int(50,      "",      inline = "MA #3", active = show_ma3, minval  = 1)
ma3_color  = input(color.rgb(12, 51, 210),    "",      inline = "MA #3", active = show_ma3, display = display.none)

show_ma4   = input(true,         "MA #4", inline = "MA #4", display = display.none)
ma4_type   = input.string("EMA", "",      inline = "MA #4", active = show_ma4, options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"])
ma4_source = input(close,        "",      inline = "MA #4", active = show_ma4, display = display.none)
ma4_length = input.int(100,      "",      inline = "MA #4", active = show_ma4, minval  = 1)
ma4_color  = input(#da17af,    "",      inline = "MA #4", active = show_ma4, display = display.none)

show_ma5   = input(true,         "MA #5", inline = "MA #5", display = display.none)
ma5_type   = input.string("EMA", "",      inline = "MA #5", active = show_ma5, options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"])
ma5_source = input(close,        "",      inline = "MA #5", active = show_ma5, display = display.none)
ma5_length = input.int(200,      "",      inline = "MA #5", active = show_ma5, minval  = 1)
ma5_color  = input(color.rgb(213, 41, 15),      "",      inline = "MA #5", active = show_ma5, display = display.none)

ma1 = show_ma1 ? ma(ma1_source, ma1_length, ma1_type) : na
ma2 = show_ma2 ? ma(ma2_source, ma2_length, ma2_type) : na
ma3 = show_ma3 ? ma(ma3_source, ma3_length, ma3_type) : na
ma4 = show_ma4 ? ma(ma4_source, ma4_length, ma4_type) : na
ma5 = show_ma5 ? ma(ma5_source, ma5_length, ma5_type) : na


// Gradient Ribbon Fills
p1 = plot(ma1, "MA #1", ma1_color, display = show_ma1 ? display.all : display.none)
p2 = plot(ma2, "MA #2", ma2_color, display = show_ma2 ? display.all : display.none)
p3 = plot(ma3, "MA #3", ma3_color, display = show_ma3 ? display.all : display.none)
p4 = plot(ma4, "MA #4", ma4_color, display = show_ma4 ? display.all : display.none)
p5 = plot(ma5, "MA #5", ma5_color, display = show_ma5 ? display.all : display.none)

// Smooth gradient fills between each MA

fill(p1, p2, gradientFill ? color.new(ma1_color, 80) : na)
fill(p2, p3, gradientFill ? color.new(ma2_color, 80) : na)
fill(p3, p4, gradientFill ? color.new(ma3_color, 80) : na)
fill(p4, p5, gradientFill ? color.new(ma4_color, 80) : na)
