//@version=6
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
indicator("CHoCH & Divergence Fib Setup", shorttitle = "CHoCH Div Setup", overlay = true, max_boxes_count = 100, max_lines_count = 100, max_labels_count = 100)

// --- Constants & Colors ---
color BULL_COLOR     = #089981
color BEAR_COLOR     = #f23645
color NEUTRAL_COLOR  = #5b9cf6
color RISK_ZONE      = color.new(BEAR_COLOR, 85)
color REWARD_ZONE    = color.new(BULL_COLOR, 85)

// --- Inputs ---
// --- Market Structure ---
int pivotLookbackInput = input.int(5, "Pivot Lookback", minval = 1, group = "Market Structure")
color chochColorInput  = input.color(color.new(#ff9800, 30), "CHoCH Color", group = "Market Structure")
int chochWidthInput    = input.int(3, "CHoCH Line Width", minval = 1, group = "Market Structure")
string chochStyleInput = input.string("Solid", "CHoCH Line Style", options = ["Solid", "Dashed", "Dotted"], group = "Market Structure")

// --- Divergence ---
int rsiLengthInput = input.int(14, "RSI Length", minval = 1, group = "Divergence")

// --- Trade Setup ---
float fibEntryLevelInput = input.float(0.5, "Fib Entry Level", minval = 0, maxval = 1, step = 0.1, group = "Trade Setup", tooltip = "Level where entry is placed (0-1).")
float slFibLevelInput    = input.float(-0.2, "Stop Loss Fib Level", step = 0.1, group = "Trade Setup", tooltip = "Fib level for SL. -0.2 places it below/above the pivot extreme (0).")
int setupDurationInput   = input.int(30, "Visual Duration (Bars)", minval = 5, group = "Trade Setup")
int labelOffsetInput     = input.int(2, "Label Right Offset", minval = 0, group = "Trade Setup")

// --- Style ---
color vwapColorInput   = input.color(#ff9800, "VWAP Color", group = "Style")
color ma9ColorInput    = input.color(#2196f3, "MA 9 Color", group = "Style")
color ma20ColorInput   = input.color(#e91e63, "MA 20 Color", group = "Style")
color ma113ColorInput  = input.color(#9c27b0, "MA 113 Color", group = "Style")

// --- Helper: Get Line Style ---
getLineStyle(style) =>
    switch style
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

// --- Indicators ---
plot(ta.vwap, "VWAP", color = vwapColorInput, linewidth = 2)
plot(ta.sma(close, 9), "MA 9", color = ma9ColorInput)
plot(ta.sma(close, 20), "MA 20", color = ma20ColorInput)
plot(ta.sma(close, 113), "MA 113", color = ma113ColorInput, linewidth = 2)

// --- Logic: Divergence Detection ---
rsiValue = ta.rsi(close, rsiLengthInput)
plRsi    = ta.pivotlow(rsiValue, pivotLookbackInput, pivotLookbackInput)
phRsi    = ta.pivothigh(rsiValue, pivotLookbackInput, pivotLookbackInput)

var float lastPlPrice = na, var float lastPlRsi = na, var int lastPlIdx = na
var float lastPhPrice = na, var float lastPhRsi = na, var int lastPhIdx = na

if not na(plRsi)
    lastPlPrice := low[pivotLookbackInput], lastPlRsi := rsiValue[pivotLookbackInput], lastPlIdx := bar_index - pivotLookbackInput
if not na(phRsi)
    lastPhPrice := high[pivotLookbackInput], lastPhRsi := rsiValue[pivotLookbackInput], lastPhIdx := bar_index - pivotLookbackInput

bool bullishDivConfirmed = not na(plRsi) and low[pivotLookbackInput] < lastPlPrice[1] and rsiValue[pivotLookbackInput] > lastPlRsi[1]
bool bearishDivConfirmed = not na(phRsi) and high[pivotLookbackInput] > lastPhPrice[1] and rsiValue[pivotLookbackInput] < lastPhRsi[1]

// --- Logic: CHoCH ---
var float lastPivotHigh = na, var float lastPivotLow  = na
var int   lastPivotHighIdx = na, var int lastPivotLowIdx  = na
var int   structureTrend = 0 
var string currentDivType = "None"

ph = ta.pivothigh(high, pivotLookbackInput, pivotLookbackInput)
pl = ta.pivotlow(low, pivotLookbackInput, pivotLookbackInput)

if not na(ph)
    lastPivotHigh := high[pivotLookbackInput], lastPivotHighIdx := bar_index - pivotLookbackInput
if not na(pl)
    lastPivotLow := low[pivotLookbackInput], lastPivotLowIdx := bar_index - pivotLookbackInput

// Detect CHoCH Breaks
if ta.crossover(close, lastPivotHigh) and (structureTrend == -1 or structureTrend == 0)
    line.new(lastPivotHighIdx, lastPivotHigh, bar_index, lastPivotHigh, color = chochColorInput, style = getLineStyle(chochStyleInput), width = chochWidthInput)
    label.new(bar_index, lastPivotHigh, "CHoCH", color = #00000000, textcolor = chochColorInput, style = label.style_label_down, size = size.small)
    structureTrend := 1, lastPivotHigh := na 

if ta.crossunder(close, lastPivotLow) and (structureTrend == 1 or structureTrend == 0)
    line.new(lastPivotLowIdx, lastPivotLow, bar_index, lastPivotLow, color = chochColorInput, style = getLineStyle(chochStyleInput), width = chochWidthInput)
    label.new(bar_index, lastPivotLow, "CHoCH", color = #00000000, textcolor = chochColorInput, style = label.style_label_up, size = size.small)
    structureTrend := -1, lastPivotLow := na

// --- Visuals: Objects Management ---
var line entryLine = na, var line slLine = na
var line[] tpLines = array.new_line()
var label entryLabel = na, var label slLabel = na
var label[] tpLabels = array.new_label()
var box riskBox = na, var box rewardBox = na
var line divLine = na, var label divLineLabel = na

cleanupTrade() =>
    line.delete(entryLine), line.delete(slLine), label.delete(entryLabel), label.delete(slLabel)
    line.delete(divLine), label.delete(divLineLabel), box.delete(riskBox), box.delete(rewardBox)
    while array.size(tpLines) > 0
        line.delete(array.shift(tpLines))
    while array.size(tpLabels) > 0
        label.delete(array.shift(tpLabels))

// --- Draw Trade Setup ---
if bullishDivConfirmed or bearishDivConfirmed
    cleanupTrade()
    bool isBull   = bullishDivConfirmed
    currentDivType := isBull ? "BULLISH" : "BEARISH"
    float lowRef  = isBull ? low[pivotLookbackInput] : low
    float highRef = isBull ? high : high[pivotLookbackInput]
    float sRange  = math.abs(highRef - lowRef)
    int startIdx  = bar_index
    int endIdx    = bar_index + setupDurationInput
    int lblIdx    = endIdx + labelOffsetInput
    
    // Calc Levels
    float entryP  = isBull ? highRef - (sRange * fibEntryLevelInput) : lowRef + (sRange * fibEntryLevelInput)
    float slP     = isBull ? lowRef + (sRange * slFibLevelInput) : highRef - (sRange * slFibLevelInput)
    
    // Divergence Line & Label
    int divX1 = isBull ? lastPlIdx[1] : lastPhIdx[1]
    int divX2 = bar_index - pivotLookbackInput
    float divY1 = isBull ? lastPlPrice[1] : lastPhPrice[1]
    float divY2 = isBull ? lowRef : highRef
    
    divLine := line.new(divX1, divY1, divX2, divY2, color = isBull ? BULL_COLOR : BEAR_COLOR, style = line.style_dashed, width = 2)
    divLineLabel := label.new(math.round(math.avg(divX1, divX2)), math.avg(divY1, divY2), (isBull ? "Bullish" : "Bearish") + " Div", color = #00000000, textcolor = isBull ? BULL_COLOR : BEAR_COLOR, style = isBull ? label.style_label_up : label.style_label_down, size = size.small)

    // Setup Visuals
    entryLine  := line.new(startIdx, entryP, endIdx, entryP, color = BULL_COLOR, width = 2)
    slLine     := line.new(startIdx, slP, endIdx, slP, color = BEAR_COLOR, width = 2)
    entryLabel := label.new(lblIdx, entryP, "ENTRY", color = #00000000, textcolor = BULL_COLOR, style = label.style_label_left, size = size.small)
    slLabel    := label.new(lblIdx, slP, "SL (Fib " + str.tostring(slFibLevelInput) + ")", color = #00000000, textcolor = BEAR_COLOR, style = label.style_label_left, size = size.small)

    float[] tpLevels = array.from(1.272, 1.618, 2.0, 2.618)
    float maxTpP = entryP 
    for i = 0 to array.size(tpLevels) - 1
        float lvl   = array.get(tpLevels, i)
        float tpVal = isBull ? lowRef + (sRange * lvl) : highRef - (sRange * lvl)
        if i == array.size(tpLevels) - 1
            maxTpP := tpVal
        array.push(tpLines, line.new(startIdx, tpVal, endIdx, tpVal, color = NEUTRAL_COLOR, style = line.style_dotted))
        array.push(tpLabels, label.new(lblIdx, tpVal, "TP " + str.tostring(i+1), color = #00000000, textcolor = NEUTRAL_COLOR, style = label.style_label_left, size = size.small))

    riskBox   := box.new(startIdx, isBull ? entryP : slP, endIdx, isBull ? slP : entryP, border_color = color.new(BEAR_COLOR, 100), bgcolor = RISK_ZONE)
    rewardBox := box.new(startIdx, isBull ? maxTpP : entryP, endIdx, isBull ? entryP : maxTpP, border_color = color.new(BULL_COLOR, 100), bgcolor = REWARD_ZONE)

// --- Dashboard ---
var table statusTable = table.new(position.bottom_right, 2, 2, border_width = 1, frame_color = chart.fg_color)
if barstate.islast
    string trendText = structureTrend == 1 ? "BULLISH" : (structureTrend == -1 ? "BEARISH" : "NEUTRAL")
    color trendColor = structureTrend == 1 ? BULL_COLOR : (structureTrend == -1 ? BEAR_COLOR : color.new(chart.fg_color, 90))
    
    color divColor = currentDivType == "BULLISH" ? BULL_COLOR : (currentDivType == "BEARISH" ? BEAR_COLOR : color.new(chart.fg_color, 90))
    
    // Row 1: Market Structure
    table.cell(statusTable, 0, 0, "Structure Trend", bgcolor = color.new(chart.fg_color, 80), text_color = chart.bg_color)
    table.cell(statusTable, 1, 0, trendText, bgcolor = trendColor, text_color = structureTrend != 0 ? color.white : chart.fg_color)
    
    // Row 2: Divergence Setup
    table.cell(statusTable, 0, 1, "Div Setup", bgcolor = color.new(chart.fg_color, 80), text_color = chart.bg_color)
    table.cell(statusTable, 1, 1, currentDivType, bgcolor = divColor, text_color = currentDivType != "None" ? color.white : chart.fg_color)
