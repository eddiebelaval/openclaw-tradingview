//@version=5
indicator("Bullish MA Signal", overlay=true)

// Define the Moving Averages (Simple Moving Averages)
ma10 = ta.sma(close, 10)
ma20 = ta.sma(close, 20)
ma50 = ta.sma(close, 50)
ma200 = ta.sma(close, 200)

// Plot the Moving Averages
plot(ma10, color=color.blue, title="10 MA")
plot(ma20, color=color.green, title="20 MA")
plot(ma50, color=color.orange, title="50 MA")
plot(ma200, color=color.red, title="200 MA")

// Check slopes are positive (current MA > previous MA)
slope10_pos = ma10 > ma10[1]
slope20_pos = ma20 > ma20[1]
slope50_pos = ma50 > ma50[1]
slope200_pos = ma200 > ma200[1]

// Check price above all MAs
price_above_all = close > ma10 and close > ma20 and close > ma50 and close > ma200

// Check the stacking conditions for 10 and 20 above 50
ma10_above_50 = ma10 > ma50
ma20_above_50 = ma20 > ma50

// Overall bullish condition
bullish_condition = price_above_all and ma10_above_50 and ma20_above_50 and slope10_pos and slope20_pos and slope50_pos and slope200_pos

// Detect the entry into the bullish condition (first bar where it's true)
bullish_signal = bullish_condition and not bullish_condition[1]

// Plot a shape only on the signal bar for alerts
plotshape(series=bullish_signal, title="Bullish Entry Signal", location=location.abovebar, color=color.green, style=shape.labelup, text="BULL", textcolor=color.white)
