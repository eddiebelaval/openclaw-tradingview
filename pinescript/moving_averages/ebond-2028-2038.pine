//@version=6
indicator("TR Eurobond 2028-2038 — Balanced Aggressive (BUY / BB / SELL / SELL+)", overlay=true, max_labels_count=500, max_lines_count=500)

//======================
// Inputs
//======================
src          = input.source(close, "Source")

bbLen        = input.int(30, "Bollinger Length", minval=10)
bbMult       = input.float(2.0, "Bollinger Mult", step=0.1)

rsiLen       = input.int(7, "RSI Length", minval=2)

// BUY thresholds
rsiOS_core   = input.int(25, "BUY core: RSI <= ", minval=1, maxval=50)
rsiOS_soft   = input.int(30, "BUY soft: RSI <= ", minval=1, maxval=60)

// STRONG BUY (BB) thresholds (tighter)
rsiOS_strong = input.int(20, "BB strong: RSI <= ", minval=1, maxval=50)

zLen         = input.int(90, "Z-Score Length", minval=20)
zCheap_core  = input.float(1.8, "BUY core: Z <= -", step=0.1)
zCheap_soft  = input.float(1.4, "BUY soft: Z <= -", step=0.1)

// STRONG BUY (BB) thresholds (tighter)
zCheap_strong = input.float(2.1, "BB strong: Z <= -", step=0.1)

// SELL thresholds
rsiExit      = input.int(55, "SELL: RSI >= ", minval=1, maxval=99)
zExit        = input.float(-0.2, "SELL: Z >= ", step=0.1)

// SELL+ thresholds
rsiOB        = input.int(70, "SELL+: RSI >= ", minval=50, maxval=99)
zRich        = input.float(1.0, "SELL+: Z >= ", step=0.1)

// Cooldowns
cooldownBuy  = input.int(3, "Min bars between BUY/BB signals", minval=0)
cooldownSell = input.int(3, "Min bars between SELL signals", minval=0)

// Divergence (bonus)
useDiv       = input.bool(true, "Draw RSI Divergence Lines")
pivotLeft    = input.int(3, "Pivot Left", minval=1)
pivotRight   = input.int(3, "Pivot Right", minval=1)

showBBands   = input.bool(true, "Show Bollinger Bands")
showSignals  = input.bool(true, "Show Signals")

//======================
// Core indicators
//======================
bbBasis = ta.sma(src, bbLen)
bbDev   = bbMult * ta.stdev(src, bbLen)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

rsi = ta.rsi(src, rsiLen)

zMean = ta.sma(src, zLen)
zStd  = ta.stdev(src, zLen)
z     = zStd != 0 ? (src - zMean) / zStd : na

touchLower = low <= bbLower
touchUpper = high >= bbUpper

//======================
// Plots
//======================
pU = plot(showBBands ? bbUpper : na, "BB Upper", color=color.new(color.aqua, 0))
pB = plot(showBBands ? bbBasis : na, "BB Basis", color=color.new(color.blue, 0))
pL = plot(showBBands ? bbLower : na, "BB Lower", color=color.new(color.fuchsia, 0))
fill(pU, pL, title="BB Fill", color=color.new(color.silver, 88))

plot(rsi, "RSI (data window)", display=display.data_window)
plot(z,   "Z-Score (data window)", display=display.data_window)

//======================
// Divergence (visual bonus)
//======================
plPrice = ta.pivotlow(low,  pivotLeft, pivotRight)
plRsi   = ta.pivotlow(rsi,  pivotLeft, pivotRight)
phPrice = ta.pivothigh(high, pivotLeft, pivotRight)
phRsi   = ta.pivothigh(rsi, pivotLeft, pivotRight)

var float lastPlPrice = na
var float lastPlRsi   = na
var int   lastPlBar   = na
var float lastPhPrice = na
var float lastPhRsi   = na
var int   lastPhBar   = na

bullDiv = false
bearDiv = false

if useDiv and not na(plPrice) and not na(plRsi)
    currBar = bar_index - pivotRight
    currP   = plPrice
    currR   = plRsi
    if not na(lastPlPrice) and not na(lastPlRsi)
        bullDiv := (currP < lastPlPrice) and (currR > lastPlRsi)
        if bullDiv
            line.new(lastPlBar, lastPlPrice, currBar, currP, color=color.new(color.lime, 0), width=2)
            line.new(lastPlBar, lastPlPrice, currBar, currP, color=color.new(color.aqua, 45), width=1)
    lastPlPrice := currP
    lastPlRsi   := currR
    lastPlBar   := currBar

if useDiv and not na(phPrice) and not na(phRsi)
    currBar = bar_index - pivotRight
    currP   = phPrice
    currR   = phRsi
    if not na(lastPhPrice) and not na(lastPhRsi)
        bearDiv := (currP > lastPhPrice) and (currR < lastPhRsi)
        if bearDiv
            line.new(lastPhBar, lastPhPrice, currBar, currP, color=color.new(color.red, 0), width=2)
            line.new(lastPhBar, lastPhPrice, currBar, currP, color=color.new(color.fuchsia, 45), width=1)
    lastPhPrice := currP
    lastPhRsi   := currR
    lastPhBar   := currBar

//======================
// Cooldown helpers
//======================
var int lastBuyBar  = na
var int lastSellBar = na

canBuy  = na(lastBuyBar)  ? true : (bar_index - lastBuyBar  >= cooldownBuy)
canSell = na(lastSellBar) ? true : (bar_index - lastSellBar >= cooldownSell)

//======================
// STRONG BUY (BB): tight confluence
//======================
bbStrong = touchLower and (rsi <= rsiOS_strong) and (z <= -zCheap_strong)

//======================
// BUY logic (core/soft/div) — same as before
//======================
buyCore = touchLower and (rsi <= rsiOS_core) and (z <= -zCheap_core)
buySoft = touchLower and (rsi <= rsiOS_soft) and (z <= -zCheap_soft)
buyDiv  = useDiv and touchLower and bullDiv and ( (rsi <= rsiOS_soft) or (z <= -zCheap_soft) )

// If BB strong exists, prefer BB label and suppress B on same bar
buyBB = showSignals and canBuy and bbStrong
buyB  = showSignals and canBuy and (buyCore or buySoft or buyDiv) and not buyBB

//======================
// SELL logic (independent)
//======================
sellA = (close >= bbBasis) and (rsi >= rsiExit) and (z >= zExit)
sellB = touchUpper and ( (rsi >= rsiOB) or (z >= zRich) or (useDiv and bearDiv) )

sellSignalA = showSignals and canSell and sellA
sellSignalB = showSignals and canSell and sellB

// update cooldown timestamps
if buyBB or buyB
    lastBuyBar := bar_index
if sellSignalA or sellSignalB
    lastSellBar := bar_index

//======================
// Plot signals
//======================
plotshape(buyB, title="BUY (B)", style=shape.triangleup, location=location.belowbar,
  size=size.small, color=color.new(color.lime, 0), text="B")

plotshape(buyBB, title="STRONG BUY (BB)", style=shape.triangleup, location=location.belowbar,
  size=size.small, color=color.new(color.blue, 0), text="BB")

plotshape(sellSignalA and not sellSignalB, title="SELL (TP)", style=shape.square, location=location.abovebar,
  size=size.tiny, color=color.new(color.yellow, 0), text="TP")

plotshape(sellSignalB, title="SELL+ (TP+)", style=shape.diamond, location=location.abovebar,
  size=size.tiny, color=color.new(color.fuchsia, 0), text="TP+")

// Bonus dot on buy if bullish divergence (info only)
plotshape(showSignals and (buyBB or buyB) and bullDiv, title="BUY bonus div", style=shape.circle,
  location=location.belowbar, size=size.tiny, color=color.new(color.aqua, 0), text="D")

//======================
// Alerts
//======================
alertcondition(buyB,        title="BUY (B)",         message="BUY B: BB lower + (core/soft/div)")
alertcondition(buyBB,       title="STRONG BUY (BB)", message="STRONG BUY BB: BB lower + RSI very low + Z very cheap")
alertcondition(sellSignalA, title="SELL (TP)",       message="SELL TP: back to BB basis + RSI>=exit + Z>=exit")
alertcondition(sellSignalB, title="SELL+ (TP+)",     message="SELL+ strong: upper stretch + (RSI/Z/bear div)")
