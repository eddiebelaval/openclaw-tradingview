//@version=5
indicator("5 EMA Cross", overlay=true)

// ──────────────────────────────────────────────
// EMA Values
// ──────────────────────────────────────────────
ema1_value = input.int(12,  minval=1, title="EMA 1 Value", group="EMA Settings")
ema2_value = input.int(21,  minval=1, title="EMA 2 Value", group="EMA Settings")
ema3_value = input.int(50,  minval=1, title="EMA 3 Value", group="EMA Settings")
ema4_value = input.int(100, minval=1, title="EMA 4 Value", group="EMA Settings")
ema5_value = input.int(200, minval=1, title="EMA 5 Value", group="EMA Settings")

// ──────────────────────────────────────────────
// Visibility Toggles
// ──────────────────────────────────────────────
show_ema1 = input.bool(true, title="Show EMA 1", group="Visibility")
show_ema2 = input.bool(true, title="Show EMA 2", group="Visibility")
show_ema3 = input.bool(true, title="Show EMA 3", group="Visibility")
show_ema4 = input.bool(true, title="Show EMA 4", group="Visibility")
show_ema5 = input.bool(true, title="Show EMA 5", group="Visibility")

// ──────────────────────────────────────────────
// Cross Pair 1 (EMA 1 & EMA 2)
// ──────────────────────────────────────────────
cross1_enabled = input.bool(true,        title="Enable Cross Pair 1 (EMA 1 & 2)", group="Cross Pair 1")
cross1_up_col  = input(color.green,      title="Uptrend Color",                   group="Cross Pair 1")
cross1_dn_col  = input(#ff0000,          title="Downtrend Color",                 group="Cross Pair 1")
ema1_neutral   = input(color.yellow,     title="EMA 1 Neutral Color",             group="Cross Pair 1")
ema2_neutral   = input(color.orange,     title="EMA 2 Neutral Color",             group="Cross Pair 1")
cross1_fill    = input.bool(false,       title="Show Fill Between EMA 1 & 2",     group="Cross Pair 1")
cross1_arrows  = input.bool(true,        title="Show Arrows",                     group="Cross Pair 1")
arrow1_size    = input.int(50, minval=1, title="Arrow Size",                      group="Cross Pair 1")

// ──────────────────────────────────────────────
// Cross Pair 2 (EMA 3 & EMA 4)
// ──────────────────────────────────────────────
cross2_enabled = input.bool(true,        title="Enable Cross Pair 2 (EMA 3 & 4)", group="Cross Pair 2")
cross2_up_col  = input(color.green,      title="Uptrend Color",                   group="Cross Pair 2")
cross2_dn_col  = input(#ff0000,          title="Downtrend Color",                 group="Cross Pair 2")
ema3_neutral   = input(color.purple,     title="EMA 3 Neutral Color",             group="Cross Pair 2")
ema4_neutral   = input(#ff0000,          title="EMA 4 Neutral Color",             group="Cross Pair 2")
cross2_fill    = input.bool(false,       title="Show Fill Between EMA 3 & 4",     group="Cross Pair 2")
cross2_arrows  = input.bool(false,       title="Show Arrows",                     group="Cross Pair 2")
arrow2_size    = input.int(50, minval=1, title="Arrow Size",                      group="Cross Pair 2")

// ──────────────────────────────────────────────
// Standalone EMA 5 Color
// ──────────────────────────────────────────────
ema5_color = input(#2196F3, title="EMA 5 Color", group="EMA 5 (Standalone)")

// ──────────────────────────────────────────────
// Confluence & Trend Filter
// ──────────────────────────────────────────────
show_aligned_alert = input.bool(false, title="Alert When Both Pairs Aligned",          group="Confluence")
use_ema5_filter    = input.bool(false, title="EMA 5 Trend Filter (price vs EMA 5)",    group="Confluence")

// ──────────────────────────────────────────────
// Calculate EMAs
// ──────────────────────────────────────────────
ema1 = ta.ema(close, ema1_value)
ema2 = ta.ema(close, ema2_value)
ema3 = ta.ema(close, ema3_value)
ema4 = ta.ema(close, ema4_value)
ema5 = ta.ema(close, ema5_value)

// ──────────────────────────────────────────────
// EMA 5 Trend Filter
// ──────────────────────────────────────────────
price_above_ema5 = close >= ema5
price_below_ema5 = close <  ema5

// ──────────────────────────────────────────────
// Cross Pair 1 Logic
// ──────────────────────────────────────────────
cross1_up   = cross1_enabled and ema1 >= ema2
cross1_down = cross1_enabled and ema1 <  ema2

// With EMA 5 filter: only show green if price above 200, only red if below
cross1_filtered_up   = use_ema5_filter ? (cross1_up and price_above_ema5) : cross1_up
cross1_filtered_down = use_ema5_filter ? (cross1_down and price_below_ema5) : cross1_down

color cross1_ema1_color = cross1_enabled ? (cross1_filtered_up ? cross1_up_col : cross1_filtered_down ? cross1_dn_col : ema1_neutral) : ema1_neutral
color cross1_ema2_color = cross1_enabled ? (cross1_filtered_up ? cross1_up_col : cross1_filtered_down ? cross1_dn_col : ema2_neutral) : ema2_neutral

var float crossover1 = na
if cross1_enabled
    if (crossover1 == 1)
        crossover1 := na
    else if (cross1_up[1] and cross1_down)
        crossover1 := -1
    else if (crossover1 == -1)
        crossover1 := na
    else if (cross1_down[1] and cross1_up)
        crossover1 := 1

// ──────────────────────────────────────────────
// Cross Pair 2 Logic
// ──────────────────────────────────────────────
cross2_up   = cross2_enabled and ema3 >= ema4
cross2_down = cross2_enabled and ema3 <  ema4

cross2_filtered_up   = use_ema5_filter ? (cross2_up and price_above_ema5) : cross2_up
cross2_filtered_down = use_ema5_filter ? (cross2_down and price_below_ema5) : cross2_down

color cross2_ema3_color = cross2_enabled ? (cross2_filtered_up ? cross2_up_col : cross2_filtered_down ? cross2_dn_col : ema3_neutral) : ema3_neutral
color cross2_ema4_color = cross2_enabled ? (cross2_filtered_up ? cross2_up_col : cross2_filtered_down ? cross2_dn_col : ema4_neutral) : ema4_neutral

var float crossover2 = na
if cross2_enabled
    if (crossover2 == 1)
        crossover2 := na
    else if (cross2_up[1] and cross2_down)
        crossover2 := -1
    else if (crossover2 == -1)
        crossover2 := na
    else if (cross2_down[1] and cross2_up)
        crossover2 := 1

// ──────────────────────────────────────────────
// Confluence: Both pairs aligned
// ──────────────────────────────────────────────
both_bullish = cross1_up and cross2_up
both_bearish = cross1_down and cross2_down
both_bullish_cross = both_bullish and not both_bullish[1]
both_bearish_cross = both_bearish and not both_bearish[1]

// ──────────────────────────────────────────────
// Plot EMAs
// ──────────────────────────────────────────────
p1 = plot(show_ema1 ? ema1 : na, color=cross1_ema1_color, title="EMA 1", linewidth=1)
p2 = plot(show_ema2 ? ema2 : na, color=cross1_ema2_color, title="EMA 2", linewidth=2)
p3 = plot(show_ema3 ? ema3 : na, color=cross2_ema3_color, title="EMA 3", linewidth=1)
p4 = plot(show_ema4 ? ema4 : na, color=cross2_ema4_color, title="EMA 4", linewidth=2)
plot(show_ema5 ? ema5 : na, color=ema5_color, title="EMA 5", linewidth=3)

// ──────────────────────────────────────────────
// Fill Between Cross Pairs
// ──────────────────────────────────────────────
color fill1_color = cross1_fill and cross1_enabled ? (cross1_filtered_up ? color.new(cross1_up_col, 85) : cross1_filtered_down ? color.new(cross1_dn_col, 85) : na) : na
color fill2_color = cross2_fill and cross2_enabled ? (cross2_filtered_up ? color.new(cross2_up_col, 85) : cross2_filtered_down ? color.new(cross2_dn_col, 85) : na) : na

fill(p1, p2, color=fill1_color, title="Cross Pair 1 Fill")
fill(p3, p4, color=fill2_color, title="Cross Pair 2 Fill")

// ──────────────────────────────────────────────
// Confluence Labels
// ──────────────────────────────────────────────
if show_aligned_alert and both_bullish_cross
    label.new(bar_index, low, "ALL BULLISH", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
if show_aligned_alert and both_bearish_cross
    label.new(bar_index, high, "ALL BEARISH", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

// ──────────────────────────────────────────────
// Arrows
// ──────────────────────────────────────────────
plotarrow(cross1_arrows and crossover1 == 1 ? 1 : cross1_arrows and crossover1 == -1 ? -1 : na, title="Cross Pair 1 Arrow", colorup=cross1_up_col, colordown=cross1_dn_col, maxheight=arrow1_size, offset=1)
plotarrow(cross2_arrows and crossover2 == 1 ? 1 : cross2_arrows and crossover2 == -1 ? -1 : na, title="Cross Pair 2 Arrow", colorup=cross2_up_col, colordown=cross2_dn_col, maxheight=arrow2_size, offset=1)

// ──────────────────────────────────────────────
// Alerts
// ──────────────────────────────────────────────
alertcondition(crossover1 == 1,  title="Cross Pair 1 — Trend Up",   message="EMA Cross Pair 1 Trend Up — {{ticker}} — {{interval}}")
alertcondition(crossover1 == -1, title="Cross Pair 1 — Trend Down", message="EMA Cross Pair 1 Trend Down — {{ticker}} — {{interval}}")
alertcondition(crossover2 == 1,  title="Cross Pair 2 — Trend Up",   message="EMA Cross Pair 2 Trend Up — {{ticker}} — {{interval}}")
alertcondition(crossover2 == -1, title="Cross Pair 2 — Trend Down", message="EMA Cross Pair 2 Trend Down — {{ticker}} — {{interval}}")
alertcondition(both_bullish_cross, title="Both Pairs — Bullish",    message="Both EMA pairs aligned BULLISH — {{ticker}} — {{interval}}")
alertcondition(both_bearish_cross, title="Both Pairs — Bearish",    message="Both EMA pairs aligned BEARISH — {{ticker}} — {{interval}}")
