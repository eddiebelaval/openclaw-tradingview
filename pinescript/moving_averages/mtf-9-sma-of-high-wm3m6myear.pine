//@version=6
indicator("MTF 9 SMA of High (W/M/3M/6M/Year)", overlay=true, max_labels_count=500)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
int len   = input.int(9, "SMA Length", minval=1)
int width = input.int(2, "Line Width", minval=1, maxval=5)

// ✅ Dropdown for Source (H/C/O/L)
string srcOpt = input.string("High", "SMA Source", options=["High", "Close", "Open", "Low"])

// Convert dropdown selection to a price series
series float src =
     srcOpt == "High"  ? high  :
     srcOpt == "Close" ? close :
     srcOpt == "Open"  ? open  :
     low

// Timeframes (selectable)
string tf1 = input.timeframe("W",   "Timeframe 1 (Default: Weekly)")
string tf2 = input.timeframe("M",   "Timeframe 2 (Default: Monthly)")
string tf3 = input.timeframe("3M",  "Timeframe 3 (Default: 3-Month)")
string tf4 = input.timeframe("6M",  "Timeframe 4 (Default: 6-Month)")
string tf5 = input.timeframe("12M", "Timeframe 5 (Default: Yearly / 12M)")

// Placeholders (optional)
string tf6 = input.timeframe("", "Timeframe 6 (Placeholder - optional)")
string tf7 = input.timeframe("", "Timeframe 7 (Placeholder - optional)")

// Show/Hide lines
bool show1 = input.bool(true,  "Show TF1 Line")
bool show2 = input.bool(true,  "Show TF2 Line")
bool show3 = input.bool(true,  "Show TF3 Line")
bool show4 = input.bool(true,  "Show TF4 Line")
bool show5 = input.bool(true,  "Show TF5 Line")
bool show6 = input.bool(false, "Show TF6 Line")
bool show7 = input.bool(false, "Show TF7 Line")

// Show/Hide labels
bool lab1 = input.bool(true,  "Show TF1 Label")
bool lab2 = input.bool(true,  "Show TF2 Label")
bool lab3 = input.bool(true,  "Show TF3 Label")
bool lab4 = input.bool(true,  "Show TF4 Label")
bool lab5 = input.bool(true,  "Show TF5 Label")
bool lab6 = input.bool(false, "Show TF6 Label")
bool lab7 = input.bool(false, "Show TF7 Label")

// Colors
color col1 = input.color(color.aqua,    "TF1 Color")
color col2 = input.color(color.orange,  "TF2 Color")
color col3 = input.color(color.fuchsia, "TF3 Color")
color col4 = input.color(color.yellow,  "TF4 Color")
color col5 = input.color(color.lime,    "TF5 Color")
color col6 = input.color(color.gray,    "TF6 Color")
color col7 = input.color(color.silver,  "TF7 Color")

// Label styling
color labelTextColor  = input.color(color.white, "Label Text Color")
int   labelOffsetBars = input.int(5, "Label Offset Bars (Right shift)", minval=0, maxval=200)
float labelPadTicks   = input.float(10, "Label Vertical Padding (ticks)", minval=0, step=1)
bool  showLabelValue  = input.bool(true, "Show SMA value in label")

// ─────────────────────────────────────────────────────────────────────────────
// HTF SMA(src, len)
// ─────────────────────────────────────────────────────────────────────────────
getSma(string tf) =>
    float out = na
    if tf != ""
        out := request.security(
            syminfo.tickerid,
            tf,
            ta.sma(src, len),
            gaps=barmerge.gaps_off,
            lookahead=barmerge.lookahead_off
        )
    out

// ─────────────────────────────────────────────────────────────────────────────
// v6-safe label updater: return updated label handle (no arg mutation)
// ─────────────────────────────────────────────────────────────────────────────
updateLabel(bool show, string tf, float val, color col, label lbl, int idx) =>
    label res = lbl

    if (not show) or (tf == "") or na(val)
        if not na(res)
            label.delete(res)
        res := na
    else
        int   x = bar_index + labelOffsetBars
        float y = val + (idx * labelPadTicks * syminfo.mintick)

        string baseTxt = tf + " " + str.tostring(len) + " SMA(" + srcOpt + ")"
        string txt = showLabelValue ? (baseTxt + " : " + str.tostring(val)) : baseTxt

        if na(res)
            res := label.new(
                x=x, y=y, text=txt,
                xloc=xloc.bar_index,
                style=label.style_label_left,
                color=col,
                textcolor=labelTextColor,
                size=size.small,
                force_overlay=true
            )
        else
            label.set_xy(res, x, y)
            label.set_text(res, txt)
            label.set_color(res, col)
            label.set_textcolor(res, labelTextColor)

    res

// ─────────────────────────────────────────────────────────────────────────────
// Values
// ─────────────────────────────────────────────────────────────────────────────
float sma1 = getSma(tf1)
float sma2 = getSma(tf2)
float sma3 = getSma(tf3)
float sma4 = getSma(tf4)
float sma5 = getSma(tf5)
float sma6 = getSma(tf6)
float sma7 = getSma(tf7)

// ─────────────────────────────────────────────────────────────────────────────
// Plots (Lines)
// ─────────────────────────────────────────────────────────────────────────────
plot(show1 ? sma1 : na, title="SMA - TF1", color=col1, linewidth=width)
plot(show2 ? sma2 : na, title="SMA - TF2", color=col2, linewidth=width)
plot(show3 ? sma3 : na, title="SMA - TF3", color=col3, linewidth=width)
plot(show4 ? sma4 : na, title="SMA - TF4", color=col4, linewidth=width)
plot(show5 ? sma5 : na, title="SMA - TF5", color=col5, linewidth=width)
plot(show6 ? sma6 : na, title="SMA - TF6", color=col6, linewidth=width)
plot(show7 ? sma7 : na, title="SMA - TF7", color=col7, linewidth=width)

// ─────────────────────────────────────────────────────────────────────────────
// Labels (last bar only)
// ─────────────────────────────────────────────────────────────────────────────
var label L1 = na
var label L2 = na
var label L3 = na
var label L4 = na
var label L5 = na
var label L6 = na
var label L7 = na

if barstate.islast
    L1 := updateLabel(lab1, tf1, sma1, col1, L1, 0)
    L2 := updateLabel(lab2, tf2, sma2, col2, L2, 1)
    L3 := updateLabel(lab3, tf3, sma3, col3, L3, 2)
    L4 := updateLabel(lab4, tf4, sma4, col4, L4, 3)
    L5 := updateLabel(lab5, tf5, sma5, col5, L5, 4)
    L6 := updateLabel(lab6, tf6, sma6, col6, L6, 5)
    L7 := updateLabel(lab7, tf7, sma7, col7, L7, 6)
