//@version=5
indicator("Cyberpunk Ichimoku Oracle", overlay=true, max_lines_count=500, max_labels_count=500)

// ==========================================
// 1. Settings / 設定
// ==========================================

// --- Group: Engine Core / エンジンコア ---
grp_engine = "Engine Core / タイムフレーム設定"
tenkan_len = input.int(9,  "Tenkan-sen / 転換線", minval=1, group=grp_engine)
kijun_len  = input.int(26, "Kijun-sen / 基準線", minval=1, group=grp_engine)
senkou_b   = input.int(52, "Senkou Span B / 先行スパンB", minval=1, group=grp_engine)
displacement = input.int(26, "Displacement / 先行期間", minval=1, group=grp_engine)

// --- Group: Visual Aesthetics / ビジュアル設定 ---
grp_visual = "Visual Aesthetics / ビジュアル設定"
show_tenkan = input.bool(true, "Show Tenkan / 転換線を表示", group=grp_visual)
show_kijun  = input.bool(true, "Show Kijun / 基準線を表示", group=grp_visual)
show_chikou = input.bool(true, "Show Chikou / 遅行スパンを表示", group=grp_visual)
show_kumo   = input.bool(true, "Show Kumo / 雲を表示", group=grp_visual)
show_glow   = input.bool(true, "Enable Neon Glow / ネオン発光を有効化", group=grp_visual)

// --- Group: HUD System / HUDシステム ---
grp_hud      = "HUD System / システム情報"
show_hud      = input.bool(true, "Show HUD / HUDを表示", group=grp_hud)
hud_position = input.string("top_right", "HUD Position / 表示位置", options=["top_right", "bottom_right", "top_left", "bottom_left"], group=grp_hud)
hud_size_in  = input.string("Small", "HUD Size / HUDサイズ", options=["Tiny", "Small", "Normal", "Large"], group=grp_hud)
is_jp         = input.bool(false, "HUD Language: Japanese / HUDを日本語にする", group=grp_hud)

// --- Cyberpunk Colors ---
C_CYAN    = #00f2ff
C_MAGENTA = #ff00ff
C_WHITE    = #ffffff
C_GRAY    = #404040
C_VOID    = color.new(#000000, 100) 

// ==========================================
// 2. Calculations / 計算
// ==========================================
donchian(len) => math.avg(ta.highest(high, len), ta.lowest(low, len))

tenkan  = donchian(tenkan_len)
kijun   = donchian(kijun_len)
span_a  = math.avg(tenkan, kijun)
span_b  = donchian(senkou_b)
chikou  = close

// ==========================================
// 3. Plotting / 描画
// ==========================================
plot(show_tenkan and show_glow ? tenkan : na, "Tenkan Glow", color.new(#ffff00, 80), 4)
plot(show_tenkan ? tenkan : na, "Tenkan-sen", #ffff00, 2)
plot(show_kijun and show_glow ? kijun : na, "Kijun Glow", color.new(C_WHITE, 80), 4)
plot(show_kijun ? kijun : na, "Kijun-sen", C_WHITE, 2)
plot(show_chikou ? chikou : na, "Chikou Span", C_CYAN, 1, offset = -displacement + 1)

p1 = plot(show_kumo ? span_a : na, "Span A", color.new(C_CYAN, 50), offset = displacement - 1)
p2 = plot(show_kumo ? span_b : na, "Span B", color.new(C_MAGENTA, 50), offset = displacement - 1)
fill(p1, p2, span_a > span_b ? color.new(C_CYAN, 85) : color.new(C_MAGENTA, 85), "Kumo Fill")

// ==========================================
// 4. Analysis & HUD / 解析とHUD
// ==========================================

h_size = switch hud_size_in
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large
    => size.small

h_pos = switch hud_position
    "top_right"    => position.top_right
    "bottom_right" => position.bottom_right
    "top_left"     => position.top_left
    "bottom_left"  => position.bottom_left
    => position.top_right

// 一目均衡表の解析
k_top = math.max(span_a[displacement-1], span_b[displacement-1])
k_btm = math.min(span_a[displacement-1], span_b[displacement-1])
p_vs_k = close > k_top ? 1 : close < k_btm ? -1 : 0
tk_c   = tenkan > kijun ? 1 : -1
c_stat = close > high[displacement-1] ? 1 : close < low[displacement-1] ? -1 : 0

// HUD描画
var table hud = table.new(h_pos, 2, 5, bgcolor=C_VOID)

if barstate.islast and show_hud
    // タイトルを ORACLE に変更 / フォント指定を削除
    table.cell(hud, 0, 0, "ORACLE: ICHIMOKU", text_color=C_CYAN, text_size=h_size)
    table.merge_cells(hud, 0, 0, 1, 0)
    
    table.cell(hud, 0, 1, is_jp ? "価格/雲:" : "PRICE/KUMO:", text_color=C_WHITE, text_size=h_size, text_halign=text.align_left)
    table.cell(hud, 1, 1, p_vs_k == 1 ? "BULLISH" : p_vs_k == -1 ? "BEARISH" : "NEUTRAL", text_color=(p_vs_k == 1 ? C_CYAN : p_vs_k == -1 ? C_MAGENTA : C_GRAY), text_size=h_size)

    table.cell(hud, 0, 2, is_jp ? "交差ステータス:" : "T-K CROSS:", text_color=C_WHITE, text_size=h_size, text_halign=text.align_left)
    table.cell(hud, 1, 2, tk_c == 1 ? "POSITIVE" : "NEGATIVE", text_color=(tk_c == 1 ? C_CYAN : C_MAGENTA), text_size=h_size)

    table.cell(hud, 0, 3, is_jp ? "遅行スパン:" : "CHIKOU SPAN:", text_color=C_WHITE, text_size=h_size, text_halign=text.align_left)
    table.cell(hud, 1, 3, c_stat == 1 ? "CLEAR" : c_stat == -1 ? "BLOCKED" : "NOISY", text_color=(c_stat == 1 ? C_CYAN : c_stat == -1 ? C_MAGENTA : C_GRAY), text_size=h_size)

    score = p_vs_k + tk_c + c_stat
    bias_text = score == 3 ? "STR-BULL" : score == -3 ? "STR-BEAR" : "SCANNING"
    bias_col  = score == 3 ? C_CYAN : score == -3 ? C_MAGENTA : C_WHITE
    
    table.cell(hud, 0, 4, is_jp ? "システムバイアス:" : "SYSTEM BIAS:", text_color=C_WHITE, text_size=h_size, text_halign=text.align_left)
    table.cell(hud, 1, 4, bias_text, text_color=bias_col, text_size=h_size, text_halign=text.align_left)
