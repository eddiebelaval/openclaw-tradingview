// © 2026 NEXOUS_cl - Institutional Trading Systems
// Author: Christakis Loizou (cl)
// Name: NEXOUS_cl UNIVERSAL PRO TRADER
//@version=5
indicator("NEXOUS_cl UNIVERSAL PRO TRADER", shorttitle="NEXOUS_cl", overlay=true, max_boxes_count=500)

// --- PROFESSIONAL DESCRIPTION ---
// [SYSTEM OVERVIEW]
// Developed by NEXOUS_cl for professional traders. 
// Features: 8-EMA Universal Ribbon for Trend Identification.
// High-Visibility Yellow Kill Zones for London and New York sessions.
// Real-time Audio Alerts for Session Entry.

// --- SETTINGS RIBBON ---
group_ribbon = "NEXOUS_cl Ribbon Settings"
show_ribbon = input.bool(true, "Show EMA Ribbon", group=group_ribbon)
src = input(close, "Source Data", group=group_ribbon)

ema1 = ta.ema(src, 20),  ema2 = ta.ema(src, 25),  ema3 = ta.ema(src, 30)
ema4 = ta.ema(src, 35),  ema5 = ta.ema(src, 40),  ema6 = ta.ema(src, 45)
ema7 = ta.ema(src, 50),  ema8 = ta.ema(src, 55)

// --- COLORS & PLOTS ---
color_up = color.new(#00ff00, 30)
color_dn = color.new(#ff0000, 30)
ribbon_col = ema1 > ema8 ? color_up : color_dn

plot(show_ribbon ? ema1 : na, color=ribbon_col, linewidth=1)
plot(show_ribbon ? ema2 : na, color=ribbon_col, linewidth=1)
plot(show_ribbon ? ema3 : na, color=ribbon_col, linewidth=1)
plot(show_ribbon ? ema4 : na, color=ribbon_col, linewidth=1)
plot(show_ribbon ? ema5 : na, color=ribbon_col, linewidth=1)
plot(show_ribbon ? ema6 : na, color=ribbon_col, linewidth=1)
plot(show_ribbon ? ema7 : na, color=ribbon_col, linewidth=1)
plot(show_ribbon ? ema8 : na, color=ribbon_col, linewidth=2, title="NEXOUS_cl Base EMA")

// --- INSTITUTIONAL KILL ZONES (HEAVY YELLOW) ---
group_kz = "NEXOUS_cl Kill Zones"
show_kz = input.bool(true, "Show Yellow Kill Zones", group=group_kz)
kz_color = color.new(#FFD700, 70) // Έντονο "Χρυσό-Κίτρινο"

// Session Times (London & New York)
is_london = time(timeframe.period, "0200-0500:23456") 
is_newyork = time(timeframe.period, "0800-1100:23456") 
in_zone = is_london or is_newyork

// Drawing
bgcolor(show_kz and in_zone ? kz_color : na)

// --- ALERTS SYSTEM ---
// 1. Alert for Kill Zone Entry
kz_entry = in_zone and not in_zone[1]
if kz_entry
    alert("NEXOUS_cl: Market entering Kill Zone! High Liquidity Expected.", alert.freq_once_per_bar)

// 2. Alert for Trend Change
long_signal = ta.crossover(ema1, ema8)
short_signal = ta.crossunder(ema1, ema8)

if long_signal
    alert("NEXOUS_cl: Bullish Trend Started", alert.freq_once_per_bar)
if short_signal
    alert("NEXOUS_cl: Bearish Trend Started", alert.freq_once_per_bar)

// --- SIGNALS ON CHART ---
plotshape(long_signal, title="Buy Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="NEXOUS_cl BUY")
plotshape(short_signal, title="Sell Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="NEXOUS_cl SELL")

// --- COPYRIGHT WATERMARK ---
var table watermark = table.new(position.bottom_right, 1, 1)
table.cell(watermark, 0, 0, "NEXOUS_cl PRO © 2026", text_color=color.new(color.white, 50), text_size=size.small)
