//@version=5
indicator("Nifty 50 Institutional Aggression", overlay=false, precision=2)

// --- 1. Aggressive Logic Function ---
// Isme hum 'Weightage' aur 'Volume Intensity' ka use karte hain
calc_aggression(s, w) =>
    // VWAP aur Volume ka combo hi asli 'Aggressive' move batata hai
    [p, vwapVal, vol, avgVol] = request.security(s, timeframe.period, [close, ta.vwap, volume, ta.sma(volume, 20)], gaps=barmerge.gaps_off)
    
    float score = 0.0
    is_bullish = p > vwapVal
    // Agar volume average se 1.5x zyada hai, toh ye "Aggressive" hai
    is_aggressive = vol > (avgVol * 1.5) 
    
    if is_bullish
        score := is_aggressive ? w : w * 0.4 // Aggressive buying ko full points
    else
        score := is_aggressive ? -w : -w * 0.4 // Aggressive selling ko negative points
    score

// --- 2. Nifty 50 Top Movers (High Impact) ---
// Nifty 50 ki movement inhi 10-12 stocks par tiki hoti hai
s1 = calc_aggression("NSE:HDFCBANK", 11.5), s2 = calc_aggression("NSE:RELIANCE", 9.2)
s3 = calc_aggression("NSE:ICICIBANK", 8.0), s4 = calc_aggression("NSE:INFY", 5.0)
s5 = calc_aggression("NSE:LT", 4.0), s6 = calc_aggression("NSE:ITC", 3.8)
s7 = calc_aggression("NSE:SBIN", 3.4), s8 = calc_aggression("NSE:BHARTIARTL", 3.3)
s9 = calc_aggression("NSE:TCS", 3.0), s10 = calc_aggression("NSE:AXISBANK", 2.8)

total_aggression = s1+s2+s3+s4+s5+s6+s7+s8+s9+s10

// --- 3. Plotting like Order Book Analysis ---
// Bars ka color intensity aggression level dikhayega
bar_col = total_aggression > 25 ? #00ff00 : total_aggression > 0 ? #a5d6a7 : total_aggression < -25 ? #ff0000 : #ef9a9a

plot(total_aggression, style=plot.style_columns, color=color.new(bar_col, 20), title="Nifty Aggressive Flow")

// Signal Line (Fast tracking like Quantsapp)
signal = ta.ema(total_aggression, 3)
plot(signal, color=color.white, linewidth=2, title="Trend Pulse")

// --- 4. Critical Levels ---
hline(0, "Neutral", color=color.gray)
hline(40, "Extreme Buying", color=color.new(color.green, 50), linestyle=hline.style_dashed)
hline(-40, "Extreme Selling", color=color.new(color.red, 50), linestyle=hline.style_dashed)
