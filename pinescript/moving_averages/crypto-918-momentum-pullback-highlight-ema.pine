//@version=5
indicator("Crypto 9/18 Momentum + Pullback (Fixed)", overlay=true)

// === EMAs
ema9  = ta.ema(close, 9)
ema18 = ta.ema(close, 18)
ema25 = ta.ema(close, 25)

// === Separation Filter
emaDistance = math.abs(ema9 - ema18)
minDistance = input.float(0.0, "Min EMA Separation", step=0.01)

bullTrend = ema9 > ema18 and emaDistance > minDistance
bearTrend = ema9 < ema18 and emaDistance > minDistance

// === Cross Detection
bullCross = ta.crossover(ema9, ema18)
bearCross = ta.crossunder(ema9, ema18)
isCross   = bullCross or bearCross

// === Plot EMAs
plot(ema9,  color=color.green,  linewidth=2, title="9 EMA")
plot(ema18, color=color.yellow, linewidth=2, title="18 EMA")

// 25 EMA (fixed width, highlight via colour only)
plot(ema25,
     color=isCross ? color.silver : color.new(color.silver, 60),
     linewidth=2,
     title="25 EMA")

// === Cross Candle Highlight (vertical band effect)
bgcolor(isCross ? color.new(color.silver, 85) : na)

// === Subtle Momentum Background
bgcolor(bullTrend and not isCross ? color.new(color.green, 94) :
       bearTrend and not isCross ? color.new(color.red, 94) : na)

// === Pullback Logic
pullbackBull = bullTrend and low <= ema18
pullbackBear = bearTrend and high >= ema18

confirmBull = pullbackBull and close > ema9
confirmBear = pullbackBear and close < ema9

plotshape(confirmBull, location=location.belowbar,
     style=shape.triangleup, size=size.small, color=color.green,
     title="Confirmed Bull Pullback")

plotshape(confirmBear, location=location.abovebar,
     style=shape.triangledown, size=size.small, color=color.red,
     title="Confirmed Bear Pullback")

// === Alerts
alertcondition(bullCross,
     title="Bullish Cross",
     message="9 crossed ABOVE 18 – Momentum Shift")

alertcondition(bearCross,
     title="Bearish Cross",
     message="9 crossed BELOW 18 – Momentum Shift")

alertcondition(confirmBull,
     title="Bull Pullback Confirmed",
     message="Bullish pullback confirmed")

alertcondition(confirmBear,
     title="Bear Pullback Confirmed",
     message="Bearish pullback confirmed")
