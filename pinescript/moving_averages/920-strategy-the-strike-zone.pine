//@version=6
indicator("9/20 Strategy: The Strike Zone", overlay=true, max_bars_back=500)

// --- 1. Inputs ---
emaLen      = input.int(9, "9 EMA")
smaLen      = input.int(20, "20 SMA")
rrRatio     = input.float(1.5, "Risk:Reward (1.5R)")
tickBuffer  = input.float(0.5, "SL Buffer")
shareCount  = input.int(50, "Number of Shares") 

// --- 2. Indicators ---
float emaVal = ta.ema(close, emaLen)
float smaVal = ta.sma(close, smaLen)
bool longCross  = ta.crossover(emaVal, smaVal)
bool shortCross = ta.crossunder(emaVal, smaVal)

plot(emaVal, color=color.blue, title="9 EMA", linewidth=2)
plot(smaVal, color=color.orange, title="20 SMA", linewidth=2)

// --- 3. Time Windows (NY Time) ---
sessMorning = "0930-1130"
sessPower   = "1500-1600"
bool isMorning  = not na(time(timeframe.period, sessMorning, "America/New_York"))
bool isPower    = not na(time(timeframe.period, sessPower, "America/New_York"))
bool isTradeWindow = isMorning or isPower

isNewDay = ta.change(time("D", "America/New_York")) != 0

// --- 4. Arrays ---
var sideArr   = array.new_string(0)
var entryArr  = array.new_float(0)
var slArr     = array.new_float(0)
var tpArr     = array.new_float(0)
var statusArr = array.new_string(0)
var pnlArr    = array.new_float(0) 
var pplArr    = array.new_float(0) 

if isNewDay
    array.clear(sideArr), array.clear(entryArr), array.clear(slArr), array.clear(tpArr), array.clear(statusArr), array.clear(pnlArr), array.clear(pplArr)

// --- 5. Signal Logic & Visual Marks ---
bool buySignal  = isTradeWindow and longCross
bool sellSignal = isTradeWindow and shortCross

if buySignal or sellSignal
    float ent = close
    float sl  = buySignal ? (low[1] - tickBuffer) : (high[1] + tickBuffer)
    float risk = math.abs(ent - sl)
    float tp   = buySignal ? (ent + (risk * rrRatio)) : (ent - (risk * rrRatio))
    
    array.push(sideArr, buySignal ? "BUY" : "SELL")
    array.push(entryArr, ent)
    array.push(slArr, sl)
    array.push(tpArr, tp)
    array.push(statusArr, "ACTIVE")
    array.push(pnlArr, 0.0)
    array.push(pplArr, 0.0)

    if array.size(sideArr) > 8
        array.shift(sideArr), array.shift(entryArr), array.shift(slArr), array.shift(tpArr), array.shift(statusArr), array.shift(pnlArr), array.shift(pplArr)
    
    // BUY/SELL Labels
    label.new(bar_index, buySignal ? low : high, text=buySignal ? "🚀 BUY" : "🔥 SELL", color=buySignal ? color.green : color.red, textcolor=color.white, style=buySignal ? label.style_label_up : label.style_label_down, yloc=buySignal ? yloc.belowbar : yloc.abovebar)
    
    // TP Line & Price Label
    line.new(bar_index, tp, bar_index + 12, tp, color=color.new(color.green, 30), width=2)
    label.new(bar_index + 6, tp, text="🎯 TP: " + str.tostring(tp, "#.##"), style=label.style_none, textcolor=color.green, size=size.normal)
    
    // SL Line & Price Label
    line.new(bar_index, sl, bar_index + 12, sl, color=color.new(color.red, 30), width=2, style=line.style_dashed)
    label.new(bar_index + 6, sl, text="🛑 SL: " + str.tostring(sl, "#.##"), style=label.style_none, textcolor=color.red, size=size.normal)

// --- 6. Tracking Logic ---
int wins = 0
int total = 0
float totalPnL = 0.0
float totalPPL = 0.0

if array.size(sideArr) > 0
    for i = 0 to array.size(sideArr) - 1
        float entryP = array.get(entryArr, i)
        float slP    = array.get(slArr, i)
        float tpP    = array.get(tpArr, i)
        string side  = array.get(sideArr, i)
        
        if array.get(statusArr, i) == "ACTIVE"
            if (side == "BUY" and high >= tpP) or (side == "SELL" and low <= tpP)
                array.set(statusArr, i, "WIN ✅"), array.set(pplArr, i, math.abs(tpP - entryP)), array.set(pnlArr, i, math.abs(tpP - entryP) * shareCount)
            else if (side == "BUY" and low <= slP) or (side == "SELL" and high >= slP)
                array.set(statusArr, i, "LOSS ❌"), array.set(pplArr, i, -math.abs(entryP - slP)), array.set(pnlArr, i, -math.abs(entryP - slP) * shareCount)

        if array.get(statusArr, i) != "ACTIVE"
            total += 1, totalPnL += array.get(pnlArr, i), totalPPL += array.get(pplArr, i)
            if array.get(statusArr, i) == "WIN ✅"
                wins += 1

float winRate = total > 0 ? (wins / total) * 100 : 0

// --- 7. Table ---
var table log = table.new(position.top_center, 7, 11, bgcolor=color.new(color.black, 30), border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(log, 0, 0, "THE STRIKE ZONE: DAILY LEDGER", text_color=color.white, bgcolor=color.new(color.blue, 40), text_size=size.large)
    table.merge_cells(log, 0, 0, 6, 0)
    
    headers = array.from("SIDE", "ENTRY", "SL", "TP", "PPL (Pts)", "PnL ($)", "RESULT")
    for i = 0 to 6
        table.cell(log, i, 1, array.get(headers, i), text_color=color.white, bgcolor=color.gray)

    for i = 0 to 7
        int r = i + 2
        if i < array.size(sideArr)
            table.cell(log, 0, r, array.get(sideArr, i), text_color = array.get(sideArr, i) == "BUY" ? color.green : color.red)
            table.cell(log, 1, r, str.tostring(array.get(entryArr, i), "#.##"), text_color=color.white)
            table.cell(log, 2, r, str.tostring(array.get(slArr, i), "#.##"), text_color=color.red)
            table.cell(log, 3, r, str.tostring(array.get(tpArr, i), "#.##"), text_color=color.green)
            table.cell(log, 4, r, str.tostring(array.get(pplArr, i), "#.##"), text_color = array.get(pplArr, i) >= 0 ? color.green : color.red)
            table.cell(log, 5, r, "$" + str.tostring(array.get(pnlArr, i), "#.##"), text_color = array.get(pnlArr, i) >= 0 ? color.green : color.red)
            table.cell(log, 6, r, array.get(statusArr, i), text_color=color.white)
        else
            for j = 0 to 6
                table.cell(log, j, r, "-", text_color=color.new(color.white, 70))

    // Summary Row
    table.cell(log, 0, 10, "WIN RATE: " + str.tostring(winRate, "#.#") + "%", bgcolor=color.new(color.gray, 40), text_color=winRate >= 50 ? color.green : color.red)
    table.merge_cells(log, 0, 10, 1, 10)
    table.cell(log, 2, 10, "TOTAL PTS: " + str.tostring(totalPPL, "#.##"), bgcolor=color.new(color.gray, 40), text_color=totalPPL >= 0 ? color.green : color.red)
    table.merge_cells(log, 2, 10, 3, 10)
    table.cell(log, 4, 10, "TOTAL PnL: $" + str.tostring(totalPnL, "#.##"), bgcolor=color.new(color.gray, 40), text_color=totalPnL >= 0 ? color.green : color.red)
    table.merge_cells(log, 4, 10, 6, 10)

// Highlight Time Zones (Blue for AM, Orange for Power Hour)
bgcolor(isMorning ? color.new(color.blue, 96) : isPower ? color.new(color.orange, 94) : na)
