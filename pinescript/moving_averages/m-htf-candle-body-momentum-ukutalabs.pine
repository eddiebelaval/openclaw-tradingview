//@version=6
indicator("M-HTF Candle Body Momentum [UkutaLabs]", overlay=true, max_lines_count = 500, max_boxes_count=1000)
import UkutaLabs/Higher_Time_Frame/9 as htf
import UkutaLabs/UkutaLabs_General_library/8 as ulgl

//------------------------
//USER VARIABLES
//------------------------
int Period = input.int(defval=21, title="Period", group="Configuration")
bool ShowLineGlow = input.bool(defval=false, title="Show Line Glow", group="Configuration", tooltip = "when enabled, it wil reduce the look back period length")

bool Display5 = input.bool(defval=false, title="Display (On/Off)", group="5 Minute (Higher Timeframe)")
color BullishColor5 = input.color(defval=color.lime, title="Bullish", inline="EMA5", group="5 Minute (Higher Timeframe)")
color BearishColor5 = input.color(defval=color.rgb(255, 0, 0), title="Bearish", inline="EMA5", group="5 Minute (Higher Timeframe)")
int LineWidthEMA5 = input.int(defval=1, title="Line Width", inline="EMA5", options=[1,2,3], group="5 Minute (Higher Timeframe)")

bool Display15 = input.bool(defval=false, title="Display (15 Minute)", group="15 Minute (Higher Timeframe)")
color BullishColor15 = input.color(defval=color.lime, title="Bullish", inline="EMA15", group="15 Minute (Higher Timeframe)")
color BearishColor15 = input.color(defval=color.rgb(255, 0, 0), title="Bearish", inline="EMA15", group="15 Minute (Higher Timeframe)")
int LineWidthEMA15 = input.int(defval=1, title="Line Width", inline="EMA15", options=[1,2,3], group="15 Minute (Higher Timeframe)")

bool Display30 = input.bool(defval=false, title="Display (30 Minute)", group="30 Minute (Higher Timeframe)")
color BullishColor30 = input.color(defval=color.lime, title="Bullish", inline="EMA30", group="30 Minute (Higher Timeframe)")
color BearishColor30 = input.color(defval=color.rgb(255, 0, 0), title="Bearish", inline="EMA30", group="30 Minute (Higher Timeframe)")
int LineWidthEMA30 = input.int(defval=1, title="Line Width", inline="EMA30", options=[1,2,3], group="30 Minute (Higher Timeframe)")

bool Display60 = input.bool(defval=false, title="Display (60 Minute)", group="60 Minute (Higher Timeframe)")
color BullishColor60 = input.color(defval=color.lime, title="Bullish", inline="EMA60", group="60 Minute (Higher Timeframe)")
color BearishColor60 = input.color(defval=color.rgb(255, 0, 0), title="Bearish", inline="EMA60", group="60 Minute (Higher Timeframe)")
int LineWidthEMA60 = input.int(defval=1, title="Line Width", inline="EMA60", options=[1,2,3], group="60 Minute (Higher Timeframe)")

bool Display120 = input.bool(defval=false, title="Display (120 Minute)", group="120 Minute (Higher Timeframe)")
color BullishColor120 = input.color(defval=color.lime, title="Bullish", inline="EMA120", group="120 Minute (Higher Timeframe)")
color BearishColor120 = input.color(defval=color.rgb(255, 0, 0), title="Bearish", inline="EMA120", group="120 Minute (Higher Timeframe)")
int LineWidthEMA120 = input.int(defval=1, title="Line Width", inline="EMA120", options=[1,2,3], group="120 Minute (Higher Timeframe)")

bool Display240 = input.bool(defval=false, title="Display (240 Minute)", group="240 Minute (Higher Timeframe)")
color BullishColor240 = input.color(defval=color.lime, title="Bullish", inline="EMA240", group="240 Minute (Higher Timeframe)")
color BearishColor240 = input.color(defval=color.rgb(255, 0, 0), title="Bearish", inline="EMA240", group="240 Minute (Higher Timeframe)")
int LineWidthEMA240 = input.int(defval=1, title="Line Width", inline="EMA240", options=[1,2,3], group="240 Minute (Higher Timeframe)")

bool DisplayDaily = input.bool(defval=false, title="Display (Daily)", group="Daily (Higher Timeframe)")
color BullishColorDaily = input.color(defval=color.lime, title="Bullish", inline="EMADaily", group="Daily (Higher Timeframe)")
color BearishColorDaily = input.color(defval=color.rgb(255, 0, 0), title="Bearish", inline="EMADaily", group="Daily (Higher Timeframe)")
int LineWidthEMADaily = input.int(defval=1, title="Line Width", inline="EMADaily", options=[1,2,3], group="Daily Minute (Higher Timeframe)")

//------------------------
//VARIABLES
//------------------------
var int tfp = timeframe.isintraday and not timeframe.isseconds ? int(str.tonumber(timeframe.period)) : 0

var int b = 0
var int b5 = 0
var int b15 = 0
var int b30 = 0
var int b60 = 0
var int b120 = 0
var int b240 = 0
var int b1380 = 0
var int s5 = 0
var int s15 = 0
var int s30 = 0
var int s60 = 0
var int s120 = 0
var int s240 = 0
var int s1380 = 0

var oCollection5 = array.new<htf.Candle> (0)
var oCollection15 = array.new<htf.Candle> (0)
var oCollection30 = array.new<htf.Candle> (0)
var oCollection60 = array.new<htf.Candle> (0)
var oCollection120 = array.new<htf.Candle> (0)
var oCollection240 = array.new<htf.Candle> (0)
var oCollectionDaily = array.new<htf.Candle> (0)

//------------------------
//METHODS
//------------------------

TrackHTF(int BarsPerHigher, int BarCount, array<htf.Candle> oCollection, color BullishColor, color BearishColor, int LineWidth) =>
    var htf.Candle newCandle = na
    var htf.Candle oCurrentCandle = na
    var htf.Candle oPreviousCandle = na
    oCurrentCandle := oCollection.size() > 0 ? oCollection.get(oCollection.size()-1) : na
    oPreviousCandle := oCollection.size() > 1 ? oCollection.get(oCollection.size()-2) : na

    if na(oCurrentCandle)
        oCurrentCandle := htf.Candle.new()
        oCurrentCandle.UID := 1
        oCurrentCandle.OpenPrice := open[0]
        oCurrentCandle.HighPrice := high[0]
        oCurrentCandle.LowPrice := low[0]

        oCurrentCandle.oCBM := htf.CBM.new()

        oCollection.push(oCurrentCandle)
      
    if BarCount%BarsPerHigher==0
        oCurrentCandle.ClosePrice := close[1] 
        oCurrentCandle.CloseIndex := bar_index[1]
        oCurrentCandle.Volume := oCurrentCandle.Volume + volume[1]
        if not na(oPreviousCandle)
            oCurrentCandle.MAOpen := htf.CalculateEMA(oCurrentCandle, Period, oCurrentCandle.OpenPrice, oPreviousCandle.MAOpen)
            oCurrentCandle.MAClose := htf.CalculateEMA(oCurrentCandle, Period, oCurrentCandle.ClosePrice, oPreviousCandle.MAClose)

        color MAColor = oCurrentCandle.MAClose < oCurrentCandle.MAOpen ? BearishColor : BullishColor

        if not na(oPreviousCandle)

            oCurrentCandle.oCBM.OpenLine.set_color(MAColor)
            oCurrentCandle.oCBM.OpenLine.set_y1(oPreviousCandle.MAOpen)
            oCurrentCandle.oCBM.OpenLine.set_y2(oCurrentCandle.MAOpen)

            if ShowLineGlow
                oCurrentCandle.oCBM.HOpenLine.set_color(color.new(MAColor,80))
                oCurrentCandle.oCBM.HOpenLine.set_y1(oPreviousCandle.MAOpen)
                oCurrentCandle.oCBM.HOpenLine.set_y2(oCurrentCandle.MAOpen)

            oCurrentCandle.oCBM.CloseLine.set_color(MAColor)
            oCurrentCandle.oCBM.CloseLine.set_y1(oPreviousCandle.MAClose)
            oCurrentCandle.oCBM.CloseLine.set_y2(oCurrentCandle.MAClose)

            if ShowLineGlow
                oCurrentCandle.oCBM.HCloseLine.set_color(color.new(MAColor,80))
                oCurrentCandle.oCBM.HCloseLine.set_y1(oPreviousCandle.MAClose)
                oCurrentCandle.oCBM.HCloseLine.set_y2(oCurrentCandle.MAClose) 
           

        newCandle := htf.Candle.new(    
            UID = oCollection.size() > 0 ? oCurrentCandle.UID + 1 : 1,
            OpenPrice = open[0],
            OpenIndex = bar_index[0],
            HighPrice = high[0],
            HighIndex = bar_index[0],
            LowPrice = low[0],
            LowIndex = bar_index[0],
            oCBM = htf.CBM.new()
        )

        oCollection.push(newCandle)

        newCandle.oCBM.OpenLine := line.new(x1 = bar_index, y1 = 0, x2 = bar_index, y2 = 0, color = MAColor, style = ulgl.GetLineStyle("Solid"), width=LineWidth)
        if ShowLineGlow
            newCandle.oCBM.HOpenLine := line.new(x1 = bar_index, y1 = 0, x2 = bar_index, y2 = 0, color = color.new(MAColor,80), style = ulgl.GetLineStyle("Solid"), width=8+LineWidth)
        newCandle.oCBM.CloseLine := line.new(x1 = bar_index, y1 = 0, x2 = bar_index, y2 = 0, color = MAColor, style = ulgl.GetLineStyle("Solid"), width=LineWidth)
        if ShowLineGlow    
            newCandle.oCBM.HCloseLine := line.new(x1 = bar_index, y1 = 0, x2 = bar_index, y2 = 0, color = color.new(MAColor,80), style = ulgl.GetLineStyle("Solid"), width=8+LineWidth)

    if BarCount%BarsPerHigher!=0 and not na(oCurrentCandle)
        oCurrentCandle.HighIndex := high[1] > oCurrentCandle.HighPrice ? bar_index[1] : oCurrentCandle.HighIndex
        oCurrentCandle.HighPrice := high[1] > oCurrentCandle.HighPrice ? high[1] : oCurrentCandle.HighPrice
        oCurrentCandle.LowIndex := low[1] < oCurrentCandle.LowPrice ? bar_index[1] : oCurrentCandle.LowIndex
        oCurrentCandle.LowPrice := low[1] < oCurrentCandle.LowPrice ? low[1] : oCurrentCandle.LowPrice
        if not na(oPreviousCandle)
            oCurrentCandle.MAOpen := htf.CalculateEMA(oCurrentCandle, Period, open[1], oPreviousCandle.MAOpen)
            oCurrentCandle.MAClose := htf.CalculateEMA(oCurrentCandle, Period, close[1], oPreviousCandle.MAClose)
 
        color MAColor = oCurrentCandle.MAClose < oCurrentCandle.MAOpen ? BearishColor : BullishColor

        oCurrentCandle.oCBM.OpenLine.set_color(MAColor)
        oCurrentCandle.oCBM.OpenLine.set_x1(oPreviousCandle.CloseIndex)
        oCurrentCandle.oCBM.OpenLine.set_x2(bar_index)
        oCurrentCandle.oCBM.OpenLine.set_y1(oPreviousCandle.MAOpen)
        oCurrentCandle.oCBM.OpenLine.set_y2(oCurrentCandle.MAOpen)

        if ShowLineGlow
            oCurrentCandle.oCBM.HOpenLine.set_color(color.new(MAColor,80))
            oCurrentCandle.oCBM.HOpenLine.set_x1(oPreviousCandle.CloseIndex)
            oCurrentCandle.oCBM.HOpenLine.set_x2(bar_index)
            oCurrentCandle.oCBM.HOpenLine.set_y1(oPreviousCandle.MAOpen)
            oCurrentCandle.oCBM.HOpenLine.set_y2(oCurrentCandle.MAOpen)

        oCurrentCandle.oCBM.CloseLine.set_color(MAColor)
        oCurrentCandle.oCBM.CloseLine.set_x1(oPreviousCandle.CloseIndex)
        oCurrentCandle.oCBM.CloseLine.set_x2(bar_index)
        oCurrentCandle.oCBM.CloseLine.set_y1(oPreviousCandle.MAClose)
        oCurrentCandle.oCBM.CloseLine.set_y2(oCurrentCandle.MAClose)

        if ShowLineGlow
            oCurrentCandle.oCBM.HCloseLine.set_color(color.new(MAColor,80))
            oCurrentCandle.oCBM.HCloseLine.set_x1(oPreviousCandle.CloseIndex)
            oCurrentCandle.oCBM.HCloseLine.set_x2(bar_index)
            oCurrentCandle.oCBM.HCloseLine.set_y1(oPreviousCandle.MAClose)
            oCurrentCandle.oCBM.HCloseLine.set_y2(oCurrentCandle.MAClose)


//------------------------
//FUNCTION
//------------------------

if session.isfirstbar
    b5 := 0
    b15 := 0
    b30 := 0
    b60 := 0
    b120 := 0
    b240 := 0
    b1380 := 0
    s5 := 0
    s15 := 0
    s30 := 0
    s60 := 0
    s120 := 0
    s240 := 0
    s1380 := 0    

if Display5 and 5%tfp==0
    b5 := session.isfirstbar ? 0 : b5+(time - time[1]) / 60000
    s5 := b5 > 5 ? b5-5 : 0
    b5 := b5 > 5 ? 5 : b5
    TrackHTF(5/tfp, b5, oCollection5, BullishColor5, BearishColor5, LineWidthEMA5)
    if b5%5 == 0
        b5 := s5
if Display15 and 15%tfp==0 
    b15 := session.isfirstbar ? 0 : b15+(time - time[1]) / 60000
    s15 := b15 > 15 ? b15-15 : 0
    b15 := b15 > 15 ? 15 : b15
    TrackHTF(15/tfp, b15, oCollection15, BullishColor15, BearishColor15, LineWidthEMA15)
    if b15%15 == 0
        b15 := s15
if Display30 and 30%tfp==0 
    b30 := session.isfirstbar ? 0 : b30+(time - time[1]) / 60000
    s30 := b30 > 30 ? b30-30 : 0
    b30 := b30 > 30 ? 30 : b30
    TrackHTF(30/tfp, b30, oCollection30, BullishColor30, BearishColor30, LineWidthEMA30)
    if b30%30 == 0
        b30 := s30
if Display60 and 60%tfp==0 
    b60 := session.isfirstbar ? 0 : b60+(time - time[1]) / 60000
    s60 := b60 > 60 ? b60-60 : 0
    b60 := b60 > 60 ? 60 : b60
    TrackHTF(60/tfp, b60, oCollection60, BullishColor60, BearishColor60, LineWidthEMA60)
    if b60%60 == 0
        b60 := s60
if Display120 and 120%tfp==0 
    b120 := session.isfirstbar ? 0 : b120+(time - time[1]) / 60000
    s120 := b120 > 120 ? b120-120 : 0
    b120 := b120 > 120 ? 120 : b120
    TrackHTF(120/tfp, b120, oCollection120, BullishColor120, BearishColor120, LineWidthEMA120)
    if b120%120 == 0
        b120 := s120
if Display240 and 240%tfp==0 
    b240 := session.isfirstbar ? 0 : b240+(time - time[1]) / 60000
    s240 := b240 > 240 ? b240-240 : 0
    b240 := b240 > 240 ? 240 : b240
    TrackHTF(240/tfp, b240, oCollection240, BullishColor240, BearishColor240, LineWidthEMA240)
    if b240%240 == 0
        b240 := s240
if DisplayDaily and 1380%tfp==0
    b1380 := session.isfirstbar ? 0 : b1380+(time - time[1]) / 60000
    s1380 := b1380 > 1380 ? b1380-1380 : 0
    b1380 := b1380 > 1380 ? 1380 : b1380
    TrackHTF(1380/tfp, b1380, oCollectionDaily, BullishColorDaily, BearishColorDaily, LineWidthEMADaily)
    if b1380%1380 == 0
        b1380 := s1380
