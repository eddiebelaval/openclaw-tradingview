// Enhanced by Monir Hasan | Hybrid SMC + MAs + Advanced Signals
// Version: V1 Ultra
//@version=6
indicator('Gold Master Hybrid V1 Ultra', 'GM V1 Ultra', overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)
MA_GROUP        = 'Moving Averages'
SMC_GROUP       = 'Smart Money Concepts'
OB_GROUP        = 'Order Blocks'
FVG_GROUP       = 'Fair Value Gaps'
SIG_GROUP       = 'Signal Settings'
RISK_GROUP      = 'Risk Management'
DASH_GROUP      = 'Dashboard'
show_ma_lines   = input.bool(true,  "Show MA Lines",            group = MA_GROUP)
show_ema9       = input.bool(true,  "Show EMA 9",               group = MA_GROUP)
show_ema21      = input.bool(true,  "Show EMA 21",              group = MA_GROUP)
show_sma50      = input.bool(true,  "Show SMA 50",              group = MA_GROUP)
show_sma100     = input.bool(true,  "Show SMA 100",             group = MA_GROUP)
show_sma200     = input.bool(true,  "Show SMA 200",             group = MA_GROUP)
show_swings     = input.bool(true,  "Show HH/HL/LH/LL Labels",  group = SMC_GROUP)
swing_len       = input.int(20,     "Swing Lookback Length",    minval = 5, maxval = 50, group = SMC_GROUP)
show_bos        = input.bool(true,  "Show BOS/CHoCH Lines",     group = SMC_GROUP)
show_ob         = input.bool(true,  "Show Order Blocks",        group = OB_GROUP)
ob_lookback     = input.int(10,     "OB Lookback",              minval = 3, maxval = 30, group = OB_GROUP)
ob_bull_col     = input.color(color.new(color.teal, 75), "Bullish OB Color", group = OB_GROUP)
ob_bear_col     = input.color(color.new(color.red,  75), "Bearish OB Color", group = OB_GROUP)
show_fvg        = input.bool(true,  "Show Fair Value Gaps",     group = FVG_GROUP)
fvg_bull_col    = input.color(color.new(color.lime,   85), "Bullish FVG Color", group = FVG_GROUP)
fvg_bear_col    = input.color(color.new(color.orange, 85), "Bearish FVG Color", group = FVG_GROUP)
show_signals    = input.bool(true,  "Show Buy/Sell Signals",    group = SIG_GROUP)
atr_mult_sl     = input.float(1.5, "ATR Multiplier (SL)",  minval=0.5, maxval=5.0,  step=0.1, group = RISK_GROUP)
atr_mult_tp1    = input.float(2.0, "ATR Multiplier (TP1)", minval=0.5, maxval=10.0, step=0.1, group = RISK_GROUP)
atr_mult_tp2    = input.float(3.5, "ATR Multiplier (TP2)", minval=1.0, maxval=15.0, step=0.1, group = RISK_GROUP)
risk_reward_min = input.float(1.5, "Min Risk:Reward Ratio",minval=1.0, maxval=5.0,  step=0.1, group = RISK_GROUP)
show_dash       = input.bool(true, "Show Dashboard", group = DASH_GROUP)
dash_pos        = input.string("Top Right", "Dashboard Position", options=["Top Right","Bottom Right","Top Left","Bottom Left"], group = DASH_GROUP)
ema9   = ta.ema(close, 9)
ema21  = ta.ema(close, 21)
sma50  = ta.sma(close, 50)
sma100 = ta.sma(close, 100)
sma200 = ta.sma(close, 200)
atr14  = ta.atr(14)
plot(show_ma_lines and show_ema9   ? ema9   : na, color=color.new(color.aqua,   30), linewidth=1, title="EMA 9")
plot(show_ma_lines and show_ema21  ? ema21  : na, color=color.new(color.yellow, 30), linewidth=1, title="EMA 21")
plot(show_ma_lines and show_sma50  ? sma50  : na, color=color.new(color.orange, 20), linewidth=2, title="SMA 50")
plot(show_ma_lines and show_sma100 ? sma100 : na, color=color.new(color.white,  10), linewidth=2, title="SMA 100")
plot(show_ma_lines and show_sma200 ? sma200 : na, color=color.new(color.red,    10), linewidth=3, title="SMA 200")
p_ema9  = plot(show_ma_lines and show_ema9  ? ema9  : na, display=display.none, title="EMA9 fill")
p_ema21 = plot(show_ma_lines and show_ema21 ? ema21 : na, display=display.none, title="EMA21 fill")
fill(p_ema9, p_ema21, color = ema9 > ema21 ? color.new(color.teal, 88) : color.new(color.red, 88), title = "MA Ribbon")
rsi14 = ta.rsi(close, 14)
[macd_line, signal_line, hist_line] = ta.macd(close, 12, 26, 9)
k_val = ta.stoch(close, high, low, 14)
d_val = ta.sma(k_val, 3)
hi_p = ta.pivothigh(swing_len, swing_len)
lo_p = ta.pivotlow(swing_len, swing_len)
var float last_hi = na
var float last_lo = na
if not na(hi_p)
    is_hh   = hi_p > last_hi or na(last_hi)
    lbl_txt = is_hh ? "HH" : "LH"
    lbl_col = is_hh ? color.new(color.red, 0) : color.new(color.orange, 0)
    if show_swings
        label.new(bar_index[swing_len], hi_p, lbl_txt, color = color.new(lbl_col, 80), textcolor = lbl_col, style = label.style_label_down, size = size.small)
    last_hi := hi_p
if not na(lo_p)
    is_ll   = lo_p < last_lo or na(last_lo)
    lbl_txt = is_ll ? "LL" : "HL"
    lbl_col = is_ll ? color.new(color.lime, 0) : color.new(color.teal, 0)
    if show_swings
        label.new(bar_index[swing_len], lo_p, lbl_txt, color = color.new(lbl_col, 80), textcolor = lbl_col, style = label.style_label_up, size = size.small)
    last_lo := lo_p
var float int_hi    = na
var float int_lo    = na
var int   trend_dir = 0
var int   bos_count = 0
hi10 = ta.highest(high, 10)
lo10 = ta.lowest(low,  10)
if high[5] > hi10[6]
    int_hi := high[5]
if low[5] < lo10[6]
    int_lo := low[5]
bos_bull = ta.crossover(close,  int_hi)
bos_bear = ta.crossunder(close, int_lo)
if show_bos
    if bos_bull
        line.new(bar_index[5], int_hi, bar_index, int_hi, color=color.new(color.lime, 30), width=2, style=line.style_dashed)
        label.new(bar_index, high, trend_dir == -1 ? "CHoCH" : "BOS", color=color.new(color.lime, 70), textcolor=color.lime, style=label.style_label_down, size=size.small)
        bos_count += 1
        trend_dir  := 1
    if bos_bear
        line.new(bar_index[5], int_lo, bar_index, int_lo, color=color.new(color.red, 30), width=2, style=line.style_dashed)
        label.new(bar_index, low, trend_dir == 1 ? "CHoCH" : "BOS", color=color.new(color.red, 70), textcolor=color.red, style=label.style_label_up, size=size.small)
        bos_count += 1
        trend_dir  := -1
ob_highest = ta.highest(high, ob_lookback)
ob_lowest  = ta.lowest(low,  ob_lookback)
bull_ob_cond = close[ob_lookback] < open[ob_lookback] and close > ob_highest[1]
bear_ob_cond = close[ob_lookback] > open[ob_lookback] and close < ob_lowest[1]
if show_ob and bull_ob_cond
    box.new(bar_index[ob_lookback], math.max(open[ob_lookback], close[ob_lookback]), bar_index, math.min(open[ob_lookback], close[ob_lookback]), border_color=color.new(color.teal, 20), bgcolor=ob_bull_col, text=" Bull OB", text_color=color.teal, text_size=size.tiny)
if show_ob and bear_ob_cond
    box.new(bar_index[ob_lookback], math.max(open[ob_lookback], close[ob_lookback]), bar_index, math.min(open[ob_lookback], close[ob_lookback]), border_color=color.new(color.red, 20), bgcolor=ob_bear_col, text=" Bear OB", text_color=color.red, text_size=size.tiny)
fvg_bull = low > high[2]
fvg_bear = high < low[2]
if show_fvg and fvg_bull
    box.new(bar_index[1], low, bar_index[1] + 20, high[2], border_color=color.new(color.lime, 50), bgcolor=fvg_bull_col, text=" FVG+", text_color=color.lime, text_size=size.tiny)
if show_fvg and fvg_bear
    box.new(bar_index[1], low[2], bar_index[1] + 20, high, border_color=color.new(color.orange, 50), bgcolor=fvg_bear_col, text=" FVG-", text_color=color.orange, text_size=size.tiny)
vol_avg   = ta.sma(volume, 20)
vol_surge = volume > vol_avg * 1.5
buy_score = 0
buy_score += close > ema9                    ? 1 : 0
buy_score += ema9  > ema21                   ? 1 : 0
buy_score += close > sma50                   ? 1 : 0
buy_score += rsi14 > 50 and rsi14 < 70       ? 1 : 0
buy_score += macd_line > signal_line         ? 1 : 0
buy_score += k_val > d_val and k_val < 80    ? 1 : 0
buy_score += vol_surge                       ? 1 : 0
buy_score += trend_dir == 1                  ? 1 : 0
sell_score = 0
sell_score += close < ema9                   ? 1 : 0
sell_score += ema9  < ema21                  ? 1 : 0
sell_score += close < sma50                  ? 1 : 0
sell_score += rsi14 < 50 and rsi14 > 30      ? 1 : 0
sell_score += macd_line < signal_line        ? 1 : 0
sell_score += k_val < d_val and k_val > 20   ? 1 : 0
sell_score += vol_surge                      ? 1 : 0
sell_score += trend_dir == -1                ? 1 : 0
raw_strong_buy  = buy_score  >= 6
raw_strong_sell = sell_score >= 6
raw_weak_buy    = buy_score  >= 4 and buy_score  < 6
raw_weak_sell   = sell_score >= 4 and sell_score < 6
confirmed_strong_buy  = raw_strong_buy  and raw_strong_buy[1]
confirmed_strong_sell = raw_strong_sell and raw_strong_sell[1]
confirmed_weak_buy    = raw_weak_buy    and raw_weak_buy[1]
confirmed_weak_sell   = raw_weak_sell   and raw_weak_sell[1]
var int last_signal_bar = -100
var int signal_state = 0 // 2: Strong Buy, 1: Weak Buy, -2: Strong Sell, -1: Weak Sell
cooldown_bars = 5 // Minimum bars before a new signal in same direction
is_cooldown_over = (bar_index - last_signal_bar) >= cooldown_bars
strong_buy  = confirmed_strong_buy  and (signal_state != 2  or is_cooldown_over)
strong_sell = confirmed_strong_sell and (signal_state != -2 or is_cooldown_over)
weak_buy    = confirmed_weak_buy    and signal_state <= 0
weak_sell   = confirmed_weak_sell   and signal_state >= 0
if strong_buy
    signal_state := 2
    last_signal_bar := bar_index
else if strong_sell
    signal_state := -2
    last_signal_bar := bar_index
else if weak_buy
    signal_state := 1
    last_signal_bar := bar_index
else if weak_sell
    signal_state := -1
    last_signal_bar := bar_index
plotshape(show_signals and strong_buy,  "Strong BUY",  shape.triangleup,   location.belowbar, color.new(color.lime,   0), size=size.normal, text="BUY",  textcolor=color.new(color.lime, 0))
plotshape(show_signals and strong_sell, "Strong SELL", shape.triangledown, location.abovebar, color.new(color.red,    0), size=size.normal, text="SELL", textcolor=color.new(color.red, 0))
plotshape(show_signals and weak_buy,    "Weak BUY",    shape.triangleup,   location.belowbar, color.new(color.teal,  40), size=size.small,  text="buy",  textcolor=color.new(color.teal, 0))
plotshape(show_signals and weak_sell,   "Weak SELL",   shape.triangledown, location.abovebar, color.new(color.orange,40), size=size.small,  text="sell", textcolor=color.new(color.orange, 0))
if show_signals and strong_buy
    sl_buy  = low   - atr14 * atr_mult_sl
    tp1_buy = close + atr14 * atr_mult_tp1
    tp2_buy = close + atr14 * atr_mult_tp2
    rr_buy  = (tp1_buy - close) / math.max(close - sl_buy, 0.0001)
    if rr_buy >= risk_reward_min
        line.new(bar_index, sl_buy,  bar_index + 8, sl_buy,  color=color.new(color.red,   20), width=2)
        line.new(bar_index, tp1_buy, bar_index + 8, tp1_buy, color=color.new(color.lime,  20), width=2)
        line.new(bar_index, tp2_buy, bar_index + 8, tp2_buy, color=color.new(color.green, 20), width=2)
        label.new(bar_index + 8, sl_buy,  "SL:"  + str.tostring(sl_buy,  "#.##"), color=color.new(color.red,   60), textcolor=color.red,   size=size.tiny, style=label.style_label_left)
        label.new(bar_index + 8, tp1_buy, "TP1:" + str.tostring(tp1_buy, "#.##"), color=color.new(color.lime,  60), textcolor=color.lime,  size=size.tiny, style=label.style_label_left)
        label.new(bar_index + 8, tp2_buy, "TP2:" + str.tostring(tp2_buy, "#.##"), color=color.new(color.green, 60), textcolor=color.green, size=size.tiny, style=label.style_label_left)
if show_signals and strong_sell
    sl_sell  = high  + atr14 * atr_mult_sl
    tp1_sell = close - atr14 * atr_mult_tp1
    tp2_sell = close - atr14 * atr_mult_tp2
    rr_sell  = (close - tp1_sell) / math.max(sl_sell - close, 0.0001)
    if rr_sell >= risk_reward_min
        line.new(bar_index, sl_sell,  bar_index + 8, sl_sell,  color=color.new(color.red,   20), width=2)
        line.new(bar_index, tp1_sell, bar_index + 8, tp1_sell, color=color.new(color.lime,  20), width=2)
        line.new(bar_index, tp2_sell, bar_index + 8, tp2_sell, color=color.new(color.green, 20), width=2)
        label.new(bar_index + 8, sl_sell,  "SL:"  + str.tostring(sl_sell,  "#.##"), color=color.new(color.red,   60), textcolor=color.red,   size=size.tiny, style=label.style_label_left)
        label.new(bar_index + 8, tp1_sell, "TP1:" + str.tostring(tp1_sell, "#.##"), color=color.new(color.lime,  60), textcolor=color.lime,  size=size.tiny, style=label.style_label_left)
        label.new(bar_index + 8, tp2_sell, "TP2:" + str.tostring(tp2_sell, "#.##"), color=color.new(color.green, 60), textcolor=color.green, size=size.tiny, style=label.style_label_left)
bgcolor(trend_dir == 1 ? color.new(color.teal, 97) : trend_dir == -1 ? color.new(color.red, 97) : na, title="Trend Background")
dash_position = dash_pos == "Top Right" ? position.top_right : dash_pos == "Bottom Right" ? position.bottom_right : dash_pos == "Top Left" ? position.top_left : position.bottom_left
var table dash = table.new(dash_position, 2, 14, bgcolor = color.new(#131722, 15), border_width = 1, border_color = color.new(#363a45, 10), frame_color = color.new(#363a45, 10), frame_width = 1)
if barstate.islast and show_dash
    table.cell(dash, 0, 0, "GM V1 Ultra", text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 20))
    table.cell(dash, 1, 0, "VALUE",         text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 20))
    table.cell(dash, 0, 1, "TREND",         text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, trend_dir == 1 ? "BULLISH" : trend_dir == -1 ? "BEARISH" : "NEUTRAL", bgcolor = trend_dir == 1 ? color.new(color.green, 60) : trend_dir == -1 ? color.new(color.red, 60) : color.new(color.gray, 60), text_color = color.white, text_size=size.small)
    table.cell(dash, 0, 2, "EMA 9",         text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, close > ema9 ? "Above" : "Below", bgcolor = close > ema9 ? color.new(color.green, 70) : color.new(color.red, 70), text_color = color.white, text_size=size.small)
    rsi_lbl = rsi14 > 70 ? "Overbought" : rsi14 < 30 ? "Oversold" : rsi14 > 50 ? "Bullish" : "Bearish"
    rsi_bg  = rsi14 > 70 ? color.new(color.orange, 60) : rsi14 < 30 ? color.new(color.purple, 60) : rsi14 > 50 ? color.new(color.green, 70) : color.new(color.red, 70)
    table.cell(dash, 0, 3, "RSI 14",        text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(math.round(rsi14, 1)) + " " + rsi_lbl, bgcolor=rsi_bg, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 4, "MACD",          text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, macd_line > signal_line ? "Bullish" : "Bearish", bgcolor = macd_line > signal_line ? color.new(color.green, 70) : color.new(color.red, 70), text_color = color.white, text_size=size.small)
    table.cell(dash, 0, 5, "VOLUME",        text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, vol_surge ? "SURGE" : "Normal", bgcolor = vol_surge ? color.new(color.blue, 60) : color.new(color.gray, 70), text_color = color.white, text_size=size.small)
    score_val   = trend_dir == 1 ? buy_score : sell_score
    score_color = score_val >= 6 ? color.new(color.green, 50) : score_val >= 4 ? color.new(color.orange, 50) : color.new(color.red, 60)
    table.cell(dash, 0, 6, "SIGNAL",        text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, (score_val >= 6 ? "STRONG " : score_val >= 4 ? "WEAK " : "NONE ") + str.tostring(score_val) + "/8", bgcolor=score_color, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 7, "ATR 14",        text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 7, str.tostring(atr14, "#.##"), text_color=color.yellow, text_size=size.small)
    tp1_d = trend_dir == 1 ? close + atr14 * atr_mult_tp1 : close - atr14 * atr_mult_tp1
    tp2_d = trend_dir == 1 ? close + atr14 * atr_mult_tp2 : close - atr14 * atr_mult_tp2
    sl_d  = trend_dir == 1 ? close - atr14 * atr_mult_sl  : close + atr14 * atr_mult_sl
    table.cell(dash, 0, 8, "TP1",           text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 8, str.tostring(tp1_d, "#.##"), text_color=color.lime, text_size=size.small)
    table.cell(dash, 0, 9, "TP2",           text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 9, str.tostring(tp2_d, "#.##"), text_color=color.green, text_size=size.small)
    table.cell(dash, 0, 10, "STOP LOSS",    text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 10, str.tostring(sl_d, "#.##"), text_color=color.red, text_size=size.small)
    rr_d = math.abs(tp1_d - close) / math.max(math.abs(sl_d - close), 0.0001)
    table.cell(dash, 0, 11, "R:R RATIO",    text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 11, "1:" + str.tostring(math.round(rr_d, 2)), bgcolor = rr_d >= risk_reward_min ? color.new(color.green, 60) : color.new(color.red, 60), text_color = color.white, text_size=size.small)
    table.cell(dash, 0, 12, "BOS Count",    text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 12, str.tostring(bos_count), text_color=color.aqua, text_size=size.small)
    in_london   = not na(time(timeframe.period, "0800-1700:23456"))
    in_newyork  = not na(time(timeframe.period, "1300-2200:23456"))
    in_asian    = not na(time(timeframe.period, "0000-0900:23456"))
    session_txt = in_london ? "London" : in_newyork ? "New York" : in_asian ? "Asian" : "Off Hours"
    table.cell(dash, 0, 13, "SESSION",      text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 13, session_txt,    text_color=color.yellow, text_size=size.small)
alertcondition(strong_buy,  "Strong BUY Signal",  "GM V1 Ultra: Strong BUY Signal!")
alertcondition(strong_sell, "Strong SELL Signal", "GM V1 Ultra: Strong SELL Signal!")
alertcondition(weak_buy,    "Weak BUY Signal",    "GM V1 Ultra: Weak BUY Signal!")
alertcondition(weak_sell,   "Weak SELL Signal",   "GM V1 Ultra: Weak SELL Signal!")
alertcondition(bos_bull,    "BOS UP",             "GM V1 Ultra: Bullish BOS!")
alertcondition(bos_bear,    "BOS DOWN",           "GM V1 Ultra: Bearish BOS!")
