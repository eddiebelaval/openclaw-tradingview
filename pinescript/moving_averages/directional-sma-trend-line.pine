//@version=6
indicator("Directional SMA Trend Line", overlay=true)

// Inputs
lenFast   = input.int(10, "Fast SMA Length", minval=1)
lenSlow   = input.int(20, "Slow SMA Length", minval=1)

bullColor = input.color(color.green, "Bullish Color (SMA10 > SMA20)")
bearColor = input.color(color.purple, "Bearish Color (SMA10 < SMA20)")

lineWidth = input.int(3, "Line Width", minval=1, maxval=10)

plotStyleInput = input.string("Line", "Plot Style",
     options = ["Line","Line Break","Circles","Cross"])

// Plot style mapping
plotStyle =
     plotStyleInput == "Line Break" ? plot.style_linebr :
     plotStyleInput == "Circles" ? plot.style_circles :
     plotStyleInput == "Cross" ? plot.style_cross :
     plot.style_line

// SMA berekening
smaFast = ta.sma(close, lenFast)
smaSlow = ta.sma(close, lenSlow)

// Trendlijn (SMA10 als basis)
trend = smaFast

// Kleur afhankelijk van regime
trendColor = smaFast > smaSlow ? bullColor : bearColor

// Plot
plot(trend, color = trendColor, linewidth = lineWidth, style = plotStyle)
