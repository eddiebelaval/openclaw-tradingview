//@version=6
indicator("Parabolic Ribbon [SS]", overlay = true, max_lines_count = 500, max_labels_count = 500)

//Groups 
g1 = "SMA Inputs" 
g2 = "Visual Preferences"
// User Inputs
lookback    = input.int(100, "Lookback Period", minval = 2, tooltip = "This is the SMA length", group = g1)
sd_1        = input.float(1.0, "Inner SD (Pink)", group = g1)
sd_2        = input.float(2.0, "Mid SD (Purple)", group = g1)
sd_3        = input.float(3.0, "Outer SD (Red)", group = g1)
offset      = input.int(500, "Projection Distance", group = g1)
showlbls = input.bool(true, "Show Trend Labels (Bubbles)", group = g2)
barcol = input.bool(true, "Change Candle Colour to match Assessment", group = g2)

// Colours 
col_neon_pink   = #ff80bf
col_neon_purple = #9d4edd
col_neon_red    = #ff5252
col_cyan        = #03dac6
col_table_bg    = #121212

// Variable definitions and calcs 
float price_basis    = ta.sma(close, lookback)
float rolling_stdev  = ta.stdev(close, lookback)

// volatility 
float band_width     = (price_basis + (rolling_stdev * sd_3)) - (price_basis - (rolling_stdev * sd_3))
float avg_band_width = ta.sma(band_width, 100)
float vola_score     = (band_width / avg_band_width) * 100

// states
string market_state = band_width < avg_band_width ? "CONTRACTION" : "EXPANSION"
color state_color   = band_width < avg_band_width ? #bb86fc : col_cyan

plot(price_basis, "SMA", color = color.new(#ec006e, 0))
plot(price_basis, "SMA", color = color.new(#ec006e, 70), linewidth = 3)
plot(price_basis, "SMA", color = color.new(#ec006e, 80), linewidth = 6)
plot(price_basis, "SMA", color = color.new(#ec006e, 85), linewidth = 8)
plot(price_basis, "SMA", color = color.new(#ec006e, 90), linewidth = 10)
plot(price_basis, "SMA", color = color.new(#ec006e, 95), linewidth = 12)
float cor = ta.correlation(time, close, lookback) 
trend = cor >= 0.1 ? "Uptrend" : cor <= -0.1 ? "Downtrend" : "No Trend" 
var string last_signal = na 
if market_state[1] == "CONTRACTION" and market_state == "EXPANSION" and trend == "Uptrend" and showlbls
    label.new(bar_index, high, text = na, color = color.lime, style = label.style_circle, size = size.tiny)
    label.new(bar_index, high, text = na, color = color.new(color.lime, 70), style = label.style_circle, size = size.small)
    label.new(bar_index, high, text = na, color = color.new(color.lime, 80), style = label.style_circle, size = size.normal)
    label.new(bar_index, high, text = na, color = color.new(color.lime, 95), style = label.style_circle, size = size.large, tooltip = "Bullish Expansion Detected \n Current Trend: " + str.tostring(trend) + "\n Current Trend Correlation: " + str.tostring(math.round(cor, 2)))
    last_signal := "Long"
if market_state[1] == "CONTRACTION" and market_state == "EXPANSION" and trend == "Downtrend" and showlbls
    label.new(bar_index, high, text = na, color = color.red, style = label.style_circle, size = size.tiny)
    label.new(bar_index, high, text = na, color = color.new(color.red, 70), style = label.style_circle, size = size.small)
    label.new(bar_index, high, text = na, color = color.new(color.red, 80), style = label.style_circle, size = size.normal)
    label.new(bar_index, high, text = na, color = color.new(color.red, 95), style = label.style_circle, size = size.large, tooltip = "Bearish Expansion Detected \n Current Trend: " + str.tostring(trend) + "\n Current Trend Correlation: " + str.tostring(math.round(cor, 2)))
    last_signal := "Short"
if market_state[1] == "EXPANSION" and market_state == "CONTRACTION" and showlbls
    label.new(bar_index, high, text = na, color = color.gray, style = label.style_circle, size = size.tiny)
    label.new(bar_index, high, text = na, color = color.new(color.gray, 70), style = label.style_circle, size = size.small)
    label.new(bar_index, high, text = na, color = color.new(color.gray, 80), style = label.style_circle, size = size.normal)
    label.new(bar_index, high, text = na, color = color.new(color.gray, 95), style = label.style_circle, size = size.large, tooltip = "Consolidation Detected \n Current Trend: " + str.tostring(trend) + "\n Current Trend Correlation: " + str.tostring(math.round(cor, 2)))
    last_signal := "Consolidation" 
// Definitions and arras 
var line[] ribbon_lines = array.new_line()
var linefill[] ribbon_fills = array.new_linefill()


method f_draw_glow(line[] arr, int _t1, int _t2, float _price, color _color) =>
    arr.push(line.new(_t1, _price, _t2, _price, xloc=xloc.bar_time, color=color.new(_color, 65), width=2))
    arr.push(line.new(_t1, _price, _t2, _price, xloc=xloc.bar_time, color=color.new(_color, 85), width=6))
    arr.push(line.new(_t1, _price, _t2, _price, xloc=xloc.bar_time, color=color.new(_color, 95), width=12))

if barstate.islast

    if array.size(ribbon_lines) > 0
        for i = 0 to array.size(ribbon_lines) - 1
            line.delete(array.get(ribbon_lines, i))
        array.clear(ribbon_lines)
    
    if array.size(ribbon_fills) > 0
        for i = 0 to array.size(ribbon_fills) - 1
            linefill.delete(array.get(ribbon_fills, i))
        array.clear(ribbon_fills)


    int start_t = time - (offset * (time - time[1]))
    int end_t   = time + (offset * (time - time[1]))

    float h3 = price_basis + (rolling_stdev * sd_3)
    float h2 = price_basis + (rolling_stdev * sd_2)
    float h1 = price_basis + (rolling_stdev * sd_1)
    float l1 = price_basis - (rolling_stdev * sd_1)
    float l2 = price_basis - (rolling_stdev * sd_2)
    float l3 = price_basis - (rolling_stdev * sd_3)

    // 3. Create Boundary Lines
    line ln_h3 = line.new(start_t, h3, end_t, h3, xloc=xloc.bar_time, color=color.new(col_neon_red, 80))
    line ln_h2 = line.new(start_t, h2, end_t, h2, xloc=xloc.bar_time, color=color.new(col_neon_purple, 80))
    line ln_h1 = line.new(start_t, h1, end_t, h1, xloc=xloc.bar_time, color=color.new(col_neon_pink, 80))
    line ln_l1 = line.new(start_t, l1, end_t, l1, xloc=xloc.bar_time, color=color.new(col_neon_pink, 80))
    line ln_l2 = line.new(start_t, l2, end_t, l2, xloc=xloc.bar_time, color=color.new(col_neon_purple, 80))
    line ln_l3 = line.new(start_t, l3, end_t, l3, xloc=xloc.bar_time, color=color.new(col_neon_red, 80))
    
    // Track boundaries
    ribbon_lines.push(ln_h3), ribbon_lines.push(ln_h2), ribbon_lines.push(ln_h1)
    ribbon_lines.push(ln_l1), ribbon_lines.push(ln_l2), ribbon_lines.push(ln_l3)

    // Ribbon fills 
    ribbon_fills.push(linefill.new(ln_h3, ln_h2, color.new(col_neon_red, 82)))
    ribbon_fills.push(linefill.new(ln_h2, ln_h1, color.new(col_neon_purple, 85)))
    ribbon_fills.push(linefill.new(ln_h1, ln_l1, color.new(col_neon_pink, 88)))
    ribbon_fills.push(linefill.new(ln_l1, ln_l2, color.new(col_neon_purple, 85)))
    ribbon_fills.push(linefill.new(ln_l2, ln_l3, color.new(col_neon_red, 82)))


    ribbon_lines.f_draw_glow(start_t, end_t, h3, col_neon_red)
    ribbon_lines.f_draw_glow(start_t, end_t, h2, col_neon_purple)
    ribbon_lines.f_draw_glow(start_t, end_t, h1, col_neon_pink)
    ribbon_lines.f_draw_glow(start_t, end_t, l1, col_neon_pink)
    ribbon_lines.f_draw_glow(start_t, end_t, l2, col_neon_purple)
    ribbon_lines.f_draw_glow(start_t, end_t, l3, col_neon_red)

// Table
var table ai_table = table.new(position.top_right, 2, 4, bgcolor = color.new(col_table_bg, 15), border_color = col_neon_purple, border_width = 1)

if barstate.islast
    // plotting table 
    table.cell(ai_table, 0, 0, "SYSTEM STATUS", text_color = color.white, text_size = size.small, bgcolor = color.new(col_neon_purple, 50))
    table.cell(ai_table, 1, 0, "ACTIVE", text_color = col_cyan, text_size = size.small, bgcolor = color.new(col_neon_purple, 50))
    

    table.cell(ai_table, 0, 1, "PHASE", text_color = color.gray, text_size = size.small)
    table.cell(ai_table, 1, 1, market_state, text_color = state_color, text_size = size.small)
    

    table.cell(ai_table, 0, 2, "VOLA SCORE", text_color = color.gray, text_size = size.small)
    table.cell(ai_table, 1, 2, str.tostring(vola_score, "#.##"), text_color = color.white, text_size = size.small)


    string insight = band_width < avg_band_width ? "Price contraction, likely consolidation" : "Expansion detected, watch for trend"
    table.cell(ai_table, 0, 3, "INSIGHT", text_color = color.gray, text_size = size.small)
    table.cell(ai_table, 1, 3, insight, text_color = color.white, text_size = size.small)

barcolor(trend == "Downtrend" and last_signal == "Short" and close < price_basis and barcol ? color.red : trend == "Uptrend" and last_signal == "Long" and close > price_basis and barcol ? color.lime : last_signal == "Consolidation" and barcol ? color.gray : na)
