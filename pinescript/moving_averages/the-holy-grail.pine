//@version=5
indicator("Holy Grail", overlay=true, precision=6)

// ─── Inputs (logic only) ─────────────────────────────────────────
useAdx       = input.bool(true,  title="With ADX (uncheck = without ADX)")
adxSmoothing = input.int(14,     title="ADX Smoothing", minval=1)
diLength     = input.int(14,     title="DI Length", minval=1)
adxThreshold = input.float(30.0, title="ADX Threshold", minval=0)

emaFastLen   = input.int(20, title="EMA Fast (Pullback)", minval=1)
emaSlowLen   = input.int(50, title="EMA Slow (Trend)", minval=1)

// ─── Williams Fractals (strategy highs / lows) ───────────────────
showFractals = input.bool(true, title="Show Williams Fractals", group="Williams Fractals")
fractalN     = input.int(6, title="Fractal Periods", minval=2, group="Williams Fractals")

// ─── Custom ADX (méthode Wilder) ─────────────────────────────────────────
dirmov(len) =>
    up = ta.change(high)
    down = -ta.change(low)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    truerange = ta.rma(ta.tr, len)
    plus = fixnan(100 * ta.rma(plusDM, len) / truerange)
    minus = fixnan(100 * ta.rma(minusDM, len) / truerange)
    [plus, minus]

adx(dilen, adxlen) =>
    [plus, minus] = dirmov(dilen)
    sum = plus + minus
    100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), adxlen)

// ─── Values ─────────────────────────────────────────────────────────────
adxValue = adx(diLength, adxSmoothing)

emaFast = ta.ema(close, emaFastLen)   // EMA 20
emaSlow = ta.ema(close, emaSlowLen)   // EMA 50

// ─── Fractales de Williams (plus hauts / plus bas systématiques) ───────
n = fractalN
// UpFractal (plus haut de swing = objectifs / entrée au-dessus du plus haut)
bool upflagDownFrontier = true
bool upflagUpFrontier0 = true
bool upflagUpFrontier1 = true
bool upflagUpFrontier2 = true
bool upflagUpFrontier3 = true
bool upflagUpFrontier4 = true
for i = 1 to n
    upflagDownFrontier := upflagDownFrontier and (high[n-i] < high[n])
    upflagUpFrontier0 := upflagUpFrontier0 and (high[n+i] < high[n])
    upflagUpFrontier1 := upflagUpFrontier1 and (high[n+1] <= high[n] and high[n+i + 1] < high[n])
    upflagUpFrontier2 := upflagUpFrontier2 and (high[n+1] <= high[n] and high[n+2] <= high[n] and high[n+i + 2] < high[n])
    upflagUpFrontier3 := upflagUpFrontier3 and (high[n+1] <= high[n] and high[n+2] <= high[n] and high[n+3] <= high[n] and high[n+i + 3] < high[n])
    upflagUpFrontier4 := upflagUpFrontier4 and (high[n+1] <= high[n] and high[n+2] <= high[n] and high[n+3] <= high[n] and high[n+4] <= high[n] and high[n+i + 4] < high[n])
flagUpFrontier = upflagUpFrontier0 or upflagUpFrontier1 or upflagUpFrontier2 or upflagUpFrontier3 or upflagUpFrontier4
upFractal = (upflagDownFrontier and flagUpFrontier)

// DownFractal (plus bas de swing = stops / retracement low)
bool downflagDownFrontier = true
bool downflagUpFrontier0 = true
bool downflagUpFrontier1 = true
bool downflagUpFrontier2 = true
bool downflagUpFrontier3 = true
bool downflagUpFrontier4 = true
for i = 1 to n
    downflagDownFrontier := downflagDownFrontier and (low[n-i] > low[n])
    downflagUpFrontier0 := downflagUpFrontier0 and (low[n+i] > low[n])
    downflagUpFrontier1 := downflagUpFrontier1 and (low[n+1] >= low[n] and low[n+i + 1] > low[n])
    downflagUpFrontier2 := downflagUpFrontier2 and (low[n+1] >= low[n] and low[n+2] >= low[n] and low[n+i + 2] > low[n])
    downflagUpFrontier3 := downflagUpFrontier3 and (low[n+1] >= low[n] and low[n+2] >= low[n] and low[n+3] >= low[n] and low[n+i + 3] > low[n])
    downflagUpFrontier4 := downflagUpFrontier4 and (low[n+1] >= low[n] and low[n+2] >= low[n] and low[n+3] >= low[n] and low[n+4] >= low[n] and low[n+i + 4] > low[n])
flagDownFrontier = downflagUpFrontier0 or downflagUpFrontier1 or downflagUpFrontier2 or downflagUpFrontier3 or downflagUpFrontier4
downFractal = (downflagDownFrontier and flagDownFrontier)

// ─── Conditions ─────────────────────────────────────────────────────────
adxOk   = adxValue > adxThreshold
adxCond = useAdx ? adxOk : true

trendBull = emaFast > emaSlow
trendBear = emaFast < emaSlow

// ─── Pullback “propre” (PDF) ────────────────────────────────────────────
pullbackBull = (low <= emaFast) and (close >= emaFast) and (low > emaSlow)
pullbackBear = (high >= emaFast) and (close <= emaFast) and (high < emaSlow)

// Setup (bougie A)
setupBull = adxCond and trendBull and pullbackBull
setupBear = adxCond and trendBear and pullbackBear

// Trigger PDF (bougie B) via High / Low
buyEntry  = setupBull[1] and high > high[1]
sellEntry = setupBear[1] and low  < low[1]

// Anti-superposition visuelle
showSetupBull = setupBull and not buyEntry and not sellEntry
showSetupBear = setupBear and not buyEntry and not sellEntry

// ─── EMA plots (couleurs par défaut, éditables) ─────────────────────────
pEmaFast = plot(emaFast, title="EMA 20", color=color.yellow, linewidth=1)
pEmaSlow = plot(emaSlow, title="EMA 50", color=color.orange, linewidth=1)

// ─── EMA Cloud type Ichimoku (stylable dans Style) ───────────────────────
pBullTop = plot(trendBull ? emaFast : na, title="Cloud Bull Top", display=display.none)
pBullBot = plot(trendBull ? emaSlow : na, title="Cloud Bull Bottom", display=display.none)
pBearTop = plot(trendBear ? emaFast : na, title="Cloud Bear Top", display=display.none)
pBearBot = plot(trendBear ? emaSlow : na, title="Cloud Bear Bottom", display=display.none)

// Couleurs par défaut (modifiables dans Style)
fill(pBullTop, pBullBot, color=color.new(color.green, 85), title="EMA Cloud Bull")
fill(pBearTop, pBearBot, color=color.new(color.red,   85), title="EMA Cloud Bear")

// ─── Fractales de Williams (plus hauts / plus bas de la stratégie) ──────
plotshape(showFractals and downFractal, style=shape.cross, location=location.belowbar,
     offset=-n, color=color.gray, size=size.tiny, title="Fractale bas (stop / retracement low)")
plotshape(showFractals and upFractal, style=shape.cross, location=location.abovebar,
     offset=-n, color=color.gray, size=size.tiny, title="Fractale haut (objectif / swing high)")

// ─── Signaux (couleurs par défaut, éditables) ───────────────────────────
plotshape(showSetupBull, style=shape.circle, location=location.belowbar,
     color=color.green, size=size.tiny, title="Setup Bull", editable=true)

plotshape(showSetupBear, style=shape.circle, location=location.abovebar,
     color=color.red, size=size.tiny, title="Setup Bear", editable=true)

plotshape(buyEntry, style=shape.triangleup, location=location.belowbar,
     color=color.green, size=size.small, title="BUY Entry", editable=true)

plotshape(sellEntry, style=shape.triangledown, location=location.abovebar,
     color=color.red, size=size.small, title="SELL Entry", editable=true)



// ─── Background ADX (violet par défaut – limite TradingView) ─────────────
bgcolor(useAdx and adxOk ? color.new(color.purple, 85) : na, title="ADX Regime")
// open
