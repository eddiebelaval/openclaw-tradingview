//@version=5
indicator("YieldingFLow Trade Checklist - Dark Mode + Light Toggle", overlay = true, max_labels_count = 500)

// ───── TABLE POSITION & THEME ─────
group_settings = "Table Settings"
table_pos = input.string("top_right", "Table Position", 
     options = ["top_left", "top_right", "bottom_left", "bottom_right", "middle_right"], group = group_settings)

theme = input.string("Dark", "Color Theme", 
     options = ["Light", "Dark"], group = group_settings)

// Position logic
pos = table_pos == "top_left" ? position.top_left :
      table_pos == "top_right" ? position.top_right :
      table_pos == "bottom_left" ? position.bottom_left :
      table_pos == "bottom_right" ? position.bottom_right : position.middle_right

// ───── COLOR PALETTE (conditional Dark/Light) ─────
col_header = theme == "Light" ? color.new(#A5D6FF, 0) : color.new(#263A5E, 0)
col_bg     = theme == "Light" ? color.new(color.white, 0) : color.new(#1C2333, 0)
col_border = theme == "Light" ? color.new(#D1E0E8, 0) : color.new(#4A5F85, 0)
col_text   = theme == "Light" ? color.new(#1E3A5F, 0) : color.new(#E0EFFF, 0)

col_green  = theme == "Light" ? color.new(#4ECDC4, 0) : color.new(#00E5C0, 0)   // teal
col_red    = theme == "Light" ? color.new(#FF6B6B, 0) : color.new(#FF7A7A, 0)   // coral

verdict_ok_bg   = theme == "Light" ? color.new(#C5F0E8, 70) : color.new(#003D33, 70)
verdict_fail_bg = theme == "Light" ? color.new(#FFD6D6, 70) : color.new(#4D1F1F, 70)

// ───── INPUTS (your exact framework) ─────
group0 = "Phase 0: Risk"
risk_ok = input.bool(true,  "✅ 1-2% risk + Stop written BEFORE entry?", group = group0)
rr_ok   = input.bool(true,  "✅ Reward:Risk ≥ 1:2 planned?", group = group0)

group1 = "Phase 1: Macro Liquidity"
liq_ok  = input.bool(true,  "✅ Global Liquidity expanding?", group = group1)
cb_ok   = input.bool(true,  "✅ Central banks supportive?", group = group1)
usd_ok  = input.bool(true,  "✅ USD weakening?", group = group1)
vix_ok  = input.bool(true,  "✅ VIX supportive?", group = group1)

group2 = "Phase 2: Wyckoff"
wyckoff_ok = input.bool(true,  "✅ Accumulation or early Markup?", group = group2)

group3 = "Phase 3: ICT Technical"
ob_fvg_ok    = input.bool(true,  "✅ At Bullish OB + FVG?", group = group3)
liq_grab_ok  = input.bool(true,  "✅ Liquidity grab confirmed?", group = group3)
structure_ok = input.bool(true,  "✅ Bullish structure (BOS)?", group = group3)

group4 = "Phase 4 & 5: Final"
asset_ok = input.bool(true,  "✅ Asset filter passed?", group = group4)
exit_ok  = input.bool(true,  "✅ Exit rules written?", group = group4)

// ───── AUTO TECHNICALS ─────
ma200    = ta.sma(close, 200)
ma50     = ta.sma(close, 50)
above200 = close > ma200
above50  = close > ma50
uptrend  = ma50 > ma200

// ───── SLEEK TABLE (now dark-mode ready) ─────
var table checklist = table.new(pos, columns = 3, rows = 18, 
     bgcolor = col_bg, border_width = 1, border_color = col_border)

if barstate.islast
    // Header
    table.cell(checklist, 0, 0, "CHECKLIST ITEM",  text_color = col_text, bgcolor = col_header, text_size = size.normal)
    table.cell(checklist, 1, 0, "STATUS",          text_color = col_text, bgcolor = col_header, text_size = size.normal)
    table.cell(checklist, 2, 0, "NOTES",           text_color = col_text, bgcolor = col_header, text_size = size.small)

    // Phase 0
    table.cell(checklist, 0, 1, "Phase 0: Risk size + Stop", text_color = col_text, bgcolor = col_bg)
    table.cell(checklist, 1, 1, risk_ok ? "✅ YES" : "❌ NO", text_color = risk_ok ? col_green : col_red)
    table.cell(checklist, 2, 1, "Mandatory", text_color = color.gray)

    table.cell(checklist, 0, 2, "Phase 0: RR ≥ 1:2", text_color = col_text, bgcolor = col_bg)
    table.cell(checklist, 1, 2, rr_ok ? "✅ YES" : "❌ NO", text_color = rr_ok ? col_green : col_red)

    // Phase 1
    table.cell(checklist, 0, 3, "Phase 1: Liquidity expanding", text_color = col_text, bgcolor = col_bg)
    table.cell(checklist, 1, 3, liq_ok ? "✅ YES" : "❌ NO", text_color = liq_ok ? col_green : col_red)

    table.cell(checklist, 0, 4, "Phase 1: Central banks supportive", text_color = col_text, bgcolor = col_bg)
    table.cell(checklist, 1, 4, cb_ok ? "✅ YES" : "❌ NO", text_color = cb_ok ? col_green : col_red)

    table.cell(checklist, 0, 5, "Phase 1: USD weakening", text_color = col_text, bgcolor = col_bg)
    table.cell(checklist, 1, 5, usd_ok ? "✅ YES" : "❌ NO", text_color = usd_ok ? col_green : col_red)

    table.cell(checklist, 0, 6, "Phase 1: VIX supportive", text_color = col_text, bgcolor = col_bg)
    table.cell(checklist, 1, 6, vix_ok ? "✅ YES" : "❌ NO", text_color = vix_ok ? col_green : col_red)

    // Phase 2
    table.cell(checklist, 0, 7, "Phase 2: Wyckoff phase", text_color = col_text, bgcolor = col_bg)
    table.cell(checklist, 1, 7, wyckoff_ok ? "✅ YES" : "❌ NO", text_color = wyckoff_ok ? col_green : col_red)

    // Phase 3
    table.cell(checklist, 0, 8, "Phase 3: OB + FVG", text_color = col_text, bgcolor = col_bg)
    table.cell(checklist, 1, 8, ob_fvg_ok ? "✅ YES" : "❌ NO", text_color = ob_fvg_ok ? col_green : col_red)

    table.cell(checklist, 0, 9, "Phase 3: Liquidity grab", text_color = col_text, bgcolor = col_bg)
    table.cell(checklist, 1, 9, liq_grab_ok ? "✅ YES" : "❌ NO", text_color = liq_grab_ok ? col_green : col_red)

    table.cell(checklist, 0, 10, "Phase 3: Bullish structure", text_color = col_text, bgcolor = col_bg)
    table.cell(checklist, 1, 10, structure_ok ? "✅ YES" : "❌ NO", text_color = structure_ok ? col_green : col_red)

    // Auto TA
    table.cell(checklist, 0, 11, "TA: Above 200 MA", text_color = col_text, bgcolor = col_bg)
    table.cell(checklist, 1, 11, above200 ? "✅ YES" : "❌ NO", text_color = above200 ? col_green : col_red)

    table.cell(checklist, 0, 12, "TA: Above 50 MA", text_color = col_text, bgcolor = col_bg)
    table.cell(checklist, 1, 12, above50 ? "✅ YES" : "❌ NO", text_color = above50 ? col_green : col_red)

    table.cell(checklist, 0, 13, "TA: 50 > 200 MA (trend)", text_color = col_text, bgcolor = col_bg)
    table.cell(checklist, 1, 13, uptrend ? "✅ YES" : "❌ NO", text_color = uptrend ? col_green : col_red)

    // Phase 4 & 5
    table.cell(checklist, 0, 14, "Phase 4: Asset filter", text_color = col_text, bgcolor = col_bg)
    table.cell(checklist, 1, 14, asset_ok ? "✅ YES" : "❌ NO", text_color = asset_ok ? col_green : col_red)

    table.cell(checklist, 0, 15, "Phase 5: Exit rules written", text_color = col_text, bgcolor = col_bg)
    table.cell(checklist, 1, 15, exit_ok ? "✅ YES" : "❌ NO", text_color = exit_ok ? col_green : col_red)

    // FINAL VERDICT
    overall_ok = risk_ok and rr_ok and liq_ok and cb_ok and usd_ok and vix_ok and wyckoff_ok and 
                 ob_fvg_ok and liq_grab_ok and structure_ok and above200 and above50 and uptrend and 
                 asset_ok and exit_ok

    table.cell(checklist, 0, 17, "FINAL VERDICT", text_color = col_text, bgcolor = col_header, text_size = size.large)
    table.cell(checklist, 1, 17, overall_ok ? "✅ READY TO TRADE" : "❌ FIX THE FAILS", 
               text_color = overall_ok ? col_green : col_red, 
               bgcolor = overall_ok ? verdict_ok_bg : verdict_fail_bg, 
               text_size = size.large)

// ───── MA PLOTS (visible on both themes) ─────
plot(ma200, "200 MA", color = color.new(color.orange, 0), linewidth = 2)
plot(ma50,  "50 MA",  color = color.new(color.blue, 0),   linewidth = 2)
