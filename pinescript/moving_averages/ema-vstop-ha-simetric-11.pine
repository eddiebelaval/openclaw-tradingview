//@version=6
indicator(title="EMA VStop HA Simétrico", shorttitle="Combo_Anclado", overlay=true)

// ==========================================
// 1. CONFIGURACIÓN EMA (Estructura Original)
// ==========================================
GRP_EMA = "Configuración EMA"
len = input.int(9, minval=1, title="EMA Length", group=GRP_EMA)
srcEMA = input.source(close, title="EMA Source", group=GRP_EMA)
outEMA = ta.ema(srcEMA, len)

// Ploteo EMA principal - Anclada al precio
plot(outEMA, title="EMA Blue", color=color.new(color.blue, 0), linewidth=2)

// --- Suavizado EMA ---
GRP_SM = "Suavizado EMA"
maTypeInput = input.string("None", "Tipo Suavizado", options = ["None", "SMA", "SMA + Bollinger Bands", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = GRP_SM)
maLengthInput = input.int(14, "Longitud Suavizado", group = GRP_SM)

ma(source, length, MAtype) =>
    switch MAtype
        "SMA"                   => ta.sma(source, length)
        "SMA + Bollinger Bands" => ta.sma(source, length)
        "EMA"                   => ta.ema(source, length)
        "SMMA (RMA)"            => ta.rma(source, length)
        "WMA"                   => ta.wma(source, length)
        "VWMA"                  => ta.vwma(source, length)
        => na

smoothingMA = maTypeInput != "None" ? ma(outEMA, maLengthInput, maTypeInput) : na
plot(smoothingMA, title="Smoothing Line", color=color.new(color.yellow, 0), display = maTypeInput != "None" ? display.all : display.none)

// ==========================================
// 2. CONFIGURACIÓN VSTOP (Estructura Original)
// ==========================================
GRP_VS = "Configuración VStop"
lengthVS = input.int(20, title="VStop ATR Length", minval = 2, group=GRP_VS)
srcVS = input.source(close, title="VStop Source", group=GRP_VS)
factorVS = input.float(2.0, title="VStop Multiplier", minval = 0.25, step = 0.25, group=GRP_VS)

volStop(src, atrlen, atrfactor) =>
    var float maxPrice  = src
    var float minPrice  = src
    var bool isUptrend  = true
    var float stopValue = na
    atr = ta.atr(atrlen) * atrfactor
    if isUptrend
        maxPrice := math.max(maxPrice, src)
        stopValue := maxPrice - atr
        if src < stopValue
            isUptrend := false
            minPrice := src
            stopValue := minPrice + atr
    else
        minPrice := math.min(minPrice, src)
        stopValue := minPrice + atr
        if src > stopValue
            isUptrend := true
            maxPrice := src
            stopValue := maxPrice - atr
    [stopValue, isUptrend]

[vStop, vTrend] = volStop(srcVS, lengthVS, factorVS)
plotColor = vTrend ? color.new(#009688, 0) : color.new(#F44336, 0)
plot(vStop, title="VStop Line", style=plot.style_linebr, color=plotColor, linewidth=3)

// ==========================================
// 3. LÓGICA DE SEÑALES (Anclaje al Movimiento)
// ==========================================
wick_threshold = input.float(60.0, "Mínimo % de Mechas (Vela 1)")

// Obtenemos los datos Heikin Ashi para sincronizar con el gráfico visual
ha_ticker = ticker.heikinashi(syminfo.tickerid)
[ha_o, ha_h, ha_l, ha_c] = request.security(ha_ticker, timeframe.period, [open, high, low, close])

// Lógica de Vela 1 (Vela previa [1])
v1_range = ha_h[1] - ha_l[1]
v1_body  = math.abs(ha_c[1] - ha_o[1])
v1_wick_pct = v1_range > 0 ? ((v1_range - v1_body) / v1_range) * 100 : 0

// Contacto de Vela 1 con la EMA Blue (outEMA)
v1_contact = ha_l[1] <= outEMA[1] and ha_h[1] >= outEMA[1]
v1_is_wicky = v1_wick_pct >= wick_threshold

// Lógica de Vela 2 (Vela Actual)
is_bullish_v2 = ha_c > ha_o
is_bearish_v2 = ha_c < ha_o
v2_no_wick = is_bullish_v2 ? (ha_o == ha_l) : (ha_o == ha_h)

// Ruptura de EMA Blue apoyando la dirección de Vela 1
v2_breaks_bull = ha_c[1] > ha_o[1] and ha_o <= outEMA and ha_c > outEMA
v2_breaks_bear = ha_c[1] < ha_o[1] and ha_o >= outEMA and ha_c < outEMA

// Confirmación final
pattern_bull = v1_contact and v1_is_wicky and is_bullish_v2 and v2_no_wick and v2_breaks_bull
pattern_bear = v1_contact and v1_is_wicky and is_bearish_v2 and v2_no_wick and v2_breaks_bear

// ==========================================
// 4. PLOTEO DE SEÑALES ANCLADAS
// ==========================================
// Se usa location.absolute o location.above/below para que sigan el movimiento del eje Y
plotshape(pattern_bull, "Compra", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(pattern_bear, "Venta", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small)

// Alertas
alertcondition(pattern_bull, "Compra HA", "Señal Alcista Simétrica")
alertcondition(pattern_bear, "Venta HA", "Señal Bajista Simétrica")
