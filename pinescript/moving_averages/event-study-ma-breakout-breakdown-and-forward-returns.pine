//@version=5
indicator("Event Study – MA Breakout / Breakdown [Advanced]", overlay=false)

// ═══════════════════════════════════════
// USER INPUTS
// ═══════════════════════════════════════

triggerSymbol = input.symbol("SPY",        "Trigger instrument")
targetSymbol  = input.symbol("GLD",        "Target instrument (measured)")
maLength      = input.int(200,             "Moving average length", minval=10, step=10)
eventType     = input.string("Breakdown",  "Event type", options=["Breakdown", "Breakout"])
lookbackYears = input.int(0,               "Lookback (years, 0 = all history)", minval=0, maxval=50)
cooldownBars  = input.int(21,              "Min bars between events (cooldown)", minval=1, maxval=252)
maxEpisodes   = input.int(20,              "Max episodes shown in table", minval=5, maxval=51)

// ═══════════════════════════════════════
// DATA
// ═══════════════════════════════════════

triggerClose = request.security(triggerSymbol, timeframe.period, close)
targetClose  = request.security(targetSymbol,  timeframe.period, close)

// ═══════════════════════════════════════
// MOVING AVERAGE
// ═══════════════════════════════════════

ma = ta.sma(triggerClose, maLength)

// ═══════════════════════════════════════
// EVENT DETECTION
// ═══════════════════════════════════════

breakdown = ta.crossunder(triggerClose, ma)
breakout  = ta.crossover(triggerClose, ma)
rawEvent  = eventType == "Breakdown" ? breakdown : breakout

m1 = 21
m3 = 63
m6 = 126
y1 = 252

// ═══════════════════════════════════════
// LOOKBACK FILTER
// ═══════════════════════════════════════

msPerYear  = 365.25 * 24 * 60 * 60 * 1000
cutoffTime = lookbackYears == 0 ? int(na) : timenow - int(lookbackYears * msPerYear)
inLookback = lookbackYears == 0 or time >= cutoffTime

// ═══════════════════════════════════════
// COOLDOWN FILTER
// ═══════════════════════════════════════

var int lastEventBar = -9999
cooldownOk = (bar_index - lastEventBar) >= cooldownBars
event      = rawEvent and cooldownOk and inLookback

if event
    lastEventBar := bar_index

// ═══════════════════════════════════════
// FORWARD RETURN VALIDITY CHECK
// ═══════════════════════════════════════

hasFuture1M = (bar_index + m1) <= last_bar_index
hasFuture3M = (bar_index + m3) <= last_bar_index
hasFuture6M = (bar_index + m6) <= last_bar_index
hasFuture1Y = (bar_index + y1) <= last_bar_index

// ═══════════════════════════════════════
// ARRAYS
// ═══════════════════════════════════════

var float[] ret1M    = array.new_float()
var float[] ret3M    = array.new_float()
var float[] ret6M    = array.new_float()
var float[] ret1Y    = array.new_float()
var float[] mdd1Y    = array.new_float()
var int[]   evtBars  = array.new_int()
var int[]   evtTimes = array.new_int()

// ═══════════════════════════════════════
// STORE EVENTS
// ═══════════════════════════════════════

if event and bar_index > y1
    r1 = hasFuture1M ? (targetClose[m1] / targetClose - 1) * 100 : float(na)
    r3 = hasFuture3M ? (targetClose[m3] / targetClose - 1) * 100 : float(na)
    r6 = hasFuture6M ? (targetClose[m6] / targetClose - 1) * 100 : float(na)
    rY = hasFuture1Y ? (targetClose[y1] / targetClose - 1) * 100 : float(na)

    array.push(ret1M,    r1)
    array.push(ret3M,    r3)
    array.push(ret6M,    r6)
    array.push(ret1Y,    rY)
    array.push(mdd1Y,    float(na))
    array.push(evtBars,  bar_index)
    array.push(evtTimes, time)

// ═══════════════════════════════════════
// MDD — aggiornato barra per barra
// ═══════════════════════════════════════

var float[] mddPeak    = array.new_float()
var float[] mddCurrent = array.new_float()

if event and bar_index > y1
    array.push(mddPeak,    targetClose)
    array.push(mddCurrent, 0.0)

int evtCount = array.size(evtBars)
if evtCount > 0
    for i = 0 to evtCount - 1
        int   eb          = array.get(evtBars, i)
        int   barsElapsed = bar_index - eb
        if barsElapsed > 0 and barsElapsed <= y1
            float c    = targetClose
            float peak = array.get(mddPeak, i)
            if c > peak
                array.set(mddPeak, i, c)
                peak := c
            float dd  = (c - peak) / peak * 100
            float cur = array.get(mddCurrent, i)
            if dd < cur
                array.set(mddCurrent, i, dd)
                array.set(mdd1Y,      i, dd)

// ═══════════════════════════════════════
// FUNCTIONS
// ═══════════════════════════════════════

f_avg(arr) =>
    float s  = 0.0
    int   n  = 0
    int   sz = array.size(arr)
    for i = 0 to sz - 1
        v = array.get(arr, i)
        if not na(v)
            s += v
            n += 1
    n > 0 ? s / n : na

f_median(arr) =>
    float[] valid = array.new_float()
    int sz = array.size(arr)
    for i = 0 to sz - 1
        v = array.get(arr, i)
        if not na(v)
            array.push(valid, v)
    int n = array.size(valid)
    if n == 0
        float(na)
    else
        array.sort(valid)
        n % 2 == 0 ? (array.get(valid, n / 2 - 1) + array.get(valid, n / 2)) / 2 : array.get(valid, n / 2)

f_win(arr) =>
    float w  = 0.0
    int   n  = 0
    int   sz = array.size(arr)
    for i = 0 to sz - 1
        v = array.get(arr, i)
        if not na(v)
            if v > 0
                w += 1
            n += 1
    n > 0 ? (w / n) * 100 : na

f_best(arr) =>
    float b  = na
    int   sz = array.size(arr)
    for i = 0 to sz - 1
        v = array.get(arr, i)
        if not na(v)
            b := na(b) ? v : math.max(b, v)
    b

f_worst(arr) =>
    float w  = na
    int   sz = array.size(arr)
    for i = 0 to sz - 1
        v = array.get(arr, i)
        if not na(v)
            w := na(w) ? v : math.min(w, v)
    w

f_fmt(v) =>
    na(v) ? "–" : str.tostring(v, "#.##") + "%"

f_color(v) =>
    na(v) ? color.new(color.gray, 60) : v >= 0 ? color.new(color.green, 40) : color.new(color.red, 40)

f_color_mdd(v) =>
    na(v) ? color.new(color.gray, 60) : v <= -20.0 ? color.new(color.red, 20) : v <= -10.0 ? color.new(color.orange, 30) : color.new(color.red, 55)

// ═══════════════════════════════════════
// COMPUTED STATS
// ═══════════════════════════════════════

avg1M    = array.size(ret1M) > 0 ? f_avg(ret1M)    : na
avg3M    = array.size(ret3M) > 0 ? f_avg(ret3M)    : na
avg6M    = array.size(ret6M) > 0 ? f_avg(ret6M)    : na
avg1Y    = array.size(ret1Y) > 0 ? f_avg(ret1Y)    : na

med1M    = array.size(ret1M) > 0 ? f_median(ret1M) : na
med3M    = array.size(ret3M) > 0 ? f_median(ret3M) : na
med6M    = array.size(ret6M) > 0 ? f_median(ret6M) : na
med1Y    = array.size(ret1Y) > 0 ? f_median(ret1Y) : na

win1M    = array.size(ret1M) > 0 ? f_win(ret1M)    : na
win3M    = array.size(ret3M) > 0 ? f_win(ret3M)    : na
win6M    = array.size(ret6M) > 0 ? f_win(ret6M)    : na
win1Y    = array.size(ret1Y) > 0 ? f_win(ret1Y)    : na

best1M   = array.size(ret1M) > 0 ? f_best(ret1M)   : na
best3M   = array.size(ret3M) > 0 ? f_best(ret3M)   : na
best6M   = array.size(ret6M) > 0 ? f_best(ret6M)   : na
best1Y   = array.size(ret1Y) > 0 ? f_best(ret1Y)   : na

worst1M  = array.size(ret1M) > 0 ? f_worst(ret1M)  : na
worst3M  = array.size(ret3M) > 0 ? f_worst(ret3M)  : na
worst6M  = array.size(ret6M) > 0 ? f_worst(ret6M)  : na
worst1Y  = array.size(ret1Y) > 0 ? f_worst(ret1Y)  : na

avgMdd1Y = array.size(mdd1Y) > 0 ? f_avg(mdd1Y)    : na

nEvents  = array.size(ret1M)

// ═══════════════════════════════════════
// COLORI — dichiarati prima delle tabelle
// ═══════════════════════════════════════

colHeader = color.new(color.gray, 30)
colFooter = color.new(color.gray, 50)

// ═══════════════════════════════════════
// TABELLA 1 — STATISTICHE AGGREGATE (top_left)
// ═══════════════════════════════════════

var table stats = table.new(position.top_left, 7, 7, border_color=color.new(color.gray, 50), border_width=1, frame_color=color.new(color.gray, 50), frame_width=1)

if barstate.islast
    // riga 0: spacer trasparente per margine superiore
    for col = 0 to 6
        table.cell(stats, col, 0, " ", bgcolor=color.new(color.black, 100), text_color=color.new(color.black, 100), text_size=size.tiny)

    table.cell(stats, 0, 1, "Period",       bgcolor=colHeader, text_color=color.white, text_size=size.small)
    table.cell(stats, 1, 1, "Events",       bgcolor=colHeader, text_color=color.white, text_size=size.small)
    table.cell(stats, 2, 1, "Avg ret",      bgcolor=colHeader, text_color=color.white, text_size=size.small)
    table.cell(stats, 3, 1, "Median ret",   bgcolor=colHeader, text_color=color.white, text_size=size.small)
    table.cell(stats, 4, 1, "Win rate",     bgcolor=colHeader, text_color=color.white, text_size=size.small)
    table.cell(stats, 5, 1, "Avg MDD",      bgcolor=colHeader, text_color=color.white, text_size=size.small)
    table.cell(stats, 6, 1, "Best / Worst", bgcolor=colHeader, text_color=color.white, text_size=size.small)

    table.cell(stats, 0, 2, "1 Month",            bgcolor=colFooter,                     text_color=color.white, text_size=size.small)
    table.cell(stats, 1, 2, str.tostring(nEvents), bgcolor=colFooter,                     text_color=color.white, text_size=size.small)
    table.cell(stats, 2, 2, f_fmt(avg1M),          bgcolor=f_color(avg1M),                text_color=color.white, text_size=size.small)
    table.cell(stats, 3, 2, f_fmt(med1M),          bgcolor=f_color(med1M),                text_color=color.white, text_size=size.small)
    table.cell(stats, 4, 2, f_fmt(win1M),          bgcolor=f_color(win1M - 50),           text_color=color.white, text_size=size.small)
    table.cell(stats, 5, 2, "–",                   bgcolor=color.new(color.gray, 60),     text_color=color.white, text_size=size.small)
    table.cell(stats, 6, 2, f_fmt(best1M) + " / " + f_fmt(worst1M),                       text_color=color.white, text_size=size.small)

    table.cell(stats, 0, 3, "3 Months",            bgcolor=colFooter,                     text_color=color.white, text_size=size.small)
    table.cell(stats, 1, 3, str.tostring(nEvents), bgcolor=colFooter,                     text_color=color.white, text_size=size.small)
    table.cell(stats, 2, 3, f_fmt(avg3M),          bgcolor=f_color(avg3M),                text_color=color.white, text_size=size.small)
    table.cell(stats, 3, 3, f_fmt(med3M),          bgcolor=f_color(med3M),                text_color=color.white, text_size=size.small)
    table.cell(stats, 4, 3, f_fmt(win3M),          bgcolor=f_color(win3M - 50),           text_color=color.white, text_size=size.small)
    table.cell(stats, 5, 3, "–",                   bgcolor=color.new(color.gray, 60),     text_color=color.white, text_size=size.small)
    table.cell(stats, 6, 3, f_fmt(best3M) + " / " + f_fmt(worst3M),                       text_color=color.white, text_size=size.small)

    table.cell(stats, 0, 4, "6 Months",            bgcolor=colFooter,                     text_color=color.white, text_size=size.small)
    table.cell(stats, 1, 4, str.tostring(nEvents), bgcolor=colFooter,                     text_color=color.white, text_size=size.small)
    table.cell(stats, 2, 4, f_fmt(avg6M),          bgcolor=f_color(avg6M),                text_color=color.white, text_size=size.small)
    table.cell(stats, 3, 4, f_fmt(med6M),          bgcolor=f_color(med6M),                text_color=color.white, text_size=size.small)
    table.cell(stats, 4, 4, f_fmt(win6M),          bgcolor=f_color(win6M - 50),           text_color=color.white, text_size=size.small)
    table.cell(stats, 5, 4, "–",                   bgcolor=color.new(color.gray, 60),     text_color=color.white, text_size=size.small)
    table.cell(stats, 6, 4, f_fmt(best6M) + " / " + f_fmt(worst6M),                       text_color=color.white, text_size=size.small)

    table.cell(stats, 0, 5, "1 Year",              bgcolor=colFooter,                     text_color=color.white, text_size=size.small)
    table.cell(stats, 1, 5, str.tostring(nEvents), bgcolor=colFooter,                     text_color=color.white, text_size=size.small)
    table.cell(stats, 2, 5, f_fmt(avg1Y),          bgcolor=f_color(avg1Y),                text_color=color.white, text_size=size.small)
    table.cell(stats, 3, 5, f_fmt(med1Y),          bgcolor=f_color(med1Y),                text_color=color.white, text_size=size.small)
    table.cell(stats, 4, 5, f_fmt(win1Y),          bgcolor=f_color(win1Y - 50),           text_color=color.white, text_size=size.small)
    table.cell(stats, 5, 5, f_fmt(avgMdd1Y),       bgcolor=f_color_mdd(avgMdd1Y),         text_color=color.white, text_size=size.small)
    table.cell(stats, 6, 5, f_fmt(best1Y) + " / " + f_fmt(worst1Y),                       text_color=color.white, text_size=size.small)

    string lookbackLabel = lookbackYears == 0 ? "All history" : "Last " + str.tostring(lookbackYears) + "Y"
    string footerLeft    = eventType + " – " + triggerSymbol + " " + str.tostring(maLength) + "D MA"
    string footerRight   = "→ " + targetSymbol + " | " + lookbackLabel
    table.cell(stats, 0, 6, footerLeft,  bgcolor=colFooter, text_color=color.new(color.white, 30), text_halign=text.align_left, text_size=size.small)
    table.cell(stats, 1, 6, footerRight, bgcolor=colFooter, text_color=color.new(color.white, 30), text_halign=text.align_left, text_size=size.small)

// ═══════════════════════════════════════
// TABELLA 2 — EPISODI (bottom_right)
// ═══════════════════════════════════════

var table episodes = table.new(position.bottom_right, 6, 52, border_color=color.new(color.gray, 50), border_width=1, frame_color=color.new(color.gray, 50), frame_width=1)

if barstate.islast
    table.cell(episodes, 0, 0, "Date", bgcolor=colHeader, text_color=color.white, text_size=size.small)
    table.cell(episodes, 1, 0, "1M",   bgcolor=colHeader, text_color=color.white, text_size=size.small)
    table.cell(episodes, 2, 0, "3M",   bgcolor=colHeader, text_color=color.white, text_size=size.small)
    table.cell(episodes, 3, 0, "6M",   bgcolor=colHeader, text_color=color.white, text_size=size.small)
    table.cell(episodes, 4, 0, "1Y",   bgcolor=colHeader, text_color=color.white, text_size=size.small)
    table.cell(episodes, 5, 0, "MDD",  bgcolor=colHeader, text_color=color.white, text_size=size.small)

    int totalEvt  = array.size(evtTimes)
    int startIdx  = math.max(0, totalEvt - maxEpisodes)
    int rowOffset = 1

    for i = startIdx to totalEvt - 1
        float  r1 = array.get(ret1M,    i)
        float  r3 = array.get(ret3M,    i)
        float  r6 = array.get(ret6M,    i)
        float  rY = array.get(ret1Y,    i)
        float  md = array.get(mdd1Y,    i)
        int    ts = array.get(evtTimes, i)
        string dt = str.format_time(ts, "MMM dd yyyy")

        table.cell(episodes, 0, rowOffset, dt,        bgcolor=colFooter,       text_color=color.white, text_size=size.small)
        table.cell(episodes, 1, rowOffset, f_fmt(r1), bgcolor=f_color(r1),     text_color=color.white, text_size=size.small)
        table.cell(episodes, 2, rowOffset, f_fmt(r3), bgcolor=f_color(r3),     text_color=color.white, text_size=size.small)
        table.cell(episodes, 3, rowOffset, f_fmt(r6), bgcolor=f_color(r6),     text_color=color.white, text_size=size.small)
        table.cell(episodes, 4, rowOffset, f_fmt(rY), bgcolor=f_color(rY),     text_color=color.white, text_size=size.small)
        table.cell(episodes, 5, rowOffset, f_fmt(md), bgcolor=f_color_mdd(md), text_color=color.white, text_size=size.small)
        rowOffset += 1

// ═══════════════════════════════════════
// EVENT MARKERS
// ═══════════════════════════════════════

plotshape(event and eventType == "Breakdown", title="Breakdown event", style=shape.triangledown, location=location.top,    color=color.red,   size=size.tiny)
plotshape(event and eventType == "Breakout",  title="Breakout event",  style=shape.triangleup,   location=location.bottom, color=color.green, size=size.tiny)
