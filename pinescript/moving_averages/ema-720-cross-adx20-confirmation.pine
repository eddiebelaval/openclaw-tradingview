//@version=6
indicator("EMA 7/20 Cross + ADX(>20) Confirmation", overlay=true)

// Inputs
emaFastLen = input.int(7,  "Fast EMA Length", minval=1)
emaSlowLen = input.int(20, "Slow EMA Length", minval=1)
diLen      = input.int(14, "DMI / DI Length", minval=1)
adxSmooth  = input.int(14, "ADX Smoothing", minval=1)
adxThresh  = input.float(20.0, "ADX Threshold", minval=0.0)

// Calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

// ADX via DMI (returns +DI, -DI, ADX)
[diPlus, diMinus, adxVal] = ta.dmi(diLen, adxSmooth)

// Cross conditions
bullCross = ta.crossover(emaFast, emaSlow)
bearCross = ta.crossunder(emaFast, emaSlow)

// ADX validation
adxOK = adxVal > adxThresh

// Final signals (only when ADX validates)
buySignal  = bullCross and adxOK
sellSignal = bearCross and adxOK

// Plots
plot(emaFast, title="EMA 7", linewidth=2)
plot(emaSlow, title="EMA 20", linewidth=2)

// Signal arrows
plotshape(
     buySignal,
     title="Buy Signal",
     style=shape.arrowup,
     location=location.belowbar,
     color=color.blue,
     size=size.small
)

plotshape(
     sellSignal,
     title="Sell Signal",
     style=shape.arrowdown,
     location=location.abovebar,
     color=color.red,
     size=size.small
)

// ADX shown in Data Window (keeps chart clean)
plot(adxVal, title="ADX", display=display.data_window)
