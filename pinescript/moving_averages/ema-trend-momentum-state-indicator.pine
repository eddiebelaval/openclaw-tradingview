//@version=5
indicator("EMA Trend Momentum State + HTF Context", overlay=true)

// === Inputs ===
fastLen  = input.int(10,  "Fast EMA")
midLen   = input.int(20,  "Medium EMA")
trendLen = input.int(50,  "Trend EMA")
biasLen  = input.int(200, "Bias EMA")
lookback = input.int(3,   "Momentum Lookback")

// === EMAs ===
ema10  = ta.ema(close, fastLen)
ema20  = ta.ema(close, midLen)
ema50  = ta.ema(close, trendLen)
ema200 = ta.ema(close, biasLen)

// === Momentum ===
fastUp   = ema10 > ema10[lookback]
fastDown = ema10 < ema10[lookback]

// === Trend Conditions ===
bullTrend = ema10 > ema20
bearTrend = ema10 < ema20

// === State ===
isGreen  = bullTrend and fastUp
isRed    = bearTrend and fastDown
isYellow = not isGreen and not isRed

// === Background Colors ===
greenColor  = color.new(color.green, 85)
redColor    = color.new(color.red, 85)
yellowColor = color.new(color.yellow, 85)

// Apply background only
bgcolor(isGreen ? greenColor : isRed ? redColor : yellowColor)

// === Plot EMAs ===
plot(ema10,  title="EMA 10",  color=color.teal,   linewidth=1)
plot(ema20,  title="EMA 20",  color=color.orange, linewidth=1)
plot(ema50,  title="EMA 50",  color=color.blue,   linewidth=1)
plot(ema200, title="EMA 200", color=color.black,  linewidth=1)
