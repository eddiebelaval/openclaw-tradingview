//@version=6
// © YoTrade
// Multi-MA Pro - Version 1.0
indicator(title="Multi MA Pro v1.0 {YoTrade}", shorttitle="Multi MA Pro v1.0 {YoTrade}", overlay=true)

// --- Functions ---
getMA(type, src, len) =>
    switch type
        "SMA"  => ta.sma(src, len)
        "EMA"  => ta.ema(src, len)
        "WMA"  => ta.wma(src, len)
        "VWMA" => ta.vwma(src, len)
        "HMA"  => ta.hma(src, len)
        => ta.ema(src, len)

// --- General Settings ---
groupGen     = "General Settings"
maType       = input.string("EMA", "MA Method", options=["SMA", "EMA", "WMA", "VWMA", "HMA"], group=groupGen)
showLabels   = input.bool(true, "Show Labels at End?", group=groupGen)
showPrice    = input.bool(true, "Show Price in Labels?", group=groupGen)
labelOffset  = input.int(5, "Label Offset (Bars)", minval=1, group=groupGen)
showCloud    = input.bool(true, "Show Trend Cloud (Fast/Slow)?", group=groupGen)

groupSignals = "Signal Settings"
showCrosses  = input.bool(true, "Show MA Cross Bubbles?", group=groupSignals)
showBgHigh   = input.bool(false, "Highlight Signal Bar Background?", group=groupSignals)
crossOpacity = input.int(50, "Bubble Opacity (0-100)", minval=0, maxval=100, group=groupSignals)
bubbleSize   = input.string("Tiny", "Bubble Size", options=["Tiny", "Small", "Normal", "Large"], group=groupSignals)

// --- MA Settings ---
groupF = "FAST Line (Signal Driver)"
showF  = input.bool(true, "Show Fast MA", group=groupF)
lenF   = input.int(20, "Fast Length", minval=1, group=groupF)
colF   = input.color(color.green, "Fast Color", group=groupF)
widF   = input.int(2, "Fast Width", minval=1, maxval=10, group=groupF)

groupS = "SLOW Line (Signal Driver)"
showS  = input.bool(true, "Show Slow MA", group=groupS)
lenS   = input.int(50, "Slow Length", minval=1, group=groupS)
colS   = input.color(color.red, "Slow Color", group=groupS)
widS   = input.int(2, "Slow Width", minval=1, maxval=10, group=groupS)

group3 = "MA 3 Settings"
show3  = input.bool(true, "Show MA 3", group=group3)
len3   = input.int(100, "MA 3 Length", minval=1, group=group3)
col3   = input.color(color.aqua, "MA 3 Color", group=group3)
wid3   = input.int(1, "MA 3 Width", minval=1, maxval=10, group=group3)

group4 = "MA 4 Settings"
show4  = input.bool(true, "Show MA 4", group=group4)
len4   = input.int(200, "MA 4 Length", minval=1, group=group4)
col4   = input.color(color.blue, "MA 4 Color", group=group4)
wid4   = input.int(1, "MA 4 Width", minval=1, maxval=10, group=group4)

// --- Calculations ---
maF = getMA(maType, close, lenF)
maS = getMA(maType, close, lenS)
ma3 = getMA(maType, close, len3)
ma4 = getMA(maType, close, len4)

bullCross = ta.crossover(maF, maS)
bearCross = ta.crossunder(maF, maS)

// --- Alerts ---
alertcondition(bullCross, title="MA Crossing UP",   message="YoTrade: Fast MA crossed ABOVE Slow MA on {{ticker}}")
alertcondition(bearCross, title="MA Crossing DOWN", message="YoTrade: Fast MA crossed BELOW Slow MA on {{ticker}}")

// --- Plots ---
p1 = plot(showF ? maF : na, color=colF, linewidth=widF, title="Fast MA")
p2 = plot(showS ? maS : na, color=colS, linewidth=widS, title="Slow MA")
plot(show3 ? ma3 : na, color=col3, linewidth=wid3, title="MA 3")
plot(show4 ? ma4 : na, color=col4, linewidth=wid4, title="MA 4")

// Trend Cloud Fill
fillColor = showCloud ? (maF > maS ? color.new(colF, 90) : color.new(colS, 90)) : na
fill(p1, p2, color=fillColor, title="Trend Cloud")

// Background Highlights
bgcolor(showBgHigh and bullCross ? color.new(color.green, 85) : na, title="Bullish Signal BG")
bgcolor(showBgHigh and bearCross ? color.new(color.red, 85) : na, title="Bearish Signal BG")

// --- Cross Bubbles ---
bubbleTransp = 100 - crossOpacity
bullCond = showCrosses and bullCross ? maF : na
bearCond = showCrosses and bearCross ? maS : na

plotshape(bubbleSize == "Tiny" ? bullCond : na,   style=shape.circle, location=location.absolute, color=color.new(color.green, bubbleTransp), size=size.tiny,   title="Bull Tiny")
plotshape(bubbleSize == "Small" ? bullCond : na,  style=shape.circle, location=location.absolute, color=color.new(color.green, bubbleTransp), size=size.small,  title="Bull Small")
plotshape(bubbleSize == "Normal" ? bullCond : na, style=shape.circle, location=location.absolute, color=color.new(color.green, bubbleTransp), size=size.normal, title="Bull Normal")
plotshape(bubbleSize == "Large" ? bullCond : na,  style=shape.circle, location=location.absolute, color=color.new(color.green, bubbleTransp), size=size.large,  title="Bull Large")

plotshape(bubbleSize == "Tiny" ? bearCond : na,   style=shape.circle, location=location.absolute, color=color.new(color.red, bubbleTransp), size=size.tiny,   title="Bear Tiny")
plotshape(bubbleSize == "Small" ? bearCond : na,  style=shape.circle, location=location.absolute, color=color.new(color.red, bubbleTransp), size=size.small,  title="Bear Small")
plotshape(bubbleSize == "Normal" ? bearCond : na, style=shape.circle, location=location.absolute, color=color.new(color.red, bubbleTransp), size=size.normal, title="Bear Normal")
plotshape(bubbleSize == "Large" ? bearCond : na,  style=shape.circle, location=location.absolute, color=color.new(color.red, bubbleTransp), size=size.large,  title="Bear Large")

// --- Label Logic ---
futureTime = time + (ta.change(time) * labelOffset)
updateLabel(lbl, val, txt, lblColor, visible, showLine, showVal) =>
    if barstate.islast
        string finalStr = txt + (showVal ? " [" + str.tostring(val, format.mintick) + "]" : "")
        label.set_xy(lbl, futureTime, val)
        label.set_text(lbl, finalStr)
        label.set_color(lbl, (visible and showLine) ? lblColor : color.new(lblColor, 100))
        label.set_textcolor(lbl, (visible and showLine) ? color.white : color.new(color.white, 100))

var lblF = label.new(futureTime, maF, "FAST", xloc=xloc.bar_time, style=label.style_label_left, textcolor=color.white)
var lblS = label.new(futureTime, maS, "SLOW", xloc=xloc.bar_time, style=label.style_label_left, textcolor=color.white)
var lbl3 = label.new(futureTime, ma3, maType, xloc=xloc.bar_time, style=label.style_label_left, textcolor=color.white)
var lbl4 = label.new(futureTime, ma4, maType, xloc=xloc.bar_time, style=label.style_label_left, textcolor=color.white)

updateLabel(lblF, maF, "FAST " + str.tostring(lenF), colF, showLabels, showF, showPrice)
updateLabel(lblS, maS, "SLOW " + str.tostring(lenS), colS, showLabels, showS, showPrice)
updateLabel(lbl3, ma3, maType + " " + str.tostring(len3), col3, showLabels, show3, showPrice)
updateLabel(lbl4, ma4, maType + " " + str.tostring(len4), col4, showLabels, show4, showPrice)
