//@version=5
indicator("McMillan's VIX 20/200 DMA Trend Signal", shorttitle="McMillan VIX Regime", overlay=true, max_labels_count=500, max_lines_count=500)

// VIX symbol (most reliable is CBOE:VIX on TradingView)
vix_sym = input.string("CBOE:VIX", "VIX Ticker", options=["VIX", "CBOE:VIX", "TVC:VIX"])

// Fetch daily VIX data + MAs (even if chart is lower timeframe)
vix_close = request.security(vix_sym, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
vix20     = request.security(vix_sym, "D", ta.sma(close, 20), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
vix200    = request.security(vix_sym, "D", ta.sma(close, 200), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// Exact conditions from the infographic
low_vol_regime  = vix_close < vix200 and vix20 < vix200
high_vol_regime = vix_close > vix200 and vix20 > vix200

// Persistent state machine – exactly as described:
// "It's a PERSISTENT STATE, not a one-day event. Once triggered, you're in that regime until it flips to the opposite condition."
var string regime = na
regime := na(regime[1]) ? (low_vol_regime ? "Low Vol" : high_vol_regime ? "High Vol" : "Neutral") : regime
if low_vol_regime
    regime := "Low Vol"
if high_vol_regime
    regime := "High Vol"

// Signals fire ONLY on the first bar the condition is met (the "trigger" day)
buy_signal  = low_vol_regime  and (na(regime[1]) or regime[1] != "Low Vol")
sell_signal = high_vol_regime and (na(regime[1]) or regime[1] != "High Vol")

// Plot entry signals (triangles + text exactly matching the infographic)
plotshape(buy_signal,  title="SPX BUY SIGNAL",  location=location.belowbar, color=color.new(color.green, 0), style=shape.triangleup,   size=size.small, text="BUY\nLow Vol",  textcolor=color.white)
plotshape(sell_signal, title="SPX SELL SIGNAL", location=location.abovebar, color=color.new(color.red,   0), style=shape.triangledown, size=size.small, text="SELL\nHigh Vol", textcolor=color.white)

// Background coloring for the current persistent regime
bg_color = regime == "Low Vol"  ? color.new(color.green, 80) :
           regime == "High Vol" ? color.new(color.red,   80) : na
bgcolor(bg_color, title="Regime Background")


// Info table
var table t = table.new(position.top_right, 1, 3, bgcolor=color.new(#1e222d, 80), border_width=1, frame_color=color.white)

if barstate.islast
    table.cell(t, 0, 0, "McMillan VIX 20/200 Regime", text_color=color.white, text_size=size.small)
    
    // FIXED: using if/else instead of multiline ternary
    string reg_text = "NEUTRAL"
    color  reg_bg   = color.new(color.gray, 0)
    
    if regime == "Low Vol"
        reg_text := "LOW VOL\nCalm waters\nStocks grind higher"
        reg_bg   := color.new(color.green, 0)
    else if regime == "High Vol"
        reg_text := "HIGH VOL\nStorm brewing\nStocks under pressure"
        reg_bg   := color.new(color.red, 0)
    
    table.cell(t, 0, 1, reg_text, text_color=color.white, bgcolor=reg_bg, text_size=size.normal)
    
    table.cell(t, 0, 2, "VIX: " + str.tostring(vix_close, "#.##") + 
                       "\n20DMA: " + str.tostring(vix20, "#.##") + 
                       "\n200DMA: " + str.tostring(vix200, "#.##"), 
               text_color=color.white, text_size=size.small)

// Built-in alerts (set alerts on these in TradingView)
alertcondition(buy_signal,  "McMillan SPX BUY",  "McMillan VIX Trend BUY SIGNAL – Low Vol Regime (both VIX & 20DMA below 200DMA)")
alertcondition(sell_signal, "McMillan SPX SELL", "McMillan VIX Trend SELL SIGNAL – High Vol Regime (both VIX & 20DMA above 200DMA)")
