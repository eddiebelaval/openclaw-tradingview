//@version=6
indicator('SMA 50 • 100 • 200 • 300 + Fills', shorttitle = 'SMA 50-300 + Fills', overlay = true)

// ── Inputs ───────────────────────────────────────────────────────
maType = input.string('SMA', title = 'MA Type', options = ['SMA', 'EMA'], group = 'Type')

len50 = input.int(50, '50-period', minval = 1, group = 'Periods')
len100 = input.int(100, '100-period', minval = 1, group = 'Periods')
len200 = input.int(200, '200-period', minval = 1, group = 'Periods')
len300 = input.int(300, '300-period', minval = 1, group = 'Periods')

show50 = input.bool(true, 'Show 50', inline = '50', group = 'Visibility')
show100 = input.bool(true, 'Show 100', inline = '100', group = 'Visibility')
show200 = input.bool(true, 'Show 200', inline = '200', group = 'Visibility')
show300 = input.bool(true, 'Show 300', inline = '300', group = 'Visibility')

col50 = input.color(color.new(color.green, 0), '50', inline = '50', group = 'Style')
col100 = input.color(color.new(color.orange, 0), '100', inline = '100', group = 'Style')
col200 = input.color(color.new(color.red, 0), '200', inline = '200', group = 'Style')
col300 = input.color(color.new(color.purple, 0), '300', inline = '300', group = 'Style')

linewidth = input.int(2, 'Line width', minval = 1, maxval = 5, group = 'Style')

// ── Calculate moving averages ────────────────────────────────────
f_getMA(src, len) =>
    switch maType
        'EMA' => ta.ema(src, len)
        => ta.sma(src, len) // default SMA

ma50 = f_getMA(close, len50)
ma100 = f_getMA(close, len100)
ma200 = f_getMA(close, len200)
ma300 = f_getMA(close, len300)

// ── Plot lines ───────────────────────────────────────────────────
p50 = plot(show50 ? ma50 : na, title = '50', color = col50, linewidth = math.max(1, linewidth))
p100 = plot(show100 ? ma100 : na, title = '100', color = col100, linewidth = math.max(1, linewidth))
p200 = plot(show200 ? ma200 : na, title = '200', color = col200, linewidth = math.max(1, linewidth))
p300 = plot(show300 ? ma300 : na, title = '300', color = col300, linewidth = math.max(1, linewidth))

// ── Fill areas ───────────────────────────────────────────────────
// Helper function: green tint when upper > lower, red tint otherwise
f_fill_color(upper, lower) =>
    upper > lower ? color.new(color.green, 90) : color.new(color.red, 90)

// 50–100 fill (short/medium term)
fill(p50, p100, color = f_fill_color(ma50, ma100), title = '50–100 zone')

// 200–300 fill (long-term)
fill(p200, p300, color = f_fill_color(ma200, ma300), title = '200–300 zone')
