//@version=6
indicator("9/20 Strategy: Intra-Day Ledger", overlay=true)

// --- 1. Inputs ---
emaLen      = input.int(9, "9 EMA")
smaLen      = input.int(20, "20 SMA")
rrRatio     = input.float(1.5, "Risk:Reward (1.5R)")
tickBuffer  = input.float(0.5, "SL Buffer")

// --- 2. Time Windows (New York Time) ---
sessMorning = "0930-1130"
sessPower   = "1500-1600"

bool isMorning = not na(time(timeframe.period, sessMorning, "America/New_York"))
bool isPower   = not na(time(timeframe.period, sessPower, "America/New_York"))
bool isTradeWindow = isMorning or isPower

isNewDay = ta.change(time("D", "America/New_York")) != 0

// --- 3. Indicators ---
float emaVal    = ta.ema(close, emaLen)
float smaVal    = ta.sma(close, smaLen)

plot(emaVal, color=color.blue, title="9 EMA", linewidth=2)
plot(smaVal, color=color.orange, title="20 SMA", linewidth=2)

// --- 4. Arrays (Fixed to 7) ---
var sideArr   = array.new_string(0)
var entryArr  = array.new_float(0)
var slArr     = array.new_float(0)
var tpArr     = array.new_float(0)
var statusArr = array.new_string(0)

if isNewDay
    array.clear(sideArr), array.clear(entryArr), array.clear(slArr), array.clear(tpArr), array.clear(statusArr)

// --- 5. Signal Logic ---
bool longCross  = ta.crossover(emaVal, smaVal)
bool shortCross = ta.crossunder(emaVal, smaVal)

bool buySignal  = isTradeWindow and longCross
bool sellSignal = isTradeWindow and shortCross

if buySignal or sellSignal
    float ent = close
    float sl  = buySignal ? (low[1] - tickBuffer) : (high[1] + tickBuffer)
    float risk = math.abs(ent - sl)
    float tp   = buySignal ? (ent + (risk * rrRatio)) : (ent - (risk * rrRatio))
    
    array.push(sideArr, buySignal ? "BUY" : "SELL")
    array.push(entryArr, ent)
    array.push(slArr, sl)
    array.push(tpArr, tp)
    array.push(statusArr, "ACTIVE")

    if array.size(sideArr) > 7
        array.shift(sideArr), array.shift(entryArr), array.shift(slArr), array.shift(tpArr), array.shift(statusArr)
    
    label.new(bar_index, buySignal ? low : high, text=buySignal ? "BUY" : "SELL", color=buySignal ? color.green : color.red, textcolor=color.white, style=buySignal ? label.style_label_up : label.style_label_down, yloc=buySignal ? yloc.belowbar : yloc.abovebar)
    label.new(bar_index + 1, tp, text="TP: " + str.tostring(tp, "#.##"), color=color.new(color.black, 100), textcolor=color.green, style=label.style_label_center, size=size.large)
    label.new(bar_index + 1, sl, text="SL: " + str.tostring(sl, "#.##"), color=color.new(color.black, 100), textcolor=color.red, style=label.style_label_center, size=size.large)
    line.new(bar_index, sl, bar_index + 12, sl, color=color.new(color.red, 50), width=2, style=line.style_dashed)
    line.new(bar_index, tp, bar_index + 12, tp, color=color.new(color.green, 50), width=2, style=line.style_solid)

// --- 6. Status Monitoring ---
int winCount = 0
int totalCompleted = 0

if array.size(sideArr) > 0
    for i = 0 to array.size(sideArr) - 1
        string curStatus = array.get(statusArr, i)
        if curStatus == "ACTIVE"
            string curSide = array.get(sideArr, i)
            float curTP    = array.get(tpArr, i)
            float curSL    = array.get(slArr, i)
            if (curSide == "BUY" and high >= curTP) or (curSide == "SELL" and low <= curTP)
                array.set(statusArr, i, "WIN ✅")
            else if (curSide == "BUY" and low <= curSL) or (curSide == "SELL" and high >= curSL)
                array.set(statusArr, i, "LOSS ❌")
        
        // Update stats for the summary row
        if array.get(statusArr, i) == "WIN ✅"
            winCount += 1
            totalCompleted += 1
        else if array.get(statusArr, i) == "LOSS ❌"
            totalCompleted += 1

float winPct = totalCompleted > 0 ? (winCount / totalCompleted) * 100 : 0

// --- 7. History Table (Fixed 7 Rows + Summary - TOP CENTER) ---
var table historyTable = table.new(position.top_center, 5, 10, bgcolor=color.new(color.black, 30), border_width=1, border_color=color.gray)

if barstate.islast
    // Main Title spanning 5 columns
    table.cell(historyTable, 0, 0, "INTRA-DAY: MORNING & POWER HOUR", text_color=color.yellow, bgcolor=color.new(color.gray, 20), text_size=size.normal)
    table.merge_cells(historyTable, 0, 0, 4, 0)

    // Header Row
    table.cell(historyTable, 0, 1, "SIDE", text_color=color.white, bgcolor=color.gray)
    table.cell(historyTable, 1, 1, "ENTRY", text_color=color.white, bgcolor=color.gray)
    table.cell(historyTable, 2, 1, "SL", text_color=color.white, bgcolor=color.gray)
    table.cell(historyTable, 3, 1, "TP", text_color=color.white, bgcolor=color.gray)
    table.cell(historyTable, 4, 1, "RESULT", text_color=color.white, bgcolor=color.gray)

    // Trade Rows (Rows 2 to 8)
    for i = 0 to 6
        int row = i + 2
        if i < array.size(sideArr)
            string side = array.get(sideArr, i)
            string stat = array.get(statusArr, i)
            table.cell(historyTable, 0, row, side, text_color = side == "BUY" ? color.green : color.red)
            table.cell(historyTable, 1, row, str.tostring(array.get(entryArr, i), "#.##"), text_color=color.white)
            table.cell(historyTable, 2, row, str.tostring(array.get(slArr, i), "#.##"), text_color=color.red)
            table.cell(historyTable, 3, row, str.tostring(array.get(tpArr, i), "#.##"), text_color=color.green)
            table.cell(historyTable, 4, row, stat, text_color = stat == "WIN ✅" ? color.green : stat == "LOSS ❌" ? color.red : color.white)
        else
            table.cell(historyTable, 0, row, "-", text_color=color.new(color.white, 70))
            table.cell(historyTable, 1, row, "-", text_color=color.new(color.white, 70))
            table.cell(historyTable, 2, row, "-", text_color=color.new(color.white, 70))
            table.cell(historyTable, 3, row, "-", text_color=color.new(color.white, 70))
            table.cell(historyTable, 4, row, "WAITING...", text_color=color.new(color.white, 50))

    // Summary Row (Row 9)
    table.cell(historyTable, 0, 9, "TOTAL: " + str.tostring(totalCompleted), text_color=color.white, bgcolor=color.new(color.gray, 40))
    table.merge_cells(historyTable, 0, 9, 1, 9)
    table.cell(historyTable, 2, 9, "WIN RATE:", text_color=color.white, bgcolor=color.new(color.gray, 40))
    table.cell(historyTable, 3, 9, str.tostring(winPct, "#.#") + "%", text_color=winPct >= 50 ? color.green : color.red, bgcolor=color.new(color.gray, 40))
    table.merge_cells(historyTable, 3, 9, 4, 9)

bgcolor(isTradeWindow ? color.new(color.gray, 96) : na)
