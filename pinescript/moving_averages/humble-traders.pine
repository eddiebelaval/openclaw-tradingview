//@version=6
indicator("Humble Traders", overlay = true)

// ══════════════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════════════

// --- Moving Averages ---
string grpMA = "Moving Averages"
string maType = input.string("EMA", "MA Type", options = ["SMA", "EMA"], group = grpMA)
int    ma1Len   = input.int(21,  "MA 1 Length", minval = 1, group = grpMA)
int    ma2Len   = input.int(35,  "MA 2 Length", minval = 1, group = grpMA)
int    ma3Len   = input.int(50,  "MA 3 Length", minval = 1, group = grpMA)
int    ma4Len   = input.int(750, "MA 4 Length", minval = 1, group = grpMA)
bool   showMA1  = input.bool(true, "Show MA 1",  group = grpMA)
bool   showMA2  = input.bool(true, "Show MA 2",  group = grpMA)
bool   showMA3  = input.bool(true, "Show MA 3",  group = grpMA)
bool   showMA4  = input.bool(true, "Show MA 4",  group = grpMA)

// --- ADX ---
string grpADX = "ADX (Average Directional Index)"
bool   showADX    = input.bool(true, "Show ADX Panel", group = grpADX)
string adxSize    = input.string("Normal", "Panel Size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = grpADX)
int    adxLen     = input.int(12,  "ADX Period",   minval = 1, group = grpADX)
float  adxLevel1  = input.float(20.0, "ADX Level 1 (Trend threshold)", group = grpADX)
float  adxLevel2  = input.float(33.0, "ADX Level 2 (Strong trend)",    group = grpADX)

// ══════════════════════════════════════════════════════════════════════
// MOVING AVERAGES
// ══════════════════════════════════════════════════════════════════════

ma(src, len) =>
    maType == "SMA" ? ta.sma(src, len) : ta.ema(src, len)

ma1 = ma(hlcc4, ma1Len)
ma2 = ma(hlcc4, ma2Len)
ma3 = ma(hlcc4, ma3Len)
ma4 = ma(hlcc4, ma4Len)

// Plot
plot(showMA1 ? ma1 : na, "MA 1 (21)",  color = color.new(#0099CC, 0),   linewidth = 1)  // Blue
plot(showMA2 ? ma2 : na, "MA 2 (35)",  color = color.new(#FF8C00, 0),   linewidth = 1)  // Orange
plot(showMA3 ? ma3 : na, "MA 3 (50)",  color = color.new(#9927CC, 0),   linewidth = 1)  // Purple
plot(showMA4 ? ma4 : na, "MA 4 (750)", color = color.new(#DC143C, 0),   linewidth = 1)  // Red

// ══════════════════════════════════════════════════════════════════════
// ADX  (Average Directional Movement Index — separate pane via table)
// ══════════════════════════════════════════════════════════════════════

// Calculate ADX components manually (Wilder smoothing)
upMove   = high - high[1]
downMove = low[1] - low
plusDM   = upMove > downMove and upMove > 0 ? upMove : 0.0
minusDM  = downMove > upMove and downMove > 0 ? downMove : 0.0

// True Range
trVal = ta.tr(true)

// Wilder smoothed (RMA)
smoothPlusDM  = ta.rma(plusDM, adxLen)
smoothMinusDM = ta.rma(minusDM, adxLen)
smoothTR      = ta.rma(trVal, adxLen)

// +DI / -DI
plusDI  = smoothTR != 0 ? 100 * smoothPlusDM  / smoothTR : 0.0
minusDI = smoothTR != 0 ? 100 * smoothMinusDM / smoothTR : 0.0

// DX and ADX
dx  = (plusDI + minusDI) != 0 ? 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI) : 0.0
adx = ta.rma(dx, adxLen)

// ══════════════════════════════════════════════════════════════════════
// ADX INFO TABLE  (bottom-right panel showing ADX values + trend info)
// ══════════════════════════════════════════════════════════════════════

// Resolve panel sizes from dropdown
string headSz  = adxSize == "Tiny" ? size.tiny : adxSize == "Small" ? size.small : adxSize == "Normal" ? size.normal : adxSize == "Large" ? size.large : size.huge
string labelSz  = headSz
string valueSz  = adxSize == "Tiny" ? size.small : adxSize == "Small" ? size.normal : adxSize == "Normal" ? size.large : adxSize == "Large" ? size.large : size.huge
string footSz   = adxSize == "Tiny" ? size.tiny : adxSize == "Small" ? size.tiny : adxSize == "Normal" ? size.small : adxSize == "Large" ? size.normal : size.large

if showADX and barstate.islast
    var table adxTable = table.new(position.bottom_right, 4, 4, bgcolor = color.new(#1E1E1E, 10), border_width = 1, border_color = color.new(#3C3C3C, 0))

    // Header
    table.cell(adxTable, 0, 0, "ADX Panel", text_color = color.white, text_size = headSz, bgcolor = color.new(#1E1E1E, 0))
    table.merge_cells(adxTable, 0, 0, 3, 0)

    // Level labels
    table.cell(adxTable, 0, 1, "ADX",  text_color = #9927CC, text_size = labelSz)
    table.cell(adxTable, 1, 1, "+DI",  text_color = #00BFFF, text_size = labelSz)
    table.cell(adxTable, 2, 1, "−DI",  text_color = #B22222, text_size = labelSz)
    table.cell(adxTable, 3, 1, "Signal", text_color = color.white, text_size = labelSz)

    // Values
    table.cell(adxTable, 0, 2, str.tostring(adx, "#.#"),     text_color = #9927CC, text_size = valueSz)
    table.cell(adxTable, 1, 2, str.tostring(plusDI, "#.#"),   text_color = #00BFFF, text_size = valueSz)
    table.cell(adxTable, 2, 2, str.tostring(minusDI, "#.#"), text_color = #B22222, text_size = valueSz)

    // Determine signal
    string sig = "No Trend"
    color  sigClr = color.gray

    if adx >= adxLevel2
        sig    := plusDI > minusDI ? "Strong BUY ▲" : "Strong SELL ▼"
        sigClr := plusDI > minusDI ? color.lime : color.red
    else if adx >= adxLevel1
        sig    := plusDI > minusDI ? "Buy ▲" : "Sell ▼"
        sigClr := plusDI > minusDI ? color.new(color.lime, 40) : color.new(color.red, 40)
    else
        sig    := "Ranging"
        sigClr := color.gray

    table.cell(adxTable, 3, 2, sig, text_color = sigClr, text_size = valueSz)

    // Levels reference
    table.cell(adxTable, 0, 3, ">" + str.tostring(adxLevel1, "#") + " = Trend", text_color = color.new(#FF00FF, 0), text_size = footSz)
    table.merge_cells(adxTable, 0, 3, 1, 3)
    table.cell(adxTable, 2, 3, ">" + str.tostring(adxLevel2, "#") + " = Strong", text_color = color.new(#FF00FF, 0), text_size = footSz)
    table.merge_cells(adxTable, 2, 3, 3, 3)
