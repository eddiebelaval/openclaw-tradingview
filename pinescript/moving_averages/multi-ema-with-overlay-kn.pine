//@version=6
indicator("Multi-EMA with Overlay - KN", overlay=true)

// ==========================================
// EMA SETTINGS & LOGIC
// ==========================================
group1       = "EMA 1"
group2       = "EMA 2"
group3       = "EMA 3"
groupDisplay = "EMA Display Toggles"
groupLabels  = "EMA Labels"

// Candle color overlay settings
// this group controls the coloring of the price bars based on EMA relationship
groupCandle = "Candle Colors"
showCandleColor = input.bool(true, "Enable Candle Coloring", group=groupCandle)
bullColor  = input.color(color.green, "Bullish Candle Color", group=groupCandle)
bearColor  = input.color(color.red,   "Bearish Candle Color",  group=groupCandle)

groupPreset = "Length Presets"
preset = input.string("Custom", "Choose a preset",
     options=["Custom", "Scalper's Setup (9/21/55)", "Fibonacci Trio (8/13/21)", "Big Picture Scalp (13/50/200)"],
     tooltip="Selecting a preset will populate the EMA lengths below.",
     group=groupPreset)

// EMA 1 settings
ema1LengthInput  = input.int(50, title="Length", group=group1)
ema1Color   = input.color(color.purple, title="Color", group=group1)

// EMA 2 settings
ema2LengthInput = input.int(100, title="Length", group=group2)
ema2Color  = input.color(color.yellow, title="Color", group=group2)

// EMA 3 settings
ema3LengthInput = input.int(200, title="Length", group=group3)
ema3Color  = input.color(color.blue, title="Color", group=group3)

// Apply preset logic - simple and direct
ema1Length = 0
ema2Length = 0
ema3Length = 0

if preset == "Scalper's Setup (9/21/55)"
    ema1Length := 9
    ema2Length := 21
    ema3Length := 55
else if preset == "Fibonacci Trio (8/13/21)"
    ema1Length := 8
    ema2Length := 13
    ema3Length := 21
else if preset == "Big Picture Scalp (13/50/200)"
    ema1Length := 13
    ema2Length := 50
    ema3Length := 200
else
    ema1Length := ema1LengthInput
    ema2Length := ema2LengthInput
    ema3Length := ema3LengthInput

// Preset Status Display
groupStatus = "Preset Status"
showStatus = input.bool(true, title="Show Active Preset Info", group=groupStatus)

var label presetStatusLabel = na

// compute EMAs using final lengths
ema1        = ta.ema(close, ema1Length)
ema2        = ta.ema(close, ema2Length)
ema3        = ta.ema(close, ema3Length)

// colour candles based on EMA 1 vs EMA 2 (plotcandle to color body, wick, border)
candleColor = showCandleColor ? (ema1 > ema2 ? bullColor : bearColor) : na
// overlay a matching candle shape so borders and wicks are colored as well
plotcandle(open, high, low, close,
     color=candleColor,
     wickcolor=candleColor,
     bordercolor=candleColor)

// Display preset info - update on every bar
if barstate.islast
    if showStatus
        presetName = preset
        tableText = presetName + "\nEMA 1: " + str.tostring(ema1Length) + "\nEMA 2: " + str.tostring(ema2Length) + "\nEMA 3: " + str.tostring(ema3Length)
        if na(presetStatusLabel)
            presetStatusLabel := label.new(bar_index, high, tableText, color=color.blue, style=label.style_label_down, textcolor=color.white, size=size.small)
        else
            label.set_xy(presetStatusLabel, bar_index, high)
            label.set_text(presetStatusLabel, tableText)
    else
        if not na(presetStatusLabel)
            label.delete(presetStatusLabel)
            presetStatusLabel := na

// Display toggles
showEMA1    = input.bool(true, title="Show EMA 1", group=groupDisplay)
showEMA2    = input.bool(true, title="Show EMA 2", group=groupDisplay)
showEMA3    = input.bool(true, title="Show EMA 3", group=groupDisplay)
showLabels  = input.bool(true, title="Show Price Labels", group=groupLabels)

// Plot EMAs
plot(showEMA1  ? ema1  : na, title="EMA 1",  color=ema1Color,  linewidth=1)
plot(showEMA2  ? ema2  : na, title="EMA 2",  color=ema2Color, linewidth=1)
plot(showEMA3  ? ema3  : na, title="EMA 3",  color=ema3Color, linewidth=1)

// EMA Price Labels Logic
var label l1  = na
var label l2  = na
var label l3  = na

update_ema_label(show, ema_val, ema_color, current_label) =>
    var label lb = current_label
    if show and not na(ema_val)
        if na(lb)
            lb := label.new(bar_index, ema_val, str.tostring(math.round(ema_val, 2)), 
                 color=ema_color, style=label.style_label_left, textcolor=color.white, size=size.small)
        else
            label.set_xy(lb, bar_index, ema_val)
            label.set_text(lb, str.tostring(math.round(ema_val, 2)))
            label.set_color(lb, ema_color)
    else
        if not na(lb)
            label.delete(lb)
            lb := na
    lb

l1 := update_ema_label(showLabels and showEMA1, ema1, ema1Color, l1)
l2 := update_ema_label(showLabels and showEMA2, ema2, ema2Color, l2)
l3 := update_ema_label(showLabels and showEMA3, ema3, ema3Color, l3)

// ==========================================
// Previous Candle Range (embedded)
// ==========================================
groupPrev = "Previous Range"
prev_len = input.int(14, "Length (previous candles)", minval=1, group=groupPrev)
showPrevTable = input.bool(true, "Show Range Table", group=groupPrev)
posPrev = input.string("Top Left", "Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group=groupPrev)
showAsPercentPrev = input.bool(false, "Show as % of price", group=groupPrev)

// Display customization for embedded panel
bgPrev = input.color(color.new(color.blue, 10), "Background Color", group=groupPrev)
txtPrev = input.color(color.white, "Text Color", group=groupPrev)
txtSizePrev = input.string("Normal", "Text Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=groupPrev)
showRangePrev = input.bool(true, "Show Range", group=groupPrev)
showTFPrev = input.bool(true, "Show Timeframe", group=groupPrev)
showLenPrev = input.bool(true, "Show Length", group=groupPrev)
// individual label text fields (so users can change the labels separately)
labelRangeHLTextPrev = input.string("HL Spread:", "HL Spread Label", group=groupPrev)
labelRangeTextPrev = input.string("Avg Range:", "Avg Range Label", group=groupPrev)
labelTFTextPrev    = input.string("TF:", "Timeframe Label", group=groupPrev)
labelLenTextPrev   = input.string("Len:", "Length Label", group=groupPrev)
showRangeHLPrev = input.bool(true, "Show Range HL", group=groupPrev)
showAsPercentRangeHLPrev = input.bool(false, "Show Range HL as % of price", group=groupPrev)

// Map position (if/else to avoid multiline ternary issues)
prev_table_pos = position.top_left
if posPrev == "Top Right"
    prev_table_pos := position.top_right
else if posPrev == "Bottom Left"
    prev_table_pos := position.bottom_left
else if posPrev == "Bottom Right"
    prev_table_pos := position.bottom_right
else
    prev_table_pos := position.top_left

// Persistent table for previous range
var table prevRangeTable = table.new(prev_table_pos, 1, 1)

// previous-candle range series (use closed previous candle: index 1)
prevRange = high[1] - low[1]

// average of previous 'prev_len' previous ranges (SMA)
avgRangePrev = ta.sma(prevRange, prev_len)

// Range HL: highest high and lowest low within prev_len period
highestHigh = ta.highest(high, prev_len)
lowestLow = ta.lowest(low, prev_len)
rangeHL = highestHigh - lowestLow

// optionally convert to percent of close price
avgDisplayPrev = showAsPercentPrev and not na(avgRangePrev) ? avgRangePrev / close * 100.0 : avgRangePrev
displayRangeHL = showAsPercentRangeHLPrev and not na(rangeHL) ? rangeHL / close * 100.0 : rangeHL

// formatted display value (rounded to 2 decimals)
displayTextValPrev = na(avgDisplayPrev) ? "n/a" : str.tostring(math.round(avgDisplayPrev * 100) / 100.0)
displayTextValRangeHL = na(displayRangeHL) ? "n/a" : str.tostring(math.round(displayRangeHL * 100) / 100.0)

// Build label text based on toggles or custom template
rangePartPrev = showRangePrev ? (displayTextValPrev + (showAsPercentPrev ? "%" : "")) : ""
rangeHLPartPrev = showRangeHLPrev ? (displayTextValRangeHL + (showAsPercentRangeHLPrev ? "%" : "")) : ""
// normalize timeframe label: append units (m/h/d) for clarity
tf_raw = timeframe.period
tf_low = str.lower(tf_raw)
tf_display = ""
if tf_low == ""
    tf_display := ""
else
    // if timeframe string already contains a letter, use it (lowercased)
    if str.contains(tf_low, "d") or str.contains(tf_low, "h") or str.contains(tf_low, "w") or str.contains(tf_low, "m")
        tf_display := tf_low
    else
        // numeric-only values are minutes
        tf_display := tf_raw + "m"

tfPartPrev = showTFPrev ? tf_display : ""
lenPartPrev = showLenPrev ? (str.tostring(prev_len)) : ""

labelTextPrev = ""
partsPrev = array.new_string()
if rangeHLPartPrev != ""
    array.push(partsPrev, labelRangeHLTextPrev + " " + rangeHLPartPrev)
if rangePartPrev != ""
    array.push(partsPrev, labelRangeTextPrev + " " + rangePartPrev)
if tfPartPrev != ""
    array.push(partsPrev, labelTFTextPrev + " " + tfPartPrev)
if lenPartPrev != ""
    array.push(partsPrev, labelLenTextPrev + " " + lenPartPrev)
for i = 0 to array.size(partsPrev) - 1
    labelTextPrev := labelTextPrev + (i == 0 ? "" : "\n") + array.get(partsPrev, i)

// map text size
prev_text_size = txtSizePrev == "Tiny" ? size.tiny : txtSizePrev == "Small" ? size.small : txtSizePrev == "Large" ? size.large : txtSizePrev == "Huge" ? size.huge : size.normal

// Update persistent table cell on last bar (including premarket)
if barstate.islast and showPrevTable
    table.cell(prevRangeTable, 0, 0, labelTextPrev, bgcolor=bgPrev, text_color=txtPrev, text_size=prev_text_size)
else
    table.clear(prevRangeTable, 0, 0, 0, 0)

// ==========================================
// OVERLAY MESSAGE SETTINGS & LOGIC
// ==========================================
var group_msg = "Message Settings"
i_text      = input.string("Strategy: BUY - CROSS - SELL (Fibonacci Trio Scalping), - Day Chart uptrend (Price above EMAs), - RSI Low, - At Discount, - At Support, - New HL, - Purple above Yellow BUY, - Purple cross Yellow SELL, - Use Blue as Stop Loss, - TP 25% of 1D Range", "Message Text", tooltip="Use the separator to create new lines", group=group_msg)
i_separator = input.string(",", "New Line Separator", tooltip="This character will be replaced by a carriage return", group=group_msg)
i_textColor = input.color(color.white, "Text Color", group=group_msg)
i_bgColor   = input.color(color.new(#2962ff, 20), "Background Color", group=group_msg)
i_textSize  = input.string("Normal", "Text Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=group_msg)

var group_pos = "Position Settings"
i_pos       = input.string("Bottom Left", "Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Center"], group=group_pos)

// Format text to support carriage returns
formatted_text = str.replace_all(i_text, i_separator, "\n")

// Map Table Position
table_pos = i_pos == "Top Right"    ? position.top_right :
     i_pos == "Top Left"     ? position.top_left :
     i_pos == "Bottom Right" ? position.bottom_right :
     i_pos == "Bottom Left"  ? position.bottom_left :
     i_pos == "Middle Right" ? position.middle_right : 
     position.middle_center

// Map Text Size
text_size = i_textSize == "Tiny"   ? size.tiny : 
     i_textSize == "Small"  ? size.small : 
     i_textSize == "Large"  ? size.large : 
     i_textSize == "Huge"   ? size.huge : 
     size.normal

// Initialize table
var table messageDisplay = table.new(table_pos, 1, 1)

// Render Table
if barstate.islast
    table.cell(messageDisplay, 0, 0, formatted_text, 
         bgcolor=i_bgColor, 
         text_color=i_textColor, 
         text_size=text_size,
         text_halign=text.align_left)
