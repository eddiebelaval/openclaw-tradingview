//@version=6
indicator("Best Moving Averages [Zofesu]", shorttitle="[Zofesu] Best MA", overlay=true)

// ========================================================================= //
// HELPER FUNCTIONS
// ========================================================================= //
ma_calc(src, len, ma_type) =>
    float result = na
    if ma_type == "SMA"
        result := ta.sma(src, len)
    else if ma_type == "EMA"
        result := ta.ema(src, len)
    else if ma_type == "HMA"
        result := ta.wma(2 * ta.wma(src, len / 2) - ta.wma(src, len), math.round(math.sqrt(len)))
    else if ma_type == "RMA"
        result := ta.rma(src, len)
    else if ma_type == "TMA"
        result := ta.sma(ta.sma(src, math.round(len / 2) + 1), math.round(len / 2) + 1)
    else if ma_type == "LSMA"
        result := ta.linreg(src, len, 0)
    else if ma_type == "DEMA"
        float e = ta.ema(src, len)
        result := 2 * e - ta.ema(e, len)
    else if ma_type == "TEMA"
        float e1 = ta.ema(src, len)
        float e2 = ta.ema(e1, len)
        float e3 = ta.ema(e2, len)
        result := 3 * e1 - 3 * e2 + e3
    result

ma_tooltip = "MA Type Guide:\n" +
  "SMA — Simple average. Slow, clear S/R levels. Best: 50/200 for trend.\n" +
  "EMA — Reacts faster to price. Best: 9/20 for momentum, 50 for trend.\n" +
  "HMA — Hull MA. Very fast, smooth. Best: scalping, short-term entries.\n" +
  "RMA — Wilder Smoothed MA. Used in RSI/ATR. Best: 14 for volatility.\n" +
  "TMA — Triangular MA. Double smoothed, very slow. Best: macro trend.\n" +
  "LSMA — Linear regression line. Best: trend direction + dynamic S/R.\n" +
  "DEMA — Double EMA. Less lag than EMA. Best: trend following entries.\n" +
  "TEMA — Triple EMA. Minimal lag. Best: fast trend + exit signals.\n" +
  "─────────────\n" +
  "Popular lengths:\n" +
  "9 = Short momentum | 20 = Swing baseline\n" +
  "50 = Medium trend  | 100/200 = Institutional\n" +
  "─────────────\n" +
  "Combinations:\n" +
  "5-8-13 = Scalping ribbon\n" +
  "9-21 = Pullback entries\n" +
  "20-50-200 = Full trend stack"

tf_tooltip = "Leave blank for chart timeframe. On higher timeframes stepped appearance is expected — this is standard MTF behavior in Pine Script."

// ========================================================================= //
// MA 1
// ========================================================================= //
grp1 = "MA 1"
ma1_on   = input.bool(true,    "Enable MA 1",  group=grp1)
ma1_type = input.string("EMA", "Type",         group=grp1, options=["SMA","EMA","HMA","RMA","TMA","LSMA","DEMA","TEMA"])
ma1_len  = input.int(5,       "Length",       group=grp1, minval=1, tooltip=ma_tooltip)
ma1_tf   = input.timeframe("", "Timeframe",    group=grp1, tooltip=tf_tooltip)
ma1_col  = input.color(color.new(#fffb00, 0),  "Color", group=grp1)
ma1_width= input.int(2,        "Width",        group=grp1, minval=1, maxval=5)
ma1_src  = input.source(close, "Source",       group=grp1)

// ========================================================================= //
// MA 2
// ========================================================================= //
grp2 = "MA 2"
ma2_on   = input.bool(true,    "Enable MA 2",  group=grp2)
ma2_type = input.string("EMA", "Type",         group=grp2, options=["SMA","EMA","HMA","RMA","TMA","LSMA","DEMA","TEMA"])
ma2_len  = input.int(8,       "Length",       group=grp2, minval=1, tooltip=ma_tooltip)
ma2_tf   = input.timeframe("", "Timeframe",    group=grp2, tooltip=tf_tooltip)
ma2_col  = input.color(color.new(#0066ff, 0),  "Color", group=grp2)
ma2_width= input.int(2,        "Width",        group=grp2, minval=1, maxval=5)
ma2_src  = input.source(close, "Source",       group=grp2)

// ========================================================================= //
// MA 3
// ========================================================================= //
grp3 = "MA 3"
ma3_on   = input.bool(true,    "Enable MA 3",  group=grp3)
ma3_type = input.string("EMA", "Type",         group=grp3, options=["SMA","EMA","HMA","RMA","TMA","LSMA","DEMA","TEMA"])
ma3_len  = input.int(13,      "Length",       group=grp3, minval=1, tooltip=ma_tooltip)
ma3_tf   = input.timeframe("", "Timeframe",    group=grp3, tooltip=tf_tooltip)
ma3_col  = input.color(color.new(#ff0000, 0),  "Color", group=grp3)
ma3_width= input.int(2,        "Width",        group=grp3, minval=1, maxval=5)
ma3_src  = input.source(close, "Source",       group=grp3)

// ========================================================================= //
// MA 4
// ========================================================================= //
grp4 = "MA 4"
ma4_on   = input.bool(true,   "Enable MA 4",  group=grp4)
ma4_type = input.string("RMA", "Type",         group=grp4, options=["SMA","EMA","HMA","RMA","TMA","LSMA","DEMA","TEMA"])
ma4_len  = input.int(200,       "Length",       group=grp4, minval=1, tooltip=ma_tooltip)
ma4_tf   = input.timeframe("", "Timeframe",    group=grp4, tooltip=tf_tooltip)
ma4_col  = input.color(color.new(#00a31b, 0),  "Color", group=grp4)
ma4_width= input.int(2,        "Width",        group=grp4, minval=1, maxval=5)
ma4_src  = input.source(close, "Source",       group=grp4)

// ========================================================================= //
// MA 5
// ========================================================================= //
grp5 = "MA 5"
ma5_on   = input.bool(false,   "Enable MA 5",  group=grp5)
ma5_type = input.string("LSMA","Type",         group=grp5, options=["SMA","EMA","HMA","RMA","TMA","LSMA","DEMA","TEMA"])
ma5_len  = input.int(50,       "Length",       group=grp5, minval=1, tooltip=ma_tooltip)
ma5_tf   = input.timeframe("", "Timeframe",    group=grp5, tooltip=tf_tooltip)
ma5_col  = input.color(color.new(#00BCD4, 0),  "Color", group=grp5)
ma5_width= input.int(2,        "Width",        group=grp5, minval=1, maxval=5)
ma5_src  = input.source(close, "Source",       group=grp5)

// ========================================================================= //
// MA 6
// ========================================================================= //
grp6 = "MA 6"
ma6_on   = input.bool(false,   "Enable MA 6",  group=grp6)
ma6_type = input.string("TEMA","Type",         group=grp6, options=["SMA","EMA","HMA","RMA","TMA","LSMA","DEMA","TEMA"])
ma6_len  = input.int(20,       "Length",       group=grp6, minval=1, tooltip=ma_tooltip)
ma6_tf   = input.timeframe("", "Timeframe",    group=grp6, tooltip=tf_tooltip)
ma6_col  = input.color(color.new(#4CAF50, 0),  "Color", group=grp6)
ma6_width= input.int(2,        "Width",        group=grp6, minval=1, maxval=5)
ma6_src  = input.source(close, "Source",       group=grp6)

// ========================================================================= //
// MA 7
// ========================================================================= //
grp7 = "MA 7"
ma7_on   = input.bool(false,   "Enable MA 7",  group=grp7)
ma7_type = input.string("DEMA","Type",         group=grp7, options=["SMA","EMA","HMA","RMA","TMA","LSMA","DEMA","TEMA"])
ma7_len  = input.int(20,       "Length",       group=grp7, minval=1, tooltip=ma_tooltip)
ma7_tf   = input.timeframe("", "Timeframe",    group=grp7, tooltip=tf_tooltip)
ma7_col  = input.color(color.new(#FF5722, 0),  "Color", group=grp7)
ma7_width= input.int(2,        "Width",        group=grp7, minval=1, maxval=5)
ma7_src  = input.source(close, "Source",       group=grp7)

// ========================================================================= //
// MA 8
// ========================================================================= //
grp8 = "MA 8"
ma8_on   = input.bool(false,   "Enable MA 8",  group=grp8)
ma8_type = input.string("RMA", "Type",         group=grp8, options=["SMA","EMA","HMA","RMA","TMA","LSMA","DEMA","TEMA"])
ma8_len  = input.int(14,       "Length",       group=grp8, minval=1, tooltip=ma_tooltip)
ma8_tf   = input.timeframe("", "Timeframe",    group=grp8, tooltip=tf_tooltip)
ma8_col  = input.color(color.new(#E91E63, 0),  "Color", group=grp8)
ma8_width= input.int(2,        "Width",        group=grp8, minval=1, maxval=5)
ma8_src  = input.source(close, "Source",       group=grp8)

// ========================================================================= //
// MA 9
// ========================================================================= //
grp9 = "MA 9"
ma9_on   = input.bool(false,   "Enable MA 9",  group=grp9)
ma9_type = input.string("TMA", "Type",         group=grp9, options=["SMA","EMA","HMA","RMA","TMA","LSMA","DEMA","TEMA"])
ma9_len  = input.int(20,       "Length",       group=grp9, minval=1, tooltip=ma_tooltip)
ma9_tf   = input.timeframe("", "Timeframe",    group=grp9, tooltip=tf_tooltip)
ma9_col  = input.color(color.new(#607D8B, 0),  "Color", group=grp9)
ma9_width= input.int(2,        "Width",        group=grp9, minval=1, maxval=5)
ma9_src  = input.source(close, "Source",       group=grp9)

// ========================================================================= //
// KELTNER CHANNEL
// ========================================================================= //
grpK = "Keltner Channel"
kc_on      = input.bool(false, "Enable Keltner Channel", group=grpK, tooltip="Keltner Channel: EMA midline ± ATR multiplier. Best for mean reversion and volatility-based entries.")
kc_len     = input.int(20,    "EMA Length",    group=grpK, minval=1)
kc_atr_len = input.int(10,    "ATR Length",    group=grpK, minval=1)
kc_mult    = input.float(2.0, "ATR Multiplier",group=grpK, minval=0.1, step=0.1)
kc_tf      = input.timeframe("","Timeframe",   group=grpK, tooltip=tf_tooltip)
kc_src     = input.source(close, "Source",     group=grpK)
kc_mid_col = input.color(color.new(#FFD700, 0),   "Midline Color",     group=grpK)
kc_up_col  = input.color(color.new(#FFD700, 70),  "Upper Band Color",  group=grpK)
kc_dn_col  = input.color(color.new(#FFD700, 70),  "Lower Band Color",  group=grpK)
kc_width   = input.int(1, "Width", group=grpK, minval=1, maxval=5)
kc_fill    = input.bool(true, "Fill Band", group=grpK)

kc_logic() =>
    float mid   = ta.ema(kc_src, kc_len)
    float atr   = ta.atr(kc_atr_len)
    float upper = mid + kc_mult * atr
    float lower = mid - kc_mult * atr
    [mid, upper, lower]

[kc_mid, kc_upper, kc_lower] = request.security(syminfo.tickerid, kc_tf, kc_logic(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// ========================================================================= //
// ALLIGATOR
// ========================================================================= //
grpA = "Alligator (Williams)"
ali_on      = input.bool(false, "Enable Alligator", group=grpA, tooltip="Williams Alligator: Smoothed MA on hl2. Jaw=13+8, Teeth=8+5, Lips=5+3. On higher MTF lines may appear stepped — this is expected behavior.")
ali_tf      = input.timeframe("", "Timeframe", group=grpA, tooltip=tf_tooltip)
ali_jaw_col = input.color(color.new(#2962FF, 0), "Jaw Color (slow)",  group=grpA)
ali_tee_col = input.color(color.new(#E91E63, 0), "Teeth Color (mid)", group=grpA)
ali_lip_col = input.color(color.new(#66BB6A, 0), "Lips Color (fast)", group=grpA)
ali_width   = input.int(1, "Width", group=grpA, minval=1, maxval=5)

smma(src, length) =>
    float s = 0.0
    s := na(s[1]) ? ta.sma(src, length) : (s[1] * (length - 1) + src) / length
    s

ali_jaw = request.security(syminfo.tickerid, ali_tf, smma(hl2, 13)[8], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
ali_tee = request.security(syminfo.tickerid, ali_tf, smma(hl2, 8)[5],  gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
ali_lip = request.security(syminfo.tickerid, ali_tf, smma(hl2, 5)[3],  gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// ========================================================================= //
// MTF CALCULATIONS
// ========================================================================= //
f_ma1 = request.security(syminfo.tickerid, ma1_tf, ma_calc(ma1_src, ma1_len, ma1_type), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
f_ma2 = request.security(syminfo.tickerid, ma2_tf, ma_calc(ma2_src, ma2_len, ma2_type), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
f_ma3 = request.security(syminfo.tickerid, ma3_tf, ma_calc(ma3_src, ma3_len, ma3_type), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
f_ma4 = request.security(syminfo.tickerid, ma4_tf, ma_calc(ma4_src, ma4_len, ma4_type), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
f_ma5 = request.security(syminfo.tickerid, ma5_tf, ma_calc(ma5_src, ma5_len, ma5_type), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
f_ma6 = request.security(syminfo.tickerid, ma6_tf, ma_calc(ma6_src, ma6_len, ma6_type), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
f_ma7 = request.security(syminfo.tickerid, ma7_tf, ma_calc(ma7_src, ma7_len, ma7_type), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
f_ma8 = request.security(syminfo.tickerid, ma8_tf, ma_calc(ma8_src, ma8_len, ma8_type), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
f_ma9 = request.security(syminfo.tickerid, ma9_tf, ma_calc(ma9_src, ma9_len, ma9_type), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// ========================================================================= //
// PLOT
// ========================================================================= //
plot(ma1_on ? f_ma1 : na, "MA 1", color=ma1_col, linewidth=ma1_width)
plot(ma2_on ? f_ma2 : na, "MA 2", color=ma2_col, linewidth=ma2_width)
plot(ma3_on ? f_ma3 : na, "MA 3", color=ma3_col, linewidth=ma3_width)
plot(ma4_on ? f_ma4 : na, "MA 4", color=ma4_col, linewidth=ma4_width)
plot(ma5_on ? f_ma5 : na, "MA 5", color=ma5_col, linewidth=ma5_width)
plot(ma6_on ? f_ma6 : na, "MA 6", color=ma6_col, linewidth=ma6_width)
plot(ma7_on ? f_ma7 : na, "MA 7", color=ma7_col, linewidth=ma7_width)
plot(ma8_on ? f_ma8 : na, "MA 8", color=ma8_col, linewidth=ma8_width)
plot(ma9_on ? f_ma9 : na, "MA 9", color=ma9_col, linewidth=ma9_width)

// Keltner Channel
kc_p_mid   = plot(kc_on ? kc_mid   : na, "KC Midline", color=kc_mid_col, linewidth=kc_width)
kc_p_upper = plot(kc_on ? kc_upper : na, "KC Upper",   color=kc_up_col,  linewidth=kc_width)
kc_p_lower = plot(kc_on ? kc_lower : na, "KC Lower",   color=kc_dn_col,  linewidth=kc_width)
fill(kc_p_upper, kc_p_lower, color=kc_fill and kc_on ? color.new(#FFD700, 90) : na, title="KC Fill")

// Alligator
plot(ali_on ? ali_jaw : na, "Alligator Jaw",   color=ali_jaw_col, linewidth=ali_width)
plot(ali_on ? ali_tee : na, "Alligator Teeth", color=ali_tee_col, linewidth=ali_width)
plot(ali_on ? ali_lip : na, "Alligator Lips",  color=ali_lip_col, linewidth=ali_width)
