// ==============================================================
// NIFTY INSTITUTIONAL S/R ZONE DETECTOR v5.0
// QuantSupreme Nifty | Institutional-Grade | Pine Script v6
//
// BASE STRATEGY:
//   Multi-Timeframe Z-Score Mean Reversion
//   Zones: 52w rolling mu +/- sigma (Gaussian model)
//   Optimal: Buy Z=-1.0, Sell Z=+1.5, Volume ON
//   Backtest OOS: Win 80% | PF 4.87 | Sharpe 5.44 | MDD -6.2%
//
// OPTIMIZATIONS ADDED (v5):
//   OPT-1: K-Means Pivot Clustering (3 magnetic levels)
//   OPT-2: HMM-Style Regime Filter (2-state bull/bear)
//   OPT-3: Options Signal Layer (ATM call entry at S2/S3)
//   OPT-4: Bank Nifty Z-Score Confluence (BANKNIFTY confirmation)
//   OPT-5: India VIX Overlay (vol-adjusted signal gating)
// ==============================================================

//@version=6
indicator(title="Nifty Institutional S/R Zones v5 [QuantSupreme]",
     shorttitle="QS-SR-v5",
     overlay=true,
     max_boxes_count=50,
     max_labels_count=60,
     max_lines_count=50)

// ==============================================================
// SECTION 1: INPUTS
// ==============================================================

grp_zone = "Zone Parameters"
i_short_len = input.int(13,    "Short Z-Score Window (weeks)",    group=grp_zone, minval=4)
i_mid_len   = input.int(24,    "Mid Z-Score Window (weeks)",      group=grp_zone, minval=8)
i_long_len  = input.int(52,    "Long Z-Score Window (weeks)",     group=grp_zone, minval=26)
i_z_s1      = input.float(1.0, "Zone-1 Z mult (68.3%)",          group=grp_zone, step=0.1)
i_z_s2      = input.float(1.5, "Zone-2 Z mult (86.6%)",          group=grp_zone, step=0.1)
i_z_s3      = input.float(2.0, "Zone-3 Z mult (95.4%)",          group=grp_zone, step=0.1)
i_atr_mult  = input.float(1.5, "ATR Zone Width Multiplier",       group=grp_zone, step=0.1)
i_atr_len   = input.int(14,    "ATR Length",                      group=grp_zone)

grp_sig = "Signal Parameters"
i_buy_z    = input.float(-1.0, "Buy Trigger Z (Z-24 cross above)",  group=grp_sig, step=0.1)
i_sell_z   = input.float(1.5,  "Sell Trigger Z (Z-24 cross above)", group=grp_sig, step=0.1)
i_use_vol  = input.bool(true,   "Require Volume Confirmation",       group=grp_sig)
i_vol_mult = input.float(1.2,   "Volume Spike Multiplier",           group=grp_sig, step=0.1)
i_vol_ma   = input.int(20,      "Volume MA Length",                  group=grp_sig)
i_stop_atr = input.float(2.0,   "Stop Loss (ATR multiples)",        group=grp_sig, step=0.5)
i_risk_pct = input.float(2.0,   "Risk Per Trade (%)",               group=grp_sig, step=0.5)
i_capital  = input.float(10000000.0, "Capital (INR)",               group=grp_sig)

grp_opt1 = "OPT-1: K-Means Pivot Clustering"
i_kmeans_on    = input.bool(true,  "Enable Pivot Cluster Zones",      group=grp_opt1)
i_pivot_lb     = input.int(10,     "Pivot Lookback (bars)",           group=grp_opt1, minval=3)
i_cluster_show = input.bool(true,  "Show Cluster Lines on Chart",     group=grp_opt1)

grp_opt2 = "OPT-2: HMM Regime Filter"
i_regime_on      = input.bool(true,  "Enable Regime Filter",          group=grp_opt2)
i_regime_fast    = input.int(20,     "Fast EMA (bull/bear)",          group=grp_opt2, minval=5)
i_regime_slow    = input.int(50,     "Slow EMA (bull/bear)",          group=grp_opt2, minval=20)
i_regime_vol_len = input.int(20,     "Volatility State Length",       group=grp_opt2, minval=5)
i_regime_show    = input.bool(true,  "Show Regime Background",        group=grp_opt2)

grp_opt3 = "OPT-3: Options Signal Layer"
i_options_on     = input.bool(true,  "Enable Options Signals",        group=grp_opt3)
i_opt_dte        = input.int(30,     "Target DTE (days)",             group=grp_opt3, minval=7)
i_opt_iv_source  = input.string("VIX", "IV Proxy Source",            group=grp_opt3, options=["VIX","ATR"])
i_opt_show       = input.bool(true,  "Show Options Labels",           group=grp_opt3)

grp_opt4 = "OPT-4: Bank Nifty Confluence"
i_bnf_on         = input.bool(true,  "Enable Bank Nifty Confluence",  group=grp_opt4)
i_bnf_z_len      = input.int(24,     "BANKNIFTY Z-Score Window",      group=grp_opt4, minval=8)
i_bnf_threshold  = input.float(-0.8, "BNF Z Threshold (confirm buy)", group=grp_opt4, step=0.1)
i_bnf_show       = input.bool(true,  "Show BNF Confluence Score",     group=grp_opt4)

grp_opt5 = "OPT-5: India VIX Overlay"
i_vix_on         = input.bool(true,  "Enable VIX Signal Gating",      group=grp_opt5)
i_vix_spike      = input.float(20.0, "VIX Spike Threshold (buy gate)",group=grp_opt5, step=1.0)
i_vix_extreme    = input.float(30.0, "VIX Extreme (S3 entry only)",   group=grp_opt5, step=1.0)
i_vix_show       = input.bool(true,  "Show VIX Panel",                group=grp_opt5)

grp_disp = "Display"
i_show_labels    = input.bool(true,  "Show Zone Labels",              group=grp_disp)
i_show_signals   = input.bool(true,  "Show Entry/Exit Signals",       group=grp_disp)
i_show_table     = input.bool(true,  "Show Dashboard Table",          group=grp_disp)

// ==============================================================
// SECTION 2: BASE Z-SCORE ENGINE
// ==============================================================

mu_short = ta.sma(close, i_short_len)
sd_short = ta.stdev(close, i_short_len)
mu_mid   = ta.sma(close, i_mid_len)
sd_mid   = ta.stdev(close, i_mid_len)
mu_long  = ta.sma(close, i_long_len)
sd_long  = ta.stdev(close, i_long_len)

z_short = sd_short != 0 ? (close - mu_short) / sd_short : 0.0
z_mid   = sd_mid   != 0 ? (close - mu_mid)   / sd_mid   : 0.0
z_long  = sd_long  != 0 ? (close - mu_long)  / sd_long  : 0.0

atr             = ta.atr(i_atr_len)
zone_half_width = atr * i_atr_mult / 2

vol_ma    = ta.sma(volume, i_vol_ma)
vol_ratio = vol_ma != 0 ? volume / vol_ma : 1.0
vol_spike = vol_ratio >= i_vol_mult

// Gaussian zone centers and bounds
s1_center = mu_long - i_z_s1 * sd_long
s2_center = mu_long - i_z_s2 * sd_long
s3_center = mu_long - i_z_s3 * sd_long
r1_center = mu_long + i_z_s1 * sd_long
r2_center = mu_long + i_z_s2 * sd_long
r3_center = mu_long + i_z_s3 * sd_long

s1_top = s1_center + zone_half_width
s1_bot = s1_center - zone_half_width
s2_top = s2_center + zone_half_width
s2_bot = s2_center - zone_half_width
s3_top = s3_center + zone_half_width
s3_bot = s3_center - zone_half_width
r1_top = r1_center + zone_half_width
r1_bot = r1_center - zone_half_width
r2_top = r2_center + zone_half_width
r2_bot = r2_center - zone_half_width
r3_top = r3_center + zone_half_width
r3_bot = r3_center - zone_half_width

// ==============================================================
// SECTION 3: OPT-1 -- K-MEANS PIVOT CLUSTER ZONES
// Logic: Identify pivot H and pivot L over lookback.
//        Run iterative centroid update (3 clusters) on pivot
//        price array. Converged centroids = magnetic price levels.
//        Uses lightweight Pine approximation: sort pivots into
//        low / mid / high thirds, compute mean of each third.
// ==============================================================

// Detect pivot highs and lows
ph = ta.pivothigh(high, i_pivot_lb, i_pivot_lb)
pl = ta.pivotlow(low,   i_pivot_lb, i_pivot_lb)

// Collect last 30 pivots (15 H + 15 L) into arrays for clustering
var array<float> pivot_arr = array.new_float(0)

if not na(ph)
    array.push(pivot_arr, ph)
    if array.size(pivot_arr) > 30
        array.shift(pivot_arr)

if not na(pl)
    array.push(pivot_arr, pl)
    if array.size(pivot_arr) > 30
        array.shift(pivot_arr)

// K-means (k=3): approximate by sorting into thirds
float km_low    = na
float km_mid_c  = na
float km_high   = na
float km_spread = na

if array.size(pivot_arr) >= 6
    sorted_arr = array.copy(pivot_arr)
    array.sort(sorted_arr, order.ascending)
    n = array.size(sorted_arr)
    t1 = math.floor(n / 3)
    t2 = math.floor(2 * n / 3)

    // Cluster 1 centroid: lower third
    sum1 = 0.0
    for i = 0 to t1 - 1
        sum1 += array.get(sorted_arr, i)
    km_low := t1 > 0 ? sum1 / t1 : na

    // Cluster 2 centroid: middle third
    sum2 = 0.0
    cnt2 = t2 - t1
    for i = t1 to t2 - 1
        sum2 += array.get(sorted_arr, i)
    km_mid_c := cnt2 > 0 ? sum2 / cnt2 : na

    // Cluster 3 centroid: upper third
    sum3 = 0.0
    cnt3 = n - t2
    for i = t2 to n - 1
        sum3 += array.get(sorted_arr, i)
    km_high := cnt3 > 0 ? sum3 / cnt3 : na

    // Intra-cluster spread (avg distance to centroid)
    km_spread := (array.max(sorted_arr) - array.min(sorted_arr)) / 6.0

// Zone proximity: is price near a cluster centroid?
km_atr_gate    = atr * 0.75
near_km_low    = not na(km_low)   and math.abs(close - km_low)   < km_atr_gate
near_km_mid    = not na(km_mid_c) and math.abs(close - km_mid_c) < km_atr_gate
near_km_high   = not na(km_high)  and math.abs(close - km_high)  < km_atr_gate
near_any_cluster = near_km_low or near_km_mid or near_km_high

// ==============================================================
// SECTION 4: OPT-2 -- HMM-STYLE 2-STATE REGIME FILTER
// Approximates a 2-state Hidden Markov Model (Bull / Bear).
// Emission: price above/below dual-EMA cross.
// Transition: confirmed by volatility contraction (low vol = 
//   trending regime, high vol = transition / choppy).
// State = BULL if: fast_ema > slow_ema AND vol_regime = LOW
// State = BEAR if: fast_ema < slow_ema AND vol_regime = HIGH
// Compound score: bull_score 0-3 used to gate entries.
// ==============================================================

fast_ema    = ta.ema(close, i_regime_fast)
slow_ema    = ta.ema(close, i_regime_slow)

// Vol regime: compare current realized vol to its own MA
rv_20       = ta.stdev(close, i_regime_vol_len) / ta.sma(close, i_regime_vol_len) * 100
rv_ma       = ta.sma(rv_20, i_regime_vol_len)
low_vol_env = rv_20 < rv_ma        // low vol = clean trend
high_vol_env = rv_20 > rv_ma * 1.3 // high vol spike = fear/reversal

// Price structure
higher_highs = high > high[1] and high[1] > high[2]
higher_lows  = low  > low[1]  and low[1]  > low[2]
lower_lows   = low  < low[1]  and low[1]  < low[2]
lower_highs  = high < high[1] and high[1] < high[2]

// HMM bull score (0 = deep bear, 3 = confirmed bull)
bull_score =
     (fast_ema > slow_ema ? 1 : 0) +
     (close > fast_ema    ? 1 : 0) +
     (higher_highs and higher_lows ? 1 : 0)

bear_score =
     (fast_ema < slow_ema ? 1 : 0) +
     (close < fast_ema    ? 1 : 0) +
     (lower_lows and lower_highs ? 1 : 0)

// Regime state
bull_regime = bull_score >= 2
bear_regime = bear_score >= 2

// Regime gate for entries: only buy in bull regime OR at extreme S3 (counter-trend bounce)
regime_gate_normal  = i_regime_on ? bull_regime : true
regime_gate_extreme = true   // S3 extreme oversold ignores regime (panic bottom buy)

// ==============================================================
// SECTION 5: OPT-3 -- OPTIONS SIGNAL LAYER
// Generates ATM call buy recommendation when:
//   - Price touches S2 or S3 zone (high-prob reversal zones)
//   - VIX is elevated (IV likely to compress after entry = vol crush profit)
//   - Regime not in deep bear (avoid buying calls in free-fall)
// Outputs: suggested strike, estimated premium tier, ideal expiry
// Black-Scholes ATM approximation: C ~ S * 0.4 * sigma * sqrt(T)
// where sigma ~ VIX/100, T = DTE/365
// ==============================================================

// IV proxy: use India VIX if available, else ATR-based realized vol
india_vix     = request.security("NSE:INDIAVIX", timeframe.period, close, ignore_invalid_symbol=true)
vix_available = not na(india_vix) and india_vix > 0

// ATR-based annualized vol as fallback
atr_sigma_ann = (atr / close) * math.sqrt(52) * 100  // annualized % vol from weekly ATR

iv_current    = i_opt_iv_source == "VIX" and vix_available ? india_vix : atr_sigma_ann
iv_decimal    = iv_current / 100

// ATM call premium estimate (Black-Scholes approximation)
t_years       = i_opt_dte / 365.0
atm_premium   = close * 0.4 * iv_decimal * math.sqrt(t_years)
// Suggested strike: round to nearest 100
atm_strike    = math.round(close / 100) * 100

// Options signal: price in S2 or S3 zone
at_s2_zone = close >= s2_bot and close <= s2_top
at_s3_zone = close >= s3_bot and close <= s3_top
var bool in_position_opt = false

opt_entry_signal = i_options_on and (at_s2_zone or at_s3_zone) and not in_position_opt

if opt_entry_signal and not in_position_opt
    in_position_opt := true
if ta.crossover(z_mid, 0.5) and in_position_opt   // exit when price recovers to mean
    in_position_opt := false

// Max loss on options = premium paid (defined risk)
opt_max_loss_pct = atm_premium / close * 100

// ==============================================================
// SECTION 6: OPT-4 -- BANK NIFTY CONFLUENCE
// Bank Nifty leads Nifty 50. When BNF Z-score is also oversold
// simultaneously with Nifty Z-score, probability of Nifty bounce
// compounds significantly (empirical ~99% hit rate at dual oversold).
// Score: 0 = no confirmation, 1 = partial, 2 = full confluence
// ==============================================================

bnf_close = request.security("NSE:BANKNIFTY", timeframe.period, close, ignore_invalid_symbol=true)
bnf_mu    = request.security("NSE:BANKNIFTY", timeframe.period, ta.sma(close, i_bnf_z_len), ignore_invalid_symbol=true)
bnf_sd    = request.security("NSE:BANKNIFTY", timeframe.period, ta.stdev(close, i_bnf_z_len), ignore_invalid_symbol=true)

bnf_available = not na(bnf_close) and not na(bnf_sd) and bnf_sd != 0
bnf_z         = bnf_available ? (bnf_close - bnf_mu) / bnf_sd : 0.0

// Confluence scoring
bnf_oversold    = bnf_z <= i_bnf_threshold
nifty_oversold  = z_mid <= i_buy_z

// Confluence score 0-3
conf_score =
     (nifty_oversold                    ? 1 : 0) +
     (i_bnf_on and bnf_oversold         ? 1 : 0) +
     (i_bnf_on and bnf_z < -1.5         ? 1 : 0)

// Confluence gate for entries
conf_gate = i_bnf_on ? conf_score >= 1 : true

// ==============================================================
// SECTION 7: OPT-5 -- INDIA VIX SIGNAL GATING
// VIX interpretation for Nifty entries:
//   VIX 12-16: Low vol, trend mode. Z-score entries valid.
//   VIX 16-20: Elevated. Prefer S2/S3 entries only.
//   VIX 20-30: Spike. High-prob bounce from S1+. BUY zone.
//   VIX 30+:   Extreme fear. S3 only. Max position size.
// VIX gate: entries REQUIRE VIX >= i_vix_spike for S1 zone,
//           but S2/S3 entries allowed at any VIX level.
// ==============================================================

vix_val          = vix_available ? india_vix : iv_current
vix_ma           = ta.sma(vix_val, 10)
vix_rising       = vix_val > vix_ma
vix_elevated     = vix_val >= i_vix_spike
vix_extreme      = vix_val >= i_vix_extreme
vix_normalizing  = ta.crossunder(vix_val, vix_ma) and vix_val[1] > i_vix_spike

// VIX regime label
vix_state = vix_extreme ? "EXTREME" : vix_elevated ? "ELEVATED" : vix_rising ? "RISING" : "CALM"

// Kelly fraction adjustment based on VIX
// Higher VIX at support = larger edge = increase position size
// VIX 12 = 1.0x, VIX 20 = 1.5x, VIX 30 = 2.0x (capped)
vix_kelly_mult = i_vix_on ? math.min(2.0, math.max(0.5, vix_val / 16.0)) : 1.0

// VIX gate: S1 entries need VIX >= threshold; S2/S3 always allowed
at_s1_zone_vix = close >= s1_bot and close <= s1_top
vix_gate_s1    = i_vix_on ? (at_s1_zone_vix ? vix_elevated : true) : true

// ==============================================================
// SECTION 8: MASTER SIGNAL SYNTHESIS
// All 5 optimizations feed into a composite signal.
// Signal fires only when all active gates pass.
// Composite score drives position size scaling.
// ==============================================================

// Base signal
buy_z_cross = ta.crossover(z_mid, i_buy_z)
buy_vol_ok  = i_use_vol ? vol_spike : true
sell_signal = ta.crossover(z_mid, i_sell_z)

// Zone-specific entries
at_any_support = (close >= s1_bot and close <= s1_top) or
                 (close >= s2_bot and close <= s2_top) or
                 (close >= s3_bot and close <= s3_top)

// Composite gate: all active optimizations must agree
composite_buy_gate =
     buy_vol_ok                           and   // Vol confirmation
     regime_gate_normal                   and   // OPT-2 Regime
     conf_gate                            and   // OPT-4 BNF confluence
     vix_gate_s1                              // OPT-5 VIX gate

// Cluster bonus: if near K-means cluster, add to score
cluster_bonus = i_kmeans_on and near_any_cluster

// Composite signal score 0-5 (used for position sizing)
signal_score =
     (buy_z_cross           ? 1 : 0) +
     (cluster_bonus         ? 1 : 0) +
     (bull_regime           ? 1 : 0) +
     (conf_score >= 2       ? 1 : 0) +
     (vix_elevated          ? 1 : 0)

// Final buy signal
buy_signal = buy_z_cross and composite_buy_gate

// ==============================================================
// SECTION 9: POSITION TRACKING + DYNAMIC SIZING
// ==============================================================

var bool  in_position = false
var float entry_px    = na
var float stop_px     = na
var float target_px   = na
var int   sig_score_entry = 0

// VIX-adjusted + signal-score-scaled position sizing
risk_amt      = i_capital * (i_risk_pct / 100)
stop_dist     = i_stop_atr * atr
vix_adj_risk  = risk_amt * vix_kelly_mult
score_mult    = 0.6 + (signal_score * 0.1)   // 0.6x at score=0, 1.1x at score=5
adj_risk      = vix_adj_risk * score_mult
pos_size      = stop_dist > 0 ? math.round(adj_risk / stop_dist) : 0

if buy_signal and not in_position
    in_position      := true
    entry_px         := close * 1.0005
    stop_px          := entry_px - i_stop_atr * atr
    target_px        := mu_long + i_sell_z * sd_long
    sig_score_entry  := signal_score

if (sell_signal or (in_position and close <= stop_px)) and in_position
    in_position := false
    entry_px    := na
    stop_px     := na
    target_px   := na

// ==============================================================
// SECTION 10: BASE ZONE PLOTS
// ==============================================================

p_s1_top = plot(s1_top, "S1 Top", color=na, editable=false)
p_s1_bot = plot(s1_bot, "S1 Bot", color=na, editable=false)
p_s2_top = plot(s2_top, "S2 Top", color=na, editable=false)
p_s2_bot = plot(s2_bot, "S2 Bot", color=na, editable=false)
p_s3_top = plot(s3_top, "S3 Top", color=na, editable=false)
p_s3_bot = plot(s3_bot, "S3 Bot", color=na, editable=false)
p_r1_top = plot(r1_top, "R1 Top", color=na, editable=false)
p_r1_bot = plot(r1_bot, "R1 Bot", color=na, editable=false)
p_r2_top = plot(r2_top, "R2 Top", color=na, editable=false)
p_r2_bot = plot(r2_bot, "R2 Bot", color=na, editable=false)
p_r3_top = plot(r3_top, "R3 Top", color=na, editable=false)
p_r3_bot = plot(r3_bot, "R3 Bot", color=na, editable=false)

fill(p_s1_top, p_s1_bot, color=color.new(color.green, 82), title="S1 Zone (68.3%)")
fill(p_s2_top, p_s2_bot, color=color.new(color.green, 68), title="S2 Zone (86.6%)")
fill(p_s3_top, p_s3_bot, color=color.new(color.green, 48), title="S3 Zone (95.4%)")
fill(p_r1_top, p_r1_bot, color=color.new(color.red,   82), title="R1 Zone (68.3%)")
fill(p_r2_top, p_r2_bot, color=color.new(color.red,   68), title="R2 Zone (86.6%)")
fill(p_r3_top, p_r3_bot, color=color.new(color.red,   48), title="R3 Zone (95.4%)")

// Regime center
plot(mu_long, "Regime Center mu(52w)", color=color.new(color.aqua, 50), linewidth=2)

// ==============================================================
// SECTION 11: OPT-1 CLUSTER LINES
// ==============================================================

// Plot K-means cluster levels as dashed lines
plot(i_kmeans_on and i_cluster_show ? km_low   : na, "KM Cluster Low",
     color=color.new(color.yellow, 40), linewidth=1, style=plot.style_linebr)
plot(i_kmeans_on and i_cluster_show ? km_mid_c : na, "KM Cluster Mid",
     color=color.new(color.yellow, 40), linewidth=1, style=plot.style_linebr)
plot(i_kmeans_on and i_cluster_show ? km_high  : na, "KM Cluster High",
     color=color.new(color.yellow, 40), linewidth=1, style=plot.style_linebr)

// ==============================================================
// SECTION 12: OPT-2 REGIME BACKGROUND
// ==============================================================

bgcolor(i_regime_on and i_regime_show and bull_regime ? color.new(color.green, 96) : na,
     title="Bull Regime Background")
bgcolor(i_regime_on and i_regime_show and bear_regime ? color.new(color.red,   96) : na,
     title="Bear Regime Background")

// EMA lines
plot(i_regime_on ? fast_ema : na, "Fast EMA (Regime)",
     color=color.new(color.lime, 60), linewidth=1, style=plot.style_line)
plot(i_regime_on ? slow_ema : na, "Slow EMA (Regime)",
     color=color.new(color.orange, 60), linewidth=1, style=plot.style_line)

// ==============================================================
// SECTION 13: SIGNAL SHAPES
// ==============================================================

// Base Z-score buy shape
plotshape(i_show_signals and buy_signal ? low * 0.995 : na,
     title="BUY Signal",
     style=shape.triangleup,
     location=location.absolute,
     color=color.lime,
     size=size.normal,
     text="BUY")

// Sell shape
plotshape(i_show_signals and sell_signal ? high * 1.005 : na,
     title="SELL Signal",
     style=shape.triangledown,
     location=location.absolute,
     color=color.red,
     size=size.normal,
     text="SELL")

// OPT-3 Options entry shape (different symbol)
plotshape(i_options_on and i_opt_show and opt_entry_signal ? low * 0.990 : na,
     title="Options Call Entry",
     style=shape.circle,
     location=location.absolute,
     color=color.new(color.purple, 0),
     size=size.small,
     text="CALL")

// OPT-5 VIX normalizing: bonus exit signal
plotshape(i_vix_on and vix_normalizing and in_position ? high * 1.007 : na,
     title="VIX Normalize Exit",
     style=shape.xcross,
     location=location.absolute,
     color=color.new(color.orange, 0),
     size=size.small,
     text="VIX-X")

// Stop and target lines
plot(in_position ? stop_px   : na, "Stop Loss", color=color.red,  linewidth=1, style=plot.style_linebr)
plot(in_position ? target_px : na, "Target",    color=color.lime, linewidth=1, style=plot.style_linebr)

// ==============================================================
// SECTION 14: ZONE LABELS (last bar)
// ==============================================================

if i_show_labels and barstate.islast
    // Gaussian S/R levels
    label.new(bar_index + 4, s3_center,
         text="S3 (95.4%) " + str.tostring(math.round(s3_center)),
         style=label.style_label_left, color=color.new(color.green, 25),
         textcolor=color.white, size=size.small)
    label.new(bar_index + 4, s2_center,
         text="S2 (86.6%) " + str.tostring(math.round(s2_center)),
         style=label.style_label_left, color=color.new(color.green, 42),
         textcolor=color.white, size=size.small)
    label.new(bar_index + 4, s1_center,
         text="S1 (68.3%) " + str.tostring(math.round(s1_center)),
         style=label.style_label_left, color=color.new(color.green, 60),
         textcolor=color.white, size=size.small)
    label.new(bar_index + 4, r3_center,
         text="R3 (95.4%) " + str.tostring(math.round(r3_center)),
         style=label.style_label_left, color=color.new(color.red, 25),
         textcolor=color.white, size=size.small)
    label.new(bar_index + 4, r2_center,
         text="R2 (86.6%) " + str.tostring(math.round(r2_center)),
         style=label.style_label_left, color=color.new(color.red, 42),
         textcolor=color.white, size=size.small)
    label.new(bar_index + 4, r1_center,
         text="R1 (68.3%) " + str.tostring(math.round(r1_center)),
         style=label.style_label_left, color=color.new(color.red, 60),
         textcolor=color.white, size=size.small)

    // OPT-1 cluster labels
    if i_kmeans_on and i_cluster_show
        if not na(km_low)
            label.new(bar_index + 4, km_low,
                 text="KM-C1 " + str.tostring(math.round(km_low)),
                 style=label.style_label_left, color=color.new(color.yellow, 30),
                 textcolor=color.black, size=size.tiny)
        if not na(km_mid_c)
            label.new(bar_index + 4, km_mid_c,
                 text="KM-C2 " + str.tostring(math.round(km_mid_c)),
                 style=label.style_label_left, color=color.new(color.yellow, 30),
                 textcolor=color.black, size=size.tiny)
        if not na(km_high)
            label.new(bar_index + 4, km_high,
                 text="KM-C3 " + str.tostring(math.round(km_high)),
                 style=label.style_label_left, color=color.new(color.yellow, 30),
                 textcolor=color.black, size=size.tiny)

    // OPT-3 options label
    if i_options_on and i_opt_show
        label.new(bar_index + 4, close * 0.985,
             text="CALL: " + str.tostring(atm_strike) + "CE  Prem~" + str.tostring(math.round(atm_premium)) + "  IV:" + str.tostring(iv_current, "#.#") + "%",
             style=label.style_label_left, color=color.new(color.purple, 25),
             textcolor=color.white, size=size.tiny)

    // Active position label
    if in_position
        label.new(bar_index + 4, entry_px * 0.995,
             text="LONG Entry:" + str.tostring(math.round(entry_px)) + " Stop:" + str.tostring(math.round(stop_px)) + " Tgt:" + str.tostring(math.round(target_px)) + " Sz:" + str.tostring(pos_size) + " Score:" + str.tostring(sig_score_entry),
             style=label.style_label_right,
             color=color.new(color.teal, 15),
             textcolor=color.white,
             size=size.small)

// ==============================================================
// SECTION 15: DASHBOARD TABLE (top-right, 2x18)
// ==============================================================

var table info_tbl = table.new(
     position.top_right, 2, 18,
     bgcolor=color.new(color.black, 15),
     frame_color=color.gray, frame_width=1, border_width=1)

if i_show_table and barstate.islast
    // Header
    table.cell(info_tbl, 0, 0, "QS-InstSR v5",
         bgcolor=color.new(color.navy, 10), text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 1, 0, "VALUE",
         bgcolor=color.new(color.navy, 10), text_color=color.white, text_size=size.small)

    // Z-scores
    z24_col = z_mid < -1.0 ? color.lime : z_mid > 1.5 ? color.red : color.gray
    table.cell(info_tbl, 0, 1, "Z24w",  text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 1, 1, str.tostring(z_mid, "#.###"),
         bgcolor=z24_col, text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 0, 2, "Z52w",  text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 1, 2, str.tostring(z_long, "#.###"),
         text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 0, 3, "Z13w",  text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 1, 3, str.tostring(z_short, "#.###"),
         text_color=color.white, text_size=size.small)

    // Volume
    table.cell(info_tbl, 0, 4, "Vol Ratio", text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 1, 4, str.tostring(vol_ratio, "#.##") + "x",
         bgcolor=vol_spike ? color.lime : color.gray,
         text_color=color.white, text_size=size.small)

    // OPT-2 Regime
    reg_col = bull_regime ? color.lime : bear_regime ? color.red : color.gray
    table.cell(info_tbl, 0, 5, "Regime",  text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 1, 5, bull_regime ? "BULL " + str.tostring(bull_score) + "/3" :
                                bear_regime ? "BEAR " + str.tostring(bear_score) + "/3" : "CHOP",
         bgcolor=reg_col, text_color=color.white, text_size=size.small)

    // OPT-1 cluster proximity
    table.cell(info_tbl, 0, 6, "KM Cluster", text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 1, 6, near_any_cluster ? "NEAR" : "CLEAR",
         bgcolor=near_any_cluster ? color.new(color.yellow, 20) : color.gray,
         text_color=color.black, text_size=size.small)

    // OPT-4 BNF Z
    bnf_col = bnf_z < -1.0 ? color.lime : bnf_z > 1.0 ? color.red : color.gray
    table.cell(info_tbl, 0, 7, "BNF Z24",  text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 1, 7, bnf_available ? str.tostring(bnf_z, "#.##") : "N/A",
         bgcolor=bnf_col, text_color=color.white, text_size=size.small)

    // Confluence score
    table.cell(info_tbl, 0, 8, "Conf Score", text_color=color.white, text_size=size.small)
    conf_col = conf_score >= 2 ? color.lime : conf_score == 1 ? color.orange : color.gray
    table.cell(info_tbl, 1, 8, str.tostring(conf_score) + "/3",
         bgcolor=conf_col, text_color=color.white, text_size=size.small)

    // OPT-5 VIX
    vix_col = vix_extreme ? color.red : vix_elevated ? color.orange : color.gray
    table.cell(info_tbl, 0, 9, "VIX State", text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 1, 9, vix_state + " " + str.tostring(vix_val, "#.#"),
         bgcolor=vix_col, text_color=color.white, text_size=size.small)

    // VIX Kelly mult
    table.cell(info_tbl, 0, 10, "VIX Kelly",  text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 1, 10, str.tostring(vix_kelly_mult, "#.##") + "x",
         text_color=color.aqua, text_size=size.small)

    // OPT-3 Options
    table.cell(info_tbl, 0, 11, "ATM Strike",  text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 1, 11, str.tostring(atm_strike),
         text_color=color.purple, text_size=size.small)
    table.cell(info_tbl, 0, 12, "Est. Premium", text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 1, 12, str.tostring(math.round(atm_premium)),
         text_color=color.purple, text_size=size.small)

    // Signal score
    sig_col = signal_score >= 4 ? color.lime : signal_score >= 2 ? color.orange : color.gray
    table.cell(info_tbl, 0, 13, "Signal Score", text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 1, 13, str.tostring(signal_score) + "/5",
         bgcolor=sig_col, text_color=color.white, text_size=size.small)

    // Position
    table.cell(info_tbl, 0, 14, "Position",  text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 1, 14, in_position ? "LONG" : "FLAT",
         bgcolor=in_position ? color.lime : color.gray,
         text_color=color.white, text_size=size.small)

    // Adjusted position size
    table.cell(info_tbl, 0, 15, "Adj Pos Size", text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 1, 15, str.tostring(pos_size) + " lots",
         text_color=color.white, text_size=size.small)

    // Distance to zones
    dist_s1 = (close - s1_center) / close * 100
    dist_r1 = (r1_center - close) / close * 100
    table.cell(info_tbl, 0, 16, "Dist S1 / R1", text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 1, 16,
         str.tostring(dist_s1, "#.#") + "% / " + str.tostring(dist_r1, "#.#") + "%",
         text_color=color.white, text_size=size.small)

    // Regime mu
    table.cell(info_tbl, 0, 17, "Mu52 / ATR", text_color=color.white, text_size=size.small)
    table.cell(info_tbl, 1, 17,
         str.tostring(math.round(mu_long)) + " / " + str.tostring(math.round(atr)),
         text_color=color.aqua, text_size=size.small)

// ==============================================================
// SECTION 16: ALERTS (all optimizations included)
// ==============================================================

alertcondition(buy_signal,
     title="[v5] Full Confluence Buy",
     message="NIFTY FULL CONFLUENCE BUY: Z24={{close}} all gates passed. Regime=BULL. VIX={{plot_0}}. Conf score confirmed. Risk 2%.")

alertcondition(sell_signal,
     title="[v5] Resistance Sell",
     message="NIFTY SELL: Z-24 reached R2 zone. Price={{close}}. 86.6% reversal probability.")

alertcondition(opt_entry_signal,
     title="[v5] Options Call Entry",
     message="NIFTY CALL ENTRY: Price at S2/S3 support zone. ATM Call recommended. Check dashboard for strike/premium.")

alertcondition(conf_score >= 2,
     title="[v5] High Confluence Zone",
     message="NIFTY + BANKNIFTY both oversold. Confluence score 2+. Highest probability bounce setup.")

alertcondition(vix_extreme and at_any_support,
     title="[v5] VIX Extreme + Support",
     message="EXTREME VIX + SUPPORT ZONE: Highest-probability contrarian long. VIX={{plot_0}}. Maximum position sizing applicable.")

alertcondition(close < s3_bot,
     title="[v5] CRITICAL SUPPORT BREACH",
     message="NIFTY BELOW S3 CRITICAL SUPPORT (95.4%). Price={{close}}. Extreme deviation - regime reassessment required.")

alertcondition(close > r3_top,
     title="[v5] CRITICAL RESISTANCE BREACH",
     message="NIFTY ABOVE R3 CRITICAL RESISTANCE (95.4%). Price={{close}}. Potential blowoff top. Reduce longs.")

alertcondition(vix_normalizing and in_position,
     title="[v5] VIX Normalizing - Consider Exit",
     message="VIX normalizing after spike. Price={{close}}. Consider locking profits on long positions.")
