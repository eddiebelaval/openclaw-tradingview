//@version=5
indicator("TrendStretch Strips (Boxed)", overlay=true)

//──────────────────────────────────────────────────────────────────────────────
// Layout
//──────────────────────────────────────────────────────────────────────────────
groupLayout = "Layout"
posOpt  = input.string("Top Right", "Placement", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=groupLayout)
txtSize = input.string("Small", "Text size", options=["Tiny","Small","Normal","Large"], group=groupLayout)

// Toggles
groupTog = "Toggles"
showMinerviniTiles = input.bool(false, "Show Minervini strip (MT1–MT7)", group=groupTog)

//──────────────────────────────────────────────────────────────────────────────
// MAs
//──────────────────────────────────────────────────────────────────────────────
groupMA = "Moving Averages"
lenE1   = input.int(8,   "EMA 8",  minval=1, group=groupMA)
lenE2   = input.int(21,  "EMA 21", minval=1, group=groupMA)
lenE3   = input.int(50,  "EMA 50", minval=1, group=groupMA)
lenS200 = input.int(200, "SMA 200", minval=1, group=groupMA)

//──────────────────────────────────────────────────────────────────────────────
// MA % Distance Banding (editable)
//──────────────────────────────────────────────────────────────────────────────
groupBands = "MA % Distance Banding"
bandDeepBelowMax   = input.float(-2.0, "Deep-below max (<=)", step=0.1, group=groupBands)
bandSlightBelowMax = input.float( 0.0, "Slight-below max (<)", step=0.1, group=groupBands)
bandSlightAboveMax = input.float( 2.0, "Slight-above max (<)", step=0.1, group=groupBands)

colStrongAbove = input.color(color.rgb(46, 204, 113), "Strong Above", group=groupBands)
colSlightAbove = input.color(color.rgb(241, 196, 15), "Slight Above", group=groupBands)
colSlightBelow = input.color(color.rgb(241, 196, 15), "Slight Below", group=groupBands)
colDeepBelow   = input.color(color.rgb(241, 196, 15), "Deep Below", group=groupBands)

bgAlpha = input.int(0, "Tile transparency (0=solid)", minval=0, maxval=90, group=groupBands)

//──────────────────────────────────────────────────────────────────────────────
// Stats (Daily-based)
//──────────────────────────────────────────────────────────────────────────────
groupStats = "Stats (Daily-based)"
atrLen = input.int(14, "Daily ATR length", minval=1, group=groupStats)
adrLen = input.int(20, "ADR length (days)", minval=1, group=groupStats)

dtrGood = input.float(100.0, "DTR/ATR Good (>= %)", step=1, group=groupStats)
dtrMid  = input.float(70.0,  "DTR/ATR Mid (>= %)", step=1, group=groupStats)

adrGood = input.float(3.0,  "ADR% Good (>=)", step=0.1, group=groupStats)
adrMid  = input.float(1.5,  "ADR% Mid (>=)", step=0.1, group=groupStats)

lodGood = input.float(50.0, "LoD %ATR Good (>=)", step=1, group=groupStats)
lodMid  = input.float(25.0, "LoD %ATR Mid (>=)", step=1, group=groupStats)

colGood = input.color(color.rgb(46, 204, 113), "Good", group=groupStats)
colMid  = input.color(color.rgb(241, 196, 15), "Mid", group=groupStats)
colBad  = input.color(color.rgb(231, 76, 60),  "Bad", group=groupStats)
colNA   = input.color(color.rgb(120,120,120), "NA", group=groupStats)

// Tile text
groupStyle = "Style"
textCol = input.color(color.black, "Tile text color", group=groupStyle)

// Box styling (white outlines)
boxCol   = input.color(color.white, "Box line color", group=groupStyle)
boxWidth = input.int(1, "Box line width", minval=1, maxval=4, group=groupStyle)

//──────────────────────────────────────────────────────────────────────────────
// Minervini
//──────────────────────────────────────────────────────────────────────────────
groupMin = "Minervini"
rsManual = input.int(0, "Optional IBD RS Rating (0 = N/A)", minval=0, maxval=99, group=groupMin)
rsMin    = input.int(70, "RS threshold", minval=1, maxval=99, group=groupMin)

//──────────────────────────────────────────────────────────────────────────────
// Helpers
//──────────────────────────────────────────────────────────────────────────────
f_posFromOpt(_opt) =>
    switch _opt
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right

f_sizeFromOpt(_opt) =>
    switch _opt
        "Tiny"   => size.tiny
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

f_distPct(_src, _ma) => (_src / _ma - 1.0) * 100.0

f_maBandColor(_pct) =>
    e1 = bandDeepBelowMax
    e2 = bandSlightBelowMax
    e3 = bandSlightAboveMax
    lo1 = math.min(e1, e2)
    hi1 = math.max(e1, e2)
    lo2 = math.min(hi1, e3)
    hi2 = math.max(hi1, e3)
    _pct <= lo1 ? colDeepBelow : _pct < lo2 ? colSlightBelow : _pct < hi2 ? colSlightAbove : colStrongAbove

f_statColor(_v, _good, _mid) =>
    na(_v) ? colNA : (_v >= _good ? colGood : _v >= _mid ? colMid : colBad)

f_boolColor(_ok) =>
    _ok ? colGood : colBad

f_cellText(_title, _value) => _title + "\n" + _value

// Single-line to avoid Pine line-continuation issues
f_tile(_t, _col, _row, _title, _value, _bg, _txtCol, _ts, _alpha) =>
    table.cell(_t, _col, _row, f_cellText(_title, _value), text_color=_txtCol, text_size=_ts, bgcolor=color.new(_bg, _alpha))

//──────────────────────────────────────────────────────────────────────────────
// Calculations
//──────────────────────────────────────────────────────────────────────────────
ema8   = ta.ema(close, lenE1)
ema21  = ta.ema(close, lenE2)
ema50  = ta.ema(close, lenE3)
sma200 = ta.sma(close, lenS200)

d8   = f_distPct(close, ema8)
d21  = f_distPct(close, ema21)
d50  = f_distPct(close, ema50)
d200 = f_distPct(close, sma200)

// Daily stats (works on intraday)
dHigh  = request.security(syminfo.tickerid, "D", high)
dLow   = request.security(syminfo.tickerid, "D", low)
dClose = request.security(syminfo.tickerid, "D", close)

dTR  = dHigh - dLow
dATR = request.security(syminfo.tickerid, "D", ta.atr(atrLen))
dtrAtrPct = (not na(dATR) and dATR != 0.0) ? (dTR / dATR) * 100.0 : na

dADR = request.security(syminfo.tickerid, "D", ta.sma(high - low, adrLen))
adrPct = dClose != 0.0 ? (dADR / dClose) * 100.0 : na

// LoD distance as % of Daily ATR
lodPctAtr = (not na(dATR) and dATR != 0.0) ? ((close - dLow) / dATR) * 100.0 : na

// Minervini checks (1–7)
sma50m  = ta.sma(close, 50)
sma150m = ta.sma(close, 150)
sma200m = ta.sma(close, 200)

wkHigh52 = request.security(syminfo.tickerid, "W", ta.highest(high, 52))
wkLow52  = request.security(syminfo.tickerid, "W", ta.lowest(low, 52))

c1 = close > sma150m and close > sma200m
c2 = sma150m > sma200m
c3 = ta.rising(sma200m, 20)
c4 = sma50m > sma150m and sma50m > sma200m
c5 = close > sma50m
c6 = wkLow52 != 0.0 ? close >= wkLow52 * 1.30 : false
c7 = wkHigh52 != 0.0 ? close >= wkHigh52 * 0.75 : false
c8 = rsManual > 0 ? rsManual >= rsMin : na

minScore = (c1?1:0)+(c2?1:0)+(c3?1:0)+(c4?1:0)+(c5?1:0)+(c6?1:0)+(c7?1:0)+(rsManual>0 and c8?1:0)
minTotal = rsManual>0 ? 8 : 7
mttText  = str.format("{0}/{1}", minScore, minTotal)
mttColor = minScore == minTotal ? colGood : minScore >= math.ceil(minTotal * 0.70) ? colMid : colBad

//──────────────────────────────────────────────────────────────────────────────
// Table (boxed tiles)
// Row 0: distances/stats/MTT
// Row 1: Minervini MT1–MT7 (optional)
//──────────────────────────────────────────────────────────────────────────────
pos = f_posFromOpt(posOpt)
ts  = f_sizeFromOpt(txtSize)

// Top strip: 8 tiles (no padding)
tiles = 8
cols  = tiles
rows  = showMinerviniTiles ? 2 : 1

var table t = na
var int prevCols = na
var int prevRows = na

if na(t) or prevCols != cols or prevRows != rows
    if not na(t)
        table.delete(t)
    // White lines around cells via frame + border
    t := table.new(pos, cols, rows, frame_color=boxCol, frame_width=boxWidth, border_color=boxCol, border_width=boxWidth)
    prevCols := cols
    prevRows := rows

if barstate.islast
    table.clear(t, 0, 0, cols - 1, rows - 1)

    // Row 0 tiles (distance / stats / MTT)
    f_tile(t, 0, 0, str.tostring(lenE1) + "EMA",  str.format("{0,number,#0.00}%", d8),   f_maBandColor(d8),   textCol, ts, bgAlpha)
    f_tile(t, 1, 0, str.tostring(lenE2) + "EMA",  str.format("{0,number,#0.00}%", d21),  f_maBandColor(d21),  textCol, ts, bgAlpha)
    f_tile(t, 2, 0, str.tostring(lenE3) + "EMA",  str.format("{0,number,#0.00}%", d50),  f_maBandColor(d50),  textCol, ts, bgAlpha)
    f_tile(t, 3, 0, str.tostring(lenS200) + "SMA", str.format("{0,number,#0.00}%", d200), f_maBandColor(d200), textCol, ts, bgAlpha)

    dtrText = na(dTR) or na(dATR) ? "NA" : str.format("{0,number,#0.00}/{1,number,#0.00} ({2,number,#0.00}%)", dTR, dATR, dtrAtrPct)
    f_tile(t, 4, 0, "DTR vs ATR", dtrText, f_statColor(dtrAtrPct, dtrGood, dtrMid), textCol, ts, bgAlpha)

    f_tile(t, 5, 0, "MTT", mttText, mttColor, textCol, ts, bgAlpha)

    f_tile(t, 6, 0, "ADR%" + str.tostring(adrLen), na(adrPct) ? "NA" : str.format("{0,number,#0.00}%", adrPct), f_statColor(adrPct, adrGood, adrMid), textCol, ts, bgAlpha)
    f_tile(t, 7, 0, "LoD %ATR", na(lodPctAtr) ? "NA" : str.format("{0,number,#0.00}%", lodPctAtr), f_statColor(lodPctAtr, lodGood, lodMid), textCol, ts, bgAlpha)

    // Optional Minervini strip (Row 1) — Conditions across cols 0..6; col 7 shows MTT again
if showMinerviniTiles
    f_tile(t, 0, 1, "Px>150/200",   c1 ? "PASS" : "FAIL", f_boolColor(c1), textCol, ts, bgAlpha)
    f_tile(t, 1, 1, "150>200",      c2 ? "PASS" : "FAIL", f_boolColor(c2), textCol, ts, bgAlpha)
    f_tile(t, 2, 1, "200↑1M",       c3 ? "PASS" : "FAIL", f_boolColor(c3), textCol, ts, bgAlpha)
    f_tile(t, 3, 1, "50>150/200",   c4 ? "PASS" : "FAIL", f_boolColor(c4), textCol, ts, bgAlpha)
    f_tile(t, 4, 1, "Px>50",        c5 ? "PASS" : "FAIL", f_boolColor(c5), textCol, ts, bgAlpha)
    f_tile(t, 5, 1, "+30%52WL",     c6 ? "PASS" : "FAIL", f_boolColor(c6), textCol, ts, bgAlpha)
    f_tile(t, 6, 1, "≤25%off52WH",  c7 ? "PASS" : "FAIL", f_boolColor(c7), textCol, ts, bgAlpha)
    f_tile(t, 7, 1, "Score",        mttText,              mttColor,        textCol, ts, bgAlpha)
