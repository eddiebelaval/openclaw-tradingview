//@version=5
indicator("Time + SMA89/200 + Directional Candle Filter", overlay=true)

// =====================================
// SETTINGS
// =====================================

// blank = current chart timeframe
tfFilter = input.timeframe("", "Filter Timeframe (blank = current)")

// SMA compression settings
distThreshold  = input.float(3.0, "Max distance between SMA89 and SMA200", step=0.1)
slopeBars      = input.int(5, "Bars to measure slope", minval=1)
slopeThreshold = input.float(1.0, "Max flat slope threshold", step=0.1)

// Candle filter settings
dojiThreshold  = input.float(0.10, "Doji body ratio threshold", step=0.01)
wickRatioBlock = input.float(0.40, "Directional wick ratio block threshold", step=0.01)

// =====================================
// TIME FILTER (UTC+8 / Singapore)
// =====================================

block1 = not na(time(timeframe.period, "0400-0700", "Asia/Singapore"))
block2 = not na(time(timeframe.period, "0830-0915", "Asia/Singapore"))
block3 = not na(time(timeframe.period, "1600-2045", "Asia/Singapore"))

timeBlocked = block1 or block2 or block3
timeAllowed = not timeBlocked

// =====================================
// FILTER TIMEFRAME
// =====================================

tf = tfFilter == "" ? timeframe.period : tfFilter

// =====================================
// SMA89 / SMA200 COMPRESSION + FLAT FILTER
// =====================================

sma89_tf      = request.security(syminfo.tickerid, tf, ta.sma(close, 89))
sma200_tf     = request.security(syminfo.tickerid, tf, ta.sma(close, 200))
sma89_prev_tf = request.security(syminfo.tickerid, tf, ta.sma(close, 89)[slopeBars])
sma200_prev_tf= request.security(syminfo.tickerid, tf, ta.sma(close, 200)[slopeBars])

maCloseTogether = math.abs(sma89_tf - sma200_tf) < distThreshold
sma89Flat       = math.abs(sma89_tf - sma89_prev_tf) < slopeThreshold
sma200Flat      = math.abs(sma200_tf - sma200_prev_tf) < slopeThreshold

maBlocked = maCloseTogether and sma89Flat and sma200Flat
maAllowed = not maBlocked

// =====================================
// LAST CLOSED CANDLE FILTER (selected timeframe)
// Doji allowed
// Buy blocks long upper wick
// Sell blocks long lower wick
// =====================================

prevOpen_tf  = request.security(syminfo.tickerid, tf, open[1])
prevHigh_tf  = request.security(syminfo.tickerid, tf, high[1])
prevLow_tf   = request.security(syminfo.tickerid, tf, low[1])
prevClose_tf = request.security(syminfo.tickerid, tf, close[1])

prevRange_tf = prevHigh_tf - prevLow_tf
prevBody_tf  = math.abs(prevClose_tf - prevOpen_tf)

upperWick_tf = prevHigh_tf - math.max(prevOpen_tf, prevClose_tf)
lowerWick_tf = math.min(prevOpen_tf, prevClose_tf) - prevLow_tf

bodyRatio_tf      = prevRange_tf > 0 ? prevBody_tf / prevRange_tf : 1.0
upperWickRatio_tf = prevRange_tf > 0 ? upperWick_tf / prevRange_tf : 0.0
lowerWickRatio_tf = prevRange_tf > 0 ? lowerWick_tf / prevRange_tf : 0.0

// Doji = allowed
doji_tf = bodyRatio_tf < dojiThreshold

// Directional wick blocks
buyWickBlocked  = not doji_tf and upperWickRatio_tf > wickRatioBlock
sellWickBlocked = not doji_tf and lowerWickRatio_tf > wickRatioBlock

buyWickAllowed  = not buyWickBlocked
sellWickAllowed = not sellWickBlocked

// =====================================
// FINAL BUY / SELL FILTERS
// =====================================

buyAllowed  = timeAllowed and maAllowed and buyWickAllowed
sellAllowed = timeAllowed and maAllowed and sellWickAllowed

buyBlocked  = not buyAllowed
sellBlocked = not sellAllowed

// =====================================
// PLOTS
// =====================================

plot(sma89_tf, color=color.orange, title="SMA 89")
plot(sma200_tf, color=color.blue, title="SMA 200")

bgcolor(timeBlocked ? color.new(color.red, 85) : na, title="Blocked Time")
bgcolor(maBlocked and not timeBlocked ? color.new(color.orange, 85) : na, title="Blocked MA Compression")

// Optional visual hints for last closed candle block
bgcolor(buyWickBlocked and not timeBlocked and not maBlocked ? color.new(color.green, 88) : na, title="Buy Blocked by Upper Wick")
bgcolor(sellWickBlocked and not timeBlocked and not maBlocked ? color.new(color.purple, 88) : na, title="Sell Blocked by Lower Wick")

// =====================================
// ALERTS
// =====================================

alertcondition(buyAllowed, title="Buy Allowed Zone", message="Buy allowed")
alertcondition(sellAllowed, title="Sell Allowed Zone", message="Sell allowed")

alertcondition(buyBlocked, title="Buy Blocked Zone", message="Buy blocked")
alertcondition(sellBlocked, title="Sell Blocked Zone", message="Sell blocked")
