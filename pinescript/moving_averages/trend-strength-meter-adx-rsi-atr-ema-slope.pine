//@version=5
indicator("Trend Strength Meter (ADX + RSI + ATR + EMA Slope)", shorttitle="Trend Strength Meter", overlay=false, max_lines_count=500, max_labels_count=200)

//===================== INPUTS =====================//
grpW   = "Ağırlıklar (Toplam ≈ 100)"
wADX   = input.int(30, "ADX",   minval=0, maxval=100, group=grpW)
wRSI   = input.int(30, "RSI",   minval=0, maxval=100, group=grpW)
wATR   = input.int(20, "ATR",   minval=0, maxval=100, group=grpW)
wSLOPE = input.int(20, "EMA Slope", minval=0, maxval=100, group=grpW)

grpT   = "Temel Ayarlar"
lenADX = input.int(14, "DI Length (ta.dmi)", group=grpT)
adxSm  = input.int(14, "ADX Smoothing",      group=grpT)
lenRSI = input.int(14, "RSI Length",         group=grpT)
lenATR = input.int(14, "ATR Length",         group=grpT)
emaLen = input.int(200,"EMA Trend (Slope) Length", group=grpT)
smooth = input.int(5,  "Skor Yumuşatma (SMA)", minval=1, group=grpT)

grpR   = "Referanslar / Eşikler"
adxCap = input.int(50, "ADX Üst Tavan (normalize için)", minval=20, maxval=70, group=grpR)
atrRefLen = input.int(50, "ATR Referans Ortalaması", group=grpR)
atrScale  = input.float(0.25, "ATR Normalize Ölçeği (0.15–0.5)", step=0.05, group=grpR)
bullTh = input.int(60, "Bullish Güç Eşiği", minval=0, maxval=100, group=grpR)
bearTh = input.int(60, "Bearish Güç Eşiği", minval=0, maxval=100, group=grpR)

grpV   = "Görselleştirme"
showBands = input.bool(true, "60/80 Bantları", group=grpV)
colBull = color.new(color.lime, 0)
colBear = color.new(color.red,  0)
colNet  = color.new(color.teal, 0)

//===================== SERIES =====================//
emaBase  = ta.ema(close, emaLen)
emaSlope = emaBase - emaBase[1]
atr      = ta.atr(lenATR)
atrMA    = ta.sma(atr, atrRefLen)
rsiV     = ta.rsi(close, lenRSI)
// ADX'i DMI'dan al (iki parametre zorunlu)
[diPlus, diMinus, adxV] = ta.dmi(lenADX, adxSm)

//===================== HELPERS =====================//
// Pine v5'te math.clamp yok; kendi clamp fonksiyonumuz:
clamp(x, lo, hi) =>
    x < lo ? lo : x > hi ? hi : x

norm01(x, lo, hi) =>
    hi == lo ? 0.0 : clamp((x - lo) / (hi - lo), 0.0, 1.0)

toPct(x) =>
    clamp(x * 100.0, 0.0, 100.0)

//===================== NORMALİZASYON =====================//
// 1) ADX: 0–adxCap → 0–100
adxNorm = toPct(norm01(adxV, 0, adxCap))

// 2) RSI yönlü katkı
rsiBull = toPct(norm01(rsiV, 50, 100))      // 50→100: boğa gücü
rsiBear = toPct(norm01(50, rsiV, 0))        // 50→0  : ayı  gücü

// 3) ATR oranı
atrRatio   = atrMA == 0 ? 0.0 : atr / atrMA
atrNormRaw = (atrRatio - 1.0) / atrScale
atrNorm    = toPct(atrNormRaw < 0 ? 0 : atrNormRaw)

// 4) EMA Slope (ATR'a göre ölçekleyip -1..+1 → 0..100)
slopeNorm  = toPct(norm01(emaSlope / (atr == 0 ? 1 : atr), -1.0, 1.0))

//===================== YÖN FİLTRESİ =====================//
bullDir = emaSlope > 0 and close > emaBase
bearDir = emaSlope < 0 and close < emaBase

//===================== SKORLAR =====================//
wSum = math.max(wADX + wRSI + wATR + wSLOPE, 1)

adxBull = adxNorm
adxBear = adxNorm
atrBull = atrNorm
atrBear = atrNorm
slopeBull = slopeNorm
slopeBear = toPct(100 - slopeNorm)
rsiBullN  = rsiBull
rsiBearN  = rsiBear

bullScoreRaw = (wADX*adxBull + wRSI*rsiBullN + wATR*atrBull + wSLOPE*slopeBull) / wSum
bearScoreRaw = (wADX*adxBear + wRSI*rsiBearN + wATR*atrBear + wSLOPE*slopeBear) / wSum

bullScore = ta.sma(bullScoreRaw, smooth)
bearScore = ta.sma(bearScoreRaw, smooth)

netSigned = (bullScore - bearScore)
netAbs    = math.abs(netSigned)
isBull    = netSigned >= 0

//===================== PLOTS =====================//
h60 = showBands ? 60 : na
h80 = showBands ? 30 : na
plot(h60, "60 Bandı", color=color.new(color.gray, 70), linewidth=1, style=plot.style_linebr)
plot(h80, "25 Bandı", color=color.new(color.gray, 70), linewidth=1, style=plot.style_linebr)

plot(bullScore, "Bullish Strength", color=colBull, linewidth=2)
plot(bearScore, "Bearish Strength", color=colBear, linewidth=2)
plot(netAbs, "Net Strength", style=plot.style_columns, linewidth=2, color=isBull ? color.new(colBull, 40) : color.new(colBear, 40))

plotshape(ta.crossover(bullScore, bullTh) and bullDir, title="Bull Start", style=shape.triangleup, location=location.bottom, color=colBull, size=size.tiny, text="Bull")
plotshape(ta.crossover(bearScore, bearTh) and bearDir, title="Bear Start", style=shape.triangledown, location=location.bottom, color=colBear, size=size.tiny, text="Bear")

//===================== ALERTS =====================//
alertcondition(ta.crossover(bullScore, bullTh) and bullDir, "Bullish Trend Güçlü", "Bullish trend güç eşiği aşıldı")
alertcondition(ta.crossover(bearScore, bearTh) and bearDir, "Bearish Trend Güçlü", "Bearish trend güç eşiği aşıldı")
