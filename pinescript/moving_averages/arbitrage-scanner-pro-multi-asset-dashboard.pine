//@version=5
indicator("⚡ Arbitrage Scanner Pro [Multi-Asset Dashboard]", overlay=false, explicit_plot_zorder=true, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════
// --- 1. SIMULATION SETTINGS ---
// ══════════════════════════════════════════════════════════════════
simGroup = "⚡ Speed Mode"
mode = input.string("Simulate 15s", options=["Normal (1m)", "Simulate 30s", "Simulate 15s", "Simulate 10s"], title="Scan Speed", group=simGroup, tooltip="Faster scan speed detects arbitrage opportunities quicker.")

// Strategy Inputs
stGroup = "📐 Arbitrage Detection Settings"
rawStLength = input.int(5, title="Trend Detection Length", group=stGroup)
rawStFactor = input.float(1.0, title="Sensitivity Factor", group=stGroup)
rawEmaLength = input.int(20, title="Channel Length", group=stGroup)
rawRsiLength = input.int(14, title="Momentum Length", group=stGroup)

// ══════════════════════════════════════════════════════════════════
// --- 2. MULTI-ASSET SETTINGS ---
// ══════════════════════════════════════════════════════════════════
secGroup = "📊 Asset B (Secondary)"
showSecondary = input.bool(true, "Enable Asset B", group=secGroup)
secondarySymbol = input.symbol("BINANCE:ETHUSDT", "Asset B Symbol", group=secGroup)
secBullColor = input.color(color.new(#26a69a, 0), "Bull Candle", group=secGroup, inline="sec_col")
secBearColor = input.color(color.new(#ef5350, 0), "Bear Candle", group=secGroup, inline="sec_col")

thirdGroup = "📊 Asset C (Third)"
showThird = input.bool(true, "Enable Asset C", group=thirdGroup)
thirdSymbol = input.symbol("BINANCE:BNBUSDT", "Asset C Symbol", group=thirdGroup)
thirdBullColor = input.color(color.new(#2196f3, 0), "Bull Candle", group=thirdGroup, inline="third_col")
thirdBearColor = input.color(color.new(#ff9800, 0), "Bear Candle", group=thirdGroup, inline="third_col")

// Visual Settings
visGroup = "🎨 Display Settings"
showIndicators = input.bool(true, "Show Trend Overlays", group=visGroup)
signalStyle = input.string("Labels", options=["Labels", "Arrows", "Both"], title="Signal Style", group=visGroup)
chartGap = input.float(15.0, "Gap Between Charts", minval=10, maxval=500, step=10, group=visGroup, tooltip="Adjust the vertical spacing between Asset B and Asset C charts")
signalOffset = input.float(8.0, "Signal Label Offset", minval=2, maxval=30, step=1, group=visGroup, tooltip="Distance of signal labels from candles")

// Size Settings
sizeGroup = "📏 Size Settings"
dashboardSize = input.string("Small", options=["Tiny", "Small", "Normal", "Large"], title="Dashboard Text Size", group=sizeGroup)
labelSize = input.string("Normal", options=["Tiny", "Small", "Normal", "Large", "Huge"], title="Chart Label Size", group=sizeGroup)
signalLabelSize = input.string("Normal", options=["Tiny", "Small", "Normal", "Large", "Huge"], title="Signal Label Size", group=sizeGroup)
dashPosition = input.string("Top Right", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Top Center", "Bottom Center", "Middle Right", "Middle Left", "Middle Center"], title="Dashboard Position", group=sizeGroup)

// ══════════════════════════════════════════════════════════════════
// --- 3. SIZE HELPER FUNCTIONS ---
// ══════════════════════════════════════════════════════════════════
getDashSize() =>
    switch dashboardSize
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        => size.small

getLabelSize() =>
    switch labelSize
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.normal

getSignalSize() =>
    switch signalLabelSize
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.normal

getDashPos() =>
    switch dashPosition
        "Top Right" => position.top_right
        "Top Left" => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left" => position.bottom_left
        "Top Center" => position.top_center
        "Bottom Center" => position.bottom_center
        "Middle Right" => position.middle_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        => position.top_right

dSize = getDashSize()
lSize = getLabelSize()
sSize = getSignalSize()
dPos = getDashPos()

// ══════════════════════════════════════════════════════════════════
// --- 4. SYMBOL PARSING FUNCTIONS ---
// ══════════════════════════════════════════════════════════════════
getExchange(simple string sym) =>
    str.contains(sym, ":") ? array.get(str.split(sym, ":"), 0) : "N/A"

getTicker(simple string sym) =>
    str.contains(sym, ":") ? array.get(str.split(sym, ":"), 1) : sym

mainFullSymbol = syminfo.prefix + ":" + syminfo.ticker
mainExchange = syminfo.prefix
mainTicker = syminfo.ticker

secExchange = getExchange(secondarySymbol)
secTicker = getTicker(secondarySymbol)

thirdExchange = getExchange(thirdSymbol)
thirdTicker = getTicker(thirdSymbol)

// ══════════════════════════════════════════════════════════════════
// --- 5. SPEED DIVIDER ---
// ══════════════════════════════════════════════════════════════════
var float divider = 1.0
if mode == "Normal (1m)"
    divider := 1.0
else if mode == "Simulate 30s"
    divider := 2.0
else if mode == "Simulate 15s"
    divider := 4.0
else if mode == "Simulate 10s"
    divider := 6.0

effStLength = math.max(1, math.round(rawStLength / divider))
effEmaLength = math.max(1, math.round(rawEmaLength / divider))
effRsiLength = math.max(2, math.round(rawRsiLength / divider))

// ══════════════════════════════════════════════════════════════════
// --- 6. ASSET A (MAIN) CALCULATIONS ---
// ══════════════════════════════════════════════════════════════════
[stVal, stDir] = ta.supertrend(rawStFactor, effStLength)
emaH = ta.ema(high, effEmaLength)
emaL = ta.ema(low, effEmaLength)
rsiVal = ta.rsi(close, effRsiLength)
rsiMa = ta.sma(rsiVal, 14)

isGreen = stDir == -1
isRed = stDir == 1
priceAbove = close > emaH
priceBelow = close < emaL
stInside = stVal < emaH and stVal > emaL

buy = isGreen and priceAbove and rsiVal > 60 and rsiVal > rsiMa and not stInside
sell = isRed and priceBelow and not stInside
buySignal = buy and not buy[1]
sellSignal = sell and not sell[1]

// ══════════════════════════════════════════════════════════════════
// --- 7. ASSET A OVERLAY PLOTS ---
// ══════════════════════════════════════════════════════════════════
plot(emaH, color=color.new(color.yellow, 50), title="A: Channel High", force_overlay=true)
plot(emaL, color=color.new(color.yellow, 50), title="A: Channel Low", force_overlay=true)
plot(stVal, color=stDir == -1 ? color.lime : color.fuchsia, linewidth=2, title="A: Trend Line", force_overlay=true)

plotshape(signalStyle != "Arrows" and buySignal, title="A: Long Label", location=location.belowbar, 
          color=color.lime, style=shape.labelup, text="🚀 LONG", textcolor=color.rgb(0,0,0), 
          size=size.normal, force_overlay=true)
plotshape(signalStyle != "Arrows" and sellSignal, title="A: Short Label", location=location.abovebar, 
          color=color.fuchsia, style=shape.labeldown, text="🔻 SHORT", textcolor=color.rgb(0,0,0), 
          size=size.normal, force_overlay=true)

plotshape(signalStyle != "Labels" and buySignal, title="A: Long Arrow", location=location.belowbar, 
          color=color.lime, style=shape.triangleup, size=size.normal, force_overlay=true)
plotshape(signalStyle != "Labels" and sellSignal, title="A: Short Arrow", location=location.abovebar, 
          color=color.fuchsia, style=shape.triangledown, size=size.normal, force_overlay=true)

// ══════════════════════════════════════════════════════════════════
// --- 8. ASSET B (SECONDARY) CALCULATIONS ---
// ══════════════════════════════════════════════════════════════════
[secOpen, secHigh, secLow, secClose] = request.security(secondarySymbol, timeframe.period, [open, high, low, close])
secEmaH = request.security(secondarySymbol, timeframe.period, ta.ema(high, effEmaLength))
secEmaL = request.security(secondarySymbol, timeframe.period, ta.ema(low, effEmaLength))
[secStVal, secStDir] = request.security(secondarySymbol, timeframe.period, ta.supertrend(rawStFactor, effStLength))
secRsiVal = request.security(secondarySymbol, timeframe.period, ta.rsi(close, effRsiLength))
secRsiMa = request.security(secondarySymbol, timeframe.period, ta.sma(ta.rsi(close, effRsiLength), 14))

secMin = ta.lowest(secLow, 200)
secMax = ta.highest(secHigh, 200)
secRange = secMax - secMin
secNormFactor = secRange != 0 ? 100 / secRange : 1

secNormOpen = (secOpen - secMin) * secNormFactor
secNormHigh = (secHigh - secMin) * secNormFactor
secNormLow = (secLow - secMin) * secNormFactor
secNormClose = (secClose - secMin) * secNormFactor
secNormEmaH = (secEmaH - secMin) * secNormFactor
secNormEmaL = (secEmaL - secMin) * secNormFactor
secNormStVal = (secStVal - secMin) * secNormFactor

secCandleColor = secClose >= secOpen ? secBullColor : secBearColor

secIsGreen = secStDir == -1
secIsRed = secStDir == 1
secPriceAbove = secClose > secEmaH
secPriceBelow = secClose < secEmaL
secStInside = secStVal < secEmaH and secStVal > secEmaL
secBuy = secIsGreen and secPriceAbove and secRsiVal > 60 and secRsiVal > secRsiMa and not secStInside
secSell = secIsRed and secPriceBelow and not secStInside
secBuySignal = secBuy and not secBuy[1]
secSellSignal = secSell and not secSell[1]

// Price change calculation
secPriceChange = secClose - secClose[1]
secPriceChangePct = secClose[1] != 0 ? (secPriceChange / secClose[1]) * 100 : 0

plotcandle(showSecondary ? secNormOpen : na, showSecondary ? secNormHigh : na, 
           showSecondary ? secNormLow : na, showSecondary ? secNormClose : na,
           title="B: Candles", color=secCandleColor, wickcolor=secCandleColor, 
           bordercolor=secCandleColor)

plot(showSecondary and showIndicators ? secNormEmaH : na, color=color.new(color.yellow, 50), 
     title="B: Channel High", linewidth=1)
plot(showSecondary and showIndicators ? secNormEmaL : na, color=color.new(color.yellow, 50), 
     title="B: Channel Low", linewidth=1)

secStColor = secStDir == -1 ? color.lime : color.fuchsia
plot(showSecondary and showIndicators ? secNormStVal : na, color=secStColor, linewidth=2, title="B: Trend Line")

secBuyY = showSecondary and secBuySignal ? secNormLow - signalOffset : na
secSellY = showSecondary and secSellSignal ? secNormHigh + signalOffset : na

plotshape(secBuyY, title="B: Long", location=location.absolute, 
          color=color.lime, style=shape.labelup, text="B\nLONG", textcolor=color.rgb(0,0,0), size=size.normal)
plotshape(secSellY, title="B: Short", location=location.absolute, 
          color=color.fuchsia, style=shape.labeldown, text="B\nSHORT", textcolor=color.rgb(0,0,0), size=size.normal)

secBuyBG = showSecondary and secBuySignal ? color.new(color.lime, 85) : na
secSellBG = showSecondary and secSellSignal ? color.new(color.fuchsia, 85) : na
bgcolor(secBuyBG, title="B: Long Flash")
bgcolor(secSellBG, title="B: Short Flash")

// ══════════════════════════════════════════════════════════════════
// --- 9. ASSET C (THIRD) CALCULATIONS ---
// ══════════════════════════════════════════════════════════════════
thirdOffset = -chartGap

[thirdOpen, thirdHigh, thirdLow, thirdClose] = request.security(thirdSymbol, timeframe.period, [open, high, low, close])
thirdEmaH = request.security(thirdSymbol, timeframe.period, ta.ema(high, effEmaLength))
thirdEmaL = request.security(thirdSymbol, timeframe.period, ta.ema(low, effEmaLength))
[thirdStVal, thirdStDir] = request.security(thirdSymbol, timeframe.period, ta.supertrend(rawStFactor, effStLength))
thirdRsiVal = request.security(thirdSymbol, timeframe.period, ta.rsi(close, effRsiLength))
thirdRsiMa = request.security(thirdSymbol, timeframe.period, ta.sma(ta.rsi(close, effRsiLength), 14))

thirdMin = ta.lowest(thirdLow, 200)
thirdMax = ta.highest(thirdHigh, 200)
thirdRange = thirdMax - thirdMin
thirdNormFactor = thirdRange != 0 ? 100 / thirdRange : 1

thirdNormOpen = ((thirdOpen - thirdMin) * thirdNormFactor) + thirdOffset
thirdNormHigh = ((thirdHigh - thirdMin) * thirdNormFactor) + thirdOffset
thirdNormLow = ((thirdLow - thirdMin) * thirdNormFactor) + thirdOffset
thirdNormClose = ((thirdClose - thirdMin) * thirdNormFactor) + thirdOffset
thirdNormEmaH = ((thirdEmaH - thirdMin) * thirdNormFactor) + thirdOffset
thirdNormEmaL = ((thirdEmaL - thirdMin) * thirdNormFactor) + thirdOffset
thirdNormStVal = ((thirdStVal - thirdMin) * thirdNormFactor) + thirdOffset

thirdCandleColor = thirdClose >= thirdOpen ? thirdBullColor : thirdBearColor

thirdIsGreen = thirdStDir == -1
thirdIsRed = thirdStDir == 1
thirdPriceAbove = thirdClose > thirdEmaH
thirdPriceBelow = thirdClose < thirdEmaL
thirdStInside = thirdStVal < thirdEmaH and thirdStVal > thirdEmaL
thirdBuy = thirdIsGreen and thirdPriceAbove and thirdRsiVal > 60 and thirdRsiVal > thirdRsiMa and not thirdStInside
thirdSell = thirdIsRed and thirdPriceBelow and not thirdStInside
thirdBuySignal = thirdBuy and not thirdBuy[1]
thirdSellSignal = thirdSell and not thirdSell[1]

// Price change calculation
thirdPriceChange = thirdClose - thirdClose[1]
thirdPriceChangePct = thirdClose[1] != 0 ? (thirdPriceChange / thirdClose[1]) * 100 : 0

plotcandle(showThird ? thirdNormOpen : na, showThird ? thirdNormHigh : na, 
           showThird ? thirdNormLow : na, showThird ? thirdNormClose : na,
           title="C: Candles", color=thirdCandleColor, wickcolor=thirdCandleColor, 
           bordercolor=thirdCandleColor)

plot(showThird and showIndicators ? thirdNormEmaH : na, color=color.new(color.orange, 50), 
     title="C: Channel High", linewidth=1)
plot(showThird and showIndicators ? thirdNormEmaL : na, color=color.new(color.orange, 50), 
     title="C: Channel Low", linewidth=1)

thirdStColor = thirdStDir == -1 ? color.lime : color.fuchsia
plot(showThird and showIndicators ? thirdNormStVal : na, color=thirdStColor, linewidth=2, title="C: Trend Line")

thirdBuyY = showThird and thirdBuySignal ? thirdNormLow - signalOffset : na
thirdSellY = showThird and thirdSellSignal ? thirdNormHigh + signalOffset : na

plotshape(thirdBuyY, title="C: Long", location=location.absolute, 
          color=color.lime, style=shape.labelup, text="C\nLONG", textcolor=color.rgb(0,0,0), size=size.normal)
plotshape(thirdSellY, title="C: Short", location=location.absolute, 
          color=color.fuchsia, style=shape.labeldown, text="C\nSHORT", textcolor=color.rgb(0,0,0), size=size.normal)

// ══════════════════════════════════════════════════════════════════
// --- 10. ARBITRAGE DETECTION LOGIC ---
// ══════════════════════════════════════════════════════════════════
arbDivergence_AB = (buySignal and secSellSignal) or (sellSignal and secBuySignal)
arbDivergence_AC = (buySignal and thirdSellSignal) or (sellSignal and thirdBuySignal)
arbDivergence_BC = (secBuySignal and thirdSellSignal) or (secSellSignal and thirdBuySignal)

arbConvergence_Long = buySignal and secBuySignal and thirdBuySignal
arbConvergence_Short = sellSignal and secSellSignal and thirdSellSignal

trendDiv_AB = (isGreen and secIsRed) or (isRed and secIsGreen)
trendDiv_AC = (isGreen and thirdIsRed) or (isRed and thirdIsGreen)
trendDiv_BC = (secIsGreen and thirdIsRed) or (secIsRed and thirdIsGreen)

allBullish = isGreen and secIsGreen and thirdIsGreen
allBearish = isRed and secIsRed and thirdIsRed

arbScore = (trendDiv_AB ? 1 : 0) + (trendDiv_AC ? 1 : 0) + (trendDiv_BC ? 1 : 0)

arbBG = arbDivergence_AB or arbDivergence_AC or arbDivergence_BC ? color.new(color.yellow, 80) : arbConvergence_Long ? color.new(color.lime, 85) : arbConvergence_Short ? color.new(color.fuchsia, 85) : na
bgcolor(arbBG, title="Arbitrage Opportunity Flash")

// Main price change
mainPriceChange = close - close[1]
mainPriceChangePct = close[1] != 0 ? (mainPriceChange / close[1]) * 100 : 0

// ══════════════════════════════════════════════════════════════════
// --- 11. SEPARATOR LINES ---
// ══════════════════════════════════════════════════════════════════
plot(showSecondary ? 110.0 : na, color=color.new(color.gray, 60), title="B: Top Line", linewidth=1, style=plot.style_linebr)
plot(showSecondary ? -10.0 : na, color=color.new(color.white, 50), title="B: Bottom Line", linewidth=1, style=plot.style_linebr)
plot(showThird ? thirdOffset + 110 : na, color=color.new(color.gray, 60), title="C: Top Line", linewidth=1, style=plot.style_linebr)
plot(showThird ? thirdOffset - 10 : na, color=color.new(color.white, 50), title="C: Bottom Line", linewidth=1, style=plot.style_linebr)

// ══════════════════════════════════════════════════════════════════
// --- 12. PANE CHART ASSET LABELS (Exchange + Ticker + Price) ---
// ══════════════════════════════════════════════════════════════════
var label secNameLabel = na
var label secExchLabel = na
var label secPriceLabel = na
var label secChangeLabel = na

var label thirdNameLabel = na
var label thirdExchLabel = na
var label thirdPriceLabel = na
var label thirdChangeLabel = na

if barstate.islast
    // Clean up old labels
    label.delete(secNameLabel)
    label.delete(secExchLabel)
    label.delete(secPriceLabel)
    label.delete(secChangeLabel)
    label.delete(thirdNameLabel)
    label.delete(thirdExchLabel)
    label.delete(thirdPriceLabel)
    label.delete(thirdChangeLabel)
    
    // ── ASSET B LABELS ──
    if showSecondary
        // Asset name label (top of chart area)
        secNameLabel := label.new(bar_index + 3, 108, 
             "📊 " + secTicker, 
             style=label.style_label_left, 
             color=color.new(#26a69a, 20), 
             textcolor=color.white, 
             size=lSize)
        
        // Exchange label (below name)
        secExchLabel := label.new(bar_index + 3, 101, 
             "🏛️ " + secExchange, 
             style=label.style_label_left, 
             color=color.new(#26a69a, 60), 
             textcolor=color.new(color.white, 20), 
             size=lSize)
        
        // Price label (at current normalized close)
        string secPriceText = "💲 " + str.tostring(secClose, "#.####")
        secPriceLabel := label.new(bar_index + 3, secNormClose, 
             secPriceText, 
             style=label.style_label_left, 
             color=secClose >= secOpen ? color.new(#26a69a, 40) : color.new(#ef5350, 40), 
             textcolor=color.white, 
             size=lSize)
        
        // Price change label (below price)
        string secChgSign = secPriceChangePct >= 0 ? "+" : ""
        string secChangeText = secChgSign + str.tostring(secPriceChangePct, "#0.00") + "%"
        color secChgColor = secPriceChangePct >= 0 ? color.new(color.lime, 20) : color.new(color.red, 20)
        secChangeLabel := label.new(bar_index + 3, secNormClose - 6, 
             secChangeText, 
             style=label.style_label_left, 
             color=secChgColor, 
             textcolor=color.white, 
             size=lSize)
    
    // ── ASSET C LABELS ──
    if showThird
        // Asset name label
        thirdNameLabel := label.new(bar_index + 3, thirdOffset + 108, 
             "📊 " + thirdTicker, 
             style=label.style_label_left, 
             color=color.new(#2196f3, 20), 
             textcolor=color.white, 
             size=lSize)
        
        // Exchange label
        thirdExchLabel := label.new(bar_index + 3, thirdOffset + 101, 
             "🏛️ " + thirdExchange, 
             style=label.style_label_left, 
             color=color.new(#2196f3, 60), 
             textcolor=color.new(color.white, 20), 
             size=lSize)
        
        // Price label
        string thirdPriceText = "💲 " + str.tostring(thirdClose, "#.####")
        thirdPriceLabel := label.new(bar_index + 3, thirdNormClose, 
             thirdPriceText, 
             style=label.style_label_left, 
             color=thirdClose >= thirdOpen ? color.new(#2196f3, 40) : color.new(#ff9800, 40), 
             textcolor=color.white, 
             size=lSize)
        
        // Price change label
        string thirdChgSign = thirdPriceChangePct >= 0 ? "+" : ""
        string thirdChangeText = thirdChgSign + str.tostring(thirdPriceChangePct, "#0.00") + "%"
        color thirdChgColor = thirdPriceChangePct >= 0 ? color.new(color.lime, 20) : color.new(color.red, 20)
        thirdChangeLabel := label.new(bar_index + 3, thirdNormClose - 6, 
             thirdChangeText, 
             style=label.style_label_left, 
             color=thirdChgColor, 
             textcolor=color.white, 
             size=lSize)

// ══════════════════════════════════════════════════════════════════
// --- 13. ARBITRAGE DASHBOARD ---
// ══════════════════════════════════════════════════════════════════
var table arbDash = table.new(dPos, 6, 10, bgcolor=color.new(#0d1117, 5), border_width=1, border_color=color.new(#30363d, 0), frame_width=2, frame_color=color.new(#58a6ff, 30), force_overlay=true)

if barstate.islast
    // === HEADER ===
    table.cell(arbDash, 0, 0, "⚡ ARBITRAGE SCANNER PRO", bgcolor=color.new(#161b22, 0), text_color=#58a6ff, text_size=dSize, text_halign=text.align_center)
    table.merge_cells(arbDash, 0, 0, 5, 0)
    
    // === COLUMN HEADERS ===
    headerBG = color.new(#21262d, 0)
    table.cell(arbDash, 0, 1, "ASSET", bgcolor=headerBG, text_color=#c9d1d9, text_size=dSize)
    table.cell(arbDash, 1, 1, "EXCHANGE", bgcolor=headerBG, text_color=#c9d1d9, text_size=dSize)
    table.cell(arbDash, 2, 1, "PRICE", bgcolor=headerBG, text_color=#c9d1d9, text_size=dSize)
    table.cell(arbDash, 3, 1, "CHANGE", bgcolor=headerBG, text_color=#c9d1d9, text_size=dSize)
    table.cell(arbDash, 4, 1, "TREND", bgcolor=headerBG, text_color=#c9d1d9, text_size=dSize)
    table.cell(arbDash, 5, 1, "SIGNAL", bgcolor=headerBG, text_color=#c9d1d9, text_size=dSize)
    
    // === ASSET A ROW ===
    rowBG1 = color.new(#161b22, 0)
    table.cell(arbDash, 0, 2, "🔷 " + mainTicker, bgcolor=rowBG1, text_color=#58a6ff, text_size=dSize)
    table.cell(arbDash, 1, 2, "🏛️ " + mainExchange, bgcolor=rowBG1, text_color=color.new(#8b949e, 0), text_size=dSize)
    table.cell(arbDash, 2, 2, str.tostring(close, "#.####"), bgcolor=rowBG1, text_color=color.white, text_size=dSize)
    string mainChgSign = mainPriceChangePct >= 0 ? "+" : ""
    string mainChgText = mainChgSign + str.tostring(mainPriceChangePct, "#0.00") + "%"
    color mainChgCol = mainPriceChangePct >= 0 ? color.lime : color.red
    table.cell(arbDash, 3, 2, mainChgText, bgcolor=rowBG1, text_color=mainChgCol, text_size=dSize)
    table.cell(arbDash, 4, 2, isGreen ? "▲ BULL" : "▼ BEAR", bgcolor=rowBG1, text_color=isGreen ? color.lime : color.fuchsia, text_size=dSize)
    mainSig = buySignal ? "🚀 LONG!" : sellSignal ? "🔻 SHORT!" : buy ? "🟢 Long" : sell ? "🔴 Short" : "⚪ Neutral"
    mainSigCol = buySignal or buy ? color.lime : sellSignal or sell ? color.fuchsia : color.gray
    mainSigBG = buySignal or sellSignal ? color.new(mainSigCol, 70) : rowBG1
    table.cell(arbDash, 5, 2, mainSig, bgcolor=mainSigBG, text_color=mainSigCol, text_size=dSize)
    
    // === ASSET B ROW ===
    rowBG2 = color.new(#0d1117, 0)
    if showSecondary
        table.cell(arbDash, 0, 3, "🟢 " + secTicker, bgcolor=rowBG2, text_color=#26a69a, text_size=dSize)
        table.cell(arbDash, 1, 3, "🏛️ " + secExchange, bgcolor=rowBG2, text_color=color.new(#8b949e, 0), text_size=dSize)
        table.cell(arbDash, 2, 3, str.tostring(secClose, "#.####"), bgcolor=rowBG2, text_color=color.white, text_size=dSize)
        string secChgSign2 = secPriceChangePct >= 0 ? "+" : ""
        string secChgText2 = secChgSign2 + str.tostring(secPriceChangePct, "#0.00") + "%"
        color secChgCol2 = secPriceChangePct >= 0 ? color.lime : color.red
        table.cell(arbDash, 3, 3, secChgText2, bgcolor=rowBG2, text_color=secChgCol2, text_size=dSize)
        table.cell(arbDash, 4, 3, secIsGreen ? "▲ BULL" : "▼ BEAR", bgcolor=rowBG2, text_color=secIsGreen ? color.lime : color.fuchsia, text_size=dSize)
        secSig = secBuySignal ? "🚀 LONG!" : secSellSignal ? "🔻 SHORT!" : secBuy ? "🟢 Long" : secSell ? "🔴 Short" : "⚪ Neutral"
        secSigCol = secBuySignal or secBuy ? color.lime : secSellSignal or secSell ? color.fuchsia : color.gray
        secSigBG = secBuySignal or secSellSignal ? color.new(secSigCol, 70) : rowBG2
        table.cell(arbDash, 5, 3, secSig, bgcolor=secSigBG, text_color=secSigCol, text_size=dSize)
    else
        table.cell(arbDash, 0, 3, "B: OFF", bgcolor=rowBG2, text_color=color.gray, text_size=dSize)
        table.cell(arbDash, 1, 3, "-", bgcolor=rowBG2, text_color=color.gray, text_size=dSize)
        table.cell(arbDash, 2, 3, "-", bgcolor=rowBG2, text_color=color.gray, text_size=dSize)
        table.cell(arbDash, 3, 3, "-", bgcolor=rowBG2, text_color=color.gray, text_size=dSize)
        table.cell(arbDash, 4, 3, "-", bgcolor=rowBG2, text_color=color.gray, text_size=dSize)
        table.cell(arbDash, 5, 3, "-", bgcolor=rowBG2, text_color=color.gray, text_size=dSize)
    
    // === ASSET C ROW ===
    if showThird
        table.cell(arbDash, 0, 4, "🔵 " + thirdTicker, bgcolor=rowBG1, text_color=#2196f3, text_size=dSize)
        table.cell(arbDash, 1, 4, "🏛️ " + thirdExchange, bgcolor=rowBG1, text_color=color.new(#8b949e, 0), text_size=dSize)
        table.cell(arbDash, 2, 4, str.tostring(thirdClose, "#.####"), bgcolor=rowBG1, text_color=color.white, text_size=dSize)
        string thirdChgSign2 = thirdPriceChangePct >= 0 ? "+" : ""
        string thirdChgText2 = thirdChgSign2 + str.tostring(thirdPriceChangePct, "#0.00") + "%"
        color thirdChgCol2 = thirdPriceChangePct >= 0 ? color.lime : color.red
        table.cell(arbDash, 3, 4, thirdChgText2, bgcolor=rowBG1, text_color=thirdChgCol2, text_size=dSize)
        table.cell(arbDash, 4, 4, thirdIsGreen ? "▲ BULL" : "▼ BEAR", bgcolor=rowBG1, text_color=thirdIsGreen ? color.lime : color.fuchsia, text_size=dSize)
        thirdSig = thirdBuySignal ? "🚀 LONG!" : thirdSellSignal ? "🔻 SHORT!" : thirdBuy ? "🟢 Long" : thirdSell ? "🔴 Short" : "⚪ Neutral"
        thirdSigCol = thirdBuySignal or thirdBuy ? color.lime : thirdSellSignal or thirdSell ? color.fuchsia : color.gray
        thirdSigBG = thirdBuySignal or thirdSellSignal ? color.new(thirdSigCol, 70) : rowBG1
        table.cell(arbDash, 5, 4, thirdSig, bgcolor=thirdSigBG, text_color=thirdSigCol, text_size=dSize)
    else
        table.cell(arbDash, 0, 4, "C: OFF", bgcolor=rowBG1, text_color=color.gray, text_size=dSize)
        table.cell(arbDash, 1, 4, "-", bgcolor=rowBG1, text_color=color.gray, text_size=dSize)
        table.cell(arbDash, 2, 4, "-", bgcolor=rowBG1, text_color=color.gray, text_size=dSize)
        table.cell(arbDash, 3, 4, "-", bgcolor=rowBG1, text_color=color.gray, text_size=dSize)
        table.cell(arbDash, 4, 4, "-", bgcolor=rowBG1, text_color=color.gray, text_size=dSize)
        table.cell(arbDash, 5, 4, "-", bgcolor=rowBG1, text_color=color.gray, text_size=dSize)
    
    // === ARBITRAGE STATUS SECTION ===
    arbHeaderBG = color.new(#1f6feb, 80)
    table.cell(arbDash, 0, 5, "━━━━━ ARBITRAGE STATUS ━━━━━", bgcolor=arbHeaderBG, text_color=#58a6ff, text_size=dSize, text_halign=text.align_center)
    table.merge_cells(arbDash, 0, 5, 5, 5)
    
    // Divergence Status
    divStatusBG = color.new(#161b22, 0)
    string divText = ""
    color divColor = color.gray
    
    if arbDivergence_AB or arbDivergence_AC or arbDivergence_BC
        divText := "⚠️ SIGNAL DIVERGENCE — ARBITRAGE OPPORTUNITY"
        divColor := color.yellow
    else if allBullish
        divText := "🟢 ALL ASSETS BULLISH — FULL CONVERGENCE"
        divColor := color.lime
    else if allBearish
        divText := "🔴 ALL ASSETS BEARISH — FULL CONVERGENCE"
        divColor := color.fuchsia
    else if arbScore >= 2
        divText := "🔶 HIGH TREND DIVERGENCE (" + str.tostring(arbScore) + "/3 PAIRS)"
        divColor := color.orange
    else if arbScore == 1
        divText := "🟡 MILD DIVERGENCE (1/3 PAIRS)"
        divColor := color.yellow
    else
        divText := "⚪ ALL TRENDS ALIGNED — NO OPPORTUNITY"
        divColor := color.gray
    
    table.cell(arbDash, 0, 6, divText, bgcolor=divStatusBG, text_color=divColor, text_size=dSize, text_halign=text.align_center)
    table.merge_cells(arbDash, 0, 6, 5, 6)
    
    // Pair Detail Row
    pairBG = color.new(#0d1117, 0)
    abCol = trendDiv_AB ? color.yellow : color.new(#8b949e, 0)
    acCol = trendDiv_AC ? color.yellow : color.new(#8b949e, 0)
    bcCol = trendDiv_BC ? color.yellow : color.new(#8b949e, 0)
    
    abText = trendDiv_AB ? "⚡ DIVERGED" : "✅ ALIGNED"
    acText = trendDiv_AC ? "⚡ DIVERGED" : "✅ ALIGNED"
    bcText = trendDiv_BC ? "⚡ DIVERGED" : "✅ ALIGNED"
    
    table.cell(arbDash, 0, 7, "A↔B", bgcolor=pairBG, text_color=color.new(#c9d1d9, 0), text_size=dSize)
    table.cell(arbDash, 1, 7, abText, bgcolor=pairBG, text_color=abCol, text_size=dSize)
    table.cell(arbDash, 2, 7, "A↔C", bgcolor=pairBG, text_color=color.new(#c9d1d9, 0), text_size=dSize)
    table.cell(arbDash, 3, 7, acText, bgcolor=pairBG, text_color=acCol, text_size=dSize)
    table.cell(arbDash, 4, 7, "B↔C", bgcolor=pairBG, text_color=color.new(#c9d1d9, 0), text_size=dSize)
    table.cell(arbDash, 5, 7, bcText, bgcolor=pairBG, text_color=bcCol, text_size=dSize)
    
    // RSI Comparison Row
    rsiBG = color.new(#161b22, 0)
    table.cell(arbDash, 0, 8, "📊 RSI", bgcolor=rsiBG, text_color=color.new(#c9d1d9, 0), text_size=dSize)
    table.cell(arbDash, 1, 8, "A: " + str.tostring(rsiVal, "#0.0"), bgcolor=rsiBG, text_color=rsiVal > 60 ? color.lime : rsiVal < 40 ? color.red : color.yellow, text_size=dSize)
    table.cell(arbDash, 2, 8, showSecondary ? "B: " + str.tostring(secRsiVal, "#0.0") : "B: -", bgcolor=rsiBG, text_color=secRsiVal > 60 ? color.lime : secRsiVal < 40 ? color.red : color.yellow, text_size=dSize)
    table.cell(arbDash, 3, 8, showThird ? "C: " + str.tostring(thirdRsiVal, "#0.0") : "C: -", bgcolor=rsiBG, text_color=thirdRsiVal > 60 ? color.lime : thirdRsiVal < 40 ? color.red : color.yellow, text_size=dSize)
    table.cell(arbDash, 4, 8, "Score", bgcolor=rsiBG, text_color=color.new(#c9d1d9, 0), text_size=dSize)
    scoreCol = arbScore == 0 ? color.lime : arbScore == 1 ? color.yellow : arbScore == 2 ? color.orange : color.red
    table.cell(arbDash, 5, 8, str.tostring(arbScore) + "/3", bgcolor=rsiBG, text_color=scoreCol, text_size=dSize)
    
    // Mode Footer
    modeBG = color.new(#21262d, 0)
    table.cell(arbDash, 0, 9, "⚡ " + mode, bgcolor=modeBG, text_color=color.new(#8b949e, 0), text_size=dSize, text_halign=text.align_center)
    table.merge_cells(arbDash, 0, 9, 2, 9)
    table.cell(arbDash, 3, 9, "TF: " + timeframe.period, bgcolor=modeBG, text_color=color.new(#8b949e, 0), text_size=dSize)
    table.cell(arbDash, 4, 9, "Gap: " + str.tostring(chartGap), bgcolor=modeBG, text_color=color.new(#8b949e, 0), text_size=dSize)
    table.cell(arbDash, 5, 9, "v2.0", bgcolor=modeBG, text_color=color.new(#8b949e, 0), text_size=dSize)

// ══════════════════════════════════════════════════════════════════
// --- 14. ALERTS ---
// ══════════════════════════════════════════════════════════════════
alertcondition(buySignal, title="🔷 Asset A — LONG", message="🚀 LONG on A: {{ticker}} @ {{close}}")
alertcondition(sellSignal, title="🔷 Asset A — SHORT", message="🔻 SHORT on A: {{ticker}} @ {{close}}")
alertcondition(secBuySignal, title="🟢 Asset B — LONG", message="🚀 LONG on Asset B")
alertcondition(secSellSignal, title="🟢 Asset B — SHORT", message="🔻 SHORT on Asset B")
alertcondition(thirdBuySignal, title="🔵 Asset C — LONG", message="🚀 LONG on Asset C")
alertcondition(thirdSellSignal, title="🔵 Asset C — SHORT", message="🔻 SHORT on Asset C")

anyBuySignal = buySignal or secBuySignal or thirdBuySignal
anySellSignal = sellSignal or secSellSignal or thirdSellSignal
alertcondition(anyBuySignal, title="⚡ ANY Asset — LONG", message="🚀 LONG signal on one of your assets!")
alertcondition(anySellSignal, title="⚡ ANY Asset — SHORT", message="🔻 SHORT signal on one of your assets!")

anyDivergence = arbDivergence_AB or arbDivergence_AC or arbDivergence_BC
alertcondition(anyDivergence, title="⚠️ ARB — Divergence", message="⚠️ Signal divergence detected! Arbitrage opportunity.")
alertcondition(arbConvergence_Long, title="🟢 ARB — All Long", message="🟢 All 3 assets LONG convergence!")
alertcondition(arbConvergence_Short, title="🔴 ARB — All Short", message="🔴 All 3 assets SHORT convergence!")
alertcondition(arbScore >= 2, title="🔶 ARB — High Divergence", message="🔶 High divergence score (2+/3).")
