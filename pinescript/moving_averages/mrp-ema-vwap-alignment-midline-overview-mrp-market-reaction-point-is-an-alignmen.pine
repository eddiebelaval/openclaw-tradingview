//@version=6
indicator('MRP', overlay = true)

// ===== Inputs =====
emaLength = input.int(21, 'EMA Length', minval = 1)

// ===== Core =====
vwapValue = ta.vwap
emaValue = ta.ema(close, emaLength)

// Alignment condition
bullAlign = emaValue > vwapValue
bearAlign = emaValue < vwapValue

// Midline only when aligned
mrpRaw = (emaValue + vwapValue) / 2

// When not aligned, hold previous value (avoid flip noise)
var float mrpLine = na
mrpLine := bullAlign or bearAlign ? mrpRaw : mrpLine[1]

// Slope
mrpUp = mrpLine > mrpLine[1]
mrpDown = mrpLine < mrpLine[1]

// Color logic
lineColor = bullAlign and mrpUp ? color.lime : bearAlign and mrpDown ? color.red : color.gray

plot(mrpLine, title = 'MRP Line', color = lineColor, linewidth = 2)
