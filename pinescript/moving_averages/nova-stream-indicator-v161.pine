//@version=6
// Reference: Nova_Stream_Indicator_V16.1 (Clean Version)
indicator("Nova_Stream Indicator V16.1", shorttitle="NS_V16.1", overlay=true)

// --- 1. INPUTS --- [cite: 2025-12-29]
language   = input.string("English", "Language", options=["English", "Persian", "Spanish", "French", "German", "Turkish", "Arabic", "Russian", "Chinese", "Japanese", "Italian"]) 
tableSize  = input.string("normal", "Table Size", options=["tiny", "small", "normal", "large", "huge"])
tablePos   = input.string("top_right", "Table Position", options=["top_right", "bottom_right", "top_left", "bottom_left"])

// --- SF CONTROL INPUTS --- [cite: 2025-12-30]
sfSens      = input.float(3.5, "SF Sensitivity (Overbought)", minval=1.0, step=0.1)
exitWaveSel = input.int(3, "Exit Wave (1-6)", minval=1, maxval=6)

// --- 2. WAVE STRUCTURE (12 LINES) - PROTECTED [cite: 2025-12-29, 2026-01-05]
f1=ta.ema(close,3), f2=ta.ema(close,5), f3=ta.ema(close,8), f4=ta.ema(close,10), f5=ta.ema(close,12), f6=ta.ema(close,15)
s1=ta.ema(close,50), s2=ta.ema(close,60), s3=ta.ema(close,70), s4=ta.ema(close,80), s5=ta.ema(close,90), s6=ta.ema(close,100)
backbone = ta.ema(close, 200)

// Dynamic exit wave selection [cite: 2025-12-30]
float exitWave = switch exitWaveSel
    1 => f1
    2 => f2
    3 => f3
    4 => f4
    5 => f5
    6 => f6
    => f3

// --- 3. TREND LOGIC --- [cite: 2025-12-29]
lookback = 20 
slopeThreshold = 0.002 
backboneTrendLine = ta.linreg(backbone, lookback, 0)
previousTrendLine = ta.linreg(backbone[1], lookback, 0)
slopeDirection = backboneTrendLine - previousTrendLine
isStrongTrendUp   = slopeDirection > (backbone * slopeThreshold / 100) 
isStrongTrendDown = slopeDirection < -(backbone * slopeThreshold / 100)
waveDistance = math.abs(f6 - s1)
isNotSqueezed = waveDistance > ta.atr(14) * 0.2 

// --- MTF LOGIC --- [cite: 2026-01-05]
higherTF = timeframe.isintraday and timeframe.multiplier < 60 ? "60" : timeframe.period
htfBackbone = request.security(syminfo.tickerid, higherTF, ta.ema(close, 200))
htfPrice    = request.security(syminfo.tickerid, higherTF, close)
htfTrendUp  = htfPrice > htfBackbone
htfTrendDown = htfPrice < htfBackbone

// --- 4. CORE LOGIC --- [cite: 2025-12-29]
blueAboveOrange = f6 > s1
blueBelowOrange = f6 < s1
atrVal = ta.atr(14)
distOrange = close - s1
isOverbought = distOrange > (atrVal * sfSens)
isOversold   = distOrange < -(atrVal * sfSens)
strengthScore = math.abs(slopeDirection) / (backbone * 0.001 / 100)
string strengthBar = strengthScore > 3.0 ? "█████" : strengthScore > 2.0 ? "████░" : strengthScore > 1.0 ? "██░░░" : "█░░░░"
volFlow = close > open ? volume : -volume
netVol = ta.sma(volFlow, 20)
string volText = (netVol > 0 ? "+" : "") + str.format("{0,number,#.#M}", netVol / 1000000)

// --- 5. SUPER SIGNAL (SN) LOGIC --- [cite: 2026-01-05, 2025-12-29]
isDistSafe = math.abs(distOrange) <= atrVal * sfSens
isGreen = close > open
isRed   = close < open

superBuy   = blueAboveOrange and close > backbone and open > backbone and isGreen and isNotSqueezed and isDistSafe and isStrongTrendUp and netVol > 0 and not isOverbought and htfTrendUp
superSell  = blueBelowOrange and close < backbone and open < backbone and isRed and isNotSqueezed and isDistSafe and isStrongTrendDown and netVol < 0 and not isOversold and htfTrendDown

normalBuy  = (ta.crossover(close, backbone) or (f6 > backbone and s1 > backbone)) and blueAboveOrange and isStrongTrendUp and isNotSqueezed and htfTrendUp
normalSell = (f6 < backbone and s1 < backbone) and blueBelowOrange and isStrongTrendDown and isNotSqueezed and htfTrendDown

// --- 6. SIGNAL MANAGEMENT --- [cite: 2025-12-30]
var int lastPos = 0
finalSPBuy  = superBuy and lastPos != 1
finalSPSell = superSell and lastPos != -1
finalBuy    = normalBuy and not superBuy and lastPos != 1
finalSell   = normalSell and not superSell and lastPos != -1

if finalBuy or finalSPBuy
    lastPos := 1
if finalSell or finalSPSell
    lastPos := -1

// --- 6.1 SAFE EXIT (SF) LOGIC --- [cite: 2025-12-30]
var bool sfBuyTriggered = false
var bool sfSellTriggered = false
if (finalBuy or finalSPBuy)
    sfBuyTriggered := false
if (finalSell or finalSPSell)
    sfSellTriggered := false

trendWeakeningUp   = slopeDirection < slopeDirection[1]
trendWeakeningDown = slopeDirection > slopeDirection[1]
sfBuySignal = lastPos == 1 and isOverbought and (close < exitWave or trendWeakeningUp) and not sfBuyTriggered
if sfBuySignal
    sfBuyTriggered := true
sfSellSignal = lastPos == -1 and isOversold and (close > exitWave or trendWeakeningDown) and not sfSellTriggered
if sfSellSignal
    sfSellTriggered := true

// --- 7. UI ENGINE --- [cite: 2026-01-05]
getTranslation(label, lang) =>
    switch lang
        "Persian" => label == "Status" ? "وضعیت بازار" : label == "Buy" ? "خرید" : label == "Sell" ? "فروش" : label == "SN Buy" ? "SN خرید" : label == "SN Sell" ? "SN فروش" : label == "Squeeze" ? "تراکم" : label == "Dist" ? "فاصله" : label == "Strength" ? "قدرت" : label == "Flow" ? "جریان" : label == "Risk" ? "ریسک" : label
        "Arabic"  => label == "Status" ? "الحالة" : label == "Buy" ? "شراء" : label == "Sell" ? "بيع" : label == "SN Buy" ? "SN شراء" : label == "SN Sell" ? "SN بيع" : label == "Squeeze" ? "ضغط" : label == "Dist" ? "مسافة" : label == "Strength" ? "قوة" : label == "Flow" ? "تدفق" : label == "Risk" ? "خطر" : label
        "Spanish" => label == "Status" ? "Estado" : label == "Buy" ? "Compra" : label == "Sell" ? "Venta" : label == "SN Buy" ? "SN Compra" : label == "SN Sell" ? "SN Venta" : label == "Squeeze" ? "Apretón" : label == "Dist" ? "Distancia" : label == "Strength" ? "Fuerza" : label == "Flow" ? "Flujo" : label == "Risk" ? "Riesgo" : label
        "French"  => label == "Status" ? "Statut" : label == "Buy" ? "Achat" : label == "Sell" ? "Vente" : label == "SN Buy" ? "SN Achat" : label == "SN Sell" ? "SN Vente" : label == "Squeeze" ? "Squeeze" : label == "Dist" ? "Distance" : label == "Strength" ? "Force" : label == "Flow" ? "Flux" : label == "Risk" ? "Risque" : label
        "German"  => label == "Status" ? "Status" : label == "Buy" ? "Kauf" : label == "Sell" ? "Verkauf" : label == "SN Buy" ? "SN Kauf" : label == "SN Sell" ? "SN Verkauf" : label == "Squeeze" ? "Quetschen" : label == "Dist" ? "Abstand" : label == "Strength" ? "Stärke" : label == "Flow" ? "Fluss" : label == "Risk" ? "Risiko" : label
        "Turkish" => label == "Status" ? "Durum" : label == "Buy" ? "Al" : label == "Sell" ? "Sat" : label == "SN Buy" ? "SN Al" : label == "SN Sell" ? "SN Sat" : label == "Squeeze" ? "Sıkışما" : label == "Dist" ? "Mesafe" : label == "Strength" ? "Güç" : label == "Flow" ? "Akış" : label == "Risk" ? "Risk" : label
        "Russian" => label == "Status" ? "Статус" : label == "Buy" ? "Купить" : label == "Sell" ? "Продать" : label == "SN Buy" ? "SN Купить" : label == "SN Sell" ? "SN Продать" : label == "Squeeze" ? "Сжатие" : label == "Dist" ? "Дистанция" : label == "Strength" ? "Сила" : label == "Flow" ? "Поток" : label == "Risk" ? "Риск" : label
        "Chinese" => label == "Status" ? "状态" : label == "Buy" ? "买入" : label == "Sell" ? "卖出" : label == "SN Buy" ? "SN 买入" : label == "SN Sell" ? "SN 卖出" : label == "Squeeze" ? "挤压" : label == "Dist" ? "距离" : label == "Strength" ? "强度" : label == "Flow" ? "流量" : label == "Risk" ? "风险" : label
        "Japanese"=> label == "Status" ? "ステータス" : label == "Buy" ? "買い" : label == "Sell" ? "売り" : label == "SN Buy" ? "SN 買い" : label == "SN Sell" ? "SN 売り" : label == "Squeeze" ? "スクイーズ" : label == "Dist" ? "距離" : label == "Strength" ? "強さ" : label == "Flow" ? "フロー" : label == "Risk" ? "リスク" : label
        "Italian" => label == "Status" ? "Stato" : label == "Buy" ? "Compra" : label == "Sell" ? "Vendita" : label == "SN Buy" ? "SN Compra" : label == "SN Sell" ? "SN Vendita" : label == "Squeeze" ? "Squeeze" : label == "Dist" ? "Distanza" : label == "Strength" ? "Forza" : label == "Flow" ? "Flusso" : label == "Risk" ? "Rischio" : label
        => label == "Status" ? "Market Status" : label == "Buy" ? "Buy Nova" : label == "Sell" ? "Sell Nova" : label == "SN Buy" ? "Super Nova Buy" : label == "SN Sell" ? "Super Nova Sell" : label == "Squeeze" ? "Squeeze Radar" : label == "Dist" ? "Dist. Backbone" : label == "Strength" ? "Trend Strength" : label == "Flow" ? "Volume Flow" : label == "Risk" ? "Correction Risk" : label

getSize(s) => s == "tiny" ? size.tiny : s == "small" ? size.small : s == "large" ? size.large : s == "huge" ? size.huge : size.normal
getPos(p) => p == "bottom_right" ? position.bottom_right : p == "top_left" ? position.top_left : p == "bottom_left" ? position.bottom_left : position.top_right

infoTable = table.new(getPos(tablePos), 2, 10, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 70))

if barstate.islast
    string mTrend = (not isStrongTrendUp and not isStrongTrendDown) or not isNotSqueezed ? (language == "Persian" ? "رنج ⚖️" : "RANGE ⚖️") : isStrongTrendUp ? (language == "Persian" ? "صعودی 🚀" : "BULL 🚀") : (language == "Persian" ? "نزولی 📉" : "BEAR 📉")
    color mCol = (not isStrongTrendUp and not isStrongTrendDown) or not isNotSqueezed ? color.yellow : isStrongTrendUp ? color.green : color.red
    tSize = getSize(tableSize)
    string sqIcon = isNotSqueezed ? "🟢" : "⭕" 
    string dIcon  = isDistSafe ? "✔️" : "⚠️"
    string corText = isOverbought ? (language == "Persian" ? "اشباع خرید ⚠️" : "OVERBOUGHT ⚠️") : isOversold ? (language == "Persian" ? "اشباع فروش ⚠️" : "OVERSOLD ⚠️") : (language == "Persian" ? "عادی" : "STABLE")
    color corCol   = isOverbought or isOversold ? color.new(color.red, 20) : color.new(color.green, 20)

    table.cell(infoTable, 0, 0, getTranslation("Status", language), text_color=color.gray, text_size=tSize)
    table.cell(infoTable, 1, 0, mTrend, bgcolor=mCol, text_color=color.black, text_size=tSize)
    table.cell(infoTable, 0, 1, getTranslation("Buy", language), text_color=color.white, text_size=tSize)
    table.cell(infoTable, 1, 1, lastPos == 1 ? "ACTIVE" : "WAIT", bgcolor=lastPos == 1 ? color.new(color.green, 20) : color.new(color.gray, 80), text_size=tSize)
    table.cell(infoTable, 0, 2, getTranslation("Sell", language), text_color=color.white, text_size=tSize)
    table.cell(infoTable, 1, 2, lastPos == -1 ? "ACTIVE" : "WAIT", bgcolor=lastPos == -1 ? color.new(color.red, 20) : color.new(color.gray, 80), text_size=tSize)
    table.cell(infoTable, 0, 3, getTranslation("SN Buy", language), text_color=color.yellow, text_size=tSize)
    table.cell(infoTable, 1, 3, superBuy ? "ACTIVE" : "---", bgcolor=superBuy ? color.new(color.yellow, 20) : color.new(color.gray, 80), text_size=tSize)
    table.cell(infoTable, 0, 4, getTranslation("SN Sell", language), text_color=color.orange, text_size=tSize)
    table.cell(infoTable, 1, 4, superSell ? "ACTIVE" : "---", bgcolor=superSell ? color.new(color.orange, 20) : color.new(color.gray, 80), text_size=tSize)
    table.cell(infoTable, 0, 5, getTranslation("Squeeze", language), text_color=color.white, text_size=tSize)
    table.cell(infoTable, 1, 5, sqIcon + (isNotSqueezed ? " Stable" : " Squeeze"), text_size=tSize, text_color=isNotSqueezed ? color.green : color.orange)
    table.cell(infoTable, 0, 6, getTranslation("Dist", language), text_color=color.white, text_size=tSize)
    table.cell(infoTable, 1, 6, dIcon + (isDistSafe ? " Safe" : " Risk"), text_size=tSize, text_color=(isDistSafe ? color.blue : color.red))
    table.cell(infoTable, 0, 7, getTranslation("Strength", language), text_color=color.white, text_size=tSize)
    table.cell(infoTable, 1, 7, strengthBar, text_size=tSize, text_color=color.aqua)
    table.cell(infoTable, 0, 8, getTranslation("Flow", language), text_color=color.white, text_size=tSize)
    table.cell(infoTable, 1, 8, volText, text_size=tSize, bgcolor=netVol > 0 ? color.new(color.green, 40) : color.new(color.red, 40), text_color=color.white)
    table.cell(infoTable, 0, 9, getTranslation("Risk", language), text_color=color.white, text_size=tSize)
    table.cell(infoTable, 1, 9, corText, text_size=tSize, bgcolor=corCol, text_color=color.white)

// --- 8. VISUALS --- [cite: 2025-12-29, 2026-01-05]
plot(backbone, color=isStrongTrendUp ? color.white : color.red, linewidth=3, title="Backbone")
plot(f1, color=color.new(color.blue, 85)), plot(f2, color=color.new(color.blue, 80)), plot(f3, color=color.new(color.blue, 75))
plot(f4, color=color.new(color.blue, 70)), plot(f5, color=color.new(color.blue, 65)), plot(f6, color=color.blue, linewidth=2)
p1=plot(s1, color=color.new(color.orange, 70)), p2=plot(s2, color=color.new(color.orange, 75)), p3=plot(s3, color=color.new(color.orange, 80))
p4=plot(s4, color=color.new(color.orange, 85)), p5=plot(s5, color=color.new(color.orange, 90)), p6=plot(s6, color=color.new(color.orange, 70))
fill(p1, p6, color.new(color.orange, 90))

plotshape(finalBuy, "Buy", shape.triangleup, location.belowbar, color.green, size=size.small, text="BUY")
plotshape(finalSell, "Sell", shape.triangledown, location.abovebar, color.red, size=size.small, text="SELL")
plotshape(finalSPBuy, "Super Buy SN", shape.diamond, location.belowbar, color.yellow, size=size.small, text="SN")
plotshape(finalSPSell, "Super Sell SN", shape.diamond, location.abovebar, color.orange, size=size.small, text="SN")

plotshape(sfBuySignal, "Safe Exit Buy", shape.labeldown, location.abovebar, color.aqua, size=size.tiny, text="SF", textcolor=color.black)
plotshape(sfSellSignal, "Safe Exit Sell", shape.labelup, location.belowbar, color.purple, size=size.tiny, text="SF", textcolor=color.white)

// --- 9. ALERTS --- [cite: 2025-12-30]
alertcondition(finalBuy,   "Nova Buy", "Buy Nova Signal")
alertcondition(finalSell,  "Nova Sell", "Sell Nova Signal")
alertcondition(finalSPBuy, "SuperNova Buy SN", "SUPER NOVA BUY SN")
alertcondition(finalSPSell,"SuperNova Sell SN", "SUPER NOVA SELL SN")
alertcondition(sfBuySignal or sfSellSignal, "Safe Exit SF", "Correction Risk: SF Exit Signal")
