//@version=5
indicator("Zoe 1m Clean-Confirm v4 (RSI+MACD+ATR)", overlay=true, max_labels_count=500)

// ========= Inputs =========
fastLen   = input.int(13, "EMA Fast", minval=1)
slowLen   = input.int(34, "EMA Slow", minval=1)
useVWAP   = input.bool(true, "Use VWAP Trend Filter")

rsiLen    = input.int(14, "RSI Length", minval=1)
rsiOB     = input.int(70, "RSI Overbought", minval=50, maxval=95)
rsiOS     = input.int(30, "RSI Oversold", minval=5,  maxval=50)

macdFast  = input.int(12, "MACD Fast", minval=1)
macdSlow  = input.int(26, "MACD Slow", minval=1)
macdSig   = input.int(9,  "MACD Signal", minval=1)

atrLen    = input.int(14, "ATR Length", minval=1)
atrMult   = input.float(0.8, "ATR Distance Filter (xATR)", step=0.1)

showPre   = input.bool(true,  "Show PRE-Signal (grey)")
showConf  = input.bool(true,  "Show CONFIRM Signal (colored)")
showBG    = input.bool(false, "Background Trend Shade")

// ========= Core =========
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
vwapVal = ta.vwap(close)

rsi     = ta.rsi(close, rsiLen)
[macdLine, sigLine, hist] = ta.macd(close, macdFast, macdSlow, macdSig)

atr     = ta.atr(atrLen)

// Trend filter
bullTrend = emaFast > emaSlow and (not useVWAP or close > vwapVal)
bearTrend = emaFast < emaSlow and (not useVWAP or close < vwapVal)

// ATR distance filter (avoid weak/noise entries)
bullAtrOk = (close - emaFast) > atr * atrMult
bearAtrOk = (emaFast - close) > atr * atrMult

// MACD momentum confirm
bullMacdOk = macdLine > sigLine and hist > 0
bearMacdOk = macdLine < sigLine and hist < 0

// RSI logic:
// - For long: prefer RSI rising out of oversold OR staying below overbought (not extreme)
// - For short: prefer RSI falling out of overbought OR staying above oversold (not extreme)
bullRsiOk = (ta.crossover(rsi, rsiOS) or (rsi > 50 and rsi < rsiOB))
bearRsiOk = (ta.crossunder(rsi, rsiOB) or (rsi < 50 and rsi > rsiOS))

// ========= Signals =========
// PRE = structure + (RSI OR MACD) gives you heads-up
preLong  = bullTrend and (bullRsiOk or bullMacdOk)
preShort = bearTrend and (bearRsiOk or bearMacdOk)

// CONFIRM = structure + RSI + MACD + ATR (stricter, fewer false entries)
confLong  = bullTrend and bullRsiOk and bullMacdOk and bullAtrOk
confShort = bearTrend and bearRsiOk and bearMacdOk and bearAtrOk

// ========= Plots =========
plot(emaFast, color=color.orange, linewidth=2, title="EMA Fast")
plot(emaSlow, color=color.blue,   linewidth=2, title="EMA Slow")
plot(useVWAP ? vwapVal : na, color=color.purple, linewidth=2, title="VWAP")

// PRE signal (grey)
plotshape(showPre and preLong,  title="PRE Long",  style=shape.circle, location=location.belowbar, size=size.tiny, color=color.new(color.gray, 0), text="pre")
plotshape(showPre and preShort, title="PRE Short", style=shape.circle, location=location.abovebar, size=size.tiny, color=color.new(color.gray, 0), text="pre")

// CONFIRM signal (colored arrows)
plotshape(showConf and confLong,  title="CONF Long",  style=shape.triangleup,   location=location.belowbar, size=size.small, color=color.new(color.lime, 0), text="BUY")
plotshape(showConf and confShort, title="CONF Short", style=shape.triangledown, location=location.abovebar, size=size.small, color=color.new(color.red,  0), text="SELL")

// Optional background
bgcolor(showBG and bullTrend ? color.new(color.green, 92) : na)
bgcolor(showBG and bearTrend ? color.new(color.red,   92) : na)

// ========= Alerts =========
alertcondition(confLong,  title="Zoe CONF Long",  message="Zoe CONF Long: Trend+RSI+MACD+ATR confirmed")
alertcondition(confShort, title="Zoe CONF Short", message="Zoe CONF Short: Trend+RSI+MACD+ATR confirmed")
