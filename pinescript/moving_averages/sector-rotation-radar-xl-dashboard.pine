//@version=6
indicator("Sector Rotation Radar (XL*) • PRO Dashboard + Breadth + Alerts", overlay=true, max_labels_count=500)

//──────────────────────────────────────────────────────────────────────────────
// Inputs
//──────────────────────────────────────────────────────────────────────────────
benchSym  = input.symbol("SPY", "Benchmark (Market)", confirm=true)
showTable = input.bool(true, "Show Table")
calcMode  = input.string("Current TF", "Compute on", options=["Current TF","Weekly"])

// Universe
preset = input.string("All (XL*)", "Universe preset", options=["All (XL*)","Cyclical","Defensive"])
useXLC  = input.bool(true, "Include XLC (Comm.)")
useXLY  = input.bool(true, "Include XLY (Discretionary)")
useXLP  = input.bool(true, "Include XLP (Staples)")
useXLE  = input.bool(true, "Include XLE (Energy)")
useXLF  = input.bool(true, "Include XLF (Financials)")
useXLI  = input.bool(true, "Include XLI (Industrials)")
useXLK  = input.bool(true, "Include XLK (Tech)")
useXLB  = input.bool(true, "Include XLB (Materials)")
useXLV  = input.bool(true, "Include XLV (Health Care)")
useXLU  = input.bool(true, "Include XLU (Utilities)")
useXLRE = input.bool(true, "Include XLRE (Real Estate)")

// Breadth + Alerts
showBreadthRow = input.bool(true, "Show breadth row")
enableAlerts   = input.bool(true, "Enable alertconditions")
riskOnThresh   = input.int(7, "Risk-on threshold (MA200 breadth)", minval=0, maxval=11)
riskOffThresh  = input.int(4, "Risk-off threshold (MA200 breadth)", minval=0, maxval=11)

posOpt  = input.string("Middle Right", "Table anchor",
     options=["Top Right","Top Center","Top Left",
              "Middle Right","Middle Center","Middle Left",
              "Bottom Right","Bottom Center","Bottom Left"])

padTop  = input.int(6, "Pad rows (top)", minval=0, maxval=30)
padLeft = input.int(0, "Pad cols (left)", minval=0, maxval=15)

txtSizeOpt = input.string("Small", "Text size", options=["Tiny","Small","Normal","Large","Huge"])

// Colors
headerBg   = input.color(color.rgb(45, 50, 58), "Header background")
headerTxt  = input.color(color.white,           "Header text color")
rowTxt     = input.color(color.rgb(30, 30, 30), "Row text (neutral)")

bgGood     = input.color(color.rgb(199, 226, 201), "Positive row background")
bgBad      = input.color(color.rgb(242, 186, 186), "Negative row background")
bgBase     = input.color(color.rgb(232, 232, 232), "Neutral row background")

breadthBg  = input.color(color.rgb(35, 38, 46), "Breadth row background")
breadthTxt = input.color(color.white,          "Breadth row text color")

borderW    = input.int(1, "Border width", minval=0, maxval=5)
borderC    = input.color(color.new(color.white, 70), "Border color")

// Fonts
posFont = input.color(color.rgb(0, 51, 42),   "Positive value font  #00332a")
negFont = input.color(color.rgb(128, 25, 34), "Negative value font  #801922")

// Score settings (bars in chosen TF)
lb1 = input.int(21,  "Lookback 1 (bars in chosen TF)", minval=2)
lb2 = input.int(63,  "Lookback 2 (bars in chosen TF)", minval=3)
lb3 = input.int(126, "Lookback 3 (bars in chosen TF)", minval=4)
w1  = input.float(0.50, "Weight LB1", step=0.05)
w2  = input.float(0.30, "Weight LB2", step=0.05)
w3  = input.float(0.20, "Weight LB3", step=0.05)

// ΔRank lookback
rankLookback = input.int(5, "ΔRank lookback (bars in chosen TF)", minval=1)

//──────────────────────────────────────────────────────────────────────────────
// Helpers
//──────────────────────────────────────────────────────────────────────────────
f_pos(p) =>
    switch p
        "Top Right"     => position.top_right
        "Top Center"    => position.top_center
        "Top Left"      => position.top_left
        "Middle Right"  => position.middle_right
        "Middle Center" => position.middle_center
        "Middle Left"   => position.middle_left
        "Bottom Right"  => position.bottom_right
        "Bottom Center" => position.bottom_center
        "Bottom Left"   => position.bottom_left

f_size(s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge

tfCalc = calcMode == "Weekly" ? "W" : timeframe.period

f_roc(x, len) =>
    len > 0 and not na(x[len]) ? 100 * (x / x[len] - 1) : na

f_score(rs) =>
    float r1 = f_roc(rs, lb1)
    float r2 = f_roc(rs, lb2)
    float r3 = f_roc(rs, lb3)
    w1 * r1 + w2 * r2 + w3 * r3

f_fmt2(x) =>
    na(x) ? "na" : str.tostring(x, "#.##")

f_fmt1(x) =>
    na(x) ? "na" : str.tostring(x, "0.0")

f_rowBg(sc) =>
    na(sc) ? bgBase : (sc >= 0 ? bgGood : bgBad)

f_valTc(x) =>
    na(x) ? rowTxt : (x >= 0 ? posFont : negFont)

f_deltaIcon(d) =>
    d > 0 ? "▲" : d < 0 ? "▼" : "•"

f_badge(rank) =>
    rank <= 3 ? "🔥" : rank >= 9 ? "❄" : "▫️"

// Modern emoji per sector (XL*)
f_emoji(nm) =>
    switch nm
        "XLE"  => "🔋"
        "XLB"  => "⚒️"
        "XLI"  => "🏗️"
        "XLF"  => "🏦"
        "XLK"  => "💻"
        "XLY"  => "🛒"
        "XLP"  => "🧃"
        "XLV"  => "🧬"
        "XLU"  => "🔌"
        "XLRE" => "🏘️"
        => "📡"

f_sectorName(nm) =>
    switch nm
        "XLE"  => "Energy"
        "XLB"  => "Materials"
        "XLI"  => "Industrials"
        "XLF"  => "Financials"
        "XLK"  => "Technology"
        "XLY"  => "Consumer Discretionary"
        "XLP"  => "Consumer Staples"
        "XLV"  => "Health Care"
        "XLU"  => "Utilities"
        "XLRE" => "Real Estate"
        => "Communication Services"

// MA cell: emoji + % distance (1 decimal)
f_maCell(pct) =>
    string out = "na"
    if not na(pct)
        if pct >= 0
            out := "✅ " + str.tostring(pct, "0.0") + "%"
        else
            out := "❌ (" + str.tostring(pct, "0.0") + "%)"
    out

f_maTc(pct) =>
    na(pct) ? rowTxt : (pct >= 0 ? posFont : negFont)

// 1 security call per symbol (TF calc): close, pctToMA50, pctToMA200
f_pack(sym) =>
    request.security(
        sym, tfCalc,
        [
            close,
            100 * (close / ta.sma(close, 50) - 1),
            100 * (close / ta.sma(close, 200) - 1)
        ],
        barmerge.gaps_off, barmerge.lookahead_off
    )

// YTD REAL (always Daily): 1 call per symbol
f_ytd(sym) =>
    request.security(
        sym, "D",
        100 * (close / nz(ta.valuewhen(year != year[1], close, 0), close) - 1),
        barmerge.gaps_off, barmerge.lookahead_off
    )

// Benchmark close (1 call)
benchC = request.security(benchSym, tfCalc, close, barmerge.gaps_off, barmerge.lookahead_off)

// Universe filter
f_isCyc(nm) =>
    nm == "XLE" or nm == "XLB" or nm == "XLI" or nm == "XLF" or nm == "XLK" or nm == "XLY" or nm == "XLRE"

f_isDef(nm) =>
    nm == "XLP" or nm == "XLU" or nm == "XLV" or nm == "XLC"

f_toggle(nm) =>
    switch nm
        "XLC"  => useXLC
        "XLY"  => useXLY
        "XLP"  => useXLP
        "XLE"  => useXLE
        "XLF"  => useXLF
        "XLI"  => useXLI
        "XLK"  => useXLK
        "XLB"  => useXLB
        "XLV"  => useXLV
        "XLU"  => useXLU
        => useXLRE

f_enabled(nm) =>
    bool byPreset = preset == "All (XL*)" ? true : preset == "Cyclical" ? f_isCyc(nm) : f_isDef(nm)
    byPreset and f_toggle(nm)

//──────────────────────────────────────────────────────────────────────────────
// Symbols XL*
//──────────────────────────────────────────────────────────────────────────────
string XLC  = "XLC"
string XLY  = "XLY"
string XLP  = "XLP"
string XLE  = "XLE"
string XLF  = "XLF"
string XLI  = "XLI"
string XLK  = "XLK"
string XLB  = "XLB"
string XLV  = "XLV"
string XLU  = "XLU"
string XLRE = "XLRE"

// Packed data (11 calls)
[cXLC,  p50XLC,  p200XLC ] = f_pack(XLC)
[cXLY,  p50XLY,  p200XLY ] = f_pack(XLY)
[cXLP,  p50XLP,  p200XLP ] = f_pack(XLP)
[cXLE,  p50XLE,  p200XLE ] = f_pack(XLE)
[cXLF,  p50XLF,  p200XLF ] = f_pack(XLF)
[cXLI,  p50XLI,  p200XLI ] = f_pack(XLI)
[cXLK,  p50XLK,  p200XLK ] = f_pack(XLK)
[cXLB,  p50XLB,  p200XLB ] = f_pack(XLB)
[cXLV,  p50XLV,  p200XLV ] = f_pack(XLV)
[cXLU,  p50XLU,  p200XLU ] = f_pack(XLU)
[cXLRE, p50XLRE, p200XLRE] = f_pack(XLRE)

// YTD (11 calls)
ytdXLC  = f_ytd(XLC)
ytdXLY  = f_ytd(XLY)
ytdXLP  = f_ytd(XLP)
ytdXLE  = f_ytd(XLE)
ytdXLF  = f_ytd(XLF)
ytdXLI  = f_ytd(XLI)
ytdXLK  = f_ytd(XLK)
ytdXLB  = f_ytd(XLB)
ytdXLV  = f_ytd(XLV)
ytdXLU  = f_ytd(XLU)
ytdXLRE = f_ytd(XLRE)

// RS ratios vs benchmark
rsXLC  = cXLC  / benchC
rsXLY  = cXLY  / benchC
rsXLP  = cXLP  / benchC
rsXLE  = cXLE  / benchC
rsXLF  = cXLF  / benchC
rsXLI  = cXLI  / benchC
rsXLK  = cXLK  / benchC
rsXLB  = cXLB  / benchC
rsXLV  = cXLV  / benchC
rsXLU  = cXLU  / benchC
rsXLRE = cXLRE / benchC

// Scores
scXLC  = f_score(rsXLC)
scXLY  = f_score(rsXLY)
scXLP  = f_score(rsXLP)
scXLE  = f_score(rsXLE)
scXLF  = f_score(rsXLF)
scXLI  = f_score(rsXLI)
scXLK  = f_score(rsXLK)
scXLB  = f_score(rsXLB)
scXLV  = f_score(rsXLV)
scXLU  = f_score(rsXLU)
scXLRE = f_score(rsXLRE)

// Maps
f_scoreForName(string nm) =>
    switch nm
        "XLC"  => scXLC
        "XLY"  => scXLY
        "XLP"  => scXLP
        "XLE"  => scXLE
        "XLF"  => scXLF
        "XLI"  => scXLI
        "XLK"  => scXLK
        "XLB"  => scXLB
        "XLV"  => scXLV
        "XLU"  => scXLU
        => scXLRE

f_rsForName(string nm) =>
    switch nm
        "XLC" => rsXLC
        "XLY" => rsXLY
        "XLP" => rsXLP
        "XLE" => rsXLE
        "XLF" => rsXLF
        "XLI" => rsXLI
        "XLK" => rsXLK
        "XLB" => rsXLB
        "XLV" => rsXLV
        "XLU" => rsXLU
        => rsXLRE

f_ytdForName(string nm) =>
    switch nm
        "XLC" => ytdXLC
        "XLY" => ytdXLY
        "XLP" => ytdXLP
        "XLE" => ytdXLE
        "XLF" => ytdXLF
        "XLI" => ytdXLI
        "XLK" => ytdXLK
        "XLB" => ytdXLB
        "XLV" => ytdXLV
        "XLU" => ytdXLU
        => ytdXLRE

f_p50ForName(string nm) =>
    switch nm
        "XLC" => p50XLC
        "XLY" => p50XLY
        "XLP" => p50XLP
        "XLE" => p50XLE
        "XLF" => p50XLF
        "XLI" => p50XLI
        "XLK" => p50XLK
        "XLB" => p50XLB
        "XLV" => p50XLV
        "XLU" => p50XLU
        => p50XLRE

f_p200ForName(string nm) =>
    switch nm
        "XLC" => p200XLC
        "XLY" => p200XLY
        "XLP" => p200XLP
        "XLE" => p200XLE
        "XLF" => p200XLF
        "XLI" => p200XLI
        "XLK" => p200XLK
        "XLB" => p200XLB
        "XLV" => p200XLV
        "XLU" => p200XLU
        => p200XLRE

//──────────────────────────────────────────────────────────────────────────────
// Build enabled universe (names list)
// NOTE: This is built on isfirst (requires reload to reflect toggle/preset changes)
//──────────────────────────────────────────────────────────────────────────────
var string[] names = array.new_string()
if barstate.isfirst
    if f_enabled("XLC")
        array.push(names, "XLC")
    if f_enabled("XLY")
        array.push(names, "XLY")
    if f_enabled("XLP")
        array.push(names, "XLP")
    if f_enabled("XLE")
        array.push(names, "XLE")
    if f_enabled("XLF")
        array.push(names, "XLF")
    if f_enabled("XLI")
        array.push(names, "XLI")
    if f_enabled("XLK")
        array.push(names, "XLK")
    if f_enabled("XLB")
        array.push(names, "XLB")
    if f_enabled("XLV")
        array.push(names, "XLV")
    if f_enabled("XLU")
        array.push(names, "XLU")
    if f_enabled("XLRE")
        array.push(names, "XLRE")

int n = array.size(names)

//──────────────────────────────────────────────────────────────────────────────
// Ranking utilities
//──────────────────────────────────────────────────────────────────────────────
f_buildRanks(float[] srcScores) =>
    int nLoc = array.size(srcScores)
    int[] idx = array.new_int(nLoc, 0)
    int[] rk  = array.new_int(nLoc, 0)

    for i = 0 to nLoc - 1
        array.set(idx, i, i)

    for i = 0 to nLoc - 2
        int best = i
        float bestVal = array.get(srcScores, array.get(idx, i))
        for j = i + 1 to nLoc - 1
            float v = array.get(srcScores, array.get(idx, j))
            if na(bestVal) or (not na(v) and v > bestVal)
                best := j
                bestVal := v
        int tmp = array.get(idx, i)
        array.set(idx, i, array.get(idx, best))
        array.set(idx, best, tmp)

    for r = 0 to nLoc - 1
        int id = array.get(idx, r)
        array.set(rk, id, r + 1)

    rk

// Score arrays
float[] scArr     = array.new_float(n, na)
float[] scPrevArr = array.new_float(n, na)

for i = 0 to n - 1
    string nm = array.get(names, i)
    float scNow = f_scoreForName(nm)
    array.set(scArr, i, scNow)
    array.set(scPrevArr, i, scNow[rankLookback])

int[] rkNow  = f_buildRanks(scArr)
int[] rkPrev = f_buildRanks(scPrevArr)

// sort display by rkNow asc
int[] idxShow = array.new_int(n, 0)
for i = 0 to n - 1
    array.set(idxShow, i, i)

for i = 0 to n - 2
    int best = i
    int bestR = array.get(rkNow, array.get(idxShow, i))
    for j = i + 1 to n - 1
        int rj = array.get(rkNow, array.get(idxShow, j))
        if rj < bestR
            best := j
            bestR := rj
    int tmp = array.get(idxShow, i)
    array.set(idxShow, i, array.get(idxShow, best))
    array.set(idxShow, best, tmp)

//──────────────────────────────────────────────────────────────────────────────
// Breadth (no extra security calls)
//──────────────────────────────────────────────────────────────────────────────
int breadth200 = 0
for i = 0 to n - 1
    string nm = array.get(names, i)
    float p200 = f_p200ForName(nm)
    if not na(p200) and p200 >= 0
        breadth200 += 1

int breadthPrev = nz(breadth200[1])
int breadthDelta = breadth200 - breadthPrev

string stateTxt = breadth200 >= riskOnThresh ? "Risk-on" : breadth200 <= riskOffThresh ? "Risk-off" : "Neutral"
string deltaTxt = breadthDelta > 0 ? "▲" + str.tostring(breadthDelta) : breadthDelta < 0 ? "▼" + str.tostring(math.abs(breadthDelta)) : "•0"
string breadthLine = "BREADTH (MA200): " + str.tostring(breadth200) + "/" + str.tostring(n) + "  |  " + stateTxt + "  |  " + deltaTxt

//──────────────────────────────────────────────────────────────────────────────
// Alerts (GLOBAL SCOPE) ✅ fixed
//──────────────────────────────────────────────────────────────────────────────
string leaderNm = n > 0 ? array.get(names, array.get(idxShow, 0)) : ""
string top3key  = ""
if n >= 3
    top3key := array.get(names, array.get(idxShow, 0)) + "," + array.get(names, array.get(idxShow, 1)) + "," + array.get(names, array.get(idxShow, 2))

bool leaderChanged = leaderNm != leaderNm[1] and not na(leaderNm[1])
bool top3Changed   = top3key  != top3key[1] and not na(top3key[1])

bool riskOnNow   = breadth200 >= riskOnThresh
bool riskOffNow  = breadth200 <= riskOffThresh
bool riskOnFlip  = riskOnNow and not riskOnNow[1]
bool riskOffFlip = riskOffNow and not riskOffNow[1]

alertcondition(enableAlerts and leaderChanged, "Sector Rotation: Leader changed", "Leader (Rank #1) changed.")
alertcondition(enableAlerts and top3Changed,   "Sector Rotation: Top 3 changed",  "Top 3 sectors changed.")
alertcondition(enableAlerts and riskOnFlip,    "Sector Rotation: Risk-on",        "Breadth MA200 moved to Risk-on regime.")
alertcondition(enableAlerts and riskOffFlip,   "Sector Rotation: Risk-off",       "Breadth MA200 moved to Risk-off regime.")

//──────────────────────────────────────────────────────────────────────────────
// Table
//──────────────────────────────────────────────────────────────────────────────
var table t = table.new(f_pos(posOpt), 16, 60, border_width=borderW, border_color=borderC)

// Generic cell (center)
f_cell(_c, _r, _txt, _bg, _tc) =>
    table.cell(t, _c, _r, _txt, bgcolor=_bg, text_color=_tc, text_size=f_size(txtSizeOpt))

// Left-aligned (ONLY for SECTOR values)
f_cellL(_c, _r, _txt, _bg, _tc) =>
    table.cell(t, _c, _r, _txt, bgcolor=_bg, text_color=_tc, text_size=f_size(txtSizeOpt), text_halign=text.align_left)

if showTable and barstate.islast
    int c0 = padLeft
    int r0 = padTop
    int row = 0

    // Optional breadth row
    if showBreadthRow
        table.merge_cells(t, c0 + 0, r0 + row, c0 + 8, r0 + row)
        f_cell(c0+0, r0+row, breadthLine, breadthBg, breadthTxt)
        row += 1

    int headerRow = r0 + row
    table.merge_cells(t, c0 + 0, headerRow, c0 + 1, headerRow)

    string dHead = "Δ" + (calcMode == "Weekly" ? "1W" : str.tostring(rankLookback))

    // Headers
    f_cell(c0+0, headerRow, "Top R.", headerBg, headerTxt)
    f_cell(c0+2, headerRow, "SECTOR", headerBg, headerTxt)
    f_cell(c0+3, headerRow, dHead,    headerBg, headerTxt)
    f_cell(c0+4, headerRow, "MA50",   headerBg, headerTxt)
    f_cell(c0+5, headerRow, "MA200",  headerBg, headerTxt)
    f_cell(c0+6, headerRow, "SCORE",  headerBg, headerTxt)
    f_cell(c0+7, headerRow, "RS/SPY", headerBg, headerTxt)
    f_cell(c0+8, headerRow, "YTD",    headerBg, headerTxt)

    row += 1

    // Rows
    for k = 0 to n - 1
        int id = array.get(idxShow, k)
        string nm = array.get(names, id)

        float sc   = array.get(scArr, id)
        float rs   = f_rsForName(nm)
        float ytd  = f_ytdForName(nm)
        float p50  = f_p50ForName(nm)
        float p200 = f_p200ForName(nm)

        int rNow  = array.get(rkNow, id)
        int rPrev = array.get(rkPrev, id)
        int dRank = rPrev - rNow

        string badge = f_badge(rNow)
        string dTxt  = f_deltaIcon(dRank) + str.tostring(math.abs(dRank))

        color bg = f_rowBg(sc)

        color tcScore = f_valTc(sc)
        color tcRS    = f_valTc(rs)
        color tcYTD   = f_valTc(ytd)
        color tcD     = dRank == 0 ? rowTxt : (dRank > 0 ? posFont : negFont)

        string sectorTxt = f_emoji(nm) + " $" + nm + " (" + f_sectorName(nm) + ")"

        string ma50Txt   = f_maCell(p50)
        string ma200Txt  = f_maCell(p200)
        color  ma50Tc    = f_maTc(p50)
        color  ma200Tc   = f_maTc(p200)

        // Top R. (icon left, rank right)
        f_cell(c0+0, r0+row, badge,              bg, rowTxt)
        f_cell(c0+1, r0+row, str.tostring(rNow), bg, rowTxt)

        // Sector (left aligned)
        f_cellL(c0+2, r0+row, sectorTxt,         bg, rowTxt)

        // Rest
        f_cell(c0+3, r0+row, dTxt,               bg, tcD)
        f_cell(c0+4, r0+row, ma50Txt,            bg, ma50Tc)
        f_cell(c0+5, r0+row, ma200Txt,           bg, ma200Tc)
        f_cell(c0+6, r0+row, f_fmt2(sc),         bg, tcScore)
        f_cell(c0+7, r0+row, f_fmt2(rs),         bg, tcRS)
        f_cell(c0+8, r0+row, f_fmt1(ytd) + "%",  bg, tcYTD)

        row += 1
