//@version=6
// NQ Trading System — Medium/Slow EMA Bounce
// Toggle between medium EMA (144/169) and slow EMA (432/507) as entry level.

indicator("NQ Medium/Slow EMA Bounce", overlay=true, max_lines_count=500)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
SL       = input.float(20.0, "Stop loss (points)",  group="Risk", minval=1.0)
TP       = input.float(50.0, "Take profit (points)", group="Risk", minval=1.0)
entryEma = input.string("Medium (144/169)", "Entry EMA level",
           options=["Medium (144/169)", "Slow (432/507)"], group="Entry")

// ─── EMAs ─────────────────────────────────────────────────────────────────────
ema144 = ta.ema(close, 144)
ema169 = ta.ema(close, 169)
ema432 = ta.ema(close, 432)
ema507 = ta.ema(close, 507)

medMid  = (ema144 + ema169) / 2
slowMid = (ema432 + ema507) / 2

plot(ema144, "EMA144 Medium", color=#4FAF58,                linewidth=1)
plot(ema169, "EMA169 Medium", color=#9B29AC,                linewidth=1)
plot(ema432, "EMA432 Slow",   color=color.new(#E5531A, 20), linewidth=2)
plot(ema507, "EMA507 Slow",   color=color.new(#801B24, 20), linewidth=2)

entryLevel = entryEma == "Medium (144/169)" ? medMid : slowMid
plot(entryLevel, "Entry Level", color=color.new(color.white, 40), linewidth=1, style=plot.style_circles)

// ─── ZONE BOUNDARIES ──────────────────────────────────────────────────────────
medHi  = math.max(ema144, ema169)
medLo  = math.min(ema144, ema169)
slowHi = math.max(ema432, ema507)
slowLo = math.min(ema432, ema507)

aboveZone = entryEma == "Medium (144/169)" ? close[1] > medHi[1]  : close[1] > slowHi[1]
belowZone = entryEma == "Medium (144/169)" ? close[1] < medLo[1]  : close[1] < slowLo[1]

// ─── TRADE STATE ──────────────────────────────────────────────────────────────
var bool  inTrade = false
var bool  isLong  = false
var float slLevel = na
var float tpLevel = na
var line  slLine  = na
var line  tpLine  = na

bool tradeClosed = false
if inTrade
    if isLong
        if low <= slLevel or high >= tpLevel
            inTrade     := false
            tradeClosed := true
    else
        if high >= slLevel or low <= tpLevel
            inTrade     := false
            tradeClosed := true

if (inTrade or tradeClosed) and not na(slLine)
    line.set_x2(slLine, bar_index)
    line.set_x2(tpLine, bar_index)

// ─── SIGNAL CONDITIONS ────────────────────────────────────────────────────────
longCond  = not inTrade and aboveZone and low <= entryLevel and high > entryLevel
shortCond = not inTrade and belowZone and high >= entryLevel and low < entryLevel

longEntry  = longCond  and not longCond[1]
shortEntry = shortCond and not shortCond[1]

// ─── OPEN TRADE ───────────────────────────────────────────────────────────────
if longEntry
    inTrade := true
    isLong  := true
    slLevel := entryLevel - SL
    tpLevel := entryLevel + TP
    slLine  := line.new(bar_index, slLevel, bar_index, slLevel,
                        color=color.red,   style=line.style_solid, width=1)
    tpLine  := line.new(bar_index, tpLevel, bar_index, tpLevel,
                        color=color.green, style=line.style_solid, width=1)

if shortEntry
    inTrade := true
    isLong  := false
    slLevel := entryLevel + SL
    tpLevel := entryLevel - TP
    slLine  := line.new(bar_index, slLevel, bar_index, slLevel,
                        color=color.red,   style=line.style_solid, width=1)
    tpLine  := line.new(bar_index, tpLevel, bar_index, tpLevel,
                        color=color.green, style=line.style_solid, width=1)

// ─── ARROWS ───────────────────────────────────────────────────────────────────
plotshape(longEntry,  "Buy",  shape.triangleup,   location.belowbar, color.green, size=size.small)
plotshape(shortEntry, "Sell", shape.triangledown, location.abovebar, color.red,   size=size.small)
