//@version=6
indicator("Nested SMA Conditional Bands", overlay = true, max_bars_back=500)

// ── INPUTS ───────────────────────────────────────────────────────────────
group_global = "Envelope Settings"
multPreset   = input.string("1/2", "Multiplier Preset (powers of 2)",  options = ["1/1024","1/512","1/256","1/128","1/64",   "1/32",  "1/16",  "1/8",   "1/4",   "1/2",   "1",     "2",    "4",  "8",     "16",    "32",    "64",    "128",   "256",   "512",  "1024"],tooltip = "Logarithmic steps centered on 1. Use 'Manual Multiplier' field below only if you need a value not in this list.", group=group_global)

manualFine   = input.float(1.0, "Fine-tune × (if needed)", minval=0.00001, step=0.0001, group=group_global)


offsetMode   = input.string("Points", "Offset Mode", options=["Points"], group=group_global)
base_length  = input.int(20, "Base Length (Power-of-2 start)", minval=1, group=group_global)

// ── Shading (always between core MAs) ────────────────────────────────────
group_shade = "Zone Shading Between MAs"
shade1 = input.bool(true, "Shade 1-2", group=group_shade)   
trans1 = input.int(92, "", group=group_shade)
shade2 = input.bool(true, "Shade 2-3", group=group_shade)   
trans2 = input.int(88, "", group=group_shade)
shade3 = input.bool(true, "Shade 3-4", group=group_shade)   
trans3 = input.int(88, "", group=group_shade)
shade4 = input.bool(true, "Shade 4-5", group=group_shade)   
trans4 = input.int(88, "", group=group_shade)
shade5 = input.bool(true, "Shade 5-6", group=group_shade)   
trans5 = input.int(88, "", group=group_shade)
shade6 = input.bool(true, "Shade 6-7", group=group_shade)   
trans6 = input.int(88, "", group=group_shade)
shade7 = input.bool(true, "Shade 7-8", group=group_shade)   
trans7 = input.int(88, "", group=group_shade)

// ── Multiplier ───────────────────────────────────────────────────────────
float mult_base = switch multPreset
    "1/8192"  => 1.0 / 8192
    "1/4096"  => 1.0 / 4096
    "1/2048"  => 1.0 / 2048
    "1/1024"  => 1.0 / 1024
    "1/512"   => 1.0 / 512
    "1/256"   => 1.0 / 256
    "1/128"   => 1.0 / 128
    "1/64"    => 1.0 / 64
    "1/32"    => 1.0 / 32
    "1/16"    => 1.0 / 16
    "1/8"     => 1.0 / 8
    "1/4"     => 1.0 / 4
    "1/2"     => 1.0 / 2
    "1"       => 1.0
    "2"       => 2.0
    "4"       => 4.0
    "8"       => 8.0
    "16"      => 16.0
    "32"      => 32.0
    "64"      => 64.0
    "128"     => 128.0
    "256"     => 256.0
    "512"     => 512.0
    "1024"    => 1024.0
    "2048"    => 2048.0
    "4096"    => 4096.0
    "8192"    => 8192.0
    => 1.0

float final_mult = mult_base * manualFine

// ── Lengths & MAs ────────────────────────────────────────────────────────
len1 = base_length
len2 = base_length * 2
len3 = base_length * 4
len4 = base_length * 8
len5 = base_length * 16
len6 = base_length * 32
len7 = base_length * 64
len8 = base_length * 128

ma1 = ta.sma(close, len1)
ma2 = ta.sma(close, len2)
ma3 = ta.sma(close, len3)
ma4 = ta.sma(close, len4)
ma5 = ta.sma(close, len5)
ma6 = ta.sma(close, len6)
ma7 = ta.sma(close, len7)
ma8 = ta.sma(close, len8)

// ── Deviation ────────────────────────────────────────────────────────────
float deviation = offsetMode == "Points" ?
     0.305176 * final_mult :
     close * (0.00625 / 100) * final_mult

// ── Envelopes ────────────────────────────────────────────────────────────
u1 = ma1 + deviation * 1    
l1 = ma1 - deviation * 1
u2 = ma2 + deviation * 2    
l2 = ma2 - deviation * 2
u3 = ma3 + deviation * 4    
l3 = ma3 - deviation * 4
u4 = ma4 + deviation * 8    
l4 = ma4 - deviation * 8
u5 = ma5 + deviation * 16   
l5 = ma5 - deviation * 16
u6 = ma6 + deviation * 32   
l6 = ma6 - deviation * 32
u7 = ma7 + deviation * 64   
l7 = ma7 - deviation * 64
u8 = ma8 + deviation * 128  
l8 = ma8 - deviation * 128

// ── Per-level high/low conditions ────────────────────────────────────────

// 75% point between ma1 and u1
float upper_quartile1 = ma1 + (u1 - ma1) * 0.75
// 25% point between ma1 and l1
float lower_quartile1 = ma1 + (l1 - ma1) * 0.25   // same as ma1 - (ma1 - l1) * 0.25
float upper_quartile2 = ma2 + (u2 - ma2) * 0.75
float lower_quartile2 = ma2 + (l2 - ma2) * 0.25
float upper_quartile3 = ma3 + (u3 - ma3) * 0.75
float lower_quartile3 = ma3 + (l3 - ma3) * 0.25
float upper_quartile4 = ma4 + (u4 - ma4) * 0.75
float lower_quartile4 = ma4 + (l4 - ma4) * 0.25
float upper_quartile5 = ma5 + (u5 - ma5) * 0.75
float lower_quartile5 = ma5 + (l5 - ma5) * 0.25
float upper_quartile6 = ma6 + (u6 - ma6) * 0.75
float lower_quartile6 = ma6 + (l6 - ma6) * 0.25
float upper_quartile7 = ma7 + (u7 - ma7) * 0.75
float lower_quartile7 = ma7 + (l7 - ma7) * 0.25
float upper_quartile8 = ma8 + (u8 - ma8) * 0.75
float lower_quartile8 = ma8 + (l8 - ma8) * 0.25


// bool up1   = high > ma1  // example
// bool dn1   = low  < ma1  // example

bool up1   = high > upper_quartile1
bool dn1   = low  < lower_quartile1
bool up2   = high > upper_quartile2
bool dn2   = low  < lower_quartile2
bool up3   = high > upper_quartile3
bool dn3   = low  < lower_quartile3
bool up4   = high > upper_quartile4
bool dn4   = low  < lower_quartile4
bool up5   = high > upper_quartile5
bool dn5   = low  < lower_quartile5
bool up6   = high > upper_quartile6
bool dn6   = low  < lower_quartile6
bool up7   = high > upper_quartile7
bool dn7   = low  < lower_quartile7
bool up8   = high > upper_quartile8
bool dn8   = low  < lower_quartile8

// ── Core MAs always visible ──────────────────────────────────────────────
plot(ma1, "MA1", #90bff9, 1)
plot(ma2, "MA2", #ff9800, 1)
plot(ma3, "MA3", #fbff00, 1)
plot(ma4, "MA4", #6bf806, 1)
plot(ma5, "MA5", #3179f5, 1)
plot(ma6, "MA6", #7e57c2, 1)
plot(ma7, "MA7", #ff0022, 1)
plot(ma8, "MA8", #ffffff, 1)

// ── Conditional envelopes — independent per level ────────────────────────
plot(up1 ? u1 : na, "U1", color.new(#90bff9, 45), 1, style = plot.style_linebr)
plot(dn1 ? l1 : na, "L1", color.new(#90bff9, 45), 1, style = plot.style_linebr)

plot(up2 ? u2 : na, "U2", color.new(#ff9800, 45), 1, style = plot.style_linebr)
plot(dn2 ? l2 : na, "L2", color.new(#ff9800, 45), 1, style = plot.style_linebr)

plot(up3 ? u3 : na, "U3", color.new(#fbff00, 45), 1, style = plot.style_linebr)
plot(dn3 ? l3 : na, "L3", color.new(#fbff00, 45), 1, style = plot.style_linebr)

plot(up4 ? u4 : na, "U4", color.new(#6bf806, 45), 1, style = plot.style_linebr)
plot(dn4 ? l4 : na, "L4", color.new(#6bf806, 45), 1, style = plot.style_linebr)

plot(up5 ? u5 : na, "U5", color.new(#3179f5, 45), 1, style = plot.style_linebr)
plot(dn5 ? l5 : na, "L5", color.new(#3179f5, 45), 1, style = plot.style_linebr)

plot(up6 ? u6 : na, "U6", color.new(#7e57c2, 45), 1, style = plot.style_linebr)
plot(dn6 ? l6 : na, "L6", color.new(#7e57c2, 45), 1, style = plot.style_linebr)

plot(up7 ? u7 : na, "U7", color.new(#ff0022, 45), 1, style = plot.style_linebr)
plot(dn7 ? l7 : na, "L7", color.new(#ff0022, 45), 1, style = plot.style_linebr)

plot(up8 ? u8 : na, "U8", color.new(#ffffff, 45), 1, style = plot.style_linebr)
plot(dn8 ? l8 : na, "L8", color.new(#ffffff, 45), 1, style = plot.style_linebr)

// ── Shading between core MAs (always) ────────────────────────────────────
p1 = plot(ma1, display=display.none)
p2 = plot(ma2, display=display.none)
p3 = plot(ma3, display=display.none)
p4 = plot(ma4, display=display.none)
p5 = plot(ma5, display=display.none)
p6 = plot(ma6, display=display.none)
p7 = plot(ma7, display=display.none)
p8 = plot(ma8, display=display.none)

fill(p1,p2, shade1 ? color.new(#90bff9, trans1) : na)
fill(p2,p3, shade2 ? color.new(#ff9800, trans2) : na)
fill(p3,p4, shade3 ? color.new(#fbff00, trans3) : na)
fill(p4,p5, shade4 ? color.new(#6bf806, trans4) : na)
fill(p5,p6, shade5 ? color.new(#3179f5, trans5) : na)
fill(p6,p7, shade6 ? color.new(#7e57c2, trans6) : na)
fill(p7,p8, shade7 ? color.new(#ff0022, trans7) : na)


// ── Multiplier info ──────────────────────────────────────────────────────
var table t = table.new(position.bottom_right, 1, 1, bgcolor=color.new(#000000, 70))
if barstate.islast
    table.cell(t, 0, 0,
         "× " + str.tostring(final_mult, "#.####") + (offsetMode=="Percent"?"%":" pts"),
         text_color = color.white, text_size = size.small)
