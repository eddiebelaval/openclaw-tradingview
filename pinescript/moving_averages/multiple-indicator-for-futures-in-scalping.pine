//@version=6
indicator(".", overlay=true, max_lines_count=500, max_labels_count=500)

// === EMAs ===
ema8   = ta.ema(close, 8)
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)

plot(ema8,   "EMA 8",   color=color.yellow, linewidth=2)
plot(ema20,  "EMA 20",  color=color.aqua, linewidth=2)
plot(ema50,  "EMA 50",  color=color.red, linewidth=2)
plot(ema100, "EMA 100", color=color.green, linewidth=2)
plot(ema200, "EMA 200", color=color.purple, linewidth=2)

// === EMA 500 personalitzable ===
showEMA500  = input.bool(true, "Mostrar EMA 500")
ema500Color = input.color(color.white, "Color EMA 500")
ema500Width = input.int(3, "Gruix EMA 500", minval=1, maxval=5)

ema500 = ta.ema(close, 500)
plot(showEMA500 ? ema500 : na, "EMA 500", color=ema500Color, linewidth=ema500Width)

// === VWAP ===
showVWAP  = input.bool(true, "Mostrar VWAP")
vwapColor = input.color(color.fuchsia, "Color VWAP")
vwapWidth = input.int(2, "Gruix VWAP", 1, 5)
vwapValue = ta.vwap(hlc3)
plot(showVWAP ? vwapValue : na, "VWAP", color=vwapColor, linewidth=vwapWidth)

// === Bollinger Bands ===
bbLength = 20
bbMult   = 2.0
basis = ta.sma(close, bbLength)
dev = bbMult * ta.stdev(close, bbLength)
upper = basis + dev
lower = basis - dev
plot(upper, "BB Upper", color=color.green)
plot(basis, "BB Mid", color=color.orange)
plot(lower, "BB Lower", color=color.red)

// === Fibonacci Pivots Diaris ===
colorPivot = input.color(color.white, "Pivot P")
colorR1S1  = input.color(color.blue, "S1/R1")
colorR2S2  = input.color(color.red, "S2/R2")
colorR3S3  = input.color(color.green, "S3/R3")
pivotSize  = input.string("small","Mida text pivots", options=["tiny","small","normal","large","huge"])
pivotLW = 2

hi = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
lo = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
cl = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
pp = (hi + lo + cl)/3
rangeDay = hi - lo
r1 = pp + 0.382*rangeDay
r2 = pp + 0.618*rangeDay
r3 = pp + 1.0*rangeDay
s1 = pp - 0.382*rangeDay
s2 = pp - 0.618*rangeDay
s3 = pp - 1.0*rangeDay
offsetUp = rangeDay*0.004

var line lineP  = na
var line lineR1 = na
var line lineR2 = na
var line lineR3 = na
var line lineS1 = na
var line lineS2 = na
var line lineS3 = na
var label lblP  = na
var label lblR1 = na
var label lblR2 = na
var label lblR3 = na
var label lblS1 = na
var label lblS2 = na
var label lblS3 = na

if ta.change(time("D")) != 0
    line.delete(lineP)
    line.delete(lineR1)
    line.delete(lineR2)
    line.delete(lineR3)
    line.delete(lineS1)
    line.delete(lineS2)
    line.delete(lineS3)
    label.delete(lblP)
    label.delete(lblR1)
    label.delete(lblR2)
    label.delete(lblR3)
    label.delete(lblS1)
    label.delete(lblS2)
    label.delete(lblS3)

    t0 = time
    t1 = time + 24*60*60*1000

    lineP  := line.new(t0, pp, t1, pp, color=colorPivot,width=pivotLW,xloc=xloc.bar_time)
    lineR1 := line.new(t0, r1, t1, r1, color=colorR1S1,width=pivotLW,xloc=xloc.bar_time)
    lineR2 := line.new(t0, r2, t1, r2, color=colorR2S2,width=pivotLW,xloc=xloc.bar_time)
    lineR3 := line.new(t0, r3, t1, r3, color=colorR3S3,width=pivotLW,xloc=xloc.bar_time)
    lineS1 := line.new(t0, s1, t1, s1, color=colorR1S1,width=pivotLW,xloc=xloc.bar_time)
    lineS2 := line.new(t0, s2, t1, s2, color=colorR2S2,width=pivotLW,xloc=xloc.bar_time)
    lineS3 := line.new(t0, s3, t1, s3, color=colorR3S3,width=pivotLW,xloc=xloc.bar_time)

    lblP  := label.new(t1, pp+offsetUp,"P "+str.tostring(pp,format.mintick), style=label.style_none, textcolor=colorPivot, size=pivotSize,xloc=xloc.bar_time)
    lblR1 := label.new(t1, r1+offsetUp,"R1 "+str.tostring(r1,format.mintick), style=label.style_none, textcolor=colorR1S1, size=pivotSize,xloc=xloc.bar_time)
    lblR2 := label.new(t1, r2+offsetUp,"R2 "+str.tostring(r2,format.mintick), style=label.style_none, textcolor=colorR2S2, size=pivotSize,xloc=xloc.bar_time)
    lblR3 := label.new(t1, r3+offsetUp,"R3 "+str.tostring(r3,format.mintick), style=label.style_none, textcolor=colorR3S3, size=pivotSize,xloc=xloc.bar_time)
    lblS1 := label.new(t1, s1+offsetUp,"S1 "+str.tostring(s1,format.mintick), style=label.style_none, textcolor=colorR1S1, size=pivotSize,xloc=xloc.bar_time)
    lblS2 := label.new(t1, s2+offsetUp,"S2 "+str.tostring(s2,format.mintick), style=label.style_none, textcolor=colorR2S2, size=pivotSize,xloc=xloc.bar_time)
    lblS3 := label.new(t1, s3+offsetUp,"S3 "+str.tostring(s3,format.mintick), style=label.style_none, textcolor=colorR3S3, size=pivotSize,xloc=xloc.bar_time)

// === OHLC personalitzat ===
showDaily   = input.bool(true, "Mostrar OHLC Diari")
showWeekly  = input.bool(true, "Mostrar OHLC Setmanal")
showMonthly = input.bool(true, "Mostrar OHLC Mensual")

colorO_D = input.color(color.blue, "Open Diari")
colorH_D = input.color(color.green, "High Diari anterior")
colorL_D = input.color(color.rgb(9, 239, 255), "Low Diari anterior")
colorC_D = input.color(color.rgb(2, 238, 255), "Close Diari anterior")

colorO_W = input.color(color.rgb(255, 139, 6), "Open Setmanal")
colorH_W = input.color(color.green, "High Setmanal anterior")
colorL_W = input.color(color.red, "Low Setmanal anterior")
colorC_W = input.color(color.orange, "Close Setmanal anterior")

colorO_M = input.color(color.blue, "Open Mensual")
colorH_M = input.color(color.green, "High Mensual anterior")
colorL_M = input.color(color.red, "Low Mensual anterior")
colorC_M = input.color(color.orange, "Close Mensual anterior")

lineWidthDaily   = input.int(1,"Gruix línies Diari",1,5)
lineWidthWeekly  = input.int(1,"Gruix línies Setmanal",1,5)
lineWidthMonthly = input.int(1,"Gruix línies Mensual",1,5)
labelSizeDaily   = input.string("small","Mida labels Diari", options=["tiny","small","normal","large","huge"])
labelSizeWeekly  = input.string("small","Mida labels Setmanal", options=["tiny","small","normal","large","huge"])
labelSizeMonthly = input.string("small","Mida labels Mensual", options=["tiny","small","normal","large","huge"])

// (la resta del codi OHLC queda igual)
