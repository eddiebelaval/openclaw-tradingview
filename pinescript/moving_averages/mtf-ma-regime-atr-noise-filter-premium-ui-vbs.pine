//@version=6
indicator("VictoryByStrategy • MTF MA Regime + ATR Noise Filter (Free v1.0.5 • Premium UI)", overlay=true, max_labels_count=500)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 1) INPUTS (All English + Tooltips)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
grp_core = "1) Core"
maType = input.string(
     "EMA", "MA Type",
     options=["EMA","SMA","RMA","WMA","HMA"],
     tooltip="Select the moving average type used for the chart-timeframe MAs and the HTF bias MA.",
     group=grp_core
)
midLen = input.int(
     20, "Mid MA Length",
     minval=1,
     tooltip="Length for the Mid MA on the current chart timeframe. Used for pullback signals and the ATR noise band center.",
     group=grp_core
)
slowLen = input.int(
     50, "Slow MA Length",
     minval=1,
     tooltip="Length for the Slow MA on the current chart timeframe. Used mainly for visual trend context (not required for signals).",
     group=grp_core
)

grp_mtf = "2) Higher Timeframe (HTF) Bias • MTF"
htfTf = input.timeframe(
     "240", "HTF for Bias (default 4H)",
     tooltip="Higher timeframe used to define the main bias. Default is 4H. Signals are designed to follow this bias.",
     group=grp_mtf
)
htfSlowLen = input.int(
     50, "HTF Slow MA Length",
     minval=1,
     tooltip="Length for the HTF slow MA used to define bias. Example: HTF close above HTF slow MA = bullish bias.",
     group=grp_mtf
)
useSlope = input.bool(
     true, "Use HTF Slope Filter",
     tooltip="If enabled, bullish bias requires HTF slow MA rising; bearish bias requires HTF slow MA falling. Helps reduce whipsaw.",
     group=grp_mtf
)

grp_noise = "3) ATR Noise Filter"
atrLen = input.int(
     14, "ATR Length",
     minval=1,
     tooltip="ATR period used to build the noise band around the Mid MA.",
     group=grp_noise
)
atrMult = input.float(
     1.0, "ATR Multiplier",
     step=0.1,
     tooltip="Noise band width = ATR * multiplier. Larger values = wider band (fewer band breaks).",
     group=grp_noise
)
useNoise = input.bool(
     true, "Show ATR Noise Band",
     tooltip="Plots the ATR-based noise band around the Mid MA. This helps visualize 'normal vs abnormal' movement.",
     group=grp_noise
)
useNoiseForSignals = input.bool(
     false, "Use Noise Filter for Signals (block signals in noise)",
     tooltip="If enabled, signals are blocked while price remains inside the ATR noise band. This reduces signals during choppy conditions.",
     group=grp_noise
)
neutralWhenNoise = input.bool(
     true, "Treat Noise as NEUTRAL (background)",
     tooltip="If enabled, the background becomes Neutral (gray) whenever price is inside the ATR noise band, even if HTF bias is bullish/bearish.",
     group=grp_noise
)

grp_momo = "4) Momentum Confirmation"
rsiLen = input.int(
     14, "RSI Length",
     minval=1,
     tooltip="RSI period used as a lightweight momentum confirmation.",
     group=grp_momo
)
rsiBull = input.int(
     50, "RSI Bull Threshold",
     minval=1, maxval=99,
     tooltip="Bullish momentum condition: RSI must be above this level to allow bullish signals.",
     group=grp_momo
)
rsiBear = input.int(
     50, "RSI Bear Threshold",
     minval=1, maxval=99,
     tooltip="Bearish momentum condition: RSI must be below this level to allow bearish signals.",
     group=grp_momo
)

grp_signals = "5) Signals & Alerts"
signalMode = input.string(
     "Both", "Signal Mode",
     options=["Both","Pullback only","Breakout only"],
     tooltip="Choose which signal type(s) to display.\n• Pullback (PB): trend continuation after a healthy pullback.\n• Breakout (BO): break above/below the ATR noise band in the direction of HTF bias.",
     group=grp_signals
)
directionMode = input.string(
     "Both", "Direction Mode",
     options=["Both","Buy only","Sell only"],
     tooltip="Filter displayed signals by direction.\n• Buy only: show bullish signals only.\n• Sell only: show bearish signals only.",
     group=grp_signals
)
cooldownBars = input.int(
     5, "Signal Cooldown (bars)",
     minval=0,
     tooltip="Minimum number of bars between same-type signals (PB Buy, PB Sell, BO Buy, BO Sell). Use 0 to disable cooldown.",
     group=grp_signals
)

grp_visual = "6) Visual"
showMA = input.bool(
     true, "Plot MAs",
     tooltip="Plots Mid MA and Slow MA on the chart timeframe.",
     group=grp_visual
)
showShapes = input.bool(
     true, "Plot Signal Markers",
     tooltip="Shows PB/BO markers on the chart when signals occur. Disable for a cleaner chart.",
     group=grp_visual
)
showBgBias = input.bool(
     true, "Background by HTF Bias / Neutral",
     tooltip="Colors the background based on HTF bias. Optional: treat noise as Neutral if enabled in the Noise Filter section.",
     group=grp_visual
)
bgOpacity = input.int(
     90, "Background Opacity (0-100)",
     minval=0, maxval=100,
     tooltip="Higher values = more transparent background. 0 is fully opaque, 100 is fully transparent.",
     group=grp_visual
)

grp_status = "7) Status Panel (Overlay)"
showStatus = input.bool(
     true, "Show Status Panel",
     tooltip="Shows a compact overlay panel (top-right) with HTF bias, noise state, gating, and a PB/BO legend.",
     group=grp_status
)
statusSize = input.string(
     "Small", "Panel Size",
     options=["Small","Normal"],
     tooltip="Controls status panel text size and spacing.",
     group=grp_status
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 2) FUNCTIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_ma(_src, _len) =>
    switch maType
        "EMA" => ta.ema(_src, _len)
        "SMA" => ta.sma(_src, _len)
        "RMA" => ta.rma(_src, _len)
        "WMA" => ta.wma(_src, _len)
        "HMA" => ta.hma(_src, _len)

// Cooldown gate using last signal bar index (deterministic + correct)
f_allow_with_cooldown(_sigRaw, _cdBars, _lastBar) =>
    _sigRaw and (_cdBars == 0 or na(_lastBar) or (bar_index - _lastBar > _cdBars))

f_yesno(_b) => _b ? "Yes" : "No"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 3) LOCAL (Chart TF) CALCS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
midMA  = f_ma(close, midLen)
slowMA = f_ma(close, slowLen)

atrVal    = ta.atr(atrLen)
upperBand = midMA + atrVal * atrMult
lowerBand = midMA - atrVal * atrMult

rsiVal   = ta.rsi(close, rsiLen)
momoBull = rsiVal > rsiBull
momoBear = rsiVal < rsiBear

inNoise = close <= upperBand and close >= lowerBand

// Precompute cross events (execute every bar)
xUp_mid   = ta.crossover(close, midMA)
xDn_mid   = ta.crossunder(close, midMA)
xUp_upper = ta.crossover(close, upperBand)
xDn_lower = ta.crossunder(close, lowerBand)

// Signal mode gates
allowPB = signalMode == "Both" or signalMode == "Pullback only"
allowBO = signalMode == "Both" or signalMode == "Breakout only"

// Direction gates
allowBuy  = directionMode == "Both" or directionMode == "Buy only"
allowSell = directionMode == "Both" or directionMode == "Sell only"

// Optional gating: block signals during noise
noiseGateOK = not useNoiseForSignals or not inNoise

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 4) HTF (Atomic MTF) Bias via single request.security (non-repaint)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[htfClose, htfSlow, htfSlowPrev] =
     request.security(
         syminfo.tickerid,
         htfTf,
         [close, f_ma(close, htfSlowLen), f_ma(close, htfSlowLen)[1]],
         barmerge.gaps_off,
         barmerge.lookahead_off
     )

htfSlopeUp = htfSlow > htfSlowPrev
htfSlopeDn = htfSlow < htfSlowPrev

bullBias_raw = htfClose > htfSlow
bearBias_raw = htfClose < htfSlow

bullBias = useSlope ? (bullBias_raw and htfSlopeUp) : bullBias_raw
bearBias = useSlope ? (bearBias_raw and htfSlopeDn) : bearBias_raw
biasNeutral_raw = not bullBias and not bearBias

// Neutral enhancement: treat noise as neutral (visual context)
biasNeutral = neutralWhenNoise ? (biasNeutral_raw or inNoise) : biasNeutral_raw

bullBiasFlip = bullBias and not bullBias[1]
bearBiasFlip = bearBias and not bearBias[1]

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 5) SIGNAL RAW (no cooldown yet)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Pullback (PB): dip to/through Mid MA then reclaim (trend-follow)
pbBuy_raw  = allowPB and allowBuy  and bullBias and momoBull and noiseGateOK and (low <= midMA)  and xUp_mid
pbSell_raw = allowPB and allowSell and bearBias and momoBear and noiseGateOK and (high >= midMA) and xDn_mid

// Breakout (BO): cross outside ATR noise band, aligned with HTF bias
boBuy_raw  = allowBO and allowBuy  and bullBias and momoBull and noiseGateOK and xUp_upper
boSell_raw = allowBO and allowSell and bearBias and momoBear and noiseGateOK and xDn_lower

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 6) COOLDOWN (per-signal, correct)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var int lastPbBuy  = na
var int lastPbSell = na
var int lastBoBuy  = na
var int lastBoSell = na

pbBuy  = f_allow_with_cooldown(pbBuy_raw,  cooldownBars, lastPbBuy)
pbSell = f_allow_with_cooldown(pbSell_raw, cooldownBars, lastPbSell)
boBuy  = f_allow_with_cooldown(boBuy_raw,  cooldownBars, lastBoBuy)
boSell = f_allow_with_cooldown(boSell_raw, cooldownBars, lastBoSell)

if pbBuy
    lastPbBuy := bar_index
if pbSell
    lastPbSell := bar_index
if boBuy
    lastBoBuy := bar_index
if boSell
    lastBoSell := bar_index

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 7) VISUALS (Clean Overlay)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
plot(showMA ? midMA : na,  "Mid MA",  linewidth=2)
plot(showMA ? slowMA : na, "Slow MA", linewidth=2)

pU = plot(useNoise ? upperBand : na, "ATR Upper Band", linewidth=1)
pL = plot(useNoise ? lowerBand : na, "ATR Lower Band", linewidth=1)
fill(pU, pL, title="Noise Band Fill", color=color.new(color.gray, 88))

bgCol =
     bullBias    ? color.new(color.green, bgOpacity) :
     bearBias    ? color.new(color.red,   bgOpacity) :
     biasNeutral ? color.new(color.gray,  math.min(bgOpacity + 5, 100)) :
                   na

bgcolor(showBgBias ? bgCol : na, title="HTF Bias / Neutral Background")

plotshape(showShapes and pbBuy,  title="PB BUY",  style=shape.labelup,   text="PB", location=location.belowbar, size=size.tiny, color=color.new(color.green, 0),  textcolor=color.white)
plotshape(showShapes and pbSell, title="PB SELL", style=shape.labeldown, text="PB", location=location.abovebar, size=size.tiny, color=color.new(color.red, 0),    textcolor=color.white)

plotshape(showShapes and boBuy,  title="BO BUY",  style=shape.labelup,   text="BO", location=location.belowbar, size=size.tiny, color=color.new(color.teal, 0),   textcolor=color.white)
plotshape(showShapes and boSell, title="BO SELL", style=shape.labeldown, text="BO", location=location.abovebar, size=size.tiny, color=color.new(color.maroon, 0), textcolor=color.white)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 8) STATUS PANEL (Overlay)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var table t = table.new(position.top_right, 1, 7, border_width=1)

biasText = bullBias ? "BULL" : bearBias ? "BEAR" : "NEUTRAL"
noiseText = inNoise ? "IN NOISE" : "OUTSIDE NOISE"
gateText = useNoiseForSignals ? "Signals blocked in noise: " + f_yesno(inNoise) : "Signals blocked in noise: No"

legend1 = "PB = Pullback (trend continuation)"
legend2 = "BO = Breakout (noise band break)"

panelTitle = "VictoryByStrategy • Status"
tfLine = "HTF Bias TF: " + htfTf

// Basic panel colors
titleBg = color.new(color.black, 0)
rowBg   = color.new(color.black, 70)

biasBg =
      bullBias ? color.new(color.green, 70) :
      bearBias ? color.new(color.red, 70) :
                 color.new(color.gray, 70)

txtSize = statusSize == "Small" ? size.small : size.normal

if showStatus and barstate.islast
    table.cell(t, 0, 0, panelTitle, text_color=color.white, bgcolor=titleBg, text_size=txtSize)
    table.cell(t, 0, 1, tfLine,      text_color=color.white, bgcolor=rowBg,   text_size=txtSize)
    table.cell(t, 0, 2, "Bias: " + biasText, text_color=color.white, bgcolor=biasBg, text_size=txtSize)
    table.cell(t, 0, 3, "Noise: " + noiseText, text_color=color.white, bgcolor=rowBg, text_size=txtSize)
    table.cell(t, 0, 4, gateText, text_color=color.white, bgcolor=rowBg, text_size=txtSize)
    table.cell(t, 0, 5, legend1, text_color=color.white, bgcolor=rowBg, text_size=txtSize)
    table.cell(t, 0, 6, legend2, text_color=color.white, bgcolor=rowBg, text_size=txtSize)

if not showStatus and barstate.islast
    // Clear cells when disabled (prevents "ghost" panel)
    for i = 0 to 6
        table.cell(t, 0, i, "", bgcolor=color.new(color.black, 100))

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 9) ALERTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
alertcondition(bullBiasFlip, "HTF Bias -> BULL", "VictoryByStrategy: HTF bias flipped to BULL.")
alertcondition(bearBiasFlip, "HTF Bias -> BEAR", "VictoryByStrategy: HTF bias flipped to BEAR.")

alertcondition(pbBuy,  "Pullback BUY",  "VictoryByStrategy: Pullback BUY signal (trend pullback reclaim).")
alertcondition(pbSell, "Pullback SELL", "VictoryByStrategy: Pullback SELL signal (trend pullback reclaim).")

alertcondition(boBuy,  "Breakout BUY",  "VictoryByStrategy: Breakout BUY signal (upper noise band break).")
alertcondition(boSell, "Breakout SELL", "VictoryByStrategy: Breakout SELL signal (lower noise band break).")
