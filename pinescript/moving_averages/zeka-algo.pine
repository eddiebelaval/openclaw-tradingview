//@version=6
indicator("Rafa Pullback PRO (VWAP+EMA+RSI+Volume+ADX)", overlay=true, max_labels_count=500)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
emaFastLen   = input.int(20, "EMA Rápida", minval=1)
emaSlowLen   = input.int(50, "EMA Lenta",  minval=1)

useVWAP      = input.bool(true, "Usar VWAP na confluência")
zoneMode     = input.string("EMA20-EMA50", "Zona de Pullback",
                options=["EMA20-EMA50","VWAP","EMA20","EMA50"])

rsiLen       = input.int(14, "RSI", minval=1)
rsiMinBuy    = input.float(50.0, "RSI mínimo BUY", step=0.1)
rsiMaxSell   = input.float(50.0, "RSI máximo SELL", step=0.1)

volLen       = input.int(20, "Média de Volume", minval=1)
volConfirm   = input.bool(true, "Confirmar volume")

atrLen       = input.int(14, "ATR", minval=1)
impLookback  = input.int(20, "Lookback impulso", minval=5)
impAtrMult   = input.float(1.4, "Impulso ≥ ATR x", step=0.1)
impClosePos  = input.float(0.65, "Fechamento no extremo (0–1)", step=0.05)

useADX       = input.bool(true, "Filtro Anti-Range (ADX)")
adxLen       = input.int(14, "ADX Length", minval=1)
adxMin       = input.float(18.0, "ADX mínimo", step=0.5)

entryOnBreak = input.bool(true, "Entrar no rompimento")
showStatus   = input.bool(true, "Mostrar status")
showBG       = input.bool(true, "Fundo quando PB OK")

// ─────────────────────────────────────────────────────────────────────────────
// Indicadores base
// ─────────────────────────────────────────────────────────────────────────────
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(atrLen)
vwapVal = ta.vwap(hlc3)
volMA   = ta.sma(volume, volLen)

// ADX correto (Pine v6)
[dip, dim, adxVal] = ta.dmi(adxLen, adxLen)
adxOk = not useADX or adxVal >= adxMin

plot(emaFast, "EMA 20", linewidth=2)
plot(emaSlow, "EMA 50", linewidth=2)
plot(useVWAP ? vwapVal : na, "VWAP", linewidth=2)

// ─────────────────────────────────────────────────────────────────────────────
// Viés
// ─────────────────────────────────────────────────────────────────────────────
trendUp =
     emaFast > emaSlow and close > emaFast and
     (not useVWAP or close > vwapVal) and
     rsiVal >= rsiMinBuy and adxOk

trendDown =
     emaFast < emaSlow and close < emaFast and
     (not useVWAP or close < vwapVal) and
     rsiVal <= rsiMaxSell and adxOk

// ─────────────────────────────────────────────────────────────────────────────
// Impulso
// ─────────────────────────────────────────────────────────────────────────────
body     = math.abs(close - open)
rng      = high - low
closePos = rng > 0 ? (close - low) / rng : 0.5

impBuy  = close > open and body >= atrVal * impAtrMult and closePos >= impClosePos
impSell = close < open and body >= atrVal * impAtrMult and closePos <= (1 - impClosePos)

recentImpBuy  = ta.barssince(impBuy)  <= impLookback
recentImpSell = ta.barssince(impSell) <= impLookback

// ─────────────────────────────────────────────────────────────────────────────
// Zona de Pullback
// ─────────────────────────────────────────────────────────────────────────────
zoneLow = switch zoneMode
    "EMA20-EMA50" => math.min(emaFast, emaSlow)
    "VWAP"        => vwapVal
    "EMA20"       => emaFast
    "EMA50"       => emaSlow

zoneHigh = switch zoneMode
    "EMA20-EMA50" => math.max(emaFast, emaSlow)
    "VWAP"        => vwapVal
    "EMA20"       => emaFast
    "EMA50"       => emaSlow

touchedZone =
     zoneMode == "EMA20-EMA50"
     ? (low <= zoneHigh and low >= zoneLow)
     : (low <= zoneHigh and high >= zoneLow)

// ─────────────────────────────────────────────────────────────────────────────
// Gatilhos
// ─────────────────────────────────────────────────────────────────────────────
prevBear = close[1] < open[1]
prevBull = close[1] > open[1]

lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)

bullEngulf = close > open and prevBear and close > open[1]
bearEngulf = close < open and prevBull and close < open[1]

bullReject = close > open and lowerWick > body * 1.2
bearReject = close < open and upperWick > body * 1.2

confirmBuy  = bullEngulf or bullReject
confirmSell = bearEngulf or bearReject

volOk = not volConfirm or volume > volMA

pbBuy  = trendUp   and recentImpBuy  and touchedZone and confirmBuy  and volOk
pbSell = trendDown and recentImpSell and touchedZone and confirmSell and volOk

buySignal  = entryOnBreak ? pbBuy[1]  and high > high[1] : pbBuy
sellSignal = entryOnBreak ? pbSell[1] and low  < low[1]  : pbSell

plotshape(buySignal,  style=shape.labelup,   text="BUY\nPB",  location=location.belowbar)
plotshape(sellSignal, style=shape.labeldown, text="SELL\nPB", location=location.abovebar)

bgcolor(showBG and pbBuy  ? color.new(color.green, 88) : na)
bgcolor(showBG and pbSell ? color.new(color.red,   88) : na)

// ─────────────────────────────────────────────────────────────────────────────
// Status
// ─────────────────────────────────────────────────────────────────────────────
var label statusLbl = na
if showStatus and barstate.islast
    label.delete(statusLbl)
    statusLbl := label.new(
        bar_index, high,
        buySignal  ? "🚀 BUY Pullback" :
        sellSignal ? "🧨 SELL Pullback" :
        trendUp    ? "⏳ Tendência BUY" :
        trendDown  ? "⏳ Tendência SELL" :
                     "🛑 Sem viés",
        style=label.style_label_down,
        textcolor=color.white
    )

alertcondition(buySignal,  "BUY Pullback",  "Pullback BUY validado")
alertcondition(sellSignal, "SELL Pullback", "Pullback SELL validado")
