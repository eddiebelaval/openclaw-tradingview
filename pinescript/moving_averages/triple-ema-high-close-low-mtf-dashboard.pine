//@version=6
indicator(title="Triple EMA - High / Close / Low + MTF Dashboard", shorttitle="EMA+MTF", overlay=true)

// ─────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────
emaLen      = input.int(21,    title="EMA Length (applies to ALL timeframes)", minval=1)
showFill    = input.bool(true, title="Fill Band",              group="Display")
colorHigh   = input.color(color.new(color.red,   0),  title="EMA High Color",    group="Display")
colorClose  = input.color(color.new(color.white, 0),  title="EMA Close Color",   group="Display")
colorLow    = input.color(color.new(color.teal,  0),  title="EMA Low Color",     group="Display")
fillColUp   = input.color(color.new(color.teal,  85), title="Fill Color (Bull)", group="Display")
fillColDown = input.color(color.new(color.red,   85), title="Fill Color (Bear)", group="Display")
tablePos    = input.string("bottom_right", title="Dashboard Position", options=["top_right","top_left","bottom_right","bottom_left","middle_right","middle_left"], group="Dashboard")

// ─────────────────────────────────────────
// EMA ON CURRENT TIMEFRAME
// ─────────────────────────────────────────
emaHigh  = ta.ema(high,  emaLen)
emaClose = ta.ema(close, emaLen)
emaLow   = ta.ema(low,   emaLen)

// ─────────────────────────────────────────
// PLOTS
// ─────────────────────────────────────────
pHigh  = plot(emaHigh,  title="EMA High",  color=colorHigh,  linewidth=1)
pClose = plot(emaClose, title="EMA Close", color=colorClose, linewidth=2)
pLow   = plot(emaLow,   title="EMA Low",   color=colorLow,   linewidth=1)

fillColor = emaClose > emaClose[1] ? fillColUp : fillColDown
fill(pHigh, pLow, color=showFill ? fillColor : na, title="Band Fill")

// ─────────────────────────────────────────
// MTF DIRECTION FUNCTION
//  2 = Strong Bull (close above EMA High band, rising)
//  1 = Bull       (close above EMA Close, rising)
//  0 = Neutral    (inside band or flat)
// -1 = Bear       (close below EMA Close, falling)
// -2 = Strong Bear(close below EMA Low band, falling)
// ─────────────────────────────────────────
getDir(tf) =>
    _emaC  = request.security(syminfo.tickerid, tf, ta.ema(close, emaLen), lookahead=barmerge.lookahead_off)
    _emaCP = request.security(syminfo.tickerid, tf, ta.ema(close, emaLen)[1], lookahead=barmerge.lookahead_off)
    _emaH  = request.security(syminfo.tickerid, tf, ta.ema(high,  emaLen), lookahead=barmerge.lookahead_off)
    _emaL  = request.security(syminfo.tickerid, tf, ta.ema(low,   emaLen), lookahead=barmerge.lookahead_off)
    _close = request.security(syminfo.tickerid, tf, close, lookahead=barmerge.lookahead_off)
    _rising  = _emaC > _emaCP
    _falling = _emaC < _emaCP
    _dir = _close > _emaH and _rising  ?  2 :
           _close > _emaC and _rising  ?  1 :
           _close < _emaL and _falling ? -2 :
           _close < _emaC and _falling ? -1 : 0
    _dir

// ─────────────────────────────────────────
// FETCH ALL TIMEFRAMES
// ─────────────────────────────────────────
dir_m1  = getDir("1")
dir_m5  = getDir("5")
dir_m15 = getDir("15")
dir_m30 = getDir("30")
dir_h1  = getDir("60")
dir_h4  = getDir("240")
dir_1d  = getDir("D")
dir_1w  = getDir("W")

// ─────────────────────────────────────────
// HELPERS
// ─────────────────────────────────────────
dirLabel(d) =>
    if d == 2
        "^^ STRONG"
    else if d == 1
        "^  BULL"
    else if d == -1
        "v  BEAR"
    else if d == -2
        "vv STRONG"
    else
        "-- NEUT"

dirTxtColor(d) =>
    if d == 2
        color.new(color.lime, 0)
    else if d == 1
        color.new(color.teal, 0)
    else if d == -1
        color.new(color.red, 0)
    else if d == -2
        color.new(color.maroon, 0)
    else
        color.new(color.gray, 0)

dirBG(d) =>
    if d == 2
        color.new(color.lime, 70)
    else if d == 1
        color.new(color.teal, 70)
    else if d == -1
        color.new(color.red, 70)
    else if d == -2
        color.new(color.maroon, 60)
    else
        color.new(color.gray, 80)

// ─────────────────────────────────────────
// TABLE POSITION
// ─────────────────────────────────────────
tPos = tablePos == "top_right"    ? position.top_right    :
       tablePos == "top_left"     ? position.top_left     :
       tablePos == "bottom_right" ? position.bottom_right :
       tablePos == "bottom_left"  ? position.bottom_left  :
       tablePos == "middle_right" ? position.middle_right :
       position.middle_left

// ─────────────────────────────────────────
// DASHBOARD TABLE
// ─────────────────────────────────────────
var table dash = table.new(tPos, 2, 11, border_width=1, border_color=color.new(color.gray, 40), frame_color=color.new(color.gray, 20), frame_width=2)

if barstate.islast

    // Header
    table.cell(dash, 0, 0, "TF",
         text_color=color.white, bgcolor=color.new(color.navy, 10),
         text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 1, 0, "EMA(" + str.tostring(emaLen) + ") TREND",
         text_color=color.white, bgcolor=color.new(color.navy, 10),
         text_size=size.small, text_halign=text.align_center)

    // TF rows
    tfLabels = array.from("M1","M5","M15","M30","H1","H4","1D","1W")
    tfDirs   = array.from(dir_m1, dir_m5, dir_m15, dir_m30, dir_h1, dir_h4, dir_1d, dir_1w)

    for i = 0 to 7
        d = array.get(tfDirs, i)
        table.cell(dash, 0, i + 1, array.get(tfLabels, i),
             text_color=color.white,
             bgcolor=color.new(color.navy, 50),
             text_size=size.small, text_halign=text.align_center)
        table.cell(dash, 1, i + 1, dirLabel(d),
             text_color=dirTxtColor(d),
             bgcolor=dirBG(d),
             text_size=size.small, text_halign=text.align_center)

    // BIAS row
    bullCount = (dir_m1>=1?1:0)+(dir_m5>=1?1:0)+(dir_m15>=1?1:0)+(dir_m30>=1?1:0)+(dir_h1>=1?1:0)+(dir_h4>=1?1:0)+(dir_1d>=1?1:0)+(dir_1w>=1?1:0)
    bearCount = (dir_m1<=-1?1:0)+(dir_m5<=-1?1:0)+(dir_m15<=-1?1:0)+(dir_m30<=-1?1:0)+(dir_h1<=-1?1:0)+(dir_h4<=-1?1:0)+(dir_1d<=-1?1:0)+(dir_1w<=-1?1:0)

    biasLabel = bullCount > bearCount ? "^ BULL " + str.tostring(bullCount) + "/8" : bearCount > bullCount ? "v BEAR " + str.tostring(bearCount) + "/8" : "-- MIXED"
    biasBG    = bullCount > bearCount ? color.new(color.teal, 50) : bearCount > bullCount ? color.new(color.red, 50) : color.new(color.gray, 60)

    table.cell(dash, 0, 9, "BIAS",
         text_color=color.white, bgcolor=color.new(color.navy, 10),
         text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 1, 9, biasLabel,
         text_color=color.white, bgcolor=biasBG,
         text_size=size.small, text_halign=text.align_center)
