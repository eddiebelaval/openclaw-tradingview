//@version=6
indicator("Goat Trap Pinbar", overlay=true)

// Candle math
body       = math.abs(close - open)
upShadow   = high - math.max(open, close)
downShadow = math.min(open, close) - low

prevBody = math.abs(close[1] - open[1])
prevBull = close[1] > open[1]
prevBear = open[1] > close[1]

// Pinbar conditions (same logic as your v2)
bearPinbar = barstate.isconfirmed and prevBull and (prevBody > body) and (upShadow > 0.5 * body) and (upShadow > 2 * downShadow)
bullPinbar = barstate.isconfirmed and prevBear and (prevBody > body) and (downShadow > 0.5 * body) and (downShadow > 2 * upShadow)

// Shapes
plotshape(bearPinbar, title="Bearish Pinbar", style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.tiny)
plotshape(bullPinbar, title="Bullish Pinbar", style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.tiny)

// Re-added plotchar to restore the "Chars" entries in Style (like your original)
// Using a single space keeps it effectively invisible but keeps the style controls.
plotchar(bearPinbar, char=" ", color=color.red,  location=location.abovebar, text="BEARISH PINBAR")
plotchar(bullPinbar, char=" ", color=color.lime, location=location.belowbar, text="BULLISH PINBAR")

// Alerts
alertcondition(bearPinbar, title="Goat Trap Pinbar - Bearish",
     message="Goat Trap Pinbar: BEARISH pinbar on {{exchange}}:{{ticker}} ({{interval}}) at {{time}}")

alertcondition(bullPinbar, title="Goat Trap Pinbar - Bullish",
     message="Goat Trap Pinbar: BULLISH pinbar on {{exchange}}:{{ticker}} ({{interval}}) at {{time}}")

alertcondition(bearPinbar or bullPinbar, title="Goat Trap Pinbar - Any",
     message="Goat Trap Pinbar: Pinbar formed on {{exchange}}:{{ticker}} ({{interval}}) at {{time}}")
