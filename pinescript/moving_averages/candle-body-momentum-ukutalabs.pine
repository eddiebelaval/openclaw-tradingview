//@version=6
indicator("Candle Body Momentum [UkutaLabs]", overlay=true)

int EMAPeriod  = input.int(defval=14, title="Look Back Period", group='Configuration')

bullishColor    = input.color(defval=color.lime, title="Bullish Color", group="Ribbon")
bearishColor    = input.color(defval=color.red, title="Bearish Color", group="Ribbon")

float oEMA = ta.ema(open, EMAPeriod)
float cEMA = ta.ema(close, EMAPeriod)

color sColor = oEMA > cEMA ? bearishColor : bullishColor

plot(oEMA, color = sColor, editable = false, force_overlay = true, display = display.pane)
plot(oEMA, color = color.new(sColor, 80), linewidth = 10, editable = false, force_overlay = true, display = display.pane)
plot(oEMA, color = color.new(sColor, 90), linewidth = 20, editable = false, force_overlay = true, display = display.pane)

plot(cEMA, color = sColor, editable = false, force_overlay = true, display = display.pane)
plot(cEMA, color = color.new(sColor, 80), linewidth = 10, editable = false, force_overlay = true, display = display.pane)
plot(cEMA, color = color.new(sColor, 90), linewidth = 20, editable = false, force_overlay = true, display = display.pane)
