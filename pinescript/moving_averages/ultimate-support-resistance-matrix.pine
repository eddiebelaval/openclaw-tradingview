//@version=6
indicator("Ultimate Support Resistance Matrix", overlay = true, max_lines_count = 500, max_labels_count = 500)

// --- GİRDİLER ---
show_bb     = input.bool(true, "Bollinger Bands", group="Görünürlük")
show_sma    = input.bool(true, "SMA (50/200)", group="Görünürlük")
show_ichi   = input.bool(true, "Ichimoku", group="Görünürlük")
show_open   = input.bool(true, "Openings (M/W/D)", group="Görünürlük")
show_vwap   = input.bool(true, "VWAP (W/D)", group="Görünürlük")
show_cama   = input.bool(true, "Camarilla H3/L3", group="Görünürlük")
show_hl     = input.bool(true, "High/Low Levels", group="Görünürlük")

// --- RENKLER ---
color_bb = #2196f3, color_vwap = #ff9800, color_sma = #008080, color_open = #ffffff, color_cama = #e91e63, color_h4 = #ffeb3b

// --- YARDIMCI HESAPLAMA FONKSİYONLARI ---
get_bb() => 
    _m = ta.sma(close, 20)
    _dev = 2 * ta.stdev(close, 20)
    [_m + _dev, _m, _m - _dev]

get_ichi() =>
    _senkouA = math.avg(math.avg(ta.lowest(low, 9), ta.highest(high, 9)), math.avg(ta.lowest(low, 26), ta.highest(high, 26)))
    _senkouB = math.avg(ta.lowest(low, 52), ta.highest(high, 52))
    [_senkouA, _senkouB]

// --- VERİLERİ ÇEKME (MTF) ---
// Bollinger Bands (W, D, H4)
[bb_w_u, bb_w_m, bb_w_l]   = request.security(syminfo.tickerid, "W", get_bb())
[bb_d_u, bb_d_m, bb_d_l]   = request.security(syminfo.tickerid, "D", get_bb())
[bb_h4_u, bb_h4_m, bb_h4_l] = request.security(syminfo.tickerid, "240", get_bb())

// Ichimoku
[ichi_w_a, ichi_w_b] = request.security(syminfo.tickerid, "W", get_ichi())
[ichi_d_a, ichi_d_b] = request.security(syminfo.tickerid, "D", get_ichi())

// SMA'lar (W, D, H4)
sma_w_200  = request.security(syminfo.tickerid, "W", ta.sma(close, 200))
sma_w_50   = request.security(syminfo.tickerid, "W", ta.sma(close, 50))
sma_d_200  = request.security(syminfo.tickerid, "D", ta.sma(close, 200))
sma_d_50   = request.security(syminfo.tickerid, "D", ta.sma(close, 50))
sma_h4_200 = request.security(syminfo.tickerid, "240", ta.sma(close, 200))
sma_h4_50  = request.security(syminfo.tickerid, "240", ta.sma(close, 50))

// Fiyat Seviyeleri & VWAP
[h_w, l_w] = request.security(syminfo.tickerid, "W", [high, low])
m_o = request.security(syminfo.tickerid, "M", open)
w_o = request.security(syminfo.tickerid, "W", open)
d_o = request.security(syminfo.tickerid, "D", open)
w_v = request.security(syminfo.tickerid, "W", ta.vwap)
d_v = ta.vwap(close)

// Camarilla
[ph, pl, pc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]])
range_c = ph - pl
h4 = pc + (range_c * 1.1 / 2), h3 = pc + (range_c * 1.1 / 4)
l3 = pc - (range_c * 1.1 / 4), l4 = pc - (range_c * 1.1 / 2)

// --- ÇİZİM FONKSİYONU ---
draw_level(cond, val, col, width, txt) =>
    var line l = na
    var label lb = na
    line.delete(l)
    label.delete(lb)
    if cond and not na(val)
        l := line.new(bar_index, val, bar_index + 1, val, xloc.bar_index, extend.both, color.new(col, 30), line.style_solid, width)
        lb := label.new(bar_index + 15, val, txt + ": " + str.tostring(val, format.mintick), xloc.bar_index, yloc.price, color.new(col, 100), label.style_none, col, size.small, text.align_left)
    [l, lb]

// --- UYGULAMA (Sadece Son Bar) ---
if barstate.islast
    // --- Bollinger Bands (Orta Bantlar Dahil) ---
    draw_level(show_bb, bb_w_u, color_bb, 1, "W BB Upper")
    draw_level(show_bb, bb_w_m, color_bb, 1, "W BB Basis (20 SMA)")
    draw_level(show_bb, bb_w_l, color_bb, 1, "W BB Lower")
    
    draw_level(show_bb, bb_d_u, color_bb, 1, "D BB Upper")
    draw_level(show_bb, bb_d_m, color_bb, 1, "D BB Basis (20 SMA)")
    draw_level(show_bb, bb_d_l, color_bb, 1, "D BB Lower")

    draw_level(show_bb, bb_h4_u, color_bb, 1, "H4 BB Upper")
    draw_level(show_bb, bb_h4_m, color_bb, 1, "H4 BB Basis (20 SMA)")
    draw_level(show_bb, bb_h4_l, color_bb, 1, "H4 BB Lower")

    // --- SMA Seviyeleri ---
    draw_level(show_sma, sma_w_200, color_sma, 2, "W SMA 200")
    draw_level(show_sma, sma_w_50, color_sma, 1, "W SMA 50")
    draw_level(show_sma, sma_d_200, color_sma, 2, "D SMA 200")
    draw_level(show_sma, sma_d_50, color_sma, 1, "D SMA 50")
    draw_level(show_sma, sma_h4_200, color_h4, 1, "H4 SMA 200")
    draw_level(show_sma, sma_h4_50, color_h4, 1, "H4 SMA 50")

    // --- Diğer Matrix Elemanları ---
    draw_level(show_ichi, ichi_w_a, #9c27b0, 1, "W Ichi A")
    draw_level(show_ichi, ichi_w_b, #9c27b0, 1, "W Ichi B")
    draw_level(show_open, m_o, color_open, 2, "Monthly Open")
    draw_level(show_open, w_o, color_open, 1, "Weekly Open")
    draw_level(show_vwap, w_v, color_vwap, 2, "Weekly VWAP")
    draw_level(show_vwap, d_v, color_vwap, 1, "Daily VWAP")
    draw_level(show_cama, h4, color_cama, 1, "Cama H4")
    draw_level(show_cama, h3, color_cama, 1, "Cama H3")
    draw_level(show_cama, l3, color_cama, 1, "Cama L3")
    draw_level(show_cama, l4, color_cama, 1, "Cama L4")
    draw_level(show_hl, h_w, #ff5252, 1, "W High")
    draw_level(show_hl, l_w, #ff5252, 1, "W Low")
