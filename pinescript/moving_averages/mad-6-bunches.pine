//@version=5
indicator("MAD 6 Bunches", overlay=true)

// === Detect 1 Minute Chart ===
is1m = timeframe.period == "1"

// === Toggle Inputs ===
showBatch1 = input.bool(true, "Show EMA Batch 1 (5–7)", group="Batch 1")
showBatch2 = input.bool(true, "Show EMA Batch 2 (Dynamic)", group="Batch 2")
showBatch3 = input.bool(true, "Show EMA Batch 3 (Dynamic)", group="Batch 3")
showBatch4 = input.bool(true, "Show EMA Batch 4 (150–210)", group="Batch 4")
showBatch5 = input.bool(true, "Show EMA Batch 5 (330–420)", group="Batch 5")
showBatch6 = input.bool(true, "Show EMA Batch 6 (650–4995)", group="Batch 6")

// =====================================================
// ================= EMA CALCULATIONS ==================
// =====================================================

// Batch 1
ema5  = ta.ema(close, 5)
ema6  = ta.ema(close, 6)
ema7  = ta.ema(close, 7)

// -------- Batch 2 (Dynamic) --------
ema11 = ta.ema(close, 11)
ema12 = ta.ema(close, 12)
ema13 = ta.ema(close, 13)

ema30 = ta.ema(close, 30)
ema33 = ta.ema(close, 33)
ema36 = ta.ema(close, 36)
ema39 = ta.ema(close, 39)

// -------- Batch 3 (Dynamic) --------
ema38  = ta.ema(close, 38)
ema42  = ta.ema(close, 42)
ema46  = ta.ema(close, 46)
ema50  = ta.ema(close, 50)

ema81  = ta.ema(close, 81)
ema90  = ta.ema(close, 90)
ema99  = ta.ema(close, 99)
ema108 = ta.ema(close, 108)

// Batch 4
ema150 = ta.ema(close, 150)
ema165 = ta.ema(close, 165)
ema180 = ta.ema(close, 180)
ema195 = ta.ema(close, 195)
ema210 = ta.ema(close, 210)

// Batch 5
ema330 = ta.ema(close, 330)
ema360 = ta.ema(close, 360)
ema390 = ta.ema(close, 390)
ema420 = ta.ema(close, 420)

// Batch 6
ema650  = ta.ema(close, 650)
ema850  = ta.ema(close, 850)
ema3000 = ta.ema(close, 3000)
ema3900 = ta.ema(close, 3900)
ema4995 = ta.ema(close, 4995)


// =====================================================
// ====================== PLOTS ========================
// =====================================================

// Batch 1
plot(showBatch1 ? ema5 : na, "", color=color.new(color.gray, 20), linewidth=1)
plot(showBatch1 ? ema6 : na, "", color=color.new(color.gray, 40), linewidth=1)
plot(showBatch1 ? ema7 : na, "", color=color.black, linewidth=2)

// ================= Batch 2 =================
plot(showBatch2 and is1m ? ema11 : na, "", color=color.yellow, linewidth=1)
plot(showBatch2 and is1m ? ema12 : na, "", color=color.yellow, linewidth=1)
plot(showBatch2 and is1m ? ema13 : na, "", color=color.yellow, linewidth=2)

plot(showBatch2 and not is1m ? ema30 : na, "", color=color.yellow, linewidth=1)
plot(showBatch2 and not is1m ? ema33 : na, "", color=color.yellow, linewidth=1)
plot(showBatch2 and not is1m ? ema36 : na, "", color=color.yellow, linewidth=1)
plot(showBatch2 and not is1m ? ema39 : na, "", color=color.yellow, linewidth=2)

// ================= Batch 3 =================
plot(showBatch3 and is1m ? ema38 : na, "", color=color.green, linewidth=1)
plot(showBatch3 and is1m ? ema42 : na, "", color=color.green, linewidth=1)
plot(showBatch3 and is1m ? ema46 : na, "", color=color.green, linewidth=1)
plot(showBatch3 and is1m ? ema50 : na, "", color=color.green, linewidth=2)

plot(showBatch3 and not is1m ? ema81 : na, "", color=color.green, linewidth=1)
plot(showBatch3 and not is1m ? ema90 : na, "", color=color.green, linewidth=1)
plot(showBatch3 and not is1m ? ema99 : na, "", color=color.green, linewidth=1)
plot(showBatch3 and not is1m ? ema108 : na, "", color=color.green, linewidth=2)

// Batch 4
plot(showBatch4 ? ema150 : na, "", color=color.blue, linewidth=2)
plot(showBatch4 ? ema165 : na, "", color=color.blue, linewidth=1)
plot(showBatch4 ? ema180 : na, "", color=color.blue, linewidth=1)
plot(showBatch4 ? ema195 : na, "", color=color.blue, linewidth=1)
plot(showBatch4 ? ema210 : na, "", color=color.blue, linewidth=2)

// Batch 5
plot(showBatch5 ? ema330 : na, "", color=color.maroon, linewidth=1)
plot(showBatch5 ? ema360 : na, "", color=color.maroon, linewidth=2)
plot(showBatch5 ? ema390 : na, "", color=color.maroon, linewidth=1)
plot(showBatch5 ? ema420 : na, "", color=color.navy, linewidth=3)

// Batch 6
plot(showBatch6 ? ema650 : na, "", color=color.maroon, linewidth=2)
plot(showBatch6 ? ema850 : na, "", color=color.green, linewidth=2)
plot(showBatch6 ? ema3000 : na, "", color=color.maroon, linewidth=2)
plot(showBatch6 ? ema3900 : na, "", color=color.navy, linewidth=2)
plot(showBatch6 ? ema4995 : na, "", color=color.green, linewidth=3)


// =====================================================
// ================== CROSSING SYSTEM ==================
// =====================================================

// Bunch 2 acts as EMA 9
fastEMA = is1m ? ema13 : ema39

// Bunch 3 acts as EMA 30
slowEMA = is1m ? ema50 : ema108

buySignal  = ta.crossover(fastEMA, slowEMA)
sellSignal = ta.crossunder(fastEMA, slowEMA)

// === Plot BUY / SELL Labels (Same Style as Your 9/30) ===
plotshape(buySignal,
     title="BUY",
     location=location.belowbar,
     color=color.green,
     style=shape.labelup,
     size=size.tiny,
     text="BUY",
     textcolor=color.white)

plotshape(sellSignal,
     title="SELL",
     location=location.abovebar,
     color=color.red,
     style=shape.labeldown,
     size=size.tiny,
     text="SELL",
     textcolor=color.white)
