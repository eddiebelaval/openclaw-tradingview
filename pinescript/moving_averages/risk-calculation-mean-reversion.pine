//@version=6
// © Jason Parker
indicator("Risk", overlay=true)

// ==============================================================================
// INPUTS
// ==============================================================================

float buyingPower  = input.float(200000.0, "Buying Power ($)",
     minval  = 100.0,
     step    = 1000.0,
     tooltip = "Your total available buying power — used to calculate max share size.")
float equityRisk   = input.float(25000.0,  "Equity at Risk ($)",
     minval  = 100.0,
     step    = 100.0,
     tooltip = "The maximum equity you are willing to lose on this trade.")
bool  showPct      = input.bool(true, "Show % on Profit Targets",
     tooltip = "Appends the percentage move required to reach each EMA profit target.")
int   cooldownBars = input.int(20, "Cooldown (Bars)",
     minval  = 1,
     tooltip = "Number of bars that must pass before the alert can fire again.",
     group   = "Alert Settings")

// ==============================================================================
// EMA CALCULATIONS
// ==============================================================================

float ema200Curr = ta.ema(close, 200)

float _ema1m_src = ta.ema(close, 200)
float ema200_1m  = request.security(syminfo.tickerid, "1",  _ema1m_src, gaps=barmerge.gaps_on,  lookahead=barmerge.lookahead_off)

float _ema1h_src = ta.ema(close, 200)
float ema200_1h  = request.security(syminfo.tickerid, "60", _ema1h_src, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// Plot EMAs — lines only, suppress price scale tag
plot(ema200Curr, title="200 EMA (Current)", color=color.red,             linewidth=2, display=display.pane)
plot(ema200_1m,  title="200 EMA (1m)",      color=color.black,           linewidth=2, display=display.pane)
plot(ema200_1h,  title="200 EMA (1h)",      color=color.new(#89CFF0, 0), linewidth=2, display=display.pane)

// ==============================================================================
// CORE CALCULATIONS  (all from the same bar's close)
// ==============================================================================

float px       = close
float ema1h    = na(ema200_1h) ? ema200Curr : ema200_1h

// Share count based on full buying power
int   shares   = math.floor(buyingPower / px)

// ── Loss calculations ─────────────────────────────────────────────────────────
// How many points price must fall to wipe out full buying power
float ptsBP    = shares > 0 ? buyingPower / shares : 0.0

// How many points price must fall to lose just the equity at risk
// (same share count — this is the natural stop-loss distance)
float ptsEQ    = shares > 0 ? equityRisk  / shares : 0.0

// ── Profit target distances ───────────────────────────────────────────────────
float distCurr = math.abs(ema200Curr - px)
float dist1m   = na(ema200_1m) ? na : math.abs(ema200_1m - px)
float dist1h   = math.abs(ema1h - px)

// Dollar gain at full buying power share count
float pnlCurr  = distCurr * shares
float pnl1m    = na(dist1m) ? na : dist1m * shares
float pnl1h    = dist1h   * shares

// Percentage move to each EMA
float pctCurr  = px > 0 ? distCurr / px * 100 : 0.0
float pct1m    = (na(dist1m) or px <= 0) ? na : dist1m / px * 100
float pct1h    = px > 0 ? dist1h   / px * 100 : 0.0

// ==============================================================================
// ALERT LOGIC — Tiered profit alerts $100–$1000 (each with independent cooldown)
// ==============================================================================

// Helper: build a reusable alert message string
alertMsg(float threshold) =>
    "Risk Alert ($" + str.tostring(int(threshold)) + "+): Profit to 200 EMA = $" + str.tostring(math.round(pnlCurr, 2)) + " | " + str.tostring(shares) + " shares @ $" + str.tostring(close, "#.##") + " | EMA target $" + str.tostring(ema200Curr, "#.##") + " | " + str.tostring(distCurr, "#.##") + " pts"

// ── $100 ─────────────────────────────────────────────────────────────────────
var int cd100 = cooldownBars
bool trig100  = pnlCurr >= 100 and cd100 >= cooldownBars
cd100        := trig100 ? 0 : cd100 + 1
if trig100
    alert(alertMsg(100), alert.freq_once_per_bar)
alertcondition(trig100, title="Risk — $100+ Profit to 200 EMA", message="Risk Alert: $100+ profit to current 200 EMA. See alert() message for details.")

// ── $200 ─────────────────────────────────────────────────────────────────────
var int cd200 = cooldownBars
bool trig200  = pnlCurr >= 200 and cd200 >= cooldownBars
cd200        := trig200 ? 0 : cd200 + 1
if trig200
    alert(alertMsg(200), alert.freq_once_per_bar)
alertcondition(trig200, title="Risk — $200+ Profit to 200 EMA", message="Risk Alert: $200+ profit to current 200 EMA. See alert() message for details.")

// ── $300 ─────────────────────────────────────────────────────────────────────
var int cd300 = cooldownBars
bool trig300  = pnlCurr >= 300 and cd300 >= cooldownBars
cd300        := trig300 ? 0 : cd300 + 1
if trig300
    alert(alertMsg(300), alert.freq_once_per_bar)
alertcondition(trig300, title="Risk — $300+ Profit to 200 EMA", message="Risk Alert: $300+ profit to current 200 EMA. See alert() message for details.")

// ── $400 ─────────────────────────────────────────────────────────────────────
var int cd400 = cooldownBars
bool trig400  = pnlCurr >= 400 and cd400 >= cooldownBars
cd400        := trig400 ? 0 : cd400 + 1
if trig400
    alert(alertMsg(400), alert.freq_once_per_bar)
alertcondition(trig400, title="Risk — $400+ Profit to 200 EMA", message="Risk Alert: $400+ profit to current 200 EMA. See alert() message for details.")

// ── $500 ─────────────────────────────────────────────────────────────────────
var int cd500 = cooldownBars
bool trig500  = pnlCurr >= 500 and cd500 >= cooldownBars
cd500        := trig500 ? 0 : cd500 + 1
if trig500
    alert(alertMsg(500), alert.freq_once_per_bar)
alertcondition(trig500, title="Risk — $500+ Profit to 200 EMA", message="Risk Alert: $500+ profit to current 200 EMA. See alert() message for details.")

// ── $600 ─────────────────────────────────────────────────────────────────────
var int cd600 = cooldownBars
bool trig600  = pnlCurr >= 600 and cd600 >= cooldownBars
cd600        := trig600 ? 0 : cd600 + 1
if trig600
    alert(alertMsg(600), alert.freq_once_per_bar)
alertcondition(trig600, title="Risk — $600+ Profit to 200 EMA", message="Risk Alert: $600+ profit to current 200 EMA. See alert() message for details.")

// ── $700 ─────────────────────────────────────────────────────────────────────
var int cd700 = cooldownBars
bool trig700  = pnlCurr >= 700 and cd700 >= cooldownBars
cd700        := trig700 ? 0 : cd700 + 1
if trig700
    alert(alertMsg(700), alert.freq_once_per_bar)
alertcondition(trig700, title="Risk — $700+ Profit to 200 EMA", message="Risk Alert: $700+ profit to current 200 EMA. See alert() message for details.")

// ── $800 ─────────────────────────────────────────────────────────────────────
var int cd800 = cooldownBars
bool trig800  = pnlCurr >= 800 and cd800 >= cooldownBars
cd800        := trig800 ? 0 : cd800 + 1
if trig800
    alert(alertMsg(800), alert.freq_once_per_bar)
alertcondition(trig800, title="Risk — $800+ Profit to 200 EMA", message="Risk Alert: $800+ profit to current 200 EMA. See alert() message for details.")

// ── $900 ─────────────────────────────────────────────────────────────────────
var int cd900 = cooldownBars
bool trig900  = pnlCurr >= 900 and cd900 >= cooldownBars
cd900        := trig900 ? 0 : cd900 + 1
if trig900
    alert(alertMsg(900), alert.freq_once_per_bar)
alertcondition(trig900, title="Risk — $900+ Profit to 200 EMA", message="Risk Alert: $900+ profit to current 200 EMA. See alert() message for details.")

// ── $1000 ────────────────────────────────────────────────────────────────────
var int cd1000 = cooldownBars
bool trig1000  = pnlCurr >= 1000 and cd1000 >= cooldownBars
cd1000        := trig1000 ? 0 : cd1000 + 1
if trig1000
    alert(alertMsg(1000), alert.freq_once_per_bar)
alertcondition(trig1000, title="Risk — $1000+ Profit to 200 EMA", message="Risk Alert: $1000+ profit to current 200 EMA. See alert() message for details.")

// ==============================================================================
// HELPERS
// ==============================================================================

fmtDollar(float v) =>
    "$" + str.tostring(v, "#,###.##")

fmtTarget(float dollars, float pct) =>
    string p = (showPct and not na(pct)) ? "  (" + str.tostring(pct, "#.##") + "%)" : ""
    "+$" + str.tostring(dollars, "#,###.##") + p

// ==============================================================================
// TABLE — bottom right corner
// ==============================================================================

var table t = table.new(
     position     = position.bottom_right,
     columns      = 2,
     rows         = 11,
     bgcolor      = color.new(color.black, 10),
     border_color = color.gray,
     border_width = 1,
     frame_color  = color.gray,
     frame_width  = 1)

if barstate.islast

    // ── Header ────────────────────────────────────────────────────────────────
    table.cell(t, 0, 0,
         "RISK  —  " + str.tostring(shares) + " shares @ $" + str.tostring(px, "#.##"),
         text_color=color.white, text_size=size.small,
         bgcolor=color.new(color.black, 10), text_halign=text.align_center)
    table.merge_cells(t, 0, 0, 1, 0)

    // ── Share size ────────────────────────────────────────────────────────────
    table.cell(t, 0, 1, "Share Size  (" + fmtDollar(buyingPower) + " buying power)",
         text_color=color.white, text_size=size.normal,
         bgcolor=color.new(color.black, 10), text_halign=text.align_left)
    table.cell(t, 1, 1, str.tostring(shares) + " shares",
         text_color=color.yellow, text_size=size.normal,
         bgcolor=color.new(color.black, 10), text_halign=text.align_right)

    // ── Loss section header ───────────────────────────────────────────────────
    table.cell(t, 0, 2, "── Loss Scenarios ──",
         text_color=color.gray, text_size=size.small,
         bgcolor=color.new(color.black, 10), text_halign=text.align_center)
    table.merge_cells(t, 0, 2, 1, 2)

    // ── Points to lose full buying power ─────────────────────────────────────
    table.cell(t, 0, 3, "▼  Lose Full BP  (" + fmtDollar(buyingPower) + ")",
         text_color=color.red, text_size=size.normal,
         bgcolor=color.new(color.black, 10), text_halign=text.align_left)
    table.cell(t, 1, 3, "-" + str.tostring(ptsBP, "#.##") + " pts",
         text_color=color.red, text_size=size.normal,
         bgcolor=color.new(color.black, 10), text_halign=text.align_right)

    // ── Points to lose equity at risk (natural stop distance) ─────────────────
    table.cell(t, 0, 4, "▼  Lose Equity  (" + fmtDollar(equityRisk) + ")",
         text_color=color.new(color.orange, 0), text_size=size.normal,
         bgcolor=color.new(color.black, 10), text_halign=text.align_left)
    table.cell(t, 1, 4, "-" + str.tostring(ptsEQ, "#.##") + " pts",
         text_color=color.new(color.orange, 0), text_size=size.normal,
         bgcolor=color.new(color.black, 10), text_halign=text.align_right)

    // ── Profit targets section header ─────────────────────────────────────────
    table.cell(t, 0, 5, "── Profit Targets  (at full buying power) ──",
         text_color=color.gray, text_size=size.small,
         bgcolor=color.new(color.black, 10), text_halign=text.align_center)
    table.merge_cells(t, 0, 5, 1, 5)

    // ── Target 1: 200 EMA Current (red) ───────────────────────────────────────
    table.cell(t, 0, 6,
         "200 EMA Current (red)  →  $" + str.tostring(ema200Curr, "#.##"),
         text_color=color.new(color.red, 0), text_size=size.normal,
         bgcolor=color.new(color.black, 10), text_halign=text.align_left)
    table.cell(t, 1, 6, fmtTarget(pnlCurr, pctCurr),
         text_color=color.green, text_size=size.normal,
         bgcolor=color.new(color.black, 10), text_halign=text.align_right)

    // ── Target 2: 200 EMA 1m (black) ──────────────────────────────────────────
    if not na(pnl1m)
        table.cell(t, 0, 7,
             "200 EMA 1m (black)  →  $" + str.tostring(ema200_1m, "#.##"),
             text_color=color.new(color.white, 20), text_size=size.normal,
             bgcolor=color.new(color.black, 10), text_halign=text.align_left)
        table.cell(t, 1, 7, fmtTarget(pnl1m, pct1m),
             text_color=color.green, text_size=size.normal,
             bgcolor=color.new(color.black, 10), text_halign=text.align_right)
    else
        table.cell(t, 0, 7, "200 EMA 1m (black)  →  N/A",
             text_color=color.gray, text_size=size.normal,
             bgcolor=color.new(color.black, 10), text_halign=text.align_left)
        table.cell(t, 1, 7, "N/A",
             text_color=color.gray, text_size=size.normal,
             bgcolor=color.new(color.black, 10), text_halign=text.align_right)

    // ── Target 3: 200 EMA 1h (baby blue) ──────────────────────────────────────
    table.cell(t, 0, 8,
         "200 EMA 1h (blue)  →  $" + str.tostring(ema1h, "#.##"),
         text_color=color.new(#89CFF0, 0), text_size=size.normal,
         bgcolor=color.new(color.black, 10), text_halign=text.align_left)
    table.cell(t, 1, 8, fmtTarget(pnl1h, pct1h),
         text_color=color.green, text_size=size.normal,
         bgcolor=color.new(color.black, 10), text_halign=text.align_right)

    // ── Equity-scaled profit targets ──────────────────────────────────────────
    table.cell(t, 0, 9, "── Profit Targets  (at equity risk only) ──",
         text_color=color.gray, text_size=size.small,
         bgcolor=color.new(color.black, 10), text_halign=text.align_center)
    table.merge_cells(t, 0, 9, 1, 9)

    // Equity share count (how many shares $equityRisk buys)
    int   eqShares   = math.floor(equityRisk / px)
    float eqPnlCurr  = distCurr * eqShares
    float eqPnl1m    = na(dist1m) ? na : dist1m * eqShares
    float eqPnl1h    = dist1h   * eqShares

    string eqRow = "200 EMA Current  +$" + str.tostring(eqPnlCurr, "#,###.##") +
         "  |  1m  +$" + (na(eqPnl1m) ? "N/A" : str.tostring(eqPnl1m, "#,###.##")) +
         "  |  1h  +$" + str.tostring(eqPnl1h, "#,###.##")

    table.cell(t, 0, 10, eqRow,
         text_color=color.new(color.green, 20), text_size=size.small,
         bgcolor=color.new(color.black, 10), text_halign=text.align_left)
    table.merge_cells(t, 0, 10, 1, 10)
