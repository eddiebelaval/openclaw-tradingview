//@version=6
strategy("9 EMA MTF Strategy - Daily Break/1H Sustain", overlay=true, initial_capital=100000)

// --- Inputs ---
ema_len = input.int(9, "EMA Length")

// --- MTF 9 EMA Fetching (Non-Repainting) ---
f_get_ema(_tf) => request.security(syminfo.tickerid, _tf, ta.ema(close, ema_len), lookahead=barmerge.lookahead_on)

ema_m = f_get_ema("M")
ema_w = f_get_ema("W")
ema_d = f_get_ema("D")
ema_h = f_get_ema("60") // Hourly EMA on chart

// --- Entry Logic (Hourly Execution) ---
// Condition: Price breaks Daily EMA and SUSTAINS for 1-hour candle
long_condition  = close > ema_d and close[1] > ema_d and strategy.position_size == 0
short_condition = close < ema_d and close[1] < ema_d and strategy.position_size == 0

// --- Fibonacci 0.618 Exit Calculation (Previous 1H Candle) ---
prev_h = high[1]
prev_l = low[1]
fib_range = prev_h - prev_l
fib_exit_long  = prev_l + (fib_range * 0.382) // Breach of 61.8% retracement
fib_exit_short = prev_h - (fib_range * 0.382)

// --- Order Execution ---
if (long_condition)
    strategy.entry("Long", strategy.long, comment="Entry Long")

if (short_condition)
    strategy.entry("Short", strategy.short, comment="Entry Short")

// --- Exit & Target Logic ---
if (strategy.position_size > 0)
    // Exit if price breaches Fib 0.618 of previous 1H candle
    if (close < fib_exit_long)
        strategy.close("Long", comment="Fib Exit")
    // Target 1: Weekly 9 EMA | Target 2: Monthly 9 EMA
    strategy.exit("T1_Long", "Long", limit=ema_w, comment="TP1 Weekly")
    strategy.exit("T2_Long", "Long", limit=ema_m, comment="TP2 Monthly")

if (strategy.position_size < 0)
    // Exit if price breaches Fib 0.618 of previous 1H candle
    if (close > fib_exit_short)
        strategy.close("Short", comment="Fib Exit")
    // Target 1: Weekly 9 EMA | Target 2: Monthly 9 EMA
    strategy.exit("T1_Short", "Short", limit=ema_w, comment="TP1 Weekly")
    strategy.exit("T2_Short", "Short", limit=ema_m, comment="TP2 Monthly")

// --- Visuals ---
plot(ema_w, color=color.blue, title="Weekly 9 EMA", linewidth=2)
plot(ema_m, color=color.red, title="Monthly 9 EMA", linewidth=2)
plot(ema_d, color=color.orange, title="Daily 9 EMA", style=plot.style_stepline)
