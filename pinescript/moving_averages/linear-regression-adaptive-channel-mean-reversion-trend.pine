//@version=5
indicator("Linear Regression Adaptive Channel ", shorttitle="LinReg_Channel", overlay=true)

// ==========================================
// 1. Input Parameters | 输入参数
// ==========================================
lookbackPeriod = input.int(60, "Lookback Period | 统计周期", minval=1, group="Calculation Settings")
stdDevMult     = input.float(2.0, "StdDev Multiplier | 通道宽度倍数", minval=0.5, step=0.1, group="Calculation Settings")
showMeanSignals = input.bool(true, "Show Mean-Reversion Signals | 显示中轨交互信号", group="Visual Settings")

// ==========================================
// 2. Core Calculations | 基础计算
// ==========================================
// Linear Regression Basis | 线性回归基准线
regBasis = ta.linreg(close, lookbackPeriod, 0)
// Calculate Slope to determine trend direction | 计算斜率以判断趋势方向
basisSlope = regBasis - ta.linreg(close, lookbackPeriod, 1)
// Volatility measurement via Standard Deviation | 通过标准差测量波动率
sigma = ta.stdev(close, lookbackPeriod)

// Calculate Outer Channels | 计算外部轨道
upperChannel = regBasis + stdDevMult * sigma
lowerChannel = regBasis - stdDevMult * sigma

// ==========================================
// 3. Signal Filtering Logic | 信号去重逻辑
// ==========================================
// Exhaustion Signals: Triggered on price extreme breakout | 竭尽信号：价格突破极值时触发
signalOversold = ta.crossunder(low, lowerChannel) 
signalOverbought = ta.crossover(high, upperChannel)

// Mean Reversion & Interaction Logic | 中轨回归与交互逻辑
// A. Target Reached: Rebound from oversold to Mean | 目标达成：从超跌反弹至均线
targetReached = ta.crossover(close, regBasis) and basisSlope > 0
// B. Mean Support: Retest of the basis line in uptrend | 中轨支撑：上升趋势中回踩基准线
meanSupport = ta.crossunder(low, regBasis) and close > regBasis and basisSlope > 0
// C. Mean Resistance: Failed breakout of the basis line in downtrend | 中轨压力：下降趋势中反抽受阻
meanResistance = ta.crossover(high, regBasis) and close < regBasis and basisSlope < 0

// ==========================================
// 4. Visualization & Plotting | 绘图与视觉呈现
// ==========================================
p_upper = plot(upperChannel, "Upper Resistance Band", color=color.new(color.red, 30), linewidth=2)
p_basis = plot(regBasis, "Linear Regression Basis", color=color.new(color.gray, 50), style=plot.style_linebr)
p_lower = plot(lowerChannel, "Lower Support Band", color=color.new(color.blue, 30), linewidth=2)

// Cloud Filling for Visual Depth | 背景云图填充增强视觉层次感
fill(p_upper, p_basis, color=color.new(color.red, 95), title="Resistance Zone Fill")
fill(p_basis, p_lower, color=color.new(color.blue, 95), title="Support Zone Fill")

// Primary Entry/Exit Shapes | 主要进场/离场形态
plotshape(signalOversold, title="Exhaustion Buy", style=shape.triangleup, location=location.belowbar, color=color.red, size=size.small, text="BUY")
plotshape(signalOverbought, title="Exhaustion Sell", style=shape.triangledown, location=location.abovebar, color=color.green, size=size.small, text="SELL")

// Mean Reversion Labels | 中轨回归交互标签
plotshape(showMeanSignals and targetReached ? targetReached : na, title="Target 1 Met", style=shape.diamond, location=location.abovebar, color=color.yellow, size=size.tiny, text="T1")
plotshape(showMeanSignals and meanSupport ? meanSupport : na, title="Mean Support", style=shape.circle, location=location.belowbar, color=color.orange, size=size.tiny, text="ADD")
plotshape(showMeanSignals and meanResistance ? meanResistance : na, title="Mean Resistance", style=shape.circle, location=location.abovebar, color=color.fuchsia, size=size.tiny, text="REDUCE")

// ==========================================
// 5. Statistics Dashboard | 右侧实时信息面板
// ==========================================
var table statsPanel = table.new(position.top_right, 2, 2, bgcolor=color.new(color.black, 70), border_width=1)
if barstate.islast
    table.cell(statsPanel, 0, 0, "Trend Bias:", text_color=color.white, text_size=size.small)
    table.cell(statsPanel, 1, 0, basisSlope > 0 ? "BULLISH" : "BEARISH", text_color=basisSlope > 0 ? color.red : color.green, text_size=size.small)
    table.cell(statsPanel, 0, 1, "Price Status:", text_color=color.white, text_size=size.small)
    currentPos = close > upperChannel ? "OVERBOUGHT" : close < lowerChannel ? "OVERSOLD" : "NEUTRAL"
    table.cell(statsPanel, 1, 1, currentPos, text_color=color.yellow, text_size=size.small)

// ==========================================
// 6. Alert Conditions | 警报条件设置
// ==========================================
alertcondition(signalOversold, "Oversold Entry", "Price entered Oversold zone on {{ticker}}")
alertcondition(signalOverbought, "Overbought Exit", "Price entered Overbought zone on {{ticker}}")
