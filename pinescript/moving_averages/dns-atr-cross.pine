//@version=6
indicator(title="DNS ATR CROSS", shorttitle="DNS ATR", overlay=false)

// === ATR SETTINGS ===
atrLength = input.int(title="ATR Length", defval=14, minval=1, maxval=50, group="ATR Settings")

// === MOVING AVERAGE PERIODS ===
ma1Period = input.int(title="10 Day MA Period", defval=10, minval=2, maxval=200, group="MA Periods")
ma2Period = input.int(title="21 Day MA Period", defval=21, minval=2, maxval=200, group="MA Periods")
ma3Period = input.int(title="50 Day MA Period", defval=50, minval=2, maxval=200, group="MA Periods")

// === LINE COLORS ===
currentColor = input.color(title="Current ATR Color", defval=color.orange, group="Line Colors")
ma1Color = input.color(title="10 Day MA Color", defval=color.blue, group="Line Colors")
ma2Color = input.color(title="21 Day MA Color", defval=color.red, group="Line Colors")
ma3Color = input.color(title="50 Day MA Color", defval=color.green, group="Line Colors")

// === SIGNAL COLORS ===
bullishColor = input.color(title="Bullish Cross Color", defval=color.green, group="Signal Colors")
bearishColor = input.color(title="Bearish Cross Color", defval=color.red, group="Signal Colors")

// === TABLE POSITION ===
tablePosition = input.string(title="Data Panel Position", defval="top_right", options=["top_left", "top_right", "bottom_left", "bottom_right"], group="Panel Settings")

// === CALCULATIONS ===
atrCurrent = ta.atr(atrLength)
atrMA1 = ta.sma(atrCurrent, ma1Period)
atrMA2 = ta.sma(atrCurrent, ma2Period)
atrMA3 = ta.sma(atrCurrent, ma3Period)

// === CROSSOVER DETECTION ===
bullishCross = ta.crossover(atrMA1, atrMA2) and barstate.isconfirmed
bearishCross = ta.crossunder(atrMA1, atrMA2) and barstate.isconfirmed

// === TABLE POSITION MAPPING ===
tablePos = switch tablePosition
    "top_left" => position.top_left
    "top_right" => position.top_right
    "bottom_left" => position.bottom_left
    => position.bottom_right

// === PLOT ATR LINES ===
plot(atrCurrent, title="Current", color=currentColor, linewidth=1)
plot(atrMA1, title="10 Day MA", color=ma1Color, linewidth=2)
plot(atrMA2, title="21 Day MA", color=ma2Color, linewidth=2)
plot(atrMA3, title="50 Day MA", color=ma3Color, linewidth=1)

// === SIGNAL PLOTS ===
plotshape(bullishCross, title="Bullish Cross", style=shape.circle, location=location.bottom, color=bullishColor, size=size.small)
plotshape(bearishCross, title="Bearish Cross", style=shape.triangledown, location=location.top, color=bearishColor, size=size.small)

// === DATA PANEL ===
if barstate.islast
    var tbl = table.new(position=tablePos, columns=2, rows=5, 
         bgcolor=color.new(color.black, 80), 
         frame_color=color.gray, 
         frame_width=1)
    
    // 50 Day MA
    table.cell(tbl, column=0, row=0, text="50 Day MA", text_color=color.white, bgcolor=ma3Color, text_size=size.small)
    table.cell(tbl, column=1, row=0, text=str.tostring(atrMA3, "#.##"), text_color=color.white, bgcolor=ma3Color, text_size=size.small)
    
    // 21 Day MA
    table.cell(tbl, column=0, row=1, text="21 Day MA", text_color=color.white, bgcolor=ma2Color, text_size=size.small)
    table.cell(tbl, column=1, row=1, text=str.tostring(atrMA2, "#.##"), text_color=color.white, bgcolor=ma2Color, text_size=size.small)
    
    // 10 Day MA
    table.cell(tbl, column=0, row=2, text="10 Day MA", text_color=color.white, bgcolor=ma1Color, text_size=size.small)
    table.cell(tbl, column=1, row=2, text=str.tostring(atrMA1, "#.##"), text_color=color.white, bgcolor=ma1Color, text_size=size.small)
    
    // Current
    table.cell(tbl, column=0, row=3, text="Current", text_color=color.white, bgcolor=currentColor, text_size=size.small)
    table.cell(tbl, column=1, row=3, text=str.tostring(atrCurrent, "#.##"), text_color=color.white, bgcolor=currentColor, text_size=size.small)

// === ALERTS ===
alertcondition(bullishCross, title="Bullish ATR Cross", message="10 Day ATR MA crossed ABOVE 21 Day ATR MA")
alertcondition(bearishCross, title="Bearish ATR Cross", message="10 Day ATR MA crossed BELOW 21 Day ATR MA")
