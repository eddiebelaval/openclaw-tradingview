//@version=6
indicator("SMC Crypto Swing Sniper (4H Edition)", shorttitle="SMC Sniper MTF", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// -----------------------------------------------------------------------------
// 1. EINSTELLUNGEN
// -----------------------------------------------------------------------------
grp_smc   = "SMC Marktstruktur & Zonen"
pivot_len = input.int(5, "Pivot Lookback (Kerzen)", minval=2, group=grp_smc)
show_bos  = input.bool(true, "Zeige BOS & CHoCH Linien", group=grp_smc)
showOB    = input.bool(true, "Zeige SMC Order Blocks", group=grp_smc)
max_obs   = input.int(5, "Max. aktive OBs pro Richtung", minval=1, maxval=10, group=grp_smc)
mitigOB   = input.bool(true, "Zerstörte Zonen ausblenden", group=grp_smc)

grp_fvg   = "Fair Value Gaps"
showFVG   = input.bool(true, "Zeige Trend-FVGs (Gold Zone)", group=grp_fvg)
max_fvgs  = input.int(3, "Max. aktive FVGs pro Richtung", minval=1, maxval=10, group=grp_fvg)

grp_vol   = "Volumen & Orderflow"
showVol   = input.bool(true, "Zeige Volumen-Kerzen (Wale = Weiß)", group=grp_vol)
volMult   = input.float(2.0, "Volumen-Schwelle (2.0 = 200% vom Schnitt)", step=0.5, group=grp_vol)
showCvd   = input.bool(true, "Zeige CVD Divergenzen (Pfeile)", group=grp_vol)

// CVD Tuning-Menü
grp_cvd   = "CVD Divergenz Tuning"
cvd_len   = input.int(21, "CVD Period (Periodic/Rolling)", minval=5, group=grp_cvd)
divLb     = input.int(2, "Fractal Periods (Sensibilität)", minval=1, group=grp_cvd)
maxDivBars= input.int(60, "Max. Divergenz-Abstand (Kerzen)", minval=10, group=grp_cvd)

grp_trend = "Swing Trend Indikatoren (FIXED 4H/M)"
showEMAs  = input.bool(true, "Zeige EMA 50 (Fix auf 4H)", group=grp_trend)
showWMA   = input.bool(true, "Zeige WMA 200 (Fix auf 4H)", group=grp_trend)
showVwap  = input.bool(true, "Zeige Monthly VWAP (Fix auf Monat)", group=grp_trend)

grp_sr    = "Lokaler 1H Preisfilter (S/R Linien)"
show_sr   = input.bool(true, "Zeige statische S/R Linien", group=grp_sr)
sr_len    = input.int(50, "Lookback (Anzahl 1H Kerzen = 50 Std)", minval=10, group=grp_sr)

grp_dash  = "Dashboard (4h Swing Trend)"
showDash  = input.bool(true, "Zeige Markt-Dashboard", group=grp_dash)
posDash   = input.string("Top Right", "Position", options=["Top Right", "Bottom Right", "Top Left"], group=grp_dash)

// NEU: Alarme
grp_alarms = "Alarme (4H RSI)"
rsi_os_lvl = input.int(15, "RSI Oversold Alarm (Untergrenze)", minval=1, maxval=40, group=grp_alarms)
rsi_ob_lvl = input.int(85, "RSI Overbought Alarm (Obergrenze)", minval=60, maxval=99, group=grp_alarms)

// -----------------------------------------------------------------------------
// 2. FARBEN & STIL
// -----------------------------------------------------------------------------
c_neon_green = #00FF00 
c_neon_red   = #FF0055 
c_gold       = #FFD700 
c_real_blue  = #2962FF 
c_vwap       = color.new(#40E0D0, 0) 

bg_bull_ob   = color.new(c_neon_green, 80)
bg_bear_ob   = color.new(c_neon_red, 80)
bg_fvg_gold  = color.new(c_gold, 80)

// -----------------------------------------------------------------------------
// 3. VOLUMEN & CVD (PERIODIC/ROLLING)
// -----------------------------------------------------------------------------
avgVol = ta.sma(volume, 20)
isWhale = volume > (avgVol * volMult)
barcolor(showVol and isWhale ? color.white : na, title="Whale Volume")

tw = high - low
body = math.abs(close - open)
isBull = close >= open

buyVol = tw == 0 ? 0 : volume * (isBull ? ((close - low) + body) / (tw + body) : (close - low) / (tw + body))
sellVol = tw == 0 ? 0 : volume * (isBull ? (high - close) / (tw + body) : ((high - close) + body) / (tw + body))

delta = buyVol - sellVol
cvd = math.sum(delta, cvd_len) 

pl_cvd = ta.pivotlow(low, divLb, divLb)
ph_cvd = ta.pivothigh(high, divLb, divLb)

var float prev_pl_p = na
var float prev_pl_c = na
var int   prev_pl_b = na 

var float prev_ph_p = na
var float prev_ph_c = na
var int   prev_ph_b = na 

bool bDiv = false
bool sDiv = false

if not na(pl_cvd)
    if pl_cvd < prev_pl_p and cvd[divLb] > prev_pl_c and (bar_index[divLb] - prev_pl_b) <= maxDivBars
        bDiv := true
    prev_pl_p := pl_cvd
    prev_pl_c := cvd[divLb]
    prev_pl_b := bar_index[divLb]
    
if not na(ph_cvd)
    if ph_cvd > prev_ph_p and cvd[divLb] < prev_ph_c and (bar_index[divLb] - prev_ph_b) <= maxDivBars
        sDiv := true
    prev_ph_p := ph_cvd
    prev_ph_c := cvd[divLb]
    prev_ph_b := bar_index[divLb]

plotshape(showCvd and bDiv, location=location.belowbar, color=c_neon_green, style=shape.labelup, size=size.tiny, offset=-divLb, text="CVD", textcolor=color.black)
plotshape(showCvd and sDiv, location=location.abovebar, color=c_neon_red, style=shape.labeldown, size=size.tiny, offset=-divLb, text="CVD", textcolor=color.white)

// -----------------------------------------------------------------------------
// 4. SMART MARKET STRUCTURE & KLARE ORDER BLOCKS
// -----------------------------------------------------------------------------
ph = ta.pivothigh(high, pivot_len, pivot_len)
pl = ta.pivotlow(low, pivot_len, pivot_len)

var float last_swing_h = na
var float last_swing_l = na
var int last_swing_h_idx = na
var int last_swing_l_idx = na
var int smc_trend = 0 

var box[] smc_bull_obs = array.new_box()
var box[] smc_bear_obs = array.new_box()

if not na(ph)
    last_swing_h := ph
    last_swing_h_idx := bar_index[pivot_len]

if not na(pl)
    last_swing_l := pl
    last_swing_l_idx := bar_index[pivot_len]

bool breakout_up = ta.crossover(close, last_swing_h)
bool breakout_dn = ta.crossunder(close, last_swing_l)

if breakout_up
    if smc_trend == -1 or smc_trend == 0
        if show_bos
            line.new(last_swing_h_idx, last_swing_h, bar_index, last_swing_h, color=c_neon_green, style=line.style_dashed, width=2)
            label.new(int(math.avg(last_swing_h_idx, bar_index)), last_swing_h, "CHoCH", style=label.style_none, textcolor=c_neon_green, size=size.small)
        smc_trend := 1
    else if smc_trend == 1
        if show_bos
            line.new(last_swing_h_idx, last_swing_h, bar_index, last_swing_h, color=c_neon_green, style=line.style_solid, width=2)
            label.new(int(math.avg(last_swing_h_idx, bar_index)), last_swing_h, "BOS", style=label.style_none, textcolor=c_neon_green, size=size.small)
    
    if showOB and not na(last_swing_l_idx)
        int bars_back = bar_index - last_swing_l_idx
        if bars_back >= 0 and bars_back < 300 
            float ob_top = math.max(open[bars_back], close[bars_back])
            float ob_bot = low[bars_back]
            box new_ob = box.new(last_swing_l_idx, ob_top, bar_index, ob_bot, bgcolor=bg_bull_ob, border_color=na)
            array.push(smc_bull_obs, new_ob)
            if array.size(smc_bull_obs) > max_obs
                box.delete(array.shift(smc_bull_obs))

    last_swing_h := na 

if breakout_dn
    if smc_trend == 1 or smc_trend == 0
        if show_bos
            line.new(last_swing_l_idx, last_swing_l, bar_index, last_swing_l, color=c_neon_red, style=line.style_dashed, width=2)
            label.new(int(math.avg(last_swing_l_idx, bar_index)), last_swing_l, "CHoCH", style=label.style_none, textcolor=c_neon_red, size=size.small)
        smc_trend := -1
    else if smc_trend == -1
        if show_bos
            line.new(last_swing_l_idx, last_swing_l, bar_index, last_swing_l, color=c_neon_red, style=line.style_solid, width=2)
            label.new(int(math.avg(last_swing_l_idx, bar_index)), last_swing_l, "BOS", style=label.style_none, textcolor=c_neon_red, size=size.small)
    
    if showOB and not na(last_swing_h_idx)
        int bars_back = bar_index - last_swing_h_idx
        if bars_back >= 0 and bars_back < 300
            float ob_top = high[bars_back]
            float ob_bot = math.min(open[bars_back], close[bars_back])
            box new_ob = box.new(last_swing_h_idx, ob_top, bar_index, ob_bot, bgcolor=bg_bear_ob, border_color=na)
            array.push(smc_bear_obs, new_ob)
            if array.size(smc_bear_obs) > max_obs
                box.delete(array.shift(smc_bear_obs))

    last_swing_l := na

if array.size(smc_bull_obs) > 0
    for i = array.size(smc_bull_obs) - 1 to 0
        b = array.get(smc_bull_obs, i)
        box.set_right(b, bar_index + 2)
        if mitigOB and low < box.get_bottom(b) 
            box.delete(array.remove(smc_bull_obs, i))

if array.size(smc_bear_obs) > 0
    for i = array.size(smc_bear_obs) - 1 to 0
        b = array.get(smc_bear_obs, i)
        box.set_right(b, bar_index + 2)
        if mitigOB and high > box.get_top(b) 
            box.delete(array.remove(smc_bear_obs, i))

// -----------------------------------------------------------------------------
// 5. FAIR VALUE GAPS (FVG)
// -----------------------------------------------------------------------------
var box[] fvgs_bull = array.new_box()
var box[] fvgs_bear = array.new_box()

if showFVG
    if low > high[2] and smc_trend == 1
        box new_fvg_bull = box.new(bar_index - 2, low, bar_index, high[2], bgcolor=bg_fvg_gold, border_color=na)
        array.push(fvgs_bull, new_fvg_bull)
        if array.size(fvgs_bull) > max_fvgs
            box.delete(array.shift(fvgs_bull))

    if high < low[2] and smc_trend == -1
        box new_fvg_bear = box.new(bar_index - 2, low[2], bar_index, high, bgcolor=bg_fvg_gold, border_color=na)
        array.push(fvgs_bear, new_fvg_bear)
        if array.size(fvgs_bear) > max_fvgs
            box.delete(array.shift(fvgs_bear))

if array.size(fvgs_bull) > 0
    for i = array.size(fvgs_bull) - 1 to 0
        b = array.get(fvgs_bull, i)
        box.set_right(b, bar_index + 2)
        if low <= box.get_bottom(b) 
            box.delete(array.remove(fvgs_bull, i))

if array.size(fvgs_bear) > 0
    for i = array.size(fvgs_bear) - 1 to 0
        b = array.get(fvgs_bear, i)
        box.set_right(b, bar_index + 2)
        if high >= box.get_top(b) 
            box.delete(array.remove(fvgs_bear, i))

// -----------------------------------------------------------------------------
// 6. 1H S/R LEVEL (CLEAN HORIZONTAL LINES)
// -----------------------------------------------------------------------------
var line line_res = line.new(na, na, na, na, color=c_neon_red, width=2)
var line line_mid = line.new(na, na, na, na, color=c_gold, width=2)
var line line_sup = line.new(na, na, na, na, color=c_neon_green, width=2)

var label lab_res = label.new(na, na, "1H Res", color=color.new(color.black, 100), textcolor=c_neon_red, style=label.style_label_down, size=size.small)
var label lab_mid = label.new(na, na, "1H Mid", color=color.new(color.black, 100), textcolor=c_gold, style=label.style_label_left, size=size.small)
var label lab_sup = label.new(na, na, "1H Sup", color=color.new(color.black, 100), textcolor=c_neon_green, style=label.style_label_up, size=size.small)

[htf_h, htf_l] = request.security(syminfo.tickerid, "60", [ta.highest(high, sr_len), ta.lowest(low, sr_len)])
htf_m = math.avg(htf_h, htf_l)

if barstate.islast
    if show_sr
        start_idx = bar_index - 100 
        end_idx   = bar_index + 15  
        
        line.set_xy1(line_res, start_idx, htf_h)
        line.set_xy2(line_res, end_idx, htf_h)
        
        line.set_xy1(line_mid, start_idx, htf_m)
        line.set_xy2(line_mid, end_idx, htf_m)
        
        line.set_xy1(line_sup, start_idx, htf_l)
        line.set_xy2(line_sup, end_idx, htf_l)
        
        label.set_xy(lab_res, end_idx, htf_h)
        label.set_xy(lab_mid, end_idx, htf_m)
        label.set_xy(lab_sup, end_idx, htf_l)
    else
        line.set_xy1(line_res, na, na)
        line.set_xy1(line_mid, na, na)
        line.set_xy1(line_sup, na, na)
        label.set_xy(lab_res, na, na)
        label.set_xy(lab_mid, na, na)
        label.set_xy(lab_sup, na, na)

// -----------------------------------------------------------------------------
// 7. FIXIERTE TRENDS (4H) & VWAP (MONTHLY)
// -----------------------------------------------------------------------------
ema50_4h  = request.security(syminfo.tickerid, "240", ta.ema(close, 50))
wma200_4h = request.security(syminfo.tickerid, "240", ta.wma(close, 200))
avwap     = ta.vwap(hlc3, timeframe.change("M")) 

plot(showEMAs ? ema50_4h : na, "EMA 50 (4H)", color=c_neon_green, linewidth=2) 
plot(showWMA ? wma200_4h : na, "WMA 200 (4H)", color=c_real_blue, linewidth=2)
plot(showVwap ? avwap : na, "Monthly VWAP", color=c_vwap, linewidth=3) 

var label lab_ema  = label.new(na, na, "EMA 50 (4H)", style=label.style_none, textcolor=c_neon_green, size=size.small)
var label lab_wma  = label.new(na, na, "WMA 200 (4H)", style=label.style_none, textcolor=c_real_blue, size=size.small)
var label lab_vwap = label.new(na, na, "M.VWAP", style=label.style_none, textcolor=c_vwap, size=size.small) 

if barstate.islast
    end = bar_index + 12
    if showEMAs
        label.set_xy(lab_ema, end + 1, ema50_4h)
    if showWMA
        label.set_xy(lab_wma, end + 1, wma200_4h)
    if showVwap
        label.set_xy(lab_vwap, end + 1, avwap)

// -----------------------------------------------------------------------------
// 8. DASHBOARD MIT ADX
// -----------------------------------------------------------------------------
dash_calc() => 
    [m, s, _] = ta.macd(close, 12, 26, 9)
    [diPlus, diMinus, adx] = ta.dmi(14, 14)
    [close, ta.ema(close, 50), ta.rsi(close, 14), m, s, diPlus, diMinus, adx]

[btc_c, btc_e, btc_r, btc_m, btc_s, btc_dp, btc_dm, btc_a] = request.security("BINANCE:BTCUSDT", "240", dash_calc())
[btcd_c, btcd_e, btcd_r, btcd_m, btcd_s, btcd_dp, btcd_dm, btcd_a] = request.security("CRYPTOCAP:BTC.D", "240", dash_calc())
[usdtd_c, usdtd_e, usdtd_r, usdtd_m, usdtd_s, usdtd_dp, usdtd_dm, usdtd_a] = request.security("CRYPTOCAP:USDT.D", "240", dash_calc())
[curr_c, curr_e, curr_r, curr_m, curr_s, curr_dp, curr_dm, curr_a] = request.security(syminfo.tickerid, "240", dash_calc())

if showDash and barstate.islast
    var table tbl = table.new(posDash == "Top Right" ? position.top_right : posDash == "Bottom Right" ? position.bottom_right : position.top_left, 5, 5, bgcolor=color.new(color.black, 40), border_width=1)
    table.cell(tbl, 0, 0, "ASSET", text_color=color.white, bgcolor=color.new(color.gray, 50))
    table.cell(tbl, 1, 0, "4H TREND", text_color=color.white, bgcolor=color.new(color.gray, 50))
    table.cell(tbl, 2, 0, "4H RSI", text_color=color.white, bgcolor=color.new(color.gray, 50))
    table.cell(tbl, 3, 0, "4H MACD", text_color=color.white, bgcolor=color.new(color.gray, 50))
    table.cell(tbl, 4, 0, "4H ADX", text_color=color.white, bgcolor=color.new(color.gray, 50)) 

    string[] assets = array.from("BTC", "BTC.D", "USDT.D", syminfo.ticker)
    float[] prices  = array.from(btc_c, btcd_c, usdtd_c, curr_c)
    float[] emas    = array.from(btc_e, btcd_e, usdtd_e, curr_e)
    float[] rsis    = array.from(btc_r, btcd_r, usdtd_r, curr_r)
    float[] macds   = array.from(btc_m, btcd_m, usdtd_m, curr_m)
    float[] sigs    = array.from(btc_s, btcd_s, usdtd_s, curr_s)
    float[] dps     = array.from(btc_dp, btcd_dp, usdtd_dp, curr_dp)
    float[] dms     = array.from(btc_dm, btcd_dm, usdtd_dm, curr_dm)
    float[] adxs    = array.from(btc_a, btcd_a, usdtd_a, curr_a)

    for i = 0 to 3
        c = array.get(prices, i), e = array.get(emas, i), r = array.get(rsis, i), m = array.get(macds, i), s = array.get(sigs, i)
        dp = array.get(dps, i), dm = array.get(dms, i), ax = array.get(adxs, i)
        
        bg_color = i == 3 ? color.new(color.blue, 80) : na
        table.cell(tbl, 0, i+1, array.get(assets, i), text_color=color.white, bgcolor=bg_color)
        table.cell(tbl, 1, i+1, c > e ? "BULL" : "BEAR", text_color=c > e ? c_neon_green : c_neon_red, bgcolor=bg_color)
        table.cell(tbl, 2, i+1, str.tostring(math.round(r)), text_color=r >= 70 ? c_neon_red : r <= 30 ? c_neon_green : color.white, bgcolor=bg_color)
        table.cell(tbl, 3, i+1, m > s ? "BULL" : "BEAR", text_color=m > s ? c_neon_green : c_neon_red, bgcolor=bg_color)
        
        adx_str = ax >= 25 ? (dp > dm ? "BULL" : "BEAR") : "WEAK"
        adx_col = ax >= 25 ? (dp > dm ? c_neon_green : c_neon_red) : color.gray
        table.cell(tbl, 4, i+1, adx_str + " (" + str.tostring(math.round(ax)) + ")", text_color=adx_col, bgcolor=bg_color)

// -----------------------------------------------------------------------------
// 9. ALARME (4H RSI)
// -----------------------------------------------------------------------------
bool rsi_os_alert = ta.crossunder(curr_r, rsi_os_lvl)
bool rsi_ob_alert = ta.crossover(curr_r, rsi_ob_lvl)

alertcondition(rsi_os_alert, title="🚨 4H RSI Oversold", message="RSI auf 4H unter das Oversold-Level ({{curr_r}}) gefallen bei {{ticker}}!")
alertcondition(rsi_ob_alert, title="🚨 4H RSI Overbought", message="RSI auf 4H über das Overbought-Level ({{curr_r}}) gestiegen bei {{ticker}}!")
