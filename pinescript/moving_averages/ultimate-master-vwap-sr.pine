//@version=5
indicator("Ultimate Master VWAP & S/R", overlay=true, max_lines_count=500)

// --- INPUTS ---
group_vwap = "Standard VWAP Settings"
show_d   = input.bool(true, "Current Day VWAP", group=group_vwap, inline="d")
col_d    = input.color(color.blue, "", group=group_vwap, inline="d")
show_pd  = input.bool(true, "Previous Day VWAP", group=group_vwap, inline="pd")
col_pd   = input.color(color.new(color.blue, 50), "", group=group_vwap, inline="pd")
show_w   = input.bool(true, "Weekly VWAP", group=group_vwap, inline="w")
col_w    = input.color(color.orange, "", group=group_vwap, inline="w")
show_m   = input.bool(true, "Monthly VWAP", group=group_vwap, inline="m")
col_m    = input.color(color.red, "", group=group_vwap, inline="m")
show_y   = input.bool(true, "Yearly VWAP", group=group_vwap, inline="y")
col_y    = input.color(color.yellow, "", group=group_vwap, inline="y")
show_py  = input.bool(true, "Last Year VWAP", group=group_vwap, inline="py")
col_py   = input.color(color.new(color.yellow, 60), "", group=group_vwap, inline="py")

group_q = "Quarterly VWAP Settings"
show_q_curr = input.bool(true, "Show Current Year Quarters (Q1-Q4)", group=group_q)
show_q_prev = input.bool(true, "Show Previous Year Quarters (2025)", group=group_q)

group_sma = "Custom SMA Settings"
show_sma = input.bool(true, "Show Custom SMA", group=group_sma, inline="sma")
col_sma  = input.color(color.white, "", group=group_sma, inline="sma")
sma_len  = input.int(20, "SMA Length", minval=1, group=group_sma)
sma_tf   = input.timeframe("D", "SMA Timeframe", group=group_sma)

group_sr = "Support & Resistance"
show_sr_d = input.bool(true, "Daily High/Low", group=group_sr, inline="srd")
col_sr_d  = input.color(color.gray, "", group=group_sr, inline="srd")
show_sr_w = input.bool(true, "Weekly High/Low", group=group_sr, inline="srw")
col_sr_w  = input.color(color.new(color.yellow, 30), "", group=group_sr, inline="srw")
show_sr_m = input.bool(true, "Monthly High/Low", group=group_sr, inline="srm")
col_sr_m  = input.color(color.fuchsia, "", group=group_sr, inline="srm")

// --- FUNCTIONS ---
f_label(_val, _txt, _col) =>
    var label _l = na
    label.delete(_l)
    _l := label.new(bar_index, _val, _txt, color=color.new(_col, 100), textcolor=_col, style=label.style_label_left, size=size.small)

// --- DATA FETCHING ---
d_h = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
d_l = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
w_h = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_on)
w_l = request.security(syminfo.tickerid, "W", low[1], lookahead=barmerge.lookahead_on)
m_h = request.security(syminfo.tickerid, "M", high[1], lookahead=barmerge.lookahead_on)
m_l = request.security(syminfo.tickerid, "M", low[1], lookahead=barmerge.lookahead_on)

sma_base = ta.sma(close, sma_len)
sma_val = request.security(syminfo.tickerid, sma_tf, sma_base, lookahead=barmerge.lookahead_on)

// --- VWAP CALCULATIONS ---
v_d = ta.vwap(hlc3, timeframe.change("D"))
v_w = ta.vwap(hlc3, timeframe.change("W"))
v_m = ta.vwap(hlc3, timeframe.change("M"))
v_y = ta.vwap(hlc3, timeframe.change("12M"))

pd_vwap = request.security(syminfo.tickerid, "D", v_d[1], lookahead=barmerge.lookahead_on)
py_vwap = request.security(syminfo.tickerid, "12M", v_y[1], lookahead=barmerge.lookahead_on)

v_q1 = ta.vwap(hlc3, month == 1 and ta.change(month))
v_q2 = ta.vwap(hlc3, month == 4 and ta.change(month))
v_q3 = ta.vwap(hlc3, month == 7 and ta.change(month))
v_q4 = ta.vwap(hlc3, month == 10 and ta.change(month))

pq1 = request.security(syminfo.tickerid, "3M", v_q1[1], lookahead=barmerge.lookahead_on)
pq2 = request.security(syminfo.tickerid, "3M", v_q2[1], lookahead=barmerge.lookahead_on)
pq3 = request.security(syminfo.tickerid, "3M", v_q3[1], lookahead=barmerge.lookahead_on)
pq4 = request.security(syminfo.tickerid, "3M", v_q4[1], lookahead=barmerge.lookahead_on)

// --- BACKGROUND ---
q_bg = (month <= 3) ? color.new(color.aqua, 90) : (month >= 4 and month <= 6) ? color.new(color.lime, 90) : (month >= 7 and month <= 9) ? color.new(color.orange, 90) : color.new(color.maroon, 90)
bgcolor(show_q_curr ? q_bg : na)

// --- PLOTS ---
plot(show_d ? v_d : na, "D-VWAP", color=col_d)
plot(show_pd ? pd_vwap : na, "PD-VWAP", color=col_pd, style=plot.style_linebr)
plot(show_w ? v_w : na, "W-VWAP", color=col_w)
plot(show_m ? v_m : na, "M-VWAP", color=col_m)
plot(show_y ? v_y : na, "Y-VWAP", color=col_y, linewidth=2)
plot(show_py ? py_vwap : na, "PY-VWAP", color=col_py, style=plot.style_linebr)

plot(show_q_curr and month <= 3 ? v_q1 : na, "Q1-VWAP", color=color.aqua)
plot(show_q_curr and month >= 4 and month <= 6 ? v_q2 : na, "Q2-VWAP", color=color.lime)
plot(show_q_curr and month >= 7 and month <= 9 ? v_q3 : na, "Q3-VWAP", color=color.orange)
plot(show_q_curr and month >= 10 ? v_q4 : na, "Q4-VWAP", color=color.maroon)

plot(show_q_prev ? pq1 : na, "2025 Q1-VWAP", color=color.new(color.aqua, 60), style=plot.style_linebr)
plot(show_q_prev ? pq2 : na, "2025 Q2-VWAP", color=color.new(color.lime, 60), style=plot.style_linebr)
plot(show_q_prev ? pq3 : na, "2025 Q3-VWAP", color=color.new(color.orange, 60), style=plot.style_linebr)
plot(show_q_prev ? pq4 : na, "2025 Q4-VWAP", color=color.new(color.maroon, 60), style=plot.style_linebr)

plot(show_sma ? sma_val : na, "MTF SMA", color=col_sma, linewidth=2)

// --- LABELS & LINES ---
if barstate.islast
    if show_d 
        f_label(v_d, "D-VWAP", col_d)
    if show_pd 
        f_label(pd_vwap, "PD-VWAP", col_pd)
    if show_w 
        f_label(v_w, "W-VWAP", col_w)
    if show_m 
        f_label(v_m, "M-VWAP", col_m)
    if show_y 
        f_label(v_y, "Y-VWAP", col_y)
    if show_q_curr and month >= 4 and month <= 6
        f_label(v_q2, "Q2-VWAP", color.lime)
    if show_sma 
        f_label(sma_val, "SMA (" + sma_tf + ")", col_sma)
    
    // Daily S/R
    if show_sr_d
        line.new(bar_index[20], d_h, bar_index, d_h, extend=extend.right, color=col_sr_d)
        f_label(d_h, "D-High", col_sr_d)
        line.new(bar_index[20], d_l, bar_index, d_l, extend=extend.right, color=col_sr_d)
        f_label(d_l, "D-Low", col_sr_d)
    // Weekly S/R
    if show_sr_w
        line.new(bar_index[20], w_h, bar_index, w_h, extend=extend.right, color=col_sr_w)
        f_label(w_h, "W-High", col_sr_w)
        line.new(bar_index[20], w_l, bar_index, w_l, extend=extend.right, color=col_sr_w)
        f_label(w_l, "W-Low", col_sr_w)
    // Monthly S/R
    if show_sr_m
        line.new(bar_index[20], m_h, bar_index, m_h, extend=extend.right, color=col_sr_m)
        f_label(m_h, "M-High", col_sr_m)
        line.new(bar_index[20], m_l, bar_index, m_l, extend=extend.right, color=col_sr_m)
        f_label(m_l, "M-Low", col_sr_m)
