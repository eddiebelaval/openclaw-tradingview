//@version=5
indicator("EMA 9/21 + RSI Exit Clean Final", overlay=true)

// ===== INPUTS =====
emaFastLen = input.int(9, "EMA Fast")
emaSlowLen = input.int(21, "EMA Slow")
rsiLen     = input.int(14, "RSI Length")
rsiUpper   = input.int(90, "RSI Upper")
rsiLower   = input.int(10, "RSI Lower")

// ===== CALCULATIONS =====
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi     = ta.rsi(close, rsiLen)

plot(emaFast, color=color.green)
plot(emaSlow, color=color.red)

// ===== CROSS =====
bullCross = ta.crossover(emaFast, emaSlow)
bearCross = ta.crossunder(emaFast, emaSlow)
anyCross  = bullCross or bearCross

// ===== TRIANGLES =====
plotshape(bullCross, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(bearCross, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

// ===== VARIABLES =====
var line activeLine = na
var int tradeDir = 0  // 1=Long, -1=Short

// ===== STOP LINE ON NEW CROSS =====
if anyCross and not na(activeLine)
    line.set_x2(activeLine, bar_index)
    line.set_extend(activeLine, extend.none)
    activeLine := na

// ===== ENTRY =====
if bullCross
    tradeDir := 1
    activeLine := line.new(bar_index, close, bar_index + 1, close, extend=extend.right, color=color.green, width=2)

if bearCross
    tradeDir := -1
    activeLine := line.new(bar_index, close, bar_index + 1, close, extend=extend.right, color=color.red, width=2)

// ===== RSI EXIT =====
rsiLongExit  = tradeDir == 1 and rsi >= rsiUpper
rsiShortExit = tradeDir == -1 and rsi <= rsiLower
rsiExit = rsiLongExit or rsiShortExit

if rsiExit and not na(activeLine)
    line.set_x2(activeLine, bar_index)
    line.set_extend(activeLine, extend.none)
    activeLine := line.new(bar_index, close, bar_index + 1, close, extend=extend.right, color=color.orange, width=2)
    tradeDir := 0

// ===== CROSS EXIT CONDITION (Single Line) =====
crossExit = (tradeDir == 1 and bearCross) or (tradeDir == -1 and bullCross)

// ===== ALERTS =====
alertcondition(bullCross, title="Long Entry", message="EMA 9 crossed above EMA 21 - LONG ENTRY")
alertcondition(bearCross, title="Short Entry", message="EMA 9 crossed below EMA 21 - SHORT ENTRY")
alertcondition(rsiExit, title="RSI Exit", message="Trade Exit due to RSI level hit")
alertcondition(crossExit, title="Crossover Exit", message="Trade Exit due to Opposite EMA Crossover")
