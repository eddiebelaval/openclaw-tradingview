//@version=5
indicator("Triple MTF MA Painter - Directional Toggles", overlay=true)

// --- DISPLAY SETTINGS ---
g_disp = "Display Settings"
showBullish  = input.bool(true, "Show Bullish Signals", group=g_disp)
showBearish  = input.bool(true, "Show Bearish Signals", group=g_disp)
showBarColor = input.bool(true, "Show Bar Coloring", group=g_disp)
showLabels   = input.bool(true, "Show Labels", group=g_disp)

// --- HELPER FUNCTION ---
get_ma(src, len, type) =>
    switch type
        "SMA"   => ta.sma(src, len)
        "EMA"   => ta.ema(src, len)
        "VWMA"  => ta.vwma(src, len)
        "ZLEMA" => 
            lag = math.floor((len - 1) / 2)
            ta.ema(src + (src - src[lag]), len)
        => ta.ema(src, len)

// --- MA 1 SETTINGS ---
g1 = "Moving Average 1"
ma1_On     = input.bool(true, "Enable MA 1", group=g1)
ma1_TF     = input.timeframe("D", "MA 1 Timeframe", group=g1)
ma1_Len    = input.int(50, "MA 1 Length", minval=1, group=g1)
ma1_Type   = input.string("EMA", "MA 1 Type", options=["SMA", "EMA", "VWMA", "ZLEMA"], group=g1)
ma1_Source = input.source(close, "MA 1 Source", group=g1)
ma1_Color  = input.color(color.new(color.blue, 30), "MA 1 Color", group=g1)

// --- MA 2 SETTINGS ---
g2 = "Moving Average 2"
ma2_On     = input.bool(true, "Enable MA 2", group=g2)
ma2_TF     = input.timeframe("", "MA 2 Timeframe", group=g2)
ma2_Len    = input.int(20, "MA 2 Length", minval=1, group=g2)
ma2_Type   = input.string("VWMA", "MA 2 Type", options=["SMA", "EMA", "VWMA", "ZLEMA"], group=g2)
ma2_Source = input.source(close, "MA 2 Source", group=g2)
ma2_Color  = input.color(color.new(color.orange, 30), "MA 2 Color", group=g2)

// --- MA 3 SETTINGS ---
g3 = "Moving Average 3"
ma3_On     = input.bool(true, "Enable MA 3", group=g3)
ma3_TF     = input.timeframe("", "MA 3 Timeframe", group=g3)
ma3_Len    = input.int(14, "MA 3 Length", minval=1, group=g3)
ma3_Type   = input.string("ZLEMA", "MA 3 Type", options=["SMA", "EMA", "VWMA", "ZLEMA"], group=g3)
ma3_Source = input.source(close, "MA 3 Source", group=g3)
ma3_Color  = input.color(color.new(color.purple, 30), "MA 3 Color", group=g3)

// --- Calculations ---
ma1 = request.security(syminfo.tickerid, ma1_TF, get_ma(ma1_Source, ma1_Len, ma1_Type), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
ma2 = request.security(syminfo.tickerid, ma2_TF, get_ma(ma2_Source, ma2_Len, ma2_Type), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
ma3 = request.security(syminfo.tickerid, ma3_TF, get_ma(ma3_Source, ma3_Len, ma3_Type), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

plot(ma1_On ? ma1 : na, color=ma1_Color, title="MA 1", linewidth=2)
plot(ma2_On ? ma2 : na, color=ma2_Color, title="MA 2", linewidth=2)
plot(ma3_On ? ma3 : na, color=ma3_Color, title="MA 3", linewidth=2)

// --- Logic Filter ---
above1 = not ma1_On or close > ma1
above2 = not ma2_On or close > ma2
above3 = not ma3_On or close > ma3
below1 = not ma1_On or close < ma1
below2 = not ma2_On or close < ma2
below3 = not ma3_On or close < ma3

isAboveAll = above1 and above2 and above3
isBelowAll = below1 and below2 and below3

isBullishBar = high > high[1] and low > low[1]
isBearishBar = high < high[1] and low < low[1]

// State Machine (Maintains trend memory)
var int lastSignal = 0 
bool triggerBullish = (isBullishBar and isAboveAll and lastSignal != 1)
bool triggerBearish = (isBearishBar and isBelowAll and lastSignal != 2)

if triggerBullish
    lastSignal := 1
if triggerBearish
    lastSignal := 2

// --- Final Output Logic with Toggles ---
showBull = showBullish and triggerBullish
showBear = showBearish and triggerBearish

barcolor(showBarColor ? (showBull ? color.green : showBear ? color.red : na) : na)

if showBull and showLabels
    label.new(bar_index, low, "Bullish", color=color.green, style=label.style_label_up, textcolor=color.white, size=size.small)

if showBear and showLabels
    label.new(bar_index, high, "Bearish", color=color.red, style=label.style_label_down, textcolor=color.white, size=size.small)
