//@version=6
indicator("MTF Composite SMA Midline + ADR Channel AA",
     overlay=true, max_bars_back=5000, dynamic_requests=true)

//────────────────────────────────────────────────────────────────────────────
// 0) MTF MIDLINE / ZONE BACKBONE
//────────────────────────────────────────────────────────────────────────────
groupMTF = "MTF Settings"

mtfA  = input.timeframe("15",  "MTF A", group=groupMTF)
len1A = input.int(7, "A: V1 (outer len)", minval=1, group=groupMTF)
len2A = input.int(14, "A: V2 (inner len)", minval=1, group=groupMTF)

mtfB  = input.timeframe("60",  "MTF B", group=groupMTF)
len1B = input.int(7, "B: V1 (outer len)", minval=1, group=groupMTF)
len2B = input.int(14, "B: V2 (inner len)", minval=1, group=groupMTF)

mtfC  = input.timeframe("240", "MTF C", group=groupMTF)
len1C = input.int(7, "C: V1 (outer len)", minval=1, group=groupMTF)
len2C = input.int(14, "C: V2 (inner len)", minval=1, group=groupMTF)

mtfD  = input.timeframe("720", "MTF D", group=groupMTF)
len1D = input.int(7, "D: V1 (outer len)", minval=1, group=groupMTF)
len2D = input.int(14, "D: V2 (inner len)", minval=1, group=groupMTF)

usePrev  = 1
smoothOn = true
tfNum    = str.tonumber(timeframe.period)

isNumTf(s) =>
    not na(str.tonumber(s))

canSmooth(tfStr) =>
    smoothOn and isNumTf(tfStr) and not na(tfNum) and tfNum > 0

scaleLen(tfStr, baseLen) =>
    canSmooth(tfStr) ? int(math.max(1, math.round(str.tonumber(tfStr) * baseLen / tfNum))) : baseLen

hi_only_sma(_l1, _l2, _prev) =>
    ta.sma(ta.sma(high[_prev], _l2), _l1)

lo_only_sma(_l1, _l2, _prev) =>
    ta.sma(ta.sma(low[_prev], _l2), _l1)

mid_only_sma(_l1, _l2, _prev) =>
    (hi_only_sma(_l1, _l2, _prev) + lo_only_sma(_l1, _l2, _prev)) / 2.0

mtfHigh(tfStr, l1, l2) =>
    canSmooth(tfStr)
         ? hi_only_sma(scaleLen(tfStr, l1), scaleLen(tfStr, l2), 0)
         : request.security(syminfo.tickerid, tfStr, hi_only_sma(l1, l2, usePrev),
              gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

mtfLow(tfStr, l1, l2) =>
    canSmooth(tfStr)
         ? lo_only_sma(scaleLen(tfStr, l1), scaleLen(tfStr, l2), 0)
         : request.security(syminfo.tickerid, tfStr, lo_only_sma(l1, l2, usePrev),
              gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

mtfMid(tfStr, l1, l2) =>
    canSmooth(tfStr)
         ? mid_only_sma(scaleLen(tfStr, l1), scaleLen(tfStr, l2), 0)
         : request.security(syminfo.tickerid, tfStr, mid_only_sma(l1, l2, usePrev),
              gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

hA = mtfHigh(mtfA, len1A, len2A)
hB = mtfHigh(mtfB, len1B, len2B)
hC = mtfHigh(mtfC, len1C, len2C)
hD = mtfHigh(mtfD, len1D, len2D)

lA = mtfLow(mtfA, len1A, len2A)
lB = mtfLow(mtfB, len1B, len2B)
lC = mtfLow(mtfC, len1C, len2C)
lD = mtfLow(mtfD, len1D, len2D)

mA = mtfMid(mtfA, len1A, len2A)
mB = mtfMid(mtfB, len1B, len2B)
mC = mtfMid(mtfC, len1C, len2C)
mD = mtfMid(mtfD, len1D, len2D)

median4(v1, v2, v3, v4) =>
    float a = v1, b = v2, c = v3, d = v4
    float s12 = math.min(a, b), b12 = math.max(a, b)
    float s34 = math.min(c, d), b34 = math.max(c, d)
    float midL = math.max(s12, s34)
    float midH = math.min(b12, b34)
    (midL + midH) / 2.0

Uhigh = median4(hA, hB, hC, hD)
Ulow  = median4(lA, lB, lC, lD)
Umid  = median4(mA, mB, mC, mD)

//────────────────────────────────────────────────────────────────────────────
// 1) ADR AROUND UMID
//────────────────────────────────────────────────────────────────────────────
groupRange = "ADR Around Umid"

showADR = input.bool(true, "Show ADR", group=groupRange)
adrLen  = input.int(14, "ADR Length", minval=1, group=groupRange)
kADR    = input.float(1.0, "ADR Multiplier", step=0.05, minval=0.0, group=groupRange)

adrHL = request.security(
    syminfo.tickerid, "D", ta.sma(high - low, adrLen)[1],
    gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

ADR_Up = Umid + kADR * adrHL
ADR_Dn = Umid - kADR * adrHL

//────────────────────────────────────────────────────────────────────────────
// 2) PLOTS
//────────────────────────────────────────────────────────────────────────────
plot(Umid, "Umid", color=color.new(color.white, 0), linewidth=2)

pADRUp = plot(showADR ? ADR_Up : na, "ADR Upper", color=color.new(color.aqua, 0), linewidth=1)
pADRDn = plot(showADR ? ADR_Dn : na, "ADR Lower", color=color.new(color.aqua, 0), linewidth=1)

fill(pADRUp, pADRDn, color=color.new(color.aqua, 92), title="ADR Fill")

//────────────────────────────────────────────────────────────────────────────
// 3) ALERT LOGIC
//────────────────────────────────────────────────────────────────────────────
crossUpUmid_raw  = ta.crossover(close, Umid)
crossDnUmid_raw  = ta.crossunder(close, Umid)

crossUpADRUp_raw = ta.crossover(close, ADR_Up)
crossDnADRUp_raw = ta.crossunder(close, ADR_Up)

crossUpADRDn_raw = ta.crossover(close, ADR_Dn)
crossDnADRDn_raw = ta.crossunder(close, ADR_Dn)

crossUpUmid  = crossUpUmid_raw
crossDnUmid  = crossDnUmid_raw

crossUpADRUp = showADR and crossUpADRUp_raw
crossDnADRUp = showADR and crossDnADRUp_raw

crossUpADRDn = showADR and crossUpADRDn_raw
crossDnADRDn = showADR and crossDnADRDn_raw

alertcondition(crossUpUmid,  "Price Crossed Above Umid",      "Price crossed above Umid")
alertcondition(crossDnUmid,  "Price Crossed Below Umid",      "Price crossed below Umid")
alertcondition(crossUpADRUp, "Price Crossed Above ADR Upper", "Price crossed above ADR Upper")
alertcondition(crossDnADRUp, "Price Crossed Below ADR Upper", "Price crossed below ADR Upper")
alertcondition(crossUpADRDn, "Price Crossed Above ADR Lower", "Price crossed above ADR Lower")
alertcondition(crossDnADRDn, "Price Crossed Below ADR Lower", "Price crossed below ADR Lower")
