//@version=6
indicator("Elite Cloud Breakout [LuxAlgo Optimized]", shorttitle="Elite Cloud", overlay = true)

// --- Constants ---
color BULL_COLOR    = #089981
color BEAR_COLOR    = #f23645
color NEUTRAL_COLOR = #5b9cf6

// --- Inputs ---
int emaLengthInput   = input.int(21, "EMA Cloud Length", minval = 1, tooltip = "Length for the High/Low EMA bands that form the cloud.")
int sensitivityInput = input.int(1, "Trailing Stop Sensitivity", minval = 1, tooltip = "Sensitivity for the UT Bot trailing stop visual.")
int atrPeriodInput   = input.int(10, "ATR Period", minval = 1, tooltip = "ATR period for the trailing stop volatility.")
bool showUTStop      = input.bool(true, "Show Trailing Stop", tooltip = "Display the UT Bot trailing stop line on the chart.")

// --- Calculations ---
// Dual EMA Cloud
float emaHigh = ta.ema(high, emaLengthInput)
float emaLow  = ta.ema(low, emaLengthInput)
float emaAvg  = (emaHigh + emaLow) / 2

// UT Bot Logic (Used as a trailing stop guide)
float nLoss = sensitivityInput * ta.atr(atrPeriodInput)
var float trailingStop = 0.0
trailingStop := if close > trailingStop[1] and close[1] > trailingStop[1]
    math.max(trailingStop[1], close - nLoss)
else if close < trailingStop[1] and close[1] < trailingStop[1]
    math.min(trailingStop[1], close + nLoss)
else if close > trailingStop[1]
    close - nLoss
else
    close + nLoss

// --- Signal Logic: 2-Bar Cloud Breakout ---
// A signal triggers ONLY when the current AND previous candle close outside the cloud,
// and the candle before that was NOT outside (to ensure it's the start of the breakout).
bool isAbove = close > emaHigh
bool isBelow = close < emaLow

bool buySignal  = isAbove and isAbove[1] and not isAbove[2]
bool sellSignal = isBelow and isBelow[1] and not isBelow[2]

// Trend State for Visuals
bool isUptrend   = emaHigh > emaHigh[1] and emaLow > emaLow[1]
bool isDowntrend = emaHigh < emaHigh[1] and emaLow < emaLow[1]
color cloudColor = isUptrend ? BULL_COLOR : isDowntrend ? BEAR_COLOR : NEUTRAL_COLOR

// --- Visuals ---
// EMA Cloud with Vertical Gradients (Transparent Center)
p_high = plot(emaHigh, "EMA High", color.new(cloudColor, 80))
p_low  = plot(emaLow,  "EMA Low",  color.new(cloudColor, 80))
p_avg  = plot(emaAvg,  "EMA Mid",  color.new(cloudColor, 100))

fill(p_high, p_avg, emaHigh, emaAvg, color.new(cloudColor, 80), color.new(cloudColor, 100), "Upper Cloud")
fill(p_low,  p_avg, emaAvg,  emaLow,  color.new(cloudColor, 100), color.new(cloudColor, 80), "Lower Cloud")

// Signal Labels (Triggered on the 2nd candle close)
plotshape(buySignal,  "Confirmed Buy",  shape.labelup,   location.belowbar, BULL_COLOR, 0, "BUY",  color.white, size = size.small)
plotshape(sellSignal, "Confirmed Sell", shape.labeldown, location.abovebar, BEAR_COLOR, 0, "SELL", color.white, size = size.small)

// UT Trailing Stop Visual
plot(showUTStop ? trailingStop : na, "UT Stop", close > trailingStop ? color.new(BULL_COLOR, 50) : color.new(BEAR_COLOR, 50), 1, plot.style_linebr)

// Visual Hierarchy: Dim bars inside the "Neutral Zone"
barcolor(isAbove ? BULL_COLOR : isBelow ? BEAR_COLOR : color.new(chart.fg_color, 70))

// --- Alerts ---
alertcondition(buySignal,  "Confirmed Cloud Breakout Buy",  "Two consecutive candles closed above the EMA Cloud")
alertcondition(sellSignal, "Confirmed Cloud Breakout Sell", "Two consecutive candles closed below the EMA Cloud")
