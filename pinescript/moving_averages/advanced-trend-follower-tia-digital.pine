//@version=6
indicator("Advanced Trend Follower [TIA Digital]", overlay = true, max_labels_count = 500)

// --- Constants ---
string G_TREND  = "Trend Settings"
string G_CONF   = "Confluence Filters"
string G_TP     = "Take Profit Settings"
string G_VIS    = "Visualization"

color BULL_COLOR = #089981
color BEAR_COLOR = #f23645
color NEUT_COLOR = #5b9cf6

// --- Inputs ---
int fastLenInput    = input.int(20, "Fast EMA Length", minval = 1, group = G_TREND)
int slowLenInput    = input.int(50, "Slow EMA Length", minval = 1, group = G_TREND)
int adxLenInput     = input.int(14, "ADX Length", minval = 1, group = G_TREND)
int adxThreshInput  = input.int(20, "ADX Threshold", minval = 0, group = G_TREND, tooltip = "ADX value above which the trend is considered strong enough.")

bool useRsiFilter   = input.bool(true, "Use RSI Filter", group = G_CONF, tooltip = "Longs only if RSI > 50, Shorts only if RSI < 50.")
bool useVolFilter   = input.bool(false, "Use Volume Filter", group = G_CONF, tooltip = "Signals only valid if volume is above its 20-period average.")
bool useEmaFilter   = input.bool(false, "Use 200 EMA Filter", group = G_CONF, tooltip = "Longs only above 200 EMA, Shorts only below 200 EMA.")

float tp1MultInput  = input.float(1.5, "TP 1 ATR Multiplier", minval = 0.1, step = 0.1, group = G_TP)
float tp2MultInput  = input.float(3.0, "TP 2 ATR Multiplier", minval = 0.1, step = 0.1, group = G_TP)
float stopMultInput = input.float(2.0, "Stop Multiplier", minval = 0.1, step = 0.1, group = G_TP)

bool showSLInput     = input.bool(true, "Show Initial SL", group = G_VIS)
bool showTPInput     = input.bool(true, "Show Take Profit Levels", group = G_VIS)
bool showLabelsInput = input.bool(true, "Show Signal Labels", group = G_VIS)

// --- Calculations ---
// Trend Components
float fastEma = ta.ema(close, fastLenInput)
float slowEma = ta.ema(close, slowLenInput)
float ema200  = ta.ema(close, 200)
[_, _, adx]   = ta.dmi(adxLenInput, adxLenInput)

// Confluence Components
float rsi    = ta.rsi(close, 14)
float volAvg = ta.sma(volume, 20)

// Filter Logic
bool rsiLong  = not useRsiFilter or rsi > 50
bool rsiShort = not useRsiFilter or rsi < 50
bool volCond  = not useVolFilter or volume > volAvg
bool emaLong  = not useEmaFilter or close > ema200
bool emaShort = not useEmaFilter or close < ema200

// Core Trend Logic
bool trendBull = fastEma > slowEma and adx > adxThreshInput
bool trendBear = fastEma < slowEma and adx > adxThreshInput

// Combined Signal Detection
bool bullSignal = trendBull and rsiLong and volCond and emaLong and not (trendBull[1] and rsiLong[1] and volCond[1] and emaLong[1])
bool bearSignal = trendBear and rsiShort and volCond and emaShort and not (trendBear[1] and rsiShort[1] and volCond[1] and emaShort[1])

// ATR for Levels
float atr = ta.atr(14)

// Persistent variables for signals and levels
var float tp1 = na
var float tp2 = na
var float initialSL = na
var float trailingStop = na
var int trendDir = 0 

if bullSignal
    trendDir := 1
    tp1 := high + (atr * tp1MultInput)
    tp2 := high + (atr * tp2MultInput)
    initialSL := low - (atr * stopMultInput)
    trailingStop := initialSL
else if bearSignal
    trendDir := -1
    tp1 := low - (atr * tp1MultInput)
    tp2 := low - (atr * tp2MultInput)
    initialSL := high + (atr * stopMultInput)
    trailingStop := initialSL
else if trendDir == 1
    trailingStop := math.max(trailingStop, low - (atr * stopMultInput))
    if low <= trailingStop or fastEma < slowEma
        trendDir := 0
        tp1 := na, tp2 := na, initialSL := na, trailingStop := na
else if trendDir == -1
    trailingStop := math.min(trailingStop, high + (atr * stopMultInput))
    if high >= trailingStop or fastEma > slowEma
        trendDir := 0
        tp1 := na, tp2 := na, initialSL := na, trailingStop := na

// --- Visuals ---
// Trend Ribbon
pFast = plot(fastEma, "Fast EMA", color = trendBull ? BULL_COLOR : trendBear ? BEAR_COLOR : NEUT_COLOR, linewidth = 2)
pSlow = plot(slowEma, "Slow EMA", color = chart.fg_color, linewidth = 1, style = plot.style_linebr)
fill(pFast, pSlow, trendBull ? color.new(BULL_COLOR, 85) : trendBear ? color.new(BEAR_COLOR, 85) : na, "Trend Fill")

// 200 EMA Filter Line
plot(useEmaFilter ? ema200 : na, "200 EMA Filter", color = color.new(chart.fg_color, 70), style = plot.style_circles, linewidth = 1)

// Trailing Stop with Gradient
pStop  = plot(trailingStop, "Trailing Stop", color = trendDir == 1 ? BULL_COLOR : trendDir == -1 ? BEAR_COLOR : na, style = plot.style_linebr)
pPrice = plot(close, "Price Reference", color = na, display = display.none)

fill(pStop, pPrice, top_value = trendDir == 1 ? close : na, bottom_value = trendDir == 1 ? trailingStop : na, top_color = color.new(BULL_COLOR, 50), bottom_color = color.new(BULL_COLOR, 100), title = "Bullish Stop Gradient")
fill(pStop, pPrice, top_value = trendDir == -1 ? trailingStop : na, bottom_value = trendDir == -1 ? close : na, top_color = color.new(BEAR_COLOR, 100), bottom_color = color.new(BEAR_COLOR, 50), title = "Bearish Stop Gradient")

// TP/SL Levels
plot(showTPInput ? tp1 : na, "TP 1", color = trendDir == 1 ? color.new(BULL_COLOR, 30) : color.new(BEAR_COLOR, 30), style = plot.style_linebr)
plot(showTPInput ? tp2 : na, "TP 2", color = trendDir == 1 ? color.new(BULL_COLOR, 10) : color.new(BEAR_COLOR, 10), style = plot.style_linebr)
plot(showSLInput ? initialSL : na, "Initial SL", color = color.new(chart.fg_color, 50), style = plot.style_linebr)

// Signal Labels
plotshape(bullSignal and showLabelsInput, "Buy Signal", shape.triangleup, location.belowbar, BULL_COLOR, size = size.small, text = "STRONG BUY", textcolor = BULL_COLOR)
plotshape(bearSignal and showLabelsInput, "Sell Signal", shape.triangledown, location.abovebar, BEAR_COLOR, size = size.small, text = "STRONG SELL", textcolor = BEAR_COLOR)

// Status Dashboard
var table statusTable = table.new(position.top_right, 2, 2, bgcolor = color.new(chart.bg_color, 10), border_width = 1)
if barstate.islast
    table.cell(statusTable, 0, 0, "ADX (" + str.tostring(adx, "#.##") + ")", text_color = adx > adxThreshInput ? BULL_COLOR : BEAR_COLOR, text_size = size.small)
    table.cell(statusTable, 1, 0, "RSI (" + str.tostring(rsi, "#.##") + ")", text_color = rsi > 50 ? BULL_COLOR : BEAR_COLOR, text_size = size.small)
    table.cell(statusTable, 0, 1, "Vol vs Avg", text_color = volume > volAvg ? BULL_COLOR : BEAR_COLOR, text_size = size.small)
    table.cell(statusTable, 1, 1, "200 EMA", text_color = close > ema200 ? BULL_COLOR : BEAR_COLOR, text_size = size.small)
