//@version=6
indicator("Cumulative-Displacement Moving Average", overlay=true, timeframe="", timeframe_gaps=true)

// === INPUTS ===
targetVolume   = input.float(0.001, "Price Displacement")
dispMode = input.string("Wick (High-Low)", "Displacement Mode", options = ["Wick (High-Low)", "Body (Open-Close)"], tooltip = "Wick (High-Low): Measures total price expansion using the full candle range.\n\nBody (Open-Close): Measures net directional displacement using the candle body only.") 
sourceOpt      = input.string("HLC3", "CDMA Source", options=["Close","HL2","HLC3","OHLC4","High & Low"])
plotCDMA        = input.bool(true, "Plot CDMA")
minConsecutive = input.int(3, "Min Consecutive Candles for Slope Confirmation")
CDMASmoothType  = input.string("SMA", "CDMA Smoothing", options=["None","SMA","EMA","WMA","RMA"])
CDMASmoothLen   = input.int(5, "CDMA Smoothing Length")

// === ARTIFICIAL VOLUME MA ===
f_artVolumeMA(_src, _artVol) =>
    float volSum = 0.0
    float priceSum = 0.0
    int barsUsed = 0
    while (volSum < targetVolume) and barsUsed < bar_index + 1
        volSum += _artVol[barsUsed]
        priceSum += _src[barsUsed]
        barsUsed += 1
    barsUsed > 0 ? priceSum / barsUsed : na

// === CDMA CALCULATION ===
artVol = dispMode == "Wick (High-Low)" ? (high - low) : math.abs(close - open)

CDMASingle =
     sourceOpt == "Close" ? f_artVolumeMA(close, artVol) :
     sourceOpt == "HL2"   ? f_artVolumeMA(hl2, artVol) :
     sourceOpt == "HLC3"  ? f_artVolumeMA(hlc3, artVol) :
     sourceOpt == "OHLC4" ? f_artVolumeMA(ohlc4, artVol) :
     na

CDMAHigh = sourceOpt == "High & Low" ? f_artVolumeMA(high, artVol) : na
CDMALow  = sourceOpt == "High & Low" ? f_artVolumeMA(low, artVol) : na

// === SMOOTHING ===
f_smooth(_src) =>
    CDMASmoothType == "None" ? _src : CDMASmoothType == "SMA"  ? ta.sma(_src, CDMASmoothLen) : CDMASmoothType == "EMA"  ? ta.ema(_src, CDMASmoothLen) : CDMASmoothType == "WMA"  ? ta.wma(_src, CDMASmoothLen) : ta.rma(_src, CDMASmoothLen)

CDMASingleSmooth = f_smooth(CDMASingle)
CDMAHighSmooth   = f_smooth(CDMAHigh)
CDMALowSmooth    = f_smooth(CDMALow)

// === SLOPE CONFIRMED COLOR LOGIC ===
var int riseCountSingle = 0
var int fallCountSingle = 0
var color CDMAColorSingle = color.gray

CDMASlopeUpSingle   = CDMASingleSmooth > CDMASingleSmooth[1]
CDMASlopeDownSingle = CDMASingleSmooth < CDMASingleSmooth[1]

if CDMASlopeUpSingle
    riseCountSingle += 1
    fallCountSingle := 0
else if CDMASlopeDownSingle
    fallCountSingle += 1
    riseCountSingle := 0
else
    riseCountSingle := 0
    fallCountSingle := 0

bullishConfirmedSingle = riseCountSingle >= minConsecutive
bearishConfirmedSingle = fallCountSingle >= minConsecutive

CDMAColorSingle := bullishConfirmedSingle ? color.green :
                  bearishConfirmedSingle ? color.red :
                  color.gray

// Optional: High CDMA slope
var int riseCountHigh = 0
var int fallCountHigh = 0
var color CDMAColorHigh = color.gray

if not na(CDMAHighSmooth)
    CDMASlopeUpHigh   = CDMAHighSmooth > CDMAHighSmooth[1]
    CDMASlopeDownHigh = CDMAHighSmooth < CDMAHighSmooth[1]

    if CDMASlopeUpHigh
        riseCountHigh += 1
        fallCountHigh := 0
    else if CDMASlopeDownHigh
        fallCountHigh += 1
        riseCountHigh := 0
    else
        riseCountHigh := 0
        fallCountHigh := 0

    bullishConfirmedHigh = riseCountHigh >= minConsecutive
    bearishConfirmedHigh = fallCountHigh >= minConsecutive

    CDMAColorHigh := bullishConfirmedHigh ? color.green : bearishConfirmedHigh ? color.red :color.gray
else
    CDMAColorHigh := color.gray

// Optional: Low CDMA slope
var int riseCountLow = 0
var int fallCountLow = 0
var color CDMAColorLow = color.gray

if not na(CDMALowSmooth)
    CDMASlopeUpLow   = CDMALowSmooth > CDMALowSmooth[1]
    CDMASlopeDownLow = CDMALowSmooth < CDMALowSmooth[1]

    if CDMASlopeUpLow
        riseCountLow += 1
        fallCountLow := 0
    else if CDMASlopeDownLow
        fallCountLow += 1
        riseCountLow := 0
    else
        riseCountLow := 0
        fallCountLow := 0

    bullishConfirmedLow = riseCountLow >= minConsecutive
    bearishConfirmedLow = fallCountLow >= minConsecutive

    CDMAColorLow := bullishConfirmedLow ? color.green :
                   bearishConfirmedLow ? color.red :
                   color.gray
else
    CDMAColorLow := color.gray

// === PLOTS ===
plot(plotCDMA ? CDMASingleSmooth : na, "CDMA HTF", linewidth=2, color=CDMAColorSingle)
plot(plotCDMA ? CDMAHighSmooth   : na, "CDMA HTF High", linewidth=2, color=CDMAColorHigh)
plot(plotCDMA ? CDMALowSmooth    : na, "CDMA HTF Low", linewidth=2, color=CDMAColorLow)
