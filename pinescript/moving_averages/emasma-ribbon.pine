//@version=6
indicator("EMA/SMA Ribbon + Extra MAs", overlay=true)

//==================================================================================================
// MAIN RIBBON (UNCHANGED)
//==================================================================================================
// Settings
src       = ohlc4
emaLen    = 15
smaLen    = 22
emaOffset = 0
smaOffset = 6

// MAs
ema15 = ta.ema(src, emaLen)
sma22 = ta.sma(src, smaLen)

// Visual-aligned SMA (because SMA plot is shifted right by 6)
smaVis = sma22[smaOffset]

// Plots
pEma = plot(ema15, title="EMA 15 (ohlc4)", offset=emaOffset, linewidth=2)
pSma = plot(sma22, title="SMA 22 (ohlc4, offset 6)", offset=smaOffset, linewidth=2)

// Ribbon color based on what you SEE
ribbonCol = na(smaVis) ? na : (ema15 > smaVis ? color.new(color.lime, 80) : color.new(color.red, 80))
fill(pEma, pSma, title="Ribbon", color=ribbonCol)


//==================================================================================================
// EXTRA MOVING AVERAGES (SEPARATE FROM RIBBON)
// - Changeable lengths
// - Changeable colors
// - Changeable line styles (solid / dotted / dashed)
// - Changeable thickness
//==================================================================================================
groupExtra = "Extra Moving Averages"

// Helper: map style string -> plot style
f_plotStyle(_s) =>
    switch _s
        "Solid"  => plot.style_line
        "Dotted" => plot.style_circles
        "Dashed" => plot.style_line
        => plot.style_line

// Helper: dashed effect (TradingView doesn't support true dashed plots for plot().
// We approximate dashed by plotting only every N bars.
f_dashMask(_enabled, _step) =>
    _enabled ? (bar_index % _step == 0) : true

// --- EMA 9
ema9_len   = input.int(9,  "EMA 9 Length",  minval=1, group=groupExtra)
ema9_col   = input.color(color.orange, "EMA 9 Color", group=groupExtra)
ema9_w     = input.int(1,  "EMA 9 Thickness", minval=1, maxval=5, group=groupExtra)
ema9_style = input.string("Solid", "EMA 9 Line Style", options=["Solid","Dotted","Dashed"], group=groupExtra)
ema9_dashN = input.int(3, "EMA 9 Dash Step (if Dashed)", minval=2, maxval=20, group=groupExtra)

ema9 = ta.ema(src, ema9_len)
ema9_plotVal = ema9_style == "Dashed" ? (f_dashMask(true, ema9_dashN) ? ema9 : na) : ema9
plot(ema9_plotVal, title="EMA 9", linewidth=ema9_w, color=ema9_col, style=f_plotStyle(ema9_style))

// --- EMA 20
ema20_len   = input.int(20, "EMA 20 Length", minval=1, group=groupExtra)
ema20_col   = input.color(color.yellow, "EMA 20 Color", group=groupExtra)
ema20_w     = input.int(1, "EMA 20 Thickness", minval=1, maxval=5, group=groupExtra)
ema20_style = input.string("Solid", "EMA 20 Line Style", options=["Solid","Dotted","Dashed"], group=groupExtra)
ema20_dashN = input.int(3, "EMA 20 Dash Step (if Dashed)", minval=2, maxval=20, group=groupExtra)

ema20 = ta.ema(src, ema20_len)
ema20_plotVal = ema20_style == "Dashed" ? (f_dashMask(true, ema20_dashN) ? ema20 : na) : ema20
plot(ema20_plotVal, title="EMA 20", linewidth=ema20_w, color=ema20_col, style=f_plotStyle(ema20_style))

// --- EMA 50
ema50_len   = input.int(50, "EMA 50 Length", minval=1, group=groupExtra)
ema50_col   = input.color(color.green, "EMA 50 Color", group=groupExtra)
ema50_w     = input.int(1, "EMA 50 Thickness", minval=1, maxval=5, group=groupExtra)
ema50_style = input.string("Solid", "EMA 50 Line Style", options=["Solid","Dotted","Dashed"], group=groupExtra)
ema50_dashN = input.int(3, "EMA 50 Dash Step (if Dashed)", minval=2, maxval=20, group=groupExtra)

ema50 = ta.ema(src, ema50_len)
ema50_plotVal = ema50_style == "Dashed" ? (f_dashMask(true, ema50_dashN) ? ema50 : na) : ema50
plot(ema50_plotVal, title="EMA 50", linewidth=ema50_w, color=ema50_col, style=f_plotStyle(ema50_style))


// --- SMA 100
sma100_len   = input.int(100, "SMA 100 Length", minval=1, group=groupExtra)
sma100_col   = input.color(color.purple, "SMA 100 Color", group=groupExtra)
sma100_w     = input.int(1, "SMA 100 Thickness", minval=1, maxval=5, group=groupExtra)
sma100_style = input.string("Dashed", "SMA 100 Line Style", options=["Solid","Dotted","Dashed"], group=groupExtra)
sma100_dashN = input.int(3, "SMA 100 Dash Step (if Dashed)", minval=2, maxval=20, group=groupExtra)

sma100 = ta.sma(src, sma100_len)
sma100_plotVal = sma100_style == "Dashed" ? (f_dashMask(true, sma100_dashN) ? sma100 : na) : sma100
plot(sma100_plotVal, title="SMA 100", linewidth=sma100_w, color=sma100_col, style=f_plotStyle(sma100_style))

// --- SMA 150
sma150_len   = input.int(150, "SMA 150 Length", minval=1, group=groupExtra)
sma150_col   = input.color(color.blue, "SMA 150 Color", group=groupExtra)
sma150_w     = input.int(1, "SMA 150 Thickness", minval=1, maxval=5, group=groupExtra)
sma150_style = input.string("Dashed", "SMA 150 Line Style", options=["Solid","Dotted","Dashed"], group=groupExtra)
sma150_dashN = input.int(3, "SMA 150 Dash Step (if Dashed)", minval=2, maxval=20, group=groupExtra)

sma150 = ta.sma(src, sma150_len)
sma150_plotVal = sma150_style == "Dashed" ? (f_dashMask(true, sma150_dashN) ? sma150 : na) : sma150
plot(sma150_plotVal, title="SMA 150", linewidth=sma150_w, color=sma150_col, style=f_plotStyle(sma150_style))

// --- SMA 200
sma200_len   = input.int(200, "SMA 200 Length", minval=1, group=groupExtra)
sma200_col   = input.color(color.red, "SMA 200 Color", group=groupExtra)
sma200_w     = input.int(2, "SMA 200 Thickness", minval=1, maxval=5, group=groupExtra)  // default normal line
sma200_style = input.string("Dashed", "SMA 200 Line Style", options=["Solid","Dotted","Dashed"], group=groupExtra)
sma200_dashN = input.int(3, "SMA 200 Dash Step (if Dashed)", minval=2, maxval=20, group=groupExtra)

sma200 = ta.sma(src, sma200_len)
sma200_plotVal = sma200_style == "Dashed" ? (f_dashMask(true, sma200_dashN) ? sma200 : na) : sma200
plot(sma200_plotVal, title="SMA 200", linewidth=sma200_w, color=sma200_col, style=f_plotStyle(sma200_style))
