//@version=6
indicator('Trend Structure', overlay=true)

// ==========================================
// Inputs
// ==========================================
sourcePrice = input.source(defval=close, title='Source')
timeframeInput = input.timeframe(defval='', title='Timeframe')
maLength = input.int(defval=20, title='Length', minval=1)
maMode = input.string(defval='EMA', title='MA Type', options=['SMA', 'EMA', 'WMA', 'HMA', 'VWMA', 'RMA', 'TEMA'])
lineThickness = input.int(defval=4, title='Line Width', minval=1, maxval=6)
upTrendColor = input.color(defval=color.new(color.rgb(64, 217, 143), 50), title='Up Color')
downTrendColor = input.color(defval=color.new(color.rgb(246, 113, 113), 50), title='Down Color')

// ==========================================
// Helpers
// ==========================================
temaValue(priceSeries, lengthValue) =>
    emaFast = ta.ema(priceSeries, lengthValue)
    emaMid = ta.ema(emaFast, lengthValue)
    emaSlow = ta.ema(emaMid, lengthValue)
    3.0 * (emaFast - emaMid) + emaSlow

maValueByMode(priceSeries, lengthValue, modeValue) =>
    switch modeValue
        'SMA' => ta.sma(priceSeries, lengthValue)
        'EMA' => ta.ema(priceSeries, lengthValue)
        'WMA' => ta.wma(priceSeries, lengthValue)
        'HMA' => ta.hma(priceSeries, lengthValue)
        'VWMA' => ta.vwma(priceSeries, lengthValue)
        'RMA' => ta.rma(priceSeries, lengthValue)
        => temaValue(priceSeries, lengthValue)

selectedTimeframe = timeframeInput == '' ? timeframe.period : timeframeInput
mtfTrendLine = request.security(syminfo.tickerid, selectedTimeframe, maValueByMode(sourcePrice, maLength, maMode))

isUpTrend = mtfTrendLine >= mtfTrendLine[1]
trendLineColor = isUpTrend ? upTrendColor : downTrendColor

// ==========================================
// Plot
// ==========================================
plot(mtfTrendLine, title='Trend Line', color=trendLineColor, linewidth=lineThickness, style=plot.style_circles)
