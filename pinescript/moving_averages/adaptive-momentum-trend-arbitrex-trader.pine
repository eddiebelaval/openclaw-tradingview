//@version=6
indicator("Adaptive Momentum Trend [Arbitrex Trader]", overlay = true)

// ===== INPUTS =====
atrLength = input.int(14, "ATR Length")
emaLength = input.int(50, "EMA Length")
rsiLength = input.int(14, "RSI Length")
atrMult   = input.float(2, "ATR Multiplier")

// ===== CORE CALCULATIONS =====
atrValue = ta.atr(atrLength)
emaValue = ta.ema(close, emaLength)
rsiValue = ta.rsi(close, rsiLength)

// ===== DYNAMIC BANDS =====
upperLevel = emaValue + atrValue * atrMult
lowerLevel = emaValue - atrValue * atrMult

// ===== TREND LOGIC =====
bullTrend = close > upperLevel and rsiValue > 55
bearTrend = close < lowerLevel and rsiValue < 45

// Persistent trend state
var int trend = 0
if bullTrend
    trend := 1
else if bearTrend
    trend := -1

// Signal only on trend change
buySignal  = trend == 1  and trend[1] != 1
sellSignal = trend == -1 and trend[1] != -1

// ===== PLOTS =====
emaPlot   = plot(emaValue, "Trend EMA", color=color.orange, linewidth=2)
upperPlot = plot(upperLevel, "Upper Level", color=color.new(color.green, 0))
lowerPlot = plot(lowerLevel, "Lower Level", color=color.new(color.red, 0))

// ===== FILL BASED ON TREND =====
fillColor = trend == 1 ? color.new(color.green, 85) :
           trend == -1 ? color.new(color.red, 85) :
           color.new(color.gray, 90)

fill(upperPlot, lowerPlot, color=fillColor)

// ===== SIGNALS =====
plotshape(buySignal, title="BUY", location=location.belowbar,
     style=shape.labelup, text="BUY",
     color=color.green, textcolor=color.white, size=size.small)

plotshape(sellSignal, title="SELL", location=location.abovebar,
     style=shape.labeldown, text="SELL",
     color=color.red, textcolor=color.white, size=size.small)

// ===== ALERTS =====
alertcondition(buySignal, title="BUY Alert", message="AMST PRO BUY Signal")
alertcondition(sellSignal, title="SELL Alert", message="AMST PRO SELL Signal")
