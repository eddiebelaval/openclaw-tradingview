//@version=5
indicator("VWAP Lights (2x GX VWAP + TRUE HOD/LOD anchors)", overlay=true, max_lines_count=500)

//──────────────────────────────────────────────────────────────────────────────
// Inputs
//──────────────────────────────────────────────────────────────────────────────
groupSess = "Sessions (Mountain Time)"
tz      = input.string("America/Denver", "Timezone", group=groupSess)
sessRTH = input.session("0730-1400", "RTH Session (MT)", group=groupSess)

groupOpt = "Options"
srcChoice = input.string("HLC3", "VWAP Source (GX + RTH)", options=["HLC3","Close"], group=groupOpt)
showGX    = input.bool(true, "Plot Globex VWAP (Current + Previous)", group=groupOpt)
showRTH   = input.bool(true, "Plot RTH VWAP (RTH only)", group=groupOpt)
showAnch  = input.bool(true, "Show HOD/LOD anchored VWAP (erase old anchor)", group=groupOpt)

groupPerf = "Performance"
maxSegs = input.int(400, "Max segments per anchored VWAP (limit)", minval=50, maxval=500, group=groupPerf)

groupTbl = "Table"
tblPos = input.string("Top Right", "Position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=groupTbl)
useChartTickerLabel = input.bool(true, "Use chart ticker label", group=groupTbl)
customTickerLabel   = input.string("MNQ", "Custom ticker label (if disabled)", group=groupTbl)

// Position
pos = switch tblPos
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    => position.top_right

//──────────────────────────────────────────────────────────────────────────────
// Table (narrow): Label + LED
//──────────────────────────────────────────────────────────────────────────────
var table t = table.new(pos, 2, 5, border_width=1)

//──────────────────────────────────────────────────────────────────────────────
// Helpers
//──────────────────────────────────────────────────────────────────────────────
f_inSession(_sess) =>
    not na(time(timeframe.period, _sess, tz))

f_led(_row, _price, _lvl) =>
    isNA = na(_lvl) or na(_price)
    up   = not isNA and _price > _lvl
    bg   = isNA ? color.new(color.gray, 85) : (up ? color.new(color.green, 0) : color.new(color.red, 0))
    table.cell(t, 1, _row, "●", text_color=color.white, bgcolor=bg, text_size=size.tiny)

srcStd = srcChoice == "Close" ? close : hlc3

f_clearLines(line[] arr) =>
    sz = array.size(arr)
    if sz > 0
        for i = 0 to sz - 1
            ln = array.get(arr, i)
            if not na(ln)
                line.delete(ln)
        array.clear(arr)

f_capSegments(line[] arr, int cap) =>
    while array.size(arr) > cap
        old = array.shift(arr)
        if not na(old)
            line.delete(old)

//──────────────────────────────────────────────────────────────────────────────
// Globex session key (GX day starts at 16:00 MT)
// Key is YYYYMMDD of the session START date (16:00 MT).
// If bar time is before 16:00 MT, it belongs to the previous GX day.
//──────────────────────────────────────────────────────────────────────────────
f_gxKey(_t) =>
    h = hour(_t, tz)
    m = minute(_t, tz)
    mins = h * 60 + m
    tKey = mins < 16 * 60 ? (_t - 24 * 60 * 60 * 1000) : _t
    year(tKey, tz) * 10000 + month(tKey, tz) * 100 + dayofmonth(tKey, tz)

// Per-bar key
gxKey = f_gxKey(time)

// Fixed reference keys
gxKeyNow  = f_gxKey(timenow)
gxKeyPrev = f_gxKey(timenow - 24 * 60 * 60 * 1000)

//──────────────────────────────────────────────────────────────────────────────
// Globex VWAP series (resets when gxKey changes)
//──────────────────────────────────────────────────────────────────────────────
newGX = gxKey != gxKey[1]

var float gx_cumPV = na
var float gx_cumV  = na

if newGX or na(gx_cumV)
    gx_cumPV := srcStd * volume
    gx_cumV  := volume
else
    gx_cumPV += srcStd * volume
    gx_cumV  += volume

gxSeries = gx_cumV != 0 ? (gx_cumPV / gx_cumV) : na

// Two separate plots
gxCurr = (showGX and gxKey == gxKeyNow)  ? gxSeries : na
gxPrev = (showGX and gxKey == gxKeyPrev) ? gxSeries : na

plot(gxCurr, title="Globex VWAP (Current GX session)", linewidth=2)
plot(gxPrev, title="Globex VWAP (Previous GX session)", linewidth=2)

//──────────────────────────────────────────────────────────────────────────────
// RTH VWAP (only during RTH)
//──────────────────────────────────────────────────────────────────────────────
f_rthVWAP(_src) =>
    inR = f_inSession(sessRTH)
    rStart = inR and not inR[1]

    var float cumPV = na
    var float cumV  = na

    if rStart
        cumPV := _src * volume
        cumV  := volume
    else if inR
        cumPV += _src * volume
        cumV  += volume

    (inR and cumV != 0) ? (cumPV / cumV) : na

inRTH  = f_inSession(sessRTH)
rStart = inRTH and not inRTH[1]
rth    = f_rthVWAP(srcStd)

plot(showRTH ? (inRTH ? rth : na) : na, title="RTH VWAP (RTH only)", linewidth=2, style=plot.style_linebr)

//──────────────────────────────────────────────────────────────────────────────
// TRUE anchored HOD/LOD VWAPs (segment chains)
// - HOD uses HIGH, LOD uses LOW
// - erase old anchor segments on new extreme
// - only during RTH
//──────────────────────────────────────────────────────────────────────────────
hodCol = color.new(color.orange, 0)
lodCol = color.new(color.aqua,   0)
lnW    = 2

var line[] hodSegs = array.new_line()
var line[] lodSegs = array.new_line()

var float hod = na
var float hod_cumPV = na
var float hod_cumV  = na
var float hodPrevVWAP = na

var float lod = na
var float lod_cumPV = na
var float lod_cumV  = na
var float lodPrevVWAP = na

newHOD = false
newLOD = false

if rStart
    hod := high
    hod_cumPV := high * volume
    hod_cumV  := volume
    hodPrevVWAP := na
    newHOD := true

    lod := low
    lod_cumPV := low * volume
    lod_cumV  := volume
    lodPrevVWAP := na
    newLOD := true

else if inRTH
    if na(hod) or high > hod
        hod := high
        hod_cumPV := high * volume
        hod_cumV  := volume
        hodPrevVWAP := na
        newHOD := true
    else
        hod_cumPV += high * volume
        hod_cumV  += volume
        newHOD := false

    if na(lod) or low < lod
        lod := low
        lod_cumPV := low * volume
        lod_cumV  := volume
        lodPrevVWAP := na
        newLOD := true
    else
        lod_cumPV += low * volume
        lod_cumV  += volume
        newLOD := false
else
    newHOD := false
    newLOD := false

hodVWAP = (inRTH and hod_cumV != 0) ? (hod_cumPV / hod_cumV) : na
lodVWAP = (inRTH and lod_cumV != 0) ? (lod_cumPV / lod_cumV) : na

if showAnch and inRTH and newHOD
    f_clearLines(hodSegs)
if showAnch and inRTH and newLOD
    f_clearLines(lodSegs)

if showAnch and inRTH
    if not na(hodVWAP)
        if na(hodPrevVWAP)
            hodPrevVWAP := hodVWAP
        else
            array.push(hodSegs, line.new(bar_index - 1, hodPrevVWAP, bar_index, hodVWAP, width=lnW, color=hodCol))
            hodPrevVWAP := hodVWAP
            f_capSegments(hodSegs, maxSegs)

    if not na(lodVWAP)
        if na(lodPrevVWAP)
            lodPrevVWAP := lodVWAP
        else
            array.push(lodSegs, line.new(bar_index - 1, lodPrevVWAP, bar_index, lodVWAP, width=lnW, color=lodCol))
            lodPrevVWAP := lodVWAP
            f_capSegments(lodSegs, maxSegs)

if (not inRTH) and inRTH[1]
    f_clearLines(hodSegs)
    f_clearLines(lodSegs)
    hodPrevVWAP := na
    lodPrevVWAP := na

//──────────────────────────────────────────────────────────────────────────────
// LED table (ticker label follows chart if enabled)
//──────────────────────────────────────────────────────────────────────────────
tickerLabel = useChartTickerLabel ? syminfo.ticker : customTickerLabel

if barstate.islast
    table.cell(t, 0, 0, "GX",  text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 1, "RTH", text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 2, "HOD", text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 3, "LOD", text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 4, tickerLabel, text_color=color.white, text_size=size.tiny)

    f_led(0, close, gxSeries)
    f_led(1, close, rth)
    f_led(2, close, hodVWAP)
    f_led(3, close, lodVWAP)
    f_led(4, close, rth)
