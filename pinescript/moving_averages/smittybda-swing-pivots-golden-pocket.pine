// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("Swing Pivots & Golden Pocket", "Swing & GP", overlay = true, max_boxes_count = 100, max_labels_count = 500, max_lines_count = 500)

// --- Inputs ---
int leftBarsInput  = input.int(3, "Swing Left Bars", minval = 1, tooltip = "Number of bars to the left of the pivot")
int rightBarsInput = input.int(3, "Swing Right Bars", minval = 1, tooltip = "Number of bars to the right of the pivot")

color bullColorInput = input.color(#089981, "Bullish Color", group = "Style")
color bearColorInput = input.color(#f23645, "Bearish Color", group = "Style")
color gpColorInput   = input.color(#ffff00, "GP Zone (Bright Yellow)", group = "Style")
color gpExtColorInput = input.color(#ffff8d, "GP Extensions (Light Yellow)", group = "Style")
int transparencyInput = input.int(70, "Box Transparency", minval = 0, maxval = 100, group = "Style")

// EMA Input
int emaLengthInput = input.int(9, "EMA Length", minval = 1, group = "Momentum")
color emaColorInput = input.color(#5b9cf6, "EMA Color", group = "Momentum")

// --- Logic ---
float ph = ta.pivothigh(high, leftBarsInput, rightBarsInput)
float pl = ta.pivotlow(low, leftBarsInput, rightBarsInput)
float ema9 = ta.ema(close, emaLengthInput)

// Persistent variables to store pivot data
var float lastHighPrice = na
var float lastLowPrice  = na

// Persistent variables for the most recent objects
var box bullPocket = na
var box bearPocket = na

// Arrays to manage lines and labels
var line[] bullLines = array.new_line()
var label[] bullLabels = array.new_label()
var line[] bearLines = array.new_line()
var label[] bearLabels = array.new_label()

// Helper to clear objects
clearObjects(line[] linesArray, label[] labelsArray) =>
    if array.size(linesArray) > 0
        for i = 0 to array.size(linesArray) - 1
            line.delete(array.get(linesArray, i))
        array.clear(linesArray)
    if array.size(labelsArray) > 0
        for i = 0 to array.size(labelsArray) - 1
            label.delete(array.get(labelsArray, i))
        array.clear(labelsArray)

// Helper to create line and label pair
addLineLabel(line[] lArr, label[] lbArr, int startBar, float price, string txt, color col, string style = line.style_solid) =>
    array.push(lArr, line.new(startBar, price, bar_index, price, color = color.new(col, 30), style = style, width = 2, extend = extend.right))
    array.push(lbArr, label.new(bar_index, price, txt + ": " + str.tostring(price, format.mintick), color = #00000000, textcolor = col, style = label.style_label_left, size = size.small))

// --- Visualization & Golden Pocket Calculation ---
// Confirm Swing High
if not na(ph)
    lastHighPrice := ph
    int highBar   = bar_index - rightBarsInput
    label.new(highBar, ph, "SH", color = #00000000, textcolor = bearColorInput, style = label.style_label_down, size = size.small)

    if not na(lastLowPrice)
        float diff = ph - lastLowPrice
        float bullTop = ph - (diff * 0.618)
        float bullBottom = ph - (diff * 0.650)
        
        box.delete(bullPocket)
        bullPocket := box.new(highBar, bullTop, bar_index, bullBottom, border_color = color.new(gpColorInput, 10), bgcolor = color.new(gpColorInput, transparencyInput), extend = extend.right)

        clearObjects(bullLines, bullLabels)
        // GP Retracements (Dotted edges of the box)
        addLineLabel(bullLines, bullLabels, highBar, bullTop, "0.618", gpColorInput, line.style_dotted)
        addLineLabel(bullLines, bullLabels, highBar, bullBottom, "0.650", gpColorInput, line.style_dotted)
        // 0.5 Solid
        addLineLabel(bullLines, bullLabels, highBar, ph - (diff * 0.5), "0.5", bullColorInput, line.style_solid)
        
        // Extensions
        float[] extLv = array.from(0.14, 0.236, 0.389, 0.618, 0.650)
        for lv in extLv
            color currentLineColor = (lv == 0.618 or lv == 0.650) ? gpExtColorInput : bullColorInput
            // Upper Extensions (1.xx)
            addLineLabel(bullLines, bullLabels, highBar, ph + (diff * lv), "1." + str.tostring(lv * 1000, "###"), currentLineColor, line.style_dashed)
            // Lower Extensions (-0.xx)
            addLineLabel(bullLines, bullLabels, highBar, lastLowPrice - (diff * lv), "-0." + str.tostring(lv * 1000, "###"), currentLineColor, line.style_dashed)

// Confirm Swing Low
if not na(pl)
    lastLowPrice := pl
    int lowBar   = bar_index - rightBarsInput
    label.new(lowBar, pl, "SL", color = #00000000, textcolor = bullColorInput, style = label.style_label_up, size = size.small)

    if not na(lastHighPrice)
        float diff = lastHighPrice - pl
        float bearBottom = pl + (diff * 0.618)
        float bearTop = pl + (diff * 0.650)
        
        box.delete(bearPocket)
        bearPocket := box.new(lowBar, bearBottom, bar_index, bearTop, border_color = color.new(gpColorInput, 10), bgcolor = color.new(gpColorInput, transparencyInput), extend = extend.right)

        clearObjects(bearLines, bearLabels)
        // GP Retracements (Dotted edges of the box)
        addLineLabel(bearLines, bearLabels, lowBar, bearBottom, "0.618", gpColorInput, line.style_dotted)
        addLineLabel(bearLines, bearLabels, lowBar, bearTop, "0.650", gpColorInput, line.style_dotted)
        // 0.5 Solid
        addLineLabel(bearLines, bearLabels, lowBar, pl + (diff * 0.5), "0.5", bearColorInput, line.style_solid)
        
        // Extensions
        float[] extLv = array.from(0.14, 0.236, 0.389, 0.618, 0.650)
        for lv in extLv
            color currentLineColor = (lv == 0.618 or lv == 0.650) ? gpExtColorInput : bearColorInput
            // Lower Extensions (1.xx)
            addLineLabel(bearLines, bearLabels, lowBar, pl - (diff * lv), "1." + str.tostring(lv * 1000, "###"), currentLineColor, line.style_dashed)
            // Upper Extensions (-0.xx)
            addLineLabel(bearLines, bearLabels, lowBar, lastHighPrice + (diff * lv), "-0." + str.tostring(lv * 1000, "###"), currentLineColor, line.style_dashed)

// --- Visuals ---
plot(ema9, "9 EMA", color = emaColorInput, linewidth = 2)
plotshape(ph, "Swing High Marker", shape.triangledown, location.abovebar, bearColorInput, offset = -rightBarsInput, size = size.tiny)
plotshape(pl, "Swing Low Marker", shape.triangleup, location.belowbar, bullColorInput, offset = -rightBarsInput, size = size.tiny)
