//@version=5
indicator("Undercut EMA Screener", overlay = true)

// Define EMA (e.g., 10-period)
emaLength = input.int(10, "EMA Length")
ema10 = ta.ema(close, emaLength)

// Undercut condition: Low dips below EMA, but close reclaims it (with optional volume filter)
undercut = (low < ema10) and (close > ema10) and (close > open)  // Green candle reclaim
volumeSurge = volume > ta.sma(volume, 20) * input.float(1.5, "Volume Multiplier")

// Combine for stronger signal
signal = undercut and volumeSurge ? 1 : 0

// Output for screener (must have plot or alertcondition)
plot(signal, "Undercut Signal", color = color.green, display = display.none)  // Hidden plot for filtering
alertcondition(signal == 1, title = "Undercut Detected", message = "Potential undercut and rally setup")
