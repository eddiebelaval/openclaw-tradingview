//@version=5
indicator("Guga Azevedo 10(EMAs + SMAs)", overlay=true, max_labels_count=500)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Inputs gerais
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
mode          = input.string("Linhas", "Modo", options=["Linhas", "Ribbon"])
showLabels    = input.bool(true, "Mostrar nomes no gráfico (labels)")
labelsXOffset = input.int(2, "Labels: deslocamento X (barras)", minval=0, maxval=50)
minGapTicks   = input.int(40, "Labels: distância mínima (ticks)", minval=1, maxval=500)
showTable     = input.bool(false, "Mostrar tabela lateral (evita labels no preço)")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Inputs de cada média (período + visibilidade + cor)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
grpEMA = "EMAs"
showE9   = input.bool(true,  "Exibir EMA 9",   group=grpEMA)
lenE9    = input.int(9,      "Período EMA 9",  group=grpEMA, minval=1)
colE9    = input.color(color.yellow, "Cor EMA 9", group=grpEMA)

showE20  = input.bool(true,  "Exibir EMA 20",  group=grpEMA)
lenE20   = input.int(20,     "Período EMA 20", group=grpEMA, minval=1)
colE20   = input.color(color.orange, "Cor EMA 20", group=grpEMA)

showE21  = input.bool(true,  "Exibir EMA 21",  group=grpEMA)
lenE21   = input.int(21,     "Período EMA 21", group=grpEMA, minval=1)
colE21   = input.color(color.teal, "Cor EMA 21", group=grpEMA)

showE34  = input.bool(true,  "Exibir EMA 34",  group=grpEMA)
lenE34   = input.int(34,     "Período EMA 34", group=grpEMA, minval=1)
colE34   = input.color(color.blue, "Cor EMA 34", group=grpEMA)

showE50  = input.bool(true,  "Exibir EMA 50",  group=grpEMA)
lenE50   = input.int(50,     "Período EMA 50", group=grpEMA, minval=1)
colE50   = input.color(color.purple, "Cor EMA 50", group=grpEMA)

showE100 = input.bool(true,  "Exibir EMA 100", group=grpEMA)
lenE100  = input.int(100,    "Período EMA 100", group=grpEMA, minval=1)
colE100  = input.color(color.red, "Cor EMA 100", group=grpEMA)

// ✅ ALTERADO: EMA 200 agora vem com cor visível (fuchsia por padrão)
showE200 = input.bool(true,  "Exibir EMA 200", group=grpEMA)
lenE200  = input.int(200,    "Período EMA 200", group=grpEMA, minval=1)
colE200  = input.color(color.fuchsia, "Cor EMA 200", group=grpEMA)

grpSMA = "SMAs"
showS50  = input.bool(true,  "Exibir SMA 50",  group=grpSMA)
lenS50   = input.int(50,     "Período SMA 50", group=grpSMA, minval=1)
colS50   = input.color(color.lime, "Cor SMA 50", group=grpSMA)

showS100 = input.bool(true,  "Exibir SMA 100", group=grpSMA)
lenS100  = input.int(100,    "Período SMA 100", group=grpSMA, minval=1)
colS100  = input.color(color.aqua, "Cor SMA 100", group=grpSMA)

showS200 = input.bool(true,  "Exibir SMA 200", group=grpSMA)
lenS200  = input.int(200,    "Período SMA 200", group=grpSMA, minval=1)
colS200  = input.color(color.gray, "Cor SMA 200", group=grpSMA)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Cálculo das médias
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ema9   = ta.ema(close, lenE9)
ema20  = ta.ema(close, lenE20)
ema21  = ta.ema(close, lenE21)
ema34  = ta.ema(close, lenE34)
ema50  = ta.ema(close, lenE50)
ema100 = ta.ema(close, lenE100)
ema200 = ta.ema(close, lenE200)

sma50  = ta.sma(close, lenS50)
sma100 = ta.sma(close, lenS100)
sma200 = ta.sma(close, lenS200)

isLines  = mode == "Linhas"
isRibbon = mode == "Ribbon"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Plots (Linhas) — com cores
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
plot(isLines and showE9   ? ema9   : na, title="EMA 9",   linewidth=2, color=colE9)
plot(isLines and showE20  ? ema20  : na, title="EMA 20",  linewidth=2, color=colE20)
plot(isLines and showE21  ? ema21  : na, title="EMA 21",  linewidth=2, color=colE21)
plot(isLines and showE34  ? ema34  : na, title="EMA 34",  linewidth=2, color=colE34)
plot(isLines and showE50  ? ema50  : na, title="EMA 50",  linewidth=2, color=colE50)
plot(isLines and showE100 ? ema100 : na, title="EMA 100", linewidth=2, color=colE100)
plot(isLines and showE200 ? ema200 : na, title="EMA 200", linewidth=2, color=colE200)

plot(isLines and showS50  ? sma50  : na, title="SMA 50",  linewidth=2, color=colS50)
plot(isLines and showS100 ? sma100 : na, title="SMA 100", linewidth=2, color=colS100)
plot(isLines and showS200 ? sma200 : na, title="SMA 200", linewidth=2, color=colS200)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Ribbon (plots transparentes + fill) — só EMAs
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
rE9   = plot(isRibbon and showE9   ? ema9   : na, title="rEMA 9",   linewidth=1, color=color.new(colE9, 100))
rE20  = plot(isRibbon and showE20  ? ema20  : na, title="rEMA 20",  linewidth=1, color=color.new(colE20, 100))
rE21  = plot(isRibbon and showE21  ? ema21  : na, title="rEMA 21",  linewidth=1, color=color.new(colE21, 100))
rE34  = plot(isRibbon and showE34  ? ema34  : na, title="rEMA 34",  linewidth=1, color=color.new(colE34, 100))
rE50  = plot(isRibbon and showE50  ? ema50  : na, title="rEMA 50",  linewidth=1, color=color.new(colE50, 100))
rE100 = plot(isRibbon and showE100 ? ema100 : na, title="rEMA 100", linewidth=1, color=color.new(colE100, 100))
rE200 = plot(isRibbon and showE200 ? ema200 : na, title="rEMA 200", linewidth=1, color=color.new(colE200, 100))

fill(rE9,   rE20,  title="Ribbon 9-20",    color=color.new(colE9,   85))
fill(rE20,  rE21,  title="Ribbon 20-21",   color=color.new(colE20,  85))
fill(rE21,  rE34,  title="Ribbon 21-34",   color=color.new(colE21,  85))
fill(rE34,  rE50,  title="Ribbon 34-50",   color=color.new(colE34,  85))
fill(rE50,  rE100, title="Ribbon 50-100",  color=color.new(colE50,  85))
fill(rE100, rE200, title="Ribbon 100-200", color=color.new(colE100, 85))

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Labels anti-overlap (robusto) + tabela opcional
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var label[] labs = array.new_label()
var table tb = table.new(position.top_right, 2, 11, border_width=1)

f_clear_labels() =>
    int n = array.size(labs)
    if n > 0
        for i = 0 to n - 1
            label.delete(array.get(labs, i))
        array.clear(labs)

f_push(_show, _val, _txt, _col, float[] vals, string[] txts, color[] cols) =>
    if _show and not na(_val)
        array.push(vals, _val)
        array.push(txts, _txt)
        array.push(cols, _col)

f_sort_desc(float[] vals, string[] txts, color[] cols) =>
    int n = array.size(vals)
    if n >= 2
        for i = 0 to n - 2
            for j = 0 to n - 2 - i
                if array.get(vals, j) < array.get(vals, j + 1)
                    v0 = array.get(vals, j)
                    v1 = array.get(vals, j + 1)
                    t0 = array.get(txts, j)
                    t1 = array.get(txts, j + 1)
                    c0 = array.get(cols, j)
                    c1 = array.get(cols, j + 1)
                    array.set(vals, j, v1)
                    array.set(vals, j + 1, v0)
                    array.set(txts, j, t1)
                    array.set(txts, j + 1, t0)
                    array.set(cols, j, c1)
                    array.set(cols, j + 1, c0)

if barstate.islast
    if showTable
        f_clear_labels()
        table.clear(tb, 0, 0)

        table.cell(tb, 0, 0, "MA", text_color=color.white, bgcolor=color.new(color.black, 0))
        table.cell(tb, 1, 0, "Valor", text_color=color.white, bgcolor=color.new(color.black, 0))

        row = 1
        if showE9
            table.cell(tb, 0, row, "EMA " + str.tostring(lenE9), text_color=colE9)
            table.cell(tb, 1, row, str.tostring(ema9, format.mintick))
            row += 1
        if showE20
            table.cell(tb, 0, row, "EMA " + str.tostring(lenE20), text_color=colE20)
            table.cell(tb, 1, row, str.tostring(ema20, format.mintick))
            row += 1
        if showE21
            table.cell(tb, 0, row, "EMA " + str.tostring(lenE21), text_color=colE21)
            table.cell(tb, 1, row, str.tostring(ema21, format.mintick))
            row += 1
        if showE34
            table.cell(tb, 0, row, "EMA " + str.tostring(lenE34), text_color=colE34)
            table.cell(tb, 1, row, str.tostring(ema34, format.mintick))
            row += 1
        if showE50
            table.cell(tb, 0, row, "EMA " + str.tostring(lenE50), text_color=colE50)
            table.cell(tb, 1, row, str.tostring(ema50, format.mintick))
            row += 1
        if showE100
            table.cell(tb, 0, row, "EMA " + str.tostring(lenE100), text_color=colE100)
            table.cell(tb, 1, row, str.tostring(ema100, format.mintick))
            row += 1
        if showE200
            table.cell(tb, 0, row, "EMA " + str.tostring(lenE200), text_color=colE200)
            table.cell(tb, 1, row, str.tostring(ema200, format.mintick))
            row += 1
        if showS50
            table.cell(tb, 0, row, "SMA " + str.tostring(lenS50), text_color=colS50)
            table.cell(tb, 1, row, str.tostring(sma50, format.mintick))
            row += 1
        if showS100
            table.cell(tb, 0, row, "SMA " + str.tostring(lenS100), text_color=colS100)
            table.cell(tb, 1, row, str.tostring(sma100, format.mintick))
            row += 1
        if showS200
            table.cell(tb, 0, row, "SMA " + str.tostring(lenS200), text_color=colS200)
            table.cell(tb, 1, row, str.tostring(sma200, format.mintick))
            row += 1

    else
        table.clear(tb, 0, 0)

        if showLabels
            f_clear_labels()

            float[] vals = array.new_float()
            string[] txts = array.new_string()
            color[] cols = array.new_color()

            f_push(showE9,   ema9,   "EMA " + str.tostring(lenE9),   colE9,   vals, txts, cols)
            f_push(showE20,  ema20,  "EMA " + str.tostring(lenE20),  colE20,  vals, txts, cols)
            f_push(showE21,  ema21,  "EMA " + str.tostring(lenE21),  colE21,  vals, txts, cols)
            f_push(showE34,  ema34,  "EMA " + str.tostring(lenE34),  colE34,  vals, txts, cols)
            f_push(showE50,  ema50,  "EMA " + str.tostring(lenE50),  colE50,  vals, txts, cols)
            f_push(showE100, ema100, "EMA " + str.tostring(lenE100), colE100, vals, txts, cols)
            f_push(showE200, ema200, "EMA " + str.tostring(lenE200), colE200, vals, txts, cols)
            f_push(showS50,  sma50,  "SMA " + str.tostring(lenS50),  colS50,  vals, txts, cols)
            f_push(showS100, sma100, "SMA " + str.tostring(lenS100), colS100, vals, txts, cols)
            f_push(showS200, sma200, "SMA " + str.tostring(lenS200), colS200, vals, txts, cols)

            f_sort_desc(vals, txts, cols)

            gap = syminfo.mintick * minGapTicks
            float[] placedY = array.new_float()

            int n = array.size(vals)
            if n > 0
                for i = 0 to n - 1
                    y = array.get(vals, i)
                    yAdj = y

                    for k = 0 to 20
                        ok = true
                        m = array.size(placedY)
                        if m > 0
                            for j = 0 to m - 1
                                if math.abs(yAdj - array.get(placedY, j)) < gap
                                    ok := false
                        if ok
                            break
                        yAdj -= gap

                    array.push(placedY, yAdj)

                    t = array.get(txts, i)
                    c = array.get(cols, i)

                    lb = label.new(bar_index + labelsXOffset, yAdj, t, style=label.style_label_left, textcolor=color.white, color=color.new(c, 0), size=size.small)
                    array.push(labs, lb)
        else
            f_clear_labels()
