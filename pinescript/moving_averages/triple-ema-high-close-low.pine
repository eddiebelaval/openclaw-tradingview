//@version=5
indicator(title="Triple EMA - High / Close / Low", shorttitle="EMA Band", overlay=true)

// ─────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────
emaLen      = input.int(21,    title="EMA Length",          minval=1)
showFill    = input.bool(true, title="Fill Band",            group="Display")
colorHigh   = input.color(color.new(color.red,   0),  title="EMA High Color",  group="Display")
colorClose  = input.color(color.new(color.white, 0),  title="EMA Close Color", group="Display")
colorLow    = input.color(color.new(color.teal,  0),  title="EMA Low Color",   group="Display")
fillColUp   = input.color(color.new(color.teal,  85), title="Fill Color (Bull)", group="Display")
fillColDown = input.color(color.new(color.red,   85), title="Fill Color (Bear)", group="Display")

// ─────────────────────────────────────────
// EMA CALCULATIONS
// ─────────────────────────────────────────
emaHigh  = ta.ema(high,  emaLen)
emaClose = ta.ema(close, emaLen)
emaLow   = ta.ema(low,   emaLen)

// ─────────────────────────────────────────
// PLOTS
// ─────────────────────────────────────────
pHigh  = plot(emaHigh,  title="EMA High",  color=colorHigh,  linewidth=1, style=plot.style_line)
pClose = plot(emaClose, title="EMA Close", color=colorClose, linewidth=2, style=plot.style_line)
pLow   = plot(emaLow,   title="EMA Low",   color=colorLow,   linewidth=1, style=plot.style_line)

// Fill between High and Low EMA
// Color based on whether close EMA is rising or falling
fillColor = emaClose > emaClose[1] ? fillColUp : fillColDown
fill(pHigh, pLow, color=showFill ? fillColor : na, title="Band Fill")

// ─────────────────────────────────────────
// LABEL on last bar showing EMA length
// ─────────────────────────────────────────
if barstate.islast
    label.new(bar_index, emaHigh,
         text="EMA(" + str.tostring(emaLen) + ") H/C/L",
         style=label.style_label_left,
         color=color.new(color.gray, 60),
         textcolor=color.white,
         size=size.tiny)
