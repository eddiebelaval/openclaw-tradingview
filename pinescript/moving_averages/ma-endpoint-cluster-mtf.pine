//@version=6
//──────────────────────────────────────────────────────────────────────────────
// INDICATOR METADATA
//──────────────────────────────────────────────────────────────────────────────
indicator('MA Endpoint Cluster (MTF)', shorttitle = 'MA Cluster', overlay = true, max_lines_count = 500)

//──────────────────────────────────────────────────────────────────────────────
// TOOLTIP TEXTS & DESCRIPTIONS
//──────────────────────────────────────────────────────────────────────────────

string DESC         = 'SMA/EMA MTF ENDINGS - TRADING GUIDE\n' + '\n' + 'CONCEPT:\n' + 'This tool is designed to keep price action clean (\'Ending\' mode) while providing critical Multi-Timeframe (MTF) Support & Resistance levels.\n\n' +
                      'TRADING APPLICATION:\n' + '1. Trend Filter (Primary MA):\n' +
                      '   • The \'Primary MA\' uses Red/Green colors. Use ⠀⠀this to determine the immediate bias.\n' +
                      '   • Green = Bullish context, Red = Bearish ⠀⠀context.\n\n' + '2. Magnetic Levels (Cluster Analysis):\n' +
                      '   • Set \'Time Frame\' to \'All\' or \'Chart & Higher\'.\n' +
                      '   • Look for areas where multiple \'Ending\' ⠀⠀segments cluster together tightly.\n' +
                      '   • These Clusters act as high-probability reversal ⠀⠀zones or strong magnets for price.\n\n' +
                      '3. Dynamic S/R & Pullbacks:\n' +
                      '   • In a trend, price often retraces to touch the ⠀⠀\'Endings\' of Higher Timeframe MAs (e.g., Daily ⠀⠀20 SMA visible on a 5m chart).\n\n' +
                      'MODES:\n' +
                      '• Full: Shows the historic line path.\n' +
                      '• Ending: Shows only the current location (last 2 ⠀bars) to reduce visual noise.'

string TT_GEN_TYPE  = 'Choose the calculation method:\n' + '• SMA: Simple Moving Average.\n' + '• EMA: Exponential Moving Average.\n' + '• SMA & EMA: Plots both simultaneously (useful to see compression).'

string TT_GEN_TF    = 'CONTROLS THE VISIBLE TIMEFRAMES:\n\n' + '• \'Chart\': Only plots MAs from the current chart timeframe.\n' + '• \'Chart & Higher\': Plots the current chart\'s MAs AND all higher timeframes. Filters out lower timeframe noise.\n' + '• \'All\': Plots \'Endings\' for ALL timeframes (5m up to 1M). Best for finding Clusters.\n' + '• Specific (e.g., \'4h\'): Forces the display of MAs from that specific timeframe only.'

string TT_GEN_PRI   = 'COLOR CODING & HIERARCHY:\n\n' + 'Select which MA represents your main trend filter.\n' + '• SMA is colored RED. EMA is colored GREEN\n' + '• All other MAs are colored YELLOW (current TF) or BLUE (higher TF).'

string TT_GEN_OP    = 'VISIBILITY CONTROL:\n\n' + 'Adjusts the transparency of the continuous lines when Mode is set to \'Full\'.\n' + '• 100% = Solid line.\n' + '• 0% = Invisible.'

string TT_GEN_WGT   = 'LINE THICKNESS LOGIC:\n\n' + 'If enabled, Ending lines use weighted thickness:\n' + '• Width 1: Current TF, 5m, 15m\n' + '• Width 2: 1h\n' + '• Width 3: 4h\n' + '• Width 4: 1D\n' + '• Width 5: 1W\n' + '• Width 6: 1M'

string TT_MA_CFG    = 'INDIVIDUAL MA SETTINGS:\n\n' + '• Mode \'Off\': Hides this MA completely.\n' + '• Mode \'Ending\': Draws a short segment at the current price level only. Keeps the chart naked.\n' + '• Mode \'Full\': Draws the traditional continuous line history.\n' + '• Length: The lookback period for the calculation.' + ' In case of "Ending" or "Full", all higher TF Endings will be plotted'

//──────────────────────────────────────────────────────────────────────────────
// 1. INPUTS
//──────────────────────────────────────────────────────────────────────────────

// --- INFO GROUP ---
_info = input.bool(false, 'General Information / Guide', tooltip = DESC)

grp_mode    = 'Mode Selection'
modeSel     = input.string('Simple Mode', 'Mode', options = ['Simple Mode', 'Advanced Mode'], group = grp_mode, tooltip = 'Toggle between Simple Mode and Advanced Mode.')

bool isSimpleMode   = modeSel == 'Simple Mode'
bool isAdvancedMode = modeSel == 'Advanced Mode'


grp_simple = 'Simple Mode'
sm_plotCurrentTf    = input.bool(true, 'Current TF EMA/SMA⠀', inline='cur', group = grp_simple, tooltip = '')
sm_currentMaType    = input.string('SMA', 'MA Type', inline='cur', options = ['SMA', 'EMA'], group = grp_simple, tooltip = 'The displayed MA\'s are: 10, 20, 50(green), 100, 150, 200(red), 360. \n\nSelect whether the current timeframe set uses SMA or EMA for all Simple Mode lengths.')
sm_plotHtf          = input.bool(false, 'Higher TF EMA/SMA⠀⠀', inline='high', group = grp_simple, tooltip = '')
sm_htfMaType        = input.string('SMA', 'MA Type', inline='high', options = ['SMA', 'EMA'], group = grp_simple, tooltip = 'Higher time frame MA\'s for D, W, M: 10, 20, 50, 100, 150, 200, 360. \n\nSelect whether higher timeframe lines (D/W/M) use SMA or EMA in Simple Mode.')

// --- GENERAL SETTINGS ---
grp_gen = 'Advanced Settings'
maType          = input.string('SMA & EMA', 'MA Type', options = ['SMA', 'EMA', 'SMA & EMA'], group = grp_gen, tooltip = TT_GEN_TYPE)
tfSel           = input.string('Chart & Higher', 'Time Frame Logic', options = ['Chart', 'Chart & Higher', 'All', '5m', '15m', '1h', '4h', '1D', '1W', '1M'], group = grp_gen, tooltip = TT_GEN_TF)
tfWeighted      = input.bool(true, 'Time Frame Weighted', group = grp_gen, tooltip = TT_GEN_WGT)
primaryMaSel    = input.string('MA 6', 'Primary MA (Highlight)', options = ['MA 1', 'MA 2', 'MA 3', 'MA 4', 'MA 5', 'MA 6', 'MA 7'], group = grp_gen, tooltip = TT_GEN_PRI)
opacityInput    = input.int(100, 'Full Plot Opacity %', minval = 0, maxval = 100, step = 5, group = grp_gen, tooltip = TT_GEN_OP)
transpVal       = 100 - opacityInput

// --- MA CONFIGURATION ---
grp = 'Advanced MA Configuration'

// MA 1
string m1_mode = input.string('Off', 'MA 1 Mode', options = ['Off', 'Ending', 'Full'], inline = 'ma1', group = grp, tooltip = TT_MA_CFG)
int m1_len = input.int(10, 'Length', minval = 1, inline = 'ma1', group = grp, tooltip = TT_MA_CFG)

// MA 2
string m2_mode = input.string('Off', 'MA 2 Mode', options = ['Off', 'Ending', 'Full'], inline = 'ma2', group = grp, tooltip = TT_MA_CFG)
int m2_len = input.int(20, 'Length', minval = 1, inline = 'ma2', group = grp, tooltip = TT_MA_CFG)

// MA 3
string m3_mode = input.string('Off', 'MA 3 Mode', options = ['Off', 'Ending', 'Full'], inline = 'ma3', group = grp, tooltip = TT_MA_CFG)
int m3_len = input.int(50, 'Length', minval = 1, inline = 'ma3', group = grp, tooltip = TT_MA_CFG)

// MA 4
string m4_mode = input.string('Off', 'MA 4 Mode', options = ['Off', 'Ending', 'Full'], inline = 'ma4', group = grp, tooltip = TT_MA_CFG)
int m4_len = input.int(100, 'Length', minval = 1, inline = 'ma4', group = grp, tooltip = TT_MA_CFG)

// MA 5
string m5_mode = input.string('Off', 'MA 5 Mode', options = ['Off', 'Ending', 'Full'], inline = 'ma5', group = grp, tooltip = TT_MA_CFG)
int m5_len = input.int(150, 'Length', minval = 1, inline = 'ma5', group = grp, tooltip = TT_MA_CFG)

// MA 6
string m6_mode = input.string('Full', 'MA 6 Mode', options = ['Off', 'Ending', 'Full'], inline = 'ma6', group = grp, tooltip = TT_MA_CFG)
int m6_len = input.int(200, 'Length', minval = 1, inline = 'ma6', group = grp, tooltip = TT_MA_CFG)

// MA 7
string m7_mode = input.string('Off', 'MA 7 Mode', options = ['Off', 'Ending', 'Full'], inline = 'ma7', group = grp, tooltip = TT_MA_CFG)
int m7_len = input.int(360, 'Length', minval = 1, inline = 'ma7', group = grp, tooltip = TT_MA_CFG)

int primaryLen = switch primaryMaSel
    'MA 1' => m1_len
    'MA 2' => m2_len
    'MA 3' => m3_len
    'MA 4' => m4_len
    'MA 5' => m5_len
    'MA 6' => m6_len
    'MA 7' => m7_len
    => 200

//──────────────────────────────────────────────────────────────────────────────
// 2. High-Performance Calculation (Tuple Return)
//──────────────────────────────────────────────────────────────────────────────
// Wir berechnen Current UND Previous Wert innerhalb der Funktion.
// Das garantiert, dass "Ending" Linien korrekt gezeichnet werden (Stufen-Effekt).
f_calc_tuple() =>
    // MA 1
    s1 = ta.sma(close, m1_len)
    s1p = s1[1]
    e1 = ta.ema(close, m1_len)
    e1p = e1[1]
    // MA 2
    s2 = ta.sma(close, m2_len)
    s2p = s2[1]
    e2 = ta.ema(close, m2_len)
    e2p = e2[1]
    // MA 3
    s3 = ta.sma(close, m3_len)
    s3p = s3[1]
    e3 = ta.ema(close, m3_len)
    e3p = e3[1]
    // MA 4
    s4 = ta.sma(close, m4_len)
    s4p = s4[1]
    e4 = ta.ema(close, m4_len)
    e4p = e4[1]
    // MA 5
    s5 = ta.sma(close, m5_len)
    s5p = s5[1]
    e5 = ta.ema(close, m5_len)
    e5p = e5[1]
    // MA 6
    s6 = ta.sma(close, m6_len)
    s6p = s6[1]
    e6 = ta.ema(close, m6_len)
    e6p = e6[1]
    // MA 7
    s7 = ta.sma(close, m7_len)
    s7p = s7[1]
    e7 = ta.ema(close, m7_len)
    e7p = e7[1]

    // Rückgabe aller 28 Werte als Tuple
    [s1, s1p, e1, e1p, s2, s2p, e2, e2p, s3, s3p, e3, e3p, s4, s4p, e4, e4p, s5, s5p, e5, e5p, s6, s6p, e6, e6p, s7, s7p, e7, e7p]

f_tf_label_normalized(tfInput) =>
    tfInput == '15' ? '15m' : tfInput == '1d' ? '1D' : tfInput == '1w' ? '1W' : tfInput

string tfSelNorm = f_tf_label_normalized(tfSel)

bool hasAdvancedMa = m1_mode != 'Off' or m2_mode != 'Off' or m3_mode != 'Off' or m4_mode != 'Off' or m5_mode != 'Off' or m6_mode != 'Off' or m7_mode != 'Off'
bool needsAdvData = isAdvancedMode and hasAdvancedMa
bool advIsAll = tfSelNorm == 'All'
bool advIsChartHigher = tfSelNorm == 'Chart & Higher'

f_adv_tf_needed(tfCode, tfSec) =>
    bool isSpecific = tfSelNorm == tfCode
    needsAdvData and (advIsAll or isSpecific or (advIsChartHigher and timeframe.in_seconds(tfSec) >= timeframe.in_seconds(timeframe.period) and timeframe.period != tfSec))

bool needChart = needsAdvData and (tfSelNorm == 'Chart' or advIsAll or advIsChartHigher)
bool need5m = f_adv_tf_needed('5m', '5')
bool need15m = f_adv_tf_needed('15m', '15')
bool need1h = f_adv_tf_needed('1h', '60')
bool need4h = f_adv_tf_needed('4h', '240')
bool need1D = f_adv_tf_needed('1D', 'D')
bool need1W = f_adv_tf_needed('1W', 'W')
bool need1M = f_adv_tf_needed('1M', 'M')

//──────────────────────────────────────────────────────────────────────────────
// 3. Data Fetching
//──────────────────────────────────────────────────────────────────────────────
gaps = barmerge.gaps_off
look = barmerge.lookahead_off

f_adv_security_tuple(tf, enabled) =>
    if enabled
        request.security(syminfo.tickerid, tf, f_calc_tuple(), lookahead = look, gaps = gaps)
    else
        [na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na]

f_chart_tuple(enabled) =>
    if enabled
        f_calc_tuple()
    else
        [na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na]

// Lokale Berechnung (Chart)
[c_s1, c_s1p, c_e1, c_e1p, c_s2, c_s2p, c_e2, c_e2p, c_s3, c_s3p, c_e3, c_e3p, c_s4, c_s4p, c_e4, c_e4p, c_s5, c_s5p, c_e5, c_e5p, c_s6, c_s6p, c_e6, c_e6p, c_s7, c_s7p, c_e7, c_e7p] = f_chart_tuple(needChart)

// Security Calls (Tuples) nur bei Bedarf
[d5_s1, d5_s1p, d5_e1, d5_e1p, d5_s2, d5_s2p, d5_e2, d5_e2p, d5_s3, d5_s3p, d5_e3, d5_e3p, d5_s4, d5_s4p, d5_e4, d5_e4p, d5_s5, d5_s5p, d5_e5, d5_e5p, d5_s6, d5_s6p, d5_e6, d5_e6p, d5_s7, d5_s7p, d5_e7, d5_e7p] = f_adv_security_tuple('5', need5m)
[d15_s1, d15_s1p, d15_e1, d15_e1p, d15_s2, d15_s2p, d15_e2, d15_e2p, d15_s3, d15_s3p, d15_e3, d15_e3p, d15_s4, d15_s4p, d15_e4, d15_e4p, d15_s5, d15_s5p, d15_e5, d15_e5p, d15_s6, d15_s6p, d15_e6, d15_e6p, d15_s7, d15_s7p, d15_e7, d15_e7p] = f_adv_security_tuple('15', need15m)
[d60_s1, d60_s1p, d60_e1, d60_e1p, d60_s2, d60_s2p, d60_e2, d60_e2p, d60_s3, d60_s3p, d60_e3, d60_e3p, d60_s4, d60_s4p, d60_e4, d60_e4p, d60_s5, d60_s5p, d60_e5, d60_e5p, d60_s6, d60_s6p, d60_e6, d60_e6p, d60_s7, d60_s7p, d60_e7, d60_e7p] = f_adv_security_tuple('60', need1h)
[d240_s1, d240_s1p, d240_e1, d240_e1p, d240_s2, d240_s2p, d240_e2, d240_e2p, d240_s3, d240_s3p, d240_e3, d240_e3p, d240_s4, d240_s4p, d240_e4, d240_e4p, d240_s5, d240_s5p, d240_e5, d240_e5p, d240_s6, d240_s6p, d240_e6, d240_e6p, d240_s7, d240_s7p, d240_e7, d240_e7p] = f_adv_security_tuple('240', need4h)
[dD_s1, dD_s1p, dD_e1, dD_e1p, dD_s2, dD_s2p, dD_e2, dD_e2p, dD_s3, dD_s3p, dD_e3, dD_e3p, dD_s4, dD_s4p, dD_e4, dD_e4p, dD_s5, dD_s5p, dD_e5, dD_e5p, dD_s6, dD_s6p, dD_e6, dD_e6p, dD_s7, dD_s7p, dD_e7, dD_e7p] = f_adv_security_tuple('D', need1D)
[dW_s1, dW_s1p, dW_e1, dW_e1p, dW_s2, dW_s2p, dW_e2, dW_e2p, dW_s3, dW_s3p, dW_e3, dW_e3p, dW_s4, dW_s4p, dW_e4, dW_e4p, dW_s5, dW_s5p, dW_e5, dW_e5p, dW_s6, dW_s6p, dW_e6, dW_e6p, dW_s7, dW_s7p, dW_e7, dW_e7p] = f_adv_security_tuple('W', need1W)
[dM_s1, dM_s1p, dM_e1, dM_e1p, dM_s2, dM_s2p, dM_e2, dM_e2p, dM_s3, dM_s3p, dM_e3, dM_e3p, dM_s4, dM_s4p, dM_e4, dM_e4p, dM_s5, dM_s5p, dM_e5, dM_e5p, dM_s6, dM_s6p, dM_e6, dM_e6p, dM_s7, dM_s7p, dM_e7, dM_e7p] = f_adv_security_tuple('M', need1M)


//──────────────────────────────────────────────────────────────────────────────
// 4. "Full" Plotting Selector
//──────────────────────────────────────────────────────────────────────────────
plotTf = tfSelNorm == 'All' or tfSelNorm == 'Chart & Higher' ? 'Chart' : tfSelNorm

f_val(sel, vC, v5, v15, v60, v240, vD, vW, vM) =>
    sel == 'Chart' ? vC : sel == '5m' ? v5 : sel == '15m' ? v15 : sel == '1h' ? v60 : sel == '4h' ? v240 : sel == '1D' ? vD : sel == '1W' ? vW : sel == '1M' ? vM : na

// Get Values for Full Plot (using only Current values)
p_s1 = f_val(plotTf, c_s1, d5_s1, d15_s1, d60_s1, d240_s1, dD_s1, dW_s1, dM_s1)
p_e1 = f_val(plotTf, c_e1, d5_e1, d15_e1, d60_e1, d240_e1, dD_e1, dW_e1, dM_e1)
p_s2 = f_val(plotTf, c_s2, d5_s2, d15_s2, d60_s2, d240_s2, dD_s2, dW_s2, dM_s2)
p_e2 = f_val(plotTf, c_e2, d5_e2, d15_e2, d60_e2, d240_e2, dD_e2, dW_e2, dM_e2)
p_s3 = f_val(plotTf, c_s3, d5_s3, d15_s3, d60_s3, d240_s3, dD_s3, dW_s3, dM_s3)
p_e3 = f_val(plotTf, c_e3, d5_e3, d15_e3, d60_e3, d240_e3, dD_e3, dW_e3, dM_e3)
p_s4 = f_val(plotTf, c_s4, d5_s4, d15_s4, d60_s4, d240_s4, dD_s4, dW_s4, dM_s4)
p_e4 = f_val(plotTf, c_e4, d5_e4, d15_e4, d60_e4, d240_e4, dD_e4, dW_e4, dM_e4)
p_s5 = f_val(plotTf, c_s5, d5_s5, d15_s5, d60_s5, d240_s5, dD_s5, dW_s5, dM_s5)
p_e5 = f_val(plotTf, c_e5, d5_e5, d15_e5, d60_e5, d240_e5, dD_e5, dW_e5, dM_e5)
p_s6 = f_val(plotTf, c_s6, d5_s6, d15_s6, d60_s6, d240_s6, dD_s6, dW_s6, dM_s6)
p_e6 = f_val(plotTf, c_e6, d5_e6, d15_e6, d60_e6, d240_e6, dD_e6, dW_e6, dM_e6)
p_s7 = f_val(plotTf, c_s7, d5_s7, d15_s7, d60_s7, d240_s7, dD_s7, dW_s7, dM_s7)
p_e7 = f_val(plotTf, c_e7, d5_e7, d15_e7, d60_e7, d240_e7, dD_e7, dW_e7, dM_e7)

// Colors
pc_s(len) =>
    baseCol = len == primaryLen ? color.red : plotTf == 'Chart' ? color.yellow : color.blue
    color.new(baseCol, transpVal)
pc_e(len) =>
    baseCol = len == primaryLen ? color.green : plotTf == 'Chart' ? color.yellow : color.blue
    color.new(baseCol, transpVal)

bool showS = maType == 'SMA' or maType == 'SMA & EMA'
bool showE = maType == 'EMA' or maType == 'SMA & EMA'

plot(isAdvancedMode and showS and m1_mode == 'Full' ? p_s1 : na, 'SMA 1', color = pc_s(m1_len))
plot(isAdvancedMode and showE and m1_mode == 'Full' ? p_e1 : na, 'EMA 1', color = pc_e(m1_len))
plot(isAdvancedMode and showS and m2_mode == 'Full' ? p_s2 : na, 'SMA 2', color = pc_s(m2_len))
plot(isAdvancedMode and showE and m2_mode == 'Full' ? p_e2 : na, 'EMA 2', color = pc_e(m2_len))
plot(isAdvancedMode and showS and m3_mode == 'Full' ? p_s3 : na, 'SMA 3', color = pc_s(m3_len))
plot(isAdvancedMode and showE and m3_mode == 'Full' ? p_e3 : na, 'EMA 3', color = pc_e(m3_len))
plot(isAdvancedMode and showS and m4_mode == 'Full' ? p_s4 : na, 'SMA 4', color = pc_s(m4_len))
plot(isAdvancedMode and showE and m4_mode == 'Full' ? p_e4 : na, 'EMA 4', color = pc_e(m4_len))
plot(isAdvancedMode and showS and m5_mode == 'Full' ? p_s5 : na, 'SMA 5', color = pc_s(m5_len))
plot(isAdvancedMode and showE and m5_mode == 'Full' ? p_e5 : na, 'EMA 5', color = pc_e(m5_len))
plot(isAdvancedMode and showS and m6_mode == 'Full' ? p_s6 : na, 'SMA 6', color = pc_s(m6_len))
plot(isAdvancedMode and showE and m6_mode == 'Full' ? p_e6 : na, 'EMA 6', color = pc_e(m6_len))
plot(isAdvancedMode and showS and m7_mode == 'Full' ? p_s7 : na, 'SMA 7', color = pc_s(m7_len))
plot(isAdvancedMode and showE and m7_mode == 'Full' ? p_e7 : na, 'EMA 7', color = pc_e(m7_len))

//──────────────────────────────────────────────────────────────────────────────
// 5. Ending Segments (Tuple Logic)
//──────────────────────────────────────────────────────────────────────────────
var array<line> drawn = array.new_line()

f_col(tf, len, isEma) =>
    bool isChartTf = tf == ''
    if isChartTf and len == primaryLen
        isEma ? color.green : color.red
    else
        isChartTf ? color.yellow : color.blue

f_seg(yPrev, yNow, c, w) =>
    line.new(bar_index - 1, yPrev, bar_index, yNow, xloc = xloc.bar_index, color = c, width = w)

f_draw_one_ma(mode, showS, showE, s, sp, e, ep, len, tf, w) =>
    if mode != 'Off'
        // Wir nutzen hier sp (Previous vom HTF) und s (Current vom HTF)
        if showS and not na(s) and not na(sp)
            array.push(drawn, f_seg(sp, s, f_col(tf, len, false), w))
        if showE and not na(e) and not na(ep)
            array.push(drawn, f_seg(ep, e, f_col(tf, len, true), w))

f_draw_tf_group(tfLabel, width, s1, s1p, e1, e1p, s2, s2p, e2, e2p, s3, s3p, e3, e3p, s4, s4p, e4, e4p, s5, s5p, e5, e5p, s6, s6p, e6, e6p, s7, s7p, e7, e7p) =>
    f_draw_one_ma(m1_mode, showS, showE, s1, s1p, e1, e1p, m1_len, tfLabel, width)
    f_draw_one_ma(m2_mode, showS, showE, s2, s2p, e2, e2p, m2_len, tfLabel, width)
    f_draw_one_ma(m3_mode, showS, showE, s3, s3p, e3, e3p, m3_len, tfLabel, width)
    f_draw_one_ma(m4_mode, showS, showE, s4, s4p, e4, e4p, m4_len, tfLabel, width)
    f_draw_one_ma(m5_mode, showS, showE, s5, s5p, e5, e5p, m5_len, tfLabel, width)
    f_draw_one_ma(m6_mode, showS, showE, s6, s6p, e6, e6p, m6_len, tfLabel, width)
    f_draw_one_ma(m7_mode, showS, showE, s7, s7p, e7, e7p, m7_len, tfLabel, width)


// Main execution for lines
if barstate.islast
    for l in drawn
        line.delete(l)
    array.clear(drawn)

    if isAdvancedMode
        // Check which TFs are needed (explicit and readable TF-logic)
        bool do_chart = needChart
        bool do_5m = need5m
        bool do_15m = need15m
        bool do_1h = need1h
        bool do_4h = need4h
        bool do_1D = need1D
        bool do_1W = need1W
        bool do_1M = need1M

        // Determine widths
        int w_chart = tfWeighted ? 1 : 2
        int w_5m = tfWeighted ? 1 : 2
        int w_15m = tfWeighted ? 1 : 2
        int w_1h = tfWeighted ? 2 : 2
        int w_4h = tfWeighted ? 3 : 2
        int w_1D = tfWeighted ? 4 : 2
        int w_1W = tfWeighted ? 5 : 2
        int w_1M = tfWeighted ? 6 : 2

        if do_chart
            f_draw_tf_group('', w_chart, c_s1, c_s1p, c_e1, c_e1p, c_s2, c_s2p, c_e2, c_e2p, c_s3, c_s3p, c_e3, c_e3p, c_s4, c_s4p, c_e4, c_e4p, c_s5, c_s5p, c_e5, c_e5p, c_s6, c_s6p, c_e6, c_e6p, c_s7, c_s7p, c_e7, c_e7p)
        if do_5m
            f_draw_tf_group('5m', w_5m, d5_s1, d5_s1p, d5_e1, d5_e1p, d5_s2, d5_s2p, d5_e2, d5_e2p, d5_s3, d5_s3p, d5_e3, d5_e3p, d5_s4, d5_s4p, d5_e4, d5_e4p, d5_s5, d5_s5p, d5_e5, d5_e5p, d5_s6, d5_s6p, d5_e6, d5_e6p, d5_s7, d5_s7p, d5_e7, d5_e7p)
        if do_15m
            f_draw_tf_group('15m', w_15m, d15_s1, d15_s1p, d15_e1, d15_e1p, d15_s2, d15_s2p, d15_e2, d15_e2p, d15_s3, d15_s3p, d15_e3, d15_e3p, d15_s4, d15_s4p, d15_e4, d15_e4p, d15_s5, d15_s5p, d15_e5, d15_e5p, d15_s6, d15_s6p, d15_e6, d15_e6p, d15_s7, d15_s7p, d15_e7, d15_e7p)
        if do_1h
            f_draw_tf_group('1h', w_1h, d60_s1, d60_s1p, d60_e1, d60_e1p, d60_s2, d60_s2p, d60_e2, d60_e2p, d60_s3, d60_s3p, d60_e3, d60_e3p, d60_s4, d60_s4p, d60_e4, d60_e4p, d60_s5, d60_s5p, d60_e5, d60_e5p, d60_s6, d60_s6p, d60_e6, d60_e6p, d60_s7, d60_s7p, d60_e7, d60_e7p)
        if do_4h
            f_draw_tf_group('4h', w_4h, d240_s1, d240_s1p, d240_e1, d240_e1p, d240_s2, d240_s2p, d240_e2, d240_e2p, d240_s3, d240_s3p, d240_e3, d240_e3p, d240_s4, d240_s4p, d240_e4, d240_e4p, d240_s5, d240_s5p, d240_e5, d240_e5p, d240_s6, d240_s6p, d240_e6, d240_e6p, d240_s7, d240_s7p, d240_e7, d240_e7p)
        if do_1D
            f_draw_tf_group('1D', w_1D, dD_s1, dD_s1p, dD_e1, dD_e1p, dD_s2, dD_s2p, dD_e2, dD_e2p, dD_s3, dD_s3p, dD_e3, dD_e3p, dD_s4, dD_s4p, dD_e4, dD_e4p, dD_s5, dD_s5p, dD_e5, dD_e5p, dD_s6, dD_s6p, dD_e6, dD_e6p, dD_s7, dD_s7p, dD_e7, dD_e7p)
        if do_1W
            f_draw_tf_group('1W', w_1W, dW_s1, dW_s1p, dW_e1, dW_e1p, dW_s2, dW_s2p, dW_e2, dW_e2p, dW_s3, dW_s3p, dW_e3, dW_e3p, dW_s4, dW_s4p, dW_e4, dW_e4p, dW_s5, dW_s5p, dW_e5, dW_e5p, dW_s6, dW_s6p, dW_e6, dW_e6p, dW_s7, dW_s7p, dW_e7, dW_e7p)
        if do_1M
            f_draw_tf_group('1M', w_1M, dM_s1, dM_s1p, dM_e1, dM_e1p, dM_s2, dM_s2p, dM_e2, dM_e2p, dM_s3, dM_s3p, dM_e3, dM_e3p, dM_s4, dM_s4p, dM_e4, dM_e4p, dM_s5, dM_s5p, dM_e5, dM_e5p, dM_s6, dM_s6p, dM_e6, dM_e6p, dM_s7, dM_s7p, dM_e7, dM_e7p)


//──────────────────────────────────────────────────────────────────────────────
// 6. Simple Mode
//──────────────────────────────────────────────────────────────────────────────

bool sm_useCurrentEma = sm_currentMaType == 'EMA'
bool sm_useHtfEma = sm_htfMaType == 'EMA'

sm_ma10 = sm_useCurrentEma ? ta.ema(close, 10) : ta.sma(close, 10)
sm_ma20 = sm_useCurrentEma ? ta.ema(close, 20) : ta.sma(close, 20)
sm_ma50 = sm_useCurrentEma ? ta.ema(close, 50) : ta.sma(close, 50)
sm_ma100 = sm_useCurrentEma ? ta.ema(close, 100) : ta.sma(close, 100)
sm_ma150 = sm_useCurrentEma ? ta.ema(close, 150) : ta.sma(close, 150)
sm_ma200 = sm_useCurrentEma ? ta.ema(close, 200) : ta.sma(close, 200)
sm_ma360 = sm_useCurrentEma ? ta.ema(close, 360) : ta.sma(close, 360)

plot(isSimpleMode and sm_plotCurrentTf ? sm_ma10 : na, 'sm ctf ma 10', color = color.white, linewidth = 1, show_last = 2)
plot(isSimpleMode and sm_plotCurrentTf ? sm_ma20 : na, 'sm ctf ma 20', color = color.white, linewidth = 1, show_last = 2)
plot(isSimpleMode and sm_plotCurrentTf ? sm_ma50 : na, 'sm ctf ma 50', color = color.green, linewidth = 2, show_last = 2)
plot(isSimpleMode and sm_plotCurrentTf ? sm_ma100 : na, 'sm ctf ma 100', color = color.white, linewidth = 1, show_last = 2)
plot(isSimpleMode and sm_plotCurrentTf ? sm_ma150 : na, 'sm ctf ma 150', color = color.white, linewidth = 1, show_last = 2)
plot(isSimpleMode and sm_plotCurrentTf ? sm_ma200 : na, 'sm ctf ma 200', color = color.red, linewidth = 2, show_last = 2)
plot(isSimpleMode and sm_plotCurrentTf ? sm_ma360 : na, 'sm ctf ma 360', color = color.white, linewidth = 1, show_last = 2)

f_sm_htf_tuple() =>
    sm_htf10 = sm_useHtfEma ? ta.ema(close, 10) : ta.sma(close, 10)
    sm_htf20 = sm_useHtfEma ? ta.ema(close, 20) : ta.sma(close, 20)
    sm_htf50 = sm_useHtfEma ? ta.ema(close, 50) : ta.sma(close, 50)
    sm_htf100 = sm_useHtfEma ? ta.ema(close, 100) : ta.sma(close, 100)
    sm_htf150 = sm_useHtfEma ? ta.ema(close, 150) : ta.sma(close, 150)
    sm_htf200 = sm_useHtfEma ? ta.ema(close, 200) : ta.sma(close, 200)
    sm_htf360 = sm_useHtfEma ? ta.ema(close, 360) : ta.sma(close, 360)
    [sm_htf10, sm_htf20, sm_htf50, sm_htf100, sm_htf150, sm_htf200, sm_htf360]

f_sm_security_tuple(tf, enabled) =>
    if enabled
        request.security(syminfo.tickerid, tf, f_sm_htf_tuple(), gaps, look)
    else
        [na, na, na, na, na, na, na]

sm_showDaily = isSimpleMode and sm_plotHtf and timeframe.isintraday
sm_showWeekly = isSimpleMode and sm_plotHtf and (timeframe.isintraday or timeframe.isdaily)
sm_showMonthly = isSimpleMode and sm_plotHtf and (timeframe.isintraday or timeframe.isdaily or timeframe.isweekly)

[sm_d10, sm_d20, sm_d50, sm_d100, sm_d150, sm_d200, sm_d360] = f_sm_security_tuple('D', sm_showDaily)
[sm_w10, sm_w20, sm_w50, sm_w100, sm_w150, sm_w200, sm_w360] = f_sm_security_tuple('W', sm_showWeekly)
[sm_m10, sm_m20, sm_m50, sm_m100, sm_m150, sm_m200, sm_m360] = f_sm_security_tuple('M', sm_showMonthly)

plot(sm_showDaily ? sm_d10 : na, 'sm d ma 10', color = color.yellow, linewidth = 1, show_last = 2)
plot(sm_showDaily ? sm_d20 : na, 'sm d ma 20', color = color.yellow, linewidth = 1, show_last = 2)
plot(sm_showDaily ? sm_d50 : na, 'sm d ma 50', color = color.yellow, linewidth = 1, show_last = 2)
plot(sm_showDaily ? sm_d100 : na, 'sm d ma 100', color = color.yellow, linewidth = 1, show_last = 2)
plot(sm_showDaily ? sm_d150 : na, 'sm d ma 150', color = color.yellow, linewidth = 1, show_last = 2)
plot(sm_showDaily ? sm_d200 : na, 'sm d ma 200', color = color.yellow, linewidth = 1, show_last = 2)
plot(sm_showDaily ? sm_d360 : na, 'sm d ma 360', color = color.yellow, linewidth = 1, show_last = 2)

plot(sm_showWeekly ? sm_w10 : na, 'sm w ma 10', color = color.yellow, linewidth = 1, show_last = 2)
plot(sm_showWeekly ? sm_w20 : na, 'sm w ma 20', color = color.yellow, linewidth = 1, show_last = 2)
plot(sm_showWeekly ? sm_w50 : na, 'sm w ma 50', color = color.yellow, linewidth = 1, show_last = 2)
plot(sm_showWeekly ? sm_w100 : na, 'sm w ma 100', color = color.yellow, linewidth = 1, show_last = 2)
plot(sm_showWeekly ? sm_w150 : na, 'sm w ma 150', color = color.yellow, linewidth = 1, show_last = 2)
plot(sm_showWeekly ? sm_w200 : na, 'sm w ma 200', color = color.yellow, linewidth = 1, show_last = 2)
plot(sm_showWeekly ? sm_w360 : na, 'sm w ma 360', color = color.yellow, linewidth = 1, show_last = 2)

plot(sm_showMonthly ? sm_m10 : na, 'sm m ma 10', color = color.yellow, linewidth = 2, show_last = 2)
plot(sm_showMonthly ? sm_m20 : na, 'sm m ma 20', color = color.yellow, linewidth = 2, show_last = 2)
plot(sm_showMonthly ? sm_m50 : na, 'sm m ma 50', color = color.yellow, linewidth = 2, show_last = 2)
plot(sm_showMonthly ? sm_m100 : na, 'sm m ma 100', color = color.yellow, linewidth = 1, show_last = 2)
plot(sm_showMonthly ? sm_m150 : na, 'sm m ma 150', color = color.yellow, linewidth = 1, show_last = 2)
plot(sm_showMonthly ? sm_m200 : na, 'sm m ma 200', color = color.yellow, linewidth = 1, show_last = 2)
plot(sm_showMonthly ? sm_m360 : na, 'sm m ma 360', color = color.yellow, linewidth = 1, show_last = 2)
