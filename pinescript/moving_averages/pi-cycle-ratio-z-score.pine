//@version=6
indicator("Pi Cycle Ratio Z-Score", overlay = false, precision = 3)

// ── Inputs ────────────────────────────────────────────────────────────────────
int zscore_length = input.int(2500, title = "Z-Score Lookback (days)", minval = 50)

// ── MAs ───────────────────────────────────────────────────────────────────────
float ma111   = ta.sma(close, 111)
float ma350x2 = ta.sma(close, 350) * 2

// ── Ratio ─────────────────────────────────────────────────────────────────────
float ratio = ma111 / ma350x2

// ── Z-Score of the ratio ──────────────────────────────────────────────────────
float ratio_mean  = ta.sma(ratio, zscore_length)
float ratio_stdev = ta.stdev(ratio, zscore_length)
float zscore      = (ratio - ratio_mean) / ratio_stdev

// ── Reference lines ───────────────────────────────────────────────────────────
hline(2,  "+2 SD — High Value",  color = color.new(color.green, 0),  linestyle = hline.style_dashed)
hline(1,  "+1 SD",               color = color.new(color.green, 50), linestyle = hline.style_dotted)
hline(0,  "Neutral",             color = color.new(color.gray,  30), linestyle = hline.style_solid)
hline(-1, "-1 SD",               color = color.new(color.red,   50), linestyle = hline.style_dotted)
hline(-2, "-2 SD — Overheated",  color = color.new(color.red,   0),  linestyle = hline.style_dashed)

// ── Line colour by zone ───────────────────────────────────────────────────────
color zone_color = switch
    zscore >= 1.5  => color.new(color.green,  0)
    zscore >= 0.5  => color.new(color.green,  50)
    zscore >= -0.5 => color.new(color.gray,   30)
    zscore >= -1.5 => color.new(color.orange, 20)
    =>                color.new(color.red,    0)

// ── Plot ──────────────────────────────────────────────────────────────────────
plot(zscore, title = "Pi Cycle Ratio Z-Score", color = zone_color, linewidth = 2)

// ── Background shading at extremes ───────────────────────────────────────────
color bg = switch
    zscore >= 1.5  => color.new(color.green, 90)
    zscore <= -1.5 => color.new(color.red,   90)
    =>                na
bgcolor(bg, title = "Extreme Zone Background")

// ── Signal label ──────────────────────────────────────────────────────────────
string signal = switch
    zscore >= 1.5  => "HIGH VALUE"
    zscore >= 0.5  => "Value"
    zscore >= -0.5 => "Neutral"
    zscore >= -1.5 => "Overvalue"
    =>                "OVERHEATED"

color lbl_color = switch
    zscore >= 0.5  => color.green
    zscore >= -0.5 => color.gray
    =>                color.red

var label lbl = na
label.delete(lbl)
lbl := label.new(bar_index, zscore, signal + "\n" + str.tostring(math.round(zscore, 2)), style = label.style_label_left, color = color.new(lbl_color, 80), textcolor = color.white, size = size.small)
