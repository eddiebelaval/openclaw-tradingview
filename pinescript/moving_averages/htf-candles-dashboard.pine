//@version=6
indicator("HTF Candles Dashboard ", overlay=true, max_labels_count=500, max_boxes_count=500, max_bars_back=5000, max_lines_count=500)

// ================================================================================================
// Linjar
// ================================================================================================

// ---------------------------------------------------------------------------------------------- //
// Functions for HTF Candles  ------------------------------------------------------------------- //

f_htf_ohlc(_htf) =>
    var htf_o  = 0., var htf_h  = 0., var htf_l  = 0.,     htf_c  = close
    var htf_ox = 0., var htf_hx = 0., var htf_lx = 0., var htf_cx = 0.

    if ta.change(time(_htf)) != 0
        htf_ox := htf_o
        htf_o := open
        htf_hx := htf_h
        htf_h := high
        htf_lx := htf_l
        htf_l := low
        htf_cx := htf_c[1]
        true
    else
        htf_h := math.max(high, htf_h)
        htf_l := math.min(low, htf_l)
        true

    [htf_ox, htf_hx, htf_lx, htf_cx, htf_o, htf_h, htf_l, htf_c]

f_haTicker(_htf) =>
    haTicker = ticker.heikinashi(syminfo.tickerid)
    [ha_o, ha_h, ha_l, ha_c] = request.security(haTicker, _htf, [open, high, low, close])
    ha_ox = ta.valuewhen(ta.change(time(_htf)) != 0, ha_o, 0)
    ha_hx = ta.valuewhen(ta.change(time(_htf)) != 0, ha_h, 0)
    ha_lx = ta.valuewhen(ta.change(time(_htf)) != 0, ha_l, 0)
    ha_cx = ta.valuewhen(ta.change(time(_htf)) != 0, ha_c, 0)

    [ha_ox, ha_hx, ha_lx, ha_cx, ha_o, ha_h, ha_l, ha_c]

f_getTF(_htf) =>
    htf = _htf == '3 Mins' ? '3' : _htf == '5 Mins' ? '5' : _htf == '10 Mins' ? '10' : _htf == '15 Mins' ? '15' : _htf == '30 Mins' ? '30' : _htf == '45 Mins' ? '45' : _htf == '1 Hour' ? '60' : _htf == '2 Hours' ? '120' : _htf == '3 Hours' ? '180' : _htf == '4 Hours' ? '240' : _htf == '1 Day' ? 'D' : _htf == '1 Week' ? 'W' : _htf == '1 Month' ? 'M' : _htf == '3 Months' ? '3M' : _htf == '6 Months' ? '6M' : _htf == '1 Year' ? '12M' : na
    htf

checkIf(_chartTF, _candlestickTF) =>
    var stat = false
    candlestickTF = _candlestickTF == 'D' ? 1440 : _candlestickTF == 'W' ? 10080 :  _candlestickTF == 'M' ? 302400 :  _candlestickTF == '3M' ? 3 * 302400 :  _candlestickTF == '6M' ? 6 * 302400 :  _candlestickTF == '12M' ? 12 * 302400 : str.tonumber(_candlestickTF)

    if timeframe.isintraday
        stat := candlestickTF >= str.tonumber(_chartTF)
    else
        chartTF = str.contains(_chartTF, 'D') ? _chartTF == 'D' ? 1440 : str.tonumber(str.replace(_chartTF, 'D', '', 0)) * 1440 : str.contains(_chartTF, 'W') ? _chartTF == 'W' ? 10080 : str.tonumber(str.replace(_chartTF, 'W', '', 0)) * 10080 : _chartTF == 'M' ? 302400 : str.tonumber(str.replace(_chartTF, 'M', '', 0)) * 302400
        stat := candlestickTF >= chartTF
    stat

f_atr(_length, _htf) =>
    request.security(syminfo.tickerid, _htf, ta.atr(_length))

f_getTooltip(_o, _h, _l, _c, _c1, _atr, _atrM) =>
    highVolatility = _h - _l > _atr * _atrM
    'Change % : ' + str.tostring((_c / _c1 - 1) * 100, '#.##') + '%\n' + (highVolatility ? '⚡ High Volatility Detected\nATR Value ' + str.tostring(_atr, '#.##') + '\n' : 'ATR Value : ' + str.tostring(_atr, '#.##') + '\n') + 'Candle Range : ' + str.tostring(_h - _l) + '\n\nO : ' + str.tostring(_o) + '\nH : ' + str.tostring(_h) + '\nL : ' + str.tostring(_l) + '\nC : ' + str.tostring(_c)

f_drawLineX(_x1, _y1, _x2, _y2, _xloc, _extend, _color, _style, _width) =>
    var id = line.new(_x1, _y1, _x2, _y2, _xloc, _extend, _color, _style, _width)
    line.set_xy1(id, _x1, _y1)
    line.set_xy2(id, _x2, _y2)
    line.set_color(id, _color)

f_drawLabelX(_x, _y, _text, _xloc, _yloc, _color, _style, _textcolor, _size, _textalign, _tooltip) =>
    var id = label.new(_x, _y, _text, _xloc, _yloc, _color, _style, _textcolor, _size, _textalign, _tooltip)
    label.set_xy(id, _x, _y)
    label.set_text(id, _text)
    label.set_tooltip(id, _tooltip)
    label.set_textcolor(id, _textcolor)

f_getOHLC(_o , _h , _l , _c, _atr, _hist) =>
    Ox = ta.valuewhen(ta.change(_o) != 0, _o, _hist)
    Hx = ta.valuewhen(ta.change(_h) != 0, _h, _hist)
    Lx = ta.valuewhen(ta.change(_l) != 0, _l, _hist)
    Cx = ta.valuewhen(ta.change(_c) != 0, _c, _hist)
    Ax = ta.valuewhen(ta.change(_atr) != 0, _atr, _hist + 1)
    [Ox , Hx , Lx , Cx, Ax]

f_drawCandle(_x, _o, _h, _l, _c, _color, _text, _tooltip) =>
    f_drawLineX(_x, _o, _x, _c, xloc.bar_index, extend.none, _color, line.style_solid, 3)
    f_drawLineX(_x, _h, _x, _l, xloc.bar_index, extend.none, _color, line.style_solid, 1)
    f_drawLabelX(_x, _h, _text, xloc.bar_index, yloc.price, #00000000, label.style_label_down, _color, size.normal, text.align_left, _tooltip)

f_drawAssistLineLableX(_x1, _y, _x2, _color, _text, _size) =>
    f_drawLineX(_x1, _y, _x2, _y, xloc.bar_index, extend.none, _color, line.style_solid, 1)
    f_drawLabelX(_x2, _y, _text + ' (' + str.tostring(_y, format.mintick) + ')', xloc.bar_index, yloc.price, #00000000, label.style_label_left, _color, _size, text.align_left, str.tostring(_y, format.mintick))

f_processCandles(_show, _htf, _cndl, _bullC, _bearC, _trans, _btransp, _width, _mini, _offset, _atr, _atrM, _hcount, _a_hst, _a_lst, _disableCandle) =>
    if _show
        [O1 , H1 , L1 , C1 , O0 , H0 , L0 , C0 ] = f_htf_ohlc(_htf)
        [hO1, hH1, hL1, hC1, hO0, hH0, hL0, hC0] = f_haTicker(_htf)

        O0 := _cndl == 'Heikin Ashi' ? hO0 : O0
        O1 := _cndl == 'Heikin Ashi' ? hO1 : O1
        H0 := _cndl == 'Heikin Ashi' ? hH0 : H0
        H1 := _cndl == 'Heikin Ashi' ? hH1 : H1
        L0 := _cndl == 'Heikin Ashi' ? hL0 : L0
        L1 := _cndl == 'Heikin Ashi' ? hL1 : L1
        C0 := _cndl == 'Heikin Ashi' ? hC0 : C0
        C1 := _cndl == 'Heikin Ashi' ? hC1 : C1

        color0  = O0 < C0 ? color.new(_bullC, _trans)   : color.new(_bearC, _trans)
        color01 = O0 < C0 ? color.new(_bullC, _btransp) : color.new(_bearC, _btransp)
        color1  = O1 < C1 ? color.new(_bullC, _trans)   : color.new(_bearC, _trans)
        color11 = O1 < C1 ? color.new(_bullC, _btransp) : color.new(_bearC, _btransp)

        var box hl  = na
        var box oc  = na
        var int x11 = na
        var int x1  = na

        if _htf != timeframe.period and not _disableCandle
            if ta.change(time(_htf)) != 0
                x11 := x1
                x1  := bar_index

                if L1 != 0
                    box.new(x11, H1, x1 - 1, L1, color11, _width, line.style_dotted, extend.none, xloc.bar_index, color1)
                    box.new(x11, O1, x1 - 1, C1, color11, _width, line.style_solid , extend.none, xloc.bar_index, color1)

                box.delete(hl)
                hl := box.new(x1, H0, 2 * x1 - x11 - 1, L0, color01, _width, line.style_dotted, extend.none, xloc.bar_index, color0)
                box.delete(oc)
                oc := box.new(x1, O0, 2 * x1 - x11 - 1, C0, color01, _width, line.style_solid , extend.none, xloc.bar_index, color0)
                true
            else
                box.set_top(hl, H0)
                box.set_bottom(hl, L0)
                box.set_bgcolor(hl, color0)
                box.set_border_color(hl, color01)

                box.set_top(oc, math.max(O0, C0))
                box.set_bottom(oc, math.min(O0, C0))
                box.set_bgcolor(oc, color0)
                box.set_border_color(oc, color01)
                true

        if _mini
            if ta.change(time(_htf)) != 0
                array.push(_a_hst, H1)
                array.push(_a_lst, L1)

            if _hcount > 0
                f_drawCandle(bar_index + _offset, O0, H0, L0, C0, O0 < C0 ? _bullC : _bearC, _htf, f_getTooltip(O0, H0, L0, C0, C1, _atr, _atrM) )
            if _hcount > 1
                f_drawCandle(bar_index + _offset - 1, O1, H1, L1, C1, O1 < C1 ? _bullC : _bearC, '', f_getTooltip(O1, H1, L1, C1, ta.valuewhen(ta.change(C1) != 0, C1, 1), ta.valuewhen(ta.change(_atr) != 0, _atr, 1), _atrM) )
            if _hcount > 2
                [Ox , Hx , Lx , Cx, Ax] = f_getOHLC(O1 , H1 , L1 , C1, _atr, 1)
                f_drawCandle(bar_index + _offset - 2, Ox, Hx, Lx, Cx, Ox < Cx ? _bullC : _bearC, '', f_getTooltip(Ox, Hx, Lx, Cx, Cx, Ax, _atrM) )
            if _hcount > 3
                [Ox , Hx , Lx , Cx, Ax] = f_getOHLC(O1 , H1 , L1 , C1, _atr, 2)
                f_drawCandle(bar_index + _offset - 3, Ox, Hx, Lx, Cx, Ox < Cx ? _bullC : _bearC, '', f_getTooltip(Ox, Hx, Lx, Cx, Cx, Ax, _atrM) )
            if _hcount > 4
                [Ox , Hx , Lx , Cx, Ax] = f_getOHLC(O1 , H1 , L1 , C1, _atr, 3)
                f_drawCandle(bar_index + _offset - 4, Ox, Hx, Lx, Cx, Ox < Cx ? _bullC : _bearC, '', f_getTooltip(Ox, Hx, Lx, Cx, Cx, Ax, _atrM) )
            if _hcount > 5
                [Ox , Hx , Lx , Cx, Ax] = f_getOHLC(O1 , H1 , L1 , C1, _atr, 4)
                f_drawCandle(bar_index + _offset - 5, Ox, Hx, Lx, Cx, Ox < Cx ? _bullC : _bearC, '', f_getTooltip(Ox, Hx, Lx, Cx, Cx, Ax, _atrM) )
            if _hcount > 6
                [Ox , Hx , Lx , Cx, Ax] = f_getOHLC(O1 , H1 , L1 , C1, _atr, 5)
                f_drawCandle(bar_index + _offset - 6, Ox, Hx, Lx, Cx, Ox < Cx ? _bullC : _bearC, '', f_getTooltip(Ox, Hx, Lx, Cx, Cx, Ax, _atrM) )
            if _hcount > 7
                [Ox , Hx , Lx , Cx, Ax] = f_getOHLC(O1 , H1 , L1 , C1, _atr, 6)
                f_drawCandle(bar_index + _offset - 7, Ox, Hx, Lx, Cx, Ox < Cx ? _bullC : _bearC, '', f_getTooltip(Ox, Hx, Lx, Cx, Cx, Ax, _atrM) )
            if _hcount > 8
                [Ox , Hx , Lx , Cx, Ax] = f_getOHLC(O1 , H1 , L1 , C1, _atr, 7)
                f_drawCandle(bar_index + _offset - 8, Ox, Hx, Lx, Cx, Ox < Cx ? _bullC : _bearC, '', f_getTooltip(Ox, Hx, Lx, Cx, Cx, Ax, _atrM) )
            if _hcount > 9
                [Ox , Hx , Lx , Cx, Ax] = f_getOHLC(O1 , H1 , L1 , C1, _atr, 8)
                f_drawCandle(bar_index + _offset - 9, Ox, Hx, Lx, Cx, Ox < Cx ? _bullC : _bearC, '', f_getTooltip(Ox, Hx, Lx, Cx, Cx, Ax, _atrM) )

f_processAssistanceLines(_assist, _x2_offset, _size, _length, _htf, _a_hst, _a_lst, _cndl) =>
    bar_indexX = ta.valuewhen(ta.change(time(_htf)) != 0, bar_index, _length - 1)

    int qty = array.size(_a_hst)
    if qty > _length - 1
        array.remove(_a_hst, 0)
        array.remove(_a_lst, 0)

    [_, _, _, _, _, H0 , L0 , _] = f_htf_ohlc(_htf)
    [_, _, _, _, _, hH0, hL0, _] = f_haTicker(_htf)

    H0 := _cndl == 'Heikin Ashi' ? hH0 : H0
    L0 := _cndl == 'Heikin Ashi' ? hL0 : L0

    H = math.max(array.max(_a_hst), H0)
    L = math.min(array.min(_a_lst), L0)

    if _assist == 'Range' and L != 0
        f_drawAssistLineLableX(bar_indexX, H, bar_index + _x2_offset + 1, #787b86, 'H', _size)
        f_drawAssistLineLableX(bar_indexX, L, bar_index + _x2_offset + 1, #787b86, 'L', _size)

    else if (_assist == 'Fib Levels' or _assist == 'Reverse Fib Levels') and L != 0
        diff = _assist == 'Fib Levels' ? H - L : L - H
        base = _assist == 'Fib Levels' ? L : H
        
        f_drawAssistLineLableX(bar_indexX, base + diff * 0.00, bar_index + _x2_offset + 1, #787b86, '0.00%'  , _size)
        f_drawAssistLineLableX(bar_indexX, base + diff * .236, bar_index + _x2_offset + 1, #f44336, '23.60%' , _size)
        f_drawAssistLineLableX(bar_indexX, base + diff * .382, bar_index + _x2_offset + 1, #81c784, '38.20%' , _size)
        f_drawAssistLineLableX(bar_indexX, base + diff * .500, bar_index + _x2_offset + 1, #4caf50, '50.00%' , _size)
        f_drawAssistLineLableX(bar_indexX, base + diff * .618, bar_index + _x2_offset + 1, #009688, '61.80%' , _size)
        f_drawAssistLineLableX(bar_indexX, base + diff * .786, bar_index + _x2_offset + 1, #64b5f6, '78.60%' , _size)
        f_drawAssistLineLableX(bar_indexX, base + diff * 1.00, bar_index + _x2_offset + 1, #787b86, '100.00%', _size)

    [H, L]

// ---------------------------------------------------------------------------------------------- //
// Customizable Inputs for HTF Candles
// ---------------------------------------------------------------------------------------------- //

htf_group_candle = 'HTF Candle & Mini Chart Settings'

htfCndl1  = input.bool(true, '1st HTF Candle', inline='TYP', group=htf_group_candle)
cndlType1 = input.string('Standart', '', options=['Standart', 'Heikin Ashi'], inline='TYP', group=htf_group_candle)
htfUser1  = input.string('1 Hour', 'TF', options=['3 Mins', '5 Mins', '10 Mins', '15 Mins', '30 Mins', '45 Mins', '1 Hour', '2 Hours', '3 Hours', '4 Hours', '1 Day', '1 Week', '1 Month', '3 Months', '6 Months', '1 Year'], inline='TYP', group=htf_group_candle)

htfCndl2  = input.bool(true, '2nd HTF Candle', inline='TYP3', group=htf_group_candle)
cndlType2 = input.string('Standart', '', options=['Standart', 'Heikin Ashi'], inline='TYP3', group=htf_group_candle)
htfUser2  = input.string('4 Hours', 'TF', options=['3 Mins', '5 Mins', '10 Mins', '15 Mins', '30 Mins', '45 Mins', '1 Hour', '2 Hours', '3 Hours', '4 Hours', '1 Day', '1 Week', '1 Month', '3 Months', '6 Months', '1 Year'], inline='TYP3', group=htf_group_candle)

bullC     = input.color(#26a69a, 'Candle : Bull', inline='CNDL', group=htf_group_candle)
bearC     = input.color(#ef5350, 'Bear', inline='CNDL', group=htf_group_candle)
trans     = input.int(85, 'Transp', inline='CNDL', minval=65, maxval=95, group=htf_group_candle)
cndlAlarm = input.bool(false, 'Enable Candle Alerts', group=htf_group_candle)

htf_group_mini = 'HTF Mini Chart Settings'
mChart     = input.bool(true, 'Enable HTF Mini Chart(s) Display', inline='mini', group=htf_group_mini)

count1     = input.int(3, 'Number of Bars : 1st', minval=1, maxval=17, inline='TYP1', group=htf_group_mini)
count2     = input.int(2, '2nd', minval=1, maxval=17, inline='TYP1', group=htf_group_mini)

assist1    = input.string('Range', 'Assistant Lines : 1st', options=['Range', 'Fib Levels', 'Reverse Fib Levels', 'None'], inline='asis', group=htf_group_mini)
assist2    = input.string('Range', '2nd', options=['Range', 'Fib Levels', 'Reverse Fib Levels', 'None'], inline='asis', group=htf_group_mini)

assistSize = input.string('Small', 'Text Size', options=['Small', 'Normal', 'Large'], inline='oth', group=htf_group_mini)
textSiz    = assistSize == 'Small' ? size.small : assistSize == 'Normal' ? size.normal : size.large
mOffset    = input.int(0, 'Horizontal Offset', minval=-3, maxval=25, inline='oth', group=htf_group_mini)

disableMum = input.bool(false, 'Disable HTF Candle(s) Display', group=htf_group_mini)

// ---------------------------------------------------------------------------------------------- //
// HTF Candles Processing
// ---------------------------------------------------------------------------------------------- //

htf1       = f_getTF(htfUser1)
htf2       = f_getTF(htfUser2)
htfOffset1 = 23 + mOffset
htfOffset2 = 47 + mOffset

supported1 = checkIf(timeframe.period, htf1)
supported2 = checkIf(timeframe.period, htf2)

var a_hst1 = array.new_float()
var a_lst1 = array.new_float()
var a_hst2 = array.new_float()
var a_lst2 = array.new_float()

if chart.is_standard
    if supported1
        f_processCandles(htfCndl1, htf1, cndlType1, bullC, bearC, trans, 34, 1, mChart, htfOffset1, f_atr(14, htf1), 1.5, count1, a_hst1, a_lst1, disableMum)
    
    if supported2
        f_processCandles(htfCndl2, htf2, cndlType2, bullC, bearC, 100, 0, 2, mChart, htfOffset2, f_atr(14, htf2), 1.5, count2, a_hst2, a_lst2, disableMum)

if supported1
    [priceHighest1, priceLowest1] = f_processAssistanceLines(assist1, htfOffset1, textSiz, count1, htf1, a_hst1, a_lst1, cndlType1)

if supported2
    [priceHighest2, priceLowest2] = f_processAssistanceLines(assist2, htfOffset2, textSiz, count2, htf2, a_hst2, a_lst2, cndlType2)

// ================================================================================================
// PART 2: CANDLE Dashboard + Bollinger Bands + Parabolic SAR
// ================================================================================================

// =======================
// PARABOLIC SAR SETTINGS
// =======================
show_psar = input.bool(true, "Show Parabolic SAR", group="Parabolic SAR")
psar_start = input.float(0.02, "PSAR Start", minval=0.001, maxval=0.1, step=0.001, group="Parabolic SAR")
psar_increment = input.float(0.02, "PSAR Increment", minval=0.001, maxval=0.1, step=0.001, group="Parabolic SAR")
psar_maximum = input.float(0.2, "PSAR Maximum", minval=0.1, maxval=1.0, step=0.01, group="Parabolic SAR")
psar_color_bullish = input.color(color.green, "Bullish PSAR Color", group="Parabolic SAR")
psar_color_bearish = input.color(color.red, "Bearish PSAR Color", group="Parabolic SAR")
psar_size = input.int(2, "PSAR Size", minval=1, maxval=5, group="Parabolic SAR")

psar = ta.sar(psar_start, psar_increment, psar_maximum)
psar_trend = psar < close ? 1 : -1

plot(show_psar and psar_trend == 1 ? psar : na, title="Bullish PSAR", color=psar_color_bullish, linewidth=psar_size, style=plot.style_circles, display=display.all)
plot(show_psar and psar_trend == -1 ? psar : na, title="Bearish PSAR", color=psar_color_bearish, linewidth=psar_size, style=plot.style_circles, display=display.all)

// =======================
// BOLLINGER BANDS SETTINGS
// =======================
show_bb = input.bool(true, "Show Bollinger Bands", group="Bollinger Bands")
bb_length = input.int(20, "BB Length", minval=1, group="Bollinger Bands")
bb_stddev = input.float(2.0, "BB StdDev", minval=0.1, maxval=5.0, step=0.1, group="Bollinger Bands")
bb_source = input(close, "BB Source", group="Bollinger Bands")
bb_offset = input.int(0, "BB Offset", minval=-500, maxval=500, group="Bollinger Bands")
bb_ma_type = input.string("SMA", "BB MA Type", options=["SMA", "EMA"], group="Bollinger Bands")

bb_color = input.color(color.blue, "BB Color", group="Bollinger Bands")
bb_linewidth = input.int(1, "BB Line Width", minval=1, maxval=5, group="Bollinger Bands")
bb_fill_color = input.color(color.new(color.blue, 90), "BB Fill Color", group="Bollinger Bands")

bb_basis = bb_ma_type == "SMA" ? ta.sma(bb_source, bb_length) : ta.ema(bb_source, bb_length)
bb_dev = ta.stdev(bb_source, bb_length) * bb_stddev
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev

bb_basis_plot = plot(show_bb ? bb_basis : na, "BB Basis", color=bb_color, linewidth=bb_linewidth, offset=bb_offset)
bb_upper_plot = plot(show_bb ? bb_upper : na, "BB Upper", color=bb_color, linewidth=bb_linewidth, offset=bb_offset)
bb_lower_plot = plot(show_bb ? bb_lower : na, "BB Lower", color=bb_color, linewidth=bb_linewidth, offset=bb_offset)

fill(bb_upper_plot, bb_lower_plot, color=show_bb ? bb_fill_color : na, title="BB Fill")

// =======================
// SESSION BACKGROUND SETTINGS
// =======================
bgColor = input.bool(true, "Activate Session Background", tooltip="Enable/disable session background coloring", group="Session Background")

london_color_input = input.color(color.green, "London Session Color", group="Session Background")
ny_color_input     = input.color(color.red, "New York Session Color", group="Session Background")
tokyo_color_input   = input.color(color.yellow, "Tokyo Session Color", group="Session Background")
sydney_color_input  = input.color(color.blue, "Sydney Session Color", group="Session Background")

London = input.bool(true, "London Session", tooltip="Show London session", group="Session Background")
NY     = input.bool(true, "New York Session", tooltip="Show New York session", group="Session Background")
Tokyo  = input.bool(true, "Tokyo Session", tooltip="Show Tokyo session", group="Session Background")
Sydney = input.bool(true, "Sydney Session", tooltip="Show Sydney session", group="Session Background")

session_opacity = input.int(90, "Session Background Transparency (0 = opaque, 100 = transparent)", minval=0, maxval=100, group="Session Background")

res = input.timeframe("D", "Resolution", options=["D","W","M"], tooltip="Resolution for session calculations", group="Session Background")
london_sess = input.session("0300-0800:1234567", "London Session Hours", tooltip="London trading session hours", group="Session Background")
ny_sess     = input.session("0900-1700:1234567", "New York Session Hours", tooltip="New York trading session hours", group="Session Background")
tokyo_sess  = input.session("2100-0300:1234567", "Tokyo Session Hours", tooltip="Tokyo trading session hours", group="Session Background")
sydney_sess = input.session("0900-1200:1234567", "Sydney Session Hours", tooltip="Sydney session hours", group="Session Background")

is_session(sess) =>
    not na(time(timeframe.period, sess, "America/New_York"))

londonSession = is_session(london_sess)
nySession     = is_session(ny_sess)
tokyoSession  = is_session(tokyo_sess)
sydneySession = is_session(sydney_sess)

london_bg = color.new(london_color_input, session_opacity)
ny_bg     = color.new(ny_color_input, session_opacity)
tokyo_bg  = color.new(tokyo_color_input, session_opacity)
sydney_bg = color.new(sydney_color_input, session_opacity)

bgcolor(londonSession and London and bgColor ? london_bg : na)
bgcolor(nySession and NY and bgColor ? ny_bg : na)
bgcolor(tokyoSession and Tokyo and bgColor ? tokyo_bg : na)
bgcolor(sydneySession and Sydney and bgColor ? sydney_bg : na)

// =======================
// MANIPULATION CANDLE DETECTION
// =======================
manipBuy = high > high[1] and low < low[1] and close > high[1]
manipSell = high > high[1] and low < low[1] and close < low[1]

// Plot candle color override for manipulation
barcolor(manipBuy or manipSell ? color.white : na)

if manipBuy
    label.new(bar_index, high, "Manipulation Buy", style=label.style_label_up, color=color.white, textcolor=color.black, size=size.tiny)
if manipSell
    label.new(bar_index, low, "Manipulation Sell", style=label.style_label_down, color=color.white, textcolor=color.black, size=size.tiny)

// =======================
// MA TYPE SELECTION
// =======================
ma_type = input.string("EMA", "MA Type", options=["EMA", "SMA"], tooltip="Choose between EMA or SMA", group="Moving Averages")

ma(series, length) =>
    if ma_type == "EMA"
        ta.ema(series, length)
    else
        ta.sma(series, length)

// =======================
// CUSTOM MA 200 SETTINGS
// =======================
ma200_len = input.int(200, "MA 200 Length", minval=1, tooltip="Length for MA 200", group="Moving Averages")
ma200_src = input(close, "MA 200 Source", tooltip="Source for MA 200", group="Moving Averages")
ma200_offset = input.int(0, "MA 200 Offset", minval=-500, maxval=500, tooltip="Offset for MA 200", group="Moving Averages")
show_ma200 = input.bool(true, "Show MA 200", tooltip="Show/Hide MA 200", group="Moving Averages")
ma200_color = input.color(color.purple, "MA 200 Color", tooltip="Color for MA 200 line", group="Moving Averages")
ma200_width = input.int(2, "MA 200 Width", minval=1, maxval=5, tooltip="Width for MA 200 line", group="Moving Averages")

ma200 = ma(ma200_src, ma200_len)
plot(show_ma200 ? ma200 : na, "MA 200", color=ma200_color, linewidth=ma200_width, offset=ma200_offset, display=display.all)

// =======================
// EMA 50 SETTINGS
// =======================
len = input.int(50, "EMA 50 Length", minval=1, tooltip="Length for main EMA", group="Moving Averages")
src = input(close, "MA Source", tooltip="Source for all MAs", group="Moving Averages")
offset = input.int(0, "MA Offset", minval=-500, maxval=500, tooltip="Offset for all MAs", group="Moving Averages")

out = ma(src, len)
plot(out, "MA 50 Close", color=color.blue, linewidth=2, display=display.all)

ema50Low = ma(low, 50)
ema50High = ma(high, 50)

plot(ema50Low, "MA 50 Low", color=color.orange, linewidth=2, display=display.all)
plot(ema50High, "MA 50 High", color=color.orange, linewidth=2, display=display.all)

// =======================
// H4 CANDLE ANALYSIS
// =======================
[h4_open, h4_high, h4_low, h4_close,
 h4_open_prev, h4_high_prev, h4_low_prev, h4_close_prev,
 h4_open_prev2, h4_high_prev2, h4_low_prev2, h4_close_prev2] = request.security(syminfo.tickerid, "240", [open, high, low, close, open[1], high[1], low[1], close[1], open[2], high[2], low[2], close[2]])

body_size_h4_prev = math.abs(h4_close_prev - h4_open_prev)
total_range_h4_prev = h4_high_prev - h4_low_prev
body_ratio_h4_prev = total_range_h4_prev > 0 ? body_size_h4_prev / total_range_h4_prev : 0

upper_wick_h4_prev = h4_close_prev > h4_open_prev ? h4_high_prev - h4_close_prev : h4_high_prev - h4_open_prev
lower_wick_h4_prev = h4_close_prev > h4_open_prev ? h4_open_prev - h4_low_prev : h4_close_prev - h4_low_prev

is_doji_h4_prev = body_ratio_h4_prev <= 0.2
is_upper_rejection_h4_prev = upper_wick_h4_prev > body_size_h4_prev * 1.0 and lower_wick_h4_prev < upper_wick_h4_prev
is_lower_rejection_h4_prev = lower_wick_h4_prev > body_size_h4_prev * 1.0 and upper_wick_h4_prev < lower_wick_h4_prev
is_full_body_h4_prev = body_ratio_h4_prev >= 0.6

h4_candle_status = if is_doji_h4_prev
    "DOJI"
else if is_upper_rejection_h4_prev
    "REJECTION ▼"
else if is_lower_rejection_h4_prev
    "REJECTION ▲"
else if is_full_body_h4_prev
    "FULL BODY"
else
    "-"

get_h4_status_color(status) =>
    if status == "REJECTION ▼"
        color.red
    else if status == "REJECTION ▲"
        color.green
    else if status == "DOJI"
        color.purple
    else if status == "FULL BODY"
        color.blue
    else
        color.gray

// =======================
// H1 CANDLE ANALYSIS
// =======================
[h1_open_prev, h1_high_prev, h1_low_prev, h1_close_prev] = request.security(syminfo.tickerid, "60", [open[1], high[1], low[1], close[1]])

body_size_h1_prev = math.abs(h1_close_prev - h1_open_prev)
total_range_h1_prev = h1_high_prev - h1_low_prev
body_ratio_h1_prev = total_range_h1_prev > 0 ? body_size_h1_prev / total_range_h1_prev : 0

upper_wick_h1_prev = h1_close_prev > h1_open_prev ? h1_high_prev - h1_close_prev : h1_high_prev - h1_open_prev
lower_wick_h1_prev = h1_close_prev > h1_open_prev ? h1_open_prev - h1_low_prev : h1_close_prev - h1_low_prev

is_doji_h1_prev = body_ratio_h1_prev <= 0.2
is_upper_rejection_h1_prev = upper_wick_h1_prev > body_size_h1_prev * 1.0 and lower_wick_h1_prev < upper_wick_h1_prev
is_lower_rejection_h1_prev = lower_wick_h1_prev > body_size_h1_prev * 1.0 and upper_wick_h1_prev < lower_wick_h1_prev
is_full_body_h1_prev = body_ratio_h1_prev >= 0.6

h1_candle_status = if is_doji_h1_prev
    "DOJI"
else if is_upper_rejection_h1_prev
    "REJECTION ▼"
else if is_lower_rejection_h1_prev
    "REJECTION ▲"
else if is_full_body_h1_prev
    "FULL BODY"
else
    "-"

get_h1_status_color(status) =>
    if status == "REJECTION ▼"
        color.red
    else if status == "REJECTION ▲"
        color.green
    else if status == "DOJI"
        color.purple
    else if status == "FULL BODY"
        color.blue
    else
        color.gray

// =======================
// PREVIOUS CANDLE TREND
// =======================
prev_candle_above_ma50 = close[1] > out[1]
prev_candle_below_ma50 = close[1] < out[1]

prev_trend_text = if prev_candle_above_ma50
    "BULL"
else if prev_candle_below_ma50
    "BEAR"
else
    "-"

prev_trend_color = if prev_candle_above_ma50
    color.green
else if prev_candle_below_ma50
    color.red
else
    color.gray

// =======================
// DASHBOARD
// =======================
show_dashboard = input.bool(true, "Show Dashboard", group="Dashboard Settings")
dashboard_position = input.string("top.right", "Dashboard Position", options=["top.right", "top.left", "bottom.right", "bottom.left"], group="Dashboard Settings")
dashboard_text_size = input.string("small", "Text Size", options=["tiny", "small", "normal", "large"], group="Dashboard Settings")

get_table_text_size(size_str) =>
    if size_str == "tiny"
        size.tiny
    else if size_str == "small"
        size.small
    else if size_str == "normal"
        size.normal
    else
        size.large

if show_dashboard and barstate.islast
    table_pos = position.top_right
    if dashboard_position == "top.left"
        table_pos := position.top_left
    else if dashboard_position == "bottom.right"
        table_pos := position.bottom_right
    else if dashboard_position == "bottom.left"
        table_pos := position.bottom_left

    var table single_col_dash = table.new(position=table_pos, columns=1, rows=4, bgcolor=color.new(color.gray, 90), border_width=1)
    table_text_size = get_table_text_size(dashboard_text_size)

    table.cell(single_col_dash, 0, 0, "STATUS", bgcolor=color.orange, text_color=color.white, text_size=table_text_size)
    table.cell(single_col_dash, 0, 1, h4_candle_status, bgcolor=get_h4_status_color(h4_candle_status), text_color=color.white, text_size=table_text_size)
    table.cell(single_col_dash, 0, 2, h1_candle_status, bgcolor=get_h1_status_color(h1_candle_status), text_color=color.white, text_size=table_text_size)
    table.cell(single_col_dash, 0, 3, prev_trend_text, bgcolor=prev_trend_color, text_color=color.white, text_size=table_text_size)

// =======================
// ALERT CONDITIONS
// =======================

h4_special_status = h4_candle_status == "DOJI" or str.contains(h4_candle_status, "REJECTION")
h1_special_status = h1_candle_status == "DOJI" or str.contains(h1_candle_status, "REJECTION")
h4_h1_special_condition = h4_special_status and h1_special_status

alertcondition(h4_h1_special_condition, title="H4 & H1 Special Pattern", message="H4 and H1 both show DOJI or REJECTION patterns!")

psar_flip_bullish = psar_trend == 1 and psar_trend[1] == -1
psar_flip_bearish = psar_trend == -1 and psar_trend[1] == 1
psar_flip = psar_flip_bullish or psar_flip_bearish

ma50_confirmation = close > out

h4_h1_psar_ma_condition = h4_special_status and h1_special_status and psar_flip and ma50_confirmation

alertcondition(h4_h1_psar_ma_condition, title="H4/H1 Special + PSAR Flip + MA50 Confirmation", message="H4 and H1 special patterns with PSAR flip and MA50 confirmation!")

// =======================
// PARABOLIC SAR ALERTS
// =======================
psar_bullish_reversal = show_psar and psar_trend == 1 and psar_trend[1] == -1
alertcondition(psar_bullish_reversal, title="PSAR Bullish Reversal", message="Parabolic SAR has switched to bullish (trend reversal up)!")

psar_bearish_reversal = show_psar and psar_trend == -1 and psar_trend[1] == 1
alertcondition(psar_bearish_reversal, title="PSAR Bearish Reversal", message="Parabolic SAR has switched to bearish (trend reversal down)!")

price_cross_above_psar = show_psar and close > psar and close[1] <= psar[1]
alertcondition(price_cross_above_psar, title="Price Cross Above PSAR", message="Price has crossed above the Parabolic SAR!")

price_cross_below_psar = show_psar and close < psar and close[1] >= psar[1]
alertcondition(price_cross_below_psar, title="Price Cross Below PSAR", message="Price has crossed below the Parabolic SAR!")

price_touches_psar = show_psar and high >= psar and low <= psar
alertcondition(price_touches_psar, title="Price Touches PSAR", message="Price has touched the Parabolic SAR level!")

// =======================
// MA CROSSING ALERTS
// =======================
price_touches_ma50_from_above = high >= out and low <= out and low[1] > out[1]
alertcondition(price_touches_ma50_from_above, title="Price Touches MA 50 From Above", message="Price has touched the MA 50 from above (resistance test)!")

price_touches_ma50_from_below = high >= out and low <= out and high[1] < out[1]
alertcondition(price_touches_ma50_from_below, title="Price Touches MA 50 From Below", message="Price has touched the MA 50 from below (support test)!")

high_touches_ma50 = high >= out and high[1] < out[1]
alertcondition(high_touches_ma50, title="High Touches MA 50", message="High has touched or crossed above the MA 50!")

low_touches_ma50 = low <= out and low[1] > out[1]
alertcondition(low_touches_ma50, title="Low Touches MA 50", message="Low has touched or crossed below the MA 50!")

price_cross_above_ma50 = ta.crossover(close, out)
alertcondition(price_cross_above_ma50, title="Close Cross Above MA 50", message="Close price has crossed above the MA 50!")

price_cross_below_ma50 = ta.crossunder(close, out)
alertcondition(price_cross_below_ma50, title="Close Cross Below MA 50", message="Close price has crossed below the MA 50!")

// =======================
// MA 200 CROSSING ALERTS
// =======================
price_touches_ma200_from_above = show_ma200 and high >= ma200 and low <= ma200 and low[1] > ma200[1]
alertcondition(price_touches_ma200_from_above, title="Price Touches MA 200 From Above", message="Price has touched the MA 200 from above (resistance test)!")

price_touches_ma200_from_below = show_ma200 and high >= ma200 and low <= ma200 and high[1] < ma200[1]
alertcondition(price_touches_ma200_from_below, title="Price Touches MA 200 From Below", message="Price has touched the MA 200 from below (support test)!")

high_touches_ma200 = show_ma200 and high >= ma200 and high[1] < ma200[1]
alertcondition(high_touches_ma200, title="High Touches MA 200", message="High has touched or crossed above the MA 200!")

low_touches_ma200 = show_ma200 and low <= ma200 and low[1] > ma200[1]
alertcondition(low_touches_ma200, title="Low Touches MA 200", message="Low has touched or crossed below the MA 200!")

price_cross_above_ma200 = show_ma200 and ta.crossover(close, ma200)
alertcondition(price_cross_above_ma200, title="Close Cross Above MA 200", message="Close price has crossed above the MA 200!")

price_cross_below_ma200 = show_ma200 and ta.crossunder(close, ma200)
alertcondition(price_cross_below_ma200, title="Close Cross Below MA 200", message="Close price has crossed below the MA 200!")

ma50_cross_above_ma200 = show_ma200 and ta.crossover(out, ma200)
alertcondition(ma50_cross_above_ma200, title="MA 50 Cross Above MA 200", message="MA 50 has crossed above MA 200 (Golden Cross)!")

ma50_cross_below_ma200 = show_ma200 and ta.crossunder(out, ma200)
alertcondition(ma50_cross_below_ma200, title="MA 50 Cross Below MA 200", message="MA 50 has crossed below MA 200 (Death Cross)!")

// =======================
// BOLLINGER BANDS ALERTS
// =======================
price_touches_bb_upper = show_bb and high >= bb_upper and high[1] < bb_upper[1]
alertcondition(price_touches_bb_upper, title="Price Touches BB Upper", message="Price has touched or crossed above the Upper Bollinger Band!")

price_touches_bb_lower = show_bb and low <= bb_lower and low[1] > bb_lower[1]
alertcondition(price_touches_bb_lower, title="Price Touches BB Lower", message="Price has touched or crossed below the Lower Bollinger Band!")

price_above_bb_upper = show_bb and close > bb_upper
price_below_bb_lower = show_bb and close < bb_lower
alertcondition(price_above_bb_upper, title="Price Above BB Upper", message="Price is above Upper Bollinger Band (overbought signal)!")
alertcondition(price_below_bb_lower, title="Price Below BB Lower", message="Price is below Lower Bollinger Band (oversold signal)!")

bb_squeeze = show_bb and (bb_upper - bb_lower) < (bb_upper[1] - bb_lower[1]) * 0.9
alertcondition(bb_squeeze, title="BB Squeeze Detected", message="Bollinger Bands are squeezing (low volatility period)!")

bb_expand = show_bb and (bb_upper - bb_lower) > (bb_upper[1] - bb_lower[1]) * 1.1
alertcondition(bb_expand, title="BB Expansion Detected", message="Bollinger Bands are expanding (high volatility period)!")

// =======================
// TWO CANDLE THEORY
// =======================
show_prev_range = input.bool(true, "Show Previous Range", group="Two Candle Theory")
prev_range_color = input.color(color.blue, "Previous Range Color", group="Two Candle Theory")
show_thirds = input.bool(true, "Show Thirds", group="Two Candle Theory")
thirds_color = input.color(color.gray, "Thirds Color", group="Two Candle Theory", inline="thirds")
thirds_opacity = input.int(70, "Thirds Opacity", minval=0, maxval=100, group="Two Candle Theory", inline="thirds")

high_third = high - (high - low) / 3
low_third = low + (high - low) / 3

get_close_position() =>
    if close >= high_third
        "High Close"
    else if close <= low_third
        "Low Close"
    else
        "Mid Close"

get_close_comparison() =>
    prev_high = high[1]
    prev_low = low[1]
    
    if close > prev_high
        "Bull Candle"
    else if close < prev_low
        "Bear Candle"
    else
        "Range Candle"

close_position = get_close_position()
close_comparison = get_close_comparison()

get_bias_color(close_pos, close_comp) =>
    if close_comp == "Bull Candle"
        if close_pos == "High Close"
            color.green
        else if close_pos == "Mid Close"
            color.lime
        else
            color.olive
    else if close_comp == "Range Candle"
        if close_pos == "High Close"
            color.silver
        else if close_pos == "Mid Close"
            color.gray
        else
            color.silver
    else // Bear Candle
        if close_pos == "High Close"
            color.maroon
        else if close_pos == "Mid Close"
            color.red
        else
            color.purple

get_strength_text(close_pos, close_comp) =>
    if close_comp == "Bull Candle"
        if close_pos == "High Close"
            "Bullish Ekstrem"
        else if close_pos == "Mid Close"
            "Bullish"
        else
            "Bullish Lemah"
    else if close_comp == "Range Candle"
        if close_pos == "High Close"
            "Sideways Bullish"
        else if close_pos == "Mid Close"
            "Netral"
        else
            "Sideways Bearish"
    else // Bear Candle
        if close_pos == "High Close"
            "Bearish Lemah"
        else if close_pos == "Mid Close"
            "Bearish"
        else
            "Bearish Ekstrem"

bias_color = get_bias_color(close_position, close_comparison)
strength = get_strength_text(close_position, close_comparison)

prev_close_position = get_close_position()[1]
prev_close_comparison = get_close_comparison()[1]
prev_bias_color = get_bias_color(prev_close_position, prev_close_comparison)

if show_prev_range and barstate.isconfirmed
    box.new(bar_index[1], high[1], bar_index, low[1], border_color=prev_range_color, border_width=1, bgcolor=color.new(prev_range_color, 90), extend=extend.none)

if show_thirds and barstate.isconfirmed
    line.new(bar_index, high_third[1], bar_index[1], high_third[1], color=color.new(thirds_color, thirds_opacity), width=1, style=line.style_dashed)
    line.new(bar_index, low_third[1], bar_index[1], low_third[1], color=color.new(thirds_color, thirds_opacity), width=1, style=line.style_dashed)

two_candle_text_size = input.string("small", "Two Candle Label Size", options=["tiny", "small", "normal", "large"], group="Two Candle Theory")
label_size = two_candle_text_size == "tiny" ? size.tiny : two_candle_text_size == "small" ? size.small : two_candle_text_size == "normal" ? size.normal : size.large

if barstate.islast
    label.new(bar_index, na, text="Current: " + close_position + "\n" + close_comparison + "\n" + strength, color=bias_color, textcolor=color.white, style=label.style_label_center, yloc=yloc.abovebar, size=label_size)
    label.new(bar_index[1], na, text="Prev: " + prev_close_position + "\n" + prev_close_comparison, color=prev_bias_color, textcolor=color.white, style=label.style_label_center, yloc=yloc.belowbar, size=label_size)

alertcondition(close_comparison == "Bull Candle" and close_position == "High Close", title="High Close Bull Candle", message="High Close Bull Candle Detected!")
alertcondition(close_comparison == "Bear Candle" and close_position == "Low Close", title="High Close Bear Candle", message="High Close Bear Candle Detected!")

// =======================
// FILTER WICKLESS CANDLES - YELLOW COLOR
// =======================
// Bullish with no lower wick (low >= open)
bullish_wickless = close > open and low >= open
// Bearish with no upper wick (high <= open)
bearish_wickless = close < open and high <= open

// Apply yellow color for wickless candles (overrides manipulation color if both true)
// Using barcolor with a higher priority than the manipulation color
barcolor(bullish_wickless or bearish_wickless ? color.yellow : manipBuy or manipSell ? color.white : na)

// Optional: Add labels to identify wickless candles (only on last bar to avoid clutter)
if bullish_wickless and barstate.islast
    label.new(bar_index, high, "No Lower Wick", style=label.style_label_up, color=color.yellow, textcolor=color.black, size=size.tiny)

if bearish_wickless and barstate.islast
    label.new(bar_index, low, "No Upper Wick", style=label.style_label_down, color=color.yellow, textcolor=color.black, size=size.tiny)

// Simple Logo
var table logo = table.new(position.bottom_right, 1, 1)
if barstate.islast
    table.cell(logo, 0, 0, '☼☾  ', text_size=size.normal, text_color=color.teal)
