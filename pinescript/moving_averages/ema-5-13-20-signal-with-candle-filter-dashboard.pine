//@version=6
indicator("EMA 5 / 13 / 20 Signal with Candle Filter + Dashboard", overlay=true)

// =========================
// EMA SETTINGS
// =========================
ema5  = ta.ema(close, 5)
ema13 = ta.ema(close, 13)
ema20 = ta.ema(close, 20)

// Plot EMAs
plot(ema5,  title="EMA 5",  color=color.blue, linewidth=2)
plot(ema13, title="EMA 13", color=color.orange, linewidth=2)
plot(ema20, title="EMA 20", color=color.green, linewidth=2)

// =========================
// CANDLE CALCULATIONS
// =========================
body = math.abs(close - open)
candleRange = high - low

upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low

bodyPercent = candleRange > 0 ? body / candleRange : 0

// Candle filters
strongBody = bodyPercent > 0.5
doji = bodyPercent < 0.2

// Pin bars
bullPin = lowerWick > body * 2 and upperWick < body
bearPin = upperWick > body * 2 and lowerWick < body

// =========================
// CROSS CONDITIONS
// =========================
crossUp = ta.crossover(ema5, ema13)
crossDown = ta.crossunder(ema5, ema13)

// =========================
// BUY / SELL CONDITIONS
// =========================
buyCondition =
     crossUp and
     close > ema20 and
     strongBody and
     not doji and
     not bearPin

sellCondition =
     crossDown and
     close < ema20 and
     strongBody and
     not doji and
     not bullPin

// =========================
// SIGNAL COLORS
// =========================
textColor = chart.fg_color

// =========================
// SIGNAL PLOTS
// =========================
plotshape(
     buyCondition,
     title="BUY",
     location=location.belowbar,
     style=shape.labelup,
     color=color.lime,
     text="BUY",
     textcolor=textColor,
     size=size.small)

plotshape(
     sellCondition,
     title="SELL",
     location=location.abovebar,
     style=shape.labeldown,
     color=color.red,
     text="SELL",
     textcolor=textColor,
     size=size.small)

// =========================
// ALERTS
// =========================
alertcondition(
     buyCondition,
     title="BUY Signal",
     message="BUY: EMA5 crossed above EMA13 and candle closed above EMA20")

alertcondition(
     sellCondition,
     title="SELL Signal",
     message="SELL: EMA5 crossed below EMA13 and candle closed below EMA20")

// =========================
// DASHBOARD
// =========================
var table dashboard = table.new(position.top_right, 2, 6, border_width=1)

if barstate.islast
    table.cell(dashboard, 0, 0, "Condition", text_color=color.white, bgcolor=color.black)
    table.cell(dashboard, 1, 0, "Status", text_color=color.white, bgcolor=color.black)

    table.cell(dashboard, 0, 1, "EMA Cross Up")
    table.cell(dashboard, 1, 1, crossUp ? "✔" : "✘", text_color=crossUp ? color.green : color.red)

    table.cell(dashboard, 0, 2, "EMA Cross Down")
    table.cell(dashboard, 1, 2, crossDown ? "✔" : "✘", text_color=crossDown ? color.green : color.red)

    table.cell(dashboard, 0, 3, "Strong Candle")
    table.cell(dashboard, 1, 3, strongBody ? "✔" : "✘", text_color=strongBody ? color.green : color.red)

    table.cell(dashboard, 0, 4, "Above EMA20")
    table.cell(dashboard, 1, 4, close > ema20 ? "✔" : "✘", text_color=(close > ema20) ? color.green : color.red)

    table.cell(dashboard, 0, 5, "Below EMA20")
    table.cell(dashboard, 1, 5, close < ema20 ? "✔" : "✘", text_color=(close < ema20) ? color.green : color.red)
