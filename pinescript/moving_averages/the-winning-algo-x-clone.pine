//@version=6
indicator("ALGO X CLONE", overlay = true, max_lines_count = 500, max_labels_count = 500)

// Inputs
len           = input.int(100, "Range length (bigger = bigger boxes)", minval = 5)
atrLen        = input.int(14, "ATR length", minval = 1)
atrMult       = input.float(1.5, "ATR multiplier (TP distance)", minval = 0.1, step = 0.1)
boxTransp     = 20
useNextBarSig = input.bool(false, "Signal delay: use next candle?")
useTimeFilter = input.bool(false, "Use time filter?")
sessionInput  = input.session("0900-1600", "Session (exchange time)")

// Time filter
inSession = useTimeFilter ? not na(time(timeframe.period, sessionInput)) : true

// Auto range
rangeHigh  = ta.highest(high, len)
rangeLow   = ta.lowest(low, len)
rangeMid   = (rangeHigh + rangeLow) / 2.0
rangeWidth = rangeHigh - rangeLow
validRange = rangeWidth > 0

// ATR TP bands
atrValue = ta.atr(atrLen)
tpUpper  = rangeMid + atrMult * atrValue
tpLower  = rangeMid - atrMult * atrValue

// Raw breakout signals
var bool longSignalRaw  = false
var bool shortSignalRaw = false

if barstate.isconfirmed and inSession and validRange
    longSignalRaw := close > rangeHigh and close[1] <= rangeHigh[1]
if barstate.isconfirmed and inSession and not validRange
    longSignalRaw := false
if barstate.isconfirmed and inSession and validRange
    shortSignalRaw := close < rangeLow and close[1] >= rangeLow[1]
if barstate.isconfirmed and inSession and not validRange
    shortSignalRaw := false
if not barstate.isconfirmed
    longSignalRaw := false
if not barstate.isconfirmed
    shortSignalRaw := false

// Final signals with delay option
bool longSignal  = false
bool shortSignal = false

longSignal  := barstate.isconfirmed ? (useNextBarSig ? longSignalRaw[1]  : longSignalRaw)  : false
shortSignal := barstate.isconfirmed ? (useNextBarSig ? shortSignalRaw[1] : shortSignalRaw) : false

// Position state
var bool inLong      = false
var bool inShort     = false
var bool inLongPrev  = false
var bool inShortPrev = false

if barstate.isconfirmed
    inLongPrev  := inLong
    inShortPrev := inShort

if barstate.isconfirmed and longSignal and not inLong and not inShort
    inLong := true
if barstate.isconfirmed and shortSignal and not inLong and not inShort
    inShort := true

if barstate.isconfirmed and inLong and (shortSignal or close < rangeMid)
    inLong := false
if barstate.isconfirmed and inShort and (longSignal or close > rangeMid)
    inShort := false

// SPLIT RANGE BOX INTO GREEN TOP + RED BOTTOM
var box topBox = na
var box botBox = na

if barstate.isconfirmed
    box.delete(topBox)
    box.delete(botBox)

    // Softer GREEN top half
    topBox := box.new(
        bar_index - len + 1,
        rangeHigh,
        bar_index,
        rangeMid,
        border_color = color.new(color.green, 70),
        bgcolor      = color.new(color.green, 85)
    )

    // Softer RED bottom half
    botBox := box.new(
        bar_index - len + 1,
        rangeMid,
        bar_index,
        rangeLow,
        border_color = color.new(color.red, 70),
        bgcolor      = color.new(color.red, 85)
    )

// Midline + TP lines
plot(rangeMid, "Range midline", color = color.new(color.yellow, 0), linewidth = 2)
plot(tpUpper, "TP upper", color = color.new(color.green, 0))
plot(tpLower, "TP lower", color = color.new(color.red, 0))

// LONG SIGNAL — GREEN TP ON TOP
if barstate.isconfirmed and longSignal
    label.new(bar_index, low, "BUY",
        style = label.style_label_up,
        color = color.new(color.green, 0),
        textcolor = color.white)

    label.new(bar_index, tpUpper, "TP",
        style = label.style_label_up,
        color = color.new(color.green, 0),
        textcolor = color.white)

// SHORT SIGNAL — RED TP ON BOTTOM
if barstate.isconfirmed and shortSignal
    label.new(bar_index, high, "SELL",
        style = label.style_label_down,
        color = color.new(color.red, 0),
        textcolor = color.white)

    label.new(bar_index, tpLower, "TP",
        style = label.style_label_down,
        color = color.new(color.red, 0),
        textcolor = color.white)

// EXIT LABELS
if barstate.isconfirmed and inLongPrev and not inLong
    label.new(bar_index, close, "EXIT LONG",
        style = label.style_label_down,
        color = color.new(color.orange, 0),
        textcolor = color.white)

if barstate.isconfirmed and inShortPrev and not inShort
    label.new(bar_index, close, "EXIT SHORT",
        style = label.style_label_up,
        color = color.new(color.orange, 0),
        textcolor = color.white)

// Alerts
alertcondition(longSignal,  "ALGO X CLONE Long",  "ALGO X CLONE: Long signal")
alertcondition(shortSignal, "ALGO X CLONE Short", "ALGO X CLONE: Short signal")
