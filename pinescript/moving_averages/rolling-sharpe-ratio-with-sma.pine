//@version=5
indicator("Sharpe Ratio", shorttitle="Sharpe", overlay=false)

// Input for the calculation period and risk-free rate
calcPeriod = input.int(20, title="Calculation Period", minval=1)
riskFreeRate = input.float(0.0, title="Risk-Free Rate", step=0.01) / 100

// Calculate daily returns
dailyReturns = close / close[1] - 1

// Calculate the mean of daily returns
meanReturn = ta.sma(dailyReturns, calcPeriod)

// Calculate the standard deviation of daily returns
stdDeviation = ta.stdev(dailyReturns, calcPeriod)

// Calculate the Sharpe Ratio
excessReturn = meanReturn - riskFreeRate / calcPeriod
sharpeRatio = excessReturn / stdDeviation * math.sqrt(252)  // Annualizing the Sharpe Ratio

// Plot the Sharpe Ratio
plot(sharpeRatio, title="Sharpe Ratio", color=color.blue, linewidth=2)

// Plot a reference line at 0
hline(0, "Zero Line", color=color.red)
// Input for SMA length
smaLength = input.int(20, title="Sharpe SMA Length", minval=1)

// Calculate SMA of Sharpe Ratio
sharpeSMA = ta.sma(sharpeRatio, smaLength)
plot(sharpeSMA, title="Sharpe SMA", color=color.orange, linewidth=2)
plot(sharpeRatio, title="Sharpe Ratio", color=color.blue, linewidth=2)
plot(sharpeSMA, title="Sharpe SMA", color=color.orange, linewidth=2)
