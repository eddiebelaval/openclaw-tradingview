//@version=5
indicator("JVN Forex Setup Alert", overlay=true)

// =========================
// INPUTS
// =========================
emaLength      = input.int(200, "EMA Length", minval=1)
rsiLength      = input.int(14, "RSI Length", minval=1)

rsiBuyLevel    = input.float(50.0, "RSI Buy Level")
rsiSellLevel   = input.float(50.0, "RSI Sell Level")

minPips        = input.float(5.0, "Min Distance From EMA (pips)", step=0.1)
maxPips        = input.float(15.0, "Max Distance From EMA (pips)", step=0.1)

atrLength      = input.int(10, "UT ATR Length", minval=1)
atrMultiplier  = input.float(1.0, "UT ATR Multiplier", step=0.1)

useLondon      = input.bool(true, "Use London Session")
useNewYork     = input.bool(true, "Use New York Session")

londonSession  = input.session("0700-1600", "London Session (UTC)")
newyorkSession = input.session("1300-2200", "New York Session (UTC)")

showLabels     = input.bool(true, "Show Buy/Sell Labels")

// =========================
// PIP VALUE
// =========================
pipValue = syminfo.type == "forex" ? (str.contains(syminfo.ticker, "JPY") ? 0.01 : 0.0001) : syminfo.mintick

// =========================
// EMA CALCULATIONS
// =========================
// 15M EMA
ema15 = ta.ema(close, emaLength)

// 1H EMA and 1H close for higher timeframe bias
ema1H   = request.security(syminfo.tickerid, "60", ta.ema(close, emaLength))
close1H = request.security(syminfo.tickerid, "60", close)

// =========================
// RSI
// =========================
rsiVal = ta.rsi(close, rsiLength)

// =========================
// DISTANCE FROM 15M EMA
// =========================
distanceFromEMA = math.abs(close - ema15) / pipValue
withinRange = distanceFromEMA >= minPips and distanceFromEMA <= maxPips

// =========================
// SESSION FILTER
// =========================
inLondon  = useLondon  ? not na(time(timeframe.period, londonSession, "UTC"))  : false
inNewYork = useNewYork ? not na(time(timeframe.period, newyorkSession, "UTC")) : false
sessionActive = inLondon or inNewYork

// =========================
// TREND / BIAS FILTERS
// =========================
// Higher timeframe bias from 1H
bullBias1H = close1H > ema1H
bearBias1H = close1H < ema1H

// Local 15M confirmation
bullTrend15 = close > ema15
bearTrend15 = close < ema15

// =========================
// RSI FILTER
// =========================
rsiBuy = rsiVal > rsiBuyLevel
rsiSell = rsiVal < rsiSellLevel

// =========================
// UT-STYLE ATR TRAILING STOP
// =========================
atrVal = ta.atr(atrLength)
nLoss = atrMultiplier * atrVal

var float trailingStop = na

if na(trailingStop[1])
    trailingStop := close - nLoss
else
    if close > trailingStop[1] and close[1] > trailingStop[1]
        trailingStop := math.max(trailingStop[1], close - nLoss)
    else if close < trailingStop[1] and close[1] < trailingStop[1]
        trailingStop := math.min(trailingStop[1], close + nLoss)
    else if close > trailingStop[1]
        trailingStop := close - nLoss
    else
        trailingStop := close + nLoss

utBuy  = ta.crossover(close, trailingStop)
utSell = ta.crossunder(close, trailingStop)

// =========================
// FINAL CONDITIONS
// =========================
buySetup =
     timeframe.period == "15" and
     bullBias1H and
     bullTrend15 and
     withinRange and
     rsiBuy and
     utBuy and
     sessionActive and
     barstate.isconfirmed

sellSetup =
     timeframe.period == "15" and
     bearBias1H and
     bearTrend15 and
     withinRange and
     rsiSell and
     utSell and
     sessionActive and
     barstate.isconfirmed

// =========================
// PLOTS
// =========================
plot(ema15, "15M EMA 200", color=color.yellow, linewidth=2)
plot(trailingStop, "UT Trailing Stop", color=color.fuchsia)

// Optional shapes
plotshape(showLabels and buySetup,  title="Buy Setup",  style=shape.labelup,   location=location.belowbar, color=color.green, text="BUY", textcolor=color.white, size=size.small)
plotshape(showLabels and sellSetup, title="Sell Setup", style=shape.labeldown, location=location.abovebar, color=color.red,   text="SELL", textcolor=color.white, size=size.small)

// =========================
// ALERT CONDITIONS
// =========================
alertcondition(buySetup,  title="BUY SETUP",  message="BUY setup ready on {{ticker}} {{interval}}")
alertcondition(sellSetup, title="SELL SETUP", message="SELL setup ready on {{ticker}} {{interval}}")
