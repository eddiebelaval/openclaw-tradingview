//@version=6
indicator("MTF MA Ribbon", overlay = true)

tema(src, length) =>
    ema1 = ta.ema(src, length)
    ema2 = ta.ema(ema1, length)
    ema3 = ta.ema(ema2, length)
    3 * (ema1 - ema2) + ema3

tilsonT3(src, length, vFactor) =>
    ema1 = ta.ema(src, length)
    ema2 = ta.ema(ema1, length)
    ema3 = ta.ema(ema2, length)
    ema4 = ta.ema(ema3, length)
    ema5 = ta.ema(ema4, length)
    ema6 = ta.ema(ema5, length)
    c1 = -vFactor * math.pow(vFactor, 3)
    c2 = 3 * math.pow(vFactor, 2) + 3 * math.pow(vFactor, 3)
    c3 = -6 * math.pow(vFactor, 2) - 3 * vFactor - 3 * math.pow(vFactor, 3)
    c4 = 1 + 3 * vFactor + math.pow(vFactor, 3) + 3 * math.pow(vFactor, 2)
    c1 * ema6 + c2 * ema5 + c3 * ema4 + c4 * ema3

get_ma(src, length, MAtype, t3_vFactor) =>
    float result = na
    if MAtype == "SMA"
        result := ta.sma(src, length)
    if MAtype == "EMA"
        result := ta.ema(src, length)
    if MAtype == "WMA"
        result := ta.wma(src, length)
    if MAtype == "VWMA"
        result := ta.vwma(src, length)
    if MAtype == "RMA"
        result := ta.rma(src, length)
    if MAtype == "HMA"
        result := ta.hma(src, length)
    if MAtype == "TEMA"
        result := tema(src, length)
    if MAtype == "Tilson T3"
        result := tilsonT3(src, length, t3_vFactor)
    result

get_smooth(raw_ma, length, smooth_type) =>
    float result = na
    if smooth_type == "SMA"
        result := ta.sma(raw_ma, length)
    if smooth_type == "EMA"
        result := ta.ema(raw_ma, length)
    if smooth_type == "WMA"
        result := ta.wma(raw_ma, length)
    result

get_bands(src, b_type, length, mult) =>
    float up = na
    float dn = na
    if b_type == "Bollinger"
        dev = mult * ta.stdev(src, length)
        up := src + dev
        dn := src - dev
    if b_type == "Keltner"
        atr = ta.atr(length)
        up := src + mult * atr
        dn := src - mult * atr
    [up, dn]

t3_factor = input.float(0.7, title="T3 Volume Factor", step=0.1)

grp_ma = "Genel Ayarlar"

// MA 1
show_ma1   = input.bool(true,  "MA 1", inline="m1", group=grp_ma)
ma1_type   = input.string("SMA", "", options=["SMA", "EMA", "WMA", "VWMA", "RMA", "HMA", "TEMA", "Tilson T3"], inline="m1", group=grp_ma)
ma1_source = input.source(close, "", inline="m1", group=grp_ma)
ma1_length = input.int(20, "Periyot:", minval=1, inline="m1", group=grp_ma)
ma1_smooth_type = input.string("Yok", "Yumuşatma:", options=["Yok", "SMA", "EMA", "WMA"], inline="s1", group=grp_ma)
ma1_smooth_len  = input.int(20, "Periyot:", minval=1, inline="s1", group=grp_ma)
ma1_tf     = input.timeframe("", "Zaman:", inline="t1", group=grp_ma)
ma1_wait   = input.bool(true, "Zaman aralığının kapanmasını bekleyin", inline="w1", group=grp_ma)

// MA 2
show_ma2   = input.bool(true,  "MA 2", inline="m2", group=grp_ma)
ma2_type   = input.string("SMA", "", options=["SMA", "EMA", "WMA", "VWMA", "RMA", "HMA", "TEMA", "Tilson T3"], inline="m2", group=grp_ma)
ma2_source = input.source(close, "", inline="m2", group=grp_ma)
ma2_length = input.int(50, "Periyot:", minval=1, inline="m2", group=grp_ma)
ma2_smooth_type = input.string("Yok", "Yumuşatma:", options=["Yok", "SMA", "EMA", "WMA"], inline="s2", group=grp_ma)
ma2_smooth_len  = input.int(50, "Periyot:", minval=1, inline="s2", group=grp_ma)
ma2_tf     = input.timeframe("", "Zaman:", inline="t2", group=grp_ma)
ma2_wait   = input.bool(true, "Zaman aralığının kapanmasını bekleyin", inline="w2", group=grp_ma)

// MA 3
show_ma3   = input.bool(true,  "MA 3", inline="m3", group=grp_ma)
ma3_type   = input.string("SMA", "", options=["SMA", "EMA", "WMA", "VWMA", "RMA", "HMA", "TEMA", "Tilson T3"], inline="m3", group=grp_ma)
ma3_source = input.source(close, "", inline="m3", group=grp_ma)
ma3_length = input.int(200, "Periyot:", minval=1, inline="m3", group=grp_ma)
ma3_smooth_type = input.string("Yok", "Yumuşatma:", options=["Yok", "SMA", "EMA", "WMA"], inline="s3", group=grp_ma)
ma3_smooth_len  = input.int(200, "Periyot:", minval=1, inline="s3", group=grp_ma)
ma3_tf     = input.timeframe("", "Zaman:", inline="t3", group=grp_ma)
ma3_wait   = input.bool(true, "Zaman aralığının kapanmasını bekleyin", inline="w3", group=grp_ma)

// MA 4
show_ma4   = input.bool(false, "MA 4", inline="m4", group=grp_ma)
ma4_type   = input.string("SMA", "", options=["SMA", "EMA", "WMA", "VWMA", "RMA", "HMA", "TEMA", "Tilson T3"], inline="m4", group=grp_ma)
ma4_source = input.source(close, "", inline="m4", group=grp_ma)
ma4_length = input.int(50, "Periyot:", minval=1, inline="m4", group=grp_ma)
ma4_smooth_type = input.string("Yok", "Yumuşatma:", options=["Yok", "SMA", "EMA", "WMA"], inline="s4", group=grp_ma)
ma4_smooth_len  = input.int(50, "Periyot:", minval=1, inline="s4", group=grp_ma)
ma4_tf     = input.timeframe("", "Zaman:", inline="t4", group=grp_ma)
ma4_wait   = input.bool(true, "Zaman aralığının kapanmasını bekleyin", inline="w4", group=grp_ma)

// MA 5
show_ma5   = input.bool(false, "MA 5", inline="m5", group=grp_ma)
ma5_type   = input.string("SMA", "", options=["SMA", "EMA", "WMA", "VWMA", "RMA", "HMA", "TEMA", "Tilson T3"], inline="m5", group=grp_ma)
ma5_source = input.source(close, "", inline="m5", group=grp_ma)
ma5_length = input.int(200, "Periyot:", minval=1, inline="m5", group=grp_ma)
ma5_smooth_type = input.string("Yok", "Yumuşatma:", options=["Yok", "SMA", "EMA", "WMA"], inline="s5", group=grp_ma)
ma5_smooth_len  = input.int(200, "Periyot:", minval=1, inline="s5", group=grp_ma)
ma5_tf     = input.timeframe("", "Zaman:", inline="t5", group=grp_ma)
ma5_wait   = input.bool(true, "Zaman aralığının kapanmasını bekleyin", inline="w5", group=grp_ma)

grp_band = "Bollınger / Keltner"

// Bant 1
show_b1   = input.bool(true, "Bant 1", group=grp_band)
type_b1   = input.string("Bollinger", "Tür:", options=["Bollinger", "Keltner"], inline="b1_1", group=grp_band)
target_b1 = input.string("MA 1", "Hedef MA:", options=["MA 1", "MA 1 Yumuşatma", "MA 2", "MA 2 Yumuşatma", "MA 3", "MA 3 Yumuşatma", "MA 4", "MA 4 Yumuşatma", "MA 5", "MA 5 Yumuşatma"], inline="b1_1", group=grp_band)
len_b1    = input.int(20, "Periyot:", minval=1, inline="b1_2", group=grp_band)
mult_b1   = input.float(2.0, "Çarpan:", step=0.1, inline="b1_2", group=grp_band)

// Bant 2
show_b2   = input.bool(false, "Bant 2", group=grp_band)
type_b2   = input.string("Bollinger", "Tür:", options=["Bollinger", "Keltner"], inline="b2_1", group=grp_band)
target_b2 = input.string("MA 2", "Hedef MA:", options=["MA 1", "MA 1 Yumuşatma", "MA 2", "MA 2 Yumuşatma", "MA 3", "MA 3 Yumuşatma", "MA 4", "MA 4 Yumuşatma", "MA 5", "MA 5 Yumuşatma"], inline="b2_1", group=grp_band)
len_b2    = input.int(20, "Periyot:", minval=1, inline="b2_2", group=grp_band)
mult_b2   = input.float(2.0, "Çarpan:", step=0.1, inline="b2_2", group=grp_band)

// Bant 3
show_b3   = input.bool(false, "Bant 3", group=grp_band)
type_b3   = input.string("Bollinger", "Tür:", options=["Bollinger", "Keltner"], inline="b3_1", group=grp_band)
target_b3 = input.string("MA 3", "Hedef MA:", options=["MA 1", "MA 1 Yumuşatma", "MA 2", "MA 2 Yumuşatma", "MA 3", "MA 3 Yumuşatma", "MA 4", "MA 4 Yumuşatma", "MA 5", "MA 5 Yumuşatma"], inline="b3_1", group=grp_band)
len_b3    = input.int(20, "Periyot:", minval=1, inline="b3_2", group=grp_band)
mult_b3   = input.float(2.0, "Çarpan:", step=0.1, inline="b3_2", group=grp_band)

// Bant 4
show_b4   = input.bool(false, "Bant 4", group=grp_band)
type_b4   = input.string("Bollinger", "Tür:", options=["Bollinger", "Keltner"], inline="b4_1", group=grp_band)
target_b4 = input.string("MA 4", "Hedef MA:", options=["MA 1", "MA 1 Yumuşatma", "MA 2", "MA 2 Yumuşatma", "MA 3", "MA 3 Yumuşatma", "MA 4", "MA 4 Yumuşatma", "MA 5", "MA 5 Yumuşatma"], inline="b4_1", group=grp_band)
len_b4    = input.int(20, "Periyot:", minval=1, inline="b4_2", group=grp_band)
mult_b4   = input.float(2.0, "Çarpan:", step=0.1, inline="b4_2", group=grp_band)

// Bant 5
show_b5   = input.bool(false, "Bant 5", group=grp_band)
type_b5   = input.string("Bollinger", "Tür:", options=["Bollinger", "Keltner"], inline="b5_1", group=grp_band)
target_b5 = input.string("MA 5", "Hedef MA:", options=["MA 1", "MA 1 Yumuşatma", "MA 2", "MA 2 Yumuşatma", "MA 3", "MA 3 Yumuşatma", "MA 4", "MA 4 Yumuşatma", "MA 5", "MA 5 Yumuşatma"], inline="b5_1", group=grp_band)
len_b5    = input.int(20, "Periyot:", minval=1, inline="b5_2", group=grp_band)
mult_b5   = input.float(2.0, "Çarpan:", step=0.1, inline="b5_2", group=grp_band)

raw1 = get_ma(ma1_source, ma1_length, ma1_type, t3_factor)
sm1  = get_smooth(raw1, ma1_smooth_len, ma1_smooth_type)
raw2 = get_ma(ma2_source, ma2_length, ma2_type, t3_factor)
sm2  = get_smooth(raw2, ma2_smooth_len, ma2_smooth_type)
raw3 = get_ma(ma3_source, ma3_length, ma3_type, t3_factor)
sm3  = get_smooth(raw3, ma3_smooth_len, ma3_smooth_type)
raw4 = get_ma(ma4_source, ma4_length, ma4_type, t3_factor)
sm4  = get_smooth(raw4, ma4_smooth_len, ma4_smooth_type)
raw5 = get_ma(ma5_source, ma5_length, ma5_type, t3_factor)
sm5  = get_smooth(raw5, ma5_smooth_len, ma5_smooth_type)

[src_b1, tf_b1, wait_b1] = switch target_b1
    "MA 1" => [raw1, ma1_tf, ma1_wait]
    "MA 1 Yumuşatma" => [sm1, ma1_tf, ma1_wait]
    "MA 2" => [raw2, ma2_tf, ma2_wait]
    "MA 2 Yumuşatma" => [sm2, ma2_tf, ma2_wait]
    "MA 3" => [raw3, ma3_tf, ma3_wait]
    "MA 3 Yumuşatma" => [sm3, ma3_tf, ma3_wait]
    "MA 4" => [raw4, ma4_tf, ma4_wait]
    "MA 4 Yumuşatma" => [sm4, ma4_tf, ma4_wait]
    "MA 5" => [raw5, ma5_tf, ma5_wait]
    "MA 5 Yumuşatma" => [sm5, ma5_tf, ma5_wait]
    => [raw1, ma1_tf, ma1_wait]

[src_b2, tf_b2, wait_b2] = switch target_b2
    "MA 1" => [raw1, ma1_tf, ma1_wait]
    "MA 1 Yumuşatma" => [sm1, ma1_tf, ma1_wait]
    "MA 2" => [raw2, ma2_tf, ma2_wait]
    "MA 2 Yumuşatma" => [sm2, ma2_tf, ma2_wait]
    "MA 3" => [raw3, ma3_tf, ma3_wait]
    "MA 3 Yumuşatma" => [sm3, ma3_tf, ma3_wait]
    "MA 4" => [raw4, ma4_tf, ma4_wait]
    "MA 4 Yumuşatma" => [sm4, ma4_tf, ma4_wait]
    "MA 5" => [raw5, ma5_tf, ma5_wait]
    "MA 5 Yumuşatma" => [sm5, ma5_tf, ma5_wait]
    => [raw1, ma1_tf, ma1_wait]

[src_b3, tf_b3, wait_b3] = switch target_b3
    "MA 1" => [raw1, ma1_tf, ma1_wait]
    "MA 1 Yumuşatma" => [sm1, ma1_tf, ma1_wait]
    "MA 2" => [raw2, ma2_tf, ma2_wait]
    "MA 2 Yumuşatma" => [sm2, ma2_tf, ma2_wait]
    "MA 3" => [raw3, ma3_tf, ma3_wait]
    "MA 3 Yumuşatma" => [sm3, ma3_tf, ma3_wait]
    "MA 4" => [raw4, ma4_tf, ma4_wait]
    "MA 4 Yumuşatma" => [sm4, ma4_tf, ma4_wait]
    "MA 5" => [raw5, ma5_tf, ma5_wait]
    "MA 5 Yumuşatma" => [sm5, ma5_tf, ma5_wait]
    => [raw1, ma1_tf, ma1_wait]

[src_b4, tf_b4, wait_b4] = switch target_b4
    "MA 1" => [raw1, ma1_tf, ma1_wait]
    "MA 1 Yumuşatma" => [sm1, ma1_tf, ma1_wait]
    "MA 2" => [raw2, ma2_tf, ma2_wait]
    "MA 2 Yumuşatma" => [sm2, ma2_tf, ma2_wait]
    "MA 3" => [raw3, ma3_tf, ma3_wait]
    "MA 3 Yumuşatma" => [sm3, ma3_tf, ma3_wait]
    "MA 4" => [raw4, ma4_tf, ma4_wait]
    "MA 4 Yumuşatma" => [sm4, ma4_tf, ma4_wait]
    "MA 5" => [raw5, ma5_tf, ma5_wait]
    "MA 5 Yumuşatma" => [sm5, ma5_tf, ma5_wait]
    => [raw1, ma1_tf, ma1_wait]

[src_b5, tf_b5, wait_b5] = switch target_b5
    "MA 1" => [raw1, ma1_tf, ma1_wait]
    "MA 1 Yumuşatma" => [sm1, ma1_tf, ma1_wait]
    "MA 2" => [raw2, ma2_tf, ma2_wait]
    "MA 2 Yumuşatma" => [sm2, ma2_tf, ma2_wait]
    "MA 3" => [raw3, ma3_tf, ma3_wait]
    "MA 3 Yumuşatma" => [sm3, ma3_tf, ma3_wait]
    "MA 4" => [raw4, ma4_tf, ma4_wait]
    "MA 4 Yumuşatma" => [sm4, ma4_tf, ma4_wait]
    "MA 5" => [raw5, ma5_tf, ma5_wait]
    "MA 5 Yumuşatma" => [sm5, ma5_tf, ma5_wait]
    => [raw1, ma1_tf, ma1_wait]


// Ham Bant Hesaplamaları
[up_raw1, dn_raw1] = get_bands(src_b1, type_b1, len_b1, mult_b1)
[up_raw2, dn_raw2] = get_bands(src_b2, type_b2, len_b2, mult_b2)
[up_raw3, dn_raw3] = get_bands(src_b3, type_b3, len_b3, mult_b3)
[up_raw4, dn_raw4] = get_bands(src_b4, type_b4, len_b4, mult_b4)
[up_raw5, dn_raw5] = get_bands(src_b5, type_b5, len_b5, mult_b5)

// --- MTF VERİ ÇEKİMİ ---
[f_raw1, f_sm1] = request.security(syminfo.tickerid, ma1_tf, [ma1_wait ? raw1[1] : raw1, ma1_wait ? sm1[1] : sm1], lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_on)
[f_raw2, f_sm2] = request.security(syminfo.tickerid, ma2_tf, [ma2_wait ? raw2[1] : raw2, ma2_wait ? sm2[1] : sm2], lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_on)
[f_raw3, f_sm3] = request.security(syminfo.tickerid, ma3_tf, [ma3_wait ? raw3[1] : raw3, ma3_wait ? sm3[1] : sm3], lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_on)
[f_raw4, f_sm4] = request.security(syminfo.tickerid, ma4_tf, [ma4_wait ? raw4[1] : raw4, ma4_wait ? sm4[1] : sm4], lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_on)
[f_raw5, f_sm5] = request.security(syminfo.tickerid, ma5_tf, [ma5_wait ? raw5[1] : raw5, ma5_wait ? sm5[1] : sm5], lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_on)

[f_b1_up, f_b1_dn] = request.security(syminfo.tickerid, tf_b1, [wait_b1 ? up_raw1[1] : up_raw1, wait_b1 ? dn_raw1[1] : dn_raw1], lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_on)
[f_b2_up, f_b2_dn] = request.security(syminfo.tickerid, tf_b2, [wait_b2 ? up_raw2[1] : up_raw2, wait_b2 ? dn_raw2[1] : dn_raw2], lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_on)
[f_b3_up, f_b3_dn] = request.security(syminfo.tickerid, tf_b3, [wait_b3 ? up_raw3[1] : up_raw3, wait_b3 ? dn_raw3[1] : dn_raw3], lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_on)
[f_b4_up, f_b4_dn] = request.security(syminfo.tickerid, tf_b4, [wait_b4 ? up_raw4[1] : up_raw4, wait_b4 ? dn_raw4[1] : dn_raw4], lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_on)
[f_b5_up, f_b5_dn] = request.security(syminfo.tickerid, tf_b5, [wait_b5 ? up_raw5[1] : up_raw5, wait_b5 ? dn_raw5[1] : dn_raw5], lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_on)

// MA Çizimleri
plot(show_ma1 ? f_raw1 : na, color=#ffffff, title="MA 1", linewidth=1)
plot(show_ma1 and ma1_smooth_type != "Yok" ? f_sm1 : na, color=#ffffff, title="MA 1 Yumuşatma", linewidth=1)
plot(show_ma2 ? f_raw2 : na, color=#008eff, title="MA 2", linewidth=1)
plot(show_ma2 and ma2_smooth_type != "Yok" ? f_sm2 : na, color=#008eff, title="MA 2 Yumuşatma", linewidth=1)
plot(show_ma3 ? f_raw3 : na, color=#fbc02d, title="MA 3", linewidth=1)
plot(show_ma3 and ma3_smooth_type != "Yok" ? f_sm3 : na, color=#fbc02d, title="MA 3 Yumuşatma", linewidth=1)
plot(show_ma4 ? f_raw4 : na, color=#9c27b0, title="MA 4", linewidth=2)
plot(show_ma4 and ma4_smooth_type != "Yok" ? f_sm4 : na, color=#9c27b0, title="MA 4 Yumuşatma", linewidth=2)
plot(show_ma5 ? f_raw5 : na, color=#00bcd4, title="MA 5", linewidth=2)
plot(show_ma5 and ma5_smooth_type != "Yok" ? f_sm5 : na, color=color.rgb(0, 188, 212), title="MA 5 Yumuşatma", linewidth=2)

// Bant Çizimleri
p1_up = plot(show_b1 ? f_b1_up : na, color=#f23645, title="Bant 1 Üst", style=plot.style_line)
p1_dn = plot(show_b1 ? f_b1_dn : na, color=#4caf50, title="Bant 1 Alt", style=plot.style_line)
fill(p1_up, p1_dn, color=show_b1 ?color.new(color.white, 95) : na, title="Bant 1 Arkaplan")

p2_up = plot(show_b2 ? f_b2_up : na, color=#f23645, title="Bant 2 Üst", style=plot.style_line)
p2_dn = plot(show_b2 ? f_b2_dn : na, color=#4caf50, title="Bant 2 Alt", style=plot.style_line)
fill(p2_up, p2_dn, color=show_b2 ? color.new(color.white, 95) : na, title="Bant 2 Arkaplan")

p3_up = plot(show_b3 ? f_b3_up : na, color=#f23645, title="Bant 3 Üst", style=plot.style_line)
p3_dn = plot(show_b3 ? f_b3_dn : na, color=#4caf50, title="Bant 3 Alt", style=plot.style_line)
fill(p3_up, p3_dn, color=show_b3 ? color.new(color.white, 95) : na, title="Bant 3 Arkaplan")

p4_up = plot(show_b4 ? f_b4_up : na, color=#f23645, title="Bant 4 Üst", style=plot.style_line)
p4_dn = plot(show_b4 ? f_b4_dn : na, color=#4caf50, title="Bant 4 Alt", style=plot.style_line)
fill(p4_up, p4_dn, color=show_b4 ? color.new(color.white, 95) : na, title="Bant 4 Arkaplan")

p5_up = plot(show_b5 ? f_b5_up : na, color=#f23645, title="Bant 5 Üst", style=plot.style_line)
p5_dn = plot(show_b5 ? f_b5_dn : na, color=#4caf50, title="Bant 5 Alt", style=plot.style_line)
fill(p5_up, p5_dn, color=show_b5 ? color.new(color.white, 95) : na, title="Bant 5 Arkaplan")
