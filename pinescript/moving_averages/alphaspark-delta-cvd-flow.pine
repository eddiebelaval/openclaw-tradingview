// This version of indicator is a simple copy and adaptation of Sync-and-Trade's indicator so please follow them on Trading View and give them a shout-out!
// https://www.tradingview.com/u/SYNC-AND-TRADE/#published-scripts
// © SYNC-AND-TRADE
// This version has simple default settings prefered to my liking and color changes, together with formula ad signals that use my DeltaShift's MFI adaptation for better flitering of market direction.
// https://whop.com/alphaspark-trading/

//@version=6
indicator('🔼 AlphaSpark Delta CVD Flow', overlay = false, max_bars_back = 5000)

// =========================================================================
// ALPHASPARK DELTAFLOW EXHAUSTION FILTER
// =========================================================================
grp_df = "AlphaSpark DeltaFlow Filter"
use_df_filter  = input.bool(true, title="Use DeltaFlow Exhaustion Filter?", tooltip="If true, Longs only trigger when DF < 0, and Shorts only trigger when DF > 0.", group=grp_df)
show_df_ribbon = input.bool(true, title="Show DeltaFlow Status Ribbon?", tooltip="Displays colored squares at the bottom of the pane showing the DeltaFlow state.", group=grp_df)
df_length      = input.int(60, title="DeltaFlow Length", group=grp_df)

// Enable/Disable Long and Short settings
use_long = input.bool(true, 'Use Long Settings', group = 'Long Settings')
use_short = input.bool(true, 'Use Short Settings', group = 'Short Settings')

// Add input parameters for MA length and type separately for long and short
length_long = input.int(55, 'Long MA Length', minval = 1, group = 'Long Settings')
ma_type_long = input.string(title = 'Long MA Type', defval = 'EMA', options = ['SMA', 'EMA', 'WMA', 'RMA', 'HMA'], group = 'Long Settings')
length_short = input.int(34, 'Short MA Length', minval = 1, group = 'Short Settings')
ma_type_short = input.string(title = 'Short MA Type', defval = 'EMA', options = ['SMA', 'EMA', 'WMA', 'RMA', 'HMA'], group = 'Short Settings')

length_long2 = input.int(89, 'Second Long MA Length', minval = 1, group = 'Long Settings')
ma_type_long2 = input.string(title = 'Second Long MA Type', defval = 'WMA', options = ['SMA', 'EMA', 'WMA', 'RMA', 'HMA'], group = 'Long Settings')
length_short2 = input.int(21, 'Second Short MA Length', minval = 1, group = 'Short Settings')
ma_type_short2 = input.string(title = 'Second Short MA Type', defval = 'WMA', options = ['SMA', 'EMA', 'WMA', 'RMA', 'HMA'], group = 'Short Settings')

// Add variables mult_long, len_long, mult_short, and len_short as arguments
mult_long = input.float(1.5, 'Long Multiplier', step = 0.1, group = 'Long Settings')
len_long = input.int(40, 'Long Length', minval = 1, group = 'Long Settings')

mult_short = input.float(1.5, 'Short Multiplier', step = 0.1, group = 'Short Settings')
len_short = input.int(40, 'Short Length', minval = 1, group = 'Short Settings')

// New input parameter to use data from a higher timeframe
use_higher_timeframe = input.bool(false, 'Use Higher Timeframe Data', group = 'Higher Timeframe')
higher_tf = input.string('D', 'Higher Timeframe', options = ['D', 'W', 'M'], group = 'Higher Timeframe')

// New parameter to enable/disable volume integration
use_volume_integration = input.bool(true, 'Use Volume Integration in CVD', group = 'Volume Integration')

// Function to get data from higher timeframe
f_get_higher_tf_data(src) =>
    request.security(syminfo.tickerid, higher_tf, src)

// Calculate Cumulative Volume Delta (CVD) with volume
var float cvd_with_volume = na
if use_higher_timeframe
    higher_tf_close = f_get_higher_tf_data(close)
    higher_tf_open = f_get_higher_tf_data(open)
    higher_tf_high = f_get_higher_tf_data(high)
    higher_tf_low = f_get_higher_tf_data(low)
    higher_tf_volume = f_get_higher_tf_data(volume)
    float higher_tf_volume_delta = na
    if use_volume_integration
        higher_tf_volume_delta := higher_tf_volume * (higher_tf_close - higher_tf_open)
        higher_tf_volume_delta
    else
        higher_tf_volume_delta := higher_tf_volume * (higher_tf_close - higher_tf_open) / (higher_tf_high - higher_tf_low)
        higher_tf_volume_delta
    cvd_with_volume := na(cvd_with_volume[1]) ? higher_tf_volume_delta : cvd_with_volume[1] + higher_tf_volume_delta
    cvd_with_volume
else
    float volume_weighted_delta = na
    if use_volume_integration
        volume_weighted_delta := volume * (close - open)
        volume_weighted_delta
    else
        volume_weighted_delta := volume * (close - open) / (high - low)
        volume_weighted_delta
    cvd_with_volume := na(cvd_with_volume[1]) ? volume_weighted_delta : cvd_with_volume[1] + volume_weighted_delta
    cvd_with_volume

// Modify MA calculation function to support different types
ma(source, length, ma_type) =>
    switch ma_type
        'SMA' => ta.sma(source, length)
        'EMA' => ta.ema(source, length)
        'WMA' => ta.wma(source, length)
        'RMA' => ta.rma(source, length)
        'HMA' => ta.hma(source, length)

cvd_ma_long = ma(cvd_with_volume, length_long, ma_type_long)
cvd_ma_short = ma(cvd_with_volume, length_short, ma_type_short)

cvd_ma_long2 = ma(cvd_with_volume, length_long2, ma_type_long2)
cvd_ma_short2 = ma(cvd_with_volume, length_short2, ma_type_short2)

base_cloud_distance = input.float(0.01, 'Base Cloud Distance', minval = 0.01, maxval = 150, step = 0.01)

use_dynamic_cloud = input.bool(true, 'Use Dynamic Cloud Distance', group = 'Volatility')
volatility_period = input.int(14, 'Volatility Period', minval = 1, group = 'Volatility')
volatility_lookback = input.int(100, 'Volatility Lookback', minval = 1, group = 'Volatility')

current_volatility = ta.atr(volatility_period)
avg_volatility = ta.sma(current_volatility, volatility_lookback)

volatility_multiplier = math.max(current_volatility / avg_volatility, 1)
dynamic_cloud_distance = use_dynamic_cloud ? base_cloud_distance * volatility_multiplier : base_cloud_distance
show_parallel_lines = input.bool(false, 'Show Parallel Distance Lines', group = 'UI Settings')
base_parallel_distance = input.float(8.0, 'Base Parallel Distance', minval = 0.1, maxval = 150, step = 0.1)

higher_tf_atr = use_higher_timeframe ? f_get_higher_tf_data(ta.atr(len_long)) : ta.atr(len_long)
upper_cloud_long = cvd_ma_long + dynamic_cloud_distance * higher_tf_atr
lower_cloud_long = cvd_ma_long - dynamic_cloud_distance * higher_tf_atr
upper_cloud_short = cvd_ma_short + dynamic_cloud_distance * higher_tf_atr
lower_cloud_short = cvd_ma_short - dynamic_cloud_distance * higher_tf_atr

upper_parallel_long1 = cvd_ma_long + base_parallel_distance * higher_tf_atr
lower_parallel_long1 = cvd_ma_long - base_parallel_distance * higher_tf_atr
upper_parallel_long2 = cvd_ma_long + 2 * base_parallel_distance * higher_tf_atr
lower_parallel_long2 = cvd_ma_long - 2 * base_parallel_distance * higher_tf_atr
upper_parallel_long3 = cvd_ma_long + 3 * base_parallel_distance * higher_tf_atr
lower_parallel_long3 = cvd_ma_long - 3 * base_parallel_distance * higher_tf_atr

upper_parallel_short1 = cvd_ma_short + base_parallel_distance * higher_tf_atr
lower_parallel_short1 = cvd_ma_short - base_parallel_distance * higher_tf_atr
upper_parallel_short2 = cvd_ma_short + 2 * base_parallel_distance * higher_tf_atr
lower_parallel_short2 = cvd_ma_short - 2 * base_parallel_distance * higher_tf_atr
upper_parallel_short3 = cvd_ma_short + 3 * base_parallel_distance * higher_tf_atr
lower_parallel_short3 = cvd_ma_short - 3 * base_parallel_distance * higher_tf_atr

uptrend_long = cvd_ma_long > cvd_ma_long[1]
downtrend_long = cvd_ma_long < cvd_ma_long[1]
uptrend_short = cvd_ma_short > cvd_ma_short[1]
downtrend_short = cvd_ma_short < cvd_ma_short[1]

plot(use_long ? cvd_ma_long : na, color = uptrend_long ? #089981 : downtrend_long ? #3f00ff : color.gray, linewidth = 1, title = 'CVD Moving Average Long')
plot(use_short ? cvd_ma_short : na, color = uptrend_short ? #089981 : downtrend_short ? #3f00ff : color.gray, linewidth = 1, title = 'CVD Moving Average Short')
plot(use_long ? cvd_ma_long2 : na, color = uptrend_long ? #089981 : downtrend_long ? #3f00ff : color.gray, linewidth = 1, title = 'CVD Moving Average Long 2')
plot(use_short ? cvd_ma_short2 : na, color = uptrend_short ? #089981 : downtrend_short ? #3f00ff : color.gray, linewidth = 1, title = 'CVD Moving Average Short 2')

fill(plot(use_long ? upper_cloud_long : na, color = color.new(#089981, 90), title = 'Upper Cloud Long'), plot(use_long ? lower_cloud_long : na, color = color.new(#3f00ff, 90), title = 'Lower Cloud Long'), color = color.new(#9915ff, 90), title = 'Cloud Long')
fill(plot(use_short ? upper_cloud_short : na, color = color.new(#089981, 90), title = 'Upper Cloud Short'), plot(use_short ? lower_cloud_short : na, color = color.new(#3f00ff, 90), title = 'Lower Cloud Short'), color = color.new(#9915ff, 90), title = 'Cloud Short')

plot(show_parallel_lines and use_long ? upper_parallel_long1 : na, color = color.new(#089981, 50), linewidth = 1, title = 'Upper Parallel Long 1')
plot(show_parallel_lines and use_long ? lower_parallel_long1 : na, color = color.new(#3f00ff, 50), linewidth = 1, title = 'Lower Parallel Long 1')
plot(show_parallel_lines and use_long ? upper_parallel_long2 : na, color = color.new(#089981, 50), linewidth = 1, title = 'Upper Parallel Long 2')
plot(show_parallel_lines and use_long ? lower_parallel_long2 : na, color = color.new(#3f00ff, 50), linewidth = 1, title = 'Lower Parallel Long 2')
plot(show_parallel_lines and use_long ? upper_parallel_long3 : na, color = color.new(#089981, 50), linewidth = 1, title = 'Upper Parallel Long 3')
plot(show_parallel_lines and use_long ? lower_parallel_long3 : na, color = color.new(#3f00ff, 50), linewidth = 1, title = 'Lower Parallel Long 3')

plot(show_parallel_lines and use_short ? upper_parallel_short1 : na, color = color.new(#089981, 50), linewidth = 1, title = 'Upper Parallel Short 1')
plot(show_parallel_lines and use_short ? lower_parallel_short1 : na, color = color.new(#3f00ff, 50), linewidth = 1, title = 'Lower Parallel Short 1')
plot(show_parallel_lines and use_short ? upper_parallel_short2 : na, color = color.new(#089981, 50), linewidth = 1, title = 'Upper Parallel Short 2')
plot(show_parallel_lines and use_short ? lower_parallel_short2 : na, color = color.new(#3f00ff, 50), linewidth = 1, title = 'Lower Parallel Short 2')
plot(show_parallel_lines and use_short ? upper_parallel_short3 : na, color = color.new(#089981, 50), linewidth = 1, title = 'Upper Parallel Short 3')
plot(show_parallel_lines and use_short ? lower_parallel_short3 : na, color = color.new(#3f00ff, 50), linewidth = 1, title = 'Lower Parallel Short 3')

cvdDisplayType = input.string(title = 'CVD Display Type', defval = 'Line', options = ['Line', 'Regular Candlesticks'])
plotLine = cvdDisplayType == 'Line'
plot(plotLine ? cvd_with_volume : na, color = #00aeef, title = 'Cumulative Volume Delta', linewidth = 4)

plotRegular = cvdDisplayType == 'Regular Candlesticks'
plotcandle(plotRegular ? cvd_with_volume[1] : na, cvd_with_volume, cvd_with_volume[1], cvd_with_volume, color = cvd_with_volume > cvd_with_volume[1] ? color.blue : #3f00ff, wickcolor = color.gray, title = 'CVD Regular Candlesticks')

// =========================================================================
// DELTAFLOW CALCULATION (The AlphaSpark Filter)
// =========================================================================
df_src = ta.ema(hlc3, 9)
df_mfi = ta.mfi(df_src, df_length)
df_rescaled = (df_mfi - 50) * 2 

// The Rules you defined: < 0 for Longs, > 0 for Shorts
df_long_ok = df_rescaled < 0
df_short_ok = df_rescaled > 0

// Visual Ribbon plotting at the bottom of the pane (so it doesn't break CVD scale)
plotshape(show_df_ribbon and df_long_ok ? cvd_with_volume : na, title="DF Long Zone", location=location.bottom, style=shape.square, color=color.new(color.blue, 70), size=size.tiny)
plotshape(show_df_ribbon and df_short_ok ? cvd_with_volume : na, title="DF Short Zone", location=location.bottom, style=shape.square, color=color.new(color.purple, 70), size=size.tiny)

// =========================================================================
// MARKET STATE DEFINITIONS (PURE BREAKOUTS)
// =========================================================================
long_state = cvd_with_volume > cvd_ma_long and cvd_with_volume > cvd_ma_short and cvd_with_volume > cvd_ma_long2 and cvd_with_volume > cvd_ma_short2
short_state = cvd_with_volume < cvd_ma_long and cvd_with_volume < cvd_ma_short and cvd_with_volume < cvd_ma_long2 and cvd_with_volume < cvd_ma_short2

// =========================================================================
// ALPHA SPARK: ALTERNATING SIGNALS + DELTAFLOW FILTER
// =========================================================================
var int last_signal_type = 0 

raw_long_cross = long_state and not long_state[1]
raw_short_cross = short_state and not short_state[1]

// The Filter: Is it a valid cross AND Alternates AND DeltaFlow agrees (if enabled)?
valid_long_entry = raw_long_cross and last_signal_type != 1 and (not use_df_filter or df_long_ok)
valid_short_entry = raw_short_cross and last_signal_type != -1 and (not use_df_filter or df_short_ok)

if valid_long_entry
    last_signal_type := 1

if valid_short_entry
    last_signal_type := -1

// =========================================================================
// ALPHASPARK VISUAL ENTRY MARKERS (Triangles)
// =========================================================================
plotshape(valid_long_entry ? cvd_with_volume : na, title="Long Entry Triangle", location=location.absolute, style=shape.triangleup, color=color.new(color.blue, 0), size=size.small)
plotshape(valid_short_entry ? cvd_with_volume : na, title="Short Entry Triangle", location=location.absolute, style=shape.triangledown, color=color.new(color.purple, 0), size=size.small)

// Alerts
alertcondition(valid_long_entry, title = 'Enter Long State', message = 'CVD crossed above ALL MAs + DeltaFlow < 0, Enter Long')
alertcondition(valid_short_entry, title = 'Enter Short State', message = 'CVD crossed below ALL MAs + DeltaFlow > 0, Enter Short')

// UI Table functionality (Removed testing logic variables to clean up)
font_size_table_option = input.string(title = 'Font Size', defval = 'normal', options = ['tiny', 'small', 'normal', 'large'], group = 'UI Settings')

font_size_picker(font_size) =>
    switch font_size
        'tiny' => size.tiny
        'small' => size.small
        'normal' => size.normal
        'large' => size.large

var table market_state = table.new(position.top_center, 3, 2, border_width = 1)

table.cell(market_state, 0, 0, 'Market State', bgcolor = color.new(color.blue, 90), text_color = color.gray, text_size = font_size_picker(font_size_table_option))
table.cell(market_state, 1, 0, 'Long', text_color = color.gray, text_size = font_size_picker(font_size_table_option))
table.cell(market_state, 2, 0, 'Short', text_color = color.gray, text_size = font_size_picker(font_size_table_option))

table.cell(market_state, 0, 1, 'Status', bgcolor = color.new(color.blue, 90), text_color = color.gray, text_size = font_size_picker(font_size_table_option))
table.cell(market_state, 1, 1, long_state ? '✓' : '✗', text_color = long_state ? color.green : #3f00ff, text_size = font_size_picker(font_size_table_option))
table.cell(market_state, 2, 1, short_state ? '✓' : '✗', text_color = short_state ? color.green : #3f00ff, text_size = font_size_picker(font_size_table_option))

// END
