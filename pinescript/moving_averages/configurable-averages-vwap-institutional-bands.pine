//@version=5
indicator("Médias Configuráveis (EMA/SMA) + VWAPs (D/W/M) + Bandas (DP)", overlay=true, max_lines_count=500)

// =====================================================
// CONFIGURAÇÕES DE PERÍODO
// =====================================================
ma1_period = input.int(9,   title="Período Média 1")
ma2_period = input.int(20,  title="Período Média 2")
ma3_period = input.int(50,  title="Período Média 3")
ma4_period = input.int(200, title="Período Média 4")
ma5_period = input.int(200, title="Período Média 5")

// =====================================================
// CONFIGURAÇÕES DE TIPO (EMA ou SMA)
// =====================================================
ma1_type = input.string("EMA", title="Tipo Média 1", options=["EMA", "SMA"])
ma2_type = input.string("EMA", title="Tipo Média 2", options=["EMA", "SMA"])
ma3_type = input.string("EMA", title="Tipo Média 3", options=["EMA", "SMA"])
ma4_type = input.string("EMA", title="Tipo Média 4", options=["EMA", "SMA"])
ma5_type = input.string("SMA", title="Tipo Média 5", options=["EMA", "SMA"])

// =====================================================
// CONFIGURAÇÕES DE EXIBIÇÃO
// =====================================================
show_ma1 = input.bool(true, title="Mostrar Média 1")
show_ma2 = input.bool(true, title="Mostrar Média 2")
show_ma3 = input.bool(true, title="Mostrar Média 3")
show_ma4 = input.bool(true, title="Mostrar Média 4")
show_ma5 = input.bool(true, title="Mostrar Média 5")

// =====================================================
// CONFIGURAÇÕES DE CORES
// =====================================================
ma1_color = input.color(color.blue,   title="Cor Média 1")
ma2_color = input.color(color.orange, title="Cor Média 2")
ma3_color = input.color(color.purple, title="Cor Média 3")
ma4_color = input.color(color.red,    title="Cor Média 4")
ma5_color = input.color(color.green,  title="Cor Média 5")

// =====================================================
// CONFIGURAÇÕES DE ESPESSURA
// =====================================================
ma1_width = input.int(2, title="Espessura Média 1", minval=1, maxval=5)
ma2_width = input.int(2, title="Espessura Média 2", minval=1, maxval=5)
ma3_width = input.int(2, title="Espessura Média 3", minval=1, maxval=5)
ma4_width = input.int(2, title="Espessura Média 4", minval=1, maxval=5)
ma5_width = input.int(2, title="Espessura Média 5", minval=1, maxval=5)

// =====================================================
// FUNÇÃO PARA CALCULAR MÉDIA
// =====================================================
calc_ma(_type, _period) =>
    _type == "EMA" ? ta.ema(close, _period) : ta.sma(close, _period)

// =====================================================
// CÁLCULO DAS MÉDIAS
// =====================================================
ma1 = calc_ma(ma1_type, ma1_period)
ma2 = calc_ma(ma2_type, ma2_period)
ma3 = calc_ma(ma3_type, ma3_period)
ma4 = calc_ma(ma4_type, ma4_period)
ma5 = calc_ma(ma5_type, ma5_period)

// =====================================================
// PLOT DAS MÉDIAS
// =====================================================
plot(show_ma1 ? ma1 : na, title="Média 1", color=ma1_color, linewidth=ma1_width)
plot(show_ma2 ? ma2 : na, title="Média 2", color=ma2_color, linewidth=ma2_width)
plot(show_ma3 ? ma3 : na, title="Média 3", color=ma3_color, linewidth=ma3_width)
plot(show_ma4 ? ma4 : na, title="Média 4", color=ma4_color, linewidth=ma4_width)
plot(show_ma5 ? ma5 : na, title="Média 5", color=ma5_color, linewidth=ma5_width)

// =====================================================
// VWAPs (D/W/M) + Bandas (DP)
// =====================================================
grp_vwap = "VWAPs (D/W/M)"
grp_bands = "Bandas VWAP (Desvio Padrão)"

// Timeframe base fixo para estabilidade
base_tf = input.timeframe("1", "TF Base para VWAP (estável)", group=grp_vwap)

// Inputs VWAP Diária
show_vwap_d  = input.bool(true,  "Mostrar VWAP Diária", group=grp_vwap)
vwap_d_color = input.color(color.white, "Cor VWAP Diária", group=grp_vwap)
vwap_d_width = input.int(2, "Esp.", minval=1, maxval=5, group=grp_vwap)

// Inputs VWAP Semanal
show_vwap_w  = input.bool(true,  "Mostrar VWAP Semanal", group=grp_vwap)
vwap_w_color = input.color(color.aqua, "Cor VWAP Semanal", group=grp_vwap)
vwap_w_width = input.int(2, "Esp.", minval=1, maxval=5, group=grp_vwap)

// Inputs VWAP Mensal
show_vwap_m  = input.bool(true,  "Mostrar VWAP Mensal", group=grp_vwap)
vwap_m_color = input.color(color.orange, "Cor VWAP Mensal", group=grp_vwap)
vwap_m_width = input.int(2, "Esp.", minval=1, maxval=5, group=grp_vwap)

// -----------------------------
// Bandas (config geral)
// -----------------------------
show_bands = input.bool(true, "Mostrar Bandas (DP) nas VWAPs", group=grp_bands)
dp_mult    = input.float(1.0, "Multiplicador do DP", step=0.25, minval=0.25, group=grp_bands)

// Você pode ligar/desligar por VWAP também (opcional e útil)
bands_d = input.bool(true, "Bandas na VWAP Diária", group=grp_bands)
bands_w = input.bool(true, "Bandas na VWAP Semanal", group=grp_bands)
bands_m = input.bool(true, "Bandas na VWAP Mensal", group=grp_bands)

// Cores/espessuras das bandas (uma config simples, global)
band_up_color   = input.color(color.new(color.white, 0), "Cor Banda Superior", group=grp_bands)
band_dn_color   = input.color(color.new(color.white, 0), "Cor Banda Inferior", group=grp_bands)
band_width      = input.int(1, "Espessura Bandas", minval=1, maxval=5, group=grp_bands)
band_style_opt  = input.string("Linha", "Estilo", options=["Linha", "Pontilhada", "Tracejada"], group=grp_bands)

band_style = band_style_opt == "Pontilhada" ? plot.style_circles : band_style_opt == "Tracejada" ? plot.style_linebr : plot.style_line

// =====================================================
// FUNÇÃO: VWAP + DP (ponderado por volume) com reset por TF
// DP aqui é a raiz da variância ponderada por volume:
// var = (Σ(v*x^2)/Σv) - (Σ(v*x)/Σv)^2
// =====================================================
calcVWAPandSD(_resetTF) =>
    _reset = timeframe.change(_resetTF)
    var float cumV   = na
    var float cumPV  = na
    var float cumPV2 = na
    tp = hlc3
    if barstate.isfirst or _reset
        cumV   := volume
        cumPV  := tp * volume
        cumPV2 := tp * tp * volume
    else
        cumV   += volume
        cumPV  += tp * volume
        cumPV2 += tp * tp * volume

    vwap = cumV != 0 ? cumPV / cumV : na
    ex2  = cumV != 0 ? cumPV2 / cumV : na
    varp = (not na(vwap) and not na(ex2)) ? math.max(ex2 - vwap * vwap, 0) : na
    sd   = not na(varp) ? math.sqrt(varp) : na
    [vwap, sd]

// =====================================================
// VWAP D/W/M + DP (estáveis via TF base)
// =====================================================
[vwapD, sdD] = request.security(syminfo.tickerid, base_tf, calcVWAPandSD("D"), lookahead=barmerge.lookahead_off)
[vwapW, sdW] = request.security(syminfo.tickerid, base_tf, calcVWAPandSD("W"), lookahead=barmerge.lookahead_off)
[vwapM, sdM] = request.security(syminfo.tickerid, base_tf, calcVWAPandSD("M"), lookahead=barmerge.lookahead_off)

// Bandas
vwapD_up = vwapD + sdD * dp_mult
vwapD_dn = vwapD - sdD * dp_mult
vwapW_up = vwapW + sdW * dp_mult
vwapW_dn = vwapW - sdW * dp_mult
vwapM_up = vwapM + sdM * dp_mult
vwapM_dn = vwapM - sdM * dp_mult

// =====================================================
// PLOTS VWAPs
// =====================================================
plot(show_vwap_d ? vwapD : na, "VWAP Diária",  color=vwap_d_color, linewidth=vwap_d_width)
plot(show_vwap_w ? vwapW : na, "VWAP Semanal", color=vwap_w_color, linewidth=vwap_w_width)
plot(show_vwap_m ? vwapM : na, "VWAP Mensal",  color=vwap_m_color, linewidth=vwap_m_width)

// =====================================================
// PLOTS BANDAS (com toggle geral + por VWAP)
// =====================================================
plot(show_bands and bands_d and show_vwap_d ? vwapD_up : na, "Banda Sup VWAP D", color=band_up_color, linewidth=band_width, style=band_style)
plot(show_bands and bands_d and show_vwap_d ? vwapD_dn : na, "Banda Inf VWAP D", color=band_dn_color, linewidth=band_width, style=band_style)

plot(show_bands and bands_w and show_vwap_w ? vwapW_up : na, "Banda Sup VWAP W", color=band_up_color, linewidth=band_width, style=band_style)
plot(show_bands and bands_w and show_vwap_w ? vwapW_dn : na, "Banda Inf VWAP W", color=band_dn_color, linewidth=band_width, style=band_style)

plot(show_bands and bands_m and show_vwap_m ? vwapM_up : na, "Banda Sup VWAP M", color=band_up_color, linewidth=band_width, style=band_style)
plot(show_bands and bands_m and show_vwap_m ? vwapM_dn : na, "Banda Inf VWAP M", color=band_dn_color, linewidth=band_width, style=band_style)
