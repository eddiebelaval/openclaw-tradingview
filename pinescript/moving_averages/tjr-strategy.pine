//@version=6
indicator("TJR Strategy", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=10)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────

ms_lookback    = input.int(20,    "Structure Lookback",          group="Market Structure")
show_ms        = input.bool(true, "Show HH/HL/LH/LL Labels",    group="Market Structure")

impulse_mult   = input.float(2.0, "Impulse Candle Multiplier",  group="Supply Demand", step=0.1)
zone_lookback  = input.int(20,    "Zone Avg Lookback",          group="Supply Demand")
show_zones     = input.bool(true, "Show Supply Demand Zones",   group="Supply Demand")

use_engulf     = input.bool(true, "Engulfing Candle Confirm",   group="Entry")
use_wick       = input.bool(true, "Rejection Wick Confirm",     group="Entry")
wick_ratio     = input.float(2.0, "Wick Ratio Minimum",         group="Entry", step=0.1)
use_bos        = input.bool(true, "Break of Structure Confirm", group="Entry")

atr_len        = input.int(14,    "ATR Length",                 group="Risk")
sl_atr_mult    = input.float(1.0, "Stop Loss ATR",              group="Risk", step=0.1)
tp1_rr         = input.float(2.0, "TP1 Risk Reward",            group="Risk", step=0.1)
tp2_rr         = input.float(3.0, "TP2 Risk Reward",            group="Risk", step=0.1)
show_tp_sl     = input.bool(true, "Show SL TP Lines",           group="Risk")

use_session    = input.bool(true, "London + NY Sessions Only",  group="Session")
show_labels    = input.bool(true, "Show Entry Labels",          group="Display")
show_hud       = input.bool(true, "Show Dashboard",             group="Display")

// ─────────────────────────────────────────────
// SESSION
// ─────────────────────────────────────────────

ny_hour        = hour(time, "America/New_York")
london_session = ny_hour >= 3  and ny_hour < 12
ny_session     = ny_hour >= 8  and ny_hour < 17
midday_chop    = ny_hour >= 12 and ny_hour < 14
in_session     = not use_session or (london_session or ny_session)
session_ok     = in_session and not midday_chop

// ─────────────────────────────────────────────
// MARKET STRUCTURE
// ─────────────────────────────────────────────

ph = ta.pivothigh(high, ms_lookback, ms_lookback)
pl = ta.pivotlow(low,   ms_lookback, ms_lookback)

var float last_ph = na
var float prev_ph = na
var float last_pl = na
var float prev_pl = na

if not na(ph)
    prev_ph := last_ph
    last_ph := ph

if not na(pl)
    prev_pl := last_pl
    last_pl := pl

is_hh = not na(last_ph) and not na(prev_ph) and last_ph > prev_ph
is_lh = not na(last_ph) and not na(prev_ph) and last_ph < prev_ph
is_hl = not na(last_pl) and not na(prev_pl) and last_pl > prev_pl
is_ll = not na(last_pl) and not na(prev_pl) and last_pl < prev_pl

var int trend = 0
if is_hh and is_hl
    trend := 1
if is_lh and is_ll
    trend := -1

if show_ms and not na(ph)
    ms_col = is_hh ? color.lime : color.red
    ms_txt = is_hh ? "HH" : "LH"
    label.new(bar_index - ms_lookback, ph,
              ms_txt,
              color=color.new(ms_col, 20),
              textcolor=color.white,
              style=label.style_label_down,
              size=size.tiny,
              xloc=xloc.bar_index,
              yloc=yloc.price)

if show_ms and not na(pl)
    ms_col = is_hl ? color.lime : color.red
    ms_txt = is_hl ? "HL" : "LL"
    label.new(bar_index - ms_lookback, pl,
              ms_txt,
              color=color.new(ms_col, 20),
              textcolor=color.white,
              style=label.style_label_up,
              size=size.tiny,
              xloc=xloc.bar_index,
              yloc=yloc.price)

// ─────────────────────────────────────────────
// SUPPLY & DEMAND — ONE ZONE EACH ONLY
// ─────────────────────────────────────────────

atr          = ta.atr(atr_len)
avg_body     = ta.sma(math.abs(close - open), zone_lookback)
bull_impulse = (close - open) > avg_body * impulse_mult and close > open
bear_impulse = (open - close) > avg_body * impulse_mult and close < open

var float demand_top = na
var float demand_bot = na
var float supply_top = na
var float supply_bot = na
var box   demand_box = na
var box   supply_box = na

if bull_impulse
    demand_top := math.max(open, close)
    demand_bot := math.min(open, close)
    if not na(demand_box)
        box.delete(demand_box)
    if show_zones
        demand_box := box.new(bar_index, demand_top, bar_index + 200, demand_bot,
                              border_color=color.new(color.lime, 30),
                              bgcolor=color.new(color.lime, 80),
                              extend=extend.right)

if bear_impulse
    supply_top := math.max(open, close)
    supply_bot := math.min(open, close)
    if not na(supply_box)
        box.delete(supply_box)
    if show_zones
        supply_box := box.new(bar_index, supply_top, bar_index + 200, supply_bot,
                              border_color=color.new(color.red, 30),
                              bgcolor=color.new(color.red, 80),
                              extend=extend.right)

if not na(demand_bot) and close < demand_bot
    demand_top := na
    demand_bot := na
    if not na(demand_box)
        box.delete(demand_box)

if not na(supply_top) and close > supply_top
    supply_top := na
    supply_bot := na
    if not na(supply_box)
        box.delete(supply_box)

// ─────────────────────────────────────────────
// PRICE IN ZONE
// ─────────────────────────────────────────────

in_demand = not na(demand_top) and low  <= demand_top and high >= demand_bot
in_supply = not na(supply_top) and high >= supply_bot and low  <= supply_top

// ─────────────────────────────────────────────
// ENTRY CONFIRMATIONS
// ─────────────────────────────────────────────

candle_body = math.abs(close - open)
upper_wick  = high - math.max(open, close)
lower_wick  = math.min(open, close) - low

bull_engulf = close > open and close > open[1] and open < close[1]
bear_engulf = close < open and close < open[1] and open > close[1]
bull_wick   = lower_wick > candle_body * wick_ratio and close > open
bear_wick   = upper_wick > candle_body * wick_ratio and close < open

recent_high = ta.highest(high, 5)[1]
recent_low  = ta.lowest(low,   5)[1]
bull_bos    = close > recent_high
bear_bos    = close < recent_low

long_confirm  = (use_engulf and bull_engulf) or (use_wick and bull_wick) or (use_bos and bull_bos)
short_confirm = (use_engulf and bear_engulf) or (use_wick and bear_wick) or (use_bos and bear_bos)

// ─────────────────────────────────────────────
// SIGNALS
// ─────────────────────────────────────────────

long_signal  = trend == 1  and in_demand and long_confirm  and session_ok
short_signal = trend == -1 and in_supply and short_confirm and session_ok

// ─────────────────────────────────────────────
// ENTRY ARROWS — fixed to bar, never move
// ─────────────────────────────────────────────

plotshape(long_signal,  "Long Entry",  shape.triangleup,   location.belowbar, color.new(color.lime, 0), size=size.normal, text="TJR L")
plotshape(short_signal, "Short Entry", shape.triangledown, location.abovebar, color.new(color.red,  0), size=size.normal, text="TJR S")

// ─────────────────────────────────────────────
// SL / TP LINES
// ─────────────────────────────────────────────

var line sl_ln  = na
var line tp1_ln = na
var line tp2_ln = na

if long_signal and show_tp_sl
    sl_p  = not na(demand_bot) ? demand_bot - atr * sl_atr_mult : close - atr * sl_atr_mult
    risk  = close - sl_p
    tp1_p = close + risk * tp1_rr
    tp2_p = close + risk * tp2_rr
    sl_ln  := line.new(bar_index, sl_p,  bar_index + 15, sl_p,  color=color.red,   width=1, style=line.style_dashed)
    tp1_ln := line.new(bar_index, tp1_p, bar_index + 15, tp1_p, color=color.lime,  width=1, style=line.style_dashed)
    tp2_ln := line.new(bar_index, tp2_p, bar_index + 15, tp2_p, color=color.green, width=2, style=line.style_dashed)

if short_signal and show_tp_sl
    sl_p  = not na(supply_top) ? supply_top + atr * sl_atr_mult : close + atr * sl_atr_mult
    risk  = sl_p - close
    tp1_p = close - risk * tp1_rr
    tp2_p = close - risk * tp2_rr
    sl_ln  := line.new(bar_index, sl_p,  bar_index + 15, sl_p,  color=color.red,   width=1, style=line.style_dashed)
    tp1_ln := line.new(bar_index, tp1_p, bar_index + 15, tp1_p, color=color.lime,  width=1, style=line.style_dashed)
    tp2_ln := line.new(bar_index, tp2_p, bar_index + 15, tp2_p, color=color.green, width=2, style=line.style_dashed)

// ─────────────────────────────────────────────
// SIGNAL LABELS — pinned to bar_index at time of signal
// ─────────────────────────────────────────────

if long_signal and show_labels
    sl_p  = not na(demand_bot) ? demand_bot - atr * sl_atr_mult : close - atr * sl_atr_mult
    risk  = close - sl_p
    tp1_p = close + risk * tp1_rr
    tp2_p = close + risk * tp2_rr
    label.new(bar_index, low,
              "L  SL:" + str.tostring(math.round(sl_p, 1)) +
              " TP1:" + str.tostring(math.round(tp1_p, 1)) +
              " TP2:" + str.tostring(math.round(tp2_p, 1)),
              color=color.new(color.lime, 10),
              textcolor=color.black,
              style=label.style_label_up,
              size=size.tiny,
              xloc=xloc.bar_index,
              yloc=yloc.price)

if short_signal and show_labels
    sl_p  = not na(supply_top) ? supply_top + atr * sl_atr_mult : close + atr * sl_atr_mult
    risk  = sl_p - close
    tp1_p = close - risk * tp1_rr
    tp2_p = close - risk * tp2_rr
    label.new(bar_index, high,
              "S  SL:" + str.tostring(math.round(sl_p, 1)) +
              " TP1:" + str.tostring(math.round(tp1_p, 1)) +
              " TP2:" + str.tostring(math.round(tp2_p, 1)),
              color=color.new(color.red, 10),
              textcolor=color.white,
              style=label.style_label_down,
              size=size.tiny,
              xloc=xloc.bar_index,
              yloc=yloc.price)

// ─────────────────────────────────────────────
// HUD
// ─────────────────────────────────────────────

var table hud = table.new(position.top_right, 2, 9,
     bgcolor=color.new(color.black, 65),
     border_color=color.new(color.gray, 50),
     border_width=1,
     frame_color=color.new(color.gray, 30),
     frame_width=1)

if barstate.islast and show_hud
    trend_str = trend == 1  ? "UPTREND"   : trend == -1 ? "DOWNTREND" : "RANGING"
    trend_col = trend == 1  ? color.lime  : trend == -1 ? color.red   : color.gray
    sess_str  = session_ok  ? "ACTIVE"    : "AVOID"
    sess_col  = session_ok  ? color.lime  : color.orange
    lon_str   = london_session ? "OPEN"   : "CLOSED"
    lon_col   = london_session ? color.lime : color.gray
    ny_str    = ny_session  ? "OPEN"      : "CLOSED"
    ny_col    = ny_session  ? color.lime  : color.gray
    chop_str  = midday_chop ? "AVOID"     : "NO"
    chop_col  = midday_chop ? color.red   : color.lime
    dem_str   = in_demand   ? "IN ZONE"   : "Outside"
    dem_col   = in_demand   ? color.lime  : color.gray
    sup_str   = in_supply   ? "IN ZONE"   : "Outside"
    sup_col   = in_supply   ? color.red   : color.gray
    bias_str  = trend == 1  ? "BUY ONLY"  : trend == -1 ? "SELL ONLY" : "WAIT"
    bias_col  = trend == 1  ? color.lime  : trend == -1 ? color.red   : color.gray

    table.cell(hud, 0, 0, "TJR STRATEGY", text_color=color.white,  bgcolor=color.new(color.navy, 20), text_size=size.small)
    table.cell(hud, 1, 0, "STATUS",        text_color=color.white,  bgcolor=color.new(color.navy, 20), text_size=size.small)
    table.cell(hud, 0, 1, "Trend",          text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 1, trend_str,        text_color=trend_col,    text_size=size.small)
    table.cell(hud, 0, 2, "Bias",           text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 2, bias_str,         text_color=bias_col,     text_size=size.small)
    table.cell(hud, 0, 3, "Session",        text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 3, sess_str,         text_color=sess_col,     text_size=size.small)
    table.cell(hud, 0, 4, "London",         text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 4, lon_str,          text_color=lon_col,      text_size=size.small)
    table.cell(hud, 0, 5, "New York",       text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 5, ny_str,           text_color=ny_col,       text_size=size.small)
    table.cell(hud, 0, 6, "Midday Chop",    text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 6, chop_str,         text_color=chop_col,     text_size=size.small)
    table.cell(hud, 0, 7, "Demand Zone",    text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 7, dem_str,          text_color=dem_col,      text_size=size.small)
    table.cell(hud, 0, 8, "Supply Zone",    text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 8, sup_str,          text_color=sup_col,      text_size=size.small)

// ─────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────

alertcondition(long_signal,                 "TJR Long Entry",  "TJR LONG - {{ticker}} @ {{close}}")
alertcondition(short_signal,                "TJR Short Entry", "TJR SHORT - {{ticker}} @ {{close}}")
alertcondition(long_signal or short_signal, "TJR Any Entry",   "TJR Signal - {{ticker}} @ {{close}}")
