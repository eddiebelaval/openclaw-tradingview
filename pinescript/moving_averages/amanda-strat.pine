//@version=5
indicator("Amanda Clean (No Big Background) — MSS + Fib GP + 9/21 + 200", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=200)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
showEMAs   = input.bool(true, "Show EMAs")
len9       = input.int(9, "EMA 9", minval=1)
len21      = input.int(21, "EMA 21", minval=1)
len200     = input.int(200, "EMA 200", minval=1)

pivotLen   = input.int(10, "Major Swing Strength", minval=1)

showConBox = input.bool(true, "Show Consolidation Box")
conBoxColor = input.color(color.new(color.purple, 85), "Consolidation Box Color")

require200 = input.bool(true, "Require EMA 200 Bias")
requireGP  = input.bool(true, "Require Golden Pocket")
oneSignalPerBOS = input.bool(true, "Only One Entry Per BOS")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EMAs
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ema9   = ta.ema(close, len9)
ema21  = ta.ema(close, len21)
ema200 = ta.ema(close, len200)

plot(showEMAs ? ema9 : na,  title="EMA 9")
plot(showEMAs ? ema21 : na, title="EMA 21")
plot(showEMAs ? ema200 : na,title="EMA 200")

bullBias = close > ema200
bearBias = close < ema200

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Major High / Low (structure)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)

var float lastMajHigh = na
var float lastMajLow  = na
var int   lastMajHighBar = na
var int   lastMajLowBar  = na
var bool  majHighActive = false
var bool  majLowActive  = false

if not na(ph)
    lastMajHigh := ph
    lastMajHighBar := bar_index - pivotLen
    majHighActive := true
    label.new(lastMajHighBar, lastMajHigh, "Major High", style=label.style_label_down, color=color.green, textcolor=color.white)

if not na(pl)
    lastMajLow := pl
    lastMajLowBar := bar_index - pivotLen
    majLowActive := true
    label.new(lastMajLowBar, lastMajLow, "Major Low", style=label.style_label_up, color=color.red, textcolor=color.white)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BOS (only once per level)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bullBOS = majHighActive and not na(lastMajHigh) and ta.crossover(close, lastMajHigh)
bearBOS = majLowActive  and not na(lastMajLow)  and ta.crossunder(close, lastMajLow)

// Fib anchors
var bool  fibBull = na
var float fibA = na
var float fibB = na
var bool  entryFired = false

if bullBOS
    majHighActive := false
    fibBull := true
    fibA := lastMajLow
    fibB := high
    entryFired := false

if bearBOS
    majLowActive := false
    fibBull := false
    fibA := lastMajHigh
    fibB := low
    entryFired := false

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Fib levels (Golden Pocket only)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
hasFib = not na(fibA) and not na(fibB) and fibA != fibB
fibRange = hasFib ? math.abs(fibB - fibA) : na

fibLevel(r) =>
    fibBull ? (fibB - fibRange * r) : (fibB + fibRange * r)

lvl618 = hasFib ? fibLevel(0.618) : na
lvl705 = hasFib ? fibLevel(0.705) : na

gpTop = hasFib ? math.max(lvl618, lvl705) : na
gpBot = hasFib ? math.min(lvl618, lvl705) : na

inGP = hasFib and close <= gpTop and close >= gpBot

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// GOLDEN POCKET VISUAL (yellow box)
// NO big background shading here.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var box gpBox = na

if hasFib
    if na(gpBox)
        gpBox := box.new(bar_index, gpTop, bar_index, gpBot)
    box.set_right(gpBox, bar_index)
    box.set_top(gpBox, gpTop)
    box.set_bottom(gpBox, gpBot)
    box.set_bgcolor(gpBox, color.new(color.yellow, 85))
    box.set_border_color(gpBox, color.new(color.yellow, 40))
else
    if not na(gpBox)
        box.delete(gpBox)
        gpBox := na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CONSOLIDATION BOX (small purple box)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var box conBox = na

if showConBox and hasFib
    if inGP and na(conBox)
        conBox := box.new(bar_index, high, bar_index, low)
        box.set_bgcolor(conBox, conBoxColor)
        box.set_border_color(conBox, color.new(color.white, 60))

    if not na(conBox) and inGP
        box.set_right(conBox, bar_index)
        box.set_top(conBox, math.max(box.get_top(conBox), high))
        box.set_bottom(conBox, math.min(box.get_bottom(conBox), low))
        box.set_bgcolor(conBox, conBoxColor)
        box.set_border_color(conBox, color.new(color.white, 60))

// Reset conBox when fib resets
if not hasFib and not na(conBox)
    box.delete(conBox)
    conBox := na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Entry tabs (BUY/SELL)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bullCross = ta.crossover(ema9, ema21)
bearCross = ta.crossunder(ema9, ema21)

bullEntry = hasFib and fibBull and bullCross and (not require200 or bullBias) and (not requireGP or inGP)
bearEntry = hasFib and (not fibBull) and bearCross and (not require200 or bearBias) and (not requireGP or inGP)

finalBull = bullEntry and (not oneSignalPerBOS or not entryFired)
finalBear = bearEntry and (not oneSignalPerBOS or not entryFired)

if finalBull
    label.new(bar_index, low, "BUY", style=label.style_label_up, color=color.green, textcolor=color.white)
    entryFired := true

if finalBear
    label.new(bar_index, high, "SELL", style=label.style_label_down, color=color.red, textcolor=color.white)
    entryFired := true

alertcondition(finalBull, "BUY Entry",  "BUY ENTRY: BOS + GP + 9/21 cross + (optional) EMA200 bias")
alertcondition(finalBear, "SELL Entry", "SELL ENTRY: BOS + GP + 9/21 cross + (optional) EMA200 bias")
