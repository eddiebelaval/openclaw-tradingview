//@version=5
indicator("Gelişmiş Trend ve Momentum Al-Sat", overlay=true, timeframe="", timeframe_gaps=true)
// --- Girdiler (Ayarlar) ---
atrPeriod = input.int(10, "SuperTrend ATR Dönemi", minval=1)
src = input(close, "Kaynak")
multiplier = input.float(3.0, "SuperTrend Çarpanı", step=0.1)
emaLength = input.int(200, "Uzun Vadeli Trend (EMA) Uzunluğu")
rsiLength = input.int(14, "RSI Uzunluğu")
rsiOverbought = input.int(70, "RSI Aşırı Satış Eşiği")
rsiOversold = input.int(30, "RSI Aşırı Alım Eşiği")
// --- Hesaplamalar ---
// 1. SuperTrend Hesaplaması
[supertrend, direction] = ta.supertrend(multiplier, atrPeriod)
// 2. EMA Hesaplaması
ema200 = ta.ema(close, emaLength)
// 3. RSI Hesaplaması
rsiValue = ta.rsi(close, rsiLength)
// --- Al-Sat Koşulları ---
// AL Koşulu:
// - SuperTrend 'Al' yönünde olmalı (direction < 0)
// - Fiyat 200 EMA'nın üzerinde olmalı (Yükselen trend teyidi)
// - RSI 30'un üzerinde olmalı (Aşırı dipten dönüş veya yükseliş momentumu)
buyCondition = ta.change(direction) < 0 and close > ema200 and rsiValue > rsiOversold
// SAT Koşulu:
// - SuperTrend 'Sat' yönünde olmalı (direction > 0)
// - Fiyat 200 EMA'nın altında olmalı (Düşen trend teyidi)
// - RSI 70'in altında olmalı (Tepe dönüşü teyidi)
sellCondition = ta.change(direction) > 0 and close < ema200 and rsiValue < rsiOverbought
// --- Görselleştirme ---
// SuperTrend Çizgisi
plot(direction < 0 ? supertrend : na, "Yükseliş Trendi", color=color.green, linewidth=2, style=plot.style_linebr)
plot(direction > 0 ? supertrend : na, "Düşüş Trendi", color=color.red, linewidth=2, style=plot.style_linebr)
// EMA 200 Çizgisi
plot(ema200, "EMA 200", color=color.gray, linewidth=1)
// Sinyal Etiketleri
plotshape(buyCondition, title="AL Sinyali", text="AL", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.small)
plotshape(sellCondition, title="SAT Sinyali", text="SAT", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.small)
// Arka Plan Renklendirme (Opsiyonel)
bgcolor(buyCondition ? color.new(color.green, 90) : na)
bgcolor(sellCondition ? color.new(color.red, 90) : na)
// --- Alarmlar ---
alertcondition(buyCondition, title="Yeni AL Sinyali", message="Fiyat {{close}} seviyesinde AL sinyali verdi!")
alertcondition(sellCondition, title="Yeni SAT Sinyali", message="Fiyat {{close}} seviyesinde SAT sinyali verdi!")
