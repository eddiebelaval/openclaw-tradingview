//@version=6
indicator("VWAP EMA RSI DMI Pro", shorttitle="VW_EMA_RSI", overlay=true)

// === Inputs ===
ema_fast_len = input.int(20, "Fast EMA Length")
ema_slow_len = input.int(50, "Slow EMA Length")
ema_trend_len = input.int(200, "Trend EMA Length")
rsi_len = input.int(14, "RSI Length")
dmi_len = input.int(14, "DMI Length")
adx_smooth = input.int(14, "ADX Smoothing")
show_table = input.bool(true, "Show Table Summary")

// === Core Calculations ===
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
ema_trend = ta.ema(close, ema_trend_len)
vwap_val = ta.vwap(close)
rsi_val = ta.rsi(close, rsi_len)

// DMI calculation — FIXED ✅
[di_plus, di_minus, adx] = ta.dmi(adx_smooth, dmi_len)

// === Confluence Conditions ===
bull_condition = close > vwap_val and ema_fast > ema_slow and ema_slow > ema_trend and rsi_val > 50 and di_plus > di_minus
bear_condition = close < vwap_val and ema_fast < ema_slow and ema_slow < ema_trend and rsi_val < 50 and di_minus > di_plus

// === Background Color ===
bg_color = bull_condition ? color.new(color.green, 85) : bear_condition ? color.new(color.red, 85) : color.new(color.gray, 90)
bgcolor(bg_color)

// === Plot VWAP & EMAs ===
plot(vwap_val, color=color.new(color.orange, 0), title="VWAP", linewidth=2)
plot(ema_fast, color=color.new(color.teal, 0), title="EMA Fast (20)", linewidth=1)
plot(ema_slow, color=color.new(color.purple, 0), title="EMA Slow (50)", linewidth=1)
plot(ema_trend, color=color.new(color.yellow, 0), title="EMA Trend (200)", linewidth=1)

// === Automatic Buy / Sell Labels ===
var float last_signal_bar = na
if bull_condition and not bear_condition
    if na(last_signal_bar) or (bar_index - last_signal_bar > 3)
        label.new(bar_index, low, "BUY ✅", style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.normal)
        last_signal_bar := bar_index
if bear_condition and not bull_condition
    if na(last_signal_bar) or (bar_index - last_signal_bar > 3)
        label.new(bar_index, high, "SELL ❌", style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.normal)
        last_signal_bar := bar_index

// === Table Summary ===
if show_table
    var table conf_table = table.new(position.bottom_right, 3, 5, border_width=1)
    if barstate.isfirst
        table.cell(conf_table, 0, 0, "Indicator", text_color=color.yellow)
        table.cell(conf_table, 1, 0, "Value", text_color=color.yellow)
        table.cell(conf_table, 2, 0, "Status", text_color=color.yellow)

    table.cell(conf_table, 0, 1, "VWAP", text_color=color.white)
    table.cell(conf_table, 1, 1, str.tostring(vwap_val, format.mintick))
    table.cell(conf_table, 2, 1, close > vwap_val ? "Above (Bullish)" : "Below (Bearish)", text_color=close > vwap_val ? color.lime : color.red)

    table.cell(conf_table, 0, 2, "EMA Trend", text_color=color.white)
    table.cell(conf_table, 1, 2, ema_fast > ema_slow ? "Up" : "Down", text_color=ema_fast > ema_slow ? color.lime : color.red)
    table.cell(conf_table, 2, 2, ema_fast > ema_slow ? "Bull" : "Bear", text_color=ema_fast > ema_slow ? color.lime : color.red)

    table.cell(conf_table, 0, 3, "RSI", text_color=color.white)
    table.cell(conf_table, 1, 3, str.tostring(rsi_val, format.mintick))
    table.cell(conf_table, 2, 3, rsi_val > 50 ? "Above 50 (Bull)" : "Below 50 (Bear)", text_color=rsi_val > 50 ? color.lime : color.red)

    table.cell(conf_table, 0, 4, "DMI", text_color=color.white)
    table.cell(conf_table, 1, 4, "DI+:" + str.tostring(di_plus, "#.##") + " / DI-:" + str.tostring(di_minus, "#.##"))
    table.cell(conf_table, 2, 4, di_plus > di_minus ? "Bull" : "Bear", text_color=di_plus > di_minus ? color.lime : color.red)

// === Alerts ===
alertcondition(bull_condition, title="BUY Signal", message="VWAP+EMA+RSI+DMI BUY Confluence ✅")
alertcondition(bear_condition, title="SELL Signal", message="VWAP+EMA+RSI+DMI SELL Confluence ❌")
